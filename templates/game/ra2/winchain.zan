// 快速游戏胜负全链路的回归程序。在一个程序化铺出的平地地图上放下两座
// 基地,不读 data/:地形是构造出来的 IsoMap,规则是 Rules.Default()。
// 场景各断言一个结果,任何一条 FAIL 都以非零码退出:
//   长局:打光敌方建筑但留一个兵 -> result 保持 0(还要继续清兵)
//   短局:同样局面 -> result 立即变 1(打光建筑就算赢)
//   反向短局:己方建筑全灭 -> result 变 2(判负)
//   多房:玩家+两个 AI 房,清一个 AI 局面继续,清光才判胜
using System;
using Game.Kit;
using Ra2.Assets;
using Ra2.Formats;
using Ra2.Game;

class WinChainTest {
    // 铺一张 40x40 的平地:level 4 是真实地图的地面高度,可通行。
    static IsoMap FlatMap(int w, int h) {
        IsoMap iso = new IsoMap();
        iso.width = w;
        iso.height = h;
        iso.tiles = new List<IsoTile>();
        iso.cellIndex = new List<int>();
        for (int c = 0; c < w * h; c = c + 1) { iso.cellIndex.Add(0); }
        for (int y = 0; y < h; y = y + 1) {
            for (int x = 0; x < w; x = x + 1) {
                IsoTile t = new IsoTile();
                t.x = x;
                t.y = y;
                t.tile = 0xFFFF;   // clear ground
                t.subTile = 0;
                t.level = 4;
                iso.tiles.Add(t);
                iso.cellIndex[y * w + x] = iso.tiles.Count;
            }
        }
        return iso;
    }

    static int StructuresOf(World world, int side) {
        int n = 0;
        for (int i = 0; i < world.ObjectCount(); i = i + 1) {
            WorldObject o = world.ObjectAt(i);
            if (o.Side() == side && o.Kind() == ObjKind.Structure()
             && !o.IsDead()) { n = n + 1; }
        }
        return n;
    }

    static int UnitsOf(World world, int side) {
        int n = 0;
        for (int i = 0; i < world.ObjectCount(); i = i + 1) {
            WorldObject o = world.ObjectAt(i);
            if (o.Side() == side && o.Kind() == ObjKind.Unit()
             && !o.IsDead()) { n = n + 1; }
        }
        return n;
    }

    static int KillStructuresOf(World world, int side) {
        int killed = 0;
        for (int i = 0; i < world.ObjectCount(); i = i + 1) {
            WorldObject o = world.ObjectAt(i);
            if (o.Side() == side && o.Kind() == ObjKind.Structure()
             && !o.IsDead()) {
                o.TakeDamage(o.Hp());
                killed = killed + 1;
            }
        }
        return killed;
    }

    static int failures = 0;

    // ---- 声音样件工厂:合成 AUD,喂给解码器断言 ----------------------

    static byte[] Au8(int n) {
        byte[] b = new byte[n];
        return b;
    }

    static void Au16(byte[] buf, int at, int v) {
        buf[at] = (byte)(v & 0xFF);
        buf[at + 1] = (byte)((v >> 8) & 0xFF);
    }

    static int AuGet16(byte[] buf, int at) {
        int v = (buf[at] & 0xFF) + (buf[at + 1] & 0xFF) * 256;
        return v >= 32768 ? v - 65536 : v;
    }

    static void AuU32(byte[] buf, int at, int v) {
        buf[at] = (byte)(v & 0xFF);
        buf[at + 1] = (byte)((v >> 8) & 0xFF);
        buf[at + 2] = (byte)((v >> 16) & 0xFF);
        buf[at + 3] = (byte)((v >> 24) & 0xFF);
    }

    /// <summary>16 位 PCM 的 AUD:rate、outBps=1、comp=0,单块。</summary>
    static byte[] PcmAud(int[] samples) {
        int dataLen = samples.Length * 2 + 4;
        byte[] b = Au8(8 + dataLen);
        Au16(b, 0, 22050);
        AuU32(b, 2, dataLen);
        b[6] = 1;
        b[7] = 0;
        b[8] = (byte)((samples.Length * 2) & 0xFF);
        b[9] = (byte)(((samples.Length * 2) >> 8) & 0xFF);
        b[10] = (byte)((samples.Length * 2) & 0xFF);
        b[11] = (byte)(((samples.Length * 2) >> 8) & 0xFF);
        for (int i = 0; i < samples.Length; i = i + 1) {
            Au16(b, 12 + i * 2, samples[i]);
        }
        return b;
    }

    /// <summary>8 位无符号 PCM 的 AUD:outBps=0,单块,解码时拓宽到 16 位。</summary>
    static byte[] Pcm8Aud(byte[] samples) {
        int dataLen = samples.Length + 4;
        byte[] b = Au8(8 + dataLen);
        Au16(b, 0, 22050);
        AuU32(b, 2, dataLen);
        b[6] = 0;
        b[7] = 0;
        b[8] = (byte)(samples.Length & 0xFF);
        b[9] = (byte)((samples.Length >> 8) & 0xFF);
        b[10] = (byte)(samples.Length & 0xFF);
        b[11] = (byte)((samples.Length >> 8) & 0xFF);
        for (int i = 0; i < samples.Length; i = i + 1) {
            b[12 + i] = samples[i];
        }
        return b;
    }

    static int ImaStepAt(int index) {
        int v = 7;
        for (int i = 0; i < index; i = i + 1) {
            v = v + (v >> 2) + 1;
        }
        return v;
    }

    /// <summary>IMA ADPCM 的 AUD(压缩 99):闭环重建编码——编码器与解码器
    /// 同步推进预测器,解码输出应与重建序列逐样本一致,且对目标样本的
    /// 误差有界。每块 5 个样本 = 4 个增量 = 整 2 字节半字节,块头是完整
    /// 的 4 字节(预测器 + 步索引 + 保留字节),与解码器逐字节对齐。
    /// 返回码 0 = 正常,负值 = 输入规模不支持。</summary>
    static int ImaAud(int[] samples, byte[] outBuf, int cap) {
        int perChunk = 5;
        int chunkCount = (samples.Length + perChunk - 1) / perChunk;
        int dataLen = 0;
        for (int c = 0; c < chunkCount; c = c + 1) {
            int n = perChunk;
            if (c * perChunk + n > samples.Length) {
                n = samples.Length - c * perChunk;
            }
            dataLen = dataLen + 8 + ((n - 1) + 1) / 2;
        }
        if (8 + dataLen > cap) { return 0 - 1; }
        byte[] b = outBuf;
        Au16(b, 0, 22050);
        AuU32(b, 2, dataLen);
        b[6] = 1;
        b[7] = 99;
        int at = 8;
        int si = 0;
        for (int c = 0; c < chunkCount; c = c + 1) {
            int end = si + perChunk;
            if (end > samples.Length) { end = samples.Length; }
            int deltas = end - si - 1;
            int nibBytes = (deltas + 1) / 2;
            int chunkBytes = 4 + nibBytes;
            b[at] = (byte)(chunkBytes & 0xFF);
            b[at + 1] = (byte)((chunkBytes >> 8) & 0xFF);
            int outBytes = (end - si) * 2;
            b[at + 2] = (byte)(outBytes & 0xFF);
            b[at + 3] = (byte)((outBytes >> 8) & 0xFF);
            int predictor = samples[si];
            int stepIndex = 0;
            Au16(b, at + 4, predictor);
            b[at + 6] = 0;
            b[at + 7] = 0;
            int nibAt = at + 8;
            int nibbles = 0;
            for (int i = si + 1; i < end; i = i + 1) {
                int step = ImaStepAt(stepIndex);
                int diff = samples[i] - predictor;
                int nib = 0;
                if (diff < 0) { nib = nib + 8; diff = 0 - diff; }
                if (diff >= step) { nib = nib + 4; diff = diff - step; }
                if (diff >= step >> 1) { nib = nib + 2; diff = diff - (step >> 1); }
                if (diff >= step >> 2) { nib = nib + 1; }
                if (nibbles % 2 == 0) {
                    b[nibAt] = (byte)nib;
                } else {
                    b[nibAt] = (byte)((b[nibAt] & 0xFF) + nib * 16);
                    nibAt = nibAt + 1;
                }
                nibbles = nibbles + 1;
                // 与解码器逐位一致的重建链。
                int step2 = ImaStepAt(stepIndex);
                int add = step2 >> 3;
                if ((nib & 1) != 0) { add = add + (step2 >> 2); }
                if ((nib & 2) != 0) { add = add + (step2 >> 1); }
                if ((nib & 4) != 0) { add = add + step2; }
                if ((nib & 8) != 0) { add = 0 - add; }
                predictor = predictor + add;
                if (predictor > 32767) { predictor = 32767; }
                if (predictor < 0 - 32768) { predictor = 0 - 32768; }
                int d = stepIndex
                    + (nib < 4 ? 0 - 1 : nib == 4 ? 2 : nib == 5 ? 4
                        : nib == 6 ? 6 : 8);
                stepIndex = d < 0 ? 0 : d > 88 ? 88 : d;
            }
            at = at + 4 + chunkBytes;
            si = end;
        }
        return 8 + dataLen;
    }

    static void Report(string tag, int got, int want) {
        string verdict = got == want ? "PASS" : "FAIL";
        Console.WriteLine(verdict + " " + tag
            + " got=" + Convert.ToString(got)
            + " want=" + Convert.ToString(want));
        if (got != want) { failures = failures + 1; }
    }

    // 场景 1+2:玩家(盟军)与敌人(苏军)各一座基地。先验证长局规则,
    // 同一局面再用短局规则重摆一遍。
    static void Main() {
        Rules rules = Rules.Default();
        StructureCatalog sc = StructureCatalog.CreateWith(rules);
        UnitCatalog uc = UnitCatalog.CreateWith(rules);

        // ---- 长局:清掉敌方建筑、留兵,结果必须还是 0 ----
        World world = World.Create(FlatMap(40, 40), sc, uc);
        world.PlaceBase(0, 3, 3);
        world.PlaceBase(1, 30, 30);
        GameController game = GameController.CreateWith(world, 0, 10000,
                                                        Difficulty.Normal());
        game.SetShortGame(false);
        int step = 0;
        while (step < 200 && game.Result() == 0) { game.Tick(); step = step + 1; }
        Report("long pre-game stays undecided", game.Result(), 0);
        Report("long both bases stand (player)",
               StructuresOf(world, 0) > 0 ? 1 : 0, 1);
        Report("long both bases stand (enemy)",
               StructuresOf(world, 1) > 0 ? 1 : 0, 1);
        int killed = KillStructuresOf(world, 1);
        Report("long enemy structures razed", killed > 0 ? 1 : 0, 1);
        game.Tick();
        Report("long surviving enemy units keep fight going",
               game.Result(), 0);
        // 敌方最后一个兵也阵亡后,长局才算分晓。
        for (int i = 0; i < world.ObjectCount(); i = i + 1) {
            WorldObject o = world.ObjectAt(i);
            if (o.Side() == 1 && o.Kind() == ObjKind.Unit() && !o.IsDead()) {
                o.TakeDamage(o.Hp());
            }
        }
        game.Tick();
        Report("long win once the last enemy unit dies", game.Result(), 1);

        // ---- 短局:同一开局,清建筑即胜,不用清兵 ----
        World world2 = World.Create(FlatMap(40, 40), sc, uc);
        world2.PlaceBase(0, 3, 3);
        world2.PlaceBase(1, 30, 30);
        GameController game2 = GameController.CreateWith(world2, 0, 10000,
                                                         Difficulty.Normal());
        game2.SetShortGame(true);
        // Sit out the opening ticks first: the first tick alone must not
        // have already decided the game, which is what "got=2 want=0" used
        // to catch before this loop existed.
        int step2 = 0;
        while (step2 < 50 && game2.Result() == 0) { game2.Tick(); step2 = step2 + 1; }
        Report("short pre-game stays undecided", game2.Result(), 0);
        KillStructuresOf(world2, 1);
        game2.Tick();
        Report("short surviving enemy units do not matter",
               game2.Result(), 1);

        // ---- 反向:短局下己方建筑全灭即判负 ----
        World world3 = World.Create(FlatMap(40, 40), sc, uc);
        world3.PlaceBase(0, 3, 3);
        world3.PlaceBase(1, 30, 30);
        GameController game3 = GameController.CreateWith(world3, 0, 10000,
                                                         Difficulty.Normal());
        game3.SetShortGame(true);
        KillStructuresOf(world3, 0);
        game3.Tick();
        Report("short player loss when own base is razed", game3.Result(), 2);

        // ---- 多房:玩家 + 两个 AI 房(1 苏军、2 盟军),全员混战 ----
        // 清掉 1 号 AI 的建筑与兵后局面对 2 号 AI 仍是 0(还活着就继续打);
        // 再清 2 号 AI 才判胜。
        World world4 = World.Create(FlatMap(40, 40), sc, uc);
        world4.PlaceBase(0, 3, 3);
        world4.PlaceBase(1, 30, 3);
        world4.PlaceBase(2, 3, 30);
        List<int> houses4 = new List<int>();
        houses4.Add(1);
        houses4.Add(2);
        List<int> diffs4 = new List<int>();
        diffs4.Add(Difficulty.Brutal());
        diffs4.Add(Difficulty.Normal());
        world4.SetFactions(0, houses4);
        GameController game4 = GameController.CreateMulti(world4, 0, houses4,
                                                          diffs4, 10000);
        game4.SetShortGame(true);
        int step4 = 0;
        while (step4 < 50 && game4.Result() == 0) { game4.Tick(); step4 = step4 + 1; }
        Report("multi pre-game stays undecided", game4.Result(), 0);
        Report("multi both AI houses stand",
               StructuresOf(world4, 1) > 0 && StructuresOf(world4, 2) > 0
                   ? 1 : 0, 1);
        Report("multi AI factions rotated (soviet + yuri)",
               world4.FactionOf(1) == Side2.Soviet()
               && world4.FactionOf(2) == Side2.Yuri() ? 1 : 0, 1);
        KillStructuresOf(world4, 1);
        for (int i = 0; i < world4.ObjectCount(); i = i + 1) {
            WorldObject o = world4.ObjectAt(i);
            if (o.Side() == 1 && o.Kind() == ObjKind.Unit() && !o.IsDead()) {
                o.TakeDamage(o.Hp());
            }
        }
        game4.Tick();
        Report("multi killing one AI keeps the game on", game4.Result(), 0);
        KillStructuresOf(world4, 2);
        game4.Tick();
        Report("multi killing the last AI wins", game4.Result(), 1);

        // ---- 战争迷雾:每屋一张 MapShroud。开局各家的兵力揭示自己的视野
        // 圈,敌基地对 0 号屋保持无光;征召兵落在无光处的瞬间点亮自己的
        // 视野圈,行军沿途逐格续揭示;临时揭示到期塌回无光;Darken 位
        // (间隙产生器的地基)可开可关。纯逻辑链路,不依赖 GUI 驱动。
        MapShroud probeA = MapShroud.Create(40, 40);
        probeA.SeedElevation(world4);
        probeA.RevealFrom(20, 20, 4, 5);
        probeA.Update();
        Report("shroud standalone reveal",
               probeA.At(20, 20) == MapShroud.Explored() ? 1 : 0, 1);
        World world5 = World.Create(FlatMap(40, 40), sc, uc);
        world5.PlaceBase(0, 3, 3);
        world5.PlaceBase(1, 30, 30);
        world5.InitShrouds();
        MapShroud sh5 = world5.ShroudOf(0);
        Report("shroud built for house 0", sh5 != null ? 1 : 0, 1);
        Report("shroud absent outside houses",
               world5.ShroudOf(8) == null
               && world5.ShroudOf(0 - 1) == null ? 1 : 0, 1);
        Report("shroud own base cell lit",
               sh5.At(3, 3) == MapShroud.Explored() ? 1 : 0, 1);
        Report("shroud enemy base dark for house 0",
               sh5.At(30, 30) == MapShroud.Unexplored() ? 1 : 0, 1);
        int e1id5 = 0 - 1;
        for (int i5 = 0; i5 < world5.Units().ListFor(world5, 0).Count;
          i5 = i5 + 1) {
            UnitType t5 = world5.Units().TypeFor(world5, 0, i5);
            if (t5 != null && t5.Reg() == "E1") { e1id5 = i5; }
        }
        Report("shroud E1 in roster", e1id5 >= 0 ? 1 : 0, 1);
        // 找一张无光又可通行的格子落兵(离两家基地都远)。
        int sx5 = 0 - 1;
        int sy5 = 0 - 1;
        for (int cy5 = 12; cy5 <= 27 && sx5 < 0; cy5 = cy5 + 1) {
            for (int cx5 = 12; cx5 <= 27; cx5 = cx5 + 1) {
                if (sh5.At(cx5, cy5) == MapShroud.Unexplored()
                 && world5.PassableForRoute(cx5, cy5, false)) {
                    sx5 = cx5;
                    sy5 = cy5;
                    break;
                }
            }
        }
        Report("shroud dark spawn cell found", sx5 >= 0 ? 1 : 0, 1);
        int scout5 = world5.SpawnUnit(0, e1id5, sx5, sy5);
        Report("shroud scout spawned", scout5 >= 0 ? 1 : 0, 1);
        world5.Tick();
        WorldObject so5 = world5.ObjectAt(scout5);
        int sight5 = so5.UnitType().Sight();
        Report("shroud E1 sight parsed", sight5 > 0 ? 1 : 0, 1);
        int lit5 = 0;
        for (int dy5 = 0 - 1; dy5 <= 1; dy5 = dy5 + 1) {
            for (int dx5 = 0 - 1; dx5 <= 1; dx5 = dx5 + 1) {
                if (sh5.At(sx5 + dx5, sy5 + dy5)
                 == MapShroud.Explored()) { lit5 = lit5 + 1; }
            }
        }
        Report("shroud spawn reveal ring lit", lit5, 9);
        // 行军五格:走到的每一步都要把脚下与视野圈续上揭示。
        world5.ClearSelection();
        world5.AddSelectionByObject(so5);
        world5.OrderMove(sx5 + 5, sy5);
        int guard5 = 0;
        while (so5.X() == sx5 && guard5 < 400) { world5.Tick(); guard5 = guard5 + 1; }
        Report("shroud scout marched", so5.X() != sx5 ? 1 : 0, 1);
        Report("shroud march destination lit",
               sh5.At(so5.X(), so5.Y()) == MapShroud.Explored() ? 1 : 0, 1);
        // 收拾侦察兵:带着残存路线躺走廊里的兵,会顶死后面箱子场景的行兵。
        if (!so5.IsDead()) { so5.TakeDamage(so5.Hp()); }
        world5.Tick();
        // 临时揭示:首帧显形,75 逻辑帧到期塌回无光。
        sh5.RevealTemporarily(35, 8, 4);
        sh5.Update();
        Report("shroud temp reveal shows ground",
               sh5.At(35, 8) == MapShroud.TemporaryReveal() ? 1 : 0, 1);
        for (int t5 = 1; t5 < MapShroud.TempRevealTicks(); t5 = t5 + 1) {
            sh5.Update();
        }
        Report("shroud temp reveal expired",
               sh5.At(35, 8) == MapShroud.Unexplored() ? 1 : 0, 1);
        // Darken 位:间隙产生器的地基标记,开了要能关。
        sh5.ToggleFlagsAround(10, 10, 2, MapShroud.Darken(), true);
        Report("shroud darken set", sh5.Darkened(10, 10) ? 1 : 0, 1);
        sh5.ToggleFlagsAround(10, 10, 2, MapShroud.Darken(), false);
        Report("shroud darken cleared", sh5.Darkened(10, 10) ? 0 : 1, 1);

        // ---- 箱子 / 强化工具: reference 的 CrateGeneratorTrait 全链路 ----
        // 边缘列扫描只登记出生点不开箱;第一拍把场上补到下限;水箱只能
        // 掷水奖励;步兵踩上钉好的钱箱要吃掉它并入账;无 yard 无基地、
        // 钱够开局的指挥官从箱子里领回一辆 MCV,钱不够的滚进钱箱兜底。
        Rules cr6 = world5.Rules();
        world5.InitCrates(true);
        Report("crate init spawns nothing",
               world5.CrateCount() == 0 ? 1 : 0, 1);
        world5.Tick();
        Report("crate field topped up to floor",
               world5.CrateCount() >= cr6.CrateMinimum() ? 1 : 0, 1);
        Report("crate refuses out-of-bounds cell",
               world5.SpawnCrateAt(0 - 1, 0 - 1) ? 1 : 0, 0);
        // reference 的掷骰是 generateRandomInt(0, totalShares) 双端含:
        // 掷到 total 落空、这一枪不放箱,陆地水池都可能。落空合法;
        // 只要掷出编号,水箱就必须是 waterAllowed 的奖励。
        bool powOk6 = true;
        bool waterOk6 = true;
        for (int ri6 = 0; ri6 < 200; ri6 = ri6 + 1) {
            int p6 = world5.ChoosePowerup(false);
            if (p6 >= cr6.PowerupCount()) { powOk6 = false; }
            int q6 = world5.ChoosePowerup(true);
            if (q6 >= 0 && (q6 >= cr6.PowerupCount()
                         || !cr6.PowerupWaterAt(q6))) {
                waterOk6 = false;
            }
        }
        Report("crate powerup roll in range", powOk6 ? 1 : 0, 1);
        Report("crate water roll water-only", waterOk6 ? 1 : 0, 1);
        int moneyIdx6 = 0 - 1;
        int healIdx6 = 0 - 1;
        int unitIdx6 = 0 - 1;
        int explIdx6 = 0 - 1;
        int revIdx6 = 0 - 1;
        int tibIdx6 = 0 - 1;
        int icbmIdx6 = 0 - 1;
        for (int pi6 = 0; pi6 < cr6.PowerupCount(); pi6 = pi6 + 1) {
            int ty6 = cr6.PowerupTypeAt(pi6);
            if (ty6 == Rules.PowerupMoney()) { moneyIdx6 = pi6; }
            else if (ty6 == Rules.PowerupHealBase()) { healIdx6 = pi6; }
            else if (ty6 == Rules.PowerupUnit()) { unitIdx6 = pi6; }
            else if (ty6 == Rules.PowerupExplosion()) { explIdx6 = pi6; }
            else if (ty6 == Rules.PowerupReveal()) { revIdx6 = pi6; }
            else if (ty6 == Rules.PowerupTiberium()) { tibIdx6 = pi6; }
            else if (ty6 == Rules.PowerupICBM()) { icbmIdx6 = pi6; }
        }
        int px6 = 0 - 1;
        int py6 = 0 - 1;
        for (int sy6 = 12; sy6 < 28 && px6 < 0; sy6 = sy6 + 1) {
            for (int sx6 = 12; sx6 < 28; sx6 = sx6 + 1) {
                if (world5.CrateCanPlace(sx6, sy6)) {
                    px6 = sx6;
                    py6 = sy6;
                    break;
                }
            }
        }
        Report("crate placeable cell found", px6 >= 0 ? 1 : 0, 1);
        // 拾取场景:随补箱一只挡在后头的箱子,行兵从 (px6+2,py6) 走向钉在
        // (px6,py6) 的钱箱,吃箱的一列入账事件,箱子从场上消失。
        if (px6 >= 0 && moneyIdx6 >= 0 && e1id5 >= 0
         && world5.CrateCanPlace(px6 + 2, py6)) {
            world5.SpawnCratePinned(px6 + 3, py6, moneyIdx6, 9000);
            int walker6 = world5.SpawnUnit(0, e1id5, px6 + 2, py6);
            WorldObject wo6 = walker6 >= 0 ? world5.ObjectAt(walker6) : null;
            bool walkerOk6 = walker6 >= 0 && wo6 != null;
            bool placed6 = walkerOk6
                && world5.SpawnCratePinned(px6, py6, moneyIdx6, 9000);
            if (walkerOk6) {
                world5.ClearSelection();
                world5.AddSelectionByObject(wo6);
            }
            bool order6 = walkerOk6 ? world5.OrderMove(px6, py6) : false;
            Report("crate walker spawned and ordered",
                   walkerOk6 && placed6 && order6 ? 1 : 0, 1);
            int startX6 = walkerOk6 ? wo6.X() : 0 - 1;
            bool moved6 = false;
            int evBase6 = world5.EventCount();
            for (int t6 = 0; t6 < 300 && order6; t6 = t6 + 1) {
                world5.Tick();
                if (wo6.X() != startX6) { moved6 = true; }
                if (wo6.IsDead()) { break; }
                bool hit6 = false;
                for (int ei6 = evBase6; ei6 < world5.EventCount();
                  ei6 = ei6 + 1) {
                    if (world5.EventKindAt(ei6) == 1) { hit6 = true; break; }
                }
                if (hit6) { break; }
            }
            Report("crate walker moved", moved6 ? 1 : 0, 1);
            int money6 = 0;
            for (int ei6 = evBase6; ei6 < world5.EventCount();
              ei6 = ei6 + 1) {
                if (world5.EventKindAt(ei6) == 1
                 && world5.EventAmountAt(ei6) > 0) {
                    money6 = money6 + 1;
                }
            }
            Report("crate pickup queues money event", money6 > 0 ? 1 : 0, 1);
            Report("crate consumed by walker",
                   world5.CrateAt(px6, py6) < 0 ? 1 : 0, 1);
            if (!wo6.IsDead()) { wo6.TakeDamage(wo6.Hp()); }
            world5.Tick();
            world5.ClearSelection();
        }
        // 直发奖励:钱箱按 Data= 的 55%..145% 入账;治疗基地把本方全员
        // (含领箱者)顶满血;全图揭示把敌基地角点亮;单位箱在没有
        // CrateGoodie 车辆时、ICBM 在没有超武系统时,都滚进钱箱兜底。
        int grant6 = world5.SpawnUnit(0, e1id5, 20, 20);
        WorldObject so7 = grant6 >= 0 ? world5.ObjectAt(grant6) : null;
        if (so7 != null && moneyIdx6 >= 0) {
            int evM6 = world5.EventCount();
            world5.GrantPowerup(so7, moneyIdx6, so7.X(), so7.Y());
            int amount6 = 0;
            for (int ei6 = evM6; ei6 < world5.EventCount(); ei6 = ei6 + 1) {
                if (world5.EventKindAt(ei6) == 1
                 && world5.EventSideAt(ei6) == 0) {
                    amount6 = world5.EventAmountAt(ei6);
                }
            }
            Report("crate money pays in band",
                   amount6 >= 5500 && amount6 <= 14500 ? 1 : 0, 1);
        }
        if (so7 != null && healIdx6 >= 0) {
            so7.TakeDamage(so7.Hp() / 2);
            world5.GrantPowerup(so7, healIdx6, so7.X(), so7.Y());
            Report("crate healbase restores picker",
                   so7.Hp() == so7.MaxHp() ? 1 : 0, 1);
        }
        if (so7 != null && revIdx6 >= 0) {
            world5.GrantPowerup(so7, revIdx6, so7.X(), so7.Y());
            Report("crate reveal lights the far corner",
                   sh5.At(30, 30) == MapShroud.Explored() ? 1 : 0, 1);
        }
        if (so7 != null && unitIdx6 >= 0) {
            int evU6 = world5.EventCount();
            world5.GrantPowerup(so7, unitIdx6, so7.X(), so7.Y());
            bool paid6 = false;
            for (int ei6 = evU6; ei6 < world5.EventCount(); ei6 = ei6 + 1) {
                if (world5.EventKindAt(ei6) == 1
                 && world5.EventAmountAt(ei6) > 0) { paid6 = true; break; }
            }
            Report("crate unit without goodies pays money",
                   paid6 ? 1 : 0, 1);
        }
        if (so7 != null && icbmIdx6 >= 0) {
            int evI6 = world5.EventCount();
            world5.GrantPowerup(so7, icbmIdx6, so7.X(), so7.Y());
            bool paidI6 = false;
            for (int ei6 = evI6; ei6 < world5.EventCount(); ei6 = ei6 + 1) {
                if (world5.EventKindAt(ei6) == 1
                 && world5.EventAmountAt(ei6) > 0) { paidI6 = true; break; }
            }
            Report("crate icbm without superweapons pays money",
                   paidI6 ? 1 : 0, 1);
        }
        if (so7 != null && !so7.IsDead()) {
            so7.TakeDamage(so7.Hp());
            world5.Tick();
        }
        // 无基世界:没有建造场、没有可部署基地车的指挥官,钱够开局的从
        // 箱子里领回 MCV,钱不够的滚进钱箱兜底。两条路各验一遍,穷的先
        // 走,富的后走,免得先领的 MCV 把"无基地"前提顶掉。
        World world6 = World.Create(FlatMap(40, 40), sc, uc);
        world6.InitShrouds();
        world6.InitCrates(true);
        int e2id6 = world6.Units().IdOfReg(world6, 1, "E2");
        if (unitIdx6 >= 0 && e1id5 >= 0 && e2id6 >= 0) {
            int poor6 = world6.SpawnUnit(0, e1id5, 18, 18);
            WorldObject po6 = poor6 >= 0 ? world6.ObjectAt(poor6) : null;
            if (po6 != null) {
                world6.SetCreditSnap(0, 0);
                int evP6 = world6.EventCount();
                world6.GrantPowerup(po6, unitIdx6, 18, 18);
                bool paidP6 = false;
                for (int ei6 = evP6; ei6 < world6.EventCount();
                  ei6 = ei6 + 1) {
                    if (world6.EventKindAt(ei6) == 1) { paidP6 = true; break; }
                }
                Report("crate poor commander falls back to money",
                       paidP6 ? 1 : 0, 1);
            }
            int rich6 = world6.SpawnUnit(0, e1id5, 20, 20);
            WorldObject ro6 = rich6 >= 0 ? world6.ObjectAt(rich6) : null;
            if (ro6 != null) {
                world6.SetCreditSnap(0, 999999);
                world6.GrantPowerup(ro6, unitIdx6, 20, 20);
                int mcv6 = 0;
                for (int i6 = 0; i6 < world6.ObjectCount(); i6 = i6 + 1) {
                    WorldObject o6 = world6.ObjectAt(i6);
                    if (o6.Side() == 0 && !o6.IsDead()
                     && o6.Kind() == ObjKind.Unit()
                     && o6.UnitType() != null
                     && o6.UnitType().DeploysInto() != null
                     && o6.UnitType().DeploysInto().Length > 0) {
                        mcv6 = mcv6 + 1;
                    }
                }
                Report("crate free MCV walks out", mcv6 > 0 ? 1 : 0, 1);
            }
            // 爆炸弹:HE 弹头直接砸在领箱者脚下的格子上,同格的敌兵吃满额。
            int foe6 = world6.SpawnUnit(1, e2id6, 26, 20);
            WorldObject fo6 = foe6 >= 0 ? world6.ObjectAt(foe6) : null;
            if (fo6 != null && explIdx6 >= 0) {
                int hpBefore6 = fo6.Hp();
                world6.GrantPowerup(fo6, explIdx6, fo6.X(), fo6.Y());
                Report("crate blast hits the foe on the cell",
                       fo6.IsDead() || fo6.Hp() < hpBefore6 ? 1 : 0, 1);
            }
            // 矿箱:六掷半径 2,5x5 扫描总该落上一层矿。
            WorldObject giver6 = null;
            if (ro6 != null && !ro6.IsDead()) { giver6 = ro6; }
            else if (po6 != null && !po6.IsDead()) { giver6 = po6; }
            if (giver6 != null && tibIdx6 >= 0) {
                world6.GrantPowerup(giver6, tibIdx6, 20, 18);
                int ore6 = 0;
                for (int dy6 = 0 - 2; dy6 <= 2; dy6 = dy6 + 1) {
                    for (int dx6 = 0 - 2; dx6 <= 2; dx6 = dx6 + 1) {
                        if (world6.OreOvAt(20 + dx6, 18 + dy6) > 0) {
                            ore6 = ore6 + 1;
                        }
                    }
                }
                Report("crate tiberium grows ore", ore6 > 0 ? 1 : 0, 1);
            }
        }

        // ---- 声音: AUD 解码 / sound.ini / EVA / 主题 --------------------
        // 表文件是玩家安装的资产(本机没有也能静音跑),引擎语义全部用
        // 合成样件断言:AUD 三种编码的解码闭环、WAV 容器、sound.ini 的
        // Defaults/Control/Sounds 截断/Type 回退、EVA 的队列纪律、主题
        // 播放表、位置音量的距离衰减。
        int[] pcmS = new int[] { 1000, 0 - 2000, 30000, 0 - 30000 };
        byte[] pcmAud = PcmAud(pcmS);
        List<int> plen = new List<int>();
        plen.Add(0);
        AudSound pcmSnd = AudSound.Decode(pcmAud, pcmAud.Length);
        Report("aud pcm decodes", pcmSnd.Valid() ? 1 : 0, 1);
        Report("aud pcm rate",
               pcmSnd.Valid() ? pcmSnd.Rate() : 0 - 1, 22050);
        Report("aud pcm sample count",
               pcmSnd.Valid() ? pcmSnd.SampleCount() : 0 - 1, 4);
        Report("aud pcm sample value",
               pcmSnd.Valid() ? AuGet16(pcmSnd.Pcm(), 0) : 0 - 1, 1000);
        Report("aud pcm sample value 2",
               pcmSnd.Valid() ? AuGet16(pcmSnd.Pcm(), 2) : 0 - 1,
               0 - 2000);
        byte[] pcm8 = Au8(4);
        pcm8[0] = 200;
        pcm8[1] = 0;
        pcm8[2] = 128;
        pcm8[3] = 255;
        byte[] pcm8Aud = Pcm8Aud(pcm8);
        AudSound pcm8Snd = AudSound.Decode(pcm8Aud, pcm8Aud.Length);
        Report("aud 8bit widens silence-centered",
               pcm8Snd.Valid() ? AuGet16(pcm8Snd.Pcm(), 4) : 0 - 1, 0);
        Report("aud 8bit widens high",
               pcm8Snd.Valid() ? AuGet16(pcm8Snd.Pcm(), 6) : 0 - 1,
               32512);
        int[] imaS = new int[] { 0, 100, 200, 300, 200, 100, 0,
            0 - 100, 1200, 0 - 1200, 300, 0, 300, 0, 0 - 300, 0 };
        byte[] imaBuf = Au8(512);
        int imaLen = ImaAud(imaS, imaBuf, 512);
        Report("aud ima fixture built", imaLen > 0 ? 1 : 0, 1);
        AudSound imaSnd = AudSound.Fail();
        if (imaLen > 0) { imaSnd = AudSound.Decode(imaBuf, imaLen); }
        Report("aud ima decodes", imaSnd.Valid() ? 1 : 0, 1);
        Report("aud ima sample count",
               imaSnd.Valid() ? imaSnd.SampleCount() : 0 - 1, 16);
        Report("aud ima first sample exact",
               imaSnd.Valid() ? AuGet16(imaSnd.Pcm(), 0) : 0 - 1, 0);
        // 块头样本从预测器直接播种,必须逐位精确:第 3 块(样本 10)
        // 的目标是 300。
        Report("aud ima chunk head exact",
               imaSnd.Valid() ? AuGet16(imaSnd.Pcm(), 10 * 2) : 0 - 1,
               300);
        int imaErr = 0;
        for (int i = 0; i < 16 && imaSnd.Valid(); i = i + 1) {
            int gotS = AuGet16(imaSnd.Pcm(), i * 2);
            int err = gotS - imaS[i];
            if (err < 0) { err = 0 - err; }
            if (err > imaErr) { imaErr = err; }
        }
        Report("aud ima error bounded", imaErr <= 3500 ? 1 : 0, 1);
        Report("aud rejects garbage",
               AudSound.Decode(Au8(16), 16).Valid() ? 1 : 0, 0);
        byte[] tiny = Au8(4);
        Report("aud rejects truncated",
               AudSound.Decode(tiny, 4).Valid() ? 1 : 0, 0);
        byte[] wav = AudSound.WavContainer(pcmSnd.Pcm(), 22050);
        Report("wav container riff tag",
               wav[0] == 82 && wav[1] == 73 && wav[2] == 70
               && wav[3] == 70 ? 1 : 0, 1);
        Report("wav container size",
               wav.Length == 44 + 8 ? 1 : 0, 1);
        // 本机时长断言需要 1ms 以上,4 个样本不足——补一段 2205 样本
        // (22050Hz 下正好 100ms)的静音去走原生装载。
        byte[] longPcm = Au8(2205 * 2);
        byte[] wavLong = AudSound.WavContainer(longPcm, 22050);
        AudioClip wavClip = AudioClip.LoadWavFromMem(
            wavLong.ToStr(0, wavLong.Length), wavLong.Length);
        Report("wav container parses natively",
               wavClip.IsValid() ? 1 : 0, 1);
        Report("wav clip frequency",
               wavClip.IsValid() ? wavClip.Frequency() : 0 - 1, 22050);
        Report("wav clip duration",
               wavClip.IsValid() && wavClip.DurationMs() > 0 ? 1 : 0, 1);

        // sound.ini 解析:Defaults 承底、$ 引用剥离、Sounds= 行内 Control=
        // 截断、Range=-2 化无穷、Type 缺空间类时回退 Defaults。
        string soundIni = "[Defaults]\n"
            + "MinVolume=20\nRange=10\nVolume=50\nLimit=1\n"
            + "Type=Screen\nPriority=Normal\n"
            + "[SoundList]\n1=MyShot\n2=MyLoop\n3=MyProbe\n"
            + "[MyShot]\nSounds=$alpha $beta Control=Random\nVolume=80\n"
            + "Delay=100 200\nType=Local\nRange=-2\nLimit=3\nLoop=5\n"
            + "MinVolume=25\nVShift=40 60\nAttack=1\nDecay=1\n"
            + "Control=Interrupt\n"
            + "[MyLoop]\nSounds=solo\nType=Global Normal\n"
            + "[MyProbe]\nType=Player\n";
        SoundSpecs specs = SoundSpecs.Parse(IniParser.Parse(soundIni));
        Report("sound ini parses three specs", specs.Count(), 3);
        SoundSpec shot = specs.Spec("myshot");
        Report("sound spec lookup caseless", shot != null ? 1 : 0, 1);
        Report("sound spec dollar strip",
               shot != null && shot.sounds.Count == 2
               && shot.sounds[0] == "alpha" && shot.sounds[1] == "beta"
                   ? 1 : 0, 1);
        Report("sound spec volume", shot != null ? shot.volume : 0 - 1,
               80);
        Report("sound spec delay pair",
               shot != null && shot.delaySet && shot.delayMin == 100
               && shot.delayMax == 200 ? 1 : 0, 1);
        Report("sound spec range inf",
               shot != null ? shot.range : 0, 2147483647);
        Report("sound spec limit", shot != null ? shot.limit : 0 - 1, 3);
        Report("sound spec loop", shot != null ? shot.loop : 0 - 1, 5);
        Report("sound spec minvolume",
               shot != null ? shot.minVolume : 0 - 1, 25);
        Report("sound spec vshift pair",
               shot != null && shot.vShiftSet && shot.vShiftMin == 40
               && shot.vShiftMax == 60 ? 1 : 0, 1);
        // 参考的 parseSoundNames 把 Sounds= 行内第一个 control= 起的
        // token 截断丢弃——Control 位只来自独立的 Control= 键,行内那份
        // 不生效。所以位里只有 Interrupt,没有 Random。
        Report("sound spec controls",
               shot != null
               && (shot.controlBits & (SndSpecText.ControlRandom()
                  | SndSpecText.ControlAttack()
                  | SndSpecText.ControlDecay())) == 0
               && (shot.controlBits & SndSpecText.ControlInterrupt()) != 0
                   ? 1 : 0, 1);
        SoundSpec loop = specs.Spec("MyLoop");
        Report("sound spec default limit",
               loop != null ? loop.limit : 0 - 1, 1);
        Report("sound spec default volume",
               loop != null ? loop.volume : 0 - 1, 50);
        Report("sound spec global type",
               loop != null
               && (loop.typeBits & SndSpecText.TypeGlobal()) != 0 ? 1 : 0,
               1);
        SoundSpec probe = specs.Spec("MyProbe");
        Report("sound spec type fallback adds screen",
               probe != null
               && (probe.typeBits & SndSpecText.TypePlayer()) != 0
               && (probe.typeBits & SndSpecText.TypeScreen()) != 0
                   ? 1 : 0, 1);

        // 位置音量:Local 的 range*sqrt2 截断 + 平方衰减,Screen 的线性
        // 衰减,Global 的他房 MinVolume。
        SndEngine engineS = SndEngine.Create();
        engineS.SetViewport(20.0, 20.0, 600.0, 300.0);
        SoundSpec localSpec = new SoundSpec();
        localSpec.name = "LocalSpec";
        localSpec.typeBits = SndSpecText.TypeLocal();
        localSpec.range = 10;
        localSpec.volume = 100;
        localSpec.sounds = new List<string>();
        localSpec.sounds.Add("a");
        int volCenter = (int)(engineS.EffectVolume(localSpec, 20.0, 20.0,
            0, 1.0) * 1000.0);
        Report("world local at center full", volCenter, 1000);
        int volHalf = (int)(engineS.EffectVolume(localSpec, 27.0, 20.0,
            0, 1.0) * 1000.0);
        Report("world local half range falls",
               volHalf > 700 && volHalf < 800 ? 1 : 0, 1);
        int volFar = (int)(engineS.EffectVolume(localSpec, 40.0, 20.0,
            0, 1.0) * 1000.0);
        Report("world local past range silent", volFar, 0);
        SoundSpec screenSpec = new SoundSpec();
        screenSpec.name = "ScreenSpec";
        screenSpec.typeBits = SndSpecText.TypeScreen();
        screenSpec.volume = 100;
        screenSpec.sounds = new List<string>();
        screenSpec.sounds.Add("a");
        int volScreen = (int)(engineS.EffectVolume(screenSpec, 20.0 + 75.0,
            20.0, 0, 1.0) * 1000.0);
        Report("world screen half falloff", volScreen, 500);
        SoundSpec globalSpec = new SoundSpec();
        globalSpec.name = "GlobalSpec";
        globalSpec.typeBits = SndSpecText.TypeGlobal();
        globalSpec.volume = 100;
        globalSpec.minVolume = 20;
        globalSpec.sounds = new List<string>();
        globalSpec.sounds.Add("a");
        int volGlobal = (int)(engineS.EffectVolume(globalSpec, 0.0, 0.0,
            1, 1.0) * 1000.0);
        Report("world global other side minvolume", volGlobal, 200);
        Report("world no-shroud list",
               SndEngine.NoShroudKey("SellSound")
               && !SndEngine.NoShroudKey("MyShot") ? 1 : 0, 1);

        // eva.ini:侧别列、优先级、队列;EVA 的等待纪律(优先级说话、
        // 五秒冷却、批量只留一条)。
        string evaIni = "[DialogList]\n1=000I000\n2=000I002\n3=000I003\n"
            + "[000I000]\nText=Construction complete\nAllied=CONCOMP1\n"
            + "Russian=CONCOMP1\nPriority=Important\n"
            + "[000I002]\nText=Unit ready\nAllied=UNITRDY1\n"
            + "Russian=UNITRDY1\nType=queue\n"
            + "[000I003]\nText=Low power\nAllied=LOWPWR1\n"
            + "Russian=LOWPWR1\nPriority=Critical\n";
        SndEngine engineE = SndEngine.Create();
        engineE.evaSpecs = EvaSpecs.Parse(IniParser.Parse(evaIni), 0);
        engineE.eva = Eva.Create(engineE.evaSpecs, engineE);
        Report("eva side prefix allied",
               EvaSpecs.PrefixForSide(Side2.Allied()) == "Allied" ? 1 : 0,
               1);
        Report("eva table parsed", engineE.EvaCount(), 3);
        EvaSpec comp = engineE.evaSpecs.Spec("000I000");
        Report("eva sound column",
               comp != null && comp.sound == "CONCOMP1" ? 1 : 0, 1);
        Report("eva priority important",
               comp != null && comp.priority == 2 ? 1 : 0, 1);
        EvaSpec ready = engineE.evaSpecs.Spec("000I002");
        Report("eva queue flag",
               ready != null && ready.queue ? 1 : 0, 1);
        engineE.EvaPlay("000I000", false);
        engineE.EvaPlay("000I003", false);
        engineE.eva.Update(0);
        Report("eva critical speaks first",
               engineE.eva.waiting.Count == 1
               && engineE.eva.waiting[0] == comp ? 1 : 0, 1);
        engineE.eva.Update(1);
        Report("eva queue drains", engineE.eva.waiting.Count, 0);
        engineE.EvaPlay("000I000", false);
        engineE.eva.Update(100);
        Report("eva cooldown holds",
               engineE.eva.waiting.Count == 0
               && !engineE.EvaSpeaking() ? 1 : 0, 1);
        engineE.EvaPlay("000I000", false);
        engineE.eva.Update(5200);
        bool spoke5200 = false;
        for (int i = 0; i < engineE.eva.lastPlayedNames.Count;
          i = i + 1) {
            if (engineE.eva.lastPlayedNames[i] == "CONCOMP1"
             && engineE.eva.lastPlayedAt[i] == 5200) {
                spoke5200 = true;
            }
        }
        Report("eva cooldown releases", spoke5200 ? 1 : 0, 1);

        // theme.ini:Normal 出播放表、Repeat 循环、shuffle 同集、选项串
        // 序列化往返。
        string themeIni = "[Themes]\n1=GRIND\n2=DEFEND\n3=HIDEF\n"
            + "[GRIND]\nName=Grinder\nSound=GRINDER\nNormal=yes\n"
            + "[DEFEND]\nName=Defend\nSound=DEFEND\nNormal=yes\n"
            + "Repeat=yes\n"
            + "[HIDEF]\nName=Hidden\nSound=HIDDEN\nNormal=no\n";
        SndEngine engineM = SndEngine.Create();
        engineM.musicSpecs = MusicSpecs.Parse(IniParser.Parse(themeIni));
        engineM.music = MusicPlayer.Create(engineM.musicSpecs, engineM);
        Report("music table parsed", engineM.MusicCount(), 3);
        List<MusicSpec> playlist = engineM.music.BuildPlaylist(false);
        Report("music playlist normal only", playlist.Count, 2);
        List<MusicSpec> shuffled = engineM.music.BuildPlaylist(true);
        Report("music shuffle same set",
               shuffled.Count == 2
               && (shuffled[0] != shuffled[1]) ? 1 : 0, 1);
        engineM.music.UnserializeOptions("1,1,Defend");
        // 参考语义:反序列化把 "Defend" 存进 initialRepeatName(播放时
        // 从播放表里找它起播),但此刻没有已装载的播放表,序列化时名字
        // 段落空——"1,1," 而不是回显输入。
        Report("music options roundtrip",
               engineM.music.ShuffleMode()
               && engineM.music.RepeatMode()
               && engineM.music.initialRepeatName == "Defend"
               && engineM.music.SerializeOptions() == "1,1,"
                   ? 1 : 0, 1);
        // 混音台:滑条、静音、序列化。
        engineM.SetVolume(Ch.Voice(), 0.5);
        Report("mixer voice volume",
               engineM.ChannelGainOf(Ch.Voice()) == 0.5 ? 1 : 0, 1);
        engineM.SetMuted(Ch.Voice(), true);
        Report("mixer voice mute",
               engineM.ChannelGainOf(Ch.Voice()) < 0.001 ? 1 : 0, 1);
        engineM.SetMuted(Ch.Voice(), false);
        Report("mixer unmute keeps slider",
               engineM.ChannelGainOf(Ch.Voice()) == 0.5 ? 1 : 0, 1);
        string mix = engineM.SerializeMixer();
        engineM.SetVolume(Ch.Voice(), 1.0);
        engineM.UnserializeMixer(mix);
        Report("mixer serialize roundtrip",
               engineM.ChannelGainOf(Ch.Voice()) == 0.5 ? 1 : 0, 1);

        // ---- 武器声/口令声:SoundHandler 的设备无关逻辑 -----------------
        // 规则转录:Report= 逗号表、弹头 ElectricAssault=、TechnoVoices
        // 八个 Voice* 键,全部从 ApplyIni 的分层环进来。
        Rules rulesV = Rules.Default();
        rulesV.ApplyIni(IniParser.Parse(
            "[M60]\nReport=GunA, GunB\n"
            + "[SA]\nElectricAssault=yes\n"
            + "[E1]\nVoiceSelect=GSelect\nVoiceMove=GMove\n"
            + "VoiceAttack=GAttack\nVoiceEnter=GEnter\n"
            + "VoiceCapture=GCapture\nVoiceSpecialAttack=GSpecial\n"
            + "VoiceFeedback=GFeedback\nVoiceCrashing=GCrash\n"));
        Weapon gunV = rulesV.WeaponNamed("M60");
        Warhead saV = rulesV.WarheadNamed("SA");
        TechnoVoices gv = null;
        UnitDef e1V = rulesV.UnitDefNamed("E1");
        if (e1V != null) { gv = e1V.Voices(); }
        Report("weapon report parsed",
               gunV != null ? gunV.ReportCount() : 0 - 1, 2);
        Report("weapon report entry",
               gunV != null && SndSpecText.SameWord(gunV.ReportAt(1), "GunB")
                   ? 1 : 0, 1);
        Report("warhead electric assault",
               saV != null && saV.ElectricAssault() ? 1 : 0, 1);
        Report("unit voices transcribed",
               gv != null
               && SndSpecText.SameWord(gv.Select(), "GSelect")
               && SndSpecText.SameWord(gv.Move(), "GMove")
               && SndSpecText.SameWord(gv.Crashing(), "GCrash") ? 1 : 0, 1);
        // 口令回退链,参考 handleOrderPushed 的 switch;缺键的链按
        // 参考落到备选,全空落 ""。
        Report("order voice attack",
               SndSpecText.SameWord(
                   SndEngine.OrderVoiceName(gv, OrderFeedback.Attack()),
                   "GAttack") ? 1 : 0, 1);
        Report("order voice move",
               SndSpecText.SameWord(
                   SndEngine.OrderVoiceName(gv, OrderFeedback.Move()),
                   "GMove") ? 1 : 0, 1);
        Report("order voice enter",
               SndSpecText.SameWord(
                   SndEngine.OrderVoiceName(gv, OrderFeedback.Enter()),
                   "GEnter") ? 1 : 0, 1);
        Report("order voice capture",
               SndSpecText.SameWord(
                   SndEngine.OrderVoiceName(gv, OrderFeedback.Capture()),
                   "GCapture") ? 1 : 0, 1);
        Report("order voice special",
               SndSpecText.SameWord(
                   SndEngine.OrderVoiceName(gv,
                       OrderFeedback.SpecialAttack()),
                   "GSpecial") ? 1 : 0, 1);
        TechnoVoices partial = TechnoVoices.Create();
        partial.ReadIni(IniParser.Parse(
            "[T]\nVoiceMove=BMove\nVoiceAttack=BAttack\n").Section("T"));
        Report("order voice enter falls to move",
               SndSpecText.SameWord(
                   SndEngine.OrderVoiceName(partial, OrderFeedback.Enter()),
                   "BMove") ? 1 : 0, 1);
        Report("order voice capture falls empty",
               SndEngine.OrderVoiceName(partial,
                   OrderFeedback.Capture()).Length == 0 ? 1 : 0, 1);
        Report("order voice special falls attack",
               SndSpecText.SameWord(
                   SndEngine.OrderVoiceName(partial,
                       OrderFeedback.SpecialAttack()),
                   "BAttack") ? 1 : 0, 1);
        TechnoVoices quiet = TechnoVoices.Create();
        Report("order voice none empty",
               SndEngine.OrderVoiceName(quiet,
                   OrderFeedback.Move()).Length == 0 ? 1 : 0, 1);
        // 电击弹头的火线音量打 25 折,其余全量;随机挑名永远落在表内。
        SndEngine engineV = SndEngine.Create();
        Weapon plainW = Weapon.Create("P", 10, 20, 4,
            Warhead.Create("PW", "100"));
        Weapon eaW = Weapon.Create("E", 10, 20, 4,
            Warhead.Create("EW", "100"));
        eaW.Warhead().SetElectricAssault(true);
        Report("report gain full",
               (int)(engineV.ReportGain(plainW) * 1000.0), 1000);
        Report("report gain quarter",
               (int)(engineV.ReportGain(eaW) * 1000.0), 250);
        Weapon repW = Weapon.Create("R", 10, 20, 4, null);
        List<string> repNames = new List<string>();
        repNames.Add("RA");
        repNames.Add("RB");
        repNames.Add("RC");
        repW.SetReport(repNames);
        bool pickOk = repW.ReportCount() > 0;
        for (int i = 0; i < 30 && pickOk; i = i + 1) {
            string p = engineV.ReportPick(repW);
            if (!SndSpecText.SameWord(p, "RA")
             && !SndSpecText.SameWord(p, "RB")
             && !SndSpecText.SameWord(p, "RC")) {
                pickOk = false;
            }
        }
        Report("report pick in set", pickOk ? 1 : 0, 1);
        // 循环报告判定:Control=Loop/Ambient 命中,判定按名字缓存。没有
        // [Defaults] 的表按参考语义整表弃用,所以样表必须带 Defaults。
        string loopIni = "[Defaults]\nVolume=100\n"
            + "[SoundList]\n1=LoopShot\n2=PlainShot\n"
            + "[LoopShot]\nSounds=ls\nControl=Loop\n"
            + "[PlainShot]\nSounds=ps\n";
        SndEngine engineL = SndEngine.Create();
        engineL.specs = SoundSpecs.Parse(IniParser.Parse(loopIni));
        Report("loop report detects loop",
               engineL.IsLoopReport("LoopShot") ? 1 : 0, 1);
        Report("loop report plain",
               engineL.IsLoopReport("PlainShot") ? 1 : 0, 0);
        Report("loop report cache hits",
               engineL.IsLoopReport("LoopShot") ? 1 : 0, 1);
        // 250ms 口令窗:两类反馈共享;说话才花窗(select 事件先花窗再
        // 查名,口令是有名才花窗)。
        SndEngine engineF = SndEngine.Create();
        TechnoVoices fv = TechnoVoices.Create();
        fv.ReadIni(IniParser.Parse(
            "[T]\nVoiceMove=FMove\nVoiceAttack=FAttack\n").Section("T"));
        engineF.PlayOrderVoice(fv, OrderFeedback.Move(), 1000);
        Report("feedback window set",
               engineF.lastFeedbackMs == 1000 ? 1 : 0, 1);
        engineF.PlayOrderVoice(fv, OrderFeedback.Attack(), 1100);
        Report("feedback window holds",
               engineF.lastFeedbackMs == 1000 ? 1 : 0, 1);
        engineF.PlayOrderVoice(fv, OrderFeedback.Attack(), 1300);
        Report("feedback window passes",
               engineF.lastFeedbackMs == 1300 ? 1 : 0, 1);
        SndEngine engineG = SndEngine.Create();
        engineG.PlayOrderVoice(quiet, OrderFeedback.Move(), 500);
        Report("silent kind keeps window",
               engineG.lastFeedbackMs == 0 ? 1 : 0, 1);
        engineG.PlaySelectVoice(quiet, 2000);
        Report("select spends window",
               engineG.lastFeedbackMs == 2000 ? 1 : 0, 1);
        // 键名分流:SoundKey 枚举名走 rules 的 [AudioVisual],其余名字
        // 直接查 sound.ini——报告名与口令名永不误入 rules 映射。
        SndEngine engineK = SndEngine.Create();
        engineK.specs = SoundSpecs.Parse(IniParser.Parse(
            "[Defaults]\nVolume=100\n"
            + "[SoundList]\n1=MyVoice\n2=Sell1\n"
            + "[MyVoice]\nSounds=v1\n[Sell1]\nSounds=s1\n"));
        engineK.rules = IniParser.Parse(
            "[AudioVisual]\nSellSound=Sell1\n");
        Report("sound key name routes rules",
               engineK.SpecForKey("SellSound") != null ? 1 : 0, 1);
        Report("plain name direct",
               engineK.SpecForKey("MyVoice") != null ? 1 : 0, 1);
        Report("unmapped key silent",
               engineK.SpecForKey("RadarOn") == null ? 1 : 0, 1);
        // ---- SoundHandler 事件位 ----------------------------------------
        // 箱子音/EVA 映射表:Veteran→CratePromote、Money→CrateMoney、
        // Reveal→CrateReveal、Firepower→CrateFire、Armor→CrateArmour、
        // Speed→CrateSpeed、Unit→CrateUnit;EVA 只有 Armor/Firepower/Speed
        // 三类(SoundHandler crateSoundByType / crateEvaByType)。
        Report("crate sound veteran",
               SndEngine.CrateSoundOfType(Rules.PowerupVeteran())
                   == "CratePromoteSound" ? 1 : 0, 1);
        Report("crate sound money",
               SndEngine.CrateSoundOfType(Rules.PowerupMoney())
                   == "CrateMoneySound" ? 1 : 0, 1);
        Report("crate sound reveal",
               SndEngine.CrateSoundOfType(Rules.PowerupReveal())
                   == "CrateRevealSound" ? 1 : 0, 1);
        Report("crate sound firepower",
               SndEngine.CrateSoundOfType(Rules.PowerupFirepower())
                   == "CrateFireSound" ? 1 : 0, 1);
        Report("crate sound armour",
               SndEngine.CrateSoundOfType(Rules.PowerupArmor())
                   == "CrateArmourSound" ? 1 : 0, 1);
        Report("crate sound speed",
               SndEngine.CrateSoundOfType(Rules.PowerupSpeed())
                   == "CrateSpeedSound" ? 1 : 0, 1);
        Report("crate sound unit",
               SndEngine.CrateSoundOfType(Rules.PowerupUnit())
                   == "CrateUnitSound" ? 1 : 0, 1);
        Report("crate sound unmapped null",
               SndEngine.CrateSoundOfType(Rules.PowerupDarkness()) == null
                   ? 1 : 0, 1);
        Report("crate eva armor",
               SndEngine.CrateEvaOfType(Rules.PowerupArmor())
                   == "EVA_UnitArmorUpgraded" ? 1 : 0, 1);
        Report("crate eva firepower",
               SndEngine.CrateEvaOfType(Rules.PowerupFirepower())
                   == "EVA_UnitFirePowerUpgraded" ? 1 : 0, 1);
        Report("crate eva speed",
               SndEngine.CrateEvaOfType(Rules.PowerupSpeed())
                   == "EVA_UnitSpeedUpgraded" ? 1 : 0, 1);
        Report("crate eva unmapped null",
               SndEngine.CrateEvaOfType(Rules.PowerupMoney()) == null
                   ? 1 : 0, 1);
        // 箱子事件的门:敌方拾取静音(不进 EVA 队列),本方拾取 Armor
        // 进 EVA 队列,Money 只有声没有 EVA;HealBase 从 [CrateRules] 取名。
        SndEngine engineC = SndEngine.Create();
        engineC.specs = SoundSpecs.Parse(IniParser.Parse(
            "[Defaults]\nVolume=100\n"
            + "[SoundList]\n1=CrateMoneySound\n2=HealCrate1\n"
            + "[CrateMoneySound]\nSounds=cm\n[HealCrate1]\nSounds=hc\n"));
        engineC.evaSpecs = EvaSpecs.Parse(IniParser.Parse(
            "[DialogList]\n1=EVA_UnitArmorUpgraded\n"
            + "[EVA_UnitArmorUpgraded]\nText=upgraded\nRussian=eva1\n"), 0);
        engineC.eva = Eva.Create(engineC.evaSpecs, engineC);
        Rules crateRules = Rules.Default();
        crateRules.ApplyIni(IniParser.Parse(
            "[CrateRules]\nHealCrateSound=HealCrate1\n"));
        Report("heal crate sound parsed",
               crateRules.HealCrateSound() == "HealCrate1" ? 1 : 0, 1);
        engineC.CratePickupFeedback(1, 3, 4, Rules.PowerupArmor(),
                                    crateRules);
        Report("crate hostile silent", engineC.EvaQueueCount(), 0);
        engineC.CratePickupFeedback(0, 3, 4, Rules.PowerupArmor(),
                                    crateRules);
        Report("crate own eva queues", engineC.EvaQueueCount(), 1);
        engineC.CratePickupFeedback(0, 3, 4, Rules.PowerupMoney(),
                                    crateRules);
        Report("crate money no eva", engineC.EvaQueueCount(), 1);
        // TechnoRules 声音键:单位的 CreateSound/DeploySound/UndeploySound/
        // DieSound 与建筑的 SlamSound/DieSound,普通 sound.ini 名直读。
        Rules keyRules = Rules.Default();
        keyRules.ApplyIni(IniParser.Parse(
            "[E1]\nCreateSound=GiMake\nDeploySound=GiSit\n"
            + "UndeploySound=GiStand\nDieSound=GiDie\n"
            + "[GACNST]\nSlamSound=MySlam\nDieSound=MyBDie\n"));
        UnitDef giKeys = keyRules.UnitDefNamed("E1");
        BuildingDef cnstKeys = keyRules.BuildingDefNamed("GACNST");
        Report("unit create sound",
               giKeys != null && giKeys.CreateSound() == "GiMake" ? 1 : 0, 1);
        Report("unit deploy sound",
               giKeys != null && giKeys.DeploySound() == "GiSit" ? 1 : 0, 1);
        Report("unit undeploy sound",
               giKeys != null && giKeys.UndeploySound() == "GiStand"
                   ? 1 : 0, 1);
        Report("unit die sound",
               giKeys != null && giKeys.DieSound() == "GiDie" ? 1 : 0, 1);
        Report("building slam sound",
               cnstKeys != null && cnstKeys.SlamSound() == "MySlam"
                   ? 1 : 0, 1);
        Report("building die sound",
               cnstKeys != null && cnstKeys.DieSound() == "MyBDie"
                   ? 1 : 0, 1);
        // 建筑损伤阈值:参考的跨越判定——打后血量在阈值上/下沿的两次
        // 比较用整数精确算,黄 50/红 25,满血 100。
        Report("damage cross none",
               SndEngine.DamageCross(70, 100, 30, 50, 25) ? 1 : 0, 0);
        Report("damage cross yellow",
               SndEngine.DamageCross(40, 100, 30, 50, 25) ? 1 : 0, 1);
        Report("damage cross red",
               SndEngine.DamageCross(10, 100, 30, 50, 25) ? 1 : 0, 1);
        Report("damage cross overkill",
               SndEngine.DamageCross(0, 100, 100, 50, 25) ? 1 : 0, 1);
        Report("damage cross above",
               SndEngine.DamageCross(60, 100, 30, 50, 25) ? 1 : 0, 0);
        // 新增科技判定:当前集合里有上一个集合没有的名字才算新增
        // (handleAvailableObjectsUpdate);首次观察传 null 不播。
        List<string> availA = new List<string>();
        availA.Add("GACNST");
        List<string> availB = new List<string>();
        availB.Add("GACNST");
        availB.Add("GAPOWR");
        List<string> availShrink = new List<string>();
        availShrink.Add("GACNST");
        Report("avail first update silent",
               SndEngine.HasNewName(null, availB) ? 1 : 0, 0);
        Report("avail same silent",
               SndEngine.HasNewName(availA, availA) ? 1 : 0, 0);
        Report("avail grow announces",
               SndEngine.HasNewName(availA, availB) ? 1 : 0, 1);
        Report("avail shrink silent",
               SndEngine.HasNewName(availB, availShrink) ? 1 : 0, 0);
        // 迷雾门(SoundHandler 经 WorldSound):不在免雾名单的键在未探索
        // 地面静音,免雾名单(BuildingSlam 等)穿透,Global 全通。
        SndEngine engineS2 = SndEngine.Create();
        engineS2.specs = SoundSpecs.Parse(IniParser.Parse(
            "[Defaults]\nVolume=100\n"
            + "[SoundList]\n1=SomeBoom\n2=BuildingSlam\n3=GlobalBoom\n"
            + "[SomeBoom]\nSounds=b1\n[BuildingSlam]\nSounds=bs\n"
            + "[GlobalBoom]\nSounds=g1\nType=global\n"));
        MapShroud sndShroud = MapShroud.Create(8, 8);
        Report("shroud mutes plain key",
               engineS2.ShroudedOut("SomeBoom", 3, 3, sndShroud) ? 1 : 0, 1);
        Report("shroud passes slam",
               engineS2.ShroudedOut("BuildingSlam", 3, 3, sndShroud)
                   ? 1 : 0, 0);
        Report("shroud passes global",
               engineS2.ShroudedOut("GlobalBoom", 3, 3, sndShroud) ? 1 : 0,
               0);
        // ---- 经验等级 (VeteranTrait) -------------------------------------
        // 规则解析:VeteranRatio 等因子走千分位 (1000 = 1.0),VeteranSight
        // 下限 1000,VeteranCap 默认 2,InitialVeteran 默认关。
        Rules vetRules = Rules.Default();
        vetRules.ApplyIni(IniParser.Parse(
            "[General]\nVeteranRatio=3\nVeteranCombat=1.2\n"
            + "VeteranSight=0.9\nVeteranArmor=1.5\nVeteranROF=0.8\n"
            + "VeteranSpeed=1.1\nVeteranCap=1\nInitialVeteran=yes\n"));
        Report("vet ratio parsed",
               vetRules.VeteranRatioM() == 3000 ? 1 : 0, 1);
        Report("vet combat parsed",
               vetRules.VeteranCombatM() == 1200 ? 1 : 0, 1);
        Report("vet sight floored",
               vetRules.VeteranSightM() == 1000 ? 1 : 0, 1);
        Report("vet armor parsed",
               vetRules.VeteranArmorM() == 1500 ? 1 : 0, 1);
        Report("vet rof parsed",
               vetRules.VeteranRofM() == 800 ? 1 : 0, 1);
        Report("vet speed parsed",
               vetRules.VeteranSpeedM() == 1100 ? 1 : 0, 1);
        Report("vet cap parsed", vetRules.VeteranCap() == 1 ? 1 : 0, 1);
        Report("initial veteran parsed",
               vetRules.InitialVeteran() ? 1 : 0, 1);
        Report("vet defaults intact",
               Rules.Default().VeteranCap() == 2 ? 1 : 0, 1);
        // 能力表解析:VeteranAbilities 进 veteran 集合,EliteAbilities 并入
        // elite 集合(参考的 union);未知名跳过。
        Rules vetRules2 = Rules.Default();
        vetRules2.ApplyIni(IniParser.Parse(
            "[E1]\nVeteranAbilities=STRONGER, ROF, NotAnAbility\n"
            + "EliteAbilities=FIREPOWER, SIGHT\n"));
        UnitDef vetGi = vetRules2.UnitDefNamed("E1");
        Report("vet abilities parsed",
               vetGi != null && vetGi.VeteranAbilities().Count == 2
               && vetGi.VeteranAbilities().Contains(VetAbility.Stronger())
               && vetGi.VeteranAbilities().Contains(VetAbility.Rof())
                   ? 1 : 0, 1);
        Report("elite abilities union",
               vetGi != null && vetGi.EliteAbilities().Count == 4
               && vetGi.EliteAbilities().Contains(VetAbility.Firepower())
                   ? 1 : 0, 1);
        // 阈值与升级:cost * ratio/1000 + 1;XP 跨线晋级,溢出结转,封顶
        // 停涨(gainXP 的整数语义)。
        // 经验等级运行时:一个无 theater 的小地图世界(水域回退、道路
        // 默认全通),规则用默认档,单位摆开验证阈值/倍率/封顶。
        Rules vetWorldRules = Rules.Default();
        vetWorldRules.ApplyIni(IniParser.Parse(
            "[General]\nVeteranArmor=1.5\nVeteranCombat=1.2\n"
            + "InitialVeteran=yes\n"
            + "[E1]\nVeteranAbilities=STRONGER\n"
            + "EliteAbilities=FIREPOWER\n"));
        World vetWorld = World.Create(
            MapFile.Parse("[Map]\nSize=0,0,20,20\nLocalSize=0,0,20,20\n")
                .Terrain(),
            StructureCatalog.CreateWith(vetWorldRules),
            UnitCatalog.CreateWith(vetWorldRules));
        Rules wRules = vetWorld.Rules();
        int vetId = 0 - 1;
        for (int i = 0; i < vetWorld.Units().ListFor(vetWorld, 0).Count;
             i = i + 1) {
            UnitType tt = vetWorld.Units().TypeFor(vetWorld, 0, i);
            if (tt != null && tt.Reg() == "E1") { vetId = i; break; }
        }
        Report("vet unit present", vetId >= 0 ? 1 : 0, 1);
        if (vetId >= 0) {
            WorldObject v1 = vetWorld.SpawnUnit(0, vetId, 5, 5) >= 0
                ? vetWorld.ObjectAt(vetWorld.ObjectCount() - 1) : null;
            UnitType vetType = vetWorld.Units().TypeFor(vetWorld, 0, vetId);
            int thresh = vetType != null
                ? wRules.VeteranRatioM() * vetType.Cost() / 1000 + 1 : 1;
            Report("threshold maths",
                   vetWorld.PromoteThreshold(v1) == thresh ? 1 : 0, 1);
            vetWorld.GainVetXp(v1, thresh - 1);
            Report("xp below line",
                   v1.VeteranLevel() == 0 && v1.VeteranXp() == thresh - 1
                       ? 1 : 0, 1);
            vetWorld.GainVetXp(v1, 1);
            Report("xp crosses line",
                   v1.VeteranLevel() == 1 && v1.VeteranXp() == 0 ? 1 : 0, 1);
            // 从 1 级起一笔跨两级:新等级 = 1 + (0 + 2t+5)/t,封顶 2,
            // 消耗 (2-1) 段阈值,余 xp = 2t+5 - t = t+5(gainXP 的整数语义:
            // 溢出结转,不是从零重新计数)。
            vetWorld.GainVetXp(v1, thresh * 2 + 5);
            Report("xp overflow carries",
                   v1.VeteranLevel() == 2 && v1.VeteranXp() == thresh + 5
                       ? 1 : 0, 1);
            vetWorld.GainVetXp(v1, thresh * 3);
            Report("xp capped at cap",
                   v1.VeteranLevel() == 2 ? 1 : 0, 1);
            // 击杀经验:受害者 cost * (其等级 + 1),友军/中立不给分。
            // 敌兵用 1 号屋摆下场 (同规则表、同 cost),击杀者用 1 级的
            // v5 验证进账;封顶的 v1 击杀不再进账 (isMaxLevel 短路)。
            int preyId = vetWorld.Units().IdOfReg(vetWorld, 1, "E2");
            int preyIdx = preyId >= 0
                ? vetWorld.SpawnUnit(1, preyId, 8, 8) : 0 - 1;
            WorldObject prey = preyIdx >= 0
                ? vetWorld.ObjectAt(preyIdx) : null;
            int preyCost = prey != null && prey.UnitType() != null
                ? prey.UnitType().Cost() : 0;
            int before = v1.VeteranXp();
            WorldObject v5 = vetWorld.SpawnUnit(0, vetId, 10, 8) >= 0
                ? vetWorld.ObjectAt(vetWorld.ObjectCount() - 1) : null;
            vetWorld.GainVetXp(v5, thresh / 2);   // 半程,击杀不触发晋级
            int before5 = v5.VeteranXp();
            vetWorld.AwardKillXP(v5, prey);
            Report("kill xp banked",
                   v5.VeteranXp() == before5 + preyCost * 1 ? 1 : 0, 1);
            Report("kill xp capped silent",
                   v1.VeteranXp() == before ? 1 : 0, 1);
            WorldObject pal = vetWorld.SpawnUnit(0, vetId, 9, 8) >= 0
                ? vetWorld.ObjectAt(vetWorld.ObjectCount() - 1) : null;
            vetWorld.AwardKillXP(pal, v5);
            Report("friendly kill silent", pal.VeteranXp() == 0 ? 1 : 0, 1);
            // 倍率门:老兵档解锁 STRONGER(armor 1500),精英档沿用
            // elite 并集里的 FIREPOWER(1200);未列出的保持 1000。
            WorldObject v2 = vetWorld.SpawnUnit(0, vetId, 5, 6) >= 0
                ? vetWorld.ObjectAt(vetWorld.ObjectCount() - 1) : null;
            Report("rookie armor stock",
                   vetWorld.VetArmorPermille(v2) == 1000 ? 1 : 0, 1);
            v2.SetVeteranLevel(1);
            Report("vet armor boosted",
                   vetWorld.VetArmorPermille(v2) == 1500 ? 1 : 0, 1);
            Report("vet firepower stock (elite only)",
                   vetWorld.VetFirepowerPermille(v2) == 1000 ? 1 : 0, 1);
            v2.SetVeteranLevel(2);
            Report("elite firepower boosted",
                   vetWorld.VetFirepowerPermille(v2) == 1200 ? 1 : 0, 1);
            Report("elite sight stock (not listed)",
                   vetWorld.VetSightPermille(v2) == 1000 ? 1 : 0, 1);
            // 火力包:精英档 1200 * 箱子火力 1 = 1200;箱子火力翻倍时
            // 乘起来 (参考 baseDamageMultiplier 的乘积)。
            Report("firepower package elite",
                   vetWorld.FirepowerPermilleOf(v2) == 1200 ? 1 : 0, 1);
            v2.SetCrateFirepower(2);
            Report("firepower package with crate",
                   vetWorld.FirepowerPermilleOf(v2) == 2400 ? 1 : 0, 1);
            // 受伤调整:STRONGER 除伤 (1500) 再除箱子护甲 (1)。
            int adj = vetWorld.VictimArmorAdjust(v2, 3000);
            Report("victim armor adjusts", adj == 2000 ? 1 : 0, 1);
            // InitialVeteran:新建单位直接精英档。
            WorldObject v3 = vetWorld.SpawnUnit(0, vetId, 6, 6) >= 0
                ? vetWorld.ObjectAt(vetWorld.ObjectCount() - 1) : null;
            vetWorld.ApplyInitialVeteran(v3);
            Report("initial veteran elite",
                   v3.VeteranLevel() == 2 ? 1 : 0, 1);
            WorldObject v4 = vetWorld.SpawnUnit(0, vetId, 6, 7) >= 0
                ? vetWorld.ObjectAt(vetWorld.ObjectCount() - 1) : null;
            Report("spawn default rookie",
                   v4.VeteranLevel() == 0 ? 1 : 0, 1);
        }
        // 碾压:规则键解析(Crusher/Crushable 默认/CrushSound/Weight/
        // SpeedType 默认与覆盖)、门控(Track/Hover)、友军豁免、进格轧杀
        // (DeathType.Crush + InfDeath 0 + 尸体不留)、墙的碾压(可碾墙倒
        // 下不带连锁半伤 + 车辆 rocking 请求)与老兵 CRUSHER 能力的授予。
        Rules crushRules = Rules.Default();
        UnitDef crushMtnk = crushRules.UnitDefNamed("MTNK");
        UnitDef crushFv = crushRules.UnitDefNamed("FV");
        UnitDef crushGi = crushRules.UnitDefNamed("E1");
        UnitDef crushGgi = crushRules.UnitDefNamed("GGI");
        Report("rules mtnk crusher",
               crushMtnk != null && crushMtnk.Crusher() ? 1 : 0, 1);
        Report("rules mtnk track default",
               crushMtnk != null
               && crushMtnk.SpeedTypeValue() == SpeedType.Track() ? 1 : 0, 1);
        Report("rules fv wheel no crusher",
               crushFv != null && !crushFv.Crusher()
               && crushFv.SpeedTypeValue() == SpeedType.Wheel() ? 1 : 0, 1);
        Report("rules gi crushable default",
               crushGi != null && crushGi.Crushable() ? 1 : 0, 1);
        Report("rules gi squish key",
               crushGi != null && crushGi.CrushSound() == "InfantrySquish"
                   ? 1 : 0, 1);
        Report("rules ggi not crushable",
               crushGgi != null && !crushGgi.Crushable() ? 1 : 0, 1);
        // INI 解析:SpeedType= 覆盖默认,Crusher=no 关掉,Track 之外的
        // 滚动类(Hover)也放行,Hover 是碾得动的。
        Rules crushIniRules = Rules.Default();
        crushIniRules.ApplyIni(IniParser.Parse(
            "[General]\nVeteranRatio=10\n"
            + "[E1]\nCrusher=yes\nSpeedType=Hover\nCrushable=no\n"
            + "Weight=3.5\n"));
        UnitDef iniGi = crushIniRules.UnitDefNamed("E1");
        Report("ini crusher yes",
               iniGi != null && iniGi.Crusher() ? 1 : 0, 1);
        Report("ini speedtype override",
               iniGi != null && iniGi.SpeedTypeValue() == SpeedType.Hover()
                   ? 1 : 0, 1);
        Report("ini crushable no",
               iniGi != null && !iniGi.Crushable() ? 1 : 0, 1);
        Report("ini weight parsed",
               iniGi != null && iniGi.Weight() == 3 ? 1 : 0, 1);
        // 运行时:一座 20x20 的平地世界。把灰熊(MTNK,履带+碾压)和一辆
        // 多功能车(FV,轮式)摆上场,验门控与轧杀。
        Rules crushWorldRules = Rules.Default();
        World crushWorld = World.Create(
            MapFile.Parse("[Map]\nSize=0,0,20,20\nLocalSize=0,0,20,20\n")
                .Terrain(),
            StructureCatalog.CreateWith(crushWorldRules),
            UnitCatalog.CreateWith(crushWorldRules));
        int mtnkId = crushWorld.Units().IdOfReg(crushWorld, 0, "MTNK");
        int fvId = crushWorld.Units().IdOfReg(crushWorld, 0, "FV");
        int e1Id = crushWorld.Units().IdOfReg(crushWorld, 0, "E1");
        int e2Id = crushWorld.Units().IdOfReg(crushWorld, 1, "E2");
        Report("crush units present",
               mtnkId >= 0 && fvId >= 0 && e1Id >= 0 && e2Id >= 0 ? 1 : 0, 1);
        if (mtnkId >= 0 && fvId >= 0 && e1Id >= 0 && e2Id >= 0) {
            WorldObject tank = crushWorld.SpawnUnit(0, mtnkId, 5, 5) >= 0
                ? crushWorld.ObjectAt(crushWorld.ObjectCount() - 1) : null;
            WorldObject fv = crushWorld.SpawnUnit(0, fvId, 5, 8) >= 0
                ? crushWorld.ObjectAt(crushWorld.ObjectCount() - 1) : null;
            Report("tank is crusher",
                   crushWorld.IsCrusher(tank) ? 1 : 0, 1);
            Report("fv not crusher",
                   crushWorld.IsCrusher(fv) ? 0 : 1, 1);
            // 敌方步兵先落在旁边的空格,再走位到坦克格上(直接落在占用格
            // 会被 SpawnUnit 拒绝,拿到的会是另一个对象)。
            WorldObject prey = crushWorld.SpawnUnit(1, e2Id, 5, 6) >= 0
                ? crushWorld.ObjectAt(crushWorld.ObjectCount() - 1) : null;
            WorldObject pal = crushWorld.SpawnUnit(0, e1Id, 5, 7) >= 0
                ? crushWorld.ObjectAt(crushWorld.ObjectCount() - 1) : null;
            Report("prey crushable",
                   crushWorld.CrushApplies(tank, prey) ? 1 : 0, 1);
            // 友军豁免:同一屋的兵不进轧杀集合。
            Report("friendly spared",
                   crushWorld.CrushApplies(tank, pal) ? 0 : 1, 1);
            // 走位到同一格:进格轧杀读的是格子,不是对象状态。
            crushWorld.PlaceObjectAt(prey, 5, 5);
            crushWorld.PlaceObjectAt(pal, 5, 5);
            crushWorld.CrushOnCell(tank, 5, 5);
            Report("crush kills",
                   prey.Hp() == 0 ? 1 : 0, 1);
            Report("crush death type",
                   prey.DeathType() == DeathType.Crush() ? 1 : 0, 1);
            Report("crush infdeath none",
                   prey.InfDeath() == 0 ? 1 : 0, 1);
            Report("friendly survives",
                   pal.Hp() > 0 ? 1 : 0, 1);
            // 轮式车进不了有人的格子:CanCrushInto 对 FV 恒假。
            Report("fv cannot crush into",
                   crushWorld.CanCrushInto(fv, 5, 5) ? 0 : 1, 1);
            // 轧杀进账:坦克击杀敌方步兵,拿到 cost * (0+1) 的经验。
            int mtnkXp = tank.VeteranXp();
            int giCost = prey.UnitType() != null ? prey.UnitType().Cost() : 0;
            Report("crush awards xp",
                   mtnkXp == giCost ? 1 : 0, 1);
            // 墙:先摆一排三格沙袋(可碾),坦克碾中段 -> 该格倒下、
            // 邻格不被连锁半伤带走(WallTrait 的半伤只走弹伤路径),
            // 坦克拿到 rocking 请求。
            Rules wr = crushWorld.Rules();
            int sandIdx = 0 - 1;
            for (int i = 0; i < wr.OverlayTypeCount(); i = i + 1) {
                if (wr.OverlayName(i) == "GASAND") { sandIdx = i; break; }
            }
            Report("sandbag overlay present", sandIdx >= 0 ? 1 : 0, 1);
            if (sandIdx >= 0) {
                Report("sandbag crushable",
                       wr.OverlayCrushable(sandIdx) ? 1 : 0, 1);
                Report("sandbag squish key",
                       wr.OverlayCrushSound(sandIdx) == "WallCrushSandbag"
                           ? 1 : 0, 1);
                crushWorld.SetWall(8, 8, sandIdx);
                crushWorld.SetWall(9, 8, sandIdx);
                crushWorld.SetWall(10, 8, sandIdx);
                int beforeHp9 = crushWorld.WallHpAt(9, 8);
                tank.ApplyRocking(0, 500);
                Report("rocking armed",
                       tank.RockTicks() == WorldObject.RockingTicks() ? 1 : 0,
                       1);
                crushWorld.CrushOnCell(tank, 9, 8);
                Report("wall crushed",
                       crushWorld.WallOvAt(9, 8) < 0 ? 1 : 0, 1);
                Report("wall neighbours intact",
                       crushWorld.WallHpAt(8, 8) == beforeHp9
                       && crushWorld.WallHpAt(10, 8) == beforeHp9 ? 1 : 0, 1);
                Report("wall neighbours reconnect",
                       crushWorld.WallDataAt(8, 8) == 0
                       && crushWorld.WallDataAt(10, 8) == 0 ? 1 : 0, 1);
            }
            // 混凝土墙不可碾:GAWALL 的 Crushable= 缺省为 no。
            int concIdx = 0 - 1;
            for (int i = 0; i < wr.OverlayTypeCount(); i = i + 1) {
                if (wr.OverlayName(i) == "GAWALL") { concIdx = i; break; }
            }
            Report("concrete wall not crushable",
                   concIdx >= 0 && !wr.OverlayCrushable(concIdx) ? 1 : 0, 1);
            if (concIdx >= 0) {
                crushWorld.SetWall(12, 12, concIdx);
                crushWorld.CrushOnCell(tank, 12, 12);
                Report("concrete wall stands",
                       crushWorld.WallOvAt(12, 12) >= 0 ? 1 : 0, 1);
                Report("concrete blocks step",
                       crushWorld.CanCrushInto(tank, 12, 12) ? 0 : 1, 1);
            }
            // 老兵 CRUSHER 能力:换一个规则世界,让 FV 的精英能力表带上
            // CRUSHER,晋级后 crusher 标志翻起 —— 参考的
            // VeteranTrait.handlePromotion。FV 是轮式,能力翻起的标志
            // 仍被 SpeedType 门挡住(IsCrusher 要求 Track/Hover)。
            Rules promoRules = Rules.Default();
            promoRules.ApplyIni(IniParser.Parse(
                "[General]\nVeteranRatio=10\n"
                + "[FV]\nEliteAbilities=CRUSHER\n"));
            World promoWorld = World.Create(
                MapFile.Parse("[Map]\nSize=0,0,20,20\nLocalSize=0,0,20,20\n")
                    .Terrain(),
                StructureCatalog.CreateWith(promoRules),
                UnitCatalog.CreateWith(promoRules));
            int promoFv = promoWorld.Units().IdOfReg(promoWorld, 0, "FV");
            WorldObject pv = null;
            if (promoFv >= 0 && promoWorld.SpawnUnit(0, promoFv, 4, 4) >= 0) {
                pv = promoWorld.ObjectAt(promoWorld.ObjectCount() - 1);
            }
            if (pv != null) {
                Report("promotion flag off at rookie",
                       pv.Crusher() ? 0 : 1, 1);
                pv.SetVeteranLevel(VetLevel.Elite());
                promoWorld.HandlePromotion(pv);
                Report("promotion grants crusher",
                       pv.Crusher() ? 1 : 0, 1);
                Report("promoted wheel still gated",
                       promoWorld.IsCrusher(pv) ? 0 : 1, 1);
            }
            // 履带车走同一条授予路径:把 MTNK 的精英能力也带上 CRUSHER,
            // 它本来就是 crusher,晋级后仍成立(幂等)。
            int promoMtnk = promoWorld.Units().IdOfReg(promoWorld, 0, "MTNK");
            WorldObject pm = null;
            if (promoMtnk >= 0
             && promoWorld.SpawnUnit(0, promoMtnk, 6, 6) >= 0) {
                pm = promoWorld.ObjectAt(promoWorld.ObjectCount() - 1);
            }
            if (pm != null) {
                Report("stock mtnk crusher",
                       promoWorld.IsCrusher(pm) ? 1 : 0, 1);
            }
            // 被轧死的单位在 RemoveDead 后从场上消失,而坦克还在。猎物在
            // 轧杀那一刻 Hp 归零,但收尸发生在下一次 Tick 的 RemoveDead
            // ——所以先量场上人数,再 tick,再量。
            int aliveBefore = crushWorld.ObjectCount();
            // rocking 的衰减:逻辑 tick 递减;同一次 tick 顺手收走尸体。
            tank.SetRockTicks(2);
            crushWorld.Tick();
            Report("rocking decays",
                   tank.RockTicks() == 1 ? 1 : 0, 1);
            Report("crushed removed",
                   crushWorld.ObjectCount() < aliveBefore ? 1 : 0, 1);
            Report("crusher survives cleanup",
                   tank.Hp() > 0 ? 1 : 0, 1);
            Report("crusher cell kept",
                   crushWorld.OccupantAt(5, 5) >= 0 ? 1 : 0, 1);
        }

        // ---- 场景:地图光照 [Lighting] + 灯柱 tile light + 亮度渐变 ----
        // 参考 engine/Lighting.ts 的零售公式(CNCMaps Palette.ApplyLighting):
        //   tint      = 地图 tint(仅 Full 类或 forceTint)+ 该格灯池 tint 之和
        //   intensity = max(0, ambient - ground) + level*height + 该格灯池强度之和
        //   result    = max(0, tint) * max(0, intensity)
        // 每一项按 art 的 LightingType 门控(None 全亮、Global 无 ambient、
        // Level 加高度、Ambient 加灯池、Full 加地图 tint)。
        // 1) 无 [Lighting] 段的地图 = 参考默认(白天):level .032/ambient 1/tint 1。
        MapFile litless = MapFile.Parse(
            "[Map]\nSize=0,0,20,20\nLocalSize=0,0,20,20\n");
        MapLighting litDef = litless.Lighting();
        Report("no [Lighting] defaults level",
               litDef.Level() == 0.032 ? 1 : 0, 1);
        Report("no [Lighting] defaults ambient",
               litDef.Ambient() == 1.0 ? 1 : 0, 1);
        Report("no [Lighting] defaults tint",
               litDef.Red() == 1.0 && litDef.Green() == 1.0
                   && litDef.Blue() == 1.0 ? 1 : 0, 1);
        Report("no [Lighting] defaults ground",
               litDef.Ground() == 0.0 ? 1 : 0, 1);
        Report("base tint not forced",
               litDef.ForceTint() ? 0 : 1, 1);
        // 2) 地图自带 [Lighting]:夜战(暗 ambient、偏蓝 tint)+ Ion 前缀覆盖。
        MapFile litMap = MapFile.Parse(
            "[Map]\nSize=0,0,20,20\nLocalSize=0,0,20,20\n"
            + "[Lighting]\nLevel=.05\nAmbient=.6\nRed=.7\nGreen=.8\n"
            + "Blue=1.1\nGround=.1\n"
            + "IonAmbient=.35\nIonRed=.6\nIonGreen=.7\nIonBlue=1.2\n");
        MapLighting litNight = litMap.Lighting();
        Report("map [Lighting] level",
               litNight.Level() == 0.05 ? 1 : 0, 1);
        Report("map [Lighting] ambient",
               litNight.Ambient() == 0.6 ? 1 : 0, 1);
        Report("map [Lighting] ground",
               litNight.Ground() == 0.1 ? 1 : 0, 1);
        Report("map [Lighting] tint blue",
               litNight.Blue() == 1.1 ? 1 : 0, 1);
        MapLighting litIon = litMap.IonLighting();
        // Ion 段只覆盖自己给的键,其余继承默认(Level 没给 -> .032)。
        Report("ion ambient override",
               litIon.Ambient() == 0.35 ? 1 : 0, 1);
        Report("ion tint override",
               litIon.Blue() == 1.2 ? 1 : 0, 1);
        Report("ion level falls back",
               litIon.Level() == 0.032 ? 1 : 0, 1);
        // Ion 段总是 forceTint:离子风暴里连建筑也吃那张冷色 tint。
        Report("ion forces tint",
               litIon.ForceTint() ? 1 : 0, 1);

        // 3) 零售公式本体:直接对 Lighting 求值。
        Lighting light = Lighting.Create(litNight);
        Report("daylight level step",
               light.Compute(3, 0, 0, 0)[0] == 0.5 ? 1 : 0, 1);
        // Ambient 类不吃地图 tint(forceTint=false),所以三个通道都等于强度。
        Report("ambient class ignores map tint",
               light.Compute(3, 0, 0, 0)[2] == 0.5 ? 1 : 0, 1);
        // Full 类吃地图 tint:.7 * .5 / .8 * .5 / 1.1 * .5。
        Report("full class takes map tint red",
               light.Compute(4, 0, 0, 0)[0] == 0.35 ? 1 : 0, 1);
        Report("full class takes map tint blue",
               light.Compute(4, 0, 0, 0)[2] == 0.55 ? 1 : 0, 1);
        // Level 类:ambient-ground 打底 + level*height,没有地图 tint。
        // (0.6-0.1) + 0.05*4 = 0.7。
        Report("level class height step",
               light.Compute(2, 0, 0, 4)[0] == 0.7 ? 1 : 0, 1);
        // None 类全亮:动画不吃光照(火球在夜里不该变暗)。
        Report("none class unlit",
               light.Compute(0, 0, 0, 0)[0] == 1.0 ? 1 : 0, 1);
        // 零下限:负灯把和压到 0 以下时,原版引擎是夹到 0 而不是回绕。
        Lighting negLight = Lighting.Create(litNight);
        negLight.AddTileLight(2, 2, TileLight.Create(-9.0, -9.0, -9.0,
                                                     -9.0));
        Report("negative light clamps to zero",
               negLight.Compute(4, 2, 2, 0)[0] == 0.0 ? 1 : 0, 1);

        // 4) 灯池:一盏灯照亮半径内的格子,亮度线性衰减到边缘归零。
        // 世界铺一张平地:解析出来的地图没有 IsoMapPack5 地形包,格子
        // 判不出陆地,结构放不下去。地图光照用 SetMapLighting 装进去,
        // 跟主程序 LoadGame 的接线一致。
        Rules litRules = Rules.Default();
        World litWorld = World.Create(FlatMap(40, 40),
            StructureCatalog.CreateWith(litRules),
            UnitCatalog.CreateWith(litRules));
        litWorld.SetMapLighting(litMap.Lighting());
        // 内置规则给 GALITE(路灯)抄了 LightVisibility=5000/Intensity=.2。
        BuildingDef lampDef = litRules.BuildingDefNamed("GALITE");
        Report("galite is a lamp def",
               lampDef != null && lampDef.LightVisibility() == 5000 ? 1 : 0, 1);
        Report("galite intensity",
               lampDef != null && lampDef.LightIntensity() == 0.2 ? 1 : 0, 1);
        Report("galite tint red",
               lampDef != null && lampDef.LightRedTint() == 0.05 ? 1 : 0, 1);
        // 不可见灯:IN* 前缀(INYELWLAMP 等)与 TEM*/SNO* 剧场氛围灯。
        BuildingDef inLamp = litRules.BuildingDefNamed("INYELWLAMP");
        Report("invisible lamp flag",
               inLamp != null && inLamp.InvisibleInGame() ? 1 : 0, 1);
        Report("visible lamp not hidden",
               lampDef != null && !lampDef.InvisibleInGame() ? 1 : 0, 1);
        // 负灯 NEGRED:强度为负,把周围压暗。
        BuildingDef negDef = litRules.BuildingDefNamed("NEGRED");
        Report("negred negative intensity",
               negDef != null && negDef.LightIntensity() < 0.0 ? 1 : 0, 1);
        int galiteId = litWorld.Catalog().CivIdOf("GALITE");
        Report("galite in civ catalog",
               galiteId >= 0 ? 1 : 0, 1);
        if (galiteId >= 0) {
            // 半径 5000/256 = 19.5 格,以 (20,20) 为心:中心强度 .2,
            // 正北一格 .2*(5000-256)/5000 ≈ .19。
            int li = litWorld.PlaceCivStructure(galiteId, 20, 20, 0);
            Report("lamp placed", li >= 0 ? 1 : 0, 1);
            Report("lamp cell lit",
                   litWorld.Lights().TileLightAt(20, 20) != null ? 1 : 0, 1);
            TileLight lc = litWorld.Lights().TileLightAt(20, 20);
            Report("lamp center intensity",
                   lc != null && lc.Intensity() > 0.19
                       && lc.Intensity() < 0.201 ? 1 : 0, 1);
            TileLight ln = litWorld.Lights().TileLightAt(20, 19);
            Report("lamp one cell falloff",
                   ln != null && ln.Intensity() > 0.18
                       && ln.Intensity() < lc.Intensity() ? 1 : 0, 1);
            Report("lamp rim unlit",
                   litWorld.Lights().TileLightAt(20, 0) == null ? 1 : 0, 1);
            // 灯死了,池子跟着走 —— 参考的 onLampRemoved。
            litWorld.ClearLampLights(litWorld.ObjectAt(li));
            Report("dead lamp pool gone",
                   litWorld.Lights().TileLightAt(20, 20) == null ? 1 : 0, 1);
            // 两个灯共享的格子:一盏拆掉后另一盏还在。
            int l1 = litWorld.PlaceCivStructure(galiteId, 5, 5, 0);
            int l2 = litWorld.PlaceCivStructure(galiteId, 6, 5, 0);
            Report("two lamps placed",
                   l1 >= 0 && l2 >= 0 ? 1 : 0, 1);
            if (l1 >= 0 && l2 >= 0) {
                TileLight both = litWorld.Lights().TileLightAt(5, 5);
                litWorld.ClearLampLights(litWorld.ObjectAt(l2));
                TileLight one = litWorld.Lights().TileLightAt(5, 5);
                Report("shared cell keeps survivor",
                       both != null && one != null
                           && one.Intensity() < both.Intensity()
                           && one.Intensity() > 0.0 ? 1 : 0, 1);
                litWorld.ClearLampLights(litWorld.ObjectAt(l1));
                Report("last lamp clears cell",
                       litWorld.Lights().TileLightAt(5, 5) == null ? 1 : 0, 1);
            }
            // 灯池进公式:一盏灯下的地面比远处亮(Full 类吃地图 tint +
            // 灯池)。两盏测试灯都拆了,这里另放一盏。
            int l3 = litWorld.PlaceCivStructure(galiteId, 30, 30, 0);
            if (l3 >= 0) {
                List<double> near = litWorld.ShadeAt(30, 30, 4, 4);
                List<double> far = litWorld.ShadeAt(2, 2, 4, 4);
                Report("lamp brightens its cell",
                       near[0] > far[0] ? 1 : 0, 1);
            }
        }
        // 5) 渲染侧的着色因子:同一格,地面(Full)与单位(Ambient)拿到
        // 不同的值 —— Full 吃地图 tint,Ambient 不吃(除非 forceTint)。
        List<double> groundShade = litWorld.ShadeAt(20, 20, 0, 4);
        List<double> unitShade = litWorld.ShadeAt(20, 20, 0, 3);
        Report("ground shade takes tint",
               groundShade[0] != unitShade[0] ? 1 : 0, 1);
        // 单位额外亮度(ExtraUnitLight=.2):同格同高度,单位比地面亮 .2
        // —— 用 ShadeFor 走一遍对象路径。
        int litMtnk = litWorld.Units().IdOfReg(litWorld, 0, "MTNK");
        if (litMtnk >= 0) {
            int ui = litWorld.SpawnUnit(0, litMtnk, 15, 15);
            if (ui >= 0) {
                WorldObject uo = litWorld.ObjectAt(litWorld.ObjectCount() - 1);
                List<double> withUnit = litWorld.ShadeFor(uo, 3);
                List<double> without = litWorld.ShadeAt(15, 15, 4, 3);
                Report("unit takes extra light",
                       withUnit[0] > without[0] ? 1 : 0, 1);
                Report("extra light is .2",
                       withUnit[0] - without[0] > 0.199
                           && withUnit[0] - without[0] < 0.201 ? 1 : 0, 1);
            }
        }

        // 6) 亮度渐变(MapLightingTrait.onTick):每 rate 分钟走一步,
        // 走到目标就停。出厂 AmbientChangeRate=.2 / Step=.2。
        Report("rules ambient change rate",
               litRules.AmbientChangeRateM() == 200 ? 1 : 0, 1);
        Report("rules ambient change step",
               litRules.AmbientChangeStepM() == 200 ? 1 : 0, 1);
        Lighting walk = Lighting.Create(litNight);
        // 目标 .4,当前 .6,步长 .2 -> 一步到底。
        walk.SetTargetAmbient(0.4, 200, 200);
        Report("ambient walk has target", walk.HasTarget() ? 1 : 0, 1);
        // 间隔 = floor(0.9 * 200) = 180 tick(参考的
        // 60*BASE_TICKS_PER_SECOND*rate,基 tick 15),第一次 tick 只设
        // 倒计时。
        walk.TickAmbient();
        Report("ambient walk waits its interval",
               walk.MapLightingNow().Ambient() == 0.6 ? 1 : 0, 1);
        // 180 个 tick 走完倒计时,第 181 个 tick 落一步,再一个间隔后
        // 看到 diff 已是 0 才清目标 —— 参考的 ambientUpdateTicks 每轮
        // 重置,所以到站也要再等一个间隔才认。
        for (int w = 0; w < 181; w = w + 1) { walk.TickAmbient(); }
        Report("ambient walk steps to target",
               walk.MapLightingNow().Ambient() == 0.4 ? 1 : 0, 1);
        for (int w = 0; w < 181; w = w + 1) { walk.TickAmbient(); }
        // 到达后 target 清空,后续 tick 不再改。
        Report("ambient walk stops at target",
               walk.HasTarget() ? 0 : 1, 1);
        walk.TickAmbient();
        Report("ambient walk idle after arrival",
               walk.MapLightingNow().Ambient() == 0.4 ? 1 : 0, 1);
        // 步长比差距大时只走差距那么多(不越过目标)。
        Lighting walk2 = Lighting.Create(litNight);
        walk2.SetTargetAmbient(0.55, 200, 900);
        walk2.TickAmbient();
        for (int w = 0; w < 181; w = w + 1) { walk2.TickAmbient(); }
        Report("ambient walk clamps overshoot",
               walk2.MapLightingNow().Ambient() == 0.55 ? 1 : 0, 1);

        // 7) 核弹闪光的包络(NukeLightingFx):0.3s 冲 +1.5,持续到 3.3s,
        // 之后 0.5s 落回。优先级 High=1。
        NukeLightingFx nuke = NukeLightingFx.CreateNuke();
        Report("nuke fx high priority", nuke.Priority(), 1);
        MapLighting nukeBase = MapLighting.Create();
        nuke.Start(0.0, nukeBase);
        Report("nuke fx running", nuke.IsRunning() ? 1 : 0, 1);
        List<int> nres = new List<int>();
        nres.Add(0);
        // t=150ms -> progress .5 -> ambient 1.75。
        bool nDone = nuke.UpdateNuke(150.0, 1, nres);
        Report("nuke flash ramps up",
               nuke.Lighting().Ambient() == 1.75 ? 1 : 0, 1);
        Report("nuke flash reports update", nres[0], 1);
        Report("nuke flash not done early", nDone ? 0 : 1, 1);
        // t=1000ms:0.3~3.3 的平台期参考什么都不写,ambient 冻结在最后一次
        // 上升到的值 —— 也就是 0.3s 那一刻的峰值 1+1.5=2.5(浮点等于
        // 1.5*1.0 的加法,这里用同一算式比对)。断言它既没继续涨也没回落。
        nuke.UpdateNuke(1000.0, 1, nres);
        Report("nuke flash plateau freezes",
               nuke.Lighting().Ambient() > 1.74
                   && nuke.Lighting().Ambient() < 1.76 ? 1 : 0, 1);
        Report("nuke flash plateau no update", nres[0], 0);
        // t=3550ms -> 回落 progress .5 -> ambient 1.75。
        nuke.UpdateNuke(3550.0, 1, nres);
        Report("nuke flash falls back",
               nuke.Lighting().Ambient() == 1.75 ? 1 : 0, 1);
        // t=3800ms -> progress 1 -> 回到底值,效果结束。
        nDone = nuke.UpdateNuke(3800.0, 1, nres);
        Report("nuke flash restores ambient",
               nuke.Lighting().Ambient() == 1.0 ? 1 : 0, 1);
        Report("nuke flash done at end", nDone ? 1 : 0, 1);
        // 游戏速度缩放:同一时刻,速度 2 的 elapsed 翻倍。t=1650ms 在
        // speed=2 下 elapsed 正好 3.3s,刚进回落段(progress 0),所以
        // ambient 仍是峰值 1+1.5=2.5;而 speed=1 的同一时刻还在 0.3~3.3
        // 的平台上不动。两者一比就见速度在起作用。
        NukeLightingFx nuke2 = NukeLightingFx.CreateNuke();
        nuke2.Start(0.0, MapLighting.Create());
        nuke2.UpdateNuke(1650.0, 2, nres);
        Report("nuke flash scaled by game speed",
               nuke2.Lighting().Ambient() == 2.5 ? 1 : 0, 1);
        NukeLightingFx nuke3 = NukeLightingFx.CreateNuke();
        nuke3.Start(0.0, MapLighting.Create());
        nuke3.UpdateNuke(150.0, 1, nres);
        Report("nuke flash unscaled stays low",
               nuke3.Lighting().Ambient() == 1.75 ? 1 : 0, 1);

        // 8) 覆盖层(override):效果运行期间用的是效果自己的 MapLighting,
        // 清除后回到地图的底值 —— 参考的 applyAmbientOverride。
        Lighting ov = Lighting.Create(litNight);
        Report("no override initially", ov.HasOverride() ? 0 : 1, 1);
        MapLighting ovLight = MapLighting.Create();
        ovLight.SetAmbient(2.0);
        ov.ApplyAmbientOverride(ovLight);
        Report("override in force", ov.HasOverride() ? 1 : 0, 1);
        Report("override changes ambient",
               ov.MapLightingNow().Ambient() == 2.0 ? 1 : 0, 1);
        ov.ApplyAmbientOverride(null);
        Report("override cleared",
               ov.MapLightingNow().Ambient() == 0.6 ? 1 : 0, 1);

        // 真实安装的表状态:本机 rip 没有音频表,引擎必须以空表静音装载
        // 而不是崩。表数打印出来,有表/无表都算通过。
        string instDir = "data";
        if (!File.Exists(instDir + "/ra2.mix")) { instDir = "../data"; }
        if (File.Exists(instDir + "/ra2.mix")) {
            Vfs vfsInst = AssetDb.MountInstall(instDir);
            SndEngine engineI = SndEngine.Create();
            engineI.Load(vfsInst, IniParser.Parse("\n"), 0);
            Console.WriteLine("winchain install tables: sound="
                + Convert.ToString(engineI.SpecCount())
                + " eva=" + Convert.ToString(engineI.EvaCount())
                + " music=" + Convert.ToString(engineI.MusicCount())
                + " (probe-only line)");
        } else {
            Console.WriteLine("winchain install tables: no data/ mount");
        }

        Console.WriteLine(failures == 0 ? "winchain ok"
                          : "winchain FAILED " + Convert.ToString(failures));
        if (failures > 0) { return 1; }
        return 0;
    }
}
