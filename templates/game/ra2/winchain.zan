// 快速游戏胜负全链路的回归程序。在一个程序化铺出的平地地图上放下两座
// 基地,不读 data/:地形是构造出来的 IsoMap,规则是 Rules.Default()。
// 场景各断言一个结果,任何一条 FAIL 都以非零码退出:
//   长局:打光敌方建筑但留一个兵 -> result 保持 0(还要继续清兵)
//   短局:同样局面 -> result 立即变 1(打光建筑就算赢)
//   反向短局:己方建筑全灭 -> result 变 2(判负)
//   多房:玩家+两个 AI 房,清一个 AI 局面继续,清光才判胜
using System;
using Game.Kit;
using Ra2.Assets;
using Ra2.Formats;
using Ra2.Game;

class WinChainTest {
    // 铺一张 40x40 的平地:level 4 是真实地图的地面高度,可通行。
    static IsoMap FlatMap(int w, int h) {
        IsoMap iso = new IsoMap();
        iso.width = w;
        iso.height = h;
        iso.tiles = new List<IsoTile>();
        iso.cellIndex = new List<int>();
        for (int c = 0; c < w * h; c = c + 1) { iso.cellIndex.Add(0); }
        for (int y = 0; y < h; y = y + 1) {
            for (int x = 0; x < w; x = x + 1) {
                IsoTile t = new IsoTile();
                t.x = x;
                t.y = y;
                t.tile = 0xFFFF;   // clear ground
                t.subTile = 0;
                t.level = 4;
                iso.tiles.Add(t);
                iso.cellIndex[y * w + x] = iso.tiles.Count;
            }
        }
        return iso;
    }

    static int StructuresOf(World world, int side) {
        int n = 0;
        for (int i = 0; i < world.ObjectCount(); i = i + 1) {
            WorldObject o = world.ObjectAt(i);
            if (o.Side() == side && o.Kind() == ObjKind.Structure()
             && !o.IsDead()) { n = n + 1; }
        }
        return n;
    }

    static int UnitsOf(World world, int side) {
        int n = 0;
        for (int i = 0; i < world.ObjectCount(); i = i + 1) {
            WorldObject o = world.ObjectAt(i);
            if (o.Side() == side && o.Kind() == ObjKind.Unit()
             && !o.IsDead()) { n = n + 1; }
        }
        return n;
    }

    static int KillStructuresOf(World world, int side) {
        int killed = 0;
        for (int i = 0; i < world.ObjectCount(); i = i + 1) {
            WorldObject o = world.ObjectAt(i);
            if (o.Side() == side && o.Kind() == ObjKind.Structure()
             && !o.IsDead()) {
                o.TakeDamage(o.Hp());
                killed = killed + 1;
            }
        }
        return killed;
    }

    static int failures = 0;

    // ---- 声音样件工厂:合成 AUD,喂给解码器断言 ----------------------

    static byte[] Au8(int n) {
        byte[] b = new byte[n];
        return b;
    }

    static void Au16(byte[] buf, int at, int v) {
        buf[at] = (byte)(v & 0xFF);
        buf[at + 1] = (byte)((v >> 8) & 0xFF);
    }

    static int AuGet16(byte[] buf, int at) {
        int v = (buf[at] & 0xFF) + (buf[at + 1] & 0xFF) * 256;
        return v >= 32768 ? v - 65536 : v;
    }

    static void AuU32(byte[] buf, int at, int v) {
        buf[at] = (byte)(v & 0xFF);
        buf[at + 1] = (byte)((v >> 8) & 0xFF);
        buf[at + 2] = (byte)((v >> 16) & 0xFF);
        buf[at + 3] = (byte)((v >> 24) & 0xFF);
    }

    /// <summary>16 位 PCM 的 AUD:rate、outBps=1、comp=0,单块。</summary>
    static byte[] PcmAud(int[] samples) {
        int dataLen = samples.Length * 2 + 4;
        byte[] b = Au8(8 + dataLen);
        Au16(b, 0, 22050);
        AuU32(b, 2, dataLen);
        b[6] = 1;
        b[7] = 0;
        b[8] = (byte)((samples.Length * 2) & 0xFF);
        b[9] = (byte)(((samples.Length * 2) >> 8) & 0xFF);
        b[10] = (byte)((samples.Length * 2) & 0xFF);
        b[11] = (byte)(((samples.Length * 2) >> 8) & 0xFF);
        for (int i = 0; i < samples.Length; i = i + 1) {
            Au16(b, 12 + i * 2, samples[i]);
        }
        return b;
    }

    /// <summary>8 位无符号 PCM 的 AUD:outBps=0,单块,解码时拓宽到 16 位。</summary>
    static byte[] Pcm8Aud(byte[] samples) {
        int dataLen = samples.Length + 4;
        byte[] b = Au8(8 + dataLen);
        Au16(b, 0, 22050);
        AuU32(b, 2, dataLen);
        b[6] = 0;
        b[7] = 0;
        b[8] = (byte)(samples.Length & 0xFF);
        b[9] = (byte)((samples.Length >> 8) & 0xFF);
        b[10] = (byte)(samples.Length & 0xFF);
        b[11] = (byte)((samples.Length >> 8) & 0xFF);
        for (int i = 0; i < samples.Length; i = i + 1) {
            b[12 + i] = samples[i];
        }
        return b;
    }

    static int ImaStepAt(int index) {
        int v = 7;
        for (int i = 0; i < index; i = i + 1) {
            v = v + (v >> 2) + 1;
        }
        return v;
    }

    /// <summary>IMA ADPCM 的 AUD(压缩 99):闭环重建编码——编码器与解码器
    /// 同步推进预测器,解码输出应与重建序列逐样本一致,且对目标样本的
    /// 误差有界。每块 5 个样本 = 4 个增量 = 整 2 字节半字节,块头是完整
    /// 的 4 字节(预测器 + 步索引 + 保留字节),与解码器逐字节对齐。
    /// 返回码 0 = 正常,负值 = 输入规模不支持。</summary>
    static int ImaAud(int[] samples, byte[] outBuf, int cap) {
        int perChunk = 5;
        int chunkCount = (samples.Length + perChunk - 1) / perChunk;
        int dataLen = 0;
        for (int c = 0; c < chunkCount; c = c + 1) {
            int n = perChunk;
            if (c * perChunk + n > samples.Length) {
                n = samples.Length - c * perChunk;
            }
            dataLen = dataLen + 8 + ((n - 1) + 1) / 2;
        }
        if (8 + dataLen > cap) { return 0 - 1; }
        byte[] b = outBuf;
        Au16(b, 0, 22050);
        AuU32(b, 2, dataLen);
        b[6] = 1;
        b[7] = 99;
        int at = 8;
        int si = 0;
        for (int c = 0; c < chunkCount; c = c + 1) {
            int end = si + perChunk;
            if (end > samples.Length) { end = samples.Length; }
            int deltas = end - si - 1;
            int nibBytes = (deltas + 1) / 2;
            int chunkBytes = 4 + nibBytes;
            b[at] = (byte)(chunkBytes & 0xFF);
            b[at + 1] = (byte)((chunkBytes >> 8) & 0xFF);
            int outBytes = (end - si) * 2;
            b[at + 2] = (byte)(outBytes & 0xFF);
            b[at + 3] = (byte)((outBytes >> 8) & 0xFF);
            int predictor = samples[si];
            int stepIndex = 0;
            Au16(b, at + 4, predictor);
            b[at + 6] = 0;
            b[at + 7] = 0;
            int nibAt = at + 8;
            int nibbles = 0;
            for (int i = si + 1; i < end; i = i + 1) {
                int step = ImaStepAt(stepIndex);
                int diff = samples[i] - predictor;
                int nib = 0;
                if (diff < 0) { nib = nib + 8; diff = 0 - diff; }
                if (diff >= step) { nib = nib + 4; diff = diff - step; }
                if (diff >= step >> 1) { nib = nib + 2; diff = diff - (step >> 1); }
                if (diff >= step >> 2) { nib = nib + 1; }
                if (nibbles % 2 == 0) {
                    b[nibAt] = (byte)nib;
                } else {
                    b[nibAt] = (byte)((b[nibAt] & 0xFF) + nib * 16);
                    nibAt = nibAt + 1;
                }
                nibbles = nibbles + 1;
                // 与解码器逐位一致的重建链。
                int step2 = ImaStepAt(stepIndex);
                int add = step2 >> 3;
                if ((nib & 1) != 0) { add = add + (step2 >> 2); }
                if ((nib & 2) != 0) { add = add + (step2 >> 1); }
                if ((nib & 4) != 0) { add = add + step2; }
                if ((nib & 8) != 0) { add = 0 - add; }
                predictor = predictor + add;
                if (predictor > 32767) { predictor = 32767; }
                if (predictor < 0 - 32768) { predictor = 0 - 32768; }
                int d = stepIndex
                    + (nib < 4 ? 0 - 1 : nib == 4 ? 2 : nib == 5 ? 4
                        : nib == 6 ? 6 : 8);
                stepIndex = d < 0 ? 0 : d > 88 ? 88 : d;
            }
            at = at + 4 + chunkBytes;
            si = end;
        }
        return 8 + dataLen;
    }

    static void Report(string tag, int got, int want) {
        string verdict = got == want ? "PASS" : "FAIL";
        Console.WriteLine(verdict + " " + tag
            + " got=" + Convert.ToString(got)
            + " want=" + Convert.ToString(want));
        if (got != want) { failures = failures + 1; }
    }

    // 场景 1+2:玩家(盟军)与敌人(苏军)各一座基地。先验证长局规则,
    // 同一局面再用短局规则重摆一遍。
    static void Main() {
        Rules rules = Rules.Default();
        StructureCatalog sc = StructureCatalog.CreateWith(rules);
        UnitCatalog uc = UnitCatalog.CreateWith(rules);

        // ---- 长局:清掉敌方建筑、留兵,结果必须还是 0 ----
        World world = World.Create(FlatMap(40, 40), sc, uc);
        world.PlaceBase(0, 3, 3);
        world.PlaceBase(1, 30, 30);
        GameController game = GameController.CreateWith(world, 0, 10000,
                                                        Difficulty.Normal());
        game.SetShortGame(false);
        int step = 0;
        while (step < 200 && game.Result() == 0) { game.Tick(); step = step + 1; }
        Report("long pre-game stays undecided", game.Result(), 0);
        Report("long both bases stand (player)",
               StructuresOf(world, 0) > 0 ? 1 : 0, 1);
        Report("long both bases stand (enemy)",
               StructuresOf(world, 1) > 0 ? 1 : 0, 1);
        int killed = KillStructuresOf(world, 1);
        Report("long enemy structures razed", killed > 0 ? 1 : 0, 1);
        game.Tick();
        Report("long surviving enemy units keep fight going",
               game.Result(), 0);
        // 敌方最后一个兵也阵亡后,长局才算分晓。
        for (int i = 0; i < world.ObjectCount(); i = i + 1) {
            WorldObject o = world.ObjectAt(i);
            if (o.Side() == 1 && o.Kind() == ObjKind.Unit() && !o.IsDead()) {
                o.TakeDamage(o.Hp());
            }
        }
        game.Tick();
        Report("long win once the last enemy unit dies", game.Result(), 1);

        // ---- 短局:同一开局,清建筑即胜,不用清兵 ----
        World world2 = World.Create(FlatMap(40, 40), sc, uc);
        world2.PlaceBase(0, 3, 3);
        world2.PlaceBase(1, 30, 30);
        GameController game2 = GameController.CreateWith(world2, 0, 10000,
                                                         Difficulty.Normal());
        game2.SetShortGame(true);
        // Sit out the opening ticks first: the first tick alone must not
        // have already decided the game, which is what "got=2 want=0" used
        // to catch before this loop existed.
        int step2 = 0;
        while (step2 < 50 && game2.Result() == 0) { game2.Tick(); step2 = step2 + 1; }
        Report("short pre-game stays undecided", game2.Result(), 0);
        KillStructuresOf(world2, 1);
        game2.Tick();
        Report("short surviving enemy units do not matter",
               game2.Result(), 1);

        // ---- 反向:短局下己方建筑全灭即判负 ----
        World world3 = World.Create(FlatMap(40, 40), sc, uc);
        world3.PlaceBase(0, 3, 3);
        world3.PlaceBase(1, 30, 30);
        GameController game3 = GameController.CreateWith(world3, 0, 10000,
                                                         Difficulty.Normal());
        game3.SetShortGame(true);
        KillStructuresOf(world3, 0);
        game3.Tick();
        Report("short player loss when own base is razed", game3.Result(), 2);

        // ---- 多房:玩家 + 两个 AI 房(1 苏军、2 盟军),全员混战 ----
        // 清掉 1 号 AI 的建筑与兵后局面对 2 号 AI 仍是 0(还活着就继续打);
        // 再清 2 号 AI 才判胜。
        World world4 = World.Create(FlatMap(40, 40), sc, uc);
        world4.PlaceBase(0, 3, 3);
        world4.PlaceBase(1, 30, 3);
        world4.PlaceBase(2, 3, 30);
        List<int> houses4 = new List<int>();
        houses4.Add(1);
        houses4.Add(2);
        List<int> diffs4 = new List<int>();
        diffs4.Add(Difficulty.Brutal());
        diffs4.Add(Difficulty.Normal());
        world4.SetFactions(0, houses4);
        GameController game4 = GameController.CreateMulti(world4, 0, houses4,
                                                          diffs4, 10000);
        game4.SetShortGame(true);
        int step4 = 0;
        while (step4 < 50 && game4.Result() == 0) { game4.Tick(); step4 = step4 + 1; }
        Report("multi pre-game stays undecided", game4.Result(), 0);
        Report("multi both AI houses stand",
               StructuresOf(world4, 1) > 0 && StructuresOf(world4, 2) > 0
                   ? 1 : 0, 1);
        Report("multi AI factions rotated (soviet + yuri)",
               world4.FactionOf(1) == Side2.Soviet()
               && world4.FactionOf(2) == Side2.Yuri() ? 1 : 0, 1);
        KillStructuresOf(world4, 1);
        for (int i = 0; i < world4.ObjectCount(); i = i + 1) {
            WorldObject o = world4.ObjectAt(i);
            if (o.Side() == 1 && o.Kind() == ObjKind.Unit() && !o.IsDead()) {
                o.TakeDamage(o.Hp());
            }
        }
        game4.Tick();
        Report("multi killing one AI keeps the game on", game4.Result(), 0);
        KillStructuresOf(world4, 2);
        game4.Tick();
        Report("multi killing the last AI wins", game4.Result(), 1);

        // ---- 战争迷雾:每屋一张 MapShroud。开局各家的兵力揭示自己的视野
        // 圈,敌基地对 0 号屋保持无光;征召兵落在无光处的瞬间点亮自己的
        // 视野圈,行军沿途逐格续揭示;临时揭示到期塌回无光;Darken 位
        // (间隙产生器的地基)可开可关。纯逻辑链路,不依赖 GUI 驱动。
        MapShroud probeA = MapShroud.Create(40, 40);
        probeA.SeedElevation(world4);
        probeA.RevealFrom(20, 20, 4, 5);
        probeA.Update();
        Report("shroud standalone reveal",
               probeA.At(20, 20) == MapShroud.Explored() ? 1 : 0, 1);
        World world5 = World.Create(FlatMap(40, 40), sc, uc);
        world5.PlaceBase(0, 3, 3);
        world5.PlaceBase(1, 30, 30);
        world5.InitShrouds();
        MapShroud sh5 = world5.ShroudOf(0);
        Report("shroud built for house 0", sh5 != null ? 1 : 0, 1);
        Report("shroud absent outside houses",
               world5.ShroudOf(8) == null
               && world5.ShroudOf(0 - 1) == null ? 1 : 0, 1);
        Report("shroud own base cell lit",
               sh5.At(3, 3) == MapShroud.Explored() ? 1 : 0, 1);
        Report("shroud enemy base dark for house 0",
               sh5.At(30, 30) == MapShroud.Unexplored() ? 1 : 0, 1);
        int e1id5 = 0 - 1;
        for (int i5 = 0; i5 < world5.Units().ListFor(world5, 0).Count;
          i5 = i5 + 1) {
            UnitType t5 = world5.Units().TypeFor(world5, 0, i5);
            if (t5 != null && t5.Reg() == "E1") { e1id5 = i5; }
        }
        Report("shroud E1 in roster", e1id5 >= 0 ? 1 : 0, 1);
        // 找一张无光又可通行的格子落兵(离两家基地都远)。
        int sx5 = 0 - 1;
        int sy5 = 0 - 1;
        for (int cy5 = 12; cy5 <= 27 && sx5 < 0; cy5 = cy5 + 1) {
            for (int cx5 = 12; cx5 <= 27; cx5 = cx5 + 1) {
                if (sh5.At(cx5, cy5) == MapShroud.Unexplored()
                 && world5.PassableForRoute(cx5, cy5, false)) {
                    sx5 = cx5;
                    sy5 = cy5;
                    break;
                }
            }
        }
        Report("shroud dark spawn cell found", sx5 >= 0 ? 1 : 0, 1);
        int scout5 = world5.SpawnUnit(0, e1id5, sx5, sy5);
        Report("shroud scout spawned", scout5 >= 0 ? 1 : 0, 1);
        world5.Tick();
        WorldObject so5 = world5.ObjectAt(scout5);
        int sight5 = so5.UnitType().Sight();
        Report("shroud E1 sight parsed", sight5 > 0 ? 1 : 0, 1);
        int lit5 = 0;
        for (int dy5 = 0 - 1; dy5 <= 1; dy5 = dy5 + 1) {
            for (int dx5 = 0 - 1; dx5 <= 1; dx5 = dx5 + 1) {
                if (sh5.At(sx5 + dx5, sy5 + dy5)
                 == MapShroud.Explored()) { lit5 = lit5 + 1; }
            }
        }
        Report("shroud spawn reveal ring lit", lit5, 9);
        // 行军五格:走到的每一步都要把脚下与视野圈续上揭示。
        world5.ClearSelection();
        world5.AddSelectionByObject(so5);
        world5.OrderMove(sx5 + 5, sy5);
        int guard5 = 0;
        while (so5.X() == sx5 && guard5 < 400) { world5.Tick(); guard5 = guard5 + 1; }
        Report("shroud scout marched", so5.X() != sx5 ? 1 : 0, 1);
        Report("shroud march destination lit",
               sh5.At(so5.X(), so5.Y()) == MapShroud.Explored() ? 1 : 0, 1);
        // 收拾侦察兵:带着残存路线躺走廊里的兵,会顶死后面箱子场景的行兵。
        if (!so5.IsDead()) { so5.TakeDamage(so5.Hp()); }
        world5.Tick();
        // 临时揭示:首帧显形,75 逻辑帧到期塌回无光。
        sh5.RevealTemporarily(35, 8, 4);
        sh5.Update();
        Report("shroud temp reveal shows ground",
               sh5.At(35, 8) == MapShroud.TemporaryReveal() ? 1 : 0, 1);
        for (int t5 = 1; t5 < MapShroud.TempRevealTicks(); t5 = t5 + 1) {
            sh5.Update();
        }
        Report("shroud temp reveal expired",
               sh5.At(35, 8) == MapShroud.Unexplored() ? 1 : 0, 1);
        // Darken 位:间隙产生器的地基标记,开了要能关。
        sh5.ToggleFlagsAround(10, 10, 2, MapShroud.Darken(), true);
        Report("shroud darken set", sh5.Darkened(10, 10) ? 1 : 0, 1);
        sh5.ToggleFlagsAround(10, 10, 2, MapShroud.Darken(), false);
        Report("shroud darken cleared", sh5.Darkened(10, 10) ? 0 : 1, 1);

        // ---- 箱子 / 强化工具: reference 的 CrateGeneratorTrait 全链路 ----
        // 边缘列扫描只登记出生点不开箱;第一拍把场上补到下限;水箱只能
        // 掷水奖励;步兵踩上钉好的钱箱要吃掉它并入账;无 yard 无基地、
        // 钱够开局的指挥官从箱子里领回一辆 MCV,钱不够的滚进钱箱兜底。
        Rules cr6 = world5.Rules();
        world5.InitCrates(true);
        Report("crate init spawns nothing",
               world5.CrateCount() == 0 ? 1 : 0, 1);
        world5.Tick();
        Report("crate field topped up to floor",
               world5.CrateCount() >= cr6.CrateMinimum() ? 1 : 0, 1);
        Report("crate refuses out-of-bounds cell",
               world5.SpawnCrateAt(0 - 1, 0 - 1) ? 1 : 0, 0);
        // reference 的掷骰是 generateRandomInt(0, totalShares) 双端含:
        // 掷到 total 落空、这一枪不放箱,陆地水池都可能。落空合法;
        // 只要掷出编号,水箱就必须是 waterAllowed 的奖励。
        bool powOk6 = true;
        bool waterOk6 = true;
        for (int ri6 = 0; ri6 < 200; ri6 = ri6 + 1) {
            int p6 = world5.ChoosePowerup(false);
            if (p6 >= cr6.PowerupCount()) { powOk6 = false; }
            int q6 = world5.ChoosePowerup(true);
            if (q6 >= 0 && (q6 >= cr6.PowerupCount()
                         || !cr6.PowerupWaterAt(q6))) {
                waterOk6 = false;
            }
        }
        Report("crate powerup roll in range", powOk6 ? 1 : 0, 1);
        Report("crate water roll water-only", waterOk6 ? 1 : 0, 1);
        int moneyIdx6 = 0 - 1;
        int healIdx6 = 0 - 1;
        int unitIdx6 = 0 - 1;
        int explIdx6 = 0 - 1;
        int revIdx6 = 0 - 1;
        int tibIdx6 = 0 - 1;
        int icbmIdx6 = 0 - 1;
        for (int pi6 = 0; pi6 < cr6.PowerupCount(); pi6 = pi6 + 1) {
            int ty6 = cr6.PowerupTypeAt(pi6);
            if (ty6 == Rules.PowerupMoney()) { moneyIdx6 = pi6; }
            else if (ty6 == Rules.PowerupHealBase()) { healIdx6 = pi6; }
            else if (ty6 == Rules.PowerupUnit()) { unitIdx6 = pi6; }
            else if (ty6 == Rules.PowerupExplosion()) { explIdx6 = pi6; }
            else if (ty6 == Rules.PowerupReveal()) { revIdx6 = pi6; }
            else if (ty6 == Rules.PowerupTiberium()) { tibIdx6 = pi6; }
            else if (ty6 == Rules.PowerupICBM()) { icbmIdx6 = pi6; }
        }
        int px6 = 0 - 1;
        int py6 = 0 - 1;
        for (int sy6 = 12; sy6 < 28 && px6 < 0; sy6 = sy6 + 1) {
            for (int sx6 = 12; sx6 < 28; sx6 = sx6 + 1) {
                if (world5.CrateCanPlace(sx6, sy6)) {
                    px6 = sx6;
                    py6 = sy6;
                    break;
                }
            }
        }
        Report("crate placeable cell found", px6 >= 0 ? 1 : 0, 1);
        // 拾取场景:随补箱一只挡在后头的箱子,行兵从 (px6+2,py6) 走向钉在
        // (px6,py6) 的钱箱,吃箱的一列入账事件,箱子从场上消失。
        if (px6 >= 0 && moneyIdx6 >= 0 && e1id5 >= 0
         && world5.CrateCanPlace(px6 + 2, py6)) {
            world5.SpawnCratePinned(px6 + 3, py6, moneyIdx6, 9000);
            int walker6 = world5.SpawnUnit(0, e1id5, px6 + 2, py6);
            WorldObject wo6 = walker6 >= 0 ? world5.ObjectAt(walker6) : null;
            bool walkerOk6 = walker6 >= 0 && wo6 != null;
            bool placed6 = walkerOk6
                && world5.SpawnCratePinned(px6, py6, moneyIdx6, 9000);
            if (walkerOk6) {
                world5.ClearSelection();
                world5.AddSelectionByObject(wo6);
            }
            bool order6 = walkerOk6 ? world5.OrderMove(px6, py6) : false;
            Report("crate walker spawned and ordered",
                   walkerOk6 && placed6 && order6 ? 1 : 0, 1);
            int startX6 = walkerOk6 ? wo6.X() : 0 - 1;
            bool moved6 = false;
            int evBase6 = world5.EventCount();
            for (int t6 = 0; t6 < 300 && order6; t6 = t6 + 1) {
                world5.Tick();
                if (wo6.X() != startX6) { moved6 = true; }
                if (wo6.IsDead()) { break; }
                bool hit6 = false;
                for (int ei6 = evBase6; ei6 < world5.EventCount();
                  ei6 = ei6 + 1) {
                    if (world5.EventKindAt(ei6) == 1) { hit6 = true; break; }
                }
                if (hit6) { break; }
            }
            Report("crate walker moved", moved6 ? 1 : 0, 1);
            int money6 = 0;
            for (int ei6 = evBase6; ei6 < world5.EventCount();
              ei6 = ei6 + 1) {
                if (world5.EventKindAt(ei6) == 1
                 && world5.EventAmountAt(ei6) > 0) {
                    money6 = money6 + 1;
                }
            }
            Report("crate pickup queues money event", money6 > 0 ? 1 : 0, 1);
            Report("crate consumed by walker",
                   world5.CrateAt(px6, py6) < 0 ? 1 : 0, 1);
            if (!wo6.IsDead()) { wo6.TakeDamage(wo6.Hp()); }
            world5.Tick();
            world5.ClearSelection();
        }
        // 直发奖励:钱箱按 Data= 的 55%..145% 入账;治疗基地把本方全员
        // (含领箱者)顶满血;全图揭示把敌基地角点亮;单位箱在没有
        // CrateGoodie 车辆时、ICBM 在没有超武系统时,都滚进钱箱兜底。
        int grant6 = world5.SpawnUnit(0, e1id5, 20, 20);
        WorldObject so7 = grant6 >= 0 ? world5.ObjectAt(grant6) : null;
        if (so7 != null && moneyIdx6 >= 0) {
            int evM6 = world5.EventCount();
            world5.GrantPowerup(so7, moneyIdx6, so7.X(), so7.Y());
            int amount6 = 0;
            for (int ei6 = evM6; ei6 < world5.EventCount(); ei6 = ei6 + 1) {
                if (world5.EventKindAt(ei6) == 1
                 && world5.EventSideAt(ei6) == 0) {
                    amount6 = world5.EventAmountAt(ei6);
                }
            }
            Report("crate money pays in band",
                   amount6 >= 5500 && amount6 <= 14500 ? 1 : 0, 1);
        }
        if (so7 != null && healIdx6 >= 0) {
            so7.TakeDamage(so7.Hp() / 2);
            world5.GrantPowerup(so7, healIdx6, so7.X(), so7.Y());
            Report("crate healbase restores picker",
                   so7.Hp() == so7.MaxHp() ? 1 : 0, 1);
        }
        if (so7 != null && revIdx6 >= 0) {
            world5.GrantPowerup(so7, revIdx6, so7.X(), so7.Y());
            Report("crate reveal lights the far corner",
                   sh5.At(30, 30) == MapShroud.Explored() ? 1 : 0, 1);
        }
        if (so7 != null && unitIdx6 >= 0) {
            int evU6 = world5.EventCount();
            world5.GrantPowerup(so7, unitIdx6, so7.X(), so7.Y());
            bool paid6 = false;
            for (int ei6 = evU6; ei6 < world5.EventCount(); ei6 = ei6 + 1) {
                if (world5.EventKindAt(ei6) == 1
                 && world5.EventAmountAt(ei6) > 0) { paid6 = true; break; }
            }
            Report("crate unit without goodies pays money",
                   paid6 ? 1 : 0, 1);
        }
        if (so7 != null && icbmIdx6 >= 0) {
            int evI6 = world5.EventCount();
            world5.GrantPowerup(so7, icbmIdx6, so7.X(), so7.Y());
            bool paidI6 = false;
            for (int ei6 = evI6; ei6 < world5.EventCount(); ei6 = ei6 + 1) {
                if (world5.EventKindAt(ei6) == 1
                 && world5.EventAmountAt(ei6) > 0) { paidI6 = true; break; }
            }
            Report("crate icbm without superweapons pays money",
                   paidI6 ? 1 : 0, 1);
        }
        if (so7 != null && !so7.IsDead()) {
            so7.TakeDamage(so7.Hp());
            world5.Tick();
        }
        // 无基世界:没有建造场、没有可部署基地车的指挥官,钱够开局的从
        // 箱子里领回 MCV,钱不够的滚进钱箱兜底。两条路各验一遍,穷的先
        // 走,富的后走,免得先领的 MCV 把"无基地"前提顶掉。
        World world6 = World.Create(FlatMap(40, 40), sc, uc);
        world6.InitShrouds();
        world6.InitCrates(true);
        int e2id6 = world6.Units().IdOfReg(world6, 1, "E2");
        if (unitIdx6 >= 0 && e1id5 >= 0 && e2id6 >= 0) {
            int poor6 = world6.SpawnUnit(0, e1id5, 18, 18);
            WorldObject po6 = poor6 >= 0 ? world6.ObjectAt(poor6) : null;
            if (po6 != null) {
                world6.SetCreditSnap(0, 0);
                int evP6 = world6.EventCount();
                world6.GrantPowerup(po6, unitIdx6, 18, 18);
                bool paidP6 = false;
                for (int ei6 = evP6; ei6 < world6.EventCount();
                  ei6 = ei6 + 1) {
                    if (world6.EventKindAt(ei6) == 1) { paidP6 = true; break; }
                }
                Report("crate poor commander falls back to money",
                       paidP6 ? 1 : 0, 1);
            }
            int rich6 = world6.SpawnUnit(0, e1id5, 20, 20);
            WorldObject ro6 = rich6 >= 0 ? world6.ObjectAt(rich6) : null;
            if (ro6 != null) {
                world6.SetCreditSnap(0, 999999);
                world6.GrantPowerup(ro6, unitIdx6, 20, 20);
                int mcv6 = 0;
                for (int i6 = 0; i6 < world6.ObjectCount(); i6 = i6 + 1) {
                    WorldObject o6 = world6.ObjectAt(i6);
                    if (o6.Side() == 0 && !o6.IsDead()
                     && o6.Kind() == ObjKind.Unit()
                     && o6.UnitType() != null
                     && o6.UnitType().DeploysInto() != null
                     && o6.UnitType().DeploysInto().Length > 0) {
                        mcv6 = mcv6 + 1;
                    }
                }
                Report("crate free MCV walks out", mcv6 > 0 ? 1 : 0, 1);
            }
            // 爆炸弹:HE 弹头直接砸在领箱者脚下的格子上,同格的敌兵吃满额。
            int foe6 = world6.SpawnUnit(1, e2id6, 26, 20);
            WorldObject fo6 = foe6 >= 0 ? world6.ObjectAt(foe6) : null;
            if (fo6 != null && explIdx6 >= 0) {
                int hpBefore6 = fo6.Hp();
                world6.GrantPowerup(fo6, explIdx6, fo6.X(), fo6.Y());
                Report("crate blast hits the foe on the cell",
                       fo6.IsDead() || fo6.Hp() < hpBefore6 ? 1 : 0, 1);
            }
            // 矿箱:六掷半径 2,5x5 扫描总该落上一层矿。
            WorldObject giver6 = null;
            if (ro6 != null && !ro6.IsDead()) { giver6 = ro6; }
            else if (po6 != null && !po6.IsDead()) { giver6 = po6; }
            if (giver6 != null && tibIdx6 >= 0) {
                world6.GrantPowerup(giver6, tibIdx6, 20, 18);
                int ore6 = 0;
                for (int dy6 = 0 - 2; dy6 <= 2; dy6 = dy6 + 1) {
                    for (int dx6 = 0 - 2; dx6 <= 2; dx6 = dx6 + 1) {
                        if (world6.OreOvAt(20 + dx6, 18 + dy6) > 0) {
                            ore6 = ore6 + 1;
                        }
                    }
                }
                Report("crate tiberium grows ore", ore6 > 0 ? 1 : 0, 1);
            }
        }

        // ---- 声音: AUD 解码 / sound.ini / EVA / 主题 --------------------
        // 表文件是玩家安装的资产(本机没有也能静音跑),引擎语义全部用
        // 合成样件断言:AUD 三种编码的解码闭环、WAV 容器、sound.ini 的
        // Defaults/Control/Sounds 截断/Type 回退、EVA 的队列纪律、主题
        // 播放表、位置音量的距离衰减。
        int[] pcmS = new int[] { 1000, 0 - 2000, 30000, 0 - 30000 };
        byte[] pcmAud = PcmAud(pcmS);
        List<int> plen = new List<int>();
        plen.Add(0);
        AudSound pcmSnd = AudSound.Decode(pcmAud, pcmAud.Length);
        Report("aud pcm decodes", pcmSnd.Valid() ? 1 : 0, 1);
        Report("aud pcm rate",
               pcmSnd.Valid() ? pcmSnd.Rate() : 0 - 1, 22050);
        Report("aud pcm sample count",
               pcmSnd.Valid() ? pcmSnd.SampleCount() : 0 - 1, 4);
        Report("aud pcm sample value",
               pcmSnd.Valid() ? AuGet16(pcmSnd.Pcm(), 0) : 0 - 1, 1000);
        Report("aud pcm sample value 2",
               pcmSnd.Valid() ? AuGet16(pcmSnd.Pcm(), 2) : 0 - 1,
               0 - 2000);
        byte[] pcm8 = Au8(4);
        pcm8[0] = 200;
        pcm8[1] = 0;
        pcm8[2] = 128;
        pcm8[3] = 255;
        byte[] pcm8Aud = Pcm8Aud(pcm8);
        AudSound pcm8Snd = AudSound.Decode(pcm8Aud, pcm8Aud.Length);
        Report("aud 8bit widens silence-centered",
               pcm8Snd.Valid() ? AuGet16(pcm8Snd.Pcm(), 4) : 0 - 1, 0);
        Report("aud 8bit widens high",
               pcm8Snd.Valid() ? AuGet16(pcm8Snd.Pcm(), 6) : 0 - 1,
               32512);
        int[] imaS = new int[] { 0, 100, 200, 300, 200, 100, 0,
            0 - 100, 1200, 0 - 1200, 300, 0, 300, 0, 0 - 300, 0 };
        byte[] imaBuf = Au8(512);
        int imaLen = ImaAud(imaS, imaBuf, 512);
        Report("aud ima fixture built", imaLen > 0 ? 1 : 0, 1);
        AudSound imaSnd = AudSound.Fail();
        if (imaLen > 0) { imaSnd = AudSound.Decode(imaBuf, imaLen); }
        Report("aud ima decodes", imaSnd.Valid() ? 1 : 0, 1);
        Report("aud ima sample count",
               imaSnd.Valid() ? imaSnd.SampleCount() : 0 - 1, 16);
        Report("aud ima first sample exact",
               imaSnd.Valid() ? AuGet16(imaSnd.Pcm(), 0) : 0 - 1, 0);
        // 块头样本从预测器直接播种,必须逐位精确:第 3 块(样本 10)
        // 的目标是 300。
        Report("aud ima chunk head exact",
               imaSnd.Valid() ? AuGet16(imaSnd.Pcm(), 10 * 2) : 0 - 1,
               300);
        int imaErr = 0;
        for (int i = 0; i < 16 && imaSnd.Valid(); i = i + 1) {
            int gotS = AuGet16(imaSnd.Pcm(), i * 2);
            int err = gotS - imaS[i];
            if (err < 0) { err = 0 - err; }
            if (err > imaErr) { imaErr = err; }
        }
        Report("aud ima error bounded", imaErr <= 3500 ? 1 : 0, 1);
        Report("aud rejects garbage",
               AudSound.Decode(Au8(16), 16).Valid() ? 1 : 0, 0);
        byte[] tiny = Au8(4);
        Report("aud rejects truncated",
               AudSound.Decode(tiny, 4).Valid() ? 1 : 0, 0);
        byte[] wav = AudSound.WavContainer(pcmSnd.Pcm(), 22050);
        Report("wav container riff tag",
               wav[0] == 82 && wav[1] == 73 && wav[2] == 70
               && wav[3] == 70 ? 1 : 0, 1);
        Report("wav container size",
               wav.Length == 44 + 8 ? 1 : 0, 1);
        // 本机时长断言需要 1ms 以上,4 个样本不足——补一段 2205 样本
        // (22050Hz 下正好 100ms)的静音去走原生装载。
        byte[] longPcm = Au8(2205 * 2);
        byte[] wavLong = AudSound.WavContainer(longPcm, 22050);
        AudioClip wavClip = AudioClip.LoadWavFromMem(
            wavLong.ToStr(0, wavLong.Length), wavLong.Length);
        Report("wav container parses natively",
               wavClip.IsValid() ? 1 : 0, 1);
        Report("wav clip frequency",
               wavClip.IsValid() ? wavClip.Frequency() : 0 - 1, 22050);
        Report("wav clip duration",
               wavClip.IsValid() && wavClip.DurationMs() > 0 ? 1 : 0, 1);

        // sound.ini 解析:Defaults 承底、$ 引用剥离、Sounds= 行内 Control=
        // 截断、Range=-2 化无穷、Type 缺空间类时回退 Defaults。
        string soundIni = "[Defaults]\n"
            + "MinVolume=20\nRange=10\nVolume=50\nLimit=1\n"
            + "Type=Screen\nPriority=Normal\n"
            + "[SoundList]\n1=MyShot\n2=MyLoop\n3=MyProbe\n"
            + "[MyShot]\nSounds=$alpha $beta Control=Random\nVolume=80\n"
            + "Delay=100 200\nType=Local\nRange=-2\nLimit=3\nLoop=5\n"
            + "MinVolume=25\nVShift=40 60\nAttack=1\nDecay=1\n"
            + "Control=Interrupt\n"
            + "[MyLoop]\nSounds=solo\nType=Global Normal\n"
            + "[MyProbe]\nType=Player\n";
        SoundSpecs specs = SoundSpecs.Parse(IniParser.Parse(soundIni));
        Report("sound ini parses three specs", specs.Count(), 3);
        SoundSpec shot = specs.Spec("myshot");
        Report("sound spec lookup caseless", shot != null ? 1 : 0, 1);
        Report("sound spec dollar strip",
               shot != null && shot.sounds.Count == 2
               && shot.sounds[0] == "alpha" && shot.sounds[1] == "beta"
                   ? 1 : 0, 1);
        Report("sound spec volume", shot != null ? shot.volume : 0 - 1,
               80);
        Report("sound spec delay pair",
               shot != null && shot.delaySet && shot.delayMin == 100
               && shot.delayMax == 200 ? 1 : 0, 1);
        Report("sound spec range inf",
               shot != null ? shot.range : 0, 2147483647);
        Report("sound spec limit", shot != null ? shot.limit : 0 - 1, 3);
        Report("sound spec loop", shot != null ? shot.loop : 0 - 1, 5);
        Report("sound spec minvolume",
               shot != null ? shot.minVolume : 0 - 1, 25);
        Report("sound spec vshift pair",
               shot != null && shot.vShiftSet && shot.vShiftMin == 40
               && shot.vShiftMax == 60 ? 1 : 0, 1);
        // 参考的 parseSoundNames 把 Sounds= 行内第一个 control= 起的
        // token 截断丢弃——Control 位只来自独立的 Control= 键,行内那份
        // 不生效。所以位里只有 Interrupt,没有 Random。
        Report("sound spec controls",
               shot != null
               && (shot.controlBits & (SndSpecText.ControlRandom()
                  | SndSpecText.ControlAttack()
                  | SndSpecText.ControlDecay())) == 0
               && (shot.controlBits & SndSpecText.ControlInterrupt()) != 0
                   ? 1 : 0, 1);
        SoundSpec loop = specs.Spec("MyLoop");
        Report("sound spec default limit",
               loop != null ? loop.limit : 0 - 1, 1);
        Report("sound spec default volume",
               loop != null ? loop.volume : 0 - 1, 50);
        Report("sound spec global type",
               loop != null
               && (loop.typeBits & SndSpecText.TypeGlobal()) != 0 ? 1 : 0,
               1);
        SoundSpec probe = specs.Spec("MyProbe");
        Report("sound spec type fallback adds screen",
               probe != null
               && (probe.typeBits & SndSpecText.TypePlayer()) != 0
               && (probe.typeBits & SndSpecText.TypeScreen()) != 0
                   ? 1 : 0, 1);

        // 位置音量:Local 的 range*sqrt2 截断 + 平方衰减,Screen 的线性
        // 衰减,Global 的他房 MinVolume。
        SndEngine engineS = SndEngine.Create();
        engineS.SetViewport(20.0, 20.0, 600.0, 300.0);
        SoundSpec localSpec = new SoundSpec();
        localSpec.name = "LocalSpec";
        localSpec.typeBits = SndSpecText.TypeLocal();
        localSpec.range = 10;
        localSpec.volume = 100;
        localSpec.sounds = new List<string>();
        localSpec.sounds.Add("a");
        int volCenter = (int)(engineS.EffectVolume(localSpec, 20.0, 20.0,
            0, 1.0) * 1000.0);
        Report("world local at center full", volCenter, 1000);
        int volHalf = (int)(engineS.EffectVolume(localSpec, 27.0, 20.0,
            0, 1.0) * 1000.0);
        Report("world local half range falls",
               volHalf > 700 && volHalf < 800 ? 1 : 0, 1);
        int volFar = (int)(engineS.EffectVolume(localSpec, 40.0, 20.0,
            0, 1.0) * 1000.0);
        Report("world local past range silent", volFar, 0);
        SoundSpec screenSpec = new SoundSpec();
        screenSpec.name = "ScreenSpec";
        screenSpec.typeBits = SndSpecText.TypeScreen();
        screenSpec.volume = 100;
        screenSpec.sounds = new List<string>();
        screenSpec.sounds.Add("a");
        int volScreen = (int)(engineS.EffectVolume(screenSpec, 20.0 + 75.0,
            20.0, 0, 1.0) * 1000.0);
        Report("world screen half falloff", volScreen, 500);
        SoundSpec globalSpec = new SoundSpec();
        globalSpec.name = "GlobalSpec";
        globalSpec.typeBits = SndSpecText.TypeGlobal();
        globalSpec.volume = 100;
        globalSpec.minVolume = 20;
        globalSpec.sounds = new List<string>();
        globalSpec.sounds.Add("a");
        int volGlobal = (int)(engineS.EffectVolume(globalSpec, 0.0, 0.0,
            1, 1.0) * 1000.0);
        Report("world global other side minvolume", volGlobal, 200);
        Report("world no-shroud list",
               SndEngine.NoShroudKey("SellSound")
               && !SndEngine.NoShroudKey("MyShot") ? 1 : 0, 1);

        // eva.ini:侧别列、优先级、队列;EVA 的等待纪律(优先级说话、
        // 五秒冷却、批量只留一条)。
        string evaIni = "[DialogList]\n1=000I000\n2=000I002\n3=000I003\n"
            + "[000I000]\nText=Construction complete\nAllied=CONCOMP1\n"
            + "Russian=CONCOMP1\nPriority=Important\n"
            + "[000I002]\nText=Unit ready\nAllied=UNITRDY1\n"
            + "Russian=UNITRDY1\nType=queue\n"
            + "[000I003]\nText=Low power\nAllied=LOWPWR1\n"
            + "Russian=LOWPWR1\nPriority=Critical\n";
        SndEngine engineE = SndEngine.Create();
        engineE.evaSpecs = EvaSpecs.Parse(IniParser.Parse(evaIni), 0);
        engineE.eva = Eva.Create(engineE.evaSpecs, engineE);
        Report("eva side prefix allied",
               EvaSpecs.PrefixForSide(Side2.Allied()) == "Allied" ? 1 : 0,
               1);
        Report("eva table parsed", engineE.EvaCount(), 3);
        EvaSpec comp = engineE.evaSpecs.Spec("000I000");
        Report("eva sound column",
               comp != null && comp.sound == "CONCOMP1" ? 1 : 0, 1);
        Report("eva priority important",
               comp != null && comp.priority == 2 ? 1 : 0, 1);
        EvaSpec ready = engineE.evaSpecs.Spec("000I002");
        Report("eva queue flag",
               ready != null && ready.queue ? 1 : 0, 1);
        engineE.EvaPlay("000I000", false);
        engineE.EvaPlay("000I003", false);
        engineE.eva.Update(0);
        Report("eva critical speaks first",
               engineE.eva.waiting.Count == 1
               && engineE.eva.waiting[0] == comp ? 1 : 0, 1);
        engineE.eva.Update(1);
        Report("eva queue drains", engineE.eva.waiting.Count, 0);
        engineE.EvaPlay("000I000", false);
        engineE.eva.Update(100);
        Report("eva cooldown holds",
               engineE.eva.waiting.Count == 0
               && !engineE.EvaSpeaking() ? 1 : 0, 1);
        engineE.EvaPlay("000I000", false);
        engineE.eva.Update(5200);
        bool spoke5200 = false;
        for (int i = 0; i < engineE.eva.lastPlayedNames.Count;
          i = i + 1) {
            if (engineE.eva.lastPlayedNames[i] == "CONCOMP1"
             && engineE.eva.lastPlayedAt[i] == 5200) {
                spoke5200 = true;
            }
        }
        Report("eva cooldown releases", spoke5200 ? 1 : 0, 1);

        // theme.ini:Normal 出播放表、Repeat 循环、shuffle 同集、选项串
        // 序列化往返。
        string themeIni = "[Themes]\n1=GRIND\n2=DEFEND\n3=HIDEF\n"
            + "[GRIND]\nName=Grinder\nSound=GRINDER\nNormal=yes\n"
            + "[DEFEND]\nName=Defend\nSound=DEFEND\nNormal=yes\n"
            + "Repeat=yes\n"
            + "[HIDEF]\nName=Hidden\nSound=HIDDEN\nNormal=no\n";
        SndEngine engineM = SndEngine.Create();
        engineM.musicSpecs = MusicSpecs.Parse(IniParser.Parse(themeIni));
        engineM.music = MusicPlayer.Create(engineM.musicSpecs, engineM);
        Report("music table parsed", engineM.MusicCount(), 3);
        List<MusicSpec> playlist = engineM.music.BuildPlaylist(false);
        Report("music playlist normal only", playlist.Count, 2);
        List<MusicSpec> shuffled = engineM.music.BuildPlaylist(true);
        Report("music shuffle same set",
               shuffled.Count == 2
               && (shuffled[0] != shuffled[1]) ? 1 : 0, 1);
        engineM.music.UnserializeOptions("1,1,Defend");
        // 参考语义:反序列化把 "Defend" 存进 initialRepeatName(播放时
        // 从播放表里找它起播),但此刻没有已装载的播放表,序列化时名字
        // 段落空——"1,1," 而不是回显输入。
        Report("music options roundtrip",
               engineM.music.ShuffleMode()
               && engineM.music.RepeatMode()
               && engineM.music.initialRepeatName == "Defend"
               && engineM.music.SerializeOptions() == "1,1,"
                   ? 1 : 0, 1);
        // 混音台:滑条、静音、序列化。
        engineM.SetVolume(Ch.Voice(), 0.5);
        Report("mixer voice volume",
               engineM.ChannelGainOf(Ch.Voice()) == 0.5 ? 1 : 0, 1);
        engineM.SetMuted(Ch.Voice(), true);
        Report("mixer voice mute",
               engineM.ChannelGainOf(Ch.Voice()) < 0.001 ? 1 : 0, 1);
        engineM.SetMuted(Ch.Voice(), false);
        Report("mixer unmute keeps slider",
               engineM.ChannelGainOf(Ch.Voice()) == 0.5 ? 1 : 0, 1);
        string mix = engineM.SerializeMixer();
        engineM.SetVolume(Ch.Voice(), 1.0);
        engineM.UnserializeMixer(mix);
        Report("mixer serialize roundtrip",
               engineM.ChannelGainOf(Ch.Voice()) == 0.5 ? 1 : 0, 1);
        // 真实安装的表状态:本机 rip 没有音频表,引擎必须以空表静音装载
        // 而不是崩。表数打印出来,有表/无表都算通过。
        string instDir = "data";
        if (!File.Exists(instDir + "/ra2.mix")) { instDir = "../data"; }
        if (File.Exists(instDir + "/ra2.mix")) {
            Vfs vfsInst = AssetDb.MountInstall(instDir);
            SndEngine engineI = SndEngine.Create();
            engineI.Load(vfsInst, IniParser.Parse("\n"), 0);
            Console.WriteLine("winchain install tables: sound="
                + Convert.ToString(engineI.SpecCount())
                + " eva=" + Convert.ToString(engineI.EvaCount())
                + " music=" + Convert.ToString(engineI.MusicCount())
                + " (probe-only line)");
        } else {
            Console.WriteLine("winchain install tables: no data/ mount");
        }

        Console.WriteLine(failures == 0 ? "winchain ok"
                          : "winchain FAILED " + Convert.ToString(failures));
        if (failures > 0) { return 1; }
        return 0;
    }
}
