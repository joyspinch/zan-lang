using System;

namespace Match3;

// Gem-night skin for every standard control in the shell: violet glass
// panels with a gold rim, gold call-to-action buttons, round map nodes.
// Palette: night #140f26 / panel #2e2358 / rim #5b4a99 / gold #ffd666 /
// pink accent #ff85c0 / sky #69c0ff / lavender text #cfc4ff.
public class Match3Skin {
    public static string NodeClass(int i) { return "m3-n" + Convert.ToString(i + 1); }

    // Map node positions follow the winding path in Match3Scenes.NodeX/NodeY.
    static string NodeCss() {
        string css = "";
        for (int i = 0; i < Match3Levels.Count; i = i + 1) {
            css = css + "button." + Match3Skin.NodeClass(i) + "{left:" + Convert.ToString(Match3Scenes.NodeX(i) - 36)
                + "dpx;top:" + Convert.ToString(Match3Scenes.NodeY(i) - 36) + "dpx}";
        }
        return css;
    }

    public static string Css() {
        return Match3Skin.NodeCss() + ".match3-hud{position:relative;background:transparent;padding:0;border:0}"
            + "label.m3l{position:absolute;padding:0;margin:0;border:0;background:transparent;"
            + "vertical-align:top;text-align:center}"
            + "label.m3-level-title{left:140dpx;top:6dpx;width:440dpx;height:40dpx;font-size:28dpx;color:#ffd666}"
            + "label.m3-tip{left:30dpx;top:798dpx;width:660dpx;height:28dpx;font-size:18dpx;color:#ffe58f}"
            + "label.m3-keys{left:20dpx;top:886dpx;width:680dpx;height:22dpx;font-size:14dpx;color:#8a7fb8}"
            // chips
            + "button.m3-chip{position:absolute;top:8dpx;height:32dpx;padding:0;margin:0;"
            + "justify-content:center;align-items:center;font-size:14dpx;color:#e6dcff;"
            + "background:linear-gradient(#3a2d6e,#261c4a);border:2dpx solid #5b4a99;border-radius:16dpx}"
            + "button.m3-pause-btn,button.m3-back-btn{left:16dpx;width:100dpx}"
            + "button.m3-mute-btn{left:578dpx;width:126dpx}"
            + "button.m3-chip:hover{background:linear-gradient(#4a3a8a,#30245c);border-color:#ffd666}"
            + "button.m3-chip:active{background:#1d1538}"
            + "button.m3-chip:focus{border:2dpx solid #69c0ff}"
            + "button.m3-chip:disabled{color:#5d5385;background:#1d1636;border-color:#2f2752}"
            // pods
            + ".m3-pod{position:absolute;top:56dpx;height:118dpx;padding:0;margin:0;"
            + "background:linear-gradient(#332763,#1b1436);"
            + "border:2dpx solid #5b4a99;border-radius:18dpx;box-shadow:0 6dpx 16dpx rgba(0,0,0,0.45)}"
            + ".m3-moves-pod{left:24dpx;width:150dpx}"
            + ".m3-goal-pod{left:186dpx;width:348dpx;border-color:#8a6fd8}"
            + ".m3-score-pod{left:546dpx;width:150dpx}"
            + "label.m3-cap{left:0;top:10dpx;width:100%;height:18dpx;font-size:13dpx;color:#b9a8ff}"
            + "label.m3-moves-value{left:0;top:32dpx;width:100%;height:62dpx;font-size:52dpx;color:#ffffff}"
            + "label.m3-goal-item{top:52dpx;width:110dpx;height:40dpx;font-size:30dpx;color:#ffffff;text-align:left}"
            + "label.m3-score-value{left:0;top:36dpx;width:100%;height:40dpx;font-size:32dpx;color:#ffd666}"
            + ".m3-meter{position:absolute;left:14dpx;top:88dpx;width:122dpx;height:12dpx;padding:0;margin:0}"
            // cards
            + ".m3-card{position:absolute;padding:0;margin:0;background:linear-gradient(#2c2156,#160f2c);"
            + "border:3dpx solid #ffd666;border-radius:22dpx;box-shadow:0 14dpx 36dpx rgba(0,0,0,0.6)}"
            + ".m3-banner{left:100dpx;top:330dpx;width:520dpx;height:180dpx;border-color:#ff85c0}"
            + "label.m3-banner-title{left:0;top:22dpx;width:100%;height:52dpx;font-size:44dpx;color:#ffd666}"
            + "label.m3-banner-goal{left:0;top:86dpx;width:100%;height:32dpx;font-size:24dpx;color:#ffffff}"
            + "label.m3-banner-moves{left:0;top:126dpx;width:100%;height:28dpx;font-size:19dpx;color:#b9a8ff}"
            + ".m3-title-card{left:70dpx;top:250dpx;width:580dpx;height:500dpx}"
            + "label.m3-h1{left:0;top:24dpx;width:100%;height:64dpx;font-size:54dpx;color:#ffd666}"
            + "label.m3-sub{left:0;top:92dpx;width:100%;height:26dpx;font-size:17dpx;color:#cfc4ff}"
            + "label.m3-how-head{left:0;top:138dpx;width:100%;height:24dpx;font-size:16dpx;color:#69c0ff}"
            + "label.m3-how{left:50dpx;width:480dpx;height:26dpx;font-size:17dpx;color:#f0eaff;text-align:left}"
            + "label.m3-how1{top:172dpx}label.m3-how2{top:202dpx}label.m3-how3{top:232dpx}label.m3-how4{top:262dpx}"
            + "label.m3-title-stats{left:0;top:308dpx;width:100%;height:26dpx;font-size:17dpx;color:#ffe58f}"
            + "label.m3-card-keys{left:0;width:100%;height:22dpx;font-size:14dpx;color:#8a7fb8}"
            + "label.m3-title-keys{top:452dpx}"
            + "label.m3-h2{left:0;top:24dpx;width:100%;height:50dpx;font-size:40dpx;color:#ffffff}"
            + ".m3-pause-card{left:110dpx;top:250dpx;width:500dpx;height:400dpx;border-color:#69c0ff}"
            + "label.m3-pause-goal{left:20dpx;top:88dpx;width:460dpx;height:26dpx;font-size:16dpx;color:#cfc4ff}"
            + "label.m3-pause-keys{top:350dpx}"
            + ".m3-result{left:100dpx;top:318dpx;width:520dpx;height:400dpx}"
            + "label.m3-result-title{font-size:34dpx;height:46dpx}"
            + "label.m3-result-score{left:0;top:80dpx;width:100%;height:36dpx;font-size:30dpx;color:#ffd666}"
            + "label.m3-newbest{left:0;top:120dpx;width:100%;height:30dpx;font-size:22dpx;color:#ff85c0}"
            + "label.m3-result-best{left:0;top:154dpx;width:100%;height:26dpx;font-size:18dpx;color:#f0eaff}"
            + "label.m3-result-stats{left:0;top:186dpx;width:100%;height:22dpx;font-size:14dpx;color:#b9a8ff}"
            + "label.m3-result-keys{top:364dpx}"
            // level map
            + ".m3-map{position:absolute;left:0;top:0;width:720dpx;height:924dpx;padding:0;margin:0;"
            + "background:transparent;border:0}"
            + "label.m3-map-stars{left:334dpx;top:60dpx;width:140dpx;height:32dpx;font-size:24dpx;color:#ffd666;text-align:left}"
            + "button.m3-node{position:absolute;width:72dpx;height:72dpx;padding:0;margin:0;justify-content:center;"
            + "align-items:center;font-size:24dpx;color:#ffffff;border-radius:22dpx;"
            + "background:linear-gradient(#8a6be6,#4a2f9a);border:3dpx solid #cfc4ff}"
            + "button.m3-node-done{color:#3a2400;background:linear-gradient(#ffe58f,#d48806);border-color:#fff1b8}"
            + "button.m3-node-next{color:#ffffff;background:linear-gradient(#ff9ccf,#c41d7f);border-color:#ffffff}"
            + "button.m3-node:hover{border-color:#ffd666;background:linear-gradient(#a084f0,#5a3cb0)}"
            + "button.m3-node-done:hover{background:linear-gradient(#fff1b8,#faad14)}"
            + "button.m3-node-next:hover{background:linear-gradient(#ffb8dc,#eb2f96)}"
            + "button.m3-node:active{background:#3a237e}"
            + "button.m3-node:focus{border:3dpx solid #69c0ff}"
            + "button.m3-node:disabled{color:#5d5385;background:#221a40;border-color:#3a2f62}"
            // card buttons: gold call-to-action and violet secondary
            + "button.m3-cta,button.m3-ghost{position:absolute;padding:0;margin:0;justify-content:center;"
            + "align-items:center;border-radius:30dpx}"
            + "button.m3-cta{font-size:26dpx;color:#3a2400;background:linear-gradient(#ffe58f,#faad14);"
            + "border:3dpx solid #fff1b8;box-shadow:0 6dpx 14dpx rgba(0,0,0,0.45)}"
            + "button.m3-ghost{font-size:20dpx;color:#f0eaff;background:linear-gradient(#3a2d6e,#261c4a);"
            + "border:2dpx solid #6b5ab0}"
            + "button.m3-cta label,button.m3-ghost label,button.m3-chip label,button.m3-node label{background:transparent;"
            + "border:0;padding:0;margin:0;font-size:inherit;color:inherit;text-align:center}"
            + "button.m3-cta:hover{background:linear-gradient(#fff1b8,#ffc53d)}"
            + "button.m3-cta:active{background:#d48806}"
            + "button.m3-cta:focus{border:3dpx solid #69c0ff}"
            + "button.m3-ghost:hover{background:linear-gradient(#4a3a8a,#30245c);border-color:#ffd666}"
            + "button.m3-ghost:active{background:#1d1538}"
            + "button.m3-ghost:focus{border:2dpx solid #69c0ff}"
            + "button.m3-cta:disabled,button.m3-ghost:disabled{color:#5d5385;background:#1d1636;border-color:#2f2752}"
            + "button.m3-play-btn{left:150dpx;top:354dpx;width:280dpx;height:66dpx;font-size:30dpx}"
            + "button.m3-resume-btn{left:110dpx;top:140dpx;width:280dpx;height:60dpx}"
            + "button.m3-restart-btn{left:110dpx;top:214dpx;width:280dpx;height:50dpx}"
            + "button.m3-pmap-btn{left:110dpx;top:276dpx;width:280dpx;height:50dpx}"
            + "button.m3-next-btn{left:130dpx;top:222dpx;width:260dpx;height:62dpx}"
            + "button.m3-retry-btn{left:60dpx;top:300dpx;width:190dpx;height:48dpx}"
            + "button.m3-rmap-btn{left:270dpx;top:300dpx;width:190dpx;height:48dpx}"
            + "button.m3-rmap-solo{left:165dpx}";
    }
}
