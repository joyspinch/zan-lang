using System;
using System.Collections.Generic;
using Gui;
using Game.Foundation.Gui;
using Game.Kit;
using Match3;

public class Match3Loop : IGuiHostLoop {
    public Match3Game game;

    public void Start(GuiHost host) {
        this.game = Match3Game.Create();
    }

    public void Event(GuiHost host, int kind, int code) {
        if (kind == 4) { // KeyDown
            if (code == 27) { // ESC
                host.App().isRunning = false;
            }
        } else if (kind == 1) { // MouseDown / Click
            int mx = host.MouseX();
            int my = host.MouseY();
            this.game.OnClick(mx, my);
        }
    }

    public void FixedUpdate(GuiHost host, int dt) {
        this.game.Update((double)dt / 1000.0);
    }

    public void Update(GuiHost host, int dt) { }

    public void Render(GuiHost host, Canvas c, double alpha) {
        this.game.Render(c);
    }

    public void Stop(GuiHost host) { }
}

public class App {
    public static void Main() {
        GuiHost host = new GuiHost("Match-3 Puzzle - Zan Game", 720, 960, 60);
        host.Run(new Match3Loop());
    }
}
