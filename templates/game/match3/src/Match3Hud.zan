using System;
using Gui;
using Gui.Widget;
using Game.Foundation;
using Game.Foundation.Gui;

namespace Match3;

// The game shell: title -> level map -> playing <-> paused -> results.
// One retained tree of standard Panel / Label / Button / Progress controls,
// skinned in Css() with the game's night-violet + gold art language; the
// canvas only paints world art (board, map path, stars, effects) and icons.
// Audio (SfxBank) and progress (GameProfile) live here in the view layer;
// Match3Game / Match3Sim never touch them, so replays stay deterministic.
public class Match3Hud : UiViewOwner {
    public const int StateTitle = 0;
    public const int StateMap = 1;
    public const int StatePlaying = 2;
    public const int StatePaused = 3;
    public const int StateResults = 4;

    public Panel root;
    public Label levelTitle;
    public Button pauseButton;
    public Button muteButton;
    public Button mapBackButton;
    public Label tip;
    public Label keys;

    // in-game pods
    public Panel movesPod;
    public Label movesValue;
    public Panel goalPod;
    public Label goalCaption;
    public Label[] goalItems;
    public Panel scorePod;
    public Label scoreValue;
    public Progress scoreMeter;

    // level intro banner
    public Panel banner;
    public Label bannerTitle;
    public Label bannerGoal;
    public Label bannerMoves;
    public double bannerT;

    // title
    public Panel titlePanel;
    public Label titleStats;
    public Button playButton;

    // level map
    public Panel mapPanel;
    public Label mapStars;
    public Button[] nodes;

    // pause
    public Panel pausePanel;
    public Label pauseGoal;
    public Button resumeButton;
    public Button restartButton;
    public Button pauseMapButton;

    // results
    public Panel result;
    public Label resultTitle;
    public Label resultScore;
    public Label resultNewBest;
    public Label resultBest;
    public Label resultStats;
    public Button nextButton;
    public Button retryButton;
    public Button resultMapButton;

    public int state;
    public Match3Game game;
    public GameProfile profile;
    public Match3Fx uiFx;
    public double clock;
    public double resultT;
    public int resultStars;
    public int starsShown;
    public bool lastNewBest;
    public bool debug;
    SfxBank sfx;
    AudioBus bus;
    bool muted;
    int seenRev;
    bool pressed;
    int pressX;
    int pressY;
    weak GuiHost host;
    UiViewScope view;

    public Match3Hud(GuiHost host, Match3Game game, GameProfile profile, SfxBank sfx, AudioBus bus) {
        this.host = host;
        this.game = game;
        this.profile = profile;
        this.sfx = sfx;
        this.bus = bus;
        this.uiFx = new Match3Fx();
        this.state = StateTitle;
        this.seenRev = -1;
        this.debug = Environment.GetEnvironmentVariable("MATCH3_DEBUG") == "1";
        this.muted = profile.Flag("muted", false);
        if (bus != null) { bus.SetSfxMuted(this.muted); }
        host.App().UseCss(Match3Hud.Css());
        this.root = new Panel("match3-hud");
        this.root.Class = "match3-hud";

        this.levelTitle = this.AddLabel(this.root, "", "m3-level-title");
        this.tip = this.AddLabel(this.root, "", "m3-tip");
        this.keys = this.AddLabel(this.root, "", "m3-keys");

        this.movesPod = this.AddPanel(this.root, "m3-moves", "m3-pod m3-moves-pod");
        this.AddLabel(this.movesPod, "MOVES", "m3-cap");
        this.movesValue = this.AddLabel(this.movesPod, "", "m3-moves-value");
        this.goalPod = this.AddPanel(this.root, "m3-goal", "m3-pod m3-goal-pod");
        this.goalCaption = this.AddLabel(this.goalPod, "GOAL", "m3-cap");
        this.goalItems = new Label[3];
        for (int i = 0; i < 3; i = i + 1) {
            this.goalItems[i] = this.AddLabel(this.goalPod, "", "m3-goal-item");
        }
        this.scorePod = this.AddPanel(this.root, "m3-score", "m3-pod m3-score-pod");
        this.AddLabel(this.scorePod, "SCORE", "m3-cap");
        this.scoreValue = this.AddLabel(this.scorePod, "", "m3-score-value");
        this.scoreMeter = new Progress(0, 0);
        this.scoreMeter.Class = "m3-meter";
        this.scoreMeter.ShowText(false);
        this.scoreMeter.StrokeWidth(10);
        this.scoreMeter.FillColor(unchecked((int)0xFFFFC53D));
        this.scoreMeter.RailColor(unchecked((int)0xFF2A2048));
        this.scorePod.Add(this.scoreMeter);

        this.banner = this.AddPanel(this.root, "m3-banner", "m3-card m3-banner");
        this.bannerTitle = this.AddLabel(this.banner, "", "m3-banner-title");
        this.bannerGoal = this.AddLabel(this.banner, "", "m3-banner-goal");
        this.bannerMoves = this.AddLabel(this.banner, "", "m3-banner-moves");

        // Title
        this.titlePanel = this.AddPanel(this.root, "m3-title", "m3-card m3-title-card");
        this.AddLabel(this.titlePanel, "GEM CASCADE", "m3-h1");
        this.AddLabel(this.titlePanel, "A match-3 journey through 24 starlit levels", "m3-sub");
        this.AddLabel(this.titlePanel, "SPECIAL GEMS", "m3-how-head");
        this.AddLabel(this.titlePanel, "Line of 4  ->  STRIPED gem clears a line", "m3-how m3-how1");
        this.AddLabel(this.titlePanel, "L or T shape  ->  AREA BOMB blasts 3x3", "m3-how m3-how2");
        this.AddLabel(this.titlePanel, "Line of 5  ->  COLOUR BOMB clears a colour", "m3-how m3-how3");
        this.AddLabel(this.titlePanel, "Swap two specials together for a super combo", "m3-how m3-how4");
        this.titleStats = this.AddLabel(this.titlePanel, "", "m3-title-stats");
        this.playButton = this.AddButton(this.titlePanel, "PLAY", "m3-cta m3-play-btn");
        this.AddLabel(this.titlePanel, "ENTER  play     ESC  quit     M  sound", "m3-card-keys m3-title-keys");

        // Level map: 24 nodes on a winding path (path + stars painted by Match3Scenes).
        this.mapPanel = this.AddPanel(this.root, "m3-map", "m3-map");
        this.mapStars = this.AddLabel(this.mapPanel, "", "m3-map-stars");
        this.nodes = new Button[Match3Levels.Count];
        for (int i = 0; i < Match3Levels.Count; i = i + 1) {
            this.nodes[i] = this.AddButton(this.mapPanel, Convert.ToString(i + 1), "m3-node " + Match3Skin.NodeClass(i));
        }

        // Pause
        this.pausePanel = this.AddPanel(this.root, "m3-pause", "m3-card m3-pause-card");
        this.AddLabel(this.pausePanel, "PAUSED", "m3-h2");
        this.pauseGoal = this.AddLabel(this.pausePanel, "", "m3-pause-goal");
        this.resumeButton = this.AddButton(this.pausePanel, "RESUME", "m3-cta m3-resume-btn");
        this.restartButton = this.AddButton(this.pausePanel, "RESTART LEVEL", "m3-ghost m3-restart-btn");
        this.pauseMapButton = this.AddButton(this.pausePanel, "LEVEL MAP", "m3-ghost m3-pmap-btn");
        this.AddLabel(this.pausePanel, "P / ESC  resume", "m3-card-keys m3-pause-keys");

        // Results (the stars are painted above the card by Match3Scenes)
        this.result = this.AddPanel(this.root, "m3-result", "m3-card m3-result");
        this.resultTitle = this.AddLabel(this.result, "", "m3-h2 m3-result-title");
        this.resultScore = this.AddLabel(this.result, "", "m3-result-score");
        this.resultNewBest = this.AddLabel(this.result, "NEW BEST!", "m3-newbest");
        this.resultBest = this.AddLabel(this.result, "", "m3-result-best");
        this.resultStats = this.AddLabel(this.result, "", "m3-result-stats");
        this.nextButton = this.AddButton(this.result, "NEXT LEVEL", "m3-cta m3-next-btn");
        this.retryButton = this.AddButton(this.result, "REPLAY", "m3-ghost m3-retry-btn");
        this.resultMapButton = this.AddButton(this.result, "LEVEL MAP", "m3-ghost m3-rmap-btn");
        this.AddLabel(this.result, "ENTER  continue     ESC  level map", "m3-card-keys m3-result-keys");

        // Chips last so they stay on top.
        this.pauseButton = this.AddButton(this.root, "PAUSE", "m3-chip m3-pause-btn");
        this.mapBackButton = this.AddButton(this.root, "MENU", "m3-chip m3-back-btn");
        this.muteButton = this.AddButton(this.root, "", "m3-chip m3-mute-btn");
        this.SyncState();
    }

    Label AddLabel(Control parent, string text, string cls) {
        Label l = new Label(text);
        l.Class = "m3l " + cls;
        parent.Add(l);
        return l;
    }

    Button AddButton(Control parent, string text, string cls) {
        Button b = new Button(text);
        b.Class = cls;
        parent.Add(b);
        return b;
    }

    Panel AddPanel(Control parent, string name, string cls) {
        Panel p = new Panel(name);
        p.Class = cls;
        parent.Add(p);
        return p;
    }

    // ---- progress ----

    public static string StarKey(int index) { return "stars_" + Convert.ToString(index + 1); }
    public static string ScoreKey(int index) { return "score_" + Convert.ToString(index + 1); }

    public int StarsOf(int index) { return (int)this.profile.Best(StarKey(index)); }

    public bool Unlocked(int index) {
        if (index <= 0 || this.debug) { return true; }
        return this.StarsOf(index - 1) > 0;
    }

    public int TotalStars() {
        int n = 0;
        for (int i = 0; i < Match3Levels.Count; i = i + 1) { n = n + this.StarsOf(i); }
        return n;
    }

    // First unlocked level without stars (the glowing "you are here" node).
    public int CurrentLevel() {
        for (int i = 0; i < Match3Levels.Count; i = i + 1) {
            if (this.StarsOf(i) == 0) { return i; }
        }
        return Match3Levels.Count - 1;
    }

    // ---- sound ----

    public void Play(string name) {
        if (this.sfx != null) { this.sfx.Play(name); }
    }

    public void Play(string name, double gain) {
        if (this.sfx != null) { this.sfx.Play(name, gain); }
    }

    public void ToggleMute() {
        this.muted = !this.muted;
        if (this.bus != null) { this.bus.SetSfxMuted(this.muted); }
        this.profile.SetFlag("muted", this.muted);
        this.profile.Save();
        this.Play("click");
        this.SyncState();
    }

    // ---- flow ----

    public void ShowMap() {
        this.state = StateMap;
        this.Play("click");
        this.SyncState();
    }

    public void ShowTitle() {
        this.state = StateTitle;
        this.Play("click");
        this.SyncState();
    }

    public void StartLevel(int index) {
        if (!this.Unlocked(index)) { this.Play("error"); return; }
        this.game.LoadLevel(index);
        this.state = StatePlaying;
        this.bannerT = 2.6;
        this.pressed = false;
        this.Play("click");
        this.Play("whoosh", 0.8);
        this.SyncState();
    }

    public void Pause() {
        if (this.state != StatePlaying) { return; }
        this.state = StatePaused;
        this.Play("click");
        this.SyncState();
    }

    public void Resume() {
        if (this.state != StatePaused) { return; }
        this.state = StatePlaying;
        this.Play("click");
        this.SyncState();
    }

    public void Quit() {
        GuiHost owner = this.host;
        if (owner != null) { owner.RequestStop(); }
    }

    public void Next() {
        if (this.state != StateResults) { return; }
        int i = this.game.levelIndex;
        if (this.game.won && i + 1 < Match3Levels.Count) { this.StartLevel(i + 1); }
        else { this.StartLevel(i); }
    }

    // Keyboard shell: M mute, P/Esc pause, Enter/Space confirm. Keys a focused
    // standard control consumed never reach here.
    public void Key(int code) {
        if (code == 77) { this.ToggleMute(); return; }               // M
        if (this.debug && this.state == StatePlaying) {
            if (code == 68) { this.game.DebugSpecials(); return; }   // D
            if (code == 87) { this.game.DebugWin(); return; }        // W
            if (code == 76) { this.game.DebugLose(); return; }       // L
        }
        if (code == 80 || code == 27) {                              // P / Esc
            if (this.state == StatePlaying) { this.Pause(); }
            else if (this.state == StatePaused) { this.Resume(); }
            else if (code == 27 && (this.state == StateResults || this.state == StateMap)) {
                if (this.state == StateMap) { this.ShowTitle(); } else { this.ShowMap(); }
            }
            else if (code == 27 && this.state == StateTitle) { this.Quit(); }
            return;
        }
        if (code == 13 || code == 32) {                              // Enter / Space
            if (this.state == StateTitle) { this.ShowMap(); }
            else if (this.state == StateMap) { this.StartLevel(this.CurrentLevel()); }
            else if (this.state == StateResults) { this.Next(); }
        }
    }

    int DesignX() {
        GuiHost owner = this.host;
        return owner == null ? -1 : owner.App().mouseX;
    }

    int DesignY() {
        GuiHost owner = this.host;
        return owner == null ? -1 : owner.App().mouseY - owner.App().ContentTop();
    }

    // Board press: click-click or press-and-drag toward a neighbour.
    public bool PointerDown(Control target) {
        GuiHost owner = this.host;
        if (owner == null || owner.App().window.EventButton() != 0) { return false; }
        if (Match3Hud.InButton(target)) { return false; }
        if (this.state == StateTitle) {
            this.ShowMap();
            return true;
        }
        if (this.state != StatePlaying) { return false; }
        this.bannerT = this.bannerT > 0.3 ? 0.3 : this.bannerT;
        this.pressX = this.DesignX();
        this.pressY = this.DesignY();
        this.pressed = true;
        this.game.OnClick(this.pressX, this.pressY);
        return true;
    }

    public void PointerUp() {
        if (!this.pressed) { return; }
        this.pressed = false;
        if (this.state != StatePlaying || !this.game.hasSelection) { return; }
        int dx = this.DesignX() - this.pressX;
        int dy = this.DesignY() - this.pressY;
        int adx = dx < 0 ? -dx : dx;
        int ady = dy < 0 ? -dy : dy;
        if (adx < 22 && ady < 22) { return; }
        int c = this.game.selectedCol;
        int r = this.game.selectedRow;
        if (adx > ady) { c = c + (dx > 0 ? 1 : -1); } else { r = r + (dy > 0 ? 1 : -1); }
        if (c < 0 || c >= Match3Game.Cols || r < 0 || r >= Match3Game.Rows) { return; }
        this.game.OnClick(Match3Game.CellX(c), Match3Game.CellY(r));
    }

    static bool InButton(Control c) {
        Control cur = c;
        while (cur != null) {
            if (cur is Button) { return true; }
            cur = cur.Parent();
        }
        return false;
    }

    // ---- per-frame (Update, never Paint) ----

    public void Tick(double dt) {
        this.clock = this.clock + dt;
        this.uiFx.Update(dt);
        GuiHost owner = this.host;
        if (owner != null) {
            this.game.hoverX = this.state == StatePlaying ? this.DesignX() : -1;
            this.game.hoverY = this.state == StatePlaying ? this.DesignY() : -1;
        }
        this.DrainSounds();
        if (this.bannerT > 0.0) {
            this.bannerT = this.bannerT - dt;
            if (this.bannerT <= 0.0) { this.SyncState(); }
        }
        if (this.state == StatePlaying && this.game.gameOver) {
            this.FinishRound();
            return;
        }
        if (this.game.revision != this.seenRev) {
            this.seenRev = this.game.revision;
            this.SyncState();
        }
        if (this.state == StateResults) {
            this.resultT = this.resultT + dt;
            // Stars pop in one by one: burst + rising chime.
            while (this.starsShown < this.resultStars && this.resultT >= 0.55 + 0.45 * (double)this.starsShown) {
                int k = this.starsShown;
                this.starsShown = k + 1;
                int sx = Match3Scenes.ResultStarX(k);
                int sy = Match3Scenes.ResultStarY(k);
                this.uiFx.Burst((double)sx, (double)sy, unchecked((int)0xFFFFD666), 22);
                this.uiFx.Sparkle((double)sx, (double)sy, unchecked((int)0xFFFFFFFF), 10, 30.0);
                this.uiFx.Ring(sx, sy, 90, unchecked((int)0xFFFFE58F));
                this.Play("star" + Convert.ToString(k + 1));
                if (this.starsShown == this.resultStars && this.resultStars == 3) {
                    this.uiFx.Confetti(120.0, 260.0, Match3Scenes.ConfettiColors(), 40);
                    this.uiFx.Confetti(600.0, 260.0, Match3Scenes.ConfettiColors(), 40);
                    this.Play("success", 0.7);
                }
            }
        }
    }

    void DrainSounds() {
        int m = this.game.sfxMask;
        this.game.sfxMask = 0;
        if (m == 0 || this.state != StatePlaying) { return; }
        if ((m & Match3Game.SfxSelect) != 0) { this.Play("select"); }
        if ((m & Match3Game.SfxSwap) != 0) { this.Play("swap", 0.8); }
        if ((m & Match3Game.SfxInvalid) != 0) { this.Play("error"); }
        if ((m & Match3Game.SfxPop) != 0) {
            int lv = this.game.sfxCascade;
            if (lv < 1) { lv = 1; }
            if (lv > 4) { lv = 4; }
            this.Play("coin" + Convert.ToString(lv));
            if (this.game.sfxCascade >= 3) { this.Play("powerup", 0.6); }
        }
        if ((m & Match3Game.SfxCreate) != 0) { this.Play("create", 0.8); }
        if ((m & Match3Game.SfxStripe) != 0) { this.Play("laser"); }
        if ((m & Match3Game.SfxArea) != 0) { this.Play("explode", 0.8); }
        if ((m & Match3Game.SfxBomb) != 0) { this.Play("zap"); this.Play("explode"); }
        if ((m & Match3Game.SfxCrate) != 0) { this.Play("crate"); }
        if ((m & Match3Game.SfxJelly) != 0) { this.Play("jelly", 0.7); }
        if ((m & Match3Game.SfxLand) != 0) { this.Play("land", 0.35); }
        if ((m & Match3Game.SfxShuffle) != 0) { this.Play("shuffle"); }
        if ((m & Match3Game.SfxBonus) != 0) { this.Play("bonus", 0.7); }
    }

    void FinishRound() {
        bool won = this.game.won;
        int i = this.game.levelIndex;
        this.profile.Add("plays", 1);
        this.resultStars = this.game.Stars();
        this.lastNewBest = false;
        if (won) {
            this.profile.Add("clears", 1);
            this.profile.SubmitBest(StarKey(i), (long)this.resultStars);
            this.lastNewBest = this.profile.SubmitBest(ScoreKey(i), (long)this.game.score);
        }
        this.profile.Save();
        this.state = StateResults;
        this.resultT = 0.0;
        this.starsShown = 0;
        this.Play(won ? "success" : "fail");
        this.SyncState();
    }

    // Startup / business-event synchronisation; never called by Paint.
    public void SyncState() {
        bool playing = this.state == StatePlaying;
        bool inLevel = playing || this.state == StatePaused || this.state == StateResults;
        Match3Game g = this.game;
        Match3Level lv = g.level;
        long plays = this.profile.Counter("plays");

        if (inLevel) { this.levelTitle.SetProp("text", "LEVEL " + Convert.ToString(lv.number)); }
        else if (this.state == StateMap) { this.levelTitle.SetProp("text", "LEVEL MAP"); }
        this.levelTitle.SetShown(this.state != StateTitle);
        this.movesValue.SetProp("text", Convert.ToString(g.movesLeft));
        this.movesValue.SetProp("style", g.movesLeft <= 5 ? "color:#ff7875" : "color:#ffffff");
        this.scoreValue.SetProp("text", Convert.ToString(g.score));
        int pct = lv.star3 > 0 ? g.score * 100 / lv.star3 : 0;
        this.scoreMeter.SetPercent(pct > 100 ? 100 : pct);
        this.SyncGoal();
        this.muteButton.SetText(this.muted ? "SOUND: OFF" : "SOUND: ON");
        this.pauseButton.Disabled.Set(!playing);
        this.pauseButton.SetShown(inLevel);
        this.mapBackButton.SetShown(this.state == StateMap);
        bool pods = playing || this.state == StatePaused;
        this.movesPod.SetShown(pods);
        this.goalPod.SetShown(pods);
        this.scorePod.SetShown(pods);

        string tipText = "";
        if (playing && g.hintOn) { tipText = "Hint: swap the two glowing gems"; }
        else if (playing && lv.tip != "" && this.StarsOf(g.levelIndex) == 0) { tipText = lv.tip; }
        this.tip.SetProp("text", tipText);
        this.tip.SetShown(tipText != "");
        string keyText = "";
        if (inLevel) { keyText = "Click or drag gems to swap      P / ESC  pause      M  sound"; }
        else if (this.state == StateMap) { keyText = "Click a level to play      ENTER  next level      ESC  menu"; }
        this.keys.SetProp("text", keyText);
        this.keys.SetShown(keyText != "");

        this.bannerTitle.SetProp("text", "LEVEL " + Convert.ToString(lv.number));
        this.bannerGoal.SetProp("text", Match3Levels.GoalText(lv));
        this.bannerMoves.SetProp("text", "in " + Convert.ToString(lv.moves) + " moves");
        this.pauseGoal.SetProp("text", Match3Levels.GoalText(lv) + "  -  " + Convert.ToString(g.movesLeft) + " moves left");

        int total = this.TotalStars();
        this.titleStats.SetProp("text", plays == 0
            ? "24 levels  -  earn up to 3 stars on each"
            : "STARS  " + Convert.ToString(total) + " / " + Convert.ToString(Match3Levels.Count * 3)
                + "      GAMES  " + Convert.ToString(plays));
        this.mapStars.SetProp("text", Convert.ToString(total) + " / " + Convert.ToString(Match3Levels.Count * 3));
        int cur = this.CurrentLevel();
        for (int i = 0; i < Match3Levels.Count; i = i + 1) {
            bool open = this.Unlocked(i);
            string cls = "m3-node " + Match3Skin.NodeClass(i);
            if (!open) { cls = cls + " m3-node-locked"; }
            else if (this.StarsOf(i) > 0) { cls = cls + " m3-node-done"; }
            if (i == cur && open) { cls = cls + " m3-node-next"; }
            this.nodes[i].Class = cls;
            this.nodes[i].Disabled.Set(!open);
        }

        bool won = g.won;
        bool hasNext = g.levelIndex + 1 < Match3Levels.Count;
        this.resultTitle.SetProp("text", won ? "LEVEL " + Convert.ToString(lv.number) + " COMPLETE!" : "OUT OF MOVES");
        this.resultTitle.SetProp("style", won ? "color:#ffd666" : "color:#ff7875");
        this.resultScore.SetProp("text", "SCORE  " + Convert.ToString(g.score));
        this.resultBest.SetProp("text", won
            ? "BEST  " + Convert.ToString(this.profile.Best(ScoreKey(g.levelIndex)))
            : Match3Hud.LossReason(g));
        this.resultStats.SetProp("text", "BEST CHAIN  x" + Convert.ToString(g.bestCascade)
            + "      SPECIALS  " + Convert.ToString(g.specialsMade)
            + "      TOTAL STARS  " + Convert.ToString(total));
        this.nextButton.SetText(won ? (hasNext ? "NEXT LEVEL" : "PLAY AGAIN") : "TRY AGAIN");
        this.retryButton.SetShown(won);
        this.resultMapButton.Class = won ? "m3-ghost m3-rmap-btn" : "m3-ghost m3-rmap-btn m3-rmap-solo";

        this.ShowPanel(this.titlePanel, this.state == StateTitle);
        this.ShowPanel(this.mapPanel, this.state == StateMap);
        this.ShowPanel(this.pausePanel, this.state == StatePaused);
        this.ShowPanel(this.result, this.state == StateResults);
        this.ShowPanel(this.banner, playing && this.bannerT > 0.0);
        this.resultNewBest.SetShown(this.state == StateResults && this.lastNewBest);
    }

    static string LossReason(Match3Game g) {
        int lg = g.level.goal;
        if (lg == Match3Levels.GoalScore) { return Convert.ToString(g.GoalRemaining(0)) + " points short - so close!"; }
        if (lg == Match3Levels.GoalJelly) { return Convert.ToString(g.jellyLeft) + " jelly tiles left"; }
        if (lg == Match3Levels.GoalCrates) { return Convert.ToString(g.cratesLeft) + " crates left"; }
        int left = 0;
        for (int i = 0; i < g.level.collectColor.Length; i = i + 1) { left = left + g.GoalRemaining(i); }
        return Convert.ToString(left) + " gems still to collect";
    }

    // Goal pod: up to three icon + count slots (icons painted by Match3Scenes).
    void SyncGoal() {
        Match3Level lv = this.game.level;
        int n = Match3Scenes.GoalSlots(lv);
        for (int i = 0; i < 3; i = i + 1) {
            Label l = this.goalItems[i];
            if (i >= n) { l.SetShown(false); continue; }
            l.SetShown(true);
            int left = this.game.GoalRemaining(i);
            string text = left > 0 ? Convert.ToString(left) : "DONE";
            if (lv.goal == Match3Levels.GoalScore) { text = left > 0 ? Convert.ToString(lv.target) : "DONE"; }
            l.SetProp("text", text);
            int x = Match3Scenes.GoalIconX(n, i) - Match3Scenes.GoalPodX + 22;
            l.SetProp("style", "left:" + Convert.ToString(x) + "dpx;"
                + (left > 0 ? "color:#ffffff" : "color:#95de64"));
        }
        string cap = "GOAL";
        if (lv.goal == Match3Levels.GoalScore) { cap = "REACH SCORE"; }
        if (lv.goal == Match3Levels.GoalCollect) { cap = "COLLECT"; }
        if (lv.goal == Match3Levels.GoalJelly) { cap = "CLEAR JELLY"; }
        if (lv.goal == Match3Levels.GoalCrates) { cap = "BREAK CRATES"; }
        this.goalCaption.SetProp("text", cap);
    }

    void ShowPanel(Panel p, bool shown) {
        if (!shown && p.visible) {
            GuiHost owner = this.host;
            if (owner != null) { owner.App().ReleaseInputSubtree(p); }
        }
        p.SetShown(shown);
    }

    public void AttachPreparation(GuiHost owner) {
        if (owner == null) { return; }
        this.host = owner;
        if (this.view != null && this.view.IsActive()) { return; }
        if (this.view != null) { this.view.Retire(); }
        this.view = new UiViewScope(owner.App(), this, this.root);
        this.root.OnPreviewRouted(this.view.Action("pointer", this.root).Pointer);
        this.playButton.OnClick(this.view.Action("play", this.playButton).Run);
        this.resumeButton.OnClick(this.view.Action("resume", this.resumeButton).Run);
        this.restartButton.OnClick(this.view.Action("restart", this.restartButton).Run);
        this.pauseMapButton.OnClick(this.view.Action("map", this.pauseMapButton).Run);
        this.nextButton.OnClick(this.view.Action("next", this.nextButton).Run);
        this.retryButton.OnClick(this.view.Action("restart", this.retryButton).Run);
        this.resultMapButton.OnClick(this.view.Action("map", this.resultMapButton).Run);
        this.pauseButton.OnClick(this.view.Action("pause", this.pauseButton).Run);
        this.muteButton.OnClick(this.view.Action("mute", this.muteButton).Run);
        this.mapBackButton.OnClick(this.view.Action("title", this.mapBackButton).Run);
        for (int i = 0; i < Match3Levels.Count; i = i + 1) {
            this.nodes[i].OnClick(this.view.Action("level", this.nodes[i]).Run);
        }
    }

    public void StopPreparation() {
        UiViewScope previous = this.view; this.view = null; this.host = null;
        if (previous != null) { previous.Retire(); }
    }

    public void PrepareView(UiViewScope view, App app) {
        // The game owns this full-canvas region; the scope owns only its lifetime.
        Control inputRoot = app.rootControl;
        if (inputRoot == null || !inputRoot.ContainsInputControl(this.root)) { return; }
        // Below the GuiHost title bar (drawn over content on desktop).
        int top = app.ContentTop();
        view.Layout(0, top, app.canvas.Width(), app.canvas.Height() - top);
    }
    public void Layout(App app) {
        if (this.view != null) { this.PrepareView(this.view, app); }
    }
    public void ViewAction(string name, Control sender) {
        if (name == "play") { this.ShowMap(); }
        else if (name == "resume") { this.Resume(); }
        else if (name == "restart") { this.StartLevel(this.game.levelIndex); }
        else if (name == "map") { this.ShowMap(); }
        else if (name == "next") { this.Next(); }
        else if (name == "pause") { this.Pause(); }
        else if (name == "mute") { this.ToggleMute(); }
        else if (name == "title") { this.ShowTitle(); }
        else if (name == "level") {
            for (int i = 0; i < Match3Levels.Count; i = i + 1) {
                if (this.nodes[i] == sender) { this.StartLevel(i); return; }
            }
        }
    }
    public void ViewPointer(Control sender, RoutedEventArgs args) {
        string ev = args.eventName;
        if (ev == "PointerUp" || ev == "MouseUp") { this.PointerUp(); return; }
        if (ev != "PointerDown" && ev != "MouseDown") { return; }
        if (this.PointerDown(args.originalSource)) { args.Handle(); }
    }

    public static string Css() { return Match3Skin.Css(); }
}
