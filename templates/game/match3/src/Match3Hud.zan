using System;
using Gui;
using Gui.Widget;
using Game.Foundation.Gui;

namespace Match3;

// One retained tree per loop. Render only consumes the already-laid-out tree.
// Keep this template's existing raw Canvas coordinates; world viewport migration
// is a separate change. All overlay paint belongs to standard controls.
public class Match3Hud : UiViewOwner {
    public Panel root;
    public Label title;
    public Label score;
    public Label moves;
    public Panel result;
    public Label resultTitle;
    public Button replay;
    Match3Game game;
    weak GuiHost host;
    UiViewScope view;

    public Match3Hud(GuiHost host, Match3Game game) {
        this.host = host;
        this.game = game;
        host.App().UseCss(Match3Hud.Css());
        this.root = new Panel("match3-hud");
        this.root.Class = "match3-hud";
        this.title = new Label("CLASSIC MATCH-3");
        this.title.Class = "match3-title";
        this.root.Add(this.title);
        this.score = new Label("");
        this.score.Class = "match3-score";
        this.root.Add(this.score);
        this.moves = new Label("");
        this.moves.Class = "match3-moves";
        this.root.Add(this.moves);
        this.result = new Panel("match3-result");
        this.result.Class = "match3-result";
        this.resultTitle = new Label("");
        this.resultTitle.Class = "match3-result-title";
        this.result.Add(this.resultTitle);
        this.replay = new Button("CLICK ANYWHERE TO REPLAY");
        this.replay.Class = "match3-replay";
        this.result.Add(this.replay);
        this.root.Add(this.result);
        this.SyncState();
    }

    // Loop.Event handles only Esc. Input-pump preview handles every gameplay
    // down once, preserving left-down selection and anywhere-down replay.
    public bool PointerDown() {
        GuiHost owner = this.host;
        if (owner == null || owner.App().window.EventButton() != 0) { return false; }
        this.game.OnClick(owner.MouseX(), owner.MouseY());
        this.SyncState();
        return true;
    }

    public void Replay() {
        // The later Click from an anywhere-left-down restart must not restart
        // again or select. A standard semantic Button Click uses this same action.
        if (!this.game.gameOver) { return; }
        this.game.InitBoard();
        this.SyncState();
    }

    // Startup/business-event synchronization; never called by Paint.
    public void SyncState() {
        this.score.SetProp("text", "SCORE: " + Convert.ToString(this.game.score)
            + " / " + Convert.ToString(this.game.targetScore));
        this.moves.SetProp("text", "MOVES LEFT: " + Convert.ToString(this.game.movesLeft));
        if (!this.game.gameOver && this.result.visible) {
            GuiHost owner = this.host;
            if (owner != null) { owner.App().ReleaseInputSubtree(this.result); }
        }
        this.result.SetShown(this.game.gameOver);
        bool won = this.game.score >= this.game.targetScore;
        this.resultTitle.SetProp("text", won ? "STAGE CLEAR!" : "OUT OF MOVES!");
        this.resultTitle.SetProp("style", won
            ? "left:120dpx;color:#52c41a" : "left:140dpx;color:#ff4d4f");
    }

    public void AttachPreparation(GuiHost owner) {
        if (owner == null) { return; }
        this.host = owner;
        if (this.view != null && this.view.IsActive()) { return; }
        if (this.view != null) { this.view.Retire(); }
        this.view = new UiViewScope(owner.App(), this, this.root);
        this.root.OnPreviewRouted(this.view.Action("pointer", this.root).Pointer);
        this.replay.OnClick(this.view.Action("replay", this.replay).Run);
    }

    public void StopPreparation() {
        UiViewScope previous = this.view; this.view = null; this.host = null;
        if (previous != null) { previous.Retire(); }
    }

    public void PrepareView(UiViewScope view, App app) {
        // The game owns this full-canvas region; the scope owns only its lifetime.
        Control inputRoot = app.rootControl;
        if (inputRoot == null || !inputRoot.ContainsInputControl(this.root)) { return; }
        view.Layout(0, 0, app.canvas.Width(), app.canvas.Height());
    }
    public void Layout(App app) {
        if (this.view != null) { this.PrepareView(this.view, app); }
    }
    public void ViewAction(string name, Control sender) {
        if (name == "replay") { this.Replay(); }
    }
    public void ViewPointer(Control sender, RoutedEventArgs args) {
        if (args.eventName != "PointerDown" && args.eventName != "MouseDown") { return; }
        if (this.PointerDown()) { args.Handle(); }
    }

    // Original palette and overlay positions. State styling remains in CSS.
    public static string Css() {
        return ".match3-hud{position:relative;background:transparent;padding:0;border:0}"
            + "label.match3-title,label.match3-score,label.match3-moves,"
            + "label.match3-result-title{position:absolute;"
            + "padding:0;margin:0;border:0;background:transparent;vertical-align:top}"
            + "label.match3-title{left:40dpx;top:50dpx;width:640dpx;height:40dpx;font-size:28dpx;color:#fff}"
            + "label.match3-score{left:40dpx;top:100dpx;width:356dpx;height:32dpx;font-size:20dpx;color:#ffc53d}"
            + "label.match3-moves{left:400dpx;top:100dpx;width:300dpx;height:32dpx;font-size:20dpx;color:#40a9ff}"
            + ".match3-result{position:absolute;left:100dpx;top:400dpx;width:520dpx;height:160dpx;"
            + "padding:0;border:0;background:rgba(0,0,0,0.8)}"
            + "label.match3-result-title{left:120dpx;top:40dpx;width:380dpx;height:48dpx;"
            + "font-size:32dpx;text-align:left}"
            + "button.match3-replay{position:absolute;left:80dpx;top:100dpx;width:400dpx;height:48dpx;"
            + "padding:0;margin:0;border:0;border-radius:0;background:transparent;color:#fff;font-size:18dpx;text-align:left;justify-content:flex-start}"
            + "button.match3-replay label{padding:0;margin:0;color:#fff;font-size:18dpx;text-align:left;vertical-align:top}"
            + "button.match3-replay:hover{background:rgba(64,169,255,0.12)}"
            + "button.match3-replay:active{background:rgba(64,169,255,0.2)}"
            + "button.match3-replay:focus{border:1dpx solid #40a9ff}"
            + "button.match3-replay:disabled{color:#89a5c4;background:transparent}";
    }
}
