using System;
using Gui;

namespace Match3;

// Canvas art for the shell screens (title, level map, results celebration)
// and the small icons that sit inside HUD pods. Controls themselves are
// standard Gui widgets; this file only paints scenery and pictograms, in
// the HUD's layout space (`top` = title-bar offset).
public class Match3Scenes {
    public const int GoalPodX = 186;
    public const int GoalPodW = 348;
    public const int PodTop = 56;
    public const int ScorePodX = 546;

    // ---- layout shared with Match3Hud ----

    public static int NodeX(int i) {
        int row = i / 4;
        int col = i % 4;
        if (row % 2 == 1) { col = 3 - col; }
        return 150 + col * 140;
    }

    public static int NodeY(int i) { return 172 + (i / 4) * 122; }

    public static int ResultStarX(int k) { return 360 + (k - 1) * 132; }
    public static int ResultStarY(int k) { return k == 1 ? 214 : 238; }

    public static int GoalSlots(Match3Level lv) {
        if (lv.goal == Match3Levels.GoalCollect) { return lv.collectColor.Length; }
        return 1;
    }

    public static int GoalIconX(int n, int i) {
        int slot = GoalPodW / (n < 1 ? 1 : n);
        return GoalPodX + slot * i + slot / 2 - 34;
    }

    public static int[] ConfettiColors() {
        return new int[] {
            Match3Painter.GemColor(1), Match3Painter.GemColor(2), Match3Painter.GemColor(3),
            Match3Painter.GemColor(4), Match3Painter.GemColor(5), unchecked((int)0xFFFFFFFF)
        };
    }

    // ---- scenes (drawn under the Gui tree) ----

    public static void DrawScene(Canvas c, Match3Hud hud, int top) {
        int st = hud.state;
        if (st == Match3Hud.StateTitle) {
            Match3Scenes.Title(c, hud, top);
            return;
        }
        if (st == Match3Hud.StateMap) {
            Match3Scenes.Map(c, hud, top);
            return;
        }
        hud.game.Render(c, top);
        if (st == Match3Hud.StatePaused) {
            c.FillRect(0, 0, c.Width(), c.Height(), unchecked((int)0x99090616));
        }
        if (st == Match3Hud.StateResults) {
            double k = hud.resultT / 0.4;
            if (k > 1.0) { k = 1.0; }
            c.FillRect(0, 0, c.Width(), c.Height(), Match3Painter.Alpha(unchecked((int)0xFF090616), (int)(190.0 * k)));
            Match3Scenes.ResultStars(c, hud, top);
        }
    }

    // Over the Gui tree: pod pictograms and celebration particles.
    public static void DrawOverlay(Canvas c, Match3Hud hud, int top) {
        int st = hud.state;
        if (st == Match3Hud.StatePlaying || st == Match3Hud.StatePaused) {
            Match3Scenes.PodIcons(c, hud, top);
        }
        if (st == Match3Hud.StateMap) {
            Match3Painter.Star(c, 312, top + 75, 15, true);
        }
        Match3Painter.DrawFx(c, hud.uiFx, 0, top);
    }

    static void PodIcons(Canvas c, Match3Hud hud, int top) {
        Match3Game g = hud.game;
        Match3Level lv = g.level;
        int n = GoalSlots(lv);
        int y = top + PodTop + 74;
        for (int i = 0; i < n; i = i + 1) {
            int x = GoalIconX(n, i);
            if (lv.goal == Match3Levels.GoalCollect) {
                Match3Painter.DrawGem(c, lv.collectColor[i], x, y, 19);
            } else if (lv.goal == Match3Levels.GoalJelly) {
                Match3Painter.DrawJellyIcon(c, x, y, 38);
            } else if (lv.goal == Match3Levels.GoalCrates) {
                Match3Painter.DrawCrate(c, x, y, 38, 1, 0.0);
            } else {
                Match3Painter.Star(c, x, y, 20, true);
            }
        }
        // Score meter star marks (2 and 3 stars).
        if (lv.star3 > 0) {
            int bx = ScorePodX + 14;
            int bw = 122;
            int by = top + PodTop + 94;
            for (int k = 0; k < 2; k = k + 1) {
                int thr = k == 0 ? lv.star2 : lv.star3;
                int x = bx + bw * thr / lv.star3;
                if (x > bx + bw - 6) { x = bx + bw - 6; }
                Match3Painter.Star(c, x, by, 9, g.score >= thr);
            }
        }
    }

    // Title: night sky, a bobbing row of gems above the card, specials below.
    static void Title(Canvas c, Match3Hud hud, int top) {
        double t = hud.clock;
        Match3Painter.Backdrop(c, top, t);
        for (int k = 0; k < 6; k = k + 1) {
            int x = 110 + k * 100;
            int y = top + 150 + (int)(Math.Sin(t * 2.2 + (double)k * 0.9) * 12.0);
            Match3Painter.Glow(c, x, y, 54, Match3Painter.Alpha(Match3Painter.GemColor(k + 1), 255), 70);
            Match3Painter.DrawGem(c, k + 1, x, y, 34);
        }
        int[] specials = new int[] {
            Match3Game.Gem(2, Match3Game.SpRow), Match3Game.Bomb, Match3Game.Gem(5, Match3Game.SpArea),
            Match3Game.Gem(3, Match3Game.SpCol)
        };
        for (int k = 0; k < 4; k = k + 1) {
            int x = 180 + k * 120;
            int y = top + 828 + (int)(Math.Sin(t * 1.8 + (double)k * 1.3) * 8.0);
            Match3Painter.DrawPiece(c, specials[k], x, y, 26, t + (double)k);
        }
        // Drifting sparkles.
        for (int k = 0; k < 14; k = k + 1) {
            double ph = t * 0.35 + (double)k * 0.37;
            ph = ph - Math.Floor(ph);
            int x = 40 + (k * 151) % 640;
            int y = top + 900 - (int)(ph * 860.0);
            int a = (int)(200.0 * Math.Sin(ph * 3.14159));
            Match3Painter.Glow(c, x, y, 6, Match3Painter.Alpha(unchecked((int)0xFFFFE58F), 255), a);
        }
    }

    // Level map: winding path between the 24 node buttons, earned-star pips
    // under each node, and a pulsing halo on the next level to play.
    static void Map(Canvas c, Match3Hud hud, int top) {
        double t = hud.clock;
        Match3Painter.Backdrop(c, top, t);
        for (int i = 0; i + 1 < Match3Levels.Count; i = i + 1) {
            int x0 = NodeX(i);
            int y0 = top + NodeY(i);
            int x1 = NodeX(i + 1);
            int y1 = top + NodeY(i + 1);
            bool done = hud.StarsOf(i) > 0;
            int edge = done ? unchecked((int)0xFFB8862B) : unchecked((int)0xFF3A2F62);
            int core = done ? unchecked((int)0xFFFFD666) : unchecked((int)0xFF52458A);
            if (y0 == y1) {
                c.DrawLine(x0, y0, x1, y1, edge, 14);
                c.DrawLine(x0, y0, x1, y1, core, 6);
            } else {
                // Row change: a rounded bend on the outer side of the map.
                int bend = x0 > 360 ? 70 : -70;
                c.DrawLine(x0, y0, x0 + bend, y0 + 20, edge, 14);
                c.DrawLine(x0 + bend, y0 + 20, x0 + bend, y1 - 20, edge, 14);
                c.DrawLine(x0 + bend, y1 - 20, x1, y1, edge, 14);
                c.DrawLine(x0, y0, x0 + bend, y0 + 20, core, 6);
                c.DrawLine(x0 + bend, y0 + 20, x0 + bend, y1 - 20, core, 6);
                c.DrawLine(x0 + bend, y1 - 20, x1, y1, core, 6);
            }
        }
        int cur = hud.CurrentLevel();
        double p = 0.5 + 0.5 * Math.Sin(t * 4.0);
        for (int i = 0; i < Match3Levels.Count; i = i + 1) {
            int x = NodeX(i);
            int y = top + NodeY(i);
            bool open = hud.Unlocked(i);
            c.FillRoundRect(x - 34, y - 30, 72, 72, 22, unchecked((int)0x66000000));
            if (i == cur && open) {
                Match3Painter.Glow(c, x, y, 64 + (int)(p * 10.0), unchecked((int)0xFFFF85C0), 200);
            }
            int stars = hud.StarsOf(i);
            if (open) {
                for (int k = 0; k < 3; k = k + 1) {
                    int sx = x + (k - 1) * 24;
                    int sy = y + 50 - (k == 1 ? 4 : 0);
                    Match3Painter.Star(c, sx, sy, 11, k < stars);
                }
            }
            // Theme pip: the level's goal pictogram on the node's shoulder.
            Match3Level lv = Match3Levels.Get(i);
            int ix = x + 32;
            int iy = y - 30;
            if (!open) { continue; }
            if (lv.goal == Match3Levels.GoalJelly) { Match3Painter.DrawJellyIcon(c, ix, iy, 20); }
            else if (lv.goal == Match3Levels.GoalCrates) { Match3Painter.DrawCrate(c, ix, iy, 20, 1, 0.0); }
            else if (lv.goal == Match3Levels.GoalCollect) { Match3Painter.DrawGem(c, lv.collectColor[0], ix, iy, 10); }
            else { Match3Painter.Star(c, ix, iy, 10, true); }
        }
    }

    // Results: three star sockets above the card; earned stars pop in with an
    // overshoot while golden rays turn behind the middle one.
    static void ResultStars(Canvas c, Match3Hud hud, int top) {
        double t = hud.resultT;
        if (hud.resultStars > 0 && hud.starsShown > 0) {
            int cx = ResultStarX(1);
            int cy = top + ResultStarY(1);
            int a = (int)(90.0 * (t > 1.0 ? 1.0 : t));
            for (int k = 0; k < 12; k = k + 1) {
                int a0 = (int)(t * 25.0) + k * 30;
                c.FillSector(cx, cy, 30, 190, a0, a0 + 12, Match3Painter.Alpha(unchecked((int)0xFFFFE58F), a));
            }
            Match3Painter.Glow(c, cx, cy, 150, unchecked((int)0xFFFFD666), 120);
        }
        for (int k = 0; k < 3; k = k + 1) {
            int x = ResultStarX(k);
            int y = top + ResultStarY(k);
            int r = k == 1 ? 58 : 46;
            Match3Painter.Star(c, x, y, r, false);
            if (k < hud.starsShown) {
                double since = t - (0.55 + 0.45 * (double)k);
                double s = since < 0.12 ? 0.3 + 1.1 * (since / 0.12)
                    : (since < 0.26 ? 1.4 - 0.4 * ((since - 0.12) / 0.14) : 1.0);
                Match3Painter.Star(c, x, y, (int)((double)r * s), true);
            }
        }
    }
}
