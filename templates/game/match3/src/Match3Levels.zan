using System;

namespace Match3;

// One level: move budget, palette size, goal and the starting layout.
// Layout is 64 chars, row by row from the top: '.' plain cell, 'j' jelly,
// 'J' double jelly, 'c' crate (1 hit), 'C' iron crate (2 hits),
// 'x' crate on jelly, 'X' iron crate on jelly.
public class Match3Level {
    public int number;
    public int moves;
    public int colors;
    public int goal;
    public int target;
    public int[] collectColor;
    public int[] collectCount;
    public string layout;
    public int star2;
    public int star3;
    public string tip;

    public Match3Level(int number, int moves, int colors, int goal) {
        this.number = number;
        this.moves = moves;
        this.colors = colors;
        this.goal = goal;
        this.target = 0;
        this.collectColor = new int[0];
        this.collectCount = new int[0];
        this.layout = "";
        this.star2 = 0;
        this.star3 = 0;
        this.tip = "";
    }

    public Match3Level Stars(int two, int three) {
        this.star2 = two;
        this.star3 = three;
        return this;
    }

    public Match3Level Tip(string text) {
        this.tip = text;
        return this;
    }

    public char LayoutAt(int c, int r) {
        int i = r * 8 + c;
        if (this.layout == null || i >= this.layout.Length) { return '.'; }
        return this.layout[i];
    }
}

// The 24-level campaign. The curve: levels 1-6 teach one idea each on a
// 5-colour board (cascades come easily), 7+ switch to 6 colours, tighter
// move budgets and stacked obstacles. Star thresholds were tuned with the
// headless greedy bot (see README "Balancing").
public class Match3Levels {
    public const int Count = 24;
    public const int GoalScore = 0;
    public const int GoalCollect = 1;
    public const int GoalJelly = 2;
    public const int GoalCrates = 3;

    static Match3Level Score(int n, int moves, int colors, int target) {
        Match3Level l = new Match3Level(n, moves, colors, GoalScore);
        l.target = target;
        return l;
    }

    static Match3Level Collect(int n, int moves, int colors, int[] kinds, int[] counts) {
        Match3Level l = new Match3Level(n, moves, colors, GoalCollect);
        l.collectColor = kinds;
        l.collectCount = counts;
        return l;
    }

    static Match3Level Board(int n, int moves, int colors, int goal, string layout) {
        Match3Level l = new Match3Level(n, moves, colors, goal);
        l.layout = layout;
        return l;
    }

    public static Match3Level Get(int index) {
        if (index < 0) { index = 0; }
        if (index >= Count) { index = Count - 1; }
        int n = index + 1;
        if (n == 1) {
            return Score(n, 20, 5, 1200).Stars(3400, 4400)
                .Tip("Swap two neighbouring gems to line up 3 of a kind");
        }
        if (n == 2) {
            return Collect(n, 18, 5, new int[] { 1 }, new int[] { 18 }).Stars(3800, 5400)
                .Tip("Collect the red gems shown in the GOAL box");
        }
        if (n == 3) {
            return Score(n, 18, 5, 2200).Stars(3900, 5200)
                .Tip("Line up 4 to make a STRIPED gem - it clears a whole line");
        }
        if (n == 4) {
            return Board(n, 20, 5, GoalJelly,
                "........" + "........" + "..jjjj.." + "..jjjj.." + "..jjjj.." + "..jjjj.." + "........" + "........")
                .Stars(4600, 6600).Tip("Match gems on the pink jelly tiles to clear them");
        }
        if (n == 5) {
            return Collect(n, 20, 5, new int[] { 2, 3 }, new int[] { 18, 18 }).Stars(4100, 6000)
                .Tip("Make an L or T shape for an AREA BOMB");
        }
        if (n == 6) {
            return Board(n, 20, 5, GoalCrates,
                "........" + "........" + "........" + "........" + "........" + "........" + "cccccccc" + "........")
                .Stars(4800, 6600).Tip("Crates break when you match right next to them");
        }
        if (n == 7) {
            return Score(n, 20, 6, 2400).Stars(3600, 4900)
                .Tip("Six colours now - line up 5 for a COLOUR BOMB");
        }
        if (n == 8) {
            return Board(n, 26, 6, GoalJelly,
                "........" + ".jj..jj." + ".jj..jj." + ".jj..jj." + ".jj..jj." + ".jj..jj." + ".jj..jj." + "........")
                .Stars(3900, 5700);
        }
        if (n == 9) {
            return Collect(n, 20, 6, new int[] { 4 }, new int[] { 20 }).Stars(3100, 4300)
                .Tip("Swap two special gems together for a super combo");
        }
        if (n == 10) {
            return Board(n, 22, 6, GoalCrates,
                "........" + "........" + "........" + "..C..C.." + "........" + ".C.CC.C." + "........" + "........")
                .Stars(3400, 4300).Tip("Iron crates take two hits");
        }
        if (n == 11) {
            return Board(n, 24, 6, GoalJelly,
                "........" + "........" + "..JJJJ.." + "..JJJJ.." + "..JJJJ.." + "..JJJJ.." + "........" + "........")
                .Stars(3800, 5000).Tip("Thick jelly needs two matches");
        }
        if (n == 12) {
            return Score(n, 20, 6, 3000).Stars(3700, 5100);
        }
        if (n == 13) {
            return Collect(n, 20, 6, new int[] { 1, 5 }, new int[] { 18, 18 }).Stars(3100, 4600);
        }
        if (n == 14) {
            return Board(n, 24, 6, GoalCrates,
                "........" + "........" + "........" + "c.c..c.c" + ".c.CC.c." + "c.c..c.c" + "........" + "........")
                .Stars(3900, 5200);
        }
        if (n == 15) {
            return Board(n, 32, 6, GoalJelly,
                "........" + "........" + "........" + "........" + "........" + "jjjjjjjj" + "jjjjjjjj" + "jjjjjjjj")
                .Stars(4600, 7200);
        }
        if (n == 16) {
            return Score(n, 18, 6, 2800).Stars(3400, 4700);
        }
        if (n == 17) {
            return Collect(n, 20, 6, new int[] { 5 }, new int[] { 24 }).Stars(3600, 4900);
        }
        if (n == 18) {
            return Board(n, 30, 6, GoalJelly,
                "........" + "...jj..." + "..jjjj.." + ".jjJJjj." + ".jjJJjj." + "..jjjj.." + "...jj..." + "........")
                .Stars(4500, 6400);
        }
        if (n == 19) {
            return Board(n, 26, 6, GoalCrates,
                "........" + "........" + "C.C..C.C" + ".C.CC.C." + "........" + "c.c..c.c" + ".c.cc.c." + "........")
                .Stars(4600, 6300);
        }
        if (n == 20) {
            return Collect(n, 20, 6, new int[] { 2, 4, 6 }, new int[] { 15, 15, 15 }).Stars(3500, 4600);
        }
        if (n == 21) {
            return Board(n, 34, 6, GoalJelly,
                "........" + "........" + "........" + "jjjjjjjj" + "jjjjjjjj" + "jjjjjjjj" + "jjjjjjjj" + "jjjjjjjj")
                .Stars(5200, 7400);
        }
        if (n == 22) {
            return Score(n, 18, 6, 3200).Stars(3300, 4800);
        }
        if (n == 23) {
            return Board(n, 24, 6, GoalCrates,
                "........" + "........" + "........" + "jxjxjxjx" + "XjXjXjXj" + "jjjjjjjj" + "jjjjjjjj" + "........")
                .Stars(3600, 4600);
        }
        return Board(n, 30, 6, GoalJelly,
            "........" + ".jjjjjj." + ".jJJJJj." + ".jJJJJj." + ".jJJJJj." + ".jJJJJj." + ".jjjjjj." + "........")
            .Stars(4900, 7000);
    }

    public static string ColorName(int color) {
        if (color == 1) { return "red"; }
        if (color == 2) { return "blue"; }
        if (color == 3) { return "green"; }
        if (color == 4) { return "gold"; }
        if (color == 5) { return "purple"; }
        if (color == 6) { return "orange"; }
        return "gem";
    }

    // One-line goal for banners, the pause card and the level map.
    public static string GoalText(Match3Level l) {
        if (l.goal == GoalScore) { return "Score " + Convert.ToString(l.target) + " points"; }
        if (l.goal == GoalJelly) { return "Clear every jelly tile"; }
        if (l.goal == GoalCrates) { return "Break every crate"; }
        string s = "Collect ";
        for (int i = 0; i < l.collectColor.Length; i = i + 1) {
            if (i > 0) { s = s + (i == l.collectColor.Length - 1 ? " and " : ", "); }
            s = s + Convert.ToString(l.collectCount[i]) + " " + Match3Levels.ColorName(l.collectColor[i]);
        }
        return s;
    }
}
