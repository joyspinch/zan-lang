using System;
using System.Collections.Generic;
using Gui;
using Game.Foundation.Gui;
using Game.Match3;
using Game.Kit;
using Game.Foundation;

namespace Match3;

public class Match3Game {
    public const int Cols = 8;
    public const int Rows = 8;
    public const int TileSize = 64;
    public const int BoardStartX = 104;
    public const int BoardStartY = 200;

    public Match3Board board;
    public FloatingTextPool floatingTexts;

    public int score;
    public int movesLeft;
    public int targetScore;
    public bool gameOver;

    // 选中状态
    public int selectedCol;
    public int selectedRow;
    public bool hasSelection;

    // 宝石配色 (AARRGGBB)
    public int[] gemColors;

    // 最近一次点击的结果（仅供界面层播音效/做反馈，不进校验和、不改规则）：
    // 0 无、1 选中、2 有效交换、3 无效交换、4 取消选中
    public const int ActNone = 0;
    public const int ActSelect = 1;
    public const int ActSwap = 2;
    public const int ActInvalid = 3;
    public const int ActDeselect = 4;
    public int lastAction;
    public int lastCleared;
    public int lastCombos;

    // 无效交换的红框闪烁（纯表现，秒）
    public double invalidFlash;
    public int invalidC1;
    public int invalidR1;
    public int invalidC2;
    public int invalidR2;

    // 开盘与补子的唯一随机源：同一种子同一局（回放 replays/ 依赖这一点）
    public DeterministicRandom rng;

    public Match3Game() : this(20260101) { }

    public Match3Game(long seed) {
        this.rng = new DeterministicRandom(seed);
        this.board = new Match3Board(Cols, Rows);
        this.floatingTexts = new FloatingTextPool(32);
        this.score = 0;
        this.movesLeft = 25;
        this.targetScore = 1500;
        this.gameOver = false;
        this.selectedCol = -1;
        this.selectedRow = -1;
        this.hasSelection = false;
        this.lastAction = ActNone;
        this.lastCleared = 0;
        this.lastCombos = 0;
        this.invalidFlash = 0.0;

        this.gemColors = new int[7];
        this.gemColors[0] = unchecked((int)0x00000000); // 0 为空
        this.gemColors[1] = unchecked((int)0xFFFF4D4F); // 红：火宝石
        this.gemColors[2] = unchecked((int)0xFF40A9FF); // 蓝：冰宝石
        this.gemColors[3] = unchecked((int)0xFF73D13D); // 绿：翡翠
        this.gemColors[4] = unchecked((int)0xFFFFC53D); // 黄：金曜石
        this.gemColors[5] = unchecked((int)0xFF9254DE); // 紫：紫水晶
        this.gemColors[6] = unchecked((int)0xFFFF7A45); // 橙：太阳石

        InitBoard();
    }

    public static Match3Game Create() {
        return new Match3Game();
    }

    // 界面开局用时钟当种子（每次一盘新局）；回放走 Match3Game(seed) 固定种子
    public static Match3Game Create(long seed) {
        return new Match3Game(seed);
    }

    // 随机发一盘：逐格取色，避开会和左边两格或上边两格连成三连的颜色（开局没有
    // 现成的消除）；发出来的盘面一步可走都没有就重发——开局必须有棋可下。
    public void Deal() {
        for (int attempt = 0; attempt < 100; attempt = attempt + 1) {
            for (int r = 0; r < Rows; r = r + 1) {
                for (int c = 0; c < Cols; c = c + 1) {
                    int val = 1 + rng.NextBelow(6);
                    for (int guard = 0; guard < 6; guard = guard + 1) {
                        bool row3 = c >= 2 && board.Get(c - 1, r) == val && board.Get(c - 2, r) == val;
                        bool col3 = r >= 2 && board.Get(c, r - 1) == val && board.Get(c, r - 2) == val;
                        if (!row3 && !col3) { break; }
                        val = val % 6 + 1;
                    }
                    board.Set(c, r, val);
                }
            }
            if (HasAnyMove()) { return; }
        }
    }

    // 盘面上是否还有一步能消除的交换
    public bool HasAnyMove() {
        for (int r = 0; r < Rows; r = r + 1) {
            for (int c = 0; c < Cols; c = c + 1) {
                if (c + 1 < Cols && board.CanSwap(c, r, c + 1, r)) { return true; }
                if (r + 1 < Rows && board.CanSwap(c, r, c, r + 1)) { return true; }
            }
        }
        return false;
    }

    public void InitBoard() {
        Deal();
        score = 0;
        movesLeft = 25;
        gameOver = false;
        hasSelection = false;
        invalidFlash = 0.0;
    }

    // 玩家点击坐标处理
    public void OnClick(int px, int py) {
        lastAction = ActNone;
        lastCleared = 0;
        lastCombos = 0;
        if (gameOver) {
            // 点击任意处重新开局
            InitBoard();
            return;
        }

        int relX = px - BoardStartX;
        int relY = py - BoardStartY;
        if (relX < 0 || relY < 0) { return; }

        int col = relX / TileSize;
        int row = relY / TileSize;
        if (col < 0 || col >= Cols || row < 0 || row >= Rows) {
            if (hasSelection) { lastAction = ActDeselect; }
            hasSelection = false;
            return;
        }

        if (!hasSelection) {
            selectedCol = col;
            selectedRow = row;
            hasSelection = true;
            lastAction = ActSelect;
        } else {
            // 判断是否相邻
            int dc = (int)Math.Abs((double)(col - selectedCol));
            int dr = (int)Math.Abs((double)(row - selectedRow));
            if ((dc == 1 && dr == 0) || (dc == 0 && dr == 1)) {
                // 尝试交换
                TrySwap(selectedCol, selectedRow, col, row);
                hasSelection = false;
            } else {
                // 点击了不相邻格子，切换选中
                selectedCol = col;
                selectedRow = row;
                hasSelection = true;
                lastAction = ActSelect;
            }
        }
    }

    private void TrySwap(int c1, int r1, int c2, int r2) {
        if (movesLeft <= 0) { return; }

        bool valid = board.CanSwap(c1, r1, c2, r2);
        if (valid) {
            board.Swap(c1, r1, c2, r2);
            movesLeft = movesLeft - 1;

            // 产生连续掉落结算
            int[] incoming = new int[Cols * Rows];
            for (int i = 0; i < incoming.Length; i = i + 1) {
                incoming[i] = 1 + rng.NextBelow(6);
            }
            int inIdx = 0;
            int totalCleared = 0;
            int combos = 0;
            board.ResolveCascades(incoming, ref inIdx, out totalCleared, out combos);

            lastAction = ActSwap;
            lastCleared = totalCleared;
            lastCombos = combos;
            int earnedScore = totalCleared * 10 * (combos > 0 ? combos : 1);
            score = score + earnedScore;

            double spawnX = (double)(BoardStartX + c2 * TileSize + TileSize / 2);
            double spawnY = (double)(BoardStartY + r2 * TileSize);
            floatingTexts.SpawnDamage(spawnX, spawnY, earnedScore, combos > 1);

            if (score >= targetScore || movesLeft <= 0) {
                gameOver = true;
            } else if (!HasAnyMove()) {
                // 死局：洗牌重发，分数与剩余步数保留
                Deal();
            }
        } else {
            // 换了也连不成三个：规则上不消耗步数，只给反馈
            lastAction = ActInvalid;
            invalidFlash = 0.35;
            invalidC1 = c1;
            invalidR1 = r1;
            invalidC2 = c2;
            invalidR2 = r2;
        }
    }

    public void Update(double dt) {
        floatingTexts.Update(dt);
        if (invalidFlash > 0.0) {
            invalidFlash = invalidFlash - dt;
            if (invalidFlash < 0.0) { invalidFlash = 0.0; }
        }
    }

    public void Render(Canvas c) {
        if (c == null) { return; }

        // 背景：深紫夜空渐变
        c.FillVGrad(0, 0, 720, 960, unchecked((int)0xFF221A3A), unchecked((int)0xFF12101E));

        // 棋盘底座：圆角深槽 + 细描边
        int boardW = Cols * TileSize;
        int boardH = Rows * TileSize;
        c.FillRoundRect(BoardStartX - 10, BoardStartY - 10, boardW + 20, boardH + 20, 18,
            unchecked((int)0xFF0E0C18));
        c.DrawRoundRect(BoardStartX - 10, BoardStartY - 10, boardW + 20, boardH + 20, 18,
            unchecked((int)0xFF4B3D7A), 2);

        // 绘制格子与宝石
        for (int r = 0; r < Rows; r = r + 1) {
            for (int col = 0; col < Cols; col = col + 1) {
                int gx = BoardStartX + col * TileSize;
                int gy = BoardStartY + r * TileSize;

                // 槽位底色（棋盘格）
                int slotColor = ((col + r) % 2 == 0) ? unchecked((int)0xFF231E36) : unchecked((int)0xFF2B2542);
                c.FillRoundRect(gx + 2, gy + 2, TileSize - 4, TileSize - 4, 10, slotColor);

                bool selected = hasSelection && selectedCol == col && selectedRow == r;
                if (selected) {
                    c.FillRoundRect(gx + 2, gy + 2, TileSize - 4, TileSize - 4, 10, unchecked((int)0xFF4A3F72));
                }

                int val = board.Get(col, r);
                if (val >= 1 && val <= 6) {
                    int grow = selected ? 3 : 0;
                    this.DrawGem(c, val, gx + TileSize / 2, gy + TileSize / 2, 23 + grow);
                }

                if (selected) {
                    c.DrawRoundRect(gx + 1, gy + 1, TileSize - 2, TileSize - 2, 11, unchecked((int)0xFFFFFFFF), 3);
                }
            }
        }

        // 无效交换：两格红框闪一下
        if (invalidFlash > 0.0) {
            int red = unchecked((int)0xFFFF4D4F);
            c.DrawRect(BoardStartX + invalidC1 * TileSize + 1, BoardStartY + invalidR1 * TileSize + 1,
                TileSize - 2, TileSize - 2, red, 3);
            c.DrawRect(BoardStartX + invalidC2 * TileSize + 1, BoardStartY + invalidR2 * TileSize + 1,
                TileSize - 2, TileSize - 2, red, 3);
        }

        // 渲染消除飘字
        floatingTexts.Draw(c);

        // Persistent HUD is composed after the unchanged world and floating scores.
    }

    // 宝石：每种颜色一个独立轮廓（色弱玩家靠形状也能分辨），
    // 底影 + 本体 + 内层亮面 + 高光点四层。
    void DrawGem(Canvas c, int kind, int cx, int cy, int r) {
        int body = gemColors[kind];
        int dark = Match3Game.Shade(body, 55);
        int light = Match3Game.Tint(body, 45);
        // 落影
        this.GemShape(c, kind, cx + 2, cy + 3, r, unchecked((int)0x66000000));
        // 描边（暗色本体略大一圈）
        this.GemShape(c, kind, cx, cy, r, dark);
        // 本体
        this.GemShape(c, kind, cx, cy, r - 3, body);
        // 内层亮面（上移一点，模拟顶光）
        this.GemShape(c, kind, cx, cy - r / 6, r * 11 / 20, light);
        // 高光点
        c.FillCircle(cx - r / 3, cy - r / 3, r / 6 + 1, unchecked((int)0xDDFFFFFF));
    }

    // 1 圆 / 2 圆角方 / 3 菱形 / 4 三角 / 5 六边形 / 6 心形
    void GemShape(Canvas c, int kind, int cx, int cy, int r, int color) {
        if (r <= 1) { return; }
        if (kind == 1) { c.FillCircle(cx, cy, r, color); return; }
        if (kind == 2) { c.FillRoundRect(cx - r * 9 / 10, cy - r * 9 / 10, r * 9 / 5, r * 9 / 5, r / 3, color); return; }
        if (kind == 6) {
            int lobe = r * 11 / 20;
            c.FillCircle(cx - lobe * 4 / 5, cy - r / 4, lobe, color);
            c.FillCircle(cx + lobe * 4 / 5, cy - r / 4, lobe, color);
            Match3Game.Scan(c, 3, cx, cy + r / 8, r * 17 / 20, color);
            return;
        }
        if (kind == 4) { Match3Game.Scan(c, 4, cx, cy + r / 8, r * 23 / 20, color); return; }
        Match3Game.Scan(c, kind, cx, cy, r, color);
    }

    // 扫描线填充：逐 2px 行按半宽画矩形（Canvas 无多边形填充）。
    static void Scan(Canvas c, int kind, int cx, int cy, int r, int color) {
        for (int dy = -r; dy < r; dy = dy + 2) {
            int y = dy + 1;
            int ay = y < 0 ? -y : y;
            int half = 0;
            if (kind == 3) {                       // 菱形 / 心形下尖
                half = r - ay;
            } else if (kind == 4) {                // 正三角（尖朝上）
                half = (dy + r) * 3 / 5;
            } else {                               // 六边形（平顶）
                int edge = r * 86 / 100;
                if (ay > edge) { continue; }
                half = r - (ay * 58 / 100);
            }
            if (half > 0) { c.FillRect(cx - half, cy + dy, half * 2, 2, color); }
        }
    }

    static int Shade(int argb, int pct) {
        int a = (argb >> 24) & 255;
        int rr = ((argb >> 16) & 255) * (100 - pct) / 100;
        int gg = ((argb >> 8) & 255) * (100 - pct) / 100;
        int bb = (argb & 255) * (100 - pct) / 100;
        return (a << 24) | (rr << 16) | (gg << 8) | bb;
    }

    static int Tint(int argb, int pct) {
        int a = (argb >> 24) & 255;
        int rr = (argb >> 16) & 255; rr = rr + (255 - rr) * pct / 100;
        int gg = (argb >> 8) & 255; gg = gg + (255 - gg) * pct / 100;
        int bb = argb & 255; bb = bb + (255 - bb) * pct / 100;
        return (a << 24) | (rr << 16) | (gg << 8) | bb;
    }
}
