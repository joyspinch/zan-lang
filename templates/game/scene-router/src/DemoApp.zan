using System;
using Gui;
using Gui.Widget;
using Game.Kit;
using Game.Foundation.Gui;

public class DemoApp {
    static void Main() {
        DemoState st = new DemoState();
        SceneRouter router = SceneRouter.Create("HTML 场景路由演示", 1280, 720);
        router.Register("menu", new MenuScene(st));
        router.Register("play", new PlayScene(st));
        router.Register("over", new OverScene(st));
        router.Run("menu");
    }
}
