using System;
using Gui;
using Gui.Widget;
using Game.Kit;
using Game.Foundation.Gui;

public class PlayScene : HtmlScene {
    DemoState st;
    Button pauseBtn;
    double bx;
    double by;
    double vx;
    double vy;
    double paddleX;

    PlayScene(DemoState st) { this.st = st; }

    override string HtmlFile() { return "assets/scenes/play_hud.html"; }

    override void OnWire(HtmlHandlers handlers) {
        handlers.Add("pause", () => this.TogglePause());
        handlers.Add("menu", () => this.router.Go("menu"));
        handlers.Add("quit", () => this.router.Exit());
    }

    override void OnEnter(Control root) {
        int sw = this.router.Host().StageWidth();
        int sh = this.router.Host().StageHeight();
        if (sw <= 0) { sw = 1280; sh = 720; }
        this.bx = sw / 2;
        this.by = sh * 0.3;
        this.vx = 260;
        this.vy = 300;
        this.paddleX = sw / 2;
        this.st.score = 0;
        this.st.paused = false;
        // HUD 按钮要在每次进场抓一次：上一场的树已随 HTML 卸载释放。
        this.pauseBtn = null;
        if (root != null) {
            Control pc = root.Find("pause");
            if (pc != null && pc is Button) { this.pauseBtn = (Button)pc; }
            if (this.pauseBtn != null) { this.pauseBtn.Text = "暂停"; }
        }
    }

    void TogglePause() {
        this.st.paused = !this.st.paused;
        if (this.pauseBtn != null) {
            this.pauseBtn.Text = this.st.paused ? "继续" : "暂停";
        }
    }

    override void Event(int kind, int key) {
        if (kind == 4 && key == 27) { this.router.Go("menu"); }
    }

    override void Update(int dtMs) {
        if (this.st.paused) { return; }
        GuiHost host = this.router.Host();
        int sw = host.StageWidth();
        int sh = host.StageHeight();
        if (sw <= 0) { return; }  // 首帧 Update 早于舞台映射建立
        double dt = dtMs / 1000.0;
        this.paddleX = host.MouseX();
        this.bx = this.bx + this.vx * dt;
        this.by = this.by + this.vy * dt;
        int r = 10;
        if (this.bx < r) { this.bx = r; this.vx = 0 - this.vx; }
        if (this.bx > sw - r) { this.bx = sw - r; this.vx = 0 - this.vx; }
        if (this.by < r) { this.by = r; this.vy = 0 - this.vy; }
        // 挡板碰撞：接住 +1 分，越接越快
        double padTop = sh - 44;
        if (this.vy > 0 && this.by + r >= padTop && this.by + r < padTop + 26
            && this.bx > this.paddleX - 70 && this.bx < this.paddleX + 70) {
            this.by = padTop - r;
            this.vy = 0 - this.vy * 1.04;
            this.vx = this.vx + (this.bx - this.paddleX) * 2.0;
            if (this.vx > 420) { this.vx = 420; }
            if (this.vx < 0 - 420) { this.vx = 0 - 420; }
            this.st.score = this.st.score + 1;
        }
        // 掉底 → 切结算场景（Go 入队，帧首生效）
        if (this.by > sh + 30) { this.router.Go("over"); }
    }

    override void Render(Canvas c, double alpha) {
        GuiHost host = this.router.Host();
        int sw = host.StageWidth();
        int sh = host.StageHeight();
        if (sw <= 0) { return; }
        // 挡板
        CDraw.FillRect(c, (int)this.paddleX - 70, sh - 44, 140, 14,
                       CDraw.Argb(255, 126, 231, 135));
        // 球
        CDraw.FillCircle(c, (int)this.bx, (int)this.by, 10, 255, 209, 102, 255);
        // 分数画在 HUD 工具栏中段（左按钮区与右按钮区之间）
        CText.DrawCenteredShadow(c, "得分 " + Convert.ToString(this.st.score),
                                 sw / 2, 14, 3, 255, 255, 255, 255);
    }
}

// 结算：整屏 HTML，得分经 Element.SetText 回填到 id="score" 节点。
