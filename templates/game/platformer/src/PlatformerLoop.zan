using System;
using System.Collections.Generic;
using Gui;
using Game.Kit;
using Game.Foundation.Gui;

public class PlatformerLoop : IGuiHostLoop {
    PlatformerGame g;

    public void Start(GuiHost host) {
        this.g = PlatformerGame.Create(host);
    }

    public void Event(GuiHost host, int kind, int code) {
        if (kind == 4) {  // KeyDown
            if (code == 27) {  // ESC
                host.App().isRunning = false;
            } else {
                this.g.OnKeyDown(code);
            }
        } else if (kind == 5) {  // KeyUp
            this.g.OnKeyUp(code);
        }
    }

    public void FixedUpdate(GuiHost host, int dt) {
        this.g.Tick((double)dt / 1000.0);
    }

    public void Update(GuiHost host, int dt) { }

    public void Render(GuiHost host, Canvas c, double alpha) {
        this.g.c = c;
        this.g.SyncStage(host);
        CDraw.Origin(0, host.ContentTop());
        this.g.Render();
    }

    public void Stop(GuiHost host) { }
}
