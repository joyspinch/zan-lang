using System;
using System.Collections.Generic;
using Gui;
using Game.Kit;
using Game.Foundation.Gui;

public class Platform {
    public double x;
    public double y;
    public double w;
    public double h;

    public Platform(double x, double y, double w, double h) {
        this.x = x;
        this.y = y;
        this.w = w;
        this.h = h;
    }
}
