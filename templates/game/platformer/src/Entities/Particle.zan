using System;
using System.Collections.Generic;
using Gui;
using Game.Kit;
using Game.Foundation.Gui;

public class Particle {
    public double x;
    public double y;
    public double vx;
    public double vy;
    public double life;
    public double maxLife;
    public bool active;

    public void Reset(double px, double py, double pvx, double pvy, double duration) {
        this.x = px;
        this.y = py;
        this.vx = pvx;
        this.vy = pvy;
        this.life = duration;
        this.maxLife = duration;
        this.active = true;
    }
}
