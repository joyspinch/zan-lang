using System;
using System.Collections.Generic;
using System.IO;
using Gui;
using Gui.Widget;
using Game.Tactics;
using Game.Core;
using Game.Kit;

public class Program {
    Form form;
    App app;
    BattlefieldView view;

    // 美术素材：盘上找不到就退回矢量绘制（assets/ 会被 zanc 自动内嵌进 exe）
    string bgPath;
    string infantryPath;
    string tankPath;
    string minerPath;

    // 战场仿真（无界面，RtsBattle）：界面只读它、把指令转给它
    RtsBattle battle;

    // 鼠标框选交互
    bool isDragging = false;
    double dragStartX = 0.0;
    double dragStartY = 0.0;
    double dragCurX = 0.0;
    double dragCurY = 0.0;


    static void Main() {
        Program p = new Program();
        p.Run();
    }

    void Run() {
        form = Form.CreateDark("{{NAME}} · 即时战略引擎", 1024, 700);
        app = form.GetApp();
        app.UseSkin("graphite");

        // 素材：assets/ 会被 zanc 自动内嵌进 exe，运行时盘上优先
        this.bgPath = Program.FindAsset("assets/bg_field.jpg");
        this.infantryPath = Program.FindAsset("assets/unit_infantry.png");
        this.tankPath = Program.FindAsset("assets/unit_tank.png");
        this.minerPath = Program.FindAsset("assets/unit_miner.png");
        Canvas.SetBackend(1);  // GL 硬件加速后端

        // 流场 + RVO 避障器、峡谷地形与初始军团都在 RtsBattle 里
        battle = new RtsBattle();

        BuildUi();

        // 核心游戏逻辑帧驱动（50ms / 20Hz 定步循环）
        form.Every(50, () => {
            battle.TickSimulation(0.05);
            app.RequestRedraw();
        });

        form.Run();
    }

    void BuildUi() {
        Panel root = Panel.Column();
        root.Pad(8);
        root.Gap(8);
        form.Add(root);

        // 1. 顶部战况与资源面板
        Panel topBar = Panel.Row();
        topBar.Class = "card";
        topBar.Pad(8);
        topBar.Gap(20);
        topBar.Prefer(0, 48);
        root.With(topBar);

        Label lblTitle = new Label("⚔ 指挥官控制台");
        lblTitle.Class = "title medium strong yellow";
        topBar.With(lblTitle);

        Label lblMin = new Label("💎 晶矿: " + Convert.ToString(battle.minerals));
        lblMin.Class = "medium cyan";
        topBar.With(lblMin);

        Label lblPow = new Label("⚡ 电力: " + Convert.ToString(battle.power) + "MW");
        lblPow.Class = "medium green";
        topBar.With(lblPow);

        Label lblPop = new Label("👥 人口: " + Convert.ToString(battle.supplyUsed) + "/" + Convert.ToString(battle.supplyMax));
        lblPop.Class = "medium";
        topBar.With(lblPop);

        Button btnReinforce = new Button("➕ 征召装甲营 (+10)");
        btnReinforce.Class = "primary";
        btnReinforce.OnClick(() => {
            battle.SpawnReinforcements();
        });
        topBar.With(btnReinforce);

        // 2. 中央战场视口
        view = new BattlefieldView(this);
        view.Grow();
        view.OnClick(() => {
            // 右键或左键下达行军目标
            battle.CommandMove(app.mouseX - view.bx, app.mouseY - view.by);
        });
        root.With(view);

        // 3. 底部操作提示
        Label hint = new Label("【操作指令】点击战场下达行军集结令 | 宏观流场寻路(FlowField) + 万人微观互斥避障(RVO2) 实时推挤通过狭窄峡谷");
        hint.Class = "secondary small";
        root.With(hint);
    }

    // 素材定位：盘上找不到就返回 null（调用方走矢量兜底）。
    static string FindAsset(string rel) {
        string p = Assets.Find(rel);
        if (p == null || !File.Exists(p)) { return null; }
        return p;
    }

    // 单位类型 → 精灵图（没有素材返回 null）。
    string SpriteOf(int type) {
        if (type == 1) { return this.tankPath; }
        if (type == 2) { return this.minerPath; }
        return this.infantryPath;
    }

    void RenderBattlefield(Canvas c, int bx, int by, int bw, int bh) {
        // 1. 地面：优先贴美术底图，没有素材才退回纯色
        if (this.bgPath != null) {
            CDraw.BlitImage(c, this.bgPath, bx, by, bw, bh);
        } else {
            c.FillRect(bx, by, bw, bh, 0xFF141E28);
        }

        // 2. 绘制网格背景
        int cols = bw / battle.cellSize;
        int rows = bh / battle.cellSize;
        for (int col = 0; col <= cols; col = col + 1) {
            c.FillRect(bx + col * battle.cellSize, by, 1, bh, 0x11334E68);
        }
        for (int row = 0; row <= rows; row = row + 1) {
            c.FillRect(bx, by + row * battle.cellSize, bw, 1, 0x11334E68);
        }

        // 3. 绘制中央不可通行悬崖峡谷障碍
        // 压在美术底图上时用半透明暗色 + 描边，读作"裂谷"而不是灰贴片
        int midCol = cols / 2;
        int canyonX = bx + midCol * battle.cellSize;
        for (int r = 0; r < rows; r = r + 1) {
            if (r < 7 || r > 12) {
                c.FillRect(canyonX, by + r * battle.cellSize, battle.cellSize * 2, battle.cellSize, 0xD90A1220);
                c.DrawRect(canyonX, by + r * battle.cellSize, battle.cellSize * 2, battle.cellSize, 0xFF4B5563, 1);
            }
        }

        // 4. 绘制目标集结点与光标脉冲
        if (battle.hasTarget) {
            int tx = bx + (int)battle.targetX;
            int ty = by + (int)battle.targetY;
            c.DrawCircle(tx, ty, 20, 0xAA10B981, 2);
            c.DrawCircle(tx, ty, 8, 0xFF10B981, 2);
        }

        // 5. 绘制所有作战单位
        for (int i = 0; i < battle.units.Count; i = i + 1) {
            RtsUnit u = battle.units[i];
            int ux = bx + (int)u.X;
            int uy = by + (int)u.Y;
            int r = (int)u.Radius;

            // 选中光圈
            if (u.Selected) {
                c.DrawCircle(ux, uy, r + 4, 0xAA22C55E, 1);
            }

            // 阵营环：贴图本身没有配色，敌我用环区分
            int teamColor = u.Team == 0 ? 0xAA60A5FA : 0xAAF87171;
            c.DrawCircle(ux, uy, r + 1, teamColor, 1);

            // 单位本体：优先画精灵图
            string sprite = this.SpriteOf(u.Type);
            if (sprite != null) {
                // 精灵按单位直径画：再放大就会在编队里互相压叠
                int size = r * 2;
                CDraw.BlitImage(c, sprite, ux - size / 2, uy - size / 2, size, size);
            } else if (u.Type == 1) {
                // 坦克：矩形底盘 + 炮塔
                c.FillRect(ux - r, uy - r, r * 2, r * 2, 0xFF1E3A8A);
                c.DrawRect(ux - r, uy - r, r * 2, r * 2, 0xFF3B82F6, 2);
                c.FillCircle(ux, uy, r / 2, 0xFF60A5FA);
            } else {
                // 步兵：圆形小兵
                c.FillCircle(ux, uy, r, 0xFF2563EB);
                c.DrawCircle(ux, uy, r, 0xFF93C5FD, 1);
            }

            // 血条 (微型)
            int barW = r * 2;
            c.FillRect(ux - r, uy - r - 6, barW, 3, 0xFF450A0A);
            c.FillRect(ux - r, uy - r - 6, (int)((double)barW * ((double)u.Hp / (double)u.MaxHp)), 3, 0xFF22C55E);
        }

        // 6. 右下角雷达小地图（Minimap）
        RenderMinimap(c, bx + bw - 160, by + bh - 120, 150, 110);
    }

    void RenderMinimap(Canvas c, int mx, int my, int mw, int mh) {
        c.FillRect(mx, my, mw, mh, 0xEE0B0F19);
        c.DrawRect(mx, my, mw, mh, 0xFF374151, 2);

        // 小地图中央峡谷
        c.FillRect(mx + mw / 2 - 2, my, 4, mh, 0x884B5563);
        // 小地图通道亮色
        c.FillRect(mx + mw / 2 - 2, my + (int)((double)mh * 0.4), 4, (int)((double)mh * 0.25), 0x00000000);

        // 投影单位光点
        for (int i = 0; i < battle.units.Count; i = i + 1) {
            RtsUnit u = battle.units[i];
            int px = mx + (int)((u.X / (double)battle.worldWidth) * (double)mw);
            int py = my + (int)((u.Y / (double)battle.worldHeight) * (double)mh);
            c.FillRect(px, py, 2, 2, 0xFF3B82F6);
        }
    }
}
