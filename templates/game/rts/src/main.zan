using System;
using System.Collections.Generic;
using System.IO;
using Gui;
using Gui.Backend;
using Gui.Widget;
using Game.Tactics;
using Game.Core;
using Game.Kit;
using Game.Foundation;
using Game.Audio;

// {{NAME}}：裂谷战役。入口 + 帧循环 + 对局流程（作战地图 → 交战 ⇄ 暂停 → 战报）+ 输入 + 档案。
// 界面搭建与 HUD 同步在 ProgramUi.zan（同一个 partial class），战场美术在 Views/。
public partial class Program {
    Form form;
    App app;
    BattlefieldView view;
    MinimapView minimap;

    string bgPath;
    string infantryPath;
    string tankPath;
    string minerPath;

    // 战场仿真（无界面，RtsBattle）：界面只读它、把指令转给它
    RtsBattle battle;
    BattleFx fx = new BattleFx();
    SpriteBank sprites = new SpriteBank();
    BattleRenderer renderer = new BattleRenderer();

    // 流程：作战地图（选关 + 难度）→ 交战 ⇄ 暂停 → 战报。仿真 50ms 定步，界面按显示帧
    // 插值渲染；暂停不走表，时限按仿真帧计。
    const int StateMenu = 0;
    const int StatePlaying = 1;
    const int StatePaused = 2;
    const int StateResults = 3;
    const int TickMs = 50;
    int state = 0;
    int missionIndex = 0;
    int difficulty = 1;
    bool lastWindowFocused = false;
    int lastMs = 0;
    int accMs = 0;
    double alpha = 0.0;

    // 镜头（世界坐标左上角）与方向键平移
    double camX = 0.0;
    double camY = 0.0;
    bool panLeft = false;
    bool panRight = false;
    bool panUp = false;
    bool panDown = false;

    // 警报：小地图红环（x, y, 剩余寿命 三元组）+ 顶栏提示
    List<double> alerts = new List<double>();
    string alertText = "";
    bool alertRed = false;
    double alertLeft = 0.0;
    int lastHqAlertTick = -1000;
    int lastUnitAlertTick = -1000;

    // 档案（每关每难度最佳星数与最快胜利、通关解锁、局数、静音、上次难度）与音效：界面层
    GameProfile profile;
    AudioBus bus;
    SfxBank sfx;
    bool muted = false;

    // 调试（默认关闭）：RTS_DEBUG_AUTOPLAY=1 由教练机器人代打；RTS_DEBUG_SKIP=秒 开局快进；
    // RTS_DEBUG_UNLOCK=1 解锁全部关卡；RTS_DEBUG_MISSION=1..3 / RTS_DEBUG_DIFF=0..2 预选。
    bool debugAutoplay = false;
    int debugSkipTicks = 0;
    bool debugUnlock = false;

    static void Main() {
        Program p = new Program();
        p.Run();
    }

    void Run() {
        form = Form.CreateDark("{{NAME}} · 裂谷战役", 1280, 800);
        app = form.GetApp();
        // 游戏自己的战术皮肤（不叠桌面皮肤）：未声明的部分落回 Gui 内嵌的 base.css。
        app.UseCss(RtsSkin.Css());
        UiDriver.Enable(app);

        // 素材：assets/ 会被 zanc 自动内嵌进 exe，运行时盘上优先
        this.bgPath = Program.FindAsset("assets/bg_field.jpg");
        this.infantryPath = Program.FindAsset("assets/unit_infantry.png");
        this.tankPath = Program.FindAsset("assets/unit_tank.png");
        this.minerPath = Program.FindAsset("assets/unit_miner.png");
        Canvas.SetBackend(1);  // GL 硬件加速后端
        sprites.Build(this.infantryPath, this.tankPath, this.minerPath);
        renderer.sprites = sprites;
        renderer.fx = fx;
        renderer.bgPath = this.bgPath;

        debugAutoplay = Environment.GetEnvironmentVariable("RTS_DEBUG_AUTOPLAY") == "1";
        debugUnlock = Environment.GetEnvironmentVariable("RTS_DEBUG_UNLOCK") == "1";
        debugSkipTicks = Program.EnvInt("RTS_DEBUG_SKIP", 0) * 20;

        // 档案落在用户应用数据目录（ZAN_GAME_DATA_DIR 可改），从不写工作目录
        profile = GameProfile.Open("rts");
        muted = profile.Flag("muted", false);
        difficulty = (int)profile.Counter("difficulty");
        if (difficulty < 0 || difficulty > 2) { difficulty = 1; }
        missionIndex = this.HighestUnlocked();
        int dm = Program.EnvInt("RTS_DEBUG_MISSION", 0);
        if (dm >= 1 && dm <= RtsMission.Count) { missionIndex = dm - 1; }
        int dd = Program.EnvInt("RTS_DEBUG_DIFF", -1);
        if (dd >= 0 && dd <= 2) { difficulty = dd; }

        bus = new AudioBus();
        bus.SetSfxMuted(muted);
        sfx = new SfxBank(bus);
        sfx.AddPresets(new string[] { "click", "select", "hit", "explode", "success", "fail", "error", "coin", "powerup" });
        this.TuneSfx();
        sfx.Warm();

        battle = new RtsBattle(missionIndex, difficulty, 1);
        renderer.battle = battle;

        BuildUi();
        this.CenterOn(battle.teams[0].hq.X + 260.0, battle.teams[0].hq.Y);
        ShowMenu();

        lastMs = Window.GetTickMs();
        form.Every(15, () => { Frame(); });
        form.Run();
    }

    // 本作音色：枪声短促、炮声低闷、警报上扬方波、出厂提示上扬三角波。
    void TuneSfx() {
        SynthOptions shot = SfxPresets.Hit().WithDuration(0.05).WithEnvelope(0.001, 0.040, 0.0, 0.030);
        shot.filter = new BiquadFilter(FilterKind.LowPass, 1800.0, 0.8, 44100, 1);
        sfx.AddSynth("hit", shot);
        SynthOptions cannon = SfxPresets.Explode().WithDuration(0.09).WithEnvelope(0.001, 0.090, 0.1, 0.120).WithGain(0.30);
        cannon.filter = new BiquadFilter(FilterKind.LowPass, 600.0, 0.9, 44100, 1);
        sfx.AddSynth("cannon", cannon);
        sfx.AddSynth("alarm", SfxPresets.PowerUp().WithWaveform(Waveform.Square).WithSweep(520.0, 880.0)
            .WithDuration(0.32).WithGain(0.12));
        sfx.AddSynth("ready", SfxPresets.Success().WithSweep(660.0, 990.0).WithDuration(0.12).WithGain(0.16));
        sfx.AddSynth("capture", SfxPresets.Success().WithSweep(392.0, 1175.0).WithDuration(0.45).WithGain(0.26));
        sfx.AddSynth("lost", SfxPresets.Fail().WithSweep(440.0, 180.0).WithDuration(0.35));
        sfx.AddSynth("coin", SfxPresets.Coin().WithGain(0.07));
    }

    static int EnvInt(string name, int fallback) {
        string v = Environment.GetEnvironmentVariable(name);
        if (v == null || v == "") { return fallback; }
        int n = 0;
        for (int i = 0; i < v.Length; i = i + 1) {
            int ch = (int)v[i];
            if (ch < 48 || ch > 57) { return fallback; }
            n = n * 10 + (ch - 48);
        }
        return n;
    }

    // ---- 帧 ----

    void Frame() {
        int now = Window.GetTickMs();
        int dtMs = now - lastMs;
        lastMs = now;
        if (dtMs < 0) { dtMs = 0; }
        if (dtMs > 100) { dtMs = 100; }
        double dt = (double)dtMs / 1000.0;
        renderer.time = renderer.time + dt;

        // 失焦自动暂停：只在"有焦点 → 失焦"的边沿触发。自动化脚本会话不跟随桌面焦点。
        bool focused = app.window.IsVisible() && app.window.IsFocused();
        bool scripted = UiDriver.Active();
        if (state == StatePlaying && lastWindowFocused && !focused && !scripted) { Pause(); }
        lastWindowFocused = focused;
        EnsureCardShown();
        if (app.focus.focusedId < 0) {
            if (shownCard != null) { shownCard.Focus(app); } else { view.Focus(app); }
        }

        if (state == StatePlaying) {
            accMs = accMs + dtMs;
            int steps = 0;
            bool ticked = false;
            while (accMs >= TickMs && steps < 4 && state == StatePlaying) {
                this.SimStep();
                accMs = accMs - TickMs;
                steps = steps + 1;
                ticked = true;
            }
            if (steps >= 4) { accMs = 0; }
            alpha = (double)accMs / (double)TickMs;
            fx.Update(dt);
            this.TickAlerts(dt);
            this.PanCamera(dt);
            if (ticked) { SyncHud(); }
        }
        Probe(focused);
        app.RequestRedraw();
    }

    void SimStep() {
        if (debugAutoplay) { RtsSim.Apply(battle, RtsSim.Coach(battle, battle.ticks)); }
        battle.TickSimulation((double)TickMs / 1000.0);
        ConsumeBattleEvents();
        if (battle.Outcome() != 0) { Finish(battle.Outcome() == 1); }
    }

    // 自动化探针（只在 ZAN_UI_SCRIPT 会话里生效）：脚本据此断言流程状态。
    void Probe(bool focused) {
        if (!UiDriver.Active()) { return; }
        UiDriver.SetProbe("rts.state", Convert.ToString(state));
        UiDriver.SetProbe("rts.ticks", Convert.ToString(battle.ticks));
        UiDriver.SetProbe("rts.focused", focused ? "1" : "0");
        UiDriver.SetProbe("rts.selected", Convert.ToString(battle.SelectedCount()));
        UiDriver.SetProbe("rts.blue", Convert.ToString(battle.Alive(0)));
        UiDriver.SetProbe("rts.red", Convert.ToString(battle.Alive(1)));
        UiDriver.SetProbe("rts.muted", muted ? "1" : "0");
        UiDriver.SetProbe("rts.mission", Convert.ToString(missionIndex + 1));
        UiDriver.SetProbe("rts.difficulty", Convert.ToString(difficulty));
        UiDriver.SetProbe("rts.minerals", Convert.ToString(battle.teams[0].minerals));
        UiDriver.SetProbe("rts.queue", Convert.ToString(battle.teams[0].queue.Count));
        UiDriver.SetProbe("rts.uplink", Convert.ToString(battle.uplinkOwner));
    }

    void ConsumeBattleEvents() {
        bool cannon = false;
        for (int i = 0; i < battle.shots.Count; i = i + 1) {
            RtsShot s = battle.shots[i];
            fx.AddShot(s);
            if (s.type == RtsUnit.Tank || s.type == RtsUnit.Artillery || s.type == RtsUnit.Hq) { cannon = true; }
        }
        // 开火声轻且限频：一帧几十发也只响一下
        if (battle.shots.Count > 0) { sfx.Play("hit", 0.16, 110); }
        if (cannon) { sfx.Play("cannon", 0.35, 160); }
        for (int i = 0; i < battle.fallen.Count; i = i + 1) {
            RtsUnit u = battle.fallen[i];
            fx.AddBlast(u);
            if (u.Team == 0 && battle.ticks - lastUnitAlertTick > 60) {
                lastUnitAlertTick = battle.ticks;
                this.AddAlert(u.X, u.Y);
            }
        }
        if (battle.fallen.Count > 0) { sfx.Play("explode", 0.45, 90); }
        for (int i = 0; i < battle.deposits.Count; i = i + 1) {
            RtsDeposit d = battle.deposits[i];
            if (d.team != 0) { continue; }
            fx.AddFloat(d.x, d.y - 14.0, "+" + Convert.ToString(d.amount), 0xFF7FE6FF);
            sfx.Play("coin", 0.5, 300);
        }
        for (int i = 0; i < battle.spawned.Count; i = i + 1) {
            RtsUnit u = battle.spawned[i];
            fx.AddWarp(u.X, u.Y, u.Team);
            if (u.Team == 0) { sfx.Play("ready", 0.5, 120); }
        }
        RtsUnit hq = battle.teams[0].hq;
        if (hq.HitTick == battle.ticks && battle.ticks - lastHqAlertTick > 100) {
            lastHqAlertTick = battle.ticks;
            this.AddAlert(hq.X, hq.Y);
            this.ShowAlert("⚠ 指挥中心遭到攻击！", true);
            sfx.Play("alarm", 0.6, 1000);
        }
        if (battle.captureEvent != -2) {
            int owner = battle.captureEvent;
            fx.AddPulse(battle.uplinkX, battle.uplinkY, RtsBattle.UplinkRadius, owner < 0 ? 0xFFCFE4F1 : BattleRenderer.TeamColor(owner));
            if (owner == 0) {
                this.ShowAlert("✔ 上行链路已占领：每秒 +" + Convert.ToString(RtsBattle.UplinkIncomePerSec) + " 晶矿", false);
                sfx.Play("capture", 0.7);
            } else if (owner == 1) {
                this.ShowAlert("✖ 上行链路被红军夺取", true);
                sfx.Play("lost", 0.6);
            }
        }
        if (battle.waveEvent > 0) {
            this.ShowAlert("⚠ 红军第 " + Convert.ToString(battle.waveEvent) + " 波攻势出动", true);
            sfx.Play("alarm", 0.7);
        }
    }

    void AddAlert(double x, double y) {
        alerts.Add(x);
        alerts.Add(y);
        alerts.Add(1.0);
    }

    void ShowAlert(string text, bool red) {
        alertText = text;
        alertRed = red;
        alertLeft = 4.0;
    }

    void TickAlerts(double dt) {
        for (int i = alerts.Count - 3; i >= 0; i = i - 3) {
            alerts[i + 2] = alerts[i + 2] - dt / 2.5;
            if (alerts[i + 2] <= 0.0) {
                alerts.RemoveAt(i + 2);
                alerts.RemoveAt(i + 1);
                alerts.RemoveAt(i);
            }
        }
        if (alertLeft > 0.0) { alertLeft = alertLeft - dt; }
    }

    // ---- 镜头 ----

    void ClampCamera() {
        int vw = view != null ? view.ViewW() : 1200;
        int vh = view != null ? view.ViewH() : 560;
        double maxX = (double)(battle.worldWidth - vw);
        double maxY = (double)(battle.worldHeight - vh);
        camX = maxX <= 0.0 ? maxX / 2.0 : Math.Max(0.0, Math.Min(camX, maxX));
        camY = maxY <= 0.0 ? maxY / 2.0 : Math.Max(0.0, Math.Min(camY, maxY));
    }

    void CenterOn(double x, double y) {
        int vw = view != null && view.ViewW() > 0 ? view.ViewW() : 1262;
        int vh = view != null && view.ViewH() > 0 ? view.ViewH() : 540;
        camX = x - (double)vw / 2.0;
        camY = y - (double)vh / 2.0;
        ClampCamera();
    }

    void PanCamera(double dt) {
        double dx = 0.0;
        double dy = 0.0;
        if (panLeft) { dx = dx - 1.0; }
        if (panRight) { dx = dx + 1.0; }
        if (panUp) { dy = dy - 1.0; }
        if (panDown) { dy = dy + 1.0; }
        dx = dx + (double)view.EdgeX();
        dy = dy + (double)view.EdgeY();
        camX = camX + Math.Max(-1.0, Math.Min(1.0, dx)) * 760.0 * dt;
        camY = camY + Math.Max(-1.0, Math.Min(1.0, dy)) * 760.0 * dt;
        ClampCamera();
    }

    public void MinimapJump(int x, int y, int w, int h) {
        if (w <= 0 || h <= 0) { return; }
        CenterOn((double)x * (double)battle.worldWidth / (double)w, (double)y * (double)battle.worldHeight / (double)h);
    }

    public void MinimapOrder(int x, int y, int w, int h, bool attack) {
        if (w <= 0 || h <= 0) { return; }
        this.OrderWorld((double)x * (double)battle.worldWidth / (double)w, (double)y * (double)battle.worldHeight / (double)h, attack);
    }

    // ---- 流程 ----

    void ShowMenu() {
        state = StateMenu;
        RefreshMenu();
        ShowCard(cardMenu);
        SyncHud();
    }

    void StartBattle() {
        if (!this.Unlocked(missionIndex)) { return; }
        battle = new RtsBattle(missionIndex, difficulty, 20261125 + (long)missionIndex * 7 + (long)difficulty);
        renderer.battle = battle;
        fx.Clear();
        alerts.Clear();
        alertLeft = 0.0;
        lastHqAlertTick = -1000;
        lastUnitAlertTick = -1000;
        view.CancelDrag();
        accMs = 0;
        alpha = 0.0;
        state = StatePlaying;
        profile.Add("plays", 1);
        profile.Add("difficulty", (long)difficulty - profile.Counter("difficulty"));
        profile.Save();
        // 调试快进：不出特效、不出声地推进仿真
        for (int i = 0; i < debugSkipTicks && battle.Outcome() == 0; i = i + 1) {
            if (debugAutoplay) { RtsSim.Apply(battle, RtsSim.Coach(battle, battle.ticks)); }
            battle.TickSimulation((double)TickMs / 1000.0);
        }
        this.CenterOn(battle.teams[0].hq.X + 300.0, battle.teams[0].hq.Y);
        this.ShowAlert("🎯 " + battle.mission.goalText, false);
        ShowCard(null);
        view.Focus(app);
        SyncHud();
    }

    void Pause() {
        if (state != StatePlaying) { return; }
        state = StatePaused;
        view.CancelDrag();
        ReleasePan();
        ShowCard(cardPause);
        SyncHud();
    }

    void Resume() {
        if (state != StatePaused) { return; }
        state = StatePlaying;
        lastMs = Window.GetTickMs();
        ShowCard(null);
        view.Focus(app);
        SyncHud();
    }

    void ReleasePan() {
        panLeft = false;
        panRight = false;
        panUp = false;
        panDown = false;
    }

    void Finish(bool won) {
        state = StateResults;
        view.CancelDrag();
        ReleasePan();
        int ticks = battle.ticks;
        int hqPct = battle.HqPercent(0);
        int stars = battle.mission.Stars(won, ticks, hqPct);
        string mk = this.MissionKey(missionIndex, difficulty);
        int prevStars = (int)profile.Best(mk + "_stars");
        bool newBest = false;
        bool firstClear = false;
        if (won) {
            profile.Add("wins", 1);
            firstClear = !profile.Flag("cleared_m" + Convert.ToString(missionIndex), false);
            profile.SetFlag("cleared_m" + Convert.ToString(missionIndex), true);
            profile.SubmitBest(mk + "_stars", (long)stars);
            newBest = profile.SubmitLowest(mk + "_fast", (long)ticks * (long)TickMs);
            profile.Save();
            sfx.Play("success", 0.8);
        } else {
            profile.Save();
            sfx.Play("fail", 0.8);
        }
        FillResult(won, stars, prevStars, newBest, firstClear, hqPct);
        ShowCard(cardResult);
        SyncHud();
    }

    void NextMission() {
        if (missionIndex + 1 < RtsMission.Count && this.Unlocked(missionIndex + 1)) { missionIndex = missionIndex + 1; }
        StartBattle();
    }

    void Quit() { form.Close(); }

    void ToggleMute() {
        muted = !muted;
        bus.SetSfxMuted(muted);
        profile.SetFlag("muted", muted);
        if (!muted) { sfx.Play("click"); }
        SyncHud();
    }

    // ---- 进度 ----

    string MissionKey(int m, int d) { return "m" + Convert.ToString(m + 1) + "_d" + Convert.ToString(d); }

    public bool Unlocked(int m) {
        if (m <= 0 || debugUnlock) { return true; }
        return profile.Flag("cleared_m" + Convert.ToString(m - 1), false);
    }

    int HighestUnlocked() {
        int best = 0;
        for (int m = 0; m < RtsMission.Count; m = m + 1) {
            if (this.Unlocked(m)) { best = m; }
        }
        return best;
    }

    int StarsOf(int m, int d) { return (int)profile.Best(this.MissionKey(m, d) + "_stars"); }

    int TotalStars() {
        int n = 0;
        for (int m = 0; m < RtsMission.Count; m = m + 1) {
            for (int d = 0; d < 3; d = d + 1) { n = n + this.StarsOf(m, d); }
        }
        return n;
    }

    static string StarText(int n) {
        string s = "";
        for (int i = 0; i < 3; i = i + 1) { s = s + (i < n ? "★" : "☆"); }
        return s;
    }

    // ---- 输入（BattlefieldView / MinimapView / RtsRoot 调） ----

    public bool AcceptsBattleInput() { return state == StatePlaying; }

    public void SelectAt(int x, int y, bool additive) {
        int n = battle.SelectAt((double)x + camX, (double)y + camY, additive);
        if (n > 0) { sfx.Play("select", 0.6); }
        SyncHud();
    }

    public void SelectBox(int x0, int y0, int x1, int y1, bool additive) {
        int n = battle.SelectInRect((double)x0 + camX, (double)y0 + camY, (double)x1 + camX, (double)y1 + camY, additive);
        if (n > 0) { sfx.Play("select", 0.6); }
        SyncHud();
    }

    public void OrderAt(int x, int y, bool attack) { this.OrderWorld((double)x + camX, (double)y + camY, attack); }

    void OrderWorld(double wx, double wy, bool attack) {
        int r = battle.CommandAt(wx, wy, attack);
        if (r == 0) {
            sfx.Play("error", 0.4);
            return;
        }
        fx.AddPing(battle.targetX, battle.targetY, r);
        sfx.Play(r == 2 ? "cannon" : "click", r == 2 ? 0.4 : 0.7);
    }

    void Produce(int type) {
        if (state != StatePlaying) { return; }
        if (battle.Enqueue(0, type)) {
            sfx.Play("click");
        } else {
            sfx.Play("error", 0.4);
            RtsTeam t = battle.teams[0];
            if (t.queue.Count >= RtsBattle.QueueMax) {
                this.ShowAlert("生产队列已满（最多 " + Convert.ToString(RtsBattle.QueueMax) + " 个）", false);
            } else if (t.minerals < RtsUnit.CostOf(type)) {
                this.ShowAlert("晶矿不足：" + RtsUnit.NameOf(type) + "需要 " + Convert.ToString(RtsUnit.CostOf(type)), false);
            } else {
                this.ShowAlert("人口已满", false);
            }
        }
        SyncHud();
    }

    void CancelProduction() {
        if (state != StatePlaying) { return; }
        sfx.Play(battle.CancelLast(0) ? "click" : "error", 0.5);
        SyncHud();
    }

    void CenterOnSelection() {
        double sx = 0.0;
        double sy = 0.0;
        int n = 0;
        for (int i = 0; i < battle.units.Count; i = i + 1) {
            RtsUnit u = battle.units[i];
            if (!u.Selected) { continue; }
            sx = sx + u.X;
            sy = sy + u.Y;
            n = n + 1;
        }
        if (n > 0) { this.CenterOn(sx / (double)n, sy / (double)n); }
    }

    // 全局快捷键。返回 true 表示已处理。
    public bool HandleKey(int key) {
        if (key == 77) { ToggleMute(); return true; }                      // M
        if (key == 80 || key == 27) {                                        // P / Esc
            if (state == StatePlaying) { Pause(); return true; }
            if (state == StatePaused) { Resume(); return true; }
            if (state == StateResults && key == 27) { ShowMenu(); return true; }
            return false;
        }
        if (key == 13 || (key == 32 && state != StatePlaying)) {            // Enter / Space
            if (state == StateMenu) { StartBattle(); return true; }
            if (state == StateResults) {
                if (lastWon && missionIndex + 1 < RtsMission.Count) { NextMission(); } else { StartBattle(); }
                return true;
            }
            if (state == StatePaused) { Resume(); return true; }
            return false;
        }
        if (state == StateMenu) {
            if (key >= 49 && key < 49 + RtsMission.Count) { PickMission(key - 49); return true; }   // 1..3
            if (key == 37 || key == 39) {                                                          // ← →
                PickMission(missionIndex + (key == 37 ? -1 : 1));
                return true;
            }
            if (key == 68) { PickDifficulty((difficulty + 1) % 3); return true; }                 // D
            return false;
        }
        if (key == 82 && (state == StatePaused || state == StateResults)) { StartBattle(); return true; }  // R
        if (state != StatePlaying) { return false; }
        if (key == 37) { panLeft = true; return true; }
        if (key == 39) { panRight = true; return true; }
        if (key == 38) { panUp = true; return true; }
        if (key == 40) { panDown = true; return true; }
        if (key == 81) { Produce(RtsUnit.Infantry); return true; }           // Q
        if (key == 87) { Produce(RtsUnit.Tank); return true; }               // W
        if (key == 69) { Produce(RtsUnit.Artillery); return true; }          // E
        if (key == 82) { Produce(RtsUnit.Miner); return true; }              // R
        if (key == 88) { CancelProduction(); return true; }                  // X
        if (key == 65) {                                                     // A 全选部队
            if (battle.SelectArmy() > 0) { sfx.Play("select", 0.6); }
            SyncHud();
            return true;
        }
        if (key == 83) {                                                     // S 全选采矿车
            if (battle.SelectMiners() > 0) { sfx.Play("select", 0.6); }
            SyncHud();
            return true;
        }
        if (key == 72) {                                                     // H 指挥中心
            battle.SelectHq();
            this.CenterOn(battle.teams[0].hq.X, battle.teams[0].hq.Y);
            sfx.Play("select", 0.6);
            SyncHud();
            return true;
        }
        if (key == 32) { CenterOnSelection(); return true; }                 // Space 镜头跟选中
        return false;
    }

    public void HandleKeyUp(int key) {
        if (key == 37) { panLeft = false; }
        if (key == 39) { panRight = false; }
        if (key == 38) { panUp = false; }
        if (key == 40) { panDown = false; }
    }

    // ---- 绘制入口（控件调） ----

    public void RenderBattlefield(Canvas c, int bx, int by, int bw, int bh) {
        renderer.Render(c, bx, by, bw, bh, camX, camY, state == StatePlaying ? alpha : 1.0);
        // 非交战状态压暗战场，让弹层成为视觉焦点
        if (state != StatePlaying) { c.FillRect(bx, by, bw, bh, 0x99040A12); }
    }

    public void RenderMinimap(Canvas c, int x, int y, int w, int h) {
        renderer.RenderMinimap(c, x, y, w, h, camX, camY, view.ViewW(), view.ViewH(), alerts);
    }

    // 素材定位：盘上找不到就返回 null（调用方走矢量兜底）。
    static string FindAsset(string rel) {
        string p = Assets.Find(rel);
        if (p == null || !File.Exists(p)) { return null; }
        return p;
    }
}
