using System;

// 战役关卡与难度（仿真层数据，不碰界面）。三关短战役，每关有自己的胜利目标、
// 时限、标准用时与红军 AI 参数；难度（新兵 / 老兵 / 精英）整体缩放红军经济与进攻节奏。
//
// 星级：★ 完成目标；★★ 在标准用时内完成；★★★ 同时指挥中心完好度 ≥ 70%。
public class RtsMission {
    public const int GoalDestroyHq = 0;   // 摧毁红军指挥中心
    public const int GoalHoldUplink = 1;  // 占领并累计控制上行链路 N 秒

    public int index;
    public int difficulty;
    public string code;
    public string name;
    public string goalText;
    public string enemyText;
    public int goal;
    public int holdTicksToWin;   // GoalHoldUplink：累计控制多少帧
    public int timeLimitTicks;
    public int parTicks;

    // 开局
    public int blueMinerals;
    public int redMinerals;
    public int blueInfantry;
    public int blueTanks;
    public int blueArtillery;
    public int redInfantry;
    public int redTanks;
    public int redArtillery;

    // 红军 AI
    public double redIncomePerSec;   // 指挥部补给（与矿车收入叠加）
    public int redMinerTarget;
    public int firstWaveTick;
    public int waveIntervalTicks;
    public int waveMinSize;
    public int waveGrowth;          // 每一波最低规模递增
    public bool contestUplink;      // 是否主动争夺上行链路
    public int supplyCap;
    public bool redForward;         // 红军守备队开局驻守上行链路

    public const int Count = 3;
    public const int HqIntegrityForStar = 70;

    public static string DifficultyName(int d) {
        if (d == 0) { return "新兵"; }
        if (d == 2) { return "精英"; }
        return "老兵";
    }

    public static RtsMission Get(int index, int difficulty) {
        RtsMission m = new RtsMission();
        if (index < 0) { index = 0; }
        if (index >= Count) { index = Count - 1; }
        if (difficulty < 0) { difficulty = 0; }
        if (difficulty > 2) { difficulty = 2; }
        m.index = index;
        m.difficulty = difficulty;
        m.holdTicksToWin = 0;
        m.supplyCap = 60;
        m.contestUplink = false;
        m.redForward = false;
        if (index == 0) {
            m.code = "01";
            m.name = "破晓突击";
            m.goal = GoalDestroyHq;
            m.goalText = "摧毁裂谷对岸的红军指挥中心";
            m.enemyText = "敌军兵力薄弱，进攻零散——练好生产与编队";
            m.timeLimitTicks = 20 * 240;
            m.parTicks = 20 * 150;
            m.blueMinerals = 250;
            m.redMinerals = 100;
            m.blueInfantry = 8;
            m.blueTanks = 2;
            m.blueArtillery = 1;
            m.redInfantry = 9;
            m.redTanks = 2;
            m.redArtillery = 1;
            m.redIncomePerSec = 1.0;
            m.redMinerTarget = 3;
            m.firstWaveTick = 20 * 75;
            m.waveIntervalTicks = 20 * 55;
            m.waveMinSize = 4;
            m.waveGrowth = 2;
        } else if (index == 1) {
            m.code = "02";
            m.name = "上行链路";
            m.goal = GoalHoldUplink;
            m.holdTicksToWin = 20 * 60;
            m.goalText = "占领峡口中央的上行链路，累计控制 60 秒";
            m.enemyText = "红军会派小队争夺链路，并不时反扑你的基地";
            m.timeLimitTicks = 20 * 240;
            m.parTicks = 20 * 150;
            m.blueMinerals = 300;
            m.redMinerals = 200;
            m.blueInfantry = 6;
            m.blueTanks = 2;
            m.blueArtillery = 1;
            m.redInfantry = 5;
            m.redTanks = 2;
            m.redArtillery = 1;
            m.redIncomePerSec = 1.4;
            m.redMinerTarget = 4;
            m.firstWaveTick = 20 * 50;
            m.waveIntervalTicks = 20 * 45;
            m.waveMinSize = 5;
            m.waveGrowth = 2;
            m.contestUplink = true;
            m.redForward = true;
        } else {
            m.code = "03";
            m.name = "铁砧行动";
            m.goal = GoalDestroyHq;
            m.goalText = "顶住红军的连续攻势，摧毁其指挥中心";
            m.enemyText = "红军按你的兵种组合生产克制单位，攻势一波比一波大";
            m.timeLimitTicks = 20 * 300;
            m.parTicks = 20 * 190;
            m.blueMinerals = 350;
            m.redMinerals = 350;
            m.blueInfantry = 6;
            m.blueTanks = 3;
            m.blueArtillery = 2;
            m.redInfantry = 8;
            m.redTanks = 3;
            m.redArtillery = 2;
            m.redIncomePerSec = 3.6;
            m.redMinerTarget = 5;
            m.firstWaveTick = 20 * 45;
            m.waveIntervalTicks = 20 * 36;
            m.waveMinSize = 6;
            m.waveGrowth = 3;
            m.contestUplink = true;
        }
        // 难度：红军经济、进攻间隔、开局守军
        if (difficulty == 0) {
            m.redIncomePerSec = m.redIncomePerSec * 0.6;
            m.waveIntervalTicks = m.waveIntervalTicks * 5 / 4;
            m.firstWaveTick = m.firstWaveTick * 5 / 4;
            m.blueMinerals = m.blueMinerals + 150;
            m.redInfantry = m.redInfantry - 2;
        } else if (difficulty == 2) {
            m.redIncomePerSec = m.redIncomePerSec * 1.6 + 1.0;
            m.waveIntervalTicks = m.waveIntervalTicks * 4 / 5;
            m.firstWaveTick = m.firstWaveTick * 4 / 5;
            m.redMinerals = m.redMinerals + 200;
            m.redInfantry = m.redInfantry + 3;
            m.redTanks = m.redTanks + 1;
            m.waveGrowth = m.waveGrowth + 1;
        }
        return m;
    }

    // 本局星数（未胜利 = 0）。
    public int Stars(bool won, int ticks, int hqPercent) {
        if (!won) { return 0; }
        int s = 1;
        if (ticks <= parTicks) { s = s + 1; }
        if (ticks <= parTicks && hqPercent >= HqIntegrityForStar) { s = s + 1; }
        return s;
    }
}
