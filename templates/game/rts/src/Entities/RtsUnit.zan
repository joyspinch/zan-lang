using System;
using System.Collections.Generic;
using Gui;
using Gui.Widget;
using Game.Tactics;
using Game.Core;

public class RtsUnit {
    int id;
    int type;  // 0: 陆战步兵, 1: 重装坦克, 2: 采矿战车
    int team;  // 0: 蓝军(玩家), 1: 红军(敌方)
    double x;
    double y;
    double radius;
    double speed;
    int hp;
    int maxHp;
    bool selected;
    int rvoSlot;

    // 火力：射程（像素）、单发伤害、装填（秒）与剩余冷却；采矿车不带武器（射程 0）
    double range;
    int damage;
    double reload;
    double cooldown;

    // 行军令（null = 原地驻守）与驻防点（红军脱战后回防）
    RtsOrder order;
    double homeX;
    double homeY;

    RtsUnit(int id, int type, int team, double x, double y, double r, double spd, int maxHp,
            double range, int damage, double reload) {
        this.id = id;
        this.type = type;
        this.team = team;
        this.x = x;
        this.y = y;
        this.radius = r;
        this.speed = spd;
        this.hp = maxHp;
        this.maxHp = maxHp;
        this.selected = false;
        this.rvoSlot = -1;
        this.range = range;
        this.damage = damage;
        this.reload = reload;
        // 首发错开，免得整条战线同一帧齐射
        this.cooldown = (double)(id % 7) * 0.1;
        this.order = null;
        this.homeX = x;
        this.homeY = y;
    }

    static RtsUnit Create(int id, int type, int team, double x, double y) {
        if (type == 1) {  // 坦克：远射程重炮
            return new RtsUnit(id, type, team, x, y, 16.0, 90.0, 300, 150.0, 34, 1.6);
        } else if (type == 2) {  // 采矿车：不参战
            return new RtsUnit(id, type, team, x, y, 18.0, 75.0, 450, 0.0, 0, 1.0);
        }
        // 默认步兵：近射程速射
        return new RtsUnit(id, type, team, x, y, 9.0, 110.0, 80, 100.0, 9, 0.8);
    }

    int Id { get { return id; } }
    int Type { get { return type; } }
    int Team { get { return team; } }
    double X { get { return x; } set { x = value; } }
    double Y { get { return y; } set { y = value; } }
    double Radius { get { return radius; } }
    double Speed { get { return speed; } }
    int Hp { get { return hp; } set { hp = value; } }
    int MaxHp { get { return maxHp; } }
    bool Selected { get { return selected; } set { selected = value; } }
    int RvoSlot { get { return rvoSlot; } set { rvoSlot = value; } }
    double Range { get { return range; } }
    int Damage { get { return damage; } }
    double Reload { get { return reload; } }
    double Cooldown { get { return cooldown; } set { cooldown = value; } }
    RtsOrder Order { get { return order; } set { order = value; } }
    double HomeX { get { return homeX; } }
    double HomeY { get { return homeY; } }
}
