using System;
using System.Collections.Generic;
using Gui;
using Gui.Widget;
using Gui.Rendering;
using Game.Tactics;
using Game.Core;

public class RtsUnit {
    int id;
    int type;  // 0: 陆战步兵, 1: 重装坦克, 2: 采矿战车
    int team;  // 0: 蓝军(玩家), 1: 红军(敌方)
    double x;
    double y;
    double radius;
    double speed;
    int hp;
    int maxHp;
    bool selected;
    int rvoSlot;

    RtsUnit(int id, int type, int team, double x, double y, double r, double spd, int maxHp) {
        this.id = id;
        this.type = type;
        this.team = team;
        this.x = x;
        this.y = y;
        this.radius = r;
        this.speed = spd;
        this.hp = maxHp;
        this.maxHp = maxHp;
        this.selected = false;
        this.rvoSlot = -1;
    }

    static RtsUnit Create(int id, int type, int team, double x, double y) {
        if (type == 1) {  // 坦克
            return new RtsUnit(id, type, team, x, y, 16.0, 90.0, 300);
        } else if (type == 2) {  // 采矿车
            return new RtsUnit(id, type, team, x, y, 18.0, 75.0, 450);
        }
        // 默认步兵
        return new RtsUnit(id, type, team, x, y, 9.0, 110.0, 80);
    }

    int Id { get { return id; } }
    int Type { get { return type; } }
    int Team { get { return team; } }
    double X { get { return x; } set { x = value; } }
    double Y { get { return y; } set { y = value; } }
    double Radius { get { return radius; } }
    double Speed { get { return speed; } }
    int Hp { get { return hp; } set { hp = value; } }
    int MaxHp { get { return maxHp; } }
    bool Selected { get { return selected; } set { selected = value; } }
    int RvoSlot { get { return rvoSlot; } set { rvoSlot = value; } }
}

