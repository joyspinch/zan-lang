// 对局流程弹层（简报 / 暂停 / 战报）：标准 Modal，去掉右上角关闭钮与点遮罩关闭，
// 只能经按钮或快捷键离开——流程状态始终由 Program 决定。弹层打开时键盘路由到弹层，
// 这里把按键与 Esc 转给 Program 的全局快捷键。
using System;
using Gui;
using Gui.Widget;

public class RtsModal : Modal {
    weak Program host;

    RtsModal(Program host, string title) : base(title) {
        this.host = host;
        this.MaskClosable(false);
        this.closeBtn.SetShown(false);
    }

    public override int InputFocusCapabilities() { return 1; }

    public override void OnKeyDown(RoutedEventArgs e) {
        if (e.handled) { return; }
        Program h = this.host;
        if (h != null && h.HandleKey(e.keyCode)) { e.Handle(); }
    }

    public override bool OnPopupEscape(App app) {
        Program h = this.host;
        if (h != null) { h.HandleKey(27); }
        return true;
    }
}
