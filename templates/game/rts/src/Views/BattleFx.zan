// 战场特效：曳光与爆炸残影。纯表现层——从 RtsBattle 每帧的 shots/fallen 取事件，
// 按界面帧衰减；暂停时不推进（Tick 只在交战中调用）。
using System;
using System.Collections.Generic;
using Gui;

public class FxMark {
    public int kind;  // 0 曳光, 1 爆炸
    public double x0;
    public double y0;
    public double x1;
    public double y1;
    public int team;
    public int life;
    public int maxLife;
    public int size;
}

public class BattleFx {
    List<FxMark> marks = new List<FxMark>();

    public void Clear() { this.marks.Clear(); }

    public void AddShot(RtsShot s) {
        FxMark m = new FxMark();
        m.kind = 0;
        m.x0 = s.fromX;
        m.y0 = s.fromY;
        m.x1 = s.toX;
        m.y1 = s.toY;
        m.team = s.team;
        m.size = s.type == 1 ? 2 : 1;
        m.life = 3;
        m.maxLife = 3;
        this.marks.Add(m);
    }

    public void AddBlast(RtsUnit u) {
        FxMark m = new FxMark();
        m.kind = 1;
        m.x0 = u.X;
        m.y0 = u.Y;
        m.team = u.Team;
        m.size = (int)u.Radius;
        m.life = 10;
        m.maxLife = 10;
        this.marks.Add(m);
    }

    public void Tick() {
        for (int i = this.marks.Count - 1; i >= 0; i = i - 1) {
            FxMark m = this.marks[i];
            m.life = m.life - 1;
            if (m.life <= 0) { this.marks.RemoveAt(i); }
        }
    }

    public void Render(Canvas c, int bx, int by) {
        for (int i = 0; i < this.marks.Count; i = i + 1) {
            FxMark m = this.marks[i];
            if (m.kind == 0) {
                int col = m.team == 0 ? 0xDD93C5FD : 0xDDFCA5A5;
                c.DrawLine(bx + (int)m.x0, by + (int)m.y0, bx + (int)m.x1, by + (int)m.y1, col, m.size);
                c.FillCircle(bx + (int)m.x1, by + (int)m.y1, m.size + 1, 0xEEFDE68A);
            } else {
                // 爆炸：外扩的火环 + 渐隐焦痕
                int age = m.maxLife - m.life;
                int r = m.size + age * 2;
                int alpha = (m.life * 255) / m.maxLife;
                c.FillCircle(bx + (int)m.x0, by + (int)m.y0, r, (alpha / 2 << 24) | 0x00F97316);
                c.DrawCircle(bx + (int)m.x0, by + (int)m.y0, r + 2, (alpha << 24) | 0x00FDE68A, 2);
            }
        }
    }
}
