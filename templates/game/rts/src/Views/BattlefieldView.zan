using System;
using System.Collections.Generic;
using Gui;
using Gui.Widget;
using Gui.Rendering;
using Game.Tactics;
using Game.Core;

public class BattlefieldView : Control {
    Program host;

    BattlefieldView(Program host) {
        this.InitControl("battlefield", 1);
        this.host = host;
    }

    override void OnPaint(App app) {
        base.OnPaint(app);
        Canvas c = app.canvas;
        host.RenderBattlefield(c, this.bx, this.by, this.bw, this.bh);
    }
}
