// 窗口根容器（纵向布局）：任何获得焦点的子控件（战场、按钮）上的按键都冒泡到这里，
// 交给 Program 处理全局快捷键（P/Esc 暂停、M 静音、A 全选、QWER 生产、方向键平移、Enter 出击）。
using System;
using Gui;
using Gui.Widget;

public class RtsRoot : Panel {
    weak Program host;

    RtsRoot(Program host) {
        this.InitPanel("column", 3);
        this.layout = 1;
        this.flexFlow = 1;
        this.host = host;
    }

    public override void OnKeyDown(RoutedEventArgs e) {
        if (e.handled) { return; }
        if (host.HandleKey(e.keyCode)) { e.Handle(); }
    }

    public override void OnKeyUp(RoutedEventArgs e) { host.HandleKeyUp(e.keyCode); }
}
