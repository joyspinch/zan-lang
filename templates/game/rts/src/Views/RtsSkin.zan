using System;

// 战术指挥台皮肤：深海军蓝玻璃面板 + 冷青描边与发光 + 琥珀警示 + 敌军猩红，
// 取自战场底图 assets/bg_field.jpg 的冷青网格光。
//
// 界面全部是标准控件（Panel 流式容器 / Label / Button / Progress / Image / Modal），
// 这里只给语义类上色——不自绘、不重画控件。整张样式表随 exe 内嵌（app.UseCss），
// 发布时不需要旁带皮肤文件；未声明的部分落回 Gui 内嵌的 base.css。
//
// 语义类一览（前缀 tx-）：
//   页面    tx-root · tx-topbar · tx-command · tx-panel · tx-mapframe · tx-spacer · tx-row-mid
//   文字    tx-title · tx-h2 · tx-text · tx-dim · tx-cap · tx-big · tx-stars · tx-chip-label
//           颜色 tx-cyan/amber/red/green/white
//   按钮    tx-btn（钢青描边）· tx-cta（冷青主按钮）· tx-chip / tx-chip-on（难度）·
//           tx-mission / tx-mission-on（关卡）· tx-build（生产）· tx-icon（顶栏小钮）
//   其他    tx-portrait（选中单位头像）· tx-bar + tx-prod / tx-obj / tx-hp（进度条）
public class RtsSkin {
    public static string Css() {
        return RtsSkin.PageCss() + RtsSkin.TextCss() + RtsSkin.ButtonCss() + RtsSkin.ModalCss() + RtsSkin.BarCss();
    }

    static string PageCss() {
        return "window{background:#04080e}"
            + "stack.tx-root{background:linear-gradient(to bottom,#0a1420,#04080e)}"
            + "stack.tx-spacer{flex-grow:1}"
            + "stack.tx-row-mid{align-items:center}"
            + "stack.tx-topbar{height:46;align-items:center;background:linear-gradient(to bottom,#13263a,#09131f);"
            + "border:1 #24506e;border-radius:4;box-shadow:0 3 12 rgba(0,0,0,0.6)}"
            + "stack.tx-command{height:166;align-items:stretch}"
            + "stack.tx-panel{background:linear-gradient(to bottom,#102033,#07101a);border:1 #24506e;border-radius:4;"
            + "box-shadow:0 0 14 rgba(40,170,230,0.12)}"
            + "stack.tx-mapframe{width:262;background:linear-gradient(to bottom,#102033,#07101a);border:1 #2f6a8e;"
            + "border-radius:4;align-items:center;box-shadow:0 0 16 rgba(63,214,255,0.18)}"
            + "stack.tx-sel{width:452}"
            + "stack.tx-prod-panel{flex-grow:1}"
            + "stack.tx-statcol{flex-grow:1}"
            + "stack.tx-brief{background:#07111b;border:1 #1d3b52;border-radius:4}"
            + "stack.tx-chipbox{align-items:center}"
            + "image.tx-portrait{width:96;height:96;background:linear-gradient(to bottom,#173450,#060c14);"
            + "border:1 #2f6a8e;border-radius:4}"
            + "battlefield{border:1 #1d3b52}"
            + "minimap{width:240;height:144}";
    }

    static string TextCss() {
        return "label.tx-title{font-size:17;font-weight:700;color:#7fe6ff;letter-spacing:2;"
            + "text-shadow:0 0 10 rgba(63,214,255,0.55)}"
            + "label.tx-h2{font-size:19;font-weight:700;color:#e6f6ff}"
            + "label.tx-h3{font-size:24;font-weight:700;color:#7fe6ff;text-shadow:0 0 12 rgba(63,214,255,0.5)}"
            + "label.tx-text{font-size:14;color:#cfe4f1}"
            + "label.tx-dim{font-size:13;color:#7f9bb0}"
            + "label.tx-cap{font-size:11;color:#5f88a6;letter-spacing:3}"
            + "label.tx-big{font-size:16;font-weight:700;color:#e6f6ff}"
            + "label.tx-hud{font-size:15;font-weight:700;color:#e6f6ff}"
            + "label.tx-stars{font-size:38;font-weight:700;color:#ffc94a;text-align:center;"
            + "text-shadow:0 0 16 rgba(255,180,60,0.65)}"
            + "label.tx-cyan{color:#5fdcff}"
            + "label.tx-amber{color:#ffb547}"
            + "label.tx-red{color:#ff5468}"
            + "label.tx-green{color:#46f0a0}"
            + "label.tx-white{color:#ffffff}"
            + "label.tx-center{text-align:center}"
            + "label.tx-alert{font-size:14;font-weight:700;color:#ffb547;padding-left:10;padding-right:10;height:28;"
            + "vertical-align:middle;background:rgba(255,160,40,0.10);border:1 #8a5a1e;border-radius:3}"
            + "label.tx-alert-red{color:#ff7a88;background:rgba(255,60,80,0.14);border-color:#a0303f}"
            + "label.tx-chip-label{font-size:13;font-weight:700;color:#bfe9ff;padding-left:10;padding-right:10;height:28;"
            + "vertical-align:middle;background:#0a2234;border:1 #2f6a8e;border-radius:3;letter-spacing:1}"
            + "label.tx-newbest{font-size:17;font-weight:700;color:#04121c;text-align:center;"
            + "background:linear-gradient(to bottom,#9ff0ff,#2fb8e6);border:1 #d8fbff;border-radius:3;"
            + "padding-top:5;padding-bottom:5;box-shadow:0 0 16 rgba(63,214,255,0.6)}";
    }

    static string ButtonCss() {
        string all = "button.tx-btn,button.tx-cta,button.tx-chip,button.tx-chip-on,button.tx-mission,button.tx-mission-on,"
            + "button.tx-build,button.tx-icon";
        return all + "{height:38;padding-left:16;padding-right:16;font-size:14;border-radius:3;-zan-sheen:0}"
            + "button.tx-btn label.button-caption,button.tx-chip label.button-caption,button.tx-mission label.button-caption,"
            + "button.tx-build label.button-caption,button.tx-icon label.button-caption{color:#cfe9f8;background:transparent}"
            + "button.tx-cta label.button-caption,button.tx-chip-on label.button-caption,"
            + "button.tx-mission-on label.button-caption{color:#03121c;font-weight:700;background:transparent}"
            + "button.tx-btn:disabled label.button-caption,button.tx-build:disabled label.button-caption,"
            + "button.tx-mission:disabled label.button-caption,button.tx-cta:disabled label.button-caption,"
            + "button.tx-icon:disabled label.button-caption{color:#4d6577}"
            // 钢青常规钮
            + "button.tx-btn,button.tx-icon,button.tx-chip,button.tx-mission,button.tx-build{color:#cfe9f8;"
            + "background:linear-gradient(to bottom,#16324a,#0b1a29);border:1 #2f6a8e;box-shadow:0 2 6 rgba(0,0,0,0.5)}"
            + "button.tx-btn:hover,button.tx-icon:hover,button.tx-chip:hover,button.tx-mission:hover,button.tx-build:hover{"
            + "background:linear-gradient(to bottom,#1e4563,#0f2438);border-color:#5fdcff;color:#ffffff;"
            + "box-shadow:0 0 12 rgba(63,214,255,0.45)}"
            + "button.tx-btn:active,button.tx-icon:active,button.tx-chip:active,button.tx-mission:active,button.tx-build:active{"
            + "background:#06101a;border-color:#9ff0ff;box-shadow:inset 0 0 8 rgba(63,214,255,0.4)}"
            + "button.tx-btn:focus,button.tx-icon:focus,button.tx-chip:focus,button.tx-mission:focus,button.tx-build:focus{"
            + "border-color:#9ff0ff;box-shadow:0 0 8 rgba(120,230,255,0.6)}"
            + "button.tx-btn:disabled,button.tx-icon:disabled,button.tx-mission:disabled,button.tx-build:disabled{"
            + "color:#4d6577;background:#08121c;border-color:#173044;box-shadow:none}"
            + "button.tx-icon{height:32;padding-left:12;padding-right:12;font-size:13}"
            + "button.tx-build{height:52;width:126;padding-left:8;padding-right:8;font-size:14}"
            // 冷青主按钮
            + "button.tx-cta,button.tx-chip-on,button.tx-mission-on{color:#03121c;font-weight:700;"
            + "background:linear-gradient(to bottom,#8ff0ff,#22a8d8);border:1 #d8fbff;box-shadow:0 0 16 rgba(63,214,255,0.5)}"
            + "button.tx-cta:hover,button.tx-chip-on:hover,button.tx-mission-on:hover{"
            + "background:linear-gradient(to bottom,#b8f7ff,#3cc0ec);box-shadow:0 0 24 rgba(63,214,255,0.8)}"
            + "button.tx-cta:active,button.tx-chip-on:active,button.tx-mission-on:active{"
            + "background:linear-gradient(to bottom,#3cb4dc,#14789e);box-shadow:none}"
            + "button.tx-cta:focus,button.tx-chip-on:focus,button.tx-mission-on:focus{border:2 #ffffff;"
            + "box-shadow:0 0 18 rgba(160,240,255,0.85)}"
            + "button.tx-cta:disabled{background:#0b1a29;border-color:#173044;box-shadow:none}"
            + "button.tx-cta{height:44;padding-left:26;padding-right:26;font-size:16}"
            + "button.tx-chip,button.tx-chip-on{height:32;width:92;font-size:14}"
            + "button.tx-mission,button.tx-mission-on{height:60;width:204;font-size:15}";
    }

    // 流程弹层：标准 Modal 的卡面换成战术终端——冷青描边、扫描线式标题。
    static string ModalCss() {
        return "modal::mask{background:rgba(2,6,12,0.55)}"
            + "card.modal-surface{background:linear-gradient(to bottom,#0f2032,#060d16);border:1 #3a7ea6;border-radius:6;"
            + "box-shadow:0 0 36 rgba(63,214,255,0.28)}"
            + "card.modal-surface .card-title{font-size:20;font-weight:700;color:#7fe6ff;letter-spacing:2;"
            + "text-shadow:0 0 12 rgba(63,214,255,0.6)}"
            + "card.modal-surface .card-header{border-bottom:1 #1d3b52;padding-bottom:8}"
            + "card.modal-surface .card-body{padding-top:12;padding-bottom:8}"
            + "card.modal-surface .card-footer{border-top:1 #1d3b52}";
    }

    static string BarCss() {
        return "progress.tx-bar{width:100%}"
            + ".tx-bar .progress-track{height:10;border-radius:2;background:#050b12;border:1 #1d3b52}"
            + ".tx-bar .progress-fill{height:10;border-radius:2;background:linear-gradient(to bottom,#8ff0ff,#1d8fc0)}"
            + ".tx-obj .progress-fill{background:linear-gradient(to bottom,#ffe08a,#e08a1e)}"
            + ".tx-hp .progress-fill{background:linear-gradient(to bottom,#9dffc9,#1fae68)}"
            + "progress.tx-obj{width:150}"
            + "progress.tx-prod{width:100%}";
    }
}
