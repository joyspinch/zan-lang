using System;

// Hand-authored level curve. Four chapters of ten levels; every tenth level is
// a boss with several "rings" (phases) that each clear and re-arm the rotor.
// Pure data: the simulation reads it, nothing here touches audio or files.
public class PinPhase {
    int target;
    List<double> presets;
    double speed;
    double dir;
    double pulseAmp;
    int pulseMs;
    int flipMs;
    int swingMs;
    double wobblePx;
    int wobbleMs;

    PinPhase(int target, double speed) {
        this.target = target;
        this.speed = speed;
        this.dir = 1.0;
        this.presets = new List<double>();
        this.pulseMs = 2400;
        this.wobbleMs = 2400;
    }

    PinPhase Ccw() { this.dir = -1.0; return this; }
    PinPhase Pulse(double amp, int ms) { this.pulseAmp = amp; this.pulseMs = ms; return this; }
    PinPhase Flip(int ms) { this.flipMs = ms; return this; }
    PinPhase Swing(int ms) { this.swingMs = ms; return this; }
    PinPhase Wobble(double px, int ms) { this.wobblePx = px; this.wobbleMs = ms; return this; }

    // n pins spread evenly around the rotor.
    PinPhase Even(int n, double offset) {
        for (int i = 0; i < n; i = i + 1) { this.presets.Add(offset + i * PinWorld.Tau / n); }
        return this;
    }

    // `groups` walls of `per` pins packed `gap` radians apart.
    PinPhase Clusters(int groups, int per, double gap) {
        for (int g = 0; g < groups; g = g + 1) {
            double center = 0.4 + g * PinWorld.Tau / groups;
            for (int i = 0; i < per; i = i + 1) { this.presets.Add(center + (i - (per - 1) / 2.0) * gap); }
        }
        return this;
    }

    // n pins fanned over `span` radians, leaving one wide window open.
    PinPhase Arc(int n, double span) {
        for (int i = 0; i < n; i = i + 1) { this.presets.Add(1.1 + span * i / (n - 1)); }
        return this;
    }

    bool Pulses() { return this.pulseAmp > 0; }
    bool Flips() { return this.flipMs > 0; }
    bool Swings() { return this.swingMs > 0; }
    bool Wobbles() { return this.wobblePx > 0; }
}

public class PinLevel {
    int number;
    string name;
    int parMs;
    List<PinPhase> phases;

    PinLevel(int number, string name, int parMs) {
        this.number = number;
        this.name = name;
        this.parMs = parMs;
        this.phases = new List<PinPhase>();
    }

    PinLevel Add(PinPhase phase) { this.phases.Add(phase); return this; }
    bool Boss() { return this.phases.Count > 1; }

    int TotalPins() {
        int total = 0;
        for (int i = 0; i < this.phases.Count; i = i + 1) { total = total + this.phases[i].target; }
        return total;
    }
}

public class PinLevels {
    const int Count = 40;

    static int Clamp(int level) {
        if (level < 1) { return 1; }
        if (level > PinLevels.Count) { return PinLevels.Count; }
        return level;
    }

    static bool IsBoss(int level) { return level % 10 == 0; }

    static string Chapter(int level) {
        int c = (PinLevels.Clamp(level) - 1) / 10;
        if (c == 0) { return "第一章 · 初转"; }
        if (c == 1) { return "第二章 · 变奏"; }
        if (c == 2) { return "第三章 · 摇摆"; }
        return "第四章 · 星环";
    }

    static PinPhase P(int target, double speed) { return new PinPhase(target, speed); }

    static PinLevel Get(int level) {
        int n = PinLevels.Clamp(level);
        if (n <= 10) { return PinLevels.ChapterOne(n); }
        if (n <= 20) { return PinLevels.ChapterTwo(n); }
        if (n <= 30) { return PinLevels.ChapterThree(n); }
        return PinLevels.ChapterFour(n);
    }

    // Prelude: constant spin, first patterns, then pulses and reversals arrive.
    static PinLevel ChapterOne(int n) {
        if (n == 1) { return new PinLevel(n, "初转", 4000).Add(PinLevels.P(5, 0.80).Even(2, 0.0)); }
        if (n == 2) { return new PinLevel(n, "逆旋", 4500).Add(PinLevels.P(6, 0.90).Ccw().Even(3, 0.3)); }
        if (n == 3) { return new PinLevel(n, "双壁", 6000).Add(PinLevels.P(7, 1.00).Clusters(2, 2, 0.30)); }
        if (n == 4) { return new PinLevel(n, "呼吸", 5500).Add(PinLevels.P(7, 0.95).Even(4, 0.2).Pulse(0.35, 2600)); }
        if (n == 5) { return new PinLevel(n, "半月", 6500).Add(PinLevels.P(8, 1.05).Ccw().Arc(5, 3.14)); }
        if (n == 6) { return new PinLevel(n, "潮汐", 6000).Add(PinLevels.P(8, 1.00).Even(3, 0.5).Pulse(0.45, 2200)); }
        if (n == 7) { return new PinLevel(n, "回旋", 8000).Add(PinLevels.P(8, 1.10).Clusters(3, 2, 0.30).Flip(2600)); }
        if (n == 8) { return new PinLevel(n, "五芒", 7000).Add(PinLevels.P(9, 1.10).Ccw().Even(5, 0.1).Pulse(0.40, 2000)); }
        if (n == 9) { return new PinLevel(n, "急转", 9500).Add(PinLevels.P(9, 1.15).Clusters(2, 3, 0.26).Flip(2200)); }
        return new PinLevel(n, "双环守卫", 15500)
            .Add(PinLevels.P(7, 1.10).Even(4, 0.0).Pulse(0.40, 2400))
            .Add(PinLevels.P(8, 1.25).Ccw().Clusters(3, 2, 0.30).Flip(2000));
    }

    // Tempo: harder pulses, sudden flips and the swinging pendulum.
    static PinLevel ChapterTwo(int n) {
        if (n == 11) { return new PinLevel(n, "钟摆", 9500).Add(PinLevels.P(9, 1.15).Even(4, 0.4).Swing(5200)); }
        if (n == 12) { return new PinLevel(n, "窄门", 9000).Add(PinLevels.P(10, 1.20).Arc(6, 4.0).Flip(1900)); }
        if (n == 13) { return new PinLevel(n, "四象", 10000).Add(PinLevels.P(10, 1.25).Clusters(4, 2, 0.28).Pulse(0.55, 1800)); }
        if (n == 14) { return new PinLevel(n, "逆流", 9500).Add(PinLevels.P(10, 1.30).Ccw().Even(5, 0.3).Flip(1700)); }
        if (n == 15) { return new PinLevel(n, "双墙", 15000).Add(PinLevels.P(11, 1.25).Clusters(2, 4, 0.24).Swing(4800)); }
        if (n == 16) { return new PinLevel(n, "错拍", 10500).Add(PinLevels.P(11, 1.35).Even(6, 0.2).Pulse(0.50, 1600).Flip(2400)); }
        if (n == 17) { return new PinLevel(n, "弦月", 14000).Add(PinLevels.P(11, 1.40).Ccw().Arc(7, 3.6).Flip(1500)); }
        if (n == 18) { return new PinLevel(n, "三叠", 14000).Add(PinLevels.P(12, 1.40).Clusters(3, 3, 0.26).Pulse(0.60, 1500)); }
        if (n == 19) { return new PinLevel(n, "疾风", 14000).Add(PinLevels.P(12, 1.45).Even(6, 0.5).Pulse(0.45, 1900).Flip(1600)); }
        return new PinLevel(n, "三重奏", 26500)
            .Add(PinLevels.P(8, 1.30).Even(3, 0.0).Pulse(0.50, 2000))
            .Add(PinLevels.P(9, 1.40).Ccw().Clusters(2, 3, 0.26).Flip(1600))
            .Add(PinLevels.P(9, 1.45).Even(6, 0.3).Swing(4600));
    }

    // Sway: the rotor itself drifts left and right under the launcher.
    static PinLevel ChapterThree(int n) {
        if (n == 21) { return new PinLevel(n, "微澜", 8000).Add(PinLevels.P(10, 1.10).Even(3, 0.2).Wobble(18, 2600)); }
        if (n == 22) { return new PinLevel(n, "摆渡", 9000).Add(PinLevels.P(10, 1.20).Ccw().Clusters(3, 2, 0.30).Wobble(20, 2300)); }
        if (n == 23) { return new PinLevel(n, "浮沉", 9000).Add(PinLevels.P(11, 1.25).Even(4, 0.6).Wobble(20, 2500).Pulse(0.40, 2100)); }
        if (n == 24) { return new PinLevel(n, "偏心", 10000).Add(PinLevels.P(11, 1.30).Arc(6, 3.4).Wobble(22, 2200).Flip(2200)); }
        if (n == 25) { return new PinLevel(n, "晃钟", 14000).Add(PinLevels.P(11, 1.30).Clusters(4, 2, 0.28).Wobble(22, 2000).Swing(5000)); }
        if (n == 26) { return new PinLevel(n, "醉月", 10500).Add(PinLevels.P(12, 1.40).Ccw().Even(5, 0.0).Wobble(22, 2400).Pulse(0.50, 1700)); }
        if (n == 27) { return new PinLevel(n, "回澜", 16000).Add(PinLevels.P(12, 1.40).Clusters(2, 4, 0.25).Wobble(24, 2100).Flip(1800)); }
        if (n == 28) { return new PinLevel(n, "漩涡", 11000).Add(PinLevels.P(12, 1.45).Even(6, 0.4).Wobble(26, 1800).Pulse(0.50, 2000)); }
        if (n == 29) { return new PinLevel(n, "惊涛", 18000).Add(PinLevels.P(13, 1.50).Clusters(3, 3, 0.26).Wobble(24, 2000).Flip(1600)); }
        return new PinLevel(n, "摇摆巨轮", 27000)
            .Add(PinLevels.P(8, 1.30).Even(4, 0.3).Wobble(22, 2400).Pulse(0.45, 2000))
            .Add(PinLevels.P(9, 1.40).Ccw().Clusters(3, 2, 0.28).Wobble(24, 2000).Flip(1800))
            .Add(PinLevels.P(10, 1.45).Even(5, 0.0).Wobble(28, 2200).Swing(4800));
    }

    // Finale: every mechanic at once and the largest pin counts.
    static PinLevel ChapterFour(int n) {
        if (n == 31) { return new PinLevel(n, "星门", 13500).Add(PinLevels.P(12, 1.50).Even(4, 0.1).Pulse(0.55, 1800).Flip(1700)); }
        if (n == 32) { return new PinLevel(n, "星摆", 16500).Add(PinLevels.P(13, 1.55).Clusters(4, 2, 0.28).Wobble(22, 2200).Swing(4600)); }
        if (n == 33) { return new PinLevel(n, "星弧", 17500).Add(PinLevels.P(13, 1.60).Ccw().Arc(8, 4.2).Flip(1500)); }
        if (n == 34) { return new PinLevel(n, "星潮", 12000).Add(PinLevels.P(13, 1.60).Even(6, 0.3).Wobble(26, 2000).Pulse(0.60, 1800)); }
        if (n == 35) { return new PinLevel(n, "星锁", 18000).Add(PinLevels.P(14, 1.65).Clusters(3, 3, 0.25).Flip(1600).Pulse(0.40, 2200)); }
        if (n == 36) { return new PinLevel(n, "星漂", 13500).Add(PinLevels.P(14, 1.70).Even(5, 0.5).Wobble(24, 2100).Swing(4400)); }
        if (n == 37) { return new PinLevel(n, "星河", 20000).Add(PinLevels.P(14, 1.70).Ccw().Clusters(5, 2, 0.27).Wobble(20, 2300).Flip(1500)); }
        if (n == 38) { return new PinLevel(n, "星爆", 19500).Add(PinLevels.P(15, 1.75).Even(6, 0.0).Pulse(0.60, 1600).Flip(1600)); }
        if (n == 39) { return new PinLevel(n, "星陨", 24000).Add(PinLevels.P(15, 1.80).Clusters(4, 3, 0.24).Wobble(28, 1900).Flip(1500).Pulse(0.45, 2100)); }
        return new PinLevel(n, "星环终章", 37000)
            .Add(PinLevels.P(10, 1.50).Even(4, 0.0).Pulse(0.55, 1800))
            .Add(PinLevels.P(11, 1.60).Ccw().Clusters(3, 2, 0.28).Wobble(24, 2000).Flip(1600))
            .Add(PinLevels.P(12, 1.70).Even(6, 0.3).Wobble(26, 2100).Pulse(0.50, 1700).Flip(1500));
    }
}
