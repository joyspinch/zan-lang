using System;
using Gui;
using Gui.Backend;
using Game.Kit;
using Game.Foundation;
using Game.Foundation.Gui;

namespace PinCircle;

public class PinView {
    const int Ink = 0xFF051C21;
    const int Jade = 0xFF69E4C4;
    const int Gold = 0xFFD9B77B;
    const int Paper = 0xFFF7EED6;
    const int Muted = 0xFF89ABA8;
    const int Danger = 0xFFFF8B76;
    int w = 600;
    int h = 900;
    int mx;
    int my;
    bool spaceHeld;
    double unit = 1;
    string backdrop;
    string rotor;
    string jade;
    string brass;
    string red;
    PinHud hud;
    PinShell shell;
    PinFx fx;

    PinView() {
        this.shell = new PinShell();
        this.fx = new PinFx();
        this.backdrop = Assets.Find("assets/backdrop.jpg");
        this.rotor = Assets.Find("assets/rotor.png");
        this.jade = Assets.Find("assets/jade.png");
        this.brass = Assets.Find("assets/brass.png");
        this.red = Assets.Find("assets/red.png");
    }

    void Sync(GuiHost host) {
        if (host.StageWidth() > 0 && host.StageHeight() > 0) {
            this.w = host.StageWidth();
            this.h = host.StageHeight();
        }
        this.unit = Math.Min(this.w / 600.0, this.h / 900.0);
        this.mx = host.MouseX();
        this.my = host.MouseY();
    }

    void Publish(PinWorld game, string scene) {
        if (!UiDriver.Active()) { return; }
        UiDriver.SetProbe("pin.scene", scene);
        UiDriver.SetProbe("pin.level", Convert.ToString(game.level));
        UiDriver.SetProbe("pin.inserted", Convert.ToString(game.inserted));
        UiDriver.SetProbe("pin.paused", game.paused ? "1" : "0");
        UiDriver.SetProbe("pin.elapsed", Convert.ToString(game.elapsedMs));
        UiDriver.SetProbe("pin.state", Convert.ToString((int)game.state));
        UiDriver.SetProbe("pin.muted", this.shell.Muted() ? "1" : "0");
        UiDriver.SetProbe("pin.best", Convert.ToString(this.shell.BestLevel()));
        UiDriver.SetProbe("pin.phase", Convert.ToString(game.phase));
        UiDriver.SetProbe("pin.stars", Convert.ToString(this.shell.TotalStars()));
    }

    int Dp(double value) { return (int)(value * this.unit); }
    int Gp(double value) { return this.Dp(value * 1.32); }
    int CenterX() { return this.w / 2; }
    int CenterY() { return this.h / 2 - this.Dp(84); }
    int ActionY() { return this.CenterY() + this.Gp(PinWorld.LaunchRadius); }
    int MenuActionY() { return this.h - this.Dp(196); }
    int ResultY() { return this.h / 2 - this.Dp(12); }

    static int Red(int color) { return (color >> 16) & 255; }
    static int Green(int color) { return (color >> 8) & 255; }
    static int Blue(int color) { return color & 255; }

    void Circle(Canvas c, int x, int y, int radius, int color, int alpha) {
        CDraw.FillCircle(c, x, y, radius, PinView.Red(color), PinView.Green(color), PinView.Blue(color), alpha);
    }
    void Ring(Canvas c, int x, int y, int radius, int width, int color, int alpha) {
        CDraw.CircleStroke(c, x, y, radius, width, PinView.Red(color), PinView.Green(color), PinView.Blue(color), alpha);
    }
    void Line(Canvas c, int x1, int y1, int x2, int y2, int width, int color, int alpha) {
        CDraw.Line(c, x1, y1, x2, y2, width, PinView.Red(color), PinView.Green(color), PinView.Blue(color), alpha);
    }
    void ImageCentered(Canvas c, string path, int cx, int cy, int size) {
        CDraw.BlitImage(c, path, cx - size / 2, cy - size / 2, size, size);
    }

    void DrawBackground(Canvas c) {
        CDraw.Clear(c, this.w, this.h, PinView.Ink);
        CDraw.BlitImage(c, this.backdrop, 0, 0, this.w, this.h);
    }

    void Arc(Canvas c, int cx, int cy, double radius, double start, double span, int color, int alpha) {
        int steps = (int)Math.Max(2, Math.Abs(span) * radius / 8);
        for (int i = 0; i < steps; i = i + 1) {
            double a = start + span * i / steps;
            double b = start + span * (i + 1) / steps;
            this.Line(c, cx + this.Dp(Math.Cos(a) * radius), cy + this.Dp(Math.Sin(a) * radius),
                cx + this.Dp(Math.Cos(b) * radius), cy + this.Dp(Math.Sin(b) * radius), this.Dp(2), color, alpha);
        }
    }

    void Orb(Canvas c, int x, int y, bool preset, bool failed) {
        this.ImageCentered(c, failed ? this.red : (preset ? this.brass : this.jade), x, y,
            this.Gp(PinWorld.HeadRadius * 3.76));
    }

    void Needle(Canvas c, int cx, int cy, double angle, double radius, bool preset, bool failed) {
        double dx = Math.Cos(angle);
        double dy = Math.Sin(angle);
        int hx = cx + this.Gp(dx * radius);
        int hy = cy + this.Gp(dy * radius);
        int tx = cx + this.Gp(dx * (radius - PinWorld.ShaftLength));
        int ty = cy + this.Gp(dy * (radius - PinWorld.ShaftLength));
        int color = failed ? PinView.Danger : (preset ? PinView.Gold : PinView.Jade);
        this.Line(c, tx + this.Dp(2), ty + this.Dp(3), hx + this.Dp(2), hy + this.Dp(3), this.Gp(4), PinView.Ink, 160);
        this.Line(c, tx, ty, hx, hy, this.Gp(PinWorld.ShaftWidth), color, 255);
        this.Line(c, tx, ty, hx, hy, this.Dp(1), PinView.Paper, preset ? 112 : 160);
        this.Orb(c, hx, hy, preset, failed);
    }

    // Translucent needle for fly-outs and grow-ins (bitmaps have no alpha
    // control, so the head is painted as a lit sphere instead).
    void GhostNeedle(Canvas c, int cx, int cy, double angle, double radius, double length, int color, int alpha) {
        double dx = Math.Cos(angle);
        double dy = Math.Sin(angle);
        int hx = cx + this.Gp(dx * radius);
        int hy = cy + this.Gp(dy * radius);
        int tx = cx + this.Gp(dx * (radius - length));
        int ty = cy + this.Gp(dy * (radius - length));
        this.Line(c, tx, ty, hx, hy, this.Gp(PinWorld.ShaftWidth), color, alpha);
        int r = this.Gp(PinWorld.HeadRadius);
        this.Circle(c, hx, hy + this.Dp(2), r, PinView.Ink, alpha / 2);
        this.Circle(c, hx, hy, r, color, alpha);
        this.Circle(c, hx - r / 3, hy - r / 3, r / 3, PinView.Paper, alpha * 2 / 3);
    }

    void Halo(Canvas c, int cx, int cy, double rotation, bool warn, int timeMs) {
        this.Ring(c, cx, cy, this.Gp(170), this.Dp(1), PinView.Gold, 46);
        this.Ring(c, cx, cy, this.Gp(178), this.Dp(1), PinView.Jade, 26);
        for (int i = 0; i < 60; i = i + 1) {
            double a = i * PinWorld.Tau / 60.0;
            double inner = i % 5 == 0 ? 170 : 174;
            this.Line(c, cx + this.Gp(Math.Cos(a) * inner), cy + this.Gp(Math.Sin(a) * inner),
                cx + this.Gp(Math.Cos(a) * 178), cy + this.Gp(Math.Sin(a) * 178),
                this.Dp(1), PinView.Gold, i % 5 == 0 ? 136 : 48);
        }
        // Reversal telegraph: the orbit arcs blink red just before a sudden flip.
        bool blink = warn && (timeMs / 90) % 2 == 0;
        this.Arc(c, cx, cy, 244, rotation - 0.6, 0.45, blink ? PinView.Danger : PinView.Jade, blink ? 230 : 120);
        this.Arc(c, cx, cy, 244, rotation + 2.54, 0.45, blink ? PinView.Danger : PinView.Gold, blink ? 230 : 96);
        if (warn) {
            this.Ring(c, cx, cy, this.Gp(178), this.Dp(2), PinView.Danger, blink ? 120 : 40);
        }
    }

    // Boss rotors wear one brass ring per remaining phase; each shatters in turn.
    void Rotor(Canvas c, int cx, int cy, double rotation, double scale, int rings) {
        this.Circle(c, cx, cy + this.Dp(7), this.Gp((PinWorld.DiskRadius + 5) * scale), PinView.Ink, 128);
        for (int k = rings; k >= 1; k = k - 1) {
            int rr = this.Gp((PinWorld.DiskRadius + 3 + 7 * k) * scale);
            this.Ring(c, cx, cy, rr, this.Gp(4), PinView.Ink, 150);
            this.Ring(c, cx, cy, rr, this.Gp(3), k == 1 ? PinView.Gold : PinView.Danger, 220);
            for (int i = 0; i < 6; i = i + 1) {
                double a = rotation * (k % 2 == 0 ? -0.5 : 0.5) + i * PinWorld.Tau / 6.0;
                this.Circle(c, cx + (int)(Math.Cos(a) * rr), cy + (int)(Math.Sin(a) * rr), this.Gp(2.4), PinView.Paper, 200);
            }
        }
        this.ImageCentered(c, this.rotor, cx, cy, this.Gp(PinWorld.DiskRadius * 2 * scale));
        double a0 = rotation - PinWorld.Down;
        this.Circle(c, cx + this.Gp(Math.Cos(a0) * 49 * scale), cy + this.Gp(Math.Sin(a0) * 49 * scale), this.Dp(3), PinView.Jade, 255);
    }

    void Impact(Canvas c, PinWorld game, int cx, int cy) {
        PinFx fx = this.fx;
        if (fx.ringMs <= 0) { return; }
        double t = 1 - fx.ringMs / 280.0;
        if (t < 0) { t = 0; }
        double ease = Easing.Evaluate(EaseType.CubicOut, t);
        int alpha = (int)((1 - t) * 220);
        this.Ring(c, cx, cy, this.Gp(PinWorld.DiskRadius + 4 + ease * 34), this.Dp(2), PinView.Jade, alpha);
        this.Ring(c, cx, cy, this.Gp(PinWorld.DiskRadius + 2 + ease * 18), this.Dp(1), PinView.Gold, alpha);
    }

    void Sparks(Canvas c, int cx, int cy) {
        List<Spark> list = this.fx.sparks;
        for (int i = 0; i < list.Count; i = i + 1) {
            Spark s = list[i];
            int alpha = (int)(255.0 * s.life / s.max);
            int x = cx + this.Gp(s.x);
            int y = cy + this.Gp(s.y);
            this.Line(c, x, y, x - this.Gp(s.vx * 0.018), y - this.Gp(s.vy * 0.018), this.Dp(s.size), s.color, alpha * 2 / 3);
            this.Circle(c, x, y, this.Dp(s.size), s.color, alpha);
        }
    }

    // Wobbling rotors show their travel with two brass brackets on the axis.
    void SwayGuides(Canvas c, PinWorld game, int cx, int cy) {
        double amp = game.Phase().wobblePx;
        if (amp <= 0) { return; }
        int reach = this.Gp(amp + PinWorld.DiskRadius + 12);
        for (int side = -1; side <= 1; side = side + 2) {
            int x = cx + side * reach;
            this.Line(c, x, cy - this.Dp(16), x, cy + this.Dp(16), this.Dp(2), PinView.Gold, 150);
            this.Line(c, x, cy - this.Dp(16), x - side * this.Dp(7), cy - this.Dp(16), this.Dp(2), PinView.Gold, 150);
            this.Line(c, x, cy + this.Dp(16), x - side * this.Dp(7), cy + this.Dp(16), this.Dp(2), PinView.Gold, 150);
        }
        this.Line(c, cx - reach, cy, cx + reach, cy, this.Dp(1), PinView.Gold, 40);
    }

    void Play(Canvas c, PinWorld game) {
        this.DrawBackground(c);
        PinFx fx = this.fx;
        int cx = this.CenterX() + this.Dp(fx.ShakeX());
        int cy = this.CenterY() + this.Dp(fx.ShakeY());
        double rotation = game.rotation + fx.extraRotation;
        int rx = cx + this.Gp(game.wobble);
        int ry = cy + this.Gp(fx.recoilY);
        this.Halo(c, cx, cy, rotation, game.FlipWarning() && !game.paused, fx.clock);
        this.SwayGuides(c, game, cx, cy);
        this.Impact(c, game, rx, ry);
        // Boss ring burst: the previous ring's pins fly off and fade.
        if (fx.burstMs > 0) {
            double t = Math.Min(1.0, fx.burstMs / 900.0);
            double reach = PinWorld.PinRadius + Easing.Evaluate(EaseType.CubicOut, t) * 260;
            int bx = cx + this.Gp(fx.burstWobble);
            for (int i = 0; i < fx.burstAngles.Count; i = i + 1) {
                double a = fx.burstAngles[i] + fx.burstRotation + t * (i % 2 == 0 ? 0.6 : -0.6);
                this.GhostNeedle(c, bx, cy, a, reach, PinWorld.ShaftLength * (1 - t * 0.5),
                    fx.burstPreset[i] ? PinView.Gold : PinView.Jade, (int)(230 * (1 - t)));
            }
        }
        double grow = game.Armed() ? 1.0 : Easing.Evaluate(EaseType.CubicOut, 1.0 - game.interludeMs / (double)PinWorld.InterludeMs);
        double fly = fx.FlyOut();
        for (int i = 0; i < game.pins.Count; i = i + 1) {
            Pin p = game.pins[i];
            double a = p.angle + rotation;
            if (fly > 0) {
                double reach = PinWorld.PinRadius + fly * fly * 300;
                this.GhostNeedle(c, rx, ry, a, reach, PinWorld.ShaftLength, p.preset ? PinView.Gold : PinView.Jade, (int)(255 * (1 - fly)));
            } else if (grow < 1.0) {
                double r = PinWorld.DiskRadius + (PinWorld.PinRadius - PinWorld.DiskRadius) * grow;
                this.GhostNeedle(c, rx, ry, a, r, (r - PinWorld.DiskRadius) * 0.98, p.preset ? PinView.Gold : PinView.Jade, (int)(80 + 175 * grow));
            } else {
                this.Needle(c, rx, ry, a, PinWorld.PinRadius, p.preset, false);
                // Clear flourish: a glint runs round the pins before they fly.
                if (fx.clearing && fx.clearMs < 640 && i * 50 <= fx.clearMs && fx.clearMs < i * 50 + 160) {
                    int hx = rx + this.Gp(Math.Cos(a) * PinWorld.PinRadius);
                    int hy = ry + this.Gp(Math.Sin(a) * PinWorld.PinRadius);
                    this.Circle(c, hx, hy, this.Gp(14), PinView.Paper, 90);
                    this.Ring(c, hx, hy, this.Gp(17), this.Dp(2), PinView.Gold, 200);
                }
            }
        }
        if (game.state == RoundState.Playing) {
            int ly = this.ActionY();
            this.Ring(c, this.CenterX(), ly, this.Dp(27), this.Dp(1), PinView.Gold, 90);
            this.Ring(c, this.CenterX(), ly, this.Dp(32), this.Dp(1), PinView.Jade, 50);
            if (game.flying) {
                int fy = cy + this.Gp(game.shotRadius);
                this.Line(c, cx, fy + this.Dp(16), cx, fy + this.Dp(44), this.Dp(5), PinView.Jade, 54);
                this.Line(c, cx, fy + this.Dp(16), cx, fy + this.Dp(30), this.Dp(3), PinView.Paper, 70);
                this.Needle(c, cx, cy, PinWorld.Down, game.shotRadius, false, false);
            } else if (game.Armed()) {
                this.Needle(c, cx, cy, PinWorld.Down, PinWorld.LaunchRadius, false, false);
            } else {
                // Reloading between boss rings: a gold arc fills around the launcher.
                double k = 1.0 - game.interludeMs / (double)PinWorld.InterludeMs;
                this.Arc(c, this.CenterX(), ly, 22, -PinWorld.Down, PinWorld.Tau * k, PinView.Gold, 220);
            }
        } else if (fx.failing) {
            // The deflected needle tumbles away in slow motion.
            double a = PinWorld.Down + fx.needleAngle;
            int hx = cx + this.Gp(fx.needleX);
            int hy = cy + this.Gp(fx.needleY);
            this.Line(c, hx, hy, hx - this.Gp(Math.Cos(a) * PinWorld.ShaftLength), hy - this.Gp(Math.Sin(a) * PinWorld.ShaftLength),
                this.Gp(PinWorld.ShaftWidth), PinView.Danger, 255);
            this.Orb(c, hx, hy, false, true);
        }
        int rings = game.PhaseCount() - game.phase - 1;
        if (game.state == RoundState.Cleared) { rings = 0; }
        double pulse = fx.ringMs > 0 ? 1.0 + 0.07 * Math.Sin(fx.ringMs / 280.0 * 3.14159) : 1.0;
        this.Rotor(c, rx, ry, rotation, pulse, rings);
        this.Sparks(c, cx, cy);
        if (fx.flashMs > 0) {
            int alpha = fx.flashMs * 90 / 420;
            CDraw.FillVGrad(c, 0, 0, this.w, this.h / 5, CDraw.Argb(alpha, 255, 90, 70), CDraw.Argb(0, 255, 90, 70));
            CDraw.FillVGrad(c, 0, this.h * 4 / 5, this.w, this.h / 5, CDraw.Argb(0, 255, 90, 70), CDraw.Argb(alpha, 255, 90, 70));
        }
    }

    void Menu(Canvas c, double timeMs, PinWorld game) {
        this.DrawBackground(c);
        int cx = this.CenterX();
        int cy = this.CenterY() + this.Dp(36);
        double rotation = timeMs / 3200.0;
        this.Halo(c, cx, cy, rotation, false, 0);
        for (int i = 0; i < 9; i = i + 1) {
            this.Needle(c, cx, cy, i * PinWorld.Tau / 9.0 + rotation, PinWorld.PinRadius, i % 3 != 0, false);
        }
        this.Rotor(c, cx, cy, rotation, 1.0, 0);
        double breathe = Math.Sin(timeMs / 800.0) * 0.5 + 0.5;
        this.Ring(c, cx, this.MenuActionY(), this.Dp(54 + breathe * 4), this.Dp(1), PinView.Jade, (int)(30 + breathe * 40));
    }

    // Level select: the dial idles behind the grid as a slow brass orrery.
    void SelectBackdrop(Canvas c, int timeMs) {
        this.DrawBackground(c);
        int cx = this.CenterX();
        int cy = this.h / 2;
        double rotation = timeMs / 5200.0;
        this.Ring(c, cx, cy, this.Gp(250), this.Dp(1), PinView.Gold, 34);
        this.Ring(c, cx, cy, this.Gp(300), this.Dp(1), PinView.Jade, 22);
        this.Arc(c, cx, cy, 250, rotation, 0.8, PinView.Gold, 70);
        this.Arc(c, cx, cy, 300, -rotation * 0.7 + 2.0, 0.6, PinView.Jade, 60);
    }

    void Result(Canvas c, PinWorld game, bool paused, int timeMs) {
        this.Play(c, game);
        int cx = this.CenterX();
        int ry = this.ResultY();
        bool won = game.state == RoundState.Cleared;
        if (won && !paused) {
            for (int i = 0; i < 16; i = i + 1) {
                double a = i * PinWorld.Tau / 16.0 + timeMs / 3200.0;
                int x = cx + this.Dp(Math.Cos(a) * (222 + i % 3 * 12));
                int sy = ry + this.Dp(Math.Sin(a) * 250);
                this.Circle(c, x, sy, this.Dp(i % 3 == 0 ? 3 : 2), i % 2 == 0 ? PinView.Gold : PinView.Jade, 150);
            }
        }
    }
    void EnterHud(SceneRouter router, HtmlScene scene, PinWorld game, string mode) {
        if (this.hud == null) { this.hud = new PinHud(game, this, router.Host().App()); }
        this.hud.Enter(router, scene, mode);
    }
    void ToggleMute() {
        this.shell.ToggleMute();
        if (this.hud != null) { this.hud.Sync(this.hud.animationMs); }
    }
    void ExitHud() { if (this.hud != null) { this.hud.Exit(); } }
    void SyncHud(int timeMs) { if (this.hud != null) { this.hud.Sync(timeMs); } }
    void RenderHud(App app) { if (this.hud != null) { this.hud.Render(app); } }

}
