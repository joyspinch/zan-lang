using System;
using Gui;
using Gui.Backend;
using Game.Kit;
using Game.Foundation;
using Game.Foundation.Gui;

namespace PinCircle;

public class PinView {
    const int Ink = 0xFF051C21;
    const int Jade = 0xFF69E4C4;
    const int Gold = 0xFFD9B77B;
    const int Paper = 0xFFF7EED6;
    const int Muted = 0xFF89ABA8;
    const int Danger = 0xFFFF8B76;
    int w = 600;
    int h = 900;
    int mx;
    int my;
    bool spaceHeld;
    double unit = 1;
    string backdrop;
    string rotor;
    string jade;
    string brass;
    string red;
    string title;

    PinView() {
        this.backdrop = Assets.Find("assets/backdrop.jpg");
        this.rotor = Assets.Find("assets/rotor.png");
        this.jade = Assets.Find("assets/jade.png");
        this.brass = Assets.Find("assets/brass.png");
        this.red = Assets.Find("assets/red.png");
        this.title = Assets.Find("assets/title.png");
    }

    void Sync(GuiHost host) {
        if (host.StageWidth() > 0 && host.StageHeight() > 0) {
            this.w = host.StageWidth();
            this.h = host.StageHeight();
        }
        this.unit = Math.Min(this.w / 600.0, this.h / 900.0);
        this.mx = host.MouseX();
        this.my = host.MouseY();
    }

    void Publish(PinWorld game, string scene) {
        if (!UiDriver.Active()) { return; }
        UiDriver.SetProbe("pin.scene", scene);
        UiDriver.SetProbe("pin.level", Convert.ToString(game.level));
        UiDriver.SetProbe("pin.inserted", Convert.ToString(game.inserted));
        UiDriver.SetProbe("pin.paused", game.paused ? "1" : "0");
        UiDriver.SetProbe("pin.elapsed", Convert.ToString(game.elapsedMs));
        UiDriver.SetProbe("pin.state", Convert.ToString((int)game.state));
    }

    int Dp(double value) { return (int)(value * this.unit); }
    int Gp(double value) { return this.Dp(value * 1.32); }
    int CenterX() { return this.w / 2; }
    int CenterY() { return this.h / 2 - this.Dp(84); }
    int ActionY() { return this.CenterY() + this.Gp(PinWorld.LaunchRadius); }
    int MenuActionY() { return this.h - this.Dp(196); }
    int ResultY() { return this.h / 2 - this.Dp(12); }

    bool InCircle(int x, int y, int r) {
        int dx = this.mx - x;
        int dy = this.my - y;
        return dx * dx + dy * dy <= r * r;
    }

    bool HomeHit() { return this.InCircle(this.Dp(44), this.Dp(48), this.Dp(24)); }
    bool PauseHit() { return this.InCircle(this.w - this.Dp(44), this.Dp(48), this.Dp(24)); }
    bool MenuStartHit() { return this.InCircle(this.CenterX(), this.MenuActionY(), this.Dp(52)); }
    bool ActionHit() { return this.InCircle(this.CenterX(), this.ActionY(), this.Dp(36)); }
    bool ResultHit() { return this.InCircle(this.CenterX(), this.ResultY() + this.Dp(80), this.Dp(44)); }
    bool ResultMenuHit() {
        return CDraw.PointIn(this.mx, this.my, this.CenterX() - this.Dp(76),
            this.ResultY() + this.Dp(182), this.Dp(152), this.Dp(48));
    }

    static int Red(int color) { return (color >> 16) & 255; }
    static int Green(int color) { return (color >> 8) & 255; }
    static int Blue(int color) { return color & 255; }

    void Circle(Canvas c, int x, int y, int radius, int color, int alpha) {
        CDraw.FillCircle(c, x, y, radius, PinView.Red(color), PinView.Green(color), PinView.Blue(color), alpha);
    }
    void Ring(Canvas c, int x, int y, int radius, int width, int color, int alpha) {
        CDraw.CircleStroke(c, x, y, radius, width, PinView.Red(color), PinView.Green(color), PinView.Blue(color), alpha);
    }
    void Line(Canvas c, int x1, int y1, int x2, int y2, int width, int color, int alpha) {
        CDraw.Line(c, x1, y1, x2, y2, width, PinView.Red(color), PinView.Green(color), PinView.Blue(color), alpha);
    }
    void Text(Canvas c, string text, int centerX, int y, int scale, int color) {
        CText.DrawCentered(c, text, centerX, y, scale, PinView.Red(color), PinView.Green(color), PinView.Blue(color), 255);
    }
    void ImageCentered(Canvas c, string path, int cx, int cy, int size) {
        CDraw.BlitImage(c, path, cx - size / 2, cy - size / 2, size, size);
    }

    void DrawBackground(Canvas c) {
        CDraw.Clear(c, this.w, this.h, PinView.Ink);
        CDraw.BlitImage(c, this.backdrop, 0, 0, this.w, this.h);
    }

    void Arc(Canvas c, int cx, int cy, double radius, double start, double span, int color, int alpha) {
        int steps = (int)Math.Max(2, Math.Abs(span) * radius / 8);
        for (int i = 0; i < steps; i = i + 1) {
            double a = start + span * i / steps;
            double b = start + span * (i + 1) / steps;
            this.Line(c, cx + this.Dp(Math.Cos(a) * radius), cy + this.Dp(Math.Sin(a) * radius),
                cx + this.Dp(Math.Cos(b) * radius), cy + this.Dp(Math.Sin(b) * radius), this.Dp(2), color, alpha);
        }
    }

    void Orb(Canvas c, int x, int y, bool preset, bool failed) {
        this.ImageCentered(c, failed ? this.red : (preset ? this.brass : this.jade), x, y,
            this.Gp(PinWorld.HeadRadius * 3.76));
    }

    void Needle(Canvas c, int cx, int cy, double angle, double radius, bool preset, bool failed) {
        double dx = Math.Cos(angle);
        double dy = Math.Sin(angle);
        int hx = cx + this.Gp(dx * radius);
        int hy = cy + this.Gp(dy * radius);
        int tx = cx + this.Gp(dx * (radius - PinWorld.ShaftLength));
        int ty = cy + this.Gp(dy * (radius - PinWorld.ShaftLength));
        int color = failed ? PinView.Danger : (preset ? PinView.Gold : PinView.Jade);
        this.Line(c, tx + this.Dp(2), ty + this.Dp(3), hx + this.Dp(2), hy + this.Dp(3), this.Gp(4), PinView.Ink, 160);
        this.Line(c, tx, ty, hx, hy, this.Gp(PinWorld.ShaftWidth), color, 255);
        this.Line(c, tx, ty, hx, hy, this.Dp(1), PinView.Paper, preset ? 112 : 160);
        this.Orb(c, hx, hy, preset, failed);
    }

    void Halo(Canvas c, int cx, int cy, double rotation) {
        this.Ring(c, cx, cy, this.Gp(170), this.Dp(1), PinView.Gold, 46);
        this.Ring(c, cx, cy, this.Gp(178), this.Dp(1), PinView.Jade, 26);
        for (int i = 0; i < 60; i = i + 1) {
            double a = i * PinWorld.Tau / 60.0;
            double inner = i % 5 == 0 ? 170 : 174;
            this.Line(c, cx + this.Gp(Math.Cos(a) * inner), cy + this.Gp(Math.Sin(a) * inner),
                cx + this.Gp(Math.Cos(a) * 178), cy + this.Gp(Math.Sin(a) * 178),
                this.Dp(1), PinView.Gold, i % 5 == 0 ? 136 : 48);
        }
        this.Arc(c, cx, cy, 244, rotation - 0.6, 0.45, PinView.Jade, 120);
        this.Arc(c, cx, cy, 244, rotation + 2.54, 0.45, PinView.Gold, 96);
    }

    void Rotor(Canvas c, int cx, int cy, string value, string label, double rotation) {
        this.Circle(c, cx, cy + this.Dp(7), this.Gp(PinWorld.DiskRadius + 5), PinView.Ink, 128);
        this.ImageCentered(c, this.rotor, cx, cy, this.Gp(PinWorld.DiskRadius * 2));
        double a = rotation - PinWorld.Down;
        this.Circle(c, cx + this.Gp(Math.Cos(a) * 49), cy + this.Gp(Math.Sin(a) * 49), this.Dp(3), PinView.Jade, 255);
        this.Text(c, value, cx, cy - this.Dp(34), 6, PinView.Paper);
        this.Text(c, label, cx, cy + this.Dp(30), 2, PinView.Gold);
    }

    void PlayGlyph(Canvas c, int x, int y) {
        for (int i = 0; i < 16; i = i + 1) {
            int half = this.Dp(16 - i);
            this.Line(c, x - this.Dp(8) + this.Dp(i), y - half,
                x - this.Dp(8) + this.Dp(i), y + half, this.Dp(1), PinView.Paper, 255);
        }
    }

    void Seal(Canvas c, int x, int y, bool hover, bool retry) {
        double expand = hover ? 1.05 : 1;
        this.Circle(c, x, y, this.Dp(44 * expand), PinView.Jade, hover ? 24 : 12);
        this.ImageCentered(c, this.rotor, x, y, this.Dp(84 * expand));
        this.Ring(c, x, y, this.Dp(47 * expand), this.Dp(1), PinView.Gold, hover ? 180 : 90);
        if (!retry) { this.PlayGlyph(c, x, y); return; }
        this.Arc(c, x, y, 15, -2.4, 4.8, PinView.Paper, 255);
        this.Line(c, x - this.Dp(11), y - this.Dp(10), x - this.Dp(14), y + this.Dp(1), this.Dp(2), PinView.Paper, 255);
        this.Line(c, x - this.Dp(14), y + this.Dp(1), x - this.Dp(3), y - this.Dp(1), this.Dp(2), PinView.Paper, 255);
    }

    void TopControls(Canvas c) {
        int y = this.Dp(48);
        int left = this.Dp(44);
        int right = this.w - this.Dp(44);
        this.Ring(c, left, y, this.Dp(23), this.Dp(1), PinView.Gold, this.HomeHit() ? 180 : 72);
        this.Line(c, left - this.Dp(7), y, left + this.Dp(8), y, this.Dp(2), PinView.Paper, 230);
        this.Line(c, left - this.Dp(7), y, left, y - this.Dp(7), this.Dp(2), PinView.Paper, 230);
        this.Line(c, left - this.Dp(7), y, left, y + this.Dp(7), this.Dp(2), PinView.Paper, 230);
        this.Ring(c, right, y, this.Dp(23), this.Dp(1), PinView.Gold, this.PauseHit() ? 180 : 72);
        this.Line(c, right - this.Dp(4), y - this.Dp(7), right - this.Dp(4), y + this.Dp(7), this.Dp(2), PinView.Paper, 230);
        this.Line(c, right + this.Dp(4), y - this.Dp(7), right + this.Dp(4), y + this.Dp(7), this.Dp(2), PinView.Paper, 230);
    }

    void Impact(Canvas c, PinWorld game, int cx, int cy) {
        if (game.pulseMs <= 0) { return; }
        bool failed = game.state == RoundState.Failed;
        double t = 1 - game.pulseMs / (failed ? 400.0 : 240.0);
        double ease = Easing.Evaluate(EaseType.CubicOut, t);
        int alpha = (int)((1 - t) * 220);
        int color = failed ? PinView.Danger : PinView.Jade;
        this.Ring(c, cx, cy, this.Gp(PinWorld.DiskRadius + 4 + ease * 30), this.Dp(2), color, alpha);
        int sx = cx;
        int sy = cy + this.Gp(game.shotRadius);
        if (!failed && game.pins.Count > 0) {
            double a = game.pins[game.pins.Count - 1].angle + game.rotation;
            sx = cx + this.Gp(Math.Cos(a) * PinWorld.PinRadius);
            sy = cy + this.Gp(Math.Sin(a) * PinWorld.PinRadius);
        }
        for (int i = 0; i < 10; i = i + 1) {
            double a = i * PinWorld.Tau / 10.0 + 0.2;
            double dist = 12 + ease * 34;
            this.Line(c, sx + this.Dp(Math.Cos(a) * dist), sy + this.Dp(Math.Sin(a) * dist),
                sx + this.Dp(Math.Cos(a) * (dist + 5)), sy + this.Dp(Math.Sin(a) * (dist + 5)), this.Dp(2), color, alpha);
        }
    }

    void Play(Canvas c, PinWorld game, bool controls) {
        this.DrawBackground(c);
        int cx = this.CenterX();
        int cy = this.CenterY();
        if (game.state == RoundState.Failed && game.pulseMs > 0) {
            cx = cx + this.Dp(Math.Sin(game.pulseMs / 22.0) * 5 * game.pulseMs / 400.0);
        }
        if (controls) { this.TopControls(c); }
        this.Text(c, "星 环 机 关", this.CenterX(), this.Dp(22), 2, PinView.Gold);
        this.Text(c, "第 " + game.level + " 关", this.CenterX(), this.Dp(56), 3, PinView.Paper);
        int gap = this.Dp(16);
        for (int i = 0; i < game.target; i = i + 1) {
            this.Circle(c, this.CenterX() + (i * 2 - game.target + 1) * gap / 2, this.Dp(112),
                this.Dp(3), i < game.inserted ? PinView.Jade : PinView.Gold, i < game.inserted ? 255 : 70);
        }
        this.Halo(c, cx, cy, game.rotation);
        this.Impact(c, game, cx, cy);
        for (int i = 0; i < game.pins.Count; i = i + 1) {
            Pin p = game.pins[i];
            this.Needle(c, cx, cy, p.angle + game.rotation, PinWorld.PinRadius, p.preset, false);
        }
        if (game.state == RoundState.Playing || game.flying) {
            int ly = this.ActionY();
            this.Ring(c, this.CenterX(), ly, this.Dp(27), this.Dp(1), PinView.Gold, this.ActionHit() ? 220 : 90);
            this.Ring(c, this.CenterX(), ly, this.Dp(32), this.Dp(1), PinView.Jade, 50);
            if (game.flying) {
                int fy = cy + this.Gp(game.shotRadius);
                this.Line(c, cx, fy + this.Dp(16), cx, fy + this.Dp(38), this.Dp(4), PinView.Jade, 64);
            }
            this.Needle(c, cx, cy, PinWorld.Down, game.flying ? game.shotRadius : PinWorld.LaunchRadius,
                false, game.state == RoundState.Failed);
        }
        this.Rotor(c, cx, cy, Convert.ToString(game.Remaining()), "待 发 射", game.rotation);
        int py = cy + this.Gp(204);
        this.Text(c, game.PatternName(), this.CenterX(), py, 2, PinView.Muted);
        this.Line(c, this.CenterX() - this.Dp(104), py + this.Dp(12), this.CenterX() - this.Dp(68), py + this.Dp(12), this.Dp(1), PinView.Gold, 90);
        this.Line(c, this.CenterX() + this.Dp(68), py + this.Dp(12), this.CenterX() + this.Dp(104), py + this.Dp(12), this.Dp(1), PinView.Gold, 90);
        if (controls) {
            this.Text(c, "轻触发射", this.CenterX(), this.ActionY() + this.Dp(44), 3, PinView.Paper);
            this.Text(c, "点击空白处或按空格  ·  避开针球与针杆", this.CenterX(), this.h - this.Dp(28), 2, PinView.Muted);
        }
    }

    void Menu(Canvas c, double timeMs, PinWorld game) {
        this.DrawBackground(c);
        int cx = this.CenterX();
        int cy = this.CenterY() + this.Dp(36);
        this.Text(c, "O R B I T   /   P R E C I S I O N", cx, this.Dp(40), 2, PinView.Gold);
        CDraw.BlitImage(c, this.title, cx - this.Dp(240), this.Dp(80), this.Dp(480), this.Dp(90));
        this.Text(c, "一 瞬 之 间  ·  恰 好 入 隙", cx, this.Dp(172), 2, PinView.Muted);
        double rotation = timeMs / 3200.0;
        this.Halo(c, cx, cy, rotation);
        for (int i = 0; i < 9; i = i + 1) {
            this.Needle(c, cx, cy, i * PinWorld.Tau / 9.0 + rotation, PinWorld.PinRadius, i % 3 != 0, false);
        }
        this.Rotor(c, cx, cy, "01", "入 隙", rotation);
        double breathe = Math.Sin(timeMs / 800.0) * 0.5 + 0.5;
        this.Ring(c, cx, this.MenuActionY(), this.Dp(54 + breathe * 4), this.Dp(1), PinView.Jade, (int)(30 + breathe * 40));
        this.Seal(c, cx, this.MenuActionY(), this.MenuStartHit(), false);
        this.Text(c, "开 始 挑 战", cx, this.MenuActionY() + this.Dp(64), 3, PinView.Paper);
        this.Text(c, "点击发射  ·  针针入隙  ·  步步进阶", cx, this.h - this.Dp(78), 2, PinView.Muted);
        this.Text(c, "本次最高   " + game.bestLevel + "   关", cx, this.h - this.Dp(40), 2, PinView.Gold);
    }

    void Result(Canvas c, PinWorld game, bool paused, int timeMs) {
        this.Play(c, game, false);
        CDraw.FillRect(c, 0, 0, this.w, this.h, CDraw.Argb(205, 1, 16, 20));
        int cx = this.CenterX();
        int ry = this.ResultY();
        double entry = Easing.Evaluate(EaseType.CubicOut, Math.Min(1, timeMs / 300.0));
        int y = ry - this.Dp(230) + this.Dp((1 - entry) * 16);
        int pw = this.Dp(400);
        int ph = this.Dp(480);
        CDraw.RoundRectFill(c, cx - pw / 2 + this.Dp(5), y + this.Dp(8), pw, ph, this.Dp(28), 0, 0, 0, 90);
        CDraw.RoundRectFill(c, cx - pw / 2, y, pw, ph, this.Dp(28), 115, 93, 55, 255);
        CDraw.RoundRectFill(c, cx - pw / 2 + this.Dp(1), y + this.Dp(1), pw - this.Dp(2), ph - this.Dp(2), this.Dp(27), 5, 29, 33, 255);
        CDraw.RoundRectFill(c, cx - pw / 2 + this.Dp(8), y + this.Dp(8), pw - this.Dp(16), ph - this.Dp(16), this.Dp(22), 65, 66, 47, 255);
        CDraw.RoundRectFill(c, cx - pw / 2 + this.Dp(9), y + this.Dp(9), pw - this.Dp(18), ph - this.Dp(18), this.Dp(21), 5, 29, 33, 255);
        bool won = game.state == RoundState.Cleared;
        int color = paused ? PinView.Gold : (won ? PinView.Jade : PinView.Danger);
        this.Text(c, paused ? "TAKE A BREATH" : (won ? "PERFECT TIMING" : "ONE MORE TRY"), cx, y + this.Dp(32), 2, PinView.Gold);
        int medY = y + this.Dp(104);
        this.Ring(c, cx, medY, this.Dp(30), this.Dp(1), color, 160);
        if (paused) {
            this.Line(c, cx - this.Dp(6), medY - this.Dp(11), cx - this.Dp(6), medY + this.Dp(11), this.Dp(3), color, 255);
            this.Line(c, cx + this.Dp(6), medY - this.Dp(11), cx + this.Dp(6), medY + this.Dp(11), this.Dp(3), color, 255);
        } else if (won) {
            this.Line(c, cx - this.Dp(13), medY, cx - this.Dp(3), medY + this.Dp(9), this.Dp(3), color, 255);
            this.Line(c, cx - this.Dp(3), medY + this.Dp(9), cx + this.Dp(15), medY - this.Dp(10), this.Dp(3), color, 255);
        } else {
            this.Line(c, cx, medY - this.Dp(12), cx, medY + this.Dp(3), this.Dp(3), color, 255);
            this.Circle(c, cx, medY + this.Dp(12), this.Dp(2), color, 255);
        }
        this.Text(c, paused ? "蓄 势 待 发" : (won ? "针 针 入 隙" : "再 差 一 瞬"), cx, y + this.Dp(160), 4, PinView.Paper);
        this.Text(c, "第 " + game.level + " 关   /   已入隙 " + game.inserted + " · " + game.target, cx, y + this.Dp(220), 2, PinView.Muted);
        this.Seal(c, cx, ry + this.Dp(80), this.ResultHit(), !paused && !won);
        this.Text(c, paused ? "继续挑战" : (won ? "开启下一关" : "重试本关"), cx, ry + this.Dp(138), 3, PinView.Paper);
        this.Text(c, "返回主菜单", cx, ry + this.Dp(194), 2, this.ResultMenuHit() ? PinView.Paper : PinView.Muted);
        this.Line(c, cx - this.Dp(56), ry + this.Dp(224), cx + this.Dp(56), ry + this.Dp(224), this.Dp(1), PinView.Gold, 64);
        this.Text(c, paused ? "P / 空格继续  ·  Esc 返回" : "Enter / 空格继续  ·  Esc 返回", cx, this.h - this.Dp(44), 2, PinView.Muted);
        if (won && !paused) {
            for (int i = 0; i < 16; i = i + 1) {
                double a = i * PinWorld.Tau / 16.0 + timeMs / 3200.0;
                int x = cx + this.Dp(Math.Cos(a) * (222 + i % 3 * 12));
                int sy = ry + this.Dp(Math.Sin(a) * 250);
                this.Circle(c, x, sy, this.Dp(i % 3 == 0 ? 3 : 2), i % 2 == 0 ? PinView.Gold : PinView.Jade, 150);
            }
        }
    }
}
