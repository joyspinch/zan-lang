using System;
using Gui;
using Game.Foundation.Gui;
using PinCircle;

// Level select: four chapters of ten, stars per level, bosses on every tenth.
// Cells are standard Buttons in the brass/jade skin; arrows move a keyboard
// cursor, Enter launches, Esc returns to the menu.
public class PinSelectScene : HtmlScene {
    PinWorld game;
    PinView view;
    int timeMs;

    PinSelectScene(PinWorld game, PinView view) { this.game = game; this.view = view; }

    override void OnEnter(Control root) {
        this.timeMs = 0;
        this.view.EnterHud(this.router, this, this.game, "select");
        this.view.hud.selected = this.view.shell.NextLevel();
        this.view.SyncHud(0);
    }

    override void OnExit() { this.view.ExitHud(); }
    override void Update(int dtMs) { this.view.SyncHud(this.timeMs); }

    void Launch(int level) {
        if (level < 1 || level > this.view.shell.Unlocked()) { return; }
        this.view.shell.CountPlay();
        this.view.shell.Play("select");
        this.game.StartRound(level, 0);
        this.router.Go("play");
    }

    void Move(int delta) {
        int next = this.view.hud.selected + delta;
        int open = this.view.shell.Unlocked();
        if (next < 1 || next > open) { return; }
        this.view.hud.selected = next;
        this.view.shell.Play("click", 0.6);
        this.view.SyncHud(this.timeMs);
    }

    override void Event(int kind, int key) {
        this.view.Sync(this.router.Host());
        if (kind == 5 && key == 32) { this.view.spaceHeld = false; }
        if (kind != 4) { return; }
        if (key == 27) { this.view.shell.Play("click"); this.router.Go("menu"); }
        if (key == 37) { this.Move(-1); }
        if (key == 39) { this.Move(1); }
        if (key == 38) { this.Move(-5); }
        if (key == 40) { this.Move(5); }
        if (key == 13) { this.Launch(this.view.hud.selected); }
        if (key == 32 && !this.view.spaceHeld) {
            this.view.spaceHeld = true;
            this.Launch(this.view.hud.selected);
        }
        if (key == 77) { this.view.ToggleMute(); }
    }

    override void FixedStep(int dtMs) {
        this.timeMs = this.timeMs + dtMs;
        this.view.shell.Tick(dtMs);
    }

    override void Render(Canvas c, double alpha) {
        this.view.Sync(this.router.Host());
        this.view.SelectBackdrop(c, this.timeMs);
        this.view.RenderHud(this.router.Host().App());
        this.view.Publish(this.game, "select");
    }
}
