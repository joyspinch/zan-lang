using System;
using Gui;
using Game.Foundation.Gui;
using PinCircle;

public class PinMenuScene : HtmlScene {
    PinWorld game;
    PinView view;
    int timeMs;

    PinMenuScene(PinWorld game, PinView view) { this.game = game; this.view = view; }

    override void OnEnter(Control root) {
        this.timeMs = 0;
        Gui.Backend.UiDriver.Begin(this.router.Host().App());
        this.router.Host().App().SetBackdropFx(false);
        this.view.EnterHud(this.router, this, this.game, "menu");
    }

    override void OnExit() { this.view.ExitHud(); }
    override void Update(int dtMs) { this.view.SyncHud(this.timeMs); }

    // Continue from the first level not yet cleared.
    void Start() {
        this.view.shell.CountPlay();
        this.view.shell.Play("select");
        this.game.StartRound(this.view.shell.NextLevel(), 0);
        this.router.Go("play");
    }

    override void Event(int kind, int key) {
        this.view.Sync(this.router.Host());
        if (kind == 5 && key == 32) { this.view.spaceHeld = false; }
        if (kind == 4) {
            if (key == 32) { this.view.spaceHeld = true; }
            if (key == 13 || key == 32) { this.Start(); }
            if (key == 76) { this.view.shell.Play("click"); this.router.Go("select"); }
            if (key == 27) { this.router.Exit(); }
            if (key == 77) { this.view.ToggleMute(); }
        }
    }

    override void FixedStep(int dtMs) {
        this.timeMs = this.timeMs + dtMs;
        this.view.shell.Tick(dtMs);
    }

    override void Render(Canvas c, double alpha) {
        this.view.Sync(this.router.Host());
        this.view.Menu(c, this.timeMs, this.game);
        this.view.RenderHud(this.router.Host().App());
        this.view.Publish(this.game, "menu");
    }
}
