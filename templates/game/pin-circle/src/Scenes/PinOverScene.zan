using System;
using Gui;
using Game.Foundation.Gui;
using PinCircle;

public class PinOverScene : HtmlScene {
    PinWorld game;
    PinView view;
    int waitMs;

    PinOverScene(PinWorld game, PinView view) { this.game = game; this.view = view; }

    override void OnEnter(Control root) {
        this.waitMs = 0;
        if (this.view.shell.NewBest()) { this.view.shell.Play("powerup", 0.8); }
        this.view.EnterHud(this.router, this, this.game, "over");
        Console.WriteLine("RESULT level=" + this.game.level + " inserted=" + this.game.totalInserted
            + " won=" + (this.game.state == RoundState.Cleared ? "1" : "0")
            + " stars=" + this.view.shell.LastStars()
            + " best=" + this.view.shell.BestLevel() + " newBest=" + (this.view.shell.NewBest() ? "1" : "0"));
    }

    override void OnExit() { this.view.ExitHud(); }
    override void Update(int dtMs) { this.view.SyncHud(this.waitMs); }

    void Continue() {
        if (this.waitMs < 240) { return; }
        this.view.shell.Play("select");
        int next = this.game.level + (this.game.state == RoundState.Cleared ? 1 : 0);
        this.game.StartRound(next, 0);
        this.router.Go("play");
    }

    override void Event(int kind, int key) {
        this.view.Sync(this.router.Host());
        if (kind == 5 && key == 32) { this.view.spaceHeld = false; }
        if (kind == 4) {
            if (key == 27) { this.view.shell.Play("click"); this.router.Go("menu"); }
            if (key == 76) { this.view.shell.Play("click"); this.router.Go("select"); }
            if (key == 77) { this.view.ToggleMute(); }
            if (key == 13) { this.Continue(); }
            if (key == 32 && !this.view.spaceHeld) {
                this.view.spaceHeld = true;
                this.Continue();
            }
        }
    }

    override void FixedStep(int dtMs) {
        int before = this.waitMs;
        this.waitMs = this.waitMs + dtMs;
        this.view.shell.Tick(dtMs);
        this.view.fx.Tick(dtMs);
        // Each earned star pops with its own rising chime (matches PinHud timing).
        int stars = this.game.state == RoundState.Cleared ? this.view.shell.LastStars() : 0;
        for (int i = 0; i < stars; i = i + 1) {
            int at = 380 + i * 260;
            if (before < at && this.waitMs >= at) { this.view.shell.Play("star" + (i + 1)); }
        }
    }

    override void Render(Canvas c, double alpha) {
        this.view.Sync(this.router.Host());
        this.view.Result(c, this.game, false, this.waitMs);
        this.view.RenderHud(this.router.Host().App());
        this.view.Publish(this.game, "over");
    }
}
