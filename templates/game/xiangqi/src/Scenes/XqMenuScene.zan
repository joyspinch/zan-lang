using System;
using System.IO;
using Gui;
using Game.Kit;
using Game.Foundation.Gui;

public class XqMenuScene : HtmlScene {
    XqGame g;

    XqMenuScene(XqGame g) { this.g = g; }

    override string HtmlFile() { return "assets/scenes/menu.html"; }

    override void OnWire(HtmlHandlers handlers) {
        handlers.Add("classic", () => this.Pick(0));
        handlers.Add("drill1", () => this.Pick(1));
        handlers.Add("drill2", () => this.Pick(2));
        handlers.Add("drill3", () => this.Pick(3));
        handlers.Add("drill4", () => this.Pick(4));
        handlers.Add("drill5", () => this.Pick(5));
        handlers.Add("drill6", () => this.Pick(6));
        handlers.Add("drill7", () => this.Pick(7));
        handlers.Add("drill8", () => this.Pick(8));
        handlers.Add("drill9", () => this.Pick(9));
        handlers.Add("drill10", () => this.Pick(10));
    }

    void Pick(int m) {
        this.g.mode = m;
        this.router.Go("play");
    }

    override void OnEnter(Control root) {
        Element stats = XqMenuScene.AsElement(root, "stats");
        if (stats != null) {
            stats.SetText("段位 " + this.g.prof.Title() + " · " + this.g.prof.pts
                + " 分 · 胜 " + this.g.prof.wins + " 负 " + this.g.prof.losses
                + " · 残局通关 " + this.g.prof.drills);
        }
    }

    static Element AsElement(Control root, string id) {
        Control c = root.Find(id);
        if (c != null && c is Element) { return (Element)c; }
        return null;
    }

    override void Event(int kind, int key) {
        if (kind == 4 && key == 27) { this.router.Exit(); }
    }

    override void Render(Canvas c, double alpha) {
        GuiHost host = this.router.Host();
        this.g.c = c;
        this.g.SyncStage(host);
        CDraw.Origin(0, host.ContentTop());
        this.g.DrawMenuArt();
    }
}

// 对局：纯 canvas 场景（HtmlFile 为空，无 HTML 层）。每次进场开新局
// （菜单选模式 / 结算再来一局都走这里），分出胜负后路由到结算场景。
