// 象棋 -- a lacquered Chinese chess parlor. You command red against a local
// alpha-beta AI; besides full games there are classic endgame drills (双车错 /
// 马后炮 / 车兵破士象) that teach mating patterns. Pieces are glossy lacquer
// discs with engraved characters; the last move trails a glow, checks flash a
// warning, victories shower sparks and rank points (草莽→棋圣). Esc back/exit.
// GuiHost+Canvas 版：窗口/事件/呈现由 Gui 原生外壳承担（Game.Foundation.Gui），
// 绘制走 Game.Kit.CanvasPrims 直绘，不依赖 SDL。
using System;
using System.IO;
using Gui;
using Game.Kit;
using Game.Foundation.Gui;

namespace Xiangqi;

class XqProfile {
    int pts;
    int wins;
    int losses;
    int streak;
    int bestStreak;
    int drills;  // endgame drills solved

    static string Path() { return "xiangqi_profile.txt"; }
    static int ParseInt(string s, int start) {
        int i = start; int v = 0; bool any = false;
        while (i < s.Length) { int c = s[i] & 255; if (c >= 48 && c <= 57) { v = v * 10 + (c - 48); any = true; i = i + 1; } else { i = s.Length; } }
        if (!any) { return 0; }
        return v;
    }
    static int ReadKey(List<string> lines, string key, int fb) {
        for (int i = 0; i < lines.Count; i = i + 1) {
            string ln = lines[i]; int eq = -1;
            for (int j = 0; j < ln.Length; j = j + 1) { if (ln[j] == 61) { eq = j; j = ln.Length; } }
            if (eq > 0) { if (ln.Substring(0, eq) == key) { return XqProfile.ParseInt(ln, eq + 1); } }
        }
        return fb;
    }
    static XqProfile Load() {
        XqProfile p = new XqProfile();
        if (!File.Exists(XqProfile.Path())) { return p; }
        List<string> lines = File.ReadAllLines(XqProfile.Path());
        p.pts = XqProfile.ReadKey(lines, "pts", 0);
        p.wins = XqProfile.ReadKey(lines, "wins", 0);
        p.losses = XqProfile.ReadKey(lines, "losses", 0);
        p.streak = XqProfile.ReadKey(lines, "streak", 0);
        p.bestStreak = XqProfile.ReadKey(lines, "bestStreak", 0);
        p.drills = XqProfile.ReadKey(lines, "drills", 0);
        return p;
    }
    void Save() {
        string s = "pts=" + this.pts + "\nwins=" + this.wins
            + "\nlosses=" + this.losses + "\nstreak=" + this.streak
            + "\nbestStreak=" + this.bestStreak + "\ndrills=" + this.drills + "\n";
        File.WriteAllText(XqProfile.Path(), s);
    }
    string Title() {
        if (this.pts >= 420) { return "棋圣"; }
        if (this.pts >= 260) { return "大师"; }
        if (this.pts >= 150) { return "县冠军"; }
        if (this.pts >= 70) { return "街霸"; }
        if (this.pts >= 25) { return "巷口高手"; }
        return "草莽";
    }
}

class XqParticle {
    int x; int y; int vx; int vy; int bornAt; int cr; int cg; int cb;
}
class XqPopup {
    int x; int y; string text; int bornAt; int cr; int cg; int cb;
}

class XqGame {
    Canvas c;
    XqProfile prof;
    Rng rng;

    // board[y*9+x]; 0 empty. red: 1帅 2仕 3相 4马 5车 6炮 7兵
    // black: 8将 9士 10象 11马 12车 13炮 14卒. Red at bottom (y7..9 palace).
    int[] board;
    int mode;  // 0 full game, 1..10 endgame drills
    bool redTurn;
    int selSq;  // selected square or -1
    int lastFrom;
    int lastTo;
    int winner;  // 1 red(player), 2 black(ai)
    int aiThinkAt;
    bool aiTurn;
    int moveCount;
    bool inCheck;  // player currently in check
    int mouseX;
    int mouseY;
    int toastAt;
    string toastText;
    List<XqParticle> parts;
    List<XqPopup> pops;
    string menuBg;  // asset paths (null = 画布回退画法)
    string titlePath;
    string boardPath;
    string piecePath;
    // 新美术（美术化批产资产）：全局菜单底/对局底/棋盘面/双色棋子/面板。
    string menuBg2;
    string playBg;
    string boardArt;
    string pieceRed;
    string pieceBlack;
    bool texTried;
    bool demo;
    int demoAt;
    int maxMoves;  // demo guard: end the self-play after this many red moves
    List<int> legal;  // cached legal moves for the side to move

    // 竖屏（舞台高>宽：手机竖屏或竖长窗口）参照手机棋类布局自适应——
    // 棋盘水平居中放大（格距 74），顶部对手条 + 回合徽标，底部
    // 菜单/重玩按钮行；横屏维持"左棋盘 + 右信息栏"原布局。绘制与
    // 命中测试共用这几个函数，同一帧内自洽。
    static bool Portrait() { return XqGame.VW() < XqGame.VH(); }
    static int Cell() { return XqGame.Portrait() ? 74 : 58; }
    static int BX() { return (XqGame.VW() - 8 * XqGame.Cell()) / 2; }
    static int BY() {
        if (!XqGame.Portrait()) { return 78; }
        // 顶部条(0..140) + 徽标带(到 240)之下、底部按钮行(高 110)之上居中
        return 240 + (XqGame.VH() - 240 - 150 - 9 * XqGame.Cell()) / 2;
    }
    // 视口按宿主舞台每帧延展（宽窗多看宽度）：VW/VH 是当前帧的舞台
    // 逻辑尺寸，帧首在 SyncStage 更新——布局锚定它即可满铺任意窗口，
    // 否则长轴超出的部分就是宿主 margin 底色的空条。
    static int VW() { return vw > 0 ? vw : 1280; }
    static int VH() { return vh > 0 ? vh : 720; }

    // 帧首对齐宿主延展舞台（GuiHost.Render 回调开头调用）。
    void SyncStage(GuiHost host) {
        XqGame.vw = host.StageWidth();
        XqGame.vh = host.StageHeight();
    }
    static int vw;
    static int vh;

    static XqGame Create(GuiHost h) {
        XqGame g = new XqGame();
        g.prof = XqProfile.Load();
        g.rng = Rng.Seed((long)Window.GetTickMs() + 8642097);
        g.mouseX = 640;
        g.mouseY = 360;
        g.parts = new List<XqParticle>();
        g.pops = new List<XqPopup>();
        g.toastAt = -9999;
        g.selSq = -1;
        g.demo = File.Exists("xiangqi_demo.txt");
        if (g.demo) { g.maxMoves = 6; }  // demo ends after this many red moves
        return g;
    }

    void EnsureTex() {
        if (this.texTried) { return; }
        this.texTried = true;
        this.menuBg = XqGame.FindAsset("assets/menu_bg.png");
        this.titlePath = XqGame.FindAsset("assets/title.png");
        this.boardPath = XqGame.FindAsset("assets/board_wood.png");
        this.piecePath = XqGame.FindAsset("assets/piece.png");
        this.menuBg2 = XqGame.FindAsset("assets/menu_bg2.png");
        this.playBg = XqGame.FindAsset("assets/play_bg.png");
        this.boardArt = XqGame.FindAsset("assets/board_wood2.png");
        this.pieceRed = XqGame.FindAsset("assets/piece_red.png");
        this.pieceBlack = XqGame.FindAsset("assets/piece_black.png");
    }
    static string FindAsset(string path) {
        string p = Assets.Find(path);
        if (!File.Exists(p)) { return null; }
        return p;
    }

    // 背景整幅 cover 贴图：源图按目标纵横比居中裁剪（多出的边裁掉，
    // 不拉伸变形）。BlitImage 的源矩形以图像像素为单位，无缩放。
    static void BlitCover(Canvas c, string path, int dw, int dh) {
        int iw = Canvas.ImageWidth(path);
        int ih = Canvas.ImageHeight(path);
        if (iw <= 0 || ih <= 0) { return; }
        int sw = iw;
        int sh = sw * dh / dw;
        if (sh > ih) { sh = ih; sw = sh * dw / dh; }
        string src = CDraw.BlitSource(c, path);
        if (src == null) { return; }
        c.BlitImage(src, CDraw.MapX(CDraw.originX), CDraw.MapY(CDraw.originY),
                    CDraw.MapW(dw), CDraw.MapW(dh),
                    (iw - sw) / 2, (ih - sh) / 2, sw, sh);
    }

    // ----- feedback --------------------------------------------------------

    void Toast(string t, int now) { this.toastText = t; this.toastAt = now; }
    void AddPop(int px, int py, string t, int now, int cr, int cg, int cb) {
        if (this.pops.Count > 14) { this.pops.RemoveAt(0); }
        XqPopup p = new XqPopup();
        p.x = px; p.y = py; p.text = t; p.bornAt = now;
        p.cr = cr; p.cg = cg; p.cb = cb;
        this.pops.Add(p);
    }
    void Burst(int px, int py, int n, int now, int cr, int cg, int cb) {
        if (this.parts.Count > 240) { return; }
        for (int i = 0; i < n; i = i + 1) {
            XqParticle p = new XqParticle();
            p.x = px * 256; p.y = py * 256;
            int a = this.rng.Range(0, 16);
            int spd = 60 + this.rng.Range(0, 160);
            int ux = 0; int uy = 0;
            int q = a % 4;
            if (q == 0) { ux = 256; uy = (a / 4 - 2) * 128; }
            if (q == 1) { ux = -256; uy = (a / 4 - 2) * 128; }
            if (q == 2) { uy = 256; ux = (a / 4 - 2) * 128; }
            if (q == 3) { uy = -256; ux = (a / 4 - 2) * 128; }
            p.vx = ux * spd / 256;
            p.vy = uy * spd / 256;
            p.bornAt = now;
            p.cr = cr; p.cg = cg; p.cb = cb;
            this.parts.Add(p);
        }
    }

    // ----- setup -----------------------------------------------------------

    void Put(int x, int y, int p) { this.board[y * 9 + x] = p; }

    void StartGame(int mode, int now) {
        this.board = new int[90];
        this.mode = mode;
        this.selSq = -1;
        this.lastFrom = -1;
        this.lastTo = -1;
        this.winner = 0;
        this.moveCount = 0;
        this.inCheck = false;
        this.parts = new List<XqParticle>();
        this.pops = new List<XqPopup>();
        this.toastAt = -9999;
        if (mode == 0) {
            // full game
            this.Put(0, 0, 12); this.Put(1, 0, 11); this.Put(2, 0, 10); this.Put(3, 0, 9);
            this.Put(4, 0, 8);
            this.Put(5, 0, 9); this.Put(6, 0, 10); this.Put(7, 0, 11); this.Put(8, 0, 12);
            this.Put(1, 2, 13); this.Put(7, 2, 13);
            this.Put(0, 3, 14); this.Put(2, 3, 14); this.Put(4, 3, 14); this.Put(6, 3, 14); this.Put(8, 3, 14);
            this.Put(0, 9, 5); this.Put(1, 9, 4); this.Put(2, 9, 3); this.Put(3, 9, 2);
            this.Put(4, 9, 1);
            this.Put(5, 9, 2); this.Put(6, 9, 3); this.Put(7, 9, 4); this.Put(8, 9, 5);
            this.Put(1, 7, 6); this.Put(7, 7, 6);
            this.Put(0, 6, 7); this.Put(2, 6, 7); this.Put(4, 6, 7); this.Put(6, 6, 7); this.Put(8, 6, 7);
            this.Toast("红先行，将军制胜", now);
        } else if (mode == 1) {
            // 双车错: two chariots roll up a bare palace
            this.Put(4, 9, 1);
            this.Put(0, 2, 5); this.Put(1, 4, 5);
            this.Put(4, 0, 8); this.Put(3, 0, 9); this.Put(5, 1, 9);
        } else if (mode == 2) {
            // 马后炮: the classic horse-then-cannon mate
            this.Put(4, 9, 1);
            this.Put(4, 4, 6); this.Put(3, 2, 4);
            this.Put(4, 0, 8); this.Put(3, 0, 9);
        } else if (mode == 3) {
            // 车兵破士象: chariot + pawn grind down advisors and elephants
            this.Put(4, 9, 1);
            this.Put(0, 4, 5); this.Put(4, 4, 7);
            this.Put(4, 0, 8); this.Put(3, 0, 9); this.Put(5, 0, 9);
            this.Put(2, 0, 10); this.Put(6, 0, 10);
        } else if (mode == 4) {
            // 重炮夺魁: stacked cannons on the middle file
            this.Put(4, 9, 1);
            this.Put(4, 4, 6); this.Put(4, 6, 6);
            this.Put(4, 0, 8); this.Put(4, 1, 9); this.Put(3, 0, 9);
        } else if (mode == 5) {
            // 卧槽马: horse leaps to the fatal corner point
            this.Put(4, 9, 1);
            this.Put(3, 3, 4); this.Put(0, 2, 5);
            this.Put(4, 0, 8); this.Put(3, 0, 9); this.Put(5, 0, 9);
        } else if (mode == 6) {
            // 双马饮泉: paired horses circle the palace spring
            this.Put(4, 9, 1);
            this.Put(3, 2, 4); this.Put(5, 2, 4);
            this.Put(4, 0, 8); this.Put(3, 0, 9); this.Put(5, 0, 9); this.Put(2, 0, 10);
        } else if (mode == 7) {
            // 海底捞月: chariot + cannon dig the king out of the bottom rank
            this.Put(4, 9, 1);
            this.Put(0, 5, 5); this.Put(4, 3, 6);
            this.Put(5, 0, 8); this.Put(4, 1, 12);
        } else if (mode == 8) {
            // 老卒逼宫: two humble pawns march on the palace
            this.Put(4, 9, 1);
            this.Put(3, 1, 7); this.Put(5, 1, 7);
            this.Put(4, 0, 8); this.Put(3, 0, 9);
        } else if (mode == 9) {
            // 车炮巧胜: chariot and cannon carve through the defense
            this.Put(4, 9, 1);
            this.Put(1, 3, 5); this.Put(4, 6, 6);
            this.Put(4, 0, 8); this.Put(5, 0, 9); this.Put(6, 0, 10);
        } else {
            // 单兵擒王: the lone pawn hunts the king down
            this.Put(4, 9, 1);
            this.Put(4, 2, 7);
            this.Put(4, 0, 8); this.Put(3, 0, 9);
        }
        if (mode > 0) { this.Toast("残局·" + XqGame.DrillName(mode) + "：红先取胜", now); }
        this.redTurn = true;
        this.aiTurn = false;
        this.legal = this.LegalMoves(true);
        if (this.demo) { this.demoAt = now + 500; }
    }

    static string DrillName(int m) {
        if (m == 1) { return "双车错"; }
        if (m == 2) { return "马后炮"; }
        if (m == 3) { return "车兵破士象"; }
        if (m == 4) { return "重炮夺魁"; }
        if (m == 5) { return "卧槽马"; }
        if (m == 6) { return "双马饮泉"; }
        if (m == 7) { return "海底捞月"; }
        if (m == 8) { return "老卒逼宫"; }
        if (m == 9) { return "车炮巧胜"; }
        return "单兵擒王";
    }

    // ----- rules -----------------------------------------------------------

    static bool IsRed(int p) { return p >= 1 && p <= 7; }
    static bool IsBlack(int p) { return p >= 8; }
    int At(int x, int y) {
        if (x < 0 || x > 8 || y < 0 || y > 9) { return -2; }
        return this.board[y * 9 + x];
    }

    void AddMove(List<int> res, int fx, int fy, int tx, int ty, bool red) {
        int t = this.At(tx, ty);
        if (t == -2) { return; }
        if (t != 0) {
            if (red && XqGame.IsRed(t)) { return; }
            if (!red && XqGame.IsBlack(t)) { return; }
        }
        res.Add((fy * 9 + fx) * 90 + ty * 9 + tx);
    }

    void SlideMoves(List<int> res, int fx, int fy, int dx, int dy, bool red, bool cannon) {
        int x = fx + dx; int y = fy + dy;
        bool jumped = false;
        while (x >= 0 && x <= 8 && y >= 0 && y <= 9) {
            int t = this.At(x, y);
            if (!cannon) {
                this.AddMove(res, fx, fy, x, y, red);
                if (t != 0) { return; }
            } else {
                if (!jumped) {
                    if (t == 0) { this.AddMove(res, fx, fy, x, y, red); }
                    else { jumped = true; }
                } else {
                    if (t != 0) { this.AddMove(res, fx, fy, x, y, red); return; }
                }
            }
            x = x + dx; y = y + dy;
        }
    }

    // pseudo-legal moves for one side (includes flying-general capture, so a
    // facing-generals position is auto-punished in search / legality checks)
    List<int> GenMoves(bool red) {
        List<int> res = new List<int>();
        for (int y = 0; y < 10; y = y + 1) {
            for (int x = 0; x < 9; x = x + 1) {
                int p = this.At(x, y);
                if (p != 0 && (red == XqGame.IsRed(p))) {
                    int k = p;
                    if (k >= 8) { k = k - 7; }
                    if (k == 1) {
                        // general: palace steps + flying general
                        int py0 = 7; int py1 = 9;
                        if (!red) { py0 = 0; py1 = 2; }
                        if (x > 3) { this.AddMove(res, x, y, x - 1, y, red); }
                        if (x < 5) { this.AddMove(res, x, y, x + 1, y, red); }
                        if (y > py0) { this.AddMove(res, x, y, x, y - 1, red); }
                        if (y < py1) { this.AddMove(res, x, y, x, y + 1, red); }
                        int dy = -1;
                        if (!red) { dy = 1; }
                        int yy = y + dy;
                        while (yy >= 0 && yy <= 9) {
                            int t = this.At(x, yy);
                            if (t != 0) {
                                int tk = t;
                                if (tk >= 8) { tk = tk - 7; }
                                if (tk == 1) { this.AddMove(res, x, y, x, yy, red); }
                                yy = -99;
                            } else { yy = yy + dy; }
                        }
                    } else if (k == 2) {
                        // advisor: palace diagonals
                        int py0 = 7; int py1 = 9;
                        if (!red) { py0 = 0; py1 = 2; }
                        for (int d = 0; d < 4; d = d + 1) {
                            int dx = 1; int dy = 1;
                            if (d == 1) { dx = -1; }
                            if (d == 2) { dy = -1; }
                            if (d == 3) { dx = -1; dy = -1; }
                            int tx = x + dx; int ty = y + dy;
                            if (tx >= 3 && tx <= 5 && ty >= py0 && ty <= py1) {
                                this.AddMove(res, x, y, tx, ty, red);
                            }
                        }
                    } else if (k == 3) {
                        // elephant: two-step diagonal, blocked eye, own half
                        for (int d = 0; d < 4; d = d + 1) {
                            int dx = 2; int dy = 2;
                            if (d == 1) { dx = -2; }
                            if (d == 2) { dy = -2; }
                            if (d == 3) { dx = -2; dy = -2; }
                            int tx = x + dx; int ty = y + dy;
                            bool half = ty >= 5;
                            if (!red) { half = ty <= 4; }
                            if (half && this.At(x + dx / 2, y + dy / 2) == 0) {
                                this.AddMove(res, x, y, tx, ty, red);
                            }
                        }
                    } else if (k == 4) {
                        // horse with leg blocks
                        for (int d = 0; d < 8; d = d + 1) {
                            int dx = 1; int dy = 2;
                            if (d == 1) { dx = -1; dy = 2; }
                            if (d == 2) { dx = 1; dy = -2; }
                            if (d == 3) { dx = -1; dy = -2; }
                            if (d == 4) { dx = 2; dy = 1; }
                            if (d == 5) { dx = 2; dy = -1; }
                            if (d == 6) { dx = -2; dy = 1; }
                            if (d == 7) { dx = -2; dy = -1; }
                            int lx = x; int ly = y;
                            if (dx == 2) { lx = x + 1; }
                            if (dx == -2) { lx = x - 1; }
                            if (dy == 2) { ly = y + 1; }
                            if (dy == -2) { ly = y - 1; }
                            if (this.At(lx, ly) == 0) {
                                this.AddMove(res, x, y, x + dx, y + dy, red);
                            }
                        }
                    } else if (k == 5) {
                        this.SlideMoves(res, x, y, 1, 0, red, false);
                        this.SlideMoves(res, x, y, -1, 0, red, false);
                        this.SlideMoves(res, x, y, 0, 1, red, false);
                        this.SlideMoves(res, x, y, 0, -1, red, false);
                    } else if (k == 6) {
                        this.SlideMoves(res, x, y, 1, 0, red, true);
                        this.SlideMoves(res, x, y, -1, 0, red, true);
                        this.SlideMoves(res, x, y, 0, 1, red, true);
                        this.SlideMoves(res, x, y, 0, -1, red, true);
                    } else {
                        // pawn
                        int dy = -1;
                        if (!red) { dy = 1; }
                        this.AddMove(res, x, y, x, y + dy, red);
                        bool crossed = y <= 4;
                        if (!red) { crossed = y >= 5; }
                        if (crossed) {
                            this.AddMove(res, x, y, x - 1, y, red);
                            this.AddMove(res, x, y, x + 1, y, red);
                        }
                    }
                }
            }
        }
        return res;
    }

    int FindGeneral(bool red) {
        int want = 1;
        if (!red) { want = 8; }
        for (int i = 0; i < 90; i = i + 1) {
            if (this.board[i] == want) { return i; }
        }
        return -1;
    }

    bool InCheckSide(bool red) {
        int g = this.FindGeneral(red);
        if (g < 0) { return true; }
        List<int> opp = this.GenMoves(!red);
        for (int i = 0; i < opp.Count; i = i + 1) {
            if (opp[i] % 90 == g) { return true; }
        }
        return false;
    }

    List<int> LegalMoves(bool red) {
        List<int> ps = this.GenMoves(red);
        List<int> res = new List<int>();
        for (int i = 0; i < ps.Count; i = i + 1) {
            int m = ps[i];
            int f = m / 90; int t = m % 90;
            int cap = this.board[t];
            this.board[t] = this.board[f];
            this.board[f] = 0;
            if (!this.InCheckSide(red)) { res.Add(m); }
            this.board[f] = this.board[t];
            this.board[t] = cap;
        }
        return res;
    }

    // ----- evaluation + search ---------------------------------------------

    static int PieceVal(int p) {
        int k = p;
        if (k >= 8) { k = k - 7; }
        if (k == 1) { return 100000; }
        if (k == 2) { return 130; }
        if (k == 3) { return 130; }
        if (k == 4) { return 430; }
        if (k == 5) { return 920; }
        if (k == 6) { return 460; }
        return 90;
    }

    // evaluation from black's (AI) perspective
    int Eval() {
        int v = 0;
        for (int i = 0; i < 90; i = i + 1) {
            int p = this.board[i];
            if (p != 0) {
                int val = XqGame.PieceVal(p);
                int y = i / 9;
                int k = p;
                if (k >= 8) { k = k - 7; }
                if (k == 7) {
                    // pawns gain value as they advance
                    if (XqGame.IsRed(p)) { val = val + (6 - y) * 22; }
                    else { val = val + (y - 3) * 22; }
                }
                if (k == 4 || k == 6) {
                    // horses/cannons like the middle files
                    int x = i % 9;
                    int cd = x - 4;
                    if (cd < 0) { cd = -cd; }
                    val = val + (4 - cd) * 6;
                }
                if (XqGame.IsBlack(p)) { v = v + val; } else { v = v - val; }
            }
        }
        return v;
    }

    // negamax with alpha-beta over pseudo-legal moves; capturing the enemy
    // general scores as an immediate huge win, which also enforces legality.
    int Search(bool blackToMove, int depth, int alpha, int beta) {
        if (depth == 0) { return this.EvalFor(blackToMove); }
        List<int> ms = this.GenMoves(!blackToMove);
        // order captures first (simple selection by captured value)
        int best = -9999999;
        int n = ms.Count;
        // score-order in place: captures of high value first
        for (int oi = 0; oi < n; oi = oi + 1) {
            int bi = oi;
            int bv = this.MoveOrder(ms[oi]);
            int oj = oi + 1;
            while (oj < n) {
                int vv = this.MoveOrder(ms[oj]);
                if (vv > bv) { bv = vv; bi = oj; }
                oj = oj + 1;
            }
            if (bi != oi) { int tmp = ms[oi]; ms[oi] = ms[bi]; ms[bi] = tmp; }
            int m = ms[oi];
            int f = m / 90; int t = m % 90;
            int cap = this.board[t];
            if (cap != 0) {
                int ck = cap;
                if (ck >= 8) { ck = ck - 7; }
                if (ck == 1) { return 500000 + depth * 1000; }
            }
            this.board[t] = this.board[f];
            this.board[f] = 0;
            int sc = -this.Search(!blackToMove, depth - 1, -beta, -alpha);
            this.board[f] = this.board[t];
            this.board[t] = cap;
            if (sc > best) { best = sc; }
            if (best > alpha) { alpha = best; }
            if (alpha >= beta) { return best; }
        }
        if (n == 0) { return -400000; }
        return best;
    }

    int EvalFor(bool blackToMove) {
        int e = this.Eval();
        if (blackToMove) { return e; }
        return -e;
    }

    int MoveOrder(int m) {
        int t = m % 90;
        int cap = this.board[t];
        if (cap == 0) { return 0; }
        return XqGame.PieceVal(cap);
    }

    void AiMove(int now) {
        List<int> ms = this.LegalMoves(false);
        if (ms.Count == 0) { this.Win(1, now); return; }
        int depth = 3;
        int bestM = ms[0];
        int bestV = -9999999;
        for (int i = 0; i < ms.Count; i = i + 1) {
            int m = ms[i];
            int f = m / 90; int t = m % 90;
            int cap = this.board[t];
            this.board[t] = this.board[f];
            this.board[f] = 0;
            int sc = -this.Search(false, depth - 1, -9999999, 9999999);
            this.board[f] = this.board[t];
            this.board[t] = cap;
            sc = sc + this.rng.Range(0, 5);
            if (sc > bestV) { bestV = sc; bestM = m; }
        }
        this.Apply(bestM, now, false);
    }

    void Apply(int m, int now, bool byPlayer) {
        int f = m / 90; int t = m % 90;
        int cap = this.board[t];
        this.board[t] = this.board[f];
        this.board[f] = 0;
        this.lastFrom = f;
        this.lastTo = t;
        this.moveCount = this.moveCount + 1;
        int sx = XqGame.BX() + (t % 9) * XqGame.Cell();
        int sy = XqGame.BY() + (t / 9) * XqGame.Cell();
        if (cap != 0) {
            this.Burst(sx, sy, 12, now, 255, 190, 90);
            this.AddPop(sx, sy - 26, "吃" + XqGame.Name(cap), now, 255, 205, 110);
        }
        this.redTurn = !this.redTurn;
        this.aiTurn = !this.redTurn;
        if (this.aiTurn) { this.aiThinkAt = now + 300 + this.rng.Range(0, 400); }
        this.legal = this.LegalMoves(this.redTurn);
        this.inCheck = this.InCheckSide(this.redTurn);
        if (this.legal.Count == 0) {
            if (this.redTurn) { this.Win(2, now); } else { this.Win(1, now); }
            return;
        }
        if (this.inCheck) {
            if (this.redTurn) { this.Toast("将军！小心应对", now); }
            else { this.AddPop(sx, sy - 50, "将军！", now, 255, 120, 110); }
        }
        if (this.demo) { this.demoAt = now + 450; }
    }

    void Win(int who, int now) {
        this.winner = who;
        if (who == 1) {
            int gain = 15;
            if (this.mode > 0) { gain = 20; this.prof.drills = this.prof.drills + 1; }
            this.prof.pts = this.prof.pts + gain;
            this.prof.wins = this.prof.wins + 1;
            this.prof.streak = this.prof.streak + 1;
            if (this.prof.streak > this.prof.bestStreak) { this.prof.bestStreak = this.prof.streak; }
            this.Burst(640, 300, 60, now, 255, 210, 100);
        } else {
            this.prof.losses = this.prof.losses + 1;
            this.prof.streak = 0;
            this.prof.pts = this.prof.pts - 5;
            if (this.prof.pts < 0) { this.prof.pts = 0; }
        }
        this.prof.Save();
    }

    static string Name(int p) {
        if (p == 1) { return "帅"; }
        if (p == 2) { return "仕"; }
        if (p == 3) { return "相"; }
        if (p == 4) { return "马"; }
        if (p == 5) { return "车"; }
        if (p == 6) { return "炮"; }
        if (p == 7) { return "兵"; }
        if (p == 8) { return "将"; }
        if (p == 9) { return "士"; }
        if (p == 10) { return "象"; }
        if (p == 11) { return "马"; }
        if (p == 12) { return "车"; }
        if (p == 13) { return "炮"; }
        if (p == 14) { return "卒"; }
        return "";
    }

    // ----- input -----------------------------------------------------------

    // 对局内落子/选子（竖屏底部 菜单/重玩 行由 XqPlayScene 处理：需要路由器）。
    void OnDownPlay(int cx, int cy, int now) {
        if (this.aiTurn || this.winner != 0) { return; }
        int gx = (cx - XqGame.BX() + XqGame.Cell() / 2) / XqGame.Cell();
        int gy = (cy - XqGame.BY() + XqGame.Cell() / 2) / XqGame.Cell();
        if (gx < 0 || gy < 0 || gx > 8 || gy > 9) { return; }
        int sq = gy * 9 + gx;
        int p = this.board[sq];
        if (this.selSq < 0) {
            if (XqGame.IsRed(p)) { this.selSq = sq; }
            return;
        }
        if (sq == this.selSq) { this.selSq = -1; return; }
        if (XqGame.IsRed(p)) { this.selSq = sq; return; }
        int m = this.selSq * 90 + sq;
        bool ok = false;
        for (int i = 0; i < this.legal.Count; i = i + 1) {
            if (this.legal[i] == m) { ok = true; i = this.legal.Count; }
        }
        if (ok) {
            this.selSq = -1;
            this.Apply(m, now, true);
        } else {
            this.Toast("此步不合规则", now);
        }
    }

    void Tick(int now) {
        if (this.aiTurn && now >= this.aiThinkAt) {
            this.AiMove(now);
        }
        if (this.demo && !this.aiTurn && now >= this.demoAt) {
            this.DemoMove(now);
        }
    }

    // demo: red plays with a shallow search so screenshots show a real game;
    // after maxMoves red moves the self-play ends with the over screen.
    void DemoMove(int now) {
        if (this.maxMoves > 0 && this.moveCount >= this.maxMoves) {
            this.Win(1, now); return;
        }
        List<int> ms = this.LegalMoves(true);
        if (ms.Count == 0) { this.Win(2, now); return; }
        int bestM = ms[0];
        int bestV = -9999999;
        for (int i = 0; i < ms.Count; i = i + 1) {
            int m = ms[i];
            int f = m / 90; int t = m % 90;
            int cap = this.board[t];
            this.board[t] = this.board[f];
            this.board[f] = 0;
            int sc = -this.Search(true, 1, -9999999, 9999999);
            this.board[f] = this.board[t];
            this.board[t] = cap;
            sc = sc + this.rng.Range(0, 30);
            if (sc > bestV) { bestV = sc; bestM = m; }
        }
        this.Apply(bestM, now, true);
    }

    // ----- rendering -------------------------------------------------------

    void DrawAmbient() {
        this.EnsureTex();
        int vw = XqGame.VW();
        int vh = XqGame.VH();
        if (this.playBg != null) {
            // 对局底：整幅 cover + 轻压暗，灯笼式暖光晕两处提氛围。
            XqGame.BlitCover(this.c, this.playBg, vw, vh);
            CDraw.FillRect(this.c, 0, 0, vw, vh, CDraw.Argb(150, 18, 10, 7));
            this.c.FillRadial(CDraw.MapX(vw / 3), CDraw.MapY(vh / 3), CDraw.MapW(430),
                              CDraw.Argb(255, 220, 150, 80), 16);
            this.c.FillRadial(CDraw.MapX(vw * 2 / 3), CDraw.MapY(vh * 4 / 5), CDraw.MapW(360),
                              CDraw.Argb(255, 220, 140, 70), 12);
        } else if (this.menuBg != null) {
            CKitUi.Backdrop(this.c, this.menuBg, vw, vh);
            CDraw.FillRect(this.c, 0, 0, vw, vh, CDraw.Argb(190, 20, 12, 8));
            CDraw.FillCircle(this.c, vw / 3, vh / 3, 430, 255, 180, 100, 14);
        }
        CFx.Vignette(this.c, vw, vh, 70);
    }

    void DotLine(int ax, int ay, int bx, int by, int cr, int cg, int cb, int ca) {
        int steps = 14;
        for (int s = 0; s <= steps; s = s + 1) {
            int px = ax + (bx - ax) * s / steps;
            int py = ay + (by - ay) * s / steps;
            CDraw.FillCircle(this.c, px, py, 1, cr, cg, cb, ca);
        }
    }

    void DrawBoard(int now) {
        int c = XqGame.Cell();
        int x0 = XqGame.BX();
        int y0 = XqGame.BY();
        int w = 8 * c;
        int h = 9 * c;
        // lacquered table + real wood board face（先投影后落板）
        if (this.boardArt != null) {
            CFx.ShadowRect(this.c, x0 - 38, y0 - 30, w + 76, h + 76, 18, 22, 0, 0, 0, 130);
            CDraw.BlitImage(this.c, this.boardArt, x0 - 38, y0 - 38, w + 76, h + 76);
            CDraw.FillRect(this.c, x0 - 38, y0 - 38, w + 76, h + 76,
                CDraw.Argb(18, 255, 226, 170));
            CFx.Ring(this.c, x0 - 38, y0 - 38, w + 76, h + 76, 12, 1, 40, 20, 8, 150);
        } else {
            CFx.ShadowRect(this.c, x0 - 46, y0 - 40, w + 92, h + 92, 18, 22, 0, 0, 0, 130);
            CFx.GradRect(this.c, x0 - 46, y0 - 46, w + 92, h + 92, 16, 0,
                CDraw.Argb(255, 56, 27, 15), 0, CDraw.Argb(255, 34, 17, 9));
            CFx.Ring(this.c, x0 - 46, y0 - 46, w + 92, h + 92, 16, 1, 226, 186, 128, 70);
            if (this.boardPath != null) {
                CDraw.BlitImage(this.c, this.boardPath, x0 - 38, y0 - 38, w + 76, h + 76);
                CDraw.FillRect(this.c, x0 - 38, y0 - 38, w + 76, h + 76,
                    CDraw.Argb(22, 255, 226, 170));
            } else {
                CDraw.RoundRectFill(this.c, x0 - 38, y0 - 38, w + 76, h + 76, 12, 226, 186, 128, 255);
            }
        }
        // grid: verticals stop at the river
        int grid = CDraw.Argb(245, 24, 10, 6);
        int i = 0;
        for (; i < 9; i = i + 1) {
            int lx = x0 + i * c;
            if (i == 0 || i == 8) {
                CDraw.FillRect(this.c, lx - 1, y0, 2, h, grid);
            } else {
                CDraw.FillRect(this.c, lx - 1, y0, 2, 4 * c, grid);
                CDraw.FillRect(this.c, lx - 1, y0 + 5 * c, 2, 4 * c, grid);
            }
        }
        i = 0;
        while (i < 10) {
            CDraw.FillRect(this.c, x0, y0 + i * c - 1, w, 2, grid);
            i = i + 1;
        }
        // palace diagonals
        this.DotLine(x0 + 3 * c, y0, x0 + 5 * c, y0 + 2 * c, 24, 10, 6, 245);
        this.DotLine(x0 + 5 * c, y0, x0 + 3 * c, y0 + 2 * c, 24, 10, 6, 245);
        this.DotLine(x0 + 3 * c, y0 + 7 * c, x0 + 5 * c, y0 + 9 * c, 24, 10, 6, 245);
        this.DotLine(x0 + 5 * c, y0 + 7 * c, x0 + 3 * c, y0 + 9 * c, 24, 10, 6, 245);
        // river inscription
        CText.Draw(this.c, "楚 河", x0 + c, y0 + 4 * c + c / 2 - 14, 3, 46, 22, 12, 210);
        CText.Draw(this.c, "汉 界", x0 + 5 * c + 10, y0 + 4 * c + c / 2 - 14, 3, 46, 22, 12, 210);
        // last move trail
        if (this.lastFrom >= 0) {
            int fx = x0 + (this.lastFrom % 9) * c;
            int fy = y0 + (this.lastFrom / 9) * c;
            CDraw.RingRect(this.c, fx - 14, fy - 14, 28, 28, 2, 255, 200, 110, 160);
        }
        // pieces
        for (int y = 0; y < 10; y = y + 1) {
            for (int x = 0; x < 9; x = x + 1) {
                int p = this.At(x, y);
                if (p > 0) {
                    int sx = x0 + x * c;
                    int sy = y0 + y * c;
                    int rad = 24;
                    bool sel = this.selSq == y * 9 + x;
                    bool last = this.lastTo == y * 9 + x;
                    if (sel || last) {
                        CDraw.FillCircle(this.c, sx, sy, rad + 7, 255, 210, 120, 90);
                    }
                    CDraw.FillCircle(this.c, sx + 2, sy + 4, rad, 30, 16, 8, 110);
                    // 双色棋子贴图优先，旧通用棋子次之，最后素盘回退。
                    if (XqGame.IsRed(p) && this.pieceRed != null) {
                        CDraw.BlitImage(this.c, this.pieceRed, sx - rad - 2, sy - rad - 2, rad * 2 + 4, rad * 2 + 4);
                    } else if (!XqGame.IsRed(p) && this.pieceBlack != null) {
                        CDraw.BlitImage(this.c, this.pieceBlack, sx - rad - 2, sy - rad - 2, rad * 2 + 4, rad * 2 + 4);
                    } else if (this.piecePath != null) {
                        CDraw.BlitImage(this.c, this.piecePath, sx - rad - 2, sy - rad - 2, rad * 2 + 4, rad * 2 + 4);
                    } else {
                        CDraw.FillCircle(this.c, sx, sy, rad, 244, 222, 178, 255);
                        CDraw.FillCircle(this.c, sx - 6, sy - 8, rad / 3, 255, 250, 235, 190);
                    }
                    if (XqGame.IsRed(p)) {
                        CText.DrawCentered(this.c, XqGame.Name(p), sx, sy - 15, 3, 250, 236, 214, 255);
                    } else {
                        CText.DrawCenteredShadow(this.c, XqGame.Name(p), sx, sy - 15, 3, 226, 194, 130, 255);
                    }
                }
            }
        }
        // legal targets of the selected piece
        if (this.selSq >= 0) {
            i = 0;
            while (i < this.legal.Count) {
                int m = this.legal[i];
                if (m / 90 == this.selSq) {
                    int t = m % 90;
                    int tx = x0 + (t % 9) * c;
                    int ty = y0 + (t / 9) * c;
                    this.c.FillRadial(CDraw.MapX(tx), CDraw.MapY(ty), CDraw.MapW(14),
                                      CDraw.Argb(255, 90, 200, 130), 190);
                    CDraw.FillCircle(this.c, tx, ty, 7, 90, 200, 130, 190);
                }
                i = i + 1;
            }
        }
        // 楚河汉界水面饰线（棋盘面在贴图上也压一道金线提层次）。
        CFx.Rule(this.c, x0 + 4 * c, y0 + 4 * c + c / 2 + 26, 2 * c, 120, 78, 36, 150);
    }

    void DrawSide(int now) {
        if (XqGame.Portrait()) { this.DrawTopBar(now); return; }
        int px = 700;
        CFx.Card(this.c, px, 66, 512, 588, 16, 44, 24, 16, 28, 14, 8, 226, 186, 128, 90, 1, 0);
        CFx.Rule(this.c, px + 256, 148, 190, 226, 186, 128, 130);
        CText.Draw(this.c, "象棋", px + 36, 96, 5, 240, 220, 190, 255);
        string mn = "经典对弈";
        if (this.mode > 0) { mn = "残局·" + XqGame.DrillName(this.mode); }
        CText.Draw(this.c, mn, px + 36, 170, 2, 255, 214, 150, 255);
        string turn = "轮到红方（你）";
        int tr = 140; int tg = 220; int tb = 170;
        if (this.aiTurn) { turn = "黑方思考中…"; tr = 255; tg = 214; tb = 150; }
        if (this.inCheck && !this.aiTurn) { turn = "将军！速解"; tr = 255; tg = 120; tb = 110; }
        CText.Draw(this.c, turn, px + 36, 214, 3, tr, tg, tb, 255);
        CText.Draw(this.c, "段位 " + this.prof.Title() + " · " + this.prof.pts + " 分", px + 36, 286, 2, 235, 225, 205, 255);
        CText.Draw(this.c, "胜 " + this.prof.wins + " · 负 " + this.prof.losses, px + 36, 326, 2, 200, 190, 170, 255);
        CText.Draw(this.c, "连胜 " + this.prof.streak + " · 最佳 " + this.prof.bestStreak, px + 36, 366, 2, 200, 190, 170, 255);
        CText.Draw(this.c, "残局通关 " + this.prof.drills, px + 36, 406, 2, 200, 190, 170, 255);
        CText.Draw(this.c, "第 " + (this.moveCount + 1) + " 手", px + 36, 446, 2, 200, 190, 170, 255);
        CText.Draw(this.c, "点选红子再点目标 · Esc 菜单", px + 36, 610, 2, 160, 150, 135, 255);
    }

    // 竖屏对局 HUD：顶部对手条（黑方段位 + 手数）与"黑方思考中/轮到
    // 红方"徽标带（参考手机棋类布局），底部 菜单/重玩 按钮行。
    void DrawTopBar(int now) {
        int vw = XqGame.VW();
        CFx.Card(this.c, 16, 24, vw - 32, 112, 16, 44, 24, 16, 30, 16, 9, 226, 186, 128, 90, 1, 0);
        CText.Draw(this.c, "对手 · 黑方", 40, 44, 3, 240, 222, 190, 255);
        CText.Draw(this.c, "段位 " + this.prof.Title() + " · " + this.prof.pts + " 分", 40, 92, 2, 200, 190, 170, 255);
        string turn = "轮到红方（你）";
        int tr = 140; int tg = 220; int tb = 170;
        if (this.aiTurn) { turn = "黑方思考中…"; tr = 255; tg = 214; tb = 150; }
        if (this.inCheck && !this.aiTurn) { turn = "将军！速解"; tr = 255; tg = 120; tb = 110; }
        CFx.Pill(this.c, vw - 300, 48, 268, 64, 0, 26, 16, 10, 16, 9, 5, 226, 186, 128, 70);
        CText.DrawCentered(this.c, turn, vw - 166, 66, 3, tr, tg, tb, 255);
        CText.Draw(this.c, "第 " + (this.moveCount + 1) + " 手 · 残局通关 " + this.prof.drills, 40, 200, 2, 200, 190, 170, 255);
        int by = XqGame.VH() - 110;
        int bw = 200;
        CFx.GoldButton(this.c, this.mouseX, this.mouseY, vw / 2 - bw - 12, by, bw, 64, "菜单", 3, 0);
        CFx.GoldButton(this.c, this.mouseX, this.mouseY, vw / 2 + 12, by, bw, 64, "重玩", 3, 1);
    }

    // 竖屏底部按钮行命中区（绘制与 OnDown 共用矩形）。
    bool BottomRowHit(int cx, int cy, out bool menu) {
        menu = false;
        if (!XqGame.Portrait()) { return false; }
        int vw = XqGame.VW();
        int by = XqGame.VH() - 110;
        if (CDraw.PointIn(cx, cy, vw / 2 - 212, by, 200, 64)) { menu = true; return true; }
        if (CDraw.PointIn(cx, cy, vw / 2 + 12, by, 200, 64)) { return true; }
        return false;
    }

    void DrawFx(int now) {
        int i = 0;
        while (i < this.parts.Count) {
            XqParticle p = this.parts[i];
            int age = now - p.bornAt;
            if (age > 900) { this.parts.RemoveAt(i); continue; }
            int px = (p.x + p.vx * age / 4) / 256;
            int py = (p.y + p.vy * age / 4) / 256 + age * age / 26000;
            int alpha = 235 - age * 235 / 900;
            CDraw.FillCircle(this.c, px, py, 3, p.cr, p.cg, p.cb, alpha);
            i = i + 1;
        }
        i = 0;
        while (i < this.pops.Count) {
            XqPopup p = this.pops[i];
            int age = now - p.bornAt;
            if (age > 1400) { this.pops.RemoveAt(i); continue; }
            int alpha = 255 - age * 255 / 1400;
            CText.DrawCentered(this.c, p.text, p.x, p.y - age / 14, 2, p.cr, p.cg, p.cb, alpha);
            i = i + 1;
        }
        if (now - this.toastAt < 2200) {
            CText.DrawCenteredShadow(this.c, this.toastText, XqGame.VW() / 2, XqGame.VH() / 2 - 120, 2, 255, 224, 150, 255);
        }
    }

    void DrawPlay(int now) {
        CDraw.Clear(this.c, XqGame.VW(), XqGame.VH(), CDraw.Argb(255, 34, 22, 14));
        this.DrawAmbient();
        this.DrawBoard(now);
        this.DrawSide(now);
        this.DrawFx(now);
    }

    // 菜单画布层：美术背景 + 标题（经典/残局按钮与战绩行走 XqMenuScene 的
    // HTML 层）。
    void DrawMenuArt() {
        this.EnsureTex();
        CDraw.Clear(this.c, XqGame.VW(), XqGame.VH(), CDraw.Argb(255, 28, 18, 12));
        if (this.menuBg2 != null) {
            XqGame.BlitCover(this.c, this.menuBg2, XqGame.VW(), XqGame.VH());
            CDraw.FillRect(this.c, 0, 0, XqGame.VW(), XqGame.VH(), CDraw.Argb(110, 18, 10, 6));
        } else {
            CKitUi.Backdrop(this.c, this.menuBg, XqGame.VW(), XqGame.VH());
            CDraw.FillRect(this.c, 0, 0, XqGame.VW(), XqGame.VH(), CDraw.Argb(120, 18, 10, 6));
        }
        CFx.Vignette(this.c, XqGame.VW(), XqGame.VH(), 90);
        if (this.titlePath != null) {
            CDraw.BlitImage(this.c, this.titlePath, XqGame.VW() / 2 - 300, 30, 600, 200);
        } else {
            CText.DrawCenteredShadow(this.c, "象棋", XqGame.VW() / 2, 70, 9, 245, 230, 200, 255);
        }
    }
}

// 主菜单：画布层只画美术背景与标题（XqMenuScene.Render → DrawMenuArt），
// 经典对弈 + 10 个残局按钮与战绩行走 HTML 层；每次进场由
// XqPlayScene.OnEnter 开新局。
class XqMenuScene : HtmlScene {
    XqGame g;

    XqMenuScene(XqGame g) { this.g = g; }

    override string HtmlFile() { return "assets/scenes/menu.html"; }

    override void OnWire(HtmlHandlers handlers) {
        handlers.Add("classic", () => this.Pick(0));
        handlers.Add("drill1", () => this.Pick(1));
        handlers.Add("drill2", () => this.Pick(2));
        handlers.Add("drill3", () => this.Pick(3));
        handlers.Add("drill4", () => this.Pick(4));
        handlers.Add("drill5", () => this.Pick(5));
        handlers.Add("drill6", () => this.Pick(6));
        handlers.Add("drill7", () => this.Pick(7));
        handlers.Add("drill8", () => this.Pick(8));
        handlers.Add("drill9", () => this.Pick(9));
        handlers.Add("drill10", () => this.Pick(10));
    }

    void Pick(int m) {
        this.g.mode = m;
        this.router.Go("play");
    }

    override void OnEnter(Control root) {
        Element stats = XqMenuScene.AsElement(root, "stats");
        if (stats != null) {
            stats.SetText("段位 " + this.g.prof.Title() + " · " + this.g.prof.pts
                + " 分 · 胜 " + this.g.prof.wins + " 负 " + this.g.prof.losses
                + " · 残局通关 " + this.g.prof.drills);
        }
    }

    static Element AsElement(Control root, string id) {
        Control c = root.Find(id);
        if (c != null && c is Element) { return (Element)c; }
        return null;
    }

    override void Event(int kind, int key) {
        if (kind == 4 && key == 27) { this.router.Exit(); }
    }

    override void Render(Canvas c, double alpha) {
        GuiHost host = this.router.Host();
        this.g.c = c;
        this.g.SyncStage(host);
        CDraw.Origin(0, host.ContentTop());
        this.g.DrawMenuArt();
    }
}

// 对局：纯 canvas 场景（HtmlFile 为空，无 HTML 层）。每次进场开新局
// （菜单选模式 / 结算再来一局都走这里），分出胜负后路由到结算场景。
class XqPlayScene : HtmlScene {
    XqGame g;

    XqPlayScene(XqGame g) { this.g = g; }

    override void OnEnter(Control root) {
        this.g.StartGame(this.g.mode, Window.GetTickMs());
    }

    override void Event(int kind, int key) {
        GuiHost host = this.router.Host();
        // 指针坐标经 host.MouseX/Y 反变换回舞台逻辑坐标（桌面视口
        // letterbox / 手机驱动反变换都在宿主之下完成）。
        if (kind == 1) {
            this.g.mouseX = host.MouseX();
            this.g.mouseY = host.MouseY();
        } else if (kind == 2 && key == 0) {
            this.g.mouseX = host.MouseX();
            this.g.mouseY = host.MouseY();
            int cx = this.g.mouseX;
            int cy = this.g.mouseY;
            // 竖屏底部按钮行：菜单（回主菜单）与重玩（重开当前局）
            bool menu;
            if (this.g.BottomRowHit(cx, cy, out menu)) {
                if (menu) { this.router.Go("menu"); }
                else { this.g.StartGame(this.g.mode, Window.GetTickMs()); }
                return;
            }
            this.g.OnDownPlay(cx, cy, Window.GetTickMs());
        } else if (kind == 4) {
            if (key == 27) { this.router.Go("menu"); }
        }
    }

    override void FixedStep(int dtMs) {
        this.g.Tick(Window.GetTickMs());
        // 分出胜负（绝杀 / 无子可动）后切结算。
        if (this.g.winner != 0) { this.router.Go("over"); }
    }

    override void Render(Canvas c, double alpha) {
        GuiHost host = this.router.Host();
        // Android 上表面晚于 Start 到达(转向/后台往返亦然),App 会整体
        // 换新画布对象(App.SwapCanvas);Start 时抓的引用画进已销毁的
        // 旧表面,永不 present。每帧对齐到宿主传入的当前画布。
        this.g.c = c;
        // 舞台 0 基绘制：原点落到标准标题栏之下，chrome 由宿主在
        // 内容之上叠画。帧首先把宿主延展后的舞台尺寸同步进 VW/VH，
        // 布局才能铺满整窗（宽窗多看宽度，不落 margin 空条）。
        this.g.SyncStage(host);
        CDraw.Origin(0, host.ContentTop());
        this.g.DrawPlay(Window.GetTickMs());
    }
}

// 结算：HTML 面板叠在定格的棋局上——Render 继续画对局画面（棋局已停，
// 画面定格），body 半透明压暗，按钮/文案由 HTML 层承担。
class XqOverScene : HtmlScene {
    XqGame g;
    Element headline;
    Element subEl;
    Element cheerEl;

    XqOverScene(XqGame g) { this.g = g; }

    override string HtmlFile() { return "assets/scenes/over.html"; }

    override void OnWire(HtmlHandlers handlers) {
        handlers.Add("again", () => this.router.Go("play"));
        handlers.Add("menu", () => this.router.Go("menu"));
    }

    override void OnEnter(Control root) {
        this.headline = XqOverScene.AsElement(root, "headline");
        this.subEl = XqOverScene.AsElement(root, "sub");
        this.cheerEl = XqOverScene.AsElement(root, "cheer");
        string head; string sub; string cheer;
        if (this.g.winner == 1) {
            head = "绝杀！红方胜";
            int gain = 15;
            if (this.g.mode > 0) { gain = 20; }
            sub = "+" + gain + " 段位分 · 现 " + this.g.prof.Title();
            cheer = "棋高一着，再战一盘！";
            if (this.g.prof.streak >= 3) { cheer = this.g.prof.streak + " 连胜！杀伐果断"; }
            if (this.g.mode > 0) { cheer = "残局功力见涨！"; }
        } else {
            head = "黑方得手";
            sub = "第 " + this.g.moveCount + " 手告负";
            cheer = "复盘关键一手，卷土重来！";
        }
        if (this.headline != null) { this.headline.SetText(head); }
        if (this.subEl != null) { this.subEl.SetText(sub); }
        if (this.cheerEl != null) { this.cheerEl.SetText(cheer); }
    }

    static Element AsElement(Control root, string id) {
        Control c = root.Find(id);
        if (c != null && c is Element) { return (Element)c; }
        return null;
    }

    override void Event(int kind, int key) {
        if (kind != 4) { return; }
        if (key == 27) { this.router.Go("menu"); }
        if (key == 13 || key == 32) { this.router.Go("play"); }
    }

    override void Render(Canvas c, double alpha) {
        GuiHost host = this.router.Host();
        this.g.c = c;
        this.g.SyncStage(host);
        CDraw.Origin(0, host.ContentTop());
        this.g.DrawPlay(Window.GetTickMs());
    }
}

class XqApp {
    static void Main() {
        // 手机竖屏：GuiHost 以逻辑宽高比定外壳方向（宽>高横屏，反之
        // 竖屏）。竖长逻辑舞台在桌面宽窗里经 StageViewport 居中留灰，
        // 手机上则满屏竖向铺满——两态共用一套 Portrait() 布局。
        SceneRouter router = SceneRouter.CreateFixed("象棋", 720, 1280, 16);
        XqGame g = XqGame.Create(router.Host());
        router.Register("menu", new XqMenuScene(g));
        router.Register("play", new XqPlayScene(g));
        router.Register("over", new XqOverScene(g));
        // demo 标记（xiangqi_demo.txt）直接进对局自弈供截图/无头验证。
        router.Run(g.demo ? "play" : "menu");
    }
}
