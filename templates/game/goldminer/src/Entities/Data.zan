using System;
using System.IO;
using Gui;
using Game.Kit;
using Game.Foundation.Gui;

public class Data {
    // 逻辑舞台尺寸：W 由宿主每帧按窗口比例延展（GuiHost.StageWidth，
    // 宽窗多看宽度、零黑边零变形），布局一律锚定 W；H 贴设计值。
    public static int W = 960;
    public const int H = 720;
    public static int HOOK_X = 480;  // 绳锚点横坐标（恒 W/2，帧首随 W 更新）
    public const int HOOK_Y = 150;  // 绳锚点(矿车口下缘)
    public const int SKY_H = 190;  // 天空/表土分界

    // 道具生成带的半宽：整体收在钩爪可达的中心区，宽屏（手机舞台
    // 延展到 1600）不再把道具铺到摆钩扫不到的贴边死角。半宽上限
    // 520 ≈ 爪在场地深处最大伸出量（25° 极角 × 556 绳长 ≈ ±503）
    // 外加一点余量；窄舞台（W=960）取满 W/2-40，行为不变。
    public static int HalfSpan() {
        int half = W / 2 - 40;
        if (half > 520) { half = 520; }
        if (half < 200) { half = 200; }
        return half;
    }

    // 字面量数组:静态初始化不跨单元,消除初始化顺序依赖
    public static ItemDef[] DEFS = ItemDef.All();

    public static string SavePath() {
        return Assets.ExeDir() + "/goldminer_save.txt";
    }

    // 音效加载:磁盘优先,内嵌直接内存加载(全程不落盘)
    public static AudioClip LoadWav2(string rel) {
        string p = Assets.Find(rel);
        AudioClip c = AudioClip.LoadWav(p);
        if (c != null && c.IsValid()) { return c; }
        if (File.EmbedExists(rel)) {
            byte[] b = File.ReadAllBytes(rel);
            c = AudioClip.LoadWavFromMem(b.ToStr(0, b.Length), b.Length);
        }
        return c;
    }

    // Zan 没有 int.Parse:逐位解析(可带负号)
    public static int ParseIntS(string s) {
        int v = 0;
        bool neg = false;
        for (int i = 0; i < s.Length; i = i + 1) {
            int c = s[i] & 255;
            if (c == 45 && i == 0) { neg = true; continue; }
            if (c < 48 || c > 57) { break; }
            v = v * 10 + (c - 48);
        }
        if (neg) { return -v; }
        return v;
    }
}

// 音效包
