using System;
using System.IO;
using Gui;

public class ItemDef {
    // const(编译期常量):避免跨单元静态初始化顺序问题
    public const int KIND_COUNT = 11;
    // 半径(碰撞,设计单位) / 重量(拉回速度分子) / 分值 / 是否垃圾(清连击)
    public int rad;
    public int weight;  // 收线权重:baseV = 720/(0.5+0.62w),越重拉越久
    public int score;
    public bool junk;  // 石头/骷髅:清空连击
    public string name;
    public string tex;  // 纹理基础名（如 "gold_s", "diamond" 等，消除并行纹理数组）
    public string assetPath;  // 解析出的资源文件路径（消除并行路径数组）
    public int texW;  // 处理后素材尺寸(渲染用)
    public int texH;

    public static ItemDef[] All() {
        ItemDef[] a = new ItemDef[11];
        a[0] = Mk(24, 5, 50, false, "小金块", "gold_s");
        a[1] = Mk(30, 9, 150, false, "金块", "gold_m");
        a[2] = Mk(38, 15, 400, false, "大金块", "gold_l");
        a[3] = Mk(26, 6, 600, false, "钻石", "diamond");
        a[4] = Mk(34, 12, 350, false, "宝箱", "chest");
        a[5] = Mk(30, 10, 0, false, "神秘袋", "bag");  // 0 = 开袋随机
        a[6] = Mk(34, 16, 20, true, "石头", "rock");
        a[7] = Mk(26, 8, 15, true, "骷髅", "skull");
        a[8] = Mk(30, 10, 0, false, "TNT", "tnt");  // 抓到即炸
        a[9] = Mk(24, 8, 0, false, "炸弹", "bomb");  // 抓到进入拆弹 QTE
        a[10] = Mk(18, 3, 120, false, "金币袋", "coin");  // 神秘袋开出物之一
        return a;
    }

    static ItemDef Mk(int rad, int weight, int score, bool junk, string name, string tex) {
        ItemDef d = new ItemDef();
        d.rad = rad; d.weight = weight; d.score = score;
        d.junk = junk; d.name = name; d.tex = tex;
        d.assetPath = "";
        d.texW = rad * 2; d.texH = rad * 2;  // 默认正方形,加载时按素材实比覆盖
        return d;
    }
}

// 场上的物品实例
