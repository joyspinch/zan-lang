using System;
using System.IO;
using Gui;
using Game.Kit;
using Game.Foundation.Gui;

public class Snd {
    public AudioClip swing;
    public AudioClip grab;
    public AudioClip reel;
    public AudioClip gold;
    public AudioClip coinS;
    public AudioClip boom;
    public AudioClip tntboom;
    public AudioClip tick;
    public AudioClip hurry;
    public AudioClip win;
    public AudioClip fail;
    public AudioClip bombtick;
    public AudioClip levelup;
    public bool on = true;

    public static Snd Create() {
        Snd s = new Snd();
        if (!Audio.Open()) { return s; }
        s.swing = Data.LoadWav2("assets/swing.wav");
        s.grab = Data.LoadWav2("assets/grab.wav");
        s.reel = Data.LoadWav2("assets/reel.wav");
        s.gold = Data.LoadWav2("assets/gold.wav");
        s.coinS = Data.LoadWav2("assets/coin.wav");
        s.boom = Data.LoadWav2("assets/boom.wav");
        s.tntboom = Data.LoadWav2("assets/tntboom.wav");
        s.tick = Data.LoadWav2("assets/tick.wav");
        s.hurry = Data.LoadWav2("assets/hurry.wav");
        s.win = Data.LoadWav2("assets/win.wav");
        s.fail = Data.LoadWav2("assets/fail.wav");
        s.bombtick = Data.LoadWav2("assets/bombtick.wav");
        s.levelup = Data.LoadWav2("assets/levelup.wav");
        // 预热声卡:zan_audio_play 首次被调时才同步打开物理音频设备
        // (WASAPI 上实测可达 ~500ms)。不做这一步,设备开启的开销正好
        // 落在玩家第一次发射的那一帧,表现为"按下第一次发射就很卡"。
        // 启动期以 0 音量播一声,把设备初始化移出对局;voice 播完自动回收。
        s.Play(s.swing, 0.0);
        return s;
    }

    public void Play(AudioClip c, double gain) {
        if (!this.on || c == null || !c.IsValid()) { return; }
        c.Play(gain, 0);
    }
}
