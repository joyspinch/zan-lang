// Gold Miner — 黄金矿工:数据/渲染/输入与无头自测。
// GuiHost 版:窗口/事件/呈现走 Game.Foundation.Gui,场景与兜底 HUD
// 全部经 Canvas 直绘(Game.Kit CDraw/CText,自带 SDL 版曾用的
// 超采样离屏一概不需要);顶栏/结算/拆弹走场景层自绘(原 Gui 控件
// 树 HUD 依赖 GameHud 的 SDL 合成链路,画布版统一收敛到兜底 HUD,
// 信息两档:厘秒倒计时 + 结算后续提示)。音频走原生 zan_audio
// (System.Audio/AudioClip,P2 原生音频已落地,与 wuwei
// AudioService 同一先例),Snd.Open 失败自动哑火不碍运行。
using System;
using System.IO;
using Gui;
using Game.Kit;
using Game.Foundation.Gui;

namespace GoldMiner;

// 静态数据与工具
class Data {
    // 逻辑舞台尺寸：W 由宿主每帧按窗口比例延展（GuiHost.StageWidth，
    // 宽窗多看宽度、零黑边零变形），布局一律锚定 W；H 贴设计值。
    public static int W = 960;
    public const int H = 720;
    public static int HOOK_X = 480;     // 绳锚点横坐标（恒 W/2，帧首随 W 更新）
    public const int HOOK_Y = 150;      // 绳锚点(矿车口下缘)
    public const int SKY_H = 190;       // 天空/表土分界

    // 道具生成带的半宽：整体收在钩爪可达的中心区，宽屏（手机舞台
    // 延展到 1600）不再把道具铺到摆钩扫不到的贴边死角。半宽上限
    // 520 ≈ 爪在场地深处最大伸出量（25° 极角 × 556 绳长 ≈ ±503）
    // 外加一点余量；窄舞台（W=960）取满 W/2-40，行为不变。
    public static int HalfSpan() {
        int half = W / 2 - 40;
        if (half > 520) { half = 520; }
        if (half < 200) { half = 200; }
        return half;
    }

    // 字面量数组:静态初始化不跨单元,消除初始化顺序依赖
    public static ItemDef[] DEFS = ItemDef.All();

    public static string SavePath() {
        return Assets.ExeDir() + "/goldminer_save.txt";
    }

    // 音效加载:磁盘优先,内嵌直接内存加载(全程不落盘)
    public static AudioClip LoadWav2(string rel) {
        string p = Assets.Find(rel);
        AudioClip c = AudioClip.LoadWav(p);
        if (c != null && c.IsValid()) { return c; }
        if (File.EmbedExists(rel)) {
            byte[] b = File.ReadAllBytes(rel);
            c = AudioClip.LoadWavFromMem(b.ToStr(0, b.Length), b.Length);
        }
        return c;
    }

    // Zan 没有 int.Parse:逐位解析(可带负号)
    public static int ParseIntS(string s) {
        int v = 0;
        bool neg = false;
        for (int i = 0; i < s.Length; i = i + 1) {
            int c = s[i] & 255;
            if (c == 45 && i == 0) { neg = true; continue; }
            if (c < 48 || c > 57) { break; }
            v = v * 10 + (c - 48);
        }
        if (neg) { return -v; }
        return v;
    }
}

// 音效包
class Snd {
    public AudioClip swing;
    public AudioClip grab;
    public AudioClip reel;
    public AudioClip gold;
    public AudioClip coinS;
    public AudioClip boom;
    public AudioClip tntboom;
    public AudioClip tick;
    public AudioClip hurry;
    public AudioClip win;
    public AudioClip fail;
    public AudioClip bombtick;
    public AudioClip levelup;
    public bool on = true;

    public static Snd Create() {
        Snd s = new Snd();
        if (!Audio.Open()) { return s; }
        s.swing = Data.LoadWav2("assets/swing.wav");
        s.grab = Data.LoadWav2("assets/grab.wav");
        s.reel = Data.LoadWav2("assets/reel.wav");
        s.gold = Data.LoadWav2("assets/gold.wav");
        s.coinS = Data.LoadWav2("assets/coin.wav");
        s.boom = Data.LoadWav2("assets/boom.wav");
        s.tntboom = Data.LoadWav2("assets/tntboom.wav");
        s.tick = Data.LoadWav2("assets/tick.wav");
        s.hurry = Data.LoadWav2("assets/hurry.wav");
        s.win = Data.LoadWav2("assets/win.wav");
        s.fail = Data.LoadWav2("assets/fail.wav");
        s.bombtick = Data.LoadWav2("assets/bombtick.wav");
        s.levelup = Data.LoadWav2("assets/levelup.wav");
        // 预热声卡:zan_audio_play 首次被调时才同步打开物理音频设备
        // (WASAPI 上实测可达 ~500ms)。不做这一步,设备开启的开销正好
        // 落在玩家第一次发射的那一帧,表现为"按下第一次发射就很卡"。
        // 启动期以 0 音量播一声,把设备初始化移出对局;voice 播完自动回收。
        s.Play(s.swing, 0.0);
        return s;
    }

    public void Play(AudioClip c, double gain) {
        if (!this.on || c == null || !c.IsValid()) { return; }
        c.Play(gain, 0);
    }
}

class MinerApp {
    public GuiHost host;
    public Canvas c;
    public World w;
    public Snd snd;
    public Rng uiRng;

    public long now;

    // 纹理路径(assets 定位;null = 缺失,画矢量兜底)
    public string bgPath;
    public string minerPath;
    // 新美术(gpt-image-2 手绘,*2 文件名;旧资产名一律不动,缺则回退旧图)
    public string campPath2;            // 天空带画面(0..SKY_H)
    public string minePath2;            // 地层画面(SKY_H..H)
    public string topPath2;             // 顶栏木牌横幅
    public string resultPath2;          // 结算羊皮纸面板
    public string glowPath2;            // 柔光晕(拆弹警示底光)
    public string dynPath2;             // 炸药随身包图标(顶栏)
    public string bombPath2;            // 拆弹弹体(拆弹面板)

    // 计时
    public long lastFrameAt;
    public int lastBombTickSec = -1;
    public int lastTenSecTick = -1;
    public int lastBoomSeq = 0;         // 已播声的爆炸事件序号
    // 素材实比(加载期从 PNG 头读出)
    public int minerW = 120;
    public int minerH = 200;
    public int clawH = 66;

    public static MinerApp Create(GuiHost h) {
        MinerApp a = new MinerApp();
        a.host = h;
        a.c = h.App().canvas;
        // 首帧前先按宿主真实舞台同步 W/HOOK_X：此前 NewRun 的 Populate
        // 用的是 W=960 默认值，而手机舞台已延展到 ~1600，首关道具全铺
        // 在实际场地左侧 960 内，看起来"道具都在左边"。
        int sw = h.StageWidth();
        if (sw > 0) { Data.W = sw; }
        Data.HOOK_X = Data.W / 2;
        a.uiRng = Rng.Seed(20260904L);
        a.bgPath = MinerApp.FindAsset("assets/bg.jpg");
        // 新美术优先(*2 文件名),旧资产名一律不动,缺则逐级回退旧图
        a.campPath2 = MinerApp.FindAsset("assets/camp2.png");
        a.minePath2 = MinerApp.FindAsset("assets/mine2.png");
        a.topPath2 = MinerApp.FindAsset("assets/top2.png");
        a.resultPath2 = MinerApp.FindAsset("assets/result2.png");
        a.glowPath2 = MinerApp.FindAsset("assets/glow2.png");
        a.dynPath2 = MinerApp.FindAsset("assets/dyn2.png");
        a.bombPath2 = MinerApp.FindAsset("assets/bomb2.png");
        a.minerPath = MinerApp.FindAsset("assets/miner2.png");
        if (a.minerPath == null) {
            a.minerPath = MinerApp.FindAsset("assets/miner.png");
        }
        for (int i = 0; i < ItemDef.KIND_COUNT; i = i + 1) {
            ItemDef d = Data.DEFS[i];
            d.assetPath = MinerApp.FindAsset("assets/" + d.tex + "2.png");
            if (d.assetPath == null) {
                d.assetPath = MinerApp.FindAsset("assets/" + d.tex + ".png");
            }
        }
        a.w = new World();
        a.w.rng = Rng.Seed((int)(DateTime.UtcNow().ToUnixSeconds() & 2147483647));
        a.w.Load();
        a.w.NewRun(a.w.rng);
        a.snd = Snd.Create();
        a.lastFrameAt = World.NowMs();
        // 按 PNG 头实比覆盖每个物品的绘制尺寸(保宽比,长边 = rad*2)
        int[] wh = new int[2];
        for (int i = 0; i < ItemDef.KIND_COUNT; i = i + 1) {
            ItemDef d = Data.DEFS[i];
            if (d.assetPath == null) { continue; }
            if (MinerApp.PngSize(d.assetPath, wh)) {
                int longEdge = d.rad * 2;
                if (wh[0] >= wh[1]) {
                    d.texW = longEdge;
                    d.texH = longEdge * wh[1] / wh[0];
                } else {
                    d.texH = longEdge;
                    d.texW = longEdge * wh[0] / wh[1];
                }
            }
        }
        // 矿工贴地站立:脚踩草地线,头顶让出兜底 HUD 顶栏带(此前
        // 头盔被顶栏罩住)。
        if (a.minerPath != null) {
            int[] mw = new int[2];
            if (MinerApp.PngSize(a.minerPath, mw)) {
                a.minerH = Data.SKY_H - 54;
                a.minerW = a.minerH * mw[0] / mw[1];
            }
        }
        return a;
    }

    static string FindAsset(string rel) {
        string p = Assets.Find(rel);
        if (!File.Exists(p)) { return null; }
        return p;
    }

    // 读 PNG 头 IHDR 取尺寸(大端)。素材由构建管线统一生成,尺寸可靠;
    // 解析失败返回 false,调用方退回正方形假设。
    static bool PngSize(string path, int[] outWH) {
        outWH[0] = 0; outWH[1] = 0;
        if (path == null || !File.Exists(path)) { return false; }
        byte[] b = File.ReadAllBytes(path);
        if (b.Length < 24) { return false; }
        if (b[0] != 137 || b[1] != 80 || b[2] != 78 || b[3] != 71) { return false; }
        outWH[0] = (b[16] & 255) << 24 | (b[17] & 255) << 16
                 | (b[18] & 255) << 8 | (b[19] & 255);
        outWH[1] = (b[20] & 255) << 24 | (b[21] & 255) << 16
                 | (b[22] & 255) << 8 | (b[23] & 255);
        return outWH[0] > 0 && outWH[1] > 0;
    }

    // 全出血横带 cover：把 path 按目标带纵横比裁一块铺满 (dw,dh)，
    // focus 0..1 选纵向取景位(0 顶 1 底)。ddz BlitCover 同款，多一个
    // 取景参数——营地/地层各取画面信息最厚的横带，不留 letterbox。
    static void BlitBand(Canvas c, string path, int dx, int dy, int dw, int dh,
                         double focus) {
        int iw = Canvas.ImageWidth(path);
        int ih = Canvas.ImageHeight(path);
        if (iw <= 0 || ih <= 0) { return; }
        int sw = iw;
        int sh = sw * dh / dw;
        if (sh > ih) { sh = ih; sw = sh * dw / dh; }
        int sy = (int)((ih - sh) * focus);
        string src = CDraw.BlitSource(c, path);
        if (src == null) { return; }
        c.BlitImage(src, CDraw.MapX(dx + CDraw.originX),
                    CDraw.MapY(dy + CDraw.originY),
                    CDraw.MapW(dw), CDraw.MapW(dh),
                    (iw - sw) / 2, sy, sw, sh);
    }

    // ---------------------------------------------------------------
    // 逻辑推进
    // ---------------------------------------------------------------
    public void StepFrame(int dtMs) {
        this.w.Step(dtMs);
        World w = this.w;
        // 音效钩子
        if (w.state == World.ST_BOMB) {
            int sec = w.bombTimeLeft / 300;
            if (sec != this.lastBombTickSec) {
                this.lastBombTickSec = sec;
                this.snd.Play(this.snd.bombtick, 0.5);
            }
        }
        // 爆炸声:World 只记事件序号(boomSeq)与音色(boomTnt),
        // 宿主每帧轮询补声——TNT 连锁/玩家炸药/拆弹失败共用一条通道。
        if (w.boomSeq != this.lastBoomSeq) {
            this.lastBoomSeq = w.boomSeq;
            this.snd.Play(w.boomTnt != 0 ? this.snd.tntboom : this.snd.boom, 0.8);
        }
        if (w.hurryPlayed && w.timeLeftMs > 0 && w.state != World.ST_RESULT) {
            int sec = w.timeLeftMs / 1000;
            if (sec <= 10 && sec != this.lastTenSecTick) {
                this.lastTenSecTick = sec;
                this.snd.Play(this.snd.tick, 0.5);
            }
        }
    }

    // 输入触发(点击/空格/下/回车)
    public void OnActionKey() {
        World w = this.w;
        if (w.state == World.ST_RESULT) {
            if (w.ConfirmResult()) {
                if (w.levelResult > 0) {
                    this.snd.Play(this.snd.levelup, 0.7);
                }
            }
            return;
        }
        if (w.state == World.ST_SWING) {
            this.snd.Play(this.snd.swing, 0.5);
        } else if (w.state == World.ST_QTE || w.state == World.ST_BOMB) {
            this.snd.Play(this.snd.grab, 0.35);
        }
        w.Action();
    }

    public void OnDynamiteKey() {
        if (this.w.UseDynamite()) {
            this.snd.Play(this.snd.boom, 0.8);
            this.w.Float("炸掉了!", Data.HOOK_X, Data.HOOK_Y + 120, 255, 170, 80);
        }
    }

    // ---------------------------------------------------------------
    // 场景渲染(游戏世界 + 兜底 HUD,全部 Canvas 直绘)
    // ---------------------------------------------------------------
    public void DrawAll() {
        int w = Data.W;
        int h = Data.H;
        Canvas rd = this.c;
        World wo = this.w;
        // 震屏偏移
        int ox = 0;
        int oy = 0;
        if (wo.shakeFrames > 0) {
            ox = this.uiRng.Range(-wo.shakeMag, wo.shakeMag + 1) / 8;
            oy = this.uiRng.Range(-wo.shakeMag, wo.shakeMag + 1) / 8;
        }
        // 背景:天空带 + 地层带双横带 cover(接缝压在 SKY_H 草地线下,
        // 8px 交叠防震屏露缝);新图缺失回退旧整图,再缺回退渐变
        if (this.campPath2 != null && this.minePath2 != null) {
            MinerApp.BlitBand(rd, this.campPath2, ox, oy, w, Data.SKY_H + 8,
                              0.55);
            MinerApp.BlitBand(rd, this.minePath2, ox, oy + Data.SKY_H - 8, w,
                              h - Data.SKY_H + 8, 0.5);
        } else if (this.bgPath != null) {
            CDraw.BlitImage(rd, this.bgPath, ox, oy, w, h);
        } else {
            CDraw.FillVGrad(rd, 0, 0, w, h, CDraw.Argb(255, 96, 140, 200),
                            CDraw.Argb(255, 60, 40, 28));
        }
        // FEVER 热浪(>=3 连击:边缘暖光)
        if (wo.feverGlow > 0) {
            int ga = wo.feverGlow * 55 / 100;
            CDraw.RingRect(rd, ox + 2, oy + 2, w - 4, h - 4, 8, 255,
                           170 - ga / 3, 60, ga);
        }
        // 物品
        for (int i = 0; i < wo.items.Count; i = i + 1) {
            Item it = wo.items[i];
            if (!it.alive) { continue; }
            ItemDef d = Data.DEFS[it.kind];
            string tp = d.assetPath;
            double fy = Math.Sin(it.wob + this.now / 480.0) * 2.0;
            if (tp != null) {
                int dw = d.texW;
                int dh = d.texH;
                CDraw.BlitImage(rd, tp, ox + it.x - dw / 2,
                                oy + it.y - dh / 2 + (int)fy, dw, dh);
            } else {
                CDraw.FillCircle(rd, ox + it.x, oy + it.y + (int)fy, d.rad,
                                 200, 170, 60, 255);
            }
        }
        // 绳 + 爪 + 钩上物
        this.DrawClaw(ox, oy);
        // 矿工(双脚踩草地线 SKY_H,头部完整在画内)
        if (this.minerPath != null) {
            int mw = this.minerW;
            int mh = this.minerH;
            CDraw.BlitImage(rd, this.minerPath, ox + Data.HOOK_X - mw / 2,
                            oy + Data.SKY_H + 6 - mh, mw, mh);
        } else {
            CDraw.FillCircle(rd, ox + Data.HOOK_X, oy + Data.HOOK_Y - 40, 34,
                             220, 160, 60, 255);
        }
        // 粒子
        for (int i = 0; i < wo.parts.Count; i = i + 1) {
            Particle p = wo.parts[i];
            int a = p.life * 255 / p.maxLife;
            CDraw.FillRect(rd, ox + (int)p.x - p.size / 2,
                           oy + (int)p.y - p.size / 2, p.size, p.size,
                           CDraw.Argb(a, p.r, p.g, p.b));
        }
        // 飘字(得分/提示,属于游戏世界的演出)
        for (int i = 0; i < wo.texts.Count; i = i + 1) {
            FloatText ft = wo.texts[i];
            int a = ft.life * 255 / 70;
            CText.DrawCenteredShadow(rd, ft.text, ox + ft.x, oy + ft.y - 20, 3,
                                     ft.r, ft.g, ft.b, a > 255 ? 255 : a);
        }
        // 场景内 QTE 圈(圈心跟着爪走,必须画在场景层)
        if (wo.state == World.ST_QTE) { this.DrawQte(ox, oy); }
        // 兜底 HUD:半透明顶栏(关卡/金币/进度/倒计时/炸药) + 结算与
        // 拆弹信息,保证游戏数据始终可读。
        this.DrawFallbackHud(ox, oy);
        // 爆炸白闪
        if (wo.flashFrames > 0) {
            int fa = wo.flashFrames * 38;
            if (fa > 255) { fa = 255; }
            CDraw.FillRect(rd, 0, 0, w, h, CDraw.Argb(fa, 255, 245, 220));
        }
    }

    // 场景层兜底 HUD:半透明顶栏(关卡/金币/进度/倒计时/炸药) +
    // 结算与拆弹覆盖。文本与场景飘字同一套 CText(系统字体,全 CJK
    // 带投影)。倒计时给到厘秒(原 Gui 控件树 HUD 同档,时间感知更紧)。
    void DrawFallbackHud(int ox, int oy) {
        Canvas rd = this.c;
        World wo = this.w;
        int pct = wo.Target() > 0 ? wo.gold * 100 / wo.Target() : 0;
        if (pct > 100) { pct = 100; }
        // 顶栏:木牌横幅画打底(全宽 cover),轻压暗保文字对比;缺图回退
        // 半透明黑条。文字信息两版一致。
        if (this.topPath2 != null) {
            MinerApp.BlitBand(rd, this.topPath2, ox, oy, Data.W, 48, 0.5);
            CDraw.FillRect(rd, ox, oy, Data.W, 46, CDraw.Argb(110, 12, 14, 20));
        } else {
            CDraw.FillRect(rd, ox, oy, Data.W, 46, CDraw.Argb(215, 12, 14, 20));
        }
        CDraw.FillRect(rd, ox, oy + 46, Data.W, 2, CDraw.Argb(255, 138, 111, 51));
        CText.DrawShadow(rd, "第 " + Convert.ToString(wo.level) + " 关",
                         ox + 16, oy + 10, 2, 232, 226, 212, 255);
        CText.DrawShadow(rd, "$" + Convert.ToString(wo.gold) + "/"
                         + Convert.ToString(wo.Target()),
                         ox + 140, oy + 10, 2, 244, 208, 120, 255);
        CDraw.FillRect(rd, ox + 360, oy + 17, 200, 12, CDraw.Argb(255, 40, 44, 56));
        CDraw.FillRect(rd, ox + 360, oy + 19, 196 * pct / 100, 8,
                       CDraw.Argb(255, 111, 170, 94));
        // 右侧从右往左排(倒计时/连击/炸药),量宽定位互不重叠
        int totalCs = (wo.timeLeftMs + 5) / 10;
        int cs = totalCs % 100;
        bool urgent = totalCs <= 1000;
        int xr = ox + Data.W - 16;
        string dtxt = "Q 炸药 x" + Convert.ToString(wo.dynamites);
        int dw = CText.Width(dtxt, 2);
        if (this.dynPath2 != null) {
            int isz = 26;                       // 炸药随身包(161x200 实比)
            CDraw.BlitImage(rd, this.dynPath2, xr - dw - 8 - isz * 161 / 200,
                            oy + 8, isz * 161 / 200, isz);
        }
        CText.DrawShadow(rd, dtxt, xr - dw, oy + 10, 2, 200, 194, 174, 255);
        xr = xr - dw - 28;
        string ttxt = "剩余 " + Convert.ToString(totalCs / 100) + "." +
                      (cs < 10 ? "0" : "") + Convert.ToString(cs) + " 秒";
        int tw = CText.Width(ttxt, 2);
        CText.DrawShadow(rd, ttxt, xr - tw, oy + 10, 2,
                         urgent ? 250 : 232,
                         urgent ? 120 : 226,
                         urgent ? 96 : 212, 255);
        xr = xr - tw - 28;
        if (wo.combo >= 2) {
            string ctxt = "连击 x" + Convert.ToString(wo.combo);
            int cw = CText.Width(ctxt, 2);
            CText.DrawShadow(rd, ctxt, xr - cw, oy + 10, 2, 240, 176, 80, 255);
        }
        // 拆弹覆盖
        if (wo.state == World.ST_BOMB) {
            CDraw.FillRect(rd, ox + Data.W / 2 - 170, oy + 230, 340, 150,
                           CDraw.Argb(205, 10, 12, 17));
            CDraw.FillRect(rd, ox + Data.W / 2 - 170, oy + 230, 340, 3,
                           CDraw.Argb(255, 192, 85, 63));
            int tx = ox + Data.W / 2;
            if (this.bombPath2 != null) {
                // 弹体贴面板左侧,柔光晕按帧缩放脉动;文字整体右移让位
                int bw = 72 * 277 / 340;        // 弹体(277x340 实比)
                int bx = ox + Data.W / 2 - 156;
                int by = oy + 269;
                if (this.glowPath2 != null) {
                    int g = 150 + (int)(Math.Sin(this.now / 110.0) * 12.0);
                    CDraw.BlitImage(rd, this.glowPath2,
                                    bx + bw / 2 - g / 2, by + 36 - g / 2, g, g);
                }
                CDraw.BlitImage(rd, this.bombPath2, bx, by, bw, 72);
                tx = tx + 30;
            }
            CText.DrawCenteredShadow(rd, "疯狂点击! 拆除炸弹!",
                                     tx, oy + 252, 3,
                                     240, 176, 80, 255);
            CText.DrawCenteredShadow(rd, Convert.ToString(wo.bombClicks) + "/"
                                     + Convert.ToString(wo.bombNeed) + "    "
                                     + Convert.ToString(wo.bombTimeLeft / 1000 + 1)
                                     + " 秒",
                                     tx, oy + 312, 2,
                                     232, 226, 212, 255);
        }
        // 结算覆盖
        if (wo.state == World.ST_RESULT) {
            bool win = wo.levelResult > 0;
            if (this.resultPath2 != null) {
                // 羊皮纸面板打底(460x210 ≈ 1024x468 实比),轻压暗保文字
                CDraw.BlitImage(rd, this.resultPath2, ox + Data.W / 2 - 230,
                                oy + 200, 460, 210);
                CDraw.FillRect(rd, ox + Data.W / 2 - 230, oy + 200, 460, 210,
                               CDraw.Argb(60, 10, 12, 17));
            } else {
                CDraw.FillRect(rd, ox + Data.W / 2 - 230, oy + 200, 460, 210,
                               CDraw.Argb(205, 10, 12, 17));
            }
            CDraw.FillRect(rd, ox + Data.W / 2 - 230, oy + 200, 460, 3,
                           CDraw.Argb(255, win ? 111 : 192,
                                      win ? 170 : 85, win ? 94 : 63));
            CText.DrawCenteredShadow(rd, win ? "过关!" : "时间到!",
                                     ox + Data.W / 2, oy + 224, 4,
                                     232, 226, 212, 255);
            CText.DrawCenteredShadow(rd, "本关 $" + Convert.ToString(wo.gold)
                                     + " / 目标 $" + Convert.ToString(wo.Target()),
                                     ox + Data.W / 2, oy + 296, 2,
                                     244, 208, 120, 255);
            CText.DrawCenteredShadow(rd, "累计 $" + Convert.ToString(wo.totalGold),
                                     ox + Data.W / 2, oy + 334, 2,
                                     232, 226, 212, 255);
            CText.DrawCenteredShadow(rd, win
                                     ? "点击继续 → 第 " + Convert.ToString(wo.level + 1) + " 关"
                                     : "点击重新开始",
                                     ox + Data.W / 2, oy + 372, 2,
                                     200, 194, 178, 255);
        }
    }

    // 爪与绳。画布没有旋转贴图,爪改为随摆角旋转的矢量三爪钩
    // (钢毂 + 绿灯 + 三枚弯钳),铰点/绳头几何与纹理版同一约定。
    void DrawClaw(int ox, int oy) {
        Canvas rd = this.c;
        World wo = this.w;
        double rad = wo.angle * Math.PI / 180.0;
        double ca = Math.Cos(rad);
        double sa = Math.Sin(rad);
        int cx = ox + Data.HOOK_X + (int)(ca * wo.clawLen);
        int cy = oy + Data.HOOK_Y + (int)(sa * wo.clawLen);
        // 爪顶铰点(绿点)= 爪心 - 指向方向·ch/2。与伸出判定同一约定:
        // 指向方向 (cosA,sinA),铰点始终在其反方向 ch/2 处。
        int ch = this.clawH;
        int h2 = ch / 2;
        int ex = cx - (int)(ca * h2);
        int ey = cy - (int)(sa * h2);
        // 绳:绞车卷筒(即摆动圆心 HOOK_X,HOOK_Y)→ 爪铰点,一条绷直
        // 的绳。摆动的爪绕圆心走圆弧,绳只有与爪同圆心才始终对准铰
        // 点。但线头不能从圆心(机身内部)画起:起点裁剪到机身包围盒
        // 的出射点,视觉上从抓钩机底部钻出。
        int sx0 = ox + Data.HOOK_X;
        int sy0 = oy + Data.HOOK_Y;
        // 机身包围盒:矿工贴图立在 SKY_H 草地线上,机顶压在顶栏下缘
        // (兜底 HUD 顶栏 46px)。
        int bodyTop = oy + 45;
        int bodyBottom = oy + Data.SKY_H + 6;
        int bodyHalf = (this.minerW + 1) / 2;
        int bodyLeft = ox + Data.HOOK_X - bodyHalf;
        int bodyRight = ox + Data.HOOK_X + bodyHalf;
        // 沿 (dx,dy)=圆心→铰点方向从圆心走参数 t∈[0,1],取与包围盒
        // 的最后一个交点(最大 t)为线头;圆心在盒内,必有交点。
        int dx = ex - sx0;
        int dy = ey - sy0;
        double tBest = 0.0;
        if (dx != 0) {
            double tx = dx > 0 ? (double)(bodyRight - sx0) / dx
                               : (double)(bodyLeft - sx0) / dx;
            if (tx > tBest) { tBest = tx; }
        }
        if (dy != 0) {
            double ty = dy > 0 ? (double)(bodyBottom - sy0) / dy
                               : (double)(bodyTop - sy0) / dy;
            if (ty > tBest) { tBest = ty; }
        }
        if (tBest < 0.0) { tBest = 0.0; }
        if (tBest > 1.0) { tBest = 1.0; }
        int sx = sx0 + (int)(dx * tBest);
        int sy = sy0 + (int)(dy * tBest);
        // 两遍绳身:深棕粗底 + 浅棕细面,土色背景上可读
        CDraw.Line(rd, sx, sy, ex, ey, 4, 74, 56, 38, 255);
        CDraw.Line(rd, sx, sy, ex, ey, 2, 128, 100, 66, 255);
        // 矢量爪:局部 (u,v) 坐标,v+ = 指向方向(90° 时向下),
        // 世界 = 爪心 + u·(-sinA,cosA) + v·(cosA,sinA)。
        // 三枚弯钳(左右对称 + 中央爪尖),再盖钢毂与绿灯。
        int p1x = cx + (int)(-6 * -sa + -2 * ca);
        int p1y = cy + (int)(-6 * ca + -2 * sa);
        int p2x = cx + (int)(-17 * -sa + 8 * ca);
        int p2y = cy + (int)(-17 * ca + 8 * sa);
        int p3x = cx + (int)(-10 * -sa + 22 * ca);
        int p3y = cy + (int)(-10 * ca + 22 * sa);
        // 左钳两段
        CDraw.Line(rd, p1x, p1y, p2x, p2y, 3, 156, 162, 176, 255);
        CDraw.Line(rd, p2x, p2y, p3x, p3y, 3, 156, 162, 176, 255);
        // 右钳(镜像 u)
        int q1x = cx + (int)(6 * -sa + -2 * ca);
        int q1y = cy + (int)(6 * ca + -2 * sa);
        int q2x = cx + (int)(17 * -sa + 8 * ca);
        int q2y = cy + (int)(17 * ca + 8 * sa);
        int q3x = cx + (int)(10 * -sa + 22 * ca);
        int q3y = cy + (int)(10 * ca + 22 * sa);
        CDraw.Line(rd, q1x, q1y, q2x, q2y, 3, 156, 162, 176, 255);
        CDraw.Line(rd, q2x, q2y, q3x, q3y, 3, 156, 162, 176, 255);
        // 中央爪尖
        int m1x = cx + (int)(0 * -sa + 2 * ca);
        int m1y = cy + (int)(0 * ca + 2 * sa);
        int m2x = cx + (int)(0 * -sa + 24 * ca);
        int m2y = cy + (int)(0 * ca + 24 * sa);
        CDraw.Line(rd, m1x, m1y, m2x, m2y, 5, 120, 126, 140, 255);
        // 钢毂 + 亮边 + 绿灯(灯在铰点侧,即指向反方向)
        CDraw.FillCircle(rd, cx, cy, 9, 70, 74, 86, 255);
        CDraw.CircleStroke(rd, cx, cy, 9, 2, 150, 156, 170, 255);
        int lx = cx - (int)(11 * ca);
        int ly = cy - (int)(11 * sa);
        CDraw.FillCircle(rd, lx, ly, 3, 110, 235, 120, 255);
        // 钩上物挂在爪钳里:中心在爪心指向方向 0.58 爪高处,随摆角
        // 转动(贴图保持直立)。
        if (wo.hookedKind >= 0) {
            ItemDef d = Data.DEFS[wo.hookedKind];
            string tp = d.assetPath;
            int jr = ch * 58 / 100;
            int jx = cx + (int)(ca * jr);
            int jy = cy + (int)(sa * jr);
            if (tp != null) {
                CDraw.BlitImage(rd, tp, jx - d.texW / 2, jy - d.texH / 2,
                                d.texW, d.texH);
            } else {
                CDraw.FillCircle(rd, jx, jy, d.rad, 200, 170, 60, 255);
            }
        }
    }

    void DrawQte(int ox, int oy) {
        Canvas rd = this.c;
        World wo = this.w;
        double rad = wo.angle * Math.PI / 180.0;
        int cx = ox + Data.HOOK_X + (int)(Math.Cos(rad) * wo.clawLen);
        int cy = oy + Data.HOOK_Y + (int)(Math.Sin(rad) * wo.clawLen);
        // 金圈(命中区)
        CDraw.CircleStroke(rd, cx, cy, 44, 2, 255, 210, 80, 255);
        // 白圈(收缩)
        int wr = (int)wo.qteRing;
        if (wr < 8) { wr = 8; }
        CDraw.CircleStroke(rd, cx, cy, wr, 2, 255, 255, 255, 235);
        // 进度点
        for (int i = 0; i < wo.qteNeed; i = i + 1) {
            int dx = cx - wo.qteNeed * 10 + i * 20 + 5;
            if (i < wo.qteDone) {
                CDraw.FillCircle(rd, dx, cy + 74, 6, 130, 240, 120, 255);
            } else {
                CDraw.FillCircle(rd, dx, cy + 74, 6, 70, 70, 80, 255);
            }
        }
        // 操作提示(圈心过深时画到圈上方)
        int hy = cy + 96;
        if (hy > Data.H - 20) { hy = cy - 74; }
        CText.DrawCenteredShadow(rd, "白圈缩进金圈时点击!", cx, hy, 2,
                                 232, 226, 212, 255);
    }

    // ---------------------------------------------------------------
    // 入口与无头自测
    // ---------------------------------------------------------------
    static int Main(string[] args) {
        // 文字脸:圆体(幼圆)比系统 UI 字体更配游戏画风;机器上没有
        // 幼圆时 GDI 字体链接自动回退系统默认。运行库首次建字体时
        // 读一次该变量。
        Environment.SetEnvironmentVariable("ZAN_GUI_FONT_FACE", "幼圆");
        // 无头平衡仿真:自动打 8 关,校验经济曲线与状态机(不建窗口)
        if (ProcessHost.Env("MINER_SIM") == "1") {
            return MinerApp.SimRun();
        }
        GuiHost host = new GuiHost("黄金矿工", Data.W, Data.H, 16);
        host.Run(new MnLoop());
        return 0;
    }

    // 无头仿真:模拟一个"会连点的中等玩家"打关,输出经济快照 + 不变量检查。
    // MINER_SIM_SEED 覆盖随机种子(默认 424242),便于多种子回归。
    static int SimRun() {
        StreamWriter log = new StreamWriter("miner_sim.log");
        long seed = 424242L;
        string seedEnv = ProcessHost.Env("MINER_SIM_SEED");
        if (seedEnv != null && seedEnv.Length > 0) {
            seed = Data.ParseIntS(seedEnv);
        }
        log.WriteLine("=== MINER_SIM headless seed=" + seed + " ===");
        World w = new World();
        w.rng = Rng.Seed(seed);
        w.NewRun(w.rng);
        bool allOk = true;
        int wonLevels = 0;
        for (int lv = 1; lv <= 8; lv = lv + 1) {
            if (lv > 1) {
                // 与真实流程一致:上一关结算确认后才进入下一关
                // (ConfirmResult 里 level+1)。SIM 每关限时从 L1 拍起,
                // 这里按 w.level 对齐,失败即停。
                if (w.level != lv) { break; }
            }
            w.StartLevel();
            int target = w.Target();
            int field = 0;
            for (int i = 0; i < w.items.Count; i = i + 1) {
                ItemDef d = Data.DEFS[w.items[i].kind];
                if (!d.junk && d.score > 0) { field = field + d.score; }
            }
            log.WriteLine("L" + w.level + " target=" + target
                          + " items=" + w.items.Count
                          + " field=" + field
                          + " need=" + (field > 0 ? target * 100 / field : 0) + "%"
                          + " swing=" + (int)w.angDir);
            // 模拟:60fps 推进,贪心策略 —— 摆到有价物角度就放钩。
            // 前摇:真实玩家会等扫过几轮看清全场再出手;AI 预热 2 秒,
            // 且目标价 < 120 的小鱼不碰,省下收线时间。
            int frames = w.LevelTimeMs() / 16;
            int captured = 0;
            for (int f = 0; f < frames && w.state != World.ST_RESULT; f = f + 1) {
                // 简单 AI:沿整条摆动射线扫描(120..600),选射线近旁最优目标
                if (w.state == World.ST_SWING) {
                    double rad = w.angle * Math.PI / 180.0;
                    Item best = null;
                    int bestScore = 0;
                    if (f > 120) {
                        for (int i = 0; i < w.items.Count; i = i + 1) {
                            Item it = w.items[i];
                            if (!it.alive) { continue; }
                            int dx = it.x - Data.HOOK_X;
                            int dy = it.y - Data.HOOK_Y;
                            // 物品在射线上的投影长度与垂距
                            double proj = dx * Math.Cos(rad) + dy * Math.Sin(rad);
                            if (proj < 110.0 || proj > 620.0) { continue; }
                            double perp = Math.Abs(-dx * Math.Sin(rad)
                                                   + dy * Math.Cos(rad));
                            if (perp > 26.0) { continue; }   // 爪半径内才算可抓
                            int sc = Data.DEFS[it.kind].score;
                            if (it.kind == 8 || it.kind == 9) { sc = -1; } // 避开
                            // 终局放宽:收线要好几秒,小鱼平时不值当;
                            // 最后 15 秒有啥抓啥(石头除外),模拟真人抢分
                            int minFish = w.timeLeftMs < 15000 ? 30 : 100;
                            if (sc > 0 && sc < minFish) { sc = 0; }
                            // 价值/重量性价比优先
                            if (sc > 0) {
                                sc = sc * 10 / (Data.DEFS[it.kind].weight + 4);
                            }
                            // 路径遮挡:更近处若有垃圾/TNT 挡道,收益打折
                            // (HitTest 按数组序返回第一个命中,近物先被抓)
                            if (sc > 0) {
                                for (int j = 0; j < w.items.Count; j = j + 1) {
                                    Item ob = w.items[j];
                                    if (!ob.alive || ob == it) { continue; }
                                    if (ob.kind == 8) { continue; } // TNT 单算
                                    int ox = ob.x - Data.HOOK_X;
                                    int oy = ob.y - Data.HOOK_Y;
                                    double oproj = ox * Math.Cos(rad)
                                                   + oy * Math.Sin(rad);
                                    if (oproj < 110.0 || oproj > proj - 10.0) {
                                        continue;
                                    }
                                    double operp = Math.Abs(
                                        -ox * Math.Sin(rad) + oy * Math.Cos(rad));
                                    if (operp > 26.0) { continue; }
                                    ItemDef od = Data.DEFS[ob.kind];
                                    int obMin = w.timeLeftMs < 15000 ? 30 : 100;
                                    if (od.junk || od.score < obMin) {
                                        sc = 0;     // 垃圾挡道必被抓到,别浪费收线时间
                                        break;
                                    }
                                }
                            }
                            if (sc > bestScore) { bestScore = sc; best = it; }
                        }
                    }
                    if (best != null) { w.Action(); captured = captured + 1; }
                } else if (w.state == World.ST_QTE) {
                    // AI:白圈进入金圈即命中(20% 空点,模拟手残)
                    if (w.qteRing >= 34.0 && w.qteRing <= 54.0 && f % 5 != 0) {
                        w.Action();
                    }
                } else if (w.state == World.ST_BOMB) {
                    w.Action();     // 疯狂点击
                } else if (w.state == World.ST_RETRACT
                           && w.hookedKind == 6 && w.dynamites > 0) {
                    w.UseDynamite();    // 石头不上桌:用炸药止损
                }
                w.Step(16);
            }
            log.WriteLine("  -> gold=" + w.gold + "/" + target
                          + " result=" + (w.levelResult > 0 ? "WIN" : "FAIL")
                          + " actions=" + captured
                          + " timeLeft=" + w.timeLeftMs);
            // 不变量
            if (w.gold < 0) { log.WriteLine("  !! gold < 0"); allOk = false; }
            if (w.items.Count == 0) { log.WriteLine("  !! no items"); allOk = false; }
            if (w.levelResult == 0) {
                log.WriteLine("  !! level did not end");
                allOk = false;
                break;
            }
            if (w.levelResult > 0) {
                wonLevels = wonLevels + 1;
                // ConfirmResult 要求结算画面停留 600ms;SIM 里直接推
                // 进 1 秒再确认,走真实过关流程(level+1)。
                w.Step(1000);
                w.ConfirmResult();
            } else {
                break;      // 经济到顶:失败即停(曲线过陡的信号)
            }
        }
        // 平衡口径:8 种子中位推进 L5+、最差 L2+。曲线过陡(中位
        // 低于 L3)或过缓(中位 L8 通关)都会被这里拦下。
        if (wonLevels < 2) {
            log.WriteLine("  !! balance: only " + wonLevels
                          + " of first levels won");
            allOk = false;
        }
        log.WriteLine(allOk ? "=== SIM PASS ===" : "=== SIM FAIL ===");
        log.WriteLine("bestLevel=" + w.bestLevel + " totalGold=" + w.totalGold);
        log.Close();
        Console.WriteLine(allOk ? "SIM PASS" : "SIM FAIL");
        return allOk ? 0 : 1;
    }
}

// GuiHost 主循环回调：事件 → 固定步长模拟（16ms，追帧上限内多次）→
// 渲染（BeginFrame/PresentFrame 由宿主包好；帧预算自限速约 60fps）。
class MnLoop : IGuiHostLoop {
    MinerApp a;

    public void Start(GuiHost host) {
        this.a = MinerApp.Create(host);
    }
    public void Event(GuiHost host, int kind, int code) {
        // Gui 键码 = WM_KEYDOWN wParam(Windows VK)。放钩/节拍:空格 32、
        // 下 40、回车 13、鼠标左键;炸药:Q 81 / E 69;Esc 27 只在结算
        // 画面退出并存档(Stop 里落盘)。鼠标 kind:1=移动 2=按下 3=释放
        // (Win32Shell 契约,与 App 控件分发同一套)。
        if (kind == 4) {
            if (code == 27) {
                if (this.a.w.state == World.ST_RESULT) { host.RequestStop(); }
                return;
            }
            if (code == 32 || code == 40 || code == 13) {
                this.a.OnActionKey();
            } else if (code == 81 || code == 69) {
                this.a.OnDynamiteKey();
            }
        } else if (kind == 2 && code == 0) {
            // 左键按下:放钩 / QTE 节拍 / 拆弹连点 / 结算确认(触屏由
            // Gui 运行时合成鼠标点击,同一路径)。
            this.a.OnActionKey();
        }
    }
    public void FixedUpdate(GuiHost host, int dt) {
        this.a.now = Window.GetTickMs();
        this.a.StepFrame(dt);
    }
    public void Update(GuiHost host, int dt) { }
    public void Render(GuiHost host, Canvas c, double alpha) {
        this.a.now = Window.GetTickMs();
        // Android 上表面晚于 Start 到达(转向/后台往返亦然),App 会整体
        // 换新画布对象(App.SwapCanvas);Start 时抓的引用画进已销毁的
        // 旧表面,永不 present。每帧对齐到宿主传入的当前画布。
        this.a.c = c;
        // 窗口跟随：宿主视口已按窗口比例延展逻辑舞台（宽窗多看宽度，
        // 零黑边），取当帧值并让锚点跟随，布局锚定 Data.W 即自适应。
        Data.W = host.StageWidth();
        Data.HOOK_X = Data.W / 2;
        // 注意：这里绝不归位/钳制任何物理状态（摆角、爪长……）。
        // Render 每帧跑在 FixedUpdate 之后，帧内推进的摆角会被拍回、
        // 摆钩冻死在 90°；物理坐标已全部锚定活的 Data.HOOK_X/HOOK_Y，
        // 摆动圆心自动跟随新窗口，无需任何重置。
        CDraw.Origin(0, host.ContentTop());
        CDraw.Clear(c, Data.W, Data.H, CDraw.Argb(255, 12, 10, 8));
        this.a.DrawAll();
    }
    public void Stop(GuiHost host) {
        this.a.w.Save();
    }
}
