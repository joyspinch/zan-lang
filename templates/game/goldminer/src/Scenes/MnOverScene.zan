using System;
using System.IO;
using Gui;
using Game.Kit;
using Game.Foundation.Gui;

public class MnOverScene : HtmlScene {
    MinerApp a;

    MnOverScene(MinerApp a) { this.a = a; }

    override string HtmlFile() { return "assets/scenes/result.html"; }

    override void OnWire(HtmlHandlers handlers) {
        handlers.Add("next", () => this.Next());
    }

    // ConfirmResult 内部分流：赢 → level+1 开下一关，输 → 重开；
    // 600ms 冷却未到时返回 false，点击无效（防误触秒过）。
    void Next() {
        if (this.a.w.ConfirmResult()) {
            if (this.a.w.levelResult > 0) {
                this.a.snd.Play(this.a.snd.levelup, 0.7);
            }
            this.router.Go("play");
        }
    }

    override void OnEnter(Control root) {
        Element headline = MnOverScene.AsElement(root, "headline");
        Element subEl = MnOverScene.AsElement(root, "sub");
        Element totalEl = MnOverScene.AsElement(root, "total");
        bool win = this.a.w.levelResult > 0;
        if (headline != null) { headline.SetText(win ? "过关!" : "时间到!"); }
        if (subEl != null) {
            subEl.SetText("本关 $" + Convert.ToString(this.a.w.gold)
                + " / 目标 $" + Convert.ToString(this.a.w.Target()));
        }
        if (totalEl != null) {
            totalEl.SetText("累计 $" + Convert.ToString(this.a.w.totalGold));
        }
        // 按钮标签随胜负分流：<button> 生成的是 Gui Button 控件
        // （不是文本 Element），改标签走 Binding 字段 Button.Text。
        Control nextBtn = root.Find("next");
        if (nextBtn != null && nextBtn is Button) {
            Button b = (Button)nextBtn;
            b.Text = win ? "继续 → 第 " + Convert.ToString(this.a.w.level + 1)
                                   + " 关" : "重新开始";
        }
    }

    static Element AsElement(Control root, string id) {
        Control c = root.Find(id);
        if (c != null && c is Element) { return (Element)c; }
        return null;
    }

    override void FixedStep(int dtMs) {
        this.a.now = Window.GetTickMs();
        this.a.StepFrame(dtMs);
    }

    override void Event(int kind, int key) {
        if (kind == 4 && key == 27) { this.router.Exit(); }
    }

    override void Render(Canvas c, double alpha) {
        this.a.now = Window.GetTickMs();
        this.a.c = c;
        GuiHost host = this.router.Host();
        Data.W = host.StageWidth();
        Data.HOOK_X = Data.W / 2;
        CDraw.Origin(0, host.ContentTop());
        CDraw.Clear(c, Data.W, Data.H, CDraw.Argb(255, 12, 10, 8));
        this.a.DrawAll();
    }
}
