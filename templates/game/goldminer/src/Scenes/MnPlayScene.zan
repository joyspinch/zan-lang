using System;
using System.IO;
using Gui;
using Game.Kit;
using Game.Foundation.Gui;

public class MnPlayScene : HtmlScene {
    MinerApp a;

    MnPlayScene(MinerApp a) { this.a = a; }

    override void Event(int kind, int key) {
        // Gui 键码 = WM_KEYDOWN wParam(Windows VK)。放钩/节拍:空格 32、
        // 下 40、回车 13、鼠标左键;炸药:Q 81 / E 69。鼠标 kind:1=移动
        // 2=按下 3=释放(Win32Shell 契约,与 App 控件分发同一套)。
        if (kind == 4) {
            if (key == 32 || key == 40 || key == 13) {
                this.a.OnActionKey();
            } else if (key == 81 || key == 69) {
                this.a.OnDynamiteKey();
            }
        } else if (kind == 2 && key == 0) {
            // 左键按下:放钩 / QTE 节拍 / 拆弹连点(触屏由 Gui 运行时
            // 合成鼠标点击,同一路径)。
            this.a.OnActionKey();
        }
    }

    override void FixedStep(int dtMs) {
        this.a.now = Window.GetTickMs();
        this.a.StepFrame(dtMs);
        // 本关结束 → 结算场景；切换在帧首应用，本场景随即使停。
        if (this.a.w.state == World.ST_RESULT) { this.router.Go("over"); }
    }

    override void Render(Canvas c, double alpha) {
        this.a.now = Window.GetTickMs();
        // Android 上表面晚于 Start 到达(转向/后台往返亦然),App 会整体
        // 换新画布对象(App.SwapCanvas);Start 时抓的引用画进已销毁的
        // 旧表面,永不 present。每帧对齐到宿主传入的当前画布。
        this.a.c = c;
        // 窗口跟随：宿主视口已按窗口比例延展逻辑舞台（宽窗多看宽度，
        // 零黑边），取当帧值并让锚点跟随，布局锚定 Data.W 即自适应。
        GuiHost host = this.router.Host();
        Data.W = host.StageWidth();
        Data.HOOK_X = Data.W / 2;
        // 注意：这里绝不归位/钳制任何物理状态（摆角、爪长……）。
        // Render 每帧跑在 FixedUpdate 之后，帧内推进的摆角会被拍回、
        // 摆钩冻死在 90°；物理坐标已全部锚定活的 Data.HOOK_X/HOOK_Y，
        // 摆动圆心自动跟随新窗口，无需任何重置。
        CDraw.Origin(0, host.ContentTop());
        CDraw.Clear(c, Data.W, Data.H, CDraw.Argb(255, 12, 10, 8));
        this.a.DrawAll();
    }

    override void OnExit() {
        // 进度落盘时机与旧 GuiHost Stop 一致：离开对局（进结算/退应用）
        // 时保存。
        this.a.w.Save();
    }
}

// 结算：HTML 面板叠在定格的对局画面上——Render 继续画 DrawAll（世界
// 已停在 ST_RESULT），body 半透明压暗；FixedStep 继续推世界（结算
// 确认的 600ms 冷却 resultWait 靠它累计，飘字/白闪收尾也靠它）。
