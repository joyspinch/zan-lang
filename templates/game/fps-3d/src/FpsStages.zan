using System;
using System.Collections.Generic;

namespace Fps3D;

// 关卡数据：一座 60 m x 60 m 的霓虹竞技场（四周围墙），每关在里面摆一套建筑
// （柱、墙、平台、坡道）、一组目标、一枚隐藏碎片和三档奖牌时间。
// 坐标：Y 朝上，地面 y = 0；出生点在 +Z 一侧、面朝 -Z。全部是纯数据，
// FpsGame 用它做规则与碰撞，FpsScene 用它搭场景，无头回放同样可用。

// 实心体：XZ 矩形 + 高度。Axis = 0 为平顶方块（底 Bottom、顶 H0）；
// Axis = 1 / 2 为从地面升起的坡道，高度沿 X / Z 从 H0 线性变到 H1。
public class FpsSolid {
    public float MinX;
    public float MaxX;
    public float MinZ;
    public float MaxZ;
    public float Bottom;
    public float H0;
    public float H1;
    public int Axis;
    // 外观：0 墙 1 柱 2 平台 3 坡道 4 掩体 5 目标踏台（颜色取所属目标）
    public int Look;
    // 踏台所属目标的颜色（Look == 5 时有效）
    public int PadColor;

    public FpsSolid() {
        this.Axis = 0;
        this.Look = 0;
        this.PadColor = 0;
    }

    public float Top() { return this.H0 > this.H1 ? this.H0 : this.H1; }

    public float CenterX() { return (this.MinX + this.MaxX) * 0.5f; }
    public float CenterZ() { return (this.MinZ + this.MaxZ) * 0.5f; }

    // (x, z) 处的顶面高度（点先夹进矩形）
    public float HeightAt(float x, float z) {
        if (this.Axis == 0) { return this.H0; }
        float t = 0.0f;
        if (this.Axis == 1) { t = (x - this.MinX) / (this.MaxX - this.MinX); }
        else { t = (z - this.MinZ) / (this.MaxZ - this.MinZ); }
        if (t < 0.0f) { t = 0.0f; }
        if (t > 1.0f) { t = 1.0f; }
        return this.H0 + (this.H1 - this.H0) * t;
    }

    // 与以 (x, z) 为中心、半边长 r 的方形脚印是否相交
    public bool Overlaps(float x, float z, float r) {
        return x + r > this.MinX && x - r < this.MaxX && z + r > this.MinZ && z - r < this.MaxZ;
    }
}

// 目标：Kind 0 静止，1 往返（A ↔ B，余弦缓动），2 环绕（绕 A 点水平转圈）。
// Pad >= 0 时只有站在该实心体上才算数（"踏台目标"）。
public class FpsTargetDef {
    public int Kind;
    public float X;
    public float Y;
    public float Z;
    public float X2;
    public float Y2;
    public float Z2;
    public float Radius;
    // 往返：角速度（弧度/秒，一个来回 = 2π / Speed 秒）；环绕：角速度（弧度/秒）
    public float Speed;
    public float Phase;
    public float Size;
    public int Pad;
    public int Color;

    public FpsTargetDef() {
        this.Kind = 0;
        this.Size = 1.6f;
        this.Pad = -1;
        this.Radius = 0.0f;
        this.Speed = 0.0f;
        this.Phase = 0.0f;
    }
}

public class FpsStage {
    public string Name;
    public string Blurb;
    public float SpawnX;
    public float SpawnZ;
    // 出生朝向（弧度，0 = 面朝 -Z）
    public float SpawnYaw;
    public List<FpsSolid> Solids;
    public List<FpsTargetDef> Targets;
    public float ShardX;
    public float ShardY;
    public float ShardZ;
    // 奖牌门槛（净用时毫秒，含连击/碎片奖励）
    public long Gold;
    public long Silver;
    public long Bronze;
    // 主题色（HUD 关卡名、天空地平线点缀）
    public int Accent;

    public FpsStage(string name, string blurb) {
        this.Name = name;
        this.Blurb = blurb;
        this.SpawnX = 0.0f;
        this.SpawnZ = 25.0f;
        this.SpawnYaw = 0.0f;
        this.Solids = new List<FpsSolid>();
        this.Targets = new List<FpsTargetDef>();
        this.Accent = 0x00E5FF;
    }

    // 平顶方块（中心 cx/cz，宽 w 深 d，底 bottom 顶 top）
    public int Box(float cx, float cz, float w, float d, float bottom, float top, int look) {
        FpsSolid s = new FpsSolid();
        s.MinX = cx - w * 0.5f;
        s.MaxX = cx + w * 0.5f;
        s.MinZ = cz - d * 0.5f;
        s.MaxZ = cz + d * 0.5f;
        s.Bottom = bottom;
        s.H0 = top;
        s.H1 = top;
        s.Axis = 0;
        s.Look = look;
        this.Solids.Add(s);
        return this.Solids.Count - 1;
    }

    // 坡道：从地面升起，axis 1 沿 X、2 沿 Z；h0 / h1 为 Min 端 / Max 端高度
    public int Ramp(float minX, float maxX, float minZ, float maxZ, float h0, float h1, int axis) {
        FpsSolid s = new FpsSolid();
        s.MinX = minX;
        s.MaxX = maxX;
        s.MinZ = minZ;
        s.MaxZ = maxZ;
        s.Bottom = 0.0f;
        s.H0 = h0;
        s.H1 = h1;
        s.Axis = axis;
        s.Look = 3;
        this.Solids.Add(s);
        return this.Solids.Count - 1;
    }

    // 目标踏台（矮台，颜色随目标）
    public int Pad(float cx, float cz, float top, int color) {
        int i = this.Box(cx, cz, 2.6f, 2.6f, 0.0f, top, 5);
        this.Solids[i].PadColor = color;
        return i;
    }

    public FpsTargetDef Static(float x, float y, float z, float size) {
        FpsTargetDef t = new FpsTargetDef();
        t.Kind = 0;
        t.X = x; t.Y = y; t.Z = z;
        t.Size = size;
        t.Color = FpsStages.Palette(this.Targets.Count);
        this.Targets.Add(t);
        return t;
    }

    public FpsTargetDef Mover(float x, float y, float z, float x2, float y2, float z2, float speed, float phase) {
        FpsTargetDef t = this.Static(x, y, z, 1.5f);
        t.Kind = 1;
        t.X2 = x2; t.Y2 = y2; t.Z2 = z2;
        t.Speed = speed;
        t.Phase = phase;
        return t;
    }

    public FpsTargetDef Orbiter(float cx, float y, float cz, float radius, float speed, float phase) {
        FpsTargetDef t = this.Static(cx, y, cz, 1.4f);
        t.Kind = 2;
        t.Radius = radius;
        t.Speed = speed;
        t.Phase = phase;
        return t;
    }

    // 踏台目标：目标挂在 (x, y, z)，踏台在 (px, pz) 高 padTop
    public FpsTargetDef Gated(float x, float y, float z, float px, float pz, float padTop) {
        FpsTargetDef t = this.Static(x, y, z, 1.6f);
        t.Pad = this.Pad(px, pz, padTop, t.Color);
        return t;
    }

    public void Shard(float x, float y, float z) {
        this.ShardX = x;
        this.ShardY = y;
        this.ShardZ = z;
    }

    public void Medals(long gold, long silver, long bronze) {
        this.Gold = gold;
        this.Silver = silver;
        this.Bronze = bronze;
    }

    // 0 无 1 铜 2 银 3 金
    public int MedalFor(long ms) {
        if (ms <= this.Gold) { return 3; }
        if (ms <= this.Silver) { return 2; }
        if (ms <= this.Bronze) { return 1; }
        return 0;
    }
}

public class FpsStages {
    public const float ArenaHalf = 30.0f;

    public static int Count() { return 6; }

    // 目标配色（霓虹色环，彼此可分辨）
    public static int Palette(int i) {
        int[] p = new int[10] { 0xFF4D6D, 0x3DB8FF, 0x7CFF5B, 0xFFC53D, 0xB37FEB,
                                0x2CF5D6, 0xFF8A3D, 0xF759AB, 0xE8FF3D, 0x6D8BFF };
        return p[i % 10];
    }

    public static string MedalName(int m) {
        if (m == 3) { return "GOLD"; }
        if (m == 2) { return "SILVER"; }
        if (m == 1) { return "BRONZE"; }
        return "NO MEDAL";
    }

    public static FpsStage Build(int index) {
        FpsStage s;
        if (index == 1) { s = FpsStages.Elevation(); }
        else if (index == 2) { s = FpsStages.Drift(); }
        else if (index == 3) { s = FpsStages.Vantage(); }
        else if (index == 4) { s = FpsStages.Orbit(); }
        else if (index == 5) { s = FpsStages.Gauntlet(); }
        else { s = FpsStages.WarmUp(); }
        FpsStages.Perimeter(s);
        return s;
    }

    // 四面围墙（每关都有，放在列表末尾，不影响关卡自己的下标）
    static void Perimeter(FpsStage s) {
        float h = FpsStages.ArenaHalf;
        s.Box(0.0f, -h - 0.5f, 2.0f * h + 2.0f, 1.0f, 0.0f, 5.0f, 0);
        s.Box(0.0f, h + 0.5f, 2.0f * h + 2.0f, 1.0f, 0.0f, 5.0f, 0);
        s.Box(-h - 0.5f, 0.0f, 1.0f, 2.0f * h, 0.0f, 5.0f, 0);
        s.Box(h + 0.5f, 0.0f, 1.0f, 2.0f * h, 0.0f, 5.0f, 0);
    }

    // 1：开阔场地、静止目标，熟悉走位与标记
    static FpsStage WarmUp() {
        FpsStage s = new FpsStage("WARM-UP", "Six still targets. Learn to move and tag.");
        s.Accent = 0x00E5FF;
        s.Box(-9.0f, 6.0f, 2.0f, 2.0f, 0.0f, 6.0f, 1);
        s.Box(9.0f, 6.0f, 2.0f, 2.0f, 0.0f, 6.0f, 1);
        s.Box(-9.0f, -12.0f, 2.0f, 2.0f, 0.0f, 6.0f, 1);
        s.Box(9.0f, -12.0f, 2.0f, 2.0f, 0.0f, 6.0f, 1);
        s.Box(0.0f, -4.0f, 12.0f, 1.0f, 0.0f, 1.2f, 4);
        s.Box(-20.0f, -20.0f, 3.0f, 3.0f, 0.0f, 1.5f, 4);
        s.Box(20.0f, 18.0f, 3.0f, 3.0f, 0.0f, 1.5f, 4);
        s.Box(-24.0f, 4.0f, 1.0f, 10.0f, 0.0f, 3.0f, 0);
        s.Static(0.0f, 1.5f, 12.0f, 1.8f);
        s.Static(-14.0f, 1.6f, 2.0f, 1.8f);
        s.Static(14.0f, 2.2f, -2.0f, 1.8f);
        s.Static(-6.0f, 1.4f, -18.0f, 1.6f);
        s.Static(8.0f, 3.2f, -22.0f, 1.6f);
        s.Static(22.0f, 1.4f, -24.0f, 1.6f);
        // 碎片：西侧矮墙背后
        s.Shard(-27.0f, 0.9f, 4.0f);
        s.Medals(6000, 12500, 22500);
        return s;
    }

    // 2：中央高台 + 坡道 + 胸墙，部分目标只有站高处才看得见
    static FpsStage Elevation() {
        FpsStage s = new FpsStage("ELEVATION", "Climb the ramp. Some targets hide behind the parapet.");
        s.Accent = 0xFFC53D;
        s.Box(0.0f, -2.0f, 12.0f, 10.0f, 0.0f, 3.0f, 2);
        s.Ramp(-2.0f, 2.0f, 3.0f, 11.0f, 3.0f, 0.0f, 2);
        s.Box(-18.0f, 0.0f, 6.0f, 8.0f, 0.0f, 1.0f, 2);
        s.Box(18.0f, -6.0f, 6.0f, 6.0f, 0.0f, 1.0f, 2);
        s.Box(0.0f, -13.0f, 22.0f, 1.0f, 0.0f, 2.6f, 0);
        s.Box(5.0f, -6.0f, 1.6f, 1.6f, 3.0f, 4.0f, 1);
        s.Box(-12.0f, 12.0f, 2.0f, 2.0f, 0.0f, 5.0f, 1);
        s.Box(12.0f, 12.0f, 2.0f, 2.0f, 0.0f, 5.0f, 1);
        s.Static(0.0f, 4.6f, -1.0f, 1.6f);
        s.Static(-18.0f, 2.4f, 1.0f, 1.6f);
        s.Static(18.0f, 2.4f, -6.0f, 1.6f);
        s.Static(-3.0f, 1.0f, -17.0f, 1.6f);
        s.Static(-20.0f, 1.0f, -22.0f, 1.6f);
        s.Static(16.0f, 1.0f, -20.0f, 1.6f);
        s.Static(-12.0f, 7.0f, -6.0f, 1.6f);
        // 碎片：高台角上的立柱顶（从高台跳上去）
        s.Shard(5.0f, 4.8f, -6.0f);
        s.Medals(10500, 16500, 30000);
        return s;
    }

    // 3：往返移动目标，在柱间来回滑行
    static FpsStage Drift() {
        FpsStage s = new FpsStage("DRIFT", "Targets on rails. Lead your shots and chain the combo.");
        s.Accent = 0xFF4DD2;
        s.Box(-12.0f, 0.0f, 2.0f, 2.0f, 0.0f, 6.0f, 1);
        s.Box(12.0f, 0.0f, 2.0f, 2.0f, 0.0f, 6.0f, 1);
        s.Box(-12.0f, -16.0f, 2.0f, 2.0f, 0.0f, 6.0f, 1);
        s.Box(12.0f, -16.0f, 2.0f, 2.0f, 0.0f, 6.0f, 1);
        s.Box(0.0f, -8.0f, 4.0f, 4.0f, 0.0f, 1.2f, 4);
        s.Box(-22.0f, 14.0f, 6.0f, 1.0f, 0.0f, 2.0f, 4);
        s.Box(22.0f, -26.0f, 1.0f, 6.0f, 0.0f, 2.5f, 0);
        s.Mover(-10.0f, 2.0f, 0.0f, 10.0f, 2.0f, 0.0f, 1.1f, 0.0f);
        s.Mover(-10.0f, 3.5f, -16.0f, 10.0f, 3.5f, -16.0f, 0.9f, 1.6f);
        s.Mover(-20.0f, 1.5f, -4.0f, -20.0f, 1.5f, -22.0f, 0.8f, 0.5f);
        s.Mover(20.0f, 1.5f, 6.0f, 20.0f, 4.0f, -12.0f, 1.0f, 2.4f);
        s.Static(0.0f, 2.2f, -8.0f, 1.4f);
        s.Mover(14.0f, 1.5f, -26.0f, 26.0f, 1.5f, -26.0f, 1.4f, 0.0f);
        s.Static(0.0f, 1.5f, -26.0f, 1.6f);
        s.Mover(-26.0f, 2.0f, 20.0f, -26.0f, 2.0f, 4.0f, 1.2f, 0.8f);
        // 碎片：东南角的墙后
        s.Shard(25.5f, 0.9f, -27.0f);
        s.Medals(19000, 27000, 48500);
        return s;
    }

    // 4：踏台目标——只有站在同色踏台上标记才算数
    static FpsStage Vantage() {
        FpsStage s = new FpsStage("VANTAGE", "Tag ringed targets from their matching pad.");
        s.Accent = 0x7CFF5B;
        s.Box(0.0f, -6.0f, 16.0f, 1.0f, 0.0f, 1.4f, 4);
        s.Box(-14.0f, 8.0f, 1.0f, 8.0f, 0.0f, 2.0f, 0);
        s.Box(14.0f, 8.0f, 1.0f, 8.0f, 0.0f, 2.0f, 0);
        s.Box(0.0f, -24.0f, 10.0f, 1.0f, 0.0f, 4.0f, 0);
        s.Static(0.0f, 1.5f, 14.0f, 1.6f);
        // 踏台目标：墙后高处，从对应踏台越墙可见
        s.Gated(-4.0f, 2.0f, -14.0f, -6.0f, 0.0f, 1.0f);
        s.Gated(6.0f, 2.6f, -12.0f, 6.0f, 2.0f, 1.0f);
        s.Gated(-22.0f, 2.0f, 8.0f, -10.0f, 16.0f, 1.0f);
        s.Gated(22.0f, 2.2f, 6.0f, 18.0f, 20.0f, 1.0f);
        s.Static(-20.0f, 1.4f, -20.0f, 1.6f);
        s.Static(20.0f, 1.6f, -22.0f, 1.6f);
        // 碎片：最北端高墙背后
        s.Shard(0.0f, 0.9f, -27.0f);
        s.Medals(28000, 36500, 65500);
        return s;
    }

    // 5：中央高塔，三只目标绕塔转圈，外加移动与高处静止目标
    static FpsStage Orbit() {
        FpsStage s = new FpsStage("ORBIT", "Three targets circle the spire. Time your tags.");
        s.Accent = 0xB37FEB;
        s.Box(0.0f, -6.0f, 4.0f, 4.0f, 0.0f, 9.0f, 1);
        s.Box(-16.0f, -16.0f, 6.0f, 6.0f, 0.0f, 1.0f, 2);
        s.Ramp(-19.0f, -13.0f, -13.0f, -5.0f, 1.0f, 0.0f, 2);
        s.Box(16.0f, 10.0f, 8.0f, 2.0f, 0.0f, 2.5f, 4);
        s.Box(-18.0f, 14.0f, 2.0f, 2.0f, 0.0f, 5.0f, 1);
        s.Orbiter(0.0f, 2.0f, -6.0f, 6.0f, 0.9f, 0.0f);
        s.Orbiter(0.0f, 5.0f, -6.0f, 9.0f, -0.6f, 2.0f);
        s.Orbiter(0.0f, 8.0f, -6.0f, 5.0f, 1.3f, 4.0f);
        s.Static(-16.0f, 2.4f, -16.0f, 1.6f);
        s.Mover(10.0f, 1.5f, 18.0f, 24.0f, 1.5f, 18.0f, 1.0f, 0.0f);
        s.Gated(24.0f, 2.0f, -22.0f, 16.0f, -22.0f, 1.0f);
        s.Static(-24.0f, 6.0f, 2.0f, 1.6f);
        // 碎片：东侧长掩体北面（从出生点看不到）
        s.Shard(16.0f, 0.9f, 7.4f);
        s.Medals(22000, 28500, 51500);
        return s;
    }

    // 6：全部机制混合的终局
    static FpsStage Gauntlet() {
        FpsStage s = new FpsStage("GAUNTLET", "Everything at once. Twelve targets, one clean run.");
        s.Accent = 0xFF8A3D;
        s.Box(0.0f, 4.0f, 10.0f, 8.0f, 0.0f, 2.5f, 2);
        s.Ramp(-1.5f, 1.5f, 8.0f, 14.0f, 2.5f, 0.0f, 2);
        s.Box(0.0f, -14.0f, 3.0f, 3.0f, 0.0f, 8.0f, 1);
        s.Box(-14.0f, -4.0f, 1.0f, 14.0f, 0.0f, 3.0f, 0);
        s.Box(14.0f, -4.0f, 1.0f, 14.0f, 0.0f, 3.0f, 0);
        s.Box(-22.0f, 18.0f, 4.0f, 4.0f, 0.0f, 1.2f, 4);
        s.Static(0.0f, 4.2f, 4.0f, 1.4f);
        s.Orbiter(0.0f, 3.0f, -14.0f, 5.0f, 1.0f, 0.0f);
        s.Orbiter(0.0f, 6.5f, -14.0f, 7.0f, -0.7f, 3.0f);
        s.Mover(-24.0f, 1.5f, 6.0f, -24.0f, 1.5f, -20.0f, 0.9f, 0.0f);
        s.Mover(24.0f, 3.5f, -20.0f, 24.0f, 1.2f, 6.0f, 0.8f, 1.0f);
        s.Gated(-20.0f, 2.2f, -12.0f, -8.0f, -18.0f, 1.0f);
        s.Gated(22.0f, 3.0f, 0.0f, 19.0f, -14.0f, 1.0f);
        s.Static(-26.0f, 1.4f, 26.0f, 1.4f);
        s.Mover(14.0f, 1.4f, 24.0f, 26.0f, 1.4f, 24.0f, 1.5f, 0.0f);
        s.Static(0.0f, 9.4f, -14.0f, 1.4f);
        s.Static(-26.0f, 1.5f, -27.0f, 1.4f);
        s.Static(26.0f, 1.5f, -27.0f, 1.4f);
        // 碎片：西北角矮台背后
        s.Shard(-26.5f, 0.9f, 22.0f);
        s.Medals(26500, 35500, 64000);
        return s;
    }
}
