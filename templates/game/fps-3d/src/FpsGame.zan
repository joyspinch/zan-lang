using System;
using System.Collections.Generic;
using System.Numerics;
using Gui;
using Game.Animation;
using Game.Render3D;
using Game.Graphics;

namespace Fps3D;

public class FpsGame {
    public Camera3D camera;
    public FpsController3D controller;
    public RenderPlan plan;
    public Renderer3D renderer;
    public SceneNode rootNode;

    // 渲染后端状态
    public string backendName;
    public bool isGpuBackend;
    // Last actual world submission; HUD samples it in the update phase.
    public int drawResult;

    // 鼠标视角模式（按住右键拖拽 或 右键单击切换自由视角）
    public bool freeLookMode;

    // 交互拾取状态
    public bool targetHit;
    public float hitDistance;

    // 键盘移动状态
    public bool keyFwd;
    public bool keyBwd;
    public bool keyLeft;
    public bool keyRight;
    public bool keyUp;
    public bool keyDown;

    // 场景中目标方块的 AABB 包围盒（用于射线检测）
    public Vector3[] targetMins;
    public Vector3[] targetMaxs;
    public int targetCount;

    // 目标：用准星点中（标记）全部方块，计时越短越好
    public const float TagRange = 30.0f;
    public bool[] tagged;
    public int taggedCount;
    // 准星当前对准的目标下标（-1 = 没有）
    public int aimIndex;
    // 本局用时（毫秒，只随固定步长推进；全部标记后冻结）
    public double elapsedMs;
    public bool complete;
    // 每个目标的场景节点（标记后换材质）；无头时为空
    SceneNode[] targetNodes;

    public FpsGame() {
        this.camera = new Camera3D();
        this.camera.SetViewport(1280, 720);
        this.controller = new FpsController3D();
        this.controller.Position = new Vector3(0.0f, 1.8f, 12.0f); // 初始站在场景前方

        this.plan = new RenderPlan(this.camera);
        this.plan.AmbientRed = 0.2f;
        this.plan.AmbientGreen = 0.22f;
        this.plan.AmbientBlue = 0.28f;

        // 添加一束斜向阳光
        Light sun = new Light();
        sun.Kind = LightKind.Directional;
        sun.Direction = new Vector3(-0.5f, -1.0f, -0.6f);
        sun.Red = 1.0f;
        sun.Green = 0.95f;
        sun.Blue = 0.85f;
        sun.Intensity = 1.2f;
        this.plan.Lights.Add(sun);

        this.renderer = new Renderer3D(256);
        this.rootNode = new SceneNode("WorldRoot");

        this.targetHit = false;
        this.hitDistance = 0.0f;
        this.backendName = "gl";
        this.isGpuBackend = true;
        this.freeLookMode = false;

        this.keyFwd = false;
        this.keyBwd = false;
        this.keyLeft = false;
        this.keyRight = false;
        this.keyUp = false;
        this.keyDown = false;

        // 准星拾取用的包围盒是游戏数据（不依赖 GPU）：构造时就摆好，无头回放
        // （FpsSim）与上传网格前的第一帧都能做射线检测
        this.targetCount = FpsGame.TargetX().Length;
        this.targetMins = new Vector3[this.targetCount];
        this.targetMaxs = new Vector3[this.targetCount];
        float[] tx = FpsGame.TargetX();
        float[] ty = FpsGame.TargetY();
        float[] tz = FpsGame.TargetZ();
        float[] ts = FpsGame.TargetSize();
        for (int i = 0; i < this.targetCount; i = i + 1) {
            float h = ts[i] * 0.5f;
            this.targetMins[i] = new Vector3(tx[i] - h, ty[i] - h, tz[i] - h);
            this.targetMaxs[i] = new Vector3(tx[i] + h, ty[i] + h, tz[i] + h);
        }
        this.tagged = new bool[this.targetCount];
        this.targetNodes = new SceneNode[this.targetCount];
        this.Reset();
    }

    // 目标方块布局（中心点与边长，米）：前方三栋原有方块 + 散布四周、
    // 有的悬空（要 Space 升空或抬头）的五块。
    public static float[] TargetX() { return new float[8] { -4.0f, 0.0f, 4.0f, -13.0f, 12.0f, 0.0f, -14.0f, 13.0f }; }
    public static float[] TargetY() { return new float[8] { 1.0f, 1.0f, 1.0f, 1.0f, 1.5f, 6.0f, 4.0f, 0.75f }; }
    public static float[] TargetZ() { return new float[8] { 0.0f, 0.0f, 0.0f, -10.0f, -8.0f, -14.0f, 10.0f, 14.0f }; }
    public static float[] TargetSize() { return new float[8] { 2.0f, 2.0f, 2.0f, 2.0f, 3.0f, 2.0f, 2.0f, 1.5f }; }
    // 未标记时的颜色（0xRRGGBB）；标记后统一变暗为石板灰
    public static int[] TargetColor() {
        return new int[8] { 0xFF4D4F, 0x40A9FF, 0x52C41A, 0xFAAD14, 0xB37FEB, 0x13C2C2, 0xFF7A45, 0xF759AB };
    }

    // 回到出生点、清空标记与计时（重开一局不用重建场景）
    public void Reset() {
        this.controller.Position = new Vector3(0.0f, 1.8f, 12.0f);
        this.controller.Yaw = 0.0f;
        this.controller.Pitch = 0.0f;
        this.controller.SyncToCamera(this.camera);
        for (int i = 0; i < this.targetCount; i = i + 1) {
            this.tagged[i] = false;
            this.PaintTarget(i);
        }
        this.taggedCount = 0;
        this.aimIndex = -1;
        this.elapsedMs = 0.0;
        this.complete = false;
        this.targetHit = false;
        this.hitDistance = 0.0f;
        this.ReleaseKeys();
    }

    public void ReleaseKeys() {
        this.keyFwd = false;
        this.keyBwd = false;
        this.keyLeft = false;
        this.keyRight = false;
        this.keyUp = false;
        this.keyDown = false;
    }

    // 标记准星对准的目标。返回：0 = 没对准/太远，1 = 已标记过，
    // 2 = 标记成功，3 = 标记成功且全部完成。
    public int TryTag() {
        if (this.complete) { return 0; }
        if (this.aimIndex < 0 || this.hitDistance > FpsGame.TagRange) { return 0; }
        if (this.tagged[this.aimIndex]) { return 1; }
        this.tagged[this.aimIndex] = true;
        this.taggedCount = this.taggedCount + 1;
        this.PaintTarget(this.aimIndex);
        if (this.taggedCount >= this.targetCount) {
            this.complete = true;
            return 3;
        }
        return 2;
    }

    // 已标记位图（回放校验用）
    public int TaggedMask() {
        int m = 0;
        for (int i = 0; i < this.targetCount; i = i + 1) {
            if (this.tagged[i]) { m = m | (1 << i); }
        }
        return m;
    }

    void PaintTarget(int i) {
        if (this.targetNodes == null || this.targetNodes[i] == null) { return; }
        Material m = this.targetNodes[i].Material;
        if (this.tagged[i]) {
            m.Red = 0.22f; m.Green = 0.26f; m.Blue = 0.3f;
            m.EmissiveRed = 0.0f; m.EmissiveGreen = 0.0f; m.EmissiveBlue = 0.0f;
        } else {
            int c = FpsGame.TargetColor()[i];
            m.Red = (float)((c >> 16) & 255) / 255.0f;
            m.Green = (float)((c >> 8) & 255) / 255.0f;
            m.Blue = (float)(c & 255) / 255.0f;
            m.EmissiveRed = m.Red * 0.25f;
            m.EmissiveGreen = m.Green * 0.25f;
            m.EmissiveBlue = m.Blue * 0.25f;
        }
    }

    public static FpsGame Create() {
        return new FpsGame();
    }

    // 初始化场景几何体并上传到 GPU
    public void InitScene(Canvas canvas) {
        if (canvas == null) { return; }

        // 1. 生成并上传地面平面 (40m x 40m)
        Mesh3D groundMesh = Primitives3D.CreatePlane(40.0f, 40.0f, 4, 4);
        int groundKey = canvas.MeshUpload(groundMesh);

        SceneNode groundNode = new SceneNode("Ground");
        groundNode.MeshKey = groundKey;
        groundNode.BoundsRadius = 30.0f;
        groundNode.Material = new Material();
        groundNode.Material.Red = 0.2f;
        groundNode.Material.Green = 0.2f;
        groundNode.Material.Blue = 0.28f;
        rootNode.Children.Add(groundNode);

        // 2. 生成立方体网格 (2m x 2m x 2m)
        Mesh3D cubeMesh = Primitives3D.CreateCube(2.0f, 2.0f, 2.0f);
        int cubeKey = canvas.MeshUpload(cubeMesh);

        // 摆放目标方块（立方体网格 2m，按边长缩放）
        float[] tx = FpsGame.TargetX();
        float[] ty = FpsGame.TargetY();
        float[] tz = FpsGame.TargetZ();
        float[] ts = FpsGame.TargetSize();
        for (int i = 0; i < this.targetCount; i = i + 1) {
            SceneNode b = new SceneNode("Target_" + Convert.ToString(i));
            float k = ts[i] * 0.5f;
            b.MeshKey = cubeKey;
            b.BoundsRadius = 2.0f * k;
            b.Local = new Transform3D(new Vector3(tx[i], ty[i], tz[i]), Quaternion.Identity, new Vector3(k, k, k));
            b.Material = new Material();
            this.targetNodes[i] = b;
            this.PaintTarget(i);
            rootNode.Children.Add(b);
        }
    }

    public void OnKeyDown(int code) {
        if (code == 87 || code == 38) { keyFwd = true; } // W
        if (code == 83 || code == 40) { keyBwd = true; } // S
        if (code == 65 || code == 37) { keyLeft = true; } // A
        if (code == 68 || code == 39) { keyRight = true; } // D
        if (code == 32) { keyUp = true; } // Space 向上升
        if (code == 16) { keyDown = true; } // Shift 向下沉
    }

    public void OnKeyUp(int code) {
        if (code == 87 || code == 38) { keyFwd = false; }
        if (code == 83 || code == 40) { keyBwd = false; }
        if (code == 65 || code == 37) { keyLeft = false; }
        if (code == 68 || code == 39) { keyRight = false; }
        if (code == 32) { keyUp = false; }
        if (code == 16) { keyDown = false; }
    }

    public void OnMouseMove(float deltaX, float deltaY) {
        controller.OnMouseMove(deltaX, deltaY);
    }

    public void Tick(double dt) {
        float fdt = (float)dt;
        // 键盘移动步进
        controller.UpdateInput(keyFwd, keyBwd, keyLeft, keyRight, keyUp, keyDown, fdt);
        // 同步位置到 Camera3D
        controller.SyncToCamera(camera);

        // 从屏幕中心点 (640, 360) 发射视线射线检测准星目标
        Ray3D centerRay = Raycast3D.ScreenPointToRay(640, 360, 1280, 720, camera);

        targetHit = false;
        hitDistance = 999999.0f;
        aimIndex = -1;

        for (int i = 0; i < targetCount; i = i + 1) {
            float dist = 0.0f;
            if (Raycast3D.IntersectAabb(centerRay, targetMins[i], targetMaxs[i], out dist)) {
                if (dist < hitDistance) {
                    hitDistance = dist;
                    targetHit = true;
                    aimIndex = i;
                }
            }
        }

        if (!complete) { elapsedMs = elapsedMs + dt * 1000.0; }
    }

    // 准星对准的是可以标记的目标（未标记且在射程内）
    public bool AimTaggable() {
        return aimIndex >= 0 && !tagged[aimIndex] && hitDistance <= FpsGame.TagRange;
    }

    public void Render(Canvas c) {
        if (c == null) { return; }

        // 1. 提交 3D 场景渲染计划
        plan.Build(rootNode);
        int drawRes = renderer.Draw(c, plan);
        this.drawResult = drawRes;

        // 如果 GPU 批次渲染未提交 (返回 0，通常为 CPU 兜底后端)，启用 CPU 3D 透视投影线框
        if (drawRes == 0) {
            DrawCpuWireframeFallback(c);
        }

        // The persistent FpsHud tree composes status and crosshair after the world.
    }

    // CPU 3D 透视投影线框兜底渲染器
    private void DrawCpuWireframeFallback(Canvas c) {
        Mat4 vp = camera.ViewProjectionMatrix();

        // 1. 绘制地面网格 (XZ 平面，-20m 到 +20m，每隔 4m 一道线)
        for (int i = -5; i <= 5; i = i + 1) {
            float coord = (float)i * 4.0f;
            // 横线：(-20, 0, coord) -> (20, 0, coord)
            Draw3DLine(c, vp, -20.0f, 0.0f, coord, 20.0f, 0.0f, coord, unchecked((int)0xFF2A2A3D));
            // 纵线：(coord, 0, -20) -> (coord, 0, 20)
            Draw3DLine(c, vp, coord, 0.0f, -20.0f, coord, 0.0f, 20.0f, unchecked((int)0xFF2A2A3D));
        }

        // 2. 绘制每个目标方块的 12 条棱线（已标记的变暗）
        for (int b = 0; b < targetCount; b = b + 1) {
            Vector3 lo = targetMins[b];
            Vector3 hi = targetMaxs[b];
            int col = tagged[b] ? unchecked((int)0xFF3A4450) : (unchecked((int)0xFF000000) | FpsGame.TargetColor()[b]);
            float x0 = lo.X; float y0 = lo.Y; float z0 = lo.Z;
            float x1 = hi.X; float y1 = hi.Y; float z1 = hi.Z;

            // 底面 4 条边
            Draw3DLine(c, vp, x0, y0, z0, x1, y0, z0, col);
            Draw3DLine(c, vp, x1, y0, z0, x1, y0, z1, col);
            Draw3DLine(c, vp, x1, y0, z1, x0, y0, z1, col);
            Draw3DLine(c, vp, x0, y0, z1, x0, y0, z0, col);

            // 顶面 4 条边
            Draw3DLine(c, vp, x0, y1, z0, x1, y1, z0, col);
            Draw3DLine(c, vp, x1, y1, z0, x1, y1, z1, col);
            Draw3DLine(c, vp, x1, y1, z1, x0, y1, z1, col);
            Draw3DLine(c, vp, x0, y1, z1, x0, y1, z0, col);

            // 4 条垂直立柱
            Draw3DLine(c, vp, x0, y0, z0, x0, y1, z0, col);
            Draw3DLine(c, vp, x1, y0, z0, x1, y1, z0, col);
            Draw3DLine(c, vp, x1, y0, z1, x1, y1, z1, col);
            Draw3DLine(c, vp, x0, y0, z1, x0, y1, z1, col);
        }
    }

    // 空间两点通过相机透视投影矩阵绘制 2D 线段
    private void Draw3DLine(Canvas c, Mat4 vp, float x1, float y1, float z1, float x2, float y2, float z2, int color) {
        int sx1 = 0; int sy1 = 0;
        int sx2 = 0; int sy2 = 0;
        if (ProjectPoint(vp, x1, y1, z1, out sx1, out sy1) && ProjectPoint(vp, x2, y2, z2, out sx2, out sy2)) {
            c.DrawLine(sx1, sy1, sx2, sy2, color, 1);
        }
    }

    // 单点透视投影至屏幕像素坐标 (1280x720)
    private bool ProjectPoint(Mat4 vp, float x, float y, float z, out int sx, out int sy) {
        sx = 0; sy = 0;
        // 列主序矩阵变换: v' = M * v
        float clipX = vp.m[0] * x + vp.m[1] * y + vp.m[2] * z + vp.m[3];
        float clipY = vp.m[4] * x + vp.m[5] * y + vp.m[6] * z + vp.m[7];
        float clipW = vp.m[12] * x + vp.m[13] * y + vp.m[14] * z + vp.m[15];

        if (clipW < 0.1f) {
            return false; // 在相机近平面后方
        }

        float ndcX = clipX / clipW;
        float ndcY = clipY / clipW;

        if (ndcX < -2.0f || ndcX > 2.0f || ndcY < -2.0f || ndcY > 2.0f) {
            return false;
        }

        sx = (int)((ndcX * 0.5f + 0.5f) * 1280.0f);
        sy = (int)((0.5f - ndcY * 0.5f) * 720.0f);
        return true;
    }
}
