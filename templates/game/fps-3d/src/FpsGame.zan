using System;
using System.Collections.Generic;
using System.Numerics;
using Gui;
using Game.Animation;
using Game.Render3D;

namespace Fps3D;

public class FpsGame {
    public Camera3D camera;
    public FpsController3D controller;
    public RenderPlan plan;
    public Renderer3D renderer;
    public SceneNode rootNode;

    // 渲染后端状态
    public string backendName;
    public bool isGpuBackend;

    // 鼠标视角模式（按住右键拖拽 或 右键单击切换自由视角）
    public bool freeLookMode;

    // 交互拾取状态
    public bool targetHit;
    public float hitDistance;

    // 键盘移动状态
    public bool keyFwd;
    public bool keyBwd;
    public bool keyLeft;
    public bool keyRight;
    public bool keyUp;
    public bool keyDown;

    // 场景中建筑的 AABB 包围盒（用于射线检测）
    public Vector3[] targetMins;
    public Vector3[] targetMaxs;
    public int targetCount;

    public FpsGame() {
        this.camera = new Camera3D();
        this.camera.SetViewport(1280, 720);
        this.controller = new FpsController3D();
        this.controller.Position = new Vector3(0.0f, 1.8f, 12.0f); // 初始站在场景前方

        this.plan = new RenderPlan(this.camera);
        this.plan.AmbientRed = 0.2f;
        this.plan.AmbientGreen = 0.22f;
        this.plan.AmbientBlue = 0.28f;

        // 添加一束斜向阳光
        Light sun = new Light();
        sun.Kind = LightKind.Directional;
        sun.Direction = new Vector3(-0.5f, -1.0f, -0.6f);
        sun.Red = 1.0f;
        sun.Green = 0.95f;
        sun.Blue = 0.85f;
        sun.Intensity = 1.2f;
        this.plan.Lights.Add(sun);

        this.renderer = new Renderer3D(256);
        this.rootNode = new SceneNode("WorldRoot");

        this.targetHit = false;
        this.hitDistance = 0.0f;
        this.backendName = "gl";
        this.isGpuBackend = true;
        this.freeLookMode = false;

        this.keyFwd = false;
        this.keyBwd = false;
        this.keyLeft = false;
        this.keyRight = false;
        this.keyUp = false;
        this.keyDown = false;

        this.targetCount = 3;
        this.targetMins = new Vector3[3];
        this.targetMaxs = new Vector3[3];
    }

    public static FpsGame Create() {
        return new FpsGame();
    }

    // 初始化场景几何体并上传到 GPU
    public void InitScene(Canvas canvas) {
        if (canvas == null) { return; }

        // 1. 生成并上传地面平面 (40m x 40m)
        Mesh3D groundMesh = Primitives3D.CreatePlane(40.0f, 40.0f, 4, 4);
        int groundKey = canvas.MeshUpload(groundMesh);

        SceneNode groundNode = new SceneNode("Ground");
        groundNode.MeshKey = groundKey;
        groundNode.BoundsRadius = 30.0f;
        groundNode.Material = new Material();
        groundNode.Material.Red = 0.2f;
        groundNode.Material.Green = 0.2f;
        groundNode.Material.Blue = 0.28f;
        rootNode.Children.Add(groundNode);

        // 2. 生成立方体网格 (2m x 2m x 2m)
        Mesh3D cubeMesh = Primitives3D.CreateCube(2.0f, 2.0f, 2.0f);
        int cubeKey = canvas.MeshUpload(cubeMesh);

        // 摆放 3 栋不同颜色的立方体目标
        float[] posX = new float[3] { -4.0f, 0.0f, 4.0f };
        float[] colR = new float[3] { 1.0f, 0.2f, 0.2f };
        float[] colG = new float[3] { 0.2f, 0.6f, 0.8f };
        float[] colB = new float[3] { 0.2f, 0.9f, 0.2f };

        for (int i = 0; i < 3; i = i + 1) {
            SceneNode b = new SceneNode("Building_" + Convert.ToString(i));
            b.MeshKey = cubeKey;
            b.BoundsRadius = 2.0f;
            b.Local = new Transform3D(new Vector3(posX[i], 1.0f, 0.0f), Quaternion.Identity, Vector3.One);
            b.Material = new Material();
            b.Material.Red = colR[i];
            b.Material.Green = colG[i];
            b.Material.Blue = colB[i];
            rootNode.Children.Add(b);

            // 记录对应 AABB 包围盒便于射线拾取
            targetMins[i] = new Vector3(posX[i] - 1.0f, 0.0f, -1.0f);
            targetMaxs[i] = new Vector3(posX[i] + 1.0f, 2.0f, 1.0f);
        }
    }

    public void OnKeyDown(int code) {
        if (code == 87 || code == 38) { keyFwd = true; } // W
        if (code == 83 || code == 40) { keyBwd = true; } // S
        if (code == 65 || code == 37) { keyLeft = true; } // A
        if (code == 68 || code == 39) { keyRight = true; } // D
        if (code == 32) { keyUp = true; } // Space 向上升
        if (code == 16) { keyDown = true; } // Shift 向下沉
    }

    public void OnKeyUp(int code) {
        if (code == 87 || code == 38) { keyFwd = false; }
        if (code == 83 || code == 40) { keyBwd = false; }
        if (code == 65 || code == 37) { keyLeft = false; }
        if (code == 68 || code == 39) { keyRight = false; }
        if (code == 32) { keyUp = false; }
        if (code == 16) { keyDown = false; }
    }

    public void OnMouseMove(float deltaX, float deltaY) {
        controller.OnMouseMove(deltaX, deltaY);
    }

    public void Tick(double dt) {
        float fdt = (float)dt;
        // 键盘移动步进
        controller.UpdateInput(keyFwd, keyBwd, keyLeft, keyRight, keyUp, keyDown, fdt);
        // 同步位置到 Camera3D
        controller.SyncToCamera(camera);

        // 从屏幕中心点 (640, 360) 发射视线射线检测准星目标
        Ray3D centerRay = Raycast3D.ScreenPointToRay(640, 360, 1280, 720, camera);

        targetHit = false;
        hitDistance = 999999.0f;

        for (int i = 0; i < targetCount; i = i + 1) {
            float dist = 0.0f;
            if (Raycast3D.IntersectAabb(centerRay, targetMins[i], targetMaxs[i], out dist)) {
                if (dist < hitDistance) {
                    hitDistance = dist;
                    targetHit = true;
                }
            }
        }
    }

    public void Render(Canvas c) {
        if (c == null) { return; }

        // 1. 提交 3D 场景渲染计划
        plan.Build(rootNode);
        int drawRes = renderer.Draw(c, plan);

        // 如果 GPU 批次渲染未提交 (返回 0，通常为 CPU 兜底后端)，启用 CPU 3D 透视投影线框
        if (drawRes == 0) {
            DrawCpuWireframeFallback(c);
        }

        // 2. 绘制 2D HUD 界面与准星
        int cx = 640;
        int cy = 360;
        int crosshairColor = targetHit ? unchecked((int)0xFF00FF00) : unchecked((int)0xFFFFFFFF);

        // 绘制屏幕准星 (+)
        c.DrawLine(cx - 8, cy, cx + 8, cy, crosshairColor, 2);
        c.DrawLine(cx, cy - 8, cx, cy + 8, crosshairColor, 2);

        // 顶部 HUD 信息
        c.DrawRect(10, 10, 490, 115, unchecked((int)0xCC000000), 1);
        c.DrawText(20, 18, "3D FIRST-PERSON EXPLORER", unchecked((int)0xFF00E5FF), 16);
        string posStr = "POS: (" + Convert.ToString((int)controller.Position.X) + ", "
                                 + Convert.ToString((int)controller.Position.Y) + ", "
                                 + Convert.ToString((int)controller.Position.Z) + ")";
        c.DrawText(20, 38, posStr, unchecked((int)0xFFFFFFFF), 14);

        string backendStr = "BACKEND: " + (drawRes > 0 ? "GPU (OpenGL 3.3)" : "CPU (3D Wireframe Fallback)");
        int backendColor = (drawRes > 0) ? unchecked((int)0xFF52C41A) : unchecked((int)0xFFFAAD14);
        c.DrawText(20, 58, backendStr, backendColor, 13);

        string viewStr = freeLookMode ? "VIEW: [FREE LOOK MODE] Click RMB or ESC to release"
                                      : "VIEW: [DRAG MODE] Hold RMB/LMB or Click RMB to toggle";
        int viewColor = freeLookMode ? unchecked((int)0xFF00E5FF) : unchecked((int)0xFFFFA940);
        c.DrawText(20, 76, viewStr, viewColor, 13);

        if (targetHit) {
            c.DrawText(20, 94, "LOCKED ON CUBE (DIST: " + Convert.ToString((int)hitDistance) + "m)", unchecked((int)0xFF00FF00), 14);
        } else {
            c.DrawText(20, 94, "AIM: NO TARGET [WASD MOVE | SPACE/SHIFT ELEVATE]", unchecked((int)0xFFAAAAAA), 13);
        }
    }

    // CPU 3D 透视投影线框兜底渲染器
    private void DrawCpuWireframeFallback(Canvas c) {
        Mat4 vp = camera.ViewProjectionMatrix();

        // 1. 绘制地面网格 (XZ 平面，-20m 到 +20m，每隔 4m 一道线)
        for (int i = -5; i <= 5; i = i + 1) {
            float coord = (float)i * 4.0f;
            // 横线：(-20, 0, coord) -> (20, 0, coord)
            Draw3DLine(c, vp, -20.0f, 0.0f, coord, 20.0f, 0.0f, coord, unchecked((int)0xFF2A2A3D));
            // 纵线：(coord, 0, -20) -> (coord, 0, 20)
            Draw3DLine(c, vp, coord, 0.0f, -20.0f, coord, 0.0f, 20.0f, unchecked((int)0xFF2A2A3D));
        }

        // 2. 绘制 3 栋建筑的 12 条棱线
        float[] posX = new float[3] { -4.0f, 0.0f, 4.0f };
        int[] colors = new int[3] { unchecked((int)0xFFFF4D4F), unchecked((int)0xFF40A9FF), unchecked((int)0xFF52C41A) };

        for (int b = 0; b < 3; b = b + 1) {
            float cx = posX[b];
            int col = colors[b];

            // 底面 4 条边
            Draw3DLine(c, vp, cx - 1.0f, 0.0f, -1.0f, cx + 1.0f, 0.0f, -1.0f, col);
            Draw3DLine(c, vp, cx + 1.0f, 0.0f, -1.0f, cx + 1.0f, 0.0f,  1.0f, col);
            Draw3DLine(c, vp, cx + 1.0f, 0.0f,  1.0f, cx - 1.0f, 0.0f,  1.0f, col);
            Draw3DLine(c, vp, cx - 1.0f, 0.0f,  1.0f, cx - 1.0f, 0.0f, -1.0f, col);

            // 顶面 4 条边
            Draw3DLine(c, vp, cx - 1.0f, 2.0f, -1.0f, cx + 1.0f, 2.0f, -1.0f, col);
            Draw3DLine(c, vp, cx + 1.0f, 2.0f, -1.0f, cx + 1.0f, 2.0f,  1.0f, col);
            Draw3DLine(c, vp, cx + 1.0f, 2.0f,  1.0f, cx - 1.0f, 2.0f,  1.0f, col);
            Draw3DLine(c, vp, cx - 1.0f, 2.0f,  1.0f, cx - 1.0f, 2.0f, -1.0f, col);

            // 4 条垂直立柱
            Draw3DLine(c, vp, cx - 1.0f, 0.0f, -1.0f, cx - 1.0f, 2.0f, -1.0f, col);
            Draw3DLine(c, vp, cx + 1.0f, 0.0f, -1.0f, cx + 1.0f, 2.0f, -1.0f, col);
            Draw3DLine(c, vp, cx + 1.0f, 0.0f,  1.0f, cx + 1.0f, 2.0f,  1.0f, col);
            Draw3DLine(c, vp, cx - 1.0f, 0.0f,  1.0f, cx - 1.0f, 2.0f,  1.0f, col);
        }
    }

    // 空间两点通过相机透视投影矩阵绘制 2D 线段
    private void Draw3DLine(Canvas c, Mat4 vp, float x1, float y1, float z1, float x2, float y2, float z2, int color) {
        int sx1 = 0; int sy1 = 0;
        int sx2 = 0; int sy2 = 0;
        if (ProjectPoint(vp, x1, y1, z1, out sx1, out sy1) && ProjectPoint(vp, x2, y2, z2, out sx2, out sy2)) {
            c.DrawLine(sx1, sy1, sx2, sy2, color, 1);
        }
    }

    // 单点透视投影至屏幕像素坐标 (1280x720)
    private bool ProjectPoint(Mat4 vp, float x, float y, float z, out int sx, out int sy) {
        sx = 0; sy = 0;
        // 列主序矩阵变换: v' = M * v
        float clipX = vp.m[0] * x + vp.m[1] * y + vp.m[2] * z + vp.m[3];
        float clipY = vp.m[4] * x + vp.m[5] * y + vp.m[6] * z + vp.m[7];
        float clipW = vp.m[12] * x + vp.m[13] * y + vp.m[14] * z + vp.m[15];

        if (clipW < 0.1f) {
            return false; // 在相机近平面后方
        }

        float ndcX = clipX / clipW;
        float ndcY = clipY / clipW;

        if (ndcX < -2.0f || ndcX > 2.0f || ndcY < -2.0f || ndcY > 2.0f) {
            return false;
        }

        sx = (int)((ndcX * 0.5f + 0.5f) * 1280.0f);
        sy = (int)((0.5f - ndcY * 0.5f) * 720.0f);
        return true;
    }
}
