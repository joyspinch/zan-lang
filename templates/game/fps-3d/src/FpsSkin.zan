namespace Fps3D;

// 本游戏的界面皮肤："霓虹黄昏"——深靛玻璃面板、青色霓虹描边、洋红连击色、
// 金/银/铜奖牌色，和场景的天空盒、灯条同一套色板。所有控件状态（常态、悬停、
// 按下、焦点、禁用）都在这里定义，不回落到桌面默认样式。
public class FpsSkin {
    public static string Css() {
        return ".fps-hud{position:relative;background:transparent;padding:0;border:0}"
            + ".fps-flash,.fps-chip,.fps-stats,.fps-veil,.fps-card,.fps-select,.fps-tile{position:absolute;padding:0;margin:0}"
            + ".fps-flash{border:0;background:transparent}"
            + ".fps-chip,.fps-stats{background:linear-gradient(180deg,rgba(14,16,40,0.86),rgba(8,8,24,0.80));"
            + "border:1dpx solid rgba(25,230,255,0.30);border-radius:10dpx;box-shadow:0 4dpx 18dpx rgba(0,0,0,0.45)}"
            + ".fps-veil{background:rgba(4,3,14,0.72);border:0}"
            + ".fps-veil.fps-veil-soft{background:linear-gradient(90deg,rgba(4,3,14,0.80),rgba(4,3,14,0.20))}"
            + ".fps-card,.fps-select{background:linear-gradient(180deg,rgba(18,16,46,0.95),rgba(8,8,26,0.95));"
            + "border:2dpx solid rgba(25,230,255,0.75);border-radius:14dpx;box-shadow:0 0 30dpx rgba(25,230,255,0.22)}"
            + ".fps-card.fps-card-title{border-color:rgba(255,46,154,0.80);box-shadow:0 0 34dpx rgba(255,46,154,0.25)}"
            + ".fps-card.fps-card-result{border-color:rgba(255,211,77,0.80);box-shadow:0 0 34dpx rgba(255,211,77,0.22)}"
            + ".fps-tile{background:rgba(20,22,52,0.92);border:1dpx solid rgba(120,140,200,0.35);border-radius:10dpx}"
            + ".fps-tile.fps-tile-sel{border:2dpx solid #19e6ff;background:rgba(18,40,70,0.95);box-shadow:0 0 18dpx rgba(25,230,255,0.35)}"
            + ".fps-tile.fps-tile-locked{background:rgba(14,14,26,0.85);border-color:rgba(90,90,120,0.35)}"
            + "label.fps-label{position:absolute;padding:0;margin:0;border:0;background:transparent;"
            + "text-align:left;vertical-align:top;color:#eaf6ff}"
            + "label.fps-left{text-align:left}"
            + "label.fps-chip-stage{color:#19e6ff;letter-spacing:2dpx;font-weight:600}"
            + "label.fps-chip-name{color:#ffffff;font-weight:700}"
            + "label.fps-chip-pace{color:#8a97b8}"
            + "label.fps-timer{text-align:center;color:#ffffff;font-weight:700;text-shadow:0 2dpx 8dpx rgba(0,0,0,0.8)}"
            + "label.fps-bonus{text-align:center;color:#ff5cb4;font-weight:700;text-shadow:0 1dpx 4dpx rgba(0,0,0,0.8)}"
            + "label.fps-ring-text{text-align:center;color:#ffffff;font-weight:700}"
            + "label.fps-ring-sub{text-align:center;color:#8a97b8;letter-spacing:1dpx}"
            + "label.fps-combo{color:#8a97b8;font-weight:700}label.fps-combo.fps-hot{color:#ff5cb4}"
            + "label.fps-shard{color:#6f7a99}"
            + ".fps-ring,.fps-combobar{position:absolute;padding:0;margin:0;border:0;background:transparent}"
            + ".fps-crosshair{position:absolute;padding:0;border:0;background:transparent;color:#f4fbff}"
            + ".fps-crosshair.fps-x-lock{color:#5cff9d}.fps-crosshair.fps-x-far{color:#ffb547}.fps-crosshair.fps-x-pad{color:#ff8a3d}"
            + ".fps-marker{position:absolute;padding:0;border:0;background:transparent}"
            + "label.fps-mtext{text-align:center;color:#a9b4d0;text-shadow:0 1dpx 3dpx rgba(0,0,0,0.9)}"
            + "label.fps-mtext.fps-inrange{color:#5cff9d}"
            + "label.fps-aim{text-align:center;color:#a9b4d0;font-weight:600;text-shadow:0 1dpx 3dpx rgba(0,0,0,0.9)}"
            + "label.fps-aim.fps-x-lock{color:#5cff9d}label.fps-aim.fps-x-far{color:#ffb547}label.fps-aim.fps-x-pad{color:#ff8a3d}"
            + "label.fps-count{text-align:center;color:#ffffff;font-weight:800;text-shadow:0 0 22dpx rgba(25,230,255,0.9)}"
            + "label.fps-count.fps-go{color:#5cff9d;text-shadow:0 0 22dpx rgba(92,255,157,0.9)}"
            + "label.fps-toast{text-align:center;font-weight:700;text-shadow:0 2dpx 6dpx rgba(0,0,0,0.9)}"
            + "label.fps-toast.fps-good{color:#5cff9d}label.fps-toast.fps-bad{color:#ffb547}"
            + "label.fps-hint{text-align:center;color:#c9d4f0;text-shadow:0 1dpx 4dpx rgba(0,0,0,0.9)}"
            + "label.fps-sound{text-align:right;color:#6f7a99}"
            + "label.fps-heading{text-align:center;color:#19e6ff;font-weight:800;letter-spacing:2dpx;text-shadow:0 0 16dpx rgba(25,230,255,0.55)}"
            + ".fps-card-title label.fps-heading{color:#ffffff;text-shadow:0 0 20dpx rgba(255,46,154,0.85)}"
            + "label.fps-sub{text-align:center;color:#ff5cb4;letter-spacing:2dpx;font-weight:600}"
            + "label.fps-badge{text-align:center;vertical-align:middle;font-weight:800;letter-spacing:2dpx;"
            + "border:2dpx solid #6f7a99;border-radius:19dpx;background:rgba(0,0,0,0.35)}"
            + "label.fps-badge.fps-gold{border-color:#ffd34d;background:rgba(255,211,77,0.12)}"
            + "label.fps-badge.fps-silver{border-color:#cfdbeb;background:rgba(207,219,235,0.10)}"
            + "label.fps-badge.fps-bronze{border-color:#e8955c;background:rgba(232,149,92,0.10)}"
            + "label.fps-line{text-align:center;color:#d4dcf2}"
            + "label.fps-line.fps-dim{color:#8a97b8}label.fps-line.fps-strong{color:#ffffff;font-weight:700}"
            + "label.fps-line.fps-big{font-weight:800;text-shadow:0 0 18dpx rgba(0,0,0,0.6)}"
            + "label.fps-line.fps-accent{color:#19e6ff}"
            + "label.fps-mrow{text-align:center;font-weight:700;line-height:1.25}"
            + "label.fps-tnum{color:#19e6ff;letter-spacing:2dpx;font-weight:600}"
            + "label.fps-tname{color:#ffffff;font-weight:800}"
            + "label.fps-tblurb{color:#a9b4d0;white-space:normal}"
            + "label.fps-tbest{color:#eaf6ff}"
            + "label.fps-ttimes{color:#6f7a99}"
            + "label.fps-tshard{color:#6f7a99}"
            + ".fps-tile-locked label.fps-tname{color:#5a6080}.fps-tile-locked label.fps-tnum{color:#4a5070}"
            + ".fps-gold{color:#ffd34d}.fps-silver{color:#cfdbeb}.fps-bronze{color:#e8955c}.fps-nomedal{color:#6f7a99}.fps-shardc{color:#ffd34d}"
            + "label.fps-gold{color:#ffd34d}label.fps-silver{color:#cfdbeb}label.fps-bronze{color:#e8955c}label.fps-nomedal{color:#6f7a99}"
            + "button.fps-btn{position:absolute;padding:0;margin:0;justify-content:center;align-items:center;font-weight:700;letter-spacing:1dpx;"
            + "color:#d4dcf2;background:linear-gradient(180deg,rgba(28,30,70,0.96),rgba(14,14,40,0.96));"
            + "border:2dpx solid rgba(120,140,200,0.55);border-radius:8dpx}"
            + "button.fps-btn.fps-primary{color:#ffffff;border-color:#19e6ff;background:linear-gradient(180deg,#0f4a66,#0a2a44);"
            + "box-shadow:0 0 14dpx rgba(25,230,255,0.35)}"
            + "button.fps-btn label{background:transparent;border:0;font-size:inherit;color:inherit;"
            + "text-align:center;padding:0;margin:0}"
            + "button.fps-btn:hover{background:linear-gradient(180deg,#1b5f80,#0f3a58);color:#ffffff;border-color:#19e6ff}"
            + "button.fps-btn:active{background:#19e6ff;color:#06101e;border-color:#ffffff}"
            + "button.fps-btn:focus{border:2dpx solid #ffffff}"
            + "button.fps-btn:disabled{color:#5a6080;background:rgba(20,20,36,0.9);border-color:rgba(90,90,120,0.4);box-shadow:none}";
    }
}
