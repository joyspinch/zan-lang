using System;
using System.Numerics;
using Gui;
using Gui.Widget;
using Game.Foundation.Gui;
using Game.Render3D;

namespace Fps3D;

// 对局 HUD：一棵常驻的标准 Gui 控件树（Panel / Label / Progress + 两个自绘小件：
// 准星与目标指示），外观全部来自本游戏的"霓虹黄昏"皮肤（FpsSkin.Css）。
// 菜单卡片（开始页、选关、暂停、结算）由 FpsMenu 挂在同一棵树上。
//
// 布局：按 1280x720 设计稿等比缩放，顶部避开标准标题栏（app.ContentTop()）。
public class FpsHud {
    public const int MaxMarkers = 12;

    public Panel root;
    public HudLayer layer;
    public FpsMenu menu;
    public string mode;

    Panel flash;
    FpsMarker[] markers;
    Label[] markerText;
    Panel chip;
    Label chipStage;
    Label chipName;
    Label chipPace;
    Label timer;
    Label bonus;
    Panel stats;
    Progress ring;
    Label ringText;
    Label ringSub;
    Label combo;
    Progress comboBar;
    Label shard;
    FpsCrosshair crosshair;
    Label aim;
    Label countdown;
    Label toast;
    Label hint;
    Label sound;

    FpsGame game;
    weak Gui.App app;
    int lastCountBeat;

    public FpsHud(Gui.App app, FpsGame game) {
        this.game = game;
        this.app = app;
        this.mode = "title";
        this.lastCountBeat = -1;
        app.UseCss(FpsSkin.Css());
        this.root = new Panel("fps-hud");
        this.root.Class = "fps-hud";

        this.flash = FpsHud.Group(this.root, "fps-flash");
        this.markers = new FpsMarker[FpsHud.MaxMarkers];
        this.markerText = new Label[FpsHud.MaxMarkers];
        for (int i = 0; i < FpsHud.MaxMarkers; i = i + 1) {
            this.markers[i] = new FpsMarker();
            this.markers[i].Class = "fps-marker";
            this.root.Add(this.markers[i]);
            this.markerText[i] = FpsHud.Text(this.root, "", "fps-mtext");
        }

        this.chip = FpsHud.Group(this.root, "fps-chip");
        this.chipStage = FpsHud.Text(this.chip, "", "fps-chip-stage");
        this.chipName = FpsHud.Text(this.chip, "", "fps-chip-name");
        this.chipPace = FpsHud.Text(this.chip, "", "fps-chip-pace");

        this.timer = FpsHud.Text(this.root, "", "fps-timer");
        this.bonus = FpsHud.Text(this.root, "", "fps-bonus");

        this.stats = FpsHud.Group(this.root, "fps-stats");
        this.ring = new Progress(0, 1);
        this.ring.Ring();
        this.ring.showIndicator = false;
        this.ring.FillColor(unchecked((int)0xFF19E6FF));
        this.ring.RailColor(unchecked((int)0x40FFFFFF));
        this.ring.Class = "fps-ring";
        this.stats.Add(this.ring);
        this.ringText = FpsHud.Text(this.stats, "", "fps-ring-text");
        this.ringSub = FpsHud.Text(this.stats, "TARGETS", "fps-ring-sub");
        this.combo = FpsHud.Text(this.stats, "", "fps-combo");
        this.comboBar = new Progress(0, 1);
        this.comboBar.showIndicator = false;
        this.comboBar.FillColor(unchecked((int)0xFFFF2E9A));
        this.comboBar.RailColor(unchecked((int)0x30FFFFFF));
        this.comboBar.Class = "fps-combobar";
        this.stats.Add(this.comboBar);
        this.shard = FpsHud.Text(this.stats, "", "fps-shard");

        this.crosshair = new FpsCrosshair();
        this.crosshair.Class = "fps-crosshair";
        this.root.Add(this.crosshair);
        this.aim = FpsHud.Text(this.root, "", "fps-aim");
        this.countdown = FpsHud.Text(this.root, "", "fps-count");
        this.toast = FpsHud.Text(this.root, "", "fps-toast");
        this.hint = FpsHud.Text(this.root, "", "fps-hint");
        this.sound = FpsHud.Text(this.root, "", "fps-sound");

        this.menu = new FpsMenu(app, this.root, game);

        this.layer = new HudLayer();
        this.layer.Add(this.root);
        this.layer.SetBounds(0, 0, app.canvas.Width(), app.canvas.Height());
        this.layer.Bind(app);
    }

    public static Panel Group(Control parent, string cls) {
        Panel p = new Panel(cls);
        p.Class = cls;
        parent.Add(p);
        return p;
    }

    public static Label Text(Control parent, string text, string cls) {
        Label l = new Label(text);
        l.Class = "fps-label " + cls;
        parent.Add(l);
        return l;
    }

    public static void Box(Control control, int x, int y, int w, int h, int font) {
        string style = "left:" + Convert.ToString(x) + "dpx;top:" + Convert.ToString(y)
            + "dpx;width:" + Convert.ToString(w) + "dpx;height:" + Convert.ToString(h) + "dpx";
        if (font > 0) { style = style + ";font-size:" + Convert.ToString(font) + "dpx"; }
        if (control.inlineStyleCss != style) { control.SetProp("style", style); }
    }

    public static void SetClass(Control c, string cls) {
        if (c.Class != cls) { c.Class = cls; }
    }

    public static void SetText(Label l, string text) {
        l.SetProp("text", text);
    }

    // m:ss.d
    public static string FormatTime(long ms) {
        if (ms < 0) { ms = 0; }
        long tenths = ms / 100;
        long sec = tenths / 10;
        long min = sec / 60;
        long s = sec % 60;
        return Convert.ToString(min) + ":" + (s < 10 ? "0" : "") + Convert.ToString(s)
            + "." + Convert.ToString(tenths % 10);
    }

    // 秒，一位小数（奖励提示用）
    public static string Secs(double ms) {
        long tenths = (long)(ms / 100.0 + 0.5);
        return Convert.ToString(tenths / 10) + "." + Convert.ToString(tenths % 10) + "s";
    }

    public static string MedalClass(int m) {
        if (m == 3) { return "fps-gold"; }
        if (m == 2) { return "fps-silver"; }
        if (m == 1) { return "fps-bronze"; }
        return "fps-nomedal";
    }

    // 切换界面模式：清掉旧模式残留的点击并释放卡片按钮的焦点/捕获
    public void SetMode(string m) {
        if (this.mode == m) { return; }
        this.mode = m;
        this.menu.SetMode(m);
        Gui.App a = this.app;
        if (a != null) { a.ReleaseInputSubtree(this.menu.veil); }
    }

    public string TakeAction() { return this.menu.TakeAction(); }

    public void SyncState(Gui.App app, FpsView view) {
        int w = app.canvas.Width();
        int h = app.canvas.Height();
        double s = Math.Min((double)w / 1280.0, (double)h / 720.0);
        if (s <= 0.0) { s = 1.0; }
        int top = app.ContentTop();
        bool playing = this.mode == "play";
        bool inRun = playing || this.mode == "pause";

        this.SyncPlay(app, view, w, h, s, top, playing);
        this.SetShownAll(inRun, playing, view);
        this.menu.Sync(app, view, w, h, s, top);

        this.layer.SetBounds(0, 0, w, h);
        this.layer.SetVisible(app.window.GetHandle() == 0 || app.window.IsVisible());
    }

    void SetShownAll(bool inRun, bool playing, FpsView view) {
        this.chip.SetShown(inRun);
        this.timer.SetShown(inRun);
        this.stats.SetShown(inRun);
        this.crosshair.SetShown(playing && !this.game.complete);
        this.aim.SetShown(playing && this.game.aimState != 0);
        this.countdown.SetShown(playing && (this.game.InCountdown() || this.game.elapsedMs < 600.0));
        this.toast.SetShown(playing && view.toast != "");
        this.bonus.SetShown(playing && view.bonusMs > 0);
        this.hint.SetShown(playing && view.showHint);
        this.sound.SetShown(inRun);
        this.flash.SetShown(playing && view.flashMs > 0);
    }

    void SyncPlay(Gui.App app, FpsView view, int w, int h, double s, int top, bool playing) {
        FpsStage st = this.game.stage;
        int n = this.game.targetCount;
        long net = this.game.NetMs();

        // 左上：关卡牌 + 奖牌配速
        FpsHud.Box(this.chip, (int)(20 * s), top + (int)(14 * s), (int)(330 * s), (int)(92 * s), 0);
        FpsHud.Box(this.chipStage, (int)(18 * s), (int)(10 * s), (int)(300 * s), (int)(18 * s), (int)(13 * s));
        FpsHud.Box(this.chipName, (int)(18 * s), (int)(28 * s), (int)(300 * s), (int)(32 * s), (int)(26 * s));
        FpsHud.Box(this.chipPace, (int)(18 * s), (int)(62 * s), (int)(300 * s), (int)(20 * s), (int)(14 * s));
        FpsHud.SetText(this.chipStage, "STAGE " + Convert.ToString(this.game.stageIndex + 1) + " / " + Convert.ToString(FpsStages.Count()));
        FpsHud.SetText(this.chipName, st.Name);
        int pace = st.MedalFor(net);
        string paceText = "MEDAL LOST - FINISH TO UNLOCK NEXT";
        if (pace == 3) { paceText = "GOLD PACE  " + FpsHud.FormatTime(st.Gold); }
        else if (pace == 2) { paceText = "SILVER PACE  " + FpsHud.FormatTime(st.Silver); }
        else if (pace == 1) { paceText = "BRONZE PACE  " + FpsHud.FormatTime(st.Bronze); }
        FpsHud.SetText(this.chipPace, paceText);
        FpsHud.SetClass(this.chipPace, "fps-label fps-chip-pace " + FpsHud.MedalClass(pace));

        // 顶部中央：大计时 + 奖励飘字
        FpsHud.Box(this.timer, w / 2 - (int)(160 * s), top + (int)(8 * s), (int)(320 * s), (int)(56 * s), (int)(46 * s));
        FpsHud.SetText(this.timer, FpsHud.FormatTime(net));
        FpsHud.SetClass(this.timer, "fps-label fps-timer " + FpsHud.MedalClass(pace));
        FpsHud.Box(this.bonus, w / 2 - (int)(160 * s), top + (int)(64 * s), (int)(320 * s), (int)(26 * s), (int)(20 * s));
        FpsHud.SetText(this.bonus, view.bonusText);

        // 右上：进度环 + 连击 + 碎片
        int sw = (int)(250 * s);
        FpsHud.Box(this.stats, w - sw - (int)(20 * s), top + (int)(14 * s), sw, (int)(92 * s), 0);
        int rs = (int)(72 * s);
        FpsHud.Box(this.ring, (int)(10 * s), (int)(10 * s), rs, rs, 0);
        this.ring.StrokeWidth((int)(7 * s) > 2 ? (int)(7 * s) : 2);
        this.ring.SetPercent(n > 0 ? this.game.taggedCount * 100 / n : 0);
        FpsHud.Box(this.ringText, (int)(10 * s), (int)(28 * s), rs, (int)(24 * s), (int)(20 * s));
        FpsHud.SetText(this.ringText, Convert.ToString(this.game.taggedCount) + "/" + Convert.ToString(n));
        FpsHud.Box(this.ringSub, (int)(10 * s), (int)(50 * s), rs, (int)(14 * s), (int)(9 * s));
        int cx = (int)(96 * s);
        int cw = sw - cx - (int)(14 * s);
        FpsHud.Box(this.combo, cx, (int)(12 * s), cw, (int)(26 * s), (int)(20 * s));
        int c = this.game.combo;
        FpsHud.SetText(this.combo, c >= 2 ? "COMBO x" + Convert.ToString(c) : "COMBO  -");
        FpsHud.SetClass(this.combo, c >= 2 ? "fps-label fps-combo fps-hot" : "fps-label fps-combo");
        FpsHud.Box(this.comboBar, cx, (int)(42 * s), cw, (int)(8 * s), 0);
        this.comboBar.StrokeWidth((int)(6 * s) > 2 ? (int)(6 * s) : 2);
        this.comboBar.SetPercent((int)(this.game.ComboLeft() * 100.0f));
        FpsHud.Box(this.shard, cx, (int)(58 * s), cw, (int)(22 * s), (int)(14 * s));
        FpsHud.SetText(this.shard, this.game.shardTaken ? "SHARD FOUND  -2.0s" : (view.shardEver ? "SHARD  (found before)" : "SHARD  hidden"));
        FpsHud.SetClass(this.shard, this.game.shardTaken ? "fps-label fps-shard fps-gold" : "fps-label fps-shard");

        // 准星（状态 + 命中闪）与下方说明
        int ch = (int)(64 * s);
        FpsHud.Box(this.crosshair, w / 2 - ch / 2, h / 2 - ch / 2, ch, ch, 0);
        this.crosshair.state = this.game.aimState;
        this.crosshair.hitMs = view.hitMs;
        this.crosshair.pulse = view.pulse;
        string cc = "fps-crosshair";
        if (this.game.aimState == 1) { cc = "fps-crosshair fps-x-lock"; }
        else if (this.game.aimState == 2) { cc = "fps-crosshair fps-x-far"; }
        else if (this.game.aimState == 3) { cc = "fps-crosshair fps-x-pad"; }
        FpsHud.SetClass(this.crosshair, cc);
        FpsHud.Box(this.aim, w / 2 - (int)(200 * s), h / 2 + (int)(40 * s), (int)(400 * s), (int)(22 * s), (int)(15 * s));
        string aimText = "";
        string aimCls = "fps-label fps-aim";
        if (this.game.aimState == 1) {
            aimText = "LOCKED  " + Convert.ToString((int)this.game.hitDistance) + " m";
            aimCls = "fps-label fps-aim fps-x-lock";
        } else if (this.game.aimState == 2) {
            aimText = "OUT OF RANGE  " + Convert.ToString((int)this.game.hitDistance) + " m  (max 16)";
            aimCls = "fps-label fps-aim fps-x-far";
        } else if (this.game.aimState == 3) {
            aimText = "STAND ON THE MATCHING PAD";
            aimCls = "fps-label fps-aim fps-x-pad";
        }
        FpsHud.SetText(this.aim, aimText);
        FpsHud.SetClass(this.aim, aimCls);

        // 倒计时 3-2-1-GO
        FpsHud.Box(this.countdown, 0, h / 2 - (int)(150 * s), w, (int)(110 * s), (int)(96 * s));
        if (this.game.InCountdown()) {
            int beat = (int)(this.game.countdownMs / 800.0) + 1;
            FpsHud.SetText(this.countdown, Convert.ToString(beat));
            FpsHud.SetClass(this.countdown, "fps-label fps-count");
        } else {
            FpsHud.SetText(this.countdown, "GO!");
            FpsHud.SetClass(this.countdown, "fps-label fps-count fps-go");
        }

        FpsHud.Box(this.toast, 0, h / 2 + (int)(70 * s), w, (int)(34 * s), (int)(24 * s));
        FpsHud.SetText(this.toast, view.toast);
        FpsHud.SetClass(this.toast, view.toastGood ? "fps-label fps-toast fps-good" : "fps-label fps-toast fps-bad");

        FpsHud.Box(this.hint, 0, h - (int)(44 * s), w, (int)(24 * s), (int)(15 * s));
        FpsHud.SetText(this.hint, this.game.freeLookMode
            ? "WASD move  |  SPACE jump  |  SHIFT sprint  |  mouse: look (free)  |  F release  |  CLICK tag  |  P pause"
            : "WASD move  |  SPACE jump  |  SHIFT sprint  |  hold mouse + drag: look  |  F free look  |  CLICK tag  |  P pause");
        FpsHud.Box(this.sound, w - (int)(220 * s), h - (int)(30 * s), (int)(204 * s), (int)(20 * s), (int)(12 * s));
        FpsHud.SetText(this.sound, (view.muted ? "SOUND OFF" : "SOUND ON") + "  [M]   " + (this.game.freeLookMode ? "FREE LOOK [F]" : "DRAG LOOK [F]"));

        FpsHud.Box(this.flash, 0, 0, w, h, 0);
        if (view.flashMs > 0) {
            int a = view.flashMs * 22 / 160;
            if (a > 22) { a = 22; }
            string col = "rgba(" + Convert.ToString((view.flashColor >> 16) & 255) + "," + Convert.ToString((view.flashColor >> 8) & 255)
                + "," + Convert.ToString(view.flashColor & 255) + ",0." + (a < 10 ? "0" : "") + Convert.ToString(a) + ")";
            string fs = "left:0dpx;top:0dpx;width:" + Convert.ToString(w) + "dpx;height:" + Convert.ToString(h) + "dpx;background:" + col;
            if (this.flash.inlineStyleCss != fs) { this.flash.SetProp("style", fs); }
        }

        this.SyncMarkers(w, h, s, top, playing);
    }

    // 目标指示：屏幕内菱形 + 距离；屏幕外贴边箭头
    void SyncMarkers(int w, int h, double s, int top, bool playing) {
        FpsStage st = this.game.stage;
        Camera3D cam = this.game.camera;
        Vector3 eye = cam.Position;
        Vector3 fwd = cam.Forward();
        Vector3 right = cam.Right();
        Vector3 up = Vector3.Normalize(Vector3.Cross(right, fwd));
        int ms = (int)(26 * s);
        int mo = (int)(40 * s);
        int count = 0;
        for (int i = 0; i < this.game.targetCount && i < FpsHud.MaxMarkers; i = i + 1) {
            FpsMarker mk = this.markers[i];
            Label tx = this.markerText[i];
            if (!playing || this.game.tagged[i] || this.game.complete) {
                mk.SetShown(false);
                tx.SetShown(false);
                continue;
            }
            Vector3 p = this.game.targetPos[i];
            float half = this.game.targetHalf[i];
            Vector3 head = new Vector3(p.X, p.Y + half + 0.7f, p.Z);
            float dist = Vector3.Distance(p, eye);
            float sx = 0.0f;
            float sy = 0.0f;
            float depth = 0.0f;
            Vector3 rel = Vector3.Subtract(head, eye);
            bool front = Vector3.Dot(rel, fwd) > 0.2f;
            bool onScreen = front && Raycast3D.WorldToScreen(head, w, h, cam, out sx, out sy, out depth)
                && sx > (float)mo && sx < (float)(w - mo) && sy > (float)(top + mo + (int)(90 * s)) && sy < (float)(h - mo);
            mk.color = st.Targets[i].Color;
            mk.gated = st.Targets[i].Pad >= 0;
            mk.focus = this.game.aimIndex == i;
            if (onScreen) {
                mk.offscreen = false;
                FpsHud.Box(mk, (int)sx - ms / 2, (int)sy - ms / 2, ms, ms, 0);
                FpsHud.Box(tx, (int)sx - (int)(40 * s), (int)sy + ms / 2, (int)(80 * s), (int)(16 * s), (int)(11 * s));
            } else {
                // 方向投到相机平面：x 向右、y 向下（屏幕坐标）
                float rx = Vector3.Dot(rel, right);
                float ry = 0.0f - Vector3.Dot(rel, up);
                if (!front && rx * rx + ry * ry < 0.01f) { rx = 1.0f; }
                float len = (float)Math.Sqrt((double)(rx * rx + ry * ry));
                if (len < 0.0001f) { len = 1.0f; }
                float dx = rx / len;
                float dy = ry / len;
                // 箭头只贴在 HUD 顶栏之下、提示行之上的区域，不压计时与面板
                int bandTop = top + (int)(118 * s);
                int bandBot = h - (int)(56 * s);
                float hw = (float)(w / 2 - mo);
                float hh = (float)((bandBot - bandTop) / 2 - (int)(16 * s));
                float k = 1.0e9f;
                if (dx > 0.001f || dx < -0.001f) { k = hw / (dx > 0.0f ? dx : 0.0f - dx); }
                if (dy > 0.001f || dy < -0.001f) {
                    float ky = hh / (dy > 0.0f ? dy : 0.0f - dy);
                    if (ky < k) { k = ky; }
                }
                int ax = w / 2 + (int)(dx * k);
                int ay = (bandTop + bandBot) / 2 + (int)(dy * k);
                mk.offscreen = true;
                mk.angle = (float)Math.Atan2((double)dy, (double)dx);
                int as2 = (int)(30 * s);
                FpsHud.Box(mk, ax - as2 / 2, ay - as2 / 2, as2, as2, 0);
                int ty = ay + as2 / 2;
                if (ty > h - (int)(20 * s)) { ty = ay - as2 / 2 - (int)(16 * s); }
                FpsHud.Box(tx, ax - (int)(40 * s), ty, (int)(80 * s), (int)(16 * s), (int)(11 * s));
            }
            FpsHud.SetText(tx, Convert.ToString((int)dist) + " m");
            FpsHud.SetClass(tx, dist <= FpsGame.TagRange ? "fps-label fps-mtext fps-inrange" : "fps-label fps-mtext");
            mk.SetShown(true);
            tx.SetShown(true);
            count = count + 1;
        }
        for (int i = this.game.targetCount; i < FpsHud.MaxMarkers; i = i + 1) {
            this.markers[i].SetShown(false);
            this.markerText[i].SetShown(false);
        }
    }

    public void Render(Gui.App app) {
        this.layer.Paint(app);
    }

    public void Stop() {
        this.layer.SetVisible(false);
        this.layer.Clear();
    }
}

// FpsLoop 汇总给 HUD/菜单的应用层状态（档案、静音、提示、结算），
// 让界面层不依赖 GameProfile/音频。
public class FpsView {
    public bool muted;
    public bool showHint;
    public bool autoPaused;
    public string toast;
    public bool toastGood;
    public string bonusText;
    public int bonusMs;
    public int hitMs;
    public int flashMs;
    public int flashColor;
    public float pulse;
    public bool shardEver;
    public long plays;
    public long clears;

    // 每关档案
    public bool[] hasBest;
    public long[] bestMs;
    public bool[] shardFound;
    public bool[] unlocked;
    public int selected;

    // 结算
    public long lastNet;
    public long lastRaw;
    public long lastCombo;
    public long lastShard;
    public bool newBest;
    public int medal;
    public int prevMedal;
    public int bestCombo;
    public bool unlockedNext;

    public FpsView() {
        int n = FpsStages.Count();
        this.toast = "";
        this.toastGood = true;
        this.bonusText = "";
        this.hasBest = new bool[n];
        this.bestMs = new long[n];
        this.shardFound = new bool[n];
        this.unlocked = new bool[n];
        this.unlocked[0] = true;
    }

    public int MedalOf(int stage, FpsStage def) {
        if (!this.hasBest[stage]) { return 0; }
        return def.MedalFor(this.bestMs[stage]);
    }
}
