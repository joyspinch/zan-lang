using System;
using Gui;
using Gui.Widget;
using Game.Foundation.Gui;

namespace Fps3D;

public class FpsHud {
    public Panel root;
    public Label position;
    public Label backend;
    public Label viewMode;
    public Label aim;
    public FpsCrosshair crosshair;
    public HudLayer layer;
    FpsGame game;

    public FpsHud(Gui.App app, FpsGame game) {
        this.game = game;
        app.UseCss(FpsHud.Css());
        this.root = new Panel("fps-hud");
        this.root.Class = "fps-hud";
        Panel status = new Panel("fps-status");
        status.Class = "fps-status";
        this.root.Add(status);
        Label title = new Label("3D FIRST-PERSON EXPLORER");
        title.Class = "fps-title";
        status.Add(title);
        this.position = new Label("");
        this.position.Class = "fps-position";
        status.Add(this.position);
        this.backend = new Label("");
        status.Add(this.backend);
        this.viewMode = new Label("");
        status.Add(this.viewMode);
        this.aim = new Label("");
        status.Add(this.aim);
        this.crosshair = new FpsCrosshair();
        this.crosshair.Class = "fps-crosshair";
        this.root.Add(this.crosshair);
        this.layer = new HudLayer();
        this.layer.Add(this.root);
        // Preserve the existing raw-Canvas world/HUD geometry, including (640,360).
        this.layer.SetBounds(0, 0, app.canvas.Width(), app.canvas.Height());
        this.layer.Bind(app);
        this.SyncState(app);
    }

    public void SyncState(Gui.App app) {
        this.position.SetProp("text", "POS: (" + Convert.ToString((int)game.controller.Position.X)
            + ", " + Convert.ToString((int)game.controller.Position.Y)
            + ", " + Convert.ToString((int)game.controller.Position.Z) + ")");
        bool gpu = game.drawResult > 0;
        this.backend.SetProp("text", "BACKEND: "
            + (gpu ? "GPU (OpenGL 3.3)" : "CPU (3D Wireframe Fallback)"));
        this.backend.Class = gpu ? "fps-backend fps-gpu" : "fps-backend fps-cpu";
        this.viewMode.SetProp("text", game.freeLookMode
            ? "VIEW: [FREE LOOK MODE] Click RMB or ESC to release"
            : "VIEW: [DRAG MODE] Hold RMB/LMB or Click RMB to toggle");
        this.viewMode.Class = game.freeLookMode ? "fps-view fps-free" : "fps-view fps-drag";
        this.aim.SetProp("text", game.targetHit
            ? "LOCKED ON CUBE (DIST: " + Convert.ToString((int)game.hitDistance) + "m)"
            : "AIM: NO TARGET [WASD MOVE | SPACE/SHIFT ELEVATE]");
        this.aim.Class = game.targetHit ? "fps-aim fps-locked" : "fps-aim";
        this.crosshair.Class = game.targetHit ? "fps-crosshair fps-locked" : "fps-crosshair";
        this.layer.SetBounds(0, 0, app.canvas.Width(), app.canvas.Height());
        this.layer.SetVisible(app.window.GetHandle() == 0 || app.window.IsVisible());
    }

    public void Render(Gui.App app) {
        this.layer.Paint(app);
    }

    public void Stop() {
        this.layer.SetVisible(false);
        this.layer.Clear();
    }

    public static string Css() {
        return ".fps-hud{position:relative;background:transparent;padding:0;border:0}"
            + ".fps-status{position:absolute;left:10dpx;top:10dpx;width:490dpx;height:115dpx;"
            + "padding:0;border:0;background:rgba(0,0,0,0.8)}"
            + ".fps-status label{position:absolute;left:10dpx;width:480dpx;height:24dpx;"
            + "padding:0;margin:0;border:0;background:transparent;text-align:left;vertical-align:top}"
            + ".fps-title{top:8dpx;font-size:16dpx;color:#00e5ff}"
            + ".fps-position{top:28dpx;font-size:14dpx;color:#fff}"
            + ".fps-backend{top:48dpx;font-size:13dpx}.fps-gpu{color:#52c41a}.fps-cpu{color:#faad14}"
            + ".fps-view{top:66dpx;font-size:13dpx}.fps-free{color:#00e5ff}.fps-drag{color:#ffa940}"
            + ".fps-aim{top:84dpx;font-size:13dpx;color:#aaa}"
            + ".fps-aim.fps-locked{font-size:14dpx;color:#00ff00}"
            + ".fps-crosshair{position:absolute;left:632dpx;top:352dpx;width:17dpx;height:17dpx;"
            + "padding:0;border:0;background:transparent;color:#fff}"
            + ".fps-crosshair.fps-locked{color:#00ff00}";
    }
}
