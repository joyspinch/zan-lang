using System;
using Gui;

namespace Fps3D;

// 准星：标准保留树里的自绘小控件（只画准星本身，位置与颜色来自 HUD 皮肤）。
// state：0 空闲（细十字 + 中心点）、1 锁定（十字张开 + 四角括号）、2 太远（虚十字）、
// 3 需站踏台（十字 + 下方小方框）。hitMs > 0 时叠一个"命中 X"短闪。
public class FpsCrosshair : Control {
    public int state;
    public int hitMs;
    public float pulse;

    public override void OnPaint(Gui.App app) {
        if (bw <= 0 || bh <= 0) { return; }
        int color = this.Box(app).FgOr(unchecked((int)0xFFFFFFFF));
        int cx = bx + bw / 2;
        int cy = by + bh / 2;
        int u = bw / 12;
        if (u < 2) { u = 2; }
        int t = u >= 4 ? 3 : 2;
        int shadow = unchecked((int)0x90000000);
        if (this.state == 1) {
            int gap = u * 2 + (int)(this.pulse * (float)u);
            int len = u * 3;
            this.Cross(app, cx, cy, gap, len, shadow, t + 2);
            this.Cross(app, cx, cy, gap, len, color, t);
            int r = u * 5 + (int)(this.pulse * (float)u);
            int k = u * 2;
            this.Bracket(app, cx - r, cy - r, k, k, color, t);
            this.Bracket(app, cx + r, cy - r, 0 - k, k, color, t);
            this.Bracket(app, cx - r, cy + r, k, 0 - k, color, t);
            this.Bracket(app, cx + r, cy + r, 0 - k, 0 - k, color, t);
        } else if (this.state == 2) {
            int gap = u * 2;
            app.canvas.FillCircle(cx, cy, t, color);
            for (int i = 0; i < 3; i = i + 1) {
                int a = gap + i * u * 2;
                app.canvas.DrawLine(cx + a, cy, cx + a + u, cy, color, t);
                app.canvas.DrawLine(cx - a, cy, cx - a - u, cy, color, t);
            }
        } else {
            int gap = u;
            int len = u * 3;
            this.Cross(app, cx, cy, gap, len, shadow, t + 2);
            this.Cross(app, cx, cy, gap, len, color, t);
            app.canvas.FillCircle(cx, cy, t - 1 > 1 ? t - 1 : 1, color);
            if (this.state == 3) {
                int s = u * 3;
                app.canvas.DrawRect(cx - s, cy + u * 6, s * 2, u * 2, color, t);
            }
        }
        if (this.hitMs > 0) {
            int hit = unchecked((int)0xFFFFFFFF);
            int a0 = u * 2;
            int a1 = u * 5;
            app.canvas.DrawLine(cx - a0, cy - a0, cx - a1, cy - a1, hit, t + 1);
            app.canvas.DrawLine(cx + a0, cy - a0, cx + a1, cy - a1, hit, t + 1);
            app.canvas.DrawLine(cx - a0, cy + a0, cx - a1, cy + a1, hit, t + 1);
            app.canvas.DrawLine(cx + a0, cy + a0, cx + a1, cy + a1, hit, t + 1);
        }
    }

    void Cross(Gui.App app, int cx, int cy, int gap, int len, int color, int t) {
        app.canvas.DrawLine(cx - gap - len, cy, cx - gap, cy, color, t);
        app.canvas.DrawLine(cx + gap, cy, cx + gap + len, cy, color, t);
        app.canvas.DrawLine(cx, cy - gap - len, cx, cy - gap, color, t);
        app.canvas.DrawLine(cx, cy + gap, cx, cy + gap + len, color, t);
    }

    void Bracket(Gui.App app, int x, int y, int dx, int dy, int color, int t) {
        app.canvas.DrawLine(x, y, x + dx, y, color, t);
        app.canvas.DrawLine(x, y, x, y + dy, color, t);
    }
}

// 目标指示：屏幕内是目标头顶的菱形（踏台目标外加圆环），屏幕外是贴边、指向目标的箭头。
// 颜色就是目标本身的世界配色（世界信息），透明度随距离衰减。
public class FpsMarker : Control {
    public int color;
    public bool offscreen;
    // 屏幕外箭头的朝向（弧度，0 = 向右，顺时针为正）
    public float angle;
    public bool gated;
    public bool focus;

    public override void OnPaint(Gui.App app) {
        if (bw <= 0 || bh <= 0) { return; }
        int cx = bx + bw / 2;
        int cy = by + bh / 2;
        int r = bw / 2 - 2;
        int col = unchecked((int)0xFF000000) | (this.color & 0xFFFFFF);
        int dark = unchecked((int)0xA0000000);
        if (this.offscreen) {
            float ca = (float)Math.Cos((double)this.angle);
            float sa = (float)Math.Sin((double)this.angle);
            int tx = cx + (int)(ca * (float)r);
            int ty = cy + (int)(sa * (float)r);
            int bx0 = cx + (int)((-ca * 0.6f - sa * 0.75f) * (float)r);
            int by0 = cy + (int)((-sa * 0.6f + ca * 0.75f) * (float)r);
            int bx1 = cx + (int)((-ca * 0.6f + sa * 0.75f) * (float)r);
            int by1 = cy + (int)((-sa * 0.6f - ca * 0.75f) * (float)r);
            app.canvas.FillCircle(cx, cy, r, dark);
            app.canvas.DrawLine(bx0, by0, tx, ty, col, 4);
            app.canvas.DrawLine(bx1, by1, tx, ty, col, 4);
            app.canvas.DrawCircle(cx, cy, r, col, 2);
            return;
        }
        int d = r * 3 / 4;
        if (this.focus) { d = r; }
        app.canvas.DrawLine(cx, cy - d, cx + d, cy, dark, 6);
        app.canvas.DrawLine(cx + d, cy, cx, cy + d, dark, 6);
        app.canvas.DrawLine(cx, cy + d, cx - d, cy, dark, 6);
        app.canvas.DrawLine(cx - d, cy, cx, cy - d, dark, 6);
        app.canvas.DrawLine(cx, cy - d, cx + d, cy, col, 3);
        app.canvas.DrawLine(cx + d, cy, cx, cy + d, col, 3);
        app.canvas.DrawLine(cx, cy + d, cx - d, cy, col, 3);
        app.canvas.DrawLine(cx - d, cy, cx, cy - d, col, 3);
        app.canvas.FillCircle(cx, cy, d / 3 > 1 ? d / 3 : 1, col);
        if (this.gated) { app.canvas.DrawCircle(cx, cy, r, col, 2); }
    }
}
