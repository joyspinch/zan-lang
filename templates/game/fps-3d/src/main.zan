using System;
using Gui;
using Game.Foundation.Gui;
using Fps3D;

public class FpsLoop : IGuiHostLoop {
    public FpsGame game;
    public bool sceneInited;
    public int lastMouseX;
    public int lastMouseY;

    public void Start(GuiHost host) {
        this.game = FpsGame.Create();
        this.sceneInited = false;
        this.lastMouseX = host.MouseX();
        this.lastMouseY = host.MouseY();
    }

    public void Event(GuiHost host, int kind, int code) {
        if (kind == 4) { // KeyDown
            if (code == 27) { // ESC 退出
                host.App().isRunning = false;
            } else {
                this.game.OnKeyDown(code);
            }
        } else if (kind == 5) { // KeyUp
            this.game.OnKeyUp(code);
        } else if (kind == 2) { // MouseMove
            int mx = host.MouseX();
            int my = host.MouseY();
            int dx = mx - this.lastMouseX;
            int dy = my - this.lastMouseY;
            this.lastMouseX = mx;
            this.lastMouseY = my;

            // 限制单帧最大位移扰动
            if (Math.Abs(dx) < 200 && Math.Abs(dy) < 200) {
                this.game.OnMouseMove((float)dx, (float)dy);
            }
        }
    }

    public void FixedUpdate(GuiHost host, int dt) {
        this.game.Tick((double)dt / 1000.0);
    }

    public void Update(GuiHost host, int dt) { }

    public void Render(GuiHost host, Canvas c, double alpha) {
        if (!sceneInited) {
            this.game.InitScene(c);
            this.sceneInited = true;
        }
        this.game.Render(c);
    }

    public void Stop(GuiHost host) { }
}

public class App {
    public static void Main() {
        GuiHost host = new GuiHost("3D First-Person Explorer - Zan Game", 1280, 720, 60);
        host.Run(new FpsLoop());
    }
}
