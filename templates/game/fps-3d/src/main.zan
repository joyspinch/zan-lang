using System;
using Gui;
using Game.Foundation.Gui;
using Fps3D;

public class FpsLoop : IGuiHostLoop {
    public FpsGame game;
    public bool sceneInited;
    public int lastMouseX;
    public int lastMouseY;

    public bool isDragging;
    public int rightDownX;
    public int rightDownY;
    public bool rightButtonDown;

    public void Start(GuiHost host) {
        // 关键：切换到 GPU 硬件加速后端 (1 = GL 3.3)，激活 3D 光栅化与深度缓冲管线
        int backend = host.App().SetRenderBackend(1);
        string backendName = host.App().RenderBackendName();

        this.game = FpsGame.Create();
        this.game.backendName = backendName;
        this.game.isGpuBackend = (backend == 1);

        this.sceneInited = false;
        this.isDragging = false;
        this.rightButtonDown = false;
        this.rightDownX = 0;
        this.rightDownY = 0;
        this.lastMouseX = host.MouseX();
        this.lastMouseY = host.MouseY();
    }

    public void Event(GuiHost host, int kind, int code) {
        if (kind == 4) { // KeyDown
            if (code == 27) { // ESC 键：若处于自由视角模式则退出视角锁定；否则退出程序
                if (this.game.freeLookMode) {
                    this.game.freeLookMode = false;
                } else {
                    host.App().isRunning = false;
                }
            } else if (code == 70) { // 'F' 键：快速切换自由视角模式
                this.game.freeLookMode = !this.game.freeLookMode;
                this.lastMouseX = host.MouseX();
                this.lastMouseY = host.MouseY();
            } else {
                this.game.OnKeyDown(code);
            }
        } else if (kind == 5) { // KeyUp
            this.game.OnKeyUp(code);
        } else if (kind == 2) { // MouseDown (code: 0=左键, 1=右键)
            int mx = host.MouseX();
            int my = host.MouseY();
            this.isDragging = true;
            this.lastMouseX = mx;
            this.lastMouseY = my;

            if (code == 1) { // 右键按下，记录起始坐标以识别单击与拖拽
                this.rightButtonDown = true;
                this.rightDownX = mx;
                this.rightDownY = my;
            }
        } else if (kind == 3) { // MouseUp (code: 0=左键, 1=右键)
            int mx = host.MouseX();
            int my = host.MouseY();
            this.isDragging = false;

            if (code == 1 && this.rightButtonDown) {
                this.rightButtonDown = false;
                // 若按下到抬起位移极小（< 8 像素），判定为单击切换自由视角
                int dDownX = mx - this.rightDownX;
                if (dDownX < 0) { dDownX = -dDownX; }
                int dDownY = my - this.rightDownY;
                if (dDownY < 0) { dDownY = -dDownY; }
                if (dDownX < 8 && dDownY < 8) {
                    this.game.freeLookMode = !this.game.freeLookMode;
                    this.lastMouseX = mx;
                    this.lastMouseY = my;
                }
            }
        } else if (kind == 1) { // MouseMove
            int mx = host.MouseX();
            int my = host.MouseY();
            int dx = mx - this.lastMouseX;
            int dy = my - this.lastMouseY;
            this.lastMouseX = mx;
            this.lastMouseY = my;

            // 当按住鼠标拖拽 或 处于自由视角模式时，平滑转动 3D 视角
            if (this.isDragging || this.game.freeLookMode) {
                if (Math.Abs(dx) < 300 && Math.Abs(dy) < 300) {
                    this.game.OnMouseMove((float)dx, (float)dy);
                }
            }
        }
    }

    public void FixedUpdate(GuiHost host, int dt) {
        this.game.Tick((double)dt / 1000.0);
    }

    public void Update(GuiHost host, int dt) { }

    public void Render(GuiHost host, Canvas c, double alpha) {
        if (!sceneInited) {
            this.game.InitScene(c);
            this.sceneInited = true;
        }
        this.game.Render(c);
    }

    public void Stop(GuiHost host) { }
}

public class App {
    public static void Main() {
        GuiHost host = new GuiHost("3D First-Person Explorer - Zan Game", 1280, 720, 60);
        host.Run(new FpsLoop());
    }
}
