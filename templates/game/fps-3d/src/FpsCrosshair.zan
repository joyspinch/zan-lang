using Gui;

namespace Fps3D;

// The template's exact + glyph is a retained control; application Render draws
// only the world. Its position and target-state color come from the HUD skin.
public class FpsCrosshair : Control {
    public override void OnPaint(Gui.App app) {
        if (bw <= 0 || bh <= 0) { return; }
        int color = this.Box(app).FgOr(0);
        int cx = bx + bw / 2;
        int cy = by + bh / 2;
        app.canvas.DrawLine(bx, cy, bx + bw - 1, cy, color, 2);
        app.canvas.DrawLine(cx, by, cx, by + bh - 1, color, 2);
    }
}
