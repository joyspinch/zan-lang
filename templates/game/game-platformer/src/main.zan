using System;
using Game.Kit;

// 游戏实体结构（值语义/复用实例，零GC堆分配）
class Platform {
    public float x;
    public float y;
    public float w;
    public float h;

    public Platform(float x, float y, float w, float h) {
        this.x = x;
        this.y = y;
        this.w = w;
        this.h = h;
    }
}

class Particle {
    public float x;
    public float y;
    public float vx;
    public float vy;
    public float life;
    public float maxLife;
    public bool active;

    public void Reset(float px, float py, float pvx, float pvy, float duration) {
        this.x = px;
        this.y = py;
        this.vx = pvx;
        this.vy = pvy;
        this.life = duration;
        this.maxLife = duration;
        this.active = true;
    }
}

class {{NAME}} {
    // 物理与手感参数常量
    const float GRAVITY = 1100.0f;
    const float MOVE_SPEED = 320.0f;
    const float JUMP_VELOCITY = -520.0f;
    const float COYOTE_TIME_MAX = 0.12f;   // 土狼时间（离台后仍可起跳窗口）
    const float JUMP_BUFFER_MAX = 0.15f;   // 跳跃输入缓冲（着陆前按键有效窗口）

    // 角色状态
    static float playerX = 100.0f;
    static float playerY = 300.0f;
    static float playerVx = 0.0f;
    static float playerVy = 0.0f;
    static float playerW = 28.0f;
    static float playerH = 44.0f;
    static bool isGrounded = false;
    static float coyoteTimer = 0.0f;
    static float jumpBufferTimer = 0.0f;

    // 平滑弹性相机
    static float cameraX = 0.0f;
    static float cameraY = 0.0f;
    static float cameraShake = 0.0f;

    // 静态场景物件与粒子对象池（彻底消除运行时堆分配）
    static List<Platform> platforms = new List<Platform>();
    static Particle[] particlePool = new Particle[64];

    static void Main() {
        InitScene();
        GameEngine.Init("2D Platformer Engine - Zero-Alloc Loop", 1280, 720);
        GameEngine.Run(Update, Render);
    }

    static void InitScene() {
        // 初始化平台地图
        platforms.Add(new Platform(0.0f, 620.0f, 1280.0f, 100.0f)); // 地面
        platforms.Add(new Platform(200.0f, 500.0f, 220.0f, 24.0f));
        platforms.Add(new Platform(500.0f, 400.0f, 260.0f, 24.0f));
        platforms.Add(new Platform(850.0f, 320.0f, 200.0f, 24.0f));
        platforms.Add(new Platform(400.0f, 220.0f, 180.0f, 24.0f));

        // 预分配粒子池（Zero-Alloc）
        for (int i = 0; i < 64; i = i + 1) {
            particlePool[i] = new Particle();
            particlePool[i].active = false;
        }
    }

    // 零分配 60FPS 物理循环
    static void Update(float dt) {
        // 限制极端单帧步长防止穿模
        if (dt > 0.033f) { dt = 0.033f; }

        // 1. 水平输入响应
        float moveDir = 0.0f;
        if (GameEngine.IsKeyDown(KeyCode.A) || GameEngine.IsKeyDown(KeyCode.Left)) {
            moveDir = moveDir - 1.0f;
        }
        if (GameEngine.IsKeyDown(KeyCode.D) || GameEngine.IsKeyDown(KeyCode.Right)) {
            moveDir = moveDir + 1.0f;
        }
        playerVx = moveDir * MOVE_SPEED;

        // 2. 输入缓冲（Jump Buffering）更新
        if (GameEngine.IsKeyPressed(KeyCode.Space) || GameEngine.IsKeyPressed(KeyCode.W)) {
            jumpBufferTimer = JUMP_BUFFER_MAX;
        } else if (jumpBufferTimer > 0.0f) {
            jumpBufferTimer = jumpBufferTimer - dt;
        }

        // 3. 土狼时间（Coyote Time）更新
        if (isGrounded) {
            coyoteTimer = COYOTE_TIME_MAX;
        } else if (coyoteTimer > 0.0f) {
            coyoteTimer = coyoteTimer - dt;
        }

        // 4. 起跳判定（结合缓冲与土狼时间，消除失灵手感）
        if (jumpBufferTimer > 0.0f && coyoteTimer > 0.0f) {
            playerVy = JUMP_VELOCITY;
            jumpBufferTimer = 0.0f;
            coyoteTimer = 0.0f;
            isGrounded = false;
            SpawnDust(playerX + playerW * 0.5f, playerY + playerH, 6);
        }

        // 5. 变高跳跃支持（松开跳跃键截断重力上升）
        if (!GameEngine.IsKeyDown(KeyCode.Space) && playerVy < -100.0f) {
            playerVy = playerVy + GRAVITY * dt * 1.5f;
        } else {
            playerVy = playerVy + GRAVITY * dt;
        }

        // 6. 水平移动与平台碰撞
        playerX = playerX + playerVx * dt;

        // 7. 垂直移动与碰撞
        playerY = playerY + playerVy * dt;
        isGrounded = false;

        for (int i = 0; i < platforms.Count; i = i + 1) {
            Platform p = platforms[i];
            // AABB 碰撞检测
            if (playerX + playerW > p.x && playerX < p.x + p.w) {
                // 自上而下着陆判定
                if (playerY + playerH >= p.y && playerY + playerH - playerVy * dt <= p.y + 12.0f && playerVy >= 0.0f) {
                    playerY = p.y - playerH;
                    playerVy = 0.0f;
                    isGrounded = true;
                }
            }
        }

        // 8. 平滑弹性相机跟随（Spring-Damper）
        float targetCamX = playerX - 640.0f + playerW * 0.5f;
        float targetCamY = playerY - 360.0f + playerH * 0.5f;
        cameraX = cameraX + (targetCamX - cameraX) * (dt * 8.0f);
        cameraY = cameraY + (targetCamY - cameraY) * (dt * 8.0f);

        // 9. 更新粒子系统（零堆分配）
        UpdateParticles(dt);
    }

    static void SpawnDust(float px, float py, int count) {
        int spawned = 0;
        for (int i = 0; i < 64; i = i + 1) {
            if (!particlePool[i].active) {
                float vx = (Convert.ToSingle((i * 17) % 100) - 50.0f) * 1.2f;
                float vy = -Convert.ToSingle((i * 13) % 60 + 20);
                particlePool[i].Reset(px, py, vx, vy, 0.35f);
                spawned = spawned + 1;
                if (spawned >= count) { break; }
            }
        }
    }

    static void UpdateParticles(float dt) {
        for (int i = 0; i < 64; i = i + 1) {
            if (particlePool[i].active) {
                Particle p = particlePool[i];
                p.x = p.x + p.vx * dt;
                p.y = p.y + p.vy * dt;
                p.life = p.life - dt;
                if (p.life <= 0.0f) {
                    p.active = false;
                }
            }
        }
    }

    // 渲染循环（全部基于当前相机偏移变换）
    static void Render() {
        GameEngine.Clear(0x18181B); // 暗色沉浸背景

        float offsetX = cameraX;
        float offsetY = cameraY;

        // 绘制平台
        for (int i = 0; i < platforms.Count; i = i + 1) {
            Platform p = platforms[i];
            GameEngine.DrawRect(p.x - offsetX, p.y - offsetY, p.w, p.h, 0x3F3F46);
            // 平台顶沿高光
            GameEngine.DrawRect(p.x - offsetX, p.y - offsetY, p.w, 4.0f, 0xA1A1AA);
        }

        // 绘制粒子
        for (int i = 0; i < 64; i = i + 1) {
            if (particlePool[i].active) {
                Particle pt = particlePool[i];
                GameEngine.DrawRect(pt.x - offsetX, pt.y - offsetY, 4.0f, 4.0f, 0xE4E4E7);
            }
        }

        // 绘制主角（带动效颜色）
        int heroColor = isGrounded ? 0x22C55E : 0x38BDF8;
        GameEngine.DrawRect(playerX - offsetX, playerY - offsetY, playerW, playerH, heroColor);

        // 绘制 HUD
        GameEngine.DrawText("2D Platformer Engine (Coyote Time + Jump Buffer + Zero-Alloc)", 24, 24, 18, 0xFFFFFF);
        string statusText = "Grounded: " + (isGrounded ? "YES" : "NO") + " | Coyote: " + Convert.ToString(coyoteTimer);
        GameEngine.DrawText(statusText, 24, 52, 14, 0x94A3B8);
    }
}
