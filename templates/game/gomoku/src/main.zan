// 五子棋 -- a warm wood-and-ink gomoku parlor. You play black against a local
// AI whose strength you pick (初学 / 棋士 / 棋圣). Stones are glossy with soft
// shadows on a textured kaya board; the last move glows, placements ripple.
// Wins earn rank points toward titles (棋童→棋圣), streaks bring cheering
// toasts, defeats get an encouraging review line. Esc back/exit.
// GuiHost+Canvas 版：窗口/事件/呈现由 Gui 原生外壳承担（Game.Foundation.Gui），
// 绘制走 Game.Kit.CanvasPrims 直绘，不依赖 SDL；主菜单/对局/结算由
// SceneRouter 路由三个场景（菜单与结算的按钮/文案在 HTML 层）。
using System;
using System.IO;
using Gui;
using Game.Kit;
using Game.Foundation.Gui;

namespace Gomoku;

class GmProfile {
    int pts;        // rank points
    int wins;
    int losses;
    int streak;
    int bestStreak;

    static string Path() { return "gomoku_profile.txt"; }

    static int ParseInt(string s, int start) {
        int i = start; int v = 0; bool any = false;
        while (i < s.Length) { int c = s[i] & 255; if (c >= 48 && c <= 57) { v = v * 10 + (c - 48); any = true; i = i + 1; } else { i = s.Length; } }
        if (!any) { return 0; }
        return v;
    }
    static int ReadKey(List<string> lines, string key, int fb) {
        for (int i = 0; i < lines.Count; i = i + 1) {
            string ln = lines[i]; int eq = -1;
            for (int j = 0; j < ln.Length; j = j + 1) { if (ln[j] == 61) { eq = j; j = ln.Length; } }
            if (eq > 0) { if (ln.Substring(0, eq) == key) { return GmProfile.ParseInt(ln, eq + 1); } }
        }
        return fb;
    }
    static GmProfile Load() {
        GmProfile p = new GmProfile();
        if (!File.Exists(GmProfile.Path())) { return p; }
        List<string> lines = File.ReadAllLines(GmProfile.Path());
        p.pts = GmProfile.ReadKey(lines, "pts", 0);
        p.wins = GmProfile.ReadKey(lines, "wins", 0);
        p.losses = GmProfile.ReadKey(lines, "losses", 0);
        p.streak = GmProfile.ReadKey(lines, "streak", 0);
        p.bestStreak = GmProfile.ReadKey(lines, "bestStreak", 0);
        return p;
    }
    void Save() {
        string s = "pts=" + this.pts + "\nwins=" + this.wins
            + "\nlosses=" + this.losses + "\nstreak=" + this.streak
            + "\nbestStreak=" + this.bestStreak + "\n";
        File.WriteAllText(GmProfile.Path(), s);
    }
    string Title() {
        if (this.pts >= 400) { return "棋圣"; }
        if (this.pts >= 240) { return "国手"; }
        if (this.pts >= 140) { return "棋士"; }
        if (this.pts >= 60) { return "入段"; }
        if (this.pts >= 20) { return "棋童"; }
        return "新手";
    }
}

class GmParticle {
    int x;      // fp 1/256
    int y;
    int vx;
    int vy;
    int bornAt;
    int cr;
    int cg;
    int cb;
}

class GmPopup {
    int x;
    int y;
    string text;
    int bornAt;
    int cr;
    int cg;
    int cb;
}

class GmGame {
    Canvas c;
    GmProfile prof;
    Rng rng;

    int[] board;      // 15*15: 0 empty, 1 black (player), 2 white (AI)
    int diff;         // 0 easy, 1 normal, 2 hard
    int moves;
    int lastX;
    int lastY;
    int winner;       // 0 none, 1 player, 2 ai, 3 draw
    int winX0; int winY0; int winX1; int winY1;
    int aiThinkAt;    // AI answers after a short human-feeling pause
    bool aiTurn;
    int mouseX;
    int mouseY;
    int toastAt;
    string toastText;
    int placedAt;     // ripple animation timestamp
    List<GmParticle> parts;
    List<GmPopup> pops;
    string menuBg;    // asset paths (null = 画布回退画法)
    string titlePath;
    string boardPath;
    string blackPath;
    string whitePath;
    string menuBg2;   // 手绘美术资产（新名，绝不覆盖旧素材）
    string playBg;
    string boardArt;
    string blackPath2;
    string whitePath2;
    bool texTried;
    bool demo;        // self-play showcase for screenshots
    int demoAt;

    static int N() { return 15; }
    // 竖屏（舞台高>宽：手机竖屏或竖长窗口）参照手机棋类布局自适应：
    // 15 路棋盘水平居中放大（格距 52），顶部对手条 + 回合徽标，底部
    // 菜单/重玩按钮行；横屏维持"左棋盘 + 右信息栏"原布局。
    static bool Portrait() { return GmGame.VW() < GmGame.VH(); }
    static int Cell() {
        if (!GmGame.Portrait()) { return 42; }
        // 竖屏自适应：格距收进当前舞台宽（盘面 14c+76 ≤ VW-20），
        // 否则 52 格距在 720 宽的延展舞台上棋盘会左右出界被裁。
        int c = (GmGame.VW() - 96) / 14;
        if (c > 52) { c = 52; }
        if (c < 20) { c = 20; }
        return c;
    }
    static int BX() { return (GmGame.VW() - 14 * GmGame.Cell()) / 2; }
    static int BY() {
        if (!GmGame.Portrait()) { return 66; }
        // 顶部条(0..140) + 徽标带(到 230)之下、底部按钮行(高 110)之上居中
        return 230 + (GmGame.VH() - 230 - 150 - 14 * GmGame.Cell()) / 2;
    }
    // 视口按宿主舞台每帧延展（宽窗多看宽度）：VW/VH 是当前帧的舞台
    // 逻辑尺寸，帧首在 SyncStage 更新——布局锚定它即可满铺任意窗口，
    // 否则长轴超出的部分就是宿主 margin 底色的空条。
    static int VW() { return vw > 0 ? vw : 1280; }
    static int VH() { return vh > 0 ? vh : 720; }

    // 帧首对齐宿主延展舞台（GuiHost.Render 回调开头调用）。
    void SyncStage(GuiHost host) {
        GmGame.vw = host.StageWidth();
        GmGame.vh = host.StageHeight();
    }
    static int vw;
    static int vh;

    static GmGame Create(GuiHost h) {
        GmGame g = new GmGame();
        g.prof = GmProfile.Load();
        g.rng = Rng.Seed((long)Window.GetTickMs() + 1357924);
        g.diff = 1;
        g.mouseX = 640;
        g.mouseY = 360;
        g.parts = new List<GmParticle>();
        g.pops = new List<GmPopup>();
        g.toastAt = -9999;
        g.demo = File.Exists("gomoku_demo.txt");
        if (g.demo) { g.diff = 2; }
        return g;
    }

    void EnsureTex() {
        if (this.texTried) { return; }
        this.texTried = true;
        this.menuBg = GmGame.FindAsset("assets/menu_bg.png");
        this.titlePath = GmGame.FindAsset("assets/title.png");
        this.boardPath = GmGame.FindAsset("assets/board_wood.png");
        this.blackPath = GmGame.FindAsset("assets/stone_black.png");
        this.whitePath = GmGame.FindAsset("assets/stone_white.png");
        this.menuBg2 = GmGame.FindAsset("assets/menu_bg2.png");
        this.playBg = GmGame.FindAsset("assets/play_bg.png");
        this.boardArt = GmGame.FindAsset("assets/board_wood2.png");
        this.blackPath2 = GmGame.FindAsset("assets/stone_black2.png");
        this.whitePath2 = GmGame.FindAsset("assets/stone_white2.png");
    }
    static string FindAsset(string path) {
        string p = Assets.Find(path);
        if (!File.Exists(p)) { return null; }
        return p;
    }

    // 全出血 cover：居中裁剪贴满舞台（长短边都铺满，不留 letterbox 条）。
    static void BlitCover(Canvas c, string path, int dw, int dh) {
        int iw = Canvas.ImageWidth(path);
        int ih = Canvas.ImageHeight(path);
        if (iw <= 0 || ih <= 0) { return; }
        int sw = iw;
        int sh = sw * dh / dw;
        if (sh > ih) { sh = ih; sw = sh * dw / dh; }
        string src = CDraw.BlitSource(c, path);
        if (src == null) { return; }
        c.BlitImage(src, CDraw.MapX(CDraw.originX), CDraw.MapY(CDraw.originY),
                    CDraw.MapW(dw), CDraw.MapW(dh),
                    (iw - sw) / 2, (ih - sh) / 2, sw, sh);
    }

    // ----- feedback --------------------------------------------------------

    void Toast(string t, int now) { this.toastText = t; this.toastAt = now; }
    void AddPop(int px, int py, string t, int now, int cr, int cg, int cb) {
        if (this.pops.Count > 14) { this.pops.RemoveAt(0); }
        GmPopup p = new GmPopup();
        p.x = px; p.y = py; p.text = t; p.bornAt = now;
        p.cr = cr; p.cg = cg; p.cb = cb;
        this.pops.Add(p);
    }
    void Burst(int px, int py, int n, int now, int cr, int cg, int cb) {
        if (this.parts.Count > 240) { return; }
        for (int i = 0; i < n; i = i + 1) {
            GmParticle p = new GmParticle();
            p.x = px * 256; p.y = py * 256;
            int a = this.rng.Range(0, 16);
            int spd = 60 + this.rng.Range(0, 160);
            int ux = 0; int uy = 0;
            int q = a % 4;
            if (q == 0) { ux = 256; uy = (a / 4 - 2) * 128; }
            if (q == 1) { ux = -256; uy = (a / 4 - 2) * 128; }
            if (q == 2) { uy = 256; ux = (a / 4 - 2) * 128; }
            if (q == 3) { uy = -256; ux = (a / 4 - 2) * 128; }
            p.vx = ux * spd / 256;
            p.vy = uy * spd / 256;
            p.bornAt = now;
            p.cr = cr; p.cg = cg; p.cb = cb;
            this.parts.Add(p);
        }
    }

    // ----- game flow -------------------------------------------------------

    void StartGame(int now) {
        this.board = new int[GmGame.N() * GmGame.N()];
        this.moves = 0;
        this.lastX = -1;
        this.lastY = -1;
        this.winner = 0;
        this.aiTurn = false;
        this.parts = new List<GmParticle>();
        this.pops = new List<GmPopup>();
        this.toastAt = -9999;
        this.Toast("执黑先行，五连制胜", now);
    }

    int At(int x, int y) {
        if (x < 0 || y < 0 || x >= GmGame.N() || y >= GmGame.N()) { return -1; }
        return this.board[y * GmGame.N() + x];
    }

    // Counts the c-colored run through (x,y) along (dx,dy); records endpoints.
    bool IsWin(int x, int y, int c) {
        for (int d = 0; d < 4; d = d + 1) {
            int dx = 1; int dy = 0;
            if (d == 1) { dx = 0; dy = 1; }
            if (d == 2) { dx = 1; dy = 1; }
            if (d == 3) { dx = 1; dy = -1; }
            int n = 1;
            int x0 = x; int y0 = y; int x1 = x; int y1 = y;
            int k = 1;
            while (this.At(x + dx * k, y + dy * k) == c) { x1 = x + dx * k; y1 = y + dy * k; n = n + 1; k = k + 1; }
            k = 1;
            while (this.At(x - dx * k, y - dy * k) == c) { x0 = x - dx * k; y0 = y - dy * k; n = n + 1; k = k + 1; }
            if (n >= 5) {
                this.winX0 = x0; this.winY0 = y0; this.winX1 = x1; this.winY1 = y1;
                return true;
            }
        }
        return false;
    }

    void Place(int x, int y, int c, int now) {
        this.board[y * GmGame.N() + x] = c;
        this.moves = this.moves + 1;
        this.lastX = x;
        this.lastY = y;
        this.placedAt = now;
        int sx = GmGame.BX() + x * GmGame.Cell();
        int sy = GmGame.BY() + y * GmGame.Cell();
        if (c == 1) { this.Burst(sx, sy, 5, now, 90, 200, 255); }
        else { this.Burst(sx, sy, 5, now, 255, 210, 140); }
        if (this.IsWin(x, y, c)) {
            this.winner = c;
            if (c == 1) {
                int gain = 10 + this.diff * 10;
                this.prof.pts = this.prof.pts + gain;
                this.prof.wins = this.prof.wins + 1;
                this.prof.streak = this.prof.streak + 1;
                if (this.prof.streak > this.prof.bestStreak) { this.prof.bestStreak = this.prof.streak; }
                this.Burst(640, 300, 60, now, 255, 220, 110);
                if (this.prof.streak >= 3) { this.Toast(this.prof.streak + " 连胜！锐不可当", now); }
            } else {
                this.prof.losses = this.prof.losses + 1;
                this.prof.streak = 0;
                this.prof.pts = this.prof.pts - 4;
                if (this.prof.pts < 0) { this.prof.pts = 0; }
            }
            this.prof.Save();
            return;
        }
        if (this.moves >= GmGame.N() * GmGame.N()) {
            this.winner = 3;
            this.prof.Save();
            return;
        }
        if (c == 1) {
            this.aiTurn = true;
            this.aiThinkAt = now + 350 + this.rng.Range(0, 450);
        } else {
            this.aiTurn = false;
        }
    }

    // ----- AI: line-pattern scoring ---------------------------------------

    // Scores placing color c at (x,y): sums pattern values over 4 directions.
    int ScoreCell(int x, int y, int c) {
        int total = 0;
        for (int d = 0; d < 4; d = d + 1) {
            int dx = 1; int dy = 0;
            if (d == 1) { dx = 0; dy = 1; }
            if (d == 2) { dx = 1; dy = 1; }
            if (d == 3) { dx = 1; dy = -1; }
            int n = 1;
            int openA = 0; int openB = 0;
            int k = 1;
            while (this.At(x + dx * k, y + dy * k) == c) { n = n + 1; k = k + 1; }
            if (this.At(x + dx * k, y + dy * k) == 0) { openA = 1; }
            k = 1;
            while (this.At(x - dx * k, y - dy * k) == c) { n = n + 1; k = k + 1; }
            if (this.At(x - dx * k, y - dy * k) == 0) { openB = 1; }
            int open = openA + openB;
            int v = 0;
            if (n >= 5) { v = 1000000; }
            else if (n == 4) { if (open == 2) { v = 120000; } else if (open == 1) { v = 20000; } }
            else if (n == 3) { if (open == 2) { v = 12000; } else if (open == 1) { v = 900; } }
            else if (n == 2) { if (open == 2) { v = 650; } else if (open == 1) { v = 80; } }
            else { if (open == 2) { v = 40; } }
            total = total + v;
        }
        return total;
    }

    bool NearStone(int x, int y) {
        int dy = -2;
        while (dy <= 2) {
            int dx = -2;
            while (dx <= 2) {
                int v = this.At(x + dx, y + dy);
                if (v == 1 || v == 2) { return true; }
                dx = dx + 1;
            }
            dy = dy + 1;
        }
        return false;
    }

    void AiMove(int now) {
        int n = GmGame.N();
        if (this.moves == 0) { this.Place(n / 2, n / 2, 2, now); return; }
        // defense weight rises with difficulty; easy adds noise
        int defNum = 70;
        if (this.diff == 1) { defNum = 95; }
        if (this.diff == 2) { defNum = 105; }
        int bestV = -1;
        int bestX = -1;
        int bestY = -1;
        int y = 0;
        for (; y < n; y = y + 1) {
            for (int x = 0; x < n; x = x + 1) {
                if (this.At(x, y) == 0 && this.NearStone(x, y)) {
                    int atk = this.ScoreCell(x, y, 2);
                    int def = this.ScoreCell(x, y, 1);
                    int v = atk + def * defNum / 100;
                    if (this.diff == 0) { v = v + this.rng.Range(0, 2600); }
                    if (this.diff == 1) { v = v + this.rng.Range(0, 220); }
                    if (v > bestV) { bestV = v; bestX = x; bestY = y; }
                }
            }
        }
        if (bestX < 0) {
            // no neighborhood cell (shouldn't happen): first empty
            y = 0;
            while (y < n) {
                for (int x = 0; x < n; x = x + 1) {
                    if (this.At(x, y) == 0 && bestX < 0) { bestX = x; bestY = y; }
                }
                y = y + 1;
            }
        }
        // emotional beats: praise the player's threats we had to answer
        int pThreat = this.ScoreCell(bestX, bestY, 1);
        this.Place(bestX, bestY, 2, now);
        if (pThreat >= 12000) {
            this.AddPop(GmGame.BX() + bestX * GmGame.Cell(),
                GmGame.BY() + bestY * GmGame.Cell() - 30, "好棋，只能挡了", now, 255, 214, 150);
        }
    }

    // ----- input -----------------------------------------------------------

    // 对局内落子（竖屏底部按钮行在 GmPlayScene 处理：需要路由器）。
    void OnDownPlay(int cx, int cy, int now) {
        if (this.aiTurn || this.winner != 0) { return; }
        int gx = (cx - GmGame.BX() + GmGame.Cell() / 2) / GmGame.Cell();
        int gy = (cy - GmGame.BY() + GmGame.Cell() / 2) / GmGame.Cell();
        if (gx < 0 || gy < 0 || gx >= GmGame.N() || gy >= GmGame.N()) { return; }
        if (this.At(gx, gy) != 0) { return; }
        this.Place(gx, gy, 1, now);
    }

    void Tick(int now) {
        if (this.aiTurn && now >= this.aiThinkAt) {
            this.AiMove(now);
            this.demoAt = now + 420;
        }
        if (this.demo && !this.aiTurn && now >= this.demoAt) {
            this.DemoMove(now);
        }
    }

    // demo: play black with the same evaluator so screenshots show a real game
    void DemoMove(int now) {
        int n = GmGame.N();
        if (this.moves == 0) { this.Place(n / 2, n / 2 - 1, 1, now); return; }
        int bestV = -1; int bestX = -1; int bestY = -1;
        for (int y = 0; y < n; y = y + 1) {
            for (int x = 0; x < n; x = x + 1) {
                if (this.At(x, y) == 0 && this.NearStone(x, y)) {
                    int v = this.ScoreCell(x, y, 1) + this.ScoreCell(x, y, 2) * 90 / 100
                        + this.rng.Range(0, 500);
                    if (v > bestV) { bestV = v; bestX = x; bestY = y; }
                }
            }
        }
        if (bestX >= 0) { this.Place(bestX, bestY, 1, now); }
    }

    // ----- rendering -------------------------------------------------------

    void DrawBoard(int now) {
        int n = GmGame.N();
        int c = GmGame.Cell();
        int x0 = GmGame.BX();
        int y0 = GmGame.BY();
        int span = (n - 1) * c;
        // 漆木桌 + 手绘棋盘面（先投影后落板，再描金边）
        if (this.boardArt != null) {
            CFx.ShadowRect(this.c, x0 - 38, y0 - 30, span + 76, span + 76, 18, 22, 0, 0, 0, 130);
            CDraw.BlitImage(this.c, this.boardArt, x0 - 38, y0 - 38, span + 76, span + 76);
            CDraw.FillRect(this.c, x0 - 38, y0 - 38, span + 76, span + 76,
                CDraw.Argb(18, 255, 226, 170));
            CFx.Ring(this.c, x0 - 38, y0 - 38, span + 76, span + 76, 12, 1, 40, 20, 8, 150);
        } else {
            CDraw.RoundRectFill(this.c, x0 - 44, y0 - 44, span + 88, span + 88, 14, 60, 38, 20, 255);
            if (this.boardPath != null) {
                CDraw.BlitImage(this.c, this.boardPath, x0 - 38, y0 - 38, span + 76, span + 76);
                CDraw.FillRect(this.c, x0 - 38, y0 - 38, span + 76, span + 76,
                    CDraw.Argb(18, 255, 220, 160));
            } else {
                CDraw.RoundRectFill(this.c, x0 - 38, y0 - 38, span + 76, span + 76, 10, 214, 168, 106, 255);
            }
        }
        // grid
        int grid = CDraw.Argb(235, 74, 48, 22);
        for (int i = 0; i < n; i = i + 1) {
            CDraw.FillRect(this.c, x0, y0 + i * c - 1, span, 2, grid);
            CDraw.FillRect(this.c, x0 + i * c - 1, y0, 2, span, grid);
        }
        // star points
        int[] st = new int[3];
        st[0] = 3; st[1] = 7; st[2] = 11;
        for (int a = 0; a < 3; a = a + 1) {
            for (int b = 0; b < 3; b = b + 1) {
                CDraw.FillCircle(this.c, x0 + st[a] * c, y0 + st[b] * c, 4, 74, 48, 22, 235);
            }
        }
        // stones
        for (int y = 0; y < n; y = y + 1) {
            for (int x = 0; x < n; x = x + 1) {
                int v = this.At(x, y);
                if (v != 0) {
                    int sx = x0 + x * c;
                    int sy = y0 + y * c;
                    int rad = c * 18 / 52;
                    bool isLast = x == this.lastX && y == this.lastY;
                    if (isLast) {
                        int age = now - this.placedAt;
                        int grow = rad * 2 / 9;
                        if (age < 220 && age >= 0) { rad = rad - grow + age * grow / 220; }
                        CDraw.FillCircle(this.c, sx, sy, rad + 9, 255, 200, 110, 60);
                        CDraw.FillCircle(this.c, sx, sy, rad + 4, 255, 214, 130, 70);
                    }
                    CDraw.FillCircle(this.c, sx + 2, sy + 3, rad, 30, 18, 8, 90);
                    string stone = this.blackPath2;
                    if (v == 2) { stone = this.whitePath2; }
                    if (stone == null) { stone = this.blackPath; }
                    if (v == 2 && this.whitePath2 == null) { stone = this.whitePath; }
                    if (stone != null) {
                        CDraw.BlitImage(this.c, stone, sx - rad, sy - rad, rad * 2, rad * 2);
                    } else if (v == 1) {
                        CDraw.FillCircle(this.c, sx, sy, rad, 34, 36, 44, 255);
                        CDraw.FillCircle(this.c, sx - 5, sy - 6, rad / 3, 130, 140, 160, 200);
                    } else {
                        CDraw.FillCircle(this.c, sx, sy, rad, 236, 232, 222, 255);
                        CDraw.FillCircle(this.c, sx - 5, sy - 6, rad / 3, 255, 255, 255, 230);
                        CDraw.FillCircle(this.c, sx + 4, sy + 6, rad / 2, 205, 198, 185, 90);
                    }
                    if (isLast) {
                        CDraw.FillCircle(this.c, sx, sy, 5, 255, 90, 90, 230);
                    }
                }
            }
        }
        // winning line glow
        if (this.winner == 1 || this.winner == 2) {
            int ax = x0 + this.winX0 * c; int ay = y0 + this.winY0 * c;
            int bx = x0 + this.winX1 * c; int by = y0 + this.winY1 * c;
            int steps = 24;
            for (int s = 0; s <= steps; s = s + 1) {
                int px = ax + (bx - ax) * s / steps;
                int py = ay + (by - ay) * s / steps;
                CDraw.FillCircle(this.c, px, py, 6, 255, 214, 90, 180);
            }
        }
        // hover ghost stone
        if (this.winner == 0 && !this.aiTurn) {
            int gx = (this.mouseX - x0 + c / 2) / c;
            int gy = (this.mouseY - y0 + c / 2) / c;
            if (gx >= 0 && gy >= 0 && gx < n && gy < n && this.At(gx, gy) == 0) {
                CDraw.FillCircle(this.c, x0 + gx * c, y0 + gy * c, c * 18 / 52, 34, 36, 44, 90);
            }
        }
    }

    void DrawSide(int now) {
        if (GmGame.Portrait()) { this.DrawTopBar(now); return; }
        int px = 750;
        CFx.Card(this.c, px, 66, 460, 588, 16, 40, 28, 16, 30, 20, 12, 226, 186, 128, 90, 1, 0);
        CFx.Rule(this.c, px + 230, 148, 180, 226, 186, 128, 130);
        CText.Draw(this.c, "五子棋", px + 32, 96, 5, 240, 220, 190, 255);
        string dn = "初学";
        if (this.diff == 1) { dn = "棋士"; }
        if (this.diff == 2) { dn = "棋圣"; }
        CText.Draw(this.c, "对手 · " + dn, px + 32, 170, 2, 255, 214, 150, 255);
        string turn = "轮到你落子";
        int tr = 140; int tg = 220; int tb = 170;
        if (this.aiTurn) { turn = "对手思考中…"; tr = 255; tg = 214; tb = 150; }
        CText.Draw(this.c, turn, px + 32, 214, 3, tr, tg, tb, 255);
        CText.Draw(this.c, "段位 " + this.prof.Title() + " · " + this.prof.pts + " 分", px + 32, 286, 2, 235, 225, 205, 255);
        CText.Draw(this.c, "胜 " + this.prof.wins + " · 负 " + this.prof.losses, px + 32, 326, 2, 200, 190, 170, 255);
        CText.Draw(this.c, "连胜 " + this.prof.streak + " · 最佳 " + this.prof.bestStreak, px + 32, 366, 2, 200, 190, 170, 255);
        CText.Draw(this.c, "第 " + (this.moves + 1) + " 手", px + 32, 406, 2, 200, 190, 170, 255);
        CText.Draw(this.c, "Esc 菜单", px + 32, 610, 2, 160, 150, 135, 255);
    }

    // 竖屏对局 HUD：顶部对手条 + 回合徽标，底部 菜单/重玩 按钮行。
    void DrawTopBar(int now) {
        int vw = GmGame.VW();
        CFx.Card(this.c, 16, 24, vw - 32, 112, 16, 40, 28, 16, 30, 20, 12, 226, 186, 128, 90, 1, 0);
        CText.Draw(this.c, "对手 · " + this.DiffName(), 40, 44, 3, 240, 220, 190, 255);
        CText.Draw(this.c, "段位 " + this.prof.Title() + " · " + this.prof.pts + " 分", 40, 92, 2, 200, 190, 170, 255);
        string turn = "轮到你落子";
        int tr = 140; int tg = 220; int tb = 170;
        if (this.aiTurn) { turn = "对手思考中…"; tr = 255; tg = 214; tb = 150; }
        CFx.Pill(this.c, vw - 300, 48, 268, 64, 0, 26, 16, 10, 16, 9, 5, 226, 186, 128, 70);
        CText.DrawCentered(this.c, turn, vw - 166, 66, 3, tr, tg, tb, 255);
        CText.Draw(this.c, "第 " + (this.moves + 1) + " 手 · 胜 " + this.prof.wins
            + " 负 " + this.prof.losses, 40, 200, 2, 200, 190, 170, 255);
        int by = GmGame.VH() - 110;
        int bw = 200;
        CKitUi.Button(this.c, this.mouseX, this.mouseY, vw / 2 - bw - 12, by, bw, 64, "菜单", 3, 0);
        CKitUi.Button(this.c, this.mouseX, this.mouseY, vw / 2 + 12, by, bw, 64, "重玩", 3, 1);
    }

    string DiffName() {
        if (this.diff == 1) { return "棋士"; }
        if (this.diff == 2) { return "棋圣"; }
        return "初学";
    }

    void DrawFx(int now) {
        int i = 0;
        while (i < this.parts.Count) {
            GmParticle p = this.parts[i];
            int age = now - p.bornAt;
            if (age > 900) { this.parts.RemoveAt(i); continue; }
            int px = (p.x + p.vx * age / 4) / 256;
            int py = (p.y + p.vy * age / 4) / 256 + age * age / 26000;
            int alpha = 235 - age * 235 / 900;
            CDraw.FillCircle(this.c, px, py, 3, p.cr, p.cg, p.cb, alpha);
            i = i + 1;
        }
        i = 0;
        while (i < this.pops.Count) {
            GmPopup p = this.pops[i];
            int age = now - p.bornAt;
            if (age > 1400) { this.pops.RemoveAt(i); continue; }
            int alpha = 255 - age * 255 / 1400;
            CText.DrawCentered(this.c, p.text, p.x, p.y - age / 14, 2, p.cr, p.cg, p.cb, alpha);
            i = i + 1;
        }
        if (now - this.toastAt < 2200) {
            int age = now - this.toastAt;
            int alpha = 235;
            if (age > 1700) { alpha = 235 - (age - 1700) * 235 / 500; }
            CText.DrawCenteredShadow(this.c, this.toastText, GmGame.VW() / 2, GmGame.VH() / 2 - 120, 2, 255, 224, 150, alpha);
        }
    }

    void DrawAmbient() {
        // dim parlor artwork behind the table for atmosphere
        this.EnsureTex();
        int vw = GmGame.VW();
        int vh = GmGame.VH();
        if (this.playBg != null) {
            // 对局底：整幅 cover + 轻压暗，两处暖光晕提棋室氛围。
            GmGame.BlitCover(this.c, this.playBg, vw, vh);
            CDraw.FillRect(this.c, 0, 0, vw, vh, CDraw.Argb(150, 18, 10, 7));
            this.c.FillRadial(CDraw.MapX(vw / 3), CDraw.MapY(vh / 3), CDraw.MapW(430),
                              CDraw.Argb(255, 220, 150, 80), 16);
            this.c.FillRadial(CDraw.MapX(vw * 2 / 3), CDraw.MapY(vh * 4 / 5), CDraw.MapW(360),
                              CDraw.Argb(255, 220, 140, 70), 12);
        } else if (this.menuBg != null) {
            CKitUi.Backdrop(this.c, this.menuBg, vw, vh);
            CDraw.FillRect(this.c, 0, 0, vw, vh, CDraw.Argb(180, 24, 14, 8));
        }
        CFx.Vignette(this.c, vw, vh, 70);
    }

    void DrawPlay(int now) {
        CDraw.Clear(this.c, GmGame.VW(), GmGame.VH(), CDraw.Argb(255, 38, 26, 18));
        this.DrawAmbient();
        this.DrawBoard(now);
        this.DrawSide(now);
        this.DrawFx(now);
    }

    // 菜单画布层：美术背景 + 标题（难度按钮与战绩行走 GmMenuScene 的 HTML 层）。
    void DrawMenuArt() {
        this.EnsureTex();
        int vw = GmGame.VW();
        int vh = GmGame.VH();
        CDraw.Clear(this.c, vw, vh, CDraw.Argb(255, 30, 20, 14));
        if (this.menuBg2 != null) {
            GmGame.BlitCover(this.c, this.menuBg2, vw, vh);
            CDraw.FillRect(this.c, 0, 0, vw, vh, CDraw.Argb(110, 18, 10, 6));
        } else {
            CKitUi.Backdrop(this.c, this.menuBg, vw, vh);
            CDraw.FillRect(this.c, 0, 0, vw, vh, CDraw.Argb(120, 20, 12, 6));
        }
        CFx.Vignette(this.c, vw, vh, 90);
        if (this.titlePath != null) {
            CDraw.BlitImage(this.c, this.titlePath, vw / 2 - 300, 36, 600, 200);
        } else {
            CText.DrawCenteredShadow(this.c, "五子棋", vw / 2, 80, 9, 245, 232, 205, 255);
        }
    }
}

// 主菜单：画布层只画美术背景与标题（GmGame.DrawMenuArt），难度按钮与
// 战绩行走 HTML 层；每次进场由 GmPlayScene.OnEnter 开新局。
class GmMenuScene : HtmlScene {
    GmGame g;

    GmMenuScene(GmGame g) { this.g = g; }

    override string HtmlFile() { return "assets/scenes/menu.html"; }

    override void OnWire(HtmlHandlers handlers) {
        handlers.Add("easy", () => this.Pick(0));
        handlers.Add("normal", () => this.Pick(1));
        handlers.Add("hard", () => this.Pick(2));
    }

    void Pick(int d) {
        this.g.diff = d;
        this.router.Go("play");
    }

    override void OnEnter(Control root) {
        Element stats = GmMenuScene.AsElement(root, "stats");
        if (stats != null) {
            stats.SetText("段位 " + this.g.prof.Title() + " · " + this.g.prof.pts
                + " 分 · 胜 " + this.g.prof.wins + " 负 " + this.g.prof.losses
                + " · 最佳连胜 " + this.g.prof.bestStreak);
        }
    }

    static Element AsElement(Control root, string id) {
        Control c = root.Find(id);
        if (c != null && c is Element) { return (Element)c; }
        return null;
    }

    override void Event(int kind, int key) {
        if (kind == 4 && key == 27) { this.router.Exit(); }
    }

    override void Render(Canvas c, double alpha) {
        GuiHost host = this.router.Host();
        this.g.c = c;
        this.g.SyncStage(host);
        CDraw.Origin(0, host.ContentTop());
        this.g.DrawMenuArt();
    }
}

// 对局：纯 canvas 场景（HtmlFile 为空，无 HTML 层）。每次进场开新局
// （菜单选难度 / 结算再来一局都走这里），分出胜负后路由到结算场景。
class GmPlayScene : HtmlScene {
    GmGame g;

    GmPlayScene(GmGame g) { this.g = g; }

    override void OnEnter(Control root) {
        this.g.StartGame(Window.GetTickMs());
    }

    override void Event(int kind, int key) {
        GuiHost host = this.router.Host();
        // 指针坐标经 host.MouseX/Y 反变换回舞台逻辑坐标（桌面视口
        // letterbox / 手机驱动反变换都在宿主之下完成）。
        if (kind == 1) {
            this.g.mouseX = host.MouseX();
            this.g.mouseY = host.MouseY();
        } else if (kind == 2 && key == 0) {
            this.g.mouseX = host.MouseX();
            this.g.mouseY = host.MouseY();
            if (this.g.aiTurn || this.g.winner != 0) { return; }
            int cx = this.g.mouseX;
            int cy = this.g.mouseY;
            // 竖屏底部按钮行（与 DrawTopBar 同矩形）：菜单 / 重玩
            if (GmGame.Portrait()) {
                int vw = GmGame.VW();
                int by = GmGame.VH() - 110;
                if (CDraw.PointIn(cx, cy, vw / 2 - 212, by, 200, 64)) { this.router.Go("menu"); return; }
                if (CDraw.PointIn(cx, cy, vw / 2 + 12, by, 200, 64)) { this.g.StartGame(Window.GetTickMs()); return; }
            }
            this.g.OnDownPlay(cx, cy, Window.GetTickMs());
        } else if (kind == 4) {
            if (key == 27) { this.router.Go("menu"); }
        }
    }

    override void FixedStep(int dtMs) {
        this.g.Tick(Window.GetTickMs());
        // 分出胜负（含和棋）后切结算；切换在帧首应用，本场景随即使停。
        if (this.g.winner != 0) { this.router.Go("over"); }
    }

    override void Render(Canvas c, double alpha) {
        GuiHost host = this.router.Host();
        // Android 上表面晚于 Start 到达(转向/后台往返亦然),App 会整体
        // 换新画布对象(App.SwapCanvas);Start 时抓的引用画进已销毁的
        // 旧表面,永不 present。每帧对齐到宿主传入的当前画布。
        this.g.c = c;
        // 舞台 0 基绘制：原点落到标准标题栏之下，chrome 由宿主在
        // 内容之上叠画。帧首先把宿主延展后的舞台尺寸同步进 VW/VH，
        // 布局才能铺满整窗（宽窗多看宽度，不落 margin 空条）。
        this.g.SyncStage(host);
        CDraw.Origin(0, host.ContentTop());
        this.g.DrawPlay(Window.GetTickMs());
    }
}

// 结算：HTML 面板叠在定格的棋局上——Render 继续画对局画面（棋局已停，
// 画面定格），body 半透明压暗，按钮/文案由 HTML 层承担。
class GmOverScene : HtmlScene {
    GmGame g;
    Element headline;
    Element subEl;
    Element cheerEl;

    GmOverScene(GmGame g) { this.g = g; }

    override string HtmlFile() { return "assets/scenes/over.html"; }

    override void OnWire(HtmlHandlers handlers) {
        handlers.Add("again", () => this.router.Go("play"));
        handlers.Add("menu", () => this.router.Go("menu"));
    }

    override void OnEnter(Control root) {
        this.headline = GmOverScene.AsElement(root, "headline");
        this.subEl = GmOverScene.AsElement(root, "sub");
        this.cheerEl = GmOverScene.AsElement(root, "cheer");
        string head; string sub; string cheer;
        if (this.g.winner == 1) {
            head = "妙手连珠，胜！";
            sub = "+" + (10 + this.g.diff * 10) + " 段位分 · 现 " + this.g.prof.Title();
            cheer = "棋风正盛，再下一城！";
            if (this.g.prof.streak >= 3) { cheer = this.g.prof.streak + " 连胜！势不可挡"; }
        } else if (this.g.winner == 2) {
            head = "惜败半目间";
            sub = "第 " + this.g.moves + " 手告负";
            cheer = "复盘一手，下局翻盘！";
        } else {
            head = "满盘和棋";
            sub = "势均力敌，罕见的对局";
            cheer = "换个思路，再来一盘？";
        }
        if (this.headline != null) { this.headline.SetText(head); }
        if (this.subEl != null) { this.subEl.SetText(sub); }
        if (this.cheerEl != null) { this.cheerEl.SetText(cheer); }
    }

    static Element AsElement(Control root, string id) {
        Control c = root.Find(id);
        if (c != null && c is Element) { return (Element)c; }
        return null;
    }

    override void Event(int kind, int key) {
        if (kind != 4) { return; }
        if (key == 27) { this.router.Go("menu"); }
        if (key == 13 || key == 32) { this.router.Go("play"); }
    }

    override void Render(Canvas c, double alpha) {
        GuiHost host = this.router.Host();
        this.g.c = c;
        this.g.SyncStage(host);
        CDraw.Origin(0, host.ContentTop());
        this.g.DrawPlay(Window.GetTickMs());
    }
}

class GmApp {
    static void Main() {
        // 手机竖屏：GuiHost 逻辑宽高比定外壳方向（见 xiangqi 同注）。
        SceneRouter router = SceneRouter.CreateFixed("五子棋", 720, 1280, 16);
        GmGame g = GmGame.Create(router.Host());
        router.Register("menu", new GmMenuScene(g));
        router.Register("play", new GmPlayScene(g));
        router.Register("over", new GmOverScene(g));
        // demo 标记（gomoku_demo.txt）直接进对局自弈供截图/无头验证。
        router.Run(g.demo ? "play" : "menu");
    }
}
