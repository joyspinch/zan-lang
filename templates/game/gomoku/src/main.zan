using System;
using System.IO;
using Gui;
using Game.Kit;
using Game.Foundation.Gui;

public class GmApp {
    static void Main() {
        // 手机竖屏：GuiHost 逻辑宽高比定外壳方向（见 xiangqi 同注）。
        SceneRouter router = SceneRouter.CreateFixed("五子棋", 720, 1280, 16);
        GmGame g = GmGame.Create(router.Host());
        router.Register("menu", new GmMenuScene(g));
        router.Register("play", new GmPlayScene(g));
        router.Register("over", new GmOverScene(g));
        // demo 标记（gomoku_demo.txt）直接进对局自弈供截图/无头验证。
        router.Run(g.demo ? "play" : "menu");
    }
}
