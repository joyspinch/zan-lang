// 打砖块 -- a neon arcade brick-breaker. Mouse moves the glowing paddle; the
// ball smashes candy-glass bricks that spark and shatter. Chain combos raise a
// score multiplier, bricks drop powerups (multiball, wide paddle, slow-mo,
// score gems), and clearing a board advances to the next, faster level.
// Floating score popups, particle bursts, screen shake and encouraging toasts
// provide the juice; best score / highest level / max combo persist.
// Esc back/exit.
// SceneRouter 版：场景切换走 Game.Foundation.Gui.SceneRouter——主菜单/
// 结算整屏 HTML+CSS（assets/scenes/*.html + data-on-click），对局世界
// 在 BkPlayScene.Render 里走 Game.Kit.CanvasPrims 直绘。
using System;
using System.IO;
using Gui;
using Game.Kit;
using Game.Foundation.Gui;

namespace Breakout;

class Profile {
    int high;
    int bestLevel;
    int bestCombo;
    int games;

    static string Path() { return "breakout_save.txt"; }
    static int ParseInt(string s, int start) {
        int i = start; int v = 0; bool any = false;
        while (i < s.Length) { int c = s[i] & 255; if (c >= 48 && c <= 57) { v = v * 10 + (c - 48); any = true; i = i + 1; } else { i = s.Length; } }
        if (!any) { return 0; }
        return v;
    }
    static int ReadKey(List<string> lines, string key, int fb) {
        for (int i = 0; i < lines.Count; i = i + 1) {
            string ln = lines[i]; int eq = -1;
            for (int j = 0; j < ln.Length; j = j + 1) { if (ln[j] == 61) { eq = j; j = ln.Length; } }
            if (eq > 0) { if (ln.Substring(0, eq) == key) { return Profile.ParseInt(ln, eq + 1); } }
        }
        return fb;
    }
    static Profile Load() {
        Profile p = new Profile();
        p.high = 0; p.bestLevel = 1; p.bestCombo = 0; p.games = 0;
        if (File.Exists(Profile.Path())) {
            List<string> lines = File.ReadAllLines(Profile.Path());
            p.high = Profile.ReadKey(lines, "high", 0);
            p.bestLevel = Profile.ReadKey(lines, "bestLevel", 1);
            p.bestCombo = Profile.ReadKey(lines, "bestCombo", 0);
            p.games = Profile.ReadKey(lines, "games", 0);
        }
        return p;
    }
    void Save() {
        string s = "high=" + this.high + "\nbestLevel=" + this.bestLevel
            + "\nbestCombo=" + this.bestCombo + "\ngames=" + this.games + "\n";
        File.WriteAllText(Profile.Path(), s);
    }
}

class Brick {
    int x;      // px (fixed point 1/256 when moving; stored *256)
    int y;
    int w;
    int h;
    int hp;     // 1..3, 0 = gone
    int hue;    // palette index
    bool gem;   // drops a bonus when broken
    bool steel; // indestructible obstacle: ball bounces off, no score
    int mvx;    // horizontal drift px/s (moving rows), bounces at the rails
}

class Ball {
    bool alive;
    int x;      // fp 1/256 px
    int y;
    int vx;     // fp px/s
    int vy;
}

class Drop {
    bool alive;
    int x;      // px
    int y;      // fp 1/256 px (falls)
    int kind;   // 0 multiball, 1 wide, 2 slow, 3 gem score
}

class Particle {
    int x;      // fp
    int y;
    int vx;
    int vy;
    int bornAt;
    int cr;
    int cg;
    int cb;
}

class Popup {
    int x;
    int y;
    string text;
    int bornAt;
    int cr;
    int cg;
    int cb;
}

// 对局世界引擎：只负责"打砖块本身"（模拟 + 直绘）。菜单/结算屏在
// HTML 场景里，本类不再持有 scene 整数——失守置 over，清屏的过场
// 闪光（clearing）是对局内部状态，不出场景。
class BkGame {
    GuiHost host;
    Canvas c;
    Profile prof;
    Rng rng;

    List<Brick> bricks;
    List<Ball> balls;
    List<Drop> drops;
    List<Particle> parts;
    List<Popup> pops;

    bool over;        // 三条命耗尽，BkPlayScene 据此路由到结算场景
    bool clearing;    // 清屏过场闪光（进下一关前停 1.4s）
    int clearAt;
    int score;
    int level;
    int lives;
    int combo;        // hits since last paddle touch / miss
    int bestCombo;
    int mult;         // score multiplier from combo
    int padX;         // center px
    int padW;
    int slowUntil;
    int lastTick;
    int mouseX;
    int mouseY;
    bool stuck;       // ball waiting on the paddle
    int toastAt;
    string toastText;
    int shakeUntil;
    bool wasRecord;
    string menuBg;    // 对局背景资产（null = 画布回退画法）
    bool texTried;
    bool demo;
    int demoJitter;

    // 视口按宿主舞台每帧延展（宽窗多看宽度）：W/H 是当前帧的舞台逻辑
    // 尺寸，帧首在 SyncStage 更新——布局锚定它即可满铺任意窗口，否则
    // 长轴超出的部分就是宿主 margin 底色的空条。
    static int W() { return bw > 0 ? bw : 1280; }
    static int H() { return bh > 0 ? bh : 720; }
    static int PadY() { return 660; }

    // 帧首对齐宿主延展舞台（渲染回调开头调用）。
    void SyncStage(GuiHost host) {
        BkGame.bw = host.StageWidth();
        BkGame.bh = host.StageHeight();
    }
    static int bw;
    static int bh;

    static int PalR(int i) { int m = i % 6; if (m == 0) { return 255; } if (m == 1) { return 255; } if (m == 2) { return 120; } if (m == 3) { return 90; } if (m == 4) { return 190; } return 255; }
    static int PalG(int i) { int m = i % 6; if (m == 0) { return 110; } if (m == 1) { return 205; } if (m == 2) { return 235; } if (m == 3) { return 160; } if (m == 4) { return 120; } return 235; }
    static int PalB(int i) { int m = i % 6; if (m == 0) { return 140; } if (m == 1) { return 90; } if (m == 2) { return 140; } if (m == 3) { return 255; } if (m == 4) { return 255; } return 120; }

    static BkGame Create(GuiHost h) {
        BkGame g = new BkGame();
        g.host = h;
        // 画布引用不在这里抓：宿主 App 在 Run 后才存在，且场景 Render
        // 每帧用宿主传入的当前画布对齐（App.SwapCanvas 契约）。
        g.prof = Profile.Load();
        g.rng = Rng.Seed((long)Window.GetTickMs() + 24681357);
        g.over = false;
        g.clearing = false;
        g.mouseX = 640;
        g.mouseY = 360;
        g.demo = File.Exists("breakout_demo.txt");
        if (g.demo) { g.StartGame(Window.GetTickMs()); }
        return g;
    }

    void EnsureTex() {
        if (this.texTried) { return; }
        this.texTried = true;
        this.menuBg = BkGame.FindAsset("assets/menu_bg.png");
    }
    static string FindAsset(string path) {
        string p = Assets.Find(path);
        if (!File.Exists(p)) { return null; }
        return p;
    }

    // ----- level layouts ---------------------------------------------------

    // Eight layouts cycle with rising difficulty: steel obstacle bricks that
    // only deflect the ball, shield rows guarding the stack, moving rows.
    void BuildLevel(int lv) {
        this.bricks = new List<Brick>();
        int pattern = (lv - 1) % 8;
        int cols = 12;
        int bw = 88;
        int bh = 34;
        int gap = 8;
        int x0 = (BkGame.W() - cols * (bw + gap) + gap) / 2;
        int rows = 6;
        for (int ri = 0; ri < rows; ri = ri + 1) {
            for (int ci = 0; ci < cols; ci = ci + 1) {
                bool put = true;
                bool steel = false;
                int mvx = 0;
                if (pattern == 1) { put = (ri + ci) % 2 == 0; }
                if (pattern == 2) { int mid = cols / 2; int d = ci - mid; if (d < 0) { d = -d; } put = d + 1 >= ri && d - 1 <= ri + 1; }
                if (pattern == 3) { put = ri % 2 == 0 || ci % 3 != 1; }
                if (pattern == 4) {
                    // steel pillars every 4th column shield the stack
                    if (ri >= 2 && ci % 4 == 1) { steel = true; }
                }
                if (pattern == 5) {
                    // full steel shield row with two gaps under the stack
                    if (ri == 4) { steel = ci != 2 && ci != 9; }
                    if (ri == 5) { put = false; }
                }
                if (pattern == 6) {
                    // two moving rows sweep left/right
                    if (ri == 2) { mvx = 90; }
                    if (ri == 4) { mvx = -90; }
                    put = ri != 5 || ci % 2 == 0;
                }
                if (pattern == 7) {
                    // fortress: steel frame with a soft core, moving floor
                    if (ri == 1 && ci >= 2 && ci <= 9 && ci != 5 && ci != 6) { steel = true; }
                    if (ri >= 2 && ri <= 3 && (ci == 2 || ci == 9)) { steel = true; }
                    if (ri == 5) { mvx = 110; }
                }
                if (put) {
                    Brick b = new Brick();
                    b.x = (x0 + ci * (bw + gap)) * 256;
                    b.y = 90 + ri * (bh + gap);
                    b.w = bw;
                    b.h = bh;
                    b.steel = steel;
                    b.mvx = mvx;
                    if (lv > 8) { if (mvx > 0) { b.mvx = mvx + 40; } if (mvx < 0) { b.mvx = mvx - 40; } }
                    b.hp = 1 + (rows - 1 - ri) / 2;
                    if (b.hp > 3) { b.hp = 3; }
                    if (lv >= 3) { b.hp = b.hp + ri % 2; if (b.hp > 3) { b.hp = 3; } }
                    if (steel) { b.hp = 1; b.gem = false; }
                    else { b.gem = this.rng.Range(0, 100) < 16; }
                    b.hue = (ri + lv) % 6;
                    this.bricks.Add(b);
                }
            }
        }
    }

    int BallSpeed() {
        int s = 540 + (this.level - 1) * 45;
        if (s > 820) { s = 820; }
        return s;
    }

    void ResetBall() {
        this.balls = new List<Ball>();
        Ball b = new Ball();
        b.alive = true;
        this.balls.Add(b);
        this.stuck = true;
        this.combo = 0;
        this.mult = 1;
    }

    void LaunchBall(int now) {
        if (!this.stuck) { return; }
        this.stuck = false;
        Ball b = this.balls[0];
        int side = 1;
        if (this.rng.Range(0, 2) == 1) { side = -1; }
        int spd = this.BallSpeed();
        // velocities are fixed-point px/s (1/256): vx ~= 0.4*spd, vy ~= 0.9*spd
        b.vx = side * spd * 100;
        b.vy = -spd * 235;
    }

    void StartGame(int now) {
        this.score = 0;
        this.level = 1;
        this.lives = 3;
        this.bestCombo = 0;
        this.padW = 150;
        this.padX = 640;
        this.slowUntil = 0;
        if (this.demo) { this.level = 5; }
        this.BuildLevel(this.level);
        this.ResetBall();
        this.drops = new List<Drop>();
        this.parts = new List<Particle>();
        this.pops = new List<Popup>();
        this.toastAt = -9999;
        this.wasRecord = false;
        this.over = false;
        this.clearing = false;
        this.lastTick = now;
    }

    // ----- feedback --------------------------------------------------------

    void Toast(string t, int now) { this.toastText = t; this.toastAt = now; }
    void AddPop(int px, int py, string t, int now, int cr, int cg, int cb) {
        if (this.pops.Count > 22) { this.pops.RemoveAt(0); }
        Popup p = new Popup();
        p.x = px; p.y = py; p.text = t; p.bornAt = now;
        p.cr = cr; p.cg = cg; p.cb = cb;
        this.pops.Add(p);
    }
    void Burst(int px, int py, int n, int now, int cr, int cg, int cb) {
        if (this.parts.Count > 200) { return; }
        for (int i = 0; i < n; i = i + 1) {
            Particle p = new Particle();
            p.x = px * 256; p.y = py * 256;
            int a = this.rng.Range(0, 16);
            int spd = 70 + this.rng.Range(0, 170);
            int ux = 0; int uy = 0;
            int q = a % 4;
            if (q == 0) { ux = 256; uy = (a / 4 - 2) * 128; }
            if (q == 1) { ux = -256; uy = (a / 4 - 2) * 128; }
            if (q == 2) { uy = 256; ux = (a / 4 - 2) * 128; }
            if (q == 3) { uy = -256; ux = (a / 4 - 2) * 128; }
            p.vx = ux * spd / 256;
            p.vy = uy * spd / 256;
            p.bornAt = now;
            p.cr = cr; p.cg = cg; p.cb = cb;
            this.parts.Add(p);
        }
    }

    // ----- simulation ------------------------------------------------------

    void HitBrick(int bi, Ball ball, int now) {
        Brick b = this.bricks[bi];
        b.hp = b.hp - 1;
        this.combo = this.combo + 1;
        if (this.combo > this.bestCombo) { this.bestCombo = this.combo; }
        this.mult = 1 + this.combo / 4;
        if (this.mult > 5) { this.mult = 5; }
        int cx = b.x / 256 + b.w / 2;
        int cy = b.y + b.h / 2;
        if (b.hp <= 0) {
            int gain = 10 * this.mult;
            this.score = this.score + gain;
            this.Burst(cx, cy, 10, now, BkGame.PalR(b.hue), BkGame.PalG(b.hue), BkGame.PalB(b.hue));
            this.AddPop(cx, cy, "+" + gain, now, BkGame.PalR(b.hue), BkGame.PalG(b.hue), BkGame.PalB(b.hue));
            if (b.gem) {
                Drop d = new Drop();
                d.alive = true;
                d.x = cx;
                d.y = cy * 256;
                int roll = this.rng.Range(0, 100);
                if (roll < 30) { d.kind = 0; }
                else if (roll < 55) { d.kind = 1; }
                else if (roll < 75) { d.kind = 2; }
                else { d.kind = 3; }
                this.drops.Add(d);
            }
            this.bricks.RemoveAt(bi);
            if (this.combo == 8) { this.Toast("连击 x" + this.mult + "！火力全开", now); }
        } else {
            this.score = this.score + 2 * this.mult;
            this.Burst(cx, cy, 4, now, 255, 255, 255);
        }
        if (!this.wasRecord && this.prof.high > 0 && this.score > this.prof.high) {
            this.wasRecord = true;
            this.Toast("新纪录诞生！", now);
        }
    }

    void ApplyDrop(Drop d, int now) {
        if (d.kind == 0) {
            // multiball: split every live ball into two
            int n = this.balls.Count;
            for (int i = 0; i < n && this.balls.Count < 6; i = i + 1) {
                Ball src = this.balls[i];
                if (src.alive) {
                    Ball nb = new Ball();
                    nb.alive = true;
                    nb.x = src.x; nb.y = src.y;
                    nb.vx = -src.vx;
                    nb.vy = src.vy;
                    if (nb.vy > 0) { nb.vy = -nb.vy; }
                    this.balls.Add(nb);
                }
            }
            this.Toast("分裂球！", now);
        } else if (d.kind == 1) {
            // permanent widen (stacks to a cap; resets when a life is lost)
            this.padW = this.padW + 30;
            if (this.padW > 260) {
                this.padW = 260;
                this.AddPop(d.x, d.y / 256, "已达最长", now, 255, 205, 90);
            } else {
                this.Toast("挡板加长 " + this.padW + "/260", now);
            }
        } else if (d.kind == 2) {
            this.slowUntil = now + 6000;
            this.Toast("子弹时间！", now);
        } else {
            // gem burst: three extra balls erupt from the paddle
            int spd = this.BallSpeed();
            for (int k = 0; k < 3 && this.balls.Count < 8; k = k + 1) {
                Ball nb = new Ball();
                nb.alive = true;
                nb.x = this.padX * 256;
                nb.y = (BkGame.PadY() - 20) * 256;
                nb.vx = (k - 1) * spd * 130;
                nb.vy = -spd * 220;
                this.balls.Add(nb);
            }
            this.Toast("宝石爆裂！三球齐发", now);
        }
        this.Burst(d.x, d.y / 256, 8, now, 255, 235, 140);
    }

    void LoseBall(int now) {
        // called when the last ball fell
        this.lives = this.lives - 1;
        this.combo = 0;
        this.mult = 1;
        this.padW = 150;
        this.shakeUntil = now + 350;
        if (this.lives <= 0) {
            this.over = true;
            this.prof.games = this.prof.games + 1;
            if (this.score > this.prof.high) { this.prof.high = this.score; }
            if (this.level > this.prof.bestLevel) { this.prof.bestLevel = this.level; }
            if (this.bestCombo > this.prof.bestCombo) { this.prof.bestCombo = this.bestCombo; }
            this.prof.Save();
        } else {
            this.Toast("还有 " + this.lives + " 次机会，稳住！", now);
            this.ResetBall();
        }
    }

    void StepBall(Ball b, int dt, int now) {
        if (!b.alive) { return; }
        if (this.stuck) {
            b.x = this.padX * 256;
            b.y = (BkGame.PadY() - 16) * 256;
            return;
        }
        int sdt = dt;
        if (now < this.slowUntil) { sdt = dt * 60 / 100; }
        b.x = b.x + b.vx * sdt / 1000;
        b.y = b.y + b.vy * sdt / 1000;
        int px = b.x / 256;
        int py = b.y / 256;
        int rad = 9;
        // walls
        if (px < rad + 8) { b.x = (rad + 8) * 256; if (b.vx < 0) { b.vx = -b.vx; } }
        if (px > BkGame.W() - rad - 8) { b.x = (BkGame.W() - rad - 8) * 256; if (b.vx > 0) { b.vx = -b.vx; } }
        if (py < rad + 8) { b.y = (rad + 8) * 256; if (b.vy < 0) { b.vy = -b.vy; } }
        // paddle
        int pw = this.padW;
        if (b.vy > 0 && py > BkGame.PadY() - rad && py < BkGame.PadY() + 22) {
            if (px > this.padX - pw / 2 - rad && px < this.padX + pw / 2 + rad) {
                b.vy = -b.vy;
                b.y = (BkGame.PadY() - rad) * 256;
                // deflect by where the ball hit the paddle
                int off = (px - this.padX) * 256 / (pw / 2 + rad);
                int spd = this.BallSpeed();
                b.vx = off * spd * 200 / 256 + b.vx / 3;
                if (this.combo >= 6) { this.Toast("连击被接住，继续冲！", now); }
                this.combo = 0;
                this.mult = 1;
            }
        }
        // fell below
        if (py > BkGame.H() + 30) {
            b.alive = false;
            return;
        }
        // bricks (AABB vs circle, resolve by shallowest axis)
        int bi = this.bricks.Count - 1;
        while (bi >= 0) {
            Brick k = this.bricks[bi];
            int kx = k.x / 256;
            int nx = px;
            if (nx < kx) { nx = kx; }
            if (nx > kx + k.w) { nx = kx + k.w; }
            int ny = py;
            if (ny < k.y) { ny = k.y; }
            if (ny > k.y + k.h) { ny = k.y + k.h; }
            int dx = px - nx;
            int dy = py - ny;
            if (dx * dx + dy * dy <= rad * rad) {
                if (dx == 0 && dy == 0) {
                    if (b.vy > 0) { b.vy = -b.vy; } else { b.vy = -b.vy; }
                } else {
                    int adx = dx; if (adx < 0) { adx = -adx; }
                    int ady = dy; if (ady < 0) { ady = -ady; }
                    if (adx > ady) {
                        if ((dx > 0 && b.vx < 0) || (dx < 0 && b.vx > 0)) { b.vx = -b.vx; }
                    } else {
                        if ((dy > 0 && b.vy < 0) || (dy < 0 && b.vy > 0)) { b.vy = -b.vy; }
                    }
                }
                if (k.steel) {
                    this.Burst(kx + k.w / 2, k.y + k.h / 2, 3, now, 200, 210, 230);
                } else {
                    this.HitBrick(bi, b, now);
                }
                bi = -1;
            } else {
                bi = bi - 1;
            }
        }
    }

    void Step(int now) {
        int dt = now - this.lastTick;
        this.lastTick = now;
        if (dt < 0) { dt = 0; }
        if (dt > 50) { dt = 50; }
        if (dt == 0) { return; }

        // paddle follows the mouse
        if (this.demo) {
            // track the lowest live ball
            int tx = 640;
            int by = -1;
            for (int bi = 0; bi < this.balls.Count; bi = bi + 1) {
                Ball b = this.balls[bi];
                if (b.alive && b.y > by) { by = b.y; tx = b.x / 256; }
            }
            this.demoJitter = (this.demoJitter + dt) % 2000;
            this.padX = this.padX + (tx - this.padX) * dt / 90;
            if (this.stuck && now % 1700 < 40) { this.LaunchBall(now); }
        } else {
            this.padX = this.mouseX;
        }
        int pw = this.padW;
        if (this.padX < pw / 2 + 10) { this.padX = pw / 2 + 10; }
        if (this.padX > BkGame.W() - pw / 2 - 10) { this.padX = BkGame.W() - pw / 2 - 10; }

        if (this.clearing) {
            if (now >= this.clearAt) {
                this.level = this.level + 1;
                this.BuildLevel(this.level);
                this.ResetBall();
                this.drops = new List<Drop>();
                this.clearing = false;
                this.Toast("第 " + this.level + " 关！球速提升", now);
            }
            return;
        }

        int i = 0;
        for (; i < this.balls.Count; i = i + 1) {
            this.StepBall(this.balls[i], dt, now);
        }
        // prune dead balls; if none left, lose a life
        i = this.balls.Count - 1;
        bool any = false;
        while (i >= 0) {
            if (this.balls[i].alive) { any = true; }
            else if (this.balls.Count > 1) { this.balls.RemoveAt(i); }
            i = i - 1;
        }
        if (!any) { this.LoseBall(now); return; }

        // drops fall
        i = this.drops.Count - 1;
        while (i >= 0) {
            Drop d = this.drops[i];
            d.y = d.y + 190 * dt * 256 / 1000;
            int dy = d.y / 256;
            int pw2 = this.padW;
            if (dy > BkGame.PadY() - 12 && dy < BkGame.PadY() + 26
                && d.x > this.padX - pw2 / 2 - 14 && d.x < this.padX + pw2 / 2 + 14) {
                this.ApplyDrop(d, now);
                this.drops.RemoveAt(i);
            } else if (dy > BkGame.H() + 20) {
                this.drops.RemoveAt(i);
            }
            i = i - 1;
        }

        // particles
        i = this.parts.Count - 1;
        while (i >= 0) {
            Particle p = this.parts[i];
            if (now - p.bornAt > 650) { this.parts.RemoveAt(i); }
            else {
                p.x = p.x + p.vx * dt / 4;
                p.y = p.y + p.vy * dt / 4;
            }
            i = i - 1;
        }

        // moving rows drift and bounce off the side rails
        i = 0;
        while (i < this.bricks.Count) {
            Brick k = this.bricks[i];
            if (k.mvx != 0) {
                k.x = k.x + k.mvx * dt * 256 / 1000;
                if (k.x < 10 * 256 && k.mvx < 0) { k.mvx = -k.mvx; }
                if (k.x > (BkGame.W() - 10 - k.w) * 256 && k.mvx > 0) { k.mvx = -k.mvx; }
            }
            i = i + 1;
        }

        // level cleared when no breakable bricks remain (steel stays)
        int breakable = 0;
        i = 0;
        while (i < this.bricks.Count) {
            if (!this.bricks[i].steel) { breakable = breakable + 1; }
            i = i + 1;
        }
        if (breakable == 0 && !this.clearing) {
            this.clearing = true;
            this.clearAt = now + 1400;
            this.Toast("清屏！漂亮！", now);
            this.Burst(640, 300, 30, now, 255, 230, 120);
        }
    }

    // ----- rendering -------------------------------------------------------

    // 固定步长推进（BkPlayScene.FixedStep 调用）；失守后停步，画面定格。
    void Tick(int now) {
        if (!this.over) { this.Step(now); }
    }

    void DrawScene(int now) {
        this.EnsureTex();
        int shX = 0; int shY = 0;
        if (now < this.shakeUntil) {
            int left = this.shakeUntil - now;
            int amp = left / 80 + 1;
            shX = (now * 7 % (amp * 2 + 1)) - amp;
            shY = (now * 13 % (amp * 2 + 1)) - amp;
        }
        CDraw.Clear(this.c, BkGame.W(), BkGame.H(), CDraw.Argb(255, 12, 10, 28));
        // dim nebula artwork + colored light pools for depth
        if (this.menuBg != null) {
            CKitUi.Backdrop(this.c, this.menuBg, BkGame.W(), BkGame.H());
            CDraw.FillRect(this.c, 0, 0, BkGame.W(), BkGame.H(), CDraw.Argb(216, 8, 7, 22));
        }
        CDraw.FillCircle(this.c, 240, 620, 300, 120, 60, 220, 14);
        CDraw.FillCircle(this.c, 1050, 160, 280, 60, 160, 255, 12);
        CDraw.FillCircle(this.c, 660, 420, 360, 255, 90, 180, 8);
        // side + top glow rails
        int rail = CDraw.Argb(60, 120, 80, 220);
        int railHi = CDraw.Argb(200, 190, 120, 255);
        CDraw.FillRect(this.c, 0 + shX, 0 + shY, 8, BkGame.H(), rail);
        CDraw.FillRect(this.c, BkGame.W() - 8 + shX, 0 + shY, 8, BkGame.H(), rail);
        CDraw.FillRect(this.c, 0 + shX, 0 + shY, BkGame.W(), 8, rail);
        CDraw.FillRect(this.c, 6 + shX, 0 + shY, 2, BkGame.H(), railHi);
        CDraw.FillRect(this.c, BkGame.W() - 8 + shX, 0 + shY, 2, BkGame.H(), railHi);
        CDraw.FillRect(this.c, 0 + shX, 6 + shY, BkGame.W(), 2, railHi);
        // dashed danger line along the open bottom edge
        int danger = CDraw.Argb(130, 255, 90, 110);
        int dxp = 14;
        while (dxp < BkGame.W() - 14) {
            CDraw.FillRect(this.c, dxp + shX, BkGame.H() - 6 + shY, 22, 3, danger);
            dxp = dxp + 44;
        }

        // bricks: candy glass with inner highlight; hp shows as brightness
        int i = 0;
        while (i < this.bricks.Count) {
            Brick b = this.bricks[i];
            int bx = b.x / 256;
            if (b.steel) {
                // riveted steel obstacle
                CDraw.RoundRectFill(this.c, bx + shX, b.y + shY, b.w, b.h, 7, 96, 104, 128, 245);
                CDraw.RoundRectFill(this.c, bx + 4 + shX, b.y + 4 + shY, b.w - 8, b.h / 2 - 4, 5, 255, 255, 255, 26);
                CDraw.RingRect(this.c, bx + shX, b.y + shY, b.w, b.h, 2, 170, 180, 205, 160);
                CDraw.FillCircle(this.c, bx + 10 + shX, b.y + b.h / 2 + shY, 3, 190, 200, 220, 220);
                CDraw.FillCircle(this.c, bx + b.w - 10 + shX, b.y + b.h / 2 + shY, 3, 190, 200, 220, 220);
                i = i + 1;
                continue;
            }
            int cr = BkGame.PalR(b.hue); int cg = BkGame.PalG(b.hue); int cb = BkGame.PalB(b.hue);
            int dim = (3 - b.hp) * 22;
            int br2 = cr - cr * dim / 100;
            int bg2 = cg - cg * dim / 100;
            int bb2 = cb - cb * dim / 100;
            CDraw.RoundRectFill(this.c, bx - 4 + shX, b.y - 4 + shY, b.w + 8, b.h + 8, 12, cr, cg, cb, 34);
            CDraw.RoundRectFill(this.c, bx + shX, b.y + shY, b.w, b.h, 9, br2, bg2, bb2, 235);
            CDraw.RoundRectFill(this.c, bx + 4 + shX, b.y + 4 + shY, b.w - 8, b.h / 2 - 4, 6, 255, 255, 255, 46);
            if (b.gem) {
                CDraw.FillCircle(this.c, bx + b.w / 2 + shX, b.y + b.h / 2 + shY, 5, 255, 255, 255, 200);
            }
            if (b.hp >= 3) {
                CDraw.RingRect(this.c, bx + shX, b.y + shY, b.w, b.h, 2, 255, 255, 255, 70);
            }
            i = i + 1;
        }

        // drops
        i = 0;
        while (i < this.drops.Count) {
            Drop d = this.drops[i];
            int dy = d.y / 256;
            int cr = 140; int cg = 255; int cb = 210;
            string mark = "分";
            if (d.kind == 1) { cr = 255; cg = 205; cb = 90; mark = "长"; }
            if (d.kind == 2) { cr = 120; cg = 200; cb = 255; mark = "慢"; }
            if (d.kind == 3) { cr = 255; cg = 220; cb = 110; mark = "宝"; }
            CDraw.FillCircle(this.c, d.x + shX, dy + shY, 18, cr, cg, cb, 50);
            CDraw.FillCircle(this.c, d.x + shX, dy + shY, 13, cr, cg, cb, 235);
            CText.DrawCentered(this.c, mark, d.x + shX, dy - 11 + shY, 2, 20, 24, 44, 255);
            i = i + 1;
        }

        // paddle: glowing capsule
        int pw = this.padW;
        int py = BkGame.PadY();
        CDraw.RoundRectFill(this.c, this.padX - pw / 2 - 4 + shX, py - 4 + shY, pw + 8, 26, 13, 140, 255, 210, 40);
        CDraw.RoundRectFill(this.c, this.padX - pw / 2 + shX, py + shY, pw, 18, 9, 90, 235, 190, 255);
        CDraw.RoundRectFill(this.c, this.padX - pw / 2 + 8 + shX, py + 3 + shY, pw - 16, 6, 3, 255, 255, 255, 90);

        // balls
        i = 0;
        while (i < this.balls.Count) {
            Ball b = this.balls[i];
            if (b.alive) {
                int bx = b.x / 256; int by = b.y / 256;
                // light trail behind the direction of travel
                int t = 1;
                while (t <= 3) {
                    int tx = bx - b.vx * t * 14 / 256000;
                    int ty = by - b.vy * t * 14 / 256000;
                    CDraw.FillCircle(this.c, tx + shX, ty + shY, 9 - t * 2, 255, 220, 120, 90 - t * 24);
                    t = t + 1;
                }
                CDraw.FillCircle(this.c, bx + shX, by + shY, 16, 255, 240, 160, 40);
                CDraw.FillCircle(this.c, bx + shX, by + shY, 14, 255, 240, 160, 46);
                CDraw.FillCircle(this.c, bx + shX, by + shY, 9, 255, 235, 130, 255);
                CDraw.FillCircle(this.c, bx - 3 + shX, by - 3 + shY, 3, 255, 255, 255, 220);
            }
            i = i + 1;
        }

        // particles
        i = 0;
        while (i < this.parts.Count) {
            Particle p = this.parts[i];
            int age = now - p.bornAt;
            int alpha = 255 - age * 255 / 650;
            CDraw.FillCircle(this.c, p.x / 256 + shX, p.y / 256 + shY, 3, p.cr, p.cg, p.cb, alpha);
            i = i + 1;
        }
        // popups
        i = this.pops.Count - 1;
        while (i >= 0) {
            Popup p = this.pops[i];
            int age = now - p.bornAt;
            if (age > 900) { this.pops.RemoveAt(i); }
            else {
                int alpha = 255 - age * 255 / 900;
                CText.DrawCentered(this.c, p.text, p.x, p.y - age / 9, 3, p.cr, p.cg, p.cb, alpha);
            }
            i = i - 1;
        }

        // HUD
        CText.DrawShadow(this.c, "" + this.score, 28, 18, 7, 255, 230, 120, 255);
        CText.DrawShadow(this.c, "第 " + this.level + " 关", 32, 84, 2, 170, 220, 255, 255);
        if (this.mult > 1) {
            CText.DrawShadow(this.c, "连击 x" + this.mult, 32, 114, 3, 255, 170, 210, 255);
        }
        // lives (hearts as glowing dots)
        i = 0;
        while (i < this.lives) {
            CDraw.FillCircle(this.c, 1230 - i * 34, 36, 12, 255, 110, 140, 235);
            CDraw.FillCircle(this.c, 1233 - i * 34, 32, 4, 255, 255, 255, 140);
            i = i + 1;
        }
        // toast
        if (now - this.toastAt < 1500) {
            int a = 255;
            int age = now - this.toastAt;
            if (age > 1100) { a = 255 - (age - 1100) * 255 / 400; }
            CText.DrawCentered(this.c, this.toastText, 640, 150, 4, 255, 235, 140, a);
        }
        if (this.stuck) {
            CText.DrawCentered(this.c, "点击发射", 640, 560, 3, 190, 200, 230, 200);
        }
    }

    void DrawPlay(int now) {
        this.DrawScene(now);
    }
}

// ----- HTML 场景层（SceneRouter）--------------------------------------------

// 主菜单：整屏 HTML+CSS，data-on-click="start" 直达处理器，
// 档案成绩在 OnEnter 里回填到 id="stats"。
class BkMenuScene : HtmlScene {
    BkGame g;
    Element stats;

    BkMenuScene(BkGame g) { this.g = g; }

    override string HtmlFile() { return "assets/scenes/menu.html"; }

    override void OnWire(HtmlHandlers handlers) {
        handlers.Add("start", () => this.router.Go("play"));
    }

    override void OnEnter(Control root) {
        this.stats = null;
        if (root != null) {
            Control el = root.Find("stats");
            if (el != null && el is Element) { this.stats = (Element)el; }
        }
        if (this.stats != null) {
            this.stats.SetText("最高分 " + this.g.prof.high + " · 最高 " + this.g.prof.bestLevel
                + " 关 · 最长连击 " + this.g.prof.bestCombo);
        }
    }

    override void Event(int kind, int key) {
        if (kind != 4) { return; }
        if (key == 27) { this.router.Exit(); }
        if (key == 13 || key == 32) { this.router.Go("play"); }
    }
}

// 对局：纯 canvas 场景（HtmlFile 为空，无 HTML 层）。每次进场开新局
// （菜单开始 / 结算再来一局都走这里），失守后路由到结算场景。
class BkPlayScene : HtmlScene {
    BkGame g;

    BkPlayScene(BkGame g) { this.g = g; }

    override void OnEnter(Control root) {
        this.g.StartGame(Window.GetTickMs());
    }

    override void Event(int kind, int key) {
        GuiHost host = this.router.Host();
        // 指针坐标经 host.MouseX/Y 反变换回舞台逻辑坐标（桌面视口
        // letterbox / 手机驱动反变换都在宿主之下完成）。
        if (kind == 1) {
            this.g.mouseX = host.MouseX();
            this.g.mouseY = host.MouseY();
        } else if (kind == 2 && key == 0) {
            this.g.mouseX = host.MouseX();
            this.g.mouseY = host.MouseY();
            this.g.LaunchBall(Window.GetTickMs());
        } else if (kind == 4) {
            if (key == 27) { this.router.Go("menu"); }
            if (key == 32) { this.g.LaunchBall(Window.GetTickMs()); }
        }
    }

    override void FixedStep(int dtMs) {
        this.g.Tick(Window.GetTickMs());
        if (this.g.over) { this.router.Go("over"); }
    }

    override void Render(Canvas c, double alpha) {
        GuiHost host = this.router.Host();
        // Android 上表面晚于 Start 到达(转向/后台往返亦然),App 会整体
        // 换新画布对象(App.SwapCanvas);Start 时抓的引用画进已销毁的
        // 旧表面,永不 present。每帧对齐到宿主传入的当前画布。
        this.g.c = c;
        // 舞台 0 基绘制：原点落到标准标题栏之下，chrome 由宿主在
        // 内容之上叠画。帧首先把宿主延展后的舞台尺寸同步进 W/H，
        // 布局才能铺满整窗（宽窗多看宽度，不落 margin 空条）。
        this.g.SyncStage(host);
        CDraw.Origin(0, host.ContentTop());
        this.g.DrawPlay(Window.GetTickMs());
    }
}

// 结算：HTML 面板叠在定格的对局画面上——Render 继续画最后一帧世界
// （对局已停步，画面定格），body 透明，只有中央面板不透明。
class BkOverScene : HtmlScene {
    BkGame g;
    Element headline;
    Element scoreEl;
    Element subEl;
    Element cheerEl;

    BkOverScene(BkGame g) { this.g = g; }

    override string HtmlFile() { return "assets/scenes/over.html"; }

    override void OnWire(HtmlHandlers handlers) {
        handlers.Add("retry", () => this.router.Go("play"));
        handlers.Add("menu", () => this.router.Go("menu"));
    }

    override void OnEnter(Control root) {
        this.headline = null;
        this.scoreEl = null;
        this.subEl = null;
        this.cheerEl = null;
        if (root != null) {
            this.headline = BkOverScene.AsElement(root, "headline");
            this.scoreEl = BkOverScene.AsElement(root, "score");
            this.subEl = BkOverScene.AsElement(root, "sub");
            this.cheerEl = BkOverScene.AsElement(root, "cheer");
        }
        // prof.high 已在 LoseBall 里更新，record 判定与旧版 DrawOver 同基准。
        bool record = this.g.score >= this.g.prof.high && this.g.score > 0;
        if (this.headline != null) {
            this.headline.SetText(record ? "新纪录！" : "挡板失守");
        }
        if (this.scoreEl != null) {
            this.scoreEl.SetText("得分 " + this.g.score);
        }
        if (this.subEl != null) {
            this.subEl.SetText("第 " + this.g.level + " 关 · 最长连击 " + this.g.bestCombo);
        }
        if (this.cheerEl != null) {
            this.cheerEl.SetText(record ? "砖块粉碎机就是你！" : "再来一局，打出更高连击！");
        }
    }

    static Element AsElement(Control root, string id) {
        Control c = root.Find(id);
        if (c != null && c is Element) { return (Element)c; }
        return null;
    }

    override void Event(int kind, int key) {
        if (kind != 4) { return; }
        if (key == 27) { this.router.Go("menu"); }
        if (key == 13 || key == 32) { this.router.Go("play"); }
    }

    override void Render(Canvas c, double alpha) {
        GuiHost host = this.router.Host();
        this.g.c = c;
        this.g.SyncStage(host);
        CDraw.Origin(0, host.ContentTop());
        this.g.DrawPlay(Window.GetTickMs());
    }
}

class BkApp {
    static void Main() {
        SceneRouter router = SceneRouter.CreateFixed("打砖块", 1280, 720, 16);
        BkGame g = BkGame.Create(router.Host());
        router.Register("menu", new BkMenuScene(g));
        router.Register("play", new BkPlayScene(g));
        router.Register("over", new BkOverScene(g));
        // demo 标记（breakout_demo.txt）直接进对局供截图/无头验证。
        router.Run(g.demo ? "play" : "menu");
    }
}
