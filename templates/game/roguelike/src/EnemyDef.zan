using System;
using System.Collections.Generic;

// 一种敌人：名字、外形（RogueArt 按 look 画）、档次、所属幕、生命与招式表。
//
// 出招方式：
//   0 依次循环（可读、可预判：骷髅兵"砍—举盾—砍"）
//   1 随机但不连出同一招（史莱姆、毒蛛这类"野兽"）
//   2 第一招固定（开场仪式/怒吼），之后循环其余招式（邪教徒、Boss）
public class EnemyDef {
    public string id;
    public string name;
    public string look;
    public string blurb;
    public int tier;
    public int act;
    public int hp;
    public int hpVar;
    public int mode;
    public List<EnemyMove> moves;

    public EnemyDef(string id, string name, string look, int tier, int act, int hp, int hpVar, int mode) {
        this.id = id;
        this.name = name;
        this.look = look;
        this.tier = tier;
        this.act = act;
        this.hp = hp;
        this.hpVar = hpVar;
        this.mode = mode;
        this.blurb = "";
        this.moves = new List<EnemyMove>();
    }

    public EnemyDef Move(EnemyMove m) { this.moves.Add(m); return this; }
    public EnemyDef About(string text) { this.blurb = text; return this; }

    // 档次：0 普通 · 1 精英 · 2 Boss
    public bool Elite() { return this.tier == 1; }
    public bool Boss() { return this.tier == 2; }
}
