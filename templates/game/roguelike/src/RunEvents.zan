using System;
using System.Collections.Generic;

// 奇遇：地图上"？"节点的八段小故事，每段两三个有得有失的选项。
//
// 一局里不重复（RunState.seenEvents），抽哪段、赌运气的结果都走本局随机源，
// 同种子同结果。加一段奇遇：Title/Text/选项文案各加一条，再在 Enabled/Apply
// 里写它的条件与结算。
public class RunEvents {
    public int Count() { return 8; }

    public string Title(int id) {
        if (id == 0) { return "古老祭坛"; }
        if (id == 1) { return "流浪铁匠"; }
        if (id == 2) { return "迷失的灵魂"; }
        if (id == 3) { return "宝藏洞穴"; }
        if (id == 4) { return "治愈之泉"; }
        if (id == 5) { return "骷髅赌徒"; }
        if (id == 6) { return "被遗忘的书库"; }
        return "骷髅商队";
    }

    public string Text(int id) {
        if (id == 0) { return "石台上刻满符文，血槽早已干涸。低语声说：它渴了。"; }
        if (id == 1) { return "铁砧还是热的。驼背的铁匠抬头看你：「只收一点炭钱。」"; }
        if (id == 2) { return "一个半透明的身影向你伸出手，像是想拿走什么，又像是想给你什么。"; }
        if (id == 3) { return "金光从碎石缝里透出来——也可能是陷阱的反光。"; }
        if (id == 4) { return "泉水泛着微光，掬一捧喝下，浑身都暖了起来。"; }
        if (id == 5) { return "骷髅赌徒摇着骨骰，咔啦咔啦：「押点什么？」"; }
        if (id == 6) { return "满墙的书页还在自己翻动，有几本似乎在等你。"; }
        return "一队骷髅扛着货箱路过，领头的那个愿意做笔交易。";
    }

    public int OptionCount(int id) {
        if (id == 3 || id == 4 || id == 6) { return 2; }
        return 3;
    }

    public string Option(int id, int i) {
        if (id == 0) {
            if (i == 0) { return "献血：失去 10 生命，获得一件遗物"; }
            if (i == 1) { return "祈祷：回复 12 生命"; }
        } else if (id == 1) {
            if (i == 0) { return "锻造：支付 35 金币，随机升级 2 张牌"; }
            if (i == 1) { return "淬火：失去 6 生命，随机升级 1 张牌"; }
        } else if (id == 2) {
            if (i == 0) { return "净化：从牌组移除一张打击或防御"; }
            if (i == 1) { return "交换：失去 5 生命上限，选一张罕见以上的牌"; }
        } else if (id == 3) {
            if (i == 0) { return "搜刮：获得 70 金币，但一半可能遭伏击失去 12 生命"; }
            if (i == 1) { return "小心取走：获得 25 金币"; }
        } else if (id == 4) {
            if (i == 0) { return "饮用：回复 30% 生命上限"; }
            if (i == 1) { return "洗礼：生命上限 +6"; }
        } else if (id == 5) {
            if (i == 0) { return "押 40 金币：一半机会赢回 100"; }
            if (i == 1) { return "押上鲜血：失去 8 生命，一半机会赢得一件遗物"; }
        } else if (id == 6) {
            if (i == 0) { return "研读：三张牌里选一张带走"; }
            if (i == 1) { return "撕书取火：随机升级 1 张牌"; }
        } else {
            if (i == 0) { return "雇佣护卫：支付 50 金币，生命上限 +8"; }
            if (i == 1) { return "抢劫：获得 60 金币，失去 15 生命"; }
        }
        return "离开";
    }

    public bool Enabled(RunFlow f, int id, int i) {
        RunState r = f.run;
        if (id == 0 && i == 0) { return r.hp > 10; }
        if (id == 1 && i == 0) { return r.gold >= 35 && r.Upgradable().Count > 0; }
        if (id == 1 && i == 1) { return r.hp > 6 && r.Upgradable().Count > 0; }
        if (id == 2 && i == 0) { return this.HasBasic(r); }
        if (id == 2 && i == 1) { return r.maxHp > 10; }
        if (id == 5 && i == 0) { return r.gold >= 40; }
        if (id == 5 && i == 1) { return r.hp > 8; }
        if (id == 6 && i == 1) { return r.Upgradable().Count > 0; }
        if (id == 7 && i == 0) { return r.gold >= 50; }
        if (id == 7 && i == 1) { return r.hp > 15; }
        return true;
    }

    bool HasBasic(RunState r) {
        for (int i = 0; i < r.deck.Count; i = i + 1) {
            string b = CardLibrary.BaseId(r.deck[i]);
            if (b == "strike" || b == "guard") { return true; }
        }
        return false;
    }

    // 结算一个选项，返回结果文案（可能把阶段切去选牌/战利品）。
    public string Apply(RunFlow f, int id, int i) {
        RunState r = f.run;
        if (i == this.OptionCount(id) - 1 && !(id == 3 || id == 4 || id == 6)) { return "你转身离开了。"; }
        if (id == 0) {
            if (i == 0) {
                r.SetHp(r.hp - 10);
                string relic = f.GrantRandomRelic();
                return relic == "" ? "祭坛吞下了血，吐出 50 枚金币。" : "祭坛吞下了血。你得到了「" + f.relicBook.Name(relic) + "」。";
            }
            r.Heal(12);
            return "一股暖流涌过全身，回复 12 生命。";
        }
        if (id == 1) {
            if (i == 0) {
                r.gold = r.gold - 35;
                return "火星四溅——" + r.UpgradeRandom(2, f.library, false) + " 张牌升级了。";
            }
            r.SetHp(r.hp - 6);
            return "你把手伸进炉火。" + r.UpgradeRandom(1, f.library, false) + " 张牌升级了。";
        }
        if (id == 2) {
            if (i == 0) {
                f.OpenPicker(3, RunFlow.Encounter(), 0);
                return "";
            }
            r.AddMaxHp(-5);
            f.OfferCards(60);
            return "";
        }
        if (id == 3) {
            int got = r.AddGold(i == 0 ? 70 : 25);
            if (i == 0 && r.Roll(2) == 0) {
                r.SetHp(r.hp - 12);
                return "你抓起 " + got + " 枚金币，碎石里却窜出一只伏兵！失去 12 生命。";
            }
            return "你带走了 " + got + " 枚金币。";
        }
        if (id == 4) {
            if (i == 0) {
                int heal = r.maxHp * 3 / 10;
                r.Heal(heal);
                return "回复 " + heal + " 生命。";
            }
            r.AddMaxHp(6);
            return "生命上限 +6。";
        }
        if (id == 5) {
            if (i == 0) {
                r.gold = r.gold - 40;
                if (r.Roll(2) == 0) { r.gold = r.gold + 100; return "骨骰停在了六点——你赢回 100 金币！"; }
                return "骨骰停在了一点。赌徒咔啦咔啦地笑了。";
            }
            r.SetHp(r.hp - 8);
            if (r.Roll(2) == 0) {
                string relic = f.GrantRandomRelic();
                return relic == "" ? "你赢了，但他只付得起 50 金币。" : "你赢了！赌徒丢给你「" + f.relicBook.Name(relic) + "」。";
            }
            return "你输了，伤口隐隐作痛。";
        }
        if (id == 6) {
            if (i == 0) { f.OfferCards(30); return ""; }
            return "书页燃起蓝火。" + r.UpgradeRandom(1, f.library, false) + " 张牌升级了。";
        }
        if (i == 0) {
            r.gold = r.gold - 50;
            r.AddMaxHp(8);
            return "护卫教了你几招：生命上限 +8。";
        }
        r.AddGold(60);
        r.SetHp(r.hp - 15);
        return "你抢到了金币，也挨了几下骨头棒子。";
    }
}
