using System;
using System.Collections.Generic;
using Gui;
using Gui.Backend;
using Gui.Widget;
using Game.Cards;

// 主菜单与结算页。
public partial class Program {

    // ---- 主菜单 ----------------------------------------------------------------

    // 左边标题图与题名，右边开局 / 战绩 / 指引三块石板。
    void BuildMenu() {
        Panel page = this.Row("rg-fill");
        page.Gap(24);

        Panel hero = this.Col("rg-mid rg-vcenter");
        hero.Gap(6);
        Image art = this.Art("assets/title.png", "肉鸽爬塔", "rg-hero-art");
        if (art != null) { hero.With(art); }
        hero.With(this.Txt("肉鸽爬塔", "rg-h1 rg-center"));
        hero.With(this.Txt("ROGUELIKE  ·  DECKBUILDER", "rg-sub rg-center"));
        page.With(hero);

        Panel side = this.Col("rg-fill");
        side.Gap(12);
        side.With(this.MenuStartPanel());
        side.With(this.MenuStatsPanel());
        side.With(this.MenuGuidePanel());
        page.With(side);
        root.With(page);
    }

    Panel MenuStartPanel() {
        Panel box = this.Col("rg-panel rg-panel-gold");
        box.Pad(18);
        box.Gap(10);
        box.With(this.Txt("开始攀登", "rg-h2"));
        box.With(this.Txt("三幕分岔地图：战斗、精英、商店、奇遇、篝火、宝箱，每幕尽头一个 Boss。", "rg-text"));
        box.With(this.Txt("同一颗种子必然给出同一张地图、同一批敌人、同一组奖励与货架。", "rg-dim"));
        Panel row = this.Row("rg-mid");
        row.Gap(10);
        InputNumber seedBox = new InputNumber(1, 999999999);
        seedBox.Hint("种子");
        seedBox.SetValue(this.DefaultSeed());
        seedBox.SwitchClass("rg-seed", true);
        seedBox.Prefer(220, 44);
        row.With(seedBox);
        Button start = new Button("用此种子开局");
        start.Class = "rg-cta rg-big-btn";
        start.OnClick(() => { this.StartRun(seedBox.Value.Get()); });
        row.With(start);
        Button random = new Button("随机种子");
        random.Class = "rg-btn";
        random.OnClick(() => { this.StartRun(this.RandomSeed()); });
        row.With(random);
        box.With(row);

        // 进阶：登顶一次解锁下一级，最多 5 级（敌人生命 +6%/级，起始生命 -3/级）。
        Panel asc = this.Row("rg-mid");
        asc.Gap(8);
        asc.With(this.Txt("进阶", "rg-text rg-ember"));
        int max = this.shell.MaxAscension();
        if (this.ascension > max) { this.ascension = max; }
        for (int i = 0; i <= 5; i = i + 1) {
            int level = i;
            Button b = new Button(i == 0 ? "标准" : Convert.ToString(i));
            b.Class = "rg-asc" + (i == this.ascension ? " rg-asc-on" : "");
            if (i > max) {
                b.Disabled = true;
                b.Tip = "登顶进阶 " + (i - 1) + " 后解锁";
            } else {
                b.Tip = i == 0 ? "标准难度" : "敌人生命 +" + (i * 6) + "%，起始生命 -" + (i * 3);
                b.OnClick(() => { this.ascension = level; this.shell.Play("click"); this.BuildUi(); });
            }
            asc.With(b);
        }
        asc.With(this.Txt(max == 0 ? "登顶一次解锁进阶 1" : "已解锁至进阶 " + max, "rg-dim"));
        box.With(asc);
        return box;
    }

    Panel MenuStatsPanel() {
        Panel box = this.Col("rg-panel");
        box.Pad(16);
        box.Gap(10);
        Panel head = this.Row("rg-mid");
        head.Gap(12);
        head.With(this.Txt("战绩", "rg-h2"));
        head.With(this.Spacer());
        head.With(this.Txt("图鉴 " + this.SeenCount() + "/" + this.flow.bestiary.Count() + " 种敌人", "rg-dim"));
        head.With(this.MuteButton());
        box.With(head);
        Panel tiles = this.Row("");
        tiles.Gap(10);
        tiles.With(this.Tile(Convert.ToString(this.shell.Runs()), "已开局", ""));
        tiles.With(this.Tile(Convert.ToString(this.shell.Wins()), "登顶次数", "rg-green"));
        tiles.With(this.Tile("第 " + this.shell.BestFloor() + " 层", "最高到达", "rg-ember"));
        string fastest = this.shell.HasFastest() ? this.shell.FastestTurns() + " 回合" : "—";
        tiles.With(this.Tile(fastest, "最快登顶", "rg-teal"));
        box.With(tiles);
        return box;
    }

    int SeenCount() {
        int n = 0;
        for (int i = 0; i < this.flow.bestiary.Count(); i = i + 1) {
            if (this.shell.Seen(this.flow.bestiary.At(i).id)) { n = n + 1; }
        }
        return n;
    }

    // 指引：第一次玩是新手指引，之后换成"攀登要诀"；底部三类卡牌图例。
    Panel MenuGuidePanel() {
        Panel box = this.Col("rg-panel rg-fill");
        box.Pad(16);
        box.Gap(6);
        if (this.shell.Runs() == 0) {
            box.With(this.Txt("新手指引", "rg-h2 rg-ember"));
            box.With(this.Txt("1. 地图自下而上走：点亮着的节点前进，连线决定之后能去哪。", "rg-text"));
            box.With(this.Txt("2. 战斗中点手牌出牌（或按 1–9），每回合 3 点能量；E 结束回合。", "rg-text"));
            box.With(this.Txt("3. 先看敌人意图：要攻击就叠格挡，要强化就抢攻。", "rg-text"));
            box.With(this.Txt("4. 篝火休息或升级牌，商店删掉弱牌；三幕 Boss 全倒即登顶。", "rg-text"));
        } else {
            box.With(this.Txt("攀登要诀", "rg-h2 rg-ember"));
            box.With(this.Txt("· 精英掉遗物，血量充足时值得一打；血少就绕去篝火。", "rg-text"));
            box.With(this.Txt("· 中毒与能力牌越早越值；虚弱让敌人伤害 -25%，易伤让你 +50%。", "rg-text"));
            box.With(this.Txt("· 牌组不是越大越好——删掉打击，好牌才抽得到。", "rg-text"));
        }
        box.With(this.Spacer());
        Panel legend = this.Row("rg-mid");
        legend.Gap(14);
        legend.With(this.LegendItem("assets/cards/attack.png", "攻击", "伤害 · 多段 · 施毒", "rg-type-attack"));
        legend.With(this.LegendItem("assets/cards/skill.png", "技能", "格挡 · 削弱 · 抽牌", "rg-type-skill"));
        legend.With(this.LegendItem("assets/cards/power.png", "能力", "整场持续的增益", "rg-type-power"));
        box.With(legend);
        box.With(this.Txt("快捷键：M 静音 · Esc 放弃本局（会先确认）· 战斗中 1–9 出牌、E 结束回合", "rg-dim"));
        return box;
    }

    Panel LegendItem(string art, string name, string desc, string typeCls) {
        Panel item = this.Row("rg-fill rg-mid");
        item.Gap(10);
        Image img = this.Art(art, name, "rg-legend-art");
        if (img != null) { item.With(img); }
        Panel words = this.Col("");
        words.Gap(2);
        words.With(this.Txt(name, "rg-h2 " + typeCls));
        words.With(this.Txt(desc, "rg-dim"));
        item.With(words);
        return item;
    }

    // ---- 结算 ------------------------------------------------------------------

    void BuildOver() {
        bool won = this.flow.runWon;
        RunState r = this.flow.run;
        this.BuildTopBar(won ? "登顶成功" : "攀登失败");
        Panel page = this.Col("rg-fill rg-center");
        Panel card = this.Col(won ? "rg-panel rg-panel-gold" : "rg-panel rg-panel-danger");
        card.Pad(24);
        card.Gap(12);
        card.Prefer(780, 0);
        Panel head = this.Row("rg-mid");
        head.Gap(22);
        Image art = this.Art("assets/title.png", "肉鸽爬塔", "rg-over-art");
        if (art != null) { head.With(art); }
        Panel words = this.Col("rg-fill");
        words.Gap(6);
        words.With(this.Txt(won ? "登顶成功" : "攀登失败", won ? "rg-h1" : "rg-h1 rg-red"));
        string killer = this.flow.battle != null && this.flow.battle.winner == 1 ? "，倒在了「" + this.flow.battle.def.name + "」面前" : "";
        words.With(this.Txt(won ? "深渊守卫倒下了，王冠归你。" : "止步第 " + r.act + " 幕第 " + r.floors + " 层" + killer + "。", "rg-text"));
        words.With(this.Txt("种子 " + r.Seed() + (r.Ascension() > 0 ? " · 进阶 " + r.Ascension() : " · 标准难度"), "rg-dim"));
        head.With(words);
        card.With(head);

        Panel tiles = this.Row("");
        tiles.Gap(10);
        tiles.With(this.Tile("第 " + r.act + " 幕", "到达", "rg-ember"));
        tiles.With(this.Tile(Convert.ToString(r.floors), "层数", ""));
        tiles.With(this.Tile(Convert.ToString(r.kills), "击杀", "rg-red"));
        tiles.With(this.Tile(r.deck.Count + " 张", "牌组", "rg-teal"));
        tiles.With(this.Tile(Convert.ToString(this.flow.turnsTaken), "回合", "rg-violet"));
        card.With(tiles);

        Panel relics = this.Row("rg-mid");
        relics.Gap(8);
        relics.With(this.Txt("遗物", "rg-text"));
        for (int i = 0; i < r.relics.Count; i = i + 1) { relics.With(this.RelicBadge(r.relics[i], "")); }
        card.With(relics);

        if (this.shell.NewFastest()) {
            card.With(this.Txt("NEW BEST · 最快登顶 " + this.flow.turnsTaken + " 回合！", "rg-newbest"));
        }
        if (this.shell.NewBestFloor()) {
            card.With(this.Txt("NEW BEST · 最高到达第 " + r.floors + " 层！", "rg-newbest"));
        }
        if (this.shell.UnlockedAscension()) {
            card.With(this.Txt("解锁 · 进阶 " + this.shell.MaxAscension() + "（菜单里选择）", "rg-newbest"));
        }
        string fastest = this.shell.HasFastest() ? this.shell.FastestTurns() + " 回合" : "—";
        card.With(this.Txt("纪录：最高第 " + this.shell.BestFloor() + " 层 · 最快登顶 " + fastest
            + " · 登顶 " + this.shell.Wins() + " / " + this.shell.Runs() + " 局", "rg-dim"));
        Panel actions = this.Row("");
        actions.Gap(12);
        Button again = new Button("同种子再来一局");
        again.Class = "rg-cta rg-big-btn";
        again.OnClick(() => { this.StartRun(this.flow.run.Seed()); });
        actions.With(again);
        Button back = new Button("回到主菜单（Esc）");
        back.Class = "rg-btn rg-big-btn";
        back.OnClick(() => { this.GoMenu(); });
        actions.With(back);
        card.With(actions);
        page.With(card);
        root.With(page);
    }
}
