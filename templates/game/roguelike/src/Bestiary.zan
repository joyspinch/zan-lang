using System;
using System.Collections.Generic;

// 图鉴：三幕的全部敌人。每幕 3–4 种普通敌人、1 种精英、1 个 Boss。
//
// 难度曲线写在数据里：第 1 幕前两场只从"弱小"的前两种里抽（史莱姆、毒蛛），
// 让第一分钟好读；之后招式开始组合（攻击+削弱、格挡+强化），第 2、3 幕引入
// 多段攻击、吸血与中毒，Boss 有开场招与四段循环。
// 加敌人：在 Build() 里加一条 EnemyDef，RogueArt 给它的 look 一个外形即可。
public class Bestiary {
    List<EnemyDef> all;

    public Bestiary() {
        this.all = new List<EnemyDef>();
        this.Build();
    }

    void Build() {
        // ---- 第 1 幕：地牢 ----
        this.all.Add(new EnemyDef("slime", "沼泽史莱姆", "slime", 0, 1, 26, 4, 1)
            .About("黏糊糊的一团，酸液会让你虚弱。")
            .Move(new EnemyMove("撞击").Hit(7, 1))
            .Move(new EnemyMove("酸液").Hit(4, 1).Hex(1, 0)));
        this.all.Add(new EnemyDef("spider", "洞穴毒蛛", "spider", 0, 1, 22, 4, 1)
            .About("咬一口就中毒——毒每回合都在烧。")
            .Move(new EnemyMove("毒咬").Hit(3, 1).Venom(3))
            .Move(new EnemyMove("撕咬").Hit(6, 1))
            .Move(new EnemyMove("吐丝").Hex(1, 1)));
        this.all.Add(new EnemyDef("skeleton", "骷髅兵", "skeleton", 0, 1, 32, 4, 0)
            .About("砍一刀、举一次盾，节奏好读。")
            .Move(new EnemyMove("劈砍").Hit(9, 1))
            .Move(new EnemyMove("举盾").Guard(7).Hit(4, 1)));
        this.all.Add(new EnemyDef("cultist", "邪教徒", "cultist", 0, 1, 40, 4, 2)
            .About("先念咒强化自己，拖得越久越疼。")
            .Move(new EnemyMove("仪式").Buff(3))
            .Move(new EnemyMove("黑刃").Hit(6, 1)));
        this.all.Add(new EnemyDef("knight", "骷髅骑士", "knight", 1, 1, 74, 6, 0)
            .About("精英：重甲冲锋，践踏会让你易伤。")
            .Move(new EnemyMove("冲锋").Hit(14, 1))
            .Move(new EnemyMove("盾墙").Guard(12).Buff(2))
            .Move(new EnemyMove("践踏").Hit(7, 1).Hex(0, 2)));
        this.all.Add(new EnemyDef("boneking", "骸骨君王", "boneking", 2, 1, 120, 0, 2)
            .About("第 1 幕 Boss：号令之后连斩，处刑一击极重。")
            .Move(new EnemyMove("王之号令").Guard(10).Buff(2))
            .Move(new EnemyMove("骨刺").Hit(5, 2))
            .Move(new EnemyMove("腐骨").Hit(5, 1).Hex(1, 0))
            .Move(new EnemyMove("处刑").Hit(16, 1)));

        // ---- 第 2 幕：墓城 ----
        this.all.Add(new EnemyDef("gargoyle", "石像鬼", "gargoyle", 0, 2, 46, 6, 0)
            .About("三连爪击——格挡要叠够三段。")
            .Move(new EnemyMove("爪击").Hit(4, 3))
            .Move(new EnemyMove("石化").Guard(12).Buff(2)));
        this.all.Add(new EnemyDef("necro", "亡灵法师", "necro", 0, 2, 42, 4, 0)
            .About("先削弱再轰击，还会吸你的魂回血。")
            .Move(new EnemyMove("衰弱").Hex(2, 2))
            .Move(new EnemyMove("暗影箭").Hit(13, 1))
            .Move(new EnemyMove("汲魂").Hit(8, 1).Mend(6)));
        this.all.Add(new EnemyDef("hound", "腐尸犬", "hound", 0, 2, 44, 4, 1)
            .About("野性难测：撕咬、嚎叫或扑咬。")
            .Move(new EnemyMove("撕咬").Hit(6, 2))
            .Move(new EnemyMove("嚎叫").Buff(2).Guard(6))
            .Move(new EnemyMove("扑咬").Hit(11, 1)));
        this.all.Add(new EnemyDef("archer", "骷髅弓手", "archer", 0, 2, 38, 4, 0)
            .About("箭雨四段，瞄准之后一箭穿心。")
            .Move(new EnemyMove("箭雨").Hit(3, 4))
            .Move(new EnemyMove("瞄准").Guard(8).Buff(1))
            .Move(new EnemyMove("穿心箭").Hit(15, 1)));
        this.all.Add(new EnemyDef("fiend", "血魔", "fiend", 1, 2, 120, 8, 0)
            .About("精英：吸血回复，狂暴后越打越疼。")
            .Move(new EnemyMove("血雨").Hit(5, 3))
            .Move(new EnemyMove("狂暴").Buff(3).Mend(10))
            .Move(new EnemyMove("吸血").Hit(12, 1).Mend(6)));
        this.all.Add(new EnemyDef("witch", "腐化女巫", "witch", 2, 2, 180, 0, 2)
            .About("第 2 幕 Boss：瘟疫与诅咒，献祭回血强化。")
            .Move(new EnemyMove("瘟疫").Venom(4).Hex(1, 0))
            .Move(new EnemyMove("暗影鞭").Hit(5, 3))
            .Move(new EnemyMove("诅咒箭").Hit(18, 1))
            .Move(new EnemyMove("献祭").Buff(2).Mend(12)));

        // ---- 第 3 幕：深渊 ----
        this.all.Add(new EnemyDef("assassin", "暗影刺客", "assassin", 0, 3, 60, 6, 1)
            .About("毒刃、连刺、隐匿，三招随机换。")
            .Move(new EnemyMove("毒刃").Hit(8, 1).Venom(4))
            .Move(new EnemyMove("连刺").Hit(4, 4))
            .Move(new EnemyMove("隐匿").Guard(16).Buff(2)));
        this.all.Add(new EnemyDef("golem", "熔岩魔像", "golem", 0, 3, 86, 8, 0)
            .About("皮糙肉厚，蓄热之后一拳千钧。")
            .Move(new EnemyMove("熔岩拳").Hit(16, 1))
            .Move(new EnemyMove("蓄热").Buff(3).Guard(12))
            .Move(new EnemyMove("地裂").Hit(10, 1).Hex(0, 2)));
        this.all.Add(new EnemyDef("wraith", "怨灵", "wraith", 0, 3, 54, 6, 0)
            .About("哀嚎让你又弱又脆，再来夺魂。")
            .Move(new EnemyMove("哀嚎").Hex(2, 2))
            .Move(new EnemyMove("灵爪").Hit(7, 2))
            .Move(new EnemyMove("夺魂").Hit(12, 1).Mend(8)));
        this.all.Add(new EnemyDef("paladin", "堕落圣骑士", "paladin", 1, 3, 170, 10, 0)
            .About("精英：审判重击，圣盾之后更强。")
            .Move(new EnemyMove("审判").Hit(22, 1))
            .Move(new EnemyMove("圣盾").Guard(20).Buff(2))
            .Move(new EnemyMove("惩戒").Hit(8, 1).Hex(2, 2)));
        this.all.Add(new EnemyDef("warden", "深渊守卫", "warden", 2, 3, 260, 0, 2)
            .About("最终 Boss：凝视、毁灭、碾压、壁垒，四拍循环。")
            .Move(new EnemyMove("深渊凝视").Hex(1, 2).Guard(12))
            .Move(new EnemyMove("毁灭").Hit(26, 1))
            .Move(new EnemyMove("碾压").Hit(8, 3))
            .Move(new EnemyMove("壁垒").Guard(20).Buff(3)));
    }

    public int Count() { return this.all.Count; }
    public EnemyDef At(int i) { return this.all[i]; }

    public EnemyDef Find(string id) {
        for (int i = 0; i < this.all.Count; i = i + 1) {
            if (this.all[i].id == id) { return this.all[i]; }
        }
        return null;
    }

    // 按幕与档次挑一个敌人；easy 只在该幕前两种普通敌人里挑。
    public EnemyDef Pick(int act, int tier, int roll, bool easy) {
        List<EnemyDef> pool = new List<EnemyDef>();
        for (int i = 0; i < this.all.Count; i = i + 1) {
            EnemyDef d = this.all[i];
            if (d.act == act && d.tier == tier) { pool.Add(d); }
        }
        if (pool.Count == 0) { return this.all[0]; }
        int n = easy && pool.Count > 2 ? 2 : pool.Count;
        return pool[roll % n];
    }
}
