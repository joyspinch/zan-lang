using System;

// 敌人的一个招式 = 一个意图：攻击（可多段）、格挡、强化、削弱，可以组合。
// 意图在玩家回合开始前就亮出来（Battle.intent），玩家据此决定叠甲还是抢攻。
public class EnemyMove {
    public string name;
    public int damage;
    public int hits;
    public int block;
    public int strength;
    public int weakness;
    public int vulnerable;
    public int poison;
    public int heal;

    public EnemyMove(string name) {
        this.name = name;
        this.hits = 1;
    }

    // 链式小工厂：Bestiary 里一行写一个招式。
    public EnemyMove Hit(int damage, int hits) { this.damage = damage; this.hits = hits; return this; }
    public EnemyMove Guard(int block) { this.block = block; return this; }
    public EnemyMove Buff(int strength) { this.strength = strength; return this; }
    public EnemyMove Hex(int weakness, int vulnerable) { this.weakness = weakness; this.vulnerable = vulnerable; return this; }
    public EnemyMove Venom(int poison) { this.poison = poison; return this; }
    public EnemyMove Mend(int heal) { this.heal = heal; return this; }

    public bool Attacks() { return this.damage > 0; }
    public bool Debuffs() { return this.weakness > 0 || this.vulnerable > 0 || this.poison > 0; }
    public bool Buffs() { return this.strength > 0 || this.heal > 0; }

    // 意图种类（界面挑图标与配色）：攻击 / 多段 / 防御 / 强化 / 削弱。
    public string Kind() {
        if (this.damage > 0) { return this.hits > 1 ? "multi" : "attack"; }
        if (this.Debuffs()) { return "debuff"; }
        if (this.Buffs()) { return "buff"; }
        return "defend";
    }
}
