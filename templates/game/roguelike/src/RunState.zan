using System;
using System.Collections.Generic;
using Game.Foundation;

// 一局肉鸽的全部可变状态：种子、进阶、幕、地图位置、生命、金币、牌组、遗物。
//
// 核心约定：**一切随机都出自 run.random**，而 run.random 由种子决定——同一颗种子
// 必然给出同一张地图、同一批敌人、同一组奖励与商店货架（每场战斗的洗牌/意图
// 随机源也从种子派生）。牌组和遗物都只存 id（纯数据）。
public class RunState {
    int seed;
    int ascension;
    DeterministicRandom random;
    public int act;
    public int hp;
    public int maxHp;
    public int gold;
    public int kills;
    // 已走过的节点数（跨幕累计，"第 N 层"）。
    public int floors;
    public List<string> deck;
    public List<string> relics;
    public ActMap map;
    // 当前所在节点（-1 = 本幕刚开始，还没走第一步）。
    public int pos;
    // 本局已经遇过的奇遇（不重复）。
    public List<int> seenEvents;
    // 商店删牌服务的价格（每用一次 +25）。
    public int removeCost;

    RunState(int seed, int ascension, CardLibrary library) {
        this.seed = seed;
        this.ascension = ascension;
        this.random = new DeterministicRandom(seed);
        this.act = 0;
        this.maxHp = 72 - ascension * 3;
        this.hp = this.maxHp;
        this.gold = 99;
        this.kills = 0;
        this.floors = 0;
        this.pos = -1;
        this.removeCost = 75;
        this.deck = new List<string>();
        this.relics = new List<string>();
        this.seenEvents = new List<int>();
        for (int i = 0; i < library.StarterCount(); i = i + 1) {
            this.deck.Add(library.StarterAt(i));
        }
        this.relics.Add("ember_blood");
    }

    int Seed() { return this.seed; }
    int Ascension() { return this.ascension; }
    int Floor() { return this.floors; }
    int Hp() { return this.hp; }
    int MaxHp() { return this.maxHp; }
    int Kills() { return this.kills; }
    int Gold() { return this.gold; }
    List<string> Deck() { return this.deck; }

    // 进入下一幕：新地图，回到起点；幕间回复一半已损生命。
    void NextAct() {
        this.act = this.act + 1;
        this.map = new ActMap(this.random);
        this.pos = -1;
        if (this.act > 1) { this.Heal((this.maxHp - this.hp) / 2); }
    }

    // 当前可以走的节点：本幕起点是第 0 行全部，之后是当前节点的连线。
    List<MapNode> Choices() {
        List<MapNode> list = new List<MapNode>();
        if (this.map == null) { return list; }
        if (this.pos < 0) { return this.map.RowNodes(0); }
        MapNode at = this.map.nodes[this.pos];
        for (int i = 0; i < at.next.Count; i = i + 1) { list.Add(this.map.nodes[at.next[i]]); }
        return list;
    }

    void MoveTo(MapNode node) {
        node.visited = true;
        this.pos = node.index;
        this.floors = this.floors + 1;
    }

    bool HasRelic(string id) {
        for (int i = 0; i < this.relics.Count; i = i + 1) {
            if (this.relics[i] == id) { return true; }
        }
        return false;
    }

    void SetHp(int value) {
        if (value < 0) { value = 0; }
        if (value > this.maxHp) { value = this.maxHp; }
        this.hp = value;
    }

    void Heal(int amount) { this.SetHp(this.hp + amount); }

    void AddMaxHp(int amount) {
        this.maxHp = this.maxHp + amount;
        if (this.maxHp < 1) { this.maxHp = 1; }
        this.SetHp(this.hp + (amount > 0 ? amount : 0));
    }

    // 拿金币（贪婪指环 +50%）；返回实得。
    int AddGold(int amount) {
        if (this.HasRelic("greed_ring")) { amount = amount * 3 / 2; }
        this.gold = this.gold + amount;
        return amount;
    }

    // 用本局随机源取 [0, bound)——地图、敌人、奖励、商店、奇遇全部走这里。
    int Roll(int bound) { return bound <= 1 ? 0 : this.random.NextBelow(bound); }

    // 敌人强度随进阶提升：每级 +6% 生命。
    int ScaleEnemyHp(int hp) { return hp * (100 + this.ascension * 6) / 100; }

    // 牌组里可升级的位置（未升级的牌）。
    List<int> Upgradable() {
        List<int> list = new List<int>();
        for (int i = 0; i < this.deck.Count; i = i + 1) {
            if (!CardLibrary.IsUpgraded(this.deck[i])) { list.Add(i); }
        }
        return list;
    }

    // 随机升级 n 张（可选只升攻击牌）；返回升级了几张。
    int UpgradeRandom(int n, CardLibrary library, bool attacksOnly) {
        int done = 0;
        for (int k = 0; k < n; k = k + 1) {
            List<int> pool = new List<int>();
            List<int> all = this.Upgradable();
            for (int i = 0; i < all.Count; i = i + 1) {
                if (!attacksOnly || library.Find(this.deck[all[i]]).Category() == "attack") { pool.Add(all[i]); }
            }
            if (pool.Count == 0) { return done; }
            int at = pool[this.Roll(pool.Count)];
            this.deck[at] = CardLibrary.UpgradeOf(this.deck[at]);
            done = done + 1;
        }
        return done;
    }
}
