using System;
using Game.Cards;

// 卡牌效果种类：前 7 种直接取引擎 Game.Cards 的 CardEffectKind，其余是本作的扩展。
//
// CardDefinition 的效果只是 (kind, amount, target) 三元组，kind 是整数——所以扩展
// 关键词不用改引擎：在这里登记一个新编号，再到 Battle.Resolve 里写它的结算即可。
// 「消耗」「保留」这种不结算数值的关键词也挂成效果（amount 恒为 1），牌面文案
// 与战斗都按同一份效果表读，不会漏。
public class CardFx {
    public static int Damage() { return CardEffectKind.Damage(); }
    public static int Block() { return CardEffectKind.Block(); }
    public static int Heal() { return CardEffectKind.Heal(); }
    public static int Draw() { return CardEffectKind.Draw(); }
    public static int Energy() { return CardEffectKind.Energy(); }
    public static int Strength() { return CardEffectKind.Strength(); }
    public static int Vulnerable() { return CardEffectKind.Vulnerable(); }
    // 中毒：目标每回合开始失去等量生命，层数 -1。
    public static int Poison() { return 8; }
    // 虚弱：目标造成的攻击伤害 -25%，每回合结束 -1。
    public static int Weak() { return 9; }
    // 盾击：造成等同当前格挡的伤害（吃力量）。
    public static int BlockDamage() { return 10; }
    // 自损：失去生命（不经格挡）。
    public static int LoseHp() { return 11; }
    // 催化：目标中毒层数翻倍。
    public static int DoublePoison() { return 12; }
    // 消耗：打出后移出本场战斗。
    public static int Exhaust() { return 20; }
    // 保留：回合结束不弃掉。
    public static int Retain() { return 21; }
    // 能力（本场持续）：每回合开始获得力量 / 回合结束获得格挡 / 每回合开始给敌人中毒 /
    // 每回合多抽牌 / 受到攻击时反伤。
    public static int PowerStrength() { return 30; }
    public static int PowerPlating() { return 31; }
    public static int PowerPoison() { return 32; }
    public static int PowerDraw() { return 33; }
    public static int PowerThorns() { return 34; }
}
