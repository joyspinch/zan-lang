using System;
using System.Collections.Generic;
using Gui;
using Gui.Backend;
using Gui.Widget;

// 最上层的演出层：飞牌与飘字要越过手牌区和铭牌，所以画在所有控件之上。
// 它铺满整窗（皮肤里 position:absolute），不参与命中——点击照样落到下面的标准控件。
public class FxLayer : Control {
    BattleFx fx;

    public FxLayer(BattleFx fx) {
        InitControl("FxLayer");
        this.fx = fx;
        NoOverlapCheck();
    }

    public override string Kind() { return "FxLayer"; }

    public override void OnMeasure(App app) { prefW = 0; prefH = 0; }

    protected override Control HitTestCore(int x, int y, int pointerType, List<Control> excludedSubtrees) { return null; }

    public override void OnPaint(App app) {
        Canvas c = app.canvas;
        int now = BattleFx.Now();
        bool live = false;
        for (int i = 0; i < this.fx.items.Count; i = i + 1) {
            FxItem it = this.fx.items[i];
            double t = it.T(now);
            if (t < 1.0) { live = true; }
            if (t <= 0.0 || t >= 1.0) { continue; }
            if (it.kind == "fly") { this.PaintFly(c, it, t); }
            else if (it.kind == "num") { this.PaintNum(c, it, t); }
        }
        this.fx.Prune(now);
        if (live) { app.RequestAnimationFrame(); }
    }

    // 飞牌：沿弧线飞向目标，边飞边缩小、旋转，末段淡出。
    void PaintFly(Canvas c, FxItem it, double t) {
        double e = 1.0 - (1.0 - t) * (1.0 - t);
        int tx = it.who == 0 ? this.fx.heroX : this.fx.enemyX;
        int ty = it.who == 0 ? this.fx.heroY : this.fx.enemyY;
        int sx = it.x + it.w / 2;
        int sy = it.y + it.h / 2;
        int cx = sx + (int)((double)(tx - sx) * e);
        int cy = sy + (int)((double)(ty - sy) * e) - (int)(Math.Sin(t * 3.14159) * 90.0);
        double scale = 1.0 - 0.55 * e;
        int w = (int)((double)it.w * scale);
        int h = (int)((double)it.h * scale);
        int alpha = t > 0.75 ? (int)((1.0 - t) / 0.25 * 1000.0) : 1000;
        int border = (int)0xFFC8503A;
        if (it.text2 == "skill") { border = (int)0xFF3AA8A2; }
        if (it.text2 == "power") { border = (int)0xFF9466DC; }
        int angle = (int)(e * (it.who == 0 ? -12.0 : 14.0));
        if (c.PushLayer(cx - w / 2, cy - h / 2, w, h, alpha, 1000, angle)) {
            c.FillRoundRect(0, 0, w, h, 10, border);
            c.FillVGrad(3, 3, w - 6, h - 6, (int)0xFF3D2E22, (int)0xFF140E0B);
            c.FillCircle(16, 16, 12, (int)0xFFE89A30);
            c.DrawTextCentered(4, 4, 24, 24, Convert.ToString(it.value), (int)0xFF2A1206, 15);
            c.DrawTextCentered(0, h / 2 - 14, w, 28, it.text, (int)0xFFFFE9C0, w > 90 ? 18 : 13);
            c.PopLayer();
        }
        // 尾迹火星。
        for (int k = 1; k < 5; k = k + 1) {
            double tk = t - (double)k * 0.05;
            if (tk <= 0.0) { continue; }
            double ek = 1.0 - (1.0 - tk) * (1.0 - tk);
            int px = sx + (int)((double)(tx - sx) * ek);
            int py = sy + (int)((double)(ty - sy) * ek) - (int)(Math.Sin(tk * 3.14159) * 90.0);
            c.FillCircle(px, py, 6 - k, ((200 - k * 40) << 24) | 0xFFB050);
        }
    }

    // 飘字：先弹大再缩回，上飘并淡出；描黑边保证在任何背景上可读。
    void PaintNum(Canvas c, FxItem it, double t) {
        int ax = it.who == 0 ? this.fx.heroX : this.fx.enemyX;
        int ay = it.who == 0 ? this.fx.heroY : this.fx.enemyY;
        double pop = t < 0.15 ? 0.6 + t / 0.15 * 0.6 : (t < 0.3 ? 1.2 - (t - 0.15) / 0.15 * 0.2 : 1.0);
        int size = (int)((double)it.value * pop);
        if (size < 8) { size = 8; }
        int y = ay - 40 - (int)(t * 70.0) + it.extra;
        int x = ax;
        int a = t > 0.7 ? (int)((1.0 - t) / 0.3 * 255.0) : 255;
        int ink = (a << 24) | 0x140806;
        int col = (a << 24) | (it.color & 0xFFFFFF);
        int bw = 260;
        int bh = size + 12;
        c.DrawTextCentered(x - bw / 2 - 2, y, bw, bh, it.text, ink, size);
        c.DrawTextCentered(x - bw / 2 + 2, y, bw, bh, it.text, ink, size);
        c.DrawTextCentered(x - bw / 2, y - 2, bw, bh, it.text, ink, size);
        c.DrawTextCentered(x - bw / 2, y + 3, bw, bh, it.text, ink, size);
        c.DrawTextCentered(x - bw / 2, y, bw, bh, it.text, col, size);
    }
}
