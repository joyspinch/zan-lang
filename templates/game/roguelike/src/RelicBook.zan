using System;
using System.Collections.Generic;

// 遗物：一局里一直生效的被动效果。精英战掉一件普通遗物、宝箱开一件、
// Boss 战后三选一一件 Boss 遗物；起手自带「余烬之血」。
//
// 遗物只存 id（纯数据，RunState.relics），效果按 id 写在结算处：
// 战斗类在 Battle（开场 / 回合开始 / 回合结束），流程类在 RunFlow（战后回血、
// 金币、拾取时升级）。加遗物 = 这里登记一条 + 在结算处认它的 id。
public class RelicBook {
    public static int Starter() { return 0; }
    public static int Normal() { return 1; }
    public static int BossTier() { return 2; }

    List<string> ids;
    List<string> names;
    List<string> glyphs;
    List<string> descs;
    List<int> tiers;

    public RelicBook() {
        this.ids = new List<string>();
        this.names = new List<string>();
        this.glyphs = new List<string>();
        this.descs = new List<string>();
        this.tiers = new List<int>();
        int S = RelicBook.Starter();
        int N = RelicBook.Normal();
        int B = RelicBook.BossTier();
        this.Add("ember_blood", "余烬之血", "血", S, "每场战斗胜利后回复 6 生命。");
        this.Add("anchor", "沉船之锚", "锚", N, "每场战斗开始时获得 10 格挡。");
        this.Add("vajra", "金刚杵", "杵", N, "每场战斗开始时获得 1 力量。");
        this.Add("lantern", "引魂灯", "灯", N, "每场战斗第 1 回合多 1 能量。");
        this.Add("serpent_ring", "蛇眼戒", "戒", N, "每场战斗第 1 回合多抽 2 张牌。");
        this.Add("bronze_scales", "青铜鳞片", "鳞", N, "每场战斗开始时获得 3 荆棘（受击反伤）。");
        this.Add("blood_vial", "血瓶", "瓶", N, "每场战斗开始时回复 3 生命。");
        this.Add("marbles", "碎骨袋", "袋", N, "每场战斗开始时给敌人 1 易伤。");
        this.Add("red_mask", "赤红面具", "面", N, "每场战斗开始时给敌人 1 虚弱。");
        this.Add("venom_sac", "毒囊", "囊", N, "每场战斗开始时给敌人 4 中毒。");
        this.Add("orichalcum", "山铜护符", "符", N, "回合结束时若没有格挡，获得 6 格挡。");
        this.Add("whetstone", "磨刀石", "砺", N, "拾取时随机升级牌组里 2 张攻击牌。");
        this.Add("greed_ring", "贪婪指环", "贪", N, "之后获得的金币 +50%。");
        this.Add("ember_crown", "余烬王冠", "冠", B, "每回合多 1 能量。");
        this.Add("star_box", "群星之匣", "匣", B, "每回合多抽 1 张牌。");
        this.Add("titan_heart", "泰坦之心", "心", B, "拾取时生命上限 +25，并回满生命。");
        this.Add("demon_horn", "恶魔之角", "角", B, "每场战斗开始时获得 3 力量。");
    }

    void Add(string id, string name, string glyph, int tier, string desc) {
        this.ids.Add(id);
        this.names.Add(name);
        this.glyphs.Add(glyph);
        this.tiers.Add(tier);
        this.descs.Add(desc);
    }

    int IndexOf(string id) {
        for (int i = 0; i < this.ids.Count; i = i + 1) {
            if (this.ids[i] == id) { return i; }
        }
        return -1;
    }

    public int Count() { return this.ids.Count; }
    public string IdAt(int i) { return this.ids[i]; }
    public int TierAt(int i) { return this.tiers[i]; }
    public string Name(string id) { int i = this.IndexOf(id); return i < 0 ? id : this.names[i]; }
    public string Glyph(string id) { int i = this.IndexOf(id); return i < 0 ? "?" : this.glyphs[i]; }
    public string Desc(string id) { int i = this.IndexOf(id); return i < 0 ? "" : this.descs[i]; }
    public int Tier(string id) { int i = this.IndexOf(id); return i < 0 ? 0 : this.tiers[i]; }

    // 某档次里还没拿到的遗物（按登记顺序）——调用方用本局随机源挑。
    public List<string> Unowned(int tier, List<string> owned) {
        List<string> list = new List<string>();
        for (int i = 0; i < this.ids.Count; i = i + 1) {
            if (this.tiers[i] != tier) { continue; }
            bool have = false;
            for (int j = 0; j < owned.Count; j = j + 1) {
                if (owned[j] == this.ids[i]) { have = true; }
            }
            if (!have) { list.Add(this.ids[i]); }
        }
        return list;
    }
}
