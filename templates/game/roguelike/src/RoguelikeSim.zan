using System;
using System.Collections.Generic;
using Game.Cards;
using Game.Foundation;

// 回放与回归（docs/ZAN_STANDARD.md S26/S27）：用界面走的同一份 RunFlow 无头推进一局。
// replays/ 下的回放由 `zan-check` 重放、逐校验点比对；Bot 是模糊测试用的机器人。
// 改了规则后回放分叉，就重新录制（见 README）。
//
// 输入编码（与当前阶段不符的输入忽略，和点不到的按钮一样）：
//   1 开局（回放种子，进阶 0）   10+i 走第 i 个可选节点      20+i 打出第 i 张手牌   30 结束回合
//   40+i 收下第 i 张奖励牌       44 跳过奖励牌              45+i 选第 i 件 Boss 遗物
//   50 结算页回主菜单            60 篝火休息  61 篝火锻造
//   70+i 奇遇第 i 个选项         79 奇遇结束继续
//   80+i 商店买第 i 张牌         86+i 买第 i 件遗物  88 删牌服务  89 离开商店
//   99 取消选牌                  100+i 选牌第 i 个候选
public class RoguelikeSim : IReplaySim {
    // 模糊测试时 Bot 读的当前仿真（Bot 是静态函数，只拿得到随机源）。
    static RoguelikeSim live;
    public RunFlow flow;
    int seed;

    public void Reset(long seed) {
        this.seed = (int)(seed % 999999999);
        this.flow = new RunFlow();
        RoguelikeSim.live = this;
    }

    public void Step(int frame, int input) {
        RunFlow f = this.flow;
        int p = f.phase;
        if (input == 1 && (p == RunFlow.Menu() || p == RunFlow.Over())) {
            f.StartRun(this.seed, 0);
        } else if (input >= 10 && input < 20 && p == RunFlow.MapPhase()) {
            List<MapNode> choices = f.run.Choices();
            int i = input - 10;
            if (i < choices.Count) { f.EnterNode(choices[i]); }
        } else if (input >= 20 && input < 30) {
            f.PlayCard(input - 20);
        } else if (input == 30) {
            f.EndTurn();
        } else if (input >= 40 && input < 43) {
            f.TakeReward(input - 40);
        } else if (input == 44) {
            f.SkipCards();
        } else if (input >= 45 && input < 48) {
            f.TakeRelic(input - 45);
        } else if (input == 50 && p == RunFlow.Over()) {
            f.phase = RunFlow.Menu();
        } else if (input == 60) {
            f.Rest();
        } else if (input == 61) {
            f.Smith();
        } else if (input >= 70 && input < 79) {
            f.ChooseEvent(input - 70);
        } else if (input == 79) {
            f.EventContinue();
        } else if (input >= 80 && input < 86) {
            f.BuyCard(input - 80);
        } else if (input >= 86 && input < 88) {
            f.BuyRelic(input - 86);
        } else if (input == 88) {
            f.BuyRemoval();
        } else if (input == 89) {
            f.LeaveShop();
        } else if (input == 99) {
            f.CancelPick();
        } else if (input >= 100 && input < 200) {
            f.PickCard(input - 100);
        }
    }

    public int StateChecksum() {
        RunFlow f = this.flow;
        StateHasher h = new StateHasher();
        h.Int(f.phase).Bool(f.runWon);
        if (f.run != null) {
            RunState r = f.run;
            h.Int(r.act).Int(r.floors).Int(r.hp).Int(r.maxHp).Int(r.gold).Int(r.kills).Int(r.pos);
            for (int i = 0; i < r.deck.Count; i = i + 1) { h.Text(r.deck[i]); }
            for (int i = 0; i < r.relics.Count; i = i + 1) { h.Text(r.relics[i]); }
        }
        if (f.phase == RunFlow.Fight() && f.battle != null) {
            Battle b = f.battle;
            h.Int(b.player.hp).Int(b.player.block).Int(b.player.strength).Int(b.player.poison)
             .Int(b.enemy.hp).Int(b.enemy.block).Int(b.enemy.strength).Int(b.enemy.poison)
             .Int(b.energy).Int(b.turn).Int(b.Hand().Count()).Text(b.def.id);
        }
        for (int i = 0; i < f.rewardChoices.Count; i = i + 1) { h.Text(f.rewardChoices[i]); }
        for (int i = 0; i < f.shopCards.Count; i = i + 1) { h.Text(f.shopCards[i]); }
        h.Int(f.eventId).Int(f.pickList.Count);
        return h.Value();
    }

    [Invariant]
    public bool HpInRange() {
        RunState r = this.flow.run;
        return r == null || (r.hp >= 0 && r.hp <= r.maxHp && r.maxHp > 0);
    }

    [Invariant]
    public bool ActInRange() {
        RunState r = this.flow.run;
        return r == null || (r.act >= 1 && r.act <= RunFlow.LastAct());
    }

    [Invariant]
    public bool GoldNeverNegative() {
        return this.flow.run == null || this.flow.run.gold >= 0;
    }

    // 牌组里的每个 id 都有牌面定义；删牌服务不会删到 5 张以下。
    [Invariant]
    public bool DeckIntact() {
        RunState r = this.flow.run;
        if (r == null) { return true; }
        if (r.deck.Count < 5) { return false; }
        for (int i = 0; i < r.deck.Count; i = i + 1) {
            if (this.flow.library.Find(r.deck[i]) == null) { return false; }
        }
        return true;
    }

    // 战斗中：四区牌数之和 = 牌组张数（牌不会凭空多出或丢失），能量不为负，手牌不超 10。
    [Invariant]
    public bool BattleConservesCards() {
        RunFlow f = this.flow;
        if (f.phase != RunFlow.Fight() || f.battle == null) { return true; }
        CardDeck d = f.battle.deck;
        int total = d.DrawPile().Count() + d.Hand().Count() + d.DiscardPile().Count() + d.ExhaustPile().Count();
        return total == f.run.deck.Count && f.battle.energy >= 0 && d.Hand().Count() <= 10;
    }

    // 地图位置合法，走过的节点数 = 层数（每走一步层数 +1）。
    [Invariant]
    public bool MapPathConsistent() {
        RunState r = this.flow.run;
        if (r == null || r.map == null) { return true; }
        if (r.pos >= r.map.nodes.Count) { return false; }
        int visited = 0;
        for (int i = 0; i < r.map.nodes.Count; i = i + 1) {
            if (r.map.nodes[i].visited) { visited = visited + 1; }
        }
        return visited <= ActMap.Rows() + 1 && r.floors >= visited;
    }

    // 阶段与数据一致：战斗阶段有一场未分胜负的战斗，战利品阶段有东西可拿，选牌有候选。
    [Invariant]
    public bool PhaseConsistent() {
        RunFlow f = this.flow;
        if (f.phase < 0 || f.phase > 8) { return false; }
        if (f.phase == RunFlow.Fight() && (f.battle == null || f.battle.winner >= 0)) { return false; }
        if (f.phase == RunFlow.Loot() && f.cardDone && f.relicDone) { return false; }
        if (f.phase == RunFlow.Pick() && f.pickList.Count == 0) { return false; }
        return true;
    }

    // 机器人：大多数时候照"会玩的人"出手（RogueBot），掺 15% 乱按测边界。
    public static int Bot(DeterministicRandom rng, int frame) {
        RoguelikeSim sim = RoguelikeSim.live;
        if (sim != null && rng.NextBelow(100) < 85) {
            return RogueBot.Decide(sim.flow, rng);
        }
        int[] codes = new int[]{ 1, 10, 11, 12, 20, 21, 22, 30, 40, 41, 44, 45, 50, 60, 61, 70, 71, 72, 79, 80, 86, 88, 89, 99, 100, 101 };
        return codes[rng.NextBelow(codes.Length)];
    }
}
