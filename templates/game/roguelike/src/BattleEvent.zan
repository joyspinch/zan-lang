using System;

// 战斗里发生的一件事（给界面演出用）：谁、什么、多少。
// 规则层只负责记下来；界面层读完就播动画（飞牌、跳字、抖动、护盾），
// 无头回放从不读它——表现与规则分离，回放不受动画影响。
//
// kind：play 出牌 · hit 受到攻击 · block 获得格挡 · poison 中毒发作 · heal 回复
//       buff 强化 · debuff 被削弱 · thorns 反伤 · lose 自损 · draw 抽牌 · energy 能量
// who：0 攀登者 · 1 敌人（被作用的一方）
public class BattleEvent {
    public string kind;
    public int who;
    public int amount;
    public int extra;
    public string text;

    public BattleEvent(string kind, int who, int amount, int extra, string text) {
        this.kind = kind;
        this.who = who;
        this.amount = amount;
        this.extra = extra;
        this.text = text;
    }
}
