using System;

// 肉鸽爬塔的游戏皮肤：暗色石砌塔 + 熔金 + 余烬橙 + 深红，取自标题图 assets/title.png。
//
// 界面全部是标准控件（Panel 流式容器 / Label / Button / InputNumber / Progress /
// Image），这里只给语义类上色——不自绘、不重画控件。整张样式表随 exe 内嵌
// （app.UseCss），发布时不需要旁带皮肤文件。
//
// 语义类一览（前缀 rg-）：
//   页面    rg-root · rg-topbar · rg-panel(-gold/-danger) · rg-spacer · rg-tile
//   文字    rg-h1 · rg-sub · rg-h2 · rg-text · rg-dim · rg-big + 颜色 rg-gold/ember/red/teal/violet/green
//   按钮    rg-btn（石质）· rg-cta（熔金主按钮）· rg-chip（顶栏小钮）· rg-danger
//   卡牌    rg-card + rg-card-attack/skill/power · rg-cost(-off) · rg-type-* · rg-card-art/name/fx/warn
//   路线    rg-node + rg-node-elite/chest/boss · rg-pip(-done/-now) · rg-node-art
//   战斗    rg-actor · rg-enemy · rg-bar + rg-hp/rg-ehp · rg-status · rg-intent · rg-energy(-empty)
public class RogueSkin {
    public static string Css() {
        return RogueSkin.PageCss() + RogueSkin.TextCss() + RogueSkin.ButtonCss()
            + RogueSkin.CardCss() + RogueSkin.MapCss() + RogueSkin.BattleCss();
    }

    // 页面底、面板与顶栏：黑石底 + 暖金描边，面板像嵌在塔壁里的石板。
    static string PageCss() {
        return "window{background:#0b0807}"
            + "stack.rg-root{flex-grow:1;background:linear-gradient(to bottom,#1e1512,#080605)}"
            + "stack.rg-fill{flex-grow:1}"
            + "stack.rg-spacer{flex-grow:1}"
            + "stack.rg-center{align-items:center;justify-content:center}"
            + "stack.rg-mid{align-items:center}"
            + "stack.rg-vcenter{justify-content:center}"
            + "stack.rg-panel{background:linear-gradient(to bottom,#2a1f19,#150f0c);"
            + "border:1 #5e4532;border-radius:12;box-shadow:0 6 18 rgba(0,0,0,0.6)}"
            + "stack.rg-panel-gold{border:2 #c48a36;box-shadow:0 0 22 rgba(232,130,40,0.28)}"
            + "stack.rg-panel-danger{border:2 #c0392b;background:linear-gradient(to bottom,#3a1713,#1a0b09);"
            + "box-shadow:0 0 22 rgba(200,50,30,0.45)}"
            + "stack.rg-topbar{background:linear-gradient(to bottom,#2e2018,#150e0b);"
            + "border:1 #7a5530;border-radius:12;box-shadow:0 4 14 rgba(0,0,0,0.6);align-items:center}"
            + "stack.rg-tile{flex-grow:1;background:#120d0b;border:1 #4a3526;border-radius:10;"
            + "align-items:center;justify-content:center}"
            + "image.rg-hero-art{width:520;height:520;border:2 #c48a36;border-radius:14;"
            + "box-shadow:0 0 36 rgba(255,140,40,0.35);background:#120d0b}"
            + "image.rg-over-art{width:150;height:150;border:2 #c48a36;border-radius:10;background:#120d0b}"
            + "image.rg-legend-art{width:56;height:56;border:1 #5e4532;border-radius:8;background:#120d0b}"
            + "input.rg-seed{height:44;width:230;background:#0f0b09;border:1 #7a5530;border-radius:8;color:#f6e7cc;font-size:17}"
            + "input.rg-seed:hover{border-color:#e0a04a}"
            + "input.rg-seed:focus{border-color:#ffcf6e;box-shadow:0 0 8 rgba(255,170,60,0.55)}"
            + ".rg-seed input.input-number-input{color:#f6e7cc;font-size:17}"
            + ".rg-seed button.input-number-btn{width:40;color:#e8b04a;background:#1c1410;font-size:18}"
            + ".rg-seed button.input-number-btn:hover:not(:disabled){background:#3a2a1e;color:#ffd27a}"
            + ".rg-seed button.input-number-btn:active:not(:disabled){background:#4a3020}"
            + ".rg-seed button.input-number-minus{border-right:1 #4a3526}"
            + ".rg-seed button.input-number-plus{border-left:1 #4a3526}";
    }

    // 字体层级：标题熔金发光，正文羊皮纸色，说明文字暗金褐。
    static string TextCss() {
        return "label.rg-h1{font-size:50;font-weight:700;color:#ffcf6e;text-shadow:0 2 14 rgba(255,110,20,0.7)}"
            + "label.rg-sub{font-size:14;color:#e0873a;letter-spacing:5}"
            + "label.rg-h2{font-size:21;font-weight:700;color:#f2c063}"
            + "label.rg-h3{font-size:30;font-weight:700;color:#ffcf6e;text-shadow:0 2 10 rgba(255,110,20,0.6)}"
            + "label.rg-text{font-size:15;color:#ecdcc0}"
            + "label.rg-dim{font-size:13;color:#a08b72}"
            + "label.rg-big{font-size:30;font-weight:700;color:#ffcf6e}"
            + "label.rg-cap{font-size:12;color:#a08b72;letter-spacing:2}"
            + "label.rg-center{text-align:center}"
            + "label.rg-gold{color:#ffcf6e}"
            + "label.rg-ember{color:#ff9a4a}"
            + "label.rg-red{color:#ff6450}"
            + "label.rg-teal{color:#6fe0d8}"
            + "label.rg-violet{color:#c9a2ff}"
            + "label.rg-green{color:#9fdc6e}"
            + "label.rg-newbest{font-size:20;font-weight:700;color:#2a1206;text-align:center;"
            + "background:linear-gradient(to bottom,#ffd77a,#e0861e);border:1 #fff0c0;border-radius:8;"
            + "padding-top:6;padding-bottom:6;box-shadow:0 0 18 rgba(255,150,40,0.55)}";
    }

    // 按钮：石质常规钮、熔金主按钮、顶栏小钮、深红危险钮；五态齐全。
    static string ButtonCss() {
        return "button.rg-btn,button.rg-cta,button.rg-chip,button.rg-danger{height:42;padding-left:20;padding-right:20;"
            + "font-size:15;border-radius:8;-zan-sheen:0}"
            + "button.rg-btn label.button-caption,button.rg-chip label.button-caption{color:#f1e4cc;background:transparent}"
            + "button.rg-cta label.button-caption{color:#2a1206;font-weight:700;background:transparent}"
            + "button.rg-danger label.button-caption{color:#ffe6dc;background:transparent}"
            + "button.rg-btn:disabled label.button-caption,button.rg-chip:disabled label.button-caption,"
            + "button.rg-cta:disabled label.button-caption{color:#7a6a58}"
            + "button.rg-btn,button.rg-chip{color:#f1e4cc;background:linear-gradient(to bottom,#3b2b21,#221813);"
            + "border:1 #7a5a3a;box-shadow:0 2 6 rgba(0,0,0,0.5)}"
            + "button.rg-btn:hover,button.rg-chip:hover{background:linear-gradient(to bottom,#4c3727,#2f2118);"
            + "border-color:#e0a04a;color:#fff3dc;box-shadow:0 0 10 rgba(255,150,50,0.35)}"
            + "button.rg-btn:active,button.rg-chip:active{background:#170f0c;border-color:#ff8a3d;box-shadow:none}"
            + "button.rg-btn:focus,button.rg-chip:focus{border-color:#ffcf6e;box-shadow:0 0 8 rgba(255,170,60,0.6)}"
            + "button.rg-btn:disabled,button.rg-chip:disabled{color:#6f6152;background:#1a1411;border-color:#3a2c22;box-shadow:none}"
            + "button.rg-chip{height:30;padding-left:12;padding-right:12;font-size:13;border-radius:15}"
            + "button.rg-cta{color:#2a1206;font-weight:700;font-size:16;"
            + "background:linear-gradient(to bottom,#ffd06a,#de7420);border:1 #ffe4a6;"
            + "box-shadow:0 0 16 rgba(255,140,40,0.45)}"
            + "button.rg-cta:hover{background:linear-gradient(to bottom,#ffe292,#f08c2c);border-color:#fff3cf;"
            + "color:#1a0a02;box-shadow:0 0 24 rgba(255,160,50,0.7)}"
            + "button.rg-cta:active{background:linear-gradient(to bottom,#d88a2e,#a8501a);border-color:#ffcf6e;box-shadow:none}"
            + "button.rg-cta:focus{border:2 #fff6dc;box-shadow:0 0 18 rgba(255,220,140,0.8)}"
            + "button.rg-cta:disabled{color:#7a6a58;background:#2a211b;border-color:#4a3c30;box-shadow:none}"
            + "button.rg-danger{color:#ffe6dc;background:linear-gradient(to bottom,#8a2a1e,#4e120d);border:1 #d0503a;"
            + "box-shadow:0 0 12 rgba(200,50,30,0.4)}"
            + "button.rg-danger:hover{background:linear-gradient(to bottom,#a8382a,#621a12);border-color:#ff7a5a}"
            + "button.rg-danger:active{background:#3a0d09;box-shadow:none}"
            + "button.rg-danger:focus{border:2 #ffb09a;box-shadow:0 0 12 rgba(255,90,60,0.6)}"
            + "button.rg-big-btn{height:50;font-size:18;padding-left:28;padding-right:28}";
    }

    // 卡牌：整张牌就是一个标准 Button（内容是一列牌面），描边色区分类型，
    // 能量不足 = 禁用态（变暗、费用宝石转灰、底部红字提示）。
    static string CardCss() {
        return "button.rg-card{width:170;height:290;padding:0;flex-direction:column;align-items:stretch;"
            + "justify-content:flex-start;gap:0;border-radius:12;-zan-sheen:0;"
            + "background:linear-gradient(to bottom,#2e231c,#120c0a);border:2 #8a6a40;"
            + "box-shadow:0 6 14 rgba(0,0,0,0.65)}"
            + "button.rg-card-big{width:210;height:330}"
            + "button.rg-card-tight{width:150}"
            + "button.rg-card-attack{border-color:#c8503a}"
            + "button.rg-card-skill{border-color:#3aa8a2}"
            + "button.rg-card-power{border-color:#9466dc}"
            + "button.rg-card:hover{border-color:#ffd27a;background:linear-gradient(to bottom,#3d2e22,#1a110d);"
            + "box-shadow:0 0 22 rgba(255,170,60,0.7);transform:scale(1.04)}"
            + "button.rg-card:active{transform:scale(0.97);background:#160e0b;box-shadow:0 0 8 rgba(255,140,40,0.5)}"
            + "button.rg-card:focus{border-color:#ffe6a8;box-shadow:0 0 16 rgba(255,210,120,0.75)}"
            + "button.rg-card:disabled{opacity:0.62;border-color:#4a3c30;box-shadow:none;transform:none;"
            + "background:linear-gradient(to bottom,#211915,#0e0a08)}"
            + "stack.rg-card-body{padding:8;gap:5;align-items:stretch}"
            + "stack.rg-card-head{align-items:center;gap:6}"
            + "label.rg-cost{width:32;height:32;border-radius:16;font-size:18;font-weight:700;text-align:center;"
            + "vertical-align:middle;color:#2a1206;background:linear-gradient(to bottom,#ffd77a,#d0761c);"
            + "border:1 #fff0c0;box-shadow:0 0 8 rgba(255,150,40,0.6)}"
            + "label.rg-cost-off{color:#d8c4a8;background:linear-gradient(to bottom,#5a4a3c,#2e241c);"
            + "border:1 #7a6a58;box-shadow:none}"
            + "label.rg-type{font-size:12;letter-spacing:3;text-align:right;flex-grow:1}"
            + "label.rg-type-attack{color:#ff8a6a}"
            + "label.rg-type-skill{color:#6fe0d8}"
            + "label.rg-type-power{color:#c9a2ff}"
            + "image.rg-card-art{width:150;height:124;border-radius:6;border:1 #00000099;background:#0b0807}"
            + "button.rg-card-big image.rg-card-art{width:190;height:156}"
            + "button.rg-card-tight image.rg-card-art{width:130;height:110}"
            + "label.rg-card-name{font-size:20;font-weight:700;color:#ffe9c0;text-align:center}"
            + "button.rg-card-big label.rg-card-name{font-size:22}"
            + "label.rg-card-fx{font-size:14;color:#e6d6bc;text-align:center}"
            + "button.rg-card-big label.rg-card-fx{font-size:15}"
            + "label.rg-card-warn{font-size:12;color:#ff6a50;text-align:center}";
    }

    // 路线：楼层进度珠 + 竖版路线牌。
    static string MapCss() {
        return "label.rg-pip{height:32;padding-left:16;padding-right:16;border-radius:16;font-size:14;"
            + "vertical-align:middle;background:#150f0c;border:1 #4a3526;color:#8a7660}"
            + "label.rg-pip-done{background:#2e2216;border-color:#a07a40;color:#e8c890}"
            + "label.rg-pip-now{background:linear-gradient(to bottom,#ffcc5c,#de7420);color:#2a1206;"
            + "border-color:#ffe2a0;font-weight:700;box-shadow:0 0 14 rgba(255,140,40,0.55)}"
            + "label.rg-pip-link{font-size:14;color:#5e4532}"
            + "stack.rg-node{width:330;align-items:center;background:linear-gradient(to bottom,#2c211a,#130d0b);"
            + "border:2 #6b4a2c;border-radius:14;box-shadow:0 8 22 rgba(0,0,0,0.65)}"
            + "stack.rg-node-elite{border-color:#c0392b;box-shadow:0 0 22 rgba(200,50,30,0.4)}"
            + "stack.rg-node-chest{border-color:#e8b04a;box-shadow:0 0 22 rgba(232,176,74,0.35)}"
            + "stack.rg-node-boss{border-color:#ff5a2a;box-shadow:0 0 30 rgba(255,80,30,0.55)}"
            + "image.rg-node-art{width:230;height:230;border:1 #5e4532;border-radius:10;background:#0b0807}"
            + "label.rg-node-kind{font-size:26;font-weight:700;color:#ffcf6e;text-align:center}"
            + "label.rg-node-elite-kind{color:#ff6450}"
            + "label.rg-node-boss-kind{color:#ff7a3a;text-shadow:0 0 10 rgba(255,80,30,0.7)}"
            + "stack.rg-node button.rg-cta{width:200}";
    }

    // 战斗：左右两块角色石板、中间意图横幅、能量宝珠、底部手牌。
    static string BattleCss() {
        return "stack.rg-actor{width:340;border-top:3 #6fae4a}"
            + "stack.rg-enemy{width:340;border-top:3 #c0392b}"
            + "progress.rg-bar{width:100%}"
            + ".rg-bar .progress-track{height:16;border-radius:8;background:#1a0c0a;border:1 #4a2a20}"
            + ".rg-hp .progress-fill{height:16;border-radius:8;background:linear-gradient(to bottom,#b6e07a,#4f8a2a)}"
            + ".rg-ehp .progress-fill{height:16;border-radius:8;background:linear-gradient(to bottom,#ff7a5a,#a01e14)}"
            + "progress.rg-bar-small{width:130}"
            + ".rg-bar-small .progress-track,.rg-bar-small .progress-fill{height:10;border-radius:5}"
            + "label.rg-status{height:28;padding-left:12;padding-right:12;border-radius:14;font-size:14;"
            + "vertical-align:middle;background:#120d0b;border:1 #4a3526;color:#ecdcc0}"
            + "label.rg-status-block{color:#8fd0ff;border-color:#3a6a90}"
            + "label.rg-status-str{color:#ffcf6e;border-color:#8a6a30}"
            + "label.rg-status-vuln{color:#ff8a6a;border-color:#8a3a2a}"
            + "stack.rg-intent{background:linear-gradient(to bottom,#3a1511,#1a0907);border:2 #c0392b;"
            + "border-radius:12;align-items:center;box-shadow:0 0 22 rgba(200,50,30,0.4)}"
            + "label.rg-intent-num{font-size:40;font-weight:700;color:#ff6450;text-align:center;"
            + "text-shadow:0 0 12 rgba(255,60,30,0.7)}"
            + "stack.rg-energy{width:96;height:96;border-radius:48;align-items:center;justify-content:center;"
            + "background:linear-gradient(to bottom,#ffd36a,#c4561a);border:3 #ffe6a8;"
            + "box-shadow:0 0 24 rgba(255,140,40,0.6)}"
            + "stack.rg-energy-empty{background:linear-gradient(to bottom,#4a3c30,#221a14);border-color:#6a5a48;box-shadow:none}"
            + "label.rg-energy-num{font-size:30;font-weight:700;color:#2a1206;text-align:center}"
            + "label.rg-energy-cap{font-size:12;color:#3a1a06;text-align:center;letter-spacing:2}"
            + "stack.rg-energy-empty label.rg-energy-num,stack.rg-energy-empty label.rg-energy-cap{color:#d8c4a8}"
            + "stack.rg-hand{flex-grow:1;justify-content:center;align-items:center}";
    }
}
