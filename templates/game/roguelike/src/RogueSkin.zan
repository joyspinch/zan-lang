using System;

// 肉鸽爬塔的游戏皮肤：暗色石砌塔 + 熔金 + 余烬橙 + 深红，取自标题图 assets/title.png。
//
// 界面全部是标准控件，这里只给语义类上色——不自绘、不重画控件。整张样式表随 exe
// 内嵌（app.UseCss）。配色约定：熔金 = 可点/重要，余烬 = 当前/可走，深红 = 危险/敌人，
// 青 = 格挡/技能，紫 = 能力/削弱，绿 = 生命/中毒。
//
// 语义类一览（前缀 rg-）：
//   页面    root · topbar · panel(-gold/-danger) · spacer · tile · fx（最上层演出）· toast · gain
//   文字    h1 · sub · h2 · h3 · h3s · text · text-sm · dim · cap · big + 颜色 gold/ember/red/teal/violet/green
//   按钮    btn（石质）· cta（熔金）· chip · danger · asc · opt（房间大选项）
//   卡牌    card + card-attack/skill/power/up/big/tight/shop · cost · type-* · card-art/name/fx/kw · chipcard
//   遗物    relic（顶栏徽章）· relic-card · relic-big · relic-boss
//   地图    map · map-row · map-slot · mnode + mk-<种类> + ms-<状态> · legend-dot · map-side
//   战斗    stage · stage-side · plate · status + st-* · intent + intent-<种类> · energy · pile · hand
public class RogueSkin {
    public static string Css() {
        return RogueSkin.PageCss() + RogueSkin.TextCss() + RogueSkin.ButtonCss()
            + RogueSkin.CardCss() + RogueSkin.RelicCss() + RogueSkin.MapCss()
            + RogueSkin.BattleCss() + RogueSkin.RoomCss();
    }

    static string PageCss() {
        return "window{background:#0b0807}"
            + "stack.rg-root{flex-grow:1;background:linear-gradient(to bottom,#1e1512,#080605)}"
            + "stack.rg-fill{flex-grow:1}"
            + "stack.rg-spacer{flex-grow:1}"
            + "stack.rg-center{align-items:center;justify-content:center}"
            + "stack.rg-mid{align-items:center}"
            + "stack.rg-vcenter{justify-content:center}"
            + "stack.rg-panel{background:linear-gradient(to bottom,#2a1f19,#150f0c);"
            + "border:1 #5e4532;border-radius:12;box-shadow:0 6 18 rgba(0,0,0,0.6)}"
            + "stack.rg-panel-gold{border:2 #c48a36;box-shadow:0 0 22 rgba(232,130,40,0.28)}"
            + "stack.rg-panel-danger{border:2 #c0392b;background:linear-gradient(to bottom,#3a1713,#1a0b09);"
            + "box-shadow:0 0 22 rgba(200,50,30,0.45)}"
            + "stack.rg-topbar{background:linear-gradient(to bottom,#2e2018,#150e0b);"
            + "border:1 #7a5530;border-radius:12;box-shadow:0 4 14 rgba(0,0,0,0.6)}"
            + "stack.rg-tile{flex-grow:1;background:#120d0b;border:1 #4a3526;border-radius:10;"
            + "align-items:center;justify-content:center}"
            + ".rg-fx{position:absolute;left:0;top:0;width:100%;height:100%}"
            + "image.rg-hero-art{width:500;height:500;border:2 #c48a36;border-radius:14;"
            + "box-shadow:0 0 36 rgba(255,140,40,0.35);background:#120d0b}"
            + "image.rg-over-art{width:150;height:150;border:2 #c48a36;border-radius:10;background:#120d0b}"
            + "image.rg-legend-art{width:52;height:52;border:1 #5e4532;border-radius:8;background:#120d0b}"
            + "input.rg-seed{height:44;width:220;background:#0f0b09;border:1 #7a5530;border-radius:8;color:#f6e7cc;font-size:17}"
            + "input.rg-seed:hover{border-color:#e0a04a}"
            + "input.rg-seed:focus{border-color:#ffcf6e;box-shadow:0 0 8 rgba(255,170,60,0.55)}"
            + ".rg-seed input.input-number-input{color:#f6e7cc;font-size:17}"
            + ".rg-seed button.input-number-btn{width:40;color:#e8b04a;background:#1c1410;font-size:18}"
            + ".rg-seed button.input-number-btn:hover:not(:disabled){background:#3a2a1e;color:#ffd27a}"
            + ".rg-seed button.input-number-btn:active:not(:disabled){background:#4a3020}"
            + ".rg-seed button.input-number-minus{border-right:1 #4a3526}"
            + ".rg-seed button.input-number-plus{border-left:1 #4a3526}"
            + "tooltip{background:#1c130f;border:1 #c48a36;border-radius:8;color:#f6e7cc;font-size:13;"
            + "box-shadow:0 6 16 rgba(0,0,0,0.7)}";
    }

    static string TextCss() {
        return "label.rg-h1{font-size:46;font-weight:700;color:#ffcf6e;text-shadow:0 2 14 rgba(255,110,20,0.7)}"
            + "label.rg-sub{font-size:14;color:#e0873a;letter-spacing:5}"
            + "label.rg-h2{font-size:20;font-weight:700;color:#f2c063}"
            + "label.rg-h3{font-size:28;font-weight:700;color:#ffcf6e;text-shadow:0 2 10 rgba(255,110,20,0.6)}"
            + "label.rg-h3s{font-size:17;font-weight:700;color:#f6e0b0}"
            + "label.rg-text{font-size:15;color:#ecdcc0}"
            + "label.rg-text-sm{font-size:13;color:#d8c8ac}"
            + "label.rg-dim{font-size:13;color:#a08b72}"
            + "label.rg-big{font-size:26;font-weight:700;color:#ffcf6e}"
            + "label.rg-cap{font-size:12;color:#a08b72;letter-spacing:2}"
            + "label.rg-center{text-align:center}"
            + "label.rg-gold{color:#ffcf6e}"
            + "label.rg-ember{color:#ff9a4a}"
            + "label.rg-red{color:#ff6450}"
            + "label.rg-teal{color:#6fe0d8}"
            + "label.rg-violet{color:#c9a2ff}"
            + "label.rg-green{color:#9fdc6e}"
            + "label.rg-toast{font-size:14;color:#ffe2a8;background:#2a1c12;border:1 #8a6030;border-radius:8;"
            + "padding-left:10;padding-right:10;padding-top:6;padding-bottom:6}"
            + "label.rg-gain{font-size:18;font-weight:700;border-radius:10;padding-left:14;padding-right:14;"
            + "padding-top:6;padding-bottom:6;background:#1a120e;border:1 #5e4532;color:#ecdcc0}"
            + "label.rg-gain-gold{color:#ffd27a;border-color:#c48a36;box-shadow:0 0 12 rgba(255,170,60,0.35)}"
            + "label.rg-newbest{font-size:19;font-weight:700;color:#2a1206;text-align:center;"
            + "background:linear-gradient(to bottom,#ffd77a,#e0861e);border:1 #fff0c0;border-radius:8;"
            + "padding-top:5;padding-bottom:5;box-shadow:0 0 18 rgba(255,150,40,0.55)}"
            + "label.rg-rarity{font-size:12;letter-spacing:3;color:#a08b72}"
            + "label.rg-rarity-2{color:#6fe0d8}"
            + "label.rg-rarity-3{color:#ffcf6e;text-shadow:0 0 8 rgba(255,170,60,0.7)}";
    }

    static string ButtonCss() {
        return "button.rg-btn,button.rg-cta,button.rg-chip,button.rg-danger{height:42;padding-left:20;padding-right:20;"
            + "font-size:15;border-radius:8;-zan-sheen:0}"
            + "button.rg-btn label.button-caption,button.rg-chip label.button-caption,button.rg-asc label.button-caption{color:#f1e4cc;background:transparent}"
            + "button.rg-cta label.button-caption{color:#2a1206;font-weight:700;background:transparent}"
            + "button.rg-danger label.button-caption{color:#ffe6dc;background:transparent}"
            + "button.rg-btn:disabled label.button-caption,button.rg-chip:disabled label.button-caption,"
            + "button.rg-cta:disabled label.button-caption,button.rg-asc:disabled label.button-caption{color:#7a6a58}"
            + "button.rg-btn,button.rg-chip,button.rg-asc{color:#f1e4cc;background:linear-gradient(to bottom,#3b2b21,#221813);"
            + "border:1 #7a5a3a;box-shadow:0 2 6 rgba(0,0,0,0.5)}"
            + "button.rg-btn:hover,button.rg-chip:hover,button.rg-asc:hover{background:linear-gradient(to bottom,#4c3727,#2f2118);"
            + "border-color:#e0a04a;color:#fff3dc;box-shadow:0 0 10 rgba(255,150,50,0.35)}"
            + "button.rg-btn:active,button.rg-chip:active,button.rg-asc:active{background:#170f0c;border-color:#ff8a3d;box-shadow:none}"
            + "button.rg-btn:focus,button.rg-chip:focus,button.rg-asc:focus{border-color:#ffcf6e;box-shadow:0 0 8 rgba(255,170,60,0.6)}"
            + "button.rg-btn:disabled,button.rg-chip:disabled,button.rg-asc:disabled{color:#6f6152;background:#1a1411;border-color:#3a2c22;box-shadow:none}"
            + "button.rg-chip{height:30;padding-left:12;padding-right:12;font-size:13;border-radius:15}"
            + "button.rg-asc{height:32;min-width:44;padding-left:10;padding-right:10;font-size:14;border-radius:16;-zan-sheen:0}"
            + "button.rg-asc-on{background:linear-gradient(to bottom,#ffd06a,#de7420);border-color:#ffe4a6}"
            + "button.rg-asc-on label.button-caption{color:#2a1206;font-weight:700}"
            + "button.rg-cta{color:#2a1206;font-weight:700;font-size:16;"
            + "background:linear-gradient(to bottom,#ffd06a,#de7420);border:1 #ffe4a6;"
            + "box-shadow:0 0 16 rgba(255,140,40,0.45)}"
            + "button.rg-cta:hover{background:linear-gradient(to bottom,#ffe292,#f08c2c);border-color:#fff3cf;"
            + "color:#1a0a02;box-shadow:0 0 24 rgba(255,160,50,0.7)}"
            + "button.rg-cta:active{background:linear-gradient(to bottom,#d88a2e,#a8501a);border-color:#ffcf6e;box-shadow:none}"
            + "button.rg-cta:focus{border:2 #fff6dc;box-shadow:0 0 18 rgba(255,220,140,0.8)}"
            + "button.rg-cta:disabled{color:#7a6a58;background:#2a211b;border-color:#4a3c30;box-shadow:none}"
            + "button.rg-danger{color:#ffe6dc;background:linear-gradient(to bottom,#8a2a1e,#4e120d);border:1 #d0503a;"
            + "box-shadow:0 0 12 rgba(200,50,30,0.4)}"
            + "button.rg-danger:hover{background:linear-gradient(to bottom,#a8382a,#621a12);border-color:#ff7a5a}"
            + "button.rg-danger:active{background:#3a0d09;box-shadow:none}"
            + "button.rg-danger:focus{border:2 #ffb09a;box-shadow:0 0 12 rgba(255,90,60,0.6)}"
            + "button.rg-big-btn{height:48;font-size:17;padding-left:26;padding-right:26}";
    }

    // 卡牌：整张牌就是一个标准 Button（内容是一列牌面），描边色区分类型，
    // 升级牌描金边、名字转绿；能量不足 = 禁用态（变暗、费用宝石转灰）。
    static string CardCss() {
        return "button.rg-card{width:150;height:212;padding:0;flex-direction:column;align-items:stretch;"
            + "justify-content:flex-start;gap:0;border-radius:12;-zan-sheen:0;"
            + "background:linear-gradient(to bottom,#2e231c,#120c0a);border:2 #8a6a40;"
            + "box-shadow:0 6 14 rgba(0,0,0,0.65)}"
            + "button.rg-card-big{width:180;height:250}"
            + "button.rg-card-shop{width:150;height:212}"
            + "button.rg-card-tight{width:116}"
            + "button.rg-card-attack{border-color:#c8503a}"
            + "button.rg-card-skill{border-color:#3aa8a2}"
            + "button.rg-card-power{border-color:#9466dc}"
            + "button.rg-card-up{box-shadow:0 0 14 rgba(255,210,110,0.45)}"
            + "button.rg-card:hover{border-color:#ffd27a;background:linear-gradient(to bottom,#3d2e22,#1a110d);"
            + "box-shadow:0 0 22 rgba(255,170,60,0.7);transform:translateY(-10) scale(1.05)}"
            + "button.rg-card:active{transform:scale(0.96);background:#160e0b;box-shadow:0 0 8 rgba(255,140,40,0.5)}"
            + "button.rg-card:focus{border-color:#ffe6a8;box-shadow:0 0 16 rgba(255,210,120,0.75)}"
            + "button.rg-card:disabled{opacity:0.55;border-color:#4a3c30;box-shadow:none;transform:none;"
            + "background:linear-gradient(to bottom,#211915,#0e0a08)}"
            + "button.rg-sold{opacity:0.3}"
            + "stack.rg-card-body{padding:7;gap:3;align-items:stretch}"
            + "stack.rg-card-head{align-items:center;gap:6}"
            + "label.rg-cost{width:30;height:30;border-radius:15;font-size:17;font-weight:700;text-align:center;"
            + "vertical-align:middle;color:#2a1206;background:linear-gradient(to bottom,#ffd77a,#d0761c);"
            + "border:1 #fff0c0;box-shadow:0 0 8 rgba(255,150,40,0.6)}"
            + "label.rg-cost-off{color:#d8c4a8;background:linear-gradient(to bottom,#5a4a3c,#2e241c);"
            + "border:1 #7a6a58;box-shadow:none}"
            + "label.rg-cost-sm{width:24;height:24;border-radius:12;font-size:14}"
            + "label.rg-type{font-size:11;letter-spacing:3;text-align:right;flex-grow:1}"
            + "label.rg-type-attack{color:#ff8a6a}"
            + "label.rg-type-skill{color:#6fe0d8}"
            + "label.rg-type-power{color:#c9a2ff}"
            + "image.rg-card-art{width:132;height:92;border-radius:6;border:1 #00000099;background:#0b0807}"
            + "button.rg-card-big image.rg-card-art{width:162;height:104}"
            + "button.rg-card-tight image.rg-card-art{width:98;height:66}"
            + "label.rg-card-name{font-size:17;font-weight:700;color:#ffe9c0;text-align:center}"
            + "label.rg-card-name-up{color:#b6f07a}"
            + "button.rg-card-big label.rg-card-name{font-size:21}"
            + "button.rg-card-tight label.rg-card-name{font-size:14}"
            + "label.rg-card-fx{font-size:13;color:#e6d6bc;text-align:center}"
            + "label.rg-fx-up{color:#9fff7a}"
            + "label.rg-fx-down{color:#ff8a6a}"
            + "button.rg-card-big label.rg-card-fx{font-size:15}"
            + "button.rg-card-tight label.rg-card-fx{font-size:11}"
            + "label.rg-card-kw{font-size:11;letter-spacing:2;color:#e8b04a;text-align:center}"
            + "label.rg-price{font-size:15;font-weight:700;color:#ffd27a}"
            + "label.rg-price-poor{color:#8a6a58}"
            + "label.rg-price-sold{color:#5a4a3c}"
            + "button.rg-chipcard{width:196;height:86;padding:8;border-radius:10;-zan-sheen:0;flex-direction:column;"
            + "align-items:stretch;justify-content:flex-start;background:linear-gradient(to bottom,#2e231c,#140e0b);"
            + "border:2 #8a6a40;box-shadow:0 4 10 rgba(0,0,0,0.55)}"
            + "button.rg-chipcard-attack{border-color:#a8483a}"
            + "button.rg-chipcard-skill{border-color:#2e8a86}"
            + "button.rg-chipcard-power{border-color:#7a56b8}"
            + "button.rg-chipcard:hover{border-color:#ffd27a;box-shadow:0 0 16 rgba(255,170,60,0.6)}"
            + "button.rg-chipcard:active{background:#160e0b}"
            + "button.rg-chipcard:focus{border-color:#ffe6a8}"
            + "stack.rg-chipcard-face{gap:2;align-items:stretch}"
            + "label.rg-chipcard-name{font-size:15;font-weight:700;color:#ffe9c0}"
            + "label.rg-chipcard-fx{font-size:12;color:#d8c8ac}"
            + "label.rg-chipcard-up{font-size:12;color:#9fff7a}";
    }

    // 遗物：顶栏小圆章（悬停提示）、战利品/商店里的大遗物卡。Boss 遗物描红。
    static string RelicCss() {
        return "label.rg-relic{width:30;height:30;border-radius:15;font-size:15;font-weight:700;text-align:center;"
            + "vertical-align:middle;color:#2a1206;background:radial-gradient(circle,#ffe6a0,#c8801e);"
            + "border:1 #fff0c0;box-shadow:0 0 8 rgba(255,160,50,0.5)}"
            + "label.rg-relic:hover{border:2 #ffffff;box-shadow:0 0 14 rgba(255,200,100,0.9)}"
            + "label.rg-relic-boss{background:radial-gradient(circle,#ff9a7a,#a8281e);color:#fff0e0;border-color:#ffc0a0}"
            + "stack.rg-relicbar{gap:6}"
            + "button.rg-relic-card{width:200;height:150;padding:10;border-radius:12;-zan-sheen:0;flex-direction:column;"
            + "align-items:center;justify-content:center;background:linear-gradient(to bottom,#2e231c,#140e0b);"
            + "border:2 #c48a36;box-shadow:0 0 16 rgba(255,160,50,0.3)}"
            + "button.rg-relic-card:hover{border-color:#ffe6a8;box-shadow:0 0 26 rgba(255,190,80,0.7);transform:scale(1.04)}"
            + "button.rg-relic-card:active{transform:scale(0.97)}"
            + "button.rg-relic-card:focus{border-color:#fff3cf}"
            + "button.rg-relic-card:disabled{opacity:0.5;box-shadow:none;transform:none}"
            + "stack.rg-relic-face{align-items:center;gap:4}"
            + "label.rg-relic-big{width:56;height:56;border-radius:28;font-size:28;font-weight:700;text-align:center;"
            + "vertical-align:middle;color:#2a1206;background:radial-gradient(circle,#ffe6a0,#c8801e);"
            + "border:2 #fff0c0;box-shadow:0 0 16 rgba(255,160,50,0.6)}"
            + "label.rg-relic-big.rg-relic-boss{background:radial-gradient(circle,#ff9a7a,#a8281e);color:#fff0e0}";
    }

    // 地图：节点是圆形按钮，种类配色；可走的亮起发光，走过的暗金，锁住的是禁用态。
    static string MapCss() {
        return "stack.rg-map{flex-grow:1;justify-content:space-between;background:linear-gradient(to bottom,#241a14,#120c0a);"
            + "border:1 #5e4532;border-radius:14;box-shadow:inset 0 0 40 rgba(0,0,0,0.8)}"
            + "stack.rg-map-row{justify-content:center;align-items:center}"
            + "stack.rg-map-slot{width:150;height:58;align-items:center;justify-content:center}"
            + "stack.rg-gap{height:2}"
            + "button.rg-mnode{width:50;height:50;border-radius:25;padding:0;font-size:19;font-weight:700;-zan-sheen:0;"
            + "background:radial-gradient(circle,#3a2c22,#1a120e);border:2 #6b4a2c;box-shadow:0 3 8 rgba(0,0,0,0.6)}"
            + "label.rg-mglyph{font-size:19;font-weight:700;color:#e8d8b8;text-align:center;background:transparent}"
            + "label.rg-mglyph-boss{font-size:36}"
            + "button.rg-mnode-boss{width:92;height:92;border-radius:46;font-size:34}"
            + "button.rg-mk-1{border-color:#c0392b}"
            + "button.rg-mk-1 label.rg-mglyph{color:#ff7a5a}"
            + "button.rg-mk-2{border-color:#e8b04a}"
            + "button.rg-mk-2 label.rg-mglyph{color:#ffd27a}"
            + "button.rg-mk-3{border:3 #ff5a2a;background:radial-gradient(circle,#5a1a10,#1e0806)}"
            + "button.rg-mk-3 label.rg-mglyph{color:#ffb080}"
            + "button.rg-mk-4 label.rg-mglyph{color:#6fe0d8}"
            + "button.rg-mk-5{border-color:#c8a040}"
            + "button.rg-mk-5 label.rg-mglyph{color:#ffe08a}"
            + "button.rg-mk-6{border-color:#e0702a}"
            + "button.rg-mk-6 label.rg-mglyph{color:#ffa050}"
            + "button.rg-ms-avail{background:radial-gradient(circle,#6a4428,#2a1a10);border-width:3;"
            + "box-shadow:0 0 18 rgba(255,150,50,0.8)}"
            + "button.rg-ms-avail:hover{transform:scale(1.15);box-shadow:0 0 28 rgba(255,190,80,1.0);border-color:#ffe6a8}"
            + "button.rg-ms-avail:active{transform:scale(0.95)}"
            + "button.rg-ms-avail:focus{border-color:#fff3cf}"
            + "button.rg-ms-done:disabled{opacity:1;background:radial-gradient(circle,#8a6430,#3a2612);border-color:#e8b04a;box-shadow:none}"
            + "button.rg-ms-done:disabled label.rg-mglyph{color:#2a1206}"
            + "button.rg-ms-here:disabled{opacity:1;background:radial-gradient(circle,#ffd27a,#c87020);border:3 #fff3cf;"
            + "box-shadow:0 0 22 rgba(255,200,100,0.9)}"
            + "button.rg-ms-here:disabled label.rg-mglyph{color:#2a1206}"
            + "button.rg-ms-locked:disabled{opacity:0.5;box-shadow:none}"
            + "label.rg-legend-dot{width:26;height:26;border-radius:13;font-size:13;font-weight:700;text-align:center;"
            + "vertical-align:middle;color:#e8d8b8;background:#1a120e;border:2 #6b4a2c}"
            + "label.rg-mk-1{color:#ff7a5a;border-color:#c0392b}"
            + "label.rg-mk-2{color:#ffd27a;border-color:#e8b04a}"
            + "label.rg-mk-3{color:#ffb080;border-color:#ff5a2a}"
            + "label.rg-mk-4{color:#6fe0d8}"
            + "label.rg-mk-5{color:#ffe08a;border-color:#c8a040}"
            + "label.rg-mk-6{color:#ffa050;border-color:#e0702a}"
            + "stack.rg-map-side{width:330}";
    }

    // 战斗：场景面板（画布背景 + 标准控件铭牌）、意图横幅、状态徽章、能量宝珠、牌堆。
    static string BattleCss() {
        return "stack.rg-stage{height:330;border:1 #5e4532;border-radius:14;box-shadow:0 6 18 rgba(0,0,0,0.7)}"
            + "stack.rg-stage-side{width:300}"
            + "stack.rg-plate{background:rgba(16,10,8,0.82);border:1 #5e4532;border-radius:10}"
            + "stack.rg-plate-hero{border-top:3 #6fae4a}"
            + "stack.rg-plate-enemy{border-top:3 #c0392b}"
            + "progress.rg-bar{width:100%}"
            + ".rg-bar .progress-track{height:14;border-radius:7;background:#1a0c0a;border:1 #4a2a20}"
            + ".rg-hp .progress-fill{height:14;border-radius:7;background:linear-gradient(to bottom,#b6e07a,#4f8a2a)}"
            + ".rg-ehp .progress-fill{height:14;border-radius:7;background:linear-gradient(to bottom,#ff7a5a,#a01e14)}"
            + "progress.rg-bar-small{width:120}"
            + ".rg-bar-small .progress-track,.rg-bar-small .progress-fill{height:10;border-radius:5}"
            + "label.rg-tag{font-size:11;font-weight:700;letter-spacing:2;border-radius:6;padding-left:6;padding-right:6;"
            + "padding-top:1;padding-bottom:1}"
            + "label.rg-tag-boss{color:#2a0a04;background:#ff7a3a}"
            + "label.rg-tag-elite{color:#ffe6dc;background:#8a2a1e}"
            + "label.rg-status{height:24;padding-left:8;padding-right:8;border-radius:12;font-size:13;font-weight:700;"
            + "vertical-align:middle;background:#120d0b;border:1 #4a3526;color:#ecdcc0}"
            + "label.rg-st-block{color:#8fd0ff;border-color:#3a6a90}"
            + "label.rg-st-str{color:#ffcf6e;border-color:#8a6a30}"
            + "label.rg-st-weak{color:#d2a8ff;border-color:#5e3a8a}"
            + "label.rg-st-vuln{color:#ff8a6a;border-color:#8a3a2a}"
            + "label.rg-st-poison{color:#9cff6a;border-color:#3a7a2a}"
            + "label.rg-st-thorns{color:#ffa040;border-color:#8a5a2a}"
            + "label.rg-st-power{color:#e0c8ff;border-color:#7a56b8;background:#1e1428}"
            + "label.rg-turn{font-size:12;letter-spacing:3;color:#c8a878;text-align:center;"
            + "background:rgba(16,10,8,0.7);border-radius:10;padding-left:10;padding-right:10;padding-top:2;padding-bottom:2}"
            + "stack.rg-intent{min-width:230;border-radius:12;align-items:center;"
            + "background:linear-gradient(to bottom,rgba(58,21,17,0.92),rgba(26,9,7,0.92));border:2 #c0392b;"
            + "box-shadow:0 0 22 rgba(200,50,30,0.45)}"
            + "stack.rg-intent-defend{border-color:#3a8ad0;background:linear-gradient(to bottom,rgba(16,36,58,0.92),rgba(8,16,28,0.92));"
            + "box-shadow:0 0 22 rgba(60,140,220,0.4)}"
            + "stack.rg-intent-buff{border-color:#e0a030;background:linear-gradient(to bottom,rgba(58,40,12,0.92),rgba(26,16,6,0.92));"
            + "box-shadow:0 0 22 rgba(230,160,40,0.4)}"
            + "stack.rg-intent-debuff{border-color:#9466dc;background:linear-gradient(to bottom,rgba(40,22,58,0.92),rgba(18,10,28,0.92));"
            + "box-shadow:0 0 22 rgba(150,100,220,0.4)}"
            + "label.rg-intent-kind{font-size:18;font-weight:700;color:#ffd8c8;letter-spacing:4}"
            + "label.rg-intent-num{font-size:38;font-weight:700;color:#ff6450;text-shadow:0 0 12 rgba(255,60,30,0.7)}"
            + "label.rg-intent-move{font-size:13;color:#e8d0b8;text-align:center}"
            + "label.rg-victory{font-size:54;font-weight:700;color:#ffd27a;text-shadow:0 0 24 rgba(255,160,40,0.9)}"
            + "label.rg-defeat{font-size:54;font-weight:700;color:#ff5a44;text-shadow:0 0 24 rgba(200,30,20,0.9)}"
            + "stack.rg-strip{height:72}"
            + "stack.rg-energy{width:70;height:70;border-radius:35;align-items:center;justify-content:center;"
            + "background:radial-gradient(circle,#ffe08a,#c4561a);border:3 #ffe6a8;"
            + "box-shadow:0 0 24 rgba(255,140,40,0.7)}"
            + "stack.rg-energy-empty{background:radial-gradient(circle,#4a3c30,#221a14);border-color:#6a5a48;box-shadow:none}"
            + "label.rg-energy-num{font-size:22;font-weight:700;color:#2a1206;text-align:center}"
            + "label.rg-energy-cap{font-size:10;color:#3a1a06;text-align:center;letter-spacing:2}"
            + "stack.rg-energy-empty label.rg-energy-num,stack.rg-energy-empty label.rg-energy-cap{color:#d8c4a8}"
            + "label.rg-pile{height:30;padding-left:12;padding-right:12;border-radius:15;font-size:13;vertical-align:middle;"
            + "color:#ecdcc0;background:#150f0c;border:1 #5e4532}"
            + "stack.rg-hand{flex-grow:1;justify-content:center;align-items:flex-end}";
    }

    // 房间：篝火/奇遇/商店的大选项、奇遇石板、商人栏。
    static string RoomCss() {
        return "button.rg-opt{width:440;height:70;padding-left:18;padding-right:18;border-radius:12;-zan-sheen:0;"
            + "flex-direction:column;align-items:flex-start;justify-content:center;"
            + "background:linear-gradient(to bottom,#3b2b21,#1e1511);border:2 #7a5a3a;box-shadow:0 4 12 rgba(0,0,0,0.6)}"
            + "button.rg-opt:hover{border-color:#ffd27a;background:linear-gradient(to bottom,#4c3727,#2a1d15);"
            + "box-shadow:0 0 20 rgba(255,170,60,0.6);transform:translateX(6)}"
            + "button.rg-opt:active{background:#170f0c;transform:none}"
            + "button.rg-opt:focus{border-color:#ffe6a8}"
            + "button.rg-opt:disabled{opacity:0.45;box-shadow:none;transform:none}"
            + "button.rg-opt-rest{border-color:#6fae4a}"
            + "button.rg-opt-smith{border-color:#e0702a}"
            + "button.rg-opt-remove{width:300;border-color:#c0392b}"
            + "stack.rg-opt-face{gap:2;align-items:flex-start}"
            + "label.rg-opt-title{font-size:19;font-weight:700;color:#ffd27a}"
            + "label.rg-opt-desc{font-size:13;color:#d8c8ac}"
            + "stack.rg-event{width:560}"
            + "button.rg-opt-event{width:516}"
            + "stack.rg-shop-keeper{width:270}";
    }
}
