using System;

// 战斗中的一方（攀登者或敌人）：生命、格挡与全部状态层数。
//
// 引擎的 CardActor 只有格挡/力量/易伤；本作多了中毒、虚弱、荆棘与几种能力，
// 所以战斗单位在模板里自己写，牌堆与牌面定义仍用引擎的 CardDeck / CardDefinition。
// 结算顺序：力量加成 → 虚弱 ×0.75 → 易伤 ×1.5 → 格挡吸收 → 扣血。
public class Fighter {
    public string name;
    public int hp;
    public int maxHp;
    public int block;
    public int strength;
    public int vulnerable;
    public int weakness;
    public int poison;
    public int thorns;
    // 能力：每回合开始 +力量 / 回合结束 +格挡 / 每回合开始给对手施毒 / 每回合多抽
    public int strengthPerTurn;
    public int platingPerTurn;
    public int poisonPerTurn;
    public int drawPerTurn;

    public Fighter(string name, int hp, int maxHp) {
        this.name = name;
        this.maxHp = maxHp < 1 ? 1 : maxHp;
        this.hp = hp > this.maxHp ? this.maxHp : hp;
        if (this.hp < 0) { this.hp = 0; }
    }

    // 一次攻击（一段）的最终伤害：攻击者力量、攻击者虚弱、本方易伤。
    public static int AttackValue(int raw, Fighter attacker, Fighter target) {
        int dmg = raw + attacker.strength;
        if (dmg < 0) { dmg = 0; }
        if (attacker.weakness > 0) { dmg = dmg * 3 / 4; }
        if (target.vulnerable > 0) { dmg = dmg * 3 / 2; }
        return dmg;
    }

    // 承受一段已算好的伤害：先扣格挡再扣血，返回实际掉的血。
    public int Absorb(int dmg) {
        if (dmg < 0) { dmg = 0; }
        int blocked = dmg < this.block ? dmg : this.block;
        this.block = this.block - blocked;
        int lost = dmg - blocked;
        this.hp = this.hp - lost;
        if (this.hp < 0) { this.hp = 0; }
        return lost;
    }

    // 直接失去生命（中毒、自损、反伤）：不经格挡。
    public int LoseHp(int n) {
        if (n <= 0) { return 0; }
        int before = this.hp;
        this.hp = this.hp - n;
        if (this.hp < 0) { this.hp = 0; }
        return before - this.hp;
    }

    public int Heal(int n) {
        if (n <= 0) { return 0; }
        int before = this.hp;
        this.hp = this.hp + n;
        if (this.hp > this.maxHp) { this.hp = this.maxHp; }
        return this.hp - before;
    }

    public void AddBlock(int n) { if (n > 0) { this.block = this.block + n; } }

    // 回合结束：虚弱 / 易伤各 -1。
    public void TickDebuffs() {
        if (this.weakness > 0) { this.weakness = this.weakness - 1; }
        if (this.vulnerable > 0) { this.vulnerable = this.vulnerable - 1; }
    }

    // 回合开始的中毒结算：失去层数的生命，层数 -1；返回掉的血。
    public int TickPoison() {
        if (this.poison <= 0) { return 0; }
        int lost = this.LoseHp(this.poison);
        this.poison = this.poison - 1;
        return lost;
    }

    public bool Alive() { return this.hp > 0; }
}
