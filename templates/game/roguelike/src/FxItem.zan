using System;

// 时间线上的一条演出（见 BattleFx）。
public class FxItem {
    public string kind;
    public int who;
    public int start;
    public int dur;
    public int value;
    public int extra;
    public int color;
    public string text;
    public string text2;
    public int x;
    public int y;
    public int w;
    public int h;

    // 归一化进度：未开始 < 0，播放中 0..1，结束 ≥ 1。
    public double T(int now) {
        if (this.dur <= 0) { return 1.0; }
        return (double)(now - this.start) / (double)this.dur;
    }
}
