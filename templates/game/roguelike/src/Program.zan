using System;
using System.Collections.Generic;
using System.IO;
using Gui;
using Gui.Backend;
using Gui.Widget;
using Game.Cards;
using Game.Foundation;
using Game.Kit;

// 肉鸽爬塔（卡牌构筑）——应用壳与阶段状态机。
//
// 界面全部由标准库控件（Panel / Label / Button / InputNumber / Progress / Image）拼出：
// 任何状态变化都重建整棵控件树（RemoveAll + 重新 With），"界面 = 状态的函数"。
// 外观只走语义类 + 游戏皮肤（RogueSkin.Css，app.UseCss 内嵌进 exe）。
//
// 画布只画"世界"：战斗场景与立绘（BattleStage）、地图连线（MapBoard）、篝火/商人等
// 场景插画（SceneArt）、飞牌与飘字（FxLayer）。它们都是面板的背景层或最上层的演出层，
// 从不重画按钮、血条这类控件。
//
// 规则在 RunFlow（无界面，回放与界面共用）；本类只编排流程、配音效、喂演出时间线。
// 按屏拆成几个分部文件：
//   Program.zan          壳、快捷键、顶栏、控件小工厂、流程推进
//   Program.Menu.zan     主菜单与结算
//   Program.Map.zan      地图
//   Program.Battle.zan   战斗与卡牌
//   Program.Rooms.zan    战利品、篝火、商店、奇遇、选牌
//
// 快捷键：M 静音；Esc 局中弹出"放弃本局？"确认条，结算页回菜单；战斗中 1–9 出牌、E 结束回合。
public partial class Program {
    Form form;
    App app;
    Panel root;

    RunFlow flow;
    RogueShell shell;
    BattleFx fx;
    bool confirmQuit;
    bool endRecorded;
    // 菜单里选的进阶等级。
    int ascension;
    // 战斗刚分出胜负：先在战斗页停一会儿播完击杀演出，再切页（毫秒时间戳，0 = 不停）。
    int holdUntil;
    // 战斗中手牌按钮（飞牌从它们的位置起飞）。
    List<Button> handButtons;
    // 刚升级/移除/获得的提示（选牌、篝火之后在地图页显示一次）。
    string toast;

    // 入口在 src/main.zan（RoguelikeApp.Main）。
    void Run() {
        this.flow = new RunFlow();
        this.shell = new RogueShell();
        this.fx = new BattleFx();
        this.handButtons = new List<Button>();
        this.confirmQuit = false;
        this.endRecorded = false;
        this.ascension = 0;
        this.holdUntil = 0;
        this.toast = "";

        form = Form.CreateDark("肉鸽爬塔 · Roguelike Deckbuilder (Zan)", 1280, 820);
        app = form.GetApp();
        app.UseCss(RogueSkin.Css());
        UiDriver.Enable(app);

        root = Panel.Column();
        root.Class = "rg-root";
        app.OnUnhandledKey((int key) => { this.OnKey(key); });
        root.Pad(14);
        root.Gap(10);
        form.Add(root);
        form.FrameHook(() => { this.PublishProbes(); });
        // 节拍器：战斗收尾的停顿到点后切页（Form.Every 读真实单调钟）。
        form.Every(60, () => { this.Tick(); });

        this.BuildUi();
        form.Run();
    }

    void Tick() {
        if (this.holdUntil != 0 && BattleFx.Now() >= this.holdUntil) {
            this.holdUntil = 0;
            this.fx.Clear();
            this.BuildUi();
        }
    }

    bool Holding() { return this.holdUntil != 0; }

    // ---- 界面重建 --------------------------------------------------------------

    void BuildUi() {
        root.RemoveAll();
        this.handButtons.Clear();
        if (this.confirmQuit) { this.BuildConfirm(); }
        int p = this.flow.phase;
        if (this.Holding() && this.flow.battle != null) { this.BuildBattle(); }
        else if (p == RunFlow.Menu()) { this.BuildMenu(); }
        else if (p == RunFlow.MapPhase()) { this.BuildMap(); }
        else if (p == RunFlow.Fight()) { this.BuildBattle(); }
        else if (p == RunFlow.Loot()) { this.BuildLoot(); }
        else if (p == RunFlow.Camp()) { this.BuildCamp(); }
        else if (p == RunFlow.Store()) { this.BuildShop(); }
        else if (p == RunFlow.Encounter()) { this.BuildEvent(); }
        else if (p == RunFlow.Pick()) { this.BuildPicker(); }
        else { this.BuildOver(); }
        // 演出层永远在最后（最上）。
        FxLayer layer = new FxLayer(this.fx);
        layer.Class = "rg-fx";
        root.With(layer);
        app.RequestRedraw();
    }

    // ---- 快捷键 ----------------------------------------------------------------

    void OnKey(int key) {
        if (key == 77) {
            this.shell.ToggleMute();
            this.BuildUi();
            return;
        }
        if (this.flow.phase == RunFlow.Fight() && !this.confirmQuit && !this.Holding()) {
            if (key >= 49 && key <= 57) { this.PlayCard(key - 49); return; }
            if (key == 69) { this.EndTurn(); return; }
        }
        if (key != 27) { return; }
        if (this.confirmQuit) {
            this.confirmQuit = false;
            this.shell.Play("click");
        } else if (this.flow.phase == RunFlow.Over()) {
            this.GoMenu();
            return;
        } else if (this.flow.phase != RunFlow.Menu()) {
            this.confirmQuit = true;
            this.shell.Play("click");
        } else {
            return;
        }
        this.BuildUi();
    }

    // 局中 Esc 的确认条：继续 / 放弃回菜单。
    void BuildConfirm() {
        Panel bar = this.Row("rg-panel rg-panel-danger rg-mid");
        bar.Pad(12);
        bar.Gap(14);
        Panel words = this.Col("rg-fill");
        words.Gap(2);
        words.With(this.Txt("放弃本局并回到主菜单？", "rg-h2 rg-red"));
        words.With(this.Txt("本局进度不会保存；战绩里的开局次数照记。", "rg-dim"));
        bar.With(words);
        Button stay = new Button("继续爬塔（Esc）");
        stay.Class = "rg-cta";
        stay.OnClick(() => { this.confirmQuit = false; this.shell.Play("click"); this.BuildUi(); });
        bar.With(stay);
        Button leave = new Button("放弃本局");
        leave.Class = "rg-danger";
        leave.OnClick(() => { this.GoMenu(); });
        bar.With(leave);
        root.With(bar);
    }

    void GoMenu() {
        this.confirmQuit = false;
        this.holdUntil = 0;
        this.fx.Clear();
        this.flow.phase = RunFlow.Menu();
        this.shell.Play("click");
        this.BuildUi();
    }

    Button MuteButton() {
        Button b = new Button(this.shell.Muted() ? "音效 关" : "音效 开");
        b.Class = "rg-chip";
        b.Tip = "切换音效（快捷键 M）";
        b.OnClick(() => { this.shell.ToggleMute(); this.BuildUi(); });
        return b;
    }

    // 自动化探针（ZAN_UI_SCRIPT 驱动时才发布）。
    void PublishProbes() {
        if (!UiDriver.Active()) { return; }
        UiDriver.SetProbe("rogue.phase", Convert.ToString(this.flow.phase));
        UiDriver.SetProbe("rogue.confirm", this.confirmQuit ? "1" : "0");
        UiDriver.SetProbe("rogue.muted", this.shell.Muted() ? "1" : "0");
        UiDriver.SetProbe("rogue.runs", Convert.ToString(this.shell.Runs()));
        UiDriver.SetProbe("rogue.bestFloor", Convert.ToString(this.shell.BestFloor()));
        UiDriver.SetProbe("rogue.newBest", (this.shell.NewBestFloor() ? "floor " : "")
            + (this.shell.NewFastest() ? "fastest" : ""));
        if (this.flow.run != null) {
            UiDriver.SetProbe("rogue.act", Convert.ToString(this.flow.run.act));
            UiDriver.SetProbe("rogue.hp", Convert.ToString(this.flow.run.hp));
            UiDriver.SetProbe("rogue.gold", Convert.ToString(this.flow.run.gold));
            UiDriver.SetProbe("rogue.deck", Convert.ToString(this.flow.run.deck.Count));
        }
    }

    // ---- 控件小工厂（只挂语义类，外观全在 RogueSkin） ---------------------------

    Panel Col(string cls) {
        Panel p = Panel.Column();
        if (cls != "") { p.Class = cls; }
        return p;
    }

    Panel Row(string cls) {
        Panel p = Panel.Row();
        if (cls != "") { p.Class = cls; }
        return p;
    }

    Label Txt(string text, string cls) {
        Label l = new Label(text);
        l.Class = cls;
        return l;
    }

    // 会自动换行的说明文字。
    Label Para(string text, string cls) {
        Label l = new Label(text);
        l.Class = cls;
        l.SetWrap(true);
        return l;
    }

    Panel Spacer() { return this.Row("rg-spacer"); }

    Progress Bar(int value, int max, string cls) {
        int pct = max > 0 ? value * 100 / max : 0;
        if (pct < 0) { pct = 0; }
        if (pct > 100) { pct = 100; }
        Progress p = new Progress(pct, 1);
        p.IsShowText = false;
        p.SwitchClass("rg-bar", true);
        p.SwitchClass(cls, true);
        return p;
    }

    Panel Tile(string value, string caption, string valueCls) {
        Panel t = this.Col("rg-tile");
        t.Pad(8);
        t.Gap(2);
        t.With(this.Txt(value, "rg-big rg-center " + valueCls));
        t.With(this.Txt(caption, "rg-cap rg-center"));
        return t;
    }

    Image Art(string rel, string alt, string cls) {
        string path = this.ArtPath(rel);
        if (path == "") { return null; }
        Image img = new Image(path, alt, "cover");
        img.Class = cls;
        return img;
    }

    // 素材定位：磁盘（exe 目录向上找）优先，其次编译期内嵌；都没有返回空串。
    string ArtPath(string rel) {
        if (rel == null || rel == "") { return ""; }
        string p = Assets.Find(rel);
        if (p != null && File.Exists(p)) { return p; }
        if (File.EmbedExists(rel)) { return rel; }
        return "";
    }

    // 遗物徽章：单字圆章 + 悬停提示（名字与效果）。Boss 遗物描红边。
    Label RelicBadge(string id, string extraCls) {
        Label l = new Label(this.flow.relicBook.Glyph(id));
        l.Class = "rg-relic" + (this.flow.relicBook.Tier(id) == RelicBook.BossTier() ? " rg-relic-boss" : "")
            + (extraCls != "" ? " " + extraCls : "");
        l.Tip = this.flow.relicBook.Name(id) + "：" + this.flow.relicBook.Desc(id);
        return l;
    }

    // ---- 顶栏：位置 / 生命 / 金币 / 牌组 / 遗物栏 / 种子 / 静音 ---------------------

    void BuildTopBar(string title) {
        RunState r = this.flow.run;
        Panel bar = this.Row("rg-topbar rg-mid");
        bar.Pad(10);
        bar.Gap(16);
        Panel place = this.Col("");
        place.With(this.Txt(title, "rg-h2"));
        place.With(this.Txt("第 " + r.act + " 幕 · 第 " + r.floors + " 层" + (r.Ascension() > 0 ? " · 进阶 " + r.Ascension() : ""), "rg-cap"));
        bar.With(place);
        Panel hp = this.Row("rg-mid");
        hp.Gap(8);
        hp.With(this.Txt("生命", "rg-dim"));
        hp.With(this.Bar(r.hp, r.maxHp, "rg-hp rg-bar-small"));
        hp.With(this.Txt(r.hp + "/" + r.maxHp, "rg-text rg-green"));
        hp.Tip = "生命：归零即本局结束。篝火休息、奇遇、余烬之血可以回复。";
        bar.With(hp);
        Label gold = this.Txt("金币 " + r.gold, "rg-text rg-gold");
        gold.Tip = "金币：在商店买牌、买遗物、删牌。";
        bar.With(gold);
        Label deck = this.Txt("牌组 " + r.deck.Count, "rg-text");
        deck.Tip = this.DeckSummary();
        bar.With(deck);
        Panel relics = this.Row("rg-relicbar rg-mid");
        relics.Gap(6);
        for (int i = 0; i < r.relics.Count; i = i + 1) { relics.With(this.RelicBadge(r.relics[i], "")); }
        bar.With(relics);
        bar.With(this.Spacer());
        bar.With(this.Txt("种子 " + r.Seed(), "rg-dim"));
        bar.With(this.MuteButton());
        root.With(bar);
    }

    // 牌组构成（悬停提示用）：按分类计数，列出升级过的牌。
    string DeckSummary() {
        List<string> deck = this.flow.run.deck;
        int atk = 0;
        int skl = 0;
        int pow = 0;
        int up = 0;
        for (int i = 0; i < deck.Count; i = i + 1) {
            CardDefinition d = this.flow.library.Find(deck[i]);
            if (d.Category() == "attack") { atk = atk + 1; }
            else if (d.Category() == "skill") { skl = skl + 1; }
            else { pow = pow + 1; }
            if (CardLibrary.IsUpgraded(deck[i])) { up = up + 1; }
        }
        return "攻击 " + atk + " · 技能 " + skl + " · 能力 " + pow + "\n已升级 " + up + " 张";
    }

    // ---- 流程推进（规则在 RunFlow，这里推进后配音效、喂演出、重建界面） ---------

    void StartRun(int seed) {
        this.flow.StartRun(seed, this.ascension);
        this.DebugWarp();
        this.shell.BeginRun();
        this.shell.Play("click");
        this.confirmQuit = false;
        this.endRecorded = false;
        this.holdUntil = 0;
        this.toast = "";
        this.fx.Clear();
        this.BuildUi();
    }

    void EnterNode(MapNode node) {
        int prev = this.flow.phase;
        this.toast = "";
        this.flow.EnterNode(node);
        int k = node.kind;
        if (k == MapNode.Treasure() || k == MapNode.Shop()) { this.shell.Play("coin"); }
        else if (k == MapNode.Campfire()) { this.shell.Play("heal", 0.6); }
        else { this.shell.Play("click"); }
        if (this.flow.phase == RunFlow.Fight()) {
            this.fx.Clear();
            this.shell.SeeEnemy(this.flow.battle.def.id);
            this.fx.Feed(this.flow.battle.events, 350);
        }
        this.AfterStep(prev);
    }

    void PlayCard(int index) {
        if (this.flow.battle == null || this.Holding()) { return; }
        CardZone hand = this.flow.battle.Hand();
        if (index < 0 || index >= hand.Count()) { return; }
        CardDefinition d = hand.At(index).Definition();
        Button src = index < this.handButtons.Count ? this.handButtons[index] : null;
        int prev = this.flow.phase;
        this.flow.PlayCard(index);
        if (!this.flow.lastPlayOk) {
            this.shell.Play("error");
            return;
        }
        int target = this.TargetsEnemy(d) ? 1 : 0;
        if (src != null && src.bw > 0) {
            this.fx.Fly(d.Name(), d.Category(), src.bx, src.by, src.bw, src.bh, target, d.Cost());
        }
        this.fx.Feed(this.flow.battle.events, src != null ? 260 : 60);
        this.PlayBattleSounds(d);
        this.AfterStep(prev);
    }

    bool TargetsEnemy(CardDefinition d) {
        for (int i = 0; i < d.EffectCount(); i = i + 1) {
            if (d.EffectAt(i).Target() == CardTarget.Enemy()) { return true; }
        }
        return false;
    }

    // 出牌音效：按牌型与结果挑——攻击（重击更沉）、格挡、能力、削弱、回血。
    void PlayBattleSounds(CardDefinition d) {
        this.shell.Play("select");
        int dmg = 0;
        bool block = false;
        bool hex = false;
        bool heal = false;
        List<BattleEvent> ev = this.flow.battle.events;
        for (int i = 0; i < ev.Count; i = i + 1) {
            BattleEvent e = ev[i];
            if (e.kind == "hit" && e.who == 1) { dmg = dmg + e.amount + e.extra; }
            if (e.kind == "block") { block = true; }
            if (e.kind == "debuff") { hex = true; }
            if (e.kind == "heal" && e.amount > 0) { heal = true; }
        }
        if (d.Category() == "power") { this.shell.Play("power"); }
        if (dmg >= 15) { this.shell.Play("heavy"); } else if (dmg > 0) { this.shell.Play("hit"); }
        if (block) { this.shell.Play("block"); }
        if (hex) { this.shell.Play("hex", 0.7); }
        if (heal) { this.shell.Play("heal"); }
    }

    void EndTurn() {
        if (this.flow.battle == null || this.Holding()) { return; }
        int prev = this.flow.phase;
        int hp = this.flow.battle.player.hp;
        this.flow.EndTurn();
        this.fx.Feed(this.flow.battle.events, 120);
        if (this.flow.battle.player.hp < hp) { this.shell.Play("hit", 0.85); }
        else { this.shell.Play("block", 0.7); }
        this.AfterStep(prev);
    }

    // 阶段切换：战斗结束先停在战斗页播完击杀，再切；结算只记一次档案。
    void AfterStep(int prev) {
        int now = this.flow.phase;
        if (prev == RunFlow.Fight() && now != RunFlow.Fight() && this.flow.battle != null) {
            this.holdUntil = BattleFx.Now() + 1300;
            if (this.flow.battle.winner == 0) { this.shell.Play("explode"); }
        }
        if (now == RunFlow.Over() && !this.endRecorded) {
            this.endRecorded = true;
            this.confirmQuit = false;
            this.shell.EndRun(this.flow.runWon, this.flow.run.floors, this.flow.turnsTaken, this.flow.run.Ascension());
            this.shell.Play(this.flow.runWon ? "success" : "fail");
        }
        this.BuildUi();
    }

    // 调试跳关：ROGUE_DEBUG=<幕>:<节点种类>（如 3:3 = 第 3 幕 Boss，1:5 = 商店），默认关闭。
    void DebugWarp() {
        string dbg = Environment.GetEnvironmentVariable("ROGUE_DEBUG");
        if (dbg == null || dbg.Length < 3 || dbg.Substring(1, 1) != ":") { return; }
        int act = Convert.ToInt32(dbg.Substring(0, 1));
        int kind = Convert.ToInt32(dbg.Substring(2, dbg.Length - 2));
        this.flow.DebugWarp(act, kind);
        if (this.flow.phase == RunFlow.Fight()) { this.fx.Feed(this.flow.battle.events, 350); }
    }

    // ---- 种子 ------------------------------------------------------------------

    int DefaultSeed() {
        if (this.flow.run != null) { return this.flow.run.Seed(); }
        return 20260101;
    }

    int RandomSeed() {
        int seed = Window.GetTickMs() % 999999999;
        if (seed <= 0) { seed = 1; }
        return seed;
    }
}
