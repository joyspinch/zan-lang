using System;
using System.Collections.Generic;
using Gui;
using Gui.Backend;
using Gui.Widget;

// 场景插画（世界层）：篝火、宝箱、商人、奇遇祭坛这类房间的主视觉。
// 只画一张程序化 SVG + 底光，篝火再加摇曳的光晕与上飘火星；不接收点击。
public class SceneArt : Control {
    string look;
    int size;

    public SceneArt(string look, int size) {
        InitControl("SceneArt");
        this.look = look;
        this.size = size;
    }

    public override string Kind() { return "SceneArt"; }

    public override void OnMeasure(App app) { prefW = this.size; prefH = this.size * 220 / 200; }

    protected override Control HitTestCore(int x, int y, int pointerType, List<Control> excludedSubtrees) { return null; }

    public override void OnPaint(App app) {
        Canvas c = app.canvas;
        if (bw <= 0 || bh <= 0) { return; }
        int now = Window.GetTickMs();
        int w = this.size;
        int h = this.size * 220 / 200;
        int x = bx + (bw - w) / 2;
        int y = by + (bh - h) / 2;
        int glow = this.look == "altar" ? (int)0xFF4ADCD0 : (int)0xFFFF8A2A;
        double flick = Math.Sin(now * 0.011) * 0.5 + Math.Sin(now * 0.029) * 0.5;
        bool fire = this.look == "campfire";
        c.FillRadial(x + w / 2, y + h * 2 / 3, w * 2 / 3 + (fire ? (int)(flick * 12.0) : 0), glow, fire ? 120 : 70);
        c.BlitImage(BattleStage.Sprite(this.look, false, w, h), x, y, w, h, 0, 0, 0, 0);
        if (fire) {
            for (int i = 0; i < 14; i = i + 1) {
                int period = 1300 + (i * 211) % 900;
                double t = (double)((now + i * 313) % period) / (double)period;
                int px = x + w / 2 + (int)(Math.Sin(t * 5.0 + i) * (double)(w / 6));
                int py = y + h * 3 / 4 - (int)(t * (double)h * 0.8);
                int a = (int)((1.0 - t) * 230.0);
                c.FillCircle(px, py, 2 + i % 3, (a << 24) | 0xFFB040);
            }
            app.RequestAnimationFrame(40);
        }
    }
}
