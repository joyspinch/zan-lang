using System;
using System.Collections.Generic;
using Game.Cards;

// 卡牌目录：肉鸽卡牌的全部牌面定义、起始牌组与奖励池。
//
// 牌面只在这里定义一次 —— 起始牌组、战斗牌堆、战后奖励三处共用同一批
// CardDefinition。因此"加一张新牌"= 加一条定义 + 决定它进不进奖励池，
// 不需要在别处登记。
//
// CardDefinition 是不可变模板：一次定义可以被 CardDeck 实例化成多张卡
// （CardInstance 带独立的升级等级与保留标记），所以牌组里存的是卡 id
// 而不是卡对象——一局打完，卡组是可以被存档/读档的纯数据。
public class CardLibrary {
    CardCatalog catalog;
    List<string> rewardPool;
    List<string> starterDeck;

    CardLibrary() {
        this.catalog = new CardCatalog();
        this.rewardPool = new List<string>();
        this.starterDeck = new List<string>();
        this.Build();
    }

    void Build() {
        // ---- 攻击牌 ----
        CardDefinition strike = new CardDefinition("strike", "打击", 1, "attack")
            .AddEffect(CardEffectKind.Damage(), 6, CardTarget.Enemy());
        CardDefinition heavy = new CardDefinition("heavy", "重击", 2, "attack")
            .AddEffect(CardEffectKind.Damage(), 14, CardTarget.Enemy());
        CardDefinition drain = new CardDefinition("drain", "汲取", 1, "attack")
            .AddEffect(CardEffectKind.Damage(), 4, CardTarget.Enemy())
            .AddEffect(CardEffectKind.Heal(), 3, CardTarget.Self());

        // ---- 防御牌 ----
        CardDefinition guard = new CardDefinition("guard", "防御", 1, "skill")
            .AddEffect(CardEffectKind.Block(), 5, CardTarget.Self());
        CardDefinition brand = new CardDefinition("brand", "破甲", 1, "skill")
            .AddEffect(CardEffectKind.Vulnerable(), 2, CardTarget.Enemy());
        CardDefinition mend = new CardDefinition("mend", "治疗", 1, "skill")
            .AddEffect(CardEffectKind.Heal(), 6, CardTarget.Self());

        // ---- 能力牌 ----
        CardDefinition focus = new CardDefinition("focus", "蓄力", 1, "power")
            .AddEffect(CardEffectKind.Strength(), 2, CardTarget.Self());
        CardDefinition surge = new CardDefinition("surge", "疾风", 0, "skill")
            .AddEffect(CardEffectKind.Draw(), 2, CardTarget.Self());
        CardDefinition fury = new CardDefinition("fury", "狂怒", 2, "power")
            .AddEffect(CardEffectKind.Energy(), 1, CardTarget.Self())
            .AddEffect(CardEffectKind.Draw(), 1, CardTarget.Self());

        this.catalog.Add(strike);
        this.catalog.Add(heavy);
        this.catalog.Add(drain);
        this.catalog.Add(guard);
        this.catalog.Add(brand);
        this.catalog.Add(mend);
        this.catalog.Add(focus);
        this.catalog.Add(surge);
        this.catalog.Add(fury);

        // 奖励池：战后三选一从这里抽（抽到什么由 run 的随机源决定）。
        this.rewardPool.Add("heavy");
        this.rewardPool.Add("drain");
        this.rewardPool.Add("brand");
        this.rewardPool.Add("mend");
        this.rewardPool.Add("focus");
        this.rewardPool.Add("surge");
        this.rewardPool.Add("fury");

        // 起始牌组：10 张。肉鸽的构筑乐趣来自"牌少但每张都有用"，
        // 所以起手不给稀有牌——强度靠后续的层间选择积累。
        for (int i = 0; i < 4; i = i + 1) { this.starterDeck.Add("strike"); }
        for (int i = 0; i < 4; i = i + 1) { this.starterDeck.Add("guard"); }
        this.starterDeck.Add("focus");
        this.starterDeck.Add("strike");
    }

    // 按 id 找牌面定义：未找到返回 null。
    CardDefinition Find(string id) { return this.catalog.Find(id); }

    // 奖励池大小。
    int RewardCount() { return this.rewardPool.Count; }
    // 奖励池第 index 个卡 id。
    string RewardAt(int index) { return this.rewardPool[index]; }

    // 起始牌组大小。
    int StarterCount() { return this.starterDeck.Count; }
    // 起始牌组第 index 张的卡 id。
    string StarterAt(int index) { return this.starterDeck[index]; }
}
