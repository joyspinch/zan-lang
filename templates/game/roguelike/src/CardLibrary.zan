using System;
using System.Collections.Generic;
using Game.Cards;

// 卡牌目录：全部牌面定义（含升级版）、稀有度、起始牌组、奖励池与牌面文案。
//
// 每张牌一行：Add(id, 名字, 分类, 稀有度, 费用, 效果, 升级费用, 升级效果)。
// 效果用一串空格分隔的小记号写成，读起来像牌面本身：
//   d6 造成 6 伤害（写两次 = 两段攻击）  b5 格挡 5   h3 回复 3     c2 抽 2 张
//   e1 能量 +1        s2 力量 +2         v2 易伤 2    w1 虚弱 1     p3 中毒 3
//   B  造成等同格挡的伤害   L3 失去 3 生命   P 中毒翻倍
//   X  消耗（打出后移出本场）   R 保留（回合结束不弃）
//   能力（本场持续）：S2 每回合 +2 力量 · M3 回合结束 +3 格挡 · N3 每回合施毒 3
//                     D1 每回合多抽 1 · T3 受击反伤 3
// 升级版自动登记为 "<id>+"、名字带 "+"，于是牌组仍是一串卡 id（纯数据），
// 升级 = 把 "strike" 换成 "strike+"，存档、回放、哈希都不用知道"升级"这回事。
public class CardLibrary {
    public static int Basic() { return 0; }
    public static int Common() { return 1; }
    public static int Uncommon() { return 2; }
    public static int Rare() { return 3; }

    CardCatalog catalog;
    List<string> ids;
    List<int> rarities;
    List<string> starterDeck;

    CardLibrary() {
        this.catalog = new CardCatalog();
        this.ids = new List<string>();
        this.rarities = new List<int>();
        this.starterDeck = new List<string>();
        this.Build();
    }

    void Build() {
        int B = CardLibrary.Basic();
        int C = CardLibrary.Common();
        int U = CardLibrary.Uncommon();
        int R = CardLibrary.Rare();
        // ---- 起手 ----
        this.Add("strike", "打击", "attack", B, 1, "d6", 1, "d9");
        this.Add("guard", "防御", "skill", B, 1, "b5", 1, "b8");
        this.Add("bash", "痛击", "attack", B, 2, "d8 v2", 2, "d11 v3");
        // ---- 攻击 ----
        this.Add("twin", "双刃", "attack", C, 1, "d5 d5", 1, "d7 d7");
        this.Add("venom", "毒刃", "attack", C, 1, "d4 p3", 1, "d6 p5");
        this.Add("daze", "震击", "attack", C, 1, "d7 w1", 1, "d10 w2");
        this.Add("quick", "快斩", "attack", C, 0, "d4 c1", 0, "d7 c1");
        this.Add("slam", "盾击", "attack", C, 1, "B", 0, "B");
        this.Add("drain", "汲取", "attack", C, 1, "d6 h2", 1, "d8 h3");
        this.Add("sunder", "破甲斩", "attack", C, 1, "d4 v2", 1, "d6 v3");
        this.Add("heavy", "重击", "attack", U, 2, "d15", 2, "d20");
        this.Add("flurry", "连斩", "attack", U, 2, "d3 d3 d3 d3", 2, "d4 d4 d4 d4");
        this.Add("bloodblade", "血刃", "attack", U, 1, "L3 d13", 1, "L3 d18");
        this.Add("judgement", "裁决", "attack", R, 2, "d24 X", 2, "d32 X");
        // ---- 技能 ----
        this.Add("parry", "招架", "skill", C, 1, "b6 c1", 1, "b9 c1");
        this.Add("ironwall", "铁壁", "skill", C, 2, "b13", 2, "b18");
        this.Add("toxin", "毒雾", "skill", C, 1, "p6", 1, "p9");
        this.Add("hold", "坚守", "skill", C, 1, "b8 R", 1, "b11 R");
        this.Add("surge", "疾风", "skill", C, 0, "c2 X", 0, "c3 X");
        this.Add("hex", "诅咒", "skill", U, 1, "w2 v2", 0, "w2 v2");
        this.Add("mend", "治疗", "skill", U, 1, "h6 X", 1, "h9 X");
        this.Add("offering", "献祭", "skill", U, 0, "L4 e2 c2 X", 0, "L4 e2 c3 X");
        this.Add("catalyst", "催化", "skill", U, 1, "P X", 1, "P");
        this.Add("rally", "激励", "skill", U, 0, "e1 c1 X", 0, "e2 c1 X");
        this.Add("laststand", "破釜沉舟", "skill", R, 1, "e3 X", 0, "e3 X");
        this.Add("aegis", "圣盾", "skill", R, 2, "b20 w2 X", 2, "b26 w3 X");
        // ---- 能力 ----
        this.Add("focus", "蓄力", "power", C, 1, "s2", 1, "s3");
        this.Add("plating", "金属化", "power", C, 1, "M3", 1, "M5");
        this.Add("thorns", "荆棘", "power", C, 1, "T3", 1, "T5");
        this.Add("noxious", "剧毒", "power", U, 2, "N3", 2, "N4");
        this.Add("insight", "灵感", "power", U, 1, "D1", 0, "D1");
        this.Add("demon", "恶魔形态", "power", R, 3, "S2", 3, "S3");

        // 起始牌组：10 张，起手不给稀有牌——强度靠一路上的选择积累。
        for (int i = 0; i < 5; i = i + 1) { this.starterDeck.Add("strike"); }
        for (int i = 0; i < 4; i = i + 1) { this.starterDeck.Add("guard"); }
        this.starterDeck.Add("bash");
    }

    // 登记一张牌的基础版与升级版（"<id>+"）。
    void Add(string id, string name, string category, int rarity,
             int cost, string spec, int costUp, string specUp) {
        string art = "assets/cards/" + category + ".png";
        this.catalog.Add(CardLibrary.Parse(new CardDefinition(id, name, cost, category).SetArt(art), spec));
        this.catalog.Add(CardLibrary.Parse(new CardDefinition(id + "+", name + "+", costUp, category).SetArt(art), specUp));
        this.ids.Add(id);
        this.rarities.Add(rarity);
    }

    // 把效果记号串挂到定义上（见文件头的记号表）。
    static CardDefinition Parse(CardDefinition def, string spec) {
        int enemy = CardTarget.Enemy();
        int self = CardTarget.Self();
        int i = 0;
        while (i < spec.Length) {
            int end = i;
            while (end < spec.Length && spec.Substring(end, 1) != " ") { end = end + 1; }
            if (end > i) {
                string code = spec.Substring(i, 1);
                int n = end - i > 1 ? Convert.ToInt32(spec.Substring(i + 1, end - i - 1)) : 1;
                if (code == "d") { def.AddEffect(CardFx.Damage(), n, enemy); }
                else if (code == "b") { def.AddEffect(CardFx.Block(), n, self); }
                else if (code == "h") { def.AddEffect(CardFx.Heal(), n, self); }
                else if (code == "c") { def.AddEffect(CardFx.Draw(), n, self); }
                else if (code == "e") { def.AddEffect(CardFx.Energy(), n, self); }
                else if (code == "s") { def.AddEffect(CardFx.Strength(), n, self); }
                else if (code == "v") { def.AddEffect(CardFx.Vulnerable(), n, enemy); }
                else if (code == "w") { def.AddEffect(CardFx.Weak(), n, enemy); }
                else if (code == "p") { def.AddEffect(CardFx.Poison(), n, enemy); }
                else if (code == "B") { def.AddEffect(CardFx.BlockDamage(), 0, enemy); }
                else if (code == "L") { def.AddEffect(CardFx.LoseHp(), n, self); }
                else if (code == "P") { def.AddEffect(CardFx.DoublePoison(), 1, enemy); }
                else if (code == "X") { def.AddEffect(CardFx.Exhaust(), 1, self); }
                else if (code == "R") { def.AddEffect(CardFx.Retain(), 1, self); }
                else if (code == "S") { def.AddEffect(CardFx.PowerStrength(), n, self); }
                else if (code == "M") { def.AddEffect(CardFx.PowerPlating(), n, self); }
                else if (code == "N") { def.AddEffect(CardFx.PowerPoison(), n, self); }
                else if (code == "D") { def.AddEffect(CardFx.PowerDraw(), n, self); }
                else if (code == "T") { def.AddEffect(CardFx.PowerThorns(), n, self); }
            }
            i = end + 1;
        }
        return def;
    }

    // ---- 查询 ----------------------------------------------------------------

    // 按 id 找牌面定义（"<id>+" 是升级版）：未找到返回 null。
    CardDefinition Find(string id) { return this.catalog.Find(id); }

    // 基础牌种数（不含升级版）与第 i 种的 id。
    int KindCount() { return this.ids.Count; }
    string KindAt(int i) { return this.ids[i]; }

    // 稀有度（升级版与基础版相同）。
    int RarityOf(string id) {
        string baseId = CardLibrary.BaseId(id);
        for (int i = 0; i < this.ids.Count; i = i + 1) {
            if (this.ids[i] == baseId) { return this.rarities[i]; }
        }
        return CardLibrary.Basic();
    }

    static bool IsUpgraded(string id) { return id.EndsWith("+"); }
    static string BaseId(string id) { return id.EndsWith("+") ? id.Substring(0, id.Length - 1) : id; }
    static string UpgradeOf(string id) { return id.EndsWith("+") ? id : id + "+"; }

    // 是否带某个关键词效果（消耗 / 保留 / 能力种类……）。
    static bool Has(CardDefinition def, int kind) {
        for (int i = 0; i < def.EffectCount(); i = i + 1) {
            if (def.EffectAt(i).Kind() == kind) { return true; }
        }
        return false;
    }

    // 第一条某种效果的数值（没有返回 0）——机器人与界面估值用。
    static int Amount(CardDefinition def, int kind) {
        int total = 0;
        for (int i = 0; i < def.EffectCount(); i = i + 1) {
            if (def.EffectAt(i).Kind() == kind) { total = total + def.EffectAt(i).Amount(); }
        }
        return total;
    }

    // 商店标价：按稀有度，升级版加价。
    int Price(string id) {
        int r = this.RarityOf(id);
        int p = r == CardLibrary.Rare() ? 140 : (r == CardLibrary.Uncommon() ? 75 : 50);
        if (CardLibrary.IsUpgraded(id)) { p = p + 25; }
        return p;
    }

    // 按稀有度权重抽一种可奖励的牌（不含起手基础牌）。
    // rareBias 越大越容易出稀有（精英/Boss 奖励用）。roll 由调用方从本局随机源取，
    // 这样随机源始终只有 RunState 一处。
    string PickReward(int roll100, int pick) {
        int rare = CardLibrary.Common();
        if (roll100 >= 60) { rare = CardLibrary.Uncommon(); }
        if (roll100 >= 92) { rare = CardLibrary.Rare(); }
        int count = 0;
        for (int i = 0; i < this.ids.Count; i = i + 1) {
            if (this.rarities[i] == rare) { count = count + 1; }
        }
        int want = count > 0 ? pick % count : 0;
        for (int i = 0; i < this.ids.Count; i = i + 1) {
            if (this.rarities[i] == rare) {
                if (want == 0) { return this.ids[i]; }
                want = want - 1;
            }
        }
        return "strike";
    }

    int StarterCount() { return this.starterDeck.Count; }
    string StarterAt(int index) { return this.starterDeck[index]; }

    // ---- 牌面文案（界面与回放共用同一份效果表） ------------------------------

    // 效果逐行文案：同数值的连续攻击合并成 "造成 5 伤害 ×2"；关键词另起一行（Keywords）。
    static List<string> Describe(CardDefinition def) {
        List<string> lines = new List<string>();
        int i = 0;
        while (i < def.EffectCount()) {
            CardEffect fx = def.EffectAt(i);
            int k = fx.Kind();
            int n = fx.Amount();
            if (k == CardFx.Damage()) {
                int hits = 1;
                while (i + hits < def.EffectCount() && def.EffectAt(i + hits).Kind() == k
                       && def.EffectAt(i + hits).Amount() == n) {
                    hits = hits + 1;
                }
                lines.Add("造成 " + n + " 伤害" + (hits > 1 ? " ×" + hits : ""));
                i = i + hits;
                continue;
            }
            string t = CardLibrary.EffectLine(k, n);
            if (t != "") { lines.Add(t); }
            i = i + 1;
        }
        return lines;
    }

    static string EffectLine(int k, int n) {
        if (k == CardFx.Block()) { return "获得 " + n + " 格挡"; }
        if (k == CardFx.Heal()) { return "回复 " + n + " 生命"; }
        if (k == CardFx.Draw()) { return "抽 " + n + " 张牌"; }
        if (k == CardFx.Energy()) { return "获得 " + n + " 能量"; }
        if (k == CardFx.Strength()) { return "获得 " + n + " 力量"; }
        if (k == CardFx.Vulnerable()) { return "施加 " + n + " 易伤"; }
        if (k == CardFx.Weak()) { return "施加 " + n + " 虚弱"; }
        if (k == CardFx.Poison()) { return "施加 " + n + " 中毒"; }
        if (k == CardFx.BlockDamage()) { return "伤害 = 当前格挡"; }
        if (k == CardFx.LoseHp()) { return "失去 " + n + " 生命"; }
        if (k == CardFx.DoublePoison()) { return "敌人中毒层数翻倍"; }
        if (k == CardFx.PowerStrength()) { return "每回合开始 +" + n + " 力量"; }
        if (k == CardFx.PowerPlating()) { return "回合结束 +" + n + " 格挡"; }
        if (k == CardFx.PowerPoison()) { return "每回合开始施毒 " + n; }
        if (k == CardFx.PowerDraw()) { return "每回合多抽 " + n + " 张"; }
        if (k == CardFx.PowerThorns()) { return "受击时反伤 " + n; }
        return "";
    }

    // 关键词一行（"消耗 · 保留"），没有返回空串。能力牌打出后留在场上，不进弃牌堆。
    static string Keywords(CardDefinition def) {
        string s = "";
        if (def.Category() == "power") { s = "能力"; }
        if (CardLibrary.Has(def, CardFx.Retain())) { s = s == "" ? "保留" : s + " · 保留"; }
        if (CardLibrary.Has(def, CardFx.Exhaust())) { s = s == "" ? "消耗" : s + " · 消耗"; }
        return s;
    }

    // 关键词释义（卡牌悬停提示）。
    static string Glossary(CardDefinition def) {
        string s = def.Name() + "：" + String.Join("，", CardLibrary.Describe(def)) + "。";
        if (CardLibrary.Has(def, CardFx.Exhaust())) { s = s + "\n消耗：打出后移出本场战斗。"; }
        if (CardLibrary.Has(def, CardFx.Retain())) { s = s + "\n保留：回合结束时不会被弃掉。"; }
        if (def.Category() == "power") { s = s + "\n能力：打出后整场战斗持续生效。"; }
        if (CardLibrary.Amount(def, CardFx.Poison()) > 0 || CardLibrary.Has(def, CardFx.PowerPoison())) {
            s = s + "\n中毒：每回合开始失去等同层数的生命，然后层数 -1。";
        }
        if (CardLibrary.Has(def, CardFx.Weak())) { s = s + "\n虚弱：造成的攻击伤害 -25%。"; }
        if (CardLibrary.Has(def, CardFx.Vulnerable())) { s = s + "\n易伤：受到的攻击伤害 +50%。"; }
        return s;
    }

    static string RarityName(int r) {
        if (r == CardLibrary.Rare()) { return "稀有"; }
        if (r == CardLibrary.Uncommon()) { return "罕见"; }
        if (r == CardLibrary.Common()) { return "普通"; }
        return "基础";
    }
}
