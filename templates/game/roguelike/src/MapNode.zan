using System;

// 路线节点：一层里玩家可以选的一个去处。
//
// 肉鸽的"路线选择"就是这张表：kind 决定节点性质，敌人属性直接写在这里，
// 新增一层只要往 RunState.BuildFloor 里加一条 MapNode。
public class MapNode {
    // 节点类型：0 普通战斗，1 精英战斗，2 宝箱，3 Boss 战。
    int kind;
    string enemyName;
    int hp;
    int damage;

    MapNode(int kind, string enemyName, int hp, int damage) {
        this.kind = kind;
        this.enemyName = enemyName;
        this.hp = hp;
        this.damage = damage;
    }

    // 节点类型标识。
    int Kind() { return this.kind; }

    // 敌人名（宝箱节点为空串）。
    string EnemyName() { return this.enemyName; }

    // 敌人生命（宝箱节点为 0）。
    int Hp() { return this.hp; }

    // 敌人每回合伤害（宝箱节点为 0）。
    int Damage() { return this.damage; }

    // 节点类型名（界面上显示）。
    string KindName() {
        if (this.kind == 0) { return "普通战斗"; }
        if (this.kind == 1) { return "精英战斗"; }
        if (this.kind == 2) { return "宝箱"; }
        return "Boss 战";
    }

    // 一行说明：敌人名 + 血量 + 每回合伤害（宝箱没有敌人）。
    string Desc() {
        if (this.kind == 2) {
            return "免费拿一张牌，并回复 8 点生命";
        }
        return this.enemyName + " · " + Convert.ToString(this.hp)
            + " 生命 · 每回合 " + Convert.ToString(this.damage) + " 伤害";
    }
}
