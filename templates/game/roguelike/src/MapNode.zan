using System;
using System.Collections.Generic;

// 地图上的一个节点：所在行列、类型、通往下一行的连线、是否走过。
public class MapNode {
    public static int Battle() { return 0; }
    public static int Elite() { return 1; }
    public static int Treasure() { return 2; }
    public static int Boss() { return 3; }
    public static int Event() { return 4; }
    public static int Shop() { return 5; }
    public static int Campfire() { return 6; }

    public int index;
    public int row;
    public int col;
    public int kind;
    // 显示用的水平微偏（像素），由种子决定——地图看起来是手绘的，不是棋盘格。
    public int jitter;
    public bool visited;
    public List<int> next;

    public MapNode(int index, int row, int col) {
        this.index = index;
        this.row = row;
        this.col = col;
        this.kind = MapNode.Battle();
        this.next = new List<int>();
    }

    public bool Links(int other) {
        for (int i = 0; i < this.next.Count; i = i + 1) {
            if (this.next[i] == other) { return true; }
        }
        return false;
    }

    public int Kind() { return this.kind; }

    public static string KindName(int kind) {
        if (kind == MapNode.Elite()) { return "精英"; }
        if (kind == MapNode.Treasure()) { return "宝箱"; }
        if (kind == MapNode.Boss()) { return "Boss"; }
        if (kind == MapNode.Event()) { return "奇遇"; }
        if (kind == MapNode.Shop()) { return "商店"; }
        if (kind == MapNode.Campfire()) { return "篝火"; }
        return "战斗";
    }

    // 节点上的单字徽记。
    public static string Glyph(int kind) {
        if (kind == MapNode.Elite()) { return "精"; }
        if (kind == MapNode.Treasure()) { return "宝"; }
        if (kind == MapNode.Boss()) { return "王"; }
        if (kind == MapNode.Event()) { return "？"; }
        if (kind == MapNode.Shop()) { return "商"; }
        if (kind == MapNode.Campfire()) { return "火"; }
        return "战";
    }

    public static string KindHint(int kind) {
        if (kind == MapNode.Elite()) { return "精英：更强的敌人，掉落遗物"; }
        if (kind == MapNode.Treasure()) { return "宝箱：一件遗物和一些金币"; }
        if (kind == MapNode.Boss()) { return "Boss：本幕的守关者"; }
        if (kind == MapNode.Event()) { return "奇遇：有得有失的抉择"; }
        if (kind == MapNode.Shop()) { return "商店：用金币买牌、买遗物、删牌"; }
        if (kind == MapNode.Campfire()) { return "篝火：休息回血，或锻造升级一张牌"; }
        return "战斗：击败敌人换牌与金币";
    }
}
