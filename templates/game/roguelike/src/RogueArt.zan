using System;

// 角色与敌人的立绘：程序化 SVG（运行时由 nanosvg 光栅化一次、按尺寸缓存）。
//
// 场景画（世界层）允许画布绘制，控件不画——立绘就是"世界"的一部分。所有形象
// 共用一个坐标系：viewBox 200×220，脚底在 y≈212，水平居中；敌人面朝左（朝向攀登者），
// 攀登者面朝右。九种剪影（史莱姆/蜘蛛/骷髅/长袍/骑士/野兽/魔像/怨灵/恶魔）靠
// 配色与配件变出 17 种敌人，配色取自标题图的暗金、余烬与深红。
//
// flash=true 生成"受击闪白"版本：所有填色换成近白暖色，叠在原图上淡出即是受击闪光。
public class RogueArt {
    bool flash;

    RogueArt(bool flash) { this.flash = flash; }

    // 颜色（闪白版统一换成暖白，只保留透明度差异）。
    string C(string hex) { return this.flash ? "#fff4e6" : hex; }

    static string Open() {
        return "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 200 220' width='200' height='220'>";
    }

    // 某个外形的完整 SVG。
    public static string Svg(string look, bool flash) {
        RogueArt a = new RogueArt(flash);
        string body = a.Body(look);
        return RogueArt.Open() + body + "</svg>";
    }

    string Body(string look) {
        if (look == "hero") { return this.Hero(); }
        if (look == "campfire") { return this.Campfire(); }
        if (look == "chest") { return this.Chest(); }
        if (look == "merchant") { return this.Merchant(); }
        if (look == "altar") { return this.Altar(); }
        if (look == "slime") { return this.Slime("#7fd65a", "#2f7a2a", "#d8ff9a"); }
        if (look == "spider") { return this.Spider("#5a3a6e", "#2a1636", "#ff4a3a"); }
        if (look == "skeleton") { return this.Skeleton("#e8dcc0", "#8a7a5e", false, "sword"); }
        if (look == "archer") { return this.Skeleton("#d8ccb0", "#7a6a50", false, "bow"); }
        if (look == "cultist") { return this.Robe("#7a1e1e", "#3a0c0c", "#ffb03a", "hood", "dagger"); }
        if (look == "necro") { return this.Robe("#3a2a5e", "#160e2a", "#6fffe0", "hood", "staff"); }
        if (look == "assassin") { return this.Robe("#26262e", "#0c0c10", "#ff5a5a", "hood", "twin"); }
        if (look == "witch") { return this.Robe("#3e5a2a", "#18260e", "#c8ff5a", "hat", "staff"); }
        if (look == "knight") { return this.Knight("#9aa4b0", "#4a525e", "#c0392b", "plume"); }
        if (look == "paladin") { return this.Knight("#d8b060", "#6a4a1e", "#fff0b0", "halo"); }
        if (look == "boneking") { return this.Skeleton("#efe2c4", "#6a5a3e", true, "great"); }
        if (look == "gargoyle") { return this.Beast("#7a7e86", "#3a3c42", "#ffcf6e", true); }
        if (look == "hound") { return this.Beast("#6a5a3a", "#2e2416", "#b6ff5a", false); }
        if (look == "golem") { return this.Golem("#4a3a32", "#1e1612", "#ff7a2a"); }
        if (look == "wraith") { return this.Wraith("#8ab8d8", "#2a4a6a", "#e0fbff"); }
        if (look == "fiend") { return this.Fiend("#a8281e", "#4a0c08", "#ffd24a", false); }
        if (look == "warden") { return this.Fiend("#3a2e3e", "#120a14", "#ff6a1e", true); }
        return this.Slime("#a0a0a0", "#505050", "#ffffff");
    }

    // 竖向渐变 defs。
    string Grad(string id, string top, string bottom) {
        return "<defs><linearGradient id='" + id + "' x1='0' y1='0' x2='0' y2='1'>"
            + "<stop offset='0' stop-color='" + this.C(top) + "'/>"
            + "<stop offset='1' stop-color='" + this.C(bottom) + "'/></linearGradient></defs>";
    }

    // 发光的眼睛（闪白版也保留）。
    string Eye(int x, int y, int r, string color) {
        return "<circle cx='" + x + "' cy='" + y + "' r='" + (r + 3) + "' fill='" + color + "' opacity='0.35'/>"
            + "<circle cx='" + x + "' cy='" + y + "' r='" + r + "' fill='" + color + "'/>";
    }

    // ---- 攀登者：披风剑士，面朝右 --------------------------------------------

    string Hero() {
        string s = this.Grad("cape", "#8a1e18", "#3a0a08") + this.Grad("mail", "#c8ccd4", "#5a606a");
        s = s + "<path d='M70 70 Q48 120 52 206 L120 206 Q110 130 98 74 Z' fill='url(#cape)'/>"
            + "<rect x='84' y='150' width='12' height='58' rx='4' fill='" + this.C("#2e2620") + "'/>"
            + "<rect x='104' y='150' width='12' height='58' rx='4' fill='" + this.C("#2e2620") + "'/>"
            + "<rect x='80' y='200' width='20' height='10' rx='4' fill='" + this.C("#1a1410") + "'/>"
            + "<rect x='102' y='200' width='22' height='10' rx='4' fill='" + this.C("#1a1410") + "'/>"
            + "<path d='M78 86 Q100 76 122 86 L126 156 L74 156 Z' fill='url(#mail)'/>"
            + "<rect x='74' y='134' width='52' height='9' fill='" + this.C("#6a4a26") + "'/>"
            + "<rect x='96' y='133' width='10' height='11' fill='" + this.C("#e8b04a") + "'/>"
            + "<circle cx='100' cy='62' r='18' fill='" + this.C("#e0b48a") + "'/>"
            + "<path d='M80 60 Q82 38 100 38 Q120 38 120 56 L114 50 Q100 46 86 56 Z' fill='" + this.C("#3a2418") + "'/>"
            + "<circle cx='108' cy='62' r='2.6' fill='" + this.C("#1a1010") + "'/>"
            + "<path d='M70 92 Q60 120 72 140' stroke='" + this.C("#a8aeb8") + "' stroke-width='12' fill='none' stroke-linecap='round'/>"
            + "<path d='M124 92 Q140 108 146 122' stroke='" + this.C("#a8aeb8") + "' stroke-width='12' fill='none' stroke-linecap='round'/>"
            + "<rect x='140' y='116' width='10' height='14' rx='3' fill='" + this.C("#6a4a26") + "'/>"
            + "<rect x='134' y='112' width='22' height='6' rx='2' fill='" + this.C("#e8b04a") + "'/>"
            + "<path d='M141 112 L145 40 L149 112 Z' fill='" + this.C("#eef2f8") + "' stroke='" + this.C("#8a94a4") + "' stroke-width='1.5'/>"
            + "<path d='M145 44 L145 108' stroke='" + this.C("#ffffff") + "' stroke-width='1' opacity='0.7'/>"
            + "<ellipse cx='62' cy='122' rx='20' ry='26' fill='" + this.C("#5a3a1e") + "' stroke='" + this.C("#e8b04a") + "' stroke-width='3'/>"
            + "<circle cx='62' cy='122' r='6' fill='" + this.C("#e8b04a") + "'/>";
        return s;
    }

    // ---- 史莱姆 ----------------------------------------------------------------

    string Slime(string body, string dark, string shine) {
        string s = this.Grad("sl", body, dark);
        s = s + "<path d='M30 210 Q24 150 60 120 Q100 80 140 120 Q178 150 170 210 Z' fill='url(#sl)' opacity='0.92'/>"
            + "<path d='M30 210 Q40 196 52 210 Q64 198 78 210 Q92 196 108 210 Q122 198 138 210 Q152 196 170 210 Z' fill='" + this.C(dark) + "'/>"
            + "<ellipse cx='72' cy='128' rx='16' ry='9' fill='" + this.C(shine) + "' opacity='0.55'/>"
            + "<circle cx='120' cy='170' r='7' fill='" + this.C(shine) + "' opacity='0.35'/>"
            + "<circle cx='136' cy='186' r='4' fill='" + this.C(shine) + "' opacity='0.35'/>"
            + "<ellipse cx='78' cy='156' rx='11' ry='14' fill='" + this.C("#10200c") + "'/>"
            + "<ellipse cx='118' cy='156' rx='11' ry='14' fill='" + this.C("#10200c") + "'/>"
            + "<circle cx='75' cy='152' r='4' fill='" + this.C("#ffffff") + "'/>"
            + "<circle cx='115' cy='152' r='4' fill='" + this.C("#ffffff") + "'/>"
            + "<path d='M82 184 Q98 194 116 184' stroke='" + this.C("#10200c") + "' stroke-width='4' fill='none' stroke-linecap='round'/>";
        return s;
    }

    // ---- 蜘蛛 ------------------------------------------------------------------

    string Spider(string body, string dark, string eye) {
        string s = this.Grad("sp", body, dark);
        string legs = "";
        for (int i = 0; i < 4; i = i + 1) {
            int y = 150 + i * 12;
            legs = legs + "<path d='M100 " + y + " Q" + (52 - i * 6) + " " + (y - 50 + i * 8) + " " + (22 + i * 4) + " 210' stroke='" + this.C(dark) + "' stroke-width='7' fill='none' stroke-linecap='round'/>"
                + "<path d='M100 " + y + " Q" + (148 + i * 6) + " " + (y - 50 + i * 8) + " " + (178 - i * 4) + " 210' stroke='" + this.C(dark) + "' stroke-width='7' fill='none' stroke-linecap='round'/>";
        }
        s = s + legs
            + "<ellipse cx='112' cy='150' rx='46' ry='38' fill='url(#sp)'/>"
            + "<path d='M100 126 L112 140 L124 126 L136 140' stroke='" + this.C("#c8a0e0") + "' stroke-width='3' fill='none' opacity='0.6'/>"
            + "<ellipse cx='70' cy='164' rx='26' ry='22' fill='" + this.C(body) + "'/>"
            + this.Eye(60, 158, 5, eye) + this.Eye(74, 154, 4, eye) + this.Eye(64, 170, 3, eye) + this.Eye(78, 166, 3, eye)
            + "<path d='M48 178 L44 192 M58 182 L56 196' stroke='" + this.C("#e8e0d0") + "' stroke-width='4' stroke-linecap='round'/>";
        return s;
    }

    // ---- 骷髅（兵 / 弓手 / 君王） ----------------------------------------------

    string Skeleton(string bone, string shade, bool king, string weapon) {
        string s = "";
        if (king) {
            s = s + this.Grad("kc", "#5a1e6a", "#1e0a26")
                + "<path d='M62 70 Q36 140 30 212 L170 212 Q164 140 138 70 Z' fill='url(#kc)'/>";
        }
        s = s + "<rect x='96' y='84' width='8' height='76' fill='" + this.C(shade) + "'/>";
        for (int i = 0; i < 4; i = i + 1) {
            int y = 96 + i * 13;
            s = s + "<path d='M100 " + y + " Q" + (74 + i * 2) + " " + (y + 2) + " " + (78 + i * 3) + " " + (y + 10) + " M100 " + y + " Q" + (126 - i * 2) + " " + (y + 2) + " " + (122 - i * 3) + " " + (y + 10) + "' stroke='" + this.C(bone) + "' stroke-width='5' fill='none' stroke-linecap='round'/>";
        }
        s = s + "<path d='M80 160 Q100 150 120 160 L114 172 L86 172 Z' fill='" + this.C(bone) + "'/>"
            + "<path d='M88 172 L84 210 M112 172 L116 210' stroke='" + this.C(bone) + "' stroke-width='8' stroke-linecap='round'/>"
            + "<path d='M84 92 L64 130 L58 150 M116 92 L136 128' stroke='" + this.C(bone) + "' stroke-width='7' fill='none' stroke-linecap='round'/>"
            + "<path d='M76 56 Q76 30 100 30 Q124 30 124 56 Q124 72 112 76 L112 84 L88 84 L88 76 Q76 72 76 56 Z' fill='" + this.C(bone) + "'/>"
            + this.Eye(90, 56, 6, king ? "#b06aff" : "#ff7a3a") + this.Eye(110, 56, 6, king ? "#b06aff" : "#ff7a3a")
            + "<path d='M92 76 L92 84 M100 76 L100 84 M108 76 L108 84' stroke='" + this.C(shade) + "' stroke-width='2'/>";
        if (weapon == "sword") {
            s = s + "<path d='M56 150 L30 70' stroke='" + this.C("#c8ccd4") + "' stroke-width='7' stroke-linecap='round'/>"
                + "<path d='M48 140 L66 134' stroke='" + this.C("#6a4a26") + "' stroke-width='6' stroke-linecap='round'/>"
                + "<ellipse cx='140' cy='132' rx='16' ry='22' fill='" + this.C("#5a3a1e") + "' stroke='" + this.C("#9a8a6e") + "' stroke-width='3'/>";
        } else if (weapon == "bow") {
            s = s + "<path d='M54 70 Q20 140 58 206' stroke='" + this.C("#7a5a30") + "' stroke-width='6' fill='none'/>"
                + "<path d='M54 70 L58 206' stroke='" + this.C("#e8e0d0") + "' stroke-width='1.5'/>"
                + "<path d='M58 138 L20 138' stroke='" + this.C("#c8ccd4") + "' stroke-width='3'/>"
                + "<path d='M20 138 L28 133 L28 143 Z' fill='" + this.C("#c8ccd4") + "'/>";
        } else {
            s = s + "<path d='M58 152 L20 40' stroke='" + this.C("#d8dce4") + "' stroke-width='12' stroke-linecap='round'/>"
                + "<path d='M22 46 L20 40' stroke='" + this.C("#ffffff") + "' stroke-width='4'/>"
                + "<path d='M46 136 L72 128' stroke='" + this.C("#e8b04a") + "' stroke-width='8' stroke-linecap='round'/>"
                + "<path d='M78 34 L82 14 L90 28 L100 10 L110 28 L118 14 L122 34 Z' fill='" + this.C("#ffcf4a") + "' stroke='" + this.C("#a86a10") + "' stroke-width='2'/>"
                + "<circle cx='100' cy='26' r='4' fill='" + this.C("#ff3a3a") + "'/>";
        }
        return s;
    }

    // ---- 长袍（邪教徒 / 亡灵法师 / 刺客 / 女巫） --------------------------------

    string Robe(string robe, string dark, string glow, string head, string weapon) {
        string s = this.Grad("rb", robe, dark);
        s = s + "<path d='M70 70 Q50 140 40 212 L160 212 Q150 140 130 70 Z' fill='url(#rb)'/>"
            + "<path d='M100 80 L100 212' stroke='" + this.C(dark) + "' stroke-width='3' opacity='0.6'/>"
            + "<path d='M70 90 Q52 120 56 150' stroke='" + this.C(robe) + "' stroke-width='16' fill='none' stroke-linecap='round'/>"
            + "<path d='M130 90 Q146 116 140 140' stroke='" + this.C(robe) + "' stroke-width='16' fill='none' stroke-linecap='round'/>";
        if (head == "hat") {
            s = s + "<path d='M74 70 Q100 60 126 70 L120 54 Q100 50 80 54 Z' fill='" + this.C(dark) + "'/>"
                + "<path d='M54 66 L146 66 L132 58 L68 58 Z' fill='" + this.C(dark) + "'/>"
                + "<path d='M76 58 L112 4 L124 58 Z' fill='" + this.C(dark) + "'/>"
                + "<ellipse cx='100' cy='76' rx='16' ry='14' fill='" + this.C("#a8c890") + "'/>"
                + this.Eye(93, 74, 3, glow) + this.Eye(107, 74, 3, glow)
                + "<path d='M84 86 Q100 104 116 86' stroke='" + this.C("#c8e0b0") + "' stroke-width='8' fill='none'/>";
        } else {
            s = s + "<path d='M72 78 Q70 34 100 30 Q130 34 128 78 Q114 70 100 70 Q86 70 72 78 Z' fill='" + this.C(robe) + "'/>"
                + "<ellipse cx='100' cy='66' rx='18' ry='16' fill='" + this.C("#0a0606") + "'/>"
                + this.Eye(92, 64, 3, glow) + this.Eye(108, 64, 3, glow);
        }
        if (weapon == "staff") {
            s = s + "<path d='M48 210 L56 70' stroke='" + this.C("#4a3420") + "' stroke-width='6' stroke-linecap='round'/>"
                + "<circle cx='56' cy='62' r='14' fill='" + glow + "' opacity='0.35'/>"
                + "<circle cx='56' cy='62' r='8' fill='" + glow + "'/>";
        } else if (weapon == "twin") {
            s = s + "<path d='M56 150 L30 128' stroke='" + this.C("#d8dce4") + "' stroke-width='5' stroke-linecap='round'/>"
                + "<path d='M140 140 L164 118' stroke='" + this.C("#d8dce4") + "' stroke-width='5' stroke-linecap='round'/>"
                + "<path d='M30 128 L36 136' stroke='" + glow + "' stroke-width='3'/>";
        } else {
            s = s + "<path d='M56 150 L34 122' stroke='" + this.C("#c8ccd4") + "' stroke-width='5' stroke-linecap='round'/>"
                + "<circle cx='34' cy='122' r='6' fill='" + glow + "' opacity='0.5'/>";
        }
        return s;
    }

    // ---- 骑士（骷髅骑士 / 堕落圣骑士） ------------------------------------------

    string Knight(string steel, string dark, string accent, string crest) {
        string s = this.Grad("kn", steel, dark);
        if (crest == "halo") {
            s = s + "<ellipse cx='100' cy='26' rx='30' ry='8' fill='none' stroke='" + accent + "' stroke-width='4' opacity='0.9'/>";
        }
        s = s + "<path d='M66 80 L134 80 L140 160 L60 160 Z' fill='url(#kn)'/>"
            + "<path d='M100 84 L100 158' stroke='" + this.C(dark) + "' stroke-width='3'/>"
            + "<rect x='72' y='158' width='22' height='52' rx='5' fill='" + this.C(dark) + "'/>"
            + "<rect x='106' y='158' width='22' height='52' rx='5' fill='" + this.C(dark) + "'/>"
            + "<ellipse cx='64' cy='86' rx='18' ry='12' fill='" + this.C(steel) + "'/>"
            + "<ellipse cx='136' cy='86' rx='18' ry='12' fill='" + this.C(steel) + "'/>"
            + "<path d='M76 30 Q100 18 124 30 L126 74 L74 74 Z' fill='url(#kn)'/>"
            + "<rect x='80' y='50' width='40' height='7' rx='3' fill='" + this.C("#0a0808") + "'/>"
            + this.Eye(90, 53, 3, accent == "#fff0b0" ? "#ffe08a" : "#ff4a3a") + this.Eye(110, 53, 3, accent == "#fff0b0" ? "#ffe08a" : "#ff4a3a");
        if (crest == "plume") {
            s = s + "<path d='M100 22 Q130 0 150 26 Q126 18 104 30 Z' fill='" + this.C(accent) + "'/>";
        }
        s = s + "<path d='M38 96 L34 190 Q60 210 82 190 L80 96 Z' fill='" + this.C(dark) + "' stroke='" + this.C(steel) + "' stroke-width='4'/>"
            + "<path d='M58 110 L58 180 M44 140 L72 140' stroke='" + this.C(accent) + "' stroke-width='5'/>"
            + "<path d='M150 150 L170 30' stroke='" + this.C("#dfe4ec") + "' stroke-width='9' stroke-linecap='round'/>"
            + "<path d='M138 146 L162 152' stroke='" + this.C(accent) + "' stroke-width='6' stroke-linecap='round'/>";
        return s;
    }

    // ---- 野兽（石像鬼带翼 / 腐尸犬） --------------------------------------------

    string Beast(string fur, string dark, string eye, bool wings) {
        string s = this.Grad("bs", fur, dark);
        if (wings) {
            s = s + "<path d='M110 100 Q150 20 196 40 Q170 60 178 90 Q160 84 150 110 Z' fill='" + this.C(dark) + "'/>"
                + "<path d='M96 100 Q70 30 30 30 Q52 56 40 84 Q60 80 70 110 Z' fill='" + this.C(dark) + "' opacity='0.85'/>";
        }
        s = s + "<ellipse cx='118' cy='150' rx='54' ry='34' fill='url(#bs)'/>"
            + "<path d='M150 170 L156 210 M130 176 L132 210 M96 172 L90 210 M78 166 L66 208' stroke='" + this.C(dark) + "' stroke-width='12' stroke-linecap='round'/>"
            + "<path d='M164 140 Q190 130 192 104' stroke='" + this.C(fur) + "' stroke-width='8' fill='none' stroke-linecap='round'/>"
            + "<path d='M80 124 Q50 108 44 132 Q40 156 64 164 Q82 166 92 150 Z' fill='" + this.C(fur) + "'/>"
            + "<path d='M48 140 L20 148 Q24 164 46 160 Z' fill='" + this.C(dark) + "'/>"
            + "<path d='M26 150 L30 156 M34 152 L37 158' stroke='" + this.C("#f0e8d8") + "' stroke-width='3'/>"
            + "<path d='M66 116 L60 90 L76 112 Z M82 118 L86 94 L92 120 Z' fill='" + this.C(dark) + "'/>"
            + this.Eye(58, 132, 4, eye);
        return s;
    }

    // ---- 熔岩魔像 --------------------------------------------------------------

    string Golem(string rock, string dark, string lava) {
        string s = this.Grad("gl", rock, dark);
        s = s + "<path d='M56 60 L144 56 L156 150 L44 152 Z' fill='url(#gl)'/>"
            + "<path d='M70 150 L62 210 L96 210 L96 152 Z M106 152 L106 210 L140 210 L132 150 Z' fill='" + this.C(dark) + "'/>"
            + "<path d='M44 70 L16 150 L40 166 L60 90 Z M156 66 L186 146 L162 162 L140 88 Z' fill='url(#gl)'/>"
            + "<rect x='12' y='150' width='36' height='30' rx='8' fill='" + this.C(rock) + "'/>"
            + "<rect x='156' y='146' width='36' height='30' rx='8' fill='" + this.C(rock) + "'/>"
            + "<path d='M76 30 L124 28 L128 64 L72 66 Z' fill='" + this.C(rock) + "'/>"
            + "<path d='M70 80 L92 104 L84 130 L110 120 L130 140 M120 70 L108 96' stroke='" + lava + "' stroke-width='4' fill='none' stroke-linejoin='round'/>"
            + "<path d='M70 80 L92 104 L84 130 L110 120 L130 140' stroke='" + lava + "' stroke-width='10' fill='none' opacity='0.25'/>"
            + this.Eye(90, 46, 4, lava) + this.Eye(110, 46, 4, lava);
        return s;
    }

    // ---- 怨灵 ------------------------------------------------------------------

    string Wraith(string pale, string dark, string glow) {
        string s = this.Grad("wr", pale, dark);
        s = s + "<path d='M100 24 Q146 30 150 100 Q156 150 140 180 Q128 200 112 188 Q104 210 90 192 Q74 206 66 182 Q46 150 52 96 Q56 30 100 24 Z' fill='url(#wr)' opacity='0.85'/>"
            + "<path d='M60 100 Q30 120 26 150 M140 100 Q170 116 176 146' stroke='" + this.C(pale) + "' stroke-width='9' fill='none' stroke-linecap='round' opacity='0.75'/>"
            + "<path d='M26 150 L18 160 M26 150 L28 164 M176 146 L186 154 M176 146 L174 160' stroke='" + this.C(pale) + "' stroke-width='4' stroke-linecap='round' opacity='0.75'/>"
            + "<ellipse cx='100' cy='70' rx='26' ry='30' fill='" + this.C("#0a121c") + "'/>"
            + this.Eye(90, 66, 5, glow) + this.Eye(110, 66, 5, glow)
            + "<ellipse cx='100' cy='88' rx='7' ry='10' fill='" + this.C("#020406") + "'/>";
        return s;
    }

    // ---- 恶魔（血魔 / 深渊守卫） -------------------------------------------------

    string Fiend(string skin, string dark, string eye, bool colossus) {
        string s = this.Grad("fd", skin, dark);
        s = s + "<path d='M100 90 Q150 0 198 30 Q176 50 186 84 Q160 76 146 110 Z' fill='" + this.C(dark) + "'/>"
            + "<path d='M100 90 Q50 0 2 30 Q24 50 14 84 Q40 76 54 110 Z' fill='" + this.C(dark) + "'/>"
            + "<path d='M62 76 L138 76 L146 150 L54 150 Z' fill='url(#fd)'/>"
            + "<path d='M64 150 L58 210 L94 210 L96 150 Z M104 150 L106 210 L142 210 L136 150 Z' fill='" + this.C(dark) + "'/>"
            + "<path d='M62 84 Q36 120 40 160 M138 84 Q164 120 160 160' stroke='" + this.C(skin) + "' stroke-width='16' fill='none' stroke-linecap='round'/>"
            + "<path d='M36 160 L28 176 M42 162 L40 180 M164 160 L172 176 M158 162 L160 180' stroke='" + this.C("#f0e0c0") + "' stroke-width='4' stroke-linecap='round'/>"
            + "<path d='M74 40 Q74 20 100 20 Q126 20 126 40 L124 72 Q100 84 76 72 Z' fill='" + this.C(skin) + "'/>"
            + "<path d='M76 34 Q56 20 54 0 Q72 12 84 26 Z M124 34 Q144 20 146 0 Q128 12 116 26 Z' fill='" + this.C("#e8dcc0") + "'/>"
            + this.Eye(90, 48, 4, eye) + this.Eye(110, 48, 4, eye)
            + "<path d='M88 64 L92 70 L96 64 L100 70 L104 64 L108 70 L112 64' stroke='" + this.C("#f0e8d8") + "' stroke-width='2' fill='none'/>";
        if (colossus) {
            s = s + "<path d='M62 92 L138 92 L134 112 L66 112 Z' fill='" + this.C("#5a4a60") + "'/>"
                + "<circle cx='100' cy='122' r='12' fill='" + eye + "' opacity='0.4'/>"
                + "<circle cx='100' cy='122' r='7' fill='" + eye + "'/>"
                + "<path d='M64 76 L52 60 L78 74 Z M136 76 L148 60 L122 74 Z' fill='" + this.C("#5a4a60") + "'/>";
        }
        return s;
    }

    // ---- 场景插画：篝火 / 宝箱 / 商人 / 奇遇祭坛 ------------------------------------

    string Campfire() {
        string s = "<defs><radialGradient id='fl' cx='0.5' cy='0.8' r='0.6'>"
            + "<stop offset='0' stop-color='#fff2a8'/><stop offset='0.45' stop-color='#ffa030'/>"
            + "<stop offset='1' stop-color='#c8301a' stop-opacity='0'/></radialGradient></defs>";
        s = s + "<ellipse cx='100' cy='196' rx='70' ry='14' fill='#000000' opacity='0.5'/>"
            + "<path d='M40 198 L150 168 L156 180 L46 210 Z' fill='#5a3a20'/>"
            + "<path d='M160 198 L50 168 L44 180 L154 210 Z' fill='#4a2e18'/>"
            + "<circle cx='60' cy='204' r='9' fill='#3a2a22'/><circle cx='142' cy='204' r='10' fill='#3a2a22'/>"
            + "<circle cx='100' cy='208' r='8' fill='#2e221a'/>"
            + "<path d='M100 40 Q130 100 140 150 Q140 190 100 192 Q60 190 60 150 Q70 100 100 40 Z' fill='url(#fl)'/>"
            + "<path d='M100 90 Q118 130 120 160 Q118 182 100 182 Q82 182 80 160 Q84 130 100 90 Z' fill='#fff0a0' opacity='0.85'/>"
            + "<path d='M70 110 Q60 140 72 160' stroke='#ff7a2a' stroke-width='6' fill='none' opacity='0.7'/>"
            + "<path d='M132 104 Q146 136 128 162' stroke='#ff7a2a' stroke-width='6' fill='none' opacity='0.7'/>";
        return s;
    }

    string Chest() {
        string s = this.Grad("ch", "#8a5a2a", "#4a2a12");
        s = s + "<ellipse cx='100' cy='200' rx='76' ry='12' fill='#000000' opacity='0.5'/>"
            + "<path d='M30 90 Q100 40 170 90 L170 112 L30 112 Z' fill='url(#ch)' stroke='#e8b04a' stroke-width='4'/>"
            + "<rect x='30' y='108' width='140' height='88' rx='6' fill='url(#ch)' stroke='#e8b04a' stroke-width='4'/>"
            + "<rect x='30' y='130' width='140' height='8' fill='#e8b04a'/>"
            + "<rect x='88' y='112' width='24' height='34' rx='4' fill='#ffd27a' stroke='#8a5a10' stroke-width='3'/>"
            + "<circle cx='100' cy='126' r='5' fill='#3a2010'/>"
            + "<path d='M100 72 L106 86 L100 100 L94 86 Z' fill='#ffe9a8' opacity='0.9'/>";
        return s;
    }

    string Merchant() {
        string s = this.Robe("#4a3a6a", "#1a1226", "#ffd24a", "hood", "staff");
        s = s + "<rect x='112' y='150' width='70' height='50' rx='6' fill='#5a3a20' stroke='#e8b04a' stroke-width='3'/>"
            + "<circle cx='132' cy='168' r='7' fill='#ffcf4a'/><circle cx='150' cy='174' r='7' fill='#ffcf4a'/>"
            + "<circle cx='140' cy='160' r='6' fill='#ffe08a'/><rect x='158' y='158' width='14' height='18' rx='3' fill='#6fe0d8'/>";
        return s;
    }

    string Altar() {
        string s = this.Grad("al", "#5a4a40", "#221a16");
        s = s + "<ellipse cx='100' cy='202' rx='80' ry='12' fill='#000000' opacity='0.5'/>"
            + "<path d='M44 200 L56 120 L144 120 L156 200 Z' fill='url(#al)'/>"
            + "<rect x='36' y='108' width='128' height='16' rx='4' fill='#6a5a4e'/>"
            + "<path d='M70 150 L80 140 L90 156 L100 138 L110 156 L120 140 L130 150' stroke='#6fe0d8' stroke-width='3' fill='none' opacity='0.8'/>"
            + "<circle cx='100' cy='72' r='34' fill='#6fe0d8' opacity='0.18'/>"
            + "<circle cx='100' cy='72' r='20' fill='#6fe0d8' opacity='0.35'/>"
            + "<path d='M100 46 L108 72 L100 98 L92 72 Z' fill='#d8fffa'/>";
        return s;
    }
}
