using System;
using System.Cli;
using System.Json;

/* 输出层：同一份统计渲染成人看的表格或机器读的 JSON。 */
public class Report {
    public static string Text(List<TextStats> files, TextStats total, int top) {
        Table t = new Table();
        t.AddColumn("文件", 0).AddColumn("行", 2).AddColumn("词", 2).AddColumn("字符", 2);
        for (int i = 0; i < files.Count; i++) {
            Report.Row(t, files[i]);
        }
        if (files.Count > 1) { Report.Row(t, total); }
        string s = t.Render();

        List<string> words = total.TopWords(top);
        if (words.Count > 0) {
            s = s + "\n高频词 Top " + Convert.ToString(words.Count) + "：\n";
            for (int i = 0; i < words.Count; i++) {
                s = s + "  " + Convert.ToString(i + 1) + ". " + words[i]
                    + " × " + Convert.ToString(total.CountOf(words[i])) + "\n";
            }
        }
        return s;
    }

    public static string Json(List<TextStats> files, TextStats total, int top) {
        JsonValue root = JsonValue.NewObject();
        JsonValue arr = JsonValue.NewArray();
        for (int i = 0; i < files.Count; i++) {
            arr.Append(Report.Node(files[i]));
        }
        root.Set("files", arr);
        root.Set("total", Report.Node(total));
        JsonValue topArr = JsonValue.NewArray();
        List<string> words = total.TopWords(top);
        for (int i = 0; i < words.Count; i++) {
            JsonValue w = JsonValue.NewObject();
            w.PutStr("word", words[i]);
            w.PutInt("count", total.CountOf(words[i]));
            topArr.Append(w);
        }
        root.Set("top", topArr);
        return JsonSerializer.SerializePretty(root);
    }

    static void Row(Table t, TextStats s) {
        t.AddRow(s.name, Convert.ToString(s.lines), Convert.ToString(s.words), Convert.ToString(s.chars));
    }

    static JsonValue Node(TextStats s) {
        JsonValue o = JsonValue.NewObject();
        o.PutStr("name", s.name);
        o.PutInt("lines", s.lines);
        o.PutInt("words", s.words);
        o.PutInt("chars", s.chars);
        return o;
    }
}
