using System;

/*
 * 命令行参数：Environment.ArgCount() 取个数、ArgAt(i) 取第 i 个、
 * ExeDir() 取程序所在目录。参数在 IDE 的运行设置里配，或在终端里跟在 exe 后面。
 */

class Program {
    static void Main() {
        Console.WriteLine("{{NAME}}：命令行参数演示");
        int argCount = Environment.ArgCount();
        Console.WriteLine($"收到 {argCount} 个参数：");
        for (int i = 0; i < argCount; i++) {
            Console.WriteLine($"  参数[{i}] = {Environment.ArgAt(i)}");
        }
        if (argCount == 0) {
            Console.WriteLine("（没有参数。试试在终端运行：{{NAME}}.exe hello 123）");
        }
        Console.WriteLine($"程序所在目录：{Environment.ExeDir()}");
    }
}
