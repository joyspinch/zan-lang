using System;

/* 一份（或多份累加的）文本统计：行 / 词 / 字符 + 词频表。 */
public class TextStats {
    public string name;
    public int lines;
    public int words;
    public int chars;
    bool ignoreCase;
    Dictionary<string, int> freq;

    public TextStats(bool ignoreCase) {
        this.name = "";
        this.ignoreCase = ignoreCase;
        this.freq = new Dictionary<string, int>();
    }

    /* 累加一段文本。词 = 连续的字母 / 数字 / 下划线 / 非 ASCII 字符。 */
    public void Add(string text) {
        this.chars = this.chars + text.Length;
        if (text.Length > 0) {
            this.lines = this.lines + 1;
        }
        int start = -1;
        for (int i = 0; i <= text.Length; i++) {
            bool inWord = i < text.Length && TextStats.IsWordChar(text[i]);
            if (i < text.Length && text[i] == '\n' && i + 1 < text.Length) {
                this.lines = this.lines + 1;
            }
            if (inWord && start < 0) {
                start = i;
            } else if (!inWord && start >= 0) {
                this.Count(text.Substring(start, i - start));
                start = -1;
            }
        }
    }

    void Count(string word) {
        this.words = this.words + 1;
        string key = this.ignoreCase ? word.ToLower() : word;
        int n = 0;
        if (this.freq.TryGetValue(key, out n)) {
            this.freq[key] = n + 1;
        } else {
            this.freq[key] = 1;
        }
    }

    /* 前 n 个高频词（次数降序，同次数按首次出现顺序）。n 很小，选择法足够。 */
    public List<string> TopWords(int n) {
        List<string> keys = new List<string>();
        foreach (string k in this.freq.Keys) { keys.Add(k); }
        List<string> result = new List<string>();
        while (result.Count < n && keys.Count > 0) {
            int best = 0;
            for (int i = 1; i < keys.Count; i++) {
                if (this.freq[keys[i]] > this.freq[keys[best]]) { best = i; }
            }
            result.Add(keys[best]);
            keys.RemoveAt(best);
        }
        return result;
    }

    public int CountOf(string word) {
        return this.freq[word];
    }

    static bool IsWordChar(char c) {
        return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
            || (c >= '0' && c <= '9') || c == '_' || (int)c > 127;
    }
}
