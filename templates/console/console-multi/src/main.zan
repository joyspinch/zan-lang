using System;
using {{NAME}}.Services;
using {{NAME}}.Cli;

/*
 * 多文件项目示例：一个内存版库存管理器。
 *
 *   src/main.zan                    入口：组装对象、启动命令循环（本文件）
 *   src/Models/Product.zan          数据：商品（namespace {{NAME}}.Models）
 *   src/Services/Inventory.zan      业务：入库 / 出库 / 查询 / 估值（{{NAME}}.Services）
 *   src/Cli/CommandShell.zan        交互：解析命令行文本、调用业务、打印结果（{{NAME}}.Cli）
 *
 * 规则只有两条：
 *   1. src/ 下（含子目录）的所有 .zan 一起编译，IDE 与 zan.proj 会自动全部带上；
 *   2. 跨文件按命名空间引用：`using {{NAME}}.Services;` 之后直接写 Inventory。
 * 目录只是组织方式，命名空间才决定可见名字——两者保持一致最好找。
 *
 * 运行后输入 help 查看命令；也可以把命令写进文件用管道喂进来：
 *   {{NAME}} < commands.txt
 */
public class Program {
    static void Main() {
        Inventory inventory = new Inventory();
        inventory.Receive("苹果", 40, 3.5);
        inventory.Receive("香蕉", 25, 2.0);

        CommandShell shell = new CommandShell(inventory);
        shell.Run();
    }
}
