using System;

/*
 * 多文件项目：入口在 src/main.zan，公共辅助拆到 src/utils.zan。
 * 同一 src/ 下的类直接按类名调用；编译时要把全部 .zan 一起列出来
 * （IDE 与 zan.proj 会自动带上）。
 */

class Program {
    static void Main() {
        Utils.Banner("{{NAME}}");
        int sum = Utils.Add(2, 3);
        Console.WriteLine($"Utils.Add(2, 3) = {sum}");
        Console.WriteLine("再新建一个 .zan 文件、在里面写 class，就能像 Utils 一样直接用。");
    }
}
