using System;
using {{NAME}}.Models;
using {{NAME}}.Services;

namespace {{NAME}}.Cli;

/* 命令循环：读一行 → 拆词 → 分派 → 打印。业务错误（ArgumentException）
 * 在这里统一接住并提示，循环继续，不让一次输错把程序带崩。 */
public class CommandShell {
    Inventory inventory;

    public CommandShell(Inventory inventory) {
        this.inventory = inventory;
    }

    public void Run() {
        Console.WriteLine("库存管理器 —— 输入 help 查看命令，quit 退出。");
        while (true) {
            Console.Write("> ");
            string raw = Console.ReadLine();
            if (raw == null || raw.Length == 0) { break; }  // 输入流结束（EOF）
            string line = raw.Trim();
            if (line == "") { continue; }
            if (line == "quit" || line == "exit") { break; }
            try {
                this.Execute(line.Split(" "));
            } catch (ArgumentException e) {
                Console.ForegroundColor = ConsoleColor.Red;
                Console.WriteLine("错误：" + e.Message);
                Console.ResetColor();
            }
        }
        Console.WriteLine("再见。");
    }

    void Execute(List<string> words) {
        string cmd = words[0];
        if (cmd == "help") {
            Console.WriteLine("  add <名称> <数量> <单价>   入库");
            Console.WriteLine("  ship <名称> <数量>         出库");
            Console.WriteLine("  list                       列出库存");
            Console.WriteLine("  total                      库存总估值");
            Console.WriteLine("  quit                       退出");
        } else if (cmd == "add") {
            CommandShell.Need(words, 4, "add <名称> <数量> <单价>");
            Product p = this.inventory.Receive(words[1], CommandShell.Int(words[2]), CommandShell.Num(words[3]));
            Console.WriteLine($"已入库，{p.Name} 现有 {p.Quantity}");
        } else if (cmd == "ship") {
            CommandShell.Need(words, 3, "ship <名称> <数量>");
            int left = this.inventory.Ship(words[1], CommandShell.Int(words[2]));
            Console.WriteLine($"已出库，{words[1]} 剩余 {left}");
        } else if (cmd == "list") {
            List<Product> all = this.inventory.All();
            if (all.Count == 0) { Console.WriteLine("（库存为空）"); }
            for (int i = 0; i < all.Count; i++) {
                Product p = all[i];
                Console.WriteLine($"  {p.Name}  数量 {p.Quantity}  单价 {p.UnitPrice}  小计 {p.Value()}");
            }
        } else if (cmd == "total") {
            Console.WriteLine($"库存总估值：{this.inventory.TotalValue()}");
        } else {
            throw new ArgumentException("未知命令 " + cmd + "（输入 help 查看）");
        }
    }

    static void Need(List<string> words, int count, string usage) {
        if (words.Count < count) { throw new ArgumentException("用法：" + usage); }
    }

    static int Int(string s) {
        int v = 0;
        if (!int.TryParse(s, out v)) { throw new ArgumentException("不是整数：" + s); }
        return v;
    }

    static double Num(string s) {
        double v = 0.0;
        if (!double.TryParse(s, out v)) { throw new ArgumentException("不是数字：" + s); }
        return v;
    }
}
