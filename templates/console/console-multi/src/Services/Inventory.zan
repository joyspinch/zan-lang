using System;
using {{NAME}}.Models;

namespace {{NAME}}.Services;

/* 库存业务：所有规则（数量为正、出库不能超存、价格取最新）集中在这里，
 * 交互层只负责把用户输入翻译成这些调用。 */
public class Inventory {
    List<Product> products;

    public Inventory() {
        this.products = new List<Product>();
    }

    /* 入库：已有商品累加数量并更新单价，没有就新建。 */
    public Product Receive(string name, int quantity, double unitPrice) {
        if (quantity <= 0) { throw new ArgumentException("入库数量必须大于 0"); }
        if (unitPrice < 0) { throw new ArgumentException("单价不能为负"); }
        Product p = this.Find(name);
        if (p == null) {
            p = new Product(name, quantity, unitPrice);
            this.products.Add(p);
        } else {
            p.Quantity = p.Quantity + quantity;
            p.UnitPrice = unitPrice;
        }
        return p;
    }

    /* 出库：数量不够时拒绝；出到 0 自动下架。返回剩余数量。 */
    public int Ship(string name, int quantity) {
        Product p = this.Find(name);
        if (p == null) { throw new ArgumentException("没有这个商品：" + name); }
        if (quantity <= 0) { throw new ArgumentException("出库数量必须大于 0"); }
        if (quantity > p.Quantity) {
            throw new ArgumentException(name + " 库存只有 " + Convert.ToString(p.Quantity));
        }
        p.Quantity = p.Quantity - quantity;
        if (p.Quantity == 0) { this.products.Remove(p); }
        return p.Quantity;
    }

    public Product Find(string name) {
        for (int i = 0; i < this.products.Count; i++) {
            if (this.products[i].Name == name) { return this.products[i]; }
        }
        return null;
    }

    public List<Product> All() {
        return this.products;
    }

    /* 全部库存估值。 */
    public double TotalValue() {
        double sum = 0.0;
        for (int i = 0; i < this.products.Count; i++) {
            sum = sum + this.products[i].Value();
        }
        return sum;
    }
}
