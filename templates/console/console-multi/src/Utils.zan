using System;

/* 跨文件使用的辅助类：与 main.zan 同在 src/ 下即可互相调用。 */
class Utils {
    static void Banner(string title) {
        Console.ForegroundColor = ConsoleColor.Cyan;
        Console.WriteLine("=============================");
        Console.WriteLine("  " + title);
        Console.WriteLine("=============================");
        Console.ResetColor();
    }

    static int Add(int a, int b) {
        return a + b;
    }
}
