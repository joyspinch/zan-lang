using System;

/*
 * 控制台能力演示 —— 一个程序走完 System.Console 的常用能力：
 * 输出与插值、颜色、窗口标题、命令行参数、清屏、读一行、读单键。
 * 每一节都能单独摘出去用，运行起来跟着提示走一遍即可。
 */

class Program {
    static void Main() {
        /* 窗口标题：OSC 转义序列实现，只支持设置、不支持读回。 */
        Console.Title = "{{NAME}} — Zan 控制台能力演示";

        Section("0. WriteLine / Write / 字符串插值");
        Console.WriteLine("Hello from {{NAME}}!");
        Console.Write("Write 不换行；");
        Console.WriteLine("WriteLine 才换行。");
        int a = 6;
        int b = 7;
        Console.WriteLine($"插值字符串：{a} x {b} = {a * b}");
        Console.WriteLine("转义符：\t制表符、\\反斜杠、\"引号\"。");

        Section("1. 颜色 ForegroundColor / BackgroundColor / ResetColor");
        Console.ForegroundColor = ConsoleColor.Yellow;
        Console.WriteLine("黄色前景（ConsoleColor.Yellow）");
        Console.ForegroundColor = ConsoleColor.Green;
        Console.WriteLine("绿色前景（再赋值即换色）");
        Console.BackgroundColor = ConsoleColor.DarkBlue;
        Console.ForegroundColor = ConsoleColor.White;
        Console.WriteLine("蓝底白字（两个通道同时设置）");
        Console.ResetColor();
        Console.WriteLine("ResetColor() 已恢复默认配色。");

        Section("2. 命令行参数 Environment.ArgCount / ArgAt / ExeDir");
        int argCount = Environment.ArgCount();
        Console.WriteLine($"启动参数 {argCount} 个：");
        for (int i = 0; i < argCount; i++) {
            Console.WriteLine($"  参数[{i}] = {Environment.ArgAt(i)}");
        }
        if (argCount == 0) {
            Console.WriteLine("  （本次无参数；试试在终端运行 {{NAME}}.exe one two）");
        }
        Console.WriteLine($"程序所在目录：{Environment.ExeDir()}");

        Section("3. 清屏 Console.Clear");
        Console.WriteLine("马上清屏并重画横幅 —— 之前的输出会全部消失：");
        Console.Clear();
        Banner("清屏完成，屏幕已重置");

        Section("4. 读一行 Console.ReadLine");
        Console.Write("你叫什么名字？直接回车跳过 > ");
        string name = Console.ReadLine().Trim();
        if (name == "") { name = "陌生人"; }
        Console.WriteLine($"你好，{name}！这就是一个交互式 Zan 程序的全部。");

        Section("5. 读单个键 Console.ReadKey");
        Console.WriteLine("按任意键（不回显），程序打印键值后退出…");
        int key = Console.ReadKey(true);
        Console.WriteLine("");
        if (key == 13) {
            Console.WriteLine("  Enter，键值 13");
        } else if (key == 27) {
            Console.WriteLine("  Esc，键值 27");
        } else if (key == 32) {
            Console.WriteLine("  空格，键值 32");
        } else if (key >= 33 && key <= 126) {
            char ch = (char)key;
            Console.WriteLine("  键值 " + key + "，字符 '" + ch + "'");
        } else {
            Console.WriteLine($"  键值 {key}");
        }

        Console.ResetColor();
    }

    /* 小节标题：青色分隔行，ResetColor 收尾。 */
    static void Section(string title) {
        Console.WriteLine("");
        Console.ForegroundColor = ConsoleColor.Cyan;
        Console.WriteLine("──────── " + title + " ────────");
        Console.ResetColor();
    }

    static void Banner(string text) {
        Console.ForegroundColor = ConsoleColor.Cyan;
        Console.WriteLine("=============================");
        Console.WriteLine("  " + text);
        Console.WriteLine("=============================");
        Console.ResetColor();
    }
}
