using Gui;

partial class CommandBarHost {
    static void Software() { MainForm.OpenCommand(0); }
    static void Scene() { MainForm.OpenCommand(1); }
    static void Blacklist() { MainForm.OpenCommand(2); }
    static void Title() { MainForm.OpenCommand(3); }
    static void Schedule() { MainForm.OpenCommand(4); }
    static void Access() { MainForm.OpenCommand(5); }
    static void Site() { MainForm.OpenCommand(6); }
    static void Shop() { MainForm.OpenCommand(7); }
    static void Report() { MainForm.OpenCommand(8); }
    static void Clear() { MainForm.OpenCommand(9); }
    static void Web() { MainForm.OpenCommand(10); }
    static void Settings() { MainForm.OpenCommand(11); }
    static void Help() { MainForm.OpenCommand(12); }

    void OnInit() {
        this.SoftwareButton.Click += CommandBarHost.Software;
        this.SceneButton.Click += CommandBarHost.Scene;
        this.BlacklistButton.Click += CommandBarHost.Blacklist;
        this.TitleButton.Click += CommandBarHost.Title;
        this.ScheduleButton.Click += CommandBarHost.Schedule;
        this.AccessButton.Click += CommandBarHost.Access;
        this.SiteButton.Click += CommandBarHost.Site;
        this.ShopButton.Click += CommandBarHost.Shop;
        this.ReportButton.Click += CommandBarHost.Report;
        this.ClearButton.Click += CommandBarHost.Clear;
        this.WebButton.Click += CommandBarHost.Web;
        this.SettingsButton.Click += CommandBarHost.Settings;
        this.HelpButton.Click += CommandBarHost.Help;
    }

    override void OnPaint(App app) {
        MainForm.RenderCommandMenu(app);
    }
}
