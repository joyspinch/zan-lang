using System;
using Gui;
using Gui.Widget;
using OnePlus.Pages;

partial class CampGroupPage {
    static CampGroupPage current;

    void OnInit() {
        CampGroupPage.current = this;
        this.LoadButton.Click += CampGroupPage.Load;
        this.QuickButton.Click += CampGroupPage.Quick;
        this.ConfigButton.Click += CampGroupPage.Config;
        this.ConfigButton.Icon = "table";
        this.ConfigButton.Tip = "表格样式/列配置";
    }

    static void Load() {
        if (CampGroupPage.current != null) {
            MainForm.SetStatus("计划组报表已加载（假数据）");
        }
    }

    static void Quick() {
        if (CampGroupPage.current != null) {
            MainForm.SetStatus("快捷日期：今日（仅演示）");
        }
    }

    static void Config() {
        if (CampGroupPage.current != null) {
            MainForm.SetStatus("未实现/仅演示：表格样式");
        }
    }
}
