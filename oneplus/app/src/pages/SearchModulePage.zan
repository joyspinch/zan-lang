using System;
using Gui;
using Gui.Widget;
using OnePlus.Model;
using OnePlus.Pages;

partial class SearchModulePage {
    static SearchModulePage current;
    static ToolDef tool;
    static string activeKind;

    void OnInit() {
        SearchModulePage.current = this;
        SearchModulePage.tool = ToolRegistry.All()[0];
        SearchModulePage.activeKind = "plan";
        this.ShowKind("plan");
    }

    void SetRouteStatus(string text) {
        if (text != "") { this.RibbonTitle.SetProp("text", text); }
    }

    static void Show(string kind) {
        if (SearchModulePage.current == null) { return; }
        SearchModulePage.current.ShowKind(kind);
    }

    void SetTool(ToolDef value) {
        SearchModulePage.current = this;
        SearchModulePage.tool = value;
        if (value != null && value.objectKinds.Count > 0) {
            this.ShowKind(value.objectKinds[0]);
        }
    }

    void ShowKind(string kind) {
        this.Body.RemoveAll();
        SearchModulePage.activeKind = kind;
        if (kind == "planGroup") {
            CampGroupPage page = new CampGroupPage();
            page.Dock(Dock.Fill());
            this.Body.Add(page);
        } else if (kind == "plan") {
            CampListPage page = new CampListPage();
            page.Dock(Dock.Fill());
            this.Body.Add(page);
        } else if (kind == "adGroup") {
            AdGroupPage page = new AdGroupPage();
            page.Dock(Dock.Fill());
            this.Body.Add(page);
        } else if (kind == "keyword") {
            KeywordPage page = new KeywordPage();
            page.Dock(Dock.Fill());
            this.Body.Add(page);
        } else if (kind == "crowd") {
            CrowdPage page = new CrowdPage();
            page.Dock(Dock.Fill());
            this.Body.Add(page);
        } else if (kind == "adzone") {
            AdzonePage page = new AdzonePage();
            page.Dock(Dock.Fill());
            this.Body.Add(page);
        } else if (kind == "creative") {
            CreativePage page = new CreativePage();
            page.Dock(Dock.Fill());
            this.Body.Add(page);
        } else if (kind == "optimize") {
            OptimizePage page = new OptimizePage();
            page.Dock(Dock.Fill());
            this.Body.Add(page);
        } else {
            ToolPage page = new ToolPage(SearchModulePage.tool);
            page.Dock(Dock.Fill());
            this.Body.Add(page);
            page.ShowObjectKind(kind);
        }
    }
}
