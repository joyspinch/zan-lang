using System;
using Gui;
using Gui.Component.DataTable;
using OnePlus.Model;
using OnePlus.Pages;

class CampGridHost : Control {
    GridPane<PlanRow> pane;

    CampGridHost() {
        this.InitControl("reference-camp-grid", 5);
        this.pane = new GridPane<PlanRow>("计划", "onebpSearch", "plan",
            GridColumns.CampPlans(), FakeRows.Plans(),
            (r, f, v) => GridColumns.SetMetric(r, f, v),
            (r, f) => GridColumns.ReadMetric(r, f));
        this.pane.Dock(Dock.Fill());
        this.Add(this.pane);
    }

    override void OnPaint(App app) {
        this.pane.ActivateRoute();
    }
}

class CampGroupGridHost : Control {
    GridPane<PlanGroupRow> pane;

    CampGroupGridHost() {
        this.InitControl("reference-camp-group-grid", 5);
        this.pane = new GridPane<PlanGroupRow>("计划组", "onebpSearch",
            "planGroup", GridColumns.CampGroups(), FakeRows.PlanGroups(),
            (r, f, v) => GridColumns.SetMetric(r, f, v),
            (r, f) => GridColumns.ReadMetric(r, f));
        this.pane.Dock(Dock.Fill());
        this.Add(this.pane);
    }

    override void OnPaint(App app) {
        this.pane.ActivateRoute();
    }
}
