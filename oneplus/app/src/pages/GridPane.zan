using System;
using Gui;
using Gui.Widget;
using Gui.Component.DataTable;
using OnePlus.Menu;

namespace OnePlus.Pages;

delegate void GridWrite<T>(T row, string field, string value);
delegate double GridRead<T>(T row, string field);

/// 泛型表格页：每个对象类型只负责实体、列定义和写回访问器。
class GridPane<T> : ObjectPane {
    DataGrid<T> grid;
    List<T> rows;
    GridWrite<T> writer;
    GridRead<T> reader;
    string bizCode;
    string objectKind;
    static GridPane<T> current;

    GridPane(string title, string biz, string kind, DataGrid<T> g,
             List<T> src, GridWrite<T> w, GridRead<T> r) : base(title) {
        this.InitControl("oneplus-grid-pane", 5);
        grid = g;
        rows = src;
        writer = w;
        reader = r;
        bizCode = biz;
        objectKind = kind;
        grid.Bind(rows);
        grid.ExternalRowMenu(true).OnRowContext(GridPane<T>.OnContext);
        this.With(grid);
    }

    static void OnContext() {
        if (GridPane<T>.current == null) { return; }
        DataTableState st = GridPane<T>.current.grid.State();
        OnePlus.Pages.ToolPage.OpenMenu(GridPane<T>.current,
            st.CtxX(), st.CtxY());
    }

    DataGrid<T> Grid() { return grid; }
    override int SelectedCount() {
        return grid.State().SelectedRowIndices().Count;
    }

    override void WriteField(string field, string value) {
        if (writer == null) { return; }
        List<int> selected = grid.State().SelectedRowIndices();
        for (int i = 0; i < selected.Count; i = i + 1) {
            int at = selected[i];
            if (at >= 0 && at < rows.Count) {
                writer(rows[at], field, value);
            }
        }
        grid.State().dirty = true;
    }

    override void ScaleField(string field, double factor) {
        if (writer == null || reader == null) { return; }
        List<int> selected = grid.State().SelectedRowIndices();
        for (int i = 0; i < selected.Count; i = i + 1) {
            int at = selected[i];
            if (at >= 0 && at < rows.Count) {
                double oldValue = reader(rows[at], field);
                double nextValue = Math.Round(oldValue * factor, 2);
                writer(rows[at], field, Convert.ToString(nextValue));
            }
        }
        grid.State().dirty = true;
    }

    override void Configure(bool striped, bool rowNumbers, bool summary,
                            bool filterRow) {
        grid.State().striped = striped;
        grid.State().showRowNum = rowNumbers;
        grid.State().showSummary = summary;
        grid.State().showFilterRow = filterRow;
    }

    override void Refresh() {
        grid.State().dirty = true;
    }

    override void ActivateRoute() {
        GridPane<T>.current = this;
    }

    override string BizCode() { return bizCode; }
    override string ObjectKind() { return objectKind; }
}
