using System;
using Gui;
using Gui.Component.DataTable;
using OnePlus.Model;

class AdGroupObjectHost : Control {
    GridPane<AdGroupRow> pane;
    AdGroupObjectHost() {
        this.InitControl("ad-group-object-host", 5);
        pane = new GridPane<AdGroupRow>("主体", "onebpSearch", "adGroup",
            GridColumns.AdGroups(), FakeRows.AdGroups(),
            (r, f, v) => GridColumns.SetMetric(r, f, v),
            (r, f) => GridColumns.ReadMetric(r, f));
        pane.Dock(Dock.Fill()); this.Add(pane);
    }
    override void OnPaint(App app) { pane.ActivateRoute(); }
}

