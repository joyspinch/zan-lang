using Gui;

partial class OnePlusRibbonGroup {
    void OnInit() {
        this.PlanGroupBtn.Click += OnePlusRibbonGroup.PlanGroup;
        this.PlanBtn.Click += OnePlusRibbonGroup.Plan;
        this.AdGroupBtn.Click += OnePlusRibbonGroup.AdGroup;
        this.KeywordBtn.Click += OnePlusRibbonGroup.Keyword;
        this.CrowdBtn.Click += OnePlusRibbonGroup.Crowd;
        this.AdzoneBtn.Click += OnePlusRibbonGroup.Adzone;
        this.CreativeBtn.Click += OnePlusRibbonGroup.Creative;
        this.OptimizeBtn.Click += OnePlusRibbonGroup.Optimize;
    }

    static void PlanGroup() { SearchModulePage.Show("planGroup"); }
    static void Plan() { SearchModulePage.Show("plan"); }
    static void AdGroup() { SearchModulePage.Show("adGroup"); }
    static void Keyword() { SearchModulePage.Show("keyword"); }
    static void Crowd() { SearchModulePage.Show("crowd"); }
    static void Adzone() { SearchModulePage.Show("adzone"); }
    static void Creative() { SearchModulePage.Show("creative"); }
    static void Optimize() { SearchModulePage.Show("optimize"); }
}
