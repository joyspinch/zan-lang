using Gui;
using Gui.Widget;

/// 复刻原版业务功能区：大图标+标题的 Office 风格命令条
/// （计划组/计划/主体/关键词/人群/资源位/创意/一键优化）。
class ModuleRibbon : Control {
    List<RibbonCmd> cmds;
    List<string> kinds;

    ModuleRibbon() {
        this.InitControl("module-ribbon", 5);
        this.cmds = new List<RibbonCmd>();
        this.kinds = new List<string>();
        this.AddCmd("grid", "计划组", "planGroup");
        this.AddCmd("layout", "计划", "plan");
        this.AddCmd("archive", "主体", "adGroup");
        this.AddCmd("search", "关键词", "keyword");
        this.AddCmd("user", "人群", "crowd");
        this.AddCmd("image", "资源位", "adzone");
        this.AddCmd("edit", "创意", "creative");
        this.AddCmd("star", "一键优化", "optimize");
    }

    void AddCmd(string icon, string label, string kind) {
        this.cmds.Add(new RibbonCmd(icon, label));
        this.kinds.Add(kind);
    }

    override void OnMeasure(App app) {
        prefW = app.Scale(520);
        prefH = Ribbon.Height(app);
    }

    override void OnPaint(App app) {
        for (int i = 0; i < cmds.Count; i = i + 1) {
            cmds[i].SetOn(kinds[i] == SearchModulePage.ActiveKind());
        }
        int hit = Ribbon.Render(app, bx, by, bw, bh, cmds);
        if (hit >= 0 && hit < kinds.Count) {
            SearchModulePage.Show(kinds[hit]);
        }
    }
}

partial class OnePlusRibbonGroup {
    void OnInit() {
        ModuleRibbon ribbon = new ModuleRibbon();
        ribbon.Dock(Dock.Fill());
        this.RibbonButtons.Add(ribbon);
    }
}
