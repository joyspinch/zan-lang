using System;
using Gui;
using OnePlus.Pages;

partial class WideReferenceToolbar {
    static WideReferenceToolbar current;

    void OnInit() {
        WideReferenceToolbar.current = this;
        this.ConfigButton.Icon = "table";
        this.ConfigButton.Tip = "表格样式/列配置";
        this.LoadButton.Click += WideReferenceToolbar.Load;
        this.QuickButton.Click += WideReferenceToolbar.Quick;
        this.ConfigButton.Click += WideReferenceToolbar.Config;
        this.StartDate.OnChange(WideReferenceToolbar.RangeChanged);
        this.EndDate.OnChange(WideReferenceToolbar.RangeChanged);
    }

    static void RangeChanged() {
        WideReferenceToolbar t = WideReferenceToolbar.current;
        if (t == null) { return; }
        MainForm.SetStatus("日期范围 " + t.StartDate.Text() + " 至 " +
            t.EndDate.Text() + "，点击「加载报表」刷新");
    }

    static void Load() {
        WideReferenceToolbar t = WideReferenceToolbar.current;
        if (t == null) { return; }
        MainForm.SetStatus("报表已加载 " + t.StartDate.Text() + " 至 " +
            t.EndDate.Text() + "（假数据）");
    }

    static void Quick() {
        WideReferenceToolbar t = WideReferenceToolbar.current;
        if (t == null) { return; }
        DateTime today = DateTime.Now();
        t.StartDate.SetDate(today);
        t.EndDate.SetDate(today);
        MainForm.SetStatus("快捷日期：今日 " + today.ToDateString());
    }

    static void Config() {
        MainForm.SetStatus("未实现/仅演示：表格样式/列配置");
    }
}
