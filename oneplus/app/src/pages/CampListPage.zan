using System;
using Gui;
using Gui.Widget;

partial class CampListPage {
    static CampListPage current;

    void OnInit() {
        CampListPage.current = this;
        this.LoadButton.Click += CampListPage.Load;
        this.QuickButton.Click += CampListPage.Quick;
        this.ConfigButton.Click += CampListPage.Config;
        this.ConfigButton.Icon = "table";
        this.ConfigButton.Tip = "表格样式/列配置";
    }

    static void Load() {
        if (CampListPage.current != null) {
            MainForm.SetStatus("计划报表已加载（假数据）");
        }
    }

    static void Quick() {
        if (CampListPage.current != null) {
            MainForm.SetStatus("快捷日期：今日（仅演示）");
        }
    }

    static void Config() {
        if (CampListPage.current != null) {
            MainForm.SetStatus("未实现/仅演示：表格样式");
        }
    }
}
