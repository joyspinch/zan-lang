using System;
using Gui;
using Gui.Widget;
using Gui.Component.DataTable;
using OnePlus.Model;
using OnePlus.Menu;

namespace OnePlus.Pages;

/// 一个推广工具的统一工作台：左侧对象导航，右侧泛型表格页。
class ToolPage : Control {
    ToolDef tool;
    List<ObjectKind> kinds;
    ListView<ObjectKind> nav;
    Panel paneHost;
    ObjectPane activePane;
    List<ObjectPane> cachedPanes;
    static ToolPage current;
    static bool menuOpen;
    static int menuX;
    static int menuY;
    static List<MenuAction> menuActions;
    static List<MenuAction> menuResolved;
    static ObjectPane menuPane;
    static SignalInt menuAction;
    static SignalInt menuSub;
    static SignalBool menuFlag;

    ToolPage(ToolDef t) {
        this.InitControl("oneplus-tool-page", 5);
        tool = t;
        kinds = new List<ObjectKind>();
        cachedPanes = new List<ObjectPane>();
        for (int i = 0; i < tool.objectKinds.Count; i = i + 1) {
            kinds.Add(ObjectKind.Find(tool.objectKinds[i]));
            cachedPanes.Add(null);
        }
        nav = new ListView<ObjectKind>(
            new ListColumn<ObjectKind>("对象类型", r => r.title));
        nav.Bind(kinds).OnSelect(ToolPage.OnNav).EmptyText("暂无对象");
        nav.Dock(Dock.Left());
        nav.Prefer(220, 0);
        paneHost = Panel.Root("pane-host");
        paneHost.Dock(Dock.Fill());
        Panel split = Panel.Root("tool-split");
        split.Dock(Dock.Fill());
        split.With(nav).With(paneHost);
        this.With(split);
        if (ToolPage.menuAction == null) {
            ToolPage.menuAction = new SignalInt(-1);
            ToolPage.menuSub = new SignalInt(-1);
            ToolPage.menuFlag = new SignalBool(false);
            ToolPage.menuResolved = new List<MenuAction>();
        }
        ToolPage.current = this;
        if (kinds.Count > 0) {
            this.ShowKind(kinds[0].id);
        }
    }

    static void OnNav() {
        if (ToolPage.current == null) { return; }
        int at = ToolPage.current.nav.SelectedIndex();
        if (at >= 0 && at < ToolPage.current.kinds.Count) {
            ToolPage.current.ShowKind(ToolPage.current.kinds[at].id);
        }
    }

    void ShowKind(string kind) {
        int kindAt = -1;
        for (int i = 0; i < kinds.Count; i = i + 1) {
            if (kinds[i].id == kind) { kindAt = i; }
        }
        if (kindAt < 0) { return; }
        ObjectPane pane = cachedPanes[kindAt];
        if (pane == null) {
            pane = this.BuildPane(kind);
            cachedPanes[kindAt] = pane;
        }
        if (pane == null) { return; }
        paneHost.RemoveAll();
        paneHost.Add(pane);
        pane.Dock(Dock.Fill());
        activePane = pane;
        ToolPage.current = this;
    }

    ObjectPane BuildPane(string kind) {
        string b = tool.bizCode;
        if (kind == "planGroup") {
            return new GridPane<PlanGroupRow>("计划组", b, kind,
                GridColumns.PlanGroups(), FakeRows.PlanGroups(),
                (r, f, v) => GridColumns.SetMetric(r, f, v),
                (r, f) => GridColumns.ReadMetric(r, f));
        }
        if (kind == "plan") {
            return new GridPane<PlanRow>("计划", b, kind,
                GridColumns.Plans(), FakeRows.Plans(),
                (r, f, v) => GridColumns.SetMetric(r, f, v),
                (r, f) => GridColumns.ReadMetric(r, f));
        }
        if (kind == "adGroup") {
            return new GridPane<AdGroupRow>("推广单元", b, kind,
                GridColumns.AdGroups(), FakeRows.AdGroups(),
                (r, f, v) => GridColumns.SetMetric(r, f, v),
                (r, f) => GridColumns.ReadMetric(r, f));
        }
        if (kind == "keyword") {
            return new GridPane<KeywordRow>("关键词", b, kind,
                GridColumns.Keywords(), FakeRows.Keywords(),
                (r, f, v) => GridColumns.SetKeyword(r, f, v),
                (r, f) => GridColumns.ReadMetric(r, f));
        }
        if (kind == "wordPackage") {
            return new GridPane<WordPackageRow>("词包", b, kind,
                GridColumns.WordPackages(), FakeRows.WordPackages(),
                (r, f, v) => GridColumns.SetMetric(r, f, v),
                (r, f) => GridColumns.ReadMetric(r, f));
        }
        if (kind == "crowd") {
            return new GridPane<CrowdRow>("人群", b, kind,
                GridColumns.Crowds(), FakeRows.Crowds(),
                (r, f, v) => GridColumns.SetMetric(r, f, v),
                (r, f) => GridColumns.ReadMetric(r, f));
        }
        if (kind == "adzone") {
            return new GridPane<AdzoneRow>("资源位", b, kind,
                GridColumns.Adzones(), FakeRows.Adzones(),
                (r, f, v) => GridColumns.SetMetric(r, f, v),
                (r, f) => GridColumns.ReadMetric(r, f));
        }
        if (kind == "creative") {
            return new GridPane<CreativeRow>("创意", b, kind,
                GridColumns.Creatives(), FakeRows.Creatives(),
                (r, f, v) => GridColumns.SetMetric(r, f, v),
                (r, f) => GridColumns.ReadMetric(r, f));
        }
        if (kind == "siteAdGroup") {
            return new GridPane<SiteAdGroupRow>("全站主体", b, kind,
                GridColumns.SiteAdGroups(), FakeRows.SiteAdGroups(),
                (r, f, v) => GridColumns.SetMetric(r, f, v),
                (r, f) => GridColumns.ReadMetric(r, f));
        }
        return new GridPane<CrowdTrimRow>("精细化调控", b, kind,
            GridColumns.CrowdTrims(), FakeRows.CrowdTrims(),
            (r, f, v) => GridColumns.SetMetric(r, f, v),
            (r, f) => GridColumns.ReadMetric(r, f));
    }

    static void OpenMenu(ObjectPane pane, int x, int y) {
        if (ToolPage.current == null || pane == null) { return; }
        string biz = pane.BizCode();
        string kind = pane.ObjectKind();
        ToolPage.menuActions = MenuRegistry.For(biz, kind);
        ToolPage.menuPane = pane;
        ToolPage.menuX = x;
        ToolPage.menuY = y;
        ToolPage.menuOpen = true;
        ToolPage.menuFlag.Set(true);
        ToolPage.menuAction.Set(-1);
        ToolPage.menuSub.Set(-1);
    }

    static int AddResolved(MenuAction action) {
        ToolPage.menuResolved.Add(action);
        return ToolPage.menuResolved.Count - 1;
    }

    static List<MenuItem> ChildItems(List<MenuAction> actions, int selected) {
        List<MenuItem> result = new List<MenuItem>();
        for (int i = 0; i < actions.Count; i = i + 1) {
            MenuAction a = actions[i];
            if (a.children.Count > 0) {
                result.Add(MenuItem.Submenu(a.title, a.icon,
                    ToolPage.ChildItems(a.children, selected)));
                continue;
            }
            int token = ToolPage.AddResolved(a);
            if (a.needsRows && selected == 0) {
                result.Add(MenuItem.Disabled(a.title, a.icon, token));
            } else if (a.danger) {
                result.Add(MenuItem.Danger(a.title, a.icon, token));
            } else {
                result.Add(MenuItem.Item(a.title, a.icon, token));
            }
        }
        return result;
    }

    override void OnPaint(App app) {
        ToolPage.current = this;
        if (activePane != null) { activePane.ActivateRoute(); }
        if (!ToolPage.menuOpen || ToolPage.menuPane == null) { return; }
        List<MenuItem> items = new List<MenuItem>();
        items.Add(MenuItem.Header(tool.title + " · 批量操作"));
        int selected = ToolPage.menuPane.SelectedCount();
        string lastGroup = "";
        ToolPage.menuResolved = new List<MenuAction>();
        for (int i = 0; i < ToolPage.menuActions.Count; i = i + 1) {
            MenuAction a = ToolPage.menuActions[i];
            if (a.group != lastGroup) {
                if (lastGroup != "") { items.Add(MenuItem.Separator()); }
                items.Add(MenuItem.Header(a.group));
                lastGroup = a.group;
            }
            if (a.children.Count > 0) {
                List<MenuItem> kids = ToolPage.ChildItems(a.children, selected);
                items.Add(MenuItem.Submenu(a.title, a.icon, kids));
                continue;
            }
            int token = ToolPage.AddResolved(a);
            if (a.needsRows && selected == 0) {
                items.Add(MenuItem.Disabled(a.title, a.icon, token));
            } else if (a.danger) {
                items.Add(MenuItem.Danger(a.title, a.icon, token));
            } else {
                items.Add(MenuItem.Item(a.title, a.icon, token));
            }
        }
        app.AddOverlay(OverlayPopup.RichMenu(ToolPage.menuX, ToolPage.menuY,
            items, 710000, ToolPage.menuAction, ToolPage.menuFlag,
            ToolPage.menuSub));
        int picked = ToolPage.menuAction.Get();
        if (picked >= 0 && picked < ToolPage.menuResolved.Count) {
            ToolPage.menuOpen = false;
            ToolPage.menuFlag.Set(false);
            ActionHost.Execute(ToolPage.menuResolved[picked], ToolPage.menuPane);
            ToolPage.menuAction.Set(-1);
        }
    }

    static ToolPage Current() { return ToolPage.current; }
}
