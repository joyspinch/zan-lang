using Gui;
using OnePlus.Pages;

partial class ReferenceToolbar {
    static ReferenceToolbar current;

    void OnInit() {
        ReferenceToolbar.current = this;
        this.ConfigButton.Icon = "table";
        this.ConfigButton.Tip = "表格样式/列配置";
        this.LoadButton.Click += ReferenceToolbar.Load;
        this.QuickButton.Click += ReferenceToolbar.Quick;
        this.ConfigButton.Click += ReferenceToolbar.Config;
    }

    static void Load() {
        MainForm.SetStatus("报表已加载（假数据）");
    }

    static void Quick() {
        MainForm.SetStatus("快捷日期：今日（仅演示）");
    }

    static void Config() {
        MainForm.SetStatus("未实现/仅演示：表格样式/列配置");
    }
}
