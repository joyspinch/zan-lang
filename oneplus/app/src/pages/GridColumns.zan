using System;
using Gui;
using Gui.Widget;
using Gui.Component.DataTable;
using OnePlus.Model;

namespace OnePlus.Pages;

/// 所有对象类型的中文列定义集中在这里，便于后续接入真实字段。
class GridColumns {
    static string Name(MetricRow r) { return r.name; }
    static string State(MetricRow r) { return r.state; }
    static double Budget(MetricRow r) { return r.budget; }
    static double Bid(MetricRow r) { return r.bid; }
    static double Premium(MetricRow r) { return r.premium; }
    static double Spend(MetricRow r) { return r.spend; }
    static int Clicks(MetricRow r) { return r.clicks; }
    static int Conversions(MetricRow r) { return r.conversions; }

    static double ReadMetric(MetricRow r, string field) {
        if (field == "budget") { return GridColumns.Budget(r); }
        if (field == "bid") { return GridColumns.Bid(r); }
        if (field == "premium") { return GridColumns.Premium(r); }
        if (field == "spend") { return GridColumns.Spend(r); }
        return 0.0;
    }

    static void SetMetric(MetricRow r, string field, string value) {
        if (field == "budget") { r.budget = Convert.ToDouble(value); }
        else if (field == "bid") { r.bid = Convert.ToDouble(value); }
        else if (field == "premium") { r.premium = Convert.ToDouble(value); }
        else if (field == "state") { r.state = value; }
    }

    static void SetKeyword(KeywordRow r, string field, string value) {
        GridColumns.SetMetric(r, field, value);
        if (field == "matchType") { r.matchType = value; }
    }

    static DataGrid<T> Base<T>() {
        DataGrid<T> g = new DataGrid<T>();
        return g;
    }

    static void Common<T>(DataGrid<T> g,
                          GridText<T> name,
                          GridText<T> state,
                          GridReal<T> spend,
                          GridInt<T> clicks,
                          GridInt<T> conversions) {
        g.Col("名称", 220, name);
        g.Col("状态", 90, state);
        g.RealCol("花费", 100, 2, spend).Money("¥").Sum();
        g.NumCol("点击", 80, clicks).Sum();
        g.NumCol("转化", 80, conversions).Sum();
    }

    static void Finish<T>(DataGrid<T> g) {
        g.Selectable(true).RowNumbers(true).Striped(true).Summary(true)
            .FilterRow(true);
    }

    static DataGrid<PlanGroupRow> PlanGroups() {
        DataGrid<PlanGroupRow> g = GridColumns.Base<PlanGroupRow>();
        GridColumns.Common<PlanGroupRow>(g, r => r.name, r => r.state,
            r => r.spend, r => r.clicks, r => r.conversions);
        g.RealCol("日限额", 100, 2, r => r.budget).Money("¥").Sum();
        g.RealCol("出价", 90, 2, r => r.bid).Money("¥").Avg();
        GridColumns.Finish<PlanGroupRow>(g);
        return g;
    }

    static DataGrid<PlanRow> Plans() {
        DataGrid<PlanRow> g = GridColumns.Base<PlanRow>();
        GridColumns.Common<PlanRow>(g, r => r.name, r => r.state,
            r => r.spend, r => r.clicks, r => r.conversions);
        g.RealCol("日限额", 100, 2, r => r.budget).Money("¥").Sum();
        g.RealCol("出价", 90, 2, r => r.bid).Money("¥").Avg();
        GridColumns.Finish<PlanRow>(g);
        return g;
    }

    static DataGrid<AdGroupRow> AdGroups() {
        DataGrid<AdGroupRow> g = GridColumns.Base<AdGroupRow>();
        GridColumns.Common<AdGroupRow>(g, r => r.name, r => r.state,
            r => r.spend, r => r.clicks, r => r.conversions);
        g.RealCol("出价", 90, 2, r => r.bid).Money("¥").Avg();
        g.RealCol("溢价", 90, 1, r => r.premium).Percent().Avg();
        GridColumns.Finish<AdGroupRow>(g);
        return g;
    }

    static DataGrid<KeywordRow> Keywords() {
        DataGrid<KeywordRow> g = GridColumns.Base<KeywordRow>();
        GridColumns.Common<KeywordRow>(g, r => r.name, r => r.state,
            r => r.spend, r => r.clicks, r => r.conversions);
        g.RealCol("出价", 90, 2, r => r.bid).Money("¥").Avg();
        g.RealCol("质量分", 90, 1, r => r.qualityScore).Avg();
        g.Col("匹配方式", 100, r => r.matchType);
        GridColumns.Finish<KeywordRow>(g);
        return g;
    }

    static DataGrid<WordPackageRow> WordPackages() {
        DataGrid<WordPackageRow> g = GridColumns.Base<WordPackageRow>();
        GridColumns.Common<WordPackageRow>(g, r => r.name, r => r.state,
            r => r.spend, r => r.clicks, r => r.conversions);
        g.NumCol("词数", 80, r => r.wordCount).Sum();
        GridColumns.Finish<WordPackageRow>(g);
        return g;
    }

    static DataGrid<CrowdRow> Crowds() {
        DataGrid<CrowdRow> g = GridColumns.Base<CrowdRow>();
        GridColumns.Common<CrowdRow>(g, r => r.name, r => r.state,
            r => r.spend, r => r.clicks, r => r.conversions);
        g.Col("人群类型", 100, r => r.crowdType);
        g.NumCol("覆盖人数", 100, r => r.reach).Sum();
        g.RealCol("溢价", 90, 1, r => r.premium).Percent().Avg();
        GridColumns.Finish<CrowdRow>(g);
        return g;
    }

    static DataGrid<AdzoneRow> Adzones() {
        DataGrid<AdzoneRow> g = GridColumns.Base<AdzoneRow>();
        GridColumns.Common<AdzoneRow>(g, r => r.name, r => r.state,
            r => r.spend, r => r.clicks, r => r.conversions);
        g.RealCol("出价系数", 100, 2, r => r.bidFactor).Percent().Avg();
        GridColumns.Finish<AdzoneRow>(g);
        return g;
    }

    static DataGrid<CreativeRow> Creatives() {
        DataGrid<CreativeRow> g = GridColumns.Base<CreativeRow>();
        GridColumns.Common<CreativeRow>(g, r => r.name, r => r.state,
            r => r.spend, r => r.clicks, r => r.conversions);
        g.Col("创意类型", 100, r => r.creativeType);
        g.NumCol("展现", 90, r => r.impressions).Sum();
        g.RealCol("点击率", 90, 1, r => r.ctr).Percent().Avg();
        GridColumns.Finish<CreativeRow>(g);
        return g;
    }

    static DataGrid<SiteAdGroupRow> SiteAdGroups() {
        DataGrid<SiteAdGroupRow> g = GridColumns.Base<SiteAdGroupRow>();
        GridColumns.Common<SiteAdGroupRow>(g, r => r.name, r => r.state,
            r => r.spend, r => r.clicks, r => r.conversions);
        g.RealCol("日预算", 100, 2, r => r.budget).Money("¥").Sum();
        g.NumCol("投放天数", 90, r => r.deliveryDays).Sum();
        GridColumns.Finish<SiteAdGroupRow>(g);
        return g;
    }

    static DataGrid<CrowdTrimRow> CrowdTrims() {
        DataGrid<CrowdTrimRow> g = GridColumns.Base<CrowdTrimRow>();
        GridColumns.Common<CrowdTrimRow>(g, r => r.name, r => r.state,
            r => r.spend, r => r.clicks, r => r.conversions);
        g.RealCol("时段系数", 100, 2, r => r.timeFactor).Percent().Avg();
        g.RealCol("地域系数", 100, 2, r => r.regionFactor).Percent().Avg();
        GridColumns.Finish<CrowdTrimRow>(g);
        return g;
    }
}
