using System;
using Gui;
using Gui.Widget;
using Gui.Component.DataTable;
using OnePlus.Model;

namespace OnePlus.Pages;

/// 参考页（CampGroups/CampPlans）的手写列定义与各表格页共用的
/// 写回访问器。常规对象类型的列并集已迁到 *.zform 网格组件
/// （PlanGroupGrid 等），由 GenForm 生成类型化列。
class GridColumns {
    static string Name(MetricRow r) { return r.name; }
    static string State(MetricRow r) { return r.state; }
    static double Budget(MetricRow r) { return r.budget; }
    static double Bid(MetricRow r) { return r.bid; }
    static double Premium(MetricRow r) { return r.premium; }
    static double Spend(MetricRow r) { return r.spend; }
    static int Clicks(MetricRow r) { return r.clicks; }
    static int Conversions(MetricRow r) { return r.conversions; }

    static double ReadMetric(MetricRow r, string field) {
        if (field == "budget") { return GridColumns.Budget(r); }
        if (field == "bid") { return GridColumns.Bid(r); }
        if (field == "premium") { return GridColumns.Premium(r); }
        if (field == "spend") { return GridColumns.Spend(r); }
        return 0.0;
    }

    static void SetMetric(MetricRow r, string field, string value) {
        if (field == "budget") { r.budget = Convert.ToDouble(value); }
        else if (field == "bid") { r.bid = Convert.ToDouble(value); }
        else if (field == "premium") { r.premium = Convert.ToDouble(value); }
        else if (field == "state") { r.state = value; }
    }

    static void SetKeyword(KeywordRow r, string field, string value) {
        GridColumns.SetMetric(r, field, value);
        if (field == "matchType") { r.matchType = value; }
    }

    static DataGrid<T> Base<T>() {
        DataGrid<T> g = new DataGrid<T>();
        // 参考工程的 DevExpress 表格行高约 22px，信息密度远高于
        // 主题默认的 34px，这里统一收紧。
        g.RowHeight(22);
        return g;
    }

    static void Finish<T>(DataGrid<T> g) {
        g.Selectable(true).RowNumbers(true).Striped(true).Summary(true)
            .FilterRow(true);
    }

    static DataGrid<PlanGroupRow> CampGroups() {
        DataGrid<PlanGroupRow> g = GridColumns.Base<PlanGroupRow>();
        g.Col("计划组分类", 130, r => r.state);
        g.Col("计划组名称", 240, r => r.name);
        g.NumCol("计划数", 90, r => r.clicks).Sum();
        g.NumCol("主体数", 90, r => r.conversions).Sum();
        g.NumCol("关键词", 90, r => r.clicks).Sum();
        g.NumCol("词包", 90, r => r.conversions).Sum();
        g.NumCol("人群", 90, r => r.clicks).Sum();
        g.NumCol("创意", 90, r => r.conversions).Sum();
        GridColumns.Finish<PlanGroupRow>(g);
        return g;
    }

    static DataGrid<PlanRow> CampPlans() {
        DataGrid<PlanRow> g = GridColumns.Base<PlanRow>();
        g.Col("状态", 90, r => r.state);
        g.Col("计划组", 180, r => r.name);
        g.Col("推广计划", 220, r => r.name);
        g.Col("出价方式", 110, r => "手动");
        g.Col("趋势主题", 130, r => "日常销售");
        g.Col("计划ID", 100, r => Convert.ToString(r.clicks));
        g.NumCol("主体数", 90, r => r.conversions).Sum();
        g.RealCol("分时折扣", 100, 1, r => r.premium).Percent().Avg();
        g.RealCol("日限额", 100, 2, r => r.budget).Money("¥").Sum();
        g.Col("创建时间", 140, r => "2024-01-01");
        g.Col("修改时间", 140, r => "2024-01-02");
        g.RealCol("出价", 90, 2, r => r.bid).Money("¥").Avg();
        g.NumCol("关键词数", 90, r => r.clicks).Sum();
        g.NumCol("词包数", 90, r => r.conversions).Sum();
        g.NumCol("创意数", 90, r => r.clicks).Sum();
        g.NumCol("人群数", 90, r => r.conversions).Sum();
        g.Col("屏蔽行为", 100, r => "未设置");
        g.Col("屏蔽年龄", 100, r => "未设置");
        g.Col("屏蔽高退款", 110, r => "未设置");
        g.Col("冷启动", 90, r => "关闭");
        GridColumns.Finish<PlanRow>(g);
        return g;
    }
}
