using System;
using Gui;
using Gui.Widget;
using Gui.Component.CefBrowser;
using OnePlus.Model;

/// @component 页面 globe
/// 一个网页标签：导航行（后退/前进/主页/刷新/停止 + 地址栏）和一个
/// Chromium 视图都在这个组件里，因此主窗体只管标签条，不必认识浏览器。
/// 没有 CEF 运行时时同一个组件退化成一段说明文字，工具标签照旧可用。
partial class BrowserPage {
    /// CEF 是否可用（进程级事实，启动时由 MainForm.SetCefState 写入）。
    static bool cefReady;
    static string cefMessage;
    /// 当前上屏的实例：导航按钮的处理函数是普通函数指针（不捕获），
    /// 因此按 ToolPage 的写法用「正在绘制的实例」来路由。
    static BrowserPage current;
    /// 本实例真的有浏览器（CEF 不可用时只有说明文字）。
    bool live;
    /// 已回填进地址栏的地址，避免每帧重写输入框。
    string syncedUrl;

    static void SetCefState(bool ready, string message) {
        BrowserPage.cefReady = ready;
        BrowserPage.cefMessage = message;
    }

    static bool CefReady() { return BrowserPage.cefReady; }

    void OnInit() {
        this.syncedUrl = "";
        this.live = BrowserPage.cefReady;
        BrowserPage.current = this;
        this.NavBackButton.Icon = "chevron-left";
        this.NavBackButton.Tip = "后退";
        this.NavForwardButton.Icon = "chevron-right";
        this.NavForwardButton.Tip = "前进";
        this.NavHomeButton.Icon = "home";
        this.NavHomeButton.Tip = "主页";
        this.NavRefreshButton.Icon = "refresh";
        this.NavRefreshButton.Tip = "刷新";
        this.NavCloseButton.Icon = "close";
        this.NavCloseButton.Tip = "停止";
        this.NavBackButton.Click += BrowserPage.BackClicked;
        this.NavForwardButton.Click += BrowserPage.ForwardClicked;
        this.NavHomeButton.Click += BrowserPage.HomeClicked;
        this.NavRefreshButton.Click += BrowserPage.RefreshClicked;
        this.NavCloseButton.Click += BrowserPage.StopClicked;
        this.AddressBox.Submit += BrowserPage.AddressSubmitted;
        if (this.live) {
            // window.open / target=_blank 默认由 CEF 自己开一个独立的 Chromium
            // 窗口（看着就是凭空多出来一个「Chrome 浏览器」）；这里改成在本
            // 软件里新开一个标签。
            this.Browser.View().OnPopup(MainForm.OpenPopup);
        } else {
            // 没有浏览器就没有导航行可点：整块换成说明文字。
            this.NavHost.SetShown(false);
            this.Body.RemoveAll();
            TextArea unavailable = new TextArea("");
            unavailable.ReadOnly(true).AutoHeight(true);
            unavailable.SetText("浏览器不可用\n" + BrowserPage.cefMessage +
                                "\n业务工具标签仍可正常使用。");
            unavailable.Dock(Dock.Fill());
            unavailable.Pad(30);
            this.Body.Add(unavailable);
        }
    }

    /// 起始地址：首帧之前设置只是设计属性，之后等同于导航。
    void Open(string url) {
        if (!this.live || url == "") { return; }
        this.Browser.SetStartUrl(url);
    }

    void Navigate(string url) {
        if (!this.live || url == "") { return; }
        this.Browser.Navigate(url);
    }

    bool HasBrowser() { return this.live; }

    string CurrentUrl() {
        if (!this.live) { return ""; }
        return this.Browser.CurrentUrl();
    }

    string CurrentTitle() {
        if (!this.live) { return ""; }
        return this.Browser.CurrentTitle();
    }

    /// 地址栏回填：返回页面标题（宿主用它更新标签文字），
    /// 没有浏览器时返回空串。
    string Sync() {
        BrowserPage.current = this;
        if (!this.live) { return ""; }
        string url = this.Browser.CurrentUrl();
        if (url != "" && url != this.syncedUrl) {
            this.syncedUrl = url;
            this.AddressBox.SetText(url);
        }
        return this.Browser.CurrentTitle();
    }

    /// 宿主把本页切上屏：地址栏下一帧重新回填。
    void Activate() {
        BrowserPage.current = this;
        this.syncedUrl = "";
    }

    /// 落在隐藏的标签里时收起原生浏览器。
    void Deactivate() {
        if (this.live) { this.Browser.Hide(); }
    }

    /// 关闭标签：连原生浏览器一起销毁（否则 Chromium 进程会留着）。
    void Close() {
        if (this.live) { this.Browser.Destroy(); }
    }

    static void BackClicked() {
        BrowserPage p = BrowserPage.current;
        if (p != null && p.live) { p.Browser.Back(); }
    }

    static void ForwardClicked() {
        BrowserPage p = BrowserPage.current;
        if (p != null && p.live) { p.Browser.Forward(); }
    }

    static void HomeClicked() {
        BrowserPage p = BrowserPage.current;
        if (p != null && p.live) { p.Browser.Navigate(SiteRegistry.Home().url); }
    }

    static void RefreshClicked() {
        BrowserPage p = BrowserPage.current;
        if (p != null && p.live) { p.Browser.Reload(); }
    }

    static void StopClicked() {
        BrowserPage p = BrowserPage.current;
        if (p != null && p.live) { p.Browser.Stop(); }
    }

    static void AddressSubmitted() {
        BrowserPage p = BrowserPage.current;
        if (p == null) { return; }
        string target = p.AddressBox.GetText();
        if (target == "") { return; }
        p.Navigate(target);
    }

    /// 上屏的实例就是导航按钮的目标（与 ToolPage 同一约定）。
    override void OnPaint(App app) {
        BrowserPage.current = this;
    }
}
