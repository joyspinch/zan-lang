using System;
using Gui;
using Gui.Widget;
using Gui.Component.DataTable;

namespace OnePlus.Pages;

/// 统一业务页对不同实体表格暴露的最小操作面。
class ObjectPane : Control {
    string paneTitle;

    ObjectPane(string title) {
        paneTitle = title;
    }

    virtual string Title() { return paneTitle; }
    virtual string BizCode() { return ""; }
    virtual string ObjectKind() { return ""; }
    virtual int SelectedCount() { return 0; }
    virtual void WriteField(string field, string value) { }
    virtual void ScaleField(string field, double factor) { }
    virtual void Configure(bool striped, bool rowNumbers, bool summary,
                           bool filterRow) { }
    virtual void Refresh() { }
    virtual void ActivateRoute() { }
}
