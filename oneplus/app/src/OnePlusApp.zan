using System;
using Gui;
using Gui.Component.CefBrowser;
using OnePlus.Shell;

namespace OnePlus;

/// 群爆款优化神器的跨平台 GUI 骨架入口。
class OnePlusApp {
    static App mainApp;

    /// 主循环收到子窗口事件后，把事件交给对应的 ChildWindow。
    static void FrameTick() {
        if (OnePlusApp.mainApp == null) { return; }
        nint evh = Window.EventHwnd();
        if (evh != OnePlusApp.mainApp.WindowHandle()) {
            ChildWindows.Route(evh);
        }
    }

    static async int Main() {
        CefBootstrap.RunHelper();
        bool cefReady = await CefBootstrap.StartAsync();
        string cefMessage = "CEF 就绪";
        if (!cefReady) {
            cefMessage = CefHost.Error();
            if (cefMessage == "") { cefMessage = "当前环境没有 CEF 运行时"; }
            Console.WriteLine("CEF 启动失败，降级为业务工具模式：" + cefMessage);
        }

        Form form = Form.CreateDark("群爆款优化神器 · Zan 版", 1360, 860);
        App app = form.GetApp();
        OnePlusApp.mainApp = app;
        form.FrameHook(OnePlusApp.FrameTick);
        AppShell shell = new AppShell(app, cefReady, cefMessage);
        shell.Dock(Dock.Fill());
        form.Add(shell);
        form.Run();
        CefHost.Shutdown();
        return 0;
    }
}
