/// 站点/网页入口集中定义，对应原版 AppDefine + Form1 的 ShowPage(key, url, title)。
/// key 与原 C# 保持一致（Hosttb/OneWeb/Hostsycm...），作为文档标签的稳定复用键。
class SiteDef {
    string key;
    string name;
    string url;
    string icon;

    SiteDef(string key, string name, string url, string icon) {
        this.key = key;
        this.name = name;
        this.url = url;
        this.icon = icon;
    }
}

class SiteRegistry {
    static List<SiteDef> quickAccess;

    static List<SiteDef> QuickAccess() {
        if (SiteRegistry.quickAccess != null) { return SiteRegistry.quickAccess; }
        List<SiteDef> r = new List<SiteDef>();
        r.Add(new SiteDef("Hosttb", "淘宝网首页",
            "https://www.taobao.com/", "home"));
        r.Add(new SiteDef("OneWeb", "万象台无界",
            "https://one.alimama.com/index.html#!/manage/search", "globe"));
        r.Add(new SiteDef("Hostsycm", "生意参谋",
            "https://sycm.taobao.com/", "grid"));
        r.Add(new SiteDef("Hostdmp", "达摩盘",
            "https://dmp.taobao.com/index_new.html", "pin"));
        r.Add(new SiteDef("Hostspsc", "商品素材",
            "https://qn.taobao.com/home.htm/tmc-material/material-center/material_upload/item",
            "image"));
        r.Add(new SiteDef("Hostspsc", "商品素材(新)",
            "https://qn.taobao.com/home.htm/material-center/material-management",
            "image"));
        r.Add(new SiteDef("Hostdgsc", "导购素材管理",
            "https://xiangqing.wangpu.taobao.com/index.html", "folder"));
        r.Add(new SiteDef("Hostcnxh", "猜你喜欢",
            "https://qn.taobao.com/home.htm/recommended-material/management",
            "heart"));
        SiteRegistry.quickAccess = r;
        return r;
    }

    static SiteDef Home() {
        return SiteRegistry.QuickAccess()[0];
    }
}
