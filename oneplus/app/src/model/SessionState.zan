using System;
using System.Management;
using System.Diagnostics;
using Gui.Component.DataTable;

namespace OnePlus.Model;

/// 标题栏上的会话与运行状态，对应参考工程 Ws.cs 的登录/授权标题
/// 以及 Form1 的 barStaticItem1（平均耗时）/barStaticItem12（内存）。
/// 登录与授权来自授权接口，这里由 SetAuth 注入；耗时按每次接口
/// 调用累计，内存每次询问时从运行时实时采样。
class SessionState {
    static string shop;
    static string nickname;
    static bool login;
    static string expire;
    static int apiCount;
    static double apiSeconds;
    static double apiMaxSeconds;

    /// 授权接口回包后写入店铺、昵称、登录态与到期日（yyyy-MM-dd）。
    static void SetAuth(string shopName, string nick, bool signedIn,
                        string expireDate) {
        SessionState.shop = shopName;
        SessionState.nickname = nick;
        SessionState.login = signedIn;
        SessionState.expire = expireDate;
    }

    /// 记一次接口调用耗时（秒），供平均值与最慢值统计。
    static void NoteApiCall(double seconds) {
        SessionState.apiCount = SessionState.apiCount + 1;
        SessionState.apiSeconds = SessionState.apiSeconds + seconds;
        if (seconds > SessionState.apiMaxSeconds) {
            SessionState.apiMaxSeconds = seconds;
        }
    }

    static double AverageSeconds() {
        if (SessionState.apiCount <= 0) { return 0.0; }
        return SessionState.apiSeconds / (double)SessionState.apiCount;
    }

    /// `新云腾商城:琼子 登录 授权到期: 2026-11-15`
    static string LoginText() {
        string who = SessionState.shop;
        if (who == null) { who = ""; }
        string nick = SessionState.nickname;
        if (nick == null) { nick = ""; }
        if (nick != "") { who = who + ":" + nick; }
        if (SessionState.login) { who = who + " 登录"; }
        string due = SessionState.expire;
        if (due == null || due == "") { return who; }
        return who + " 授权到期: " + due;
    }

    /// `平均:0.632秒  消耗内存:260.06 MB 优秀`
    static string PerfText() {
        string avg = "平均:" +
            DataTable.FormatReal(SessionState.AverageSeconds(), 3) + "秒";
        long rss = ServerMetrics.MemoryRssBytes();
        if (rss < 0) { return avg; }
        string mem = "消耗内存:" + SessionState.FormatBytes(rss);
        long availMb = SessionState.AvailableMegabytes();
        if (availMb >= 0) { mem = mem + " " + SessionState.Grade(availMb); }
        return avg + "  " + mem;
    }

    /// 系统可用物理内存（MB），取不到时为 -1。
    static long AvailableMegabytes() {
        try {
            MemoryStatus s = Memory.GetStatus();
            return s.availPhys / 1024 / 1024;
        } catch {
            return 0 - 1;
        }
    }

    /// 与参考工程一致的可用内存分档评价。
    static string Grade(long availMb) {
        if (availMb <= 512) { return "极低，Win系统可能不稳定"; }
        if (availMb <= 1024) { return "过低，可能导致卡顿"; }
        if (availMb <= 2048) { return "普通"; }
        if (availMb <= 4096) { return "良好"; }
        return "优秀";
    }

    /// 参考工程 FormatBytes：进位到 B/KB/MB/GB，保留两位小数。
    static string FormatBytes(long bytes) {
        double n = (double)bytes;
        int unit = 0;
        while (n >= 1024.0 && unit < 3) {
            n = n / 1024.0;
            unit = unit + 1;
        }
        string suffix = "B";
        if (unit == 1) { suffix = "KB"; }
        else if (unit == 2) { suffix = "MB"; }
        else if (unit == 3) { suffix = "GB"; }
        return DataTable.FormatReal(n, 2) + " " + suffix;
    }
}
