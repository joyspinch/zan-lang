using System;

namespace OnePlus.Model;

/// 一个推广软件的对象入口与功能开关。
class ToolDef {
    string id;
    string title;
    string bizCode;
    List<string> objectKinds;
    bool oneClick;
    bool creative;
    bool adzone;

    ToolDef(string i, string t, string biz) {
        id = i;
        title = t;
        bizCode = biz;
        objectKinds = new List<string>();
        oneClick = true;
        creative = true;
        adzone = true;
    }

    ToolDef Kinds(List<string> kinds) {
        objectKinds = kinds;
        return this;
    }

    ToolDef Flags(bool optimize, bool hasCreative, bool hasAdzone) {
        oneClick = optimize;
        creative = hasCreative;
        adzone = hasAdzone;
        return this;
    }
}

class ToolRegistry {
    static List<string> Kinds(params string[] ids) {
        List<string> r = new List<string>();
        for (int i = 0; i < ids.Count; i = i + 1) { r.Add(ids[i]); }
        return r;
    }

    static List<ToolDef> All() {
        List<ToolDef> r = new List<ToolDef>();
        r.Add(new ToolDef("search", "关键词推广", "onebpSearch").Kinds(
            ToolRegistry.Kinds("planGroup", "plan", "adGroup", "keyword",
                               "wordPackage", "crowd", "adzone", "creative")));
        r.Add(new ToolDef("displayCrowd", "精准人群推广", "displayCrowd").Kinds(
            ToolRegistry.Kinds("planGroup", "plan", "adGroup", "crowd",
                               "crowdTrim", "creative", "adzone")));
        r.Add(new ToolDef("site", "全站推广", "sitePromotion").Kinds(
            ToolRegistry.Kinds("planGroup", "plan", "siteAdGroup",
                               "crowd", "crowdTrim", "adzone")));
        r.Add(new ToolDef("shortVideo", "超级短视频", "shortVideo").Kinds(
            ToolRegistry.Kinds("planGroup", "plan", "adGroup", "crowd")).Flags(
                false, false, false));
        r.Add(new ToolDef("jd", "京东快车", "jdSearch").Kinds(
            ToolRegistry.Kinds("planGroup", "plan", "adGroup", "keyword",
                               "crowd", "creative")));
        return r;
    }

    static ToolDef Find(string id) {
        List<ToolDef> all = ToolRegistry.All();
        for (int i = 0; i < all.Count; i = i + 1) {
            if (all[i].id == id || all[i].bizCode == id) { return all[i]; }
        }
        return all[0];
    }
}
