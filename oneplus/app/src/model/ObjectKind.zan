using System;

namespace OnePlus.Model;

/// 推广列表里的对象类型元数据。
class ObjectKind {
    string id;
    string title;
    string icon;

    ObjectKind(string i, string t, string ico) {
        id = i;
        title = t;
        icon = ico;
    }

    static List<ObjectKind> All() {
        List<ObjectKind> r = new List<ObjectKind>();
        r.Add(new ObjectKind("planGroup", "计划组", "folder"));
        r.Add(new ObjectKind("plan", "计划", "calendar"));
        r.Add(new ObjectKind("adGroup", "推广单元", "layers"));
        r.Add(new ObjectKind("keyword", "关键词", "search"));
        r.Add(new ObjectKind("wordPackage", "词包", "book"));
        r.Add(new ObjectKind("crowd", "人群", "users"));
        r.Add(new ObjectKind("adzone", "资源位", "layout"));
        r.Add(new ObjectKind("creative", "创意", "image"));
        r.Add(new ObjectKind("siteAdGroup", "全站主体", "globe"));
        r.Add(new ObjectKind("crowdTrim", "精细化调控", "sliders"));
        return r;
    }

    static ObjectKind Find(string id) {
        List<ObjectKind> all = ObjectKind.All();
        for (int i = 0; i < all.Count; i = i + 1) {
            if (all[i].id == id) { return all[i]; }
        }
        return new ObjectKind(id, id, "dot");
    }
}
