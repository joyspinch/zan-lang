using System;

namespace OnePlus.Model;

/// 所有假数据行共用的展示字段；具体对象类型用轻量实体子类区分。
class MetricRow {
    string name;
    string state;
    double budget;
    double bid;
    double premium;
    double spend;
    int clicks;
    int conversions;

    MetricRow() {
        name = "";
        state = "启用";
        budget = 0.0;
        bid = 0.0;
        premium = 0.0;
        spend = 0.0;
        clicks = 0;
        conversions = 0;
    }
}

class PlanGroupRow : MetricRow {}
class PlanRow : MetricRow {}
class AdGroupRow : MetricRow {}
class KeywordRow : MetricRow {
    string matchType;
    double qualityScore;
}
class WordPackageRow : MetricRow {
    int wordCount;
}
class CrowdRow : MetricRow {
    string crowdType;
    int reach;
}
class AdzoneRow : MetricRow {
    double bidFactor;
}
class CreativeRow : MetricRow {
    string creativeType;
    int impressions;
    double ctr;
}
class SiteAdGroupRow : MetricRow {
    int deliveryDays;
}
class CrowdTrimRow : MetricRow {
    double timeFactor;
    double regionFactor;
}

class FakeRows {
    static void Fill(MetricRow r, string prefix, int i) {
        r.name = prefix + " " + Convert.ToString(i + 1);
        r.state = "启用";
        if (i % 7 == 0) { r.state = "暂停"; }
        r.budget = 100.0 + (i % 9) * 35.0;
        r.bid = 0.35 + (i % 6) * 0.12;
        r.premium = 5.0 + (i % 8) * 2.5;
        r.spend = 18.0 + (i % 13) * 7.2;
        r.clicks = 30 + i * 4;
        r.conversions = 2 + i % 11;
    }

    static List<PlanGroupRow> PlanGroups() {
        List<PlanGroupRow> r = new List<PlanGroupRow>();
        for (int i = 0; i < 36; i = i + 1) {
            PlanGroupRow row = new PlanGroupRow();
            FakeRows.Fill(row, "搜索计划组", i);
            r.Add(row);
        }
        return r;
    }

    static List<PlanRow> Plans() {
        List<PlanRow> r = new List<PlanRow>();
        for (int i = 0; i < 36; i = i + 1) {
            PlanRow row = new PlanRow();
            FakeRows.Fill(row, "推广计划", i);
            r.Add(row);
        }
        return r;
    }

    static List<AdGroupRow> AdGroups() {
        List<AdGroupRow> r = new List<AdGroupRow>();
        for (int i = 0; i < 36; i = i + 1) {
            AdGroupRow row = new AdGroupRow();
            FakeRows.Fill(row, "推广单元", i);
            r.Add(row);
        }
        return r;
    }

    static List<KeywordRow> Keywords() {
        List<KeywordRow> r = new List<KeywordRow>();
        for (int i = 0; i < 36; i = i + 1) {
            KeywordRow row = new KeywordRow();
            FakeRows.Fill(row, "爆款关键词", i);
            row.matchType = "广泛";
            if (i % 3 == 0) { row.matchType = "精确"; }
            else if (i % 3 == 1) { row.matchType = "短语"; }
            row.qualityScore = 6.0 + (i % 5) * 0.8;
            r.Add(row);
        }
        return r;
    }

    static List<WordPackageRow> WordPackages() {
        List<WordPackageRow> r = new List<WordPackageRow>();
        for (int i = 0; i < 36; i = i + 1) {
            WordPackageRow row = new WordPackageRow();
            FakeRows.Fill(row, "核心词包", i);
            row.wordCount = 12 + (i % 9) * 7;
            r.Add(row);
        }
        return r;
    }

    static List<CrowdRow> Crowds() {
        List<CrowdRow> r = new List<CrowdRow>();
        for (int i = 0; i < 36; i = i + 1) {
            CrowdRow row = new CrowdRow();
            FakeRows.Fill(row, "定向人群", i);
            row.crowdType = "兴趣";
            if (i % 3 == 1) { row.crowdType = "行为"; }
            else if (i % 3 == 2) { row.crowdType = "相似"; }
            row.reach = 12000 + i * 830;
            r.Add(row);
        }
        return r;
    }

    static List<AdzoneRow> Adzones() {
        List<AdzoneRow> r = new List<AdzoneRow>();
        for (int i = 0; i < 36; i = i + 1) {
            AdzoneRow row = new AdzoneRow();
            FakeRows.Fill(row, "资源位", i);
            row.bidFactor = 0.80 + (i % 8) * 0.05;
            r.Add(row);
        }
        return r;
    }

    static List<CreativeRow> Creatives() {
        List<CreativeRow> r = new List<CreativeRow>();
        for (int i = 0; i < 36; i = i + 1) {
            CreativeRow row = new CreativeRow();
            FakeRows.Fill(row, "商品创意", i);
            row.creativeType = "主图";
            if (i % 3 == 1) { row.creativeType = "短视频"; }
            else if (i % 3 == 2) { row.creativeType = "标题"; }
            row.impressions = 800 + i * 95;
            row.ctr = 1.8 + (i % 9) * 0.35;
            r.Add(row);
        }
        return r;
    }

    static List<SiteAdGroupRow> SiteAdGroups() {
        List<SiteAdGroupRow> r = new List<SiteAdGroupRow>();
        for (int i = 0; i < 36; i = i + 1) {
            SiteAdGroupRow row = new SiteAdGroupRow();
            FakeRows.Fill(row, "全站主体", i);
            row.deliveryDays = 7 + (i % 8);
            r.Add(row);
        }
        return r;
    }

    static List<CrowdTrimRow> CrowdTrims() {
        List<CrowdTrimRow> r = new List<CrowdTrimRow>();
        for (int i = 0; i < 36; i = i + 1) {
            CrowdTrimRow row = new CrowdTrimRow();
            FakeRows.Fill(row, "精细调控", i);
            row.timeFactor = 0.70 + (i % 7) * 0.08;
            row.regionFactor = 0.80 + (i % 6) * 0.06;
            r.Add(row);
        }
        return r;
    }
}
