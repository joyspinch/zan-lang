using System;

namespace OnePlus.Menu;

/// 右键菜单动作描述，渲染与执行都只依赖这一份配置。
class MenuAction {
    string id;
    string title;
    string icon;
    string group;
    bool danger;
    bool needsRows;
    List<MenuAction> children;
    string window;

    MenuAction(string i, string t, string ico, string g, bool d,
               bool rows, string win) {
        id = i;
        title = t;
        icon = ico;
        group = g;
        danger = d;
        needsRows = rows;
        children = new List<MenuAction>();
        window = win;
    }

    static MenuAction Run(string i, string t, string ico, string g,
                          bool rows) {
        return new MenuAction(i, t, ico, g, false, rows, "");
    }

    static MenuAction Danger(string i, string t, string ico, string g,
                             bool rows) {
        return new MenuAction(i, t, ico, g, true, rows, "");
    }

    static MenuAction Window(string i, string t, string ico, string g,
                             bool rows, string win) {
        return new MenuAction(i, t, ico, g, false, rows, win);
    }

    static MenuAction Submenu(string i, string t, string ico, string g,
                              bool rows, List<MenuAction> kids) {
        MenuAction m = new MenuAction(i, t, ico, g, false, rows, "");
        m.children = kids;
        return m;
    }
}
