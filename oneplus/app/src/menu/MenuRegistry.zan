using System;
using OnePlus.Model;

namespace OnePlus.Menu;

/// 通用动作与对象专属动作在此组合，避免每个对象复制整套菜单。
class MenuRegistry {
    static MenuAction Demo(string id, string title, string group,
                           bool rows) {
        return MenuAction.Run(id, title, "dot", group, rows);
    }

    static MenuAction Group(string id, string title, string group,
                            List<MenuAction> children) {
        return MenuAction.Submenu(id, title, "folder", group, true,
                                  children);
    }

