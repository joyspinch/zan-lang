    static List<MenuAction> Common() {
        List<MenuAction> r = new List<MenuAction>();
        r.Add(MenuAction.Run("enable", "启用", "check", "状态", true));
        r.Add(MenuAction.Run("pause", "暂停", "pause", "状态", true));
        r.Add(MenuAction.Danger("delete", "删除", "trash", "危险操作", true));
        r.Add(MenuAction.Run("export", "导出", "download", "数据", true));
        r.Add(MenuAction.Window("gridConfig", "表格配置", "settings",
                                "数据", false, "gridConfig"));
        return r;
    }

    static List<MenuAction> For(string bizCode, string objectKind) {
        List<MenuAction> r = MenuRegistry.Common();
        if (objectKind == "plan") {
            List<MenuAction> reference = MenuRegistry.PlanReference();
            for (int i = 0; i < reference.Count; i = i + 1) {
                r.Add(reference[i]);
            }
            r.Add(MenuAction.Run("rename", "改名", "edit", "计划", true));
            r.Add(MenuAction.Run("clone", "克隆", "copy", "计划", true));
        } else if (objectKind == "keyword") {
            List<MenuAction> bids = new List<MenuAction>();
            bids.Add(MenuAction.Run("bidUp", "提价 10%", "trend-up", "出价", true));
            bids.Add(MenuAction.Run("bidDown", "降价 10%", "trend-down", "出价", true));
            bids.Add(MenuAction.Run("bidFixed", "改为指定价", "edit", "出价", true));
            r.Add(MenuAction.Submenu("bid", "改出价", "trend-up", "关键词",
                                     true, bids));
            List<MenuAction> matches = new List<MenuAction>();
            matches.Add(MenuAction.Run("matchExact", "精确", "target", "匹配方式", true));
            matches.Add(MenuAction.Run("matchPhrase", "短语", "quote", "匹配方式", true));
            matches.Add(MenuAction.Run("matchBroad", "广泛", "globe", "匹配方式", true));
            r.Add(MenuAction.Submenu("match", "改匹配方式", "filter", "关键词",
                                     true, matches));
        } else if (objectKind == "crowd" || objectKind == "crowdTrim") {
            r.Add(MenuAction.Run("premium", "改溢价", "percent", "人群", true));
            r.Add(MenuAction.Run("exclude", "加入屏蔽人群", "minus-circle",
                                 "人群", true));
        } else if (objectKind == "adGroup") {
            r.Add(MenuAction.Run("selectAll", "全选", "check", "基础", false));
            r.Add(MenuAction.Run("refresh", "刷新", "refresh", "基础", false));
            r.Add(MenuAction.Run("quickManage", "快捷管理", "folder", "管理", true));
        } else if (objectKind == "wordPackage") {
            r.Add(MenuAction.Run("wordBidEdit", "修改词包出价", "edit", "词包", true));
            r.Add(MenuAction.Run("filterCondition", "根据条件筛选", "filter", "筛选", false));
            r.Add(MenuAction.Run("wordToggleDelete", "启停删词包", "trash", "危险操作", true));
        } else if (objectKind == "adzone") {
            r.Add(MenuAction.Run("selectAll", "全选", "check", "基础", false));
            r.Add(MenuAction.Run("refresh", "刷新", "refresh", "基础", false));
            r.Add(MenuAction.Run("adzoneToggle", "开启·暂停", "pause", "状态", true));
        } else if (objectKind == "creative") {
            r.Add(MenuAction.Run("creativeDetail", "查看创意组详情", "eye", "创意", true));
            r.Add(MenuAction.Run("creativeCopyAsset", "批量复制创意素材", "copy", "创意", true));
            r.Add(MenuAction.Run("creativeVideo", "添加视频创意", "video", "创意", true));
            r.Add(MenuAction.Run("creativeReplace", "批量替换素材", "refresh", "创意", true));
            r.Add(MenuAction.Run("creativeSmart", "智能创意", "sparkles", "创意", true));
            r.Add(MenuAction.Run("creativeSmartNew", "智能创意新", "sparkles", "创意", true));
            r.Add(MenuAction.Run("filterCondition", "根据条件筛选", "filter", "筛选", false));
            r.Add(MenuAction.Run("creativeRecommend", "添加推荐标题", "plus", "创意", true));
            r.Add(MenuAction.Run("creativeTitle", "批量修改创意标题", "edit", "创意", true));
            r.Add(MenuAction.Run("creativeOptimize", "批量创意优化", "wand", "创意", true));
        } else if (objectKind == "optimize") {
            r.Add(MenuAction.Run("newScheme", "新建方案", "plus", "自动优化方案管理", false));
            r.Add(MenuAction.Run("editScheme", "修改", "edit", "自动优化方案管理", true));
            r.Add(MenuAction.Danger("deleteScheme", "删除", "trash", "危险操作", true));
            r.Add(MenuAction.Run("executeScheme", "执行优化", "play", "自动优化方案管理", true));
            r.Add(MenuAction.Run("selectAll", "全选", "check", "基础", false));
            r.Add(MenuAction.Run("refresh", "刷新", "refresh", "基础", false));
        } else if (objectKind == "keyword") {
            r.Add(MenuAction.Run("keywordAvg", "查询均价", "chart", "关键词", true));
            r.Add(MenuAction.Run("keywordQuality", "查询质量分", "star", "关键词", true));
            r.Add(MenuAction.Run("keywordCopyName", "复制关键词", "copy", "关键词", true));
            r.Add(MenuAction.Run("keywordExport", "导出关键词", "download", "关键词", true));
            r.Add(MenuAction.Run("keywordDeduplicate", "处理重复关键词", "filter", "关键词", true));
        }
        return r;
    }
}
