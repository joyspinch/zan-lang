using System;
using OnePlus.Model;

namespace OnePlus.Menu;

/// 通用动作与对象专属动作在此组合，避免每个对象复制整套菜单。
class MenuRegistry {
    static List<MenuAction> Common() {
        List<MenuAction> r = new List<MenuAction>();
        r.Add(MenuAction.Run("enable", "启用", "check", "状态", true));
        r.Add(MenuAction.Run("pause", "暂停", "pause", "状态", true));
        r.Add(MenuAction.Danger("delete", "删除", "trash", "危险操作", true));
        r.Add(MenuAction.Run("export", "导出", "download", "数据", true));
        r.Add(MenuAction.Window("gridConfig", "表格配置", "settings",
                                "数据", false, "gridConfig"));
        return r;
    }

    static List<MenuAction> For(string bizCode, string objectKind) {
        List<MenuAction> r = MenuRegistry.Common();
        if (objectKind == "plan") {
            r.Add(MenuAction.Window("dailyBudget", "修改日限额", "wallet",
                                    "计划", true, "dailyBudget"));
            r.Add(MenuAction.Run("rename", "改名", "edit", "计划", true));
            r.Add(MenuAction.Run("clone", "克隆", "copy", "计划", true));
            if (bizCode != "shortVideo") {
                r.Add(MenuAction.Run("movePlan", "移动计划组", "folder",
                                     "计划", true));
            }
        } else if (objectKind == "keyword") {
            List<MenuAction> bids = new List<MenuAction>();
            bids.Add(MenuAction.Run("bidUp", "提价 10%", "trend-up", "出价", true));
            bids.Add(MenuAction.Run("bidDown", "降价 10%", "trend-down", "出价", true));
            bids.Add(MenuAction.Run("bidFixed", "改为指定价", "edit", "出价", true));
            r.Add(MenuAction.Submenu("bid", "改出价", "trend-up", "关键词",
                                     true, bids));
            List<MenuAction> matches = new List<MenuAction>();
            matches.Add(MenuAction.Run("matchExact", "精确", "target", "匹配方式", true));
            matches.Add(MenuAction.Run("matchPhrase", "短语", "quote", "匹配方式", true));
            matches.Add(MenuAction.Run("matchBroad", "广泛", "globe", "匹配方式", true));
            r.Add(MenuAction.Submenu("match", "改匹配方式", "filter", "关键词",
                                     true, matches));
        } else if (objectKind == "crowd" || objectKind == "crowdTrim") {
            r.Add(MenuAction.Run("premium", "改溢价", "percent", "人群", true));
            r.Add(MenuAction.Run("exclude", "加入屏蔽人群", "minus-circle",
                                 "人群", true));
        }
        return r;
    }
}
