using System;
using Gui;
using OnePlus.Pages;
using OnePlus.Shell;
using OnePlus.Windows;

namespace OnePlus.Menu;

/// 所有菜单结果经过这里，参数动作再转交窗口注册表。
class ActionHost {
    static void Say(string text) {
        AppShell.SetStatus(text);
    }

    static void Execute(MenuAction action, ObjectPane pane) {
        if (action == null || pane == null) { return; }
        int rows = pane.SelectedCount();
        if (action.needsRows && rows == 0) {
            ActionHost.Say("请先勾选要操作的行");
            return;
        }
        if (action.window != "") {
            WindowRegistry.Open(action.window, pane);
            return;
        }
        if (action.id == "enable") { pane.WriteField("state", "启用"); }
        else if (action.id == "pause") { pane.WriteField("state", "暂停"); }
        else if (action.id == "delete") { ActionHost.Say("已标记删除 " + Convert.ToString(rows) + " 行（假数据）"); return; }
        else if (action.id == "bidUp") {
            pane.ScaleField("bid", 1.1);
        } else if (action.id == "bidDown") {
            pane.ScaleField("bid", 0.9);
        } else if (action.id == "bidFixed") {
            pane.WriteField("bid", "1.00");
        } else if (action.id == "matchExact") {
            pane.WriteField("matchType", "精确");
        } else if (action.id == "matchPhrase") {
            pane.WriteField("matchType", "短语");
        } else if (action.id == "matchBroad") {
            pane.WriteField("matchType", "广泛");
        } else if (action.id == "export") {
            ActionHost.Say("已导出 " + Convert.ToString(rows) + " 行（假数据）");
            return;
        }
        pane.Refresh();
        ActionHost.Say("已执行「" + action.title + "」" +
                       Convert.ToString(rows) + " 行（假数据）");
    }
}
