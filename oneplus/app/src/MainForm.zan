using System;
using Gui;
using Gui.Widget;
using OnePlus.Model;

class DocumentTabHost : Control {
    Tabs tabs;

    DocumentTabHost() {
        this.InitControl("document-tab-host", 1);
        this.tabs = new Tabs(Tabs.Card());
    }

    void SetShowAdd(bool on) { this.tabs.SetShowAdd(on); }
    void Clear() { this.tabs.Clear(); }
    void Add(string label, bool closable) { this.tabs.Add(label, closable); }
    int Count() { return this.tabs.Count(); }
    void Select(int index) { this.tabs.Select(index); }
    int Active() { return this.tabs.Active(); }
    string ActiveLabel() { return this.tabs.ActiveLabel(); }
    int TakeChanged() { return this.tabs.TakeChanged(); }
    int TakeClosed() { return this.tabs.TakeClosed(); }
    void SetLabel(int index, string label) { this.tabs.SetLabel(index, label); }
    string LabelAt(int index) { return this.tabs.LabelAt(index); }

    override void OnPaint(App app) {
        this.tabs.Render(app, this.bx, this.by, this.bw);
    }
}

partial class MainForm {
    static MainForm current;
    static Form form;
    static App app;
    static SignalInt menuAction;
    static SignalInt menuSub;
    static SignalBool menuOpen;
    static int menuKind;
    static int menuX;
    static int menuY;
    static List<string> tabKeys;
    static List<Control> tabPages;
    /// 与 tabPages 同序：网页标签的组件，业务工具标签这一格是 null。
    static List<BrowserPage> tabBrowsers;

    static void OnLoad(Form f) {
        MainForm.form = f;
        MainForm.app = f.GetApp();
        MainForm.app.EnableSkins(0);
        MainForm.app.ApplySkinName("light");
        MainForm.current = new MainForm();
        MainForm.menuAction = new SignalInt(-1);
        MainForm.menuSub = new SignalInt(-1);
        MainForm.menuOpen = new SignalBool(false);
        MainForm.tabKeys = new List<string>();
        MainForm.tabPages = new List<Control>();
        MainForm.tabBrowsers = new List<BrowserPage>();
        DocumentTabs.Clear();
        DocumentTabs.SetShowAdd(false);
        SiteButton.Click += MainForm.SiteClicked;
        // 首标签是固定的主页网页（不可关闭），业务工具页由命令菜单按需打开。
        SiteDef home = SiteRegistry.Home();
        MainForm.OpenBrowserTab("browser:" + home.key, home.name,
                                home.url, false);
        // 登录/授权本应来自授权接口；本壳跟其他页一样先给假数据。
        SessionState.SetAuth("新云腾商城", "琼子", true, "2026-11-15");
        MainForm.RefreshTitleStatus();
        f.Every(1000, MainForm.RefreshTitleStatus);
    }

    static void SiteClicked() { MainForm.OpenCommand(6); }

    static void OpenCommand(int index) {
        MainForm.CommandClicked(index);
    }

    /// 浏览器能不能用是 BrowserPage 自己的事（它拿不到就退化成一段
    /// 说明文字），主窗体只把启动结论转给它。
    static void SetCefState(bool ready, string message) {
        BrowserPage.SetCefState(ready, message);
    }

    static void CommandClicked(int index) {
        if (MainForm.current == null) { return; }
        MainForm.menuKind = index;
        MainForm.menuX = MainForm.app.mouseX;
        MainForm.menuY = MainForm.app.mouseY + 8;
        MainForm.menuAction.Set(-1);
        MainForm.menuSub.Set(-1);
        MainForm.menuOpen.Set(true);
        MainForm.app.RequestRedraw();
    }

    static List<MenuItem> SoftwareMenu() {
        List<MenuItem> r = new List<MenuItem>();
        r.Add(MenuItem.Header("推广软件"));
        r.Add(MenuItem.Item("关键词推广", "search", 0));
        r.Add(MenuItem.Item("精准人群推广", "user", 1));
        List<MenuItem> goods = new List<MenuItem>();
        goods.Add(MenuItem.Item("货品运营(已升级店铺)", "archive", 2));
        goods.Add(MenuItem.Item("货品加速", "play", 3));
        goods.Add(MenuItem.Item("测款快", "grid", 4));
        goods.Add(MenuItem.Item("上新快", "plus", 5));
        r.Add(MenuItem.Submenu("货品运营", "archive", goods));
        List<MenuItem> consumer = new List<MenuItem>();
        consumer.Add(MenuItem.Item("人群击穿", "user", 6));
        consumer.Add(MenuItem.Item("拉新快", "plus", 7));
        consumer.Add(MenuItem.Item("会员快", "star", 8));
        consumer.Add(MenuItem.Item("粉丝快", "heart", 9));
        consumer.Add(MenuItem.Item("易获客", "search", 10));
        r.Add(MenuItem.Submenu("消费者运营", "user", consumer));
        r.Add(MenuItem.Item("全站推广", "globe", 11));
        r.Add(MenuItem.Item("多目标直投", "pin", 12));
        r.Add(MenuItem.Item("超级短视频", "play", 13));
        r.Add(MenuItem.Item("超级直播", "bell", 14));
        return r;
    }

    static List<MenuItem> AccessMenu() {
        List<MenuItem> r = new List<MenuItem>();
        r.Add(MenuItem.Header("快捷访问"));
        List<SiteDef> sites = SiteRegistry.QuickAccess();
        for (int i = 0; i < sites.Count; i = i + 1) {
            r.Add(MenuItem.Item(sites[i].name, sites[i].icon, i));
        }
        return r;
    }

    static List<MenuItem> SiteMenu() {
        List<MenuItem> r = new List<MenuItem>();
        r.Add(MenuItem.Header("站点"));
        r.Add(MenuItem.Item("千牛", "home", 0));
        r.Add(MenuItem.Item("天猫超市", "grid", 1));
        r.Add(MenuItem.Item("天猫国际", "globe", 2));
        r.Add(MenuItem.Item("阿里健康", "heart", 3));
        r.Add(MenuItem.Item("淘工厂", "archive", 4));
        r.Add(MenuItem.Item("关闭仅退款", "close", 5));
        return r;
    }

    static List<MenuItem> ShopMenu() {
        List<MenuItem> r = new List<MenuItem>();
        r.Add(MenuItem.Header("店铺工具"));
        r.Add(MenuItem.Item("活动场景", "star", 0));
        r.Add(MenuItem.Item("主体黑名单", "close", 1));
        r.Add(MenuItem.Item("标题助手", "edit", 2));
        r.Add(MenuItem.Item("定时优化", "clock", 3));
        return r;
    }

    static List<MenuItem> MenuFor(int kind) {
        if (kind == 0) { return MainForm.SoftwareMenu(); }
        if (kind == 5) { return MainForm.AccessMenu(); }
        if (kind == 6) { return MainForm.SiteMenu(); }
        if (kind == 7) { return MainForm.ShopMenu(); }
        List<MenuItem> r = new List<MenuItem>();
        r.Add(MenuItem.Header(MainForm.current.CommandTitle(kind)));
        r.Add(MenuItem.Item("未实现/仅演示", "info", 0));
        return r;
    }

    string CommandTitle(int index) {
        if (index == 7) { return "店铺工具"; }
        if (index == 8) { return "统一报表"; }
        if (index == 9) { return "清理"; }
        if (index == 10) { return "网页"; }
        if (index == 11) { return "设置"; }
        if (index == 12) { return "帮助"; }
        return "命令";
    }

    void HandleMenu() {
        int picked = menuAction.Get();
        if (picked < 0) { return; }
        menuOpen.Set(false);
        menuAction.Set(-1);
        if (menuKind == 0) {
            if (picked == 0) {
                MainForm.OpenModuleTab("关键词推广", ToolRegistry.Find("search"));
            } else if (picked == 1) {
                MainForm.OpenModuleTab("精准人群推广", ToolRegistry.Find("displayCrowd"));
            } else {
                MainForm.SetStatus("未实现/仅演示：推广软件");
            }
        } else if (menuKind == 5) {
            this.OpenBrowserByIndex(picked);
        } else if (menuKind == 6) {
            MainForm.SetStatus("站点操作仅演示：" + Convert.ToString(picked));
        } else if (menuKind == 7) {
            MainForm.SetStatus("未实现/仅演示：店铺工具");
        } else {
            MainForm.SetStatus("未实现/仅演示：" + this.CommandTitle(menuKind));
        }
    }

    static void OpenModuleTab(string label, ToolDef def) {
        for (int i = 0; i < MainForm.tabKeys.Count; i = i + 1) {
            if (MainForm.tabKeys[i] == "module:" + def.bizCode) {
                DocumentTabs.Select(i);
                MainForm.ShowTab(i);
                return;
            }
        }
        SearchModulePage page = new SearchModulePage();
        page.SetTool(def);
        int at = DocumentTabs.Count();
        DocumentTabs.Add(label, true);
        MainForm.tabKeys.Add("module:" + def.bizCode);
        MainForm.tabPages.Add(page);
        MainForm.tabBrowsers.Add(null);
        DocumentTabs.Select(at);
        MainForm.ShowTab(at);
        MainForm.SetStatus(label + " · 业务工具 · 假数据");
    }

    void OpenBrowserByIndex(int index) {
        List<SiteDef> sites = SiteRegistry.QuickAccess();
        if (index < 0 || index >= sites.Count) { return; }
        MainForm.OpenSite(sites[index]);
    }

    static void OpenSite(SiteDef site) {
        MainForm.OpenBrowserTab("browser:" + site.key, site.name,
                                site.url, true);
    }

    static void OpenBrowserTab(string key, string name, string url,
                               bool closable) {
        for (int i = 0; i < MainForm.tabKeys.Count; i = i + 1) {
            if (MainForm.tabKeys[i] == key) {
                DocumentTabs.Select(i);
                MainForm.ShowTab(i);
                BrowserPage exist = MainForm.tabBrowsers[i];
                if (exist != null && exist.CurrentUrl() != url) {
                    exist.Navigate(url);
                    DocumentTabs.SetLabel(i, name);
                }
                return;
            }
        }
        int at = DocumentTabs.Count();
        DocumentTabs.Add(name, closable);
        BrowserPage page = new BrowserPage();
        page.Dock(Dock.Fill());
        page.Open(url);
        MainForm.tabKeys.Add(key);
        MainForm.tabPages.Add(page);
        MainForm.tabBrowsers.Add(page);
        DocumentTabs.Select(at);
        MainForm.ShowTab(at);
        MainForm.SetStatus(name + " · " +
            (page.HasBrowser() ? "浏览器已打开" : "浏览器不可用"));
    }

    /// 页面里 window.open / target=_blank 的目标：在本软件里新开一个标签，
    /// 而不是让 CEF 自己弹一个独立的 Chromium 窗口。
    static void OpenPopup(string url) {
        if (url == "") { return; }
        MainForm.OpenBrowserTab("browser:popup:" + url, "新标签", url, true);
    }

    static BrowserPage ActiveBrowser() {
        int active = DocumentTabs.Active();
        if (active < 0 || active >= MainForm.tabBrowsers.Count) { return null; }
        return MainForm.tabBrowsers[active];
    }

    /// 地址回填在网页组件自己的地址框里，主窗体只拿它回报的
    /// 标题更新标签文字。
    static void SyncAddress() {
        BrowserPage b = MainForm.ActiveBrowser();
        if (b == null) { return; }
        string title = b.Sync();
        int active = DocumentTabs.Active();
        if (title != "" && active >= 0 &&
            DocumentTabs.LabelAt(active) != title) {
            DocumentTabs.SetLabel(active, title);
        }
    }

    static void TabChanged() {
        if (MainForm.current != null) {
            MainForm.SetStatus("当前标签：" +
                MainForm.current.DocumentTabs.ActiveLabel());
        }
    }

    /// 标题栏上的登录/授权与运行指标（平均耗时、内存），
    /// 每秒重取一次，对应参考工程标题栏的两组项。
    static void RefreshTitleStatus() {
        if (MainForm.app == null) { return; }
        MainForm.app.SetChromeStatus(SessionState.LoginText(),
                                    SessionState.PerfText());
    }

    static void SetStatus(string text) {
        if (MainForm.current != null) {
            MainStatusBar.SetText(0, text);
        }
    }

    static void ShowTab(int index) {
        if (index < 0 || index >= MainForm.tabPages.Count) { return; }
        DocumentBody.RemoveAll();
        Control page = MainForm.tabPages[index];
        DocumentBody.Add(page);
        page.Dock(Dock.Fill());
        for (int i = 0; i < MainForm.tabBrowsers.Count; i = i + 1) {
            BrowserPage other = MainForm.tabBrowsers[i];
            if (other == null) { continue; }
            if (i == index) { other.Activate(); } else { other.Deactivate(); }
        }
    }

    static App App() { return MainForm.app; }

    static void FrameTick() {
        if (MainForm.current == null || MainForm.app == null) { return; }
        MainForm.current.HandleMenu();
        int changed = DocumentTabs.TakeChanged();
        if (changed >= 0) { MainForm.ShowTab(changed); }
        // 「关闭全部 / 关闭其他」一次移除多个标签，关闭索引在标签条里排队：
        // 一帧只领一个的话，剩下的标签页和浏览器会一直挂着（关完标签 Chromium
        // 进程还在就是这个原因），因此这里一次把队列领干净。
        bool shut = false;
        int closed = DocumentTabs.TakeClosed();
        while (closed >= 0) {
            if (closed < MainForm.tabPages.Count) {
                BrowserPage cb = MainForm.tabBrowsers[closed];
                if (cb != null) { cb.Close(); }
                MainForm.tabPages.RemoveAt(closed);
                MainForm.tabKeys.RemoveAt(closed);
                MainForm.tabBrowsers.RemoveAt(closed);
                shut = true;
            }
            closed = DocumentTabs.TakeClosed();
        }
        if (shut) { MainForm.ShowTab(DocumentTabs.Active()); }
        MainForm.SyncAddress();
        nint evh = Window.EventHwnd();
        if (evh != MainForm.app.WindowHandle()) {
            ChildWindows.Route(evh);
        }
    }

    static void RenderCommandMenu(App a) {
        if (menuOpen.Get()) {
            a.AddOverlay(OverlayPopup.RichMenu(menuX, menuY,
                MainForm.MenuFor(menuKind), 720000, menuAction,
                menuOpen, menuSub));
        }
    }
}
