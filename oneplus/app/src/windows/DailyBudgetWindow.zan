using System;
using Gui;
using Gui.Widget;
using OnePlus.Pages;
using OnePlus.Menu;

namespace OnePlus.Windows;

/// 修改日限额参数窗，提交后直接回写当前泛型表格的选中行。
class DailyBudgetWindow : ChildWindow {
    static DailyBudgetWindow current;
    ObjectPane pane;
    Input amount;
    Label selected;

    override string Title() { return "修改日限额"; }
    override int Width() { return 420; }
    override int Height() { return 250; }

    static void Open(App parent, ObjectPane p) {
        DailyBudgetWindow.current = new DailyBudgetWindow();
        DailyBudgetWindow.current.pane = p;
        DailyBudgetWindow.current.Build();
        DailyBudgetWindow.current.OpenHost(parent);
    }

    void Build() {
        Panel root = Panel.Column();
        root.Gap(10);
        root.Pad(18);
        root.With(new Label("修改日限额") { Class = "title" });
        selected = new Label("已选择 " + Convert.ToString(pane.SelectedCount()) +
                             " 行") { Class = "secondary" };
        amount = new Input("请输入正数金额");
        amount.Dock(Dock.Top()).Prefer(360, 40);
        Button ok = new Button("确定") { Class = "primary" };
        Button cancel = new Button("取消") { Class = "secondary" };
        ok.Click += DailyBudgetWindow.OnOk;
        cancel.Click += DailyBudgetWindow.OnCancel;
        Panel buttons = Panel.Row().Gap(8);
        buttons.With(ok).With(cancel);
        root.With(selected).With(amount).With(buttons);
        this.SetRoot(root, null);
    }

    static void OnOk() {
        if (DailyBudgetWindow.current == null) { return; }
        string text = DailyBudgetWindow.current.amount.GetText();
        double value = Convert.ToDouble(text);
        if (value <= 0.0) {
            DailyBudgetWindow.current.amount.SetError("请输入大于 0 的金额");
            return;
        }
        DailyBudgetWindow.current.pane.WriteField("budget", text);
        DailyBudgetWindow.current.pane.Refresh();
        ActionHost.Say("日限额已回写 " +
                       Convert.ToString(DailyBudgetWindow.current.pane.SelectedCount()) +
                       " 行（假数据）");
        DailyBudgetWindow.current.Close();
    }

    static void OnCancel() {
        if (DailyBudgetWindow.current != null) {
            DailyBudgetWindow.current.Close();
        }
    }
}
