using System;
using Gui;
using Gui.Widget;
using OnePlus.Pages;
using OnePlus.Menu;

namespace OnePlus.Windows;

/// 表格配置窗。配置项直接写入当前 GridPane 的 DataTableState。
class GridConfigWindow : ChildWindow {
    static GridConfigWindow current;
    ObjectPane pane;
    Checkbox striped;
    Checkbox rowNumbers;
    Checkbox summary;
    Checkbox filterRow;

    override string Title() { return "表格配置"; }
    override int Width() { return 420; }
    override int Height() { return 300; }

    static void Open(App parent, ObjectPane p) {
        GridConfigWindow.current = new GridConfigWindow();
        GridConfigWindow.current.pane = p;
        GridConfigWindow.current.Build();
        GridConfigWindow.current.OpenHost(parent);
    }

    void Build() {
        Panel root = Panel.Column();
        root.Gap(8);
        root.Pad(18);
        root.With(new Label("当前表格显示设置"));
        striped = new Checkbox("条纹行");
        rowNumbers = new Checkbox("显示行号");
        summary = new Checkbox("显示汇总");
        filterRow = new Checkbox("显示筛选行");
        Button ok = new Button("应用") { Class = "primary" };
        Button cancel = new Button("取消") { Class = "secondary" };
        ok.Click += GridConfigWindow.OnOk;
        cancel.Click += GridConfigWindow.OnCancel;
        Panel buttons = Panel.Row().Gap(8);
        buttons.With(ok).With(cancel);
        root.With(striped).With(rowNumbers).With(summary)
            .With(filterRow).With(buttons);
        this.SetRoot(root, null);
    }

    static void OnOk() {
        if (GridConfigWindow.current == null) { return; }
        GridConfigWindow.current.pane.Configure(
            GridConfigWindow.current.striped.IsChecked(),
            GridConfigWindow.current.rowNumbers.IsChecked(),
            GridConfigWindow.current.summary.IsChecked(),
            GridConfigWindow.current.filterRow.IsChecked());
        GridConfigWindow.current.pane.Refresh();
        ActionHost.Say("表格配置已应用（假数据）");
        GridConfigWindow.current.Close();
    }

    static void OnCancel() {
        if (GridConfigWindow.current != null) {
            GridConfigWindow.current.Close();
        }
    }
}
