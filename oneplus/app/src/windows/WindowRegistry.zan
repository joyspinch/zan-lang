using Gui;
using OnePlus.Pages;
using OnePlus.Shell;

namespace OnePlus.Windows;

/// 参数窗口只按稳定 key 注册，业务菜单不依赖具体窗口类。
class WindowRegistry {
    static void Open(string key, ObjectPane pane) {
        if (key == "dailyBudget") {
            DailyBudgetWindow.Open(AppShell.App(), pane);
        } else if (key == "gridConfig") {
            GridConfigWindow.Open(AppShell.App(), pane);
        }
    }
}
