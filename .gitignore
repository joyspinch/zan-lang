# OS files
.DS_Store
Thumbs.db

# LLVM IR output
*.ll
*.bc
ir.txt

# Secrets / local credentials (never commit)
sk.txt
secrets.local.ps1
*.local.ps1

# Dev scratch, probes, and ad-hoc tooling output
scratch/
_scratch/
# tools/ is scratch by default; the maintained tools are checked in explicitly.
# "tools/*" rather than "tools/": an excluded directory is never descended into,
# so the negations below would not be reachable.
tools/*
!tools/mge/
!tools/repomap/
!tools/mcp_server/
!tools/ai_pack/
!tools/packtool/
!tools/pack_script.zan
!tools/skinbuilder/
!tools/ra2_retarget_shots.py
!tools/ra2_extract.py
!tools/ra2_diff.py
!tools/ra2_spec/
/1
tmp_*
_tmp_*
*.log

# Ad-hoc benchmark / run logs
bench*.txt
http_*.txt
*_out.txt
*_err.txt
dbg_*.txt
iodbg*.txt
debug*.txt
stdout
srv_pid.txt

# Screenshots
*.png
# Keep committed game art assets (shipped with the games)
!examples/game/**/*.png
# legend 模板运行时素材（迷你传奇资源包提取的原图，随模板分发）
!templates/game/legend/assets/**/*.png
!templates/game/legend/assets/**/*.jpg
# legend 原版界面截图台账（mir2/mir/*.png，REFERENCE_AUDIT.md 的权威依据）
!templates/game/legend/mir2/**/*.png
# goldminer 模板运行时素材（原版 exe 嵌入表提取的处理后原图，随模板分发）
!templates/game/goldminer/assets/**/*.png
# 新美术化游戏模板（象棋/围棋/五子棋/斗地主）真实手绘资产，随模板分发
!templates/game/xiangqi/assets/**/*.png
!templates/game/weiqi/assets/**/*.png
!templates/game/gomoku/assets/**/*.png
!templates/game/ddz/assets/**/*.png

# --- Agent / PR workflow artifacts (must never be committed) ---
# Commit-message drafts and PR bodies
commit_msg*.txt
pr[0-9]*_body.md
pr_body*.md
pr[0-9]*_msg.txt
pr_meta.json
.dev_*
# Diffs and patches produced during review
*.diff
*.patch
# Ad-hoc PR / build helper scripts dropped in the repo root
mkpr*.py
updpr*.py
push.bat
_*.ps1
_*.c

# Cross-compiled / extensionless native probe binaries
spawn_probe_linux
test_cross_linux*
*_srv_linux
*_srv_new
*_srv_old
http_srv_new
http_srv_old

# Dev helper scripts / commit-message drafts
scripts/_*

# Compiled example executables (extensionless artifacts)
/examples/hello
/examples/net_bench
/examples/http_client_bench
/examples/static_call_test

# Golden test case binaries (dump-ast compiles a stray executable)
tests/golden/cases/*
!tests/golden/cases/*.zan

# Leak-probe scratch (ad-hoc memory probes, not real tests)
tests/leakprobe/
build-linux/
build-wsl/
dist/

# Game resource-pack master key shares (XOR halves; losing them loses the pack)
zrp.keys/

# CI release packaging output (archives + checksums)
out/

# Local game runtime data (saves, attract-mode flags)
*_save.txt
*_demo.txt
examples/web/
examples/game/mir2/

# RepoMap / AI index output (regenerate with tools/repomap)
.zanmap/

# Project-local package store (marketplace installs), never version-controlled
.zan-packages/

# ZCode agent tool state (plans, session metadata)
.zcode/

# Golden-test scratch output written next to the expected files
tests/golden/expected/*.actual

# Reference PHP framework dump (user's previous framework, not a zan template)
templates/server/server-mvc/web/
stdlib/Sdk/jos-net-open-api-sdk-2.0/
stdlib/Sdk/WeiXinMPSDK-master/
AotAnywhere/
build-gcc/
# 并存的多工具链构建目录（build15 = LLVM 15 配置等）
build[0-9]*/
mcp/examples/
mcp/knowledge/
mcp/stdlib/
mcp/templates/
mcp/toolchain/

# Python bytecode caches (tools/*.py get imported by editors/test runners)
__pycache__/
*.pyc
data/
# template data dirs are versioned game data (client CSVs, server M2.DB);
# re-allow traversal so tracked files and the DB stay committable
!templates/**/data/
!templates/**/data/**
# stdlib 源码目录 System/Data/ 与运行时 data/ 同名（ignorecase=true 时
# data/ 连 Data/ 一起吞掉）；数据层源码必须可提交，新文件才不会静默消失
!stdlib/System/Data/
!stdlib/System/Data/**

# CTest dashboard output at repo root
/Testing/
