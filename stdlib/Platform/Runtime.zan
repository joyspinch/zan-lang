using System;

namespace Platform;

/// <summary>
/// 运行时平台检测与信息。所有查询都解析为
/// 编译时选定的目标平台（WINDOWS / LINUX / MACOS），
/// 因此交叉编译的程序报告目标系统而非构建主机。
/// </summary>
class Runtime {
    #if WINDOWS
    [DllImport("crt", EntryPoint = "_getpid")]
    static extern int plat_getpid();
    #else
    [DllImport("crt", EntryPoint = "getpid")]
    static extern int plat_getpid();
    #endif

    /// <summary>返回当前平台名称。</summary>
    static string GetPlatform() {
        #if WINDOWS
        return "windows";
        #elif MACOS
        return "macos";
        #else
        return "linux";
        #endif
    }

    /// <summary>在 Windows 上运行时返回 true。</summary>
    static bool IsWindows() {
        #if WINDOWS
        return true;
        #else
        return false;
        #endif
    }

    /// <summary>在 Linux 上运行时返回 true。</summary>
    static bool IsLinux() {
        #if LINUX
        return true;
        #else
        return false;
        #endif
    }

    /// <summary>在 macOS 上运行时返回 true。</summary>
    static bool IsMacOS() {
        #if MACOS
        return true;
        #else
        return false;
        #endif
    }

    /// <summary>获取当前进程 ID。</summary>
    static int GetProcessId() {
        return plat_getpid();
    }

    /// <summary>返回当前平台的路径分隔符。</summary>
    static string PathSeparator() {
        #if WINDOWS
        return "\\";
        #else
        return "/";
        #endif
    }

    /// <summary>返回当前平台的换行符。</summary>
    static string NewLine() {
        #if WINDOWS
        return "\r\n";
        #else
        return "\n";
        #endif
    }
}
