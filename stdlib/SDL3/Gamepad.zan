using System;

namespace SDL3;

/// <summary>已打开的手柄。
///
/// 工厂方法永远返回对象：没插手柄时 <see cref="IsOpen"/> 为 false，
/// 读按键/轴返回 0，因此手柄热插拔的代码不需要判空。</summary>
class SdlGamepad {
    nint handle;

    /// <summary>初始化手柄子系统（Sdl.Init 已带 SdlInit.Gamepad() 时可省）。</summary>
    static bool Init() {
        return SdlNative.zan_gamepad_init() != 0;
    }

    /// <summary>当前接入的手柄数量。</summary>
    static int Count() {
        return SdlNative.zan_gamepad_count();
    }

    /// <summary>第 <paramref name="index"/> 个手柄的实例 id（事件里的
    /// which），越界返回 0。</summary>
    static int IdAt(int index) {
        return SdlNative.zan_gamepad_id_at(index);
    }

    /// <summary>按实例 id 打开手柄（GAMEPAD_ADDED 事件的 which）。</summary>
    static SdlGamepad Open(int which) {
        SdlGamepad pad = new SdlGamepad();
        pad.handle = SdlNative.zan_gamepad_open(which);
        return pad;
    }

    /// <summary>打开第一个手柄；没有手柄时返回未打开的对象。</summary>
    static SdlGamepad OpenFirst() {
        SdlGamepad pad = new SdlGamepad();
        pad.handle = SdlNative.zan_gamepad_open_first();
        return pad;
    }

    bool IsOpen() { return this.handle != 0; }

    /// <summary>手柄名（未打开时为空串）。</summary>
    string Name() { return SdlNative.zan_gamepad_name(this.handle); }

    /// <summary>实例 id，和事件里的 which 对得上。</summary>
    int Id() { return SdlNative.zan_gamepad_id(this.handle); }

    bool IsDown(int button) {
        return SdlNative.zan_gamepad_button(this.handle, button) != 0;
    }

    /// <summary>轴原始值：摇杆 -32768..32767，扳机 0..32767。</summary>
    int Axis(int axis) {
        return SdlNative.zan_gamepad_axis(this.handle, axis);
    }

    /// <summary>轴归一化到 -1..1（扳机为 0..1）。</summary>
    double AxisNormalized(int axis) {
        double raw = (double)SdlNative.zan_gamepad_axis(this.handle, axis);
        if (raw < 0.0) { return raw / 32768.0; }
        return raw / 32767.0;
    }

    /// <summary>震动。<paramref name="low"/>/<paramref name="high"/> 是
    /// 低频/高频马达强度（0..65535），持续 <paramref name="milliseconds"/>。</summary>
    bool Rumble(int low, int high, int milliseconds) {
        return SdlNative.zan_gamepad_rumble(
            this.handle, low, high, milliseconds) != 0;
    }

    void Close() {
        if (this.handle != 0) {
            SdlNative.zan_gamepad_close(this.handle);
            this.handle = 0;
        }
    }
}

/// <summary>手柄按键编号（SDL 的位置命名：South 是 Xbox 的 A）。</summary>
class SdlGamepadButton {
    static int South() { return 0; }
    static int East() { return 1; }
    static int West() { return 2; }
    static int North() { return 3; }
    static int Back() { return 4; }
    static int Guide() { return 5; }
    static int Start() { return 6; }
    static int LeftStick() { return 7; }
    static int RightStick() { return 8; }
    static int LeftShoulder() { return 9; }
    static int RightShoulder() { return 10; }
    static int DpadUp() { return 11; }
    static int DpadDown() { return 12; }
    static int DpadLeft() { return 13; }
    static int DpadRight() { return 14; }
}

/// <summary>手柄轴编号。</summary>
class SdlGamepadAxis {
    static int LeftX() { return 0; }
    static int LeftY() { return 1; }
    static int RightX() { return 2; }
    static int RightY() { return 3; }
    static int LeftTrigger() { return 4; }
    static int RightTrigger() { return 5; }
}
