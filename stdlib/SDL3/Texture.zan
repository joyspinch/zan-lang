using System;

namespace SDL3;

/// <summary>持有 SDL_Texture 句柄。</summary>
class SdlTexture {
    nint handle;

    static SdlTexture CreateRgba32(SdlRenderer renderer, int width, int height, bool streaming) {
        int streamValue = 0;
        if (streaming) { streamValue = 1; }
        SdlTexture texture = new SdlTexture();
        texture.handle = SdlNative.zan_sdl_create_texture_rgba32(
            renderer.Handle(), width, height, streamValue);
        return texture;
    }

    static SdlTexture LoadBmp(SdlRenderer renderer, string path) {
        SdlTexture texture = new SdlTexture();
        texture.handle = SdlNative.zan_sdl_load_bmp_texture(renderer.Handle(), path);
        return texture;
    }

    /// <summary>
    /// 将 PNG、JPEG 或其他 stb_image 支持的格式加载为 RGBA32。
    /// 保留 PNG 的 Alpha 并启用 alpha 混合。
    /// </summary>
    static SdlTexture LoadImage(SdlRenderer renderer, string path) {
        SdlTexture texture = new SdlTexture();
        texture.handle = SdlNative.zan_sdl_load_image_texture(
            renderer.Handle(), path);
        return texture;
    }

    /// <summary>加载 RGB BMP，并将一种颜色视为透明。</summary>
    static SdlTexture LoadBmpColorKey(
        SdlRenderer renderer,
        string path,
        int red,
        int green,
        int blue
    ) {
        SdlTexture texture = new SdlTexture();
        texture.handle = SdlNative.zan_sdl_load_bmp_texture_colorkey(
            renderer.Handle(),
            path,
            red,
            green,
            blue);
        return texture;
    }

    /// <summary>创建离屏渲染目标纹理（线性过滤），
    /// 渲染器可通过 <see cref="SdlRenderer.SetTarget"/> 绘制到其中。
    /// 这是降采样模糊和缓存背景的基础。</summary>
    static SdlTexture CreateTarget(SdlRenderer renderer, int width, int height) {
        SdlTexture texture = new SdlTexture();
        texture.handle = SdlNative.zan_sdl_create_target_texture(
            renderer.Handle(), width, height);
        return texture;
    }

    bool IsValid() { return this.handle != 0; }
    nint Handle() { return this.handle; }

    bool Update(string rgbaPixels, int pitch) {
        return SdlNative.zan_sdl_update_texture(this.handle, rgbaPixels, pitch) != 0;
    }

    bool SetNearest(bool nearest) {
        int flagValue = 0;
        if (nearest) { flagValue = 1; }
        return SdlNative.zan_sdl_set_texture_nearest(this.handle, flagValue) != 0;
    }

    /// <summary>设置 SDL 纹理混合模式。模式 1 为 alpha 混合。</summary>
    bool SetBlendMode(int mode) {
        return SdlNative.zan_sdl_set_texture_blend(this.handle, mode) != 0;
    }

    bool SetColor(int red, int green, int blue) {
        return SdlNative.zan_sdl_set_texture_color(
            this.handle, red, green, blue) != 0;
    }

    bool ResetColor() { return this.SetColor(255, 255, 255); }

    bool SetOpacity(int alpha) {
        if (alpha < 0) { alpha = 0; }
        if (alpha > 255) { alpha = 255; }
        return SdlNative.zan_sdl_set_texture_nearest(
            this.handle, 256 + alpha) != 0;
    }

    void Close() {
        if (this.handle != 0) {
            SdlNative.zan_sdl_destroy_texture(this.handle);
            this.handle = 0;
        }
    }
}
