using System;

namespace SDL3;

/// <summary>持有 SDL_Window 句柄。</summary>
class SdlWindow {
    nint handle;

    /// 创建窗口（flags 为 SDL_WindowFlags 位组合）。
    static SdlWindow Create(string title, int width, int height, int flags) {
        SdlWindow window = new SdlWindow();
        window.handle = SdlNative.zan_sdl_create_window(title, width, height, flags);
        return window;
    }

    /// 句柄是否有效（创建成功）。
    bool IsValid() { return this.handle != 0; }
    /// 原生 SDL_Window 句柄。
    nint Handle() { return this.handle; }
    /// 窗口的 SDL 实例 id。
    int Id() { return SdlNative.zan_sdl_window_id(this.handle); }
    /// 当前客户区宽（像素，随缩放/最大化变化）。
    int Width() { return SdlNative.zan_sdl_window_width(this.handle); }
    /// 当前客户区高（像素）。
    int Height() { return SdlNative.zan_sdl_window_height(this.handle); }

    /// 设置标题栏文字。
    bool SetTitle(string title) {
        return SdlNative.zan_sdl_set_window_title(this.handle, title) != 0;
    }

    /// 切换全屏。
    bool SetFullscreen(bool enabled) {
        int flagValue = 0;
        if (enabled) { flagValue = 1; }
        return SdlNative.zan_sdl_set_window_fullscreen(this.handle, flagValue) != 0;
    }

    /// 无边框拖拽/缩放命中测试：外框 6px 缩放、顶部 40px 拖动
    /// （自绘标题栏用）；`logicalW` 是设计单位宽，用于换算排除条。
    bool SetGameHitTest(int logicalW) {
        return SdlNative.zan_sdl_set_game_hittest(this.handle, logicalW) != 0;
    }

    /// 在屏幕坐标处弹原生系统菜单（移动/大小/最小化/关闭）。
    bool ShowSystemMenu(int x, int y) {
        return SdlNative.zan_sdl_show_window_menu(this.handle, x, y) != 0;
    }

    /// 最大化窗口。
    bool Maximize() { return SdlNative.zan_sdl_maximize_window(this.handle) != 0; }
    /// 最小化窗口。
    bool Minimize() { return SdlNative.zan_sdl_minimize_window(this.handle) != 0; }
    /// 从最大化/全屏恢复到原窗口尺寸（退出全屏后还原用）。
    bool Restore() { return SdlNative.zan_sdl_restore_window(this.handle) != 0; }

    /// 显示窗口。
    bool Show() { return SdlNative.zan_sdl_show_window(this.handle) != 0; }
    /// 隐藏窗口。
    bool Hide() { return SdlNative.zan_sdl_hide_window(this.handle) != 0; }

    /// 销毁窗口并释放句柄（Close 后不可再用）。
    void Close() {
        if (this.handle != 0) {
            SdlNative.zan_sdl_destroy_window(this.handle);
            this.handle = 0;
        }
    }
}
