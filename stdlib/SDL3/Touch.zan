using System;

namespace SDL3;

/// <summary>触摸设备。手指事件本身从 <see cref="SdlEvent"/> 上读
/// （FingerId / FingerX …），这里只做设备枚举。</summary>
class SdlTouch {
    /// <summary>接入的触摸设备数量（桌面上通常为 0）。</summary>
    static int DeviceCount() {
        return SdlNative.zan_touch_device_count();
    }

    /// <summary>第 <paramref name="index"/> 个触摸设备 id，越界返回 0。</summary>
    static long DeviceAt(int index) {
        return SdlNative.zan_touch_device_at(index);
    }

    static string DeviceName(long device) {
        return SdlNative.zan_touch_device_name(device);
    }
}
