using System;

namespace SDL3;

/// <summary>
/// SDL_GPU 精灵管线的 ABI 安全原生桥接（Metal/Vulkan/D3D12）。
///
/// 句柄为指针大小（<c>nint</c>），坐标是 32 位，
/// 与 <see cref="SdlNative"/> 的 C ABI 匹配；像素缓冲区为原始字节字符串。
/// </summary>
class SdlGpuNative {
    [DllImport("zan_sdl3")]
    static extern nint zan_gpu_create(nint window);

    [DllImport("zan_sdl3")]
    static extern nint zan_gpu_create_offscreen(int width, int height);

    [DllImport("zan_sdl3")]
    static extern void zan_gpu_destroy(nint handle);

    [DllImport("zan_sdl3")]
    static extern nint zan_gpu_load_texture(nint handle, int width, int height, string pixels);

    [DllImport("zan_sdl3")]
    static extern nint zan_gpu_solid_texture(nint handle, int width, int height);

    [DllImport("zan_sdl3")]
    static extern nint zan_gpu_load_bmp(nint handle, string path);

    [DllImport("zan_sdl3")]
    static extern nint zan_gpu_load_image(nint handle, string path);

    [DllImport("zan_sdl3")]
    static extern void zan_gpu_free_texture(nint handle, nint texture);

    [DllImport("zan_sdl3")]
    static extern int zan_gpu_texture_width(nint texture);

    [DllImport("zan_sdl3")]
    static extern int zan_gpu_texture_height(nint texture);

    [DllImport("zan_sdl3")]
    static extern int zan_gpu_begin(nint handle, int red, int green, int blue, int alpha);

    [DllImport("zan_sdl3")]
    static extern void zan_gpu_draw(
        nint handle,
        nint texture,
        int dstX,
        int dstY,
        int dstW,
        int dstH,
        int srcX,
        int srcY,
        int srcW,
        int srcH,
        int red,
        int green,
        int blue,
        int alpha);

    [DllImport("zan_sdl3")]
    static extern void zan_gpu_end(nint handle);

    [DllImport("zan_sdl3")]
    static extern int zan_gpu_read_pixel(nint handle, int x, int y);
}

/// <summary>由 <see cref="SdlGpu"/> 上下文拥有的 GPU 纹理。</summary>
class SdlGpuTexture {
    nint context;
    nint handle;
    SdlGpu owner;

    bool IsValid() { return this.handle != 0; }
    nint Handle() { return this.handle; }
    int Width() { return SdlGpuNative.zan_gpu_texture_width(this.handle); }
    int Height() { return SdlGpuNative.zan_gpu_texture_height(this.handle); }

    void Free() {
        if (this.handle != 0) {
            if (this.context != 0) {
                SdlGpuNative.zan_gpu_free_texture(this.context, this.handle);
            }
            this.handle = 0;
        }
        if (this.owner != null) {
            this.owner.Untrack(this);
            this.owner = null;
        }
        this.context = 0;
    }
}

/// <summary>
/// SDL_GPU 精灵渲染器：获取交换链（或离屏目标），
/// 每帧批量绘制带纹理四边形并提交到 GPU。后端
/// （macOS 为 Metal、Linux 为 Vulkan、Windows 为 D3D12）由 SDL 选择。
/// </summary>
class SdlGpu {
    nint handle;
    List<SdlGpuTexture> textures;

    /// <summary>创建向 <paramref name="window"/> 呈现的 GPU 上下文。</summary>
    static SdlGpu Create(SdlWindow window) {
        SdlGpu gpu = new SdlGpu();
        gpu.handle = SdlGpuNative.zan_gpu_create(window.Handle());
        gpu.textures = new List<SdlGpuTexture>();
        return gpu;
    }

    /// <summary>创建无窗口上下文，渲染到 width x height
    /// 目标，可通过 <see cref="ReadPixel"/> 读取。适用于无头测试。</summary>
    static SdlGpu CreateOffscreen(int width, int height) {
        SdlGpu gpu = new SdlGpu();
        gpu.handle = SdlGpuNative.zan_gpu_create_offscreen(width, height);
        gpu.textures = new List<SdlGpuTexture>();
        return gpu;
    }

    bool IsValid() { return this.handle != 0; }
    nint Handle() { return this.handle; }

    /// <summary>在上下文有效时记录子纹理，便于
    /// <see cref="Destroy"/> 按顺序释放。</summary>
    void Track(SdlGpuTexture tex) {
        if (this.handle != 0 && tex != null) {
            this.textures.Add(tex);
        }
    }

    void Untrack(SdlGpuTexture tex) {
        int i = 0;
        int n = this.textures.Count;
        while (i < n) {
            if (this.textures[i] == tex) {
                this.textures.RemoveAt(i);
                return;
            }
            i = i + 1;
        }
    }

    SdlGpuTexture MakeTexture() {
        SdlGpuTexture tex = new SdlGpuTexture();
        tex.context = this.handle;
        tex.owner = this;
        this.Track(tex);
        return tex;
    }

    /// <summary>以紧凑的 RGBA32 像素上传为采样纹理。</summary>
    SdlGpuTexture LoadTexture(int width, int height, string pixels) {
        SdlGpuTexture tex = this.MakeTexture();
        tex.handle = SdlGpuNative.zan_gpu_load_texture(this.handle, width, height, pixels);
        return tex;
    }

    /// <summary>创建纯白纹理；通过绘制颜色着色。</summary>
    SdlGpuTexture SolidTexture(int width, int height) {
        SdlGpuTexture tex = this.MakeTexture();
        tex.handle = SdlGpuNative.zan_gpu_solid_texture(this.handle, width, height);
        return tex;
    }

    /// <summary>加载 BMP 文件并转换为 RGBA32。</summary>
    SdlGpuTexture LoadBmp(string path) {
        SdlGpuTexture tex = this.MakeTexture();
        tex.handle = SdlGpuNative.zan_gpu_load_bmp(this.handle, path);
        return tex;
    }

    /// <summary>将 PNG/JPEG 图像数据加载为 RGBA32 采样纹理。</summary>
    SdlGpuTexture LoadImage(string path) {
        SdlGpuTexture tex = this.MakeTexture();
        tex.handle = SdlGpuNative.zan_gpu_load_image(this.handle, path);
        return tex;
    }

    /// <summary>开始一帧并设置清除颜色（每通道 0-255）。</summary>
    bool Begin(int red, int green, int blue, int alpha) {
        return SdlGpuNative.zan_gpu_begin(this.handle, red, green, blue, alpha) != 0;
    }

    /// <summary>将整个纹理绘制到目标矩形中，并着色。</summary>
    void Draw(SdlGpuTexture texture, int x, int y, int width, int height,
              int red, int green, int blue, int alpha) {
        SdlGpuNative.zan_gpu_draw(this.handle, texture.Handle(),
            x, y, width, height, 0, 0, 0, 0, red, green, blue, alpha);
    }

    /// <summary>将源区域（纹理像素）绘制到目标矩形，
    /// 并着色。源宽/高为 0 表示整个纹理。</summary>
    void DrawRegion(SdlGpuTexture texture,
                    int dstX, int dstY, int dstW, int dstH,
                    int srcX, int srcY, int srcW, int srcH,
                    int red, int green, int blue, int alpha) {
        SdlGpuNative.zan_gpu_draw(this.handle, texture.Handle(),
            dstX, dstY, dstW, dstH, srcX, srcY, srcW, srcH, red, green, blue, alpha);
    }

    /// <summary>将批处理的一帧提交到 GPU。</summary>
    void End() { SdlGpuNative.zan_gpu_end(this.handle); }

    /// <summary>从最后的离屏帧读取一个像素，打包为 0xRRGGBBAA。</summary>
    int ReadPixel(int x, int y) {
        return SdlGpuNative.zan_gpu_read_pixel(this.handle, x, y);
    }

    void Destroy() {
        if (this.handle != 0) {
            // 先释放所有子纹理：一旦上下文销毁，
            // native 端将再无法接受 free_texture。
            int i = this.textures.Count - 1;
            while (i >= 0) {
                SdlGpuTexture tex = this.textures[i];
                this.textures.RemoveAt(i);
                if (tex != null) {
                    tex.owner = null;
                    tex.Free();
                }
                i = i - 1;
            }
            SdlGpuNative.zan_gpu_destroy(this.handle);
            this.handle = 0;
        }
    }
}
