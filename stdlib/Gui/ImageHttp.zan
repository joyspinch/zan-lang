using System;
using System.Net.Sockets;
using System.Net.Http;
using System.Net.Http.Client;
using System.Net.External;
using System.Threading;
using Gui;
using Gui.Widget;

namespace Gui;

/// <summary>Image 控件与 DataTable 图片列共用的网络图片加载器。
/// 分工与 DownloadJob 一致：取回在后台 OS 线程上以协程 await 完成
///（不阻塞 UI），结果经 <see cref="App.Post"/> 封送回 UI 线程再解码
/// 注册；单个共享 worker 逐条处理排队的请求。UI 线程入口是
/// <see cref="Fetch"/>（控件模式）与 <see cref="EnsureUrl"/>（无控件
/// 的 URL 槽模式）。</summary>
class ImageHttp {
    /// 一次取回请求：UI 线程排队，worker 领走，完成后经 Post 通知。
    /// img 为 null 时是 URL 槽请求（见 EnsureUrl）。
    class Req {
        string url;
        string key;
        App app;
        Image img;
    }

    /// URL 槽：一段 URL 的加载状态。就绪后 key 指向已注册的
    /// `mem:` 图像，可反复绘制；失败保持 2，不自动重试。
    class Slot {
        string key;
        int state;   // 0 加载中，1 就绪，2 失败
    }

    static nint lockHandle;
    static List<Req> pending;
    static bool workerStarted;
    static Dict<string, Slot> urlSlots;
    static int slotSeq;

    /// UI 线程调用：确保 `url` 的图片取回已排队（无控件场景，例如
    /// DataTable 图片列）。就绪返回已注册的 `mem:` key，加载中或
    /// 失败返回 null——同一 URL 只排队一次，结果缓存供后续帧直用。
    static string EnsureUrl(App app, string url) {
        if (url == null || url == "") { return null; }
        if (urlSlots == null) { urlSlots = new Dict<string, Slot>(); }
        if (urlSlots.ContainsKey(url)) {
            Slot have = urlSlots[url];
            if (have.state == 1) { return have.key; }
            return null;
        }
        slotSeq = slotSeq + 1;
        Slot s = new Slot();
        s.key = "mem:slot" + Convert.ToString(slotSeq);
        s.state = 0;
        urlSlots[url] = s;
        ImageHttp.Fetch(app, null, url, s.key);
        return null;
    }

    /// UI 线程调用：排队一次 URL 取回。worker 首次需要时启动。
    static void Fetch(App app, Image img, string url, string key) {
        if (lockHandle == 0) {
            lockHandle = Mutex.Create();
            pending = new List<Req>();
        }
        Req r = new Req();
        r.url = url;
        r.key = key;
        r.app = app;
        r.img = img;
        Mutex.Lock(lockHandle);
        pending.Add(r);
        bool needWorker = !workerStarted;
        workerStarted = true;
        Mutex.Unlock(lockHandle);
        if (needWorker) {
            if (!Thread.Start(ImageHttp.WorkerLoop)) {
                // 线程起不来：统一走 Apply 失败路径（控件显示失败占位，
                // URL 槽置失败态）。
                Req fail = r;
                app.Post(() => { ImageHttp.Apply(fail, null, null, 0, "no worker"); });
            }
        }
    }

    /// worker 线程入口：逐条取回直到队列清空，然后退出
    ///（下一次 Fetch 会重新拉起）。await 让出期间 IO 反应器推进传输。
    static void WorkerLoop() {
        Socket.Initialize();
        while (true) {
            Req r = ImageHttp.Take();
            if (r == null) {
                Mutex.Lock(lockHandle);
                if (pending.Count == 0) {
                    workerStarted = false;
                    Mutex.Unlock(lockHandle);
                    return;
                }
                Mutex.Unlock(lockHandle);
                continue;
            }
            await ImageHttp.FetchOne(r);
        }
    }

    static Req Take() {
        Req r = null;
        Mutex.Lock(lockHandle);
        if (pending.Count > 0) {
            r = pending[0];
            pending.RemoveAt(0);
        }
        Mutex.Unlock(lockHandle);
        return r;
    }

    /// 取回单个 URL。传输里任何一处抛出（DNS、TLS、断开的套接字、
    /// 超时）都必须变成一条错误结果：不接住的话 worker 静静死掉，
    /// 控件会永远停在加载占位上。
    static async int FetchOne(Req r) {
        string err = "";
        string body = null;
        byte[] bytes = null;
        int blen = 0;
        ExternalTarget target = ExternalTarget.Parse(r.url);
        if (target == null || !ExternalTargetPolicy.IsAllowedTarget(
                target, false, false)) {
            err = "bad url";
        } else {
            try {
                HttpClient client = HttpClient.CreateHttps(target.Host(),
                    target.Port());
                ExternalCallPolicy policy = ExternalCallPolicy.Default()
                    .TotalTimeout(15000)
                    .ResponseLimit(16 * 1024 * 1024)
                    .StreamLimit(16 * 1024 * 1024);
                client.SetCallPolicy(policy);
                // 二进制安全通道：图片字节里的 NUL 不能让响应在
                // strlen 语义下提前截断（否则 JPEG 头几个字节就是终点）。
                HttpResponse resp = await client.SendBytesAsync("GET",
                    target.Path() + target.Query(), "");
                if (resp.statusCode != 200) {
                    err = "HTTP " + resp.statusCode;
                } else if (resp.IsBinary()) {
                    bytes = resp.bodyBytes;
                    blen = resp.BodyLength();
                } else {
                    body = resp.body;
                    blen = resp.BodyLength();
                }
            } catch (Exception ex) {
                err = ex.Message;
            }
        }
        string e = err;
        string b = body;
        byte[] bb = bytes;
        int n = blen;
        r.app.Post(() => { ImageHttp.Apply(r, bb, b, n, e); });
        return 0;
    }

    /// UI 线程：把取回的字节注册进图像缓存并通知消费方。解码必须
    /// 发生在 UI 线程（图像注册表与光栅器只从 UI 线程触碰）。
    static void Apply(Req r, byte[] bytes, string body, int len, string err) {
        if (r.img == null) {
            // URL 槽模式：注册 key、置状态、触发重绘（下一帧命中缓存）。
            Slot s = null;
            if (urlSlots != null && urlSlots.ContainsKey(r.url)) {
                s = urlSlots[r.url];
            }
            if (s != null) {
                bool ok = false;
                if (err == "") {
                    int w = 0;
                    if (bytes != null) {
                        w = Canvas.ImageLoadMem(s.key, bytes, len);
                    } else if (body != null) {
                        if (body.Contains("<svg")) {
                            w = Canvas.ImageLoadSvg(s.key, body, 0, 0);
                        } else {
                            w = Canvas.ImageLoadMem(s.key, body, len);
                        }
                    }
                    ok = w > 0;
                }
                if (ok) {
                    s.state = 1;
                } else {
                    s.state = 2;
                }
                r.app.RequestRedraw();
            }
            return;
        }
        if (err == "") {
            int w2 = 0;
            if (bytes != null) {
                w2 = Canvas.ImageLoadMem(r.key, bytes, len);
            } else if (body != null) {
                if (body.Contains("<svg")) {
                    r.img.OnSvgFetched(body);
                    return;
                }
                w2 = Canvas.ImageLoadMem(r.key, body, len);
            }
            if (w2 > 0) {
                r.img.OnFetched(r.key, w2, Canvas.ImageHeight(r.key));
                return;
            }
        }
        r.img.OnFetchFailed();
    }

}
