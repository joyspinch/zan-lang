using Gui;
using Gui.Widget;
using Gui.Hmi;

namespace Gui;

/// <summary>
/// 标准保留控件的 HeavyControls 注册入口（与 CEF/WebView/Chart/
/// DataTable 同一契约：先注册后可用）。ControlFactory 不再内联任何
/// `new Xxx()` 分支——那样每个分支名都是活标识符，auto-stdlib 按需
/// 拉取会把全部控件文件（连同 ImageHttp→网络栈这样的重依赖）拖进
/// 每个程序的编译图。设计器生成代码与手写 `new Button()` 直接持有
/// 类型，不受影响；运行期按 kind 字符串重建（Serialize/Html 克隆、
/// FormBuilder、动态表单）的宿主在启动时调用一次 <see cref="Install"/>。
/// 不调用的程序只编译自己拼写过的控件。
/// </summary>
class ControlBootstrap {
    static bool installed;

    /// ControlFactory 主 switch 原有的 kind 名单（设计器面板与
    /// JSON 装载器的标准保留控件），外加设计器工具箱全量的
    /// 展示/反馈/导航/工控 kind——名单缺了它们，Serialize/Html
    /// 克隆、FormBuilder 动态表单按 kind 重建时拿到 null，控件
    /// 在运行期整体消失（与 GenForm.IsStdWidgetKind 对齐）。
    static List<string> Names() {
        return new List<string>{
            "Panel", "Label", "Button", "Progress", "Input", "TextArea",
            "InputOtp",
            "Switch", "Checkbox", "Radio", "Slider", "SelectBox", "Rate",
            "Pagination", "Tabs", "DatePicker", "ColorPicker", "VirtualList",
            "AlarmBanner",
            "AlarmList", "SplitPanel", "ToolStrip", "StatusBar",
            "FloatButton", "RadioGroup", "RadioButtonGroup", "CheckboxGroup",
            "ScrollColumn",
            "Divider", "Flex", "Grid", "GridItem", "Image", "Watermark",
            "Countdown", "QrCode", "Upload",
            "NumberAnimation",
            "Marquee",
            "DynamicTags",
            "Calendar", "Card",
            "Tag", "Badge", "Avatar", "Statistic", "Timeline", "TreeView",
            "Collapse", "Empty", "Result", "Skeleton", "Spin", "Steps",
            "Breadcrumb", "PageHeader", "ListView", "Dropdown", "Carousel",
            "Led", "Digital", "Gauge", "Bargraph", "Trend",
            "NumPad", "DeviceCard", "EquipPanel" };
    }

    /// 注册全部标准 kind（幂等）。调用后 ControlFactory.Kinds() 与
    /// Create(kind) 恢复完整名单。
    static void Install() {
        if (installed) { return; }
        installed = true;
        List<string> names = ControlBootstrap.Names();
        for (int i = 0; i < names.Count; i = i + 1) {
            HeavyControls.Register(names[i], Make);
        }
    }

    /// kind → 控件实例（与原 ControlFactory 主 switch 逐分支等价；
    /// 泛型控件 DataGrid/Transfer 在 DataTableBootstrap、ChartHost 在
    /// ChartBootstrap）。未注册 kind 返回 null（"miss 即 null"契约
    /// 不变——拼错的 kind 仍显式失败）。
    static Control Make(string kind) {
        if (kind == "Panel") { return new Panel(); }
        if (kind == "Label") { return new Label(); }
        if (kind == "Button") { return new Button(); }
        if (kind == "Progress") { return new Progress(); }
        if (kind == "Input") { return new Input(); }
        if (kind == "InputOtp") { return new InputOtp(); }
        if (kind == "TextArea") { return new TextArea(); }
        if (kind == "Switch") { return new Switch(); }
        if (kind == "Checkbox") { return new Checkbox(); }
        if (kind == "Radio") { return new Radio(); }
        if (kind == "Slider") { return new Slider(); }
        if (kind == "SelectBox") { return new SelectBox(); }
        if (kind == "Rate") { return new Rate(); }
        if (kind == "Pagination") { return new Pagination(); }
        if (kind == "Tabs") { return new Tabs(); }
        if (kind == "DatePicker") { return new DatePicker(); }
        if (kind == "ColorPicker") { return new ColorPicker(); }
        if (kind == "VirtualList") { return new VirtualList(); }
        if (kind == "AlarmBanner") { return new AlarmBanner(); }
        if (kind == "AlarmList") { return new AlarmList(); }
        if (kind == "SplitPanel") { return new SplitPanel(); }
        if (kind == "ToolStrip") { return new ToolStrip(); }
        if (kind == "StatusBar") { return new StatusBar(); }
        if (kind == "FloatButton") { return new FloatButton(); }
        if (kind == "RadioGroup") { return new RadioGroup(); }
        if (kind == "RadioButtonGroup") { return new RadioButtonGroup(); }
        if (kind == "CheckboxGroup") { return new CheckboxGroup(); }
        if (kind == "ScrollColumn") { return new ScrollColumn(); }
        if (kind == "Divider") { return new Divider(); }
        if (kind == "Flex") { return new Flex(); }
        if (kind == "Grid") { return new Grid(); }
        if (kind == "GridItem") { return new GridItem(); }
        if (kind == "Image") { return new Image(); }
        if (kind == "Watermark") { return new Watermark(); }
        if (kind == "Countdown") { return new Countdown(); }
        if (kind == "QrCode") { return new QrCode(); }
        if (kind == "Upload") { return new Upload(); }
        if (kind == "NumberAnimation") { return new NumberAnimation(); }
        if (kind == "Marquee") { return new Marquee(); }
        if (kind == "DynamicTags") { return new DynamicTags(); }
        if (kind == "Calendar") { return new Calendar(); }
        if (kind == "Card") { return new Card(); }
        if (kind == "Tag") { return new Tag(); }
        if (kind == "Badge") { return new Badge(); }
        if (kind == "Avatar") { return new Avatar(); }
        if (kind == "Statistic") { return new Statistic(); }
        if (kind == "Timeline") { return new Timeline(); }
        if (kind == "TreeView") { return new TreeView(); }
        if (kind == "Collapse") { return new Collapse(); }
        if (kind == "Empty") { return new Empty(); }
        if (kind == "Result") { return new Result(); }
        if (kind == "Skeleton") { return new Skeleton(); }
        if (kind == "Spin") { return new Spin(); }
        if (kind == "Steps") { return new Steps(); }
        if (kind == "Breadcrumb") { return new Breadcrumb(); }
        if (kind == "PageHeader") { return new PageHeader(); }
        if (kind == "ListView") { return new ListView<string>(); }
        if (kind == "Dropdown") { return new Dropdown<string>(); }
        if (kind == "Carousel") { return new Carousel(); }
        if (kind == "Led") { return new Led(); }
        if (kind == "Digital") { return new Digital(); }
        if (kind == "Gauge") { return new Gauge(); }
        if (kind == "Bargraph") { return new Bargraph(); }
        if (kind == "Trend") { return new Trend(); }
        if (kind == "NumPad") { return new NumPad(); }
        if (kind == "DeviceCard") { return new DeviceCard(); }
        if (kind == "EquipPanel") { return new EquipPanel(); }
        return null;
    }
}
