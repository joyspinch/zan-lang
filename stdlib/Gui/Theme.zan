using System;
using System.Json;

namespace Gui;

/// NaiveUI 主题 token。所有颜色打包为 0xAARRGGBB 存入 int。
class Theme {
    int primary;
    int primaryHover;
    int primaryPressed;
    int info;
    int infoHover;
    int infoPressed;
    int success;
    int successHover;
    int successPressed;
    int warning;
    int warningHover;
    int warningPressed;
    int error;
    int errorHover;
    int errorPressed;

    int textPrimary;
    int textSecondary;
    int textTertiary;
    int textDisabled;
    int textInverse;

    int bgPrimary;
    int bgSecondary;
    int bgTertiary;
    int bgHover;
    int bgActive;
    int bgDisabled;

    int borderPrimary;
    int borderSecondary;
    int borderHover;
    int borderFocus;
    int divider;
    int overlay;

    // 磨砂玻璃主题时为 1：面板模糊其背后的背景
    // （通过 Canvas.BlurRect），并以半透明色调填充。
    int glass;

    // 内容背景为垂直渐变（bgGradTop ->
    // bgGradBottom）而非纯色 bgPrimary 时为 1——现代 AI / Aurora / Glass
    // 壁纸。面板随后使用半透明表面，让背景透出。
    int gradient;
    int bgGradTop;
    int bgGradBottom;

    // 拟物化皮肤为 1：控件与页面同色，通过
    // 左上亮 + 右下暗的柔和阴影对实现凸起/内陷，
    // （见共享控件中的 Emboss 辅助函数），而非使用边框/填充。
    int neu;
    // 新粗野主义皮肤为 1：实心、偏移（无模糊）的投影、
    // 粗硬边框和锐利圆角（配合 radius 0 / 粗
    // borderWidth token 和不透明 shadowColor）。
    int brutal;

    // 该皮肤的动画背景效果（BackdropFx.Kind* 常量，0 = 无）。
    // App.RenderBackground 在节流的动画帧上把效果叠加到静态壁纸
    // 快照上，使皮肤带有标志性的动感。
    int fx;

    int scrollbar;
    int scrollbarHover;

    // 必须在任何皮肤/背景上保持可读的浮层表面：工具提示
    // 和弹出层在所有主题下都用不透明的深色石板色，媒体/照片层
    // 用近不透明的遮罩压暗页面，并在其上浮动白色半透明小圆片。
    int tooltipBg;
    int tooltipBorder;
    int tooltipText;
    int tooltipTextMuted;
    int scrim;          // 模态媒体层后面的全窗口压暗层
    int scrimChip;      // 悬浮在遮罩上的待机圆形控件
    int scrimChipHover; // 悬停变体
    int onScrim;        // 直接绘制在遮罩上的文本/图标
    int statusDebugBg;  // 调试会话进行中时状态栏的色调

    int borderRadiusSmall;
    int borderRadiusMedium;
    int borderRadiusLarge;
    int borderWidth;

    int fontSizeTiny;
    int fontSizeSmall;
    int fontSizeMedium;
    int fontSizeLarge;
    int fontSizeHuge;

    int heightTiny;
    int heightSmall;
    int heightMedium;
    int heightLarge;

    int paddingTiny;
    int paddingSmall;
    int paddingMedium;
    int paddingLarge;

    int gapSmall;
    int gapMedium;
    int gapLarge;

    // 面板 / 列表列的可读宽度区间：比例面板
    // 不会缩到小于第一个，也不会超过第二个，因此
    // 布局只需声明比例（见 Stack.SlotPane）。

    int iconSizeSmall;
    int iconSizeMedium;
    int iconSizeLarge;
    int iconSizeCaption;

    int shadowColor;

    int animFastMs;
    int animMediumMs;
    int animSlowMs;

