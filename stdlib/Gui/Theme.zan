        t.primaryHover   = -8394812;
        t.primaryPressed = -11742557;
        t.info           = -9387800;
        t.infoHover      = -7417362;
        t.infoPressed    = -11357984;
        t.success        = -10231113;
        t.successHover   = -8394812;
        t.successPressed = -11742557;
        t.warning        = -1007584;
        t.warningHover   = -217024;
        t.warningPressed = -3572720;
        t.error          = -1539968;
        t.errorHover     = -1271399;
