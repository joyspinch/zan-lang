        t.primary        = -15163304;
        t.primaryHover   = -13193878;
        t.primaryPressed = -15959485;
        t.info           = -14647056;
        t.infoHover      = -12543748;
        t.infoPressed    = -15703863;
        t.success        = -15163304;
        t.successHover   = -13193878;
        t.successPressed = -15959485;
        t.warning        = -1007584;
        t.warningHover   = -217024;
        t.warningPressed = -3572720;
        t.error          = -3133360;
        t.errorHover     = -2205843;
        t.errorPressed   = -5562561;

        t.textPrimary    = -14736859;
        t.textSecondary  = -13420999;
        t.textTertiary   = -9012094;
        t.textDisabled   = -4013374;
        t.textInverse    = -1;

        t.bgPrimary      = -1;
        t.bgSecondary    = -328964;
        t.bgTertiary     = -789515;
        t.bgHover        = -789515;
        t.bgActive       = -1184275;
        t.bgDisabled     = -328964;

        t.borderPrimary   = -2039578;
        t.borderSecondary = -1052683;
        t.borderHover     = -13193878;
        t.borderFocus     = -15163304;
        t.divider         = -1052683;
        t.overlay         = 1291845632;
        t.glass           = 0;
        t.gradient        = 0;
        t.bgGradTop       = 0;
        t.bgGradBottom    = 0;
        t.neu             = 0;
        t.brutal          = 0;
        t.fx              = 0;

        t.scrollbar       = -3618616;
        t.scrollbarHover  = -5592406;

        t.tooltipBg         = 0xFF1F2430;
        t.tooltipBorder     = 0xFF3A4150;
        t.tooltipText       = 0xFFF2F5FA;
        t.tooltipTextMuted  = 0xFFBFC7D5;
        t.scrim             = 0xE6000000;
        t.scrimChip         = 0x40FFFFFF;
        t.scrimChipHover    = 0x66FFFFFF;
        t.onScrim           = 0xFFFFFFFF;
        t.statusDebugBg     = 0xFFCC6633;

        t.borderRadiusSmall  = 3;
