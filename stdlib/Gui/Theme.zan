    static Theme Dark() {
        Theme t = new Theme();
        t.primary        = -10231113;
        t.primaryHover   = -8394812;
        t.primaryPressed = -11742557;
        t.info           = -9387800;
        t.infoHover      = -7417362;
        t.infoPressed    = -11357984;
        t.success        = -10231113;
        t.successHover   = -8394812;
        t.successPressed = -11742557;
        t.warning        = -1007584;
        t.warningHover   = -217024;
        t.warningPressed = -3572720;
        t.error          = -1539968;
        t.errorHover     = -1271399;
        t.errorPressed   = -2005145;

        t.textPrimary    = -1;
        t.textSecondary  = -6380632;
        t.textTertiary   = -9012094;
        t.textDisabled   = -11184811;
        t.textInverse    = -14736859;

        t.bgPrimary      = -15198180;
        t.bgSecondary    = -14671836;
        t.bgTertiary     = -13882318;
        t.bgHover        = -13487560;
        t.bgActive       = -13092802;
        t.bgDisabled     = -14671836;

        t.borderPrimary   = -12237491;
        t.borderSecondary = -13092802;
        t.borderHover     = -8394812;
        t.borderFocus     = -10231113;
        t.divider         = -13092802;
        t.overlay         = 1291845632;
        t.glass           = 0;
        t.gradient        = 0;
        t.bgGradTop       = 0;
        t.bgGradBottom    = 0;
        t.neu             = 0;
        t.brutal          = 0;
