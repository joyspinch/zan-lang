    // ---- 颜色打包辅助（int 为 64 位；按 0xAARRGGBB 存储）----

    /// 由 8 位 r/g/b 生成不透明颜色。
    static int Rgb(int r, int g, int b) {
        return 4278190080 + r * 65536 + g * 256 + b;
    }

    /// 由 8 位 r/g/b 与 8 位 alpha（0 透明 .. 255 不透明）生成颜色。
    static int Rgba(int r, int g, int b, int a) {
        return a * 16777216 + r * 65536 + g * 256 + b;
    }

    // ---- 数据驱动皮肤（CSS/JSON token 映射）----
    // 皮肤可以用 JSON 设计 token 样式表编写，而无需
    // 手写工厂，例如：
    //   { "base": "dark",
    //     "primary": "#63e2b7", "bgPrimary": "#101014",
    //     "borderRadiusMedium": 6, "glass": 1 }
    // 键是 Theme token 名称（接受前导 “--”，CSS 自定义
    // 属性风格）。颜色接受 “#RGB”/“#RRGGBB”/“#AARRGGBB”/“0x..”/int；
    // 其余都是 int。“base” 选择起始 Theme（“light”、
    // “dark” 或 PresetNames() 索引），token 随后覆盖。现有
    // 预设不受影响；这是加法式、向后兼容的路径。

    /// 颜色 token：解析 “#..”/“0x..”/十进制字符串，或直接接受原始 int。
    static int TokenColor(JsonValue v) {
        if (v == null) { return 0; }
        if (v.IsNumber()) { return v.AsInt(0); }
        return StyleSheet.ParseColor(v.AsString(""));
    }

    /// 按 Theme 字段名将一条 token 应用到 `t`（去掉前导 “--”）。
    static void SetToken(Theme t, string key, JsonValue v) {
        string k = key;
        if (k.Length >= 2 && k.Substring(0, 2) == "--") { k = k.Substring(2, k.Length - 2); }
        // 颜色
        if (k == "primary") { t.primary = Theme.TokenColor(v); }
        else if (k == "primaryHover") { t.primaryHover = Theme.TokenColor(v); }
        else if (k == "primaryPressed") { t.primaryPressed = Theme.TokenColor(v); }
        else if (k == "info") { t.info = Theme.TokenColor(v); }
        else if (k == "infoHover") { t.infoHover = Theme.TokenColor(v); }
        else if (k == "infoPressed") { t.infoPressed = Theme.TokenColor(v); }
        else if (k == "success") { t.success = Theme.TokenColor(v); }
        else if (k == "successHover") { t.successHover = Theme.TokenColor(v); }
        else if (k == "successPressed") { t.successPressed = Theme.TokenColor(v); }
        else if (k == "warning") { t.warning = Theme.TokenColor(v); }
        else if (k == "warningHover") { t.warningHover = Theme.TokenColor(v); }
        else if (k == "warningPressed") { t.warningPressed = Theme.TokenColor(v); }
        else if (k == "error") { t.error = Theme.TokenColor(v); }
        else if (k == "errorHover") { t.errorHover = Theme.TokenColor(v); }
        else if (k == "errorPressed") { t.errorPressed = Theme.TokenColor(v); }
        else if (k == "textPrimary") { t.textPrimary = Theme.TokenColor(v); }
        else if (k == "textSecondary") { t.textSecondary = Theme.TokenColor(v); }
        else if (k == "textTertiary") { t.textTertiary = Theme.TokenColor(v); }
        else if (k == "textDisabled") { t.textDisabled = Theme.TokenColor(v); }
        else if (k == "textInverse") { t.textInverse = Theme.TokenColor(v); }
        else if (k == "bgPrimary") { t.bgPrimary = Theme.TokenColor(v); }
        else if (k == "bgSecondary") { t.bgSecondary = Theme.TokenColor(v); }
        else if (k == "bgTertiary") { t.bgTertiary = Theme.TokenColor(v); }
        else if (k == "bgHover") { t.bgHover = Theme.TokenColor(v); }
        else if (k == "bgActive") { t.bgActive = Theme.TokenColor(v); }
        else if (k == "bgDisabled") { t.bgDisabled = Theme.TokenColor(v); }
        else if (k == "borderPrimary") { t.borderPrimary = Theme.TokenColor(v); }
        else if (k == "borderSecondary") { t.borderSecondary = Theme.TokenColor(v); }
        else if (k == "borderHover") { t.borderHover = Theme.TokenColor(v); }
        else if (k == "borderFocus") { t.borderFocus = Theme.TokenColor(v); }
        else if (k == "divider") { t.divider = Theme.TokenColor(v); }
        else if (k == "overlay") { t.overlay = Theme.TokenColor(v); }
        else if (k == "bgGradTop") { t.bgGradTop = Theme.TokenColor(v); }
        else if (k == "bgGradBottom") { t.bgGradBottom = Theme.TokenColor(v); }
        else if (k == "scrollbar") { t.scrollbar = Theme.TokenColor(v); }
        else if (k == "scrollbarHover") { t.scrollbarHover = Theme.TokenColor(v); }
        else if (k == "tooltipBg") { t.tooltipBg = Theme.TokenColor(v); }
        else if (k == "tooltipBorder") { t.tooltipBorder = Theme.TokenColor(v); }
        else if (k == "tooltipText") { t.tooltipText = Theme.TokenColor(v); }
        else if (k == "tooltipTextMuted") { t.tooltipTextMuted = Theme.TokenColor(v); }
        else if (k == "scrim") { t.scrim = Theme.TokenColor(v); }
        else if (k == "scrimChip") { t.scrimChip = Theme.TokenColor(v); }
        else if (k == "scrimChipHover") { t.scrimChipHover = Theme.TokenColor(v); }
        else if (k == "onScrim") { t.onScrim = Theme.TokenColor(v); }
        else if (k == "statusDebugBg") { t.statusDebugBg = Theme.TokenColor(v); }
        else if (k == "shadowColor") { t.shadowColor = Theme.TokenColor(v); }
        // 标志与度量（纯 int）
        else if (k == "glass") { t.glass = v.AsInt(0); }
        else if (k == "gradient") { t.gradient = v.AsInt(0); }
        else if (k == "neu") { t.neu = v.AsInt(0); }
        else if (k == "brutal") { t.brutal = v.AsInt(0); }
        else if (k == "fx") { t.fx = v.AsInt(0); }
        else if (k == "borderRadiusSmall") { t.borderRadiusSmall = v.AsInt(0); }
        else if (k == "borderRadiusMedium") { t.borderRadiusMedium = v.AsInt(0); }
        else if (k == "borderRadiusLarge") { t.borderRadiusLarge = v.AsInt(0); }
        else if (k == "borderWidth") { t.borderWidth = v.AsInt(0); }
        else if (k == "fontSizeTiny") { t.fontSizeTiny = v.AsInt(0); }
        else if (k == "fontSizeSmall") { t.fontSizeSmall = v.AsInt(0); }
        else if (k == "fontSizeMedium") { t.fontSizeMedium = v.AsInt(0); }
        else if (k == "fontSizeLarge") { t.fontSizeLarge = v.AsInt(0); }
        else if (k == "fontSizeHuge") { t.fontSizeHuge = v.AsInt(0); }
        else if (k == "heightTiny") { t.heightTiny = v.AsInt(0); }
        else if (k == "heightSmall") { t.heightSmall = v.AsInt(0); }
        else if (k == "heightMedium") { t.heightMedium = v.AsInt(0); }
        else if (k == "heightLarge") { t.heightLarge = v.AsInt(0); }
        else if (k == "paddingTiny") { t.paddingTiny = v.AsInt(0); }
        else if (k == "paddingSmall") { t.paddingSmall = v.AsInt(0); }
        else if (k == "paddingMedium") { t.paddingMedium = v.AsInt(0); }
        else if (k == "paddingLarge") { t.paddingLarge = v.AsInt(0); }
        else if (k == "gapSmall") { t.gapSmall = v.AsInt(0); }
        else if (k == "gapMedium") { t.gapMedium = v.AsInt(0); }
        else if (k == "gapLarge") { t.gapLarge = v.AsInt(0); }
        else if (k == "iconSizeSmall") { t.iconSizeSmall = v.AsInt(0); }
        else if (k == "iconSizeMedium") { t.iconSizeMedium = v.AsInt(0); }
        else if (k == "iconSizeLarge") { t.iconSizeLarge = v.AsInt(0); }
        else if (k == "iconSizeCaption") { t.iconSizeCaption = v.AsInt(0); }
        else if (k == "animFastMs") { t.animFastMs = v.AsInt(0); }
        else if (k == "animMediumMs") { t.animMediumMs = v.AsInt(0); }
        else if (k == "animSlowMs") { t.animSlowMs = v.AsInt(0); }
    }

    /// “base” token 命名的起始 Theme：“light” 或 “dark”（皮肤是
    /// CSS 打包的，因此皮肤绝不会基于另一皮肤的代码）。
    static Theme BaseTheme(JsonValue b) {
        if (b == null) { return Theme.Dark(); }
        string s = b.AsString("");
        if (s == "light" || s == "Light") { return Theme.Light(); }
        return Theme.Dark();
    }

    /// 将 JSON 对象中的每个 token 应用到 `t`（跳过 “base” 键）。
    static void ApplyTokens(Theme t, JsonValue obj) {
        if (obj == null || !obj.IsObject()) { return; }
        for (int i = 0; i < obj.Count(); i = i + 1) {
            string k = obj.KeyAt(i);
            if (k != "base") { Theme.SetToken(t, k, obj.ValAt(i)); }
        }
    }

    /// 从 JSON token 样式表构建 Theme：“base” token 选择
    /// 起始 Theme，其余覆盖单个 token。格式错误 / 空的
    /// 文档产生默认（Dark）主题，坏皮肤永远不会崩溃。
    static Theme FromTokens(string json) {
        JsonValue v = JsonValue.ParseLenient(json);
        if (v == null || !v.IsObject()) { return Theme.Dark(); }
        Theme t = Theme.BaseTheme(v.Get("base"));
        Theme.ApplyTokens(t, v);
        return t;
    }

    void ScaleByDpi(int dpiPercent) {
        if (dpiPercent <= 100) { return; }

        fontSizeTiny   = fontSizeTiny * dpiPercent / 100;
        fontSizeSmall  = fontSizeSmall * dpiPercent / 100;
        fontSizeMedium = fontSizeMedium * dpiPercent / 100;
        fontSizeLarge  = fontSizeLarge * dpiPercent / 100;
        fontSizeHuge   = fontSizeHuge * dpiPercent / 100;

        heightTiny  = heightTiny * dpiPercent / 100;
        heightSmall = heightSmall * dpiPercent / 100;
        heightMedium = heightMedium * dpiPercent / 100;
        heightLarge = heightLarge * dpiPercent / 100;

        paddingTiny  = paddingTiny * dpiPercent / 100;
        paddingSmall = paddingSmall * dpiPercent / 100;
        paddingMedium = paddingMedium * dpiPercent / 100;
        paddingLarge = paddingLarge * dpiPercent / 100;

        gapSmall  = gapSmall * dpiPercent / 100;
        gapMedium = gapMedium * dpiPercent / 100;
        gapLarge  = gapLarge * dpiPercent / 100;

        iconSizeSmall  = iconSizeSmall * dpiPercent / 100;
        iconSizeMedium = iconSizeMedium * dpiPercent / 100;
        iconSizeLarge  = iconSizeLarge * dpiPercent / 100;
        iconSizeCaption = iconSizeCaption * dpiPercent / 100;

        borderRadiusSmall  = borderRadiusSmall * dpiPercent / 100;
        borderRadiusMedium = borderRadiusMedium * dpiPercent / 100;
        borderRadiusLarge  = borderRadiusLarge * dpiPercent / 100;
        borderWidth        = borderWidth * dpiPercent / 100;
        if (borderWidth < 1) { borderWidth = 1; }
    }

    /// 把所有随缩放变化的度量（字号/高度/内边距/间距/图标/圆角/边框）
    /// 快照成一个列表，顺序与 ApplyMetricsScaled 一一对应。用于设计器
    /// 在渲染真实控件预览前保存基线，之后精确还原。
    List<int> SnapshotMetrics() {
        return new List<int>{
            fontSizeTiny, fontSizeSmall, fontSizeMedium, fontSizeLarge, fontSizeHuge,
            heightTiny, heightSmall, heightMedium, heightLarge,
            paddingTiny, paddingSmall, paddingMedium, paddingLarge,
            gapSmall, gapMedium, gapLarge,
            iconSizeSmall, iconSizeMedium, iconSizeLarge, iconSizeCaption,
            borderRadiusSmall, borderRadiusMedium, borderRadiusLarge, borderWidth };
    }

    /// 以 `bm`（SnapshotMetrics 的返回值）为基线，按 num/den 缩放所有
    /// 度量并写回。与 ScaleByDpi 不同，它支持缩小（num < den），且始终从
    /// 基线计算，所以用 num == den 调用即可精确还原、不累积舍入误差。
    void ApplyMetricsScaled(List<int> bm, int num, int den) {
        if (bm == null || bm.Count < 24 || den <= 0) { return; }
        fontSizeTiny   = bm[0] * num / den;
        fontSizeSmall  = bm[1] * num / den;
        fontSizeMedium = bm[2] * num / den;
        fontSizeLarge  = bm[3] * num / den;
        fontSizeHuge   = bm[4] * num / den;
        if (fontSizeTiny < 6) { fontSizeTiny = 6; }
        if (fontSizeSmall < 6) { fontSizeSmall = 6; }
        if (fontSizeMedium < 7) { fontSizeMedium = 7; }
        if (fontSizeLarge < 8) { fontSizeLarge = 8; }
        if (fontSizeHuge < 9) { fontSizeHuge = 9; }
        heightTiny  = bm[5] * num / den;
        heightSmall = bm[6] * num / den;
        heightMedium = bm[7] * num / den;
        heightLarge = bm[8] * num / den;
        paddingTiny  = bm[9] * num / den;
        paddingSmall = bm[10] * num / den;
        paddingMedium = bm[11] * num / den;
        paddingLarge = bm[12] * num / den;
        gapSmall  = bm[13] * num / den;
        gapMedium = bm[14] * num / den;
        gapLarge  = bm[15] * num / den;
        iconSizeSmall  = bm[16] * num / den;
        iconSizeMedium = bm[17] * num / den;
        iconSizeLarge  = bm[18] * num / den;
        iconSizeCaption = bm[19] * num / den;
        borderRadiusSmall  = bm[20] * num / den;
        borderRadiusMedium = bm[21] * num / den;
        borderRadiusLarge  = bm[22] * num / den;
        borderWidth        = bm[23] * num / den;
        if (borderWidth < 1) { borderWidth = 1; }
    }
}
