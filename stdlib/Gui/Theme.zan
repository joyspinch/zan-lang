        t.scrollbar       = -12237491;
        t.scrollbarHover  = -10197908;

        t.tooltipBg         = 0xFF1F2430;
        t.tooltipBorder     = 0xFF3A4150;
        t.tooltipText       = 0xFFF2F5FA;
        t.tooltipTextMuted  = 0xFFBFC7D5;
        t.scrim             = 0xE6000000;
        t.scrimChip         = 0x40FFFFFF;
        t.scrimChipHover    = 0x66FFFFFF;
        t.onScrim           = 0xFFFFFFFF;
        t.statusDebugBg     = 0xFFCC6633;

        t.borderRadiusSmall  = 3;
        t.borderRadiusMedium = 3;
        t.borderRadiusLarge  = 6;
        t.borderWidth        = 1;

        t.fontSizeTiny   = 12;
        t.fontSizeSmall  = 13;
        t.fontSizeMedium = 14;
        t.fontSizeLarge  = 16;
        t.fontSizeHuge   = 20;

        t.heightTiny  = 22;
        t.heightSmall = 28;
        t.heightMedium = 34;
        t.heightLarge = 40;

        t.paddingTiny  = 4;
        t.paddingSmall = 8;
        t.paddingMedium = 12;
        t.paddingLarge = 16;

        t.gapSmall  = 6;
        t.gapMedium = 8;
        t.gapLarge  = 12;

        t.iconSizeSmall  = 16;
        t.iconSizeMedium = 20;
        t.iconSizeLarge  = 24;
        t.iconSizeCaption = 11;

        t.shadowColor = 637534208;

        t.animFastMs   = 100;
