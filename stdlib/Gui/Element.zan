namespace Gui;

/// 通用元素容器（WEB_GUI_ROADMAP P0/P5）：kind 即 CSS type 选择器
/// 匹配的标签名（div/p/section/...）。HTML 声明层（P5）建树的容器
/// 节点直接落成 Element；代码里也可以用它写 web 风格的布局容器。
/// 纯文本内容（P1 匿名文本块）经 SetText 提供。
class Element : Control {
    string elTag;
    string elText;
    int elTextY;    // 文本块在内容框内的相对 Y（ArrangeFlow 落位）
    int elTextW;    // 文本块可用宽（内容框宽）

    void InitElement(string tag, string nodeName) {
        this.InitControl(nodeName, 0);
        elTag = tag;
    }

    /// 标签名（StyleType() 折小写后与 CSS type 选择器匹配）。
    override string Kind() { return elTag; }

    /// 元素的纯文本内容：块流布局（P1）把它当作匿名文本块参与排版。
    Element SetText(string t) {
        elText = t;
        return this;
    }

    /// 元素的纯文本内容。
    string Text() { return elText; }

    int ElFontSize() {
        StyleBox sb = computedStyle;
        if (sb == null) { return 14; }
        if (sb.fontPx > 0) { return sb.fontPx; }
        return sb.envRemPx > 0 ? sb.envRemPx : 14;
    }

    int ElRowHeight() {
        StyleBox sb = computedStyle;
        if (sb == null) { return Canvas.FontHeight(14); }
        int fs = this.ElFontSize();
        int lh = sb.LineHeightPx(fs);
        return lh > 0 ? lh : Canvas.FontHeight(fs);
    }

    /// 匿名文本块参与块流测量（Control.HasFlowText/FlowTextHeight）。
    override bool HasFlowText() { return elText != ""; }

    override int FlowTextHeight(int availW) {
        if (elText == "") { return 0; }
        int rowH = this.ElRowHeight();
        if (availW <= 0) { return rowH; }
        List<string> lines = TextWrap.Lines(elText, availW, this.ElFontSize());
        return lines.Count * rowH;
    }

    override void FlowTextPlace(int relY, int availW) {
        elTextY = relY;
        elTextW = availW;
    }

    /// 保留模式绘制：背景/边框由基类 PaintStyleBox 完成，这里画
    /// 匿名文本块的各行（text-align 对齐、行高行进、断行按落位宽）。
    override void OnPaint(App app) {
        if (elText == "" || elTextW <= 0) { return; }
        StyleBox sb = computedStyle;
        if (sb == null) { return; }
        int fs = this.ElFontSize();
        int rowH = this.ElRowHeight();
        int col = sb.Fade(sb.FgOr(app.theme.textPrimary));
        List<string> lines = TextWrap.Lines(elText, elTextW, fs);
        int y = by + elTextY;
        for (int i = 0; i < lines.Count; i = i + 1) {
            string ln = lines[i];
            int x = bx;
            if (sb.align == 1) {
                int tw = StyleBox.MeasureSpaced(ln, fs, sb.letterSpacing);
                x = bx + (elTextW - tw) / 2;
            } else if (sb.align == 2) {
                int tw = StyleBox.MeasureSpaced(ln, fs, sb.letterSpacing);
                x = bx + elTextW - tw;
            }
            sb.DrawRun(app.canvas, x, y, ln, col, fs);
            y = y + rowH;
        }
    }
}
