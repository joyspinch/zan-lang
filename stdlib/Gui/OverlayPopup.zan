using System;
using System.Threading;

namespace Gui;

/// <summary>
/// 框架拥有的浮动选项列表弹窗（由 Select / SelectBox /
/// Dropdown / Menu 使用）。Zan 委托无法捕获局部变量或绑定 `this`，因此
/// 弹窗以*数据*形式描述：控件在主渲染阶段将其交给 <c>App.AddOverlay</c>，
/// <c>App.RunOverlays</c> 在所有内容之后绘制并分发它，
/// 因此它始终绘制在最上层，并拥有最顶部的命中
/// 区域（HitTester 后注册者优先）。选择选项会写入
/// 绑定的模型、触发 <see cref="onChange"/> 并关闭弹窗；
/// 在其它任何位置按压都会关闭它（单一、集中式分发——没有逐控件事件
/// 抓取，应用代码中也没有 z-order 取巧）。
/// </summary>
class OverlayPopup {
    /// 富菜单上一帧悬停到的行（即时模式绘制，用它判断是否值得
    /// 为一次鼠标移动重绘）。
    static int lastRichHover;
    int x;
    int y;
    int w;
    List<string> options;
    int baseId;
    SignalInt model;
    int triggerId;
    SignalBool openFlag;
    SignalInt scrollModel;
    UiEvent onChange;
    bool showCheck;

    // 富上下文菜单模式（图标 / 分隔线 / 分组标题 / 子菜单）。
    bool rich;
    // 外观抽屉模式（框架外观/效果/强调色设置面板）。
    bool themeDrawerMode;
    List<MenuItem> menuItems;
    SignalInt result;
    SignalInt subOpen;

    // 富菜单滚动：弹窗每帧重建，偏移由宿主跨帧持有。richMaxRows
    // 限制主面板可见的可点击行数，长菜单出滚动条（滚轮 + 拖动）；
    // null / <=0 时面板保持整高不滚（与旧版一致）。richMinW 是
    // 面板宽度下限（Dropdown 让面板不窄于触发器），0 时不生效。
    SignalInt richScroll;
    int richMaxRows;
    int richMinW;

    // 自定义宿主模式：弹窗由 Control 的
    // OnPaintOverlay 绘制并分发（参见 Host），适用于需要定制
    // 面板而非内置选项列表/菜单/抽屉类型的浮动控件。
    Control host;

    /// 富上下文菜单：包含 `items`（参见 MenuItem）的浮动面板，
    /// 支持图标、分隔线、分组标题和一层悬停展开的
    /// 子菜单。选中的叶子 `action` 写入 `result`；
    /// 选择、外部按压或 Escape 都会关闭面板。`baseId` 必须是稳定的
    /// 至少 256 个 id 的连续块（WidgetId.Block(256)）。
    static OverlayPopup RichMenu(int x, int y, List<MenuItem> items, int baseId,
                                 SignalInt result, SignalBool openFlag,
                                 SignalInt subOpen) {
        return OverlayPopup.RichMenu(x, y, items, baseId, result, openFlag,
            subOpen, null, 0, 0);
    }

    /// 滚动/宽度扩展版富菜单：`scroll` + `maxRows` 让长菜单只显示
    /// maxRows 行并出滚动条（偏移由宿主跨帧持有）；`minW` 给面板
    /// 宽度下限。其余同上。
    static OverlayPopup RichMenu(int x, int y, List<MenuItem> items, int baseId,
                                 SignalInt result, SignalBool openFlag,
                                 SignalInt subOpen, SignalInt scroll,
                                 int maxRows, int minW) {
        OverlayPopup p = new OverlayPopup();
        p.rich = true;
        p.x = x;
        p.y = y;
        p.w = 0;
        p.options = new List<string>();
        p.menuItems = items;
        p.baseId = baseId;
        p.result = result;
        p.openFlag = openFlag;
        p.subOpen = subOpen;
        p.triggerId = 0 - 1;
        p.showCheck = false;
        p.richScroll = scroll;
        p.richMaxRows = maxRows;
        p.richMinW = minW;
        return p;
    }

    /// 外观抽屉：右侧停靠的设置面板，包含外观
    /// 列表、一键动画开/关开关、背景特效选择器和
    /// 强调色色板。`baseId` 必须是至少
    /// PresetCount + 24 个 id 的稳定块；状态存放在 App 上（themeMenuModel、
    /// fxKindOverride、accentOverride、fxEnabled）。
    static OverlayPopup ThemeDrawer(int baseId, int triggerId,
                                    SignalBool openFlag, SignalInt scrollModel) {
        OverlayPopup p = new OverlayPopup();
        p.themeDrawerMode = true;
        p.x = 0;
        p.y = 0;
        p.w = 0;
        p.options = new List<string>();
        p.baseId = baseId;
        p.triggerId = triggerId;
        p.openFlag = openFlag;
        p.scrollModel = scrollModel;
        p.showCheck = false;
        return p;
    }

    /// 完全自定义的浮动层：`h` 通过 OnPaintOverlay 重写绘制自己的弹窗（chrome、选项
    /// 及输入分发）。让任何浮动控件
    /// （Select 框、Popover、Tooltip 等）将整个弹窗交给
    /// 覆盖层阶段处理——绘制在所有内容之上，命中区域最后注册——
    /// 而无需专门的 OverlayPopup 类型。控件在主阶段将
    /// 锚点几何存入自己的字段，并在打开时
    /// 调用 `app.AddOverlay(OverlayPopup.Host(this))`。
    static OverlayPopup Host(Control h) {
        OverlayPopup p = new OverlayPopup();
        p.host = h;
        p.options = new List<string>();
        p.triggerId = 0 - 1;
        return p;
    }

    /// 将锚定在 `x`、宽度为 `w` 的弹窗保持在窗口内。
    static int FitX(App app, int x, int w) {
        int margin = app.Scale(4);
        int right = app.canvas.Width() - margin - w;
        int px = x;
        if (px > right) { px = right; }
        if (px < margin) { px = margin; }
        return px;
    }

    /// 将弹窗高度限制在窗口可显示范围内。
    static int FitH(App app, int h) {
        int margin = app.Scale(4);
        int avail = app.canvas.Height() - margin * 2;
        if (avail < 1) { avail = 1; }
        if (h > avail) { h = avail; }
        return h;
    }

    /// 触发控件下方弹窗的垂直定位：`anchorY` 是
    /// 首选顶部（触发控件底部加间距），`trigH` 是触发控件
    /// 高度。会超出底部的弹窗翻转到触发控件上方，
    /// 只有那里也放不下时才会被限制在窗口内
    /// ——因此靠近底部边缘的下拉框会向上展开，而不是被
    /// 窗口截断。
    static int FitY(App app, int anchorY, int trigH, int h) {
        int margin = app.Scale(4);
        int gap = app.Scale(4);
        int bottom = app.canvas.Height() - margin;
        int y = anchorY;
        if (y + h > bottom) {
            int above = anchorY - trigH - gap * 2 - h;
            if (above >= margin) { y = above; }
            else { y = bottom - h; }
        }
        if (y < margin) { y = margin; }
        return y;
    }

    /// 带选中对勾的选项列表弹窗：点击选项写入 `model`、触发
    /// `onChange` 并关闭；在弹窗和触发控件之外按压或 Escape 也关闭。
    /// 第 i 个选项的命中 id 为 `baseId + i`，滚动偏移存于 `scrollModel`。
    static OverlayPopup OptionList(int x, int y, int w, List<string> options,
                                   int baseId, SignalInt model, int triggerId,
                                   SignalBool openFlag, SignalInt scrollModel,
                                   UiEvent onChange) {
        OverlayPopup p = new OverlayPopup();
        p.x = x;
        p.y = y;
        p.w = w;
        p.options = options;
        p.baseId = baseId;
        p.model = model;
        p.triggerId = triggerId;
        p.openFlag = openFlag;
        p.scrollModel = scrollModel;
        p.onChange = onChange;
        p.showCheck = true;
        return p;
    }

    /// 操作菜单（如 Dropdown）：与 OptionList 相同的锚定、遮罩、外部点击关闭
    /// 弹窗，但没有常驻的选中对勾。
    /// 选中的索引写入 `model` 并触发 `onChange`。
    static OverlayPopup Menu(int x, int y, int w, List<string> options,
                             int baseId, SignalInt model, int triggerId,
                             SignalBool openFlag, SignalInt scrollModel,
                             UiEvent onChange) {
        OverlayPopup p = OverlayPopup.OptionList(x, y, w, options, baseId, model,
            triggerId, openFlag, scrollModel, onChange);
        p.showCheck = false;
        return p;
    }

    /// 绘制并分发弹窗（由 App.RunOverlays 在覆盖层阶段调用）：
    /// 按构造模式分流——宿主控件的 OnPaintOverlay、富菜单、
    /// 外观抽屉，或内置选项列表（样式取 `popup` / `popup.option`
    /// 规则），并集中处理选择、外部按压关闭与 Escape。
    void Render(App app) {
        if (host != null) {
            host.OnPaintOverlay(app);
            return;
        }
        if (rich) {
            this.RenderRich(app);
            return;
        }
        if (themeDrawerMode) {
            this.RenderThemeDrawer(app);
            return;
        }
        Canvas c = app.canvas;
        Theme t = app.theme;
        int count = options.Count;
        int optH = t.heightMedium;
        int totalH = count * optH;
        int margin = app.Scale(4);
        int popupW = w;
        int maxW = c.Width() - margin * 2;
        if (maxW < 1) { maxW = 1; }
        if (popupW < app.Scale(48)) { popupW = app.Scale(48); }
        if (popupW > maxW) { popupW = maxW; }
        int popupX = OverlayPopup.FitX(app, x, popupW);

        int maxViewH = OverlayPopup.FitH(app, optH * 8);
        int viewH = totalH;
        if (viewH > maxViewH) { viewH = maxViewH; }
        int popupY = OverlayPopup.FitY(app, y, t.heightMedium, viewH);

        int maxScroll = totalH - viewH;
        if (maxScroll < 0) { maxScroll = 0; }
        int scrollY = scrollModel.Get();
        int selectedIdx = model.Get();
        if (scrollY == 0 && selectedIdx * optH >= viewH) {
            scrollY = selectedIdx * optH - viewH + optH;
        }
        if (scrollY < 0) { scrollY = 0; }
        if (scrollY > maxScroll) { scrollY = maxScroll; }

        bool pointerInside = app.mouseX >= popupX && app.mouseX < popupX + popupW
            && app.mouseY >= popupY && app.mouseY < popupY + viewH;
        bool ownsWheel = app.CaptureWheel(popupX, popupY, popupW, viewH);
        if (ownsWheel && maxScroll > 0) {
            int oldScroll = scrollY;
            scrollY = scrollY - app.window.EventKeyCode() * optH / 120;
            if (scrollY < 0) { scrollY = 0; }
            if (scrollY > maxScroll) { scrollY = maxScroll; }
            if (scrollY != oldScroll) {
                scrollModel.Set(scrollY);
                app.RequestRedraw();
            }
        }
        StyleBox popupStyle = Style.Full(app, "popup", "", "", Style.SNormal());
        StyleBox optionStyle = Style.Part(app, "popup", "option", "", "", "",
                                          Style.SNormal());
        StyleBox optionHover = Style.Part(app, "popup", "option", "", "", "",
                                          Style.SHover());
        StyleBox optionSelected = Style.Part(app, "popup", "option", "", "", "",
                                             Style.SSelected());
        StyleBox scrollbarStyle = Style.Part(app, "popup", "scrollbar", "",
                                             "", "", Style.SNormal());
        int popupRadius = popupStyle.RadiusOr(t.borderRadiusMedium);
        int popupShadow = popupStyle.shadow;
        int popupBg = popupStyle.BgOr(0);
        int popupBorder = popupStyle.BorderOr(0);
        int popupBorderW = popupStyle.BorderWOr(1);
        int optionHoverBg = optionHover.BgOr(0);
        int optionText = optionStyle.FgOr(0);
        int optionSelectedText = optionSelected.FgOr(optionText);
        int scrollbarBg = scrollbarStyle.BgOr(0);
        // 阴影 + 主体。
        app.BlockHitsBelow();
        c.FillRoundRect(popupX + 1, popupY + 2, popupW, viewH, popupRadius, popupShadow);
        c.FillRoundRect(popupX, popupY, popupW, viewH, popupRadius, popupBg);
        c.DrawRoundRect(popupX, popupY, popupW, viewH, popupRadius,
                        popupBorder, popupBorderW);
        app.BlockHitsRect(popupX, popupY, popupW, viewH);

        c.PushClip(popupX, popupY, popupW, viewH);
        for (int i = 0; i < count; i = i + 1) {
            int optId = baseId + i;
            int optY = popupY + i * optH - scrollY;
            if (optY + optH > popupY && optY < popupY + viewH) {
                bool hovered = app.focus.IsHovered(optId);
                bool selected = showCheck && i == selectedIdx;
                if (hovered) {
                    c.FillRect(popupX + 1, optY, popupW - 2, optH, optionHoverBg);
                }
                int textColor = optionText;
                if (selected) { textColor = optionSelectedText; }
                int optMaxW = popupW - t.paddingSmall - t.paddingLarge - t.iconSizeSmall - t.paddingSmall;
                int optFs = Style.FontFallback(app, "medium");
                c.DrawText(popupX + t.paddingSmall, Canvas.CenterTextY(optY, optH, optFs),
                           Ellipsis.Fit(options[i], optMaxW, optFs), textColor, optFs);
                if (selected) {
                    c.DrawGlyphIn("check", popupX + popupW - t.paddingLarge - t.iconSizeSmall,
                                        optY, t.iconSizeSmall, optH,
                                        t.iconSizeSmall, optionSelectedText);
                }
                app.hitTester.RegisterRect(optId, popupX, optY, popupW, optH, 0);
            }
        }
        c.PopClip();
        if (maxScroll > 0 && viewH > 0) {
            int barW = app.Scale(5);
            int thumbH = viewH * viewH / totalH;
            int minThumb = app.Scale(18);
            if (thumbH < minThumb) { thumbH = minThumb; }
            if (thumbH > viewH) { thumbH = viewH; }
            int travel = viewH - thumbH;
            int thumbY = popupY;
            if (maxScroll > 0) { thumbY = popupY + scrollY * travel / maxScroll; }
            c.FillRoundRect(popupX + popupW - barW - app.Scale(2), thumbY,
                            barW, thumbH, barW / 2, scrollbarBg);
        }

        // 集中分发：点击落在选项上（按上一帧区域解析，
        // 上一帧区域已把弹窗置顶）则选择；
        // 在弹窗和触发控件之外任意位置按压则关闭。
        int kind = app.EventKind();
        if (kind == 3) {
            int hit = app.ClickTarget();
            if (hit >= baseId && hit < baseId + count) {
                int idx = hit - baseId;
                // 操作菜单（无对勾）每次选择都会触发，包括
                // 再次选择当前索引；选择列表仅在变更时触发。
                if (!showCheck || idx != model.Get()) {
                    model.Set(idx);
                    onChange.Raise();
                }
                openFlag.Set(false);
                app.RequestRedraw();
            }
        }
        if (kind == 2) {
            int pt = app.PressTarget();
            bool insideOption = pt >= baseId && pt < baseId + count;
            if (pt != triggerId && !insideOption) {
                openFlag.Set(false);
                app.RequestRedraw();
            }
        }
        if (kind == 4 && app.window.EventKeyCode() == 27) {
            openFlag.Set(false);
            app.RequestRedraw();
        }
    }

    /// 绘制外观抽屉（参见 ThemeDrawer）并分发其
    /// 点击。所有状态均从 App 读写，使抽屉本身
    /// 在帧间保持无状态。
    void RenderThemeDrawer(App app) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int count = app.themeNames.Count;
        int dw = app.Scale(312);
        int top = app.ContentTop();
        int dx = c.Width() - dw;
        int dh = c.Height() - top;
        int pad = t.paddingLarge;
        int rowH = t.heightMedium;
        int fs = Style.FontFallback(app, "medium");
        int tab = app.themeDrawerTab.Get();
        int headerH = app.Scale(46);
        int tabsH = app.Scale(40);
        int idClose = baseId + count + 17;
        int idTab0 = baseId + count + 18;
        StyleBox drawerStyle = Style.Full(app, "themedrawer", "", "",
                                          Style.SNormal());
        StyleBox edgeStyle = Style.Part(app, "themedrawer", "edge", "", "", "",
                                        Style.SNormal());
        StyleBox titleStyle = Style.Part(app, "themedrawer", "title", "", "", "",
                                         Style.SNormal());
        StyleBox closeStyle = Style.Part(app, "themedrawer", "close", "", "", "",
                                         Style.SNormal());
        StyleBox closeHover = Style.Part(app, "themedrawer", "close", "", "", "",
                                         Style.SHover());
        StyleBox segStyle = Style.Part(app, "themedrawer", "seg", "", "", "",
                                       Style.SNormal());
        StyleBox segItemStyle = Style.Part(app, "themedrawer", "seg-item", "",
                                           "", "", Style.SNormal());
        StyleBox segItemHover = Style.Part(app, "themedrawer", "seg-item", "",
                                           "", "", Style.SHover());
        StyleBox segItemSelected = Style.Part(app, "themedrawer", "seg-item", "",
                                              "", "", Style.SSelected());
        int drawerBg = drawerStyle.BgOr(0);
        int drawerBorder = drawerStyle.borderLeftColor;
        if (drawerBorder == 0) { drawerBorder = drawerStyle.BorderOr(0); }
        int drawerBorderW = drawerStyle.borderLeftW;
        if (drawerBorderW < 0) { drawerBorderW = drawerStyle.BorderWOr(1); }
        int edgeBg = edgeStyle.BgOr(0);
        int titleFg = titleStyle.FgOr(0);
        int closeBg = closeStyle.BgOr(0);
        int closeFg = closeStyle.FgOr(0);
        int closeHoverBg = closeHover.BgOr(closeBg);
        int closeHoverFg = closeHover.FgOr(closeFg);
        int segBg = segStyle.BgOr(0);
        int segItemFg = segItemStyle.FgOr(0);
        int segItemHoverBg = segItemHover.BgOr(0);
        int segItemSelectedBg = segItemSelected.BgOr(0);
        int segItemSelectedBorder = segItemSelected.BorderOr(0);
        int segItemSelectedFg = segItemSelected.FgOr(segItemFg);
        int contentH = this.DrawerContentH(app, tab);
        int viewY = top + headerH + tabsH;
        int viewH = dh - headerH - tabsH;
        int maxScroll = contentH - viewH;
        if (maxScroll < 0) { maxScroll = 0; }
        int scrollY = scrollModel.Get();
        if (scrollY < 0) { scrollY = 0; }
        if (scrollY > maxScroll) { scrollY = maxScroll; }
        bool ownsWheel = app.CaptureWheel(dx, viewY, dw, viewH);
        if (ownsWheel && maxScroll > 0) {
            int oldScroll = scrollY;
            scrollY = scrollY - app.window.EventKeyCode() * rowH / 120;
            if (scrollY < 0) { scrollY = 0; }
            if (scrollY > maxScroll) { scrollY = maxScroll; }
            if (scrollY != oldScroll) {
                scrollModel.Set(scrollY);
                app.RequestRedraw();
            }
        }

        app.BlockHitsBelow();
        c.FillRect(dx - app.Scale(6), top, app.Scale(6), dh,
                   edgeBg);
        if (t.glass != 0) {
            app.FillGlass(dx, top, dw, dh, 0, drawerBg, 1000);
        } else {
            c.FillRect(dx, top, dw, dh, drawerBg);
        }
        c.FillRect(dx, top, drawerBorderW, dh, drawerBorder);
        app.BlockHitsRect(dx, top, dw, dh);

        // ---- 头部：标题 + 圆形关闭按钮 ----
        int titleY = Canvas.CenterTextY(top, headerH, Style.FontFallback(app, "large"));
        c.DrawText(dx + pad, titleY, "主题", titleFg, Style.FontFallback(app, "large"));
        int cbtn = app.Scale(26);
        int cbx = dx + dw - pad - cbtn;
        int cby = top + (headerH - cbtn) / 2;
        bool closeHov = app.focus.IsHovered(idClose);
        int closeColor = closeBg;
        if (closeHov) { closeColor = closeHoverBg; }
        c.FillCircle(cbx + cbtn / 2, cby + cbtn / 2, cbtn / 2, closeColor);
        int closeGlyph = closeFg;
        if (closeHov) { closeGlyph = closeHoverFg; }
        c.DrawGlyphIn("close", cbx, cby, cbtn, cbtn,
                            t.iconSizeSmall, closeGlyph);
        app.hitTester.RegisterRect(idClose, cbx, cby, cbtn, cbtn, 0);

        // ---- 分段选项卡 ----
        int segX = dx + pad;
        int segW = dw - pad * 2;
        int segY = top + headerH;
        int segH = tabsH - app.Scale(10);
        c.FillRoundRect(segX, segY, segW, segH, segH / 2, segBg);
        int tabW = segW / 2;
        for (int ti = 0; ti < 2; ti = ti + 1) {
            int tx = segX + ti * tabW;
            string lbl = "样式";
            if (ti == 1) { lbl = "动效"; }
            bool active = tab == ti;
            bool hov = app.focus.IsHovered(idTab0 + ti);
            if (active) {
                c.FillRoundRect(tx + app.Scale(3), segY + app.Scale(3),
                                tabW - app.Scale(6), segH - app.Scale(6),
                                (segH - app.Scale(6)) / 2, segItemSelectedBg);
                c.DrawRoundRect(tx + app.Scale(3), segY + app.Scale(3),
                                tabW - app.Scale(6), segH - app.Scale(6),
                                (segH - app.Scale(6)) / 2, segItemSelectedBorder, 1);
            } else if (hov) {
                c.FillRoundRect(tx + app.Scale(3), segY + app.Scale(3),
                                tabW - app.Scale(6), segH - app.Scale(6),
                                (segH - app.Scale(6)) / 2, segItemHoverBg);
            }
            int lc = segItemFg;
            if (active) { lc = segItemSelectedFg; }
            int lw = Canvas.MeasureText(lbl, fs);
            c.DrawText(tx + (tabW - lw) / 2,
                       Canvas.CenterTextY(segY, segH, fs), lbl, lc, fs);
            app.hitTester.RegisterRect(idTab0 + ti, tx, segY, tabW, segH, 0);
        }

        c.PushClip(dx, viewY, dw, viewH);
        int yy = viewY + pad - scrollY;
        if (tab == 0) {
            yy = this.DrawSkinGrid(app, yy);
            yy = this.DrawAccentRow(app, yy);
            yy = this.DrawDensityRow(app, yy);
            yy = this.DrawOpacityChips(app, yy);
            this.DrawWallpaperSection(app, yy);
        } else {
            this.DrawMotionTab(app, yy);
        }
        c.PopClip();
        this.HandleDrawerInput(app);
    }

    /// 强调色色板的候选色（0 = 跟随外观默认值）。
    static List<int> DrawerAccents() {
        List<int> accents = new List<int>{
            0, // 外观默认值
            Theme.Rgb(59, 130, 246), // 蓝色
            Theme.Rgb(139, 92, 246), // 紫色
            Theme.Rgb(236, 72, 153), // 粉色
            Theme.Rgb(16, 185, 129), // 绿色
            Theme.Rgb(245, 158, 11), // 琥珀色
            Theme.Rgb(239, 68, 68) }; // 红色
        return accents;
    }

    /// 整窗/壁纸不透明度的候选档位（百分比）。
    static List<int> DrawerOpLevels() {
        List<int> opLevels = new List<int>{
            100, 90, 80,
            70, 60, 50 };
        return opLevels;
    }

    /// 动效标签页的背景特效选项名（第 0 项 “跟随皮肤” 映射 -1，
    /// 其余按序为 BackdropFx 种类）。
    static List<string> DrawerKinds() {
        List<string> kinds = new List<string>{
            "跟随皮肤",
            "星空",
            "极光",
            "流星",
            "水墨",
            "花瓣",
            "数字雨",
            "光斑",
            "网格" };
        return kinds;
    }

    /// 当前抽屉标签页的可滚动内容总高度。
    int DrawerContentH(App app, int tab) {
        Theme t = app.theme;
        int count = app.themeNames.Count;
        int pad = t.paddingLarge;
        int rowH = t.heightMedium;
        int cols = 3;
        int cardH = app.Scale(58);
        int rows = (count + cols - 1) / cols;
        int swatch = app.Scale(26);
        if (tab == 0) {
            return pad + rowH
                + rows * (cardH + pad)
                + rowH
                + swatch + pad
                + rowH
                + swatch + pad
                + rowH
                + swatch + pad
                + rowH
                + rowH + pad
                + swatch + pad;
        }
        return pad + rowH * 2
            + rowH
            + DrawerKinds().Count * rowH + pad;
    }

    /// 密度档选项行（标签 + 大中小三枚 chip），复用透明度选项的
    /// chip 样式。返回下一节的 y。
    int DrawDensityRow(App app, int yy) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int count = app.themeNames.Count;
        int dw = app.Scale(312);
        int dx = c.Width() - dw;
        int pad = t.paddingLarge;
        int swatch = app.Scale(26);
        int idDen0 = baseId + count + 32;
        List<string> labels = new List<string>{
            "小", "中", "大" };
        StyleBox chipStyle = Style.Part(app, "themedrawer", "chip", "", "", "",
                                        Style.SNormal());
        StyleBox chipHover = Style.Part(app, "themedrawer", "chip", "", "", "",
                                        Style.SHover());
        StyleBox chipSelected = Style.Part(app, "themedrawer", "chip", "",
                                           "", "", Style.SSelected());
        yy = this.DrawerSection(app, dx, yy, dw, "密度");
        int chipGap = app.Scale(6);
        int chipW = (dw - pad * 2 - chipGap * (labels.Count - 1)) / labels.Count;
        int chipH = swatch;
        for (int i = 0; i < labels.Count; i = i + 1) {
            int optId = idDen0 + i;
            int sx = dx + pad + i * (chipW + chipGap);
            bool hov = app.focus.IsHovered(optId);
            bool sel = app.Density() == i;
            int chipBg = chipStyle.BgOr(0);
            if (hov) { chipBg = chipHover.BgOr(chipBg); }
            if (sel) { chipBg = chipSelected.BgOr(chipBg); }
            c.FillRoundRect(sx, yy, chipW, chipH, t.borderRadiusSmall, chipBg);
            int bd = chipStyle.BorderOr(0);
            if (sel) { bd = chipSelected.BorderOr(bd); }
            else if (hov) { bd = chipHover.BorderOr(bd); }
            c.DrawRoundRect(sx, yy, chipW, chipH, t.borderRadiusSmall, bd, 1);
            int tc = chipStyle.FgOr(0);
            if (sel) { tc = chipSelected.FgOr(tc); }
            int lw = Canvas.MeasureText(labels[i],
                                        Style.FontFallback(app, "small"));
            c.DrawText(sx + (chipW - lw) / 2,
                       Canvas.CenterTextY(yy, chipH,
                                          Style.FontFallback(app, "small")),
                       labels[i], tc, Style.FontFallback(app, "small"));
            app.hitTester.RegisterRect(optId, sx, yy, chipW, chipH, 0);
        }
        return yy + chipH + pad;
    }

    /// 外观预设网格（实时预览卡片）。
    int DrawSkinGrid(App app, int yy) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int count = app.themeNames.Count;
        int dw = app.Scale(312);
        int dx = c.Width() - dw;
        int pad = t.paddingLarge;
        int cols = 3;
        int cardW = (dw - pad * (cols + 1)) / cols;
        int cardH = app.Scale(58);
        int rows = (count + cols - 1) / cols;
        StyleBox cardStyle = Style.Part(app, "themedrawer", "card", "", "", "",
                                         Style.SNormal());
        StyleBox cardHover = Style.Part(app, "themedrawer", "card", "", "", "",
                                         Style.SHover());
        StyleBox cardSelected = Style.Part(app, "themedrawer", "card", "", "",
                                           "", Style.SSelected());
        int cardBorder = cardStyle.BorderOr(0);
        int cardHoverBorder = cardHover.BorderOr(cardBorder);
        int cardSelectedBorder = cardSelected.BorderOr(cardBorder);
        int cardBorderW = cardStyle.BorderWOr(1);
        int cardHoverBorderW = cardHover.BorderWOr(cardBorderW);
        int cardSelectedBorderW = cardSelected.BorderWOr(2);
        yy = this.DrawerSection(app, dx, yy, dw, "皮肤");
        // 带实时颜色预览的预设卡片网格。
        int i = 0;
        for (; i < count; i = i + 1) {
            int col = i % cols;
            int row = i / cols;
            int cx = dx + pad + col * (cardW + pad);
            int cy = yy + row * (cardH + pad);
            Theme pt = app.SkinThemeAt(i);
            int optId = baseId + i;
            bool hovered = app.focus.IsHovered(optId);
            bool selected = i == app.themeMenuModel.Get();
            c.FillRoundRect(cx, cy, cardW, cardH, t.borderRadiusMedium,
                            pt.bgPrimary);
            // 迷你预览：侧边栏 + 一行内容 + 强调色圆点
            int labelH = Canvas.FontHeight(Style.FontFallback(app, "small"));
            int previewH = cardH - labelH - app.Scale(10);
            c.FillRoundRect(cx + app.Scale(5), cy + app.Scale(5),
                            app.Scale(9), previewH - app.Scale(4),
                            app.Scale(2), pt.bgSecondary);
            c.FillRoundRect(cx + app.Scale(18), cy + app.Scale(7),
                            cardW - app.Scale(34), app.Scale(5),
                            app.Scale(2), pt.bgActive);
            c.FillCircle(cx + cardW - app.Scale(10), cy + app.Scale(10),
                         app.Scale(4), pt.primary);
            int labelMaxW = cardW - app.Scale(9);
            c.PushClip(cx + app.Scale(4), cy + previewH,
                       cardW - app.Scale(8), labelH + app.Scale(4));
            c.DrawText(cx + app.Scale(5), cy + previewH,
                       Ellipsis.Fit(app.themeNames[i], labelMaxW,
                                    Style.FontFallback(app, "small")),
                       pt.textPrimary, Style.FontFallback(app, "small"));
            c.PopClip();
            if (selected) {
                c.DrawRoundRect(cx, cy, cardW, cardH, t.borderRadiusMedium,
                                cardSelectedBorder, cardSelectedBorderW);
            } else if (hovered) {
                c.DrawRoundRect(cx, cy, cardW, cardH, t.borderRadiusMedium,
                                cardHoverBorder, cardHoverBorderW);
            } else {
                c.DrawRoundRect(cx, cy, cardW, cardH, t.borderRadiusMedium,
                                cardBorder, cardBorderW);
            }
        }
        yy = yy + rows * (cardH + pad);
        // 注册网格命中区域（绘制后进行，保证 id 保持绘制顺序）
        i = 0;
        while (i < count) {
            int col = i % cols;
            int row = i / cols;
            int cx = dx + pad + col * (cardW + pad);
            int cy = yy - rows * (cardH + pad) + row * (cardH + pad);
            app.hitTester.RegisterRect(baseId + i, cx, cy, cardW, cardH, 0);
            i = i + 1;
        }
        return yy;
    }

    /// 强调色色板行。
    int DrawAccentRow(App app, int yy) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int count = app.themeNames.Count;
        int dw = app.Scale(312);
        int dx = c.Width() - dw;
        int pad = t.paddingLarge;
        int swatch = app.Scale(26);
        int swGap = app.Scale(8);
        int idAcc0 = baseId + count + 10;
        List<int> accents = OverlayPopup.DrawerAccents();
        StyleBox swatchStyle = Style.Part(app, "themedrawer", "swatch", "",
                                           "", "", Style.SNormal());
        StyleBox swatchHover = Style.Part(app, "themedrawer", "swatch", "",
                                           "", "", Style.SHover());
        StyleBox swatchSelected = Style.Part(app, "themedrawer", "swatch", "",
                                              "", "", Style.SSelected());
        StyleBox swatchDefault = Style.Part(app, "themedrawer", "swatch",
                                             "", "default", "", Style.SNormal());
        StyleBox swatchCheck = Style.Part(app, "themedrawer", "swatch-check",
                                          "", "", "", Style.SNormal());
        int swatchBorder = swatchStyle.BorderOr(0);
        int swatchHoverBorder = swatchHover.BorderOr(swatchBorder);
        int swatchSelectedBorder = swatchSelected.BorderOr(swatchBorder);
        int swatchDefaultBg = swatchDefault.BgOr(0);
        int swatchBorderW = swatchStyle.BorderWOr(1);
        int swatchSelectedBorderW = swatchSelected.BorderWOr(2);
        int swatchCheckFg = swatchCheck.FgOr(0);
        yy = this.DrawerSection(app, dx, yy, dw, "强调色");
        for (int i = 0; i < accents.Count; i = i + 1) {
            int optId = idAcc0 + i;
            int sx = dx + pad + i * (swatch + swGap);
            int colr = accents[i];
            if (colr == 0) { colr = swatchDefaultBg; }
            bool hovered = app.focus.IsHovered(optId);
            bool selected = app.accentOverride == accents[i];
            if (hovered && !selected) {
                c.DrawCircle(sx + swatch / 2, yy + swatch / 2,
                             swatch / 2 + app.Scale(2), swatchHoverBorder, 1);
            }
            c.FillCircle(sx + swatch / 2, yy + swatch / 2, swatch / 2, colr);
            if (accents[i] == 0) {
                c.DrawCircle(sx + swatch / 2, yy + swatch / 2, swatch / 2,
                             swatchBorder, swatchBorderW);
            }
            if (selected) {
                c.DrawCircle(sx + swatch / 2, yy + swatch / 2,
                             swatch / 2 + app.Scale(2), swatchSelectedBorder,
                             swatchSelectedBorderW);
                c.DrawGlyphIn("check", sx, yy, swatch, swatch,
                                    t.iconSizeSmall, swatchCheckFg);
            }
            app.hitTester.RegisterRect(optId, sx, yy, swatch, swatch, 0);
        }
        yy = yy + swatch + pad;
        return yy;
    }

    /// 整窗不透明度选项。
    int DrawOpacityChips(App app, int yy) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int count = app.themeNames.Count;
        int dw = app.Scale(312);
        int dx = c.Width() - dw;
        int pad = t.paddingLarge;
        int swatch = app.Scale(26);
        int idOp0 = baseId + count + 20;
        List<int> opLevels = OverlayPopup.DrawerOpLevels();
        StyleBox chipStyle = Style.Part(app, "themedrawer", "chip", "", "", "",
                                        Style.SNormal());
        StyleBox chipHover = Style.Part(app, "themedrawer", "chip", "", "", "",
                                        Style.SHover());
        StyleBox chipSelected = Style.Part(app, "themedrawer", "chip", "",
                                           "", "", Style.SSelected());
        yy = this.DrawerSection(app, dx, yy, dw, "透明度");
        int chipGap = app.Scale(6);
        int chipW = (dw - pad * 2 - chipGap * (opLevels.Count - 1))
            / opLevels.Count;
        int chipH = swatch;
        int curOp = app.WindowOpacity();
        for (int i = 0; i < opLevels.Count; i = i + 1) {
            int optId = idOp0 + i;
            int sx = dx + pad + i * (chipW + chipGap);
            bool chipHov = app.focus.IsHovered(optId);
            bool chipSel = curOp == opLevels[i];
            int chipBg = chipStyle.BgOr(0);
            if (chipHov) { chipBg = chipHover.BgOr(chipBg); }
            if (chipSel) { chipBg = chipSelected.BgOr(chipBg); }
            c.FillRoundRect(sx, yy, chipW, chipH, t.borderRadiusSmall,
                            chipBg);
            int chipBd = chipStyle.BorderOr(0);
            if (chipSel) { chipBd = chipSelected.BorderOr(chipBd); }
            else if (chipHov) { chipBd = chipHover.BorderOr(chipBd); }
            c.DrawRoundRect(sx, yy, chipW, chipH, t.borderRadiusSmall,
                            chipBd, 1);
            int chipTc = chipStyle.FgOr(0);
            if (chipSel) { chipTc = chipSelected.FgOr(chipTc); }
            string chipLbl = Convert.ToString(opLevels[i]);
            int chipLw = Canvas.MeasureText(chipLbl, Style.FontFallback(app, "small"));
            c.DrawText(sx + (chipW - chipLw) / 2,
                       Canvas.CenterTextY(yy, chipH, Style.FontFallback(app, "small")),
                       chipLbl, chipTc, Style.FontFallback(app, "small"));
            app.hitTester.RegisterRect(optId, sx, yy, chipW, chipH, 0);
        }
        yy = yy + chipH + pad;
        return yy;
    }

    /// 自定义壁纸选择器 + 混合强度选项。
    int DrawWallpaperSection(App app, int yy) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int count = app.themeNames.Count;
        int dw = app.Scale(312);
        int dx = c.Width() - dw;
        int pad = t.paddingLarge;
        int rowH = t.heightMedium;
        int swatch = app.Scale(26);
        int chipGap = app.Scale(6);
        List<int> opLevels = OverlayPopup.DrawerOpLevels();
        int chipW = (dw - pad * 2 - chipGap * (opLevels.Count - 1)) / opLevels.Count;
        int chipH = swatch;
        int idWallPick = baseId + count + 26;
        int idWallClear = baseId + count + 27;
        int idWallOp0 = baseId + count + 28;
        // ---- 自定义壁纸图片 + 其混合强度 ----
        StyleBox fieldStyle = Style.Part(app, "themedrawer", "field", "",
                                          "", "", Style.SNormal());
        StyleBox fieldHover = Style.Part(app, "themedrawer", "field", "",
                                          "", "", Style.SHover());
        StyleBox fieldDisabled = Style.Part(app, "themedrawer", "field", "",
                                             "", "", Style.SDisabled());
        StyleBox labelStyle = Style.Part(app, "themedrawer", "label", "",
                                         "", "", Style.SNormal());
        StyleBox chipStyle = Style.Part(app, "themedrawer", "chip", "", "", "",
                                        Style.SNormal());
        StyleBox chipHover = Style.Part(app, "themedrawer", "chip", "", "", "",
                                        Style.SHover());
        StyleBox chipSelected = Style.Part(app, "themedrawer", "chip", "",
                                           "", "", Style.SSelected());
        yy = this.DrawerSection(app, dx, yy, dw, "壁纸");
        bool hasWall = app.WallpaperPath() != "";
        int btnGap = app.Scale(6);
        int clearW = app.Scale(58);
        int pickW = dw - pad * 2 - btnGap - clearW;
        bool pickHov = app.focus.IsHovered(idWallPick);
        int pickBg = fieldStyle.BgOr(0);
        if (pickHov) { pickBg = fieldHover.BgOr(pickBg); }
        c.FillRoundRect(dx + pad, yy, pickW, rowH, t.borderRadiusSmall, pickBg);
        c.DrawRoundRect(dx + pad, yy, pickW, rowH, t.borderRadiusSmall,
                        fieldStyle.BorderOr(0), fieldStyle.BorderWOr(1));
        string pickLbl = "选择图片...";
        if (hasWall) {
            string wp = app.WallpaperPath();
            int cut = 0 - 1;
            for (int ci = 0; ci < wp.Length; ci = ci + 1) {
                string ch = wp.Substring(ci, 1);
                if (ch == "\\" || ch == "/") { cut = ci; }
            }
            pickLbl = wp.Substring(cut + 1, wp.Length - cut - 1);
        }
        int pickLw = Canvas.MeasureText(pickLbl, Style.FontFallback(app, "small"));
        int pickTx = dx + pad + app.Scale(8);
        if (pickLw > pickW - app.Scale(16)) {
            c.PushClip(dx + pad, yy, pickW, rowH);
        }
        c.DrawText(pickTx,
                   Canvas.CenterTextY(yy, rowH, Style.FontFallback(app, "small")),
                   pickLbl, labelStyle.FgOr(0), Style.FontFallback(app, "small"));
        if (pickLw > pickW - app.Scale(16)) { c.PopClip(); }
        app.hitTester.RegisterRect(idWallPick, dx + pad, yy, pickW, rowH, 0);

        int clearX = dx + pad + pickW + btnGap;
        bool clrHov = app.focus.IsHovered(idWallClear);
        int clrBg = fieldStyle.BgOr(0);
        if (clrHov && hasWall) { clrBg = fieldHover.BgOr(clrBg); }
        if (!hasWall) { clrBg = fieldDisabled.BgOr(clrBg); }
        c.FillRoundRect(clearX, yy, clearW, rowH, t.borderRadiusSmall, clrBg);
        c.DrawRoundRect(clearX, yy, clearW, rowH, t.borderRadiusSmall,
                        fieldStyle.BorderOr(0), fieldStyle.BorderWOr(1));
        int clrTc = fieldStyle.FgOr(0);
        if (!hasWall) { clrTc = fieldDisabled.FgOr(clrTc); }
        int clrLw = Canvas.MeasureText("清除", Style.FontFallback(app, "small"));
        c.DrawText(clearX + (clearW - clrLw) / 2,
                   Canvas.CenterTextY(yy, rowH, Style.FontFallback(app, "small")),
                   "清除", clrTc, Style.FontFallback(app, "small"));
        if (hasWall) {
            app.hitTester.RegisterRect(idWallClear, clearX, yy, clearW, rowH, 0);
        }
        yy = yy + rowH + pad;

        int curWop = app.WallpaperOpacity();
        for (int i = 0; i < opLevels.Count; i = i + 1) {
            int optId = idWallOp0 + i;
            int sx = dx + pad + i * (chipW + chipGap);
            bool wHov = app.focus.IsHovered(optId);
            bool wSel = curWop == opLevels[i];
            int wBg = chipStyle.BgOr(0);
            if (wHov) { wBg = chipHover.BgOr(wBg); }
            if (wSel) { wBg = chipSelected.BgOr(wBg); }
            c.FillRoundRect(sx, yy, chipW, chipH, t.borderRadiusSmall, wBg);
            int wBd = chipStyle.BorderOr(0);
            if (wSel) { wBd = chipSelected.BorderOr(wBd); }
            else if (wHov) { wBd = chipHover.BorderOr(wBd); }
            c.DrawRoundRect(sx, yy, chipW, chipH, t.borderRadiusSmall, wBd, 1);
            int wTc = chipStyle.FgOr(0);
            if (wSel) { wTc = chipSelected.FgOr(wTc); }
            if (!hasWall) { wTc = fieldDisabled.FgOr(wTc); }
            string wLbl = Convert.ToString(opLevels[i]);
            int wLw = Canvas.MeasureText(wLbl, Style.FontFallback(app, "small"));
            c.DrawText(sx + (chipW - wLw) / 2,
                       Canvas.CenterTextY(yy, chipH, Style.FontFallback(app, "small")),
                       wLbl, wTc, Style.FontFallback(app, "small"));
            app.hitTester.RegisterRect(optId, sx, yy, chipW, chipH, 0);
        }
        yy = yy + chipH;
        return yy;
    }

    /// 动效标签页：动画开关 + 背景特效单选列表。
    void DrawMotionTab(App app, int yy) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int count = app.themeNames.Count;
        int dw = app.Scale(312);
        int dx = c.Width() - dw;
        int pad = t.paddingLarge;
        int rowH = t.heightMedium;
        int fs = Style.FontFallback(app, "medium");
        int idToggle = baseId + count;
        int idKind0 = baseId + count + 1;
        List<string> kinds = OverlayPopup.DrawerKinds();
        StyleBox rowStyle = Style.Part(app, "themedrawer", "row", "", "", "",
                                       Style.SNormal());
        StyleBox rowHover = Style.Part(app, "themedrawer", "row", "", "", "",
                                       Style.SHover());
        StyleBox labelStyle = Style.Part(app, "themedrawer", "label", "", "", "",
                                         Style.SNormal());
        StyleBox radioStyle = Style.Part(app, "themedrawer", "radio", "", "", "",
                                         Style.SNormal());
        StyleBox radioSelected = Style.Part(app, "themedrawer", "radio", "",
                                            "", "", Style.SSelected());
        StyleBox switchStyle = Style.Part(app, "themedrawer", "switch", "",
                                          "", "", Style.SNormal());
        StyleBox switchSelected = Style.Part(app, "themedrawer", "switch", "",
                                             "", "", Style.SSelected());
        StyleBox knobStyle = Style.Part(app, "themedrawer", "knob", "", "", "",
                                        Style.SNormal());
        // ---- 动效标签页 ----
        bool tglHov = app.focus.IsHovered(idToggle);
        if (tglHov) {
            c.FillRect(dx + 1, yy, dw - 2, rowH, rowHover.BgOr(0));
        }
        c.DrawText(dx + pad, Canvas.CenterTextY(yy, rowH, fs),
                   "动画", labelStyle.FgOr(0), fs);
        int pillW = app.Scale(40);
        int pillH = app.Scale(22);
        int px = dx + dw - pad - pillW;
        int py = yy + (rowH - pillH) / 2;
        int pillBg = switchStyle.BgOr(0);
        if (app.fxEnabled) { pillBg = switchSelected.BgOr(pillBg); }
        c.FillRoundRect(px, py, pillW, pillH, pillH / 2, pillBg);
        int knob = pillH - app.Scale(6);
        int kx = px + app.Scale(3);
        if (app.fxEnabled) { kx = px + pillW - knob - app.Scale(3); }
        c.FillCircle(kx + knob / 2, py + pillH / 2, knob / 2,
                     knobStyle.BgOr(0));
        app.hitTester.RegisterRect(idToggle, dx, yy, dw, rowH, 0);
        yy = yy + rowH * 2;

        yy = this.DrawerSection(app, dx, yy - rowH, dw, "背景效果");
        for (int i = 0; i < kinds.Count; i = i + 1) {
            int optId = idKind0 + i;
            int kindVal = i;                 // 1..6 = BackdropFx 种类
            if (i == 0) { kindVal = 0 - 1; } // 跟随外观
            bool hovered = app.focus.IsHovered(optId);
            bool selected = app.fxKindOverride == kindVal;
            if (hovered) {
                c.FillRect(dx + 1, yy, dw - 2, rowH, rowHover.BgOr(0));
            }
            // 单选圆点
            int rr = app.Scale(7);
            int rcx = dx + pad + rr;
            int rcy = yy + rowH / 2;
            if (selected) {
                c.DrawCircle(rcx, rcy, rr, radioSelected.BorderOr(0),
                             radioSelected.BorderWOr(2));
                c.FillCircle(rcx, rcy, rr - app.Scale(3),
                             radioSelected.BgOr(radioSelected.BorderOr(0)));
            } else {
                c.DrawCircle(rcx, rcy, rr, radioStyle.BorderOr(0),
                             radioStyle.BorderWOr(1));
            }
            int tc = labelStyle.FgOr(0);
            if (selected) { tc = radioSelected.FgOr(tc); }
            c.DrawText(dx + pad + rr * 2 + app.Scale(10),
                       Canvas.CenterTextY(yy, rowH, fs),
                       kinds[i], tc, fs);
            app.hitTester.RegisterRect(optId, dx, yy, dw, rowH, 0);
            yy = yy + rowH;
        }
    }

    /// 外观抽屉的点击 / 外部按压 / Escape 分发。
    void HandleDrawerInput(App app) {
        Canvas c = app.canvas;
        int count = app.themeNames.Count;
        int dw = app.Scale(312);
        int dx = c.Width() - dw;
        int top = app.ContentTop();
        int idToggle = baseId + count;
        int idKind0 = baseId + count + 1;
        int idAcc0 = baseId + count + 10;
        int idClose = baseId + count + 17;
        int idTab0 = baseId + count + 18;
        int idOp0 = baseId + count + 20;
        int idWallPick = baseId + count + 26;
        int idWallClear = baseId + count + 27;
        int idWallOp0 = baseId + count + 28;
        int idDen0 = baseId + count + 32;
        List<int> accents = OverlayPopup.DrawerAccents();
        List<string> kinds = OverlayPopup.DrawerKinds();
        List<int> opLevels = OverlayPopup.DrawerOpLevels();
        // ---- 分发 ----
        int kind = app.EventKind();
        if (kind == 3) {
            int hit = app.ClickTarget();
            if (hit >= baseId && hit < baseId + count) {
                app.themeMenuModel.Set(hit - baseId);
                app.RequestRedraw();
            } else if (hit == idToggle) {
                app.SetBackdropFx(!app.fxEnabled);
            } else if (hit >= idKind0 && hit < idKind0 + kinds.Count) {
                int ki = hit - idKind0;
                int kv = ki;
                if (ki == 0) { kv = 0 - 1; }
                app.fxKindOverride = kv;
                app.SetBackdropFx(app.fxEnabled);
            } else if (hit >= idAcc0 && hit < idAcc0 + accents.Count) {
                app.accentOverride = accents[hit - idAcc0];
                app.ApplySkin(app.appliedSkin);
                app.RequestRedraw();
            } else if (hit >= idOp0 && hit < idOp0 + opLevels.Count) {
                app.SetWindowOpacity(opLevels[hit - idOp0]);
                app.RequestRedraw();
            } else if (hit >= idDen0 && hit < idDen0 + 3) {
                app.SetDensity(hit - idDen0);
                app.RequestRedraw();
            } else if (hit == idWallPick) {
                app.RequestWallpaperPick();
            } else if (hit == idWallClear) {
                app.ClearWallpaper();
            } else if (hit >= idWallOp0 && hit < idWallOp0 + opLevels.Count) {
                app.SetWallpaper(app.WallpaperPath(),
                                 opLevels[hit - idWallOp0]);
            } else if (hit == idTab0 || hit == idTab0 + 1) {
                app.themeDrawerTab.Set(hit - idTab0);
                scrollModel.Set(0);
                app.RequestRedraw();
            } else if (hit == idClose) {
                openFlag.Set(false);
                app.RequestRedraw();
            }
        }
        if (kind == 2) {
            int pt = app.PressTarget();
            bool inside = pt >= baseId && pt < baseId + count + 40;
            bool insidePanel = app.mouseX >= dx && app.mouseY >= top;
            if (pt != triggerId && !inside && !insidePanel) {
                openFlag.Set(false);
                app.RequestRedraw();
            }
        }
        if (kind == 4 && app.window.EventKeyCode() == 27) {
            openFlag.Set(false);
            app.RequestRedraw();
        }
    }

    /// 居中显示、两侧带分隔线的抽屉分区标题
    /// （“---- Label ----”）。返回标题下方的 y。
    int DrawerSection(App app, int dx, int yy, int dw, string label) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int pad = t.paddingLarge;
        int rowH = t.heightMedium;
        StyleBox ruleStyle = Style.Part(app, "themedrawer", "rule", "", "", "",
                                         Style.SNormal());
        StyleBox sectionStyle = Style.Part(app, "themedrawer", "section", "",
                                           "", "", Style.SNormal());
        int lw = Canvas.MeasureText(label, Style.FontFallback(app, "small"));
        int cy = yy + rowH / 2;
        int lx = dx + (dw - lw) / 2;
        c.FillRect(dx + pad, cy, lx - app.Scale(10) - dx - pad, 1,
                   ruleStyle.BgOr(0));
        c.FillRect(lx + lw + app.Scale(10), cy,
                   dx + dw - pad - lx - lw - app.Scale(10), 1,
                   ruleStyle.BgOr(0));
        c.DrawText(lx, Canvas.CenterTextYAt(cy, Style.FontFallback(app, "small")), label,
                   sectionStyle.FgOr(0), Style.FontFallback(app, "small"));
        return yy + rowH;
    }

    /// 富项目列表的面板宽度：最宽标签加上图标列和
    /// 右侧留白（快捷键文本 / 子菜单箭头），并限制最小宽度。
    static int RichWidth(App app, List<MenuItem> items) {
        Theme t = app.theme;
        int padH = app.Scale(8);
        int iconCol = t.iconSizeSmall + app.Scale(10);
        int maxLbl = 0;
        int maxRight = 0;
        for (int i = 0; i < items.Count; i = i + 1) {
            MenuItem m = items[i];
            if (m.kind == 0 || m.kind == 2 || m.kind == 3) {
                int lw = Canvas.MeasureText(m.label, Style.FontFallback(app, "medium"));
                if (lw > maxLbl) { maxLbl = lw; }
            }
            if (m.kind == 0 && m.shortcut != "") {
                int sw = Canvas.MeasureText(m.shortcut, Style.FontFallback(app, "small"));
                if (sw > maxRight) { maxRight = sw; }
            }
            if (m.kind == 3 && t.iconSizeSmall > maxRight) { maxRight = t.iconSizeSmall; }
        }
        int w = padH + iconCol + maxLbl + app.Scale(24) + maxRight + padH;
        int minW = app.Scale(168);
        if (w < minW) { w = minW; }
        return w;
    }

    /// 富菜单行高：比表单控件（heightMedium）紧凑——右键菜单
    /// 条目多，一行 26 逻辑像素才能一屏放下。
    static int MenuRowH(App app) { return app.Scale(26); }

    /// 富项目列表的可视高度：条目总高被 maxRows 行的可点击
    /// 高度钳制（maxRows <= 0 时整高）。定位与渲染共用同一
    /// 口径，宿主传进来的 y 才不会按整高翻转到触发器上方。
    static int RichViewH(App app, List<MenuItem> items, int maxRows) {
        int fullH = OverlayPopup.RichHeight(app, items);
        if (maxRows <= 0) { return fullH; }
        int cap = app.Scale(12) + maxRows * OverlayPopup.MenuRowH(app);
        if (fullH > cap) { return cap; }
        return fullH;
    }

    /// 富项目列表的面板高度（分隔线和标题比
    /// 可点击行更矮）。
    static int RichHeight(App app, List<MenuItem> items) {
        int rowH = OverlayPopup.MenuRowH(app);
        int sepH = app.Scale(8);
        int hdrH = app.Scale(20);
        int h = app.Scale(6) * 2;
        for (int i = 0; i < items.Count; i = i + 1) {
            int k = items[i].kind;
            if (k == 1) { h = h + sepH; }
            else if (k == 2) { h = h + hdrH; }
            else { h = h + rowH; }
        }
        return h;
    }

    /// `upto` 处项目在面板内的 Y 偏移，按行类型计算。
    static int RichRowTop(App app, List<MenuItem> items, int upto, int startY) {
        int rowH = OverlayPopup.MenuRowH(app);
        int sepH = app.Scale(8);
        int hdrH = app.Scale(20);
        int yy = startY;
        for (int i = 0; i < upto; i = i + 1) {
            int k = items[i].kind;
            if (k == 1) { yy = yy + sepH; }
            else if (k == 2) { yy = yy + hdrH; }
            else { yy = yy + rowH; }
        }
        return yy;
    }

    /// 在 (px,py) 处绘制一个富菜单面板（图标 / 分隔线 / 标题 / 子菜单
    /// 箭头），并为每个可点击 / 子菜单行注册命中 id `idBase + rowIndex`。
    /// `ph` 是可视高度，行按 `scrollY` 上移并裁进面板（可滚动主面板
    /// 用，子菜单面板传 0）。返回光标所在的行索引，没有则为 -1。
    /// `barW` 是面板右缘滚动条条带的宽度（无可滚动时为 0）：
    /// 行悬停不含条带——条带归滚动条，悬停伸进去会让拖动滑块
    /// 的指针扫出子菜单父行，子面板开合顶漂覆盖层 AllocId，
    /// 滚动条 IsPressed 失配后拖动中断、恢复时瞬移。
    static int PaintRichPanel(App app, List<MenuItem> items, int px, int py,
                              int pw, int ph, int idBase, int scrollY,
                              int barW) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int rowH = OverlayPopup.MenuRowH(app);
        int sepH = app.Scale(8);
        int hdrH = app.Scale(20);
        int padV = app.Scale(6);
        int padH = app.Scale(8);
        int iconCol = t.iconSizeSmall + app.Scale(10);

        StyleBox menuStyle = Style.Full(app, "contextmenu", "", "",
                                        Style.SNormal());
        StyleBox itemStyle = Style.Part(app, "contextmenu", "item", "", "",
                                        "", Style.SNormal());
        StyleBox itemHover = Style.Part(app, "contextmenu", "item", "", "",
                                        "", Style.SHover());
        StyleBox itemDanger = Style.Part(app, "contextmenu", "item", "",
                                         "danger", "", Style.SNormal());
        StyleBox dangerHover = Style.Part(app, "contextmenu", "item", "",
                                          "danger", "", Style.SHover());
        StyleBox itemDisabled = Style.Part(app, "contextmenu", "item", "",
                                           "", "", Style.SDisabled());
        StyleBox headerStyle = Style.Part(app, "contextmenu", "header", "",
                                          "", "", Style.SNormal());
        StyleBox accelStyle = Style.Part(app, "contextmenu", "accel", "", "",
                                         "", Style.SNormal());
        StyleBox separatorStyle = Style.Part(app, "contextmenu", "separator", "",
                                             "", "", Style.SNormal());
        int menuRadius = menuStyle.RadiusOr(t.borderRadiusMedium);
        int menuShadow = menuStyle.shadow;
        int menuBg = menuStyle.BgOr(0);
        int menuBorder = menuStyle.BorderOr(0);
        int menuBorderW = menuStyle.BorderWOr(1);
        int separatorBg = separatorStyle.BgOr(0);
        int itemFg = itemStyle.FgOr(0);
        int itemHoverBg = itemHover.BgOr(0);
        int itemDangerFg = itemDanger.FgOr(app.theme.error);
        int dangerHoverBg = dangerHover.BgOr(itemHoverBg);
        int itemDisabledFg = itemDisabled.FgOr(itemFg);
        int headerFg = headerStyle.FgOr(0);
        int accelFg = accelStyle.FgOr(0);

        c.FillRoundRect(px + 1, py + 3, pw, ph, menuRadius, menuShadow);
        c.FillRoundRect(px, py, pw, ph, menuRadius, menuBg);
        c.DrawRoundRect(px, py, pw, ph, menuRadius, menuBorder, menuBorderW);
        app.BlockHitsRect(px, py, pw, ph);

        int hoverRow = 0 - 1;
        int hoverMaxX = px + pw - barW;
        int rowY = py + padV - scrollY;
        c.PushClip(px, py, pw, ph);
        for (int i = 0; i < items.Count; i = i + 1) {
            MenuItem m = items[i];
            if (m.kind == 1) {
                if (rowY + sepH > py && rowY < py + ph) {
                    c.FillRect(px + padH, rowY + sepH / 2, pw - padH * 2, 1,
                               separatorBg);
                }
                rowY = rowY + sepH;
            } else if (m.kind == 2) {
                if (rowY + hdrH > py && rowY < py + ph) {
                    int ty = Canvas.CenterTextY(rowY, hdrH, Style.FontFallback(app, "small"));
                    c.DrawText(px + padH, ty, m.label, headerFg, Style.FontFallback(app, "small"));
                }
                rowY = rowY + hdrH;
            } else {
                bool vis = rowY + rowH > py && rowY < py + ph;
                bool hovered = vis
                    && app.mouseX >= px && app.mouseX < hoverMaxX
                    && app.mouseY >= rowY && app.mouseY < rowY + rowH;
                int fg = itemFg;
                int hoverBg = itemHoverBg;
                if (m.disabled) { fg = itemDisabledFg; }
                else if (m.danger) {
                    fg = itemDangerFg;
                    hoverBg = dangerHoverBg;
                }
                if (vis && hovered && !m.disabled) {
                    c.FillRect(px + 1, rowY, pw - 2, rowH, hoverBg);
                }
                if (vis) {
                    if (m.icon != "") {
                        c.DrawGlyphIn(m.icon, px + padH, rowY,
                            t.iconSizeSmall, rowH, t.iconSizeSmall, fg);
                    }
                    int ty = Canvas.CenterTextY(rowY, rowH, Style.FontFallback(app, "medium"));
                    c.DrawText(px + padH + iconCol, ty, m.label, fg, Style.FontFallback(app, "medium"));
                    if (m.kind == 3) {
                        c.DrawGlyphIn("chevron-right",
                            px + pw - padH - t.iconSizeSmall, rowY,
                            t.iconSizeSmall, rowH, t.iconSizeSmall, fg);
                    } else if (m.shortcut != "") {
                        int sw = Canvas.MeasureText(m.shortcut, Style.FontFallback(app, "small"));
                        c.DrawText(px + pw - padH - sw, ty, m.shortcut,
                            accelFg, Style.FontFallback(app, "small"));
                    }
                    if (hovered) { hoverRow = i; }
                    // 命中区裁到可视范围：滚动时首尾的半行只以可见
                    // 部分响应点击，面板边缘外的不可见部分不拦截。
                    int vy0 = rowY;
                    if (vy0 < py) { vy0 = py; }
                    int vy1 = rowY + rowH;
                    if (vy1 > py + ph) { vy1 = py + ph; }
                    app.hitTester.RegisterRect(idBase + i, px, vy0, pw,
                                               vy1 - vy0, 0);
                }
                rowY = rowY + rowH;
            }
        }
        c.PopClip();
        return hoverRow;
    }

    /// 绘制并分发富菜单：主面板（可按 richMaxRows 出滚动条）加
    /// 悬停展开的一层子菜单。叶子项在左键松开时把 `action` 写入
    /// `result` 并关闭；面板外按压、Escape 或窗口失焦也关闭。
    /// 行悬停按几何解析，仅悬停行变化时请求重绘。
    void RenderRich(App app) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        List<MenuItem> items = menuItems;
        int n = items.Count;
        int margin = app.Scale(4);
        int cw = c.Width();
        int ch = c.Height();

        int pw = OverlayPopup.RichWidth(app, items);
        if (richMinW > pw) { pw = richMinW; }
        int fullH = OverlayPopup.RichHeight(app, items);
        int px = x;
        if (px + pw > cw - margin) { px = cw - margin - pw; }
        if (px < margin) { px = margin; }
        // 可滚动主面板：可视高度按 richMaxRows 收口，超出部分滚轮
        // 和拖动滚动条都可用。
        int viewH = fullH;
        int scrollY = 0;
        int maxScroll = 0;
        int py = y;
        if (richScroll != null && richMaxRows > 0) {
            viewH = OverlayPopup.RichViewH(app, items, richMaxRows);
            maxScroll = fullH - viewH;
            if (maxScroll < 0) { maxScroll = 0; }
        }
        if (py + viewH > ch - margin) { py = ch - margin - viewH; }
        if (py < margin) { py = margin; }
        if (maxScroll > 0) {
            // 滚轮直接按几何认领（CaptureWheel 仲裁），不走
            // Ui.Over：本弹层已铺全屏遮罩，PointerCaptured 恒为
            // 真，经 Ui.Over 的 HandleWheel 在弹层里永远拿不到
            // 滚轮事件。
            bool ownsWheel = app.CaptureWheel(px, py, pw, viewH);
            if (ownsWheel && app.EventKind() == 13) {
                int wdelta = app.window.EventKeyCode();
                int cur = richScroll.Get() - wdelta * app.scrollSpeed / 120;
                if (cur < 0) { cur = 0; }
                if (cur > maxScroll) { cur = maxScroll; }
                if (cur != richScroll.Get()) {
                    richScroll.Set(cur);
                    app.NoteScrollDamage(px, py, pw, viewH);
                }
            }
            scrollY = richScroll.Get();
            if (scrollY < 0) { scrollY = 0; }
            if (scrollY > maxScroll) { scrollY = maxScroll; }
            richScroll.Set(scrollY);
        }

        app.BlockHitsBelow();
        // 富菜单行由几何驱动：不注册命中 id，因此面板内移动指针
        // 不会改变悬停 id，也就不会安排重绘。只在悬停行真的变了时
        // 重绘，而不是菜单开着就每个鼠标移动事件重绘一整帧。
        int barW = 0;
        if (maxScroll > 0) { barW = app.Scale(10); }
        int overRow = OverlayPopup.PaintRichPanel(app, items, px, py, pw, viewH,
            baseId, scrollY, barW);
        if (overRow != OverlayPopup.lastRichHover) {
            OverlayPopup.lastRichHover = overRow;
            app.RequestRedraw();
        }

        // 跟踪当前打开的（若有）子菜单。悬停子菜单
        // 父项时打开；光标位于父项或其子面板上时保持打开；
        // 光标移到其它（非子菜单）行时关闭。
        int curSub = subOpen.Get();
        bool overParentSub = overRow >= 0 && overRow < n && items[overRow].kind == 3;
        bool overOtherRow = overRow >= 0 && !overParentSub;

        int childX = 0;
        int childY = 0;
        int childW = 0;
        int childH = 0;
        bool haveChild = false;
        if (curSub >= 0 && curSub < n && items[curSub].kind == 3) {
            List<MenuItem> kids = items[curSub].children;
            childW = OverlayPopup.RichWidth(app, kids);
            childH = OverlayPopup.RichHeight(app, kids);
            childX = px + pw - app.Scale(4);
            if (childX + childW > cw - margin) { childX = px - childW + app.Scale(4); }
            childY = OverlayPopup.RichRowTop(app, items, curSub, py + app.Scale(6))
                - scrollY;
            if (childY + childH > ch - margin) { childY = ch - margin - childH; }
            if (childY < margin) { childY = margin; }
            haveChild = true;
        }
        bool overChild = haveChild
            && app.mouseX >= childX && app.mouseX < childX + childW
            && app.mouseY >= childY && app.mouseY < childY + childH;

        int newSub = curSub;
        if (overParentSub) { newSub = overRow; }
        else if (overChild) { newSub = curSub; }
        else if (overOtherRow) { newSub = 0 - 1; }
        if (newSub != curSub) {
            subOpen.Set(newSub);
            app.RequestRedraw();
        }

        int childOver = 0 - 1;
        int cx = 0;
        int cy = 0;
        int cwd = 0;
        int chd = 0;
        bool childOpen = false;
        if (newSub >= 0 && newSub < n && items[newSub].kind == 3) {
            List<MenuItem> ck = items[newSub].children;
            cwd = OverlayPopup.RichWidth(app, ck);
            chd = OverlayPopup.RichHeight(app, ck);
            cx = px + pw - app.Scale(4);
            if (cx + cwd > cw - margin) { cx = px - cwd + app.Scale(4); }
            cy = OverlayPopup.RichRowTop(app, items, newSub, py + app.Scale(6))
                - scrollY;
            if (cy + chd > ch - margin) { cy = ch - margin - chd; }
            if (cy < margin) { cy = margin; }
            childOver = OverlayPopup.PaintRichPanel(app, ck, cx, cy, cwd, chd,
                baseId + 128, 0, 0);
            childOpen = true;
        } else {
            // 子面板没开也要占掉它的 barrier id：覆盖层 AllocId 按
            // 注册顺序发号，子面板开/关增减一个命中区会把其后注册
            // 的滚动条 id 顶得漂移，拖动中 IsPressed 突然失配中断
            // 拖动，等 id 回来又按 jump-to-mouse 瞬移——来回跳跃。
            app.focus.AllocId();
        }

        // 滚动条：画在行之上，命中区在行之后注册，拖动优先于行点击。
        if (maxScroll > 0) {
            Widget.Scrollbar.RenderVerticalScrollIn(app,
                px + pw - app.Scale(10), py, viewH, viewH, fullH, richScroll,
                px, py, pw, viewH);
        }

        // 交互由几何驱动（右键目标不会填充
        // 主点击/按压 id）。叶子项在左键于其行上松开时激活；
        // 在两个面板之外点击（或 Escape）则关闭。菜单
        // 锚定在打开点，因此打开时的右键松开落在
        // 其内部，不会立即自我关闭。
        int kind = app.EventKind();
        int btn = app.window.EventButton();
        bool inMain = app.mouseX >= px && app.mouseX < px + pw
            && app.mouseY >= py && app.mouseY < py + viewH;
        bool inChild = childOpen
            && app.mouseX >= cx && app.mouseX < cx + cwd
            && app.mouseY >= cy && app.mouseY < cy + chd;
        // 滚动条条带上的按下/松开属于滚动交互（拖动中常越出
        // 面板底部）：既不算叶子行激活，也不关闭菜单。
        bool onBar = maxScroll > 0 && app.mouseX >= px + pw - app.Scale(10)
            && app.mouseX < px + pw;

        // 叶子激活只认「本帧首次到达、未被认领」的释放：打开
        // 菜单的那次触发器释放已在同帧被 ClaimClick 认领，若这里
        // 直接读原始事件，会把同一次释放当成行点击（触发器与
        // 首行重叠），菜单开了即选第 0 项。EventKind 在空闲帧
        // 停留不变，ClickFrameCurrent 同时挡住陈旧释放的重放。
        if (kind == 3 && btn == 0 && !onBar && app.ClickFrameCurrent()
            && !app.ClickClaimed()) {
            if (childOpen && childOver >= 0
                && childOver < items[newSub].children.Count) {
                MenuItem hcm = items[newSub].children[childOver];
                if (hcm.kind == 0 && !hcm.disabled) {
                    result.Set(hcm.action);
                    openFlag.Set(false);
                    subOpen.Set(0 - 1);
                    app.RequestRedraw();
                }
            } else if (overRow >= 0 && overRow < n) {
                MenuItem hm = items[overRow];
                if (hm.kind == 0 && !hm.disabled) {
                    result.Set(hm.action);
                    openFlag.Set(false);
                    subOpen.Set(0 - 1);
                    app.RequestRedraw();
                }
            }
        }
        bool leftEvt = (kind == 2 || kind == 3) && btn == 0;
        // 释放引发的关闭只认本帧首次到达且未被认领的释放：打开
        // 菜单的那次触发器释放（已被认领）落在面板之外，直接读
        // 原始事件会在同帧把刚打开的菜单关掉；EventKind 在空闲
        // 帧停留不变，ClickFrameCurrent 同时挡住陈旧释放重放。
        bool releaseOwned = kind == 2
            || (app.ClickFrameCurrent() && !app.ClickClaimed());
        if (leftEvt && releaseOwned && !inMain && !inChild && !onBar) {
            openFlag.Set(false);
            subOpen.Set(0 - 1);
            app.RequestRedraw();
        }
        if (kind == 4 && app.window.EventKeyCode() == 27) {
            openFlag.Set(false);
            subOpen.Set(0 - 1);
            app.RequestRedraw();
        }
        // 窗口失焦（事件 9，或本帧查询到焦点已不在本窗口）时
        // 同样关闭：切到别的窗口后菜单不该悬在非活动窗口上。
        if (kind == 9 || !app.window.IsFocused()) {
            openFlag.Set(false);
            subOpen.Set(0 - 1);
            app.RequestRedraw();
        }
    }
}
