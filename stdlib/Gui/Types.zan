using System;

namespace Gui;

class Point {
    int x;
    int y;

    Point(int x, int y) {
        this.x = x;
        this.y = y;
    }
}

class Size {
    int width;
    int height;

    Size(int w, int h) {
        this.width = w;
        this.height = h;
    }
}

class Insets {
    int top;
    int right;
    int bottom;
    int left;

    Insets(int top, int right, int bottom, int left) {
        this.top = top;
        this.right = right;
        this.bottom = bottom;
        this.left = left;
    }

    static Insets Uniform(int val) {
        return new Insets(val, val, val, val);
    }

    static Insets Symmetric(int vertical, int horizontal) {
        return new Insets(vertical, horizontal, vertical, horizontal);
    }

    int Horizontal() { return left + right; }
    int Vertical() { return top + bottom; }
}

class Rect {
    int x;
    int y;
    int width;
    int height;

    Rect(int x, int y, int w, int h) {
        this.x = x;
        this.y = y;
        this.width = w;
        this.height = h;
    }

    int Right() { return x + width; }
    int Bottom() { return y + height; }

    bool Contains(int px, int py) {
        if (px < x) { return false; }
        if (px >= x + width) { return false; }
        if (py < y) { return false; }
        if (py >= y + height) { return false; }
        return true;
    }

    bool Intersects(int ox, int oy, int ow, int oh) {
        if (x + width <= ox) { return false; }
        if (ox + ow <= x) { return false; }
        if (y + height <= oy) { return false; }
        if (oy + oh <= y) { return false; }
        return true;
    }

    static Rect Inflate(int rx, int ry, int rw, int rh, int amount) {
        return new Rect(rx - amount, ry - amount, rw + amount * 2, rh + amount * 2);
    }
}

/// A colour: a packed 0xAARRGGBB value with CSS as its text form.
///
/// This is a value type, so it costs no allocation to pass one around; the
/// packed representation is what the renderer and the platform layer speak,
/// and it is produced only at that boundary via <c>ToArgb()</c>. An alpha of
/// zero is "unset" (<c>Color.None()</c>), matching the CSS `transparent` and
/// the sentinel the style layer has always used.
struct Color {
    uint argb;

    static Color FromArgb(uint packed) {
        Color c = new Color();
        c.argb = packed;
        return c;
    }

    /// Parses any CSS colour form: `#rgb`, `#rgba`, `#rrggbb`, `#aarrggbb`,
    /// `rgb()/rgba()`, `hsl()/hsla()`, `0x...`, a decimal and the named
    /// colours. An empty or unparseable value yields <c>None()</c>.
    static Color Parse(string css) {
        return Color.FromArgb((uint)StyleSheet.ParseColor(css));
    }

    static Color FromRGBA(int r, int g, int b, int a) {
        return Color.FromArgb((uint)(((a & 255) * 16777216) + ((r & 255) * 65536) +
                                     ((g & 255) * 256) + (b & 255)));
    }

    static Color FromRGB(int r, int g, int b) { return Color.FromRGBA(r, g, b, 255); }

    /// A 0xRRGGBB literal, taken as fully opaque.
    static Color FromHex(int hex) {
        return Color.FromRGB((hex / 65536) % 256, (hex / 256) % 256, hex % 256);
    }

    /// The unset colour: nothing is painted with it.
    static Color None() { return Color.FromArgb(0); }

    bool IsNone() { return argb == 0; }

    int A() { return (int)((argb / 16777216) % 256); }
    int R() { return (int)((argb / 65536) % 256); }
    int G() { return (int)((argb / 256) % 256); }
    int B() { return (int)(argb % 256); }

    Color WithAlpha(int a) { return Color.FromRGBA(R(), G(), B(), a); }

    /// The packed value handed to the renderer and the platform layer.
    uint ToArgb() { return argb; }

    /// Legacy spelling of <c>ToArgb()</c>.
    int ToARGB() { return (int)argb; }

    /// `#rrggbb`, or `#aarrggbb` when the colour is translucent.
    string ToCss() {
        string body = Color.Hex2(R()) + Color.Hex2(G()) + Color.Hex2(B());
        if (A() == 255) { return "#" + body; }
        return "#" + Color.Hex2(A()) + body;
    }

    static string Hex2(int v) {
        string digits = "0123456789abcdef";
        int n = v & 255;
        return digits.Substring(n / 16, 1) + digits.Substring(n % 16, 1);
    }

    static Color White() { return Color.FromRGB(255, 255, 255); }
    static Color Black() { return Color.FromRGB(0, 0, 0); }
    static Color Red() { return Color.FromRGB(208, 48, 80); }
    static Color Green() { return Color.FromRGB(24, 160, 88); }
    static Color Blue() { return Color.FromRGB(32, 128, 240); }
    static Color Yellow() { return Color.FromRGB(240, 160, 32); }
    static Color Gray() { return Color.FromRGB(128, 128, 128); }
}

class Cursor {
    static int Arrow() { return 0; }
    static int Hand() { return 1; }
    static int IBeam() { return 2; }
    static int ResizeH() { return 3; }
    static int ResizeV() { return 4; }
}
