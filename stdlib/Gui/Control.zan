using System;

namespace Gui;

/// One event-handler binding for the designer/serializer: an event name mapped
/// to a handler identifier. One entity instead of parallel key/value lists.
class EventBinding {
    string key;
    string val;

    EventBinding(string key, string val) {
        this.key = key;
        this.val = val;
    }
}

/// Retained-mode component tree (coexists with the immediate-mode widgets).
///
/// Every node is a `Control`: it has a stable `name`, a parent, an ordered list
/// of children, a dock hint, and a resolved bounds rect. Containers append
/// children with `Add`; any node can locate a descendant with `Find(name)`.
/// Layout is WinForms-style docking (see `Arrange`): docked children snap to an
/// edge and consume space in insertion order, a `Fill` child takes what remains,
/// and `Manual` children sit at an explicit offset inside the parent. Drawing is
/// polymorphic - subclasses override `OnPaint` and the framework recurses via
/// `Paint`, clipping each subtree to its parent's box so content cannot bleed
/// out (reuses the native clip stack).
///
/// NOTE: the base method names are deliberately unusual (Paint/Arrange/
/// MeasureTree/InitControl/OnPaint/OnMeasure) so they never collide with a
/// widget's own methods when a widget subclasses Control - the compiler resolves
/// calls by name only (no overloading), so a base name reused by a subclass with
/// a different signature would miscompile.
class Control {
    string name;
    /// 0 manual, 1 top, 2 bottom, 3 left, 4 right, 5 fill.
    int dock;
    /// Auto-flow for children added via With(): 0 none, 1 column, 2 row.
    /// A container (see Panel.Column/Row) sets this so each With() child docks
    /// along the flow axis automatically.
    int layout;
    /// When true this node should grow to fill the remaining main-axis space of
    /// its flow parent (dock == fill), overriding the flow's default docking.
    bool grow;
    /// Preferred main-axis extent used while docking (height for top/bottom,
    /// width for left/right). Ignored for a Fill child. A widget's OnMeasure
    /// typically sets these from the theme.
    int prefW;
    int prefH;
    /// Manual offset inside the parent content box when dock == 0.
    int mx;
    int my;
    int padL;
    int padT;
    int padR;
    int padB;
    int gap;
    bool visible;
    /// Resolved bounds in canvas coordinates (set by Arrange).
    int bx;
    int by;
    int bw;
    int bh;
    weak Control parent;
    List<Control> children;
    /// Event-handler bindings for the designer/serializer: maps an event name
    /// (see Events()) to a handler identifier. Empty when unbound.
    List<EventBinding> events;
    /// Common per-widget event bundle (pointer/focus/keyboard/touch/drag),
    /// inherited by every control. Interactive widgets that own a stable id
    /// wire it themselves (On.Fire(app, id) after registering their hit
    /// region); everything else is wired by RenderTree via FireCommon.
    WidgetEvents On;
    /// Stable id backing `On` for widgets that do not own one (containers and
    /// display-only widgets). Allocated on first use; 0 = never needed.
    int commonId;
    /// Set by a widget that registers its own hit region and calls On.Fire
    /// itself (Button, Input, ...), so RenderTree does not fire the bundle a
    /// second time on a second id.
    bool wiresOwnEvents;
    /// Lifecycle events fired by RenderTree: Paint every frame this node paints,
    /// Resize when its resolved size changed, Show/Hide on a visibility flip.
    UiEvent Paint;
    UiEvent Resize;
    UiEvent Show;
    UiEvent Hide;
    int lastBw;
    int lastBh;
    bool lastVisible;
    bool everLaidOut;
    /// Optional dotted state path this control is bound to (JSON `bind`), used
    /// by UiDoc to sync the control's value with a state entity. Empty = none.
    string bindPath;
    /// Optional control property used by the binding. Empty selects the
    /// control's canonical `value`/`text` property automatically.
    string bindProp;
    string bindSnapshot;
    /// Optional style class (JSON `class`), used by a StyleSheet to cascade
    /// declarations onto this control by `.class` selector. Empty = none.
    /// Space separated CSS classes: `btn.Class = "primary small";` (assign,
    /// no setter) -- every visual variant a widget has is one of these.
    string Class;
    StyleBox computedStyle;
    int computedStyleGen;
    string computedStyleType;
    string computedStyleClass;
    string computedStyleId;
    bool styleSurfaceOwned;

    // --- CSS-like style layer (all 0 = unset). Honoured by PaintStyleBox for
    // surfaces and by text widgets for color/font. Set via the fluent
    // Bg/Gradient/Radius/Border/Shadow/TextColor/FontPx helpers, or cascaded
    // from a StyleSheet / skin. Colors are packed 0xAARRGGBB ints (as Theme).
    int styleBg;
    int styleBgTo;
    int styleRadius;
    int styleBorderColor;
    int styleBorderWidth;
    int styleShadow;
    int styleShadowDy;
    int styleColor;
    int styleFontPx;
    int styleTransitionMs;

    /// Base initialiser every subclass calls from its factory/constructor.
    void InitControl(string n, int d) {
        name = n;
        dock = d;
        prefW = 0;
        prefH = 0;
        mx = 0;
        my = 0;
        paneMin = 0;
        paneMax = 0;
        padL = 0;
        padT = 0;
        padR = 0;
        padB = 0;
        gap = 0;
        visible = true;
        bx = 0;
        by = 0;
        bw = 0;
        bh = 0;
        parent = null;
        children = new List<Control>();
        events = new List<EventBinding>();
        On = WidgetEvents.Create();
        commonId = 0;
        wiresOwnEvents = false;
        Paint = UiEvent.Create();
        Resize = UiEvent.Create();
        Show = UiEvent.Create();
        Hide = UiEvent.Create();
        lastBw = 0;
        lastBh = 0;
        lastVisible = false;
        everLaidOut = false;
        layout = 0;
        grow = false;
        bindPath = "";
        bindProp = "";
        bindSnapshot = "";
        Class = "";
        computedStyle = null;
        computedStyleGen = 0 - 1;
        computedStyleType = "";
        computedStyleClass = "";
        computedStyleId = "";
        styleSurfaceOwned = false;
        styleBg = 0;
        styleBgTo = 0;
        styleRadius = 0;
        styleBorderColor = 0;
        styleBorderWidth = 0;
        styleShadow = 0;
        styleShadowDy = 0;
        styleColor = 0;
        styleFontPx = 0;
        styleTransitionMs = 0;
    }

    // --- CSS-like fluent style setters (chainable). Names are unique across
    // the widget set so they never collide with a subclass method. ---
    Control Bg(int c) { styleBg = c; styleBgTo = 0; computedStyle = null; return this; }
    Control Gradient(int top, int bottom) { styleBg = top; styleBgTo = bottom; computedStyle = null; return this; }
    Control Radius(int r) { styleRadius = r; computedStyle = null; return this; }
    Control Border(int color, int w) { styleBorderColor = color; styleBorderWidth = w; computedStyle = null; return this; }
    Control Shadow(int color, int dy) { styleShadow = color; styleShadowDy = dy; computedStyle = null; return this; }
    Control TextColor(int c) { styleColor = c; computedStyle = null; return this; }
    Control FontPx(int px) { styleFontPx = px; computedStyle = null; return this; }
    Control Transition(int ms) { styleTransitionMs = ms; computedStyle = null; return this; }

    // --- Chainable event subscription (a C#-close alternative to BindEvent;
    // `btn.OnClick(Handler)` reads like `btn.Click += Handler`). Each appends
    // a handler and returns THIS so setup stays fluent. ---
    Control OnClick(Action a) { BindEvent("Click", a); return this; }
    Control OnDoubleClick(Action a) { BindEvent("DoubleClick", a); return this; }
    Control OnRightClick(Action a) { BindEvent("RightClick", a); return this; }
    Control OnChange(Action a) { BindEvent("Change", a); return this; }
    Control OnEnter(Action a) { BindEvent("Enter", a); return this; }
    Control OnLeave(Action a) { BindEvent("Leave", a); return this; }
    Control OnMouseDown(Action a) { BindEvent("MouseDown", a); return this; }
    Control OnMouseUp(Action a) { BindEvent("MouseUp", a); return this; }
    Control OnWheel(Action a) { BindEvent("Wheel", a); return this; }
    Control OnFocus(Action a) { BindEvent("Focus", a); return this; }
    Control OnBlur(Action a) { BindEvent("Blur", a); return this; }
    Control OnKeyDown(Action a) { BindEvent("KeyDown", a); return this; }
    Control OnKeyUp(Action a) { BindEvent("KeyUp", a); return this; }
    Control OnLongPress(Action a) { BindEvent("LongPress", a); return this; }
    Control OnSwipe(Action a) { BindEvent("Swipe", a); return this; }
    Control OnDrag(Action a) { BindEvent("Drag", a); return this; }
    Control OnDrop(Action a) { BindEvent("Drop", a); return this; }
    Control OnResize(Action a) { Resize.Add(a); return this; }
    Control OnShow(Action a) { Show.Add(a); return this; }
    Control OnHide(Action a) { Hide.Add(a); return this; }

    /// Stable id for this control's common event bundle (see FireCommon).
    int CommonId() {
        if (commonId == 0) { commonId = WidgetId.Next(); }
        return commonId;
    }

    /// Registers the resolved box as a hit region and raises the common event
    /// bundle, so pointer/focus/keyboard events work on EVERY control, not just
    /// the handful that wire `On` themselves. Skipped when the widget wires its
    /// own events, and when nobody is listening -- an unused container must not
    /// take the pointer away from what is painted under it.
    void FireCommon(App app) {
        if (wiresOwnEvents) { return; }
        if (!On.Any()) { return; }
        if (bw <= 0 || bh <= 0) { return; }
        int id = this.CommonId();
        app.hitTester.Register(HitRegion.Create(id, bx, by, bw, bh, 0));
        On.Fire(app, id);
    }

    /// Effective text color: the CSS `styleColor` if set, else the fallback the
    /// widget resolves from its variant/theme. Text widgets call this.
    int StyleTextColor(int fallback) {
        if (styleColor != 0) { return styleColor; }
        return fallback;
    }

    /// Effective font size: the CSS `styleFontPx` if set, else the fallback.
    int StyleFontSize(int fallback) {
        if (styleFontPx != 0) { return styleFontPx; }
        return fallback;
    }

    /// Effective CSS transition duration (ms): the control's `transition`
    /// (styleTransitionMs) when set, else `fallback`. Widgets pass this to
    /// Ui.HoverLevelMs/PressLevelMs so the `transition` property actually
    /// drives how fast hover/press states cross-fade via App.AnimTo.
    int TransitionMs(int fallback) {
        if (computedStyle != null && computedStyle.transitionMs >= 0) {
            return computedStyle.transitionMs;
        }
        if (styleTransitionMs > 0) { return styleTransitionMs; }
        return fallback;
    }

    /// CSS type selector this control answers to. Defaults to its Kind, but a
    /// control whose Kind names a surface while the instance is only an
    /// invisible layout node overrides it, so stylesheet rules for the surface
    /// (padding, background, blur) do not apply to the layout node.
    virtual string StyleType() {
        return this.Kind().ToLower();
    }

    StyleBox ResolveStyle(App app, int state) {
        return this.ResolveStyleAs(app, this.StyleType(), Class, state);
    }

    StyleBox ResolveStyleAs(App app, string type, string cls, int state) {
        StyleBox box = Style.Full(app, type, cls, name, state);
        Style.Inline(box, this);
        computedStyle = box;
        computedStyleGen = app.bgThemeGen;
        computedStyleType = type;
        computedStyleClass = Class;
        computedStyleId = name;
        return box;
    }

    StyleBox ResolveEasedStyleAs(App app, int id, string type, string cls,
                                 bool disabled, bool selected) {
        StyleBox box = Style.EasedId(app, id, type, cls, name, disabled, selected);
        Style.Inline(box, this);
        computedStyle = box;
        computedStyleGen = app.bgThemeGen;
        computedStyleType = type;
        computedStyleClass = Class;
        computedStyleId = name;
        return box;
    }

    StyleBox ResolveEasedLatchedStyleAs(App app, int id, string type, string cls,
                                        bool disabled, int latched, int progress) {
        StyleBox off = Style.EasedStateId(app, id, type, cls, name, disabled, 0);
        StyleBox on = Style.EasedStateId(app, id, type, cls, name, disabled, latched);
        Style.Inline(off, this);
        Style.Inline(on, this);
        StyleBox box = StyleBox.Blend(off, on, progress);
        computedStyle = box;
        computedStyleGen = app.bgThemeGen;
        computedStyleType = type;
        computedStyleClass = Class;
        computedStyleId = name;
        return box;
    }

    StyleBox ResolvePart(App app, string part, string fallbackType, int state) {
        return this.ResolvePartAs(app, this.StyleType(), part,
                                  fallbackType, Class, state);
    }

    StyleBox ResolvePartAs(App app, string type, string part,
                           string fallbackType, string cls, int state) {
        return Style.Part(app, type, part, fallbackType, cls, name, state);
    }

    StyleBox ResolveEasedPartAs(App app, int id, string type, string part,
                                string fallbackType, string cls,
                                bool disabled, bool selected) {
        return Style.EasedPartId(app, id, type, part, fallbackType, cls, name,
                                 disabled, selected);
    }

    StyleBox ResolveEasedLatchedPartAs(App app, int id, string type, string part,
                                       string fallbackType, string cls,
                                       bool disabled, int latched, int progress) {
        StyleBox off = Style.EasedPartStateId(app, id, type, part, fallbackType,
                                              cls, name, disabled, 0);
        StyleBox on = Style.EasedPartStateId(app, id, type, part, fallbackType,
                                             cls, name, disabled, latched);
        return StyleBox.Blend(off, on, progress);
    }

    bool ComputedStyleCurrent(App app) {
        string type = this.StyleType();
        return computedStyle != null && computedStyleGen == app.bgThemeGen
            && computedStyleType == type && computedStyleClass == Class
            && computedStyleId == name;
    }

    int StyleWidth() {
        if (computedStyle == null) { return prefW; }
        return computedStyle.ClampW(computedStyle.WidthOr(prefW));
    }

    int StyleHeight() {
        if (computedStyle == null) { return prefH; }
        return computedStyle.ClampH(computedStyle.HeightOr(prefH));
    }

    int StylePadL() {
        if (computedStyle != null) { return computedStyle.PadLOr(padL); }
        return padL;
    }

    /// Top inset of the content box. Virtual because a container that draws
    /// its own chrome (a Card's title row) must keep room for it whatever the
    /// stylesheet says about padding.
    virtual int StylePadT() {
        if (computedStyle != null) { return computedStyle.PadTOr(padT); }
        return padT;
    }

    int StylePadR() {
        if (computedStyle != null) { return computedStyle.PadROr(padR); }
        return padR;
    }

    int StylePadB() {
        if (computedStyle != null) { return computedStyle.PadBOr(padB); }
        return padB;
    }

    /// CSS `display` of this node: 0 block (children dock), 1 flex (children are
    /// laid out along flex-direction), 2 none.
    int StyleDisplay() {
        if (computedStyle == null) { return 0; }
        return computedStyle.display;
    }

    /// Declared main/cross size inside a containing block of `avail` px, with
    /// percentages resolved and min/max applied; falls back to the measured
    /// preference (prefW/prefH) when the style declares no size.
    int StyleWidthIn(int avail) {
        if (computedStyle == null) { return prefW; }
        return computedStyle.ClampWIn(avail, computedStyle.WidthIn(avail, prefW));
    }

    int StyleHeightIn(int avail) {
        if (computedStyle == null) { return prefH; }
        return computedStyle.ClampHIn(avail, computedStyle.HeightIn(avail, prefH));
    }

    /// CSS `flex-grow` of this node (0 = keep its own size).
    int StyleGrow() {
        if (computedStyle == null) { return 0; }
        return computedStyle.grow;
    }

    int StyleMarL() { if (computedStyle == null) { return 0; } return computedStyle.marL; }
    int StyleMarT() { if (computedStyle == null) { return 0; } return computedStyle.marT; }
    int StyleMarR() { if (computedStyle == null) { return 0; } return computedStyle.marR; }
    int StyleMarB() { if (computedStyle == null) { return 0; } return computedStyle.marB; }

    int StyleGap() {
        if (computedStyle != null) { return computedStyle.GapOr(gap); }
        return gap;
    }

    bool StyleVisible() {
        if (!visible) { return false; }
        if (computedStyle == null) { return true; }
        return computedStyle.display != 2 && computedStyle.visible != 0;
    }

    /// Paints this node's CSS surface (shadow, background/gradient, border)
    /// into its resolved bounds, honouring styleRadius. Called by RenderTree
    /// before OnPaint, so every control gets uniform CSS styling and widgets'
    /// OnPaint only draw their own content on top. No-op when nothing is set,
    /// so existing widgets that paint their own surface are unaffected.
    void PaintStyleBox(App app) {
        if (wiresOwnEvents || styleSurfaceOwned) { return; }
        if (!this.ComputedStyleCurrent(app)) {
            this.ResolveStyle(app, Style.SNormal());
        }
        computedStyle.Paint(app, bx, by, bw, bh);
    }

    /// Fires the common event bundle for this node against `id`. Widgets call
    /// this once per frame after registering their hit region; equivalent to
    /// On.Fire(app, id) but keeps the call site uniform.
    void FireOn(App app, int id) {
        On.Fire(app, id);
    }

    Control Dock(int d) {
        dock = d;
        return this;
    }

    Control Prefer(int w, int h) {
        prefW = w;
        prefH = h;
        return this;
    }

    Control Place(int x, int y) {
        mx = x;
        my = y;
        return this;
    }

    Control Pad(int p) {
        padL = p;
        padT = p;
        padR = p;
        padB = p;
        return this;
    }

    Control Padding(int top, int right, int bottom, int left) {
        padT = top;
        padR = right;
        padB = bottom;
        padL = left;
        return this;
    }

    Control Gap(int g) {
        gap = g;
        return this;
    }

    Control SetShown(bool v) {
        visible = v;
        return this;
    }

    /// Appends a child (auto-docked). Returns the child so callers can keep a
    /// handle inline, e.g. `Button b = panel.Add(save)`.
    Control Add(Control c) {
        c.parent = this;
        children.Add(c);
        return c;
    }

    /// Fluent child append: adds `c` and returns THIS container (not the child),
    /// so several children can be chained - `panel.With(a).With(b).With(c)`. If
    /// this node has a flow layout (column/row) the child is auto-docked along
    /// the flow axis unless it opted into Grow().
    Control With(Control c) {
        if (layout != 0 && !c.grow) {
            if (layout == 2) { c.dock = 3; } else { c.dock = 1; }
        }
        c.parent = this;
        children.Add(c);
        return this;
    }

    /// Main-axis size to dock this child at, given the space its parent still
    /// has free: the stylesheet decides, so `width: 34%; min-width: 260px` on a
    /// docked pane behaves exactly as it would in a browser; a child without a
    /// styled size keeps its measured one.
    int DockSize(int avail, bool horizontal) {
        if (horizontal) { return this.StyleWidthIn(avail); }
        return this.StyleHeightIn(avail);
    }

    /// Marks this node to fill the remaining main-axis space of its flow parent.
    Control Grow() {
        grow = true;
        dock = 5;
        return this;
    }

    Control DockTop() { dock = 1; return this; }
    Control DockBottom() { dock = 2; return this; }
    Control DockLeft() { dock = 3; return this; }
    Control DockRight() { dock = 4; return this; }
    Control DockFill() { dock = 5; return this; }
    Control DockManual() { dock = 0; return this; }

    /// Fluent id setter, so a node built inline can still be located later with
    /// Find() or targeted by the designer/serializer.
    Control Named(string n) {
        name = n;
        computedStyle = null;
        return this;
    }

    int IndexOf(Control c) {
        int i = 0;
        while (i < children.Count) {
            if (children[i] == c) { return i; }
            i = i + 1;
        }
        return -1;
    }

    /// Detaches a child (no-op if not a child of this node).
    void Remove(Control c) {
        int idx = IndexOf(c);
        if (idx >= 0) {
            children.RemoveAt(idx);
            c.parent = null;
        }
    }

    /// Inserts a child at a position, clamped into range. Reparents `c`.
    void InsertAt(int idx, Control c) {
        int at = idx;
        if (at < 0) { at = 0; }
        if (at > children.Count) { at = children.Count; }
        c.parent = this;
        children.Insert(at, c);
    }

    /// Moves an existing child to a new index (for designer drag-reorder).
    void MoveChild(Control c, int to) {
        int idx = IndexOf(c);
        if (idx < 0) { return; }
        children.RemoveAt(idx);
        int at = to;
        if (at < 0) { at = 0; }
        if (at > children.Count) { at = children.Count; }
        children.Insert(at, c);
    }

    /// The deepest visible descendant whose resolved bounds contain the point,
    /// preferring later (top-most) children. Used for designer hit-selection.
    Control HitTest(int x, int y) {
        if (!this.StyleVisible()) { return null; }
        if (x < bx || y < by || x >= bx + bw || y >= by + bh) { return null; }
        int i = children.Count - 1;
        while (i >= 0) {
            Control hit = children[i].HitTest(x, y);
            if (hit != null) { return hit; }
            i = i - 1;
        }
        return this;
    }

    /// Depth-first search by name, including this node. Returns null if absent.
    Control Find(string n) {
        if (name == n) {
            return this;
        }
        int i = 0;
        while (i < children.Count) {
            Control r = children[i].Find(n);
            if (r != null) {
                return r;
            }
            i = i + 1;
        }
        return null;
    }

    int ChildCount() {
        return children.Count;
    }

    /// The handler bound to `evt`, or "" if none. Used by the event inspector.
    string GetHandler(string evt) {
        int i = 0;
        while (i < events.Count) {
            if (events[i].key == evt) { return events[i].val; }
            i = i + 1;
        }
        return "";
    }

    /// Binds (or rebinds) a handler identifier to `evt`.
    void SetHandler(string evt, string h) {
        int i = 0;
        while (i < events.Count) {
            if (events[i].key == evt) { events[i].val = h; return; }
            i = i + 1;
        }
        events.Add(new EventBinding(evt, h));
    }

    /// Lets a node set its preferred size from the theme, bottom-up (children
    /// first). Subclasses override OnMeasure. Runs before Arrange.
    void MeasureTree(App app) {
        this.ResolveStyle(app, Style.SNormal());
        if (!this.StyleVisible()) { return; }
        int i = 0;
        while (i < children.Count) {
            children[i].MeasureTree(app);
            i = i + 1;
        }
        OnMeasure(app);
    }

    static int FitSize(int requested, int available) {
        if (requested < 0) { return 0; }
        if (available < 0) { return 0; }
        if (requested > available) { return available; }
        return requested;
    }

    static int FitGap(int requested, int available) {
        if (requested < 0 || available <= 0) { return 0; }
        if (requested > available) { return available; }
        return requested;
    }

    /// Computes bounds for this node and, via docking, for its subtree.
    void Arrange(int px, int py, int pw, int ph) {
        if (pw < 0) { pw = 0; }
        if (ph < 0) { ph = 0; }
        bx = px;
        by = py;
        bw = pw;
        bh = ph;
        int innerPadL = this.StylePadL();
        int innerPadT = this.StylePadT();
        int innerPadR = this.StylePadR();
        int innerPadB = this.StylePadB();
        int innerGap = this.StyleGap();
        int cx = px + innerPadL;
        int cy = py + innerPadT;
        int cw = pw - innerPadL - innerPadR;
        int ch = ph - innerPadT - innerPadB;
        if (cw < 0) { cw = 0; }
        if (ch < 0) { ch = 0; }
        if (this.StyleDisplay() == 1) {
            this.ArrangeFlex(cx, cy, cw, ch, innerGap);
            return;
        }
        int i = 0;
        while (i < children.Count) {
            Control c = children[i];
            if (c.StyleVisible()) {
                if (c.dock == 1) {
                    int hh = Control.FitSize(c.DockSize(ch, false), ch);
                    c.Arrange(cx, cy, cw, hh);
                    int restH = ch - hh;
                    int gh = Control.FitGap(innerGap, restH);
                    cy = cy + hh + gh;
                    ch = restH - gh;
                } else if (c.dock == 2) {
                    int hh = Control.FitSize(c.DockSize(ch, false), ch);
                    c.Arrange(cx, cy + ch - hh, cw, hh);
                    int restH = ch - hh;
                    int gh = Control.FitGap(innerGap, restH);
                    ch = restH - gh;
                } else if (c.dock == 3) {
                    int ww = Control.FitSize(c.DockSize(cw, true), cw);
                    c.Arrange(cx, cy, ww, ch);
                    int restW = cw - ww;
                    int gw = Control.FitGap(innerGap, restW);
                    cx = cx + ww + gw;
                    cw = restW - gw;
                } else if (c.dock == 4) {
                    int ww = Control.FitSize(c.DockSize(cw, true), cw);
                    c.Arrange(cx + cw - ww, cy, ww, ch);
                    int restW = cw - ww;
                    int gw = Control.FitGap(innerGap, restW);
                    cw = restW - gw;
                } else if (c.dock == 5) {
                    c.Arrange(cx, cy, cw, ch);
                } else {
                    int ww = c.StyleWidth();
                    int hh = c.StyleHeight();
                    if (ww < 0) { ww = 0; }
                    if (hh < 0) { hh = 0; }
                    c.Arrange(cx + c.mx, cy + c.my, ww, hh);
                }
            }
            i = i + 1;
        }
    }

    /// Lays the children out as a CSS flex line inside this node's content box:
    /// each child takes its declared main size (px or % of the box) or, when it
    /// declares none, its measured preference; `flex-grow` shares whatever is
    /// left; `justify-content` places the remainder and `align-items` sizes the
    /// cross axis (stretch by default). Margins and `gap` are honoured, and a
    /// line that overflows is shrunk proportionally instead of spilling out.
    void ArrangeFlex(int cx, int cy, int cw, int ch, int gapPx) {
        bool row = true;
        if (computedStyle != null && computedStyle.flexDir == 1) { row = false; }
        int mainBox = cw;
        int crossBox = ch;
        if (!row) { mainBox = ch; crossBox = cw; }

        List<Control> items = new List<Control>();
        int i = 0;
        while (i < children.Count) {
            if (children[i].StyleVisible()) { items.Add(children[i]); }
            i = i + 1;
        }
        int n = items.Count;
        if (n == 0) { return; }

        List<int> sizes = new List<int>();
        int used = 0;
        int totalGrow = 0;
        i = 0;
        while (i < n) {
            Control c = items[i];
            int sz;
            if (row) { sz = c.StyleWidthIn(cw); } else { sz = c.StyleHeightIn(ch); }
            if (sz < 0) { sz = 0; }
            sizes.Add(sz);
            used = used + sz + c.MarMain(row);
            totalGrow = totalGrow + c.StyleGrow();
            i = i + 1;
        }
        int gaps = 0;
        if (n > 1) { gaps = (n - 1) * gapPx; }
        int free = mainBox - used - gaps;

        if (free > 0 && totalGrow > 0) {
            // Two passes: share the free space by flex-grow, clamp the results
            // to max-width/height, then hand what the clamped items gave back
            // to the ones that can still take it.
            int pass = 0;
            while (pass < 2 && free > 0) {
                int share = free;
                int growable = 0;
                i = 0;
                while (i < n) {
                    int g = items[i].StyleGrow();
                    if (g > 0) { growable = growable + g; }
                    i = i + 1;
                }
                if (growable == 0) { pass = 2; }
                else {
                    int taken = 0;
                    i = 0;
                    while (i < n) {
                        int g = items[i].StyleGrow();
                        if (g > 0) {
                            int want = sizes[i] + share * g / growable;
                            int got = want;
                            if (row) { got = items[i].StyleClampW(cw, want); }
                            else { got = items[i].StyleClampH(ch, want); }
                            taken = taken + got - sizes[i];
                            sizes[i] = got;
                        }
                        i = i + 1;
                    }
                    free = free - taken;
                    if (taken == 0) { pass = 2; }
                    pass = pass + 1;
                }
            }
            if (free < 0) { free = 0; }
        } else if (free < 0 && used > 0) {
            // Overflowing line: shrink the items proportionally (flex-shrink: 1).
            int room = mainBox - gaps;
            if (room < 0) { room = 0; }
            int placedSize = 0;
            i = 0;
            while (i < n) {
                int sz = sizes[i] * room / used;
                if (i == n - 1) { sz = room - placedSize; }
                if (sz < 0) { sz = 0; }
                placedSize = placedSize + sz;
                sizes[i] = sz;
                i = i + 1;
            }
            free = 0;
        }

        int offset = 0;
        int between = gapPx;
        int justify = 0;
        if (computedStyle != null) { justify = computedStyle.justify; }
        if (justify == 1) { offset = free / 2; }
        else if (justify == 2) { offset = free; }
        else if (justify == 3 && n > 1) { between = between + free / (n - 1); }
        else if (justify == 4) {
            int slots = n + 1;
            offset = free / slots;
            between = between + offset;
        }

        int align = 0;
        if (computedStyle != null) { align = computedStyle.alignItems; }
        int pos = offset;
        i = 0;
        while (i < n) {
            Control c = items[i];
            int main = sizes[i];
            int crossAvail = crossBox - c.MarCross(row);
            if (crossAvail < 0) { crossAvail = 0; }
            int cross;
            if (row) { cross = c.StyleHeightIn(ch); } else { cross = c.StyleWidthIn(cw); }
            if (align == 0 || cross <= 0) { cross = crossAvail; }
            if (cross > crossAvail) { cross = crossAvail; }
            int crossPos = 0;
            if (align == 2) { crossPos = (crossAvail - cross) / 2; }
            else if (align == 3) { crossPos = crossAvail - cross; }
            if (row) {
                c.Arrange(cx + pos + c.StyleMarL(),
                          cy + crossPos + c.StyleMarT(), main, cross);
            } else {
                c.Arrange(cx + crossPos + c.StyleMarL(),
                          cy + pos + c.StyleMarT(), cross, main);
            }
            pos = pos + main + c.MarMain(row) + between;
            i = i + 1;
        }
    }

    /// Applies this node's min/max-width (or -height) to `v`, resolving
    /// percentage bounds against a containing block of `avail`.
    int StyleClampW(int avail, int v) {
        if (computedStyle == null) { return v; }
        return computedStyle.ClampWIn(avail, v);
    }

    int StyleClampH(int avail, int v) {
        if (computedStyle == null) { return v; }
        return computedStyle.ClampHIn(avail, v);
    }

    /// Total margin along / across a flex line.
    int MarMain(bool row) {
        if (row) { return this.StyleMarL() + this.StyleMarR(); }
        return this.StyleMarT() + this.StyleMarB();
    }

    int MarCross(bool row) {
        if (row) { return this.StyleMarT() + this.StyleMarB(); }
        return this.StyleMarL() + this.StyleMarR();
    }

    /// Draws this node's own visuals. Base draws nothing; subclasses override.
    virtual void OnPaint(App app) {
    }

    /// Draws this control's floating/overlay layer (popup menus, option lists,
    /// tooltips) during the deferred overlay pass, so it paints above ALL page
    /// content and registers the top-most hit regions -- never occluded by, and
    /// never leaking clicks through to, widgets drawn after it. Base draws
    /// nothing; a floating widget overrides this and, while open, defers itself
    /// with `app.AddOverlay(OverlayPopup.Host(this))` instead of painting its
    /// popup inline during the main pass.
    virtual void OnPaintOverlay(App app) {
    }

    /// Sets prefW/prefH from content/theme. Base is a no-op; leaves override.
    virtual void OnMeasure(App app) {
    }

    // --- Designer / serialization model (uniform, cast-free via virtuals) ---

    /// Stable type tag used to reconstruct this node (see ControlFactory). Every
    /// concrete widget overrides it; the base tag is only a fallback.
    virtual string Kind() {
        return "Control";
    }

    /// Widget-specific editable properties for the inspector and serializer.
    /// Common geometry (dock/pad/gap/size/pos/name) is handled by Serialize, so
    /// this returns only the properties unique to the widget. Base has none.
    virtual List<PropSpec> Props() {
        return new List<PropSpec>();
    }

    /// The common event names every control exposes (pointer/focus/keyboard/
    /// touch/drag/lifecycle), in inspector order. Widgets prepend these to their
    /// own semantic events in Events().
    static List<string> CommonEvents() {
        List<string> e = new List<string>();
        e.Add("Click");
        e.Add("DoubleClick");
        e.Add("RightClick");
        e.Add("MouseDown");
        e.Add("MouseUp");
        e.Add("Enter");
        e.Add("Leave");
        e.Add("Move");
        e.Add("Wheel");
        e.Add("Focus");
        e.Add("Blur");
        e.Add("KeyDown");
        e.Add("KeyUp");
        e.Add("KeyPress");
        e.Add("Tap");
        e.Add("LongPress");
        e.Add("Swipe");
        e.Add("DragStart");
        e.Add("Drag");
        e.Add("Drop");
        e.Add("Resize");
        e.Add("Show");
        e.Add("Hide");
        return e;
    }

    /// Declared event names for the designer's event inspector. Base returns the
    /// common bundle; widgets override to append their own semantic events (and
    /// still include CommonEvents()).
    virtual List<string> Events() {
        return Control.CommonEvents();
    }

    /// Subscribes a resolved Action to the named event. The base maps the common
    /// bundle (Click/Enter/.../Drop) onto `On`; widgets override to also route
    /// their own semantic events (Change/Submit/RowClick/...) to the right
    /// UiEvent field, then call the base for the common set. Used by the JSON
    /// loader to attach `on<Event>` handlers resolved through the registry.
    virtual void BindEvent(string evt, Action a) {
        On.AddByName(evt, a);
    }

    /// Reads a property by key as text. Base knows nothing; widgets override for
    /// the keys they publish in Props().
    virtual string GetProp(string key) {
        return "";
    }

    /// Writes a property by key from text. Base ignores; widgets override.
    virtual void SetProp(string key, string val) {
    }

    /// Lays out and paints this subtree inside `area`: the single call a host
    /// needs to hand a rectangle to a retained component (measure, dock, paint).
    void RenderInside(App app, Rect area) {
        this.MeasureTree(app);
        this.Arrange(area.x, area.y, area.width, area.height);
        this.RenderTree(app);
    }

    /// Renders the subtree: self, then children clipped to this node's box so a
    /// child cannot paint outside its parent (native clip stack). Named
    /// RenderTree (not Paint) because several widgets already declare a static
    /// Paint and the compiler resolves method calls by name only.
    void RenderTree(App app) {
        if (!this.ComputedStyleCurrent(app)) {
            this.ResolveStyle(app, Style.SNormal());
        }
        if (!this.StyleVisible()) {
            if (lastVisible && Hide.Count() > 0) { Hide.Raise(); }
            lastVisible = false;
            return;
        }
        if (!lastVisible && everLaidOut && Show.Count() > 0) { Show.Raise(); }
        lastVisible = true;
        PaintStyleBox(app);
        OnPaint(app);
        this.FireCommon(app);
        if (Paint.Count() > 0) { Paint.Raise(); }
        if (everLaidOut && (bw != lastBw || bh != lastBh) && Resize.Count() > 0) {
            Resize.Raise();
        }
        lastBw = bw;
        lastBh = bh;
        everLaidOut = true;
        if (children.Count > 0) {
            app.canvas.PushClip(bx, by, bw, bh);
            int i = 0;
            while (i < children.Count) {
                children[i].RenderTree(app);
                i = i + 1;
            }
            app.canvas.PopClip();
        }
    }
}

/// Root of a retained-mode UI: the window itself as a component. Owns the App
/// and drives the frame loop, laying out and rendering the whole tree each
/// frame beneath the title-bar chrome.
class Form : Control {
    App app;
    string title;

    /// Builds the backing window + app. The tree can be assembled and laid out
    /// before Run() is called.
    static Form Create(string title, int width, int height) {
        Form f = new Form();
        f.InitControl(title, 5);
        f.title = title;
        f.app = App.Create(title, width, height);
        return f;
    }

    static Form CreateDark(string title, int width, int height) {
        Form f = Form.Create(title, width, height);
        f.app.SetDark(true);
        return f;
    }

    App GetApp() {
        return app;
    }

    /// Measures, lays out and paints the whole tree once into the current frame,
    /// below the chrome. Exposed so a hand-rolled loop can compose it.
    void RenderFrame(App a) {
        int top = a.ContentTop();
        int W = a.canvas.Width();
        int H = a.canvas.Height();
        // Paint the active skin's themed backdrop (gradient + glass wallpaper,
        // or a flat fill) behind the tree, so frosted-glass panels blur real
        // colour instead of a flat clear -- identical to how the IDE/gallery
        // set up their windows. Slot 0 is the conventional backdrop cache slot.
        a.RenderBackground(0, top, W, H - top, 0);
        this.MeasureTree(a);
        this.Arrange(0, top, W, H - top);
        this.RenderTree(a);
    }

    /// Standard retained-mode loop: process events, lay out, render tree, draw
    /// chrome, present.
    void Run() {
        app.Show();
        while (app.isRunning) {
            if (!app.ProcessEvent()) {
                break;
            }
            if (!app.needsRedraw) {
                continue;
            }
            app.BeginFrame();
            RenderFrame(app);
            app.RenderChrome(title);
            app.PresentFrame();
        }
    }
}

/// Named dock values, so trees read `.Dock(Dock.Top())` instead of a magic
/// number. (The language has no static-field constants, hence static methods.)
class Dock {
    static int Manual() { return 0; }
    static int Top() { return 1; }
    static int Bottom() { return 2; }
    static int Left() { return 3; }
    static int Right() { return 4; }
    static int Fill() { return 5; }
}
