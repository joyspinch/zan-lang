using System;

namespace Gui;

/// 供设计器/序列化器使用的一个事件处理器绑定：事件名映射到
/// 处理器标识符。用单个实体取代并行的键/值列表。
class EventBinding {
    string key;
    string val;

    EventBinding(string key, string val) {
        this.key = key;
        this.val = val;
    }
}

/// 保留模式组件树（与即时模式控件共存）。
///
/// 每个节点都是一个 `Control`：有稳定的 `name`、父节点、有序的
/// 子节点列表、停靠提示和已解析的边界矩形。容器用 `Add` 追加
/// 子节点；任何节点都可用 `Find(name)` 定位后代。
/// 布局是 WinForms 风格的停靠（见 `Arrange`）：停靠的子节点吸附到
/// 边缘并按插入顺序占用空间，`Fill` 子节点占据剩余部分，
/// `Manual` 子节点位于父节点内的显式偏移处。绘制是
/// 多态的——子类重写 `OnPaint`，框架通过 `Paint` 递归，
/// 把每个子树裁剪到父节点的矩形内，内容不会
/// 溢出（复用原生裁剪栈）。
///
/// 注意：基类方法名刻意不寻常（Paint/Arrange/
/// MeasureTree/InitControl/OnPaint/OnMeasure），以免与
/// 继承 Control 的控件自身的方法冲突——编译器仅按名称
/// 解析调用（无重载），因此子类若以不同签名复用基类名称
/// 会编译出错。
class Control {
    string name;
    /// 0 手动，1 顶部，2 底部，3 左侧，4 右侧，5 填充。
    int dock;
    /// 通过 With() 添加的子节点的自动流式布局：0 无，1 列，2 行。
    /// 容器（见 Panel.Column/Row）设置此项，使每个 With() 子节点
    /// 自动沿流式布局轴停靠。
    int layout;
    /// 为 true 时，此节点应增长以填满其流式父节点的
    /// 剩余主轴空间（dock == fill），覆盖流式布局的默认停靠。
    bool grow;
    /// 停靠时使用的首选主轴尺寸（top/bottom 为高度，
    /// left/right 为宽度）。对 Fill 子节点忽略。控件的 OnMeasure
    /// 通常根据主题设置这些值。
    int prefW;
    int prefH;
    /// dock == 0 时在父内容框内的手动偏移。
    int mx;
    int my;
    int padL;
    int padT;
    int padR;
    int padB;
    /// 由 Pad()/Padding() 设置：调用方固定了内边距，因此控件的
    /// OnMeasure 不得用其主题默认值覆盖它。
    bool padSet;
    /// 由 Prefer()（以及 UiDoc 的 `width`/`height`）设置：调用方固定了
    /// 首选尺寸，因此根据子节点自测量的容器
    /// 会保留给定的那个轴。
    bool prefSet;
    /// Sizes a document declares (UiDoc `width`/`height`/`gap`/`pad`/`x`/`y`)
    /// are logical pixels, written as they look at 100%. They are kept apart
    /// from the resolved ones and converted at measure time: taken as physical
    /// pixels, a row declaring 38 stays 38 tall while the text inside it grows
    /// with the theme, so at 150% every row overlaps the next.
    int logW;
    int logH;
    int logGap;
    int logPad;
    int logX;
    int logY;
    bool logPlaceSet;
    int gap;
    bool visible;
    /// 画布坐标下的已解析边界（由 Arrange 设置）。
    int bx;
    int by;
    int bw;
    int bh;
    weak Control parent;
    List<Control> children;
    /// 供设计器/序列化器使用的事件处理器绑定：把事件名
    /// （见 Events()）映射到处理器标识符。未绑定时为空。
    List<EventBinding> events;
    /// 每个控件通用的事件包（指针/焦点/键盘/触摸/拖拽），
    /// 所有控件继承。拥有稳定 id 的交互控件
    /// 自行接线（注册命中区域后调用 On.Fire(app, id)）；
    /// 其余控件由 RenderTree 通过 FireCommon 接线。
    WidgetEvents On;
    /// 为不自持 id 的控件（容器和仅显示控件）提供支撑 `On` 的稳定 id。
    /// 首次使用时分配；0 = 从未需要。
    int commonId;
    /// 由自行注册命中区域并调用 On.Fire 的控件（Button、Input 等）设置，
    /// 这样 RenderTree 就不会在另一个 id 上第二次
    /// 触发该事件包。
    bool wiresOwnEvents;
    /// 由 RenderTree 触发的生命周期事件：Paint 在节点每帧绘制时触发，
    /// Resize 在解析尺寸变化时触发，Show/Hide 在可见性翻转时触发。
    UiEvent Paint;
    UiEvent Resize;
    UiEvent Show;
    UiEvent Hide;
    int lastBw;
    int lastBh;
    bool lastVisible;
    bool everLaidOut;
    /// 此控件绑定的可选点分状态路径（JSON `bind`），
    /// 由 UiDoc 用于将控件值与状态实体同步。空 = 无。
    string bindPath;
    /// 绑定使用的可选控件属性。为空时自动选择
    /// 控件的规范 `value`/`text` 属性。
    string bindProp;
    string bindSnapshot;
    /// 可选样式类（JSON `class`），供 StyleSheet 通过 `.class` 选择器
    /// 把声明级联到此控件。空 = 无。
    /// 以空格分隔的 CSS 类：`btn.Class = "primary small";`（直接赋值，
    /// 无 setter）——控件拥有的每个视觉变体都对应其中一个类。
    string Class;
    /// 双向禁用标志，沿树向下继承：`grp.Disabled = vm.busy;`
    /// 会置灰并禁用整个子树（见 IsDisabled）。
    Binding<bool> Disabled;
    StyleBox computedStyle;
    int computedStyleGen;
    string computedStyleType;
    string computedStyleClass;
    string computedStyleId;
    bool styleSurfaceOwned;

    // --- 类 CSS 样式层（全 0 = 未设置）。PaintStyleBox 对表面生效，
    // 文本控件对颜色/字体生效。可通过流式的
    // Bg/Gradient/Radius/Border/Shadow/TextColor/FontPx 辅助方法设置，或从
    // StyleSheet/皮肤级联。颜色打包为 0xAARRGGBB 整数（同 Theme）。
    int styleBg;
    int styleBgTo;
    int styleRadius;
    int styleBorderColor;
    int styleBorderWidth;
    int styleShadow;
    int styleShadowDy;
    int styleColor;
    int styleFontPx;
    int styleTransitionMs;

    /// 所有子类在工厂/构造函数中调用的基础初始化方法。
    void InitControl(string n, int d) {
        name = n;
        dock = d;
        prefW = 0;
        prefH = 0;
        mx = 0;
        my = 0;
        paneMin = 0;
        paneMax = 0;
        padL = 0;
        padT = 0;
        padR = 0;
        padB = 0;
        padSet = false;
        prefSet = false;
        logW = 0;
        logH = 0;
        logGap = 0 - 1;
        logPad = 0 - 1;
        logX = 0;
        logY = 0;
        logPlaceSet = false;
        gap = 0;
        visible = true;
        bx = 0;
        by = 0;
        bw = 0;
        bh = 0;
        parent = null;
        children = new List<Control>();
        events = new List<EventBinding>();
        On = new WidgetEvents();
        commonId = 0;
        wiresOwnEvents = false;
        Paint = new UiEvent();
        Resize = new UiEvent();
        Show = new UiEvent();
        Hide = new UiEvent();
        lastBw = 0;
        lastBh = 0;
        lastVisible = false;
        everLaidOut = false;
        layout = 0;
        grow = false;
        bindPath = "";
        bindProp = "";
        bindSnapshot = "";
        Class = "";
        Disabled = false;
        computedStyle = null;
        computedStyleGen = 0 - 1;
        computedStyleType = "";
        computedStyleClass = "";
        computedStyleId = "";
        styleSurfaceOwned = false;
        styleBg = 0;
        styleBgTo = 0;
        styleRadius = 0;
        styleBorderColor = 0;
        styleBorderWidth = 0;
        styleShadow = 0;
        styleShadowDy = 0;
        styleColor = 0;
        styleFontPx = 0;
        styleTransitionMs = 0;
    }

    // --- 类 CSS 流式样式设置器（可链式调用）。名称在整个控件集合中唯一，
    // 不会与子类方法冲突。---
    Control Bg(int c) { styleBg = c; styleBgTo = 0; computedStyle = null; return this; }
    Control Gradient(int top, int bottom) { styleBg = top; styleBgTo = bottom; computedStyle = null; return this; }
    Control Radius(int r) { styleRadius = r; computedStyle = null; return this; }
    Control Border(int color, int w) { styleBorderColor = color; styleBorderWidth = w; computedStyle = null; return this; }
    Control Shadow(int color, int dy) { styleShadow = color; styleShadowDy = dy; computedStyle = null; return this; }
    Control TextColor(int c) { styleColor = c; computedStyle = null; return this; }
    Control FontPx(int px) { styleFontPx = px; computedStyle = null; return this; }
    Control Transition(int ms) { styleTransitionMs = ms; computedStyle = null; return this; }

    // --- 可链式事件订阅（BindEvent 的类 C# 替代写法；
    // `btn.OnClick(Handler)` 读起来像 `btn.Click += Handler`）。每个都追加
    // 一个处理器并返回 THIS，保持设置流程连贯。---
    Control OnClick(Action a) { BindEvent("Click", a); return this; }
    Control OnDoubleClick(Action a) { BindEvent("DoubleClick", a); return this; }
    Control OnRightClick(Action a) { BindEvent("RightClick", a); return this; }
    Control OnChange(Action a) { BindEvent("Change", a); return this; }
    Control OnEnter(Action a) { BindEvent("Enter", a); return this; }
    Control OnLeave(Action a) { BindEvent("Leave", a); return this; }
    Control OnMouseDown(Action a) { BindEvent("MouseDown", a); return this; }
    Control OnMouseUp(Action a) { BindEvent("MouseUp", a); return this; }
    Control OnWheel(Action a) { BindEvent("Wheel", a); return this; }
    Control OnFocus(Action a) { BindEvent("Focus", a); return this; }
    Control OnBlur(Action a) { BindEvent("Blur", a); return this; }
    Control OnKeyDown(Action a) { BindEvent("KeyDown", a); return this; }
    Control OnKeyUp(Action a) { BindEvent("KeyUp", a); return this; }
    Control OnLongPress(Action a) { BindEvent("LongPress", a); return this; }
    Control OnSwipe(Action a) { BindEvent("Swipe", a); return this; }
    Control OnDrag(Action a) { BindEvent("Drag", a); return this; }
    Control OnDrop(Action a) { BindEvent("Drop", a); return this; }
    Control OnResize(Action a) { Resize.Add(a); return this; }
    Control OnShow(Action a) { Show.Add(a); return this; }
    Control OnHide(Action a) { Hide.Add(a); return this; }

    /// 当控件自身被禁用或位于被禁用的祖先之下时为 true，
    /// 控件正是据此解析其 `:disabled` 样式及其
    /// （缺失的）交互——禁用一个组即禁用了它的命令，
    /// 而无需逐个修改。
    bool IsDisabled() {
        if (Disabled.Get()) { return true; }
        if (parent != null) { return parent.IsDisabled(); }
        return false;
    }

    /// 此控件通用事件包的稳定 id（见 FireCommon）。
    int CommonId() {
        if (commonId == 0) { commonId = WidgetId.Next(); }
        return commonId;
    }

    /// 把已解析的矩形注册为命中区域并触发通用事件包，
    /// 使指针/焦点/键盘事件对所有控件生效，而不只是
    /// 自行接线 `On` 的那几个。控件自行接线
    /// 自己的事件或无人监听时跳过——未使用的容器不能
    /// 抢走画在它下面的内容的指针。
    void FireCommon(App app) {
        if (wiresOwnEvents) { return; }
        if (!On.Any()) { return; }
        if (bw <= 0 || bh <= 0) { return; }
        int id = this.CommonId();
        app.hitTester.Register(new HitRegion(id, bx, by, bw, bh, 0));
        On.Fire(app, id);
    }

    /// 生效的文本颜色：设置了 CSS `styleColor` 则用它，否则用控件
    /// 从其变体/主题解析的回退值。文本控件调用此方法。
    int StyleTextColor(int fallback) {
        if (styleColor != 0) { return styleColor; }
        return fallback;
    }

    /// 生效的字体大小：设置了 CSS `styleFontPx` 则用它，否则用回退值。
    int StyleFontSize(int fallback) {
        if (styleFontPx != 0) { return styleFontPx; }
        return fallback;
    }

    /// 生效的 CSS 过渡时长（毫秒）：控件的 `transition`
    /// （styleTransitionMs）已设置时用它，否则用 `fallback`。控件把它传给
    /// Ui.HoverLevelMs/PressLevelMs，使 `transition` 属性真正
    /// 决定悬停/按下状态通过 App.AnimTo 交叉淡化的速度。
    int TransitionMs(int fallback) {
        if (computedStyle != null && computedStyle.transitionMs >= 0) {
            return computedStyle.transitionMs;
        }
        if (styleTransitionMs > 0) { return styleTransitionMs; }
        return fallback;
    }

    /// 此控件响应的 CSS 类型选择器。默认为其 Kind，但
    /// Kind 指代表面而实例仅是布局节点的控件会覆盖它，
    /// 这样针对表面的样式表规则
    /// （内边距、背景、模糊）不会作用于布局节点。
    virtual string StyleType() {
        return this.Kind().ToLower();
    }

    StyleBox ResolveStyle(App app, int state) {
        return this.ResolveStyleAs(app, this.StyleType(), Class, state);
    }

    StyleBox ResolveStyleAs(App app, string type, string cls, int state) {
        StyleBox box = Style.Full(app, type, cls, name, state);
        Style.Inline(box, this);
        computedStyle = box;
        computedStyleGen = app.bgThemeGen;
        computedStyleType = type;
        computedStyleClass = Class;
        computedStyleId = name;
        return box;
    }

    StyleBox ResolveEasedStyleAs(App app, int id, string type, string cls,
                                 bool disabled, bool selected) {
        StyleBox box = Style.EasedId(app, id, type, cls, name, disabled, selected);
        Style.Inline(box, this);
        computedStyle = box;
        computedStyleGen = app.bgThemeGen;
        computedStyleType = type;
        computedStyleClass = Class;
        computedStyleId = name;
        return box;
    }

    StyleBox ResolveEasedLatchedStyleAs(App app, int id, string type, string cls,
                                        bool disabled, int latched, int progress) {
        StyleBox off = Style.EasedStateId(app, id, type, cls, name, disabled, 0);
        StyleBox on = Style.EasedStateId(app, id, type, cls, name, disabled, latched);
        Style.Inline(off, this);
        Style.Inline(on, this);
        StyleBox box = StyleBox.Blend(off, on, progress);
        computedStyle = box;
        computedStyleGen = app.bgThemeGen;
        computedStyleType = type;
        computedStyleClass = Class;
        computedStyleId = name;
        return box;
    }

    StyleBox ResolvePart(App app, string part, string fallbackType, int state) {
        return this.ResolvePartAs(app, this.StyleType(), part,
                                  fallbackType, Class, state);
    }

    StyleBox ResolvePartAs(App app, string type, string part,
                           string fallbackType, string cls, int state) {
        return Style.Part(app, type, part, fallbackType, cls, name, state);
    }

    StyleBox ResolveEasedPartAs(App app, int id, string type, string part,
                                string fallbackType, string cls,
                                bool disabled, bool selected) {
        return Style.EasedPartId(app, id, type, part, fallbackType, cls, name,
                                 disabled, selected);
    }

    StyleBox ResolveEasedLatchedPartAs(App app, int id, string type, string part,
                                       string fallbackType, string cls,
                                       bool disabled, int latched, int progress) {
        StyleBox off = Style.EasedPartStateId(app, id, type, part, fallbackType,
                                              cls, name, disabled, 0);
        StyleBox on = Style.EasedPartStateId(app, id, type, part, fallbackType,
                                             cls, name, disabled, latched);
        return StyleBox.Blend(off, on, progress);
    }

    bool ComputedStyleCurrent(App app) {
        string type = this.StyleType();
        return computedStyle != null && computedStyleGen == app.bgThemeGen
            && computedStyleType == type && computedStyleClass == Class
            && computedStyleId == name;
    }

    int StyleWidth() {
        if (computedStyle == null) { return prefW; }
        return computedStyle.ClampW(computedStyle.WidthOr(prefW));
    }

    int StyleHeight() {
        if (computedStyle == null) { return prefH; }
        return computedStyle.ClampH(computedStyle.HeightOr(prefH));
    }

    /// 内容框的左侧内边距。显式的 Pad()/Padding() 优先于
    /// 解析样式携带的主题默认值（自由画布根节点将其固定为 0）；
    /// 未调用时由样式表决定。
    int StylePadL() {
        if (padSet) { return padL; }
        if (computedStyle != null) { return computedStyle.PadLOr(padL); }
        return padL;
    }

    /// 内容框的顶部内边距。之所以是虚方法，是因为绘制自身
    /// 装饰的容器（如 Card 的标题行）无论样式表如何规定
    /// 内边距都必须为此预留空间。
    virtual int StylePadT() {
        if (padSet) { return padT; }
        if (computedStyle != null) { return computedStyle.PadTOr(padT); }
        return padT;
    }

    int StylePadR() {
        if (padSet) { return padR; }
        if (computedStyle != null) { return computedStyle.PadROr(padR); }
        return padR;
    }

    int StylePadB() {
        if (padSet) { return padB; }
        if (computedStyle != null) { return computedStyle.PadBOr(padB); }
        return padB;
    }

    /// 此节点的 CSS `display`：0 block（子节点停靠），1 flex（子节点沿
    /// flex-direction 排列），2 none。
    int StyleDisplay() {
        if (computedStyle == null) { return 0; }
        return computedStyle.display;
    }

    /// 在 `avail` 像素的包含块内声明的主/交叉轴尺寸，
    /// 百分比已解析、min/max 已应用；样式未声明尺寸时
    /// 回退到测量偏好（prefW/prefH）。
    int StyleWidthIn(int avail) {
        if (computedStyle == null) { return prefW; }
        return computedStyle.ClampWIn(avail, computedStyle.WidthIn(avail, prefW));
    }

    int StyleHeightIn(int avail) {
        if (computedStyle == null) { return prefH; }
        return computedStyle.ClampHIn(avail, computedStyle.HeightIn(avail, prefH));
    }

    /// 样式表声明了宽度/高度（如 `button.large` 这样的尺寸类）时为 true，
    /// 区别于测量偏好。停靠在行中的子节点
    /// 若声明了交叉轴尺寸则保留它（并居中），而不是
    /// 被拉伸到行高。
    bool StyleDeclaresWidth() {
        return computedStyle != null && computedStyle.width >= 0;
    }

    bool StyleDeclaresHeight() {
        return computedStyle != null && computedStyle.height >= 0;
    }

    /// 此节点的 CSS `flex-grow`（0 = 保持自身尺寸）。
    int StyleGrow() {
        if (computedStyle == null) { return 0; }
        return computedStyle.grow;
    }

    int StyleMarL() { if (computedStyle == null) { return 0; } return computedStyle.marL; }
    int StyleMarT() { if (computedStyle == null) { return 0; } return computedStyle.marT; }
    int StyleMarR() { if (computedStyle == null) { return 0; } return computedStyle.marR; }
    int StyleMarB() { if (computedStyle == null) { return 0; } return computedStyle.marB; }

    int StyleGap() {
        if (computedStyle != null) { return computedStyle.GapOr(gap); }
        return gap;
    }

    bool StyleVisible() {
        if (!visible) { return false; }
        if (computedStyle == null) { return true; }
        return computedStyle.display != 2 && computedStyle.visible != 0;
    }

    /// 把此节点的 CSS 表面（阴影、背景/渐变、边框）
    /// 绘制进其已解析边界，遵循 styleRadius。由 RenderTree 在
    /// OnPaint 之前调用，使所有控件获得统一的 CSS 样式，控件的
    /// OnPaint 只需在之上绘制自己的内容。未设置任何样式时为空操作，
    /// 因此自行绘制表面的既有控件不受影响。
    void PaintStyleBox(App app) {
        if (wiresOwnEvents || styleSurfaceOwned) { return; }
        if (!this.ComputedStyleCurrent(app)) {
            this.ResolveStyle(app, Style.SNormal());
        }
        computedStyle.Paint(app, bx, by, bw, bh);
    }

    /// 针对 `id` 触发此节点的通用事件包。控件在
    /// 注册命中区域后每帧调用一次；等价于
    /// On.Fire(app, id)，但调用点更统一。
    void FireOn(App app, int id) {
        On.Fire(app, id);
    }

    Control Dock(int d) {
        dock = d;
        return this;
    }

    Control Prefer(int w, int h) {
        prefW = w;
        prefH = h;
        prefSet = true;
        return this;
    }

    Control Place(int x, int y) {
        mx = x;
        my = y;
        return this;
    }

    Control Pad(int p) {
        padL = p;
        padT = p;
        padR = p;
        padB = p;
        padSet = true;
        return this;
    }

    Control Padding(int top, int right, int bottom, int left) {
        padT = top;
        padR = right;
        padB = bottom;
        padL = left;
        padSet = true;
        return this;
    }

    Control Gap(int g) {
        gap = g;
        return this;
    }

    Control SetShown(bool v) {
        visible = v;
        return this;
    }

    /// 追加一个子节点（自动停靠）。返回该子节点，调用方可
    /// 内联持有引用，如 `Button b = panel.Add(save)`。
    Control Add(Control c) {
        c.parent = this;
        children.Add(c);
        return c;
    }

    /// 流式子节点追加：添加 `c` 并返回 THIS 容器（而非子节点），
    /// 因此多个子节点可链式追加——`panel.With(a).With(b).With(c)`。若
    /// 此节点有流式布局（列/行），子节点会自动沿
    /// 流式轴停靠，除非它选择了 Grow()。
    Control With(Control c) {
        if (layout != 0 && !c.grow) {
            if (layout == 2) { c.dock = 3; } else { c.dock = 1; }
        }
        c.parent = this;
        children.Add(c);
        return this;
    }

    /// 给定父节点剩余空间时，此子节点停靠的主轴尺寸：
    /// 由样式表决定，因此停靠面板上的 `width: 34%; min-width: 260px`
    /// 与浏览器中的行为完全一致；没有样式尺寸的子节点
    /// 保持其测量尺寸。
    int DockSize(int avail, bool horizontal) {
        if (horizontal) { return this.StyleWidthIn(avail); }
        return this.StyleHeightIn(avail);
    }

    /// 标记此节点填满其流式父节点的剩余主轴空间。
    Control Grow() {
        grow = true;
        dock = 5;
        return this;
    }

    Control DockTop() { dock = 1; return this; }
    Control DockBottom() { dock = 2; return this; }
    Control DockLeft() { dock = 3; return this; }
    Control DockRight() { dock = 4; return this; }
    Control DockFill() { dock = 5; return this; }
    Control DockManual() { dock = 0; return this; }

    /// 流式 id 设置器，内联构建的节点之后仍可用
    /// Find() 定位，或被设计器/序列化器定位。
    Control Named(string n) {
        name = n;
        computedStyle = null;
        return this;
    }

    int IndexOf(Control c) {
        for (int i = 0; i < children.Count; i = i + 1) {
            if (children[i] == c) { return i; }
        }
        return -1;
    }

    /// 移除一个子节点（若它不是本节点的子节点则为空操作）。
    void Remove(Control c) {
        int idx = IndexOf(c);
        if (idx >= 0) {
            children.RemoveAt(idx);
            c.parent = null;
        }
    }

    /// 在某个位置插入子节点，索引被钳制在范围内。会重新父化 `c`。
    void InsertAt(int idx, Control c) {
        int at = idx;
        if (at < 0) { at = 0; }
        if (at > children.Count) { at = children.Count; }
        c.parent = this;
        children.Insert(at, c);
    }

    /// 把已有子节点移动到新索引（供设计器拖拽排序用）。
    void MoveChild(Control c, int to) {
        int idx = IndexOf(c);
        if (idx < 0) { return; }
        children.RemoveAt(idx);
        int at = to;
        if (at < 0) { at = 0; }
        if (at > children.Count) { at = children.Count; }
        children.Insert(at, c);
    }

    /// 其已解析边界包含该点的最深层可见后代，
    /// 优先选择更靠后（最上层）的子节点。用于设计器命中选择。
    Control HitTest(int x, int y) {
        if (!this.StyleVisible()) { return null; }
        if (x < bx || y < by || x >= bx + bw || y >= by + bh) { return null; }
        int i = children.Count - 1;
        while (i >= 0) {
            Control hit = children[i].HitTest(x, y);
            if (hit != null) { return hit; }
            i = i - 1;
        }
        return this;
    }

    /// 按名称深度优先搜索，包括本节点。找不到返回 null。
    Control Find(string n) {
        if (name == n) {
            return this;
        }
        for (int i = 0; i < children.Count; i = i + 1) {
            Control r = children[i].Find(n);
            if (r != null) {
                return r;
            }
        }
        return null;
    }

    int ChildCount() {
        return children.Count;
    }

    /// 绑定到 `evt` 的处理器，无则为 ""。供事件检查器使用。
    string GetHandler(string evt) {
        for (int i = 0; i < events.Count; i = i + 1) {
            if (events[i].key == evt) { return events[i].val; }
        }
        return "";
    }

    /// 把处理器标识符绑定（或重新绑定）到 `evt`。
    void SetHandler(string evt, string h) {
        for (int i = 0; i < events.Count; i = i + 1) {
            if (events[i].key == evt) { events[i].val = h; return; }
        }
        events.Add(new EventBinding(evt, h));
    }

    /// 让节点自下而上从主题设置首选尺寸（子节点
    /// 优先）。子类重写 OnMeasure。在 Arrange 之前运行。
    /// Converts the logical sizes a document declared into physical pixels at
    /// the app's current scale. Runs before every measure pass, so a DPI
    /// change (or a move to another monitor) re-resolves them.
    void ApplyDeclaredUnits(App app) {
        if (logW > 0) { prefW = app.Scale(logW); prefSet = true; }
        if (logH > 0) { prefH = app.Scale(logH); prefSet = true; }
        if (logGap >= 0) { gap = app.Scale(logGap); }
        if (logPad >= 0) { this.Pad(app.Scale(logPad)); }
        if (logPlaceSet) {
            mx = app.Scale(logX);
            my = app.Scale(logY);
        }
    }

    void MeasureTree(App app) {
        this.ApplyDeclaredUnits(app);
        this.ResolveStyle(app, Style.SNormal());
        if (!this.StyleVisible()) { return; }
        for (int i = 0; i < children.Count; i = i + 1) {
            children[i].MeasureTree(app);
        }
        // 作者要求的尺寸（Prefer()，或 UiDoc 中的 `width`/`height`）
        // 优先于控件自行测量的尺寸：OnMeasure
        // 无条件赋值 prefW/prefH，过去会丢掉
        // 停靠表格列给定的 92px，把控件停靠在
        // 自然宽度上——导致一行内的列互相重叠。
        int keepW = prefW;
        int keepH = prefH;
        bool keepSet = prefSet;
        OnMeasure(app);
        if (keepSet) {
            if (keepW > 0) { prefW = keepW; }
            if (keepH > 0) { prefH = keepH; }
            prefSet = true;
        }
    }

    static int FitSize(int requested, int available) {
        if (requested < 0) { return 0; }
        if (available < 0) { return 0; }
        if (requested > available) { return available; }
        return requested;
    }

    static int FitGap(int requested, int available) {
        if (requested < 0 || available <= 0) { return 0; }
        if (requested > available) { return available; }
        return requested;
    }

    /// 计算此节点及其子树（通过停靠）的边界。
    /// 虚方法，使容器（如 ScrollColumn）可以偏移/裁剪其子节点。
    virtual void Arrange(int px, int py, int pw, int ph) {
        if (pw < 0) { pw = 0; }
        if (ph < 0) { ph = 0; }
        bx = px;
        by = py;
        bw = pw;
        bh = ph;
        int innerPadL = this.StylePadL();
        int innerPadT = this.StylePadT();
        int innerPadR = this.StylePadR();
        int innerPadB = this.StylePadB();
        int innerGap = this.StyleGap();
        int cx = px + innerPadL;
        int cy = py + innerPadT;
        int cw = pw - innerPadL - innerPadR;
        int ch = ph - innerPadT - innerPadB;
        if (cw < 0) { cw = 0; }
        if (ch < 0) { ch = 0; }
        if (this.StyleDisplay() == 1) {
            this.ArrangeFlex(cx, cy, cw, ch, innerGap);
            return;
        }
        for (int i = 0; i < children.Count; i = i + 1) {
            Control c = children[i];
            if (c.StyleVisible()) {
                if (c.dock == 1) {
                    int hh = Control.FitSize(c.DockSize(ch, false), ch);
                    c.Arrange(cx, cy, cw, hh);
                    int restH = ch - hh;
                    int gh = Control.FitGap(innerGap, restH);
                    cy = cy + hh + gh;
                    ch = restH - gh;
                } else if (c.dock == 2) {
                    int hh = Control.FitSize(c.DockSize(ch, false), ch);
                    c.Arrange(cx, cy + ch - hh, cw, hh);
                    int restH = ch - hh;
                    int gh = Control.FitGap(innerGap, restH);
                    ch = restH - gh;
                } else if (c.dock == 3) {
                    int ww = Control.FitSize(c.DockSize(cw, true), cw);
                    if (c.StyleDeclaresHeight()) {
                        int hh = Control.FitSize(c.StyleHeightIn(ch), ch);
                        c.Arrange(cx, cy + (ch - hh) / 2, ww, hh);
                    } else {
                        c.Arrange(cx, cy, ww, ch);
                    }
                    int restW = cw - ww;
                    int gw = Control.FitGap(innerGap, restW);
                    cx = cx + ww + gw;
                    cw = restW - gw;
                } else if (c.dock == 4) {
                    int ww = Control.FitSize(c.DockSize(cw, true), cw);
                    if (c.StyleDeclaresHeight()) {
                        int hh = Control.FitSize(c.StyleHeightIn(ch), ch);
                        c.Arrange(cx + cw - ww, cy + (ch - hh) / 2, ww, hh);
                    } else {
                        c.Arrange(cx + cw - ww, cy, ww, ch);
                    }
                    int restW = cw - ww;
                    int gw = Control.FitGap(innerGap, restW);
                    cw = restW - gw;
                } else if (c.dock == 5) {
                    c.Arrange(cx, cy, cw, ch);
                } else {
                    int ww = c.StyleWidth();
                    int hh = c.StyleHeight();
                    if (ww < 0) { ww = 0; }
                    if (hh < 0) { hh = 0; }
                    c.Arrange(cx + c.mx, cy + c.my, ww, hh);
                }
            }
        }
    }

    /// 把子节点作为一条 CSS flex 行排布在本节点的内容框内：
    /// 每个子节点取声明的主轴尺寸（px 或框的百分比），未声明时
    /// 取测量偏好；`flex-grow` 分配剩余空间；
    /// `justify-content` 安排剩余部分，`align-items` 决定
    /// 交叉轴尺寸（默认 stretch）。支持 margins 和 `gap`，
    /// 溢出的一行会按比例收缩而不是溢出框外。
    void ArrangeFlex(int cx, int cy, int cw, int ch, int gapPx) {
        bool row = true;
        if (computedStyle != null && computedStyle.flexDir == 1) { row = false; }
        int mainBox = cw;
        int crossBox = ch;
        if (!row) { mainBox = ch; crossBox = cw; }

        List<Control> items = new List<Control>();
        int i = 0;
        for (; i < children.Count; i = i + 1) {
            if (children[i].StyleVisible()) { items.Add(children[i]); }
        }
        int n = items.Count;
        if (n == 0) { return; }

        List<int> sizes = new List<int>();
        int used = 0;
        int totalGrow = 0;
        i = 0;
        while (i < n) {
            Control c = items[i];
            int sz;
            if (row) { sz = c.StyleWidthIn(cw); } else { sz = c.StyleHeightIn(ch); }
            if (sz < 0) { sz = 0; }
            sizes.Add(sz);
            used = used + sz + c.MarMain(row);
            totalGrow = totalGrow + c.StyleGrow();
            i = i + 1;
        }
        int gaps = 0;
        if (n > 1) { gaps = (n - 1) * gapPx; }
        int free = mainBox - used - gaps;

        if (free > 0 && totalGrow > 0) {
            // 两遍处理：先按 flex-grow 分配剩余空间并把结果
            // 钳制到 max-width/height，再把被钳制项让出的空间
            // 分给还能接受的项目。
            int pass = 0;
            while (pass < 2 && free > 0) {
                int share = free;
                int growable = 0;
                i = 0;
                while (i < n) {
                    int g = items[i].StyleGrow();
                    if (g > 0) { growable = growable + g; }
                    i = i + 1;
                }
                if (growable == 0) { pass = 2; }
                else {
                    int taken = 0;
                    i = 0;
                    while (i < n) {
                        int g = items[i].StyleGrow();
                        if (g > 0) {
                            int want = sizes[i] + share * g / growable;
                            int got = want;
                            if (row) { got = items[i].StyleClampW(cw, want); }
                            else { got = items[i].StyleClampH(ch, want); }
                            taken = taken + got - sizes[i];
                            sizes[i] = got;
                        }
                        i = i + 1;
                    }
                    free = free - taken;
                    if (taken == 0) { pass = 2; }
                    pass = pass + 1;
                }
            }
            if (free < 0) { free = 0; }
        } else if (free < 0 && used > 0) {
            // 溢出的一行：按比例收缩各项目（flex-shrink: 1）。
            int room = mainBox - gaps;
            if (room < 0) { room = 0; }
            int placedSize = 0;
            i = 0;
            while (i < n) {
                int sz = sizes[i] * room / used;
                if (i == n - 1) { sz = room - placedSize; }
                if (sz < 0) { sz = 0; }
                placedSize = placedSize + sz;
                sizes[i] = sz;
                i = i + 1;
            }
            free = 0;
        }

        int offset = 0;
        int between = gapPx;
        int justify = 0;
        if (computedStyle != null) { justify = computedStyle.justify; }
        if (justify == 1) { offset = free / 2; }
        else if (justify == 2) { offset = free; }
        else if (justify == 3 && n > 1) { between = between + free / (n - 1); }
        else if (justify == 4) {
            int slots = n + 1;
            offset = free / slots;
            between = between + offset;
        }

        int align = 0;
        if (computedStyle != null) { align = computedStyle.alignItems; }
        int pos = offset;
        i = 0;
        while (i < n) {
            Control c = items[i];
            int main = sizes[i];
            int crossAvail = crossBox - c.MarCross(row);
            if (crossAvail < 0) { crossAvail = 0; }
            int cross;
            if (row) { cross = c.StyleHeightIn(ch); } else { cross = c.StyleWidthIn(cw); }
            bool declaresCross = row ? c.StyleDeclaresHeight() : c.StyleDeclaresWidth();
            if (cross > crossAvail) { cross = crossAvail; }
            if (align == 0 && !declaresCross) { cross = crossAvail; }
            if (cross <= 0) { cross = crossAvail; }
            int crossPos = 0;
            if (align == 2) { crossPos = (crossAvail - cross) / 2; }
            else if (align == 3) { crossPos = crossAvail - cross; }
            if (row) {
                c.Arrange(cx + pos + c.StyleMarL(),
                          cy + crossPos + c.StyleMarT(), main, cross);
            } else {
                c.Arrange(cx + crossPos + c.StyleMarL(),
                          cy + pos + c.StyleMarT(), cross, main);
            }
            pos = pos + main + c.MarMain(row) + between;
            i = i + 1;
        }
    }

    /// 把此节点的 min/max-width（或 -height）应用到 `v`，
    /// 百分比边界按 `avail` 的包含块解析。
    int StyleClampW(int avail, int v) {
        if (computedStyle == null) { return v; }
        return computedStyle.ClampWIn(avail, v);
    }

    int StyleClampH(int avail, int v) {
        if (computedStyle == null) { return v; }
        return computedStyle.ClampHIn(avail, v);
    }

    /// 沿/跨 flex 行的总外边距。
    int MarMain(bool row) {
        if (row) { return this.StyleMarL() + this.StyleMarR(); }
        return this.StyleMarT() + this.StyleMarB();
    }

    int MarCross(bool row) {
        if (row) { return this.StyleMarT() + this.StyleMarB(); }
        return this.StyleMarL() + this.StyleMarR();
    }

    /// 绘制此节点自身的视觉。基类不绘制；子类重写。
    virtual void OnPaint(App app) {
    }

    /// 在延迟的覆盖层阶段绘制此控件的浮动/覆盖层（弹出菜单、选项列表、
    /// 提示），使其绘制在所有页面内容之上
    /// 并注册最顶层的命中区域——永不被遮挡，
    /// 也绝不把点击漏给其后绘制的控件。基类
    /// 不绘制；浮动控件重写此方法，打开期间用
    /// `app.AddOverlay(OverlayPopup.Host(this))` 延迟自身，
    /// 而不是在主阶段内联绘制弹窗。
    virtual void OnPaintOverlay(App app) {
    }

    /// 根据内容/主题设置 prefW/prefH。基类为空操作；叶节点重写。
    virtual void OnMeasure(App app) {
    }

    // --- 设计器/序列化模型（通过虚方法统一、免强转）---

    /// 用于重建此节点的稳定类型标签（见 ControlFactory）。每个
    /// 具体控件都重写它；基类标签只是回退。
    virtual string Kind() {
        return "Control";
    }

    /// 供检查器和序列化器使用的控件专属可编辑属性。
    /// 通用几何（dock/pad/gap/size/pos/name）由 Serialize 处理，
    /// 因此这里只返回控件独有的属性。基类没有。
    virtual List<PropSpec> Props() {
        return new List<PropSpec>();
    }

    /// 所有控件暴露的通用事件名（指针/焦点/键盘/
    /// 触摸/拖拽/生命周期），按检查器顺序。控件将其前置到自己的
    /// 语义事件之前（在 Events() 中）。
    static List<string> CommonEvents() {
        List<string> e = new List<string>{
            "Click",
            "DoubleClick",
            "RightClick",
            "MouseDown",
            "MouseUp",
            "Enter",
            "Leave",
            "Move",
            "Wheel",
            "Focus",
            "Blur",
            "KeyDown",
            "KeyUp",
            "KeyPress",
            "Tap",
            "LongPress",
            "Swipe",
            "DragStart",
            "Drag",
            "Drop",
            "Resize",
            "Show",
            "Hide" };
        return e;
    }

    /// 供设计器事件检查器使用的声明事件名。基类返回
    /// 通用事件包；控件重写以追加自己的语义事件（并
    /// 仍包含 CommonEvents()）。
    virtual List<string> Events() {
        return Control.CommonEvents();
    }

    /// 把解析出的 Action 订阅到指定事件。基类把通用事件包
    /// （Click/Enter/.../Drop）映射到 `On`；控件重写以把
    /// 自己的语义事件（Change/Submit/RowClick/...）路由到正确的
    /// UiEvent 字段，然后为通用事件集调用基类。JSON
    /// 加载器用它附加经注册表解析的 `on<Event>` 处理器。
    virtual void BindEvent(string evt, Action a) {
        On.AddByName(evt, a);
    }

    /// `key` 对应的规格；若此控件未发布该绑定
    /// 属性则返回 null。
    PropSpec PropOf(string key) {
        List<PropSpec> ps = this.Props();
        for (int i = 0; i < ps.Count; i = i + 1) {
            if (ps[i].Answers(key) && ps[i].IsBound()) { return ps[i]; }
        }
        return null;
    }

    /// 为无法用字段表达的属性提供的挂钩——逗号连接的条目列表、
    /// 或多个字段派生的值。有此类属性的控件重写这一对方法；
    /// 一切由字段支撑的属性仅由 Props() 提供。
    virtual string GetExtra(string key) {
        return "";
    }

    /// 写入一个额外属性；控件没有该键时返回 false，
    /// 基类此时回退为把它当作样式类处理。
    virtual bool SetExtra(string key, string val) {
        return false;
    }

    /// 通过控件在 Props() 中绑定的访问器，按键以文本形式读取属性——
    /// 这样控件只需发布每个属性一次，无需自己的
    /// 字符串映射。`class`、`name` 和 `disabled` 对所有控件都有应答。
    virtual string GetProp(string key) {
        if (key == "class") { return Class; }
        if (key == "name") { return name; }
        PropSpec p = this.PropOf(key);
        if (p != null) { return p.Read(); }
        return this.GetExtra(key);
    }

    /// 从文本按键写入属性（GetProp 的逆操作）。未知的
    /// 键改指样式类，要么是标志（`"round": true`），要么是
    /// 变体名（`"size": "small"`），文档正是借此设置
    /// 控件没有字段对应的视觉变体。
    virtual void SetProp(string key, string val) {
        if (key == "class") { Class = val; return; }
        if (key == "name") { name = val; return; }
        PropSpec p = this.PropOf(key);
        if (p != null) {
            p.Write(val);
            if (p.syncName) { name = val; }
            return;
        }
        if (this.SetExtra(key, val)) { return; }
        if (val == "true") { this.AddClass(key); }
        else if (val != "" && val != "false") { this.AddClass(val); }
    }

    /// 应用设计器里的标题文本。只有声明了 `text` 属性的控件
    /// 会接受它：容器的 label 是设计期说明，不是内容，所以
    /// 不能像 SetProp 那样退化成样式类。
    void SetDesignText(string txt) {
        if (txt == "") { return; }
        PropSpec p = this.PropOf("text");
        if (p == null) { return; }
        p.Write(txt);
        if (p.syncName) { name = txt; }
    }

    /// 若样式类尚不存在则添加它。
    void AddClass(string cls) {
        if (cls == "" || Style.Has(Class, cls)) { return; }
        if (Class == "") { Class = cls; return; }
        Class = Class + " " + cls;
    }

    /// 在 `area` 内布局并绘制此子树：宿主只需这一句
    /// 即可把矩形交给保留组件（测量、停靠、绘制）。
    void RenderInside(App app, Rect area) {
        this.MeasureTree(app);
        this.Arrange(area.x, area.y, area.width, area.height);
        this.RenderTree(app);
    }

    /// 以自身测量出的尺寸在 (x, y) 处绘制此子树：适用于
    /// 有位置但给不出矩形的宿主（预览、状态条）。
    void RenderAt(App app, int x, int y) {
        this.MeasureTree(app);
        this.Arrange(x, y, prefW, prefH);
        this.RenderTree(app);
    }

    /// 在 (x, y) 处按 `w` 像素宽绘制此子树，高度按自身测量。
    void RenderAt(App app, int x, int y, int w) {
        this.MeasureTree(app);
        this.Arrange(x, y, w, prefH);
        this.RenderTree(app);
    }

    /// 渲染子树：先自身，再裁剪到本节点矩形内的子节点，
    /// 子节点不能画到父节点之外（原生裁剪栈）。命名为
    /// RenderTree（而非 Paint），因为一些控件已声明了静态
    /// Paint，而编译器仅按名称解析方法调用。
    void RenderTree(App app) {
        if (!this.ComputedStyleCurrent(app)) {
            this.ResolveStyle(app, Style.SNormal());
        }
        if (!this.StyleVisible()) {
            if (lastVisible && Hide.Count() > 0) { Hide.Raise(); }
            lastVisible = false;
            return;
        }
        if (!lastVisible && everLaidOut && Show.Count() > 0) { Show.Raise(); }
        lastVisible = true;
        PaintStyleBox(app);
        OnPaint(app);
        this.FireCommon(app);
        if (Paint.Count() > 0) { Paint.Raise(); }
        if (everLaidOut && (bw != lastBw || bh != lastBh) && Resize.Count() > 0) {
            Resize.Raise();
        }
        lastBw = bw;
        lastBh = bh;
        everLaidOut = true;
        if (children.Count > 0) {
            app.canvas.PushClip(bx, by, bw, bh);
            for (int i = 0; i < children.Count; i = i + 1) {
                children[i].RenderTree(app);
            }
            app.canvas.PopClip();
        }
    }
}

/// 窗口上的一个周期任务（Form.Every 登记）。工控画面、
/// 监控看板这类“定时重扫”的屏幕靠它驱动，不必自己
/// 写事件循环。
class FormTask {
    int periodMs;
    /// 下次到期的时刻（App 的动画时钟）。
    int dueMs;
    Action work;

    FormTask(int ms, Action a) {
        periodMs = ms;
        if (periodMs < 1) { periodMs = 1; }
        work = a;
        dueMs = 0;
    }

    int Period() { return periodMs; }
    int Due() { return dueMs; }
    void Schedule(int atMs) { dueMs = atMs; }
    void Fire() { work(); }
}

/// 保留模式 UI 的根：窗口本身作为一个组件。拥有 App
/// 并驱动帧循环，每帧在标题栏装饰之下
/// 布局并渲染整棵树。
class Form : Control {
    App app;
    string title;
    /// 周期任务（见 Every），在事件循环中按期触发。
    List<FormTask> tasks;
    /// 设计出的 `on<Event>` 绑定的 Name -> Action 表（与
    /// UiDoc/HandlerRegistry 契约相同）：.zform 存储处理器名，
    /// 业务文件用 On() 注册 Action，生成的
    /// __WireForm 把每个控件的事件订阅到 Handle(name)。从未注册的
    /// 处理器自然不会触发。
    HandlerRegistry handlers;

    /// 构建底层窗口和 app。树可以在 Run() 之前
    /// 组装并布局好。
    Form(string title, int width, int height) {
        this.InitControl(title, 5);
        this.title = title;
        this.app = new App(title, width, height);
        this.handlers = new HandlerRegistry();
        this.tasks = new List<FormTask>();
    }

    static Form CreateDark(string title, int width, int height) {
        Form f = new Form(title, width, height);
        f.app.SetDark(true);
        return f;
    }

    App GetApp() {
        return app;
    }

    // ---- 每帧钩子 ----

    /// 每帧回调（在事件处理之后、周期任务与渲染之前执行）。
    /// 供宿主在保留模式循环中泵其它窗口 / 驱动动画 / 轮询
    /// 后台任务（IDE 的多窗口 pump、向导等）。覆盖旧值。
    Action frameHook;

    void FrameHook(Action a) {
        frameHook = a;
    }

    // ---- 退出钩子 ----

    /// 事件循环结束（窗口关闭）后调用一次的回调，
    /// 供宿主保存状态 / 清理。
    Action exitHook;

    void OnExit(Action a) {
        exitHook = a;
    }

    // ---- 周期任务 ----

    /// 每 `ms` 毫秒跑一次 `a`，由事件循环驱动（采集、报警
    /// 扫描、趋势取点都用它）。任务跑完就请求重绘，因此
    /// 它改的信号会在下一帧体现。
    FormTask Every(int ms, Action a) {
        FormTask t = new FormTask(ms, a);
        t.Schedule(app.nowMs + t.Period());
        tasks.Add(t);
        return t;
    }

    /// 到期的周期任务全部跑一遍，并把下一个到期时刻告知
    /// 事件循环（以便在无输入时也能醒过来）。手写循环可
    /// 直接调用它。
    void PumpTasks() {
        if (tasks.Count == 0) { return; }
        int now = app.nowMs;
        int soonest = 0 - 1;
        for (int i = 0; i < tasks.Count; i = i + 1) {
            FormTask t = tasks[i];
            if (now >= t.Due()) {
                t.Fire();
                t.Schedule(now + t.Period());
                app.RequestRedraw();
            }
            int wait = t.Due() - now;
            if (wait < 0) { wait = 0; }
            if (soonest < 0 || wait < soonest) { soonest = wait; }
        }
        if (soonest >= 0) { app.RequestAnimationFrame(soonest); }
    }

    // ---- 动态控件通道 ----
    //
    // 类型化的控件字段是访问控件的主要、经编译检查的方式。
    // 这些按名查找是次要通道，供
    // 编译期不知道类型的代码使用（数据驱动 UI、设计器
    // 脚本、插件胶水）：Ctl()/Get<T>() 遍历实时树。

    /// 第一个（深度优先）名为 `name` 的控件，或 null。
    /// 设计器总是为每个字段分配唯一名称，因此实际中它是精确的；
    /// 但你自己写的代码永远不要假定结果非空。
    Control Ctl(string name) {
        return this.Find(name);
    }

    /// 类型化按名查找：`Checkbox c = form.Get<Checkbox>("agree");`
    /// 名称不存在或控件不是该类型时返回 null。
    T Get<T>(string name) {
        Control c = this.Find(name);
        if (c == null) { return null; }
        if (c is T) { return (T)c; }
        return null;
    }

    // ---- 设计的事件绑定 ----

    /// 注册（或替换）绑定到设计处理器名的 Action。
    /// __WireForm 通过此表解析每个控件的 `on<Event>` 值，
    /// 因此设计中的处理器名必须与此处一致。
    void On(string name, Action a) {
        handlers.Set(name, a);
    }

    /// 为 `name` 注册的 Action；未注册时为 null。
    Action Handle(string name) {
        return handlers.Get(name);
    }

    /// 运行为 `name` 注册的 Action（若有）。对未注册的名称
    /// 安全（空操作）。让设计器和数据驱动代码无需持有
    /// 控件引用即可触发处理器。
    void Call(string name) {
        Action a = handlers.Get(name);
        if (a != null) { a(); }
    }

    /// 在当前帧中一次性测量、布局并绘制整棵树，
    /// 位于装饰之下。公开以便手写循环可以组合调用它。
    void RenderFrame(App a) {
        int top = a.ContentTop();
        int W = a.canvas.Width();
        int H = a.canvas.Height();
        // 在树后绘制当前皮肤的主题背景（渐变 + 玻璃壁纸，
        // 或纯色填充），让磨砂玻璃面板模糊真实
        // 色彩而不是纯色清屏——与 IDE/画廊
        // 设置窗口的方式相同。槽 0 是惯例的背景缓存槽。
        a.RenderBackground(0, top, W, H - top, 0);
        this.MeasureTree(a);
        this.Arrange(0, top, W, H - top);
        this.RenderTree(a);
    }

    /// 标准保留模式循环：处理事件、泵子窗口、布局、渲染树、绘制
    /// 装饰、呈现。子窗口（ChildWindow）与共享文件选择器由
    /// ChildWindows 注册表在此自动泵送，宿主无需手写任何泵逻辑。
    void Run() {
        app.Show();
        while (app.isRunning) {
            if (!app.ProcessEvent()) {
                break;
            }
            if (frameHook != null) { frameHook(); }
            ChildWindows.PumpAll();
            ChildWindows.FoldDeadlines(app);
            this.PumpTasks();
            if (!app.needsRedraw) {
                continue;
            }
            app.BeginFrame();
            RenderFrame(app);
            app.RenderChrome(title);
            app.PresentFrame();
        }
        if (exitHook != null) { exitHook(); }
    }
}

/// 具名停靠值，使树中写 `.Dock(Dock.Top())` 而不是魔法
/// 数字。（该语言没有静态字段常量，因此用静态方法。）
class Dock {
    static int Manual() { return 0; }
    static int Top() { return 1; }
    static int Bottom() { return 2; }
    static int Left() { return 3; }
    static int Right() { return 4; }
    static int Fill() { return 5; }
}
