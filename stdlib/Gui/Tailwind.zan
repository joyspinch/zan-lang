using System;

namespace Gui;

/// Tailwind 拼写的工具类（utility class）：控件的 class 列表里除了
/// 皮肤自己的语义类（`.primary`、`.ghost`）之外，还可以直接写
/// Tailwind 的原子类，由这里翻译成引擎已经理解的 CSS 声明：
///
///     Ui.Panel(app, "flex items-center gap-2 px-4 py-2 rounded-lg "
///                 + "bg-slate-800 text-slate-100 shadow-md "
///                 + "hover:bg-slate-700");
///
/// 之所以值得内建：AI 和大多数前端开发者手上最熟的样式语言就是
/// Tailwind，写 UI 时不需要先去查这套 GUI 的属性名和主题 token。
/// 工具类不是新的样式模型——每个 token 都会退化成
/// `StyleSheet.Decl`（即 `.css` 皮肤里能写的同一批属性），所以皮肤、
/// 过渡、DPI 缩放、`:hover` 缓动全部照旧生效。
///
/// 与 Tailwind 的对应关系：
///   * 间距刻度 = `n * 4px`（`p-4` -> 16px，`p-px` -> 1px，`p-1.5` -> 6px）；
///   * 变体前缀 `hover: focus: active: disabled: checked: selected:` 对应
///     引擎的状态位，可叠加（`hover:focus:ring` 需两者同时成立）；
///     引擎未建模的变体（`md:`、`group-hover:`、`dark:`）整条 token 忽略；
///   * 任意值 `w-[240px]`、`bg-[#0f172a]`、`text-[13px]`，下划线代表空格；
///   * 颜色透明度 `bg-black/40`；
///   * 调色板是 Tailwind 默认调色板（22 个色系 x 11 个色阶）。
///
/// 只有能被识别的 token 会产生声明，其余原样留给皮肤的类选择器，
/// 因此工具类和 `.css` 皮肤可以混用。工具类写在控件上，所以像
/// Tailwind 一样最后应用、胜过皮肤里的组件规则。
class Tailwind {
    /// 把 `cls` 里每个可识别的工具类叠加到已解析的样式盒上。
    /// `stateBits` 是 Style.S* 掩码，决定 `hover:` 这类变体是否生效。
    static void Apply(StyleBox b, string cls, int stateBits) {
        if (cls == "") { return; }
        List<string> toks = Style.Classes(cls);
        for (int i = 0; i < toks.Count; i = i + 1) {
            Tailwind.Token(b, toks[i], stateBits);
        }
        Tailwind.Gradient(b, toks);
    }

    /// retained-mode（UiDoc / 设计器）的同一套解析：先解析成
    /// 样式盒，再把控件自身保留的那几个字段抄过去。
    static void ApplyControl(Control c, string cls, int stateBits) {
        if (c == null || cls == "") { return; }
        StyleBox b = new StyleBox();
        Tailwind.Apply(b, cls, stateBits);
        StyleSheet.CopyToControl(b, c);
        if (b.padL >= 0) { c.Pad(b.padL); }
        if (b.gap >= 0) { c.gap = b.gap; }
        if (b.width >= 0) { c.prefW = b.width; }
        if (b.height >= 0) { c.prefH = b.height; }
    }

    /// 应用单个 token（可带变体前缀）。未被识别时返回 false。
    static bool Token(StyleBox b, string tok, int stateBits) {
        string t = tok;
        for (int guard = 0; guard < 4; guard = guard + 1) {
            int colon = Tailwind.Colon(t);
            if (colon < 0) { guard = 4; continue; }
            string variant = t.Substring(0, colon);
            t = t.Substring(colon + 1, t.Length - colon - 1);
            int bit = Style.StateBit(variant);
            if (bit == 0) { return false; }
            if ((stateBits / bit) % 2 != 1) { return false; }
        }
        if (t == "") { return false; }
        return Tailwind.Util(b, t);
    }

    /// 不带变体的工具类。负号前缀（`-mt-2`）在这里剥掉，再作为
    /// 符号传给认得负值的类别。
    static bool Util(StyleBox b, string tok) {
        string s = tok;
        string sign = "";
        if (Tailwind.Pre(s, "-")) {
            sign = "-";
            s = Tailwind.Rest(s, "-");
        }
        if (sign == "" && Tailwind.Keyword(b, s)) { return true; }
        if (Tailwind.Spacing(b, s, sign)) { return true; }
        if (sign == "" && Tailwind.Size(b, s)) { return true; }
        if (sign == "" && Tailwind.Typography(b, s)) { return true; }
        if (sign == "" && Tailwind.Paint(b, s)) { return true; }
        if (sign == "" && Tailwind.Round(b, s)) { return true; }
        if (Tailwind.Motion(b, s, sign)) { return true; }
        return Tailwind.Misc(b, s, sign);
    }

    // ---- 关键字（无参数）---------------------------------------------------

    /// display / flex / position / overflow / 文本变形这类固定拼写。
    static bool Keyword(StyleBox b, string s) {
        if (Tailwind.KeyLayout(b, s)) { return true; }
        if (Tailwind.KeyFlex(b, s)) { return true; }
        if (Tailwind.KeyText(b, s)) { return true; }
        return false;
    }

    static bool KeyLayout(StyleBox b, string s) {
        if (s == "flex" || s == "inline-flex") { return Tailwind.D(b, "display", "flex"); }
        if (s == "block" || s == "inline-block") { return Tailwind.D(b, "display", "block"); }
        if (s == "hidden") { return Tailwind.D(b, "display", "none"); }
        if (s == "static") { return Tailwind.D(b, "position", "static"); }
        if (s == "relative" || s == "sticky") { return Tailwind.D(b, "position", "relative"); }
        if (s == "absolute" || s == "fixed") { return Tailwind.D(b, "position", "absolute"); }
        if (s == "overflow-hidden" || s == "overflow-clip" || s == "overflow-auto"
            || s == "overflow-scroll" || s == "overflow-x-hidden"
            || s == "overflow-y-hidden" || s == "overflow-x-auto"
            || s == "overflow-y-auto" || s == "overflow-x-scroll"
            || s == "overflow-y-scroll") {
            return Tailwind.D(b, "overflow", "hidden");
        }
        if (s == "overflow-visible") { return Tailwind.D(b, "overflow", "visible"); }
        if (s == "visible") { return Tailwind.D(b, "visibility", "visible"); }
        if (s == "invisible") { return Tailwind.D(b, "visibility", "hidden"); }
        return false;
    }

    static bool KeyFlex(StyleBox b, string s) {
        if (s == "flex-row") { return Tailwind.D(b, "flex-direction", "row"); }
        if (s == "flex-col") { return Tailwind.D(b, "flex-direction", "column"); }
        if (s == "flex-row-reverse") { return Tailwind.D(b, "flex-direction", "row"); }
        if (s == "flex-col-reverse") { return Tailwind.D(b, "flex-direction", "column"); }
        if (s == "flex-wrap" || s == "flex-wrap-reverse") {
            return Tailwind.D(b, "flex-wrap", "wrap");
        }
        if (s == "flex-nowrap") { return Tailwind.D(b, "flex-wrap", "nowrap"); }
        if (s == "flex-1" || s == "flex-auto" || s == "grow") {
            return Tailwind.D(b, "flex-grow", "1");
        }
        if (s == "flex-none" || s == "grow-0") { return Tailwind.D(b, "flex-grow", "0"); }
        if (s == "items-start" || s == "items-baseline") {
            return Tailwind.D(b, "align-items", "flex-start");
        }
        if (s == "items-center") { return Tailwind.D(b, "align-items", "center"); }
        if (s == "items-end") { return Tailwind.D(b, "align-items", "flex-end"); }
        if (s == "items-stretch") { return Tailwind.D(b, "align-items", "stretch"); }
        if (s == "justify-start") { return Tailwind.D(b, "justify-content", "flex-start"); }
        if (s == "justify-center") { return Tailwind.D(b, "justify-content", "center"); }
        if (s == "justify-end") { return Tailwind.D(b, "justify-content", "flex-end"); }
        if (s == "justify-between") { return Tailwind.D(b, "justify-content", "space-between"); }
        if (s == "justify-around") { return Tailwind.D(b, "justify-content", "space-around"); }
        if (s == "justify-evenly") { return Tailwind.D(b, "justify-content", "space-evenly"); }
        return false;
    }

    static bool KeyText(StyleBox b, string s) {
        if (s == "uppercase") { return Tailwind.D(b, "text-transform", "uppercase"); }
        if (s == "lowercase") { return Tailwind.D(b, "text-transform", "lowercase"); }
        if (s == "normal-case" || s == "capitalize") {
            return Tailwind.D(b, "text-transform", "none");
        }
        if (s == "truncate") {
            Tailwind.D(b, "white-space", "nowrap");
            return Tailwind.D(b, "text-overflow", "ellipsis");
        }
        if (s == "text-ellipsis") { return Tailwind.D(b, "text-overflow", "ellipsis"); }
        if (s == "text-clip") { return Tailwind.D(b, "text-overflow", "clip"); }
        if (s == "whitespace-nowrap" || s == "whitespace-pre") {
            return Tailwind.D(b, "white-space", "nowrap");
        }
        if (s == "whitespace-normal") { return Tailwind.D(b, "white-space", "normal"); }
        if (s == "align-top") { return Tailwind.D(b, "vertical-align", "top"); }
        if (s == "align-middle") { return Tailwind.D(b, "vertical-align", "middle"); }
        if (s == "align-bottom") { return Tailwind.D(b, "vertical-align", "bottom"); }
        if (s == "border-solid") { return Tailwind.D(b, "border-style", "solid"); }
        if (s == "border-dashed" || s == "border-dotted") {
            return Tailwind.D(b, "border-style", "dashed");
        }
        return false;
    }

    // ---- 间距（padding / margin / gap）--------------------------------------

    /// `p-4 px-2 pt-1 m-3 mx-2 -mt-1 gap-2 gap-x-4 space-y-2`。
    static bool Spacing(StyleBox b, string s, string sign) {
        if (Tailwind.SpacingSide(b, s, sign, "p", "padding")) { return true; }
        if (Tailwind.SpacingSide(b, s, sign, "m", "margin")) { return true; }
        if (Tailwind.Pre(s, "gap-x-") || Tailwind.Pre(s, "space-x-")) {
            return Tailwind.D(b, "column-gap", Tailwind.Len(Tailwind.After(s, "-x-"), sign));
        }
        if (Tailwind.Pre(s, "gap-y-") || Tailwind.Pre(s, "space-y-")) {
            return Tailwind.D(b, "row-gap", Tailwind.Len(Tailwind.After(s, "-y-"), sign));
        }
        if (Tailwind.Pre(s, "gap-")) {
            return Tailwind.D(b, "gap", Tailwind.Len(Tailwind.Rest(s, "gap-"), sign));
        }
        return false;
    }

    /// 一族方向性间距：`<p>-4`、`<p>x-4`、`<p>t-4`（`prop` 是
    /// `padding` 或 `margin`）。x/y 展开成两条边，因为引擎按边存。
    static bool SpacingSide(StyleBox b, string s, string sign, string key,
                            string prop) {
        if (!Tailwind.Pre(s, key)) { return false; }
        string r = Tailwind.Rest(s, key);
        if (Tailwind.Pre(r, "-")) {
            return Tailwind.D(b, prop, Tailwind.Len(Tailwind.Rest(r, "-"), sign));
        }
        if (r.Length < 2) { return false; }
        string side = r.Substring(0, 1);
        if (r.Substring(1, 1) != "-") { return false; }
        string val = Tailwind.Len(r.Substring(2, r.Length - 2), sign);
        if (val == "") { return false; }
        if (side == "x") {
            Tailwind.D(b, prop + "-left", val);
            return Tailwind.D(b, prop + "-right", val);
        }
        if (side == "y") {
            Tailwind.D(b, prop + "-top", val);
            return Tailwind.D(b, prop + "-bottom", val);
        }
        if (side == "t") { return Tailwind.D(b, prop + "-top", val); }
        if (side == "r") { return Tailwind.D(b, prop + "-right", val); }
        if (side == "b") { return Tailwind.D(b, prop + "-bottom", val); }
        if (side == "l") { return Tailwind.D(b, prop + "-left", val); }
        return false;
    }

    // ---- 尺寸 --------------------------------------------------------------

    /// `w-64 h-full w-1/2 min-w-0 max-w-md size-8 h-[38px]`。
    static bool Size(StyleBox b, string s) {
        if (Tailwind.Pre(s, "min-w-")) {
            return Tailwind.D(b, "min-width", Tailwind.Extent(Tailwind.Rest(s, "min-w-")));
        }
        if (Tailwind.Pre(s, "min-h-")) {
            return Tailwind.D(b, "min-height", Tailwind.Extent(Tailwind.Rest(s, "min-h-")));
        }
        if (Tailwind.Pre(s, "max-w-")) {
            return Tailwind.D(b, "max-width", Tailwind.Extent(Tailwind.Rest(s, "max-w-")));
        }
        if (Tailwind.Pre(s, "max-h-")) {
            return Tailwind.D(b, "max-height", Tailwind.Extent(Tailwind.Rest(s, "max-h-")));
        }
        if (Tailwind.Pre(s, "size-")) {
            string v = Tailwind.Extent(Tailwind.Rest(s, "size-"));
            Tailwind.D(b, "width", v);
            return Tailwind.D(b, "height", v);
        }
        if (Tailwind.Pre(s, "w-")) {
            return Tailwind.D(b, "width", Tailwind.Extent(Tailwind.Rest(s, "w-")));
        }
        if (Tailwind.Pre(s, "h-")) {
            return Tailwind.D(b, "height", Tailwind.Extent(Tailwind.Rest(s, "h-")));
        }
        return false;
    }

    /// 盒子度量的值：`full/screen` -> 100%，`auto` -> 未设置，
    /// `1/2` -> 50%，T 恤码（`max-w-md`）-> 固定像素，其余走间距刻度。
    static string Extent(string v) {
        if (v == "") { return ""; }
        if (v == "full" || v == "screen" || v == "dvh" || v == "dvw") { return "100%"; }
        if (v == "auto" || v == "fit" || v == "min" || v == "max" || v == "none") {
            return "-1";
        }
        if (Tailwind.IndexOf(v, "/") > 0) {
            int slash = Tailwind.IndexOf(v, "/");
            int num = StyleSheet.Num(v.Substring(0, slash));
            int den = StyleSheet.Num(v.Substring(slash + 1, v.Length - slash - 1));
            if (den == 0) { return ""; }
            return Convert.ToString(num * 100 / den) + "%";
        }
        int shirt = Tailwind.Shirt(v);
        if (shirt > 0) { return Convert.ToString(shirt); }
        return Tailwind.Len(v, "");
    }

    /// `max-w-*` 的 T 恤码宽度（Tailwind 的 `max-w-md` = 448px）。
    static int Shirt(string v) {
        if (v == "xs") { return 320; }
        if (v == "sm") { return 384; }
        if (v == "md") { return 448; }
        if (v == "lg") { return 512; }
        if (v == "xl") { return 576; }
        if (v == "2xl") { return 672; }
        if (v == "3xl") { return 768; }
        if (v == "4xl") { return 896; }
        if (v == "5xl") { return 1024; }
        if (v == "6xl") { return 1152; }
        if (v == "7xl") { return 1280; }
        return 0;
    }

    // ---- 排版 --------------------------------------------------------------

    /// `text-sm text-center text-slate-100 font-bold leading-6 tracking-wide`。
    static bool Typography(StyleBox b, string s) {
        if (Tailwind.Pre(s, "text-")) { return Tailwind.Text(b, Tailwind.Rest(s, "text-")); }
        if (Tailwind.Pre(s, "font-")) {
            int w = Tailwind.Weight(Tailwind.Rest(s, "font-"));
            if (w == 0) { return false; }
            return Tailwind.D(b, "font-weight", Convert.ToString(w));
        }
        if (Tailwind.Pre(s, "leading-")) {
            return Tailwind.D(b, "line-height", Tailwind.Leading(Tailwind.Rest(s, "leading-")));
        }
        if (Tailwind.Pre(s, "tracking-")) {
            return Tailwind.D(b, "letter-spacing",
                              Tailwind.Tracking(Tailwind.Rest(s, "tracking-")));
        }
        return false;
    }

    /// `text-*` 一个词管三件事：对齐、字号、前景色。按这个顺序
    /// 试，任意值里带 `#` 的当颜色。
    static bool Text(StyleBox b, string v) {
        if (v == "left" || v == "center" || v == "right" || v == "start"
            || v == "end") {
            return Tailwind.D(b, "text-align", v);
        }
        int px = Tailwind.FontSize(v);
        if (px > 0) { return Tailwind.D(b, "font-size", Convert.ToString(px)); }
        string arb = Tailwind.Arb(v);
        if (arb != "") {
            if (Tailwind.Pre(arb, "#") || Tailwind.Pre(arb, "rgb")
                || Tailwind.Pre(arb, "hsl")) {
                return Tailwind.D(b, "color", arb);
            }
            return Tailwind.D(b, "font-size", arb);
        }
        string col = Tailwind.Color(v);
        if (col == "") { return false; }
        return Tailwind.D(b, "color", col);
    }

    static int FontSize(string v) {
        if (v == "xs") { return 12; }
        if (v == "sm") { return 14; }
        if (v == "base") { return 16; }
        if (v == "lg") { return 18; }
        if (v == "xl") { return 20; }
        if (v == "2xl") { return 24; }
        if (v == "3xl") { return 30; }
        if (v == "4xl") { return 36; }
        if (v == "5xl") { return 48; }
        if (v == "6xl") { return 60; }
        if (v == "7xl") { return 72; }
        if (v == "8xl") { return 96; }
        if (v == "9xl") { return 128; }
        return 0;
    }

    static int Weight(string v) {
        if (v == "thin") { return 100; }
        if (v == "extralight") { return 200; }
        if (v == "light") { return 300; }
        if (v == "normal") { return 400; }
        if (v == "medium") { return 500; }
        if (v == "semibold") { return 600; }
        if (v == "bold") { return 700; }
        if (v == "extrabold") { return 800; }
        if (v == "black") { return 900; }
        return 0;
    }

    /// 行高：引擎按像素存，所以比例关键字按 16px 正文换算。
    static string Leading(string v) {
        if (v == "none") { return "16"; }
        if (v == "tight") { return "20"; }
        if (v == "snug") { return "22"; }
        if (v == "normal") { return "24"; }
        if (v == "relaxed") { return "26"; }
        if (v == "loose") { return "32"; }
        return Tailwind.Len(v, "");
    }

    /// 字距：引擎按像素存（Tailwind 的 em 值按 16px 正文换算并取整）。
    static string Tracking(string v) {
        if (v == "tighter") { return "-2"; }
        if (v == "tight") { return "-1"; }
        if (v == "normal") { return "0"; }
        if (v == "wide") { return "1"; }
        if (v == "wider") { return "2"; }
        if (v == "widest") { return "3"; }
        string arb = Tailwind.Arb(v);
        if (arb != "") { return arb; }
        return "";
    }

    // ---- 颜色 / 边框 / 阴影 -------------------------------------------------

    /// `bg-slate-800 bg-[#0f172a] border-2 border-t border-blue-500
    /// shadow-md shadow-none accent-emerald-500`。
    static bool Paint(StyleBox b, string s) {
        if (Tailwind.Pre(s, "bg-")) {
            string v = Tailwind.ColorOrArb(Tailwind.Rest(s, "bg-"));
            if (v == "") { return false; }
            return Tailwind.D(b, "background", v);
        }
        if (Tailwind.Pre(s, "accent-")) {
            string v = Tailwind.ColorOrArb(Tailwind.Rest(s, "accent-"));
            if (v == "") { return false; }
            return Tailwind.D(b, "accent-color", v);
        }
        if (Tailwind.Pre(s, "backdrop-blur")) {
            return Tailwind.D(b, "backdrop-filter",
                              "blur(" + Tailwind.Blur(Tailwind.Rest(s, "backdrop-blur")) + "px)");
        }
        if (s == "border" || Tailwind.Pre(s, "border-")) { return Tailwind.Border(b, s); }
        if (s == "shadow" || Tailwind.Pre(s, "shadow-")) { return Tailwind.Shadow(b, s); }
        if (Tailwind.Pre(s, "opacity-")) {
            return Tailwind.D(b, "opacity", Tailwind.Rest(s, "opacity-") + "%");
        }
        return false;
    }

    /// `border` / `border-2` / `border-t` / `border-t-2` /
    /// `border-blue-500` / `border-t-blue-500`。
    static bool Border(StyleBox b, string s) {
        if (s == "border") { return Tailwind.D(b, "border-width", "1"); }
        string r = Tailwind.Rest(s, "border-");
        string side = "";
        string head = r;
        int dash = Tailwind.IndexOf(r, "-");
        if (dash > 0) { head = r.Substring(0, dash); }
        if (Tailwind.IsSide(head)) {
            side = head;
            if (dash > 0) { r = r.Substring(dash + 1, r.Length - dash - 1); }
            else { r = ""; }
        }
        if (r == "") { return Tailwind.BorderSet(b, side, "1", ""); }
        if (StyleSheet.IsNumeric(r)) { return Tailwind.BorderSet(b, side, r, ""); }
        string col = Tailwind.ColorOrArb(r);
        if (col == "") { return false; }
        return Tailwind.BorderSet(b, side, "", col);
    }

    static bool IsSide(string v) {
        return v == "t" || v == "r" || v == "b" || v == "l" || v == "x"
            || v == "y";
    }

    /// 一条边（或 x/y 两条边）的宽度或颜色。
    static bool BorderSet(StyleBox b, string side, string w, string col) {
        if (side == "x") {
            Tailwind.BorderSet(b, "l", w, col);
            return Tailwind.BorderSet(b, "r", w, col);
        }
        if (side == "y") {
            Tailwind.BorderSet(b, "t", w, col);
            return Tailwind.BorderSet(b, "b", w, col);
        }
        string prop = "border";
        if (side == "t") { prop = "border-top"; }
        else if (side == "r") { prop = "border-right"; }
        else if (side == "b") { prop = "border-bottom"; }
        else if (side == "l") { prop = "border-left"; }
        if (w != "") { return Tailwind.D(b, prop + "-width", w); }
        return Tailwind.D(b, prop + "-color", col);
    }

    /// `bg-gradient-to-br from-indigo-500 via-purple-500 to-pink-500`：渐变
    /// 要把几个 token 合成一条 `linear-gradient()`，所以在逐 token 解析
    /// 之后单独走一遍（只认不带变体前缀的写法）。
    static void Gradient(StyleBox b, List<string> toks) {
        string dir = "";
        string from = "";
        string via = "";
        string to = "";
        for (int i = 0; i < toks.Count; i = i + 1) {
            string t = toks[i];
            if (Tailwind.Colon(t) >= 0) { continue; }
            if (Tailwind.Pre(t, "bg-gradient-to-")) {
                dir = Tailwind.GradientDir(Tailwind.Rest(t, "bg-gradient-to-"));
                continue;
            }
            if (Tailwind.Pre(t, "from-")) {
                from = Tailwind.ColorOrArb(Tailwind.Rest(t, "from-"));
                continue;
            }
            if (Tailwind.Pre(t, "via-")) {
                via = Tailwind.ColorOrArb(Tailwind.Rest(t, "via-"));
                continue;
            }
            if (Tailwind.Pre(t, "to-")) {
                to = Tailwind.ColorOrArb(Tailwind.Rest(t, "to-"));
            }
        }
        if (from == "") { return; }
        if (to == "") {
            Tailwind.D(b, "background", from);
            return;
        }
        string val = "linear-gradient(";
        if (dir != "") { val = val + dir + ", "; }
        val = val + from;
        if (via != "") { val = val + ", " + via; }
        Tailwind.D(b, "background", val + ", " + to + ")");
    }

    /// `bg-gradient-to-<dir>` 的方向（引擎支持下 / 右 / 右下 / 上）。
    static string GradientDir(string v) {
        if (v == "t") { return "to top"; }
        if (v == "r") { return "to right"; }
        if (v == "br") { return "to bottom right"; }
        return "to bottom";
    }

    /// Tailwind 的阴影档位（`shadow-md`）或阴影颜色（`shadow-blue-500`）。
    static bool Shadow(StyleBox b, string s) {
        string v = "";
        if (s != "shadow") { v = Tailwind.Rest(s, "shadow-"); }
        if (v == "") { return Tailwind.D(b, "box-shadow", "0 1 3 rgba(0,0,0,0.2)"); }
        if (v == "none") { return Tailwind.D(b, "box-shadow", "none"); }
        if (v == "sm") { return Tailwind.D(b, "box-shadow", "0 1 2 rgba(0,0,0,0.1)"); }
        if (v == "md") { return Tailwind.D(b, "box-shadow", "0 4 6 rgba(0,0,0,0.2)"); }
        if (v == "lg") { return Tailwind.D(b, "box-shadow", "0 10 15 rgba(0,0,0,0.25)"); }
        if (v == "xl") { return Tailwind.D(b, "box-shadow", "0 20 25 rgba(0,0,0,0.28)"); }
        if (v == "2xl") { return Tailwind.D(b, "box-shadow", "0 25 50 rgba(0,0,0,0.35)"); }
        if (v == "inner") {
            return Tailwind.D(b, "box-shadow", "inset 0 2 4 rgba(0,0,0,0.2)");
        }
        string col = Tailwind.ColorOrArb(v);
        if (col == "") { return false; }
        return Tailwind.D(b, "box-shadow", col);
    }

    /// `backdrop-blur` 的档位半径。
    static string Blur(string v) {
        if (v == "" ) { return "8"; }
        string r = v;
        if (Tailwind.Pre(r, "-")) { r = Tailwind.Rest(r, "-"); }
        if (r == "none") { return "0"; }
        if (r == "sm") { return "4"; }
        if (r == "md") { return "12"; }
        if (r == "lg") { return "16"; }
        if (r == "xl") { return "24"; }
        if (r == "2xl") { return "40"; }
        if (r == "3xl") { return "64"; }
        string arb = Tailwind.Arb(r);
        if (arb != "") { return arb; }
        return Convert.ToString(StyleSheet.Num(r));
    }

    // ---- 圆角 --------------------------------------------------------------

    /// `rounded rounded-lg rounded-full rounded-t-md rounded-tl-lg
    /// rounded-[10px]`。
    static bool Round(StyleBox b, string s) {
        if (s != "rounded" && !Tailwind.Pre(s, "rounded-")) { return false; }
        string r = "";
        if (s != "rounded") { r = Tailwind.Rest(s, "rounded-"); }
        string corner = "";
        string size = r;
        string head = r;
        int dash = Tailwind.IndexOf(r, "-");
        if (dash > 0) { head = r.Substring(0, dash); }
        if (Tailwind.IsCorner(head)) {
            corner = head;
            size = "";
            if (dash > 0) { size = r.Substring(dash + 1, r.Length - dash - 1); }
        }
        return Tailwind.RoundApply(b, corner, size);
    }

    static bool IsCorner(string v) {
        return v == "t" || v == "r" || v == "b" || v == "l" || v == "tl"
            || v == "tr" || v == "br" || v == "bl";
    }

    /// 把半径写成 `tl tr br bl` 四元组，只有被点到的角取值。
    static bool RoundApply(StyleBox b, string corner, string size) {
        string v = Tailwind.Radius(size);
        if (v == "") { return false; }
        if (corner == "") { return Tailwind.D(b, "border-radius", v); }
        string tl = "0"; string tr = "0"; string br = "0"; string bl = "0";
        if (corner == "t") { tl = v; tr = v; }
        else if (corner == "b") { br = v; bl = v; }
        else if (corner == "l") { tl = v; bl = v; }
        else if (corner == "r") { tr = v; br = v; }
        else if (corner == "tl") { tl = v; }
        else if (corner == "tr") { tr = v; }
        else if (corner == "br") { br = v; }
        else { bl = v; }
        return Tailwind.D(b, "border-radius", tl + " " + tr + " " + br + " " + bl);
    }

    static string Radius(string v) {
        if (v == "") { return "4"; }
        if (v == "none") { return "0"; }
        if (v == "sm") { return "2"; }
        if (v == "md") { return "6"; }
        if (v == "lg") { return "8"; }
        if (v == "xl") { return "12"; }
        if (v == "2xl") { return "16"; }
        if (v == "3xl") { return "24"; }
        if (v == "full") { return "999"; }
        string arb = Tailwind.Arb(v);
        if (arb != "") { return arb; }
        return "";
    }

    // ---- 过渡 / 变换 / 动画 -------------------------------------------------

    /// `transition duration-200 ease-out scale-105 -translate-y-1 rotate-45
    /// animate-spin`。
    static bool Motion(StyleBox b, string s, string sign) {
        if (sign == "") {
            if (s == "transition" || Tailwind.Pre(s, "transition-")) {
                string r = "";
                if (s != "transition") { r = Tailwind.Rest(s, "transition-"); }
                if (r == "none") { return Tailwind.D(b, "transition", "0ms"); }
                return Tailwind.D(b, "transition", "150ms");
            }
            if (Tailwind.Pre(s, "duration-")) {
                string d = Tailwind.Rest(s, "duration-");
                string arb = Tailwind.Arb(d);
                if (arb != "") { return Tailwind.D(b, "transition-duration", arb); }
                return Tailwind.D(b, "transition-duration", d + "ms");
            }
            if (Tailwind.Pre(s, "ease-")) {
                return Tailwind.D(b, "transition-timing-function",
                                  Tailwind.Easing(Tailwind.Rest(s, "ease-")));
            }
            if (Tailwind.Pre(s, "animate-")) {
                return Tailwind.D(b, "animation",
                                  Tailwind.Rest(s, "animate-") + " 1000ms");
            }
            if (Tailwind.Pre(s, "scale-")) {
                return Tailwind.D(b, "transform",
                                  "scale(" + Tailwind.Rest(s, "scale-") + "%)");
            }
        }
        if (Tailwind.Pre(s, "translate-x-")) {
            return Tailwind.D(b, "transform",
                              "translateX(" + Tailwind.Len(Tailwind.Rest(s, "translate-x-"), sign) + ")");
        }
        if (Tailwind.Pre(s, "translate-y-")) {
            return Tailwind.D(b, "transform",
                              "translateY(" + Tailwind.Len(Tailwind.Rest(s, "translate-y-"), sign) + ")");
        }
        if (Tailwind.Pre(s, "rotate-")) {
            return Tailwind.D(b, "transform",
                              "rotate(" + sign + Tailwind.Rest(s, "rotate-") + "deg)");
        }
        return false;
    }

    /// `ease-*` 的 CSS 缓动名（未知返回 ""，token 因此被忽略）。
    static string Easing(string v) {
        if (v == "linear") { return "linear"; }
        if (v == "in") { return "ease-in"; }
        if (v == "out") { return "ease-out"; }
        if (v == "in-out") { return "ease-in-out"; }
        return "";
    }

    // ---- 其余（定位偏移 / 层级 / 光标）--------------------------------------

    /// `top-2 inset-0 z-10 order-2 columns-3 cursor-pointer`。
    static bool Misc(StyleBox b, string s, string sign) {
        if (Tailwind.Pre(s, "top-")) {
            return Tailwind.D(b, "top", Tailwind.Len(Tailwind.Rest(s, "top-"), sign));
        }
        if (Tailwind.Pre(s, "right-")) {
            return Tailwind.D(b, "right", Tailwind.Len(Tailwind.Rest(s, "right-"), sign));
        }
        if (Tailwind.Pre(s, "bottom-")) {
            return Tailwind.D(b, "bottom", Tailwind.Len(Tailwind.Rest(s, "bottom-"), sign));
        }
        if (Tailwind.Pre(s, "left-")) {
            return Tailwind.D(b, "left", Tailwind.Len(Tailwind.Rest(s, "left-"), sign));
        }
        if (Tailwind.Pre(s, "inset-x-")) {
            string v = Tailwind.Len(Tailwind.Rest(s, "inset-x-"), sign);
            Tailwind.D(b, "left", v);
            return Tailwind.D(b, "right", v);
        }
        if (Tailwind.Pre(s, "inset-y-")) {
            string v = Tailwind.Len(Tailwind.Rest(s, "inset-y-"), sign);
            Tailwind.D(b, "top", v);
            return Tailwind.D(b, "bottom", v);
        }
        if (Tailwind.Pre(s, "inset-")) {
            string v = Tailwind.Len(Tailwind.Rest(s, "inset-"), sign);
            Tailwind.D(b, "top", v);
            Tailwind.D(b, "right", v);
            Tailwind.D(b, "bottom", v);
            return Tailwind.D(b, "left", v);
        }
        if (sign != "") { return false; }
        if (Tailwind.Pre(s, "z-")) {
            string v = Tailwind.Rest(s, "z-");
            if (v == "auto") { return false; }
            return Tailwind.D(b, "z-index", v);
        }
        if (Tailwind.Pre(s, "order-")) {
            return Tailwind.D(b, "order", Tailwind.Rest(s, "order-"));
        }
        if (Tailwind.Pre(s, "columns-")) {
            return Tailwind.D(b, "columns", Tailwind.Rest(s, "columns-"));
        }
        if (Tailwind.Pre(s, "cursor-")) {
            return Tailwind.D(b, "cursor", Tailwind.Rest(s, "cursor-"));
        }
        return false;
    }

    // ---- 值 ----------------------------------------------------------------

    /// 间距刻度：`4` -> 16px、`1.5` -> 6px、`px` -> 1px、`0` -> 0，
    /// 任意值 `[10px]` 原样透出。`sign` 为 "-" 时取负。
    static string Len(string v, string sign) {
        if (v == "") { return ""; }
        string arb = Tailwind.Arb(v);
        if (arb != "") { return sign + arb; }
        if (v == "px") { return sign + "1"; }
        if (v == "auto") { return ""; }
        if (Tailwind.IndexOf(v, "%") > 0) { return sign + v; }
        if (!StyleSheet.IsNumeric(v)) { return ""; }
        int dot = Tailwind.IndexOf(v, ".");
        int whole = StyleSheet.Num(v);
        int px = whole * 4;
        if (dot > 0) {
            string frac = v.Substring(dot + 1, v.Length - dot - 1);
            px = StyleSheet.Num(v.Substring(0, dot)) * 4;
            if (StyleSheet.Num(frac) == 5) { px = px + 2; }
        }
        return sign + Convert.ToString(px);
    }

    /// 颜色 token：调色板名（`slate-800`）、任意值（`[#0f172a]`）、
    /// `white/black/transparent`，都可带 `/40` 透明度。
    static string ColorOrArb(string v) {
        string arb = Tailwind.Arb(v);
        if (arb != "") { return arb; }
        return Tailwind.Color(v);
    }

    /// 调色板查表：`blue-500` -> `#3b82f6`，`black/40` -> `#66000000`。
    /// 未知名称返回 ""，token 因此原样留给皮肤。
    static string Color(string name) {
        string v = name;
        int alpha = 0 - 1;
        int slash = Tailwind.IndexOf(v, "/");
        if (slash > 0) {
            alpha = StyleSheet.Num(v.Substring(slash + 1, v.Length - slash - 1));
            v = v.Substring(0, slash);
        }
        string hex = Tailwind.Swatch(v);
        if (hex == "") { return ""; }
        if (alpha < 0) { return hex; }
        return "#" + Tailwind.HexPair(alpha * 255 / 100) + Tailwind.Rest(hex, "#");
    }

    /// 单个色板格：色系名 + 色阶（Tailwind 默认调色板）。
    static string Swatch(string v) {
        if (v == "white") { return "#ffffff"; }
        if (v == "black") { return "#000000"; }
        if (v == "transparent" || v == "current" || v == "inherit") {
            return "transparent";
        }
        int dash = Tailwind.LastIndexOf(v, "-");
        if (dash <= 0) { return ""; }
        string family = v.Substring(0, dash);
        int shade = Tailwind.ShadeIndex(v.Substring(dash + 1, v.Length - dash - 1));
        if (shade < 0) { return ""; }
        string row = Tailwind.Family(family);
        if (row == "") { return ""; }
        List<string> cols = row.Split(" ");
        if (shade >= cols.Count) { return ""; }
        return cols[shade];
    }

    /// 色阶 -> 列号（50、100..900、950）。
    static int ShadeIndex(string shade) {
        if (shade == "50") { return 0; }
        if (shade == "100") { return 1; }
        if (shade == "200") { return 2; }
        if (shade == "300") { return 3; }
        if (shade == "400") { return 4; }
        if (shade == "500") { return 5; }
        if (shade == "600") { return 6; }
        if (shade == "700") { return 7; }
        if (shade == "800") { return 8; }
        if (shade == "900") { return 9; }
        if (shade == "950") { return 10; }
        return 0 - 1;
    }

    /// 一个色系的 11 个色阶，按 50..950 排列。
    static string Family(string f) {
        if (f == "slate") {
            return "#f8fafc #f1f5f9 #e2e8f0 #cbd5e1 #94a3b8 #64748b #475569 #334155 #1e293b #0f172a #020617";
        }
        if (f == "gray") {
            return "#f9fafb #f3f4f6 #e5e7eb #d1d5db #9ca3af #6b7280 #4b5563 #374151 #1f2937 #111827 #030712";
        }
        if (f == "zinc") {
            return "#fafafa #f4f4f5 #e4e4e7 #d4d4d8 #a1a1aa #71717a #52525b #3f3f46 #27272a #18181b #09090b";
        }
        if (f == "neutral") {
            return "#fafafa #f5f5f5 #e5e5e5 #d4d4d4 #a3a3a3 #737373 #525252 #404040 #262626 #171717 #0a0a0a";
        }
        if (f == "stone") {
            return "#fafaf9 #f5f5f4 #e7e5e4 #d6d3d1 #a8a29e #78716c #57534e #44403c #292524 #1c1917 #0c0a09";
        }
        if (f == "red") {
            return "#fef2f2 #fee2e2 #fecaca #fca5a5 #f87171 #ef4444 #dc2626 #b91c1c #991b1b #7f1d1d #450a0a";
        }
        if (f == "orange") {
            return "#fff7ed #ffedd5 #fed7aa #fdba74 #fb923c #f97316 #ea580c #c2410c #9a3412 #7c2d12 #431407";
        }
        if (f == "amber") {
            return "#fffbeb #fef3c7 #fde68a #fcd34d #fbbf24 #f59e0b #d97706 #b45309 #92400e #78350f #451a03";
        }
        if (f == "yellow") {
            return "#fefce8 #fef9c3 #fef08a #fde047 #facc15 #eab308 #ca8a04 #a16207 #854d0e #713f12 #422006";
        }
        if (f == "lime") {
            return "#f7fee7 #ecfccb #d9f99d #bef264 #a3e635 #84cc16 #65a30d #4d7c0f #3f6212 #365314 #1a2e05";
        }
        if (f == "green") {
            return "#f0fdf4 #dcfce7 #bbf7d0 #86efac #4ade80 #22c55e #16a34a #15803d #166534 #14532d #052e16";
        }
        if (f == "emerald") {
            return "#ecfdf5 #d1fae5 #a7f3d0 #6ee7b7 #34d399 #10b981 #059669 #047857 #065f46 #064e3b #022c22";
        }
        if (f == "teal") {
            return "#f0fdfa #ccfbf1 #99f6e4 #5eead4 #2dd4bf #14b8a6 #0d9488 #0f766e #115e59 #134e4a #042f2e";
        }
        if (f == "cyan") {
            return "#ecfeff #cffafe #a5f3fc #67e8f9 #22d3ee #06b6d4 #0891b2 #0e7490 #155e75 #164e63 #083344";
        }
        if (f == "sky") {
            return "#f0f9ff #e0f2fe #bae6fd #7dd3fc #38bdf8 #0ea5e9 #0284c7 #0369a1 #075985 #0c4a6e #082f49";
        }
        if (f == "blue") {
            return "#eff6ff #dbeafe #bfdbfe #93c5fd #60a5fa #3b82f6 #2563eb #1d4ed8 #1e40af #1e3a8a #172554";
        }
        if (f == "indigo") {
            return "#eef2ff #e0e7ff #c7d2fe #a5b4fc #818cf8 #6366f1 #4f46e5 #4338ca #3730a3 #312e81 #1e1b4b";
        }
        if (f == "violet") {
            return "#f5f3ff #ede9fe #ddd6fe #c4b5fd #a78bfa #8b5cf6 #7c3aed #6d28d9 #5b21b6 #4c1d95 #2e1065";
        }
        if (f == "purple") {
            return "#faf5ff #f3e8ff #e9d5ff #d8b4fe #c084fc #a855f7 #9333ea #7e22ce #6b21a8 #581c87 #3b0764";
        }
        if (f == "fuchsia") {
            return "#fdf4ff #fae8ff #f5d0fe #f0abfc #e879f9 #d946ef #c026d3 #a21caf #86198f #701a75 #4a044e";
        }
        if (f == "pink") {
            return "#fdf2f8 #fce7f3 #fbcfe8 #f9a8d4 #f472b6 #ec4899 #db2777 #be185d #9d174d #831843 #500724";
        }
        if (f == "rose") {
            return "#fff1f2 #ffe4e6 #fecdd3 #fda4af #fb7185 #f43f5e #e11d48 #be123c #9f1239 #881337 #4c0519";
        }
        return "";
    }

    /// 0..255 -> 两位十六进制。
    static string HexPair(int v) {
        int n = v;
        if (n < 0) { n = 0; }
        if (n > 255) { n = 255; }
        return Tailwind.HexDigit(n / 16) + Tailwind.HexDigit(n % 16);
    }

    static string HexDigit(int d) {
        if (d < 10) { return Convert.ToString(d); }
        if (d == 10) { return "a"; }
        if (d == 11) { return "b"; }
        if (d == 12) { return "c"; }
        if (d == 13) { return "d"; }
        if (d == 14) { return "e"; }
        return "f";
    }

    /// 任意值 `[...]` 的内容（下划线还原成空格），不是任意值时返回 ""。
    static string Arb(string v) {
        if (v.Length < 3) { return ""; }
        if (v.Substring(0, 1) != "[") { return ""; }
        if (v.Substring(v.Length - 1, 1) != "]") { return ""; }
        string inner = v.Substring(1, v.Length - 2);
        string outp = "";
        for (int i = 0; i < inner.Length; i = i + 1) {
            string ch = inner.Substring(i, 1);
            if (ch == "_") { ch = " "; }
            outp = outp + ch;
        }
        return outp;
    }

    // ---- 小工具 ------------------------------------------------------------

    /// 一条声明；返回 true 表示引擎认得这个属性。
    static bool D(StyleBox b, string key, string val) {
        if (val == "") { return false; }
        return StyleSheet.Decl(b, key, val);
    }

    static bool Pre(string s, string prefix) {
        return StyleSheet.StartsWith(s, prefix);
    }

    static string Rest(string s, string prefix) {
        if (!StyleSheet.StartsWith(s, prefix)) { return s; }
        return s.Substring(prefix.Length, s.Length - prefix.Length);
    }

    /// `mark` 之后的部分（用于 `gap-x-2` / `space-x-2` 这种同尾拼写）。
    static string After(string s, string mark) {
        int at = Tailwind.IndexOf(s, mark);
        if (at < 0) { return ""; }
        return s.Substring(at + mark.Length, s.Length - at - mark.Length);
    }

    static int IndexOf(string s, string needle) {
        return Css.IndexFrom(s, needle, 0);
    }

    static int LastIndexOf(string s, string needle) {
        int found = 0 - 1;
        for (int i = 0; i < s.Length; i = i + 1) {
            if (s.Substring(i, 1) == needle) { found = i; }
        }
        return found;
    }

    /// 变体前缀分隔的 `:` 的位置；任意值里的 `:` 不算（`bg-[url(a:b)]`）。
    static int Colon(string s) {
        int at = Tailwind.IndexOf(s, ":");
        if (at < 0) { return 0 - 1; }
        int bracket = Tailwind.IndexOf(s, "[");
        if (bracket >= 0 && bracket < at) { return 0 - 1; }
        return at;
    }
}
