using System;
using System.IO;
using Gui;

namespace Gui.Backend;

/// 在系统模态尺寸调整循环里就地绘制的一帧（见
/// Window.SetSizePaint）。
delegate void SizePaintBody();

/// <summary>
/// 跨平台抽象的窗口与事件管理。
/// 委托给处理 Win32/X11/Cocoa 的 zan_gui 运行时。
/// </summary>
class Window {
    // 这些导入确保链接器包含 gui_runtime 所需的系统库
    [DllImport("user32")]
    static extern nint GetModuleHandleA(nint reserved);

    [DllImport("gdi32")]
    static extern nint GetStockObject(int fnObject);

    [DllImport("kernel32")]
    static extern int GetTickCount();

    #if !WINDOWS
    [DllImport("zan_gui")]
    static extern nint zan_gui_create_window(string title, int width, int height);

    [DllImport("zan_gui")]
    static extern int zan_gui_show_window(nint hwnd);

    [DllImport("zan_gui")]
    static extern int zan_gui_wait_event();

    [DllImport("zan_gui")]
    static extern int zan_gui_wait_event_timeout(int ms);

    [DllImport("zan_gui")]
    static extern int zan_gui_poll_event();

    [DllImport("zan_gui")]
    static extern int zan_gui_wake();

    [DllImport("zan_gui")]
    static extern int zan_gui_inject_event(nint hwnd, int kind, int x, int y,
        int button, int keycode, int mods);

    [DllImport("zan_gui")]
    static extern int zan_gui_inject_pending();

    [DllImport("zan_gui")]
    static extern int zan_gui_event_kind();

    [DllImport("zan_gui")]
    static extern string zan_gui_drop_take();

    [DllImport("zan_gui")]
    static extern int zan_gui_event_x();

    [DllImport("zan_gui")]
    static extern int zan_gui_event_y();

    [DllImport("zan_gui")]
    static extern int zan_gui_event_button();

    [DllImport("zan_gui")]
    static extern int zan_gui_event_keycode();

    [DllImport("zan_gui")]
    static extern int zan_gui_event_mods();

    [DllImport("zan_gui")]
    static extern int zan_gui_window_width();

    [DllImport("zan_gui")]
    static extern int zan_gui_window_height();

    [DllImport("zan_gui")]
    static extern nint zan_gui_event_hwnd();

    [DllImport("zan_gui")]
    static extern int zan_gui_client_width(nint hwnd);

    [DllImport("zan_gui")]
    static extern int zan_gui_client_height(nint hwnd);

    [DllImport("zan_gui")]
    static extern int zan_gui_present(nint hwnd, int surfaceId);

    [DllImport("zan_gui")]
    static extern int zan_gui_present_dirty_add(int x, int y, int w, int h);

    [DllImport("zan_gui")]
    static extern int zan_gui_set_title(nint hwnd, string title);

    [DllImport("zan_gui")]
    static extern int zan_gui_set_cursor(int cursorType);

    [DllImport("zan_gui")]
    static extern long zan_gui_get_tick_ms();

    [DllImport("zan_gui")]
    static extern void zan_gui_sleep_ms(int ms);

    [DllImport("zan_gui")]
    static extern int zan_gui_minimize(nint hwnd);

    [DllImport("zan_gui")]
    static extern int zan_gui_toggle_maximize(nint hwnd);

    [DllImport("zan_gui")]
    static extern int zan_gui_close_window(nint hwnd);

    [DllImport("zan_gui")]
    static extern int zan_gui_destroy_window(nint hwnd);

    [DllImport("zan_gui")]
    static extern int zan_gui_is_maximized(nint hwnd);

    [DllImport("zan_gui")]
    static extern int zan_gui_window_visible(nint hwnd);

    [DllImport("zan_gui")]
    static extern int zan_gui_window_focused(nint hwnd);

    [DllImport("zan_gui")]
    static extern int zan_gui_set_topmost(nint hwnd, int on);

    [DllImport("zan_gui")]
    static extern int zan_gui_set_caption_buttons(nint hwnd, int count);

    [DllImport("zan_gui")]
    static extern int zan_gui_titlebar_height();

    [DllImport("zan_gui")]
    static extern int zan_gui_caption_button_width();

    /// 在窗口后启用系统原生半透明玻璃（Win11 亚克力、
    /// macOS NSVisualEffectView、Linux 合成器模糊），
    /// 凡表面透明处生效。tint 为打包的 ARGB 颜色；alpha 控制磨砂强度。
    /// 在没有原生背景的平台上安全地空操作。
    [DllImport("zan_gui")]
    static extern int zan_gui_enable_glass(nint hwnd, int tintArgb);
    /// 将窗口恢复不透明（移除原生半透明合成）。
    [DllImport("zan_gui")]
    static extern int zan_gui_disable_glass(nint hwnd);
    /// 以百分比（10..100）设置整个窗口的不透明度；100 恢复不透明。
    [DllImport("zan_gui")]
    static extern int zan_gui_set_opacity(nint hwnd, int percent);
    /// 将窗口左上角移动到屏幕工作区的 (x, y) 像素位置。
    [DllImport("zan_gui")]
    static extern int zan_gui_set_window_pos(nint hwnd, int x, int y);
    /// 在显示器工作区上重新居中窗口。
    [DllImport("zan_gui")]
    static extern int zan_gui_center_window(nint hwnd);
    /// 清除上一帧注册的所有客户端优先条带。
    [DllImport("zan_gui")]
    static extern int zan_gui_clear_hit_guards(nint hwnd);
    /// 为客户端像素矩形抢占边框的边缘缩放区域。
    [DllImport("zan_gui")]
    static extern int zan_gui_add_hit_guard(nint hwnd, int x, int y, int w, int h);
    #endif

    nint handle;
    int width;
    int height;



    /// <summary>创建新的平台窗口。</summary>
    Window(string title, int width, int height) {
        #if WINDOWS
        this.handle = Win32Shell.CreateWindow(title, width, height);
        #else
        this.handle = zan_gui_create_window(title, width, height);
        #endif
        this.width = width;
        this.height = height;
    }

    /// <summary>注册一个在系统模态尺寸调整循环里被调用的帧体。
    /// 拖动窗口边框时消息循环停在 OS 内部，应用自己的循环拿不到
    /// 控制权，表面会一直停在旧尺寸上，新露出的一条是空白，直到
    /// 松手为止；窗口过程收到 WM_SIZE 时回调它，就能就地画出
    /// 新尺寸的一帧。</summary>
    static void SetSizePaint(SizePaintBody body) {
        #if WINDOWS
        Win32Shell.SetSizePaint(body);
        #else
        // SDL 后端拖动边框时仍会送出正常的 resize 事件
        // （见 gui_runtime_sdl.c 的模态循环处理），应用循环
        // 自己就能画下一帧，无需从窗口过程回调。
        Window.sizePaintUnused = body;
        #endif
    }

    #if !WINDOWS
    static SizePaintBody sizePaintUnused;
    #endif

    /// <summary>在屏幕上显示窗口。</summary>
    void Show() {
        #if WINDOWS
        Win32Shell.ShowWindowNow((nint)handle);
        #else
        zan_gui_show_window(handle);
        #endif
    }

    /// <summary>将窗口左上角移动到屏幕工作区的 (x, y) 像素位置。</summary>
    void SetPosition(int x, int y) {
        #if WINDOWS
        Win32Shell.SetWindowPosition((nint)handle, x, y);
        #else
        zan_gui_set_window_pos(handle, x, y);
        #endif
    }

    /// <summary>在显示器工作区上居中窗口。</summary>
    void Center() {
        #if WINDOWS
        Win32Shell.CenterWindow((nint)handle);
        #else
        zan_gui_center_window(handle);
        #endif
    }

    /// <summary>阻塞直到下一个 OS 事件到达。成功返回 0，退出返回 -1。</summary>
    int WaitEvent() {
        #if WINDOWS
        return Win32Shell.WaitEvent();
        #else
        return zan_gui_wait_event();
        #endif
    }

    /// <summary>阻塞直到 OS 事件到达或 `ms` 毫秒过去。
    /// 返回 0=收到事件、1=超时、-1=退出。在内核中空闲，
    /// 等待下一帧截止时间的动画循环不消耗 CPU。</summary>
    int WaitEventTimeout(int ms) {
        #if WINDOWS
        return Win32Shell.WaitEventTimeout(ms);
        #else
        return zan_gui_wait_event_timeout(ms);
        #endif
    }

    /// <summary>不阻塞地轮询事件。返回 0=收到事件、1=无事件、-1=退出。</summary>
    int PollEvent() {
        #if WINDOWS
        return Win32Shell.PollEvent();
        #else
        return zan_gui_poll_event();
        #endif
    }

    /// <summary>
    /// 从任意线程唤醒阻塞在 WaitEvent 中的 UI 线程，使其能排空
    /// App 分发队列。线程安全。由 App.Post 使用。
    /// </summary>
    void Wake() {
        #if WINDOWS
        Win32Shell.Wake();
        #else
        zan_gui_wake();
        #endif
    }

    /// <summary>为此窗口排队一个合成输入事件，由
    /// 下一次 PollEvent/WaitEvent 与真实 OS 事件一样取出。
    /// UI 自动化驱动（Gui.UiDriver）用它驱动应用，
    /// 无需移动系统鼠标或合成系统按键。`kind`/`button`/`keycode`/`mods`
    /// 与 EventKind()/EventButton()/EventKeyCode()/
    /// EventMods() 使用相同的编码。</summary>
    void InjectEvent(int kind, int x, int y, int button, int keycode, int mods) {
        #if WINDOWS
        Win32Shell.InjectEvent((nint)handle, kind, x, y, button, keycode, mods);
        #else
        zan_gui_inject_event(handle, kind, x, y, button, keycode, mods);
        #endif
    }

    /// <summary>仍排队的合成事件数量（事件循环
    /// 完全消费驱动器最后一批后为 0）。</summary>
    static int InjectPending() {
        #if WINDOWS
        return Win32Shell.InjectPending();
        #else
        return zan_gui_inject_pending();
        #endif
    }

    /// <summary>上次文件拖放事件（kind 9）携带的文件路径，
    /// 取出即从队列移除：应用看到该事件时调用一次。
    /// 拖放位置为 EventX()/EventY()（客户端像素），应用可将
    /// 文件路由到光标下的控件。</summary>
    List<string> TakeDroppedFiles() {
        #if WINDOWS
        return Win32Shell.TakeDropped();
        #else
        List<string> outp = new List<string>();
        string p = zan_gui_drop_take();
        while (p != "") {
            outp.Add(p);
            p = zan_gui_drop_take();
        }
        return outp;
        #endif
    }

    /// <summary>返回最近一次事件类型（0=无、1=鼠标移动、2=鼠标按下、3=鼠标释放、4=按键按下、5=按键释放、6=文本输入、7=调整大小、8=关闭、9=文件拖放、13=滚动）。</summary>
    int EventKind() {
        #if WINDOWS
        return Win32Shell.EventKindValue();
        #else
        return zan_gui_event_kind();
        #endif
    }
    int EventX() {
        #if WINDOWS
        return Win32Shell.EventXValue();
        #else
        return zan_gui_event_x();
        #endif
    }
    int EventY() {
        #if WINDOWS
        return Win32Shell.EventYValue();
        #else
        return zan_gui_event_y();
        #endif
    }
    int EventButton() {
        #if WINDOWS
        return Win32Shell.EventButtonValue();
        #else
        return zan_gui_event_button();
        #endif
    }
    int EventKeyCode() {
        #if WINDOWS
        return Win32Shell.EventKeyCodeValue();
        #else
        return zan_gui_event_keycode();
        #endif
    }
    int EventMods() {
        #if WINDOWS
        return Win32Shell.EventModsValue();
        #else
        return zan_gui_event_mods();
        #endif
    }

    int GetWidth() {
        #if WINDOWS
        return Win32Shell.WindowWidth();
        #else
        return zan_gui_window_width();
        #endif
    }
    int GetHeight() {
        #if WINDOWS
        return Win32Shell.WindowHeight();
        #else
        return zan_gui_window_height();
        #endif
    }

    /// <summary>此窗口的原生句柄（不透明；用于事件路由）。</summary>
    nint GetHandle() { return handle; }

    /// <summary>产生最近一次事件的窗口句柄，
    /// 拥有多个顶层窗口的应用可据此正确路由事件。</summary>
    static nint EventHwnd() {
        #if WINDOWS
        return Win32Shell.EventWindow();
        #else
        return zan_gui_event_hwnd();
        #endif
    }

    /// <summary>本窗口客户区宽/高（设备像素），按窗口查询
    /// （不同于反映最近调整大小的窗口的 GetWidth）。</summary>
    int ClientWidth() {
        #if WINDOWS
        return Win32Shell.ClientWidth((nint)handle);
        #else
        return zan_gui_client_width(handle);
        #endif
    }
    int ClientHeight() {
        #if WINDOWS
        return Win32Shell.ClientHeight((nint)handle);
        #else
        return zan_gui_client_height(handle);
        #endif
    }

    /// <summary>将 Canvas（表面）呈现到窗口。</summary>
    void Present(Canvas canvas) {
        #if WINDOWS
        Win32Shell.Present((nint)handle, canvas.surfaceId);
        #else
        zan_gui_present(handle, canvas.surfaceId);
        #endif
    }

    /// <summary>将下一次 Present 限制在声明的像素上：
    /// 只重绘了几个小矩形的帧只需几次小
    /// 上传，而非整个表面。声明每个变化的矩形
    /// ——遗漏的部分保留先前呈现的像素。
    /// 不声明（默认）则呈现全部。</summary>
    void PresentDirty(int x, int y, int w, int h) {
        #if WINDOWS
        Win32Shell.PresentDirty(x, y, w, h);
        #else
        zan_gui_present_dirty_add(x, y, w, h);
        #endif
    }

    /// <summary>设置窗口标题。</summary>
    void SetTitle(string title) {
        #if WINDOWS
        Win32Shell.SetTitle((nint)handle, title);
        #else
        zan_gui_set_title(handle, title);
        #endif
    }

    /// <summary>设置鼠标光标类型。</summary>
    static void SetCursor(int cursorType) {
        #if WINDOWS
        Win32Shell.SetCursorShape(cursorType);
        #else
        zan_gui_set_cursor(cursorType);
        #endif
    }

    /// <summary>返回当前时间（毫秒）。</summary>
    static int GetTickMs() {
        #if WINDOWS
        return Win32Shell.TickMs();
        #else
        return zan_gui_get_tick_ms();
        #endif
    }

    /// <summary>让调用线程休眠指定的毫秒数（帧节奏控制）。</summary>
    static void SleepMs(int ms) {
        #if WINDOWS
        Win32Shell.Sleep(ms);
        #else
        zan_gui_sleep_ms(ms);
        #endif
    }

    /// <summary>最小化窗口。</summary>
    void Minimize() {
        #if WINDOWS
        Win32Shell.Minimize((nint)handle);
        #else
        zan_gui_minimize(handle);
        #endif
    }

    /// <summary>在最大化与还原之间切换。</summary>
    void ToggleMaximize() {
        #if WINDOWS
        Win32Shell.ToggleMaximize((nint)handle);
        #else
        zan_gui_toggle_maximize(handle);
        #endif
    }

    /// <summary>请求关闭窗口。</summary>
    void Close() {
        #if WINDOWS
        Win32Shell.CloseWindow((nint)handle);
        #else
        zan_gui_close_window(handle);
        #endif
    }

    /// <summary>彻底拆除窗口（销毁 OS 窗口）。
    /// 在响应关闭事件后调用，避免对话框作为
    /// 孤儿滞留；在主窗口上为空操作。</summary>
    void Destroy() {
        #if WINDOWS
        Win32Shell.Destroy((nint)handle);
        #else
        zan_gui_destroy_window(handle);
        #endif
    }

    /// <summary>窗口当前处于最大化状态时为真。</summary>
    bool IsMaximized() {
        #if WINDOWS
        return Win32Shell.Maximized((nint)handle);
        #else
        return zan_gui_is_maximized(handle) != 0;
        #endif
    }

    /// <summary>窗口任意部分可见时（未最小化
    /// 且未被其他窗口完全遮挡）为真。环境动画
    /// 在该值为假时暂停。</summary>
    bool IsVisible() {
        #if WINDOWS
        return Win32Shell.Visible((nint)handle);
        #else
        return zan_gui_window_visible(handle) != 0;
        #endif
    }

    /// <summary>此窗口持有输入焦点时为真。
    /// 此时环境动画会减速至心跳节奏。</summary>
    bool IsFocused() {
        #if WINDOWS
        return Win32Shell.Focused((nint)handle);
        #else
        return zan_gui_window_focused(handle) != 0;
        #endif
    }

    /// <summary>在此窗口后启用系统原生半透明玻璃，
    /// 由打包的 ARGB `tint` 着色。渲染器必须将表面清为
    /// 透明，效果才能透出。</summary>
    void EnableGlass(int tint) {
        #if WINDOWS
        Win32Shell.EnableGlass((nint)handle, tint);
        #else
        zan_gui_enable_glass(handle, tint);
        #endif
    }

    /// <summary>恢复为不透明窗口。</summary>
    void DisableGlass() {
        #if WINDOWS
        Win32Shell.DisableGlass((nint)handle);
        #else
        zan_gui_disable_glass(handle);
        #endif
    }

    /// 整个窗口的不透明度（百分比），限制在 10..100。100 = 完全不透明。
    void SetOpacity(int percent) {
        #if WINDOWS
        Win32Shell.SetOpacity((nint)handle, percent);
        #else
        zan_gui_set_opacity(handle, percent);
        #endif
    }

    /// 窗口轮廓为形状区域的并集，`spec` 格式：
    /// "t,x,y,w,h,r;t,x,y,w,h,r;..."（逻辑像素；1 = 圆角矩形、2 =
    /// 椭圆）。"" 恢复为普通不透明矩形。DWM 开启时以逐像素
    /// alpha（分层窗口）合成，DWM 关闭时以合并区域
    /// 合成，因此异形窗口在 Windows 7 上也能工作。轮廓
    /// 具有抗锯齿边缘（DWM），外部区域对
    /// 绘制和鼠标输入都透明。不应用亚克力模糊。仅限 Windows；
    /// 其他平台为安全空操作。
    void SetShape(string spec) {
        #if WINDOWS
        Win32Shell.SetShape((nint)handle, spec);
        #endif
    }

    /// <summary>启用或禁用窗口置顶（topmost）。</summary>
    void SetTopmost(bool on) {
        int v = 0;
        if (on) { v = 1; }
        #if WINDOWS
        Win32Shell.SetTopmost((nint)handle, on);
        #else
        zan_gui_set_topmost(handle, v);
        #endif
    }

    /// <summary>告知运行时框架绘制多少个标题按钮，
    /// 使可拖拽标题栏区域排除它们。</summary>
    void SetCaptionButtons(int count) {
        #if WINDOWS
        Win32Shell.SetCaptionButtons(handle, count);
        #else
        zan_gui_set_caption_buttons(handle, count);
        #endif
    }

    /// <summary>清除上一帧声明的客户端优先条带（见
    /// <see cref="AddHitGuard"/>）。由应用每帧调用一次。</summary>
    void ClearHitGuards() {
        #if WINDOWS
        Win32Shell.ClearHitGuards((nint)handle);
        #else
        zan_gui_clear_hit_guards(handle);
        #endif
    }

    /// <summary>为客户端区域抢占一个矩形（客户端像素），
    /// 使边框边缘缩放手柄不遮挡紧贴窗口边缘绘制的控件。
    /// 角手柄保持优先。</summary>
    void AddHitGuard(int x, int y, int w, int h) {
        #if WINDOWS
        Win32Shell.AddHitGuard((nint)handle, x, y, w, h);
        #else
        zan_gui_add_hit_guard(handle, x, y, w, h);
        #endif
    }

    /// <summary>为自定义标题栏保留的高度（设备像素）。</summary>
    static int TitlebarHeight() {
        #if WINDOWS
        return Win32Shell.TitlebarHeight();
        #else
        return zan_gui_titlebar_height();
        #endif
    }

    /// <summary>单个标题按钮的宽度（设备像素）。</summary>
    static int CaptionButtonWidth() {
        #if WINDOWS
        return Win32Shell.CaptionButtonWidth();
        #else
        return zan_gui_caption_button_width();
        #endif
    }
}

/// <summary>系统剪贴板访问（UTF-8 文本）。</summary>
class Clipboard {
    /// 本进程最后一次复制的文本。系统剪贴板可能瞬时被
    /// 别的进程占着（剪贴板管理器、远程桌面……），那时候写入和
    /// 读取都会失败；应用内部的复制粘贴不应该因此丢内容，
    /// 所以读不到时退回这份副本。
    static string last;

    #if !WINDOWS
    [DllImport("zan_gui")]
    static extern int zan_gui_set_clipboard(string text);

    [DllImport("zan_gui")]
    static extern string zan_gui_get_clipboard();
    #endif

    /// <summary>将文本复制到系统剪贴板。成功返回 true。</summary>
    static bool SetText(string text) {
        Clipboard.last = text;
        #if WINDOWS
        return Win32Shell.SetClipboard(text);
        #else
        return zan_gui_set_clipboard(text) == 0;
        #endif
    }

    /// <summary>返回系统剪贴板文本（UTF-8），无文本时返回
    /// ""。</summary>
    static string GetText() {
        string text = "";
        #if WINDOWS
        text = Win32Shell.GetClipboard();
        #else
        text = zan_gui_get_clipboard();
        #endif
        if (text == "" && Clipboard.last != null) { return Clipboard.last; }
        return text;
    }
}

/// <summary>输入法（IME）集成。文本控件报告
/// 光标位置，使组合/候选窗口跟随光标而非
/// 固定在窗口原点。</summary>
class Ime {
    #if !WINDOWS
    [DllImport("zan_gui")]
    static extern void zan_gui_set_ime_pos(int x, int y);
    #endif

    /// <summary>将 IME 组合 + 候选窗口定位到给定的
    /// 客户区像素坐标（通常是光标底部）。</summary>
    static void SetCaret(int x, int y) {
        #if WINDOWS
        Win32Shell.SetImePos(x, y);
        #else
        zan_gui_set_ime_pos(x, y);
        #endif
    }
}

/// <summary>用于导出的最小文件写入（UTF-8，Windows 上加 BOM 以便
/// 记事本和 Excel 按 UTF-8 读取导出）。</summary>
class SysFile {
    /// <summary>将内容写入 path，覆盖已有文件。成功返回 true。</summary>
    static bool Write(string path, string content) {
        #if WINDOWS
        return Win32Shell.WriteTextFile(path, content);
        #else
        try {
            File.WriteAllText(path, content);
            return true;
        } catch (Exception e) {
            return false;
        }
        #endif
    }
}

/// <summary>
/// 与运行时事件编码一致的事件类型常量。
/// </summary>
class EventKind {
    static int None() { return 0; }
    static int MouseMove() { return 1; }
    static int MouseDown() { return 2; }
    static int MouseUp() { return 3; }
    static int KeyDown() { return 4; }
    static int KeyUp() { return 5; }
    static int TextInput() { return 6; }
    static int Resize() { return 7; }
    static int Close() { return 8; }
    static int Scroll() { return 13; }
}

/// <summary>
/// 虚拟键码常量（Windows 上的 VK_*）。
/// </summary>
class Keys {
    static int Escape() { return 27; }
    static int Enter() { return 13; }
    static int Tab() { return 9; }
    static int Backspace() { return 8; }
    static int Delete() { return 46; }
    static int Left() { return 37; }
    static int Up() { return 38; }
    static int Right() { return 39; }
    static int Down() { return 40; }
    static int Home() { return 36; }
    static int End() { return 35; }
    static int PageUp() { return 33; }
    static int PageDown() { return 34; }
    static int Space() { return 32; }
    static int F1() { return 112; }
    static int F2() { return 113; }
    static int F5() { return 116; }
    static int F11() { return 122; }
    static int A() { return 65; }
    static int C() { return 67; }
    static int V() { return 86; }
    static int X() { return 88; }
    static int Z() { return 90; }
    static int S() { return 83; }
}

/// <summary>
/// 来自 EventMods() 的修饰键标志。
/// </summary>
class Modifiers {
    static int Ctrl() { return 1; }
    static int Shift() { return 2; }
    static int Alt() { return 4; }

    static bool HasCtrl(int mods) { return (mods / 1) % 2 == 1; }
    static bool HasShift(int mods) { return (mods / 2) % 2 == 1; }
    static bool HasAlt(int mods) { return (mods / 4) % 2 == 1; }
}
