using System;
using System.IO;
using System.Diagnostics;
using System.Json;
using Gui;

namespace Gui.Backend;

/// 驱动 `dump hitregions` 输出中的一个命中区域。键（z/id/x/y/
/// w/h/type）与旧版 dump 格式一致，保证现有脚本有效。
class HitRegionDoc {
    int z;
    int id;
    int x;
    int y;
    int w;
    int h;
    int type;
}

/// `dump hitregions` 输出的根：区域数量与按注册顺序排列的区域列表。
class HitRegionsDoc {
    int count;
    List<HitRegionDoc> regions;
}

/// 一个控件节点，由 `dump tree` 写出：控件树的形状和布局
/// 结果。截图只能看到“这里是空的”，节点才能说出是控件
/// 没挂上、高度算成了 0，还是被制成了不可见。
class ControlNode {
    string kind;
    string name;
    int dock;
    int visible;
    int x;
    int y;
    int w;
    int h;
    int prefW;
    int prefH;
    List<ControlNode> kids;
}

/// `dump tree` 输出的根：只含保留模式根节点；未通过 SetRoot
/// 登记根时序列化为空树。
class ControlTreeDoc {
    ControlNode root;
}

/// 当前皮肤解析后的样式 token，由 `dump theme` 写出。
///
/// 仅靠几何（hitregions）不足以评判 UI："文本没有
/// 垂直居中"、"这张卡片多了个外框"和"代码框
/// 与其他面板不一致"，这些都是关于像素背后
/// 样式值的判断。导出 token 后，自动化检查可将
/// 控件的实际矩形与皮肤真正要求的 padding/高度/字体
/// 对比，而无需从坐标猜测。
class ThemeDoc {
    int scale;

    int textPrimary;
    int textSecondary;
    int textTertiary;
    int textDisabled;
    int bgPrimary;
    int bgSecondary;
    int bgTertiary;
    int borderPrimary;
    int borderSecondary;
    int divider;
    int primary;
    int shadowColor;

    int borderRadiusSmall;
    int borderRadiusMedium;
    int borderRadiusLarge;
    int borderWidth;

    int fontSizeTiny;
    int fontSizeSmall;
    int fontSizeMedium;
    int fontSizeLarge;
    int fontSizeHuge;

    int heightTiny;
    int heightSmall;
    int heightMedium;
    int heightLarge;

    int paddingTiny;
    int paddingSmall;
    int paddingMedium;
    int paddingLarge;

    int gapSmall;
    int gapMedium;
    int gapLarge;

    // 皮肤模式标志：同一控件根据这些标志以边框、压纹或
    // 硬偏移阴影绘制，因此样式检查在称边框"多余"之前
    // 必须先知道它面对的是哪个系列。
    int glass;
    int gradient;
    int neu;
    int brutal;
}

/// <summary>
/// Gui 框架的 AI 可操作 UI 自动化驱动。
///
/// 驱动脚本不移动系统鼠标、也不做屏幕像素抓取，而是
/// 注入合成输入事件（见 Window.InjectEvent / 原生
/// zan_gui_inject_event），这些事件由真实 OS 输入流经的
/// 同一个轮询/等待事件循环取出。所有命中测试、焦点变化、点击目标和按键
/// 处理程序因此与真人操作时完全相同——应用
/// 通过真实事件分发"从内部"被驱动，而非从外部模拟。
///
/// 可选启用：将环境变量 ZAN_UI_SCRIPT 设为脚本文本路径。
/// 未设置时驱动完全静止，正常 GUI 行为
/// 不受影响。输出（命中区域/编辑器 dump、断言结果日志）
/// 写入 ZAN_UI_OUT（默认 "_scratch/uidrv"）。
///
/// 脚本语法（每行一条命令；空行和 '#' 注释忽略）：
///   wait &lt;ms&gt;                     在下一条命令前暂停 &lt;ms&gt; 毫秒
///   move &lt;x&gt; &lt;y&gt; — 合成鼠标移动
///   click &lt;x&gt; &lt;y&gt; — 在 x,y 处移动+按下+释放（左键）
///   clickid &lt;hitId&gt; — 点击指定 id 命中区域的中心
///   rclick &lt;x&gt; &lt;y&gt; — 在 x,y 处右键点击
///   scroll &lt;x&gt; &lt;y&gt; &lt;delta&gt; — 在 x,y 处滚轮滚动
///   char &lt;code&gt; — 一个文本输入字符（Tab=9/Enter=13/Esc=27）
///   type "&lt;text&gt;" — 逐个输入字面文本的每个字符
///   keydown &lt;code&gt; [mods] — 原始 KeyDown（方向键、F 键、App Tab 焦点）
///   keyup &lt;code&gt; [mods] — 原始 KeyUp（例如 IDE 中的 F5）
///   ev &lt;kind&gt; &lt;x&gt; &lt;y&gt; &lt;btn&gt; &lt;code&gt; &lt;mods&gt; — 原始事件（逃生通道）
///   dump hitregions &lt;file&gt; — 将所有注册的命中区域写入为 JSON
///   dump theme &lt;file&gt; — 将当前皮肤的样式 token 写入为 JSON
///   dump tree &lt;file&gt; — 将保留模式控件树写入为 JSON
///   dump pixels &lt;file&gt; [x y w h] — 将客户区或指定矩形的原始像素写入文件
///   redraw full — 强制下一帧整窗重绘，并等待该帧呈现
///   freeze clock / unfreeze clock — 冻结或恢复测试专用动画时钟
///   dump probe &lt;name&gt; &lt;file&gt; — 写入指定 probe 的当前值
///   assert probe &lt;name&gt; contains &lt;text&gt; — 对照 probe 值记录 PASS/FAIL
///   assert probe &lt;name&gt; equals &lt;text&gt;
///   log &lt;text&gt; — 向结果日志追加一条备注
///   quit — 关闭窗口（结束应用）
///
/// 宿主每帧通过 SetProbe(name, value) 推送命名 probe；
/// IDE 发布 "editor"（缓冲区/光标/补全状态）和 "log"。
/// </summary>
class UiDriver {
    static extern string getenv(string name);

    static bool active;
    static bool finished;
    static App app;
    /// 保留模式的根（Form.Run 登记），供 `dump tree` 遍历。
    static Control root;
    static List<string> cmds;
    static int pc;
    static int waitUntilUs;        // 绝对微秒；仅在 waitArmed 时有效
    static bool waitArmed;         // 是否有挂起等待（时钟会回绕，不能用 0 判断）
    static bool waitFullPresent;
    static string outDir;
    static string resultsPath;
    static int passCount;
    static int failCount;

    static List<string> probeNames;
    static List<string> probeVals;

    /// ZAN_UI_SCRIPT 驱动的会话运行中时为真（可设置 probe）。
    static bool Active() { return active; }

    /// 读取 ZAN_UI_SCRIPT；已设置时加载脚本并启动驱动。
    /// 绑定到给定应用的窗口以注入事件。
    /// 环境变量未设置时为空操作（驱动保持静止）。可多次调用。
    static void Begin(App a) {
        if (active) { return; }
        string path = UiDriver.Env("ZAN_UI_SCRIPT");
        if (path == "") { return; }
        if (!File.Exists(path)) { return; }
        app = a;
        outDir = UiDriver.Env("ZAN_UI_OUT");
        if (outDir == "") { outDir = "_scratch/uidrv"; }
        Directory.CreateDirectoryRecursive(outDir);
        resultsPath = outDir + "/results.log";
        cmds = new List<string>();
        string body = File.ReadAllText(path);
        List<string> raw = body.Replace("\r", "").Split("\n");
        for (int i = 0; i < raw.Count; i = i + 1) { cmds.Add(raw[i]); }
        pc = 0;
        waitUntilUs = 0;
        waitArmed = false;
        waitFullPresent = false;
        passCount = 0;
        failCount = 0;
        probeNames = new List<string>();
        probeVals = new List<string>();
        finished = false;
        active = true;
        File.WriteAllText(resultsPath,
            "# UiDriver session: " + path + " (" + Convert.ToString(cmds.Count)
            + " lines)\n");
        app.RequestRedraw();
    }

    /// 宿主钩子：登记保留模式的根，供 `dump tree`（Form.Run 调用）。
    static void SetRoot(Control c) {
        root = c;
    }

    /// 宿主钩子：释放 `redraw full` 在下一次脚本命令前的呈现屏障。
    static void NotifyPresented(App owner) {
        if (app == owner && waitFullPresent) { waitFullPresent = false; }
    }

    /// 读取环境变量；未设置（null）归一为 ""。
    static string Env(string name) {
        string v = getenv(name);
        if (v == null) { return ""; }
        return v;
    }

    /// 宿主钩子：发布（或覆盖）一个命名的内省 probe。
    static void SetProbe(string name, string val) {
        if (!active) { return; }
        for (int i = 0; i < probeNames.Count; i = i + 1) {
            if (probeNames[i] == name) { probeVals[i] = val; return; }
        }
        probeNames.Add(name);
        probeVals.Add(val);
    }

    /// 读取已发布的 probe 值；未发布过返回 ""。
    static string GetProbe(string name) {
        for (int i = 0; i < probeNames.Count; i = i + 1) {
            if (probeNames[i] == name) { return probeVals[i]; }
        }
        return "";
    }

    /// 推进脚本。每个事件循环迭代调用一次（从
    /// App.ProcessEvent 和 IDE 的自定义循环）。注入下一个事件
    /// 或跳过即时（dump/assert/log）命令。在注入的批次之间
    /// 让出，使每批完全消费并渲染后再进行下一批。
    static void Tick() {
        if (!active || finished) { return; }
        // `redraw full` hands control back to the host. The host clears this
        // gate from PresentFrame, so the next script command cannot observe
        // the pre-redraw surface.
        if (waitFullPresent) {
            app.pollPending = true;
            return;
        }
        // 脚本运行期间保持宿主循环轮询（而非阻塞），使注入的事件
        // 被刷出、基于时间的等待得以推进。只要求循环别睡着，不要求
        // 重绘：把它写成 needsRedraw 会让被驱动的每一帧都变成整窗
        // 重绘，量出来的就不再是应用真实的绘制路径。
        app.pollPending = true;
        // 先让之前注入的批次排空（并完成渲染）。
        if (Window.InjectPending() > 0) { return; }
        int nowUs = Window.GetTickUs();
        if (waitArmed) {
            if (nowUs - waitUntilUs < 0) { return; }
            waitArmed = false;
        }
        while (pc < cmds.Count) {
            string line = cmds[pc];
            pc = pc + 1;
            bool yield = UiDriver.Exec(line);
            if (yield) { return; }
        }
        UiDriver.Finish();
    }

    /// 执行一行命令。注入事件或设置了
    /// 等待时返回 true（调用方应在下一条命令前让循环先处理）。
    static bool Exec(string line) {
        string trimmed = UiDriver.Trim(line);
        if (trimmed == "") { return false; }
        if (UiDriver.StartsWith(trimmed, "#")) { return false; }
        List<string> t = UiDriver.Tok(trimmed);
        string cmd = t[0];

        if (cmd == "wait") {
            int ms = UiDriver.ArgI(t, 1, 0);
            waitUntilUs = Window.GetTickUs() + ms * 1000;
            waitArmed = true;
            UiDriver.Note("wait " + Convert.ToString(ms));
            return true;
        }
        if (cmd == "redraw") {
            if (t.Count != 2 || t[1] != "full") {
                UiDriver.Note("redraw: expected full");
                return false;
            }
            app.RequestRedraw();
            waitFullPresent = true;
            UiDriver.Note("redraw full");
            return true;
        }
        if (cmd == "freeze") {
            if (t.Count < 2 || t.Count > 3 || t[1] != "clock") {
                UiDriver.Note("freeze: expected clock [tickMs]");
                return false;
            }
            int fixedMs = 600000;
            if (t.Count == 3) { fixedMs = UiDriver.ArgI(t, 2, fixedMs); }
            app.FreezeAnimClock(fixedMs);
            UiDriver.Note("freeze clock " + Convert.ToString(fixedMs));
            return false;
        }
        if (cmd == "unfreeze") {
            if (t.Count != 2 || t[1] != "clock") {
                UiDriver.Note("unfreeze: expected clock");
                return false;
            }
            app.UnfreezeAnimClock();
            UiDriver.Note("unfreeze clock");
            return false;
        }
        if (cmd == "move") {
            UiDriver.Inject(1, UiDriver.ArgI(t, 1, 0), UiDriver.ArgI(t, 2, 0), 0, 0, 0);
            UiDriver.Note(trimmed);
            return true;
        }
        if (cmd == "click") {
            UiDriver.ClickAt(UiDriver.ArgI(t, 1, 0), UiDriver.ArgI(t, 2, 0), 0);
            UiDriver.Note(trimmed);
            return true;
        }
        if (cmd == "rclick") {
            UiDriver.ClickAt(UiDriver.ArgI(t, 1, 0), UiDriver.ArgI(t, 2, 0), 1);
            UiDriver.Note(trimmed);
            return true;
        }
        if (cmd == "clickid") {
            int id = UiDriver.ArgI(t, 1, -1);
            HitRegion r = UiDriver.FindRegion(id);
            if (r != null) {
                int cx = r.x + r.width / 2;
                int cy = r.y + r.height / 2;
                UiDriver.ClickAt(cx, cy, 0);
                UiDriver.Note("clickid " + Convert.ToString(id)
                    + " -> (" + Convert.ToString(cx) + "," + Convert.ToString(cy) + ")");
            } else {
                UiDriver.Note("clickid " + Convert.ToString(id) + " -> NOT FOUND");
                return false;
            }
            return true;
        }
        if (cmd == "scroll") {
            UiDriver.Inject(13, UiDriver.ArgI(t, 1, 0), UiDriver.ArgI(t, 2, 0),
                0, UiDriver.ArgI(t, 3, 0), 0);
            UiDriver.Note(trimmed);
            return true;
        }
        if (cmd == "char") {
            UiDriver.Inject(6, 0, 0, 0, UiDriver.ArgI(t, 1, 0), 0);
            UiDriver.Note(trimmed);
            return true;
        }
        if (cmd == "type") {
            string txt = UiDriver.Unquote(UiDriver.RemainderAfter(trimmed, 1));
            for (int i = 0; i < txt.Length; i = i + 1) {
                int b = txt[i];
                if (b >= 32 && b < 127) {
                    UiDriver.Inject(6, 0, 0, 0, b, 0);
                }
            }
            UiDriver.Note("type \"" + txt + "\"");
            return true;
        }
        if (cmd == "keydown") {
            UiDriver.Inject(4, 0, 0, 0, UiDriver.ArgI(t, 1, 0), UiDriver.ArgI(t, 2, 0));
            UiDriver.Note(trimmed);
            return true;
        }
        if (cmd == "keyup") {
            UiDriver.Inject(5, 0, 0, 0, UiDriver.ArgI(t, 1, 0), UiDriver.ArgI(t, 2, 0));
            UiDriver.Note(trimmed);
            return true;
        }
        if (cmd == "ev") {
            UiDriver.Inject(UiDriver.ArgI(t, 1, 0), UiDriver.ArgI(t, 2, 0),
                UiDriver.ArgI(t, 3, 0), UiDriver.ArgI(t, 4, 0),
                UiDriver.ArgI(t, 5, 0), UiDriver.ArgI(t, 6, 0));
            UiDriver.Note(trimmed);
            return true;
        }
        if (cmd == "dump") {
            UiDriver.DoDump(t);
            return false;
        }
        if (cmd == "assert") {
            UiDriver.DoAssert(t, trimmed);
            return false;
        }
        if (cmd == "log") {
            UiDriver.Note(UiDriver.RemainderAfter(trimmed, 1));
            return false;
        }
        if (cmd == "quit") {
            UiDriver.Note("quit");
            UiDriver.Finish();
            app.window.Close();
            app.isRunning = false;
            return true;
        }
        UiDriver.Note("UNKNOWN COMMAND: " + trimmed);
        return false;
    }

    /// 注入移动+按下+释放三个合成事件，等价一次点击；
    /// button 0 左键、1 右键。
    static void ClickAt(int x, int y, int button) {
        UiDriver.Inject(1, x, y, 0, 0, 0);          // 移动
        UiDriver.Inject(2, x, y, button, 0, 0);     // 按下
        UiDriver.Inject(3, x, y, button, 0, 0);     // 释放
    }

    /// 向绑定窗口注入一个原始合成事件（编码同 Window.InjectEvent）。
    static void Inject(int kind, int x, int y, int button, int code, int mods) {
        app.window.InjectEvent(kind, x, y, button, code, mods);
    }

    /// 将命中区域 id 解析为区域（后注册者优先，与
    /// HitTester 的逆序命中优先级一致）。未注册时返回 null。
    static HitRegion FindRegion(int id) {
        int i = app.hitTester.RegionCount() - 1;
        while (i >= 0) {
            HitRegion r = app.hitTester.RegionAt(i);
            if (r.id == id) { return r; }
            i = i - 1;
        }
        return null;
    }

    /// 执行 `dump` 命令：hitregions/tree/theme/pixels/probe 写出
    /// JSON 或像素文件（相对路径落到输出目录）。参数缺失或目标
    /// 未知记入结果日志。
    static void DoDump(List<string> t) {
        if (t.Count < 3) { UiDriver.Note("dump: missing args"); return; }
        string what = t[1];
        if (what == "hitregions") {
            string file = t[2];
            File.WriteAllText(UiDriver.OutPath(file), UiDriver.HitRegionsJson());

            UiDriver.Note("dump hitregions -> " + file + " ("
                + Convert.ToString(app.hitTester.RegionCount()) + " regions)");
            return;
        }
        if (what == "tree") {
            string treeFile = t[2];
            File.WriteAllText(UiDriver.OutPath(treeFile), UiDriver.TreeJson());
            UiDriver.Note("dump tree -> " + treeFile);
            return;
        }
        if (what == "theme") {
            string file = t[2];
            File.WriteAllText(UiDriver.OutPath(file), UiDriver.ThemeJson());
            UiDriver.Note("dump theme -> " + file);
            return;
        }
        if (what == "pixels") {
            string file = t[2];
            string path = UiDriver.OutPath(file);
            int x = 0;
            int y = app.titlebarH;
            int w = app.canvas.Width();
            int h = app.canvas.Height() - y;
            if (t.Count == 7) {
                x = UiDriver.ArgI(t, 3, 0);
                y = UiDriver.ArgI(t, 4, 0);
                w = UiDriver.ArgI(t, 5, 0);
                h = UiDriver.ArgI(t, 6, 0);
            } else if (t.Count != 3) {
                UiDriver.Note("dump pixels: expected file or file x y w h");
                return;
            }
            int bytes = app.canvas.WritePixels(path, x, y, w, h);
            int expected = 24 + w * h * 4;
            if (bytes < 0 || bytes != expected) {
                UiDriver.Note("dump pixels FAILED -> " + file
                    + " rc=" + Convert.ToString(bytes)
                    + " expected=" + Convert.ToString(expected));
                return;
            }
            File.WriteAllText(path + ".size",
                Convert.ToString(w) + "x" + Convert.ToString(h));
            UiDriver.Note("dump pixels -> " + file + " ("
                + Convert.ToString(w) + "x" + Convert.ToString(h)
                + " at " + Convert.ToString(x) + ","
                + Convert.ToString(y) + ")");
            return;
        }
        if (what == "probe") {
            if (t.Count < 4) { UiDriver.Note("dump probe: missing file"); return; }
            string name = t[2];
            string file = t[3];
            File.WriteAllText(UiDriver.OutPath(file), UiDriver.GetProbe(name));
            UiDriver.Note("dump probe " + name + " -> " + file);
            return;
        }
        UiDriver.Note("dump: unknown target " + what);
    }

    /// 执行 `assert` 命令：按 contains/equals 比较 probe 值与期望，
    /// 计入 pass/fail 统计并把判定写入结果日志（失败附实际值，
    /// 超 200 字符截断）。
    static void DoAssert(List<string> t, string trimmed) {
        // assert probe <name> <contains|equals> <text...>
        if (t.Count < 5 || t[1] != "probe") {
            UiDriver.Note("assert: bad form: " + trimmed);
            return;
        }
        string name = t[2];
        string op = t[3];
        string expect = UiDriver.Unquote(UiDriver.RemainderAfter(trimmed, 4));
        string val = UiDriver.GetProbe(name);
        bool ok = false;
        if (op == "contains") { ok = UiDriver.Contains(val, expect); }
        else if (op == "equals") { ok = (UiDriver.Trim(val) == UiDriver.Trim(expect)); }
        else { UiDriver.Note("assert: unknown op " + op); return; }
        if (ok) {
            passCount = passCount + 1;
            UiDriver.Note("ASSERT PASS  probe " + name + " " + op + " \"" + expect + "\"");
        } else {
            failCount = failCount + 1;
            string shown = val;
            if (shown.Length > 200) { shown = shown.Substring(0, 200) + "..."; }
            UiDriver.Note("ASSERT FAIL  probe " + name + " " + op + " \"" + expect
                + "\"  | actual=" + shown);
        }
    }

    /// 结束会话：向结果日志写入 DONE pass=N fail=M 汇总（幂等）。
    static void Finish() {
        if (finished) { return; }
        finished = true;
        UiDriver.Note("DONE pass=" + Convert.ToString(passCount)
            + " fail=" + Convert.ToString(failCount));
    }

    // ---------------- 内省序列化器 ----------------

    /// 全部命中区域序列化为 JSON：z 为注册序号（后注册者命中
    /// 优先），type 为 HitTester 的 widgetType。
    static string HitRegionsJson() {
        int n = app.hitTester.RegionCount();
        HitRegionsDoc o = new HitRegionsDoc();
        o.count = n;
        o.regions = new List<HitRegionDoc>();
        for (int i = 0; i < n; i = i + 1) {
            HitRegion r = app.hitTester.RegionAt(i);
            HitRegionDoc doc = new HitRegionDoc();
            doc.z = i;
            doc.id = r.id;
            doc.x = r.x;
            doc.y = r.y;
            doc.w = r.width;
            doc.h = r.height;
            doc.type = r.widgetType;
            o.regions.Add(doc);
        }
        return Json.Serialize<HitRegionsDoc>(o);
    }

    /// 当前窗口的控件树（形状 + 布局结果）。根由 Form.Run
    /// 登记；没有保留模式根时写出一棵空树。
    static string TreeJson() {
        ControlTreeDoc o = new ControlTreeDoc();
        if (root != null) { o.root = UiDriver.NodeOf(root); }
        return Json.Serialize<ControlTreeDoc>(o);
    }

    /// 把控件子树递归转成 dump 节点：kind/名称/停靠/可见性/
    /// 解析矩形/测量偏好/子节点。
    static ControlNode NodeOf(Control c) {
        ControlNode n = new ControlNode();
        n.kind = c.Kind();
        n.name = c.name;
        n.dock = c.dock;
        n.visible = 0;
        if (c.visible) { n.visible = 1; }
        n.x = c.bx;
        n.y = c.by;
        n.w = c.bw;
        n.h = c.bh;
        n.prefW = c.prefW;
        n.prefH = c.prefH;
        n.kids = new List<ControlNode>();
        for (int i = 0; i < c.children.Count; i = i + 1) {
            n.kids.Add(UiDriver.NodeOf(c.children[i]));
        }
        return n;
    }

    /// 当前皮肤解析后的样式 token，外加 DPI 缩放，调用方可
    /// 将 token 转换为命中区域所用的设备像素。
    static string ThemeJson() {
        Theme t = app.theme;
        ThemeDoc o = new ThemeDoc();
        o.scale = app.Scale(1000);

        o.textPrimary = t.textPrimary;
        o.textSecondary = t.textSecondary;
        o.textTertiary = t.textTertiary;
        o.textDisabled = t.textDisabled;
        o.bgPrimary = t.bgPrimary;
        o.bgSecondary = t.bgSecondary;
        o.bgTertiary = t.bgTertiary;
        o.borderPrimary = t.borderPrimary;
        o.borderSecondary = t.borderSecondary;
        o.divider = t.divider;
        o.primary = t.primary;
        o.shadowColor = t.shadowColor;

        o.borderRadiusSmall = t.borderRadiusSmall;
        o.borderRadiusMedium = t.borderRadiusMedium;
        o.borderRadiusLarge = t.borderRadiusLarge;
        o.borderWidth = t.borderWidth;

        o.fontSizeTiny = t.fontSizeTiny;
        o.fontSizeSmall = t.fontSizeSmall;
        o.fontSizeMedium = t.fontSizeMedium;
        o.fontSizeLarge = t.fontSizeLarge;
        o.fontSizeHuge = t.fontSizeHuge;

        o.heightTiny = t.heightTiny;
        o.heightSmall = t.heightSmall;
        o.heightMedium = t.heightMedium;
        o.heightLarge = t.heightLarge;

        o.paddingTiny = t.paddingTiny;
        o.paddingSmall = t.paddingSmall;
        o.paddingMedium = t.paddingMedium;
        o.paddingLarge = t.paddingLarge;

        o.gapSmall = t.gapSmall;
        o.gapMedium = t.gapMedium;
        o.gapLarge = t.gapLarge;

        o.glass = t.glass;
        o.gradient = t.gradient;
        o.neu = t.neu;
        o.brutal = t.brutal;
        return Json.Serialize<ThemeDoc>(o);
    }

    /// 布尔值的 JSON 字面量（"true"/"false"）。公开，
    /// 构建 probe JSON 的宿主（如 IDE 的编辑器快照）可复用。
    static string JsonBool(bool b) {
        if (b) { return "true"; }
        return "false";
    }

    // ---------------- 小型字符串辅助 ----------------

    /// 向结果日志追加一行。
    static void Note(string msg) {
        File.AppendAllText(resultsPath, msg + "\n");
    }

    /// dump 目标路径：绝对路径（以 / 开头或含盘符）原样返回，
    /// 否则拼到输出目录下。
    static string OutPath(string file) {
        if (UiDriver.StartsWith(file, "/") || UiDriver.Contains(file, ":")) { return file; }
        return outDir + "/" + file;
    }

    /// 取第 `idx` 个 token 的整数值；越界或缺失返回 `def`。
    static int ArgI(List<string> t, int idx, int def) {
        if (idx < 0 || idx >= t.Count) { return def; }
        return Convert.ToInt32(t[idx]);
    }

    /// 按空白（空格/制表符）把一行切成 token 列表。
    static List<string> Tok(string s) {
        List<string> outp = new List<string>();
        string cur = "";
        for (int i = 0; i < s.Length; i = i + 1) {
            string ch = s.Substring(i, 1);
            if (ch == " " || ch == "\t") {
                if (cur.Length > 0) { outp.Add(cur); cur = ""; }
            } else {
                cur = cur + ch;
            }
        }
        if (cur.Length > 0) { outp.Add(cur); }
        return outp;
    }

    /// 前 `count` 个空白分隔 token 之后的所有内容，去除首尾空白。
    static string RemainderAfter(string s, int count) {
        int i = 0;
        for (int seen = 0; seen < count && i < s.Length; seen = seen + 1) {
            while (i < s.Length) {
                string c = s.Substring(i, 1);
                if (c == " " || c == "\t") { i = i + 1; } else { break; }
            }
            while (i < s.Length) {
                string c = s.Substring(i, 1);
                if (c != " " && c != "\t") { i = i + 1; } else { break; }
            }
        }
        while (i < s.Length) {
            string c = s.Substring(i, 1);
            if (c == " " || c == "\t") { i = i + 1; } else { break; }
        }
        return UiDriver.Trim(s.Substring(i, s.Length - i));
    }

    /// 去除首尾成对的双引号（不配对则原样返回）。
    static string Unquote(string s) {
        string r = UiDriver.Trim(s);
        if (r.Length >= 2 && r.Substring(0, 1) == "\"" && r.Substring(r.Length - 1, 1) == "\"") {
            return r.Substring(1, r.Length - 2);
        }
        return r;
    }

    /// 去除首尾空白（空格/制表/回车/换行）。
    static string Trim(string s) {
        int a = 0;
        int b = s.Length;
        while (a < b) {
            string c = s.Substring(a, 1);
            if (c == " " || c == "\t" || c == "\r" || c == "\n") { a = a + 1; } else { break; }
        }
        while (b > a) {
            string c = s.Substring(b - 1, 1);
            if (c == " " || c == "\t" || c == "\r" || c == "\n") { b = b - 1; } else { break; }
        }
        return s.Substring(a, b - a);
    }

    /// `s` 是否以 `pfx` 开头。
    static bool StartsWith(string s, string pfx) {
        if (pfx.Length > s.Length) { return false; }
        return s.Substring(0, pfx.Length) == pfx;
    }

    /// `s` 是否包含子串 `sub`（空子串恒为真）。
    static bool Contains(string s, string sub) {
        if (sub.Length == 0) { return true; }
        if (sub.Length > s.Length) { return false; }
        int last = s.Length - sub.Length;
        for (int i = 0; i <= last; i = i + 1) {
            if (s.Substring(i, sub.Length) == sub) { return true; }
        }
        return false;
    }

    /// 对字符串做 JSON 转义（引号、反斜杠、控制字符）。公开，
    /// 构建 probe JSON 的宿主（如 IDE 的编辑器快照）可复用。
    static string JsonEsc(string s) {
        string outp = "";
        for (int i = 0; i < s.Length; i = i + 1) {
            int b = s[i];
            if (b == 34) { outp = outp + "\\\""; }
            else if (b == 92) { outp = outp + "\\\\"; }
            else if (b == 10) { outp = outp + "\\n"; }
            else if (b == 13) { outp = outp + "\\r"; }
            else if (b == 9) { outp = outp + "\\t"; }
            else if (b < 32) { outp = outp + " "; }
            else { outp = outp + s.Substring(i, 1); }
        }
        return outp;
    }
}
