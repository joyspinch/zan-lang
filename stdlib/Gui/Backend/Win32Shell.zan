    [DllImport("gdi32", EntryPoint = "CreateSolidBrush")]
    static extern nint CreateSolidBrush(int color);

    /// GDI 呈现（含对上一呈现帧的差分增量上传），见 gui_runtime.c。
    /// rects 为 [x,y,w,h]* 扁平数组的原生缓冲，rectCount 是矩形个数；
    /// rectCount < 0 强制整窗上传（WM_PAINT：重定向表面可能已失效）；
    /// rectCount == 0 走瓦片差分。返回实际上传的矩形数，-1 失败。
    [DllImport("zan_gui")]
    static extern int zan_gui_gdi_present(nint hwnd, int surfaceId, nint rects,
                                          int rectCount);

    /// 窗口销毁时释放它的呈现阴影（见 zan_gui_gdi_present）。
    [DllImport("zan_gui")]
    static extern void zan_gui_gdi_present_drop(nint hwnd);
    [DllImport("gdi32", EntryPoint = "DeleteObject")]
