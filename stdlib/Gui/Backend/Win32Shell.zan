    [DllImport("kernel32", EntryPoint = "CreateFileW")]
    static extern nint CreateFileW(nint path, int access, int share, nint sa,
                                   int disposition, int flags, nint template);
    [DllImport("kernel32", EntryPoint = "WriteFile")]
    static extern int WriteFile(nint file, nint buf, int bytes, nint written,
                                nint overlapped);
