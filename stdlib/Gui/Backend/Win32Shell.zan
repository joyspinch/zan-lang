    [DllImport("gdi32", EntryPoint = "SetDIBitsToDevice")]
    static extern int SetDIBitsToDevice(nint dc, int xd, int yd, int w, int h,
                                        int xs, int ys, int startScan,
                                        int scanLines, nint bits, nint info,
