    [DllImport("kernel32", EntryPoint = "QueryPerformanceFrequency")]
    static extern int QueryPerformanceFrequency(nint slot);
    [DllImport("winmm", EntryPoint = "timeBeginPeriod")]
    static extern int TimeBeginPeriod(int ms);
    [DllImport("kernel32", EntryPoint = "GlobalAlloc")]
    static extern nint GlobalAlloc(int flags, long bytes);
