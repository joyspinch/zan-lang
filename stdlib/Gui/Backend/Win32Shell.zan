    static bool ready;
    static nint instance;
    static nint className;
    static nint mainHwnd;
    static nint eventHwnd;
    // Window the event currently published by Post belongs to.
    static nint evHwnd;

    // Paths of the files the last WM_DROPFILES delivered, drained by
    // Window.TakeDroppedFiles() when the app sees the kind-9 event.
    static List<string> dropped;

    // Last reported event: kind, x, y, button, keycode, mods.
    static int evKind;
    static int evX;
    static int evY;
    static int evButton;
    static int evKeyCode;
    static int evMods;
    static bool hasEvent;

    static int windowWidth;
    static int windowHeight;
    static int dpi;
    static int titlebarH;
    static int buttonW;
    // How many client-drawn caption buttons each window keeps on the right of
    // its titlebar, per hwnd: a dialog with a single close button must not
    // shrink (or widen) the strip its parent reserves, or the parent's own
    // system buttons stop hit-testing as client area the moment a child opens.
    static List<nint> capHwnd;
    static List<int> capCount;
    static int imeX;
    static int imeY;

    static bool glassOn;
    static int glassTint;
    // Shape-window mode: 0 = rectangle, 1 = shaped. A shaped window's
    // silhouette is the UNION of shapeRegions (type,x,y,w,h,r groups of six,
    // logical px: type 1 = rounded rect, type 2 = ellipse). Enforced with
    // per-pixel alpha composition (WS_EX_LAYERED + UpdateLayeredWindow) when
    // DWM composition is on (Windows 7 included), and with a combined
    // SetWindowRgn when DWM is off, so shaped windows work even on Win7
    // without the DWM. Pixels outside every region pass clicks through.
    static int shapeMode;
    static List<int> shapeRegions;
    // Cached per-pixel coverage mask for the layered path (0..255, straight
    // alpha): rebuilt only when the window or the shape list changes.
    static List<byte> shapeMask;
    static int shapeMaskW;
    static int shapeMaskH;
    static int shapeMaskGen;

    // Per-window last presented surface, so WM_PAINT repaints the frame that
    // belongs to *this* window rather than whichever one presented last.
    static List<nint> surfHwnd;
    static List<int> surfId;
    static int lastSurface;

    // Dirty rects announced for the next present (x, y, w, h groups of four).
    static List<int> dirty;
    static bool dirtyOverflow;

    // Synthetic events queued by the automation driver, guarded by a critical
    // section because a driver thread may enqueue while the UI thread drains.
    static List<int> injectQ;
    static List<nint> injectHwnd;
    static nint injectCs;

    // Cached layered-window present surface (glass), rebuilt on size change.
    static nint lwDc;
    static nint lwBitmap;
    static nint lwOld;
    static nint lwBits;
    static int lwW;
    static int lwH;

    // Client-priority strips (client coords, groups of four: x, y, w, h). The
    // app draws controls flush with the frame -- a scrollbar sits in the last
    // few pixels -- and a thin edge grip on top of one swallows every press
    // meant for it. A strip registered here makes the edge grip yield; corner
    // grips still win so a diagonal resize stays reachable.
    static List<int> hitGuards;
    static List<nint> hitGuardWins;

    static nint scratchRect;
    static nint scratchMsg;
    static nint bitmapInfo;
    static int bgColor;

    /// Reads a 32-bit field. Win32 RECT / POINT coordinates go negative on
    /// multi-monitor layouts, so the value stays signed.
    static int S32(nint p, int off) {
        return new Span<int>(p + off, 1)[0];
    }

    /// One-time class registration, DPI awareness and shared scratch buffers.
    static void Init() {
        if (Win32Shell.ready) { return; }
        Win32Shell.ready = true;
        Win32Shell.capHwnd = new List<nint>();
        Win32Shell.capCount = new List<int>();
        Win32Shell.dpi = 96;
        Win32Shell.titlebarH = 32;
        Win32Shell.buttonW = 46;
        Win32Shell.surfHwnd = new List<nint>();
        Win32Shell.surfId = new List<int>();
        Win32Shell.dirty = new List<int>();
        Win32Shell.injectQ = new List<int>();
        Win32Shell.injectHwnd = new List<nint>();
        Win32Shell.hitGuards = new List<int>();
        Win32Shell.hitGuardWins = new List<nint>();
        Win32Shell.lastSurface = 0 - 1;
        Win32Shell.bgColor = 0;

        Win32Shell.injectCs = NativeMemory.Alloc(64);
        Win32Shell.InitializeCriticalSection(Win32Shell.injectCs);
        Win32Shell.scratchRect = NativeMemory.Alloc(16);
        Win32Shell.scratchMsg = NativeMemory.Alloc(64);
        Win32Shell.bitmapInfo = NativeMemory.Alloc(48);

        Win32Shell.EnableDpiAwareness();

        Win32Shell.instance = Win32Shell.GetModuleHandleW(0);
        Win32Shell.className = Wide.Of("ZanGuiApp");
        nint wc = NativeMemory.Alloc(80);
        NativeMemory.Fill(wc, 0, 80);
        new Span<int>(wc, 1)[0] = 80;
        new Span<int>(wc + 4, 1)[0] = 0x0020 | 0x0008;  // CS_OWNDC | CS_DBLCLKS
        new Span<long>(wc + 8, 1)[0] = (nint)Win32Shell.OnMessage;
        new Span<long>(wc + 24, 1)[0] = Win32Shell.instance;
        new Span<long>(wc + 32, 1)[0] = Win32Shell.LoadIconW(Win32Shell.instance, 1);
        new Span<long>(wc + 40, 1)[0] = Win32Shell.LoadCursorW(0, 32512);
        new Span<long>(wc + 64, 1)[0] = Win32Shell.className;
        new Span<long>(wc + 72, 1)[0] = new Span<long>(wc + 32, 1)[0];
        Win32Shell.RegisterClassExW(wc);
        NativeMemory.Free(wc);
    }

    /// Per-monitor awareness when Shcore is present, system awareness otherwise,
    /// so the binary still loads on Windows 7.
    static void EnableDpiAwareness() {
        nint fn = Interop.Entry("Shcore.dll", "SetProcessDpiAwareness");
        if (fn != 0) {
            SetProcessDpiAwarenessFn perMonitor = (SetProcessDpiAwarenessFn)fn;
            perMonitor(2);
            return;
        }
        fn = Interop.Entry("user32.dll", "SetProcessDPIAware");
        if (fn == 0) { return; }
        SetProcessDpiAwareFn system = (SetProcessDpiAwareFn)fn;
        system();
    }

    // ---- window procedure ---------------------------------------------------

    static int ModsNow() {
        int mods = 0;
        if ((Win32Shell.GetKeyState(17) & 0x8000) != 0) { mods = mods | 1; }
        if ((Win32Shell.GetKeyState(16) & 0x8000) != 0) { mods = mods | 2; }
        if ((Win32Shell.GetKeyState(18) & 0x8000) != 0) { mods = mods | 4; }
        return mods;
    }

    /// Low/high signed 16-bit halves of an LPARAM coordinate pair.
    static int LoWord(nint v) {
        int raw = ((int)v) & 65535;
        if (raw >= 32768) { return raw - 65536; }
        return raw;
    }

    static int HiWord(nint v) {
        int raw = (((int)v) >> 16) & 65535;
        if (raw >= 32768) { return raw - 65536; }
        return raw;
    }

    /// Publishes one input event for the loop to consume. `hwnd` is stored with
    /// it: the window that produced THIS event, which is what multi-window
    /// routing needs. `eventHwnd` alone is the last window the window procedure
    /// ran for, and a message dispatched after (or nested inside) the one that
    /// posted -- WM_NCHITTEST/WM_SETCURSOR/WM_PAINT for a sibling window, none
    /// of which post -- would retarget the event to the wrong window, so a
    /// parent's clicks were dropped as "not mine" once a child window existed.
    static void Post(nint hwnd, int kind, int x, int y, int button, int keycode,
                     int mods) {
        Win32Shell.evHwnd = hwnd;
        Win32Shell.evKind = kind;
        Win32Shell.evX = x;
        Win32Shell.evY = y;
        Win32Shell.evButton = button;
        Win32Shell.evKeyCode = keycode;
        Win32Shell.evMods = mods;
        Win32Shell.hasEvent = true;
    }

    /// Collects the paths of a file drop and publishes it as a kind-9 event at
    /// the drop point (client px), so the app can route it to whatever widget
    /// is under the cursor. The paths wait in `dropped` until it takes them.
    static void OnDropFiles(nint hwnd, nint hdrop) {
        if (Win32Shell.dropped == null) {
            Win32Shell.dropped = new List<string>();
        }
        // Index -1 (0xFFFFFFFF) asks for the file count.
        int n = Win32Shell.DragQueryFileW(hdrop, 0 - 1, 0, 0);
        nint buf = NativeMemory.Alloc(2048);
        int i = 0;
        while (i < n) {
            int len = Win32Shell.DragQueryFileW(hdrop, i, buf, 1024);
            if (len > 0) { Win32Shell.dropped.Add(Wide.Read(buf)); }
            i = i + 1;
        }
        NativeMemory.Free(buf);
        nint pt = NativeMemory.Alloc(8);
        new Span<int>(pt, 1)[0] = 0;
        new Span<int>(pt + 4, 1)[0] = 0;
        Win32Shell.DragQueryPoint(hdrop, pt);
        int px = Win32Shell.S32(pt, 0);
        int py = Win32Shell.S32(pt, 4);
        NativeMemory.Free(pt);
        Win32Shell.DragFinish(hdrop);
        Win32Shell.Post(hwnd, 9, px, py, 0, 0, 0);
    }

    /// Hands over (and clears) the paths of the last drop.
    static List<string> TakeDropped() {
        List<string> outp = new List<string>();
        if (Win32Shell.dropped == null) { return outp; }
        int i = 0;
        while (i < Win32Shell.dropped.Count) {
            outp.Add(Win32Shell.dropped[i]);
            i = i + 1;
        }
        Win32Shell.dropped = new List<string>();
        return outp;
    }

    static nint OnMessage(nint hwnd, int msg, nint wp, nint lp) {
        Win32Shell.eventHwnd = hwnd;
        if (msg == 0x010D || msg == 0x010F || msg == 0x0281) {
            // WM_IME_STARTCOMPOSITION / WM_IME_COMPOSITION / WM_IME_SETCONTEXT
            Win32Shell.ImeReposition(hwnd);
        } else if (msg == 2) {                     // WM_DESTROY
            Win32Shell.Post(hwnd, 8, 0, 0, 0, 0, 0);
            if (hwnd == Win32Shell.mainHwnd) { Win32Shell.PostQuitMessage(0); }
            else if (Win32Shell.mainHwnd != 0) {
                // Hand activation back to the frame that opened this window.
                // Without it the process is left with no active window, so the
                // main window got no keyboard input (and, being unfocused, also
                // stopped animating) after a dialog closed.
                Win32Shell.SetForegroundWindow(Win32Shell.mainHwnd);
                Win32Shell.SetFocus(Win32Shell.mainHwnd);
            }
            return 0;
        } else if (msg == 0x0231) {                // WM_ENTERSIZEMOVE
            if (Win32Shell.glassOn && Win32Shell.shapeMode == 0) {
                Win32Shell.AcrylicApply(hwnd, 3, Win32Shell.glassTint);
            }
        } else if (msg == 0x0232) {                // WM_EXITSIZEMOVE
            if (Win32Shell.glassOn && Win32Shell.shapeMode == 0) {
                Win32Shell.AcrylicApply(hwnd, 4, Win32Shell.glassTint);
            }
            if (Win32Shell.glassOn) {
                if (Win32Shell.lastSurface >= 0) {
                    Win32Shell.PresentLayered(hwnd, Win32Shell.lastSurface);
                }
            }
        } else if (msg == 5) {                     // WM_SIZE
            Win32Shell.windowWidth = Win32Shell.LoWord(lp) & 65535;
            Win32Shell.windowHeight = (((int)lp) >> 16) & 65535;
            int own = Win32Shell.SurfaceOf(hwnd);
            if (!Win32Shell.glassOn && own >= 0) {
                Win32Shell.Blit(hwnd, own);
            }
            Win32Shell.Post(hwnd, 7, Win32Shell.windowWidth, Win32Shell.windowHeight,
                0, 0, 0);
            return 0;
        } else if (msg == 0x0024 && hwnd == Win32Shell.mainHwnd
                && Win32Shell.shapeMode == 0) {
            // WM_GETMINMAXINFO: MINMAXINFO.ptMinTrackSize (offset 24). The
            // shell layout stops being usable below 800x600 logical pixels, so
            // the main frame refuses to be dragged smaller (child windows keep
            // the default limits). Shaped windows are exempt: their size is
            // the shape's bounding box (SetShape calls FitShapeWindow), which
            // is typically far smaller than 800x600.
            int scale = Win32Shell.dpi;
            if (scale <= 0) { scale = 96; }
            new Span<int>(lp + 24, 1)[0] = 800 * scale / 96;
            new Span<int>(lp + 28, 1)[0] = 600 * scale / 96;
            return 0;
        } else if (msg == 0x0233) {                // WM_DROPFILES
            Win32Shell.OnDropFiles(hwnd, wp);
            return 0;
        } else if (msg == 512) {                   // WM_MOUSEMOVE
            Win32Shell.Post(hwnd, 1, Win32Shell.LoWord(lp), Win32Shell.HiWord(lp),
                0, 0, 0);
            return 0;
        } else if (msg == 513) {                   // WM_LBUTTONDOWN
            Win32Shell.Post(hwnd, 2, Win32Shell.LoWord(lp), Win32Shell.HiWord(lp),
                0, 0, Win32Shell.ModsNow());
            Win32Shell.SetCapture(hwnd);
            return 0;
        } else if (msg == 514) {                   // WM_LBUTTONUP
            Win32Shell.Post(hwnd, 3, Win32Shell.LoWord(lp), Win32Shell.HiWord(lp),
                0, 0, Win32Shell.ModsNow());
            Win32Shell.ReleaseCapture();
            return 0;
        } else if (msg == 516) {                   // WM_RBUTTONDOWN
            Win32Shell.Post(hwnd, 2, Win32Shell.LoWord(lp), Win32Shell.HiWord(lp),
                1, 0, Win32Shell.ModsNow());
            return 0;
        } else if (msg == 517) {                   // WM_RBUTTONUP
            Win32Shell.Post(hwnd, 3, Win32Shell.LoWord(lp), Win32Shell.HiWord(lp),
                1, 0, 0);
            return 0;
        } else if (msg == 256) {                   // WM_KEYDOWN
            Win32Shell.Post(hwnd, 4, 0, 0, 0, (int)wp, Win32Shell.ModsNow());
            return 0;
        } else if (msg == 257) {                   // WM_KEYUP
            Win32Shell.Post(hwnd, 5, 0, 0, 0, (int)wp, 0);
            return 0;
        } else if (msg == 258) {                   // WM_CHAR
            Win32Shell.Post(hwnd, 6, 0, 0, 0, (int)wp, 0);
            return 0;
        } else if (msg == 522) {                   // WM_MOUSEWHEEL
            nint pt = Win32Shell.scratchRect;
            new Span<int>(pt, 1)[0] = Win32Shell.LoWord(lp);
            new Span<int>(pt + 4, 1)[0] = Win32Shell.HiWord(lp);
            Win32Shell.ScreenToClient(hwnd, pt);
            int delta = (((int)wp) >> 16) & 65535;
            if (delta >= 32768) { delta = delta - 65536; }
            Win32Shell.Post(hwnd, 13, Win32Shell.S32(pt, 0),
                Win32Shell.S32(pt, 4), 0, delta, 0);
            return 0;
        } else if (msg == 0x0083) {                // WM_NCCALCSIZE
            if (wp != 0) {
                if (Win32Shell.IsMaximized(hwnd)) {
                    int fx = Win32Shell.GetSystemMetrics(32)
                        + Win32Shell.GetSystemMetrics(92);
                    int fy = Win32Shell.GetSystemMetrics(33)
                        + Win32Shell.GetSystemMetrics(92);
                    new Span<int>(lp, 1)[0] = Win32Shell.S32(lp, 0) + fx;
                    new Span<int>(lp + 4, 1)[0] = Win32Shell.S32(lp, 4) + fy;
                    new Span<int>(lp + 8, 1)[0] = Win32Shell.S32(lp, 8) - fx;
                    new Span<int>(lp + 12, 1)[0] = Win32Shell.S32(lp, 12) - fy;
                }
                return 0;
            }
        } else if (msg == 0x0084) {                // WM_NCHITTEST
            return Win32Shell.HitTest(hwnd, Win32Shell.LoWord(lp),
                Win32Shell.HiWord(lp));
        } else if (msg == 15) {                    // WM_PAINT
            nint ps = NativeMemory.Alloc(72);
            Win32Shell.BeginPaint(hwnd, ps);
            int own = Win32Shell.SurfaceOf(hwnd);
            if (!Win32Shell.glassOn && own >= 0) { Win32Shell.Blit(hwnd, own); }
            Win32Shell.EndPaint(hwnd, ps);
            NativeMemory.Free(ps);
            return 0;
        } else if (msg == 32) {                    // WM_SETCURSOR
            if ((((int)lp) & 65535) == 1) { return 1; }
        } else if (msg == 20) {                    // WM_ERASEBKGND
            return 1;
        }
        return Win32Shell.DefWindowProcW(hwnd, msg, wp, lp);
    }

    /// Borderless chrome: frame-sized grips on the edges, the caption strip
    /// draggable except where the app draws its caption buttons.
    static nint HitTest(nint hwnd, int screenX, int screenY) {
        nint rc = Win32Shell.scratchRect;
        if (Win32Shell.GetWindowRect(hwnd, rc) == 0) { return 1; }
        int left = Win32Shell.S32(rc, 0);
        int top = Win32Shell.S32(rc, 4);
        int w = Win32Shell.S32(rc, 8) - left;
        int h = Win32Shell.S32(rc, 12) - top;
        int x = screenX - left;
        int y = screenY - top;
        // Thin edge grips, fat corner grips: the app draws its own controls
        // flush with the window edge (a scrollbar sits in the last ~15px), so a
        // wide border strip would swallow every click meant for them, while a
        // diagonal corner drag still needs a comfortable target.
        int b = 4 * Win32Shell.dpi / 96;
        int cb = 12 * Win32Shell.dpi / 96;
        bool maxed = Win32Shell.IsMaximized(hwnd);
        bool inButtons = y < Win32Shell.titlebarH
            && x >= w - Win32Shell.CaptionButtonsOf(hwnd) * Win32Shell.buttonW;
        if (!maxed && !inButtons) {
            bool onLeft = x < b;
            bool onRight = x >= w - b;
            bool onTop = y < b;
            bool onBottom = y >= h - b;
            bool cLeft = x < cb;
            bool cRight = x >= w - cb;
            bool cTop = y < cb;
            bool cBottom = y >= h - cb;
            if (cTop && cLeft) { return 13; }
            if (cTop && cRight) { return 14; }
            if (cBottom && cLeft) { return 16; }
            if (cBottom && cRight) { return 17; }
            if (!Win32Shell.InHitGuard(hwnd, x, y)) {
                if (onLeft) { return 10; }
                if (onRight) { return 11; }
                if (onTop) { return 12; }
                if (onBottom) { return 15; }
            }
        }
        if (inButtons) { return 1; }
        if (y < Win32Shell.titlebarH) { return 2; }
        return 1;
    }

    /// Drops last frame's client-priority strips. Called once per frame before
    /// rendering re-registers the ones still on screen.
    static void ClearHitGuards(nint hwnd) {
        Win32Shell.Init();
        List<int> g = Win32Shell.hitGuards;
        List<nint> ws = Win32Shell.hitGuardWins;
        List<int> keep = new List<int>();
        List<nint> keepW = new List<nint>();
        int i = 0;
        while (i < ws.Count) {
            if (ws[i] != hwnd) {
                keepW.Add(ws[i]);
                keep.Add(g[i * 4]);
                keep.Add(g[i * 4 + 1]);
                keep.Add(g[i * 4 + 2]);
                keep.Add(g[i * 4 + 3]);
            }
            i = i + 1;
        }
        Win32Shell.hitGuards = keep;
        Win32Shell.hitGuardWins = keepW;
    }

    /// Claims `w` x `h` at (`x`, `y`) in client coords for the client area, so
    /// the frame's edge grip does not shadow the control drawn there.
    static void AddHitGuard(nint hwnd, int x, int y, int w, int h) {
        Win32Shell.Init();
        if (w <= 0 || h <= 0) { return; }
        Win32Shell.hitGuardWins.Add(hwnd);
        Win32Shell.hitGuards.Add(x);
        Win32Shell.hitGuards.Add(y);
        Win32Shell.hitGuards.Add(w);
        Win32Shell.hitGuards.Add(h);
    }

    /// Only `hwnd`'s own strips count: every window registers rects in its own
    /// client coords, so a child window's would otherwise shadow the parent's
    /// frame at the same offsets.
    static bool InHitGuard(nint hwnd, int x, int y) {
        List<int> g = Win32Shell.hitGuards;
        List<nint> ws = Win32Shell.hitGuardWins;
        if (g == null || ws == null) { return false; }
        int i = 0;
        while (i < ws.Count) {
            int o = i * 4;
            if (ws[i] == hwnd
                && x >= g[o] && x < g[o] + g[o + 2]
                && y >= g[o + 1] && y < g[o + 1] + g[o + 3]) {
                return true;
            }
            i = i + 1;
        }
        return false;
    }

    static bool IsMaximized(nint hwnd) {
        nint wpl = NativeMemory.Alloc(48);
        NativeMemory.Fill(wpl, 0, 48);
        new Span<int>(wpl, 1)[0] = 44;
        int ok = Win32Shell.GetWindowPlacement(hwnd, wpl);
        int show = Win32Shell.S32(wpl, 8);
        NativeMemory.Free(wpl);
        return ok != 0 && show == 3;
    }

    // ---- IME ----------------------------------------------------------------

    static void ImeReposition(nint hwnd) {
        nint imc = Win32Shell.ImmGetContext(hwnd);
        if (imc == 0) { return; }
        nint form = NativeMemory.Alloc(48);
        NativeMemory.Fill(form, 0, 48);
        new Span<int>(form, 1)[0] = 2;           // CFS_POINT
        new Span<int>(form + 4, 1)[0] = Win32Shell.imeX;
        new Span<int>(form + 8, 1)[0] = Win32Shell.imeY;
        Win32Shell.ImmSetCompositionWindow(imc, form);
        NativeMemory.Fill(form, 0, 48);
        new Span<int>(form, 1)[0] = 0;           // dwIndex
        new Span<int>(form + 4, 1)[0] = 64;          // CFS_CANDIDATEPOS
        new Span<int>(form + 8, 1)[0] = Win32Shell.imeX;
        new Span<int>(form + 12, 1)[0] = Win32Shell.imeY;
        Win32Shell.ImmSetCandidateWindow(imc, form);
        NativeMemory.Free(form);
        Win32Shell.ImmReleaseContext(hwnd, imc);
    }

    static void SetImePos(int x, int y) {
        Win32Shell.Init();
        Win32Shell.imeX = x;
        Win32Shell.imeY = y;
        if (Win32Shell.eventHwnd != 0) {
            Win32Shell.ImeReposition(Win32Shell.eventHwnd);
        }
    }

    // ---- presentation -------------------------------------------------------

    static int SurfaceOf(nint hwnd) {
        int i = 0;
        while (i < Win32Shell.surfHwnd.Count) {
            if (Win32Shell.surfHwnd[i] == hwnd) { return Win32Shell.surfId[i]; }
            i = i + 1;
        }
        return 0 - 1;
    }

    static void RememberSurface(nint hwnd, int surface) {
        int i = 0;
        while (i < Win32Shell.surfHwnd.Count) {
            if (Win32Shell.surfHwnd[i] == hwnd) {
                Win32Shell.surfId[i] = surface;
                return;
            }
            i = i + 1;
        }
        Win32Shell.surfHwnd.Add(hwnd);
        Win32Shell.surfId.Add(surface);
    }

    /// Top-down 32bpp BI_RGB header describing the surface being presented.
    static void FillBitmapInfo(int w, int h) {
        nint bi = Win32Shell.bitmapInfo;
        NativeMemory.Fill(bi, 0, 48);
        new Span<int>(bi, 1)[0] = 40;
        new Span<int>(bi + 4, 1)[0] = w;
        new Span<int>(bi + 8, 1)[0] = 0 - h;
        new Span<short>(bi + 12, 1)[0] = 1;
        new Span<short>(bi + 14, 1)[0] = 32;
    }

    static void Blit(nint hwnd, int surface) {
        nint pixels = Win32Shell.zan_gui_get_pixels(surface);
        if (pixels == 0) { return; }
        int sw = Win32Shell.zan_gui_surface_width(surface);
        int sh = Win32Shell.zan_gui_surface_height(surface);
        if (Win32Shell.glassOn) {
            Win32Shell.dirty.Clear();
            Win32Shell.dirtyOverflow = false;
            Win32Shell.PresentLayered(hwnd, surface);
            return;
        }
        nint dc = Win32Shell.GetDC(hwnd);
        if (dc == 0) { return; }
        Win32Shell.FillBitmapInfo(sw, sh);
        if (Win32Shell.dirty.Count > 0 && !Win32Shell.dirtyOverflow) {
            int i = 0;
            while (i + 3 < Win32Shell.dirty.Count) {
                int rx = Win32Shell.dirty[i];
                int ry = Win32Shell.dirty[i + 1];
                int rw = Win32Shell.dirty[i + 2];
                int rh = Win32Shell.dirty[i + 3];
                i = i + 4;
                if (rx < 0) { rw = rw + rx; rx = 0; }
                if (ry < 0) { rh = rh + ry; ry = 0; }
                if (rx + rw > sw) { rw = sw - rx; }
                if (ry + rh > sh) { rh = sh - ry; }
                if (rw <= 0 || rh <= 0) { continue; }
                // Source rows count from the bottom of a top-down DIB.
                Win32Shell.SetDIBitsToDevice(dc, rx, ry, rw, rh, rx,
                    sh - (ry + rh), 0, sh, pixels, Win32Shell.bitmapInfo, 0);
            }
        } else {
            Win32Shell.SetDIBitsToDevice(dc, 0, 0, sw, sh, 0, 0, 0, sh,
                pixels, Win32Shell.bitmapInfo, 0);
        }
        Win32Shell.dirty.Clear();
        Win32Shell.dirtyOverflow = false;
        if (Win32Shell.windowWidth > sw || Win32Shell.windowHeight > sh) {
            int bgr = ((Win32Shell.bgColor & 255) << 16)
                | (Win32Shell.bgColor & 65280)
                | ((Win32Shell.bgColor >> 16) & 255);
            nint brush = Win32Shell.CreateSolidBrush(bgr);
            nint rc = Win32Shell.scratchRect;
            if (Win32Shell.windowWidth > sw) {
                new Span<int>(rc, 1)[0] = sw;
                new Span<int>(rc + 4, 1)[0] = 0;
                new Span<int>(rc + 8, 1)[0] = Win32Shell.windowWidth;
                new Span<int>(rc + 12, 1)[0] = Win32Shell.windowHeight;
                Win32Shell.FillRect(dc, rc, brush);
            }
            if (Win32Shell.windowHeight > sh) {
                new Span<int>(rc, 1)[0] = 0;
                new Span<int>(rc + 4, 1)[0] = sh;
                new Span<int>(rc + 8, 1)[0] = sw;
                new Span<int>(rc + 12, 1)[0] = Win32Shell.windowHeight;
                Win32Shell.FillRect(dc, rc, brush);
            }
            Win32Shell.DeleteObject(brush);
        }
        Win32Shell.ReleaseDC(hwnd, dc);
    }

    /// Glass present: premultiply the straight-alpha surface into a cached DIB
    /// section and hand it to the DWM, which composites the blurred backdrop
    /// wherever the alpha is below 255.
    static void PresentLayered(nint hwnd, int surface) {
        nint pixels = Win32Shell.zan_gui_get_pixels(surface);
        if (pixels == 0) { return; }
        int sw = Win32Shell.zan_gui_surface_width(surface);
        int sh = Win32Shell.zan_gui_surface_height(surface);
        if (Win32Shell.lwDc == 0 || Win32Shell.lwW != sw
                || Win32Shell.lwH != sh) {
            if (Win32Shell.lwDc != 0) {
                Win32Shell.SelectObject(Win32Shell.lwDc, Win32Shell.lwOld);
                Win32Shell.DeleteObject(Win32Shell.lwBitmap);
                Win32Shell.DeleteDC(Win32Shell.lwDc);
                Win32Shell.lwDc = 0;
            }
            nint screen = Win32Shell.GetDC(0);
            Win32Shell.lwDc = Win32Shell.CreateCompatibleDC(screen);
            Win32Shell.ReleaseDC(0, screen);
            Win32Shell.FillBitmapInfo(sw, sh);
            nint bits = 0;
            Win32Shell.lwBitmap = Win32Shell.CreateDIBSection(Win32Shell.lwDc,
                Win32Shell.bitmapInfo, 0, ref bits, 0, 0);
            if (Win32Shell.lwBitmap == 0) {
                Win32Shell.DeleteDC(Win32Shell.lwDc);
                Win32Shell.lwDc = 0;
                return;
            }
            Win32Shell.lwOld = Win32Shell.SelectObject(Win32Shell.lwDc,
                Win32Shell.lwBitmap);
            Win32Shell.lwBits = bits;
            Win32Shell.lwW = sw;
            Win32Shell.lwH = sh;
        }
        int n = sw * sh;
        List<byte> mask = null;
        if (Win32Shell.shapeMode != 0) {
            mask = Win32Shell.ShapeMask(sw, sh);
        }
        int i = 0;
        while (i < n) {
            int p = Win32Shell.S32(pixels, i * 4);
            int a = (p >> 24) & 255;
            if (mask != null) {
                int cov = mask[i];
                if (cov <= 0) {
                    a = 0;
                    new Span<int>(Win32Shell.lwBits + i * 4, 1)[0] = 0;
                    i = i + 1;
                    continue;
                }
                if (cov < 255) {
                    // Premultiplied: scale alpha and colour channels alike.
                    a = a * cov / 255;
                    int r = ((p >> 16) & 255) * cov / 255;
                    int g = ((p >> 8) & 255) * cov / 255;
                    int b = (p & 255) * cov / 255;
                    new Span<int>(Win32Shell.lwBits + i * 4, 1)[0] =
                        (a << 24) | (r << 16) | (g << 8) | b;
                    i = i + 1;
                    continue;
                }
            }
            int r2 = ((p >> 16) & 255) * a / 255;
            int g2 = ((p >> 8) & 255) * a / 255;
            int b2 = (p & 255) * a / 255;
            new Span<int>(Win32Shell.lwBits + i * 4, 1)[0] = (a << 24) | (r2 << 16) | (g2 << 8) | b2;
            i = i + 1;
        }
        nint screenDc = Win32Shell.GetDC(0);
        nint size = NativeMemory.Alloc(8);
        new Span<int>(size, 1)[0] = sw;
        new Span<int>(size + 4, 1)[0] = sh;
        nint src = NativeMemory.Alloc(8);
        new Span<int>(src, 1)[0] = 0;
        new Span<int>(src + 4, 1)[0] = 0;
        nint blend = NativeMemory.Alloc(4);
        new Span<byte>(blend, 1)[0] = 0;         // AC_SRC_OVER
        new Span<byte>(blend + 1, 1)[0] = 0;
        new Span<byte>(blend + 2, 1)[0] = 255;
        new Span<byte>(blend + 3, 1)[0] = 1;         // AC_SRC_ALPHA
        // pptDst = 0: update only the content, never the OS-owned position.
        int ulw = Win32Shell.UpdateLayeredWindow(hwnd, screenDc, 0, size,
            Win32Shell.lwDc, src, 0, blend, 2);
        NativeMemory.Free(blend);
        NativeMemory.Free(src);
        NativeMemory.Free(size);
        Win32Shell.ReleaseDC(0, screenDc);
    }

    static void AcrylicApply(nint hwnd, int state, int tintArgb) {
        nint fn = Interop.Entry("user32.dll", "SetWindowCompositionAttribute");
        if (fn == 0) { return; }
        int a = (tintArgb >> 24) & 255;
        int r = (tintArgb >> 16) & 255;
        int g = (tintArgb >> 8) & 255;
        int b = tintArgb & 255;
        nint accent = NativeMemory.Alloc(16);
        new Span<int>(accent, 1)[0] = state;
        new Span<int>(accent + 4, 1)[0] = 0;
        new Span<int>(accent + 8, 1)[0] = (a << 24) | (b << 16) | (g << 8) | r;
        new Span<int>(accent + 12, 1)[0] = 0;
        nint data = NativeMemory.Alloc(24);
        new Span<int>(data, 1)[0] = 19;          // WCA_ACCENT_POLICY
        new Span<long>(data + 8, 1)[0] = accent;
        new Span<long>(data + 16, 1)[0] = 16;
        SetWinCompAttrFn call = (SetWinCompAttrFn)fn;
        call(hwnd, data);
        NativeMemory.Free(data);
        NativeMemory.Free(accent);
    }

    // ---- public shell API ---------------------------------------------------

    static nint CreateWindow(string title, int width, int height) {
        Win32Shell.Init();
        nint screenDc = Win32Shell.GetDC(0);
        int deviceDpi = Win32Shell.GetDeviceCaps(screenDc, 88);
        Win32Shell.ReleaseDC(0, screenDc);
        if (deviceDpi <= 0) { deviceDpi = 96; }
        Win32Shell.dpi = deviceDpi;
        Win32Shell.titlebarH = 32 * deviceDpi / 96;
        Win32Shell.buttonW = 46 * deviceDpi / 96;

        int scaledW = width * deviceDpi / 96;
        int scaledH = height * deviceDpi / 96;
        // A logical size scaled up by the display DPI easily exceeds the screen
        // (a restored 2133x1293 at 150% asks for 3200x1940), so a window never
        // opens larger than most of its monitor's work area.
        if (Win32Shell.WorkArea(0, 1)) {
            int maxW = (Win32Shell.S32(Win32Shell.scratchRect, 8)
                - Win32Shell.S32(Win32Shell.scratchRect, 0)) * 82 / 100;
            int maxH = (Win32Shell.S32(Win32Shell.scratchRect, 12)
                - Win32Shell.S32(Win32Shell.scratchRect, 4)) * 82 / 100;
            if (maxW > 0 && scaledW > maxW) { scaledW = maxW; }
            if (maxH > 0 && scaledH > maxH) { scaledH = maxH; }
        }
        // ...and, for the main frame only, never below the minimum the resize
        // limit enforces (child windows keep whatever size they ask for).
        if (Win32Shell.mainHwnd == 0) {
            int minW = 800 * deviceDpi / 96;
            int minH = 600 * deviceDpi / 96;
            if (scaledW < minW) { scaledW = minW; }
            if (scaledH < minH) { scaledH = minH; }
        }
        Win32Shell.windowWidth = scaledW;
        Win32Shell.windowHeight = scaledH;

        nint rc = NativeMemory.Alloc(16);
        new Span<int>(rc, 1)[0] = 0;
        new Span<int>(rc + 4, 1)[0] = 0;
        new Span<int>(rc + 8, 1)[0] = scaledW;
        new Span<int>(rc + 12, 1)[0] = scaledH;
        Win32Shell.AdjustWindowRect(rc, 13565952, 0);   // WS_OVERLAPPEDWINDOW
        int frameW = Win32Shell.S32(rc, 8) - Win32Shell.S32(rc, 0);
        int frameH = Win32Shell.S32(rc, 12) - Win32Shell.S32(rc, 4);
        NativeMemory.Free(rc);

        nint wtitle = Wide.Of(title);
        // Secondary windows are OWNED by the main frame: the OS then keeps them
        // above it, minimizes/restores them with it, and -- what matters most --
        // reactivates the frame when the owned window closes.
        nint owner = Win32Shell.mainHwnd;
        nint hwnd = Win32Shell.CreateWindowExW(0, Win32Shell.className, wtitle,
            13565952, 0x80000000, 0x80000000, frameW, frameH, owner, 0,
            Win32Shell.instance, 0);
        Wide.Free(wtitle);
        if (hwnd == 0) { return 0; }
        // Accept files dragged in from Explorer (they arrive as WM_DROPFILES).
        Win32Shell.DragAcceptFiles(hwnd, 1);

        if (Win32Shell.mainHwnd == 0) {
            Win32Shell.mainHwnd = hwnd;
            Win32Shell.CenterWindow(hwnd);
        } else {
            Win32Shell.CenterOnOwner(hwnd);
        }

        // A 1px extended frame restores the OS drop shadow and rounded corners
        // on the borderless window.
        nint margins = NativeMemory.Alloc(16);
        new Span<int>(margins, 1)[0] = 0;
        new Span<int>(margins + 4, 1)[0] = 0;
        new Span<int>(margins + 8, 1)[0] = 0;
        new Span<int>(margins + 12, 1)[0] = 1;
        Win32Shell.DwmExtendFrameIntoClientArea(hwnd, margins);
        NativeMemory.Free(margins);
        // SWP_FRAMECHANGED | SWP_NOMOVE | SWP_NOSIZE | SWP_NOZORDER | NOACTIVATE
        Win32Shell.SetWindowPos(hwnd, 0, 0, 0, 0, 0, 0x0020 | 2 | 1 | 4 | 16);
        return hwnd;
    }

    /// Work-area rectangle of the monitor a window sits on, into scratchRect.
    static bool WorkArea(nint hwnd, int flags) {
        nint monitor = Win32Shell.MonitorFromWindow(hwnd, flags);
        nint mi = NativeMemory.Alloc(40);
        NativeMemory.Fill(mi, 0, 40);
        new Span<int>(mi, 1)[0] = 40;
        int ok = Win32Shell.GetMonitorInfoW(monitor, mi);
        if (ok != 0) {
            new Span<int>(Win32Shell.scratchRect, 1)[0] = Win32Shell.S32(mi, 20);
            new Span<int>(Win32Shell.scratchRect + 4, 1)[0] = Win32Shell.S32(mi, 24);
            new Span<int>(Win32Shell.scratchRect + 8, 1)[0] = Win32Shell.S32(mi, 28);
            new Span<int>(Win32Shell.scratchRect + 12, 1)[0] = Win32Shell.S32(mi, 32);
        }
        NativeMemory.Free(mi);
        return ok != 0;
    }

    static bool CenterWindow(nint hwnd) {
        nint wr = NativeMemory.Alloc(16);
        if (Win32Shell.GetWindowRect(hwnd, wr) == 0) {
            NativeMemory.Free(wr);
            return false;
        }
        int winW = Win32Shell.S32(wr, 8) - Win32Shell.S32(wr, 0);
        int winH = Win32Shell.S32(wr, 12) - Win32Shell.S32(wr, 4);
        NativeMemory.Free(wr);
        if (!Win32Shell.WorkArea(hwnd, 1)) { return false; }
        int waL = Win32Shell.S32(Win32Shell.scratchRect, 0);
        int waT = Win32Shell.S32(Win32Shell.scratchRect, 4);
        int waR = Win32Shell.S32(Win32Shell.scratchRect, 8);
        int waB = Win32Shell.S32(Win32Shell.scratchRect, 12);
        int x = waL + (waR - waL - winW) / 2;
        int y = waT + (waB - waT - winH) / 2;
        if (x < waL) { x = waL; }
        if (y < waT) { y = waT; }
        Win32Shell.SetWindowPos(hwnd, 0, x, y, 0, 0, 1 | 4 | 16);
        return true;
    }

    /// Secondary windows (dialogs) open centered over the main window, kept
    /// inside the monitor work area.
    static void CenterOnOwner(nint hwnd) {
        nint pr = NativeMemory.Alloc(16);
        nint cr = NativeMemory.Alloc(16);
        int okP = Win32Shell.GetWindowRect(Win32Shell.mainHwnd, pr);
        int okC = Win32Shell.GetWindowRect(hwnd, cr);
        if (okP != 0 && okC != 0) {
            int childW = Win32Shell.S32(cr, 8) - Win32Shell.S32(cr, 0);
            int childH = Win32Shell.S32(cr, 12) - Win32Shell.S32(cr, 4);
            int x = Win32Shell.S32(pr, 0)
                + (Win32Shell.S32(pr, 8) - Win32Shell.S32(pr, 0)
                    - childW) / 2;
            int y = Win32Shell.S32(pr, 4)
                + (Win32Shell.S32(pr, 12) - Win32Shell.S32(pr, 4)
                    - childH) / 2;
            if (Win32Shell.WorkArea(Win32Shell.mainHwnd, 2)) {
                int waL = Win32Shell.S32(Win32Shell.scratchRect, 0);
                int waT = Win32Shell.S32(Win32Shell.scratchRect, 4);
                int waR = Win32Shell.S32(Win32Shell.scratchRect, 8);
                int waB = Win32Shell.S32(Win32Shell.scratchRect, 12);
                if (x < waL) { x = waL; }
                if (y < waT) { y = waT; }
                if (x + childW > waR) { x = waR - childW; }
                if (y + childH > waB) { y = waB - childH; }
            }
            Win32Shell.SetWindowPos(hwnd, 0, x, y, 0, 0, 1 | 4 | 16);
        }
        NativeMemory.Free(cr);
        NativeMemory.Free(pr);
    }

    static void ShowWindowNow(nint hwnd) {
        Win32Shell.ShowWindow(hwnd, 5);
        Win32Shell.UpdateWindow(hwnd);
        Win32Shell.SetForegroundWindow(hwnd);
        Win32Shell.SetFocus(hwnd);
    }

    static void SetWindowPosition(nint hwnd, int x, int y) {
        if (hwnd == 0) { return; }
        Win32Shell.SetWindowPos(hwnd, 0, x, y, 0, 0, 1 | 4 | 16);
    }

    static void Minimize(nint hwnd) { Win32Shell.ShowWindow(hwnd, 6); }

    static void ToggleMaximize(nint hwnd) {
        if (Win32Shell.IsMaximized(hwnd)) {
            Win32Shell.ShowWindow(hwnd, 9);
        } else {
            Win32Shell.ShowWindow(hwnd, 3);
        }
    }

    static void CloseWindow(nint hwnd) {
        Win32Shell.PostMessageW(hwnd, 16, 0, 0);   // WM_CLOSE
    }

    static void Destroy(nint hwnd) {
        Win32Shell.ForgetCaptionButtons(hwnd);
        Win32Shell.DestroyWindow(hwnd);
    }

    static bool Maximized(nint hwnd) { return Win32Shell.IsMaximized(hwnd); }

    static bool Visible(nint hwnd) {
        if (Win32Shell.IsIconic(hwnd) != 0) { return false; }
        return Win32Shell.IsWindowVisible(hwnd) != 0;
    }

    static bool Focused(nint hwnd) {
        if (hwnd == 0) { return false; }
        return Win32Shell.GetForegroundWindow() == hwnd;
    }

    static void SetTopmost(nint hwnd, bool on) {
        nint after = 0 - 2;                        // HWND_NOTOPMOST
        if (on) { after = 0 - 1; }                 // HWND_TOPMOST
        Win32Shell.SetWindowPos(hwnd, after, 0, 0, 0, 0, 2 | 1 | 16);
    }

    static void SetTitle(nint hwnd, string title) {
        nint wtitle = Wide.Of(title);
        Win32Shell.SetWindowTextW(hwnd, wtitle);
        Wide.Free(wtitle);
    }

    /// The caption-button count registered for `hwnd` (5 until it says).
    static int CaptionButtonsOf(nint hwnd) {
        Win32Shell.Init();
        int i = 0;
        while (i < Win32Shell.capHwnd.Count) {
            if (Win32Shell.capHwnd[i] == hwnd) { return Win32Shell.capCount[i]; }
            i = i + 1;
        }
        return 5;
    }

    static void SetCaptionButtons(nint hwnd, int count) {
        Win32Shell.Init();
        if (count < 0 || count > 8) { return; }
        int i = 0;
        while (i < Win32Shell.capHwnd.Count) {
            if (Win32Shell.capHwnd[i] == hwnd) {
                Win32Shell.capCount[i] = count;
                return;
            }
            i = i + 1;
        }
        Win32Shell.capHwnd.Add(hwnd);
        Win32Shell.capCount.Add(count);
    }

    /// Forgets a closed window's caption-button strip.
    static void ForgetCaptionButtons(nint hwnd) {
        Win32Shell.Init();
        int i = 0;
        while (i < Win32Shell.capHwnd.Count) {
            if (Win32Shell.capHwnd[i] == hwnd) {
                Win32Shell.capHwnd.RemoveAt(i);
                Win32Shell.capCount.RemoveAt(i);
                return;
            }
            i = i + 1;
        }
    }

    static int TitlebarHeight() {
        Win32Shell.Init();
        return Win32Shell.titlebarH;
    }

    static int CaptionButtonWidth() {
        Win32Shell.Init();
        return Win32Shell.buttonW;
    }

    static int ClientWidth(nint hwnd) {
        if (hwnd == 0) { return 0; }
        nint rc = Win32Shell.scratchRect;
        if (Win32Shell.GetClientRect(hwnd, rc) == 0) { return 0; }
        return Win32Shell.S32(rc, 8) - Win32Shell.S32(rc, 0);
    }

    static int ClientHeight(nint hwnd) {
        if (hwnd == 0) { return 0; }
        nint rc = Win32Shell.scratchRect;
        if (Win32Shell.GetClientRect(hwnd, rc) == 0) { return 0; }
        return Win32Shell.S32(rc, 12) - Win32Shell.S32(rc, 4);
    }

    static int WindowWidth() { return Win32Shell.windowWidth; }
    static int WindowHeight() { return Win32Shell.windowHeight; }

    static void SetCursorShape(int kind) {
        int id = 32512;
        if (kind == 1) { id = 32649; }             // hand
        if (kind == 2) { id = 32513; }             // I-beam
        if (kind == 3) { id = 32644; }             // size WE
        if (kind == 4) { id = 32645; }             // size NS
        if (kind == 5) { id = 32515; }             // cross
        Win32Shell.SetCursor(Win32Shell.LoadCursorW(0, id));
    }

    static void EnableGlass(nint hwnd, int tintArgb) {
        Win32Shell.Init();
        if (hwnd == 0) { return; }
        nint ex = Win32Shell.GetWindowLongPtrW(hwnd, 0 - 20);
        if ((ex & 0x00080000) == 0) {              // WS_EX_LAYERED
            Win32Shell.SetWindowLongPtrW(hwnd, 0 - 20, ex | 0x00080000);
        }
        Win32Shell.glassTint = tintArgb;
        Win32Shell.AcrylicApply(hwnd, 4, tintArgb);
        Win32Shell.glassOn = true;
        int own = Win32Shell.SurfaceOf(hwnd);
        if (own >= 0) { Win32Shell.PresentLayered(hwnd, own); }
    }

    static void DisableGlass(nint hwnd) {
        Win32Shell.Init();
        if (hwnd == 0) { return; }
        Win32Shell.AcrylicApply(hwnd, 0, 0);
        nint ex = Win32Shell.GetWindowLongPtrW(hwnd, 0 - 20);
        Win32Shell.SetWindowLongPtrW(hwnd, 0 - 20, ex & ~0x00080000);
        Win32Shell.glassOn = false;
    }

    static void SetOpacity(nint hwnd, int percent) {
        Win32Shell.Init();
        if (hwnd == 0) { return; }
        if (percent < 10) { percent = 10; }
        if (percent > 100) { percent = 100; }
        nint ex = Win32Shell.GetWindowLongPtrW(hwnd, 0 - 20);
        if (percent >= 100) {
            if (!Win32Shell.glassOn && (ex & 0x00080000) != 0) {
                Win32Shell.SetLayeredWindowAttributes(hwnd, 0, 255, 2);
                Win32Shell.SetWindowLongPtrW(hwnd, 0 - 20, ex & ~0x00080000);
            }
            return;
        }
        if ((ex & 0x00080000) == 0) {
            Win32Shell.SetWindowLongPtrW(hwnd, 0 - 20, ex | 0x00080000);
        }
        Win32Shell.SetLayeredWindowAttributes(hwnd, 0, percent * 255 / 100, 2);
    }

    /// Window silhouette as the UNION of shape regions. `spec` is
    /// "t,x,y,w,h,r;t,x,y,w,h,r;..." in logical px (type 1 = rounded rect with
    /// corner radius r, type 2 = ellipse with w/h its bounding box; r unused).
    /// "" restores a plain opaque rectangle. Two paths, both Windows-7 safe:
    /// with DWM composition on the window is layered and composited per-pixel
    /// (anti-aliased edges, outside pixels click through); with DWM off it
    /// falls back to a combined SetWindowRgn (hard edges, same click-through).
    /// No SetWindowCompositionAttribute is involved (Win8+ only).
    static void SetShape(nint hwnd, string spec) {
        Win32Shell.Init();
        if (hwnd == 0) { return; }
        List<int> regs = new List<int>();
        if (spec.Length > 0) {
            List<string> parts = spec.Split(";");
            int i = 0;
            while (i < parts.Count) {
                List<string> nums = parts[i].Split(",");
                if (nums.Count >= 6) {
                    regs.Add(Convert.ToInt32(nums[0]));
                    regs.Add(Convert.ToInt32(nums[1]));
                    regs.Add(Convert.ToInt32(nums[2]));
                    regs.Add(Convert.ToInt32(nums[3]));
                    regs.Add(Convert.ToInt32(nums[4]));
                    regs.Add(Convert.ToInt32(nums[5]));
                }
                i = i + 1;
            }
        }
        if (regs.Count == 0) {
            // Plain opaque window again: clear any region + layered style.
            Win32Shell.SetWindowRgn(hwnd, 0, true);
            nint ex = Win32Shell.GetWindowLongPtrW(hwnd, 0 - 20);
            if ((ex & 0x00080000) != 0) {
                Win32Shell.SetLayeredWindowAttributes(hwnd, 0, 255, 2);
                Win32Shell.SetWindowLongPtrW(hwnd, 0 - 20, ex & ~0x00080000);
            }
            Win32Shell.shapeMode = 0;
            Win32Shell.shapeRegions = new List<int>();
            Win32Shell.shapeMask = new List<byte>();
            Win32Shell.glassOn = false;
            return;
        }
        Win32Shell.shapeRegions = regs;
        Win32Shell.shapeMask = new List<byte>();
        // Flag the shape BEFORE shrinking: FitShapeWindow's SetWindowPos must
        // not be clamped by the main frame's 800x600 WM_GETMINMAXINFO minimum.
        Win32Shell.shapeMode = 1;
        Win32Shell.FitShapeWindow(hwnd, regs);
        if (Win32Shell.DwmComposited()) {
            // Layered per-pixel alpha path: no acrylic blur, just the shape.
            nint ex = Win32Shell.GetWindowLongPtrW(hwnd, 0 - 20);
            if ((ex & 0x00080000) == 0) {              // WS_EX_LAYERED
                Win32Shell.SetWindowLongPtrW(hwnd, 0 - 20, ex | 0x00080000);
            }
            Win32Shell.glassOn = true;                 // route Present through PresentLayered
            int own = Win32Shell.SurfaceOf(hwnd);
            if (own >= 0) { Win32Shell.PresentLayered(hwnd, own); }
        } else {
            // No DWM (e.g. Win7 with composition disabled): a classic region
            // window. Region coords are client pixels (scaled to physical).
            Win32Shell.glassOn = false;
            nint ex = Win32Shell.GetWindowLongPtrW(hwnd, 0 - 20);
            if ((ex & 0x00080000) != 0) {
                Win32Shell.SetLayeredWindowAttributes(hwnd, 0, 255, 2);
                Win32Shell.SetWindowLongPtrW(hwnd, 0 - 20, ex & ~0x00080000);
            }
            Win32Shell.SetShapeRgn(hwnd, regs);
            int own = Win32Shell.SurfaceOf(hwnd);
            if (own >= 0) { Win32Shell.Blit(hwnd, own); }
        }
    }

    /// Shrinks (or grows) the window so its client area exactly matches the
    /// bounding box of the shape regions, scaled to physical px. Without this
    /// a small shaped design would be padded to the 800x600 main-frame minimum
    /// and the silhouette would be mis-sized. Keeps the window centered. The
    /// regions are expected window-relative (min x/y >= 0); shapes that extend
    /// above/left of the window are left alone.
    static void FitShapeWindow(nint hwnd, List<int> regs) {
        if (regs.Count == 0) { return; }
        int minX = 2147483647;
        int minY = 2147483647;
        int maxX = -2147483648;
        int maxY = -2147483648;
        int i = 0;
        while (i + 5 < regs.Count) {
            int x = regs[i + 1];
            int y = regs[i + 2];
            int w = regs[i + 3];
            int h = regs[i + 4];
            if (x < minX) { minX = x; }
            if (y < minY) { minY = y; }
            int x2 = x + w;
            if (x2 > maxX) { maxX = x2; }
            int y2 = y + h;
            if (y2 > maxY) { maxY = y2; }
            i = i + 6;
        }
        if (minX < 0 || minY < 0) { return; }
        int scale = Win32Shell.DpiScale();
        int cw = (maxX - minX) * scale / 100;
        int ch = (maxY - minY) * scale / 100;
        if (cw <= 0 || ch <= 0) { return; }
        nint rc = NativeMemory.Alloc(16);
        Win32Shell.GetWindowRect(hwnd, rc);
        int winW = Win32Shell.S32(rc, 8) - Win32Shell.S32(rc, 0);
        int winH = Win32Shell.S32(rc, 12) - Win32Shell.S32(rc, 4);
        int cx = Win32Shell.S32(rc, 0) + winW / 2;
        int cy = Win32Shell.S32(rc, 4) + winH / 2;
        NativeMemory.Free(rc);
        // Outer size that yields the requested client size (client = bbox).
        // Measure the ACTUAL chrome delta (DWM frame extension eats the frame,
        // so AdjustWindowRect's estimate is off) and add it to the target.
        nint cr = NativeMemory.Alloc(16);
        Win32Shell.GetClientRect(hwnd, cr);
        int curCw = Win32Shell.S32(cr, 8) - Win32Shell.S32(cr, 0);
        int curCh = Win32Shell.S32(cr, 12) - Win32Shell.S32(cr, 4);
        NativeMemory.Free(cr);
        int outerW = cw + (winW - curCw);
        int outerH = ch + (winH - curCh);
        if (outerW == winW && outerH == winH) { return; }
        // SWP_NOZORDER | SWP_NOACTIVATE: size + reposition, keep the center.
        Win32Shell.SetWindowPos(hwnd, 0, cx - outerW / 2, cy - outerH / 2,
            outerW, outerH, 4 | 16);
    }

    /// True while DWM desktop composition is enabled (Vista+; Win7 returns
    /// true normally and false only when the user switched it off).
    static bool DwmComposited() {
        nint fn = Interop.Entry("dwmapi.dll", "DwmIsCompositionEnabled");
        if (fn == 0) { return true; }   // assume composited when unknown
        nint slot = NativeMemory.Alloc(4);
        DwmIsCompFn call = (DwmIsCompFn)fn;
        call(slot);
        int enabled = new Span<int>(slot, 1)[0];
        NativeMemory.Free(slot);
        return enabled != 0;
    }

    /// Classic region fallback (Win7 without DWM): union of rounded-rect and
    /// ellipse regions. The window owns the merged region after SetWindowRgn.
    static void SetShapeRgn(nint hwnd, List<int> regs) {
        int scale = Win32Shell.DpiScale();
        nint merged = 0;
        int i = 0;
        while (i + 5 < regs.Count) {
            int t = regs[i];
            int x = regs[i + 1] * scale / 100;
            int y = regs[i + 2] * scale / 100;
            int w = regs[i + 3] * scale / 100;
            int h = regs[i + 4] * scale / 100;
            int r = regs[i + 5] * scale / 100;
            nint rgn = 0;
            if (t == 2) {
                rgn = Win32Shell.CreateEllipticRgn(x, y, x + w, y + h);
            } else {
                if (r < 0) { r = 0; }
                rgn = Win32Shell.CreateRoundRectRgn(x, y, x + w, y + h, r, r);
            }
            if (rgn != 0) {
                if (merged == 0) { merged = rgn; }
                else {
                    Win32Shell.CombineRgn(merged, merged, rgn, 2); // RGN_OR
                    Win32Shell.DeleteObject(rgn);
                }
            }
            i = i + 6;
        }
        if (merged != 0) { Win32Shell.SetWindowRgn(hwnd, merged, true); }
    }

    /// Signed distance (in 1/16-pixel fixed point, negative inside) from the
    /// subpixel sample (sx, sy) — also 1/16-pixel units — to the nearest edge
    /// of the shaped silhouette. Rounded rects use the standard SDF; ellipses
    /// the exact SDF. All arithmetic is 64-bit so large windows can't
    /// overflow the squared distances.
    static long ShapeSdfFp(List<int> regs, long sx, long sy, int scale) {
        long best = 9223372036854775807;
        int i = 0;
        while (i + 5 < regs.Count) {
            int t = regs[i];
            long x = (long)(regs[i + 1] * scale / 100) * 16;
            long y = (long)(regs[i + 2] * scale / 100) * 16;
            long w = (long)(regs[i + 3] * scale / 100) * 16;
            long h = (long)(regs[i + 4] * scale / 100) * 16;
            long r = (long)(regs[i + 5] * scale / 100) * 16;
            long d = 0;
            if (t == 2) {
                long cx = x + w / 2;
                long cy = y + h / 2;
                long rad = w / 2;
                if (rad < 1) { rad = 1; }
                long dx = sx - cx;
                long dy = sy - cy;
                long dist = Win32Shell.ISqrt64(dx * dx + dy * dy);
                d = dist - rad;
            } else {
                if (r < 0) { r = 0; }
                if (r * 2 > w) { r = w / 2; }
                if (r * 2 > h) { r = h / 2; }
                // Standard rounded-rect SDF: the point is expressed as an
                // absolute offset (ax, ay) from the centre; q is the offset
                // beyond the un-rounded core, and the distance is
                // length(max(q,0)) - r. Negative inside, positive outside.
                long ax = sx - (x + w / 2);
                if (ax < 0) { ax = 0 - ax; }
                long ay = sy - (y + h / 2);
                if (ay < 0) { ay = 0 - ay; }
                long hw2 = w / 2 - r;
                long hh2 = h / 2 - r;
                long qx = ax - hw2;
                long qy = ay - hh2;
                if (qx < 0) { qx = 0; }
                if (qy < 0) { qy = 0; }
                long dist = Win32Shell.ISqrt64(qx * qx + qy * qy);
                d = dist - r;
            }
            if (d < best) { best = d; }
            i = i + 6;
        }
        return best;
    }

    /// 64-bit integer square root (floor) via Newton iteration — converges in
    /// a handful of steps regardless of magnitude, unlike a linear scan.
    static long ISqrt64(long v) {
        if (v <= 0) { return 0; }
        long x = v;
        long y = (x + 1) / 2;
        while (y < x) {
            x = y;
            y = (x + v / x) / 2;
        }
        return x;
    }

    /// Rebuilds the per-pixel coverage mask (0..255) for the current shape
    /// list at physical size sw x sh, unless a matching cached mask exists.
    /// Each pixel is supersampled 4x4: sixteen subpixel samples (at 1/16-pixel
    /// resolution, i.e. sample centres 1/8, 3/8, 5/8, 7/8 of the way across
    /// the pixel) are SDF-tested and averaged. A single centre sample leaves
    /// rounded corners as a 1px staircase; the supersampled mean reads as a
    /// smooth anti-aliased edge that lines up with the renderer's own
    /// double-precision corner arcs.
    static List<byte> ShapeMask(int sw, int sh) {
        if (Win32Shell.shapeMask != null
                && Win32Shell.shapeMaskW == sw && Win32Shell.shapeMaskH == sh) {
            return Win32Shell.shapeMask;
        }
        int scale = Win32Shell.DpiScale();
        List<byte> mask = new List<byte>();
        int n = sw * sh;
        int i = 0;
        while (i < n) {
            int px = i % sw;
            int py = i / sw;
            int sum = 0;
            int sa = 0;
            while (sa < 4) {
                int sb = 0;
                while (sb < 4) {
                    long sx = (long)px * 16 + sa * 4 + 2;
                    long sy = (long)py * 16 + sb * 4 + 2;
                    long d = Win32Shell.ShapeSdfFp(Win32Shell.shapeRegions,
                                                   sx, sy, scale);
                    // coverage = clamp(0.5 - sdf, 0, 1) in 1/16-pixel units:
                    // 0.5px = 8/16, so the ramp is cov = 8 - d over [0,16].
                    long cov = 8 - d;
                    if (cov < 0) { cov = 0; }
                    if (cov > 16) { cov = 16; }
                    sum = sum + (int)cov;
                    sb = sb + 1;
                }
                sa = sa + 1;
            }
            int c2 = sum; // 16 samples * 0..16 = 0..256
            if (c2 > 255) { c2 = 255; }
            if (c2 == 0) {
                // Type-3 shadow-band regions only extend the OS surface: the
                // canvas's own alpha (the soft shadow PaintShapeShadow painted)
                // must composite untouched, so the band is opaque in the mask.
                // Pixels the shadow never reached stay transparent because
                // their canvas alpha is 0. Coverage of the real silhouette
                // (types 1/2) wins wherever it is non-zero, so corner AA is
                // never flattened by the band.
                int inBand = 0;
                int rj = 0;
                while (rj + 5 < Win32Shell.shapeRegions.Count) {
                    if (Win32Shell.shapeRegions[rj] == 3) {
                        long bx0 = (long)Win32Shell.shapeRegions[rj + 1] * scale / 100 * 16;
                        long by0 = (long)Win32Shell.shapeRegions[rj + 2] * scale / 100 * 16;
                        long bx1 = bx0 + (long)Win32Shell.shapeRegions[rj + 3] * scale / 100 * 16;
                        long by1 = by0 + (long)Win32Shell.shapeRegions[rj + 4] * scale / 100 * 16;
                        long sx = (long)px * 16 + 8;
                        long sy = (long)py * 16 + 8;
                        if (sx >= bx0 && sx < bx1 && sy >= by0 && sy < by1) {
                            inBand = 1;
                            rj = Win32Shell.shapeRegions.Count;
                        }
                    }
                    rj = rj + 6;
                }
                if (inBand != 0) { c2 = 255; }
            }
            mask.Add((byte)c2);
            i = i + 1;
        }
        Win32Shell.shapeMask = mask;
        Win32Shell.shapeMaskW = sw;
        Win32Shell.shapeMaskH = sh;
        return mask;
    }

    static void Present(nint hwnd, int surface) {
        Win32Shell.Init();
        if (Win32Shell.zan_gui_get_pixels(surface) == 0) { return; }
        Win32Shell.lastSurface = surface;
        Win32Shell.RememberSurface(hwnd, surface);
        if (Win32Shell.shapeMode != 0) {
            // Shaped window: per-pixel alpha composite with the silhouette
            // mask (PresentLayered premultiplies and lets the OS blend the
            // transparent outside of the shape against the desktop).
            Win32Shell.PresentLayered(hwnd, surface);
        } else {
            Win32Shell.Blit(hwnd, surface);
        }
    }

    static void PresentDirty(int x, int y, int w, int h) {
        Win32Shell.Init();
        if (w <= 0 || h <= 0) { return; }
        if (Win32Shell.dirty.Count >= 2048) {
            Win32Shell.dirtyOverflow = true;
            return;
        }
        Win32Shell.dirty.Add(x);
        Win32Shell.dirty.Add(y);
        Win32Shell.dirty.Add(w);
        Win32Shell.dirty.Add(h);
    }

    // ---- event loop ---------------------------------------------------------

    static void ClearEvent() {
        Win32Shell.hasEvent = false;
        Win32Shell.evHwnd = 0;
        Win32Shell.evKind = 0;
        Win32Shell.evX = 0;
        Win32Shell.evY = 0;
        Win32Shell.evButton = 0;
        Win32Shell.evKeyCode = 0;
        Win32Shell.evMods = 0;
    }

    /// Serve one queued synthetic event, if the automation driver left any.
    static bool DrainInjected() {
        bool got = false;
        Win32Shell.EnterCriticalSection(Win32Shell.injectCs);
        if (Win32Shell.injectQ.Count >= 6) {
            Win32Shell.evKind = Win32Shell.injectQ[0];
            Win32Shell.evX = Win32Shell.injectQ[1];
            Win32Shell.evY = Win32Shell.injectQ[2];
            Win32Shell.evButton = Win32Shell.injectQ[3];
            Win32Shell.evKeyCode = Win32Shell.injectQ[4];
            Win32Shell.evMods = Win32Shell.injectQ[5];
            int i = 0;
            while (i < 6) {
                Win32Shell.injectQ.RemoveAt(0);
                i = i + 1;
            }
            nint target = Win32Shell.injectHwnd[0];
            Win32Shell.injectHwnd.RemoveAt(0);
            if (target == 0) { target = Win32Shell.mainHwnd; }
            Win32Shell.evHwnd = target;
            Win32Shell.hasEvent = true;
            got = true;
        }
        Win32Shell.LeaveCriticalSection(Win32Shell.injectCs);
        return got;
    }

    static int PollEvent() {
        Win32Shell.Init();
        Win32Shell.ClearEvent();
        if (Win32Shell.DrainInjected()) { return 0; }
        nint msg = Win32Shell.scratchMsg;
        while (Win32Shell.PeekMessageW(msg, 0, 0, 0, 1) != 0) {
            if (Win32Shell.S32(msg, 8) == 18) { return 0 - 1; }  // WM_QUIT
            Win32Shell.TranslateMessage(msg);
            Win32Shell.DispatchMessageW(msg);
            if (Win32Shell.hasEvent) { return 0; }
        }
        return 1;
    }

    static int WaitEvent() {
        Win32Shell.Init();
        Win32Shell.ClearEvent();
        if (Win32Shell.DrainInjected()) { return 0; }
        nint msg = Win32Shell.scratchMsg;
        if (Win32Shell.GetMessageW(msg, 0, 0, 0) <= 0) { return 0 - 1; }
        Win32Shell.TranslateMessage(msg);
        Win32Shell.DispatchMessageW(msg);
        return 0;
    }

    static int WaitEventTimeout(int ms) {
        Win32Shell.Init();
        Win32Shell.ClearEvent();
        if (Win32Shell.DrainInjected()) { return 0; }
        if (ms < 0) { ms = 0; }
        int start = Win32Shell.GetTickCount();
        nint msg = Win32Shell.scratchMsg;
        while (true) {
            while (Win32Shell.PeekMessageW(msg, 0, 0, 0, 1) != 0) {
                if (Win32Shell.S32(msg, 8) == 18) { return 0 - 1; }
                Win32Shell.TranslateMessage(msg);
                Win32Shell.DispatchMessageW(msg);
                if (Win32Shell.hasEvent) { return 0; }
            }
            int elapsed = Win32Shell.GetTickCount() - start;
            if (elapsed >= ms) { return 1; }
            // QS_ALLINPUT = 0x04FF; WAIT_TIMEOUT = 258
            int wr = Win32Shell.MsgWaitForMultipleObjects(0, 0, 0,
                ms - elapsed, 0x04FF);
            if (wr == 258) { return 1; }
        }
        return 1;
    }

    static void Wake() {
        Win32Shell.Init();
        if (Win32Shell.mainHwnd != 0) {
            Win32Shell.PostMessageW(Win32Shell.mainHwnd, 0, 0, 0);
        }
    }

    static void InjectEvent(nint hwnd, int kind, int x, int y, int button,
                            int keycode, int mods) {
        Win32Shell.Init();
        Win32Shell.EnterCriticalSection(Win32Shell.injectCs);
        Win32Shell.injectQ.Add(kind);
        Win32Shell.injectQ.Add(x);
        Win32Shell.injectQ.Add(y);
        Win32Shell.injectQ.Add(button);
        Win32Shell.injectQ.Add(keycode);
        Win32Shell.injectQ.Add(mods);
        Win32Shell.injectHwnd.Add(hwnd);
        Win32Shell.LeaveCriticalSection(Win32Shell.injectCs);
        Win32Shell.Wake();
    }

    static int InjectPending() {
        Win32Shell.Init();
        Win32Shell.EnterCriticalSection(Win32Shell.injectCs);
        int n = Win32Shell.injectHwnd.Count;
        Win32Shell.LeaveCriticalSection(Win32Shell.injectCs);
        return n;
    }

    static int EventKindValue() { return Win32Shell.evKind; }
    static int EventXValue() { return Win32Shell.evX; }
    static int EventYValue() { return Win32Shell.evY; }
    static int EventButtonValue() { return Win32Shell.evButton; }
    static int EventKeyCodeValue() { return Win32Shell.evKeyCode; }
    static int EventModsValue() { return Win32Shell.evMods; }
    static nint EventWindow() { return Win32Shell.evHwnd; }

    /// Monotonic milliseconds from the performance counter: GetTickCount only
    /// moves every ~15 ms, which makes per-frame animation steps jitter.
    static int TickMs() {
        Win32Shell.Init();
        nint slot = NativeMemory.Alloc(16);
        Win32Shell.QueryPerformanceFrequency(slot);
        long freq = new Span<long>(slot, 1)[0];
        Win32Shell.QueryPerformanceCounter(slot);
        long now = new Span<long>(slot, 1)[0];
        NativeMemory.Free(slot);
        if (freq <= 0) { return Win32Shell.GetTickCount(); }
        return (int)(now * 1000 / freq);
    }

    static void Sleep(int ms) {
        if (ms > 0) { Win32Shell.SleepW(ms); }
    }

    // ---- clipboard ----------------------------------------------------------

    static bool SetClipboard(string text) {
        Win32Shell.Init();
        nint wide = Wide.Of(text);
        int units = Wide.Length(wide);
        // GMEM_MOVEABLE; the clipboard takes ownership on success.
        nint mem = Win32Shell.GlobalAlloc(2, (units + 1) * 2);
        if (mem == 0) { Wide.Free(wide); return false; }
        nint dst = Win32Shell.GlobalLock(mem);
        if (dst == 0) {
            Win32Shell.GlobalFree(mem);
            Wide.Free(wide);
            return false;
        }
        NativeMemory.Copy(dst, wide, (units + 1) * 2);
        Win32Shell.GlobalUnlock(mem);
        Wide.Free(wide);
        if (Win32Shell.OpenClipboard(Win32Shell.mainHwnd) == 0) {
            Win32Shell.GlobalFree(mem);
            return false;
        }
        Win32Shell.EmptyClipboard();
        nint ok = Win32Shell.SetClipboardData(13, mem);   // CF_UNICODETEXT
        Win32Shell.CloseClipboard();
        if (ok == 0) {
            Win32Shell.GlobalFree(mem);
            return false;
        }
        return true;
    }

    static string GetClipboard() {
        Win32Shell.Init();
        if (Win32Shell.IsClipboardFormatAvailable(13) == 0) { return ""; }
        if (Win32Shell.OpenClipboard(Win32Shell.mainHwnd) == 0) { return ""; }
        nint handle = Win32Shell.GetClipboardData(13);
        if (handle == 0) {
            Win32Shell.CloseClipboard();
            return "";
        }
        nint text = Win32Shell.GlobalLock(handle);
        string text2 = "";
        if (text != 0) {
            text2 = Wide.Read(text);
            Win32Shell.GlobalUnlock(handle);
        }
        Win32Shell.CloseClipboard();
        return text2;
    }

    /// Screen DPI as a percentage of 96 (150 on a 144 dpi display).
    static int DpiScale() {
        nint dc = Win32Shell.GetDC(0);
        int deviceDpi = Win32Shell.GetDeviceCaps(dc, 88);
        Win32Shell.ReleaseDC(0, dc);
        if (deviceDpi <= 0) { return 100; }
        return deviceDpi * 100 / 96;
    }

    /// Overwrite a file with UTF-8 text, prefixed with a BOM so spreadsheet
    /// apps detect the encoding of an exported CJK CSV.
    static bool WriteTextFile(string path, string content) {
        nint wpath = Wide.Of(path);
        // GENERIC_WRITE, no sharing, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL
        nint file = Win32Shell.CreateFileW(wpath, 0x40000000, 0, 0, 2, 128, 0);
        Wide.Free(wpath);
        if (file == 0 - 1 || file == 0) { return false; }
        nint written = NativeMemory.Alloc(8);
        nint bom = NativeMemory.Alloc(4);
        new Span<byte>(bom, 1)[0] = 239;
        new Span<byte>(bom + 1, 1)[0] = 187;
        new Span<byte>(bom + 2, 1)[0] = 191;
        Win32Shell.WriteFile(file, bom, 3, written, 0);
        NativeMemory.Free(bom);
        int bytes = content.Length;
        int ok = 1;
        if (bytes > 0) {
            nint buf = NativeMemory.Alloc(bytes + 1);
            NativeMemory.PutString(buf, 0, content, bytes);
            ok = Win32Shell.WriteFile(file, buf, bytes, written, 0);
            NativeMemory.Free(buf);
        }
        NativeMemory.Free(written);
        Win32Shell.CloseHandle(file);
        return ok != 0;
    }

    /// Background colour used to fill the margin exposed by a live resize
    /// before the app repaints, kept in sync by the canvas clear.
    static void SetBackground(int color) {
        Win32Shell.Init();
        Win32Shell.bgColor = color;
    }
}

#endif
