using System;

namespace Gui;

/// 为可视化设计器和序列化器描述 Control 的一个可编辑属性，
/// 以及读写它的方式。控件从 Props() 返回其列表，
/// 并把每个 spec 指向它编辑的字段：
///
///     PropSpec icon = PropSpec.Text("icon", "Icon");
///     icon.str = Icon;            // 编译器合成的访问器对
///     ps.Add(icon);
///
/// 因为 spec 携带访问器对，`Control.GetProp/SetProp` 就能
/// 泛化地读写每个属性——控件只声明一次属性，
/// 而不必在三个字符串匹配方法里重复。
///
/// kind：0 文本，1 整数，2 布尔，3 枚举（见 `options`），4 颜色。
class PropSpec {
    string key;
    /// 同一属性在文档中应答的附加键（布尔标志的 "checked on"、
    /// "value" 等）；序列化器从不回写它们。
    string alias;
    string label;
    int kind;
    List<string> options;
    /// 绑定的字段，按 `kind` 三者取其一。在这里给字段赋值
    /// 即成为实时绑定，值会直接读写
    /// 到控件；给已有 Binding 赋值则共享它。
    Binding<string> str;
    Binding<int> num;
    Binding<bool> flag;
    /// 针对值具有响应性的控件，用 signal 而非字段：
    /// 写入经由 Set 走，订阅者仍能收到变更事件。
    SignalString sstr;
    SignalInt snum;
    SignalBool sflag;
    /// 写入该属性同时重命名节点时为 true，使设计器
    /// 树跟随标识该控件的文本。
    bool syncName;

    PropSpec(string k, string lbl, int kd) {
        key = k;
        alias = "";
        label = lbl;
        kind = kd;
        options = new List<string>();
        str = null;
        num = null;
        flag = null;
        sstr = null;
        snum = null;
        sflag = null;
        syncName = false;
    }

    /// spec 一旦指向字段或 signal 即为 true，这正是
    /// 基类无需控件协助就能服务该属性的原因。
    bool IsBound() {
        return str != null || num != null || flag != null ||
               sstr != null || snum != null || sflag != null;
    }

    /// 当 `key` 命名该属性（自身键或某个别名）时为 true。
    bool Answers(string k) {
        return key == k || Style.Has(alias, k);
    }

    /// 将此属性标记为同时命名节点的属性。
    PropSpec AsName() {
        syncName = true;
        return this;
    }

    /// 在文档中也应答 `k`（返回 this，便于链式调用）。
    PropSpec Also(string k) {
        if (alias == "") { alias = k; }
        else { alias = alias + " " + k; }
        return this;
    }

    /// 属性值的字符串形式，即设计器与文档格式交换所用的形式
    /// （标志为 `"true"`/`"false"`，数字为十进制）。
    string Read() {
        if (str != null) { return str.Get(); }
        if (num != null) { return Convert.ToString(num.Get()); }
        if (flag != null) { return PropSpec.Flag(flag.Get()); }
        if (sstr != null) { return sstr.Get(); }
        if (snum != null) { return Convert.ToString(snum.Get()); }
        if (sflag != null) { return PropSpec.Flag(sflag.Get()); }
        return "";
    }

    void Write(string val) {
        if (str != null) { str.Set(val); return; }
        if (num != null) { num.Set(Convert.ToInt32(val)); return; }
        if (flag != null) { flag.Set(PropSpec.IsOn(val)); return; }
        if (sstr != null) { sstr.Set(val); return; }
        if (snum != null) { snum.Set(Convert.ToInt32(val)); return; }
        if (sflag != null) { sflag.Set(PropSpec.IsOn(val)); }
    }

    static string Flag(bool on) {
        if (on) { return "true"; }
        return "false";
    }

    static bool IsOn(string val) {
        return val == "true" || val == "1";
    }

    static PropSpec Text(string k, string lbl) { return new PropSpec(k, lbl, 0); }
    static PropSpec Int(string k, string lbl) { return new PropSpec(k, lbl, 1); }
    static PropSpec Bool(string k, string lbl) { return new PropSpec(k, lbl, 2); }
    static PropSpec Color(string k, string lbl) { return new PropSpec(k, lbl, 4); }

    /// 枚举属性，值为 `opts` 之一（以其标签文本存储）。
    static PropSpec Enum(string k, string lbl, List<string> opts) {
        PropSpec p = new PropSpec(k, lbl, 3);
        p.options = opts;
        return p;
    }

    PropSpec Option(string o) {
        options.Add(o);
        return this;
    }
}
