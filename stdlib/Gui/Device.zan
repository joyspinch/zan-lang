using System;

namespace Gui;

/// <summary>
/// 目标设备画像：新建项目向导与 .zform 设计器共用的
/// 设备单一来源。一张画像 = 一个设备类别 + 它的设计
/// 基准视口（逻辑像素）+ 该类别是否允许自由尺寸。
///
/// 锁定的是"设计基准"而不是物理尺寸：运行时按实际表面
/// 等比拟合（App.Show 的画布拟合）或流式重排（FbFlow
/// 24 列网格 / Flexbox），所以手机有大小之分、折叠屏
/// 中途变形都不需要额外的画像——它们由重排与拟合兜住。
///
/// 桌面 / 2in1 是唯一的自由类别：窗口尺寸由用户决定，
/// 沿用向导里的分辨率预设与自定义宽高。其余类别的画布
/// 尺寸由画像给出，设计器里不可改，只允许画像声明的
/// 横竖屏切换。
/// </summary>
class DeviceProfile {
    /// 画像 id（.zform "device" 键、manifest "device=" 的取值）。
    string id;
    /// 英文 / 中文显示名。
    string en;
    string zh;
    /// 竖屏（portrait）设计基准视口。
    int pw;
    int ph;
    /// 横屏（landscape）设计基准视口；不支持横屏时与竖屏相同。
    int lw;
    int lh;
    /// true = 设计尺寸锁定为画像视口，不可自由填写。
    bool locked;
    /// true = 允许横竖屏切换（画像内互换基准视口）。
    bool rotatable;
    /// true = 圆形表盘（穿戴）。
    bool round;

    /// 私有构造：全部画像在 All() 中静态声明。
    DeviceProfile(string i, string e, string c, int pw0, int ph0,
                  int lw0, int lh0, bool lk, bool rot, bool rnd) {
        id = i;
        en = e;
        zh = c;
        pw = pw0;
        ph = ph0;
        lw = lw0;
        lh = lh0;
        locked = lk;
        rotatable = rot;
        round = rnd;
    }

    /// 画像 id（"desktop" / "phone" / ... ）。
    string Id() { return id; }
    /// 按界面语言取显示名（lang "zh" 返回中文名）。
    string Label(string lang) {
        if (lang == "zh") { return zh; }
        return en;
    }
    /// 该类别是否锁定设计尺寸。
    bool Locked() { return locked; }
    /// 该类别是否允许横竖屏切换。
    bool Rotatable() { return rotatable; }
    /// 该类别是否为圆形表盘。
    bool Round() { return round; }

    /// 指定方向（0 竖屏 / 1 横屏）的设计画布宽 / 高。
    int CanvasW(int orient) {
        if (orient == 1) { return lw; }
        return pw;
    }
    int CanvasH(int orient) {
        if (orient == 1) { return lh; }
        return ph;
    }

    /// 全部设备画像（顺序即向导 chips 的顺序；0 号是自由的
    /// 桌面/2in1，也是 .zform 缺省——"device" 键为空即它）。
    static List<DeviceProfile> All() {
        List<DeviceProfile> ps = new List<DeviceProfile>();
        ps.Add(new DeviceProfile("desktop", "Desktop / 2-in-1", "桌面 / 2in1",
                                 1000, 680, 1000, 680, false, true, false));
        ps.Add(new DeviceProfile("phone", "Phone", "手机",
                                 390, 844, 844, 390, true, true, false));
        ps.Add(new DeviceProfile("tablet", "Tablet", "平板",
                                 768, 1024, 1024, 768, true, true, false));
        ps.Add(new DeviceProfile("tv", "TV", "电视",
                                 1920, 1080, 1920, 1080, true, false, false));
        ps.Add(new DeviceProfile("car", "Car", "车机",
                                 1280, 720, 1280, 720, true, false, false));
        ps.Add(new DeviceProfile("watch", "Wearable", "手表/穿戴",
                                 466, 466, 466, 466, true, false, true));
        return ps;
    }

    /// 画像数量（向导 chips 行排版用）。
    static int Count() { return DeviceProfile.All().Count; }

    /// 第 i 个画像；越界返回 null。
    static DeviceProfile At(int i) {
        List<DeviceProfile> ps = DeviceProfile.All();
        if (i < 0 || i >= ps.Count) { return null; }
        return ps[i];
    }

    /// 按 id 查画像；空串（桌面自由类别是缺省）或未知 id
    /// 返回 null，调用方据此回退到自由类别行为。
    static DeviceProfile ById(string deviceId) {
        if (deviceId == "") { return null; }
        List<DeviceProfile> ps = DeviceProfile.All();
        for (int i = 0; i < ps.Count; i = i + 1) {
            if (ps[i].id == deviceId) { return ps[i]; }
        }
        return null;
    }

    /// 按 id 查画像在 All() 中的下标；未找到返回 0（桌面）。
    static int IndexOfId(string deviceId) {
        List<DeviceProfile> ps = DeviceProfile.All();
        for (int i = 0; i < ps.Count; i = i + 1) {
            if (ps[i].id == deviceId) { return i; }
        }
        return 0;
    }
}
