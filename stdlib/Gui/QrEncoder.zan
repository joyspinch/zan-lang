using System;

namespace Gui;

/// 纠错级别（ISO/IEC 18004）。
enum QrEcl {
    L = 0,   // ~7% 恢复
    M = 1,   // ~15%
    Q = 2,   // ~25%
    H = 3,   // ~30%
}

/// 二维码编码结果：version/size/ecl + 边长 size 的模块矩阵（true = 深色，
/// 不含静区）。`Get(x,y)` 按行主序读模块。
class QrMatrix {
    public int version;
    public int size;
    public QrEcl ecl;
    public bool[] modules;

    public bool Get(int x, int y) { return modules[y * size + x]; }
}

/// 纯 Zan 的 QR Code（模型 1-40）编码器，ISO/IEC 18004：
///
///   - 输入按 Unicode 码点分成 Numeric / Alphanumeric / Byte(UTF-8) 游程
///     混合编码（中文等多字节字符原样按 UTF-8 字节进 Byte 段，与系统
///     码页无关）；短游程（<=8 字符）折回 Byte，省模式切换开销。
///   - 自动选最小版本；L/M/Q/H 四级纠错（GF(256) Reed-Solomon，分块交织）。
///   - 八个掩码全试、按标准罚分四条选优；格式信息 BCH(15,5)、
///     v>=7 版本信息 BCH(18,6)。
///   - 超容量抛 Exception（与 stdlib 异常约定一致）。
///
/// `Encode(text, ecl)` 返回 `QrMatrix`。渲染/导出在 Gui.Widget.QrCode。
class QrEncoder {

    // ---- 标准表 -----------------------------------------------------------

    // 每块纠错码字数 [level][version 1..40]（ISO 18004 Table 13-22）
    static int[] EC_PER_BLOCK_L = new int[]{
        -1, 7, 10, 15, 20, 26, 18, 20, 24, 30, 18, 20, 24, 26, 30, 22, 24, 28,
        30, 28, 28, 28, 28, 30, 30, 26, 28, 30, 30, 30, 30, 30, 30, 30, 30, 30,
        30, 30, 30, 30, 30};
    static int[] EC_PER_BLOCK_M = new int[]{
        -1, 10, 16, 26, 18, 24, 16, 18, 22, 22, 26, 30, 22, 22, 24, 24, 28, 28,
        26, 26, 26, 26, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28,
        28, 28, 28, 28, 28};
    static int[] EC_PER_BLOCK_Q = new int[]{
        -1, 13, 22, 18, 26, 18, 24, 18, 22, 20, 24, 28, 26, 24, 20, 30, 24, 28,
        28, 26, 30, 28, 30, 30, 30, 30, 28, 30, 30, 37, 34, 28, 30, 31, 24, 37,
        32, 29, 37, 34, 31};
    static int[] EC_PER_BLOCK_H = new int[]{
        -1, 17, 28, 22, 16, 22, 28, 26, 26, 24, 28, 24, 28, 22, 24, 24, 30, 28,
        28, 26, 28, 30, 24, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30,
        30, 30, 30, 30, 30};
    // 分块数 [level][version 1..40]
    static int[] NUM_BLOCKS_L = new int[]{
        -1, 1, 1, 1, 1, 1, 2, 2, 2, 2, 4, 4, 4, 4, 4, 6, 6, 6, 6, 7, 8, 8, 9,
        9, 10, 12, 12, 12, 13, 14, 15, 16, 17, 18, 19, 19, 20, 21, 22, 24, 25};
    static int[] NUM_BLOCKS_M = new int[]{
        -1, 1, 1, 1, 2, 2, 4, 4, 4, 5, 5, 5, 8, 9, 9, 10, 10, 11, 13, 14, 16,
        17, 17, 18, 20, 21, 23, 25, 26, 28, 29, 31, 33, 35, 37, 38, 40, 43, 45,
        47, 49};
    static int[] NUM_BLOCKS_Q = new int[]{
        -1, 1, 1, 2, 2, 4, 4, 6, 6, 8, 8, 8, 10, 12, 16, 12, 17, 16, 18, 21, 20,
        23, 23, 25, 27, 29, 34, 34, 35, 38, 40, 43, 45, 48, 51, 53, 56, 59, 62,
        65, 68};
    static int[] NUM_BLOCKS_H = new int[]{
        -1, 1, 1, 2, 4, 4, 4, 5, 6, 8, 8, 11, 11, 16, 16, 18, 16, 19, 21, 25,
        25, 25, 34, 30, 32, 35, 37, 40, 42, 45, 48, 51, 54, 57, 60, 63, 66, 70,
        74, 77, 81};

    static int EcPerBlock(QrEcl ecl, int ver) {
        if (ecl == QrEcl.L) { return EC_PER_BLOCK_L[ver]; }
        if (ecl == QrEcl.M) { return EC_PER_BLOCK_M[ver]; }
        if (ecl == QrEcl.Q) { return EC_PER_BLOCK_Q[ver]; }
        return EC_PER_BLOCK_H[ver];
    }

    static int NumBlocks(QrEcl ecl, int ver) {
        if (ecl == QrEcl.L) { return NUM_BLOCKS_L[ver]; }
        if (ecl == QrEcl.M) { return NUM_BLOCKS_M[ver]; }
        if (ecl == QrEcl.Q) { return NUM_BLOCKS_Q[ver]; }
        return NUM_BLOCKS_H[ver];
    }

    // 模式指示符
    static int MODE_NUMERIC = 1;
    static int MODE_ALNUM = 2;
    static int MODE_BYTE = 4;

    static string ALNUM_CHARS =
        "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ $%*+-./:";

    /// 校正图形的坐标轴序列（ISO/IEC 18004 Table E.1，v=1 返回空）。
    static int[] AlignPattern(int ver) {
        // ISO/IEC 18004 Table E.1（首元素 0 为占位，调用方取 pos[1..]）
        if (ver <= 1) { return new int[0]; }
        if (ver == 2) { return new int[]{0, 6, 18}; }
        if (ver == 3) { return new int[]{0, 6, 22}; }
        if (ver == 4) { return new int[]{0, 6, 26}; }
        if (ver == 5) { return new int[]{0, 6, 30}; }
        if (ver == 6) { return new int[]{0, 6, 34}; }
        if (ver == 7) { return new int[]{0, 6, 22, 38}; }
        if (ver == 8) { return new int[]{0, 6, 24, 42}; }
        if (ver == 9) { return new int[]{0, 6, 26, 46}; }
        if (ver == 10) { return new int[]{0, 6, 28, 50}; }
        if (ver == 11) { return new int[]{0, 6, 30, 54}; }
        if (ver == 12) { return new int[]{0, 6, 32, 58}; }
        if (ver == 13) { return new int[]{0, 6, 34, 62}; }
        if (ver == 14) { return new int[]{0, 6, 26, 46, 66}; }
        if (ver == 15) { return new int[]{0, 6, 26, 48, 70}; }
        if (ver == 16) { return new int[]{0, 6, 26, 50, 74}; }
        if (ver == 17) { return new int[]{0, 6, 30, 54, 78}; }
        if (ver == 18) { return new int[]{0, 6, 30, 56, 82}; }
        if (ver == 19) { return new int[]{0, 6, 30, 58, 86}; }
        if (ver == 20) { return new int[]{0, 6, 34, 62, 90}; }
        if (ver == 21) { return new int[]{0, 6, 28, 50, 72, 94}; }
        if (ver == 22) { return new int[]{0, 6, 26, 50, 74, 98}; }
        if (ver == 23) { return new int[]{0, 6, 30, 54, 78, 102}; }
        if (ver == 24) { return new int[]{0, 6, 28, 54, 80, 106}; }
        if (ver == 25) { return new int[]{0, 6, 32, 58, 84, 110}; }
        if (ver == 26) { return new int[]{0, 6, 30, 58, 86, 114}; }
        if (ver == 27) { return new int[]{0, 6, 34, 62, 90, 118}; }
        if (ver == 28) { return new int[]{0, 6, 26, 50, 74, 98, 122}; }
        if (ver == 29) { return new int[]{0, 6, 30, 54, 78, 102, 126}; }
        if (ver == 30) { return new int[]{0, 6, 26, 52, 78, 104, 130}; }
        if (ver == 31) { return new int[]{0, 6, 30, 56, 82, 108, 134}; }
        if (ver == 32) { return new int[]{0, 6, 34, 60, 86, 112, 138}; }
        if (ver == 33) { return new int[]{0, 6, 30, 58, 86, 114, 142}; }
        if (ver == 34) { return new int[]{0, 6, 34, 62, 90, 118, 146}; }
        if (ver == 35) { return new int[]{0, 6, 30, 54, 78, 102, 126, 150}; }
        if (ver == 36) { return new int[]{0, 6, 24, 50, 76, 102, 128, 154}; }
        if (ver == 37) { return new int[]{0, 6, 28, 54, 80, 106, 132, 158}; }
        if (ver == 38) { return new int[]{0, 6, 32, 58, 84, 110, 136, 162}; }
        if (ver == 39) { return new int[]{0, 6, 26, 54, 82, 110, 138, 166}; }
        return new int[]{0, 6, 30, 58, 86, 114, 142, 170};
    }

    /// 按版本/级别给出完整序列 [numBlocksG1, dataG1, numBlocksG2, dataG2]。
    /// 从官方 (总码字 - 纠错码字) 反推数据位。
    static int[] BlockPlan(int ver, QrEcl ecl) {
        int nBlocks = NumBlocks(ecl, ver);
        int ecLen = EcPerBlock(ecl, ver);
        // 数据码字总量：先算总码字数。
        int total = QrEncoder.TotalCodewords(ver);
        int data = total - nBlocks * ecLen;
        int small = data / nBlocks;
        int numLarge = data - small * nBlocks;
        if (numLarge > 0) {
            return new int[]{nBlocks - numLarge, small, numLarge, small + 1};
        }
        return new int[]{nBlocks, small, 0, 0};
    }

    /// 总码字数 = floor(rawDataModules/8)。
    static int TotalCodewords(int ver) {
        int rawModules = (16 * ver + 128) * ver + 64;
        int n = ver / 7 + 2;
        if (ver >= 2) {
            rawModules = rawModules - ((25 * n - 10) * n - 55);
        }
        if (ver >= 7) { rawModules = rawModules - 36; }
        return rawModules / 8;
    }

    // ---- GF(256)（本原多项式 0x11D），首次使用时构建 ----------------------

    static int[] gfExp = null;
    static int[] gfLog = null;

    static void EnsureGf() {
        if (gfExp != null) { return; }
        int[] e = new int[512];
        int[] l = new int[256];
        int v = 1;
        for (int i = 0; i < 255; i = i + 1) {
            e[i] = v;
            l[v] = i;
            v = v << 1;
            if (v >= 256) { v = v ^ 0x11D; }
        }
        for (int i = 255; i < 512; i = i + 1) { e[i] = e[i - 255]; }
        gfExp = e;
        gfLog = l;
    }

    static int GfMul(int a, int b) {
        if (a == 0 || b == 0) { return 0; }
        EnsureGf();
        return gfExp[gfLog[a] + gfLog[b]];
    }

    /// RS 生成多项式（Nayuki 式）：prod (x - a^i)，i = 0..deg-1。
    /// 返回长度 deg 的数组，result[deg-1] = 1（最高次系数），升幂索引，
    /// 最高次 x^deg 的系数隐式为 1。
    static int[] RsGenerator(int deg) {
        EnsureGf();
        int[] result = new int[deg];
        for (int i = 0; i < deg; i = i + 1) { result[i] = 0; }
        result[deg - 1] = 1;
        int root = 1;
        for (int i = 0; i < deg; i = i + 1) {
            for (int j = 0; j < deg; j = j + 1) {
                result[j] = GfMul(result[j], root);
                if (j + 1 < deg) { result[j] = result[j] ^ result[j + 1]; }
            }
            root = GfMul(root, 2);
        }
        return result;
    }

    /// data 对生成多项式 gen 取模（Nayuki 式），返回 deg 个纠错码字。
    static int[] RsRemainder(int[] data, int dataLen, int[] gen) {
        int deg = gen.Length;
        int[] result = new int[deg];
        for (int i = 0; i < deg; i = i + 1) { result[i] = 0; }
        for (int i = 0; i < dataLen; i = i + 1) {
            int factor = data[i] ^ result[0];
            for (int j = 1; j < deg; j = j + 1) { result[j - 1] = result[j]; }
            result[deg - 1] = 0;
            for (int j = 0; j < deg; j = j + 1) {
                result[j] = result[j] ^ GfMul(gen[j], factor);
            }
        }
        return result;
    }

    // ---- 分段模型 -----------------------------------------------------------

    /// 一个编码分段：mode 为指示符值，chars 是字符数（numeric/alnum 为
    /// 字符数，byte 为字节数），bits 是该段的数据位（不含模式/计数头）。
    class Segment {
        public int mode;
        public int chars;
        public int srcPos;
        public List<int> bits;
    }

    // ---- 公开入口 -----------------------------------------------------------

    /// 按级别编码文本，返回不含静区的模块矩阵。
    public static QrMatrix Encode(string text, QrEcl ecl) {
        List<QrEncoder.Segment> segs = QrEncoder.MakeSegments(text);
        int ver = QrEncoder.PickVersion(segs, ecl);
        if (ver < 0) {
            throw new Exception(
                "QrEncoder: content too long for QR version 40");
        }
        int totalCw = QrEncoder.TotalCodewords(ver);
        int[] cw = new int[totalCw];
        for (int i = 0; i < totalCw; i = i + 1) { cw[i] = 0; }
        int nDataCw = QrEncoder.WriteSegments(segs, ver, ecl, cw);
        return QrEncoder.BuildMatrix(ver, ecl, cw, nDataCw);
    }

    /// 级别名 -> 枚举（大小写均可）；未知返回 M（与 layui 默认一致）。
    public static QrEcl ParseEcl(string s) {
        if (s == null || s.Length != 1) { return QrEcl.M; }
        int b = s[0] & 255;
        if (b == 76 || b == 108) { return QrEcl.L; }   // L/l
        if (b == 81 || b == 113) { return QrEcl.Q; }   // Q/q
        if (b == 72 || b == 104) { return QrEcl.H; }   // H/h
        return QrEcl.M;
    }

    // ---- 文本 -> 分段 -----------------------------------------------------

    static bool IsNumeric(int b) { return b >= 48 && b <= 57; }

    static int AlnumValue(string ch) {
        for (int i = 0; i < 45; i = i + 1) {
            if (ALNUM_CHARS[i] == (int)(ch[0])) { return i; }
        }
        return -1;
    }

    static int SeqByteLen(int lead) {
        if (lead < 128) { return 1; }
        if (lead < 224) { return 2; }
        if (lead < 240) { return 3; }
        return 4;
    }

    /// 按码点游程切段：数字 / 字母数字 / 字节（UTF-8 原样），再把短的非
    /// Byte 游程折回 Byte（模式切换头 4+cc 位往往比直接写进 UTF-8 更贵）。
    static List<QrEncoder.Segment> MakeSegments(string text) {
        List<QrEncoder.Segment> outp = new List<QrEncoder.Segment>();
        if (text == null || text.Length == 0) {
            return outp;
        }
        List<QrEncoder.Segment> raw = new List<QrEncoder.Segment>();
        int len = text.Length;
        int i = 0;
        while (i < len) {
            int runStart = i;
            int mode = QrEncoder.ModeOfByte(text[i] & 255, text, i);
            i = i + QrEncoder.SeqByteLen(text[i] & 255);
            while (i < len) {
                int m2 = QrEncoder.ModeOfByte(text[i] & 255, text, i);
                if (m2 != mode) { break; }
                i = i + QrEncoder.SeqByteLen(text[i] & 255);
            }
            string run = text.Substring(runStart, i - runStart);
            QrEncoder.Segment s = new QrEncoder.Segment();
            s.bits = new List<int>();
            s.srcPos = runStart;
            if (mode == MODE_NUMERIC) {
                s.mode = MODE_NUMERIC;
                s.chars = run.Length;
                int j = 0;
                int n = run.Length;
                while (j < n) {
                    int take = n - j;
                    if (take > 3) { take = 3; }
                    int v = 0;
                    for (int k = 0; k < take; k = k + 1) {
                        v = v * 10 + (run[j + k] - 48);
                    }
                    int bits = 4;
                    if (take == 3) { bits = 10; }
                    if (take == 2) { bits = 7; }
                    for (int b2 = bits - 1; b2 >= 0; b2 = b2 - 1) {
                        s.bits.Add((v >> b2) & 1);
                    }
                    j = j + take;
                }
            } else if (mode == MODE_ALNUM) {
                s.mode = MODE_ALNUM;
                s.chars = run.Length;
                int j = 0;
                int n = run.Length;
                while (j + 2 <= n) {
                    int v = QrEncoder.AlnumValue(run.Substring(j, 1)) * 45
                        + QrEncoder.AlnumValue(run.Substring(j + 1, 1));
                    for (int b2 = 10; b2 >= 0; b2 = b2 - 1) {
                        s.bits.Add((v >> b2) & 1);
                    }
                    j = j + 2;
                }
                if (j < n) {
                    int v = QrEncoder.AlnumValue(run.Substring(j, 1));
                    for (int b2 = 5; b2 >= 0; b2 = b2 - 1) {
                        s.bits.Add((v >> b2) & 1);
                    }
                }
            } else {
                s.mode = MODE_BYTE;
                s.chars = run.Length;   // string 即 UTF-8 字节序列
                for (int j = 0; j < run.Length; j = j + 1) {
                    int v = run[j] & 255;
                    for (int b2 = 7; b2 >= 0; b2 = b2 - 1) {
                        s.bits.Add((v >> b2) & 1);
                    }
                }
            }
            raw.Add(s);
        }
        // 短游程折回 Byte + 相邻 Byte 段合并。
        for (int k = 0; k < raw.Count; k = k + 1) {
            QrEncoder.Segment s = raw[k];
            if (s.mode != MODE_BYTE && s.chars <= 8) {
                // 该游程全部在 ASCII（数字/字母数字表）内：直接按字节走。
                // 起点用构建时记录的 srcPos——合并会就地改 raw 段的
                // chars/bits，事后累加求起点就错了。
                s = QrEncoder.MakeByteRun(text.Substring(s.srcPos, s.chars));
            }
            bool merged = false;
            if (s.mode == MODE_BYTE && outp.Count > 0) {
                QrEncoder.Segment p = outp[outp.Count - 1];
                if (p.mode == MODE_BYTE) {
                    for (int j = 0; j < s.bits.Count; j = j + 1) {
                        p.bits.Add(s.bits[j]);
                    }
                    p.chars = p.chars + s.chars;
                    merged = true;
                }
            }
            if (!merged) { outp.Add(s); }
        }
        return outp;
    }

    static QrEncoder.Segment MakeByteRun(string run) {
        QrEncoder.Segment s = new QrEncoder.Segment();
        s.mode = MODE_BYTE;
        s.chars = run.Length;
        s.bits = new List<int>();
        for (int j = 0; j < run.Length; j = j + 1) {
            int v = run[j] & 255;
            for (int b = 7; b >= 0; b = b - 1) { s.bits.Add((v >> b) & 1); }
        }
        return s;
    }

    /// 字节 b（UTF-8 首字节）+ 文本上下文 -> 该码点的模式。
    static int ModeOfByte(int b, string text, int pos) {
        int n = QrEncoder.SeqByteLen(b);
        if (n == 1) {
            string ch = text.Substring(pos, 1);
            if (QrEncoder.IsNumeric(b)) { return MODE_NUMERIC; }
            if (QrEncoder.AlnumValue(ch) >= 0) { return MODE_ALNUM; }
        }
        return MODE_BYTE;
    }

    // ---- 版本选择 -----------------------------------------------------------

    static int CharCountBits(int mode, int ver) {
        int g = 0;
        if (ver <= 9) { g = 0; } else if (ver <= 26) { g = 1; } else { g = 2; }
        if (mode == MODE_NUMERIC) { return 10 + 2 * g; }
        if (mode == MODE_ALNUM) { return 9 + 2 * g; }
        if (g == 0) { return 8; }
        return 16;
    }

    static int DataCapacity(int ver, QrEcl ecl) {
        return QrEncoder.TotalCodewords(ver)
            - EcPerBlock(ecl, ver) * NumBlocks(ecl, ver);
    }

    /// 能容纳这些分段的最小版本，1..40；放不下返回 -1。
    static int PickVersion(List<QrEncoder.Segment> segs, QrEcl ecl) {
        for (int ver = 1; ver <= 40; ver = ver + 1) {
            int need = 0;
            for (int i = 0; i < segs.Count; i = i + 1) {
                QrEncoder.Segment s = segs[i];
                need = need + 4 + CharCountBits(s.mode, ver) + s.bits.Count;
            }
            if (need <= DataCapacity(ver, ecl) * 8) { return ver; }
        }
        return -1;
    }

    /// 分段位流 + 终止符 + 填充写入 cw（容量码字），返回实际数据码字数。
    static int WriteSegments(List<QrEncoder.Segment> segs, int ver, QrEcl ecl,
                             int[] cw) {
        List<int> bits = new List<int>();
        for (int i = 0; i < segs.Count; i = i + 1) {
            QrEncoder.Segment s = segs[i];
            QrEncoder.AppendVal(bits, s.mode, 4);
            QrEncoder.AppendVal(bits, s.chars, CharCountBits(s.mode, ver));
            for (int k = 0; k < s.bits.Count; k = k + 1) {
                bits.Add(s.bits[k]);
            }
        }
        int cap = DataCapacity(ver, ecl);
        int capBits = cap * 8;
        int term = capBits - bits.Count;
        if (term > 4) { term = 4; }
        if (term < 0) { term = 0; }
        for (int i = 0; i < term; i = i + 1) { bits.Add(0); }
        int nDataCw = (bits.Count + 7) / 8;
        for (int i = 0; i < bits.Count; i = i + 1) {
            if (bits[i] != 0) { cw[i / 8] = cw[i / 8] | (1 << (7 - i % 8)); }
        }
        for (int i = nDataCw; i < cap; i = i + 1) {
            cw[i] = (i - nDataCw) % 2 == 0 ? 0xEC : 0x11;
        }
        return nDataCw;
    }

    static void AppendVal(List<int> bits, int val, int n) {
        for (int i = n - 1; i >= 0; i = i - 1) { bits.Add((val >> i) & 1); }
    }

    // ---- 矩阵构建 ----------------------------------------------------------

    static void SetFn(bool[] fn, int size, int x, int y) {
        if (x < 0 || y < 0 || x >= size || y >= size) { return; }
        fn[y * size + x] = true;
    }
    static void SetDark(bool[] dark, bool[] fn, int size, int x, int y) {
        if (x < 0 || y < 0 || x >= size || y >= size) { return; }
        dark[y * size + x] = true;
        fn[y * size + x] = true;
    }

    /// 定位图形 + 分隔：以 (cx,cy) 为中心的 7x7 环，越界部分丢弃
    /// （Nayuki 的 dist!=2 && dist!=4 画法）。
    static void DrawFinder(bool[] dark, bool[] fn, int size, int cx, int cy) {
        for (int dy = -4; dy <= 4; dy = dy + 1) {
            for (int dx = -4; dx <= 4; dx = dx + 1) {
                int dist = dx;
                if (dy * dy > dx * dx) { dist = dy; }
                if (dist < 0) { dist = -dist; }
                int x = cx + dx;
                int y = cy + dy;
                QrEncoder.SetFn(fn, size, x, y);
                if (x < 0 || y < 0 || x >= size || y >= size) { continue; }
                if (dist != 2 && dist != 4) { dark[y * size + x] = true; }
            }
        }
    }

    static void DrawAlign(bool[] dark, bool[] fn, int size, int cx, int cy) {
        for (int dy = -2; dy <= 2; dy = dy + 1) {
            for (int dx = -2; dx <= 2; dx = dx + 1) {
                int dist = dx;
                if (dy * dy > dx * dx) { dist = dy; }
                if (dist < 0) { dist = -dist; }
                int x = cx + dx;
                int y = cy + dy;
                QrEncoder.SetFn(fn, size, x, y);
                if (x < 0 || y < 0 || x >= size || y >= size) { continue; }
                if (dist != 1) { dark[y * size + x] = true; }
            }
        }
    }

    static int BchVersion(int ver) {
        int d = ver << 12;
        // 消去比特 17..12 共 6 位（只循环 5 次会残留高位污染版本信息）
        for (int i = 0; i <= 5; i = i + 1) {
            if (((d >> (17 - i)) & 1) != 0) { d = d ^ (0x1F25 << (5 - i)); }
        }
        return (ver << 12) | d;
    }

    static QrMatrix BuildMatrix(int ver, QrEcl ecl, int[] cw, int nDataCw) {
        int size = ver * 4 + 17;
        bool[] dark = new bool[size * size];
        bool[] fn = new bool[size * size];   // function pattern（不可掩码）

        // 定位
        QrEncoder.DrawFinder(dark, fn, size, 3, 3);
        QrEncoder.DrawFinder(dark, fn, size, size - 4, 3);
        QrEncoder.DrawFinder(dark, fn, size, 3, size - 4);

        // 定时
        for (int i = 8; i <= size - 9; i = i + 1) {
            QrEncoder.SetFn(fn, size, i, 6);
            QrEncoder.SetFn(fn, size, 6, i);
            if (i % 2 == 0) {
                dark[6 * size + i] = true;
                dark[i * size + 6] = true;
            }
        }

        // 校正（跳过与定位图形重叠的三个角）
        int[] pos = QrEncoder.AlignPattern(ver);
        int n = pos.Length - 1;
        for (int r = 0; r < n; r = r + 1) {
            for (int c = 0; c < n; c = c + 1) {
                bool corner = (r == 0 && c == 0)
                    || (r == 0 && c == n - 1)
                    || (r == n - 1 && c == 0);
                if (!corner) {
                    QrEncoder.DrawAlign(dark, fn, size, pos[c + 1], pos[r + 1]);
                }
            }
        }

        // 版本信息（v >= 7）：左上/右上 6x3 条带
        if (ver >= 7) {
            int vinfo = QrEncoder.BchVersion(ver);
            for (int i = 0; i < 18; i = i + 1) {
                int bit = (vinfo >> i) & 1;
                int a = i / 3;
                int b = i % 3;
                QrEncoder.SetFn(fn, size, a, size - 11 + b);
                QrEncoder.SetFn(fn, size, size - 11 + b, a);
                if (bit != 0) {
                    dark[(size - 11 + b) * size + a] = true;
                    dark[a * size + (size - 11 + b)] = true;
                }
            }
        }

        // 格式信息暂存区（含固定深色模块）
        for (int i = 0; i < 9; i = i + 1) {
            if (i != 6) {
                QrEncoder.SetFn(fn, size, 8, i);
                QrEncoder.SetFn(fn, size, i, 8);
            }
        }
        for (int i = 0; i < 8; i = i + 1) {
            QrEncoder.SetFn(fn, size, size - 1 - i, 8);
            if (i != 6) { QrEncoder.SetFn(fn, size, 8, size - 1 - i); }
        }
        QrEncoder.SetFn(fn, size, 8, size - 8);
        dark[8 * size + (size - 8)] = true;   // fixed dark module

        // 纠错分块 + 交织。ISO 分块 = numBlocks 块（group1 在前）；交织序：
        // 第 t 轮依次取每块的第 t 个码字（不足跳过），数据轮完再纠错轮。
        int[] plan = QrEncoder.BlockPlan(ver, ecl);
        int k1 = plan[0]; int d1 = plan[1]; int k2 = plan[2]; int d2 = plan[3];
        int numBlocks = k1 + k2;
        int ecLen = QrEncoder.EcPerBlock(ecl, ver);
        int dataTotal = QrEncoder.DataCapacity(ver, ecl);
        int[] lens = new int[numBlocks];
        List<int[]> chunks = new List<int[]>();
        List<int[]> ecs = new List<int[]>();
        int p = 0;
        for (int b = 0; b < numBlocks; b = b + 1) {
            lens[b] = b < k1 ? d1 : d2;
            int[] chunk = new int[lens[b]];
            for (int t = 0; t < lens[b]; t = t + 1) {
                chunk[t] = cw[p];
                p = p + 1;
            }
            int[] gen = QrEncoder.RsGenerator(ecLen);
            chunks.Add(chunk);
            ecs.Add(QrEncoder.RsRemainder(chunk, lens[b], gen));
        }
        int[] blockData = new int[dataTotal + numBlocks * ecLen];
        int w = 0;
        int maxLen = d1 > d2 ? d1 : d2;
        for (int t = 0; t < maxLen; t = t + 1) {
            for (int b = 0; b < numBlocks; b = b + 1) {
                if (t < lens[b]) {
                    blockData[w] = chunks[b][t];
                    w = w + 1;
                }
            }
        }
        for (int t = 0; t < ecLen; t = t + 1) {
            for (int b = 0; b < numBlocks; b = b + 1) {
                blockData[w] = ecs[b][t];
                w = w + 1;
            }
        }
        // 蛇形放置：码字 bit -> 模块（跳过 fn，未写到则留 0）
        bool[] finalDark = new bool[size * size];
        for (int i = 0; i < size * size; i = i + 1) {
            finalDark[i] = dark[i];
        }
        int bit = 0;
        int totalCw = blockData.Length;
        for (int right = size - 1; right >= 1; right = right - 2) {
            int r2 = right;
            if (right <= 6) { r2 = right - 1; }
            for (int vert = 0; vert < size; vert = vert + 1) {
                for (int z = 0; z < 2; z = z + 1) {
                    int j = r2 - z;
                    bool upwards = (r2 & 2) == 0;
                    if (j < 6) { upwards = !upwards; }
                    int y = upwards ? size - 1 - vert : vert;
                    int idx = y * size + j;
                    if (!fn[idx] && bit < totalCw * 8) {
                        int v = (blockData[bit / 8] >> (7 - bit % 8)) & 1;
                        finalDark[idx] = v != 0;
                        bit = bit + 1;
                    }
                }
            }
        }
        // 选掩码
        int bestMask = 0;
        int bestPenalty = 0x7FFFFFFF;
        bool[] best = null;
        for (int m = 0; m < 8; m = m + 1) {
            bool[] cand = QrEncoder.ApplyMask(finalDark, fn, size, m, ecl);
            int pen = QrEncoder.Penalty(cand, size);
            if (pen < bestPenalty) {
                bestPenalty = pen;
                bestMask = m;
                best = cand;
            }
        }
        QrMatrix mx = new QrMatrix();
        mx.version = ver;
        mx.size = size;
        mx.ecl = ecl;
        mx.modules = best;
        return mx;
    }

    /// 掩码 + 格式信息写入，返回成品矩阵（new 数组，深拷贝）。
    static bool[] ApplyMask(bool[] dark, bool[] fn, int size, int mask,
                            QrEcl ecl) {
        bool[] outp = new bool[size * size];
        for (int i = 0; i < size * size; i = i + 1) { outp[i] = dark[i]; }
        for (int y = 0; y < size; y = y + 1) {
            for (int x = 0; x < size; x = x + 1) {
                int idx = y * size + x;
                if (!fn[idx] && QrEncoder.MaskBit(mask, x, y)) {
                    outp[idx] = !outp[idx];
                }
            }
        }
        int eclBits = 0;
        if (ecl == QrEcl.L) { eclBits = 1; }
        else if (ecl == QrEcl.M) { eclBits = 0; }
        else if (ecl == QrEcl.Q) { eclBits = 3; }
        else { eclBits = 2; }
        // BCH(15,5) 系统码，生成多项式 0x537，再 XOR 掩码 0x5412
        int data = (eclBits << 3) | mask;
        int r = data << 10;
        for (int i = 4; i >= 0; i = i - 1) {
            if (((r >> (i + 10)) & 1) != 0) { r = r ^ (0x537 << i); }
        }
        int bits = ((data << 10) | r) ^ 0x5412;
        // 第一拷贝（左上）：bit i -> (col 8, row i)，i=6 跳过定时行，
        // bit 7 -> (8,8)
        for (int i = 0; i <= 5; i = i + 1) {
            outp[i * size + 8] = ((bits >> i) & 1) != 0;
        }
        outp[7 * size + 8] = ((bits >> 6) & 1) != 0;
        outp[8 * size + 8] = ((bits >> 7) & 1) != 0;
        outp[8 * size + 7] = ((bits >> 8) & 1) != 0;
        for (int i = 9; i < 15; i = i + 1) {
            outp[8 * size + (14 - i)] = ((bits >> i) & 1) != 0;
        }
        // 第二拷贝（右上 + 左下）
        for (int i = 0; i < 8; i = i + 1) {
            outp[8 * size + (size - 1 - i)] = ((bits >> i) & 1) != 0;
        }
        for (int i = 8; i < 15; i = i + 1) {
            outp[(size - 15 + i) * size + 8] = ((bits >> i) & 1) != 0;
        }
        outp[8 * size + (size - 8)] = true;   // fixed dark
        return outp;
    }

    static bool MaskBit(int m, int x, int y) {
        if (m == 0) { return (x + y) % 2 == 0; }
        if (m == 1) { return y % 2 == 0; }
        if (m == 2) { return x % 3 == 0; }
        if (m == 3) { return (x + y) % 3 == 0; }
        if (m == 4) { return (x / 3 + y / 2) % 2 == 0; }
        if (m == 5) { return ((x * y) % 2 + (x * y) % 3) == 0; }
        if (m == 6) { return (((x * y) % 2 + (x * y) % 3) % 2) == 0; }
        return (((x + y) % 2 + (x * y) % 3) % 2) == 0;
    }

    // ---- 掩码罚分（ISO 18004 Table 24，与 Nayuki 一致） --------------------

    static int Penalty(bool[] m, int size) {
        int result = 0;
        // 规则 1：行/列同色游程 >=5
        for (int y = 0; y < size; y = y + 1) {
            result = result + QrEncoder.RunPenaltyLine(m, size, y, true);
        }
        for (int x = 0; x < size; x = x + 1) {
            result = result + QrEncoder.RunPenaltyLine(m, size, x, false);
        }
        // 规则 2：2x2 同色块
        for (int y = 0; y < size - 1; y = y + 1) {
            for (int x = 0; x < size - 1; x = x + 1) {
                bool c = m[y * size + x];
                if (c == m[y * size + x + 1] && c == m[(y + 1) * size + x]
                    && c == m[(y + 1) * size + x + 1]) { result = result + 3; }
            }
        }
        // 规则 3：行/列中出现的 0000 + 1011101（11 格窗口；模式对称，
        // 反向窗口必然也是该形状，无需重复统计）
        for (int y = 0; y < size; y = y + 1) {
            for (int x = 0; x + 11 <= size; x = x + 1) {
                if (QrEncoder.Pattern11(m, size, x, y, true)) {
                    result = result + 40;
                }
            }
        }
        for (int x = 0; x < size; x = x + 1) {
            for (int y = 0; y + 11 <= size; y = y + 1) {
                if (QrEncoder.Pattern11(m, size, x, y, false)) {
                    result = result + 40;
                }
            }
        }
        // 规则 4：深色比例
        int darkCount = 0;
        for (int i = 0; i < size * size; i = i + 1) {
            if (m[i]) { darkCount = darkCount + 1; }
        }
        int total = size * size;
        int percent = darkCount * 100 / total;
        int k = (Math.Abs(percent - 50) + 4) / 5;
        result = result + k * 10;
        return result;
    }

    static int RunPenaltyLine(bool[] m, int size, int line, bool horizontal) {
        int pen = 0;
        int runColor = -1;
        int runLen = 0;
        for (int i = 0; i < size; i = i + 1) {
            int idx = horizontal ? line * size + i : i * size + line;
            int c = m[idx] ? 1 : 0;
            if (c != runColor) {
                if (runLen >= 5) { pen = pen + 3 + (runLen - 5); }
                runColor = c;
                runLen = 1;
            } else {
                runLen = runLen + 1;
            }
        }
        if (runLen >= 5) { pen = pen + 3 + (runLen - 5); }
        return pen;
    }

    /// 11 格窗口 == 0000 1011101（从 (x,y) 沿 horizontal 方向）。
    static bool Pattern11(bool[] m, int size, int x, int y, bool horizontal) {
        for (int k = 0; k < 11; k = k + 1) {
            int idx = horizontal ? y * size + x + k : (y + k) * size + x;
            bool want = k == 4 || k == 6 || k == 7 || k == 8 || k == 10;
            if (m[idx] != want) { return false; }
        }
        return true;
    }
}
