using System;
using System.Json;

namespace Gui;

/// CSS 声明级联，应用于已解析的 StyleBox（
/// 皮肤路径，每个控件通过 Style 使用）或 retained-mode Control
/// （在 UiDoc 构建期间）。
///
/// 样式表是 selector -> declaration-block 映射。选择器保留 CSS
/// 拼写（`button`、`.primary`、`button.primary`、`#save`），并可能带有
/// `:state` 后缀（`:hover`、`:active`、`:focus`、`:disabled`、`:selected`、
/// `:checked`）。特异性按 type -> class -> type.class -> id 递增，状态
/// 规则叠加在基础外观之上，所以 `button:hover` 只需注明
/// 变化的部分。
///
/// 值是真正的 CSS：颜色用 `#rgb / #rrggbb / #aarrggbb / rgb() / rgba() /
/// hsl() / hsla()` 或命名颜色，长度带或不带 `px`，时长用
/// `120ms / 0.2s`、`linear-gradient(...)`、`box-shadow: x y blur color`、
/// `backdrop-filter: blur(20px)`、`transform: translate/scale/rotate`、flex
/// 布局、排版和 `animation: <name> <dur> <easing>`。
class StyleSheet {
    JsonValue rules;
    /// 解析后保留的 `:root` 自定义属性（`--name` -> 值），这样
    /// 皮肤除了控件规则外，也能供给语义化 Theme token。
    JsonValue vars;
    /// 下次 Apply 在普通选择器之外还要解析的伪状态
    /// （“hover”、“active”、“focus”、“disabled”；“” = 仅基础外观）。
    string state;

    // ---- 选择器索引（级联）----
    // 选择器一次性解析为各组成部分，解析就是真正的匹配
    // （“这条规则是否适用于这个控件？”），而不是查少数几个
    // 解析器认为值得尝试的选择器拼写。这正是
    // 复合选择器（`button.ghost.primary:hover`）能生效，以及
    // 组件默认外观可以放在样式表而非代码中的原因。
    List<string> selText;
    List<string> selType;
    List<string> selClasses;   // 空格分隔，规则未命名任何类别时为“”。
    /// 规则要求的第一个类名（无类要求时为“”）。把颜色与状态
    /// 下沉进 CSS 后，`button` 那一桶里绝大多数规则都带类
    /// （`button.ghost.primary:hover` 之类），先用这一个字符串比较筛掉，
    /// 就不必为每条规则再切分一次类名串。
    List<string> selClass0;
    /// `[class*="frag"]` 要求的 class 属性子串（无该要求时为“”）。
    List<string> selContains;
    List<string> selId;
    List<string> selPart;
    List<string> selState;
    /// 选择器要求的状态位（多个伪类取与）；引擎不认识其中
    /// 任何一个伪类时为 -1（该规则永不匹配）。
    List<int> selStateMask;
    List<int> selSpec;
    int indexedCount;
    /// 每条规则的声明块，索引与上面的选择器表对齐：匹配后直接取，
    /// 不再按选择器文本回查 rules（一次首帧解析要按名字查上百次）。
    List<JsonValue> selBlock;
    /// 按类型名分桶的规则下标（升序，因此与 anyType 归并后仍是级联顺序）。
    /// 一个控件只需看自己类型那一桶加上无类型的那些规则，
    /// 而不是每次解析都扫全表——冷解析（首帧、换肤）的主要成本在此。
    Dict<string, List<int>> byType;
    /// 没有类型选择器的规则下标（`.primary`、`#save`、`::option`）。
    List<int> anyType;

    StyleSheet() {
        this.rules = JsonValue.NewObject();
        this.vars = JsonValue.NewObject();
        this.state = "";
        this.indexedCount = 0 - 1;
    }

    /// 解析以 CSS 文本编写的样式表（见 Css）。皮肤以 `.css` 文件发布，
    /// 以便在不重新构建应用的情况下编写和替换。
    static StyleSheet FromCss(string src) {
        return Css.Parse(src);
    }

    /// 将另一张表的规则和自定义属性叠加到当前表上
    /// （另一张表优先），这样应用样式表可以重新应用
    /// 到当前激活的皮肤之上，而不会被其替换。
    void MergeSheet(StyleSheet other) {
        if (other == null) { return; }
        for (int i = 0; i < other.rules.Count(); i = i + 1) {
            Css.MergeInto(this, other.rules.KeyAt(i), other.rules.ValAt(i));
        }
        for (int j = 0; j < other.vars.Count(); j = j + 1) {
            vars.Set(other.vars.KeyAt(j), other.vars.ValAt(j));
        }
    }

    /// 从 JSON 源字符串解析样式表。格式错误 / 非对象的
    /// 文档会产生空样式表，因此坏文件永远不会中断加载。
    static StyleSheet FromJson(string src) {
        StyleSheet s = new StyleSheet();
        JsonValue v = JsonValue.ParseLenient(src);
        if (v != null && v.IsObject()) { s.rules = v; }
        return s;
    }

    /// 样式表完全没有规则时为 true（应用未加载皮肤）。
    bool IsEmpty() {
        return rules == null || rules.Count() == 0;
    }

    /// `:root` 自定义属性的值（`Var("--accent")`），不存在时返回“”。
    string Var(string name) {
        if (vars == null) { return ""; }
        JsonValue v = vars.Get(name);
        if (v == null) { return ""; }
        return v.AsString("");
    }

    /// 单个选择器的声明块（选择器不存在时为 null）。
    JsonValue Block(string selector) {
        if (rules == null) { return null; }
        JsonValue block = rules.Get(selector);
        if (block == null || !block.IsObject()) { return null; }
        return block;
    }

    // ---- StyleBox 应用（皮肤路径）----

    /// 将一个选择器的声明叠加到已解析的样式盒上。未知
    /// 属性在此忽略（它们是控件属性，由
    /// ApplySelector 处理）。
    void ApplyBox(StyleBox b, string selector) {
        JsonValue block = this.Block(selector);
        if (block == null) { return; }
        for (int i = 0; i < block.Count(); i = i + 1) {
            string k = block.KeyAt(i);
            if (k == "__zan_prescaled") { continue; }
            JsonValue v = block.ValAt(i);
            StyleSheet.DeclSource(b, k, StyleSheet.ValStr(v),
                                  StyleSheet.IsPrescaled(block, k));
        }
    }

    // ---- 级联 -----

    /// 将匹配控件的每条规则应用到 `b`，最弱的匹配优先，
    /// 因此最具体的声明胜出。`classes` 是控件的 class
    /// 列表，`part` 选择 `type::part` 规则（“”表示控件本身），
    /// `stateBits` 是 Style.S* 掩码。
    ///
    /// 排序以状态为主：所有无状态规则先应用（按 CSS
    /// 特异性：type < class < class chain < id），然后是每个
    /// 活动状态的规则，因此无论作者把 `:hover` 放在文件
    /// 何处，它都只需注明变化的部分。
    void ApplyMatch(StyleBox b, string type, string cls, string id, string part,
                    int stateBits) {
        this.Index();
        List<string> want = Style.Classes(cls);
        List<int> typed = null;
        if (type != "") { this.byType.TryGetValue(type, out typed); }
        int a = 0;
        int c = 0;
        bool more = true;
        while (more) {
            int ia = 0 - 1;
            int ic = 0 - 1;
            if (typed != null && a < typed.Count) { ia = typed[a]; }
            if (c < anyType.Count) { ic = anyType[c]; }
            if (ia < 0 && ic < 0) {
                more = false;
            } else {
                int i;
                if (ic < 0 || (ia >= 0 && ia < ic)) { i = ia; a = a + 1; }
                else { i = ic; c = c + 1; }
                if (this.Matches(i, type, want, id, part, stateBits, cls)) {
                    this.ApplyDecls(b, selBlock[i]);
                }
            }
        }
    }

    /// 把已经取到的声明块叠加到样式盒上。
    void ApplyDecls(StyleBox b, JsonValue block) {
        if (block == null) { return; }
        for (int i = 0; i < block.Count(); i = i + 1) {
            string k = block.KeyAt(i);
            if (k == "__zan_prescaled") { continue; }
            StyleSheet.DeclSource(b, k, StyleSheet.ValStr(block.ValAt(i)),
                                  StyleSheet.IsPrescaled(block, k));
        }
    }

    /// 规则 `i` 是否选中给定的控件/部件/状态。`cls` 是 class
    /// 属性原文，供 `[class*="frag"]` 做子串匹配。
    bool Matches(int i, string type, List<string> classes, string id,
                 string part, int stateBits, string cls) {
        if (selPart[i] != part) { return false; }
        if (selType[i] != "" && selType[i] != type) { return false; }
        if (selId[i] != "" && (id == "" || selId[i] != id)) { return false; }
        int mask = selStateMask[i];
        if (mask < 0) { return false; }
        if ((stateBits & mask) != mask) { return false; }
        string contains = selContains[i];
        if (contains != ""
            && (cls == "" || StyleSheet.IndexOf(cls, contains) < 0)) {
            return false;
        }
        if (selClasses[i] == "") { return true; }
        if (!StyleSheet.Holds(classes, selClass0[i])) { return false; }
        List<string> need = Style.Classes(selClasses[i]);
        for (int k = 0; k < need.Count; k = k + 1) {
            if (!StyleSheet.Holds(classes, need[k])) { return false; }
        }
        return true;
    }

    /// 一组伪类名对应的状态位掩码（含未知伪类时为 -1）。
    static int StateMask(string state) {
        if (state == "") { return 0; }
        List<string> names = Style.Classes(state);
        int mask = 0;
        for (int i = 0; i < names.Count; i = i + 1) {
            int bit = Style.StateBit(names[i]);
            if (bit == 0) { return 0 - 1; }
            mask = mask | bit;
        }
        return mask;
    }

    /// 空格分隔类名串里的第一个名字（“”表示没有类要求）。
    static string FirstClass(string classes) {
        int sp = StyleSheet.IndexOf(classes, " ");
        if (sp < 0) { return classes; }
        return classes.Substring(0, sp);
    }

    static bool Holds(List<string> list, string name) {
        for (int i = 0; i < list.Count; i = i + 1) {
            if (list[i] == name) { return true; }
        }
        return false;
    }

    /// 一次性解析每个选择器，并按权重保持规则有序，因此
    /// 匹配就是对已排序表的扫描。
    void Index() {
        if (rules == null) { return; }
        if (indexedCount == rules.Count()) { return; }
        selText = new List<string>();
        selType = new List<string>();
        selClasses = new List<string>();
        selId = new List<string>();
        selPart = new List<string>();
        selState = new List<string>();
        selStateMask = new List<int>();
        selClass0 = new List<string>();
        selContains = new List<string>();
        selSpec = new List<int>();
        int i = 0;
        while (i < rules.Count()) {
            string sel = rules.KeyAt(i);
            i = i + 1;
            Selector p = Selector.Parse(sel);
            if (p == null) { continue; }
            int spec = p.Specificity();
            // 在权重相同的规则中插入到最后（保持文档顺序）。
            int at = selSpec.Count;
            while (at > 0 && selSpec[at - 1] > spec) { at = at - 1; }
            selText.Insert(at, sel);
            selType.Insert(at, p.type);
            selClasses.Insert(at, p.classes);
            selId.Insert(at, p.id);
            selPart.Insert(at, p.part);
            selState.Insert(at, p.state);
            selStateMask.Insert(at, StyleSheet.StateMask(p.state));
            selClass0.Insert(at, StyleSheet.FirstClass(p.classes));
            selContains.Insert(at, p.clsContains);
            selSpec.Insert(at, spec);
        }
        // 分桶要等排序完成再做：上面的 Insert 会挪动下标。
        this.selBlock = new List<JsonValue>();
        this.byType = new Dict<string, List<int>>();
        this.anyType = new List<int>();
        for (int k = 0; k < selText.Count; k = k + 1) {
            selBlock.Add(this.Block(selText[k]));
            string ty = selType[k];
            if (ty == "") {
                anyType.Add(k);
            } else {
                List<int> bucket;
                if (!byType.TryGetValue(ty, out bucket)) {
                    bucket = new List<int>();
                    byType.Add(ty, bucket);
                }
                bucket.Add(k);
            }
        }
        indexedCount = rules.Count();
    }

    /// 声明值的文本形式（数字转成字符串，因此 JSON 表中的 `radius: 8`
    /// 行为与 CSS 中的 `radius: 8px` 一致）。
    static string ValStr(JsonValue v) {
        if (v == null) { return ""; }
        if (v.IsNumber()) { return Convert.ToString(v.AsInt(0)); }
        return v.AsString("");
    }

    static bool IsPrescaled(JsonValue block, string key) {
        if (block == null) { return false; }
        JsonValue source = block.Get("__zan_prescaled");
        if (source == null || !source.IsObject()) { return false; }
        JsonValue value = source.Get(key);
        return value != null && value.AsBool(false);
    }

    /// 将一条 CSS 声明应用到样式盒。当该
    /// 属性不是引擎理解的视觉/布局属性时返回 false。
    static bool Decl(StyleBox b, string key, string val) {
        string k = StyleSheet.Lower(StyleSheet.Trim(key));
        string v = StyleSheet.Trim(val);
        if (k == "" || v == "") { return false; }
        if (StyleSheet.DeclFill(b, k, v)) { return true; }
        if (StyleSheet.DeclText(b, k, v)) { return true; }
        if (StyleSheet.DeclBorderBox(b, k, v)) { return true; }
        if (StyleSheet.DeclBoxMetrics(b, k, v)) { return true; }
        if (StyleSheet.DeclLayout(b, k, v)) { return true; }
        if (StyleSheet.DeclMotion(b, k, v)) { return true; }
        return false;
    }

    static bool DeclSource(StyleBox b, string key, string val, bool prescaled) {
        bool ok = StyleSheet.Decl(b, key, val);
        if (!ok) { return false; }
        int source = StyleSheet.SourceFor(key);
        if (source != 0) { b.SetPrescaled(source, prescaled); }
        return true;
    }

    static int SourceFor(string key) {
        string k = StyleSheet.Lower(StyleSheet.Trim(key));
        if (k == "font-size" || k == "font") {
            return StyleBox.SourceFont();
        }
        if (k == "width" || k == "min-width" || k == "max-width"
                || k == "flex-basis") {
            return StyleBox.SourceWidth();
        }
        if (k == "height" || k == "min-height" || k == "max-height") {
            return StyleBox.SourceHeight();
        }
        if (k == "gap" || k == "row-gap" || k == "column-gap") {
            return StyleBox.SourceGap();
        }
        if (k == "radius" || k == "border-radius"
                || k == "border-top-left-radius"
                || k == "border-top-right-radius"
                || k == "border-bottom-right-radius"
                || k == "border-bottom-left-radius") {
            return StyleBox.SourceRadius();
        }
        if (k == "padding" || k == "pad" || k == "padding-left"
                || k == "padding-top" || k == "padding-right"
                || k == "padding-bottom" || k == "margin"
                || k == "margin-left" || k == "margin-top"
                || k == "margin-right" || k == "margin-bottom") {
            return StyleBox.SourcePadding();
        }
        return 0;
    }

    /// fill：背景 / 透明度 / 模糊滤镜。
    static bool DeclFill(StyleBox b, string k, string v) {
        if (k == "background" || k == "background-color" || k == "bg") {
            StyleSheet.DeclBackground(b, v);
            return true;
        }
        if (k == "background-image") {
            StyleSheet.DeclBackground(b, v);
            return true;
        }
        if (k == "opacity") { b.opacity = StyleSheet.Perm(v); return true; }
        if (k == "backdrop-filter" || k == "filter") {
            b.blur = StyleSheet.BlurArg(v);
            return true;
        }
        return false;
    }

    /// text：颜色 / 字体 / 对齐 / 变换 / 换行。
    static bool DeclText(StyleBox b, string k, string v) {
        if (k == "color") { b.fg = StyleSheet.ParseColor(v); return true; }
        if (k == "accent-color") { b.accent = StyleSheet.ParseColor(v); return true; }
        if (k == "font-size" || k == "font") { b.fontPx = StyleSheet.Num(v); return true; }
        if (k == "font-weight") { b.fontWeight = StyleSheet.Weight(v); return true; }
        if (k == "line-height") { b.lineHeight = StyleSheet.Num(v); return true; }
        if (k == "letter-spacing") { b.letterSpacing = StyleSheet.Num(v); return true; }
        if (k == "text-align") {
            b.align = 0;
            if (v == "center") { b.align = 1; }
            if (v == "right" || v == "end") { b.align = 2; }
            return true;
        }
        if (k == "vertical-align") {
            b.valign = 0;
            if (v == "middle" || v == "center") { b.valign = 1; }
            if (v == "bottom") { b.valign = 2; }
            return true;
        }
        if (k == "text-transform") {
            b.textCase = 0;
            if (v == "uppercase") { b.textCase = 1; }
            if (v == "lowercase") { b.textCase = 2; }
            return true;
        }
        if (k == "text-overflow") {
            b.ellipsis = 0;
            if (v == "ellipsis") { b.ellipsis = 1; }
            return true;
        }
        if (k == "white-space") {
            b.nowrap = 0;
            if (v == "nowrap" || v == "pre") { b.nowrap = 1; }
            return true;
        }
        return false;
    }

    /// border / 圆角 / 阴影。
    static bool DeclBorderBox(StyleBox b, string k, string v) {
        if (k == "border") { StyleSheet.DeclBorder(b, v, 0); return true; }
        if (k == "border-top") { StyleSheet.DeclBorder(b, v, 1); return true; }
        if (k == "border-right") { StyleSheet.DeclBorder(b, v, 2); return true; }
        if (k == "border-bottom") { StyleSheet.DeclBorder(b, v, 3); return true; }
        if (k == "border-left") { StyleSheet.DeclBorder(b, v, 4); return true; }
        if (k == "border-width") { b.borderW = StyleSheet.Num(v); return true; }
        if (k == "border-color") { b.borderColor = StyleSheet.ParseColor(v); return true; }
        if (k == "border-top-width") { b.borderTopW = StyleSheet.Num(v); return true; }
        if (k == "border-right-width") { b.borderRightW = StyleSheet.Num(v); return true; }
        if (k == "border-bottom-width") { b.borderBottomW = StyleSheet.Num(v); return true; }
        if (k == "border-left-width") { b.borderLeftW = StyleSheet.Num(v); return true; }
        if (k == "border-top-color") { b.borderTopColor = StyleSheet.ParseColor(v); return true; }
        if (k == "border-right-color") { b.borderRightColor = StyleSheet.ParseColor(v); return true; }
        if (k == "border-bottom-color") { b.borderBottomColor = StyleSheet.ParseColor(v); return true; }
        if (k == "border-left-color") { b.borderLeftColor = StyleSheet.ParseColor(v); return true; }
        if (k == "border-radius" || k == "radius") {
            StyleSheet.DeclRadius(b, v);
            return true;
        }
        if (k == "border-top-left-radius") {
            StyleSheet.CornerRadius(b, 0, StyleSheet.Num(v));
            return true;
        }
        if (k == "border-top-right-radius") {
            StyleSheet.CornerRadius(b, 1, StyleSheet.Num(v));
            return true;
        }
        if (k == "border-bottom-right-radius") {
            StyleSheet.CornerRadius(b, 2, StyleSheet.Num(v));
            return true;
        }
        if (k == "border-bottom-left-radius") {
            StyleSheet.CornerRadius(b, 3, StyleSheet.Num(v));
            return true;
        }
        if (k == "box-shadow" || k == "shadow") { StyleSheet.DeclShadow(b, v); return true; }
        if (k == "border-style") {
            b.borderStyle = 0;
            if (v == "dashed" || v == "dotted") { b.borderStyle = 1; }
            return true;
        }
        // 两种没有自有 CSS 拼写的装饰：拟物化
        // 凸起/内陷边对和跟随光标的 sheen 光泽。
        if (k == "emboss" || k == "-zan-emboss") {
            b.emboss = 0;
            if (v == "raised") { b.emboss = 1; }
            if (v == "inset") { b.emboss = 2; }
            return true;
        }
        if (k == "specular" || k == "-zan-specular") {
            b.specular = 0;
            if (v != "none" && v != "0") { b.specular = 1; }
            return true;
        }
        if (k == "sheen" || k == "-zan-sheen") {
            StyleSheet.DeclSheen(b, v);
            return true;
        }
        return false;
    }

    /// 盒子度量：padding / margin / size / gap。
    static bool DeclBoxMetrics(StyleBox b, string k, string v) {
        if (k == "padding" || k == "pad") { StyleSheet.DeclSides(b, v, 0); return true; }
        if (k == "padding-left") { b.padL = StyleSheet.Num(v); return true; }
        if (k == "padding-top") { b.padT = StyleSheet.Num(v); return true; }
        if (k == "padding-right") { b.padR = StyleSheet.Num(v); return true; }
        if (k == "padding-bottom") { b.padB = StyleSheet.Num(v); return true; }
        if (k == "margin") { StyleSheet.DeclSides(b, v, 1); return true; }
        if (k == "margin-left") { b.marL = StyleSheet.Num(v); return true; }
        if (k == "margin-top") { b.marT = StyleSheet.Num(v); return true; }
        if (k == "margin-right") { b.marR = StyleSheet.Num(v); return true; }
        if (k == "margin-bottom") { b.marB = StyleSheet.Num(v); return true; }
        if (k == "width") { StyleSheet.DeclMetric(b, 0, v); return true; }
        if (k == "height") { StyleSheet.DeclMetric(b, 1, v); return true; }
        if (k == "min-width") { StyleSheet.DeclMetric(b, 2, v); return true; }
        if (k == "min-height") { StyleSheet.DeclMetric(b, 3, v); return true; }
        if (k == "max-width") { StyleSheet.DeclMetric(b, 4, v); return true; }
        if (k == "max-height") { StyleSheet.DeclMetric(b, 5, v); return true; }
        // `gap: <both>` 或 `gap: <row> <column>`（CSS 简写：第一个值是
        // 行距）。两个值时同时置上两根轴，`row-gap`/`column-gap`
        // 仍可在其后单独覆盖。
        if (k == "gap") {
            List<string> g = StyleSheet.Tokens(v);
            if (g.Count == 0) { return true; }
            b.gap = StyleSheet.Num(g[0]);
            if (g.Count >= 2) {
                b.rowGap = StyleSheet.Num(g[0]);
                b.colGap = StyleSheet.Num(g[1]);
            }
            return true;
        }
        if (k == "row-gap") { b.rowGap = StyleSheet.Num(v); return true; }
        if (k == "column-gap") { b.colGap = StyleSheet.Num(v); return true; }
        if (k == "columns") { b.columns = StyleSheet.Num(v); return true; }
        return false;
    }

    /// 单个盒子度量（0 宽、1 高、2/3 min、4/5 max）：`%` 值保留
    /// 为包含块的比例（千分数），其余按像素处理。
    static void DeclMetric(StyleBox b, int which, string v) {
        bool pct = StyleSheet.IndexOf(v, "%") >= 0;
        int n = StyleSheet.Num(v);
        if (pct) { n = n * 10; }
        if (which == 0) { if (pct) { b.widthPm = n; } else { b.width = n; } }
        else if (which == 1) { if (pct) { b.heightPm = n; } else { b.height = n; } }
        else if (which == 2) { if (pct) { b.minWPm = n; } else { b.minW = n; } }
        else if (which == 3) { if (pct) { b.minHPm = n; } else { b.minH = n; } }
        else if (which == 4) { if (pct) { b.maxWPm = n; } else { b.maxW = n; } }
        else { if (pct) { b.maxHPm = n; } else { b.maxH = n; } }
    }

    /// layout：display / flexbox / position / overflow / visibility / cursor。
    static bool DeclLayout(StyleBox b, string k, string v) {
        if (k == "display") {
            b.display = 0;
            if (v == "flex" || v == "inline-flex") { b.display = 1; }
            if (v == "none") { b.display = 2; }
            return true;
        }
        if (k == "flex-direction") {
            b.flexDir = 0;
            if (v == "column" || v == "column-reverse") { b.flexDir = 1; }
            return true;
        }
        if (k == "justify-content") {
            b.justify = StyleSheet.JustifyCode(v);
            return true;
        }
        if (k == "align-items") {
            b.alignItems = 0;
            if (v == "flex-start" || v == "start" || v == "top") { b.alignItems = 1; }
            if (v == "center") { b.alignItems = 2; }
            if (v == "flex-end" || v == "end" || v == "bottom") { b.alignItems = 3; }
            return true;
        }
        // `flex-flow: <direction> || <wrap>`——两个值顺序任意，各自
        // 可省。
        if (k == "flex-flow") {
            List<string> ff = StyleSheet.Tokens(v);
            for (int i = 0; i < ff.Count; i = i + 1) {
                string t = StyleSheet.Lower(ff[i]);
                if (t == "row" || t == "row-reverse") { b.flexDir = 0; }
                else if (t == "column" || t == "col" || t == "column-reverse") {
                    b.flexDir = 1;
                } else if (t == "wrap" || t == "wrap-reverse") { b.wrap = 1; }
                else if (t == "nowrap") { b.wrap = 0; }
            }
            return true;
        }
        if (k == "flex-wrap") {
            b.wrap = 0;
            if (v == "wrap" || v == "wrap-reverse") { b.wrap = 1; }
            return true;
        }
        if (k == "align-content") {
            b.alignContent = StyleSheet.AlignContentCode(v);
            return true;
        }
        if (k == "align-self") {
            b.alignSelf = 0;
            if (v == "auto") { b.alignSelf = 0 - 1; }
            if (v == "flex-start" || v == "start" || v == "top") { b.alignSelf = 1; }
            if (v == "center") { b.alignSelf = 2; }
            if (v == "flex-end" || v == "end" || v == "bottom") { b.alignSelf = 3; }
            return true;
        }
        // `place-content: <align-content> [<justify-content>]`——一个值时
        // 两根轴取同一个（`place-content: center` 就是整块居中）。
        if (k == "place-content") {
            List<string> pc = StyleSheet.Tokens(v);
            if (pc.Count == 0) { return true; }
            b.alignContent = StyleSheet.AlignContentCode(StyleSheet.Lower(pc[0]));
            string j = pc[0];
            if (pc.Count >= 2) { j = pc[1]; }
            b.justify = StyleSheet.JustifyCode(StyleSheet.Lower(j));
            return true;
        }
        if (k == "flex") { StyleSheet.DeclFlex(b, v); return true; }
        if (k == "flex-grow") { b.grow = StyleSheet.Num(v); return true; }
        if (k == "flex-shrink") { b.shrink = StyleSheet.Num(v); return true; }
        if (k == "flex-basis") { StyleSheet.DeclBasis(b, v); return true; }
        if (k == "aspect-ratio") { StyleSheet.DeclAspect(b, v); return true; }
        if (k == "order") { b.order = StyleSheet.Num(v); return true; }
        if (k == "position") {
            b.position = 0;
            if (v == "relative") { b.position = 1; }
            if (v == "absolute" || v == "fixed") { b.position = 2; }
            return true;
        }
        if (k == "top") { b.posT = StyleSheet.Num(v); return true; }
        if (k == "right") { b.posR = StyleSheet.Num(v); return true; }
        if (k == "bottom") { b.posB = StyleSheet.Num(v); return true; }
        if (k == "left") { b.posL = StyleSheet.Num(v); return true; }
        // `inset: <all> | <v> <h> | <t> <h> <b> | <t> <r> <b> <l>`
        // （四边偏移的简写，和 padding 同一套取值规则）。
        if (k == "inset") {
            List<string> ins = StyleSheet.Tokens(v);
            if (ins.Count == 0) { return true; }
            int t = StyleSheet.Num(ins[0]);
            int r = t;
            int bo = t;
            int l = t;
            if (ins.Count == 2) {
                r = StyleSheet.Num(ins[1]);
                l = r;
            } else if (ins.Count == 3) {
                r = StyleSheet.Num(ins[1]);
                l = r;
                bo = StyleSheet.Num(ins[2]);
            } else if (ins.Count >= 4) {
                r = StyleSheet.Num(ins[1]);
                bo = StyleSheet.Num(ins[2]);
                l = StyleSheet.Num(ins[3]);
            }
            b.posT = t; b.posR = r; b.posB = bo; b.posL = l;
            return true;
        }
        if (k == "overflow" || k == "overflow-y" || k == "overflow-x") {
            b.overflow = 0;
            if (v == "hidden" || v == "clip" || v == "auto" || v == "scroll") {
                b.overflow = 1;
            }
            return true;
        }
        if (k == "z-index") { b.zIndex = StyleSheet.Num(v); return true; }
        if (k == "visibility") {
            b.visible = 1;
            if (v == "hidden" || v == "collapse") { b.visible = 0; }
            return true;
        }
        if (k == "cursor") { b.cursor = StyleSheet.CursorCode(v); return true; }
        // 本引擎的盒子一律是 border-box（内边距与边框都在声明尺寸
        // 之内），所以这条属性照收但不改任何东西——认下来是为了
        // 让作者照常写它，而不是让它掉到 Control.SetProp 里去。
        if (k == "box-sizing") { return true; }
        return false;
    }

    /// `justify-content` 的取值码：0 start，1 center，2 end，
    /// 3 space-between，4 space-around/evenly。
    static int JustifyCode(string v) {
        if (v == "center") { return 1; }
        if (v == "flex-end" || v == "end" || v == "right") { return 2; }
        if (v == "space-between") { return 3; }
        if (v == "space-around" || v == "space-evenly") { return 4; }
        return 0;
    }

    /// `align-content` 的取值码：0 start，1 center，2 end，
    /// 3 space-between，4 space-around/evenly，5 stretch。
    static int AlignContentCode(string v) {
        if (v == "center") { return 1; }
        if (v == "flex-end" || v == "end" || v == "bottom") { return 2; }
        if (v == "space-between") { return 3; }
        if (v == "space-around" || v == "space-evenly") { return 4; }
        if (v == "stretch") { return 5; }
        return 0;
    }

    /// `flex: none | auto | initial | <grow> [<shrink> [<basis>]]`。
    static void DeclFlex(StyleBox b, string val) {
        string lo = StyleSheet.Lower(val);
        if (lo == "none") { b.grow = 0; b.shrink = 0; return; }
        if (lo == "auto") { b.grow = 1; b.shrink = 1; return; }
        if (lo == "initial") { b.grow = 0; b.shrink = 1; return; }
        List<string> toks = StyleSheet.Tokens(val);
        if (toks.Count == 0) { return; }
        b.grow = StyleSheet.Num(toks[0]);
        if (toks.Count >= 2) { b.shrink = StyleSheet.Num(toks[1]); }
        if (toks.Count >= 3) { StyleSheet.DeclBasis(b, toks[2]); }
    }

    /// `flex-basis: auto | content | <px> | <pct>`：主轴基准尺寸。
    /// `auto` 撤销声明，回退到 width/height 或控件的测量偏好。
    static void DeclBasis(StyleBox b, string val) {
        string lo = StyleSheet.Lower(val);
        if (lo == "auto" || lo == "content") {
            b.basis = 0 - 1;
            b.basisPm = 0 - 1;
            return;
        }
        int n = StyleSheet.Num(val);
        if (StyleSheet.IndexOf(val, "%") >= 0) {
            b.basisPm = n * 10;
            b.basis = 0 - 1;
        } else {
            b.basis = n;
            b.basisPm = 0 - 1;
        }
    }

    /// `aspect-ratio: auto | <w> / <h> | <ratio>`，存为千分比
    /// （`16 / 9` -> 1778）。
    static void DeclAspect(StyleBox b, string val) {
        string lo = StyleSheet.Lower(val);
        if (lo == "auto" || lo == "none") { b.aspect = 0; return; }
        int slash = StyleSheet.IndexOf(val, "/");
        if (slash >= 0) {
            int w = StyleSheet.Num(StyleSheet.Trim(val.Substring(0, slash)));
            int h = StyleSheet.Num(StyleSheet.Trim(
                val.Substring(slash + 1, val.Length - slash - 1)));
            if (h == 0) { b.aspect = 0; return; }
            b.aspect = w * 1000 / h;
            return;
        }
        b.aspect = StyleSheet.Perm(val);
    }

    /// motion：transition / transform / animation。
    static bool DeclMotion(StyleBox b, string k, string v) {
        if (k == "transition" || k == "transition-duration") {
            StyleSheet.DeclTransition(b, v);
            return true;
        }
        if (k == "transition-timing-function") {
            b.easing = StyleSheet.Easing(v);
            return true;
        }
        if (k == "transform") { StyleSheet.DeclTransform(b, v); return true; }
        // 现代 CSS 里 translate/rotate/scale 也可以脱离 transform 单独
        // 声明，写起来短得多（`rotate: 90` 而不是 `transform: rotate(90)`）。
        if (k == "rotate") { b.rotate = StyleSheet.Num(v); return true; }
        if (k == "scale") { b.scale = StyleSheet.Perm(v); return true; }
        if (k == "translate") {
            List<string> t = StyleSheet.Tokens(v);
            if (t.Count >= 1) { b.tx = StyleSheet.Num(t[0]); }
            if (t.Count >= 2) { b.ty = StyleSheet.Num(t[1]); }
            return true;
        }
        if (k == "animation" || k == "animation-name") {
            StyleSheet.DeclAnimation(b, v);
            return true;
        }
        if (k == "animation-duration") { b.animMs = StyleSheet.Ms(v); return true; }
        return false;
    }

    /// `background: <color> | linear-gradient([<dir>,] a, b[, c])`。
    static void DeclBackground(StyleBox b, string val) {
        string s = val;
        if (StyleSheet.StartsWith(s, "linear-gradient(")) {
            int close = StyleSheet.LastIndexOf(s, ")");
            if (close < 0) { close = s.Length; }
            string inner = s.Substring(16, close - 16);
            List<string> parts = Css.SplitTopTrim(inner, ",");
            List<string> stops = new List<string>();
            int i = 0;
            while (i < parts.Count) {
                string p = parts[i];
                i = i + 1;
                if (p == "") { continue; }
                int dir = StyleSheet.GradientDir(p);
                if (dir >= 0) { b.bgDir = dir; continue; }
                stops.Add(p);
            }
            if (stops.Count >= 2) {
                b.bg = StyleSheet.ParseColor(StyleSheet.StopColor(stops[0]));
                if (stops.Count >= 3) {
                    b.bgVia = StyleSheet.ParseColor(StyleSheet.StopColor(stops[1]));
                    b.bgTo = StyleSheet.ParseColor(StyleSheet.StopColor(stops[2]));
                } else {
                    b.bgVia = 0;
                    b.bgTo = StyleSheet.ParseColor(StyleSheet.StopColor(stops[1]));
                }
                return;
            }
        }
        if (s == "none" || s == "transparent") {
            b.bg = 0;
            b.bgTo = 0;
            b.bgVia = 0;
            return;
        }
        b.bg = StyleSheet.ParseColor(s);
        b.bgTo = 0;
        b.bgVia = 0;
    }

    /// 渐变方向关键字/角度作为 StyleBox.bgDir，当该
    /// token 是颜色停靠点（color stop）时返回 -1。
    static int GradientDir(string tok) {
        string s = StyleSheet.Lower(tok);
        if (s == "to bottom" || s == "180deg") { return 0; }
        if (s == "to right" || s == "90deg") { return 1; }
        if (s == "to bottom right" || s == "135deg" || s == "to right bottom") { return 2; }
        if (s == "to top" || s == "0deg" || s == "360deg") { return 3; }
        if (s == "to bottom left" || s == "225deg" || s == "to left bottom") { return 4; }
        // 任意角度：吸附到最近的支持方向。CSS 角度
        // 从 12 点位置开始顺时针旋转（0=上、90=右、180=下），
        // 因此 “165deg”（略偏离正下方）吸附到底部。
        // 没有这个处理时，角度 token 会被解析为颜色停靠点，
        // 渐变会从透明的起始色开始。
        if (StyleSheet.EndsWith(s, "deg")) {
            int deg = StyleSheet.Num(tok);
            int d = deg % 360;
            if (d < 0) { d = d + 360; }
            int best = 0;
            int bestDist = 1000;
            for (int ci = 0; ci < 5; ci = ci + 1) {
                int a = 0;
                int dir = 0;
                if (ci == 0) { a = 180; dir = 0; }      // 底
                else if (ci == 1) { a = 0; dir = 3; }   // 顶
                else if (ci == 2) { a = 90; dir = 1; }  // 右
                else if (ci == 3) { a = 135; dir = 2; } // 右下
                else { a = 225; dir = 4; }              // 左下
                int dist = a - d;
                if (dist < 0) { dist = 0 - dist; }
                if (dist > 180) { dist = 360 - dist; }
                if (dist < bestDist) {
                    bestDist = dist;
                    best = dir;
                }
            }
            return best;
        }
        return 0 - 1;
    }

    /// 去掉停靠点的位置（`#fff 40%` -> `#fff`）。
    static string StopColor(string stop) {
        string s = StyleSheet.Trim(stop);
        if (StyleSheet.StartsWith(s, "rgb") || StyleSheet.StartsWith(s, "hsl")) {
            int close = StyleSheet.IndexOf(s, ")");
            if (close > 0) { return s.Substring(0, close + 1); }
            return s;
        }
        int sp = StyleSheet.IndexOf(s, " ");
        if (sp > 0) { return s.Substring(0, sp); }
        return s;
    }

    /// `border[-side]: <width> [style] <color>`（顺序任意，宽度可选）。
    static void DeclBorder(StyleBox b, string val, int side) {
        List<string> toks = StyleSheet.Tokens(val);
        int w = 1;
        int col = 0;
        bool haveW = false;
        int i = 0;
        while (i < toks.Count) {
            string tk = toks[i];
            i = i + 1;
            string lo = StyleSheet.Lower(tk);
            if (lo == "solid" || lo == "dashed" || lo == "dotted" || lo == "none") {
                if (lo == "none") { w = 0; haveW = true; }
                continue;
            }
            if (StyleSheet.IsNumeric(tk)) {
                w = StyleSheet.Num(tk);
                haveW = true;
                continue;
            }
            col = StyleSheet.ParseColor(tk);
        }
        if (!haveW) { w = 1; }
        if (side == 0) {
            b.borderW = w;
            if (col != 0) { b.borderColor = col; }
            b.borderTopW = 0 - 1; b.borderRightW = 0 - 1;
            b.borderBottomW = 0 - 1; b.borderLeftW = 0 - 1;
        } else if (side == 1) {
            b.borderTopW = w; b.borderTopColor = col;
        } else if (side == 2) {
            b.borderRightW = w; b.borderRightColor = col;
        } else if (side == 3) {
            b.borderBottomW = w; b.borderBottomColor = col;
        } else {
            b.borderLeftW = w; b.borderLeftColor = col;
        }
    }

    /// `border-radius: all | tl tr br bl`（`999`/`50%` 将形状完全圆化）。
    static void DeclRadius(StyleBox b, string val) {
        List<string> toks = StyleSheet.Tokens(val);
        if (toks.Count == 0) { return; }
        if (toks.Count == 1) {
            b.SetRadius(StyleSheet.Num(toks[0]));
            return;
        }
        int tl = StyleSheet.Num(toks[0]);
        int tr = tl;
        int br = tl;
        int bl = tl;
        if (toks.Count == 2) {
            tr = StyleSheet.Num(toks[1]);
            br = tl;
            bl = tr;
        } else if (toks.Count == 3) {
            tr = StyleSheet.Num(toks[1]);
            br = StyleSheet.Num(toks[2]);
            bl = tr;
        } else {
            tr = StyleSheet.Num(toks[1]);
            br = StyleSheet.Num(toks[2]);
            bl = StyleSheet.Num(toks[3]);
        }
        b.radiusTL = tl; b.radiusTR = tr; b.radiusBR = br; b.radiusBL = bl;
        int max = tl;
        if (tr > max) { max = tr; }
        if (br > max) { max = br; }
        if (bl > max) { max = bl; }
        b.radius = max;
    }

    /// 单个角的圆角（`border-top-left-radius` 等，`which`：0 TL、
    /// 1 TR、2 BR、3 BL）。
    ///
    /// 未被声明过的角先继承当前的 `radius`：StyleBox 用"四个角都
    /// 未声明"表示全圆角，只写一个角的话另外三个必须落成具体值，
    /// 否则 Corners() 会把它们当成直角，一条
    /// `border-top-left-radius: 0` 就会把整个盒子削成方的。
    static void CornerRadius(StyleBox b, int which, int v) {
        int fb = b.radius;
        if (fb < 0) { fb = 0; }
        if (b.radiusTL < 0) { b.radiusTL = fb; }
        if (b.radiusTR < 0) { b.radiusTR = fb; }
        if (b.radiusBR < 0) { b.radiusBR = fb; }
        if (b.radiusBL < 0) { b.radiusBL = fb; }
        if (which == 0) { b.radiusTL = v; }
        else if (which == 1) { b.radiusTR = v; }
        else if (which == 2) { b.radiusBR = v; }
        else { b.radiusBL = v; }
        int max = b.radiusTL;
        if (b.radiusTR > max) { max = b.radiusTR; }
        if (b.radiusBR > max) { max = b.radiusBR; }
        if (b.radiusBL > max) { max = b.radiusBL; }
        b.radius = max;
    }

    /// `box-shadow: [inset] <dx> <dy> [blur] <color>`（或仅一个颜色）。
    static void DeclShadow(StyleBox b, string val) {
        if (StyleSheet.Lower(val) == "none") {
            b.shadow = 0;
            return;
        }
        List<string> toks = StyleSheet.Tokens(val);
        List<int> nums = new List<int>();
        int col = 0;
        int i = 0;
        while (i < toks.Count) {
            string tk = toks[i];
            i = i + 1;
            if (StyleSheet.Lower(tk) == "inset") { b.shadowInset = 1; continue; }
            if (StyleSheet.IsNumeric(tk)) { nums.Add(StyleSheet.Num(tk)); continue; }
            col = StyleSheet.ParseColor(tk);
        }
        if (col != 0) { b.shadow = col; }
        if (nums.Count >= 2) {
            b.shadowDx = nums[0];
            b.shadowDy = nums[1];
            if (nums.Count >= 3) { b.shadowBlur = nums[2]; }
        } else if (nums.Count == 1) {
            b.shadowDy = nums[0];
        } else if (b.shadowDy == 0) {
            b.shadowDy = 2;
        }
    }

    /// `-zan-sheen: none | <strength> [color]`：玻璃光泽强度（`0.35`、
    /// `35%` 或千分比 `350`），可选高光颜色（默认白）。绘制由
    /// StyleBox 统一完成，因此任何画 box 的控件都能被皮肤点亮。
    static void DeclSheen(StyleBox b, string val) {
        if (StyleSheet.Lower(val) == "none") {
            b.sheen = 0;
            return;
        }
        List<string> toks = StyleSheet.Tokens(val);
        int i = 0;
        int str = 0 - 1;
        while (i < toks.Count) {
            string tk = toks[i];
            i = i + 1;
            if (StyleSheet.IsNumeric(tk)) {
                if (str < 0) { str = StyleSheet.Perm(tk); }
                continue;
            }
            b.sheenColor = StyleSheet.ParseColor(tk);
        }
        if (str < 0) { str = 1000; }
        if (str > 1000) { str = 1000; }
        b.sheen = str;
    }

    /// `padding/margin: all | v h | t h b | t r b l`。
    static void DeclSides(StyleBox b, string val, int which) {
        List<string> toks = StyleSheet.Tokens(val);
        if (toks.Count == 0) { return; }
        int t = StyleSheet.Num(toks[0]);
        int r = t;
        int bo = t;
        int l = t;
        if (toks.Count == 2) {
            r = StyleSheet.Num(toks[1]);
            l = r;
        } else if (toks.Count == 3) {
            r = StyleSheet.Num(toks[1]);
            l = r;
            bo = StyleSheet.Num(toks[2]);
        } else if (toks.Count >= 4) {
            r = StyleSheet.Num(toks[1]);
            bo = StyleSheet.Num(toks[2]);
            l = StyleSheet.Num(toks[3]);
        }
        if (which == 0) {
            b.padT = t; b.padR = r; b.padB = bo; b.padL = l;
        } else {
            b.marT = t; b.marR = r; b.marB = bo; b.marL = l;
        }
    }

    /// `transition: [prop] <duration> [timing]`——这里只有时长和 timing
    /// 有意义（所有可动画属性一起缓动）。
    static void DeclTransition(StyleBox b, string val) {
        List<string> toks = StyleSheet.Tokens(val);
        int i = 0;
        while (i < toks.Count) {
            string tk = toks[i];
            i = i + 1;
            if (StyleSheet.IsNumeric(tk)) { b.transitionMs = StyleSheet.Ms(tk); continue; }
            int e = StyleSheet.Easing(tk);
            if (e >= 0) { b.easing = e; }
        }
    }

    /// `transform: translate(x,y) translateX(x) translateY(y) scale(n) rotate(deg)`。
    static void DeclTransform(StyleBox b, string val) {
        string s = val;
        if (StyleSheet.Lower(s) == "none") {
            b.tx = 0; b.ty = 0; b.scale = 1000; b.rotate = 0;
            return;
        }
        int i = 0;
        while (i < s.Length) {
            int open = Css.IndexFrom(s, "(", i);
            if (open < 0) { return; }
            int close = Css.IndexFrom(s, ")", open + 1);
            if (close < 0) { return; }
            string name = StyleSheet.Lower(StyleSheet.Trim(s.Substring(i, open - i)));
            string args = s.Substring(open + 1, close - open - 1);
            i = close + 1;
            List<string> a = Css.SplitTrim(args, ",");
            if (name == "translate") {
                if (a.Count >= 1) { b.tx = StyleSheet.Num(a[0]); }
                if (a.Count >= 2) { b.ty = StyleSheet.Num(a[1]); }
            } else if (name == "translatex") {
                if (a.Count >= 1) { b.tx = StyleSheet.Num(a[0]); }
            } else if (name == "translatey") {
                if (a.Count >= 1) { b.ty = StyleSheet.Num(a[0]); }
            } else if (name == "scale") {
                if (a.Count >= 1) { b.scale = StyleSheet.Perm(a[0]); }
            } else if (name == "rotate") {
                if (a.Count >= 1) { b.rotate = StyleSheet.Num(a[0]); }
            }
        }
    }

    /// `animation: <name> <duration> [timing] [infinite]`。名称映射到
    /// 内置关键帧（spin、pulse、breath、shimmer、float、glow、aurora、
    /// motes），由 Fx 绘制。
    static void DeclAnimation(StyleBox b, string val) {
        List<string> toks = StyleSheet.Tokens(val);
        int i = 0;
        while (i < toks.Count) {
            string tk = toks[i];
            i = i + 1;
            string lo = StyleSheet.Lower(tk);
            if (lo == "none") { b.anim = 0; continue; }
            if (lo == "infinite" || lo == "linear" || lo == "ease"
                || lo == "ease-in" || lo == "ease-out" || lo == "ease-in-out"
                || lo == "alternate" || lo == "forwards") {
                int e = StyleSheet.Easing(lo);
                if (e >= 0) { b.easing = e; }
                continue;
            }
            if (StyleSheet.IsNumeric(tk)) { b.animMs = StyleSheet.Ms(tk); continue; }
            int kind = Style.AnimKind(lo);
            if (kind != 0) { b.anim = kind; }
        }
    }

    /// 滤镜值中的 `blur(20px)` -> 20（无时为 0）。
    static int BlurArg(string val) {
        int at = Css.IndexFrom(StyleSheet.Lower(val), "blur(", 0);
        if (at < 0) { return 0; }
        int close = Css.IndexFrom(val, ")", at);
        if (close < 0) { return 0; }
        return StyleSheet.Num(val.Substring(at + 5, close - at - 5));
    }

    static int Easing(string val) {
        string s = StyleSheet.Lower(val);
        if (s == "ease") { return 0; }
        if (s == "linear") { return 1; }
        if (s == "ease-in") { return 2; }
        if (s == "ease-out") { return 3; }
        if (s == "ease-in-out") { return 4; }
        return 0 - 1;
    }

    static int Weight(string val) {
        string s = StyleSheet.Lower(val);
        if (s == "bold" || s == "bolder") { return 700; }
        if (s == "normal") { return 400; }
        if (s == "light" || s == "lighter") { return 300; }
        return StyleSheet.Num(s);
    }

    static int CursorCode(string val) {
        string s = StyleSheet.Lower(val);
        if (s == "pointer" || s == "hand" || s == "grab") { return Cursor.Hand(); }
        if (s == "text") { return Cursor.IBeam(); }
        if (s == "ew-resize" || s == "col-resize") { return Cursor.ResizeH(); }
        if (s == "ns-resize" || s == "row-resize") { return Cursor.ResizeV(); }
        return Cursor.Arrow();
    }

    // ---- Control 应用（retained mode / UiDoc）----

    /// 将匹配的规则应用到 `c`，按特异性升序（type，然后
    /// class，然后 id），最具体的选择器胜出。
    void Apply(Control c, string type, string cls, string id) {
        ApplySelector(c, type);
        if (cls != "") { ApplySelector(c, "." + cls); }
        if (id != "") { ApplySelector(c, "#" + id); }
        // 状态规则叠加在基础外观之上，因此 `button:hover` 只需
        // 注明变化的部分。
        if (state != "") {
            ApplySelector(c, type + ":" + state);
            if (cls != "") { ApplySelector(c, "." + cls + ":" + state); }
            if (id != "") { ApplySelector(c, "#" + id + ":" + state); }
        }
        // 控件的 class 列表里还可以写 Tailwind 工具类，和 immediate
        // 模式走同一套解析（见 Tailwind），并同样最后应用。
        Tailwind.ApplyControl(c, cls, Style.StateBit(state));
    }

    /// 将一个选择器的声明应用到控件：layout 键落在
    /// 控件自身的字段上，视觉键走共享的 StyleBox 解析器
    /// （因此 CSS 在 retained 和 immediate 模式下行为一致），其余
    /// 通过 SetProp 发布给控件。
    void ApplySelector(Control c, string selector) {
        JsonValue block = this.Block(selector);
        if (block == null) { return; }
        StyleBox box = new StyleBox();
        bool visual = false;
        int i = 0;
        while (i < block.Count()) {
            string k = block.KeyAt(i);
            JsonValue v = block.ValAt(i);
            i = i + 1;
            if (k == "pad" || k == "padding") {
                c.Pad(StyleSheet.Num(StyleSheet.ValStr(v)));
                continue;
            }
            if (k == "gap") { c.gap = v.AsInt(0); continue; }
            if (k == "dock") {
                if (v.IsNumber()) { c.dock = v.AsInt(0); }
                else { c.dock = StyleSheet.DockValue(v.AsString("")); }
                continue;
            }
            if (k == "x") { c.mx = v.AsInt(0); continue; }
            if (k == "y") { c.my = v.AsInt(0); continue; }
            if (k == "width") { c.prefW = StyleSheet.Num(StyleSheet.ValStr(v)); continue; }
            if (k == "height") { c.prefH = StyleSheet.Num(StyleSheet.ValStr(v)); continue; }
            if (k == "__zan_prescaled") { continue; }
            if (StyleSheet.DeclSource(box, k, StyleSheet.ValStr(v),
                                      StyleSheet.IsPrescaled(block, k))) {
                visual = true;
                continue;
            }
            c.SetProp(k, StyleSheet.Scalar(v));
        }
        if (visual) { StyleSheet.CopyToControl(box, c); }
    }

    /// 复制控件内联携带的视觉属性（Control 只保留
    /// 一小部分；其余在绘制时存于解析后的 StyleBox 上）。
    static void CopyToControl(StyleBox b, Control c) {
        if (b.bg != 0) { c.styleBg = b.bg; }
        if (b.bgTo != 0) { c.styleBgTo = b.bgTo; }
        if (b.radius >= 0) { c.styleRadius = b.radius; }
        if (b.borderColor != 0) { c.styleBorderColor = b.borderColor; }
        if (b.borderW >= 0) { c.styleBorderWidth = b.borderW; }
        if (b.shadow != 0) {
            c.styleShadow = b.shadow;
            c.styleShadowDy = b.shadowDy;
            if (c.styleShadowDy == 0) { c.styleShadowDy = 2; }
        }
        if (b.fg != 0) { c.styleColor = b.fg; }
        if (b.fontPx > 0) { c.styleFontPx = b.fontPx; }
        if (b.transitionMs >= 0) { c.styleTransitionMs = b.transitionMs; }
    }

    /// 在控件上设置纯色填充或 `linear-gradient(a,b)`。
    static void ApplyBackground(Control c, string val) {
        StyleBox b = new StyleBox();
        StyleSheet.DeclBackground(b, StyleSheet.Trim(val));
        c.styleBg = b.bg;
        c.styleBgTo = b.bgTo;
    }

    /// 解析 `border: <width> <color>`（宽度可选，默认为 1）。
    static void ApplyBorder(Control c, string val) {
        StyleBox b = new StyleBox();
        StyleSheet.DeclBorder(b, StyleSheet.Trim(val), 0);
        c.styleBorderWidth = b.borderW;
        c.styleBorderColor = b.borderColor;
    }

    // ---- 值解析 -----

    /// 将 CSS 颜色解析为打包的 0xAARRGGBB int。接受 `#RGB`、
    /// `#RRGGBB`、`#RRGGBBAA`、`#AARRGGBB`、`rgb()/rgba()`、`hsl()/hsla()`、
    /// `0x...`、纯十进制数和 CSS 命名颜色。空值或无法解析的值
    /// 返回 0（= 未设置），因此坏规则只是什么都不做。
    static int ParseColor(string val) {
        string s = StyleSheet.Trim(val);
        if (s.Length == 0) { return 0; }
        if (s.Substring(0, 1) == "#") {
            string h = s.Substring(1, s.Length - 1);
            if (h.Length == 3) {
                string r = h.Substring(0, 1);
                string g = h.Substring(1, 1);
                string b = h.Substring(2, 1);
                h = r + r + g + g + b + b;
            } else if (h.Length == 4) {
                // #rgba
                string r = h.Substring(0, 1);
                string g = h.Substring(1, 1);
                string b = h.Substring(2, 1);
                string a = h.Substring(3, 1);
                h = a + a + r + r + g + g + b + b;
            }
            if (h.Length == 6) { h = "FF" + h; }
            if (h.Length == 8 && StyleSheet.HexDigit(h.Substring(0, 1)) < 0) { return 0; }
            if (h.Length != 8) { return 0; }
            return StyleSheet.HexToInt(h);
        }
        string lo = StyleSheet.Lower(s);
        if (StyleSheet.StartsWith(lo, "rgb")) { return StyleSheet.ParseRgb(s); }
        if (StyleSheet.StartsWith(lo, "hsl")) { return StyleSheet.ParseHsl(s); }
        if (lo == "transparent" || lo == "none" || lo == "currentcolor") { return 0; }
        if (s.Length > 2 && s.Substring(0, 2) == "0x") {
            return StyleSheet.HexToInt(s.Substring(2, s.Length - 2));
        }
        int named = StyleSheet.NamedColor(lo);
        if (named != 0) { return named; }
        return StyleSheet.ParseInt(s);
    }

    /// `rgb(r,g,b)` / `rgba(r,g,b,a)`，`a` 为 0..1 或百分比。
    static int ParseRgb(string val) {
        int open = StyleSheet.IndexOf(val, "(");
        int close = StyleSheet.LastIndexOf(val, ")");
        if (open < 0 || close < open) { return 0; }
        List<string> a = Css.SplitTrim(val.Substring(open + 1, close - open - 1), ",");
        if (a.Count < 3) { return 0; }
        int r = StyleSheet.Chan(a[0]);
        int g = StyleSheet.Chan(a[1]);
        int b = StyleSheet.Chan(a[2]);
        int al = 255;
        if (a.Count >= 4) { al = StyleSheet.Perm(a[3]) * 255 / 1000; }
        return StyleSheet.Pack(al, r, g, b);
    }

    /// `hsl(h,s%,l%)` / `hsla(...)` 转换为 RGB（整数运算）。
    static int ParseHsl(string val) {
        int open = StyleSheet.IndexOf(val, "(");
        int close = StyleSheet.LastIndexOf(val, ")");
        if (open < 0 || close < open) { return 0; }
        List<string> a = Css.SplitTrim(val.Substring(open + 1, close - open - 1), ",");
        if (a.Count < 3) { return 0; }
        int h = StyleSheet.Num(a[0]) % 360;
        if (h < 0) { h = h + 360; }
        int sat = StyleSheet.Perm(a[1]);
        int lit = StyleSheet.Perm(a[2]);
        int al = 255;
        if (a.Count >= 4) { al = StyleSheet.Perm(a[3]) * 255 / 1000; }
        // c = (1 - |2l - 1|) * s；所有值均为千分数
        int d2l = 2 * lit - 1000;
        if (d2l < 0) { d2l = 0 - d2l; }
        int chroma = (1000 - d2l) * sat / 1000;
        int hp = h * 1000 / 60;
        int mod2 = hp % 2000;
        int xm = mod2 - 1000;
        if (xm < 0) { xm = 0 - xm; }
        int x = chroma * (1000 - xm) / 1000;
        int m = lit - chroma / 2;
        int r = 0; int g = 0; int b = 0;
        if (h < 60) { r = chroma; g = x; b = 0; }
        else if (h < 120) { r = x; g = chroma; b = 0; }
        else if (h < 180) { r = 0; g = chroma; b = x; }
        else if (h < 240) { r = 0; g = x; b = chroma; }
        else if (h < 300) { r = x; g = 0; b = chroma; }
        else { r = chroma; g = 0; b = x; }
        r = (r + m) * 255 / 1000;
        g = (g + m) * 255 / 1000;
        b = (b + m) * 255 / 1000;
        return StyleSheet.Pack(al, r, g, b);
    }

    /// 单个 rgb() 通道：`0..255` 或百分比。
    static int Chan(string tok) {
        string s = StyleSheet.Trim(tok);
        if (StyleSheet.IndexOf(s, "%") >= 0) { return StyleSheet.Perm(s) * 255 / 1000; }
        return StyleSheet.Clamp255(StyleSheet.Num(s));
    }

    static int Clamp255(int v) {
        if (v < 0) { return 0; }
        if (v > 255) { return 255; }
        return v;
    }

    /// 将 a,r,g,b（0..255）打包为 GUI 的有符号 0xAARRGGBB int。
    static int Pack(int a, int r, int g, int b) {
        int av = StyleSheet.Clamp255(a);
        int rv = StyleSheet.Clamp255(r);
        int gv = StyleSheet.Clamp255(g);
        int bv = StyleSheet.Clamp255(b);
        return av * 16777216 + rv * 65536 + gv * 256 + bv;
    }

    /// 皮肤实际会用到的 CSS 命名颜色（未知时为 0）。
    static int NamedColor(string name) {
        if (name == "white") { return StyleSheet.Pack(255, 255, 255, 255); }
        if (name == "black") { return StyleSheet.Pack(255, 0, 0, 0); }
        if (name == "red") { return StyleSheet.Pack(255, 255, 0, 0); }
        if (name == "green") { return StyleSheet.Pack(255, 0, 128, 0); }
        if (name == "lime") { return StyleSheet.Pack(255, 0, 255, 0); }
        if (name == "blue") { return StyleSheet.Pack(255, 0, 0, 255); }
        if (name == "yellow") { return StyleSheet.Pack(255, 255, 255, 0); }
        if (name == "orange") { return StyleSheet.Pack(255, 255, 165, 0); }
        if (name == "gold") { return StyleSheet.Pack(255, 255, 215, 0); }
        if (name == "purple") { return StyleSheet.Pack(255, 128, 0, 128); }
        if (name == "magenta" || name == "fuchsia") { return StyleSheet.Pack(255, 255, 0, 255); }
        if (name == "cyan" || name == "aqua") { return StyleSheet.Pack(255, 0, 255, 255); }
        if (name == "gray" || name == "grey") { return StyleSheet.Pack(255, 128, 128, 128); }
        if (name == "silver") { return StyleSheet.Pack(255, 192, 192, 192); }
        if (name == "maroon") { return StyleSheet.Pack(255, 128, 0, 0); }
        if (name == "navy") { return StyleSheet.Pack(255, 0, 0, 128); }
        if (name == "teal") { return StyleSheet.Pack(255, 0, 128, 128); }
        if (name == "olive") { return StyleSheet.Pack(255, 128, 128, 0); }
        if (name == "pink") { return StyleSheet.Pack(255, 255, 192, 203); }
        if (name == "brown") { return StyleSheet.Pack(255, 165, 42, 42); }
        if (name == "crimson") { return StyleSheet.Pack(255, 220, 20, 60); }
        if (name == "coral") { return StyleSheet.Pack(255, 255, 127, 80); }
        if (name == "salmon") { return StyleSheet.Pack(255, 250, 128, 114); }
        if (name == "khaki") { return StyleSheet.Pack(255, 240, 230, 140); }
        if (name == "ivory") { return StyleSheet.Pack(255, 255, 255, 240); }
        if (name == "beige") { return StyleSheet.Pack(255, 245, 245, 220); }
        if (name == "wheat") { return StyleSheet.Pack(255, 245, 222, 179); }
        if (name == "tan") { return StyleSheet.Pack(255, 210, 180, 140); }
        if (name == "indigo") { return StyleSheet.Pack(255, 75, 0, 130); }
        if (name == "violet") { return StyleSheet.Pack(255, 238, 130, 238); }
        if (name == "turquoise") { return StyleSheet.Pack(255, 64, 224, 208); }
        if (name == "skyblue") { return StyleSheet.Pack(255, 135, 206, 235); }
        if (name == "steelblue") { return StyleSheet.Pack(255, 70, 130, 180); }
        if (name == "slategray" || name == "slategrey") { return StyleSheet.Pack(255, 112, 128, 144); }
        if (name == "seagreen") { return StyleSheet.Pack(255, 46, 139, 87); }
        if (name == "forestgreen") { return StyleSheet.Pack(255, 34, 139, 34); }
        if (name == "darkgreen") { return StyleSheet.Pack(255, 0, 100, 0); }
        if (name == "darkred") { return StyleSheet.Pack(255, 139, 0, 0); }
        if (name == "darkblue") { return StyleSheet.Pack(255, 0, 0, 139); }
        if (name == "darkgray" || name == "darkgrey") { return StyleSheet.Pack(255, 169, 169, 169); }
        if (name == "lightgray" || name == "lightgrey") { return StyleSheet.Pack(255, 211, 211, 211); }
        if (name == "whitesmoke") { return StyleSheet.Pack(255, 245, 245, 245); }
        return 0;
    }

    /// 将十六进制字符串（最多 8 位）转换为打包 int。最高位为 1
    /// （alpha >= 0x80）自然产生负数，与 Theme token 一致。
    static int HexToInt(string h) {
        int acc = 0;
        for (int i = 0; i < h.Length; i = i + 1) {
            int d = StyleSheet.HexDigit(h.Substring(i, 1));
            if (d < 0) { return 0; }
            acc = (acc * 16) + d;
        }
        return acc;
    }

    static int HexDigit(string ch) {
        if (ch == "0") { return 0; }
        if (ch == "1") { return 1; }
        if (ch == "2") { return 2; }
        if (ch == "3") { return 3; }
        if (ch == "4") { return 4; }
        if (ch == "5") { return 5; }
        if (ch == "6") { return 6; }
        if (ch == "7") { return 7; }
        if (ch == "8") { return 8; }
        if (ch == "9") { return 9; }
        if (ch == "a" || ch == "A") { return 10; }
        if (ch == "b" || ch == "B") { return 11; }
        if (ch == "c" || ch == "C") { return 12; }
        if (ch == "d" || ch == "D") { return 13; }
        if (ch == "e" || ch == "E") { return 14; }
        if (ch == "f" || ch == "F") { return 15; }
        return -1;
    }

    static bool Digit(string ch) {
        int d = StyleSheet.HexDigit(ch);
        return d >= 0 && d <= 9;
    }

    /// token 读作数字时返回 true（可选符号、十进制、带
    /// px/ms/s/%/deg 等单位后缀），而非关键字或颜色。
    static bool IsNumeric(string tok) {
        string s = StyleSheet.Trim(tok);
        if (s.Length == 0) { return false; }
        string first = s.Substring(0, 1);
        if (first == "-" || first == "+" || first == ".") {
            if (s.Length < 2) { return false; }
            return StyleSheet.Digit(s.Substring(1, 1));
        }
        return StyleSheet.Digit(first);
    }

    /// 将 CSS 长度/数字转为 int：感知符号、容忍单位（`12px`、`-4`、
    /// `1.5rem` -> 1、`200ms`），非数字 token 返回 0。
    static int Num(string val) {
        string s = StyleSheet.Trim(val);
        if (s.Length == 0) { return 0; }
        int sign = 1;
        int i = 0;
        if (s.Substring(0, 1) == "-") { sign = -1; i = 1; }
        else if (s.Substring(0, 1) == "+") { i = 1; }
        int acc = 0;
        bool any = false;
        while (i < s.Length) {
            string ch = s.Substring(i, 1);
            if (!StyleSheet.Digit(ch)) { i = s.Length; }
            else {
                acc = acc * 10 + StyleSheet.HexDigit(ch);
                any = true;
                i = i + 1;
            }
        }
        if (!any) { return 0; }
        return sign * acc;
    }

    /// 比例转千分数：`1` / `1.0` -> 1000、`0.5` -> 500、`60%` -> 600、
    /// `255`（alpha 通道）由调用方保持 255 比例。
    static int Perm(string val) {
        string s = StyleSheet.Trim(val);
        if (s.Length == 0) { return 1000; }
        if (StyleSheet.IndexOf(s, "%") >= 0) {
            return StyleSheet.Num(s) * 10;
        }
        int dot = StyleSheet.IndexOf(s, ".");
        if (dot < 0) {
            int n = StyleSheet.Num(s);
            if (n <= 1) { return n * 1000; }
            return n;
        }
        int whole = StyleSheet.Num(s.Substring(0, dot));
        string fracStr = s.Substring(dot + 1, s.Length - dot - 1);
        int frac = 0;
        int scale = 100;
        int i = 0;
        while (i < fracStr.Length && i < 3) {
            string ch = fracStr.Substring(i, 1);
            if (!StyleSheet.Digit(ch)) { i = fracStr.Length; }
            else {
                frac = frac + StyleSheet.HexDigit(ch) * scale;
                scale = scale / 10;
                i = i + 1;
            }
        }
        int sign = 1;
        if (whole < 0) { sign = -1; whole = -whole; }
        return sign * (whole * 1000 + frac);
    }

    /// CSS 时长（毫秒）：`200`、`200ms`、`0.25s`。
    static int Ms(string val) {
        string s = StyleSheet.Trim(val);
        if (StyleSheet.IndexOf(StyleSheet.Lower(s), "ms") >= 0) {
            return StyleSheet.Num(s);
        }
        if (StyleSheet.IndexOf(StyleSheet.Lower(s), "s") >= 0) {
            return StyleSheet.Perm(s);
        }
        return StyleSheet.Num(s);
    }

    static int ParseInt(string s) {
        return StyleSheet.Num(s);
    }

    /// 将值按空白拆分为 token，保持 `fn(a, b)`
    /// 分组完整，使 `rgba(0,0,0,.4)` 作为一个 token 保留。
    static List<string> Tokens(string val) {
        List<string> outp = new List<string>();
        string cur = "";
        int depth = 0;
        int i = 0;
        while (i < val.Length) {
            string ch = val.Substring(i, 1);
            i = i + 1;
            if (ch == "(") { depth = depth + 1; cur = cur + ch; continue; }
            if (ch == ")") { depth = depth - 1; cur = cur + ch; continue; }
            if (depth == 0 && Css.Space(ch)) {
                if (cur != "") { outp.Add(cur); }
                cur = "";
                continue;
            }
            cur = cur + ch;
        }
        if (cur != "") { outp.Add(cur); }
        return outp;
    }

    static bool StartsWith(string s, string prefix) {
        if (s.Length < prefix.Length) { return false; }
        return s.Substring(0, prefix.Length) == prefix;
    }

    static int IndexOf(string s, string ch) {
        return Css.IndexFrom(s, ch, 0);
    }

    static bool EndsWith(string s, string suffix) {
        if (s.Length < suffix.Length) { return false; }
        return s.Substring(s.Length - suffix.Length, suffix.Length) == suffix;
    }

    /// 单字符查找（`ch` 只取首字符）。
    static int LastIndexOf(string s, string ch) {
        int found = -1;
        for (int i = 0; i < s.Length; i = i + 1) {
            if (s.Substring(i, 1) == ch) { found = i; }
        }
        return found;
    }

    static string Lower(string s) {
        return s.ToLower();
    }

    static string Trim(string s) {
        return Css.Trim(s);
    }

    /// 把停靠名（`top`/`bottom`/`left`/`right`/`fill`）解析为
    /// Dock 常量。供样式表 / JSON 文档共用。
    static int DockValue(string text) {
        if (text == "top" || text == "Top") { return Dock.Top(); }
        if (text == "bottom" || text == "Bottom") { return Dock.Bottom(); }
        if (text == "left" || text == "Left") { return Dock.Left(); }
        if (text == "right" || text == "Right") { return Dock.Right(); }
        if (text == "fill" || text == "Fill") { return Dock.Fill(); }
        return Dock.Manual();
    }

    /// 把标量 JSON 值渲染为 SetProp 期望的文本。
    static string Scalar(JsonValue v) {
        if (v.IsString()) { return v.AsString(""); }
        if (v.IsNumber()) { return v.AsString(""); }
        if (v.IsBool()) { if (v.AsBool(false)) { return "true"; } return "false"; }
        return "";
    }
}
