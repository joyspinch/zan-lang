        if (name == "darkslateblue") { return StyleSheet.Pack(255, 72, 61, 139); }
        if (name == "darkslategray" || name == "darkslategrey") { return StyleSheet.Pack(255, 47, 79, 79); }
        if (name == "darkturquoise") { return StyleSheet.Pack(255, 0, 206, 209); }
        if (name == "darkviolet") { return StyleSheet.Pack(255, 148, 0, 211); }
