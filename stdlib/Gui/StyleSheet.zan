    }

    /// 将十六进制字符串（最多 8 位）转换为打包 int。最高位为 1
    /// （alpha >= 0x80）自然产生负数，与 Theme token 一致。
    static int HexToInt(string h) {
        int acc = 0;
        for (int i = 0; i < h.Length; i = i + 1) {
            int d = StyleSheet.HexDigit(h.Substring(i, 1));
            if (d < 0) { return 0; }
            acc = (acc * 16) + d;
        }
        return acc;
    }

    /// 单个十六进制字符的值（0-15），非十六进制时 -1。
    static int HexDigit(string ch) {
        if (ch == "0") { return 0; }
        if (ch == "1") { return 1; }
        if (ch == "2") { return 2; }
        if (ch == "3") { return 3; }
        if (ch == "4") { return 4; }
        if (ch == "5") { return 5; }
        if (ch == "6") { return 6; }
        if (ch == "7") { return 7; }
        if (ch == "8") { return 8; }
        if (ch == "9") { return 9; }
        if (ch == "a" || ch == "A") { return 10; }
        if (ch == "b" || ch == "B") { return 11; }
        if (ch == "c" || ch == "C") { return 12; }
        if (ch == "d" || ch == "D") { return 13; }
        if (ch == "e" || ch == "E") { return 14; }
        if (ch == "f" || ch == "F") { return 15; }
        return -1;
    }

    /// 字符是否为十进制数字。
    static bool Digit(string ch) {
        int d = StyleSheet.HexDigit(ch);
        return d >= 0 && d <= 9;
    }

    /// token 读作数字时返回 true（可选符号、十进制、带
    /// px/ms/s/%/deg 等单位后缀），而非关键字或颜色。
    static bool IsNumeric(string tok) {
        string s = StyleSheet.Trim(tok);
        if (s.Length == 0) { return false; }
        string first = s.Substring(0, 1);
        if (first == "-" || first == "+" || first == ".") {
            if (s.Length < 2) { return false; }
            return StyleSheet.Digit(s.Substring(1, 1));
        }
        return StyleSheet.Digit(first);
    }

    /// 将 CSS 长度/数字转为 int：感知符号、容忍单位（`12px`、`-4`、
    /// `1.5rem` -> 1、`200ms`），非数字 token 返回 0。
    static int Num(string val) {
        string s = StyleSheet.Trim(val);
        if (s.Length == 0) { return 0; }
        int sign = 1;
        int i = 0;
        if (s.Substring(0, 1) == "-") { sign = -1; i = 1; }
        else if (s.Substring(0, 1) == "+") { i = 1; }
        int acc = 0;
        bool any = false;
        while (i < s.Length) {
            string ch = s.Substring(i, 1);
            if (!StyleSheet.Digit(ch)) { i = s.Length; }
            else {
                acc = acc * 10 + StyleSheet.HexDigit(ch);
                any = true;
                i = i + 1;
            }
        }
        if (!any) { return 0; }
        return sign * acc;
    }

    /// 比例转千分数：`1` / `1.0` -> 1000、`0.5` -> 500、`60%` -> 600、
    /// `255`（alpha 通道）由调用方保持 255 比例。
    static int Perm(string val) {
        string s = StyleSheet.Trim(val);
        if (s.Length == 0) { return 1000; }
        if (StyleSheet.IndexOf(s, "%") >= 0) {
            return StyleSheet.Num(s) * 10;
        }
        int dot = StyleSheet.IndexOf(s, ".");
        if (dot < 0) {
            int n = StyleSheet.Num(s);
            if (n <= 1) { return n * 1000; }
            return n;
        }
        int whole = StyleSheet.Num(s.Substring(0, dot));
        string fracStr = s.Substring(dot + 1, s.Length - dot - 1);
        int frac = 0;
        int scale = 100;
        int i = 0;
        while (i < fracStr.Length && i < 3) {
            string ch = fracStr.Substring(i, 1);
            if (!StyleSheet.Digit(ch)) { i = fracStr.Length; }
            else {
                frac = frac + StyleSheet.HexDigit(ch) * scale;
                scale = scale / 10;
                i = i + 1;
            }
        }
        int sign = 1;
        if (whole < 0) { sign = -1; whole = -whole; }
        return sign * (whole * 1000 + frac);
    }

    /// CSS 时长（毫秒）：`200`、`200ms`、`0.25s`。
    static int Ms(string val) {
        string s = StyleSheet.Trim(val);
        if (StyleSheet.IndexOf(StyleSheet.Lower(s), "ms") >= 0) {
            return StyleSheet.Num(s);
        }
        if (StyleSheet.IndexOf(StyleSheet.Lower(s), "s") >= 0) {
            return StyleSheet.Perm(s);
        }
        return StyleSheet.Num(s);
    }

    // ---- 长度与数学（calc 家族）---------------------------------------------

    /// CSS 长度求值，返回 px 整数。单位：px/无单位照旧；em 相对当前
    /// 有效字号（解析级联里已声明的 font-size，未声明时主题正文）；
    /// rem 相对根字号；ex/ch 近似半高（0.5em）；pt 按 96dpi 折算；
    /// vw/vh/vmin/vmax 相对窗口逻辑尺寸；`%` 保持各属性原有语义
    /// （这里当裸数字返回，声明点的百分比分支不受影响）。
    /// calc()/min()/max()/clamp() 递归求值（见 CssMath）。
    static int Len(StyleBox b, string val) {
        string v = StyleSheet.Trim(val);
        if (v == "") { return 0; }
        if (StyleSheet.HasMath(v)) { return StyleSheet.CssMath(b, v); }
        return StyleSheet.UnitPx(b, v);
    }

    /// 值里是否带数学函数（calc/min/max/clamp）。
    static bool HasMath(string v) {
        string s = StyleSheet.Lower(v);
        return Css.IndexFrom(s, "calc(", 0) >= 0
            || Css.IndexFrom(s, "min(", 0) >= 0
            || Css.IndexFrom(s, "max(", 0) >= 0
            || Css.IndexFrom(s, "clamp(", 0) >= 0;
    }

    /// 千分比转 px 的四舍五入。
    static int Round1000(int perm) {
        if (perm >= 0) { return (perm + 500) / 1000; }
        return 0 - ((0 - perm + 500) / 1000);
    }

    /// 数字文本 -> 千分比整数：`12` -> 12000、`1.5` -> 1500、
    /// `.5` -> 500、`-2` -> -2000。（不能复用 Perm：它对无小数点的
    /// 整数按原样返回——那是 alpha 通道的语义，不是长度。）
    static int NumPerm(string numStr) {
        string s = numStr;
        int sign = 1;
        if (s.Substring(0, 1) == "-") { sign = 0 - 1; s = s.Substring(1, s.Length - 1); }
        else if (s.Substring(0, 1) == "+") { s = s.Substring(1, s.Length - 1); }
        int dot = StyleSheet.IndexOf(s, ".");
        int whole = dot < 0 ? StyleSheet.Num(s) : StyleSheet.Num(
            s.Substring(0, dot));
        int frac = 0;
        int scale = 100;
        if (dot >= 0) {
            string fs = s.Substring(dot + 1, s.Length - dot - 1);
            for (int i = 0; i < fs.Length && i < 3; i = i + 1) {
                string ch = fs.Substring(i, 1);
                if (!StyleSheet.Digit(ch)) { break; }
                frac = frac + StyleSheet.HexDigit(ch) * scale;
                scale = scale / 10;
            }
        }
        return sign * (whole * 1000 + frac);
    }

    /// 单个"数字+单位"记号 -> px 整数。未知单位按裸数字处理
    /// （ValueUnresolved 仍会点名），空数字回退 Num。
    static int UnitPx(StyleBox b, string tok) {
        string s = StyleSheet.Trim(tok);
        if (s.Length == 0) { return 0; }
        int i = 0;
        if (s.Substring(0, 1) == "-" || s.Substring(0, 1) == "+") { i = 1; }
        int st = i;
        while (i < s.Length) {
            string ch = s.Substring(i, 1);
            if (StyleSheet.Digit(ch) || ch == ".") { i = i + 1; }
            else { break; }
        }
        string numStr = s.Substring(0, i);
        string unit = StyleSheet.Lower(s.Substring(i, s.Length - i));
        if (numStr == "" || numStr == "-" || numStr == "+") {
            return StyleSheet.Num(s);
        }
        int perm = StyleSheet.NumPerm(numStr);
        if (unit == "" || unit == "px") { return StyleSheet.Round1000(perm); }
        if (unit == "em") {
            int font = b.fontPx > 0 ? b.fontPx
                : (b.envRemPx > 0 ? b.envRemPx : 16);
            return StyleSheet.Round1000(perm * font);
        }
        if (unit == "rem") {
            int rem = b.envRemPx > 0 ? b.envRemPx : 16;
            return StyleSheet.Round1000(perm * rem);
        }
        if (unit == "ex" || unit == "ch") {
            int f2 = b.fontPx > 0 ? b.fontPx
                : (b.envRemPx > 0 ? b.envRemPx : 16);
            return StyleSheet.Round1000(perm * f2 / 2);
        }
        if (unit == "pt") { return StyleSheet.Round1000(perm * 4 / 3); }
        // 绝对单位按 96dpi 折算：pc = 12pt，in = 96px，
        // cm = 96/2.54，mm = 1/10 cm，q = 1/40 cm。
        if (unit == "pc") { return StyleSheet.Round1000(perm * 16); }
        if (unit == "in") { return StyleSheet.Round1000(perm * 96); }
        if (unit == "cm") { return StyleSheet.Round1000(perm * 37795 / 1000); }
        if (unit == "mm") { return StyleSheet.Round1000(perm * 37795 / 10000); }
        if (unit == "q") { return StyleSheet.Round1000(perm * 37795 / 40000); }
        if (unit == "vw") {
            int w = b.envVw > 0 ? b.envVw : 1280;
            return StyleSheet.Round1000(perm * w / 100);
        }
        if (unit == "vh") {
            int h = b.envVh > 0 ? b.envVh : 720;
            return StyleSheet.Round1000(perm * h / 100);
        }
        if (unit == "vmin" || unit == "vmax") {
            int w2 = b.envVw > 0 ? b.envVw : 1280;
            int h2 = b.envVh > 0 ? b.envVh : 720;
            int base2 = unit == "vmin" ? (w2 < h2 ? w2 : h2) : (w2 > h2 ? w2 : h2);
            return StyleSheet.Round1000(perm * base2 / 100);
        }
        if (unit == "%") {
            // 长度点的 % 语义属于各声明（widthPm/千分比通道）；
            // 这里维持"裸数字"的历史行为。
            return StyleSheet.Round1000(perm);
        }
        return StyleSheet.Round1000(perm);
    }

    /// calc()/min()/max()/clamp() 求值（可嵌套）。叶子单位在 UnitPx
    /// 折算成 px；`%` 在表达式里按视口宽近似——容器宽度在样式解析期
    /// （布局之前）不可得，视口是稳定的基准，Lint/审计文档有说明。
    static int CssMath(StyleBox b, string val) {
        string v = StyleSheet.Trim(val);
        string lo = StyleSheet.Lower(v);
        if (StyleSheet.StartsWith(lo, "clamp(")) {
            int open = StyleSheet.IndexOf(v, "(");
            int close = v.Length - 1;
            while (close > open && v.Substring(close, 1) != ")") { close = close - 1; }
            List<string> a = Css.SplitTopTrim(
                v.Substring(open + 1, close - open - 1), ",");
            if (a.Count < 3) { return 0; }
            int mn = StyleSheet.CssMath(b, a[0]);
            int mid = StyleSheet.CssMath(b, a[1]);
            int mx = StyleSheet.CssMath(b, a[2]);
            return mn > mx ? mn : (mid < mn ? mn : (mid > mx ? mx : mid));
        }
        if (StyleSheet.StartsWith(lo, "min(") || StyleSheet.StartsWith(lo, "max(")) {
            bool isMin = StyleSheet.StartsWith(lo, "min(");
            int open2 = StyleSheet.IndexOf(v, "(");
            int close2 = v.Length - 1;
            while (close2 > open2 && v.Substring(close2, 1) != ")") { close2 = close2 - 1; }
            List<string> a2 = Css.SplitTopTrim(
                v.Substring(open2 + 1, close2 - open2 - 1), ",");
            if (a2.Count == 0) { return 0; }
            int best = StyleSheet.CssMath(b, a2[0]);
            for (int i = 1; i < a2.Count; i = i + 1) {
                int cur = StyleSheet.CssMath(b, a2[i]);
                if (isMin ? cur < best : cur > best) { best = cur; }
            }
            return best;
        }
        // calc(...) 或裸表达式（min/max 的参数可以是 `10px + 2em`）。
        int op = Css.IndexFrom(lo, "calc(", 0);
        string expr = op >= 0
            ? v.Substring(op + 5, v.Length - op - 5) : v;
        int endI = expr.Length - 1;
        while (endI >= 0 && expr.Substring(endI, 1) != ")") { endI = endI - 1; }
        if (endI >= 0 && op >= 0) { expr = expr.Substring(0, endI); }
        List<string> toks = StyleSheet.MathTokens(expr);
        MathCursor cur2 = new MathCursor();
        cur2.toks = toks;
        cur2.pos = 0;
        int val2 = StyleSheet.MathExpr(b, cur2);
        return val2;
    }

    /// 表达式 token 化：数字+单位、运算符、括号；空白跳过。
    static List<string> MathTokens(string s) {
        List<string> outp = new List<string>();
        int i = 0;
        while (i < s.Length) {
            string ch = s.Substring(i, 1);
            if (Css.Space(ch)) { i = i + 1; continue; }
            if (ch == "(" || ch == ")" || ch == "+" || ch == "-"
                || ch == "*" || ch == "/") {
                outp.Add(ch);
                i = i + 1;
                continue;
            }
            int st = i;
            while (i < s.Length) {
                string c2 = s.Substring(i, 1);
                if (Css.Space(c2) || c2 == "(" || c2 == ")" || c2 == "+"
                    || c2 == "-" || c2 == "*" || c2 == "/") {
                    break;
                }
                i = i + 1;
            }
            outp.Add(s.Substring(st, i - st));
        }
        return outp;
    }

    /// 加减层：term (('+'|'-') term)*。
    static int MathExpr(StyleBox b, MathCursor c) {
        int v = StyleSheet.MathTerm(b, c);
        while (c.pos < c.toks.Count) {
            string op = c.toks[c.pos];
            if (op != "+" && op != "-") { break; }
            c.pos = c.pos + 1;
            int r = StyleSheet.MathTerm(b, c);
            v = op == "+" ? v + r : v - r;
        }
        return v;
    }

    /// 乘除层：factor (('*'|'/') factor)*。除零按 0（坏表达式不炸）。
    static int MathTerm(StyleBox b, MathCursor c) {
        int v = StyleSheet.MathFactor(b, c);
        while (c.pos < c.toks.Count) {
            string op = c.toks[c.pos];
            if (op != "*" && op != "/") { break; }
            c.pos = c.pos + 1;
            int r = StyleSheet.MathFactor(b, c);
            if (op == "*") { v = v * r; }
            else { v = r == 0 ? 0 : v / r; }
        }
        return v;
    }

    /// 因子层：括号表达式 / 一元符号 / 数字+单位。
    static int MathFactor(StyleBox b, MathCursor c) {
        if (c.pos >= c.toks.Count) { return 0; }
        string tok = c.toks[c.pos];
        if (tok == "(") {
            c.pos = c.pos + 1;
            int v = StyleSheet.MathExpr(b, c);
            if (c.pos < c.toks.Count && c.toks[c.pos] == ")") { c.pos = c.pos + 1; }
            return v;
        }
        if (tok == "-") {
            c.pos = c.pos + 1;
            return 0 - StyleSheet.MathFactor(b, c);
        }
        if (tok == "+") {
            c.pos = c.pos + 1;
            return StyleSheet.MathFactor(b, c);
        }
        c.pos = c.pos + 1;
        return StyleSheet.UnitPx(b, tok);
    }

    /// 值转整数（透传 Num 解析）。
    static int ParseInt(string s) {
        return StyleSheet.Num(s);
    }

    /// 将值按空白拆分为 token，保持 `fn(a, b)`
    /// 分组完整，使 `rgba(0,0,0,.4)` 作为一个 token 保留。
    static List<string> Tokens(string val) {
        List<string> outp = new List<string>();
        string cur = "";
        int depth = 0;
        int i = 0;
        while (i < val.Length) {
            string ch = val.Substring(i, 1);
            i = i + 1;
            if (ch == "(") { depth = depth + 1; cur = cur + ch; continue; }
            if (ch == ")") { depth = depth - 1; cur = cur + ch; continue; }
            if (depth == 0 && Css.Space(ch)) {
                if (cur != "") { outp.Add(cur); }
                cur = "";
                continue;
            }
            cur = cur + ch;
        }
        if (cur != "") { outp.Add(cur); }
        return outp;
    }

    /// s 是否以 prefix 开头。
    static bool StartsWith(string s, string prefix) {
        if (s.Length < prefix.Length) { return false; }
        return s.Substring(0, prefix.Length) == prefix;
    }

    /// 子串首次出现位置（无则 -1，转发 Css.IndexFrom）。
    static int IndexOf(string s, string ch) {
        return Css.IndexFrom(s, ch, 0);
    }

    /// s 是否以 suffix 结尾。
    static bool EndsWith(string s, string suffix) {
        if (s.Length < suffix.Length) { return false; }
        return s.Substring(s.Length - suffix.Length, suffix.Length) == suffix;
    }

    /// 单字符查找（`ch` 只取首字符）。
    static int LastIndexOf(string s, string ch) {
        int found = -1;
        for (int i = 0; i < s.Length; i = i + 1) {
            if (s.Substring(i, 1) == ch) { found = i; }
        }
        return found;
    }

    /// 转小写（属性名/关键字匹配用）。
    static string Lower(string s) {
        return s.ToLower();
    }

    /// 转发 Css.Trim（去两端空白）。
    static string Trim(string s) {
        return Css.Trim(s);
    }

    /// 把停靠名（`top`/`bottom`/`left`/`right`/`fill`）解析为
    /// Dock 常量。供样式表 / JSON 文档共用。
    static int DockValue(string text) {
        if (text == "top" || text == "Top") { return Dock.Top(); }
        if (text == "bottom" || text == "Bottom") { return Dock.Bottom(); }
        if (text == "left" || text == "Left") { return Dock.Left(); }
        if (text == "right" || text == "Right") { return Dock.Right(); }
        if (text == "fill" || text == "Fill") { return Dock.Fill(); }
        return Dock.Manual();
    }

    /// 把标量 JSON 值渲染为 SetProp 期望的文本。
    static string Scalar(JsonValue v) {
        if (v.IsString()) { return v.AsString(""); }
        if (v.IsNumber()) { return v.AsString(""); }
        if (v.IsBool()) { if (v.AsBool(false)) { return "true"; } return "false"; }
        return "";
    }
}

/// calc()/min()/max()/clamp() 求值游标：token 表 + 当前位置。
/// MathExpr/MathTerm/MathFactor 递归下降时推进 pos。
class MathCursor {
    List<string> toks;
    int pos;
}
