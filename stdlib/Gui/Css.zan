using System;
using System.Json;

namespace Gui;

/// 一个小型 CSS 解析器：把以真实 CSS 文本编写的皮肤样式表转换成
/// StyleSheet 已能应用的 选择器 -> 声明 映射。
///
/// 皮肤过去是 Zan 代码（每个皮肤一个 Theme 预设），因此任何超出
/// 调色板交换的东西——控件形状、渐变、阴影、各状态外观——都意味着
/// 要改控件代码。现在皮肤是放在美术资源旁的 `.css` 文件，
/// GUI 在运行时加载，用户可以重新设计应用外观（或自带皮肤），
/// 而无需改动或重新构建任何代码：
///
///   :root { --accent: #d92b2b; --radius: 999; }
///   button.primary        { background: linear-gradient(#ffd76a, #e0a020);
///                           radius: var(--radius); border: 1 #8a5b12; }
///   button.primary:hover  { background: #ffe08a; }
///   tab.item:active       { border-bottom: 2 var(--accent); }
///
/// 有目的地支持（仅此而已，无更多级联）：声明块、选择器
/// 列表（`a, b { }`）、`:state` 后缀、`/* 注释 */` 以及 `:root`
/// 中以 `var(--name)` 引用的自定义属性。其余一律解析为
/// 普通属性，由 StyleSheet/控件决定其含义。
class Css {
    /// 把 `src` 解析为样式表，选择器保留其 `:state` 后缀。
    /// 格式错误的文档会产出所有干净解析出的部分，一条坏规则
    /// 不会毁掉整个皮肤。
    static StyleSheet Parse(string src) {
        return Css.ParseWith(src, null, null);
    }

    /// 同 Parse，但额外认得 `extraNames`/`extraVals` 里的自定义属性
    /// （当前皮肤的 `:root` 变量与主题 token）：应用自己的 CSS 里
    /// 写 `var(--accent)`、`var(--bg-primary)` 因此能解析到当前皮肤/
    /// 主题（以前展开为空，因为只看得见同一份源文本里的变量）。
    /// 外来变量只参与展开，不会写进结果表的 vars：sheet.vars 仍然
    /// 只代表这份 CSS 自己声明了什么（Skin.ThemeOf 按它推导主题，
    /// 掺进主题 token 就成了自我喂养）。同名时本身的变量胜出。
    static StyleSheet ParseWith(string src, List<string> extraNames,
                                List<string> extraVals) {
        StyleSheet sheet = new StyleSheet();
        string s = Css.StripComments(src);
        // 第 1 遍：`:root` 自定义属性，便于值引用它们。
        List<string> ownNames = new List<string>();
        List<string> ownVals = new List<string>();
        Css.CollectVars(s, ownNames, ownVals);
        // 展开用的名单：外来变量在前、本身变量在后（ExpandVars 取
        // 最后一个同名命中，因此这份 CSS 自己的声明覆盖皮肤/主题）。
        List<string> varNames = new List<string>();
        List<string> varVals = new List<string>();
        if (extraNames != null && extraVals != null) {
            int ei = 0;
            while (ei < extraNames.Count && ei < extraVals.Count) {
                varNames.Add(extraNames[ei]);
                varVals.Add(extraVals[ei]);
                ei = ei + 1;
            }
        }
        for (int vi = 0; vi < ownNames.Count; vi = vi + 1) {
            sheet.vars.Set(ownNames[vi], JsonValue.NewStr(ownVals[vi]));
            varNames.Add(ownNames[vi]);
            varVals.Add(ownVals[vi]);
        }
        // 第 2 遍：所有规则块。
        int i = 0;
        while (i < s.Length) {
            int open = Css.IndexFrom(s, "{", i);
            if (open < 0) { break; }
            int close = Css.IndexFrom(s, "}", open + 1);
            if (close < 0) { break; }
            string selectors = Css.Trim(s.Substring(i, open - i));
            string body = s.Substring(open + 1, close - open - 1);
            i = close + 1;
            if (selectors.Length == 0) { continue; }
            List<string> sels = Css.SplitTrim(selectors, ",");
            JsonValue block = Css.ParseBlock(body, varNames, varVals);
            if (block.Count() == 0) { continue; }
            int k = 0;
            while (k < sels.Count) {
                string sel = sels[k];
                k = k + 1;
                if (sel.Length == 0) { continue; }
                if (sel == ":root") { continue; }
                Css.MergeInto(sheet, sel, block);
            }
        }
        return sheet;
    }

    /// 单个块的声明，`var(--x)` 已解析，自定义
    /// 属性被丢弃（它们只用于被引用）。
    static JsonValue ParseBlock(string body, List<string> varNames,
                                List<string> varVals) {
        JsonValue block = JsonValue.NewObject();
        List<string> decls = Css.SplitTrim(body, ";");
        int i = 0;
        while (i < decls.Count) {
            string d = decls[i];
            i = i + 1;
            if (d.Length == 0) { continue; }
            int colon = Css.IndexFrom(d, ":", 0);
            if (colon <= 0) { continue; }
            string key = Css.Trim(d.Substring(0, colon));
            string val = Css.Trim(d.Substring(colon + 1, d.Length - colon - 1));
            if (key.Length == 0 || val.Length == 0) { continue; }
            if (key.Length > 2 && key.Substring(0, 2) == "--") { continue; }
            block.Set(Css.Lower(key),
                      JsonValue.NewStr(Css.StripImportant(
                          Css.ExpandVars(val, varNames, varVals))));
        }
        return block;
    }

    /// 去掉结尾的 `!important`（此处的级联本就是"后规则
    /// 胜出"，因此该标志没有额外含义）。
    static string StripImportant(string val) {
        int at = Css.IndexFrom(Css.Lower(val), "!important", 0);
        if (at < 0) { return val; }
        return Css.Trim(val.Substring(0, at));
    }

    /// 把属性名/关键字转小写（选择器保留大小写，因此 `#Save`
    /// 仍能匹配名为 `Save` 的控件）。
    static string Lower(string s) {
        return s.ToLower();
    }

    /// 把 `block` 的声明加入 `sel`，保留同一选择器早先规则
    /// 已设置的声明（与 CSS 一样，后规则胜出）。
    static void MergeInto(StyleSheet sheet, string sel, JsonValue block) {
        JsonValue existing = sheet.rules.Get(sel);
        if (existing == null || !existing.IsObject()) {
            JsonValue copy = JsonValue.NewObject();
            for (int i = 0; i < block.Count(); i = i + 1) {
                copy.Set(block.KeyAt(i), block.ValAt(i));
            }
            sheet.rules.Set(sel, copy);
            return;
        }
        for (int j = 0; j < block.Count(); j = j + 1) {
            existing.Set(block.KeyAt(j), block.ValAt(j));
        }
    }

    /// 从每个 `:root` 块中读取 `--name: value` 对。
    static void CollectVars(string s, List<string> names, List<string> vals) {
        int i = 0;
        while (i < s.Length) {
            int open = Css.IndexFrom(s, "{", i);
            if (open < 0) { return; }
            int close = Css.IndexFrom(s, "}", open + 1);
            if (close < 0) { return; }
            string sel = Css.Trim(s.Substring(i, open - i));
            string body = s.Substring(open + 1, close - open - 1);
            i = close + 1;
            if (sel != ":root") { continue; }
            List<string> decls = Css.SplitTrim(body, ";");
            int k = 0;
            while (k < decls.Count) {
                string d = decls[k];
                k = k + 1;
                int colon = Css.IndexFrom(d, ":", 0);
                if (colon <= 0) { continue; }
                string key = Css.Trim(d.Substring(0, colon));
                if (key.Length <= 2 || key.Substring(0, 2) != "--") { continue; }
                names.Add(key);
                vals.Add(Css.Trim(d.Substring(colon + 1, d.Length - colon - 1)));
            }
        }
    }

    /// 替换 `val` 中的每个 `var(--name)`；未知名称展开为 ""。
    static string ExpandVars(string val, List<string> names, List<string> vals) {
        string s = val;
        for (int guard = 0; guard < 8; guard = guard + 1) {
            int at = Css.IndexFrom(s, "var(", 0);
            if (at < 0) { return s; }
            int close = Css.IndexFrom(s, ")", at);
            if (close < 0) { return s; }
            string name = Css.Trim(s.Substring(at + 4, close - at - 4));
            string rep = "";
            for (int i = 0; i < names.Count; i = i + 1) {
                if (names[i] == name) { rep = vals[i]; }
            }
            s = s.Substring(0, at) + rep + s.Substring(close + 1, s.Length - close - 1);
        }
        return s;
    }

    /// 删除 `/* ... */` 注释（逐片处理，大样式表只需一趟
    /// 而非每字符一个字符串）。
    static string StripComments(string src) {
        string outp = "";
        int i = 0;
        while (i < src.Length) {
            int open = Css.IndexFrom(src, "/*", i);
            if (open < 0) {
                return outp + src.Substring(i, src.Length - i);
            }
            outp = outp + src.Substring(i, open - i);
            int end = Css.IndexFrom(src, "*/", open + 2);
            if (end < 0) { return outp; }
            i = end + 2;
        }
        return outp;
    }

    /// 按 `sep` 拆分并修剪每部分（空白和换行）。
    static List<string> SplitTrim(string s, string sep) {
        List<string> outp = new List<string>();
        List<string> parts = s.Split(sep);
        for (int i = 0; i < parts.Count; i = i + 1) {
            outp.Add(Css.Trim(parts[i]));
        }
        return outp;
    }

    /// 按顶层 `sep`（单字符）拆分并修剪每部分：括号内的分隔符
    /// 不拆，因此 `linear-gradient(90deg, rgba(0,0,0,.5), #fff)` 的
    /// 函数式颜色停靠点会作为整体保留。
    static List<string> SplitTopTrim(string s, string sep) {
        List<string> outp = new List<string>();
        int depth = 0;
        int start = 0;
        for (int i = 0; i < s.Length; i = i + 1) {
            string ch = s.Substring(i, 1);
            if (ch == "(") { depth = depth + 1; }
            else if (ch == ")") { if (depth > 0) { depth = depth - 1; } }
            else if (ch == sep && depth == 0) {
                outp.Add(Css.Trim(s.Substring(start, i - start)));
                start = i + 1;
            }
        }
        outp.Add(Css.Trim(s.Substring(start, s.Length - start)));
        return outp;
    }

    static int IndexFrom(string s, string needle, int start) {
        int from = start;
        if (from < 0) { from = 0; }
        if (from > s.Length) { return -1; }
        int at = s.Substring(from, s.Length - from).IndexOf(needle);
        if (at < 0) { return -1; }
        return from + at;
    }

    static bool Space(string ch) {
        return ch == " " || ch == "\t" || ch == "\r" || ch == "\n";
    }

    static string Trim(string s) {
        int a = 0;
        int b = s.Length;
        for (; a < b && Css.Space(s.Substring(a, 1)); a = a + 1) { }
        while (b > a && Css.Space(s.Substring(b - 1, 1))) { b = b - 1; }
        return s.Substring(a, b - a);
    }
}

/// 一个已解析的选择器：把 `button.ghost.primary::icon:hover` 拆成类型名、
/// 其类链、可选的 id、可选的 `::part` 和可选的
/// `:state`。这就是引擎建模的全部选择器语法——足以用 CSS 描述
/// 组件的完整外观（其部件和状态），而且
/// 足够小，匹配保持为一次表扫描。
class Selector {
    string type;
    string classes;   // 以空格分隔，无类时为 ""
    string id;
    string part;
    string state;

    /// 解析一个选择器；遇到本引擎不建模的形式（后代/子组合器、
    /// 属性选择器、`:root`）时返回 null，
    /// 这类选择器永远不会匹配。
    static Selector Parse(string sel) {
        string s = Css.Trim(sel);
        if (s == "" || s == ":root") { return null; }
        Selector p = new Selector();
        p.type = "";
        p.classes = "";
        p.id = "";
        p.part = "";
        p.state = "";
        int i = 0;
        int n = s.Length;
        for (; i < n && Selector.NameChar(s.Substring(i, 1)); i = i + 1) {
            p.type = p.type + s.Substring(i, 1);
        }
        while (i < n) {
            string ch = s.Substring(i, 1);
            int start = i + 1;
            bool isPart = false;
            if (ch == ":" && i + 1 < n && s.Substring(i + 1, 1) == ":") {
                start = i + 2;
                isPart = true;
            } else if (ch != "." && ch != "#" && ch != ":") {
                return null;
            }
            int j = start;
            string name = "";
            while (j < n && Selector.NameChar(s.Substring(j, 1))) {
                name = name + s.Substring(j, 1);
                j = j + 1;
            }
            if (name == "") { return null; }
            if (ch == ".") {
                if (p.classes == "") { p.classes = name; }
                else { p.classes = p.classes + " " + name; }
            } else if (ch == "#") {
                p.id = name;
            } else if (isPart) {
                p.part = name;
            } else {
                p.state = name;
            }
            i = j;
        }
        return p;
    }

    /// 此选择器在级联中的权重。伪状态高于
    /// 其他一切，因此无论作者写在哪里，`:hover` 都叠加在基础外观之上；
    /// 其下按 CSS 顺序：type <
    /// class < 类链 < id。
    int Specificity() {
        int spec = 0;
        if (type != "") { spec = spec + 1; }
        spec = spec + Style.Classes(classes).Count * 100;
        if (id != "") { spec = spec + 10000; }
        if (state != "") { spec = spec + 1000000; }
        return spec;
    }

    /// 可作为类型/类/id/部件名称字符时为 true。
    static bool NameChar(string ch) {
        if (ch == "." || ch == "#" || ch == ":" || ch == "*") { return false; }
        if (ch == "," || ch == ">" || ch == "+" || ch == "~" || ch == "[") {
            return false;
        }
        return !Css.Space(ch);
    }
}
