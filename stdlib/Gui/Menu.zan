using System;
using System.Threading;

namespace Gui;

/// <summary>
/// 富上下文菜单的一个条目（参见 <see cref="OverlayPopup.RichMenu"/>）。
/// `kind`：0 = 可点击项，1 = 分隔线，2 = 分组标题，3 = 子菜单
/// 父项（悬停时其 `children` 在侧面板中展开）。`action` 是
/// 选择叶子项时写回调用方结果信号的值。
/// </summary>
class MenuItem {
    int kind;
    string label;
    string icon;
    string shortcut;
    /// 稳定标识（Gui.Widget.Menu v2 的选中/展开 key）；空串时菜单退化为用 label 当 key。上下文菜单忽略本字段。
    string key;
    int action;
    bool disabled;
    bool danger;
    List<MenuItem> children;

    /// 可点击项工厂（各静态构造的公共底座）。
    static MenuItem Item(string label, string icon, int action) {
        MenuItem m = new MenuItem();
        m.kind = 0;
        m.label = label;
        m.icon = icon;
        m.shortcut = "";
        m.key = "";
        m.action = action;
        m.disabled = false;
        m.danger = false;
        m.children = new List<MenuItem>();
        return m;
    }

    /// 带快捷键提示的可点击项。
    static MenuItem Shortcut(string label, string icon, string sc, int action) {
        MenuItem m = MenuItem.Item(label, icon, action);
        m.shortcut = sc;
        return m;
    }

    /// 置灰不可点项。
    static MenuItem Disabled(string label, string icon, int action) {
        MenuItem m = MenuItem.Item(label, icon, action);
        m.disabled = true;
        return m;
    }

    /// 危险操作项（红色）。
    static MenuItem Danger(string label, string icon, int action) {
        MenuItem m = MenuItem.Item(label, icon, action);
        m.danger = true;
        return m;
    }

    /// 危险操作项 + 快捷键提示。
    static MenuItem DangerShortcut(string label, string icon, string sc,
                                   int action) {
        MenuItem m = MenuItem.Danger(label, icon, action);
        m.shortcut = sc;
        return m;
    }

    /// 分隔线（kind=1）。
    static MenuItem Separator() {
        MenuItem m = new MenuItem();
        m.kind = 1;
        m.label = "";
        m.icon = "";
        m.shortcut = "";
        m.key = "";
        m.action = 0 - 1;
        m.disabled = false;
        m.danger = false;
        m.children = new List<MenuItem>();
        return m;
    }

    /// 分组标题（kind=2，不可点）。
    static MenuItem Header(string label) {
        MenuItem m = new MenuItem();
        m.kind = 2;
        m.label = label;
        m.icon = "";
        m.shortcut = "";
        m.key = "";
        m.action = 0 - 1;
        m.disabled = false;
        m.danger = false;
        m.children = new List<MenuItem>();
        return m;
    }

    /// 子菜单（kind=3，悬停时在侧面板展开 children）。
    static MenuItem Submenu(string label, string icon, List<MenuItem> children) {
        MenuItem m = new MenuItem();
        m.kind = 3;
        m.label = label;
        m.icon = icon;
        m.shortcut = "";
        m.key = "";
        m.action = 0 - 1;
        m.disabled = false;
        m.danger = false;
        m.children = children;
        return m;
    }
}
