    /// 表内图标个数。
    static int Count() {
        IconSvgData.Ensure();
        return names.Count;
    }

    /// 全部图标名(升序)。供画廊、文档工具枚举。
    static List<string> Names() {
        IconSvgData.Ensure();
        return names;
    }

    /// 二分查找图标名,未命中返回 -1。
    static int IndexOf(string name) {
        IconSvgData.Ensure();
        int lo = 0;
        int hi = names.Count - 1;
        while (lo <= hi) {
            int mid = (lo + hi) / 2;
            int cmp = name.CompareTo(names[mid]);
            if (cmp == 0) { return mid; }
            if (cmp < 0) { hi = mid - 1; }
            else { lo = mid + 1; }
        }
        return -1;
    }

    /// 按下标取 SVG body(不含 <svg> 外壳)。
    static string Body(int index) {
        IconSvgData.Ensure();
        return bodies[index];
    }
}
