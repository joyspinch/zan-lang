using System;
using System.Threading;

namespace Gui;

/// 一个命中矩形：控件 id、屏幕矩形与控件类型
/// （widgetType == -1 表示阻挡区，见 HitTester.blockers）。
class HitRegion {
    int id;
    int x;
    int y;
    int width;
    int height;
    int widgetType;

    HitRegion(int id, int x, int y, int w, int h, int wtype) {
        this.id = id;
        this.x = x;
        this.y = y;
        this.width = w;
        this.height = h;
        this.widgetType = wtype;
    }

    /// 点 (px, py) 是否落在矩形内（左闭右开）。
    bool Contains(int px, int py) {
        if (px < x) { return false; }
        if (px >= x + width) { return false; }
        if (py < y) { return false; }
        if (py >= y + height) { return false; }
        return true;
    }

    /// 就地改写（供 HitTester 复用池中的对象）。
    void Set(int id, int x, int y, int w, int h, int wtype) {
        this.id = id;
        this.x = x;
        this.y = y;
        this.width = w;
        this.height = h;
        this.widgetType = wtype;
    }
}

/// 每帧命中区注册表：控件渲染时登记矩形，鼠标/触摸事件据此
/// 解析目标。附带阻挡区（模态遮罩）、事件锚点（按下/点击的
/// 跨帧目标重绑定）与整帧快照（条带帧的事件解析基准）。
class HitTester {
    List<HitRegion> regions;
    // 阻挡区域（widgetType == -1，通过 App.BlockHitsRect 注册），
    // 会吞掉矩形下方空间内的所有控件。`blockers` 累积
    // 本帧的阻挡区域；`prevBlockers` 是上一帧的集合。页面内容
    // 在本帧覆盖层注册之前渲染，因此必须查询
    // `prevBlockers` 以判断自己位于模态框/弹出层/浮动窗口之下；而
    // 阻挡层自身的内容在铺设遮罩之后渲染，因此读取 `blockers`
    // 来确认自己位于阻挡之上并保持可用。
    List<HitRegion> blockers;
    List<HitRegion> prevBlockers;
    // 命中区对象池。每帧每个控件注册一个命中区，一个稠密
    // 界面一秒就要新建上万个 HitRegion；池化后只在控件数
    // 创新高时才分配。两个池交替使用，因为 prevBlockers 还
    // 引用着上一帧的对象，不能被本帧就地改写。
    List<HitRegion> poolA;
    List<HitRegion> poolB;
    bool useA;
    int used;

    // 目标锚点（0 按下、1 点击、2 右键按下、3 右键点击）。鼠标事件
    // 在上一帧的命中区上解析出目标，而控件要到下一帧渲染时才去对比
    // 自己的 id。控件 id 是即时模式的分配序号，只要中间多出或少掉
    // 一个控件（典型如右键菜单开/关），其后所有 id 都会整体平移，
    // 于是上一帧解析出的 id 在本帧落到了另一个控件上——这就是
    // “开过右键菜单后信号乱串”的根源。矩形来自布局，不随 id 平移，
    // 因此锚点同时记住命中区的矩形；本帧哪个控件注册到同一个矩形，
    // 哪个才是真正的目标，注册时就地把锚点 id 改写过去。
    List<int> anchorId;
    List<int> anchorX;
    List<int> anchorY;
    List<int> anchorW;
    List<int> anchorH;
    List<int> anchorType;
    List<int> anchorSet;

    // 事件解析基准：最近一个完整帧的命中区快照。局部帧只渲染损伤
    // 条带，条带外的控件本帧不注册命中区；若事件按「上一帧」解析，
    // 上一帧恰好是条带帧时，条带外的点击会全部扑空（表现为点击
    // 无响应/迟钝）。条带裁剪的前提是条带外像素与控件均未变化，
    // 所以最近一次整帧的命中区对条带外依然正确——整帧结束时由
    // App 拷贝一份（KeepFullSnapshot）作为解析基准。
    List<int> snapId;
    List<int> snapX;
    List<int> snapY;
    List<int> snapW;
    List<int> snapH;
    List<int> snapType;
    int snapUsed;

    HitTester() {
        poolA = new List<HitRegion>();
        poolB = new List<HitRegion>();
        useA = true;
        used = 0;
        regions = poolA;
        blockers = new List<HitRegion>();
        prevBlockers = new List<HitRegion>();
        anchorId = new List<int>{ -1, -1, -1, -1 };
        anchorX = new List<int>{ 0, 0, 0, 0 };
        anchorY = new List<int>{ 0, 0, 0, 0 };
        anchorW = new List<int>{ 0, 0, 0, 0 };
        anchorH = new List<int>{ 0, 0, 0, 0 };
        anchorType = new List<int>{ 0, 0, 0, 0 };
        anchorSet = new List<int>{ 0, 0, 0, 0 };
        snapId = new List<int>();
        snapX = new List<int>();
        snapY = new List<int>();
        snapW = new List<int>();
        snapH = new List<int>();
        snapType = new List<int>();
        snapUsed = 0;
    }

    /// 整帧（非条带帧）渲染结束时调用：把当前命中区拷贝为事件
    /// 解析的基准。regions 是复用池，对象会被下一帧就地改写，因此
    /// 必须按值拷贝（AnchorAt 只用到这六个 int）。
    void KeepFullSnapshot() {
        int n = used;
        snapId.Clear();
        snapX.Clear();
        snapY.Clear();
        snapW.Clear();
        snapH.Clear();
        snapType.Clear();
        for (int i = 0; i < n; i = i + 1) {
            HitRegion r = regions[i];
            snapId.Add(r.id);
            snapX.Add(r.x);
            snapY.Add(r.y);
            snapW.Add(r.width);
            snapH.Add(r.height);
            snapType.Add(r.widgetType);
        }
        snapUsed = n;
    }

    /// 开启新的一帧：当前阻挡区转为 prevBlockers，切换到另一个
    /// 复用池并把已用计数清零（上一帧对象留待就地改写）。
    void Clear() {
        prevBlockers = blockers;
        blockers = new List<HitRegion>();
        useA = !useA;
        if (useA) { regions = poolA; } else { regions = poolB; }
        used = 0;
    }

    /// 在最近一个完整帧的命中区快照上解析 (px, py) 的目标并记入
    /// 锚点 `k`；`below` 为真时跳过阻挡区，解析其下方的控件（右键用）。
    int AnchorAt(int k, int px, int py, bool below) {
        int i = snapUsed - 1;
        while (i >= 0) {
            int wtype = snapType[i];
            bool skip = below && wtype == -1;
            if (!skip && px >= snapX[i] && px < snapX[i] + snapW[i]
                && py >= snapY[i] && py < snapY[i] + snapH[i]) {
                anchorId[k] = snapId[i];
                anchorX[k] = snapX[i];
                anchorY[k] = snapY[i];
                anchorW[k] = snapW[i];
                anchorH[k] = snapH[i];
                anchorType[k] = wtype;
                anchorSet[k] = 1;
                return snapId[i];
            }
            i = i - 1;
        }
        this.ClearAnchor(k);
        return -1;
    }

    /// 作废锚点 `k`（id 复位为 -1）。
    void ClearAnchor(int k) {
        anchorId[k] = -1;
        anchorSet[k] = 0;
    }

    /// 锚点 `k` 当前对应的控件 id（本帧已按矩形改写过）。
    int AnchorIdOf(int k) { return anchorId[k]; }

    /// 本帧已注册的命中区数量（`regions` 是复用池，末尾
    /// 可能残留上一帧的对象，遍历要以此为界）。
    int RegionCount() { return used; }
    /// 第 i 个已注册的命中区（i < RegionCount()）。
    HitRegion RegionAt(int i) { return regions[i]; }

    /// 注册一个命中区，复用池中的对象（首选形式：不分配）。
    void RegisterRect(int id, int x, int y, int w, int h, int wtype) {
        HitRegion r;
        if (used < regions.Count) {
            r = regions[used];
            r.Set(id, x, y, w, h, wtype);
        } else {
            r = new HitRegion(id, x, y, w, h, wtype);
            regions.Add(r);
        }
        used = used + 1;
        if (wtype == -1) { blockers.Add(r); }
        // 锚点重绑定必须取「最后一个」匹配而非首匹配：命中区按
        // 绘制次序注册（底层先、顶层后），AnchorAt 也按最顶层优先
        // 解析。孪生矩形——gallery 级联窗口开到第 7 个与第 1 个完全
        // 重合、photos 遮罩叠在对话框遮罩上（同 (0,0,W,H)）——按
        // 首匹配会让按住/点击目标被下层的孪生控件抢走，顶层窗口
        // 的按钮/拖动全部失效。持续扫到最后一个匹配，与一次全新
        // AnchorAt 在同一点上的解析结果一致。
        for (int k = 0; k < 4; k = k + 1) {
            if (anchorSet[k] == 1
                && anchorType[k] == wtype
                && anchorX[k] == x && anchorY[k] == y
                && anchorW[k] == w && anchorH[k] == h) {
                anchorId[k] = id;
            }
        }
    }

    void Register(HitRegion region) {
        this.RegisterRect(region.id, region.x, region.y,
            region.width, region.height, region.widgetType);
    }

    /// 当本帧已注册的阻挡层覆盖该点时返回 true——即
    /// 查询方表面已铺设自己的遮罩，正处于阻挡层
    /// 主体（阻挡之上），而非其下方的内容。
    bool BlockerAt(int px, int py) {
        int i = blockers.Count - 1;
        while (i >= 0) {
            if (blockers[i].Contains(px, py)) { return true; }
            i = i - 1;
        }
        return false;
    }

    /// 当上一帧的阻挡层覆盖该点时返回 true。供
    /// 页面内容（在本帧覆盖层注册前渲染）
    /// 判断自身是否位于模态框/弹出层/浮动窗口之下。
    bool PrevBlockerAt(int px, int py) {
        int i = prevBlockers.Count - 1;
        while (i >= 0) {
            if (prevBlockers[i].Contains(px, py)) { return true; }
            i = i - 1;
        }
        return false;
    }

    /// 本帧命中区中最顶层（最后注册）覆盖 (px, py) 的控件 id，
    /// 无命中时 -1。
    int HitTest(int px, int py) {
        int i = used - 1;
        while (i >= 0) {
            HitRegion r = regions[i];
            if (r.Contains(px, py)) {
                return r.id;
            }
            i = i - 1;
        }
        return -1;
    }

    /// 与 HitTest 相同，但跳过阻挡区域，返回其**下方**的控件。
    /// 供右键使用：上下文菜单打开时它的遮罩会吞掉一切，于是
    /// 在别处右键什么也不会发生（必须先关掉菜单）；右键改为
    /// 解析到遮罩下的控件后，菜单就直接换到新位置重开。
    int HitTestBelowBlockers(int px, int py) {
        int i = used - 1;
        while (i >= 0) {
            HitRegion r = regions[i];
            if (r.widgetType != -1 && r.Contains(px, py)) {
                return r.id;
            }
            i = i - 1;
        }
        return -1;
    }

    /// 与 HitTestBelowBlockers 相同，但只匹配 `from` 下标**之后**
    /// 注册的区域（跳过阻挡区）。弹层在覆盖阶段用它识别「自己
    /// 内部注册的控件」——内嵌滚动条、搜索框等，它们在弹层
    /// blocker 之后才注册；而不带基线时，弹层正下方的内容控件
    /// 早在内容帧就注册在前，会被误当成弹层内部控件，令弹层把
    /// 本该选中选项的释放点击整个吞掉（SelectBox 弹层盖住滑杆/
    /// 输入框/表格行时选项选不中）。
    int HitTestFrom(int px, int py, int from) {
        int i = used - 1;
        while (i >= from) {
            HitRegion r = regions[i];
            if (r.widgetType != -1 && r.Contains(px, py)) {
                return r.id;
            }
            i = i - 1;
        }
        return -1;
    }

    /// 上一帧为 `id` 注册的区域，以扁平的 [x,y,w,h] 列表表示；
    /// 若该 id 未拥有区域则为 null。让框架只重绘
    /// 状态变化的控件，而不是整个窗口。
    List<int> RectOf(int id) {
        if (id < 0) { return null; }
        for (int i = 0; i < used; i = i + 1) {
            HitRegion r = regions[i];
            if (r.id == id) {
                List<int> box = new List<int>{
                    r.x,
                    r.y,
                    r.width,
                    r.height };
                return box;
            }
        }
        return null;
    }

    /// id 注册的控件类型（HitRegion.widgetType），未注册时 -1。
    int GetWidgetType(int id) {
        for (int i = 0; i < used; i = i + 1) {
            if (regions[i].id == id) {
                return regions[i].widgetType;
            }
        }
        return -1;
    }
}

