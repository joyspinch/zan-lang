using System;
using Gui;

namespace Gui.Widget;

/// 窗口状态栏：一行停靠的小文本项，靠左或
/// 靠右对齐，位于带细顶部分隔线的主题表面上。
/// 各项是 Label，文本颜色、省略号和样式与其它控件一样跟随主题；
/// 调用方拥有项文本及其含义。
///
///   StatusBar bar = new StatusBar();
///   int posItem = bar.AddLeft("Ln 1, Col 1");
///   int encItem = bar.AddRight("UTF-8");
///   // 每帧：
///   bar.SetText(posItem, "Ln 12, Col 4");
///   bar.RenderAt(app, 0, y, width, height);
class StatusBar : Control {
    List<Label> items;
    int tintBg;          // 0 = 主题表面，否则为纯色着色

    StatusBar() {
        this.InitControl("statusBar", 2);
        items = new List<Label>();
        tintBg = 0;
    }

    override string Kind() { return "StatusBar"; }

    override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec tint = PropSpec.Color("tint", "Tint");
        tint.num = tintBg;
        ps.Add(tint);
        PropSpec cls = PropSpec.Text("class", "Classes");
        cls.str = Class;
        ps.Add(cls);
        return ps;
    }

    Label NewItem(string text) {
        Label l = new Label { Text = text, Class = "secondary small" };
        items.Add(l);
        Add(l);
        return l;
    }

    /// 追加一个左对齐项；返回其索引供后续更新。
    int AddLeft(string text) {
        Label l = NewItem(text);
        l.DockLeft();
        return items.Count - 1;
    }

    /// 追加一个右对齐项；返回其索引供后续更新。
    int AddRight(string text) {
        Label l = NewItem(text);
        l.DockRight();
        return items.Count - 1;
    }

    void SetText(int index, string text) {
        if (index < 0 || index >= items.Count) { return; }
        items[index].Text = text;
    }

    void SetColor(int index, int color) {
        if (index < 0 || index >= items.Count) { return; }
        items[index].TextColor(color);
    }

    /// 纯色背景着色，替换默认表面（0 恢复默认），
    /// 用于宿主想在整个状态栏传达某种模式时。
    void SetTint(int bg) { tintBg = bg; }

    override void OnMeasure(App app) {
        Theme t = app.theme;
        padL = app.Scale(8);
        padR = app.Scale(10);
        padT = 0;
        padB = 0;
        gap = app.Scale(14);
        prefH = app.Scale(22);
        // CSS 表面：基础 PaintStyleBox 在 OnPaint 运行前填充此处。
        // 从上到下的微妙渐变给状态栏一点层次感。
        if (tintBg != 0) {
            this.Bg(tintBg);
        } else {
            int botc = App.Darken(t.bgSecondary, 60);
            this.Gradient(t.bgSecondary, botc);
        }
    }

    override void OnPaint(App app) {
        // 只有顶部细线分隔线是内容；表面填充由
        // 基础 CSS 样式层处理（styleBg 在 OnMeasure 中设置）。
        app.canvas.FillRect(bx, by, bw,
            Style.Of(app, "divider", "", Style.SNormal()).HeightOr(1),
            Style.Of(app, "divider", "", Style.SNormal()).BgOr(app.theme.divider));
    }

    /// 将状态栏渲染到显式矩形中（供自行管理
    /// 窗口布局的宿主使用）；作为 Control 树的停靠子控件时无需此方法。
    void RenderAt(App app, int x, int y, int w, int h) {
        MeasureTree(app);
        Arrange(x, y, w, h);
        RenderTree(app);
    }
}
