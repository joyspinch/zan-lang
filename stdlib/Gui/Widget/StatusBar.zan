using System;
using Gui;

namespace Gui.Widget;

/// A window status bar: a thin docked row of small text items, aligned to the
/// left or the right, over a themed surface with a hairline top divider.
/// Items are Labels, so text colour, ellipsis and styling follow the theme
/// like every other widget; the caller owns the item texts and their meaning.
///
///   StatusBar bar = StatusBar.Create();
///   int posItem = bar.AddLeft("Ln 1, Col 1");
///   int encItem = bar.AddRight("UTF-8");
///   // each frame:
///   bar.SetText(posItem, "Ln 12, Col 4");
///   bar.RenderAt(app, 0, y, width, height);
class StatusBar : Control {
    List<Label> items;
    int tintBg;          // 0 = the theme surface, otherwise a flat tint

    StatusBar() {
        this.InitControl("statusBar", 2);
        items = new List<Label>();
        tintBg = 0;
    }

    static StatusBar Create() { return new StatusBar(); }

    override string Kind() { return "StatusBar"; }

    Label NewItem(string text) {
        Label l = new Label { Text = text, Class = "secondary small" };
        items.Add(l);
        Add(l);
        return l;
    }

    /// Appends a left-aligned item; returns its index for later updates.
    int AddLeft(string text) {
        Label l = NewItem(text);
        l.DockLeft();
        return items.Count - 1;
    }

    /// Appends a right-aligned item; returns its index for later updates.
    int AddRight(string text) {
        Label l = NewItem(text);
        l.DockRight();
        return items.Count - 1;
    }

    void SetText(int index, string text) {
        if (index < 0 || index >= items.Count) { return; }
        items[index].Text = text;
    }

    void SetColor(int index, int color) {
        if (index < 0 || index >= items.Count) { return; }
        items[index].TextColor(color);
    }

    /// A flat background tint replacing the default surface (0 restores it),
    /// for modes the host wants to signal across the whole bar.
    void SetTint(int bg) { tintBg = bg; }

    override void OnMeasure(App app) {
        Theme t = app.theme;
        padL = app.Scale(8);
        padR = app.Scale(10);
        padT = 0;
        padB = 0;
        gap = app.Scale(14);
        prefH = app.Scale(22);
        // CSS surface: the base PaintStyleBox fills this before OnPaint runs.
        // A subtle top->bottom gradient gives the bar a little depth.
        if (tintBg != 0) {
            this.Bg(tintBg);
        } else {
            int botc = App.LerpColor(t.bgSecondary, 4278190080, 60);
            this.Gradient(t.bgSecondary, botc);
        }
    }

    override void OnPaint(App app) {
        // Only the top hairline divider is content; the surface fill is handled
        // by the base CSS style layer (styleBg set in OnMeasure).
        Divider.Render(app, bx, by, bw);
    }

    /// Renders the bar into an explicit rectangle (hosts that own their own
    /// window layout); as a docked child of a Control tree this is not needed.
    void RenderAt(App app, int x, int y, int w, int h) {
        MeasureTree(app);
        Arrange(x, y, w, h);
        RenderTree(app);
    }
}
