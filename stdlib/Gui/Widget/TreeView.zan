using System;
using Gui;
using Gui.Backend;

namespace Gui.Widget;

/// 树的一个节点，按先序排列。`depth` 是缩进级别（根 = 0）。
/// 目录可展开/折叠；文件是叶节点。`icon` 非空时覆盖
/// 默认文件夹/文件字形。`path` 可选地携带该节点表示的
/// 真实文件系统路径（纯内存树为空）。
/// `checked` 支撑可选的选择复选框列。
class TreeNode {
    /// 节点标题。
    string label;
    /// 缩进级别（根 = 0）。
    int depth;
    /// 是否目录（可展开/折叠；叶节点为 false）。
    bool isDir;
    /// 目录的展开状态。
    bool expanded;
    /// 自定义图标名（"" = 默认文件夹/文件字形）。
    string icon;
    /// 该节点表示的真实文件系统路径（纯内存树为空）。
    string path;
    /// 调用方可选的 payload（例如索引、id），
    /// 节点本身不解释它。
    string payload;
    /// 复选框状态（WithChecks 列的数据来源）。
    bool checked;

    /// 构造目录节点（`expanded` 决定初始展开状态）。
    static TreeNode Dir(string label, int depth, bool expanded) {
        TreeNode n = new TreeNode();
        n.label = label;
        n.depth = depth;
        n.isDir = true;
        n.expanded = expanded;
        n.icon = "";
        n.path = "";
        n.payload = "";
        n.checked = false;
        return n;
    }

    /// 构造叶节点（默认图标）。
    static TreeNode File(string label, int depth) {
        TreeNode n = new TreeNode();
        n.label = label;
        n.depth = depth;
        n.isDir = false;
        n.expanded = false;
        n.icon = "";
        n.path = "";
        n.payload = "";
        n.checked = false;
        return n;
    }

    /// 构造叶节点并指定图标名（覆盖默认文件字形）。
    static TreeNode FileIcon(string label, int depth, string icon) {
        TreeNode n = TreeNode.File(label, depth);
        n.icon = icon;
        return n;
    }

    /// 附带调用方自定义标识（索引、id 等），节点不解释它。
    TreeNode WithPayload(string p) {
        this.payload = p;
        return this;
    }
}

/// 构建节点自身的控件子树，用于行是自定义
/// 组件而非内置字形 + 标签行的树。
delegate Control NodeOf(TreeNode node);

/// <summary>
/// 绑定到调用方自有 `List<TreeNode>` 的可折叠树。与所有
/// 保留式控件一样，它位于控件树中，由 CSS 决定其盒子，调用点
/// 无需计算矩形、跟踪滚动偏移或轮询返回码：
///
///     TreeView files = new TreeView();
///     files.Bind(model.nodes);          // 调用方的列表，不复制
///     files.OnSelect(OpenSelected);
///     files.OnContext(ShowMenu);        // 读取 ContextRow / ContextX / ContextY
///     side.Add(files);
///
/// 节点可以是自己的组件，而不是内置行：
///
///     TreeView tv = new TreeView(n => NodeCard(n));
///
/// 点击目录会切换展开并隐藏其子树；滚轮滚动、
/// overlay 滚动条、可选的内联过滤行和可选的复选框
/// 列都在控件内部处理。处理器被编组到
/// UI 线程（UiEvent.Post），后台任务重建绑定列表
/// 并调用 Refresh() 是安全的。
/// </summary>
class TreeView : Control {
    /// 调用方的节点，每帧读取：修改列表会在
    /// 下一次绘制时体现（自定义节点控件需要重建时调用 Refresh()）。
    List<TreeNode> data;
    /// 焦点/选中行信号（-1 = 无；可经 BindSel 换成共享信号）。
    SignalInt sel;
    /// 垂直滚动偏移。
    SignalInt scroll;
    /// 顶部内联过滤行（WithFilter 挂入；过滤由宿主重绑列表完成）。
    Input filter;
    /// 是否显示复选框列（WithChecks）。
    bool checks;
    /// 多选模式：Ctrl 点击切换行的选中状态，
    /// Shift 点击从焦点行扩展到该行。`marks` 保存
    /// `sel`（焦点行）之外的额外选中行。
    bool multi;
    /// 多选集合（sel 焦点行之外的行号）。
    List<int> marks;
    /// 自定义行模板（null = 内置行）。
    NodeOf tpl;
    /// 自定义行需要重建。
    bool rowsStale;
    /// 上次构建行时的节点数。
    int builtFor;

    /// 处理器运行期间设置：事件涉及的节点，以及
    /// 指针位置，使上下文菜单无需调用点
    /// 读取鼠标状态即可自行锚定。
    int ctxRow;
    int ctxX;
    int ctxY;

    /// 树没有节点时居中显示（"" 不绘制任何内容）。
    string Empty;

    /// 节点被选中时（读取 SelectedIndex / Selected）。
    UiEvent Select;
    /// 节点被双击时（打开 / 运行它）。
    UiEvent Activate;
    /// 目录被展开时。
    UiEvent Expand;
    /// 目录被折叠时。
    UiEvent Collapse;
    /// 节点被右键点击时（读取 ContextRow / ContextX / ContextY）。
    UiEvent Context;
    /// 复选框被切换时（用 ContextRow 读取节点）。
    UiEvent Check;
    /// 行被左键按下时（读取 ContextRow / ContextX / ContextY）。
    /// 供把行当拖拽源的宿主使用，例如设计器工具箱。
    UiEvent Press;
    /// 拖动行改变次序后（读取 MoveFrom / MoveTo）。
    UiEvent Move;

    /// 拖动排序（WithReorder）的状态：按下的行、是否已经拖起来、
    /// 松手时的插入位置，以及本帧是否要吃掉点击（拖完不应该
    /// 顺带选中或展开落点那一行）。
    bool reorder;
    bool pressed;
    int dragRow;
    bool dragging;
    int dropAt;
    bool dropDone;

    /// 公共初始化（各构造共用）。
    void InitTree() {
        this.InitControl("tree", 5);
        data = new List<TreeNode>();
        sel = new SignalInt(0 - 1);
        scroll = new SignalInt(0);
        filter = null;
        checks = false;
        multi = false;
        marks = new List<int>();
        tpl = null;
        rowsStale = true;
        builtFor = 0 - 1;
        ctxRow = 0 - 1;
        ctxX = 0;
        ctxY = 0;
        Empty = "";
        wiresOwnEvents = true;
        Select = new UiEvent();
        Activate = new UiEvent();
        Expand = new UiEvent();
        Collapse = new UiEvent();
        Context = new UiEvent();
        Check = new UiEvent();
        Press = new UiEvent();
        Move = new UiEvent();
        reorder = false;
        pressed = false;
        dragRow = 0 - 1;
        dragging = false;
        dropAt = 0 - 1;
        dropDone = false;
    }

    /// 默认构造：内置行（箭头/图标/标签）。
    TreeView() { InitTree(); }

    /// 自定义行：模板为每个节点构建控件子树。
    TreeView(NodeOf template) {
        InitTree();
        tpl = template;
    }

    override string Kind() { return "TreeView"; }

    override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec chk = PropSpec.Bool("checks", "Checkboxes");
        chk.flag = checks;
        ps.Add(chk);
        PropSpec empty = PropSpec.Text("empty", "Empty text");
        empty.str = Empty;
        ps.Add(empty);
        PropSpec cls = PropSpec.Text("class", "Classes");
        cls.str = Class;
        ps.Add(cls);
        return ps;
    }

    override string StyleType() { return "tree"; }

    // ---- 数据 ---------------------------------------------------------------

    /// 绑定调用方的节点列表；不复制任何内容。
    TreeView Bind(List<TreeNode> nodes) {
        if (nodes == null) { data = new List<TreeNode>(); }
        else { data = nodes; }
        rowsStale = true;
        if (sel.Get() >= data.Count) { sel.Set(0 - 1); }
        int mi = marks.Count - 1;
        while (mi >= 0) {
            if (marks[mi] >= data.Count) { marks.RemoveAt(mi); }
            mi = mi - 1;
        }
        return this;
    }

    /// 标记绑定的节点为已变化，使自定义行在下一帧重建。
    void Refresh() { rowsStale = true; }

    /// 共享调用方的选择信号，供在节点列表重建时
    /// 持久化选择的宿主使用。
    TreeView BindSel(SignalInt s) {
        if (s != null) { sel = s; }
        return this;
    }

    /// 在树顶部绘制内联过滤行，本身不进行过滤：
    /// 宿主在输入变化时重新绑定过滤后的列表。
    TreeView WithFilter(Input f) {
        filter = f;
        return this;
    }

    /// 在每个节点前绘制三态复选框。
    TreeView WithChecks() {
        checks = true;
        return this;
    }

    /// 启用 Ctrl 点击（切换）和 Shift 点击（范围）多选。
    TreeView WithMultiSelect() {
        multi = true;
        return this;
    }

    /// 启用拖动排序：按住一行拖动时画出插入位置，松手后触发
    /// Move。树只报告「哪一行拖到了哪个插入点」，真正的次序由
    /// 宿主在自己的模型上完成（树的节点列表下一帧照常重建）。
    TreeView WithReorder() {
        reorder = true;
        return this;
    }

    /// 被拖动的行。
    int MoveFrom() { return dragRow; }

    /// 插入位置：行要放到这个索引之前；等于 Count() 表示放到末尾。
    int MoveTo() { return dropAt; }

    /// 节点数（含隐藏在折叠目录里的）。
    int Count() { return data.Count; }

    /// 滚到底部；下一帧绘制时会被钳到实际最大偏移。
    void ScrollToEnd() { scroll.Set(1000000000); }

    /// 绑定列表本身，供自行维护节点视图的宿主
    /// 在处理器被触发时使用。
    List<TreeNode> Nodes() { return data; }

    /// `row` 是否在节点列表范围内。
    bool Has(int row) { return row >= 0 && row < data.Count; }

    /// `row` 处的节点；仅在 Has(row) 为真时有效。
    TreeNode NodeAt(int row) { return data[row]; }

    /// 选中行号（-1 = 无选中）。
    int SelectedIndex() { return sel.Get(); }

    /// 是否有一行处于选中状态。
    bool HasSelection() { return this.Has(sel.Get()); }

    /// 选中的节点；仅在 HasSelection() 时有效。
    TreeNode Selected() { return data[sel.Get()]; }

    /// 编程式选中一行，变化时触发 Select。
    void SelectIndex(int row) {
        if (row < 0 - 1 || row >= data.Count) { return; }
        if (sel.Get() == row) { return; }
        sel.Set(row);
        Select.Post();
    }

    /// 清空选中与全部多选标记。
    void ClearSelection() {
        sel.Set(0 - 1);
        marks = new List<int>();
    }

    /// `row` 属于选择集（含焦点行）时返回 true。
    bool IsMarked(int row) {
        if (row < 0) { return false; }
        if (row == sel.Get()) { return true; }
        for (int i = 0; i < marks.Count; i = i + 1) {
            if (marks[i] == row) { return true; }
        }
        return false;
    }

    /// 所有选中行按升序排列（含焦点行）。
    List<int> SelectedIndices() {
        List<int> outp = new List<int>();
        int n = data.Count;
        for (int i = 0; i < n; i = i + 1) {
            if (this.IsMarked(i)) { outp.Add(i); }
        }
        return outp;
    }

    /// 多选中的行数。
    int SelectionCount() { return this.SelectedIndices().Count; }

    /// 处理器回调里读取当前涉及的节点行号；
    /// 仅在 Context/Check/Press 处理器运行期间有效。
    int ContextRow() { return ctxRow; }

    /// 事件发生时的屏幕坐标（配套 ContextRow）。
    int ContextX() { return ctxX; }
    int ContextY() { return ctxY; }

    // ---- 处理器 -----------------------------------------------------------

    /// 某行被选中时回调。
    TreeView OnSelect(Action a) { Select.Add(a); return this; }

    /// 选中行再次被点击时回调。
    TreeView OnActivate(Action a) { Activate.Add(a); return this; }

    /// 目录被展开时回调。
    TreeView OnExpand(Action a) { Expand.Add(a); return this; }

    /// 目录被折叠时回调。
    TreeView OnCollapse(Action a) { Collapse.Add(a); return this; }

    /// 行被右键点击时回调（读取 ContextRow/ContextX/ContextY）。
    TreeView OnContext(Action a) { Context.Add(a); return this; }

    /// 复选框被切换时回调（读取 ContextRow）。
    TreeView OnCheck(Action a) { Check.Add(a); return this; }

    /// 行被左键按下时回调（读取 ContextRow/ContextX/ContextY）。
    TreeView OnPress(Action a) { Press.Add(a); return this; }

    /// 拖动排序完成后回调（读取 MoveFrom/MoveTo）。
    TreeView OnMove(Action a) { Move.Add(a); return this; }

    /// 树为空时显示的文本。
    TreeView EmptyText(string text) { Empty = text; return this; }

    // ---- 展开 / 复选框状态（树拥有自己的模型） -----------

    /// 展开所有目录。
    void ExpandAll() {
        for (int k = 0; k < data.Count; k = k + 1) {
            if (data[k].isDir) { data[k].expanded = true; }
        }
        rowsStale = true;
    }

    /// 折叠所有目录。
    void CollapseAll() {
        for (int k = 0; k < data.Count; k = k + 1) {
            if (data[k].isDir) { data[k].expanded = false; }
        }
        rowsStale = true;
    }

    /// 勾选/取消全部节点（含目录）。
    void SetAllChecked(bool on) {
        for (int k = 0; k < data.Count; k = k + 1) { data[k].checked = on; }
    }

    /// 切换 `row` 行的三态复选框状态（目录联动子节点）。
    void Toggle(int row) {
        if (!this.Has(row)) { return; }
        TreeView.ToggleCheck(data, row);
    }

    /// 所有已勾选节点的索引（含目录）。
    List<int> CheckedIndices() {
        List<int> res = new List<int>();
        for (int k = 0; k < data.Count; k = k + 1) {
            if (data[k].checked) { res.Add(k); }
        }
        return res;
    }

    /// 所有已勾选叶节点的标签。
    List<string> CheckedLabels() {
        List<string> res = new List<string>();
        for (int k = 0; k < data.Count; k = k + 1) {
            if (data[k].checked && !data[k].isDir) { res.Add(data[k].label); }
        }
        return res;
    }

    /// 已勾选叶节点数。
    int CheckedCount() { return this.CheckedLabels().Count; }

    // ---- 内部实现 ----------------------------------------------------------

    /// 是否为模板行模式。
    bool Templated() { return tpl != null; }

    /// 行高：样式 height 优先，否则主题 small。
    int RowHeight(App app) {
        StyleBox s = this.ResolveStyleAs(app, "tree", Class, Style.SNormal());
        return s.HeightOr(app.theme.heightSmall);
    }

    /// 过滤行高度（未挂过滤行时为 0）。
    int FilterHeight(App app) {
        if (filter == null) { return 0; }
        return app.Scale(26);
    }

    /// 没有折叠的祖先隐藏 `row` 时返回 true。
    bool Shown(int row) {
        int d = data[row].depth;
        int j = row - 1;
        while (j >= 0) {
            if (data[j].depth < d) {
                if (data[j].isDir && !data[j].expanded) { return false; }
                d = data[j].depth;
            }
            j = j - 1;
        }
        return true;
    }

    /// 可见行的像素高度；面板未声明高度时，列布局
    /// 据此确定树的高度。
    int ContentHeight(App app) {
        int rowH = this.RowHeight(app);
        int h = 0;
        int hideDepth = 0 - 1;
        for (int k = 0; k < data.Count; k = k + 1) {
            TreeNode n = data[k];
            bool shown = true;
            if (hideDepth >= 0) {
                if (n.depth > hideDepth) { shown = false; }
                else { hideDepth = 0 - 1; }
            }
            if (shown) {
                if (this.Templated() && k < children.Count) {
                    h = h + this.RowExtent(app, children[k]);
                } else {
                    h = h + rowH;
                }
                if (n.isDir && !n.expanded) { hideDepth = n.depth; }
            }
        }
        return h;
    }

    /// 模板行实际占高（prefH 未测出时退统一行高）。
    int RowExtent(App app, Control row) {
        int h = row.prefH;
        if (h <= 0) { h = this.RowHeight(app); }
        return h;
    }

    /// 通过模板为每个节点重建一个子控件。在此处
    /// 测量子控件，因为树的测量阶段在发现需要重建时
    /// 已经走过了它们。
    void BuildRows(App app) {
        if (!rowsStale && builtFor == data.Count) { return; }
        children = new List<Control>();
        for (int i = 0; i < data.Count; i = i + 1) {
            Control row = tpl(data[i]);
            if (row != null) {
                row.parent = this;
                row.dock = 1;
                children.Add(row);
            }
        }
        rowsStale = false;
        builtFor = data.Count;
        for (int k = 0; k < children.Count; k = k + 1) {
            children[k].MeasureTree(app);
        }
    }

    /// 过滤行，绘制在树自身的背景上，使其看起来是树的一部分。
    /// 返回其下方的行区域。
    Rect PaintFilter(App app) {
        int barH = this.FilterHeight(app);
        Rect rows = new Rect(bx, by + barH, bw, bh - barH);
        if (barH == 0) { return rows; }
        Theme t = app.theme;
        StyleBox search = Style.Part(app, "treeview", "search", "", Class, "",
                                     Style.SNormal());
        int pad = app.Scale(6);
        int glyph = app.Scale(12);
        app.canvas.DrawGlyphIn("search", bx + pad, by, glyph, barH,
            glyph, search.FgOr(0));
        int inX = bx + pad * 2 + glyph;
        filter.Render(app, inX, by + app.Scale(2),
            bw - (inX - bx) - pad, barH - app.Scale(4));
        return rows;
    }

    /// 一行的选择 / 展开 / 上下文交互。返回注册的 id，
    /// 以便据此绘制悬停状态。
    int RowInteract(App app, int index, Rect row) {
        int id = app.focus.AllocId();
        app.hitTester.RegisterRect(id, row.x, row.y, row.width, row.height, 0);
        // 按下/点击的目标由 App 在事件到达时对着上一帧完整的命中区
        // 解析，行自己再做一次 HitTest 只能看到本帧已注册的一半，
        // 会抢走本该属于行内控件或上层浮层的手势。
        if (app.PressTarget() != id && app.ClickTarget() != id
            && app.RightPressTarget() != id) { return id; }
        if (app.PressTarget() == id && app.EventKind() == 2
            && app.window.EventButton() == 0) {
            ctxRow = index;
            ctxX = app.mouseX;
            ctxY = app.mouseY;
            if (reorder) {
                pressed = true;
                dragRow = index;
                dragging = false;
                dropAt = 0 - 1;
            }
            Press.Post();
        }
        // 刚刚拖完的那一次松手不是点击：否则落点那一行会被
        // 顺带选中，目录还会被展开 / 折叠。
        if (dropDone) { return id; }
        // 必须同时是本次点击解析出的目标：ClickAvailable() 只回答
        // “本帧有一次可用的主键点击”，不认 id，单靠它会让任何进到
        // 这里的行响应发生在别处的点击。
        if (app.ClickTarget() == id && app.ClickAvailable()) {
            TreeNode n = data[index];
            int mods = app.window.EventMods();
            if (multi && Modifiers.HasCtrl(mods)) {
                // 将行切入/切出多选。不触发 Select
                // （切换不是选中），目录保留
                // 展开状态，使选择可以包含已折叠的文件夹。
                bool was = false;
                for (int mi = 0; mi < marks.Count; mi = mi + 1) {
                    if (marks[mi] == index) { marks.RemoveAt(mi); was = true; break; }
                }
                if (sel.Get() == index) { sel.Set(0 - 1); was = true; }
                if (!was) {
                    if (sel.Get() < 0) { sel.Set(index); }
                    else { marks.Add(index); }
                }
                ctxRow = index;
                this.NoteSelfDamage(app);
                return id;
            }
            if (multi && Modifiers.HasShift(mods) && sel.Get() >= 0) {
                // 将选择从焦点行扩展到本行，
                // 只标记可见行，使折叠目录的子节点
                // 永远不会被悄悄选中。
                int a = sel.Get();
                int b = index;
                if (b < a) { int tmp = a; a = b; b = tmp; }
                int r = a;
                while (r <= b) {
                    if (!this.IsMarked(r) && this.Shown(r)) { marks.Add(r); }
                    r = r + 1;
                }
                ctxRow = index;
                this.NoteSelfDamage(app);
                return id;
            }
            bool moved = sel.Get() != index;
            if (multi) { marks = new List<int>(); }
            sel.Set(index);
            ctxRow = index;
            if (n.isDir) {
                n.expanded = !n.expanded;
                rowsStale = true;
                if (n.expanded) { Expand.Post(); } else { Collapse.Post(); }
            }
            if (moved) { Select.Post(); }
            if (app.DoubleClickNow()) { Activate.Post(); }
            this.NoteSelfDamage(app);
        } else if (app.RightPressTarget() == id && app.EventKind() == 2
                   && app.window.EventButton() == 1) {
            // 右键点击会把选择移到菜单所针对的行，
            // 但不触发 Select：打开上下文菜单不是选中。
            // 右键点击已属于多选集合的行
            // 保持选择不变，使上下文操作可以作用于全部。
            if (!(multi && this.IsMarked(index))) {
                if (multi) { marks = new List<int>(); }
                sel.Set(index);
            }
            ctxRow = index;
            ctxX = app.mouseX;
            ctxY = app.mouseY;
            Context.Post();
            this.NoteSelfDamage(app);
        }
        return id;
    }

    /// 选择、展开、折叠只改变树自己的那块像素，因此把损伤
    /// 限定在控件矩形内：整窗重绘会把功能区、编辑器、预览
    /// 一起重画，展开一个目录的 CPU 峰值就是这么来的。需要
    /// 更大范围的宿主在它们的 Select/Expand 处理器里自行
    /// 调用 RequestRedraw（处理器在下一帧之前执行）。
    void NoteSelfDamage(App app) {
        app.NoteDamage(bx, by, bw, bh);
        app.window.Wake();
    }

    /// 行前的复选框：绘制三态框，点击时切换节点
    /// （目录则连同其后代）。返回 true
    /// 表示已消费该点击，行不会同时被选中。
    bool PaintCheck(App app, int row, int cx, int rowY, int rowH, int box) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int cy = rowY + (rowH - box) / 2;
        int state = TreeView.CheckState(data, row);
        int lvl = 0;
        if (state == 2) {
            Checkbox.PaintBoxIndeterminate(app, cx, cy, box);
        } else {
            if (state == 1) { lvl = 1000; }
            Checkbox.PaintBox(app, cx, cy, box, lvl);
        }
        if (app.EventKind() == 3 && app.window.EventButton() == 0
            && app.mouseX >= cx && app.mouseX < cx + box
            && app.mouseY >= rowY && app.mouseY < rowY + rowH) {
            TreeView.ToggleCheck(data, row);
            ctxRow = row;
            Check.Post();
            this.NoteSelfDamage(app);
            return true;
        }
        return false;
    }

    /// 内置行：箭头、图标和标签，按深度缩进。
    void PaintRow(App app, int row, Rect box, int checkCol, bool active) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        TreeNode n = data[row];
        StyleBox arrow = Style.Part(app, "treeview", "arrow", "", Class, "",
                                    Style.SNormal());
        string iconCls = Class;
        if (n.isDir) { iconCls = iconCls + " dir"; }
        StyleBox icon = Style.Part(app, "treeview", "icon", "", iconCls, "",
                                   Style.SNormal());
        int labelState = Style.SNormal();
        if (active) { labelState = Style.SSelected(); }
        StyleBox label = Style.Part(app, "treeview", "label", "", Class, "",
                                    labelState);
        int fontSize = label.FontOr(Style.FontFallback(app, "medium"));
        int indent = app.Scale(14);
        int x0 = box.x + t.paddingSmall + checkCol + n.depth * indent;
        if (n.isDir) {
            string chev = "chevron-right";
            if (n.expanded) { chev = "chevron-down"; }
            c.DrawGlyphIn(chev, x0, box.y, fontSize, box.height,
                fontSize - 4, arrow.FgOr(0));
        }
        int iconX = x0 + fontSize + t.gapSmall / 2;
        string ic = n.icon;
        if (ic == "") {
            if (n.isDir) { ic = "folder"; } else { ic = "file"; }
        }
        c.DrawGlyphIn(ic, iconX, box.y, fontSize, box.height, fontSize, icon.FgOr(0));
        int textX = iconX + fontSize + t.gapSmall;
        int textY = Canvas.CenterTextY(box.y, box.height, fontSize);
        int labelMaxW = box.x + box.width - t.paddingSmall - textX;
        c.DrawText(textX, textY, Ellipsis.Fit(n.label, labelMaxW, fontSize),
            label.FgOr(0), label.FontOr(fontSize));
    }

    /// 滚轮 + `contentH` 在行区域内限制的滚动偏移。
    int ScrollOffset(App app, Rect rows, int contentH) {
        Scrollbar.HandleWheel(app, rows.x, rows.y, rows.width, rows.height,
            contentH, scroll);
        int maxOff = contentH - rows.height;
        if (maxOff < 0) { maxOff = 0; }
        if (scroll.Get() > maxOff) { scroll.Set(maxOff); }
        if (scroll.Get() < 0) { scroll.Set(0); }
        return scroll.Get();
    }

    /// 拖动排序的每帧状态机：移动时更新插入位置，松手时把
    /// 结果交给宿主。返回本帧是否刚刚完成一次拖放。
    void UpdateDrag(App app, Rect rows) {
        if (!reorder || !pressed || dragRow < 0) { return; }
        int ek = app.EventKind();
        if (ek == 1) {
            if (!dragging && app.mouseY >= rows.y
                && app.mouseY < rows.y + rows.height) {
                dragging = true;
            }
            if (dragging) { this.NoteSelfDamage(app); }
            return;
        }
        if (ek != 3) { return; }
        bool moved = dragging && dropAt >= 0 && dropAt != dragRow
            && dropAt != dragRow + 1;
        if (moved) {
            dropDone = true;
            Move.Post();
            rowsStale = true;
        }
        dragging = false;
        pressed = false;
        this.NoteSelfDamage(app);
    }

    /// 插入位置的横线（拖动排序时画在两行之间）。
    void PaintDropLine(App app, Rect rows, int y) {
        int h = app.Scale(2);
        int py = y - h / 2;
        if (py < rows.y) { py = rows.y; }
        if (py > rows.y + rows.height - h) { py = rows.y + rows.height - h; }
        StyleBox indicator = Style.Part(app, "treeview", "indicator", "", Class, "",
                                        Style.SNormal());
        app.canvas.FillRect(rows.x, py, rows.width, h, indicator.BgOr(0));
    }

    /// 行区绘制与交互：折叠隐藏、选中/悬停底色、复选框与拖动排序。
    void PaintRows(App app, Rect rows) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        StyleBox rowSelected = Style.Full(app, "row", "", "", Style.SSelected());
        StyleBox rowHover = Style.Full(app, "row", "", "", Style.SHover());
        StyleBox indicator = Style.Part(app, "treeview", "indicator", "", Class, "",
                                        Style.SNormal());
        int rowH = this.RowHeight(app);
        if (rows.height <= 0 || rowH <= 0) { return; }
        this.UpdateDrag(app, rows);
        bool dragNow = reorder && dragging;
        int dropY = 0 - 1;
        if (dragNow) { dropAt = data.Count; }
        int contentH = this.ContentHeight(app);
        int off = this.ScrollOffset(app, rows, contentH);
        bool overflow = contentH > rows.height;
        int barW = app.Scale(6);
        int rowW = rows.width;
        if (overflow) { rowW = rows.width - barW; }
        int box = app.Scale(16);
        int checkCol = 0;
        if (checks) { checkCol = box + app.Scale(6); }
        int selRow = sel.Get();
        bool checkClick = false;
        int hideDepth = 0 - 1;
        int y = rows.y - off;

        c.PushClip(rows.x, rows.y, rows.width, rows.height);
        for (int k = 0; k < data.Count; k = k + 1) {
            TreeNode n = data[k];
            bool shown = true;
            if (hideDepth >= 0) {
                if (n.depth > hideDepth) { shown = false; }
                else { hideDepth = 0 - 1; }
            }
            if (shown) {
                int rh = rowH;
                Control child = null;
                if (this.Templated() && k < children.Count) {
                    child = children[k];
                    rh = this.RowExtent(app, child);
                }
                bool onscreen = y + rh > rows.y && y < rows.y + rows.height;
                Rect rb = new Rect(rows.x, y, rowW, rh);
                if (dragNow && dropY < 0 && app.mouseY < y + rh / 2) {
                    dropAt = k;
                    dropY = y;
                }
                if (child != null) {
                    child.Arrange(rb.x, rb.y, rb.width, rb.height);
                    child.visible = onscreen;
                }
                if (onscreen) {
                    bool active = k == selRow || (multi && this.IsMarked(k));
                    int id = 0 - 1;
                    // 先绘制行背景，使其绝不会盖住行前的复选框
                    // （旧顺序会把选择高亮铺满
                    // 整行并遮住复选框）。
                    if (!checkClick) { id = this.RowInteract(app, k, rb); }
                    if (active) {
                        c.FillRect(rb.x, rb.y, rowW, rh, rowSelected.BgOr(0));
                        c.FillRect(rb.x, rb.y, app.Scale(3), rh, indicator.BgOr(0));
                    } else if (id >= 0 && app.focus.IsHovered(id)) {
                        c.FillRect(rb.x, rb.y, rowW, rh, rowHover.BgOr(0));
                    }
                    if (checks) {
                        if (this.PaintCheck(app, k, rb.x + t.paddingSmall,
                                            rb.y, rh, box)) {
                            checkClick = true;
                        }
                    }
                    if (child == null) {
                        this.PaintRow(app, k, rb, checkCol, active);
                    }
                }
                y = y + rh;
                if (n.isDir && !n.expanded) { hideDepth = n.depth; }
            } else if (this.Templated() && k < children.Count) {
                children[k].visible = false;
            }
        }
        if (dragNow) {
            if (dropY < 0) { dropY = y; }
            this.PaintDropLine(app, rows, dropY);
        }
        c.PopClip();
        // 本帧已经吃掉了拖放那一次松手；拖动源的行号留到下一次
        // 按下才重置，因为 Move 处理器在本帧之后才跑，还要读
        // MoveFrom()。
        dropDone = false;

        if (overflow) {
            Scrollbar.RenderVerticalScrollIn(app,
                rows.x + rows.width - barW, rows.y, rows.height,
                rows.height, contentH, scroll,
                rows.x, rows.y, rows.width, rows.height);
        }
    }

    // ---- 保留式钩子 -----------------------------------------------------

    override void OnMeasure(App app) {
        if (this.Templated()) { this.BuildRows(app); }
        prefH = this.ContentHeight(app) + this.FilterHeight(app);
    }

    override void OnPaint(App app) {
        if (this.Templated()) { this.BuildRows(app); }
        Rect rows = this.PaintFilter(app);
        if (data.Count == 0) {
            this.PaintEmpty(app, rows);
            return;
        }
        this.PaintRows(app, rows);
    }

    /// 空树时绘制 Empty 提示文本。
    void PaintEmpty(App app, Rect rows) {
        if (Empty == "") { return; }
        Theme t = app.theme;
        StyleBox empty = Style.Part(app, "treeview", "empty", "", Class, "",
                                    Style.SNormal());
        app.canvas.DrawStyledText(
            Style.Of(app, "label", "hint small", Style.SNormal()),
            rows.x + t.paddingMedium, rows.y + t.paddingSmall, Empty,
            empty.FgOr(0), empty.FontOr(Style.FontFallback(app, "medium")));
    }

    override List<string> Events() {
        List<string> e = Control.CommonEvents();
        e.Add("Select");
        e.Add("Activate");
        e.Add("Expand");
        e.Add("Collapse");
        e.Add("Context");
        e.Add("Check");
        return e;
    }

    /// 将树的语义事件（Select/Activate/Expand/Collapse/
    /// Context/Check）路由到对应 UiEvent 字段；其余事件落入
    /// `On` 的公共绑定。没有这个，基类会把 `onSelect`
    /// JSON/设计器处理器映射到 `On`，而 AddByName 忽略未知名称，
    /// 处理器会静默地从未执行。
    override void BindEvent(string evt, Action a) {
        if (evt == "Select") { Select.Add(a); return; }
        if (evt == "Activate") { Activate.Add(a); return; }
        if (evt == "Expand") { Expand.Add(a); return; }
        if (evt == "Collapse") { Collapse.Add(a); return; }
        if (evt == "Context") { Context.Add(a); return; }
        if (evt == "Check") { Check.Add(a); return; }
        On.AddByName(evt, a);
    }

    // ---- 树在自己的模型上使用的节点列表数学 ----------------------

    /// `idx` 的子树之后第一个节点的索引。
    static int SubtreeEnd(List<TreeNode> nodes, int idx) {
        int d = nodes[idx].depth;
        int j = idx + 1;
        while (j < nodes.Count && nodes[j].depth > d) { j = j + 1; }
        return j;
    }

    /// 节点复选框的三态：0 = 未勾选，1 = 已勾选，2 = 部分
    /// 勾选（后代混合的目录）。
    static int CheckState(List<TreeNode> nodes, int idx) {
        TreeNode n = nodes[idx];
        if (!n.isDir) {
            if (n.checked) { return 1; }
            return 0;
        }
        int end = TreeView.SubtreeEnd(nodes, idx);
        int total = 0;
        int on = 0;
        int j = idx + 1;
        while (j < end) {
            if (!nodes[j].isDir) {
                total = total + 1;
                if (nodes[j].checked) { on = on + 1; }
            }
            j = j + 1;
        }
        if (total == 0) {
            if (n.checked) { return 1; }
            return 0;
        }
        if (on == 0) { return 0; }
        if (on == total) { return 1; }
        return 2;
    }

    /// 切换节点。叶节点翻转自身状态；目录将其所有后代
    /// （以及自身）设为当前聚合状态的反面。
    static void ToggleCheck(List<TreeNode> nodes, int idx) {
        TreeNode n = nodes[idx];
        if (!n.isDir) {
            n.checked = !n.checked;
            return;
        }
        bool target = TreeView.CheckState(nodes, idx) != 1;
        n.checked = target;
        int end = TreeView.SubtreeEnd(nodes, idx);
        int j = idx + 1;
        while (j < end) { nodes[j].checked = target; j = j + 1; }
    }
}
