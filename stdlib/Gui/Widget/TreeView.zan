using System;
using Gui;
using Gui.Backend;

namespace Gui.Widget;

/// One node of a tree, in pre-order. `depth` is the indent level (root = 0).
/// Directories can be expanded/collapsed; files are leaves. `icon` overrides the
/// default folder/file glyph when non-empty. `path` optionally carries the real
/// filesystem path this node represents (empty for purely in-memory trees).
/// `checked` backs the optional selection checkbox column.
class TreeNode {
    string label;
    int depth;
    bool isDir;
    bool expanded;
    string icon;
    string path;
    bool checked;

    static TreeNode Dir(string label, int depth, bool expanded) {
        TreeNode n = new TreeNode();
        n.label = label;
        n.depth = depth;
        n.isDir = true;
        n.expanded = expanded;
        n.icon = "";
        n.path = "";
        n.checked = false;
        return n;
    }

    static TreeNode File(string label, int depth) {
        TreeNode n = new TreeNode();
        n.label = label;
        n.depth = depth;
        n.isDir = false;
        n.expanded = false;
        n.icon = "";
        n.path = "";
        n.checked = false;
        return n;
    }

    static TreeNode FileIcon(string label, int depth, string icon) {
        TreeNode n = TreeNode.File(label, depth);
        n.icon = icon;
        return n;
    }
}

/// Builds a node's own control subtree, for a tree whose rows are a custom
/// component instead of the built-in glyph + label row.
delegate Control NodeOf(TreeNode node);

/// <summary>
/// A collapsible tree bound to the caller's own `List<TreeNode>`. Like every
/// retained widget it sits in a control tree and CSS decides its box, so no call
/// site computes a rectangle, tracks a scroll offset or polls a return code:
///
///     TreeView files = new TreeView();
///     files.Bind(model.nodes);          // the caller's list, not copied
///     files.OnSelect(OpenSelected);
///     files.OnContext(ShowMenu);        // read ContextRow / ContextX / ContextY
///     side.Add(files);
///
/// A node can be a component of its own instead of the built-in row:
///
///     TreeView tv = new TreeView(n => NodeCard(n));
///
/// Clicking a directory toggles it and hides its subtree; wheel scrolling, the
/// overlay scrollbar, the optional inline filter row and the optional checkbox
/// column are all handled inside the control. Handlers are marshalled onto the
/// UI thread (UiEvent.Post), so a background job that rebuilds the bound list
/// and calls Refresh() is safe.
/// </summary>
class TreeView : Control {
    /// The caller's nodes, read every frame: mutating the list shows up on the
    /// next paint (call Refresh() when custom node controls must be rebuilt).
    List<TreeNode> data;
    SignalInt sel;
    SignalInt scroll;
    Input filter;
    bool checks;
    /// Multi-select mode: Ctrl-click toggles a row in/out of the selection,
    /// Shift-click extends it from the focused row. `marks` holds the extra
    /// selected rows beside `sel` (the focused row).
    bool multi;
    List<int> marks;
    NodeOf tpl;
    bool rowsStale;
    int builtFor;

    /// Set while a handler runs: the node the event is about, and where the
    /// pointer was, so a context menu can anchor itself without the call site
    /// reading mouse state.
    int ctxRow;
    int ctxX;
    int ctxY;

    /// Centred while the tree has no nodes ("" draws nothing).
    string Empty;

    /// A node was selected (read SelectedIndex / Selected).
    UiEvent Select;
    /// A node was double-clicked (open / run it).
    UiEvent Activate;
    /// A directory was expanded.
    UiEvent Expand;
    /// A directory was collapsed.
    UiEvent Collapse;
    /// A node was right-clicked (read ContextRow / ContextX / ContextY).
    UiEvent Context;
    /// A checkbox was toggled (read ContextRow for the node).
    UiEvent Check;

    void InitTree() {
        this.InitControl("tree", 5);
        data = new List<TreeNode>();
        sel = SignalInt.Create(0 - 1);
        scroll = SignalInt.Create(0);
        filter = null;
        checks = false;
        multi = false;
        marks = new List<int>();
        tpl = null;
        rowsStale = true;
        builtFor = 0 - 1;
        ctxRow = 0 - 1;
        ctxX = 0;
        ctxY = 0;
        Empty = "";
        wiresOwnEvents = true;
        Select = UiEvent.Create();
        Activate = UiEvent.Create();
        Expand = UiEvent.Create();
        Collapse = UiEvent.Create();
        Context = UiEvent.Create();
        Check = UiEvent.Create();
    }

    TreeView() { InitTree(); }

    /// Custom rows: the template builds each node's control subtree.
    TreeView(NodeOf template) {
        InitTree();
        tpl = template;
    }

    override string Kind() { return "TreeView"; }

    override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec chk = PropSpec.Bool("checks", "Checkboxes");
        chk.flag = checks;
        ps.Add(chk);
        PropSpec empty = PropSpec.Text("empty", "Empty text");
        empty.str = Empty;
        ps.Add(empty);
        PropSpec cls = PropSpec.Text("class", "Classes");
        cls.str = Class;
        ps.Add(cls);
        return ps;
    }

    override string StyleType() { return "tree"; }

    // ---- data ---------------------------------------------------------------

    /// Binds the caller's node list; nothing is copied.
    TreeView Bind(List<TreeNode> nodes) {
        if (nodes == null) { data = new List<TreeNode>(); }
        else { data = nodes; }
        rowsStale = true;
        if (sel.Get() >= data.Count) { sel.Set(0 - 1); }
        int mi = marks.Count - 1;
        while (mi >= 0) {
            if (marks[mi] >= data.Count) { marks.RemoveAt(mi); }
            mi = mi - 1;
        }
        return this;
    }

    /// Marks the bound nodes as changed, so custom rows rebuild next frame.
    void Refresh() { rowsStale = true; }

    /// Shares the caller's selection signal, for a host that persists the
    /// selection across rebuilds of the node list.
    TreeView BindSel(SignalInt s) {
        if (s != null) { sel = s; }
        return this;
    }

    /// Draws an inline filter row at the top of the tree and filters nothing by
    /// itself: the host rebinds the filtered list when the input changes.
    TreeView WithFilter(Input f) {
        filter = f;
        return this;
    }

    /// Draws a tri-state checkbox in front of every node.
    TreeView WithChecks() {
        checks = true;
        return this;
    }

    /// Enables Ctrl-click (toggle) and Shift-click (range) multi-selection.
    TreeView WithMultiSelect() {
        multi = true;
        return this;
    }

    int Count() { return data.Count; }

    /// The bound list itself, for a host that keeps its own view of the nodes a
    /// handler was raised about.
    List<TreeNode> Nodes() { return data; }

    bool Has(int row) { return row >= 0 && row < data.Count; }

    TreeNode NodeAt(int row) { return data[row]; }

    int SelectedIndex() { return sel.Get(); }

    bool HasSelection() { return this.Has(sel.Get()); }

    /// The selected node; only valid while HasSelection().
    TreeNode Selected() { return data[sel.Get()]; }

    void SelectIndex(int row) {
        if (row < 0 - 1 || row >= data.Count) { return; }
        if (sel.Get() == row) { return; }
        sel.Set(row);
        Select.Post();
    }

    void ClearSelection() {
        sel.Set(0 - 1);
        marks = new List<int>();
    }

    /// True when `row` is part of the selection (the focused row included).
    bool IsMarked(int row) {
        if (row < 0) { return false; }
        if (row == sel.Get()) { return true; }
        int i = 0;
        while (i < marks.Count) {
            if (marks[i] == row) { return true; }
            i = i + 1;
        }
        return false;
    }

    /// Every selected row in ascending order (focused row included).
    List<int> SelectedIndices() {
        List<int> outp = new List<int>();
        int n = data.Count;
        int i = 0;
        while (i < n) {
            if (this.IsMarked(i)) { outp.Add(i); }
            i = i + 1;
        }
        return outp;
    }

    int SelectionCount() { return this.SelectedIndices().Count; }

    /// The node the running handler is about (right-clicked or check-toggled).
    int ContextRow() { return ctxRow; }
    int ContextX() { return ctxX; }
    int ContextY() { return ctxY; }

    // ---- handlers -----------------------------------------------------------

    TreeView OnSelect(Action a) { Select.Add(a); return this; }
    TreeView OnActivate(Action a) { Activate.Add(a); return this; }
    TreeView OnExpand(Action a) { Expand.Add(a); return this; }
    TreeView OnCollapse(Action a) { Collapse.Add(a); return this; }
    TreeView OnContext(Action a) { Context.Add(a); return this; }
    TreeView OnCheck(Action a) { Check.Add(a); return this; }

    /// Text shown while the tree is empty.
    TreeView EmptyText(string text) { Empty = text; return this; }

    // ---- expansion / checkbox state (the tree owns its own model) -----------

    void ExpandAll() {
        int k = 0;
        while (k < data.Count) {
            if (data[k].isDir) { data[k].expanded = true; }
            k = k + 1;
        }
        rowsStale = true;
    }

    void CollapseAll() {
        int k = 0;
        while (k < data.Count) {
            if (data[k].isDir) { data[k].expanded = false; }
            k = k + 1;
        }
        rowsStale = true;
    }

    void SetAllChecked(bool on) {
        int k = 0;
        while (k < data.Count) { data[k].checked = on; k = k + 1; }
    }

    void Toggle(int row) {
        if (!this.Has(row)) { return; }
        TreeView.ToggleCheck(data, row);
    }

    /// Indices of every checked node (directories included).
    List<int> CheckedIndices() {
        List<int> res = new List<int>();
        int k = 0;
        while (k < data.Count) {
            if (data[k].checked) { res.Add(k); }
            k = k + 1;
        }
        return res;
    }

    /// Labels of every checked leaf node.
    List<string> CheckedLabels() {
        List<string> res = new List<string>();
        int k = 0;
        while (k < data.Count) {
            if (data[k].checked && !data[k].isDir) { res.Add(data[k].label); }
            k = k + 1;
        }
        return res;
    }

    int CheckedCount() { return this.CheckedLabels().Count; }

    // ---- internals ----------------------------------------------------------

    bool Templated() { return tpl != null; }

    int RowHeight(App app) {
        StyleBox s = this.ResolveStyleAs(app, "tree", Class, Style.SNormal());
        return s.HeightOr(app.theme.heightSmall);
    }

    int FilterHeight(App app) {
        if (filter == null) { return 0; }
        return app.Scale(26);
    }

    /// True when no collapsed ancestor hides `row`.
    bool Shown(int row) {
        int d = data[row].depth;
        int j = row - 1;
        while (j >= 0) {
            if (data[j].depth < d) {
                if (data[j].isDir && !data[j].expanded) { return false; }
                d = data[j].depth;
            }
            j = j - 1;
        }
        return true;
    }

    /// Pixel height of the visible rows, which is what a column layout sizes the
    /// tree from when the sheet declares no height.
    int ContentHeight(App app) {
        int rowH = this.RowHeight(app);
        int h = 0;
        int hideDepth = 0 - 1;
        int k = 0;
        while (k < data.Count) {
            TreeNode n = data[k];
            bool shown = true;
            if (hideDepth >= 0) {
                if (n.depth > hideDepth) { shown = false; }
                else { hideDepth = 0 - 1; }
            }
            if (shown) {
                if (this.Templated() && k < children.Count) {
                    h = h + this.RowExtent(app, children[k]);
                } else {
                    h = h + rowH;
                }
                if (n.isDir && !n.expanded) { hideDepth = n.depth; }
            }
            k = k + 1;
        }
        return h;
    }

    int RowExtent(App app, Control row) {
        int h = row.prefH;
        if (h <= 0) { h = this.RowHeight(app); }
        return h;
    }

    /// Rebuilds one child control per node through the template. Children are
    /// measured here because the tree's measure pass has already walked past
    /// them by the time a rebuild is noticed.
    void BuildRows(App app) {
        if (!rowsStale && builtFor == data.Count) { return; }
        children = new List<Control>();
        int i = 0;
        while (i < data.Count) {
            Control row = tpl(data[i]);
            if (row != null) {
                row.parent = this;
                row.dock = 1;
                children.Add(row);
            }
            i = i + 1;
        }
        rowsStale = false;
        builtFor = data.Count;
        int k = 0;
        while (k < children.Count) {
            children[k].MeasureTree(app);
            k = k + 1;
        }
    }

    /// The filter row, drawn on the tree's own background so it reads as part of
    /// the tree. Returns the rows area below it.
    Rect PaintFilter(App app) {
        int barH = this.FilterHeight(app);
        Rect rows = Rect.Create(bx, by + barH, bw, bh - barH);
        if (barH == 0) { return rows; }
        Theme t = app.theme;
        int pad = app.Scale(6);
        int glyph = app.Scale(12);
        app.canvas.DrawGlyphIn("search", bx + pad, by, glyph, barH,
            glyph, t.textTertiary);
        int inX = bx + pad * 2 + glyph;
        filter.Render(app, inX, by + app.Scale(2),
            bw - (inX - bx) - pad, barH - app.Scale(4));
        return rows;
    }

    /// Selection / expansion / context for one row's box. Returns the id it
    /// registered so hover state can be painted from it.
    int RowInteract(App app, int index, Rect row) {
        int id = app.focus.AllocId();
        app.hitTester.Register(
            HitRegion.Create(id, row.x, row.y, row.width, row.height, 0));
        int hit = app.hitTester.HitTest(app.mouseX, app.mouseY);
        if (hit != id) { return id; }
        if (app.ClickAvailable()) {
            TreeNode n = data[index];
            int mods = app.window.EventMods();
            if (multi && Modifiers.HasCtrl(mods)) {
                // Toggle the row in/out of the multi-selection. No Select is
                // raised (a toggle is not a pick) and directories keep their
                // expansion state so a selection can include closed folders.
                bool was = false;
                int mi = 0;
                while (mi < marks.Count) {
                    if (marks[mi] == index) { marks.RemoveAt(mi); was = true; break; }
                    mi = mi + 1;
                }
                if (sel.Get() == index) { sel.Set(0 - 1); was = true; }
                if (!was) {
                    if (sel.Get() < 0) { sel.Set(index); }
                    else { marks.Add(index); }
                }
                ctxRow = index;
                app.RequestRedraw();
                app.window.Wake();
                return id;
            }
            if (multi && Modifiers.HasShift(mods) && sel.Get() >= 0) {
                // Extend the selection from the focused row to this one,
                // marking only visible rows so children of collapsed
                // directories are never silently included.
                int a = sel.Get();
                int b = index;
                if (b < a) { int tmp = a; a = b; b = tmp; }
                int r = a;
                while (r <= b) {
                    if (!this.IsMarked(r) && this.Shown(r)) { marks.Add(r); }
                    r = r + 1;
                }
                ctxRow = index;
                app.RequestRedraw();
                app.window.Wake();
                return id;
            }
            bool moved = sel.Get() != index;
            if (multi) { marks = new List<int>(); }
            sel.Set(index);
            ctxRow = index;
            if (n.isDir) {
                n.expanded = !n.expanded;
                rowsStale = true;
                if (n.expanded) { Expand.Post(); } else { Collapse.Post(); }
            }
            if (moved) { Select.Post(); }
            if (app.DoubleClickNow()) { Activate.Post(); }
            app.RequestRedraw();
            app.window.Wake();
        } else if (app.EventKind() == 2 && app.window.EventButton() == 1) {
            // A right-click moves the selection to the row the menu is about
            // without raising Select: opening a context menu is not a pick.
            // A right-click on a row that is already part of a multi-selection
            // keeps the selection, so a context action can target all of it.
            if (!(multi && this.IsMarked(index))) {
                if (multi) { marks = new List<int>(); }
                sel.Set(index);
            }
            ctxRow = index;
            ctxX = app.mouseX;
            ctxY = app.mouseY;
            Context.Post();
            app.RequestRedraw();
            app.window.Wake();
        }
        return id;
    }

    /// Checkbox in front of a row: draws the tri-state box and toggles the node
    /// (and, for a directory, its descendants) when clicked. Returns true when
    /// it consumed the click, so the row does not also select.
    bool PaintCheck(App app, int row, int cx, int rowY, int rowH, int box) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int cy = rowY + (rowH - box) / 2;
        int state = TreeView.CheckState(data, row);
        if (state == 2) {
            // Indeterminate is the tree's own state (some descendants checked);
            // the checked / empty boxes come from Checkbox so they match
            // everywhere.
            c.FillRoundRect(cx, cy, box, box, t.borderRadiusSmall, t.primary);
            c.FillRect(cx + app.Scale(4), cy + box / 2 - app.Scale(1),
                box - app.Scale(8), app.Scale(2), t.bgPrimary);
        } else {
            int lvl = 0;
            if (state == 1) { lvl = 1000; }
            Checkbox.PaintBox(app, cx, cy, box, lvl, t.primary, t.borderPrimary);
        }
        if (app.EventKind() == 3 && app.window.EventButton() == 0
            && app.mouseX >= cx && app.mouseX < cx + box
            && app.mouseY >= rowY && app.mouseY < rowY + rowH) {
            TreeView.ToggleCheck(data, row);
            ctxRow = row;
            Check.Post();
            app.RequestRedraw();
            return true;
        }
        return false;
    }

    /// The built-in row: chevron, icon and label, indented by depth.
    void PaintRow(App app, int row, Rect box, int checkCol, bool active) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        TreeNode n = data[row];
        int fontSize = t.fontSizeMedium;
        int indent = app.Scale(14);
        int x0 = box.x + t.paddingSmall + checkCol + n.depth * indent;
        if (n.isDir) {
            string chev = "chevron-right";
            if (n.expanded) { chev = "chevron-down"; }
            c.DrawGlyphIn(chev, x0, box.y, fontSize, box.height,
                fontSize - 4, t.textTertiary);
        }
        int iconX = x0 + fontSize + t.gapSmall / 2;
        string ic = n.icon;
        if (ic == "") {
            if (n.isDir) { ic = "folder"; } else { ic = "file"; }
        }
        int iconColor = t.textSecondary;
        if (n.isDir) { iconColor = t.primary; }
        c.DrawGlyphIn(ic, iconX, box.y, fontSize, box.height, fontSize, iconColor);
        int textX = iconX + fontSize + t.gapSmall;
        int textColor = t.textPrimary;
        if (active) { textColor = t.primary; }
        int textY = box.y + (box.height - Canvas.FontHeight(fontSize)) / 2;
        int labelMaxW = box.x + box.width - t.paddingSmall - textX;
        c.DrawText(textX, textY, Ellipsis.Fit(n.label, labelMaxW, fontSize),
            textColor, fontSize);
    }

    /// Wheel + clamped scroll offset for `contentH` inside the rows area.
    int ScrollOffset(App app, Rect rows, int contentH) {
        Scrollbar.HandleWheel(app, rows.x, rows.y, rows.width, rows.height,
            contentH, scroll);
        int maxOff = contentH - rows.height;
        if (maxOff < 0) { maxOff = 0; }
        if (scroll.Get() > maxOff) { scroll.Set(maxOff); }
        if (scroll.Get() < 0) { scroll.Set(0); }
        return scroll.Get();
    }

    void PaintRows(App app, Rect rows) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int rowH = this.RowHeight(app);
        if (rows.height <= 0 || rowH <= 0) { return; }
        int contentH = this.ContentHeight(app);
        int off = this.ScrollOffset(app, rows, contentH);
        bool overflow = contentH > rows.height;
        int barW = app.Scale(6);
        int rowW = rows.width;
        if (overflow) { rowW = rows.width - barW; }
        int box = app.Scale(16);
        int checkCol = 0;
        if (checks) { checkCol = box + app.Scale(6); }
        int selRow = sel.Get();
        bool checkClick = false;
        int hideDepth = 0 - 1;
        int y = rows.y - off;

        c.PushClip(rows.x, rows.y, rows.width, rows.height);
        int k = 0;
        while (k < data.Count) {
            TreeNode n = data[k];
            bool shown = true;
            if (hideDepth >= 0) {
                if (n.depth > hideDepth) { shown = false; }
                else { hideDepth = 0 - 1; }
            }
            if (shown) {
                int rh = rowH;
                Control child = null;
                if (this.Templated() && k < children.Count) {
                    child = children[k];
                    rh = this.RowExtent(app, child);
                }
                bool onscreen = y + rh > rows.y && y < rows.y + rows.height;
                Rect rb = Rect.Create(rows.x, y, rowW, rh);
                if (child != null) {
                    child.Arrange(rb.x, rb.y, rb.width, rb.height);
                    child.visible = onscreen;
                }
                if (onscreen) {
                    bool active = k == selRow || (multi && this.IsMarked(k));
                    if (checks) {
                        if (this.PaintCheck(app, k, rb.x + t.paddingSmall,
                                            rb.y, rh, box)) {
                            checkClick = true;
                        }
                    }
                    int id = 0 - 1;
                    if (!checkClick) { id = this.RowInteract(app, k, rb); }
                    if (active) {
                        c.FillRect(rb.x, rb.y, rowW, rh, t.bgActive);
                        c.FillRect(rb.x, rb.y, app.Scale(3), rh, t.primary);
                    } else if (id >= 0 && app.focus.IsHovered(id)) {
                        c.FillRect(rb.x, rb.y, rowW, rh, t.bgHover);
                    }
                    if (child == null) {
                        this.PaintRow(app, k, rb, checkCol, active);
                    }
                }
                y = y + rh;
                if (n.isDir && !n.expanded) { hideDepth = n.depth; }
            } else if (this.Templated() && k < children.Count) {
                children[k].visible = false;
            }
            k = k + 1;
        }
        c.PopClip();

        if (overflow) {
            Scrollbar.RenderVerticalScroll(app, rows.x + rows.width - barW,
                rows.y, rows.height, rows.height, contentH, scroll);
        }
    }

    // ---- retained hooks -----------------------------------------------------

    override void OnMeasure(App app) {
        if (this.Templated()) { this.BuildRows(app); }
        prefH = this.ContentHeight(app) + this.FilterHeight(app);
    }

    override void OnPaint(App app) {
        if (this.Templated()) { this.BuildRows(app); }
        Rect rows = this.PaintFilter(app);
        if (data.Count == 0) {
            this.PaintEmpty(app, rows);
            return;
        }
        this.PaintRows(app, rows);
    }

    void PaintEmpty(App app, Rect rows) {
        if (Empty == "") { return; }
        Theme t = app.theme;
        app.canvas.DrawStyledText(
            Style.Of(app, "label", "hint small", Style.SNormal()),
            rows.x + t.paddingMedium, rows.y + t.paddingSmall, Empty,
            t.textPrimary, t.fontSizeMedium);
    }

    override List<string> Events() {
        List<string> e = Control.CommonEvents();
        e.Add("Select");
        e.Add("Activate");
        e.Add("Expand");
        e.Add("Collapse");
        e.Add("Context");
        e.Add("Check");
        return e;
    }

    /// Routes the tree's semantic events (Select/Activate/Expand/Collapse/
    /// Context/Check) to their UiEvent fields; everything else falls through to
    /// the common bundle on `On`. Without this the base maps an `onSelect`
    /// JSON/designer handler onto `On`, whose AddByName ignores unknown names,
    /// so the handler silently never ran.
    override void BindEvent(string evt, Action a) {
        if (evt == "Select") { Select.Add(a); return; }
        if (evt == "Activate") { Activate.Add(a); return; }
        if (evt == "Expand") { Expand.Add(a); return; }
        if (evt == "Collapse") { Collapse.Add(a); return; }
        if (evt == "Context") { Context.Add(a); return; }
        if (evt == "Check") { Check.Add(a); return; }
        On.AddByName(evt, a);
    }

    // ---- node-list math the tree uses on its own model ----------------------

    /// Index of the first node after `idx`'s subtree.
    static int SubtreeEnd(List<TreeNode> nodes, int idx) {
        int d = nodes[idx].depth;
        int j = idx + 1;
        while (j < nodes.Count && nodes[j].depth > d) { j = j + 1; }
        return j;
    }

    /// Tri-state of a node's checkbox: 0 = unchecked, 1 = checked, 2 = partially
    /// checked (a directory whose descendants are a mix).
    static int CheckState(List<TreeNode> nodes, int idx) {
        TreeNode n = nodes[idx];
        if (!n.isDir) {
            if (n.checked) { return 1; }
            return 0;
        }
        int end = TreeView.SubtreeEnd(nodes, idx);
        int total = 0;
        int on = 0;
        int j = idx + 1;
        while (j < end) {
            if (!nodes[j].isDir) {
                total = total + 1;
                if (nodes[j].checked) { on = on + 1; }
            }
            j = j + 1;
        }
        if (total == 0) {
            if (n.checked) { return 1; }
            return 0;
        }
        if (on == 0) { return 0; }
        if (on == total) { return 1; }
        return 2;
    }

    /// Toggle a node. A leaf flips its own state; a directory drives all of its
    /// descendants (and itself) to the opposite of its current aggregate state.
    static void ToggleCheck(List<TreeNode> nodes, int idx) {
        TreeNode n = nodes[idx];
        if (!n.isDir) {
            n.checked = !n.checked;
            return;
        }
        bool target = TreeView.CheckState(nodes, idx) != 1;
        n.checked = target;
        int end = TreeView.SubtreeEnd(nodes, idx);
        int j = idx + 1;
        while (j < end) { nodes[j].checked = target; j = j + 1; }
    }
}
