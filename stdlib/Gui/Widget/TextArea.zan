using System;
using Gui;
using Gui.Component;
using Gui.Component.CodeEditor;

namespace Gui.Widget;

/// <summary>
/// 多行文本输入（textarea）。
///
/// 保留式组件（创建一次，跨帧保留），绑定到
/// SignalString。它负责光标移动、换行编辑、自身的视口
/// 裁剪和垂直滚动（鼠标滚轮 + 自动隐藏滚动条，
/// 输入时保持光标可见）——调用点只需：
///
///   TextArea notes = new TextArea("Write something...");   // 一次
///   notes.Change += () => { ... };                            // C# 风格
///   notes.Render(app, x, y, w, h);                            // 每帧
///   string value = notes.GetText();
///
/// 它拥有稳定的身份（焦点在兄弟/弹层变动后依然保留），框架
/// 解析其焦点/点击，并上报光标位置，使 IME 组合
/// 窗口跟随光标。只读代码展示 / 语法功能请使用
/// CodeEditor；这是普通可编辑的多行字段。
///
/// 它同时是保留式 Control，设计的表单可将其停靠进树中：
///
///   TextArea body = new TextArea("Write something...");
///   body.Dock(Dock.Top()).Prefer(0, 90);
///   root.Add(body);
/// </summary>
class TextArea : Control {
    SignalString model;
    /// 双向绑定文本：`notes.data = doc.body;` 保持模型字段与
    /// 文本框双向同步（编译器降级的 Binding）。
    Binding<string> data;
    string hint;
    int cursorPos;
    /// 选区的固定端（字节偏移），-1 表示无选区。光标是活动端，
    /// 因此 Shift+方向键、拖动和 Ctrl+A 都只移动 `cursorPos`。
    int selAnchor;
    int scrollY;
    int wid;
    /// 由本帧拥有键盘的属主设置一帧——
    /// 悬浮在框上的自动补全列表需要 Up/Down/Enter 来移动和
    /// 接受选择，而不是移动光标、破坏换行。每次
    /// Render 都会清除，因此漏帧不会让框失聪。
    bool skipKeys;
    /// `cacheTxt` 按行拆分的结果。拆分会为每行分配一个列表和一个
    /// 字符串，而框在每帧以及每次
    /// 方向键时都需要这些行——每帧都做正是让长提示文本
    /// 输入卡顿的原因。缓存以文本为键，任何编辑（按键、绑定
    /// 或 SetText）都恰好重建一次。
    string cacheTxt;
    List<string> cacheLines;
    /// 只读展示：文字仍可点选、拖选、Ctrl+A / Ctrl+C，但任何按键都改不了
    /// 内容，也不画输入框的外框——用来显示一段可复制的正文。
    bool readOnly;
    /// 高度跟着内容走（放进滚动列里的正文用），而不是固定一格。
    bool autoHeight;
    /// 文本变化时触发（C# 风格：`area.Change += h;`）。
    UiEvent Change;

    /// 立即模式工厂与保留式构造器
    /// 共用的初始化：设置 Control 基座（默认停靠顶部，追加的区域
    /// 自动吸附），再设置文本框专属状态。
    void InitTextArea(SignalString sig, string hintText) {
        this.InitControl("textarea", 1);
        model = sig;
        hint = hintText;
        cursorPos = 0;
        selAnchor = -1;
        scrollY = 0;
        wid = WidgetId.Next();
        skipKeys = false;
        cacheTxt = "";
        cacheLines = null;
        readOnly = false;
        autoHeight = false;
        wiresOwnEvents = true;
        Change = new UiEvent();
    }

    /// Default design-time constructor; the form supplies `placeholder` later.
    TextArea() : this("") { }

    /// 保留式构造器：`TextArea notes = new TextArea("Notes...");`
    TextArea(string hintText) {
        InitTextArea(new SignalString(""), hintText);
    }

    static TextArea Bind(SignalString sig, string hintText) {
        TextArea a = new TextArea(hintText);
        a.model = sig;
        return a;
    }

    string GetText() {
        return model.Get();
    }

    /// 只读：可选中复制，不可编辑。
    TextArea ReadOnly(bool on) {
        readOnly = on;
        return this;
    }

    bool IsReadOnly() { return readOnly; }

    /// 高度按行数自动撑开（外层负责滚动）。
    TextArea AutoHeight(bool on) {
        autoHeight = on;
        return this;
    }

    /// 一行的高度，正文换行的调用方按它算可见行数。
    static int LineHeight(App app) {
        return Canvas.FontHeight(app.theme.fontSizeMedium) + app.Scale(4);
    }

    /// 放下全部文本需要的高度（含内边距）。
    int ContentHeight(App app) {
        int n = this.Lines().Count;
        if (n < 1) { n = 1; }
        return n * TextArea.LineHeight(app) + app.theme.paddingSmall * 2;
    }

    /// 此框的焦点 id，属主可在渲染前查询它是否获得焦点
    /// （其上的弹层必须决定谁拥有按键）。
    int Id() { return wid; }

    /// 把本帧的按键事件交给调用方而不是文本框。
    void SkipKeysOnce() { skipKeys = true; }

    void SetText(string v) {
        model.Set(v);
        cursorPos = v.Length;
        selAnchor = -1;
        PushBinding();
    }

    /// 将绑定的模型值拉入编辑缓冲区（model -> UI）。
    void SyncBinding() {
        if (data == null) { return; }
        string cur = data.Get();
        if (cur != model.Get()) {
            model.Set(cur);
            if (cursorPos > cur.Length) { cursorPos = cur.Length; }
        }
    }

    /// 通过绑定把编辑缓冲区写回（UI -> model）。
    void PushBinding() {
        if (data == null) { return; }
        data.Set(model.Get());
    }

    /// 所有 UI 编辑都汇入这里：先写回，再通知。
    void Edited() {
        PushBinding();
        Change.Raise();
    }

    void ClampCursor() {
        string txt = model.Get();
        if (cursorPos > txt.Length) { cursorPos = txt.Length; }
        if (cursorPos < 0) { cursorPos = 0; }
        if (selAnchor > txt.Length) { selAnchor = txt.Length; }
    }

    bool HasSel() { return selAnchor >= 0 && selAnchor != cursorPos; }
    int SelStart() { if (selAnchor >= 0 && selAnchor < cursorPos) { return selAnchor; } return cursorPos; }
    int SelEnd() { if (selAnchor > cursorPos) { return selAnchor; } return cursorPos; }

    string SelText() {
        if (!HasSel()) { return ""; }
        return model.Get().Substring(SelStart(), SelEnd() - SelStart());
    }

    /// 删除选中的范围，并把光标收拢到其起点。
    void DeleteSel() {
        if (!HasSel()) { return; }
        string txt = model.Get();
        int s = SelStart();
        int e = SelEnd();
        model.Set(txt.Substring(0, s) + txt.Substring(e, txt.Length - e));
        cursorPos = s;
        selAnchor = -1;
    }

    /// 文本按行返回，每次编辑最多拆分一次。
    List<string> Lines() {
        string txt = model.Get();
        if (cacheLines == null || cacheTxt != txt) {
            cacheLines = CodeEditor.SplitLines(txt);
            cacheTxt = txt;
        }
        return cacheLines;
    }

    /// 字节光标所在的行，从缓存行中推算出，而不是
    /// 在光标前重新拆分一份文本副本。
    int CaretLine(List<string> lines) {
        int pos = 0;
        for (int i = 0; i < lines.Count; i = i + 1) {
            int end = pos + lines[i].Length;
            if (cursorPos <= end) { return i; }
            pos = end + 1;
        }
        if (lines.Count == 0) { return 0; }
        return lines.Count - 1;
    }

    int LineStartAbs(List<string> lines, int line) {
        int s = 0;
        for (int i = 0; i < line; i = i + 1) {
            s = s + lines[i].Length + 1;
        }
        return s;
    }

    void HandleInput(App app) {
        this.ClampCursor();
        int kind = app.EventKind();
        string txt = model.Get();

        if (kind == 6) {
            if (readOnly) { return; }
            int code = app.window.EventKeyCode();
            if (code == 8) {
                if (HasSel()) {
                    DeleteSel();
                    Edited();
                    app.RequestRedraw();
                } else if (cursorPos > 0) {
                    int start = Text.PrevCharStart(txt, cursorPos);
                    model.Set(Text.DeleteBefore(txt, cursorPos));
                    cursorPos = start;
                    Edited();
                    app.RequestRedraw();
                }
            } else if (code == 13) {
                if (HasSel()) { DeleteSel(); txt = model.Get(); }
                model.Set(Text.InsertAt(txt, cursorPos, "\n"));
                cursorPos = cursorPos + 1;
                Edited();
                app.RequestRedraw();
            } else if (code == 9) {
                if (HasSel()) { DeleteSel(); txt = model.Get(); }
                model.Set(Text.InsertAt(txt, cursorPos, "  "));
                cursorPos = cursorPos + 2;
                Edited();
                app.RequestRedraw();
            } else {
                string ch = Text.CharStr(code);
                if (ch.Length > 0) {
                    if (HasSel()) { DeleteSel(); txt = model.Get(); }
                    model.Set(Text.InsertAt(txt, cursorPos, ch));
                    cursorPos = cursorPos + ch.Length;
                    Edited();
                    app.RequestRedraw();
                }
            }
        } else if (kind == 4) {
            int kc = app.window.EventKeyCode();
            int mods = app.window.EventMods();
            bool shift = Modifiers.HasShift(mods);
            bool ctrl = Modifiers.HasCtrl(mods);
            if (ctrl && kc == 65) {
                // Ctrl+A：全选。
                selAnchor = 0;
                cursorPos = txt.Length;
                app.RequestRedraw();
            } else if (ctrl && kc == 67) {
                // Ctrl+C：复制选区（无选区时复制全文）。
                if (HasSel()) { Clipboard.SetText(SelText()); }
                else { Clipboard.SetText(txt); }
            } else if (ctrl && kc == 88) {
                // Ctrl+X：剪切。
                if (readOnly) { return; }
                if (HasSel()) {
                    Clipboard.SetText(SelText());
                    DeleteSel();
                    Edited();
                    app.RequestRedraw();
                }
            } else if (ctrl && kc == 86) {
                // Ctrl+V：粘贴并覆盖选区（多行文本整段插入）。
                if (readOnly) { return; }
                string clip = Clipboard.GetText();
                if (clip.Length > 0) {
                    if (HasSel()) { DeleteSel(); txt = model.Get(); }
                    model.Set(Text.InsertAt(txt, cursorPos, clip));
                    cursorPos = cursorPos + clip.Length;
                    selAnchor = -1;
                    Edited();
                    app.RequestRedraw();
                }
            } else if (kc == 37 || kc == 39 || kc == 38 || kc == 40
                       || kc == 36 || kc == 35) {
                // 导航键：Shift 从光标处扩展选区，普通移动收起选区。
                if (shift) {
                    if (selAnchor < 0) { selAnchor = cursorPos; }
                } else {
                    selAnchor = -1;
                }
                if (kc == 37) {
                    if (cursorPos > 0) { cursorPos = Text.PrevCharStart(txt, cursorPos); }
                    app.RequestRedraw();
                } else if (kc == 39) {
                    if (cursorPos < txt.Length) { cursorPos = Text.NextCharEnd(txt, cursorPos); }
                    app.RequestRedraw();
                } else if (kc == 38 || kc == 40) {
                    List<string> lines = this.Lines();
                    int caretLine = this.CaretLine(lines);
                    int caretCol = cursorPos - this.LineStartAbs(lines, caretLine);
                    int target = caretLine - 1;
                    if (kc == 40) { target = caretLine + 1; }
                    if (target >= 0 && target < lines.Count) {
                        int col = caretCol;
                        if (col > lines[target].Length) { col = lines[target].Length; }
                        cursorPos = this.LineStartAbs(lines, target) + col;
                        app.RequestRedraw();
                    }
                } else if (kc == 36) {
                    List<string> lines = this.Lines();
                    cursorPos = this.LineStartAbs(lines, this.CaretLine(lines));
                    app.RequestRedraw();
                } else if (kc == 35) {
                    List<string> lines = this.Lines();
                    int caretLine = this.CaretLine(lines);
                    cursorPos = this.LineStartAbs(lines, caretLine) + lines[caretLine].Length;
                    app.RequestRedraw();
                }
            } else if (kc == 46) {
                if (readOnly) { return; }
                if (HasSel()) {
                    DeleteSel();
                    Edited();
                    app.RequestRedraw();
                } else if (cursorPos < txt.Length) {
                    model.Set(Text.RemoveAt(txt, cursorPos));
                    Edited();
                    app.RequestRedraw();
                }
            }
        }
    }

    /// 鸠标位置对应的字节偏移（行高/滚动位置均取当前帧）。
    int PosFromMouse(App app, List<string> lines, int innerX, int innerY,
                     int lineH, int fs) {
        int line = (app.mouseY - innerY + scrollY) / lineH;
        if (line < 0) { line = 0; }
        if (line >= lines.Count) { line = lines.Count - 1; }
        if (line < 0) { return 0; }
        int col = CodeEditor.ColFromX(lines[line], app.mouseX - innerX, fs);
        return this.LineStartAbs(lines, line) + col;
    }

    int Render(App app, int x, int y, int w, int h) {
        int id = wid;
        Canvas c = app.canvas;
        Theme t = app.theme;

        app.focus.RegisterFocusable(id);
        bool hovered = app.focus.IsHovered(id);
        bool focused = app.focus.IsFocused(id);

        if (focused && !skipKeys) { this.HandleInput(app); }
        skipKeys = false;

        SyncBinding();
        string txt = model.Get();
        this.ClampCursor();

        int borderColor = t.borderPrimary;
        if (focused) { borderColor = t.borderFocus; }
        if (hovered && !focused) { borderColor = t.borderHover; }
        if (!readOnly) {
            c.SurfaceRoundRect(x, y, w, h, t.borderRadiusMedium, t.bgPrimary,
                               borderColor, 1);
        }

        int pad = t.paddingSmall;
        int innerX = x + pad;
        int innerY = y + pad;
        int innerW = w - pad * 2;
        int innerH = h - pad * 2;
        int lineH = TextArea.LineHeight(app);

        List<string> lines = this.Lines();
        int contentH = lines.Count * lineH;

        int caretLine = this.CaretLine(lines);
        int caretCol = cursorPos - this.LineStartAbs(lines, caretLine);
        if (caretCol < 0) { caretCol = 0; }
        if (caretCol > lines[caretLine].Length) {
            caretCol = lines[caretLine].Length;
        }

        // 保持光标可见（仅在获得焦点 / 正在编辑时）。
        if (focused) {
            int caretTop = caretLine * lineH;
            if (caretTop < scrollY) { scrollY = caretTop; }
            if (caretTop + lineH > scrollY + innerH) {
                scrollY = caretTop + lineH - innerH;
            }
        }

        bool overBox = app.mouseX >= x && app.mouseX < x + w
            && app.mouseY >= y && app.mouseY < y + h;
        bool ownsWheel = false;
        if (overBox) { ownsWheel = app.CaptureWheel(x, y, w, h); }
        if (ownsWheel) {
            int d = app.window.EventKeyCode();
            scrollY = scrollY - d * app.scrollSpeed / 120;
            app.RequestRedraw();
        }
        int maxScroll = contentH - innerH;
        if (maxScroll < 0) { maxScroll = 0; }
        if (scrollY > maxScroll) { scrollY = maxScroll; }
        if (scrollY < 0) { scrollY = 0; }

        c.PushClip(innerX, innerY, innerW, innerH);
        if (txt == "" && !focused) {
            c.DrawText(innerX, innerY, hint, t.textTertiary, t.fontSizeMedium);
        } else {
            int fs = t.fontSizeMedium;
            if (focused && HasSel()) {
                // 选区高亮画在文本下面，每行取它与选区的交集；
                // 含换行的行尾多画一个空格宽，使跳行可见。
                int selS = SelStart();
                int selE = SelEnd();
                int selColor = App.LerpColor(t.bgPrimary, t.primary, 96);
                int nlW = Canvas.MeasureText(" ", fs);
                int lineStart = 0;
                for (int i = 0; i < lines.Count; i = i + 1) {
                    int lineEnd = lineStart + lines[i].Length;
                    int s = selS;
                    int e = selE;
                    if (s < lineStart) { s = lineStart; }
                    if (e > lineEnd) { e = lineEnd; }
                    if (s <= e && selE > lineStart && selS <= lineEnd) {
                        int ly = innerY + i * lineH - scrollY;
                        int x0 = Canvas.MeasureText(lines[i].Substring(0, s - lineStart), fs);
                        int x1 = Canvas.MeasureText(lines[i].Substring(0, e - lineStart), fs);
                        int selW = x1 - x0;
                        if (selE > lineEnd) { selW = selW + nlW; }
                        c.FillRect(innerX + x0, ly, selW, Canvas.FontHeight(fs), selColor);
                    }
                    lineStart = lineEnd + 1;
                }
            }
            for (int i = 0; i < lines.Count; i = i + 1) {
                int ly = innerY + i * lineH - scrollY;
                if (ly + lineH > innerY && ly < innerY + innerH) {
                    c.DrawText(innerX, ly, lines[i], t.textPrimary, t.fontSizeMedium);
                }
            }
            if (focused && !readOnly) {
                int caretX = innerX + Canvas.MeasureText(
                    lines[caretLine].Substring(0, caretCol), t.fontSizeMedium);
                int caretY = innerY + caretLine * lineH - scrollY;
                int fh = Canvas.FontHeight(t.fontSizeMedium);
                c.FillRect(caretX, caretY, 1, fh, t.primary);
                // 让 IME 组合窗口跟随光标。
                app.SetImeCaret(caretX, caretY + fh);
            }
        }
        c.PopClip();

        // 内容溢出时的垂直滚动条（限制 + 裁剪）。
        if (contentH > innerH && innerH > 0) {
            int barW = app.Scale(6);
            int barX = x + w - barW - app.Scale(2);
            int minThumb = app.Scale(24);
            if (minThumb > innerH) { minThumb = innerH; }
            int thumbH = innerH * innerH / contentH;
            if (thumbH < minThumb) { thumbH = minThumb; }
            if (thumbH > innerH) { thumbH = innerH; }
            int travel = innerH - thumbH;
            if (travel < 0) { travel = 0; }
            int thumbY = innerY;
            if (maxScroll > 0) { thumbY = innerY + scrollY * travel / maxScroll; }
            if (thumbY < innerY) { thumbY = innerY; }
            if (thumbY + thumbH > innerY + innerH) { thumbY = innerY + innerH - thumbH; }
            c.PushClip(innerX, innerY, innerW, innerH);
            c.FillRoundRect(barX, innerY, barW, innerH, barW / 2, t.bgTertiary);
            c.FillRoundRect(barX, thumbY, barW, thumbH, barW / 2, t.scrollbar);
            c.PopClip();
        }

        app.hitTester.RegisterRect(id, x, y, w, h, 1);

        // 鼠标选择：按下锚定选区并放置光标，按住拖动移动活动端。
        if (Ui.PressedDown(app, id)) {
            cursorPos = this.PosFromMouse(app, lines, innerX, innerY, lineH,
                                          t.fontSizeMedium);
            if (!Modifiers.HasShift(app.window.EventMods()) || selAnchor < 0) {
                selAnchor = cursorPos;
            }
            this.ClampCursor();
            app.RequestRedraw();
        } else if (focused && app.focus.IsPressed(id) && app.EventKind() == 1) {
            int drag = this.PosFromMouse(app, lines, innerX, innerY, lineH,
                                         t.fontSizeMedium);
            if (drag != cursorPos) {
                cursorPos = drag;
                this.ClampCursor();
                app.RequestRedraw();
            }
        }
        // 单消费者点击：当此区域是框架解析出的点击
        // 目标时放置光标。
        if (Ui.Clicked(app, id)) {
            cursorPos = this.PosFromMouse(app, lines, innerX, innerY, lineH,
                                          t.fontSizeMedium);
            if (selAnchor == cursorPos) { selAnchor = -1; }
            this.ClampCursor();
            app.RequestRedraw();
        }
        if (!focused && selAnchor >= 0) { selAnchor = -1; }

        On.Fire(app, id);
        return id;
    }

    // --- 设计器 / 序列化模型 ---

    override string Kind() { return "TextArea"; }

    override string StyleType() { return "textarea"; }

    override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec ph = PropSpec.Text("hint", "Placeholder");
        ph.str = hint;
        ph.Also("placeholder");
        ps.Add(ph);
        ps.Add(PropSpec.Text("text", "Text"));
        return ps;
    }

    /// 文本经由 SetText 写入，使光标保持在范围内。
    override string GetExtra(string key) {
        if (key == "text" || key == "value") { return model.Get(); }
        return "";
    }

    override bool SetExtra(string key, string val) {
        if (key != "text" && key != "value") { return false; }
        this.SetText(val);
        return true;
    }

    override List<string> Events() {
        List<string> e = Control.CommonEvents();
        e.Add("Change");
        return e;
    }

    override void BindEvent(string evt, Action a) {
        if (evt == "Change") { Change.Add(a); return; }
        On.AddByName(evt, a);
    }

    // --- 保留式钩子（Control） ---

    override void OnMeasure(App app) {
        Theme t = app.theme;
        StyleBox s = this.ResolveStyleAs(app, "textarea", Class, Style.SNormal());
        if (autoHeight) { prefH = this.ContentHeight(app); }
        else { prefH = s.HeightOr(app.Scale(90)); }
        prefW = s.WidthOr(app.Scale(220));
    }

    override void OnPaint(App app) {
        this.Render(app, bx, by, bw, bh);
    }
}

