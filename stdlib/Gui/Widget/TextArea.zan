using System;
using Gui;
using Gui.Component;
using Gui.Component.CodeEditor;

namespace Gui.Widget;

/// <summary>
/// 多行文本输入（textarea）。
///
/// 保留式组件（创建一次，跨帧保留），绑定到
/// SignalString。它负责光标移动、换行编辑、自身的视口
/// 裁剪和垂直滚动（鼠标滚轮 + 自动隐藏滚动条，
/// 输入时保持光标可见）——调用点只需：
///
///   TextArea notes = new TextArea("Write something...");   // 一次
///   notes.Change += () => { ... };                            // C# 风格
///   notes.Render(app, x, y, w, h);                            // 每帧
///   string value = notes.GetText();
///
/// 它拥有稳定的身份（焦点在兄弟/弹层变动后依然保留），框架
/// 解析其焦点/点击，并上报光标位置，使 IME 组合
/// 窗口跟随光标。只读代码展示 / 语法功能请使用
/// CodeEditor；这是普通可编辑的多行字段。
///
/// 它同时是保留式 Control，设计的表单可将其停靠进树中：
///
///   TextArea body = new TextArea("Write something...");
///   body.Dock(Dock.Top()).Prefer(0, 90);
///   root.Add(body);
///
/// 能力面（对齐 Naive UI 的 type="textarea"）：`Disabled`（继承自
/// Control）、`SetStatus` 校验态描边、`ShowCount`+`MaxLen`
/// (+`CountGraphemes`) 字数统计、`Round` 圆角、`Filter` 输入过滤，
/// 以及 Clear/Focus/Blur/SelectAll/ScrollToEnd 手动操作。
/// </summary>
class TextArea : Control {
    SignalString model;
    /// 双向绑定文本：`notes.data = doc.body;` 保持模型字段与
    /// 文本框双向同步（编译器降级的 Binding）。
    Binding<string> data;
    string hint;
    int cursorPos;
    /// 选区的固定端（字节偏移），-1 表示无选区。光标是活动端，
    /// 因此 Shift+方向键、拖动和 Ctrl+A 都只移动 `cursorPos`。
    int selAnchor;
    int scrollY;
    int wid;
    /// 由本帧拥有键盘的属主设置一帧——
    /// 悬浮在框上的自动补全列表需要 Up/Down/Enter 来移动和
    /// 接受选择，而不是移动光标、破坏换行。每次
    /// Render 都会清除，因此漏帧不会让框失聪。
    bool skipKeys;
    /// `cacheTxt` 按行拆分的结果。拆分会为每行分配一个列表和一个
    /// 字符串，而框在每帧以及每次
    /// 方向键时都需要这些行——每帧都做正是让长提示文本
    /// 输入卡顿的原因。缓存以文本为键，任何编辑（按键、绑定
    /// 或 SetText）都恰好重建一次。
    string cacheTxt;
    List<string> cacheLines;
    /// 软换行后的显示行：每一项是一段文本的字节区间（起点 + 长度）。一行
    /// 写不下就拆成几行显示，而文本本身不动（只有 Enter 才真的插入
    /// 换行）：否则一句长句子会一直往右跑到框外面，又没有横向滚动，
    /// 后半句就看不见了。按它的宽度与字号缓存，因为量文本宽度不便宜。
    List<int> rowStart;
    List<int> rowLen;
    string wrapTxt;
    int wrapW;
    int wrapFs;
    /// 校验错误信息；"" 表示有效。SetError 会绘制红色边框，并
    /// 把 `msg` 显示在字段下方，直到用户编辑（或调用 ClearError）。
    /// 与 Input 的校验 API 同款，FormGroup 对字段统一调用。
    string errMsg;
    /// 只读展示：文字仍可点选、拖选、Ctrl+A / Ctrl+C，但任何按键都改不了
    /// 内容，也不画输入框的外框——用来显示一段可复制的正文。
    bool readOnly;
    /// 高度跟着内容走（放进滚动列里的正文用），而不是固定一格。
    bool autoHeight;
    /// 由本帧渲染沿记一笔宿主 App：手动操作（Focus/Blur/Clear/
    /// ScrollToEnd）要在没有 app 形参的事件回调里改焦点、请求重绘。
    App liveApp;
    /// 输入字符上限（>0 生效），按码点计；CountGraphemes 打开时按
    /// 字素簇计（与 ShowCount 显示同一口径）。0 表示不限。
    int MaxLen;
    /// 是否显示字数统计（"当前 / 上限"），画在框内右下角。
    bool ShowCount;
    /// 计数口径：true 按字素簇，false 按码点。
    bool CountGraphemes;
    /// 校验状态：""/success/warning/error，映射 base.css 字段状态类。
    string FieldStatus;
    /// 圆角框（整高半圆角），走 `.round` 类。
    bool Round;
    /// 输入过滤（Naive UI allow-input）：收到插入后的完整候选文本，
    /// 返回清洗后的文本；null 表示拒绝该插入。
    InputFilterFn Filter;
    /// 文本变化时触发（C# 风格：`area.Change += h;`）。
    UiEvent Change;

    /// 立即模式工厂与保留式构造器
    /// 共用的初始化：设置 Control 基座（默认停靠顶部，追加的区域
    /// 自动吸附），再设置文本框专属状态。
    void InitTextArea(SignalString sig, string hintText) {
        this.InitControl("textarea", 1);
        model = sig;
        hint = hintText;
        cursorPos = 0;
        selAnchor = -1;
        scrollY = 0;
        wid = WidgetId.Next();
        skipKeys = false;
        cacheTxt = "";
        cacheLines = null;
        rowStart = new List<int>();
        rowLen = new List<int>();
        wrapTxt = "";
        wrapW = 0;
        wrapFs = 0;
        errMsg = "";
        readOnly = false;
        autoHeight = false;
        liveApp = null;
        MaxLen = 0;
        ShowCount = false;
        CountGraphemes = false;
        FieldStatus = "";
        Round = false;
        Filter = null;
        wiresOwnEvents = true;
        Change = new UiEvent();
    }

    /// Default design-time constructor; the form supplies `placeholder` later.
    TextArea() : this("") { }

    /// 保留式构造器：`TextArea notes = new TextArea("Notes...");`
    TextArea(string hintText) {
        InitTextArea(new SignalString(""), hintText);
    }

    static TextArea Bind(SignalString sig, string hintText) {
        TextArea a = new TextArea(hintText);
        a.model = sig;
        return a;
    }

    string GetText() {
        return model.Get();
    }

    /// 只读：可选中复制，不可编辑。
    TextArea ReadOnly(bool on) {
        readOnly = on;
        return this;
    }

    bool IsReadOnly() { return readOnly; }

    /// 高度按行数自动撑开（外层负责滚动）。
    TextArea AutoHeight(bool on) {
        autoHeight = on;
        return this;
    }

    /// 一行的高度，正文换行的调用方按它算可见行数。
    static int LineHeight(App app) {
        StyleBox s = Style.Of(app, "textarea", "", Style.SNormal());
        return Canvas.FontHeight(s.FontOr(Style.FontFallback(app, "medium")))
            + app.Scale(4);
    }

    /// 放下全部文本需要的高度（含内边距）。量的是显示行：一句被折成
    /// 三行的长句子占三行的高度，否则自动高度的正文会把自己剪掉。还没
    /// 画过（不知道宽度）时退回按逻辑行算。
    int ContentHeight(App app) {
        int n = this.Lines().Count;
        if (wrapTxt == model.Get() && wrapW > 0 && rowStart.Count > 0) {
            n = rowStart.Count;
        }
        if (n < 1) { n = 1; }
        return n * TextArea.LineHeight(app) + app.theme.paddingSmall * 2;
    }

    /// 此框的焦点 id，属主可在渲染前查询它是否获得焦点
    /// （其上的弹层必须决定谁拥有按键）。
    int Id() { return wid; }

    /// 把本帧的按键事件交给调用方而不是文本框。
    void SkipKeysOnce() { skipKeys = true; }

    void SetText(string v) {
        model.Set(v);
        cursorPos = v.Length;
        selAnchor = -1;
        PushBinding();
    }

    /// 将绑定的模型值拉入编辑缓冲区（model -> UI）。
    override void SyncBinding() {
        if (data == null) { return; }
        string cur = data.Get();
        if (cur != model.Get()) {
            model.Set(cur);
            if (cursorPos > cur.Length) { cursorPos = cur.Length; }
        }
    }

    /// 通过绑定把编辑缓冲区写回（UI -> model）。
    void PushBinding() {
        if (data == null) { return; }
        data.Set(model.Get());
    }

    /// 所有 UI 编辑都汇入这里：先写回，再通知。
    void Edited() {
        if (errMsg != "") { errMsg = ""; }
        PushBinding();
        Change.Raise();
    }

    /// 给字段标记校验错误；绘制红色边框，并显示
    /// `msg` 于字段下方，直到用户编辑（或调用 ClearError）。
    void SetError(string msg) {
        errMsg = msg;
    }

    /// 清除待处理的校验错误（任何编辑时自动调用）。
    void ClearError() {
        errMsg = "";
    }

    // ---- 增强：与 Input 同款的校验状态、计数与手动操作 ----------------

    /// 设置校验状态（""/success/warning/error），即 base.css 的字段
    /// 状态类。与 errMsg 互不影响：前者描边，后者带消息。
    void SetStatus(string v) {
        string s = Control.StatusSanitize(v);
        if (s == FieldStatus) { return; }
        FieldStatus = s;
        if (liveApp != null) { liveApp.RequestRedraw(); }
    }

    /// 当前文本的计数值（按 CountGraphemes 口径）。
    int CountOf(string s) {
        if (CountGraphemes) { return Text.Graphemes(s); }
        return Text.Chars(s);
    }

    /// 当前文本的计数值。
    int CountValue() { return this.CountOf(model.Get()); }

    /// 选中全部文本（等同于用户按 Ctrl+A）。
    void SelectAll() {
        selAnchor = 0;
        cursorPos = model.Get().Length;
    }

    /// 清空内容（Naive UI ref.clear()）。触发 Change，光标归零。
    void Clear() {
        if (model.Get() == "") { return; }
        model.Set("");
        cursorPos = 0;
        selAnchor = -1;
        Edited();
        if (liveApp != null) { liveApp.RequestRedraw(); }
    }

    /// 以编程方式把焦点抢到本文本框（Naive UI ref.focus()）。
    /// 禁用态不响应。
    void Focus() {
        if (liveApp == null || this.IsDisabled()) { return; }
        liveApp.focus.SetFocused(wid);
        liveApp.RequestRedraw();
    }

    /// 交出焦点（Naive UI ref.blur()）。
    void Blur() {
        if (liveApp == null) { return; }
        if (liveApp.focus.IsFocused(wid)) { liveApp.focus.ClearFocus(); }
        liveApp.RequestRedraw();
    }

    /// 光标移到文末（渲染沿本就会把光标滚进视口）。
    void ScrollToEnd() {
        cursorPos = model.Get().Length;
        selAnchor = -1;
        if (liveApp != null) { liveApp.RequestRedraw(); }
    }

    /// 光标移到文首。
    void ScrollToStart() {
        cursorPos = 0;
        selAnchor = -1;
        if (liveApp != null) { liveApp.RequestRedraw(); }
    }

    void ClampCursor() {
        string txt = model.Get();
        if (cursorPos > txt.Length) { cursorPos = txt.Length; }
        if (cursorPos < 0) { cursorPos = 0; }
        if (selAnchor > txt.Length) { selAnchor = txt.Length; }
    }

    bool HasSel() { return selAnchor >= 0 && selAnchor != cursorPos; }
    int SelStart() { if (selAnchor >= 0 && selAnchor < cursorPos) { return selAnchor; } return cursorPos; }
    int SelEnd() { if (selAnchor > cursorPos) { return selAnchor; } return cursorPos; }

    string SelText() {
        if (!HasSel()) { return ""; }
        return model.Get().Substring(SelStart(), SelEnd() - SelStart());
    }

    /// 删除选中的范围，并把光标收拢到其起点。
    void DeleteSel() {
        if (!HasSel()) { return; }
        string txt = model.Get();
        int s = SelStart();
        int e = SelEnd();
        model.Set(txt.Substring(0, s) + txt.Substring(e, txt.Length - e));
        cursorPos = s;
        selAnchor = -1;
    }

    /// 插入的唯一闸门：先替换选区，再过宿主过滤器与字符上限。
    /// 被拒绝时完整回滚（选区也还回去）。与 Input 同款：过滤后
    /// 整体被改写时光标按净增字节平移，上限按 CountOf 口径计。
    bool Insert(string s) {
        string orig = model.Get();
        int origCursor = cursorPos;
        int origAnchor = selAnchor;
        bool hadSel = HasSel();
        if (hadSel) { DeleteSel(); }
        string txt = model.Get();
        string cand = Text.InsertAt(txt, cursorPos, s);
        string final = cand;
        if (Filter != null) { final = Filter(cand); }
        if (final == null
            || (MaxLen > 0 && this.CountOf(final) > MaxLen)) {
            model.Set(orig);
            cursorPos = origCursor;
            selAnchor = origAnchor;
            return false;
        }
        int delta = final.Length - cand.Length;
        int cp = cursorPos + s.Length + delta;
        if (cp < 0) { cp = 0; }
        if (cp > final.Length) { cp = final.Length; }
        if (final == txt && cp == cursorPos && !hadSel) {
            // 净零变化（插入即被过滤掉）：不发 Change、不动状态。
            selAnchor = -1;
            return false;
        }
        model.Set(final);
        cursorPos = cp;
        selAnchor = -1;
        Edited();
        return true;
    }

    /// 退格/删除的候选整体再过一次过滤器：删除路径也可能"暴露"
    /// 出非法文本（如 trim 场景删掉词边界字母露出空格）。
    bool DeleteCandidate(string cand) {
        string final = cand;
        if (Filter != null) { final = Filter(cand); }
        if (final == null) { return false; }
        if (final == model.Get()) { return false; }
        model.Set(final);
        if (cursorPos > final.Length) { cursorPos = final.Length; }
        if (selAnchor > final.Length) { selAnchor = final.Length; }
        Edited();
        return true;
    }

    /// 文本按行返回，每次编辑最多拆分一次。
    List<string> Lines() {
        string txt = model.Get();
        if (cacheLines == null || cacheTxt != txt) {
            cacheLines = CodeEditor.SplitLines(txt);
            cacheTxt = txt;
        }
        return cacheLines;
    }

    /// 重算软换行（文本 / 宽度 / 字号变了才算）。
    void Wrap(int maxW, int fs) {
        string txt = model.Get();
        if (wrapTxt == txt && wrapW == maxW && wrapFs == fs
            && rowStart.Count > 0) {
            return;
        }
        wrapTxt = txt;
        wrapW = maxW;
        wrapFs = fs;
        rowStart = new List<int>();
        rowLen = new List<int>();
        List<string> lines = this.Lines();
        int abs = 0;
        for (int i = 0; i < lines.Count; i = i + 1) {
            string ln = lines[i];
            this.WrapLine(ln, abs, maxW, fs);
            abs = abs + ln.Length + 1;
        }
        if (rowStart.Count == 0) {
            rowStart.Add(0);
            rowLen.Add(0);
        }
    }

    /// 一段逻辑行拆成几行显示。宽度还没算出来（maxW <= 0，第一帧）就不拆。
    void WrapLine(string ln, int abs, int maxW, int fs) {
        if (ln.Length == 0 || maxW <= 0) {
            rowStart.Add(abs);
            rowLen.Add(ln.Length);
            return;
        }
        int p = 0;
        while (p < ln.Length) {
            string rest = ln.Substring(p, ln.Length - p);
            if (Canvas.MeasureText(rest, fs) <= maxW) {
                rowStart.Add(abs + p);
                rowLen.Add(rest.Length);
                return;
            }
            // 二分找能装下的最长前缀（量每一个前缀太贵）。
            int lo = 1;
            int hi = rest.Length;
            while (lo < hi) {
                int mid = (lo + hi + 1) / 2;
                if (Canvas.MeasureText(rest.Substring(0, mid), fs) <= maxW) {
                    lo = mid;
                } else {
                    hi = mid - 1;
                }
            }
            // 不在一个多字节字符中间断开，也至少往前走一个字（否则一个比
            // 框还宽的字会让这个循环原地转）。
            lo = Text.ClampCharStart(rest, lo);
            if (lo <= 0) { lo = Text.NextCharEnd(rest, 0); }
            int cut = lo;
            // 能在空格处断就在空格处断，英文单词不被劈开；整段没空格
            // （中文）就按字断。
            int sp = 0 - 1;
            for (int k = 0; k < lo; k = k + 1) {
                if (rest.Substring(k, 1) == " ") { sp = k; }
            }
            if (sp > 0) { cut = sp + 1; }
            rowStart.Add(abs + p);
            rowLen.Add(cut);
            p = p + cut;
        }
    }

    /// 字节位置落在哪一显示行。刚好落在软换行的接缝上时算下一行的行首：
    /// 光标跟着刚敲进去的字走，而那个字已经在下一行了。
    int RowOfPos(int pos) {
        for (int i = 0; i < rowStart.Count; i = i + 1) {
            int e = rowStart[i] + rowLen[i];
            if (pos < e) { return i; }
            if (pos == e) {
                if (i + 1 < rowStart.Count && rowStart[i + 1] == e) {
                    return i + 1;
                }
                return i;
            }
        }
        if (rowStart.Count == 0) { return 0; }
        return rowStart.Count - 1;
    }

    /// 第 `i` 行显示出来的那段文本。
    string RowText(int i) {
        if (i < 0 || i >= rowStart.Count) { return ""; }
        string txt = model.Get();
        int s = rowStart[i];
        int n = rowLen[i];
        if (s > txt.Length) { return ""; }
        if (s + n > txt.Length) { n = txt.Length - s; }
        return txt.Substring(s, n);
    }

    /// 确保显示行算过一次（第一帧还没画过时宽度未知，那就不折行）。
    void EnsureRows() {
        this.Wrap(wrapW, wrapFs);
    }

    void HandleInput(App app) {
        this.EnsureRows();
        this.ClampCursor();
        int kind = app.EventKind();
        string txt = model.Get();

        if (kind == 6) {
            if (readOnly) { return; }
            int code = app.window.EventKeyCode();
            if (code == 8) {
                if (HasSel()) {
                    DeleteSel();
                    Edited();
                    app.RequestRedraw();
                } else if (cursorPos > 0) {
                    int start = Text.PrevCharStart(txt, cursorPos);
                    if (this.DeleteCandidate(Text.DeleteBefore(txt, cursorPos))) {
                        cursorPos = start;
                    }
                    app.RequestRedraw();
                }
            } else if (code == 13) {
                // 换行走同一闸门：上限/过滤对 Enter 同样生效。
                if (this.Insert("\n")) { app.RequestRedraw(); }
            } else if (code == 9) {
                if (this.Insert("  ")) { app.RequestRedraw(); }
            } else {
                string ch = Text.CharStr(code);
                if (ch.Length > 0) {
                    if (this.Insert(ch)) { app.RequestRedraw(); }
                }
            }
        } else if (kind == 4) {
            int kc = app.window.EventKeyCode();
            int mods = app.window.EventMods();
            bool shift = Modifiers.HasShift(mods);
            bool ctrl = Modifiers.HasCtrl(mods);
            if (ctrl && kc == 65) {
                // Ctrl+A：全选。
                selAnchor = 0;
                cursorPos = txt.Length;
                app.RequestRedraw();
            } else if (ctrl && kc == 67) {
                // Ctrl+C：复制选区（无选区时复制全文）。
                if (HasSel()) { Clipboard.SetText(SelText()); }
                else { Clipboard.SetText(txt); }
            } else if (ctrl && kc == 88) {
                // Ctrl+X：剪切。
                if (readOnly) { return; }
                if (HasSel()) {
                    Clipboard.SetText(SelText());
                    DeleteSel();
                    Edited();
                    app.RequestRedraw();
                }
            } else if (ctrl && kc == 86) {
                // Ctrl+V：粘贴并覆盖选区（整段走同一过滤+上限闸门）。
                if (readOnly) { return; }
                string clip = Clipboard.GetText();
                if (clip.Length > 0) {
                    if (this.Insert(clip)) { app.RequestRedraw(); }
                }
            } else if (kc == 37 || kc == 39 || kc == 38 || kc == 40
                       || kc == 36 || kc == 35) {
                // 导航键：Shift 从光标处扩展选区，普通移动收起选区。
                if (shift) {
                    if (selAnchor < 0) { selAnchor = cursorPos; }
                } else {
                    selAnchor = -1;
                }
                if (kc == 37) {
                    if (cursorPos > 0) { cursorPos = Text.PrevCharStart(txt, cursorPos); }
                    app.RequestRedraw();
                } else if (kc == 39) {
                    if (cursorPos < txt.Length) { cursorPos = Text.NextCharEnd(txt, cursorPos); }
                    app.RequestRedraw();
                } else if (kc == 38 || kc == 40) {
                    // 上/下走的是看得见的行（软换行后的显示行）：一句被折成
                    // 三行的长句子里按下就该到第二行，而不是跳到下一段。
                    int caretRow = this.RowOfPos(cursorPos);
                    int caretCol = cursorPos - rowStart[caretRow];
                    int target = caretRow - 1;
                    if (kc == 40) { target = caretRow + 1; }
                    if (target >= 0 && target < rowStart.Count) {
                        int col = caretCol;
                        if (col > rowLen[target]) { col = rowLen[target]; }
                        cursorPos = rowStart[target] + col;
                        app.RequestRedraw();
                    }
                } else if (kc == 36) {
                    cursorPos = rowStart[this.RowOfPos(cursorPos)];
                    app.RequestRedraw();
                } else if (kc == 35) {
                    int caretRow = this.RowOfPos(cursorPos);
                    cursorPos = rowStart[caretRow] + rowLen[caretRow];
                    app.RequestRedraw();
                }
            } else if (kc == 46) {
                if (readOnly) { return; }
                if (HasSel()) {
                    DeleteSel();
                    Edited();
                    app.RequestRedraw();
                } else if (cursorPos < txt.Length) {
                    if (this.DeleteCandidate(Text.RemoveAt(txt, cursorPos))) {
                        app.RequestRedraw();
                    }
                }
            }
        }
    }

    /// 鸠标位置对应的字节偏移（行高/滚动位置均取当前帧）。按显示行算：
    /// 点在折下来那半句上，光标就落在那半句里。
    int PosFromMouse(App app, int innerX, int innerY, int lineH, int fs) {
        int row = (app.mouseY - innerY + scrollY) / lineH;
        if (row < 0) { row = 0; }
        if (row >= rowStart.Count) { row = rowStart.Count - 1; }
        if (row < 0) { return 0; }
        int col = CodeEditor.ColFromX(this.RowText(row), app.mouseX - innerX,
                                     fs);
        return rowStart[row] + col;
    }

    int Render(App app, int x, int y, int w, int h) {
        int id = wid;
        Canvas c = app.canvas;
        Theme t = app.theme;
        // 事件回调没有 app 形参，渲染沿记一笔宿主供手动操作使用。
        liveApp = app;

        bool off = this.IsDisabled();
        app.focus.RegisterFocusable(id);
        bool focused = app.focus.IsFocused(id) && !off;

        // 校验状态与圆角：与 Input 同款，把类并进 Class 再解析
        // （渲染末恢复，避免设计器读到污染字段），base.css 的
        // `.success/.warning/.error` 与 `.round` 规则负责外观。
        string origClass = Class;
        string stCls = Control.StatusSanitize(FieldStatus);
        if (stCls != "") { this.AddClass(stCls); }
        if (Round) { this.AddClass("round"); }

        if (focused && !skipKeys) { this.HandleInput(app); }
        skipKeys = false;

        SyncBinding();
        string txt = model.Get();
        this.ClampCursor();

        // 外框（填充、边框、圆角、hover/focus 淡变）全部来自样式层，
        // 皮肤的 `textarea:hover / textarea:focus` 规则即可重设。
        StyleBox s = this.ResolveEasedStyleAsIn(
            app, id, "textarea", Class, off, false, x, y, w, h);
        if (!readOnly) { s.Paint(app, x, y, w, h); }
        int fs = s.FontOr(Style.FontFallback(app, "medium"));
        // 校验错误：颜色与线宽来自 `textarea::error` 部件（在样式层之后
        // 绘制，皮肤可改写该部件但无法被普通边框规则冲淡）。
        StyleBox errorStyle = new StyleBox();
        if (errMsg != "") {
            errorStyle = this.ResolvePartAs(app, "textarea", "error", "",
                                            Class, Style.SNormal());
            c.DrawRect(x, y, w, h, errorStyle.BorderOr(errorStyle.fg),
                       errorStyle.BorderWOr(2));
        }

        int pad = s.PadLOr(t.paddingSmall);
        int innerX = x + pad;
        int innerY = y + pad;
        int innerW = w - pad * 2;
        int innerH = h - pad * 2;
        int lineH = TextArea.LineHeight(app);

        // 折行宽度给滚动条留出位置，否则溢出时每行的最后几个字会被滚
        // 动条盖住（而且“溢出才变窄”会在两种折法之间来回跳）。
        int wrapWidth = innerW - app.Scale(10);
        if (wrapWidth < app.Scale(24)) { wrapWidth = innerW; }
        this.Wrap(wrapWidth, fs);
        int contentH = rowStart.Count * lineH;

        int caretRow = this.RowOfPos(cursorPos);
        int caretCol = cursorPos - rowStart[caretRow];
        if (caretCol < 0) { caretCol = 0; }
        if (caretCol > rowLen[caretRow]) { caretCol = rowLen[caretRow]; }

        // 保持光标可见（仅在获得焦点 / 正在编辑时）。
        if (focused) {
            int caretTop = caretRow * lineH;
            if (caretTop < scrollY) { scrollY = caretTop; }
            if (caretTop + lineH > scrollY + innerH) {
                scrollY = caretTop + lineH - innerH;
            }
        }

        bool overBox = app.mouseX >= x && app.mouseX < x + w
            && app.mouseY >= y && app.mouseY < y + h;
        bool ownsWheel = false;
        if (overBox) { ownsWheel = app.CaptureWheel(x, y, w, h); }
        if (ownsWheel) {
            int d = app.window.EventKeyCode();
            scrollY = scrollY - d * app.scrollSpeed / 120;
            app.RequestRedraw();
        }
        int maxScroll = contentH - innerH;
        if (maxScroll < 0) { maxScroll = 0; }
        if (scrollY > maxScroll) { scrollY = maxScroll; }
        if (scrollY < 0) { scrollY = 0; }

        c.PushClip(innerX, innerY, innerW, innerH);
        if (txt == "" && !focused) {
            StyleBox placeholderStyle = this.ResolvePartAs(
                app, "textarea", "placeholder", "", Class, Style.SNormal());
            c.DrawText(innerX, innerY, hint, placeholderStyle.FgOr(s.fg),
                       placeholderStyle.FontOr(fs));
        } else {
            if (focused && HasSel()) {
                // 选区高亮画在文本下面，每行取它与选区的交集；
                // 含换行的行尾多画一个空格宽，使跳行可见。
                int selS = SelStart();
                int selE = SelEnd();
                StyleBox selectionStyle = this.ResolvePartAs(
                    app, "textarea", "selection", "", Class, Style.SNormal());
                int selColor = selectionStyle.BgOr(s.accent);
                int nlW = Canvas.MeasureText(" ", fs);
                for (int i = 0; i < rowStart.Count; i = i + 1) {
                    int lineStart = rowStart[i];
                    int lineEnd = lineStart + rowLen[i];
                    int rs = selS;
                    int re = selE;
                    if (rs < lineStart) { rs = lineStart; }
                    if (re > lineEnd) { re = lineEnd; }
                    if (rs <= re && selE > lineStart && selS <= lineEnd) {
                        string rt = this.RowText(i);
                        int ly = innerY + i * lineH - scrollY;
                        int x0 = Canvas.MeasureText(rt.Substring(0, rs - lineStart), fs);
                        int x1 = Canvas.MeasureText(rt.Substring(0, re - lineStart), fs);
                        int selW = x1 - x0;
                        if (selE > lineEnd) { selW = selW + nlW; }
                        c.FillRect(innerX + x0, ly, selW, Canvas.FontHeight(fs), selColor);
                    }
                }
            }
            for (int i = 0; i < rowStart.Count; i = i + 1) {
                int ly = innerY + i * lineH - scrollY;
                if (ly + lineH > innerY && ly < innerY + innerH) {
                    c.DrawText(innerX, ly, this.RowText(i), s.fg, fs);
                }
            }
            if (focused && !readOnly) {
                StyleBox caretStyle = this.ResolvePartAs(
                    app, "textarea", "caret", "", Class, Style.SNormal());
                int caretX = innerX + Canvas.MeasureText(
                    this.RowText(caretRow).Substring(0, caretCol), fs);
                int caretY = innerY + caretRow * lineH - scrollY;
                int fh = Canvas.FontHeight(fs);
                c.FillRect(caretX, caretY, caretStyle.WidthOr(1), fh,
                           caretStyle.BgOr(caretStyle.FgOr(s.accent)));
                // 让 IME 组合窗口跟随光标。
                app.SetImeCaret(caretX, caretY + fh);
            }
        }
        c.PopClip();

        // 内容溢出时的垂直滚动条（限制 + 裁剪）。
        if (contentH > innerH && innerH > 0) {
            StyleBox sbStyle = this.ResolvePartAs(
                app, "textarea", "scrollbar", "", Class, Style.SNormal());
            StyleBox sbTrack = this.ResolvePartAs(
                app, "textarea", "scrollbar-track", "", Class,
                Style.SNormal());
            int barW = sbStyle.WidthOr(app.Scale(6));
            int barX = x + w - barW - app.Scale(2);
            int minThumb = app.Scale(24);
            if (minThumb > innerH) { minThumb = innerH; }
            int thumbH = innerH * innerH / contentH;
            if (thumbH < minThumb) { thumbH = minThumb; }
            if (thumbH > innerH) { thumbH = innerH; }
            int travel = innerH - thumbH;
            if (travel < 0) { travel = 0; }
            int thumbY = innerY;
            if (maxScroll > 0) { thumbY = innerY + scrollY * travel / maxScroll; }
            if (thumbY < innerY) { thumbY = innerY; }
            if (thumbY + thumbH > innerY + innerH) { thumbY = innerY + innerH - thumbH; }
            c.PushClip(innerX, innerY, innerW, innerH);
            if (sbTrack.bg != 0) {
                c.FillRoundRect(barX, innerY, barW, innerH, barW / 2,
                                sbTrack.bg);
            }
            c.FillRoundRect(barX, thumbY, barW, thumbH, barW / 2,
                            sbStyle.BgOr(s.fg));
            c.PopClip();
        }

        // 校验消息显示在字段下方（在内容裁剪区之外绘制，
        // 不会被 PopClip 截掉）。
        if (errMsg != "") {
            c.DrawText(x, y + h + app.Scale(2), errMsg,
                       errorStyle.FgOr(s.fg),
                       errorStyle.FontOr(Style.FontFallback(app, "small")));
        }
        // 字数统计（Naive UI show-count）：框外右下角，与 errMsg
        // 同排左右分置；口径与 MaxLen 一致（CountOf）。
        if (ShowCount) {
            StyleBox countStyle = this.ResolvePartAs(
                app, "textarea", "count", "", Class, Style.SNormal());
            int cfs = countStyle.FontOr(Style.FontFallback(app, "small"));
            string countTxt = Input.CountText(this.CountOf(txt), MaxLen);
            int cw = Canvas.MeasureText(countTxt, cfs);
            c.DrawText(x + w - cw, y + h + app.Scale(2), countTxt,
                       countStyle.FgOr(s.fg), cfs);
        }

        app.hitTester.RegisterRect(id, x, y, w, h, 1);

        // 鼠标选择：按下锚定选区并放置光标，按住拖动移动活动端。
        if (Ui.PressedDown(app, id) && !off) {
            cursorPos = this.PosFromMouse(app, innerX, innerY, lineH, fs);
            if (!Modifiers.HasShift(app.window.EventMods()) || selAnchor < 0) {
                selAnchor = cursorPos;
            }
            this.ClampCursor();
            app.RequestRedraw();
        } else if (focused && app.focus.IsPressed(id) && app.EventKind() == 1) {
            int drag = this.PosFromMouse(app, innerX, innerY, lineH, fs);
            if (drag != cursorPos) {
                cursorPos = drag;
                this.ClampCursor();
                app.RequestRedraw();
            }
        }
        // 单消费者点击：当此区域是框架解析出的点击
        // 目标时放置光标。
        if (Ui.Clicked(app, id) && !off) {
            cursorPos = this.PosFromMouse(app, innerX, innerY, lineH, fs);
            if (selAnchor == cursorPos) { selAnchor = -1; }
            this.ClampCursor();
            app.RequestRedraw();
        }
        if (!focused && selAnchor >= 0) { selAnchor = -1; }

        // 恢复 Class，避免设计器/序列化器读到污染字段。
        Class = origClass;

        On.Fire(app, id);
        return id;
    }

    // --- 设计器 / 序列化模型 ---

    override string Kind() { return "TextArea"; }

    override string StyleType() { return "textarea"; }

    override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec ph = PropSpec.Text("hint", "Placeholder");
        ph.str = hint;
        ph.Also("placeholder");
        ps.Add(ph);
        ps.Add(PropSpec.Text("text", "Text"));
        PropSpec st = PropSpec.Enum("status", "Status",
            new List<string>{ "", "success", "warning", "error" });
        st.str = FieldStatus;
        ps.Add(st);
        PropSpec ml = PropSpec.Int("maxlen", "MaxLen");
        ml.num = MaxLen;
        ml.Step(1, 0, 4096);
        ps.Add(ml);
        PropSpec sc = PropSpec.Bool("showCount", "ShowCount");
        sc.flag = ShowCount;
        ps.Add(sc);
        PropSpec rd = PropSpec.Bool("round", "Round");
        rd.flag = Round;
        ps.Add(rd);
        return ps;
    }

    /// 文本经由 SetText 写入，使光标保持在范围内。
    override string GetExtra(string key) {
        if (key == "text" || key == "value") { return model.Get(); }
        return "";
    }

    override bool SetExtra(string key, string val) {
        if (key == "text" || key == "value") {
            // 值没变就别碰光标/选区：属性写入可能每帧都来，而 SetText 的语义是
            // 「换了一段文本」——光标收到末尾。
            if (val != model.Get()) { this.SetText(val); }
            return true;
        }
        if (key == "status") { this.SetStatus(val); return true; }
        if (key == "maxlen") { MaxLen = Convert.ToInt32(val); return true; }
        if (key == "showCount") { ShowCount = (val == "true"); return true; }
        if (key == "round") { Round = (val == "true"); return true; }
        if (key == "countGraphemes") {
            CountGraphemes = (val == "true"); return true;
        }
        return false;
    }

    override List<string> Events() {
        List<string> e = Control.CommonEvents();
        e.Add("Change");
        return e;
    }

    override void BindEvent(string evt, Action a) {
        if (evt == "Change") { Change.Add(a); return; }
        On.AddByName(evt, a);
    }

    // --- 保留式钩子（Control） ---

    /// 框外底行（show-count 文本与校验消息共用同一排，框下沿 2px 起）。
    /// 父容器渲染子树时会把自己的矩形作为裁剪带（Control.RenderTree 的
    /// PushClip），越出测量高度的绘制会被整条裁掉——所以这一行必须计入
    /// 测量高度，框体本身相应只占 bh - 本值，Render 内的描边/命中矩形
    /// 仍是框的真实高度。
    int BottomRowH(App app) {
        if (!ShowCount && errMsg == "") { return 0; }
        StyleBox cs = this.ResolvePartAs(app, "textarea", "count", "",
                                         Class, Style.SNormal());
        int cfs = cs.FontOr(Style.FontFallback(app, "small"));
        return app.Scale(2) + Canvas.FontHeight(cfs) + app.Scale(2);
    }

    override void OnMeasure(App app) {
        Theme t = app.theme;
        StyleBox s = this.ResolveStyleAs(app, "textarea", Class, Style.SNormal());
        if (autoHeight) { prefH = this.ContentHeight(app); }
        else { prefH = s.HeightOr(app.Scale(90)); }
        prefH += this.BottomRowH(app);
        prefW = s.WidthOr(app.Scale(220));
    }

    override void OnPaint(App app) {
        this.Render(app, bx, by, bw, bh - this.BottomRowH(app));
    }
}
