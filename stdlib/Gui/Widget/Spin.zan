using System;
using Gui;
using Gui.Backend;

namespace Gui.Widget;

/// 动画加载指示器：一圈圆点，带旋转的高亮头部和
/// 渐隐的尾迹。颜色来自 `spin` CSS 规则（accent 是头部，background 是静止圆点），
/// 皮肤可重设样式，而代码侧
/// 只需简单赋值：
///
///     Spin s = new Spin { Size = 36, Class = "info" };
///
/// 类：语义角色（`primary` … `error`）决定强调色，尺寸
/// 级别（`tiny` … `large`）决定直径。
class Spin : Control {
    /// 直径（CSS px）；`width` / `height` 规则优先于此值。
    int Size;
    /// 圆点颜色；0 表示采用 `spin` 规则的 accent（在自己内容中绘制加载指示器的宿主，
    /// 如加载中的按钮，可设置其前景色）。
    int Accent;
    /// 圆点下方的说明文字（由 `spin::label` 部件设置样式）；空表示
    /// 纯指示器。
    Binding<string> Tip;

    void InitSpin(int size) {
        this.InitControl("spin", 1);
        Size = size;
        Accent = 0;
        Tip = "";
    }

    Spin() { InitSpin(36); }
    Spin(int size) { InitSpin(size); }

    int Diameter(App app) {
        return this.ResolveStyleAs(app, "spin", Class, Style.SNormal())
            .HeightOr(app.Scale(Size));
    }

    string Caption() {
        if (Tip == null) { return ""; }
        return Tip.Get();
    }

    int TipFont(App app) {
        return Style.Part(app, "spin", "label", "", "", "", Style.SNormal())
            .FontOr(app.theme.fontSizeSmall);
    }

    override void OnMeasure(App app) {
        prefW = this.Diameter(app);
        prefH = prefW;
        if (this.Caption() == "") { return; }
        prefH = prefH + app.theme.gapMedium
              + Canvas.FontHeight(this.TipFont(app));
    }

    override void OnPaint(App app) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        StyleBox s = this.ResolveStyleAs(app, "spin", Class, Style.SNormal());
        int accent = Accent;
        if (accent == 0) { accent = s.AccentOr(t.primary); }
        int rest = s.BgOr(t.bgTertiary);
        string tip = this.Caption();
        int dots = bh;
        if (tip != "") {
            dots = this.Diameter(app);
            int fs = this.TipFont(app);
            c.DrawTextCentered(bx, by + dots + app.theme.gapMedium, bw,
                               Canvas.FontHeight(fs), tip,
                               Style.Part(app, "spin", "label", "", "", "",
                                          Style.SNormal())
                                   .FgOr(t.textSecondary), fs);
        }
        int box = bw;
        if (dots < box) { box = dots; }
        int radius = box / 2;
        int cx = bx + bw / 2;
        int cy = by + dots / 2;
        int dotR = radius / 4;
        if (dotR < app.Scale(2)) { dotR = app.Scale(2); }
        // 墙钟相位（每 90ms 一步），使旋转速度固定，
        // 与页面实际重绘频率无关。
        int active = (Window.GetTickMs() / 90) % 8;
        for (int i = 0; i < 8; i = i + 1) {
            int px = cx + PivotSafeMul(Spin.OffX(i), radius);
            int py = cy + PivotSafeMul(Spin.OffY(i), radius);
            int d = (active - i + 8) % 8;
            int dc = rest;
            int dr = dotR;
            switch (d) {
                case 0: dc = accent; dr = dotR + app.Scale(1); break;
                case 1: dc = accent; break;
                case 2: dc = t.textTertiary; break;
                case 3: dc = t.borderPrimary; break;
                default: break;
            }
            c.FillCircle(px, py, dr, dc);
        }
        // 仅当指示器真正在屏幕上时才保持页面重绘。
        // 屏幕外的指示器（如随长页面滚出视野）
        // 不得驱动重绘，否则会空转动画占满 CPU。
        // 可见时将帧率限制到约 11fps，而不是 60fps 忙循环。
        if (Spin.OnScreen(app, cx, cy, radius)) {
            int span = radius + dotR + app.Scale(2);
            app.RequestAnimationFrameIn(90, cx - span, cy - span, span * 2, span * 2);
        }
    }


    // 8 个单位圆偏移（x1000），每 45 度一步，从顶部开始。
    static int OffX(int i) {
        switch (i) {
            case 0: return 0;
            case 1: return 707;
            case 2: return 1000;
            case 3: return 707;
            case 4: return 0;
            case 5: return -707;
            case 6: return -1000;
            default: return -707;
        }
    }

    static int OffY(int i) {
        switch (i) {
            case 0: return -1000;
            case 1: return -707;
            case 2: return 0;
            case 3: return 707;
            case 4: return 1000;
            case 5: return 707;
            case 6: return 0;
            default: return -707;
        }
    }





    /// 指示器包围盒与窗口表面重叠时返回 true。
    static bool OnScreen(App app, int cx, int cy, int radius) {
        int w = app.canvas.Width();
        int h = app.canvas.Height();
        return cx + radius >= 0 && cx - radius <= w
            && cy + radius >= 0 && cy - radius <= h;
    }

    // (offset_x1000 * radius) / 1000，避免溢出意外。
    static int PivotSafeMul(int per1000, int radius) {
        return (per1000 * radius) / 1000;
    }


    // ---- 设计器 / 序列化模型 -------------------------------------

    override string Kind() { return "Spin"; }

    override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec size = PropSpec.Int("size", "Size");
        size.num = Size;
        ps.Add(size);
        PropSpec tip = PropSpec.Text("tip", "Tip");
        tip.str = Tip;
        ps.Add(tip);
        ps.Add(PropSpec.Text("class", "Classes"));
        return ps;
    }
}
