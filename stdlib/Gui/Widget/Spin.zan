using System;
using Gui;

namespace Gui.Widget;

/// An animated loading spinner: a ring of dots with a rotating bright head and
/// a fading trail. Colour comes from the `spin` CSS rules (its accent is the
/// head, its background the resting dots), so a skin restyles it and the code
/// side is plain assignment:
///
///     Spin s = new Spin { Size = 36, Class = "info" };
///
/// Classes: the semantic roles (`primary` … `error`) pick the accent, the size
/// scale (`tiny` … `large`) its diameter.
class Spin : Control {
    /// Diameter in CSS px; a `width` / `height` rule wins over it.
    int Size;

    void InitSpin(int size) {
        this.InitControl("spin", 1);
        Size = size;
    }

    Spin() { InitSpin(36); }
    Spin(int size) { InitSpin(size); }

    int Diameter(App app) {
        return this.ResolveStyleAs(app, "spin", Class, Style.SNormal())
            .HeightOr(app.Scale(Size));
    }

    override void OnMeasure(App app) {
        prefW = this.Diameter(app);
        prefH = prefW;
    }

    override void OnPaint(App app) {
        int d = this.Diameter(app);
        Spin.Paint(app, bx + d / 2, by + d / 2, d / 2, Class);
    }

    // 8 unit-circle offsets (x1000) at 45-degree steps, starting at the top.
    static int OffX(int i) {
        switch (i) {
            case 0: return 0;
            case 1: return 707;
            case 2: return 1000;
            case 3: return 707;
            case 4: return 0;
            case 5: return -707;
            case 6: return -1000;
            default: return -707;
        }
    }

    static int OffY(int i) {
        switch (i) {
            case 0: return -1000;
            case 1: return -707;
            case 2: return 0;
            case 3: return 707;
            case 4: return 1000;
            case 5: return 707;
            case 6: return 0;
            default: return -707;
        }
    }

    /// A spinner of `radius` centred on (cx, cy) in the style `cls` selects.
    static void Paint(App app, int cx, int cy, int radius, string cls) {
        StyleBox s = Style.Of(app, "spin", cls, Style.SNormal());
        Spin.Dots(app, cx, cy, radius, s.AccentOr(app.theme.primary),
                  s.BgOr(app.theme.bgTertiary));
    }

    /// A spinner in a caller-supplied colour, for painters that carry their own
    /// accent (a button's busy state, a syntax-coloured log line).
    static void Render(App app, int cx, int cy, int radius, int color) {
        Spin.Dots(app, cx, cy, radius, color,
                  Style.Of(app, "spin", "", Style.SNormal())
                      .BgOr(app.theme.bgTertiary));
    }

    static void Dots(App app, int cx, int cy, int radius, int color, int rest) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int dotR = radius / 4;
        if (dotR < app.Scale(2)) { dotR = app.Scale(2); }
        // Wall-clock phase (one step every 90ms) so the spin rate is fixed
        // regardless of how often the page actually repaints.
        int active = (Window.GetTickMs() / 90) % 8;
        int i = 0;
        while (i < 8) {
            int px = cx + PivotSafeMul(Spin.OffX(i), radius);
            int py = cy + PivotSafeMul(Spin.OffY(i), radius);
            int d = (active - i + 8) % 8;
            int dc = rest;
            int dr = dotR;
            switch (d) {
                case 0: dc = color; dr = dotR + app.Scale(1); break;
                case 1: dc = color; break;
                case 2: dc = t.textTertiary; break;
                case 3: dc = t.borderPrimary; break;
                default: break;
            }
            c.FillCircle(px, py, dr, dc);
            i = i + 1;
        }
        // Only keep the page repainting while the spinner is actually on
        // screen. An off-screen spinner (e.g. scrolled out of a long page)
        // must not drive repaints, or it pins the CPU animating nothing.
        // When visible, throttle to ~11fps instead of a 60fps busy loop.
        if (Spin.OnScreen(app, cx, cy, radius)) { app.RequestAnimationFrame(90); }
    }

    /// True when the spinner's bounding box overlaps the window surface.
    static bool OnScreen(App app, int cx, int cy, int radius) {
        int w = app.canvas.Width();
        int h = app.canvas.Height();
        return cx + radius >= 0 && cx - radius <= w
            && cy + radius >= 0 && cy - radius <= h;
    }

    // (offset_x1000 * radius) / 1000 without overflow surprises.
    static int PivotSafeMul(int per1000, int radius) {
        return (per1000 * radius) / 1000;
    }

    /// Spinner with a caption below it, centered in a box. The caption is the
    /// `spin::label` part.
    static void WithTip(App app, int x, int y, int w, int h, string tip) {
        Theme t = app.theme;
        int cx = x + w / 2;
        int cy = y + h / 2 - app.Scale(10);
        Spin.Paint(app, cx, cy, app.Scale(18), "");
        if (tip == "") { return; }
        StyleBox ls = Style.Part(app, "spin", "label", "", "", "",
                                 Style.SNormal());
        int fs = ls.FontOr(t.fontSizeSmall);
        app.canvas.DrawTextCentered(x, cy + app.Scale(30), w,
                                    Canvas.FontHeight(fs), tip,
                                    ls.FgOr(t.textSecondary), fs);
    }

    // ---- designer / serialization model -------------------------------------

    override string Kind() { return "Spin"; }

    override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec size = PropSpec.Int("size", "Size");
        size.num = Size;
        ps.Add(size);
        ps.Add(PropSpec.Text("class", "Classes"));
        return ps;
    }
}
