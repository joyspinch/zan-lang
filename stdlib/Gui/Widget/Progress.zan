using System;
using Gui;

namespace Gui.Widget;

/// 带类型变体的进度指示器。
/// 类型：default(1)、info(2)、success(3)、warning(4)、error(5)
/// 形状：线性轨道条（Render / RenderText）或圆环
/// （Circle），两者都可选标注数字百分比。
class Progress : Control {
    int percent;
    /// 绑定百分比：`p.data = task.progress;` 每帧重新读取模型字段
    /// （编译器降级的 Binding）；设置后覆盖 `percent`。
    Binding<int> data;
    int ptype;
    /// 0 = 线性条，1 = 圆环。
    int shape;

    void InitProgress(int pct, int pt) {
        this.InitControl("progress", 1);
        percent = pct;
        ptype = pt;
        shape = 0;
    }

    /// Default design-time constructor; properties configure the value later.
    Progress() : this(0, 1) { }

    /// 有状态模式构造函数：`Progress p = new Progress(60, 3);`
    Progress(int pct, int pt) {
        InitProgress(pct, pt);
    }

    void SetPercent(int pct) {
        percent = pct;
        if (data != null) { data.Set(pct); }
    }

    /// 当前百分比：设置了绑定时返回绑定的模型值。
    int Percent() {
        if (data != null) { return data.Get(); }
        return percent;
    }

    /// 将此实例切换为圆环形状（可链式调用）。
    Progress Ring() {
        shape = 1;
        return this;
    }

    override string Kind() { return "Progress"; }

    override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        ps.Add(PropSpec.Int("percent", "Percent"));
        PropSpec ty = PropSpec.Enum("type", "Type", new List<string>());
        ty.Option("default"); ty.Option("info"); ty.Option("success");
        ty.Option("warning"); ty.Option("error");
        ty.num = ptype;
        ps.Add(ty);
        PropSpec sh = PropSpec.Enum("shape", "Shape", new List<string>());
        sh.Option("bar"); sh.Option("ring");
        sh.num = shape;
        ps.Add(sh);
        return ps;
    }

    /// 显示的百分比可能来自绑定值，因此通过
    /// Percent() 读取，且只写入本地字段。
    override string GetExtra(string key) {
        if (key == "percent") { return Convert.ToString(this.Percent()); }
        return "";
    }

    override bool SetExtra(string key, string val) {
        if (key != "percent") { return false; }
        percent = Convert.ToInt32(val);
        return true;
    }

    void PaintBar(App app, int pct) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        StyleBox trackStyle = this.ResolvePartAs(app, "progress", "track", "",
                                                 Class, Style.SNormal());
        StyleBox fillStyle = this.ResolvePartAs(app, "progress", "fill", "",
                                                Class, Style.SNormal());
        StyleBox labelStyle = this.ResolvePartAs(app, "progress", "label", "",
                                                 Class, Style.SNormal());
        int fs = labelStyle.FontOr(t.fontSizeSmall);
        bool showLabel = labelStyle.display != 2 && labelStyle.visible != 0;
        int labelW = 0;
        int gp = t.gapSmall;
        if (computedStyle != null) { gp = computedStyle.GapOr(gp); }
        if (showLabel) { labelW = Canvas.MeasureText("100%", fs) + gp; }
        int barW = bw - labelW;
        if (barW < app.Scale(20)) { barW = bw; labelW = 0; showLabel = false; }
        int trackH = trackStyle.HeightOr(app.Scale(8));
        if (trackH < 1) { trackH = 1; }
        int trackY = by + (bh - trackH) / 2;
        int fillW = pct * barW / 100;
        c.FillRoundRect(bx, trackY, barW, trackH,
                        trackStyle.RadiusOr(trackH / 2),
                        trackStyle.BgOr(t.bgTertiary));
        if (fillW > 0) {
            int fillH = fillStyle.HeightOr(trackH);
            if (fillH < 1) { fillH = 1; }
            int fillY = trackY + (trackH - fillH) / 2;
            c.FillRoundRect(bx, fillY, fillW, fillH,
                            fillStyle.RadiusOr(fillH / 2),
                            fillStyle.BgOr(Progress.FillColor(t, ptype)));
        }
        if (showLabel) {
            int ty = Canvas.CenterTextY(by, bh, fs);
            c.DrawText(bx + barW + gp, ty, Convert.ToString(pct) + "%",
                       labelStyle.FgOr(t.textSecondary), fs);
        }
    }

    void PaintRing(App app, int pct) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        StyleBox trackStyle = this.ResolvePartAs(app, "progress", "track", "",
                                                 Class, Style.SNormal());
        StyleBox fillStyle = this.ResolvePartAs(app, "progress", "fill", "",
                                                Class, Style.SNormal());
        StyleBox labelStyle = this.ResolvePartAs(app, "progress", "label", "",
                                                 Class, Style.SNormal());
        int size = bw;
        if (bh < size) { size = bh; }
        if (size < 2) { return; }
        int radius = size / 2;
        int cx = bx + bw / 2;
        int cy = by + bh / 2;
        int thick = trackStyle.BorderWOr(app.Scale(7));
        if (thick < 1) { thick = 1; }
        if (thick >= radius) { thick = radius - 1; }
        int inner = radius - thick;
        c.FillSector(cx, cy, inner, radius, 0, 360,
                     trackStyle.BgOr(t.bgTertiary));
        int sweep = 360 * pct / 100;
        if (sweep > 0) {
            c.FillSector(cx, cy, inner, radius, 0, sweep,
                         fillStyle.BgOr(fillStyle.AccentOr(Progress.FillColor(t, ptype))));
        }
        if (labelStyle.display != 2 && labelStyle.visible != 0) {
            int fs = labelStyle.FontOr(t.fontSizeMedium);
            c.DrawTextCentered(bx, by, bw, bh, Convert.ToString(pct) + "%",
                               labelStyle.FgOr(t.textPrimary), fs);
        }
    }

    override void OnMeasure(App app) {
        StyleBox root = this.ResolveStyleAs(app, "progress", Class,
                                            Style.SNormal());
        if (shape == 1) {
            prefH = root.HeightOr(app.Scale(72));
            prefW = root.WidthOr(app.Scale(72));
        } else {
            StyleBox trackStyle = this.ResolvePartAs(app, "progress", "track", "",
                                                     Class, Style.SNormal());
            StyleBox labelStyle = this.ResolvePartAs(app, "progress", "label", "",
                                                     Class, Style.SNormal());
            int contentH = trackStyle.HeightOr(app.Scale(8));
            if (labelStyle.fontPx > 0 && labelStyle.display != 2
                    && labelStyle.visible != 0) {
                int labelH = Canvas.FontHeight(labelStyle.fontPx);
                if (labelH > contentH) { contentH = labelH; }
            }
            prefH = root.HeightOr(contentH);
            prefW = root.WidthOr(app.Scale(200));
        }
    }

    override void OnPaint(App app) {
        int pct = Progress.Clamp(Percent());
        if (shape == 1) {
            this.PaintRing(app, pct);
        } else {
            this.PaintBar(app, pct);
        }
    }

    /// 解析进度类型对应的填充色。
    static int FillColor(Theme t, int ptype) {
        if (ptype == 2) { return t.info; }
        if (ptype == 3) { return t.success; }
        if (ptype == 4) { return t.warning; }
        if (ptype == 5) { return t.error; }
        return t.primary;
    }

    static int Clamp(int percent) {
        if (percent < 0) { return 0; }
        if (percent > 100) { return 100; }
        return percent;
    }



}
