using System;
using Gui;

namespace Gui.Widget;

/// Named dock sides, so layouts read `DockSide.Left()` instead of a magic int.
/// Left/Right are full-height columns, Bottom is a strip under the center, and
/// Center is the area everything else docks around.
class DockSide {
    static int Left() { return 0; }
    static int Right() { return 1; }
    static int Bottom() { return 2; }
    static int Center() { return 3; }
}

/// One dockable panel: a stable id (used for persistence and lookups), the
/// title shown on its tab, and the content rect resolved by the last layout.
/// `headerless` panels (the document area of an IDE) draw no tab and cannot be
/// dragged or closed -- everything else docks around them.
class DockPanel {
    string id;
    string title;
    /// Icon name for the host's panel switch (see DockHost.AddSwitches).
    string icon;
    /// One line on what the panel is for, shown by its switch's hover tip.
    string tip;
    bool closable;
    bool headerless;
    bool hidden;
    /// The side the panel was last docked to -- where Show() puts it back.
    int home;
    Rect body;

    static DockPanel Create(string id, string title, bool closable) {
        DockPanel p = new DockPanel();
        p.id = id;
        p.title = title;
        p.icon = "grid";
        p.tip = "";
        p.closable = closable;
        p.headerless = false;
        p.hidden = false;
        p.home = DockSide.Left();
        p.body = Rect.Create(0, 0, 0, 0);
        return p;
    }
}

/// A stack of panels sharing one region: the tab strip on top, the active
/// panel's content below. Groups of a side are laid out along that side's
/// cross axis (left/right stack vertically, bottom/center sit side by side)
/// with a draggable handle between neighbours.
class DockGroup {
    /// Identity that survives list churn (groups are moved and removed while
    /// docking), so code can hold on to a group across a mutation.
    int key;
    static int nextKey;

    int side;
    List<string> ids;
    int active;
    /// Cross-axis size in px. <= 0 until the first layout materialises it from
    /// `weight`; afterwards it is what the split handles drag.
    int extent;
    int weight;
    Rect bounds;
    Rect header;
    Rect body;

    static DockGroup Create(int side, int weight) {
        DockGroup g = new DockGroup();
        DockGroup.nextKey = DockGroup.nextKey + 1;
        g.key = DockGroup.nextKey;
        g.side = side;
        g.ids = new List<string>();
        g.active = 0;
        g.extent = 0;
        g.weight = weight;
        g.bounds = Rect.Create(0, 0, 0, 0);
        g.header = Rect.Create(0, 0, 0, 0);
        g.body = Rect.Create(0, 0, 0, 0);
        return g;
    }
}

/// <summary>
/// A docking layout manager -- the shell of an IDE-style window. Panels live in
/// tab groups docked to the left, right, bottom or center; every group can be
/// resized by dragging its split handles, every tab can be dragged to another
/// group (or to an edge, to open a new group there) and closed, and the whole
/// arrangement serialises to a string so it survives a restart.
///
/// Retained: create the host once, register the panels once, then drive it each
/// frame between Begin and End and draw each panel into the rect the host hands
/// back:
///
///   // once:
///   DockHost dock = DockHost.Create();
///   dock.Register("explorer", "EXPLORER", DockSide.Left(), true, true);
///   dock.Register("outline",  "OUTLINE",  DockSide.Left(), true, true);
///   dock.RegisterFixed("editor", "Editor");            // center document area
///   dock.Register("output", "OUTPUT", DockSide.Bottom(), true, true);
///   dock.LoadLayout(File.ReadAllText(layoutPath));     // optional
///
///   // each frame:
///   dock.Begin(app, area);
///   RenderExplorer(app, dock.Content("explorer"));     // empty rect when hidden
///   RenderEditor(app, dock.Content("editor"));
///   RenderOutput(app, dock.Content("output"));
///   dock.End(app);                                     // drag ghost + drop hint
///   if (dock.TakeChanged()) { File.WriteAllText(layoutPath, dock.SaveLayout()); }
///
/// A closed panel is only hidden, never forgotten: HiddenIds() feeds a "restore
/// panel" menu and Show(id) docks it back where it was.
/// </summary>
class DockHost {
    List<DockPanel> panels;
    List<DockGroup> groups;

    /// Side extents in px (width for left/right, height for bottom).
    int leftW;
    int rightW;
    int bottomH;
    bool sized;

    /// Drag state: the panel being dragged and the resolved drop target.
    /// dropKind: 0 = none, 1 = join `dropGroup`, 2 = new group in `dropSide`
    /// at index `dropIndex`.
    bool dragging;
    bool dragArmed;
    string dragId;
    int dropKind;
    int dropGroup;
    int dropSide;
    int dropIndex;
    Rect dropRect;

    /// Panel menu (right-click a tab strip): lists the closed panels so they
    /// can be docked back. `emptyMenuLabel` is shown when none are closed and
    /// is settable so hosts can localise it.
    bool menuOpen;
    int menuX;
    int menuY;
    string emptyMenuLabel;

    /// Ribbon panel switches: the ids behind them and where they start in the
    /// host's command list (see AddSwitches).
    List<string> switchIds;
    int switchBase;
    /// What a switch click will do, appended to its tip (see SetSwitchHints).
    string switchHideHint;
    string switchShowHint;

    string lastClosed;
    bool changed;
    /// A resize drag in progress: promoted to `changed` on release so a host
    /// that persists the layout writes it once, not once per frame.
    bool pendingResize;
    Rect area;
    int headerH;

    static DockHost Create() {
        DockHost h = new DockHost();
        h.panels = new List<DockPanel>();
        h.groups = new List<DockGroup>();
        h.leftW = 0;
        h.rightW = 0;
        h.bottomH = 0;
        h.sized = false;
        h.dragging = false;
        h.dragArmed = false;
        h.dragId = "";
        h.dropKind = 0;
        h.dropGroup = -1;
        h.dropSide = -1;
        h.dropIndex = 0;
        h.dropRect = Rect.Create(0, 0, 0, 0);
        h.menuOpen = false;
        h.menuX = 0;
        h.menuY = 0;
        h.emptyMenuLabel = "No closed panels";
        h.switchIds = new List<string>();
        h.switchBase = 0 - 1;
        h.switchHideHint = "Click to hide this panel";
        h.switchShowHint = "Click to show this panel";
        h.lastClosed = "";
        h.changed = false;
        h.pendingResize = false;
        h.area = Rect.Create(0, 0, 0, 0);
        h.headerH = 0;
        return h;
    }

    // ---------------------------------------------------------------- model

    DockPanel Find(string id) {
        int i = 0;
        while (i < panels.Count) {
            if (panels[i].id == id) { return panels[i]; }
            i = i + 1;
        }
        return null;
    }

    /// Index of the group holding `id`, or -1 when the panel is closed.
    int GroupOf(string id) {
        int i = 0;
        while (i < groups.Count) {
            DockGroup g = groups[i];
            int j = 0;
            while (j < g.ids.Count) {
                if (g.ids[j] == id) { return i; }
                j = j + 1;
            }
            i = i + 1;
        }
        return -1;
    }

    /// Registers a panel. `newGroup` starts a fresh tab group on that side;
    /// otherwise the panel joins the side's last group. Registration is
    /// idempotent, so a host can be rebuilt over a restored layout.
    void Register(string id, string title, int side, bool closable, bool newGroup) {
        if (this.Find(id) != null) { return; }
        DockPanel p = DockPanel.Create(id, title, closable);
        p.home = side;
        panels.Add(p);
        DockGroup g = null;
        if (!newGroup) { g = this.LastGroupOf(side); }
        if (g == null) {
            g = DockGroup.Create(side, 100);
            groups.Add(g);
        }
        g.ids.Add(id);
    }

    /// Registers the fixed document area: a headerless, unclosable center panel
    /// that the other panels dock around (the host draws no tab for it, so the
    /// caller's own document tab bar is the only one on screen).
    void RegisterFixed(string id, string title) {
        this.Register(id, title, DockSide.Center(), false, true);
        DockPanel p = this.Find(id);
        if (p != null) { p.headerless = true; }
    }

    DockGroup LastGroupOf(int side) {
        DockGroup found = null;
        int i = 0;
        while (i < groups.Count) {
            if (groups[i].side == side) { found = groups[i]; }
            i = i + 1;
        }
        return found;
    }

    /// Sets the initial share of its side's cross axis for the group holding
    /// `id` (relative to the other groups on that side). Ignored once the user
    /// has dragged a handle or a saved layout has been restored.
    void SetWeight(string id, int weight) {
        int gi = this.GroupOf(id);
        if (gi < 0) { return; }
        groups[gi].weight = weight;
    }

    /// Sets the px extent of a side (left/right width, bottom height).
    void SetSideExtent(int side, int px) {
        if (side == 0) { leftW = px; }
        else if (side == 1) { rightW = px; }
        else if (side == 2) { bottomH = px; }
        sized = true;
    }

    bool Visible(string id) {
        DockPanel p = this.Find(id);
        if (p == null) { return false; }
        if (p.hidden) { return false; }
        return p.body.width > 0 && p.body.height > 0;
    }

    /// The content rect resolved by the last Begin(). A hidden (or inactive)
    /// panel gets a zero-sized rect, so callers can skip rendering with a
    /// single `if (r.width <= 0) { }` guard or just draw into nothing.
    Rect Content(string id) {
        DockPanel p = this.Find(id);
        if (p == null) { return Rect.Create(0, 0, 0, 0); }
        return p.body;
    }

    /// Like Content, but a hidden panel gets a 1x1 rect parked far off-screen
    /// instead of a zero one. Immediate-mode content that always renders (and
    /// registers hit regions) can then stay unguarded: it simply draws nowhere.
    Rect ContentParked(string id) {
        DockPanel p = this.Find(id);
        if (p == null || p.hidden || p.body.width <= 0 || p.body.height <= 0) {
            return Rect.Create(0 - 30000, 0 - 30000, 1, 1);
        }
        return p.body;
    }

    string Title(string id) {
        DockPanel p = this.Find(id);
        if (p == null) { return ""; }
        return p.title;
    }

    /// Retitles a panel (e.g. to follow the UI language).
    void SetTitle(string id, string title) {
        DockPanel p = this.Find(id);
        if (p != null) { p.title = title; }
    }

    /// Sets the icon a panel's ribbon switch shows.
    void SetIcon(string id, string icon) {
        DockPanel p = this.Find(id);
        if (p != null) { p.icon = icon; }
    }

    /// Describes what the panel is for; its ribbon switch shows this on hover.
    void SetTip(string id, string text) {
        DockPanel p = this.Find(id);
        if (p != null) { p.tip = text; }
    }

    /// The localized "what a click does" line appended to every switch tip.
    void SetSwitchHints(string hideHint, string showHint) {
        switchHideHint = hideHint;
        switchShowHint = showHint;
    }

    string SwitchTip(DockPanel p) {
        string hint = switchShowHint;
        if (!p.hidden) { hint = switchHideHint; }
        if (p.tip == "") { return hint; }
        if (hint == "") { return p.tip; }
        return p.tip + "\n" + hint;
    }

    // ------------------------------------------------------- panel switches

    /// Appends one icon switch per closable panel to a ribbon command list --
    /// the "Panels" section of a toolbar. The switches are the tail of the
    /// list, so the host keeps addressing its own commands by index, and
    /// HandleRibbon() consumes the clicks on them. Call it right after (re)
    /// building the command list; returns the index the switches start at.
    ///
    ///   dock.AddSwitches(cmds);                    // after BuildRibbon()
    ///   dock.SyncSwitches(cmds);                   // each frame
    ///   int pos = Ribbon.Render(app, x, y, w, h, cmds);
    ///   if (!dock.HandleRibbon(pos)) { ...own commands... }
    int AddSwitches(List<RibbonCmd> cmds) {
        switchBase = cmds.Count;
        switchIds = new List<string>();
        int i = 0;
        while (i < panels.Count) {
            DockPanel p = panels[i];
            if (p.closable && !p.headerless) {
                switchIds.Add(p.id);
                cmds.Add(RibbonCmd.Switch(p.icon, p.title, !p.hidden));
            }
            i = i + 1;
        }
        return switchBase;
    }

    /// Appends a captioned "Panels" section of icon switches (one per closable
    /// panel) to a tabbed ribbon's group list -- the docking counterpart of a
    /// View tab. Build the groups each frame and the switches carry the live
    /// visibility; HandleRibbon() consumes their clicks:
    ///
    ///   List<RibbonGroup> groups = BuildMyGroups(tab);
    ///   if (tab == viewTab) { dock.AddSwitchGroup(groups, "Panels"); }
    ///   else { dock.ClearSwitches(); }
    ///   int pos = Ribbon.RenderTabbed(app, x, y, w, tabs, activeTab, groups);
    ///   if (!dock.HandleRibbon(pos)) { ...own commands... }
    void AddSwitchGroup(List<RibbonGroup> groups, string title) {
        switchBase = 0;
        int g = 0;
        while (g < groups.Count) {
            switchBase = switchBase + groups[g].items.Count;
            g = g + 1;
        }
        switchIds = new List<string>();
        RibbonGroup grp = RibbonGroup.Create(title);
        int i = 0;
        while (i < panels.Count) {
            DockPanel p = panels[i];
            if (p.closable && !p.headerless) {
                switchIds.Add(p.id);
                grp.Add(RibbonItem.Toggle(p.icon, p.title, !p.hidden)
                    .SetTip(this.SwitchTip(p)));
            }
            i = i + 1;
        }
        groups.Add(grp);
    }

    /// Drops the switch mapping -- for when the toolbar showing them is gone
    /// (another ribbon tab), so no click can be mistaken for one.
    void ClearSwitches() {
        switchIds = new List<string>();
        switchBase = 0 - 1;
    }

    /// Refreshes the switches' lit state (and labels) from the live layout.
    void SyncSwitches(List<RibbonCmd> cmds) {
        int i = 0;
        while (i < switchIds.Count) {
            int at = switchBase + i;
            if (at >= cmds.Count) { return; }
            DockPanel p = this.Find(switchIds[i]);
            if (p != null) {
                cmds[at].SetOn(!p.hidden);
                cmds[at].label = p.title;
                cmds[at].icon = p.icon;
            }
            i = i + 1;
        }
    }

    /// Toggles the panel a ribbon click landed on. Returns true when the click
    /// was a panel switch (and the host should not dispatch it as a command).
    bool HandleRibbon(int pos) {
        if (switchBase < 0) { return false; }
        int i = pos - switchBase;
        if (i < 0 || i >= switchIds.Count) { return false; }
        this.Toggle(switchIds[i]);
        return true;
    }

    /// Hides a panel and drops it out of its group (removing the group when it
    /// was the last tab). The panel stays registered and restorable.
    void Close(string id) {
        DockPanel p = this.Find(id);
        if (p == null) { return; }
        if (p.hidden) { return; }
        p.hidden = true;
        p.body = Rect.Create(0, 0, 0, 0);
        this.Detach(id);
        lastClosed = id;
        changed = true;
    }

    void Detach(string id) {
        int gi = this.GroupOf(id);
        if (gi < 0) { return; }
        DockGroup g = groups[gi];
        int j = 0;
        while (j < g.ids.Count) {
            if (g.ids[j] == id) {
                g.ids.RemoveAt(j);
                if (g.active > j) { g.active = g.active - 1; }
                if (g.active >= g.ids.Count) { g.active = g.ids.Count - 1; }
                if (g.active < 0) { g.active = 0; }
                break;
            }
            j = j + 1;
        }
        if (g.ids.Count == 0) { groups.RemoveAt(gi); }
    }

    /// Re-docks a closed panel: back into an existing group on `side` when one
    /// is open, otherwise into a new group there. Also selects it.
    void ShowOn(string id, int side) {
        DockPanel p = this.Find(id);
        if (p == null) { return; }
        p.hidden = false;
        p.home = side;
        if (this.GroupOf(id) < 0) {
            DockGroup g = this.LastGroupOf(side);
            if (g == null) {
                g = DockGroup.Create(side, 100);
                groups.Add(g);
            }
            g.ids.Add(id);
        }
        int gi = this.GroupOf(id);
        if (gi >= 0) { groups[gi].active = this.IndexIn(groups[gi], id); }
        changed = true;
    }

    bool IsHidden(string id) {
        DockPanel p = this.Find(id);
        if (p == null) { return true; }
        return p.hidden;
    }

    /// Show/hide switch for a panel -- what a "panels" toolbar button drives.
    void Toggle(string id) {
        if (this.IsHidden(id)) { this.Show(id); } else { this.Close(id); }
    }

    /// Re-docks a closed panel to the side it came from.
    void Show(string id) {
        DockPanel p = this.Find(id);
        if (p == null) { return; }
        this.ShowOn(id, p.home);
    }

    int IndexIn(DockGroup g, string id) {
        int j = 0;
        while (j < g.ids.Count) {
            if (g.ids[j] == id) { return j; }
            j = j + 1;
        }
        return 0;
    }

    /// Ids of every closed panel, in registration order -- the model for a
    /// "restore panel" menu.
    List<string> HiddenIds() {
        List<string> outIds = new List<string>();
        int i = 0;
        while (i < panels.Count) {
            if (panels[i].hidden) { outIds.Add(panels[i].id); }
            i = i + 1;
        }
        return outIds;
    }

    /// Brings a panel to the front of its group (docking it back first when it
    /// was closed).
    void Focus(string id) {
        DockPanel p = this.Find(id);
        if (p == null) { return; }
        if (p.hidden) {
            this.Show(id);
            return;
        }
        int gi = this.GroupOf(id);
        if (gi >= 0) { groups[gi].active = this.IndexIn(groups[gi], id); }
    }

    /// The panel closed since the last call, or "" -- lets the host log it or
    /// tear down the panel's resources.
    string TakeClosed() {
        string s = lastClosed;
        lastClosed = "";
        return s;
    }

    /// True once when the arrangement changed (resize, dock, close, restore) --
    /// the cue to persist SaveLayout().
    bool TakeChanged() {
        bool c = changed;
        changed = false;
        return c;
    }

    // -------------------------------------------------------- persistence

    /// Serialises sides, groups and hidden panels to one line, e.g.
    /// `v1;S=240,280,160;G=0,180,0,explorer|outline;G=3,0,0,editor;H=terminal:2`
    /// (a hidden panel carries the side it should be restored to).
    /// Unknown ids are skipped on load, so the format tolerates panels that
    /// come and go between versions.
    string SaveLayout() {
        string s = "v1;S=" + Convert.ToString(leftW) + ","
            + Convert.ToString(rightW) + "," + Convert.ToString(bottomH);
        int i = 0;
        while (i < groups.Count) {
            DockGroup g = groups[i];
            s = s + ";G=" + Convert.ToString(g.side) + ","
                + Convert.ToString(g.extent) + "," + Convert.ToString(g.active);
            int j = 0;
            while (j < g.ids.Count) {
                if (j == 0) { s = s + ","; } else { s = s + "|"; }
                s = s + g.ids[j];
                j = j + 1;
            }
            i = i + 1;
        }
        string hid = "";
        int k = 0;
        while (k < panels.Count) {
            if (panels[k].hidden) {
                if (hid != "") { hid = hid + "|"; }
                hid = hid + panels[k].id + ":" + Convert.ToString(panels[k].home);
            }
            k = k + 1;
        }
        if (hid != "") { s = s + ";H=" + hid; }
        return s;
    }

    /// Restores a layout written by SaveLayout. Panels the layout does not
    /// mention keep their registered position, and ids it mentions that are no
    /// longer registered are ignored. Returns false when the string is not a
    /// layout this version understands (the caller then keeps the defaults).
    bool LoadLayout(string text) {
        if (text == null) { return false; }
        List<string> parts = DockHost.SplitOn(text, ";");
        if (parts.Count == 0) { return false; }
        if (parts[0] != "v1") { return false; }

        List<DockGroup> loaded = new List<DockGroup>();
        List<string> hidden = new List<string>();
        int i = 1;
        while (i < parts.Count) {
            string seg = parts[i];
            if (DockHost.HasPrefix(seg, "S=")) {
                List<string> nums = DockHost.SplitOn(DockHost.After(seg, 2), ",");
                if (nums.Count >= 3) {
                    leftW = Convert.ToInt32(nums[0]);
                    rightW = Convert.ToInt32(nums[1]);
                    bottomH = Convert.ToInt32(nums[2]);
                    sized = true;
                }
            } else if (DockHost.HasPrefix(seg, "G=")) {
                List<string> f = DockHost.SplitOn(DockHost.After(seg, 2), ",");
                if (f.Count >= 4) {
                    DockGroup g = DockGroup.Create(Convert.ToInt32(f[0]), 100);
                    g.extent = Convert.ToInt32(f[1]);
                    g.active = Convert.ToInt32(f[2]);
                    List<string> ids = DockHost.SplitOn(f[3], "|");
                    int j = 0;
                    while (j < ids.Count) {
                        if (this.Find(ids[j]) != null) { g.ids.Add(ids[j]); }
                        j = j + 1;
                    }
                    if (g.ids.Count > 0) {
                        if (g.active >= g.ids.Count) { g.active = g.ids.Count - 1; }
                        if (g.active < 0) { g.active = 0; }
                        loaded.Add(g);
                    }
                }
            } else if (DockHost.HasPrefix(seg, "H=")) {
                List<string> hs = DockHost.SplitOn(DockHost.After(seg, 2), "|");
                int hi = 0;
                while (hi < hs.Count) {
                    List<string> hf = DockHost.SplitOn(hs[hi], ":");
                    if (hf.Count >= 1) {
                        hidden.Add(hf[0]);
                        DockPanel hp = this.Find(hf[0]);
                        if (hp != null && hf.Count >= 2) {
                            hp.home = Convert.ToInt32(hf[1]);
                        }
                    }
                    hi = hi + 1;
                }
            }
            i = i + 1;
        }
        if (loaded.Count == 0) { return false; }

        // Keep panels the saved layout never mentioned: re-dock them into the
        // last group of the side they were registered on (or a new one).
        List<string> placed = new List<string>();
        int gi = 0;
        while (gi < loaded.Count) {
            int j = 0;
            while (j < loaded[gi].ids.Count) {
                placed.Add(loaded[gi].ids[j]);
                j = j + 1;
            }
            gi = gi + 1;
        }
        List<DockGroup> old = groups;
        groups = loaded;
        int p = 0;
        while (p < panels.Count) {
            DockPanel pan = panels[p];
            pan.hidden = DockHost.ListHas(hidden, pan.id);
            if (!DockHost.ListHas(placed, pan.id) && !pan.hidden) {
                int side = DockHost.SideOfIn(old, pan.id);
                DockGroup g = this.LastGroupOf(side);
                if (g == null) {
                    g = DockGroup.Create(side, 100);
                    groups.Add(g);
                }
                g.ids.Add(pan.id);
            }
            p = p + 1;
        }
        // Remember where every docked panel ended up, so closing and restoring
        // it later puts it back on the same side.
        int hp2 = 0;
        while (hp2 < panels.Count) {
            int hg = this.GroupOf(panels[hp2].id);
            if (hg >= 0) { panels[hp2].home = groups[hg].side; }
            hp2 = hp2 + 1;
        }
        return true;
    }

    static int SideOfIn(List<DockGroup> gs, string id) {
        int i = 0;
        while (i < gs.Count) {
            int j = 0;
            while (j < gs[i].ids.Count) {
                if (gs[i].ids[j] == id) { return gs[i].side; }
                j = j + 1;
            }
            i = i + 1;
        }
        return DockSide.Left();
    }

    static bool ListHas(List<string> xs, string v) {
        int i = 0;
        while (i < xs.Count) {
            if (xs[i] == v) { return true; }
            i = i + 1;
        }
        return false;
    }

    static bool HasPrefix(string s, string p) {
        if (s.Length < p.Length) { return false; }
        return s.Substring(0, p.Length) == p;
    }

    static string After(string s, int n) {
        if (s.Length <= n) { return ""; }
        return s.Substring(n, s.Length - n);
    }

    /// Splits on a one-character separator, dropping empty segments.
    static List<string> SplitOn(string s, string sep) {
        List<string> outp = new List<string>();
        int start = 0;
        int i = 0;
        int n = s.Length;
        while (i < n) {
            if (s.Substring(i, 1) == sep) {
                if (i > start) { outp.Add(s.Substring(start, i - start)); }
                start = i + 1;
            }
            i = i + 1;
        }
        if (n > start) { outp.Add(s.Substring(start, n - start)); }
        return outp;
    }

    // -------------------------------------------------------------- layout

    bool SideHasVisible(int side) {
        int i = 0;
        while (i < groups.Count) {
            if (groups[i].side == side && this.GroupHasVisible(groups[i])) { return true; }
            i = i + 1;
        }
        return false;
    }

    bool GroupHasVisible(DockGroup g) {
        int j = 0;
        while (j < g.ids.Count) {
            DockPanel p = this.Find(g.ids[j]);
            if (p != null && !p.hidden) { return true; }
            j = j + 1;
        }
        return false;
    }

    List<DockGroup> VisibleGroups(int side) {
        List<DockGroup> gs = new List<DockGroup>();
        int i = 0;
        while (i < groups.Count) {
            if (groups[i].side == side && this.GroupHasVisible(groups[i])) { gs.Add(groups[i]); }
            i = i + 1;
        }
        return gs;
    }

    /// Lays out the whole dock inside `a`, draws the split handles and every
    /// group's tab strip, and processes resize drags, tab clicks, closes and
    /// the start of a tab drag. Call once per frame BEFORE drawing the panels.
    void Begin(App app, Rect a) {
        area = a;
        if (pendingResize && app.EventKind() == 3) {
            pendingResize = false;
            changed = true;
        }
        headerH = app.theme.heightMedium;
        int hs = app.Scale(5);
        int minSide = app.Scale(140);
        int minCenter = app.Scale(240);
        int minBottom = app.Scale(72);

        if (!sized) {
            leftW = app.Scale(240);
            rightW = app.Scale(280);
            bottomH = app.Scale(170);
            sized = true;
        }

        int i = 0;
        while (i < panels.Count) {
            panels[i].body = Rect.Create(0, 0, 0, 0);
            i = i + 1;
        }

        bool hasL = this.SideHasVisible(DockSide.Left());
        bool hasR = this.SideHasVisible(DockSide.Right());
        bool hasB = this.SideHasVisible(DockSide.Bottom());

        int lw = 0;
        int rw = 0;
        int bh = 0;
        int hl = 0;
        int hr = 0;
        int hb = 0;
        if (hasL) { lw = leftW; hl = hs; }
        if (hasR) { rw = rightW; hr = hs; }
        if (hasB) { bh = bottomH; hb = hs; }

        if (hasL && lw < minSide) { lw = minSide; }
        if (hasR && rw < minSide) { rw = minSide; }
        int budget = a.width - hl - hr - minCenter;
        if (budget < 0) { budget = 0; }
        int over = lw + rw - budget;
        if (over > 0) {
            int cut = over;
            if (cut > rw) { cut = rw; }
            rw = rw - cut;
            over = over - cut;
            if (over > 0) {
                lw = lw - over;
                if (lw < 0) { lw = 0; }
            }
        }
        if (hasB) {
            int maxB = a.height - hb - app.Scale(120);
            if (bh > maxB) { bh = maxB; }
            if (bh < minBottom) { bh = minBottom; }
            if (bh < 0) { bh = 0; }
        }
        if (hasL) { leftW = lw; }
        if (hasR) { rightW = rw; }
        if (hasB) { bottomH = bh; }

        int midX = a.x + lw + hl;
        int midW = a.width - lw - hl - rw - hr;
        if (midW < 0) { midW = 0; }

        // ---- side split handles -------------------------------------------
        if (hasL) {
            int nx = this.Handle(app, a.x + lw, a.y, hs, a.height, true);
            if (nx >= 0) { leftW = nx - a.x; pendingResize = true; }
        }
        if (hasR) {
            int nx = this.Handle(app, a.Right() - rw - hs, a.y, hs, a.height, true);
            if (nx >= 0) { rightW = a.Right() - nx - hs; pendingResize = true; }
        }
        int centerH = a.height;
        if (hasB) {
            centerH = a.height - bh - hb;
            int ny = this.Handle(app, midX, a.y + centerH, midW, hs, false);
            if (ny >= 0) { bottomH = a.Bottom() - ny - hs; pendingResize = true; }
        }
        if (centerH < 0) { centerH = 0; }

        // ---- per-side group layout ----------------------------------------
        if (hasL) {
            this.LayoutSide(app, this.VisibleGroups(DockSide.Left()),
                Rect.Create(a.x, a.y, lw, a.height), true, hs);
        }
        if (hasR) {
            this.LayoutSide(app, this.VisibleGroups(DockSide.Right()),
                Rect.Create(a.Right() - rw, a.y, rw, a.height), true, hs);
        }
        this.LayoutSide(app, this.VisibleGroups(DockSide.Center()),
            Rect.Create(midX, a.y, midW, centerH), false, hs);
        if (hasB) {
            this.LayoutSide(app, this.VisibleGroups(DockSide.Bottom()),
                Rect.Create(midX, a.Bottom() - bh, midW, bh), false, hs);
        }
    }

    /// One split handle. Returns the new leading coordinate while it is being
    /// dragged (x for a vertical handle, y for a horizontal one), else -1.
    int Handle(App app, int x, int y, int w, int h, bool vertical) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int id = app.focus.AllocId();
        int col = t.divider;
        bool live = app.focus.IsHovered(id) || app.focus.IsPressed(id);
        if (live) { col = t.primary; }
        c.FillRect(x, y, w, h, col);
        int cursor = 4;
        if (!vertical) { cursor = 5; }
        app.hitTester.Register(HitRegion.Create(id, x, y, w, h, cursor));
        if (app.focus.IsPressed(id) && !dragging) {
            app.RequestRedraw();
            if (vertical) { return app.mouseX; }
            return app.mouseY;
        }
        return -1;
    }

    /// Splits `r` between the side's groups along its cross axis, drawing a
    /// handle between neighbours and each group's chrome.
    void LayoutSide(App app, List<DockGroup> gs, Rect r, bool vertical, int hs) {
        int n = gs.Count;
        if (n == 0) { return; }
        int total = r.width;
        if (vertical) { total = r.height; }
        total = total - hs * (n - 1);
        if (total < n) { total = n; }
        int minG = app.Scale(56);
        if (minG * n > total) { minG = total / n; }

        // Materialise extents from weights the first time, then keep their sum
        // equal to the available cross axis so a window resize scales them.
        int sum = 0;
        int wsum = 0;
        int unset = 0;
        int i = 0;
        while (i < n) {
            if (gs[i].extent <= 0) { unset = unset + 1; wsum = wsum + gs[i].weight; }
            else { sum = sum + gs[i].extent; }
            i = i + 1;
        }
        if (unset > 0) {
            int rest = total - sum;
            if (rest < unset * minG) { rest = unset * minG; }
            if (wsum <= 0) { wsum = unset; }
            i = 0;
            while (i < n) {
                if (gs[i].extent <= 0) {
                    gs[i].extent = rest * gs[i].weight / wsum;
                    if (gs[i].extent < minG) { gs[i].extent = minG; }
                    sum = sum + gs[i].extent;
                }
                i = i + 1;
            }
        }
        if (sum != total && sum > 0) {
            int acc = 0;
            i = 0;
            while (i < n - 1) {
                int e = gs[i].extent * total / sum;
                if (e < minG) { e = minG; }
                gs[i].extent = e;
                acc = acc + e;
                i = i + 1;
            }
            int last = total - acc;
            if (last < minG) { last = minG; }
            gs[n - 1].extent = last;
        }

        int pos = r.y;
        if (!vertical) { pos = r.x; }
        i = 0;
        while (i < n) {
            DockGroup g = gs[i];
            int ext = g.extent;
            if (i == n - 1) {
                if (vertical) { ext = r.Bottom() - pos; }
                else { ext = r.Right() - pos; }
                if (ext < 1) { ext = 1; }
                g.extent = ext;
            }
            if (vertical) { g.bounds = Rect.Create(r.x, pos, r.width, ext); }
            else { g.bounds = Rect.Create(pos, r.y, ext, r.height); }
            this.RenderGroup(app, g);
            pos = pos + ext;

            if (i < n - 1) {
                int nv = -1;
                if (vertical) { nv = this.Handle(app, r.x, pos, r.width, hs, false); }
                else { nv = this.Handle(app, pos, r.y, hs, r.height, true); }
                if (nv >= 0) {
                    int start = g.bounds.y;
                    if (!vertical) { start = g.bounds.x; }
                    int delta = nv - start - ext;
                    int a1 = ext + delta;
                    int a2 = gs[i + 1].extent - delta;
                    if (a1 >= minG && a2 >= minG) {
                        g.extent = a1;
                        gs[i + 1].extent = a2;
                        pendingResize = true;
                    }
                }
                pos = pos + hs;
            }
            i = i + 1;
        }
    }

    /// Paints one group's surface and tab strip, resolves the active panel's
    /// content rect and handles select / close / drag-start on its tabs.
    void RenderGroup(App app, DockGroup g) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        Rect b = g.bounds;

        List<string> vis = new List<string>();
        int i = 0;
        while (i < g.ids.Count) {
            DockPanel p = this.Find(g.ids[i]);
            if (p != null && !p.hidden) { vis.Add(p.id); }
            i = i + 1;
        }
        if (vis.Count == 0) { return; }
        if (g.active >= g.ids.Count) { g.active = g.ids.Count - 1; }
        if (g.active < 0) { g.active = 0; }
        string activeId = g.ids[g.active];
        DockPanel ap = this.Find(activeId);
        if (ap == null || ap.hidden) {
            activeId = vis[0];
            g.active = this.IndexIn(g, activeId);
            ap = this.Find(activeId);
        }

        bool chrome = !ap.headerless || vis.Count > 1;
        int hh = 0;
        if (chrome) { hh = headerH; }
        if (hh > b.height) { hh = b.height; }
        g.header = Rect.Create(b.x, b.y, b.width, hh);
        g.body = Rect.Create(b.x, b.y + hh, b.width, b.height - hh);

        if (g.side != DockSide.Center()) {
            // A plain themed fill: the surface colour is already translucent on
            // skins that paint their own backdrop, so the wallpaper reads
            // through without the frosted blur a full glass surface would add.
            c.FillRect(b.x, b.y, b.width, b.height, t.bgTertiary);
        }
        if (!chrome) {
            ap.body = g.body;
            return;
        }

        // The tab strip shares the pane's own surface -- a separate bgSecondary
        // fill made every docked pane look a different shade than its
        // neighbours. Only the divider marks it off.
        c.FillRect(b.x, b.y + hh - 1, b.width, 1, t.divider);

        // Right-clicking the strip opens the panel menu (restore closed panels).
        if (app.EventKind() == 2 && app.window.EventButton() == 1
            && app.mouseX >= b.x && app.mouseX < b.x + b.width
            && app.mouseY >= b.y && app.mouseY < b.y + hh) {
            menuOpen = true;
            menuX = app.mouseX;
            menuY = app.mouseY;
            app.RequestRedraw();
        }

        c.PushClip(b.x, b.y, b.width, hh);

        int fontSize = t.fontSizeSmall;
        int padX = t.paddingMedium;
        int gap = t.gapSmall;
        int closeBox = fontSize;
        int textY = Canvas.CenterTextY(b.y, hh, fontSize);
        int tabX = b.x;

        i = 0;
        while (i < vis.Count) {
            DockPanel p = this.Find(vis[i]);
            int tabId = app.focus.AllocId();
            int closeId = app.focus.AllocId();
            int labelW = Canvas.MeasureText(p.title, fontSize);
            int tabW = padX + labelW + padX;
            if (p.closable) { tabW = padX + labelW + gap + closeBox + padX; }
            bool isActive = p.id == activeId;
            bool hovered = app.focus.IsHovered(tabId);
            bool closeHover = app.focus.IsHovered(closeId);

            if (isActive) {
                c.FillRect(tabX, b.y, tabW, hh - 1, Layer.Fade(t.bgPrimary, 420));
            } else if (hovered || closeHover) {
                c.FillRect(tabX, b.y, tabW, hh - 1, t.bgHover);
            }
            int textColor = t.textTertiary;
            if (isActive) { textColor = t.textPrimary; }
            else if (hovered) { textColor = t.textSecondary; }
            c.DrawText(tabX + padX, textY, p.title, textColor, fontSize);
            if (isActive) { c.FillRect(tabX, b.y + hh - 2, tabW, 2, t.primary); }

            if (p.closable) {
                int cbx = tabX + padX + labelW + gap;
                int cby = b.y + (hh - closeBox) / 2;
                int closeColor = t.textTertiary;
                if (closeHover) {
                    c.FillRoundRect(cbx - 2, cby - 2, closeBox + 4, closeBox + 4,
                        t.borderRadiusSmall, t.bgActive);
                    closeColor = t.textPrimary;
                }
                c.DrawGlyphIn("close", cbx, cby, closeBox, closeBox, closeBox - 3, closeColor);
                this.RegisterClipped(app, closeId, cbx - 2, cby - 2, closeBox + 4, closeBox + 4, b.x, b.width);
            }
            this.RegisterClipped(app, tabId, tabX, b.y, tabW, hh, b.x, b.width);

            // Press + move on a tab starts a dock drag; a press that never
            // moves stays a plain click (select) handled on release.
            if (app.focus.IsPressed(tabId) && !dragging) {
                int dx = app.mouseX - app.pressStartX;
                int dy = app.mouseY - app.pressStartY;
                if (dx < 0) { dx = 0 - dx; }
                if (dy < 0) { dy = 0 - dy; }
                if (dx + dy > app.Scale(6)) {
                    dragging = true;
                    dragId = p.id;
                    app.RequestRedraw();
                }
            }

            if (app.EventKind() == 3 && !dragging && !dragArmed) {
                int hit = app.ClickTarget();
                if (p.closable && hit == closeId) {
                    this.Close(p.id);
                    app.RequestRedraw();
                } else if (hit == tabId) {
                    g.active = this.IndexIn(g, p.id);
                    app.RequestRedraw();
                }
            }

            tabX = tabX + tabW;
            i = i + 1;
        }
        c.PopClip();

        ap = this.Find(activeId);
        if (ap != null && !ap.hidden) { ap.body = g.body; }
    }

    /// Draws the panel menu opened by right-clicking a tab strip: one entry per
    /// closed panel, picking one docks it back where it was.
    void RenderMenu(App app) {
        if (!menuOpen) { return; }
        List<string> ids = this.HiddenIds();
        List<string> labels = new List<string>();
        int i = 0;
        while (i < ids.Count) {
            labels.Add(this.Title(ids[i]));
            i = i + 1;
        }
        if (labels.Count == 0) { labels.Add(emptyMenuLabel); }
        int pick = ContextMenu.Render(app, menuX, menuY, labels);
        if (pick == 0 - 2) {
            menuOpen = false;
            app.RequestRedraw();
        } else if (pick >= 0) {
            if (pick < ids.Count) { this.Show(ids[pick]); }
            menuOpen = false;
            app.RequestRedraw();
        }
    }

    void RegisterClipped(App app, int id, int rx, int ry, int rw, int rh, int clipX, int clipW) {
        int x0 = rx;
        int x1 = rx + rw;
        if (x0 < clipX) { x0 = clipX; }
        if (x1 > clipX + clipW) { x1 = clipX + clipW; }
        if (x1 <= x0) { return; }
        app.hitTester.Register(HitRegion.Create(id, x0, ry, x1 - x0, rh, 0));
    }

    // ----------------------------------------------------------- drag & drop

    /// Finishes the frame: while a tab is being dragged this resolves the drop
    /// target, highlights it and draws the drag ghost, and on release it
    /// re-docks the panel. Call once per frame AFTER drawing the panels so the
    /// hints paint on top.
    void End(App app) {
        this.RenderMenu(app);
        if (!dragging) {
            dragArmed = false;
            return;
        }
        dragArmed = true;
        Canvas c = app.canvas;
        Theme t = app.theme;

        this.ResolveDrop(app);
        if (dropKind != 0) {
            int tint = Layer.Fade(t.primary, 260);
            c.FillRect(dropRect.x, dropRect.y, dropRect.width, dropRect.height, tint);
            c.DrawRoundRect(dropRect.x, dropRect.y, dropRect.width, dropRect.height,
                t.borderRadiusSmall, t.primary, 2);
        }

        DockPanel p = this.Find(dragId);
        if (p != null) {
            int fontSize = t.fontSizeSmall;
            int pad = t.paddingMedium;
            int gw = Canvas.MeasureText(p.title, fontSize) + pad * 2;
            int gh = headerH;
            int gx = app.mouseX + app.Scale(8);
            int gy = app.mouseY + app.Scale(8);
            c.SurfaceRoundRect(gx, gy, gw, gh, t.borderRadiusSmall, t.bgPrimary, t.primary, 1);
            c.DrawTextCentered(gx, gy, gw, gh, p.title, t.textPrimary, fontSize);
        }
        app.RequestRedraw();

        if (app.EventKind() == 3 && app.window.EventButton() == 0) {
            this.ApplyDrop();
            dragging = false;
            dragArmed = false;
            dragId = "";
            dropKind = 0;
            app.RequestRedraw();
        }
    }

    /// Picks the drop target under the pointer: the group's tab strip or its
    /// middle joins that group, an edge band of a group opens a new group next
    /// to it, and the outer bands of the whole dock dock to that side.
    void ResolveDrop(App app) {
        dropKind = 0;
        dropGroup = -1;
        dropSide = -1;
        dropIndex = 0;
        int mx = app.mouseX;
        int my = app.mouseY;
        if (!area.Contains(mx, my)) { return; }

        int gi = 0;
        while (gi < groups.Count) {
            DockGroup g = groups[gi];
            if (this.GroupHasVisible(g) && g.bounds.Contains(mx, my)) {
                if (g.header.height > 0 && g.header.Contains(mx, my)) {
                    dropKind = 1;
                    dropGroup = gi;
                    dropRect = g.bounds;
                    return;
                }
                int zone = DockHost.EdgeZone(g.bounds, mx, my);
                if (zone == 0) {
                    dropKind = 1;
                    dropGroup = gi;
                    dropRect = g.bounds;
                    return;
                }
                bool vertical = g.side == DockSide.Left() || g.side == DockSide.Right();
                bool along = false;
                if (vertical && (zone == 3 || zone == 4)) { along = true; }
                if (!vertical && (zone == 1 || zone == 2)) { along = true; }
                if (along) {
                    dropKind = 2;
                    dropSide = g.side;
                    dropIndex = this.SideIndexOf(g);
                    if (zone == 2 || zone == 4) { dropIndex = dropIndex + 1; }
                    dropRect = DockHost.HalfRect(g.bounds, zone);
                    return;
                }
                // Crossing the group's grain: dock to the host side the edge
                // points at instead of splitting this group the wrong way.
                dropKind = 2;
                dropSide = DockHost.SideForZone(zone);
                dropIndex = this.SideCount(dropSide);
                if (dropSide == DockSide.Left() && zone == 1) { dropIndex = 0; }
                dropRect = this.SideStrip(app, dropSide);
                return;
            }
            gi = gi + 1;
        }

        int zoneA = DockHost.EdgeZone(area, mx, my);
        if (zoneA == 0) { zoneA = 2; }
        dropKind = 2;
        dropSide = DockHost.SideForZone(zoneA);
        dropIndex = this.SideCount(dropSide);
        dropRect = this.SideStrip(app, dropSide);
    }

    /// 0 = middle, 1 = left band, 2 = right band, 3 = top band, 4 = bottom band.
    static int EdgeZone(Rect r, int mx, int my) {
        int bx = r.width / 4;
        int by = r.height / 4;
        if (bx < 8) { bx = 8; }
        if (by < 8) { by = 8; }
        int dl = mx - r.x;
        int dr = r.Right() - mx;
        int dt = my - r.y;
        int db = r.Bottom() - my;
        int best = 0;
        int bestD = 0;
        if (dl < bx) { best = 1; bestD = dl; }
        if (dr < bx && (best == 0 || dr < bestD)) { best = 2; bestD = dr; }
        if (dt < by && (best == 0 || dt < bestD)) { best = 3; bestD = dt; }
        if (db < by && (best == 0 || db < bestD)) { best = 4; bestD = db; }
        return best;
    }

    static Rect HalfRect(Rect r, int zone) {
        if (zone == 1) { return Rect.Create(r.x, r.y, r.width / 2, r.height); }
        if (zone == 2) { return Rect.Create(r.x + r.width / 2, r.y, r.width / 2, r.height); }
        if (zone == 3) { return Rect.Create(r.x, r.y, r.width, r.height / 2); }
        return Rect.Create(r.x, r.y + r.height / 2, r.width, r.height / 2);
    }

    static int SideForZone(int zone) {
        if (zone == 1) { return DockSide.Left(); }
        if (zone == 2) { return DockSide.Right(); }
        if (zone == 4) { return DockSide.Bottom(); }
        return DockSide.Center();
    }

    /// The band a side would occupy, used as the drop hint for a side dock.
    Rect SideStrip(App app, int side) {
        int w = leftW;
        if (side == DockSide.Right()) { w = rightW; }
        if (w <= 0) { w = app.Scale(240); }
        if (side == DockSide.Center()) { return area; }
        if (side == DockSide.Left()) { return Rect.Create(area.x, area.y, w, area.height); }
        if (side == DockSide.Right()) { return Rect.Create(area.Right() - w, area.y, w, area.height); }
        int h = bottomH;
        if (h <= 0) { h = app.Scale(170); }
        return Rect.Create(area.x, area.Bottom() - h, area.width, h);
    }

    /// Position of `g` among the groups of its own side.
    int SideIndexOf(DockGroup g) {
        int n = 0;
        int i = 0;
        while (i < groups.Count) {
            if (groups[i].key == g.key) { return n; }
            if (groups[i].side == g.side) { n = n + 1; }
            i = i + 1;
        }
        return n;
    }

    int SideCount(int side) {
        int n = 0;
        int i = 0;
        while (i < groups.Count) {
            if (groups[i].side == side) { n = n + 1; }
            i = i + 1;
        }
        return n;
    }

    /// Global index at which a new group becomes the `k`-th group of `side`.
    int InsertPos(int side, int k) {
        int n = 0;
        int i = 0;
        while (i < groups.Count) {
            if (groups[i].side == side) {
                if (n == k) { return i; }
                n = n + 1;
            }
            i = i + 1;
        }
        return groups.Count;
    }

    void ApplyDrop() {
        if (dropKind == 0) { return; }
        DockPanel p = this.Find(dragId);
        if (p == null) { return; }
        if (dropKind == 1) {
            if (dropGroup < 0 || dropGroup >= groups.Count) { return; }
            DockGroup target = groups[dropGroup];
            if (DockHost.ListHas(target.ids, dragId)) {
                target.active = this.IndexIn(target, dragId);
                return;
            }
            int tkey = target.key;
            this.Detach(dragId);
            // Detach may have dissolved an emptied group before the target.
            int ti = this.IndexOfKey(tkey);
            if (ti < 0) { return; }
            groups[ti].ids.Add(dragId);
            groups[ti].active = groups[ti].ids.Count - 1;
            p.home = groups[ti].side;
            changed = true;
            return;
        }

        int side = dropSide;
        int k = dropIndex;
        p.home = side;
        int fromGroup = this.GroupOf(dragId);
        if (fromGroup >= 0 && groups[fromGroup].side == side
            && groups[fromGroup].ids.Count == 1) {
            // Already a lone group on that side: just reorder it.
            DockGroup solo = groups[fromGroup];
            groups.RemoveAt(fromGroup);
            int pos = this.InsertPos(side, k);
            if (pos > groups.Count) { pos = groups.Count; }
            groups.Insert(pos, solo);
            changed = true;
            return;
        }
        this.Detach(dragId);
        DockGroup ng = DockGroup.Create(side, 100);
        ng.ids.Add(dragId);
        ng.active = 0;
        int at = this.InsertPos(side, k);
        if (at > groups.Count) { at = groups.Count; }
        groups.Insert(at, ng);
        changed = true;
    }

    int IndexOfKey(int key) {
        int i = 0;
        while (i < groups.Count) {
            if (groups[i].key == key) { return i; }
            i = i + 1;
        }
        return -1;
    }

    /// True while a tab is being dragged -- hosts can suppress their own
    /// hover/drag handling for the frame.
    bool Dragging() { return dragging; }
}
