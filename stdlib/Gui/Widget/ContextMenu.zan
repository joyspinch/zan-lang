using System;
using Gui;

namespace Gui.Widget;

/// Floating right-click context menu. Draws at (mx, my) clamped to the
/// window, blocks hits underneath, and reports the user's choice this frame:
/// -1 = nothing yet, -2 = dismissed (clicked outside), or the index of the
/// chosen label. Entries equal to "-" render as separators.
class ContextMenu {
    /// One menu row: hover highlight, the label and an optional right-aligned
    /// accelerator / check mark. Exposed so any widget that hosts its own menu
    /// (table header menus, designers) gets identical rows without repainting
    /// them. `hovered` is supplied by the caller because some menus hit-test
    /// geometrically and others through a registered id.
    static void PaintItem(App app, int x, int y, int w, int h,
                          string label, string accel, bool hovered) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int fs = t.fontSizeSmall;
        int ty = Canvas.CenterTextY(y, h, fs);
        if (hovered) { c.FillRect(x, y, w, h, t.bgHover); }
        c.DrawText(x + app.Scale(12), ty, label, t.textPrimary, fs);
        if (accel.Length > 0) {
            int aw = Canvas.MeasureText(accel, fs);
            c.DrawText(x + w - aw - app.Scale(12), ty, accel, t.textTertiary, fs);
        }
    }

    /// A separator row inside a menu.
    static void PaintSeparator(App app, int x, int y, int w) {
        app.canvas.FillRect(x + app.Scale(6), y, w - app.Scale(12), 1,
                            app.theme.divider);
    }

    /// The height `labels` will occupy, so a caller anchoring the menu above its
    /// button (a composer row at the bottom of a panel) can pass the right `my`
    /// instead of relying on the clamp, which drops it against the window edge.
    static int Height(App app, List<string> labels) {
        int itemH = Canvas.FontHeight(app.theme.fontSizeMedium) + app.Scale(8);
        int sepH = app.Scale(7);
        int h = app.Scale(6);
        for (int i = 0; i < labels.Count; i = i + 1) {
            if (labels[i] == "-") { h = h + sepH; } else { h = h + itemH; }
        }
        return h;
    }

    static int Render(App app, int mx, int my, List<string> labels) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int fontSize = t.fontSizeMedium;
        int itemH = Canvas.FontHeight(fontSize) + app.Scale(8);
        int sepH = app.Scale(7);
        int mW = app.Scale(150);
        for (int i = 0; i < labels.Count; i = i + 1) {
            if (labels[i] != "-") {
                int lw = Canvas.MeasureText(labels[i], fontSize) + app.Scale(28);
                if (lw > mW) { mW = lw; }
            }
        }
        int mH = ContextMenu.Height(app, labels);

        int winW = c.Width();
        int winH = c.Height();
        if (mx + mW > winW) { mx = winW - mW - app.Scale(4); }
        if (my + mH > winH) { my = winH - mH - app.Scale(4); }
        if (mx < 0) { mx = 0; }
        if (my < app.titlebarH) { my = app.titlebarH; }

        // Rows are hit-tested geometrically rather than through registered hit
        // regions, so nothing else would repaint the menu as the pointer moves
        // across it and the hover highlight would never follow.
        if (app.EventKind() == 1) { app.RequestRedraw(); }

        c.FillRoundRect(mx + 2, my + 2, mW, mH, app.Scale(4), t.shadowColor);
        app.canvas.SurfaceRoundRect(mx, my, mW, mH,
            app.theme.borderRadiusLarge, t.bgSecondary,
            app.theme.borderSecondary, 1);
        app.BlockHitsRect(mx, my, mW, mH);

        int ry = my + app.Scale(3);
        for (int ri = 0; ri < labels.Count; ri = ri + 1) {
            if (labels[ri] == "-") {
                ContextMenu.PaintSeparator(app, mx, ry + sepH / 2, mW);
                ry = ry + sepH;
            } else {
                bool hov = app.mouseX >= mx && app.mouseX < mx + mW
                           && app.mouseY >= ry && app.mouseY < ry + itemH;
                ContextMenu.PaintItem(app, mx, ry, mW, itemH, labels[ri], "", hov);
                ry = ry + itemH;
            }
        }

        if (app.ClickAvailable() && app.window.EventButton() == 0) {
            bool inside = app.mouseX >= mx && app.mouseX < mx + mW
                          && app.mouseY >= my && app.mouseY < my + mH;
            if (inside) {
                int cy = my + app.Scale(3);
                for (int ci = 0; ci < labels.Count; ci = ci + 1) {
                    int rh = itemH;
                    if (labels[ci] == "-") { rh = sepH; }
                    if (labels[ci] != "-" && app.mouseY >= cy && app.mouseY < cy + rh) {
                        return ci;
                    }
                    cy = cy + rh;
                }
                return 0 - 1;
            }
            return 0 - 2;
        }
        return 0 - 1;
    }
}
