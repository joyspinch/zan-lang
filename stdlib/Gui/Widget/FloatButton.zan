using System;
using Gui;

namespace Gui.Widget;

/// FloatButton: a circular action button for fixed "back to top" / quick-action
/// affordances. `Class = "primary"` gives it the accent fill.
///
///     int id = new FloatButton("plus") { Class = "primary" }.Render(app, x, y);
///     if (Ui.Clicked(app, id)) { ... }
class FloatButton : Control {
    /// Glyph drawn in the circle.
    Binding<string> Icon;
    /// Diameter in device pixels; 0 uses the theme's large control height.
    Binding<int> Size;
    /// Fires when the button is clicked.
    UiEvent Click;
    int wid;

    void InitFloatButton(string icon) {
        this.InitControl("floatbutton", 1);
        Icon = icon;
        Size = 0;
        wid = WidgetId.Next();
        wiresOwnEvents = true;
        Click = UiEvent.Create();
    }

    FloatButton() { InitFloatButton(""); }
    FloatButton(string icon) { InitFloatButton(icon); }

    int Diameter(App app) {
        int s = Size.Get();
        if (s > 0) { return s; }
        return app.theme.heightLarge;
    }

    /// Draws at (x, y) and returns the widget id, so a host can test it with
    /// `Ui.Clicked` instead of subscribing to `Click`.
    int Render(App app, int x, int y) {
        int d = this.Diameter(app);
        bx = x;
        by = y;
        bw = d;
        bh = d;
        this.OnPaint(app);
        return wid;
    }

    override void OnMeasure(App app) {
        int d = this.Diameter(app);
        prefW = d;
        prefH = d;
    }

    override void OnPaint(App app) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int d = this.Diameter(app);
        StyleBox s = Style.Eased(app, wid, "floatbutton", Class,
                                 this.IsDisabled());
        Style.Inline(s, this);
        int radius = s.RadiusOr(d / 2);

        // Soft shadow then circular body.
        c.FillRoundRect(bx + 1, by + 2, d, d, radius, t.shadowColor);
        c.FillRoundRect(bx, by, d, d, radius, s.BgOr(t.bgPrimary));
        int bwidth = s.BorderWOr(1);
        int border = s.BorderOr(t.borderPrimary);
        if (border != 0 && bwidth > 0) {
            c.DrawRoundRect(bx, by, d, d, radius, border, bwidth);
        }
        c.DrawGlyphIn(Icon.Get(), bx, by, d, d, s.FontOr(t.iconSizeMedium),
                      s.FgOr(t.textPrimary));

        app.hitTester.Register(HitRegion.Create(wid, bx, by, d, d, 0));
        if (Ui.Clicked(app, wid) && !this.IsDisabled()) {
            Click.Raise();
            app.RequestRedraw();
        }
        On.Fire(app, wid);
    }

    // ---- designer / serialization model -------------------------------------

    override string Kind() { return "FloatButton"; }

    override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec ico = PropSpec.Text("icon", "Icon");
        ico.str = Icon;
        ps.Add(ico);
        PropSpec sz = PropSpec.Int("size", "Diameter");
        sz.num = Size;
        ps.Add(sz);
        ps.Add(PropSpec.Text("class", "Classes"));
        return ps;
    }

    override List<string> Events() {
        List<string> e = Control.CommonEvents();
        e.Add("Click");
        return e;
    }

    override void BindEvent(string evt, Action a) {
        if (evt == "Click") { Click.Add(a); return; }
        On.AddByName(evt, a);
    }
}
