using System;
using Gui;

namespace Gui.Widget;

/// 浮动按钮：固定“返回顶部”/快捷操作的圆形操作按钮
/// 。`Class = "primary"` 使用强调色填充。
///
///     int id = new FloatButton("plus") { Class = "primary" }.Render(app, x, y);
///     if (Ui.Clicked(app, id)) { ... }
class FloatButton : Control {
    /// 绘制在圆内的图形。
    Binding<string> Icon;
    /// 直径（设备像素）；0 表示用主题的大控件高度。
    Binding<int> Size;
    /// 按钮被点击时触发。
    UiEvent Click;
    int wid;

    void InitFloatButton(string icon) {
        this.InitControl("floatbutton", 1);
        Icon = icon;
        Size = 0;
        wid = WidgetId.Next();
        wiresOwnEvents = true;
        Click = new UiEvent();
    }

    FloatButton() { InitFloatButton(""); }
    FloatButton(string icon) { InitFloatButton(icon); }

    int Diameter(App app) {
        int s = Size.Get();
        if (s > 0) { return s; }
        return app.theme.heightLarge;
    }

    /// 在 (x, y) 绘制并返回控件 id，宿主可用
    /// `Ui.Clicked` 检测点击，而无需订阅 `Click`。
    int Render(App app, int x, int y) {
        int d = this.Diameter(app);
        bx = x;
        by = y;
        bw = d;
        bh = d;
        this.OnPaint(app);
        return wid;
    }

    override void OnMeasure(App app) {
        int d = this.Diameter(app);
        prefW = d;
        prefH = d;
    }

    override void OnPaint(App app) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int d = this.Diameter(app);
        StyleBox s = Style.EasedIdIn(app, wid, "floatbutton", Class, "",
                                     this.IsDisabled(), false,
                                     bx, by, d, d);
        Style.Inline(s, this);
        int radius = s.RadiusOr(d / 2);

        // 先画柔和阴影，再画圆形主体。偏移取 CSS 的 box-shadow，
        // 以前写死 (1, 2)，皮肤把阴影调大调向也没有反应。
        if (s.shadow != 0) {
            c.FillRoundRect(bx + s.shadowDx, by + s.shadowDy, d, d, radius,
                            s.shadow);
        }
        c.FillRoundRect(bx, by, d, d, radius, s.BgOr(0));
        int bwidth = s.BorderWOr(1);
        int border = s.BorderOr(0);
        if (border != 0 && bwidth > 0) {
            c.DrawRoundRect(bx, by, d, d, radius, border, bwidth);
        }
        c.DrawGlyphIn(Icon.Get(), bx, by, d, d, s.FontOr(t.iconSizeMedium),
                      s.FgOr(0));

        app.hitTester.RegisterRect(wid, bx, by, d, d, 0);
        if (Ui.Clicked(app, wid) && !this.IsDisabled()) {
            Click.Raise();
            app.RequestRedraw();
        }
        On.Fire(app, wid);
    }

    // ---- 设计器 / 序列化模型 ----

    override string Kind() { return "FloatButton"; }

    override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec ico = PropSpec.Text("icon", "Icon");
        ico.str = Icon;
        ps.Add(ico);
        PropSpec sz = PropSpec.Int("size", "Diameter");
        sz.num = Size;
        ps.Add(sz);
        ps.Add(PropSpec.Text("class", "Classes"));
        return ps;
    }

    override List<string> Events() {
        List<string> e = Control.CommonEvents();
        e.Add("Click");
        return e;
    }

    override void BindEvent(string evt, Action a) {
        if (evt == "Click") { Click.Add(a); return; }
        On.AddByName(evt, a);
    }
}
