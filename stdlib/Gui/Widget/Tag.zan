using System;
using Gui;

namespace Gui.Widget;

/// 标签 / 徽章。与 Button 形状相同：简单赋值，所有视觉都是
/// 类，框及其内容由共享层绘制。
///
///     Tag t = new Tag { Text = "必读", Class = "错误 small" };
///     t.Closable = true;
///     t.Close += () => { tags.RemoveAt(i); };
///
/// 可识别的类只是皮肤定义的选择器：
///
///     tag                                        默认
///     .primary .info .success .warning .error     语义类型
///     .tiny .small .medium .large                 尺寸（与按钮共用）
///     .round                                     形状
class Tag : Control {
    Binding<string> Text;
    string Icon;
    /// 添加尾部关闭字形，点击时触发 Close。
    bool Closable;
    int wid;
    /// 点击关闭字形时触发；像 Button.Click 一样在 UI 线程排队，
    /// 处理器可从中移除模型中的该标签。
    UiEvent Close;

    void InitTag(string label) {
        this.InitControl(label, 1);
        Text = label;
        Icon = "";
        Closable = false;
        wid = WidgetId.Next();
        wiresOwnEvents = true;
        Close = new UiEvent();
    }

    Tag() { InitTag(""); }
    Tag(string label) { InitTag(label); }

    string Label() {
        if (Text == null) { return ""; }
        return Text.Get();
    }

    StyleBox ResolvedStyle(App app) {
        return Style.Full(app, "tag", Class, name, Style.SNormal());
    }

    int AutoWidth(App app) { return Tag.Width(app, this.Label(), Class); }

    int Render(App app, int x, int y) {
        int w = this.AutoWidth(app);
        int h = this.prefH;
        if (h <= 0) { h = app.theme.heightTiny; }
        StyleBox s = this.ResolveEasedStyleAsIn(
            app, wid, "tag", Class, false, false, x, y, w, h);
        h = s.ClampH(s.HeightOr(app.theme.heightTiny));
        string trailing = "";
        if (Closable) { trailing = "close"; }
        int closeX = BoxContent.Paint(app, wid, "tag", Class, name, s, x, y, w, h,
                                      Icon, this.Label(), trailing, false, false);
        if (!Closable) { return wid; }
        int glyph = BoxContent.GlyphSize(
            s.FontOr(Style.FontFallback(app, "small")));
        if (Ui.Activate(app, wid, closeX, y, glyph, h)) {
            Close.Post();
            app.window.Wake();
        }
        On.Fire(app, wid);
        return wid;
    }

    /// `text` 在 `cls` 样式下占据的宽度，使一行标签的布局
    /// 与 Render 绘制的间距完全一致。
    static int Width(App app, string text, string cls) {
        Theme t = app.theme;
        StyleBox s = Style.Of(app, "tag", cls, Style.SNormal());
        int fontPx = s.FontOr(Style.FontFallback(app, "small"));
        return BoxContent.Width("", text, "", fontPx, s.GapOr(t.gapSmall))
            + s.PadLOr(t.paddingSmall) + s.PadROr(t.paddingSmall);
    }

    /// `cls` 样式下标签的高度，使自行布局行的绘制者
    /// 能按 Chip 实际绘制的高度预留空间，而不是靠猜（行
    /// 比标签矮正是名称条与下方线条重叠的原因
    /// ）。
    static int Height(App app, string cls) {
        StyleBox s = Style.Of(app, "tag", cls, Style.SNormal());
        return s.HeightOr(app.theme.heightTiny);
    }

    /// 供自行管理布局的绘制者使用的立即模式标签（列表行、
    /// 设计器浮层）：同样的框和内容，无需实例。
    static void Chip(App app, int x, int y, string text, string cls) {
        StyleBox s = Style.Of(app, "tag", cls, Style.SNormal());
        int w = Tag.Width(app, text, cls);
        int h = Tag.Height(app, cls);
        BoxContent.Paint(app, 0, "tag", cls, "", s, x, y, w, h, "", text, "",
                         false, false);
    }

    /// 立即模式可关闭标签；返回关闭字形的命中 id。
    static int ChipClosable(App app, int x, int y, string text, string cls) {
        Theme t = app.theme;
        StyleBox s = Style.Of(app, "tag", cls, Style.SNormal());
        int id = app.focus.AllocId();
        int fontPx = s.FontOr(Style.FontFallback(app, "small"));
        int gap = s.GapOr(t.gapSmall);
        int glyph = BoxContent.GlyphSize(fontPx);
        int w = Tag.Width(app, text, cls) + gap + glyph;
        int h = s.HeightOr(t.heightTiny);
        int closeX = BoxContent.Paint(app, id, "tag", cls, "", s, x, y, w, h,
                                      "", text, "close", false, false);
        app.hitTester.RegisterRect(id, closeX, y, glyph, h, 0);
        return id;
    }

    /// 可关闭形式占据的宽度，使一行标签精确布局。
    static int ClosableWidth(App app, string text, string cls) {
        Theme t = app.theme;
        StyleBox s = Style.Of(app, "tag", cls, Style.SNormal());
        int fontPx = s.FontOr(Style.FontFallback(app, "small"));
        return Tag.Width(app, text, cls) + s.GapOr(t.gapSmall)
            + BoxContent.GlyphSize(fontPx);
    }

    // ---- 设计器 / 序列化模型 -------------------------------------

    override string Kind() { return "Tag"; }

    override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec text = PropSpec.Text("text", "Text");
        text.str = Text;
        text.AsName();
        ps.Add(text);
        PropSpec icon = PropSpec.Text("icon", "Icon");
        icon.str = Icon;
        ps.Add(icon);
        PropSpec close = PropSpec.Bool("closable", "Closable");
        close.flag = Closable;
        ps.Add(close);
        ps.Add(PropSpec.Text("class", "Classes"));
        return ps;
    }

    override List<string> Events() {
        List<string> e = Control.CommonEvents();
        e.Add("Close");
        return e;
    }

    /// 将关闭字形的 Close 路由到其 UiEvent 字段；其余事件
    /// 全部落入 `On` 的公共绑定。
    override void BindEvent(string evt, Action a) {
        if (evt == "Close") { Close.Add(a); return; }
        On.AddByName(evt, a);
    }

    // ---- 保留式钩子（Control） --------------------------------------

    override void OnMeasure(App app) {
        StyleBox s = this.ResolveStyleAs(app, "tag", Class, Style.SNormal());
        prefW = s.WidthOr(this.AutoWidth(app));
        prefH = s.HeightOr(app.theme.heightTiny);
    }

    override void OnPaint(App app) {
        // 行通常比标签高，因此在停靠边界内居中。
        int h = this.ResolvedStyle(app).HeightOr(app.theme.heightTiny);
        int py = by;
        if (bh > h) { py = by + (bh - h) / 2; }
        this.Render(app, bx, py);
    }
}
