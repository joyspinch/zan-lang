using System;
using Gui;

namespace Gui.Widget;

/// 在按钮下方挂面板的控件们共用的触发器按钮外观
/// （Dropdown、Popover、属性编辑器）。
class DropdownChrome {
    /// 用给定 id 绘制触发器按钮并注册其点击区域。
    static void PaintTrigger(App app, int id, int x, int y, int w, int h,
                             string label, bool open) {
        Canvas c = app.canvas;
        Theme t = app.theme;

        int hv = Ui.HoverLevel(app, id);
        if (open) { hv = 1000; }
        int border = App.LerpColor(t.borderPrimary, t.borderHover, hv);

        c.SurfaceRoundRect(x, y, w, h, t.borderRadiusMedium, t.bgPrimary,
                           border, 1);
        int textY = Canvas.CenterTextY(y, h, t.fontSizeMedium);
        c.DrawText(x + t.paddingMedium, textY, label, t.textPrimary,
                   t.fontSizeMedium);
        c.DrawGlyphIn("chevron-down",
                      x + w - t.paddingLarge - t.iconSizeSmall, y,
                      t.iconSizeSmall, h, t.iconSizeSmall, t.textSecondary);

        app.hitTester.Register(new HitRegion(id, x, y, w, h, 0));
    }
}

/// <summary>
/// Dropdown&lt;T&gt;：展开后下拉显示 T 列表的触发器。
///
/// 与 ListView&lt;T&gt; 结构相同——条目是普通实体，控件负责
/// 其余一切（展开状态、位置、滚动、命中测试、选中）：
///
///     Dropdown&lt;City&gt; pick = new Dropdown&lt;City&gt;(c =&gt; c.name);
///     pick.Bind(cities);
///     pick.OnChange(OnCity);
///     parent.Add(pick);            // 尺寸和位置由布局决定
///
/// 条目可以是完整组件而不只是文本，与列表行完全一致：
///
///     Dropdown&lt;User&gt; who = new Dropdown&lt;User&gt;(u =&gt; UserCard(u));
///
/// 面板延迟到框架覆盖层绘制，因此总是显示在
/// 后续内容之上，拦截穿透点击，并在外部点击
/// 或按 Escape 时关闭。
/// </summary>
class Dropdown<T> : Control {
    /// 面板内容：由列表控件管理行、模板和滚动。
    ListView<T> list;
    CellOf<T> textOf;
    string hint;
    bool open;
    int wid;
    /// 每帧暂存触发器几何信息，使延迟面板（在覆盖
    /// 层阶段绘制）能定位到触发器下方。
    int trigX;
    int trigY;
    int trigW;
    int trigH;
    int lastSel;
    int maxVisible;

    /// 选中不同条目时触发。
    UiEvent Change;
    UiEvent Opened;
    UiEvent Closed;

    void InitDropdown(ListView<T> content) {
        this.InitControl("dropdown", 0);
        wid = WidgetId.Next();
        wiresOwnEvents = true;
        hint = "";
        open = false;
        maxVisible = 8;
        lastSel = 0 - 1;
        Change = new UiEvent();
        Opened = new UiEvent();
        Closed = new UiEvent();
        list = content;
        list.Class = "flat headless";
    }

    /// 文本条目：`new Dropdown<City>(c => c.name)`。
    Dropdown(CellOf<T> text) {
        textOf = text;
        this.InitDropdown(new ListView<T>(new ListColumn<T>("", text)));
    }

    /// 组件条目：`new Dropdown<User>(u => UserCard(u))`。
    Dropdown(RowOf<T> item) {
        this.InitDropdown(new ListView<T>(item));
    }

    override string Kind() { return "Dropdown"; }

    override string StyleType() { return "select"; }

    /// 绑定数据源；列表每帧重新读取。
    Dropdown<T> Bind(List<T> src) {
        list.Bind(src);
        lastSel = list.SelectedIndex();
        return this;
    }

    Dropdown<T> OnChange(Action a) { Change.Add(a); return this; }
    Dropdown<T> OnOpen(Action a) { Opened.Add(a); return this; }
    Dropdown<T> OnClose(Action a) { Closed.Add(a); return this; }

    /// 未选中任何条目时显示的提示文本。
    Dropdown<T> Hint(string text) { hint = text; return this; }

    /// 面板在滚动前显示的条目数。
    Dropdown<T> Rows(int n) {
        if (n > 0) { maxVisible = n; }
        return this;
    }

    int Count() { return list.Count(); }
    int SelectedIndex() { return list.SelectedIndex(); }
    bool HasSelection() { return list.HasSelection(); }
    T Selected() { return list.Selected(); }

    void SelectIndex(int row) {
        list.SelectIndex(row);
        lastSel = list.SelectedIndex();
    }

    void Clear() {
        list.ClearSelection();
        lastSel = 0 - 1;
    }

    bool IsOpen() { return open; }

    void SetOpen(bool want) {
        if (open == want) { return; }
        open = want;
        if (open) { Opened.Post(); } else { Closed.Post(); }
    }

    void Open() { this.SetOpen(true); }
    void Close() { this.SetOpen(false); }

    /// 触发器标签：所选条目的文本，否则为提示文本。
    string TriggerText() {
        if (list.HasSelection() && textOf != null) {
            return textOf(list.Selected());
        }
        return hint;
    }

    override void OnMeasure(App app) {
        prefH = app.theme.heightMedium;
        prefW = app.Scale(160);
    }

    override void OnPaint(App app) {
        trigX = bx;
        trigY = by;
        trigW = bw;
        trigH = bh;
        DropdownChrome.PaintTrigger(app, wid, bx, by, bw, bh,
                                    this.TriggerText(), open);
        app.focus.RegisterFocusable(wid);

        bool toggle = Ui.Clicked(app, wid);
        if (Ui.Focused(app, wid) && app.EventKind() == 4) {
            int kc = app.window.EventKeyCode();
            if (kc == 13 || kc == 32) { toggle = true; }
        }
        if (toggle) {
            bool want = !open;
            this.SetOpen(want);
            // 拦截这次打开点击，防止刚弹出的面板把它当作
            // 外部点击而在同一帧再次关闭。
            if (want) { app.ClaimClick(); }
            app.RequestRedraw();
        }
        On.Fire(app, wid);

        if (open) { app.AddOverlay(OverlayPopup.Host(this)); }
    }

    /// 延迟面板：在所有内容之后绘制并分发事件，因此位于
    /// 所有控件之上并接收最上层的点击。
    override void OnPaintOverlay(App app) {
        if (!open) { return; }
        Theme t = app.theme;
        int rowH = t.heightMedium;
        int vis = list.Count();
        if (vis > maxVisible) { vis = maxVisible; }
        if (vis < 1) { vis = 1; }
        int viewH = OverlayPopup.FitH(app, vis * rowH + app.Scale(2));
        int popX = OverlayPopup.FitX(app, trigX, trigW);
        int popY = OverlayPopup.FitY(app, trigY + trigH + app.Scale(4),
                                     trigH, viewH);

        app.BlockHitsBelow();
        StyleBox pop = this.ResolvePartAs(app, "select", "popup", "popup",
                                          Class, Style.SSelected());
        pop.Paint(app, popX, popY, trigW, viewH);
        app.BlockHitsRect(popX, popY, trigW, viewH);

        list.RenderInside(app, new Rect(popX, popY, trigW, viewH));

        // 选择由列表负责；选中变化时关闭面板，并以一次 Change
        // 事件上报。
        if (list.SelectedIndex() != lastSel) {
            lastSel = list.SelectedIndex();
            this.SetOpen(false);
            Change.Post();
            app.ClaimClick();
            app.RequestRedraw();
            return;
        }
        if (app.ClickAvailable()) {
            bool inside = app.mouseX >= popX && app.mouseX < popX + trigW
                && app.mouseY >= popY && app.mouseY < popY + viewH;
            if (!inside) {
                this.SetOpen(false);
                app.RequestRedraw();
            }
        }
        if (app.EventKind() == 4 && app.window.EventKeyCode() == 27) {
            this.SetOpen(false);
            app.RequestRedraw();
        }
    }

    override List<string> Events() {
        List<string> e = Control.CommonEvents();
        e.Add("Change");
        e.Add("Opened");
        e.Add("Closed");
        return e;
    }

    /// 把下拉框的语义事件（Change/Opened/Closed）路由到对应
    /// UiEvent 字段；其余回落到 `On` 上的通用事件包
    /// （其 AddByName 忽略未知名称）。
    override void BindEvent(string evt, Action a) {
        if (evt == "Change") { Change.Add(a); return; }
        if (evt == "Opened") { Opened.Add(a); return; }
        if (evt == "Closed") { Closed.Add(a); return; }
        On.AddByName(evt, a);
    }
}
