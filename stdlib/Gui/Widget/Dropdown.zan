using System;
using Gui;

namespace Gui.Widget;

/// 在按钮下方挂面板的控件们共用的触发器按钮外观
/// （Dropdown、Popover、属性编辑器）。
class DropdownChrome {
    /// 用给定 id 绘制触发器按钮并注册其点击区域。
    static void PaintTrigger(App app, int id, int x, int y, int w, int h,
                             string label, bool open) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int hv = Ui.HoverLevelMsIn(app, id, 0, x, y, w, h);
        if (open) { hv = 1000; }
        StyleBox normal = Style.Of(app, "select", "", Style.SNormal());
        StyleBox hover = Style.Of(app, "select", "", Style.SHover());
        StyleBox s = StyleBox.Blend(normal, hover, hv);

        c.SurfaceRoundRect(x, y, w, h, s.RadiusOr(t.borderRadiusMedium),
                           s.bg, s.borderColor, s.BorderWOr(1));
        int fs = s.FontOr(Style.FontFallback(app, "medium"));
        int textY = Canvas.CenterTextY(y, h, fs);
        // 标签只能用左内边距到箭头之间的宽度；超出的一律截断，
        // 否则长模型名这类文本会直接画出触发器边框（盖到旁边的
        // 控件上）。
        int textX = x + s.PadLOr(t.paddingMedium);
        int chevX = x + w - t.paddingLarge - t.iconSizeSmall;
        StyleBox arrow = Style.Part(app, "select", "arrow", "", "", "",
                                    Style.SNormal());
        c.DrawText(textX, textY,
                   Ellipsis.Fit(label, chevX - textX - t.paddingSmall, fs),
                   s.fg, fs);
        c.DrawGlyphIn("chevron-down", chevX, y,
                      t.iconSizeSmall, h, t.iconSizeSmall, arrow.fg);

        app.hitTester.RegisterRect(id, x, y, w, h, 0);
    }
}

/// <summary>
/// Dropdown&lt;T&gt;：展开后下拉显示 T 列表的触发器。
///
/// 与 ListView&lt;T&gt; 结构相同——条目是普通实体，控件负责
/// 其余一切（展开状态、位置、滚动、命中测试、选中）：
///
///     Dropdown&lt;City&gt; pick = new Dropdown&lt;City&gt;(c =&gt; c.name);
///     pick.Bind(cities);
///     pick.OnChange(OnCity);
///     parent.Add(pick);            // 尺寸和位置由布局决定
///
/// 条目可以是完整组件而不只是文本，与列表行完全一致：
///
///     Dropdown&lt;User&gt; who = new Dropdown&lt;User&gt;(u =&gt; UserCard(u));
///
/// 面板延迟到框架覆盖层绘制，因此总是显示在
/// 后续内容之上，拦截穿透点击，并在外部点击
/// 或按 Escape 时关闭。
/// </summary>
class Dropdown<T> : Control {
    /// 面板内容：由列表控件管理行、模板和滚动。
    ListView<T> list;
    CellOf<T> textOf;
    string hint;
    bool open;
    int wid;
    /// 每帧暂存触发器几何信息，使延迟面板（在覆盖
    /// 层阶段绘制）能定位到触发器下方。
    int trigX;
    int trigY;
    int trigW;
    int trigH;
    int lastSel;
    int maxVisible;
    /// 条目是文本行（可以按最长文本量出面板宽度），还是模板控件行。
    bool textRows;

    /// 选中不同条目时触发。
    UiEvent Change;
    UiEvent Opened;
    UiEvent Closed;

    void InitDropdown(ListView<T> content) {
        this.InitControl("dropdown", 0);
        wid = WidgetId.Next();
        wiresOwnEvents = true;
        hint = "";
        open = false;
        maxVisible = 8;
        lastSel = 0 - 1;
        Change = new UiEvent();
        Opened = new UiEvent();
        Closed = new UiEvent();
        list = content;
        list.Class = "flat headless";
    }

    /// 文本条目：`new Dropdown<City>(c => c.name)`。
    Dropdown(CellOf<T> text) {
        textOf = text;
        textRows = true;
        this.InitDropdown(new ListView<T>(new ListColumn<T>("", text)));
    }

    /// 组件条目：`new Dropdown<User>(u => UserCard(u))`。
    Dropdown(RowOf<T> item) {
        this.InitDropdown(new ListView<T>(item));
    }

    override string Kind() { return "Dropdown"; }

    override string StyleType() { return "select"; }

    /// 绑定数据源；列表每帧重新读取。
    Dropdown<T> Bind(List<T> src) {
        list.Bind(src);
        lastSel = list.SelectedIndex();
        return this;
    }

    Dropdown<T> OnChange(Action a) { Change.Add(a); return this; }
    Dropdown<T> OnOpen(Action a) { Opened.Add(a); return this; }
    Dropdown<T> OnClose(Action a) { Closed.Add(a); return this; }

    /// 未选中任何条目时显示的提示文本。
    Dropdown<T> Hint(string text) { hint = text; return this; }

    /// 组件条目（`new Dropdown<User>(u => UserCard(u))`）的触发器文本：
    /// 模板行画的是控件，没有可显示的文本，不给这个的话触发器选中后
    /// 仍然只显示提示语。
    Dropdown<T> Label(CellOf<T> text) { textOf = text; return this; }

    /// 面板在滚动前显示的条目数。
    Dropdown<T> Rows(int n) {
        if (n > 0) { maxVisible = n; }
        return this;
    }

    int Count() { return list.Count(); }
    int SelectedIndex() { return list.SelectedIndex(); }
    bool HasSelection() { return list.HasSelection(); }
    T Selected() { return list.Selected(); }

    void SelectIndex(int row) {
        list.SelectIndex(row);
        lastSel = list.SelectedIndex();
    }

    void Clear() {
        list.ClearSelection();
        lastSel = 0 - 1;
    }

    bool IsOpen() { return open; }

    void SetOpen(bool want) {
        if (open == want) { return; }
        open = want;
        if (open) { Opened.Post(); } else { Closed.Post(); }
    }

    void Open() { this.SetOpen(true); }
    void Close() { this.SetOpen(false); }

    /// 触发器标签：所选条目的文本，否则为提示文本。
    string TriggerText() {
        if (list.HasSelection() && textOf != null) {
            return textOf(list.Selected());
        }
        return hint;
    }

    override void OnMeasure(App app) {
        prefH = app.theme.heightMedium;
        prefW = app.Scale(160);
    }

    /// 触发器走皮肤解析出的 `select` 框，而不是硬写主题色：
    /// 硬写的边框在任何皮肤上都是同一道亮边（嵌在深色面板头部
    /// 里就是一圈白边），样式表也关不掉它。
    void PaintTrigger(App app) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        StyleBox option = Style.Part(app, "select", "option", "option", "",
                                     "", Style.SNormal());
        int optionFont = option.FontOr(Style.FontFallback(app, "small"));
        StyleBox s = this.ResolveEasedStyleAsIn(
            app, wid, "select", Class, false, open, bx, by, bw, bh);
        s.Paint(app, bx, by, bw, bh);
        int fs = s.FontOr(Style.FontFallback(app, "medium"));
        int textY = Canvas.CenterTextY(by, bh, fs);
        int textX = bx + s.PadLOr(t.paddingMedium);
        int chevX = bx + bw - t.paddingLarge - t.iconSizeSmall;
        StyleBox arrow = this.ResolvePartAs(app, "select", "arrow", "",
                                            Class, Style.SNormal());
        c.DrawText(textX, textY,
                   Ellipsis.Fit(this.TriggerText(),
                                chevX - textX - t.paddingSmall, fs),
                   s.FgOr(0), fs);
        c.DrawGlyphIn("chevron-down", chevX, by,
                      t.iconSizeSmall, bh, t.iconSizeSmall, arrow.fg);
        app.hitTester.RegisterRect(wid, bx, by, bw, bh, 0);
    }

    override void OnPaint(App app) {
        trigX = bx;
        trigY = by;
        trigW = bw;
        trigH = bh;
        this.PaintTrigger(app);
        app.focus.RegisterFocusable(wid);

        bool toggle = Ui.Clicked(app, wid);
        if (Ui.Focused(app, wid) && app.EventKind() == 4) {
            int kc = app.window.EventKeyCode();
            if (kc == 13 || kc == 32) { toggle = true; }
        }
        if (toggle) {
            bool want = !open;
            this.SetOpen(want);
            // 拦截这次打开点击，防止刚弹出的面板把它当作
            // 外部点击而在同一帧再次关闭。
            if (want) { app.ClaimClick(); }
            app.RequestRedraw();
        }
        On.Fire(app, wid);

        if (open) { app.AddOverlay(OverlayPopup.Host(this)); }
    }

    /// 延迟面板：在所有内容之后绘制并分发事件，因此位于
    /// 所有控件之上并接收最上层的点击。
    /// 面板宽度：不窄于触发器，但至少能放下最长的一条文本。
    /// 按触发器宽度开面板会把每一条都截成 "Agnes AI / agnes-2..."，
    /// 选项之间看不出区别。模板行（组件条目）没有可量的文本，
    /// 保持触发器宽度。
    int PopupWidth(App app) {
        int w = trigW;
        if (!textRows || textOf == null) { return w; }
        Theme t = app.theme;
        StyleBox option = Style.Part(app, "select", "option", "option", "",
                                     "", Style.SNormal());
        int optionFont = option.FontOr(Style.FontFallback(app, "small"));
        // 列表行的左右内边距 + 滚动条位置（参见 ListView.PaintColumnRows）。
        int chrome = t.paddingMedium * 3 + app.Scale(10);
        int n = list.Count();
        for (int i = 0; i < n; i = i + 1) {
            int tw = Canvas.MeasureText(textOf(list.ItemAt(i)), optionFont);
            if (tw + chrome > w) { w = tw + chrome; }
        }
        int room = app.canvas.Width() - app.Scale(8);
        if (w > room) { w = room; }
        return w;
    }

    override void OnPaintOverlay(App app) {
        if (!open) { return; }
        Theme t = app.theme;
        int rowH = t.heightMedium;
        int vis = list.Count();
        if (vis > maxVisible) { vis = maxVisible; }
        if (vis < 1) { vis = 1; }
        int viewH = OverlayPopup.FitH(app, vis * rowH + app.Scale(2));
        int popW = this.PopupWidth(app);
        int popX = OverlayPopup.FitX(app, trigX, popW);
        int popY = OverlayPopup.FitY(app, trigY + trigH + app.Scale(4),
                                     trigH, viewH);

        app.BlockHitsBelow();
        StyleBox pop = this.ResolvePartAs(app, "select", "popup", "popup",
                                          Class, Style.SSelected());
        pop.Paint(app, popX, popY, popW, viewH);
        app.BlockHitsRect(popX, popY, popW, viewH);

        list.RenderInside(app, new Rect(popX, popY, popW, viewH));

        // 选择由列表负责；选中变化时关闭面板，并以一次 Change
        // 事件上报。
        if (list.SelectedIndex() != lastSel) {
            lastSel = list.SelectedIndex();
            this.SetOpen(false);
            Change.Post();
            app.ClaimClick();
            app.RequestRedraw();
            return;
        }
        if (app.ClickAvailable()) {
            bool inside = app.mouseX >= popX && app.mouseX < popX + popW
                && app.mouseY >= popY && app.mouseY < popY + viewH;
            if (!inside) {
                this.SetOpen(false);
                app.RequestRedraw();
            }
        }
        if (app.EventKind() == 4 && app.window.EventKeyCode() == 27) {
            this.SetOpen(false);
            app.RequestRedraw();
        }
    }

    override List<string> Events() {
        List<string> e = Control.CommonEvents();
        e.Add("Change");
        e.Add("Opened");
        e.Add("Closed");
        return e;
    }

    /// 把下拉框的语义事件（Change/Opened/Closed）路由到对应
    /// UiEvent 字段；其余回落到 `On` 上的通用事件包
    /// （其 AddByName 忽略未知名称）。
    override void BindEvent(string evt, Action a) {
        if (evt == "Change") { Change.Add(a); return; }
        if (evt == "Opened") { Opened.Add(a); return; }
        if (evt == "Closed") { Closed.Add(a); return; }
        On.AddByName(evt, a);
    }
}
