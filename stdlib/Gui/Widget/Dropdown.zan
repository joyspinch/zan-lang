using System;
using Gui;

namespace Gui.Widget;

/// 在按钮下方挂面板的控件们共用的触发器按钮外观
/// （Dropdown、Popover、属性编辑器）。
class DropdownChrome {
    /// 用给定 id 绘制触发器按钮并注册其点击区域。
    static void PaintTrigger(App app, int id, int x, int y, int w, int h,
                             string label, bool open) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int hv = Ui.HoverLevelMsIn(app, id, 0, x, y, w, h);
        if (open) { hv = 1000; }
        StyleBox normal = Style.Of(app, "select", "", Style.SNormal());
        StyleBox hover = Style.Of(app, "select", "", Style.SHover());
        StyleBox s = StyleBox.Blend(normal, hover, hv);

        c.SurfaceRoundRect(x, y, w, h, s.RadiusOr(t.borderRadiusMedium),
                           s.bg, s.borderColor, s.BorderWOr(1));
        int fs = s.FontOr(Style.FontFallback(app, "medium"));
        int textY = Canvas.CenterTextY(y, h, fs);
        // 标签只能用左内边距到箭头之间的宽度；超出的一律截断，
        // 否则长模型名这类文本会直接画出触发器边框（盖到旁边的
        // 控件上）。
        int textX = x + s.PadLOr(t.paddingMedium);
        int chevX = x + w - t.paddingLarge - t.iconSizeSmall;
        StyleBox arrow = Style.Part(app, "select", "arrow", "", "", "",
                                    Style.SNormal());
        c.DrawText(textX, textY,
                   Ellipsis.Fit(label, chevX - textX - t.paddingSmall, fs),
                   s.fg, fs);
        c.DrawGlyphIn("chevron-down", chevX, y,
                      t.iconSizeSmall, h, t.iconSizeSmall, arrow.fg);

        app.hitTester.RegisterRect(id, x, y, w, h, 0);
    }
}

/// <summary>
/// Dropdown：触发器下方弹出动作菜单的控件。
///
/// 与 SelectBox 分工：SelectBox 是「从列表里选一个值」；Dropdown
/// 是「点开菜单执行一个动作」。两种数据形态：
///
/// 1. 命令菜单（MenuItem）——图标、快捷键、分隔线、分组标题、
///    禁用/危险项和一层悬停展开的多级子菜单；叶子点击后其
///    `action` 写入并触发 Change，触发器不保留选中值：
///
///     menu.BindMenu(new List&lt;MenuItem&gt; {
///         MenuItem.Item("Share", "share", 0),
///         MenuItem.Separator(),
///         MenuItem.Danger("Delete", "trash", 1),
///         MenuItem.Submenu("Export", "download", kids),
///     });
///     menu.OnChange(OnAct);       // menu.Action() 是命中的 action
///
/// 2. 实体列表（与 SelectBox 的数据形态一致）——条目是普通实体，
///    `textOf` 取显示文本，选中索引语义与 SelectBox 相同，适合
///    简单的「选一个再执行」场景：
///
///     Dropdown&lt;City&gt; pick = new Dropdown&lt;City&gt;(c =&gt; c.name);
///     pick.Bind(cities);
///     pick.OnChange(OnCity);      // pick.Selected() 是所选实体
///     parent.Add(pick);           // 尺寸和位置由布局决定
///
/// 弹层是共享的富菜单组件（OverlayPopup.RichMenu）：延迟到框架
/// 覆盖层绘制，总是显示在后续内容之上，拦截穿透点击，外部点击
/// 或 Esc 关闭；长菜单出滚动条，滚轮与拖动都可用。
/// </summary>
class Dropdown<T> : Control {
    /// 命令菜单条目（BindMenu 模式）；flat 模式为 null。
    List<MenuItem> menuItems;
    /// 实体数据源（flat 模式）。每帧重新读取。
    List<T> data;
    /// 从实体取显示文本（flat 模式，Label 可换口径）。
    CellOf<T> textOf;
    /// 未选中任何条目时触发器显示的提示文本。
    string hint;
    /// 选中实体（flat 模式选择后存储；仅在选择发生时写入）。
    T selItem;
    /// flat 模式选中行号（-1 = 无）。
    int selIndex;
    /// 最近一次选择的 action id（菜单模式）。
    int lastAction;
    /// 触发器命中 id。
    int wid;
    /// 每帧暂存触发器几何信息，使延迟面板（在覆盖
    /// 层阶段绘制）能定位到触发器下方；面板宽度也不窄于触发器。
    int trigX;
    int trigY;
    int trigW;
    int trigH;
    /// 面板在滚动前显示的可点击行数（Rows(n)）。
    int maxRows;
    /// 上一帧的打开状态：RenderRich 关闭菜单只写 menuOpen 信号，
    /// 这里的跳变沿负责补发 Opened/Closed 与选中结算。
    bool wasOpen;

    /// 富菜单的信号组：结果 / 子菜单展开 / 滚动偏移都由宿主跨帧
    /// 持有（弹窗每帧重建）。
    SignalBool menuOpen;
    SignalInt menuResult;
    SignalInt menuSub;
    SignalInt menuScroll;
    /// 覆盖层命中 id 保留段（RenderRich 要求至少 256 个连续 id）。
    int menuBase;

    /// 选中不同条目 / 命中命令时触发。
    UiEvent Change;
    /// 面板打开后触发。
    UiEvent Opened;
    /// 面板关闭后触发（选中结算在 Change）。
    UiEvent Closed;

    /// 公共初始化（构造共用）。
    void InitDropdown() {
        this.InitControl("dropdown", 0);
        wid = WidgetId.Next();
        wiresOwnEvents = true;
        hint = "";
        maxRows = 8;
        selIndex = 0 - 1;
        lastAction = 0 - 1;
        menuOpen = new SignalBool(false);
        menuResult = new SignalInt(0 - 1);
        menuSub = new SignalInt(0 - 1);
        menuScroll = new SignalInt(0);
        menuBase = WidgetId.Block(256);
        Change = new UiEvent();
        Opened = new UiEvent();
        Closed = new UiEvent();
    }

    /// 文本条目：`new Dropdown<City>(c => c.name)`。
    Dropdown(CellOf<T> text) {
        this.InitDropdown();
        textOf = text;
    }

    /// 控件类型标识（序列化/设计器用）。
    override string Kind() { return "Dropdown"; }

    /// 覆写：CSS 类型选择器名（"select"，与 SelectBox 共用皮肤）。
    override string StyleType() { return "select"; }

    /// 绑定实体数据源；列表每帧重新读取。选择被清除。
    Dropdown<T> Bind(List<T> src) {
        data = src;
        selIndex = 0 - 1;
        return this;
    }

    /// 绑定命令菜单（MenuItem 树）。命中的叶子 action 在 Change
    /// 之后可经 `Action()` 读取；触发器不保留选中值，回到提示语。
    Dropdown<T> BindMenu(List<MenuItem> items) {
        menuItems = items;
        data = null;
        selIndex = 0 - 1;
        lastAction = 0 - 1;
        return this;
    }

    /// 订阅选中/命令命中（链式）。
    Dropdown<T> OnChange(Action a) { Change.Add(a); return this; }
    /// 订阅面板打开（链式）。
    Dropdown<T> OnOpen(Action a) { Opened.Add(a); return this; }
    /// 订阅面板关闭（链式）。
    Dropdown<T> OnClose(Action a) { Closed.Add(a); return this; }

    /// 未选中任何条目时显示的提示文本。
    Dropdown<T> Hint(string text) { hint = text; return this; }

    /// flat 模式选择后的触发器文本：默认用 `textOf`，绑定后仍可
    /// 用 Label 换一个取文本的口径。
    Dropdown<T> Label(CellOf<T> text) { textOf = text; return this; }

    /// 面板在滚动前显示的可点击行数。
    Dropdown<T> Rows(int n) {
        if (n > 0) { maxRows = n; }
        return this;
    }

    /// 条目数（菜单模式为菜单项数，flat 模式为数据行数）。
    int Count() {
        if (menuItems != null) { return menuItems.Count; }
        if (data != null) { return data.Count; }
        return 0;
    }

    /// flat 模式选中行号（-1 = 无）。
    int SelectedIndex() { return selIndex; }
    /// 是否有选中条目。
    bool HasSelection() { return selIndex >= 0; }
    /// 选中的实体（仅 flat 模式选择后有效）。
    T Selected() { return selItem; }

    /// 菜单模式：最近一次命中的叶子 action；无则为 -1。
    int Action() { return lastAction; }

    /// 程序化选中一行（不触发 Change、不弹面板）。
    void SelectIndex(int row) {
        if (data == null || row < 0 || row >= data.Count) { return; }
        selIndex = row;
        selItem = data[row];
    }

    /// 清除选择：触发器回到提示语（动作菜单语义）。
    void Clear() {
        selIndex = 0 - 1;
        lastAction = 0 - 1;
    }

    /// 面板当前是否打开。
    bool IsOpen() { return menuOpen.Get(); }

    /// 程序化开关面板；打开时重置滚动、子菜单与结果。
    /// 打开/关闭事件经 OnPaint 的跳变沿统一补发。
    void SetOpen(bool want) {
        if (menuOpen.Get() == want) { return; }
        if (want) {
            menuScroll.Set(0);
            menuSub.Set(0 - 1);
            menuResult.Set(0 - 1);
        }
        menuOpen.Set(want);
    }

    /// 打开面板。
    void Open() { this.SetOpen(true); }
    /// 关闭面板。
    void Close() { this.SetOpen(false); }

    /// 触发器标签：flat 模式所选条目的文本，否则为提示文本
    /// （命令菜单不把选中值留在触发器上）。
    string TriggerText() {
        if (selIndex >= 0 && textOf != null) { return textOf(selItem); }
        return hint;
    }

    /// 覆写：触发器默认一行高、160 逻辑像素宽。
    override void OnMeasure(App app) {
        prefH = app.theme.heightMedium;
        prefW = app.Scale(160);
    }

    /// 触发器走皮肤解析出的 `select` 框，而不是硬写主题色：
    /// 硬写的边框在任何皮肤上都是同一道亮边（嵌在深色面板头部
    /// 里就是一圈白边），样式表也关不掉它。
    void PaintTrigger(App app) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        StyleBox s = this.ResolveEasedStyleAsIn(
            app, wid, "select", Class, false, menuOpen.Get(), bx, by, bw, bh);
        s.Paint(app, bx, by, bw, bh);
        int fs = s.FontOr(Style.FontFallback(app, "medium"));
        int textY = Canvas.CenterTextY(by, bh, fs);
        int textX = bx + s.PadLOr(t.paddingMedium);
        int chevX = bx + bw - t.paddingLarge - t.iconSizeSmall;
        StyleBox arrow = this.ResolvePartAs(app, "select", "arrow", "",
                                            Class, Style.SNormal());
        c.DrawText(textX, textY,
                   Ellipsis.Fit(this.TriggerText(),
                                chevX - textX - t.paddingSmall, fs),
                   s.FgOr(0), fs);
        c.DrawGlyphIn("chevron-down", chevX, by,
                      t.iconSizeSmall, bh, t.iconSizeSmall, arrow.fg);
        app.hitTester.RegisterRect(wid, bx, by, bw, bh, 0);
    }

    /// 覆写：画触发器并处理点击/键盘开合与打开关闭跳变沿
    /// （菜单本体经帧末覆盖层绘制）。
    override void OnPaint(App app) {
        trigX = bx;
        trigY = by;
        trigW = bw;
        trigH = bh;
        this.PaintTrigger(app);
        app.focus.RegisterFocusable(wid);

        bool toggle = Ui.Clicked(app, wid);
        if (Ui.Focused(app, wid) && app.EventKind() == 4) {
            int kc = app.window.EventKeyCode();
            if (kc == 13 || kc == 32) { toggle = true; }
        }
        if (toggle) {
            bool want = !menuOpen.Get();
            this.SetOpen(want);
            // 拦截这次打开点击，防止刚弹出的菜单把它当作
            // 外部点击而在同一帧再次关闭。
            if (want) { app.ClaimClick(); }
        }
        On.Fire(app, wid);

        // 打开/关闭跳变沿：RenderRich 关闭菜单只写信号，事件与
        // 选中结算都收口在这里（代码 SetOpen 与用户点击同路）。
        bool nowOpen = menuOpen.Get();
        if (wasOpen && !nowOpen) {
            int act = menuResult.Get();
            if (act >= 0) {
                lastAction = act;
                if (data != null && act < data.Count) {
                    selIndex = act;
                    selItem = data[act];
                }
                Change.Post();
            }
            menuResult.Set(0 - 1);
            Closed.Post();
            app.RequestRedraw();
        }
        if (!wasOpen && nowOpen) { Opened.Post(); }
        wasOpen = nowOpen;

        if (menuOpen.Get()) { app.AddOverlay(OverlayPopup.Host(this)); }
    }

    /// flat 模式把实体列表转成菜单条目（action = 行号）。每帧重建：
    /// 数据是调用方的，绑定后原地修改也要在下一帧生效。
    List<MenuItem> SyncItems(App app) {
        if (menuItems != null) { return menuItems; }
        List<MenuItem> items = new List<MenuItem>();
        if (data == null) { return items; }
        int n = data.Count;
        for (int i = 0; i < n; i = i + 1) {
            items.Add(MenuItem.Item(textOf(data[i]), "", i));
        }
        return items;
    }

    /// 延迟面板：交给共享富菜单（图标/分隔线/子菜单/滚动条）在
    /// 覆盖层阶段绘制与分发。面板不窄于触发器。
    override void OnPaintOverlay(App app) {
        if (!menuOpen.Get()) { return; }
        List<MenuItem> items = this.SyncItems(app);
        int popW = OverlayPopup.RichWidth(app, items);
        if (popW < trigW) { popW = trigW; }
        int popH = OverlayPopup.RichHeight(app, items);
        int popX = OverlayPopup.FitX(app, trigX, popW);
        int popY = OverlayPopup.FitY(app, trigY + trigH + app.Scale(4),
                                     trigH, popH);
        app.AddOverlay(OverlayPopup.RichMenu(popX, popY, items, menuBase,
            menuResult, menuOpen, menuSub));
    }

    override List<string> Events() {
        List<string> e = Control.CommonEvents();
        e.Add("Change");
        e.Add("Opened");
        e.Add("Closed");
        return e;
    }

    /// 把下拉框的语义事件（Change/Opened/Closed）路由到对应
    /// UiEvent 字段；其余回落到 `On` 上的通用事件包
    /// （其 AddByName 忽略未知名称）。
    override void BindEvent(string evt, Action a) {
        if (evt == "Change") { Change.Add(a); return; }
        if (evt == "Opened") { Opened.Add(a); return; }
        if (evt == "Closed") { Closed.Add(a); return; }
        On.AddByName(evt, a);
    }
}
