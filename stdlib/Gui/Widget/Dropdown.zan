using System;
using Gui;

namespace Gui.Widget;

/// The trigger-button chrome shared by every widget that hangs a panel under
/// a button (Dropdown, Popover, property editors).
class DropdownChrome {
    /// Draws the trigger button with the given id and registers its hit box.
    static void PaintTrigger(App app, int id, int x, int y, int w, int h,
                             string label, bool open) {
        Canvas c = app.canvas;
        Theme t = app.theme;

        int hv = Ui.HoverLevel(app, id);
        if (open) { hv = 1000; }
        int border = App.LerpColor(t.borderPrimary, t.borderHover, hv);

        c.SurfaceRoundRect(x, y, w, h, t.borderRadiusMedium, t.bgPrimary,
                           border, 1);
        int textY = Canvas.CenterTextY(y, h, t.fontSizeMedium);
        c.DrawText(x + t.paddingMedium, textY, label, t.textPrimary,
                   t.fontSizeMedium);
        c.DrawGlyphIn("chevron-down",
                      x + w - t.paddingLarge - t.iconSizeSmall, y,
                      t.iconSizeSmall, h, t.iconSizeSmall, t.textSecondary);

        app.hitTester.Register(HitRegion.Create(id, x, y, w, h, 0));
    }
}

/// <summary>
/// Dropdown&lt;T&gt;: a trigger that drops a list of T.
///
/// Same shape as ListView&lt;T&gt; — items are plain entities, the widget owns
/// everything else (open state, placement, scrolling, hit testing, selection):
///
///     Dropdown&lt;City&gt; pick = new Dropdown&lt;City&gt;(c =&gt; c.name);
///     pick.Bind(cities);
///     pick.OnChange(OnCity);
///     parent.Add(pick);            // size and position come from the layout
///
/// Items can be whole components instead of text, exactly like list rows:
///
///     Dropdown&lt;User&gt; who = new Dropdown&lt;User&gt;(u =&gt; UserCard(u));
///
/// The panel is deferred to the framework overlay layer, so it always draws
/// above later content, blocks click-through and closes on an outside press
/// or Escape.
/// </summary>
class Dropdown<T> : Control {
    /// The panel content: a list owns the rows, templates and scrolling.
    ListView<T> list;
    CellOf<T> textOf;
    string hint;
    bool open;
    int wid;
    /// Trigger geometry stashed each frame so the deferred panel (drawn in the
    /// overlay pass) can place itself under the trigger.
    int trigX;
    int trigY;
    int trigW;
    int trigH;
    int lastSel;
    int maxVisible;

    /// Fires when a different item is picked.
    UiEvent Change;
    UiEvent Opened;
    UiEvent Closed;

    void InitDropdown(ListView<T> content) {
        this.InitControl("dropdown", 0);
        wid = WidgetId.Next();
        wiresOwnEvents = true;
        hint = "";
        open = false;
        maxVisible = 8;
        lastSel = 0 - 1;
        Change = UiEvent.Create();
        Opened = UiEvent.Create();
        Closed = UiEvent.Create();
        list = content;
        list.Class = "flat headless";
    }

    /// Text items: `new Dropdown<City>(c => c.name)`.
    Dropdown(CellOf<T> text) {
        textOf = text;
        this.InitDropdown(new ListView<T>(new ListColumn<T>("", text)));
    }

    /// Component items: `new Dropdown<User>(u => UserCard(u))`.
    Dropdown(RowOf<T> item) {
        this.InitDropdown(new ListView<T>(item));
    }

    override string Kind() { return "Dropdown"; }

    override string StyleType() { return "select"; }

    /// Binds the data source; the list re-reads it every frame.
    Dropdown<T> Bind(List<T> src) {
        list.Bind(src);
        lastSel = list.SelectedIndex();
        return this;
    }

    Dropdown<T> OnChange(Action a) { Change.Add(a); return this; }
    Dropdown<T> OnOpen(Action a) { Opened.Add(a); return this; }
    Dropdown<T> OnClose(Action a) { Closed.Add(a); return this; }

    /// Text shown while nothing is picked.
    Dropdown<T> Hint(string text) { hint = text; return this; }

    /// How many items the panel shows before it scrolls.
    Dropdown<T> Rows(int n) {
        if (n > 0) { maxVisible = n; }
        return this;
    }

    int Count() { return list.Count(); }
    int SelectedIndex() { return list.SelectedIndex(); }
    bool HasSelection() { return list.HasSelection(); }
    T Selected() { return list.Selected(); }

    void SelectIndex(int row) {
        list.SelectIndex(row);
        lastSel = list.SelectedIndex();
    }

    void Clear() {
        list.ClearSelection();
        lastSel = 0 - 1;
    }

    bool IsOpen() { return open; }

    void SetOpen(bool want) {
        if (open == want) { return; }
        open = want;
        if (open) { Opened.Post(); } else { Closed.Post(); }
    }

    void Open() { this.SetOpen(true); }
    void Close() { this.SetOpen(false); }

    /// The trigger label: the picked item's text, else the hint.
    string TriggerText() {
        if (list.HasSelection() && textOf != null) {
            return textOf(list.Selected());
        }
        return hint;
    }

    override void OnMeasure(App app) {
        prefH = app.theme.heightMedium;
        prefW = app.Scale(160);
    }

    override void OnPaint(App app) {
        trigX = bx;
        trigY = by;
        trigW = bw;
        trigH = bh;
        DropdownChrome.PaintTrigger(app, wid, bx, by, bw, bh,
                                    this.TriggerText(), open);
        app.focus.RegisterFocusable(wid);

        bool toggle = Ui.Clicked(app, wid);
        if (Ui.Focused(app, wid) && app.EventKind() == 4) {
            int kc = app.window.EventKeyCode();
            if (kc == 13 || kc == 32) { toggle = true; }
        }
        if (toggle) {
            bool want = !open;
            this.SetOpen(want);
            // Claim the opening click so the just-shown panel does not read it
            // as an outside press and close again the same frame.
            if (want) { app.ClaimClick(); }
            app.RequestRedraw();
        }
        On.Fire(app, wid);

        if (open) { app.AddOverlay(OverlayPopup.Host(this)); }
    }

    /// The deferred panel: drawn and dispatched after all content, so it sits
    /// above every widget and takes the top-most hits.
    override void OnPaintOverlay(App app) {
        if (!open) { return; }
        Theme t = app.theme;
        int rowH = t.heightMedium;
        int vis = list.Count();
        if (vis > maxVisible) { vis = maxVisible; }
        if (vis < 1) { vis = 1; }
        int viewH = OverlayPopup.FitH(app, vis * rowH + app.Scale(2));
        int popX = OverlayPopup.FitX(app, trigX, trigW);
        int popY = OverlayPopup.FitY(app, trigY + trigH + app.Scale(4),
                                     trigH, viewH);

        app.BlockHitsBelow();
        StyleBox pop = this.ResolvePartAs(app, "select", "popup", "popup",
                                          Class, Style.SSelected());
        pop.Paint(app, popX, popY, trigW, viewH);
        app.BlockHitsRect(popX, popY, trigW, viewH);

        list.RenderInside(app, Rect.Create(popX, popY, trigW, viewH));

        // The list owns picking; a changed selection closes the panel and is
        // reported as one Change.
        if (list.SelectedIndex() != lastSel) {
            lastSel = list.SelectedIndex();
            this.SetOpen(false);
            Change.Post();
            app.ClaimClick();
            app.RequestRedraw();
            return;
        }
        if (app.ClickAvailable()) {
            bool inside = app.mouseX >= popX && app.mouseX < popX + trigW
                && app.mouseY >= popY && app.mouseY < popY + viewH;
            if (!inside) {
                this.SetOpen(false);
                app.RequestRedraw();
            }
        }
        if (app.EventKind() == 4 && app.window.EventKeyCode() == 27) {
            this.SetOpen(false);
            app.RequestRedraw();
        }
    }

    override List<string> Events() {
        List<string> e = Control.CommonEvents();
        e.Add("Change");
        e.Add("Opened");
        e.Add("Closed");
        return e;
    }

    /// Routes the dropdown's semantic events (Change/Opened/Closed) to their
    /// UiEvent fields; everything else falls through to the common bundle on
    /// `On` (whose AddByName ignores names it does not know).
    override void BindEvent(string evt, Action a) {
        if (evt == "Change") { Change.Add(a); return; }
        if (evt == "Opened") { Opened.Add(a); return; }
        if (evt == "Closed") { Closed.Add(a); return; }
        On.AddByName(evt, a);
    }
}
