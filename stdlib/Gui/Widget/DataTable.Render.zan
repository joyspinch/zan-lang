using System;
using Gui;

namespace Gui.Widget;

/// DataTable part: cell rendering (conditional formatting, cell types)
/// and the virtualised main render path (header / body / footer /
/// interaction).
partial class DataTable {
    // ---------- cell rendering ----------

    /// `fgOverride` is a packed colour from the state's CellStyler, or 0 for
    /// none. It replaces the theme's text colour on plain and link cells, but a
    /// conditional-format colour still wins — there, the colour *is* the
    /// information the cell carries.
    static void DrawCell(App app, DataColumn col, string val, int cx, int cy, int cw, int rowH, double cfLo, double cfHi, int fgOverride) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int fs = t.fontSizeMedium;
        int pad = t.paddingSmall;
        int innerW = cw - pad * 2;

        // ---- conditional formatting (plain text/numeric cells only) ----
        int cfText = t.textPrimary;
        if (fgOverride != 0) { cfText = fgOverride; }
        if (col.cfMode != 0 && col.cellType == 0) {
            double v = DataTable.ParseReal(val);
            if (col.cfMode == 1) {
                // data bar proportional to value across the column's min..max
                double span = cfHi - cfLo;
                if (span <= 0.0) { span = 1.0; }
                int frac = (int)((v - cfLo) * 100.0 / span);
                if (frac < 0) { frac = 0; }
                if (frac > 100) { frac = 100; }
                int barH = rowH - app.Scale(8);
                int barY = cy + app.Scale(4);
                int barW = frac * innerW / 100;
                int tint = DataTable.ColorAlpha(col.cfColor, 95);
                int rad = app.Scale(2);
                if (barW > 0) {
                    // Clean flat data bar with a slight corner radius; fall back to
                    // a plain rect when the bar is too short to round without the
                    // straight-segment math underflowing.
                    if (barW < rad * 2) { c.FillRect(cx + pad, barY, barW, barH, tint); }
                    else { c.FillRoundRect(cx + pad, barY, barW, barH, rad, tint); }
                }
                string sb = DataTable.Truncate(DataTable.FormatCell(col, val), fs, innerW);
                int twb = Canvas.MeasureText(sb, fs);
                int tyb = cy + (rowH - Canvas.FontHeight(fs)) / 2;
                c.DrawText(cx + cw - pad - twb, tyb, sb, cfText, fs);
                return;
            } else if (col.cfMode == 2) {
                // Scale the 0..1 position to a 0..1000 integer ramp so the lerp
                // keeps its integer signature while fractional columns still
                // spread across the gradient.
                double cspan = cfHi - cfLo;
                if (cspan <= 0.0) { cspan = 1.0; }
                int pos = (int)((v - cfLo) * 1000.0 / cspan);
                if (pos < 0) { pos = 0; }
                if (pos > 1000) { pos = 1000; }
                c.FillRect(cx, cy, cw, rowH, DataTable.LerpColor(col.cfColor, col.cfColor2, pos, 1000));
            } else if (col.cfMode == 3 && v > (double)col.cfThreshold) {
                c.FillRect(cx, cy, cw, rowH, DataTable.ColorAlpha(col.cfColor, 38));
                cfText = col.cfColor;
            } else if (col.cfMode == 4 && v < (double)col.cfThreshold) {
                c.FillRect(cx, cy, cw, rowH, DataTable.ColorAlpha(col.cfColor, 38));
                cfText = col.cfColor;
            }
        }

        // ---- bool: a checkbox, a check/cross glyph, or plain text ----
        if (col.isBool) {
            bool on = DataTable.ParseBool(val);
            if (col.boolStyle == 2) {
                string bt = col.boolFalse;
                if (on) { bt = col.boolTrue; }
                int btw = Canvas.MeasureText(bt, fs);
                int btx = cx + (cw - btw) / 2;
                if (col.align == 0) { btx = cx + pad; }
                if (col.align == 2) { btx = cx + cw - pad - btw; }
                c.DrawText(btx, cy + (rowH - Canvas.FontHeight(fs)) / 2, bt, cfText, fs);
                return;
            }
            int box = app.Scale(16);
            int bx = cx + (cw - box) / 2;
            int by = cy + (rowH - box) / 2;
            int ins = app.Scale(3);
            if (col.boolStyle == 1) {
                // Glyph style: no frame, just a green check or a muted cross.
                if (on) { Icon.Draw(c, "check", bx + ins, by + ins, box - ins * 2, t.success); }
                else { Icon.Draw(c, "close", bx + ins, by + ins, box - ins * 2, t.textTertiary); }
                return;
            }
            if (on) {
                c.FillRoundRect(bx, by, box, box, t.borderRadiusSmall, t.primary);
                Icon.Draw(c, "check", bx + ins, by + ins, box - ins * 2, t.textInverse);
            } else {
                c.FillRoundRect(bx, by, box, box, t.borderRadiusSmall, t.bgPrimary);
                c.DrawRect(bx, by, box, box, t.borderPrimary, 1);
            }
            return;
        }

        if (col.cellType == 3) {
            int pct = DataTable.ParseInt(val);
            if (pct < 0) { pct = 0; }
            if (pct > 100) { pct = 100; }
            int barH = app.Scale(6);
            int barY = cy + (rowH - barH) / 2;
            int barW = innerW - app.Scale(40);
            if (barW < app.Scale(20)) { barW = app.Scale(20); }
            c.FillRoundRect(cx + pad, barY, barW, barH, barH / 2, t.bgTertiary);
            int fillW = pct * barW / 100;
            int barColor = t.primary;
            if (pct >= 100) { barColor = t.success; }
            c.FillRoundRect(cx + pad, barY, fillW, barH, barH / 2, barColor);
            int txtY = cy + (rowH - Canvas.FontHeight(t.fontSizeSmall)) / 2;
            c.DrawText(cx + pad + barW + app.Scale(6), txtY, Convert.ToString(pct) + "%", t.textSecondary, t.fontSizeSmall);
            return;
        }

        if (col.cellType == 2) {
            int tc = DataTable.TypeColor(t, col.tagType);
            int tagH = t.heightSmall;
            int tagY = cy + (rowH - tagH) / 2;
            string label = DataTable.Truncate(val, t.fontSizeSmall, innerW - pad * 2);
            int tagW = Canvas.MeasureText(label, t.fontSizeSmall) + pad * 2;
            int tagX = cx + pad;
            if (col.align == 1) { tagX = cx + (cw - tagW) / 2; }
            c.FillRoundRect(tagX, tagY, tagW, tagH, t.borderRadiusSmall, t.bgSecondary);
            c.DrawRect(tagX, tagY, tagW, tagH, tc, 1);
            int txtY = tagY + (tagH - Canvas.FontHeight(t.fontSizeSmall)) / 2;
            c.DrawText(tagX + pad, txtY, label, tc, t.fontSizeSmall);
            return;
        }

        if (col.cellType == 4) {
            int dotR = app.Scale(4);
            int dotColor = t.success;
            if (val == "0" || val == "" || val == "Offline" || val == "Idle" || val == "Inactive" || val == "Closed") { dotColor = t.textTertiary; }
            int cxc = cx + pad + dotR;
            if (col.align == 1) { cxc = cx + cw / 2 - Canvas.MeasureText(val, fs) / 2 - dotR - app.Scale(4); }
            c.FillCircle(cxc, cy + rowH / 2, dotR, dotColor);
            int txtY = cy + (rowH - Canvas.FontHeight(fs)) / 2;
            c.DrawText(cxc + dotR + app.Scale(4), txtY, val, cfText, fs);
            return;
        }

        int color = cfText;
        if (col.cellType == 1 && fgOverride == 0) { color = t.primary; }
        string shown = DataTable.Truncate(DataTable.FormatCell(col, val), fs, innerW);
        int tw = Canvas.MeasureText(shown, fs);
        int tx = cx + pad;
        if (col.align == 1) { tx = cx + (cw - tw) / 2; }
        if (col.align == 2) { tx = cx + cw - pad - tw; }
        int ty = cy + (rowH - Canvas.FontHeight(fs)) / 2;
        c.DrawText(tx, ty, shown, color, fs);
    }

    // ---------- frozen-band geometry ----------
    // The data region is three side-by-side strips: 0 frozen-left, 1 scrolling,
    // 2 frozen-right. Every pass asks these three for its strip rather than
    // recomputing the arithmetic, so the header, filter row, cells and summary
    // cannot drift apart.

    static int BandLeft(int band, int firstDataX, int bandX, int rightX) {
        if (band == 0) { return firstDataX; }
        if (band == 2) { return rightX; }
        return bandX;
    }

    static int BandRight(int band, int firstDataX, int bandX, int bandW,
                         int rightX, int pinnedW, int pinnedRW, int clipRight) {
        if (band == 0) { return firstDataX + pinnedW; }
        if (band == 2) { return rightX + pinnedRW; }
        int r = bandX + bandW;
        if (r > clipRight) { r = clipRight; }
        return r;
    }

    static void PushBandClip(Canvas c, int band, int firstDataX, int bandX, int bandW,
                             int rightX, int pinnedW, int pinnedRW,
                             int y, int h, int clipRight) {
        int l = DataTable.BandLeft(band, firstDataX, bandX, rightX);
        int r = DataTable.BandRight(band, firstDataX, bandX, bandW, rightX,
                                    pinnedW, pinnedRW, clipRight);
        int w = r - l;
        if (w < 0) { w = 0; }
        c.PushClip(l, y, w, h);
    }

    // ---------- group panel ----------

    /// Chip x positions and widths for the group panel, outer-to-inner. Shared
    /// by the strip's painting, its hit tests and the header drop, so all three
    /// agree on the geometry by construction.
    static void GroupChipLayout(App app, List<DataColumn> cols, DataTableState st,
                                int x, List<int> outX, List<int> outW) {
        Theme t = app.theme;
        int fs = t.fontSizeSmall;
        int cx = x + app.Scale(10);
        int i = 0;
        while (i < st.groupCols.Count) {
            int w = Canvas.MeasureText(cols[st.groupCols[i]].title, fs) + app.Scale(38);
            outX.Add(cx);
            outW.Add(w);
            cx = cx + w + app.Scale(8);
            i = i + 1;
        }
    }

    /// Insertion slot (0..count) the pointer addresses: the number of chips whose
    /// midpoint sits left of it.
    static int GroupDropSlot(App app, List<int> cxs, List<int> cws) {
        int slot = 0;
        int i = 0;
        while (i < cxs.Count) {
            if (app.mouseX > cxs[i] + cws[i] / 2) { slot = i + 1; }
            i = i + 1;
        }
        return slot;
    }

    /// The grouping strip above the header: one chip per grouped column
    /// (outer-to-inner) with a remove button, an insertion indicator while
    /// something is dragged over it, and a hint while the table is flat.
    /// `headerDrag` is true while a column header is being dragged, so the strip
    /// can advertise itself as a drop target.
    static void RenderGroupPanel(App app, int x, int y, int viewW, int h,
                                 List<DataColumn> cols, DataTableState st,
                                 bool headerDrag) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int fs = t.fontSizeSmall;
        bool over = app.mouseX >= x && app.mouseX < x + viewW
                    && app.mouseY >= y && app.mouseY < y + h;
        int bg = t.bgTertiary;
        if (headerDrag && over) { bg = t.bgActive; }
        c.FillRect(x, y, viewW, h, bg);
        c.FillRect(x, y + h - 1, viewW, 1, t.divider);
        c.PushClip(x, y, viewW, h);

        List<int> cxs = new List<int>();
        List<int> cws = new List<int>();
        DataTable.GroupChipLayout(app, cols, st, x, cxs, cws);
        int chipH = h - app.Scale(10);
        int chipY = y + app.Scale(5);

        if (st.groupCols.Count == 0) {
            c.DrawText(x + app.Scale(10), y + (h - Canvas.FontHeight(fs)) / 2,
                       "Drag a column header here to group by it",
                       t.textTertiary, fs);
        }

        int i = 0;
        while (i < st.groupCols.Count) {
            int col = st.groupCols[i];
            int cxp = cxs[i];
            int cwp = cws[i];
            bool dragged = st.dragChip == col;
            int fill = t.bgSecondary;
            if (dragged) { fill = t.primary; }
            c.FillRoundRect(cxp, chipY, cwp, chipH, chipH / 2, fill);
            int lc = t.textPrimary;
            if (dragged) { lc = t.textInverse; }
            int rsz = app.Scale(14);
            int rx = cxp + cwp - rsz - app.Scale(6);
            int ry = chipY + (chipH - rsz) / 2;
            string lbl = DataTable.Truncate(cols[col].title, fs,
                                            rx - cxp - app.Scale(14));
            c.DrawText(cxp + app.Scale(10),
                       chipY + (chipH - Canvas.FontHeight(fs)) / 2, lbl, lc, fs);
            int rmId = app.focus.AllocId();
            Icon.DrawCenteredIn(c, "close", rx, ry, rsz, rsz, app.Scale(10), lc);
            app.hitTester.Register(HitRegion.Create(rmId, rx, ry, rsz, rsz, 0));
            int chipId = app.focus.AllocId();
            app.hitTester.Register(HitRegion.Create(chipId, cxp, chipY,
                                                    rx - cxp, chipH, 0));
            if (app.window.EventKind() == 3 && app.window.EventButton() == 0
                && app.hitTester.HitTest(app.mouseX, app.mouseY) == rmId) {
                DataTable.UngroupOne(st, col);
                st.GroupChanged.Raise();
                app.RequestRedraw();
            }
            if (app.window.EventKind() == 2 && app.window.EventButton() == 0
                && app.hitTester.HitTest(app.mouseX, app.mouseY) == chipId) {
                st.dragChip = col;
                app.RequestRedraw();
            }
            i = i + 1;
        }

        if (st.dragChip >= 0 || (headerDrag && over)) {
            int slot = DataTable.GroupDropSlot(app, cxs, cws);
            int lineX = x + app.Scale(6);
            if (slot > 0) { lineX = cxs[slot - 1] + cws[slot - 1] + app.Scale(2); }
            c.FillRect(lineX, chipY, app.Scale(2), chipH, t.primary);
        }
        c.PopClip();

        // Finalize a chip drag on release (the App clears the press before this
        // render runs, exactly as for the header drag).
        if (st.dragChip >= 0 && app.focus.pressedId < 0) {
            int from = DataTable.GroupDepth(st, st.dragChip);
            int dst = DataTable.GroupDropSlot(app, cxs, cws);
            if (dst > from) { dst = dst - 1; }
            if (from >= 0 && dst != from) {
                DataTable.MoveGroup(st, st.dragChip, dst);
                st.GroupChanged.Raise();
            }
            st.dragChip = -1;
            app.RequestRedraw();
        }
    }

    // ---------- main render ----------

    /// Convenience overload: render an in-memory List<DataRow> (wraps it in a
    /// RowListSource). For large / virtual data, use RenderSource with a custom
    /// DataSource subclass instead.
    static void Render(App app, int x, int y, int viewW, int viewH,
                       List<DataColumn> cols, List<DataRow> rows, DataTableState st) {
        DataTable.RenderSource(app, x, y, viewW, viewH, cols, RowListSource.Create(rows), st);
    }

    static void RenderSource(App app, int x, int y, int viewW, int viewH,
                       List<DataColumn> cols, DataSource src, DataTableState st) {
        Canvas c = app.canvas;
        Theme t = app.theme;

        DataTable.EnsureInit(st, cols, src);
        DataTable.SyncBindings(st);
        DataTable.Recompute(st, cols, src);

        int titleRowH = t.heightMedium;
        int rowH = t.heightMedium;
        int fs = t.fontSizeMedium;
        // Band rows sit above the column titles and are a little shorter — they
        // carry a group name, not a sort arrow or a filter icon. `headerH` stays
        // the full header height, so every later measurement (body top, menu
        // anchors, the outside-click test) keeps working unchanged.
        int bandRowH = t.heightSmall;
        int bandLevels = 0;
        int headerH = titleRowH;

        // The group panel is a strip above the header, so it moves the header's
        // top edge down while `y` stays the widget's own top. Every vertical
        // measurement below is taken from `hdrY`, which equals `y` when the strip
        // is hidden — so a table without the panel lays out exactly as before.
        int groupPanelH = 0;
        if (st.showGroupPanel) { groupPanelH = app.Scale(34); }
        int hdrY = y + groupPanelH;
        int panelY = y;
        if (st.showGroupPanel) {
            DataTable.RenderGroupPanel(app, x, panelY, viewW, groupPanelH, cols, st,
                                       st.dragCol >= 0 && st.dragColMoved);
        }
        y = hdrY;
        viewH = viewH - groupPanelH;

        int numW = 0;
        if (st.showRowNum) {
            // Wide enough for the largest row number so 7-digit counts never
            // spill into the neighbouring column.
            numW = app.Scale(46);
            int needW = Canvas.MeasureText(Convert.ToString(src.RowCount()), t.fontSizeSmall)
                        + app.Scale(16);
            if (needW > numW) { numW = needW; }
        }
        int selW = 0;
        if (st.showSelect) { selW = app.Scale(40); }

        int gridColor = t.divider;
        int menuIconW = app.Scale(22);

        // Right edge that content may not spill past (leaves room for the
        // vertical scrollbar). Columns whose right side would exceed this are
        // clamped, and any column starting beyond it is skipped — so cells and
        // headers never draw outside the table's own border.
        int sbGutter = app.Scale(12);
        int clipRight = x + viewW - sbGutter;

        // total data width (hidden columns contribute nothing)
        int dataW = 0;
        int ci = 0;
        while (ci < st.colWidths.Count) {
            if (!st.colHidden[ci]) { dataW = dataW + st.colWidths[ci]; }
            ci = ci + 1;
        }
        int totalW = numW + selW + dataW;

        // Columns keep their natural widths; when the total exceeds the
        // available band the data region pans horizontally (st.scrollX) and
        // only the visible column window is drawn — so wide tables scroll
        // instead of squeezing every column into the viewport. Hidden columns
        // collapse to zero width; frozen (pinned) and grouped columns are
        // hoisted to the front of the visible order.
        int availData = clipRight - (x + numW + selW);
        if (availData < app.Scale(80)) { availData = app.Scale(80); }
        st.dispW.Clear();
        int di = 0;
        while (di < st.colWidths.Count) {
            if (st.colHidden[di]) { st.dispW.Add(0); }
            else { st.dispW.Add(st.colWidths[di]); }
            di = di + 1;
        }
        int firstDataX = x + numW + selW;
        int dataViewW = clipRight - firstDataX;

        // Column display order, sliced into three bands: [frozen-left |
        // scrolling | frozen-right]. Computed once and shared by every layout
        // pass so header / filter row / cells / hit-test / summary stay aligned
        // by construction.
        List<int> vorder = DataTable.VisibleOrder(st, cols);
        int nLeft = DataTable.LeftFrozenCount(st, vorder);
        int nRight = DataTable.RightFrozenCount(st, vorder);
        int pinnedW = DataTable.PinnedWidth(st);
        int pinnedRW = DataTable.PinnedRightWidth(st);
        // The frozen bands may not eat the whole table: past that point there
        // would be nothing left to scroll and the middle would be unreachable,
        // so the right band yields first (it is the one the user just added).
        int minBand = app.Scale(80);
        while (nRight > 0 && dataViewW - pinnedW - pinnedRW < minBand) {
            pinnedRW = pinnedRW - st.dispW[vorder[vorder.Count - nRight]];
            nRight = nRight - 1;
        }
        while (nLeft > 1 && dataViewW - pinnedW - pinnedRW < minBand) {
            nLeft = nLeft - 1;
            pinnedW = pinnedW - st.dispW[vorder[nLeft]];
        }
        // Only the middle band scrolls, so only its overflow sets the range.
        int bandX = firstDataX + pinnedW;                  // left edge of the middle
        int bandW = dataViewW - pinnedW - pinnedRW;        // its width
        if (bandW < 1) { bandW = 1; }
        int bandNatW = 0;
        int bi = nLeft;
        while (bi < vorder.Count - nRight) { bandNatW = bandNatW + st.dispW[vorder[bi]]; bi = bi + 1; }
        int maxScrollX = bandNatW - bandW;
        if (maxScrollX < 0) { maxScrollX = 0; }
        if (st.scrollX > maxScrollX) { st.scrollX = maxScrollX; }
        if (st.scrollX < 0) { st.scrollX = 0; }
        int rightX = firstDataX + dataViewW - pinnedRW;    // left edge of the right band

        // Header height is known only now: a banded table grows one row per
        // nesting level above the titles. The column titles keep their own row
        // at the bottom, so `y + headerH` still means "below the whole header".
        bandLevels = DataTable.BandLevels(cols, vorder);
        headerH = titleRowH + bandLevels * bandRowH;
        int titleTop = y + bandLevels * bandRowH;

        // Screen x and owning band for every entry of `vorder`, computed once.
        // Each band is clipped to its own strip, so a scrolled middle column can
        // never paint (or register a hit region) over a frozen one — which makes
        // the drawing order between the bands irrelevant, and keeps all four
        // passes below to a single loop each.
        List<int> colX = new List<int>();
        List<int> colBand = new List<int>();
        int cxAcc = firstDataX;
        int bpos = 0;
        while (bpos < vorder.Count) {
            if (bpos == nLeft) { cxAcc = bandX - st.scrollX; }
            if (bpos == vorder.Count - nRight) { cxAcc = rightX; }
            colX.Add(cxAcc);
            if (bpos < nLeft) { colBand.Add(0); }
            else if (bpos >= vorder.Count - nRight) { colBand.Add(2); }
            else { colBand.Add(1); }
            cxAcc = cxAcc + st.dispW[vorder[bpos]];
            bpos = bpos + 1;
        }

        // outer border
        c.FillRoundRect(x, y, viewW, viewH, t.borderRadiusMedium, t.bgPrimary);
        c.DrawRect(x, y, viewW, viewH, t.borderPrimary, 1);

        // ---------------- header ----------------
        c.FillRect(x, y, viewW, headerH, t.bgSecondary);
        int hx = x;

        if (st.showRowNum) {
            c.DrawTextCentered(hx, y, numW, headerH, "#", t.textTertiary, t.fontSizeSmall);
            hx = hx + numW;
            c.FillRect(hx, y, 1, headerH, gridColor);
        }
        if (st.showSelect) {
            // select-all checkbox
            int allId = app.focus.AllocId();
            bool allChecked = st.order.Count > 0;
            int oi = 0;
            while (oi < st.order.Count) {
                if (!st.selected[st.order[oi]]) { allChecked = false; oi = st.order.Count; } else { oi = oi + 1; }
            }
            int box = app.Scale(16);
            int bx = hx + (selW - box) / 2;
            int by = y + (headerH - box) / 2;
            if (allChecked) {
                c.FillRoundRect(bx, by, box, box, t.borderRadiusSmall, t.primary);
                int ins = app.Scale(3);
                Icon.Draw(c, "check", bx + ins, by + ins, box - ins * 2, t.textInverse);
            } else {
                c.FillRoundRect(bx, by, box, box, t.borderRadiusSmall, t.bgPrimary);
                c.DrawRect(bx, by, box, box, t.borderPrimary, 1);
            }
            app.hitTester.Register(HitRegion.Create(allId, hx, y, selW, headerH, 0));
            if (app.window.EventKind() == 3 && app.window.EventButton() == 0 && app.hitTester.HitTest(app.mouseX, app.mouseY) == allId) {
                bool target = !allChecked;
                int k = 0;
                while (k < st.order.Count) { st.selected[st.order[k]] = target; k = k + 1; }
                st.SelectionChanged.Raise();
                app.RequestRedraw();
            }
            hx = hx + selW;
            c.FillRect(hx, y, 1, headerH, gridColor);
        }

        // ---------------- band rows (multi-level header) ----------------
        // One row per nesting level above the titles. A span covers a run of
        // adjacent slots in the visible order, so it is clipped to its own
        // frozen strip exactly like the columns underneath it — a group split
        // by a freeze boundary simply draws as two spans, one per band, which
        // is also what it means: those columns are no longer adjacent.
        int blv = 0;
        while (blv < bandLevels) {
            int by0 = y + blv * bandRowH;
            List<BandSpan> spans = DataTable.BandRow(st, cols, vorder, blv);
            int si = 0;
            while (si < spans.Count) {
                BandSpan sp = spans[si];
                // A span is only ever drawn inside one strip; a run crossing a
                // band boundary is emitted once per strip it touches.
                int seg = sp.from;
                while (seg < sp.to) {
                    int segBand = colBand[seg];
                    int segEnd = seg;
                    while (segEnd < sp.to && colBand[segEnd] == segBand) { segEnd = segEnd + 1; }
                    int sx0 = colX[seg];
                    int sx1 = colX[segEnd - 1] + st.dispW[vorder[segEnd - 1]];
                    int sbL = DataTable.BandLeft(segBand, firstDataX, bandX, rightX);
                    int sbR = DataTable.BandRight(segBand, firstDataX, bandX, bandW,
                                                  rightX, pinnedW, pinnedRW, clipRight);
                    if (sx1 > sbL && sx0 < sbR) {
                        DataTable.PushBandClip(c, segBand, firstDataX, bandX, bandW, rightX,
                                               pinnedW, pinnedRW, by0, bandRowH, clipRight);
                        int vx0 = sx0;
                        if (vx0 < sbL) { vx0 = sbL; }
                        int vx1 = sx1;
                        if (vx1 > sbR) { vx1 = sbR; }
                        c.FillRect(sx0, by0, sx1 - sx0, bandRowH - 1, t.bgTertiary);
                        c.FillRect(sx1 - 1, by0, 1, bandRowH, gridColor);

                        // The chevron reads as "there is more here", so it is
                        // only offered on the segment that owns the band's first
                        // column — collapsing from a fragment on the far side of
                        // a freeze would fold columns the user isn't looking at.
                        int capX = sx0;
                        int capW = sx1 - sx0;
                        bool owner = seg == sp.from;
                        if (owner) {
                            int chev = app.Scale(14);
                            int chId = app.focus.AllocId();
                            string chIcon = "chevron-down";
                            if (DataTable.BandIsCollapsed(st, sp.path)) { chIcon = "chevron-right"; }
                            int chX = sx0 + app.Scale(4);
                            Icon.DrawCenteredIn(c, chIcon, chX, by0, chev, bandRowH,
                                                app.Scale(11), t.textTertiary);
                            app.hitTester.Register(HitRegion.Create(chId, chX, by0, chev, bandRowH, 0));
                            if (app.window.EventKind() == 3 && app.window.EventButton() == 0
                                && app.hitTester.HitTest(app.mouseX, app.mouseY) == chId) {
                                DataTable.ToggleBand(st, cols, sp.path);
                                st.BandToggled.Raise();
                                app.RequestRedraw();
                            }
                            capX = chX + chev;
                            capW = sx1 - capX;
                        }
                        int capPad = app.Scale(4);
                        capW = capW - capPad * 2;
                        if (capW < 0) { capW = 0; }
                        string capT = DataTable.Truncate(sp.label, t.fontSizeSmall, capW);
                        c.DrawTextCentered(capX + capPad, by0, capW, bandRowH, capT,
                                           t.textSecondary, t.fontSizeSmall);
                        c.PopClip();
                    }
                    seg = segEnd;
                }
                si = si + 1;
            }
            c.FillRect(x, by0 + bandRowH - 1, viewW, 1, gridColor);
            blv = blv + 1;
        }

        // Column drag-reorder in progress this frame (a header title is held and
        // the pointer has moved past the start threshold). dropVisLocal is the
        // visual slot the dragged column would land before; dropX is its screen x.
        bool colDragging = st.dragCol >= 0 && st.dragColMoved;
        int dropVisLocal = -1;
        int dropX = -1;

        int hoi = 0;
        int hcl = firstDataX;
        int hBand = -1;
        while (hoi < vorder.Count) {
            int i = vorder[hoi];
            DataColumn col = cols[i];
            int cw = st.dispW[i];
            // Each band gets its own clip strip, entered when the band changes.
            // The middle is clipped between the two frozen bands, so a panned
            // column is cut off at their edges instead of drawing over them.
            if (colBand[hoi] != hBand) {
                if (hBand >= 0) { c.PopClip(); }
                hBand = colBand[hoi];
                DataTable.PushBandClip(c, hBand, firstDataX, bandX, bandW, rightX,
                                       pinnedW, pinnedRW, titleTop, titleRowH, clipRight);
            }
            hcl = colX[hoi];
            // Ids are allocated for every column — visible or not — so the id
            // sequence stays identical across frames while panning; otherwise
            // widgets registered after the header (scrollbars) would change id
            // mid-drag whenever a column entered/left the viewport.
            int titleId = app.focus.AllocId();
            int menuId = -1;
            if (col.filterable || col.sortable) { menuId = app.focus.AllocId(); }
            int rzId = app.focus.AllocId();
            // Clip the hit region to the band as well as the viewport: a middle
            // column scrolled under the frozen band must not stay clickable
            // there, or the user would hit a column they cannot see.
            int bandL = DataTable.BandLeft(colBand[hoi], firstDataX, bandX, rightX);
            int bandR = DataTable.BandRight(colBand[hoi], firstDataX, bandX, bandW,
                                            rightX, pinnedW, pinnedRW, clipRight);
            if (hcl + cw <= bandL || hcl >= bandR) {
                hoi = hoi + 1;
            } else {
            hx = hcl;
            // visible slice of this column (for hit regions / hover fill)
            int visX = hx;
            if (visX < bandL) { visX = bandL; }
            int visR = hx + cw;
            if (visR > bandR) { visR = bandR; }
            int visW = visR - visX;
            // drag-reorder drop slot: first column whose left half contains the
            // pointer becomes the insertion target.
            if (colDragging && dropVisLocal < 0 && app.mouseX < hx + cw / 2) {
                dropVisLocal = hoi;
                dropX = visX;
            }
            bool hHover = app.focus.IsHovered(titleId);
            if (hHover) { c.FillRect(visX, titleTop, visW, titleRowH, t.bgHover); }

            int pad = t.paddingSmall;
            int availTitle = cw - pad * 2 - menuIconW;
            string ht = DataTable.Truncate(col.title, fs, availTitle);
            int ty = titleTop + (titleRowH - Canvas.FontHeight(fs)) / 2;
            c.DrawText(hx + pad, ty, ht, t.textSecondary, fs);

            // sort indicator — arrow per key, plus a 1-based priority badge when
            // more than one column feeds a multi-column sort.
            int spos = DataTable.SortIndexOf(st, i);
            if (spos >= 0) {
                string arrow = "arrow-up";
                if (st.sortKeys[spos].dir == 2) { arrow = "arrow-down"; }
                int aw = app.Scale(12);
                int ax = hx + pad + Canvas.MeasureText(ht, fs) + app.Scale(4);
                Icon.Draw(c, arrow, ax, titleTop + (titleRowH - aw) / 2, aw, t.primary);
                if (st.sortKeys.Count > 1) {
                    c.DrawText(ax + aw + app.Scale(1), ty,
                               Convert.ToString(spos + 1), t.primary, t.fontSizeSmall);
                }
            }

            // header menu icon — DevExpress-style: only revealed when the mouse
            // is over the header cell, when this column has an active filter, or
            // while its menu is open. `menuId` is always allocated so widget ids
            // stay stable across frames regardless of the icon's visibility.
            if (menuId >= 0) {
                int mIx = hx + cw - menuIconW - app.Scale(2);
                bool active = st.filters[i].Active();
                bool cellHover = app.mouseX >= visX && app.mouseX < visR
                                 && app.mouseY >= titleTop && app.mouseY < titleTop + titleRowH;
                bool showIcon = active || cellHover || st.openMenu == i;
                if (showIcon) {
                    int mColor = t.textTertiary;
                    if (active) { mColor = t.primary; }
                    if (app.focus.IsHovered(menuId)) { mColor = t.textPrimary; }
                    Icon.DrawCenteredIn(c, "filter", mIx, titleTop, menuIconW, titleRowH, app.Scale(13), mColor);
                    app.hitTester.Register(HitRegion.Create(menuId, mIx, titleTop, menuIconW, titleRowH, 0));
                    if (!st.dragColMoved && app.window.EventKind() == 3 && app.window.EventButton() == 0 && app.hitTester.HitTest(app.mouseX, app.mouseY) == menuId) {
                        if (st.openMenu == i) { st.openMenu = -1; } else {
                            st.openMenu = i;
                            st.filterTab = 0;
                            st.searchText = "";
                            st.valScroll = 0;
                            st.editFocus = 0;
                            st.batchLines = new List<string>();
                            st.batchLines.Add("");
                            st.batchExactFlag = 0;
                            st.menuVals = DataTable.DistinctFiltered(st, src, i);
                            st.menuMatched = st.menuVals;
                            st.menuSearchCache = "";
                        }
                        app.RequestRedraw();
                    }
                }
            }

            // header title: press starts a potential drag-reorder; a click (no
            // drag) cycles the sort. The dragged column is dimmed while moving.
            int titleW = visW - menuIconW;
            if (titleW < 0) { titleW = 0; }
            app.hitTester.Register(HitRegion.Create(titleId, visX, titleTop, titleW, titleRowH, 0));
            if (app.window.EventKind() == 2 && app.window.EventButton() == 0 && app.hitTester.HitTest(app.mouseX, app.mouseY) == titleId) {
                st.dragCol = i;
                st.dragColStartX = app.mouseX;
                st.dragColMoved = false;
            }
            if (st.dragCol == i && app.focus.pressedId == titleId) {
                int dd = app.mouseX - st.dragColStartX;
                if (dd < 0) { dd = 0 - dd; }
                if (!st.dragColMoved && dd > app.Scale(5)) {
                    st.dragColMoved = true;
                }
                if (st.dragColMoved) { app.RequestRedraw(); }
            }
            if (colDragging && st.dragCol == i) {
                c.FillRect(visX, titleTop, visW, titleRowH, t.bgHover);
            }
            if (col.sortable && !st.dragColMoved && app.window.EventKind() == 3 && app.window.EventButton() == 0 && app.ClickTarget() == titleId) {
                st.hitCol = i;
                st.HeaderClick.Raise();
                bool addSort = Modifiers.HasShift(app.window.EventMods());
                DataTable.CycleSort(st, i, addSort);
                st.dirty = true;
                st.Sort.Raise();
                app.RequestRedraw();
            }

            // right-click a header cell => column context menu (sort / auto-fit /
            // hide). Geometry-based so it wins regardless of the overlapping
            // title / menu-icon / resize ids registered for this cell.
            if (app.window.EventKind() == 2 && app.window.EventButton() == 1
                && st.openMenu < 0
                && app.mouseX >= hx && app.mouseX < hx + cw
                && app.mouseY >= titleTop && app.mouseY < titleTop + titleRowH) {
                st.hdrCtxOpen = true;
                st.hdrCtxCol = i;
                st.hdrCtxX = app.mouseX;
                st.hdrCtxY = app.mouseY;
                st.hitCol = i;
                app.RequestRedraw();
            }

            // resize handle (right border). Draggable columns get a horizontal
            // resize cursor (widget type 4); fixed columns show the not-allowed
            // cursor (widget type 6) so the grip clearly reads as disabled.
            int rzW = app.Scale(6);
            int rzX = hx + cw - rzW / 2;
            int rzCursor = 4;
            if (!col.resizable) { rzCursor = 6; }
            app.hitTester.Register(HitRegion.Create(rzId, rzX, titleTop, rzW, titleRowH, rzCursor));
            if (col.resizable && app.window.EventKind() == 2 && app.window.EventButton() == 0 && app.PressTarget() == rzId) {
                st.resizeCol = i;
                st.resizeStartX = app.mouseX;
                st.resizeStartW = st.colWidths[i];
            }
            if (col.resizable && st.resizeCol == i && app.focus.pressedId == rzId) {
                int nw = st.resizeStartW + (app.mouseX - st.resizeStartX);
                if (nw < app.Scale(48)) { nw = app.Scale(48); }
                if (nw != st.colWidths[i]) {
                    st.colWidths[i] = nw;
                    st.hitCol = i;
                    st.ColumnResize.Raise();
                    app.RequestRedraw();
                }
            }

            if (st.resizeCol == i && app.window.EventKind() == 3 && app.window.EventButton() == 0) {
                st.hitCol = i;
                st.resizeCol = -1;
                st.ColumnResizeEnd.Raise();
            }

            c.FillRect(hx + cw, titleTop, 1, titleRowH, gridColor);
            hoi = hoi + 1;
            }
        }
        if (hBand >= 0) { c.PopClip(); }
        c.FillRect(x, y + headerH - 1, viewW, 1, gridColor);

        // Column drag feedback + drop: a 2px accent line marks the insertion
        // boundary and a floating chip follows the pointer. On release the
        // column is moved before the target slot (or to the end).
        if (colDragging) {
            if (dropVisLocal < 0) { dropX = hx; }
            // The insertion line spans the whole header — including the band
            // rows, since dropping between two columns can also move one out of
            // a group — but the chip rides the title row it came from.
            c.FillRect(dropX - 1, y, app.Scale(2), headerH, t.primary);
            string dl = cols[st.dragCol].title;
            int chW = Canvas.MeasureText(dl, fs) + app.Scale(16);
            int chX = app.mouseX - chW / 2;
            if (chX < x) { chX = x; }
            if (chX + chW > x + viewW) { chX = x + viewW - chW; }
            c.FillRoundRect(chX, titleTop + app.Scale(3), chW, titleRowH - app.Scale(6),
                            t.borderRadiusSmall, t.primary);
            c.DrawText(chX + app.Scale(8),
                       titleTop + (titleRowH - Canvas.FontHeight(fs)) / 2, dl, t.textInverse, fs);
        }
        // Remember the drop slot while the button is held, so the finalize below
        // uses the last live drag position rather than wherever the pointer sits
        // on the frame that happens to flush the release.
        if (colDragging && app.focus.pressedId >= 0) { st.dropVis = dropVisLocal; }
        // Finalize when the button is no longer held. The App clears the press on
        // mouse-up before this render runs, so `pressedId < 0` reliably marks the
        // release frame even when the synthetic event's kind is coalesced away.
        if (st.dragCol >= 0 && app.focus.pressedId < 0) {
            // Released over the group strip: that is a "group by this column"
            // gesture at the slot the pointer addresses, not a reorder.
            bool toPanel = st.showGroupPanel && st.dragColMoved
                && app.mouseX >= x && app.mouseX < x + viewW
                && app.mouseY >= panelY && app.mouseY < panelY + groupPanelH;
            if (toPanel) {
                List<int> gcx = new List<int>();
                List<int> gcw = new List<int>();
                DataTable.GroupChipLayout(app, cols, st, x, gcx, gcw);
                DataTable.GroupByAt(st, st.dragCol,
                                    DataTable.GroupDropSlot(app, gcx, gcw));
                st.GroupChanged.Raise();
            } else if (st.dragColMoved) {
                int beforeCol = -1;
                if (st.dropVis >= 0 && st.dropVis < vorder.Count) {
                    beforeCol = vorder[st.dropVis];
                }
                if (beforeCol != st.dragCol) {
                    DataTable.MoveColumn(st, st.dragCol, beforeCol);
                    st.hitCol = st.dragCol;
                    st.ColumnReorder.Raise();
                }
            }
            st.dragCol = -1;
            st.dragColMoved = false;
            st.dropVis = -1;
            app.RequestRedraw();
        }

        // ---------------- body (virtualised) ----------------
        int total = st.dispRows.Count;
        int summaryH = 0;
        if (st.showSummary) { summaryH = rowH; }
        int pagerH = 0;
        if (st.paged) { pagerH = app.Scale(38); }

        int filterRowH = 0;
        if (st.showFilterRow) { filterRowH = t.heightMedium; }
        int statusBarH = 0;
        if (st.showStatusBar) { statusBarH = app.Scale(28); }
        int bodyTop = y + headerH + filterRowH;
        int bodyH = viewH - headerH - filterRowH - summaryH - pagerH - statusBarH;
        if (bodyH < rowH) { bodyH = rowH; }
        int visRows = bodyH / rowH;
        if (visRows < 1) { visRows = 1; }

        // In paged mode the visible window is a whole page; otherwise it is the
        // virtual-scroll offset.
        int start = 0;
        if (st.paged) {
            st.pageRows = visRows;
            int totalPages = 1;
            if (total > 0) { totalPages = (total + visRows - 1) / visRows; }
            int cur = st.pageModel.Get();
            if (cur > totalPages) { cur = totalPages; st.pageModel.Set(cur); }
            if (cur < 1) { cur = 1; st.pageModel.Set(cur); }
            start = (cur - 1) * visRows;
        } else {
            start = st.scrollRow;
            if (start > total - visRows) { start = total - visRows; }
            if (start < 0) { start = 0; }
            st.scrollRow = start;
        }

        // ---------------- filter row (DevExpress inline quick-filter) ----------------
        // A row of per-column text inputs just below the header. Clicking any
        // cell focuses it; typing applies a real-time Contains filter on that
        // column orthogonally to the popup filter. Only drawn when showFilterRow.
        if (st.showFilterRow && filterRowH > 0) {
            int fry = y + headerH;
            c.FillRect(x + 1, fry, viewW - 2, filterRowH, t.bgSecondary);
            c.FillRect(x + 1, fry, numW + selW - 2, filterRowH, t.bgTertiary);

            // small funnel icon in the gutter to signal the row's purpose
            if (st.showRowNum && numW > 0) {
                Icon.DrawCenteredIn(c, "filter", x, fry, numW, filterRowH, app.Scale(12), t.textTertiary);
            }

            int froi = 0;
            int frBand = -1;
            while (froi < vorder.Count) {
                int fri = vorder[froi];
                int fcw = st.dispW[fri];
                if (colBand[froi] != frBand) {
                    if (frBand >= 0) { c.PopClip(); }
                    frBand = colBand[froi];
                    DataTable.PushBandClip(c, frBand, firstDataX, bandX, bandW, rightX,
                                           pinnedW, pinnedRW, fry, filterRowH, clipRight);
                }
                int frcl = colX[froi];
                int frBandL = DataTable.BandLeft(colBand[froi], firstDataX, bandX, rightX);
                int frBandR = DataTable.BandRight(colBand[froi], firstDataX, bandX, bandW,
                                                  rightX, pinnedW, pinnedRW, clipRight);
                if (frcl + fcw > frBandL && frcl < frBandR) {
                    int pad2 = t.paddingSmall;
                    bool frFoc = st.filterRowFocusCol == fri;
                    string frTxt = st.filterRowText[fri];
                    if (frFoc) { frTxt = st.filterRowBuf; }
                    int frid2 = app.focus.AllocId();
                    int frX = frcl;
                    int frW = fcw;
                    if (frX < frBandL) { frW = frW - (frBandL - frX); frX = frBandL; }
                    if (frX + frW > frBandR) { frW = frBandR - frX; }
                    bool frAct = frTxt.Length > 0 || frFoc;
                    int frBg = t.bgPrimary;
                    if (frAct) { frBg = t.bgSecondary; }
                    if (frFoc) { frBg = t.bgPrimary; }
                    c.FillRect(frX + 2, fry + 3, frW - 4, filterRowH - 6, frBg);
                    int frBorder = t.borderPrimary;
                    if (frFoc) { frBorder = t.borderFocus; }
                    c.DrawRoundRect(frX + 2, fry + 3, frW - 4, filterRowH - 6, t.borderRadiusSmall, frBorder, 1);
                    int frInner = frW - 4 - pad2 * 2;
                    if (frInner < 0) { frInner = 0; }
                    int frfs = t.fontSizeSmall;
                    int frtY = fry + (filterRowH - Canvas.FontHeight(frfs)) / 2;
                    c.PushClip(frX + 2 + pad2, fry, frInner, filterRowH);
                    if (frTxt.Length == 0 && !frFoc) {
                        c.DrawText(frX + 2 + pad2, frtY, "搜索...", t.textTertiary, frfs);
                    } else {
                        c.DrawText(frX + 2 + pad2, frtY, frTxt, t.textPrimary, frfs);
                        if (frFoc) {
                            int fcaretW = Canvas.MeasureText(Text.Left(frTxt, st.filterRowCur), frfs);
                            c.FillRect(frX + 2 + pad2 + fcaretW, frtY, 1, Canvas.FontHeight(frfs), t.primary);
                        }
                    }
                    c.PopClip();
                    app.hitTester.Register(HitRegion.Create(frid2, frX, fry, frW, filterRowH, 1));
                    if (app.window.EventKind() == 3 && app.window.EventButton() == 0
                        && app.hitTester.HitTest(app.mouseX, app.mouseY) == frid2) {
                        if (st.filterRowFocusCol != fri) {
                            st.filterRowFocusCol = fri;
                            st.filterRowBuf = st.filterRowText[fri];
                            st.filterRowCur = st.filterRowBuf.Length;
                        }
                        app.RequestRedraw();
                    }
                }
                froi = froi + 1;
            }
            if (frBand >= 0) { c.PopClip(); }
            c.FillRect(x + 1, fry + filterRowH - 1, viewW - 2, 1, gridColor);
        }

        // Normalised cell-range bounds (order-index rows + column indices) for
        // highlighting the drag-selected rectangle behind the cells.
        bool hasRange = DataTable.HasRange(st);
        int rgR0 = 0;
        int rgR1 = -1;
        int rgC0 = 0;
        int rgC1 = -1;
        if (hasRange) {
            rgR0 = DataTable.MinI(st.rangeR0, st.rangeR1);
            rgR1 = DataTable.MaxI(st.rangeR0, st.rangeR1);
            rgC0 = DataTable.MinI(st.rangeC0, st.rangeC1);
            rgC1 = DataTable.MaxI(st.rangeC0, st.rangeC1);
        }

        // screen rect of the cell currently being edited (captured in the loop
        // so the inline editor can be drawn over it after the rows are painted)
        int edX = 0;
        int edY = 0;
        int edW = 0;
        int edH = 0;
        bool edVis = false;

        int r = 0;
        while (r < visRows && (start + r) < total) {
            int oiRow = start + r;
            int ry = bodyTop + r * rowH;

            // Group header row: indented chevron + caption + row count. It
            // occupies a display slot but carries no data-row payload.
            if (st.dispRows[oiRow].kind == 1) {
                int gi = st.dispRows[oiRow].row;
                GroupRow grp = st.groups[gi];
                int lvl = grp.level;
                c.FillRect(x + 1, ry, viewW - 2, rowH, t.bgTertiary);
                int gcx = x + numW + selW + lvl * app.Scale(16) + app.Scale(6);
                bool gcoll = grp.collapsed;
                string chev = "chevron-down";
                if (gcoll) { chev = "chevron-right"; }
                int chSz = app.Scale(14);
                Icon.Draw(c, chev, gcx, ry + (rowH - chSz) / 2, chSz, t.textSecondary);
                string glbl = grp.label + "  (" + Convert.ToString(grp.count) + ")";
                // Append group-level aggregate summaries for columns that have
                // an aggMode set (DevExpress-style group subtotals).
                // Format: "  |  Revenue: ¥1,234,567  |  Avg CTR: 3.2%"
                int gagg = 0;
                while (gagg < grp.aggTexts.Count && gagg < cols.Count) {
                    string gat = grp.aggTexts[gagg];
                    if (gat.Length > 0) {
                        glbl = glbl + "    " + cols[gagg].title + ": " + gat;
                    }
                    gagg = gagg + 1;
                }
                c.DrawText(gcx + chSz + app.Scale(4),
                    ry + (rowH - t.fontSizeMedium) / 2, glbl, t.textPrimary, t.fontSizeMedium);
                c.FillRect(x + 1, ry + rowH - 1, viewW - 2, 1, gridColor);
                r = r + 1;
                continue;
            }

            // Detail band: a master-detail panel under an expanded row. The band
            // spans DetailSlots consecutive slots; it is drawn once, on its first
            // slot, over the full height so the panel sees one rectangle rather
            // than a series of row-high strips. Later parts of the same band draw
            // nothing — the first part already covered their pixels.
            if (st.dispRows[oiRow].kind == 2) {
                if (st.dispRows[oiRow].part != 0) { r = r + 1; continue; }
                int dRow = st.dispRows[oiRow].row;
                // Count this band's remaining slots so the panel gets its whole
                // height even when the band starts on-screen and runs past the
                // bottom edge (the clip keeps the overspill invisible).
                int span = 1;
                int ns = oiRow + 1;
                while (ns < total && st.dispRows[ns].kind == 2
                       && st.dispRows[ns].part != 0 && st.dispRows[ns].row == dRow) {
                    span = span + 1;
                    ns = ns + 1;
                }
                int dh = span * rowH;
                c.FillRect(x + 1, ry, viewW - 2, dh, t.bgSecondary);
                // A left accent ties the panel to the master row above it.
                c.FillRect(x + 1, ry, app.Scale(3), dh, t.primary);
                if (st.detail != null) {
                    int dx = x + app.Scale(4);
                    int dw = viewW - app.Scale(6);
                    c.PushClip(dx, ry, dw, dh);
                    st.detail.Paint(app, src, dRow, dx, ry, dw, dh);
                    c.PopClip();
                }
                c.FillRect(x + 1, ry + dh - 1, viewW - 2, 1, gridColor);
                r = r + 1;
                continue;
            }

            int rowIdx = st.dispRows[oiRow].row;
            bool rowInRange = hasRange && oiRow >= rgR0 && oiRow <= rgR1;

            int rowId = app.focus.AllocId();
            app.hitTester.Register(HitRegion.Create(rowId, x, ry, viewW, rowH, 0));
            bool rHover = app.focus.IsHovered(rowId);
            bool rSel = st.selected[rowIdx];

            int stripeBg = t.bgPrimary;
            if (st.striped && (st.dispRows[oiRow].no % 2 == 0)) { stripeBg = t.bgSecondary; }
            int rowBg = DataTable.RowBackground(st, src, rowIdx, stripeBg,
                                                t.bgActive, t.bgHover, rSel, rHover);
            c.FillRect(x + 1, ry, viewW - 2, rowH, rowBg);

            int cx2 = x;
            if (st.showRowNum) {
                // Sequential display position (1,2,3…) in the current sorted/
                // filtered view — NOT the original data index, so the row-number
                // column stays ordered instead of jumping around when the user
                // sorts or filters.
                c.DrawTextCentered(cx2, ry, numW, rowH, Convert.ToString(st.dispRows[oiRow].no), t.textTertiary, t.fontSizeSmall);
                // Master-detail expander, tucked into the left of the gutter so
                // the row number stays legible beside it. Only rows the provider
                // accepts get one, so a childless row shows a blank margin
                // instead of a chevron that does nothing.
                if (DataTable.CanExpand(st, src, rowIdx)) {
                    int exSz = app.Scale(12);
                    int exX = cx2 + app.Scale(2);
                    int exY = ry + (rowH - exSz) / 2;
                    bool isExp = DataTable.IsExpanded(st, rowIdx);
                    string exCh = "chevron-right";
                    if (isExp) { exCh = "chevron-down"; }
                    int exId = app.focus.AllocId();
                    app.hitTester.Register(HitRegion.Create(exId, cx2, ry, app.Scale(16), rowH, 0));
                    int exCol = t.textTertiary;
                    if (app.focus.IsHovered(exId)) { exCol = t.primary; }
                    Icon.Draw(c, exCh, exX, exY, exSz, exCol);
                    if (app.window.EventKind() == 3 && app.window.EventButton() == 0
                        && app.hitTester.HitTest(app.mouseX, app.mouseY) == exId) {
                        DataTable.ToggleDetail(st, src, rowIdx);
                        app.RequestRedraw();
                    }
                }
                cx2 = cx2 + numW;
            }
            if (st.showSelect) {
                int box = app.Scale(16);
                int bx = cx2 + (selW - box) / 2;
                int by = ry + (rowH - box) / 2;
                if (rSel) {
                    c.FillRoundRect(bx, by, box, box, t.borderRadiusSmall, t.primary);
                    int ins = app.Scale(3);
                    Icon.Draw(c, "check", bx + ins, by + ins, box - ins * 2, t.textInverse);
                } else {
                    c.FillRoundRect(bx, by, box, box, t.borderRadiusSmall, t.bgPrimary);
                    c.DrawRect(bx, by, box, box, t.borderPrimary, 1);
                }
                int selId = app.focus.AllocId();
                app.hitTester.Register(HitRegion.Create(selId, cx2, ry, selW, rowH, 0));
                if (app.window.EventKind() == 3 && app.window.EventButton() == 0 && app.hitTester.HitTest(app.mouseX, app.mouseY) == selId) {
                    st.selected[rowIdx] = !rSel;
                    st.hitRow = rowIdx;
                    st.SelectionChanged.Raise();
                    app.RequestRedraw();
                }
                cx2 = cx2 + selW;
            }

            int coi = 0;
            int cBand = -1;
            while (coi < vorder.Count) {
                int cc = vorder[coi];
                int cw = st.dispW[cc];
                if (colBand[coi] != cBand) {
                    if (cBand >= 0) { c.PopClip(); }
                    cBand = colBand[coi];
                    DataTable.PushBandClip(c, cBand, firstDataX, bandX, bandW, rightX,
                                           pinnedW, pinnedRW, ry, rowH, clipRight);
                }
                int ccl = colX[coi];
                int cBandL = DataTable.BandLeft(colBand[coi], firstDataX, bandX, rightX);
                int cBandR = DataTable.BandRight(colBand[coi], firstDataX, bandX, bandW,
                                                 rightX, pinnedW, pinnedRW, clipRight);
                if (ccl + cw > cBandL && ccl < cBandR) {
                    // A per-cell style background paints under the range
                    // highlight, so a selected cell still reads as selected.
                    int cellBg = DataTable.CellBackground(st, src, rowIdx, cc);
                    if (cellBg != 0) { c.FillRect(ccl, ry, cw, rowH, cellBg); }
                    if (rowInRange && cc >= rgC0 && cc <= rgC1) {
                        c.FillRect(ccl, ry, cw, rowH, t.bgActive);
                    }
                    if (st.editing && rowIdx == st.editRow && cc == st.editCol) {
                        edX = ccl; edY = ry; edW = cw; edH = rowH; edVis = true;
                    }
                    // A custom painter owns the cell outright. Clipping it to
                    // its own rect means a misbehaving one can't bleed over its
                    // neighbours or escape the table.
                    bool painted = false;
                    if (st.styler != null) {
                        c.PushClip(ccl, ry, cw, rowH);
                        painted = st.styler.PaintCell(app, src, rowIdx, cc, ccl, ry, cw, rowH);
                        c.PopClip();
                    }
                    if (!painted) {
                        double cfLo = 0.0;
                        double cfHi = 0.0;
                        if (cc < st.cfMinR.Count) { cfLo = st.cfMinR[cc]; cfHi = st.cfMaxR[cc]; }
                        DataTable.DrawCell(app, cols[cc], src.CellText(rowIdx, cc), ccl, ry, cw, rowH,
                                           cfLo, cfHi, DataTable.CellForeground(st, src, rowIdx, cc));
                    }
                    // An editable bool cell toggles on a single click, rather
                    // than opening the text editor an inline edit would use.
                    if (cols[cc].isBool && cols[cc].editable) {
                        int tgId = app.focus.AllocId();
                        app.hitTester.Register(HitRegion.Create(tgId, ccl, ry, cw, rowH, 0));
                        if (app.window.EventKind() == 3 && app.window.EventButton() == 0
                            && app.hitTester.HitTest(app.mouseX, app.mouseY) == tgId) {
                            DataTable.ToggleBoolCell(st, cols, src, rowIdx, cc);
                            app.RequestRedraw();
                        }
                    }
                }
                coi = coi + 1;
            }
            if (cBand >= 0) { c.PopClip(); }

            c.FillRect(x + 1, ry + rowH - 1, viewW - 2, 1, gridColor);
            r = r + 1;
        }

        // ---------------- new-row placeholder ----------------
        // The empty row under the last one, DevExpress's "click here to add".
        // It is drawn only when the view is scrolled to the bottom (`r` stops
        // short of visRows exactly then), so it always sits after the final
        // row rather than floating in the middle of a scrolled page. It is not
        // a display slot: it carries no data, so nothing selects or sorts it.
        if (st.allowAddRow && src.CanInsert() && r < visRows) {
            int ay = bodyTop + r * rowH;
            int addId = app.focus.AllocId();
            app.hitTester.Register(HitRegion.Create(addId, x, ay, viewW, rowH, 0));
            bool aHover = app.focus.IsHovered(addId);
            int aBg = t.bgPrimary;
            if (aHover) { aBg = t.bgHover; }
            c.FillRect(x + 1, ay, viewW - 2, rowH, aBg);
            int aIco = app.Scale(12);
            int aIx = x + app.Scale(8);
            int aFg = t.textTertiary;
            if (aHover) { aFg = t.primary; }
            Icon.Draw(c, "plus", aIx, ay + (rowH - aIco) / 2, aIco, aFg);
            c.DrawText(aIx + aIco + app.Scale(6),
                       ay + (rowH - t.fontSizeSmall) / 2,
                       "点击添加新行  Click to add row", aFg, t.fontSizeSmall);
            c.FillRect(x + 1, ay + rowH - 1, viewW - 2, 1, gridColor);
            if (app.window.EventKind() == 3 && app.window.EventButton() == 0
                && app.hitTester.HitTest(app.mouseX, app.mouseY) == addId) {
                int newRow = DataTable.AppendRow(st, cols, src);
                if (newRow >= 0) {
                    // Recompute first: the row has to exist in the display order
                    // before the cursor can be parked on it, or BeginEdit would
                    // open on a slot that isn't there yet.
                    DataTable.Recompute(st, cols, src);
                    DataTable.FocusRow(st, cols, src, newRow);
                }
                app.RequestRedraw();
            }
        }

        // ---------------- freeze boundaries ----------------
        // A divider on the inner edge of each frozen band marks where the
        // scrolling region begins and ends, so the columns that stay put read
        // as deliberately parked rather than as a rendering glitch.
        if (pinnedW > 0 && bandX < clipRight) {
            c.FillRect(bandX, y, app.Scale(2), bodyTop + bodyH - y, t.borderPrimary);
        }
        if (pinnedRW > 0 && rightX > firstDataX) {
            c.FillRect(rightX - app.Scale(2), y, app.Scale(2), bodyTop + bodyH - y, t.borderPrimary);
        }

        // ---------------- row-drag drop indicator ----------------
        if (st.dragRow >= 0 && st.dragMoved) {
            int dropRow = (app.mouseY - bodyTop) / rowH;
            if (dropRow < 0) { dropRow = 0; }
            if (dropRow > visRows) { dropRow = visRows; }
            int dy = bodyTop + dropRow * rowH;
            if (dy < bodyTop) { dy = bodyTop; }
            if (dy > bodyTop + bodyH) { dy = bodyTop + bodyH; }
            c.FillRect(x + 1, dy - 1, viewW - 2, app.Scale(2), t.primary);
        }

        // ---------------- inline cell editor overlay ----------------
        st.edPopHot = false;
        if (st.editing && edVis && edW > app.Scale(8)) {
            DataTable.RenderEditor(app, cols, src, st, edX, edY, edW, edH);
        }

        // ---------------- body pointer interaction ----------------
        // Map the pointer to an order-position row and a data column purely from
        // geometry (works for range-extend / reorder even outside hit regions).
        int ptrOi = -1;
        if (app.mouseY >= bodyTop && app.mouseY < bodyTop + bodyH && app.mouseX >= x && app.mouseX < clipRight) {
            int rr2 = (app.mouseY - bodyTop) / rowH;
            if (rr2 >= 0 && rr2 < visRows && (start + rr2) < total) { ptrOi = start + rr2; }
            // A detail band is the provider's own surface, not a row: presses
            // there must not start a range selection, a reorder drag or an
            // editor. Dropping it here keeps every ptrOi consumer below honest
            // without each having to re-test the kind.
            if (ptrOi >= 0 && st.dispRows[ptrOi].kind == 2) { ptrOi = -1; }
        }
        int ptrCol = -1;
        if (ptrOi >= 0 && app.mouseX >= firstDataX) {
            // Scanned back-to-front so the frozen bands win: a middle column
            // scrolled underneath one occupies the same x, and the column the
            // user can actually see is the one they meant to hit.
            int pci = vorder.Count - 1;
            while (pci >= 0) {
                int cci = vorder[pci];
                int colL = colX[pci];
                int colR = colL + st.dispW[cci];
                int pbL = DataTable.BandLeft(colBand[pci], firstDataX, bandX, rightX);
                int pbR = DataTable.BandRight(colBand[pci], firstDataX, bandX, bandW,
                                              rightX, pinnedW, pinnedRW, clipRight);
                if (colL < pbL) { colL = pbL; }
                if (colR > pbR) { colR = pbR; }
                if (app.mouseX >= colL && app.mouseX < colR) { ptrCol = cci; pci = -1; }
                else { pci = pci - 1; }
            }
        }
        int ek = app.window.EventKind();
        int eb = app.window.EventButton();
        int emods = app.window.EventMods();

        // ---------------- filter row keyboard handling ----------------
        // When a filter-row cell is focused it consumes keyboard events
        // (printable chars, Backspace, Delete, Left/Right, Escape, Enter/Tab)
        // before the body interaction and inline editor see them.
        if (st.filterRowFocusCol >= 0) {
            int frc = st.filterRowFocusCol;
            bool frKeyHandled = false;
            if (ek == 6) {
                int fkc = app.window.EventKeyCode();
                if (fkc == 27) {
                    // Escape: clear this column's filter and blur
                    st.filterRowBuf = "";
                    if (st.filterRowText[frc].Length > 0) {
                        st.filterRowText[frc] = "";
                        st.dirty = true;
                        st.FilterChanged.Raise();
                    }
                    st.filterRowFocusCol = -1;
                } else if (fkc == 8) {
                    // Backspace
                    if (st.filterRowCur > 0) {
                        int prevStart = Text.PrevCharStart(st.filterRowBuf, st.filterRowCur);
                        st.filterRowBuf = Text.DeleteBefore(st.filterRowBuf, st.filterRowCur);
                        st.filterRowCur = prevStart;
                        st.filterRowText[frc] = st.filterRowBuf;
                        st.dirty = true;
                        st.FilterChanged.Raise();
                    }
                } else if (fkc == 46) {
                    // Delete
                    if (st.filterRowCur < st.filterRowBuf.Length) {
                        st.filterRowBuf = Text.RemoveAt(st.filterRowBuf, st.filterRowCur);
                        st.filterRowText[frc] = st.filterRowBuf;
                        st.dirty = true;
                        st.FilterChanged.Raise();
                    }
                } else {
                    string fch = Text.CharStr(fkc);
                    if (fch.Length > 0) {
                        st.filterRowBuf = Text.InsertAt(st.filterRowBuf, st.filterRowCur, fch);
                        st.filterRowCur = st.filterRowCur + fch.Length;
                        st.filterRowText[frc] = st.filterRowBuf;
                        st.dirty = true;
                        st.FilterChanged.Raise();
                    }
                }
                frKeyHandled = true;
            } else if (ek == 4) {
                int fkc2 = app.window.EventKeyCode();
                if (fkc2 == 13 || fkc2 == 9) {
                    // Enter / Tab: commit and blur
                    st.filterRowText[frc] = st.filterRowBuf;
                    st.filterRowFocusCol = -1;
                } else if (fkc2 == 37) {
                    if (st.filterRowCur > 0) { st.filterRowCur = Text.PrevCharStart(st.filterRowBuf, st.filterRowCur); }
                } else if (fkc2 == 39) {
                    if (st.filterRowCur < st.filterRowBuf.Length) { st.filterRowCur = Text.NextCharEnd(st.filterRowBuf, st.filterRowCur); }
                } else if (fkc2 == 36) {
                    st.filterRowCur = 0;
                } else if (fkc2 == 35) {
                    st.filterRowCur = st.filterRowBuf.Length;
                }
                frKeyHandled = true;
            }
            // A click outside the filter row blurs the focused cell
            if (ek == 2 && (app.mouseY < y + headerH || app.mouseY >= y + headerH + filterRowH)) {
                st.filterRowText[frc] = st.filterRowBuf;
                st.filterRowFocusCol = -1;
            }
            if (frKeyHandled) { ek = 0; app.RequestRedraw(); }
        }
        // While the context menu is open it is modal: swallow body events so a
        // click on a menu item can't also start a range/selection behind it.
        // (RenderContextMenu reads the raw event to drive item hits / dismiss.)
        if (st.ctxOpen) { ek = 0; }
        if (st.hdrCtxOpen) { ek = 0; }
        // Same for an open editor popup: its list/calendar handled the press
        // itself, so the cell beneath must not treat it as a new selection.
        if (st.edPopHot) { ek = 0; }

        // ---------------- inline editor key handling ----------------
        // While an editor is open it owns the keyboard: printable input, caret
        // movement and commit/cancel. Events are swallowed so they don't also
        // drive selection/scroll behind the editor.
        // Only keyboard events are swallowed here; mouse presses fall through to
        // the press handler, which commits the edit before re-selecting.
        if (st.editing) {
            DataColumn ecol = cols[st.editCol];
            if (ek == 6) {
                int code = app.window.EventKeyCode();
                if (code == 13) { DataTable.CommitEdit(st, cols, src); }
                else if (code == 27) { DataTable.CancelEdit(st); }
                else if (code == 9) { DataTable.CommitEdit(st, cols, src); }
                else if (code == 8) {
                    if (st.editCur > 0) {
                        int startp = Text.PrevCharStart(st.editBuf, st.editCur);
                        st.editBuf = Text.DeleteBefore(st.editBuf, st.editCur);
                        st.editCur = startp;
                        // Typing invalidates the previous rejection: the value
                        // under the message no longer exists.
                        st.editError = "";
                        if (ecol.editorKind == 1) { DataTable.RefreshChoices(st, ecol); }
                    }
                } else {
                    string ch = Text.CharStr(code);
                    if (ch.Length > 0) {
                        st.editBuf = Text.InsertAt(st.editBuf, st.editCur, ch);
                        st.editCur = st.editCur + ch.Length;
                        st.editError = "";
                        if (ecol.editorKind == 1) {
                            st.edPopOpen = true;
                            DataTable.RefreshChoices(st, ecol);
                        }
                    }
                }
                app.RequestRedraw();
                ek = 0;
            } else if (ek == 4) {
                int kc = app.window.EventKeyCode();
                // Up/Down drive whatever the editor's vertical affordance is:
                // the dropdown highlight, the calendar week, or the spinner.
                bool consumed = true;
                if (kc == 38 || kc == 40) {
                    int dir = 1;
                    if (kc == 38) { dir = -1; }
                    if (ecol.editorKind == 1) {
                        st.edPopOpen = true;
                        DataTable.MoveChoice(st, dir);
                    } else if (ecol.editorKind == 2) {
                        DataTable.CalendarStep(st, ecol, dir * 7);
                    } else if (ecol.editorKind == 3) {
                        st.editBuf = DataTable.StepValue(ecol, st.editBuf, 0 - dir);
                        st.editCur = st.editBuf.Length;
                        st.editError = "";
                    } else { consumed = false; }
                } else if (kc == 27) {
                    // Escape closes the popup first, and only then the editor —
                    // so dismissing a list doesn't throw away the typed text.
                    if (st.edPopOpen) { st.edPopOpen = false; }
                    else { DataTable.CancelEdit(st); }
                } else if (kc == 13) { DataTable.CommitEdit(st, cols, src); }
                else if (kc == 37) {
                    if (ecol.editorKind == 2) { DataTable.CalendarStep(st, ecol, -1); }
                    else if (st.editCur > 0) { st.editCur = Text.PrevCharStart(st.editBuf, st.editCur); }
                } else if (kc == 39) {
                    if (ecol.editorKind == 2) { DataTable.CalendarStep(st, ecol, 1); }
                    else if (st.editCur < st.editBuf.Length) { st.editCur = Text.NextCharEnd(st.editBuf, st.editCur); }
                } else if (kc == 33 && ecol.editorKind == 2) { st.edCalMonth = st.edCalMonth - 1; }
                else if (kc == 34 && ecol.editorKind == 2) { st.edCalMonth = st.edCalMonth + 1; }
                else if (kc == 36) { st.editCur = 0; }
                else if (kc == 35) { st.editCur = st.editBuf.Length; }
                else if (kc == 46) {
                    if (st.editCur < st.editBuf.Length) {
                        st.editBuf = Text.RemoveAt(st.editBuf, st.editCur);
                        st.editError = "";
                        if (ecol.editorKind == 1) { DataTable.RefreshChoices(st, ecol); }
                    }
                } else { consumed = false; }
                app.RequestRedraw();
                if (consumed) { ek = 0; }
            }
        }

        // F2 / Enter opens an editor on the active editable cell (Excel-style).
        // A bool cell has no text to edit: the same keys flip it in place.
        if (!st.editing && ek == 4) {
            int kc2 = app.window.EventKeyCode();
            if ((kc2 == 113 || kc2 == 13) && st.hitRow >= 0 && st.hitCol >= 0
                && st.hitCol < cols.Count && cols[st.hitCol].editable) {
                if (cols[st.hitCol].isBool) {
                    DataTable.ToggleBoolCell(st, cols, src, st.hitRow, st.hitCol);
                } else {
                    DataTable.BeginEdit(st, cols, src, st.hitRow, st.hitCol);
                }
                ek = 0;
                app.RequestRedraw();
            }
        }

        // ---------------- cell-cursor keyboard navigation ----------------
        // Arrows / PgUp / PgDn / Home / End move the cursor, Shift extends the
        // range, and Ctrl+C/V/X/A act on it. Gated on the grid having been
        // interacted with (st.hitRow), since the widget has no keyboard focus of
        // its own — otherwise an untouched grid would swallow Tab and the arrow
        // keys from every other widget on the page. Also yields whenever
        // something else owns the keyboard: an open editor, a focused filter-row
        // cell, or a modal popup.
        if (!st.editing && ek == 4 && st.hitRow >= 0
            && st.filterRowFocusCol < 0 && st.openMenu < 0) {
            if (DataTable.HandleNavKey(app, cols, src, st, vorder, visRows,
                                       dataViewW, pinnedW, app.window.EventKeyCode(), emods)) {
                ek = 0;
                app.RequestRedraw();
            }
        }

        // left press
        if (ek == 2 && eb == 0 && ptrOi >= 0) {
            if (st.dispRows[ptrOi].kind == 1) {
                // group header press: toggle collapse of that group
                int gi = st.dispRows[ptrOi].row;
                DataTable.ToggleCollapse(st, st.groups[gi].key);
                app.RequestRedraw();
            } else if (app.mouseX >= x && app.mouseX < x + numW) {
                // row-number press: could become a row click or a reorder drag
                st.dragRow = ptrOi;
                st.dragStartY = app.mouseY;
                st.dragMoved = false;
            } else if (app.mouseX >= firstDataX && ptrCol >= 0) {
                // A press on the cell that's already the sole active selection
                // (a slow second click) opens the inline editor; otherwise begin
                // a rectangular range selection. A press while editing commits
                // first, then re-selects.
                bool sameCell = (!st.editing) && st.hitOrder == ptrOi && st.hitCol == ptrCol
                    && st.rangeR0 == st.rangeR1 && st.rangeC0 == st.rangeC1;
                if (st.editing) { DataTable.CommitEdit(st, cols, src); }
                // A refused commit keeps its editor open; moving the selection
                // now would strand it over an unrelated cell, so the press is
                // spent on surfacing the error instead.
                if (st.editing) {
                    app.RequestRedraw();
                } else if (sameCell && cols[ptrCol].editable && !cols[ptrCol].isBool) {
                    DataTable.BeginEdit(st, cols, src, st.dispRows[ptrOi].row, ptrCol);
                    app.RequestRedraw();
                } else {
                    st.rangeR0 = ptrOi;
                    st.rangeR1 = ptrOi;
                    st.rangeC0 = ptrCol;
                    st.rangeC1 = ptrCol;
                    st.rangeDrag = true;
                    st.selAnchor = ptrOi;
                    st.hitOrder = ptrOi;
                    st.hitRow = st.dispRows[ptrOi].row;
                    st.hitCol = ptrCol;
                    st.CellClick.Raise();
                    app.RequestRedraw();
                }
            }
        }

        // drag move
        if (ek == 1) {
            if (st.rangeDrag && ptrOi >= 0) {
                st.rangeR1 = ptrOi;
                if (ptrCol >= 0) { st.rangeC1 = ptrCol; }
                app.RequestRedraw();
            }
            if (st.dragRow >= 0) {
                int dd = app.mouseY - st.dragStartY;
                if (dd < 0) { dd = 0 - dd; }
                if (dd > rowH / 2) { st.dragMoved = true; app.RequestRedraw(); }
            }
        }

        // left release
        if (ek == 3 && eb == 0) {
            if (st.rangeDrag) { st.rangeDrag = false; app.RequestRedraw(); }
            if (st.dragRow >= 0) {
                if (st.groupCols.Count == 0 && st.dragMoved && ptrOi >= 0 && ptrOi != st.dragRow
                    && st.dispRows[ptrOi].kind == 0) {
                    DataTable.MoveOrder(st, st.dragRow, ptrOi);
                    // manual order — drop any active sort without re-running
                    // Recompute (which would rebuild st.order and lose the move).
                    st.sortKeys.Clear();
                    DataTable.SyncPrimary(st);
                    app.RequestRedraw();
                } else if (!st.dragMoved && st.dispRows[st.dragRow].kind == 0) {
                    // treat as a row-selection click (按行选择)
                    int ri = st.dispRows[st.dragRow].row;
                    st.hitOrder = st.dragRow;
                    st.hitRow = ri;
                    st.hitCol = -1;
                    st.RowClick.Raise();
                    st.SelectionChanged.Raise();
                    bool shift = (emods & 2) != 0;
                    bool ctrl = (emods & 1) != 0;
                    if (shift && st.selAnchor >= 0) {
                        DataTable.SelectAllRows(st, false);
                        int a = DataTable.MinI(st.selAnchor, st.dragRow);
                        int b = DataTable.MaxI(st.selAnchor, st.dragRow);
                        int kk = a;
                        while (kk <= b) { if (kk >= 0 && kk < st.dispRows.Count && st.dispRows[kk].kind == 0) { st.selected[st.dispRows[kk].row] = true; } kk = kk + 1; }
                    } else if (ctrl) {
                        st.selected[ri] = !st.selected[ri];
                        st.selAnchor = st.dragRow;
                    } else {
                        DataTable.SelectAllRows(st, false);
                        st.selected[ri] = true;
                        st.selAnchor = st.dragRow;
                        DataTable.ClearRange(st);
                    }
                    app.RequestRedraw();
                }
                st.dragRow = -1;
                st.dragMoved = false;
            }
        }

        // double-click on a body row
        if (ek == 3 && eb == 0 && ptrOi >= 0 && st.dispRows[ptrOi].kind == 0 && app.DoubleClickNow()) {
            st.hitOrder = ptrOi;
            st.hitRow = st.dispRows[ptrOi].row;
            st.RowDoubleClick.Raise();
        }

        // right press => context menu
        if (ek == 2 && eb == 1 && st.openMenu < 0
            && app.mouseX >= x && app.mouseX < x + viewW
            && app.mouseY >= bodyTop && app.mouseY < bodyTop + bodyH) {
            // if right-clicking a row outside any current range/selection, make
            // that row the selection so the menu's copy/export act on something.
            if (ptrOi >= 0 && st.dispRows[ptrOi].kind == 0 && !DataTable.HasRange(st)) {
                int ri = st.dispRows[ptrOi].row;
                if (!st.selected[ri]) {
                    DataTable.SelectAllRows(st, false);
                    st.selected[ri] = true;
                    st.selAnchor = ptrOi;
                }
            }
            st.ctxOpen = true;
            st.ctxX = app.mouseX;
            st.ctxY = app.mouseY;
            app.RequestRedraw();
        }

        // empty state
        if (total == 0) {
            c.DrawTextCentered(x, bodyTop, viewW, bodyH, "No matching rows", t.textTertiary, t.fontSizeMedium);
        }

        // ---------------- summary (total) row ----------------
        if (st.showSummary) {
            int sumY = bodyTop + bodyH;
            c.FillRect(x + 1, sumY, viewW - 2, summaryH, t.bgSecondary);
            c.FillRect(x + 1, sumY, viewW - 2, 1, gridColor);
            int sx = x + numW + selW;
            if (st.showRowNum || st.showSelect) {
                c.DrawTextCentered(x, sumY, numW + selW, summaryH, "Σ", t.textTertiary, t.fontSizeSmall);
            }
            int soi = 0;
            int sBand = -1;
            while (soi < vorder.Count) {
                int sc = vorder[soi];
                int cw = st.dispW[sc];
                if (colBand[soi] != sBand) {
                    if (sBand >= 0) { c.PopClip(); }
                    sBand = colBand[soi];
                    DataTable.PushBandClip(c, sBand, firstDataX, bandX, bandW, rightX,
                                           pinnedW, pinnedRW, sumY, summaryH, clipRight);
                }
                sx = colX[soi];
                int sBandL = DataTable.BandLeft(colBand[soi], firstDataX, bandX, rightX);
                int sBandR = DataTable.BandRight(colBand[soi], firstDataX, bandX, bandW,
                                                 rightX, pinnedW, pinnedRW, clipRight);
                if (sx + cw > sBandL && sx < sBandR) {
                    string stxt = "";
                    if (sc < st.summaryText.Count) { stxt = st.summaryText[sc]; }
                    if (stxt.Length > 0) {
                        int pad = t.paddingSmall;
                        string shown = DataTable.Truncate(stxt, fs, cw - pad * 2);
                        int tw = Canvas.MeasureText(shown, fs);
                        int tx = sx + pad;
                        if (cols[sc].align == 2) { tx = sx + cw - pad - tw; }
                        else if (cols[sc].align == 1) { tx = sx + (cw - tw) / 2; }
                        int ty = sumY + (summaryH - Canvas.FontHeight(fs)) / 2;
                        c.DrawText(tx, ty, shown, t.textPrimary, fs);
                    }
                }
                soi = soi + 1;
            }
            if (sBand >= 0) { c.PopClip(); }
        }

        // ---------------- pager footer (reuses the Pagination widget) ----------------
        if (st.paged) {
            int fY = bodyTop + bodyH + summaryH;
            c.FillRect(x + 1, fY, viewW - 2, pagerH, t.bgSecondary);
            c.FillRect(x + 1, fY, viewW - 2, 1, gridColor);
            int totalPages = 1;
            if (total > 0) { totalPages = (total + visRows - 1) / visRows; }
            int cur = st.pageModel.Get();
            int pgW = Pagination.MeasureWidth(app, totalPages, cur);
            int pgX = x + (viewW - pgW) / 2;
            if (pgX < x + t.paddingMedium) { pgX = x + t.paddingMedium; }
            int pgY = fY + (pagerH - t.heightMedium) / 2;
            int pgFirst = Pagination.Render(app, pgX, pgY, totalPages, st.pageModel);
            Pagination.HandleClick(app, pgFirst, totalPages, st.pageModel);
            // range info on the left
            int from = (cur - 1) * visRows + 1;
            int to = cur * visRows;
            if (to > total) { to = total; }
            if (total == 0) { from = 0; }
            string info = Convert.ToString(from) + "-" + Convert.ToString(to) + " / " + Convert.ToString(total);
            c.DrawText(x + t.paddingMedium, pgY + (t.heightMedium - Canvas.FontHeight(t.fontSizeSmall)) / 2, info, t.textTertiary, t.fontSizeSmall);
        }

        // ---------------- status bar (DevExpress-style bottom strip) ----------------
        // Left: filtered/total row count + selected-row count. Right: live
        // sum/avg/cell-count for the current cell-range selection (numeric
        // columns only) — lets the user eyeball a quick total without leaving
        // the grid, same as Excel's/DevExpress's status strip.
        if (st.showStatusBar) {
            int sbY = bodyTop + bodyH + summaryH + pagerH;
            c.FillRect(x + 1, sbY, viewW - 2, statusBarH, t.bgSecondary);
            c.FillRect(x + 1, sbY, viewW - 2, 1, gridColor);
            int sbFs = t.fontSizeSmall;
            int sbTy = sbY + (statusBarH - Canvas.FontHeight(sbFs)) / 2;

            int totalSrc = src.RowCount();
            int shownRows = st.order.Count;
            string rowInfo = "行数: " + Convert.ToString(shownRows);
            if (shownRows != totalSrc) { rowInfo = rowInfo + " / " + Convert.ToString(totalSrc); }
            int selCount = 0;
            int sci = 0;
            while (sci < st.selected.Count) { if (st.selected[sci]) { selCount = selCount + 1; } sci = sci + 1; }
            if (selCount > 0) { rowInfo = rowInfo + "    已选: " + Convert.ToString(selCount); }
            c.DrawText(x + t.paddingMedium, sbTy, rowInfo, t.textSecondary, sbFs);

            if (DataTable.HasRange(st)) {
                int rC0 = DataTable.MinI(st.rangeC0, st.rangeC1);
                int rC1 = DataTable.MaxI(st.rangeC0, st.rangeC1);
                int rR0 = DataTable.MinI(st.rangeR0, st.rangeR1);
                int rR1 = DataTable.MaxI(st.rangeR0, st.rangeR1);
                int rsum = 0;
                int rcount = 0;
                int rri = rR0;
                while (rri <= rR1 && rri < st.dispRows.Count) {
                    if (st.dispRows[rri].kind == 0) {
                        int drow = st.dispRows[rri].row;
                        int rci = rC0;
                        while (rci <= rC1 && rci < cols.Count) {
                            if (cols[rci].numeric) {
                                rsum = rsum + src.CellNum(drow, rci);
                                rcount = rcount + 1;
                            }
                            rci = rci + 1;
                        }
                    }
                    rri = rri + 1;
                }
                if (rcount > 0) {
                    int ravg = rsum / rcount;
                    string rangeInfo = "选区求和: " + Convert.ToString(rsum)
                        + "    平均: " + Convert.ToString(ravg)
                        + "    单元格: " + Convert.ToString(rcount);
                    int rw = Canvas.MeasureText(rangeInfo, sbFs);
                    c.DrawText(x + viewW - t.paddingMedium - rw, sbTy, rangeInfo, t.textSecondary, sbFs);
                }
            }
        }

        // ---------------- vertical scrollbar ----------------
        if (!st.paged && total > visRows && visRows > 0) {
            int sbW = app.Scale(8);
            int sbX = x + viewW - sbW - app.Scale(2);
            int trackY = bodyTop + app.Scale(2);
            int trackH = bodyH - app.Scale(4);
            int thumbH = trackH * visRows / total;
            if (thumbH < app.Scale(24)) { thumbH = app.Scale(24); }
            int maxStart = total - visRows;
            int thumbY = trackY;
            if (maxStart > 0) { thumbY = trackY + (trackH - thumbH) * start / maxStart; }

            int sbId = app.focus.AllocId();
            bool sbHover = app.focus.IsHovered(sbId);
            int thumbColor = t.scrollbar;
            if (sbHover || app.focus.pressedId == sbId) { thumbColor = t.scrollbarHover; }
            c.FillRoundRect(sbX, thumbY, sbW, thumbH, sbW / 2, thumbColor);
            app.hitTester.Register(HitRegion.Create(sbId, sbX, trackY, sbW, trackH, 0));
            if (app.focus.pressedId == sbId && maxStart > 0) {
                int rel = app.mouseY - trackY - thumbH / 2;
                int denom = trackH - thumbH;
                if (denom < 1) { denom = 1; }
                int ns = rel * maxStart / denom;
                if (ns < 0) { ns = 0; }
                if (ns > maxStart) { ns = maxStart; }
                if (ns != st.scrollRow) { st.scrollRow = ns; st.ScrollChanged.Raise(); app.RequestRedraw(); }
            }
        }

        // ---------------- horizontal scrollbar ----------------
        if (maxScrollX > 0) {
            int hbH = app.Scale(8);
            int hbY = bodyTop + bodyH - hbH - app.Scale(2);
            // The bar spans only the band that actually scrolls, so its thumb
            // stays a truthful picture of where the middle is.
            int htrackX = bandX + app.Scale(2);
            int htrackW = bandW - app.Scale(4);
            if (htrackW < app.Scale(24)) { htrackW = app.Scale(24); }
            int thumbW = htrackW * bandW / bandNatW;
            if (thumbW < app.Scale(24)) { thumbW = app.Scale(24); }
            int thumbX = htrackX + (htrackW - thumbW) * st.scrollX / maxScrollX;
            int hbId = app.focus.AllocId();
            bool hbHover = app.focus.IsHovered(hbId);
            int hbColor = t.scrollbar;
            if (hbHover || app.focus.pressedId == hbId) { hbColor = t.scrollbarHover; }
            c.FillRoundRect(thumbX, hbY, thumbW, hbH, hbH / 2, hbColor);
            app.hitTester.Register(HitRegion.Create(hbId, htrackX, hbY, htrackW, hbH, 0));
            if (app.focus.pressedId == hbId) {
                int rel = app.mouseX - htrackX - thumbW / 2;
                int denom = htrackW - thumbW;
                if (denom < 1) { denom = 1; }
                int ns = rel * maxScrollX / denom;
                if (ns < 0) { ns = 0; }
                if (ns > maxScrollX) { ns = maxScrollX; }
                if (ns != st.scrollX) { st.scrollX = ns; app.RequestRedraw(); }
            }
        }

        // ---------------- mouse-wheel scrolls the table body ----------------
        // Claim the wheel while the pointer is over the body so the surrounding
        // page doesn't scroll instead, then advance the virtual row window.
        bool ownsBodyWheel = false;
        if (visRows > 0) {
            ownsBodyWheel = app.CaptureWheel(x, bodyTop, viewW, bodyH);
        }
        if (st.openMenu < 0 && ownsBodyWheel
            && maxScrollX > 0 && (app.window.EventMods() & 2) != 0) {
            // Shift+wheel pans the columns horizontally.
            int hDelta = app.window.EventKeyCode();
            int hStep = hDelta / 120;
            if (hStep == 0) { if (hDelta > 0) { hStep = 1; } else if (hDelta < 0) { hStep = 0 - 1; } }
            int nsx = st.scrollX - hStep * app.Scale(48);
            if (nsx < 0) { nsx = 0; }
            if (nsx > maxScrollX) { nsx = maxScrollX; }
            if (nsx != st.scrollX) { st.scrollX = nsx; app.RequestRedraw(); }
        } else if (st.openMenu < 0 && ownsBodyWheel) {
            if (total > visRows) {
                int delta = app.window.EventKeyCode();
                int step = delta / 120;
                if (step == 0) { if (delta > 0) { step = 1; } else if (delta < 0) { step = 0 - 1; } }
                if (st.paged) {
                    // wheel flips whole pages
                    int totalPages = (total + visRows - 1) / visRows;
                    int cp = st.pageModel.Get();
                    int np = cp - step;
                    if (np < 1) { np = 1; }
                    if (np > totalPages) { np = totalPages; }
                    if (np != cp) { st.pageModel.Set(np); app.RequestRedraw(); }
                } else {
                    int ns = st.scrollRow - step * 3;
                    int maxStart = total - visRows;
                    if (ns < 0) { ns = 0; }
                    if (ns > maxStart) { ns = maxStart; }
                    if (ns != st.scrollRow) { st.scrollRow = ns; st.ScrollChanged.Raise(); app.RequestRedraw(); }
                }
            }
        }

        // ---------------- header set-filter menu (overlay, drawn last) ----------------
        if (st.openMenu >= 0 && st.openMenu < cols.Count) {
            DataTable.RenderMenu(app, x, y, viewW, headerH, numW, selW, cols, src, st);
        }

        // ---------------- right-click context menu (overlay) ----------------
        if (st.ctxOpen) {
            DataTable.RenderContextMenu(app, x, y, viewW, viewH, cols, src, st);
        }

        // ---------------- header column context menu (overlay) ----------------
        if (st.hdrCtxOpen) {
            DataTable.RenderHeaderMenu(app, x, y, viewW, viewH, cols, src, st);
        }

        // ---------------- chart-from-selection overlay ----------------
        if (st.chartOpen) {
            DataTable.RenderChart(app, x, y, viewW, viewH, st);
        }

        // ---------------- transient toast (copy/export feedback) ----------------
        if (st.toastFrames > 0 && st.toast.Length > 0) {
            int tfs = t.fontSizeSmall;
            int tw = Canvas.MeasureText(st.toast, tfs) + app.Scale(24);
            int th = t.heightMedium;
            int tx = x + (viewW - tw) / 2;
            int tyy = y + viewH - th - app.Scale(12);
            c.FillRoundRect(tx, tyy, tw, th, t.borderRadiusMedium, t.textPrimary);
            c.DrawTextCentered(tx, tyy, tw, th, st.toast, t.bgPrimary, tfs);
            st.toastFrames = st.toastFrames - 1;
            if (st.toastFrames > 0) { app.RequestRedraw(); }
        }
    }

    // ---------- right-click context menu ----------

    static void CtxItem(App app, int mx, int my, int mw, int ih, string label, string accel) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int id = app.focus.AllocId();
        bool hov = app.focus.IsHovered(id);
        if (hov) { c.FillRect(mx, my, mw, ih, t.bgHover); }
        c.DrawText(mx + app.Scale(12), my + (ih - Canvas.FontHeight(t.fontSizeSmall)) / 2, label, t.textPrimary, t.fontSizeSmall);
        if (accel.Length > 0) {
            int aw = Canvas.MeasureText(accel, t.fontSizeSmall);
            c.DrawText(mx + mw - aw - app.Scale(12), my + (ih - Canvas.FontHeight(t.fontSizeSmall)) / 2, accel, t.textTertiary, t.fontSizeSmall);
        }
        app.hitTester.Register(HitRegion.Create(id, mx, my, mw, ih, 0));
    }

    // A header-menu aggregate row: shows a check on the active mode, and on
    // click applies it and closes the menu. Returns the next item's y.
    static int AggItem(App app, int mx, int iy, int mw, int ih,
                       DataTableState st, int col, int mode, string label, int curAgg) {
        string mark = "";
        if (mode == curAgg) { mark = "✓"; }
        DataTable.CtxItem(app, mx, iy, mw, ih, label, mark);
        if (DataTable.CtxHit(app, mx, iy, mw, ih)) {
            DataTable.SetAggregate(st, col, mode);
            st.hitCol = col; st.ColumnResize.Raise();
            st.hdrCtxOpen = false; app.RequestRedraw();
        }
        return iy + ih;
    }

    static bool CtxHit(App app, int mx, int my, int mw, int ih) {
        // Was the row spanning (mx,my,mw,ih) just clicked? Uses geometry so the
        // ids stay simple; the menu is modal-ish (drawn last, wins hit-testing).
        return app.window.EventKind() == 3 && app.window.EventButton() == 0
               && app.mouseX >= mx && app.mouseX < mx + mw
               && app.mouseY >= my && app.mouseY < my + ih;
    }

    static void Flash(DataTableState st, string msg) {
        st.toast = msg;
        st.toastFrames = 90;
    }

    static void RenderContextMenu(App app, int x, int y, int viewW, int viewH,
                                  List<DataColumn> cols, DataSource src, DataTableState st) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int mw = app.Scale(230);
        int ih = t.heightMedium;
        int sepH = app.Scale(9);

        // menu items: label, accelerator, kind (0 item, 1 separator)
        // 0 copy, 1 copy-with-headers, 2 paste, 3 clear cells, 4 export csv,
        // 5 chart-from-selection, [sep, insert row, delete rows, undo,]
        // sep, select all, sep, clear selection
        // The row-editing group only exists when the source can actually grow
        // or shrink, so a read-only grid shows no command it would refuse.
        bool canRows = src.CanInsert();
        int nItems = 8;
        int nSeps = 2;
        if (canRows) { nItems = nItems + 3; nSeps = nSeps + 1; }
        int mh = ih * nItems + sepH * nSeps + app.Scale(8);

        int mx = st.ctxX;
        int my = st.ctxY;
        if (mx + mw > x + viewW) { mx = x + viewW - mw - app.Scale(2); }
        if (my + mh > y + viewH) { my = y + viewH - mh - app.Scale(2); }
        if (mx < x) { mx = x; }
        if (my < y) { my = y; }

        // claim wheel + swallow clicks over the whole menu so gaps and the page
        // beneath it don't get scrolled or fall through (items register later)
        app.CaptureWheel(mx, my, mw, mh);
        app.BlockHitsRect(mx, my, mw, mh);
        c.FillRoundRect(mx, my, mw, mh, t.borderRadiusMedium, t.bgPrimary);
        c.DrawRect(mx, my, mw, mh, t.borderPrimary, 1);

        int iy = my + app.Scale(4);
        DataTable.CtxItem(app, mx, iy, mw, ih, "复制  Copy", "Ctrl+C");
        if (DataTable.CtxHit(app, mx, iy, mw, ih)) {
            Clipboard.SetText(DataTable.BuildText(st, cols, src, false, false));
            DataTable.Flash(st, "已复制到剪贴板");
            st.ctxOpen = false;
            app.RequestRedraw();
        }
        iy = iy + ih;
        DataTable.CtxItem(app, mx, iy, mw, ih, "复制（含表头）", "");
        if (DataTable.CtxHit(app, mx, iy, mw, ih)) {
            Clipboard.SetText(DataTable.BuildText(st, cols, src, false, true));
            DataTable.Flash(st, "已复制（含表头）");
            st.ctxOpen = false;
            app.RequestRedraw();
        }
        iy = iy + ih;
        DataTable.CtxItem(app, mx, iy, mw, ih, "粘贴  Paste", "Ctrl+V");
        if (DataTable.CtxHit(app, mx, iy, mw, ih)) {
            int pn = DataTable.PasteText(st, cols, src, Clipboard.GetText());
            if (pn > 0) { DataTable.Flash(st, "已粘贴 " + Convert.ToString(pn) + " 个单元格"); }
            else { DataTable.Flash(st, "无可粘贴的可编辑单元格"); }
            st.ctxOpen = false;
            app.RequestRedraw();
        }
        iy = iy + ih;
        DataTable.CtxItem(app, mx, iy, mw, ih, "清空所选单元格", "Delete");
        if (DataTable.CtxHit(app, mx, iy, mw, ih)) {
            int dn = DataTable.ClearRangeCells(st, cols, src);
            if (dn > 0) { DataTable.Flash(st, "已清空 " + Convert.ToString(dn) + " 个单元格"); }
            else { DataTable.Flash(st, "所选区域没有可编辑单元格"); }
            st.ctxOpen = false;
            app.RequestRedraw();
        }
        iy = iy + ih;
        DataTable.CtxItem(app, mx, iy, mw, ih, "导出 CSV", "");
        if (DataTable.CtxHit(app, mx, iy, mw, ih)) {
            bool ok = SysFile.Write("datatable_export.csv", DataTable.BuildText(st, cols, src, true, true));
            if (ok) { DataTable.Flash(st, "已导出 datatable_export.csv"); }
            else { DataTable.Flash(st, "导出失败"); }
            st.ctxOpen = false;
            app.RequestRedraw();
        }
        iy = iy + ih;
        DataTable.CtxItem(app, mx, iy, mw, ih, "从选区生成图表  Chart", "");
        if (DataTable.CtxHit(app, mx, iy, mw, ih)) {
            if (DataTable.BuildChartFromRange(st, cols, src)) {
                st.chartOpen = true;
            } else {
                DataTable.Flash(st, "请先框选含数值列的区域");
            }
            st.ctxOpen = false;
            app.RequestRedraw();
        }
        iy = iy + ih;
        if (canRows) {
            c.FillRect(mx + app.Scale(8), iy + sepH / 2, mw - app.Scale(16), 1, t.divider);
            iy = iy + sepH;
            DataTable.CtxItem(app, mx, iy, mw, ih, "插入行  Insert row", "Ctrl+Ins");
            if (DataTable.CtxHit(app, mx, iy, mw, ih)) {
                // Insert *below* the clicked row, which is where a reader
                // expects a new entry to appear; the anchor row keeps its place.
                int at = src.RowCount();
                if (st.hitRow >= 0) { at = st.hitRow + 1; }
                int nr = DataTable.InsertRow(st, cols, src, at);
                if (nr >= 0) {
                    DataTable.Recompute(st, cols, src);
                    DataTable.FocusRow(st, cols, src, nr);
                }
                st.ctxOpen = false;
                app.RequestRedraw();
            }
            iy = iy + ih;
            DataTable.CtxItem(app, mx, iy, mw, ih, "删除行  Delete rows", "Ctrl+Del");
            if (DataTable.CtxHit(app, mx, iy, mw, ih)) {
                int killed = DataTable.DeleteSelectedRows(st, cols, src);
                if (killed == 0 && st.hitRow >= 0) {
                    if (DataTable.DeleteRow(st, cols, src, st.hitRow)) { killed = 1; }
                }
                if (killed > 0) {
                    DataTable.Recompute(st, cols, src);
                    DataTable.Flash(st, "已删除 " + Convert.ToString(killed) + " 行（Ctrl+Z 撤销）");
                }
                st.ctxOpen = false;
                app.RequestRedraw();
            }
            iy = iy + ih;
            int undoN = DataTable.UndoDepth(st);
            string undoLbl = "撤销  Undo";
            if (undoN > 0) { undoLbl = undoLbl + "  (" + Convert.ToString(undoN) + ")"; }
            DataTable.CtxItem(app, mx, iy, mw, ih, undoLbl, "Ctrl+Z");
            if (DataTable.CtxHit(app, mx, iy, mw, ih)) {
                if (DataTable.Undo(st, cols, src)) {
                    DataTable.Recompute(st, cols, src);
                    DataTable.Flash(st, "已撤销");
                } else {
                    DataTable.Flash(st, "没有可撤销的操作");
                }
                st.ctxOpen = false;
                app.RequestRedraw();
            }
            iy = iy + ih;
        }
        c.FillRect(mx + app.Scale(8), iy + sepH / 2, mw - app.Scale(16), 1, t.divider);
        iy = iy + sepH;
        DataTable.CtxItem(app, mx, iy, mw, ih, "全选", "Ctrl+A");
        if (DataTable.CtxHit(app, mx, iy, mw, ih)) {
            DataTable.SelectAllRows(st, true);
            DataTable.ClearRange(st);
            st.ctxOpen = false;
            app.RequestRedraw();
        }
        iy = iy + ih;
        c.FillRect(mx + app.Scale(8), iy + sepH / 2, mw - app.Scale(16), 1, t.divider);
        iy = iy + sepH;
        DataTable.CtxItem(app, mx, iy, mw, ih, "清除选择", "");
        if (DataTable.CtxHit(app, mx, iy, mw, ih)) {
            DataTable.SelectAllRows(st, false);
            DataTable.ClearRange(st);
            st.ctxOpen = false;
            app.RequestRedraw();
        }

        // click outside closes the menu
        if (app.window.EventKind() == 3
            && !(app.mouseX >= mx && app.mouseX < mx + mw && app.mouseY >= my && app.mouseY < my + mh)) {
            st.ctxOpen = false;
            app.RequestRedraw();
        }
    }

    // ---------- chart-from-selection overlay ----------
    // A modal bar chart built from the selected range (see BuildChartFromRange).
    // Closes on the [x] button, a click outside the panel, or Escape.
    static void RenderChart(App app, int x, int y, int viewW, int viewH,
                            DataTableState st) {
        Canvas c = app.canvas;
        Theme t = app.theme;

        int m = app.Scale(20);
        int px = x + m;
        int py = y + m;
        int pw = viewW - m * 2;
        int ph = viewH - m * 2;
        if (pw < app.Scale(120) || ph < app.Scale(100)) { st.chartOpen = false; return; }

        // scrim + panel
        c.FillRect(x, y, viewW, viewH, t.overlay);
        // modal: claim wheel + block all hits beneath the chart overlay
        app.CaptureWheel(x, y, viewW, viewH);
        app.BlockHitsRect(x, y, viewW, viewH);
        c.FillRoundRect(px, py, pw, ph, t.borderRadiusMedium, t.bgPrimary);
        c.DrawRect(px, py, pw, ph, t.borderPrimary, 1);

        // title bar
        int th = t.heightLarge;
        c.FillRect(px + 1, py + 1, pw - 2, th, t.bgSecondary);
        c.FillRect(px + 1, py + th, pw - 2, 1, t.divider);
        c.DrawText(px + app.Scale(14), py + (th - Canvas.FontHeight(t.fontSizeMedium)) / 2,
                   "图表 Chart · " + st.chartTitle, t.textPrimary, t.fontSizeMedium);

        // close button
        int cbs = app.Scale(22);
        int cbx = px + pw - cbs - app.Scale(8);
        int cby = py + (th - cbs) / 2;
        bool cbHot = app.mouseX >= cbx && app.mouseX < cbx + cbs
                     && app.mouseY >= cby && app.mouseY < cby + cbs;
        if (cbHot) { c.FillRoundRect(cbx, cby, cbs, cbs, app.Scale(4), t.bgHover); }
        c.DrawTextCentered(cbx, cby, cbs, cbs, "×", t.textPrimary, t.fontSizeLarge);

        // plot area
        int axisW = app.Scale(44);
        int plotX = px + axisW;
        int plotTop = py + th + app.Scale(14);
        int plotBottom = py + ph - app.Scale(30);
        int plotRight = px + pw - app.Scale(16);
        int plotW = plotRight - plotX;
        int plotH = plotBottom - plotTop;
        int n = st.chartBars.Count;
        if (plotH < app.Scale(20) || plotW < app.Scale(20) || n <= 0) {
            // still allow closing even if too small to plot
        } else {
            int mx = st.chartMax;
            if (mx < 1) { mx = 1; }

            // baseline + max/zero axis labels + a faint midline
            c.FillRect(plotX, plotBottom, plotW, 1, t.borderPrimary);
            c.DrawText(px + app.Scale(8), plotTop - Canvas.FontHeight(t.fontSizeSmall) / 2,
                       Convert.ToString(mx), t.textTertiary, t.fontSizeSmall);
            c.DrawText(px + app.Scale(8), plotBottom - Canvas.FontHeight(t.fontSizeSmall) / 2,
                       "0", t.textTertiary, t.fontSizeSmall);
            int midY = plotTop + plotH / 2;
            c.FillRect(plotX, midY, plotW, 1, t.divider);

            int slotW = plotW / n;
            int barW = slotW * 3 / 5;
            if (barW < app.Scale(4)) { barW = app.Scale(4); }
            int i = 0;
            while (i < n) {
                ChartBar bar = st.chartBars[i];
                int av = bar.val;
                if (av < 0) { av = 0 - av; }
                int bh = av * plotH / mx;
                if (bh < 1 && av > 0) { bh = 1; }
                int slotL = plotX + slotW * i;
                int bx = slotL + (slotW - barW) / 2;
                int byy = plotBottom - bh;
                c.FillRect(bx, byy, barW, bh, t.primary);

                // value label above the bar
                string vlab = Convert.ToString(bar.val);
                int vlw = Canvas.MeasureText(vlab, t.fontSizeSmall);
                int vlx = slotL + (slotW - vlw) / 2;
                int vly = byy - Canvas.FontHeight(t.fontSizeSmall) - app.Scale(2);
                if (vly < plotTop) { vly = plotTop; }
                c.DrawText(vlx, vly, vlab, t.textSecondary, t.fontSizeSmall);

                // category label below the baseline (clipped to the slot)
                c.PushClip(slotL, plotBottom + app.Scale(4), slotW, app.Scale(20));
                c.DrawTextCentered(slotL, plotBottom + app.Scale(4), slotW,
                                   Canvas.FontHeight(t.fontSizeSmall),
                                   bar.label, t.textTertiary, t.fontSizeSmall);
                c.PopClip();
                i = i + 1;
            }
        }

        // close interactions: [x], click outside the panel, or Escape
        bool clicked = app.window.EventKind() == 3 && app.window.EventButton() == 0;
        bool inside = app.mouseX >= px && app.mouseX < px + pw
                      && app.mouseY >= py && app.mouseY < py + ph;
        if ((clicked && (cbHot || !inside))
            || (app.window.EventKind() == 4 && app.window.EventKeyCode() == 27)) {
            st.chartOpen = false;
            app.RequestRedraw();
        }
    }

    // ---------- header (column) context menu ----------
    // Right-clicking a column header opens this DevExpress/ag-Grid-style menu:
    // sort, auto-fit width, hide the column, restore all columns, and jump to
    // the set-filter popup. Layout mirrors RenderContextMenu (running iy).
    static void RenderHeaderMenu(App app, int x, int y, int viewW, int viewH,
                                 List<DataColumn> cols, DataSource src, DataTableState st) {
        int col = st.hdrCtxCol;
        if (col < 0 || col >= cols.Count) { st.hdrCtxOpen = false; return; }
        Canvas c = app.canvas;
        Theme t = app.theme;
        int mw = app.Scale(230);
        int ih = t.heightMedium;
        int sepH = app.Scale(9);

        bool canClear = DataTable.SortIndexOf(st, col) >= 0;
        bool anyHidden = DataTable.HiddenCount(st) > 0;
        bool canFilter = cols[col].filterable;
        bool canAgg = cols[col].numeric;

        int nItems = 4;                       // asc, desc, auto-fit, auto-fit-all
        if (canClear) { nItems = nItems + 1; }
        nItems = nItems + 1;                  // group by this column
        if (st.groupCols.Count > 0) { nItems = nItems + 1; }  // ungroup all
        nItems = nItems + 2;                  // freeze left / freeze right
        nItems = nItems + 1;                  // hide column
        if (anyHidden) { nItems = nItems + 1; }
        if (canAgg) { nItems = nItems + 6; }  // sum/avg/min/max/count/none total
        if (canFilter) { nItems = nItems + 1; }
        int nSep = 3;                         // after sort, after auto-fit, after group
        if (canAgg) { nSep = nSep + 1; }      // before aggregate items
        if (canFilter) { nSep = nSep + 1; }   // before filter item
        int mh = ih * nItems + sepH * nSep + app.Scale(8);

        int mx = st.hdrCtxX;
        int my = st.hdrCtxY;
        if (mx + mw > x + viewW) { mx = x + viewW - mw - app.Scale(2); }
        if (my + mh > y + viewH) { my = y + viewH - mh - app.Scale(2); }
        if (mx < x) { mx = x; }
        if (my < y) { my = y; }

        // claim wheel + swallow clicks over the whole menu so gaps and the page
        // beneath it don't get scrolled or fall through (items register later)
        app.CaptureWheel(mx, my, mw, mh);
        app.BlockHitsRect(mx, my, mw, mh);
        c.FillRoundRect(mx, my, mw, mh, t.borderRadiusMedium, t.bgPrimary);
        c.DrawRect(mx, my, mw, mh, t.borderPrimary, 1);

        int iy = my + app.Scale(4);
        DataTable.CtxItem(app, mx, iy, mw, ih, "升序排序  Sort Ascending", "");
        if (DataTable.CtxHit(app, mx, iy, mw, ih)) {
            DataTable.SortBy(st, col, 1);
            st.hitCol = col; st.Sort.Raise();
            st.hdrCtxOpen = false; app.RequestRedraw();
        }
        iy = iy + ih;
        DataTable.CtxItem(app, mx, iy, mw, ih, "降序排序  Sort Descending", "");
        if (DataTable.CtxHit(app, mx, iy, mw, ih)) {
            DataTable.SortBy(st, col, 2);
            st.hitCol = col; st.Sort.Raise();
            st.hdrCtxOpen = false; app.RequestRedraw();
        }
        iy = iy + ih;
        if (canClear) {
            DataTable.CtxItem(app, mx, iy, mw, ih, "清除排序  Clear Sort", "");
            if (DataTable.CtxHit(app, mx, iy, mw, ih)) {
                DataTable.ClearSort(st);
                st.Sort.Raise();
                st.hdrCtxOpen = false; app.RequestRedraw();
            }
            iy = iy + ih;
        }

        c.FillRect(mx + app.Scale(8), iy + sepH / 2, mw - app.Scale(16), 1, t.divider);
        iy = iy + sepH;
        DataTable.CtxItem(app, mx, iy, mw, ih, "自动列宽  Auto-fit Column", "");
        if (DataTable.CtxHit(app, mx, iy, mw, ih)) {
            DataTable.AutoFitColumn(app, cols, src, st, col);
            st.hitCol = col; st.ColumnResize.Raise();
            st.hdrCtxOpen = false; app.RequestRedraw();
        }
        iy = iy + ih;
        DataTable.CtxItem(app, mx, iy, mw, ih, "自动全部列宽  Auto-fit All", "");
        if (DataTable.CtxHit(app, mx, iy, mw, ih)) {
            DataTable.AutoFitAll(app, cols, src, st);
            st.ColumnResize.Raise();
            st.hdrCtxOpen = false; app.RequestRedraw();
        }
        iy = iy + ih;

        c.FillRect(mx + app.Scale(8), iy + sepH / 2, mw - app.Scale(16), 1, t.divider);
        iy = iy + sepH;
        DataTable.CtxItem(app, mx, iy, mw, ih, "按此列分组  Group by This", "");
        if (DataTable.CtxHit(app, mx, iy, mw, ih)) {
            DataTable.GroupBy(st, col);
            st.hitCol = col; st.GroupChanged.Raise();
            st.hdrCtxOpen = false; app.RequestRedraw();
        }
        iy = iy + ih;
        if (st.groupCols.Count > 0) {
            DataTable.CtxItem(app, mx, iy, mw, ih, "取消分组  Ungroup All", "");
            if (DataTable.CtxHit(app, mx, iy, mw, ih)) {
                DataTable.Ungroup(st);
                st.GroupChanged.Raise();
                st.hdrCtxOpen = false; app.RequestRedraw();
            }
            iy = iy + ih;
        }

        c.FillRect(mx + app.Scale(8), iy + sepH / 2, mw - app.Scale(16), 1, t.divider);
        iy = iy + sepH;
        // Two explicit entries rather than one cycling toggle: which edge a
        // column is frozen to is a choice, and a menu that makes the user click
        // twice to guess their way to the right one is worse than showing both.
        int frz = DataTable.FreezeOf(st, col);
        string pinLbl = "冻结到左侧  Freeze Left";
        if (frz == 1) { pinLbl = "取消冻结  Unfreeze"; }
        DataTable.CtxItem(app, mx, iy, mw, ih, pinLbl, "");
        if (DataTable.CtxHit(app, mx, iy, mw, ih)) {
            if (frz == 1) { DataTable.UnpinColumn(st, col); }
            else { DataTable.PinColumn(st, col); }
            st.hitCol = col; st.ColumnResize.Raise();
            st.hdrCtxOpen = false; app.RequestRedraw();
        }
        iy = iy + ih;
        string pinRLbl = "冻结到右侧  Freeze Right";
        if (frz == 2) { pinRLbl = "取消冻结  Unfreeze"; }
        DataTable.CtxItem(app, mx, iy, mw, ih, pinRLbl, "");
        if (DataTable.CtxHit(app, mx, iy, mw, ih)) {
            if (frz == 2) { DataTable.UnpinColumn(st, col); }
            else { DataTable.PinColumnRight(st, col); }
            st.hitCol = col; st.ColumnResize.Raise();
            st.hdrCtxOpen = false; app.RequestRedraw();
        }
        iy = iy + ih;
        DataTable.CtxItem(app, mx, iy, mw, ih, "隐藏此列  Hide Column", "");
        if (DataTable.CtxHit(app, mx, iy, mw, ih)) {
            st.colHidden[col] = true;
            st.hdrCtxOpen = false; app.RequestRedraw();
        }
        iy = iy + ih;
        if (anyHidden) {
            DataTable.CtxItem(app, mx, iy, mw, ih, "显示所有列  Show All Columns", "");
            if (DataTable.CtxHit(app, mx, iy, mw, ih)) {
                DataTable.ShowAllColumns(st);
                st.hdrCtxOpen = false; app.RequestRedraw();
            }
            iy = iy + ih;
        }

        if (canAgg) {
            c.FillRect(mx + app.Scale(8), iy + sepH / 2, mw - app.Scale(16), 1, t.divider);
            iy = iy + sepH;
            int curAgg = 0;
            if (col < st.aggMode.Count) { curAgg = st.aggMode[col]; }
            iy = DataTable.AggItem(app, mx, iy, mw, ih, st, col, 1, "合计  Sum", curAgg);
            iy = DataTable.AggItem(app, mx, iy, mw, ih, st, col, 2, "平均  Average", curAgg);
            iy = DataTable.AggItem(app, mx, iy, mw, ih, st, col, 3, "最小  Min", curAgg);
            iy = DataTable.AggItem(app, mx, iy, mw, ih, st, col, 4, "最大  Max", curAgg);
            iy = DataTable.AggItem(app, mx, iy, mw, ih, st, col, 5, "计数  Count", curAgg);
            iy = DataTable.AggItem(app, mx, iy, mw, ih, st, col, 0, "无汇总  No Total", curAgg);
        }

        if (canFilter) {
            c.FillRect(mx + app.Scale(8), iy + sepH / 2, mw - app.Scale(16), 1, t.divider);
            iy = iy + sepH;
            DataTable.CtxItem(app, mx, iy, mw, ih, "筛选…  Filter", "");
            if (DataTable.CtxHit(app, mx, iy, mw, ih)) {
                st.openMenu = col;
                st.filterTab = 0;
                st.searchText = "";
                st.valScroll = 0;
                st.editFocus = 0;
                st.batchLines = new List<string>();
                st.batchLines.Add("");
                st.batchExactFlag = 0;
                st.menuVals = DataTable.DistinctFiltered(st, src, col);
                st.menuMatched = st.menuVals;
                st.menuSearchCache = "";
                st.hdrCtxOpen = false; app.RequestRedraw();
            }
            iy = iy + ih;
        }

        // click outside closes the menu
        if (app.window.EventKind() == 3
            && !(app.mouseX >= mx && app.mouseX < mx + mw && app.mouseY >= my && app.mouseY < my + mh)) {
            st.hdrCtxOpen = false;
            app.RequestRedraw();
        }
    }

    // ---------- tabbed filter popup (DevExpress-style) ----------

    /// The open inline editor, drawn over its cell. Text and spinner editors are
    /// a box with a caret; dropdown and calendar editors add a popup below (or
    /// above, when the cell sits near the bottom of the window). A failed
    /// validation shows its message in place of the popup.
    static void RenderEditor(App app, List<DataColumn> cols, DataSource src,
                             DataTableState st, int edX, int edY, int edW, int edH) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        DataColumn col = cols[st.editCol];
        int epad = t.paddingSmall;
        int efs = t.fontSizeMedium;
        int etY = edY + (edH - Canvas.FontHeight(efs)) / 2;

        // A rejected value gets a danger border, so the error is visible even
        // when the message itself is clipped by the window edge.
        int bord = t.borderFocus;
        if (st.editError.Length > 0) { bord = t.error; }

        // Reserve room for the affordance the editor owns: spinner steppers, or
        // the dropdown / calendar toggle.
        int btnW = 0;
        if (col.editorKind == 3) { btnW = app.Scale(34); }
        else if (col.editorKind == 1 || col.editorKind == 2) { btnW = app.Scale(20); }
        int textW = edW - btnW;
        if (textW < app.Scale(24)) { textW = app.Scale(24); }

        c.FillRect(edX, edY, edW, edH, t.bgPrimary);
        c.DrawRect(edX, edY, edW, edH, bord, 2);
        c.PushClip(edX + epad, edY, textW - epad * 2, edH);
        c.DrawText(edX + epad, etY, st.editBuf, t.textPrimary, efs);
        int ecaretX = edX + epad + Canvas.MeasureText(Text.Left(st.editBuf, st.editCur), efs);
        c.FillRect(ecaretX, etY, 1, Canvas.FontHeight(efs), t.primary);
        c.PopClip();
        app.SetImeCaret(ecaretX, etY + Canvas.FontHeight(efs));

        if (col.editorKind == 3) {
            // Two half-height steppers, matching a native spin box.
            int sw = app.Scale(16);
            int sx = edX + edW - sw - app.Scale(3);
            int hh = (edH - app.Scale(6)) / 2;
            int sy = edY + app.Scale(3);
            if (DataTable.IconBtn(app, sx, sy, sw, hh, "chevron-up", false)) {
                st.editBuf = DataTable.StepValue(col, st.editBuf, 1);
                st.editCur = st.editBuf.Length;
                st.editError = "";
                app.RequestRedraw();
            }
            if (DataTable.IconBtn(app, sx, sy + hh, sw, hh, "chevron-down", false)) {
                st.editBuf = DataTable.StepValue(col, st.editBuf, -1);
                st.editCur = st.editBuf.Length;
                st.editError = "";
                app.RequestRedraw();
            }
        } else if (col.editorKind == 1 || col.editorKind == 2) {
            int sw = app.Scale(18);
            string ico = "chevron-down";
            if (col.editorKind == 2) { ico = "calendar"; }
            if (DataTable.IconBtn(app, edX + edW - sw - app.Scale(2),
                                  edY + (edH - sw) / 2, sw, sw, ico, st.edPopOpen)) {
                st.edPopOpen = !st.edPopOpen;
                app.RequestRedraw();
            }
        }

        // ---- popup / error, placed below the cell unless that would fall off
        // the bottom of the window ----
        int popW = edW;
        int popH = 0;
        if (st.editError.Length > 0) {
            popH = app.Scale(24);
            int mw = Canvas.MeasureText(st.editError, t.fontSizeSmall) + app.Scale(16);
            if (mw > popW) { popW = mw; }
        } else if (st.edPopOpen && col.editorKind == 1) {
            int itemH = app.Scale(24);
            int n = st.edPopItems.Count;
            if (n > 8) { n = 8; }
            if (n < 1) { n = 1; }
            popH = n * itemH + app.Scale(8);
            if (popW < app.Scale(120)) { popW = app.Scale(120); }
        } else if (st.edPopOpen && col.editorKind == 2) {
            popW = app.Scale(224);
            popH = app.Scale(230);
        }
        if (popH == 0) { return; }

        int popX = edX;
        int popY = edY + edH;
        if (popX + popW > c.Width()) { popX = c.Width() - popW - app.Scale(4); }
        if (popX < app.Scale(2)) { popX = app.Scale(2); }
        if (popY + popH > c.Height()) { popY = edY - popH; }
        if (popY < app.titlebarH) { popY = app.titlebarH; }

        c.FillRoundRect(popX + app.Scale(2), popY + app.Scale(3), popW, popH,
                        t.borderRadiusSmall, t.overlay);
        c.FillRoundRect(popX, popY, popW, popH, t.borderRadiusSmall, t.bgPrimary);

        if (st.editError.Length > 0) {
            c.DrawRect(popX, popY, popW, popH, t.error, 1);
            c.DrawText(popX + app.Scale(8),
                       popY + (popH - Canvas.FontHeight(t.fontSizeSmall)) / 2,
                       st.editError, t.error, t.fontSizeSmall);
            return;
        }

        c.DrawRect(popX, popY, popW, popH, t.borderPrimary, 1);
        app.CaptureWheel(popX, popY, popW, popH);
        app.BlockHitsRect(popX, popY, popW, popH);
        // The popup draws before the body reads the pointer, so flag the overlap
        // for the press handler: without this a click on a list item would also
        // land on the cell underneath, committing and closing the editor before
        // the item could be picked.
        if (app.mouseX >= popX && app.mouseX < popX + popW
            && app.mouseY >= popY && app.mouseY < popY + popH) {
            st.edPopHot = true;
        }
        if (col.editorKind == 1) {
            DataTable.RenderChoiceList(app, col, st, popX, popY, popW, popH);
        } else {
            DataTable.RenderCalendar(app, col, st, popX, popY, popW, popH);
        }
    }

    /// The dropdown list: up to 8 visible rows out of the filtered choices.
    static void RenderChoiceList(App app, DataColumn col, DataTableState st,
                                 int px, int py, int pw, int ph) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int fs = t.fontSizeSmall;
        int itemH = app.Scale(24);
        int pad = app.Scale(4);
        int vis = (ph - pad * 2) / itemH;
        if (vis < 1) { vis = 1; }

        if (st.edPopItems.Count == 0) {
            c.DrawText(px + app.Scale(8), py + pad + (itemH - Canvas.FontHeight(fs)) / 2,
                       "No match", t.textTertiary, fs);
            return;
        }

        // Keep the highlight on screen after keyboard movement.
        int selAt = -1;
        int q = 0;
        while (q < st.edPopItems.Count) {
            if (st.edPopItems[q] == st.edPopSel) { selAt = q; q = st.edPopItems.Count; }
            else { q = q + 1; }
        }
        if (selAt >= 0) {
            if (selAt < st.edPopScroll) { st.edPopScroll = selAt; }
            if (selAt >= st.edPopScroll + vis) { st.edPopScroll = selAt - vis + 1; }
        }
        int maxScroll = st.edPopItems.Count - vis;
        if (maxScroll < 0) { maxScroll = 0; }
        if (st.edPopScroll > maxScroll) { st.edPopScroll = maxScroll; }
        if (st.edPopScroll < 0) { st.edPopScroll = 0; }

        // Wheel over the list scrolls it (delta arrives as the key code on a
        // kind-13 event, per the convention the table body already uses).
        if (app.window.EventKind() == 13 && maxScroll > 0
            && app.mouseX >= px && app.mouseX < px + pw
            && app.mouseY >= py && app.mouseY < py + ph) {
            int delta = app.window.EventKeyCode();
            int step = delta / 120;
            if (step == 0) { if (delta > 0) { step = 1; } else if (delta < 0) { step = 0 - 1; } }
            st.edPopScroll = st.edPopScroll - step;
            if (st.edPopScroll > maxScroll) { st.edPopScroll = maxScroll; }
            if (st.edPopScroll < 0) { st.edPopScroll = 0; }
            app.RequestRedraw();
        }

        int i = 0;
        while (i < vis && st.edPopScroll + i < st.edPopItems.Count) {
            int ci = st.edPopItems[st.edPopScroll + i];
            int iy = py + pad + i * itemH;
            int id = app.focus.AllocId();
            bool hov = app.focus.IsHovered(id);
            if (ci == st.edPopSel) { c.FillRect(px + pad, iy, pw - pad * 2, itemH, t.bgActive); }
            else if (hov) { c.FillRect(px + pad, iy, pw - pad * 2, itemH, t.bgHover); }
            c.DrawText(px + app.Scale(8), iy + (itemH - Canvas.FontHeight(fs)) / 2,
                       DataTable.Truncate(col.choices[ci], fs, pw - app.Scale(16)),
                       t.textPrimary, fs);
            app.hitTester.Register(HitRegion.Create(id, px + pad, iy, pw - pad * 2, itemH, 0));
            if (app.window.EventKind() == 3 && app.hitTester.HitTest(app.mouseX, app.mouseY) == id) {
                st.editBuf = col.choices[ci];
                st.editCur = st.editBuf.Length;
                st.edPopSel = ci;
                st.editError = "";
                app.RequestRedraw();
            }
            i = i + 1;
        }
    }

    /// A month grid. Clicking a day writes it back through the column's own date
    /// format, so the stored text keeps whatever shape the column declares.
    static void RenderCalendar(App app, DataColumn col, DataTableState st,
                               int px, int py, int pw, int ph) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int fs = t.fontSizeSmall;
        int pad = app.Scale(8);
        int hdrH = app.Scale(26);
        int cw = (pw - pad * 2) / 7;
        int chh = app.Scale(24);

        // header: month name with prev/next steppers
        int y = DataTable.YmYear(st.edCalMonth);
        int m = DataTable.YmMonth(st.edCalMonth);
        if (DataTable.IconBtn(app, px + pad, py + app.Scale(3), app.Scale(22), hdrH,
                              "chevron-left", false)) {
            st.edCalMonth = st.edCalMonth - 1;
            app.RequestRedraw();
        }
        if (DataTable.IconBtn(app, px + pw - pad - app.Scale(22), py + app.Scale(3),
                              app.Scale(22), hdrH, "chevron-right", false)) {
            st.edCalMonth = st.edCalMonth + 1;
            app.RequestRedraw();
        }
        c.DrawTextCentered(px + pad + app.Scale(24), py + app.Scale(3),
                           pw - pad * 2 - app.Scale(48), hdrH,
                           DataTable.MonthAbbr(m) + " " + Convert.ToString(y),
                           t.textPrimary, t.fontSizeMedium);

        // weekday captions
        List<string> dows = new List<string>();
        dows.Add("Su"); dows.Add("Mo"); dows.Add("Tu"); dows.Add("We");
        dows.Add("Th"); dows.Add("Fr"); dows.Add("Sa");
        int dy = py + app.Scale(3) + hdrH;
        int di = 0;
        while (di < 7) {
            c.DrawTextCentered(px + pad + di * cw, dy, cw, app.Scale(18),
                               dows[di], t.textTertiary, t.fontSizeSmall);
            di = di + 1;
        }

        int gridY = dy + app.Scale(18);
        List<int> cells = DataTable.MonthCells(st.edCalMonth);
        int today = DataTable.Today();
        int i = 0;
        while (i < 42) {
            int day = cells[i];
            if (day > 0) {
                int gx = px + pad + (i % 7) * cw;
                int gy = gridY + (i / 7) * chh;
                int dnum = DateTime.DaysFromCivil(y, m, day);
                int id = app.focus.AllocId();
                bool hov = app.focus.IsHovered(id);
                int fg = t.textPrimary;
                if (dnum == st.edPopSel) {
                    c.FillRoundRect(gx + app.Scale(2), gy + app.Scale(1),
                                    cw - app.Scale(4), chh - app.Scale(2),
                                    t.borderRadiusSmall, t.primary);
                    fg = t.textInverse;
                } else if (hov) {
                    c.FillRoundRect(gx + app.Scale(2), gy + app.Scale(1),
                                    cw - app.Scale(4), chh - app.Scale(2),
                                    t.borderRadiusSmall, t.bgHover);
                } else if (dnum == today) {
                    c.DrawRect(gx + app.Scale(2), gy + app.Scale(1),
                               cw - app.Scale(4), chh - app.Scale(2), t.primary, 1);
                }
                c.DrawTextCentered(gx, gy, cw, chh, Convert.ToString(day), fg, fs);
                app.hitTester.Register(HitRegion.Create(id, gx, gy, cw, chh, 0));
                if (app.window.EventKind() == 3 && app.hitTester.HitTest(app.mouseX, app.mouseY) == id) {
                    st.edPopSel = dnum;
                    st.editBuf = DataTable.FormatDate(dnum, DataTable.DateStoreFormat(col));
                    st.editCur = st.editBuf.Length;
                    st.editError = "";
                    app.RequestRedraw();
                }
            }
            i = i + 1;
        }
    }

    static bool TabBtn(App app, int bx, int by, int bw, int bh, string label, bool active) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int id = app.focus.AllocId();
        bool hov = app.focus.IsHovered(id);
        if (active) { c.FillRect(bx, by, bw, bh, t.bgActive); }
        else if (hov) { c.FillRect(bx, by, bw, bh, t.bgHover); }
        int fg = t.textSecondary;
        if (active) { fg = t.primary; }
        c.DrawTextCentered(bx, by, bw, bh, label, fg, t.fontSizeSmall);
        if (active) { c.FillRect(bx, by + bh - app.Scale(2), bw, app.Scale(2), t.primary); }
        app.hitTester.Register(HitRegion.Create(id, bx, by, bw, bh, 0));
        return app.window.EventKind() == 3 && app.hitTester.HitTest(app.mouseX, app.mouseY) == id;
    }

    static bool IconBtn(App app, int bx, int by, int bw, int bh, string icon, bool active) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int id = app.focus.AllocId();
        bool hov = app.focus.IsHovered(id);
        int col = t.textSecondary;
        if (active) { c.FillRoundRect(bx, by, bw, bh, t.borderRadiusSmall, t.bgActive); col = t.primary; }
        else if (hov) { c.FillRoundRect(bx, by, bw, bh, t.borderRadiusSmall, t.bgHover); }
        Icon.DrawCenteredIn(c, icon, bx, by, bw, bh, app.Scale(13), col);
        app.hitTester.Register(HitRegion.Create(id, bx, by, bw, bh, 0));
        return app.window.EventKind() == 3 && app.hitTester.HitTest(app.mouseX, app.mouseY) == id;
    }

    static bool TextBtn(App app, int bx, int by, int bw, int bh, string label, bool primary) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int id = app.focus.AllocId();
        bool hov = app.focus.IsHovered(id);
        int bg = t.bgSecondary;
        int fg = t.textPrimary;
        if (primary) { bg = t.primary; fg = t.textInverse; }
        else if (hov) { bg = t.bgHover; }
        c.FillRoundRect(bx, by, bw, bh, t.borderRadiusSmall, bg);
        if (!primary) { c.DrawRect(bx, by, bw, bh, t.borderPrimary, 1); }
        c.DrawTextCentered(bx, by, bw, bh, label, fg, t.fontSizeSmall);
        app.hitTester.Register(HitRegion.Create(id, bx, by, bw, bh, 0));
        return app.window.EventKind() == 3 && app.hitTester.HitTest(app.mouseX, app.mouseY) == id;
    }

    static void EditBox(App app, int bx, int by, int bw, int bh, string text, string ph, bool focused) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int fs = t.fontSizeSmall;
        int bc = t.borderPrimary;
        if (focused) { bc = t.borderFocus; }
        c.FillRoundRect(bx, by, bw, bh, t.borderRadiusSmall, t.bgPrimary);
        c.DrawRect(bx, by, bw, bh, bc, 1);
        int tpad = app.Scale(6);
        int ty = by + (bh - Canvas.FontHeight(fs)) / 2;
        string shown = DataTable.Truncate(text, fs, bw - tpad * 2);
        if (text.Length == 0) {
            c.DrawText(bx + tpad, ty, ph, t.textTertiary, fs);
        } else {
            c.DrawText(bx + tpad, ty, shown, t.textPrimary, fs);
        }
        if (focused) {
            int cxp = bx + tpad + Canvas.MeasureText(shown, fs);
            if (cxp > bx + bw - tpad) { cxp = bx + bw - tpad; }
            c.FillRect(cxp, ty, app.Scale(1), Canvas.FontHeight(fs), t.primary);
        }
    }

    /// Handle one key-down for the cell cursor. Returns true when the key was
    /// consumed, so the caller can stop it reaching scroll/selection handling.
    ///
    /// Movement works in display slots (so group headers are stepped over) and
    /// in visible-column positions (so hidden and reordered columns behave).
    /// Shift extends the range from its anchor; Ctrl jumps to the edge.
    static bool HandleNavKey(App app, List<DataColumn> cols, DataSource src,
                             DataTableState st, List<int> vorder, int visRows,
                             int dataViewW, int pinnedW, int kc, int emods) {
        if (vorder.Count == 0) { return false; }
        bool shift = Modifiers.HasShift(emods);
        bool ctrl = Modifiers.HasCtrl(emods);

        // ---- clipboard / selection shortcuts ----
        if (ctrl && kc == 67) {                     // Ctrl+C
            Clipboard.SetText(DataTable.CopyText(st, cols, src));
            DataTable.Flash(st, "已复制到剪贴板");
            return true;
        }
        if (ctrl && kc == 88) {                     // Ctrl+X: copy, then blank
            Clipboard.SetText(DataTable.CopyText(st, cols, src));
            int cut = DataTable.ClearRangeCells(st, cols, src);
            if (cut > 0) { DataTable.Flash(st, "已剪切 " + Convert.ToString(cut) + " 个单元格"); }
            else { DataTable.Flash(st, "已复制到剪贴板"); }
            return true;
        }
        if (ctrl && kc == 86) {                     // Ctrl+V
            int n = DataTable.PasteText(st, cols, src, Clipboard.GetText());
            if (n > 0) { DataTable.Flash(st, "已粘贴 " + Convert.ToString(n) + " 个单元格"); }
            else { DataTable.Flash(st, "无可粘贴的可编辑单元格"); }
            return true;
        }
        if (ctrl && kc == 65) {                     // Ctrl+A: whole grid
            DataTable.SelectAllRows(st, true);
            int firstSlot = DataTable.FirstDataSlot(st);
            int lastSlot = DataTable.LastDataSlot(st);
            if (firstSlot >= 0) {
                st.rangeR0 = firstSlot;
                st.rangeR1 = lastSlot;
                st.rangeC0 = vorder[0];
                st.rangeC1 = vorder[vorder.Count - 1];
            }
            st.SelectionChanged.Raise();
            return true;
        }
        if (ctrl && kc == 90) {                     // Ctrl+Z
            if (DataTable.Undo(st, cols, src)) {
                DataTable.Recompute(st, cols, src);
                DataTable.Flash(st, "已撤销");
            } else {
                DataTable.Flash(st, "没有可撤销的操作");
            }
            return true;
        }
        // Ctrl+Delete removes whole rows; plain Delete only blanks cells. The
        // destructive one is deliberately the harder chord to hit by accident.
        if (ctrl && kc == 46) {
            int killed = DataTable.DeleteSelectedRows(st, cols, src);
            if (killed == 0 && st.hitRow >= 0) {
                if (DataTable.DeleteRow(st, cols, src, st.hitRow)) { killed = 1; }
            }
            if (killed > 0) {
                DataTable.Recompute(st, cols, src);
                DataTable.Flash(st, "已删除 " + Convert.ToString(killed) + " 行（Ctrl+Z 撤销）");
            } else {
                DataTable.Flash(st, "该数据源不支持删除行");
            }
            return true;
        }
        if (ctrl && kc == 45) {                     // Ctrl+Insert appends a row
            int nr = DataTable.AppendRow(st, cols, src);
            if (nr >= 0) {
                DataTable.Recompute(st, cols, src);
                DataTable.FocusRow(st, cols, src, nr);
            } else {
                DataTable.Flash(st, "该数据源不支持添加行");
            }
            return true;
        }
        if (kc == 46 && !ctrl) {                    // Delete blanks the range
            return DataTable.ClearRangeCells(st, cols, src) > 0;
        }
        if (kc == 32 && st.hitRow >= 0) {           // Space checks the row
            st.selected[st.hitRow] = !st.selected[st.hitRow];
            st.SelectionChanged.Raise();
            return true;
        }

        if (!DataTable.IsNavKey(kc)) { return false; }
        // A navigation key is claimed even when the cursor is already at the
        // edge, so an arrow can't fall through and scroll the page instead.
        List<int> tgt = DataTable.NavTarget(st, vorder, visRows, kc, emods);
        int newSlot = tgt[0];
        int newCol = tgt[1];
        if (newSlot < 0 || newCol < 0) { return true; }
        // Tab commits like a form field, so it always collapses the range even
        // when Shift is held (Shift+Tab means "backwards", not "extend").
        bool extend = shift && kc != 9;
        if (!DataTable.MoveCursor(st, newSlot, newCol, extend)) { return true; }
        DataTable.ScrollSlotIntoView(st, newSlot, visRows);
        DataTable.ScrollColIntoView(st, vorder, newCol, dataViewW, pinnedW);
        st.CellClick.Raise();
        return true;
    }

    /// A small pill that reads as selected when `on`. Used for the rule chips,
    /// which are radio-like: clicking the active one turns the rule off.
    static bool Chip(App app, int bx, int by, int bw, int bh, string label, bool on) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int id = app.focus.AllocId();
        bool hov = app.focus.IsHovered(id);
        int bg = t.bgSecondary;
        int fg = t.textSecondary;
        if (on) { bg = t.primary; fg = t.textInverse; }
        else if (hov) { bg = t.bgHover; }
        c.FillRoundRect(bx, by, bw, bh, bh / 2, bg);
        if (!on) { c.DrawRect(bx, by, bw, bh, t.borderPrimary, 1); }
        c.DrawTextCentered(bx, by, bw, bh, label, fg, t.fontSizeSmall);
        app.hitTester.Register(HitRegion.Create(id, bx, by, bw, bh, 0));
        return app.window.EventKind() == 3 && app.hitTester.HitTest(app.mouseX, app.mouseY) == id;
    }

    /// The "Rules" filter tab: value comparison, relative date presets (date
    /// columns only) and top-N. Returns the y below the content it drew.
    // Height RenderRulesTab will occupy for this filter/column pair. Kept
    // beside the renderer so the two stay in step: every `cy` advance there has
    // a matching term here, including the sections that only appear for date
    // columns or once a counted top/bottom mode is picked.
    static int RulesTabHeight(App app, ColFilter f, DataColumn col) {
        int chipH = app.Scale(22);
        int gap = app.Scale(4);
        int boxH = app.Scale(26);
        int lblH = Canvas.FontHeight(app.theme.fontSizeSmall) + app.Scale(4);

        int h = lblH;                            // "Compare"
        h = h + (chipH + gap) * 2;               // eight operator chips
        h = h + chipH + app.Scale(6);            // is empty / not empty
        if (f.cmpMode != 0 && f.cmpMode != 9 && f.cmpMode != 10) {
            h = h + boxH + app.Scale(4);         // one or two operand boxes
        }
        h = h + app.Scale(6);
        if (col.isDate) {
            h = h + lblH + (chipH + gap) * 4 + app.Scale(6);
        }
        h = h + lblH;                            // "Top / bottom"
        h = h + (chipH + gap) * 2;               // six top/bottom chips
        if (f.topMode >= 1 && f.topMode <= 4) { h = h + boxH; }
        return h;
    }

    static int RenderRulesTab(App app, int mx, int cy, int menuW, int pad,
                              ColFilter f, DataColumn col, DataTableState st) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int fs = t.fontSizeSmall;
        int chipH = app.Scale(22);
        int gap = app.Scale(4);
        int innerW = menuW - pad * 2;

        // ---- comparison ----
        c.DrawText(mx + pad, cy, "Compare", t.textSecondary, fs);
        cy = cy + Canvas.FontHeight(fs) + app.Scale(4);

        // two rows of four operators; a chip toggles its own mode off again
        int cw4 = (innerW - gap * 3) / 4;
        List<string> ops = new List<string>();
        ops.Add(">"); ops.Add(">="); ops.Add("<"); ops.Add("<=");
        ops.Add("="); ops.Add("<>"); ops.Add("in"); ops.Add("not in");
        int oi = 0;
        while (oi < ops.Count) {
            int mode = oi + 1;
            int bx = mx + pad + (cw4 + gap) * (oi % 4);
            int by = cy + (chipH + gap) * (oi / 4);
            if (DataTable.Chip(app, bx, by, cw4, chipH, ops[oi], f.cmpMode == mode)) {
                if (f.cmpMode == mode) { f.cmpMode = 0; } else { f.cmpMode = mode; }
                st.editFocus = 4;
                st.dirty = true;
                st.FilterChanged.Raise();
                app.RequestRedraw();
            }
            oi = oi + 1;
        }
        cy = cy + (chipH + gap) * 2;

        // the two blank-ness rules take a wider chip since they need no operand
        int cw2 = (innerW - gap) / 2;
        if (DataTable.Chip(app, mx + pad, cy, cw2, chipH, "is empty", f.cmpMode == 9)) {
            if (f.cmpMode == 9) { f.cmpMode = 0; } else { f.cmpMode = 9; st.editFocus = 0; }
            st.dirty = true; st.FilterChanged.Raise(); app.RequestRedraw();
        }
        if (DataTable.Chip(app, mx + pad + cw2 + gap, cy, cw2, chipH, "not empty", f.cmpMode == 10)) {
            if (f.cmpMode == 10) { f.cmpMode = 0; } else { f.cmpMode = 10; st.editFocus = 0; }
            st.dirty = true; st.FilterChanged.Raise(); app.RequestRedraw();
        }
        cy = cy + chipH + app.Scale(6);

        // operand boxes: one for the one-sided operators, two for in/not in.
        // The blank-ness rules need none, so they get no boxes at all.
        bool twoSided = f.cmpMode == 7 || f.cmpMode == 8;
        bool needsA = f.cmpMode != 0 && f.cmpMode != 9 && f.cmpMode != 10;
        int boxH = app.Scale(26);
        if (needsA) {
            int aw = innerW;
            if (twoSided) { aw = (innerW - gap) / 2; }
            DataTable.EditBox(app, mx + pad, cy, aw, boxH, f.cmpA, "value", st.editFocus == 4);
            int aId = app.focus.AllocId();
            app.hitTester.Register(HitRegion.Create(aId, mx + pad, cy, aw, boxH, 0));
            if (app.window.EventKind() == 3 && app.hitTester.HitTest(app.mouseX, app.mouseY) == aId) {
                st.editFocus = 4; app.RequestRedraw();
            }
            if (twoSided) {
                int bx2 = mx + pad + aw + gap;
                DataTable.EditBox(app, bx2, cy, aw, boxH, f.cmpB, "and", st.editFocus == 5);
                int bId = app.focus.AllocId();
                app.hitTester.Register(HitRegion.Create(bId, bx2, cy, aw, boxH, 0));
                if (app.window.EventKind() == 3 && app.hitTester.HitTest(app.mouseX, app.mouseY) == bId) {
                    st.editFocus = 5; app.RequestRedraw();
                }
            }
            cy = cy + boxH + app.Scale(4);
        }
        cy = cy + app.Scale(6);

        // ---- date presets (date columns only) ----
        if (col.isDate) {
            c.DrawText(mx + pad, cy, "Date range", t.textSecondary, fs);
            cy = cy + Canvas.FontHeight(fs) + app.Scale(4);
            List<string> ps = new List<string>();
            ps.Add("Today"); ps.Add("Yesterday"); ps.Add("This week");
            ps.Add("Last 7d"); ps.Add("This month"); ps.Add("Last 30d");
            ps.Add("Quarter"); ps.Add("This year"); ps.Add("YTD");
            ps.Add("Past"); ps.Add("Future");
            int cw3 = (innerW - gap * 2) / 3;
            int pi = 0;
            while (pi < ps.Count) {
                int preset = pi + 1;
                int bx = mx + pad + (cw3 + gap) * (pi % 3);
                int by = cy + (chipH + gap) * (pi / 3);
                if (DataTable.Chip(app, bx, by, cw3, chipH, ps[pi], f.datePreset == preset)) {
                    if (f.datePreset == preset) { f.datePreset = 0; } else { f.datePreset = preset; }
                    st.dirty = true; st.FilterChanged.Raise(); app.RequestRedraw();
                }
                pi = pi + 1;
            }
            cy = cy + (chipH + gap) * 4 + app.Scale(6);
        }

        // ---- top-N ----
        c.DrawText(mx + pad, cy, "Top / bottom", t.textSecondary, fs);
        cy = cy + Canvas.FontHeight(fs) + app.Scale(4);
        List<string> tops = new List<string>();
        tops.Add("Top N"); tops.Add("Bottom N"); tops.Add("Top N%");
        tops.Add("Bot N%"); tops.Add("Above avg"); tops.Add("Below avg");
        int cw3b = (innerW - gap * 2) / 3;
        int ti = 0;
        while (ti < tops.Count) {
            int mode = ti + 1;
            int bx = mx + pad + (cw3b + gap) * (ti % 3);
            int by = cy + (chipH + gap) * (ti / 3);
            if (DataTable.Chip(app, bx, by, cw3b, chipH, tops[ti], f.topMode == mode)) {
                if (f.topMode == mode) { f.topMode = 0; } else { f.topMode = mode; }
                st.dirty = true; st.FilterChanged.Raise(); app.RequestRedraw();
            }
            ti = ti + 1;
        }
        cy = cy + (chipH + gap) * 2;

        // N only matters for the four counted modes
        if (f.topMode >= 1 && f.topMode <= 4) {
            int lw = app.Scale(20);
            c.DrawText(mx + pad, cy + (boxH - Canvas.FontHeight(fs)) / 2, "N", t.textSecondary, fs);
            int nx = mx + pad + lw;
            int nw = app.Scale(64);
            DataTable.EditBox(app, nx, cy, nw, boxH, Convert.ToString(f.topN), "10", st.editFocus == 6);
            int nId = app.focus.AllocId();
            app.hitTester.Register(HitRegion.Create(nId, nx, cy, nw, boxH, 0));
            if (app.window.EventKind() == 3 && app.hitTester.HitTest(app.mouseX, app.mouseY) == nId) {
                st.editFocus = 6; app.RequestRedraw();
            }
            int spw = app.Scale(24);
            if (DataTable.TextBtn(app, nx + nw + gap, cy, spw, boxH, "-", false)) {
                if (f.topN > 1) { f.topN = f.topN - 1; st.dirty = true; st.FilterChanged.Raise(); }
                app.RequestRedraw();
            }
            if (DataTable.TextBtn(app, nx + nw + gap + spw + gap, cy, spw, boxH, "+", false)) {
                f.topN = f.topN + 1; st.dirty = true; st.FilterChanged.Raise(); app.RequestRedraw();
            }
            cy = cy + boxH;
        }
        return cy;
    }

    static void RenderMenu(App app, int x, int y, int viewW, int headerH, int numW, int selW,
                           List<DataColumn> cols, DataSource src, DataTableState st) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int mi = st.openMenu;
        ColFilter f = st.filters[mi];

        int pad = app.Scale(10);
        int fs = t.fontSizeSmall;
        int fsM = t.fontSizeMedium;
        int rowH = app.Scale(28);
        int menuW = app.Scale(256);
        int menuH = app.Scale(348);
        // The Rules tab stacks several sections of varying height, so its panel
        // is sized from the same layout math the tab itself uses rather than a
        // hand-tuned constant that would clip when the theme's metrics change.
        if (st.filterTab == 3) {
            menuH = app.Scale(8) + rowH + app.Scale(6)      // title row
                  + rowH + app.Scale(8)                      // tab strip
                  + DataTable.RulesTabHeight(app, f, cols[mi])
                  + app.Scale(40);                           // footer
        }

        // anchor under the column, clamp fully inside the window
        int mx = x + numW + selW - st.scrollX;
        int k = 0;
        while (k < mi) { mx = mx + st.dispW[k]; k = k + 1; }
        if (mx + menuW > x + viewW) { mx = x + viewW - menuW; }
        if (mx < x) { mx = x; }
        int my = y + headerH;
        int canH = c.Height();
        if (my + menuH > canH) { my = canH - menuH - app.Scale(6); }
        if (my < app.titlebarH) { my = app.titlebarH; }

        // claim the wheel over the popup so the page underneath doesn't scroll
        app.CaptureWheel(mx, my, menuW, menuH);
        // swallow clicks over the whole panel so empty areas don't fall through
        app.BlockHitsRect(mx, my, menuW, menuH);

        // route typed keys to the focused edit field
        if (app.window.EventKind() == 6 && st.editFocus != 0) {
            int chv = app.window.EventKeyCode();
            if (st.editFocus == 1) {
                if (chv == 8) { st.searchText = DataTable.Backspace(st.searchText); }
                else { string ad = Text.CharStr(chv); if (ad.Length > 0) { st.searchText = st.searchText + ad; } }
            } else if (st.editFocus == 2) {
                if (chv == 8) { f.textQuery = DataTable.Backspace(f.textQuery); }
                else { string ad = Text.CharStr(chv); if (ad.Length > 0) { f.textQuery = f.textQuery + ad; } }
                st.dirty = true;
                st.FilterChanged.Raise();
            } else if (st.editFocus == 3) {
                int last = st.batchLines.Count - 1;
                if (last < 0) { st.batchLines.Add(""); last = 0; }
                if (chv == 13) { st.batchLines.Add(""); }
                else if (chv == 8) {
                    string cur = st.batchLines[last];
                    if (cur.Length > 0) { st.batchLines[last] = DataTable.Backspace(cur); }
                    else if (last > 0) { st.batchLines.RemoveAt(last); }
                } else {
                    string ad = Text.CharStr(chv);
                    if (ad.Length > 0) { st.batchLines[last] = st.batchLines[last] + ad; }
                }
            } else if (st.editFocus == 4 || st.editFocus == 5) {
                // comparison operands: edited live, like the Text tab's query
                string cur = f.cmpA;
                if (st.editFocus == 5) { cur = f.cmpB; }
                if (chv == 8) { cur = DataTable.Backspace(cur); }
                else { string ad = Text.CharStr(chv); if (ad.Length > 0) { cur = cur + ad; } }
                if (st.editFocus == 5) { f.cmpB = cur; } else { f.cmpA = cur; }
                st.dirty = true;
                st.FilterChanged.Raise();
            } else if (st.editFocus == 6) {
                // top-N count: digits only, so the spinner value stays a number
                if (chv == 8) {
                    f.topN = f.topN / 10;
                } else if (chv >= 48 && chv <= 57 && f.topN < 100000) {
                    f.topN = f.topN * 10 + (chv - 48);
                }
                st.dirty = true;
                st.FilterChanged.Raise();
            }
            app.RequestRedraw();
        }

        // panel
        c.FillRoundRect(mx + app.Scale(2), my + app.Scale(3), menuW, menuH, t.borderRadiusMedium, t.overlay);
        c.FillRoundRect(mx, my, menuW, menuH, t.borderRadiusMedium, t.bgPrimary);
        c.DrawRect(mx, my, menuW, menuH, t.borderPrimary, 1);

        // header: title + sort asc/desc
        int hy = my + app.Scale(8);
        c.DrawText(mx + pad, hy + (rowH - Canvas.FontHeight(fsM)) / 2, cols[mi].title, t.textPrimary, fsM);
        int sbw = app.Scale(26);
        int sUpX = mx + menuW - pad - sbw * 2 - app.Scale(4);
        int sDnX = mx + menuW - pad - sbw;
        if (DataTable.IconBtn(app, sUpX, hy, sbw, rowH, "arrow-up", st.sortCol == mi && st.sortDir == 1)) {
            DataTable.SortBy(st, mi, 1); app.RequestRedraw();
        }
        if (DataTable.IconBtn(app, sDnX, hy, sbw, rowH, "arrow-down", st.sortCol == mi && st.sortDir == 2)) {
            DataTable.SortBy(st, mi, 2); app.RequestRedraw();
        }
        int cy = hy + rowH + app.Scale(6);

        // tabs
        int tabW = (menuW - pad * 2) / 4;
        if (DataTable.TabBtn(app, mx + pad, cy, tabW, rowH, "Values", st.filterTab == 0)) { st.filterTab = 0; st.editFocus = 0; app.RequestRedraw(); }
        if (DataTable.TabBtn(app, mx + pad + tabW, cy, tabW, rowH, "Text", st.filterTab == 1)) { st.filterTab = 1; st.editFocus = 0; app.RequestRedraw(); }
        if (DataTable.TabBtn(app, mx + pad + tabW * 2, cy, tabW, rowH, "Batch", st.filterTab == 2)) { st.filterTab = 2; st.editFocus = 0; app.RequestRedraw(); }
        if (DataTable.TabBtn(app, mx + pad + tabW * 3, cy, tabW, rowH, "Rules", st.filterTab == 3)) { st.filterTab = 3; st.editFocus = 0; app.RequestRedraw(); }
        c.FillRect(mx + pad, cy + rowH, menuW - pad * 2, 1, t.divider);
        cy = cy + rowH + app.Scale(8);

        int footerH = app.Scale(40);
        int contentBottom = my + menuH - footerH;

        if (st.filterTab == 0) {
            int boxH = app.Scale(26);
            DataTable.EditBox(app, mx + pad, cy, menuW - pad * 2, boxH, st.searchText, "Search values...", st.editFocus == 1);
            int sId = app.focus.AllocId();
            app.hitTester.Register(HitRegion.Create(sId, mx + pad, cy, menuW - pad * 2, boxH, 0));
            if (app.window.EventKind() == 3 && app.hitTester.HitTest(app.mouseX, app.mouseY) == sId) { st.editFocus = 1; app.RequestRedraw(); }
            cy = cy + boxH + app.Scale(6);

            int itemH = app.Scale(24);
            int allId = app.focus.AllocId();
            bool anyHidden = f.hidden.Count > 0;
            if (app.focus.IsHovered(allId)) { c.FillRect(mx + pad, cy, menuW - pad * 2, itemH, t.bgHover); }
            DataTable.DrawMiniCheck(app, mx + pad, cy, itemH, !anyHidden);
            c.DrawText(mx + pad + app.Scale(22), cy + (itemH - Canvas.FontHeight(fs)) / 2, "(Select All)", t.textPrimary, fs);
            app.hitTester.Register(HitRegion.Create(allId, mx + pad, cy, menuW - pad * 2, itemH, 0));
            if (app.window.EventKind() == 3 && app.hitTester.HitTest(app.mouseX, app.mouseY) == allId) {
                f.hidden.Clear();
                st.dirty = true; st.FilterChanged.Raise(); app.RequestRedraw();
            }
            cy = cy + itemH;

            // Rebuild the filtered value list only when the search text changes
            // (not every frame): a column can have thousands of distinct values,
            // so re-scanning + reallocating each frame would stutter. The list
            // is virtualised — only the visible window is drawn — so it stays
            // smooth no matter how many distinct values there are.
            if (!(st.searchText == st.menuSearchCache)) {
                st.menuMatched = new List<string>();
                int vi0 = 0;
                while (vi0 < st.menuVals.Count) {
                    if (DataTable.ContainsCI(st.menuVals[vi0], st.searchText)) { st.menuMatched.Add(st.menuVals[vi0]); }
                    vi0 = vi0 + 1;
                }
                st.menuSearchCache = st.searchText;
                st.valScroll = 0;
            }
            List<string> matched = st.menuMatched;

            int sbGW = app.Scale(10);
            int listX = mx + pad;
            int itemW = menuW - pad * 2 - sbGW;
            int listH = contentBottom - cy;
            int visN = listH / itemH;
            if (visN < 1) { visN = 1; }
            int maxScroll = matched.Count - visN;
            if (maxScroll < 0) { maxScroll = 0; }
            if (st.valScroll > maxScroll) { st.valScroll = maxScroll; }
            if (st.valScroll < 0) { st.valScroll = 0; }

            int listTop = cy;
            int r2 = 0;
            while (r2 < visN && (st.valScroll + r2) < matched.Count) {
                string v = matched[st.valScroll + r2];
                int vId = app.focus.AllocId();
                if (app.focus.IsHovered(vId)) { c.FillRect(listX, cy, itemW, itemH, t.bgHover); }
                bool visible = !f.IsHidden(v);
                DataTable.DrawMiniCheck(app, listX, cy, itemH, visible);
                string label = DataTable.Truncate(v, fs, itemW - app.Scale(26));
                c.DrawText(listX + app.Scale(22), cy + (itemH - Canvas.FontHeight(fs)) / 2, label, t.textPrimary, fs);
                app.hitTester.Register(HitRegion.Create(vId, listX, cy, itemW, itemH, 0));
                if (app.window.EventKind() == 3 && app.hitTester.HitTest(app.mouseX, app.mouseY) == vId) {
                    f.Toggle(v); st.dirty = true; st.FilterChanged.Raise(); app.RequestRedraw();
                }
                cy = cy + itemH;
                r2 = r2 + 1;
            }

            // draggable scrollbar for the virtualised value list
            if (matched.Count > visN) {
                int trackX = listX + itemW + app.Scale(3);
                int trackY = listTop;
                int trackH = visN * itemH;
                int sbW = app.Scale(6);
                int thumbH = trackH * visN / matched.Count;
                if (thumbH < app.Scale(20)) { thumbH = app.Scale(20); }
                int thumbY = trackY;
                if (maxScroll > 0) { thumbY = trackY + (trackH - thumbH) * st.valScroll / maxScroll; }
                int vsbId = app.focus.AllocId();
                int thumbColor = t.scrollbar;
                if (app.focus.IsHovered(vsbId) || app.focus.pressedId == vsbId) { thumbColor = t.scrollbarHover; }
                c.FillRoundRect(trackX, thumbY, sbW, thumbH, sbW / 2, thumbColor);
                app.hitTester.Register(HitRegion.Create(vsbId, trackX, trackY, sbW, trackH, 0));
                if (app.focus.pressedId == vsbId && maxScroll > 0) {
                    int rel = app.mouseY - trackY - thumbH / 2;
                    int denom = trackH - thumbH;
                    if (denom < 1) { denom = 1; }
                    int ns = rel * maxScroll / denom;
                    if (ns < 0) { ns = 0; }
                    if (ns > maxScroll) { ns = maxScroll; }
                    if (ns != st.valScroll) { st.valScroll = ns; app.RequestRedraw(); }
                }
            }
            if (app.window.EventKind() == 13) {
                bool inside = app.mouseX >= mx && app.mouseX < mx + menuW && app.mouseY >= my && app.mouseY < my + menuH;
                if (inside) {
                    int delta = app.window.EventKeyCode();
                    st.valScroll = st.valScroll - delta / 120;
                    if (st.valScroll > maxScroll) { st.valScroll = maxScroll; }
                    if (st.valScroll < 0) { st.valScroll = 0; }
                    app.RequestRedraw();
                }
            }
        } else if (st.filterTab == 1) {
            int chipW = (menuW - pad * 2 - app.Scale(9)) / 4;
            int chipH = app.Scale(24);
            int gap = app.Scale(3);
            if (DataTable.TabBtn(app, mx + pad, cy, chipW, chipH, "Contains", f.textMode == 1)) { f.textMode = 1; st.dirty = true; st.FilterChanged.Raise(); app.RequestRedraw(); }
            if (DataTable.TabBtn(app, mx + pad + (chipW + gap), cy, chipW, chipH, "Equals", f.textMode == 2)) { f.textMode = 2; st.dirty = true; st.FilterChanged.Raise(); app.RequestRedraw(); }
            if (DataTable.TabBtn(app, mx + pad + (chipW + gap) * 2, cy, chipW, chipH, "Starts", f.textMode == 3)) { f.textMode = 3; st.dirty = true; st.FilterChanged.Raise(); app.RequestRedraw(); }
            if (DataTable.TabBtn(app, mx + pad + (chipW + gap) * 3, cy, chipW, chipH, "Ends", f.textMode == 4)) { f.textMode = 4; st.dirty = true; st.FilterChanged.Raise(); app.RequestRedraw(); }
            cy = cy + chipH + app.Scale(8);

            int boxH = app.Scale(26);
            DataTable.EditBox(app, mx + pad, cy, menuW - pad * 2, boxH, f.textQuery, "Enter filter text...", st.editFocus == 2);
            int qId = app.focus.AllocId();
            app.hitTester.Register(HitRegion.Create(qId, mx + pad, cy, menuW - pad * 2, boxH, 0));
            if (app.window.EventKind() == 3 && app.hitTester.HitTest(app.mouseX, app.mouseY) == qId) { st.editFocus = 2; app.RequestRedraw(); }
            cy = cy + boxH + app.Scale(10);

            c.DrawText(mx + pad, cy, "Live-filters as you type", t.textTertiary, fs);
            cy = cy + Canvas.FontHeight(fs) + app.Scale(2);
            c.DrawText(mx + pad, cy, "(case-insensitive).", t.textTertiary, fs);
        } else if (st.filterTab == 3) {
            cy = DataTable.RenderRulesTab(app, mx, cy, menuW, pad, f, cols[mi], st);
        } else {
            c.DrawText(mx + pad, cy, "One condition per line:", t.textSecondary, fs);
            cy = cy + Canvas.FontHeight(fs) + app.Scale(4);
            int areaH = contentBottom - cy - app.Scale(66);
            if (areaH < app.Scale(48)) { areaH = app.Scale(48); }
            int aId = app.focus.AllocId();
            int abc = t.borderPrimary;
            if (st.editFocus == 3) { abc = t.borderFocus; }
            c.FillRoundRect(mx + pad, cy, menuW - pad * 2, areaH, t.borderRadiusSmall, t.bgPrimary);
            c.DrawRect(mx + pad, cy, menuW - pad * 2, areaH, abc, 1);
            app.hitTester.Register(HitRegion.Create(aId, mx + pad, cy, menuW - pad * 2, areaH, 0));
            if (app.window.EventKind() == 3 && app.hitTester.HitTest(app.mouseX, app.mouseY) == aId) { st.editFocus = 3; app.RequestRedraw(); }
            int lh = Canvas.FontHeight(fs) + app.Scale(3);
            int li = 0;
            int ly = cy + app.Scale(4);
            while (li < st.batchLines.Count && ly + lh < cy + areaH) {
                string ln = DataTable.Truncate(st.batchLines[li], fs, menuW - pad * 2 - app.Scale(10));
                c.DrawText(mx + pad + app.Scale(5), ly, ln, t.textPrimary, fs);
                if (st.editFocus == 3 && li == st.batchLines.Count - 1) {
                    int cxp = mx + pad + app.Scale(5) + Canvas.MeasureText(ln, fs);
                    c.FillRect(cxp, ly, app.Scale(1), Canvas.FontHeight(fs), t.primary);
                }
                ly = ly + lh;
                li = li + 1;
            }
            cy = cy + areaH + app.Scale(6);

            int exId = app.focus.AllocId();
            bool exact = st.batchExactFlag == 1;
            DataTable.DrawMiniCheck(app, mx + pad, cy, app.Scale(22), exact);
            c.DrawText(mx + pad + app.Scale(22), cy + (app.Scale(22) - Canvas.FontHeight(fs)) / 2, "Exact match", t.textPrimary, fs);
            app.hitTester.Register(HitRegion.Create(exId, mx + pad, cy, app.Scale(130), app.Scale(22), 0));
            if (app.window.EventKind() == 3 && app.hitTester.HitTest(app.mouseX, app.mouseY) == exId) {
                if (st.batchExactFlag == 1) { st.batchExactFlag = 0; } else { st.batchExactFlag = 1; }
                app.RequestRedraw();
            }
            cy = cy + app.Scale(28);

            int bw = (menuW - pad * 2 - app.Scale(6)) / 2;
            int bh = app.Scale(26);
            bool keepClick = DataTable.TextBtn(app, mx + pad, cy, bw, bh, "Keep matching", true);
            bool exclClick = DataTable.TextBtn(app, mx + pad + bw + app.Scale(6), cy, bw, bh, "Exclude", false);
            if (keepClick || exclClick) {
                f.batchTerms.Clear();
                int bl = 0;
                while (bl < st.batchLines.Count) {
                    if (st.batchLines[bl].Length > 0) { f.batchTerms.Add(st.batchLines[bl]); }
                    bl = bl + 1;
                }
                f.batchExact = st.batchExactFlag == 1;
                f.batchKeep = keepClick;
                st.dirty = true;
                st.FilterChanged.Raise();
                app.RequestRedraw();
            }
        }

        // footer: Clear / Close
        int fy = my + menuH - footerH + app.Scale(6);
        int fbw = (menuW - pad * 2 - app.Scale(6)) / 2;
        int fbh = app.Scale(28);
        c.FillRect(mx + pad, my + menuH - footerH, menuW - pad * 2, 1, t.divider);
        bool clearClick = DataTable.TextBtn(app, mx + pad, fy, fbw, fbh, "Clear Filter", false);
        bool closeClick = DataTable.TextBtn(app, mx + pad + fbw + app.Scale(6), fy, fbw, fbh, "Close", false);
        if (clearClick) {
            st.filters[mi] = ColFilter.Create();
            st.searchText = "";
            st.batchLines = new List<string>();
            st.batchLines.Add("");
            st.batchExactFlag = 0;
            st.editFocus = 0;
            st.dirty = true;
            st.FilterChanged.Raise();
            app.RequestRedraw();
        }
        if (closeClick) { st.openMenu = -1; app.RequestRedraw(); }

        // click outside closes the menu (and blurs the edit field)
        if (app.window.EventKind() == 3) {
            bool inside = app.mouseX >= mx && app.mouseX < mx + menuW && app.mouseY >= my && app.mouseY < my + menuH;
            bool onIcon = app.mouseY >= y && app.mouseY < y + headerH;
            if (!inside && !onIcon) { st.openMenu = -1; app.RequestRedraw(); }
        }
    }

    static void DrawMiniCheck(App app, int bx, int cy, int itemH, bool checked) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int box = app.Scale(15);
        int by = cy + (itemH - box) / 2;
        if (checked) {
            c.FillRoundRect(bx, by, box, box, t.borderRadiusSmall, t.primary);
            int ins = app.Scale(3);
            Icon.Draw(c, "check", bx + ins, by + ins, box - ins * 2, t.textInverse);
        } else {
            c.FillRoundRect(bx, by, box, box, t.borderRadiusSmall, t.bgPrimary);
            c.DrawRect(bx, by, box, box, t.borderPrimary, 1);
        }
    }
}
