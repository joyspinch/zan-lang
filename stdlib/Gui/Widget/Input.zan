using System;
using Gui;
using Gui.Component;
using Gui.Backend;
using Gui.Component.CodeEditor;

namespace Gui.Widget;

/// 带光标、占位符和响应式绑定的单行文本输入框。
///
/// 保留式 C# 风格控件：拥有稳定标识（因此焦点在
/// 兄弟/弹层变动后仍能保持），焦点/点击由框架解析，并
/// 暴露委托事件：
///     Input name = Input.Bind(model, "your name");
///     name.Change += () => { ... };   // 每次编辑时触发
///     name.Submit += () => { ... };   // 回车时触发
///     name.Render(app, x, y, w, h);
/// 获得焦点时消费键盘事件（可打印字符、Backspace、
/// Delete、Left/Right/Home/End），就地编辑绑定的 SignalString，并将
/// 光标位置上报给框架，使 IME 组合窗口
/// 跟随光标移动。
class Input : Control {
    SignalString model;
    /// 双向绑定文本：`name.data = user.name;` 使输入框与
    /// 模型双向保持同步（编译器降级的 Binding）。可选的；
    /// 未设置时，输入框仅编辑其内部 SignalString。
    Binding<string> data;
    string hint;
    int cursorPos;
    // 选区锚点（固定端；光标是移动端）：无选区时
    // 为 -1。鼠标按下 / Shift 移动时设置，
    // 任何普通光标移动或编辑时清除。
    int selAnchor;
    int wid;
    /// 密码掩码：设置后文本以 `*` 渲染，直到被明文显示。
    bool password;
    /// 掩码字段当前是否显示明文（通过眼睛图标切换）。
    bool reveal;
    /// 可选的前导 / 尾随图标名（Gui.Icon）。密码框
    /// 无论 `iconTrail` 如何都会在尾端绘制可点击的眼睛图标。
    string iconLead;
    string iconTrail;
    /// 文本每次变化时触发（C# 风格：`inp.Change += h;`）。
    UiEvent Change;
    /// 获得焦点时按下回车触发。
    UiEvent Submit;
    /// 校验错误信息；"" 表示有效。SetError 会绘制红色边框，并
    /// 在字段下方显示消息；任何编辑都会清除它。
    string errMsg;
    /// 尺寸变体：对应 Class = "small" / "large"（Naive UI size prop）。
    /// Binding<string> 使 `inp.Size = vm.density;` 可响应式换档，
    /// 属性面板（PropSpec.Enum + str 绑定）也能直接读写选项文本。
    Binding<string> Size;
    /// 可清空：文本非空且（获焦或悬停）时在尾端显示 X 按钮，
    /// 点击清空内容并触发 Change（Naive UI clearable prop）。
    bool Clearable;
    /// 聚焦时自动全选内容（Naive UI autoselect prop）。适合
    /// 地址栏、"搜索并跳转" 等点进来就整段替换的字段。
    bool Autoselect;
    /// 跟踪 autoselect 已执行过（防止每次获焦都全选）。
    bool autoselected;
    /// 输入字节上限（>0 生效）。Input 内部按 UTF-8 字节计游标，
    /// 因此这是字节长度而非字符数——一个 CJK 字符占 3 字节。
    /// 0 表示不限。
    int MaxLen;

    /// 立即模式工厂与保留模式构造函数共用的初始化函数：
    /// 设置 Control 基类（停靠顶部，使追加的输入框
    /// 自动贴齐），再设置输入框专属状态。
    void InitInput(SignalString sig, string hintText) {
        this.InitControl("input", 1);
        model = sig;
        hint = hintText;
        cursorPos = 0;
        selAnchor = -1;
        wid = WidgetId.Next();
        password = false;
        reveal = false;
        iconLead = "";
        errMsg = "";
        iconTrail = "";
        Size = "medium";
        Clearable = false;
        Autoselect = false;
        autoselected = false;
        wiresOwnEvents = true;
        Change = new UiEvent();
        Submit = new UiEvent();
    }

    /// Default design-time constructor; the form supplies `placeholder` later.
    Input() : this("") { }

    /// 保留模式构造函数：`Input name = new Input("Your name");`
    Input(string hintText) {
        InitInput(new SignalString(""), hintText);
    }

    static Input Bind(SignalString sig, string hintText) {
        Input inp = new Input(hintText);
        inp.model = sig;
        return inp;
    }

    /// 一个与 `s` 等长（按字节）的 `*` 字符串，使掩码显示保持
    /// 相同的字节布局，光标/选区计算仍然有效。
    static string Mask(string s) {
        string m = "";
        for (int i = 0; i < s.Length; i = i + 1) { m = m + "*"; }
        return m;
    }

    string GetText() { return model.Get(); }

    /// 宿主调整占位文字（SelectBox 的筛选框在 Filterable(true) 之后
    /// 才由 FilterHint 定文案，晚于构造）。
    void SetHint(string v) { hint = v; }

    /// Allows a host to move focus to this input programmatically
    /// (used for the inline rename box in a list).
    int WidgetId() { return wid; }

    void SetText(string v) {
        model.Set(v);
        cursorPos = v.Length;
        PushBinding();
    }

    /// 选中全部文本（等同于用户按 Ctrl+A），因此下一次输入
    /// 直接替换原内容。地址栏之类「点进来就是要换掉它」的
    /// 字段在 Focus 事件里调用它。
    void SelectAll() {
        selAnchor = 0;
        cursorPos = model.Get().Length;
    }

    /// 给字段标记校验错误；绘制红色边框，并显示
    /// `msg` 于字段下方，直到用户编辑（或调用 ClearError）。
    void SetError(string msg) {
        errMsg = msg;
    }

    /// 清除待处理的校验错误（任何编辑时自动调用）。
    void ClearError() {
        errMsg = "";
    }

    /// 把绑定的模型值拉入编辑缓冲区（model -> UI）。
    void SyncBinding() {
        if (data == null) { return; }
        string cur = data.Get();
        if (cur != model.Get()) {
            model.Set(cur);
            if (cursorPos > cur.Length) { cursorPos = cur.Length; }
        }
    }

    /// 把编辑缓冲区通过绑定写回模型（UI -> model）。
    void PushBinding() {
        if (data == null) { return; }
        data.Set(model.Get());
    }

    /// 所有 UI 编辑都汇入此处：先写回，再通知；同时清除
    /// 任何校验错误——修正正是问题已解决的最强信号。
    void Edited() {
        errMsg = "";
        PushBinding();
        Change.Raise();
    }

    void ClampCursor() {
        string txt = model.Get();
        if (cursorPos > txt.Length) { cursorPos = txt.Length; }
        if (cursorPos < 0) { cursorPos = 0; }
        if (selAnchor > txt.Length) { selAnchor = txt.Length; }
    }

    bool HasSel() { return selAnchor >= 0 && selAnchor != cursorPos; }
    int SelStart() { if (selAnchor >= 0 && selAnchor < cursorPos) { return selAnchor; } return cursorPos; }
    int SelEnd() { if (selAnchor > cursorPos) { return selAnchor; } return cursorPos; }

    string SelText() {
        if (!HasSel()) { return ""; }
        return model.Get().Substring(SelStart(), SelEnd() - SelStart());
    }

    /// 删除选中的范围，并把光标收拢到其起点。
    void DeleteSel() {
        if (!HasSel()) { return; }
        string txt = model.Get();
        int s = SelStart();
        int e = SelEnd();
        model.Set(txt.Substring(0, s) + txt.Substring(e, txt.Length - e));
        cursorPos = s;
        selAnchor = -1;
    }

    void HandleInput(App app) {
        ClampCursor();
        int kind = app.EventKind();
        string txt = model.Get();
        if (kind == 6) {
            int code = app.window.EventKeyCode();
            if (code == 8) {
                if (HasSel()) {
                    DeleteSel();
                    Edited();
                    app.RequestRedraw();
                } else if (cursorPos > 0) {
                    int start = Text.PrevCharStart(txt, cursorPos);
                    model.Set(Text.DeleteBefore(txt, cursorPos));
                    cursorPos = start;
                    Edited();
                    app.RequestRedraw();
                }
            } else if (code == 13) {
                Submit.Raise();
                app.RequestRedraw();
            } else if (code == 9) {
                // 忽略 Tab（由框架焦点遍历处理）
            } else {
                string ch = Text.CharStr(code);
                if (ch.Length > 0) {
                    if (HasSel()) { DeleteSel(); txt = model.Get(); }
                    // MaxLen 字节上限：放不下的插入直接忽略。
                    if (MaxLen <= 0 || txt.Length + ch.Length <= MaxLen) {
                        model.Set(Text.InsertAt(txt, cursorPos, ch));
                        cursorPos = cursorPos + ch.Length;
                        selAnchor = -1;
                        Edited();
                        app.RequestRedraw();
                    }
                }
            }
        } else if (kind == 4) {
            int kc = app.window.EventKeyCode();
            int mods = app.window.EventMods();
            bool shift = Modifiers.HasShift(mods);
            bool ctrl = Modifiers.HasCtrl(mods);
            if (ctrl && kc == 65) {
                // Ctrl+A：全选。
                selAnchor = 0;
                cursorPos = txt.Length;
                app.RequestRedraw();
            } else if (ctrl && kc == 67) {
                // Ctrl+C：复制选区（无选区时复制全文）。
                if (HasSel()) { Clipboard.SetText(SelText()); }
                else { Clipboard.SetText(txt); }
            } else if (ctrl && kc == 88) {
                // Ctrl+X：剪切。
                if (HasSel()) {
                    Clipboard.SetText(SelText());
                    DeleteSel();
                    Edited();
                    app.RequestRedraw();
                }
            } else if (ctrl && kc == 86) {
                // Ctrl+V：粘贴并覆盖选区。
                string clip = Clipboard.GetText();
                if (clip.Length > 0) {
                    if (HasSel()) { DeleteSel(); txt = model.Get(); }
                    model.Set(Text.InsertAt(txt, cursorPos, clip));
                    cursorPos = cursorPos + clip.Length;
                    selAnchor = -1;
                    Edited();
                    app.RequestRedraw();
                }
            } else if (kc == 37 || kc == 39 || kc == 36 || kc == 35) {
                // 方向键/Home/End：Shift 从光标处扩展选区；
                // 普通移动则收起选区（方向键收起到选区边缘，
                // 与所有原生文本框一致）。
                if (shift) {
                    if (selAnchor < 0) { selAnchor = cursorPos; }
                } else if (HasSel()) {
                    if (kc == 37) { cursorPos = SelStart(); }
                    else if (kc == 39) { cursorPos = SelEnd(); }
                    selAnchor = -1;
                    if (kc == 36) { cursorPos = 0; }
                    if (kc == 35) { cursorPos = txt.Length; }
                    app.RequestRedraw();
                    return;
                }
                if (!shift) { selAnchor = -1; }
                if (kc == 37) { if (cursorPos > 0) { cursorPos = Text.PrevCharStart(txt, cursorPos); } }
                else if (kc == 39) { if (cursorPos < txt.Length) { cursorPos = Text.NextCharEnd(txt, cursorPos); } }
                else if (kc == 36) { cursorPos = 0; }
                else if (kc == 35) { cursorPos = txt.Length; }
                app.RequestRedraw();
            } else if (kc == 46) {
                if (HasSel()) {
                    DeleteSel();
                    Edited();
                    app.RequestRedraw();
                } else if (cursorPos < txt.Length) {
                    model.Set(Text.RemoveAt(txt, cursorPos));
                    Edited();
                    app.RequestRedraw();
                }
            }
        }
    }

    int Render(App app, int x, int y, int w, int h) {
        int id = wid;
        Canvas c = app.canvas;
        Theme t = app.theme;

        app.focus.RegisterFocusable(id);
        bool focused = app.focus.IsFocused(id);

        // Size 字段映射为 Class 片段（small/medium/large），
        // base.css 的 input.small/large 规则负责重设高度/字号。
        string origClass = Class;
        string szv = "";
        if (Size != null) { szv = Size.Get(); }
        this.AddClass(Control.SizeClass(szv));
        // medium 是默认，不附加。

        if (focused) {
            // Autoselect: 首次获焦时全选。
            if (Autoselect && !autoselected) {
                SelectAll();
                autoselected = true;
            }
            HandleInput(app);
        }
        if (!focused) { autoselected = false; }

        SyncBinding();
        string txt = model.Get();
        ClampCursor();

        // 整个外框（填充、边框、圆角、阴影、hover/focus 淡变）
        // 来自样式层，因此皮肤的 `input:hover / input:focus`
        // 规则即可重设字段样式，无需改动此代码。
        StyleBox s = this.ResolveEasedStyleAsIn(
            app, id, "input", Class, false, false, x, y, w, h);
        s.Paint(app, x, y, w, h);
        int fs = s.FontOr(Style.FontFallback(app, "medium"));
        int accent = s.accent;
        // 校验错误：颜色与线宽来自 `input::error` 部件（在样式层之后
        // 绘制，皮肤可改写该部件但无法被普通边框规则冲淡）。
        StyleBox errorStyle = new StyleBox();
        if (errMsg != "") {
            errorStyle = this.ResolvePartAs(app, "input", "error", "",
                                            Class, Style.SNormal());
            c.DrawRect(x, y, w, h, errorStyle.BorderOr(errorStyle.fg),
                       errorStyle.BorderWOr(2));
        }

        int pad = s.PadLOr(t.paddingSmall);
        // 为每个图标预留方形槽位，文本不会跑到图标下面。
        // 密码框始终在尾端带一个眼睛切换图标。
        int glyphSz = fs;
        string trailIcon = iconTrail;
        if (password) { trailIcon = "eye"; }
        // Clearable：文本非空且获焦时在尾端附加 X 清除按钮。
        bool showClear = Clearable && txt != "" && focused;
        if (showClear) { trailIcon = "x"; }
        int leadSlot = 0;
        if (iconLead != "") { leadSlot = glyphSz + pad; }
        int trailSlot = 0;
        if (trailIcon != "") { trailSlot = glyphSz + pad; }
        int innerX = x + pad + leadSlot;
        int innerW = w - pad - s.PadROr(t.paddingSmall) - leadSlot - trailSlot;
        if (innerW < 0) { innerW = 0; }
        int textY = Canvas.CenterTextY(y, h, fs);
        // 掩码显示：字节长度不变，cursorPos 仍可正确索引。
        string disp = txt;
        if (password && !reveal) { disp = Input.Mask(txt); }
        int trailX = x + w - trailSlot;
        bool onTrail = trailSlot > 0 && app.mouseX >= trailX
            && app.mouseX < x + w && app.mouseY >= y && app.mouseY < y + h;

        StyleBox placeholderStyle = this.ResolveEasedPartAsIn(
            app, id, "input", "placeholder", "", Class, false, false,
            x, y, w, h);
        StyleBox selectionStyle = this.ResolveEasedPartAsIn(
            app, id, "input", "selection", "", Class, false, false,
            x, y, w, h);
        StyleBox caretStyle = this.ResolveEasedPartAsIn(
            app, id, "input", "caret", "", Class, false, false,
            x, y, w, h);
        int placeholderFont = placeholderStyle.FontOr(fs);
        int caretColor = caretStyle.BgOr(caretStyle.FgOr(caretStyle.AccentOr(accent)));

        int caretW = 0;
        if (disp != "") {
            caretW = Canvas.MeasureText(Text.Left(disp, cursorPos), fs);
        }
        int scrollX = 0;
        if (caretW > innerW) { scrollX = caretW - innerW; }

        c.PushClip(innerX, y, innerW, h);
        if (focused && HasSel()) {
            // 文本后的选区高亮。
            int selPx0 = Canvas.MeasureText(Text.Left(disp, SelStart()), fs);
            int selPx1 = Canvas.MeasureText(Text.Left(disp, SelEnd()), fs);
            int selH = Canvas.FontHeight(fs);
            c.FillRect(innerX - scrollX + selPx0, textY, selPx1 - selPx0, selH,
                       selectionStyle.BgOr(accent));
        }
        if (txt == "") {
            int placeholderY = Canvas.CenterTextY(y, h, placeholderFont);
            c.DrawText(innerX, placeholderY, hint,
                       placeholderStyle.FgOr(s.fg), placeholderFont);
        } else {
            c.DrawText(innerX - scrollX, textY, disp, s.fg, fs);
        }

        if (focused) {
            int cursorX = innerX - scrollX + caretW;
            int cursorH = Canvas.FontHeight(fs);
            int cursorWidth = caretStyle.WidthOr(1);
            c.FillRect(cursorX, textY, cursorWidth, cursorH, caretColor);
            // 让 IME 组合窗口保持在光标处。
            app.SetImeCaret(cursorX, textY + cursorH);
        }
        c.PopClip();

        // 图标位于文本裁剪区外预留的填充槽位中，因此
        // 它们要在 PopClip 之后绘制——否则文本裁剪区（只覆盖
        // innerX..innerX+innerW）会把它们裁掉，什么都看不到。
        if (iconLead != "" || trailIcon != "") {
            // 图标颜色来自 `input::icon`：悬停用 :hover，密码明文
            // （眼睛常亮）用 :selected。
            StyleBox iconStyle = this.ResolvePartAs(
                app, "input", "icon", "", Class, Style.SNormal());
            if (iconLead != "") {
                c.DrawGlyphIn(iconLead, x + pad, y, glyphSz, h, glyphSz,
                    iconStyle.FgOr(s.fg));
            }
            if (trailIcon != "") {
                int iconState = Style.SNormal();
                if (onTrail) { iconState = Style.SHover(); }
                if (password && reveal) {
                    iconState = iconState + Style.SSelected();
                }
                if (iconState != Style.SNormal()) {
                    iconStyle = this.ResolvePartAs(
                        app, "input", "icon", "", Class, iconState);
                }
                c.DrawGlyphIn(trailIcon, trailX, y, glyphSz, h, glyphSz,
                              iconStyle.FgOr(s.fg));
            }
        }
        // 校验消息显示在字段下方（在 PopClip 之后绘制，
        // 文本裁剪区无法截断它）。
        if (errMsg != "") {
            c.DrawText(x, y + h + app.Scale(2), errMsg,
                       errorStyle.FgOr(s.fg),
                       errorStyle.FontOr(Style.FontFallback(app, "small")));
        }

        app.hitTester.RegisterRect(id, x, y, w, h, 1);

        // 密码明文 / 清空按钮点击：都在尾端图标上释放左键。
        if (onTrail && app.EventKind() == 3
                && app.window.EventButton() == 0 && app.ClickAvailable()) {
            if (password) {
                reveal = !reveal;
            } else if (showClear) {
                // Clearable: 清空内容，触发 Change，置光标到行首。
                model.Set("");
                cursorPos = 0;
                selAnchor = -1;
                Edited();
            }
            app.ClaimClick();
            app.RequestRedraw();
        }

        // 鼠标选择：按下锚定选区并放置光标；
        // 按住拖动移动光标端；松开保留选区
        // （收起为空的选区清除锚点）。
        if (Ui.PressedDown(app, id) && !onTrail) {
            int rel = app.mouseX - innerX + scrollX;
            cursorPos = CodeEditor.ColFromX(disp, rel, fs);
            if (Modifiers.HasShift(app.window.EventMods()) && selAnchor >= 0) {
                // Shift+点击从现有锚点扩展选区。
            } else {
                selAnchor = cursorPos;
            }
            app.RequestRedraw();
        } else if (focused && app.focus.IsPressed(id)
                   && app.EventKind() == 1) {
            int rel = app.mouseX - innerX + scrollX;
            int drag = CodeEditor.ColFromX(disp, rel, fs);
            if (drag != cursorPos) {
                cursorPos = drag;
                app.RequestRedraw();
            }
        }
        // 单消费者点击：当本输入框是框架解析出的
        // 点击目标时，放置光标。
        if (Ui.Clicked(app, id) && !onTrail) {
            int rel = app.mouseX - innerX + scrollX;
            cursorPos = CodeEditor.ColFromX(disp, rel, fs);
            if (selAnchor == cursorPos) { selAnchor = -1; }
            app.RequestRedraw();
        }
        if (!focused && selAnchor >= 0) { selAnchor = -1; }

        // 恢复 Class，避免设计器/序列化器读到污染的字段。
        Class = origClass;

        On.Fire(app, id);
        return id;
    }

    // --- 设计器 / 序列化模型 ---

    override string Kind() { return "Input"; }
    override Binding<string> SizeOf() { return Size; }

    override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec ph = PropSpec.Text("hint", "Placeholder");
        ph.str = hint;
        ph.Also("placeholder");
        ps.Add(ph);
        ps.Add(PropSpec.Text("text", "Text"));
        PropSpec sz = PropSpec.Enum("size", "Size",
            new List<string>{ "tiny", "small", "medium", "large" });
        sz.str = Size;
        ps.Add(sz);
        PropSpec clr = PropSpec.Bool("clearable", "Clearable");
        clr.flag = Clearable;
        ps.Add(clr);
        PropSpec asel = PropSpec.Bool("autoselect", "Autoselect");
        asel.flag = Autoselect;
        ps.Add(asel);
        return ps;
    }

    /// 文本经 SetText 写入，保证光标与选区不越界。
    override string GetExtra(string key) {
        if (key == "text" || key == "value") { return model.Get(); }
        return "";
    }

    override bool SetExtra(string key, string val) {
        if (key == "text" || key == "value") {
            // 同一个值再写一遍不算编辑：SetText 会把光标收到末尾，而属性
            // 写入可能每帧都来（数据绑定、文案刷新），那样方向键就白按了。
            if (val != model.Get()) { this.SetText(val); }
            return true;
        }
        if (key == "password") { password = (val == "true"); return true; }
        if (key == "iconLead" || key == "icon") { iconLead = val; return true; }
        if (key == "iconTrail") { iconTrail = val; return true; }
        return false;
    }

    override List<string> Events() {
        List<string> e = Control.CommonEvents();
        e.Add("Change");
        e.Add("Submit");
        return e;
    }

    /// 将输入框自身的语义事件（Change/Submit）路由到对应的 UiEvent
    /// 字段；其余事件落入 `On` 上的通用事件包。
    override void BindEvent(string evt, Action a) {
        if (evt == "Change") { Change.Add(a); return; }
        if (evt == "Submit") { Submit.Add(a); return; }
        On.AddByName(evt, a);
    }

    // --- 保留模式钩子（Control） ---

    override void OnMeasure(App app) {
        Theme t = app.theme;
        // 尺寸档（Size → .small/.large）在渲染前也要生效：
        // 临时把档位 class 并入 Class 再解析，量出的高度
        // 与每帧渲染一致。
        string origClass = Class;
        string szv = "";
        if (Size != null) { szv = Size.Get(); }
        this.AddClass(Control.SizeClass(szv));
        StyleBox s = this.ResolveStyleAs(app, "input", Class, Style.SNormal());
        prefH = s.HeightOr(t.heightMedium);
        prefW = s.WidthOr(app.Scale(220));
        Class = origClass;
    }

    override void OnPaint(App app) {
        this.Render(app, bx, by, bw, bh);
    }
}
