using System;
using Gui;
using Gui.Component;
using Gui.Backend;
using Gui.Component.CodeEditor;

namespace Gui.Widget;

/// Single-line text input with a caret, placeholder and reactive binding.
///
/// Retained, C#-style widget: it has a stable identity (so focus survives
/// sibling/popup churn), the framework resolves focus/click for it, and it
/// exposes delegate events:
///     Input name = Input.Bind(model, "your name");
///     name.Change += () => { ... };   // fires on every edit
///     name.Submit += () => { ... };   // fires on Enter
///     name.Render(app, x, y, w, h);
/// When focused it consumes keyboard events (printable chars, Backspace,
/// Delete, Left/Right/Home/End) and edits its bound SignalString in place, and
/// reports the caret position to the framework so the IME composition window
/// follows the cursor.
class Input : Control {
    SignalString model;
    /// Two-way bound text: `name.data = user.name;` keeps the field and the
    /// input in sync both ways (compiler-lowered Binding). Optional; when
    /// unset the input edits its internal SignalString only.
    Binding<string> data;
    string hint;
    int cursorPos;
    // Selection anchor (the fixed end; the caret is the moving end): -1 when
    // there is no selection. Set on mouse press / Shift+move, cleared on any
    // plain caret move or edit.
    int selAnchor;
    int wid;
    /// Password mask: when set the text renders as `*` until revealed.
    bool password;
    /// Whether a masked field is currently showing plaintext (eye toggled).
    bool reveal;
    /// Optional leading / trailing icon names (Gui.Icon). A password field
    /// draws a clickable eye at the trailing edge regardless of `iconTrail`.
    string iconLead;
    string iconTrail;
    /// Fires whenever the text changes (C#-style: `inp.Change += h;`).
    UiEvent Change;
    /// Fires when Enter is pressed while focused.
    UiEvent Submit;

    /// Shared initialiser for the immediate-mode factories and the retained
    /// constructor: sets up the Control base (docks top so an appended input
    /// auto-snaps) then the input-specific state.
    void InitInput(SignalString sig, string hintText) {
        this.InitControl("input", 1);
        model = sig;
        hint = hintText;
        cursorPos = 0;
        selAnchor = -1;
        wid = WidgetId.Next();
        password = false;
        reveal = false;
        iconLead = "";
        iconTrail = "";
        wiresOwnEvents = true;
        Change = UiEvent.Create();
        Submit = UiEvent.Create();
    }

    /// Retained-mode constructor: `Input name = new Input("Your name");`
    Input(string hintText) {
        InitInput(SignalString.Create(""), hintText);
    }

    static Input Create(string hintText) {
        Input inp = new Input(hintText);
        return inp;
    }

    static Input Bind(SignalString sig, string hintText) {
        Input inp = new Input(hintText);
        inp.model = sig;
        return inp;
    }

    /// A string of `*` as long (in bytes) as `s`, so the masked display keeps
    /// the same byte layout and the caret/selection math stays valid.
    static string Mask(string s) {
        string m = "";
        int i = 0;
        while (i < s.Length) { m = m + "*"; i = i + 1; }
        return m;
    }

    string GetText() { return model.Get(); }
    void SetText(string v) {
        model.Set(v);
        cursorPos = v.Length;
        PushBinding();
    }

    /// Pull the bound model value into the edit buffer (model -> UI).
    void SyncBinding() {
        if (data == null) { return; }
        string cur = data.Get();
        if (cur != model.Get()) {
            model.Set(cur);
            if (cursorPos > cur.Length) { cursorPos = cur.Length; }
        }
    }

    /// Write the edit buffer back through the binding (UI -> model).
    void PushBinding() {
        if (data == null) { return; }
        data.Set(model.Get());
    }

    /// Every UI edit funnels through here: write back, then notify.
    void Edited() {
        PushBinding();
        Change.Raise();
    }

    void ClampCursor() {
        string txt = model.Get();
        if (cursorPos > txt.Length) { cursorPos = txt.Length; }
        if (cursorPos < 0) { cursorPos = 0; }
        if (selAnchor > txt.Length) { selAnchor = txt.Length; }
    }

    bool HasSel() { return selAnchor >= 0 && selAnchor != cursorPos; }
    int SelStart() { if (selAnchor >= 0 && selAnchor < cursorPos) { return selAnchor; } return cursorPos; }
    int SelEnd() { if (selAnchor > cursorPos) { return selAnchor; } return cursorPos; }

    string SelText() {
        if (!HasSel()) { return ""; }
        return model.Get().Substring(SelStart(), SelEnd() - SelStart());
    }

    /// Removes the selected range and collapses the caret to its start.
    void DeleteSel() {
        if (!HasSel()) { return; }
        string txt = model.Get();
        int s = SelStart();
        int e = SelEnd();
        model.Set(txt.Substring(0, s) + txt.Substring(e, txt.Length - e));
        cursorPos = s;
        selAnchor = -1;
    }

    void HandleInput(App app) {
        ClampCursor();
        int kind = app.EventKind();
        string txt = model.Get();
        if (kind == 6) {
            int code = app.window.EventKeyCode();
            if (code == 8) {
                if (HasSel()) {
                    DeleteSel();
                    Edited();
                    app.RequestRedraw();
                } else if (cursorPos > 0) {
                    int start = Text.PrevCharStart(txt, cursorPos);
                    model.Set(Text.DeleteBefore(txt, cursorPos));
                    cursorPos = start;
                    Edited();
                    app.RequestRedraw();
                }
            } else if (code == 13) {
                Submit.Raise();
                app.RequestRedraw();
            } else if (code == 9) {
                // ignore tab (handled by framework focus traversal)
            } else {
                string ch = Text.CharStr(code);
                if (ch.Length > 0) {
                    if (HasSel()) { DeleteSel(); txt = model.Get(); }
                    model.Set(Text.InsertAt(txt, cursorPos, ch));
                    cursorPos = cursorPos + ch.Length;
                    selAnchor = -1;
                    Edited();
                    app.RequestRedraw();
                }
            }
        } else if (kind == 4) {
            int kc = app.window.EventKeyCode();
            int mods = app.window.EventMods();
            bool shift = Modifiers.HasShift(mods);
            bool ctrl = Modifiers.HasCtrl(mods);
            if (ctrl && kc == 65) {
                // Ctrl+A: select all.
                selAnchor = 0;
                cursorPos = txt.Length;
                app.RequestRedraw();
            } else if (ctrl && kc == 67) {
                // Ctrl+C: copy the selection (whole text when none).
                if (HasSel()) { Clipboard.SetText(SelText()); }
                else { Clipboard.SetText(txt); }
            } else if (ctrl && kc == 88) {
                // Ctrl+X: cut.
                if (HasSel()) {
                    Clipboard.SetText(SelText());
                    DeleteSel();
                    Edited();
                    app.RequestRedraw();
                }
            } else if (ctrl && kc == 86) {
                // Ctrl+V: paste over the selection.
                string clip = Clipboard.GetText();
                if (clip.Length > 0) {
                    if (HasSel()) { DeleteSel(); txt = model.Get(); }
                    model.Set(Text.InsertAt(txt, cursorPos, clip));
                    cursorPos = cursorPos + clip.Length;
                    selAnchor = -1;
                    Edited();
                    app.RequestRedraw();
                }
            } else if (kc == 37 || kc == 39 || kc == 36 || kc == 35) {
                // Arrow/Home/End: Shift extends the selection from the caret;
                // a plain move collapses it (to the selection edge for arrows,
                // like every native text field).
                if (shift) {
                    if (selAnchor < 0) { selAnchor = cursorPos; }
                } else if (HasSel()) {
                    if (kc == 37) { cursorPos = SelStart(); }
                    else if (kc == 39) { cursorPos = SelEnd(); }
                    selAnchor = -1;
                    if (kc == 36) { cursorPos = 0; }
                    if (kc == 35) { cursorPos = txt.Length; }
                    app.RequestRedraw();
                    return;
                }
                if (!shift) { selAnchor = -1; }
                if (kc == 37) { if (cursorPos > 0) { cursorPos = Text.PrevCharStart(txt, cursorPos); } }
                else if (kc == 39) { if (cursorPos < txt.Length) { cursorPos = Text.NextCharEnd(txt, cursorPos); } }
                else if (kc == 36) { cursorPos = 0; }
                else if (kc == 35) { cursorPos = txt.Length; }
                app.RequestRedraw();
            } else if (kc == 46) {
                if (HasSel()) {
                    DeleteSel();
                    Edited();
                    app.RequestRedraw();
                } else if (cursorPos < txt.Length) {
                    model.Set(Text.RemoveAt(txt, cursorPos));
                    Edited();
                    app.RequestRedraw();
                }
            }
        }
    }

    int Render(App app, int x, int y, int w, int h) {
        int id = wid;
        Canvas c = app.canvas;
        Theme t = app.theme;

        app.focus.RegisterFocusable(id);
        bool focused = app.focus.IsFocused(id);

        if (focused) { HandleInput(app); }

        SyncBinding();
        string txt = model.Get();
        ClampCursor();

        // The whole frame (fill, border, radius, shadow, hover/focus fades)
        // comes from the style layer, so a skin's `input:hover / input:focus`
        // rules restyle the field without touching this code.
        StyleBox s = this.ResolveEasedStyleAs(app, id, "input", Class,
                                              false, false);
        s.Paint(app, x, y, w, h);
        int fs = s.FontOr(t.fontSizeMedium);
        int accent = s.AccentOr(t.primary);

        int pad = s.PadLOr(t.paddingSmall);
        // Reserve a square slot for each icon so the text never runs under it.
        // A password field always gets a trailing eye toggle.
        int glyphSz = fs;
        string trailIcon = iconTrail;
        if (password) { trailIcon = "eye"; }
        int leadSlot = 0;
        if (iconLead != "") { leadSlot = glyphSz + pad; }
        int trailSlot = 0;
        if (trailIcon != "") { trailSlot = glyphSz + pad; }
        int innerX = x + pad + leadSlot;
        int innerW = w - pad - s.PadROr(t.paddingSmall) - leadSlot - trailSlot;
        if (innerW < 0) { innerW = 0; }
        int textY = y + (h - Canvas.FontHeight(fs)) / 2;
        // Masked display: same byte length so cursorPos still indexes it.
        string disp = txt;
        if (password && !reveal) { disp = Input.Mask(txt); }
        int trailX = x + w - trailSlot;
        bool onTrail = trailSlot > 0 && app.mouseX >= trailX
            && app.mouseX < x + w && app.mouseY >= y && app.mouseY < y + h;

        StyleBox placeholderStyle = this.ResolveEasedPartAs(
            app, id, "input", "placeholder", "", Class, false, false);
        StyleBox selectionStyle = this.ResolveEasedPartAs(
            app, id, "input", "selection", "", Class, false, false);
        StyleBox caretStyle = this.ResolveEasedPartAs(
            app, id, "input", "caret", "", Class, false, false);
        int placeholderFont = placeholderStyle.FontOr(fs);
        int caretColor = caretStyle.BgOr(caretStyle.FgOr(caretStyle.AccentOr(accent)));

        int caretW = 0;
        if (disp != "") {
            caretW = Canvas.MeasureText(Text.Left(disp, cursorPos), fs);
        }
        int scrollX = 0;
        if (caretW > innerW) { scrollX = caretW - innerW; }

        c.PushClip(innerX, y, innerW, h);
        if (focused && HasSel()) {
            // Selection highlight behind the text.
            int selPx0 = Canvas.MeasureText(Text.Left(disp, SelStart()), fs);
            int selPx1 = Canvas.MeasureText(Text.Left(disp, SelEnd()), fs);
            int selH = Canvas.FontHeight(fs);
            int selectionColor = selectionStyle.BgOr(
                App.LerpColor(s.BgOr(t.bgPrimary), accent, 96));
            c.FillRect(innerX - scrollX + selPx0, textY, selPx1 - selPx0, selH,
                       selectionColor);
        }
        if (txt == "") {
            int placeholderY = y + (h - Canvas.FontHeight(placeholderFont)) / 2;
            c.DrawText(innerX, placeholderY, hint,
                       placeholderStyle.FgOr(t.textTertiary), placeholderFont);
        } else {
            c.DrawText(innerX - scrollX, textY, disp, s.FgOr(t.textPrimary), fs);
        }

        if (focused) {
            int cursorX = innerX - scrollX + caretW;
            int cursorH = Canvas.FontHeight(fs);
            int cursorWidth = caretStyle.WidthOr(1);
            c.FillRect(cursorX, textY, cursorWidth, cursorH, caretColor);
            // Keep the IME composition window at the caret.
            app.SetImeCaret(cursorX, textY + cursorH);
        }
        c.PopClip();

        // Icons sit in the padding slots reserved outside the text clip, so
        // they are drawn after PopClip -- otherwise the text clip (which spans
        // only innerX..innerX+innerW) would cut them off and nothing shows.
        if (iconLead != "") {
            c.DrawGlyphIn(iconLead, x + pad, y, glyphSz, h, glyphSz,
                s.FgOr(t.textTertiary));
        }
        if (trailIcon != "") {
            int eyeColor = s.FgOr(t.textTertiary);
            if (password && reveal) { eyeColor = accent; }
            if (onTrail) { eyeColor = accent; }
            c.DrawGlyphIn(trailIcon, trailX, y, glyphSz, h, glyphSz, eyeColor);
        }

        app.hitTester.Register(HitRegion.Create(id, x, y, w, h, 1));

        // Password reveal: a left-click release on the trailing eye toggles
        // plaintext and consumes the click so the caret does not move.
        if (password && onTrail && app.EventKind() == 3
                && app.window.EventButton() == 0 && app.ClickAvailable()) {
            reveal = !reveal;
            app.ClaimClick();
            app.RequestRedraw();
        }

        // Mouse selection: press anchors the selection and places the caret;
        // dragging while pressed moves the caret end; release keeps the range
        // (collapsed ranges clear the anchor).
        if (Ui.PressedDown(app, id) && !onTrail) {
            int rel = app.mouseX - innerX + scrollX;
            cursorPos = CodeEditor.ColFromX(disp, rel, fs);
            if (Modifiers.HasShift(app.window.EventMods()) && selAnchor >= 0) {
                // Shift+click extends from the existing anchor.
            } else {
                selAnchor = cursorPos;
            }
            app.RequestRedraw();
        } else if (focused && app.focus.IsPressed(id)
                   && app.EventKind() == 1) {
            int rel = app.mouseX - innerX + scrollX;
            int drag = CodeEditor.ColFromX(disp, rel, fs);
            if (drag != cursorPos) {
                cursorPos = drag;
                app.RequestRedraw();
            }
        }
        // Single-consumer click: place the caret when this input is the click
        // target resolved by the framework.
        if (Ui.Clicked(app, id) && !onTrail) {
            int rel = app.mouseX - innerX + scrollX;
            cursorPos = CodeEditor.ColFromX(disp, rel, fs);
            if (selAnchor == cursorPos) { selAnchor = -1; }
            app.RequestRedraw();
        }
        if (!focused && selAnchor >= 0) { selAnchor = -1; }

        On.Fire(app, id);
        return id;
    }

    // --- Designer / serialization model ---

    override string Kind() { return "Input"; }

    override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec ph = PropSpec.Text("hint", "Placeholder");
        ph.str = hint;
        ph.Also("placeholder");
        ps.Add(ph);
        ps.Add(PropSpec.Text("text", "Text"));
        return ps;
    }

    /// Text goes through SetText so the caret and selection stay in range.
    override string GetExtra(string key) {
        if (key == "text" || key == "value") { return model.Get(); }
        return "";
    }

    override bool SetExtra(string key, string val) {
        if (key == "text" || key == "value") { this.SetText(val); return true; }
        if (key == "password") { password = (val == "true"); return true; }
        if (key == "iconLead" || key == "icon") { iconLead = val; return true; }
        if (key == "iconTrail") { iconTrail = val; return true; }
        return false;
    }

    override List<string> Events() {
        List<string> e = Control.CommonEvents();
        e.Add("Change");
        e.Add("Submit");
        return e;
    }

    /// Routes the input's own semantic events (Change/Submit) to their UiEvent
    /// fields; everything else falls through to the common bundle on `On`.
    override void BindEvent(string evt, Action a) {
        if (evt == "Change") { Change.Add(a); return; }
        if (evt == "Submit") { Submit.Add(a); return; }
        On.AddByName(evt, a);
    }

    // --- Retained-mode hooks (Control) ---

    override void OnMeasure(App app) {
        Theme t = app.theme;
        StyleBox s = this.ResolveStyleAs(app, "input", Class, Style.SNormal());
        prefH = s.HeightOr(t.heightMedium);
        prefW = s.WidthOr(app.Scale(220));
    }

    override void OnPaint(App app) {
        this.Render(app, bx, by, bw, bh);
    }
}
