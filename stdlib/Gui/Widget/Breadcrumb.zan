using System;
using Gui;

namespace Gui.Widget;

/// Breadcrumb navigation: crumbs on one line box joined by a separator glyph.
/// Crumbs, the current crumb and the separator are styled parts
/// (`breadcrumb::item`, `::current`, `::separator`), so a skin restyles them and
/// the code side is plain assignment:
///
///     Breadcrumb b = new Breadcrumb();
///     b.AddItem("Home"); b.AddItem("Projects");
///     b.Separator = "slash";
class Breadcrumb : Control {
    List<string> items;
    /// Glyph drawn between crumbs.
    string Separator;

    void InitBreadcrumb() {
        this.InitControl("breadcrumb", 1);
        items = new List<string>();
        Separator = "chevron-right";
    }

    Breadcrumb() { InitBreadcrumb(); }

    /// Named AddItem (not Add) so it does not shadow Control.Add(Control).
    void AddItem(string label) {
        items.Add(label);
    }

    override void OnMeasure(App app) {
        Theme t = app.theme;
        StyleBox s = this.ResolveStyleAs(app, "breadcrumb", Class,
                                         Style.SNormal());
        int fs = s.FontOr(t.fontSizeMedium);
        prefH = Canvas.FontHeight(fs);
        int w = 0;
        int i = 0;
        while (i < items.Count) {
            if (i > 0) { w = w + t.iconSizeSmall + t.gapSmall; }
            w = w + Canvas.MeasureText(items[i], fs);
            i = i + 1;
        }
        prefW = s.WidthOr(w);
    }

    override void OnPaint(App app) {
        Breadcrumb.Paint(app, bx, by, items, Separator, Class);
    }

    static void Paint(App app, int x, int y, List<string> items, string sep,
                      string cls) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        StyleBox s = Style.Of(app, "breadcrumb", cls, Style.SNormal());
        StyleBox it = Style.Part(app, "breadcrumb", "item", "", cls, "",
                                 Style.SNormal());
        StyleBox cu = Style.Part(app, "breadcrumb", "current", "", cls, "",
                                 Style.SNormal());
        StyleBox sp = Style.Part(app, "breadcrumb", "separator", "", cls, "",
                                 Style.SNormal());

        // Lay every crumb and separator out on a common line box so the
        // separator glyphs sit vertically centred with the text baseline.
        int fs = s.FontOr(t.fontSizeMedium);
        int lineH = Canvas.FontHeight(fs);
        int gap = s.GapOr(t.gapSmall);
        int sepBox = sp.WidthOr(t.iconSizeSmall + app.Scale(4));
        int cx = x;
        int i = 0;
        while (i < items.Count) {
            if (i > 0) {
                c.DrawGlyphIn(sep, cx, y, sepBox, lineH,
                                    sp.FontOr(t.fontSizeSmall),
                                    sp.FgOr(t.textTertiary));
                cx = cx + sepBox + gap;
            }
            int color = it.FgOr(t.textSecondary);
            if (i == items.Count - 1) { color = cu.FgOr(t.textPrimary); }
            int tw = Canvas.MeasureText(items[i], fs);
            c.DrawTextCentered(cx, y, tw, lineH, items[i], color, fs);
            cx = cx + tw + gap;
            i = i + 1;
        }
    }

    static void Render(App app, int x, int y, List<string> items) {
        Breadcrumb.Paint(app, x, y, items, "chevron-right", "");
    }

    // ---- designer / serialization model -------------------------------------

    override string Kind() { return "Breadcrumb"; }

    override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        ps.Add(PropSpec.Text("items", "Items (comma separated)"));
        PropSpec sep = PropSpec.Text("separator", "Separator icon");
        sep.str = Separator;
        ps.Add(sep);
        ps.Add(PropSpec.Text("class", "Classes"));
        return ps;
    }

    /// The trail is a list, so it travels as one comma-separated value.
    override string GetExtra(string key) {
        if (key == "items") { return string.Join(",", items); }
        return "";
    }

    override bool SetExtra(string key, string val) {
        if (key != "items") { return false; }
        items = val.Split(",");
        return true;
    }
}
