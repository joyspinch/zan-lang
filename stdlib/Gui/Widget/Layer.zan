using System;
using Gui;
using Gui.Backend;

namespace Gui.Widget;

/// 浮动层的保留状态，支撑两种形态：
///   kind 0 —— 可拖动的“页面”窗口（layui `layer` 的 page/iframe 风格）：
///             持有几何信息、拖动状态及最小化/最大化/还原。
///   kind 1 —— 居中的模态对话框（alert / confirm），变暗的背景遮罩，
///             图标 + 标题 + 正文 + 操作行。
///   kind 2 —— 居中的提示对话框：类似 confirm 再加一个文本输入框。
/// state：0 正常，1 最大化，2 最小化（仅窗口）。
class LayerState {
    string title;
    string body;
    int x;
    int y;
    int w;
    int h;
    // 保存的正常几何信息，从最大化/最小化还原时回到这里。
    int sx;
    int sy;
    int sw;
    int sh;
    int state;
    bool open;
    bool dragging;
    int grabDx;
    int grabDy;
    int barId;
    int closeId;
    int maxId;
    int minId;
    // 是否绘制底部操作行（OK / Cancel）。
    bool footer;
    // 最近一次底部操作：0 无，1 确定，2 取消，3 关闭(X)。
    int action;
    // --- 统一 layer 扩展 ---
    int kind;            // 0 窗口，1 对话框，2 提示框
    bool modal;          // 绘制变暗的背景遮罩并让层居中
    int dtype;           // 对话框图标：0 信息，1 成功，2 警告，3 错误
    bool twoButtons;     // confirm/prompt（OK+Cancel）对比 alert（仅 OK）
    string okText;
    string cancelText;
    // 可选的第三种退路（“Don't save”），绘制在 Cancel 左侧，
    // 报告为 action 4。常规双按钮对话框传 ""。
    string altText;
    // 保留的操作按钮 + 关闭图标 id。Layer 每帧渲染这些按钮，
    // 但绝不能重建：重建的 Button 每帧都会拿到全新的 WidgetId，
    // 因此对照上一帧命中区解析出的点击目标
    // 永远不会匹配新 id，按钮看起来就像失效了（保留式宿主如
    // IDE 不会调用 WidgetId.ResetFrame）。在 Create() 中只创建一次。
    Button okBtn;
    Button cancelBtn;
    Button altBtn;
    int closeId;
    Input promptInput;   // kind 2 的文本输入框（其他情况为 null）
    int openMs;          // layer 打开时的墙钟毫秒数（入场动画用）

    LayerState(string title, int x, int y, int w, int h) {
        this.title = title;
        this.body = "";
        this.x = x;
        this.y = y;
        this.w = w;
        this.h = h;
        this.sx = x;
        this.sy = y;
        this.sw = w;
        this.sh = h;
        this.state = 0;
        this.open = false;
        this.dragging = false;
        this.grabDx = 0;
        this.grabDy = 0;
        this.barId = WidgetId.Next();
        this.closeId = WidgetId.Next();
        this.maxId = WidgetId.Next();
        this.minId = WidgetId.Next();
        this.footer = true;
        this.action = 0;
        this.kind = 0;
        this.modal = false;
        this.dtype = 0;
        this.twoButtons = true;
        this.okText = "OK";
        this.cancelText = "Cancel";
        this.altText = "";
        this.okBtn = new Button { Class = "primary" };
        this.cancelBtn = new Button { };
        this.altBtn = new Button { };
        this.closeId = WidgetId.Next();
        this.promptInput = null;
    }

    /// 居中的模态确认对话框（OK + Cancel）。dtype 决定图标。
    static LayerState Confirm(string title, string body, int dtype) {
        LayerState s = new LayerState(title, 0, 0, 420, 200);
        s.body = body;
        s.kind = 1;
        s.modal = true;
        s.dtype = dtype;
        s.twoButtons = true;
        return s;
    }

    /// 居中的模态对话框，提供三种出路——“保存它，
    /// 丢弃它，还是保持原状”，这是关闭编辑器时必须问的问题。
    /// 主操作报告 1，取消（及 X）报告 2 / 3，备选操作报告 4。
    static LayerState Choose(string title, string body, int dtype, string okText,
                             string altText, string cancelText) {
        LayerState s = LayerState.Confirm(title, body, dtype);
        s.okText = okText;
        s.altText = altText;
        s.cancelText = cancelText;
        return s;
    }

    /// 居中的模态 alert 对话框（仅一个 OK 按钮）。
    static LayerState Alert(string title, string body, int dtype) {
        LayerState s = LayerState.Confirm(title, body, dtype);
        s.twoButtons = false;
        return s;
    }

    /// 带文本输入框的居中模态 prompt 对话框（OK + Cancel）。
    static LayerState Prompt(string title, string hint) {
        LayerState s = new LayerState(title, 0, 0, 420, 220);
        s.kind = 2;
        s.modal = true;
        s.dtype = 0;
        s.twoButtons = true;
        s.promptInput = new Input(hint);
        return s;
    }

    void Open() {
        open = true;
        action = 0;
        openMs = Window.GetTickMs();
        if (state == 2) { state = 0; }
    }

    /// 用户在 prompt layer 中键入的文字（未输入时为空）。
    string PromptText() {
        if (promptInput == null) { return ""; }
        return promptInput.GetText();
    }
}

/// 一个短暂的队列项（toast / notification）。队列掌管其诞生
/// 时刻，以便淡入、存活 `lifeMs` 后淡出；`curY`/`curX`
/// 携带缓动后的屏幕位置，使更早的项被移除时
/// 堆栈能平滑收拢。
class ToastItem {
    string text;
    int type;
    int bornMs;
    int lifeMs;
    bool closing;
    int closeMs;
    int curY;
    int curX;

    ToastItem(string text, int type, int lifeMs) {
        this.text = text;
        this.type = type;
        this.bornMs = Window.GetTickMs();
        this.lifeMs = lifeMs;
        this.closing = false;
        this.closeMs = 0;
        this.curY = 0 - 99999;
        this.curX = 0 - 99999;
    }
}

/// 统一的 overlay 层——单个组件满足所有弹层需求
/// （layui `layer` 风格）：可拖动的页面窗口、模态 alert/confirm/prompt
/// 对话框、顶部居中的消息 toast 队列、角落通知、加载
/// 遮罩、锚定提示和全屏图片轮播。打开/关闭时均有动画，
/// 并在延迟的 overlay 绘制阶段渲染，因此浮在
/// 页面内容之上。
class Layer {
    // ---- 临时队列（惰性创建） ----
    static List<ToastItem> toasts;
    static List<ToastItem> notifs;
    // 上一帧这两条队列各自占过的像素 [x, y, w, h]（w/h 为 0 表示上一帧
    // 什么也没画）。
    static List<int> toastPrev;
    static List<int> notifPrev;

    static void EnsureQueues() {
        if (Layer.toasts == null) { Layer.toasts = new List<ToastItem>(); }
        if (Layer.notifs == null) { Layer.notifs = new List<ToastItem>(); }
        if (Layer.toastPrev == null) { Layer.toastPrev = Layer.NewRect(); }
        if (Layer.notifPrev == null) { Layer.notifPrev = Layer.NewRect(); }
    }

    static List<int> NewRect() {
        List<int> r = new List<int>();
        r.Add(0); r.Add(0); r.Add(0); r.Add(0);
        return r;
    }

    /// 声明这条队列这一帧的脏区，并把上一帧的脏区一起交上去。
    ///
    /// 队列里的东西一直在动（滑入、淡出、幸存者上移收拢），只声明「它现在
    /// 在哪」的话，上一帧它占过、这一帧已经离开的那几行像素没人重画，留在
    /// 屏幕上就是残影；最后一条消失的那一帧更是连一次重绘都不会请求，于是
    /// 那条 toast 会一直挂在屏幕上直到下一次整窗重绘。
    static void MarkQueueDirty(App app, List<int> prev, bool any,
            int rx, int ry, int rw, int rh) {
        if (any) { app.RequestAnimationFrameIn(16, rx, ry, rw, rh); }
        if (prev[2] > 0 && prev[3] > 0) {
            app.RequestAnimationFrameIn(16, prev[0], prev[1], prev[2], prev[3]);
        }
        if (any) {
            prev[0] = rx; prev[1] = ry; prev[2] = rw; prev[3] = rh;
        } else {
            prev[0] = 0; prev[1] = 0; prev[2] = 0; prev[3] = 0;
        }
    }

    /// 对话框操作按钮宽度：取标签自然宽度，不低于
    /// 标准对话框按钮宽度，使一排按钮保持齐整。
    static int ActionWidth(App app, Button b, int minW) {
        int w = b.AutoWidth(app);
        if (w < minW) { w = minW; }
        return w;
    }

    static int Clamp01(int v) {
        if (v < 0) { return 0; }
        if (v > 1000) { return 1000; }
        return v;
    }

    /// toast/notification/dialog 类型到 CSS 角色类（1/默认无类）。
    static string RoleClass(int mtype) {
        if (mtype == 2) { return "info"; }
        if (mtype == 3) { return "success"; }
        if (mtype == 4) { return "warning"; }
        if (mtype == 5) { return "error"; }
        return "";
    }

    static string RoleIcon(int mtype) {
        if (mtype == 3) { return "success"; }
        if (mtype == 4) { return "warning"; }
        if (mtype == 5) { return "error"; }
        return "info";
    }

    // ================================================================
    // 消息 toast 队列（顶部居中、自动消失、向上收拢）
    // ================================================================

    /// 入队一条短暂的顶部居中 toast。type：1 默认，2 信息，
    /// 3 成功，4 警告，5 错误。
    static void Msg(string text, int type) {
        Layer.EnsureQueues();
        int now = Window.GetTickMs();
        for (int i = 0; i < Layer.toasts.Count; i = i + 1) {
            ToastItem it = Layer.toasts[i];
            if (it.text == text && it.type == type && !it.closing) {
                it.lifeMs = now - it.bornMs + 3000;
                return;
            }
        }
        Layer.toasts.Add(new ToastItem(text, type, 3000));
    }

    /// 绘制并推进 toast 队列。在 overlay 阶段每帧调用一次。
    /// 条目从槽位正上方淡入/滑入，短暂停留后
    /// 淡出；幸存者缓动上移，填补空隙。
    static void RenderToasts(App app) {
        Layer.EnsureQueues();
        Theme t = app.theme;
        int now = Window.GetTickMs();

        int i = 0;
        while (i < Layer.toasts.Count) {
            ToastItem it = Layer.toasts[i];
            if (it.closing && now - it.closeMs >= 240) {
                Layer.toasts.RemoveAt(i);
            } else {
                i = i + 1;
            }
        }

        int h = t.heightMedium;
        int gap = app.Scale(8);
        int slotH = h + gap;
        int topY = app.titlebarH + app.Scale(10);
        int n = Layer.toasts.Count;
        int rx = 0;
        int ry = app.titlebarH;
        int rw = app.canvas.Width();
        int rh = app.canvas.Height() - app.titlebarH;
        for (int j = 0; j < n; j = j + 1) {
            ToastItem it = Layer.toasts[j];
            if (!it.closing && now - it.bornMs >= it.lifeMs) {
                it.closing = true;
                it.closeMs = now;
            }
            int ty = topY + j * slotH;
            if (it.curY < 0 - 9000) { it.curY = ty - app.Scale(14); }
            else { it.curY = it.curY + (ty - it.curY) / 3; }

            int enterP = App.Ease(Layer.Clamp01((now - it.bornMs) * 1000 / 220));
            int exitP = 0;
            if (it.closing) {
                exitP = App.Ease(Layer.Clamp01((now - it.closeMs) * 1000 / 240));
            }
            int a = enterP * (1000 - exitP) / 1000;
            Rect toastRect = Layer.DrawToast(
                app, it.curY, a, it.text, it.type);
            if (j == 0) {
                rx = toastRect.x;
                ry = toastRect.y;
                rw = toastRect.width;
                rh = toastRect.height;
            } else {
                if (toastRect.x < rx) {
                    rw = rw + rx - toastRect.x;
                    rx = toastRect.x;
                }
                if (toastRect.y < ry) {
                    rh = rh + ry - toastRect.y;
                    ry = toastRect.y;
                }
                if (toastRect.x + toastRect.width > rx + rw) {
                    rw = toastRect.x + toastRect.width - rx;
                }
                if (toastRect.y + toastRect.height > ry + rh) {
                    rh = toastRect.y + toastRect.height - ry;
                }
            }
        }
        Layer.MarkQueueDirty(app, Layer.toastPrev, n > 0, rx, ry, rw, rh);
    }

    static Rect DrawToast(App app, int y, int a, string text, int mtype) {
        Canvas c = app.canvas;
        Theme t = app.theme;

        string cls = Layer.RoleClass(mtype);
        StyleBox s = Style.Of(app, "toast", cls, Style.SNormal());
        StyleBox icoStyle = Style.Part(app, "toast", "icon", "", cls, "",
                                       Style.SNormal());
        string iconName = Layer.RoleIcon(mtype);
        int fontSize = s.FontOr(Style.FontFallback(app, "medium"));

        int ico = t.iconSizeSmall;
        int h = t.heightMedium;
        int textW = Canvas.MeasureText(text, fontSize);
        int w = t.paddingMedium * 2 + ico + t.gapSmall + textW;
        int x = (c.Width() - w) / 2;

        int sh = 34 * a / 1000;
        c.FillRoundRect(x + 1, y + 2, w, h, t.borderRadiusMedium, sh * 16777216);
        app.FillGlass(x, y, w, h, t.borderRadiusMedium, s.bg, a);
        c.DrawRoundRect(x, y, w, h, t.borderRadiusMedium,
                        Style.Fade(s.borderColor, a), s.BorderWOr(1));
        c.DrawGlyphIn(iconName, x + t.paddingMedium, y, ico, h, ico,
                            Style.Fade(icoStyle.fg, a));
        c.DrawText(x + t.paddingMedium + ico + t.gapSmall,
                   Canvas.CenterTextY(y, h, fontSize),
                   text, Style.Fade(s.fg, a), fontSize);
        return new Rect(x, y, w + 1, h + 2);
    }

    // ================================================================
    // 通知队列（右上角、自动消失、向上收拢）
    // ================================================================

    /// 入队一条角落通知。type：1 默认，2 信息，3 成功，
    /// 4 警告，5 错误。
    static void Notify(string title, int type) {
        Layer.EnsureQueues();
        Layer.notifs.Add(new ToastItem(title, type, 4000));
    }

    static void RenderNotifs(App app) {
        Layer.EnsureQueues();
        Canvas c = app.canvas;
        Theme t = app.theme;
        int now = Window.GetTickMs();

        int i = 0;
        while (i < Layer.notifs.Count) {
            ToastItem it = Layer.notifs[i];
            if (it.closing && now - it.closeMs >= 260) {
                Layer.notifs.RemoveAt(i);
            } else {
                i = i + 1;
            }
        }

        int w = app.Scale(300);
        int h = t.heightLarge + t.paddingSmall;
        int gap = app.Scale(10);
        int slotH = h + gap;
        int margin = app.Scale(16);
        int tx = c.Width() - w - margin;
        int topY = app.titlebarH + app.Scale(12);
        int n = Layer.notifs.Count;
        int rx = tx;
        int ry = topY;
        int rw = w;
        int rh = h;
        for (int j = 0; j < n; j = j + 1) {
            ToastItem it = Layer.notifs[j];
            if (!it.closing && now - it.bornMs >= it.lifeMs) {
                it.closing = true;
                it.closeMs = now;
            }
            int ty = topY + j * slotH;
            if (it.curY < 0 - 9000) { it.curY = ty; }
            else { it.curY = it.curY + (ty - it.curY) / 3; }

            int enterP = App.Ease(Layer.Clamp01((now - it.bornMs) * 1000 / 240));
            int exitP = 0;
            if (it.closing) {
                exitP = App.Ease(Layer.Clamp01((now - it.closeMs) * 1000 / 260));
            }
            int a = enterP * (1000 - exitP) / 1000;
            int cx = tx + (1000 - a) * app.Scale(24) / 1000;
            Layer.DrawNotifyCard(app, cx, it.curY, w, a, it.text, it.type);
            if (j == 0) {
                rx = cx; ry = it.curY; rw = w; rh = h;
            } else {
                if (cx < rx) { rw = rw + rx - cx; rx = cx; }
                if (it.curY < ry) { rh = rh + ry - it.curY; ry = it.curY; }
                if (cx + w > rx + rw) { rw = cx + w - rx; }
                if (it.curY + h > ry + rh) {
                    rh = it.curY + h - ry;
                }
            }
        }
        Layer.MarkQueueDirty(app, Layer.notifPrev, n > 0, rx, ry, rw, rh);
    }

    /// 单条通知 / 内联横幅卡片的高度。
    static int NotifyH(App app) {
        return app.theme.heightLarge + app.theme.paddingSmall;
    }

    /// 绘制通知卡片（不透明）。也复用作静态预览渲染器。
    static void DrawNotify(App app, int x, int y, int w, string message, int ntype) {
        Layer.DrawNotifyCard(app, x, y, w, 1000, message, ntype);
    }

    static void DrawNotifyCard(App app, int x, int y, int w, int a,
                               string message, int ntype) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int h = t.heightLarge + t.paddingSmall;

        string cls = Layer.RoleClass(ntype);
        StyleBox s = Style.Of(app, "notification", cls, Style.SNormal());
        StyleBox barStyle = Style.Part(app, "notification", "bar", "", cls,
                                       "", Style.SNormal());
        string iconName = Layer.RoleIcon(ntype);
        int fontSize = s.FontOr(Style.FontFallback(app, "medium"));

        int sh = 34 * a / 1000;
        c.FillRoundRect(x + 1, y + 2, w, h, t.borderRadiusMedium, sh * 16777216);
        app.FillGlass(x, y, w, h, t.borderRadiusMedium, s.bg, a);
        c.DrawRoundRect(x, y, w, h, t.borderRadiusMedium,
                        Style.Fade(s.borderColor, a), s.BorderWOr(1));

        int barColor = barStyle.bg;
        c.FillRect(x, y, barStyle.WidthOr(3), h, Style.Fade(barColor, a));

        c.DrawGlyphIn(iconName, x + t.paddingMedium, y,
                            t.iconSizeMedium, h, t.iconSizeMedium,
                            Style.Fade(barColor, a));
        c.DrawText(x + t.paddingMedium + t.iconSizeMedium + t.gapSmall,
                   Canvas.CenterTextY(y, h, fontSize),
                   message, Style.Fade(s.fg, a), fontSize);
    }

    // ================================================================
    // 加载遮罩 + 锚定提示
    // ================================================================

    /// 覆盖某区域的加载遮罩：变暗的圆角面板，中央是
    /// 旋转指示器和可选的说明文字。
    static void RenderLoad(App app, int x, int y, int w, int h, string tip) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        StyleBox mask = Style.Part(app, "layer", "mask", "", "", "",
                                   Style.SNormal());
        c.FillRoundRect(x, y, w, h, t.borderRadiusLarge, mask.bg);
        app.BlockHitsRect(x, y, w, h);
        int d = app.Scale(36);
        int cy = y + h / 2 - app.Scale(10);
        new Spin(36).RenderInside(app,
            new Rect(x + (w - d) / 2, cy - d / 2, d, d));
        if (tip == "") { return; }
        StyleBox ls = Style.Part(app, "layer", "load-label", "", "", "",
                                 Style.SNormal());
        int fs = ls.FontOr(Style.FontFallback(app, "small"));
        c.DrawTextCentered(x, cy + app.Scale(30), w, Canvas.FontHeight(fs), tip,
                           ls.FgOr(0), fs);
    }

    /// 小型的锚定提示气泡（委托给共享的 Tooltip 视觉）。
    static void Tips(App app, int anchorX, int anchorY, string text) {
        Tooltip.Render(app, anchorX, anchorY, text);
    }

    // ================================================================
    // 静态兼容辅助函数（替代已删除的包装函数）
    // ================================================================

    /// 居中的模态面板，带标题栏 + 关闭按钮。返回
    /// 关闭按钮的命中 id。（替代原 Modal.Render。）
    static int Modal(App app, int w, int h, string title) {
        Canvas c = app.canvas;
        Theme t = app.theme;

        StyleBox ov = Style.Part(app, "dialog", "overlay", "", "", "",
                                 Style.SNormal());
        StyleBox surf = Style.Part(app, "dialog", "surface", "", "", "",
                                   Style.SNormal());
        c.FillRect(0, 0, c.Width(), c.Height(), ov.bg);
        app.BlockHitsBelow();
        NativeLayer.Occlude(app, 0, 0, c.Width(), c.Height());
        int x = (c.Width() - w) / 2;
        int y = (c.Height() - h) / 2;

        c.FillRoundRect(x + surf.shadowDx, y + surf.shadowDy, w, h,
                        t.borderRadiusLarge, surf.shadow);
        c.FillRoundRect(x, y, w, h, t.borderRadiusLarge, surf.bg);

        if (title != "") {
            StyleBox ts = Style.Part(app, "dialog", "title", "", "", "",
                                     Style.SNormal());
            StyleBox ds = Style.Part(app, "dialog", "divider", "", "", "",
                                     Style.SNormal());
            int titleFont = ts.FontOr(Style.FontFallback(app, "large"));
            c.DrawText(x + t.paddingLarge, y + t.paddingLarge, title,
                       ts.fg, titleFont);
            c.FillRect(x + 1, y + t.paddingLarge + t.heightMedium, w - 2, 1,
                       ds.bg);
        }

        int closeId = app.focus.AllocId();
        int closeX = x + w - t.heightMedium;
        int closeY = y;
        int closeState = Style.SNormal();
        if (app.focus.IsHovered(closeId)) { closeState = Style.SHover(); }
        StyleBox cs = Style.Part(app, "dialog", "close", "", "", "",
                                 closeState);
        if (cs.bg != 0) {
            c.FillRoundRect(closeX, closeY, t.heightMedium, t.heightMedium,
                            t.borderRadiusLarge, cs.bg);
        }
        c.DrawGlyphIn("close", closeX, closeY, t.heightMedium,
                            t.heightMedium, t.iconSizeSmall, cs.fg);
        app.hitTester.RegisterRect(closeId, closeX, closeY, t.heightMedium, t.heightMedium, 0);
        return closeId;
    }

    /// 锚定在触发器下方的小型确认弹出框。返回 0 无，
    /// 1 确认，2 取消。（替代原 Popconfirm.Render。）
    static int DrawPopconfirm(App app, int anchorX, int anchorY, string message,
                              string okText, string cancelText) {
        Canvas c = app.canvas;
        Theme t = app.theme;

        int ico = t.iconSizeSmall;
        StyleBox s = Style.Of(app, "popconfirm", "", Style.SNormal());
        int fontSize = s.FontOr(Style.FontFallback(app, "medium"));
        int msgW = Canvas.MeasureText(message, fontSize);
        int pad = t.paddingMedium;
        int w = pad * 2 + ico + t.gapSmall + msgW;
        int bw = app.Scale(64);
        int minW = pad * 2 + bw * 2 + t.gapSmall;
        if (w < minW) { w = minW; }
        int h = pad * 2 + Canvas.FontHeight(fontSize) + t.gapMedium + t.heightSmall;

        int x = anchorX - w / 2;
        int y = anchorY + app.Scale(8);
        if (x < app.Scale(4)) { x = app.Scale(4); }

        StyleBox icoStyle = Style.Part(app, "popconfirm", "icon", "", "", "",
                                       Style.SNormal());
        int notch = app.Scale(6);
        c.FillRoundRect(x + s.shadowDx, y + s.shadowDy, w, h,
                        t.borderRadiusMedium, s.shadow);
        app.FillGlass(x, y, w, h, t.borderRadiusMedium, s.bg, 1000);
        c.DrawRoundRect(x, y, w, h, t.borderRadiusMedium, s.borderColor,
                        s.BorderWOr(1));
        Tooltip.TriUp(c, anchorX, y - notch, notch, notch, s.bg);
        app.BlockHitsRect(x, y, w, h);

        c.DrawGlyph("warning", x + pad, y + pad, ico, icoStyle.fg);
        c.DrawText(x + pad + ico + t.gapSmall, y + pad, message, s.fg, fontSize);

        int by = y + h - t.heightSmall - pad;
        int okX = x + w - pad - bw;
        int cancelX = okX - t.gapSmall - bw;

        int result = 0;
        int cancelId = new Button { Text = cancelText, Class = "primary outline" }.Render(app, cancelX, by, bw);
        if (Ui.Clicked(app, cancelId)) { result = 2; }
        int okId = new Button { Text = okText, Class = "primary" }.Render(app, okX, by, bw);
        if (Ui.Clicked(app, okId)) { result = 1; }
        return result;
    }

    // ================================================================
    // 全屏图片轮播（layui `photos` layer）
    // ================================================================

    /// 全屏变暗的图片查看器，包装共享的 Carousel。
    /// 关闭按钮被点击的那一帧返回 true。
    static bool RenderPhotos(App app, List<string> slides, SignalInt idx,
                             CarouselAnim anim) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int W = c.Width();
        int H = c.Height();
        int top = app.titlebarH;

        StyleBox s = Style.Of(app, "photos", "", Style.SNormal());
        int fontSize = s.FontOr(Style.FontFallback(app, "medium"));
        c.FillRect(0, top, W, H - top, s.bg);
        app.BlockHitsRect(0, top, W, H - top);

        int pw = W * 7 / 10;
        int ph = (H - top) * 7 / 10;
        int px = (W - pw) / 2;
        int py = top + ((H - top) - ph) / 2;

        Carousel.Of(slides, idx).Animate(anim)
            .RenderInside(app, new Rect(px, py, pw, ph));

        c.DrawText(px, py - app.Scale(28),
                   "Photo " + Convert.ToString(idx.Get() + 1) + " / "
                   + Convert.ToString(slides.Count), s.fg, fontSize);

        int bw = app.Scale(36);
        int bx = px + pw - bw;
        int byy = py - app.Scale(42);
        if (byy < top + app.Scale(6)) { byy = top + app.Scale(6); }
        int closeId = app.focus.AllocId();
        bool hover = Ui.Over(app, bx, byy, bw, bw);
        int chipState = Style.SNormal();
        if (hover) { chipState = Style.SHover(); }
        StyleBox chip = Style.Part(app, "photos", "chip", "", "", "",
                                   chipState);
        c.FillRoundRect(bx, byy, bw, bw, bw / 2, chip.bg);
        c.DrawGlyphIn("close", bx, byy, bw, bw, t.iconSizeSmall, chip.fg);
        app.hitTester.RegisterRect(closeId, bx, byy, bw, bw, 0);
        if (app.EventKind() == 3
            && app.ClickTarget() == closeId) {
            return true;
        }
        return false;
    }

    // ================================================================
    // 可拖动的页面窗口 + 模态对话框
    // ================================================================

    static int BarH(App app) {
        return app.theme.heightLarge;
    }

    static int FooterH(App app) {
        return app.theme.heightMedium + app.Scale(20);
    }

    static int BtnW(App app) {
        return app.Scale(46);
    }

    /// 状态 `s` 下，调用方正文内容应开始的绝对 Y 坐标。
    static int BodyTop(App app, LayerState s) {
        int top = app.titlebarH;
        if (s.state == 1) { return top + Layer.BarH(app) + app.Scale(16); }
        return s.y + Layer.BarH(app) + app.Scale(16);
    }

    /// 正文内容应开始的绝对 X 坐标。
    static int BodyLeft(App app, LayerState s) {
        if (s.state == 1) { return app.Scale(20); }
        return s.x + app.Scale(20);
    }

    static bool Inside(int mx, int my, int x, int y, int w, int h) {
        return mx >= x && mx < x + w && my >= y && my < y + h;
    }

    /// `s` 实际在屏幕上的边界（考虑最大化 / 最小化），
    /// 写入 4 元素 int 列表 [x, y, w, h]。
    static void Bounds(App app, LayerState s, List<int> outv) {
        int top = app.titlebarH;
        int bar = Layer.BarH(app);
        int ex = s.x; int ey = s.y; int ew = s.w; int eh = s.h;
        if (s.state == 1) {
            ex = 0; ey = top; ew = app.canvas.Width(); eh = app.canvas.Height() - top;
        } else if (s.state == 2) {
            ew = app.Scale(260); eh = bar;
        }
        outv.Add(ex); outv.Add(ey); outv.Add(ew); outv.Add(eh);
    }

    static bool Contains(App app, LayerState s, int mx, int my) {
        List<int> b = new List<int>();
        Layer.Bounds(app, s, b);
        return Layer.Inside(mx, my, b[0], b[1], b[2], b[3]);
    }

    /// layer 打开以来的入场进度（千分比）；仍在缓入时
    /// 会重新启动动画计时。
    static int Entrance(App app, LayerState s) {
        if (s.openMs <= 0) { return 1000; }
        int el = Window.GetTickMs() - s.openMs;
        int p = App.Ease(Layer.Clamp01(el * 1000 / 180));
        if (p < 1000) {
            List<int> b = new List<int>();
            Layer.Bounds(app, s, b);
            app.RequestAnimationFrameIn(16, b[0], b[1], b[2], b[3]);
        }
        return p;
    }

    /// 从后往前绘制页面窗口堆栈（最后一个 = 最顶层）。点击
    /// 任一窗口都会将其置顶；只有指针下最顶层的窗口（或被拖动者）
    /// 才消费鼠标事件。
    static void RenderStack(App app, List<LayerState> list) {
        int ek = app.EventKind();
        int mx = app.mouseX;
        int my = app.mouseY;

        int drag = 0 - 1;
        for (int j = 0; j < list.Count; j = j + 1) {
            if (list[j].dragging) { drag = j; }
        }

        int active = drag;
        if (active < 0) {
            int i = list.Count - 1;
            while (i >= 0) {
                LayerState s = list[i];
                if (s.open && Layer.Contains(app, s, mx, my)) { active = i; i = 0 - 1; }
                else { i = i - 1; }
            }
        }

        if (ek == 2 && active >= 0 && active < list.Count - 1) {
            LayerState s = list[active];
            list.RemoveAt(active);
            list.Add(s);
            active = list.Count - 1;
        }

        for (int k = 0; k < list.Count; k = k + 1) {
            Layer.RenderActive(app, list[k], k == active);
        }
    }

    static void Render(App app, LayerState s) {
        Layer.RenderActive(app, s, true);
    }

    static void RenderActive(App app, LayerState s, bool active) {
        if (!s.open) { return; }
        if (s.modal) { Layer.RenderDialog(app, s); return; }
        Canvas c = app.canvas;
        Theme t = app.theme;

        int W = c.Width();
        int H = c.Height();
        int top = app.titlebarH;
        int bar = Layer.BarH(app);
        int rad = t.borderRadiusLarge;

        int ex = s.x;
        int ey = s.y;
        int ew = s.w;
        int eh = s.h;
        if (s.state == 1) {
            ex = 0; ey = top; ew = W; eh = H - top;
        } else if (s.state == 2) {
            ew = app.Scale(260); eh = bar;
        }

        // 入场：上升 + 回稳。
        int entP = Layer.Entrance(app, s);
        ey = ey - (1000 - entP) * app.Scale(10) / 1000;

        int mx = app.mouseX;
        int my = app.mouseY;
        int ek = app.EventKind();

        int bw = Layer.BtnW(app);
        int closeX = ex + ew - bw;
        int maxX = closeX - bw;
        int minX = maxX - bw;

        // 对指针不透明：吞掉整个 layer 矩形上的所有命中，
        // 使其后面的页面控件不再响应（“透明层”bug）。
        // 最先注册，因此其下的标题栏按钮以及 app 之后绘入
        // 正文的任何组件后注册，能覆盖它。
        app.BlockHitsRect(ex, ey, ew, eh);

        app.hitTester.RegisterRect(
            s.barId, ex, ey, ew - bw * 3, bar, 5);
        app.hitTester.RegisterRect(
            s.minId, minX, ey, bw, bar, 0);
        app.hitTester.RegisterRect(
            s.maxId, maxX, ey, bw, bar, 0);
        app.hitTester.RegisterRect(
            s.closeId, closeX, ey, bw, bar, 0);
        app.focus.RegisterFocusable(s.minId);
        app.focus.RegisterFocusable(s.maxId);
        app.focus.RegisterFocusable(s.closeId);

        if (!active) { ek = 0; }

        if (active && s.state == 0 && Ui.PressedDown(app, s.barId)) {
            s.dragging = true;
            s.grabDx = mx - s.x;
            s.grabDy = my - s.y;
        }
        if (ek == 1 && s.dragging) {
            s.x = mx - s.grabDx;
            s.y = my - s.grabDy;
            // 模拟窗口属于 page layer，因此要完全保持在
            // 父级客户区内：它绝不会被拖出任何边缘。
            int clampMaxX = W - ew;
            int clampMaxY = H - eh;
            if (clampMaxX < 0) { clampMaxX = 0; }
            if (clampMaxY < top) { clampMaxY = top; }
            if (s.x < 0) { s.x = 0; }
            if (s.x > clampMaxX) { s.x = clampMaxX; }
            if (s.y < top) { s.y = top; }
            if (s.y > clampMaxY) { s.y = clampMaxY; }
            ex = s.x; ey = s.y;
            closeX = ex + ew - bw; maxX = closeX - bw; minX = maxX - bw;
            app.RequestRedraw();
        }

        if (active && Ui.Clicked(app, s.closeId)) {
            s.open = false;
            s.dragging = false;
            return;
        }
        if (active && Ui.Clicked(app, s.maxId)) {
            if (s.state == 1) {
                s.state = 0;
                s.x = s.sx; s.y = s.sy; s.w = s.sw; s.h = s.sh;
            } else {
                if (s.state == 0) {
                    s.sx = s.x; s.sy = s.y; s.sw = s.w; s.sh = s.h;
                }
                s.state = 1;
            }
            app.RequestRedraw();
        } else if (active && Ui.Clicked(app, s.minId)) {
            if (s.state == 2) {
                s.state = 0;
            } else {
                if (s.state == 0) {
                    s.sx = s.x; s.sy = s.y; s.sw = s.w; s.sh = s.h;
                }
                s.state = 2;
            }
            app.RequestRedraw();
        }
        if (Ui.MouseReleased(app) && s.dragging) {
            s.dragging = false;
            app.RequestRedraw();
        }

        c.FillRoundRect(ex - app.Scale(1), ey + app.Scale(6), ew + app.Scale(2),
                        eh, rad + app.Scale(4), 0x22000000);
        c.FillRoundRect(ex + app.Scale(1), ey + app.Scale(3), ew - app.Scale(2),
                        eh, rad + app.Scale(2), 0x33000000);

        StyleBox win = Style.Of(app, "layer", "", Style.SNormal());
        StyleBox tbs = Style.Part(app, "layer", "titlebar", "", "", "",
                                  Style.SNormal());
        int titleFont = tbs.FontOr(Style.FontFallback(app, "medium"));
        if (s.dragging && t.glass != 0) {
            c.SurfaceRoundRect(ex, ey, ew, eh, rad, win.bg, win.borderColor,
                               win.BorderWOr(1));
        } else {
            if (ek == 1) { app.ReuseBackdrop(); }
            app.FillGlass(ex, ey, ew, eh, rad, win.bg, 1000);
        }

        c.FillRoundRect(ex, ey, ew, bar, rad, tbs.bg);
        c.FillRect(ex, ey + bar - rad, ew, rad, tbs.bg);
        int stripH = tbs.borderBottomW;
        if (stripH <= 0) { stripH = app.Scale(2); }
        c.FillRect(ex, ey + bar - stripH, ew, stripH, tbs.borderBottomColor);

        int icoS = t.iconSizeSmall;
        c.DrawGlyph("grid", ex + app.Scale(14),
                  ey + (bar - icoS) / 2, icoS, tbs.accent);
        c.DrawText(ex + app.Scale(14) + icoS + t.gapSmall,
                   Canvas.CenterTextY(ey, bar, titleFont),
                   s.title, tbs.fg, titleFont);

        int gl = t.iconSizeCaption + app.Scale(2);
        string minGlyph = "minimize";
        if (s.state == 2) { minGlyph = "restore"; }
        string maxGlyph = "maximize";
        if (s.state == 1) { maxGlyph = "restore"; }
        Layer.CapButton(app, minX, ey, bw, bar, minGlyph, gl, false);
        Layer.CapButton(app, maxX, ey, bw, bar, maxGlyph, gl, false);
        Layer.CapButton(app, closeX, ey, bw, bar, "close", gl, true);

        Layer.RenderLayerBody(app, s, ex, ey, ew, eh, bar);
    }

    /// Layer 正文文本 + 可选的底部按钮（最小化时跳过）。
    static void RenderLayerBody(App app, LayerState s, int ex, int ey, int ew, int eh, int bar) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        if (s.state != 2) {
            int footH = 0;
            if (s.footer) { footH = Layer.FooterH(app); }
            int bodyBottom = ey + eh - footH;
            c.PushClip(ex + 1, ey + bar, ew - 2, bodyBottom - (ey + bar));
            int bx = ex + app.Scale(20);
            int byy = ey + bar + app.Scale(16);
            StyleBox bodyStyle = Style.Part(app, "layer", "body", "", "", "",
                                            Style.SNormal());
            int bodyFont = bodyStyle.FontOr(Style.FontFallback(app, "medium"));
            if (s.body != "") {
                c.DrawText(bx, byy, s.body, bodyStyle.fg, bodyFont);
            }
            if (s.action == 1) {
                app.canvas.DrawStyledText(
                    Style.Of(app, "label", "secondary", Style.SNormal()),
                    bx, byy + app.Scale(28), "confirmed",
                    bodyStyle.fg, Style.FontFallback(app, "medium"));
            } else if (s.action == 2) {
                app.canvas.DrawStyledText(
                    Style.Of(app, "label", "secondary", Style.SNormal()),
                    bx, byy + app.Scale(28), "cancelled",
                    bodyStyle.fg, Style.FontFallback(app, "medium"));
            }
            c.PopClip();

            if (s.footer) {
                int fy = ey + eh - footH;
                StyleBox foot = Style.Part(app, "layer", "footer", "", "",
                                           "", Style.SNormal());
                c.FillRect(ex + 1, fy, ew - 2, 1, foot.bg);
                int fbw = app.Scale(84);
                int pad = app.Scale(16);
                int okX = ex + ew - pad - fbw;
                int cancelX = okX - t.gapMedium - fbw;
                int fby = fy + (footH - t.heightMedium) / 2;
                s.cancelBtn.Text = s.cancelText;
                s.cancelBtn.Class = "primary outline";
                int cancelId = s.cancelBtn.Render(app, cancelX, fby, fbw);
                if (Ui.Clicked(app, cancelId)) { s.action = 2; }
                s.okBtn.Text = s.okText;
                s.okBtn.Class = "primary";
                int okId = s.okBtn.Render(app, okX, fby, fbw);
                if (Ui.Clicked(app, okId)) { s.action = 1; }
            }
        }
    }

    /// 居中的模态对话框：alert / confirm / prompt。将 s.action 设为
    /// 1 (OK)、2 (Cancel) 或 3 (关闭 X)；调用方读取后关闭。
    static void RenderDialog(App app, LayerState s) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int W = c.Width();
        int H = c.Height();
        int rad = t.borderRadiusLarge;

        int entP = Layer.Entrance(app, s);

        int w = app.Scale(s.w);
        int h = app.Scale(s.h);
        int x = (W - w) / 2;
        int y = (H - h) / 2 - (1000 - entP) * app.Scale(12) / 1000;

        // 变暗的背景遮罩。吞掉其下方的点击，使模态真正模态化
        // （点击遮罩或对话框正文不再穿透到页面）。
        string cls = Layer.RoleClass(s.dtype + 2);
        StyleBox ov = Style.Part(app, "dialog", "overlay", "", "", "",
                                 Style.SNormal());
        StyleBox surf = Style.Part(app, "dialog", "surface", "", "", "",
                                   Style.SNormal());
        c.FillRect(0, 0, W, H, ov.bg);
        app.BlockHitsBelow();
        NativeLayer.Occlude(app, 0, 0, W, H);

        c.FillRoundRect(x + surf.shadowDx, y + surf.shadowDy, w, h, rad,
                        surf.shadow);
        app.FillGlass(x, y, w, h, rad, surf.bg, 1000);

        StyleBox icoStyle = Style.Part(app, "dialog", "icon", "", cls, "",
                                       Style.SNormal());
        StyleBox titleStyle = Style.Part(app, "dialog", "title", "", "", "",
                                         Style.SNormal());
        string iconName = Layer.RoleIcon(s.dtype + 2);
        int titleFont = titleStyle.FontOr(Style.FontFallback(app, "large"));

        int pad = t.paddingLarge;
        int ico = t.iconSizeLarge;
        c.DrawGlyph(iconName, x + pad, y + pad, ico, icoStyle.fg);
        c.DrawText(x + pad + ico + t.gapMedium, y + pad, s.title,
                   titleStyle.fg, titleFont);

        int bodyY = y + pad + ico + t.gapMedium;
        if (s.body != "") {
            StyleBox bodyStyle = Style.Part(app, "dialog", "body", "", "",
                                            "", Style.SNormal());
            int bodyFont = bodyStyle.FontOr(Style.FontFallback(app, "medium"));
            c.DrawText(x + pad + ico + t.gapMedium, bodyY, s.body,
                       bodyStyle.fg, bodyFont);
        }

        if (s.kind == 2 && s.promptInput != null) {
            int iy = bodyY + app.Scale(30);
            s.promptInput.Render(app, x + pad, iy, w - pad * 2, t.heightMedium);
        }

        // 右对齐的操作条：[alt] [cancel] [ok]。每个按钮至少保持
        // 标准对话框宽度，标签更长时会变宽，
        // 这样翻译后的“Don't save”也绝不会被截断。
        int by = y + h - t.heightMedium - pad;
        Button okBtn = s.okBtn;
        okBtn.Text = s.okText;
        okBtn.Class = "primary";
        Button cancelBtn = s.cancelBtn;
        cancelBtn.Text = s.cancelText;
        Button altBtn = null;
        if (s.altText != "") {
            altBtn = s.altBtn;
            altBtn.Text = s.altText;
        }

        int minBw = app.Scale(88);
        List<int> bws = new List<int>();
        if (altBtn != null) { bws.Add(Layer.ActionWidth(app, altBtn, minBw)); }
        if (s.twoButtons) { bws.Add(Layer.ActionWidth(app, cancelBtn, minBw)); }
        bws.Add(Layer.ActionWidth(app, okBtn, minBw));

        Stack actions = Stack.Row(x + pad, by, w - pad * 2, t.heightMedium);
        actions.SetGap(t.gapMedium);
        int strip = 0;
        int bi = 0;
        for (; bi < bws.Count; bi = bi + 1) {
            strip = strip + bws[bi] + t.gapMedium;
        }
        actions.Space(actions.MainSize() - strip);
        bi = 0;
        if (altBtn != null) {
            Rect altSlot = actions.Slot(bws[bi]);
            int altId = altBtn.Render(app, altSlot.x, altSlot.y, altSlot.width);
            if (Ui.Clicked(app, altId)) { s.action = 4; }
            bi = bi + 1;
        }
        if (s.twoButtons) {
            Rect cancelSlot = actions.Slot(bws[bi]);
            int cancelId = cancelBtn.Render(app, cancelSlot.x, cancelSlot.y,
                                            cancelSlot.width);
            if (Ui.Clicked(app, cancelId)) { s.action = 2; }
            bi = bi + 1;
        }
        Rect okSlot = actions.Slot(bws[bi]);
        int okId = okBtn.Render(app, okSlot.x, okSlot.y, okSlot.width);
        if (Ui.Clicked(app, okId)) { s.action = 1; }

        int closeId = s.closeId;
        int closeX = x + w - t.heightMedium;
        int closeY = y;
        int closeState = Style.SNormal();
        if (app.focus.IsHovered(closeId)) { closeState = Style.SHover(); }
        StyleBox closeStyle = Style.Part(app, "dialog", "close", "", "", "",
                                         closeState);
        if (closeStyle.bg != 0) {
            c.FillRoundRect(closeX, closeY, t.heightMedium, t.heightMedium,
                            t.borderRadiusLarge, closeStyle.bg);
        }
        c.DrawGlyphIn("close", closeX, closeY, t.heightMedium,
                            t.heightMedium, t.iconSizeSmall, closeStyle.fg);
        app.hitTester.RegisterRect(closeId, closeX, closeY, t.heightMedium, t.heightMedium, 0);
        if (app.EventKind() == 3
            && app.ClickTarget() == closeId) {
            s.action = 3;
        }
    }

    /// 一个内嵌的标题栏按钮：圆角 hover 背景 + 居中字形。
    static void CapButton(App app, int x, int y, int w, int h,
                          string glyph, int gl, bool danger) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        bool hover = Ui.Over(app, x, y, w, h);
        int inset = app.Scale(5);
        string cls = "";
        if (danger) { cls = "danger"; }
        int state = Style.SNormal();
        if (hover) { state = Style.SHover(); }
        StyleBox s = Style.Part(app, "layer", "cap", "", cls, "", state);
        if (hover && s.bg != 0) {
            c.FillRoundRect(x + inset, y + inset, w - inset * 2, h - inset * 2,
                            t.borderRadiusMedium, s.bg);
        }
        c.DrawGlyphIn(glyph, x, y, w, h, gl, s.fg);
    }
}