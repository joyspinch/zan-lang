using System;
using Gui;

namespace Gui.Widget;

/// 滚动条轨道和滑块。
class Scrollbar {
    static void RenderVertical(App app, int x, int y, int height, int contentHeight, int scrollOffset) {
        Canvas c = app.canvas;

        if (height <= 0) { return; }
        StyleBox track = Style.Of(app, "scrollbar", "", Style.SNormal());
        StyleBox thumb = Style.Part(app, "scrollbar", "thumb", "", "", "",
                                    Style.SNormal());
        int barW = app.Scale(8);
        int radius = app.Scale(4);
        c.PushClip(x, y, barW, height);
        c.FillRoundRect(x, y, barW, height, radius, track.bg);

        if (contentHeight > height && contentHeight > 0) {
            int minThumb = app.Scale(20);
            if (minThumb > height) { minThumb = height; }
            int thumbH = height * height / contentHeight;
            if (thumbH < minThumb) { thumbH = minThumb; }
            if (thumbH > height) { thumbH = height; }
            int travel = height - thumbH;
            int mo = contentHeight - height;
            int thumbY = y;
            if (mo > 0 && travel > 0) { thumbY = y + scrollOffset * travel / mo; }
            if (thumbY < y) { thumbY = y; }
            if (thumbY + thumbH > y + height) { thumbY = y + height - thumbH; }
            c.FillRoundRect(x, thumbY, barW, thumbH, radius, thumb.bg);
        }
        c.PopClip();
    }

    /// 绑定滚动偏移信号的交互式垂直滚动条。支持
    /// 滑块拖动和点击跳转：按下时滑块以指针为中心，
    /// 因此点击轨道也会滚动到该处。`viewH` 为滚动表面的可见高度；
    /// `height` 为滚动条长度（通常与前者
    /// 相同）。`offset` 更新范围为 [0, contentHeight - viewH]。
    static void RenderVerticalScroll(App app, int x, int y, int height,
                                     int viewH, int contentHeight, SignalInt offset) {
        Scrollbar.RenderVerticalScrollCore(app, x, y, height, viewH,
            contentHeight, offset, false, 0, 0, 0, 0);
    }

    static void RenderVerticalScrollIn(App app, int x, int y, int height,
                                       int viewH, int contentHeight,
                                       SignalInt offset,
                                       int vx, int vy, int vw, int vh) {
        Scrollbar.RenderVerticalScrollCore(app, x, y, height, viewH,
            contentHeight, offset, true, vx, vy, vw, vh);
    }

    static void RenderVerticalScrollCore(App app, int x, int y, int height,
                                         int viewH, int contentHeight,
                                         SignalInt offset, bool scoped,
                                         int vx, int vy, int vw, int vh) {
        int id = app.focus.AllocId();
        Canvas c = app.canvas;
        if (height <= 0) { return; }
        int barW = app.Scale(10);
        int radius = barW / 2;

        int mo = contentHeight - viewH;
        if (mo < 0) { mo = 0; }

        int minThumb = app.Scale(24);
        int thumbH = height;
        if (contentHeight > viewH && contentHeight > 0) {
            thumbH = height * viewH / contentHeight;
        }
        if (thumbH < minThumb) { thumbH = minThumb; }
        if (thumbH > height) { thumbH = height; }
        int travel = height - thumbH;

        bool active = app.focus.IsPressed(id);
        if (active && travel > 0 && mo > 0) {
            int rel = app.mouseY - y - thumbH / 2;
            if (rel < 0) { rel = 0; }
            if (rel > travel) { rel = travel; }
            int newOff = rel * mo / travel;
            if (newOff != offset.Get()) {
                offset.Set(newOff);
                if (scoped) { app.NoteScrollDamage(vx, vy, vw, vh); }
                else { app.RequestRedraw(); }
            }
        }

        int cur = offset.Get();
        if (cur < 0) { cur = 0; }
        if (cur > mo) { cur = mo; }

        bool hovered = app.focus.IsHovered(id);
        StyleBox track = Style.Of(app, "scrollbar", "", Style.SNormal());
        int thumbState = Style.SNormal();
        if (hovered || active) { thumbState = Style.SHover(); }
        StyleBox thumb = Style.Part(app, "scrollbar", "thumb", "", "", "",
                                    thumbState);
        c.PushClip(x, y, barW, height);
        c.FillRoundRect(x, y, barW, height, radius, track.bg);
        if (mo > 0) {
            int thumbY = y;
            if (travel > 0) { thumbY = y + cur * travel / mo; }
            c.FillRoundRect(x, thumbY, barW, thumbH, radius, thumb.bg);
        }
        c.PopClip();

        // 轨道内侧的抓取边距：滚动条常紧贴
        // 窗口边缘，而窗口框的调整大小抓手占据最外像素，
        // 因此指针需在内容侧留出空间才能抓住滑块。
        int grab = app.Scale(5);
        app.hitTester.RegisterRect(id, x - grab, y, barW + grab, height, 0);
        // ……再从该抓手中夺回最外像素，使紧贴窗口边缘的滚动条
        // 整条宽度都可按压。
        app.ReserveEdgeHit(x - grab, y, barW + grab, height);
    }

    /// 可滚动表面的鼠标滚轮滚动。传入完整的内容
    /// 视口矩形（不只是滚动条），使指针位于内容
    /// 任意位置时滚轮都能滚动。`offset` 更新范围为 [0, contentHeight-vh]。
    /// 每帧与 RenderVerticalScroll 一起调用一次。
    static void HandleWheel(App app, int vx, int vy, int vw, int vh,
                            int contentHeight, SignalInt offset) {
        int mo = contentHeight - vh;
        if (mo <= 0) { return; }
        bool over = Ui.Over(app, vx, vy, vw, vh);
        if (!over) { return; }
        bool owns = app.CaptureWheel(vx, vy, vw, vh);
        if (!owns || app.EventKind() != 13) { return; }
        int delta = app.window.EventKeyCode();
        int cur = offset.Get() - delta * app.scrollSpeed / 120;
        if (cur < 0) { cur = 0; }
        if (cur > mo) { cur = mo; }
        if (cur != offset.Get()) {
            offset.Set(cur);
            app.NoteScrollDamage(vx, vy, vw, vh);
        }
    }
}
