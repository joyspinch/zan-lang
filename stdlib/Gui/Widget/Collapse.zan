using System;
using Gui;

namespace Gui.Widget;

/// 一个手风琴面板：标题和内容作为一个记录同存。
class CollapsePanel {
    string title;
    string body;

    CollapsePanel(string title, string body) {
        this.title = title;
        this.body = body;
    }
}

/// 手风琴（NaiveUI n-collapse）。同时只展开一个面板；`Active` 保存
/// 展开面板的索引（-1 = 全部折叠），可双向绑定：
///
///     Collapse c = new Collapse();
///     c.AddPanel("General", "Theme, language and startup");
///     c.Active = vm.openPanel;
class Collapse : Control {
    List<CollapsePanel> panels;
    SignalInt open;
    /// 双向绑定的展开索引；-1 折叠所有面板。
    Binding<int> Active;
    /// 点击标题切换展开面板时触发。
    UiEvent Change;
    int baseId;
    int idCount;

    void InitCollapse(SignalInt m) {
        this.InitControl("collapse", 1);
        panels = new List<CollapsePanel>();
        open = m;
        baseId = 0;
        idCount = 0;
        wiresOwnEvents = true;
        Change = new UiEvent();
    }

    Collapse() { InitCollapse(new SignalInt(0 - 1)); }
    Collapse(SignalInt m) { InitCollapse(m); }

    /// 命名为 AddPanel（而非 Add），以免遮蔽 Control.Add(Control)。
    void AddPanel(string title, string body) {
        panels.Add(new CollapsePanel(title, body));
    }

    void AddPanel(CollapsePanel panel) { panels.Add(panel); }

    /// 基于现有面板记录构建手风琴。
    static Collapse Of(List<CollapsePanel> items, SignalInt m) {
        Collapse col = new Collapse(m);
        for (int i = 0; i < items.Count; i = i + 1) {
            col.AddPanel(items[i]);
        }
        return col;
    }

    static int HeaderHeight(App app) {
        return app.theme.heightLarge;
    }

    static int BodyHeight(App app) {
        return app.theme.heightLarge;
    }

    static int Height(App app, int count, SignalInt openIdx) {
        int h = count * Collapse.HeaderHeight(app);
        if (openIdx.Get() >= 0) { h = h + Collapse.BodyHeight(app); }
        return h;
    }

    /// 每个面板标题占一个 id，作为连续块预留，使
    /// 面板列表不变时点击 id 保持稳定。
    void EnsureIds() {
        if (idCount >= panels.Count) { return; }
        baseId = WidgetId.Block(panels.Count);
        idCount = panels.Count;
    }

    void SyncBinding() {
        if (Active == null) { return; }
        int cur = Active.Get();
        if (cur != open.Get()) { open.Set(cur); }
    }

    override void OnMeasure(App app) {
        StyleBox s = this.ResolveStyleAs(app, "collapse", Class,
                                         Style.SNormal());
        prefH = Collapse.Height(app, panels.Count, open);
        prefW = s.WidthOr(app.Scale(240));
    }

    override void OnPaint(App app) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        this.SyncBinding();
        this.EnsureIds();
        StyleBox hs = this.ResolvePartAs(app, "collapse", "header", "", Class,
                                         Style.SNormal());
        StyleBox as2 = this.ResolvePartAs(app, "collapse", "arrow", "", Class,
                                          Style.SNormal());
        StyleBox bs = this.ResolvePartAs(app, "collapse", "body", "", Class,
                                         Style.SNormal());
        StyleBox ds = this.ResolvePartAs(app, "collapse", "divider", "",
                                         Class, Style.SNormal());
        int headerH = hs.HeightOr(Collapse.HeaderHeight(app));
        int bodyH = bs.HeightOr(Collapse.BodyHeight(app));
        int headFont = hs.FontOr(Style.FontFallback(app, "medium"));
        int bodyFont = bs.FontOr(Style.FontFallback(app, "small"));
        int ico = as2.WidthOr(t.iconSizeSmall);
        int n = panels.Count;
        int opened = open.Get();
        int cy = by;

        // 把所有内容裁剪到手风琴自身区域内，长标题/正文
        // 会被截断，而不是向右或向下溢出。
        c.PushClip(bx, by, bw, bh);
        for (int i = 0; i < n; i = i + 1) {
            CollapsePanel panel = panels[i];
            int id = baseId + i;
            bool isOpen = i == opened;
            if (i > 0) { c.FillRect(bx, cy, bw, 1, ds.bg); }
            int hbg = hs.bg;
            if (app.focus.IsHovered(id)) {
                hbg = this.ResolvePartAs(app, "collapse", "header", "",
                                         Class, Style.SHover()).bg;
            }
            c.FillRect(bx, cy + 1, bw, headerH - 1, hbg);

            string ar = "chevron-right";
            if (isOpen) { ar = "chevron-down"; }
            c.DrawGlyph(ar, bx + t.paddingMedium, cy + (headerH - ico) / 2, ico,
                        as2.fg);

            int textX = bx + t.paddingMedium + ico + t.gapMedium;
            int textMaxW = bx + bw - t.paddingMedium - textX;
            c.DrawText(textX, Canvas.CenterTextY(cy, headerH, headFont),
                       Ellipsis.Fit(panel.title, textMaxW, headFont),
                       hs.fg, headFont);

            app.hitTester.RegisterRect(id, bx, cy, bw, headerH, 0);
            cy = cy + headerH;

            if (isOpen) {
                c.FillRect(bx, cy, bw, bodyH, bs.bg);
                c.DrawText(textX,
                           Canvas.CenterTextY(cy, bodyH, bodyFont),
                           Ellipsis.Fit(panel.body, textMaxW, bodyFont),
                           bs.fg, bodyFont);
                cy = cy + bodyH;
            }
        }
        c.PopClip();

        if (this.IsDisabled() || app.EventKind() != 3) { return; }
        int hit = app.ClickTarget();
        if (hit < baseId || hit >= baseId + n) { return; }
        int idx = hit - baseId;
        if (open.Get() == idx) { idx = 0 - 1; }
        open.Set(idx);
        if (Active != null) { Active.Set(idx); }
        Change.Raise();
        app.RequestRedraw();
    }

    // ---- 设计器 / 序列化模型 ----

    override string Kind() { return "Collapse"; }

    override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>{
            PropSpec.Text("titles", "Panel titles (comma separated)"),
            PropSpec.Text("bodies", "Panel bodies (comma separated)") };
        PropSpec act = PropSpec.Int("active", "Open panel (-1 = none)");
        act.snum = open;
        ps.Add(act);
        ps.Add(PropSpec.Text("class", "Classes"));
        return ps;
    }

    /// 设计器仍把标题和内容作为独立的序列化
    /// 属性暴露，但运行时状态仍是单一的面板实体列表。
    override string GetExtra(string key) {
        List<string> values = new List<string>();
        for (int i = 0; i < panels.Count; i = i + 1) {
            if (key == "titles") { values.Add(panels[i].title); }
            else if (key == "bodies") { values.Add(panels[i].body); }
            else { return ""; }
        }
        return string.Join(",", values);
    }

    override bool SetExtra(string key, string val) {
        if (key != "titles" && key != "bodies") { return false; }
        List<string> values = val.Split(",");
        List<CollapsePanel> next = new List<CollapsePanel>();
        int count = panels.Count;
        if (values.Count > count) { count = values.Count; }
        for (int i = 0; i < count; i = i + 1) {
            string title = "";
            string body = "";
            if (i < panels.Count) {
                title = panels[i].title;
                body = panels[i].body;
            }
            if (i < values.Count) {
                if (key == "titles") { title = values[i]; }
                else { body = values[i]; }
            }
            next.Add(new CollapsePanel(title, body));
        }
        panels = next;
        return true;
    }

    override List<string> Events() {
        List<string> e = Control.CommonEvents();
        e.Add("Change");
        return e;
    }

    override void BindEvent(string evt, Action a) {
        if (evt == "Change") { Change.Add(a); return; }
        On.AddByName(evt, a);
    }
}
