using System;
using Gui;

namespace Gui.Widget;

/// A vertical scroll container for a retained UiDoc subtree.
///
/// Children are docked "top" (each with its own height); the column stacks
/// them, and when the total content is taller than the container it offsets
/// them by a self-managed scroll amount, clips them to its bounds (RenderTree
/// already pushes a clip), hides the rows scrolled out of view (so they take
/// no clicks) and draws a draggable scrollbar. It reuses the immediate-mode
/// ScrollView helper for wheel/drag/scrollbar so the behaviour matches the
/// other scrolling views. Register it in a document with type "ScrollColumn".
class ScrollColumn : Control {
    ScrollView sv;
    int contentH;
    int barReserve;

    void InitScrollColumn() {
        this.InitControl("scroll", 0);
        sv = new ScrollView();
        sv.SetEdgeInset(false);
        contentH = 0;
        barReserve = 12;
    }

    ScrollColumn() {
        InitScrollColumn();
    }

    override string Kind() { return "Panel"; }

    override void OnMeasure(App app) {
        barReserve = app.Scale(12);
    }

    /// Stacks children top-to-bottom at their natural heights, shifted up by
    /// the current scroll offset; rows fully outside the viewport are hidden.
    override void Arrange(int px, int py, int pw, int ph) {
        if (pw < 0) { pw = 0; }
        if (ph < 0) { ph = 0; }
        bx = px;
        by = py;
        bw = pw;
        bh = ph;

        int gapPx = this.StyleGap();
        int innerW = pw - barReserve;
        if (innerW < 0) { innerW = 0; }

        int off = sv.Offset();
        int cy = py - off;
        int total = 0;
        int shown = 0;
        for (int i = 0; i < children.Count; i = i + 1) {
            Control c = children[i];
            int hh = c.StyleHeight();
            if (hh <= 0) { hh = c.prefH; }
            if (hh < 0) { hh = 0; }
            bool onScreen = (cy + hh) > py && cy < (py + ph);
            c.visible = onScreen;
            if (onScreen) { c.Arrange(px, cy, innerW, hh); }
            cy = cy + hh + gapPx;
            total = total + hh + gapPx;
            shown = shown + 1;
        }
        if (shown > 0) { total = total - gapPx; }
        contentH = total;
    }

    override void OnPaint(App app) {
        Rect area = new Rect(bx, by, bw, bh);
        // Process the wheel/drag and draw the scrollbar; the new offset is
        // applied on the next Arrange (a redraw is requested when it changes).
        int dy = sv.Begin(app, area, contentH);
        sv.End(app, area);
    }
}
