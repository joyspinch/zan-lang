using System;
using Gui;

namespace Gui.Widget;

/// 用于有状态 UiDoc 子树的垂直滚动容器。
///
/// 子控件停靠为 "top"（各自带高度）；列将其堆叠，
/// 当内容总高度超过容器时，按自管理的滚动量
/// 向上偏移，并裁剪到其边界内（RenderTree
/// 已推入裁剪区），隐藏滚出视野的行（使其不响应
/// 点击），并绘制可拖动的滚动条。它复用立即模式
/// ScrollView 辅助类处理滚轮/拖动/滚动条，使行为与
/// 其他滚动视图一致。在文档中以 "ScrollColumn" 类型注册。
class ScrollColumn : Control {
    /// 滚轮/拖动/滚动条共用的立即模式滚动状态。
    ScrollView sv;
    /// Arrange 后写出：子控件总内容高度（px），供滚动计算。
    int contentH;
    /// 滚动条预留宽度（缩放后，OnMeasure 刷新）。
    int barReserve;

    /// 初始化：以 "scroll" 注册（子控件停靠堆叠），置共享滚动状态
    /// 与滚动条预留宽。
    void InitScrollColumn() {
        this.InitControl("scroll", 0);
        sv = new ScrollView();
        sv.SetEdgeInset(false);
        contentH = 0;
        barReserve = 12;
    }

    /// 空滚动列（子控件停靠 top 依次堆叠）。
    ScrollColumn() {
        InitScrollColumn();
    }

    /// 控件类型标识（序列化/设计器用）。
    override string Kind() { return "ScrollColumn"; }

    /// 覆写：按 DPI 刷新滚动条预留宽度。
    override void OnMeasure(App app) {
        barReserve = app.Scale(12);
    }

    /// 按自然高度自上而下堆叠子控件，向上偏移
    /// 当前滚动量；完全在视口外的行被隐藏。
    override void Arrange(int px, int py, int pw, int ph) {
        if (pw < 0) { pw = 0; }
        if (ph < 0) { ph = 0; }
        bx = px;
        by = py;
        bw = pw;
        bh = ph;

        int gapPx = this.StyleGap();
        int padL = this.StylePadL();
        int padT = this.StylePadT();
        int padR = this.StylePadR();
        int padB = this.StylePadB();
        int innerW = pw - padL - padR - barReserve;
        if (innerW < 0) { innerW = 0; }

        int off = sv.Offset();
        int cy = py + padT - off;
        int total = padT + padB;
        int shown = 0;
        for (int i = 0; i < children.Count; i = i + 1) {
            Control c = children[i];
            int hh = c.StyleHeight();
            if (hh <= 0) { hh = c.prefH; }
            if (hh < 0) { hh = 0; }
            bool onScreen = (cy + hh) > py && cy < (py + ph);
            c.visible = onScreen;
            if (onScreen) { c.Arrange(px + padL, cy, innerW, hh); }
            cy = cy + hh + gapPx;
            total = total + hh + gapPx;
            shown = shown + 1;
        }
        if (shown > 0) { total = total - gapPx; }
        contentH = total;
    }

    /// 覆写：处理滚轮/拖动并绘制滚动条；新滚动量在下次 Arrange 生效。
    override void OnPaint(App app) {
        Rect area = new Rect(bx, by, bw, bh);
        // 处理滚轮/拖动并绘制滚动条；新偏移量
        // 在下次 Arrange 时生效（变化时请求重绘）。
        int dy = sv.Begin(app, area, contentH);
        sv.End(app, area);
    }
}
