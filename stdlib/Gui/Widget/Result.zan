using System;
using Gui;

namespace Gui.Widget;

/// A result page: a large status glyph on a disc, a title and a description.
/// The status is a semantic class like everywhere else in the design system, so
/// a skin restyles it and the code side is plain assignment:
///
///     Result r = new Result { Text = "Published", Class = "success" };
///     r.Desc = "The executable is ready.";
///
/// Classes: `info` (default) / `success` / `warning` / `error` pick the accent
/// and the default glyph; `result::icon`, `result::title` and `result::desc` are
/// the styled parts.
class Result : Control {
    Binding<string> Text;
    Binding<string> Desc;
    /// Overrides the glyph the status class implies.
    string Icon;

    void InitResult(string ttl, string ds) {
        this.InitControl(ttl, 1);
        Text = ttl;
        Desc = ds;
        Icon = "";
        Class = "info";
    }

    Result() { InitResult("", ""); }
    Result(string ttl, string ds) { InitResult(ttl, ds); }

    string Label() {
        if (Text == null) { return ""; }
        return Text.Get();
    }

    string Description() {
        if (Desc == null) { return ""; }
        return Desc.Get();
    }

    override void OnMeasure(App app) {
        StyleBox s = this.ResolveStyleAs(app, "result", Class, Style.SNormal());
        prefH = Result.ActionsY(app, this.Description() != "");
        prefW = s.WidthOr(app.Scale(360));
    }

    override void OnPaint(App app) {
        Result.Paint(app, bx, by, bw, this.Label(), this.Description(), Icon,
                     Class);
    }

    /// The class a numeric status stands for: 0 info, 1 success, 2 warning,
    /// 3 error -- what a document or a designer field stores. Offset onto the
    /// design system's shared role scale rather than repeating its table.
    static string StatusClass(int status) {
        return Style.TypeClass(status + 2);
    }

    /// The glyph a status class implies ("info" unless it names another role).
    static string GlyphOf(string cls) {
        string role = Style.RoleClass(cls);
        if (role == "" || role == "primary") { return "info"; }
        return role;
    }

    static void Paint(App app, int x, int y, int w, string title, string desc,
                      string icon, string cls) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        StyleBox s = Style.Of(app, "result", cls, Style.SNormal());
        StyleBox gs = Style.Part(app, "result", "icon", "", cls, "",
                                 Style.SNormal());
        StyleBox ts = Style.Part(app, "result", "title", "", cls, "",
                                 Style.SNormal());
        StyleBox ds = Style.Part(app, "result", "desc", "", cls, "",
                                 Style.SNormal());

        string glyph = icon;
        if (glyph == "") { glyph = Result.GlyphOf(cls); }
        // The status class carries the accent; the icon part only overrides it.
        int accent = gs.FgOr(s.AccentOr(t.info));
        int disc = gs.HeightOr(app.Scale(64));
        int cx = x + w / 2;
        c.FillCircle(cx, y + disc / 2, disc / 2, gs.BgOr(t.bgSecondary));
        Icon.DrawCenteredIn(c, glyph, cx - disc / 2, y, disc, disc,
                            gs.FontOr(disc / 2 + app.Scale(2)), accent);

        int tf = ts.FontOr(t.fontSizeLarge);
        int ty = y + disc + t.gapLarge;
        c.DrawTextCentered(x, ty, w, Canvas.FontHeight(tf), title,
                           ts.FgOr(t.textPrimary), tf);
        if (desc == "") { return; }
        int df = ds.FontOr(t.fontSizeMedium);
        c.DrawTextCentered(x, ty + Canvas.FontHeight(tf) + t.gapSmall, w,
                           Canvas.FontHeight(df), desc,
                           ds.FgOr(t.textSecondary), df);
    }

    /// Immediate-mode result in the look `status` selects (0 info … 3 error).
    static void Render(App app, int x, int y, int w, int status, string title,
                       string desc) {
        Result.Paint(app, x, y, w, title, desc, "",
                     Result.StatusClass(status));
    }

    /// Y offset (relative to render y) where custom action content can begin.
    static int ActionsY(App app, bool hasDesc) {
        Theme t = app.theme;
        int yoff = app.Scale(64) + t.gapLarge + Canvas.FontHeight(t.fontSizeLarge);
        if (hasDesc) { yoff = yoff + t.gapSmall + Canvas.FontHeight(t.fontSizeMedium); }
        return yoff + t.gapLarge;
    }

    // ---- designer / serialization model -------------------------------------

    override string Kind() { return "Result"; }

    override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec text = PropSpec.Text("text", "Text");
        text.str = Text;
        text.AsName();
        ps.Add(text);
        PropSpec desc = PropSpec.Text("desc", "Description");
        desc.str = Desc;
        ps.Add(desc);
        PropSpec icon = PropSpec.Text("icon", "Icon");
        icon.str = Icon;
        ps.Add(icon);
        ps.Add(PropSpec.Text("class", "Classes"));
        return ps;
    }

    /// A numeric `status` from an older document picks the role class.
    override bool SetExtra(string key, string val) {
        if (key != "status") { return false; }
        Class = Result.StatusClass(Convert.ToInt32(val));
        return true;
    }
}
