using System;
using Gui;

namespace Gui.Widget;

/// 结果页：圆盘上的大型状态图标，加标题和描述。
/// 状态与设计系统其他各处一样是语义 class，
/// 皮肤可重新样式化，代码侧只是普通赋值：
///
///     Result r = new Result { Text = "Published", Class = "success" };
///     r.Desc = "The executable is ready.";
///
/// class：`info`（默认）/ `success` / `warning` / `error` 决定强调色
/// 和默认图标；`result::icon`、`result::title` 与 `result::desc` 是
/// 可设置样式的部件。
class Result : Control {
    Binding<string> Text;
    Binding<string> Desc;
    /// 覆盖状态 class 隐含的图标。
    string Icon;

    void InitResult(string ttl, string ds) {
        this.InitControl(ttl, 1);
        Text = ttl;
        Desc = ds;
        Icon = "";
        Class = "info";
    }

    Result() { InitResult("", ""); }
    Result(string ttl, string ds) { InitResult(ttl, ds); }

    string Label() {
        if (Text == null) { return ""; }
        return Text.Get();
    }

    string Description() {
        if (Desc == null) { return ""; }
        return Desc.Get();
    }

    override void OnMeasure(App app) {
        StyleBox s = this.ResolveStyleAs(app, "result", Class, Style.SNormal());
        prefH = Result.ActionsY(app, this.Description() != "");
        prefW = s.WidthOr(app.Scale(360));
    }

    override void OnPaint(App app) {
        string title = this.Label();
        string desc = this.Description();
        string icon = Icon;
        string cls = Class;

        Canvas c = app.canvas;
        Theme t = app.theme;
        StyleBox s = Style.Of(app, "result", cls, Style.SNormal());
        StyleBox gs = Style.Part(app, "result", "icon", "", cls, "",
                                 Style.SNormal());
        StyleBox ts = Style.Part(app, "result", "title", "", cls, "",
                                 Style.SNormal());
        StyleBox ds = Style.Part(app, "result", "desc", "", cls, "",
                                 Style.SNormal());

        string glyph = icon;
        if (glyph == "") { glyph = Result.GlyphOf(cls); }
        // 状态 class 决定强调色；icon 部件只负责覆盖它。
        int accent = gs.FgOr(s.AccentOr(0));
        int disc = gs.HeightOr(app.Scale(64));
        int cx = bx + bw / 2;
        c.FillCircle(cx, by + disc / 2, disc / 2, gs.BgOr(0));
        c.DrawGlyphIn(glyph, cx - disc / 2, by, disc, disc,
                            gs.FontOr(disc / 2 + app.Scale(2)), accent);

        int tf = ts.FontOr(Style.FontFallback(app, "large"));
        int ty = by + disc + t.gapLarge;
        c.DrawTextCentered(bx, ty, bw, Canvas.FontHeight(tf), title,
                           ts.FgOr(0), tf);
        if (desc == "") { return; }
        int df = ds.FontOr(Style.FontFallback(app, "medium"));
        c.DrawTextCentered(bx, ty + Canvas.FontHeight(tf) + t.gapSmall, bw,
                           Canvas.FontHeight(df), desc,
                           ds.FgOr(0), df);
    }



    /// 数字状态对应的 class：0 info、1 success、2 warning、
    /// 3 error——文档或设计器字段存储的值。取设计系统共享角色刻度上的偏移，
    /// 而不是重复其映射表。
    static string StatusClass(int status) {
        return Style.TypeClass(status + 2);
    }

    /// 状态 class 隐含的图标（未指明其他角色时为 "info"）。
    static string GlyphOf(string cls) {
        string role = Style.RoleClass(cls);
        if (role == "" || role == "primary") { return "info"; }
        return role;
    }




    /// 自定义操作内容可开始绘制的 Y 偏移（相对渲染 y）。
    static int ActionsY(App app, bool hasDesc) {
        Theme t = app.theme;
        StyleBox ts = Style.Part(app, "result", "title", "", "", "",
                                 Style.SNormal());
        int yoff = app.Scale(64) + t.gapLarge
            + Canvas.FontHeight(ts.FontOr(Style.FontFallback(app, "large")));
        if (hasDesc) {
            StyleBox ds = Style.Part(app, "result", "desc", "", "", "",
                                     Style.SNormal());
            yoff = yoff + t.gapSmall
                + Canvas.FontHeight(ds.FontOr(Style.FontFallback(app, "medium")));
        }
        return yoff + t.gapLarge;
    }

    // ---- designer / serialization model -------------------------------------

    override string Kind() { return "Result"; }

    override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec text = PropSpec.Text("text", "Text");
        text.str = Text;
        text.AsName();
        ps.Add(text);
        PropSpec desc = PropSpec.Text("desc", "Description");
        desc.str = Desc;
        ps.Add(desc);
        PropSpec icon = PropSpec.Text("icon", "Icon");
        icon.str = Icon;
        ps.Add(icon);
        ps.Add(PropSpec.Text("class", "Classes"));
        return ps;
    }

    /// 旧文档中的数字 `status` 选择对应的角色 class。
    override bool SetExtra(string key, string val) {
        if (key != "status") { return false; }
        Class = Result.StatusClass(Convert.ToInt32(val));
        return true;
    }
}
