using System;
using Gui;

namespace Gui.Widget;

/// 小型浮动提示面板（查找、跳转到行、重命名等）：带标题的
/// 表面上有单行文本框，文本归调用方所有，
/// 因此调用方完全掌控按键处理，而面板保持
/// 主题外观。
class Prompt {
    /// 单个文本框行的高度。
    static int FieldHeight(App app) { return app.Scale(22); }

    /// 含 `rows` 行文本框的面板高度。
    static int Height(App app, int rows) {
        if (rows < 1) { rows = 1; }
        return app.Scale(14) + rows * Prompt.FieldHeight(app)
            + (rows - 1) * app.Scale(6);
    }

    /// 面板表面及其标题。字段和按钮在其上绘制。
    static void Surface(App app, int x, int y, int w, int h, string caption) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        StyleBox s = Style.Of(app, "prompt", "", Style.SNormal());
        app.FillChrome(x, y, w, h, s.RadiusOr(t.borderRadiusSmall), s.bg);
        c.DrawRect(x, y, w, h, s.borderColor, s.BorderWOr(1));
        if (caption != "") {
            Prompt.Caption(app, x, y, caption);
        }
    }

    /// 面板的标题，用于标题需在表面
    /// 绘制后才计算的面板。
    static void Caption(App app, int x, int y, string caption) {
        Theme t = app.theme;
        StyleBox cs = Style.Part(app, "prompt", "caption", "", "", "",
                                 Style.SNormal());
        app.canvas.DrawText(x + app.Scale(4), y + app.Scale(2), caption,
                            cs.fg, cs.FontOr(t.fontSizeSmall));
    }

    /// 显示调用方所有文本的单行字段，超出框体部分裁剪。
    static void Field(App app, int x, int y, int w, string text) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int h = Prompt.FieldHeight(app);
        StyleBox fs = Style.Part(app, "prompt", "field", "", "", "",
                                 Style.SNormal());
        c.FillRect(x, y, w, h, fs.bg);
        c.DrawRect(x, y, w, h, fs.borderColor, fs.BorderWOr(1));
        int pad = app.Scale(4);
        c.DrawText(x + pad, y + pad,
                   Ellipsis.Fit(text, w - pad * 2, t.fontSizeSmall),
                   fs.fg, fs.FontOr(t.fontSizeSmall));
    }
}
