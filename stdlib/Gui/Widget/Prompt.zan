using System;
using Gui;

namespace Gui.Widget;

/// A small floating prompt panel (find, go-to-line, rename, ...): a captioned
/// surface with single-line text fields whose text the caller owns, so the
/// caller keeps full control of the keystroke handling while the panel keeps
/// the theme's look.
class Prompt {
    /// Height of one text field row.
    static int FieldHeight(App app) { return app.Scale(22); }

    /// Height of a panel with `rows` field rows.
    static int Height(App app, int rows) {
        if (rows < 1) { rows = 1; }
        return app.Scale(14) + rows * Prompt.FieldHeight(app)
            + (rows - 1) * app.Scale(6);
    }

    /// The panel surface plus its caption. Draw the fields and buttons on top.
    static void Surface(App app, int x, int y, int w, int h, string caption) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        app.FillChrome(x, y, w, h, t.borderRadiusSmall, t.bgSecondary);
        c.DrawRect(x, y, w, h, t.borderPrimary, 1);
        if (caption != "") {
            c.DrawText(x + app.Scale(4), y + app.Scale(2), caption,
                       t.textTertiary, t.fontSizeSmall);
        }
    }

    /// The panel's caption, for panels whose caption is computed after the
    /// surface is drawn.
    static void Caption(App app, int x, int y, string caption) {
        Theme t = app.theme;
        app.canvas.DrawText(x + app.Scale(4), y + app.Scale(2), caption,
                            t.textTertiary, t.fontSizeSmall);
    }

    /// A single-line field showing caller-owned text, clipped to the box.
    static void Field(App app, int x, int y, int w, string text) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int h = Prompt.FieldHeight(app);
        app.canvas.FillRect(x, y, w, h, app.theme.bgPrimary);
        app.canvas.DrawRect(x, y, w, h,
            app.theme.borderPrimary, 1);
        int pad = app.Scale(4);
        c.DrawText(x + pad, y + pad,
                   Ellipsis.Fit(text, w - pad * 2, t.fontSizeSmall),
                   t.textPrimary, t.fontSizeSmall);
    }
}
