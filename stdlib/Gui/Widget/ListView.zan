using System;
using Gui;

namespace Gui.Widget;

/// Reads one column's text out of a bound entity: `new ListColumn<File>("Name",
/// f => f.name)`.
delegate string CellOf<T>(T item);

/// Builds a row's own control subtree for one bound entity, for a list whose
/// rows are a custom component instead of columns of text.
delegate Control RowOf<T>(T item);

/// One column of a ListView: what its header says, how wide it is relative to
/// the others (0 = equal share) and how to read its text from an entity.
class ListColumn<T> {
    string title;
    int weight;
    bool right;
    CellOf<T> cell;

    ListColumn(string title, CellOf<T> cell) {
        this.title = title;
        this.weight = 0;
        this.right = false;
        this.cell = cell;
    }

    ListColumn(string title, int weight, CellOf<T> cell) {
        this.title = title;
        this.weight = weight;
        this.right = false;
        this.cell = cell;
    }

    /// Right-aligns this column's text (numbers, sizes, dates).
    ListColumn<T> Right() {
        right = true;
        return this;
    }

    string TextOf(T item) {
        if (cell == null) { return ""; }
        return cell(item);
    }
}

/// A list bound to the caller's own data. Three things go in -- what the rows
/// look like, the data, the handlers -- and nothing about layout does: the
/// control sits in a tree and CSS decides its box, so no call site computes a
/// rectangle or holds a row model.
///
///     ListView<FileItem> files = new ListView<FileItem>(cols);
///     files.Bind(model.files);          // the caller's List<FileItem>
///     files.OnSelect(OpenSelected);
///     side.Add(files);
///
/// A row can be a component of its own instead of columns of text -- the
/// template returns any control:
///
///     ListView<Msg> feed = new ListView<Msg>(m => MessageCard(m));
///     feed.Bind(model.inbox);
///
/// Handlers are marshalled onto the UI thread (UiEvent.Post), so a background
/// job that mutates the bound list and calls Refresh() is safe.
class ListView<T> : Control {
    /// The caller's data. Nothing is copied: the rows are read from it every
    /// frame, so mutating the list shows up on the next paint.
    List<T> data;
    List<ListColumn<T>> cols;
    RowOf<T> rowOf;
    /// Centred while the list has no rows ("" draws nothing).
    string Empty;
    int sel;
    int hover;
    SignalInt scroll;
    /// Template mode: one allocated row id per built child, so selection
    /// survives a frame in which nothing was rebuilt.
    bool rowsStale;
    int builtFor;

    /// A row was selected (read SelectedIndex / Selected).
    UiEvent Select;
    /// The selected row was clicked again (open / drill in).
    UiEvent Activate;
    /// A row was right-clicked.
    UiEvent Context;

    void InitList() {
        this.InitControl("list", 5);
        data = null;
        cols = new List<ListColumn<T>>();
        rowOf = null;
        Empty = "";
        sel = -1;
        hover = -1;
        scroll = SignalInt.Create(0);
        rowsStale = true;
        builtFor = -1;
        wiresOwnEvents = true;
        Select = UiEvent.Create();
        Activate = UiEvent.Create();
        Context = UiEvent.Create();
    }

    /// Single column of plain text (`item.ToString()` is not assumed: bind a
    /// column when the entity is not a string).
    ListView() { InitList(); }

    /// The usual form: the columns up front.
    ListView(List<ListColumn<T>> columns) {
        InitList();
        if (columns != null) { cols = columns; }
    }

    /// One column, for a plain list of labels.
    ListView(ListColumn<T> column) {
        InitList();
        if (column != null) { cols.Add(column); }
    }

    /// Custom rows: the template builds each row's control subtree.
    ListView(RowOf<T> row) {
        InitList();
        rowOf = row;
    }

    override string Kind() { return "ListView"; }

    override string StyleType() { return "list"; }

    // ---- data ---------------------------------------------------------------

    /// Binds the caller's list. The list is not copied, so this is a live view
    /// of it; call Refresh() after a change that has to rebuild custom rows.
    ListView<T> Bind(List<T> src) {
        data = src;
        rowsStale = true;
        if (sel >= this.Count()) { sel = -1; }
        return this;
    }

    /// Marks the bound data as changed, so custom rows are rebuilt on the next
    /// frame. Safe from any thread.
    void Refresh() { rowsStale = true; }

    int Count() {
        if (data == null) { return 0; }
        return data.Count;
    }

    int SelectedIndex() { return sel; }

    bool HasSelection() { return sel >= 0 && sel < this.Count(); }

    /// The selected entity; only valid while HasSelection().
    T Selected() { return data[sel]; }

    bool Has(int row) { return row >= 0 && row < this.Count(); }

    /// Entity at `row`; only valid while Has(row).
    T ItemAt(int row) { return data[row]; }

    /// Moves the selection as a click would, raising Select when it changed.
    void SelectIndex(int row) {
        if (row < -1 || row >= this.Count()) { return; }
        if (sel == row) { return; }
        sel = row;
        Select.Post();
    }

    void ClearSelection() { sel = -1; }

    // ---- handlers -----------------------------------------------------------

    ListView<T> OnSelect(Action a) { Select.Add(a); return this; }
    ListView<T> OnActivate(Action a) { Activate.Add(a); return this; }
    ListView<T> OnContext(Action a) { Context.Add(a); return this; }

    /// Text shown while the list is empty.
    ListView<T> EmptyText(string text) { Empty = text; return this; }

    // ---- internals ----------------------------------------------------------

    bool Templated() { return rowOf != null; }

    int RowHeight(App app) {
        StyleBox s = this.ResolveStyleAs(app, "list", Class, Style.SNormal());
        return s.HeightOr(app.theme.heightLarge);
    }

    int HeaderHeight(App app) {
        if (cols.Count < 2 || Style.Has(Class, "headless")) { return 0; }
        return app.theme.heightSmall;
    }

    /// Rebuilds one child control per entity through the row template. Children
    /// are measured here because the tree's measure pass has already walked
    /// past them by the time a rebuild is noticed.
    void BuildRows(App app) {
        if (!rowsStale && builtFor == this.Count()) { return; }
        children = new List<Control>();
        int n = this.Count();
        int i = 0;
        while (i < n) {
            Control row = rowOf(data[i]);
            if (row != null) {
                row.parent = this;
                row.dock = 1;
                children.Add(row);
            }
            i = i + 1;
        }
        rowsStale = false;
        builtFor = n;
        int k = 0;
        while (k < children.Count) {
            children[k].MeasureTree(app);
            k = k + 1;
        }
    }

    /// Total height of the rows, which is what a column layout sizes the list
    /// from when the sheet declares no height.
    int ContentHeight(App app) {
        if (this.Templated()) {
            int h = 0;
            int i = 0;
            while (i < children.Count) {
                h = h + this.RowExtent(app, children[i]);
                i = i + 1;
            }
            return h;
        }
        return this.Count() * this.RowHeight(app);
    }

    int RowExtent(App app, Control row) {
        int h = row.prefH;
        if (h <= 0) { h = this.RowHeight(app); }
        return h;
    }

    /// Selection / activation / context for one row's box. Returns the id it
    /// registered so the caller can paint hover state from it.
    int RowInteract(App app, int index, int x, int y, int w, int h) {
        int id = app.focus.AllocId();
        app.hitTester.Register(HitRegion.Create(id, x, y, w, h, 0));
        if (app.focus.IsHovered(id)) { hover = index; }
        int hit = app.hitTester.HitTest(app.mouseX, app.mouseY);
        if (hit != id) { return id; }
        if (app.ClickAvailable()) {
            bool again = (sel == index);
            sel = index;
            if (again) { Activate.Post(); }
            else { Select.Post(); }
            app.RequestRedraw();
            app.window.Wake();
        } else if (app.EventKind() == 2 && app.window.EventButton() == 1) {
            sel = index;
            Context.Post();
            app.RequestRedraw();
            app.window.Wake();
        }
        return id;
    }

    void PaintEmpty(App app) {
        if (Empty == "") { return; }
        Theme t = app.theme;
        int fw = Canvas.MeasureText(Empty, t.fontSizeSmall);
        app.canvas.DrawText(bx + (bw - fw) / 2,
            by + (bh - Canvas.FontHeight(t.fontSizeSmall)) / 2,
            Empty, t.textSecondary, t.fontSizeSmall);
    }

    /// Column widths for the current box: a column's weight is its share of the
    /// row, and all-zero weights share it equally.
    List<int> ColumnWidths(int rowW) {
        List<int> res = new List<int>();
        int total = 0;
        int i = 0;
        while (i < cols.Count) {
            int wt = cols[i].weight;
            if (wt <= 0) { wt = 1; }
            total = total + wt;
            i = i + 1;
        }
        if (total <= 0) { return res; }
        int used = 0;
        i = 0;
        while (i < cols.Count) {
            int wt = cols[i].weight;
            if (wt <= 0) { wt = 1; }
            int cw = rowW * wt / total;
            if (i == cols.Count - 1) { cw = rowW - used; }
            used = used + cw;
            res.Add(cw);
            i = i + 1;
        }
        return res;
    }

    void PaintHeader(App app, int headH) {
        if (headH <= 0) { return; }
        Canvas c = app.canvas;
        Theme t = app.theme;
        int pad = t.paddingMedium;
        c.FillRect(bx, by, bw, headH, t.bgSecondary);
        c.FillRect(bx, by + headH - 1, bw, 1, t.divider);
        List<int> ws = this.ColumnWidths(bw - pad * 2);
        int cx = bx + pad;
        int i = 0;
        int ty = by + (headH - Canvas.FontHeight(t.fontSizeTiny)) / 2;
        while (i < ws.Count) {
            int cw = ws[i];
            string label = Ellipsis.Fit(cols[i].title, cw - pad, t.fontSizeTiny);
            int tx = cx;
            if (cols[i].right) {
                tx = cx + cw - pad - Canvas.MeasureText(label, t.fontSizeTiny);
            }
            c.DrawText(tx, ty, label, t.textTertiary, t.fontSizeTiny);
            cx = cx + cw;
            i = i + 1;
        }
    }

    void PaintColumnRows(App app, int headH) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int rowH = this.RowHeight(app);
        int viewY = by + headH;
        int viewH = bh - headH;
        if (viewH <= 0 || rowH <= 0) { return; }
        int n = this.Count();
        int contentH = n * rowH;
        Scrollbar.HandleWheel(app, bx, viewY, bw, viewH, contentH, scroll);
        int maxOff = contentH - viewH;
        if (maxOff < 0) { maxOff = 0; }
        if (scroll.Get() > maxOff) { scroll.Set(maxOff); }
        if (scroll.Get() < 0) { scroll.Set(0); }
        int off = scroll.Get();
        bool overflow = contentH > viewH;
        int barW = app.Scale(10);
        int rowW = bw;
        if (overflow) { rowW = bw - barW; }
        int pad = t.paddingMedium;
        List<int> ws = this.ColumnWidths(rowW - pad * 2);

        int first = off / rowH;
        int last = (off + viewH) / rowH;
        if (last >= n) { last = n - 1; }
        c.PushClip(bx, viewY, rowW, viewH);
        int i = first;
        while (i <= last) {
            int ry = viewY + i * rowH - off;
            int id = this.RowInteract(app, i, bx, ry, rowW, rowH);
            if (i == sel) { c.FillRect(bx, ry, rowW, rowH, t.bgTertiary); }
            else if (app.focus.IsHovered(id)) {
                c.FillRect(bx, ry, rowW, rowH, t.bgSecondary);
            }
            if (i > first || off > 0) { c.FillRect(bx, ry, rowW, 1, t.divider); }
            int ty = ry + (rowH - Canvas.FontHeight(t.fontSizeSmall)) / 2;
            int cx = bx + pad;
            int k = 0;
            while (k < ws.Count) {
                int cw = ws[k];
                string s = Ellipsis.Fit(cols[k].TextOf(data[i]), cw - pad,
                                        t.fontSizeSmall);
                int color = t.textPrimary;
                if (k > 0) { color = t.textSecondary; }
                int tx = cx;
                if (cols[k].right) {
                    tx = cx + cw - pad - Canvas.MeasureText(s, t.fontSizeSmall);
                }
                c.DrawText(tx, ty, s, color, t.fontSizeSmall);
                cx = cx + cw;
                k = k + 1;
            }
            i = i + 1;
        }
        c.PopClip();
        if (overflow) {
            Scrollbar.RenderVerticalScroll(app, bx + bw - barW, viewY, viewH,
                                           viewH, contentH, scroll);
        }
    }

    /// Lays the template rows out inside this box with the scroll offset
    /// applied. Runs from OnPaint, i.e. before the children paint themselves,
    /// so the tree stays the single owner of their coordinates.
    void ArrangeRows(App app, int headH) {
        int viewY = by + headH;
        int viewH = bh - headH;
        if (viewH <= 0) { return; }
        int contentH = this.ContentHeight(app);
        Scrollbar.HandleWheel(app, bx, viewY, bw, viewH, contentH, scroll);
        int maxOff = contentH - viewH;
        if (maxOff < 0) { maxOff = 0; }
        if (scroll.Get() > maxOff) { scroll.Set(maxOff); }
        if (scroll.Get() < 0) { scroll.Set(0); }
        int off = scroll.Get();
        bool overflow = contentH > viewH;
        int barW = app.Scale(10);
        int rowW = bw;
        if (overflow) { rowW = bw - barW; }
        Theme t = app.theme;
        int y = viewY - off;
        int i = 0;
        while (i < children.Count) {
            Control row = children[i];
            int rh = this.RowExtent(app, row);
            row.Arrange(bx, y, rowW, rh);
            row.visible = (y + rh > viewY && y < viewY + viewH);
            if (row.visible) {
                int id = this.RowInteract(app, i, bx, y, rowW, rh);
                if (i == sel) { app.canvas.FillRect(bx, y, rowW, rh, t.bgTertiary); }
                else if (app.focus.IsHovered(id)) {
                    app.canvas.FillRect(bx, y, rowW, rh, t.bgSecondary);
                }
            }
            y = y + rh;
            i = i + 1;
        }
        if (overflow) {
            Scrollbar.RenderVerticalScroll(app, bx + bw - barW, viewY, viewH,
                                           viewH, contentH, scroll);
        }
    }

    // ---- retained hooks -----------------------------------------------------

    override void OnMeasure(App app) {
        if (this.Templated()) { this.BuildRows(app); }
        prefH = this.ContentHeight(app) + this.HeaderHeight(app);
    }

    override void OnPaint(App app) {
        StyleBox s = this.ResolveStyleAs(app, "list", Class, Style.SNormal());
        if (!Style.Has(Class, "flat")) {
            app.canvas.SurfaceRoundRect(bx, by, bw, bh,
                s.RadiusOr(app.theme.borderRadiusMedium),
                app.theme.bgPrimary, app.theme.borderSecondary, 1);
        }
        hover = -1;
        int headH = this.HeaderHeight(app);
        this.PaintHeader(app, headH);
        if (this.Count() == 0) {
            this.PaintEmpty(app);
            return;
        }
        if (this.Templated()) {
            this.BuildRows(app);
            this.ArrangeRows(app, headH);
            return;
        }
        this.PaintColumnRows(app, headH);
    }

    override List<string> Events() {
        List<string> e = Control.CommonEvents();
        e.Add("Select");
        e.Add("Activate");
        e.Add("Context");
        return e;
    }
}
