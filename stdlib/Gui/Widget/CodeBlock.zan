using System;
using Gui;

namespace Gui.Widget;

/// A read-only code panel: a captioned header with a copy action and the
/// scrollable, monospaced-looking source lines below it. The caller owns the
/// lines, the scroll signal and what "copy" does, so the widget carries no
/// knowledge of the language or the document it shows.
class CodeBlock {
    static int LineHeight(App app) {
        return Canvas.FontHeight(app.theme.fontSizeSmall) + app.Scale(4);
    }

    static int HeaderHeight(App app) { return app.Scale(28); }

    /// Natural height for `lineCount` lines (clamp it to the space available).
    static int Height(App app, int lineCount) {
        return CodeBlock.HeaderHeight(app)
            + lineCount * CodeBlock.LineHeight(app) + app.Scale(16);
    }

    /// Renders the panel. Returns true when the copy action was clicked.
    static bool Render(App app, int x, int y, int w, int h, string caption,
                       string copyLabel, List<string> lines, SignalInt scroll) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        EditorPalette pal = EditorPalette.For(t);

        int hdrH = CodeBlock.HeaderHeight(app);
        int lineH = CodeBlock.LineHeight(app);
        c.FillRoundRect(x, y, w, h, t.borderRadiusMedium, pal.hoverBg);
        c.DrawRect(x, y, w, h, t.borderPrimary, 1);
        c.FillRect(x, y + hdrH, w, 1, pal.panelBg);
        app.canvas.DrawStyledText(
            Style.Of(app, "label", "hint small", Style.SNormal()),
            x + app.Scale(12), y + app.Scale(7), caption,
            app.theme.textPrimary, app.theme.fontSizeMedium);

        int cpW = Canvas.MeasureText(copyLabel, t.fontSizeSmall) + app.Scale(34);
        int cpId = new Button { Text = copyLabel, Icon = "copy", Class = "small" }
            .Render(app, x + w - cpW - app.Scale(8), y + app.Scale(3), cpW);

        int textY = y + hdrH + app.Scale(8);
        int bottom = y + h - app.Scale(6);
        int visible = (bottom - textY) / lineH;
        if (visible < 1) { visible = 1; }
        int maxScroll = lines.Count - visible;
        if (maxScroll < 0) { maxScroll = 0; }
        if (app.CaptureWheel(x, y, w, h)) {
            int delta = app.window.EventKeyCode();
            int step = delta / 120;
            if (step == 0) {
                if (delta > 0) { step = 1; }
                else if (delta < 0) { step = 0 - 1; }
            }
            scroll.Set(scroll.Get() - step * 3);
            app.RequestRedraw();
        }
        int off = scroll.Get();
        if (off > maxScroll) { off = maxScroll; }
        if (off < 0) { off = 0; }
        scroll.Set(off);

        c.PushClip(x, y + hdrH, w, h - hdrH);
        int i = off;
        while (i < lines.Count && textY + lineH <= bottom) {
            c.DrawText(x + app.Scale(12), textY, lines[i], pal.menuText,
                       t.fontSizeSmall);
            textY = textY + lineH;
            i = i + 1;
        }
        c.PopClip();

        if (maxScroll > 0) {
            int viewH = h - hdrH - app.Scale(8);
            SignalInt px = SignalInt.Create(off * lineH);
            Scrollbar.RenderVerticalScroll(app, x + w - app.Scale(10),
                y + hdrH + app.Scale(4), viewH, viewH,
                lines.Count * lineH, px);
            int moved = px.Get() / lineH;
            if (moved != off) {
                scroll.Set(moved);
                app.RequestRedraw();
            }
        }
        return Ui.Clicked(app, cpId);
    }
}