using System;
using Gui;
using Gui.Component;
using Gui.Component.CodeEditor;

namespace Gui.Widget;

/// A read-only code panel: a captioned header with a copy action and the
/// scrollable, monospaced-looking source lines below it. The caller owns the
/// lines and what "copy" does, so the widget carries no knowledge of the
/// language or the document it shows.
///
///     CodeBlock cb = new CodeBlock("Zan", lines);
///     cb.Copy += () => { Clipboard.Set(text); };
///     cb.RenderInside(app, rect);
class CodeBlock : Control {
    List<string> lines;
    /// Header caption, usually the language.
    Binding<string> Caption;
    /// Label on the copy action.
    Binding<string> CopyLabel;
    SignalInt scroll;
    bool copied;
    int wid;
    // Selection state. The code is read-only but selectable (drag, Ctrl+A,
    // Ctrl+C), and only one block can own a selection at a time, so the state
    // is shared and tagged with the owning block's focus id -- which also lets
    // it survive hosts that rebuild the widget every frame.
    static int selOwner;
    static bool selActive;
    static bool selDragging;
    static int selAnchorLine;
    static int selAnchorCol;
    static int selLine;
    static int selCol;
    /// Fires when the copy action is clicked.
    UiEvent Copy;

    void InitCodeBlock(string caption, List<string> src) {
        this.InitControl("codeblock", 1);
        lines = src;
        Caption = caption;
        CopyLabel = "Copy";
        scroll = SignalInt.Create(0);
        copied = false;
        wid = WidgetId.Next();
        wiresOwnEvents = true;
        Copy = UiEvent.Create();
    }

    CodeBlock() { InitCodeBlock("", new List<string>()); }
    CodeBlock(string caption, List<string> src) { InitCodeBlock(caption, src); }

    /// Scrolls through a signal the host owns, so the offset survives a
    /// rebuild of the panel.
    void UseScroll(SignalInt s) {
        scroll = s;
    }

    /// True when the copy action was clicked in the frame just painted, for
    /// hosts that would rather test than subscribe to `Copy`.
    bool Copied() { return copied; }

    /// The lines shown; assigning replaces them, rewinds the scroll and drops
    /// any selection.
    void SetLines(List<string> src) {
        lines = src;
        scroll.Set(0);
        CodeBlock.ClearSelection();
    }

    /// Drops the shared selection, whoever owned it.
    static void ClearSelection() {
        CodeBlock.selActive = false;
        CodeBlock.selDragging = false;
        CodeBlock.selOwner = 0 - 1;
    }

    /// The whole snippet as one string.
    string AllText() { return string.Join("\n", lines); }

    /// The selected text, or "" when this block holds no selection.
    string SelectedText(int owner) {
        if (!CodeBlock.selActive || CodeBlock.selOwner != owner) { return ""; }
        int sL = CodeBlock.selAnchorLine;
        int sC = CodeBlock.selAnchorCol;
        int eL = CodeBlock.selLine;
        int eC = CodeBlock.selCol;
        if (sL > eL || (sL == eL && sC > eC)) {
            int tL = sL; sL = eL; eL = tL;
            int tC = sC; sC = eC; eC = tC;
        }
        if (sL < 0) { sL = 0; }
        if (eL >= lines.Count) { eL = lines.Count - 1; }
        string acc = "";
        int i = sL;
        while (i <= eL) {
            string ln = lines[i];
            int a = 0;
            int b = ln.Length;
            if (i == sL) { a = sC; }
            if (i == eL) { b = eC; }
            if (a < 0) { a = 0; }
            if (b > ln.Length) { b = ln.Length; }
            if (b > a) { acc = acc + ln.Substring(a, b - a); }
            if (i < eL) { acc = acc + "\n"; }
            i = i + 1;
        }
        return acc;
    }

    /// Selects the whole snippet (Ctrl+A).
    void SelectAll(int owner) {
        if (lines.Count == 0) { return; }
        CodeBlock.selOwner = owner;
        CodeBlock.selAnchorLine = 0;
        CodeBlock.selAnchorCol = 0;
        CodeBlock.selLine = lines.Count - 1;
        CodeBlock.selCol = lines[lines.Count - 1].Length;
        CodeBlock.selActive = true;
    }

    /// Maps the pointer to a (line, column) caret inside the code area.
    void CaretFromMouse(App app, int codeX, int topY, int lineH, int off,
                        int font, bool moveAnchor) {
        int l = off + (app.mouseY - topY) / lineH;
        if (l < 0) { l = 0; }
        if (l >= lines.Count) { l = lines.Count - 1; }
        if (l < 0) { return; }
        int col = CodeEditor.ColFromX(lines[l], app.mouseX - codeX, font);
        if (moveAnchor) {
            CodeBlock.selAnchorLine = l;
            CodeBlock.selAnchorCol = col;
        }
        CodeBlock.selLine = l;
        CodeBlock.selCol = col;
    }


    static int LineHeight(App app) {
        return Canvas.FontHeight(app.theme.fontSizeSmall) + app.Scale(4);
    }

    /// Caption bar height: a standard small button plus breathing room above
    /// and below it, so the caption and the copy action are centred in a bar
    /// that fits them instead of a bar the button has to be shrunk into.
    static int HeaderHeight(App app) {
        int h = app.theme.heightSmall + app.Scale(8);
        if (h < app.Scale(32)) { h = app.Scale(32); }
        return h;
    }

    /// Width of the line-number gutter for `lineCount` lines.
    static int GutterWidth(App app, int lineCount) {
        int digits = Canvas.MeasureText(Convert.ToString(lineCount),
                                        app.theme.fontSizeSmall);
        return digits + app.Scale(18);
    }

    /// Default surface: the skin's own panel material, so a code block reads
    /// as one of the surrounding cards rather than as a slab of the editor's
    /// colour scheme -- the editor palette follows the *code theme*, which has
    /// nothing to do with the skin the rest of the page is painted in. A
    /// stylesheet `background` on `codeblock` still wins.
    static int SurfaceColor(App app, EditorPalette pal) {
        StyleBox ps = Style.Of(app, "panel", "", Style.SNormal());
        return ps.BgOr(app.theme.surface);
    }

    /// Natural height for `lineCount` lines (clamp it to the space available).
    static int Height(App app, int lineCount) {
        return CodeBlock.HeaderHeight(app)
            + lineCount * CodeBlock.LineHeight(app) + app.Scale(16);
    }

    override void OnMeasure(App app) {
        prefH = CodeBlock.Height(app, lines.Count);
        int fs = app.theme.fontSizeSmall;
        int widest = 0;
        int i = 0;
        while (i < lines.Count) {
            int lw = Canvas.MeasureText(lines[i], fs);
            if (lw > widest) { widest = lw; }
            i = i + 1;
        }
        prefW = widest + app.Scale(34);
    }

    override void OnPaint(App app) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        EditorPalette pal = EditorPalette.For(t);
        StyleBox s = this.ResolveStyleAs(app, "codeblock", Class,
                                         Style.SNormal());

        int hdrH = CodeBlock.HeaderHeight(app);
        int lineH = CodeBlock.LineHeight(app);
        c.FillRoundRect(bx, by, bw, bh, s.RadiusOr(t.borderRadiusMedium),
                        s.BgOr(CodeBlock.SurfaceColor(app, pal)));
        c.DrawRect(bx, by, bw, bh, s.BorderOr(t.borderPrimary),
                   s.BorderWOr(1));
        c.FillRect(bx, by + hdrH, bw, 1, pal.panelBg);
        StyleBox cs = this.ResolvePartAs(app, "codeblock", "caption", "", Class,
                                         Style.SNormal());
        int capFont = cs.FontOr(t.fontSizeMedium);
        c.DrawText(bx + app.Scale(12),
                   by + (hdrH - Canvas.FontHeight(capFont)) / 2, Caption.Get(),
                   cs.FgOr(t.textPrimary), capFont);

        // The copy action is a standard small button, at its own height and
        // natural width (icon + label + padding, so a translated label is
        // never ellipsized), centred in the caption bar.
        Button cp = new Button { Text = CopyLabel.Get(), Icon = "copy",
                                 Class = "small" };
        int cpH = t.heightSmall;
        int cpW = cp.AutoWidth(app);
        int cpId = cp.RenderIn(app, bx + bw - cpW - app.Scale(8),
                               by + (hdrH - cpH) / 2, cpW, cpH);

        int textY = by + hdrH + app.Scale(8);
        int bottom = by + bh - app.Scale(6);
        int visible = (bottom - textY) / lineH;
        if (visible < 1) { visible = 1; }
        int maxScroll = lines.Count - visible;
        if (maxScroll < 0) { maxScroll = 0; }
        if (app.CaptureWheel(bx, by, bw, bh)) {
            int delta = app.window.EventKeyCode();
            int step = delta / 120;
            if (step == 0) {
                if (delta > 0) { step = 1; }
                else if (delta < 0) { step = 0 - 1; }
            }
            scroll.Set(scroll.Get() - step * 3);
            app.RequestRedraw();
        }
        int off = scroll.Get();
        if (off > maxScroll) { off = maxScroll; }
        if (off < 0) { off = 0; }
        scroll.Set(off);

        StyleBox ls = this.ResolvePartAs(app, "codeblock", "line", "", Class,
                                         Style.SNormal());
        int lineFont = ls.FontOr(t.fontSizeSmall);
        int lineColor = ls.FgOr(pal.plain);
        int gutW = CodeBlock.GutterWidth(app, lines.Count);
        // Gutter: a faint column behind right-aligned line numbers, separated
        // from the code by a hairline -- the editor's reading rhythm in a
        // read-only block.
        c.FillRect(bx + 1, by + hdrH + 1, gutW, bh - hdrH - 2,
                   34 * 16777216 + (pal.panelBg % 16777216));
        c.FillRect(bx + gutW, by + hdrH + 1, 1, bh - hdrH - 2,
                   60 * 16777216 + (pal.border % 16777216));
        int codeX = bx + gutW + app.Scale(10);
        // ---- selectable, read-only text: drag to select, Ctrl+A, Ctrl+C ----
        int fid = app.focus.AllocId();
        bool focused = app.focus.IsFocused(fid);
        bool overCode = app.mouseX >= bx + gutW && app.mouseX < bx + bw
            && app.mouseY >= textY && app.mouseY < bottom;
        if (app.EventKind() == 2 && app.window.EventButton() == 0 && overCode) {
            app.focus.SetFocused(fid);
            focused = true;
            bool shift = Modifiers.HasShift(app.window.EventMods());
            bool keep = shift && CodeBlock.selOwner == fid;
            CodeBlock.selOwner = fid;
            this.CaretFromMouse(app, codeX, textY, lineH, off, lineFont, !keep);
            CodeBlock.selActive = keep;
            CodeBlock.selDragging = true;
            app.RequestRedraw();
        }
        if (app.EventKind() == 1 && CodeBlock.selDragging
            && CodeBlock.selOwner == fid) {
            this.CaretFromMouse(app, codeX, textY, lineH, off, lineFont, false);
            CodeBlock.selActive = CodeBlock.selLine != CodeBlock.selAnchorLine
                || CodeBlock.selCol != CodeBlock.selAnchorCol;
            app.RequestRedraw();
        }
        if (app.EventKind() == 3 && app.window.EventButton() == 0) {
            CodeBlock.selDragging = false;
        }
        if (focused && app.EventKind() == 6) {
            int key = app.window.EventKeyCode();
            if (key == 1) {                                  // Ctrl+A
                this.SelectAll(fid);
                app.RequestRedraw();
            } else if (key == 3) {                           // Ctrl+C
                string sel = this.SelectedText(fid);
                if (sel == "") { sel = this.AllText(); }
                Clipboard.SetText(sel);
                app.RequestRedraw();
            }
        }
        bool showSel = CodeBlock.selActive && CodeBlock.selOwner == fid;

        c.PushClip(bx, by + hdrH, bw, bh - hdrH);
        // Block comments span lines, so the tokenizer state is carried over
        // from the first line -- not from the first *visible* one.
        bool inBlock = false;
        int pre = 0;
        while (pre < off && pre < lines.Count) {
            List<CodeSpan> preSpans = new List<CodeSpan>();
            inBlock = CodeEditor.HighlightSpans(lines[pre], pal.keyword,
                pal.type, pal.str, pal.comment, pal.number, lineColor,
                inBlock, preSpans);
            pre = pre + 1;
        }
        int i = off;
        while (i < lines.Count && textY + lineH <= bottom) {
            string no = Convert.ToString(i + 1);
            int noW = Canvas.MeasureText(no, lineFont);
            c.DrawText(bx + gutW - app.Scale(8) - noW, textY, no,
                       pal.lineNo, lineFont);
            if (showSel) {
                CodeEditor.DrawSelHighlight(c, app, CodeBlock.selAnchorLine,
                    CodeBlock.selAnchorCol, CodeBlock.selLine, CodeBlock.selCol,
                    i, lines[i], codeX, textY, lineH, lineFont,
                    Rect.Create(bx, by, bw, bh));
            }
            List<CodeSpan> spans = new List<CodeSpan>();
            inBlock = CodeEditor.HighlightSpans(lines[i], pal.keyword,
                pal.type, pal.str, pal.comment, pal.number, lineColor,
                inBlock, spans);
            int tx = codeX;
            int g = 0;
            while (g < spans.Count) {
                CodeSpan span = spans[g];
                c.DrawText(tx, textY, span.text, span.color, lineFont);
                tx = tx + Canvas.MeasureText(span.text, lineFont);
                g = g + 1;
            }
            textY = textY + lineH;
            i = i + 1;
        }
        c.PopClip();

        if (maxScroll > 0) {
            int viewH = bh - hdrH - app.Scale(8);
            SignalInt px = SignalInt.Create(off * lineH);
            Scrollbar.RenderVerticalScroll(app, bx + bw - app.Scale(10),
                by + hdrH + app.Scale(4), viewH, viewH,
                lines.Count * lineH, px);
            int moved = px.Get() / lineH;
            if (moved != off) {
                scroll.Set(moved);
                app.RequestRedraw();
            }
        }
        copied = Ui.Clicked(app, cpId);
        if (copied) {
            Copy.Raise();
            app.RequestRedraw();
        }
        On.Fire(app, wid);
    }

    // ---- designer / serialization model -------------------------------------

    override string Kind() { return "CodeBlock"; }

    override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec cap = PropSpec.Text("caption", "Caption");
        cap.str = Caption;
        ps.Add(cap);
        PropSpec cp = PropSpec.Text("copyLabel", "Copy label");
        cp.str = CopyLabel;
        ps.Add(cp);
        ps.Add(PropSpec.Text("class", "Classes"));
        return ps;
    }

    override List<string> Events() {
        List<string> e = Control.CommonEvents();
        e.Add("Copy");
        return e;
    }

    override void BindEvent(string evt, Action a) {
        if (evt == "Copy") { Copy.Add(a); return; }
        On.AddByName(evt, a);
    }
}
