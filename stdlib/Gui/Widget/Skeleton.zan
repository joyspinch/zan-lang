using System;
using Gui;

namespace Gui.Widget;

/// A loading placeholder: a plain filled box. Fill and radius come from the
/// `skeleton` CSS rules, so a skin restyles every placeholder at once and the
/// code side is plain assignment:
///
///     Skeleton s = new Skeleton { Width = 200, Height = 16 };
///     Skeleton avatar = new Skeleton { Class = "circle", Width = 40 };
///
/// Classes: `text` is a line of copy, `circle` is a round marker (an avatar
/// placeholder), and the `shimmer` animation class animates any of them.
class Skeleton : Control {
    /// Placeholder size in CSS px; a `width` / `height` rule wins over it.
    int Width;
    int Height;

    void InitSkeleton(int w, int h) {
        this.InitControl("skeleton", 1);
        Width = w;
        Height = h;
    }

    Skeleton() { InitSkeleton(200, 16); }
    Skeleton(int w, int h) { InitSkeleton(w, h); }

    StyleBox ResolvedStyle(App app) {
        return this.ResolveStyleAs(app, "skeleton", Class, Style.SNormal());
    }

    override void OnMeasure(App app) {
        StyleBox s = this.ResolvedStyle(app);
        prefW = s.WidthOr(app.Scale(Width));
        prefH = s.HeightOr(app.Scale(Height));
    }

    /// The placeholder box itself: fill, radius and animation are the style's.
    override void OnPaint(App app) {
        StyleBox s = this.ResolvedStyle(app);
        s.SetRadius(s.RadiusOr(app.theme.borderRadiusMedium));
        s.Paint(app, bx, by, bw, bh);
    }

    /// A line of copy `width` px wide, as tall as the text it stands in for.
    static Skeleton Line(App app, int width) {
        int h = Canvas.FontHeight(Style.Of(app, "skeleton", "text",
                                           Style.SNormal())
            .FontOr(app.theme.fontSizeMedium));
        Skeleton s = new Skeleton(width, h);
        s.Class = "text";
        return s;
    }

    // ---- designer / serialization model -------------------------------------

    override string Kind() { return "Skeleton"; }

    override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec w = PropSpec.Int("width", "Width");
        w.num = Width;
        ps.Add(w);
        PropSpec h = PropSpec.Int("height", "Height");
        h.num = Height;
        ps.Add(h);
        ps.Add(PropSpec.Text("class", "Classes"));
        return ps;
    }
}
