using System;
using Gui;

namespace Gui.Widget;

/// 工具条项被点击时的回调，带项的索引。
delegate void ToolItemCallback(int index);

/// <summary>
/// 窗口工具条：一行停靠的图标 / 文字按钮，位于带底部细
/// 分隔线的主题表面上——菜单栏下面那条工具栏，以及上位机
/// 画面顶部的操作条。
///
/// 各项是 Button，因此主题、样式表和事件与其它控件一致；
/// 工具条只负责表面、内边距和左右分组：
///
///   ToolStrip bar = new ToolStrip();
///   int save = bar.Add("Save", "save");
///   bar.AddSeparator();
///   int help = bar.AddRight("Help", "info");
///   bar.ItemAt(save).Click += () => { ... };
///
/// 序列化 / 设计器把每项写成 `options` 里的一条文本：
/// `"标题:图标"`，前缀 `>` 表示靠右，`-` 表示分隔条。
/// </summary>
class ToolStrip : Control {
    List<Button> items;
    /// 带索引的项点击回调（OnItemClick）。
    List<ToolItemCallback> itemCbs;
    /// 不关心是哪一项的项点击处理（设计器 ItemClick 事件）。
    UiEvent ItemClick;
    int tintBg;          // 0 = 主题表面，否则为纯色着色
    /// 只显示图标（不画标题），紧凑的图标工具条。
    bool iconOnly;
    /// `options` 的原样文本，供检查器 / 序列化按原样回读。
    string itemsSpec;

    /// 空工具条（之后 Add/AddRight/AddSeparator，或 SetItemsText）。
    ToolStrip() {
        this.InitControl("toolStrip", 1);
        items = new List<Button>();
        itemCbs = new List<ToolItemCallback>();
        ItemClick = new UiEvent();
        tintBg = 0;
        iconOnly = false;
        itemsSpec = "";
    }

    /// 覆写：公共事件之外提供 "ItemClick"。
    override List<string> Events() {
        List<string> e = Control.CommonEvents();
        e.Add("ItemClick");
        return e;
    }

    /// 覆写："ItemClick" 挂 ItemClick 事件，其余按名称走通用路由。
    override void BindEvent(string evt, Action a) {
        if (evt == "ItemClick") { ItemClick.Add(a); return; }
        On.AddByName(evt, a);
    }

    /// 任何一项被点击时回调，参数为项的索引。
    void OnItemClick(ToolItemCallback cb) { itemCbs.Add(cb); }

    /// 向已注册的处理器发布一次项点击。
    void FireItem(int index) {
        for (int i = 0; i < itemCbs.Count; i = i + 1) {
            ToolItemCallback cb = itemCbs[i];
            cb(index);
        }
        ItemClick.Raise();
    }

    /// 控件类型标识（序列化/设计器用）。
    override string Kind() { return "ToolStrip"; }

    /// 覆写：返回设计器属性清单（iconOnly/tint/class）。
    override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec io = PropSpec.Bool("iconOnly", "Icons only");
        io.flag = iconOnly;
        ps.Add(io);
        PropSpec tint = PropSpec.Color("tint", "Tint");
        tint.num = tintBg;
        ps.Add(tint);
        PropSpec cls = PropSpec.Text("class", "Classes");
        cls.str = Class;
        ps.Add(cls);
        return ps;
    }

    /// 项数（含分隔条）。
    int Count() { return items.Count; }

    /// 第 i 项；越界返回 null。
    Button ItemAt(int i) {
        if (i < 0 || i >= items.Count) { return null; }
        return items[i];
    }

    /// 建一个按钮项并加入条（尚未停靠）：iconOnly 且 icon 非空时
    /// 不显示标题；Click 已接到项点击派发。返回按钮。
    Button NewItem(string text, string icon) {
        string caption = text;
        if (iconOnly && icon != "") { caption = ""; }
        Button b = new Button { Text = caption, Icon = icon,
                               Class = "text small" };
        items.Add(b);
        Add(b);
        int idx = items.Count - 1;
        b.Click += () => { this.FireItem(idx); };
        return b;
    }

    /// 追加一个左对齐项；返回其索引供后续访问。
    int Add(string text, string icon) {
        Button b = NewItem(text, icon);
        b.DockLeft();
        return items.Count - 1;
    }

    /// 追加一个无图标的左对齐项。
    int Add(string text) { return this.Add(text, ""); }

    /// 丢掉所有项。声明式界面在按钮集合随状态变化（如调试器
    /// 的启动 / 暂停两套按钮）时重建工具条，用它代替宿主自己
    /// 持有一份影子列表。
    void Clear() {
        items = new List<Button>();
        this.RemoveAll();
    }

    /// 追加一个右对齐项（右侧分组按添加顺序从右往左排）。
    int AddRight(string text, string icon) {
        Button b = NewItem(text, icon);
        b.DockRight();
        return items.Count - 1;
    }

    /// 追加一个无图标的右对齐项。
    int AddRight(string text) { return this.AddRight(text, ""); }

    /// 竖直分隔条：一个禁用的窄项，用来分组按钮。
    int AddSeparator() {
        Button b = new Button { Text = "", Class = "text small disabled" };
        b.Prefer(1, 0);
        items.Add(b);
        Add(b);
        b.DockLeft();
        return items.Count - 1;
    }

    /// 按序列化文本重建全部项：每条 `"标题:图标"`，
    /// 前缀 `>` 靠右，`-` 为分隔条。设计器与 .zform 走这条路径。
    void SetItemsText(string spec) {
        itemsSpec = spec;
        this.Clear();
        List<string> parts = spec.Split("|");
        for (int i = 0; i < parts.Count; i = i + 1) {
            string it = parts[i];
            if (it == "") { continue; }
            if (it == "-") { this.AddSeparator(); continue; }
            bool right = false;
            if (it.Substring(0, 1) == ">") {
                right = true;
                it = it.Substring(1, it.Length - 1);
            }
            string text = it;
            string icon = "";
            List<string> kv = it.Split(":");
            if (kv.Count == 2) { text = kv[0]; icon = kv[1]; }
            if (right) { this.AddRight(text, icon); }
            else { this.Add(text, icon); }
        }
    }

    /// 切换只显示图标模式；只影响之后新建的项——已有项的标题在
    /// 建入时已按当时的模式处理。
    void SetIconOnly(bool on) { iconOnly = on; }

    /// 项集合是一个列表，不是字段，因此走 extra 属性：
    /// 设计器 / .zform 的 `options` 由此真正建出按钮。
    override string GetExtra(string key) {
        if (key == "options") { return itemsSpec; }
        return "";
    }

    /// 设计器写入 `options`（按分隔文本重建按钮项）；其他键返回
    /// false 交给基类。
    override bool SetExtra(string key, string val) {
        if (key == "options") { this.SetItemsText(val); return true; }
        return false;
    }

    /// 纯色背景着色，替换默认表面（0 恢复默认）。
    void SetTint(int bg) { tintBg = bg; }

    /// 覆写：量出工具条内边距/间距与固定行高，并落表面着色
    /// （SetTint 或 `toolstrip` 样式）。
    override void OnMeasure(App app) {
        Theme t = app.theme;
        padL = app.Scale(6);
        padR = app.Scale(6);
        padT = app.Scale(3);
        padB = app.Scale(3);
        gap = app.Scale(4);
        prefH = app.Scale(34);
        if (tintBg != 0) {
            this.Bg(tintBg);
        } else {
            StyleBox s = Style.Of(app, "toolstrip", Class, Style.SNormal());
            int topc = s.BgOr(0);
            this.Gradient(topc, App.Darken(topc, 40));
        }
    }

    /// 覆写：画底部细分隔线（表面填充已由 OnMeasure 设置的基础
    /// CSS 样式层完成）。
    override void OnPaint(App app) {
        // 底部细分隔线；表面填充由基础 CSS 样式层完成
        // （styleBg 在 OnMeasure 中设置）。
        StyleBox divider = Style.Of(app, "divider", "", Style.SNormal());
        int h = divider.HeightOr(1);
        int col = divider.BgOr(0);
        app.canvas.FillRect(bx, by + bh - h, bw, h, col);
    }

    /// 渲染到显式矩形（供自管布局的宿主使用）；作为
    /// 控件树里的停靠子控件时无需此方法。
    void RenderAt(App app, int x, int y, int w, int h) {
        MeasureTree(app);
        Arrange(x, y, w, h);
        RenderTree(app);
    }
}
