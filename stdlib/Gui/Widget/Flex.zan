using System;
using Gui;

namespace Gui.Widget;

/// 弹性布局容器（Naive UI n-flex / n-space）：把子控件排成一行或
/// 一列，可换行，间距、对齐、主轴分布全部由 CSS 决定。
///
/// 这是编排界面的默认容器——绝大多数排版需求（一排按钮、
/// 一列表单、标题行左右分置、一堆标签自动换行）都不该再手算
/// 坐标，交给它即可：
///
///     Flex row = Flex.Row().Gap(app.theme.gapMedium);
///     row.With(new Button("保存") { Class = "primary" });
///     row.With(new Button("取消"));
///     row.RenderInside(app, area);
///
/// 一排会溢出的标签自动折行（对应 n-space 的默认行为）：
///
///     Flex tags = Flex.Row().Wrap();
///     for (int i = 0; i < names.Count; i = i + 1) {
///         tags.With(new Tag(names[i]));
///     }
///
/// 标题行：左侧标题占满剩余空间，右侧动作贴右——不需要
/// 任何像素值，靠 `justify-content: space-between`：
///
///     Flex head = Flex.Row().Between().AlignCenter();
///     head.With(new Label("详情") { Class = "title" });
///     head.With(new Button("编辑"));
///
/// 容器自身按内容测量（换行时按行数累加高度），因此可以
/// 干净地嵌套：Flex 里放 Flex，外层的高度会自动跟上。
///
/// 外观完全没有：Flex 不画背景也不画边框（base.css 里
/// `flex { background: transparent; display: flex; }`）。要一张
/// 卡片就把它放进 Card/Panel，或者给它挂类由皮肤上色。
///
/// 所有变体都落在 CSS 类上，皮肤可以整体改写：
///
///     flex                            默认：行、不换行、start 对齐
///     .column                         主轴改为纵向
///     .wrap / .nowrap                 是否换行
///     .justify-center .justify-end
///     .justify-between .justify-around  主轴分布
///     .align-start .align-center
///     .align-end .align-stretch       交叉轴对齐
///     .content-center .content-between
///     .content-stretch …              换行后各行的交叉轴分布
///     .gap-none .gap-small
///     .gap-medium .gap-large          间距档（取 --gap-* token）
///
/// 子项侧的 CSS 也照常可用（写在子控件的 Class 上）：`grow` 吃掉
/// 剩余空间、`shrink-0` 溢出时不让位、`flex-1` 一排等宽、
/// `self-center` 单独跳出容器的对齐、`aspect-video` 按比例定高。
class Flex : Control {
    /// 互斥变体组：换一个方向/对齐方式时先清掉同组的旧类，
    /// 否则生效的是样式表里靠后那条规则。
    static string DirGroup() { return "row column"; }
    static string WrapGroup() { return "wrap nowrap"; }
    static string JustifyGroup() {
        return "justify-start justify-center justify-end "
            + "justify-between justify-around";
    }
    static string ContentGroup() {
        return "content-start content-center content-end "
            + "content-between content-around content-stretch";
    }
    static string AlignGroup() {
        return "align-stretch align-start align-center align-end";
    }
    static string GapGroup() {
        return "gap-none gap-small gap-medium gap-large";
    }

    void InitFlex(string dirCls) {
        // dock 默认 fill：Flex 通常是宿主给定矩形里的排版根，
        // 停靠成 top 只会让它拿到自己测出的那点高度。
        this.InitControl("flex", 5);
        this.AddClass(dirCls);
    }

    /// Default design-time constructor：横向、不换行。
    Flex() { InitFlex("row"); }

    /// 横向排列（n-flex 默认）。
    static Flex Row() { return new Flex(); }

    /// 纵向排列（n-flex 的 `vertical`）。
    static Flex Column() {
        Flex f = new Flex();
        f.SetClassIn(Flex.DirGroup(), "column");
        return f;
    }

    /// 横向 + 自动换行（等价于 n-space 的默认行为）。
    static Flex Wrapped() { return Flex.Row().Wrap(); }

    override string Kind() { return "Flex"; }
    override string StyleType() { return "flex"; }

    // ---- 变体（每个方法只改 class，几何由 CSS 给） ----------------------

    Flex Vertical() {
        this.SetClassIn(Flex.DirGroup(), "column");
        return this;
    }

    Flex Horizontal() {
        this.SetClassIn(Flex.DirGroup(), "row");
        return this;
    }

    /// 开启换行：一行放不下就折到下一行，行距取 `row-gap`
    /// （未声明时回退到 `gap`）。
    Flex Wrap() {
        this.SetClassIn(Flex.WrapGroup(), "wrap");
        return this;
    }

    Flex NoWrap() {
        this.SetClassIn(Flex.WrapGroup(), "nowrap");
        return this;
    }

    /// 主轴分布：`start`/`center`/`end`/`between`/`around`
    /// （对应 CSS justify-content）。
    Flex Justify(string mode) {
        string cls = "justify-start";
        if (mode == "center") { cls = "justify-center"; }
        else if (mode == "end" || mode == "right") { cls = "justify-end"; }
        else if (mode == "between" || mode == "space-between") {
            cls = "justify-between";
        } else if (mode == "around" || mode == "space-around"
                   || mode == "evenly") {
            cls = "justify-around";
        }
        this.SetClassIn(Flex.JustifyGroup(), cls);
        return this;
    }

    /// 子项贴主轴中线。
    Flex Center() { return this.Justify("center"); }

    /// 子项贴主轴末端（一行按钮靠右）。
    Flex End() { return this.Justify("end"); }

    /// 首尾贴边、剩余空间平分到中间（标题行左右分置）。
    Flex Between() { return this.Justify("between"); }

    /// 交叉轴对齐：`stretch`/`start`/`center`/`end`
    /// （对应 CSS align-items）。
    Flex Align(string mode) {
        string cls = "align-stretch";
        if (mode == "start" || mode == "top") { cls = "align-start"; }
        else if (mode == "center" || mode == "middle") { cls = "align-center"; }
        else if (mode == "end" || mode == "bottom") { cls = "align-end"; }
        this.SetClassIn(Flex.AlignGroup(), cls);
        return this;
    }

    /// 一行里高矮不齐的子项垂直居中——按钮和标签混排时几乎
    /// 总是要这个，否则矮的那个会被拉到整行高。
    Flex AlignCenter() { return this.Align("center"); }

    Flex AlignStart() { return this.Align("start"); }
    Flex AlignEnd() { return this.Align("end"); }

    /// 换行之后各行在交叉轴上怎么分布：`start`/`center`/`end`/
    /// `between`/`around`/`stretch`（对应 CSS align-content）。只有
    /// Wrap() 的容器且交叉轴有多余空间时才看得出区别。
    Flex Content(string mode) {
        string cls = "content-start";
        if (mode == "center" || mode == "middle") { cls = "content-center"; }
        else if (mode == "end" || mode == "bottom") { cls = "content-end"; }
        else if (mode == "between" || mode == "space-between") {
            cls = "content-between";
        } else if (mode == "around" || mode == "space-around") {
            cls = "content-around";
        } else if (mode == "stretch") { cls = "content-stretch"; }
        this.SetClassIn(Flex.ContentGroup(), cls);
        return this;
    }

    /// 间距档：`none`/`tiny`/`small`/`medium`/`large`，取
    /// base.css 的 --gap-* token（对应 n-space 的 size prop）。
    /// 需要具体像素时用基类的 Gap(px)。
    Flex Size(string size) {
        string cls = "gap-medium";
        if (size == "none" || size == "0") { cls = "gap-none"; }
        else if (size == "tiny" || size == "small") { cls = "gap-small"; }
        else if (size == "large") { cls = "gap-large"; }
        this.SetClassIn(Flex.GapGroup(), cls);
        return this;
    }

    // ---- 设计器 / 序列化模型 -------------------------------------------
    //
    // 变体都存在 `Class` 里（一个字符串，不是 Binding），没法挂
    // PropSpec 双向绑定——挂了也只是绑到一个临时值上、写不回来。
    // 因此这里只经 GetExtra/SetExtra 应答文档键，设计器直接编辑
    // `class` 即可。

    override bool SetExtra(string key, string val) {
        if (key == "direction") {
            if (val == "column" || val == "vertical") { this.Vertical(); }
            else { this.Horizontal(); }
            return true;
        }
        if (key == "wrap") {
            if (val == "true" || val == "1" || val == "wrap") { this.Wrap(); }
            else { this.NoWrap(); }
            return true;
        }
        if (key == "justify") { this.Justify(val); return true; }
        if (key == "align") { this.Align(val); return true; }
        if (key == "size") { this.Size(val); return true; }
        return false;
    }

    override string GetExtra(string key) {
        if (key == "direction") {
            if (Style.Has(Class, "column")) { return "column"; }
            return "row";
        }
        if (key == "wrap") {
            if (Style.Has(Class, "wrap")) { return "true"; }
            return "false";
        }
        return "";
    }
}
