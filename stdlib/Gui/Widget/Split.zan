using System;
using Gui;

namespace Gui.Widget;

/// <summary>
/// 可拖拽分隔条，把区域分成两个可调大小的面板——
/// IDE 风格布局的构件（项目树 | 编辑器，编辑器 |
/// 输出）。第一个面板的尺寸保存在响应式 SignalInt 中，
/// 可跨帧保持并可在别处绑定。
///
/// 立即模式用法：每帧用要分割的区域调用工厂。
/// 它绘制分隔条、处理进行中的拖拽（更新信号），
/// 并返回一个 Split，调用方把内容布局到其 `first`/`second` 矩形中：
///
///   Split sp = Split.Vertical(app, area, sidebarW, 160, 320);
///   RenderSidebar(app, sp.first);
///   RenderEditor(app, sp.second);
/// </summary>
class Split {
    /// 第一个（左/上）面板的内容矩形。
    Rect first;
    /// 第二个（右/下）面板的内容矩形。
    Rect second;
    /// 拖拽句柄的焦点 id（需要自定义命中查询时使用）。
    int handleId;

    /// 将 `area` 分割为左|右面板，带垂直拖拽句柄。
    /// `firstW` 保存左面板宽度（px）。`minFirst`/`minSecond` 限制
    /// 拖拽范围，防止任一面板缩到无法使用的宽度。
    static Split Vertical(App app, Rect area, SignalInt firstW, int minFirst, int minSecond) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int id = app.focus.AllocId();
        int handleW = app.Scale(5);

        int maxFirst = area.width - minSecond - handleW;
        if (maxFirst < minFirst) { maxFirst = minFirst; }

        if (app.focus.IsPressed(id)) {
            int nv = app.mouseX - area.x;
            if (nv < minFirst) { nv = minFirst; }
            if (nv > maxFirst) { nv = maxFirst; }
            firstW.Set(nv);
            app.RequestRedraw();
        }

        int fw = firstW.Get();
        if (fw < minFirst) { fw = minFirst; }
        if (fw > maxFirst) { fw = maxFirst; }

        int handleX = area.x + fw;
        int hc = t.divider;
        if (app.focus.IsHovered(id) || app.focus.IsPressed(id)) { hc = t.primary; }
        c.FillRect(handleX, area.y, handleW, area.height, hc);
        app.hitTester.Register(new HitRegion(id, handleX, area.y, handleW, area.height, 4));

        Split s = new Split();
        s.first = new Rect(area.x, area.y, fw, area.height);
        s.second = new Rect(handleX + handleW, area.y, area.width - fw - handleW, area.height);
        s.handleId = id;
        return s;
    }

    /// 将 `area` 分割为上|下面板，带水平拖拽句柄。
    /// `firstH` 保存上面板高度（px）。
    static Split Horizontal(App app, Rect area, SignalInt firstH, int minFirst, int minSecond) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int id = app.focus.AllocId();
        int handleH = app.Scale(5);

        int maxFirst = area.height - minSecond - handleH;
        if (maxFirst < minFirst) { maxFirst = minFirst; }

        if (app.focus.IsPressed(id)) {
            int nv = app.mouseY - area.y;
            if (nv < minFirst) { nv = minFirst; }
            if (nv > maxFirst) { nv = maxFirst; }
            firstH.Set(nv);
            app.RequestRedraw();
        }

        int fh = firstH.Get();
        if (fh < minFirst) { fh = minFirst; }
        if (fh > maxFirst) { fh = maxFirst; }

        int handleY = area.y + fh;
        int hc = t.divider;
        if (app.focus.IsHovered(id) || app.focus.IsPressed(id)) { hc = t.primary; }
        c.FillRect(area.x, handleY, area.width, handleH, hc);
        app.hitTester.Register(new HitRegion(id, area.x, handleY, area.width, handleH, 5));

        Split s = new Split();
        s.first = new Rect(area.x, area.y, area.width, fh);
        s.second = new Rect(area.x, handleY + handleH, area.width, area.height - fh - handleH);
        s.handleId = id;
        return s;
    }
}
