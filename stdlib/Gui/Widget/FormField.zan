    // ---- 选项列表 ----

    int OptionCount() { return options.Count; }
    string OptionAt(int i) { return options[i]; }
    void AddOption(string s) { options.Add(s); }
    /// 通过重建列表来移除一个选项（运行时的列表中段
    /// RemoveAt 与列表中段 Insert 一样可能破坏堆）。
    void RemoveOptionAt(int i) {
        if (i < 0 || i >= options.Count) { return; }
        List<string> nl = new List<string>();
        for (int k = 0; k < options.Count; k = k + 1) {
            if (k != i) { nl.Add(options[k]); }
        }
        options = nl;
    }

    string JoinOptions() {
        string r = "";
        for (int i = 0; i < options.Count; i = i + 1) {
            if (i > 0) { r = r + "|"; }
            r = r + options[i];
        }
        return r;
    }

    void SetOptionsFrom(string joined) {
        options = new List<string>();
        string cur = "";
        for (int i = 0; i < joined.Length; i = i + 1) {
            string ch = joined.Substring(i, 1);
            if (ch == "|") { options.Add(cur); cur = ""; }
            else { cur = cur + ch; }
        }
        if (cur.Length > 0) { options.Add(cur); }
    }

    // ---- 设计器 / 序列化模型 ----

    /// Canonical .zform kind for this field. Custom fields retain the
    /// discovered class name directly; built-ins use their real widget kind.
    string KindName() {
        if (this.kind != "") { return this.kind; }
        if (this.IsCustom()) { return this.customKind; }
        return FormField.KindForType(this.ftype);
    }

    /// The single source of truth for "which widget class does this field
    /// become": the designer writes it into `kind`, the .zform generator
    /// declares it as the field's type, and TypeForKey reads it back. Every
    /// built-in type maps to a real Control with a parameterless constructor,
    /// so a design can never generate code that names a type that does not
    /// exist. Field types that have no widget of their own (a date or colour
    /// entry, an upload row) resolve to the control that actually collects
    /// them.
    static string KindForType(int ft) {
        if (ft == 100) { return ""; }
        if (ft == 1) { return "TextArea"; }
        if (ft == 4) { return "Radio"; }
        if (ft == 5) { return "Checkbox"; }
        if (ft == 6) { return "SelectBox"; }
        if (ft == 7) { return "Switch"; }
        if (ft == 8) { return "Rate"; }
        if (ft == 9) { return "Slider"; }
        if (ft == 14) { return "TextArea"; }
        if (ft == 15 || ft == 16) { return "Label"; }
        if (ft == 17) { return "Divider"; }
        if (ft == 18 || ft == 45) { return "Panel"; }
        if (ft == 19) { return "Tag"; }
        if (ft == 20) { return "Badge"; }
        if (ft == 21) { return "Avatar"; }
        if (ft == 22) { return "Statistic"; }
        if (ft == 23) { return "Table"; }
        if (ft == 24) { return "Timeline"; }
        if (ft == 25) { return "TreeView"; }
        if (ft == 26) { return "Collapse"; }
        if (ft == 27) { return "Empty"; }
        if (ft == 29) { return "Progress"; }
        if (ft == 30) { return "Result"; }
        if (ft == 31) { return "Skeleton"; }
        if (ft == 32 || ft == 47) { return "Spin"; }
        if (ft == 34) { return "Steps"; }
        if (ft == 35) { return "Breadcrumb"; }
        if (ft == 36) { return "Tabs"; }
        if (ft == 37) { return "Pagination"; }
        if (ft == 39) { return "PageHeader"; }
        if (ft == 40) { return "ListView"; }
        if (ft == 48) { return "Dropdown"; }
        if (ft == 42) { return "Carousel"; }
        if (ft == 43) { return "Chart"; }
        if (ft == 44) { return "Ellipsis"; }
        if (ft == 46) { return "Scrollbar"; }
        if (ft == 49) { return "FloatButton"; }
        if (ft == 53) { return "Ribbon"; }
        if (ft == 56) { return "Layer"; }
        if (ft == 58) { return "ToolStrip"; }
        if (ft == 59) { return "StatusBar"; }
        if (ft == 60) { return "SplitPanel"; }
        // 61 dockpanel is a DockHost tab, not a placeable widget, so a
        // design that carries one generates the plain container.
        if (ft == 61) { return "Panel"; }
        if (ft == 62) { return "Led"; }
        if (ft == 63) { return "Digital"; }
        if (ft == 64) { return "Gauge"; }
        if (ft == 65) { return "Bargraph"; }
        if (ft == 66) { return "Trend"; }
        if (ft == 67) { return "AlarmBanner"; }
        if (ft == 68) { return "AlarmList"; }
        if (ft == 69) { return "NumPad"; }
        if (ft == 70) { return "DeviceCard"; }
        if (ft == 71) { return "EquipPanel"; }
        // 2 password, 3 number, 10 date, 11 time, 12 upload, 13 color are all
        // single-line entries, and the remaining types (alert, tooltip, menu,
        // popover, popconfirm, notification, contextmenu, icon, ellipsis,
        // timer) are transient surfaces or plain text rather than placeable
        // widgets, so a design that carries one still generates a control that
        // exists.
        if (ft == 28 || ft == 33 || ft == 38 || ft == 44 || ft == 50
            || ft == 51 || ft == 52 || ft == 54 || ft == 55 || ft == 57) {
            return "Label";
        }
        // A chart, a scrollbar, a layer and a dock tab are drawn by hosts
        // rather than placed on their own, so they generate the container.
        if (ft == 43 || ft == 46 || ft == 56) { return "Panel"; }
        return "Input";
    }

    override string Kind() { return "Field"; }

    override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec lbl = PropSpec.Text("label", "Label");
        lbl.str = label;
        ps.Add(lbl);
        PropSpec fld = PropSpec.Text("fname", "Name");
        fld.str = fname;
        fld.AsName();
        ps.Add(fld);
        PropSpec ph = PropSpec.Text("placeholder", "Placeholder");
        ph.str = placeholder;
        ps.Add(ph);
        PropSpec req = PropSpec.Bool("required", "Required");
        req.flag = required;
        ps.Add(req);
        if (ftype == 15 || ftype == 16) {
            PropSpec wr = PropSpec.Bool("wrap", "Wrap");
            wr.flag = wrap;
            ps.Add(wr);
        }
        PropSpec on = PropSpec.Bool("defOn", "Default on");
        on.flag = defOn;
        ps.Add(on);
        // 样式类：皮肤规则或 Tailwind 写法的原子类
        // （`grid-cols-3 gap-y-2`），运行时和设计器预览共用。
        PropSpec cls = PropSpec.Text("class", "Class");
        cls.str = Class;
        ps.Add(cls);
        PropSpec sp = PropSpec.Int("span", "Span");
        sp.num = span;
        ps.Add(sp);
        PropSpec dk = PropSpec.Enum("dock", "Dock", new List<string>());
        dk.Option("manual"); dk.Option("top"); dk.Option("bottom");
        dk.Option("left"); dk.Option("right"); dk.Option("fill");
        dk.num = dockSide;
        ps.Add(dk);
        if (this.IsCustom()) {
            PropSpec kind = PropSpec.Text("customKind", "Component");
            kind.str = customKind;
            ps.Add(kind);
        }
        ps.Add(PropSpec.Text("options", "Options"));
        return ps;
    }

    /// 选项列表存为文本，逗号分隔的每项即一个选项。
    override string GetExtra(string key) {
        if (key == "options") { return this.JoinOptions(); }
        return "";
    }

    override bool SetExtra(string key, string val) {
        if (key != "options") { return false; }
        this.SetOptionsFrom(val);
        return true;
    }
}
