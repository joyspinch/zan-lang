using System;
using Gui;

namespace Gui.Widget;

/// 数据录入表单的一行（FormCreate / 表单构建器风格）。
///
/// FormField 是可设计控件，描述收集“什么”，而非
/// 如何绘制交互控件：字段类型（`ftype`）、旁边显示的标签、
/// 模型键（`fname`）、占位符、必填标记，以及——选择型
/// 字段的——选项列表。可视化设计器渲染该行预览，
/// 并通过标准 Kind()/Props()/GetProp/SetProp 模型编辑，因此
/// 整个表单可无特判地往返 Serialize。
///
/// 字段类型（ftype）：
///   0 input      1 textarea  2 password 3 number  4 radio
///   5 checkbox   6 select    7 switch   8 rate    9 slider
///   10 date      11 time     12 upload  13 color   14 richtext
///
/// 显示/布局组件（ftype >= 15）渲染静态内容而非
/// 接收输入；占满整行宽度，不带标签列。
/// 在设计器面板中按类别分组：
///   Layout:     15 title     16 text        17 divider
///   Display:    18 card       19 tag         20 badge     21 avatar
///               22 statistic  23 table       24 timeline  25 tree
///               26 collapse   27 empty
///   Feedback:   28 alert      29 progress     30 result    31 skeleton
///               32 spin       33 tooltip
///   Navigation: 34 steps      35 breadcrumb   36 tabs      37 pagination
///               38 menu       39 pageheader
class FormField : Control {
    // Canonical serialized component class. The legacy ftype is retained only
    // for reading old designer documents and palette metadata.
    string kind;
    int ftype;
    string label;
    string fname;
    string placeholder;
    // Project component class name. A non-empty value marks a custom kind
    // and is serialized directly so JSON round-trips preserve the class.
    string customKind;
    bool required;
    bool defOn;      // switch 字段的默认开启状态
    /// 显示文本（ftype 15/16）的自动换行：渲染的 Label 换行适应
    /// 字段宽度而非省略截断。序列化以便自由布局携带
    /// 较长的提示段落。
    bool wrap;
    int span;        // 24 分栏中的列跨度（24 = 整行，12 = 半行，……）
    // 自由画布布局（designer layoutMode == 1）：设计空间中的绝对
    // 位置和尺寸（窗口像素）。容器子元素的坐标
    // 相对于容器的内容框（对应运行时的 DockManual + Place
    // ）。流式模式下忽略，此时宽度由 span 决定。
    int fx;
    int fy;
    int fw;
    int fh;
    /// 按设计尺寸存储的备用自由画布矩形（LVGL 风格断点
    /// 布局）："WxH:x,y,w,h;WxH:x,y,w,h"。fx/fy/fw/fh 始终保存
    /// 当前设计尺寸的矩形；设计器中切换尺寸时把
    /// 旧矩形存到这里，存在新矩形时再加载。
    string altRects;
    /// 设计器锁定：锁住的组件仍可选中和改属性，
    /// 但画布上拖不动、拉不大（和场景设计器的 Locked() 一致）。
    bool locked;
    /// 停靠边（Dock.Manual/Top/Bottom/Left/Right/Fill 的数字）。
    /// 自由画布默认 0（给定的 fx/fy/fw/fh 绝对定位）；在
    /// Dock Panel 里改成某一边，就能做出“上工具条 + 左侧栏 +
    /// 下状态栏 + 中间填充”这种应用外壳，且能随窗口缩放。
    int dockSide;
    List<string> options;

    // 容器支持。容器（Card / Tabs）在 `kids` 中持有嵌套
    // 子组件；每个子元素在 `childTab` 中记录所属标签页
    // （如 Card 这类单内容体容器恒为 0）。`uiState`
    // 是组合控件绑定的响应式索引——Tabs 的当前标签页、
    // Steps 的当前步骤、Collapse 的展开面板、
    // Pagination 的页码、Menu / Tree 的选中项——让预览实时生效。
    List<FormField> kids;
    int childTab;
    SignalInt uiState;

    void InitField(int ft) {
        this.InitControl("field", 0);
        ftype = ft;
        kind = FormField.KindForType(ft);
        label = FormField.DefaultLabel(ft);
        fname = "field";
        placeholder = FormField.DefaultPlaceholder(ft);
        required = false;
        defOn = false;
        wrap = false;
        span = 24;
        fx = 0;
        fy = 0;
        fw = 200;
        fh = 32;
        altRects = "";
        locked = false;
        dockSide = 0;
        customKind = "";
        options = new List<string>();
        kids = new List<FormField>();
        childTab = 0;
        uiState = new SignalInt(0);
        SeedOptions(ft);
    }

    /// 容器类型拥有嵌套子组件：Card (18) 有单一
    /// 内容体；Tabs (36) 把子元素分配到各个标签页；
    /// Split (60) 分成两个窗格（childTab 0/1 即窗格序号）；
    /// Dock Panel (61) 按各子元素自己的 `dock` 边停靠。
    static bool IsContainerOf(int ft) {
        return ft == 18 || ft == 36 || ft == 60 || ft == 61;
    }

    /// 外壳条通常占哪一边：工具条贴顶、状态栏贴底、停靠面板
    /// 吃掉剩下的空间。只是给「停靠」属性的建议值，组件建出来
    /// 一律是自由定位（0），不会自己跑去贴边。
    static int SuggestDockOf(int ft) {
        if (ft == 58) { return 1; }
        if (ft == 59) { return 2; }
        if (ft == 61) { return 5; }
        return 0;
    }

    /// 应用外壳类容器 / 条（工具条、状态栏、分栏、停靠面板）。
    /// 它们自带表面并在窗口边缘成条，因此设计器不给它们
    /// 加标签列。
    static bool IsShellOf(int ft) {
        return ft == 58 || ft == 59 || ft == 60 || ft == 61;
    }

    bool IsContainer() {
        return FormField.IsContainerOf(ftype);
    }

    int KidCount() { return kids.Count; }
    FormField KidAt(int i) { return kids[i]; }

    // ---- 自由画布定位（designer layoutMode == 1）----

    /// 设置设计空间中的绝对位置（容器子元素相对于父内容
    /// 框）。
    FormField PlaceAt(int x, int y) { fx = x; fy = y; return this; }
    FormField FreeSize(int w, int h) { fw = w; fh = h; return this; }
    int FreeX() { return fx; }
    int FreeY() { return fy; }
    int FreeW() { return fw; }
    int FreeH() { return fh; }

    /// 把当前 fx/fy/fw/fh 写入备用矩形表，键为
    /// "WxH"（覆盖该尺寸之前的条目）。
    void StashRect(string key) {
        string entry = key + ":" + Convert.ToString(fx) + "," + Convert.ToString(fy)
            + "," + Convert.ToString(fw) + "," + Convert.ToString(fh);
        string outp = "";
        List<string> parts = altRects.Split(";");
        for (int i = 0; i < parts.Count; i = i + 1) {
            string pt = parts[i];
            if (pt.Length > 0 && !FormField.AltKeyIs(pt, key)) {
                if (outp != "") { outp = outp + ";"; }
                outp = outp + pt;
            }
        }
        if (outp != "") { outp = outp + ";"; }
        altRects = outp + entry;
    }

    /// 把 "WxH" 键下保存的备用矩形加载到 fx/fy/fw/fh。
    /// 该尺寸无条目时返回 false（矩形保持不变）。
    bool LoadRect(string key) {
        List<string> parts = altRects.Split(";");
        for (int i = 0; i < parts.Count; i = i + 1) {
            string pt = parts[i];
            if (pt.Length > 0 && FormField.AltKeyIs(pt, key)) {
                List<string> kv = pt.Split(":");
                if (kv.Count == 2) {
                    List<string> nums = kv[1].Split(",");
                    if (nums.Count == 4) {
                        fx = Convert.ToInt32(nums[0]);
                        fy = Convert.ToInt32(nums[1]);
                        fw = Convert.ToInt32(nums[2]);
                        fh = Convert.ToInt32(nums[3]);
                        return true;
                    }
                }
            }
        }
        return false;
    }

    static bool AltKeyIs(string entry, string key) {
        return entry.Length > key.Length + 1
            && entry.Substring(0, key.Length + 1) == key + ":";
    }

    /// 为组件填充默认选项列表——选项值、表格列、
    /// 标签页标题、步骤/菜单/树条目——使新添加的组件
    /// 在预览中不至于空白。
    void SeedOptions(int ft) {
        if (ft == 23) { options.Add("Name:name"); options.Add("Email:email"); options.Add("Status:status"); return; }
        if (ft == 24) { options.Add("Created"); options.Add("Approved"); options.Add("Shipped"); return; }
        if (ft == 25) { options.Add("Root"); options.Add("Child A"); options.Add("Child B"); return; }
        if (ft == 26) { options.Add("Section 1"); options.Add("Section 2"); return; }
        if (ft == 34) { options.Add("Step 1"); options.Add("Step 2"); options.Add("Step 3"); return; }
        if (ft == 35) { options.Add("Home"); options.Add("Library"); options.Add("Data"); return; }
        if (ft == 36) { options.Add("Tab 1"); options.Add("Tab 2"); options.Add("Tab 3"); return; }
        if (ft == 38) { options.Add("Dashboard"); options.Add("Settings"); options.Add("Profile"); return; }
        if (ft == 40) { options.Add("List item one"); options.Add("List item two"); options.Add("List item three"); return; }
        if (ft == 41) { options.Add("Name:name"); options.Add("Email:email"); options.Add("Status:status"); return; }
        if (ft == 42) { options.Add("Slide 1"); options.Add("Slide 2"); options.Add("Slide 3"); return; }
        if (ft == 58) { options.Add("New:plus"); options.Add("Open:folder"); options.Add("Save:save"); options.Add("-"); options.Add(">Help:info"); return; }
        if (ft == 59) { options.Add("Ready"); options.Add(">UTF-8"); options.Add(">Ln 1, Col 1"); return; }
        // 分栏容器把方向和第一个窗格的尺寸存在通用选项表里，
        // 无需为它单独加 .zform 键：options[0]=方向，options[1]=尺寸。
        if (ft == 60) { options.Add("vertical"); options.Add("240"); return; }
        if (FormField.UsesOptionsOf(ft)) {
            options.Add("Option 1");
            options.Add("Option 2");
            options.Add("Option 3");
        }
    }

    FormField(int ft) {
        InitField(ft);
    }

    /// 构建 `ftype` 字段并生成唯一的默认模型键。
    static FormField New(int ft, int seq) {
        FormField f = new FormField(ft);
        f.kind = FormField.KindForType(ft);
        f.fname = FormField.TypeKey(ft) + Convert.ToString(seq);
        f.name = f.fname;
        return f;
    }

    /// 深拷贝（子元素一并复制）：设计器的「复制」用它，
    /// 副本除了模型名之外和原件完全一致。
    FormField Clone() {
        FormField f = new FormField(ftype);
        f.kind = kind;
        f.label = label;
        f.fname = fname;
        f.name = fname;
        f.placeholder = placeholder;
        f.customKind = customKind;
        f.required = required;
        f.defOn = defOn;
        f.wrap = wrap;
        f.span = span;
        f.fx = fx;
        f.fy = fy;
        f.fw = fw;
        f.fh = fh;
        f.altRects = altRects;
        f.locked = locked;
        f.dockSide = dockSide;
        f.childTab = childTab;
        f.options = new List<string>();
        for (int i = 0; i < options.Count; i = i + 1) { f.options.Add(options[i]); }
        f.kids = new List<FormField>();
        for (int k = 0; k < kids.Count; k = k + 1) { f.kids.Add(kids[k].Clone()); }
        return f;
    }

    /// Legacy palette value retained only while reading old designer state.
    static int Custom() { return 100; }

    bool IsCustom() { return customKind != ""; }

    /// 构建携带发现的 `kind` 标签的自定义组件字段。
    static FormField NewCustom(string kind, int seq) {
        FormField f = new FormField(100);
        f.kind = kind;
        f.customKind = kind;
        f.label = kind;
        f.fname = kind + Convert.ToString(seq);
        f.name = f.fname;
        return f;
    }

    // ---- 类型元数据 ----

    /// 用于默认模型名称的短类型键，如 "input"、"select"。
    static string TypeKey(int ft) {
        if (ft == 1) { return "textarea"; }
        if (ft == 2) { return "password"; }
        if (ft == 3) { return "number"; }
        if (ft == 4) { return "radio"; }
        if (ft == 5) { return "checkbox"; }
        if (ft == 6) { return "select"; }
        if (ft == 7) { return "switch"; }
        if (ft == 8) { return "rate"; }
        if (ft == 9) { return "slider"; }
        if (ft == 10) { return "date"; }
        if (ft == 11) { return "time"; }
        if (ft == 12) { return "upload"; }
        if (ft == 13) { return "color"; }
        if (ft == 14) { return "richtext"; }
        if (ft == 15) { return "title"; }
        if (ft == 16) { return "text"; }
        if (ft == 17) { return "divider"; }
        if (ft == 18) { return "card"; }
        if (ft == 19) { return "tag"; }
        if (ft == 20) { return "badge"; }
        if (ft == 21) { return "avatar"; }
        if (ft == 22) { return "statistic"; }
        if (ft == 23) { return "table"; }
        if (ft == 24) { return "timeline"; }
        if (ft == 25) { return "tree"; }
        if (ft == 26) { return "collapse"; }
        if (ft == 27) { return "empty"; }
        if (ft == 28) { return "alert"; }
        if (ft == 29) { return "progress"; }
        if (ft == 30) { return "result"; }
        if (ft == 31) { return "skeleton"; }
        if (ft == 32) { return "spin"; }
        if (ft == 33) { return "tooltip"; }
        if (ft == 34) { return "steps"; }
        if (ft == 35) { return "breadcrumb"; }
        if (ft == 36) { return "tabs"; }
        if (ft == 37) { return "pagination"; }
        if (ft == 38) { return "menu"; }
        if (ft == 39) { return "pageheader"; }
        if (ft == 40) { return "listview"; }
        if (ft == 41) { return "datatable"; }
        if (ft == 42) { return "carousel"; }
        if (ft == 43) { return "chart"; }
        if (ft == 44) { return "ellipsis"; }
        if (ft == 45) { return "panel"; }
        if (ft == 46) { return "scrollbar"; }
        if (ft == 47) { return "loading"; }
        if (ft == 48) { return "dropdown"; }
        if (ft == 49) { return "floatbutton"; }
        if (ft == 50) { return "popover"; }
        if (ft == 51) { return "popconfirm"; }
        if (ft == 52) { return "notification"; }
        if (ft == 53) { return "ribbon"; }
        if (ft == 54) { return "icon"; }
        if (ft == 55) { return "contextmenu"; }
        if (ft == 56) { return "layer"; }
        if (ft == 57) { return "timer"; }
        if (ft == 58) { return "toolbar"; }
        if (ft == 59) { return "statusbar"; }
        if (ft == 60) { return "split"; }
        if (ft == 61) { return "dockpanel"; }
        if (ft == 62) { return "led"; }
        if (ft == 63) { return "digital"; }
        if (ft == 64) { return "gauge"; }
        if (ft == 65) { return "bargraph"; }
        if (ft == 66) { return "trend"; }
        if (ft == 67) { return "alarmbanner"; }
        if (ft == 68) { return "alarmlist"; }
        if (ft == 69) { return "numpad"; }
        if (ft == 70) { return "devicecard"; }
        if (ft == 71) { return "equippanel"; }
        return "input";
    }

    /// TypeKey 的逆运算：由规范字符串类型（即 .zform 的
    /// `kind` 字段中所写）求 ftype。"custom" -> 100；未知 -> 0（input）。
    static int TypeForKey(string key) {
        if (key == "custom") { return 100; }
        // A Panel is the standalone container type, not the card it shares a
        // widget with.
        if (key == "Panel") { return 45; }
        // The inverse of KindForType, so a document written by the designer
        // reads back as the same field type. Several types share a widget
        // (a date and a colour entry are both an Input); the first match wins,
        // which is the plain entry the generator would have produced anyway.
        for (int ft = 0; ft <= FormField.MaxType(); ft = ft + 1) {
            if (FormField.KindForType(ft) == key) { return ft; }
        }
        // Older documents stored the lowercase palette key.
        for (int ft2 = 0; ft2 <= FormField.MaxType(); ft2 = ft2 + 1) {
            if (FormField.TypeKey(ft2) == key) { return ft2; }
        }
        return 0;
    }

    /// 最大的内置字段类型（自定义组件为哨兵 100）。面板范围、
    /// 序列化和编译期投影都以它为界。
    static int MaxType() { return 71; }

    /// 供面板/检查器使用的可读类型名称。
    static string TypeName(int ft) {
        if (ft == 1) { return "Textarea"; }
        if (ft == 2) { return "Password"; }
        if (ft == 3) { return "Number"; }
        if (ft == 4) { return "Radio"; }
        if (ft == 5) { return "Checkbox"; }
        if (ft == 6) { return "Select"; }
        if (ft == 7) { return "Switch"; }
        if (ft == 8) { return "Rate"; }
        if (ft == 9) { return "Slider"; }
        if (ft == 10) { return "Date"; }
        if (ft == 11) { return "Time"; }
        if (ft == 12) { return "Upload"; }
        if (ft == 13) { return "Color"; }
        if (ft == 14) { return "Rich Text"; }
        if (ft == 15) { return "Title"; }
        if (ft == 16) { return "Text"; }
        if (ft == 17) { return "Divider"; }
        if (ft == 18) { return "Card"; }
        if (ft == 19) { return "Tag"; }
        if (ft == 20) { return "Badge"; }
        if (ft == 21) { return "Avatar"; }
        if (ft == 22) { return "Statistic"; }
        if (ft == 23 || ft == 41) { return "DataGrid"; }
        if (ft == 24) { return "Timeline"; }
        if (ft == 25) { return "Tree"; }
        if (ft == 26) { return "Collapse"; }
        if (ft == 27) { return "Empty"; }
        if (ft == 28) { return "Alert"; }
        if (ft == 29) { return "Progress"; }
        if (ft == 30) { return "Result"; }
        if (ft == 31) { return "Skeleton"; }
        if (ft == 32) { return "Spin"; }
        if (ft == 33) { return "Tooltip"; }
        if (ft == 34) { return "Steps"; }
        if (ft == 35) { return "Breadcrumb"; }
        if (ft == 36) { return "Tabs"; }
        if (ft == 37) { return "Pagination"; }
        if (ft == 38) { return "Menu"; }
        if (ft == 39) { return "Page Header"; }
        if (ft == 40) { return "List View"; }
        if (ft == 41) { return "Data Table"; }
        if (ft == 42) { return "Carousel"; }
        if (ft == 45) { return "Panel"; }
        if (ft == 47) { return "Loading"; }
        // 48 dropdown is the popup a control opens; the placeable form of
        // it is the select box.
        if (ft == 48) { return "SelectBox"; }
        if (ft == 49) { return "Float Button"; }
        if (ft == 50) { return "Popover"; }
        if (ft == 51) { return "Popconfirm"; }
        if (ft == 52) { return "Notification"; }
        if (ft == 53) { return "ToolStrip"; }
        if (ft == 54) { return "Icon"; }
        if (ft == 55) { return "Context Menu"; }
        if (ft == 57) { return "Timer"; }
        if (ft == 58) { return "Tool Strip"; }
        if (ft == 59) { return "Status Bar"; }
        if (ft == 60) { return "Split"; }
        if (ft == 61) { return "Dock Panel"; }
        if (ft == 62) { return "LED"; }
        if (ft == 63) { return "Digital Readout"; }
        if (ft == 64) { return "Gauge"; }
        if (ft == 65) { return "Bargraph"; }
        if (ft == 66) { return "Trend"; }
        if (ft == 67) { return "Alarm Banner"; }
        if (ft == 68) { return "Alarm List"; }
        if (ft == 69) { return "Numeric Keypad"; }
        if (ft == 70) { return "Device Card"; }
        if (ft == 71) { return "Equipment Panel"; }
        return "Input";
    }

    /// 某字段类型特有的语义事件（除每个 Control 都继承的通用
    /// 指针/焦点/键盘/生命周期事件集之外）。驱动
    /// 设计器的事件检查器和 JSON `on*` 处理器约定。
    static List<string> SemanticEventsOf(int ft) {
        List<string> e = new List<string>();
        // --- 表单输入 ---
        if (ft == 0 || ft == 1 || ft == 2 || ft == 3) {
            e.Add("Change"); e.Add("Submit");            // Input/Textarea/Password/Number
        } else if (ft == 14) {
            e.Add("Change");                              // Rich Text
        } else if (ft == 4) {
            e.Add("Change");                              // Radio
        } else if (ft == 5) {
            e.Add("Change"); e.Add("Toggle");             // Checkbox
        } else if (ft == 6) {
            e.Add("Change"); e.Add("SelectionChanged");   // Select
        } else if (ft == 7) {
            e.Add("Change"); e.Add("Toggle");             // Switch
        } else if (ft == 8) {
            e.Add("Change");                              // Rate
        } else if (ft == 9) {
            e.Add("Change"); e.Add("DragEnd");            // Slider
        } else if (ft == 10 || ft == 11) {
            e.Add("Change"); e.Add("Open"); e.Add("Close"); // Date / Time picker
        } else if (ft == 12) {
            e.Add("Change"); e.Add("Upload"); e.Add("Remove"); // Upload
        } else if (ft == 13) {
            e.Add("Change");                              // Color
        // --- 显示 ---
        } else if (ft == 19) {
            e.Add("Click"); e.Add("Close");               // Tag（可关闭）
        } else if (ft == 21) {
            e.Add("Click");                               // Avatar
        } else if (ft == 22) {
            e.Add("Click");                               // Statistic
        } else if (ft == 23 || ft == 41) {
            e.Add("HeaderClick"); e.Add("Sort"); e.Add("RowClick");
            e.Add("RowDoubleClick"); e.Add("CellClick"); e.Add("CellEdit");
            e.Add("SelectionChanged"); e.Add("ColumnResize"); e.Add("ScrollChanged");
        } else if (ft == 24) {
            e.Add("ItemClick");                           // Timeline
        } else if (ft == 25) {
            e.Add("Expand"); e.Add("Collapse"); e.Add("Select"); // Tree
        } else if (ft == 26) {
            e.Add("Toggle"); e.Add("Change");             // Collapse
        // --- 反馈 ---
        } else if (ft == 28) {
            e.Add("Close");                               // Alert
        } else if (ft == 30) {
            e.Add("Action");                              // Result
        } else if (ft == 33) {
            e.Add("Show"); e.Add("Hide");                 // Tooltip
        } else if (ft == 34) {
            e.Add("Change");                              // Steps
        // --- 导航 ---
        } else if (ft == 35) {
            e.Add("ItemClick");                           // Breadcrumb
        } else if (ft == 36) {
            e.Add("TabChanged"); e.Add("TabClosed");      // Tabs
        } else if (ft == 37) {
            e.Add("Change");                              // Pagination
        } else if (ft == 38 || ft == 40 || ft == 48) {
            e.Add("ItemClick"); e.Add("SelectionChanged"); // Menu / List / Dropdown
        } else if (ft == 55) {
            e.Add("ItemClick"); e.Add("Opening");         // Context Menu
        } else if (ft == 56) {
            e.Add("Open"); e.Add("Close");                // Layer
        } else if (ft == 57) {
            e.Add("Tick");                                // Timer
        } else if (ft == 39) {
            e.Add("Back");                                // Page Header
        // --- 显示/反馈扩展 ---
        } else if (ft == 42) {
            e.Add("Change");                              // Carousel
        } else if (ft == 43) {
            e.Add("PointClick"); e.Add("LegendClick");    // Chart
        } else if (ft == 49) {
            e.Add("Click");                               // Float Button
        } else if (ft == 50) {
            e.Add("Show"); e.Add("Hide");                 // Popover
        } else if (ft == 51) {
            e.Add("Confirm"); e.Add("Cancel");            // Popconfirm
        } else if (ft == 52) {
            e.Add("Click"); e.Add("Close");               // Notification
        } else if (ft == 54) {
            e.Add("Click");                               // Icon
        } else if (ft == 67) {
            e.Add("Ack");
        } else if (ft == 68) {
            e.Add("RowClick");
        } else if (ft == 69) {
            e.Add("Enter");
            e.Add("Cancel");
        } else if (ft == 58) {
            e.Add("ItemClick");                           // Tool Strip
        } else if (ft == 60) {
            e.Add("Change");                              // Split（分栏尺寸）
        }
        return e;
    }

    override List<string> Events() {
        List<string> e = Control.CommonEvents();
        List<string> sem = FormField.SemanticEventsOf(ftype);
        for (int i = 0; i < sem.Count; i = i + 1) {
            if (!e.Contains(sem[i])) { e.Add(sem[i]); }
        }
        return e;
    }

