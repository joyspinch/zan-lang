using System;
using Gui;

namespace Gui.Widget;

/// 带响应式 int 绑定（选中索引）的单选按钮。
///
/// C# 风格的有状态实例（每个选项一个）：
///     Radio a = Radio.Bind(model, 0);
///     a.Change += () => { ... };
///     a.Render(app, x, y, "Option A");
/// 为兼容现有调用方保留旧的立即模式静态方法。
class Radio : Control {
    SignalInt model;
    /// 双向绑定的选中值：`r.data = form.gender;` 使模型字段与组选择
    /// 双向保持同步（编译器降级的
    /// Binding）。组内每个单选按钮都绑定同一字段。
    Binding<int> data;
    int optionValue;
    int wid;
    string label;
    /// 该选项被选中时触发（C# 风格：`r.Change += h;`）。
    UiEvent Change;

    void InitRadio(SignalInt m, int ov, string lbl) {
        this.InitControl(lbl, 1);
        model = m;
        optionValue = ov;
        label = lbl;
        wid = WidgetId.Next();
        wiresOwnEvents = true;
        Change = new UiEvent();
    }

    /// 有状态模式构造函数：`Radio a = new Radio(model, 0, "Option A");`
    Radio(SignalInt m, int ov, string lbl) {
        InitRadio(m, ov, lbl);
    }

    /// 自持信号：`Radio a = new Radio(0, "Option A");`，随后通过 `.data`
    /// 在组内每个单选按钮上绑定同一模型字段——调用处无需任何信号
    /// 连接代码。
    Radio(int ov, string lbl) {
        InitRadio(new SignalInt(0), ov, lbl);
    }

    static Radio Bind(SignalInt model, int optionValue) {
        Radio r = new Radio(model, optionValue, "");
        return r;
    }

    bool IsSelected() { return model.Get() == optionValue; }

    /// 将绑定的模型值拉入本地信号（model -> UI）。
    void SyncBinding() {
        if (data == null) { return; }
        int cur = data.Get();
        if (cur != model.Get()) { model.Set(cur); }
    }

    int Render(App app, int x, int y, string label) {
        int id = wid;
        SyncBinding();
        this.PaintStyled(app, id, x, y, label, model.Get() == optionValue);
        app.focus.RegisterFocusable(id);

        bool fire = Ui.Clicked(app, id);
        if (Ui.Focused(app, id) && app.EventKind() == 4) {
            int kc = app.window.EventKeyCode();
            if (kc == 32 || kc == 13) { fire = true; }
        }
        if (fire && model.Get() != optionValue) {
            model.Set(optionValue);
            if (data != null) { data.Set(optionValue); }
            Change.Raise();
            app.RequestRedraw();
        }
        On.Fire(app, id);
        return id;
    }

    override List<string> Events() {
        List<string> e = Control.CommonEvents();
        e.Add("Change");
        return e;
    }

    override string Kind() { return "Radio"; }

    override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec text = PropSpec.Text("label", "Label");
        text.str = label;
        text.Also("text");
        ps.Add(text);
        PropSpec opt = PropSpec.Int("option", "Option");
        opt.num = optionValue;
        ps.Add(opt);
        PropSpec sel = PropSpec.Int("value", "Selected");
        sel.snum = model;
        ps.Add(sel);
        return ps;
    }

    override void BindEvent(string evt, Action a) {
        if (evt == "Change") { Change.Add(a); return; }
        On.AddByName(evt, a);
    }

    int PaintStyled(App app, int id, int x, int y, string text, bool selected) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int target = 0;
        if (selected) { target = 1000; }
        int e = app.AnimTo(210000 + id, target, 130);
        int latched = Style.SChecked();
        StyleBox root = this.ResolveEasedLatchedStyleAs(
            app, id, "radio", Class, false, latched, e);
        StyleBox indicatorStyle = this.ResolveEasedLatchedPartAs(
            app, id, "radio", "indicator", "", Class, false, latched, e);
        StyleBox dotStyle = this.ResolveEasedLatchedPartAs(
            app, id, "radio", "dot", "", Class, false, latched, e);
        StyleBox labelStyle = this.ResolveEasedLatchedPartAs(
            app, id, "radio", "label", "", Class, false, latched, e);

        int diameter = indicatorStyle.WidthOr(app.Scale(18));
        int r = diameter / 2;
        int fontSize = labelStyle.FontOr(root.FontOr(t.fontSizeMedium));
        int gp = root.GapOr(app.Scale(8));
        int totalH = root.HeightOr(t.heightMedium);
        int totalW = root.WidthOr(diameter + gp + Canvas.MeasureText(text, fontSize));
        root.Paint(app, x, y, totalW, totalH);

        int cx = x + r;
        int cy = y + totalH / 2;
        int hv = Ui.HoverLevel(app, id);
        // 强调色来自 `radio::indicator` 部件（因此 `primary` /
        // `error` 等 class 可为整组重新着色），默认取主题
        // primary。圆点使用 `radio::dot` 的颜色，使语义分组选中后
        // 保持自身色调，而非总是白底主色。
        int accent = indicatorStyle.AccentOr(
            indicatorStyle.BorderOr(App.LerpColor(t.primary, t.primaryHover, hv)));
        int offBorder = App.LerpColor(t.borderPrimary, t.primaryHover, hv);
        int borderColor = indicatorStyle.BorderOr(App.LerpColor(offBorder, accent, e));
        int fillColor = indicatorStyle.BgOr(App.LerpColor(t.bgPrimary, accent, e));
        int inset = indicatorStyle.BorderWOr(App.Lerp(1, app.Scale(2), e));
        c.FillCircle(cx, cy, r, borderColor);
        c.FillCircle(cx, cy, r - inset, fillColor);
        if (e > 0) {
            int dotFull = dotStyle.WidthOr(app.Scale(8));
            int dotSize = App.Lerp(0, dotFull, e);
            // 圆点跟随组强调色（`radio::indicator` 边框），使
            // 选中时语义 class 为整个控件着色，而不是
            // 总是白底主色。
            int dotColor = dotStyle.AccentOr(dotStyle.BgOr(dotStyle.FgOr(accent)));
            c.FillCircle(cx, cy, dotSize / 2, dotColor);
        }

        int labelX = x + diameter + gp;
        int labelY = Canvas.CenterTextY(y, totalH, fontSize);
        c.DrawText(labelX, labelY, text, labelStyle.FgOr(root.FgOr(t.textPrimary)),
                   fontSize);
        app.hitTester.Register(new HitRegion(id, x, y, totalW, totalH, 2));
        return id;
    }

    override void OnMeasure(App app) {
        Theme t = app.theme;
        int latched = 0;
        if (model.Get() == optionValue) { latched = Style.SChecked(); }
        StyleBox root = this.ResolveStyleAs(app, "radio", Class, latched);
        StyleBox indicatorStyle = this.ResolvePartAs(app, "radio", "indicator", "",
                                                     Class, latched);
        StyleBox labelStyle = this.ResolvePartAs(app, "radio", "label", "",
                                                 Class, latched);
        int diameter = indicatorStyle.WidthOr(app.Scale(18));
        int fontSize = labelStyle.FontOr(root.FontOr(t.fontSizeMedium));
        prefH = root.HeightOr(t.heightMedium);
        prefW = root.WidthOr(diameter + root.GapOr(app.Scale(8))
                             + Canvas.MeasureText(label, fontSize));
    }

    override void OnPaint(App app) {
        this.Render(app, bx, by, label);
    }
}
