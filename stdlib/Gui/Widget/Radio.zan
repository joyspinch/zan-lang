using System;
using Gui;

namespace Gui.Widget;

/// 带响应式 int 绑定（选中索引）的单选按钮。
///
/// C# 风格的有状态实例（每个选项一个）：
///     Radio a = new Radio(0, "Option A");
///     a.Change += () => { ... };
///     a.Render(app, x, y, "Option A");
/// 为兼容现有调用方保留旧的立即模式静态方法。
class Radio : Control {
    /// 组内共享的选中信号：值为选中项的 optionValue（控件族内部
    /// 组装；应用代码经 data 绑定到同一模型字段）。
    SignalInt model;
    /// 双向绑定的选中值：`r.data = form.gender;` 使模型字段与组选择
    /// 双向保持同步（编译器降级的
    /// Binding）。组内每个单选按钮都绑定同一字段。
    Binding<int> data;
    /// 本按钮代表的选项值（组信号等于它时本按钮选中）。
    int optionValue;
    int wid;
    /// 按钮文本。
    string label;
    /// 尺寸档位（Naive UI size prop）：tiny/small/medium/large，
    /// 档位映射为 `radio.small` / `radio.large` 样式类（几何在
    /// base.css 的尺寸规则里）。
    Binding<string> Size;
    /// 边框变体（Element Plus el-radio border）：整个选项画成带
    /// 描边圆角盒，选中描边走强调色，语义色类照常联动。
    Binding<bool> Bordered;
    /// 该选项被选中时触发（C# 风格：`r.Change += h;`）。
    UiEvent Change;

    void InitRadio(SignalInt m, int ov, string lbl) {
        this.InitControl(lbl, 1);
        model = m;
        optionValue = ov;
        label = lbl;
        wid = WidgetId.Next();
        wiresOwnEvents = true;
        Size = "medium";
        Bordered = false;
        Change = new UiEvent();
    }

    /// Default constructor used by .zform and the string-kind registry.
    Radio() {
        InitRadio(new SignalInt(0), 0, "");
    }

    /// 自持信号：`Radio a = new Radio(0, "Option A");`，随后通过 `.data`
    /// 在组内每个单选按钮上绑定同一模型字段——调用处无需任何信号
    /// 连接代码；组互斥由共享字段经 SyncBinding 协调。
    Radio(int ov, string lbl) {
        InitRadio(new SignalInt(0), ov, lbl);
    }

    /// 共享组信号构造器——**控件族内部组装专用**（ChoiceGroup 以此
    /// 把子 Radio 接到组状态上）。应用代码不要用：外部通道只有
    /// `Radio(ov, lbl)` + `data`（§6.1）。
    Radio(SignalInt m, int ov, string lbl) {
        InitRadio(m, ov, lbl);
    }

    /// <summary>是否为当前选中项：绑定的组信号值等于本按钮的
    /// optionValue。同一组内恰好只有一个按钮为 true。</summary>
    bool IsSelected() { return model.Get() == optionValue; }

    /// <summary>运行期改写标题（老窗体切优化目标时改档位文案
    /// 「低 62-75%」/「低 0.05-0.07元」）。不触发重绘，调用方需自行
    /// RequestRedraw。</summary>
    void SetLabel(string v) {
        label = v;
    }

    override string Kind() { return "Radio"; }
    override Binding<string> SizeOf() { return Size; }

    /// 把尺寸档位与边框变体落到样式类上（Switch 的既有做法：
    /// AddClass 幂等，档位类不污染用户自设的语义色类）。
    void ApplyVariants() {
        this.AddClass(this.SizeCls());
        if (Bordered.Get()) { this.AddClass("bordered"); }
    }

    /// 将绑定的模型值拉入本地信号（model -> UI）。
    override void SyncBinding() {
        if (data == null) { return; }
        int cur = data.Get();
        if (cur != model.Get()) { model.Set(cur); }
    }

    /// <summary>立即模式渲染：绘制本按钮并处理点击/键盘（空格或回车
    /// 选中）。选中状态变化时写组信号与 data 绑定、Raise Change 并请求
    /// 重绘；已选中再点不重复触发。返回控件 id。</summary>
    int Render(App app, int x, int y, string label) {
        int id = wid;
        bool off = this.IsDisabled();
        this.ApplyVariants();
        SyncBinding();
        this.PaintStyled(app, id, x, y, label, model.Get() == optionValue);
        if (!off) { app.focus.RegisterFocusable(id); }

        bool fire = Ui.Clicked(app, id) && !off;
        if (!off && Ui.Focused(app, id) && app.EventKind() == 4) {
            int kc = app.window.EventKeyCode();
            if (kc == 32 || kc == 13) { fire = true; }
        }
        if (fire && model.Get() != optionValue) {
            model.Set(optionValue);
            if (data != null) { data.Set(optionValue); }
            Change.Raise();
            app.RequestRedraw();
        }
        if (!off) { On.Fire(app, id); }
        return id;
    }

    /// <summary>设计器事件清单：公共事件外加 Change。</summary>
    override List<string> Events() {
        List<string> e = Control.CommonEvents();
        e.Add("Change");
        return e;
    }

    /// <summary>设计器属性清单：label(=text)、option、value（优先指向
    /// 活的外部绑定，§6.1 单协议）、size 档位、bordered 变体。</summary>
    override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec text = PropSpec.Text("label", "Label");
        text.str = label;
        text.Also("text");
        ps.Add(text);
        PropSpec opt = PropSpec.Int("option", "Option");
        opt.num = optionValue;
        ps.Add(opt);
        PropSpec sel = PropSpec.Int("value", "Selected");
        // 属性通道优先指向活的外部绑定（§6.1 单协议）。
        if (data != null) { sel.num = data; } else { sel.snum = model; }
        ps.Add(sel);
        PropSpec sz = PropSpec.Enum("size", "Size",
            new List<string>{ "tiny", "small", "medium", "large" });
        sz.str = Size;
        ps.Add(sz);
        PropSpec bd = PropSpec.Bool("bordered", "Bordered");
        bd.flag = Bordered;
        ps.Add(bd);
        return ps;
    }

    /// <summary>事件路由：Change 走语义事件，其余按名转发给 On。</summary>
    override void BindEvent(string evt, Action a) {
        if (evt == "Change") { Change.Add(a); return; }
        On.AddByName(evt, a);
    }

    /// <summary>立即模式绘制主体：解析根/指示环/圆点/标签四个样式
    /// 分区，处理选中淡入动画（约 130ms）与边框变体内边距，最后登记
    /// 命中矩形。颜色全部来自 radio::indicator / ::dot 的 CSS 规则。</summary>
    int PaintStyled(App app, int id, int x, int y, string text, bool selected) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int target = 0;
        if (selected) { target = 1000; }
        int animW = this.prefW;
        if (animW <= 0) {
            StyleBox measureRoot = Style.Of(app, "radio", Class, Style.SNormal());
            StyleBox measureLabel = Style.Part(app, "radio", "label", "",
                                               Class, "", Style.SNormal());
            animW = measureRoot.PadLOr(0) + measureRoot.PadROr(0)
                + app.Scale(18) + app.Scale(8)
                + Canvas.MeasureText(text,
                    measureLabel.FontOr(Style.FontFallback(app, "medium")));
        }
        int animH = this.prefH;
        if (animH <= 0) { animH = t.heightMedium; }
        int e = app.AnimToIn(210000 + id, target, 130,
                             x, y, animW, animH);
        int latched = Style.SChecked();
        bool off = this.IsDisabled();
        StyleBox root = this.ResolveEasedLatchedStyleAsIn(
            app, id, "radio", Class, off, latched, e,
            x, y, animW, animH);
        StyleBox indicatorStyle = this.ResolveEasedLatchedPartAsIn(
            app, id, "radio", "indicator", "", Class, off, latched, e,
            x, y, animW, animH);
        StyleBox dotStyle = this.ResolveEasedLatchedPartAsIn(
            app, id, "radio", "dot", "", Class, off, latched, e,
            x, y, animW, animH);
        StyleBox labelStyle = this.ResolveEasedLatchedPartAsIn(
            app, id, "radio", "label", "", Class, off, latched, e,
            x, y, animW, animH);

        int diameter = indicatorStyle.WidthOr(app.Scale(18));
        int r = diameter / 2;
        int fontSize = labelStyle.FontOr(
            root.FontOr(Style.FontFallback(app, "medium")));
        int gp = root.GapOr(app.Scale(8));
        // 边框变体 / 皮肤的根内边距：指示环与标签整体向右让位，
        // 宽度兜底同样计入（否则 bordered 的文字贴住右边框）。
        int padL = root.PadLOr(0);
        int padR = root.PadROr(0);
        int totalH = root.HeightOr(t.heightMedium);
        int totalW = root.WidthOr(padL + padR + diameter + gp
                                  + Canvas.MeasureText(text, fontSize));
        root.Paint(app, x, y, totalW, totalH);

        int cx = x + padL + r;
        int cy = y + totalH / 2;
        // 颜色全部来自 `radio::indicator` / `::dot` 的 CSS 规则（语义
        // class 在 :checked 时为整组重新着色）；hover 淡变与选中
        // 交叉淡化已由 ResolveEasedLatchedPartAs 混好，这里只剩几何。
        int borderColor = indicatorStyle.BorderOr(root.fg);
        int fillColor = indicatorStyle.BgOr(0);
        int inset = indicatorStyle.BorderWOr(App.Lerp(1, app.Scale(2), e));
        c.FillCircle(cx, cy, r, borderColor);
        c.FillCircle(cx, cy, r - inset, fillColor);
        if (e > 0) {
            int dotFull = dotStyle.WidthOr(app.Scale(8));
            int dotSize = App.Lerp(0, dotFull, e);
            int dotColor = dotStyle.BgOr(dotStyle.AccentOr(dotStyle.FgOr(root.accent)));
            c.FillCircle(cx, cy, dotSize / 2, dotColor);
        }

        int labelX = x + padL + diameter + gp;
        int labelY = Canvas.CenterTextY(y, totalH, fontSize);
        c.DrawText(labelX, labelY, text, labelStyle.FgOr(root.fg), fontSize);
        app.hitTester.RegisterRect(id, x, y, totalW, totalH, 2);
        return id;
    }

    /// <summary>测布局：按样式规则（含边框变体）计算首选宽高，
    /// 宽度兜底 = 左右内边距 + 指示环直径 + 间距 + 文本宽。</summary>
    override void OnMeasure(App app) {
        Theme t = app.theme;
        this.ApplyVariants();
        int latched = 0;
        if (model.Get() == optionValue) { latched = Style.SChecked(); }
        if (this.IsDisabled()) { latched = latched + Style.SDisabled(); }
        StyleBox root = this.ResolveStyleAs(app, "radio", Class, latched);
        StyleBox indicatorStyle = this.ResolvePartAs(app, "radio", "indicator", "",
                                                     Class, latched);
        StyleBox labelStyle = this.ResolvePartAs(app, "radio", "label", "",
                                                 Class, latched);
        int diameter = indicatorStyle.WidthOr(app.Scale(18));
        int fontSize = labelStyle.FontOr(
            root.FontOr(Style.FontFallback(app, "medium")));
        int padW = root.PadLOr(0) + root.PadROr(0);
        prefH = root.HeightOr(t.heightMedium);
        prefW = root.WidthOr(padW + diameter + root.GapOr(app.Scale(8))
                             + Canvas.MeasureText(label, fontSize));
    }

    override void OnPaint(App app) {
        this.Render(app, bx, by, label);
    }
}
