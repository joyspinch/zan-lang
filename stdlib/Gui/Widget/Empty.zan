using System;
using Gui;

namespace Gui.Widget;

/// 空状态占位：大图形加一行说明。两者都通过 CSS
/// 部件设置样式，`empty::icon` 和 `empty::label` 控制其大小和
/// 颜色，代码侧只需简单赋值：
///
///     Empty e = new Empty { Text = "No records yet" };
///     e.Icon = "search";
class Empty : Control {
    /// 可绑定标题：`e.Text = vm.emptyHint;` 每帧重新读取模型字段
    /// （编译器降级的 Binding）；字面量则存为常量。
    Binding<string> Text;
    /// 大图形字形名（默认 "folder"）。
    string Icon;

    /// 初始化：标题文本（可绑定），图形默认 "folder"。
    void InitEmpty(string msg) {
        this.InitControl(msg, 5);
        Text = msg;
        Icon = "folder";
    }

    /// 空标题（设计器用）。
    Empty() { InitEmpty(""); }
    /// 给定标题文本。
    Empty(string msg) { InitEmpty(msg); }

    /// 当前标题（通过绑定解析）。
    string Label() {
        if (Text == null) { return ""; }
        return Text.Get();
    }

    /// 覆写：首选尺寸取 `empty` 样式宽高（默认 240 x 120）。
    override void OnMeasure(App app) {
        StyleBox s = this.ResolveStyleAs(app, "empty", Class, Style.SNormal());
        prefH = s.HeightOr(app.Scale(120));
        prefW = s.WidthOr(app.Scale(240));
    }

    /// 覆写：垂直居中画大图形与标题行（样式部件 empty::icon / ::label）。
    override void OnPaint(App app) {
        string text = this.Label();
        string icon = Icon;
        string cls = Class;

        Canvas c = app.canvas;
        Theme t = app.theme;
        StyleBox gs = Style.Part(app, "empty", "icon", "", cls, "",
                                 Style.SNormal());
        StyleBox ls = Style.Part(app, "empty", "label", "", cls, "",
                                 Style.SNormal());
        int glyph = gs.FontOr(app.Scale(40));
        int fs = ls.FontOr(Style.FontFallback(app, "medium"));
        c.DrawGlyphIn(icon, bx, by + bh / 2 - glyph, bw, glyph, glyph,
                            gs.FgOr(0));
        c.DrawTextCentered(bx, by + bh / 2 + t.gapMedium, bw, Canvas.FontHeight(fs),
                           text, ls.FgOr(0), fs);
    }






    // ---- 设计器 / 序列化模型 ----

    /// 控件类型标识（序列化/设计器用）。
    override string Kind() { return "Empty"; }

    /// 覆写：返回设计器属性清单（标题 / 图形 / 类）。
    override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec text = PropSpec.Text("text", "Text");
        text.str = Text;
        text.AsName();
        ps.Add(text);
        PropSpec icon = PropSpec.Text("icon", "Icon");
        icon.str = Icon;
        ps.Add(icon);
        ps.Add(PropSpec.Text("class", "Classes"));
        return ps;
    }
}
