using System;
using Gui;

namespace Gui.Widget;

/// An empty-state placeholder: a large glyph over a caption. Both are styled
/// parts, so `empty::icon` and `empty::label` in CSS control their size and
/// colour, and the code side is plain assignment:
///
///     Empty e = new Empty { Text = "No records yet" };
///     e.Icon = "search";
class Empty : Control {
    /// Bindable caption: `e.Text = vm.emptyHint;` re-reads the model field every
    /// frame (compiler-lowered Binding); a literal stores a constant.
    Binding<string> Text;
    string Icon;

    void InitEmpty(string msg) {
        this.InitControl(msg, 5);
        Text = msg;
        Icon = "folder";
    }

    Empty() { InitEmpty(""); }
    Empty(string msg) { InitEmpty(msg); }

    /// Current caption (resolved through the binding).
    string Label() {
        if (Text == null) { return ""; }
        return Text.Get();
    }

    override void OnMeasure(App app) {
        StyleBox s = this.ResolveStyleAs(app, "empty", Class, Style.SNormal());
        prefH = s.HeightOr(app.Scale(120));
        prefW = s.WidthOr(app.Scale(240));
    }

    override void OnPaint(App app) {
        Empty.Paint(app, bx, by, bw, bh, this.Label(), Icon, Class);
    }

    /// Glyph and caption centred in the box.
    static void Paint(App app, int x, int y, int w, int h, string text,
                      string icon, string cls) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        StyleBox gs = Style.Part(app, "empty", "icon", "", cls, "",
                                 Style.SNormal());
        StyleBox ls = Style.Part(app, "empty", "label", "", cls, "",
                                 Style.SNormal());
        int glyph = gs.FontOr(app.Scale(40));
        int fs = ls.FontOr(t.fontSizeMedium);
        c.DrawGlyphIn(icon, x, y + h / 2 - glyph, w, glyph, glyph,
                            gs.FgOr(t.textTertiary));
        c.DrawTextCentered(x, y + h / 2 + t.gapMedium, w, Canvas.FontHeight(fs),
                           text, ls.FgOr(t.textTertiary), fs);
    }

    static void Render(App app, int x, int y, int w, int h, string message) {
        Empty.Paint(app, x, y, w, h, message, "folder", "");
    }

    // ---- designer / serialization model -------------------------------------

    override string Kind() { return "Empty"; }

    override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec text = PropSpec.Text("text", "Text");
        text.str = Text;
        text.AsName();
        ps.Add(text);
        PropSpec icon = PropSpec.Text("icon", "Icon");
        icon.str = Icon;
        ps.Add(icon);
        ps.Add(PropSpec.Text("class", "Classes"));
        return ps;
    }
}
