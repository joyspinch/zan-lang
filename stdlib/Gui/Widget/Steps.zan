using System;
using Gui;

namespace Gui.Widget;

/// One step: its label and an optional description line. Stored as an entity
/// so label and description stay a single coherent record instead of two
/// parallel lists that must be kept index-aligned by hand.
class Step {
    string label;
    string desc;

    Step(string label, string desc) {
        this.label = label;
        this.desc = desc;
    }
}

/// A steps indicator: numbered circles joined by a connector, with the current
/// step read from a signal. Circles, connector and labels are styled parts
/// (`steps::circle`, `::line`, `::label`, `::desc`), each resolved with the
/// step's state as a class, so a skin restyles them and the code side is plain
/// assignment:
///
///     Steps s = new Steps(SignalInt.Create(0)) { Class = "vertical" };
///     s.AddStep("Details");
///     s.AddStepDesc("Account", "Email and password");
///     s.ErrorIndex = 1;
///
/// Classes: `vertical` stacks the steps, the semantic roles (`primary` … `error`)
/// pick the accent; the per-step state classes a skin can target are `done`,
/// `active`, `pending` and `error`.
class Steps : Control {
    List<Step> steps;
    SignalInt model;
    /// Two-way bound current step: `steps.data = wizard.step;` keeps the model
    /// field and the indicator in sync (compiler-lowered Binding). Optional;
    /// when unset the indicator reads its internal SignalInt only.
    Binding<int> data;
    /// Step painted as errored; -1 for none.
    int ErrorIndex;

    void InitSteps(SignalInt m) {
        this.InitControl("steps", 1);
        steps = new List<Step>();
        model = m;
        data = null;
        ErrorIndex = -1;
    }

    Steps(SignalInt m) { InitSteps(m); }

    /// Pull the bound model value into the local signal (model -> UI).
    void SyncBinding() {
        if (data == null) { return; }
        int cur = data.Get();
        if (cur != model.Get()) { model.Set(cur); }
    }

    void AddStep(string label) {
        steps.Add(new Step(label, ""));
    }

    /// Adds a step with a secondary description line (shown in vertical layout).
    void AddStepDesc(string label, string desc) {
        steps.Add(new Step(label, desc));
    }

    bool IsVertical() { return Style.Has(Class, "vertical"); }

    int RowGap(App app) { return app.Scale(48); }

    override void OnMeasure(App app) {
        StyleBox s = this.ResolveStyleAs(app, "steps", Class, Style.SNormal());
        if (this.IsVertical()) {
            int count = steps.Count;
            if (count < 1) { count = 1; }
            prefH = count * this.RowGap(app);
            prefW = s.WidthOr(app.Scale(280));
        } else {
            prefH = s.HeightOr(app.Scale(13) * 2 + app.Scale(8)
                + Canvas.FontHeight(app.theme.fontSizeSmall));
            prefW = s.WidthOr(app.Scale(320));
        }
    }

    override void OnPaint(App app) {
        SyncBinding();
        if (this.IsVertical()) {
            Steps.PaintVertical(app, bx, by, this.RowGap(app), steps,
                                model.Get(), ErrorIndex, Class);
        } else {
            Steps.PaintHorizontal(app, bx, by, bw, steps, model.Get(),
                                  ErrorIndex, Class);
        }
    }

    /// Immediate-mode horizontal steps from a label list.
    static void Render(App app, int x, int y, int totalWidth,
                       List<string> labels, SignalInt model) {
        Steps.RenderStatus(app, x, y, totalWidth, labels, model.Get(), -1);
    }

    /// Immediate-mode horizontal steps with an errored step (-1 for none).
    static void RenderStatus(App app, int x, int y, int totalWidth,
                             List<string> labels, int current, int errorIndex) {
        List<Step> items = new List<Step>();
        int i = 0;
        while (i < labels.Count) {
            items.Add(new Step(labels[i], ""));
            i = i + 1;
        }
        Steps.PaintHorizontal(app, x, y, totalWidth, items, current, errorIndex,
                              "");
    }

    /// The class list a step's position in the sequence stands for, so every
    /// part of a step (circle, label, description) resolves from one state. The
    /// state names are the design system's shared sequence vocabulary.
    static string StateClass(string cls, int index, int current,
                             int errorIndex) {
        return cls + " " + Style.StateClass(index, current, errorIndex);
    }

    /// A step circle: completed (check), errored (!), active or pending (number).
    static void Circle(App app, int cx, int cy, int r, int index, int current,
                       int errorIndex, string cls) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        string state = Steps.StateClass(cls, index, current, errorIndex);
        StyleBox s = Style.Of(app, "steps", cls, Style.SNormal());
        StyleBox cs = Style.Part(app, "steps", "circle", "", state, "",
                                 Style.SNormal());
        int accent = s.AccentOr(t.primary);

        int fill = t.borderPrimary;
        int glyph = t.textPrimary;
        if (index < current || index == current) { fill = accent; glyph = t.textInverse; }
        if (index == errorIndex) { fill = t.error; glyph = t.textInverse; }
        fill = cs.BgOr(fill);
        glyph = cs.FgOr(glyph);

        c.FillCircle(cx, cy, cs.HeightOr(r * 2) / 2, fill);
        int fs = cs.FontOr(t.fontSizeSmall);
        int fh = Canvas.FontHeight(fs);
        if (index == errorIndex) {
            c.DrawTextCentered(cx - r, cy - fh / 2, r * 2, fh, "!", glyph, fs);
        } else if (index < current) {
            int ck = app.Scale(12);
            Icon.Draw(c, "check", cx - ck / 2, cy - ck / 2, ck, glyph);
        } else {
            c.DrawTextCentered(cx - r, cy - fh / 2, r * 2, fh,
                               Convert.ToString(index + 1), glyph, fs);
        }
    }

    /// The connector between two circles, in the style the later step selects.
    static void Line(App app, int x0, int y0, int x1, int y1, int index,
                     int current, int errorIndex, string cls) {
        Theme t = app.theme;
        StyleBox s = Style.Of(app, "steps", cls, Style.SNormal());
        StyleBox ls = Style.Part(app, "steps", "line", "",
                                 Steps.StateClass(cls, index, current,
                                                  errorIndex),
                                 "", Style.SNormal());
        int color = t.borderPrimary;
        if (index <= current) { color = s.AccentOr(t.primary); }
        app.canvas.DrawLine(x0, y0, x1, y1, ls.BgOr(color),
                            ls.HeightOr(app.Scale(1)));
    }

    /// Horizontal steps: circles across `totalWidth` with the label under each.
    static void PaintHorizontal(App app, int x, int y, int totalWidth,
                                List<Step> steps, int current, int errorIndex,
                                string cls) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int count = steps.Count;
        if (count == 0) { return; }

        int stepW = totalWidth / count;
        int circleR = app.Scale(13);
        int i = 0;
        while (i < count) {
            int cx = x + i * stepW + stepW / 2;
            if (i > 0) {
                int prevCx = x + (i - 1) * stepW + stepW / 2;
                Steps.Line(app, prevCx + circleR + app.Scale(2), y + circleR,
                           cx - circleR - app.Scale(2), y + circleR, i, current,
                           errorIndex, cls);
            }
            Steps.Circle(app, cx, y + circleR, circleR, i, current, errorIndex,
                         cls);

            StyleBox ls = Style.Part(app, "steps", "label", "",
                                     Steps.StateClass(cls, i, current,
                                                      errorIndex),
                                     "", Style.SNormal());
            int fs = ls.FontOr(t.fontSizeSmall);
            c.DrawTextCentered(cx - stepW / 2, y + circleR * 2 + app.Scale(8),
                               stepW, Canvas.FontHeight(fs), steps[i].label,
                               ls.FgOr(Steps.LabelColor(t, i, current,
                                                        errorIndex)),
                               fs);
            i = i + 1;
        }
    }

    /// Vertical steps: circles stacked top-to-bottom with a connector line and
    /// a label (+ optional description) to the right of each circle.
    static void PaintVertical(App app, int x, int y, int rowGap,
                              List<Step> steps, int current, int errorIndex,
                              string cls) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int count = steps.Count;
        if (count == 0) { return; }

        int circleR = app.Scale(13);
        int i = 0;
        while (i < count) {
            int cy = y + i * rowGap + circleR;
            if (i > 0) {
                int prevCy = y + (i - 1) * rowGap + circleR;
                Steps.Line(app, x + circleR, prevCy + circleR + app.Scale(2),
                           x + circleR, cy - circleR - app.Scale(2), i, current,
                           errorIndex, cls);
            }
            Steps.Circle(app, x + circleR, cy, circleR, i, current, errorIndex,
                         cls);

            string state = Steps.StateClass(cls, i, current, errorIndex);
            StyleBox ls = Style.Part(app, "steps", "label", "", state, "",
                                     Style.SNormal());
            StyleBox ds = Style.Part(app, "steps", "desc", "", state, "",
                                     Style.SNormal());
            int lf = ls.FontOr(t.fontSizeMedium);
            int df = ds.FontOr(t.fontSizeSmall);
            int labelColor = ls.FgOr(Steps.LabelColor(t, i, current,
                                                      errorIndex));
            int tx = x + circleR * 2 + app.Scale(12);
            int fh = Canvas.FontHeight(lf);
            Step st = steps[i];
            if (st.desc == "") {
                c.DrawText(tx, cy - fh / 2, st.label, labelColor, lf);
            } else {
                // Two-line block (label over description) vertically centred on
                // the circle, both left-aligned so they never overlap.
                int blockTop = cy - (fh + Canvas.FontHeight(df)) / 2;
                c.DrawText(tx, blockTop, st.label, labelColor, lf);
                c.DrawText(tx, blockTop + fh, st.desc,
                           ds.FgOr(t.textTertiary), df);
            }
            i = i + 1;
        }
    }

    static int LabelColor(Theme t, int index, int current, int errorIndex) {
        if (index == errorIndex) { return t.error; }
        if (index == current) { return t.textPrimary; }
        return t.textSecondary;
    }

    // ---- designer / serialization model -------------------------------------

    override string Kind() { return "Steps"; }

    override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        ps.Add(PropSpec.Int("current", "Current step"));
        ps.Add(PropSpec.Int("error", "Errored step"));
        ps.Add(PropSpec.Text("class", "Classes"));
        return ps;
    }

    override string GetProp(string key) {
        if (key == "current") { return Convert.ToString(model.Get()); }
        if (key == "error") { return Convert.ToString(ErrorIndex); }
        if (key == "class") { return Class; }
        return "";
    }

    override void SetProp(string key, string val) {
        if (key == "current") { model.Set(Convert.ToInt32(val)); }
        else if (key == "error") { ErrorIndex = Convert.ToInt32(val); }
        else if (key == "class") { Class = val; }
        else if (val == "true") { Class = Class + " " + key; }
        else if (val != "" && val != "false") { Class = Class + " " + val; }
    }
}
