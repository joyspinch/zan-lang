using System;
using Gui;

namespace Gui.Widget;

/// A strip of buttons as a retained control: it measures every button at its
/// natural width, wraps onto another line when the strip is too narrow for them
/// (instead of squeezing labels into ellipses) and reports which one was
/// pressed. Its own box comes from the layout/CSS (`height`, `gap`).
class ButtonBar : Control {
    List<Button> buttons;
    int pressed;
    /// Line height and the number of lines measured for the current box.
    int lineH;
    int lines;

    static ButtonBar Create(string cls) {
        ButtonBar b = new ButtonBar();
        b.InitControl("buttonbar", 5);
        b.Class = cls;
        b.buttons = new List<Button>();
        b.pressed = 0 - 1;
        b.lineH = 0;
        b.lines = 1;
        return b;
    }

    override string Kind() { return "ButtonBar"; }

    override string StyleType() { return "buttonbar"; }

    ButtonBar Add(Button b) {
        buttons.Add(b);
        return this;
    }

    Button At(int i) { return buttons[i]; }

    /// Every button's natural width.
    List<int> Widths(App app) {
        List<int> w = new List<int>();
        int i = 0;
        while (i < buttons.Count) {
            w.Add(buttons[i].AutoWidth(app));
            i = i + 1;
        }
        return w;
    }

    int Gap(App app) {
        int g = this.StyleGap();
        if (g < 0) { g = app.theme.gapSmall; }
        return g;
    }

    /// Height the strip needs for the width it was given: one line per group of
    /// buttons that fits, so the parent layout reserves room for the wrap.
    override void OnMeasure(App app) {
        lineH = app.theme.heightMedium;
        if (buttons.Count > 0) { lineH = buttons[0].AutoHeight(app); }
        lines = 1;
        if (bw > 0) {
            List<int> w = this.Widths(app);
            int gapPx = this.Gap(app);
            int used = 0;
            int i = 0;
            while (i < w.Count) {
                int step = w[i];
                if (used > 0) { step = step + gapPx; }
                if (used + step > bw && used > 0) {
                    lines = lines + 1;
                    used = w[i];
                } else {
                    used = used + step;
                }
                i = i + 1;
            }
        }
        prefH = lines * lineH + (lines - 1) * this.Gap(app);
    }

    override void OnPaint(App app) {
        pressed = 0 - 1;
        int n = buttons.Count;
        if (n == 0 || bw <= 0) { return; }
        List<int> w = this.Widths(app);
        int gapPx = this.Gap(app);
        int x = bx;
        int y = by;
        int i = 0;
        while (i < n) {
            int bwi = w[i];
            if (x > bx && x + bwi > bx + bw) {
                x = bx;
                y = y + lineH + gapPx;
            }
            if (bwi > bw) { bwi = bw; }
            int id = buttons[i].Render(app, x, y, bwi);
            if (Ui.Clicked(app, id)) { pressed = i; }
            x = x + bwi + gapPx;
            i = i + 1;
        }
    }

    /// The button pressed during the last frame (-1 = none). Consumed by the
    /// read so a page acts on it exactly once.
    int TakePressed() {
        int i = pressed;
        pressed = 0 - 1;
        return i;
    }
}
