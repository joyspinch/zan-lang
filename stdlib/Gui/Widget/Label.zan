using System;
using Gui;

namespace Gui.Widget;

/// 文本标签。颜色与字号来自 `label` CSS 规则，通过
/// 与设计系统其余部分共用的类来选择：
///
///     Label l = new Label { Text = "Name" };
///     l.Class = "secondary small";       // 弱化的说明文字
///     l.Text = vm.status;                // 绑定，每帧重读
///
/// 类：`secondary` / `hint` / `inverse` 以及语义角色
/// （`primary` … `error`）决定颜色，`tiny` / `small` / `medium` / `large`
/// 和 `title` 决定字号。
class Label : Control {
    /// 可绑定文本：`lbl.Text = vm.status;` 每帧重新读取模型字段
    /// （编译器降级的 Binding）；字面量则存为常量。
    Binding<string> Text;
    /// 自动换行：为 true 时，标签将文本折成
    /// 适合槽宽的若干行，而不是用省略号截断。高度随行数变化。
    bool wrap;

    /// 初始化：文本（可绑定），默认不换行。
    void InitLabel(string txt) {
        this.InitControl(txt, 1);
        Text = txt;
        wrap = false;
    }

    /// 空标签（设计器用）。
    Label() { InitLabel(""); }
    /// 给定初值文本。
    Label(string txt) { InitLabel(txt); }

    /// 当前文本（通过绑定解析）。
    string Str() {
        if (Text == null) { return ""; }
        return Text.Get();
    }

    /// 解析 `label` 样式（带缓存）。
    StyleBox ResolvedStyle(App app) {
        return this.ResolveStyleCached(app, "label", Class, Style.SNormal());
    }

    /// 覆写：测文本宽高；wrap 时按槽宽折行，取最大行宽与行数总高。
    override void OnMeasure(App app) {
        StyleBox s = this.ResolvedStyle(app);
        int fs = s.FontOr(Style.FontFallback(app, "medium"));
        string txt = this.Str();
        if (wrap) {
            int slotW = bw;
            if (slotW <= 0) { slotW = prefW; }
            if (slotW <= 0) { slotW = app.canvas.Width(); }
            List<string> lines = TextWrap.Lines(txt, slotW, fs);
            prefH = lines.Count * Canvas.FontHeight(fs) + app.theme.gapSmall;
            int maxW = 0;
            for (int li = 0; li < lines.Count; li = li + 1) {
                int lw = Canvas.MeasureText(lines[li], fs);
                if (lw > maxW) { maxW = lw; }
            }
            prefW = maxW;
            return;
        }
        prefH = Canvas.FontHeight(fs) + app.theme.gapSmall;
        prefW = Canvas.MeasureText(txt, fs);
    }

    /// 覆写：画文本；wrap 时逐行绘制，否则超宽省略号截断并垂直居中。
    override void OnPaint(App app) {
        StyleBox s = this.ResolvedStyle(app);
        int fs = s.FontOr(Style.FontFallback(app, "medium"));
        string txt = this.Str();
        if (wrap) {
            int slotW = bw;
            if (slotW <= 0) { slotW = Canvas.MeasureText(txt, fs); }
            List<string> lines = TextWrap.Lines(txt, slotW, fs);
            int lh = Canvas.FontHeight(fs);
            int n = lines.Count;
            int total = n * lh;
            int ty = by + (bh - total) / 2;
            if (ty < by) { ty = by; }
            for (int li = 0; li < n; li = li + 1) {
                app.canvas.DrawText(bx, ty, lines[li], s.FgOr(0), fs);
                ty = ty + lh;
            }
            return;
        }
        // 填充型标签宽度等于槽宽而非文本宽，因此
        // 很长的值（如项目路径）也不会溢出容器。
        if (bw > 0 && Canvas.MeasureText(txt, fs) > bw) {
            txt = Ellipsis.Fit(txt, bw, fs);
        }
        app.canvas.DrawText(bx, Canvas.CenterTextY(by, bh, fs), txt,
                            s.FgOr(0), fs);
    }

    // ---- 设计器 / 序列化模型 ----

    /// 控件类型标识（序列化/设计器用）。
    override string Kind() { return "Label"; }

    /// 覆写：返回设计器属性清单（文本 / 换行 / 类）。
    override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec text = PropSpec.Text("text", "Text");
        text.str = Text;
        text.AsName();
        ps.Add(text);
        PropSpec w = PropSpec.Bool("wrap", "Wrap");
        w.flag = wrap;
        ps.Add(w);
        ps.Add(PropSpec.Text("class", "Classes"));
        return ps;
    }
}
