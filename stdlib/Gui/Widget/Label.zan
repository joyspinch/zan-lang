using System;
using Gui;

namespace Gui.Widget;

/// A text label. Colour and font size come from the `label` CSS rules, selected
/// by classes shared with the rest of the design system:
///
///     Label l = new Label { Text = "Name" };
///     l.Class = "secondary small";       // de-emphasised caption
///     l.Text = vm.status;                // binds, re-read every frame
///
/// Classes: `secondary` / `hint` / `inverse` and the semantic roles
/// (`primary` … `error`) pick the colour, `tiny` / `small` / `medium` / `large`
/// and `title` pick the size.
class Label : Control {
    /// Bindable text: `lbl.Text = vm.status;` re-reads the model field every
    /// frame (compiler-lowered Binding); a literal stores a constant.
    Binding<string> Text;

    void InitLabel(string txt) {
        this.InitControl(txt, 1);
        Text = txt;
    }

    Label() { InitLabel(""); }
    Label(string txt) { InitLabel(txt); }

    /// Current text (resolved through the binding).
    string Str() {
        if (Text == null) { return ""; }
        return Text.Get();
    }

    StyleBox ResolvedStyle(App app) {
        return this.ResolveStyleAs(app, "label", Class, Style.SNormal());
    }

    override void OnMeasure(App app) {
        StyleBox s = this.ResolvedStyle(app);
        int fs = s.FontOr(app.theme.fontSizeMedium);
        prefH = Canvas.FontHeight(fs) + app.theme.gapSmall;
        prefW = Canvas.MeasureText(this.Str(), fs);
    }

    override void OnPaint(App app) {
        StyleBox s = this.ResolvedStyle(app);
        int fs = s.FontOr(app.theme.fontSizeMedium);
        string txt = this.Str();
        // A filled label is as wide as its slot, not as wide as its text, so a
        // long value (a project path) would otherwise run out of its container.
        if (bw > 0 && Canvas.MeasureText(txt, fs) > bw) {
            txt = Ellipsis.Fit(txt, bw, fs);
        }
        app.canvas.DrawText(bx, Canvas.CenterTextY(by, bh, fs), txt,
                            s.FgOr(app.theme.textPrimary), fs);
    }

    /// Immediate-mode text in the style `cls` selects; every helper below is
    /// this call with a class, so a skin's `label.hint` rule reaches all of them.
    static void Paint(App app, int x, int y, string text, string cls) {
        StyleBox s = Style.Of(app, "label", cls, Style.SNormal());
        app.canvas.DrawText(x, y, text, s.FgOr(app.theme.textPrimary),
                            s.FontOr(app.theme.fontSizeMedium));
    }

    static void Render(App app, int x, int y, string text) {
        Label.Paint(app, x, y, text, "");
    }

    static void Secondary(App app, int x, int y, string text) {
        Label.Paint(app, x, y, text, "secondary");
    }

    static void Small(App app, int x, int y, string text) {
        Label.Paint(app, x, y, text, "secondary small");
    }

    /// Small text in a caller-supplied colour, for semantic colouring the
    /// theme roles do not cover (log levels, syntax colours, diff status).
    static void SmallColored(App app, int x, int y, string text, int color) {
        app.canvas.DrawText(x, y, text, color,
            Style.Of(app, "label", "small", Style.SNormal())
                .FontOr(app.theme.fontSizeSmall));
    }

    /// Small disabled/placeholder text.
    static void Disabled(App app, int x, int y, string text) {
        app.canvas.DrawText(x, y, text, app.theme.textDisabled,
            Style.Of(app, "label", "small", Style.SNormal())
                .FontOr(app.theme.fontSizeSmall));
    }

    /// The smallest de-emphasised text (dense metadata, field captions).
    static void Tiny(App app, int x, int y, string text) {
        Label.Paint(app, x, y, text, "hint tiny");
    }

    /// Small primary-coloured text (compact headers inside panels).
    static void SmallStrong(App app, int x, int y, string text) {
        Label.Paint(app, x, y, text, "small");
    }

    /// De-emphasised small text (hints, captions, secondary metadata).
    static void Hint(App app, int x, int y, string text) {
        Label.Paint(app, x, y, text, "hint small");
    }

    static void Large(App app, int x, int y, string text) {
        Label.Paint(app, x, y, text, "large");
    }

    static void Title(App app, int x, int y, string text) {
        Label.Paint(app, x, y, text, "title");
    }

    static void WithIcon(App app, int x, int y, string iconName, string text) {
        StyleBox s = Style.Of(app, "label", "", Style.SNormal());
        int fs = s.FontOr(app.theme.fontSizeMedium);
        int color = s.FgOr(app.theme.textPrimary);
        app.canvas.DrawGlyph(iconName, x, y, fs, color);
        app.canvas.DrawText(x + fs + app.theme.gapSmall, y, text, color, fs);
    }

    // ---- designer / serialization model -------------------------------------

    override string Kind() { return "Label"; }

    override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec text = PropSpec.Text("text", "Text");
        text.str = Text;
        text.AsName();
        ps.Add(text);
        ps.Add(PropSpec.Text("class", "Classes"));
        return ps;
    }
}
