using System;
using Gui;

namespace Gui.Widget;

/// 页面页眉：返回箭头、标题和可选副标题行。与按钮一样，
/// 它自己处理交互（箭头触发 `Back`），外观由
/// 类和样式部件（`pageheader::back`、`::title`、`::subtitle`）决定：
///
///     PageHeader h = new PageHeader { Text = "Details" };
///     h.Subtitle = "GUI reference";
///     h.Back.On(vm.GoBack);
class PageHeader : Control {
    /// 标题文本（可绑定）。
    Binding<string> Text;
    /// 副标题文本（可绑定）；空串不画该行。
    Binding<string> Subtitle;
    /// 返回图标字形；"" 表示隐藏。
    string Icon;
    int wid;
    /// 点击返回箭头时触发（Post 到 UI 线程队列）。
    UiEvent Back;

    /// 初始化：以标题文本注册为控件，置副标题/返回图标并自管 Back 事件。
    void InitPageHeader(string ttl, string sub) {
        this.InitControl(ttl, 1);
        Text = ttl;
        Subtitle = sub;
        Icon = "arrow-left";
        wid = WidgetId.Next();
        wiresOwnEvents = true;
        Back = new UiEvent();
    }

    /// 空页眉（设计器用）。
    PageHeader() { InitPageHeader("", ""); }
    /// 标题 + 副标题。
    PageHeader(string ttl, string sub) { InitPageHeader(ttl, sub); }

    /// 当前标题；Text 为 null 时返回空串。
    string Label() {
        if (Text == null) { return ""; }
        return Text.Get();
    }

    /// 当前副标题；Subtitle 为 null 时返回空串。
    string Sub() {
        if (Subtitle == null) { return ""; }
        return Subtitle.Get();
    }

    /// 解析页眉自身的样式盒（`pageheader` 规则）。
    StyleBox ResolvedStyle(App app) {
        return this.ResolveStyleAs(app, "pageheader", Class, Style.SNormal());
    }

    /// 覆写：标题行高（有副标题时再加一行）定高，宽度取样式表或
    /// 兜底 320。
    override void OnMeasure(App app) {
        Theme t = app.theme;
        StyleBox s = this.ResolvedStyle(app);
        StyleBox ss = Style.Part(app, "pageheader", "subtitle", "", Class, "",
                                 Style.SNormal());
        int titleLineH = Canvas.FontHeight(PageHeader.TitleFont(app, Class));
        prefH = titleLineH;
        if (this.Sub() != "") {
            prefH = titleLineH + t.gapSmall
                  + Canvas.FontHeight(ss.FontOr(Style.FontFallback(app, "medium")));
        }
        prefW = s.WidthOr(app.Scale(320));
    }

    /// 覆写：画返回箭头（hover 态、登记命中并触发 Back）、标题与
    /// 可选副标题行。
    override void OnPaint(App app) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        string cls = Class;
        StyleBox bs = Style.Part(app, "pageheader", "back", "", cls, "",
                                 Style.SNormal());
        StyleBox ts = Style.Part(app, "pageheader", "title", "", cls, "",
                                 Style.SNormal());
        StyleBox ss = Style.Part(app, "pageheader", "subtitle", "", cls, "",
                                 Style.SNormal());

        int titleFont = ts.FontOr(Style.FontFallback(app, "large") + 2);
        int titleLineH = Canvas.FontHeight(titleFont);
        int tx = bx;
        if (Icon != "") {
            int arrowBox = bs.WidthOr(t.iconSizeMedium);
            StyleBox back = Style.Part(app, "pageheader", "back", "", cls, "",
                                       app.focus.IsHovered(wid) ? Style.SHover()
                                                                  : Style.SNormal());
            int arrowColor = back.FgOr(0);
            // 箭头是唯一可交互的部分，因此 hover 只作用于它自身的
            // 盒子，而不是整行页眉。
            c.DrawGlyphIn(Icon, bx, by, arrowBox, titleLineH, arrowBox,
                          arrowColor);
            app.hitTester.RegisterRect(wid, bx, by, arrowBox,
                                                    titleLineH, 0);
            tx = bx + arrowBox + t.paddingMedium;
            if (Ui.Clicked(app, wid)) {
                Back.Post();
                app.window.Wake();
            }
        }

        c.DrawText(tx, by - 2, this.Label(), ts.FgOr(0), titleFont);
        string subtitle = this.Sub();
        if (subtitle == "") { return; }
        int subFont = ss.FontOr(Style.FontFallback(app, "medium"));
        c.DrawText(tx, by + titleLineH + t.gapSmall, subtitle,
                   ss.FgOr(0), subFont);
    }

    /// 标题字体：页眉携带的标题类，默认 `h3`。
    static int TitleFont(App app, string cls) {
        StyleBox ts = Style.Part(app, "pageheader", "title", "", cls, "",
                                 Style.SNormal());
        return ts.FontOr(Style.FontFallback(app, "large") + 2);
    }




    // ---- 设计器 / 序列化模型 ----

    /// 控件类型标识（序列化/设计器用）。
    override string Kind() { return "PageHeader"; }

    /// 覆写：返回设计器属性清单（text/subtitle/icon/class）。
    override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec text = PropSpec.Text("text", "Text");
        text.str = Text;
        text.AsName();
        ps.Add(text);
        PropSpec sub = PropSpec.Text("subtitle", "Subtitle");
        sub.str = Subtitle;
        ps.Add(sub);
        PropSpec icon = PropSpec.Text("icon", "Back icon");
        icon.str = Icon;
        ps.Add(icon);
        ps.Add(PropSpec.Text("class", "Classes"));
        return ps;
    }

    /// 覆写：公共事件之外提供 "Back"。
    override List<string> Events() {
        List<string> es = Control.CommonEvents();
        es.Add("Back");
        return es;
    }

    /// 将返回箭头的 Back 路由到其 UiEvent 字段；其余事件
    /// 落入 `On` 上的通用事件包（其 AddByName 忽略它
    /// 不认识的名称）。
    override void BindEvent(string evt, Action a) {
        if (evt == "Back") { Back.Add(a); return; }
        On.AddByName(evt, a);
    }

}
