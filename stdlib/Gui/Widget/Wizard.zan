using System;
using Gui;

namespace Gui.Widget;

/// Wizard 列表中一个可选择的条目：图标、标签和一行
/// 描述（当前选中时显示）。取代旧的
/// name/icon/description 并行列表约定，改为单一实体。
class WizardItem {
    string name;
    string icon;
    string desc;

    WizardItem(string n, string ic, string d) {
        name = n;
        icon = ic;
        desc = d;
    }
}

/// 分类项目向导的模板条目：一个 WizardItem 加上其所属的
/// 分类列，以及向导右侧预览所需的形态信息。
///
/// 尺寸不再是分类里的独立模板：产出设计窗口的模板把
/// `sizeable` 置为 true，向导据此显示设备尺寸行，宿主用所选
/// 尺寸创建项目——手机 / 平板 / 手表只是同一个模板的目标尺寸。
class WizardTemplate {
    string cat;
    string name;
    string icon;
    string desc;
    /// 该模板产出一个可按设备尺寸创建的设计窗口。
    bool sizeable;
    /// 默认设计尺寸（sizeable 时用于预览与创建）。
    int defW;
    int defH;
    /// 圆形设计区（智能手表表盘）。
    bool round;
    /// 真实截图的绝对路径，为空时按 `sketch` 画线框。
    string preview;
    /// 线框骨架：逗号分隔的记号，见 Wizard.RenderSketch
    /// （titlebar / toolbar / ribbon / tabs / sidebar / statusbar /
    /// form / chart / gauges / alarms / list / console / webview /
    /// server / library）。
    string sketch;

    WizardTemplate(string c, string n, string ic, string d) {
        cat = c;
        name = n;
        icon = ic;
        desc = d;
        sizeable = false;
        defW = 0;
        defH = 0;
        round = false;
        preview = "";
        sketch = "";
    }

    /// 链式配置形态信息，让宿主只描述它从清单里读到的内容。
    WizardTemplate Shape(bool canSize, int w, int h, bool isRound) {
        sizeable = canSize;
        defW = w;
        defH = h;
        round = isRound;
        return this;
    }

    /// 预览来源：真实截图路径（可为空）与线框记号。
    WizardTemplate Look(string previewPath, string sketchSpec) {
        preview = previewPath;
        sketch = sketchSpec;
        return this;
    }
}

/// 多选目标标签：标签及其开/关状态（1 = 已选）。
class WizardTarget {
    string name;
    int selected;

    WizardTarget(string n, int s) {
        name = n;
        selected = s;
    }
}

/// <summary>
/// 渲染浮动 "wizard" 子窗口的完整内容：标题栏
/// （带关闭按钮）、左侧可选择的模板列表、右侧的名称（和
/// 可选位置）输入框、所选模板的实时描述，
/// 以及 Create / Cancel 按钮。
///
/// 与 Modal/Dialog（在主窗口内绘制遮罩）不同，Wizard
/// 旨在填充一个真实的二级顶层窗口，用户可将其拖到
/// 桌面任意位置——调用方拥有该窗口的 App 和事件循环，
/// 每帧只需调用 Wizard.Render(childApp, ...)。
///
/// 返回 0 无操作、1 创建、2 取消/关闭。
/// </summary>
class Wizard : Control {
    /// UI language 用于 wizard's built-in labels (0 = English, 1 = 简体中文).
    /// 宿主 IDE 在渲染前设置此项，使标签跟随应用语言。
    static int lang = 1;

    /// 可选的一行提示，以主题错误色绘制在
    /// Create/Cancel 按钮旁边（如 "目标文件夹不为空"）。宿主
    /// 拒绝 Create 时设置它，对话框关闭时清除。
    static string notice = "";

    /// 三个列表视口各自的滚动位置（条目列表、分类列、模板列）。
    /// 行数超出可见高度时列表自己滚动，宿主不必再包一层滚动容器。
    static SignalInt listScroll;
    static SignalInt catScroll;
    static SignalInt tplScroll;

    static SignalInt Scroller(SignalInt s) {
        if (s == null) { return new SignalInt(0); }
        return s;
    }

    /// 行列表视口的滚动量：处理滚轮、把偏移夹在
    /// [0, contentH - h]，返回本帧应使用的偏移。
    static int ScrollOffset(App app, int x, int y, int w, int h,
                            int contentH, SignalInt off) {
        Scrollbar.HandleWheel(app, x, y, w, h, contentH, off);
        int maxOff = contentH - h;
        if (maxOff < 0) { maxOff = 0; }
        if (off.Get() > maxOff) { off.Set(maxOff); }
        if (off.Get() < 0) { off.Set(0); }
        return off.Get();
    }

    static string TW(string en, string zh) {
        if (Wizard.lang == 1) { return zh; }
        return en;
    }

    // ---- 保留式实例 ----------------------------------------------
    // Wizard 对象拥有向导窗口所需的状态（标题、条目列表、
    // 选择信号、名称/位置输入），宿主持有一个实例
    // 并每帧调用 `wiz.Show(app)`，而不是把每个字段
    // 穿过立即模式静态调用传递。
    string iTitle;
    bool iCategorized;
    List<WizardItem> iItems;
    SignalInt iSel;
    Input iName;
    Input iLoc;
    bool iShowLoc;
    List<string> iCatNames;
    SignalInt iCatSel;
    List<WizardTemplate> iTpls;
    SignalInt iTplSel;
    List<WizardTarget> iTargets;
    List<string> iGroups;
    /// 为生成设计窗口的文件模板提供的可选窗口尺寸预设选择
    /// （参见 SizePresetW/H/Name）。null 隐藏该区域。
    SignalInt iSizeSel;
    /// 可选的宽/高自定义输入，绘制在预设网格下方
    /// （null 隐藏自定义行）。点击预设会回填这些输入，宿主
    /// 从这些输入读取最终尺寸。
    Input iSizeW;
    Input iSizeH;

    Wizard() {
        this.InitControl("wizard", 5);
        this.iTitle = "";
        this.iShowLoc = false;
    }

    override string Kind() { return "Wizard"; }

    override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec title = PropSpec.Text("title", "Title");
        title.str = iTitle;
        title.WithTip("Title shown in the wizard window.");
        ps.Add(title);
        PropSpec loc = PropSpec.Bool("showLocation", "Show location");
        loc.flag = iShowLoc;
        loc.WithTip("Show the destination location field.");
        ps.Add(loc);
        return ps;
    }

    /// 单列表向导：`new Wizard(title, items, sel, name, loc, showLoc)`。
    Wizard(string title, List<WizardItem> items, SignalInt sel,
           Input nameInput, Input locInput, bool showLoc) {
        this.iTitle = title;
        this.iItems = items;
        this.iSel = sel;
        this.iName = nameInput;
        this.iLoc = locInput;
        this.iShowLoc = showLoc;
        this.iCategorized = false;
        this.iSizeSel = null;
    }

    /// 带可选尺寸预设行的单列表向导（`sizeSel` 选择
    /// Phone/Tablet/Desktop/Default；传 null 则不显示尺寸行）。
    Wizard(string title, List<WizardItem> items, SignalInt sel,
           Input nameInput, Input locInput, bool showLoc,
           SignalInt sizeSel) {
        this.iTitle = title;
        this.iItems = items;
        this.iSel = sel;
        this.iName = nameInput;
        this.iLoc = locInput;
        this.iShowLoc = showLoc;
        this.iCategorized = false;
        this.iSizeSel = sizeSel;
    }

    /// 带完整尺寸预设网格和自定义
    /// 宽/高输入的单列表向导（传 null 输入可隐藏自定义行）。
    Wizard(string title, List<WizardItem> items, SignalInt sel,
           Input nameInput, Input locInput, bool showLoc,
           SignalInt sizeSel, Input sizeW, Input sizeH) {
        this.iTitle = title;
        this.iItems = items;
        this.iSel = sel;
        this.iName = nameInput;
        this.iLoc = locInput;
        this.iShowLoc = showLoc;
        this.iCategorized = false;
        this.iSizeSel = sizeSel;
        this.iSizeW = sizeW;
        this.iSizeH = sizeH;
    }

    /// 共享的设计尺寸预设，与自由画布设计器的
    /// 下拉一致：LVGL 显示尺寸 + 手机/平板/桌面 + 手表/手环。
    static List<int> SizePresetW() {
        return new List<int>{ 320, 480, 800, 1024, 390, 768, 1280, 1366, 1920,
                              466, 368, 194 };
    }
    static List<int> SizePresetH() {
        return new List<int>{ 240, 320, 480, 600, 844, 1024, 720, 768, 1080,
                              466, 448, 368 };
    }
    static string SizePresetName(int i) {
        if (i == 0) { return "QVGA"; }
        if (i == 1) { return "HVGA"; }
        if (i == 2) { return "WVGA"; }
        if (i == 3) { return "WSVGA"; }
        if (i == 4) { return Wizard.TW("Phone", "手机"); }
        if (i == 5) { return Wizard.TW("Tablet", "平板"); }
        if (i == 6) { return "HD"; }
        if (i == 7) { return "WXGA"; }
        if (i == 8) { return "FHD"; }
        if (i == 9) { return Wizard.TW("Watch ○", "手表圆"); }
        if (i == 10) { return Wizard.TW("Watch □", "手表方"); }
        return Wizard.TW("Band", "手环");
    }

    /// `sketch` 记号列表里是否含有 `token`。
    static bool SketchHas(string sketch, string token) {
        if (sketch == "") { return false; }
        List<string> parts = sketch.Split(",");
        for (int i = 0; i < parts.Count; i = i + 1) {
            if (parts[i].Trim() == token) { return true; }
        }
        return false;
    }

    /// 右侧预览面板：所选模板在目标尺寸下的样子。有真实截图
    /// （模板目录里的 `preview` 图片）就按比例贴图，否则按模板
    /// 声明的 `sketch` 骨架画线框——两者都在正确宽高比的设备
    /// 外框里，因此"创建出来是什么样"在创建之前就能看到。
    static void RenderPreview(App app, int x, int y, int w, int h,
                              WizardTemplate tpl, int devW, int devH) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        StyleBox panelStyle = Style.Part(app, "wizard", "preview", "",
                                         "", "", Style.SNormal());
        StyleBox labelStyle = Style.Part(app, "wizard", "preview-label", "",
                                         "", "", Style.SNormal());
        StyleBox deviceStyle = Style.Part(app, "wizard", "preview-device", "",
                                          "", "", Style.SNormal());
        StyleBox captionStyle = Style.Part(app, "wizard", "preview-caption", "",
                                           "", "", Style.SNormal());
        c.FillRoundRect(x, y, w, h, t.borderRadiusMedium, panelStyle.BgOr(0));
        c.DrawRoundRect(x, y, w, h, t.borderRadiusMedium,
                        panelStyle.BorderOr(0), 1);
        int pad = t.paddingMedium;
        c.DrawText(x + pad, y + pad, Wizard.TW("Preview", "预览"),
                   labelStyle.FgOr(0),
                   labelStyle.FontOr(Style.FontFallback(app, "small")));
        if (tpl == null) { return; }

        int top = y + pad + app.Scale(22);
        int capH = app.Scale(38);
        int aw = w - 2 * pad;
        int ah = h - (top - y) - capH - pad;
        if (aw < app.Scale(40) || ah < app.Scale(40)) { return; }

        // 设备外框：按目标宽高比内接于可用区域，使手机竖屏和
        // 桌面横屏一眼就能区分。未声明尺寸的模板（控制台 /
        // 服务端 / 类库）用 16:10 的中性比例。
        int rw = devW;
        int rh = devH;
        if (rw <= 0 || rh <= 0) { rw = 16; rh = 10; }
        int dw = aw;
        int dh = dw * rh / rw;
        if (dh > ah) {
            dh = ah;
            dw = dh * rw / rh;
        }
        int dx = x + (w - dw) / 2;
        int dy = top + (ah - dh) / 2;

        if (tpl.round) {
            int r = dw / 2;
            if (dh / 2 < r) { r = dh / 2; }
            int cxx = dx + dw / 2;
            int cyy = dy + dh / 2;
            c.FillCircle(cxx, cyy, r, deviceStyle.BgOr(0));
            c.DrawCircle(cxx, cyy, r, deviceStyle.BorderOr(0), 2);
            c.PushClip(cxx - r, cyy - r, 2 * r, 2 * r);
            Wizard.RenderSketch(app, cxx - r, cyy - r, 2 * r, 2 * r, tpl);
            c.PopClip();
        } else {
            c.FillRoundRect(dx, dy, dw, dh, t.borderRadiusSmall,
                           deviceStyle.BgOr(0));
            c.DrawRoundRect(dx, dy, dw, dh, t.borderRadiusSmall,
                            deviceStyle.BorderOr(0), 1);
            c.PushClip(dx, dy, dw, dh);
            if (tpl.preview != "" && Canvas.ImageWidth(tpl.preview) > 0) {
                c.BlitImage(tpl.preview, dx, dy, dw, dh, 0, 0, 0, 0);
            } else {
                Wizard.RenderSketch(app, dx, dy, dw, dh, tpl);
            }
            c.PopClip();
        }

        // 标题下方一行说明：目标尺寸（或"自由布局"）。
        string cap = Wizard.TW("Free layout", "自由布局");
        if (devW > 0 && devH > 0) {
            cap = Convert.ToString(devW) + " x " + Convert.ToString(devH);
        }
        int capFont = captionStyle.FontOr(Style.FontFallback(app, "small"));
        int capW = Canvas.MeasureText(cap, capFont);
        c.DrawText(x + (w - capW) / 2, y + h - capH + app.Scale(10), cap,
                   captionStyle.FgOr(0), capFont);
    }

    /// 在 (x,y,w,h) 内按 `tpl.sketch` 的记号画出模板骨架的线框：
    /// 每个记号占据它在真实窗口里的位置（标题栏在上、状态栏在
    /// 下、侧栏在左），内容记号填充剩下的区域。
    static void RenderSketch(App app, int x, int y, int w, int h,
                             WizardTemplate tpl) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        string sk = tpl.sketch;
        StyleBox lineStyle = Style.Part(app, "wizard", "sketch-line", "",
                                        "", "", Style.SNormal());
        StyleBox fillStyle = Style.Part(app, "wizard", "sketch-fill", "",
                                        "", "", Style.SNormal());
        StyleBox accentStyle = Style.Part(app, "wizard", "sketch-accent", "",
                                          "", "", Style.SNormal());
        StyleBox errorStyle = Style.Part(app, "wizard", "sketch-error", "",
                                         "", "", Style.SNormal());
        StyleBox surfaceStyle = Style.Part(app, "wizard", "sketch-surface", "",
                                           "", "", Style.SNormal());
        StyleBox panelStyle = Style.Part(app, "wizard", "sketch-panel", "",
                                         "", "", Style.SNormal());
        StyleBox consoleStyle = Style.Part(app, "wizard", "sketch-console", "",
                                           "", "", Style.SNormal());
        int line = lineStyle.FgOr(0);
        int fill = fillStyle.BgOr(0);
        int accent = accentStyle.BgOr(0);
        int error = errorStyle.BgOr(0);
        int surface = surfaceStyle.BgOr(0);
        int panel = panelStyle.BgOr(0);
        int consoleBg = consoleStyle.BgOr(0);
        int consoleFg = consoleStyle.FgOr(0);
        int unit = h / 14;
        if (unit < 3) { unit = 3; }

        int cx = x;
        int cy = y;
        int cw = w;
        int chh = h;

        if (Wizard.SketchHas(sk, "titlebar")) {
            c.FillRect(cx, cy, cw, unit * 2, fill);
            c.FillCircle(cx + unit, cy + unit, unit / 3, accent);
            cy = cy + unit * 2;
            chh = chh - unit * 2;
        }
        if (Wizard.SketchHas(sk, "ribbon")) {
            c.FillRect(cx, cy, cw, unit * 3, fill);
            for (int rb = 0; rb < 4; rb = rb + 1) {
                c.FillRect(cx + unit + rb * unit * 2, cy + unit, unit, unit, line);
            }
            cy = cy + unit * 3;
            chh = chh - unit * 3;
        }
        if (Wizard.SketchHas(sk, "toolbar")) {
            c.FillRect(cx, cy, cw, unit * 2, fill);
            for (int tb = 0; tb < 5; tb = tb + 1) {
                c.FillRect(cx + unit + tb * unit * 2, cy + unit / 2, unit, unit, line);
            }
            cy = cy + unit * 2;
            chh = chh - unit * 2;
        }
        if (Wizard.SketchHas(sk, "tabs")) {
            for (int tt = 0; tt < 3; tt = tt + 1) {
                int col = fill;
                if (tt == 0) { col = accent; }
                c.FillRect(cx + unit + tt * unit * 4, cy, unit * 3, unit + unit / 2, col);
            }
            cy = cy + unit * 2;
            chh = chh - unit * 2;
        }
        if (Wizard.SketchHas(sk, "statusbar")) {
            int sbH = unit + unit / 2;
            c.FillRect(cx, cy + chh - sbH, cw, sbH, fill);
            chh = chh - sbH - unit / 2;
        }
        if (Wizard.SketchHas(sk, "alarms")) {
            c.FillRect(cx, cy, cw, unit * 2, error);
            cy = cy + unit * 2 + unit / 2;
            chh = chh - unit * 2 - unit / 2;
        }
        if (Wizard.SketchHas(sk, "sidebar")) {
            int sw = cw / 4;
            c.FillRect(cx, cy, sw, chh, fill);
            for (int sb = 0; sb < 4; sb = sb + 1) {
                c.FillRect(cx + unit / 2, cy + unit + sb * unit * 2, sw - unit, unit, line);
            }
            cx = cx + sw + unit;
            cw = cw - sw - unit;
        }

        // ---- 内容区 ----
        if (Wizard.SketchHas(sk, "console")) {
            c.FillRect(cx, cy, cw, chh, consoleBg);
            for (int cl = 0; cl < 5; cl = cl + 1) {
                int lw2 = cw / 2 + (cl % 3) * cw / 8;
                c.FillRect(cx + unit, cy + unit + cl * unit * 2, lw2, unit / 2 + 1,
                           consoleFg);
            }
        } else if (Wizard.SketchHas(sk, "webview")) {
            c.FillRect(cx, cy, cw, unit * 2, fill);
            c.FillRect(cx + unit, cy + unit / 2, cw - unit * 2, unit, surface);
            c.FillRect(cx, cy + unit * 3, cw, chh - unit * 3, panel);
        } else if (Wizard.SketchHas(sk, "chart") || Wizard.SketchHas(sk, "gauges")) {
            int half = chh / 2;
            if (Wizard.SketchHas(sk, "chart")) {
                c.DrawRect(cx, cy, cw, half - unit, line, 1);
                List<int> xs = new List<int>();
                List<int> ys = new List<int>();
                for (int pt = 0; pt < 7; pt = pt + 1) {
                    xs.Add(cx + unit + pt * (cw - unit * 2) / 6);
                    int amp = half - unit * 3;
                    if (amp < unit) { amp = unit; }
                    int off = amp * (pt % 3) / 2;
                    ys.Add(cy + half - unit * 2 - off);
                }
                c.DrawPolyline(xs, ys, accent, 2);
            }
            if (Wizard.SketchHas(sk, "gauges")) {
                int gr = half / 3;
                if (gr < unit) { gr = unit; }
                for (int gi2 = 0; gi2 < 3; gi2 = gi2 + 1) {
                    int gcx = cx + gr + unit + gi2 * (gr * 2 + unit * 2);
                    int gcy = cy + chh - gr - unit;
                    c.DrawCircle(gcx, gcy, gr, line, 2);
                    c.DrawLine(gcx, gcy, gcx + gr / 2, gcy - gr / 2, accent, 2);
                }
            }
        } else if (Wizard.SketchHas(sk, "list")) {
            for (int li = 0; li < 6; li = li + 1) {
                int rowY = cy + unit + li * unit * 2;
                if (rowY + unit > cy + chh) { break; }
                c.FillRect(cx, rowY, cw, unit + unit / 3, fill);
            }
        } else if (Wizard.SketchHas(sk, "server")) {
            int bw2 = (cw - unit * 2) / 3;
            for (int sv = 0; sv < 3; sv = sv + 1) {
                int bx2 = cx + sv * (bw2 + unit);
                if (bx2 + bw2 > cx + cw) { break; }
                c.DrawRect(bx2, cy + chh / 3, bw2, unit * 3, line, 1);
                if (sv > 0) {
                    c.DrawLine(bx2 - unit, cy + chh / 3 + unit, bx2, cy + chh / 3 + unit,
                               accent, 2);
                }
            }
        } else if (Wizard.SketchHas(sk, "library")) {
            for (int lb = 0; lb < 3; lb = lb + 1) {
                c.DrawRect(cx + lb * unit, cy + chh / 3 + lb * unit, cw / 2, unit * 2,
                           line, 1);
            }
        } else if (Wizard.SketchHas(sk, "form")) {
            for (int fr = 0; fr < 4; fr = fr + 1) {
                int rowY = cy + unit + fr * unit * 3;
                if (rowY + unit * 2 > cy + chh) { break; }
                c.FillRect(cx, rowY, cw / 3, unit, fill);
                c.DrawRect(cx, rowY + unit + unit / 2, cw - unit, unit + unit / 2, line, 1);
            }
            int okW = cw / 3;
            c.FillRect(cx, cy + chh - unit * 2, okW, unit + unit / 2, accent);
        } else if (Wizard.SketchHas(sk, "cards")) {
            int cwid = (cw - unit) / 2;
            for (int cd = 0; cd < 4; cd = cd + 1) {
                int col2 = cd % 2;
                int row2 = cd / 2;
                int cyy = cy + row2 * (chh / 2);
                if (cyy + chh / 2 - unit > cy + chh) { break; }
                c.DrawRect(cx + col2 * (cwid + unit), cyy, cwid, chh / 2 - unit, line, 1);
            }
        }
    }

    /// 从自定义宽/高输入里解析前导数字（输入是自由文本，
    /// 单位或空格都无所谓），无数字时返回 0。
    static int ParseDim(string s) {
        string digits = "0123456789";
        int n = 0;
        bool any = false;
        for (int i = 0; i < s.Length; i = i + 1) {
            string ch = s.Substring(i, 1);
            int d = 0 - 1;
            for (int k = 0; k < 10; k = k + 1) {
                if (digits.Substring(k, 1) == ch) { d = k; }
            }
            if (d >= 0) {
                n = n * 10 + d;
                any = true;
            } else if (any) {
                break;
            }
        }
        return n;
    }

    /// 分类项目向导（分类 + 模板列 + 目标标签）。
    static Wizard Categorized(string title, List<string> catNames, SignalInt catSel,
                              List<WizardTemplate> tpls, SignalInt tplSel,
                              Input nameInput, Input locInput,
                              List<WizardTarget> targets, List<string> groupNames) {
        Wizard w = new Wizard();
        w.iTitle = title;
        w.iCatNames = catNames;
        w.iCatSel = catSel;
        w.iTpls = tpls;
        w.iTplSel = tplSel;
        w.iName = nameInput;
        w.iLoc = locInput;
        w.iTargets = targets;
        w.iGroups = groupNames;
        w.iCategorized = true;
        return w;
    }

    /// 带设备尺寸选择的分类项目向导：选中的模板声明
    /// `sizeable` 时，描述下方出现尺寸预设行与自定义宽高，
    /// 右侧预览按所选尺寸的比例绘制。
    static Wizard Categorized(string title, List<string> catNames, SignalInt catSel,
                              List<WizardTemplate> tpls, SignalInt tplSel,
                              Input nameInput, Input locInput,
                              List<WizardTarget> targets, List<string> groupNames,
                              SignalInt sizeSel, Input sizeW, Input sizeH) {
        Wizard w = Wizard.Categorized(title, catNames, catSel, tpls, tplSel,
                                      nameInput, locInput, targets, groupNames);
        w.iSizeSel = sizeSel;
        w.iSizeW = sizeW;
        w.iSizeH = sizeH;
        return w;
    }

    /// 本帧将向导绘制到其窗口中，并返回动作码
    /// （0 无、1 创建、2 取消/关闭、3 浏览）。所有状态都保存在
    /// 实例上；宿主对返回码作出响应。
    int Show(App app) {
        if (iCategorized) {
            return Wizard.RenderCategorized(app, iTitle, iCatNames, iCatSel, iTpls,
                iTplSel, iName, iLoc, iTargets, iGroups,
                iSizeSel, iSizeW, iSizeH);
        }
        return Wizard.Render(app, iTitle, iItems, iSel, iName, iLoc, iShowLoc,
                             iSizeSel, iSizeW, iSizeH);
    }

    static int Render(App app, string title, List<WizardItem> items, SignalInt sel,
                      Input nameInput, Input locInput, bool showLoc, SignalInt sizeSel) {
        return Wizard.Render(app, title, items, sel, nameInput, locInput, showLoc,
                             sizeSel, null, null);
    }

    static int Render(App app, string title, List<WizardItem> items, SignalInt sel,
                      Input nameInput, Input locInput, bool showLoc, SignalInt sizeSel,
                      Input sizeW, Input sizeH) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int W = c.Width();
        int H = c.Height();
        StyleBox barStyle = Style.Part(app, "wizard", "bar", "",
                                       "", "", Style.SNormal());
        StyleBox titleStyle = Style.Part(app, "wizard", "title", "",
                                         "", "", Style.SNormal());
        StyleBox dividerStyle = Style.Part(app, "wizard", "divider", "",
                                           "", "", Style.SNormal());
        StyleBox closeStyle = Style.Part(app, "wizard", "close", "",
                                         "", "", Style.SNormal());
        StyleBox closeHoverStyle = Style.Part(app, "wizard", "close", "",
                                              "", "", Style.SHover());
        StyleBox labelStyle = Style.Part(app, "wizard", "label", "",
                                         "", "", Style.SNormal());
        StyleBox descriptionStyle = Style.Part(app, "wizard", "description", "",
                                               "", "", Style.SNormal());
        StyleBox barStyle = Style.Part(app, "wizard", "bar", "",
                                       "", "", Style.SNormal());
        StyleBox titleStyle = Style.Part(app, "wizard", "title", "",
                                         "", "", Style.SNormal());
        StyleBox dividerStyle = Style.Part(app, "wizard", "divider", "",
                                           "", "", Style.SNormal());
        StyleBox closeStyle = Style.Part(app, "wizard", "close", "",
                                         "", "", Style.SNormal());
        StyleBox closeHoverStyle = Style.Part(app, "wizard", "close", "",
                                              "", "", Style.SHover());
        StyleBox labelStyle = Style.Part(app, "wizard", "label", "",
                                         "", "", Style.SNormal());
        StyleBox descriptionStyle = Style.Part(app, "wizard", "description", "",
                                               "", "", Style.SNormal());

        // 主题化背景（渐变 / 玻璃壁纸），使对话框匹配
        // 父窗口的皮肤，而不是纯色填充。
        app.RenderBackground(0, 0, W, H, 6);

        int barH = app.titlebarH;
        if (barH < app.Scale(32)) { barH = app.Scale(32); }
        c.FillRect(0, 0, W, barH, barStyle.BgOr(0));
        int titleFont = titleStyle.FontOr(Style.FontFallback(app, "large"));
        int titleY = Canvas.CenterTextY(0, barH, titleFont);
        c.DrawText(app.Scale(16), titleY, title, titleStyle.FgOr(0),
                   titleFont);
        c.FillRect(0, barH, W, 1, dividerStyle.BgOr(0));

        int result = 0;

        // 关闭按钮（右上角，位于运行时的客户区标题区域内）。
        int closeId = app.focus.AllocId();
        int cbw = app.Scale(44);
        int closeX = W - cbw;
        bool ch = app.focus.IsHovered(closeId);
        if (ch) { c.FillRect(closeX, 0, cbw, barH, closeHoverStyle.BgOr(0)); }
        c.DrawGlyphIn("close", closeX, 0, cbw, barH, t.iconSizeSmall,
                      closeStyle.FgOr(0));
        app.hitTester.RegisterRect(closeId, closeX, 0, cbw, barH, 0);
        if (app.EventKind() == 3 && app.ClickTarget() == closeId) {
            result = 2;
        }

        int pad = t.paddingLarge;
        int contentY = barH + pad;

        int listW = app.Scale(230);
        int listH = H - contentY - app.Scale(74);
        Wizard.RenderList(app, pad, contentY, listW, listH, items, sel);

        int fx = pad + listW + pad;
        int fw = W - pad - fx;
        int fy = contentY;

        int labelFont = labelStyle.FontOr(Style.FontFallback(app, "small"));
        int descriptionFont = descriptionStyle.FontOr(
            Style.FontFallback(app, "small"));
        c.DrawText(fx, fy, Wizard.TW("Name", "名称"), labelStyle.FgOr(0),
                   labelFont);
        nameInput.Render(app, fx, fy + app.Scale(20), fw, t.heightMedium);
        int ny = fy + app.Scale(20) + t.heightMedium + app.Scale(14);

        if (showLoc) {
            c.DrawText(fx, ny, Wizard.TW("Location", "位置"),
                       labelStyle.FgOr(0), labelFont);
            locInput.Render(app, fx, ny + app.Scale(20), fw, t.heightMedium);
            ny = ny + app.Scale(20) + t.heightMedium + app.Scale(14);
        }

        int s = sel.Get();
        if (s >= 0 && s < items.Count) {
            c.DrawText(fx, ny, items[s].desc, descriptionStyle.FgOr(0),
                       descriptionFont);
        }

        // 可选的窗口尺寸预设（针对生成
        // 设计窗口的文件模板）：完整的设备分辨率网格（与
        // 自由画布设计器相同的一套）加上自定义宽/高行。
        if (sizeSel != null) {
            int sy = ny + app.Scale(34);
            c.DrawText(fx, sy, Wizard.TW("Size", "尺寸"), labelStyle.FgOr(0),
                       labelFont);
            List<int> szW = Wizard.SizePresetW();
            List<int> szH = Wizard.SizePresetH();
            int n = szW.Count;
            int perRow = 4;
            int gap2 = app.Scale(6);
            int btnW = (fw - (perRow - 1) * gap2) / perRow;
            int rowH2 = t.heightSmall + app.Scale(6);
            int by2 = sy + app.Scale(20);
            int curv = sizeSel.Get();
            for (int k = 0; k < n; k = k + 1) {
                int col = k % perRow;
                int rowi = k / perRow;
                string cls = "small";
                if (k == curv) { cls = "primary small"; }
                int bid = new Button { Text = Wizard.SizePresetName(k), Class = cls }
                    .Render(app, fx + col * (btnW + gap2), by2 + rowi * rowH2, btnW);
                if (Ui.Clicked(app, bid)) {
                    sizeSel.Set(k);
                    if (sizeW != null) { sizeW.SetText(Convert.ToString(szW[k])); }
                    if (sizeH != null) { sizeH.SetText(Convert.ToString(szH[k])); }
                    app.RequestRedraw();
                }
            }
            int cy2 = by2 + ((n + perRow - 1) / perRow) * rowH2 + app.Scale(4);
            if (sizeW != null && sizeH != null) {
                string custom = Wizard.TW("Custom", "自定义");
                c.DrawText(fx, cy2 + app.Scale(6), custom, labelStyle.FgOr(0),
                           labelFont);
                int lw = Canvas.MeasureText(custom, labelFont) + app.Scale(10);
                int inW2 = app.Scale(72);
                sizeW.Render(app, fx + lw, cy2, inW2, t.heightSmall);
                c.DrawText(fx + lw + inW2 + app.Scale(5), cy2 + app.Scale(6), "x",
                    labelStyle.FgOr(0), labelFont);
                sizeH.Render(app, fx + lw + inW2 + app.Scale(16), cy2, inW2, t.heightSmall);
            }
        }

        int bw = app.Scale(104);
        int by = H - t.heightMedium - pad;
        int okX = W - pad - bw;
        int cancelX = okX - t.gapMedium - bw;

        int cancelId = new Button { Text = Wizard.TW("Cancel", "取消") }.Render(app, cancelX, by, bw);
        if (Ui.Clicked(app, cancelId)) { result = 2; }
        int okId = new Button { Text = Wizard.TW("Create", "创建"), Class = "primary" }.Render(app, okX, by, bw);
        if (Ui.Clicked(app, okId)) { result = 1; }

        return result;
    }

    /// 可选择的模板行垂直列表（图标 + 标签），绑定到
    /// SignalInt 选择。任何选择器风格的窗口都可复用。
    static void RenderList(App app, int x, int y, int w, int h, List<WizardItem> items,
                           SignalInt sel) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        StyleBox panelStyle = Style.Part(app, "wizard", "list", "",
                                         "", "", Style.SNormal());
        StyleBox rowIconStyle = Style.Part(app, "wizard", "list-row-icon", "",
                                           "", "", Style.SNormal());
        StyleBox rowLabelStyle = Style.Part(app, "wizard", "list-row-label", "",
                                            "", "", Style.SNormal());
        StyleBox rowHoverStyle = Style.Part(app, "wizard", "list-row", "",
                                            "", "", Style.SHover());
        StyleBox rowActiveStyle = Style.Part(app, "wizard", "list-row", "",
                                             "", "", Style.SActive());
        StyleBox rowIconActiveStyle = Style.Part(app, "wizard", "list-row-icon",
                                                 "", "", "", Style.SActive());
        StyleBox rowLabelActiveStyle = Style.Part(app, "wizard", "list-row-label",
                                                  "", "", "", Style.SActive());
        StyleBox accentStyle = Style.Part(app, "wizard", "list-accent", "",
                                          "", "", Style.SNormal());
        c.FillRoundRect(x, y, w, h, t.borderRadiusMedium, panelStyle.BgOr(0));
        if (items == null || h <= 0) { return; }

        int rowH = app.Scale(42);
        int n = items.Count;
        int contentH = n * rowH;
        Wizard.listScroll = Wizard.Scroller(Wizard.listScroll);
        int off = Wizard.ScrollOffset(app, x, y, w, h, contentH, Wizard.listScroll);
        bool overflow = contentH > h;
        int barW = app.Scale(10);
        int rowW = w;
        if (overflow) { rowW = w - barW; }

        int firstId = app.focus.AllocId();
        for (int i = 1; i < n; i = i + 1) { app.focus.AllocId(); }

        int selv = sel.Get();
        int glyph = rowIconStyle.FontOr(Style.FontFallback(app, "large"));
        c.PushClip(x, y, w, h);
        for (int k = 0; k < n; k = k + 1) {
            WizardItem item = items[k];
            int id = firstId + k;
            int rowY = y + k * rowH - off;
            if (rowY + rowH <= y || rowY >= y + h) { continue; }
            bool hovered = app.focus.IsHovered(id);
            bool active = k == selv;
            if (active) {
                c.FillRect(x, rowY, rowW, rowH, rowActiveStyle.BgOr(0));
                c.FillRect(x, rowY, app.Scale(3), rowH, accentStyle.BgOr(0));
            } else if (hovered) {
                c.FillRect(x, rowY, rowW, rowH, rowHoverStyle.BgOr(0));
            }
            int iconColor = rowIconStyle.FgOr(0);
            int textColor = rowLabelStyle.FgOr(0);
            int rowGlyph = glyph;
            int rowFont = rowLabelStyle.FontOr(
                Style.FontFallback(app, "medium"));
            if (active) {
                iconColor = rowIconActiveStyle.FgOr(0);
                textColor = rowLabelActiveStyle.FgOr(0);
                rowGlyph = rowIconActiveStyle.FontOr(
                    Style.FontFallback(app, "large"));
                rowFont = rowLabelActiveStyle.FontOr(
                    Style.FontFallback(app, "medium"));
            }
            c.DrawGlyphIn(item.icon, x + t.paddingMedium, rowY,
                          rowGlyph, rowH, rowGlyph, iconColor);
            int textX = x + t.paddingMedium + rowGlyph + t.gapMedium;
            int textY = Canvas.CenterTextY(rowY, rowH, rowFont);
            c.DrawText(textX, textY, item.name, textColor, rowFont);
            app.hitTester.RegisterRect(id, x, rowY, rowW, rowH, 0);
        }
        c.PopClip();
        if (overflow) {
            Scrollbar.RenderVerticalScrollIn(app, x + w - barW, y, h, h,
                contentH, Wizard.listScroll, x, y, w, h);
        }

        if (app.EventKind() == 3) {
            int hitv = app.ClickTarget();
            int idx = hitv - firstId;
            if (idx >= 0 && idx < n) {
                sel.Set(idx);
                app.RequestRedraw();
            }
        }
    }

    /// 两级项目选择器：左侧分类列表，所选分类中的模板
    /// 居中，名称/位置输入框和实时
    /// 描述在右侧。模板以单一实体列表提供
    /// （每个携带其分类 / 名称 / 图标 / 描述）；tplSel 保存
    /// 所选模板的全局索引。返回 0 无、1 创建、2 取消。
    static int RenderCategorized(App app, string title, List<string> catNames, SignalInt catSel,
                                 List<WizardTemplate> tpls, SignalInt tplSel, Input nameInput, Input locInput,
                                 List<WizardTarget> targets, List<string> groupNames) {
        return Wizard.RenderCategorized(app, title, catNames, catSel, tpls, tplSel,
                                        nameInput, locInput, targets, groupNames,
                                        null, null, null);
    }

    static int RenderCategorized(App app, string title, List<string> catNames, SignalInt catSel,
                                 List<WizardTemplate> tpls, SignalInt tplSel, Input nameInput, Input locInput,
                                 List<WizardTarget> targets, List<string> groupNames,
                                 SignalInt sizeSel, Input sizeW, Input sizeH) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int W = c.Width();
        int H = c.Height();
        StyleBox barStyle = Style.Part(app, "wizard", "bar", "",
                                       "", "", Style.SNormal());
        StyleBox titleStyle = Style.Part(app, "wizard", "title", "",
                                         "", "", Style.SNormal());
        StyleBox dividerStyle = Style.Part(app, "wizard", "divider", "",
                                           "", "", Style.SNormal());
        StyleBox closeStyle = Style.Part(app, "wizard", "close", "",
                                         "", "", Style.SNormal());
        StyleBox closeHoverStyle = Style.Part(app, "wizard", "close", "",
                                              "", "", Style.SHover());
        StyleBox labelStyle = Style.Part(app, "wizard", "label", "",
                                         "", "", Style.SNormal());
        StyleBox descriptionStyle = Style.Part(app, "wizard", "description", "",
                                               "", "", Style.SNormal());
        StyleBox categoryPanelStyle = Style.Part(app, "wizard", "category-panel",
                                                 "", "", "", Style.SNormal());
        StyleBox templatePanelStyle = Style.Part(app, "wizard", "template-panel",
                                                 "", "", "", Style.SNormal());
        StyleBox categoryRowStyle = Style.Part(app, "wizard", "category-row",
                                               "", "", "", Style.SNormal());
        StyleBox categoryHoverStyle = Style.Part(app, "wizard", "category-row",
                                                 "", "", "", Style.SHover());
        StyleBox categoryActiveStyle = Style.Part(app, "wizard", "category-row",
                                                  "", "", "", Style.SActive());
        StyleBox templateIconStyle = Style.Part(app, "wizard", "template-row-icon",
                                                "", "", "", Style.SNormal());
        StyleBox templateLabelStyle = Style.Part(app, "wizard", "template-row-label",
                                                 "", "", "", Style.SNormal());
        StyleBox templateHoverStyle = Style.Part(app, "wizard", "template-row",
                                                 "", "", "", Style.SHover());
        StyleBox templateActiveStyle = Style.Part(app, "wizard", "template-row",
                                                  "", "", "", Style.SActive());
        StyleBox templateIconActiveStyle = Style.Part(app, "wizard", "template-row-icon",
                                                      "", "", "", Style.SActive());
        StyleBox templateLabelActiveStyle = Style.Part(app, "wizard", "template-row-label",
                                                       "", "", "", Style.SActive());
        StyleBox accentStyle = Style.Part(app, "wizard", "accent", "",
                                          "", "", Style.SNormal());
        StyleBox targetStyle = Style.Part(app, "wizard", "target", "",
                                          "", "", Style.SNormal());
        StyleBox targetHoverStyle = Style.Part(app, "wizard", "target", "",
                                               "", "", Style.SHover());
        StyleBox targetActiveStyle = Style.Part(app, "wizard", "target", "",
                                                "", "", Style.SActive());
        StyleBox noticeStyle = Style.Part(app, "wizard", "notice", "",
                                          "", "", Style.SNormal());

        // 主题化背景（渐变 / 玻璃壁纸），使对话框匹配
        // 父窗口的皮肤，而不是纯色填充。
        app.RenderBackground(0, 0, W, H, 6);

        int barH = app.titlebarH;
        if (barH < app.Scale(32)) { barH = app.Scale(32); }
        c.FillRect(0, 0, W, barH, barStyle.BgOr(0));
        int titleFont = titleStyle.FontOr(Style.FontFallback(app, "large"));
        int titleY = Canvas.CenterTextY(0, barH, titleFont);
        c.DrawText(app.Scale(16), titleY, title, titleStyle.FgOr(0),
                   titleFont);
        c.FillRect(0, barH, W, 1, dividerStyle.BgOr(0));

        int result = 0;

        int closeId = app.focus.AllocId();
        int cbw = app.Scale(44);
        int closeX = W - cbw;
        if (app.focus.IsHovered(closeId)) {
            c.FillRect(closeX, 0, cbw, barH, closeHoverStyle.BgOr(0));
        }
        c.DrawGlyphIn("close", closeX, 0, cbw, barH, t.iconSizeSmall,
                      closeStyle.FgOr(0));
        app.hitTester.RegisterRect(closeId, closeX, 0, cbw, barH, 0);
        if (app.EventKind() == 3 && app.ClickTarget() == closeId) {
            result = 2;
        }

        int pad = t.paddingLarge;
        int contentY = barH + pad;
        int listH = H - contentY - app.Scale(74);
        int rowH = app.Scale(40);
        int glyph = templateIconStyle.FontOr(
            Style.FontFallback(app, "large"));

        // ---- 分类列 ----
        int catX = pad;
        int catW = app.Scale(150);
        c.FillRoundRect(catX, contentY, catW, listH, t.borderRadiusMedium,
                        categoryPanelStyle.BgOr(0));
        int nCat = catNames.Count;
        int catContentH = nCat * rowH;
        int barW = app.Scale(10);
        Wizard.catScroll = Wizard.Scroller(Wizard.catScroll);
        int catOff = Wizard.ScrollOffset(app, catX, contentY, catW, listH,
                                        catContentH, Wizard.catScroll);
        bool catOverflow = catContentH > listH;
        int catRowW = catW;
        if (catOverflow) { catRowW = catW - barW; }
        int catFirstId = app.focus.AllocId();
        for (int ci = 1; ci < nCat; ci = ci + 1) { app.focus.AllocId(); }
        int catSelV = catSel.Get();
        c.PushClip(catX, contentY, catW, listH);
        for (int k = 0; k < nCat; k = k + 1) {
            int id = catFirstId + k;
            int rowY = contentY + k * rowH - catOff;
            if (rowY + rowH <= contentY || rowY >= contentY + listH) { continue; }
            bool active = k == catSelV;
            if (active) {
                c.FillRect(catX, rowY, catRowW, rowH, categoryActiveStyle.BgOr(0));
                c.FillRect(catX, rowY, app.Scale(3), rowH, accentStyle.BgOr(0));
            } else if (app.focus.IsHovered(id)) {
                c.FillRect(catX, rowY, catRowW, rowH, categoryHoverStyle.BgOr(0));
            }
            int tc = categoryRowStyle.FgOr(0);
            int catFont = categoryRowStyle.FontOr(
                Style.FontFallback(app, "medium"));
            if (active) {
                tc = categoryActiveStyle.FgOr(0);
                catFont = categoryActiveStyle.FontOr(
                    Style.FontFallback(app, "medium"));
            }
            int ty = Canvas.CenterTextY(rowY, rowH, catFont);
            c.DrawText(catX + t.paddingMedium, ty, catNames[k], tc, catFont);
            app.hitTester.RegisterRect(id, catX, rowY, catRowW, rowH, 0);
        }
        c.PopClip();
        if (catOverflow) {
            Scrollbar.RenderVerticalScrollIn(app, catX + catW - barW,
                contentY, listH, listH, catContentH, Wizard.catScroll,
                catX, contentY, catW, listH);
        }

        string catLabel = "";
        if (catSelV >= 0 && catSelV < nCat) { catLabel = catNames[catSelV]; }

        // ---- 模板列（按分类过滤） ----
        List<int> vis = new List<int>();
        for (int ti = 0; ti < tpls.Count; ti = ti + 1) {
            if (tpls[ti].cat == catLabel) { vis.Add(ti); }
        }
        // 让 tplSel 保持在可见集合内。
        int cur = tplSel.Get();
        bool curVisible = false;
        foreach (int gi in vis) {
            if (gi == cur) { curVisible = true; }
        }
        if (!curVisible) {
            if (vis.Count > 0) { tplSel.Set(vis[0]); } else { tplSel.Set(-1); }
            app.RequestRedraw();
        }
        int tplSelV = tplSel.Get();

        int tplX = catX + catW + pad;
        int tplW = app.Scale(240);
        c.FillRoundRect(tplX, contentY, tplW, listH, t.borderRadiusMedium,
                        templatePanelStyle.BgOr(0));
        int tplContentH = vis.Count * rowH;
        Wizard.tplScroll = Wizard.Scroller(Wizard.tplScroll);
        int tplOff = Wizard.ScrollOffset(app, tplX, contentY, tplW, listH,
                                        tplContentH, Wizard.tplScroll);
        bool tplOverflow = tplContentH > listH;
        int tplRowW = tplW;
        if (tplOverflow) { tplRowW = tplW - barW; }
        int tplFirstId = app.focus.AllocId();
        for (int vi = 1; vi < vis.Count; vi = vi + 1) { app.focus.AllocId(); }
        c.PushClip(tplX, contentY, tplW, listH);
        for (int r2 = 0; r2 < vis.Count; r2 = r2 + 1) {
            int gi = vis[r2];
            WizardTemplate tpl = tpls[gi];
            int id = tplFirstId + r2;
            int rowY = contentY + r2 * rowH - tplOff;
            if (rowY + rowH <= contentY || rowY >= contentY + listH) { continue; }
            bool active = gi == tplSelV;
            if (active) {
                c.FillRect(tplX, rowY, tplRowW, rowH, templateActiveStyle.BgOr(0));
                c.FillRect(tplX, rowY, app.Scale(3), rowH, accentStyle.BgOr(0));
            } else if (app.focus.IsHovered(id)) {
                c.FillRect(tplX, rowY, tplRowW, rowH, templateHoverStyle.BgOr(0));
            }
            int iconColor = templateIconStyle.FgOr(0);
            int textColor = templateLabelStyle.FgOr(0);
            int rowFont = templateLabelStyle.FontOr(
                Style.FontFallback(app, "medium"));
            int rowGlyph = glyph;
            if (active) {
                iconColor = templateIconActiveStyle.FgOr(0);
                textColor = templateLabelActiveStyle.FgOr(0);
                rowGlyph = templateIconActiveStyle.FontOr(
                    Style.FontFallback(app, "large"));
                rowFont = templateLabelActiveStyle.FontOr(
                    Style.FontFallback(app, "medium"));
            }
            c.DrawGlyphIn(tpl.icon, tplX + t.paddingMedium, rowY,
                          rowGlyph, rowH, rowGlyph, iconColor);
            int textX = tplX + t.paddingMedium + rowGlyph + t.gapMedium;
            int textY = Canvas.CenterTextY(rowY, rowH, rowFont);
            c.DrawText(textX, textY, tpl.name, textColor, rowFont);
            app.hitTester.RegisterRect(id, tplX, rowY, tplRowW, rowH, 0);
        }
        c.PopClip();
        if (tplOverflow) {
            Scrollbar.RenderVerticalScrollIn(app, tplX + tplW - barW,
                contentY, listH, listH, tplContentH, Wizard.tplScroll,
                tplX, contentY, tplW, listH);
        }

        WizardTemplate selTpl = null;
        if (tplSelV >= 0 && tplSelV < tpls.Count) { selTpl = tpls[tplSelV]; }

        // ---- 预览列（最右）----
        // 属于表单列之前先算，因为它从表单列里切走宽度；
        // 窗口窄到放不下两列时预览自行让位。
        int prevW = app.Scale(300);
        int availRight = W - pad - (tplX + tplW + pad);
        if (availRight < app.Scale(640)) { prevW = 0; }

        // ---- 右列：名称 / 位置 / 描述 ----
        int fx = tplX + tplW + pad;
        int fw = W - pad - fx;
        if (prevW > 0) { fw = fw - prevW - pad; }
        int fy = contentY;
        int labelFont = labelStyle.FontOr(Style.FontFallback(app, "small"));
        int descriptionFont = descriptionStyle.FontOr(
            Style.FontFallback(app, "small"));
        c.DrawText(fx, fy, Wizard.TW("Name", "名称"), labelStyle.FgOr(0),
                   labelFont);
        nameInput.Render(app, fx, fy + app.Scale(20), fw, t.heightMedium);
        int ny = fy + app.Scale(20) + t.heightMedium + app.Scale(14);
        c.DrawText(fx, ny, Wizard.TW("Location", "位置"), labelStyle.FgOr(0),
                   labelFont);
        int browseW = app.Scale(96);
        int browseGap = app.Scale(8);
        int locW = fw - browseW - browseGap;
        if (locW < app.Scale(140)) { locW = fw; browseW = 0; }
        locInput.Render(app, fx, ny + app.Scale(20), locW, t.heightMedium);
        if (browseW > 0) {
            int browseId = new Button { Text = Wizard.TW("Browse...", "浏览...") }.Render(app, fx + locW + browseGap, ny + app.Scale(20), browseW);
            if (Ui.Clicked(app, browseId)) { result = 3; }
        }
        ny = ny + app.Scale(20) + t.heightMedium + app.Scale(16);
        if (selTpl != null) {
            c.DrawText(fx, ny, selTpl.desc, descriptionStyle.FgOr(0),
                       descriptionFont);
        }

        // ---- 设备尺寸（仅针对产出设计窗口的模板）----
        // 尺寸是同一个模板的一个参数，而不是分类里十几个长得
        // 一样的条目；预览列同步按所选尺寸的比例绘制。
        int devW = 0;
        int devH = 0;
        if (selTpl != null) {
            devW = selTpl.defW;
            devH = selTpl.defH;
        }
        bool wantSize = selTpl != null && selTpl.sizeable && sizeSel != null;
        if (wantSize) {
            int sy = ny + app.Scale(30);
            c.DrawText(fx, sy, Wizard.TW("Device size", "设备尺寸"),
                       labelStyle.FgOr(0), labelFont);
            List<int> szW = Wizard.SizePresetW();
            List<int> szH = Wizard.SizePresetH();
            int nSz = szW.Count;
            int perRow = 4;
            int gap2 = app.Scale(6);
            int btnW = (fw - (perRow - 1) * gap2) / perRow;
            int rowH2 = t.heightSmall + app.Scale(6);
            int by2 = sy + app.Scale(20);
            int curv = sizeSel.Get();
            for (int k = 0; k < nSz; k = k + 1) {
                int col = k % perRow;
                int rowi = k / perRow;
                string cls = "small";
                if (k == curv) { cls = "primary small"; }
                int bid = new Button { Text = Wizard.SizePresetName(k), Class = cls }
                    .Render(app, fx + col * (btnW + gap2), by2 + rowi * rowH2, btnW);
                if (Ui.Clicked(app, bid)) {
                    sizeSel.Set(k);
                    if (sizeW != null) { sizeW.SetText(Convert.ToString(szW[k])); }
                    if (sizeH != null) { sizeH.SetText(Convert.ToString(szH[k])); }
                    app.RequestRedraw();
                }
            }
            int cy2 = by2 + ((nSz + perRow - 1) / perRow) * rowH2 + app.Scale(4);
            if (sizeW != null && sizeH != null) {
                string custom = Wizard.TW("Custom", "自定义");
                c.DrawText(fx, cy2 + app.Scale(6), custom, labelStyle.FgOr(0),
                           labelFont);
                int lw = Canvas.MeasureText(custom, labelFont) + app.Scale(10);
                int inW2 = app.Scale(72);
                sizeW.Render(app, fx + lw, cy2, inW2, t.heightSmall);
                c.DrawText(fx + lw + inW2 + app.Scale(5), cy2 + app.Scale(6), "x",
                           labelStyle.FgOr(0), labelFont);
                sizeH.Render(app, fx + lw + inW2 + app.Scale(16), cy2, inW2, t.heightSmall);
                int cw = Wizard.ParseDim(sizeW.GetText());
                int chh = Wizard.ParseDim(sizeH.GetText());
                if (cw > 0 && chh > 0) { devW = cw; devH = chh; }
            } else if (curv >= 0 && curv < nSz) {
                devW = szW[curv];
                devH = szH[curv];
            }
            ny = cy2 + t.heightSmall;
        }

        if (prevW > 0) {
            Wizard.RenderPreview(app, W - pad - prevW, contentY, prevW, listH,
                                 selTpl, devW, devH);
        }

        // ---- 目标平台：每个 OS 一列（组），架构
        //      垂直堆叠在下方，每个都是多选开关 ----
        // 位于描述下方较远的位置，使其读起来像一个独立区域，
        // 而不是挤占名称/位置输入框。
        int oy = ny + app.Scale(64);
        c.DrawText(fx, oy, Wizard.TW("Platforms", "目标平台"),
                   labelStyle.FgOr(0), labelFont);
        int nTgt = targets.Count;
        int numCols = groupNames.Count;
        int perCol = nTgt / numCols;
        int obh = t.heightMedium;
        int obw = app.Scale(120);
        int colGap = app.Scale(14);
        int chipGap = app.Scale(8);
        int headerY = oy + app.Scale(22);
        int chipsY = headerY + app.Scale(20);
        for (int gh = 0; gh < numCols; gh = gh + 1) {
            int cx = fx + gh * (obw + colGap);
            c.DrawText(cx, headerY, groupNames[gh], descriptionStyle.FgOr(0),
                       descriptionFont);
        }
        int tgtFirstId = app.focus.AllocId();
        for (int oi2 = 1; oi2 < nTgt; oi2 = oi2 + 1) { app.focus.AllocId(); }
        for (int oi = 0; oi < nTgt; oi = oi + 1) {
            WizardTarget tgt = targets[oi];
            int oid = tgtFirstId + oi;
            int coli = oi / perCol;
            int rowi = oi - coli * perCol;
            int ox = fx + coli * (obw + colGap);
            int oyy = chipsY + rowi * (obh + chipGap);
            bool osel = tgt.selected == 1;
            int obg = targetStyle.BgOr(0);
            int otc = targetStyle.FgOr(0);
            if (osel) {
                obg = targetActiveStyle.BgOr(0);
                otc = targetActiveStyle.FgOr(0);
            } else if (app.focus.IsHovered(oid)) {
                obg = targetHoverStyle.BgOr(0);
            }
            c.FillRoundRect(ox, oyy, obw, obh, t.borderRadiusMedium, obg);
            int targetFont = targetStyle.FontOr(
                Style.FontFallback(app, "medium"));
            if (osel) {
                targetFont = targetActiveStyle.FontOr(
                    Style.FontFallback(app, "medium"));
            }
            int otw = Canvas.MeasureText(tgt.name, targetFont);
            int otx = ox + (obw - otw) / 2;
            int oty = Canvas.CenterTextY(oyy, obh, targetFont);
            c.DrawText(otx, oty, tgt.name, otc, targetFont);
            app.hitTester.RegisterRect(oid, ox, oyy, obw, obh, 0);
        }

        // ---- 点击 ----
        if (app.EventKind() == 3) {
            int hitv = app.ClickTarget();
            int catIdx = hitv - catFirstId;
            int tplIdx = hitv - tplFirstId;
            int tgtIdx = hitv - tgtFirstId;
            if (catIdx >= 0 && catIdx < nCat) {
                catSel.Set(catIdx);
                app.RequestRedraw();
            } else if (tplIdx >= 0 && tplIdx < vis.Count) {
                tplSel.Set(vis[tplIdx]);
                app.RequestRedraw();
            } else if (tgtIdx >= 0 && tgtIdx < nTgt) {
                targets[tgtIdx].selected = 1 - targets[tgtIdx].selected;
                app.RequestRedraw();
            }
        }

        int bw = app.Scale(104);
        int by = H - t.heightMedium - pad;
        int okX = W - pad - bw;
        int cancelX = okX - t.gapMedium - bw;
        if (Wizard.notice != "") {
            c.DrawText(pad, by + app.Scale(6), Wizard.notice,
                       noticeStyle.FgOr(0),
                       noticeStyle.FontOr(Style.FontFallback(app, "small")));
        }
        int cancelId = new Button { Text = Wizard.TW("Cancel", "取消") }.Render(app, cancelX, by, bw);
        if (Ui.Clicked(app, cancelId)) { result = 2; }
        int okId = new Button { Text = Wizard.TW("Create", "创建"), Class = "primary" }.Render(app, okX, by, bw);
        if (Ui.Clicked(app, okId)) { result = 1; }

        return result;
    }
}
