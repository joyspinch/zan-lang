using System;
using Gui;

namespace Gui.Widget;

/// 标题和正文。与 Label 形状相同——简单赋值，
/// 字号和颜色都是皮肤无需一行代码即可重设的类：
///
///     Typography h = new Typography { Text = "Components", Class = "h2" };
///     Typography p = new Typography { Text = vm.summary, Class = "paragraph" };
///
/// 类：`h1` … `h6` 是标题级别，`paragraph` 是正文，
/// `secondary` / `hint` / `inverse` 以及语义角色（`primary` … `error`）
/// 决定颜色。文本由 Label 绘制，因此 `label` 规则同样作用于
/// 这些控件。
class Typography : Control {
    /// 文本内容（可绑定）。
    Binding<string> Text;

    void InitTypography(string txt) {
        this.InitControl(txt, 1);
        Text = txt;
    }

    /// 空文本（设计器用）。
    Typography() { InitTypography(""); }
    /// 给定初值文本。
    Typography(string txt) { InitTypography(txt); }

    /// 当前文本（通过绑定解析）。
    string Str() {
        if (Text == null) { return ""; }
        return Text.Get();
    }

    /// 标题级别（1..6）对应的类。
    static string HeadingClass(int level) {
        switch (level) {
            case 2: return "h2";
            case 3: return "h3";
            case 4: return "h4";
            case 5: return "h5";
            case 6: return "h6";
            default: return "h1";
        }
    }

    /// `Typography.H("Title", 2)` —— 该级别的标题。
    static Typography H(string txt, int level) {
        Typography t = new Typography(txt);
        t.Class = Typography.HeadingClass(level);
        return t;
    }

    /// `Typography.P("Body copy")` —— 一个段落。
    static Typography P(string txt) {
        Typography t = new Typography(txt);
        t.Class = "paragraph";
        return t;
    }

    /// 按 label 设置样式，因此 `label.h2` 和 `label.paragraph` 是选择器，
    /// 皮肤的文本规则同时作用于标题和正文。
    override string StyleType() { return "label"; }

    StyleBox ResolvedStyle(App app) {
        return this.ResolveStyleCached(app, "label", Class, Style.SNormal());
    }

    override void OnMeasure(App app) {
        int fs = this.ResolvedStyle(app).FontOr(
            Style.FontFallback(app, "medium"));
        prefH = Canvas.FontHeight(fs) + app.theme.gapSmall;
        prefW = Canvas.MeasureText(this.Str(), fs);
    }

    override void OnPaint(App app) {
        StyleBox s = Style.Of(app, "label", Class, Style.SNormal());
        app.canvas.DrawStyledText(
            s,
            bx, by, this.Str(),
            s.FgOr(0), Style.FontFallback(app, "medium"));
    }

    /// 立即模式标题；返回其占用的行高。
    static int Heading(App app, int x, int y, string text, int level) {
        string cls = Typography.HeadingClass(level);
        StyleBox s = Style.Of(app, "label", cls, Style.SNormal());
        app.canvas.DrawStyledText(s, x, y, text, s.FgOr(0),
                                  Style.FontFallback(app, "medium"));
        return Canvas.FontHeight(s.FontOr(Style.FontFallback(app, "huge")));
    }

    /// 立即模式段落；返回其占用的行高。
    static int Paragraph(App app, int x, int y, string text) {
        StyleBox s = Style.Of(app, "label", "paragraph", Style.SNormal());
        app.canvas.DrawStyledText(s, x, y, text, s.FgOr(0),
                                  Style.FontFallback(app, "medium"));
        return Canvas.FontHeight(s.FontOr(Style.FontFallback(app, "medium")));
    }

    // ---- 设计器 / 序列化模型 -------------------------------------

    override string Kind() { return "Typography"; }

    override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec text = PropSpec.Text("text", "Text");
        text.str = Text;
        text.AsName();
        ps.Add(text);
        ps.Add(PropSpec.Text("class", "Classes"));
        return ps;
    }
}