using System;
using Gui;

namespace Gui.Widget;

/// Headings and body copy. Same shape as Label -- plain assignment, and the
/// size and colour are classes a skin restyles without a line of code here:
///
///     Typography h = new Typography { Text = "Components", Class = "h2" };
///     Typography p = new Typography { Text = vm.summary, Class = "paragraph" };
///
/// Classes: `h1` … `h6` are the heading steps, `paragraph` is body copy,
/// `secondary` / `hint` / `inverse` and the semantic roles (`primary` … `error`)
/// pick the colour. Text is painted by Label, so a `label` rule reaches these
/// too.
class Typography : Control {
    Binding<string> Text;

    void InitTypography(string txt) {
        this.InitControl(txt, 1);
        Text = txt;
    }

    Typography() { InitTypography(""); }
    Typography(string txt) { InitTypography(txt); }

    /// Current text (resolved through the binding).
    string Str() {
        if (Text == null) { return ""; }
        return Text.Get();
    }

    /// The class a heading level (1..6) stands for.
    static string HeadingClass(int level) {
        switch (level) {
            case 2: return "h2";
            case 3: return "h3";
            case 4: return "h4";
            case 5: return "h5";
            case 6: return "h6";
            default: return "h1";
        }
    }

    /// `Typography.H("Title", 2)` -- a heading of that level.
    static Typography H(string txt, int level) {
        Typography t = new Typography(txt);
        t.Class = Typography.HeadingClass(level);
        return t;
    }

    /// `Typography.P("Body copy")` -- a paragraph.
    static Typography P(string txt) {
        Typography t = new Typography(txt);
        t.Class = "paragraph";
        return t;
    }

    /// Styled as a label, so `label.h2` and `label.paragraph` are the selectors
    /// and a skin's text rules reach headings and body copy alike.
    override string StyleType() { return "label"; }

    StyleBox ResolvedStyle(App app) {
        return this.ResolveStyleAs(app, "label", Class, Style.SNormal());
    }

    override void OnMeasure(App app) {
        int fs = this.ResolvedStyle(app).FontOr(app.theme.fontSizeMedium);
        prefH = Canvas.FontHeight(fs) + app.theme.gapSmall;
        prefW = Canvas.MeasureText(this.Str(), fs);
    }

    override void OnPaint(App app) {
        app.canvas.DrawStyledText(
            Style.Of(app, "label", Class, Style.SNormal()),
            bx, by, this.Str(),
            app.theme.textPrimary, app.theme.fontSizeMedium);
    }

    /// Immediate-mode heading; returns the line height it occupied.
    static int Heading(App app, int x, int y, string text, int level) {
        string cls = Typography.HeadingClass(level);
        app.canvas.DrawStyledText(
            Style.Of(app, "label", cls, Style.SNormal()),
            x, y, text,
            app.theme.textPrimary, app.theme.fontSizeMedium);
        return Canvas.FontHeight(Style.Of(app, "label", cls, Style.SNormal())
            .FontOr(app.theme.fontSizeHuge));
    }

    /// Immediate-mode paragraph; returns the line height it occupied.
    static int Paragraph(App app, int x, int y, string text) {
        app.canvas.DrawStyledText(
            Style.Of(app, "label", "paragraph", Style.SNormal()),
            x, y, text,
            app.theme.textPrimary, app.theme.fontSizeMedium);
        return Canvas.FontHeight(Style.Of(app, "label", "paragraph",
                                          Style.SNormal())
            .FontOr(app.theme.fontSizeMedium));
    }

    // ---- designer / serialization model -------------------------------------

    override string Kind() { return "Typography"; }

    override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec text = PropSpec.Text("text", "Text");
        text.str = Text;
        text.AsName();
        ps.Add(text);
        ps.Add(PropSpec.Text("class", "Classes"));
        return ps;
    }
}