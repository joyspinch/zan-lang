using System;
using Gui;

namespace Gui.Widget;

/// 徽标：圆点或计数胶囊。颜色、大小、半径和字体来自
/// `badge` CSS 规则，皮肤可重设样式，代码侧只需赋值：
///
///     Badge b = new Badge { Count = 5, Class = "error" };
///     b.Count = unread;         // 0 时绘制圆点形式
class Badge : Control {
    /// 计数值；≤ 0 画成圆点形式，> Max 画成 "<Max>+"。
    int Count;
    /// 超过此值的计数绘制为“<max>+”。
    int Max;

    /// 初始化：计数 n、上限 99、默认 error 色。
    void InitBadge(int n) {
        this.InitControl("badge", 1);
        Count = n;
        Max = 99;
        Class = "error";
    }

    /// 计数 0（圆点形式，设计器用）。
    Badge() { InitBadge(0); }
    /// 计数 n。
    Badge(int n) { InitBadge(n); }

    /// 解析 `badge` 样式盒（Class 与命名参与匹配）。
    StyleBox ResolvedStyle(App app) {
        return Style.Full(app, "badge", Class, name, Style.SNormal());
    }

    /// 计数绘制的标签（圆点形式为“”）。
    string Label() {
        if (Count <= 0) { return ""; }
        if (Count > Max) { return Convert.ToString(Max) + "+"; }
        return Convert.ToString(Count);
    }

    /// 覆写：首选尺寸 = 样式高度 + 标签宽（圆点形式取高度）。
    override void OnMeasure(App app) {
        StyleBox s = this.ResolvedStyle(app);
        prefH = s.HeightOr(app.Scale(18));
        prefW = Badge.WidthOf(app, this.Label(), Class);
    }

    /// 覆写：在盒内垂直居中地画计数胶囊或圆点。
    override void OnPaint(App app) {
        int h = this.ResolvedStyle(app).HeightOr(app.Scale(18));
        int py = by;
        if (bh > h) { py = by + (bh - h) / 2; }
        Badge.Pill(app, bx, py, this.Label(), Class);
    }

    /// 计数胶囊的宽度（无标签时为圆点，取高度）。
    static int WidthOf(App app, string label, string cls) {
        StyleBox s = Style.Of(app, "badge", cls, Style.SNormal());
        int h = s.HeightOr(app.Scale(18));
        if (label == "") { return h; }
        int w = Canvas.MeasureText(label, s.FontOr(app.Scale(11)))
            + s.PadLOr(app.Scale(4)) + s.PadROr(app.Scale(4));
        if (w < h) { w = h; }
        return w;
    }

    /// 在其左上角绘制徽标：`label` 为空时画圆点，否则画
    /// 计数胶囊。
    static void Pill(App app, int x, int y, string label, string cls) {
        StyleBox s = Style.Of(app, "badge", cls, Style.SNormal());
        int h = s.HeightOr(app.Scale(18));
        int w = Badge.WidthOf(app, label, cls);
        if (label == "") {
            // 圆点就是内缩尺寸的同一个胶囊，因此 CSS 中的 `badge.dot`
            // 像普通盒子一样控制它（大小、颜色、边框）。
            StyleBox d = Style.Of(app, "badge", cls + " dot", Style.SNormal());
            int dh = d.HeightOr(app.Scale(8));
            d.SetRadius(dh / 2);
            d.Paint(app, x, y, dh, dh);
            return;
        }
        s.SetRadius(s.RadiusOr(h / 2));
        s.Paint(app, x, y, w, h);
        app.canvas.DrawTextCentered(x, y, w, h, label,
                                    s.FgOr(0),
                                    s.FontOr(app.Scale(11)));
    }

    /// 居中于 (x, y) 的圆点——覆盖标记所需。
    static void Dot(App app, int x, int y) {
        int dh = Style.Of(app, "badge", "error dot", Style.SNormal())
            .HeightOr(app.Scale(8));
        Badge.Pill(app, x - dh / 2, y - dh / 2, "", "error");
    }

    /// 居中于 (x, y) 的计数胶囊。
    static void CountAt(App app, int x, int y, int count) {
        if (count <= 0) { return; }
        string label = Convert.ToString(count);
        if (count > 99) { label = "99+"; }
        StyleBox s = Style.Of(app, "badge", "error", Style.SNormal());
        int h = s.HeightOr(app.Scale(18));
        Badge.Pill(app, x - Badge.WidthOf(app, label, "error") / 2, y - h / 2,
                   label, "error");
    }

    // ---- 设计器 / 序列化模型 -------------------------------------

    /// 控件类型标识（序列化/设计器用）。
    override string Kind() { return "Badge"; }

    /// 覆写：返回设计器属性清单（计数 / 上限 / 类）。
    override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec count = PropSpec.Int("count", "Count");
        count.num = Count;
        ps.Add(count);
        PropSpec max = PropSpec.Int("max", "Max");
        max.num = Max;
        ps.Add(max);
        ps.Add(PropSpec.Text("class", "Classes"));
        return ps;
    }

    /// `dot: true` 为无计数形式，即计数为 0。
    override bool SetExtra(string key, string val) {
        if (key != "dot") { return false; }
        if (PropSpec.IsOn(val)) { Count = 0; }
        return true;
    }
}
