using System;
using Gui;

namespace Gui.Widget;

/// SVG 图标控件：把 IconSvg 的具名图标当作一个可嵌套的控件放进
/// Flex/Panel 组件树，交给布局测量与排列，而不是在 OnPaint 里逐个
/// 手绘定位。名字用 Tabler 原名（完整清单见 IconSvg.Names()），
/// Box 是图标边长（CSS px）；Color 为 0 时取样式前景色，再退到
/// 主题主文字色。
///
///     Flex row = Flex.Wrapped().Gap(8);
///     row.With(new IconView { Name = "home" });
///     row.With(new IconView { Name = "settings", Box = 32 });
///     row.With(new IconView { Name = "heart", Box = 32, Color = 0xFFE91E63 });
class IconView : Control {
    /// Tabler 图标名；未知名字静默不画（与 IconSvg.Draw 一致）。
    string Name;
    /// 图标边长（CSS px）。
    int Box;
    /// ARGB 覆盖色；0 = 跟随样式前景色 / 主题文字色。
    int Color;

    void InitIconView(string name, int box, int color) {
        this.InitControl("iconview", 1);
        // 图标本身透明无边框：表面由本控件全权负责（什么都不铺），
        // 框架若代铺样式面会把图标衬进一块实心底。
        styleSurfaceOwned = true;
        Name = name;
        Box = box;
        Color = color;
    }
    IconView() { InitIconView("", 20, 0); }
    IconView(string name) { InitIconView(name, 20, 0); }
    IconView(string name, int box) { InitIconView(name, box, 0); }
    IconView(string name, int box, int color) { InitIconView(name, box, color); }

    override void OnMeasure(App app) {
        int d = app.Scale(Box);
        if (d < 1) { d = app.Scale(20); }
        prefW = d;
        prefH = d;
    }

    override void OnPaint(App app) {
        if (bw <= 0 || bh <= 0) { return; }
        int d = app.Scale(Box);
        if (d < 1) { d = app.Scale(20); }
        // 不越过布局分配的边界，在盒内居中。
        if (d > bw) { d = bw; }
        if (d > bh) { d = bh; }
        int fg = Color;
        if (fg == 0) {
            fg = this.ResolveStyleAs(app, "iconview", Class, Style.SNormal())
                     .FgOr(0);
            if (fg == 0) { fg = app.theme.textPrimary; }
        }
        IconSvg.Draw(app.canvas, Name, bx + (bw - d) / 2, by + (bh - d) / 2,
            d, fg);
    }

    // ---- 设计器 / 序列化模型 -------------------------------------

    override string Kind() { return "IconView"; }

    override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec name = PropSpec.Text("name", "Name");
        name.str = Name;
        ps.Add(name);
        PropSpec box = PropSpec.Int("box", "Box");
        box.num = Box;
        ps.Add(box);
        PropSpec color = PropSpec.Int("color", "Color");
        color.num = Color;
        ps.Add(color);
        ps.Add(PropSpec.Text("class", "Classes"));
        return ps;
    }
}
