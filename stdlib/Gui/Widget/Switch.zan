using System;
using Gui;

namespace Gui.Widget;

/// 开关，支持响应式 bool 绑定。
///
/// C# 风格保留式实例：
///     Switch dark = Switch.Bind(model);
///     dark.Change += () => { ... };
///     dark.Render(app, x, y);
/// 为现有调用方保留旧版立即模式静态方法。
class Switch : Control {
    SignalBool model;
    /// 双向绑定状态：`sw.data = settings.darkMode;` 保持模型
    /// 字段与开关双向同步（编译器降级的 Binding）。
    Binding<bool> data;
    int wid;
    /// 开关切换时触发（C# 风格：`sw.Change += h;`）。
    UiEvent Change;
    /// 尺寸变体：small / medium / large（Naive UI size prop）。
    string Size;
    /// 加载中：开 + 旋转圆环（Naive UI loading prop）。
    bool Loading;
    /// 圆角轨道 + 圆形 thumb（Naive UI round prop）。
    bool Round;

    void InitSwitch(SignalBool m) {
        this.InitControl("switch", 1);
        model = m;
        wid = WidgetId.Next();
        wiresOwnEvents = true;
        Change = new UiEvent();
        Size = "medium";
        Loading = false;
        Round = true;
    }

    /// 保留式构造器：`Switch dark = new Switch();`
    Switch() {
        InitSwitch(false);
    }

    static Switch Bind(SignalBool model) {
        Switch s = new Switch();
        s.model = model;
        return s;
    }

    bool IsOn() { return model.Get(); }
    void SetOn(bool v) {
        model.Set(v);
        if (data != null) { data.Set(v); }
    }

    /// 将绑定的模型值拉入本地信号（model -> UI）。
    void SyncBinding() {
        if (data == null) { return; }
        bool cur = data.Get();
        if (cur != model.Get()) { model.Set(cur); }
    }

    int Render(App app, int x, int y) {
        int id = wid;
        SyncBinding();
        this.PaintStyled(app, id, x, y, model.Get());
        app.focus.RegisterFocusable(id);

        bool fire = Ui.Clicked(app, id);
        if (Ui.Focused(app, id) && app.EventKind() == 4) {
            int kc = app.window.EventKeyCode();
            if (kc == 32 || kc == 13) { fire = true; }
        }
        if (fire) {
            model.Toggle();
            if (data != null) { data.Set(model.Get()); }
            Change.Raise();
            app.RequestRedraw();
        }
        On.Fire(app, id);
        return id;
    }

    override List<string> Events() {
        List<string> e = Control.CommonEvents();
        e.Add("Change");
        e.Add("Toggle");
        return e;
    }

    override string Kind() { return "Switch"; }

    override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec on = PropSpec.Bool("value", "On");
        on.sflag = model;
        on.Also("checked");
        on.Also("on");
        ps.Add(on);
        PropSpec sz = PropSpec.Enum("size", "Size",
            new List<string>{ "tiny", "small", "medium", "large" });
        sz.num = 2;  // medium default
        ps.Add(sz);
        PropSpec ld = PropSpec.Bool("loading", "Loading");
        ld.flag = Loading;
        ps.Add(ld);
        PropSpec rd = PropSpec.Bool("round", "Round");
        rd.flag = Round;
        ps.Add(rd);
        return ps;
    }

    override void BindEvent(string evt, Action a) {
        if (evt == "Change" || evt == "Toggle") { Change.Add(a); return; }
        On.AddByName(evt, a);
    }

    int PaintStyled(App app, int id, int x, int y, bool isOn) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int target = 0;
        if (isOn) { target = 1000; }
        int animW = this.prefW;
        if (animW <= 0) { animW = app.Scale(40); }
        int animH = this.prefH;
        if (animH <= 0) { animH = t.heightMedium; }
        // Size 字段映射为 Class 片段：small/medium/large 由 base.css 的
        // switch.small / switch.large 规则提供尺寸。
        string origClass = Class;
        if (Size == "tiny" || Size == "small") { this.AddClass("small"); }
        else if (Size == "large") { this.AddClass("large"); }
        // medium 是默认。
        if (Loading) { this.AddClass("loading"); }
        int e = app.AnimToIn(id, target, 140, x, y, animW, animH);
        int latched = Style.SChecked();
        StyleBox root = this.ResolveEasedLatchedStyleAsIn(
            app, id, "switch", Class, false, latched, e,
            x, y, animW, animH);
        StyleBox trackStyle = this.ResolveEasedLatchedPartAsIn(
            app, id, "switch", "track", "", Class, false, latched, e,
            x, y, animW, animH);
        StyleBox thumbStyle = this.ResolveEasedLatchedPartAsIn(
            app, id, "switch", "thumb", "", Class, false, latched, e,
            x, y, animW, animH);

        int trackW = trackStyle.WidthOr(app.Scale(40));
        int trackH = trackStyle.HeightOr(app.Scale(22));
        int totalW = root.WidthOr(trackW);
        int totalH = root.HeightOr(t.heightMedium);
        int trackX = x + (totalW - trackW) / 2;
        int trackY = y + (totalH - trackH) / 2;
        root.Paint(app, x, y, totalW, totalH);

        // 轨道 off/on 与 hover 档全在 `switch::track` 的 CSS 规则里，
        // ResolveEasedLatchedPartAs 已按动画进度混好。
        c.FillRoundRect(trackX, trackY, trackW, trackH,
                        trackStyle.RadiusOr(trackH / 2),
                        trackStyle.BgOr(root.accent));

        int margin = trackStyle.PadLOr(app.Scale(2));
        int thumbSize = thumbStyle.WidthOr(trackH - margin * 2);
        int thumbR = thumbSize / 2;
        int offX = trackX + thumbR + margin;
        int onX = trackX + trackW - thumbR - margin;
        int thumbX = App.Lerp(offX, onX, e);
        int thumbY = trackY + trackH / 2;
        // 投影来自 `switch::thumb { box-shadow }`；没有声明时不画。
        if (thumbStyle.shadow != 0) {
            c.FillCircle(thumbX, thumbY + thumbStyle.shadowDy, thumbR,
                         thumbStyle.shadow);
        }
        c.FillCircle(thumbX, thumbY, thumbR, thumbStyle.BgOr(root.fg));

        app.hitTester.RegisterRect(id, x, y, totalW, totalH, 0);
        // 恢复 Class，避免设计器/序列化器读到污染的字段。
        Class = origClass;
        return id;
    }

    override void OnMeasure(App app) {
        int latched = 0;
        if (model.Get()) { latched = Style.SChecked(); }
        StyleBox root = this.ResolveStyleAs(app, "switch", Class, latched);
        StyleBox trackStyle = this.ResolvePartAs(app, "switch", "track", "",
                                                 Class, latched);
        prefH = root.HeightOr(app.theme.heightMedium);
        prefW = root.WidthOr(trackStyle.WidthOr(app.Scale(40)));
    }

    override void OnPaint(App app) {
        this.Render(app, bx, by);
    }
}
