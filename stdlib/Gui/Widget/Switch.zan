using System;
using Gui;

namespace Gui.Widget;

/// Toggle switch with reactive bool binding.
///
/// C#-style retained instance:
///     Switch dark = Switch.Bind(model);
///     dark.Change += () => { ... };
///     dark.Render(app, x, y);
/// Legacy immediate-mode static is kept for existing callers.
class Switch : Control {
    SignalBool model;
    /// Two-way bound state: `sw.data = settings.darkMode;` keeps the model
    /// field and the switch in sync both ways (compiler-lowered Binding).
    Binding<bool> data;
    int wid;
    /// Fires whenever the switch toggles (C#-style: `sw.Change += h;`).
    UiEvent Change;

    void InitSwitch(SignalBool m) {
        this.InitControl("switch", 1);
        model = m;
        wid = WidgetId.Next();
        wiresOwnEvents = true;
        Change = UiEvent.Create();
    }

    /// Retained-mode constructor: `Switch dark = new Switch();`
    Switch() {
        InitSwitch(SignalBool.Create(false));
    }

    static Switch Bind(SignalBool model) {
        Switch s = new Switch();
        s.model = model;
        return s;
    }

    static Switch Create() {
        return new Switch();
    }

    bool IsOn() { return model.Get(); }
    void SetOn(bool v) {
        model.Set(v);
        if (data != null) { data.Set(v); }
    }

    /// Pull the bound model value into the local signal (model -> UI).
    void SyncBinding() {
        if (data == null) { return; }
        bool cur = data.Get();
        if (cur != model.Get()) { model.Set(cur); }
    }

    int Render(App app, int x, int y) {
        int id = wid;
        SyncBinding();
        this.PaintStyled(app, id, x, y, model.Get());
        app.focus.RegisterFocusable(id);

        bool fire = Ui.Clicked(app, id);
        if (Ui.Focused(app, id) && app.EventKind() == 4) {
            int kc = app.window.EventKeyCode();
            if (kc == 32 || kc == 13) { fire = true; }
        }
        if (fire) {
            model.Toggle();
            if (data != null) { data.Set(model.Get()); }
            Change.Raise();
            app.RequestRedraw();
        }
        On.Fire(app, id);
        return id;
    }

    override List<string> Events() {
        List<string> e = Control.CommonEvents();
        e.Add("Change");
        e.Add("Toggle");
        return e;
    }

    override string Kind() { return "Switch"; }

    override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec on = PropSpec.Bool("value", "On");
        on.sflag = model;
        on.Also("checked");
        on.Also("on");
        ps.Add(on);
        return ps;
    }

    override void BindEvent(string evt, Action a) {
        if (evt == "Change" || evt == "Toggle") { Change.Add(a); return; }
        On.AddByName(evt, a);
    }

    int PaintStyled(App app, int id, int x, int y, bool isOn) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int target = 0;
        if (isOn) { target = 1000; }
        int e = app.AnimTo(id, target, 140);
        int latched = Style.SChecked();
        StyleBox root = this.ResolveEasedLatchedStyleAs(
            app, id, "switch", Class, false, latched, e);
        StyleBox trackStyle = this.ResolveEasedLatchedPartAs(
            app, id, "switch", "track", "", Class, false, latched, e);
        StyleBox thumbStyle = this.ResolveEasedLatchedPartAs(
            app, id, "switch", "thumb", "", Class, false, latched, e);

        int trackW = trackStyle.WidthOr(app.Scale(40));
        int trackH = trackStyle.HeightOr(app.Scale(22));
        int totalW = root.WidthOr(trackW);
        int totalH = root.HeightOr(t.heightMedium);
        int trackX = x + (totalW - trackW) / 2;
        int trackY = y + (totalH - trackH) / 2;
        root.Paint(app, x, y, totalW, totalH);

        int hv = Ui.HoverLevel(app, id);
        int offColor = App.LerpColor(t.textTertiary, t.textSecondary, hv);
        int onColor = App.LerpColor(t.primary, t.primaryHover, hv);
        int trackColor = trackStyle.BgOr(App.LerpColor(offColor, onColor, e));
        c.FillRoundRect(trackX, trackY, trackW, trackH,
                        trackStyle.RadiusOr(trackH / 2), trackColor);

        int margin = trackStyle.PadLOr(app.Scale(2));
        int thumbSize = thumbStyle.WidthOr(trackH - margin * 2);
        int thumbR = thumbSize / 2;
        int offX = trackX + thumbR + margin;
        int onX = trackX + trackW - thumbR - margin;
        int thumbX = App.Lerp(offX, onX, e);
        int thumbY = trackY + trackH / 2;
        int shadow = thumbStyle.shadow;
        if (shadow == 0) { shadow = t.shadowColor; }
        c.FillCircle(thumbX, thumbY + thumbStyle.shadowDy + 1, thumbR, shadow);
        c.FillCircle(thumbX, thumbY, thumbR, thumbStyle.BgOr(t.textInverse));

        app.hitTester.Register(HitRegion.Create(id, x, y, totalW, totalH, 0));
        return id;
    }

    static int Paint(App app, int id, int x, int y, bool isOn) {
        Canvas c = app.canvas;
        Theme t = app.theme;

        int hv = Ui.HoverLevel(app, id);
        int trackW = app.Scale(40);
        int trackH = app.Scale(22);
        int margin = app.Scale(2);
        int knobR = (trackH - margin * 2) / 2;
        int totalH = t.heightMedium;
        int trackY = y + (totalH - trackH) / 2;

        // Ease 0->1000 as the switch toggles so the knob slides and the track
        // colour crossfades between off/on instead of snapping.
        int target = 0;
        if (isOn) { target = 1000; }
        int e = app.AnimTo(id, target, 140);

        int offColor = App.LerpColor(t.textTertiary, t.textSecondary, hv);
        int onColor = App.LerpColor(t.primary, t.primaryHover, hv);
        int trackColor = App.LerpColor(offColor, onColor, e);
        c.FillRoundRect(x, trackY, trackW, trackH, trackH / 2, trackColor);

        int offX = x + knobR + margin;
        int onX = x + trackW - knobR - margin;
        int knobX = App.Lerp(offX, onX, e);
        int knobY = trackY + trackH / 2;
        c.FillCircle(knobX, knobY + 1, knobR, t.shadowColor);
        c.FillCircle(knobX, knobY, knobR, t.textInverse);

        app.hitTester.Register(HitRegion.Create(id, x, y, trackW, totalH, 0));
        return id;
    }

    static int Render(App app, int x, int y, SignalBool model) {
        int id = app.focus.AllocId();
        return Switch.Paint(app, id, x, y, model.Get());
    }

    static void HandleClick(App app, int id, SignalBool model) {
        if (app.EventKind() == 3) {
            if (app.ClickTarget() == id) {
                model.Toggle();
                app.RequestRedraw();
            }
        }
    }

    override void OnMeasure(App app) {
        int latched = 0;
        if (model.Get()) { latched = Style.SChecked(); }
        StyleBox root = this.ResolveStyleAs(app, "switch", Class, latched);
        StyleBox trackStyle = this.ResolvePartAs(app, "switch", "track", "",
                                                 Class, latched);
        prefH = root.HeightOr(app.theme.heightMedium);
        prefW = root.WidthOr(trackStyle.WidthOr(app.Scale(40)));
    }

    override void OnPaint(App app) {
        this.Render(app, bx, by);
    }
}
