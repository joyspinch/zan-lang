using System;
using Gui;

namespace Gui.Widget;

/// 分隔线，可含标题。颜色、粗细和字体
/// 来自 `divider` CSS 规则（`background` 为线条，`height` 为
/// 粗细），因此换肤可一次性重设所有分隔线。
///
///     Divider d = new Divider { Text = "Section", Class = "left" };
///
/// 类名：`left` / `right` 调整标题位置（默认居中），`vertical`
/// 绘制竖向分隔线。
class Divider : Control {
    /// 分隔线标题（可绑定）；空串 = 纯线条。
    Binding<string> Text;

    void InitDivider(string title) {
        this.InitControl(title, 1);
        Text = title;
        // 分隔线完全由 OnPaint 沿中线绘制成细线；
        // base.css 的 `divider { background: ... }` 不能先绘制为
        // 整块高度（否则会用一条横条填满整个 24px 行）。
        styleSurfaceOwned = true;
    }

    /// 无标题分隔线（设计器用）。
    Divider() { InitDivider(""); }
    /// 带标题分隔线。
    Divider(string title) { InitDivider(title); }

    string Label() {
        if (Text == null) { return ""; }
        return Text.Get();
    }

    override void OnMeasure(App app) {
        if (this.Label() == "") { prefH = app.theme.gapMedium; }
        else {
            StyleBox s = Style.Part(app, "divider", "", "", Class, "",
                                    Style.SNormal());
            prefH = Canvas.FontHeight(s.FontOr(Style.FontFallback(app, "medium")));
        }
        prefW = app.Scale(200);
    }

    override void OnPaint(App app) {
        StyleBox s = this.ResolveStyleAs(app, "divider", Class, Style.SNormal());
        int thick = s.HeightOr(1);
        int color = s.BgOr(0);
        string title = this.Label();
        if (Style.Has(Class, "vertical")) {
            app.canvas.FillRect(bx + bw / 2, by, thick, bh, color);
            return;
        }
        if (title == "") {
            app.canvas.FillRect(bx, by + bh / 2, bw, thick, color);
            return;
        }
        Theme t = app.theme;
        int fs = s.FontOr(Style.FontFallback(app, "medium"));
        int tw = Canvas.MeasureText(title, fs);
        int pad = s.GapOr(t.paddingMedium);
        int lineY = by + Canvas.FontHeight(fs) / 2;
        int textX = bx + (bw - tw) / 2;
        if (Style.Has(Class, "left")) { textX = bx + t.paddingLarge; }
        if (Style.Has(Class, "right")) { textX = bx + bw - tw - t.paddingLarge; }
        int rightStart = textX + tw + pad;
        if (textX - pad > bx) {
            app.canvas.FillRect(bx, lineY, textX - pad - bx, thick, color);
        }
        if (rightStart < bx + bw) {
            app.canvas.FillRect(rightStart, lineY, bx + bw - rightStart, thick,
                                color);
        }
        app.canvas.DrawText(textX, by, title, s.FgOr(0), fs);
    }

    // ---- 设计器 / 序列化模型 ----

    override string Kind() { return "Divider"; }

    override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec text = PropSpec.Text("text", "Text");
        text.str = Text;
        ps.Add(text);
        ps.Add(PropSpec.Text("class", "Classes"));
        return ps;
    }
}
