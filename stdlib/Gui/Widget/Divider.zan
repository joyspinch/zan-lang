using System;
using Gui;

namespace Gui.Widget;

/// A separator rule, optionally with a title in it. Colour, thickness and font
/// come from the `divider` CSS rules (`background` is the line, `height` its
/// thickness), so a skin restyles every rule at once.
///
///     Divider d = new Divider { Text = "Section", Class = "left" };
///
/// Classes: `left` / `right` place the title (centred by default), `vertical`
/// draws a column rule.
class Divider : Control {
    Binding<string> Text;

    void InitDivider(string title) {
        this.InitControl(title, 1);
        Text = title;
    }

    Divider() { InitDivider(""); }
    Divider(string title) { InitDivider(title); }

    string Label() {
        if (Text == null) { return ""; }
        return Text.Get();
    }

    override void OnMeasure(App app) {
        if (this.Label() == "") { prefH = app.theme.gapMedium; }
        else { prefH = Canvas.FontHeight(app.theme.fontSizeMedium); }
        prefW = app.Scale(200);
    }

    override void OnPaint(App app) {
        string title = this.Label();
        if (Style.Has(Class, "vertical")) {
            Divider.Line(app, bx + bw / 2, by, 0, bh, Class);
        } else if (title == "") {
            Divider.Line(app, bx, by + bh / 2, bw, 0, Class);
        } else {
            Divider.Titled(app, bx, by, bw, title, Class);
        }
    }

    /// A rule: `w` px wide when `h` is 0, `h` px tall when `w` is 0. Thickness
    /// and colour come from the style, so `divider { height: 2px }` thickens it.
    static void Line(App app, int x, int y, int w, int h, string cls) {
        StyleBox s = Style.Of(app, "divider", cls, Style.SNormal());
        int thick = s.HeightOr(1);
        int color = s.BgOr(app.theme.divider);
        if (w == 0) { app.canvas.FillRect(x, y, thick, h, color); }
        else { app.canvas.FillRect(x, y, w, thick, color); }
    }

    /// A rule broken by a title. `left` / `right` classes align the title.
    static void Titled(App app, int x, int y, int w, string title, string cls) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        StyleBox s = Style.Of(app, "divider", cls, Style.SNormal());
        int fs = s.FontOr(t.fontSizeMedium);
        int tw = Canvas.MeasureText(title, fs);
        int pad = s.GapOr(t.paddingMedium);
        int lineY = y + Canvas.FontHeight(fs) / 2;

        int textX = x + (w - tw) / 2;
        if (Style.Has(cls, "left")) { textX = x + t.paddingLarge; }
        if (Style.Has(cls, "right")) { textX = x + w - tw - t.paddingLarge; }

        int leftEnd = textX - pad;
        int rightStart = textX + tw + pad;
        if (leftEnd > x) { Divider.Line(app, x, lineY, leftEnd - x, 0, cls); }
        if (rightStart < x + w) {
            Divider.Line(app, rightStart, lineY, x + w - rightStart, 0, cls);
        }
        c.DrawText(textX, y, title, s.FgOr(t.textPrimary), fs);
    }

    /// Plain horizontal rule at (x, y).
    static void Render(App app, int x, int y, int w) {
        Divider.Line(app, x, y, w, 0, "");
    }

    /// Horizontal rule with a title. align: 0 centre, 1 left, 2 right.
    static void RenderText(App app, int x, int y, int w, string title, int align) {
        string cls = "";
        if (align == 1) { cls = "left"; }
        if (align == 2) { cls = "right"; }
        Divider.Titled(app, x, y, w, title, cls);
    }

    /// Plain vertical rule at (x, y).
    static void RenderVertical(App app, int x, int y, int h) {
        Divider.Line(app, x, y, 0, h, "");
    }

    // ---- designer / serialization model -------------------------------------

    override string Kind() { return "Divider"; }

    override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        ps.Add(PropSpec.Text("text", "Text"));
        ps.Add(PropSpec.Text("class", "Classes"));
        return ps;
    }

    override string GetProp(string key) {
        if (key == "text") { return this.Label(); }
        if (key == "class") { return Class; }
        return "";
    }

    override void SetProp(string key, string val) {
        if (key == "text") { Text = val; }
        else if (key == "class") { Class = val; }
        else if (val == "true") { Class = Class + " " + key; }
        else if (val != "" && val != "false") { Class = Class + " " + val; }
    }
}
