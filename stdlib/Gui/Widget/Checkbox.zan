using System;
using Gui;

namespace Gui.Widget;

/// 带勾选图标和响应式布尔绑定的复选框。
///
///     Checkbox agree = Checkbox.Bind("I agree", model);
///     agree.Change += () => { ... };   // 每次切换时触发
///     agree.Render(app, x, y);
class Checkbox : Control {
    string label;
    SignalBool model;
    /// 双向绑定状态：`cb.data = user.agreed;` 使模型字段
    /// 与复选框双向同步（编译器降级的 Binding）。
    Binding<bool> data;
    int wid;
    /// 选中状态切换时触发（C# 风格：`cb.Change += h;`）。
    UiEvent Change;

    void InitCheckbox(string lbl, SignalBool m) {
        this.InitControl(lbl, 1);
        label = lbl;
        model = m;
        wid = WidgetId.Next();
        wiresOwnEvents = true;
        Change = new UiEvent();
    }

    /// Default constructor used by .zform and the string-kind registry.
    Checkbox() {
        InitCheckbox("", false);
    }

    /// 保留模式构造函数：`Checkbox agree = new Checkbox("I agree");`
    Checkbox(string lbl) {
        InitCheckbox(lbl, false);
    }

    static Checkbox Bind(string label, SignalBool model) {
        Checkbox cb = new Checkbox(label);
        cb.model = model;
        return cb;
    }

    bool IsChecked() { return model.Get(); }
    void SetChecked(bool v) {
        model.Set(v);
        if (data != null) { data.Set(v); }
    }

    /// 将绑定的模型值拉入本地信号（模型 -> UI）。
    void SyncBinding() {
        if (data == null) { return; }
        bool cur = data.Get();
        if (cur != model.Get()) { model.Set(cur); }
    }

    /// 保留模式渲染：绘制、分发自身的点击/键盘切换并
    /// 触发 Change。返回控件 id。
    int Render(App app, int x, int y) {
        return this.RenderIn(app, x, y, 0);
    }

    /// 与 Render 相同，但按排布给定的行高 `h` 绘制（0 = 按样式/
    /// 主题的控件高度）。停靠成一列的复选框行高由容器决定，
    /// 用主题高度画会让方框和点击区溢出到下一行上。
    int RenderIn(App app, int x, int y, int h) {
        int id = wid;
        SyncBinding();
        this.PaintStyled(app, id, x, y, h, label, model.Get());
        app.focus.RegisterFocusable(id);

        bool fire = Ui.Clicked(app, id) && !this.IsDisabled();
        if (Ui.Focused(app, id) && app.EventKind() == 4) {
            int kc = app.window.EventKeyCode();
            if (kc == 32 || kc == 13) { fire = true; }
        }
        if (fire) {
            model.Toggle();
            if (data != null) { data.Set(model.Get()); }
            Change.Raise();
            app.RequestRedraw();
        }
        On.Fire(app, id);
        return id;
    }

    override List<string> Events() {
        List<string> e = Control.CommonEvents();
        e.Add("Change");
        e.Add("Toggle");
        return e;
    }

    override string Kind() { return "Checkbox"; }

    override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec text = PropSpec.Text("label", "Label");
        text.str = label;
        text.Also("text");
        ps.Add(text);
        PropSpec on = PropSpec.Bool("value", "Checked");
        on.sflag = model;
        on.Also("checked");
        ps.Add(on);
        return ps;
    }

    override void BindEvent(string evt, Action a) {
        if (evt == "Change" || evt == "Toggle") { Change.Add(a); return; }
        On.AddByName(evt, a);
    }

    int PaintStyled(App app, int id, int x, int y, int h, string text,
                    bool checked) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int target = 0;
        if (checked) { target = 1000; }
        int animW = this.prefW;
        if (animW <= 0) {
            StyleBox measureLabel = Style.Part(app, "checkbox", "label", "",
                                               Class, "", Style.SNormal());
            animW = app.Scale(18) + app.Scale(8)
                + Canvas.MeasureText(text,
                    measureLabel.FontOr(Style.FontFallback(app, "medium")));
        }
        int animH = h;
        if (animH <= 0) { animH = this.prefH; }
        if (animH <= 0) { animH = t.heightMedium; }
        int e = app.AnimToIn(200000 + id, target, 130,
                             x, y, animW, animH);
        int latched = Style.SChecked();
        StyleBox root = this.ResolveEasedLatchedStyleAsIn(
            app, id, "checkbox", Class, false, latched, e,
            x, y, animW, animH);
        StyleBox boxStyle = this.ResolveEasedLatchedPartAsIn(
            app, id, "checkbox", "box", "", Class, false, latched, e,
            x, y, animW, animH);
        StyleBox checkStyle = this.ResolveEasedLatchedPartAsIn(
            app, id, "checkbox", "check", "", Class, false, latched, e,
            x, y, animW, animH);
        StyleBox labelStyle = this.ResolveEasedLatchedPartAsIn(
            app, id, "checkbox", "label", "", Class, false, latched, e,
            x, y, animW, animH);

        int boxSize = boxStyle.WidthOr(app.Scale(18));
        int boxH = boxStyle.HeightOr(boxSize);
                int fontSize = labelStyle.FontOr(
                    root.FontOr(Style.FontFallback(app, "medium")));
        int gp = root.GapOr(app.Scale(8));
        int totalH = root.HeightOr(t.heightMedium);
        if (h > 0) { totalH = h; }
        int totalW = root.WidthOr(boxSize + gp + Canvas.MeasureText(text, fontSize));
        root.Paint(app, x, y, totalW, totalH);

        // 方框随 DPI 缩放，行高却可能是调用方给死的：方框比行
        // 还高时，相邻两行的边框会焊在一起（看起来就是没有行距）。
        if (boxH > totalH) { boxH = totalH; }
        if (boxSize > totalH) { boxSize = totalH; }
        int boxY = y + (totalH - boxH) / 2;
        // 颜色全部来自 `checkbox::box` / `::check` 的 CSS 规则：hover 淡变
        // 和 :checked 交叉淡化已由 ResolveEasedLatchedPartAs 混好，
        // 这里只剩几何。
        int radius = boxStyle.RadiusOr(t.borderRadiusSmall);
        c.FillRoundRect(x, boxY, boxSize, boxH, radius,
                        boxStyle.BgOr(root.accent));
        if (e < 1000) {
            c.DrawRoundRect(x, boxY, boxSize, boxH, radius,
                            boxStyle.BorderOr(root.fg),
                            boxStyle.BorderWOr(1));
        }
        if (e > 120) {
            int inset = checkStyle.PadLOr(app.Scale(3));
            int fullSize = boxSize - inset * 2;
            int icoSize = App.Lerp(0, fullSize, e);
            int icoX = x + (boxSize - icoSize) / 2;
            int icoY = boxY + (boxH - icoSize) / 2;
            c.DrawGlyph("check", icoX, icoY, icoSize,
                      checkStyle.FgOr(root.fg));
        }

        int labelX = x + boxSize + gp;
        int labelY = Canvas.CenterTextY(y, totalH, fontSize);
        c.DrawText(labelX, labelY, text, labelStyle.FgOr(root.fg), fontSize);
        app.hitTester.RegisterRect(id, x, y, totalW, totalH, 2);
        return id;
    }

    /// 绘制方框 + 标签并注册点击区域。保留模式与
    /// 旧模式路径共用，保证两者外观一致。
    /// 仅绘制复选框图形（无标签、无点击区域），使需要
    /// 内联复选框的控件画出与真实复选框相同的图形，而无需
    /// 自行绘制。`level` 在 0（未选中）~1000（选中）间交叉淡化。
    static void PaintBox(App app, int x, int y, int size, int level) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        // 内联方框与真正的复选框吃同一套 `checkbox::box` / `::check`
        // 规则：off/on 两份样式按 `level` 交叉淡化。
        StyleBox off = Style.Part(app, "checkbox", "box", "", "", "",
                                  Style.SNormal());
        StyleBox on = Style.Part(app, "checkbox", "box", "", "", "",
                                 Style.SChecked());
        StyleBox box = StyleBox.Blend(off, on, level);
        StyleBox check = Style.Part(app, "checkbox", "check", "", "", "",
                                    Style.SChecked());
        int radius = box.RadiusOr(t.borderRadiusSmall);
        c.FillRoundRect(x, y, size, size, radius, box.bg);
        if (level < 1000) {
            c.DrawRoundRect(x, y, size, size, radius, box.borderColor,
                            box.BorderWOr(1));
        }
        if (level > 120) {
            int inset = check.PadLOr(app.Scale(3));
            int fullSize = size - inset * 2;
            int icoSize = App.Lerp(0, fullSize, level);
            c.DrawGlyph("check", x + (size - icoSize) / 2,
                      y + (size - icoSize) / 2, icoSize, check.fg);
        }
    }

    static void PaintBoxIndeterminate(App app, int x, int y, int size) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        StyleBox box = Style.Part(app, "checkbox", "box", "", "", "",
                                  Style.SChecked());
        StyleBox check = Style.Part(app, "checkbox", "check", "", "", "",
                                    Style.SChecked());
        int radius = box.RadiusOr(t.borderRadiusSmall);
        c.FillRoundRect(x, y, size, size, radius, box.BgOr(0));
        int lineW = size - check.PadLOr(app.Scale(6)) * 2;
        int lineH = app.Scale(2);
        c.FillRoundRect(x + (size - lineW) / 2, y + (size - lineH) / 2,
                        lineW, lineH, lineH / 2, check.FgOr(0));
    }

    override void OnMeasure(App app) {
        Theme t = app.theme;
        int latched = 0;
        if (model.Get()) { latched = Style.SChecked(); }
        StyleBox root = this.ResolveStyleAs(app, "checkbox", Class, latched);
        StyleBox boxStyle = this.ResolvePartAs(app, "checkbox", "box", "",
                                               Class, latched);
        StyleBox labelStyle = this.ResolvePartAs(app, "checkbox", "label", "",
                                                 Class, latched);
        int boxSize = boxStyle.WidthOr(app.Scale(18));
            int fontSize = labelStyle.FontOr(
                root.FontOr(Style.FontFallback(app, "medium")));
        prefH = root.HeightOr(t.heightMedium);
        prefW = root.WidthOr(boxSize + root.GapOr(app.Scale(8))
                             + Canvas.MeasureText(label, fontSize));
    }

    override void OnPaint(App app) {
        this.RenderIn(app, bx, by, bh);
    }
}
