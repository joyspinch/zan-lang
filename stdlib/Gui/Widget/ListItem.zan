using System;
using Gui;

namespace Gui.Widget;

/// 列表里的两行行：标题 + 可选副标题。给 ListView 的模板行、
/// 目录/会话类侧栏当标准行内容——行的视觉（上下对称的留白、
/// 字号阶梯、选中配色、超宽省略号）全部住在 `listitem` 样式
/// 规则里，使用处只喂数据：
///
///     ListView<Demo> nav = new ListView<Demo>(
///         d => new ListItem(d.title, d.desc));
///
/// 选中配色：宿主把 `Selected` 置真（ListView 模板行在重建时
/// 设置），控件按 `selected` 状态解析样式，标题/副标题换
/// `listitem::title:selected` / `::desc:selected` 的颜色。
/// `ListItem.Header`（`.header` 类）是分组标题档：弱色小字，
/// 上方留白把组隔开。外观随皮肤整体变，控件代码不认颜色。
class ListItem : Control {
    /// 标题文本（可绑定）。
    Binding<string> Text;
    /// 副标题文本（可绑定）；空串不画该行。
    Binding<string> Desc;
    /// 选中态：参与样式状态选择（`selected`）。
    bool Selected;

    /// 公共初始化。
    void InitItem(string ttl, string desc) {
        this.InitControl(ttl, 1);
        Text = ttl;
        Desc = desc;
        Selected = false;
    }

    /// 空行（设计器用）。
    ListItem() { InitItem("", ""); }

    /// 单行：只有标题。
    ListItem(string ttl) { InitItem(ttl, ""); }

    /// 两行：标题 + 副标题。
    ListItem(string ttl, string desc) { InitItem(ttl, desc); }

    /// 分组标题行（弱色小字，上方留白把组隔开）。
    static ListItem Header(string ttl) {
        ListItem it = new ListItem(ttl);
        it.Class = "header";
        return it;
    }

    /// 当前标题；Text 为 null 时返回空串。
    string Label() {
        if (Text == null) { return ""; }
        return Text.Get();
    }

    /// 当前副标题；Desc 为 null 时返回空串。
    string Sub() {
        if (Desc == null) { return ""; }
        return Desc.Get();
    }

    /// 控件类型标识（序列化/设计器用）。
    override string Kind() { return "ListItem"; }

    /// 覆写：CSS 类型选择器名（"listitem"）。
    override string StyleType() { return "listitem"; }

    /// 当前状态档：禁用行按 `disabled` 状态解析（弱色），
    /// 其次选中行按 `selected` 状态解析。
    int StateNow() {
        if (this.IsDisabled()) { return Style.SDisabled(); }
        if (Selected) { return Style.SSelected(); }
        return Style.SNormal();
    }

    /// 解析 `listitem` 自身样式盒（内边距、行距从这里来）。
    StyleBox ResolvedStyle(App app) {
        return this.ResolveStyleAs(app, "listitem", Class, this.StateNow());
    }

    /// 标题行部件样式（`listitem::title`）。
    StyleBox TitleStyle(App app) {
        return Style.Part(app, "listitem", "title", "", Class, "",
                          this.StateNow());
    }

    /// 副标题行部件样式（`listitem::desc`）。
    StyleBox DescStyle(App app) {
        return Style.Part(app, "listitem", "desc", "", Class, "",
                          this.StateNow());
    }

    /// 覆写：对称上下内边距 + 标题行高 + 可选副标题行高。
    override void OnMeasure(App app) {
        StyleBox s = this.ResolvedStyle(app);
        StyleBox ts = this.TitleStyle(app);
        StyleBox ds = this.DescStyle(app);
        int tf = ts.FontOr(Style.FontFallback(app, "small"));
        int titleH = Canvas.FontHeight(tf);
        int textW = Canvas.MeasureText(this.Label(), tf);
        string sub = this.Sub();
        if (sub != "") {
            int df = ds.FontOr(Style.FontFallback(app, "tiny"));
            int dw = Canvas.MeasureText(sub, df);
            if (dw > textW) { textW = dw; }
            prefH = s.PadTOr(0) + titleH
                + s.GapOr(app.theme.gapSmall) + Canvas.FontHeight(df);
        } else {
            prefH = s.PadTOr(0) + titleH;
        }
        prefH = prefH + s.PadBOr(0);
        prefW = s.PadLOr(0) + textW + s.PadROr(0);
    }

    /// 覆写：按内边距缩进画标题/副标题，超宽省略号截断。
    override void OnPaint(App app) {
        Canvas c = app.canvas;
        StyleBox s = this.ResolvedStyle(app);
        StyleBox ts = this.TitleStyle(app);
        int x = bx + s.PadLOr(0);
        int y = by + s.PadTOr(0);
        int maxW = bw - s.PadLOr(0) - s.PadROr(0);
        int tf = ts.FontOr(Style.FontFallback(app, "small"));
        c.DrawText(x, y, Ellipsis.Fit(this.Label(), maxW, tf),
                   ts.FgOr(0), tf);
        string sub = this.Sub();
        if (sub == "") { return; }
        int titleH = Canvas.FontHeight(tf);
        StyleBox ds = this.DescStyle(app);
        int df = ds.FontOr(Style.FontFallback(app, "tiny"));
        y = y + titleH + s.GapOr(app.theme.gapSmall);
        c.DrawText(x, y, Ellipsis.Fit(sub, maxW, df), ds.FgOr(0), df);
    }

    /// 覆写：返回设计器属性清单（text/desc/selected）。
    override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec text = PropSpec.Text("text", "Text");
        text.str = this.Label();
        text.AsName();
        ps.Add(text);
        PropSpec desc = PropSpec.Text("desc", "Desc");
        desc.str = this.Sub();
        ps.Add(desc);
        PropSpec sel = PropSpec.Bool("selected", "Selected");
        sel.flag = Selected;
        ps.Add(sel);
        PropSpec off = PropSpec.Bool("disabled", "Disabled");
        off.flag = this.IsDisabled();
        ps.Add(off);
        return ps;
    }
}
