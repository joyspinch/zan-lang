using System;
using Gui;

namespace Gui.Widget;

/// 统计组件：大数值上方的小标题。两者都是样式部件，
/// CSS 中 `statistic::label` 和 `statistic::value` 控制其颜色和
/// 字号。
///
///     Statistic s = new Statistic { Text = "Active users", Value = "12,480" };
class Statistic : Control {
    /// 上方小标题（可绑定）。
    Binding<string> Text;
    /// 下方大数值（可绑定）。
    Binding<string> Value;

    void InitStatistic(string label, string amount) {
        this.InitControl(label, 1);
        Text = label;
        Value = amount;
    }

    /// 空统计（设计器用）。
    Statistic() { InitStatistic("", ""); }
    /// 标题 + 数值。
    Statistic(string label, string amount) { InitStatistic(label, amount); }

    string Label() {
        if (Text == null) { return ""; }
        return Text.Get();
    }

    string Amount() {
        if (Value == null) { return ""; }
        return Value.Get();
    }

    override void OnMeasure(App app) {
        prefH = Statistic.Height(app);
        StyleBox ls = Style.Part(app, "statistic", "label", "text", Class, "",
                                 Style.SNormal());
        StyleBox vs = Style.Part(app, "statistic", "value", "text", Class, "",
                                 Style.SNormal());
        int lw = Canvas.MeasureText(this.Label(),
                                    ls.FontOr(Style.FontFallback(app, "small")));
        int aw = Canvas.MeasureText(this.Amount(),
                                    vs.FontOr(Style.FontFallback(app, "huge")));
        if (aw > lw) { prefW = aw; } else { prefW = lw; }
    }

    override void OnPaint(App app) {
        string label = this.Label();
        string amount = this.Amount();
        string cls = Class;

        Canvas c = app.canvas;
        Theme t = app.theme;
        StyleBox ls = Style.Part(app, "statistic", "label", "text", cls, "",
                                 Style.SNormal());
        StyleBox vs = Style.Part(app, "statistic", "value", "text", cls, "",
                                 Style.SNormal());
        int lf = ls.FontOr(Style.FontFallback(app, "small"));
        c.DrawText(bx, by, label, ls.FgOr(0), lf);
        int vy = by + Canvas.FontHeight(lf) + ls.GapOr(t.gapSmall);
        c.DrawText(bx, vy, amount, vs.FgOr(0),
                   vs.FontOr(Style.FontFallback(app, "huge")));
    }






    /// 自然高度：标题行 + 间距 + 数值行。
    static int Height(App app) {
        Theme t = app.theme;
        StyleBox ls = Style.Part(app, "statistic", "label", "text", "", "",
                                 Style.SNormal());
        StyleBox vs = Style.Part(app, "statistic", "value", "text", "", "",
                                 Style.SNormal());
        return Canvas.FontHeight(ls.FontOr(Style.FontFallback(app, "small")))
            + t.gapSmall
            + Canvas.FontHeight(vs.FontOr(Style.FontFallback(app, "huge")));
    }

    // ---- 设计器 / 序列化模型 -------------------------------------

    override string Kind() { return "Statistic"; }

    override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec text = PropSpec.Text("text", "Text");
        text.str = Text;
        ps.Add(text);
        PropSpec amount = PropSpec.Text("value", "Value");
        amount.str = Value;
        ps.Add(amount);
        ps.Add(PropSpec.Text("class", "Classes"));
        return ps;
    }
}
