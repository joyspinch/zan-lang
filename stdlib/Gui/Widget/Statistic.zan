using System;
using Gui;

namespace Gui.Widget;

/// A statistic: a small caption above a large value. Both are styled parts, so
/// `statistic::label` and `statistic::value` in CSS control their colour and
/// font size.
///
///     Statistic s = new Statistic { Text = "Active users", Value = "12,480" };
class Statistic : Control {
    Binding<string> Text;
    Binding<string> Value;

    void InitStatistic(string label, string amount) {
        this.InitControl(label, 1);
        Text = label;
        Value = amount;
    }

    Statistic() { InitStatistic("", ""); }
    Statistic(string label, string amount) { InitStatistic(label, amount); }

    string Label() {
        if (Text == null) { return ""; }
        return Text.Get();
    }

    string Amount() {
        if (Value == null) { return ""; }
        return Value.Get();
    }

    override void OnMeasure(App app) {
        prefH = Statistic.Height(app);
        int lw = Canvas.MeasureText(this.Label(), app.theme.fontSizeSmall);
        int aw = Canvas.MeasureText(this.Amount(), app.theme.fontSizeHuge);
        if (aw > lw) { prefW = aw; } else { prefW = lw; }
    }

    override void OnPaint(App app) {
        Statistic.Paint(app, bx, by, this.Label(), this.Amount(), Class);
    }

    static void Paint(App app, int x, int y, string label, string amount,
                      string cls) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        StyleBox ls = Style.Part(app, "statistic", "label", "text", cls, "",
                                 Style.SNormal());
        StyleBox vs = Style.Part(app, "statistic", "value", "text", cls, "",
                                 Style.SNormal());
        int lf = ls.FontOr(t.fontSizeSmall);
        c.DrawText(x, y, label, ls.FgOr(t.textSecondary), lf);
        int vy = y + Canvas.FontHeight(lf) + ls.GapOr(t.gapSmall);
        c.DrawText(x, vy, amount, vs.FgOr(t.textPrimary),
                   vs.FontOr(t.fontSizeHuge));
    }

    static void Render(App app, int x, int y, string label, string amount) {
        Statistic.Paint(app, x, y, label, amount, "");
    }

    static int Height(App app) {
        Theme t = app.theme;
        return Canvas.FontHeight(t.fontSizeSmall) + t.gapSmall
            + Canvas.FontHeight(t.fontSizeHuge);
    }

    // ---- designer / serialization model -------------------------------------

    override string Kind() { return "Statistic"; }

    override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        ps.Add(PropSpec.Text("text", "Text"));
        ps.Add(PropSpec.Text("value", "Value"));
        ps.Add(PropSpec.Text("class", "Classes"));
        return ps;
    }

    override string GetProp(string key) {
        if (key == "text") { return this.Label(); }
        if (key == "value") { return this.Amount(); }
        if (key == "class") { return Class; }
        return "";
    }

    override void SetProp(string key, string val) {
        if (key == "text") { Text = val; }
        else if (key == "value") { Value = val; }
        else if (key == "class") { Class = val; }
        else if (val != "" && val != "false" && val != "true") {
            Class = Class + " " + val;
        }
    }
}
