using System;
using Gui;

namespace Gui.Widget;

/// 统计组件：大数值上方的小标题。两者都是样式部件，
/// CSS 中 `statistic::label` 和 `statistic::value` 控制其颜色和
/// 字号。
///
///     Statistic s = new Statistic { Text = "Active users", Value = "12,480" };
class Statistic : Control {
    Binding<string> Text;
    Binding<string> Value;

    void InitStatistic(string label, string amount) {
        this.InitControl(label, 1);
        Text = label;
        Value = amount;
    }

    Statistic() { InitStatistic("", ""); }
    Statistic(string label, string amount) { InitStatistic(label, amount); }

    string Label() {
        if (Text == null) { return ""; }
        return Text.Get();
    }

    string Amount() {
        if (Value == null) { return ""; }
        return Value.Get();
    }

    override void OnMeasure(App app) {
        prefH = Statistic.Height(app);
        int lw = Canvas.MeasureText(this.Label(), app.theme.fontSizeSmall);
        int aw = Canvas.MeasureText(this.Amount(), app.theme.fontSizeHuge);
        if (aw > lw) { prefW = aw; } else { prefW = lw; }
    }

    override void OnPaint(App app) {
        string label = this.Label();
        string amount = this.Amount();
        string cls = Class;

        Canvas c = app.canvas;
        Theme t = app.theme;
        StyleBox ls = Style.Part(app, "statistic", "label", "text", cls, "",
                                 Style.SNormal());
        StyleBox vs = Style.Part(app, "statistic", "value", "text", cls, "",
                                 Style.SNormal());
        int lf = ls.FontOr(t.fontSizeSmall);
        c.DrawText(bx, by, label, ls.FgOr(0), lf);
        int vy = by + Canvas.FontHeight(lf) + ls.GapOr(t.gapSmall);
        c.DrawText(bx, vy, amount, vs.FgOr(0),
                   vs.FontOr(t.fontSizeHuge));
    }






    static int Height(App app) {
        Theme t = app.theme;
        return Canvas.FontHeight(t.fontSizeSmall) + t.gapSmall
            + Canvas.FontHeight(t.fontSizeHuge);
    }

    // ---- 设计器 / 序列化模型 -------------------------------------

    override string Kind() { return "Statistic"; }

    override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec text = PropSpec.Text("text", "Text");
        text.str = Text;
        ps.Add(text);
        PropSpec amount = PropSpec.Text("value", "Value");
        amount.str = Value;
        ps.Add(amount);
        ps.Add(PropSpec.Text("class", "Classes"));
        return ps;
    }
}
