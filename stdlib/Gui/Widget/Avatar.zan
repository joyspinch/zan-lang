using System;
using Gui;

namespace Gui.Widget;

/// 头像：圆形标记内的首字母或图标。填充、文字颜色和
/// 半径来自 `avatar` CSS 规则；`Size` 是圆形的直径，单位为
/// CSS px（`width`/`height` 规则优先于它）。
///
///     Avatar a = new Avatar { Text = "JS", Size = 40 };
///     Avatar b = new Avatar { Icon = "user", Class = "primary" };
///     Avatar c = new Avatar { Text = "S", Size = 48, Shape = "square" };
class Avatar : Control {
    /// 圆内文本（首字母 / 缩写）；Icon 非空时不显示。
    Binding<string> Text;
    /// 图标字形名；非空时取代文本。
    string Icon;
    /// 直径（CSS px）；height 样式规则优先。
    int Size;
    /// 形状：circle（默认）、rounded、square（Naive UI shape prop）。
    string Shape;

    /// 初始化：注册为 "avatar" 并自持样式表面，置文本/图标/直径与
    /// circle 形状。
    void InitAvatar(string label, int size, string icon) {
        this.InitControl("avatar", 1);
        // OnPaint 自行绘制圆形标记，按直径居中在
        // 布局给出的盒内。若同时让框架把解析后的样式表面
        // 铺满整个边界，行高头像就会
        // 变成胶囊形。
        styleSurfaceOwned = true;
        Text = label;
        Icon = icon;
        Size = size;
        Shape = "circle";
        Class = "primary";
    }
    /// 默认 32px 空头像（设计器用）。
    Avatar() { InitAvatar("", 32, ""); }
    /// 给定首字母文本、32px。
    Avatar(string label) { InitAvatar(label, 32, ""); }
    /// 给定文本与直径。
    Avatar(string label, int size) { InitAvatar(label, size, ""); }
    /// 给定文本、直径与图标字形。
    Avatar(string label, int size, string icon) { InitAvatar(label, size, icon); }

    /// 当前文本；Text 为 null 时返回空串。
    string Label() {
        if (Text == null) { return ""; }
        return Text.Get();
    }

    /// 生效直径：`height` 样式规则优先，否则 Size 按 DPI 缩放。
    int Diameter(App app) {
        return this.ResolveStyleAs(app, "avatar", Class, Style.SNormal())
            .HeightOr(app.Scale(Size));
    }

    /// 测量：宽高都取直径（正方形占位）。
    void OnMeasure(App app) {
        prefW = this.Diameter(app);
        prefH = prefW;
    }

    /// 绘制：按直径在盒内居中画头像表面（Shape 映射圆角）与
    /// 图标/首字母文本。
    void OnPaint(App app) {
        if (bw <= 0) { return; }
        Canvas c = app.canvas;
        int d = this.Diameter(app);
        // 不越过布局分配的边界。
        if (d > bw) { d = bw; }
        // 行通常比头像高，所以在边界内居中。
        int py = by;
        if (bh > d) { py = by + (bh - d) / 2; }
        // Shape 字段映射到圆角：circle=直径/2，rounded=皮肤 borderRadiusMedium，
        // square=直角。沿用 StyleBox.Paint 路径不变。
        int radius = d / 2;
        if (Shape == "square") { radius = 0; }
        else if (Shape == "rounded") { radius = app.theme.borderRadiusMedium; }
        StyleBox s = this.ResolveStyleAs(app, "avatar", Class, Style.SNormal());
        s.SetRadius(radius);
        s.Paint(app, bx, py, d, d);
        int fg = s.FgOr(0);
        if (Icon != "") {
            c.DrawGlyph(Icon, bx + d / 4, py + d / 4, d / 2, fg);
            return;
        }
        c.DrawTextCentered(bx, py, d, d, this.Label(), fg, s.FontOr(d / 2));
    }

    // ---- 设计器 / 序列化模型 -------------------------------------

    /// 控件类型标识（序列化/设计器用）。
    string Kind() { return "Avatar"; }

    /// 覆写：返回设计器属性清单（text/icon/size/shape/class）。
    override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec text = PropSpec.Text("text", "Text");
        text.str = Text;
        ps.Add(text);
        PropSpec icon = PropSpec.Text("icon", "Icon");
        icon.str = Icon;
        ps.Add(icon);
        PropSpec size = PropSpec.Int("size", "Size");
        size.num = Size;
        ps.Add(size);
        PropSpec shape = PropSpec.Enum("shape", "Shape",
            new List<string>{ "circle", "rounded", "square" });
        shape.num = 0;  // circle default
        ps.Add(shape);
        ps.Add(PropSpec.Text("class", "Classes"));
        return ps;
    }

    /// shape prop 是枚举（string），通过 GetExtra/SetExtra 与
    /// 字符串字段 Shape 同步。PropSpec.Enum 驱动的是内部 num，
    /// 这里由 SetExtra 接住字符串后回写到 Shape。
    override string GetExtra(string key) {
        if (key == "shape") { return Shape; }
        return "";
    }

    /// 设计器写入 `shape`（枚举字符串回写到 Shape 字段）；
    /// 其他键返回 false 交给基类。
    override bool SetExtra(string key, string val) {
        if (key == "shape") {
            if (val == "square") { Shape = "square"; }
            else if (val == "rounded") { Shape = "rounded"; }
            else { Shape = "circle"; }
            return true;
        }
        return false;
    }
}
