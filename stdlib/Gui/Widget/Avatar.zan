using System;
using Gui;

namespace Gui.Widget;

/// An avatar: initials or an icon in a round marker. Fill, text colour and
/// radius come from the `avatar` CSS rules; `Size` is the circle's diameter in
/// CSS px (a `width`/`height` rule wins over it).
///
///     Avatar a = new Avatar { Text = "JS", Size = 40 };
///     Avatar b = new Avatar { Icon = "user", Class = "primary" };
class Avatar : Control {
    Binding<string> Text;
    string Icon;
    int Size;

    void InitAvatar(string label, int size, string icon) {
        this.InitControl("avatar", 1);
        // OnPaint fills the round marker itself, at the diameter and centred in
        // whatever box the layout hands over. Letting the framework also stamp
        // the resolved surface over the full bounds turned a row-height avatar
        // into a pill.
        styleSurfaceOwned = true;
        Text = label;
        Icon = icon;
        Size = size;
        Class = "primary";
    }

    Avatar() { InitAvatar("", 32, ""); }
    Avatar(string label) { InitAvatar(label, 32, ""); }
    Avatar(string label, int size, string icon) { InitAvatar(label, size, icon); }

    string Label() {
        if (Text == null) { return ""; }
        return Text.Get();
    }

    int Diameter(App app) {
        return this.ResolveStyleAs(app, "avatar", Class, Style.SNormal())
            .HeightOr(app.Scale(Size));
    }

    override void OnMeasure(App app) {
        prefW = this.Diameter(app);
        prefH = prefW;
    }

    override void OnPaint(App app) {
        Canvas c = app.canvas;
        int d = this.Diameter(app);
        // Rows are usually taller than the avatar, so center in the bounds.
        int py = by;
        if (bh > d) { py = by + (bh - d) / 2; }
        StyleBox s = this.ResolveStyleAs(app, "avatar", Class, Style.SNormal());
        s.Paint(app, bx, py, d, d);
        int fg = s.FgOr(app.theme.textInverse);
        if (Icon != "") {
            c.DrawGlyph(Icon, bx + d / 4, py + d / 4, d / 2, fg);
            return;
        }
        c.DrawTextCentered(bx, py, d, d, this.Label(), fg, s.FontOr(d / 2));
    }

    // ---- designer / serialization model -------------------------------------

    override string Kind() { return "Avatar"; }

    override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec text = PropSpec.Text("text", "Text");
        text.str = Text;
        ps.Add(text);
        PropSpec icon = PropSpec.Text("icon", "Icon");
        icon.str = Icon;
        ps.Add(icon);
        PropSpec size = PropSpec.Int("size", "Size");
        size.num = Size;
        ps.Add(size);
        ps.Add(PropSpec.Text("class", "Classes"));
        return ps;
    }
}
