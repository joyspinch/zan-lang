using System;
using Gui;

namespace Gui.Widget;

/// 一个下拉选项：其标签及是否被选中（多选）。
/// 用一个实体代替平行的选项/选中列表。
class SelectOption {
    string label;
    bool chosen;
    /// 表格式下拉（SelectBox.Table）里这一行除首列以外的单元格。
    /// null 表示这条只有 label —— 普通列表模式下始终如此。
    List<string> cells;
    /// 级联模式的子层级；null = 叶子。
    List<SelectOption> children;
    /// 在 SelectBox.opts 平铺列表中的下标。AddOption / AddBranch /
    /// AddChild 都会追加到 opts，级联展开链用它寻址。
    int flatIdx;
    /// 父级的平铺下标（顶层为 -1）。级联多选沿它向上修祖链的勾选态，
    /// 过滤结果拼完整路径、重开弹层自动展开选中链也靠它。
    int parentIdx;
    /// 分组标题行：只作小标题展示，不可悬停、不可选择。
    bool grp;
    /// 禁用项：可见、置灰，但不可选择。
    bool disabled;

    SelectOption(string label, bool chosen) {
        this.label = label;
        this.chosen = chosen;
        this.cells = null;
        this.children = null;
        this.flatIdx = 0 - 1;
        this.parentIdx = 0 - 1;
        this.grp = false;
        this.disabled = false;
    }

    /// 级联：给本选项挂一个子级，并回填它的平铺下标。
    void Attach(SelectOption child, int idx) {
        if (children == null) { children = new List<SelectOption>(); }
        child.flatIdx = idx;
        children.Add(child);
    }

    bool HasChildren() {
        return children != null && children.Count > 0;
    }

    /// 第 `i` 列的文本（0 为 label 列），越界返回空串。
    string Cell(int i) {
        if (i <= 0) { return label; }
        if (cells == null) { return ""; }
        int j = i - 1;
        if (j >= cells.Count) { return ""; }
        return cells[j];
    }
}

/// <summary>
/// 高层、自包含的 select / 下拉框。
///
/// 有状态（创建一次，跨帧保留）。单个 Render() 绘制
/// 触发控件和弹出层，并自持开/关、选项列表、单选或
/// 多选、可选清除按钮、尺寸和状态变体，以及
/// 选项列表较长时自滚动的弹出层（鼠标滚轮 + 滚动条 + 裁剪），
/// 因此调用处只需：
///
///   SelectBox city = new SelectBox("Pick a city", false);   // 创建一次
///   city.AddOption("London"); city.AddOption("Paris");
///
///   city.Render(app, x, y, w);                           // 每帧
///   int i = city.Selected();          // 无选中时为 -1
///   string text = city.Text();
///
/// 多选：SelectBox.Multi(hint) + IsChosen(i)。流畅配置：
///   new SelectBox(hint, false).Clearable(true).Size(SelectBox.Large())
///                         .Status(SelectBox.Error())
///
/// 绑定：`sel.data = form.color;` 将选中索引双向绑定到
/// 普通字段；`SelectBox.Bind(options, signal, hint)` 与其他控件共享 SignalInt，
/// 且 `sel.Change += h;` 在每次选择变化时触发。
/// </summary>
class SelectBox : Control {
    List<SelectOption> opts;
    int selected;
    /// 可选共享选择信号（SelectBox.Bind）。
    SignalInt model;
    /// 双向绑定的选中索引：`sel.data = form.color;`（编译器降级的
    /// Binding）。新变动的一方生效，弹出层与字段保持同步。
    Binding<int> data;
    int lastModel;
    int lastData;
    /// 选择变化时触发（`sel.Change += h;`）。
    UiEvent Change;
    /// 选项列表打开/关闭时触发，无论由哪种方式
    /// 触发（点击触发控件、选择、外部按压、Esc）。
    UiEvent Open;
    UiEvent Close;
    string hint;
    bool multi;
    bool clearable;
    bool open;
    int scrollY;
    /// 弹层滚动偏移的信号视图：内嵌 Scrollbar 直接拖它，
    /// 每帧与 `scrollY` 互相同步。
    SignalInt scrollSignal;
    /// 尺寸档：0 small / 1 medium / 2 large。Binding<int> 使
    /// 属性面板的 size 行真正写回；渲染时映射为 select.small/.large
    /// 档位 class（base.css 的 --height-* token 规则）。
    Binding<int> size;
    int status;
    int maxVisible;
    /// 弹出层位置：0 自动（触发控件下方，超出则反向），1 仅下方，2 仅上方。
    /// Naive UI `placement` prop。
    int placement;
    /// 可搜索：弹出层顶部加搜索框，键入时过滤选项（Naive UI `filterable` prop）。
    bool filterable;
    /// 当前搜索关键词。
    string filterText;
    /// 筛选搜索框：弹层顶部内嵌的真 Input 组件（不是自绘的假输入条），
    /// 焦点、光标、选区、Ctrl+A/C/X/V、清除按钮全部由 Input 自持。
    /// 打开弹层期间焦点锁定在它上面，键入才不需要先点一下搜索框。
    Input filterBox;
    /// 级联模式：选项带子级，弹层逐列展开（省市区这类层级）。
    bool cascade;
    /// 级联当前展开链：每列已展开选项的平铺下标（flatIdx）。
    List<int> cascadePath;
    /// 级联顶层选项（AddBranch 建立的那些），弹层第一列渲染它们。
    List<SelectOption> cascRoots;
    /// 级联过滤的命中下标（filterable + 关键词非空时重建）：平铺所有
    /// 层级里标签命中的节点，行上显示完整路径。
    List<int> cascadeFilter;
    /// 级联父子联动（Naive UI `cascade` prop，默认开）：勾选父级带动
    /// 全部子孙，父级的勾/半勾由子孙推导；关掉后任何层级的选项都可
    /// 独立勾选，单选下也允许直接选中带子级的分支。
    bool cascadeLink;
    /// 勾选策略（Naive UI check-strategy）：0 all 全部勾选节点、
    /// 1 parent 只算没被更深勾选祖先盖住的节点（完整勾选子树的顶）、
    /// 2 child 只算勾选的叶子。
    int checkStrategy;
    /// 触发器/标签显示完整路径（"浙江 / 杭州 / 西湖区"，
    /// Naive UI show-path）；关掉只显示末级短标签。
    bool showPath;
    /// 悬停即展开下一列（Naive UI hover-trigger）；默认点击展开。
    bool hoverExpand;
    /// 从过滤结果选中后清掉搜索词（默认清）。
    bool clearFilterAfter;
    /// 级联各列的滚动偏移（按下标取，多退少补）。
    List<int> cascadeScroll;
    /// 各列内嵌 Scrollbar 的信号视图，懒建，与 cascadeScroll 同步。
    List<SignalInt> cascadeScrollSig;
    /// 树形模式：弹层内嵌一颗真 TreeView，展开/折叠、滚动、悬停
    /// 全部由 TreeView 自持，SelectBox 只负责摆位与收值。
    bool treeMode;
    TreeView treeBox;
    /// 树形模式上次见到的选中下标（-1 无），用于每帧轮询选中变化。
    int treeSelSeen;
    /// 级联/树形选中的完整路径文本（"浙江 / 杭州"），供 Text() 显示。
    string pathText;
    /// 过滤后的选项索引列表（null = 不启用过滤）。每帧根据 filterText 重建。
    List<int> filteredIdx;
    // 每帧暂存锚点几何，使延迟弹出层（OnPaintOverlay、
    // 在覆盖阶段运行）能在触发控件下方自行布局。
    int trigX;
    int trigY;
    int trigW;
    /// 稳定控件 id：触发控件注册它，使悬停/按压/焦点（及读取它们的
    /// 缓动样式过渡）与任何其他控件一样工作。
    int wid;
    /// 上一帧实际绘制的头部高度（尊重显式 RenderIn
    /// 高度）；延迟弹出层读取它，使其正好位于触发控件下方。
    int lastH;
    /// 上一帧指针悬停的选项（无则 -1）。弹出层在覆盖阶段绘制
    /// 且未按行注册命中区域，因此没有其他机制
    /// 会请求重绘光标下那行的帧。
    int hoverRow;
    /// 悬停的选项变化时触发（`sel.Hover += h;`，用 Hovered() 读是哪一条）。
    /// 没有它，调用方就只能靠自己在弹层几何上重算一遍鼠标位置 —— 而弹层
    /// 的位置是框架翻转后决定的，外面根本算不准。
    UiEvent Hover;
    /// 弹层列数：0 = 自动（多选框选项多于一屏时分成等宽多列，
    /// 而不是拉成一条长条），否则固定列数。
    int cols;
    /// 表格式下拉的列标题；null = 普通单列列表。首列对应选项的
    /// label，其余对应 SelectOption.cells。
    List<string> headers;
    /// 各列宽度（设备像素）。与 headers 一一对应。
    List<int> colWidths;
    /// 搜索框里的提示文字（filterable）。空则用 "Search"。
    string filterHint;
    /// 弹层宽度缓存。量一次即可：逐帧测量每条标签在上万条选项时
    /// 就是每帧上万次文本测量，比真正的绘制还贵。
    int popupW;
    bool popupWDirty;

    static int Small() { return 0; }
    static int Medium() { return 1; }
    static int Large() { return 2; }

    static int Normal() { return 0; }
    static int Success() { return 1; }
    static int Warning() { return 2; }
    static int Error() { return 3; }

    /// Default design-time constructor; the form supplies `placeholder` later.
    SelectBox() : this("", false) { }

    /// 单选下拉框（多选用 `new SelectBox(hint, true)`）。
    SelectBox(string hintText) : this(hintText, false) { }

    SelectBox(string hintText, bool isMulti) {
        this.InitControl("selectbox", 0);
        this.opts = new List<SelectOption>();
        this.selected = 0 - 1;
        this.hint = hintText;
        this.multi = isMulti;
        this.clearable = false;
        this.open = false;
        this.scrollY = 0;
        this.size = 1;
        this.status = 0;
        this.maxVisible = 6;
        this.cols = 0;
        this.placement = 0;
        this.filterable = false;
        this.filterText = "";
        this.filteredIdx = null;
        this.wid = WidgetId.Next();
        this.lastH = 0;
        this.hoverRow = 0 - 1;
        this.wiresOwnEvents = true;
        this.lastModel = 0 - 1;
        this.lastData = 0 - 1;
        this.headers = null;
        this.colWidths = null;
        this.filterHint = "";
        this.cascade = false;
        this.cascadePath = null;
        this.cascRoots = null;
        this.cascadeFilter = null;
        this.cascadeLink = true;
        this.checkStrategy = 0;
        this.showPath = true;
        this.hoverExpand = false;
        this.clearFilterAfter = true;
        this.cascadeScroll = null;
        this.cascadeScrollSig = null;
        this.treeMode = false;
        this.treeBox = null;
        this.treeSelSeen = 0 - 1;
        this.pathText = "";
        this.popupW = 0;
        this.popupWDirty = true;
        this.Change = new UiEvent();
        this.Open = new UiEvent();
        this.Close = new UiEvent();
        this.Hover = new UiEvent();
    }

    /// 从普通标签列表构建选择框（JSON / 设计器 / 单行场景使用）。
    static SelectBox FromOptions(List<string> options, string hint) {
        SelectBox s = new SelectBox(hint, false);
        for (int i = 0; i < options.Count; i = i + 1) {
            s.AddOption(options[i]);
        }
        return s;
    }

    /// 共享外部 SignalInt 作为选中索引：读取同一信号的每个控件
    /// 都保持同步。
    static SelectBox Bind(List<string> options, SignalInt model, string hint) {
        SelectBox s = SelectBox.FromOptions(options, hint);
        s.model = model;
        s.selected = model.Get();
        s.lastModel = s.selected;
        return s;
    }

    /// 选项以 `a|b|c` 字符串表示（设计器 / .zform 属性往返）。
    string OptionsText() {
        string outp = "";
        for (int i = 0; i < opts.Count; i = i + 1) {
            if (i > 0) { outp = outp + "|"; }
            outp = outp + opts[i].label;
        }
        return outp;
    }

    void SetOptionsText(string text) {
        popupWDirty = true;
        opts = new List<SelectOption>();
        string current = "";
        for (int i = 0; i <= text.Length; i = i + 1) {
            string ch = "";
            if (i < text.Length) { ch = text.Substring(i, 1); }
            if (ch == "|" || i == text.Length) {
                opts.Add(new SelectOption(current, false));
                current = "";
            } else {
                current = current + ch;
            }
        }
        scrollY = 0;
    }

    /// 固定弹层列数（等宽）；0 恢复自动。选项按列优先填，
    /// 先从第一列自上而下。
    SelectBox Columns(int n) {
        if (n < 0) { n = 0; }
        cols = n;
        scrollY = 0;
        popupWDirty = true;
        return this;
    }

    /// 表格式下拉：弹层变成一张带列标题的表，每个选项占一行、
    /// 每行按 `widths` 分列。首列是选项的 label（Text() 仍然返回它），
    /// 其余列由 AddRow 提供。
    ///
    ///   SelectBox pick = new SelectBox("Pick a stock");
    ///   pick.Table(new List<string>{ "Code", "Name", "Last" },
    ///              new List<int>{ 90, 160, 90 });
    ///   pick.AddRow(new List<string>{ "600519", "Kweichow", "1712.00" });
    ///
    /// 传 null 恢复普通列表。
    SelectBox Table(List<string> titles, List<int> widths) {
        headers = titles;
        colWidths = widths;
        scrollY = 0;
        popupWDirty = true;
        return this;
    }

    bool IsTable() {
        return headers != null && colWidths != null && colWidths.Count > 0;
    }

    /// 表格式下拉的一行。`cells[0]` 是 label（首列），其余为后续列。
    void AddRow(List<string> cells) {
        if (cells == null || cells.Count == 0) { return; }
        SelectOption o = new SelectOption(cells[0], false);
        List<string> rest = new List<string>();
        for (int i = 1; i < cells.Count; i = i + 1) { rest.Add(cells[i]); }
        o.cells = rest;
        opts.Add(o);
        popupWDirty = true;
    }

    /// 表头高度（表格模式下弹层顶部占用的空间）。
    int HeaderH(App app) {
        if (!this.IsTable()) { return 0; }
        return app.Scale(26);
    }

    /// 过滤后参与显示的行数。
    int DisplayCount() {
        List<int> vis = this.VisibleOpts();
        if (vis == null) { return opts.Count; }
        return vis.Count;
    }

    /// 显示行 -> 真实选项下标。过滤开着时经过滤表转换，否则同一个数。
    /// 渲染、命中和悬停三处原本各自内联这段映射，任何一处写歪都表现为
    /// 「点中的不是看到的那条」。
    int RowToOpt(int row) {
        List<int> vis = this.VisibleOpts();
        if (vis == null) {
            if (row < 0 || row >= opts.Count) { return 0 - 1; }
            return row;
        }
        if (row < 0 || row >= vis.Count) { return 0 - 1; }
        return vis[row];
    }

    /// 悬停中的选项下标，没有则 -1（配合 `Hover` 事件读取）。
    int Hovered() { return hoverRow; }

    /// 第 `i` 个选项的标签（越界返回空串）。悬停/选择事件给出的是下标，
    /// 调用方要显示的是文字。
    string OptionLabel(int i) {
        if (i < 0 || i >= opts.Count) { return ""; }
        return opts[i].label;
    }

    /// 本次开层实际的列数。自动时：单选保持单列（下拉就该是
    /// 一条列表）；多选超过一屏时按 maxVisible 分列，最多 4 列，
    /// 这样一屏就能成行成列地看完。表格模式恒为一列（列在行内部）。
    int ColumnCount() {
        if (this.IsTable()) { return 1; }
        if (cols > 0) { return cols; }
        if (!multi) { return 1; }
        if (maxVisible <= 0) { return 1; }
        int n = (this.DisplayCount() + maxVisible - 1) / maxVisible;
        if (n < 1) { n = 1; }
        if (n > 4) { n = 4; }
        return n;
    }

    /// 当前列数下每列的行数。
    int RowCount() {
        int n = this.ColumnCount();
        int rows = (this.DisplayCount() + n - 1) / n;
        if (rows < 1) { rows = 1; }
        return rows;
    }

    int Value() { return selected; }
    bool IsOpen() { return open; }

    /// 打开/关闭列表，并在实际切换时触发 Open/Close，
    /// 使每个入口（触发控件、选择、外部按压、Esc、代码）以相同方式
    /// 报告。
    void SetOpen(bool v) {
        if (open == v) { return; }
        open = v;
        if (v) {
            scrollY = 0;
            // 级联弹层回到第一列；单选已有选中值时把它的祖先链展开，
            // 重开弹层能直接看到选中路径（多选没有单一选中，回第一列）。
            cascadePath = new List<int>();
            cascadeScroll = null;
            if (cascade && !multi && selected >= 0 && selected < opts.Count) {
                List<int> chain = new List<int>();
                int walk = opts[selected].parentIdx;
                while (walk >= 0 && walk < opts.Count && chain.Count < 3) {
                    chain.Insert(0, walk);
                    walk = opts[walk].parentIdx;
                }
                cascadePath = chain;
            }
            // 开层即一次新搜索：清掉上一次的关键词。
            if (filterable && filterBox != null) {
                filterBox.SetText("");
                filterText = "";
                this.RebuildFilter();
            }
            Open.Raise();
        }
        else { Close.Raise(); }
    }

    /// 将共享信号和双向绑定与 `selected` 协调一致。
    /// 弹出层直接写 `selected`，因此每一侧都与
    /// 上次同步值比较，发生变动的一方生效。
    void SyncBinding() {
        if (model != null) {
            int m = model.Get();
            if (m != selected) {
                if (selected != lastModel) { model.Set(selected); }
                else { selected = m; }
            }
            lastModel = selected;
        }
        if (data != null) {
            int b = data.Get();
            if (b != selected) {
                if (selected != lastData) { data.Set(selected); }
                else { selected = b; }
            }
            lastData = selected;
        }
    }

    /// 应用弹出层作出的选择：将绑定和 Change
    /// 事件集中在一处，使所有入口行为一致。
    void Choose(int idx) {
        if (idx < 0 || idx >= opts.Count) { return; }
        // 分组标题与禁用项不是可选项。
        if (opts[idx].grp || opts[idx].disabled) { return; }
        if (multi) {
            opts[idx].chosen = !opts[idx].chosen;
        } else {
            if (selected == idx) { return; }
            selected = idx;
            if (model != null) { model.Set(idx); lastModel = idx; }
            if (data != null) { data.Set(idx); lastData = idx; }
        }
        Change.Raise();
    }

    /// 级联选择模式。层级用 AddBranch / AddChild 建立，
    /// 弹层逐列展开，选中叶子时触发器显示完整路径
    /// （"浙江 / 杭州 / 西湖区"）。配合 Multi(true) 得到勾选式
    /// 多选（父子联动 + 勾选策略 + 标签芯片触发器）。
    SelectBox Cascade() {
        cascade = true;
        return this;
    }

    static int CheckAll() { return 0; }
    static int CheckParent() { return 1; }
    static int CheckChild() { return 2; }

    /// 级联父子联动（Naive UI `cascade` prop，默认开）：勾选父级带动
    /// 全部子孙；关掉后任何层级的选项独立勾选，单选下也允许直接选中
    /// 带子级的分支。
    SelectBox CascadeLink(bool v) {
        cascadeLink = v;
        return this;
    }

    /// 勾选策略：CheckAll / CheckParent / CheckChild（Naive UI
    /// check-strategy）。决定哪些勾选节点计入触发器的值集合。
    SelectBox CheckStrategy(int v) {
        if (v >= 0 && v <= 2) { checkStrategy = v; }
        return this;
    }

    /// 触发器是否显示完整路径；false 只显示末级短标签
    /// （Naive UI show-path）。
    SelectBox ShowPath(bool v) {
        showPath = v;
        return this;
    }

    /// 悬停即展开下一列（Naive UI hover-trigger）；默认点击展开。
    SelectBox HoverExpand(bool v) {
        hoverExpand = v;
        return this;
    }

    /// 从过滤结果里选中后是否清掉搜索词（Naive UI
    /// clear-filter-after-select，默认清）。
    SelectBox ClearFilterAfter(bool v) {
        clearFilterAfter = v;
        return this;
    }

    /// 加一个顶层分支（级联第一列的条目），返回它的平铺下标
    /// （继续 AddChild 时作父下标用）。
    int AddBranch(string label) {
        SelectOption o = new SelectOption(label, false);
        o.flatIdx = opts.Count;
        opts.Add(o);
        if (cascRoots == null) { cascRoots = new List<SelectOption>(); }
        cascRoots.Add(o);
        popupWDirty = true;
        return o.flatIdx;
    }

    /// 给第 `parent` 个选项挂一个子级（父下标是 AddBranch /
    /// AddChild 的返回值），返回子级的平铺下标。挂在同一父级
    /// 下的子级按插入顺序排成一列。
    int AddChild(int parent, string label) {
        if (parent < 0 || parent >= opts.Count) { return 0 - 1; }
        SelectOption o = new SelectOption(label, false);
        o.flatIdx = opts.Count;
        o.parentIdx = parent;
        opts.Add(o);
        opts[parent].Attach(o, o.flatIdx);
        popupWDirty = true;
        return o.flatIdx;
    }

    /// 树形选择模式：弹层内嵌一颗真 TreeView。层级用
    /// TreeNode.Dir / TreeNode.File 构建，经 TreeNodes 绑定；
    /// 叶节点被选中时触发器显示它的 payload（未设则 label）。
    /// 树的展开、滚动、悬停全部是 TreeView 自己的行为。
    SelectBox Tree() {
        treeMode = true;
        treeBox = new TreeView();
        treeSelSeen = 0 - 1;
        return this;
    }

    /// 绑定树节点（调用方的列表，TreeView.Bind 不复制）。
    SelectBox TreeNodes(List<TreeNode> nodes) {
        if (treeBox == null) { this.Tree(); }
        treeBox.Bind(nodes);
        return this;
    }

    static SelectBox Multi(string hintText) {
        return new SelectBox(hintText, true);
    }

    void AddOption(string label) {
        opts.Add(new SelectOption(label, false));
        popupWDirty = true;
    }

    /// 加一个禁用项：占正常位置、置灰显示，但不响应悬停与点击。
    void AddOption(string label, bool disabled) {
        SelectOption o = new SelectOption(label, false);
        o.flatIdx = opts.Count;
        o.disabled = disabled;
        opts.Add(o);
        popupWDirty = true;
    }

    /// 加一个分组标题：随后 AddOption 的条目在视觉上归属该组。
    /// 标题行本身不可悬停、不可选择；键入筛选时若组内没有命中
    /// 项，标题随组一起隐藏。
    void AddGroup(string title) {
        SelectOption o = new SelectOption(title, false);
        o.flatIdx = opts.Count;
        o.grp = true;
        opts.Add(o);
        popupWDirty = true;
    }

    SelectBox Clearable(bool v) {
        clearable = v;
        return this;
    }

    SelectBox Size(int v) {
        size.Set(v);
        return this;
    }

    SelectBox Status(int v) {
        status = v;
        return this;
    }

    /// 弹出位置：0=自动（默认），1=下方（Naive UI placement="bottom"），2=上方。
    SelectBox Placement(int v) {
        if (v >= 0 && v <= 2) { placement = v; }
        return this;
    }

    /// 启用搜索过滤（Naive UI filterable）。
    SelectBox Filterable(bool v) {
        filterable = v;
        if (v) { filterText = ""; }
        return this;
    }

    /// 搜索框的提示文字。不设则用 "Search"。
    SelectBox FilterHint(string s) {
        filterHint = s;
        if (filterBox != null) { filterBox.SetHint(s); }
        return this;
    }

    /// 当前搜索关键词（供调用方回显 / 远程搜索用）。
    string FilterText() { return filterText; }

    /// 以编程方式设置关键词并重建过滤结果。
    void SetFilterText(string s) {
        filterText = s;
        if (filterBox != null) { filterBox.SetText(s); }
        scrollY = 0;
        this.RebuildFilter();
    }

    /// 根据 filterText 重建过滤索引列表（空文本/未启用 → 全量）。
    /// 级联模式下平铺所有层级、按标签匹配（行上显示完整路径）；
    /// 表格模式匹配整行的所有单元格，否则只匹配 label：一张表里
    /// 按代码搜和按名称搜同样自然，只认首列会让另一半列形同虚设。
    void RebuildFilter() {
        popupWDirty = true;
        if (!filterable || filterText == "") {
            filteredIdx = null;
            cascadeFilter = null;
            return;
        }
        List<int> r = new List<int>();
        string q = filterText.ToLower();
        if (cascade) {
            // 级联过滤：所有层级的节点都参与匹配，命中项平铺单列展示，
            // 行文本是完整路径。分组标题不参与。
            for (int i = 0; i < opts.Count; i = i + 1) {
                if (opts[i].grp) { continue; }
                if (opts[i].label.ToLower().Contains(q)) { r.Add(i); }
            }
            cascadeFilter = r;
            cascadeScroll = null;
            return;
        }
        bool tbl = this.IsTable();
        // 分组标题不参与匹配：只有当它后面（到下一个标题前）有
        // 命中项时才保留，孤立的标题随组一起隐藏。
        int pendingGrp = 0 - 1;
        for (int i = 0; i < opts.Count; i = i + 1) {
            if (opts[i].grp) { pendingGrp = i; continue; }
            bool hit = opts[i].label.ToLower().Contains(q);
            if (!hit && tbl) {
                for (int j = 1; j < colWidths.Count; j = j + 1) {
                    if (opts[i].Cell(j).ToLower().Contains(q)) { hit = true; break; }
                }
            }
            if (hit) {
                if (pendingGrp >= 0) { r.Add(pendingGrp); pendingGrp = 0 - 1; }
                r.Add(i);
            }
        }
        filteredIdx = r;
    }

    int Selected() {
        return selected;
    }

    bool IsChosen(int i) {
        if (i < 0 || i >= opts.Count) { return false; }
        return opts[i].chosen;
    }

    bool HasValue() {
        if (multi) {
            for (int i = 0; i < opts.Count; i = i + 1) {
                if (opts[i].chosen) { return true; }
            }
            return false;
        }
        if (pathText != "") { return true; }
        return selected >= 0 && selected < opts.Count;
    }

    /// 以编程方式设置选中索引（-1 清除）。保持绑定的
    /// model/data 同步，但不触发 Change（调用方发起的更新）。
    void Select(int idx) {
        if (idx < 0) { selected = 0 - 1; return; }
        if (idx >= opts.Count) { return; }
        selected = idx;
        if (model != null) { model.Set(idx); lastModel = idx; }
        if (data != null) { data.Set(idx); lastData = idx; }
    }

    void Clear() {
        selected = 0 - 1;
        pathText = "";
        treeSelSeen = 0 - 1;
        cascadeScroll = null;
        if (treeBox != null) { treeBox.ClearSelection(); }
        for (int i = 0; i < opts.Count; i = i + 1) {
            opts[i].chosen = false;
        }
    }

    /// 清空选项集（连同过滤结果与宽度缓存）。远程搜索每次换一批
    /// 候选项时需要它。
    void ClearOptions() {
        opts = new List<SelectOption>();
        selected = 0 - 1;
        scrollY = 0;
        filteredIdx = null;
        popupWDirty = true;
    }

    int Count() { return opts.Count; }

    string Text() {
        if (multi) {
            // 级联多选：按勾选策略取值集合，显示路径或短标签。
            if (cascade) {
                List<string> labs = this.ValueLabels();
                string acc = "";
                for (int i = 0; i < labs.Count; i = i + 1) {
                    if (i > 0) { acc = acc + ", "; }
                    acc = acc + labs[i];
                }
                return acc;
            }
            string acc = "";
            for (int i = 0; i < opts.Count; i = i + 1) {
                if (opts[i].chosen) {
                    if (acc != "") { acc = acc + ", "; }
                    acc = acc + opts[i].label;
                }
            }
            return acc;
        }
        // 级联按当前 showPath 动态出路径/短标签（选择后切换设置也
        // 立即生效）；树形仍用收值时缓存的 payload 文本。
        if (cascade) {
            if (selected >= 0 && selected < opts.Count) {
                return this.ValueText(selected);
            }
            return pathText;
        }
        if (pathText != "") { return pathText; }
        if (selected >= 0 && selected < opts.Count) { return opts[selected].label; }
        return "";
    }

    int HeadHeight(Theme t) {
        int sz = this.SizeIdx();
        if (sz == 0) { return t.heightSmall; }
        if (sz == 2) { return t.heightLarge; }
        return t.heightMedium;
    }

    int FontSize(App app, StyleBox s) {
        int sz = this.SizeIdx();
        if (sz == 0) { return s.FontOr(Style.FontFallback(app, "small")); }
        if (sz == 2) { return s.FontOr(Style.FontFallback(app, "large")); }
        return s.FontOr(Style.FontFallback(app, "medium"));
    }

    int SizeIdx() {
        if (size == null) { return 1; }
        return size.Get();
    }

    /// 校验状态以额外 class 的形式进入样式层（base.css 的
    /// `select.success/.warning/.error` 规则），绘制代码不再直接
    /// 覆盖边框颜色。
    string StyleClass() {
        string extra = "";
        if (status == 1) { extra = "success"; }
        if (status == 2) { extra = "warning"; }
        if (status == 3) { extra = "error"; }
        string sz = "";
        int idx = this.SizeIdx();
        if (idx == 0) { sz = "small"; }
        else if (idx == 2) { sz = "large"; }
        if (sz != "") {
            if (extra == "") { extra = sz; } else { extra = extra + " " + sz; }
        }
        if (extra == "") { return Class; }
        if (Class == "") { return extra; }
        return Class + " " + extra;
    }

    override string Kind() { return "Select"; }

    override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec ph = PropSpec.Text("hint", "Placeholder");
        ph.str = hint;
        ph.Also("placeholder");
        ps.Add(ph);
        ps.Add(PropSpec.Text("options", "Options"));
        PropSpec sel = PropSpec.Int("value", "Selected");
        sel.num = selected;
        sel.Also("selected");
        ps.Add(sel);
        PropSpec clr = PropSpec.Bool("clearable", "Clearable");
        clr.flag = clearable;
        ps.Add(clr);
        PropSpec szp = PropSpec.Enum("size", "Size",
            new List<string>{ "tiny", "small", "medium", "large" });
        szp.num = size;
        ps.Add(szp);
        PropSpec pl = PropSpec.Enum("placement", "Placement",
            new List<string>{ "auto", "bottom", "top" });
        pl.num = placement;
        ps.Add(pl);
        PropSpec flt = PropSpec.Bool("filterable", "Filterable");
        flt.flag = filterable;
        ps.Add(flt);
        PropSpec sp = PropSpec.Bool("showPath", "ShowPath");
        sp.flag = showPath;
        ps.Add(sp);
        PropSpec cs = PropSpec.Enum("checkStrategy", "CheckStrategy",
            new List<string>{ "all", "parent", "child" });
        cs.num = checkStrategy;
        ps.Add(cs);
        PropSpec he = PropSpec.Bool("hoverExpand", "HoverExpand");
        he.flag = hoverExpand;
        ps.Add(he);
        return ps;
    }

    /// 选项列表为文本，每项一个 `label|value` 对。
    override string GetExtra(string key) {
        if (key == "options") { return this.OptionsText(); }
        return "";
    }

    override bool SetExtra(string key, string val) {
        if (key != "options") { return false; }
        this.SetOptionsText(val);
        return true;
    }

    override List<string> Events() {
        List<string> e = Control.CommonEvents();
        e.Add("Change");
        e.Add("SelectionChanged");
        e.Add("Open");
        e.Add("Close");
        e.Add("Hover");
        return e;
    }

    override void BindEvent(string evt, Action a) {
        if (evt == "Change" || evt == "SelectionChanged") { Change.Add(a); return; }
        if (evt == "Open") { Open.Add(a); return; }
        if (evt == "Close") { Close.Add(a); return; }
        if (evt == "Hover") { Hover.Add(a); return; }
        On.AddByName(evt, a);
    }

    override void OnMeasure(App app) {
        StyleBox s = this.ResolveStyleAs(app, "select", Class, Style.SNormal());
        prefH = s.HeightOr(this.HeadHeight(app.theme));
        prefW = s.WidthOr(app.Scale(200));
    }

    override void OnPaint(App app) {
        this.RenderIn(app, bx, by, bw, bh);
    }

    /// 以自然（样式/尺寸）高度绘制触发控件。
    void Render(App app, int x, int y, int w) {
        this.RenderIn(app, x, y, w, 0);
    }

    /// 在显式盒子内绘制触发控件；`hIn` 为 0 时高度取自
    /// 解析出的样式/尺寸变体，其他值优先生效，使工具栏一行
    /// 的 select、按钮和输入框共享同一高度。
    void RenderIn(App app, int x, int y, int w, int hIn) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        this.SyncBinding();

        string cls = this.StyleClass();
        int h = this.HeadHeight(t);
        if (hIn > 0) { h = hIn; }
        StyleBox s = this.ResolveEasedStyleAsIn(
            app, wid, "select", cls, false, open, x, y, w, h);
        h = s.HeightOr(h);
        this.lastH = h;
        int fs = this.FontSize(app, s);
        app.focus.RegisterFocusable(wid);
        app.hitTester.RegisterRect(wid, x, y, w, h, 1);

        int ek = app.EventKind();
        int eb = app.window.EventButton();
        // 触发器按几何判断悬停/点击，因此必须问过弹层：直接读
        // 原始事件时，画在它上面的下拉/菜单/模态的点击会一路
        // 穿透下来，把这个选择框也打开。
        bool leftUp = app.ClickAvailable() && eb == 0;

        bool overHead = Ui.Over(app, x, y, w, h);

        // 有值时的清除按钮几何（箭头左侧）。
        int partState = Style.StateOf(app, wid, false);
        if (open) { partState = partState + Style.SSelected(); }
        StyleBox arrowStyle = this.ResolvePartAs(app, "select", "arrow", "",
                                                 cls, partState);
        StyleBox clearStyle = this.ResolvePartAs(app, "select", "clear", "",
                                                 cls, partState);
        int arrowSize = arrowStyle.FontOr(t.iconSizeSmall);
        int arrowSlot = arrowStyle.WidthOr(t.paddingLarge + arrowSize);
        int clearSize = clearStyle.FontOr(t.iconSizeSmall);
        int clearX = x + w - arrowSlot - clearSize - t.paddingSmall;
        bool showClear = clearable && this.HasValue() && overHead;
        bool overClear = showClear && app.mouseX >= clearX
            && app.mouseX < clearX + clearSize;

        // ---- 触发控件 ----
        // 从样式层解析为 `select` 控件，使皮肤
        // 像 input 一样为其设置样式（`select:hover`、`select:focus` 等）；
        // 校验状态通过 StyleClass 的额外 class 在 CSS 中着色。
        int pad = s.PadLOr(t.paddingSmall);
        s.Paint(app, x, y, w, h);

        int textY = Canvas.CenterTextY(y, h, fs);
        int headMaxW = w - pad - arrowSlot - t.paddingSmall;
        if (showClear) { headMaxW = headMaxW - clearSize - t.paddingSmall; }
        string shown = this.Text();
        StyleBox placeholderStyle = this.ResolvePartAs(app, "select", "placeholder", "",
                                                        cls, partState);
        if (multi && cascade && shown != "") {
            // 级联多选：勾选值渲染成标签芯片（× 可单独移除，
            // 放不下折叠 +N），而不是一长串逗号文本。
            this.DrawCascadeTags(app, c, t, cls, partState, x, y, w, h,
                                 pad, arrowSlot, showClear, clearSize, fs,
                                 leftUp);
        } else if (shown == "") {
            int hintFs = placeholderStyle.FontOr(fs);
            int hintY = Canvas.CenterTextY(y, h, hintFs);
            c.DrawText(x + pad, hintY,
                Ellipsis.Fit(hint, headMaxW, hintFs),
                placeholderStyle.FgOr(s.fg), hintFs);
        } else {
            c.DrawText(x + pad, textY,
                Ellipsis.Fit(shown, headMaxW, fs), s.fg, fs);
        }

        if (showClear) {
            int clearState = Style.SNormal();
            if (open) { clearState = clearState + Style.SSelected(); }
            if (app.focus.IsFocused(wid)) { clearState = clearState + Style.SFocus(); }
            if (overClear) { clearState = clearState + Style.SHover(); }
            if (overClear && app.focus.IsPressed(wid)) {
                clearState = clearState + Style.SActive();
            }
            clearStyle = this.ResolvePartAs(app, "select", "clear", "",
                                            cls, clearState);
            c.DrawGlyphIn("close", clearX, y, clearSize, h,
                clearSize, clearStyle.FgOr(s.fg));
        }
        c.DrawGlyphIn("chevron-down", x + w - arrowSlot, y,
            arrowSlot, h, arrowSize, arrowStyle.FgOr(s.fg));

        // ---- 触发控件输入（仅关闭状态） ----
        // 弹出层自身的点击（选择选项 / 外部关闭）在
        // OnPaintOverlay 中处理，使其在覆盖阶段解析于内容之上。
        // 芯片 × 移除值的点击已在 DrawCascadeTags 里认领，跳过。
        if (leftUp && !open && !app.ClickClaimed()) {
            if (overClear) {
                this.Clear();
                app.RequestRedraw();
            } else if (overHead) {
                this.SetOpen(true);
                // 认领打开时的点击，使刚显示的弹出层不会把
                // 它当作外部按压而在同一帧立即关闭。
                app.ClaimClick();
                app.RequestRedraw();
            }
        }
        On.Fire(app, wid);

        // 将选项列表推迟到覆盖阶段：随后它绘制在所有
        // 在此控件之后绘制的控件（无遮挡），并注册最顶层
        // 命中区域（不穿透点击）。参见 OnPaintOverlay。
        trigX = x;
        trigY = y;
        trigW = w;
        if (open) {
            app.AddOverlay(OverlayPopup.Host(this));
        }
    }

    /// 弹层宽度：不窄于触发器，但至少能放下最长的一条；
    /// 多列时按列数等宽扩开。按触发器宽度开弹层会把每一条
    /// 都截成同一个前缀，选项之间看不出区别。
    ///
    /// 结果缓存在 popupW 里，只有选项集或过滤词变了才重新量：这段
    /// 要遍历全部标签，而它每帧都被调用一次。一万条选项时那是每帧
    /// 一万次 MeasureText —— 比画出来的十几行本身贵上三个数量级，
    /// 也是长列表下拉「一开就卡」的真正来源（虚表只省了绘制）。
    int PopupWidth(App app, Theme t, int trigWidth, int fs, int arrowSlot) {
        if (this.IsTable()) {
            int sum = t.paddingSmall * 2;
            for (int i = 0; i < colWidths.Count; i = i + 1) {
                sum = sum + colWidths[i];
            }
            if (sum < trigWidth) { sum = trigWidth; }
            int roomT = app.canvas.Width() - app.Scale(8);
            if (sum > roomT) { sum = roomT; }
            return sum;
        }
        if (!popupWDirty && popupW > 0) {
            int w0 = popupW;
            if (w0 < trigWidth) { w0 = trigWidth; }
            return w0;
        }
        int n = this.ColumnCount();
        int colW = trigWidth / n;
        int chrome = t.paddingSmall * 2 + arrowSlot;
        for (int i = 0; i < opts.Count; i = i + 1) {
            int tw = Canvas.MeasureText(opts[i].label, fs) + chrome;
            if (tw > colW) { colW = tw; }
        }
        int w = colW * n;
        if (w < trigWidth) { w = trigWidth; }
        int room = app.canvas.Width() - app.Scale(8);
        if (w > room) { w = room; }
        popupW = w;
        popupWDirty = false;
        return w;
    }

    /// 搜索框高度（filterable=true 时占用的顶部空间）。
    int FilterBarH(App app) {
        if (!filterable) { return 0; }
        return app.Scale(32);
    }

    /// 过滤后参与渲染的选项索引（filterable + 关键词非空才过滤）。
    List<int> VisibleOpts() {
        if (!filterable || filterText == "") { return null; }
        if (filteredIdx == null) { this.RebuildFilter(); }
        if (filteredIdx == null) { return null; }
        return filteredIdx;
    }

    /// 延迟弹层：在 App.RunOverlays 中、所有内容绘制完成后绘制并派发事件。
    override void OnPaintOverlay(App app) {
        if (!open) { return; }
        // 基线：此刻 regions 里只有内容帧的区域。随后注册的 blocker
        // 与弹层内部控件（内嵌滚动条/搜索框）都落在它之后——
        // 「释放点是否落在弹层内部控件上」只在基线之后找，
        // 否则弹层正下方的内容控件会被误判，吞掉选项点击。
        int overlayBase = app.hitTester.RegionCount();
        Canvas c = app.canvas;
        Theme t = app.theme;

        int x = trigX;
        int y = trigY;
        int w = trigW;
        int h = this.lastH;
        if (h <= 0) { h = computedStyle.HeightOr(this.HeadHeight(t)); }
        int fs = this.FontSize(app, computedStyle);
        int optH = h;
        StyleBox arrowStyle = this.ResolvePartAs(app, "select", "arrow", "",
                                                 Class, Style.SSelected());
        int arrowSlot = arrowStyle.WidthOr(t.paddingLarge + t.iconSizeSmall);

        // 级联/树形是独立的弹层形态：不走平铺列表的虚表/分列/
        // 过滤机制，在各自的覆盖绘制里自持。
        if (this.cascade) {
            this.CascadeOverlay(app, x, y, w, h, fs, arrowSlot);
            return;
        }
        if (this.treeMode) {
            this.TreeOverlay(app, x, y, w, h);
            return;
        }

        int ek = app.EventKind();

        // 过滤开着时 ColumnCount/RowCount 已按过滤后的条数算，
        // 不需要再单独把行列数清零重排一遍。
        int nCols = this.ColumnCount();
        int nRows = this.RowCount();
        if (filterable && filterText != "") { nCols = 1; nRows = this.DisplayCount(); }
        int visRows = nRows;
        if (visRows > maxVisible) { visRows = maxVisible; }
        int fbH = this.FilterBarH(app);
        int hdH = this.HeaderH(app);
        // 搜索框是弹层顶部的一块真输入框样式（与 input 同族 token），
        // 四周留外间距，不与弹层边缘粘连。
        int sbMargin = app.Scale(8);
        int sbChrome = hdH;
        if (filterable && fbH > 0) { sbChrome = hdH + fbH + sbMargin * 2; }
        int viewH = OverlayPopup.FitH(app, visRows * optH + sbChrome);
        int contentH = nRows * optH;
        // 由框架放置，保证列表不超出窗口：
        // 靠近底部边缘时向上翻转，而不是
        // 掉落到窗口末尾内容之下。
        w = this.PopupWidth(app, t, w, fs, arrowSlot);
        int popX = OverlayPopup.FitX(app, x, w);
        int popY = OverlayPopup.FitY(app, y + h + app.Scale(4), h, viewH);

        // ---- filterable 搜索框处理 ----
        bool overSearch = false;
        int searchBarX = popX + sbMargin;
        int searchBarY = popY + sbMargin;
        int searchBarW = w - sbMargin * 2;
        int searchBarH = fbH;
        if (filterable && searchBarH > 0) {
            overSearch = app.mouseX >= searchBarX
                && app.mouseX < searchBarX + searchBarW
                && app.mouseY >= searchBarY
                && app.mouseY < searchBarY + searchBarH;
        }

        // 弹层内容区（选项列表）Y 起始：搜索框与表头下方。
        int listTop = popY;
        if (filterable && searchBarH > 0) {
            listTop = searchBarY + searchBarH + sbMargin;
        }
        int headerY = listTop;
        int listY = headerY + hdH;
        int listH = popY + viewH - listY;
        if (listH < 0) { listH = 0; }
        bool overPopup = app.mouseX >= popX && app.mouseX < popX + w
            && app.mouseY >= popY && app.mouseY < popY + viewH;

        // 选项由几何驱动：它们不注册命中 id，因此
        // 在弹层内移动不会改变悬停 id，也不会调度新帧；只有悬停行
        // 真的变了才重绘（每一个鼠标移动事件都重绘一整帧，只要
        // 弹层开着就是持续满载）。
        int colW = w;
        if (nCols > 1) { colW = w / nCols; }
        if (colW < 1) { colW = 1; }
        int over = 0 - 1;
        if (overPopup && !overSearch && app.mouseY >= listY) {
            int row = (app.mouseY - listY + scrollY) / optH;
            int col = (app.mouseX - popX) / colW;
            if (col >= nCols) { col = nCols - 1; }
            if (col < 0) { col = 0; }
                if (row >= 0 && row < nRows) {
                    over = this.RowToOpt(col * nRows + row);
                    // 标题行与禁用项不可悬停：不高亮，也不报 Hover。
                    if (over >= 0 && (opts[over].grp || opts[over].disabled)) {
                        over = 0 - 1;
                    }
                }
        }
        if (over != hoverRow) {
            hoverRow = over;
            // 悬停变化对外是一个事件，而不是只让本控件换个底色：
            // 详情面板 / 联动预览这类需求要的正是「现在指着哪一条」。
            Hover.Raise();
            app.RequestRedraw();
        }

        int maxScroll = contentH - listH;
        if (maxScroll < 0) { maxScroll = 0; }
        if (overPopup && !overSearch) {
            bool ownsWheel = app.CaptureWheel(popX, listY, w, listH);
            if (ownsWheel && ek == 13) {
                int d = app.window.EventKeyCode();
                scrollY = scrollY - d * app.scrollSpeed / 120;
                app.RequestRedraw();
            }
        }
        if (scrollY > maxScroll) { scrollY = maxScroll; }
        if (scrollY < 0) { scrollY = 0; }

        app.BlockHitsBelow();
        StyleBox pop = this.ResolvePartAs(app, "select", "popup", "popup",
                                          Class, Style.SSelected());
        pop.Paint(app, popX, popY, w, viewH);
        app.BlockHitsRect(popX, popY, w, viewH);

        // ---- 搜索框渲染（filterable）----
        // 弹层顶部内嵌一颗真 Input 组件：字段底/边框/焦点环、光标、
        // 选区、Ctrl+A/C/X/V、Backspace、清除按钮全部由 Input 自持，
        // SelectBox 只负责摆位与收成关键词。焦点在弹层打开期间锁定
        // 在它上面——展开即可键入，不必先点一下搜索框。
        if (filterable && searchBarH > 0) {
            if (filterBox == null) {
                string bh = filterHint;
                if (bh == "") { bh = "Search"; }
                filterBox = new Input(bh);
                filterBox.Clearable = true;
            }
            if (!app.focus.IsFocused(filterBox.WidgetId())) {
                app.focus.SetFocused(filterBox.WidgetId());
            }
            filterBox.Render(app, searchBarX, searchBarY, searchBarW, searchBarH);
            string live = filterBox.GetText();
            if (live != filterText) {
                filterText = live;
                scrollY = 0;
                this.RebuildFilter();
                app.RequestRedraw();
            }
        }

        // ---- 表头（表格模式）----
        if (hdH > 0) {
            StyleBox hdStyle = this.ResolvePartAs(app, "select", "header", "",
                                                  Class, Style.SNormal());
            hdStyle.Paint(app, popX, headerY, w, hdH);
            int hdFs = hdStyle.FontOr(fs);
            int hdPad = hdStyle.PadLOr(t.paddingSmall);
            int cx = popX + hdPad;
            for (int ci = 0; ci < colWidths.Count; ci = ci + 1) {
                string title = "";
                if (ci < headers.Count) { title = headers[ci]; }
                c.DrawText(cx, Canvas.CenterTextY(headerY, hdH, hdFs),
                    Ellipsis.Fit(title, colWidths[ci] - app.Scale(6), hdFs),
                    hdStyle.FgOr(pop.fg), hdFs);
                cx = cx + colWidths[ci];
            }
        }

        // ---- 选项列表渲染 ----
        // 虚表：只走视口里的那几行。原来的循环每帧遍历全部选项，一万条
        // 就是一万次迭代 + 一万次 Ellipsis.Fit（每次都要测文本），而屏幕上
        // 只放得下十几行 —— 行数一多，弹层开着就等于持续满载。
        c.PushClip(popX, listY, w, listH);
        int firstRow = scrollY / optH;
        if (firstRow < 0) { firstRow = 0; }
        int lastRow = (scrollY + listH) / optH + 1;
        if (lastRow > nRows) { lastRow = nRows; }
        for (int oCol = 0; oCol < nCols; oCol = oCol + 1) {
            for (int oRow = firstRow; oRow < lastRow; oRow = oRow + 1) {
                int realIdx = this.RowToOpt(oCol * nRows + oRow);
                if (realIdx < 0) { continue; }
                int ox = popX + oCol * colW;
                int oy = listY + oRow * optH - scrollY;
                bool overRow = realIdx == hoverRow;
                bool isSel = false;
                if (multi) { isSel = opts[realIdx].chosen; }
                else { isSel = realIdx == selected; }
                bool isGrp = opts[realIdx].grp;
                bool isOff = opts[realIdx].disabled;

                // 标题行与禁用项不吃悬停/选中态：标题走小号次级色，
                // 禁用项走 :disabled 置灰。
                int st = Style.SNormal();
                if (isGrp || isOff) {
                    st = Style.SDisabled();
                } else {
                    if (overRow) { st = st + Style.SHover(); }
                    if (isSel) { st = st + Style.SSelected(); }
                }
                StyleBox row = this.ResolvePartAs(app, "select", "option", "option",
                                                   Class, st);
                row.Paint(app, ox + 1, oy, colW - 2, optH);
                int rowFs = row.FontOr(fs);
                int rowPad = row.PadLOr(t.paddingSmall);
                if (isGrp) {
                    StyleBox grpStyle = this.ResolvePartAs(app, "select", "group",
                                                          "", Class, Style.SNormal());
                    c.DrawText(ox + t.paddingSmall,
                        Canvas.CenterTextY(oy, optH, rowFs),
                        Ellipsis.Fit(opts[realIdx].label,
                                     colW - t.paddingSmall * 2, rowFs),
                        grpStyle.FgOr(row.fg), grpStyle.FontOr(rowFs));
                    continue;
                }
                if (this.IsTable()) {
                    // 一行按列宽切开，每格自己收省略号 —— 列因此是对齐的，
                    // 而不是把整行拼成一个长字符串再统一截断。
                    int cellX = ox + rowPad;
                    for (int ci = 0; ci < colWidths.Count; ci = ci + 1) {
                        c.DrawText(cellX, Canvas.CenterTextY(oy, optH, rowFs),
                            Ellipsis.Fit(opts[realIdx].Cell(ci),
                                         colWidths[ci] - app.Scale(6), rowFs),
                            row.fg, rowFs);
                        cellX = cellX + colWidths[ci];
                    }
                } else {
                    int oMaxW = colW - rowPad - arrowSlot - t.paddingSmall;
                    c.DrawText(ox + rowPad,
                        Canvas.CenterTextY(oy, optH, rowFs),
                        Ellipsis.Fit(opts[realIdx].label, oMaxW, rowFs),
                        row.fg, rowFs);
                }
                if (isSel) {
                    StyleBox checkStyle = this.ResolvePartAs(app, "select", "checkmark", "",
                                                              Class, st);
                    int checkSize = checkStyle.FontOr(t.iconSizeSmall);
                    c.DrawGlyphIn("check", ox + colW - arrowSlot, oy,
                        arrowSlot, optH, checkSize,
                        checkStyle.FgOr(checkStyle.AccentOr(row.accent)));
                }
            }
        }
        c.PopClip();

        // 弹层滚动条：内嵌真 Scrollbar 组件，拖滑块与点轨道跳转
        // 由它自持。原先这里是一只手绘 thumb，只摆样子 —— 20000 项
        // 的虚拟列表除了滚轮无路可走。scrollY 与信号每帧互同步，
        // 拖动写出的一帧内滞后由 RequestRedraw 在下一帧收敛。
        if (contentH > listH && listH > 0) {
            if (scrollSignal == null) { scrollSignal = new SignalInt(scrollY); }
            scrollSignal.Set(scrollY);
            Scrollbar.RenderVerticalScroll(app, popX + w - app.Scale(12),
                listY, listH, listH, contentH, scrollSignal);
            int sbScroll = scrollSignal.Get();
            if (sbScroll > maxScroll) { sbScroll = maxScroll; }
            if (sbScroll < 0) { sbScroll = 0; }
            if (sbScroll != scrollY) {
                scrollY = sbScroll;
                app.RequestRedraw();
            }
        }

        // ---- 弹层输入处理 ----
        if (app.ClickAvailable()) {
            if (overSearch) {
                // 搜索框区域点击不关闭弹层（输入由内嵌 Input 处理）。
            } else if (overPopup && app.mouseY >= listY) {
                // 释放点落在弹层内已注册的控件（内嵌 Scrollbar 的
                // 滑块/轨道）上时交给它 —— 拖滑块收尾的那一下
                // 不能当成行选择，误选鼠标正好压住的行。只在弹层
                // 基线之后找：基线之前是内容帧的区域，弹层盖住的
                // 滑杆/输入框会在那里，按整帧找会把选项点击整个吞掉。
                if (app.hitTester.HitTestFrom(app.mouseX, app.mouseY,
                                              overlayBase) != 0 - 1) {
                    app.ClaimClick();
                } else {
                    int rel = app.mouseY - listY + scrollY;
                    int col = (app.mouseX - popX) / colW;
                    if (col >= nCols) { col = nCols - 1; }
                    if (col < 0) { col = 0; }
                    int rowHit = rel / optH;
                    int realIdx = 0 - 1;
                    if (rowHit >= 0 && rowHit < nRows) {
                        realIdx = this.RowToOpt(col * nRows + rowHit);
                    }
                if (realIdx >= 0 && realIdx < opts.Count
                    && !opts[realIdx].grp && !opts[realIdx].disabled) {
                    this.Choose(realIdx);
                    if (!multi) { this.SetOpen(false); }
                    app.ClaimClick();
                    app.RequestRedraw();
                }
                }
            } else {
                // 点击弹层外部任意位置（含触发器）即关闭。
                this.SetOpen(false);
                app.RequestRedraw();
            }
        }
        if (ek == 4 && app.window.EventKeyCode() == 27) {
            this.SetOpen(false);
            app.RequestRedraw();
        }
    }

    /// 级联/树形弹层共用的收尾手势：点击弹层外部（含触发器）
    /// 关闭；弹层内没被任何子控件认领的点击在这里吃掉，不能
    /// 落到弹层下面的内容上；Esc 关闭。须在弹层内容处理完
    /// 点击之后调用。
    void OverlayDismiss(App app, int popX, int popY, int w, int viewH, int ek) {
        if (app.ClickAvailable()) {
            bool inside = app.mouseX >= popX && app.mouseX < popX + w
                && app.mouseY >= popY && app.mouseY < popY + viewH;
            if (!inside) { this.SetOpen(false); }
            app.RequestRedraw();
            return;
        }
        if (ek == 4 && app.window.EventKeyCode() == 27) {
            this.SetOpen(false);
            app.RequestRedraw();
        }
    }

    /// 级联弹层：一列一级。点中带子级的选项在其右侧展开下一列
    /// （HoverExpand 时悬停即展开），叶子（联动关闭时的任意层级）
    /// 选中收值；多选渲染行首勾选框，勾/半勾沿父子推导。每列自带
    /// 滚动（滚轮 + 内嵌真 Scrollbar）；filterable 时顶部搜索条，
    /// 命中项平铺单列、行文本是完整路径。列宽固定、弹层向右生长，
    /// 最多同时 4 列。
    void CascadeOverlay(App app, int x, int y, int w, int h, int fs,
                        int arrowSlot) {
        // 同 OnPaintOverlay：基线之后注册的才是弹层内部控件。
        int overlayBase = app.hitTester.RegionCount();
        Canvas c = app.canvas;
        Theme t = app.theme;
        if (cascRoots == null || cascRoots.Count == 0) { return; }
        if (cascadePath == null) { cascadePath = new List<int>(); }
        int ek = app.EventKind();
        int optH = h;
        int visRows = maxVisible;
        if (visRows < 4) { visRows = 4; }
        // 过滤开启时顶部留出搜索条；行区在它下面。
        int fbH = this.FilterBarH(app);
        int sbMargin = app.Scale(8);
        int chrome = 0;
        if (filterable && fbH > 0) { chrome = fbH + sbMargin * 2; }
        int viewH = OverlayPopup.FitH(app, visRows * optH + chrome);
        int rowsY = 0;
        int rowsH = viewH - chrome;

        // 过滤态：命中项平铺单列，行文本是完整路径。
        bool filtering = filterable && filterText != "";
        List<int> flat = null;
        if (filtering) {
            if (cascadeFilter == null) { this.RebuildFilter(); }
            flat = cascadeFilter;
        }

        int nCols;
        int colW;
        if (filtering) {
            nCols = 1;
            colW = w;
            if (colW < app.Scale(220)) { colW = app.Scale(220); }
            w = colW;
        } else {
            nCols = cascadePath.Count + 1;
            if (nCols > 4) { nCols = 4; }
            // 每列一个固定列宽（不窄于触发器）：展开新列时弹层向右
            // 生长，已展开的列保持原宽 —— 而不是把固定总宽越分越窄。
            // 超出窗口右缘才整体收窄。
            colW = w;
            if (colW < app.Scale(160)) { colW = app.Scale(160); }
            w = colW * nCols;
        }
        int room = app.canvas.Width() - app.Scale(8);
        if (w > room) { w = room; }
        int popX = OverlayPopup.FitX(app, x, w);
        int popY = OverlayPopup.FitY(app, y + h + app.Scale(4), h, viewH);
        rowsY = popY + chrome;
        app.BlockHitsBelow();
        StyleBox pop = this.ResolvePartAs(app, "select", "popup", "popup",
                                          Class, Style.SSelected());
        pop.Paint(app, popX, popY, w, viewH);
        app.BlockHitsRect(popX, popY, w, viewH);
        int rowPad = t.paddingSmall;
        bool consumed = false;
        int over = 0 - 1;

        // ---- 搜索条（filterable）----
        // 与平铺弹层同一颗内嵌真 Input：焦点在弹层打开期间锁定在它
        // 上面，展开即可键入。
        if (filterable && fbH > 0) {
            if (filterBox == null) {
                string bh = filterHint;
                if (bh == "") { bh = "Search"; }
                filterBox = new Input(bh);
                filterBox.Clearable = true;
            }
            if (!app.focus.IsFocused(filterBox.WidgetId())) {
                app.focus.SetFocused(filterBox.WidgetId());
            }
            filterBox.Render(app, popX + sbMargin, popY + sbMargin,
                             w - sbMargin * 2, fbH);
            string live = filterBox.GetText();
            if (live != filterText) {
                filterText = live;
                this.RebuildFilter();
                flat = cascadeFilter;
                filtering = filterText != "";
                app.RequestRedraw();
            }
        }

        for (int col = 0; col < nCols; col = col + 1) {
            // 本列可见窗口的选项下标：列模式按滚动窗口切层级列表，
            // 过滤态取命中表的一片。
            int count = 0;
            List<int> rowsIdx = new List<int>();
            if (filtering) {
                count = 0;
                if (flat != null) { count = flat.Count; }
                int off = this.ColScroll(0, count * optH, rowsH);
                int r = off / optH;
                while (r * optH < off + rowsH && r < count) {
                    rowsIdx.Add(flat[r]);
                    r = r + 1;
                }
            } else {
                List<SelectOption> cur = cascRoots;
                if (col > 0) {
                    cur = null;
                    int pi = cascadePath[col - 1];
                    if (pi >= 0 && pi < opts.Count) { cur = opts[pi].children; }
                }
                if (cur != null) { count = cur.Count; }
                int off = this.ColScroll(col, count * optH, rowsH);
                int r = off / optH;
                while (r * optH < off + rowsH && r < count) {
                    rowsIdx.Add(cur[r].flatIdx);
                    r = r + 1;
                }
            }
            int offCol = this.ColScroll(col, count * optH, rowsH);
            int cx = popX + col * colW;
            // 悬停行（可见窗口内的相对行号）。
            int hovRel = 0 - 1;
            if (app.mouseX >= cx && app.mouseX < cx + colW
                && app.mouseY >= rowsY && app.mouseY < rowsY + rowsH) {
                int rel = (app.mouseY - rowsY + offCol) / optH;
                if (rel >= 0 && rel < rowsIdx.Count) { hovRel = rel; }
            }
            c.PushClip(cx, rowsY, colW, rowsH);
            for (int rr = 0; rr < rowsIdx.Count; rr = rr + 1) {
                int idx = rowsIdx[rr];
                SelectOption o = opts[idx];
                int ry = rowsY + rr * optH - offCol;
                bool hov = rr == hovRel && !o.grp && !o.disabled;
                int st = Style.SNormal();
                if (o.disabled) {
                    st = Style.SDisabled();
                } else {
                    if (hov) { st = st + Style.SHover(); }
                    if (!multi && idx == selected) {
                        st = st + Style.SSelected();
                    }
                }
                StyleBox row = this.ResolvePartAs(app, "select", "option",
                                                  "option", Class, st);
                row.Paint(app, cx, ry, colW, optH);
                int rowFs = row.FontOr(fs);
                int tx = cx + rowPad;
                if (multi) {
                    int bs = this.DrawCascadeCheck(app, c, t, Class, cx, ry,
                                                   optH, o.chosen,
                                                   this.IsPartial(idx));
                    tx = cx + rowPad + bs + app.Scale(8);
                }
                string label = o.label;
                if (filtering) { label = this.PathOf(idx); }
                int labW = cx + colW - rowPad - tx;
                if (o.HasChildren() && !filtering) {
                    labW = labW - arrowSlot;
                }
                c.DrawText(tx, Canvas.CenterTextY(ry, optH, rowFs),
                    Ellipsis.Fit(label, labW, rowFs), row.fg, rowFs);
                if (o.HasChildren() && !filtering) {
                    c.DrawGlyphIn("chevron-right", cx + colW - arrowSlot, ry,
                        arrowSlot, optH, arrowSlot - t.paddingSmall, row.fg);
                }
                if (hov) { over = idx; }
                // 悬停展开：带子级的行指上即展开（不收拢、不点选）。
                if (hov && hoverExpand && !filtering && o.HasChildren()) {
                    List<int> np = new List<int>();
                    for (int i = 0; i < col && i < cascadePath.Count;
                         i = i + 1) {
                        np.Add(cascadePath[i]);
                    }
                    np.Add(idx);
                    if (!this.SamePath(np)) {
                        cascadePath = np;
                        app.RequestRedraw();
                    }
                }
                if (hov && app.ClickAvailable() && !consumed) {
                    consumed = true;
                    app.ClaimClick();
                    if (filtering) {
                        // 过滤结果平铺展示：每行都直接收值/勾选，
                        // 不再展开（下一列被过滤表盖住了）。
                        if (multi) {
                            this.SetChecked(idx, !o.chosen);
                            if (clearFilterAfter) { this.SetFilterText(""); }
                        } else {
                            if (clearFilterAfter) { this.SetFilterText(""); }
                            this.ChooseCascade(idx);
                        }
                    } else if (multi && (app.mouseX < tx || !o.HasChildren()
                                         || !cascadeLink)) {
                        // 勾选框区（或叶子、或联动关闭）勾选本行；
                        // 带子级的分支点标签区仍是展开。
                        this.SetChecked(idx, !o.chosen);
                    } else if (!multi && (!o.HasChildren() || !cascadeLink)) {
                        this.ChooseCascade(idx);
                    } else {
                        // 展开下一列：截断本列之后的旧链再推入。
                        List<int> next = new List<int>();
                        for (int i = 0; i < col && i < cascadePath.Count;
                             i = i + 1) {
                            next.Add(cascadePath[i]);
                        }
                        next.Add(idx);
                        cascadePath = next;
                    }
                    app.RequestRedraw();
                }
            }
            c.PopClip();
            // 弹层内已注册控件（内嵌滚动条的滑块/轨道）上的释放交给
            // 它，不能当成行选择。只在弹层基线之后找，理由同平铺弹层。
            if (app.ClickAvailable() && !consumed
                && app.hitTester.HitTestFrom(app.mouseX, app.mouseY,
                                             overlayBase) != 0 - 1) {
                consumed = true;
                app.ClaimClick();
            }
            // 每列自带滚动：滚轮滚动本列，内嵌真 Scrollbar 可拖。
            if (count * optH > rowsH && rowsH > 0) {
                bool ownsWheel = app.CaptureWheel(cx, rowsY, colW, rowsH);
                if (ownsWheel && ek == 13) {
                    int d = app.window.EventKeyCode();
                    int v = this.ColScroll(col, count * optH, rowsH);
                    this.SetColScroll(col, v - d * app.scrollSpeed / 120);
                    app.RequestRedraw();
                }
                if (cascadeScrollSig == null) {
                    cascadeScrollSig = new List<SignalInt>();
                }
                while (cascadeScrollSig.Count <= col) {
                    cascadeScrollSig.Add(null);
                }
                if (cascadeScrollSig[col] == null) {
                    cascadeScrollSig[col] = new SignalInt(0);
                }
                SignalInt sig = cascadeScrollSig[col];
                sig.Set(this.ColScroll(col, count * optH, rowsH));
                Scrollbar.RenderVerticalScroll(app,
                    cx + colW - app.Scale(12), rowsY + app.Scale(2),
                    rowsH - app.Scale(4), rowsH - app.Scale(4),
                    count * optH, sig);
                int sb = sig.Get();
                if (sb > count * optH - rowsH) { sb = count * optH - rowsH; }
                if (sb < 0) { sb = 0; }
                if (sb != this.ColScroll(col, count * optH, rowsH)) {
                    this.SetColScroll(col, sb);
                    app.RequestRedraw();
                }
            }
        }

        // 过滤没有命中项：整个行区一行浅色提示。
        if (filtering && (flat == null || flat.Count == 0)) {
            StyleBox grpStyle = this.ResolvePartAs(app, "select", "group", "",
                                                   Class, Style.SNormal());
            c.DrawText(popX + rowPad, Canvas.CenterTextY(rowsY, optH, fs),
                Ellipsis.Fit("No matches", w - rowPad * 2, fs),
                grpStyle.FgOr(pop.fg), grpStyle.FontOr(fs));
        }

        if (over != hoverRow) {
            hoverRow = over;
            // 级联行悬停变化同样对外报 Hover（Hovered() 是平铺下标）。
            Hover.Raise();
            app.RequestRedraw();
        }
        this.OverlayDismiss(app, popX, popY, w, viewH, ek);
    }

    void SetColScroll(int col, int v) {
        if (cascadeScroll == null) { cascadeScroll = new List<int>(); }
        while (cascadeScroll.Count <= col) { cascadeScroll.Add(0); }
        cascadeScroll[col] = v;
    }

    /// 级联行首的勾选框：复用 checkbox 的 box/check 样式 part。勾上
    /// 打勾，半勾（联动模式下子孙有勾选）画短横。返回方框宽度，
    /// 供点击分区（框区勾选、标签区展开）。
    int DrawCascadeCheck(App app, Canvas c, Theme t, string cls,
                         int cx, int ry, int optH, bool on, bool partial) {
        int st = Style.SNormal();
        if (on || partial) { st = st + Style.SChecked(); }
        StyleBox box = this.ResolvePartAs(app, "checkbox", "box", "", cls, st);
        int bs = box.WidthOr(app.Scale(16));
        int maxBs = optH - app.Scale(8);
        if (maxBs < app.Scale(10)) { maxBs = app.Scale(10); }
        if (bs > maxBs) { bs = maxBs; }
        int bx = cx + t.paddingSmall;
        int by = ry + (optH - bs) / 2;
        box.Paint(app, bx, by, bs, bs);
        if (on || partial) {
            StyleBox chk = this.ResolvePartAs(app, "checkbox", "check", "",
                                              cls, st);
            int gs = bs - app.Scale(8);
            if (gs < app.Scale(8)) { gs = bs - app.Scale(4); }
            string glyph = "minus";
            if (on) { glyph = "check"; }
            c.DrawGlyphIn(glyph, bx, by, bs, bs, gs,
                          chk.FgOr(box.AccentOr(box.fg)));
        }
        return bs;
    }

    /// 级联多选的触发器：勾选值渲染成一排标签芯片（select::tag
    /// part），每片带 ×，点 × 单独移除该值；放不下的折叠成 +N ——
    /// maxTagCount 由触发器宽度自适应兜住。showPath 决定片上的
    /// 文本是完整路径还是末级短标签。
    void DrawCascadeTags(App app, Canvas c, Theme t, string cls,
                         int partState, int x, int y, int w, int h,
                         int pad, int arrowSlot, bool showClear,
                         int clearSize, int fs, bool leftUp) {
        List<int> vs = this.ValueIdxs();
        int rightEdge = x + w - pad - arrowSlot - t.paddingSmall;
        if (showClear) { rightEdge = rightEdge - clearSize - t.paddingSmall; }
        int chipH = h - app.Scale(8);
        if (chipH > app.Scale(24)) { chipH = app.Scale(24); }
        if (chipH < app.Scale(16)) { chipH = h - app.Scale(4); }
        int chipFs = fs;
        if (chipFs > chipH - app.Scale(8)) { chipFs = chipH - app.Scale(8); }
        if (chipFs < 8) { chipFs = 8; }
        int gap = app.Scale(4);
        int cx = x + pad;
        int cy = y + (h - chipH) / 2;
        int shownN = 0;
        for (int i = 0; i < vs.Count; i = i + 1) {
            string label = this.ValueText(vs[i]);
            int tw = Canvas.MeasureText(label, chipFs);
            // 内距 ×2 + 文本 + × 字形槽。
            int cw = tw + app.Scale(10) + app.Scale(10) + chipFs;
            if (cx + cw > rightEdge) { break; }
            StyleBox chip = this.ResolvePartAs(app, "select", "tag", "",
                                               cls, partState);
            chip.Paint(app, cx, cy, cw, chipH);
            c.DrawText(cx + app.Scale(5),
                Canvas.CenterTextY(cy, chipH, chipFs),
                Ellipsis.Fit(label, tw + app.Scale(2), chipFs),
                chip.fg, chipFs);
            int xx = cx + cw - app.Scale(5) - chipFs;
            c.DrawGlyphIn("close", xx, cy, chipFs + app.Scale(4), chipH,
                          chipFs - 2, chip.fg);
            if (leftUp && !app.ClickClaimed()
                && app.mouseX >= xx - app.Scale(2)
                && app.mouseX < cx + cw
                && app.mouseY >= cy && app.mouseY < cy + chipH) {
                app.ClaimClick();
                this.SetChecked(vs[i], false);
                app.RequestRedraw();
            }
            cx = cx + cw + gap;
            shownN = shownN + 1;
        }
        if (shownN < vs.Count) {
            string more = "+" + Convert.ToString(vs.Count - shownN);
            int mw = Canvas.MeasureText(more, chipFs) + app.Scale(10);
            if (cx + mw <= rightEdge) {
                StyleBox chip = this.ResolvePartAs(app, "select", "tag", "",
                                                   cls, partState);
                chip.Paint(app, cx, cy, mw, chipH);
                c.DrawText(cx + app.Scale(5),
                    Canvas.CenterTextY(cy, chipH, chipFs), more,
                    chip.fg, chipFs);
            }
        }
    }

    /// 级联选中一个节点（平铺下标）：写入触发器（showPath 决定完整
    /// 路径还是末级短标签）、同步绑定并关闭。联动开启时只有叶子能
    /// 走到这里；关闭时带子级的分支也可以直接选中。
    void ChooseCascade(int idx) {
        if (idx < 0 || idx >= opts.Count) { return; }
        pathText = this.ValueText(idx);
        selected = idx;
        if (model != null) { model.Set(selected); lastModel = selected; }
        if (data != null) { data.Set(selected); lastData = selected; }
        Change.Raise();
        this.SetOpen(false);
    }

    /// 第 `idx` 个选项的完整路径文本（"浙江省 / 杭州市 / 西湖区"）。
    string PathOf(int idx) {
        if (idx < 0 || idx >= opts.Count) { return ""; }
        List<int> chain = new List<int>();
        int cur = idx;
        while (cur >= 0 && cur < opts.Count) {
            chain.Insert(0, cur);
            cur = opts[cur].parentIdx;
        }
        string path = "";
        for (int i = 0; i < chain.Count; i = i + 1) {
            if (i > 0) { path = path + " / "; }
            path = path + opts[chain[i]].label;
        }
        return path;
    }

    /// 值的显示文本：showPath 决定完整路径还是末级短标签。
    string ValueText(int idx) {
        if (!showPath) { return this.OptionLabel(idx); }
        return this.PathOf(idx);
    }

    /// 勾选策略下的值集合（平铺下标）：all = 全部勾选节点；
    /// parent = 没有被更深的勾选祖先盖住的节点（完整勾选子树的顶）；
    /// child = 勾选的叶子。
    List<int> ValueIdxs() {
        List<int> r = new List<int>();
        for (int i = 0; i < opts.Count; i = i + 1) {
            if (!opts[i].chosen || opts[i].grp) { continue; }
            if (checkStrategy == 2) {
                if (!opts[i].HasChildren()) { r.Add(i); }
                continue;
            }
            if (checkStrategy == 1) {
                int p = opts[i].parentIdx;
                bool covered = false;
                while (p >= 0 && p < opts.Count) {
                    if (opts[p].chosen) { covered = true; break; }
                    p = opts[p].parentIdx;
                }
                if (covered) { continue; }
            }
            r.Add(i);
        }
        return r;
    }

    /// 值集合的显示标签（配合 ValueText 的 showPath 语义）。
    List<string> ValueLabels() {
        List<int> vs = this.ValueIdxs();
        List<string> r = new List<string>();
        for (int i = 0; i < vs.Count; i = i + 1) {
            r.Add(this.ValueText(vs[i]));
        }
        return r;
    }

    /// 级联多选：把 `idx` 的勾选态设为 `on`。联动开启时带动全部
    /// 子孙，再沿父链回推（父级 = 全部子级勾上才算勾上）；
    /// 关闭时只改自己。统一触发 Change。
    void SetChecked(int idx, bool on) {
        if (idx < 0 || idx >= opts.Count) { return; }
        if (opts[idx].grp || opts[idx].disabled) { return; }
        this.ApplyCheck(idx, on);
        this.FixupAncestors(idx);
        Change.Raise();
    }

    void ApplyCheck(int idx, bool on) {
        opts[idx].chosen = on;
        if (cascadeLink && opts[idx].HasChildren()) {
            List<SelectOption> kids = opts[idx].children;
            for (int i = 0; i < kids.Count; i = i + 1) {
                this.ApplyCheck(kids[i].flatIdx, on);
            }
        }
    }

    /// 沿父链回推勾选态：全子勾上 → 父勾上，否则父取消。
    /// 某层已一致就停——更上层不可能因此变化。
    void FixupAncestors(int idx) {
        if (!cascadeLink) { return; }
        int p = opts[idx].parentIdx;
        while (p >= 0 && p < opts.Count) {
            bool all = true;
            List<SelectOption> kids = opts[p].children;
            for (int i = 0; i < kids.Count; i = i + 1) {
                if (!kids[i].chosen) { all = false; break; }
            }
            if (opts[p].chosen == all) { break; }
            opts[p].chosen = all;
            p = opts[p].parentIdx;
        }
    }

    /// 第 `idx` 个选项的半勾态：自身未勾但有勾选的子孙（联动模式）。
    bool IsPartial(int idx) {
        if (idx < 0 || idx >= opts.Count) { return false; }
        if (opts[idx].chosen || !cascadeLink) { return false; }
        return this.HasCheckedDescendant(idx);
    }

    bool HasCheckedDescendant(int idx) {
        if (!opts[idx].HasChildren()) { return false; }
        List<SelectOption> kids = opts[idx].children;
        for (int i = 0; i < kids.Count; i = i + 1) {
            if (kids[i].chosen) { return true; }
            if (this.HasCheckedDescendant(kids[i].flatIdx)) { return true; }
        }
        return false;
    }

    /// 第 `col` 列的滚动偏移（像素），按内容高度钳制。
    int ColScroll(int col, int contentH, int viewH) {
        if (cascadeScroll == null) { cascadeScroll = new List<int>(); }
        while (cascadeScroll.Count <= col) { cascadeScroll.Add(0); }
        int maxOff = contentH - viewH;
        if (maxOff < 0) { maxOff = 0; }
        int v = cascadeScroll[col];
        if (v > maxOff) { v = maxOff; }
        if (v < 0) { v = 0; }
        cascadeScroll[col] = v;
        return v;
    }

    bool SamePath(List<int> a) {
        if (cascadePath == null) { return a.Count == 0; }
        if (a.Count != cascadePath.Count) { return false; }
        for (int i = 0; i < a.Count; i = i + 1) {
            if (a[i] != cascadePath[i]) { return false; }
        }
        return true;
    }

    /// 树形弹层：内嵌真 TreeView，选中叶节点收值关闭。
    /// 展开/折叠、滚动、悬停全部是 TreeView 自己的行为；
    /// SelectBox 只给矩形、轮询选中、把叶子收成路径文本。
    void TreeOverlay(App app, int x, int y, int w, int h) {
        if (treeBox == null) { return; }
        Theme t = app.theme;
        int optH = h;
        int viewH = OverlayPopup.FitH(app, maxVisible * optH
            + t.paddingSmall * 2);
        if (w < app.Scale(260)) { w = app.Scale(260); }
        int popX = OverlayPopup.FitX(app, x, w);
        int popY = OverlayPopup.FitY(app, y + h + app.Scale(4), h, viewH);
        app.BlockHitsBelow();
        StyleBox pop = this.ResolvePartAs(app, "select", "popup", "popup",
                                          Class, Style.SSelected());
        pop.Paint(app, popX, popY, w, viewH);
        app.BlockHitsRect(popX, popY, w, viewH);
        int pad = app.Scale(4);
        treeBox.RenderInside(app, new Rect(popX + pad, popY + pad,
            w - pad * 2, viewH - pad * 2));
        // 轮询选中变化：叶节点收值（payload 优先于 label）并关闭；
        // 目录节点的选中只高亮，不收值。
        int si = treeBox.SelectedIndex();
        if (si >= 0 && si != treeSelSeen) {
            treeSelSeen = si;
            if (si < treeBox.data.Count) {
                TreeNode node = treeBox.data[si];
                if (!node.isDir) {
                    pathText = node.payload;
                    if (pathText == "") { pathText = node.label; }
                    Change.Raise();
                    app.RequestRedraw();
                    this.SetOpen(false);
                }
            }
        }
        this.OverlayDismiss(app, popX, popY, w, viewH, app.EventKind());
    }
}
