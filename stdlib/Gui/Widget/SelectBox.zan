using System;
using Gui;

namespace Gui.Widget;

/// 一个下拉选项：其标签及是否被选中（多选）。
/// 用一个实体代替平行的选项/选中列表。
class SelectOption {
    string label;
    bool chosen;

    SelectOption(string label, bool chosen) {
        this.label = label;
        this.chosen = chosen;
    }
}

/// <summary>
/// 高层、自包含的 select / 下拉框。
///
/// 有状态（创建一次，跨帧保留）。单个 Render() 绘制
/// 触发控件和弹出层，并自持开/关、选项列表、单选或
/// 多选、可选清除按钮、尺寸和状态变体，以及
/// 选项列表较长时自滚动的弹出层（鼠标滚轮 + 滚动条 + 裁剪），
/// 因此调用处只需：
///
///   SelectBox city = new SelectBox("Pick a city", false);   // 创建一次
///   city.AddOption("London"); city.AddOption("Paris");
///
///   city.Render(app, x, y, w);                           // 每帧
///   int i = city.Selected();          // 无选中时为 -1
///   string text = city.Text();
///
/// 多选：SelectBox.Multi(hint) + IsChosen(i)。流畅配置：
///   new SelectBox(hint, false).Clearable(true).Size(SelectBox.Large())
///                         .Status(SelectBox.Error())
///
/// 绑定：`sel.data = form.color;` 将选中索引双向绑定到
/// 普通字段；`SelectBox.Bind(options, signal, hint)` 与其他控件共享 SignalInt，
/// 且 `sel.Change += h;` 在每次选择变化时触发。
/// </summary>
class SelectBox : Control {
    List<SelectOption> opts;
    int selected;
    /// 可选共享选择信号（SelectBox.Bind）。
    SignalInt model;
    /// 双向绑定的选中索引：`sel.data = form.color;`（编译器降级的
    /// Binding）。新变动的一方生效，弹出层与字段保持同步。
    Binding<int> data;
    int lastModel;
    int lastData;
    /// 选择变化时触发（`sel.Change += h;`）。
    UiEvent Change;
    /// 选项列表打开/关闭时触发，无论由哪种方式
    /// 触发（点击触发控件、选择、外部按压、Esc）。
    UiEvent Open;
    UiEvent Close;
    string hint;
    bool multi;
    bool clearable;
    bool open;
    int scrollY;
    int size;
    int status;
    int maxVisible;
    // 每帧暂存锚点几何，使延迟弹出层（OnPaintOverlay、
    // 在覆盖阶段运行）能在触发控件下方自行布局。
    int trigX;
    int trigY;
    int trigW;
    /// 稳定控件 id：触发控件注册它，使悬停/按压/焦点（及读取它们的
    /// 缓动样式过渡）与任何其他控件一样工作。
    int wid;
    /// 上一帧实际绘制的头部高度（尊重显式 RenderIn
    /// 高度）；延迟弹出层读取它，使其正好位于触发控件下方。
    int lastH;
    /// 上一帧指针悬停的选项（无则 -1）。弹出层在覆盖阶段绘制
    /// 且未按行注册命中区域，因此没有其他机制
    /// 会请求重绘光标下那行的帧。
    int hoverRow;
    /// 弹层列数：0 = 自动（多选框选项多于一屏时分成等宽多列，
    /// 而不是拉成一条长条），否则固定列数。
    int cols;

    static int Small() { return 0; }
    static int Medium() { return 1; }
    static int Large() { return 2; }

    static int Normal() { return 0; }
    static int Success() { return 1; }
    static int Warning() { return 2; }
    static int Error() { return 3; }

    /// Default design-time constructor; the form supplies `placeholder` later.
    SelectBox() : this("", false) { }

    /// 单选下拉框（多选用 `new SelectBox(hint, true)`）。
    SelectBox(string hintText) : this(hintText, false) { }

    SelectBox(string hintText, bool isMulti) {
        this.InitControl("selectbox", 0);
        this.opts = new List<SelectOption>();
        this.selected = 0 - 1;
        this.hint = hintText;
        this.multi = isMulti;
        this.clearable = false;
        this.open = false;
        this.scrollY = 0;
        this.size = 1;
        this.status = 0;
        this.maxVisible = 6;
        this.cols = 0;
        this.wid = WidgetId.Next();
        this.lastH = 0;
        this.hoverRow = 0 - 1;
        this.wiresOwnEvents = true;
        this.lastModel = 0 - 1;
        this.lastData = 0 - 1;
        this.Change = new UiEvent();
        this.Open = new UiEvent();
        this.Close = new UiEvent();
    }

    /// 从普通标签列表构建选择框（JSON / 设计器 / 单行场景使用）。
    static SelectBox FromOptions(List<string> options, string hint) {
        SelectBox s = new SelectBox(hint, false);
        for (int i = 0; i < options.Count; i = i + 1) {
            s.AddOption(options[i]);
        }
        return s;
    }

    /// 共享外部 SignalInt 作为选中索引：读取同一信号的每个控件
    /// 都保持同步。
    static SelectBox Bind(List<string> options, SignalInt model, string hint) {
        SelectBox s = SelectBox.FromOptions(options, hint);
        s.model = model;
        s.selected = model.Get();
        s.lastModel = s.selected;
        return s;
    }

    /// 选项以 `a|b|c` 字符串表示（设计器 / .zform 属性往返）。
    string OptionsText() {
        string outp = "";
        for (int i = 0; i < opts.Count; i = i + 1) {
            if (i > 0) { outp = outp + "|"; }
            outp = outp + opts[i].label;
        }
        return outp;
    }

    void SetOptionsText(string text) {
        opts = new List<SelectOption>();
        string current = "";
        for (int i = 0; i <= text.Length; i = i + 1) {
            string ch = "";
            if (i < text.Length) { ch = text.Substring(i, 1); }
            if (ch == "|" || i == text.Length) {
                opts.Add(new SelectOption(current, false));
                current = "";
            } else {
                current = current + ch;
            }
        }
        scrollY = 0;
    }

    /// 固定弹层列数（等宽）；0 恢复自动。选项按列优先填，
    /// 先从第一列自上而下。
    SelectBox Columns(int n) {
        if (n < 0) { n = 0; }
        cols = n;
        scrollY = 0;
        return this;
    }

    /// 本次开层实际的列数。自动时：单选保持单列（下拉就该是
    /// 一条列表）；多选超过一屏时按 maxVisible 分列，最多 4 列，
    /// 这样一屏就能成行成列地看完。
    int ColumnCount() {
        if (cols > 0) { return cols; }
        if (!multi) { return 1; }
        if (maxVisible <= 0) { return 1; }
        int n = (opts.Count + maxVisible - 1) / maxVisible;
        if (n < 1) { n = 1; }
        if (n > 4) { n = 4; }
        return n;
    }

    /// 当前列数下每列的行数。
    int RowCount() {
        int n = this.ColumnCount();
        int rows = (opts.Count + n - 1) / n;
        if (rows < 1) { rows = 1; }
        return rows;
    }

    int Value() { return selected; }
    bool IsOpen() { return open; }

    /// 打开/关闭列表，并在实际切换时触发 Open/Close，
    /// 使每个入口（触发控件、选择、外部按压、Esc、代码）以相同方式
    /// 报告。
    void SetOpen(bool v) {
        if (open == v) { return; }
        open = v;
        if (v) { scrollY = 0; Open.Raise(); }
        else { Close.Raise(); }
    }

    /// 将共享信号和双向绑定与 `selected` 协调一致。
    /// 弹出层直接写 `selected`，因此每一侧都与
    /// 上次同步值比较，发生变动的一方生效。
    void SyncBinding() {
        if (model != null) {
            int m = model.Get();
            if (m != selected) {
                if (selected != lastModel) { model.Set(selected); }
                else { selected = m; }
            }
            lastModel = selected;
        }
        if (data != null) {
            int b = data.Get();
            if (b != selected) {
                if (selected != lastData) { data.Set(selected); }
                else { selected = b; }
            }
            lastData = selected;
        }
    }

    /// 应用弹出层作出的选择：将绑定和 Change
    /// 事件集中在一处，使所有入口行为一致。
    void Choose(int idx) {
        if (idx < 0 || idx >= opts.Count) { return; }
        if (multi) {
            opts[idx].chosen = !opts[idx].chosen;
        } else {
            if (selected == idx) { return; }
            selected = idx;
            if (model != null) { model.Set(idx); lastModel = idx; }
            if (data != null) { data.Set(idx); lastData = idx; }
        }
        Change.Raise();
    }

    static SelectBox Multi(string hintText) {
        return new SelectBox(hintText, true);
    }

    void AddOption(string label) {
        opts.Add(new SelectOption(label, false));
    }

    SelectBox Clearable(bool v) {
        clearable = v;
        return this;
    }

    SelectBox Size(int v) {
        size = v;
        return this;
    }

    SelectBox Status(int v) {
        status = v;
        return this;
    }

    int Selected() {
        return selected;
    }

    bool IsChosen(int i) {
        if (i < 0 || i >= opts.Count) { return false; }
        return opts[i].chosen;
    }

    bool HasValue() {
        if (multi) {
            for (int i = 0; i < opts.Count; i = i + 1) {
                if (opts[i].chosen) { return true; }
            }
            return false;
        }
        return selected >= 0 && selected < opts.Count;
    }

    /// 以编程方式设置选中索引（-1 清除）。保持绑定的
    /// model/data 同步，但不触发 Change（调用方发起的更新）。
    void Select(int idx) {
        if (idx < 0) { selected = 0 - 1; return; }
        if (idx >= opts.Count) { return; }
        selected = idx;
        if (model != null) { model.Set(idx); lastModel = idx; }
        if (data != null) { data.Set(idx); lastData = idx; }
    }

    void Clear() {
        selected = 0 - 1;
        for (int i = 0; i < opts.Count; i = i + 1) {
            opts[i].chosen = false;
        }
    }

    string Text() {
        if (multi) {
            string acc = "";
            for (int i = 0; i < opts.Count; i = i + 1) {
                if (opts[i].chosen) {
                    if (acc != "") { acc = acc + ", "; }
                    acc = acc + opts[i].label;
                }
            }
            return acc;
        }
        if (selected >= 0 && selected < opts.Count) { return opts[selected].label; }
        return "";
    }

    int HeadHeight(Theme t) {
        if (size == 0) { return t.heightSmall; }
        if (size == 2) { return t.heightLarge; }
        return t.heightMedium;
    }

    int FontSize(Theme t) {
        if (size == 0) { return t.fontSizeSmall; }
        if (size == 2) { return t.fontSizeLarge; }
        return t.fontSizeMedium;
    }

    /// 校验状态以额外 class 的形式进入样式层（base.css 的
    /// `select.success/.warning/.error` 规则），绘制代码不再直接
    /// 覆盖边框颜色。
    string StyleClass() {
        string extra = "";
        if (status == 1) { extra = "success"; }
        if (status == 2) { extra = "warning"; }
        if (status == 3) { extra = "error"; }
        if (extra == "") { return Class; }
        if (Class == "") { return extra; }
        return Class + " " + extra;
    }

    override string Kind() { return "Select"; }

    override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec ph = PropSpec.Text("hint", "Placeholder");
        ph.str = hint;
        ph.Also("placeholder");
        ps.Add(ph);
        ps.Add(PropSpec.Text("options", "Options"));
        PropSpec sel = PropSpec.Int("value", "Selected");
        sel.num = selected;
        sel.Also("selected");
        ps.Add(sel);
        PropSpec clr = PropSpec.Bool("clearable", "Clearable");
        clr.flag = clearable;
        ps.Add(clr);
        return ps;
    }

    /// 选项列表为文本，每项一个 `label|value` 对。
    override string GetExtra(string key) {
        if (key == "options") { return this.OptionsText(); }
        return "";
    }

    override bool SetExtra(string key, string val) {
        if (key != "options") { return false; }
        this.SetOptionsText(val);
        return true;
    }

    override List<string> Events() {
        List<string> e = Control.CommonEvents();
        e.Add("Change");
        e.Add("SelectionChanged");
        e.Add("Open");
        e.Add("Close");
        return e;
    }

    override void BindEvent(string evt, Action a) {
        if (evt == "Change" || evt == "SelectionChanged") { Change.Add(a); return; }
        if (evt == "Open") { Open.Add(a); return; }
        if (evt == "Close") { Close.Add(a); return; }
        On.AddByName(evt, a);
    }

    override void OnMeasure(App app) {
        StyleBox s = this.ResolveStyleAs(app, "select", Class, Style.SNormal());
        prefH = s.HeightOr(this.HeadHeight(app.theme));
        prefW = s.WidthOr(app.Scale(200));
    }

    override void OnPaint(App app) {
        this.RenderIn(app, bx, by, bw, bh);
    }

    /// 以自然（样式/尺寸）高度绘制触发控件。
    void Render(App app, int x, int y, int w) {
        this.RenderIn(app, x, y, w, 0);
    }

    /// 在显式盒子内绘制触发控件；`hIn` 为 0 时高度取自
    /// 解析出的样式/尺寸变体，其他值优先生效，使工具栏一行
    /// 的 select、按钮和输入框共享同一高度。
    void RenderIn(App app, int x, int y, int w, int hIn) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        this.SyncBinding();

        int h = this.HeadHeight(t);
        int fs = this.FontSize(t);
        string cls = this.StyleClass();
        if (hIn > 0) { h = hIn; }
        StyleBox s = this.ResolveEasedStyleAsIn(
            app, wid, "select", cls, false, open, x, y, w, h);
        h = s.HeightOr(h);
        this.lastH = h;
        fs = s.FontOr(fs);
        app.focus.RegisterFocusable(wid);
        app.hitTester.RegisterRect(wid, x, y, w, h, 1);

        int ek = app.EventKind();
        int eb = app.window.EventButton();
        // 触发器按几何判断悬停/点击，因此必须问过弹层：直接读
        // 原始事件时，画在它上面的下拉/菜单/模态的点击会一路
        // 穿透下来，把这个选择框也打开。
        bool leftUp = app.ClickAvailable() && eb == 0;

        bool overHead = Ui.Over(app, x, y, w, h);

        // 有值时的清除按钮几何（箭头左侧）。
        int partState = Style.StateOf(app, wid, false);
        if (open) { partState = partState + Style.SSelected(); }
        StyleBox arrowStyle = this.ResolvePartAs(app, "select", "arrow", "",
                                                 cls, partState);
        StyleBox clearStyle = this.ResolvePartAs(app, "select", "clear", "",
                                                 cls, partState);
        int arrowSize = arrowStyle.FontOr(t.iconSizeSmall);
        int arrowSlot = arrowStyle.WidthOr(t.paddingLarge + arrowSize);
        int clearSize = clearStyle.FontOr(t.iconSizeSmall);
        int clearX = x + w - arrowSlot - clearSize - t.paddingSmall;
        bool showClear = clearable && this.HasValue() && overHead;
        bool overClear = showClear && app.mouseX >= clearX
            && app.mouseX < clearX + clearSize;

        // ---- 触发控件 ----
        // 从样式层解析为 `select` 控件，使皮肤
        // 像 input 一样为其设置样式（`select:hover`、`select:focus` 等）；
        // 校验状态通过 StyleClass 的额外 class 在 CSS 中着色。
        int pad = s.PadLOr(t.paddingSmall);
        s.Paint(app, x, y, w, h);

        int textY = Canvas.CenterTextY(y, h, fs);
        int headMaxW = w - pad - arrowSlot - t.paddingSmall;
        if (showClear) { headMaxW = headMaxW - clearSize - t.paddingSmall; }
        string shown = this.Text();
        StyleBox placeholderStyle = this.ResolvePartAs(app, "select", "placeholder", "",
                                                        cls, partState);
        if (shown == "") {
            int hintFs = placeholderStyle.FontOr(fs);
            int hintY = Canvas.CenterTextY(y, h, hintFs);
            c.DrawText(x + pad, hintY,
                Ellipsis.Fit(hint, headMaxW, hintFs),
                placeholderStyle.FgOr(s.fg), hintFs);
        } else {
            c.DrawText(x + pad, textY,
                Ellipsis.Fit(shown, headMaxW, fs), s.fg, fs);
        }

        if (showClear) {
            int clearState = Style.SNormal();
            if (open) { clearState = clearState + Style.SSelected(); }
            if (app.focus.IsFocused(wid)) { clearState = clearState + Style.SFocus(); }
            if (overClear) { clearState = clearState + Style.SHover(); }
            if (overClear && app.focus.IsPressed(wid)) {
                clearState = clearState + Style.SActive();
            }
            clearStyle = this.ResolvePartAs(app, "select", "clear", "",
                                            cls, clearState);
            c.DrawGlyphIn("close", clearX, y, clearSize, h,
                clearSize, clearStyle.FgOr(s.fg));
        }
        c.DrawGlyphIn("chevron-down", x + w - arrowSlot, y,
            arrowSlot, h, arrowSize, arrowStyle.FgOr(s.fg));

        // ---- 触发控件输入（仅关闭状态） ----
        // 弹出层自身的点击（选择选项 / 外部关闭）在
        // OnPaintOverlay 中处理，使其在覆盖阶段解析于内容之上。
        if (leftUp && !open) {
            if (overClear) {
                this.Clear();
                app.RequestRedraw();
            } else if (overHead) {
                this.SetOpen(true);
                // 认领打开时的点击，使刚显示的弹出层不会把
                // 它当作外部按压而在同一帧立即关闭。
                app.ClaimClick();
                app.RequestRedraw();
            }
        }
        On.Fire(app, wid);

        // 将选项列表推迟到覆盖阶段：随后它绘制在所有
        // 在此控件之后绘制的控件（无遮挡），并注册最顶层
        // 命中区域（不穿透点击）。参见 OnPaintOverlay。
        trigX = x;
        trigY = y;
        trigW = w;
        if (open) {
            app.AddOverlay(OverlayPopup.Host(this));
        }
    }

    /// 弹层宽度：不窄于触发器，但至少能放下最长的一条；
    /// 多列时按列数等宽扩开。按触发器宽度开弹层会把每一条
    /// 都截成同一个前缀，选项之间看不出区别。
    int PopupWidth(App app, Theme t, int trigWidth, int fs, int arrowSlot) {
        int n = this.ColumnCount();
        int colW = trigWidth / n;
        int chrome = t.paddingSmall * 2 + arrowSlot;
        for (int i = 0; i < opts.Count; i = i + 1) {
            int tw = Canvas.MeasureText(opts[i].label, fs) + chrome;
            if (tw > colW) { colW = tw; }
        }
        int w = colW * n;
        if (w < trigWidth) { w = trigWidth; }
        int room = app.canvas.Width() - app.Scale(8);
        if (w > room) { w = room; }
        return w;
    }

    /// 延迟弹层：在 App.RunOverlays 中、所有内容绘制完成后绘制并派发事件。
    override void OnPaintOverlay(App app) {
        if (!open) { return; }
        Canvas c = app.canvas;
        Theme t = app.theme;

        int x = trigX;
        int y = trigY;
        int w = trigW;
        int h = this.lastH;
        if (h <= 0) { h = computedStyle.HeightOr(this.HeadHeight(t)); }
        int fs = computedStyle.FontOr(this.FontSize(t));
        int optH = h;
        StyleBox arrowStyle = this.ResolvePartAs(app, "select", "arrow", "",
                                                 Class, Style.SSelected());
        int arrowSlot = arrowStyle.WidthOr(t.paddingLarge + t.iconSizeSmall);

        int ek = app.EventKind();

        int nCols = this.ColumnCount();
        int nRows = this.RowCount();
        int visRows = nRows;
        if (visRows > maxVisible) { visRows = maxVisible; }
        int viewH = OverlayPopup.FitH(app, visRows * optH);
        int contentH = nRows * optH;
        // 由框架放置，保证列表不超出窗口：
        // 靠近底部边缘时向上翻转，而不是
        // 掉落到窗口末尾内容之下。
        w = this.PopupWidth(app, t, w, fs, arrowSlot);
        int popX = OverlayPopup.FitX(app, x, w);
        int popY = OverlayPopup.FitY(app, y + h + app.Scale(4), h, viewH);

        bool overPopup = app.mouseX >= popX && app.mouseX < popX + w
            && app.mouseY >= popY && app.mouseY < popY + viewH;

        // 选项由几何驱动：它们不注册命中 id，因此
        // 在弹层内移动不会改变悬停 id，也不会调度新帧；只有悬停行
        // 真的变了才重绘（每一个鼠标移动事件都重绘一整帧，只要
        // 弹层开着就是持续满载）。
        int colW = w / nCols;
        if (colW < 1) { colW = 1; }
        int over = 0 - 1;
        if (overPopup) {
            int row = (app.mouseY - popY + scrollY) / optH;
            int col = (app.mouseX - popX) / colW;
            if (col >= nCols) { col = nCols - 1; }
            int idx = col * nRows + row;
            if (row >= 0 && row < nRows && idx < opts.Count) { over = idx; }
        }
        if (over != hoverRow) {
            hoverRow = over;
            app.RequestRedraw();
        }

        int maxScroll = contentH - viewH;
        if (maxScroll < 0) { maxScroll = 0; }
        if (overPopup) {
            bool ownsWheel = app.CaptureWheel(popX, popY, w, viewH);
            if (ownsWheel && ek == 13) {
                int d = app.window.EventKeyCode();
                scrollY = scrollY - d * app.scrollSpeed / 120;
                app.RequestRedraw();
            }
        }
        if (scrollY > maxScroll) { scrollY = maxScroll; }
        if (scrollY < 0) { scrollY = 0; }

        app.BlockHitsBelow();
        // 弹层底由 `select::popup` 提供不透明背景（base.css 保证可读），
        // 不再额外垫一层不透明底——同区域双重绘制是过绘的典型来源。
        StyleBox pop = this.ResolvePartAs(app, "select", "popup", "popup",
                                          Class, Style.SSelected());
        pop.Paint(app, popX, popY, w, viewH);
        app.BlockHitsRect(popX, popY, w, viewH);

        c.PushClip(popX, popY, w, viewH);
        for (int i = 0; i < opts.Count; i = i + 1) {
            int oCol = i / nRows;
            int oRow = i % nRows;
            int ox = popX + oCol * colW;
            int oy = popY + oRow * optH - scrollY;
            if (oy + optH > popY && oy < popY + viewH) {
                bool overRow = i == hoverRow;
                bool isSel = false;
                if (multi) { isSel = opts[i].chosen; }
                else { isSel = i == selected; }

                // 行以 `option`（`option:hover`、`option:selected`）解析，
                // 皮肤无需在此分支即可重设列表样式。
                int st = Style.SNormal();
                if (overRow) { st = st + Style.SHover(); }
                if (isSel) { st = st + Style.SSelected(); }
                StyleBox row = this.ResolvePartAs(app, "select", "option", "option",
                                                   Class, st);
                row.Paint(app, ox + 1, oy, colW - 2, optH);
                int rowFs = row.FontOr(fs);
                int rowPad = row.PadLOr(t.paddingSmall);
                int oMaxW = colW - rowPad - arrowSlot - t.paddingSmall;
                c.DrawText(ox + rowPad,
                    Canvas.CenterTextY(oy, optH, rowFs),
                    Ellipsis.Fit(opts[i].label, oMaxW, rowFs),
                    row.fg, rowFs);
                if (isSel) {
                    StyleBox checkStyle = this.ResolvePartAs(app, "select", "checkmark", "",
                                                              Class, st);
                    int checkSize = checkStyle.FontOr(t.iconSizeSmall);
                    c.DrawGlyphIn("check", ox + colW - arrowSlot, oy,
                        arrowSlot, optH, checkSize,
                        checkStyle.FgOr(checkStyle.AccentOr(row.accent)));
                }
            }
        }
        c.PopClip();

        // 弹层滚动条（裁剪到弹层内，限制在轨道范围内）。
        if (contentH > viewH && viewH > 0) {
            StyleBox scrollbarStyle = this.ResolvePartAs(app, "select", "scrollbar", "",
                                                          Class, Style.SSelected());
            int barW = scrollbarStyle.WidthOr(app.Scale(6));
            int bx = popX + w - barW - app.Scale(2);
            int minThumb = app.Scale(24);
            if (minThumb > viewH) { minThumb = viewH; }
            int thumbH = viewH * viewH / contentH;
            if (thumbH < minThumb) { thumbH = minThumb; }
            if (thumbH > viewH) { thumbH = viewH; }
            int travel = viewH - thumbH;
            if (travel < 0) { travel = 0; }
            int thumbY = popY;
            if (maxScroll > 0) { thumbY = popY + scrollY * travel / maxScroll; }
            if (thumbY < popY) { thumbY = popY; }
            if (thumbY + thumbH > popY + viewH) { thumbY = popY + viewH - thumbH; }
            c.PushClip(popX, popY, w, viewH);
            c.FillRoundRect(bx, thumbY, barW, thumbH,
                            scrollbarStyle.RadiusOr(barW / 2),
                            scrollbarStyle.BgOr(pop.fg));
            c.PopClip();
        }

        // ---- 集中式弹层输入（overlay 阶段，位于内容之上） ----
        // 弹层打开的当前帧 ClickAvailable() 为 false（打开时的
        // 点击已被占用），因此弹层不会在打开时立即自关闭。
        if (app.ClickAvailable()) {
            if (overPopup) {
                int rel = app.mouseY - popY + scrollY;
                int col = (app.mouseX - popX) / colW;
                if (col >= nCols) { col = nCols - 1; }
                if (col < 0) { col = 0; }
                int idx = col * nRows + rel / optH;
                if (idx >= 0 && idx < opts.Count) {
                    this.Choose(idx);
                    if (!multi) { this.SetOpen(false); }
                    app.ClaimClick();
                    app.RequestRedraw();
                }
            } else {
                // 点击弹层外部任意位置（含触发器）即关闭。
                this.SetOpen(false);
                app.RequestRedraw();
            }
        }
        if (ek == 4 && app.window.EventKeyCode() == 27) {
            this.SetOpen(false);
            app.RequestRedraw();
        }
    }
}
