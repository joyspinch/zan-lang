using System;
using Gui;

namespace Gui.Widget;

/// One dropdown option: its label and whether it is chosen (multi-select).
/// One entity instead of parallel option/chosen lists.
class SelectOption {
    string label;
    bool chosen;

    SelectOption(string label, bool chosen) {
        this.label = label;
        this.chosen = chosen;
    }
}

/// <summary>
/// High-level, self-contained select / dropdown.
///
/// Retained (create once, keep across frames). A single Render() draws the
/// trigger AND the popup, and owns open/close, the option list, single- or
/// multi-selection, an optional clear button, size and status variants, and a
/// self-scrolling popup (mouse wheel + scrollbar + clipping) when the option
/// list is long — so the call site is just:
///
///   SelectBox city = SelectBox.Create("Pick a city");   // once
///   city.AddOption("London"); city.AddOption("Paris");
///
///   city.Render(app, x, y, w);                           // each frame
///   int i = city.Selected();          // -1 if none
///   string text = city.Text();
///
/// Multi-select: SelectBox.Multi(hint) + IsChosen(i). Fluent config:
///   SelectBox.Create(hint).Clearable(true).Size(SelectBox.Large())
///                         .Status(SelectBox.Error())
///
/// Binding: `sel.data = form.color;` two-way binds the selected index to a
/// plain field, `SelectBox.Bind(options, signal, hint)` shares a SignalInt with
/// other widgets, and `sel.Change += h;` fires on every selection change.
/// </summary>
class SelectBox : Control {
    List<SelectOption> opts;
    int selected;
    /// Optional shared selection signal (SelectBox.Bind).
    SignalInt model;
    /// Two-way bound selected index: `sel.data = form.color;` (compiler-lowered
    /// Binding). The newer side wins, so the popup and the field stay in sync.
    Binding<int> data;
    int lastModel;
    int lastData;
    /// Fires when the selection changes (`sel.Change += h;`).
    UiEvent Change;
    /// Fires when the option list opens / closes, whichever way it was
    /// triggered (trigger click, pick, outside press, Esc).
    UiEvent Open;
    UiEvent Close;
    string hint;
    bool multi;
    bool clearable;
    bool open;
    int scrollY;
    int size;
    int status;
    int maxVisible;
    // Anchor geometry stashed each frame so the deferred popup (OnPaintOverlay,
    // run in the overlay pass) can lay itself out below the trigger.
    int trigX;
    int trigY;
    int trigW;
    /// Stable widget id: the trigger registers it so hover/press/focus (and the
    /// eased style transitions that read them) work like any other control.
    int wid;

    static int Small() { return 0; }
    static int Medium() { return 1; }
    static int Large() { return 2; }

    static int Normal() { return 0; }
    static int Success() { return 1; }
    static int Warning() { return 2; }
    static int Error() { return 3; }

    static SelectBox Make(string hintText, bool isMulti) {
        SelectBox s = new SelectBox();
        s.InitControl("selectbox", 0);
        s.opts = new List<SelectOption>();
        s.selected = 0 - 1;
        s.hint = hintText;
        s.multi = isMulti;
        s.clearable = false;
        s.open = false;
        s.scrollY = 0;
        s.size = 1;
        s.status = 0;
        s.maxVisible = 6;
        s.wid = WidgetId.Next();
        s.wiresOwnEvents = true;
        s.lastModel = 0 - 1;
        s.lastData = 0 - 1;
        s.Change = UiEvent.Create();
        s.Open = UiEvent.Create();
        s.Close = UiEvent.Create();
        return s;
    }

    /// Builds a box from a plain label list (JSON / designer / one-liner use).
    static SelectBox FromOptions(List<string> options, string hint) {
        SelectBox s = SelectBox.Make(hint, false);
        int i = 0;
        while (i < options.Count) {
            s.AddOption(options[i]);
            i = i + 1;
        }
        return s;
    }

    /// Shares an external SignalInt as the selected index: every widget reading
    /// the same signal stays in sync.
    static SelectBox Bind(List<string> options, SignalInt model, string hint) {
        SelectBox s = SelectBox.FromOptions(options, hint);
        s.model = model;
        s.selected = model.Get();
        s.lastModel = s.selected;
        return s;
    }

    /// Options as a `a|b|c` string (designer / .zform property round-trip).
    string OptionsText() {
        string outp = "";
        int i = 0;
        while (i < opts.Count) {
            if (i > 0) { outp = outp + "|"; }
            outp = outp + opts[i].label;
            i = i + 1;
        }
        return outp;
    }

    void SetOptionsText(string text) {
        opts = new List<SelectOption>();
        string current = "";
        int i = 0;
        while (i <= text.Length) {
            string ch = "";
            if (i < text.Length) { ch = text.Substring(i, 1); }
            if (ch == "|" || i == text.Length) {
                opts.Add(new SelectOption(current, false));
                current = "";
            } else {
                current = current + ch;
            }
            i = i + 1;
        }
        scrollY = 0;
    }

    int Value() { return selected; }
    bool IsOpen() { return open; }

    /// Opens / closes the list and raises Open/Close on an actual transition,
    /// so every entry point (trigger, pick, outside press, Esc, code) reports
    /// the same way.
    void SetOpen(bool v) {
        if (open == v) { return; }
        open = v;
        if (v) { scrollY = 0; Open.Raise(); }
        else { Close.Raise(); }
    }

    /// Reconciles the shared signal and the two-way binding with `selected`.
    /// The popup writes `selected` directly, so each side is compared against
    /// its last synced value and the one that moved wins.
    void SyncBinding() {
        if (model != null) {
            int m = model.Get();
            if (m != selected) {
                if (selected != lastModel) { model.Set(selected); }
                else { selected = m; }
            }
            lastModel = selected;
        }
        if (data != null) {
            int b = data.Get();
            if (b != selected) {
                if (selected != lastData) { data.Set(selected); }
                else { selected = b; }
            }
            lastData = selected;
        }
    }

    /// Applies a selection made by the popup: keeps bindings and the Change
    /// event in one place so every entry point behaves the same.
    void Choose(int idx) {
        if (idx < 0 || idx >= opts.Count) { return; }
        if (multi) {
            opts[idx].chosen = !opts[idx].chosen;
        } else {
            if (selected == idx) { return; }
            selected = idx;
            if (model != null) { model.Set(idx); lastModel = idx; }
            if (data != null) { data.Set(idx); lastData = idx; }
        }
        Change.Raise();
    }

    static SelectBox Create(string hintText) {
        return SelectBox.Make(hintText, false);
    }

    static SelectBox Multi(string hintText) {
        return SelectBox.Make(hintText, true);
    }

    void AddOption(string label) {
        opts.Add(new SelectOption(label, false));
    }

    SelectBox Clearable(bool v) {
        clearable = v;
        return this;
    }

    SelectBox Size(int v) {
        size = v;
        return this;
    }

    SelectBox Status(int v) {
        status = v;
        return this;
    }

    int Selected() {
        return selected;
    }

    bool IsChosen(int i) {
        if (i < 0 || i >= opts.Count) { return false; }
        return opts[i].chosen;
    }

    bool HasValue() {
        if (multi) {
            int i = 0;
            while (i < opts.Count) {
                if (opts[i].chosen) { return true; }
                i = i + 1;
            }
            return false;
        }
        return selected >= 0 && selected < opts.Count;
    }

    void Clear() {
        selected = 0 - 1;
        int i = 0;
        while (i < opts.Count) {
            opts[i].chosen = false;
            i = i + 1;
        }
    }

    string Text() {
        if (multi) {
            string acc = "";
            int i = 0;
            while (i < opts.Count) {
                if (opts[i].chosen) {
                    if (acc != "") { acc = acc + ", "; }
                    acc = acc + opts[i].label;
                }
                i = i + 1;
            }
            return acc;
        }
        if (selected >= 0 && selected < opts.Count) { return opts[selected].label; }
        return "";
    }

    int HeadHeight(Theme t) {
        if (size == 0) { return t.heightSmall; }
        if (size == 2) { return t.heightLarge; }
        return t.heightMedium;
    }

    int FontSize(Theme t) {
        if (size == 0) { return t.fontSizeSmall; }
        if (size == 2) { return t.fontSizeLarge; }
        return t.fontSizeMedium;
    }

    int StatusBorder(Theme t, bool hot) {
        if (status == 1) { return t.success; }
        if (status == 2) { return t.warning; }
        if (status == 3) { return t.error; }
        if (hot) { return t.borderHover; }
        return t.borderPrimary;
    }

    override string Kind() { return "Select"; }

    override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec ph = PropSpec.Text("hint", "Placeholder");
        ph.str = hint;
        ph.Also("placeholder");
        ps.Add(ph);
        ps.Add(PropSpec.Text("options", "Options"));
        PropSpec sel = PropSpec.Int("value", "Selected");
        sel.num = selected;
        sel.Also("selected");
        ps.Add(sel);
        PropSpec clr = PropSpec.Bool("clearable", "Clearable");
        clr.flag = clearable;
        ps.Add(clr);
        return ps;
    }

    /// The option list is text, one `label|value` pair per entry.
    override string GetExtra(string key) {
        if (key == "options") { return this.OptionsText(); }
        return "";
    }

    override bool SetExtra(string key, string val) {
        if (key != "options") { return false; }
        this.SetOptionsText(val);
        return true;
    }

    override List<string> Events() {
        List<string> e = Control.CommonEvents();
        e.Add("Change");
        e.Add("SelectionChanged");
        e.Add("Open");
        e.Add("Close");
        return e;
    }

    override void BindEvent(string evt, Action a) {
        if (evt == "Change" || evt == "SelectionChanged") { Change.Add(a); return; }
        if (evt == "Open") { Open.Add(a); return; }
        if (evt == "Close") { Close.Add(a); return; }
        On.AddByName(evt, a);
    }

    override void OnMeasure(App app) {
        StyleBox s = this.ResolveStyleAs(app, "select", Class, Style.SNormal());
        prefH = s.HeightOr(this.HeadHeight(app.theme));
        prefW = s.WidthOr(app.Scale(200));
    }

    override void OnPaint(App app) {
        this.Render(app, bx, by, bw);
    }

    void Render(App app, int x, int y, int w) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        this.SyncBinding();

        int h = this.HeadHeight(t);
        int fs = this.FontSize(t);
        StyleBox s = this.ResolveEasedStyleAs(app, wid, "select", Class,
                                              false, open);
        h = s.HeightOr(h);
        fs = s.FontOr(fs);
        app.focus.RegisterFocusable(wid);
        app.hitTester.Register(HitRegion.Create(wid, x, y, w, h, 1));

        int ek = app.EventKind();
        int eb = app.window.EventButton();
        bool leftUp = ek == 3 && eb == 0;

        bool overHead = app.mouseX >= x && app.mouseX < x + w
            && app.mouseY >= y && app.mouseY < y + h;

        // Clear button geometry (left of the arrow) when there is a value.
        int partState = Style.StateOf(app, wid, false);
        if (open) { partState = partState + Style.SSelected(); }
        StyleBox arrowStyle = this.ResolvePartAs(app, "select", "arrow", "",
                                                 Class, partState);
        StyleBox clearStyle = this.ResolvePartAs(app, "select", "clear", "",
                                                 Class, partState);
        int arrowSize = arrowStyle.FontOr(t.iconSizeSmall);
        int arrowSlot = arrowStyle.WidthOr(t.paddingLarge + arrowSize);
        int clearSize = clearStyle.FontOr(t.iconSizeSmall);
        int clearX = x + w - arrowSlot - clearSize - t.paddingSmall;
        bool showClear = clearable && this.HasValue() && overHead;
        bool overClear = showClear && app.mouseX >= clearX
            && app.mouseX < clearX + clearSize;

        // ---- trigger ----
        // Resolved from the style layer as a `select` control, so a skin styles
        // it exactly like an input (`select:hover`, `select:focus`, ...); the
        // validation status still overrides the border colour.
        if (status != 0) { s.borderColor = this.StatusBorder(t, overHead || open); }
        int pad = s.PadLOr(t.paddingSmall);
        s.Paint(app, x, y, w, h);

        int textY = y + (h - Canvas.FontHeight(fs)) / 2;
        int headMaxW = w - pad - arrowSlot - t.paddingSmall;
        if (showClear) { headMaxW = headMaxW - clearSize - t.paddingSmall; }
        string shown = this.Text();
        StyleBox placeholderStyle = this.ResolvePartAs(app, "select", "placeholder", "",
                                                        Class, partState);
        if (shown == "") {
            int hintFs = placeholderStyle.FontOr(fs);
            int hintY = y + (h - Canvas.FontHeight(hintFs)) / 2;
            c.DrawText(x + pad, hintY,
                Ellipsis.Fit(hint, headMaxW, hintFs),
                placeholderStyle.FgOr(t.textTertiary), hintFs);
        } else {
            c.DrawText(x + pad, textY,
                Ellipsis.Fit(shown, headMaxW, fs), s.FgOr(t.textPrimary), fs);
        }

        if (showClear) {
            int clearState = Style.SNormal();
            if (open) { clearState = clearState + Style.SSelected(); }
            if (app.focus.IsFocused(wid)) { clearState = clearState + Style.SFocus(); }
            if (overClear) { clearState = clearState + Style.SHover(); }
            if (overClear && app.focus.IsPressed(wid)) {
                clearState = clearState + Style.SActive();
            }
            clearStyle = this.ResolvePartAs(app, "select", "clear", "",
                                            Class, clearState);
            int cc = clearStyle.FgOr(t.textTertiary);
            if (overClear && clearStyle.fg == 0) { cc = t.error; }
            c.DrawGlyphIn("close", clearX, y, clearSize, h,
                clearSize, cc);
        }
        c.DrawGlyphIn("chevron-down", x + w - arrowSlot, y,
            arrowSlot, h, arrowSize, arrowStyle.FgOr(t.textSecondary));

        // ---- trigger input (closed state only) ----
        // The popup's own clicks (option pick / outside-dismiss) are handled in
        // OnPaintOverlay so they resolve above content in the overlay pass.
        if (leftUp && !open) {
            if (overClear) {
                this.Clear();
                app.RequestRedraw();
            } else if (overHead) {
                this.SetOpen(true);
                // Claim the opening click so the just-shown popup does not treat
                // it as an outside-press and immediately close this same frame.
                app.ClaimClick();
                app.RequestRedraw();
            }
        }
        On.Fire(app, wid);

        // Defer the option list to the overlay pass: it then paints above every
        // widget drawn after this one (no occlusion) and registers the top-most
        // hit regions (no click-through). See OnPaintOverlay.
        trigX = x;
        trigY = y;
        trigW = w;
        if (open) {
            app.AddOverlay(OverlayPopup.Host(this));
        }
    }

    /// Deferred popup: drawn + dispatched in App.RunOverlays after all content.
    override void OnPaintOverlay(App app) {
        if (!open) { return; }
        Canvas c = app.canvas;
        Theme t = app.theme;

        int x = trigX;
        int y = trigY;
        int w = trigW;
        int h = computedStyle.HeightOr(this.HeadHeight(t));
        int fs = computedStyle.FontOr(this.FontSize(t));
        int optH = h;
        StyleBox arrowStyle = this.ResolvePartAs(app, "select", "arrow", "",
                                                 Class, Style.SSelected());
        int arrowSlot = arrowStyle.WidthOr(t.paddingLarge + t.iconSizeSmall);

        int ek = app.EventKind();

        int visRows = opts.Count;
        if (visRows > maxVisible) { visRows = maxVisible; }
        int viewH = OverlayPopup.FitH(app, visRows * optH);
        int contentH = opts.Count * optH;
        // Placed by the framework so the list never leaves the window: it
        // flips above the trigger near the bottom edge instead of dropping
        // behind whatever the window ends with.
        int popX = OverlayPopup.FitX(app, x, w);
        int popY = OverlayPopup.FitY(app, y + h + app.Scale(4), h, viewH);

        bool overPopup = app.mouseX >= popX && app.mouseX < popX + w
            && app.mouseY >= popY && app.mouseY < popY + viewH;

        int maxScroll = contentH - viewH;
        if (maxScroll < 0) { maxScroll = 0; }
        if (overPopup) {
            bool ownsWheel = app.CaptureWheel(popX, popY, w, viewH);
            if (ownsWheel && ek == 13) {
                int d = app.window.EventKeyCode();
                scrollY = scrollY - d * app.scrollSpeed / 120;
                app.RequestRedraw();
            }
        }
        if (scrollY > maxScroll) { scrollY = maxScroll; }
        if (scrollY < 0) { scrollY = 0; }

        app.BlockHitsBelow();
        StyleBox pop = this.ResolvePartAs(app, "select", "popup", "popup",
                                          Class, Style.SSelected());
        pop.Paint(app, popX, popY, w, viewH);
        app.BlockHitsRect(popX, popY, w, viewH);

        c.PushClip(popX, popY, w, viewH);
        int i = 0;
        while (i < opts.Count) {
            int oy = popY + i * optH - scrollY;
            if (oy + optH > popY && oy < popY + viewH) {
                bool overRow = overPopup && app.mouseX >= popX && app.mouseX < popX + w
                    && app.mouseY >= oy && app.mouseY < oy + optH;
                bool isSel = false;
                if (multi) { isSel = opts[i].chosen; }
                else { isSel = i == selected; }

                // Rows resolve as `option` (`option:hover`, `option:selected`),
                // so a skin restyles the list without a branch here.
                int st = Style.SNormal();
                if (overRow) { st = st + Style.SHover(); }
                if (isSel) { st = st + Style.SSelected(); }
                StyleBox row = this.ResolvePartAs(app, "select", "option", "option",
                                                   Class, st);
                row.Paint(app, popX + 1, oy, w - 2, optH);
                int rowFs = row.FontOr(fs);
                int rowPad = row.PadLOr(t.paddingSmall);
                int oMaxW = w - rowPad - arrowSlot - t.paddingSmall;
                c.DrawText(popX + rowPad,
                    oy + (optH - Canvas.FontHeight(rowFs)) / 2,
                    Ellipsis.Fit(opts[i].label, oMaxW, rowFs),
                    row.FgOr(States.Text(t, isSel, false)), rowFs);
                if (isSel) {
                    StyleBox checkStyle = this.ResolvePartAs(app, "select", "checkmark", "",
                                                              Class, st);
                    int checkSize = checkStyle.FontOr(t.iconSizeSmall);
                    c.DrawGlyphIn("check", popX + w - arrowSlot, oy,
                        arrowSlot, optH, checkSize,
                        checkStyle.FgOr(checkStyle.AccentOr(row.AccentOr(t.primary))));
                }
            }
            i = i + 1;
        }
        c.PopClip();

        // Popup scrollbar (clipped to the popup, clamped to its track).
        if (contentH > viewH && viewH > 0) {
            StyleBox scrollbarStyle = this.ResolvePartAs(app, "select", "scrollbar", "",
                                                          Class, Style.SSelected());
            int barW = scrollbarStyle.WidthOr(app.Scale(6));
            int bx = popX + w - barW - app.Scale(2);
            int minThumb = app.Scale(24);
            if (minThumb > viewH) { minThumb = viewH; }
            int thumbH = viewH * viewH / contentH;
            if (thumbH < minThumb) { thumbH = minThumb; }
            if (thumbH > viewH) { thumbH = viewH; }
            int travel = viewH - thumbH;
            if (travel < 0) { travel = 0; }
            int thumbY = popY;
            if (maxScroll > 0) { thumbY = popY + scrollY * travel / maxScroll; }
            if (thumbY < popY) { thumbY = popY; }
            if (thumbY + thumbH > popY + viewH) { thumbY = popY + viewH - thumbH; }
            c.PushClip(popX, popY, w, viewH);
            c.FillRoundRect(bx, thumbY, barW, thumbH,
                            scrollbarStyle.RadiusOr(barW / 2),
                            scrollbarStyle.BgOr(t.scrollbar));
            c.PopClip();
        }

        // ---- centralized popup input (overlay pass, above content) ----
        // ClickAvailable() is false on the frame the popup opened (the opening
        // click was claimed) so the popup never self-closes on open.
        if (app.ClickAvailable()) {
            if (overPopup) {
                int rel = app.mouseY - popY + scrollY;
                int idx = rel / optH;
                if (idx >= 0 && idx < opts.Count) {
                    this.Choose(idx);
                    if (!multi) { this.SetOpen(false); }
                    app.ClaimClick();
                    app.RequestRedraw();
                }
            } else {
                // Press anywhere outside the popup (incl. the trigger) closes.
                this.SetOpen(false);
                app.RequestRedraw();
            }
        }
        if (ek == 4 && app.window.EventKeyCode() == 27) {
            this.SetOpen(false);
            app.RequestRedraw();
        }
    }
}
