using System;
using Gui;

namespace Gui.Widget;

/// A single timeline entry: a time/meta label, a title, a description and the
/// classes its dot carries (`success`, `error`, … — the shared semantic roles).
class TimelineItem {
    string time;
    string title;
    string description;
    string cls;

    static TimelineItem Create(string time, string title, string description) {
        return TimelineItem.Create(time, title, description, "");
    }

    static TimelineItem Create(string time, string title, string description,
                               string cls) {
        TimelineItem it = new TimelineItem();
        it.time = time;
        it.title = title;
        it.description = description;
        it.cls = cls;
        return it;
    }
}

/// A vertical timeline: a dot and a connector per entry, with a time / title /
/// description block beside it. Dots, connector and the three text lines are
/// styled parts (`timeline::dot`, `::line`, `::time`, `::title`, `::desc`), so a
/// skin restyles them and the code side is plain assignment:
///
///     Timeline tl = new Timeline { Class = "primary" };
///     tl.AddItem("09:00", "Created", "Project initialized");
///     tl.Add(TimelineItem.Create("12:30", "Published", "", "success"));
class Timeline : Control {
    List<TimelineItem> items;

    void InitTimeline() {
        this.InitControl("timeline", 1);
        items = new List<TimelineItem>();
    }

    Timeline() { InitTimeline(); }

    void Add(TimelineItem it) { items.Add(it); }

    /// A timeline over an already-built item list.
    static Timeline Of(List<TimelineItem> its) {
        Timeline tl = new Timeline();
        int i = 0;
        while (i < its.Count) { tl.Add(its[i]); i = i + 1; }
        return tl;
    }

    void AddItem(string time, string title, string desc) {
        items.Add(TimelineItem.Create(time, title, desc));
    }

    override void OnMeasure(App app) {
        StyleBox s = this.ResolveStyleAs(app, "timeline", Class,
                                         Style.SNormal());
        prefH = Timeline.RowHeight(app) * items.Count;
        prefW = s.WidthOr(app.Scale(240));
    }

    override void OnPaint(App app) {
        string cls = Class;

        Canvas c = app.canvas;
        Theme t = app.theme;
        StyleBox s = Style.Of(app, "timeline", cls, Style.SNormal());
        StyleBox ln = Style.Part(app, "timeline", "line", "", cls, "",
                                 Style.SNormal());
        StyleBox tm = Style.Part(app, "timeline", "time", "", cls, "",
                                 Style.SNormal());
        StyleBox ti = Style.Part(app, "timeline", "title", "", cls, "",
                                 Style.SNormal());
        StyleBox de = Style.Part(app, "timeline", "desc", "", cls, "",
                                 Style.SNormal());

        int n = items.Count;
        int rowH = Timeline.RowHeight(app);
        int dotR = app.Scale(5);
        int lw = ln.HeightOr(app.Scale(2));
        int lineX = bx + dotR;
        int timeFont = tm.FontOr(t.fontSizeSmall);
        int titleFont = ti.FontOr(t.fontSizeMedium);
        int descFont = de.FontOr(t.fontSizeSmall);

        int i = 0;
        while (i < n) {
            TimelineItem it = items[i];
            int top = by + i * rowH;
            int cy = top + dotR + app.Scale(2);
            if (i < n - 1) {
                c.FillRect(lineX - lw / 2, cy, lw, rowH,
                           ln.BgOr(t.divider));
            }
            // The entry's own classes select its dot, so one errored step is a
            // class on the record, not a colour argument at the call site.
            StyleBox dot = Style.Part(app, "timeline", "dot", "",
                                      cls + " " + it.cls, "", Style.SNormal());
            int dotColor = dot.BgOr(Style.RoleBase(t, it.cls));
            if (dotColor == 0) { dotColor = s.AccentOr(t.primary); }
            c.FillCircle(lineX, cy, dot.HeightOr(dotR * 2) / 2, dotColor);

            int tx = bx + dotR * 2 + t.gapLarge;
            int ty = top;
            if (it.time != "") {
                c.DrawText(tx, ty, it.time, tm.FgOr(t.textTertiary), timeFont);
                ty = ty + Canvas.FontHeight(timeFont) + t.paddingTiny;
            }
            c.DrawText(tx, ty, it.title, ti.FgOr(t.textPrimary), titleFont);
            ty = ty + Canvas.FontHeight(titleFont) + t.gapSmall;
            if (it.description != "") {
                c.DrawText(tx, ty, it.description, de.FgOr(t.textSecondary),
                           descFont);
            }
            i = i + 1;
        }
    }



    static int RowHeight(App app) {
        Theme t = app.theme;
        return Canvas.FontHeight(t.fontSizeSmall)
             + Canvas.FontHeight(t.fontSizeMedium)
             + Canvas.FontHeight(t.fontSizeSmall)
             + t.paddingTiny + t.gapSmall + t.paddingMedium;
    }





    // ---- designer / serialization model -------------------------------------

    override string Kind() { return "Timeline"; }

    override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        ps.Add(PropSpec.Text("class", "Classes"));
        return ps;
    }
}
