using System;
using Gui;

namespace Gui.Widget;

/// 每轮播图一个过渡状态，独立成对象，使每帧重建
/// 控件的宿主仍能持有进行中的动画。
class CarouselAnim {
    int shown;
    int from;
    int startFrame;
    bool animating;
    int dir;

    CarouselAnim() {
        this.shown = 0;
        this.from = 0;
        this.startFrame = 0;
        this.animating = false;
        this.dir = 1;
    }
}

/// 轮播图：带上一张/下一张箭头和指示点的滑动面板。当前
/// 页为双向绑定；`Animate(anim)` 在变化时
/// 水平滑动面板。
///
///     Carousel car = Carousel.Of(slides, idx);
///     car.Animate(Gallery.carAnim);
///     car.RenderInside(app, rect);
/// 轮播的覆盖层：箭头与指示点必须浮在控件页（图片页）之上，而
/// RenderTree 先画父节点自己的 OnPaint 再画子树，父级里画的部件
/// 会被图片页盖住。覆盖层作为最后一个子控件参与子树绘制，天然
/// 位于所有页面之上；箭头/指示点的命中登记与点击处理也在这里做，
/// 保持"同一帧内先登记后派发"的次序。
class CarouselChrome : Control {
    Carousel owner;

    void InitChrome(Carousel c) {
        this.InitControl("carousel-chrome", 0);
        owner = c;
        wiresOwnEvents = true;
    }

    CarouselChrome(Carousel c) { InitChrome(c); }

    override void OnPaint(App app) {
        if (owner == null) { return; }
        owner.EnsureIds();
        int count = owner.slides.Count;
        if (count == 0) { return; }
        int cur = owner.model.Get();
        if (cur < 0) { cur = 0; }
        if (cur >= count) { cur = count - 1; }
        owner.PaintChrome(app, count, cur);
        if (this.IsDisabled() || app.EventKind() != 3) { return; }
        int hit = app.ClickTarget();
        if (hit == owner.baseId) {
            owner.GoTo(app, owner.model.Get() - 1);
        } else if (hit == owner.baseId + 1) {
            owner.GoTo(app, owner.model.Get() + 1);
        } else if (hit >= owner.baseId + 2
            && hit < owner.baseId + 2 + count) {
            owner.GoTo(app, hit - owner.baseId - 2);
        }
    }
}

class Carousel : Control {
    List<string> slides;
    SignalInt model;
    /// 双向绑定的当前页索引。
    Binding<int> Index;
    CarouselAnim anim;
    /// 当前页变化时触发。
    UiEvent Change;
    int baseId;
    int idCount;
    /// 自动播放：每 intervalMs 毫秒翻到下一页（Naive UI autoplay）。
    bool autoplay;
    /// 自动播放间隔（毫秒）。默认 3000。
    int intervalMs;
    /// 指示点位置：bottom / top / left / right（Naive UI dot-placement）。
    string dotPlacement;
    /// 上次翻页时刻（autoplay 用）。
    int lastTickMs;
    /// 箭头/指示点覆盖层：始终是最后一个子控件，见 CarouselChrome。
    CarouselChrome chrome;
    /// 控件页（AddSlideView 加入）：与 slides 平行的子控件列表。页面
    /// 就是真正的控件（典型是 Gui.Widget.Image——文件路径 / data URI /
    /// http(s) URL / SVG 的地址语义全部由 Image 承担），由轮播负责
    /// 排布、可见性与过渡。null = 全部是文字页。
    List<Control> slideViews;

    void InitCarousel(SignalInt m) {
        this.InitControl("carousel", 1);
        slides = new List<string>();
        model = m;
        anim = null;
        baseId = 0;
        idCount = 0;
        wiresOwnEvents = true;
        Change = new UiEvent();
        autoplay = false;
        intervalMs = 3000;
        dotPlacement = "bottom";
        slideViews = null;
        // chrome 惰性挂载：首次 Arrange 时滑片都已 Add 完，把它追加为
        // 最后一个子控件，绘制顺序才能压在控件页（如 Image）之上。
        chrome = null;
    }

    Carousel() { InitCarousel(new SignalInt(0)); }
    Carousel(SignalInt m) { InitCarousel(m); }

    /// 命名为 AddSlide（而非 Add），以免遮蔽 Control.Add(Control)。
    void AddSlide(string label) { slides.Add(label); }

    /// 加入一个控件页：v 成为轮播的子控件并占满整个轮播框，裁剪与
    /// 过渡动画由轮播管理。与 AddSlide 可混用（控件页的标题留空）。
    void AddSlideView(Control v) {
        slides.Add("");
        if (slideViews == null) { slideViews = new List<Control>(); }
        slideViews.Add(v);
        this.Add(v);
    }

    static Carousel Of(List<string> labels, SignalInt m) {
        Carousel car = new Carousel(m);
        for (int i = 0; i < labels.Count; i = i + 1) {
            car.AddSlide(labels[i]);
        }
        return car;
    }

    /// 滑动离开和进入的面板；`state` 由宿主持有，
    /// 因此控件重建后过渡依然继续。
    Carousel Animate(CarouselAnim state) {
        anim = state;
        return this;
    }

    /// 上一张、下一张，然后每个指示点一个 id，作为连续块预留。
    void EnsureIds() {
        int need = slides.Count + 2;
        if (idCount >= need) { return; }
        baseId = WidgetId.Block(need);
        idCount = need;
    }

    void SyncBinding() {
        if (Index == null) { return; }
        int cur = Index.Get();
        if (cur != model.Get()) { model.Set(cur); }
    }

    void GoTo(App app, int i) {
        int count = slides.Count;
        if (count == 0) { return; }
        int v = i;
        if (v < 0) { v = count - 1; }
        if (v >= count) { v = 0; }
        if (v == model.Get()) { return; }
        model.Set(v);
        if (Index != null) { Index.Set(v); }
        Change.Raise();
        app.RequestRedraw();
    }

    override void Arrange(int px, int py, int pw, int ph) {
        if (pw < 0) { pw = 0; }
        if (ph < 0) { ph = 0; }
        bx = px;
        by = py;
        bw = pw;
        bh = ph;
        if (slideViews != null) {
            for (int i = 0; i < slideViews.Count; i = i + 1) {
                slideViews[i].Arrange(px, py, pw, ph);
            }
        }
        if (chrome == null) {
            chrome = new CarouselChrome(this);
            this.Add(chrome);
        }
        chrome.Arrange(px, py, pw, ph);
    }

    override void OnMeasure(App app) {
        string origClass = Class;
        // dot-placement 映射为 Class：皮肤通过 carousel.dots-top
        // 等规则移动指示点位置。
        if (dotPlacement == "top") { this.AddClass("dots-top"); }
        else if (dotPlacement == "left") { this.AddClass("dots-left"); }
        else if (dotPlacement == "right") { this.AddClass("dots-right"); }
        StyleBox s = this.ResolveStyleAs(app, "carousel", Class,
                                        Style.SNormal());
        prefW = s.WidthOr(app.Scale(320));
        prefH = s.HeightOr(app.Scale(160));
        Class = origClass;
    }

    override void OnPaint(App app) {
        Canvas c = app.canvas;
        this.SyncBinding();
        // autoplay 计时：每 intervalMs 毫秒翻页一帧。
        if (autoplay && slides.Count > 1) {
            int now = Window.GetTickMs();
            if (lastTickMs == 0) { lastTickMs = now; }
            if (now - lastTickMs >= intervalMs) {
                lastTickMs = now;
                int nxt = (model.Get() + 1) % slides.Count;
                model.Set(nxt);
                if (Index != null) { Index.Set(nxt); }
                Change.Raise();
            }
            app.RequestRedraw();
        }
        this.EnsureIds();
        int count = slides.Count;
        if (count == 0) { return; }
        int cur = model.Get();
        if (cur < 0) { cur = 0; }
        if (cur >= count) { cur = count - 1; }

        this.ShowSlides(cur, cur, 0, 1);
        c.PushClip(bx, by, bw, bh);
        if (anim == null) {
            this.PaintSlide(app, bx, cur);
        } else {
            // 目标索引变化时启动过渡。
            if (!anim.animating && anim.shown != cur) {
                anim.from = anim.shown;
                anim.animating = true;
                anim.startFrame = app.frameCount;
                if (cur == (anim.from - 1 + count) % count) { anim.dir = 0 - 1; }
                else { anim.dir = 1; }
            }
            int dur = 10;
            int prog = 1000;
            if (anim.animating) {
                int elapsed = app.frameCount - anim.startFrame;
                prog = elapsed * 1000 / dur;
                if (prog >= 1000) {
                    prog = 1000;
                    anim.animating = false;
                    anim.shown = cur;
                }
            }
            if (anim.animating) {
                int shift = bw * prog / 1000;
                int outX = bx - anim.dir * shift;
                int inX = outX + anim.dir * bw;
                this.ShowSlides(anim.from, cur, shift, anim.dir);
                this.PaintSlide(app, outX, anim.from);
                this.PaintSlide(app, inX, cur);
                app.RequestRedraw();
            } else {
                this.ShowSlides(cur, cur, 0, 1);
                this.PaintSlide(app, bx, cur);
            }
        }
        c.PopClip();

        // 箭头/指示点由覆盖层子控件在子树绘制阶段画，天然位于
        // 控件页（图片页）之上；命中处理也在覆盖层里。
    }

    /// 让控件页与过渡状态一致：静止帧只有当前页可见（占满轮播框）；
    /// 过渡帧离开页停在 bx-dir*shift、进入页在进入位，其余页隐藏。
    /// 控件的 OnPaint 之后才会画子树，所以这里赶在子树绘制前把
    /// 矩形与可见性摆好即可。
    void ShowSlides(int from, int to, int shift, int dir) {
        if (slideViews == null) { return; }
        for (int i = 0; i < slideViews.Count; i = i + 1) {
            if (slideViews[i] == null) { continue; }
            if (i == from || i == to) {
                int x = bx;
                if (i == from && from != to) { x = bx - dir * shift; }
                slideViews[i].Arrange(x, by, bw, bh);
                slideViews[i].SetShown(true);
            } else {
                slideViews[i].SetShown(false);
            }
        }
    }

    /// 在任意 x 位置绘制一张幻灯片（主体 + 居中标签），过渡时可
    /// 并排绘制离开和进入的面板。控件页自己会画（RenderTree 的
    /// 子树遍历），这里只负责文字页。
    void PaintSlide(App app, int x, int i) {
        if (slideViews != null && i < slideViews.Count
            && slideViews[i] != null) {
            return;
        }
        Canvas c = app.canvas;
        Theme t = app.theme;
        int roleIndex = i % 5;
        string role = "primary";
        if (roleIndex == 1) { role = "info"; }
        else if (roleIndex == 2) { role = "warning"; }
        else if (roleIndex == 3) { role = "error"; }
        else if (roleIndex == 4) { role = "success"; }
        StyleBox s = this.ResolvePartAs(app, "carousel", "slide", "",
                                        Class + " " + role, Style.SNormal());
        StyleBox caption = this.ResolvePartAs(app, "carousel", "caption", "",
                                              Class, Style.SNormal());
        // 裁剪到幻灯片区域，防止长标签溢出边界。
        c.PushClip(x, by, bw, bh);
        c.FillRoundRect(x, by, bw, bh, s.RadiusOr(t.borderRadiusLarge), s.BgOr(0));
        int fs = caption.FontOr(
            s.FontOr(Style.FontFallback(app, "huge")));
        int tw = Canvas.MeasureText(slides[i], fs);
        c.DrawText(x + (bw - tw) / 2, Canvas.CenterTextY(by, bh, fs),
                   slides[i], caption.FgOr(0), fs);
        c.PopClip();
    }

    /// 箭头和指示点，以及各自的点击区域。
    void PaintChrome(App app, int count, int cur) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        StyleBox arrow = this.ResolvePartAs(app, "carousel", "arrow", "", Class,
                                            Style.SNormal());
        StyleBox dotStyle = this.ResolvePartAs(app, "carousel", "dot", "", Class,
                                               Style.SNormal());
        StyleBox dotOn = this.ResolvePartAs(app, "carousel", "dot", "", Class,
                                            Style.SSelected());

        int ab = arrow.HeightOr(t.heightMedium);
        int ay = by + (bh - ab) / 2;
        int prevX = bx + t.paddingMedium;
        int nextX = bx + bw - ab - t.paddingMedium;
        int abg = arrow.BgOr(0);
        c.FillRoundRect(prevX, ay, ab, ab, arrow.RadiusOr(ab / 2), abg);
        c.FillRoundRect(nextX, ay, ab, ab, arrow.RadiusOr(ab / 2), abg);
        int gl = arrow.WidthOr(t.iconSizeSmall);
        int afg = arrow.FgOr(0);
        c.DrawGlyphIn("arrow-left", prevX, ay, ab, ab, gl, afg);
        c.DrawGlyphIn("arrow-right", nextX, ay, ab, ab, gl, afg);
        app.hitTester.RegisterRect(baseId, prevX, ay, ab, ab, 0);
        app.hitTester.RegisterRect(baseId + 1, nextX, ay, ab, ab, 0);

        int dot = dotStyle.HeightOr(t.gapSmall);
        int dotGap = dotStyle.GapOr(t.gapSmall);
        int dotsW = count * dot + (count - 1) * dotGap;
        int dx = bx + (bw - dotsW) / 2;
        int dy = by + bh - t.paddingLarge;
        for (int i = 0; i < count; i = i + 1) {
            int dcolor = dotStyle.BgOr(0);
            int dw = dot;
            if (i == cur) {
                dcolor = dotOn.BgOr(0);
                dw = dot * 2;
            }
            c.FillRoundRect(dx, dy, dw, dot, dot / 2, dcolor);
            app.hitTester.RegisterRect(baseId + 2 + i, dx,
                                                    dy - dot, dw + dot,
                                                    dot * 3, 0);
            dx = dx + dw + dotGap;
        }
    }

    // ---- 设计器 / 序列化模型 ----

    override string Kind() { return "Carousel"; }

    override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        ps.Add(PropSpec.Text("slides", "Slide labels (comma separated)"));
        PropSpec idx = PropSpec.Int("index", "Active slide");
        idx.snum = model;
        ps.Add(idx);
        PropSpec ap = PropSpec.Bool("autoplay", "Autoplay");
        ap.flag = autoplay;
        ap.WithTip("Auto-advance every intervalMs (Naive UI autoplay).");
        ps.Add(ap);
        PropSpec iv = PropSpec.Int("interval", "Interval (ms)");
        iv.num = intervalMs;
        iv.Step(100, 500, 60000);
        ps.Add(iv);
        PropSpec dp = PropSpec.Enum("dotPlacement", "Dot placement",
            new List<string>{ "bottom", "top", "left", "right" });
        dp.num = 0;
        ps.Add(dp);
        ps.Add(PropSpec.Text("class", "Classes"));
        return ps;
    }

    /// 幻灯片是列表，因此以逗号分隔的值序列化。
    override string GetExtra(string key) {
        if (key == "slides") { return string.Join(",", slides); }
        return "";
    }

    override bool SetExtra(string key, string val) {
        if (key == "slides") { slides = val.Split(","); return true; }
        return false;
    }

    override List<string> Events() {
        List<string> e = Control.CommonEvents();
        e.Add("Change");
        return e;
    }

    override void BindEvent(string evt, Action a) {
        if (evt == "Change") { Change.Add(a); return; }
        On.AddByName(evt, a);
    }
}
