using System;
using Gui;

namespace Gui.Widget;

/// 带响应式页码绑定的分页组件。页数较多时，中间会
/// 用省略号窗口化（NaiveUI 风格）：1 … 4 5 [6] 7 8 … 200。
///
/// 外观来自类列表：`small` 缩小按钮，`pill` 让按钮变圆，
/// `simple` 把按钮条收窄成“prev  cur / total  next”。
///
///     Pagination pg = new Pagination(12, page);
///     pg.Class = "pill";
///     pg.RenderAt(app, x, y);
class Pagination : Control {
    SignalInt model;
    /// 双向绑定的当前页，从 1 开始。
    Binding<int> Page;
    int totalPages;
    /// 页码变化后触发。
    UiEvent Change;
    int baseId;
    int idCount;

    void InitPagination(int total, SignalInt m) {
        this.InitControl("pagination", 1);
        totalPages = total;
        model = m;
        baseId = 0;
        idCount = 0;
        wiresOwnEvents = true;
        Change = new UiEvent();
    }

    Pagination() : this(1) { }
    Pagination(int total) { InitPagination(total, new SignalInt(1)); }
    Pagination(int total, SignalInt m) { InitPagination(total, m); }

    static Pagination Of(int total, SignalInt m) {
        return new Pagination(total, m);
    }

    void SetTotal(int total) { totalPages = total; }
    int Total() { return totalPages; }

    /// 为当前页构建可见页码列表。值 0 表示
    /// 省略号占位。小范围（<= 7 页）显示全部页码。
    static List<int> BuildPages(int totalPages, int current) {
        List<int> r = new List<int>();
        if (totalPages <= 7) {
            int i = 1;
            while (i <= totalPages) { r.Add(i); i = i + 1; }
            return r;
        }
        r.Add(1);
        int lo = current - 1;
        int hi = current + 1;
        if (lo < 2) { lo = 2; }
        if (hi > totalPages - 1) { hi = totalPages - 1; }
        if (lo > 2) { r.Add(0); }
        int p = lo;
        while (p <= hi) { r.Add(p); p = p + 1; }
        if (hi < totalPages - 1) { r.Add(0); }
        r.Add(totalPages);
        return r;
    }

    /// 给定页数下控件的总像素宽度，供调用方
    /// 居中放置。与绘制时所用的条目布局一致。
    static int MeasureWidth(App app, int totalPages, int current) {
        Theme t = app.theme;
        int btnSize = t.heightMedium;
        int gap = t.gapSmall;
        List<int> pages = Pagination.BuildPages(totalPages, current);
        int count = pages.Count + 2; // 上一页 + 页码 + 下一页
        return count * (btnSize + gap) - gap;
    }

    int ButtonSize(App app, StyleBox s) {
        if (Style.Has(Class, "small")) {
            return s.HeightOr(app.theme.heightSmall);
        }
        return s.HeightOr(app.theme.heightMedium);
    }

    int FontSize(App app, StyleBox s) {
        if (Style.Has(Class, "small")) {
            return s.FontOr(Style.FontFallback(app, "small"));
        }
        return s.FontOr(Style.FontFallback(app, "medium"));
    }

    int Radius(App app, StyleBox s, int btnSize) {
        if (Style.Has(Class, "pill")) { return s.RadiusOr(btnSize / 2); }
        return s.RadiusOr(app.theme.borderRadiusSmall);
    }

    /// Prev、每个窗口条目一个 id（含省略号，使 id 与
    /// 布局对齐）以及 next；作为连续块一次性保留。
    void EnsureIds(int entries) {
        int need = entries + 2;
        if (idCount >= need) { return; }
        baseId = WidgetId.Block(need);
        idCount = need;
    }

    void GoTo(App app, int pg) {
        if (pg < 1 || pg > totalPages || pg == model.Get()) { return; }
        model.Set(pg);
        if (Page != null) { Page.Set(pg); }
        Change.Raise();
        app.RequestRedraw();
    }

    void SyncBinding() {
        if (Page == null) { return; }
        int cur = Page.Get();
        if (cur != model.Get()) { model.Set(cur); }
    }

    override void OnMeasure(App app) {
        StyleBox s = this.ResolveStyleAs(app, "pagination", Class,
                                        Style.SNormal());
        int btnSize = this.ButtonSize(app, s);
        int gap = s.GapOr(app.theme.gapSmall);
        prefH = btnSize;
        if (Style.Has(Class, "simple")) {
            prefW = btnSize * 4 + gap * 2;
            return;
        }
        List<int> pages = Pagination.BuildPages(totalPages, model.Get());
        prefW = (pages.Count + 2) * (btnSize + gap) - gap;
    }

    override void OnPaint(App app) {
        this.SyncBinding();
        if (Style.Has(Class, "simple")) {
            this.PaintSimple(app);
            return;
        }
        Canvas c = app.canvas;
        Theme t = app.theme;
        StyleBox s = this.ResolveStyleAs(app, "pagination", Class,
                                        Style.SNormal());
        StyleBox item = this.ResolvePartAs(app, "pagination", "item", "", Class,
                                          Style.SNormal());
        StyleBox sel = this.ResolvePartAs(app, "pagination", "item", "", Class,
                                         Style.SSelected());
        StyleBox arrow = this.ResolvePartAs(app, "pagination", "arrow", "",
                                            Class, Style.SNormal());
        int btnSize = this.ButtonSize(app, s);
        int radius = this.Radius(app, item, btnSize);
        int fontSize = this.FontSize(app, s);
        int gap = s.GapOr(t.gapSmall);
        int ico = arrow.WidthOr(t.iconSizeSmall);
        int current = model.Get();
        List<int> pages = Pagination.BuildPages(totalPages, current);
        this.EnsureIds(pages.Count);

        int cx = bx;
        this.PaintArrow(app, "chevron-left", baseId, cx, btnSize, radius, ico,
                        current <= 1, item, arrow);
        cx = cx + btnSize + gap;

        int i = 0;
        for (; i < pages.Count; i = i + 1) {
            int pageId = baseId + 1 + i;
            int pg = pages[i];
            if (pg == 0) {
                StyleBox el = this.ResolvePartAs(app, "pagination", "ellipsis",
                                                 "", Class, Style.SNormal());
                c.DrawTextCentered(cx, by, btnSize, btnSize, "…",
                                   el.FgOr(0),
                                   el.FontOr(fontSize));
            } else {
                bool active = pg == current;
                int bg = item.BgOr(0);
                int textColor = item.FgOr(0);
                int borderC = item.BorderOr(0);
                if (active) {
                    bg = sel.BgOr(0);
                    textColor = sel.FgOr(0);
                    borderC = sel.BorderOr(0);
                } else if (app.focus.IsHovered(pageId)) {
                    StyleBox hov = this.ResolvePartAs(app, "pagination", "item",
                                                      "", Class, Style.SHover());
                    bg = hov.BgOr(0);
                    borderC = hov.BorderOr(0);
                }
                c.SurfaceRoundRect(cx, by, btnSize, btnSize, radius, bg,
                                   borderC, item.BorderWOr(1));
                c.DrawTextCentered(cx, by, btnSize, btnSize,
                                   Convert.ToString(pg), textColor, fontSize);
                app.hitTester.RegisterRect(pageId, cx, by, btnSize,
                                                        btnSize, 0);
            }
            cx = cx + btnSize + gap;
        }

        int nextId = baseId + 1 + pages.Count;
        this.PaintArrow(app, "chevron-right", nextId, cx, btnSize, radius, ico,
                        current >= totalPages, item, arrow);

        if (this.IsDisabled() || app.EventKind() != 3) { return; }
        int hit = app.ClickTarget();
        if (hit == baseId) { this.GoTo(app, current - 1); return; }
        if (hit == nextId) { this.GoTo(app, current + 1); return; }
        i = 0;
        while (i < pages.Count) {
            if (hit == baseId + 1 + i) {
                if (pages[i] != 0) { this.GoTo(app, pages[i]); }
                return;
            }
            i = i + 1;
        }
    }

    /// 一个 prev/next 控件：一个表面、一个在范围末端置灰的箭头，
    /// 以及它的命中区域。
    void PaintArrow(App app, string glyph, int id, int cx, int btnSize,
                    int radius, int ico, bool atEnd, StyleBox item,
                    StyleBox arrow) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int bg = item.BgOr(0);
        if (app.focus.IsHovered(id) && !atEnd) {
            bg = this.ResolvePartAs(app, "pagination", "item", "", Class,
                                    Style.SHover()).BgOr(0);
        }
        StyleBox disabledArrow = this.ResolvePartAs(app, "pagination", "arrow", "",
                                                    Class, Style.SDisabled());
        int fg = (atEnd ? disabledArrow : arrow).FgOr(0);
        c.SurfaceRoundRect(cx, by, btnSize, btnSize, radius, bg,
                           item.BorderOr(0),
                           item.BorderWOr(1));
        c.DrawGlyph(glyph, cx + (btnSize - ico) / 2, by + (btnSize - ico) / 2,
                    ico, fg);
        app.hitTester.RegisterRect(id, cx, by, btnSize, btnSize, 0);
    }

    /// `simple` 类：prev 箭头、“current / total”文本、next 箭头。
    void PaintSimple(App app) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        StyleBox s = this.ResolveStyleAs(app, "pagination", Class,
                                        Style.SNormal());
        StyleBox item = this.ResolvePartAs(app, "pagination", "item", "", Class,
                                          Style.SNormal());
        StyleBox arrow = this.ResolvePartAs(app, "pagination", "arrow", "",
                                            Class, Style.SNormal());
        StyleBox lbl = this.ResolvePartAs(app, "pagination", "label", "", Class,
                                          Style.SNormal());
        int btnSize = this.ButtonSize(app, s);
        int radius = this.Radius(app, item, btnSize);
        int gap = s.GapOr(t.gapSmall);
        int ico = arrow.WidthOr(t.iconSizeSmall);
        int cur = model.Get();
        this.EnsureIds(1);

        int cx = bx;
        this.PaintArrow(app, "chevron-left", baseId, cx, btnSize, radius, ico,
                        cur <= 1, item, arrow);
        cx = cx + btnSize + gap;

        int textW = btnSize * 2;
        c.DrawTextCentered(cx, by, textW, btnSize,
            Convert.ToString(cur) + " / " + Convert.ToString(totalPages),
            lbl.FgOr(0), lbl.FontOr(Style.FontFallback(app, "medium")));
        cx = cx + textW + gap;

        int nextId = baseId + 2;
        this.PaintArrow(app, "chevron-right", nextId, cx, btnSize, radius, ico,
                        cur >= totalPages, item, arrow);

        if (this.IsDisabled() || app.EventKind() != 3) { return; }
        int hit = app.ClickTarget();
        if (hit == baseId) { this.GoTo(app, cur - 1); }
        else if (hit == nextId) { this.GoTo(app, cur + 1); }
    }

    // ---- 设计器 / 序列化模型 ----

    override string Kind() { return "Pagination"; }

    override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec total = PropSpec.Int("total", "Page count");
        total.num = totalPages;
        ps.Add(total);
        PropSpec pg = PropSpec.Int("page", "Current page");
        pg.snum = model;
        ps.Add(pg);
        PropSpec sz = PropSpec.Int("pageSize", "Page size");
        sz.num = 10;
        sz.WithTip("Rows per page (read by host; not drawn by the widget).");
        ps.Add(sz);
        PropSpec sizes = PropSpec.Text("pageSizes", "Page sizes");
        sizes.str = "10, 20, 50, 100";
        sizes.WithTip("Comma-separated selectable page sizes (read by host).");
        ps.Add(sizes);
        PropSpec sh = PropSpec.Bool("showTotal", "Show total/total");
        sh.flag = false;
        sh.WithTip("Show 'cur/total' text (simple mode already shows it).");
        ps.Add(sh);
        ps.Add(PropSpec.Text("class", "Classes"));
        return ps;
    }

    override List<string> Events() {
        List<string> e = Control.CommonEvents();
        e.Add("Change");
        return e;
    }

    override void BindEvent(string evt, Action a) {
        if (evt == "Change") { Change.Add(a); return; }
        On.AddByName(evt, a);
    }
}
