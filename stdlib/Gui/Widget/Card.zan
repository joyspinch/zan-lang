using System;
using Gui;

namespace Gui.Widget;

/// Card container with title, divider, and shadow. Its surface is resolved from
/// the style layer (`card` / `card.<class>` rules in the skin's CSS over the
/// theme's surface defaults), so a skin restyles cards without touching this
/// code; `WithFx` adds opt-in motion on top.
class Card : Control {
    string title;
    FxOptions fx;
    /// Style classes for CSS selectors (`card.hero`), space separated.
    string cls;

    void InitCard(string ttl) {
        this.InitControl(ttl, 5);
        styleSurfaceOwned = true;
        title = ttl;
        fx = null;
        cls = "";
    }

    /// Style classes used to match `card.<name>` rules in the active skin.
    Card WithClass(string names) {
        cls = names;
        return this;
    }

    /// Opt-in motion, configured as data: `card.WithFx(o)` where `o` picks the
    /// effects (aurora/sheen/motes/breath/borderGlow/spotlight). All of them
    /// draw clipped inside the card, behind its content.
    Card WithFx(FxOptions o) {
        fx = o;
        return this;
    }

    /// Retained-mode container: `Card c = new Card("Profile"); c.Add(child);`
    Card(string ttl) {
        InitCard(ttl);
    }

    override void OnMeasure(App app) {
        Theme t = app.theme;
        StyleBox s = Style.Of(app, "card", cls, Style.SNormal());
        Style.Inline(s, this);
        padL = s.PadLOr(t.paddingLarge);
        padR = s.PadROr(t.paddingLarge);
        padB = s.PadBOr(t.paddingLarge);
        if (title != "") {
            padT = t.heightMedium + t.paddingSmall + t.paddingMedium;
        } else {
            padT = s.PadTOr(t.paddingLarge);
        }
    }

    override void OnPaint(App app) {
        StyleBox s = Style.Of(app, "card", cls, Style.SNormal());
        Style.Inline(s, this);
        Card.RenderStyled(app, bx, by, bw, bh, title, fx, s);
    }

    static void Render(App app, int x, int y, int w, int h, string title) {
        Card.RenderStyled(app, x, y, w, h, title,
                          null, Style.Of(app, "card", "", Style.SNormal()));
    }

    /// Immediate-mode card with style classes (`Card.RenderAs(app, .., "hero")`).
    static void RenderAs(App app, int x, int y, int w, int h, string title,
                         string cls) {
        Card.RenderStyled(app, x, y, w, h, title,
                          null, Style.Of(app, "card", cls, Style.SNormal()));
    }

    /// Paints a card surface from an already resolved style box, then its title
    /// and divider, then any opt-in motion clipped inside it.
    static void RenderStyled(App app, int x, int y, int w, int h, string title,
                             FxOptions o, StyleBox s) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        s.Paint(app, x, y, w, h);
        if (title != "") {
            int titleY = y + t.paddingMedium;
            c.DrawText(x + s.PadLOr(t.paddingLarge), titleY, title,
                       s.FgOr(t.textPrimary), t.fontSizeLarge);
            int divY = y + t.heightMedium + t.paddingSmall;
            c.FillRect(x + 1, divY, w - 2, 1, t.divider);
        }
        if (o != null) {
            Fx.Apply(app, x, y, w, h, s.RadiusOr(t.borderRadiusMedium), o);
        }
    }

    /// Card surface + configurable motion effects (see FxOptions). The motion
    /// draws right after the surface, clipped to the card, so it sits behind
    /// the title/content and never spills onto neighbours.
    static void RenderFx(App app, int x, int y, int w, int h, string title,
                         FxOptions o) {
        Card.RenderStyled(app, x, y, w, h, title, o,
                          Style.Of(app, "card", "", Style.SNormal()));
    }

    static int ContentY(int y, Theme t) {
        return y + t.heightMedium + t.paddingSmall + t.paddingMedium;
    }

    /// Interactive card: eases an accent border highlight in on hover. Nothing
    /// moves or resizes and the highlight is drawn on the card's own rect, so it
    /// never shifts layout or paints over neighbouring content. `id` is a stable
    /// per-frame handle (e.g. app.focus.AllocId()).
    static void RenderLifted(App app, int id, int x, int y, int w, int h, string title) {
        StyleBox s = Style.Eased(app, id, "card", "", false);
        Canvas c = app.canvas;
        Theme t = app.theme;
        int hv = Ui.HoverLevel(app, id);
        Card.RenderStyled(app, x, y, w, h, title, null, s);
        if (hv > 0) {
            int hc = App.LerpColor(s.BorderOr(t.borderSecondary),
                                   s.AccentOr(t.primary), hv);
            c.DrawRoundRect(x, y, w, h, s.RadiusOr(t.borderRadiusMedium), hc,
                            app.Scale(2));
        }
        app.hitTester.Register(HitRegion.Create(id, x, y, w, h, 0));
    }
}
