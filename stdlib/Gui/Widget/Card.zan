using System;
using Gui;

namespace Gui.Widget;

/// 带标题、分隔线和阴影的卡片容器。表面由
/// 样式层解析：皮肤 CSS 中的 `card` / `card.<class>` 规则覆盖
/// 主题的表面默认值，因此换肤无需改动本
/// 代码；`WithFx` 在此基础上可选添加动效。
class Card : Control {
    string title;
    FxOptions fx;
    /// 悬停时高亮边框并接收点击，用于可点击的卡片。
    bool lifted;
    int wid;

    void InitCard(string ttl) {
        this.InitControl(ttl, 5);
        styleSurfaceOwned = true;
        title = ttl;
        fx = null;
        lifted = false;
        wid = WidgetId.Next();
    }

    /// 可选动效，以数据配置：`card.WithFx(o)`，`o` 选择
    /// 效果（aurora/sheen/motes/breath/borderGlow/spotlight）。所有效果
    /// 都在卡片内部裁剪绘制，位于内容之后。
    Card WithFx(FxOptions o) {
        fx = o;
        return this;
    }

    /// 让卡片可交互：`card.Lift()` 在悬停时
    /// 平滑显现强调边框，并把卡片矩形注册为点击区域。
    Card Lift() {
        lifted = true;
        return this;
    }

    /// 保留模式容器：`Card c = new Card("Profile"); c.Add(child);`
    Card(string ttl) {
        InitCard(ttl);
    }

    /// 无标题卡片：设计器与 `.zform` 生成的代码用 `new Card()`
    /// 建字段，没有这个构造函数就没有任何构造函数会跑，
    /// 卡片的 children 还是 null，第一次 Add 就崩。
    Card() : this("") { }

    override string Kind() { return "Card"; }

    override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec ttl = PropSpec.Text("title", "Title");
        ttl.str = title;
        ps.Add(ttl);
        PropSpec lift = PropSpec.Bool("lifted", "Lifted");
        lift.flag = lifted;
        ps.Add(lift);
        PropSpec cls = PropSpec.Text("class", "Classes");
        cls.str = Class;
        ps.Add(cls);
        return ps;
    }

    override string StyleType() { return "card"; }

    override void OnMeasure(App app) {
        Theme t = app.theme;
        StyleBox s = Style.Of(app, "card", Class, Style.SNormal());
        Style.Inline(s, this);
        padL = s.PadLOr(t.paddingLarge);
        padR = s.PadROr(t.paddingLarge);
        padB = s.PadBOr(t.paddingLarge);
        if (title != "") {
            padT = t.heightMedium + t.paddingSmall + t.paddingMedium;
        } else {
            padT = s.PadTOr(t.paddingLarge);
        }
    }

    /// 子控件从标题行及其分隔线下方开始：头部是
    /// 卡片自身的装饰，因此样式表 `padding` 只能叠加，
    /// 绝不会让内容滑到标题下面。
    override int StylePadT() {
        int styled = padT;
        if (computedStyle != null) { styled = computedStyle.PadTOr(padT); }
        if (title != "" && styled < padT) { return padT; }
        return styled;
    }

    override void OnPaint(App app) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        StyleBox s = Style.Of(app, "card", Class, Style.SNormal());
        Style.Inline(s, this);
        // 卡片可交互时悬停平滑显现强调边框；
        // 高亮绘制在卡片自身矩形上，不会引起任何位移。
        int hv = 0;
        if (lifted) {
            s = Style.Eased(app, wid, "card", Class, false);
            Style.Inline(s, this);
            hv = Ui.HoverLevel(app, wid);
        }
        s.Paint(app, bx, by, bw, bh);
        if (title != "") {
            c.DrawText(bx + s.PadLOr(t.paddingLarge), by + t.paddingMedium,
                       title, s.FgOr(t.textPrimary), t.fontSizeLarge);
            c.FillRect(bx + 1, by + t.heightMedium + t.paddingSmall, bw - 2, 1,
                       t.divider);
        }
        if (fx != null) {
            Fx.Apply(app, bx, by, bw, bh, s.RadiusOr(t.borderRadiusMedium), fx);
        }
        if (!lifted) { return; }
        if (hv > 0) {
            int hc = App.LerpColor(s.BorderOr(t.borderSecondary),
                                   s.AccentOr(t.primary), hv);
            c.DrawRoundRect(bx, by, bw, bh, s.RadiusOr(t.borderRadiusMedium),
                            hc, app.Scale(2));
        }
        app.hitTester.Register(new HitRegion(wid, bx, by, bw, bh, 0));
    }

    static int ContentY(int y, Theme t) {
        return y + t.heightMedium + t.paddingSmall + t.paddingMedium;
    }

    /// 带标题卡片的内容矩形：位于标题行及其分隔线下方，
    /// 再内缩卡片自身的水平/底部内边距。调用方
    /// 直接在此矩形内布局内容，无需重新推导头部高度。
    static Rect ContentRect(App app, int x, int y, int w, int h) {
        Theme t = app.theme;
        StyleBox s = Style.Of(app, "card", "", Style.SNormal());
        int padL = s.PadLOr(t.paddingLarge);
        int padR = s.PadROr(t.paddingLarge);
        int padB = s.PadBOr(t.paddingLarge);
        int cy = Card.ContentY(y, t);
        int cw = w - padL - padR;
        int ch = y + h - padB - cy;
        if (cw < 0) { cw = 0; }
        if (ch < 0) { ch = 0; }
        return new Rect(x + padL, cy, cw, ch);
    }

    /// 卡片为底部栏预留的高度：一行标准控件高度，
    /// 正好容纳默认尺寸的按钮。
    static int FooterHeight(Theme t) {
        return t.heightMedium;
    }

    /// 带底部栏卡片的内容矩形：底部栏上方
    /// 的全部区域，两者之间留主题的小间距。
    static Rect BodyRect(App app, int x, int y, int w, int h) {
        Theme t = app.theme;
        Rect r = Card.ContentRect(app, x, y, w, h);
        int bh = r.height - Card.FooterHeight(t) - t.paddingSmall;
        if (bh < 0) { bh = 0; }
        return new Rect(r.x, r.y, r.width, bh);
    }

    /// 卡片的底部栏：内容区最底行，与
    /// `BodyRect` 对应——两者合起来铺满内容矩形。
    static Rect FooterRect(App app, int x, int y, int w, int h) {
        Theme t = app.theme;
        Rect r = Card.ContentRect(app, x, y, w, h);
        int fh = Card.FooterHeight(t);
        if (fh > r.height) { fh = r.height; }
        return new Rect(r.x, r.y + r.height - fh, r.width, fh);
    }

}
