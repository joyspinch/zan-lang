using System;
using Gui;

namespace Gui.Widget;

/// One welded segment: its label and its stable widget id (for focus/hit).
/// One entity instead of parallel label/id lists.
class ButtonSegment {
    string label;
    int id;

    ButtonSegment(string label, int id) {
        this.label = label;
        this.id = id;
    }
}

/// <summary>
/// A NaiveUI-style attached button group: several buttons welded together with
/// shared borders (rounded only on the group's outer corners) and 1px dividers
/// between segments. Horizontal or vertical. All colours come from the theme so
/// it tracks skin changes automatically.
///
///   ButtonGroup g = ButtonGroup.Create(1);   // primary
///   g.Add("Left"); g.Add("Middle"); g.Add("Right");
///   int hit = g.Render(app, 40, 60);          // clicked index, or -1
/// </summary>
class ButtonGroup : Control {
    List<ButtonSegment> segs;
    int btnType;
    int btnStyle;
    int size;
    bool vertical;

    /// Bar mode (absorbed from the old ButtonBar): a retained strip of real
    /// Button controls that wraps when narrow and reports which one was
    /// pressed. When `barMode` is false the widget is the welded segmented
    /// group rendered immediately through `Render(app, x, y)`.
    bool barMode;
    List<Button> barBtns;
    int pressed;
    int lineH;
    int lines;

    static ButtonGroup Create(int type) {
        ButtonGroup g = new ButtonGroup();
        g.segs = new List<ButtonSegment>();
        g.btnType = type;
        g.btnStyle = 0;
        g.size = 2;
        g.vertical = false;
        g.barMode = false;
        g.barBtns = new List<Button>();
        g.pressed = 0 - 1;
        g.lineH = 0;
        g.lines = 1;
        return g;
    }

    ButtonGroup Add(string label) {
        segs.Add(new ButtonSegment(label, WidgetId.Next()));
        return this;
    }

    ButtonGroup Outline(bool o) { if (o) { btnStyle = 1; } else { btnStyle = 0; } return this; }
    ButtonGroup Vertical(bool v) { vertical = v; return this; }
    ButtonGroup SetSize(int s) { size = s; return this; }

    /// A retained horizontal strip of Button controls (the old ButtonBar).
    /// Add buttons with AddButton(); it lays them out, wraps when narrow and
    /// reports the pressed index via TakePressed(). Usable as a layout child.
    static ButtonGroup Bar(string cls) {
        ButtonGroup g = new ButtonGroup();
        g.InitControl("buttongroup", 5);
        g.Class = cls;
        g.segs = new List<ButtonSegment>();
        g.barBtns = new List<Button>();
        g.barMode = true;
        g.pressed = 0 - 1;
        g.lineH = 0;
        g.lines = 1;
        g.btnType = 0;
        g.btnStyle = 0;
        g.size = 2;
        g.vertical = false;
        return g;
    }

    ButtonGroup AddButton(Button b) {
        barBtns.Add(b);
        return this;
    }

    Button ButtonAt(int i) { return barBtns[i]; }

    /// The button pressed during the last frame (-1 = none). Consumed by the
    /// read so a page acts on it exactly once.
    int TakePressed() {
        int i = pressed;
        pressed = 0 - 1;
        return i;
    }

    List<int> BarWidths(App app) {
        List<int> w = new List<int>();
        int i = 0;
        while (i < barBtns.Count) {
            w.Add(barBtns[i].AutoWidth(app));
            i = i + 1;
        }
        return w;
    }

    /// The gap between the buttons of a bar. Zero by default: a group's
    /// buttons are welded into one strip (that is what makes it read as a
    /// group rather than three loose buttons); a stylesheet `gap` on the
    /// element breaks them apart again.
    int BarGap(App app) {
        int g = this.StyleGap();
        if (g < 0) { g = 0; }
        return g;
    }

    /// Which corners button `i` of a welded line keeps: only the ends of the
    /// line are rounded, the seams inside it are square.
    static int WeldCorners(bool first, bool last) {
        if (first && last) { return Corner.All(); }
        if (first) { return Corner.Left(); }
        if (last) { return Corner.Right(); }
        return 0;
    }

    override string Kind() { return "ButtonGroup"; }

    override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec type = PropSpec.Int("type", "Type");
        type.num = btnType;
        ps.Add(type);
        PropSpec style = PropSpec.Int("style", "Style");
        style.num = btnStyle;
        ps.Add(style);
        PropSpec sz = PropSpec.Int("size", "Size");
        sz.num = size;
        ps.Add(sz);
        PropSpec vert = PropSpec.Bool("vertical", "Vertical");
        vert.flag = vertical;
        ps.Add(vert);
        PropSpec cls = PropSpec.Text("class", "Classes");
        cls.str = Class;
        ps.Add(cls);
        return ps;
    }

    override string StyleType() { return "buttongroup"; }

    override void OnMeasure(App app) {
        if (!barMode) { return; }
        lineH = app.theme.heightMedium;
        if (barBtns.Count > 0) { lineH = barBtns[0].AutoHeight(app); }
        lines = 1;
        if (bw > 0) {
            List<int> w = this.BarWidths(app);
            int gapPx = this.BarGap(app);
            int used = 0;
            int i = 0;
            while (i < w.Count) {
                int step = w[i];
                if (used > 0) { step = step + gapPx; }
                if (used + step > bw && used > 0) {
                    lines = lines + 1;
                    used = w[i];
                } else {
                    used = used + step;
                }
                i = i + 1;
            }
        }
        prefH = lines * lineH + (lines - 1) * this.BarGap(app);
    }

    override void OnPaint(App app) {
        if (!barMode) { return; }
        pressed = 0 - 1;
        int n = barBtns.Count;
        if (n == 0 || bw <= 0) { return; }
        List<int> w = this.BarWidths(app);
        int gapPx = this.BarGap(app);
        bool weld = gapPx == 0;
        int x = bx;
        int y = by;
        int i = 0;
        while (i < n) {
            int bwi = w[i];
            bool lineStart = x == bx;
            if (!lineStart && x + bwi > bx + bw) {
                x = bx;
                y = y + lineH + gapPx;
                lineStart = true;
            }
            if (bwi > bw) { bwi = bw; }
            // A welded line ends where the next button no longer fits, so the
            // last button of every line keeps its rounded outer corner.
            bool lineEnd = i == n - 1;
            if (!lineEnd && x + bwi + w[i + 1] > bx + bw) { lineEnd = true; }
            if (weld) {
                barBtns[i].corners = ButtonGroup.WeldCorners(lineStart, lineEnd);
            }
            int id = barBtns[i].Render(app, x, y, bwi);
            if (Ui.Clicked(app, id)) { pressed = i; }
            // 1px seam so two welded neighbours still read as two buttons.
            if (weld && !lineEnd) {
                app.canvas.FillRect(x + bwi - 1, y + app.theme.paddingTiny, 1,
                                    lineH - app.theme.paddingTiny * 2,
                                    app.theme.borderPrimary);
            }
            x = x + bwi + gapPx;
            i = i + 1;
        }
    }

    int TypeColor(Theme t) { return Style.TypeColor(t, btnType); }

    int Height(Theme t) {
        if (size == 0) { return t.heightTiny; }
        if (size == 1) { return t.heightSmall; }
        if (size == 3) { return t.heightLarge; }
        return t.heightMedium;
    }

    int FontSz(Theme t) {
        if (size == 0) { return t.fontSizeTiny; }
        if (size == 1) { return t.fontSizeSmall; }
        if (size == 3) { return t.fontSizeLarge; }
        return t.fontSizeMedium;
    }

    int Render(App app, int x, int y) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int h = Height(t);
        int fs = FontSz(t);
        int radius = t.borderRadiusMedium;
        int tc = TypeColor(t);
        int n = segs.Count;
        int clicked = 0 - 1;

        int cursor = 0;
        int i = 0;
        while (i < n) {
            ButtonSegment seg = segs[i];
            int id = seg.id;
            int fsz = fs;
            int segLen = Canvas.MeasureText(seg.label, fsz) + t.paddingMedium * 2;
            int sx = x;
            int sy = y;
            int sw = segLen;
            int sh = h;
            if (vertical) { sy = y + cursor; sw = SegMaxW(t, fsz); }
            else { sx = x + cursor; }

            bool hovered = app.focus.IsHovered(id);
            bool pressed = app.focus.IsPressed(id);

            // Surface colours come from Button so a welded group and a lone
            // button react identically to hover / press / skin changes; only
            // the corner welding below is this widget's own.
            int fill = Style.TypeFill(t, btnType, btnStyle, hovered, pressed);
            int fg = Style.TypeFg(t, btnType, btnStyle);

            bool first = (i == 0);
            bool last = (i == n - 1);
            FillSeg(c, sx, sy, sw, sh, radius, fill, first, last);

            int textY = Canvas.CenterTextY(sy, sh, fsz);
            int textX = sx + (sw - Canvas.MeasureText(seg.label, fsz)) / 2;
            c.DrawText(textX, textY, seg.label, fg, fsz);

            if (btnStyle == 1) {
                // Outer rounded border for the whole group, drawn per-segment
                // with square inner edges via the same end-cap trick.
                StrokeSeg(c, sx, sy, sw, sh, radius, tc, first, last, vertical);
            }

            // Divider between adjacent segments.
            if (!last) {
                int dv = App.Darken(tc, 60);
                if (btnStyle == 1 || btnType == 0) { dv = t.borderPrimary; }
                if (vertical) { c.FillRect(sx, sy + sh - 1, sw, 1, dv); }
                else { c.FillRect(sx + sw - 1, sy, 1, sh, dv); }
            }

            app.hitTester.Register(HitRegion.Create(id, sx, sy, sw, sh, 0));
            app.focus.RegisterFocusable(id);
            if (Ui.Clicked(app, id)) { clicked = i; }

            if (vertical) { cursor = cursor + sh; }
            else { cursor = cursor + sw; }
            i = i + 1;
        }
        return clicked;
    }

    int SegMaxW(Theme t, int fs) {
        int m = 0;
        int i = 0;
        while (i < segs.Count) {
            int w = Canvas.MeasureText(segs[i].label, fs) + t.paddingMedium * 2;
            if (w > m) { m = w; }
            i = i + 1;
        }
        return m;
    }

    /// Fill a segment, rounding only the group's outer corners.
    void FillSeg(Canvas c, int x, int y, int w, int h, int r, int col,
            bool first, bool last) {
        if (first && last) {
            c.FillRoundRect(x, y, w, h, r, col);
            return;
        }
        if (vertical) {
            if (first) {
                c.FillRoundRect(x, y, w, h, r, col);
                c.FillRect(x, y + h - r, w, r, col);
            } else if (last) {
                c.FillRoundRect(x, y, w, h, r, col);
                c.FillRect(x, y, w, r, col);
            } else {
                c.FillRect(x, y, w, h, col);
            }
            return;
        }
        if (first) {
            c.FillRoundRect(x, y, w, h, r, col);
            c.FillRect(x + w - r, y, r, h, col);
        } else if (last) {
            c.FillRoundRect(x, y, w, h, r, col);
            c.FillRect(x, y, r, h, col);
        } else {
            c.FillRect(x, y, w, h, col);
        }
    }

    /// Outline stroke for a segment (outer corners rounded).
    void StrokeSeg(Canvas c, int x, int y, int w, int h, int r, int col,
            bool first, bool last, bool vert) {
        if (first && last) { c.DrawRoundRect(x, y, w, h, r, col, 1); return; }
        // Top and bottom edges always present.
        c.FillRect(x, y, w, 1, col);
        c.FillRect(x, y + h - 1, w, 1, col);
        if (!vert) {
            if (first) { c.FillRect(x, y, 1, h, col); }
            if (last) { c.FillRect(x + w - 1, y, 1, h, col); }
        } else {
            c.FillRect(x, y, 1, h, col);
            c.FillRect(x + w - 1, y, 1, h, col);
            if (first) { c.FillRect(x, y, w, 1, col); }
            if (last) { c.FillRect(x, y + h - 1, w, 1, col); }
        }
    }
}
