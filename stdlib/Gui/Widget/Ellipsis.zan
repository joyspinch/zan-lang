using System;
using Gui;

namespace Gui.Widget;

/// 省略号：单行文本在将超出给定宽度时
/// 截断并在末尾加 "..."。
class Ellipsis {
    /// 字体大小 `fs` 下若 `text` 能在 `w` 像素内放下则原样返回，
    /// 否则返回放得下的最长前缀加尾部 "..."。纯字符串
    /// 辅助函数，任何调用方都可用自己的颜色/位置绘制结果。
    static string Fit(string text, int w, int fs) {
        if (w <= 0) { return ""; }
        if (Canvas.MeasureText(text, fs) <= w) { return text; }
        int dotsW = Canvas.MeasureText("...", fs);
        int budget = w - dotsW;
        if (budget <= 0) { return "..."; }
        int n = text.Length;
        int lo = 0;
        int hi = n;
        while (lo < hi) {
            int mid = (lo + hi + 1) / 2;
            if (Canvas.MeasureText(text.Substring(0, mid), fs) <= budget) { lo = mid; }
            else { hi = mid - 1; }
        }
        lo = Text.ClampCharStart(text, lo);
        return text.Substring(0, lo) + "...";
    }

    static void Render(App app, int x, int y, int w, string text) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int fs = t.fontSizeMedium;
        if (Canvas.MeasureText(text, fs) <= w) {
            c.DrawText(x, y, text, t.textPrimary, fs);
            return;
        }
        int dotsW = Canvas.MeasureText("...", fs);
        int budget = w - dotsW;
        if (budget < 0) { budget = 0; }

        int n = text.Length;
        int lo = 0;
        int hi = n;
        while (lo < hi) {
            int mid = (lo + hi + 1) / 2;
            string sub = text.Substring(0, mid);
            if (Canvas.MeasureText(sub, fs) <= budget) {
                lo = mid;
            } else {
                hi = mid - 1;
            }
        }
        lo = Text.ClampCharStart(text, lo);
        string shown = text.Substring(0, lo) + "...";
        c.DrawText(x, y, shown, t.textPrimary, fs);
    }
}
