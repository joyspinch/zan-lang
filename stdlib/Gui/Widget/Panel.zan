using System;
using Gui;

namespace Gui.Widget;

/// <summary>
/// 表现型容器表面（卡片 / 分区），统一的
/// 背景、边框、圆角与内边距均取自当前主题。
///
/// 面板在内边距内测量并放置子控件，因此宿主
/// 只需给它一个矩形：
///
///   Panel box = new Panel("main").Titled("Details");
///   box.Gap(app.theme.gapMedium);
///   box.With(new Label { Text = "Name" });
///   box.RenderInside(app, rect);
/// </summary>
class Panel : Control {
    /// 0 卡片（填充 + 边框），1 纯表面（仅填充），2 带标题的分区，
    /// 3 布局（透明流式容器：无表面，尊重用户内边距）。
    int style;
    string title;
    int surfaceColor;
    FxOptions fx;

    void InitPanel(string name, int st) {
        this.InitControl(name, 5);
        styleSurfaceOwned = true;
        style = st;
        title = "";
        surfaceColor = 0;
        fx = null;
    }

    /// 可选的动画，以数据配置（见 FxOptions）；裁剪绘制在
    /// 面板表面内、其子控件之后。
    Panel WithFx(FxOptions o) {
        fx = o;
        return this;
    }

    /// Default design-time constructor; the form supplies the field name.
    /// 设计里的面板默认只做布局（不画表面）：设计器里的容器绝大多数
    /// 是分组行、工具条或列，画成卡片就会和里面控件自己的边框叠在
    /// 一起。要一张卡片就在设计里声明 style = card。
    Panel() {
        InitPanel("", 3);
    }

    /// 保留模式构造函数：卡片容器 `new Panel("main")`。
    Panel(string name) {
        InitPanel(name, 0);
    }

    Panel Plain(int color) {
        style = 1;
        surfaceColor = color;
        return this;
    }

    /// 纯布局宿主：不画表面、不取卡片内边距，只把自己的矩形
    /// 交给子控件。放在矮行（工具栏、面板头）里的容器必须用它：
    /// 卡片默认的 paddingLarge 会吃掉一行的全部高度，子控件只能
    /// 溢出到宿主外面。
    Panel Layout() {
        style = 3;
        return this;
    }

    Panel Titled(string t) {
        style = 2;
        title = t;
        return this;
    }

    /// 透明垂直流式容器：通过 With() 添加的子控件自上而下堆叠，
    /// 尺寸由各自 OnMeasure 决定，用 Gap() 分隔、Pad() 内缩。
    /// 容器根据子控件测量自身，因此可干净地嵌套在
    /// 其他 Column/Row 中。
    static Panel Column() {
        Panel p = new Panel("column");
        p.style = 3;
        p.layout = 1;
        return p;
    }

    /// 窗口根容器：填满客户区、按停靠排布子控件的透明表面。
    /// 窗口本身就是背景，因此根节点不画卡片（不然设计
    /// 四周会多出一圈边框），内边距也留给调用方决定。
    static Panel Root(string name) {
        Panel p = new Panel(name);
        p.style = 3;
        p.layout = 0;
        return p;
    }

    /// 透明水平流式容器（子控件从左到右排列）。
    static Panel Row() {
        Panel p = new Panel("row");
        p.style = 3;
        p.layout = 2;
        return p;
    }

    override string Kind() { return "Panel"; }

    /// 流式容器（Panel.Row/Panel.Column）只做布局：不绘制任何表面，
    /// 因此也不应继承样式表的 `panel` 规则——
    /// 否则皮肤的 `panel { padding: 18px; backdrop-filter: blur(...) }` 会
    /// 吃掉 Row 的内容框（使其各行互相重叠）并
    /// 给没有内容的容器做毛玻璃。样式表可用 `stack`
    /// 定位它们。
    override string StyleType() {
        if (style == 3) { return "stack"; }
        return "panel";
    }

    override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec st = PropSpec.Enum("style", "Style", new List<string>());
        st.Option("card"); st.Option("plain"); st.Option("section"); st.Option("layout");
        st.num = style;
        ps.Add(st);
        PropSpec lay = PropSpec.Enum("layout", "Layout", new List<string>());
        lay.Option("none"); lay.Option("column"); lay.Option("row");
        lay.num = layout;
        ps.Add(lay);
        PropSpec cap = PropSpec.Text("title", "Title");
        cap.str = title;
        ps.Add(cap);
        return ps;
    }

    override void OnMeasure(App app) {
        Theme t = app.theme;
        if (style == 3) {
            // 流式容器：保留调用方的内边距；首选尺寸由
            // 已测量的子控件加间距推导得出。显式的
            // Prefer()/`width` 优先生效（如停靠进一行的固定宽度侧边栏列）：
            // 只有留为 0 的轴才从子控件测量。
            int fixedW = 0;
            int fixedH = 0;
            if (prefSet) { fixedW = prefW; fixedH = prefH; }
            int mainSum = 0;
            int crossMax = 0;
            int cnt = 0;
            for (int i = 0; i < children.Count; i = i + 1) {
                Control ch = children[i];
                if (ch.visible) {
                    if (layout == 2) {
                        mainSum = mainSum + ch.prefW;
                        if (ch.prefH > crossMax) { crossMax = ch.prefH; }
                    } else {
                        mainSum = mainSum + ch.prefH;
                        if (ch.prefW > crossMax) { crossMax = ch.prefW; }
                    }
                    cnt = cnt + 1;
                }
            }
            if (cnt > 1) { mainSum = mainSum + gap * (cnt - 1); }
            if (layout == 2) {
                prefW = padL + padR + mainSum;
                prefH = padT + padB + crossMax;
            } else {
                prefH = padT + padB + mainSum;
                prefW = padL + padR + crossMax;
            }
            if (fixedW > 0) { prefW = fixedW; }
            if (fixedH > 0) { prefH = fixedH; }
            return;
        }
        // Pad()/Padding() 会固定内部盒子——自由画布设计将子控件放在
        // 绝对坐标并固定为 0——因此下面的主题
        // 默认值仅在调用方未改动时才生效。
        if (padSet) { return; }
        padL = t.paddingLarge;
        padR = t.paddingLarge;
        padT = t.paddingLarge;
        padB = t.paddingLarge;
        if (style == 2 && title != "") {
            StyleBox titleStyle = this.ResolvePartAs(app, "panel", "title", "",
                                                     Class, Style.SNormal());
            padT = t.paddingLarge
                + Canvas.FontHeight(titleStyle.FontOr(
                    Style.FontFallback(app, "large")))
                + t.paddingSmall + t.paddingMedium;
        }
        if (style == 1) {
            padL = t.paddingMedium;
            padR = t.paddingMedium;
            padT = t.paddingMedium;
            padB = t.paddingMedium;
        }
    }

    /// 当解析出的盒子 `s` 与该类型的裸规则解析结果不同时返回 true——
    /// 即 `<type>.<class>` / `#<name>` 规则或内联 Bg()/Gradient()/Radius()
    /// 设置器专门给了这个容器一张表面。
    bool StyledSurface(App app, string type, StyleBox s) {
        StyleBox d = Style.Of(app, type, "", Style.SNormal());
        return s.bg != d.bg || s.bgTo != d.bgTo || s.radius != d.radius
            || s.borderColor != d.borderColor || s.borderW != d.borderW
            || s.shadow != d.shadow || s.blur != d.blur;
    }

    override void OnPaint(App app) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        if (style == 3) {
            // 布局容器自己没有表面，但样式表专门给它背景/边框时
            // （`stack.reflist-head { background: ... }` 这类）照画，
            // 否则一行分组行就得为了一条底色被迫做成卡片。
            StyleBox ls = Style.Full(app, "stack", Class, name, Style.SNormal());
            Style.Inline(ls, this);
            if (this.StyledSurface(app, "stack", ls)) {
                ls.Paint(app, bx, by, bw, bh);
            }
            return;
        }
        if (app.WindowShape() != 0 && parent != null && parent is Form) {
            // 异形窗口的窗口根：轮廓就是窗口本身，
            // 全窗口主题表面会填满阴影带并把设计
            // 变方正。设计自身的卡片自行绘制。
            return;
        }
        // 表面完全由样式表决定：base.css 的 `panel` 规则把主题 token
        // 展开成背景/边框/圆角/投影/磨砂，皮肤只要改写那条规则或
        // 它用到的 token 即可，控件这里不再硬编码任何一种画法。
        // 基类 PaintStyleBox 特意跳过面板，好让 `#Card { background:
        // linear-gradient(...) }` 与内联的 Bg()/Gradient()/Radius() 走同一条路。
        StyleBox s = Style.Full(app, "panel", Class, name, Style.SNormal());
        Style.Inline(s, this);
        if (style == 1) {
            // 纯表面：只填色，不要边框/圆角/投影。Plain(color) 是显式的
            // 内联覆盖，因此优先于样式表给出的背景。
            int col = surfaceColor;
            if (col == 0) {
                StyleBox plain = Style.Part(app, "panel", "plain", "",
                                             Class, name, Style.SNormal());
                col = plain.BgOr(0);
            }
            s.bg = col;
            s.bgTo = col;
            s.borderW = 0;
            s.radius = 0;
            s.shadow = 0;
        }
        s.Paint(app, bx, by, bw, bh);
        Fx.Apply(app, bx, by, bw, bh, t.borderRadiusLarge, fx);
        if (style == 2 && title != "") {
            StyleBox ts = this.ResolvePartAs(app, "panel", "title", "", Class,
                                             Style.SNormal());
            StyleBox ds = this.ResolvePartAs(app, "panel", "divider", "",
                                             Class, Style.SNormal());
            int pad = t.paddingLarge;
            int titleFont = ts.FontOr(Style.FontFallback(app, "large"));
            int titleH = Canvas.FontHeight(titleFont);
            c.DrawText(bx + pad, by + pad, title, ts.fg, titleFont);
            int dividerY = by + pad + titleH + t.paddingSmall;
            c.FillRect(bx + pad, dividerY, bw - pad * 2, 1, ds.bg);
        }
    }

    /// 该面板表面给子控件留下的内容矩形，
    /// 供在自绘面板内布局的宿主使用。
    Rect Inner() {
        return new Rect(bx + padL, by + padT, bw - padL - padR,
                           bh - padT - padB);
    }
}
