using System;
using Gui;

namespace Gui.Widget;

/// <summary>
/// 表现型容器表面（卡片 / 分区），统一的
/// 背景、边框、圆角与内边距均取自当前主题。
///
/// 面板在内边距内测量并放置子控件，因此宿主
/// 只需给它一个矩形：
///
///   Panel box = new Panel("main").Titled("Details");
///   box.Gap(app.theme.gapMedium);
///   box.With(new Label { Text = "Name" });
///   box.RenderInside(app, rect);
/// </summary>
class Panel : Control {
    /// 0 卡片（填充 + 边框），1 纯表面（仅填充），2 带标题的分区，
    /// 3 布局（透明流式容器：无表面，尊重用户内边距）。
    int style;
    string title;
    int surfaceColor;
    FxOptions fx;

    void InitPanel(string name, int st) {
        this.InitControl(name, 5);
        styleSurfaceOwned = true;
        style = st;
        title = "";
        surfaceColor = 0;
        fx = null;
    }

    /// 可选的动画，以数据配置（见 FxOptions）；裁剪绘制在
    /// 面板表面内、其子控件之后。
    Panel WithFx(FxOptions o) {
        fx = o;
        return this;
    }

    /// Default design-time constructor; the form supplies the field name.
    Panel() : this("") { }

    /// 保留模式构造函数：卡片容器 `new Panel("main")`。
    Panel(string name) {
        InitPanel(name, 0);
    }

    Panel Plain(int color) {
        style = 1;
        surfaceColor = color;
        return this;
    }

    Panel Titled(string t) {
        style = 2;
        title = t;
        return this;
    }

    /// 透明垂直流式容器：通过 With() 添加的子控件自上而下堆叠，
    /// 尺寸由各自 OnMeasure 决定，用 Gap() 分隔、Pad() 内缩。
    /// 容器根据子控件测量自身，因此可干净地嵌套在
    /// 其他 Column/Row 中。
    static Panel Column() {
        Panel p = new Panel("column");
        p.style = 3;
        p.layout = 1;
        return p;
    }

    /// 透明水平流式容器（子控件从左到右排列）。
    static Panel Row() {
        Panel p = new Panel("row");
        p.style = 3;
        p.layout = 2;
        return p;
    }

    override string Kind() { return "Panel"; }

    /// 流式容器（Panel.Row/Panel.Column）只做布局：不绘制任何表面，
    /// 因此也不应继承样式表的 `panel` 规则——
    /// 否则皮肤的 `panel { padding: 18px; backdrop-filter: blur(...) }` 会
    /// 吃掉 Row 的内容框（使其各行互相重叠）并
    /// 给没有内容的容器做毛玻璃。样式表可用 `stack`
    /// 定位它们。
    override string StyleType() {
        if (style == 3) { return "stack"; }
        return "panel";
    }

    override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec st = PropSpec.Enum("style", "Style", new List<string>());
        st.Option("card"); st.Option("plain"); st.Option("section"); st.Option("layout");
        st.num = style;
        ps.Add(st);
        PropSpec lay = PropSpec.Enum("layout", "Layout", new List<string>());
        lay.Option("none"); lay.Option("column"); lay.Option("row");
        lay.num = layout;
        ps.Add(lay);
        PropSpec cap = PropSpec.Text("title", "Title");
        cap.str = title;
        ps.Add(cap);
        return ps;
    }

    override void OnMeasure(App app) {
        Theme t = app.theme;
        if (style == 3) {
            // 流式容器：保留调用方的内边距；首选尺寸由
            // 已测量的子控件加间距推导得出。显式的
            // Prefer()/`width` 优先生效（如停靠进一行的固定宽度侧边栏列）：
            // 只有留为 0 的轴才从子控件测量。
            int fixedW = 0;
            int fixedH = 0;
            if (prefSet) { fixedW = prefW; fixedH = prefH; }
            int mainSum = 0;
            int crossMax = 0;
            int cnt = 0;
            for (int i = 0; i < children.Count; i = i + 1) {
                Control ch = children[i];
                if (ch.visible) {
                    if (layout == 2) {
                        mainSum = mainSum + ch.prefW;
                        if (ch.prefH > crossMax) { crossMax = ch.prefH; }
                    } else {
                        mainSum = mainSum + ch.prefH;
                        if (ch.prefW > crossMax) { crossMax = ch.prefW; }
                    }
                    cnt = cnt + 1;
                }
            }
            if (cnt > 1) { mainSum = mainSum + gap * (cnt - 1); }
            if (layout == 2) {
                prefW = padL + padR + mainSum;
                prefH = padT + padB + crossMax;
            } else {
                prefH = padT + padB + mainSum;
                prefW = padL + padR + crossMax;
            }
            if (fixedW > 0) { prefW = fixedW; }
            if (fixedH > 0) { prefH = fixedH; }
            return;
        }
        // Pad()/Padding() 会固定内部盒子——自由画布设计将子控件放在
        // 绝对坐标并固定为 0——因此下面的主题
        // 默认值仅在调用方未改动时才生效。
        if (padSet) { return; }
        padL = t.paddingLarge;
        padR = t.paddingLarge;
        padT = t.paddingLarge;
        padB = t.paddingLarge;
        if (style == 2 && title != "") {
            padT = t.paddingLarge + Canvas.FontHeight(t.fontSizeLarge) + t.paddingSmall + t.paddingMedium;
        }
        if (style == 1) {
            padL = t.paddingMedium;
            padR = t.paddingMedium;
            padT = t.paddingMedium;
            padB = t.paddingMedium;
        }
    }

    /// 当解析出的盒子 `s` 与裸 `panel` 解析结果不同时返回 true——
    /// 即 `panel.<class>` / `#<name>` 规则或内联
    /// Bg()/Gradient()/Radius() 设置器给了该面板自己的表面。
    bool StyledSurface(App app, StyleBox s) {
        StyleBox d = Style.Of(app, "panel", "", Style.SNormal());
        return s.bg != d.bg || s.bgTo != d.bgTo || s.radius != d.radius
            || s.borderColor != d.borderColor || s.borderW != d.borderW
            || s.shadow != d.shadow || s.blur != d.blur;
    }

    override void OnPaint(App app) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        if (style == 3) {
            return;
        }
        // 面板拥有自己的表面，因此基类 PaintStyleBox 特意
        // 跳过它：在这里解析 CSS 盒子，当样式表（或内联设置器）
        // 专门为此面板设置了样式时绘制，
        // 使 `#Card { background: linear-gradient(...) }` 和 `panel.Gradient(a,b)`
        // 都能生效。未设置样式的面板保持普通主题表面。
        StyleBox s = Style.Full(app, "panel", Class, name, Style.SNormal());
        Style.Inline(s, this);
        if (this.StyledSurface(app, s)) {
            s.Paint(app, bx, by, bw, bh);
        } else if (app.WindowShape() != 0 && parent != null && parent is Form) {
            // 异形窗口的窗口根：轮廓就是窗口本身，
            // 全窗口主题表面会填满阴影带并把设计
            // 变方正。设计自身的卡片自行绘制。
        } else if (style == 1) {
            int col = surfaceColor;
            if (col == 0) { col = t.bgSecondary; }
            c.FillRect(bx, by, bw, bh, col);
        } else {
            c.SurfaceRoundRect(bx, by, bw, bh, t.borderRadiusLarge,
                               t.bgPrimary, t.borderSecondary, 1);
        }
        Fx.Apply(app, bx, by, bw, bh, t.borderRadiusLarge, fx);
        if (style == 2 && title != "") {
            int pad = t.paddingLarge;
            int titleH = Canvas.FontHeight(t.fontSizeLarge);
            c.DrawText(bx + pad, by + pad, title, t.textPrimary, t.fontSizeLarge);
            int dividerY = by + pad + titleH + t.paddingSmall;
            c.FillRect(bx + pad, dividerY, bw - pad * 2, 1, t.divider);
        }
    }

    /// 该面板表面给子控件留下的内容矩形，
    /// 供在自绘面板内布局的宿主使用。
    Rect Inner() {
        return new Rect(bx + padL, by + padT, bw - padL - padR,
                           bh - padT - padB);
    }
}
