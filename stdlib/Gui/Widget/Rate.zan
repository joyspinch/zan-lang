using System;
using Gui;

namespace Gui.Widget;

/// 星级评分（NaiveUI n-rate），带响应式 int 绑定与悬停预览。
/// 图标走图标组件管线（IconSvg 优先、IconVector 回退）：
/// `Icon` / `VoidIcon` 给出实心/空心档的图标名（默认 "star" /
/// "star-empty"），换成 "heart"、"flame" 等任何图标集认识的名字
/// 即可自定义外观。
///
/// 鼠标语义与框架对齐：点击走 `App.ClickAvailable()`（一次释放只
/// 被消费一帧，弹层已认领的点击不再穿透）；半星模式下每颗星注册
/// 左右两个命中矩形，点击落在哪一半、悬停预览到哪一半都直接由
/// 命中 id 决定，不再用 mouseX 对格子取余。悬停预览值变化时触发
/// `HoverChange`（`HoverValue()` 读取，0 = 已离开）。
///
/// C# 风格的有状态实例：
///     Rate stars = new Rate(5);
///     stars.Change += () => { ... };
///     stars.Render(app, x, y);
class Rate : Control {
    /// 本地评分信号：整星模式 1..maxStars，allowHalf 时按 *2 编码
    /// （7 = 3.5 星）。
    SignalInt model;
    /// 双向绑定的评分：`stars.data = review.score;` 使模型字段与评分
    /// 双向保持同步（编译器降级的 Binding）。allowHalf 时同样按 *2
    /// 编码（7 = 3.5 星），与模型信号、HoverValue 同一套语义。
    Binding<int> data;
    /// 星星总数。
    int maxStars;
    /// 命中 id 段起点：整星每星一个；allowHalf 时每星另有右半格
    /// id（baseId+maxStars+i），故按 2×maxStars 预留。
    int baseId;
    /// 评分变化时触发（C# 风格：`r.Change += h;`）。
    UiEvent Change;
    /// 悬停预览值变化时触发（含离开归 0）。`r.HoverChange += h;`
    /// 之后用 `r.HoverValue()` 读取当前预览值。
    UiEvent HoverChange;
    /// 允许半星（Naive UI allow-half）。true 时点击星星左半
    /// = i+0.5，右半 = i+1，模型用 *2 存储。
    bool allowHalf;
    /// 只读：禁止点击编辑、无悬停预览，但仍绘制（Naive UI readonly）。
    bool readOnly;
    /// 可清空：再次点击同一半格清除评分（Naive UI clearable）。
    bool clearable;
    /// 尺寸变体：small/medium/large（Naive UI size）。Binding<string>
    /// 支持响应式换档，属性面板直接读写选项文本。
    Binding<string> Size;
    /// 实心档图标名（Binding<string> 支持响应式，属性面板直写）。
    Binding<string> Icon;
    /// 空心档图标名。
    Binding<string> VoidIcon;
    /// 上一帧的悬停预览值；0 = 未悬停。Half 模式按 *2 编码。
    int lastHover;

    void InitRate(SignalInt m, int stars) {
        this.InitControl("rate", 1);
        model = m;
        maxStars = stars;
        // 必须预留 2×：allowHalf 时 PaintStars 注册 baseId+i 与
        // baseId+maxStars+i 两组 id——只 Block(stars) 的话右半格
        // id 越界进后一个控件的 id 空间：两个控件互相误认领对方的
        // 悬停/点击（悬停 A 行 → B 行跟着预览、点 B 行 → A 行值
        // 被改写）。allowHalf 是构造后才设的，这里一律按 2× 预留。
        baseId = WidgetId.Block(stars * 2);
        wiresOwnEvents = true;
        Change = new UiEvent();
        HoverChange = new UiEvent();
        allowHalf = false;
        readOnly = false;
        clearable = false;
        Size = "medium";
        Icon = "star";
        VoidIcon = "star-empty";
        lastHover = 0;
    }

    /// Default design-time constructor.
    Rate() : this(5) { }

    /// 自持信号：`Rate stars = new Rate(5);`，再通过 `.data` 双向绑定——
    /// 调用处无需任何信号连接代码。
    Rate(int stars) {
        InitRate(new SignalInt(0), stars);
    }

    override string Kind() { return "Rate"; }
    override Binding<string> SizeOf() { return Size; }

    override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec mx = PropSpec.Int("max", "Maximum stars");
        mx.num = maxStars;
        mx.Step(1, 1, 10);
        mx.WithTip("Number of stars available for rating.");
        ps.Add(mx);
        PropSpec val = PropSpec.Int("value", "Rating");
        // 属性通道优先指向活的外部绑定（§6.1 单协议）。
        if (data != null) { val.num = data; } else { val.snum = model; }
        val.Step(1, 0, 10);
        val.WithTip("Current selected rating (Naive UI value, *2 if allow-half).");
        ps.Add(val);
        PropSpec half = PropSpec.Bool("allowHalf", "Allow half");
        half.flag = allowHalf;
        ps.Add(half);
        PropSpec ro = PropSpec.Bool("readonly", "Readonly");
        ro.flag = readOnly;
        ps.Add(ro);
        PropSpec clr = PropSpec.Bool("clearable", "Clearable");
        clr.flag = clearable;
        ps.Add(clr);
        PropSpec sz = PropSpec.Enum("size", "Size",
            new List<string>{ "small", "medium", "large" });
        sz.str = Size;
        ps.Add(sz);
        PropSpec ico = PropSpec.Text("icon", "Icon");
        ico.str = Icon;
        ico.WithTip("Filled-state icon name (star / heart / flame ...).");
        ps.Add(ico);
        PropSpec vic = PropSpec.Text("voidIcon", "Void icon");
        vic.str = VoidIcon;
        vic.WithTip("Empty-state icon name.");
        ps.Add(vic);
        return ps;
    }

    /// 当前评分（allowHalf 时按 *2 编码）。
    int Value() { return model.Get(); }

    /// 当前悬停预览值（`HoverChange` 报告的同一个数）：
    /// 整星模式 = 将点亮的星数；半星模式按 *2 编码（3 = 1.5 星）；
    /// 0 = 指针已离开。
    int HoverValue() { return lastHover; }

    /// 将绑定的模型值拉入本地信号（model -> UI）。data 与 model
    /// 同一种编码（allowHalf 时都是 *2），直接比较即可——一边除
    /// 一边乘的换算会把 3.5 星量化回 3 星。
    override void SyncBinding() {
        if (data == null) { return; }
        int cur = data.Get();
        if (cur != model.Get()) { model.Set(cur); }
    }

    /// 当前档位对应的 class 片段（"" = medium）。
    string SizeCls() {
        if (Size == null) { return ""; }
        return Control.SizeClass(Size.Get());
    }

    /// 一颗星占据的横向步长：字号 + CSS 的 `gap`。绘制、测量和
    /// 半星命中判定必须用同一个值——三处各算一遍的时候，皮肤
    /// 一改 `rate { font-size }` 点击位置就和画出来的星星错开。
    int StepPx(App app) {
        string origClass = Class;
        this.AddClass(this.SizeCls());
        StyleBox s = this.ResolveStyleAs(app, "rate", Class, Style.SNormal());
        Class = origClass;
        return s.FontOr(Style.FontFallback(app, "huge"))
            + s.GapOr(app.theme.paddingTiny);
    }

    /// 悬停预览值落定：变化的那一帧才触发 HoverChange（边沿触发，
    /// 处理器里改模型不会造成重绘风暴）。
    void SetHover(App app, int v) {
        if (v == lastHover) { return; }
        lastHover = v;
        HoverChange.Raise();
    }

    /// 绘制星星并处理点击（悬停预览经 HoverValue/HoverChange 报告）；
    /// 返回命中 id 段起点。
    int Render(App app, int x, int y) {
        SyncBinding();
        this.PaintStars(app, x, y);
        // 一次释放只在它到达的那一帧被消费：ClickAvailable 挡掉
        // 持续动画帧里 EventKind 停留在 3 的重放（否则 clearable
        // 会清零又被下一帧原样写回，来回跳变）、被弹层认领的点击
        // 和右键释放。值本身由命中矩形直接给出——半星左右两半
        // 是两个不同的矩形 id，不需要再用 mouseX 对格子取余。
        if (!readOnly && app.ClickAvailable()) {
            int hit = app.ClickTarget();
            int span = allowHalf ? maxStars * 2 : maxStars;
            if (hit >= baseId && hit < baseId + span) {
                int newVal;
                if (allowHalf) {
                    if (hit >= baseId + maxStars) {
                        newVal = (hit - baseId - maxStars) * 2 + 2;
                    } else {
                        newVal = (hit - baseId) * 2 + 1;
                    }
                } else {
                    newVal = hit - baseId + 1;
                }
                if (clearable && model.Get() == newVal) { newVal = 0; }
                if (newVal != model.Get()) {
                    model.Set(newVal);
                    if (data != null) { data.Set(newVal); }
                    Change.Raise();
                    app.RequestRedraw();
                }
            }
        }
        return baseId;
    }

    override List<string> Events() {
        List<string> e = Control.CommonEvents();
        e.Add("Change");
        e.Add("HoverChange");
        return e;
    }

    /// 将评分的 Change / HoverChange 路由到各自 UiEvent 字段；其余
    /// 一切落到 `On` 的公共事件集（其 AddByName 忽略
    /// 不认识的名称）。
    override void BindEvent(string evt, Action a) {
        if (evt == "Change") { Change.Add(a); return; }
        if (evt == "HoverChange") { HoverChange.Add(a); return; }
        On.AddByName(evt, a);
    }

    /// 按 `rate` CSS 规则绘制星星，悬停的星（半星模式下是悬停的
    /// 半格）预览将要设置的评分。半星模式（allowHalf）下每颗星
    /// 注册左右两个命中矩形：左半 id = baseId+i（= i+0.5 星），
    /// 右半 id = baseId+maxStars+i（= i+1 星），命中/悬停/预览
    /// 共用这一份几何。半星 = 50% alpha 实心（`rate::star-half`）。
    void PaintStars(App app, int x, int y) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        // Size 字段映射为 Class 片段。
        string origClass = Class;
        this.AddClass(this.SizeCls());
        StyleBox s = this.ResolveStyleAs(app, "rate", Class, Style.SNormal());
        StyleBox on = this.ResolvePartAs(app, "rate", "star", "", Class,
                                         Style.SNormal());
        StyleBox off = this.ResolvePartAs(app, "rate", "empty", "", Class,
                                          Style.SNormal());
        StyleBox half = null;
        if (allowHalf) {
            half = this.ResolvePartAs(app, "rate", "star-half", "", Class,
                                       Style.SNormal());
        }
        int fs = s.FontOr(Style.FontFallback(app, "huge"));
        int step = fs + s.GapOr(app.theme.paddingTiny);
        int rowH = Canvas.FontHeight(fs);

        // 悬停预览值：命中矩形 id 直接编码了档位（整星 i+1；
        // 半星左半 2i+1 / 右半 2i+2），0 = 未悬停。
        int hoverVal = 0;
        if (!readOnly) {
            int i = 0;
            for (; i < maxStars; i = i + 1) {
                if (app.focus.IsHovered(baseId + i)) {
                    hoverVal = allowHalf ? i * 2 + 1 : i + 1;
                }
            }
            if (allowHalf) {
                for (i = 0; i < maxStars; i = i + 1) {
                    if (app.focus.IsHovered(baseId + maxStars + i)) {
                        hoverVal = i * 2 + 2;
                    }
                }
            }
        }
        this.SetHover(app, hoverVal);
        // 评分与预览同一种编码（半星 *2），显示时直接比较。
        int fillTo = model.Get();
        if (hoverVal > 0) { fillTo = hoverVal; }

        // 颜色都要过一次 Fade：rate::star-half 用 CSS `opacity: 500`
        // 表达半颗，只取 FgOr 会把半星画成实心 100%——3.5 星看起来
        // 像 4 星，悬停左/右半格视觉上毫无区别（“鼠标滑过没反应”）。
        int offColor = off.Fade(off.FgOr(0));
        int onRaw = on.FgOr(0);
        int onColor = on.Fade(onRaw);
        int halfColor = half != null ? half.Fade(half.FgOr(onRaw)) : onColor;
        string onName = "star";
        string offName = "star-empty";
        if (Icon != null && Icon.Get() != "") { onName = Icon.Get(); }
        if (VoidIcon != null && VoidIcon.Get() != "") { offName = VoidIcon.Get(); }
        int i2 = 0;
        while (i2 < maxStars) {
            int sx = x + i2 * step;
            int color = offColor;
            string name = offName;
            if (allowHalf) {
                int twosHere = fillTo - i2 * 2;
                if (twosHere >= 2) {
                    color = onColor; name = onName;
                } else if (twosHere == 1) {
                    color = halfColor; name = onName;
                }
            } else {
                if (i2 < fillTo) {
                    color = onColor; name = onName;
                }
            }
            c.DrawGlyphIn(name, sx, y, step, rowH, fs, color);
            if (!readOnly) {
                // 命中矩形必须对准星形的可见范围：DrawGlyphIn 把 `fs`
                // 宽的字形居中画进 `step` 宽的格子，字形左边缘在
                // sx + (step-fs)/2。用整格当命中区会把星星左侧的
                // 间隙也算进去——指针明明在星与星之间，亮的却是
                // 左边那颗（点中位置和显示效果对不上）。
                int gx = sx + (step - fs) / 2;
                if (allowHalf) {
                    // 半星：左半 id = baseId+i（i+0.5 星），右半 id =
                    // baseId+maxStars+i（i+1 星），分界在字形中线
                    // gx + fs/2——正好是画出来那颗星的左右两半。
                    int halfG = fs / 2;
                    app.hitTester.RegisterRect(baseId + i2, gx, y, halfG,
                                               rowH, 0);
                    app.hitTester.RegisterRect(baseId + maxStars + i2,
                        gx + halfG, y, fs - halfG, rowH, 0);
                } else {
                    // 整星：命中区 = 字形宽度本身，不多吃间隙。
                    app.hitTester.RegisterRect(baseId + i2, gx, y, fs,
                                               rowH, 0);
                }
                if (this.On.Any()) { On.Fire(app, baseId + i2); }
            }
            i2 = i2 + 1;
        }
        Class = origClass;
    }

    override void OnMeasure(App app) {
        string origClass = Class;
        this.AddClass(this.SizeCls());
        int fs = this.ResolveStyleAs(app, "rate", Class, Style.SNormal())
            .FontOr(Style.FontFallback(app, "huge"));
        Class = origClass;
        int step = this.StepPx(app);
        prefH = Canvas.FontHeight(fs);
        // 宽 = (n-1)*step + fs：星星 i 画在 x + i*step，最后一颗只占
        // 字形宽 `fs`，后面没有间隙需要预留。按 n*step 算会多出一段
        // 幻影尾隙，把 prefW 撑宽。
        prefW = maxStars * step - (step - fs);
    }

    override void OnPaint(App app) {
        this.Render(app, bx, by);
    }
}
