using System;
using Gui;

namespace Gui.Widget;

/// Star rating (NaiveUI n-rate) with reactive int binding and hover preview.
/// Uses the vector Icon component ("star" / "star-empty") so filled and empty
/// stars render identically across platforms.
///
/// C#-style retained instance:
///     Rate stars = Rate.Bind(model, 5);
///     stars.Change += () => { ... };
///     stars.Render(app, x, y);
class Rate : Control {
    SignalInt model;
    /// Two-way bound rating: `stars.data = review.score;` keeps the model
    /// field and the rating in sync both ways (compiler-lowered Binding).
    Binding<int> data;
    int maxStars;
    int baseId;
    /// Fires when the rating changes (C#-style: `r.Change += h;`).
    UiEvent Change;

    void InitRate(SignalInt m, int stars) {
        this.InitControl("rate", 1);
        model = m;
        maxStars = stars;
        baseId = WidgetId.Block(stars);
        wiresOwnEvents = true;
        Change = UiEvent.Create();
    }

    /// Retained-mode constructor: `Rate stars = new Rate(model, 5);`
    Rate(SignalInt m, int stars) {
        InitRate(m, stars);
    }

    /// Owns its signal: `Rate stars = new Rate(5);` then two-way bind via
    /// `.data` — no signal plumbing at the call site.
    Rate(int stars) {
        InitRate(SignalInt.Create(0), stars);
    }

    static Rate Bind(SignalInt model, int maxStars) {
        Rate r = new Rate(model, maxStars);
        return r;
    }

    int Value() { return model.Get(); }

    /// Pull the bound model value into the local signal (model -> UI).
    void SyncBinding() {
        if (data == null) { return; }
        int cur = data.Get();
        if (cur != model.Get()) { model.Set(cur); }
    }

    int Render(App app, int x, int y) {
        SyncBinding();
        this.PaintStars(app, x, y);
        if (app.EventKind() == 3) {
            int hit = app.ClickTarget();
            if (hit >= baseId && hit < baseId + maxStars) {
                model.Set(hit - baseId + 1);
                if (data != null) { data.Set(model.Get()); }
                Change.Raise();
                app.RequestRedraw();
            }
        }
        On.Fire(app, baseId);
        return baseId;
    }

    override List<string> Events() {
        List<string> e = Control.CommonEvents();
        e.Add("Change");
        return e;
    }

    /// Routes the rating's Change to its UiEvent field; everything else falls
    /// through to the common bundle on `On` (whose AddByName ignores names it
    /// does not know).
    override void BindEvent(string evt, Action a) {
        if (evt == "Change") { Change.Add(a); return; }
        On.AddByName(evt, a);
    }

    /// Stars from the `rate` CSS rules, with the hovered star previewing the
    /// rating it would set.
    void PaintStars(App app, int x, int y) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        StyleBox s = this.ResolveStyleAs(app, "rate", Class, Style.SNormal());
        StyleBox on = this.ResolvePartAs(app, "rate", "star", "", Class,
                                         Style.SNormal());
        StyleBox off = this.ResolvePartAs(app, "rate", "empty", "", Class,
                                          Style.SNormal());
        int fs = s.FontOr(t.fontSizeHuge);
        int step = fs + app.Scale(6);
        int rowH = Canvas.FontHeight(fs);

        int preview = 0 - 1;
        int i = 0;
        while (i < maxStars) {
            if (app.focus.IsHovered(baseId + i)) { preview = i; }
            i = i + 1;
        }
        int fillTo = model.Get();
        if (preview >= 0) { fillTo = preview + 1; }

        i = 0;
        while (i < maxStars) {
            int sx = x + i * step;
            int color = off.FgOr(t.borderPrimary);
            string name = "star-empty";
            if (i < fillTo) {
                color = on.FgOr(t.warning);
                name = "star";
            }
            c.DrawGlyphIn(name, sx, y, step, rowH, fs, color);
            app.hitTester.Register(HitRegion.Create(baseId + i, sx, y, step,
                                                    rowH, 0));
            i = i + 1;
        }
    }

    override void OnMeasure(App app) {
        int fs = this.ResolveStyleAs(app, "rate", Class, Style.SNormal())
            .FontOr(app.theme.fontSizeHuge);
        prefH = Canvas.FontHeight(fs);
        prefW = maxStars * (fs + app.Scale(6));
    }

    override void OnPaint(App app) {
        this.Render(app, bx, by);
    }
}
