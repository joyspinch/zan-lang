using System;
using Gui;

namespace Gui.Widget;

/// 星级评分（NaiveUI n-rate），带响应式 int 绑定与悬停预览。
/// 使用矢量 Icon 组件（"star" / "star-empty"），使实心和空心
/// 星星在各平台渲染一致。
///
/// C# 风格的有状态实例：
///     Rate stars = Rate.Bind(model, 5);
///     stars.Change += () => { ... };
///     stars.Render(app, x, y);
class Rate : Control {
    SignalInt model;
    /// 双向绑定的评分：`stars.data = review.score;` 使模型字段与评分
    /// 双向保持同步（编译器降级的 Binding）。
    Binding<int> data;
    int maxStars;
    int baseId;
    /// 评分变化时触发（C# 风格：`r.Change += h;`）。
    UiEvent Change;
    /// 允许半星（Naive UI allow-half）。true 时点击星星左半
    /// = i+0.5，右半 = i+1，模型用 *2 存储。
    bool allowHalf;
    /// 只读：禁止点击编辑，但仍绘制（Naive UI readonly）。
    bool readOnly;
    /// 可清空：再次点击同一星清除评分（Naive UI clearable）。
    bool clearable;
    /// 尺寸变体：small/medium/large（Naive UI size）。Binding<string>
    /// 支持响应式换档，属性面板直接读写选项文本。
    Binding<string> Size;

    void InitRate(SignalInt m, int stars) {
        this.InitControl("rate", 1);
        model = m;
        maxStars = stars;
        baseId = WidgetId.Block(stars);
        wiresOwnEvents = true;
        Change = new UiEvent();
        allowHalf = false;
        readOnly = false;
        clearable = false;
        Size = "medium";
    }

    /// Default design-time constructor.
    Rate() : this(5) { }

    /// 有状态模式构造函数：`Rate stars = new Rate(model, 5);`
    Rate(SignalInt m, int stars) {
        InitRate(m, stars);
    }

    /// 自持信号：`Rate stars = new Rate(5);`，再通过 `.data` 双向绑定——
    /// 调用处无需任何信号连接代码。
    Rate(int stars) {
        InitRate(new SignalInt(0), stars);
    }

    override string Kind() { return "Rate"; }
    override Binding<string> SizeOf() { return Size; }

    override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec mx = PropSpec.Int("max", "Maximum stars");
        mx.num = maxStars;
        mx.Step(1, 1, 10);
        mx.WithTip("Number of stars available for rating.");
        ps.Add(mx);
        PropSpec val = PropSpec.Int("value", "Rating");
        val.snum = model;
        val.Step(1, 0, 10);
        val.WithTip("Current selected rating (Naive UI value, *2 if allow-half).");
        ps.Add(val);
        PropSpec half = PropSpec.Bool("allowHalf", "Allow half");
        half.flag = allowHalf;
        ps.Add(half);
        PropSpec ro = PropSpec.Bool("readonly", "Readonly");
        ro.flag = readOnly;
        ps.Add(ro);
        PropSpec clr = PropSpec.Bool("clearable", "Clearable");
        clr.flag = clearable;
        ps.Add(clr);
        PropSpec sz = PropSpec.Enum("size", "Size",
            new List<string>{ "small", "medium", "large" });
        sz.str = Size;
        ps.Add(sz);
        return ps;
    }

    static Rate Bind(SignalInt model, int maxStars) {
        Rate r = new Rate(model, maxStars);
        return r;
    }

    int Value() { return model.Get(); }
    /// 半星模式下 *2 编码：模型字段 3 = 1.5 星。
    int RawValue() {
        if (allowHalf) { return model.Get() / 2; }
        return model.Get();
    }

    /// 将绑定的模型值拉入本地信号（model -> UI）。
    void SyncBinding() {
        if (data == null) { return; }
        int cur = data.Get();
        if (allowHalf) { cur = cur * 2; }
        if (cur != model.Get()) { model.Set(cur); }
    }

    /// 当前档位对应的 class 片段（"" = medium）。
    string SizeCls() {
        if (Size == null) { return ""; }
        return Control.SizeClass(Size.Get());
    }

    int Render(App app, int x, int y) {
        SyncBinding();
        this.PaintStars(app, x, y);
        if (!readOnly && app.EventKind() == 3) {
            int hit = app.ClickTarget();
            if (hit >= baseId && hit < baseId + maxStars) {
                int idx = hit - baseId;
                if (allowHalf) {
                    // 利用鼠标 x 位置判断左右半：图标左半 = 半星。
                    int cellW = app.Scale(22);
                    if (this.SizeCls() == "small") { cellW = app.Scale(16); }
                    else if (this.SizeCls() == "large") { cellW = app.Scale(30); }
                    int rel = app.mouseX - x;
                    bool isLeftHalf = (rel % cellW) < (cellW / 2);
                    int newVal = idx * 2 + (isLeftHalf ? 1 : 2);
                    if (clearable && model.Get() == newVal) { newVal = 0; }
                    if (newVal != model.Get()) {
                        model.Set(newVal);
                        if (data != null) { data.Set(newVal / 2); }
                        Change.Raise();
                        app.RequestRedraw();
                    }
                } else {
                    int newVal = idx + 1;
                    if (clearable && model.Get() == newVal) { newVal = 0; }
                    if (newVal != model.Get()) {
                        model.Set(newVal);
                        if (data != null) { data.Set(newVal); }
                        Change.Raise();
                        app.RequestRedraw();
                    }
                }
            }
        }
        On.Fire(app, baseId);
        return baseId;
    }

    override List<string> Events() {
        List<string> e = Control.CommonEvents();
        e.Add("Change");
        return e;
    }

    /// 将评分的 Change 路由到其 UiEvent 字段；其余一切
    /// 落到 `On` 的公共事件集（其 AddByName 忽略
    /// 不认识的名称）。
    override void BindEvent(string evt, Action a) {
        if (evt == "Change") { Change.Add(a); return; }
        On.AddByName(evt, a);
    }

    /// 按 `rate` CSS 规则绘制星星，悬停的星星预览
    /// 将要设置的评分。半星模式（allowHalf）下，
    /// 整星 = 实心，半星 = 50% alpha 实心（`rate::star-half`）。
    void PaintStars(App app, int x, int y) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        // Size 字段映射为 Class 片段。
        string origClass = Class;
        this.AddClass(this.SizeCls());
        StyleBox s = this.ResolveStyleAs(app, "rate", Class, Style.SNormal());
        StyleBox on = this.ResolvePartAs(app, "rate", "star", "", Class,
                                         Style.SNormal());
        StyleBox off = this.ResolvePartAs(app, "rate", "empty", "", Class,
                                          Style.SNormal());
        StyleBox half = null;
        if (allowHalf) {
            half = this.ResolvePartAs(app, "rate", "star-half", "", Class,
                                       Style.SNormal());
        }
        int fs = s.FontOr(Style.FontFallback(app, "huge"));
        int step = fs + app.Scale(6);
        int rowH = Canvas.FontHeight(fs);

        int preview = 0 - 1;
        int i = 0;
        for (; i < maxStars; i = i + 1) {
            if (app.focus.IsHovered(baseId + i)) { preview = i; }
        }
        // 评分以 *2 编码；显示时除以 2。
        int fillTwos = model.Get();
        int fillTo = fillTwos;
        if (preview >= 0) {
            // 悬停预览也按 *2
            fillTo = preview * 2 + 2;
        }

        int offColor = off.FgOr(0);
        int onColor = on.FgOr(0);
        int halfColor = half != null ? half.FgOr(onColor) : onColor;
        i = 0;
        while (i < maxStars) {
            int sx = x + i * step;
            int color = offColor;
            string name = "star-empty";
            if (allowHalf) {
                int twosHere = fillTo - i * 2;
                if (twosHere >= 2) {
                    color = onColor; name = "star";
                } else if (twosHere == 1) {
                    color = halfColor; name = "star";
                }
            } else {
                if (i < fillTo) {
                    color = onColor; name = "star";
                }
            }
            c.DrawGlyphIn(name, sx, y, step, rowH, fs, color);
            app.hitTester.RegisterRect(baseId + i, sx, y, step,
                                                    rowH, 0);
            i = i + 1;
        }
        Class = origClass;
    }

    override void OnMeasure(App app) {
        string origClass = Class;
        this.AddClass(this.SizeCls());
        int fs = this.ResolveStyleAs(app, "rate", Class, Style.SNormal())
            .FontOr(Style.FontFallback(app, "huge"));
        prefH = Canvas.FontHeight(fs);
        prefW = maxStars * (fs + app.Scale(6));
        Class = origClass;
    }

    override void OnPaint(App app) {
        this.Render(app, bx, by);
    }
}
