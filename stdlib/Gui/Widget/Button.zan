using System;
using Gui;

namespace Gui.Widget;

/// A button. Its whole look is CSS, so a skin restyles it without a line of
/// code here, and the code side is plain assignment -- no setter methods:
///
///     Button save = new Button { Text = "Save", Class = "primary small" };
///     save.Click += () => { ... };
///     save.Disabled = busy;
///
/// The recognised classes are just selectors a skin can define:
///
///     button                                      default
///     .primary .info .success .warning .error     semantic type
///     .outline .text .dashed                      fill treatment
///     .secondary .ghost .specular .loading        modifiers
///     .round .circle                              shape
///     .tiny .small .medium .large                 size (height/font/padding)
///     .stacked                                    icon above the label
///     .align-left                                 content at the leading edge
///
/// `Style` resolves theme defaults -> skin rules -> hover/press states into one
/// StyleBox, `BoxContent` paints that box with the icon and label in it, and
/// `Ui.Activate` makes it clickable -- so this class only measures itself and
/// raises Click.
class Button : Control {
    /// Bindable label: `btn.Text = vm.title;` re-reads the model field every
    /// frame (compiler-lowered Binding); `btn.Text = "OK";` stores a constant.
    Binding<string> Text;
    string Icon;
    /// Bindable on/off state. Bind it to a model field (`btn.Checked = vm.bold;`)
    /// and the button IS a toggle: a click flips that field and the resolved
    /// style gets the `selected` state (`button:checked` in a skin).
    Binding<bool> Checked;
    /// Hover description, shown under the button once the hover settles. Empty
    /// = no tip.
    string Tip;
    int wid;
    /// True for the frame this button was activated, for hosts that poll a
    /// group of buttons (a ribbon, a toolbar) instead of binding a handler to
    /// each one. `Disabled` is inherited from Control (bindable, and inherited
    /// down the tree, so disabling a group disables its commands).
    bool clicked;
    /// Which of the button's corners stay rounded (Corner.All by default). A
    /// group welds its buttons by squaring off the seams between them, so the
    /// strip reads as one control with rounded ends.
    int corners;
    /// Fires on the frame the button is clicked (C#-style: `btn.Click += h;`).
    /// Handlers run through the UI-thread dispatch queue (App.DrainPosts), so a
    /// handler may rebuild the control tree, open a dialog or start a background
    /// job without mutating the tree that is being painted right now.
    /// The common bundle (Enter/Leave/MouseDown/...) is inherited as Control.On.
    UiEvent Click;

    void InitButton(string label) {
        this.InitControl(label, 1);
        Text = label;
        Icon = "";
        Checked = false;
        Tip = "";
        clicked = false;
        corners = Corner.All();
        wid = WidgetId.Next();
        wiresOwnEvents = true;
        Click = UiEvent.Create();
    }

    /// `new Button { Text = "Save", Class = "primary" }`
    Button() { InitButton(""); }

    /// `new Button("Save")` -- same thing with the label up front.
    Button(string label) { InitButton(label); }

    /// Current label text (resolved through the binding).
    string Label() {
        if (Text == null) { return ""; }
        return Text.Get();
    }

    /// Current toggle state (false when the button is not a toggle).
    bool IsChecked() { return Checked.Get(); }

    /// A button whose Checked is bound to a model field is a toggle: a click
    /// flips that field instead of only raising Click.
    bool IsToggle() { return Checked.IsLive(); }

    /// True for the frame the button was activated -- the polling counterpart
    /// of `Click`.
    bool WasClicked() { return clicked; }

    /// What the hover bubble shows: the label, and under it what the command
    /// does (the label alone says nothing new).
    string TipText() {
        if (Tip == "") { return this.Label(); }
        if (this.Label() == "") { return Tip; }
        return this.Label() + "\n" + Tip;
    }

    /// The style this button resolves to right now (size, padding, colours).
    StyleBox ResolvedStyle(App app) {
        return Style.Full(app, "button", Class, name, Style.SNormal());
    }

    /// Natural width with the resolved style applied, which is what Render lays
    /// out with -- a strip that measures buttons this way never ellipsizes a
    /// label it had room for.
    int AutoWidth(App app) {
        Theme t = app.theme;
        StyleBox s = this.ResolvedStyle(app);
        if (Style.Has(Class, "circle")) { return s.HeightOr(t.heightMedium); }
        int fontPx = s.FontOr(t.fontSizeMedium);
        int pads = s.PadLOr(t.paddingLarge) + s.PadROr(t.paddingLarge);
        if (Style.Has(Class, "stacked")) {
            return BoxContent.StackedWidth(app, Icon, this.Label(), fontPx) + pads;
        }
        return BoxContent.Width(Icon, this.Label(), "", fontPx, s.GapOr(t.gapSmall))
            + pads;
    }

    /// Height from the resolved size class -- or from the content for a stacked
    /// button, whose icon sits above its label.
    int AutoHeight(App app) {
        Theme t = app.theme;
        StyleBox s = this.ResolvedStyle(app);
        if (Style.Has(Class, "stacked")) {
            int fontPx = s.FontOr(t.fontSizeMedium);
            return s.HeightOr(BoxContent.StackedHeight(app, Icon, this.Label(),
                                                       fontPx, s.GapOr(t.paddingTiny))
                              + s.PadTOr(t.paddingSmall) + s.PadBOr(t.paddingSmall));
        }
        return s.HeightOr(t.heightMedium);
    }

    int Render(App app, int x, int y, int w) {
        return this.RenderIn(app, x, y, w, 0);
    }

    /// Paints the button into an explicit box; `h` of 0 takes the height from
    /// the resolved style (what Render does), any other value wins -- a strip
    /// that gives its commands a row height (a ribbon band, a toolbar) passes
    /// it here instead of styling every button.
    int RenderIn(App app, int x, int y, int w, int h) {
        bool busy = Style.Has(Class, "loading");
        bool off = this.IsDisabled();
        clicked = false;
        // One resolve for the whole look: theme defaults for the button's
        // classes, the skin's `button…` rules on top, then the hover/press/focus
        // states cross-faded by the resolved `transition`.
        StyleBox s = this.ResolveEasedStyleAs(app, wid, "button", Class,
                                              off, this.IsChecked());
        s.SetRadius(s.RadiusOr(app.theme.borderRadiusMedium));
        if (styleRadius != 0) { s.SetRadius(styleRadius); }
        if (corners != Corner.All()) { s.SetCorners(corners); }
        if (w <= 0) { w = this.AutoWidth(app); }
        w = s.ClampW(w);
        if (h <= 0) { h = s.HeightOr(this.AutoHeight(app)); }
        h = s.ClampH(h);
        BoxContent.Paint(app, wid, "button", Class, name, s, x, y, w, h,
                         Icon, this.Label(), "", busy, off);
        if (off || busy) { return wid; }
        if (Ui.Activate(app, wid, x, y, w, h)) {
            clicked = true;
            // A bound Checked makes the button a toggle: the click writes the
            // model back through the binding before the handlers run.
            if (this.IsToggle()) { Checked.Set(!this.IsChecked()); }
            Click.Post();
            // Wake the loop so the queued handler runs on the next iteration
            // even if no further OS event arrives.
            app.window.Wake();
        }
        if (Tip != "" && Ui.HoverLevel(app, wid) >= 900) {
            Tooltip.Request(x + w / 2, y + h, this.TipText(), Tooltip.Bottom(),
                            app.Scale(260));
        }
        On.Fire(app, wid);
        return wid;
    }

    // ---- designer / serialization model -------------------------------------

    override string Kind() { return "Button"; }

    /// Every property points at the field it edits, so reading and writing them
    /// is the base class's job (Control.GetProp/SetProp) and this list is all the
    /// property code the widget has.
    override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec text = PropSpec.Text("text", "Text");
        text.str = Text;
        ps.Add(text);
        PropSpec icon = PropSpec.Text("icon", "Icon");
        icon.str = Icon;
        ps.Add(icon);
        PropSpec tip = PropSpec.Text("tip", "Tip");
        tip.str = Tip;
        ps.Add(tip);
        PropSpec off = PropSpec.Bool("disabled", "Disabled");
        off.flag = Disabled;
        ps.Add(off);
        PropSpec on = PropSpec.Bool("checked", "Checked");
        on.flag = Checked;
        ps.Add(on);
        // Everything visual is a class: `primary small round ghost loading`,
        // or whatever the skin's CSS defines.
        PropSpec cls = PropSpec.Text("class", "Classes");
        cls.str = Class;
        ps.Add(cls);
        return ps;
    }

    override List<string> Events() {
        List<string> e = Control.CommonEvents();
        e.Add("Click");
        return e;
    }

    // ---- retained-mode hooks (Control) --------------------------------------

    /// Preferred size from the resolved style + content, so docking/auto-layout
    /// can size the button without hand-computed coordinates.
    override void OnMeasure(App app) {
        StyleBox s = this.ResolveStyleAs(app, "button", Class, Style.SNormal());
        prefH = s.HeightOr(this.AutoHeight(app));
        prefW = s.WidthOr(this.AutoWidth(app));
    }

    override void OnPaint(App app) {
        this.RenderIn(app, bx, by, bw, bh);
    }
}
