using System;
using Gui;

namespace Gui.Widget;

/// 按钮。外观完全由 CSS 决定，皮肤无需一行代码即可重设样式，
/// 代码侧只需赋值——没有 setter 方法：
///
///     Button save = new Button { Text = "Save", Class = "primary small" };
///     save.Click += () => { ... };
///     save.Disabled = busy;
///
/// 可识别的 class 只是皮肤可以定义的选择器：
///
///     button                                      默认
///     .primary .info .success .warning .error     语义类型
///     .outline .text .dashed                      填充处理
///     .secondary .ghost .specular .loading        修饰符
///     .round .circle                              形状
///     .tiny .small .medium .large                 尺寸（高度/字体/内边距）
///     .stacked                                    图标在标签上方
///     .align-left                                 内容靠起始边缘
///
/// `Style` 把主题默认 -> 皮肤规则 -> 悬停/按下状态解析为一个
/// StyleBox，`BoxContent` 在该盒子里绘制图标和标签，
/// `Ui.Activate` 使其可点击——所以本类只负责测量自身并
/// 触发 Click。
class Button : Control {
    /// 可绑定标签：`btn.Text = vm.title;` 每帧重新读取模型字段
    /// （编译器降级的 Binding）；`btn.Text = "OK";` 存储常量。
    Binding<string> Text;
    string Icon;
    /// 可绑定的开/关状态。绑定到模型字段（`btn.Checked = vm.bold;`）
    /// 后按钮即成为切换开关：点击翻转该字段，解析出的
    /// 样式进入 `selected` 状态（皮肤中的 `button:checked`）。
    Binding<bool> Checked;
    /// 悬停说明，悬停稳定后显示在按钮下方。空
    /// 表示无提示。
    string Tip;
    int wid;
    /// 按钮被激活的帧为 true，供轮询一组按钮
    /// 的宿主（ribbon、工具栏）使用，而非给每个按钮绑定处理器。
    /// `Disabled` 继承自 Control（可绑定，且沿树
    /// 向下继承，禁用一组即禁用其所有命令）。
    bool clicked;
    /// 按钮哪些角保持圆角（默认 Corner.All）。
    /// 分组通过把按钮间的接缝变方来焊接按钮，使
    /// 整条看起来像一个两端圆角的控件。
    int corners;
    /// 按钮被点击的帧触发（C# 风格：`btn.Click += h;`）。
    /// 处理器经 UI 线程派发队列（App.DrainPosts）执行，因此
    /// 处理器可以重建控件树、打开对话框或启动后台
    /// 任务，而不会改动正在绘制的控件树。
    /// 常用事件集（Enter/Leave/MouseDown/...）由 Control.On 继承。
    UiEvent Click;

    void InitButton(string label) {
        this.InitControl(label, 1);
        Text = label;
        Icon = "";
        Checked = false;
        Tip = "";
        clicked = false;
        corners = Corner.All();
        wid = WidgetId.Next();
        wiresOwnEvents = true;
        Click = new UiEvent();
    }

    /// `new Button { Text = "Save", Class = "primary" }`
    Button() { InitButton(""); }

    /// `new Button("Save")` —— 同样的东西，标签前置。
    Button(string label) { InitButton(label); }

    /// 当前标签文本（通过绑定解析）。
    string Label() {
        if (Text == null) { return ""; }
        return Text.Get();
    }

    /// 当前切换状态（非切换按钮时为 false）。
    bool IsChecked() { return Checked.Get(); }

    /// Checked 绑定到模型字段的按钮即切换开关：点击
    /// 翻转该字段，而不仅仅是触发 Click。
    bool IsToggle() { return Checked.IsLive(); }

    /// 按钮被激活的帧为 true——与 Click 对应的
    /// 轮询版本。
    bool WasClicked() { return clicked; }

    /// 悬停气泡显示的内容：标签，其下方是命令的
    /// 作用（仅标签看不出新意）。
    string TipText() {
        if (Tip == "") { return this.Label(); }
        if (this.Label() == "") { return Tip; }
        return this.Label() + "\n" + Tip;
    }

    /// 该按钮当前解析出的样式（大小、内边距、颜色）。
    StyleBox ResolvedStyle(App app) {
        return this.ResolveStyleCached(app, "button", Class, Style.SNormal());
    }

    /// 应用解析样式后的自然宽度，Render 布局时用的就是它——
    /// 用这种方式测量按钮的条状控件，绝不会省略
    /// 明明放得下的标签。
    int AutoWidth(App app) {
        Theme t = app.theme;
        StyleBox s = this.ResolvedStyle(app);
        if (Style.Has(Class, "circle")) { return s.HeightOr(t.heightMedium); }
        // 只有图标没有文字的按钮（列表行的关闭、工具条上的图标命令）
        // 是正方形：文本按钮左右各一个大内边距，用在 16px 的图标上
        // 就把它撑成一块比图标宽三倍的板子。
        if (Icon != "" && this.Label() == "" && !Style.Has(Class, "stacked")) {
            return this.AutoHeight(app);
        }
        int fontPx = s.FontOr(t.fontSizeMedium);
        int pads = s.PadLOr(t.paddingLarge) + s.PadROr(t.paddingLarge);
        if (Style.Has(Class, "stacked")) {
            return BoxContent.StackedWidth(app, Icon, this.Label(), fontPx) + pads;
        }
        return BoxContent.Width(Icon, this.Label(), "", fontPx, s.GapOr(t.gapSmall))
            + pads;
    }

    /// 高度来自解析出的尺寸类；堆叠按钮则取内容高度，
    /// 因为其图标位于标签上方。
    int AutoHeight(App app) {
        Theme t = app.theme;
        StyleBox s = this.ResolvedStyle(app);
        if (Style.Has(Class, "stacked")) {
            int fontPx = s.FontOr(t.fontSizeMedium);
            return s.HeightOr(BoxContent.StackedHeight(app, Icon, this.Label(),
                                                       fontPx, s.GapOr(t.paddingTiny))
                              + s.PadTOr(t.paddingSmall) + s.PadBOr(t.paddingSmall));
        }
        return s.HeightOr(t.heightMedium);
    }

    int Render(App app, int x, int y, int w) {
        return this.RenderIn(app, x, y, w, 0);
    }

    /// 把按钮绘制到显式盒子中；`h` 为 0 时取解析样式的高度
    /// （即 Render 的行为），其他值优先——条状控件
    /// （ribbon 带、工具栏）给命令统一行高时，
    /// 直接传进来即可，无需逐个设置样式。
    int RenderIn(App app, int x, int y, int w, int h) {
        bool busy = Style.Has(Class, "loading");
        bool off = this.IsDisabled();
        clicked = false;
        // 一次性解析整个外观：按钮各 class 的主题默认值，
        // 叠加皮肤的 `button…` 规则，再用解析出的 `transition`
        // 对悬停/按下/焦点状态做交叉淡化。
        StyleBox s = this.ResolveEasedStyleAs(app, wid, "button", Class,
                                              off, this.IsChecked());
        s.SetRadius(s.RadiusOr(app.theme.borderRadiusMedium));
        if (styleRadius != 0) { s.SetRadius(styleRadius); }
        if (corners != Corner.All()) { s.SetCorners(corners); }
        if (w <= 0) { w = this.AutoWidth(app); }
        w = s.ClampW(w);
        if (h <= 0) { h = s.HeightOr(this.AutoHeight(app)); }
        h = s.ClampH(h);
        BoxContent.Paint(app, wid, "button", Class, name, s, x, y, w, h,
                         Icon, this.Label(), "", busy, off);
        if (off || busy) { return wid; }
        if (Ui.Activate(app, wid, x, y, w, h)) {
            clicked = true;
            // 绑定的 Checked 使按钮成为切换开关：点击先把
            // 模型通过绑定写回，再运行处理器。
            if (this.IsToggle()) { Checked.Set(!this.IsChecked()); }
            Click.Post();
            // 唤醒事件循环，使排队的处理器在下一轮执行，
            // 即使之后没有新的 OS 事件到达。
            app.window.Wake();
        }
        if (Tip != "" && Ui.HoverLevel(app, wid) >= 900) {
            Tooltip.RequestBox(app, x, y, w, h, this.TipText(), Tooltip.Bottom(),
                               app.Scale(260));
        }
        On.Fire(app, wid);
        return wid;
    }

    // ---- 设计器 / 序列化模型 -------------------------------------

    override string Kind() { return "Button"; }

    /// 每个属性都指向其编辑的字段，读写操作
    /// 由基类完成（Control.GetProp/SetProp），此列表就是该控件
    /// 的全部属性代码。
    override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec text = PropSpec.Text("text", "Text");
        text.str = Text;
        ps.Add(text);
        PropSpec icon = PropSpec.Text("icon", "Icon");
        icon.str = Icon;
        ps.Add(icon);
        PropSpec tip = PropSpec.Text("tip", "Tip");
        tip.str = Tip;
        ps.Add(tip);
        PropSpec off = PropSpec.Bool("disabled", "Disabled");
        off.flag = Disabled;
        ps.Add(off);
        PropSpec on = PropSpec.Bool("checked", "Checked");
        on.flag = Checked;
        ps.Add(on);
        // 所有视觉样式都是 class：`primary small round ghost loading`，
        // 或皮肤 CSS 定义的任何类。
        PropSpec cls = PropSpec.Text("class", "Classes");
        cls.str = Class;
        ps.Add(cls);
        return ps;
    }

    override List<string> Events() {
        // Click 已属于常用事件集，无需额外声明。
        return Control.CommonEvents();
    }

    /// 把 Click 路由到 Click UiEvent 字段（与 `btn.Click += h` 同一队列），
    /// 而非基类的 `On` 事件集，使 JSON/设计器的 `onClick`
    /// 处理器与代码处理器走同一通道并按序执行。
    override void BindEvent(string evt, Action a) {
        if (evt == "Click") { Click.Add(a); return; }
        On.AddByName(evt, a);
    }

    // ---- 保留模式钩子（Control）-------------------------------------

    /// 首选尺寸由解析样式 + 内容得出，停靠/自动布局
    /// 无需手算坐标即可确定按钮大小。
    override void OnMeasure(App app) {
        StyleBox s = this.ResolvedStyle(app);
        prefH = s.HeightOr(this.AutoHeight(app));
        prefW = s.WidthOr(this.AutoWidth(app));
    }

    override void OnPaint(App app) {
        this.RenderIn(app, bx, by, bw, bh);
    }
}
