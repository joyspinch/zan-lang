using System;
using Gui;

namespace Gui.Widget;

/// 锚定到某一点的提示气泡，带小三角。支持四种
/// 位置（上 / 下 / 左 / 右），长文本自动换行，
/// 并且有高度上限，换行内容
/// 溢出时显示滚动条指示。
class Tooltip {
    static int FontSize(App app) {
        StyleBox s = Style.Of(app, "tooltip", "", Style.SNormal());
        return s.FontOr(Style.FontFallback(app, "small"));
    }

    static int Top() { return 0; }
    static int Bottom() { return 1; }
    static int Left() { return 2; }
    static int Right() { return 3; }

    // 实心向下三角形（宽底在 `topY` 上方，尖在下方）。
    static void TriDown(Canvas c, int cx, int topY, int half, int h, int color) {
        for (int r = 0; r < h; r = r + 1) {
            int hw = half - half * r / h;
            if (hw < 1) { hw = 1; }
            c.FillRect(cx - hw, topY + r, hw * 2, 1, color);
        }
    }

    // 实心向上三角形（尖在 `topY`，宽底在下方）。
    static void TriUp(Canvas c, int cx, int topY, int half, int h, int color) {
        for (int r = 0; r < h; r = r + 1) {
            int hw = half * r / h;
            if (hw < 1) { hw = 1; }
            c.FillRect(cx - hw, topY + r, hw * 2, 1, color);
        }
    }

    // 实心向左三角形（尖在 `leftX`，宽底在右侧）。
    static void TriLeft(Canvas c, int leftX, int cy, int half, int w, int color) {
        for (int r = 0; r < w; r = r + 1) {
            int hh = half * r / w;
            if (hh < 1) { hh = 1; }
            c.FillRect(leftX + r, cy - hh, 1, hh * 2, color);
        }
    }

    // 实心向右三角形（尖在 `leftX`+w，宽底在左侧）。
    static void TriRight(Canvas c, int leftX, int cy, int half, int w, int color) {
        for (int r = 0; r < w; r = r + 1) {
            int hh = half - half * r / w;
            if (hh < 1) { hh = 1; }
            c.FillRect(leftX + r, cy - hh, 1, hh * 2, color);
        }
    }

    /// 贪婪地将 `text` 按词换行，使每行不超过 `maxW` 像素。
    /// 没有空格的长单词按字符硬拆。
    static List<string> WrapLines(string text, int fs, int maxW) {
        List<string> lines = new List<string>();
        if (maxW <= 0) { lines.Add(text); return lines; }
        int n = text.Length;
        string cur = "";
        string word = "";
        for (int i = 0; i <= n; i = i + 1) {
            string ch = "";
            if (i < n) { ch = text.Substring(i, 1); }
            if (i == n || ch == " " || ch == "\n") {
                string cand = cur;
                if (cur == "") { cand = word; } else { cand = cur + " " + word; }
                if (Canvas.MeasureText(cand, fs) <= maxW) {
                    cur = cand;
                } else {
                    if (cur != "") { lines.Add(cur); }
                    // 单词单独超过 maxW 时按字符硬拆。
                    while (Canvas.MeasureText(word, fs) > maxW && word.Length > 1) {
                        int lo = 1;
                        int hi = word.Length;
                        while (lo < hi) {
                            int mid = (lo + hi + 1) / 2;
                            if (Canvas.MeasureText(word.Substring(0, mid), fs) <= maxW) { lo = mid; }
                            else { hi = mid - 1; }
                        }
                        // 绝不在多字节字符中间断开；至少保留
                        // 一个完整字符，保证循环能推进。
                        lo = Text.ClampCharStart(word, lo);
                        if (lo <= 0) { lo = Text.NextCharEnd(word, 0); }
                        lines.Add(word.Substring(0, lo));
                        word = word.Substring(lo, word.Length - lo);
                    }
                    cur = word;
                }
                word = "";
                if (ch == "\n") { lines.Add(cur); cur = ""; }
            } else {
                word = word + ch;
            }
        }
        if (cur != "") { lines.Add(cur); }
        if (lines.Count == 0) { lines.Add(""); }
        return lines;
    }

    static int TipCapH(App app) { return app.Scale(148); }

    /// 为给定的锚点/位置/宽度解析屏幕上的气泡矩形（原点 + 受限尺寸），
    /// 采用与绘制时相同的边缘翻转 + 限制。
    /// 调用方用它对滚轮输入做命中测试。
    static Rect BoxRect(App app, int anchorX, int anchorY, string text,
                        int placement, int maxW) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int fs = Tooltip.FontSize(app);
        int pad = app.Scale(8);
        int lineH = Canvas.FontHeight(fs);
        int notch = app.Scale(6);
        int gap = app.Scale(6);
        int margin = app.Scale(4);

        List<string> lines = Tooltip.WrapLines(text, fs, maxW);
        int textW = 0;
        for (int li = 0; li < lines.Count; li = li + 1) {
            int lw = Canvas.MeasureText(lines[li], fs);
            if (lw > textW) { textW = lw; }
        }
        int boxW = textW + pad * 2;
        int fullH = lines.Count * lineH + pad * 2;
        int maxBoxH = Tooltip.TipCapH(app);
        int boxH = fullH;
        if (boxH > maxBoxH) { boxH = maxBoxH; }

        int top = app.titlebarH;
        int cw = c.Width();
        int chh = c.Height();

        int bx = 0;
        int by = 0;
        int place = placement;
        if (place == 0) {
            if (anchorY - gap - notch - boxH < top) { place = 1; }
        } else if (place == 1) {
            if (anchorY + gap + notch + boxH > chh - margin) { place = 0; }
        } else if (place == 2) {
            if (anchorX - gap - notch - boxW < margin) { place = 3; }
        } else if (place == 3) {
            if (anchorX + gap + notch + boxW > cw - margin) { place = 2; }
        }

        if (place == 0) {
            bx = anchorX - boxW / 2;
            by = anchorY - gap - notch - boxH;
        } else if (place == 1) {
            bx = anchorX - boxW / 2;
            by = anchorY + gap + notch;
        } else if (place == 2) {
            bx = anchorX - gap - notch - boxW;
            by = anchorY - boxH / 2;
        } else {
            bx = anchorX + gap + notch;
            by = anchorY - boxH / 2;
        }

        if (bx < margin) { bx = margin; }
        if (bx + boxW > cw - margin) { bx = cw - margin - boxW; }
        if (by < top) { by = top; }
        if (by + boxH > chh - margin) { by = chh - margin - boxH; }

        return new Rect(bx, by, boxW, boxH);
    }

    /// 提示的最大滚动偏移（px）：内容适配高度上限时为 0。
    static int MaxScroll(App app, string text, int maxW) {
        int fs = Tooltip.FontSize(app);
        int pad = app.Scale(8);
        int lineH = Canvas.FontHeight(fs);
        List<string> lines = Tooltip.WrapLines(text, fs, maxW);
        int fullH = lines.Count * lineH + pad * 2;
        int m = fullH - Tooltip.TipCapH(app);
        if (m < 0) { m = 0; }
        return m;
    }

    /// 富锚定提示：不透明深色气泡，正文自动换行，
    /// 四种位置（即将离开屏幕时自动翻转），
    /// 换行文本高于高度上限时显示滚动条。
    /// `anchorX`/`anchorY` 是三角应触及的点。`scrollOff` 是
    /// 垂直滚动量（限制在 [0, MaxScroll]）。
    static void RenderScroll(App app, int anchorX, int anchorY, string text,
                             int placement, int maxW, int scrollOff) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int fs = Tooltip.FontSize(app);
        int pad = app.Scale(8);
        int lineH = Canvas.FontHeight(fs);
        int notch = app.Scale(6);

        List<string> lines = Tooltip.WrapLines(text, fs, maxW);
        int fullH = lines.Count * lineH + pad * 2;
        Rect box = Tooltip.BoxRect(app, anchorX, anchorY, text, placement, maxW);
        int bx = box.x;
        int by = box.y;
        int boxW = box.width;
        int boxH = box.height;
        bool scroll = fullH > boxH;

        // 根据气泡位置重新推导三角的最终位置。
        int place = placement;
        if (by + boxH <= anchorY) { place = 0; }
        else if (by >= anchorY) { place = 1; }
        else if (bx + boxW <= anchorX) { place = 2; }
        else { place = 3; }

        int off = scrollOff;
        int maxOff = fullH - boxH;
        if (maxOff < 0) { maxOff = 0; }
        if (off > maxOff) { off = maxOff; }
        if (off < 0) { off = 0; }

        StyleBox s = Style.Of(app, "tooltip", "", Style.SNormal());
        int bg = s.bg;
        int border = s.borderColor;
        int fg = s.fg;

        c.FillRoundRect(bx + s.shadowDx, by + s.shadowDy, boxW, boxH,
                        s.RadiusOr(t.borderRadiusSmall), s.shadow);
        c.SurfaceRoundRect(bx, by, boxW, boxH, s.RadiusOr(t.borderRadiusSmall),
                           bg, border, s.BorderWOr(1));

        // 指向锚点一侧的指针三角。
        if (place == 0) {
            Tooltip.TriDown(c, anchorX, by + boxH, notch, notch, bg);
        } else if (place == 1) {
            Tooltip.TriUp(c, anchorX, by - notch, notch, notch, bg);
        } else if (place == 2) {
            Tooltip.TriRight(c, bx + boxW, anchorY, notch, notch, bg);
        } else {
            Tooltip.TriLeft(c, bx - notch, anchorY, notch, notch, bg);
        }

        // 将文本裁剪到（可能受限的）内容区域，并绘制
        // 按滚动偏移上移的行。
        int innerX = bx + pad;
        int innerY = by + pad;
        int innerW = boxW - pad * 2;
        int innerH = boxH - pad * 2;
        c.PushClip(innerX, innerY, innerW, innerH);
        int ty = innerY - off;
        for (int li = 0; li < lines.Count; li = li + 1) {
            c.DrawText(innerX, ty, lines[li], fg, fs);
            ty = ty + lineH;
        }
        c.PopClip();

        // 滚动条，滑块位置由滚动偏移决定。
        if (scroll) {
            int barW = app.Scale(3);
            int barX = bx + boxW - barW - app.Scale(3);
            int barY = by + pad;
            int barH = boxH - pad * 2;
            int thumbH = barH * innerH / (fullH - pad * 2);
            if (thumbH < app.Scale(16)) { thumbH = app.Scale(16); }
            int travel = barH - thumbH;
            int thumbY = barY;
            if (maxOff > 0) { thumbY = barY + travel * off / maxOff; }
            StyleBox trackStyle = Style.Part(app, "tooltip", "scrollbar-track",
                                             "", "", "", Style.SNormal());
            StyleBox thumbStyle = Style.Part(app, "tooltip", "scrollbar", "",
                                             "", "", Style.SNormal());
            c.FillRoundRect(barX, barY, barW, barH, barW / 2, trackStyle.bg);
            c.FillRoundRect(barX, thumbY, barW, thumbH, barW / 2, thumbStyle.bg);
        }
    }

    /// 无滚动的锚定提示（偏移 0）。为现有调用方保留。
    static void RenderAt(App app, int anchorX, int anchorY, string text,
                         int placement, int maxW) {
        Tooltip.RenderScroll(app, anchorX, anchorY, text, placement, maxW, 0);
    }

    /// 锚定到控件矩形的提示：调用方传入
    /// 组件边界，位置决定贴哪条边——Top 位于控件
    /// 上方（三角在顶缘）、Bottom 在下方、Left/Right 在两侧。
    /// 调用点无需手动计算锚点。
    static void RenderBox(App app, int x, int y, int w, int h, string text,
                          int placement, int maxW) {
        int ax = x + w / 2;
        int ay = y + h / 2;
        if (placement == 0) { ay = y; }
        else if (placement == 1) { ay = y + h; }
        else if (placement == 2) { ax = x; }
        else { ax = x + w; }
        Tooltip.RenderScroll(app, ax, ay, text, placement, maxW, 0);
    }

    /// RenderBox 的延迟（帧末统一刷新）变体：为控件的矩形请求提示，
    /// 位置决定贴哪条边。
    static void RequestBox(App app, int x, int y, int w, int h, string text,
                           int placement, int maxW) {
        int ax = x + w / 2;
        int ay = y + h / 2;
        if (placement == 0) { ay = y; }
        else if (placement == 1) { ay = y + h; }
        else if (placement == 2) { ax = x; }
        else { ax = x + w; }
        Tooltip.Request(ax, ay, text, placement, maxW);
    }

    /// 不透明两行提示：粗体标题在上，弱化描述在下。
    static void RenderRich(App app, int x, int y, string title, string desc) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int fs = Tooltip.FontSize(app);
        int pad = app.Scale(8);
        int lh = Canvas.FontHeight(fs);
        int tw = Canvas.MeasureText(desc, fs);
        int titleW = Canvas.MeasureText(title, fs);
        if (titleW > tw) { tw = titleW; }
        int boxW = tw + pad * 2;
        int boxH = lh * 2 + app.Scale(4) + pad * 2;
        int margin = app.Scale(4);
        if (x + boxW > c.Width() - margin) { x = c.Width() - margin - boxW; }
        if (x < margin) { x = margin; }
        if (y + boxH > c.Height() - margin) { y = c.Height() - margin - boxH; }
        if (y < app.titlebarH) { y = app.titlebarH; }

        StyleBox s = Style.Of(app, "tooltip", "", Style.SNormal());
        int bg = s.bg;
        int border = s.borderColor;
        int titleColor = Style.Part(app, "tooltip", "title", "", "", "",
                                    Style.SNormal()).fg;
        int descColor = Style.Part(app, "tooltip", "desc", "", "", "",
                                   Style.SNormal()).fg;

        c.FillRoundRect(x + s.shadowDx, y + s.shadowDy, boxW, boxH,
                        s.RadiusOr(t.borderRadiusSmall), s.shadow);
        c.SurfaceRoundRect(x, y, boxW, boxH, s.RadiusOr(t.borderRadiusSmall),
                           bg, border, s.BorderWOr(1));
        c.DrawText(x + pad, y + pad, title, titleColor, fs);
        c.DrawText(x + pad, y + pad + lh + app.Scale(4), desc, descColor, fs);
    }

    /// 锚点上方简单的单行提示（空间不足时翻到下方）。为现有
    /// 调用方保留；委托给感知位置的渲染器。
    static void Render(App app, int anchorX, int anchorY, string text) {
        Tooltip.RenderAt(app, anchorX, anchorY, text, 0, 0);
    }

    // ---------------------------------------------------------------- 延迟
    // 提示必须绘制在所有内容之上，但拥有它的控件（
    // 工具栏按钮、标签页）在帧内绘制较早，会被
    // 盖住。因此这类控件悬停时只*请求*提示；
    // 宿主在帧的末尾刷新挂起的提示：
    //
    //   ... 渲染 UI ...
    //   Tooltip.Flush(app);
    //   app.PresentFrame();
    //
    // 本帧的最后一次请求胜出——指针只在一个控件上。

    static string pendingText;
    static int pendingX;
    static int pendingY;
    static int pendingPlace;
    static int pendingMaxW;

    /// 入队控件本帧希望显示的悬停提示，锚定在
    /// 三角应触及的点上。
    static void Request(int anchorX, int anchorY, string text, int placement,
                        int maxW) {
        if (text == null || text == "") { return; }
        Tooltip.pendingText = text;
        Tooltip.pendingX = anchorX;
        Tooltip.pendingY = anchorY;
        Tooltip.pendingPlace = placement;
        Tooltip.pendingMaxW = maxW;
    }

    /// 绘制本帧请求的提示（若有）并清空队列。
    static void Flush(App app) {
        if (Tooltip.pendingText == null || Tooltip.pendingText == "") { return; }
        Tooltip.RenderAt(app, Tooltip.pendingX, Tooltip.pendingY,
            Tooltip.pendingText, Tooltip.pendingPlace, Tooltip.pendingMaxW);
        Tooltip.pendingText = "";
    }
}
