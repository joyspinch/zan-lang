using System;
using Gui;

namespace Gui.Widget;

/// <summary>
/// 自管理的垂直滚动容器。
///
/// 创建一次并跨帧保留；它自持滚动偏移，指针在内部时消费
/// 鼠标滚轮事件，将内容裁剪到
/// 视口内，并仅在内容
/// 溢出时绘制（并拖动处理）滚动条。调用方无需注册滚动条或跟踪滚动状态：
///
///   // 创建一次，放在其他状态旁：
///   ScrollView nav = new ScrollView();
///
///   // 每帧：
///   Rect area = new Rect(x, y, w, h);
///   int dy = nav.Begin(app, area, contentHeight);
///   // 按自然 Y 减去 dy 绘制各项；`area` 之外的内容
///   // 会被自动裁剪。
///   nav.End(app, area);
/// </summary>
class ScrollView {
    int offset;
    int viewH;
    int contentH;
    int barW;
    bool edgeInset;
    bool dragging;
    int dragMouseY0;
    int dragOffset0;
    int dragMo0;
    // 内容高度瞬时塌陷保护：mo 收缩把 offset 钳低的那一刻，先记住
    // 「被钳前的位置」与「收缩前的 mo」；mo 恢复到收缩前的水平时，把
    // offset 还原。内容高度由上一帧的实测结果决定，任何一帧误报（图片
    // 未加载、列表延迟建行、容器测量抖动）都会让 mo 跳水，用户看到的
    // 正是「滚下去的位置弹回来」；恢复通道让这类瞬时塌陷不再丢滚动
    // 位置。lastMo 保存上一帧的 mo，供钳制时判断「收缩前水平」。
    int collapseSavedOffset;
    int collapseMo;
    int lastMo;
    bool collapsePending;

    ScrollView() {
        this.offset = 0;
        this.viewH = 0;
        this.contentH = 0;
        this.barW = 8;
        this.edgeInset = false;
        this.dragging = false;
        this.dragMouseY0 = 0;
        this.dragOffset0 = 0;
        this.dragMo0 = 0;
        this.collapseSavedOffset = 0;
        this.collapseMo = 0;
        this.lastMo = 0;
        this.collapsePending = false;
    }

    /// 从右侧内收滚动条，避开窗口的调整大小
    /// 边框（仅当视图紧贴窗口边缘时需要，例如
    /// 详情面板——导航列表保持默认贴边位置）。
    void SetEdgeInset(bool v) {
        edgeInset = v;
    }

    /// 当前滚动位置（像素）。
    int Offset() {
        return offset;
    }

    /// 上次测量的视口/内容对应的最大有效滚动偏移。
    int MaxOffset() {
        int m = contentH - viewH;
        if (m < 0) { m = 0; }
        return m;
    }

    /// 内容高于视口时返回 true（显示滚动条）。
    bool Overflowing() {
        return contentH > viewH;
    }

    /// 以编程方式滚动到像素偏移（下一帧钳制）。
    void ScrollTo(int y) {
        offset = y;
        if (offset < 0) { offset = 0; }
        collapsePending = false;
    }

    /// <summary>
    /// 开始一帧：测量视口、处理鼠标滚轮、钳制
    /// 偏移并将绘制裁剪到 `area`。返回内容应上移的像素数，
    /// 从每个项的自然 Y 中减去该值。
    /// </summary>
    int Begin(App app, Rect area, int contentHeight) {
        viewH = area.height;
        contentH = contentHeight;

        bool inside = Ui.Over(app, area.x, area.y, area.width, area.height);
        // 本帧滚轮是否把 offset 抬过了本帧的 mo（合法贴底钳制）：这时
        // 的钳制不得武装塌陷恢复。mo0 用本帧 contentH/viewH（Begin 入口
        // 已更新）——滚轮只动 offset 不动内容，先算可照算。
        int mo0 = contentH - viewH;
        if (mo0 < 0) { mo0 = 0; }
        bool wheeledPastMo = false;
        if (inside) {
            // 认领滚轮事件，使页面（及任何外层容器）在指针位于此视口上时
            // 不会同时滚动。
            bool ownsWheel = app.CaptureWheel(
                area.x, area.y, area.width, area.height);
            if (ownsWheel) {
                int d = app.window.EventKeyCode();
                int before = offset;
                offset = offset - d * app.scrollSpeed / 120;
                if (offset != before) {
                    app.NoteScrollDamage(area.x, area.y,
                        area.width, area.height);
                    // 滚轮向下（d<0）使 offset 增大：越过本帧 mo 就会被
                    // 下面的钳制贴底——这是合法钳制，不武装塌陷恢复。
                    if (offset > before && offset > mo0) {
                        wheeledPastMo = true;
                    }
                }
                // 用户滚轮接管：塌陷恢复让位给真实意图。
                collapsePending = false;
            }
        }

        int mo = contentH - viewH;
        if (mo < 0) { mo = 0; }
        if (collapsePending && mo >= collapseMo && collapseSavedOffset > mo) {
            // mo 恢复到收缩前的水平：还原被钳位置。滚轮/拖拽/ScrollTo
            // 发生过的帧不会走到这里——那些路径先清 collapsePending；
            // mo 仍低于收缩前水平时同样不命中（挂起标记继续挂着），
            // 用户的位置既不丢、也不在塌陷期间被反复打扰。
            offset = collapseSavedOffset;
            collapsePending = false;
            app.NoteScrollDamage(area.x, area.y,
                area.width, area.height);
        }
        if (offset > mo) {
            if (!wheeledPastMo) {
                // mo 收缩：唯一会「往下掰」offset 的路径。用户滚轮把
                // offset 抬到 mo 以上是合法贴底钳制（wheeledPastMo 为真，
                // 不武装——否则此后内容正常增长会被误还原成「无输入的
                // 向下跳」）。能到这里的就是 mo 本身缩水：上一帧的实测
                // 高度被误报拉低（图片未加载、列表延迟建行、容器测量
                // 抖动）。记住被钳前的位置与收缩前的 mo（lastMo），等
                // mo 恢复就还原，滚动位置不因内容高度的瞬时塌陷而永久
                // 丢失（用户感知为「滚下去的位置弹回来」）。
                collapseSavedOffset = offset;
                collapseMo = lastMo;
                collapsePending = true;
            }
            offset = mo;
        }
        if (offset < 0) { offset = 0; }
        lastMo = mo;

        app.canvas.PushClip(area.x, area.y, area.width, area.height);
        return offset;
    }

    /// <summary>
    /// 结束一帧：释放视口裁剪区，并在内容溢出时绘制
    /// 滚动条并处理滑块拖动。传入与 Begin 相同的 Rect。
    /// </summary>
    void End(App app, Rect area) {
        app.canvas.PopClip();

        if (contentH <= viewH) {
            dragging = false;
            return;
        }

        Canvas c = app.canvas;

        // 紧贴窗口边缘的视图把滚动条内收到 ~8px
        // 调整大小边框内，使按压触发滑块拖动而非窗口
        // 调整大小；其他视图保持原有 2px 间隙。
        int bw = app.Scale(barW);
        int inset = app.Scale(2);
        if (edgeInset) { inset = app.Scale(10); }
        int by = area.y;
        int bh = area.height;
        if (bh <= 0) { dragging = false; return; }

        // 绝不让滚动条溢出极窄视图的左边缘。
        if (bw > area.width) { bw = area.width; }
        if (bw < 1) { bw = 1; }
        int bx = area.x + area.width - bw - inset;
        if (bx < area.x) { bx = area.x; }

        int minThumb = app.Scale(24);
        if (minThumb > bh) { minThumb = bh; }
        int thumbH = bh * bh / contentH;
        if (thumbH < minThumb) { thumbH = minThumb; }
        if (thumbH > bh) { thumbH = bh; }
        int mo = contentH - viewH;
        if (mo < 0) { mo = 0; }
        int travel = bh - thumbH;
        if (travel < 0) { travel = 0; }

        int thumbY = by;
        if (mo > 0) { thumbY = by + offset * travel / mo; }
        if (thumbY < by) { thumbY = by; }
        if (thumbY + thumbH > by + bh) { thumbY = by + bh - thumbH; }

        bool overThumb = Ui.Over(app, bx, thumbY, bw, thumbH);
        bool overBar = Ui.Over(app, bx, by, bw, bh);

        if (!dragging && Ui.MousePressed(app) && overBar) {
            // 点击轨道（非滑块）时，滑块跳到指针位置，
            // 随后从那里拖动——整个滚动条都可抓取。
            if (!overThumb && travel > 0) {
                int want = app.mouseY - by - thumbH / 2;
                int off = want * mo / travel;
                if (off < 0) { off = 0; }
                if (off > mo) { off = mo; }
                if (off != offset) {
                    offset = off;
                    app.NoteScrollDamage(area.x, area.y,
                        area.width, area.height);
                }
            }
            dragging = true;
            dragMouseY0 = app.mouseY;
            dragOffset0 = offset;
            dragMo0 = mo;
            // 用户直接操作滚动条：塌陷恢复让位给真实意图。
            collapsePending = false;
        }

        if (dragging) {
            int dyPix = app.mouseY - dragMouseY0;
            int off = dragOffset0;
            if (mo != dragMo0) {
                // 内容高度在拖拽中变了（自动量高、图片加载、列表增长）：
                // 以当前位置重新锚定。锚点公式 off = dragOffset0 +
                // dyPix*mo/travel 里的 mo 若不跟锚点同代，高度一变
                // 按住不动也会自己滚 —— mo 越大滚得越远的正反馈，
                // 用户感知为拖住滑块页面自己跑掉。
                dragOffset0 = offset;
                dragMouseY0 = app.mouseY;
                dragMo0 = mo;
                dyPix = 0;
            }
            if (travel > 0) { off = dragOffset0 + dyPix * mo / travel; }
            if (off < 0) { off = 0; }
            if (off > mo) { off = mo; }
            if (off != offset) {
                offset = off;
                app.NoteScrollDamage(area.x, area.y,
                    area.width, area.height);
            }
            if (Ui.MouseReleased(app)) { dragging = false; }
            thumbY = by;
            if (mo > 0) { thumbY = by + offset * travel / mo; }
        }

        StyleBox track = Style.Of(app, "scrollbar", "", Style.SNormal());
        int thumbState = Style.SNormal();
        if (dragging || overThumb) { thumbState = Style.SHover(); }
        StyleBox thumb = Style.Part(app, "scrollbar", "thumb", "", "", "",
                                    thumbState);

        int half = bw / 2;
        // 将滚动条裁剪到视口内，使其无论调用方传入什么几何参数
        // 都不会绘制出视图边界。
        c.PushClip(area.x, area.y, area.width, area.height);
        c.FillRoundRect(bx, by, bw, bh, half, track.bg);
        c.FillRoundRect(bx, thumbY, bw, thumbH, half, thumb.bg);
        c.PopClip();
    }
}
