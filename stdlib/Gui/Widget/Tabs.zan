using System;
using Gui;

namespace Gui.Widget;

/// <summary>
/// 高层级、自包含的标签页组件。
///
/// 保留式组件（创建一次，跨帧保留），拥有自己的标签页
/// 列表、活动索引、可关闭状态和右键上下文菜单。它只绘制
/// 标签页 HEADER（标签条）；调用方把活动页渲染到
/// 独立的正文区域，因此头部和页面区域完全
/// 解耦，可各自独立放置：
///
///   // 一次：
///   Tabs tabs = new Tabs(Tabs.Card(, 0));   // or Tabs.CreateVertical(...)
///   tabs.SetShowAdd(true);                   // 尾部「+」按钮
///   tabs.Add("Overview", false);             // (标签, 是否可关闭)
///   tabs.Add("Details", true);
///
///   // 每帧——头部：
///   tabs.Render(app, x, y, width);           // 水平
///   // tabs.RenderVertical(app, x, y, w, h); // 垂直轨道
///   // ...然后在正文区域为 tabs.Active() 绘制你自己的页面。
///
///   int now   = tabs.Active();
///   int added = tabs.TakeAdded();    // 本帧追加的索引，或 -1
///   int shut  = tabs.TakeClosed();   // 移除的索引（一帧一个），或 -1
///
/// 样式：Line（下划线）、Card（凸起标签）、Segment（胶囊组）。
/// 方向：Horizontal（顶部条）或 Vertical（侧边轨道）。
/// </summary>

/// 一个标签页：其标签以及是否显示关闭按钮。用一个实体代替
/// 并行的 label/closable 列表。
class TabItem {
    string label;
    bool closable;

    TabItem(string label, bool closable) {
        this.label = label;
        this.closable = closable;
    }
}

class Tabs : Control {
    List<TabItem> tabs;
    int active;
    int style;
    int orient;
    bool showAdd;
    /// 全局 closable：true 时新建 tab 默认带 X（Naive UI closable）。
    bool closableAll;
    /// 尺寸变体：small/medium/large（Naive UI size）。Binding<string>
    /// 支持响应式换档，属性面板直接读写选项文本。
    Binding<string> Size;
    int scroll;
    bool follow;
    bool hostModel;
    int ctxIndex;
    /// 设计出来的页容器（下标 = 标签索引）。有了它，标签条
    /// 本身就是容器：设计器 / .zform 里放在某个标签下的控件
    /// 经 SlotHost 落进对应的页，切换标签即切换页面，宿主
    /// 不必自己隐藏和摆放每一页。为空时控件行为与从前一致
    /// （只画标签条，页面由宿主自行绘制）。
    List<Panel> pages;
    /// `options` 的原样文本，供检查器 / 序列化按原样回读。
    string itemsSpec;
    /// 上一次测量出的表头高度与侧栏宽度：Arrange 拿不到 App，
    /// 而页面区正是表头之外的那块。
    int hdrH;
    int trackW;

    int changedIndex;
    int closedIndex;
    int addedIndex;
    /// 还没被宿主领走的关闭索引，从大到小排队。批量关闭（关闭全部 /
    /// 关闭其他）一次移除多个标签，而宿主每帧只 TakeClosed() 一次并按
    /// 索引删自己的并行数组（页、浏览器…）：只报一个索引，宿主就少删
    /// 几项，剩下的条目全部错位到别人的页上。倒序入队使每个上报的
    /// 索引在宿主删到它之前始终指向自己那一项。
    List<int> closedQueue;

    SignalBool menuOpen;
    int menuTab;
    int menuX;
    int menuY;
    SignalInt menuAction;
    SignalInt menuSub;
    int menuBaseId;

    UiEvent TabChanged;
    UiEvent TabClosed;
    UiEvent TabAdded;

    /// 内置上下文菜单标签的 UI 语言（0 = 英语，1 = 简体中文）。宿主可在
    /// 渲染前改它，让菜单跟随应用语言；默认简体中文，因为不设语言的
    /// 发布版界面本身就是中文的，此时菜单不该是唯一说英语的地方。
    static int lang = 1;

    static string TT(string en, string zh) {
        if (Tabs.lang == 1) { return zh; }
        return en;
    }

    static int Line() { return 0; }
    static int Card() { return 1; }
    static int Segment() { return 2; }

    static int Horizontal() { return 0; }
    static int Vertical() { return 1; }

    static Tabs CreateVertical(int style) {
        return new Tabs(style, 1);
    }

    /// 默认标签条：Line 外观、水平方向。（没有这个构造，`new Tabs()`
    /// 会跳过唯一的构造函数，留下一个字段全为 null 的对象。）
    Tabs() : this(0, 0) { }

    /// 给定外观的水平标签条；垂直轨道用 `new Tabs(style, Tabs.Vertical())`。
    Tabs(int style) : this(style, 0) { }

    Tabs(int style, int orient) {
        this.InitControl("tabs", 0);
        this.tabs = new List<TabItem>();
        this.active = 0;
        this.style = style;
        this.orient = orient;
        this.showAdd = false;
        this.closableAll = false;
        this.Size = "medium";
        this.scroll = 0;
        this.follow = false;
        this.hostModel = false;
        this.ctxIndex = 0 - 1;
        this.pages = new List<Panel>();
        this.itemsSpec = "";
        this.hdrH = 0;
        this.trackW = 0;
        this.changedIndex = 0 - 1;
        this.closedIndex = 0 - 1;
        this.addedIndex = 0 - 1;
        this.closedQueue = new List<int>();
        this.menuOpen = new SignalBool(false);
        this.menuTab = 0;
        this.menuX = 0;
        this.menuY = 0;
        this.menuAction = new SignalInt(0 - 1);
        this.menuSub = new SignalInt(0 - 1);
        this.menuBaseId = WidgetId.Block(256);
        this.TabChanged = new UiEvent();
        this.TabClosed = new UiEvent();
        this.TabAdded = new UiEvent();
    }

    void SetShowAdd(bool on) { showAdd = on; }

    /// 宿主驱动模式：控件不再拥有标签页集合。
    /// 关闭 / 添加 / 右键操作上报给宿主（宿主拥有
    /// 真实模型并每帧重新同步标签），而不是修改
    /// 内部列表或打开内置上下文菜单。
    void SetHostModel(bool on) { hostModel = on; }

    // ---- 设计器 / 序列化模型 --------------------------------------

    override string Kind() { return "Tabs"; }
    override Binding<string> SizeOf() { return Size; }

    override string StyleType() { return "tabs"; }

    override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        PropSpec st = PropSpec.Enum("style", "Style", new List<string>());
        st.Option("line"); st.Option("card"); st.Option("segment");
        st.num = style;
        st.WithTip("Tab header appearance.");
        ps.Add(st);
        PropSpec o = PropSpec.Enum("orient", "Orientation", new List<string>());
        o.Option("horizontal"); o.Option("vertical");
        o.num = orient;
        o.WithTip("Place the tab header across the top or along the side.");
        ps.Add(o);
        PropSpec add = PropSpec.Bool("showAdd", "Show add button");
        add.flag = showAdd;
        add.WithTip("Show a trailing button for adding a tab.");
        ps.Add(add);
        PropSpec ca = PropSpec.Bool("closable", "All closable");
        ca.flag = closableAll;
        ca.WithTip("Every tab shows a close X (Naive UI closable).");
        ps.Add(ca);
        PropSpec sz = PropSpec.Enum("size", "Size",
            new List<string>{ "small", "medium", "large" });
        sz.str = Size;
        ps.Add(sz);
        PropSpec act = PropSpec.Int("active", "Active tab");
        act.num = active;
        act.WithTip("Index of the selected tab.");
        ps.Add(act);
        return ps;
    }

    /// 标签 i 的页容器，按需补齐（缺页的标签是空白页）。
    /// 页是透明的停靠容器，因此页里的控件既能停靠也能
    /// 绝对摆放，和窗口根一样。
    Panel Page(int i) {
        int want = i;
        if (want < 0) { want = 0; }
        while (pages.Count <= want) {
            Panel p = Panel.Root("page" + Convert.ToString(pages.Count));
            p.Pad(0);
            p.Dock(Dock.Fill());
            pages.Add(p);
            this.With(p);
        }
        return pages[want];
    }

    int PageCount() { return pages.Count; }

    /// 丢掉第 i 页（标签被关掉时）。页以下标对应标签，因此删标签
    /// 必须同步删页，否则剩下的标签全部错位到前一页的内容上。
    /// 页也从控件树上摘下，它里的控件因此不再测量/绘制/接事件，
    /// 持有它们的宿主也能据此（HostForm() == null）回收资源。
    void DropPage(int i) {
        if (i < 0 || i >= pages.Count) { return; }
        List<Panel> keep = new List<Panel>();
        for (int k = 0; k < pages.Count; k = k + 1) {
            if (k == i) { this.Remove(pages[k]); }
            else { keep.Add(pages[k]); }
        }
        pages = keep;
    }

    /// 设计里放在某个标签下的控件（.zform 的 `childTab`）真正的
    /// 父节点就是那一页。
    override Control SlotHost(int slot) {
        return this.Page(slot);
    }

    /// 按序列化文本重建标签：每条一个标题，`|` 分隔，
    /// 前缀 `x` 表示该标签可关闭。设计器与 .zform 走这条路径。
    void SetItemsText(string spec) {
        itemsSpec = spec;
        tabs = new List<TabItem>();
        List<string> parts = spec.Split("|");
        for (int i = 0; i < parts.Count; i = i + 1) {
            string it = parts[i];
            if (it == "") { continue; }
            bool canClose = false;
            if (it.Substring(0, 1) == "x") {
                canClose = true;
                it = it.Substring(1, it.Length - 1);
            }
            tabs.Add(new TabItem(it, canClose));
        }
        if (active >= tabs.Count) { active = tabs.Count - 1; }
        if (active < 0 && tabs.Count > 0) { active = 0; }
        scroll = 0;
    }

    override string GetExtra(string key) {
        if (key == "options") { return itemsSpec; }
        return "";
    }

    override bool SetExtra(string key, string val) {
        if (key == "options") { this.SetItemsText(val); return true; }
        return false;
    }

    override List<string> Events() {
        List<string> e = Control.CommonEvents();
        e.Add("TabChanged");
        e.Add("TabClosed");
        e.Add("TabAdded");
        return e;
    }

    /// 将标签条的语义事件（TabChanged/TabClosed/TabAdded）
    /// 路由到对应的 UiEvent 字段，使 JSON/设计器的 `onTabChanged` 处理器
    /// 可与每帧的 TakeChanged()/TakeClosed()/TakeAdded() 轮询并存；
    /// 其余事件全部落入 `On` 的公共绑定。
    override void BindEvent(string evt, Action a) {
        if (evt == "TabChanged") { TabChanged.Add(a); return; }
        if (evt == "TabClosed") { TabClosed.Add(a); return; }
        if (evt == "TabAdded") { TabAdded.Add(a); return; }
        On.AddByName(evt, a);
    }

    // ---- 保留式钩子（Control） ---------------------------------------

    /// 首选尺寸：水平条取内容宽度（容器可能压缩它们，
    /// 此时出现溢出箭头）；垂直
    /// 轨道取固定列宽，每个标签占一行。
    override void OnMeasure(App app) {
        string origClass = Class;
        this.AddClass(this.SizeCls());
        hdrH = this.HeaderHeight(app);
        trackW = app.Scale(160);
        if (orient == 1) {
            prefW = trackW;
            prefH = hdrH * (tabs.Count + 1);
            Class = origClass;
            return;
        }
        prefH = hdrH;
        prefW = this.ContentWidth(app);
        Class = origClass;
    }

    /// 页面区是表头（或侧栏）之外的那块：活动页铺满它，
    /// 其余页隐藏（因此不测量、不绘制、不接事件）。没有
    /// 设计页时退化为基类的停靠布局。
    override void Arrange(int px, int py, int pw, int ph) {
        int w = pw;
        int h = ph;
        if (w < 0) { w = 0; }
        if (h < 0) { h = 0; }
        bx = px;
        by = py;
        bw = w;
        bh = h;
        if (pages.Count == 0) { return; }
        int cx = px;
        int cy = py;
        int cw = w;
        int ch = h;
        if (orient == 1) {
            int tw = trackW;
            if (tw > w) { tw = w; }
            cx = px + tw;
            cw = w - tw;
        } else {
            int th = hdrH;
            if (th > h) { th = h; }
            cy = py + th;
            ch = h - th;
        }
        for (int i = 0; i < pages.Count; i = i + 1) {
            Panel p = pages[i];
            p.SetShown(i == active);
            if (i == active) { p.Arrange(cx, cy, cw, ch); }
        }
    }

    /// 标签条停靠在控件树中时，会绘制到自己的
    /// 布局边界内；显式的 Render/RenderVertical 入口保留
    /// 给自行定位头部的宿主。
    override void OnPaint(App app) {
        // Size 字段映射为 Class 片段（small/medium/large），皮肤
        // 通过 tabs.small/.large 规则提供 tab 头高度/字号。
        string origClass = Class;
        this.AddClass(this.SizeCls());
        int headW = bw;
        // 有设计页时侧栏只占轨道宽，剩下的是页面区。
        if (orient == 1 && pages.Count > 0 && trackW > 0 && trackW < bw) {
            headW = trackW;
        }
        if (orient == 1) { this.RenderVertical(app, bx, by, headW, bh); }
        else { this.Render(app, bx, by, headW); }
        Class = origClass;
    }

    int TakeContext() {
        int r = ctxIndex;
        ctxIndex = 0 - 1;
        return r;
    }

    void Add(string label, bool canClose) {
        tabs.Add(new TabItem(label, canClose));
        // 空标签条没有选中项（active == -1）；补进来的第一个标签接管它，
        // 否则宿主问到的活动索引一直是 -1，谁也不会被显示。
        if (active < 0) { active = tabs.Count - 1; }
    }

    /// 丢掉所有标签页（选中项回到第一页）。声明式界面在语言切换后
    /// 重建标签文本时用它，免得宿主自己再持有一份影子列表。
    void Clear() {
        tabs = new List<TabItem>();
        active = 0 - 1;
        scroll = 0;
        changedIndex = 0 - 1;
        closedIndex = 0 - 1;
        addedIndex = 0 - 1;
        closedQueue = new List<int>();
    }

    int Count() { return tabs.Count; }

    int Active() { return active; }

    string ActiveLabel() {
        if (active < 0 || active >= tabs.Count) { return ""; }
        return tabs[active].label;
    }

    /// 改写某个标签的标题（浏览器拿网页标题回填标签时用它，
    /// 而不必把整条标签文本重新拼一遍）。
    void SetLabel(int i, string label) {
        if (i < 0 || i >= tabs.Count) { return; }
        tabs[i].label = label;
    }

    string LabelAt(int i) {
        if (i < 0 || i >= tabs.Count) { return ""; }
        return tabs[i].label;
    }

    void Select(int i) {
        if (i < 0 || i >= tabs.Count) { return; }
        if (i != active) {
            active = i;
            changedIndex = i;
            follow = true;
            TabChanged.Raise();
        }
    }

    int ClosedIndex() { return closedIndex; }

    int TakeChanged() {
        int r = changedIndex;
        changedIndex = 0 - 1;
        return r;
    }

    /// 领走一个已关闭的标签索引（没有则 -1）。一帧里关掉多个标签时
    /// 逐帧逐个领，顺序与移除顺序一致（从大到小）。
    int TakeClosed() {
        if (closedQueue.Count == 0) {
            closedIndex = 0 - 1;
            return 0 - 1;
        }
        int r = closedQueue[0];
        closedQueue.RemoveAt(0);
        if (closedQueue.Count > 0) { closedIndex = closedQueue[0]; }
        else { closedIndex = 0 - 1; }
        return r;
    }

    int TakeAdded() {
        int r = addedIndex;
        addedIndex = 0 - 1;
        return r;
    }

    void AddNew() {
        if (hostModel) {
            addedIndex = tabs.Count;
            TabAdded.Raise();
            return;
        }
        int n = tabs.Count + 1;
        tabs.Add(new TabItem("Tab " + Convert.ToString(n), true));
        active = tabs.Count - 1;
        addedIndex = active;
        changedIndex = active;
        follow = true;
        TabAdded.Raise();
    }

    /// 上报一个被移除的标签：入队给按帧轮询 TakeClosed() 的宿主，
    /// 同时抛事件给订阅 TabClosed 的宿主。
    void EmitClosed(int i) {
        closedQueue.Add(i);
        closedIndex = i;
        TabClosed.Raise();
    }

    /// 移除第 i 个标签之后把选中项挪回有效位置。
    void ReindexActive(int i) {
        if (active > i) { active = active - 1; }
        if (active >= tabs.Count) { active = tabs.Count - 1; }
        if (active < 0 && tabs.Count > 0) { active = 0; }
        // 空标签条没有活动标签：留下 0 会让每个按索引取标签的调用
        // 越界，因此这里是 -1。
        if (tabs.Count == 0) { active = 0 - 1; }
    }

    /// 第 i 个标签是否允许被关闭。固定标签（closable == false）既不画关闭
    /// 按钮，也不能被右键菜单或 CloseAt() 关掉：宿主把它当常驻页，
    /// 关掉它宿主的并行数组就和标签错位了。
    bool Closable(int i) {
        if (i < 0 || i >= tabs.Count) { return false; }
        return tabs[i].closable || closableAll;
    }

    /// 除第 keep 个之外还有几个可关闭的标签（keep < 0 表示不留）。
    int ClosableCount(int keep) {
        int n = 0;
        for (int i = 0; i < tabs.Count; i = i + 1) {
            if (i == keep) { continue; }
            if (tabs[i].closable) { n = n + 1; }
        }
        return n;
    }

    void CloseAt(int i) {
        if (i < 0 || i >= tabs.Count) { return; }
        if (!tabs[i].closable) { return; }
        if (hostModel) {
            follow = true;
            this.EmitClosed(i);
            return;
        }
        tabs.RemoveAt(i);
        this.DropPage(i);
        this.ReindexActive(i);
        follow = true;
        this.EmitClosed(i);
    }

    /// 关闭全部标签（「关闭全部」）。固定标签（closable == false）是宿主的
    /// 常驻页，批量关闭不能连它一起端走。
    void CloseAll() { this.CloseBulk(0 - 1); }

    /// 关闭除第 keep 个之外的标签（「关闭其他」）；keep 保留并成为选中项。
    void CloseOthers(int keep) {
        if (keep < 0 || keep >= tabs.Count) { return; }
        this.CloseBulk(keep);
    }

    /// 批量关闭：keep < 0 关掉全部可关闭的标签，否则额外保留第 keep 个。
    /// 先把要关的索引从大到小定下来再逐个关，这样上报出去的每个索引
    /// 在宿主处理到它之前都还指向自己那一项，宿主的并行数组不会错位。
    void CloseBulk(int keep) {
        List<int> doomed = new List<int>();
        for (int i = tabs.Count - 1; i >= 0; i = i - 1) {
            if (i == keep) { continue; }
            if (!tabs[i].closable) { continue; }
            doomed.Add(i);
        }
        if (doomed.Count == 0) { return; }
        int before = active;
        int removedBeforeKeep = 0;
        for (int k = 0; k < doomed.Count; k = k + 1) {
            int i = doomed[k];
            if (keep >= 0 && i < keep) { removedBeforeKeep = removedBeforeKeep + 1; }
            if (!hostModel) {
                tabs.RemoveAt(i);
                this.DropPage(i);
                this.ReindexActive(i);
            }
            this.EmitClosed(i);
        }
        follow = true;
        if (hostModel) { return; }
        // 「关闭其他」右键的那个标签留下来并接管选中；它前面被关掉的
        // 标签把它往前挪了几格。
        if (keep >= 0) {
            active = keep - removedBeforeKeep;
            // 比的是关之前的标签，不是索引：保留的标签换了人，只订阅
            // TabChanged 的宿主也得知道自己该显示哪一页了。
            if (before != keep) {
                changedIndex = active;
                TabChanged.Raise();
            }
            return;
        }
        if (active >= 0 && active != before) {
            changedIndex = active;
            TabChanged.Raise();
        }
    }

    /// 此变体标签页/标签条匹配的 CSS 类，皮肤可通过
    /// `tab.line`、`tab.card`、`tab.segment` 规则设置三种外观。
    string TabClasses() {
        string v = "line";
        if (style == 1) { v = "card"; }
        else if (style == 2) { v = "segment"; }
        return v;
    }

    /// 单个标签行的样式状态位。
    static int StateOf(bool hover, bool selected) {
        int st = Style.SNormal();
        if (hover) { st = st + Style.SHover(); }
        if (selected) { st = st + Style.SSelected(); }
        return st;
    }

    /// 水平条的表头高度（也是侧边轨道中的行高）。
    int HeaderHeight(App app) {
        return app.theme.heightMedium;
    }

    int TabWidth(App app, int i) {
        Theme t = app.theme;
        StyleBox tab = Style.Of(app, "tab", this.TabClasses(), Style.SNormal());
        int fs = tab.FontOr(Style.FontFallback(app, "medium"));
        // 单个标签的标题有最大宽度：超长的网页标题截断加省略号，
        // 而不是把整条标签栏撑成几屏宽。close 按钮的宽度要留在外侧，
        // 因此先按减掉 close 之后的可用宽度算文本。
        int closeW = 0;
        if (tabs[i].closable) { closeW = app.Scale(18) + app.Scale(6); }
        int labelW = app.Scale(180) - closeW;
        string label = Ellipsis.Fit(tabs[i].label, labelW, fs);
        int w = Canvas.MeasureText(label, fs) + t.paddingLarge * 2;
        if (tabs[i].closable) { w = w + closeW; }
        return w;
    }

    int ContentWidth(App app) {
        int total = 0;
        for (int i = 0; i < tabs.Count; i = i + 1) {
            total = total + this.TabWidth(app, i);
        }
        return total;
    }

    void Render(App app, int x, int y, int totalWidth) {
        if (orient == 1) {
            this.RenderVertical(app, x, y, totalWidth, this.HeaderHeight(app) * (tabs.Count + 1));
            return;
        }
        Canvas c = app.canvas;
        Theme t = app.theme;

        int tabH = t.heightMedium;
        int addW = tabH;

        int ek = app.EventKind();
        int eb = app.window.EventButton();
        // 标签按几何自己判定点击，所以要问过上层弹层/遮罩：
        // 否则画在标签条上的下拉一点就穿透过来切了标签。
        bool cap = app.PointerCaptured();
        bool leftUp = app.ClickAvailable() && eb == 0;
        bool rightUp = ek == 3 && eb == 1 && !cap;

        this.ApplyMenuAction();
        this.PumpClosed(app);

        // 标签数只能在菜单动作之后数：「关闭全部 / 关闭其他」就在
        // ApplyMenuAction 里移除标签，先数好的话本帧余下的绘制与命中
        // 判定都会按旧长度去索引已经不存在的标签。
        int count = tabs.Count;

        // 「+」添加按钮是固定的尾部控件（位于滚动
        // 视口之外）；需要时溢出箭头紧挨其左侧。
        int addReserve = 0;
        if (showAdd) { addReserve = addW; }
        int contentW = this.ContentWidth(app);
        bool overflow = contentW > (totalWidth - addReserve);

        int chevW = tabH;
        int viewW = totalWidth - addReserve;
        if (overflow) { viewW = viewW - chevW * 2; }
        if (viewW < 0) { viewW = 0; }

        // 尾部保留一点空隙，避免最后/活动的标签
        // 紧贴溢出箭头。
        int endPad = app.Scale(8);
        int maxScroll = contentW - viewW + endPad;
        if (!overflow) { maxScroll = 0; }
        if (maxScroll < 0) { maxScroll = 0; }

        bool overBar = !cap && app.mouseX >= x && app.mouseX < x + totalWidth
            && app.mouseY >= y && app.mouseY < y + tabH;

        bool ownsWheel = false;
        if (overflow && overBar) {
            ownsWheel = app.CaptureWheel(x, y, totalWidth, tabH);
        }
        if (ownsWheel && ek == 13) {
            int d = app.window.EventKeyCode();
            scroll = scroll - d * app.scrollSpeed / 120;
            follow = false;
            app.RequestRedraw();
        }
        // 活动标签在本帧发生变化（选择、添加、关闭）时自动滚动到可见；
        // 手动滚轮/箭头滚动会清除
        // 该标记，让用户可自由浏览标签条。
        if (follow && overflow) {
            int accum = 0;
            int aStart = 0;
            int aEnd = 0;
            for (int fi = 0; fi < count; fi = fi + 1) {
                int fw = this.TabWidth(app, fi);
                if (fi == active) { aStart = accum; aEnd = accum + fw; }
                accum = accum + fw;
            }
            if (scroll > aStart) { scroll = aStart; }
            if (scroll < aEnd - viewW + endPad) { scroll = aEnd - viewW + endPad; }
        }
        follow = false;
        if (scroll > maxScroll) { scroll = maxScroll; }
        if (scroll < 0) { scroll = 0; }

        string tcls = this.TabClasses();
        // 条底只有 Line 变体画通栏底线：Card/Segment 的活动标签
        // 本身是一片填充的纸页/胶囊，纸页下面再叠一条通栏灰线，
        // 等于给整条标签栏画了个框（用户视角就是"激活窗口还带着
        // 下划线"）。
        if (style == 0) {
            StyleBox strip = Style.Of(app, "tabs", tcls, Style.SNormal());
            strip.Paint(app, x, y, viewW, tabH);
        }

        // ---- 滚动标签条（裁剪视口） ----
        this.RenderTabStrip(app, x, y, viewW, tabH, count, tcls, leftUp, rightUp);

        this.RenderAddButton(app, x, y, totalWidth, addW, tabH, leftUp);

        if (overflow) {
            this.RenderOverflowChevrons(app, x, y, viewW, chevW, tabH, maxScroll, leftUp);
        }

        this.EmitMenu(app);
    }

    /// 队列里还有没被领走的关闭索引：每帧只轮询一次的宿主靠后续帧把
    /// 剩下的领完，而空闲时框框并不自己重绘，所以这里把帧要出来。
    void PumpClosed(App app) {
        if (closedQueue.Count > 0) { app.RequestRedraw(); }
    }

    /// 滚动标签条（裁剪）：每个标签一个样式框 + 标签/关闭字形，支持逐标签点击/右键菜单。
    void RenderTabStrip(App app, int x, int y, int viewW, int tabH, int count, string tcls, bool leftUp, bool rightUp) {
        bool cap = app.PointerCaptured();
        Canvas c = app.canvas;
        Theme t = app.theme;
        // 调用方数好的标签数只是上界：本帧里任何一次关闭都会让列表变短，
        // 而下面每一步都按索引取标签，因此收到实际长度。
        if (count > tabs.Count) { count = tabs.Count; }
        c.PushClip(x, y, viewW, tabH);

        int tabX = x - scroll;
        for (int i = 0; i < count; i = i + 1) {
            int tw = this.TabWidth(app, i);
            bool isActive = i == active;

            bool overTab = !cap && app.mouseX >= tabX && app.mouseX < tabX + tw
                && app.mouseX >= x && app.mouseX < x + viewW
                && app.mouseY >= y && app.mouseY < y + tabH;

            int closeW = app.Scale(18);
            int closeX = tabX + tw - closeW - app.Scale(6);
            bool overClose = tabs[i].closable && overTab
                && app.mouseX >= closeX && app.mouseX < closeX + closeW;

            // 每个条目一个解析后的 `tab` 框（`tab.card:selected`、
            // `tab:hover`、…）：皮肤负责填充、边框、圆角和
            // 标签颜色；这里只保留各变体的内缩。
            StyleBox ts = Style.Of(app, "tab", tcls,
                                   Tabs.StateOf(overTab, isActive));
            int inset = 0;
            if (style == 1) { inset = 2; }
            else if (style == 2) { inset = 3; }
            ts.Paint(app, tabX + inset, y + inset,
                     tw - inset * 2, tabH - inset * 2);

            // 皮肤没配标签色时的兜底：state::caption 按状态解析
            // （选中主色 / 悬停主文字 / 常态次级文字）。
            int tcFall = Style.Part(app, "state", "caption", "", "", "",
                isActive ? Style.SSelected()
                         : (overTab ? Style.SHover() : Style.SNormal())).FgOr(0);
            int tc = ts.FgOr(tcFall);
            int labelW = tw;
            if (tabs[i].closable) { labelW = tw - closeW - app.Scale(6); }
            // 绘制用的标题与 TabWidth 测量同源：超宽标题在这里
            // 截断成同宽的省略文本，标签不会把相邻标签挤出去。
            c.DrawTextCentered(tabX, y, labelW, tabH,
                               Ellipsis.Fit(tabs[i].label, labelW,
                                            ts.FontOr(Style.FontFallback(app, "medium"))),
                               tc, ts.FontOr(Style.FontFallback(app, "medium")));

            if (tabs[i].closable) {
                StyleBox close = Style.Part(app, "tab", "close", "", tcls, "",
                                            overClose ? Style.SHover() : Style.SNormal());
                if (overClose) {
                    c.FillRoundRect(closeX, y + (tabH - closeW) / 2, closeW, closeW,
                        close.RadiusOr(t.borderRadiusSmall), close.BgOr(0));
                }
                c.DrawGlyphIn("close", closeX, y, closeW, tabH,
                    t.iconSizeSmall, close.FgOr(0));
            }


            if (rightUp && overTab) {
                if (hostModel) {
                    ctxIndex = i;
                    app.RequestRedraw();
                } else {
                    menuOpen.Set(true);
                    menuTab = i;
                    menuX = app.mouseX;
                    menuY = app.mouseY;
                    menuSub.Set(0 - 1);
                    app.RequestRedraw();
                }
            } else if (!menuOpen.Get()) {
                if (leftUp && overClose) {
                    this.CloseAt(i);
                    app.RequestRedraw();
                    // 关掉一个标签后本帧的 count 与每个 i 都指向已经不存在的
                    // 条目：继续走下去就会读到列表末尾之外。剩下的标签由
                    // 上面请求的重绘按新列表画。
                    break;
                } else if (leftUp && overTab) {
                    this.Select(i);
                    app.RequestRedraw();
                }
            }

            tabX = tabX + tw;
        }

        c.PopClip();
    }

    /// 右边缘固定的尾部「+」添加按钮。
    void RenderAddButton(App app, int x, int y, int totalWidth, int addW, int tabH, bool leftUp) {
        bool cap = app.PointerCaptured();
        Canvas c = app.canvas;
        Theme t = app.theme;
        // 固定尾部「+」添加按钮（始终可见，右边缘）。
        if (showAdd) {
            int ax = x + totalWidth - addW;
            bool overAdd = !cap && app.mouseX >= ax && app.mouseX < ax + addW
                && app.mouseY >= y && app.mouseY < y + tabH;
            StyleBox add = Style.Part(app, "tabs", "add", "", Class, "",
                                      overAdd ? Style.SHover() : Style.SNormal());
            if (overAdd) {
                c.FillRoundRect(ax + 3, y + 3, addW - 6, tabH - 6,
                    add.RadiusOr(t.borderRadiusSmall), add.BgOr(0));
            }
            c.DrawGlyphIn("plus", ax, y, addW, tabH, t.iconSizeSmall, add.FgOr(0));
            if (leftUp && overAdd && !menuOpen.Get()) {
                this.AddNew();
                app.RequestRedraw();
            }
        }
    }

    /// 标签条宽于视口时显示的溢出箭头。
    void RenderOverflowChevrons(App app, int x, int y, int viewW, int chevW, int tabH, int maxScroll, bool leftUp) {
        bool cap = app.PointerCaptured();
        Canvas c = app.canvas;
        Theme t = app.theme;
            int lx = x + viewW;
            int rx = x + viewW + chevW;
            bool overL = !cap && app.mouseX >= lx && app.mouseX < lx + chevW
                && app.mouseY >= y && app.mouseY < y + tabH;
            bool overR = !cap && app.mouseX >= rx && app.mouseX < rx + chevW
                && app.mouseY >= y && app.mouseY < y + tabH;
            StyleBox chev = Style.Part(app, "tabs", "chevron", "", Class, "",
                                       Style.SNormal());
            StyleBox chevHover = Style.Part(app, "tabs", "chevron", "", Class, "",
                                            Style.SHover());
            if (overL) { c.FillRect(lx, y, chevW, tabH, chevHover.BgOr(0)); }
            if (overR) { c.FillRect(rx, y, chevW, tabH, chevHover.BgOr(0)); }
            c.DrawGlyphIn("chevron-left", lx, y, chevW, tabH,
                t.iconSizeSmall, (overL ? chevHover : chev).FgOr(0));
            c.DrawGlyphIn("chevron-right", rx, y, chevW, tabH,
                t.iconSizeSmall, (overR ? chevHover : chev).FgOr(0));
            if (leftUp && !menuOpen.Get()) {
                if (overL) {
                    scroll = scroll - app.Scale(80);
                    if (scroll < 0) { scroll = 0; }
                    app.RequestRedraw();
                } else if (overR) {
                    scroll = scroll + app.Scale(80);
                    if (scroll > maxScroll) { scroll = maxScroll; }
                    app.RequestRedraw();
                }
            }
    }

    /// 垂直轨道：一列全宽标签行，活动项在
    /// 左侧高亮。调用方把页面绘制在轨道右侧。
    void RenderVertical(App app, int x, int y, int w, int h) {
        Canvas c = app.canvas;
        Theme t = app.theme;

        int rowH = t.heightMedium;

        int ek = app.EventKind();
        int eb = app.window.EventButton();
        // 标签按几何自己判定点击，所以要问过上层弹层/遮罩：
        // 否则画在标签条上的下拉一点就穿透过来切了标签。
        bool cap = app.PointerCaptured();
        bool leftUp = app.ClickAvailable() && eb == 0;
        bool rightUp = ek == 3 && eb == 1 && !cap;

        // 侧边轨道也会右键开菜单，所以菜单的发起与消费同样要在这里
        // 走一遭；否则轨道上选的「关闭全部」永远不会被执行。
        this.ApplyMenuAction();
        this.PumpClosed(app);

        // 同上：菜单里的批量关闭已经改过列表长度了。
        int count = tabs.Count;

        string tcls = this.TabClasses();
        if (style == 0) {
            StyleBox divider = Style.Part(app, "tabs", "divider", "", Class, "",
                                          Style.SNormal());
            c.FillRect(x + w - 1, y, 1, h, divider.BgOr(0));
        }

        c.PushClip(x, y, w, h);

        int rowY = y;
        for (int i = 0; i < count; i = i + 1) {
            bool isActive = i == active;
            bool overRow = !cap && app.mouseX >= x && app.mouseX < x + w
                && app.mouseY >= rowY && app.mouseY < rowY + rowH;

            int closeW = app.Scale(18);
            int closeX = x + w - closeW - app.Scale(4);
            bool overClose = tabs[i].closable && overRow
                && app.mouseX >= closeX && app.mouseX < closeX + closeW;

            // 与水平条相同的 `tab` 框解析；轨道仅
            // 在活动标记改为左边缘这点上不同。
            string rowCls = tcls;
            if (style == 0) { rowCls = tcls + " rail"; }
            StyleBox rs = Style.Of(app, "tab", rowCls,
                                   Tabs.StateOf(overRow, isActive));
            int inset = 0;
            if (style == 1) { inset = 2; }
            else if (style == 2) { inset = 3; }
            if (style == 0) {
                // 轨道在左边缘标记活动行，因此去掉
                // Line 变体所带的下划线。
                rs.borderBottomW = 0 - 1;
            }
            rs.Paint(app, x + inset, rowY + inset,
                     w - inset * 2, rowH - inset * 2);
            if (style == 0 && isActive) {
                StyleBox indicator = Style.Part(app, "tab", "indicator", "", tcls,
                                                "", Style.SNormal());
                c.FillRect(x, rowY, app.Scale(3), rowH, indicator.BgOr(0));
            }

            int rowFs = rs.FontOr(Style.FontFallback(app, "medium"));
            // 皮肤没配行文字色时的兜底：state::caption 按状态解析
            // （选中主色 / 悬停主文字 / 常态次级文字）。
            int tcFall = Style.Part(app, "state", "caption", "", "", "",
                isActive ? Style.SSelected()
                         : (overRow ? Style.SHover() : Style.SNormal())).FgOr(0);
            int tc = rs.FgOr(tcFall);
            int ty = Canvas.CenterTextY(rowY, rowH, rowFs);
            // 轨道行同样截断：可关闭行的文字预算要给 close 按钮让位。
            int rowTextW = w - rs.PadLOr(t.paddingLarge) - rs.PadROr(t.paddingLarge);
            if (tabs[i].closable) { rowTextW = rowTextW - closeW - app.Scale(4); }
            c.DrawText(x + rs.PadLOr(t.paddingLarge), ty,
                       Ellipsis.Fit(tabs[i].label, rowTextW, rowFs), tc, rowFs);

            if (tabs[i].closable) {
                StyleBox close = Style.Part(app, "tab", "close", "", tcls, "",
                                            overClose ? Style.SHover() : Style.SNormal());
                if (overClose) {
                    c.FillRoundRect(closeX, rowY + (rowH - closeW) / 2, closeW, closeW,
                        close.RadiusOr(t.borderRadiusSmall), close.BgOr(0));
                }
                c.DrawGlyphIn("close", closeX, rowY, closeW, rowH,
                    t.iconSizeSmall, close.FgOr(0));
            }

            if (rightUp && overRow) {
                menuOpen.Set(true);
                menuTab = i;
                menuX = app.mouseX;
                menuY = app.mouseY;
                menuSub.Set(0 - 1);
                app.RequestRedraw();
            } else if (!menuOpen.Get()) {
                if (leftUp && overClose) {
                    this.CloseAt(i);
                    app.RequestRedraw();
                    break;
                } else if (leftUp && overRow) {
                    this.Select(i);
                    app.RequestRedraw();
                }
            }

            rowY = rowY + rowH;
        }

        if (showAdd) {
            bool overAdd = !cap && app.mouseX >= x && app.mouseX < x + w
                && app.mouseY >= rowY && app.mouseY < rowY + rowH;
            StyleBox add = Style.Part(app, "tabs", "add", "", Class, "",
                                      overAdd ? Style.SHover() : Style.SNormal());
            if (overAdd) {
                c.FillRoundRect(x + 3, rowY + 3, w - 6, rowH - 6,
                    add.RadiusOr(t.borderRadiusSmall), add.BgOr(0));
            }
            int addFont = add.FontOr(Style.FontFallback(app, "medium"));
            int ty = Canvas.CenterTextY(rowY, rowH, addFont);
            c.DrawGlyphIn("plus", x + app.Scale(4), rowY, app.Scale(20), rowH,
                t.iconSizeSmall, add.FgOr(0));
            c.DrawText(x + app.Scale(28), ty, "New tab", add.FgOr(0), addFont);
            if (leftUp && overAdd && !menuOpen.Get()) {
                this.AddNew();
                app.RequestRedraw();
            }
        }

        c.PopClip();
        this.EmitMenu(app);
    }

    /// 应用前一帧从上下文菜单中选择的动作。
    /// overlay 在延迟 overlay 阶段（Render 之后）将所选索引写入 menuAction，
    /// 因此在这里于下一帧消费。
    void ApplyMenuAction() {
        int picked = menuAction.Get();
        if (picked < 0) { return; }
        menuAction.Set(0 - 1);
        if (picked == 0) {
            this.CloseAt(menuTab);
        } else if (picked == 1) {
            this.CloseOthers(menuTab);
        } else if (picked == 2) {
            this.CloseAll();
        } else if (picked == 3) {
            this.AddNew();
        } else if (picked == 4) {
            if (menuTab >= 0 && menuTab < tabs.Count) {
                tabs.Add(new TabItem(tabs[menuTab].label, true));
                active = tabs.Count - 1;
                addedIndex = active;
                // 与 AddNew() 一致地告知宿主：没有这一下，它就无从得知
                // 多了一个标签，新标签永远是一个空页。
                TabAdded.Raise();
                changedIndex = active;
                TabChanged.Raise();
            }
        }
    }

    /// 将标签上下文菜单入队到框架 overlay 层，使其始终
    /// 绘制在后续内容之上，并在外部点击时关闭。菜单在
    /// 右键抬起时打开，使触发事件是抬起（kind 3），而不是
    /// overlay 视为外部点击关闭的按下（kind 2）。使用
    /// 共享的富菜单组件（图标、组标题、分隔线和
    /// 子菜单）。
    void EmitMenu(App app) {
        if (!menuOpen.Get()) { return; }
        // 菜单项跟着 closable 走：固定标签的「关闭」置灰，没有别的可关闭
        // 标签时「关闭其他/关闭全部」也置灰，免得点了没反应。
        string closeText = Tabs.TT("Close", "关闭");
        string othersText = Tabs.TT("Close others", "关闭其他");
        string allText = Tabs.TT("Close all", "关闭全部");
        MenuItem closeItem = this.Closable(menuTab)
            ? MenuItem.Shortcut(closeText, "close", "Ctrl+W", 0)
            : MenuItem.Disabled(closeText, "close", 0);
        MenuItem othersItem = this.ClosableCount(menuTab) > 0
            ? MenuItem.Item(othersText, "minus", 1)
            : MenuItem.Disabled(othersText, "minus", 1);
        MenuItem allItem = this.ClosableCount(0 - 1) > 0
            ? MenuItem.Item(allText, "trash", 2)
            : MenuItem.Disabled(allText, "trash", 2);
        List<MenuItem> items = new List<MenuItem>{
            MenuItem.Header(Tabs.TT("This tab", "当前标签")),
            closeItem, othersItem, allItem };
        items.Add(MenuItem.Separator());
        List<MenuItem> sub = new List<MenuItem>{
            MenuItem.Item(Tabs.TT("New tab", "新建标签"), "plus", 3),
            MenuItem.Item(Tabs.TT("Duplicate", "复制标签"), "copy", 4) };
        items.Add(MenuItem.Submenu(Tabs.TT("New", "新建"), "file", sub));
        app.AddOverlay(OverlayPopup.RichMenu(menuX, menuY, items,
            menuBaseId, menuAction, menuOpen, menuSub));
    }
}
