using System;
using Gui;

namespace Gui.Widget;

/// <summary>
/// High-level, self-contained tab component.
///
/// A retained component (create once, keep across frames) that owns its tab
/// list, active index, closable state and a right-click context menu. It draws
/// only the tab HEADER (the strip of labels); the caller renders the active
/// page into a separate body region, so the header and the page area are fully
/// decoupled and each can be placed independently:
///
///   // once:
///   Tabs tabs = Tabs.Create(Tabs.Card());   // or Tabs.CreateVertical(...)
///   tabs.SetShowAdd(true);                   // trailing "+" button
///   tabs.Add("Overview", false);             // (label, closable)
///   tabs.Add("Details", true);
///
///   // each frame — header:
///   tabs.Render(app, x, y, width);           // horizontal
///   // tabs.RenderVertical(app, x, y, w, h); // vertical rail
///   // ...then draw your own page for tabs.Active() in the body region.
///
///   int now   = tabs.Active();
///   int added = tabs.TakeAdded();    // index appended this frame, or -1
///   int shut  = tabs.TakeClosed();   // index removed this frame, or -1
///
/// Styles: Line (underline), Card (raised tab), Segment (pill group).
/// Orientation: Horizontal (top strip) or Vertical (side rail).
/// </summary>

/// One tab: its label and whether it shows a close button. One entity instead
/// of parallel label/closable lists.
class TabItem {
    string label;
    bool closable;

    TabItem(string label, bool closable) {
        this.label = label;
        this.closable = closable;
    }
}

class Tabs : Control {
    List<TabItem> tabs;
    int active;
    int style;
    int orient;
    bool showAdd;
    int scroll;
    bool follow;
    bool hostModel;
    int ctxIndex;

    int changedIndex;
    int closedIndex;
    int addedIndex;

    SignalBool menuOpen;
    int menuTab;
    int menuX;
    int menuY;
    SignalInt menuAction;
    SignalInt menuSub;
    int menuBaseId;

    UiEvent TabChanged;
    UiEvent TabClosed;
    UiEvent TabAdded;

    /// UI language for the built-in context-menu labels (0 = English,
    /// 1 = 简体中文). The host sets this before rendering so the menu follows
    /// the app language.
    static int lang;

    static string TT(string en, string zh) {
        if (Tabs.lang == 1) { return zh; }
        return en;
    }

    static int Line() { return 0; }
    static int Card() { return 1; }
    static int Segment() { return 2; }

    static int Horizontal() { return 0; }
    static int Vertical() { return 1; }

    static Tabs Create(int style) {
        return Tabs.Make(style, 0);
    }

    static Tabs CreateVertical(int style) {
        return Tabs.Make(style, 1);
    }

    static Tabs Make(int style, int orient) {
        Tabs b = new Tabs();
        b.InitControl("tabs", 0);
        b.tabs = new List<TabItem>();
        b.active = 0;
        b.style = style;
        b.orient = orient;
        b.showAdd = false;
        b.scroll = 0;
        b.follow = false;
        b.hostModel = false;
        b.ctxIndex = 0 - 1;
        b.changedIndex = 0 - 1;
        b.closedIndex = 0 - 1;
        b.addedIndex = 0 - 1;
        b.menuOpen = SignalBool.Create(false);
        b.menuTab = 0;
        b.menuX = 0;
        b.menuY = 0;
        b.menuAction = SignalInt.Create(0 - 1);
        b.menuSub = SignalInt.Create(0 - 1);
        b.menuBaseId = WidgetId.Block(256);
        b.TabChanged = UiEvent.Create();
        b.TabClosed = UiEvent.Create();
        b.TabAdded = UiEvent.Create();
        return b;
    }

    void SetShowAdd(bool on) { showAdd = on; }

    /// Host-driven mode: the widget no longer owns the tab collection.
    /// Close / add / right-click are reported to the host (which owns the
    /// real model and re-syncs the labels each frame) instead of mutating
    /// the internal list or opening the built-in context menu.
    void SetHostModel(bool on) { hostModel = on; }

    // ---- designer / serialization model --------------------------------------

    override string Kind() { return "Tabs"; }

    override string StyleType() { return "tabs"; }

    override List<string> Events() {
        List<string> e = Control.CommonEvents();
        e.Add("TabChanged");
        e.Add("TabClosed");
        e.Add("TabAdded");
        return e;
    }

    /// Routes the tab strip's semantic events (TabChanged/TabClosed/TabAdded)
    /// to their UiEvent fields, so a JSON/designer `onTabChanged` handler works
    /// alongside the per-frame TakeChanged()/TakeClosed()/TakeAdded() polling;
    /// everything else falls through to the common bundle on `On`.
    override void BindEvent(string evt, Action a) {
        if (evt == "TabChanged") { TabChanged.Add(a); return; }
        if (evt == "TabClosed") { TabClosed.Add(a); return; }
        if (evt == "TabAdded") { TabAdded.Add(a); return; }
        On.AddByName(evt, a);
    }

    // ---- retained-mode hooks (Control) ---------------------------------------

    /// Preferred size: horizontal bars take the content width (the container may
    /// compress them, which is when the overflow chevrons appear); a vertical
    /// rail takes a fixed column width and one row per tab.
    override void OnMeasure(App app) {
        if (orient == 1) {
            prefW = app.Scale(160);
            prefH = this.HeaderHeight(app) * (tabs.Count + 1);
            return;
        }
        prefH = this.HeaderHeight(app);
        prefW = this.ContentWidth(app);
    }

    /// When the strip is docked into a control tree it paints itself into its
    /// laid-out bounds; the explicit Render/RenderVertical entry points remain
    /// for hosts that position the header themselves.
    override void OnPaint(App app) {
        if (orient == 1) { this.RenderVertical(app, bx, by, bw, bh); }
        else { this.Render(app, bx, by, bw); }
    }

    int TakeContext() {
        int r = ctxIndex;
        ctxIndex = 0 - 1;
        return r;
    }

    void Add(string label, bool canClose) {
        tabs.Add(new TabItem(label, canClose));
    }

    int Count() { return tabs.Count; }

    int Active() { return active; }

    string ActiveLabel() {
        if (active < 0 || active >= tabs.Count) { return ""; }
        return tabs[active].label;
    }

    void Select(int i) {
        if (i < 0 || i >= tabs.Count) { return; }
        if (i != active) {
            active = i;
            changedIndex = i;
            follow = true;
            TabChanged.Raise();
        }
    }

    int ClosedIndex() { return closedIndex; }

    int TakeChanged() {
        int r = changedIndex;
        changedIndex = 0 - 1;
        return r;
    }

    int TakeClosed() {
        int r = closedIndex;
        closedIndex = 0 - 1;
        return r;
    }

    int TakeAdded() {
        int r = addedIndex;
        addedIndex = 0 - 1;
        return r;
    }

    void AddNew() {
        if (hostModel) {
            addedIndex = tabs.Count;
            TabAdded.Raise();
            return;
        }
        int n = tabs.Count + 1;
        tabs.Add(new TabItem("Tab " + Convert.ToString(n), true));
        active = tabs.Count - 1;
        addedIndex = active;
        changedIndex = active;
        follow = true;
        TabAdded.Raise();
    }

    void CloseAt(int i) {
        if (i < 0 || i >= tabs.Count) { return; }
        closedIndex = i;
        if (hostModel) {
            follow = true;
            TabClosed.Raise();
            return;
        }
        tabs.RemoveAt(i);
        if (active > i) { active = active - 1; }
        if (active >= tabs.Count) { active = tabs.Count - 1; }
        if (active < 0) { active = 0; }
        follow = true;
        TabClosed.Raise();
    }

    /// The CSS class a tab/strip of this variant matches, so a skin styles the
    /// three looks through `tab.line`, `tab.card`, `tab.segment` rules.
    string TabClasses() {
        string v = "line";
        if (style == 1) { v = "card"; }
        else if (style == 2) { v = "segment"; }
        return v;
    }

    /// Style state bits for one tab row.
    static int StateOf(bool hover, bool selected) {
        int st = Style.SNormal();
        if (hover) { st = st + Style.SHover(); }
        if (selected) { st = st + Style.SSelected(); }
        return st;
    }

    /// Header height for a horizontal bar (also the row height in a rail).
    int HeaderHeight(App app) {
        return app.theme.heightMedium;
    }

    int TabWidth(App app, int i) {
        Theme t = app.theme;
        int w = Canvas.MeasureText(tabs[i].label, t.fontSizeMedium) + t.paddingLarge * 2;
        if (tabs[i].closable) { w = w + app.Scale(18) + app.Scale(6); }
        return w;
    }

    int ContentWidth(App app) {
        int total = 0;
        int i = 0;
        while (i < tabs.Count) {
            total = total + this.TabWidth(app, i);
            i = i + 1;
        }
        return total;
    }

    void Render(App app, int x, int y, int totalWidth) {
        if (orient == 1) {
            this.RenderVertical(app, x, y, totalWidth, this.HeaderHeight(app) * (tabs.Count + 1));
            return;
        }
        Canvas c = app.canvas;
        Theme t = app.theme;

        int tabH = t.heightMedium;
        int count = tabs.Count;
        int addW = tabH;

        int ek = app.EventKind();
        int eb = app.window.EventButton();
        bool leftUp = ek == 3 && eb == 0;
        bool rightUp = ek == 3 && eb == 1;

        this.ApplyMenuAction();

        // The "+" add button is a fixed trailing control (outside the scrolled
        // viewport); overflow chevrons sit just left of it when needed.
        int addReserve = 0;
        if (showAdd) { addReserve = addW; }
        int contentW = this.ContentWidth(app);
        bool overflow = contentW > (totalWidth - addReserve);

        int chevW = tabH;
        int viewW = totalWidth - addReserve;
        if (overflow) { viewW = viewW - chevW * 2; }
        if (viewW < 0) { viewW = 0; }

        // Keep a small trailing gap so the last/active tab never butts flush
        // against the overflow chevrons.
        int endPad = app.Scale(8);
        int maxScroll = contentW - viewW + endPad;
        if (!overflow) { maxScroll = 0; }
        if (maxScroll < 0) { maxScroll = 0; }

        bool overBar = app.mouseX >= x && app.mouseX < x + totalWidth
            && app.mouseY >= y && app.mouseY < y + tabH;

        bool ownsWheel = false;
        if (overflow && overBar) {
            ownsWheel = app.CaptureWheel(x, y, totalWidth, tabH);
        }
        if (ownsWheel && ek == 13) {
            int d = app.window.EventKeyCode();
            scroll = scroll - d * app.scrollSpeed / 120;
            follow = false;
            app.RequestRedraw();
        }
        // Auto-scroll the active tab into view when it changed this frame
        // (selection, add, close). Manual wheel/chevron scrolling clears the
        // flag so the user can freely roam the strip.
        if (follow && overflow) {
            int accum = 0;
            int aStart = 0;
            int aEnd = 0;
            int fi = 0;
            while (fi < count) {
                int fw = this.TabWidth(app, fi);
                if (fi == active) { aStart = accum; aEnd = accum + fw; }
                accum = accum + fw;
                fi = fi + 1;
            }
            if (scroll > aStart) { scroll = aStart; }
            if (scroll < aEnd - viewW + endPad) { scroll = aEnd - viewW + endPad; }
        }
        follow = false;
        if (scroll > maxScroll) { scroll = maxScroll; }
        if (scroll < 0) { scroll = 0; }

        string tcls = this.TabClasses();
        StyleBox strip = Style.Of(app, "tabs", tcls, Style.SNormal());
        if (style == 2) { strip.Paint(app, x, y, totalWidth, tabH); }
        else { strip.Paint(app, x, y, viewW, tabH); }

        // ---- scrolled tab strip (clipped viewport) ----
        this.RenderTabStrip(app, x, y, viewW, tabH, count, tcls, leftUp, rightUp);

        this.RenderAddButton(app, x, y, totalWidth, addW, tabH, leftUp);

        if (overflow) {
            this.RenderOverflowChevrons(app, x, y, viewW, chevW, tabH, maxScroll, leftUp);
        }

        this.EmitMenu(app);
    }

    /// Scrolled tab strip (clipped): one styled box per tab + label/close glyph, per-tab click/context-menu.
    void RenderTabStrip(App app, int x, int y, int viewW, int tabH, int count, string tcls, bool leftUp, bool rightUp) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        c.PushClip(x, y, viewW, tabH);

        int tabX = x - scroll;
        int i = 0;
        while (i < count) {
            int tw = this.TabWidth(app, i);
            bool isActive = i == active;

            bool overTab = app.mouseX >= tabX && app.mouseX < tabX + tw
                && app.mouseX >= x && app.mouseX < x + viewW
                && app.mouseY >= y && app.mouseY < y + tabH;

            int closeW = app.Scale(18);
            int closeX = tabX + tw - closeW - app.Scale(6);
            bool overClose = tabs[i].closable && overTab
                && app.mouseX >= closeX && app.mouseX < closeX + closeW;

            // One resolved `tab` box per item (`tab.card:selected`,
            // `tab:hover`, ...): the skin owns the fill, border, radius and
            // label colour; only the per-variant inset stays here.
            StyleBox ts = Style.Of(app, "tab", tcls,
                                   Tabs.StateOf(overTab, isActive));
            int inset = 0;
            if (style == 1) { inset = 2; }
            else if (style == 2) { inset = 3; }
            ts.Paint(app, tabX + inset, y + inset,
                     tw - inset * 2, tabH - inset * 2);

            int tc = ts.FgOr(States.TextMuted(t, overTab, isActive, false));
            int labelW = tw;
            if (tabs[i].closable) { labelW = tw - closeW - app.Scale(6); }
            c.DrawTextCentered(tabX, y, labelW, tabH, tabs[i].label, tc,
                               ts.FontOr(t.fontSizeMedium));

            if (tabs[i].closable) {
                int icoColor = t.textTertiary;
                if (overClose) {
                    c.FillRoundRect(closeX, y + (tabH - closeW) / 2, closeW, closeW,
                        t.borderRadiusSmall, t.bgActive);
                    icoColor = t.error;
                }
                c.DrawGlyphIn("close", closeX, y, closeW, tabH,
                    t.iconSizeSmall, icoColor);
            }


            if (rightUp && overTab) {
                if (hostModel) {
                    ctxIndex = i;
                    app.RequestRedraw();
                } else {
                    menuOpen.Set(true);
                    menuTab = i;
                    menuX = app.mouseX;
                    menuY = app.mouseY;
                    menuSub.Set(0 - 1);
                    app.RequestRedraw();
                }
            } else if (!menuOpen.Get()) {
                if (leftUp && overClose) {
                    this.CloseAt(i);
                    app.RequestRedraw();
                } else if (leftUp && overTab) {
                    this.Select(i);
                    app.RequestRedraw();
                }
            }

            tabX = tabX + tw;
            i = i + 1;
        }

        c.PopClip();
    }

    /// Fixed trailing "+" add button on the right edge.
    void RenderAddButton(App app, int x, int y, int totalWidth, int addW, int tabH, bool leftUp) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        // Fixed trailing "+" add button (always visible, right edge).
        if (showAdd) {
            int ax = x + totalWidth - addW;
            bool overAdd = app.mouseX >= ax && app.mouseX < ax + addW
                && app.mouseY >= y && app.mouseY < y + tabH;
            int addColor = t.textSecondary;
            if (overAdd) {
                c.FillRoundRect(ax + 3, y + 3, addW - 6, tabH - 6,
                    t.borderRadiusSmall, t.bgHover);
                addColor = t.primary;
            }
            c.DrawGlyphIn("plus", ax, y, addW, tabH, t.iconSizeSmall, addColor);
            if (leftUp && overAdd && !menuOpen.Get()) {
                this.AddNew();
                app.RequestRedraw();
            }
        }
    }

    /// Overflow chevrons shown when the strip is wider than the viewport.
    void RenderOverflowChevrons(App app, int x, int y, int viewW, int chevW, int tabH, int maxScroll, bool leftUp) {
        Canvas c = app.canvas;
        Theme t = app.theme;
            int lx = x + viewW;
            int rx = x + viewW + chevW;
            bool overL = app.mouseX >= lx && app.mouseX < lx + chevW
                && app.mouseY >= y && app.mouseY < y + tabH;
            bool overR = app.mouseX >= rx && app.mouseX < rx + chevW
                && app.mouseY >= y && app.mouseY < y + tabH;
            if (overL) { c.FillRect(lx, y, chevW, tabH, t.bgHover); }
            if (overR) { c.FillRect(rx, y, chevW, tabH, t.bgHover); }
            c.DrawGlyphIn("chevron-left", lx, y, chevW, tabH,
                t.iconSizeSmall, t.textSecondary);
            c.DrawGlyphIn("chevron-right", rx, y, chevW, tabH,
                t.iconSizeSmall, t.textSecondary);
            if (leftUp && !menuOpen.Get()) {
                if (overL) {
                    scroll = scroll - app.Scale(80);
                    if (scroll < 0) { scroll = 0; }
                    app.RequestRedraw();
                } else if (overR) {
                    scroll = scroll + app.Scale(80);
                    if (scroll > maxScroll) { scroll = maxScroll; }
                    app.RequestRedraw();
                }
            }
    }

    /// Vertical rail: a column of full-width tab rows, active item highlighted
    /// on the left. The caller draws the page to the right of the rail.
    void RenderVertical(App app, int x, int y, int w, int h) {
        Canvas c = app.canvas;
        Theme t = app.theme;

        int rowH = t.heightMedium;
        int count = tabs.Count;

        int ek = app.EventKind();
        int eb = app.window.EventButton();
        bool leftUp = ek == 3 && eb == 0;
        bool rightUp = ek == 3 && eb == 1;

        string tcls = this.TabClasses();
        if (style == 0) {
            c.FillRect(x + w - 1, y, 1, h, t.divider);
        }

        c.PushClip(x, y, w, h);

        int rowY = y;
        int i = 0;
        while (i < count) {
            bool isActive = i == active;
            bool overRow = app.mouseX >= x && app.mouseX < x + w
                && app.mouseY >= rowY && app.mouseY < rowY + rowH;

            int closeW = app.Scale(18);
            int closeX = x + w - closeW - app.Scale(4);
            bool overClose = tabs[i].closable && overRow
                && app.mouseX >= closeX && app.mouseX < closeX + closeW;

            // Same resolved `tab` box as the horizontal strip; a rail only
            // differs in the active marker being a left edge.
            StyleBox rs = Style.Of(app, "tab", tcls,
                                   Tabs.StateOf(overRow, isActive));
            int inset = 0;
            if (style == 1) { inset = 2; }
            else if (style == 2) { inset = 3; }
            if (style == 0) {
                // A rail marks the active row on its left edge, so drop the
                // underline the line variant carries.
                rs.borderBottomW = 0 - 1;
                if (isActive) { rs.bg = rs.BgOr(t.bgActive); }
            }
            rs.Paint(app, x + inset, rowY + inset,
                     w - inset * 2, rowH - inset * 2);
            if (style == 0 && isActive) {
                c.FillRect(x, rowY, app.Scale(3), rowH, rs.AccentOr(t.primary));
            }

            int rowFs = rs.FontOr(t.fontSizeMedium);
            int tc = rs.FgOr(States.TextMuted(t, overRow, isActive, false));
            int ty = Canvas.CenterTextY(rowY, rowH, rowFs);
            c.DrawText(x + rs.PadLOr(t.paddingLarge), ty, tabs[i].label, tc, rowFs);

            if (tabs[i].closable) {
                int icoColor = t.textTertiary;
                if (overClose) {
                    c.FillRoundRect(closeX, rowY + (rowH - closeW) / 2, closeW, closeW,
                        t.borderRadiusSmall, t.bgActive);
                    icoColor = t.error;
                }
                c.DrawGlyphIn("close", closeX, rowY, closeW, rowH,
                    t.iconSizeSmall, icoColor);
            }

            if (rightUp && overRow) {
                menuOpen.Set(true);
                menuTab = i;
                menuX = app.mouseX;
                menuY = app.mouseY;
                menuSub.Set(0 - 1);
                app.RequestRedraw();
            } else if (!menuOpen.Get()) {
                if (leftUp && overClose) {
                    this.CloseAt(i);
                    app.RequestRedraw();
                } else if (leftUp && overRow) {
                    this.Select(i);
                    app.RequestRedraw();
                }
            }

            rowY = rowY + rowH;
            i = i + 1;
        }

        if (showAdd) {
            bool overAdd = app.mouseX >= x && app.mouseX < x + w
                && app.mouseY >= rowY && app.mouseY < rowY + rowH;
            int addColor = t.textSecondary;
            if (overAdd) {
                c.FillRoundRect(x + 3, rowY + 3, w - 6, rowH - 6, t.borderRadiusSmall, t.bgHover);
                addColor = t.primary;
            }
            int ty = Canvas.CenterTextY(rowY, rowH, t.fontSizeMedium);
            c.DrawGlyphIn("plus", x + app.Scale(4), rowY, app.Scale(20), rowH,
                t.iconSizeSmall, addColor);
            c.DrawText(x + app.Scale(28), ty, "New tab", addColor, t.fontSizeMedium);
            if (leftUp && overAdd && !menuOpen.Get()) {
                this.AddNew();
                app.RequestRedraw();
            }
        }

        c.PopClip();
    }

    /// Applies the action chosen from the context menu on a previous frame. The
    /// overlay writes the picked index into menuAction during the deferred
    /// overlay pass (after Render), so it is consumed here at the next frame.
    void ApplyMenuAction() {
        int picked = menuAction.Get();
        if (picked < 0) { return; }
        menuAction.Set(0 - 1);
        if (picked == 0) {
            this.CloseAt(menuTab);
        } else if (picked == 1) {
            string keep = "";
            bool keepClose = false;
            if (menuTab >= 0 && menuTab < tabs.Count) {
                keep = tabs[menuTab].label;
                keepClose = tabs[menuTab].closable;
            }
            tabs = new List<TabItem>();
            if (keep != "") {
                tabs.Add(new TabItem(keep, keepClose));
            }
            active = 0;
            closedIndex = menuTab;
        } else if (picked == 2) {
            tabs = new List<TabItem>();
            active = 0;
            closedIndex = 0;
        } else if (picked == 3) {
            this.AddNew();
        } else if (picked == 4) {
            if (menuTab >= 0 && menuTab < tabs.Count) {
                tabs.Add(new TabItem(tabs[menuTab].label, true));
                active = tabs.Count - 1;
                addedIndex = active;
            }
        }
    }

    /// Enqueues the tab context menu on the framework overlay layer so it always
    /// paints above later content and closes on an outside press. The menu opens
    /// on right-button-up so the opening event is a release (kind 3), never the
    /// press (kind 2) the overlay treats as an outside-click dismissal. Uses the
    /// shared rich menu component (icons, a group header, a separator and a
    /// submenu).
    void EmitMenu(App app) {
        if (!menuOpen.Get()) { return; }
        List<MenuItem> items = new List<MenuItem>{
            MenuItem.Header(Tabs.TT("This tab", "当前标签")),
            MenuItem.Shortcut(Tabs.TT("Close", "关闭"), "close",
                "Ctrl+W", 0),
            MenuItem.Item(Tabs.TT("Close others", "关闭其他"), "minus", 1),
            MenuItem.Item(Tabs.TT("Close all", "关闭全部"), "trash", 2) };
        items.Add(MenuItem.Separator());
        List<MenuItem> sub = new List<MenuItem>{
            MenuItem.Item(Tabs.TT("New tab", "新建标签"), "plus", 3),
            MenuItem.Item(Tabs.TT("Duplicate", "复制标签"), "copy", 4) };
        items.Add(MenuItem.Submenu(Tabs.TT("New", "新建"), "file", sub));
        app.AddOverlay(OverlayPopup.RichMenu(menuX, menuY, items,
            menuBaseId, menuAction, menuOpen, menuSub));
    }
}
