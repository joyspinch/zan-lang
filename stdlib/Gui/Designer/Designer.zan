    /// 渲染一个小按钮（高 28）并返回其 id。检查器各处使用，
    /// 让控件能放进紧凑的行内。
    int SmallBtn(App app, string text, int type, int x, int y, int w) {
        Button b = new Button { Text = text, Class = "small " + Style.TypeClass(type) };
        return b.Render(app, x, y, w);
    }

    /// 小号（高 28）纯图标按钮——尺寸与 SmallBtn 相同，但
    /// 标签是矢量 Icon 字形而非文本字符。
    int SmallIconBtn(App app, string iconName, int type, int x, int y, int w) {
        Button b = new Button { Icon = iconName,
                                Class = "circle small " + Style.TypeClass(type) };
        return b.Render(app, x, y, w);
    }

