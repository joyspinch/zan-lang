using System;
using Gui.Widget;
using Gui.Component;
using Gui.Backend;
using Gui;
using Gui.Component.Chart;
using Gui.Hmi;

namespace Gui.Designer;

/// 设计器部分：表单画布——行/容器渲染、拖放
/// 放置和实时控件预览。
partial class Designer {
    /// 设计窗口顶部的功能区（Office 风格标签页）：开始 /
    /// 排版 / 视图。命令按组排列，点击返回的是跨组的全局
    /// 序号，因此每加一项都要在 acts 里按同样的顺序补一条
    /// 动作码——两张表一一对应，避免序号错位。
    void RenderRibbon(App app, Canvas c, Theme t, int x, int y, int w) {
        List<string> tabs = new List<string>{
            Designer.T("Home", "开始"),
            Designer.T("Arrange", "排版"),
            Designer.T("View", "视图") };
        List<RibbonGroup> groups = new List<RibbonGroup>();
        List<string> acts = new List<string>();
        int tab = ribbonTab.Get();
        bool hasSel = sel != null;
        bool free = layoutMode == 1;

        if (tab == 0) {
            RibbonGroup gl = new RibbonGroup(Designer.T("Layout", "布局"));
            gl.Add(RibbonItem.Toggle("layout", Designer.T("Flow", "流式"), !free)
                .SetTip(Designer.T("24-column form layout", "24 列表单布局")));
            acts.Add("flow");
            gl.Add(RibbonItem.Toggle("grid", Designer.T("Free", "自由"), free)
                .SetTip(Designer.T("Absolute canvas layout", "绝对定位画布")));
            acts.Add("free");
            gl.Add(RibbonItem.Toggle("eye", Designer.T("Preview", "预览"), preview)
                .SetTip(Designer.T("Hide the editing chrome", "隐藏编辑外壳")));
            acts.Add("preview");
            groups.Add(gl);

            RibbonGroup gc = new RibbonGroup(Designer.T("Component", "组件"));
            RibbonItem del = RibbonItem.Large("trash", Designer.T("Delete", "删除"));
            if (!hasSel) { del.Disable(); }
            gc.Add(del);
            acts.Add("delete");
            RibbonItem up = RibbonItem.Small("chevron-up", Designer.T("Forward", "上移一层"));
            RibbonItem dn = RibbonItem.Small("chevron-down", Designer.T("Back", "下移一层"));
            if (!hasSel) { up.Disable(); dn.Disable(); }
            gc.Add(up);
            acts.Add("fwd");
            gc.Add(dn);
            acts.Add("back");
            groups.Add(gc);
        } else if (tab == 1) {
            RibbonGroup ga = new RibbonGroup(Designer.T("Align", "对齐"));
            List<string> icons = new List<string>{ "align-left", "align-center",
                "align-right", "arrow-up", "select-all", "arrow-down" };
            List<string> labels = new List<string>{
                Designer.T("Left", "左"), Designer.T("Centre", "横向居中"),
                Designer.T("Right", "右"), Designer.T("Top", "上"),
                Designer.T("Middle", "纵向居中"), Designer.T("Bottom", "下") };
            List<string> codes = new List<string>{ "al0", "al1", "al2",
                "al3", "al4", "al5" };
            for (int a = 0; a < icons.Count; a = a + 1) {
                RibbonItem it = RibbonItem.Small(icons[a], labels[a]);
                if (!hasSel || !free) { it.Disable(); }
                ga.Add(it);
                acts.Add(codes[a]);
            }
            groups.Add(ga);

            RibbonGroup gs = new RibbonGroup(Designer.T("Snap", "网格吸附"));
            gs.Add(RibbonItem.Toggle("grid", Designer.T("Show grid", "显示网格"), showGrid));
            acts.Add("grid");
            gs.Add(RibbonItem.Toggle("pin", Designer.T("Snap to grid", "对齐网格"), snapGrid));
            acts.Add("snap");
            RibbonItem sz = RibbonItem.Small("table", Designer.T("Grid size", "网格步长")
                + " " + Convert.ToString(gridSize));
            if (!free) { sz.Disable(); }
            gs.Add(sz);
            acts.Add("gridsize");
            groups.Add(gs);
        } else {
            RibbonGroup gz = new RibbonGroup(Designer.T("Zoom", "缩放"));
            RibbonItem zin = RibbonItem.Large("plus", Designer.T("Zoom in", "放大"));
            RibbonItem zout = RibbonItem.Large("minus", Designer.T("Zoom out", "缩小"));
            if (!free) { zin.Disable(); zout.Disable(); }
            gz.Add(zin);
            acts.Add("zin");
            gz.Add(zout);
            acts.Add("zout");
            List<string> zl = new List<string>{ Designer.T("Fit", "适应"),
                "50%", "100%", "150%", "200%" };
            List<int> zv = new List<int>{ 0, 500, 1000, 1500, 2000 };
            List<string> zc = new List<string>{ "z0", "z500", "z1000",
                "z1500", "z2000" };
            for (int z = 0; z < zl.Count; z = z + 1) {
                RibbonItem it = RibbonItem.Toggle("search", zl[z], winZoom == zv[z]);
                if (!free) { it.Disable(); }
                gz.Add(it);
                acts.Add(zc[z]);
            }
            groups.Add(gz);

            RibbonGroup gv = new RibbonGroup(Designer.T("Canvas", "画布"));
            RibbonItem rot = RibbonItem.Small("refresh",
                Designer.T("Rotate", "横竖切换"));
            if (!free) { rot.Disable(); }
            gv.Add(rot);
            acts.Add("rotate");
            gv.Add(RibbonItem.Small("code", Designer.T("JSON", "JSON")));
            acts.Add("json");
            RibbonItem size = RibbonItem.Small("layout",
                Convert.ToString(winW) + " x " + Convert.ToString(winH));
            size.Disable();
            gv.Add(size);
            acts.Add("nop");
            groups.Add(gv);
        }

        int hit = Ribbon.RenderTabbed(app, x, y, w, tabs, ribbonTab, groups);
        if (hit < 0 || hit >= acts.Count) { return; }
        string act = acts[hit];
        this.RunRibbon(app, act);
        app.RequestRedraw();
    }

    /// 执行功能区命令。动作码与 RenderRibbon 里登记的
    /// acts 一一对应。
    void RunRibbon(App app, string act) {
        if (act == "flow") {
            layoutMode = 0;
            msg = Designer.T("flow layout", "流式布局");
        } else if (act == "free") {
            layoutMode = 1;
            // 流式设计没有绝对坐标，切过去时给还没摆过的
            // 组件排一列，免得全部叠在原点。
            this.SeedFreeBounds();
            msg = Designer.T("free layout", "自由布局");
        } else if (act == "preview") {
            preview = !preview;
        } else if (act == "delete") {
            DeleteSel();
        } else if (act == "fwd") {
            MoveSel(0 - 1);
            msg = Designer.T("moved forward", "上移一层");
        } else if (act == "back") {
            MoveSel(1);
            msg = Designer.T("moved back", "下移一层");
        } else if (act == "grid") {
            showGrid = !showGrid;
        } else if (act == "snap") {
            snapGrid = !snapGrid;
        } else if (act == "gridsize") {
            // 在常用步长间轮换（4 → 8 → 16 → 4）。
            if (gridSize < 8) { gridSize = 8; }
            else if (gridSize < 16) { gridSize = 16; }
            else { gridSize = 4; }
            msg = Designer.T("grid ", "网格步长 ") + Convert.ToString(gridSize);
        } else if (act == "zin") {
            this.ZoomStep(1);
        } else if (act == "zout") {
            this.ZoomStep(0 - 1);
        } else if (act == "z0") { winZoom = 0; }
        else if (act == "z500") { winZoom = 500; }
        else if (act == "z1000") { winZoom = 1000; }
        else if (act == "z1500") { winZoom = 1500; }
        else if (act == "z2000") { winZoom = 2000; }
        else if (act == "rotate") {
            // 每种设计尺寸各存一套矩形，所以走 ApplyDesignSize
            // 而不是直接交换 winW/winH。
            ApplyDesignSize(winH, winW);
            msg = Designer.T("rotated", "已横竖切换");
        } else if (act == "json") {
            jsonOpen = true;
            jsonArea.SetText(SaveJson());
        }
    }

    /// 按预设档位放大/缩小一级（Fit 从 100% 起步）。
    void ZoomStep(int dir) {
        int z = winZoom;
        if (z <= 0) { z = 1000; }
        z = z + dir * 250;
        if (z < 250) { z = 250; }
        if (z > 4000) { z = 4000; }
        winZoom = z;
    }

    /// 把选中组件对齐到它所在的框（顶层为设计窗口，容器子元素
    /// 为容器的内容框）：0-2 左/水平居中/右，3-5 上/垂直居中/下。
    void AlignSel(int mode) {
        if (sel == null) { return; }
        int bw = winW;
        int bh = winH;
        FormField pc = ParentContainerOf(sel);
        if (pc != null) { bw = pc.fw; bh = pc.fh; }
        if (mode == 0) { sel.fx = 0; }
        else if (mode == 1) { sel.fx = (bw - sel.fw) / 2; }
        else if (mode == 2) { sel.fx = bw - sel.fw; }
        else if (mode == 3) { sel.fy = 0; }
        else if (mode == 4) { sel.fy = (bh - sel.fh) / 2; }
        else if (mode == 5) { sel.fy = bh - sel.fh; }
        if (sel.fx < 0) { sel.fx = 0; }
        if (sel.fy < 0) { sel.fy = 0; }
    }

    /// 给还没有绝对坐标的组件排一列（从流式切到自由时用）。
    /// 只动那些还停在原点的，已经摆过的保持不动。
    void SeedFreeBounds() {
        int cy2 = 16;
        for (int i = 0; i < fields.Count; i = i + 1) {
            FormField f = fields[i];
            if (f.fw <= 0) { f.fw = 200; }
            if (f.fh <= 0) { f.fh = 32; }
            if (f.fx == 0 && f.fy == 0) {
                f.fx = 16;
                f.fy = cy2;
            }
            cy2 = f.fy + f.fh + 12;
        }
    }

    void RenderForm(App app, Canvas c, Theme t, int cx, int cy, int cw, int ch) {
        int barH = Ribbon.HeightTabbed(app);
        RenderRibbon(app, c, t, cx, cy, cw);
        int bodyY = cy + barH;
        int bodyH = ch - barH;
        if (layoutMode == 1) {
            RenderFreeCanvas(app, c, t, cx, bodyY, cw, bodyH);
            return;
        }
        int fs = t.fontSizeSmall;
        c.FillRoundRect(cx, bodyY, cw, bodyH, app.Scale(6), t.bgPrimary);
        c.DrawRoundRect(cx, bodyY, cw, bodyH, app.Scale(6), t.borderPrimary, 1);
        c.PushClip(cx + 1, bodyY + 1, cw - 2, bodyH - 2);
        formClipTop = bodyY + 1;
        formClipBot = bodyY + bodyH - 1;

        // 表单可能超过面板大小，因此内部滚动。指针悬停其上时
        // 认领滚轮并钳制偏移（拖拽进行中跳过，
        // 以免放置与滚动互相干扰）。
        int contentH = FormContentH(app);
        int maxScroll = contentH - bodyH;
        if (maxScroll < 0) { maxScroll = 0; }
        if (!dragging && InRect(app.mouseX, app.mouseY, cx, bodyY, cw, bodyH)) {
            bool ownsWheel = app.CaptureWheel(cx, bodyY, cw, bodyH);
            if (ownsWheel) {
                int fdelta = app.window.EventKeyCode();
                formScroll = formScroll - fdelta * app.Scale(40) / 120;
                app.RequestRedraw();
            }
        }
        if (formScroll < 0) { formScroll = 0; }
        if (formScroll > maxScroll) { formScroll = maxScroll; }

        int pad = app.Scale(14);
        int fx = cx + pad;
        int fw = cw - pad * 2;
        if (maxScroll > 0) { fw = fw - app.Scale(8); }
        // 遵循设计的窗口宽度（LVGL 风格尺寸预览）：当
        // 设计尺寸窄于面板时，表单按该宽度
        // 居中渲染，使流式布局按目标分辨率校验，
        // 而不是按编辑器面板当前的大小。
        if (winW > 40 && app.Scale(winW) < fw) {
            fw = app.Scale(winW);
            fx = cx + (cw - fw) / 2;
        }
        int fy = bodyY + pad - formScroll;

        string head = formNameSig.Get();
        if (preview) { head = head + Designer.T("   (preview)", "  （预览）"); }
        if (FormVisible(fy, app.Scale(18))) {
            c.DrawText(fx, fy, head, t.textPrimary, t.fontSizeMedium);
        }
        fy = fy + app.Scale(24);
        if (FormVisible(fy, 1)) { c.FillRect(fx, fy, fw, 1, t.divider); }
        fy = fy + app.Scale(10);

        // 非可视组件从不参与画布布局：它们
        // 位于下方的托盘条中（见 RenderTray）。只布局
        // 可视字段；visIdx 把布局位置映射回 `fields` 中的真实索引，
        // 保证拖放索引正确。
        List<int> visIdx = new List<int>();
        for (int vf = 0; vf < fields.Count; vf = vf + 1) {
            if (!fields[vf].IsNonVisual()) { visIdx.Add(vf); }
        }
        int n = visIdx.Count;
        if (n == 0) {
            c.DrawText(fx, fy + app.Scale(6),
                Designer.T("Empty form — pick a component on the left, or drag one in.", "空表单 —— 在左侧选择一个组件，或拖入一个组件。"),
                t.textTertiary, fs);
        }
        bool active = dragging && InRect(dragMouseX, dragMouseY, cx, bodyY, cw, bodyH);
        bool dropSet = false;
        dropIndex = fields.Count;
        dropY = fy - app.Scale(4);
        int colGap = app.Scale(12);
        rowClicked = false;
        dropContainer = null;
        int i = 0;
        while (i < n) {
            // 把连续字段打包进同一可视行，直到其列宽（以 24 为基数）
            // 即将溢出为止，风格同 FormCreate。容器
            // 和显示组件通常占满全部 24 列。
            int rowStart = i;
            int cols = 0;
            int rowEnd = i;
            while (rowEnd < n) {
                int sp = ClampSpan(fields[visIdx[rowEnd]].span);
                if (rowEnd > rowStart && cols + sp > 24) { break; }
                cols = cols + sp;
                rowEnd = rowEnd + 1;
                if (cols >= 24) { break; }
            }
            // 行高取行内最高的字段（加上顶部标签空间）。
            int rowH = 0;
            int k = rowStart;
            while (k < rowEnd) {
                int hk = FieldHeight(app, fields[visIdx[k]]);
                if (labelPos == 2 && !fields[visIdx[k]].IsDisplay()) { hk = hk + app.Scale(18); }
                if (hk > rowH) { rowH = hk; }
                k = k + 1;
            }
            if (active && !dropSet && dragMouseY < fy + rowH / 2) {
                dropIndex = visIdx[rowStart];
                dropY = fy - app.Scale(4);
                dropSet = true;
            }
            // 剔除无法完整放入主体内的行：画布裁剪
            // 不包含子控件，跨界的行会溢出。
            bool vis = FormVisible(fy, rowH);
            int accSpan = 0;
            int rc = rowStart;
            while (rc < rowEnd) {
                int sp = ClampSpan(fields[visIdx[rc]].span);
                int x0 = fx + fw * accSpan / 24;
                accSpan = accSpan + sp;
                int x1 = fx + fw * accSpan / 24;
                int wf = x1 - x0;
                if (rc < rowEnd - 1) { wf = wf - colGap; }
                if (vis) { RenderRow(app, c, t, fields[visIdx[rc]], x0, fy, wf, rowH, visIdx[rc], true); }
                rc = rc + 1;
            }
            fy = fy + rowH + app.Scale(6);
            i = rowEnd;
        }
        if (active && !dropSet) { dropIndex = fields.Count; dropY = fy - app.Scale(4); }
        if (active && (dragFromPalette || dragMoved) && dropContainer == null) {
            c.FillRect(fx, dropY, fw, app.Scale(2), t.primary);
        }

        int dek = app.EventKind();
        if (dragging && dek == 3 && active) { DropField(); app.RequestRedraw(); }

        // 点击表单空白背景会清除选择/添加目标。
        if (!preview && dek == 2 && !rowClicked && !dragging
            && InRect(app.mouseX, app.mouseY, cx, cy, cw, ch)) {
            sel = null;
            activeContainer = null;
            app.RequestRedraw();
        }

        c.PopClip();

        if (maxScroll > 0) {
            Scrollbar.RenderVertical(app, cx + cw - app.Scale(7), cy + 1,
                ch - 2, contentH, formScroll);
        }
    }

    /// 把待处理的拖放落到表单上：面板拖拽在 dropIndex 插入新字段；
    /// 表单内拖拽把被拖的行移动到那里。
    void DropField() {
        if (dragFromPalette) {
            if (dragKind != 100 && dragKind != 200 && FormField.IsNonVisualOf(dragKind)) {
                // 非可视组件无论被拖放到哪里，
                // 都会进入托盘。
                AddField(dragKind);
            } else if (dropContainer != null) {
                // 放入指针下方的容器中（Tabs 则放入
                // 其活动标签）。
                activeContainer = dropContainer;
                if (dragKind == 200) { AddUserComponent(dragUserComp); }
                else if (dragKind == 100) { AddCustomField(dragCustomKind); }
                else { AddField(dragKind); }
            } else if (dragKind == 200) {
                activeContainer = null;
                AddUserComponent(dragUserComp);
            } else if (dragKind == 100) {
                FormField nf = FormField.NewCustom(dragCustomKind, seq);
                seq = seq + 1;
                InsertFieldAt(dropIndex, nf);
                sel = nf;
                inspTab = 0;
                msg = Designer.T("added ", "已添加 ") + dragCustomKind;
            } else {
                FormField nf = FormField.New(dragKind, seq);
                seq = seq + 1;
                InsertFieldAt(dropIndex, nf);
                sel = nf;
                inspTab = 0;
                if (nf.IsContainer()) { activeContainer = nf; }
                msg = Designer.T("added ", "已添加 ") + FormField.TypeName(dragKind);
            }
        } else if (dragIndex >= 0 && dragMoved) {
            FormField mv = fields[dragIndex];
            if (dropContainer != null && dropContainer != mv && !InSubtree(mv, dropContainer)) {
                // 把被拖的顶层行重新父化到指针下方的容器中
                // （Tabs 则为活动标签）。
                fields = ListRemove(fields, mv);
                mv.childTab = 0;
                if (dropContainer.ftype == 36 || dropContainer.ftype == 60) {
                    mv.childTab = dropContainer.uiState.Get();
                }
                dropContainer.kids.Add(mv);
                sel = mv;
                activeContainer = dropContainer;
                msg = Designer.T("moved into ", "已移入 ") + FormField.TypeName(dropContainer.ftype);
            } else {
                int at = dropIndex;
                if (at > dragIndex) { at = at - 1; }
                fields = ListMove(fields, dragIndex, at);
                sel = mv;
                msg = Designer.T("moved field", "已移动组件");
            }
        }
        dropContainer = null;
    }

    // ---- 自由画布模式（layoutMode == 1）----
    //
    // 设计的窗口（winW x winH）以信箱格式放进编辑器
    // 视口，每个字段绘制在其设计空间的绝对位置上，
    // 场景设计器风格：拖拽移动、角/边手柄调整大小、网格
    // 吸附、实时控件预览。容器子节点相对
    // 容器的内容框定位（与运行时的 DockManual + Place 一致）。

    /// 把设计窗口切换到新尺寸，每种尺寸保留独立的
    /// 自由画布布局（LVGL 风格断点布局）：
    /// 当前矩形存到离开时的 "WxH" 键下，
    /// 新尺寸若有存储的矩形则加载；首次设计的尺寸
    /// 从当前布局开始。
    void ApplyDesignSize(int newW, int newH) {
        if (newW == winW && newH == winH) { return; }
        if (newW < 40 || newH < 40) { return; }
        string oldKey = Convert.ToString(winW) + "x" + Convert.ToString(winH);
        string newKey = Convert.ToString(newW) + "x" + Convert.ToString(newH);
        StashRects(fields, oldKey);
        winW = newW;
        winH = newH;
        LoadRects(fields, newKey);
    }

    void StashRects(List<FormField> lst, string key) {
        for (int i = 0; i < lst.Count; i = i + 1) {
            lst[i].StashRect(key);
            if (lst[i].KidCount() > 0) { StashRects(lst[i].kids, key); }
        }
    }

    void LoadRects(List<FormField> lst, string key) {
        for (int i = 0; i < lst.Count; i = i + 1) {
            lst[i].LoadRect(key);
            if (lst[i].KidCount() > 0) { LoadRects(lst[i].kids, key); }
        }
    }

    /// 自由画布元素的设计空间 -> 屏幕空间转换（子节点已在 px/py 中
    /// 累积了父内容框的偏移）。
    void RenderFreeField(App app, Canvas c, Theme t, FormField f, int ox, int oy,
            int psMilli, int px, int py) {
        int fs = t.fontSizeSmall;
        int ex = ox + (px + f.fx) * psMilli / 1000;
        int ey = oy + (py + f.fy) * psMilli / 1000;
        int ew = f.fw * psMilli / 1000;
        int eh = f.fh * psMilli / 1000;
        if (ew < 2) { ew = 2; }
        if (eh < 2) { eh = 2; }
        bool selected = !preview && (f == sel);

        if (f.IsContainer()) {
            // 容器：装饰 + 标题，子节点放在内容框内。
            c.FillRoundRect(ex, ey, ew, eh, app.Scale(4), t.bgTertiary);
            c.DrawRoundRect(ex, ey, ew, eh, app.Scale(4), t.borderSecondary, 1);
            c.DrawText(ex + app.Scale(6), ey + app.Scale(4), f.label, t.textSecondary, fs);
            int kidPX = px + f.fx + 6;
            int kidPY = py + f.fy + 26;
            for (int k = 0; k < f.KidCount(); k = k + 1) {
                RenderFreeField(app, c, t, f.KidAt(k), ox, oy, psMilli, kidPX, kidPY);
            }
        } else {
            // 预览跟随画布缩放，文本和装饰随
            // 设计一起缩放，而不是保持 1:1。
            // PvS()/PvFont() 自带显示缩放，所以传入的是视图缩放本身。
            pvScale = psMilli * 100 / app.dpiScale;
            if (pvScale < 1) { pvScale = 1; }
            PreviewControl(app, c, t, f, ex, ey, ew, eh);
            pvScale = 1000;
        }

        // 选中轮廓 + 调整大小手柄。
        if (selected) {
            c.DrawRect(ex - 1, ey - 1, ew + 2, eh + 2, t.primary, 1);
            int hs = app.Scale(7);
            for (int hn = 0; hn < 8; hn = hn + 1) {
                int hx = FreeHandleX(hn, ex, ew) - hs / 2;
                int hy = FreeHandleY(hn, ey, eh) - hs / 2;
                c.FillRect(hx, hy, hs, hs, t.primary);
            }
        } else {
            c.DrawRect(ex, ey, ew, eh, t.borderSecondary, 1);
        }
        // 左上角的小型标识徽章。
        string tag = FormField.TypeName(f.ftype);
        if (f.fname.Length > 0) { tag = tag + " · " + f.fname; }
        int tgw = Canvas.MeasureText(tag, t.fontSizeTiny) + app.Scale(8);
        int tgh = Canvas.FontHeight(t.fontSizeTiny) + app.Scale(4);
        if (tgh + app.Scale(6) <= eh && tgw + app.Scale(6) <= ew) {
            c.FillRoundRect(ex + app.Scale(3), ey + app.Scale(3), tgw, tgh, app.Scale(3),
                t.shadowColor);
            c.DrawText(ex + app.Scale(7), ey + app.Scale(5), tag,
                t.textTertiary, t.fontSizeTiny);
        }
    }

    /// 设计空间 (mx, my) 处最上层的字段，从后往前搜索 `lst`，
    /// 后面的兄弟节点优先；子节点优先于其容器。父节点的
    /// 内容框原点存入 freeSelPX/freeSelPY，供拖拽使用。
    FormField FreePick(List<FormField> lst, int mx, int my, int px, int py) {
        int i = lst.Count - 1;
        while (i >= 0) {
            FormField f = lst[i];
            int ex = px + f.fx;
            int ey = py + f.fy;
            if (mx >= ex && mx < ex + f.fw && my >= ey && my < ey + f.fh) {
                if (f.IsContainer() && f.KidCount() > 0) {
                    FormField ch = FreePick(f.kids, mx, my, ex + 6, ey + 26);
                    if (ch != null) { return ch; }
                }
                freeSelPX = px;
                freeSelPY = py;
                return f;
            }
            i = i - 1;
        }
        return null;
    }

    static int FreeHandleX(int hn, int ex, int ew) {
        if (hn == 2 || hn == 3 || hn == 4) { return ex + ew; }
        if (hn == 0 || hn == 6 || hn == 7) { return ex; }
        return ex + ew / 2;
    }

    static int FreeHandleY(int hn, int ey, int eh) {
        if (hn == 0 || hn == 1 || hn == 2) { return ey; }
        if (hn == 4 || hn == 5 || hn == 6) { return ey + eh; }
        return ey + eh / 2;
    }

    /// 磁吸阈值：屏幕上约 6px 换算回设计像素，于是任何显示/视图缩放下手感一致
    /// （放大后要贴得更近才吸，缩小后更远就吸），而不是写死设计像素。
    int FreeSnapTol(App app, int psMilli) {
        int tol = app.Scale(6) * 1000 / psMilli;
        if (tol < 1) { tol = 1; }
        return tol;
    }

    /// 一根轴上的候选对齐线：画布的起点/中点/终点，加上除自己外每个可见字段的
    /// 起点/中点/终点。X 轴传 horiz=true，`span` 是该轴上画布的尺寸。静态是为了
    /// 无窗口回归能直接喂一组字段进来。
    static List<int> FreeSnapLines(bool horiz, List<FormField> sibs,
                                   FormField self, int span) {
        List<int> lines = new List<int>();
        lines.Add(0);
        lines.Add(span / 2);
        lines.Add(span);
        for (int i = 0; i < sibs.Count; i = i + 1) {
            FormField f = sibs[i];
            if (f == self || f.IsNonVisual()) { continue; }
            if (horiz) {
                lines.Add(f.fx);
                lines.Add(f.fx + f.fw / 2);
                lines.Add(f.fx + f.fw);
            } else {
                lines.Add(f.fy);
                lines.Add(f.fy + f.fh / 2);
                lines.Add(f.fy + f.fh);
            }
        }
        return lines;
    }

    /// 一根轴上的磁吸：把移动元素的起点/中点/终点三个锚点吸到最近的候选线，
    /// 取三者里最近的那一次命中，所以「贴边、居中、和另一个控件对齐」都能触发。
    ///
    /// 返回两个值：[0] = 校正后的起点（没命中就是原值），[1] = 命中的参考线坐标
    /// （-1 = 没命中，调用方据此决定画不画线）。纯几何、无 App，方便无窗口回归。
    static List<int> SnapAxis(int start, int size, List<int> lines, int tol) {
        List<int> r = new List<int>();
        int best = tol + 1;
        int adj = start;
        int guide = 0 - 1;
        for (int a = 0; a < 3; a = a + 1) {
            int off = 0;
            if (a == 1) { off = size / 2; }
            if (a == 2) { off = size; }
            int anchor = start + off;
            for (int li = 0; li < lines.Count; li = li + 1) {
                int d = anchor - lines[li];
                if (d < 0) { d = 0 - d; }
                if (d < best) {
                    best = d;
                    adj = lines[li] - off;
                    guide = lines[li];
                }
            }
        }
        r.Add(adj);
        r.Add(guide);
        return r;
    }

    /// 横向磁吸：命中则写 freeGuideX 参考线，返回校正后的左边。
    int FreeSnapX(App app, int newLeft, int w, int dw, FormField self,
                  int psMilli) {
        List<int> lines = Designer.FreeSnapLines(true, fields, self, dw);
        List<int> r = Designer.SnapAxis(newLeft, w, lines,
            this.FreeSnapTol(app, psMilli));
        this.freeGuideX = r[1];
        return r[0];
    }

    /// FreeSnapX 的纵向对应，写 freeGuideY。
    int FreeSnapY(App app, int newTop, int h, int dh, FormField self,
                  int psMilli) {
        List<int> lines = Designer.FreeSnapLines(false, fields, self, dh);
        List<int> r = Designer.SnapAxis(newTop, h, lines,
            this.FreeSnapTol(app, psMilli));
        this.freeGuideY = r[1];
        return r[0];
    }

    /// 自由画布设计区：信箱式窗口 + 网格 + 字段 +
    /// 场景设计器交互模型（选择/拖拽/调整大小/面板放置）。
    void RenderFreeCanvas(App app, Canvas c, Theme t, int cx, int cy, int cw, int ch) {
        int fs = t.fontSizeSmall;
        c.FillRoundRect(cx, cy, cw, ch, app.Scale(6), t.bgPrimary);
        c.DrawRoundRect(cx, cy, cw, ch, app.Scale(6), t.borderPrimary, 1);

        int dw = winW;
        int dh = winH;
        if (dw < 40) { dw = 40; }
        if (dh < 40) { dh = 40; }

        int inX = cx + app.Scale(12);
        int inY = cy + app.Scale(10);
        int inW = cw - app.Scale(24);
        int inH = ch - app.Scale(20);
        if (inW < 20) { inW = 20; }
        if (inH < 20) { inH = 20; }

        int psMilli;
        // 设计空间是逻辑像素：屏幕像素 = 设计像素 × 显示缩放
        // × 视图缩放，因此 100% 在任何显示比例下都是按目标
        // 设备 1:1，而 Fit 由面板的物理尺寸直接算出。
        if (winZoom > 0) { psMilli = winZoom * app.dpiScale / 100; }
        else {
            int fw2 = inW * 1000 / dw;
            int fh2 = inH * 1000 / dh;
            psMilli = fw2;
            if (fh2 < psMilli) { psMilli = fh2; }
            if (psMilli < 1) { psMilli = 1; }
        }
        int cw2 = dw * psMilli / 1000;
        int ch2 = dh * psMilli / 1000;
        // 平移：缩放后的设计大于面板时，视口
        // 可拖拽（按住空白画布）和滚轮滚动；平移
        // 偏移被钳制，设计永远不会完全滚出视野。
        int panMaxX = (cw2 - inW) / 2 + app.Scale(40);
        int panMaxY = (ch2 - inH) / 2 + app.Scale(40);
        if (cw2 <= inW) { freePanX = 0; }
        if (ch2 <= inH) { freePanY = 0; }
        if (freePanX > panMaxX) { freePanX = panMaxX; }
        if (freePanX < 0 - panMaxX) { freePanX = 0 - panMaxX; }
        if (freePanY > panMaxY) { freePanY = panMaxY; }
        if (freePanY < 0 - panMaxY) { freePanY = 0 - panMaxY; }
        int ox = inX + (inW - cw2) / 2 - freePanX;
        int oy = inY + (inH - ch2) / 2 - freePanY;

        // 从这里开始的一切都限制在编辑器面板内，
        // 缩放后的设计不会画到工具栏/相邻面板上。
        c.PushClip(inX, inY, inW, inH);

        // 画布背景 + 边框。
        c.FillRect(ox, oy, cw2, ch2, t.bgSecondary);
        c.DrawRect(ox, oy, cw2, ch2, t.borderPrimary, 1);

        // 网格覆盖层（跳过低缩放下会挤成一团的线）。
        if (showGrid && gridSize > 0) {
            int gstep = gridSize;
            while (gstep * psMilli / 1000 < app.Scale(6)) { gstep = gstep * 2; }
            int gx = 0;
            while (gx <= dw) {
                c.FillRect(ox + gx * psMilli / 1000, oy, 1, ch2, t.borderSecondary);
                gx = gx + gstep;
            }
            int gy = 0;
            while (gy <= dh) {
                c.FillRect(ox, oy + gy * psMilli / 1000, cw2, 1, t.borderSecondary);
                gy = gy + gstep;
            }
        }

        // Ctrl+滚轮以当前缩放级别为中心缩放画布（Fit 从
        // 实际适配比例起步，因此从 Fit 缩出时平滑）。
        if (InRect(app.mouseX, app.mouseY, inX, inY, inW, inH)
                && Modifiers.HasCtrl(app.window.EventMods())) {
            if (app.CaptureWheel(inX, inY, inW, inH)) {
                int wdelta = app.window.EventKeyCode();
                int z = psMilli;
                if (wdelta > 0) { z = z * 110 / 100; }
                else if (wdelta < 0) { z = z * 100 / 110; }
                if (z < 100) { z = 100; }
                if (z > 4000) { z = 4000; }
                winZoom = z;
                app.RequestRedraw();
            }
        } else if (InRect(app.mouseX, app.mouseY, inX, inY, inW, inH)) {
            // 普通滚轮垂直平移，Shift+滚轮水平平移。
            if (app.CaptureWheel(inX, inY, inW, inH)) {
                int wdelta = app.window.EventKeyCode();
                int step = app.Scale(48);
                if (Modifiers.HasShift(app.window.EventMods())) {
                    if (wdelta > 0) { freePanX = freePanX - step; }
                    else if (wdelta < 0) { freePanX = freePanX + step; }
                } else {
                    if (wdelta > 0) { freePanY = freePanY - step; }
                    else if (wdelta < 0) { freePanY = freePanY + step; }
                }
                app.RequestRedraw();
            }
        }

        int ek = app.EventKind();
        if (app.PointerCaptured()) { ek = 0; }

        // 渲染可视的顶层字段（非可视的在托盘中）。
        c.PushClip(ox, oy, cw2, ch2);
        for (int i = 0; i < fields.Count; i = i + 1) {
            if (!fields[i].IsNonVisual()) {
                RenderFreeField(app, c, t, fields[i], ox, oy, psMilli, 0, 0);
            }
        }
        c.PopClip();

        // 面板拖拽在画布上松开时，在光标处（居中）添加字段，
        // 并转换为设计空间坐标。
        if (dragging && dragFromPalette && ek == 3
                && InRect(app.mouseX, app.mouseY, ox, oy, cw2, ch2)) {
            int mDesX = (app.mouseX - ox) * 1000 / psMilli;
            int mDesY = (app.mouseY - oy) * 1000 / psMilli;
            DropFreePalette(mDesX, mDesY);
        }

        // 指针按下：选中的调整大小手柄优先，否则选择并
        // 开始拖拽；按在空白处清除选择。
        if (ek == 2 && app.window.EventButton() == 0
                && InRect(app.mouseX, app.mouseY, ox, oy, cw2, ch2)) {
            bool started = false;
            if (sel != null) {
                int sx = ox + (freeSelPX + sel.fx) * psMilli / 1000;
                int sy = oy + (freeSelPY + sel.fy) * psMilli / 1000;
                int sw2 = sel.fw * psMilli / 1000;
                int sh2 = sel.fh * psMilli / 1000;
                int hs = app.Scale(10);
                for (int hn = 0; hn < 8 && !started; hn = hn + 1) {
                    int hx = FreeHandleX(hn, sx, sw2);
                    int hy = FreeHandleY(hn, sy, sh2);
                    if (InRect(app.mouseX, app.mouseY,
                            hx - hs, hy - hs, hs * 2, hs * 2)) {
                        freeResizing = true;
                        freeResizeH = hn;
                        started = true;
                    }
                }
            }
            if (!started) {
                int mDesX = (app.mouseX - ox) * 1000 / psMilli;
                int mDesY = (app.mouseY - oy) * 1000 / psMilli;
                FormField hit = FreePick(fields, mDesX, mDesY, 0, 0);
                if (hit != null) {
                    sel = hit;
                    inspTab = 0;
                    freeDragging = true;
                    freeDragDx = mDesX - (freeSelPX + hit.fx);
                    freeDragDy = mDesY - (freeSelPY + hit.fy);
                } else {
                    sel = null;
                    activeContainer = null;
                    // 按在空白处开始视口平移拖拽（画布风格）。
                    freePanning = true;
                    freePanSX = app.mouseX;
                    freePanSY = app.mouseY;
                    freePanOX = freePanX;
                    freePanOY = freePanY;
                }
            }
            app.RequestRedraw();
        }

        // 在设计窗口之外按下面板也会平移。
        if (ek == 2 && app.window.EventButton() == 0 && !freePanning
                && !freeDragging && !freeResizing
                && InRect(app.mouseX, app.mouseY, inX, inY, inW, inH)) {
            freePanning = true;
            freePanSX = app.mouseX;
            freePanSY = app.mouseY;
            freePanOX = freePanX;
            freePanOY = freePanY;
        }

        // 平移拖拽：跟随指针移动视口。
        if (freePanning && ek == 1) {
            freePanX = freePanOX - (app.mouseX - freePanSX);
            freePanY = freePanOY - (app.mouseY - freePanSY);
            app.RequestRedraw();
        }

        // 拖拽：在设计空间移动选中对象。先走网格吸附打底，再做磁吸对齐——
        // 磁吸命中兄弟/画布的边或中线时会覆盖网格结果并画出参考线，让「贴边、
        // 居中、和另一个控件对齐」这些动作有可见的落点。按住 Alt 临时关闭磁吸，
        // 好在参考线附近做像素级微调。
        if (freeDragging && ek == 1 && sel != null) {
            int mDesX = (app.mouseX - ox) * 1000 / psMilli;
            int mDesY = (app.mouseY - oy) * 1000 / psMilli;
            int newLeft = mDesX - freeDragDx;
            int newTop = mDesY - freeDragDy;
            if (snapGrid && gridSize > 0) {
                newLeft = (newLeft + gridSize / 2) / gridSize * gridSize;
                newTop = (newTop + gridSize / 2) / gridSize * gridSize;
            }
            this.freeGuideX = 0 - 1;
            this.freeGuideY = 0 - 1;
            bool topLevel = freeSelPX == 0 && freeSelPY == 0;
            if (topLevel && !Modifiers.HasAlt(app.window.EventMods())) {
                newLeft = this.FreeSnapX(app, newLeft, sel.fw, dw, sel, psMilli);
                newTop = this.FreeSnapY(app, newTop, sel.fh, dh, sel, psMilli);
            }
            sel.fx = newLeft - freeSelPX;
            sel.fy = newTop - freeSelPY;
            app.RequestRedraw();
        }

        // 调整大小：拖拽 8 个手柄中的任意一个。
        if (freeResizing && ek == 1 && sel != null) {
            int mDesX = (app.mouseX - ox) * 1000 / psMilli;
            int mDesY = (app.mouseY - oy) * 1000 / psMilli;
            if (snapGrid && gridSize > 0) {
                mDesX = (mDesX + gridSize / 2) / gridSize * gridSize;
                mDesY = (mDesY + gridSize / 2) / gridSize * gridSize;
            }
            int oldL = freeSelPX + sel.fx;
            int oldT = freeSelPY + sel.fy;
            int oldR = oldL + sel.fw;
            int oldB = oldT + sel.fh;
            int newL = oldL;
            int newT = oldT;
            int newR = oldR;
            int newB = oldB;
            int hn = freeResizeH;
            // 0=左上 1=上 2=右上 3=右 4=右下 5=下 6=左下 7=左
            if (hn == 0 || hn == 6 || hn == 7) { newL = mDesX; }
            if (hn == 0 || hn == 1 || hn == 2) { newT = mDesY; }
            if (hn == 2 || hn == 3 || hn == 4) { newR = mDesX; }
            if (hn == 4 || hn == 5 || hn == 6) { newB = mDesY; }
            if (newR - newL < 8) {
                if (hn == 0 || hn == 6 || hn == 7) { newL = newR - 8; } else { newR = newL + 8; }
            }
            if (newB - newT < 8) {
                if (hn == 0 || hn == 1 || hn == 2) { newT = newB - 8; } else { newB = newT + 8; }
            }
            sel.fx = newL - freeSelPX;
            sel.fy = newT - freeSelPY;
            sel.fw = newR - newL;
            sel.fh = newB - newT;
            app.RequestRedraw();
        }

        // 任意位置松开指针即结束拖拽/调整大小/平移，并撤掉参考线。
        if (ek == 3) {
            freeDragging = false;
            freeResizing = false;
            freePanning = false;
            this.freeGuideX = 0 - 1;
            this.freeGuideY = 0 - 1;
            app.RequestRedraw();
        }

        // 磁吸参考线：贯穿画布的一条竖线 / 横线，画在命中的对齐坐标上。只在
        // 拖拽过程中出现，松手即消失。
        if (this.freeGuideX >= 0) {
            int gxp = ox + this.freeGuideX * psMilli / 1000;
            c.FillRect(gxp, oy, 1, ch2, t.primary);
        }
        if (this.freeGuideY >= 0) {
            int gyp = oy + this.freeGuideY * psMilli / 1000;
            c.FillRect(ox, gyp, cw2, 1, t.primary);
        }

        // 形状预览：叠加运行窗口将呈现的轮廓
        // （通过 winRound 实现的圆形表盘，或设计的 winShape），
        // 便于编译前对照真实形状检查 UI。自定义
        // 形状绘制所有并集区域。
        bool roundShape = winRound || winShape == 2;
        if (roundShape) {
            int rcx = ox + cw2 / 2;
            int rcy = oy + ch2 / 2;
            int rr2 = cw2;
            if (ch2 < rr2) { rr2 = ch2; }
            rr2 = rr2 / 2;
            c.DrawCircle(rcx, rcy, rr2, t.primary, 2);
        } else if (winShape == 1) {
            int r = winShapeRadius;
            if (r < 0) { r = 0; }
            c.DrawRoundRect(ox, oy, cw2, ch2, r, t.primary, 2);
        } else if (winShape == 3) {
            List<string> parts = winShapeSpec.Split(";");
            for (int pi = 0; pi < parts.Count; pi = pi + 1) {
                List<string> n = parts[pi].Split(",");
                if (n.Count >= 6) {
                    int st = Convert.ToInt32(n[0]);
                    int sx = ox + Convert.ToInt32(n[1]);
                    int sy = oy + Convert.ToInt32(n[2]);
                    int sw = Convert.ToInt32(n[3]);
                    int sh = Convert.ToInt32(n[4]);
                    int sr = Convert.ToInt32(n[5]);
                    if (st == 2) {
                        c.DrawCircle(sx + sw / 2, sy + sh / 2, sw / 2, t.primary, 2);
                    } else {
                        c.DrawRoundRect(sx, sy, sw, sh, sr, t.primary, 2);
                    }
                }
            }
        }

        c.PopClip();
    }

    /// 在设计空间 (dx, dy) 处把面板字段添加到自由画布，
    /// 新元素以光标为中心。
    void DropFreePalette(int dx, int dy) {
        int ftype = dragKind;
        if (ftype == 100) {
            FormField nf = FormField.NewCustom(dragCustomKind, seq);
            seq = seq + 1;
            nf.fx = dx - nf.fw / 2;
            nf.fy = dy - nf.fh / 2;
            fields.Add(nf);
            sel = nf;
            inspTab = 0;
            msg = Designer.T("added ", "已添加 ") + dragCustomKind;
            return;
        }
        if (ftype == 200) {
            AddUserComponent(dragUserComp);
            if (sel != null) {
                sel.fx = dx - sel.fw / 2;
                sel.fy = dy - sel.fh / 2;
            }
            return;
        }
        FormField f = FormField.New(ftype, seq);
        seq = seq + 1;
        if (FormField.IsNonVisualOf(ftype)) {
            fields.Add(f);
            sel = f;
            inspTab = 0;
            msg = Designer.T("added ", "已添加 ") + FormField.TypeName(ftype);
            return;
        }
        f.fw = DefaultFreeW(f);
        f.fh = DefaultFreeH(f);
        f.fx = dx - f.fw / 2;
        f.fy = dy - f.fh / 2;
        fields.Add(f);
        sel = f;
        inspTab = 0;
        if (f.IsContainer()) { activeContainer = f; }
        msg = Designer.T("added ", "已添加 ") + FormField.TypeName(ftype);
    }

    int DefaultFreeW(FormField f) {
        if (f.ftype == 36 || f.ftype == 23 || f.ftype == 24 || f.ftype == 25
            || f.ftype == 38 || f.ftype == 40 || f.ftype == 41 || f.ftype == 42
            || f.ftype == 43 || f.ftype == 45 || f.ftype == 46) { return 320; }
        if (f.ftype == 15) { return 480; }
        // 外壳类（工具条 / 状态栏 / 分栏 / 停靠面板）默认铺开，
        // 因为它们总是沿窗口边缘或充满内容区。
        if (FormField.IsShellOf(f.ftype)) { return 480; }
        return 200;
    }

    int DefaultFreeH(FormField f) {
        return f.RowUnits();
    }

    void RenderRow(App app, Canvas c, Theme t, FormField f, int rx, int ry, int rw, int rowH, int idx, bool topLevel) {
        int fs = t.fontSizeSmall;
        bool selected = !preview && (f == sel);
        if (topLevel && dragging && !dragFromPalette && dragIndex == idx && dragMoved) {
            c.FillRoundRect(rx - app.Scale(6), ry - app.Scale(3),
                rw + app.Scale(12), rowH + app.Scale(6), app.Scale(4), t.bgActive);
        }
        if (selected) {
            c.FillRoundRect(rx - app.Scale(6), ry - app.Scale(3),
                rw + app.Scale(12), rowH + app.Scale(6), app.Scale(4), t.bgHover);
            c.DrawRect(rx - app.Scale(6), ry - app.Scale(3),
                rw + app.Scale(12), rowH + app.Scale(6), t.primary, 2);
        }

        if (f.IsContainer()) {
            // 容器边框 + 嵌套子节点（子节点先处理自己的
            // 选择，因此内部点击优先选中子节点）。
            RenderContainer(app, c, t, f, rx, ry, rw, rowH);
            // 拖拽悬停在该容器上时，它成为放置目标
            // （嵌套容器优先：它们在父容器之后渲染）。
            if (dragging && InRect(dragMouseX, dragMouseY, rx, ry, rw, rowH)) {
                bool ok = true;
                if (!dragFromPalette) {
                    if (dragIndex < 0 || dragIndex >= fields.Count) { ok = false; }
                    else if (fields[dragIndex] == f || InSubtree(fields[dragIndex], f)) { ok = false; }
                }
                if (ok) {
                    dropContainer = f;
                    c.DrawRect(rx - app.Scale(4), ry - app.Scale(2),
                        rw + app.Scale(8), rowH + app.Scale(4), t.primary, 2);
                }
            }
        } else {
            int lw = app.Scale(labelWidth);
            int gap = app.Scale(10);
            int ctlX = rx;
            int ctlY = ry;
            int ctlW = rw;
            int labelY = ry + app.Scale(6);

            if (f.IsDisplay()) {
                ctlX = rx; ctlY = ry; ctlW = rw;
            } else if (labelPos == 2) {
                DrawLabel(app, c, t, f, rx, labelY, rw, 0);
                ctlY = ry + app.Scale(26); ctlX = rx; ctlW = rw;
            } else {
                int align = labelPos;
                DrawLabel(app, c, t, f, rx, labelY, lw, align);
                ctlX = rx + lw + gap;
                ctlW = rw - lw - gap;
            }
            PreviewControl(app, c, t, f, ctlX, ctlY, ctlW, rowH - (ctlY - ry));
        }

        int ek = app.EventKind();
        bool inRow = InRect(app.mouseX, app.mouseY,
            rx - app.Scale(6), ry - app.Scale(3), rw + app.Scale(12), rowH + app.Scale(6));
        // 嵌套子节点已处理了点击（rowClicked）——不要让
        // 外层容器抢走选择。
        if (!preview && ek == 2 && inRow && !dragging && !rowClicked) {
            sel = f;
            inspTab = 0;
            rowClicked = true;
            if (f.IsContainer()) { activeContainer = f; }
            else { activeContainer = ParentContainerOf(f); }
            if (topLevel) {
                dragging = true;
                dragFromPalette = false;
                dragMoved = false;
                dragIndex = idx;
                dragMouseX = app.mouseX;
                dragMouseY = app.mouseY;
            }
            app.RequestRedraw();
        }
    }

    // --- 容器几何与渲染 ----

    /// 容器主体上方装饰的高度：Card 标题栏，或
    /// Tabs 头部条。
    int ContainerHeaderH(App app, FormField f) {
        Theme t = app.theme;
        if (f.ftype == 18) { return Card.ContentY(0, t); }
        return t.heightMedium + app.Scale(8);
    }

    /// 活动标签（或卡片主体）可见子节点栈的高度，
    /// 设了最小值，空容器仍是可用的放置目标。
    int ContainerBodyH(App app, FormField f) {
        int gap = app.Scale(6);
        int pad = app.Scale(8);
        int total = 0;
        int shown = 0;
        int activeTab = f.uiState.Get();
        if (activeTab >= f.OptionCount() || activeTab < 0) { activeTab = 0; }
        for (int i = 0; i < f.KidCount(); i = i + 1) {
            FormField ch = f.KidAt(i);
            bool vis = true;
            if (f.ftype == 36 && ch.childTab != activeTab) { vis = false; }
            if (vis) {
                total = total + FieldHeight(app, ch) + gap;
                shown = shown + 1;
            }
        }
        if (shown == 0) { return app.Scale(40); }
        return total - gap + pad * 2;
    }

    int FieldHeight(App app, FormField f) {
        if (f.IsContainer()) {
            return ContainerHeaderH(app, f) + ContainerBodyH(app, f) + app.Scale(10);
        }
        return app.Scale(f.RowUnits());
    }

    void RenderContainer(App app, Canvas c, Theme t, FormField f, int rx, int ry, int rw, int rowH) {
        int headerH = ContainerHeaderH(app, f);
        if (f.ftype == 18) {
            new Card(f.label).RenderInside(app,
                new Rect(rx, ry, rw, rowH));
            int innerX = rx + t.paddingLarge;
            int innerW = rw - t.paddingLarge * 2;
            RenderKids(app, c, t, f, innerX, ry + headerH, innerW, 0);
        } else {
            List<string> labels = new List<string>();
            for (int oi = 0; oi < f.OptionCount(); oi = oi + 1) { labels.Add(f.OptionAt(oi)); }
            if (labels.Count == 0) { labels.Add("Tab 1"); }
            // 保持活动标签在范围内（标签选项可能被删除）。
            if (f.uiState.Get() >= labels.Count || f.uiState.Get() < 0) { f.uiState.Set(0); }
            Tabs strip = new Tabs(Tabs.Line(), 0);
            for (int li = 0; li < labels.Count; li = li + 1) { strip.Add(labels[li], false); }
            strip.Select(f.uiState.Get());
            strip.Render(app, rx, ry, rw);
            if (!preview) {
                int na = strip.Active();
                if (na != f.uiState.Get()) { f.uiState.Set(na); }
            }
            int innerX = rx + app.Scale(4);
            int innerW = rw - app.Scale(8);
            RenderKids(app, c, t, f, innerX, ry + headerH, innerW, f.uiState.Get());
        }
    }

    /// 垂直排布容器的可见子节点。`tabFilter` 把
    /// 子节点限制在单个 Tabs 面板内（对单主体 Card 忽略）。
    void RenderKids(App app, Canvas c, Theme t, FormField f, int x, int y, int w, int tabFilter) {
        int gap = app.Scale(6);
        int pad = app.Scale(8);
        int cyk = y + pad;
        int shown = 0;
        for (int i = 0; i < f.KidCount(); i = i + 1) {
            FormField ch = f.KidAt(i);
            bool vis = true;
            if (f.ftype == 36 && ch.childTab != tabFilter) { vis = false; }
            if (vis) {
                int kh = FieldHeight(app, ch);
                RenderRow(app, c, t, ch, x + app.Scale(4), cyk, w - app.Scale(8), kh, -1, false);
                cyk = cyk + kh + gap;
                shown = shown + 1;
            }
        }
        if (shown == 0) {
            c.DrawText(x + app.Scale(6), y + app.Scale(12),
                Designer.T("Empty — select this container, then add components", "空 —— 选中此容器，然后添加组件"),
                t.textTertiary, t.fontSizeSmall);
        }
    }

    void DrawLabel(App app, Canvas c, Theme t, FormField f, int lx, int ly, int lw, int align) {
        int fs = t.fontSizeSmall;
        string star = "";
        if (f.required && !hideStar) { star = "* "; }
        int starW = 0;
        if (star != "") { starW = Canvas.MeasureText("* ", fs); }
        int textW = Canvas.MeasureText(f.label, fs);
        int total = starW + textW;
        int tx = lx;
        if (align == 1) { tx = lx + lw - total; }
        if (star != "") {
            c.DrawText(tx, ly, "*", t.error, fs);
            tx = tx + starW;
        }
        c.DrawText(tx, ly, f.label, t.textSecondary, fs);
    }

    // ---- 感知缩放的预览度量 ----
    // 自由画布按画布缩放渲染控件预览（pvScale，
    // 千分比）；流式模式保持 1000，预览按 1:1 渲染。
    int PvS(App app, int v) { return app.Scale(v) * pvScale / 1000; }
    int PvFont(int fsz) {
        int f2 = fsz * pvScale / 1000;
        if (f2 < 7) { f2 = 7; }
        return f2;
    }

    /// 绘制字段输入控件的非交互预览。
    void PreviewControl(App app, Canvas c, Theme t, FormField f, int x, int y, int w, int avail) {
        int fs = PvFont(t.fontSizeSmall);
        int line = PvS(app, 28);
        if (w < PvS(app, 40)) { w = PvS(app, 40); }
        int ft = f.ftype;

        // 显示/布局/反馈/导航组件（ftype >= 15）。
        if (ft >= 15) {
            // 自 ui 状态设置后选项可能已被删除；保持
            // 索引在范围内，选项驱动的预览不会越界。
            if (f.UsesOptions() && f.uiState.Get() >= f.OptionCount()) { f.uiState.Set(0); }
            PreviewDisplay(app, c, t, f, x, y, w, avail, line);
            return;
        }

        if (ft == 1) {                       // 多行文本框
            int bh = avail - PvS(app, 6);
            if (bh < line) { bh = line; }
            Box(c, t, x, y, w, bh);
            c.DrawText(x + PvS(app, 8), y + PvS(app, 6), f.placeholder, t.textTertiary, fs);
            return;
        }
        if (ft == 12) {                      // 上传
            int bh = avail - PvS(app, 6);
            if (bh < line) { bh = line; }
            c.FillRoundRect(x, y, w, bh, t.borderRadiusMedium, t.bgSecondary);
            c.DrawRoundRect(x, y, w, bh, t.borderRadiusMedium, t.borderSecondary, 1);
            c.DrawTextCentered(x, y, w, bh, "+  " + f.placeholder, t.textTertiary, fs);
            return;
        }
        if (ft == 14) {                      // 富文本
            int bh = avail - PvS(app, 6);
            if (bh < line * 2) { bh = line * 2; }
            Box(c, t, x, y, w, bh);
            c.FillRect(x, y + PvS(app, 24), w, 1, t.divider);
            c.DrawText(x + PvS(app, 8), y + PvS(app, 5), "B  I  U  •", t.textTertiary, fs);
            c.DrawText(x + PvS(app, 8), y + PvS(app, 30), f.placeholder, t.textTertiary, fs);
            return;
        }

        if (ft == 4 || ft == 5) {            // 单选 / 复选
            PreviewChoice(app, c, t, f, x, y, w, line);
            return;
        }
        if (ft == 7) {                       // 开关
            int sw = PvS(app, 40);
            int sh = PvS(app, 20);
            int syy = y + (line - sh) / 2;
            int track = t.bgTertiary;
            int knobX = x + sh / 2;
            if (f.defOn) {
                track = t.primary;
                knobX = x + sw - sh / 2;
            }
            c.FillRoundRect(x, syy, sw, sh, sh / 2, track);
            c.FillCircle(knobX, syy + sh / 2, sh / 2 - PvS(app, 2), t.bgPrimary);
            return;
        }
        if (ft == 8) {                       // 评分
            int r = PvS(app, 6);
            int syy = y + line / 2;
            int sx = x + r;
            for (int k = 0; k < 5; k = k + 1) {
                int col = t.borderSecondary;
                if (k < 3) { col = t.warning; }
                c.FillCircle(sx, syy, r, col);
                sx = sx + r * 2 + PvS(app, 6);
            }
            return;
        }
        if (ft == 9) {                       // 滑块
            int syy = y + line / 2;
            c.FillRect(x, syy, w, PvS(app, 3), t.bgTertiary);
            c.FillRect(x, syy, w * 2 / 5, PvS(app, 3), t.primary);
            c.FillCircle(x + w * 2 / 5, syy + PvS(app, 1), PvS(app, 7), t.primary);
            return;
        }
        if (ft == 13) {                      // 颜色
            Box(c, t, x, y, w, line);
            c.FillRoundRect(x + PvS(app, 6), y + PvS(app, 6), PvS(app, 16), line - PvS(app, 12),
                t.borderRadiusSmall, t.primary);
            c.DrawText(x + PvS(app, 30), y + PvS(app, 6), "#3366FF", t.textSecondary, fs);
            return;
        }

        // 默认单行框（输入/密码/数字/下拉/日期/时间）。
        Box(c, t, x, y, w, line);
        string txt = f.placeholder;
        int txtCol = t.textTertiary;
        if (ft == 2) { txt = "••••••••"; }
        if (ft == 6 && f.OptionCount() > 0) { txt = f.OptionAt(0); txtCol = t.textSecondary; }
        c.DrawText(x + PvS(app, 8), y + PvS(app, 6), txt, txtCol, fs);
        if (ft == 6 || ft == 10 || ft == 11) {
            c.DrawGlyphIn("chevron-down", x + w - PvS(app, 20), y, PvS(app, 16), line,
                PvS(app, 11), t.textTertiary);
        }
        if (ft == 3) {
            c.DrawGlyphIn("chevron-up", x + w - PvS(app, 18), y,
                PvS(app, 14), line / 2, PvS(app, 9), t.textTertiary);
            c.DrawGlyphIn("chevron-down", x + w - PvS(app, 18), y + line / 2,
                PvS(app, 14), line / 2, PvS(app, 9), t.textTertiary);
        }
    }

    /// 为显示/布局/反馈/
    /// 导航组件（ftype >= 15）绘制非交互预览。每个分支绘制对应 stdlib 控件的
    /// 可辨识的缩略图。
    void PreviewDisplay(App app, Canvas c, Theme t, FormField f, int x, int y, int w, int avail, int line) {
        int fs = PvFont(t.fontSizeSmall);
        int ft = f.ftype;

        if (ft == 100) {                     // 项目自定义组件
            int bh = line + PvS(app, 8);
            c.FillRoundRect(x, y, w, bh, t.borderRadiusMedium, t.bgSecondary);
            c.DrawRoundRect(x, y, w, bh, t.borderRadiusMedium, t.primary, 1);
            string icon = CustomComponents.IconOf(f.customKind);
            if (icon == "") { icon = "puzzle"; }
            c.DrawGlyphIn(icon, x + PvS(app, 6), y, PvS(app, 20), bh,
                PvS(app, 13), t.primary);
            c.DrawText(x + PvS(app, 30), y + (bh - fs) / 2, f.customKind, t.textSecondary, fs);
            return;
        }
        if (ft == 15) {                      // 标题 / 题头
            Typography.Heading(app, x, y, f.label, 4);
            return;
        }
        if (ft == 16) {                      // 静态段落文本
            Typography.Paragraph(app, x, y, f.label);
            return;
        }
        if (ft == 17) {                      // 分隔线
            if (f.label == "") { app.canvas.FillRect(x, y + line / 2, w,
                                     Style.Of(app, "divider", "", Style.SNormal()).HeightOr(1),
                                     Style.Of(app, "divider", "", Style.SNormal()).BgOr(app.theme.divider)); }
            else {
                new Divider(f.label).RenderInside(app,
                    new Rect(x, y + PvS(app, 2), w, line));
            }
            return;
        }
        if (ft == 18) {                      // 卡片
            int bh = avail - PvS(app, 6);
            if (bh < PvS(app, 56)) { bh = PvS(app, 56); }
            c.FillRoundRect(x, y, w, bh, t.borderRadiusMedium, t.bgPrimary);
            c.DrawRoundRect(x, y, w, bh, t.borderRadiusMedium, t.borderPrimary, 1);
            c.DrawText(x + PvS(app, 10), y + PvS(app, 8), f.label, t.textPrimary, PvFont(t.fontSizeMedium));
            c.FillRect(x, y + PvS(app, 30), w, 1, t.divider);
            c.DrawText(x + PvS(app, 10), y + PvS(app, 38), Designer.T("Card body content", "卡片内容"), t.textTertiary, fs);
            return;
        }
        if (ft == 19) {                      // 标签
            Tag.Chip(app, x, y + PvS(app, 3), f.label, "primary");
            return;
        }
        if (ft == 20) {                      // 徽章
            c.DrawText(x, y + PvS(app, 6), f.label, t.textPrimary, fs);
            int bw = Canvas.MeasureText(f.label, fs);
            Badge.CountAt(app, x + bw + PvS(app, 10), y + PvS(app, 2), 5);
            return;
        }
        if (ft == 21) {                      // 头像
            new Avatar(f.label).RenderInside(app,
                new Rect(x, y + PvS(app, 2), PvS(app, 34),
                            PvS(app, 34)));
            return;
        }
        if (ft == 22) {                      // 统计
            new Statistic(f.label, "12,480").RenderAt(app, x, y);
            return;
        }
        if (ft == 23) {                      // 表格
            PreviewTable(app, c, t, f, x, y, w, avail);
            return;
        }
        if (ft == 24) {                      // 时间线
            List<TimelineItem> items = new List<TimelineItem>();
            for (int i = 0; i < f.OptionCount(); i = i + 1) {
                items.Add(new TimelineItem("", f.OptionAt(i), "", ""));
            }
            Timeline.Of(items).RenderAt(app, x, y + PvS(app, 2), w);
            return;
        }
        if (ft == 25) {                      // 树
            List<TreeNode> nodes = new List<TreeNode>();
            for (int i = 0; i < f.OptionCount(); i = i + 1) {
                if (i == 0) { nodes.Add(TreeNode.Dir(f.OptionAt(i), 0, true)); }
                else { nodes.Add(TreeNode.File(f.OptionAt(i), 1)); }
            }
            Rect area = new Rect(x, y + PvS(app, 2), w, avail - PvS(app, 6));
            TreeView tv = new TreeView();
            tv.BindSel(f.uiState).Bind(nodes);
            tv.RenderInside(app, area);
            return;
        }
        if (ft == 26) {                      // 折叠
            List<CollapsePanel> panels = new List<CollapsePanel>();
            for (int i = 0; i < f.OptionCount(); i = i + 1) {
                panels.Add(new CollapsePanel(f.OptionAt(i),
                    Designer.T("Panel content", "面板内容")));
            }
            Collapse col = Collapse.Of(panels, f.uiState);
            // 设计器画布在排布表单期间拥有点击所有权。
            col.Disabled = preview;
            col.RenderAt(app, x, y + PvS(app, 2), w);
            return;
        }
        if (ft == 27) {                      // 空状态
            int eh = avail - PvS(app, 6);
            if (eh < PvS(app, 56)) { eh = PvS(app, 56); }
            new Empty(f.label).RenderInside(app, new Rect(x, y, w, eh));
            return;
        }
        if (ft == 28) {                      // 告警横幅（Layer 通知卡片）
            Layer.DrawNotify(app, x, y, w, f.label, 2);
            return;
        }
        if (ft == 29) {                      // 进度
            new Progress(60, 1).RenderAt(app, x, y + PvS(app, 8), w);
            return;
        }
        if (ft == 30) {                      // 结果
            Result rs = new Result(f.label,
                Designer.T("Operation completed", "操作已完成"));
            rs.Class = Result.StatusClass(1);
            rs.RenderAt(app, x, y, w);
            return;
        }
        if (ft == 31) {                      // 骨架屏
            Skeleton.Line(app, w).RenderAt(app, x, y + PvS(app, 4));
            Skeleton.Line(app, w).RenderAt(app, x, y + PvS(app, 24));
            Skeleton.Line(app, w * 3 / 5).RenderAt(app, x, y + PvS(app, 44));
            return;
        }
        if (ft == 32) {                      // 旋转加载
            new Spin(20).RenderInside(app, new Rect(x + PvS(app, 2),
                y + PvS(app, 6), PvS(app, 20), PvS(app, 20)));
            c.DrawText(x + PvS(app, 30), y + PvS(app, 10), Designer.T("Loading...", "加载中..."), t.textTertiary, fs);
            return;
        }
        if (ft == 33) {                      // 提示触发器
            int bw = Canvas.MeasureText(f.label, fs) + PvS(app, 20);
            c.FillRoundRect(x, y + PvS(app, 2), bw, PvS(app, 24), t.borderRadiusMedium, t.bgSecondary);
            c.DrawRoundRect(x, y + PvS(app, 2), bw, PvS(app, 24), t.borderRadiusMedium, t.borderSecondary, 1);
            c.DrawText(x + PvS(app, 10), y + PvS(app, 7), f.label, t.textSecondary, fs);
            return;
        }
        if (ft == 34) {                      // 步骤条
            List<string> labels = new List<string>();
            for (int i = 0; i < f.OptionCount(); i = i + 1) { labels.Add(f.OptionAt(i)); }
            Steps.Of(labels, f.uiState).RenderAt(app, x, y + PvS(app, 2), w);
            return;
        }
        if (ft == 35) {                      // 面包屑
            List<string> items = new List<string>();
            for (int i = 0; i < f.OptionCount(); i = i + 1) { items.Add(f.OptionAt(i)); }
            Breadcrumb.Of(items).RenderAt(app, x, y + PvS(app, 4), w);
            return;
        }
        if (ft == 36) {                      // 标签页
            int nn = f.OptionCount(); if (nn < 1) { nn = 3; }
            int gx = x;
            for (int i = 0; i < nn; i = i + 1) {
                string it = "Tab"; if (i < f.OptionCount()) { it = f.OptionAt(i); }
                int tw = Canvas.MeasureText(it, fs) + PvS(app, 16);
                int col = t.textTertiary;
                if (i == 0) { col = t.primary; }
                c.DrawText(gx + PvS(app, 8), y + PvS(app, 4), it, col, fs);
                if (i == 0) { c.FillRect(gx, y + PvS(app, 24), tw, PvS(app, 2), t.primary); }
                gx = gx + tw;
            }
            c.FillRect(x, y + PvS(app, 25), w, 1, t.divider);
            c.DrawText(x + PvS(app, 4), y + PvS(app, 38), Designer.T("Tab panel content", "标签页内容"), t.textTertiary, fs);
            return;
        }
        if (ft == 37) {                      // 分页
            Pagination pg = Pagination.Of(10, f.uiState);
            // 设计器画布在排布表单期间拥有点击所有权。
            pg.Disabled = preview;
            pg.RenderAt(app, x, y + PvS(app, 2));
            return;
        }
        if (ft == 38) {                      // 菜单
            List<string> items = new List<string>();
            for (int i = 0; i < f.OptionCount(); i = i + 1) { items.Add(f.OptionAt(i)); }
            int mh = avail - PvS(app, 4);
            Menu.RenderVertical(app, x, y + PvS(app, 2), w, y + PvS(app, 2) + mh,
                t.heightMedium, items, f.uiState, 0);
            return;
        }
        if (ft == 39) {                      // 页头
            new PageHeader(f.label,
                Designer.T("Subtitle / description", "副标题 / 描述"))
                .RenderAt(app, x, y, w);
            return;
        }
        if (ft == 40) {                      // 列表视图
            List<string> items = new List<string>();
            for (int i = 0; i < f.OptionCount(); i = i + 1) { items.Add(f.OptionAt(i)); }
            ListView<string> lv = new ListView<string>(
                new ListColumn<string>("", s => s));
            lv.Class = "flat";
            lv.Bind(items);
            lv.RenderInside(app, new Rect(x, y + PvS(app, 2), w,
                items.Count * app.theme.heightLarge));
            return;
        }
        if (ft == 41) {                      // 数据表格
            PreviewTable(app, c, t, f, x, y, w, avail);
            return;
        }
        if (ft == 42) {                      // 轮播
            List<string> slides = new List<string>();
            for (int i = 0; i < f.OptionCount(); i = i + 1) { slides.Add(f.OptionAt(i)); }
            if (slides.Count == 0) { slides.Add("Slide 1"); }
            int chh = avail - PvS(app, 6);
            if (chh < PvS(app, 70)) { chh = PvS(app, 70); }
            Carousel car = Carousel.Of(slides, f.uiState);
            car.Disabled = preview;
            car.RenderInside(app, new Rect(x, y, w, chh));
            return;
        }
        if (ft == 43) {                      // 图表
            PreviewChart(app, c, t, f, x, y, w, avail);
            return;
        }
        if (ft == 44) {                      // 省略号
            Ellipsis.Render(app, x, y + PvS(app, 4), w, f.label);
            return;
        }
        if (ft == 45) {                      // 面板
            int ph = avail - PvS(app, 6);
            if (ph < PvS(app, 70)) { ph = PvS(app, 70); }
            Panel p = new Panel(f.label).Titled(f.label);
            p.RenderInside(app, new Rect(x, y, w, ph));
            Rect r = p.Inner();
            c.DrawText(r.x, r.y, Designer.T("Panel content", "面板内容"), t.textTertiary, fs);
            return;
        }
        if (ft == 46) {                      // 滚动条
            int sh = avail - PvS(app, 6);
            if (sh < PvS(app, 70)) { sh = PvS(app, 70); }
            c.DrawRect(x, y, w, sh, t.borderPrimary, 1);
            c.DrawText(x + PvS(app, 8), y + PvS(app, 8),
                Designer.T("Scrollable content", "可滚动内容"), t.textTertiary, fs);
            Scrollbar.RenderVertical(app, x + w - PvS(app, 10), y, sh,
                sh * 3, PvS(app, 20));
            return;
        }
        if (ft == 47) {                      // 加载中
            int r = PvS(app, 12);
            new Spin(24).RenderInside(app, new Rect(x + PvS(app, 4),
                y + PvS(app, 8), r * 2, r * 2));
            c.DrawText(x + r * 2 + PvS(app, 16), y + r,
                Designer.T("Loading...", "加载中..."), t.textTertiary, fs);
            return;
        }
        if (ft == 48) {                      // 下拉触发器
            DropdownChrome.PaintTrigger(app, app.focus.AllocId(),
                x, y + PvS(app, 2), PvS(app, 180), t.heightMedium,
                f.label, false);
            return;
        }
        if (ft == 49) {                      // 浮动按钮
            new FloatButton("plus") { Class = "primary" }
                .Render(app, x, y + PvS(app, 2));
            return;
        }
        if (ft == 50) {                      // 气泡卡片
            Popover.Render(app, x + PvS(app, 90), y,
                PvS(app, 180), PvS(app, 60), f.label, Designer.T("Popover body text", "气泡内容"));
            return;
        }
        if (ft == 51) {                      // 气泡确认
            Layer.DrawPopconfirm(app, x + PvS(app, 110), y, f.label, Designer.T("OK", "确定"), Designer.T("Cancel", "取消"));
            return;
        }
        if (ft == 52) {                      // 通知
            Layer.DrawNotify(app, x, y + PvS(app, 2), w, f.label, 3);
            return;
        }
        if (ft == 53) {                      // Ribbon 工具栏
            List<RibbonCmd> cmds = new List<RibbonCmd>{
                RibbonCmd.Group("save", Designer.T("Save", "保存")),
                new RibbonCmd("copy", Designer.T("Copy", "复制")),
                new RibbonCmd("paste", Designer.T("Paste", "粘贴")),
                new RibbonCmd("cut", Designer.T("Cut", "剪切")) };
            Ribbon.Render(app, x, y, w, Ribbon.Height(app), cmds);
            return;
        }
        if (ft == 54) {                      // 图标
            int sz = PvS(app, 24);
            c.DrawGlyphIn("star", x, y, sz, sz, t.iconSizeLarge, t.primary);
            c.DrawText(x + sz + PvS(app, 8), y + PvS(app, 4),
                f.label, t.textSecondary, fs);
            return;
        }
        if (ft == 58) {                      // 工具条
            ToolStrip ts = new ToolStrip();
            ts.SetItemsText(f.JoinOptions());
            ts.RenderAt(app, x, y, w, PvS(app, 34));
            return;
        }
        if (ft == 59) {                      // 状态栏
            StatusBar sb = new StatusBar();
            for (int i = 0; i < f.OptionCount(); i = i + 1) {
                string it = f.OptionAt(i);
                if (it.Length > 1 && it.Substring(0, 1) == ">") {
                    sb.AddRight(it.Substring(1, it.Length - 1));
                } else {
                    sb.AddLeft(it);
                }
            }
            sb.RenderAt(app, x, y, w, PvS(app, 24));
            return;
        }
        if (ft == 62) {                      // 指示灯
            Led led = new Led(f.label, f.uiState);
            PvCtrl(app, led, x, y, w, PvS(app, 26));
            return;
        }
        if (ft == 63) {                      // 数显表
            Digital dg = new Digital(f.label, f.uiState, 10,
                                     Designer.T("C", "℃"));
            PvCtrl(app, dg, x, y, PvS(app, 150), PvS(app, 72));
            return;
        }
        if (ft == 64) {                      // 圆盘仪表
            Gauge gg = new Gauge(f.label, f.uiState, 0, 100);
            gg.Limits(20, 80);
            PvCtrl(app, gg, x, y, PvS(app, 160), PvS(app, 160));
            return;
        }
        if (ft == 65) {                      // 棒图
            Bargraph bg = new Bargraph(f.label, f.uiState, 0, 100);
            bg.Limits(20, 80);
            PvCtrl(app, bg, x, y, PvS(app, 64), PvS(app, 180));
            return;
        }
        if (ft == 66) {                      // 趋势曲线
            Trend tr = new Trend(f.label, 0, 100, 1, 60);
            TrendPen pen = tr.Add(Designer.T("PV", "测量值"),
                                  new IoTag("PV"), t.success);
            // 设计期用一段确定的锯齿波占位，预览才有形状可看。
            for (int i = 0; i < 60; i = i + 1) {
                pen.Push(50 + (i % 20) * 2 - 20);
            }
            PvCtrl(app, tr, x, y, w, PvS(app, 200));
            return;
        }
        if (ft == 67) {                      // 报警横幅
            AlarmBuffer ab = new AlarmBuffer();
            ab.Raise(Designer.T("PT101", "PT101"), f.label, 2);
            AlarmBanner bn = new AlarmBanner(ab);
            PvCtrl(app, bn, x, y, w, PvS(app, 32));
            return;
        }
        if (ft == 68) {                      // 报警列表
            AlarmBuffer ab = new AlarmBuffer();
            ab.Raise("PT101", Designer.T("Pressure high", "压力高"), 2);
            ab.Raise("TIC101", Designer.T("Temp warning", "温度偏高"), 1);
            AlarmList al = new AlarmList(ab);
            PvCtrl(app, al, x, y, w, PvS(app, 200));
            return;
        }
        if (ft == 69) {                      // 数字键盘
            NumPad kp = new NumPad();
            kp.SetText("0");
            PvCtrl(app, kp, x, y, PvS(app, 200), PvS(app, 260));
            return;
        }
        if (ft == 70) {                      // 设备状态卡
            DeviceCard dc = new DeviceCard(f.label);
            dc.Set(f.uiState.Get());
            IoTag demo = new IoTag(Designer.T("Current", "电流"), "A", 10);
            demo.SetRaw(1234);
            dc.Row(Designer.T("Current", "电流"), demo);
            PvCtrl(app, dc, x, y, PvS(app, 240), PvS(app, 140));
            return;
        }
        if (ft == 71) {                      // 设备状态面板
            EquipPanel ep = new EquipPanel();
            if (f.options.Count > 0) {
                for (int i = 0; i < f.options.Count; i = i + 1) {
                    ep.AddDevice(f.options[i]);
                }
            } else {
                ep.AddDevice(Designer.T("Pump 1", "1# 泵")).Set(1);
                ep.AddDevice(Designer.T("Pump 2", "2# 泵")).Set(2);
                ep.AddDevice(Designer.T("Fan", "风机")).Set(0);
            }
            PvCtrl(app, ep, x, y, w, PvS(app, 300));
            return;
        }
    }

    /// 在设计画布上按给定矩形绘制一个保留式控件的实时预览。
    void PvCtrl(App app, Control ctl, int x, int y, int w, int h) {
        ctl.MeasureTree(app);
        ctl.Arrange(x, y, w, h);
        ctl.RenderTree(app);
    }

    /// 图表类型的人类可读名称（Chart 字段把类型存在 uiState 中）。
    static string ChartKindName(int k) {
        if (k == 1) { return "Line"; }
        if (k == 2) { return "Area"; }
        if (k == 3) { return "Stacked"; }
        if (k == 4) { return "H-Bar"; }
        if (k == 5) { return "Pie"; }
        if (k == 6) { return "Donut"; }
        if (k == 7) { return "Scatter"; }
        return "Bar";
    }

    /// Chart 组件的预览。图表类型保存在字段的
    /// uiState 中（0 柱状图 .. 7 散点图），因此一个面板条目即可组合出
    /// stdlib Chart 控件提供的所有图表类型。
    void PreviewChart(App app, Canvas c, Theme t, FormField f, int x, int y, int w, int avail) {
        int kind = f.uiState.Get();
        int hh = avail - PvS(app, 6);
        if (hh < PvS(app, 120)) { hh = PvS(app, 120); }

        List<string> labels = new List<string>{
            "Mon", "Tue", "Wed",
            "Thu", "Fri" };
        List<int> a = new List<int>{
            24, 52, 38, 66, 45 };
        List<int> b = new List<int>{
            30, 20, 50, 40, 60 };

        if (kind == 5 || kind == 6) {
            ChartOption opt = ChartOption.With(ChartType.Pie, f.label, labels);
            opt.Add("Series A", a);
            if (kind == 6) { opt.series[0].innerPct = 55; }
            ChartView.Of(opt).Render(app, x, y, w, hh);
            return;
        }
        if (kind == 7) {
            List<ChartPoint> points = new List<ChartPoint>{
                ChartPoint.Of(12, 24), ChartPoint.Of(28, 52), ChartPoint.Of(40, 38),
                ChartPoint.Of(55, 66), ChartPoint.Of(70, 45)
            };
            ChartOption opt = ChartOption.Scatter(f.label);
            ChartSeries s0 = ChartSeries.OfPoints("Series A", points);
            s0.color = Chart.Palette(t, 0);
            opt.Add(s0);
            ChartView.Of(opt).Render(app, x, y, w, hh);
            return;
        }

        ChartType ct = ChartType.Bar;
        if (kind == 1 || kind == 2) { ct = ChartType.Line; }
        ChartOption opt = ChartOption.With(ct, f.label, labels);
        if (kind == 2) {
            opt.Add(ChartSeries.Area("Series A", a)).Add(ChartSeries.Area("Series B", b));
        } else if (kind == 3) {
            opt.Add(ChartSeries.StackedBar("Series A", a)).Add(ChartSeries.StackedBar("Series B", b));
        } else if (kind == 4) {
            opt.Add(ChartSeries.HBar("Series A", a)).Add(ChartSeries.HBar("Series B", b));
        } else {
            opt.Add("Series A", a).Add("Series B", b);
        }
        ChartView.Of(opt).Render(app, x, y, w, hh);
    }

    /// 渲染表格字段的紧凑非交互预览：由字段选项（其列）构建的
    /// 表头行加上几行占位行。
    void PreviewTable(App app, Canvas c, Theme t, FormField f, int x, int y, int w, int avail) {
        int nc = f.OptionCount();
        if (nc < 1) { nc = 3; }
        List<string> cols = new List<string>();
        List<int> widths = new List<int>();
        List<string> cells = new List<string>();
        int colW = w / nc;
        for (int i = 0; i < nc; i = i + 1) {
            string h = "Col " + Convert.ToString(i + 1);
            if (i < f.OptionCount()) { h = Designer.ColTitle(f.OptionAt(i)); }
            cols.Add(h);
            widths.Add(colW);
            cells.Add("—");
        }
        int totalW = colW * nc;
        int rowH = t.heightMedium;
        int bh = avail - PvS(app, 6);
        if (bh < rowH * 3) { bh = rowH * 3; }
        c.PushClip(x, y, totalW, bh);
        Table.RenderHeader(app, x, y, cols, widths);
        int ry = y + rowH;
        bool striped = true;
        while (ry + rowH <= y + bh) {
            Table.RenderRow(app, x, ry, cells, widths, striped);
            striped = !striped;
            ry = ry + rowH;
        }
        c.PopClip();
        c.DrawRect(x, y, totalW, bh, t.borderPrimary, 1);
    }

    /// 水平渲染单选/复选字段选项的预览。
    void PreviewChoice(App app, Canvas c, Theme t, FormField f, int x, int y, int w, int line) {
        int fs = PvFont(t.fontSizeSmall);
        bool radio = (f.ftype == 4);
        int cy = y + line / 2;
        int gx = x;
        int mark = PvS(app, 14);
        for (int i = 0; i < f.OptionCount(); i = i + 1) {
            string opt = f.OptionAt(i);
            if (radio) {
                c.FillCircle(gx + mark / 2, cy, mark / 2, t.bgPrimary);
                c.DrawRect(gx, cy - mark / 2, mark, mark, t.borderPrimary, 1);
                if (i == 0) { c.FillCircle(gx + mark / 2, cy, mark / 4, t.primary); }
            } else {
                c.FillRoundRect(gx, cy - mark / 2, mark, mark, t.borderRadiusSmall, t.bgPrimary);
                c.DrawRoundRect(gx, cy - mark / 2, mark, mark, t.borderRadiusSmall, t.borderPrimary, 1);
            }
            int tx = gx + mark + PvS(app, 4);
            c.DrawText(tx, y + PvS(app, 6), opt, t.textSecondary, fs);
            int ow = mark + PvS(app, 8) + Canvas.MeasureText(opt, fs) + PvS(app, 12);
            gx = gx + ow;
            if (gx > x + w - PvS(app, 30)) { i = f.OptionCount(); }
        }
    }

    void Box(Canvas c, Theme t, int x, int y, int w, int h) {
        c.FillRoundRect(x, y, w, h, t.borderRadiusMedium, t.bgPrimary);
        c.DrawRoundRect(x, y, w, h, t.borderRadiusMedium, t.borderPrimary, 1);
    }

    // --- 检查器 ----
}
