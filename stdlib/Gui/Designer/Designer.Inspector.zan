using System;
using Gui.Widget;
using Gui;
using System.Json;

namespace Gui.Designer;

/// 设计器部分：属性检查器（逐字段编辑器、双向
/// 同步）和设计 JSON 序列化。
partial class Designer {
    void RenderInspector(App app, Canvas c, Theme t, int x, int y, int w, int h) {
        int fs = t.fontSizeSmall;
        c.FillRoundRect(x, y, w, h, app.Scale(6), t.bgSecondary);
        c.DrawRoundRect(x, y, w, h, app.Scale(6), t.borderPrimary, 1);
        int ix = x + app.Scale(12);
        int iw = w - app.Scale(24);

        // 固定头部：正在编辑的对象 + 属性/事件
        // 选项卡对。目标是选中的组件；未选中任何内容时
        // 是根 Window。
        bool root = (sel == null);
        int hy = y + app.Scale(10);
        string target = Designer.T("WINDOW", "窗口") + "  ·  " + winTitleSig.Get();
        if (!root) {
            string tn = FormField.TypeName(sel.ftype);
            if (sel.ftype == 100) { tn = sel.customKind; }
            target = Designer.T("COMPONENT", "组件") + "  ·  " + tn;
        }
        c.DrawText(ix, hy, Ellipsis.Fit(target, iw, fs), t.textTertiary, fs);
        hy = hy + app.Scale(18);

        int tabW = (iw - app.Scale(6)) / 2;
        int pType = 0; if (inspTab == 0) { pType = 1; }
        int eType = 0; if (inspTab == 1) { eType = 1; }
        int pId = SmallBtn(app, Designer.T("Properties", "属性"), pType, ix, hy, tabW);
        int eId = SmallBtn(app, Designer.T("Events", "事件"), eType,
            ix + tabW + app.Scale(6), hy, tabW);
        if (Ui.Clicked(app, pId) && inspTab != 0) { inspTab = 0; inspScroll = 0; }
        if (Ui.Clicked(app, eId) && inspTab != 1) { inspTab = 1; inspScroll = 0; }
        hy = hy + app.Scale(34);

        // 可滚动主体。内容高度取上一帧（inspContentH）的测量值，
        // 因此较高的属性/分组事件列表可以滚动。
        int bodyY = hy;
        int bodyH = y + h - bodyY - app.Scale(8);
        int maxScroll = inspContentH - bodyH;
        if (maxScroll < 0) { maxScroll = 0; }
        if (InRect(app.mouseX, app.mouseY, x, bodyY, w, bodyH)) {
            if (app.CaptureWheel(x, bodyY, w, bodyH)) {
                int delta = app.window.EventKeyCode();
                inspScroll = inspScroll - delta * app.Scale(40) / 120;
                app.RequestRedraw();
            }
        }
        if (inspScroll < 0) { inspScroll = 0; }
        if (inspScroll > maxScroll) { inspScroll = maxScroll; }

        c.PushClip(x + 1, bodyY, w - 2, bodyH);
        int iy = bodyY - inspScroll;
        int startY = iy;
        if (inspTab == 1) {
            iy = RenderEventsTab(app, c, t, ix, iy, iw);
        } else if (root) {
            iy = RenderWindowProps(app, c, t, ix, iy, iw);
        } else {
            SyncEditors(sel);
            iy = RenderFieldProps(app, c, t, sel, ix, iy, iw);
        }
        inspContentH = iy - startY;
        c.PopClip();

        if (maxScroll > 0) {
            Scrollbar.RenderVertical(app, x + w - app.Scale(7), bodyY,
                bodyH, inspContentH, inspScroll);
        }
    }

    void SyncEditors(FormField f) {
        if (f == selPrev) { return; }
        selPrev = f;
        labelSig.Set(f.label);
        nameSig.Set(f.fname);
        phSig.Set(f.placeholder);
        bindSig.Set(f.bindPath);
        bindPropSig.Set(f.bindProp);
        customSig.Set(f.customKind);
        optSig.Set("");
        List<string> evs = f.Events();
        if (evs.Count > 0) { evtEditing = evs[0]; } else { evtEditing = ""; }
        evtSig.Set(f.GetHandler(evtEditing));
    }

    /// 为事件建议委托方法名，例如字段 "amount" +
    /// "Change" -> "OnAmountChange"。类型名中的空格会被去掉，
    /// 显示组件（如 "Data Table"）仍能产生合法标识符。
    static string SuggestHandler(FormField f, string ev) {
        string src = f.fname;
        if (src == "") { src = FormField.TypeName(f.ftype); }
        string id = "";
        for (int i = 0; i < src.Length; i = i + 1) {
            string chs = src.Substring(i, 1);
            if (chs != " ") { id = id + chs; }
        }
        return "On" + id + ev;
    }

    /// 选中组件的属性选项卡（不含事件——它们在
    /// 事件选项卡）。返回最后一行之后的 y，供主体滚动。
    int RenderFieldProps(App app, Canvas c, Theme t, FormField f, int ix, int iy, int iw) {
        int fs = t.fontSizeSmall;
        iy = LabeledInput(app, c, t, Designer.T("Label", "标签"), labelInput, ix, iy, iw);
        f.label = labelSig.Get();
        iy = LabeledInput(app, c, t, Designer.T("Name", "名称"), nameInput, ix, iy, iw);
        f.fname = nameSig.Get();
        f.name = f.fname;
        iy = LabeledInput(app, c, t, Designer.T("Placeholder", "占位文本"), phInput, ix, iy, iw);
        f.placeholder = phSig.Get();
        string bindLbl = Designer.T("Bind path", "绑定路径");
        if (f.ftype == 23 || f.ftype == 41) { bindLbl = Designer.T("Data source", "数据源"); }
        iy = LabeledInput(app, c, t, bindLbl, bindInput, ix, iy, iw);
        f.bindPath = bindSig.Get();
        // 双向绑定选择器：从配对的代码文件扫描出的变量。
        if (bindVars.Count > 0) {
            string pickLbl = Designer.T("Pick from code ▾", "从代码选择 ▾");
            if (bindPickOpen) { pickLbl = Designer.T("Pick from code ▴", "从代码选择 ▴"); }
            int pkId = SmallBtn(app, pickLbl, 0, ix + app.Scale(84), iy, iw - app.Scale(84));
            if (Ui.Clicked(app, pkId)) {
                bindPickOpen = !bindPickOpen;
                app.RequestRedraw();
            }
            iy = iy + app.Scale(34);
            if (bindPickOpen) {
                for (int bvi = 0; bvi < bindVars.Count; bvi = bvi + 1) {
                    int bvType = 0;
                    if (bindVars[bvi] == f.bindPath) { bvType = 1; }
                    int bvId = SmallBtn(app, bindVars[bvi], bvType,
                        ix + app.Scale(84), iy, iw - app.Scale(84));
                    if (Ui.Clicked(app, bvId)) {
                        f.bindPath = bindVars[bvi];
                        bindSig.Set(f.bindPath);
                        bindInput.SetText(f.bindPath);
                        bindPickOpen = false;
                        msg = Designer.T("bound to ", "已绑定 ") + f.bindPath;
                        app.RequestRedraw();
                    }
                    iy = iy + app.Scale(32);
                }
            }
        }
        iy = LabeledInput(app, c, t, Designer.T("Bind prop", "绑定属性"), bindPropInput, ix, iy, iw);
        f.bindProp = bindPropSig.Get();
        if (f.ftype == 100) {
            iy = LabeledInput(app, c, t, Designer.T("Component", "组件"), customInput, ix, iy, iw);
            f.customKind = customSig.Get();
        }

        f.required = ToggleRow(app, c, t, Designer.T("Required", "必填"), f.required, ix, iy, iw);
        iy = iy + app.Scale(34);
        if (f.ftype == 15 || f.ftype == 16) {
            f.wrap = ToggleRow(app, c, t, Designer.T("Wrap text", "自动换行"), f.wrap, ix, iy, iw);
            iy = iy + app.Scale(34);
        }

        if (layoutMode == 1) {
            // 停靠边：选了某一边，画布上就自动吸附到所在层
            // （窗口或父容器）的那条边并铺满，只有厚度还能拉；
            // 「自由」才是纯绝对定位。
            List<string> dockOpts = new List<string>{
                Designer.T("Free", "自由"), Designer.T("Top", "上"),
                Designer.T("Bottom", "下"), Designer.T("Left", "左"),
                Designer.T("Right", "右"), Designer.T("Fill", "填充") };
            f.dockSide = SegRow(app, c, t, Designer.T("Dock", "停靠"), dockOpts,
                f.dockSide, ix, iy, iw);
            iy = iy + app.Scale(54);
            // 自由画布布局：设计空间的绝对位置/尺寸优先，
            // 覆盖 24 列宽设置。
            f.fx = IntRow(app, c, t, Designer.T("X", "X"), f.fx, 20, ix, iy, iw);
            iy = iy + app.Scale(36);
            f.fy = IntRow(app, c, t, Designer.T("Y", "Y"), f.fy, 20, ix, iy, iw);
            iy = iy + app.Scale(36);
            f.fw = IntRow(app, c, t, Designer.T("Width", "宽度"), f.fw, 20, ix, iy, iw);
            iy = iy + app.Scale(36);
            f.fh = IntRow(app, c, t, Designer.T("Height", "高度"), f.fh, 20, ix, iy, iw);
            iy = iy + app.Scale(36);
        } else {
            // 24 列网格上的字段宽度：快速预设外加精确跨度。
            List<string> spanOpts = new List<string>{
                "1/1", "1/2", "1/3", "1/4" };
            int spanSel = 0;
            if (f.span == 12) { spanSel = 1; }
            else if (f.span == 8) { spanSel = 2; }
            else if (f.span == 6) { spanSel = 3; }
            int newSel = SegRow(app, c, t, Designer.T("Field width", "字段宽度"), spanOpts, spanSel, ix, iy, iw);
            if (newSel != spanSel) {
                if (newSel == 1) { f.span = 12; }
                else if (newSel == 2) { f.span = 8; }
                else if (newSel == 3) { f.span = 6; }
                else { f.span = 24; }
            }
            iy = iy + app.Scale(54);
            f.span = IntRow(app, c, t, Designer.T("Span / 24", "跨度 / 24"), f.span, 1, ix, iy, iw);
            if (f.span < 1) { f.span = 1; }
            if (f.span > 24) { f.span = 24; }
            iy = iy + app.Scale(36);
        }

        if (f.ftype == 7) {
            f.defOn = ToggleRow(app, c, t, Designer.T("Default on", "默认开启"), f.defOn, ix, iy, iw);
            iy = iy + app.Scale(34);
        }

        if (f.UsesOptions()) {
            bool table = (f.ftype == 23 || f.ftype == 41);
            iy = iy + app.Scale(6);
            if (table) {
                c.DrawText(ix, iy, Designer.T("COLUMNS (title · field)", "列（标题 · 字段）"), t.textTertiary, fs);
            } else {
                c.DrawText(ix, iy, Designer.T("OPTIONS", "选项"), t.textTertiary, fs);
            }
            iy = iy + app.Scale(20);
            for (int oi = 0; oi < f.OptionCount(); oi = oi + 1) {
                string disp = f.OptionAt(oi);
                if (table) {
                    disp = Designer.ColTitle(disp);
                    string cfd = Designer.ColField(f.OptionAt(oi));
                    if (cfd != "") { disp = disp + "  ·  " + cfd; }
                }
                c.DrawText(ix, iy + app.Scale(7),
                    Convert.ToString(oi + 1) + ".  " + disp, t.textSecondary, fs);
                int rmId = SmallIconBtn(app, "close", 5, ix + iw - app.Scale(28), iy, app.Scale(28));
                if (Ui.Clicked(app, rmId)) {
                    RemoveOptionFixup(f, oi);
                }
                iy = iy + app.Scale(32);
            }
            if (table) {
                // 两部分列编辑器：显示标题 + 数据字段键。
                int half = (iw - app.Scale(54) - app.Scale(6)) / 2;
                optInput.Render(app, ix, iy, half, app.Scale(28));
                optFieldInput.Render(app, ix + half + app.Scale(6), iy, half, app.Scale(28));
                int addId = SmallBtn(app, Designer.T("Add", "添加"), 1, ix + iw - app.Scale(48), iy, app.Scale(48));
                if (Ui.Clicked(app, addId) && optSig.Get() != "") {
                    string col = optSig.Get();
                    if (optFieldSig.Get() != "") { col = col + ":" + optFieldSig.Get(); }
                    f.AddOption(col);
                    optSig.Set("");
                    optFieldSig.Set("");
                }
            } else {
                optInput.Render(app, ix, iy, iw - app.Scale(54), app.Scale(28));
                int addId = SmallBtn(app, Designer.T("Add", "添加"), 1, ix + iw - app.Scale(48), iy, app.Scale(48));
                if (Ui.Clicked(app, addId) && optSig.Get() != "") {
                    f.AddOption(optSig.Get());
                    optSig.Set("");
                }
            }
            iy = iy + app.Scale(38);
        }
        return iy + app.Scale(4);
    }

    /// 从 `f` 中移除选项 `oi` 并修复依赖状态，
    /// UI 永远不会索引超出缩小后的列表（旧的直接 RemoveOptionAt 可能
    /// 让 Tabs 容器的活动标签/子标签超出范围）。
    void RemoveOptionFixup(FormField f, int oi) {
        f.RemoveOptionAt(oi);
        if (f.ftype == 36) {
            for (int ki = 0; ki < f.kids.Count; ki = ki + 1) {
                if (f.kids[ki].childTab == oi) { f.kids[ki].childTab = 0; }
                else if (f.kids[ki].childTab > oi) { f.kids[ki].childTab = f.kids[ki].childTab - 1; }
            }
        }
        if (f.uiState.Get() >= f.OptionCount() || f.uiState.Get() < 0) { f.uiState.Set(0); }
    }

    /// 表格列选项的显示标题（"标题:字段"约定）。
    static string ColTitle(string opt) {
        int p = Designer.IndexOfColon(opt);
        if (p < 0) { return opt; }
        return opt.Substring(0, p);
    }

    /// 表格列选项的数据字段键（未声明时为 ""）。
    static string ColField(string opt) {
        int p = Designer.IndexOfColon(opt);
        if (p < 0) { return ""; }
        return opt.Substring(p + 1, opt.Length - p - 1);
    }

    static int IndexOfColon(string s) {
        for (int i = 0; i < s.Length; i = i + 1) {
            if (s.Substring(i, 1) == ":") { return i; }
        }
        return -1;
    }

    /// 根 Window 的属性选项卡：窗口装饰（标题/尺寸/标志）以及
    /// 应用于其内带标签输入行的共享布局默认值。
    int RenderWindowProps(App app, Canvas c, Theme t, int ix, int iy, int iw) {
        int fs = t.fontSizeSmall;
        c.DrawText(ix, iy, Designer.T("WINDOW", "窗口"), t.textTertiary, fs);
        iy = iy + app.Scale(20);

        iy = LabeledInput(app, c, t, Designer.T("Title", "标题"), winTitleInput, ix, iy, iw);

        // 把整个设计窗口保存为可复用的项目组件；
        // 宿主 IDE 会持久化它，之后它会出现在"我的组件"下。
        int scId = SmallBtn(app, Designer.T("Save as component", "保存为组件"), 1, ix, iy, iw);
        if (Ui.Clicked(app, scId)) {
            saveCompRequested = true;
            msg = Designer.T("saving as component…", "正在保存为组件…");
        }
        iy = iy + app.Scale(36);

        int newWinW = IntRow(app, c, t, Designer.T("Width", "宽度"), winW, 20, ix, iy, iw);
        iy = iy + app.Scale(36);
        int newWinH = IntRow(app, c, t, Designer.T("Height", "高度"), winH, 20, ix, iy, iw);
        iy = iy + app.Scale(36);
        // 经由 ApplyDesignSize 处理，使每种尺寸保留自己的自由画布
        // 布局（断点矩形），而不是仅仅调整窗口大小。
        ApplyDesignSize(newWinW, newWinH);

        winResizable = ToggleRow(app, c, t, Designer.T("Resizable", "可调整大小"), winResizable, ix, iy, iw);
        iy = iy + app.Scale(34);
        winTool = ToggleRow(app, c, t, Designer.T("Tool window", "工具窗口"), winTool, ix, iy, iw);
        iy = iy + app.Scale(34);
        winCenter = ToggleRow(app, c, t, Designer.T("Center on show", "显示时居中"), winCenter, ix, iy, iw);
        iy = iy + app.Scale(34);
        if (!winCenter) {
            winPosX = IntRow(app, c, t, Designer.T("Position X", "位置 X"), winPosX, 20, ix, iy, iw);
            iy = iy + app.Scale(36);
            winPosY = IntRow(app, c, t, Designer.T("Position Y", "位置 Y"), winPosY, 20, ix, iy, iw);
            iy = iy + app.Scale(36);
        }
        winGlass = ToggleRow(app, c, t, Designer.T("Frosted glass", "毛玻璃效果"), winGlass, ix, iy, iw);
        iy = iy + app.Scale(34);

        // 窗口轮廓：异形窗口按像素 alpha 合成，
        // 设计画布预览形状，运行中的窗口则是
        // 真正半透明的轮廓（CleanMyMac 风格卡片等）。自定义
        // 形状（winShape == 3）是以 JSON 编写的区域并集；
        // 检查器以只读方式显示它（请在 JSON 抽屉中编辑）。
        List<string> shapeOpts = new List<string>{
            Designer.T("Rect", "矩形"),
            Designer.T("Rounded", "圆角"),
            Designer.T("Ellipse", "圆形"),
            Designer.T("Custom", "自定义") };
        winShape = SegRow(app, c, t, Designer.T("Window shape", "窗口形状"), shapeOpts, winShape, ix, iy, iw);
        iy = iy + app.Scale(54);
        if (winShape == 1) {
            winShapeRadius = IntRow(app, c, t, Designer.T("Corner radius", "圆角半径"), winShapeRadius, 4, ix, iy, iw);
            iy = iy + app.Scale(36);
        } else if (winShape == 3) {
            c.DrawText(ix, iy, Designer.T("Union of regions (JSON)", "区域并集（JSON）"), t.textSecondary, fs);
            iy = iy + app.Scale(18);
            c.DrawText(ix, iy, Ellipsis.Fit(winShapeSpec, iw, fs), t.textTertiary, fs);
            iy = iy + app.Scale(20);
        }
        winChrome = ToggleRow(app, c, t, Designer.T("Title bar", "标题栏"), winChrome, ix, iy, iw);
        iy = iy + app.Scale(34);
        winOpacity = IntRow(app, c, t, Designer.T("Opacity (10-100)", "不透明度（10-100）"), winOpacity, 5, ix, iy, iw);
        iy = iy + app.Scale(36);

        c.DrawText(ix, iy, Designer.T("LAYOUT", "布局"), t.textTertiary, fs);
        iy = iy + app.Scale(20);
        List<string> posOpts = new List<string>{
            Designer.T("Left", "左"), Designer.T("Right", "右"), Designer.T("Top", "上") };
        labelPos = SegRow(app, c, t, Designer.T("Label position", "标签位置"), posOpts, labelPos, ix, iy, iw);
        iy = iy + app.Scale(54);
        List<string> szOpts = new List<string>{
            Designer.T("Large", "大"), Designer.T("Default", "默认"), Designer.T("Small", "小") };
        formSize = SegRow(app, c, t, Designer.T("Control size", "控件大小"), szOpts, formSize, ix, iy, iw);
        iy = iy + app.Scale(54);
        labelWidth = IntRow(app, c, t, Designer.T("Label width", "标签宽度"), labelWidth, 8, ix, iy, iw);
        iy = iy + app.Scale(36);
        bool showStar = !hideStar;
        showStar = ToggleRow(app, c, t, Designer.T("Required star", "必填星号"), showStar, ix, iy, iw);
        hideStar = !showStar;
        iy = iy + app.Scale(40);
        return iy;
    }

    /// 事件选项卡：当前目标（窗口根或选中组件）的所有事件，
    /// 按类别分组（Pointer / Keyboard / Focus / Drag /
    /// Lifecycle / Value），可滚动，带行内处理器编辑器。
    int RenderEventsTab(App app, Canvas c, Theme t, int ix, int iy, int iw) {
        int fs = t.fontSizeSmall;
        bool root = (sel == null);
        List<string> evs = Designer.WindowEventNames();
        if (!root) { evs = sel.Events(); }

        // 目标变化时重新为共享处理器编辑器填充数据。
        bool tgtChanged = (root != evtRootPrev) || (!root && sel != evtSelPrev);
        evtRootPrev = root;
        evtSelPrev = sel;
        if (root) {
            if (tgtChanged || !evs.Contains(winEvtEditing)) {
                if (evs.Count > 0) { winEvtEditing = evs[0]; } else { winEvtEditing = ""; }
                evtSig.Set(WinGetHandler(winEvtEditing));
            }
        } else {
            if (tgtChanged || !evs.Contains(evtEditing)) {
                if (evs.Count > 0) { evtEditing = evs[0]; } else { evtEditing = ""; }
                evtSig.Set(sel.GetHandler(evtEditing));
            }
        }

        int rowH = app.Scale(26);
        List<string> groups = Designer.EventGroups();
        for (int gi = 0; gi < groups.Count; gi = gi + 1) {
            string grp = groups[gi];
            int cnt = 0;
            for (int ck = 0; ck < evs.Count; ck = ck + 1) {
                if (Designer.EventCategory(evs[ck]) == grp) { cnt = cnt + 1; }
            }
            if (cnt > 0) {
                c.DrawText(ix, iy, Designer.GroupLabel(grp) + "  (" + Convert.ToString(cnt) + ")", t.textSecondary, fs);
                iy = iy + app.Scale(20);
                for (int ei = 0; ei < evs.Count; ei = ei + 1) {
                    string ev = evs[ei];
                    if (Designer.EventCategory(ev) == grp) {
                        string cur;
                        if (root) { cur = winEvtEditing; } else { cur = evtEditing; }
                        if (ev == cur) {
                            c.FillRoundRect(ix - app.Scale(4), iy - app.Scale(2),
                                iw + app.Scale(8), rowH, app.Scale(4), t.bgActive);
                        }
                        c.DrawText(ix, iy + app.Scale(5), ev, t.textPrimary, fs);
                        string h;
                        if (root) { h = WinGetHandler(ev); } else { h = sel.GetHandler(ev); }
                        string hv = h;
                        int hColor = t.textTertiary;
                        if (hv == "") { hv = "—"; } else { hColor = t.success; }
                        c.DrawText(ix + app.Scale(92), iy + app.Scale(5),
                            Ellipsis.Fit(hv, iw - app.Scale(180), fs), hColor, fs);
                        int edId = SmallBtn(app, Designer.T("edit", "编辑"), 0, ix + iw - app.Scale(84), iy, app.Scale(40));
                        if (Ui.Clicked(app, edId)) {
                            if (root) { winEvtEditing = ev; evtSig.Set(WinGetHandler(ev)); }
                            else { evtEditing = ev; evtSig.Set(sel.GetHandler(ev)); }
                        }
                        int crId = SmallBtn(app, Designer.T("new", "新建"), 1, ix + iw - app.Scale(40), iy, app.Scale(40));
                        if (Ui.Clicked(app, crId)) {
                            if (root) {
                                winEvtEditing = ev;
                                string sug = "OnWindow" + ev;
                                WinSetHandler(ev, sug);
                                evtSig.Set(sug);
                            } else {
                                evtEditing = ev;
                                string sug = Designer.SuggestHandler(sel, ev);
                                sel.SetHandler(ev, sug);
                                evtSig.Set(sug);
                            }
                        }
                        iy = iy + rowH + app.Scale(4);
                    }
                }
                iy = iy + app.Scale(8);
            }
        }

        string editEv;
        if (root) { editEv = winEvtEditing; } else { editEv = evtEditing; }
        iy = iy + app.Scale(2);
        c.DrawText(ix, iy, "on " + editEv + " +=", t.textTertiary, fs);
        iy = iy + app.Scale(18);
        evtInput.Render(app, ix, iy, iw, app.Scale(28));
        if (editEv != "") {
            if (root) { WinSetHandler(editEv, evtSig.Get()); }
            else { sel.SetHandler(editEv, evtSig.Get()); }
        }
        return iy + app.Scale(38);
    }

    /// 根 Window 的可设计事件（生命周期/尺寸/焦点/键盘）。
    static List<string> WindowEventNames() {
        List<string> e = new List<string>{
            "Load", "Show", "Hide", "Closing", "Close",
            "Resize", "Move", "Minimize", "Maximize", "Restore",
            "Activate", "Deactivate",
            "KeyDown", "KeyUp" };
        return e;
    }

    string WinGetHandler(string ev) {
        for (int i = 0; i < winEvents.Count; i = i + 1) {
            if (winEvents[i].key == ev) { return winEvents[i].val; }
        }
        return "";
    }

    void WinSetHandler(string ev, string h) {
        for (int i = 0; i < winEvents.Count; i = i + 1) {
            if (winEvents[i].key == ev) { winEvents[i].val = h; return; }
        }
        winEvents.Add(new EventBinding(ev, h));
    }

    /// 事件名的逻辑类别，事件选项卡据此把长列表
    /// 分组到可读标题之下而不是溢出。
    static string EventCategory(string ev) {
        if (ev == "Click" || ev == "DoubleClick" || ev == "RightClick"
            || ev == "MouseDown" || ev == "MouseUp" || ev == "Enter"
            || ev == "Leave" || ev == "Move" || ev == "Wheel" || ev == "Tap"
            || ev == "LongPress" || ev == "Swipe" || ev == "Hover") { return "Pointer"; }
        if (ev == "KeyDown" || ev == "KeyUp" || ev == "KeyPress") { return "Keyboard"; }
        if (ev == "Focus" || ev == "Blur" || ev == "Activate"
            || ev == "Deactivate") { return "Focus"; }
        if (ev == "DragStart" || ev == "Drag" || ev == "DragEnd" || ev == "Drop"
            || ev == "DragEnter" || ev == "DragLeave") { return "Drag & Drop"; }
        if (ev == "Resize" || ev == "Show" || ev == "Hide" || ev == "Open"
            || ev == "Close" || ev == "Closing" || ev == "Load"
            || ev == "Minimize" || ev == "Maximize" || ev == "Restore") { return "Lifecycle"; }
        return "Value & Data";
    }

    /// 事件类别标题的显示标签。类别键保持
    /// 英文（按字符串相等匹配）；只有事件选项卡中
    /// 显示的标题文本被翻译。
    static string GroupLabel(string grp) {
        if (grp == "Pointer") { return Designer.T("Pointer", "指针"); }
        if (grp == "Keyboard") { return Designer.T("Keyboard", "键盘"); }
        if (grp == "Focus") { return Designer.T("Focus", "焦点"); }
        if (grp == "Drag & Drop") { return Designer.T("Drag & Drop", "拖放"); }
        if (grp == "Lifecycle") { return Designer.T("Lifecycle", "生命周期"); }
        if (grp == "Value & Data") { return Designer.T("Value & Data", "值与数据"); }
        return grp;
    }

    /// 事件选项卡的类别显示顺序。
    static List<string> EventGroups() {
        List<string> g = new List<string>{
            "Pointer", "Keyboard", "Focus",
            "Drag & Drop", "Lifecycle", "Value & Data" };
        return g;
    }

    /// 面板过滤器使用的区分大小写子串测试（它匹配
    /// 小写类型键，因此小写查询即可）。
    static bool Contains(string hay, string needle) {
        if (needle.Length == 0) { return true; }
        if (hay.Length < needle.Length) { return false; }
        for (int i = 0; i + needle.Length <= hay.Length; i = i + 1) {
            if (hay.Substring(i, needle.Length) == needle) { return true; }
        }
        return false;
    }

    // --- 检查器行辅助方法 ----

    int LabeledInput(App app, Canvas c, Theme t, string label, Input inp, int ix, int iy, int iw) {
        int fs = t.fontSizeSmall;
        c.DrawText(ix, iy + app.Scale(7), label, t.textSecondary, fs);
        int lw = app.Scale(84);
        inp.Render(app, ix + lw, iy, iw - lw, app.Scale(28));
        return iy + app.Scale(36);
    }

    bool ToggleRow(App app, Canvas c, Theme t, string label, bool val, int ix, int iy, int iw) {
        int fs = t.fontSizeSmall;
        c.DrawText(ix, iy + app.Scale(7), label, t.textSecondary, fs);
        string disp = Designer.T("Off", "关");
        int ty = 0;
        if (val) { disp = Designer.T("On", "开"); ty = 3; }
        int id = SmallBtn(app, disp, ty, ix + iw - app.Scale(54), iy, app.Scale(54));
        bool nv = val;
        if (Ui.Clicked(app, id)) { nv = !val; }
        return nv;
    }

    int IntRow(App app, Canvas c, Theme t, string label, int val, int step, int ix, int iy, int iw) {
        int fs = t.fontSizeSmall;
        int bw = app.Scale(28);
        int valW = app.Scale(40);
        c.DrawText(ix, iy + app.Scale(7), label, t.textSecondary, fs);
        int pX = ix + iw - bw;
        int vX = pX - valW;
        int mX = vX - bw;
        int mId = SmallIconBtn(app, "minus", 0, mX, iy, bw);
        c.DrawTextCentered(vX, iy, valW, app.Scale(28), Convert.ToString(val), t.textPrimary, fs);
        int pId = SmallIconBtn(app, "plus", 0, pX, iy, bw);
        int nv = val;
        if (Ui.Clicked(app, mId)) { nv = val - step; }
        if (Ui.Clicked(app, pId)) { nv = val + step; }
        if (nv < 0) { nv = 0; }
        return nv;
    }

    int SegRow(App app, Canvas c, Theme t, string title, List<string> opts, int cur, int ix, int iy, int iw) {
        int fs = t.fontSizeSmall;
        c.DrawText(ix, iy, title, t.textSecondary, fs);
        int segY = iy + app.Scale(18);
        int n = opts.Count;
        int gapx = app.Scale(4);
        int segW = (iw - (n - 1) * gapx) / n;
        int gx = ix;
        int res = cur;
        for (int i = 0; i < n; i = i + 1) {
            int ty = 0;
            if (i == cur) { ty = 1; }
            int id = SmallBtn(app, opts[i], ty, gx, segY, segW);
            if (Ui.Clicked(app, id)) { res = i; }
            gx = gx + segW + gapx;
        }
        return res;
    }

    // --- 状态栏 ----

    void RenderStatus(App app, Canvas c, Theme t, int x, int y, int w) {
        int fs = t.fontSizeSmall;
        string s = Convert.ToString(fields.Count) + Designer.T(" fields", " 个组件");
        if (sel != null) {
            s = s + Designer.T("   ·   selected: ", "   ·   已选中：") + FormField.TypeName(sel.ftype) + " '" + sel.fname + "'";
        }
        if (activeContainer != null) {
            s = s + Designer.T("   ·   adding into: ", "   ·   添加到：") + FormField.TypeName(activeContainer.ftype);
            if (activeContainer.ftype == 36) {
                s = s + Designer.T(" tab ", " 标签页 ") + Convert.ToString(activeContainer.uiState.Get() + 1);
            }
        }
        c.DrawText(x, y, s + "     ·     " + msg, t.textTertiary, fs);
    }

    // --- 持久化（JSON）----

    /// 把整个表单序列化为人类可编辑的 JSON 文档：表单
    /// 配置加有序的 "fields" 数组。这是交换格式——
    /// 手工编辑 JSON 再加载回去即可重新配置表单，
    /// 设计器完全由数据驱动。与 LoadJson 往返兼容。
    ///   { name, labelPos, formSize, labelWidth, hideStar, showSubmit,
    ///     showReset, submit, fields:[ { type,label,name,placeholder,
    ///     required,change,options:[...] } ] }
    string SaveJson() {
        JsonValue o = JsonValue.NewObject();
        o.Put("name", JsonValue.NewStr(formNameSig.Get()));
        o.Put("labelPos", JsonValue.NewNum(Convert.ToString(labelPos)));
        o.Put("formSize", JsonValue.NewNum(Convert.ToString(formSize)));
        o.Put("labelWidth", JsonValue.NewNum(Convert.ToString(labelWidth)));
        o.Put("hideStar", JsonValue.NewBool(hideStar));
        o.Put("showSubmit", JsonValue.NewBool(showSubmit));
        o.Put("showReset", JsonValue.NewBool(showReset));
        o.Put("submit", JsonValue.NewStr(submitSig.Get()));
        o.Put("winW", JsonValue.NewNum(Convert.ToString(winW)));
        o.Put("winH", JsonValue.NewNum(Convert.ToString(winH)));
        o.Put("winTitle", JsonValue.NewStr(winTitleSig.Get()));
        o.Put("winResizable", JsonValue.NewBool(winResizable));
        o.Put("winTool", JsonValue.NewBool(winTool));
        o.Put("winCenter", JsonValue.NewBool(winCenter));
        o.Put("winPosX", JsonValue.NewNum(Convert.ToString(winPosX)));
        o.Put("winPosY", JsonValue.NewNum(Convert.ToString(winPosY)));
        o.Put("layoutMode", JsonValue.NewNum(Convert.ToString(layoutMode)));
        o.Put("winZoom", JsonValue.NewNum(Convert.ToString(winZoom)));
        o.Put("winRound", JsonValue.NewBool(winRound));
        o.Put("winShape", this.ShapeJson());
        o.Put("winShapeRadius", JsonValue.NewNum(Convert.ToString(winShapeRadius)));
        o.Put("winChrome", JsonValue.NewBool(winChrome));
        o.Put("winGlass", JsonValue.NewBool(winGlass));
        o.Put("winOpacity", JsonValue.NewNum(Convert.ToString(winOpacity)));
        JsonValue fieldsArr = JsonValue.NewArray();
        for (int fi = 0; fi < fields.Count; fi = fi + 1) {
            fieldsArr.Append(this.FieldJson(fields[fi]));
        }
        o.Put("fields", fieldsArr);
        return o.PrettyToJson();
    }

    /// winShape 的 JSON：Rect/Rounded/Ellipse 为普通整数，
    /// 自定义并集形状为区域数组（"t,x,y,w,h,r;..." -> [{"t":..},..]）。
    JsonValue ShapeJson() {
        if (winShape != 3) { return JsonValue.NewNum(Convert.ToString(winShape)); }
        JsonValue arr = JsonValue.NewArray();
        List<string> parts = winShapeSpec.Split(";");
        for (int i = 0; i < parts.Count; i = i + 1) {
            List<string> n = parts[i].Split(",");
            if (n.Count >= 6) {
                JsonValue r = JsonValue.NewObject();
                r.Put("t", JsonValue.NewNum(n[0]));
                r.Put("x", JsonValue.NewNum(n[1]));
                r.Put("y", JsonValue.NewNum(n[2]));
                r.Put("w", JsonValue.NewNum(n[3]));
                r.Put("h", JsonValue.NewNum(n[4]));
                r.Put("r", JsonValue.NewNum(n[5]));
                arr.Append(r);
            }
        }
        return arr;
    }

    /// ShapeJson 的逆操作：winShape 区域数组 -> 运行时消费的紧凑
    /// "t,x,y,w,h,r;..." 规格。
    string ShapeSpecFromJson(JsonValue arr) {
        string s = "";
        int i = 0;
        while (i < arr.Count()) {
            JsonValue r = arr.At(i);
            int t = r.Int("t", 1);
            int x = r.Int("x", 0);
            int y = r.Int("y", 0);
            int w = r.Int("w", 0);
            int h = r.Int("h", 0);
            int rr = r.Int("r", 0);
            if (w <= 0 || h <= 0) { i = i + 1; continue; }
            if (s.Length > 0) { s = s + ";"; }
            s = s + Convert.ToString(t) + "," + Convert.ToString(x) + ","
                + Convert.ToString(y) + "," + Convert.ToString(w) + ","
                + Convert.ToString(h) + "," + Convert.ToString(rr);
            i = i + 1;
        }
        return s;
    }

    /// 从 FormField 构建一个字段对象，递归进入容器
    /// `kids`，使 JSON 往返包含所有设计器事件绑定、选项和
    /// 子节点。读取器（FieldFromJson）与此键集镜像对应。
    JsonValue FieldJson(FormField f) {
        JsonValue o = JsonValue.NewObject();
        string kd = FormField.TypeKey(f.ftype);
        if (f.ftype == 100) { kd = "custom"; }
        o.Put("kind", JsonValue.NewStr(kd));
        o.Put("type", JsonValue.NewNum(Convert.ToString(f.ftype)));
        if (f.ftype == 100) {
            o.Put("custom", JsonValue.NewStr(f.customKind));
        }
        o.Put("label", JsonValue.NewStr(f.label));
        o.Put("name", JsonValue.NewStr(f.fname));
        o.Put("placeholder", JsonValue.NewStr(f.placeholder));
        o.Put("bind", JsonValue.NewStr(f.bindPath));
        o.Put("bindProp", JsonValue.NewStr(f.bindProp));
        o.Put("required", JsonValue.NewBool(f.required));
        if (f.ftype == 15 || f.ftype == 16) {
            o.Put("wrap", JsonValue.NewBool(f.wrap));
        }
        o.Put("span", JsonValue.NewNum(Convert.ToString(f.span)));
        o.Put("fx", JsonValue.NewNum(Convert.ToString(f.fx)));
        o.Put("fy", JsonValue.NewNum(Convert.ToString(f.fy)));
        o.Put("fw", JsonValue.NewNum(Convert.ToString(f.fw)));
        o.Put("fh", JsonValue.NewNum(Convert.ToString(f.fh)));
        if (f.altRects != "") {
            o.Put("alt", JsonValue.NewStr(f.altRects));
        }
        if (f.locked) { o.Put("locked", JsonValue.NewBool(true)); }
        o.Put("defOn", JsonValue.NewBool(f.defOn));
        // 外壳类总是写出停靠边：编译期对它们有默认边
        // （工具条贴顶、状态栏贴底、停靠面板填充），显式的
        // manual(0) 必须能覆盖这个默认值。
        if (f.dockSide != 0 || FormField.IsShellOf(f.ftype)) {
            o.Put("dock", JsonValue.NewNum(Convert.ToString(f.dockSide)));
        }
        o.Put("childTab", JsonValue.NewNum(Convert.ToString(f.childTab)));
        o.Put("activeTab", JsonValue.NewNum(Convert.ToString(f.uiState.Get())));
        List<string> evs = f.Events();
        for (int e = 0; e < evs.Count; e = e + 1) {
            string h = f.GetHandler(evs[e]);
            if (h != "") {
                o.Put("on" + evs[e], JsonValue.NewStr(h));
            }
        }
        JsonValue opts = JsonValue.NewArray();
        for (int op = 0; op < f.OptionCount(); op = op + 1) {
            opts.Append(JsonValue.NewStr(f.OptionAt(op)));
        }
        o.Put("options", opts);
        if (f.IsContainer()) {
            JsonValue kids = JsonValue.NewArray();
            for (int ki = 0; ki < f.kids.Count; ki = ki + 1) {
                kids.Append(this.FieldJson(f.kids[ki]));
            }
            o.Put("kids", kids);
        }
        return o;
    }

    /// 根据 SaveJson 生成（或
    /// 手写/工具生成的）JSON 设计文档重建表单。用真正的 JSON 解析器读取，因此任意
    /// 合法格式——美化打印、紧凑、或键乱序——加载结果都一致，
    /// 而不依赖每行一个键的布局。
    void LoadJson(string s) {
        fields = new List<FormField>();
        sel = null;
        selPrev = null;
        activeContainer = null;
        JsonValue root = JsonValue.ParseLenient(s);
        if (root == null || !root.IsObject()) {
            seq = 0;
            return;
        }
        if (root.Has("name")) { formNameSig.Set(root.Str("name", formNameSig.Get())); }
        labelPos = root.Int("labelPos", labelPos);
        formSize = root.Int("formSize", formSize);
        labelWidth = root.Int("labelWidth", labelWidth);
        hideStar = root.Bool("hideStar", hideStar);
        showSubmit = root.Bool("showSubmit", showSubmit);
        showReset = root.Bool("showReset", showReset);
        if (root.Has("submit")) { submitSig.Set(root.Str("submit", "")); }
        winW = root.Int("winW", winW);
        winH = root.Int("winH", winH);
        if (root.Has("winTitle")) { winTitleSig.Set(root.Str("winTitle", winTitleSig.Get())); }
        winResizable = root.Bool("winResizable", winResizable);
        winTool = root.Bool("winTool", winTool);
        winCenter = root.Bool("winCenter", winCenter);
        winPosX = root.Int("winPosX", winPosX);
        winPosY = root.Int("winPosY", winPosY);
        layoutMode = root.Int("layoutMode", layoutMode);
        winZoom = root.Int("winZoom", winZoom);
        winRound = root.Bool("winRound", winRound);
        JsonValue wsh = root.Get("winShape");
        if (wsh != null && wsh.IsArray()) {
            winShape = 3;
            winShapeSpec = ShapeSpecFromJson(wsh);
        } else {
            winShape = root.Int("winShape", winShape);
            winShapeSpec = "";
        }
        winShapeRadius = root.Int("winShapeRadius", winShapeRadius);
        winChrome = root.Bool("winChrome", winChrome);
        winGlass = root.Bool("winGlass", winGlass);
        winOpacity = root.Int("winOpacity", winOpacity);
        if (layoutMode < 0 || layoutMode > 1) { layoutMode = 0; }
        JsonValue arr = root.Get("fields");
        if (arr != null && arr.IsArray()) {
            BuildFieldsFromJson(arr, fields);
        }
        seq = CountFields(fields);
    }

    /// 仅解析设计 JSON 的 "fields" 数组到一个新列表，用于
    /// 在不触碰表单的情况下实例化已保存的用户组件。接受
    /// 完整设计文档或纯 fields 数组。
    List<FormField> ParseComponentFields(string s) {
        List<FormField> outp = new List<FormField>();
        JsonValue root = JsonValue.ParseLenient(s);
        if (root == null) { return outp; }
        JsonValue arr = root.Get("fields");
        if (arr == null && root.IsArray()) { arr = root; }
        if (arr != null && arr.IsArray()) {
            BuildFieldsFromJson(arr, outp);
        }
        return outp;
    }

    /// 将 JSON 数组中的每个对象追加为 FormField（递归处理
    /// 容器 "kids"），保持顺序。
    void BuildFieldsFromJson(JsonValue arr, List<FormField> dst) {
        for (int i = 0; i < arr.Count(); i = i + 1) {
            JsonValue o = arr.At(i);
            if (o != null && o.IsObject()) {
                dst.Add(FieldFromJson(o));
            }
        }
    }

    /// 从 JSON 对象构建一个 FormField。先应用 "type"，这样
    /// 字段的事件集（Events()）和容器属性反映真实类型，
    /// 然后才读取 handlers、options 和子级。
    FormField FieldFromJson(JsonValue o) {
        FormField f = new FormField(0);
        f.SetOptionsFrom("");
        if (o.Has("kind")) {
            f.ftype = FormField.TypeForKey(o.Str("kind", "input"));
        } else {
            f.ftype = o.Int("type", 0);
        }
        f.customKind = o.Str("custom", f.customKind);
        f.label = o.Str("label", f.label);
        f.fname = o.Str("name", f.fname);
        f.name = f.fname;
        f.placeholder = o.Str("placeholder", f.placeholder);
        f.bindPath = o.Str("bind", f.bindPath);
        f.bindProp = o.Str("bindProp", f.bindProp);
        f.required = o.Bool("required", f.required);
        f.wrap = o.Bool("wrap", f.wrap);
        f.span = o.Int("span", f.span);
        f.fx = o.Int("fx", f.fx);
        f.fy = o.Int("fy", f.fy);
        f.fw = o.Int("fw", f.fw);
        f.fh = o.Int("fh", f.fh);
        f.altRects = o.Str("alt", f.altRects);
        f.locked = o.Bool("locked", f.locked);
        f.defOn = o.Bool("defOn", f.defOn);
        f.dockSide = o.Int("dock", f.dockSide);
        f.childTab = o.Int("childTab", f.childTab);
        f.uiState.Set(o.Int("activeTab", f.uiState.Get()));
        List<string> evs = f.Events();
        for (int e = 0; e < evs.Count; e = e + 1) {
            string key = "on" + evs[e];
            if (o.Has(key)) { f.SetHandler(evs[e], o.Str(key, "")); }
        }
        if (o.Has("change")) { f.SetHandler("Change", o.Str("change", "")); }
        JsonValue opts = o.Get("options");
        if (opts != null && opts.IsArray()) {
            f.SetOptionsFrom("");
            for (int k = 0; k < opts.Count(); k = k + 1) {
                f.AddOption(opts.At(k).AsString(""));
            }
        }
        JsonValue kids = o.Get("kids");
        if (kids != null && kids.IsArray()) {
            BuildFieldsFromJson(kids, f.kids);
        }
        return f;
    }

    /// 字段总数（含嵌套容器子级）；加载后为唯一名计数器
    /// 提供初始值。
    int CountFields(List<FormField> lst) {
        int total = 0;
        for (int i = 0; i < lst.Count; i = i + 1) {
            total = total + 1 + CountFields(lst[i].kids);
        }
        return total;
    }
}
