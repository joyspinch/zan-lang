using System;
using Gui.Component.Chart;
using Gui.Backend;

namespace Gui;

/// App 保留动画存储中的一个带键补间/状态槽。取代了
/// 六个按索引对齐的 animKeys/animVals/animTarget/animFrom/animStart/animDur
/// 并行列表：`键`=稳定 id，`cur`=当前值，`dst`=目标值，
/// `src`=补间起始值，`startMs`=补间开始时间，`dur`=时长（毫秒）。
class AnimSlot {
    int key;
    int cur;
    int dst;
    int src;
    int startMs;
    int dur;

    AnimSlot(int k, int c, int d, int s, int st, int du) {
        key = k;
        cur = c;
        dst = d;
        src = s;
        startMs = st;
        dur = du;
    }
}

/// 一条「整窗重绘理由 → 帧数」计数（参见 App.NoteFullFrameWhy）。
class WhyTally {
    string why;
    int n;

    WhyTally(string why) {
        this.why = why;
        this.n = 1;
    }
}

/// 一帧的绘制体（参见 App.RunLoop / App.SafeFrame）。
delegate void FrameBody();

class App {
    Window window;
    Canvas canvas;
    Theme theme;
    FocusManager focus;
    HitTester hitTester;
    bool isRunning;
    bool needsRedraw;
    // 「别阻塞等事件，这一圈就回来」——与 needsRedraw 不同，它不
    // 声称有像素变了。自动化驱动、外部泵这类需要循环持续转的
    // 场景用它，避免为了轮询而把每一帧都升级成整窗重绘。
    bool pollPending;
    /// 被 SafeFrame/PumpSafe 捕下的帧异常计数与最后一条消息：
    /// 界面可以把它当状态显示（“本次运行有 N 个错误”）。
    int frameErrors;
    string lastFrameError;
    // 注册的帧绘制体（SetFrameBody）。窗口过程在系统模态
    // 尺寸调整循环里用它就地画帧，见 PaintFromWndProc。
    FrameBody frameBody;
    // 最后一个注册了帧体的 App。窗口过程回调是普通函数
    // 指针，拿不到实例，因此在这里存一份。
    static App frameApp;
    // 窗口过程画帧时置位。呈现会改窗口状态（分层窗口的
    // UpdateLayeredWindow 就带尺寸），系统可能就地再投一条尺寸
    // 消息进来：不拦住就会在上一帧还没呈现完时开始画下一帧，
    // 两帧共用同一块表面。
    static bool wndProcPainting;
    int frameCount;
    int mouseX;
    int mouseY;
    int scrollY;
    int contentHeight;
    int scrollSpeed;
    int dpiScale;
    // 构造期请求的逻辑设计尺寸。全屏宿主（Android 上 SDL 窗口
    // 就是整个 activity 表面）不会按请求给窗口尺寸，Show() 依靠
    // 这两个值把 dpiScale 重新拟合到「设计整页放进客户区」。
    int designW;
    int designH;
    int titlebarH;
    int captionBtnW;
    int splitX;
    int sidebarScrollY;
    int sidebarContentHeight;
    bool isDark;
    bool isTopmost;
    bool showThemeButton;
    bool showPinButton;
    bool showMinimizeButton;
    bool showMaximizeButton;
    bool showCloseButton;
    // 上一帧画出来的那条标题提示（它的按钮 id 与提示区左边）；
    // 0 = 上一帧没有提示。
    int capTipId;
    int capTipX;
    string themeTipText;
    string pinTipText;
    string minimizeTipText;
    string maximizeTipText;
    string restoreTipText;
    string closeTipText;
    // 标题栏主题选择器。当 themeNames 非空时，主题标题
    // 按钮会打开一个下拉菜单列出这些预设（一个"颜色"字形）
    // 而不是在深色/浅色间切换；themeMenuChange 在新选择时触发，
    // themeMenuModel 携带所选索引。选项 id 位于一段稳定的
    // 高位 WidgetId 区间中，因此永远不会与标题按钮的 id 冲突。
    List<string> themeNames;
    SignalInt themeMenuModel;
    SignalBool themeMenuOpen;
    SignalInt themeMenuScroll;
    int themeMenuBaseId;
    UiEvent themeMenuChange;
    // 外观抽屉的附加项：强制背景效果类型（-1 = 跟随
    // 皮肤）和强调色覆盖（0 = 皮肤默认），两者都应用在
    // 当前激活的预设之上。
    /// 外观抽屉的附加项：强制背景效果类型（-1 = 跟随
    /// 皮肤）和强调色覆盖（0 = 皮肤默认），两者都应用在
    /// 当前激活的预设之上。
    int fxKindOverride;
    int accentOverride;
    SignalInt themeDrawerTab;
    // 全局密度档（0 小 / 1 中 / 2 大，见 Theme.DensityPermille）：
    // 外观抽屉选择、SetDensity API 与皮肤 `--density` token 共用。
    // 基线度量在换肤/换主题时快照（densityBase），当前 theme 的度量
    // 永远是"基线 × 密度 × DPI"的乘积，档位切换从基线重推不叠加。
    // hasSkinDensity：当前皮肤包声明过 `--density`（跟随皮肤，用户
    // 抽屉选择被皮肤切换覆盖）；false = 用户自主档位。
    int density;
    List<int> densityBase;
    bool hasSkinDensity;
    // 皮肤切换：当 autoSkins 开启时，标题栏主题按钮是一个菜单
    // 其中列出磁盘上的皮肤（Skin.Names），由 App 自行应用所选皮肤
    // （无需每个应用的处理程序）。appliedSkin 是最后应用的索引，这样 RenderChrome
    // 每帧都能检测到新的选择。默认每个窗口都启用此功能。
    bool autoSkins;
    int appliedSkin;
    // 每个皮肤都是一个 CSS 包（`skins/<名称>/skin.css`）：skinPacks 就是该列表
    // 按选择器顺序排列，因此皮肤索引就是该列表的下标。skinArt 是
    // 当前皮肤包安装为壁纸的插画，因此切换到不带插画的
    // 皮肤包时，会移除该插画，而不影响用户自行选择的壁纸
    // 本身。
    List<string> skinPacks;
    string skinArt;
    // 当前皮肤包插画安装时的不透明度（百分比），保留此值以便
    // 当用户壁纸被清除时，能以相同强度重新安装该插画。
    // 清除。
    int skinArtOpacity;
    // 当前皮肤样式表（CSS），每个控件都依据它解析外观，
    // 以及它来源的皮肤包名称（"" = 无，仅使用主题令牌）。
    // 永不为空：空样式表表示"仅主题默认值"，因此控件
    // 无需判空即可始终解析成功。
    StyleSheet sheet;
    // 应用自身的样式表（页面布局和应用专属规则）。
    // 与皮肤分开保存，并在每次皮肤变更时重新叠放到最上层，
    // 这样切换皮肤会重新为应用换装，而不会丢失其布局。
    string appCss;
    string skinName;
    // 当操作系统正在合成真实的半透明背景（Win11
    // 亚克力 / macOS 毛玻璃 / Linux 合成器模糊）时为此窗口后面置 true。
    // 当玻璃皮肤激活时由 ApplyTheme 设置。开启时，帧被
    // 清除为透明，并跳过应用内壁纸，使模糊的
    // 桌面从缝隙中透出。
    bool glassNative;
    // 上次通过 SetWindowOpacity 设置的整窗不透明度百分比（0 = 从未设置，
    // 视为 100/不透明）。
    int windowOpacity;
    // 用户能否拖边框 / 最大化改变窗口大小（设计里的 resizable）。
    bool windowResizable;
    // 窗口轮廓：0 = 矩形，1 = 异形。非零值窗口按
    // 逐像素 alpha（分层窗口）合成；当
    // DWM 关闭时使用经典区域：BeginFrame 将表面完全清除为透明，控件树
    // 绘制形状，操作系统负责合成。shapeSpec 保存联合
    // 规格（"t,x,y,w,h,r;..." 逻辑像素），shapeRadius 保存第一个区域的
    // 圆角半径（供 WindowShapeRadius() 使用）。
    int shapeMode;
    int shapeRadius;
    string shapeSpec;
    // 异形轮廓投影（逻辑像素扩散量，0 = 无）：由
    // RenderBackground 在控件树之前绘制，使每个形状区域投下柔和的
    // 阴影。设计中的 winShadow 还会让 formgen 前置追加一个 type-3
    // "阴影带"区域（全窗口圆角矩形）到规格中，使操作系统
    // 表面覆盖阴影像素。shapeRects 以逻辑像素镜像已解析的规格，
    // 使 App 无需接触后端即可绘制阴影。
    int shapeShadow;
    List<int> shapeRects;
    // 是否绘制自定义标题栏装饰（品牌区 + 标题按钮）。
    // 对于设计自带头部区域的异形/无边框窗口保持隐藏；
    // 无论哪种方式，操作系统都会保持顶部 TitlebarHeight() 条带可拖动。
    bool showChrome;
    // 标题栏上应用自己写入的动态信息（登录/授权、性能指标等），
    // 画在标题文字之后、标题按钮之前。chromeStatus 用常规文本色，
    // chromeAccent 用强调色，见 SetChromeStatus。
    string chromeStatus;
    string chromeAccent;
    // 本帧内希望消费鼠标滚轮事件的矩形区域（画布坐标）
    // —— 例如带自身内部行滚动的 DataTable 主体。当
    // 指针位于其中时，ProcessEvent 会抑制页面滚动，使滚轮
    // 转而驱动该控件。每帧在 BeginFrame 中重置。
    int wheelCapX;
    int wheelCapY;
    int wheelCapW;
    int wheelCapH;
    int wheelClaimSeq;
    int wheelCapOrder;
    int wheelOwnerOrder;
    // 本帧内自行消费 Tab 键的聚焦控件 id（例如
    // CodeEditor，它使用 Tab/Shift+Tab 进行缩进）。设置后，Tab
    // 不会把键盘焦点移动到下一个控件。每帧在
    // BeginFrame 中重置；由控件在渲染期间设置。
    int tabHoldId;
    bool blocksInputBelow;
    bool inputBlockPrevious;
    // 本帧/上一帧的全窗口阻挡是否来自上下文菜单
    // （BlockHitsMenu）。菜单只拥有主键：右键要能穿到它下面，
    // 否则菜单一开，在别处右键什么也不会发生，必须先把它关掉。
    bool menuBlock;
    bool menuBlockPrevious;
    // 当前主键点击已在本次帧的剩余部分被消费 ——
    // 当模态遮罩在帧中途首次出现时自动设置（打开它的那次点击
    // 已被消耗），或通过 ClaimClick() 显式设置。读取原始点击事件的
    // 界面必须测试 ClickAvailable() 而不是直接读取窗口
    // 事件，这样点击永远不会穿透到它自己刚刚打开的模态框
    // 中。每帧在 BeginFrame 中重置。
    bool clickClaimed;
    // 一次释放只投递给一帧：持续动画（星空、spinner）会在下个
    // 事件到来前反复出帧，而 EventKind 停留在 3；没有此锁定时
    // 按钮等会在每个动画帧重新触发（通知连发、点击计数暴涨）。
    // frameSeq 由 BeginFrame 递增；clickSeenSeq 记录当前释放
    // 首次被读到的帧（-1 = 新释放尚未绑定）。
    // 解除绑定只认"没见过的新释放事件"：自定义循环的动画分支
    // 可以不泵事件就出帧，此时 EventKind 回读上一次的旧值，
    // 单看 kind==3 会把同一次释放每帧都当成新的（点击每帧
    // 重触发）。clickEvSeq 记录已解除绑定的事件序号。
    int frameSeq;
    int clickSeenSeq;
    long clickEvSeq;

    // --- 事件分发 ---
    // 当前鼠标事件的目标，在 ProcessEvent 中每事件解析一次，
    // 依据上一帧完整的命中区域（其中
    // 已包含顶部的弹窗/浮层）。控件通过 Ui.Clicked/Pressed
    // 询问自己是否是该目标，这样一次点击只投递给一个
    // 控件 —— 指针下的最顶层控件 —— 而不是每个
    // 在自身渲染时碰巧重新读取原始事件的控件。
    int clickTargetId;
    int pressTargetId;
    bool pointerDown;    // 按住左键（控件外的拖拽需要移动重绘）
    // 次要（右键）鼠标按钮目标，解析方式与
    // 主键点击/按下目标相同，但保持独立，这样右键永远不会
    // 触发 Ui.Clicked 或抢占键盘焦点。通过 RightClickTarget()
    // / RightPressTarget() 读取（参见 Ui.RightClicked）。
    int rightClickTargetId;
    int rightPressTargetId;
    // 双击 / 双点检测。lastClickId + lastClickMs 记录
    // 最近一次完成的点击；doubleClickNow 是一个单帧标志，当
    // 第二次点击在双击时间窗口内落在同一 id 上时置位。通过
    // DoubleClickNow() / Ui.DoubleClicked 读取。
    int lastClickId;
    int lastClickMs;
    bool doubleClickNow;
    // 触摸/指针手势状态。按下时我们快照目标 id、
    // 指针位置和墙钟时间；释放时根据移动距离推导出滑动
    // 方向，按住期间 PollLongPress() 在
    // 按住时间超过阈值且移动不多时报告一次长按。
    // 单指触摸以合成的鼠标序列到达，因此这些
    // 无需任何运行时改动即可在触摸屏上工作（多点触控/捏合则需要
    // C 运行时中的真实 WM_TOUCH / XInput2 支持）。
    int pressStartX;
    int pressStartY;
    int pressStartMs;
    int pressStartId;
    bool longPressFired;
    int swipeDir;
    // 延迟的浮层弹窗（Select/SelectBox/Dropdown/Menu 选项列表）。
    // 它们在主内容阶段之后运行，因此既绘制在其上方，又
    // 最后注册命中区域（使它们成为最顶层目标）。数据
    // 而非回调，因为 Zan 委托无法捕获局部变量 / 绑定 `this`。
    // 在帧内收集，由 RunOverlays 排空，在 BeginFrame 中清除。
    List<OverlayPopup> overlays;

    // 本帧登记的原生浮层（WebView 等 OS 兄弟层）与遮挡区。原生视图
    // 永远画在软件画布之上，所以它们不自己决定可见性，而是登记
    // 想占的矩形，由 PresentFrame 在弹层之后统一算出可见区域并
    // 下发裁剪（见 NativeLayer）。同样在 BeginFrame 中清除。
    List<NativeLayerReq> nativeLayers;
    List<int> nativeOccluders;
    // 只吞点击、不画任何像素的全窗口拦截区（BlockHitsBelow）。菜单/
    // 下拉铺它是为了让外部点击关掉自己，画的只有那一小块菜单体，
    // 因此它不能算作原生浮层的遮挡区——否则一开右键菜单，整页网页
    // 就被裁成空区域消失。真正遮住整窗的变暗遮罩自己调
    // NativeLayer.Occlude 声明。
    List<int> hitOnlyBlockers;
    // 最近下发给外壳的缩放填充色（-1 = 尚未下发）。
    int lastResizeBg;

    // --- 动画时钟 ---
    // 按键的补间状态。控件每帧调用 AnimTo()/AnimPx() 传入
    // 目标；数值向目标缓动，并持续请求重绘直到
    // 稳定下来，从而在原本事件驱动的循环中获得平滑过渡。
    // AnimTo 是*基于时间*的：进度 = (now - start) / duration，因此它
    // 不受逐帧 dt 抖动的影响（过去这曾导致运动卡顿）。
    // 每个槽位携带自己的键 / 当前值 / 目标 / 补间起始
    // 值 / 补间开始时间（毫秒）/ 时长（毫秒），作为一个 AnimSlot 实体。
    List<AnimSlot> anims;
    int nowMs;
    int lastFrameMs;
    bool freezeAnimClock;
    // 可选帧分析器（ZAN_FRAME_PROF=1）：累计每帧的渲染和
    // 提交成本，每 120 帧追加一行平均值
    // 到进程目录下的 zan_frame_perf.log。0 = 尚未读取环境变量，
    // 1 = 开启，2 = 关闭。
    static int perfMode;
    // 局部帧（悬停条带、动画矩形、纯特效就地呈现）的总开关，默认
    // 关闭：每一帧都整窗重绘并整窗上传。见 SetPartialFrames。
    bool partialFrames;
    // 刚处理过滚轮（kind 13）：滚动把内容挪到了指针底下，而悬停
    // 目标按旧内容解析的，需要在出帧（命中区已按新位置重注册）之后
    // 重算一次。见 RefreshScrollHover。
    bool scrollHoverDirty;
    // 本应用要求的光栅器：RenderBackend.Cpu/Gpu/Auto。默认 CPU，见
    // SetRenderBackend。
    int renderBackendMode;
    int perfFrames;
    int perfRenderMs;
    int perfPresentMs;
    // 损伤裁剪帧单独记账：整窗帧和只重画一条损伤带的帧成本差一个
    // 数量级，混在一个平均值里两个目标（整窗 ≤8ms、局部 ≤2ms）都看
    // 不出来。partial=0 而循环一直在转，就说明有人在用整窗帧做轮询。
    int perfPartFrames;
    int perfPartRenderMs;
    int perfPartPresentMs;
    // 本批里最慢的一帧（渲染 + 呈现）。平均值会把偶发的长帧摊掉，
    // 而卡顿是被最慢的那一帧决定的。
    int perfWorstMs;
    // 本批里超过一个 60Hz 帧预算（16.7ms，取整为 >16）的帧数。worst_ms
    // 只记最慢的一帧，一批里掉了 1 帧还是 12 帧它给出同一个数字，而
    // 手感上的"一卡一卡"正是掉帧的密度。
    int perfSlowFrames;
    // 上一帧结束时的样式解析计数，用来给单帧算差值。
    int perfStyleAt;
    int perfStyleMissAt;
    // 同理，上一帧结束时的光栅像素计数（不透明填充 / 混合填充 /
    // 模糊 / 字形 / 快照），只用于给超预算的单帧开单。
    int perfPxFillAt;
    int perfPxBlendAt;
    int perfPxBlurAt;
    int perfPxGlyphAt;
    int perfPxSnapAt;
    // 帧内分相位（微秒）：背景恢复 / 测量 / 排版 / 画树。整帧就几
    // 毫秒，按毫秒取整时每个相位都被截成 0 或 1，所以这里用微秒；
    // phaseAtUs 是上一个标记点。前四个是本帧的，后四个是本批的总和。
    int phaseAtUs;
    int phaseBgUs;
    int phaseMeasUs;
    int phaseArrUs;
    int phaseTreeUs;
    // 本帧最贵的那个即时模式 id 段（宿主拿它分隔各大区域）。
    int scopeId;
    int scopeAtUs;
    int scopeEndUs;
    int scopeEndId;
    string phaseSecTop;
    int phaseSecTopUs;
    // 宿主自己埋的标记点之间的分段：本帧最贵的那一段。
    int markAtUs;
    string phaseMarkTop;
    int phaseMarkTopUs;
    // 本帧走到哪个标记点了，以及本帧第一次整窗重绘请求是在哪一段
    // 发出的（"ev" = 事件处理期间）：整窗重绘帧的开销是脏区帧的
    // 十几倍，所以要能指名道姓地问「这一帧凭什么整窗重画」。
    string markNow;
    string redrawWhy;
    int redrawCount;
    // 上面两个是「攒给下一帧」的：请求多半发生在上一帧渲染期间
    // （即时模式控件在画的时候要求跟一帧）。BeginFrame 把它们
    // 交接成本帧的理由，本帧结束时才归账。
    string frameWhy;
    int frameWhyN;
    // 本批里每个整窗重绘理由各出现了多少帧。
    List<WhyTally> fullWhy;
    // 本帧自身绘制最贵的那个节点（类型#名字）与它的微秒数。
    string phaseTopNode;
    int phaseTopUs;
    int perfBgUs;
    int perfMeasUs;
    int perfArrUs;
    int perfTreeUs;
    int perfBeginMs;
    int perfFxMs;
    int perfOverlayMs;
    int lastPresentMs;
    // 上一*整窗*帧的提交时刻：条带帧不计。特效快照的突发跳过判据
    // 以它为准——条带帧期间快照靠条带回写保鲜（见 PresentFrame），
    // 只有整帧连发（滚动/拖拽风暴）才让快照注定白做。
    int lastFullFrameMs;
    // 空闲循环采样（同一个开关）：不画帧也在烧 CPU 的那份活只能
    // 在这里看见——每 2 秒记一行「循环转了多少圈、走的哪条等待
    // 路径、醒来是因为哪种事件」。帧数为 0 却有几百圈循环就是空转，
    // 一圈都没转则说明 CPU 花在别的线程上。
    int perfLoopAt;
    int perfLoops;
    int perfPollPath;
    int perfAnimPath;
    int perfWaitPath;
    int perfEvNone;
    int perfEvMove;
    int perfEvOther;
    int perfLoopMs;
    int perfFxTicks;
    int perfFxOnlyTicks;
    int perfFxTickMs;
    int perfFxTickUs;
    int perfFxRestoreUs;
    int perfFxRenderUs;
    int perfFxPresentUs;
    // 最后一次收到真实输入（鼠标/键盘/滚轮/缩放）的墙钟毫秒。
    // 环境特效以此选择活动/空闲间隔；失焦但可见的窗口仍继续动画。
    int lastInputMs;
    // 上一次被记作输入的指针位置：Windows 会在窗口重绘/焦点变化后
    // 补发坐标未变的 WM_MOUSEMOVE，若把它们也算成输入，久无人操作
    // 的窗口每隔十几秒就被「唤醒」一次，心跳降速永远不生效。
    int lastInX;
    int lastInY;
    // 墙钟截止时间（毫秒），*节流*动画希望在此刻进行下一次
    // 重绘，若无待处理则返回 -1。循环动画（例如加载
    // 转圈动画）通过 RequestAnimationFrame 在此注册，而不是
    // RequestRedraw，这样事件循环在帧间休眠，并以低频
    // 重绘它们，而不是以 60fps 忙碌地渲染整个页面。
    int animNextMs;
    int wakeNextMs;
    int wakeFrameNextMs;
    // 本帧登记的动画所声明的像素范围（并集）。animRectAll 表示
    // 至少有一个动画没有声明范围，于是由动画唤醒的下一帧仍整窗重绘。
    bool animRectValid;
    bool animRectAll;
    // 自上一帧以来收到过需要重绘的真实输入事件（按下/释放/按键/滚轮）。
    // 这类事件改变哪些像素只有控件自己在渲染中读到 Ui.Clicked/焦点
    // 之后才知道，控件不可能提前声明；裁剪到动画声明范围的帧又只
    // 渲染条带内的控件——点击目标不在条带里就既读不到点击也画不出
    // 状态，直到某次偶然覆盖它的帧（表现为点击迟钝甚至丢失）。所以
    // 输入帧必须整帧：partialPending 只允许纯动画/唤醒帧设置。
    // 滚轮入列的原因不同：滚轮同样在渲染期才被消费（CaptureWheel
    // 仲裁），但它的损伤条带按「谁先声明」累计——连续滚动时上一帧
    // 的条带只盖住上一帧的位移量，本帧多滚出的那一段沿用陈旧像素
    // （概率性花屏 + 滚动条与内容短暂错位，感知为滚动条回跳）。
    bool inputNeedsFrame;
    int animRX;
    int animRY;
    int animRW;
    int animRH;
    // 上一次动画帧实际重绘的那块（裁剪用的并集）。声明范围的动画
    // 报的是它*这一帧*占的像素，而移动的动画（转圈里的球、滑动的
    // 标签下划线、缓动中的面板）下一帧就画到别处去了：只按新范围
    // 裁剪，旧位置的那几个像素既不重画也不上传，于是沿路径留下一
    // 串亮块，直到某次整窗重绘才擦掉。裁剪要取「上一帧画过的」和
    // 「这一帧要画的」的并集。
    bool animPrevValid;
    int animPX;
    int animPY;
    int animPW;
    int animPH;

    // 当前帧处理了真实操作系统事件（输入、缩放、
    // 等）时为 true。纯动画重绘（转圈、缓动步进）在没有
    // 事件时唤醒，使玻璃后面的背景保持不变，从而其模糊/壁纸
    // 可以从缓存提供。参见 BackdropDirty()。
    bool backdropDirty;

    // 匿名玻璃表面的逐帧序号（按绘制顺序编身份）。
    // 在 BeginFrame 中重置；由 NextBlurSlot() 递增。
    int blurSlotSeq;

    // 模糊缓存槽的常驻分配表：blurSlotKey[i] 是占用第 i 槽的
    // 元素身份（0=空槽），blurSlotUse[i] 是它最后被用到的帧号。
    // 槽位过去按绘制顺序逐帧发放，于是某一帧多画/少画一个玻璃
    // 面板，它后面所有面板都会平移一格，各自捡到别人的缓存——
    // 几何不符 => 全部重新模糊。改为按身份查表后，同一元素每帧
    // 拿回同一槽，与绘制顺序和邻居的出现/消失无关；表满时淘汰
    // 最久未用的槽。
    List<int> blurSlotKey;
    List<int> blurSlotUse;
    // blurSlotNew[i] 是第 i 槽最后一次换手（分配给新身份）的帧号：
    // 换手的槽里是别的元素的像素，本帧必须当作脏区重算一次（几何
    // 恰好相同时运行时的几何校验发现不了）。
    List<int> blurSlotNew;

    // 壁纸背景缓存失效。渐变 + 柔和色块
    // 是静态的：它们只取决于窗口大小和当前皮肤，而不取决于
    // 内容/滚动/输入。bgThemeGen 在每次主题变更时递增；
    // 背景快照记录其绘制时的 gen（bgSnapGen），因此它
    // 每帧都用廉价的像素拷贝恢复（不只是非脏帧），
    // 直到尺寸或皮肤真正改变。每当脏帧时重绘约 80 个大型
    // 羽化色块正是导致玻璃/渐变皮肤在滚动或输入时
    // 卡顿的原因。
    int bgThemeGen;
    int bgSnapGen;

    // 主题度量（字号/高度/内边距/圆角……）当前被临时缩放到的千分比：
    // 1000 = 主题原始度量。设计器渲染真控件预览时按画布缩放整体改写
    // 主题度量（见 Designer.BeginCtrlZoom），解析出来的样式随之不同，
    // 因此样式缓存（Style.cache / Style.baseSheet / Control.computedStyle）
    // 必须把它算进键里。它不是“代次”而是“状态”：在缩放与原始度量之间
    // 来回切换时两份缓存并存，不像递增 bgThemeGen 那样每个控件都把
    // 整张表连 base.css 的解析结果一起作废。
    int metricsScale;

    // 用户壁纸：绘制在皮肤自身背景之上的图像文件，按
    // bgImageOpacity 百分比淡入（100 = 仅显示照片，更低 =
    // 更多皮肤颜色）。空路径 = 无壁纸。属于背景
    // 快照的一部分，因此缩放绘制只在皮肤/尺寸/壁纸变化时发生。
    string bgImagePath;
    int bgImageOpacity;
    // 用户自己的壁纸，与当前皮肤包的插画不同：
    // 只有在此为空时，皮肤包的插画才填充背景；
    // 皮肤切换永远不会替换它。由应用持久化，因此用户选择的
    // 背景在皮肤切换和重启后都得以保留。
    string userWallpaperPath;
    int userWallpaperOpacity;
    // 当外观抽屉请求壁纸文件时置位。拥有
    // 文件选择器的主机会消费该请求（ConsumeWallpaperPick）并以所选路径
    // 调用 SetWallpaper；没有文件选择器的窗口忽略它。
    bool bgImagePickWanted;

    // 动态背景效果（Theme.fx / Gui.BackdropFx）。默认开启；
    // SetBackdropFx(false) 会关闭窗口的皮肤动态效果。当当前
    // 皮肤带有效果时，RenderBackground 将其叠加在静态
    // 壁纸快照之上，并重新装备一个节流动画帧。
    bool fxEnabled;

    // 动态背景快速路径。效果层在 PresentFrame 中被合成到
    // 完成帧的顶部，同时在不带效果的情况下快照该帧
    // （槽位 7）。这样一次纯效果跳动只需
    // 一次全帧恢复 + 几十次小型填充 + 提交 —— 无需
    // 控件重渲染，也无需玻璃重新模糊。fxNextMs 是下一次跳动的截止时间（-1 =
    // 无）；fxSnapValid 表示槽位 7 保存着当前帧。
    int fxNextMs;
    bool fxSnapValid;
    // 上一次整窗合成特效所用的时间点：损伤裁剪帧以同一
    // 相位重新合成，使重绘的条带与周围的背景动画对齐。
    int fxFrameMs;

    // ---- 脏区裁剪（部分）帧 ------------------------------------
    // 纯悬停移动只会改变指针离开的控件和它进入的
    // 控件，但过去它会重绘（并重新混合）整个窗口。当
    // 没有其他变化时，下一帧被裁剪到这两个
    // 控件矩形的并集：每个控件仍会运行，但绘制被裁剪掉，
    // 因此成本降到脏区条带，Present 只上传这些部分。
    bool partialPending;
    bool partialFrame;
    // 本帧出现了未声明范围的重绘请求（RequestRedraw）：下一帧
    // 整窗重绘，声明过范围的损伤区不再生效。
    bool partialBlocked;
    // 下一帧必须是整窗帧（不得裁剪）。上一帧结束时发现屏上的像素
    // 不再可信时置位（玻璃面板跨出损伤条带，模糊只能拿旧缓存充数）。
    // partialBlocked 拦不住它：那个标志在下一次 BeginFrame 开头就被清掉，
    // 而局部帧是在 BeginFrame 之前的事件处理里武装的，于是一边移鼠标一
    // 边就把「下一帧整窗重绘」吃掉了，不一致的像素就一直挂在屏上。
    // 这个标志跨帧留存，只在真正画出一帧整窗帧时才消。
    bool forceFullNext;
    int dmgX;
    int dmgY;
    int dmgW;
    int dmgH;
    // 本帧 PushClip 时锁定的上传矩形。dmg 在渲染期间还可能增长
    // （渲染中的 NoteDamage、PresentFrame 的 WidenDamageToGlass），
    // 但那些区域本帧没渲染过，画布上是上一帧的旧像素——上传它们
    // 就是拖影。PresentDirty 只许用这里锁定的值。
    int presentX;
    int presentY;
    int presentW;
    int presentH;
    // 本帧画过的玻璃面板矩形（x,y,w,h 四元组，NoteGlassRect 记录，
    // BeginFrame 清空）。损伤条带跨出某块玻璃时（模糊只能拿条带外
    // 的旧合成像素充数），下一帧把裁剪扩到相交面板的并集：模糊从
    // 一整块本帧新画的背景重算，比整窗重绘便宜一个量级。
    List<int> glassRects;
    // 滚动串里玻璃模糊的延迟刷新：最近一次滚动损伤的截止时刻
    // （nowMs < 它 = 串还在进行）、本帧是否有面板暂用了旧模糊、
    // 是否欠着一帧扩展刷新、欠账面板矩形与武装刷新的帧号。
    // 见 BackdropDirtyIn / NoteScrollDamage / EndFrame 的还账块。
    int scrollBusyUntilMs;
    bool glassDeferred;
    bool glassRefreshOwe;
    int glassRefreshArmedAt;
    List<int> glassDeferredRects;
    // 损伤裁剪帧玻璃模糊连续 miss 的帧数。扩裁剪（widen）重算过
    // 的帧若仍报 miss，说明模糊核的采样边缘超出了任何条带，widen
    // 救不回来——按 g_blur_partial_miss 的契约升级整窗帧，否则
    // 滚动串里每一帧都在欠账，整帧永远排不上。
    int blurMissStreak;
    // 效果层在最后一次合成帧中触及的像素矩形（x,y,w,h 四边形）
    // 下一次效果跳动只从
    // 槽位 7 的快照修复这些区域，而不是恢复整个帧。null = 未知
    // （修复会回退为一次全帧恢复）。
    List<int> fxDamage;

    // 自快照以来效果层触及过的全部矩形的累计（并集清单）。效果
    // 跳动只修复"上一拍"的矩形是不够的：光斑在移动，更早各拍
    // 画下的像素若不被修复，就会作为幽灵残留在画布和屏幕上
    // （大光斑皮肤下是一团越积越亮的色块）。每次纯效果跳动把
    // 新损伤并入这份清单，修复与上传都以它为准；累计面积超过
    // 半窗或矩形过多时退回全帧恢复（fxTouchedFull）。
    List<int> fxTouched;
    bool fxTouchedFull;

    App(string title, int width, int height) {
        this.window = new Window(title, width, height);
        this.designW = width;
        this.designH = height;
        this.theme = Theme.Light();
        this.focus = new FocusManager();
        this.hitTester = new HitTester();
        this.isRunning = true;
        this.needsRedraw = true;
        this.pollPending = false;
        this.frameBody = null;
        this.frameErrors = 0;
        this.lastFrameError = "";
        this.frameCount = 0;
        this.mouseX = 0;
        this.mouseY = 0;
        this.scrollY = 0;
        this.contentHeight = 0;
        this.scrollSpeed = 40;
        this.dpiScale = 100;
        this.titlebarH = 32;
        this.captionBtnW = 46;
        this.splitX = 0;
        this.sidebarScrollY = 0;
        this.sidebarContentHeight = 0;
        this.wheelCapX = 0;
        this.wheelCapY = 0;
        this.wheelCapW = 0;
        this.wheelCapH = 0;
        this.wheelClaimSeq = 0;
        this.wheelCapOrder = 0;
        this.wheelOwnerOrder = 0;
        this.tabHoldId = -1;
        this.blocksInputBelow = false;
        this.inputBlockPrevious = false;
        this.menuBlock = false;
        this.menuBlockPrevious = false;
        this.clickTargetId = -1;
        this.pressTargetId = -1;
        this.pointerDown = false;
        this.frameSeq = 0;
        this.clickSeenSeq = 0 - 1;
        this.clickEvSeq = 0 - 1;
        this.rightClickTargetId = -1;
        this.rightPressTargetId = -1;
        this.lastClickId = -1;
        this.lastClickMs = 0;
        this.doubleClickNow = false;
        this.pressStartX = 0;
        this.pressStartY = 0;
        this.pressStartMs = 0;
        this.pressStartId = -1;
        this.longPressFired = false;
        this.swipeDir = 0;
        this.overlays = new List<OverlayPopup>();
        this.nativeLayers = new List<NativeLayerReq>();
        this.nativeOccluders = new List<int>();
        this.hitOnlyBlockers = new List<int>();
        this.lastResizeBg = 0 - 1;
        this.isDark = false;
        this.isTopmost = false;
        this.shapeMode = 0;
        this.shapeRadius = 0;
        this.shapeSpec = "";
        this.windowResizable = true;
        this.showChrome = true;
        this.chromeStatus = "";
        this.chromeAccent = "";
        this.showThemeButton = true;
        #if ANDROID
        // 手机上固顶/最小化/最大化没有意义（窗口恒为全屏表面，
        // 最小化/退出由系统手势与返回键承担）；标题栏只留皮肤按钮，
        // 关闭键同样隐藏——AC_BACK 已经是应用可感的退出通道。
        this.showPinButton = false;
        this.showMinimizeButton = false;
        this.showMaximizeButton = false;
        this.showCloseButton = false;
        #else
        this.showPinButton = true;
        this.showMinimizeButton = true;
        this.showMaximizeButton = true;
        this.showCloseButton = true;
        #endif
        this.capTipId = 0;
        this.capTipX = 0;
        this.themeTipText = "主题";
        this.pinTipText = "置顶";
        this.minimizeTipText = "最小化";
        this.maximizeTipText = "最大化";
        this.restoreTipText = "还原";
        this.closeTipText = "关闭";
        this.themeNames = new List<string>();
        this.themeMenuModel = new SignalInt(0);
        this.themeMenuOpen = new SignalBool(false);
        this.themeMenuScroll = new SignalInt(0);
        this.themeMenuBaseId = 0;
        this.themeMenuChange = new UiEvent();
        this.fxKindOverride = 0 - 1;
        this.accentOverride = 0;
        this.themeDrawerTab = new SignalInt(0);
        this.density = 1;
        this.densityBase = null;
        this.hasSkinDensity = false;
        this.autoSkins = false;
        this.appliedSkin = -1;
        this.skinPacks = new List<string>();
        this.skinArt = "";
        this.skinArtOpacity = 100;
        this.sheet = new StyleSheet();
        this.appCss = "";
        this.skinName = "";
        this.anims = new List<AnimSlot>();
        this.nowMs = Window.GetTickMs();
        this.lastFrameMs = this.nowMs;
        this.freezeAnimClock = false;
        this.perfFrames = 0;
        this.perfRenderMs = 0;
        this.perfPresentMs = 0;
        this.perfPartFrames = 0;
        this.perfPartRenderMs = 0;
        this.perfPartPresentMs = 0;
        this.perfWorstMs = 0;
        this.perfSlowFrames = 0;
        this.perfStyleAt = 0;
        this.perfStyleMissAt = 0;
        this.perfPxFillAt = 0;
        this.perfPxBlendAt = 0;
        this.perfPxBlurAt = 0;
        this.perfPxGlyphAt = 0;
        this.perfPxSnapAt = 0;
        this.phaseAtUs = 0;
        this.phaseBgUs = 0;
        this.phaseMeasUs = 0;
        this.phaseArrUs = 0;
        this.phaseTreeUs = 0;
        this.phaseTopNode = "";
        this.phaseTopUs = 0;
        this.scopeId = 0;
        this.scopeAtUs = 0;
        this.scopeEndUs = 0;
        this.scopeEndId = 0;
        this.markAtUs = 0;
        this.markNow = "";
        this.redrawWhy = "";
        this.redrawCount = 0;
        this.frameWhy = "";
        this.frameWhyN = 0;
        this.fullWhy = new List<WhyTally>();
        this.glassRects = new List<int>();
        this.glassDeferredRects = new List<int>();
        this.glassRefreshArmedAt = 0 - 1;
        this.phaseMarkTop = "";
        this.phaseMarkTopUs = 0;
        this.phaseSecTop = "";
        this.phaseSecTopUs = 0;
        this.perfBgUs = 0;
        this.perfMeasUs = 0;
        this.perfArrUs = 0;
        this.perfTreeUs = 0;
        this.perfBeginMs = 0;
        this.lastPresentMs = 0;
        this.lastFullFrameMs = 0;
        this.perfLoopAt = 0;
        this.perfLoops = 0;
        this.perfPollPath = 0;
        this.perfAnimPath = 0;
        this.perfWaitPath = 0;
        this.perfEvNone = 0;
        this.perfEvMove = 0;
        this.perfEvOther = 0;
        this.perfLoopMs = 0;
        this.perfFxTicks = 0;
        this.perfFxOnlyTicks = 0;
        this.perfFxTickMs = 0;
        this.perfFxTickUs = 0;
        this.perfFxRestoreUs = 0;
        this.perfFxRenderUs = 0;
        this.perfFxPresentUs = 0;
        this.lastInputMs = this.nowMs;
        this.lastInX = -1;
        this.lastInY = -1;
        this.animNextMs = -1;
        this.wakeNextMs = -1;
        this.wakeFrameNextMs = -1;
        this.animRectValid = false;
        this.animRectAll = false;
        this.inputNeedsFrame = false;
        this.animRW = 0;
        this.animRH = 0;
        this.animPrevValid = false;
        this.animPW = 0;
        this.animPH = 0;
        this.fxEnabled = true;
        this.fxNextMs = -1;
        this.fxSnapValid = false;
        this.partialPending = false;
        this.partialFrame = false;
        this.partialBlocked = false;
        this.forceFullNext = false;
        this.partialFrames = false;
        this.scrollHoverDirty = false;
        this.renderBackendMode = RenderBackend.Cpu();
        this.dmgW = 0;
        this.dmgH = 0;
        this.fxDamage = null;
        this.fxTouched = null;
        this.fxTouchedFull = false;
        this.backdropDirty = true;
        this.blurSlotSeq = 0;
        this.blurSlotKey = new List<int>();
        this.blurSlotUse = new List<int>();
        this.blurSlotNew = new List<int>();
        int bs = 0;
        while (bs < 64) {
            this.blurSlotKey.Add(0);
            this.blurSlotUse.Add(0);
            this.blurSlotNew.Add(-1);
            bs = bs + 1;
        }
        // gen != snapGen 时壁纸只绘制（并快照）一次，
        // 之后从缓存恢复，直到皮肤/尺寸变化。
        this.bgThemeGen = 1;
        this.bgSnapGen = 0;
        this.metricsScale = 1000;
        this.bgImagePath = "";
        this.bgImageOpacity = 100;
        this.userWallpaperPath = "";
        this.userWallpaperOpacity = 100;
        this.bgImagePickWanted = false;
        this.canvas = new Canvas(width, height);
        // 预先（在 UI 线程上）重置 UI 线程分派队列，使
        // 任何后台工作线程一产生，App.Post 就安全可用。
        Dispatcher.Init();
        // 每个窗口默认在标题栏获得内置皮肤选择器
        // （浅色窗口 -> 预选"Light"）。id 块
        // 现在分配，早于任何应用的 WidgetId.Mark，使选项 id 保持
        // 稳定。持久化过皮肤的应用只需调用 EnableSkins(index)。
        this.EnableSkins(1);
    }

    static App CreateDark(string title, int width, int height) {
        App app = new App(title, width, height);
        app.theme = Theme.Dark();
        app.isDark = true;
        app.EnableSkins(0);
        return app;
    }

    /// 切换当前主题（浅色/深色）并重新应用 DPI 缩放。
    void SetDark(bool dark) {
        isDark = dark;
        if (dark) { theme = Theme.Dark(); } else { theme = Theme.Light(); }
        this.ScaleThemeMetrics();
        this.NoteRedrawWhy("SetDark");
        needsRedraw = true;
    }

    /// 安装任意主题预设（重新应用 DPI 缩放）。`dark`
    /// 控制适合深色模式的边框细节（标题悬停水色等）。
    void ApplyTheme(Theme t, bool dark) {
        isDark = dark;
        theme = t;
        this.ScaleThemeMetrics();
        // 磨砂玻璃在应用内渲染：在主题壁纸上做软件模糊，
        // 窗口本身不透明。曾尝试原生 OS 亚克力（分层）窗口，
        // 但它改变了外观，并使窗口自行改变大小
        // （UpdateLayeredWindow 驱动了窗口尺寸），因此玻璃皮肤
        // 在此保持软件渲染。若设置了分层样式则一律去除。
        if (glassNative) { window.DisableGlass(); }
        glassNative = false;
        this.ApplySurfaceTranslucency();
        bgThemeGen = bgThemeGen + 1;
        // 缓存的帧快照与玻璃模糊缓存仍保留
        // 上一皮肤的像素，效果帧从它们恢复——若保持有效，
        // 几次切换后会把旧皮肤混入新皮肤。
        fxSnapValid = false;
        fxDamage = null;
        fxTouched = null;
        fxTouchedFull = false;
        backdropDirty = true;
        this.NoteRedrawWhy("ApplyTheme");
        needsRedraw = true;
    }

    /// 把当前 theme 的度量重算为"基线 × 密度档 × DPI"。基线在换肤 /
    /// 换主题时快照（theme 实例是新建的），密度切换、DPI 变化从基线
    /// 重推——两档缩放叠加时不会互相污染，往返切换不累积舍入误差。
    /// 全部 metric 改写入口（SetDark / ApplyTheme / SetTheme / Show）
    /// 都走这里，取代散落的 ScaleByDpi 调用。
    void ScaleThemeMetrics() {
        if (density < 0) { density = 0; }
        if (density > 2) { density = 2; }
        if (theme == null) { return; }
        // 基线 = 当前主题的原始度量。theme 每次换肤/换主题都被
        // Skin/调用方重建，所以快照此刻的度量即为未缩放的基线；
        // 若 theme 被复用（理论上的调用方误用），快照取自
        // densityBase 仍成立——只在基线缺失时重新记录。
        if (densityBase == null || densityBase.Count < 24) {
            densityBase = theme.SnapshotMetrics();
            if (density == 1) { theme.ScaleByDpi(dpiScale); return; }
        }
        theme.ApplyDensityScaled(densityBase, density);
        theme.ScaleByDpi(dpiScale);
    }

    /// 全局密度档：0 小（紧凑）/ 1 中（默认）/ 2 大（宽松）。整体
    /// 缩放字号/控件高度/内边距/间距/图标/圆角——与换肤、DPI 正交，
    /// 切换后样式缓存按代次作废，下一帧全部控件按新度量重排。
    void SetDensity(int d) {
        if (d < 0) { d = 0; }
        if (d > 2) { d = 2; }
        if (d == density) { return; }
        density = d;
        if (densityBase == null && theme != null) {
            densityBase = theme.SnapshotMetrics();
        }
        this.ScaleThemeMetrics();
        // 度量进了样式缓存键（dpiScale/metricsScale 桶），但 RootFromTheme
        // 导出的 :root token 是 base.css 解析时的输入，必须整代作废。
        bgThemeGen = bgThemeGen + 1;
        backdropDirty = true;
        this.NoteRedrawWhy("SetDensity");
        needsRedraw = true;
    }

    /// 当前密度档（0/1/2，见 SetDensity）。
    int Density() { return density; }

    /// 当前密度档的显示名（"Small"/"Medium"/"Large"）。
    string DensityLabel() { return Theme.DensityName(density); }

    /// 加载皮肤包 `name`（`skins/<name>/skin.css` + 美术资源文件夹）
    /// 并应用其令牌、样式表与插图。当
    /// 找不到皮肤包时返回 false，保持当前外观不变。
    bool UseSkin(string name) {
        Skin s = Skin.Load(name);
        if (!s.IsLoaded()) { return false; }
        s.Apply(this);
        this.ApplyAppCss();
        return true;
    }

    /// 从磁盘重新读取当前皮肤的 CSS（皮肤热编辑）。
    bool ReloadSkin() {
        if (skinName == "") { return false; }
        Skin s = Skin.Reload(skinName);
        if (!s.IsLoaded()) { return false; }
        s.Apply(this);
        this.ApplyAppCss();
        return true;
    }

    /// 安装应用自身的样式表：用于页面布局
    /// （`display: flex`、宽度、间距）并样式化自有元素类的 CSS。
    /// 与 UseCss 不同，它不随皮肤切换而失效——它会重新叠加到每个
    /// 皮肤的样式表之上，应用未指定的内容仍以皮肤外观为准。
    void UseAppCss(string css) {
        appCss = css;
        this.ApplyAppCss();
        bgThemeGen = bgThemeGen + 1;
        backdropDirty = true;
        this.NoteRedrawWhy("UseAppCss");
        needsRedraw = true;
    }

    /// 将应用样式表重新叠加到当前皮肤的样式表之上。
    void ApplyAppCss() {
        if (appCss == "") { return; }
        if (sheet == null) { sheet = new StyleSheet(); }
        // 应用 CSS 认得当前主题 token 与皮肤的 :root 变量：写
        // `color: var(--text-primary)` 的应用样式表跟着皮肤走，而不是
        // 展开成空值（var() 过去只在同一份源文本内查找）。这些外来
        // 变量只用于展开，不写进 sheet.vars——那份表代表皮肤自己声明
        // 了什么（Skin.ThemeOf 按它推导主题）。
        List<string> vn = new List<string>();
        List<string> vv = new List<string>();
        Css.CollectVars(Style.RootFromTheme(theme), vn, vv);
        if (sheet.vars != null) {
            for (int i = 0; i < sheet.vars.Count(); i = i + 1) {
                vn.Add(sheet.vars.KeyAt(i));
                vv.Add(sheet.vars.ValAt(i).AsString(""));
            }
        }
        sheet.MergeSheet(Css.ParseWith(appCss, vn, vv));
    }

    /// 直接安装样式表（应用内编写的 CSS 文本，或以
    /// 资源形式提供的 CSS），无需皮肤文件夹。
    void UseCss(string css) {
        sheet = StyleSheet.FromCss(css);
        this.ApplyAppCss();
        bgThemeGen = bgThemeGen + 1;
        fxSnapValid = false;
        fxDamage = null;
        fxTouched = null;
        fxTouchedFull = false;
        backdropDirty = true;
        this.NoteRedrawWhy("UseCss");
        needsRedraw = true;
    }

    /// 交给 OS 玻璃合成器的打包 ARGB 着色：当前皮肤的
    /// 主背景色，alpha 约 59%，使模糊的桌面既保留
    /// 色彩与实体感，又保证文字可读。
    int GlassTint() {
        return theme.GlassTint();
    }

    /// 将标题栏主题按钮变为皮肤选择器（列出磁盘上找到的
    /// 所有 `Skin.Names` 皮肤包），并由 App 自行应用所选皮肤——
    /// 无需各应用的处理函数或 switch 语句。每个窗口默认
    /// 启用此功能（见 Create）；再次调用可预选持久化的皮肤。
    /// `index` 必须是主题已激活的皮肤，使首帧
    /// 不会重复应用。幂等：稳定 id 块只分配一次。
    void EnableSkins(int index) {
        autoSkins = true;
        // 皮肤即数据：`stdlib/Gui/skins`、`./skins` 或 $ZAN_GUI_SKINS，每个
        // 是含设计令牌 skin.css（以及可选规则/美术）的文件夹。
        skinPacks = Skin.Names();
        themeNames = Skin.Labels(skinPacks);
        if (themeMenuBaseId == 0) {
            themeMenuBaseId = WidgetId.Block(themeNames.Count + 40);
        }
        themeMenuModel.Set(index);
        appliedSkin = index;
        showThemeButton = true;
        window.SetCaptionButtons(ChromeButtonCount());
        this.NoteRedrawWhy("EnableSkins");
        needsRedraw = true;
    }

    void EnableSkins() { this.EnableSkins(0); }

    /// 选择器提供的皮肤数量。
    int SkinCount() { return skinPacks.Count; }

    /// 皮肤 `i` 的名称（越界时为 ""）。
    string SkinNameAt(int i) {
        if (i < 0 || i >= skinPacks.Count) { return ""; }
        return skinPacks[i];
    }

    /// 名为 `name` 的皮肤包的索引，无匹配时为 -1。按名称
    /// （而非索引）查找，使持久化设置能经受皮肤新增或
    /// 移除导致的索引变动。
    int SkinIndexOf(string name) {
        if (name == "") { return 0 - 1; }
        for (int i = 0; i < skinPacks.Count; i = i + 1) {
            if (skinPacks[i] == name) { return i; }
        }
        return 0 - 1;
    }

    /// 应用名为 `name` 的皮肤包；当它
    /// 未安装时保持当前外观不变（例如配置针对旧皮肤列表编写）。
    void ApplySkinName(string name) {
        int i = this.SkinIndexOf(name);
        if (i >= 0) { this.ApplySkin(i); }
    }

    /// 皮肤 `i` 安装的 Theme——用于选择器预览，使
    /// 每张卡片显示各自的调色板。
    Theme SkinThemeAt(int i) {
        Skin s = Skin.Load(this.SkinNameAt(i));
        if (s.IsLoaded()) {
            Theme pt = s.NewTheme();
            if (pt != null) { return pt; }
        }
        return Theme.Dark();
    }

    /// 应用皮肤 `i`（令牌 + 样式表 + 美术）并将其记录为
    /// 当前皮肤，使选择器保持同步。
    void ApplySkin(int i) {
        if (!this.UseSkin(this.SkinNameAt(i))) { return; }
        if (accentOverride != 0) {
            theme.ApplyAccent(accentOverride);
        }
        themeMenuModel.Set(i);
        appliedSkin = i;
        // 换肤重建了 theme：密度档立即套到新调色板上（ScaleThemeMetrics
        // 已在 ApplyTheme 里跑过，但那是用"皮肤尚未带 --density"的旧档；
        // 皮肤 token 允许逐包改档，这里按当前皮肤再校准一次）。
        this.SyncSkinDensity();
    }

    /// 皮肤包可通过 `--density: small|medium|large` 声明默认密度档。
    /// 未声明时返回 -1（保持用户当前选择）。
    int SkinDensity() {
        if (sheet == null) { return 0 - 1; }
        return Skin.DensityOf(sheet);
    }

    /// 换肤后校准密度：皮肤声明了 `--density` 则跟随皮肤并记住
    /// "皮肤说了算"，否则维持用户此前选择的档位。
    void SyncSkinDensity() {
        int sd = this.SkinDensity();
        if (sd < 0) { hasSkinDensity = false; return; }
        hasSkinDensity = true;
        if (sd == density) { return; }
        density = sd;
        if (densityBase != null && densityBase.Count >= 24 && theme != null) {
            theme.ApplyDensityScaled(densityBase, density);
            theme.ScaleByDpi(dpiScale);
            bgThemeGen = bgThemeGen + 1;
            backdropDirty = true;
            this.NoteRedrawWhy("SyncSkinDensity");
            needsRedraw = true;
        }
    }

    /// 当内置皮肤选择器的选中项变化（用户选择）时应用它。
    /// 每帧开始时调用，使内容与边框一起重绘。
    void SyncSkin() {
        if (autoSkins && themeMenuModel.Get() != appliedSkin) {
            this.ApplySkin(themeMenuModel.Get());
            // 委托事件：通知监听者（例如应用可将
            // 新皮肤传播给其子窗口），在皮肤应用之后触发。
            themeMenuChange.Raise();
        }
    }

    /// 整窗不透明度百分比（10..100）；100 = 不透明。转发给
    /// OS 合成器，使控件/文本随窗口整体淡出。
    void SetWindowOpacity(int percent) {
        if (percent < 10) { percent = 10; }
        if (percent > 100) { percent = 100; }
        windowOpacity = percent;
        window.SetOpacity(percent);
    }

    /// 用户能否改变窗口大小。关闭后边框不再充当尺寸手柄、
    /// 双击标题栏不再最大化，标题栏也不再显示最大化按钮
    /// （一个点了没反应的按钮比没有更糟）。
    void SetResizable(bool on) {
        windowResizable = on;
        window.SetResizable(on);
        if (!on && showMaximizeButton) {
            this.SetChromeButtons(showThemeButton, showPinButton,
                showMinimizeButton, false);
        }
        this.NoteRedrawWhy("SetResizable");
        needsRedraw = true;
    }

    /// 见 SetResizable。
    bool Resizable() { return windowResizable; }

    /// 最近一次通过 SetWindowOpacity 设置的不透明度（未设置时为 100）。
    int WindowOpacity() {
        if (windowOpacity <= 0) { return 100; }
        return windowOpacity;
    }

    /// 窗口轮廓为各形状区域的并集。`spec` 为
    /// 逻辑像素下的 "t,x,y,w,h,r;t,x,y,w,h,r;..."：类型 1 = 圆角矩形
    /// （r = 圆角半径），类型 2 = 椭圆（w/h = 包围盒）。"" 恢复
    /// 为普通不透明矩形。多个区域并集为一个轮廓，
    /// 例如一个大圆角卡片上凸出一个圆形。在 Windows 上与
    /// 逐像素 alpha 组合（无 DWM 时回退为区域，仍兼容 Win7）；
    /// 所有区域之外的区域对绘制和点击都透明。
    /// 与原生玻璃互斥。在 Run 之前调用。
    void SetWindowShape(string spec) {
        shapeSpec = spec;
        this.ParseShapeSpec(spec);
        if (spec.Length == 0) {
            shapeMode = 0;
            shapeRadius = 0;
        } else {
            shapeMode = 1;
            shapeRadius = 0;
            // 暴露第一个区域的圆角半径，供 WindowShapeRadius() 使用。
            int c1 = spec.IndexOf(",");
            if (c1 > 0) {
                int c2 = spec.IndexOf(",", c1 + 1);
                if (c2 > 0) {
                    int c3 = spec.IndexOf(",", c2 + 1);
                    if (c3 > 0) {
                        int c4 = spec.IndexOf(",", c3 + 1);
                        if (c4 > 0) {
                            int c5 = spec.IndexOf(",", c4 + 1);
                            if (c5 > 0) {
                                shapeRadius = Convert.ToInt32(spec.Substring(c4 + 1, c5 - c4 - 1));
                            }
                        }
                    }
                }
            }
        }
        if (shapeMode != 0 && glassNative) {
            window.DisableGlass();
            glassNative = false;
        }
        window.SetShape(spec);
        this.NoteRedrawWhy("SetWindowShape");
        needsRedraw = true;
    }

    /// 围绕异形轮廓的柔和投影。`px` 是阴影的逻辑
    /// 扩展范围（0 禁用）。当形状规格尚未包含
    /// 阴影带时，会自动在开头追加一个覆盖形状包围盒向四周扩展 `px` 的
    /// 类型 3 区域，使 OS 表面延伸到
    /// 阴影像素之上，软件绘制的渐变永远不会
    /// 被裁剪。形状应从其包围盒向内缩进至少 `px`
    /// （例如 px 为 24 时的 "1,24,24,520,360,20"），使阴影带保持在屏幕上。
    /// 在 SetWindowShape 之后、Run 之前调用。
    void SetWindowShadow(int px) {
        if (px < 0) { px = 0; }
        shapeShadow = px;
        if (px > 0 && shapeMode != 0 && shapeSpec.Length > 0
                && !this.HasShadowBand()) {
            int minX = 2147483647;
            int minY = 2147483647;
            int maxX = 0 - 2147483647 - 1;
            int maxY = 0 - 2147483647 - 1;
            int i = 0;
            while (i + 5 < shapeRects.Count) {
                if (shapeRects[i] != 3) {
                    int x = shapeRects[i + 1];
                    int y = shapeRects[i + 2];
                    int x2 = x + shapeRects[i + 3];
                    int y2 = y + shapeRects[i + 4];
                    if (x < minX) { minX = x; }
                    if (y < minY) { minY = y; }
                    if (x2 > maxX) { maxX = x2; }
                    if (y2 > maxY) { maxY = y2; }
                }
                i = i + 6;
            }
            if (minX <= maxX && minY <= maxY) {
                string band = "3," + Convert.ToString(minX - px) + ","
                    + Convert.ToString(minY - px) + ","
                    + Convert.ToString(maxX - minX + px * 2) + ","
                    + Convert.ToString(maxY - minY + px * 2) + ",0";
                shapeSpec = band + ";" + shapeSpec;
                this.ParseShapeSpec(shapeSpec);
                window.SetShape(shapeSpec);
            }
        }
        this.NoteRedrawWhy("SetWindowShadow");
        needsRedraw = true;
    }

    /// 当形状规格已包含类型 3 阴影带区域时返回 true。
    bool HasShadowBand() {
        int i = 0;
        while (i + 5 < shapeRects.Count) {
            if (shapeRects[i] == 3) { return true; }
            i = i + 6;
        }
        return false;
    }

    /// 将形状规格解析为 shapeRects（由 SetWindowShape 与
    /// SetWindowShadow 自动前置的阴影带共用）。
    void ParseShapeSpec(string spec) {
        shapeRects = new List<int>();
        if (spec.Length > 0) {
            List<string> parts = spec.Split(";");
            for (int i = 0; i < parts.Count; i = i + 1) {
                List<string> nums = parts[i].Split(",");
                if (nums.Count >= 6) {
                    shapeRects.Add(Convert.ToInt32(nums[0]));
                    shapeRects.Add(Convert.ToInt32(nums[1]));
                    shapeRects.Add(Convert.ToInt32(nums[2]));
                    shapeRects.Add(Convert.ToInt32(nums[3]));
                    shapeRects.Add(Convert.ToInt32(nums[4]));
                    shapeRects.Add(Convert.ToInt32(nums[5]));
                }
            }
        }
    }

    /// 异形轮廓的阴影扩展范围（逻辑像素，0 = 无）。
    int WindowShadow() { return shapeShadow; }

    /// 当前窗口轮廓规格（见 SetWindowShape）；"" = 矩形。
    string WindowShapeSpec() { return shapeSpec; }

    /// 当前窗口轮廓（见 SetWindowShape）。
    int WindowShape() { return shapeMode; }

    /// 圆角矩形轮廓的圆角半径（见 SetWindowShape）。
    int WindowShapeRadius() { return shapeRadius; }

    /// 显示/隐藏自定义标题栏边框。隐藏时：OS 仍允许顶部
    /// TitlebarHeight() 高度的条带拖动窗口，内容从 y=0 开始。
    void SetChromeVisible(bool on) {
        showChrome = on;
        int n = 0;
        if (on) { n = ChromeButtonCount(); }
        window.SetCaptionButtons(n);
        this.NoteRedrawWhy("SetChromeVisible");
        needsRedraw = true;
    }

    /// 自定义标题栏边框可见时为 true。
    bool ChromeVisible() { return showChrome; }

    /// 标题栏上的动态信息：`text` 用常规文本色，`accent` 用强调色，
    /// 画在窗口标题之后。应用可按需每秒刷新（登录/授权、
    /// 平均耗时、内存占用等）。传空串即隐藏。
    void SetChromeStatus(string text, string accent) {
        if (chromeStatus == text && chromeAccent == accent) { return; }
        chromeStatus = text;
        chromeAccent = accent;
        this.RequestRedraw();
    }

    /// 当前标题栏状态文本（常规段）。
    string ChromeStatus() { return chromeStatus; }

    /// 当前标题栏状态文本（强调段）。
    string ChromeAccent() { return chromeAccent; }

    /// 同步操作系统窗口标题（任务栏/Alt-Tab 显示的文字）。
    /// 自绘标题栏上的文字由帧循环传入，见 Form.SetTitle。
    void SetWindowTitle(string text) { window.SetTitle(text); }

    /// 启用/禁用 OS 原生半透明玻璃（Win11 亚克力）：
    /// 窗口表面半透明处，桌面在窗口后方被模糊。
    /// 与软件渲染的磨砂玻璃
    /// 皮肤不同。与异形窗口互斥。
    void SetNativeGlass(bool on) {
        if (on) {
            if (shapeMode != 0) { this.SetWindowShape(""); }
            window.EnableGlass(this.GlassTint());
            glassNative = true;
        } else {
            window.DisableGlass();
            glassNative = false;
        }
        this.NoteRedrawWhy("SetNativeGlass");
        needsRedraw = true;
    }

    /// OS 原生半透明玻璃启用时为 true（见 SetNativeGlass）。
    bool NativeGlass() { return glassNative; }

    /// 工具窗口：细标题栏、任务栏/Alt-Tab 不显示。
    /// 适合调色板、对话框这类附属窗口。
    void SetToolWindow(bool on) {
        window.SetToolWindow(on);
    }

    /// 窗口是否为工具窗口（见 SetToolWindow）。
    bool ToolWindow() { return window.ToolWindow(); }

    // ---- 用户壁纸图片 ----------------------------------------------

    /// 将 `path`（PNG/BMP/JPG）绘制为该窗口的背景，按覆盖方式缩放，
    /// 并以 `opacity` 百分比（10..100）叠加在皮肤自身背景之上。
    /// 空路径清除它。皮肤包美术与用户壁纸都用它；
    /// 由皮肤层决定显示哪一个（见 SetUserWallpaper）。
    void SetWallpaper(string path, int opacity) {
        int op = opacity;
        if (op < 10) { op = 10; }
        if (op > 100) { op = 100; }
        if (bgImagePath != "" && bgImagePath != path) {
            Canvas.EvictImage(bgImagePath);
        }
        bgImagePath = path;
        bgImageOpacity = op;
        bgThemeGen = bgThemeGen + 1;
        fxSnapValid = false;
        this.NoteRedrawWhy("SetWallpaper");
        needsRedraw = true;
        theme.MakeSurfacesOpaque();
        this.ApplySurfaceTranslucency();
    }

    /// 用户自己的壁纸路径（"" = 无）——用户选择的图片，
    /// 区别于当前皮肤包的美术。切换皮肤不会改动它，
    /// 因此选定的背景在换肤后依然保留。
    string UserWallpaperPath() { return userWallpaperPath; }

    /// 用户壁纸设置时的不透明度（未设置时为 100）。
    int UserWallpaperOpacity() {
        if (userWallpaperOpacity <= 0) { return 100; }
        return userWallpaperOpacity;
    }

    /// 设置用户的壁纸：与皮肤美术分开记录，使
    /// 切换皮肤包不会替换它，再像普通壁纸一样绘制。空
    /// 路径清除用户壁纸并恢复当前皮肤包的美术（如果
    /// 该包带美术的话）。
    void SetUserWallpaper(string path, int opacity) {
        int op = opacity;
        if (op < 10) { op = 10; }
        if (op > 100) { op = 100; }
        userWallpaperPath = path;
        userWallpaperOpacity = op;
        if (path == "") {
            // 回到皮肤包自身的背景：其安装的美术（按
            // 其自身强度），若未带美术则无背景。
            if (skinArt != "") { this.SetWallpaper(skinArt, skinArtOpacity); }
            else { this.SetWallpaper("", op); }
            return;
        }
        this.SetWallpaper(path, op);
    }

    /// 替换打包 ARGB 颜色的 alpha 字节。
    static int WithAlpha(int color, int alpha) {
        int rgb = color % 16777216;
        if (rgb < 0) { rgb = rgb + 16777216; }
        int a = alpha;
        if (a < 0) { a = 0; }
        if (a > 255) { a = 255; }
        return a * 16777216 + rgb;
    }

    /// 设置壁纸后，各表面让其透出，但仅作为着色：
    /// 三个表面层级彼此保持几步之差，使每个
    /// 面板读起来是同一材质。若让边框远低于
    /// 文档表面，就会造成一个面板像磨砂、下一个像
    /// 玻璃、第三个几乎只剩壁纸，还会把整个外壳
    /// 拖到壁纸自身的暗度上。
    void ApplySurfaceTranslucency() {
        if (bgImagePath == "") {
            // 没有图片，但自行绘制背景（渐变或
            // 磨砂玻璃）的皮肤同样需要透明表面：不透明的
            // 面板填充会盖住窗口绘制的壁纸。平面
            // 皮肤保持完全不透明的表面。
            if (theme.gradient == 0 && theme.glass == 0) { return; }
            theme.ApplyTranslucency(225, 215, 205);
            return;
        }
        // 皮肤包自身的美术是皮肤设计的背景：表面
        // 透明度较低，使插画透过起始页、面板与停靠栏
        // 都能显现。用户壁纸是叠加在皮肤上的个人选择，因此
        // 它给表面着色更多；壁纸不透明度滑块仍可调节它
        // （100% 不透明度 ≈ 不透明面板，10% ≈ 几乎只剩壁纸）。
        int strength = this.WallpaperOpacity();
        int alpha;
        int chrome;
        int rail;
        if (this.SkinArtWallpaper()) {
            alpha = 180;
            chrome = 168;
            rail = 156;
        } else {
            alpha = 255 - strength * 85 / 100;
            chrome = alpha - 10;
            rail = alpha - 20;
            if (alpha < 190) { alpha = 190; }
            if (chrome < 180) { chrome = 180; }
            if (rail < 170) { rail = 170; }
        }
        theme.ApplyTranslucency(alpha, chrome, rail);
    }

    /// 当当前绘制的壁纸是当前皮肤包自身的美术
    /// 而非用户选择的图片时为 true。
    bool SkinArtWallpaper() {
        return skinArt != "" && bgImagePath == skinArt;
    }

    /// 当用户设置了自有壁纸（区别于当前皮肤包的美术）时为 true。
    /// 用户壁纸始终优先于皮肤包美术，且
    /// 切换皮肤不会替换它。
    bool HasUserWallpaper() {
        return userWallpaperPath != "";
    }

    /// 当 `path` 是任意已安装皮肤包自身的美术（不仅限当前
    /// 皮肤）时为 true。持久化设置曾把皮肤包美术存为壁纸，
    /// 因此针对旧皮肤列表编写的配置可能指向一个不再属于
    /// 当前皮肤的横幅；IDE 会忽略这类过期路径。
    bool IsSkinArtPath(string path) {
        if (path == "") { return false; }
        string norm = path;
        norm = norm.Replace("\\", "/");
        norm = norm.ToLower();
        for (int i = 0; i < skinPacks.Count; i = i + 1) {
            Skin s = Skin.Load(skinPacks[i]);
            string a = s.ArtPath();
            if (a != "") {
                string an = a.Replace("\\", "/").ToLower();
                if (an == norm) { return true; }
            }
        }
        return false;
    }

    /// 移除用户壁纸，恢复皮肤自身的背景。
    void ClearWallpaper() {
        this.SetWallpaper("", bgImageOpacity);
    }

    string WallpaperPath() { return bgImagePath; }

    int WallpaperOpacity() {
        if (bgImageOpacity <= 0) { return 100; }
        return bgImageOpacity;
    }

    /// 请求宿主选择壁纸文件（见 ConsumeWallpaperPick）。
    void RequestWallpaperPick() {
        bgImagePickWanted = true;
        this.NoteRedrawWhy("RequestWallpaperPick");
        needsRedraw = true;
    }

    /// 自上次调用以来请求过壁纸文件时为 true；并清除
    /// 该请求，使宿主只打开一次选择器。
    bool ConsumeWallpaperPick() {
        if (!bgImagePickWanted) { return false; }
        bgImagePickWanted = false;
        return true;
    }

    /// 将壁纸快速拷贝到 [x,y,w,h]，居中裁剪覆盖，使图片
    /// 保持宽高比，然后淡入到下方皮肤背景中。
    void RenderWallpaperImage(int x, int y, int w, int h) {
        if (bgImagePath == "") { return; }
        int iw = Canvas.ImageWidth(bgImagePath);
        int ih = Canvas.ImageHeight(bgImagePath);
        if (iw <= 0 || ih <= 0) { return; }
        // 目标尺寸为零会在下面的覆盖比例中除零。
        if (w <= 0 || h <= 0) { return; }
        // 覆盖：与目标宽高比一致的最大居中源矩形。
        int sw = iw;
        int sh = ih;
        if (iw * h > w * ih) {
            sw = w * ih / h;
        } else {
            sh = h * iw / w;
        }
        if (sw < 1) { sw = 1; }
        if (sh < 1) { sh = 1; }
        canvas.BlitImage(bgImagePath, x, y, w, h,
                         (iw - sw) / 2, (ih - sh) / 2, sw, sh);
        // 向皮肤背景淡出：以页面色绘制遮罩，强度为
        // 所请求不透明度的补值。皮肤自身的美术
        // 本就是为背景设计的——它以全强度呈现，由
        // 半透明表面完成混合——因此只有用户选择的
        // 壁纸才加遮罩。
        int fade = 100 - this.WallpaperOpacity();
        if (fade > 0 && !this.SkinArtWallpaper()) {
            StyleBox fadeStyle = Style.Part(this, "windowbg", "fade", "",
                                            "", "", Style.SNormal());
            int fadeBg = fadeStyle.BgOr(0);
            int rgb = fadeBg % 16777216;
            if (rgb < 0) { rgb = rgb + 16777216; }
            canvas.FillRect(x, y, w, h, (fade * 255 / 100) * 16777216 + rgb);
        }
    }

    // ---- 主题化窗口背景（内置，所有窗口共用） ---------
    // 让渐变/玻璃/霓虹皮肤显得真实的壁纸：
    // 垂直渐变加上磨砂面板模糊掉的柔和色斑。
    // 它位于框架中，使 IDE、画廊与任何窗口渲染出相同的
    // 皮肤——应用只需在内容后面调用 RenderBackground。

    /// 单个柔和壁纸光晕：平滑径向渐隐到明亮的中心（无
    /// 生硬边缘），为背景模糊提供可柔化的真实色彩。
    void BackdropBlob(int cx, int cy, int r, int cr, int cg, int cb) {
        // 一次逐像素径向渐隐（Canvas.FillRadial），而非叠加多个
        // 半透明圆盘：叠加的圆盘会在边缘形成可见的"靶心"环带，
        // 而这是一次拷贝而不是 20 次。
        canvas.FillRadial(cx, cy, r, Theme.Rgb(cr, cg, cb), 150);
    }

    /// 由打包 ARGB 主题强调色着色的柔和光晕。
    void BackdropDrift(int cx, int cy, int r, int color) {
        int cr = (color / 65536) % 256;
        int cg = (color / 256) % 256;
        int cb = color % 256;
        this.BackdropBlob(cx, cy, r, cr, cg, cb);
    }

    /// 在垂直渐变上叠加来自主题强调色的色斑
    /// （非玻璃渐变预设），使渐变更像壁纸。
    void BackdropGradientWallpaper(int ax, int ay, int aw, int ah) {
        StyleBox primaryStyle = Style.Part(this, "windowbg", "blob", "",
                                            "", "", Style.SNormal());
        StyleBox infoStyle = Style.Part(this, "windowbg", "blob", "",
                                        "info", "", Style.SNormal());
        StyleBox successStyle = Style.Part(this, "windowbg", "blob", "",
                                           "success", "", Style.SNormal());
        StyleBox errorStyle = Style.Part(this, "windowbg", "blob", "",
                                         "error", "", Style.SNormal());
        int r = this.Scale(340);
        this.BackdropDrift(ax + aw * 20 / 100, ay + ah * 24 / 100, r,
                           primaryStyle.BgOr(0));
        this.BackdropDrift(ax + aw * 74 / 100, ay + ah * 18 / 100, r,
                           infoStyle.BgOr(0));
        this.BackdropDrift(ax + aw * 82 / 100, ay + ah * 72 / 100, r,
                           successStyle.BgOr(0));
        this.BackdropDrift(ax + aw * 30 / 100, ay + ah * 84 / 100, r,
                           errorStyle.BgOr(0));
    }

    /// 为磨砂玻璃预设准备的 iOS 风格多彩壁纸。
    void BackdropGlassWallpaper(int ax, int ay, int aw, int ah) {
        this.BackdropBlob(ax + aw * 14 / 100, ay + ah * 20 / 100,
            this.Scale(320), 128, 96, 245);
        this.BackdropBlob(ax + aw * 40 / 100, ay + ah * 34 / 100,
            this.Scale(300), 236, 120, 175);
        this.BackdropBlob(ax + aw * 78 / 100, ay + ah * 16 / 100,
            this.Scale(320), 96, 156, 255);
        this.BackdropBlob(ax + aw * 62 / 100, ay + ah * 72 / 100,
            this.Scale(340), 240, 112, 196);
        this.BackdropBlob(ax + aw * 30 / 100, ay + ah * 86 / 100,
            this.Scale(300), 96, 222, 208);
        this.BackdropBlob(ax + aw * 90 / 100, ay + ah * 58 / 100,
            this.Scale(280), 156, 120, 250);
    }

    /// 将当前皮肤的窗口背景绘制到 [x,y,w,h]：渐变 +
    /// 柔和色斑（用于渐变/玻璃预设，使磨砂面板能模糊
    /// 真实色彩），否则为纯色 bgPrimary 填充。每次重绘缓存——
    /// 仅动画的帧用一次拷贝恢复像素，而非
    /// 重绘（昂贵的）色斑。`slot` 是调用方
    /// 为其背景预留的快照缓存槽。
    void RenderBackground(int x, int y, int w, int h, int slot) {
        Canvas c = canvas;
        Theme t = theme;
        // 异形窗口：表面在 BeginFrame 里被清成 alpha 0，操作系统
        // 只负责按轮廓合成，轮廓内的像素仍要自己画——所以这里
        // 用皮肤底色铺满每个形状区域（先画投影，再铺底），
        // 设计里没有铺满窗口的背景控件时，窗口才不会整个透明。
        if (shapeMode != 0) {
            if (shapeShadow > 0) { this.PaintShapeShadow(); }
            this.PaintShapeFill();
            return;
        }
        // 原生玻璃：窗口是一张扁平的半透明薄片（在
        // BeginFrame 中清除），覆盖在 OS 模糊的桌面之上。加上柔和的从上到下
        // 光泽，使玻璃具有纵深（顶部更亮），如同真实的
        // 亚克力而非一块平板。
        if (glassNative) {
            StyleBox sheenStyle = Style.Part(this, "windowbg", "sheen", "",
                                             "", "", Style.SNormal());
            int hi = sheenStyle.BgOr(0) % 16777216;
            if (hi < 0) { hi = hi + 16777216; }
            int bands = 18;
            int bh = h / 3 / bands;
            if (bh < 1) { bh = 1; }
            for (int i = 0; i < bands; i = i + 1) {
                int a = 15 - (15 * i / bands);
                c.FillRect(x, y + i * bh, w, bh, a * 16777216 + hi);
            }
            return;
        }
        if (t.gradient != 0 || bgImagePath != "") {
            // 壁纸（渐变 + 柔和色斑）对每个皮肤+尺寸是静态的，因此
            // 每帧从快照恢复——包括脏帧——
            // 只要皮肤代次匹配。只有皮肤变更
            // （bgThemeGen 递增）或尺寸变化（RestoreRect 几何不匹配）
            // 才触发昂贵的重绘。这使玻璃/渐变皮肤在
            // 滚动或输入时保持流畅，而非每帧重新绘制色斑。
            bool restored = false;
            if (bgSnapGen == bgThemeGen) {
                restored = c.RestoreRect(x, y, w, h, slot);
            }
            if (!restored) {
                if (t.gradient != 0) {
                    c.FillVGrad(x, y, w, h, t.bgGradTop, t.bgGradBottom);
                    if (t.glass != 0) {
                        this.BackdropGlassWallpaper(x, y, w, h);
                    } else {
                        this.BackdropGradientWallpaper(x, y, w, h);
                    }
                } else {
                    StyleBox bgStyle = Style.Full(this, "windowbg", "", "",
                                                  Style.SNormal());
                    c.FillRect(x, y, w, h, bgStyle.BgOr(0));
                }
                this.RenderWallpaperImage(x, y, w, h);
                c.SnapshotRect(x, y, w, h, slot);
                bgSnapGen = bgThemeGen;
            }
        } else {
            StyleBox bgStyle = Style.Full(this, "windowbg", "", "",
                                          Style.SNormal());
            c.FillRect(x, y, w, h, bgStyle.BgOr(0));
        }
    }

    /// 用皮肤底色铺满异形窗口的轮廓（见 RenderBackground）。
    /// 类型 3 的阴影带只是把系统表面撑大，不参与填充；
    /// 投影占的那圈边也要留出来（见 ShapeInset），否则底色
    /// 盖住光晕，圆角窗口看上去就没了阴影。
    void PaintShapeFill() {
        if (shapeRects.Count == 0) { return; }
        Canvas c = canvas;
        StyleBox shapeStyle = Style.Part(this, "windowbg", "shape", "",
                                          "", "", Style.SNormal());
        int col = shapeStyle.BgOr(0);
        int pad = this.ShapeInset();
        int i = 0;
        while (i + 5 < shapeRects.Count) {
            int t = shapeRects[i];
            if (t != 3) {
                int x = this.Scale(shapeRects[i + 1]) + pad;
                int y = this.Scale(shapeRects[i + 2]) + pad;
                int w = this.Scale(shapeRects[i + 3]) - pad * 2;
                int h = this.Scale(shapeRects[i + 4]) - pad * 2;
                int r = this.Scale(shapeRects[i + 5]) - pad;
                if (r < 0) { r = 0; }
                if (w > 0 && h > 0) {
                    if (t == 2) {
                        this.FillEllipse(x, y, w, h, col);
                    } else {
                        c.FillRoundRect(x, y, w, h, r, col);
                    }
                }
            }
            i = i + 6;
        }
    }

    /// 轮廓内留给投影的边（设备像素）。操作系统按形状裁剪
    /// 表面，形状之外的像素根本出不来，所以光晕只能画在
    /// 轮廓里头：填充向内缩 shadow 像素，投影从缩后的轮廓
    /// 向外扩到形状边缘。
    int ShapeInset() {
        if (shapeShadow <= 0) { return 0; }
        int pad = this.Scale(shapeShadow);
        if (pad < 0) { pad = 0; }
        return pad;
    }

    /// 椭圆填充（渲染器只有正圆），按行扫描：轮廓由
    /// 操作系统裁剪，这里只要把里面填实。
    void FillEllipse(int x, int y, int w, int h, int col) {
        if (w <= 0 || h <= 0) { return; }
        Canvas c = canvas;
        int rx = w / 2;
        int ry = h / 2;
        if (rx <= 0 || ry <= 0) { return; }
        int cx = x + rx;
        int cy = y + ry;
        for (int dy = 0 - ry; dy <= ry; dy = dy + 1) {
            int inside = ry * ry - dy * dy;
            if (inside <= 0) { continue; }
            int hw = rx * App.ISqrt(inside) / ry;
            if (hw <= 0) { continue; }
            c.FillRect(cx - hw, cy + dy, hw * 2, 1, col);
        }
    }

    /// 整数平方根（向下取整）。
    static int ISqrt(int v) {
        if (v <= 0) { return 0; }
        int r = 0;
        int bit = 1073741824;
        int rest = v;
        while (bit > rest) { bit = bit / 4; }
        while (bit != 0) {
            if (rest >= r + bit) {
                rest = rest - r - bit;
                r = (r / 2) + bit;
            } else {
                r = r / 2;
            }
            bit = bit / 4;
        }
        return r;
    }

    /// 将异形轮廓的柔和投影绘制到表面，
    /// 位于控件树之下（由 RenderBackground 调用）。每个非阴影带区域
    /// 投射同心抗锯齿圆环——软件渲染器没有
    /// 高斯阴影，因此衰减采用分层，与 StyleBox 自身的阴影一致。
    /// 每个圆环只描边一次（1px 圆角矩形/圆形轮廓），
    /// 半透明层不会双重混合成饱和的暗边——
    /// 这正是重叠填充的问题。类型 3 阴影带区域（由
    /// formgen 为 winShadow 添加）只扩展 OS 表面，不投射阴影。
    void PaintShapeShadow() {
        if (shapeRects.Count == 0 || shapeShadow <= 0) { return; }
        Canvas c = canvas;
        int blur = this.Scale(shapeShadow);
        if (blur <= 0) { return; }
        StyleBox shadowStyle = Style.Part(this, "windowbg", "shape-shadow",
                                           "", "", "", Style.SNormal());
        int baseCol = shadowStyle.BgOr(0);
        if (baseCol == 0) { baseCol = 0x50000000; }
        // 峰值 alpha：主题的阴影着色（非常淡），但绝不能暗到
        // 让光晕看起来像硬边轮廓。
        int peak = (baseCol >> 24) & 255;
        if (peak < 40) { peak = 40; }
        if (peak > 110) { peak = 110; }
        int rgb = baseCol % 16777216;
        if (rgb < 0) { rgb = rgb + 16777216; }
        int pad = this.ShapeInset();
        int i = 0;
        while (i + 5 < shapeRects.Count) {
            int t = shapeRects[i];
            if (t == 3) { i = i + 6; continue; }
            int x = this.Scale(shapeRects[i + 1]) + pad;
            int y = this.Scale(shapeRects[i + 2]) + pad;
            int w = this.Scale(shapeRects[i + 3]) - pad * 2;
            int h = this.Scale(shapeRects[i + 4]) - pad * 2;
            int r = this.Scale(shapeRects[i + 5]) - pad;
            if (r < 0) { r = 0; }
            if (w <= 0 || h <= 0) { i = i + 6; continue; }
            // 每像素扩展一个圆环；相邻圆环无缝拼接
            // （路径上居中的 1px 描边覆盖 [k-0.5, k+0.5]）。
            int k = 1;
            while (k <= blur) {
                int a = peak * (blur - k + 1) / blur;
                int col = (a << 24) | rgb;
                if (t == 2) {
                    int rad = (w + k * 2) / 2;
                    c.DrawCircle(x + w / 2, y + h / 2, rad, col, 1);
                } else {
                    c.DrawRoundRect(x - k, y - k, w + k * 2, h + k * 2,
                                    r + k, col, 1);
                }
                k = k + 1;
            }
            i = i + 6;
        }
    }

    /// 当前生效的背景效果类型：设置了绘制器覆盖项则用覆盖项，
    /// 否则用皮肤自身的效果。0 = 无。
    int EffectiveFx() {
        if (fxKindOverride >= 0) { return fxKindOverride; }
        return theme.fx;
    }

    /// 当前皮肤的动画背景效果运行中时为 true。
    /// 异形窗口上绝不运行：效果层会合成到整个
    /// 表面，粒子会点亮轮廓之外
    /// 的透明像素而非设计本身。
    bool FxActive() {
        return fxEnabled && this.EffectiveFx() != 0 && !glassNative
            && shapeMode == 0;
    }

    /// 启用/禁用此窗口皮肤的动态背景效果。
    void SetBackdropFx(bool on) {
        fxEnabled = on;
        fxSnapValid = false;
        fxTouched = null;
        fxTouchedFull = false;
        if (!on) { fxNextMs = -1; }
        this.NoteRedrawWhy("SetBackdropFx");
        needsRedraw = true;
    }

    /// 纯效果帧：恢复上次完整渲染帧的快照，
    /// 在其上重新合成皮肤效果并呈现。当
    /// 无有效快照时返回 false（调用方回退为完整渲染），
    /// 例如在尺寸变化之后。
    bool FxPresent() {
        // 纯特效拍与局部帧无关：它不渲染控件树，只是整窗恢复快照 +
        // 重合成特效 + 整窗提交，partialFrames 关闭（默认）时同样正确。
        // 此前按 ForceFullFrames 一票否决，等于在默认配置下把快速路径
        // 整个废掉——背景动画每拍都退回整窗控件重栅（实测首帧 36ms），
        // 任何持续动画（如倒计时）加入后 CPU 光栅饱和，一卡一卡。
        if (!fxSnapValid || !this.FxActive()) { fxNextMs = -1; return false; }
        int perfFxT0 = 0;
        int perfFxRestoreT0 = 0;
        int perfFxRenderT0 = 0;
        int perfFxPresentT0 = 0;
        if (App.PerfOn()) {
            perfFxT0 = Window.GetTickUs();
            perfFxRestoreT0 = perfFxT0;
        }
        if (!window.IsVisible()) {
            // 窗口不可见（最小化或完全被遮挡）：停止
            // 计时。仅失去焦点的窗口仍在屏幕上，
            // 其背景继续动画。任何事件——包括
            // 可见性唤醒——都会重新武装效果（ProcessEvent /
            // ApplyEvent）。
            fxNextMs = -1;
            return true;
        }
        Canvas fc = canvas;
        int cw = fc.Width();
        int chh = fc.Height();
        // 修复自快照以来特效触及过的全部区域（fxTouched），而不是
        // 只有上一拍的矩形：光斑在移动，只修上一拍会让更早各拍的
        // 像素以幽灵色块的形式留在画布与屏幕上。
        bool fullRepair = fxTouchedFull || fxTouched == null;
        bool ok;
        if (App.PerfOn()) {
            File.AppendAllText("zan_frame_perf.log",
                "fxp full=" + (fullRepair ? 1 : 0)
                + " n=" + (fxTouched == null ? 0 : fxTouched.Count / 4)
                + "\n");
        }
        if (fullRepair) {
            ok = fc.RestoreRect(0, 0, cw, chh, App.FxSnapSlot());
        } else {
            ok = true;
            int i = 0;
            while (ok && i + 3 < fxTouched.Count) {
                ok = fc.RestoreSubRect(fxTouched[i], fxTouched[i + 1],
                                       fxTouched[i + 2], fxTouched[i + 3],
                                       App.FxSnapSlot());
                i = i + 4;
            }
        }
        if (!ok) {
            fxSnapValid = false;
            return false;
        }
        if (App.PerfOn()) {
            perfFxRestoreUs = perfFxRestoreUs
                + (Window.GetTickUs() - perfFxRestoreT0);
            perfFxRenderT0 = Window.GetTickUs();
        }
        int fxPhaseMs = Window.GetTickMs();
        BackdropFx.Render(this, fc, this.EffectiveFx(), 0, 0, cw, chh,
                          fxPhaseMs, theme, dpiScale);
        // 本拍把屏幕上的特效相位推进到了 fxPhaseMs：记入 fxFrameMs，
        // 否则随后的损伤裁剪帧（悬停条带）仍按上一整帧的旧相位在
        // 条带内重合成特效，与条带外已在屏幕上的新相位错开——
        // 条带边界处就会出现一块矩形鬼影。
        fxFrameMs = fxPhaseMs;
        List<int> fresh = BackdropFx.TakeDamage();
        fxDamage = fresh;
        // 并入本拍损伤，得到下一拍的修复清单；累计过大时改走
        // 全帧恢复（本拍已经全恢复了就直接以本拍损伤重新起算）。
        if (fullRepair) {
            fxTouched = fresh;
            fxTouchedFull = false;
            if (fresh != null && fresh.Count / 4 > 1024) { fxTouchedFull = true; }
        } else {
            int i = 0;
            while (i + 3 < fresh.Count) {
                fxTouched.Add(fresh[i]);
                fxTouched.Add(fresh[i + 1]);
                fxTouched.Add(fresh[i + 2]);
                fxTouched.Add(fresh[i + 3]);
                i = i + 4;
            }
            long area = 0;
            i = 0;
            while (i + 3 < fxTouched.Count) {
                area = area + (long)fxTouched[i + 2] * fxTouched[i + 3];
                i = i + 4;
            }
            if (fxTouched.Count / 4 > 1024
                || area * 2 > (long)cw * chh) {
                fxTouchedFull = true;
            }
        }
        // 呈现：全帧修复后画布处处等于"快照+本拍特效"，整窗上传；
        // 部分修复时上传旧损伤区（已回到快照）+ 本拍损伤区即可。
        if (App.PerfOn()) { perfFxPresentT0 = Window.GetTickUs(); }
        if (fullRepair) {
            window.Present(canvas);
        } else {
            this.MarkPresentDirty(fxTouched);
            window.Present(canvas);
        }
        if (App.PerfOn()) {
            int perfFxEndUs = Window.GetTickUs();
            perfFxRenderUs = perfFxRenderUs
                + (perfFxPresentT0 - perfFxRenderT0);
            perfFxPresentUs = perfFxPresentUs
                + (perfFxEndUs - perfFxPresentT0);
            perfFxTickUs = perfFxTickUs + (perfFxEndUs - perfFxT0);
            perfFxTicks = perfFxTicks + 1;
            perfFxOnlyTicks = perfFxOnlyTicks + 1;
            perfFxTickMs = perfFxTickMs
                + (perfFxEndUs - perfFxT0) / 1000;
            this.PerfMaybeFlushLoop(Window.GetTickMs());
        }
        lastPresentMs = Window.GetTickMs();
        fxNextMs = lastPresentMs + this.FxIntervalMs();
        return true;
    }

    /// 距下次效果帧的时间：皮肤自身的帧间隔。
    /// 只有不可见的窗口才停止计时（见 FxPresent）。
    int FxIntervalMs() {
        int ms = BackdropFx.IntervalMs(this.EffectiveFx());
        // 空闲时逐级放慢环境特效的心跳：最后一次真实输入越久，
        // tick 越稀；任何输入都会把 lastInputMs 拉回当下，下一拍
        // 就恢复皮肤自身节奏。可见窗口不暂停（失焦只影响输入），
        // 但没人看动画时不必每 150ms 重合成一整层。
        int idleMs = Window.GetTickMs() - lastInputMs;
        if (idleMs <= 5000) { return ms; }
        if (idleMs <= 30000) { return ms * 2; }
        if (idleMs <= 120000) { return ms * 4; }
        int slow = ms * 8;
        if (slow > 1000) { slow = 1000; }
        if (slow < ms) { slow = ms; }
        return slow;
    }

    /// 将下次重绘标记为损伤裁剪帧，覆盖指针
    /// 离开的控件与进入的控件（带内边距，使焦点环与细线
    /// 位于命中区外侧时也包含在内）。同一事件处理中
    /// 任何其他重绘原因都会通过 CancelPartialFrame() 取消它。
    void NoteHoverDamage(int oldId, int newId) {
        if (this.ForceFullFrames()) { partialPending = false; return; }
        // 同一批事件里已经有人要求过整窗重绘（RequestRedraw，说不清
        // 改了哪些像素）：悬停不得反过来把它降级成一条条带，否则
        // 那次状态变化改的像素永远不重画，一直就留在屏上。
        if (partialBlocked) {
            this.NoteRedrawWhy("hover-blocked");
            partialPending = false;
            return;
        }
        if (this.HasOverlays() || this.PointerCaptured()) {
            this.NoteRedrawWhy("hover-blocked");
            partialPending = false;
            return;
        }
        List<int> ra = hitTester.RectOf(oldId);
        List<int> rb = hitTester.RectOf(newId);
        if (ra == null && rb == null) {
            this.NoteRedrawWhy("hover-norect");
            partialPending = false;
            return;
        }
        int pad = this.Scale(6);
        int x0 = canvas.Width();
        int y0 = canvas.Height();
        int x1 = 0;
        int y1 = 0;
        if (ra != null) {
            if (ra[0] < x0) { x0 = ra[0]; }
            if (ra[1] < y0) { y0 = ra[1]; }
            if (ra[0] + ra[2] > x1) { x1 = ra[0] + ra[2]; }
            if (ra[1] + ra[3] > y1) { y1 = ra[1] + ra[3]; }
        }
        if (rb != null) {
            if (rb[0] < x0) { x0 = rb[0]; }
            if (rb[1] < y0) { y0 = rb[1]; }
            if (rb[0] + rb[2] > x1) { x1 = rb[0] + rb[2]; }
            if (rb[1] + rb[3] > y1) { y1 = rb[1] + rb[3]; }
        }
        x0 = x0 - pad;
        y0 = y0 - pad;
        x1 = x1 + pad;
        y1 = y1 + pad;
        // 本批事件里已声明的损伤（NoteDamage：勾选框、换标签、滚动……）
        // 要一并算进来。悬停条带直接覆盖它们的话，那些区域既不重画
        // 也不上传，屏上就挂着旧像素，直到下一次整窗重绘。
        if (partialPending) {
            if (dmgX < x0) { x0 = dmgX; }
            if (dmgY < y0) { y0 = dmgY; }
            if (dmgX + dmgW > x1) { x1 = dmgX + dmgW; }
            if (dmgY + dmgH > y1) { y1 = dmgY + dmgH; }
        }
        if (x0 < 0) { x0 = 0; }
        if (y0 < 0) { y0 = 0; }
        if (x1 > canvas.Width()) { x1 = canvas.Width(); }
        if (y1 > canvas.Height()) { y1 = canvas.Height(); }
        if (x1 - x0 <= 0 || y1 - y0 <= 0) {
            partialPending = false;
            return;
        }
        dmgX = x0;
        dmgY = y0;
        dmgW = x1 - x0;
        dmgH = y1 - y0;
        partialPending = true;
    }

    /// 把接下来绘制的区域放进以 `first` 开头的即时模式 id 段，直到
    /// EndIdScope()。宿主用它隔开各个大区域（功能区、面板、标签条、
    /// 编辑区）：某个区域这一帧多画 / 少画了控件，也不会让别处的
    /// id 移位，从而把点击错投到另一个控件上。段之间要留足间隔。
    void BeginIdScope(int first) {
        focus.PushIds(first);
        // 分析器开着时把每个 id 段当作一个可计时的区域：它们正好是
        // 宕机把界面分开的那几块（功能区、编辑区、各个面板），于是
        // 不需要在宿主里另埋一套标记点。
        if (!App.PerfOn()) { return; }
        int now = Window.GetTickUs();
        // 两个 id 段之间的活（宿主在面板之外直接画的东西）也要有人认：
        // 否则尖尖那一帧只能看到“整棑很贵、每段都很便宜”。
        if (scopeEndUs > 0) {
            int gap = now - scopeEndUs;
            if (gap > phaseSecTopUs) {
                phaseSecTopUs = gap;
                phaseSecTop = "after" + Convert.ToString(scopeEndId);
            }
        }
        scopeId = first;
        scopeAtUs = now;
    }

    void EndIdScope() {
        focus.PopIds();
        if (!App.PerfOn()) { return; }
        int now = Window.GetTickUs();
        int us = now - scopeAtUs;
        scopeEndUs = now;
        scopeEndId = scopeId;
        if (us > phaseSecTopUs) {
            phaseSecTopUs = us;
            phaseSecTop = Convert.ToString(scopeId);
        }
    }

    /// StyleBox 在画玻璃时登记面板矩形（本帧内有效）。见 glassRects。
    void NoteGlassRect(int x, int y, int w, int h) {
        // 一屏玻璃面板的合理上限；超过就不再登记——损伤扩展退化成
        // 整窗帧，正确性不受影响。
        if (glassRects.Count >= 256) { return; }
        glassRects.Add(x);
        glassRects.Add(y);
        glassRects.Add(w);
        glassRects.Add(h);
    }

    /// 损伤条带跨出了玻璃面板：把下一帧的裁剪从条带扩到
    /// 「条带 ∪ 相交面板」的并集，使面板模糊从一整块本帧新画的
    /// 背景重算。没有任何相交面板（miss 来自已关闭的面板）或并集
    /// 大到接近整窗时返回 false，调用方退回整窗重绘。
    bool WidenDamageToGlass() {
        int x0 = dmgX;
        int y0 = dmgY;
        int x1 = dmgX + dmgW;
        int y1 = dmgY + dmgH;
        bool any = false;
        int i = 0;
        while (i + 3 < glassRects.Count) {
            int gx = glassRects[i];
            int gy = glassRects[i + 1];
            int gw = glassRects[i + 2];
            int gh = glassRects[i + 3];
            i = i + 4;
            if (gx + gw <= x0 || x1 <= gx) { continue; }
            if (gy + gh <= y0 || y1 <= gy) { continue; }
            if (gx < x0) { x0 = gx; }
            if (gy < y0) { y0 = gy; }
            if (gx + gw > x1) { x1 = gx + gw; }
            if (gy + gh > y1) { y1 = gy + gh; }
            any = true;
        }
        if (!any) { return false; }
        if (x0 < 0) { x0 = 0; }
        if (y0 < 0) { y0 = 0; }
        if (x1 > canvas.Width()) { x1 = canvas.Width(); }
        if (y1 > canvas.Height()) { y1 = canvas.Height(); }
        int w = x1 - x0;
        int h = y1 - y0;
        if (w <= 0 || h <= 0) { return false; }
        // 扩出来的面积已经逼近整窗时，裁剪省下的上传就不值当
        // 额外的光栅了：直接整窗更诚实。
        if (w * h * 2 > canvas.Width() * canvas.Height()) { return false; }
        dmgX = x0;
        dmgY = y0;
        dmgW = w;
        dmgH = h;
        partialPending = true;
        return true;
    }

    /// 滚动串结束后的玻璃还账：串里暂用旧模糊的面板攒在
    /// glassDeferredRects，这里在串结束后武装一帧「条带 ∪ 欠账
    /// 面板」的扩展刷新，让它们的模糊从整块新鲜背景重算。整窗帧
    /// 渲染过则一切像素本就新鲜，直接销账。每帧 EndFrame 调用。
    void SettleGlassRefresh() {
        if (!partialFrame) {
            glassRefreshOwe = false;
            glassRefreshArmedAt = 0 - 1;
            glassDeferredRects.Clear();
            glassDeferred = false;
            return;
        }
        if (glassDeferred) { return; }
        if (!glassRefreshOwe || this.ScrollBurstActive()) { return; }
        if (glassRefreshArmedAt >= 0) {
            if (glassRefreshArmedAt != frameCount) {
                // 还账帧已渲染：裁剪罩住了全部欠账面板，模糊重算过，
                // 销账。期间若又有新的暂用（玻璃Deferred），NoteGlassDeferred
                // 已把 armedAt 拍回 -1，走不到这里。
                glassRefreshOwe = false;
                glassRefreshArmedAt = 0 - 1;
                glassDeferredRects.Clear();
            }
            return;
        }
        int x0 = dmgX;
        int y0 = dmgY;
        int x1 = dmgX + dmgW;
        int y1 = dmgY + dmgH;
        int i = 0;
        while (i + 3 < glassDeferredRects.Count) {
            int gx = glassDeferredRects[i];
            int gy = glassDeferredRects[i + 1];
            int gw = glassDeferredRects[i + 2];
            int gh = glassDeferredRects[i + 3];
            i = i + 4;
            if (gx < x0) { x0 = gx; }
            if (gy < y0) { y0 = gy; }
            if (gx + gw > x1) { x1 = gx + gw; }
            if (gy + gh > y1) { y1 = gy + gh; }
        }
        if (x0 < 0) { x0 = 0; }
        if (y0 < 0) { y0 = 0; }
        if (x1 > canvas.Width()) { x1 = canvas.Width(); }
        if (y1 > canvas.Height()) { y1 = canvas.Height(); }
        int w = x1 - x0;
        int h = y1 - y0;
        needsRedraw = true;
        if (w <= 0 || h <= 0
            || w * h * 2 > canvas.Width() * canvas.Height()) {
            partialBlocked = true;
            forceFullNext = true;
            this.NoteRedrawWhy("glass-partial-blur");
            return;
        }
        dmgX = x0;
        dmgY = y0;
        dmgW = w;
        dmgH = h;
        partialPending = true;
        glassRefreshArmedAt = frameCount;
        this.NoteRedrawWhy("glass-refresh");
    }

    /// 声明本次状态变化只改变 [x,y,w,h] 这块像素：下一帧被裁剪
    /// 到它（与本帧其他声明合并），而不是重绘整个窗口。切换
    /// 标签页、勾选复选框一类的控件用它取代 RequestRedraw；
    /// 同一帧里任何 RequestRedraw 都会让下一帧回到整窗重绘。
    void NoteDamage(int x, int y, int w, int h) {
        if (this.ForceFullFrames()) { partialBlocked = true; }
        needsRedraw = true;
        if (partialBlocked || this.HasOverlays()) {
            if (partialBlocked) { this.NoteRedrawWhy("dmg-blocked"); }
            else { this.NoteRedrawWhy("dmg-overlay"); }
            partialPending = false;
            return;
        }
        this.NoteRedrawWhy("dmg");
        int x0 = x;
        int y0 = y;
        int x1 = x + w;
        int y1 = y + h;
        if (partialPending) {
            if (dmgX < x0) { x0 = dmgX; }
            if (dmgY < y0) { y0 = dmgY; }
            if (dmgX + dmgW > x1) { x1 = dmgX + dmgW; }
            if (dmgY + dmgH > y1) { y1 = dmgY + dmgH; }
        }
        if (x0 < 0) { x0 = 0; }
        if (y0 < 0) { y0 = 0; }
        if (x1 > canvas.Width()) { x1 = canvas.Width(); }
        if (y1 > canvas.Height()) { y1 = canvas.Height(); }
        if (x1 - x0 <= 0 || y1 - y0 <= 0) {
            partialPending = false;
            return;
        }
        dmgX = x0;
        dmgY = y0;
        dmgW = x1 - x0;
        dmgH = y1 - y0;
        partialPending = true;
        if (App.PerfOn()) {
            File.AppendAllText("zan_frame_perf.log",
                "damage_decl=" + Convert.ToString(dmgX) + ","
                + Convert.ToString(dmgY) + "+"
                + Convert.ToString(dmgW) + "x"
                + Convert.ToString(dmgH) + "\n");
        }
    }

    /// 滚轮把某块可滚动区域的内容平移了一段：变的只有这块像素，
    /// 于是把它声明成损伤区，而不是整窗重绘。区域为空或声明不成立
    /// 时 NoteDamage 自己会退回整窗。
    void NoteScrollDamage(int x, int y, int w, int h) {
        // 顺带续上滚动串的时间窗：串内的玻璃面板暂用旧模糊
        // （BackdropDirtyIn），串结束由 EndFrame 武装一帧扩展刷新。
        scrollBusyUntilMs = nowMs + 140;
        if (App.PerfOn()) {
            File.AppendAllText("zan_frame_perf.log",
                "scroll_damage=" + Convert.ToString(x) + ","
                + Convert.ToString(y) + "+"
                + Convert.ToString(w) + "x"
                + Convert.ToString(h) + "\n");
        }
        this.NoteDamage(x, y, w, h);
    }

    /// 页面滚动影响的区域：标题栏以下、侧边栏（若有）以右的全部内容。
    void NotePageScrollDamage() {
        int x0 = 0;
        if (splitX > 0) { x0 = splitX; }
        this.NoteScrollDamage(x0, titlebarH, canvas.Width() - x0,
                              canvas.Height() - titlebarH);
    }

    /// 强制下一帧完整重绘（任何非单纯
    /// 悬停移动的情况：滚动、输入、缩放、动画、换肤……）。
    void CancelPartialFrame() {
        partialPending = false;
    }

    /// 向下一次 Present 宣告扁平的 [x,y,w,h,...] 损伤矩形列表。
    void MarkPresentDirty(List<int> rects) {
        if (rects == null) { return; }
        int i = 0;
        while (i + 3 < rects.Count) {
            window.PresentDirty(rects[i], rects[i + 1], rects[i + 2], rects[i + 3]);
            i = i + 4;
        }
    }

    int ChromeButtonCount() {
        int count = this.showCloseButton ? 1 : 0;
        if (showThemeButton) { count = count + 1; }
        if (showPinButton) { count = count + 1; }
        if (showMinimizeButton) { count = count + 1; }
        if (showMaximizeButton) { count = count + 1; }
        return count;
    }

    void SetChromeButtons(
        bool themeButton,
        bool pinButton,
        bool minimizeButton,
        bool maximizeButton
    ) {
        showThemeButton = themeButton;
        showPinButton = pinButton;
        showMinimizeButton = minimizeButton;
        showMaximizeButton = maximizeButton;
        window.SetCaptionButtons(ChromeButtonCount());
        this.NoteRedrawWhy("SetChromeButtons");
        needsRedraw = true;
    }

    /// 悬停在某个标题按钮上够久（提示该露出来了）。
    ///
    /// 声明给动画的重绘范围必须把按钮下方那条提示一起圈进去：提示是这次悬停
    /// 动画画出来的东西，只声明按钮自己那一格的话，被动画唤醒的那一帧就裁到
    /// 那 46x33 —— 提示画在标题栏下方，整条都在裁剪框外，于是它一个像素也落
    /// 不到屏幕上（只有别的原因触发整窗重绘时才闪一下）。
    bool CaptionTipShown(int id, int bx, int bw, int hbar) {
        int rh = hbar + this.Scale(80);
        return Ui.HoverLevelMsIn(this, id, 0, this.CaptionTipX(bx, bw), 0,
            this.Scale(300), rh) >= 900;
    }

    /// 标题提示区的左边（提示居中挂在按钮下方）。
    int CaptionTipX(int bx, int bw) {
        return bx + bw / 2 - this.Scale(300) / 2;
    }

    /// 记下这一帧哪条标题提示露着（`id` 为 0 表示一条也没有），并为
    /// “浮出/消失”那一刻额外要一帧。
    ///
    /// 提示是指针刚进按钮那一帧画出来的，而那一帧的重绘范围是悬停损伤
    /// （只有离开与进入的那两格按钮），提示整条都在裁剪框外，于是一个
    /// 像素也落不到屏幕上（只有别的原因触发整窗重绘时才闪一下）；指针移开
    /// 时反过来：没人重画提示占过的那块，那条提示就挂在那里不走。
    void NoteCaptionTip(int id, int bx, int bw, int hbar) {
        if (id == capTipId) { return; }
        int tipW = this.Scale(300);
        int tipH = hbar + this.Scale(80);
        if (capTipId != 0) {
            this.RequestAnimationFrameIn(16, capTipX, 0, tipW, tipH);
        }
        if (id != 0) {
            int nx = this.CaptionTipX(bx, bw);
            this.RequestAnimationFrameIn(16, nx, 0, tipW, tipH);
            capTipX = nx;
        }
        capTipId = id;
    }

    /// 标题按钮的悬停提示文案。默认是中文；宿主界面不是中文时，
    /// 切界面语言时把这一套文案换掉即可 —— 标题栏是窗口自己画的，
    /// 它上面的字不跟着界面语言走，换文案只影响这五个提示。
    void SetCaptionTips(
        string theme,
        string pin,
        string minimize,
        string maximize,
        string restore,
        string close
    ) {
        themeTipText = theme;
        pinTipText = pin;
        minimizeTipText = minimize;
        maximizeTipText = maximize;
        restoreTipText = restore;
        closeTipText = close;
    }

    /// 照抄 `src` 的标题提示文案：副窗口的标题栏归框架画，
    /// 界面语言归主窗口的宿主管，所以它只能跟着主窗口。
    void FollowCaptionTips(App src) {
        this.SetCaptionTips(src.themeTipText, src.pinTipText,
            src.minimizeTipText, src.maximizeTipText, src.restoreTipText,
            src.closeTipText);
    }

    /// 将标题栏主题按钮变为下拉菜单，列出
    /// `names`（如皮肤预设）而非简单的深/浅切换，并且
    /// 保留在原始标题按钮位置，使其不可拖动。
    /// 向返回的事件添加处理函数以响应选择，然后读取
    /// ThemeMenuIndex()。在 WidgetId.Mark() 之前调用一次，使选项 id
    /// 块在应用生命周期内保持稳定。
    UiEvent SetThemeMenu(List<string> names, int index) {
        themeNames = names;
        themeMenuModel.Set(index);
        themeMenuBaseId = WidgetId.Block(names.Count);
        showThemeButton = true;
        window.SetCaptionButtons(ChromeButtonCount());
        this.NoteRedrawWhy("SetThemeMenu");
        needsRedraw = true;
        return themeMenuChange;
    }

    /// 标题栏主题按钮作为预设菜单时返回 true。
    bool ThemeMenuMode() { return themeNames.Count > 0; }

    /// 标题栏主题菜单当前选中的索引。
    int ThemeMenuIndex() { return themeMenuModel.Get(); }

    /// 同步菜单选中项而不触发变更事件（用于深度链接）。
    void SetThemeMenuIndex(int i) {
        themeMenuModel.Set(i);
        this.NoteRedrawWhy("SetThemeMenuIndex");
        needsRedraw = true;
    }

    /// 将 OS 窗口左上角移动到屏幕工作区像素坐标 (x, y)。
    void SetWindowPos(int x, int y) {
        window.SetPosition(x, y);
    }

    /// 将 OS 窗口在其显示器工作区居中。
    void CenterWindow() {
        window.Center();
    }

    /// <summary>换掉渲染表面。损伤裁剪帧、动画矩形与 fx 快照都以
    /// 「表面里还留着上一帧」为前提，而新表面的像素是未初始化的：
    /// 不清掉这些状态，换表面后的第一帧只画出损伤条带，其余部分
    /// 是内存垃圾——看起来就是黑屏加几块残影。</summary>
    void SwapCanvas(int w, int h) {
        // 先建新表面再销毁旧的：表面 id 取自空槽位，若先销毁，新表面
        // 会立刻复用同一个 id，而外壳按 hwnd 记着这个 id，WM_PAINT /
        // WM_SIZE（拖边框时来自 OS 的模态循环）就会把这块还没画过的
        // 表面贴上屏——里面是分配器交还的旧表面内容。
        Canvas old = canvas;
        canvas = new Canvas(w, h);
        old.Destroy();
        partialPending = false;
        partialFrame = false;
        dmgW = 0;
        dmgH = 0;
        animRectValid = false;
        animRectAll = false;
        inputNeedsFrame = false;
        animPrevValid = false;
        fxSnapValid = false;
        fxDamage = null;
        fxTouched = null;
        fxTouchedFull = false;
    }

    void Show() {
        window.Show();
        int realW = window.ClientWidth();
        int realH = window.ClientHeight();
        if (realW != canvas.Width() || realH != canvas.Height()) {
            this.SwapCanvas(realW, realH);
        }
        dpiScale = Canvas.GetDpiScale();
        // 全屏宿主不给所请求的窗口尺寸（Android 上 SDL 窗口永远
        // 是整个 activity 表面）：设计整页按当前 DPI 缩放后超出
        // 客户区时，把缩放重新拟合到刚好放下——生成代码的坐标
        // 都是逻辑字段，随 dpiScale 整页重解，右侧不再裁掉半列。
        // 桌面上客户区 == 请求尺寸（或系统钳制后的尺寸），拟合
        // 只在真的放不下时介入，行为不变。下限 50：宁可滚动、
        // 裁边也不要把界面缩到不可读。
        // Android 例外：整页拟合在手机上是倒退——窗口是 1080×2400
        // 级别的竖屏表面，设计稿（桌面比例）宽或高必然超，拟合会
        // 把 420dpi 设备压回 96dpi 的字，整页小得没法读。手机上
        // 的正确形状是「按设备原生密度渲染 + 页内滚动」，所以拟合
        // 只允许下调到原生密度为止，绝不低于它。
        if (realW > 0 && realH > 0 && designW > 0 && designH > 0) {
            int wantW = designW * dpiScale / 100;
            int wantH = designH * dpiScale / 100;
            if (wantW > realW || wantH > realH) {
                int fitX = realW * 100 / designW;
                int fitY = realH * 100 / designH;
                int fit = fitX < fitY ? fitX : fitY;
                if (fit < 50) { fit = 50; }
                if (fit > 400) { fit = 400; }
                #if ANDROID
                if (fit < dpiScale) { fit = dpiScale; }
                #endif
                if (fit < dpiScale) { dpiScale = fit; }
            }
        }
        this.ScaleThemeMetrics();
        scrollSpeed = 40 * dpiScale / 100;
        titlebarH = Window.TitlebarHeight();
        captionBtnW = Window.CaptionButtonWidth();
        if (titlebarH < 24) { titlebarH = Scale(32); }
        if (captionBtnW < 24) { captionBtnW = Scale(46); }
        int nCap = 0;
        if (showChrome) { nCap = ChromeButtonCount(); }
        window.SetCaptionButtons(nCap);
        // 设置 ZAN_UI_SCRIPT 时启用 AI 自动化驱动（否则不生效）。
        UiDriver.Begin(this);
    }

    /// 显示窗口并运行标准事件循环直至关闭，
    /// 每帧仅绘制标题栏边框。这是简单窗口的
    /// 一次调用便捷方法；要绘制自己的内容，请直接驱动
    /// BeginFrame / RenderChrome / PresentFrame 循环。
    void Run(string title) {
        this.RunLoop(() => { this.RenderChrome(title); });
    }

    /// <summary>让渲染表面跟上真实的窗口大小（并把滚动限制到
    /// 新视口）。由 ProcessEvent 每次事件调用，也由窗口过程
    /// 驱动的重绘调用。</summary>
    void SyncSurface() {
        int curW = window.ClientWidth();
        int curH = window.ClientHeight();
        if (curW <= 0 || curH <= 0) { return; }
        if (curW == canvas.Width() && curH == canvas.Height()) { return; }
        this.SwapCanvas(curW, curH);
        // 将滚动限制到新视口，而非跳到顶部——调整大小
        // 不应跳变用户的滚动位置。
        int viewH = curH - titlebarH;
        int maxScroll = contentHeight - viewH;
        if (maxScroll < 0) { maxScroll = 0; }
        if (scrollY > maxScroll) { scrollY = maxScroll; }
        if (scrollY < 0) { scrollY = 0; }
        this.NoteRedrawWhy("SyncSurface");
        needsRedraw = true;
    }

    /// <summary>注册每帧的绘制内容，供框架在应用循环之外
    /// 也能画帧：拖动窗口边框会进入系统模态尺寸调整循环，
    /// 它在松手前不会回到应用的循环，没有帧体时表面就停在
    /// 旧尺寸上，新露出的一条一直空白。自己写循环的应用在
    /// Show() 之后注册一次，循环体照旧。RunLoop 会自动注册。
    /// </summary>
    void SetFrameBody(FrameBody body) {
        frameBody = body;
        App.frameApp = this;
        Window.SetSizePaint(() => { App.PaintFromWndProc(); });
    }

    /// <summary>从窗口过程就地画一帧(先让表面跟上新的窗口
    /// 尺寸)。没有注册帧体时为空操作。支持主 App 和 ChildWindow:
    /// 按当前 eventHwnd 路由到对应的窗口。</summary>
    static void PaintFromWndProc() {
        if (App.wndProcPainting) { return; }
        // 窗口过程正在处理的消息所属的窗口。不能用 EventHwnd():
        // 那一个只在应用泵出事件时更新,而模态尺寸调整循环期间
        // 应用拿不到事件,它会停留在拖动开始前的旧值上。
        nint hwnd = Window.SizePaintWindow();
        // 先尝试路由给 ChildWindow(IDE 的子窗口)。
        if (ChildWindows.PaintForResize(hwnd)) { return; }
        // 不是子窗口,回退到主 App。
        App a = App.frameApp;
        if (a == null || a.frameBody == null) { return; }
        if (hwnd != a.WindowHandle()) { return; }
        App.wndProcPainting = true;
        a.SyncSurface();
        a.SafeFrame(a.frameBody);
        App.wndProcPainting = false;
    }

    /// <summary>受保护的标准事件循环：每一轮的事件分发与
    /// 绘制都包在异常保护里，一帧里抛出的异常只丢掉这一帧（并记入
    /// UiErrorLog），而不是结束进程。<paramref name="body"/> 只负责画
    /// 内容：BeginFrame/PresentFrame 由循环完成。</summary>
    void RunLoop(FrameBody body) {
        Show();
        if (frameBody == null) { this.SetFrameBody(body); }
        while (isRunning) {
            if (!this.PumpGuarded()) { break; }
            if (!needsRedraw) { continue; }
            // 最小化（或整窗被遮住）时不画：这时候客户区是 0×0，
            // 所有停靠都被压成零宽，而按宽度换行的内容（聊天记录、
            // 表格）会按最小宽度把整份内容重排一遍，而且没一个像素
            // 给人看。needsRedraw 留着，恢复时那一帧照旧尺寸重新画。
            if (!window.IsVisible()) { continue; }
            this.FrameGuarded(body);
        }
    }

    // 护栏调用的目标只能是静态函数指针（原生侧拿不到实例），因此
    // 这一圈要处理的 App/帧体先放到这里，再由 GuardBody 取回。
    static App guardApp;
    static FrameBody guardBody;
    // 0 = 事件分发（PumpSafe），1 = 画一帧（SafeFrame）。
    static int guardWhat;
    static bool guardPumpAlive;

    static void GuardBody(nint arg) {
        App a = App.guardApp;
        if (a == null) { return; }
        if (App.guardWhat == 0) { App.guardPumpAlive = a.PumpSafe(); }
        else { a.SafeFrame(App.guardBody); }
    }

    /// <summary>PumpSafe 再加一层原生故障护栏：Zan 异常由 PumpSafe
    /// 捕获，而硬故障（越界、空指针、除零，以及生成代码里失败的
    /// 运行时检查）由护栏记录后丢掉这一次事件——两者都不再让
    /// 进程消失。</summary>
    bool PumpGuarded() {
        App.guardApp = this;
        App.guardWhat = 0;
        App.guardPumpAlive = isRunning;
        if (!Window.GuardCall((nint)App.GuardBody, 0)) {
            // 这次事件在原生层崩了：记录（zan_crash.log 里已有带
            // 回溯的记录）、重画一帧，然后继续泵下一个事件。
            this.NoteFrameError("event", "native fault recovered");
            this.RequestRedraw();
            return isRunning;
        }
        return App.guardPumpAlive;
    }

    /// <summary>SafeFrame 再加一层原生故障护栏：这一帧里的硬故障
    /// 只丢掉这一帧。</summary>
    bool FrameGuarded(FrameBody body) {
        App.guardApp = this;
        App.guardWhat = 1;
        App.guardBody = body;
        if (!Window.GuardCall((nint)App.GuardBody, 0)) {
            this.NoteFrameError("frame", "native fault recovered");
            // 这一帧半途而废：脏区裁剪已经不可信，下一帧整窗重画。
            this.CancelPartialFrame();
            this.RequestRedraw();
            return false;
        }
        return true;
    }

    /// <summary>本次运行被原生护栏吞掉的硬故障次数。</summary>
    static int NativeFaultCount() { return Window.GuardRecovered(); }

    /// <summary>ProcessEvent 的受保护版本：事件处理（回调、
    /// 命令、绑定）里抛出的异常不再终止进程。
    /// 返回 false 只表示窗口要求退出。</summary>
    bool PumpSafe() {
        try {
            return ProcessEvent();
        } catch (Exception ex) {
            this.NoteFrameError("event", ex.Message);
            return isRunning;
        }
    }

    /// <summary>在异常保护下画一帧（BeginFrame → body →
    /// PresentFrame）。返回 false 表示这一帧失败并已记录；
    /// 写自己循环的应用可以直接用它换掉裸的
    /// BeginFrame/PresentFrame 对。</summary>
    bool SafeFrame(FrameBody body) {
        try {
            BeginFrame();
            body();
            PresentFrame();
            return true;
        } catch (Exception ex) {
            this.NoteFrameError("frame", ex.Message);
            // 这一帧残缺：丢掉那个脏区裁剪，下一帧全重绘。
            this.CancelPartialFrame();
            this.RequestRedraw();
            return false;
        }
    }

    /// 滚轮把内容挪到指针底下之后重算悬停目标。滚轮帧处理时命中
    /// 区还是上一帧（滚动前）的，就地 HitTest 只会得到同样过期的
    /// 目标——所以在出帧之后按新注册的矩形重算；变了就补一条
    /// 悬停条带帧，把新旧两个目标的预览都画对。没有这一步，滚轮
    /// 滚过后悬停预览一直挂在滚动前的那一行上（指针明明已经在
    /// 另一行上），直到下一次指针移动才被纠正。
    void RefreshScrollHover() {
        if (!this.scrollHoverDirty) { return; }
        this.scrollHoverDirty = false;
        int nh = hitTester.HitTest(mouseX, mouseY);
        if (nh == focus.hoveredId) { return; }
        int oh = focus.hoveredId;
        focus.SetHovered(nh);
        this.NoteRedrawWhy("scroll-hover");
        if (!needsRedraw) { this.NoteHoverDamage(oh, nh); }
        needsRedraw = true;
    }

    /// <summary>记录一条被捕获的界面异常。</summary>
    void NoteFrameError(string origin, string message) {
        lastFrameError = origin + ": " + message;
        frameErrors = UiErrorLog.Record(origin, message);
    }

    /// <summary>本次运行被捕获的界面异常数。</summary>
    int FrameErrorCount() { return frameErrors; }

    /// <summary>最后一条被捕获的界面异常（没有则为空串）。</summary>
    string LastFrameError() { return lastFrameError; }

    /// 自定义标题栏占用的高度；内容应从其下方开始。
    /// 边框隐藏时为 0（见 SetChromeVisible）。
    int ContentTop() {
        if (!showChrome) { return 0; }
        return titlebarH;
    }

    /// Client dimensions exposed without leaking the backing Canvas to
    /// application layout code. Controls and forms use these for their root
    /// arrange pass; direct pixel drawing remains an internal App concern.
    int ClientWidth() { return canvas.Width(); }
    int ClientHeight() { return canvas.Height(); }

    /// 绘制无边框窗口的标题栏（品牌 + 拖动区域 + 最小化/最大化/关闭
    /// 标题按钮）并处理标题按钮的点击。应
    /// 每帧最后绘制，以便覆盖内容。
    void RenderChrome(string title) {
        // 异形/无边框窗口自成一派：不显示标题栏边框，
        // 除非应用通过 SetChromeVisible(true) 显式重新启用。
        if (!showChrome) { return; }
        StyleBox chromeStyle = Style.Full(this, "titlebar", "", "",
                                           Style.SNormal());
        StyleBox brandStyle = Style.Part(this, "titlebar", "brand", "",
                                         "", "", Style.SNormal());
        StyleBox titleStyle = Style.Part(this, "titlebar", "title", "",
                                         "", "", Style.SNormal());
        StyleBox glassStyle = Style.Part(this, "titlebar", "glass", "",
                                         "", "", Style.SNormal());
        StyleBox sheenStyle = Style.Part(this, "titlebar", "sheen", "",
                                         "", "", Style.SNormal());
        StyleBox edgeStyle = Style.Part(this, "titlebar", "edge", "",
                                        "", "", Style.SNormal());
        StyleBox edgeHighlightStyle = Style.Part(this, "titlebar",
                                                  "edge-highlight", "",
                                                  "", "", Style.SNormal());
        Canvas c = canvas;
        Theme t = theme;
        int W = c.Width();
        int hbar = titlebarH;

        // 在磨砂玻璃皮肤下，标题栏也会磨砂其后的内容
        // （模糊 + 半透明主题着色 + 微弱白色光泽），
        // 使边框与玻璃主体协调，而非落在扁平的实色条上。
        if (t.glass != 0) {
            // 标题栏是每帧同一个元素：固定身份，永不换槽。
            int tslot = this.BlurSlotFor(1);
            c.BlurRectCached(0, 0, W, hbar, Scale(22),
                tslot, this.BackdropDirtyIn(tslot, 0, 0, W, hbar));
            c.FillRect(0, 0, W, hbar, glassStyle.BgOr(0));
            c.FillRect(0, 0, W, hbar, sheenStyle.BgOr(0));
        } else {
            c.FillRect(0, 0, W, hbar, chromeStyle.BgOr(0));
        }
        if (chromeStyle.borderBottomW > 0) {
            c.FillRect(0, hbar - chromeStyle.borderBottomW, W,
                       chromeStyle.borderBottomW, chromeStyle.borderBottomColor);
        }

        int pad = t.paddingLarge;
        int brand = t.iconSizeSmall;
        c.DrawGlyph("home", pad, (hbar - brand) / 2, brand,
                    brandStyle.FgOr(0));
        int titleFs = titleStyle.FontOr(Style.FontFallback(this, "medium"));
        int txtY = Canvas.CenterTextY(0, hbar, titleFs);
        int titleX = pad + brand + t.gapSmall;
        c.DrawText(titleX, txtY, title,
                   titleStyle.FgOr(0), titleFs);

        // 应用写入的动态信息紧跟标题；标题按钮之前留一段空白，
        // 文本挤不进去时整段省略，不与按钮重叠。
        if (chromeStatus != "" || chromeAccent != "") {
            StyleBox statusStyle = Style.Part(this, "titlebar", "status", "",
                                              "", "", Style.SNormal());
            StyleBox accentStyle = Style.Part(this, "titlebar", "status-accent",
                                              "", "", "", Style.SNormal());
            int fsS = statusStyle.FontOr(titleFs);
            int sy = Canvas.CenterTextY(0, hbar, fsS);
            int sx = titleX + Canvas.MeasureText(title, titleFs)
                     + t.gapLarge;
            int limit = W - pad;
            if (showChrome) { limit = limit - ChromeButtonCount() * captionBtnW; }
            if (chromeStatus != "") {
                int sw = Canvas.MeasureText(chromeStatus, fsS);
                if (sx + sw <= limit) {
                    c.DrawText(sx, sy, chromeStatus, statusStyle.FgOr(0), fsS);
                    sx = sx + sw + t.gapLarge;
                }
            }
            if (chromeAccent != "") {
                int aw = Canvas.MeasureText(chromeAccent, fsS);
                if (sx + aw <= limit) {
                    c.DrawText(sx, sy, chromeAccent, accentStyle.FgOr(0), fsS);
                }
            }
        }


        int themeId = RenderCaptionButtons(c, t, W, hbar);

        // 原生玻璃（分层）窗口没有 OS 投影，其边缘可能
        // 融入相近的壁纸。为整个窗口描一圈细边
        // 并加上更亮的顶部高光，使边界清晰可辨。
        if (glassNative) {
            int H = c.Height();
            c.DrawRect(0, 0, W, H, edgeStyle.BgOr(0), 1);
            c.FillRect(0, 0, W, 1, edgeHighlightStyle.BgOr(0));
        }

        // 将预设菜单推迟到覆盖层渲染，使其浮于所有
        // 内容之上，选项命中区获得更高 z 顺序。菜单
        // 在标题按钮下右对齐；若会裁出边缘则向内微调。
        if (themeMenuOpen.Get()) {
            AddOverlay(OverlayPopup.ThemeDrawer(themeMenuBaseId, themeId,
                themeMenuOpen, themeMenuScroll));
        }
    }

    /// 标题按钮（主题/置顶/最小化/最大化/关闭）：x 布局、悬停水色、字形、
    /// 命中区与点击处理。返回主题按钮的焦点 id，供
    /// 调用方在其下方锚定主题预设抽屉。
    int RenderCaptionButtons(Canvas c, Theme t, int W, int hbar) {
        StyleBox capStyle = Style.Part(this, "titlebar", "cap", "",
                                       "", "", Style.SNormal());
        StyleBox capHoverStyle = Style.Part(this, "titlebar", "cap", "",
                                             "", "", Style.SHover());
        StyleBox capSelectedStyle = Style.Part(this, "titlebar", "cap", "",
                                                "", "", Style.SSelected());
        StyleBox closeHoverStyle = Style.Part(this, "titlebar", "cap", "",
                                               "danger", "", Style.SHover());
        int bw = captionBtnW;
        int closeX = -bw;
        int nextX = W;
        if (showCloseButton) {
            closeX = W - bw;
            nextX = closeX;
        }
        int maxX = -bw;
        int minX = -bw;
        int pinX = -bw;
        int themeX = -bw;
        if (showMaximizeButton) { nextX = nextX - bw; maxX = nextX; }
        if (showMinimizeButton) { nextX = nextX - bw; minX = nextX; }
        if (showPinButton) { nextX = nextX - bw; pinX = nextX; }
        if (showThemeButton) { nextX = nextX - bw; themeX = nextX; }

        // 标题按钮的 id 固定在专属段内：它们在一帧的最后分配，
        // 若跟随帧内计数器，任何条件出现的表面（右键菜单、
        // 对话框、toast）都会把它们整体挪位，于是上一帧解析出的
        // 指针目标落到本帧的另一个控件上（信号乱串）。
        focus.PushIds(990000);
        int themeId = focus.AllocId();
        int pinId = focus.AllocId();
        int minId = focus.AllocId();
        int maxId = focus.AllocId();
        int closeId = focus.AllocId();
        focus.PopIds();

        bool themeH = focus.IsHovered(themeId);
        bool pinH = focus.IsHovered(pinId);
        bool minH = focus.IsHovered(minId);
        bool maxH = focus.IsHovered(maxId);
        bool closeH = focus.IsHovered(closeId);

        // 标题悬停水色遵循当前主题自身的悬停令牌，使
        // 窗口控件与每种皮肤保持协调（玻璃/渐变上为半透明水色，
        // 浅/深色上为主题灰），而非
        // 固定灰色。关闭按钮保留标志性的 Windows 红色。
        int capHover = capHoverStyle.BgOr(0);
        int closeRed = closeHoverStyle.BgOr(0);
        if (showThemeButton && themeH) {
            c.FillRect(themeX, 0, bw, hbar, capHover);
        }
        if (showPinButton && pinH) {
            c.FillRect(pinX, 0, bw, hbar, capHover);
        }
        if (showMinimizeButton && minH) {
            c.FillRect(minX, 0, bw, hbar, capHover);
        }
        if (showMaximizeButton && maxH) {
            c.FillRect(maxX, 0, bw, hbar, capHover);
        }
        if (showCloseButton && closeH) {
            c.FillRect(closeX, 0, bw, hbar, closeRed);
        }

        // 标题字形以 Windows 和微信使用的
        // 小型"标题"字号（约 11px）渲染——细而清晰而非粗壮——并在
        // 每个 46 宽的按钮中居中，呈现精致均衡的标题栏。
        int gl = (t.iconSizeCaption * 33) / 25;
        // 主题/置顶字形在视觉上比几何的
        // 最小化/最大化/关闭笔画更轻，因此绘制时放大约 5% 以显得大小一致。
        int glBig = (gl * 21) / 20;
        if (glBig <= gl) { glBig = gl + 1; }
        int gcolor = capStyle.FgOr(0);

        // 主题控件："调色板"字形；该按钮打开皮肤
        // 选择抽屉。
        int themeColor = gcolor;
        if (themeH || themeMenuOpen.Get()) {
            themeColor = capHoverStyle.FgOr(0);
        }
        string themeIcon = "color";
        if (showThemeButton) {
            c.DrawGlyphIn(themeIcon, themeX, 0, bw, hbar, glBig, themeColor);
        }

        // 置顶：激活时使用强调色 + 实心字形。
        int pinColor = gcolor;
        if (pinH) { pinColor = capHoverStyle.FgOr(0); }
        string pinIcon = "pin";
        if (isTopmost) {
            pinIcon = "unpin";
            pinColor = capSelectedStyle.FgOr(0);
        }
        if (showPinButton) {
            c.DrawGlyphIn(pinIcon, pinX, 0, bw, hbar, glBig, pinColor);
        }

        int minColor = gcolor;
        if (minH) { minColor = capHoverStyle.FgOr(0); }
        if (showMinimizeButton) {
            c.DrawGlyphIn("minimize", minX, 0, bw, hbar, gl, minColor);
        }

        string maxName = "maximize";
        if (window.IsMaximized()) { maxName = "restore"; }
        int maxColor = gcolor;
        if (maxH) { maxColor = capHoverStyle.FgOr(0); }
        if (showMaximizeButton) {
            c.DrawGlyphIn(maxName, maxX, 0, bw, hbar, gl, maxColor);
        }

        int xcolor = gcolor;
        if (closeH) { xcolor = closeHoverStyle.FgOr(0); }
        if (showCloseButton) {
            c.DrawGlyphIn("close", closeX, 0, bw, hbar, gl, xcolor);
        }

        if (showThemeButton) {
            hitTester.RegisterRect(themeId, themeX, 0, bw, hbar, 3);
        }
        if (showPinButton) {
            hitTester.RegisterRect(pinId, pinX, 0, bw, hbar, 3);
        }
        if (showMinimizeButton) {
            hitTester.RegisterRect(minId, minX, 0, bw, hbar, 3);
        }
        if (showMaximizeButton) {
            hitTester.RegisterRect(maxId, maxX, 0, bw, hbar, 3);
        }
        if (showCloseButton) {
            hitTester.RegisterRect(closeId, closeX, 0, bw, hbar, 3);
        }

        // 标题栏在宿主 Flush 之后才绘制，而独立 App.Run 根本不 Flush，
        // 所以提示必须在这里当帧绘制，不能再走 pending 通道。
        int tipId = 0;
        int tipX = 0;
        if (showThemeButton && this.CaptionTipShown(themeId, themeX, bw, hbar)) {
            Tooltip.RenderAt(this, themeX + bw / 2, hbar, themeTipText,
                Tooltip.Bottom(), this.Scale(260));
            tipId = themeId;
            tipX = themeX;
        }
        if (showPinButton && this.CaptionTipShown(pinId, pinX, bw, hbar)) {
            Tooltip.RenderAt(this, pinX + bw / 2, hbar, pinTipText,
                Tooltip.Bottom(), this.Scale(260));
            tipId = pinId;
            tipX = pinX;
        }
        if (showMinimizeButton && this.CaptionTipShown(minId, minX, bw, hbar)) {
            Tooltip.RenderAt(this, minX + bw / 2, hbar, minimizeTipText,
                Tooltip.Bottom(), this.Scale(260));
            tipId = minId;
            tipX = minX;
        }
        if (showMaximizeButton && this.CaptionTipShown(maxId, maxX, bw, hbar)) {
            string maxTip = maximizeTipText;
            if (window.IsMaximized()) { maxTip = restoreTipText; }
            Tooltip.RenderAt(this, maxX + bw / 2, hbar, maxTip,
                Tooltip.Bottom(), this.Scale(260));
            tipId = maxId;
            tipX = maxX;
        }
        if (showCloseButton && this.CaptionTipShown(closeId, closeX, bw, hbar)) {
            Tooltip.RenderAt(this, closeX + bw / 2, hbar, closeTipText,
                Tooltip.Bottom(), this.Scale(260));
            tipId = closeId;
            tipX = closeX;
        }
        this.NoteCaptionTip(tipId, tipX, bw, hbar);

        // 标题按钮和其它控件走同一套点击语义：只认主键、只认
        // 本帧解析出的那个点击目标。以前这里直接对当前坐标做
        // 命中测试，于是右键松开也会“点”到标题按钮（右键落在
        // 皮肤按钮上会闪一下抽屉，落在关闭上直接关窗），弹层
        // 盖住按钮时点击也会同时被两边收下。
        if (this.EventKind() == 3 && window.EventButton() == 0) {
            int hit = this.ClickTarget();
            if (showThemeButton && hit == themeId) {
                if (!themeMenuOpen.Get()) { themeMenuScroll.Set(0); }
                themeMenuOpen.Set(!themeMenuOpen.Get());
                this.NoteRedrawWhy("RenderCaptionButtons");
                needsRedraw = true;
            } else if (showPinButton && hit == pinId) {
                isTopmost = !isTopmost;
                window.SetTopmost(isTopmost);
                this.NoteRedrawWhy("RenderCaptionButtons");
                needsRedraw = true;
            } else if (showMinimizeButton && hit == minId) {
                window.Minimize();
            } else if (showMaximizeButton && hit == maxId) {
                window.ToggleMaximize();
            } else if (showCloseButton && hit == closeId) {
                window.Close();
            }
        }
        return themeId;
    }

    /// 记下「下一帧为什么只能整窗重绘」的第一个理由（仅分析器开着
    /// 时；见 fullWhy）。声明了范围的重绘不经过这里。
    void NoteRedrawWhy(string why) {
        if (!App.PerfOn()) { return; }
        redrawCount = redrawCount + 1;
        if (redrawWhy != "") { return; }
        redrawWhy = why;
    }

    void RequestRedraw() {
        // 未声明范围的重绘：无法知道哪些像素变了，因此
        // 下一帧整窗重绘（NoteDamage 是声明了范围的那一个）。
        if (App.PerfOn()) {
            string why = markNow;
            if (why == "") { why = "ev@" + Convert.ToString(scopeId); }
            this.NoteRedrawWhy(why);
        }
        partialBlocked = true;
        partialPending = false;
        needsRedraw = true;
        // 由状态（而非单纯悬停移动）请求的重绘可能触及任意
        // 像素，因此它会取消悬停移动在同一事件处理中
        // 早些时候武装的损伤裁剪帧。
        partialPending = false;
    }

    /// 为循环动画请求*限速*重绘：下一帧
    /// 安排在不迟于 `minIntervalMs` 之后，事件循环
    /// 在此之前休眠（空闲，零 CPU），而非以 60fps 忙渲染。与
    /// RequestRedraw 不同，它不强制立即出帧，因此持续
    /// 动画的控件（旋转指示器、骨架屏闪烁）以较低的
    /// 节奏重绘页面。同一帧内有多个动画时，更早的截止时间胜出。
    /// 输入仍会及时唤醒事件循环。
    void RequestAnimationFrame(int minIntervalMs) {
        int due = Window.GetTickMs() + minIntervalMs;
        if (animNextMs < 0 || due < animNextMs) { animNextMs = due; }
        // 没有声明范围：下一次动画帧只能整窗重绘。
        animRectAll = true;
    }

    void RequestWakeIn(int minIntervalMs) {
        int due = Window.GetTickMs() + minIntervalMs;
        if (wakeNextMs < 0 || due < wakeNextMs) { wakeNextMs = due; }
    }

    void RequestWakeAt(int dueMs) {
        if (wakeNextMs < 0 || dueMs < wakeNextMs) { wakeNextMs = dueMs; }
    }

    void RequestWakeFrameIn(int minIntervalMs) {
        int due = Window.GetTickMs() + minIntervalMs;
        if (wakeFrameNextMs < 0 || due < wakeFrameNextMs) {
            wakeFrameNextMs = due;
        }
    }

    /// 与 RequestAnimationFrame 相同，但同时声明这个动画只会
    /// 改变 [x,y,w,h] 这块像素。若一帧里所有动画都声明了范围，
    /// 由动画唤醒的那一帧就裁剪到它们的并集：转圈指示器、
    /// 边框流光、卡片光泽只重绘自己那一小块，而不是让整页
    /// 每 16~90ms 重新混合一遍（这正是空闲时 CPU 居高不下的原因）。
    void RequestAnimationFrameIn(int minIntervalMs, int x, int y, int w, int h) {
        int due = Window.GetTickMs() + minIntervalMs;
        if (animNextMs < 0 || due < animNextMs) { animNextMs = due; }
        if (w <= 0 || h <= 0) { animRectAll = true; return; }
        int pad = this.Scale(6);
        int x0 = x - pad;
        int y0 = y - pad;
        int x1 = x + w + pad;
        int y1 = y + h + pad;
        // 声明的范围整块落在画布外（收起的面板停在屏外、滚出视口的
        // 行）：它一个可见像素也改不了，所以这一拍不是「不知道范围」
        // 而是「范围为空」——退回整窗重绘反而把最省的情形变成最贵的
        // 那一种。收缩成 1 像素的损伤：循环照样按时醒来跑轮询逻辑，
        // 却几乎不画东西。
        if (x1 <= 0 || y1 <= 0 || x0 >= canvas.Width() || y0 >= canvas.Height()) {
            x0 = 0;
            y0 = 0;
            x1 = 1;
            y1 = 1;
        }
        if (animRectValid) {
            if (animRX < x0) { x0 = animRX; }
            if (animRY < y0) { y0 = animRY; }
            if (animRX + animRW > x1) { x1 = animRX + animRW; }
            if (animRY + animRH > y1) { y1 = animRY + animRH; }
        }
        if (x0 < 0) { x0 = 0; }
        if (y0 < 0) { y0 = 0; }
        if (x1 > canvas.Width()) { x1 = canvas.Width(); }
        if (y1 > canvas.Height()) { y1 = canvas.Height(); }
        if (x1 - x0 <= 0 || y1 - y0 <= 0) { animRectAll = true; return; }
        animRX = x0;
        animRY = y0;
        animRW = x1 - x0;
        animRH = y1 - y0;
        animRectValid = true;
    }

    /// 当本帧玻璃表面之后的内容可能已变化时为 true
    /// （任何 OS 输入/缩放/主题变更），若本帧只是背景不变的
    /// 纯动画帧则为 false。玻璃表面将其传给
    /// Canvas.BlurRectCached，使旋转指示器/提示条复用缓存的模糊。
    bool BackdropDirty() {
        return backdropDirty;
    }

    /// 这块玻璃区域本帧是否需要重新模糊。整窗帧同 BackdropDirty()；
    /// 损伤裁剪帧只有与脏矩形相交的区域才算脏——条带外的面板一个
    /// 像素也写不出去，重算纯属白费（连校验和都不用算）。
    /// 另外 slot 本帧刚换手时必须重算：里面是上一位主人的像素。
    ///
    /// 滚动串（连续的滚轮/拖拽，见 NoteScrollDamage）里再放宽一档：
    /// 与条带相交的面板也暂用缓存的旧模糊。此时重卷积只能拿到条带
    /// 外上一帧的合成像素，结果注定不准、还得把下一帧扩成面板并集
    /// 重来；不如先欠着——细条带照常便宜地走，串一结束由 EndFrame
    /// 武装一帧「条带 ∪ 欠账面板」的扩展刷新统一还账。磨砂玻璃对
    /// 快速滚动中的一两帧模糊滞后不敏感，账还清后像素严格正确。
    bool BackdropDirtyIn(int slot, int x, int y, int w, int h) {
        if (slot < 0) { return true; }
        if (freezeAnimClock) { return true; }
        if (slot < blurSlotNew.Count && blurSlotNew[slot] == frameCount) {
            return true;
        }
        if (glassRefreshOwe && partialFrame && !this.ScrollBurstActive()
            && this.RectHitsDamage(x, y, w, h)) {
            // 还账帧：裁剪已扩到欠账面板，这里必须真算。
            return true;
        }
        if (!backdropDirty) { return false; }
        if (!partialFrame) { return true; }
        if (!this.RectHitsDamage(x, y, w, h)) { return false; }
        if (this.ScrollBurstActive()) {
            this.NoteGlassDeferred(x, y, w, h);
            return false;
        }
        return true;
    }

    bool ScrollBurstActive() {
        return nowMs < scrollBusyUntilMs;
    }

    bool RectHitsDamage(int x, int y, int w, int h) {
        if (x + w <= dmgX || dmgX + dmgW <= x) { return false; }
        if (y + h <= dmgY || dmgY + dmgH <= y) { return false; }
        return true;
    }

    /// 登记一块在滚动串里暂用旧模糊的面板（还账清单）。
    void NoteGlassDeferred(int x, int y, int w, int h) {
        glassDeferred = true;
        glassRefreshOwe = true;
        // 串里又欠了新的：之前武装过的还账帧不再算数（它没罩住
        // 这块新面板），串结束后按更全的清单重新武装。
        glassRefreshArmedAt = 0 - 1;
        if (glassDeferredRects.Count >= 128) { return; }
        glassDeferredRects.Add(x);
        glassDeferredRects.Add(y);
        glassDeferredRects.Add(w);
        glassDeferredRects.Add(h);
    }

    void ReuseBackdrop() {
        backdropDirty = false;
    }

    bool PointerPressed() {
        return focus.pressedId >= 0;
    }

    /// 为匿名玻璃表面（没有控件身份可用）取模糊缓存槽：以
    /// 「本帧第 n 个匿名面板」为身份，等价于旧的按绘制顺序分配。
    int NextBlurSlot() {
        blurSlotSeq = blurSlotSeq + 1;
        return this.BlurSlotFor(0 - blurSlotSeq);
    }

    /// 玻璃面板的身份键。控件 id（StyleBox.fxId 之类）给 idKey；
    /// 没有 id 可用时用 BlurKey(kind, 几何)：位置/尺寸不变的面板
    /// 至少能每帧拿回同一个槽。两者分奇偶两个命名空间（id 键为奇、
    /// 几何键为偶），不会互相撞车；匿名面板用负键。
    int BlurKeyId(int id) {
        if (id == 0) { return 0; }
        int k = id;
        if (k < 0) { k = 0 - k; }
        return k * 2 + 1;
    }

    int BlurKey(int kind, int x, int y, int w, int h) {
        int k = kind * 1000003 + x * 9176 + y * 313 + w * 31 + h;
        if (k < 0) { k = 0 - k; }
        return k * 2 + 2;
    }

    /// 按稳定身份 `key` 取该玻璃面板的模糊缓存槽：同一元素每帧
    /// 拿到同一个槽，因此绘制顺序变化、别处的面板出现或消失都不再
    /// 让它丢掉缓存。key=0 视为匿名，退回按绘制顺序。返回 -1 表示
    /// 无槽可用（回退为未缓存模糊）。
    int BlurSlotFor(int key) {
        if (key == 0) { return this.NextBlurSlot(); }
        int free = -1;
        int lru = 0;
        int lruUse = -1;
        int i = 0;
        while (i < 64) {
            if (blurSlotKey[i] == key) {
                blurSlotUse[i] = frameCount;
                return i;
            }
            if (blurSlotKey[i] == 0) {
                if (free < 0) { free = i; }
            } else if (blurSlotUse[i] != frameCount
                       && (lruUse < 0 || blurSlotUse[i] < lruUse)) {
                // 本帧已经用过的槽不参与淘汰：否则一屏超过 64 块
                // 玻璃时，后面的面板会抢走前面面板刚拿到的槽，
                // 每帧互相踢来踢去，谁的缓存都留不住。
                lru = i;
                lruUse = blurSlotUse[i];
            }
            i = i + 1;
        }
        int slot = free;
        if (slot < 0) {
            if (lruUse < 0) { return -1; }
            slot = lru;
        }
        blurSlotKey[slot] = key;
        blurSlotUse[slot] = frameCount;
        blurSlotNew[slot] = frameCount;
        return slot;
    }

    /// 上报焦点文本控件的插入符位置（客户区像素），使 IME
    /// 组合/候选窗口跟随光标，而非固定在
    /// 窗口原点。聚焦期间由 Input/TextArea 每帧调用。
    void SetImeCaret(int x, int y) {
        Ime.SetCaret(x, y);
    }

    /// <summary>
    /// 将委托封送到该窗口的 UI 线程——相当于
    /// C# 的 <c>Control.Invoke</c>/<c>BeginInvoke</c>。可从任意
    /// 线程安全调用：委托入队（运行时内用 OS 互斥锁保护）并
    /// 在下一帧开始时于 UI 线程运行，之后
    /// 请求重绘。后台工作线程用它把结果交回，
    /// 而无需在非 UI 线程触碰界面状态。窗口关闭后，
    /// 委托被丢弃而非入队：已没有 UI 线程可运行它，
    /// 且让它在*下一个*窗口运行也是错误的。
    /// </summary>
    void Post(Action handler) {
        if (!isRunning) { return; }
        Dispatcher.Post(handler);
        // 若循环阻塞在 WaitEvent 中则唤醒它，使排队的工作
        // 及时运行，而非等待下一个输入事件。
        window.Wake();
    }

    /// <summary>
    /// 结束事件循环，并丢弃所有仍通过
    /// <see cref="Post"/> 排队的委托。在每次窗口关闭路径上调用：
    /// 为已关闭窗口投递的后台工作不得在下一个
    /// 窗口上运行，其帧循环复用了同一个全局分派队列。
    /// </summary>
    void StopLoop() {
        isRunning = false;
        Dispatcher.Clear();
    }

    /// <summary>编程式关闭窗口：等效于点击标题栏的关闭按钮
    /// （post WM_CLOSE，随后从事件循环正常退出）。供自绘
    /// 退出按钮、场景切换（"OpenScene" 动作结束当前场景）这类
    /// 代码侧触发"该窗口该关了"的路径使用。</summary>
    void RequestClose() {
        window.Close();
    }

    /// <summary>
    /// 在 UI 线程上运行所有通过 <see cref="Post"/> 排队的委托，
    /// 若有运行则请求重绘。每个事件循环
    /// 迭代由 ProcessEvent 自动调用；手写循环也可直接调用。
    /// </summary>
    void DrainPosts() {
        Action handler = Dispatcher.Take();
        while (handler != null) {
            handler();
            this.NoteRedrawWhy("handler");
            needsRedraw = true;
            handler = Dispatcher.Take();
        }
    }

    /// 查找动画键对应的行索引，没有则为 -1。行由
    /// AnimTo/AnimPx 追加，并保持六列索引对齐。
    int AnimIndex(int key) {
        for (int i = 0; i < anims.Count; i = i + 1) {
            if (anims[i].key == key) { return i; }
        }
        return -1;
    }

    void AnimAdd(int key, int val, int target, int durMs) {
        anims.Add(new AnimSlot(key, val, target, val, nowMs, durMs));
    }

    /// 按键持久化的整数状态（复用动画 KV 存储作为
    /// 通用保留状态表）。使模型每帧重建的即时模式控件
    /// 能保留交互状态（图例显示/隐藏、dataZoom
    /// 范围等），以稳定 id 为键。StateSet 直接设定值，无补间。
    int StateGet(int key, int dflt) {
        int idx = AnimIndex(key);
        if (idx < 0) { return dflt; }
        return anims[idx].cur;
    }

    void StateSet(int key, int val) {
        int idx = AnimIndex(key);
        if (idx < 0) { AnimAdd(key, val, val, 1); return; }
        AnimSlot a = anims[idx];
        a.cur = val;
        a.dst = val;
        a.src = val;
    }

    /// 按时间缓动的按键值（千分比，0..1000）补间，
    /// 在 `durMs` 内趋向 `target`，返回*已缓动*的当前值（
    /// 不再用 Ease 包裹）。进度为 (now - start)/duration，因此运动
    /// 与帧率或定时器精度无关，保持平滑。中途重新设目标时
    /// tween 从当前值重新开始；首次出现时直接跳变。
    int AnimToValue(int key, int target, int durMs) {
        int idx = AnimIndex(key);
        if (idx < 0) {
            AnimAdd(key, target, target, durMs);
            return target;
        }
        AnimSlot a = anims[idx];
        if (a.dst != target) {
            a.src = a.cur;
            a.dst = target;
            a.startMs = nowMs;
            a.dur = durMs;
        }
        int from = a.src;
        int tgt = a.dst;
        if (from == tgt) { a.cur = tgt; return tgt; }
        int dur = a.dur;
        if (dur < 1) { dur = 1; }
        int elapsed = nowMs - a.startMs;
        if (elapsed < 0) { elapsed = 0; }
        int p = elapsed * 1000 / dur;
        if (p > 1000) { p = 1000; }
        int e = App.Ease(p);
        int val = from + (tgt - from) * e / 1000;
        a.cur = val;
        if (p >= 1000) { a.cur = tgt; }
        return a.cur;
    }

    bool AnimActive(int key) {
        int idx = AnimIndex(key);
        if (idx < 0) { return false; }
        return anims[idx].cur != anims[idx].dst;
    }

    /// 把一次性入场动画重置到 0，用于 toolbox 还原。
    void AnimRestart(int key, int durMs) {
        int idx = AnimIndex(key);
        if (durMs < 1) { durMs = 1; }
        if (idx < 0) {
            this.anims.Add(new AnimSlot(key, 0, 1000, 0, this.nowMs, durMs));
            return;
        }
        AnimSlot a = this.anims[idx];
        a.src = 0;
        a.cur = 0;
        a.dst = 1000;
        a.startMs = this.nowMs;
        a.dur = durMs;
    }

    int AnimTo(int key, int target, int durMs) {
        int value = this.AnimToValue(key, target, durMs);
        if (this.AnimActive(key)) {
            this.NoteRedrawWhy("anim");
            needsRedraw = true;
        }
        return value;
    }

    int AnimToIn(int key, int target, int durMs,
                 int x, int y, int w, int h) {
        int value = this.AnimToValue(key, target, durMs);
        if (this.AnimActive(key)) {
            this.RequestAnimationFrameIn(0, x, y, w, h);
        }
        return value;
    }

    /// 一次性入场 tween：首次出现时在 `durMs` 内将每个 key 的值从 0 缓动到 1000，
    /// 然后保持在 1000。与 AnimTo 不同（AnimTo 会在
    /// 首帧直接跳到目标），它总是播放增长动画，
    /// 因此图表、柱状图或卡片首次绘制时可以从基线向上生长。
    /// 持续请求重绘直至稳定。返回缓动后的
    /// 0..1000 进度。
    int AnimIntroValue(int key, int durMs) {
        int idx = AnimIndex(key);
        if (idx < 0) {
            anims.Add(new AnimSlot(key, 0, 1000, 0, nowMs, durMs));
            return 0;
        }
        AnimSlot a = anims[idx];
        int from = a.src;
        int tgt = a.dst;
        if (from == tgt) { a.cur = tgt; return tgt; }
        int dur = a.dur;
        if (dur < 1) { dur = 1; }
        int elapsed = nowMs - a.startMs;
        if (elapsed < 0) { elapsed = 0; }
        int p = elapsed * 1000 / dur;
        if (p > 1000) { p = 1000; }
        int e = App.Ease(p);
        int val = from + (tgt - from) * e / 1000;
        a.cur = val;
        if (p >= 1000) { a.cur = tgt; }
        return a.cur;
    }

    int AnimIntro(int key, int durMs) {
        int value = this.AnimIntroValue(key, durMs);
        if (this.AnimActive(key)) {
            this.NoteRedrawWhy("anim-intro");
            needsRedraw = true;
        }
        return value;
    }

    int AnimIntroIn(int key, int durMs, int x, int y, int w, int h) {
        int value = this.AnimIntroValue(key, durMs);
        if (this.AnimActive(key)) {
            this.RequestAnimationFrameIn(0, x, y, w, h);
        }
        return value;
    }

    /// 使用指数平滑将每个 key 的值在任意（像素）空间向 `target` 缓动，
    /// 因此适用于任意范围（不像 AnimTo 那样固定
    /// 0..1000）。`tauMs` 是平滑时间常数（越大越慢）。用于
    /// 例如标签页下划线在不同宽度的标签之间滑动。
    int AnimPxValue(int key, int target, int tauMs) {
        int idx = AnimIndex(key);
        if (idx < 0) {
            AnimAdd(key, target, target, tauMs);
            return target;
        }
        AnimSlot a = anims[idx];
        a.dst = target;
        int cur = a.cur;
        if (cur == target) { return cur; }
        int dt = nowMs - lastFrameMs;
        if (dt < 1) { dt = 1; }
        if (dt > 64) { dt = 64; }
        if (tauMs < 1) { tauMs = 1; }
        int f = dt * 1000 / (dt + tauMs);
        int delta = (target - cur) * f / 1000;
        if (delta == 0) {
            if (target > cur) { delta = 1; } else { delta = -1; }
        }
        int next = cur + delta;
        if (delta > 0 && next > target) { next = target; }
        if (delta < 0 && next < target) { next = target; }
        a.cur = next;
        return next;
    }

    int AnimPx(int key, int target, int tauMs) {
        int value = this.AnimPxValue(key, target, tauMs);
        if (this.AnimActive(key)) {
            this.NoteRedrawWhy("anim-step");
            needsRedraw = true;
        }
        return value;
    }

    int AnimPxIn(int key, int target, int tauMs,
                 int x, int y, int w, int h) {
        int value = this.AnimPxValue(key, target, tauMs);
        if (this.AnimActive(key)) {
            this.RequestAnimationFrameIn(0, x, y, w, h);
        }
        return value;
    }

    /// 用 Smoothstep（3t^2 - 2t^3）对千分值做加减速缓动。
    static int Ease(int p) {
        if (p <= 0) { return 0; }
        if (p >= 1000) { return 1000; }
        int t2 = p * p / 1000;
        int t3 = t2 * p / 1000;
        return 3 * t2 - 2 * t3;
    }

    /// 按千分值 p (0..1000) 在 a 和 b 之间线性插值。
    static int Lerp(int a, int b, int p) {
        return a + (b - a) * p / 1000;
    }

    /// 按千分值 p (0..1000) 混合两个打包的 ARGB 颜色，alpha 与 RGB
    /// 一同插值（两端不透明时结果仍不透明）。对以负符号整数
    /// 存储的颜色同样稳健。
    static int LerpColor(int c0, int c1, int p) {
        // 打包的 0xAARRGGBB 颜色以有符号整数存储，因此任何
        // alpha 为 0xFF 的颜色都是负数。先用向下取整的
        // 取模提取低 24 位 RGB（截断的 `c / 65536` 会误解析负数，例如
        // 白色 -1 会被读成纯蓝），再拆分正数值。
        int rgb0 = c0 % 16777216; if (rgb0 < 0) { rgb0 = rgb0 + 16777216; }
        int rgb1 = c1 % 16777216; if (rgb1 < 0) { rgb1 = rgb1 + 16777216; }
        int r0 = rgb0 / 65536;
        int g0 = (rgb0 / 256) % 256;
        int b0 = rgb0 % 256;
        int r1 = rgb1 / 65536;
        int g1 = (rgb1 / 256) % 256;
        int b1 = rgb1 % 256;
        int a0 = (c0 - rgb0) / 16777216; if (a0 < 0) { a0 = a0 + 256; }
        int a1 = (c1 - rgb1) / 16777216; if (a1 < 0) { a1 = a1 + 256; }
        int r = r0 + (r1 - r0) * p / 1000;
        int g = g0 + (g1 - g0) * p / 1000;
        int b = b0 + (b1 - b0) * p / 1000;
        // alpha 与 RGB 一同插值：半透明 token（玻璃皮肤的
        // `--border-primary: #38ffffff`）过去被强制成不透明，
        // 于是深色皮肤上的复选框、边框都描出一道白边。
        int a = a0 + (a1 - a0) * p / 1000;
        return a * 16777216 + r * 65536 + g * 256 + b;
    }

    /// 按千分值 p (0..1000) 将打包颜色向不透明黑色调暗：
    /// 一个命名的阴影锚点，控件无需内联写出黑色常量。
    static int Darken(int color, int p) { return App.LerpColor(color, (int)4278190080, p); }

    /// 按千分值 p (0..1000) 将打包颜色向不透明白色调亮。
    static int Lighten(int color, int p) { return App.LerpColor(color, (int)4294967295, p); }

    /// 按千分值 p (0..1000) 缩放打包颜色已有的 alpha 通道，
    /// 保留其 RGB。p=1000 返回原色，p=0 使其完全
    /// 透明。对不透明颜色和已带 alpha 的颜色（如玻璃色板）都有效，
    /// 因此填充/遮罩可以淡入淡出。
    /// 对符号整数颜色打包稳健（见 LerpColor）。
    static int ScaleAlpha(int color, int p) {
        if (p >= 1000) { return color; }
        if (p < 0) { p = 0; }
        int rgb = color % 16777216; if (rgb < 0) { rgb = rgb + 16777216; }
        int a = (color - rgb) / 16777216; if (a < 0) { a = a + 256; }
        a = a * p / 1000;
        return rgb + a * 16777216;
    }

    /// 可滚动控件在渲染期间调用它，以在悬停时抢占滚轮。
    /// 最后悬停的声明者成为下一输入帧的拥有者，
    /// 因此嵌套视图消费滚轮时不会同时滚动父级。
    bool CaptureWheel(int x, int y, int w, int h) {
        bool inside = mouseX >= x && mouseX < x + w
            && mouseY >= y && mouseY < y + h;
        if (!inside) { return false; }
        wheelClaimSeq = wheelClaimSeq + 1;
        wheelCapX = x;
        wheelCapY = y;
        wheelCapW = w;
        wheelCapH = h;
        wheelCapOrder = wheelClaimSeq;
        return this.EventKind() == 13
            && wheelOwnerOrder == wheelClaimSeq;
    }

    void SetContentHeight(int h) {
        contentHeight = h;
    }

    int ViewportHeight() {
        return canvas.Height();
    }

    int Scale(int v) {
        return v * dpiScale / 100;
    }

    /// 填充结构性框架表面（侧边栏、标签条、工具面板）：
    /// 玻璃皮肤下会磨砂背景，使整个外壳呈现玻璃质感；
    /// 否则为普通的主题填充。`radius` 为 0 时填充方形。
    void FillChrome(int x, int y, int w, int h, int radius, int color) {
        if (theme.glass != 0) {
            this.FillGlass(x, y, w, h, radius, color, 1000);
        } else if (radius > 0) {
            canvas.FillRoundRect(x, y, w, h, radius, color);
        } else {
            canvas.FillRect(x, y, w, h, color);
        }
    }

    /// 填充遮罩表面：皮肤为玻璃且表面
    /// 稳定后（`a`，千分比淡入 alpha，>= 900）磨砂：背景模糊加
    /// 主题色调，壁纸色相仍能透出。真正的系统玻璃
    /// 已模糊桌面，只需轻微着色。其余情况
    /// 为普通（可选淡入淡出）填充。
    void FillGlass(int x, int y, int w, int h, int radius, int color, int a) {
        if (glassNative && a >= 900) {
            canvas.FillRoundRect(x, y, w, h, radius, Style.Fade(color, 300));
        } else if (theme.glass != 0 && a >= 900) {
            // 将磨砂模糊裁剪到面板的圆角半径内，
            // 使角落保留锐利的壁纸；方形模糊上叠加半透明圆角色调
            // 永远无法把模糊的角落重新画回背景。
            int gslot = this.BlurSlotFor(this.BlurKey(1, x, y, w, h));
            bool gdirty = this.BackdropDirtyIn(gslot, x, y, w, h);
            if (radius > 0) {
                canvas.BlurRoundCached(x, y, w, h, this.Scale(36),
                                       gslot, gdirty, radius, 15);
            } else {
                canvas.BlurRectCached(x, y, w, h, this.Scale(36),
                                      gslot, gdirty);
            }
            canvas.FillRoundRect(x, y, w, h, radius, Style.Fade(color, 520));
        } else {
            canvas.FillRoundRect(x, y, w, h, radius, Style.Fade(color, a));
        }
    }

    void SetTheme(Theme t) {
        theme = t;
        this.ScaleThemeMetrics();
        this.ApplySurfaceTranslucency();
        bgThemeGen = bgThemeGen + 1;
        // 应用 CSS 里的 var(--token) 是按主题展开的，换了主题就要
        // 按新调色板重新展开一遍（否则应用样式表还挂着旧颜色）。
        this.ApplyAppCss();
        this.NoteRedrawWhy("SetTheme");
        needsRedraw = true;
    }

    void FreezeAnimClock(int fixedMs) {
        Window.FreezeTick(fixedMs);
        nowMs = Window.GetTickMs();
        freezeAnimClock = true;
        lastFrameMs = nowMs;
        lastPresentMs = nowMs;
        animNextMs = -1;
        wakeNextMs = -1;
        wakeFrameNextMs = -1;
        fxNextMs = -1;
    }

    void UnfreezeAnimClock() {
        Window.UnfreezeTick();
        freezeAnimClock = false;
        nowMs = Window.GetTickMs();
        lastFrameMs = nowMs;
    }

    /// 已到期的帧截止时间（动画 / 唤醒 / 皮肤特效）就地兑现：标记这一帧
    /// 要画，并在纯动画唤醒时把它裁剪到动画自己声明的范围。返回 false
    /// 表示这一拍已由特效层就地呈现、还该继续等下一拍。
    bool TakeDueFrame(int now) {
        bool fxOnly = animNextMs < 0 || now < animNextMs;
        if (fxNextMs >= 0 && now >= fxNextMs && !this.inputNeedsFrame
            && this.FxPresent()) {
            if (fxOnly) {
                // 纯特效拍已就地呈现；继续等待下一个 tick。输入事件
                // 不等：点击目标所在的控件可能根本不在已呈现的范围里。
                return false;
            }
            // 特效拍就地推进了（条带外的背景动画不因持续动画的条带帧
            // 冻结），而页面帧也已到期：接着出页面帧。落到底下通用
            // 路径，纯动画帧照旧裁剪到动画声明的范围。
            needsRedraw = true;
        }
        if (fxOnly && animNextMs >= 0
            && animNextMs - now <= this.FxIntervalMs()
            && !(wakeNextMs >= 0 && now >= wakeNextMs)
            && !(wakeFrameNextMs >= 0 && now >= wakeFrameNextMs)
            && (this.ForceFullFrames() || !animRectValid || animRectAll
                || this.HasOverlays())) {
            // 特效拍没能就地呈现（突发期快照被跳过/失效），但下一个
            // 页面帧已排定且就在一拍之内，而且那一帧会是整窗渲染：
            // 等它。页面帧本就要整窗渲染，顺路以新相位合成特效，背景
            // 动画照常推进。原先这一拍会立即再排一帧整窗重栅——持续
            // 动画（倒计时 100ms/16ms）把页面帧压密之后，特效拍全部
            // 退化成整窗重栅，10~60 次/秒把 CPU 光栅打满，正是
            // "倒计时一动，背景动画一卡一卡"。
            // 局部帧开启且动画声明了范围时页面帧只是条带，条带外的
            // 特效不会推进，不能等——维持原来的立即整窗渲染。
            return false;
        }
        if (fxOnly && wakeFrameNextMs >= 0 && now >= wakeFrameNextMs) {
            wakeFrameNextMs = -1;
            if (wakeNextMs >= 0 && now >= wakeNextMs) {
                wakeNextMs = -1;
            }
            this.NoteRedrawWhy("wake");
            needsRedraw = true;
            return true;
        }
        if (fxOnly && wakeNextMs >= 0 && now >= wakeNextMs) {
            wakeNextMs = -1;
            return true;
        }
        this.NoteRedrawWhy("ProcessEvent");
        needsRedraw = true;
        // 纯动画唤醒：若上一帧所有动画都声明了范围，
        // 把这一帧裁剪到它们的并集。输入事件触发的帧不裁剪：
        // 点击/按键改变哪些像素只有控件渲染时读到 Ui.Clicked
        // 才知道，无法提前声明；而裁剪帧只渲染条带内的控件，
        // 点击目标在条带外时点击既不被处理也不被重绘。
        if (!fxOnly && animRectValid && !animRectAll
            && !this.inputNeedsFrame
            && !this.ForceFullFrames()
            && !this.HasOverlays()) {
            int adX = animRX;
            int adY = animRY;
            int adR = animRX + animRW;
            int adB = animRY + animRH;
            // 上一帧的动画像素也要进这一帧的裁剪，
            // 否则移动中的动画会沿路径留下残影。
            if (animPrevValid) {
                if (animPX < adX) { adX = animPX; }
                if (animPY < adY) { adY = animPY; }
                if (animPX + animPW > adR) {
                    adR = animPX + animPW;
                }
                if (animPY + animPH > adB) {
                    adB = animPY + animPH;
                }
            }
            dmgX = adX;
            dmgY = adY;
            dmgW = adR - adX;
            dmgH = adB - adY;
            // 记下的是这一帧*声明*的范围，不是刚算出的并集。存并集会
            // 让「上一帧画过的」逐帧吞进更早各帧的范围而永不收缩：几十
            // 帧之后裁剪矩形就是全窗，于是每个动画帧都整窗光栅一遍 ——
            // 名义上是局部帧，代价却是整窗帧。
            animPrevValid = true;
            animPX = animRX;
            animPY = animRY;
            animPW = animRW;
            animPH = animRH;
            partialPending = true;
        }
        return true;
    }

    /// 帧截止时间到了就兑现（不等待）。轮询那一路（有人挂起了重绘、
    /// 或自动化驱动每圈都要求轮询）以前完全绕过截止时间：动画帧只在
    /// “阻塞等下一拍”那一路才产生，于是驱动一开，悬停缓动、提示浮出、
    /// toast 收拢这些纯动画帧一帧也不来，界面就停在最后那帧上。
    void PumpDueFrame() {
        int now = Window.GetTickMs();
        int deadline = animNextMs;
        if (deadline < 0 || (wakeNextMs >= 0 && wakeNextMs < deadline)) {
            deadline = wakeNextMs;
        }
        if (deadline < 0
            || (wakeFrameNextMs >= 0 && wakeFrameNextMs < deadline)) {
            deadline = wakeFrameNextMs;
        }
        if (deadline < 0 || (fxNextMs >= 0 && fxNextMs < deadline)) {
            deadline = fxNextMs;
        }
        if (deadline < 0 || now < deadline) { return; }
        this.TakeDueFrame(now);
    }

    bool ProcessEvent() {
        // 推进活动的自动化脚本（注入合成事件，
        // 由同一循环随后轮询并分发）。未启用驱动时为空操作。
        UiDriver.Tick();
        this.PerfMark("sh.evdriver");
        // 如果重绘已挂起（例如点击处理程序在帧中修改了状态），
        // 不要阻塞等待下一个 OS 事件——改为轮询，
        // 让新状态立即绘制。否则阻塞直到事件到达。
        int result;
        int loopT0 = 0;
        int loopPath = 2;
        if (App.PerfOn()) { loopT0 = Window.GetTickMs(); }
        if (needsRedraw || pollPending) {
            // 一次性：要求轮询的一方每圈重新提出，驱动结束后
            // 循环立刻回到阻塞等待，不留下空转。
            pollPending = false;
            loopPath = 0;
            if (!needsRedraw) { this.PumpDueFrame(); }
            // 重绘挂起中（状态变化或动画进行中）。
            // 将忙轮询限制在约 60fps，避免运行中的动画让
            // CPU 以数百帧每秒空转；睡眠帧预算的剩余部分
            // 还能让运动更平滑、更贴合真实时钟节奏。
            int since = Window.GetTickMs() - lastPresentMs;
            if (lastPresentMs > 0 && since < 16) { Window.SleepMs(16 - since); }
            if (needsRedraw) {
                result = window.PollEvent();
            } else {
                // 只有"要求轮询"没有"挂起重绘"（自动化驱动在等时间
                // 或等注入批次排空）：在内核里小睡到下一个事件或最多
                // 8ms——注入的事件会立刻唤醒等待，而循环不再以
                // 数十万圈每秒空转烧掉半个核。
                int now = Window.GetTickMs();
                int slice = 8;
                int dl = animNextMs;
                if (dl < 0 || (wakeNextMs >= 0 && wakeNextMs < dl)) { dl = wakeNextMs; }
                if (dl < 0 || (wakeFrameNextMs >= 0 && wakeFrameNextMs < dl)) { dl = wakeFrameNextMs; }
                if (dl < 0 || (fxNextMs >= 0 && fxNextMs < dl)) { dl = fxNextMs; }
                if (dl >= 0) {
                    int d = dl - now;
                    if (d < 1) { d = 1; }
                    if (d < slice) { slice = d; }
                }
                result = window.WaitEventTimeout(slice);
            }
        } else if (animNextMs >= 0 || wakeNextMs >= 0
                   || wakeFrameNextMs >= 0 || fxNextMs >= 0) {
            loopPath = 1;
            // 节流的动画（spinner 在 animNextMs）和/或皮肤
            // 特效层（fxNextMs）需要未来的帧。休眠（空闲）直到
            // 最早截止时间，而不是以 60fps 忙碌渲染；但
            // 要分小段轮询，以便 OS 输入仍能及时唤醒循环。
            // 仅特效的截止时间由 FxPresent 处理（单次恢复 +
            // 重新合成，不渲染页面）；其余情况标记重绘。
            result = 1;
            bool waitedForEvent = false;
            bool waiting = true;
            while (waiting) {
                int now = Window.GetTickMs();
                int deadline = animNextMs;
                if (deadline < 0 || (wakeNextMs >= 0 && wakeNextMs < deadline)) {
                    deadline = wakeNextMs;
                }
                if (deadline < 0
                    || (wakeFrameNextMs >= 0 && wakeFrameNextMs < deadline)) {
                    deadline = wakeFrameNextMs;
                }
                if (deadline < 0 || (fxNextMs >= 0 && fxNextMs < deadline)) {
                    deadline = fxNextMs;
                }
                if (deadline < 0) { waiting = false; }
                else if (now >= deadline) {
                    if (this.TakeDueFrame(now)) { waiting = false; }
                } else {
                    // 在内核中休眠直到输入或截止时间：一次
                    // 阻塞等待，而非轮询 + 睡眠切片，因此等待
                    // 下一个动画帧不消耗 CPU。
                    waitedForEvent = true;
                    result = window.WaitEventTimeout(deadline - now);
                    if (result != 1) { waiting = false; }
                }
            }
            if (!waitedForEvent) { result = window.PollEvent(); }
        } else {
            result = window.WaitEvent();
        }
        if (App.PerfOn()) { this.PerfLoopTick(loopT0, loopPath); }
        if (result < 0) {
            this.StopLoop();
            return false;
        }

        // 在 UI 线程上运行从后台线程调度来的工作。
        // Wake() 仅投递一个空事件（kind 0）来触发此逻辑。
        DrainPosts();
        this.PerfMark("sh.posts");

        int kind = window.EventKind();
        // 按下/释放/按键触发的那一帧必须整帧重绘（见 inputNeedsFrame）。
        // 滚轮（13）同列：滚轮的消费发生在渲染期（CaptureWheel 仲裁），
        // 且连续滚动时上一帧遗留的损伤条带只盖住上一帧的位移量，本帧
        // 多滚出的那一段会沿用陈旧像素——表现为概率性花屏 + 滚动条与
        // 内容短暂错位（感知为滚动条回跳，只有滚轮滚动出现）。
        if (kind == 2 || kind == 3 || kind == 4 || kind == 5 || kind == 6
            || kind == 13) {
            inputNeedsFrame = true;
        }
        // 新的释放事件：解除上一释放的帧绑定，让本次点击
        // 重新锁定到处理它的那一帧（见 ClickFrameCurrent）。
        // 只认没见过的新事件：动画到期路径可能不泵就出帧，
        // EventKind 回读旧值，单看 kind==3 会把同一次释放
        // 每帧都当成新的。
        if (kind == 3 && window.EventSeq() != clickEvSeq) {
            clickSeenSeq = 0 - 1;
            clickEvSeq = window.EventSeq();
        }

        // 纯动画重绘在无 OS 事件（kind 0）时唤醒：玻璃背后的内容
        // 未变化，因此其模糊 + 静态壁纸可以直接从缓存恢复。
        // 任何真实事件（输入/调整大小等）都会将背景
        // 标记为脏，以便本帧重新计算——除非是纯悬停
        // 移动（kind 1 且未按住按钮）。移动指针永远不会改变
        // 玻璃背后的像素：壁纸是静态的，悬停高亮
        // 绘制在玻璃上方的前景控件上，而非其后。每次光标
        // 划过控件就重新模糊整个框架，正是导致
        // 磨砂主题卡顿的原因，因此悬停复用缓存的模糊 +
        // 壁纸快照。按住拖拽（pressedId >= 0）可能滚动/选择
        // 玻璃背后的内容，因此仍会使背景变脏。
        // 按键在此与悬停移动类似：它绘制光标和
        // 编辑中的文本在前景控件上，永远不会在玻璃后面。
        bool hoverOnly = (kind == 1) && (focus.pressedId < 0);
        bool typed = (kind == 4) || (kind == 5) || (kind == 6);
        backdropDirty = (kind != 0) && !hoverOnly && !typed;

        // 多窗口应用（IDE 主窗 + 子窗 + 悬浮窗）共享线程事件队列：
        // 泵出的原生事件可能属于其它窗口。不属于本窗口的事件留给
        // 宿主在 FrameHook 里按 EventHwnd() 路由（App.ApplyEvent），
        // 此处既不处理也不停止循环——否则子窗口的关闭（kind==8）
        // 会结束主窗口的循环。
        nint evh = Window.EventHwnd();
        if (evh != 0 && evh != window.GetHandle()) {
            return true;
        }

        if (kind == 8) {
            this.StopLoop();
            return false;
        }

        // 让渲染表面始终与真实窗口大小一致。最大化/还原
        // 会在 ShowWindow 内部同步发送 WM_SIZE，且一次性 resize
        // 事件在我们读取前可能已被清除——因此应以
        // 持久的窗口尺寸为准，而非一次性的 kind==7 事件。
        // 这保证 Present() 1:1 拷贝（绝不拉伸/模糊），且布局
        // 和命中测试与鼠标使用相同的坐标系。
        this.SyncSurface();
        this.PerfMark("sh.surface");

        // 失焦（kind 9）需要渲染一帧：打开中的浮层（右键菜单、
        // 下拉）在渲染阶段才能看到失焦并自行关闭。失焦也意味着
        // 抬键会落到别的窗口，按住状态就地清掉，免得留下一个
        // 永远“按着”的指针让之后每次移动都白重绘。
        if (kind == 9) {
            pointerDown = false;
            this.NoteRedrawWhy("blur");
            needsRedraw = true;
        }

        if (kind == 1) {
            mouseX = window.EventX();
            mouseY = window.EventY();
            int hitId = hitTester.HitTest(mouseX, mouseY);
            int oldHover = focus.hoveredId;
            focus.SetHovered(hitId);
            if (hitId != oldHover) {
                if (!needsRedraw) { this.NoteHoverDamage(oldHover, hitId); }
                else { this.NoteRedrawWhy("hover-late"); }
                needsRedraw = true;
            }
            // 当控件被按住（如滑块/滚动条拖拽）时，
            // 随指针移动持续重绘，使数值实时跟随光标。
            if (focus.pressedId >= 0) {
                this.NoteRedrawWhy("drag");
                needsRedraw = true;
            }
            // 按住按钮：即时模式的拖拽（设计器抓手/框选/缩放手柄）写在
            // 渲染代码里，按在空白处时没有任何控件被按下，所以必须
            // 单看按键状态让每次移动都到达一帧，否则拖不动。
            if (pointerDown) {
                this.NoteRedrawWhy("pointer-down");
                needsRedraw = true;
            }
            int cursorId = hitId;
            if (focus.pressedId >= 0) { cursorId = focus.pressedId; }
            int wtype = hitTester.GetWidgetType(cursorId);
            if (wtype == 0) {
                Window.SetCursor(1);
            } else if (wtype == 1) {
                Window.SetCursor(2);
            } else if (wtype == 4) {
                Window.SetCursor(3);
            } else if (wtype == 5) {
                Window.SetCursor(4);
            } else if (wtype == 6) {
                Window.SetCursor(6);
            } else if (wtype == 7) {
                Window.SetCursor(7);
            } else if (wtype == 8) {
                Window.SetCursor(8);
            } else {
                Window.SetCursor(0);
            }
        }

        if (kind == 2) {
            mouseX = window.EventX();
            mouseY = window.EventY();
            int hitId = hitTester.AnchorAt(0, mouseX, mouseY, false);
            if (window.EventButton() == 1) {
                // 次要按钮：记录 Ui.RightClicked 的目标，
                // 但不动主焦点/按下状态，这样右键
                // 点击永远不会抢走键盘焦点或触发主点击。
                rightPressTargetId = hitTester.AnchorAt(2, mouseX, mouseY,
                    menuBlockPrevious);
                // 主目标是跨帧保留的（上一次左键点在哪个控件上），
                // 而 Ui.Pressed/Ui.Clicked 只看事件类型不看按钮，
                // 所以必须在这里清掉：否则右键会把上一次左键点过的
                // 控件（例如功能区的“发布”）重新触发一次。
                pressTargetId = -1;
                hitTester.ClearAnchor(0);
            } else {
                focus.SetPressed(hitId);
                focus.SetFocused(hitId);
                // 主键按下作废上一次右键解析出的目标：否则被右键
                // 点过的控件会一直认为自己是次要目标，之后在别处的
                // 每一次点击它都会跟着响应（树行被莫名展开/折叠）。
                hitTester.ClearAnchor(2);
                hitTester.ClearAnchor(3);
                rightPressTargetId = -1;
                rightClickTargetId = -1;
                pressTargetId = hitId;
                pointerDown = true;
                NotePressStart(hitId, mouseX, mouseY);
            }
            this.NoteRedrawWhy("NotePressStart");
            needsRedraw = true;
        }

        if (kind == 3) {
            mouseX = window.EventX();
            mouseY = window.EventY();
            int hitId = hitTester.AnchorAt(1, mouseX, mouseY, false);
            if (window.EventButton() == 1) {
                // 次要按钮释放：仅解析右键点击目标，并清掉主点击
                // 目标，这样这一帧没有任何控件看到 Ui.Clicked。
                rightClickTargetId = hitTester.AnchorAt(3, mouseX, mouseY,
                    menuBlockPrevious);
                clickTargetId = -1;
                hitTester.ClearAnchor(1);
            } else {
                pointerDown = false;
                // 对照上一帧仍然完整的
                // 命中区域（含弹层，最上层优先）解析点击目标，
                // 在 BeginFrame 清除它们之前完成，使本帧恰好一个控件看到 Ui.Clicked。
                clickTargetId = hitId;
                NoteRelease(mouseX, mouseY);
                NoteClickTarget(clickTargetId);
                focus.ClearPress();
            }
            this.NoteRedrawWhy("click");
            needsRedraw = true;
        }

        // Tab / Shift+Tab 在上一帧构建的可聚焦环上移动键盘焦点
        // （见 FocusManager.RegisterFocusable）。
        if (kind == 4 && window.EventKeyCode() == 9) {
            if (!this.HasOverlays() && !blocksInputBelow && tabHoldId < 0) {
                int dir = 1;
                if (Modifiers.HasShift(window.EventMods())) { dir = -1; }
                focus.FocusStep(dir);
            }
            this.NoteRedrawWhy("focus-tab");
            needsRedraw = true;
        }

        if (kind == 13) {
            int delta = window.EventKeyCode();
            int viewH = canvas.Height() - titlebarH;
            mouseX = window.EventX();
            mouseY = window.EventY();
            // 滚动把新内容挪到了指针底下：悬停按出帧后的命中区重算
            // （此刻命中区还是上一帧的，只能在 PresentFrame 之后做）。
            this.scrollHoverDirty = true;
            if (focus.pressedId >= 0) {
                // 按住拖拽拥有手势：滑块/滚动条/选区正在跟随指针，
                // 滚轮此刻只更新指针位置（上面已做），不得再滚动
                // 任何内容——否则触摸拖滑块时页面还在背后滚。
                this.NoteRedrawWhy("wheel-pressed");
                needsRedraw = true;
            } else if (this.HasOverlays() || blocksInputBelow) {
                // 弹层和模态遮罩拥有本输入帧。让它们的
                // 渲染路径消费滚轮，而不是移动
                // 浮动表面下方的内容。
                this.NoteRedrawWhy("wheel-blocked");
                needsRedraw = true;
            } else if (mouseX >= wheelCapX && mouseX < wheelCapX + wheelCapW
                       && mouseY >= wheelCapY && mouseY < wheelCapY + wheelCapH) {
                // 指针位于内部滚动的控件上（如
                // DataTable 主体）；让它在渲染期间处理滚轮，
                // 而不是滚动整个页面。变的只有这块视口。
                this.NoteScrollDamage(wheelCapX, wheelCapY, wheelCapW,
                                      wheelCapH);
            } else {
                // 页面级滚动：仅当宿主用 SetContentHeight 声明过可滚
                // 页（contentHeight>0）时才有意义。
                if (contentHeight > 0) {
                    int oldScroll = scrollY;
                    scrollY = scrollY - delta * scrollSpeed / 120;
                    if (scrollY < 0) { scrollY = 0; }
                    int maxScroll = contentHeight - viewH;
                    if (maxScroll < 0) { maxScroll = 0; }
                    if (scrollY > maxScroll) { scrollY = maxScroll; }
                    if (scrollY != oldScroll) {
                        this.NotePageScrollDamage();
                    }
                }
                // 没滚页面也必须出一帧：滚轮消费全部发生在渲染期
                // （CaptureWheel 仲裁），而本分支的触发判据用的是上一
                // 帧的 cap 矩形——指针刚跨入滚动区时该判据已过期，本
                // 帧渲染里其实有声明者会消费这一格。若此处不留整帧承
                // 诺，RunLoop 见 needsRedraw=false 直接跳过渲染，这一
                // 格滚轮就被静默吞掉：滚轮经过区域边界时偶发丢格，步
                // 幅忽大忽小，用户感知为“滚动跳跃”。
                if (!needsRedraw) {
                    this.NoteRedrawWhy("wheel-unclaimed");
                    needsRedraw = true;
                }
            }
        }

        // 字符输入（WM_CHAR）/ 按键按下：重绘，使聚焦的文本框
        // （如 DataTable 过滤搜索框）能在本帧消费按键。
        // 事件槽仍保留该字符供控件读取。
        if (kind == 6 || kind == 4 || kind == 5) {
            this.NoteRedrawWhy("key");
            needsRedraw = true;
        }

        // 真实输入（按下/抬起/滚轮/按键/字符，以及指针真的动了的
        // 移动）记时：环境特效的心跳降速以此为准。
        if (kind >= 2 && kind <= 6) {
            lastInputMs = Window.GetTickMs();
        } else if (kind == 1 && (mouseX != lastInX || mouseY != lastInY)) {
            lastInputMs = Window.GetTickMs();
            lastInX = mouseX;
            lastInY = mouseY;
        }

        // 窗口重新可见时恢复暂停的环境特效。失焦但仍可见的窗口
        // 不会被暂停。
        if (fxSnapValid && fxNextMs < 0 && this.FxActive()
            && window.IsVisible()) {
            fxNextMs = Window.GetTickMs();
        }

        this.PerfMark("sh.eventend");
        return true;
    }

    /// 此应用窗口的原生句柄（用于多窗口事件路由）。
    nint WindowHandle() { return window.GetHandle(); }

    /// 当事件源于本窗口时，将当前已泵出的原生事件
    /// 应用于本窗口（evHwnd == 本窗口）。这使单个
    /// 进程能从共享的事件泵驱动多个顶层窗口
    /// （如 IDE 加一个悬浮对话框）：循环泵出一次，读取事件
    /// hwnd，再通过 ApplyEvent 把事件提供给每个 App。
    /// 若本窗口收到关闭事件则返回 false。
    bool ApplyEvent(nint evHwnd) {
        bool mine = evHwnd == window.GetHandle();
        int kind = window.EventKind();
        // 按下/释放/按键触发的那一帧必须整帧重绘（见 inputNeedsFrame）。
        // 滚轮（13）同列：滚轮的消费发生在渲染期（CaptureWheel 仲裁），
        // 且连续滚动时上一帧遗留的损伤条带只盖住上一帧的位移量，本帧
        // 多滚出的那一段会沿用陈旧像素——表现为概率性花屏 + 滚动条与
        // 内容短暂错位（感知为滚动条回跳，只有滚轮滚动出现）。
        if (kind == 2 || kind == 3 || kind == 4 || kind == 5 || kind == 6
            || kind == 13) {
            inputNeedsFrame = true;
        }
        // 新的释放事件：解除上一释放的帧绑定（见 ClickFrameCurrent）。
        // 与 ProcessEvent 相同，只认没见过的新事件——自定义循环
        // （gallery 等）的动画分支不泵就出帧，EventKind 会回读
        // 上一次释放的旧值，不设防就把一次点击每帧重放一遍。
        if (kind == 3 && window.EventSeq() != clickEvSeq) {
            clickSeenSeq = 0 - 1;
            clickEvSeq = window.EventSeq();
        }
        // 与 ProcessEvent 相同的帧内快速路径：由
        // 多窗口泵驱动的窗口不能为每次鼠标移动和按键
        // 都付出完整的重新模糊代价——在 IDE 尺寸的表面上，
        // 这决定了 50ms 与几毫秒帧的差别。悬停移动和按键都
        // 绘制在玻璃上方的前景控件上，其后的模糊
        // 由缓存提供；按住拖拽可能滚动玻璃后的内容，因此
        // 仍会使背景变脏。
        bool hoverOnly = (kind == 1) && (focus.pressedId < 0);
        bool typed = (kind == 4) || (kind == 5) || (kind == 6);
        backdropDirty = mine && kind != 0 && !hoverOnly && !typed;

        // 与 ProcessEvent 相同的约定：运行控件和后台线程
        // 调度到 UI 线程的工作。多窗口泵通过这里
        // 而非 ProcessEvent 驱动其窗口，因此缺了这一步，
        // 每个投递的处理程序（TreeView.Context、Select 等）都会永远排队，
        // 依赖它们的功能——尤其是上下文菜单——全部失效。
        if (mine) { DrainPosts(); }

        if (mine && kind == 8) {
            this.StopLoop();
            return false;
        }
        if (!mine) {
            // 不是本窗口的事件：所有交互状态
            // 保持原样。控件不再检测共享的原生事件类型（它们
            // 经由 App.EventKind，此处会报告"无事件"），因此
            // 兄弟窗口的点击无法到达本窗口的控件，
            // 而清除按下/点击/焦点状态反而会破坏本窗口中
            // 正常活动的拖拽或按住的按钮。
            return true;
        }

        int curW = window.ClientWidth();
        int curH = window.ClientHeight();
        if (curW > 0 && curH > 0) {
            if (curW != canvas.Width() || curH != canvas.Height()) {
                this.SwapCanvas(curW, curH);
                int viewH = curH - titlebarH;
                int maxScroll = contentHeight - viewH;
                if (maxScroll < 0) { maxScroll = 0; }
                if (scrollY > maxScroll) { scrollY = maxScroll; }
                if (scrollY < 0) { scrollY = 0; }
                this.NoteRedrawWhy("ApplyEvent");
                needsRedraw = true;
            }
        }

        // 失焦（kind 9）需要渲染一帧，让打开中的浮层自行关闭
        // （与 ProcessEvent 相同的约定）。
        if (kind == 9) {
            this.NoteRedrawWhy("blur");
            needsRedraw = true;
        }

        if (kind == 1) {
            mouseX = window.EventX();
            mouseY = window.EventY();
            int hitId = hitTester.HitTest(mouseX, mouseY);
            int oldHover = focus.hoveredId;
            focus.SetHovered(hitId);
            if (hitId != oldHover) {
                // 将下一帧裁剪到离开和进入的控件，
                // 但仅当悬停是唯一的重绘原因时：
                // 状态变化请求的重绘可能触及任意
                // 像素，裁剪掉它会丢失该更新。
                if (!needsRedraw) { this.NoteHoverDamage(oldHover, hitId); }
                this.NoteRedrawWhy("ApplyEvent");
                needsRedraw = true;
            }
            if (focus.pressedId >= 0) {
                this.NoteRedrawWhy("press-hold");
                needsRedraw = true;
            }
            // 按住按钮：即时模式拖拽逻辑（画布元素、选框、
            // 缩放手柄）位于渲染代码中，因此指针按下期间
            // 的每次移动都必须到达一帧，即使不在任何控件上。
            if (pointerDown) {
                this.NoteRedrawWhy("pointer-down");
                needsRedraw = true;
            }
            int cursorId = hitId;
            if (focus.pressedId >= 0) { cursorId = focus.pressedId; }
            int wtype = hitTester.GetWidgetType(cursorId);
            if (wtype == 0) { Window.SetCursor(1); }
            else if (wtype == 1) { Window.SetCursor(2); }
            else if (wtype == 4) { Window.SetCursor(3); }
            else if (wtype == 5) { Window.SetCursor(4); }
            else if (wtype == 6) { Window.SetCursor(6); }
            else if (wtype == 7) { Window.SetCursor(7); }
            else if (wtype == 8) { Window.SetCursor(8); }
            else { Window.SetCursor(0); }
        }

        if (kind == 2) {
            mouseX = window.EventX();
            mouseY = window.EventY();
            int hitId = hitTester.AnchorAt(0, mouseX, mouseY, false);
            if (window.EventButton() == 1) {
                rightPressTargetId = hitTester.AnchorAt(2, mouseX, mouseY,
                    menuBlockPrevious);
                pressTargetId = -1;
                hitTester.ClearAnchor(0);
            } else {
                focus.SetPressed(hitId);
                focus.SetFocused(hitId);
                // 主键按下作废上一次右键解析出的目标：否则被右键
                // 点过的控件会一直认为自己是次要目标，之后在别处的
                // 每一次点击它都会跟着响应（树行被莫名展开/折叠）。
                hitTester.ClearAnchor(2);
                hitTester.ClearAnchor(3);
                rightPressTargetId = -1;
                rightClickTargetId = -1;
                pressTargetId = hitId;
                pointerDown = true;
                NotePressStart(hitId, mouseX, mouseY);
            }
            this.NoteRedrawWhy("NotePressStart");
            needsRedraw = true;
        }

        if (kind == 3) {
            mouseX = window.EventX();
            mouseY = window.EventY();
            int hitId = hitTester.AnchorAt(1, mouseX, mouseY, false);
            if (window.EventButton() == 1) {
                rightClickTargetId = hitTester.AnchorAt(3, mouseX, mouseY,
                    menuBlockPrevious);
                clickTargetId = -1;
                hitTester.ClearAnchor(1);
            } else {
                clickTargetId = hitId;
                pointerDown = false;
                NoteRelease(mouseX, mouseY);
                NoteClickTarget(clickTargetId);
                focus.ClearPress();
            }
            this.NoteRedrawWhy("click");
            needsRedraw = true;
        }

        if (kind == 4 && window.EventKeyCode() == 9) {
            if (!this.HasOverlays() && !blocksInputBelow && tabHoldId < 0) {
                int dir = 1;
                if (Modifiers.HasShift(window.EventMods())) { dir = -1; }
                focus.FocusStep(dir);
            }
            this.NoteRedrawWhy("focus-tab");
            needsRedraw = true;
        }

        if (kind == 13) {
            mouseX = window.EventX();
            mouseY = window.EventY();
            int delta = window.EventKeyCode();
            int viewH = canvas.Height() - titlebarH;
            if (focus.pressedId >= 0) {
                // 与 ProcessEvent 的滚轮分支同语义：按住拖拽拥有
                // 手势，滚轮只更新指针位置，不滚动任何内容。
                this.NoteRedrawWhy("wheel-pressed");
                needsRedraw = true;
            } else if (this.HasOverlays() || blocksInputBelow) {
                this.NoteRedrawWhy("wheel-blocked");
                needsRedraw = true;
            } else if (mouseX >= wheelCapX && mouseX < wheelCapX + wheelCapW
                && mouseY >= wheelCapY && mouseY < wheelCapY + wheelCapH) {
                this.NoteScrollDamage(wheelCapX, wheelCapY, wheelCapW,
                                      wheelCapH);
            } else {
                // 与 ProcessEvent 的滚轮分支同语义（见彼处注释）：
                // 页面级滚动只在声明过可滚页时尝试；无论滚没滚，
                // 本帧都必须渲染——渲染期的 CaptureWheel 声明者才是
                // 滚轮真正的消费者，边界处的过期 cap 判据不能把这一
                // 格吞掉。
                if (contentHeight > 0) {
                    int oldScroll = scrollY;
                    scrollY = scrollY - delta * scrollSpeed / 120;
                    if (scrollY < 0) { scrollY = 0; }
                    int maxScroll = contentHeight - viewH;
                    if (maxScroll < 0) { maxScroll = 0; }
                    if (scrollY > maxScroll) { scrollY = maxScroll; }
                    if (scrollY != oldScroll) {
                        this.NotePageScrollDamage();
                    }
                }
                if (!needsRedraw) {
                    this.NoteRedrawWhy("wheel-unclaimed");
                    needsRedraw = true;
                }
            }
        }

        if (kind == 6 || kind == 4 || kind == 5) {
            this.NoteRedrawWhy("key");
            needsRedraw = true;
        }

        // 真实输入（按下/抬起/滚轮/按键/字符，以及指针真的动了的
        // 移动）记时：环境特效的心跳降速以此为准。
        if (kind >= 2 && kind <= 6) {
            lastInputMs = Window.GetTickMs();
        } else if (kind == 1 && (mouseX != lastInX || mouseY != lastInY)) {
            lastInputMs = Window.GetTickMs();
            lastInX = mouseX;
            lastInY = mouseY;
        }

        // 窗口重新可见时恢复暂停的环境特效。失焦但仍可见的窗口
        // 不会被暂停。
        if (fxSnapValid && fxNextMs < 0 && this.FxActive()
            && window.IsVisible()) {
            fxNextMs = Window.GetTickMs();
        }

        return true;
    }

    void PresentFrame() {
        int perfT0 = 0;
        if (App.PerfOn()) { perfT0 = Window.GetTickMs(); }
        // 最后绘制并分发弹层，使其位于所有内容之上并拥有
        // 最顶层命中区域（框架拥有的遮罩/层叠层）。
        RunOverlays();
        // 延迟悬停提示最后绘制：拥有它们的控件帧内渲染较早，
        // 会被同页后续内容甚至弹层盖住。宿主若已自行 Flush 过，
        // 这里就是空操作（队列已清空）。
        Widget.Tooltip.Flush(this);
        Component.Chart.ChartView.FlushTooltips(this);
        // 弹层落定之后再结算原生浮层：此刻本帧所有拦截区都已注册，
        // 能算出网页视图真正该露出的区域（菜单/对话框压住的部分被
        // 裁掉），否则原生层会盖住它上面的一切。
        NativeLayer.Flush(this);
        int perfT1 = 0;
        if (App.PerfOn()) { perfT1 = Window.GetTickMs(); }
        // 标志性皮肤动画：快照完成后的帧（槽位 7），然后
        // 在其上合成特效层。之后的纯特效 tick 恢复
        // 快照并重新合成（FxPresent），无需重新渲染。
        if (this.FxActive()) {
            Canvas fc = canvas;
            // 快照仅用于让之后的*空闲* tick 无需重新渲染即可重新合成
            // 特效。当帧连续快速跟上（滚动、输入、拖拽）时，
            // 下一帧本来就是完整渲染，因此每帧复制整个表面
            // 纯属开销——在 2646x1646 的窗口上，它是
            // 帧内最大的像素流量块。在该突发期间跳过它，
            // 并在活动停止后不久安排一次唤醒；那一帧距其前帧
            // 足够远，可以快照并恢复空闲 tick。
            // 将悬停/焦点/按下快照为本帧的"上一帧"基线，
            int fxNow = Window.GetTickMs();
            if (partialFrame) {
                // 只有损伤条带被重绘（因此那里是合成前的像素），
                // 裁剪仍然生效：以上一整帧的相位重新合成
                // 特效，只覆盖该条带，其余像素保持已合成的状态。
                if (fxSnapValid && presentW * presentH * 2
                    <= fc.Width() * fc.Height()) {
                    // 条带外的画布像素自上一拍以来没被改动过（裁剪
                    // 保证），把条带的干净基面（特效重合成之前）补进
                    // 快照——补丁保持槽的整窗几何，FxPresent 的整窗
                    // 恢复继续匹配，快照对整窗继续有效——持续动画
                    // （倒计时条带帧）期间特效拍仍走"恢复快照+重合成
                    // +整窗提交"的廉价路径，条带外的背景动画照常推进。
                    // 快照本来就无效（上次整帧是突发帧）时补丁救不回
                    // 条带外，保持无效，等下一次非突发整帧重建。条带
                    // 大过半窗时补丁接近整窗复制，放弃——条带外本来
                    // 也剩不下多少特效。
                    fc.SnapshotPatchRect(presentX, presentY, presentW,
                                         presentH, App.FxSnapSlot());
                }
                BackdropFx.Render(this, fc, this.EffectiveFx(), 0, 0, fc.Width(),
                                  fc.Height(), fxFrameMs, theme, dpiScale);
                BackdropFx.TakeDamage();
                fxDamage = null;
                fxTouched = null;
                fxTouchedFull = false;
                if (fxNextMs < 0 || fxNow >= fxNextMs) {
                    // 这一条带帧占用了本该到期的特效拍：把拍子挪到
                    // 此刻，循环下一圈就以廉价特效拍推进条带外的背景。
                    // 到期之前的节奏原样保留——否则条带帧（间隔可短于
                    // 特效周期）会把拍子无限后推，背景动画整段冻结。
                    fxNextMs = fxNow;
                }
            } else {
            // 突发判定只看上一*整窗*帧（条带帧不计，快照的条带区域
            // 随后回写保鲜）：整帧连发（滚动/拖拽风暴）时下一帧反正
            // 还是整帧重栅，复制整个表面纯属开销，跳过；其余情况
            // 一律快照，让特效拍走"恢复+合成+提交"的廉价路径。
            bool burst = lastFullFrameMs > 0
                && fxNow - lastFullFrameMs < 120;
            if (burst) {
                fxSnapValid = false;
                fxDamage = null;
                fxTouched = null;
                fxTouchedFull = false;
                fxNextMs = fxNow + this.FxIntervalMs();
            } else {
                fc.SnapshotRect(0, 0, fc.Width(), fc.Height(),
                                App.FxSnapSlot());
                fxSnapValid = true;
                if (App.PerfOn()) {
                    File.AppendAllText("zan_frame_perf.log", "fframe snap=1\n");
                }
            }
            BackdropFx.Render(this, fc, this.EffectiveFx(), 0, 0, fc.Width(), fc.Height(),
                              fxNow, theme, dpiScale);
            if (!burst) {
                fxDamage = BackdropFx.TakeDamage();
                // 新快照 = 干净基线：累计损伤从此刻的特效矩形重新
                // 起算（与 fxDamage 先共享同一份清单，FxPresent 里
                // 并入新损伤之前 fxDamage 已换到新列表，不会互扰）。
                fxTouched = fxDamage;
                fxTouchedFull = fxDamage.Count / 4 > 1024;
                fxNextMs = Window.GetTickMs() + this.FxIntervalMs();
            } else {
                BackdropFx.TakeDamage();
            }
            fxFrameMs = fxNow;
            if (!window.IsVisible()) { fxNextMs = -1; }
            }
        } else {
            fxNextMs = -1;
        }
        int perfPreMs = 0;
        if (App.PerfOn()) {
            perfPreMs = Window.GetTickMs();
            perfOverlayMs = perfOverlayMs + (perfT1 - perfT0);
            perfFxMs = perfFxMs + (perfPreMs - perfT1);
        }
        // 计数器每帧都读，否则整窗帧会把上一帧的欠账带过来。
        int blurMiss = Canvas.TakeBlurPartialMiss();
        if (partialFrame) {
            canvas.PopClip();
            // 上传矩形用 PushClip 时锁定的 presentX..，而不是现读
            // dmg：渲染期间 dmg 还会增长（渲染中的 NoteDamage、下面
            // 的 WidenDamageToGlass），那些区域本帧没渲染过，画布上
            // 是上一帧的旧像素——上传它们就是拖影与阶梯状残块。扩大的
            // 裁剪经 partialPending 留给下一帧真正渲染后再上屏。
            // 有玻璃面板跨出了损伤条带、且没有可复用的缓存模糊：条带里
            // 的磨砂是拿上一帧的合成结果当背景糊出来的，与整帧渲染不
            // 等价（背景内容变化大时就是可见的拖影）。下一帧把裁剪
            // 扩到相交面板并集重新算；没有可用的并集（或大到接近
            // 整窗）时才升级成整窗重绘。
            if (blurMiss > 0) {
                blurMissStreak = blurMissStreak + 1;
                // 扩裁剪重算过的帧若仍报 miss，模糊核的取样边缘越出了
                // 一切条带，widen 已无力——按 g_blur_partial_miss 的
                // 契约把下一帧升级成整窗，别让滚动串帧帧欠账。
                if (!this.WidenDamageToGlass() || blurMissStreak >= 2) {
                    partialBlocked = true;
                    forceFullNext = true;
                    blurMissStreak = 0;
                    this.NoteRedrawWhy("glass-partial-blur");
                } else {
                    this.NoteRedrawWhy("glass-strip-widen");
                }
                needsRedraw = true;
            } else {
                blurMissStreak = 0;
            }
            if (App.PerfOn()) {
                File.AppendAllText("zan_frame_perf.log",
                    "pframe present=" + Convert.ToString(presentX) + ","
                    + Convert.ToString(presentY) + "+"
                    + Convert.ToString(presentW) + "x"
                    + Convert.ToString(presentH)
                    + " miss=" + Convert.ToString(blurMiss)
                    + "\n");
            }
            window.PresentDirty(presentX, presentY, presentW, presentH);
        } else {
            // 整窗帧重画了每一个像素，就声明整窗上传：呈现范围由
            // 自己的声明决定，而不是运行时的差分影子。影子只依据
            // “上传过什么”，不依据“屏幕上是什么”——一次没上屏的
            // 上传之后，影子与屏幕永久失步，差异比对会把旧帧内容
            // 当作已呈现，滚动停下的残带就是这样留下的。
            window.PresentFull();
            lastFullFrameMs = Window.GetTickMs();
        }
        this.SettleGlassRefresh();
        // 完整帧结束时刷新事件解析基准：条带帧不刷新，条带外沿用
        // 最近一次整帧的命中区（见 HitTester.KeepFullSnapshot）。
        if (!partialFrame) { hitTester.KeepFullSnapshot(); }
        window.Present(canvas);
        UiDriver.NotifyPresented(this);
        if (App.PerfOn()) {
            int endMs = Window.GetTickMs();
            int wholeMs = endMs - perfBeginMs;
            if (wholeMs > perfWorstMs) { perfWorstMs = wholeMs; }
            if (wholeMs > 16) { perfSlowFrames = perfSlowFrames + 1; }
            int styleNow = Style.StatPeek(0);
            int styleMissNow = styleNow - Style.StatPeek(1);
            // 卡顿是单帧事件，平均值看不见：超过一个帧预算的帧单独记
            // 一行，把它花在渲染、呈现、特效还是样式重算上当场分清。
            int spikePart = 0;
            if (partialFrame) { spikePart = 1; }
            int pxFill = Canvas.RasterStat(0, 2);
            int pxBlend = Canvas.RasterStat(1, 2);
            int pxBlur = Canvas.RasterStat(5, 2);
            int pxGlyph = Canvas.RasterStat(10, 2);
            int pxSnap = Canvas.RasterStat(8, 2);
            if (frameCount == 0) {
                int pxRound = Canvas.RasterStat(3, 2);
                int pxGrad = Canvas.RasterStat(2, 2);
                int pxRestore = Canvas.RasterStat(9, 2);
                File.AppendAllText("zan_frame_perf.log",
                    "firstframe whole_ms=" + Convert.ToString(wholeMs)
                    + " render_ms=" + Convert.ToString(perfPreMs - perfBeginMs)
                    + " present_ms=" + Convert.ToString(endMs - perfPreMs)
                    + " bg_ms=" + App.UsAvg(phaseBgUs, 1)
                    + " measure_ms=" + App.UsAvg(phaseMeasUs, 1)
                    + " arrange_ms=" + App.UsAvg(phaseArrUs, 1)
                    + " tree_ms=" + App.UsAvg(phaseTreeUs, 1)
                    + " fill=" + Convert.ToString(pxFill) + "kpx"
                    + " blend=" + Convert.ToString(pxBlend) + "kpx"
                    + " round=" + Convert.ToString(pxRound) + "kpx"
                    + " grad=" + Convert.ToString(pxGrad) + "kpx"
                    + " restore=" + Convert.ToString(pxRestore) + "kpx"
                    + " blur=" + Convert.ToString(pxBlur) + "kpx"
                    + " glyph=" + Convert.ToString(pxGlyph) + "kpx"
                    + " snap=" + Convert.ToString(pxSnap) + "kpx"
                    + " style=" + Convert.ToString(styleNow)
                    + "/" + Convert.ToString(styleMissNow) + "miss"
        + " text_draw_n=" + Convert.ToString(Canvas.TextStat(0))
        + " text_measure_n=" + Convert.ToString(Canvas.TextStat(1))
        + " text_height_n=" + Convert.ToString(Canvas.TextStat(2))
        + " text_font_create_n=" + Convert.ToString(Canvas.TextStat(3))
        + " text_font_hit_n=" + Convert.ToString(Canvas.TextStat(4))
        + " text_draw_hit_n=" + Convert.ToString(Canvas.TextStat(5))
        + " text_draw_miss_n=" + Convert.ToString(Canvas.TextStat(6))
        + " text_measure_hit_n=" + Convert.ToString(Canvas.TextStat(7))
        + " text_measure_miss_n=" + Convert.ToString(Canvas.TextStat(8))
        + " text_draw_us=" + Convert.ToString(Canvas.TextStat(9))
        + " text_measure_us=" + Convert.ToString(Canvas.TextStat(10))
        + " text_height_us=" + Convert.ToString(Canvas.TextStat(11))
        + " text_size_8=" + Convert.ToString(Canvas.TextStat(20))
        + " text_size_9=" + Convert.ToString(Canvas.TextStat(21))
        + " text_size_10=" + Convert.ToString(Canvas.TextStat(22))
        + " text_size_11=" + Convert.ToString(Canvas.TextStat(23))
        + " text_size_12=" + Convert.ToString(Canvas.TextStat(24))
        + " text_size_13=" + Convert.ToString(Canvas.TextStat(25))
        + " text_size_14=" + Convert.ToString(Canvas.TextStat(26))
        + " text_size_15=" + Convert.ToString(Canvas.TextStat(27))
        + " text_size_16=" + Convert.ToString(Canvas.TextStat(28))
        + " text_size_17=" + Convert.ToString(Canvas.TextStat(29))
        + " text_size_18=" + Convert.ToString(Canvas.TextStat(30))
        + " text_size_19=" + Convert.ToString(Canvas.TextStat(31))
        + " text_size_20=" + Convert.ToString(Canvas.TextStat(32))
        + " text_size_21=" + Convert.ToString(Canvas.TextStat(33))
        + " text_size_22=" + Convert.ToString(Canvas.TextStat(34))
        + " text_size_23=" + Convert.ToString(Canvas.TextStat(35))
        + " text_size_24=" + Convert.ToString(Canvas.TextStat(36))
        + " text_size_25=" + Convert.ToString(Canvas.TextStat(37))
        + " text_size_26=" + Convert.ToString(Canvas.TextStat(38))
        + " text_size_27=" + Convert.ToString(Canvas.TextStat(39))
        + " text_size_28=" + Convert.ToString(Canvas.TextStat(40))
        + " text_size_29=" + Convert.ToString(Canvas.TextStat(41))
        + " text_size_30=" + Convert.ToString(Canvas.TextStat(42))
        + " text_size_31=" + Convert.ToString(Canvas.TextStat(43))
        + " text_size_32=" + Convert.ToString(Canvas.TextStat(44))
        + " text_size_33=" + Convert.ToString(Canvas.TextStat(45))
        + " text_size_34=" + Convert.ToString(Canvas.TextStat(46))
        + " text_size_35=" + Convert.ToString(Canvas.TextStat(47))
        + " text_size_36=" + Convert.ToString(Canvas.TextStat(48))
        + " text_size_37=" + Convert.ToString(Canvas.TextStat(49))
        + " text_size_38=" + Convert.ToString(Canvas.TextStat(50))
        + " text_size_39=" + Convert.ToString(Canvas.TextStat(51))
        + " text_size_40=" + Convert.ToString(Canvas.TextStat(52))
                    + " surface=" + Convert.ToString(canvas.Width())
                    + "x" + Convert.ToString(canvas.Height()) + "\n");
            }
            if (wholeMs >= 12) {
                File.AppendAllText("zan_frame_perf.log",
                    "  spike whole_ms=" + Convert.ToString(wholeMs)
                    + " render_ms=" + Convert.ToString(perfPreMs - perfBeginMs)
                    + " present_ms=" + Convert.ToString(endMs - perfPreMs)
                    + " partial=" + Convert.ToString(spikePart)
                    + " style=" + Convert.ToString(styleNow - perfStyleAt)
                    + "/" + Convert.ToString(styleMissNow - perfStyleMissAt)
                    + "miss fill=" + Convert.ToString(pxFill - perfPxFillAt)
                    + "kpx blend=" + Convert.ToString(pxBlend - perfPxBlendAt)
                    + "kpx blur=" + Convert.ToString(pxBlur - perfPxBlurAt)
                    + "kpx glyph=" + Convert.ToString(pxGlyph - perfPxGlyphAt)
                    + " snap=" + Convert.ToString(pxSnap - perfPxSnapAt)
                    + "kpx bg=" + App.UsAvg(phaseBgUs, 1)
                    + " measure=" + App.UsAvg(phaseMeasUs, 1)
                    + " arrange=" + App.UsAvg(phaseArrUs, 1)
                    + " tree=" + App.UsAvg(phaseTreeUs, 1)
                    + " top=" + phaseTopNode
                    + " top_ms=" + App.UsAvg(phaseTopUs, 1)
                    + " scope=" + phaseSecTop
                    + " scope_ms=" + App.UsAvg(phaseSecTopUs, 1)
                    + " mark=" + phaseMarkTop
                    + " mark_ms=" + App.UsAvg(phaseMarkTopUs, 1)
                    + " redraw=" + Convert.ToString(frameWhyN)
                    + "/" + frameWhy
                    + " frame=" + Convert.ToString(frameCount) + "\n");
            }
            phaseTopNode = "";
            phaseTopUs = 0;
            phaseSecTop = "";
            phaseSecTopUs = 0;
            // 段间分账只在一帧之内有意义：跨帧那一段是循环在等事件。
            scopeEndUs = 0;
            phaseMarkTop = "";
            phaseMarkTopUs = 0;
            markAtUs = 0;
            markNow = "";
            perfBgUs = perfBgUs + phaseBgUs;
            perfMeasUs = perfMeasUs + phaseMeasUs;
            perfArrUs = perfArrUs + phaseArrUs;
            perfTreeUs = perfTreeUs + phaseTreeUs;
            phaseBgUs = 0;
            phaseMeasUs = 0;
            phaseArrUs = 0;
            phaseTreeUs = 0;
            perfPxFillAt = pxFill;
            perfPxBlendAt = pxBlend;
            perfPxBlurAt = pxBlur;
            perfPxGlyphAt = pxGlyph;
            perfPxSnapAt = pxSnap;
            perfStyleAt = styleNow;
            perfStyleMissAt = styleMissNow;
            if (partialFrame) {
                perfPartFrames = perfPartFrames + 1;
                perfPartRenderMs = perfPartRenderMs + (perfPreMs - perfBeginMs);
                perfPartPresentMs = perfPartPresentMs + (endMs - perfPreMs);
            } else {
                perfRenderMs = perfRenderMs + (perfPreMs - perfBeginMs);
                perfPresentMs = perfPresentMs + (endMs - perfPreMs);
                this.NoteFullFrameWhy();
            }
            frameWhy = "";
            perfFrames = perfFrames + 1;
            if (perfFrames >= 30) {
                int fullN = perfFrames - perfPartFrames;
                if (fullN <= 0) { fullN = 1; }
                int partN = perfPartFrames;
                if (partN <= 0) { partN = 1; }
                File.AppendAllText("zan_frame_perf.log",
                    "frames=" + Convert.ToString(perfFrames)
                    + " full=" + Convert.ToString(perfFrames - perfPartFrames)
                    + " render_ms=" + App.MsAvg(perfRenderMs, fullN)
                    + " present_ms=" + App.MsAvg(perfPresentMs, fullN)
                    + " partial=" + Convert.ToString(perfPartFrames)
                    + " part_render_ms=" + App.MsAvg(perfPartRenderMs, partN)
                    + " part_present_ms=" + App.MsAvg(perfPartPresentMs, partN)
                    + " overlay_ms=" + App.MsAvg(perfOverlayMs, perfFrames)
                    + " fx_ms=" + App.MsAvg(perfFxMs, perfFrames)
                    + " worst_ms=" + Convert.ToString(perfWorstMs)
                    + " slow16=" + Convert.ToString(perfSlowFrames)
                    + " bg_ms=" + App.UsAvg(perfBgUs, perfFrames)
                    + " measure_ms=" + App.UsAvg(perfMeasUs, perfFrames)
                    + " arrange_ms=" + App.UsAvg(perfArrUs, perfFrames)
                    + " tree_ms=" + App.UsAvg(perfTreeUs, perfFrames)
                    + " why=" + this.FullWhyLine()
                    + " surface=" + Convert.ToString(canvas.Width())
                    + "x" + Convert.ToString(canvas.Height()) + "\n");
                File.AppendAllText("zan_frame_perf.log",
                    "  raster/frame " + App.RasterLine(perfFrames) + "\n");
                fullWhy = new List<WhyTally>();
                perfFrames = 0;
                perfRenderMs = 0;
                perfPresentMs = 0;
                perfPartFrames = 0;
                perfPartRenderMs = 0;
                perfPartPresentMs = 0;
                perfOverlayMs = 0;
                perfFxMs = 0;
                perfWorstMs = 0;
                perfSlowFrames = 0;
                perfBgUs = 0;
                perfMeasUs = 0;
                perfArrUs = 0;
                perfTreeUs = 0;
            }
        }
        frameCount = frameCount + 1;
        lastPresentMs = Window.GetTickMs();
        // 将悬停/焦点/按下快照为本帧的"上一帧"基线，
        // 使下一渲染帧能检测进入/离开和焦点/失焦转换
        // （Ui.Entered/Left/FocusGained/FocusLost）。
        focus.RollFrame();
        // 滚轮把内容挪到指针底下的那一帧在出完帧后重算悬停目标：
        // 此时命中区已按滚动后的新位置注册完毕，重算才是准的。
        // （放在 PresentFrame 而不是 SafeFrame/RunLoop——自托管应用
        // 大多写自己的循环，只有这里是所有应用共用的收口。）
        this.RefreshScrollHover();
    }

    /// 帧分析器的空闲侧：记一圈事件循环走了哪条等待路径、被什么
    /// 唤醒、在循环体外花了多少毫秒，每 2 秒往同一个日志追一行。
    /// path: 0 = 有挂起重绘（轮询），1 = 动画/特效截止时间，
    /// 2 = 阻塞等事件。窗口安静不动时这行应该几乎不增长；它涨得
    /// 快就说明有人在无事可做时反复唤醒 UI 线程。
    void PerfLoopTick(int t0, int path) {
        int now = Window.GetTickMs();
        perfLoops = perfLoops + 1;
        perfLoopMs = perfLoopMs + (now - t0);
        if (path == 0) { perfPollPath = perfPollPath + 1; }
        else if (path == 1) { perfAnimPath = perfAnimPath + 1; }
        else { perfWaitPath = perfWaitPath + 1; }
        int ek = window.EventKind();
        if (ek == 0) { perfEvNone = perfEvNone + 1; }
        else if (ek == 1) { perfEvMove = perfEvMove + 1; }
        else { perfEvOther = perfEvOther + 1; }
        this.PerfMaybeFlushLoop(now);
    }

    /// 把累计的循环/特效计数按 2 秒窗口落盘。除了事件循环本身，
    /// 纯特效 tick（FxPresent 在等待循环内就地呈现，不经过
    /// PerfLoopTick）也调用这里，否则安静的效果层会让日志整段
    /// 缺行，看起来像循环根本没在跑。
    void PerfMaybeFlushLoop(int now) {
        if (perfLoopAt == 0) { perfLoopAt = now; }
        int span = now - perfLoopAt;
        if (span < 2000) { return; }
        File.AppendAllText("zan_frame_perf.log",
            "loops=" + Convert.ToString(perfLoops)
            + " over_ms=" + Convert.ToString(span)
            + " frames=" + Convert.ToString(perfFrames)
            + " wait_ms=" + Convert.ToString(perfLoopMs)
            + " path_poll=" + Convert.ToString(perfPollPath)
            + " path_anim=" + Convert.ToString(perfAnimPath)
            + " path_block=" + Convert.ToString(perfWaitPath)
            + " ev_none=" + Convert.ToString(perfEvNone)
            + " ev_move=" + Convert.ToString(perfEvMove)
            + " ev_other=" + Convert.ToString(perfEvOther)
            + " fx_ticks=" + Convert.ToString(perfFxTicks)
            + " fx_only=" + Convert.ToString(perfFxOnlyTicks)
            + " fx_tick_ms=" + Convert.ToString(perfFxTickMs)
            + " fx_tick_us=" + Convert.ToString(perfFxTickUs)
            + " fx_restore_us=" + Convert.ToString(perfFxRestoreUs)
            + " fx_render_us=" + Convert.ToString(perfFxRenderUs)
            + " fx_present_us=" + Convert.ToString(perfFxPresentUs)
            + " fx_kind=" + Convert.ToString(this.EffectiveFx())
            + " anim_armed=" + Convert.ToString(animNextMs)
            + " fx_armed=" + Convert.ToString(fxNextMs) + "\n");
        perfLoopAt = now;
        perfLoops = 0;
        perfLoopMs = 0;
        perfPollPath = 0;
        perfAnimPath = 0;
        perfWaitPath = 0;
        perfEvNone = 0;
        perfEvMove = 0;
        perfEvOther = 0;
        perfFxTicks = 0;
        perfFxOnlyTicks = 0;
        perfFxTickMs = 0;
        perfFxTickUs = 0;
        perfFxRestoreUs = 0;
        perfFxRenderUs = 0;
        perfFxPresentUs = 0;
    }

    /// 宿主在一大段绘制里埋的标记点：把自上一个标记以来的时间
    /// 记到 `name` 头上（空名字只重置起点），分析器关着时不做事。
    /// 尖尖那一帧只报最贵的一段，不每帧刷一大篇日志。
    void PerfMark(string name) {
        if (!App.PerfOn()) { return; }
        int now = Window.GetTickUs();
        int d = now - markAtUs;
        bool first = markAtUs == 0;
        markAtUs = now;
        // 本帧的第一个标记只定起点：不然跨帧那一段（循环在等事件）
        // 会被记到它头上。
        if (name != "") { markNow = name; }
        if (name == "" || first) { return; }
        if (d > phaseMarkTopUs) {
            phaseMarkTopUs = d;
            phaseMarkTop = name;
        }
    }

    /// 记下这一整窗重绘帧是凭什么整窗重画的：脏区帧只重画一条带，
    /// 整窗帧得把整个页面重新混一遍，因此“谁在不停地要整窗重绘”
    /// 是帧成本的首要问题，而不是帧里画了什么。
    void NoteFullFrameWhy() {
        string why = frameWhy;
        if (why == "") { why = "none"; }
        for (int i = 0; i < fullWhy.Count; i = i + 1) {
            if (fullWhy[i].why == why) {
                fullWhy[i].n = fullWhy[i].n + 1;
                return;
            }
        }
        fullWhy.Add(new WhyTally(why));
    }

    /// 本批里整窗重绘理由的前三名（name:帧数，逗号分隔）。
    string FullWhyLine() {
        List<int> left = new List<int>();
        for (int i = 0; i < fullWhy.Count; i = i + 1) {
            left.Add(fullWhy[i].n);
        }
        string outp = "";
        int taken = 0;
        while (taken < 3) {
            int best = 0 - 1;
            for (int i = 0; i < left.Count; i = i + 1) {
                if (left[i] <= 0) { continue; }
                if (best < 0 || left[i] > left[best]) { best = i; }
            }
            if (best < 0) { break; }
            if (outp != "") { outp = outp + ","; }
            outp = outp + fullWhy[best].why + ":"
                + Convert.ToString(fullWhy[best].n);
            left[best] = 0;
            taken = taken + 1;
        }
        if (outp == "") { return "-"; }
        return outp;
    }

    /// 一个节点自身绘制的耗时（不含子树）：只留本帧最贵的那个。
    void PerfNode(string kind, string nm, int us) {
        if (us <= phaseTopUs) { return; }
        phaseTopUs = us;
        phaseTopNode = kind + "#" + nm;
    }

    /// 开始一段帧内相位计时（分析器关着时是空操作）。
    void PhaseBegin() {
        if (!App.PerfOn()) { return; }
        phaseAtUs = Window.GetTickUs();
    }

    /// 把上一个标记点到现在的时间计到第 `slot` 个相位上：
    /// 0 = 背景，1 = 测量，2 = 排版，3 = 画整棵树。
    void PhaseEnd(int slot) {
        if (!App.PerfOn()) { return; }
        int now = Window.GetTickUs();
        int d = now - phaseAtUs;
        phaseAtUs = now;
        if (d < 0) { return; }
        if (slot == 0) { phaseBgUs = phaseBgUs + d; }
        else if (slot == 1) { phaseMeasUs = phaseMeasUs + d; }
        else if (slot == 2) { phaseArrUs = phaseArrUs + d; }
        else { phaseTreeUs = phaseTreeUs + d; }
    }

    /// `us` 微秒摆到 `n` 帧上，以毫秒保留一位小数。
    static string UsAvg(int us, int n) {
        if (n <= 0) { n = 1; }
        int tenths = us / n / 100;
        return Convert.ToString(tenths / 10) + "."
            + Convert.ToString(tenths % 10);
    }

    /// 为真时所有局部帧路径都退回整窗重绘 + 整窗上传（本应用的默认）。
    bool ForceFullFrames() { return !partialFrames; }

    /// 局部帧（悬停条带、动画矩形、纯特效就地呈现）当前是否开启。
    bool PartialFrames() { return partialFrames; }

    /// 开启/关闭局部帧。**默认关闭**：局部帧要求每一处状态变化都准确
    /// 声明自己改了哪些像素，漏一处旧像素就留在屏上（重复的面板、动画
    /// 的移动轨迹、鼠标划过按钮时的错乱），一个真实应用里漏报的地方是
    /// 堵不完的，所以正确性优先。这是每个应用自己的选择（不是环境变量：
    /// 那会让一台机器上所有 Zan 程序共用一份配置），应用可以把它接到
    /// 自己的设置项上，逐屏验证过再打开。
    void SetPartialFrames(bool on) {
        this.partialFrames = on;
        if (!on) {
            partialPending = false;
            needsRedraw = true;
        }
    }

    /// 本应用要求的光栅器（`RenderBackend.Cpu/Gpu/Auto`）。要看实际生效的
    /// 那个用 <see cref="RenderBackendName"/>：要了 GPU 而这台机器给不出 GL
    /// 上下文时，画面照旧由 CPU 光栅出来。
    int RenderBackendMode() { return renderBackendMode; }

    /// 实际生效的光栅器名字（"cpu" / "gl"），供设置页与日志显示。
    string RenderBackendName() { return Canvas.Backend(); }

    /// 选择本应用用哪个光栅器画每一帧。**默认 CPU**：GPU 后端还有
    /// 阴影/模糊/图片这几个图元在 CPU 上（分派时自动同步帧），并且要靠
    /// 每台机器的 GL 驱动，先让应用自己逐屏验证过再开。切换会带着当前
    /// 窗口内容一起搬过去，不会闪白；随后整窗重画一帧。
    ///
    /// 返回实际装上的后端：1 = GPU，0 = CPU（要了 GPU 拿到 0 就是这台机器
    /// 没有可用的 GL 上下文——远程桌面、虚拟机、CI——不是错误）。
    int SetRenderBackend(int mode) {
        this.renderBackendMode = mode;
        int got = Canvas.SetBackend(mode);
        forceFullNext = true;
        needsRedraw = true;
        return got;
    }

    /// 效果层合成前那一帧的快照槽。快照槽是一张全进程共享的表，
    /// 而 ChartView.RenderCached 的文档把 0-7 给了宿主自己的图表缓存：
    /// 效果层也用 7 的时候，宿主一旦缓存一张图表就把这份全窗快照顶
    /// 掉，下一次效果跳动就把图表的旧像素修复到窗口各处，而且一直
    /// 留到下一次整窗重绘。取一个宿主用不到的高位槽（池按需长到 512）。
    static int FxSnapSlot() { return 384; }

    /// 启用可选帧分析器（ZAN_FRAME_PROF=1）时为真。
    static bool PerfOn() {
        if (App.perfMode == 0) {
            App.perfMode = 2;
            if (Interop.EnvVar("ZAN_FRAME_PROF") == "1") { App.perfMode = 1; }
        }
        return App.perfMode == 1;
    }

    /// `total` 毫秒摊到 `n` 帧上，保留一位小数。每帧的取样本身
    /// 只有毫秒精度，但摊到几十帧上，这一位小数足以看出
    /// 半毫秒量级的变化——整数平均会把它们全抹平。
    static string MsAvg(int total, int n) {
        if (n <= 0) { n = 1; }
        int tenths = total * 10 / n;
        return Convert.ToString(tenths / 10) + "."
            + Convert.ToString(tenths % 10);
    }

    /// 帧分析器输出的一行每帧光栅化工作量：调用数与
    /// 每个图元的数千像素，在 `frames` 帧上取平均。
    static string RasterLine(int frames) {
        List<string> names = new List<string>{
            "fill",
            "blend",
            "grad",
            "round",
            "radial",
            "blur",
            "blurhit",
            "img",
            "snap",
            "restore",
            "glyph",
            "bsimd",
            "bscalar" };
        string line = "";
        for (int i = 0; i < names.Count; i = i + 1) {
            int calls = Canvas.RasterStat(i, 0);
            int kpx = Canvas.RasterStat(i, 1);
            if (calls > 0 || kpx > 0) {
                line = line + names[i] + "=" + Convert.ToString(calls / frames)
                    + "/" + Convert.ToString(kpx / frames) + "kpx ";
            }
        }
        int styleN = Style.StatRead(0);
        int styleHit = Style.StatRead(1);
        line = line + "style=" + Convert.ToString(styleN / frames) + "/"
            + Convert.ToString((styleN - styleHit) / frames) + "miss ";
        for (int rank = 0; rank < 6; rank = rank + 1) {
            int kpx = Canvas.RasterTopBlend(rank, 0);
            int bx = Canvas.RasterTopBlend(rank, 1);
            int by = Canvas.RasterTopBlend(rank, 2);
            int bw = Canvas.RasterTopBlend(rank, 3);
            int ba = Canvas.RasterTopBlend(rank, 5);
            int bh = Canvas.RasterTopBlend(rank, 4);
            if (kpx > 0) {
                line = line + "top" + Convert.ToString(rank) + "="
                    + Convert.ToString(kpx) + "kpx@" + Convert.ToString(bx)
                    + "," + Convert.ToString(by) + "+" + Convert.ToString(bw)
                    + "x" + Convert.ToString(bh) + "a" + Convert.ToString(ba)
                    + " ";
            }
        }
        for (int rank = 0; rank < 6; rank = rank + 1) {
            int kpx = Canvas.RasterTopFill(rank, 0);
            int fx = Canvas.RasterTopFill(rank, 1);
            int fy = Canvas.RasterTopFill(rank, 2);
            int fw = Canvas.RasterTopFill(rank, 3);
            int fh = Canvas.RasterTopFill(rank, 4);
            if (kpx > 0) {
                line = line + "op" + Convert.ToString(rank) + "="
                    + Convert.ToString(kpx) + "kpx@" + Convert.ToString(fx)
                    + "," + Convert.ToString(fy) + "+" + Convert.ToString(fw)
                    + "x" + Convert.ToString(fh) + " ";
            }
        }
        return line;
    }

    void BeginFrame() {
        if (App.PerfOn()) { perfBeginMs = Window.GetTickMs(); }
        if (App.PerfOn()) { Canvas.TextStatEnable(true); }
        // 在任何绘制之前应用新选的内置皮肤，
        // 使整个窗口（内容 + 框架）本帧以新主题重绘。
        this.SyncSkin();
        // 推进动画时钟。AnimTo() 以 (nowMs - lastFrameMs) 作为
        // 流逝步长，缓动按真实时钟速率运行，与帧率无关。
        if (freezeAnimClock) {
            lastFrameMs = nowMs;
        } else {
            lastFrameMs = nowMs;
            nowMs = Window.GetTickMs();
        }
        // 帧开始时清除重绘标志；本帧内调用的处理程序
        // 可再次设置它，请求立即的后续重绘。
        if (App.PerfOn()) {
            if (redrawWhy == "") {
                if (needsRedraw) { redrawWhy = "silent"; }
                else { redrawWhy = "unrequested"; }
            }
            if (frameWhy != "" && redrawWhy == "") {
                // 这一帧之前已经有人交接过理由，却又走了一次
                // BeginFrame：说明一次 Present 对应了两次开帧。
                frameWhy = "rebegin:" + frameWhy;
            } else {
                frameWhy = redrawWhy;
                frameWhyN = redrawCount;
            }
            redrawWhy = "";
            redrawCount = 0;
        }
        needsRedraw = false;
        // 同样清除节流动画的截止时间；仍在运行的动画
        // （spinner 等）会在渲染期间通过 RequestAnimationFrame 重新武装。
        animNextMs = -1;
        wakeNextMs = -1;
        wakeFrameNextMs = -1;
        animRectValid = false;
        animRectAll = false;
        // inputNeedsFrame 此处不清：TakeDueFrame 与本函数下方的条带
        // 裁剪决策都要读它，消费后再复位（见 partialFrame 判定之后）。
        // 槽位 7 的 fx 快照是否过期要到下面 partialFrame 判定之后才能
        // 下结论：条带帧只重画条带，条带外的快照像素仍然准确，条带
        // 分支会把条带的干净基面回写快照，整体继续有效；整帧才作废。
        // 匿名玻璃表面的逐帧编号从头开始（有身份的面板走
        // BlurSlotFor 的常驻表，跨帧保持自己的槽）。
        blurSlotSeq = 0;
        wheelOwnerOrder = wheelCapOrder;
        wheelClaimSeq = 0;
        wheelCapOrder = 0;
        wheelCapW = 0;
        wheelCapH = 0;
        tabHoldId = -1;
        inputBlockPrevious = blocksInputBelow;
        blocksInputBelow = false;
        menuBlockPrevious = menuBlock;
        menuBlock = false;
        frameSeq = frameSeq + 1;
        clickClaimed = false;
        hitTester.Clear();
        glassRects.Clear();
        window.ClearHitGuards();
        focus.ResetIds();
        overlays = new List<OverlayPopup>();
        nativeLayers = new List<NativeLayerReq>();
        nativeOccluders = new List<int>();
        hitOnlyBlockers = new List<int>();
        partialFrame = false;
        partialBlocked = false;
        glassDeferred = false;
        // 输入事件（按下/释放/按键）触发的帧不得继承上一帧遗留的
        // 条带裁剪：条带外的控件本帧不渲染、不注册命中区，锚点认领
        // 与 Ui.Clicked 都会落空——表现为点击无响应/迟钝。条带是
        // 纯动画帧自己声明的，输入帧永远整帧（见 inputNeedsFrame）。
        if (inputNeedsFrame) { partialPending = false; }
        if (partialPending && dmgW > 0 && dmgH > 0) {
            partialFrame = true;
        }
        partialPending = false;
        // 上一帧留下的“下一帧必须整窗”比任何局部声明优先：它记的是
        // 表面上已经有不可信的像素，只重画一条条带永远纠不回来。
        if (forceFullNext) {
            partialFrame = false;
            forceFullNext = false;
            this.NoteRedrawWhy("force-full");
        }
        // 输入帧的整帧承诺已兑现（partialPending 已被上面的判定
        // 消费），复位给下一个事件周期。
        inputNeedsFrame = false;
        // 整窗帧重画了每一个像素，动画的旧位置已被覆盖：
        // 下一次动画帧不必再把它算进裁剪。
        if (!partialFrame) { animPrevValid = false; }
        // 本帧正在重新渲染：整帧会覆盖整个画布，槽位 7 的 fx 快照
        // 从此过期，交给帧尾的突发判定/非突发整帧重建；条带帧只
        // 覆盖条带，快照其余部分仍准确，保持有效使特效拍在持续
        // 动画（倒计时条带）期间仍能廉价整窗推进（条带分支回写）。
        if (!partialFrame) { fxSnapValid = false; }
        if (partialFrame) {
            // 下方内容照常绘制；裁剪将其限制在
            // 损坏条带内，上一帧未触及的像素得以保留。
            canvas.PushClip(dmgX, dmgY, dmgW, dmgH);
            presentX = dmgX;
            presentY = dmgY;
            presentW = dmgW;
            presentH = dmgH;
        }
        if (shapeMode != 0) {
            // 实时缩放露出的边距由外壳按此色填充（见
            // Window.SetResizeBackground）：拖动窗口边框时 OS 先放大窗口、
            // 应用才画出新尺寸的一帧，这条边距若按默认的 0 填充就是闪黑边。
            int resizeBg = 0;
            if (resizeBg != lastResizeBg) {
                lastResizeBg = resizeBg;
                Window.SetResizeBackground(resizeBg);
            }
            // 异形窗口：将整个表面清为完全透明，
            // 轮廓仅由树绘制的像素定义（系统以逐像素 alpha
            // 和抗锯齿边缘合成它）。
            if (partialFrame) {
                canvas.ClearRect(dmgX, dmgY, dmgW, dmgH, 0);
            } else {
                canvas.Clear(0);
            }
        } else {
            StyleBox bgStyle = Style.Full(this, "windowbg", "", "",
                                          Style.SNormal());
            // 实时缩放露出的边距由外壳按此色填充（见
            // Window.SetResizeBackground）：拖动窗口边框时 OS 先放大窗口、
            // 应用才画出新尺寸的一帧，这条边距若按默认的 0 填充就是闪黑边。
            int resizeBg = bgStyle.BgOr(0);
            if (resizeBg != lastResizeBg) {
                lastResizeBg = resizeBg;
                Window.SetResizeBackground(resizeBg);
            }
            if (glassNative) {
                StyleBox glassStyle = Style.Part(this, "windowbg", "glass", "",
                                                 "", "", Style.SNormal());
                // 磨砂表面：将整个窗口清为*半透明*色调
                // （而非完全透明），使系统背景均匀透出
                // 模糊，同时窗口保持为实心带边框的玻璃面板。
                // 完全透明的清除会让窗口在浅色背景上
                // 显得通透/发白（且无边框）。
                if (partialFrame) {
                    canvas.ClearRect(dmgX, dmgY, dmgW, dmgH,
                                     glassStyle.BgOr(0));
                } else {
                    canvas.Clear(glassStyle.BgOr(0));
                }
            } else {
                if (partialFrame) {
                    canvas.ClearRect(dmgX, dmgY, dmgW, dmgH, bgStyle.BgOr(0));
                } else {
                    canvas.Clear(bgStyle.BgOr(0));
                }
            }
        }
    }

    /// 将弹层排队，在主内容绘制之后绘制并分发，
    /// 使其位于一切之上并拥有最顶层命中区域。
    /// <see cref="RunOverlays"/>.
    void AddOverlay(OverlayPopup p) {
        overlays.Add(p);
        // 在损坏裁剪帧期间出现的弹层/工具提示会被
        // 裁剪掉：注册后立即请求一帧完整重绘。
        if (partialFrame) {
            this.NoteRedrawWhy("overlay-in-partial");
            needsRedraw = true;
        }
    }

    /// 按注册顺序绘制并分发本帧注册的所有遮罩。
    /// 在主渲染之后、PresentFrame 之前调用一次。
    void RunOverlays() {
        for (int i = 0; i < overlays.Count; i = i + 1) {
            OverlayPopup p = overlays[i];
            // 每个浮层自成一段 id：一个下拉打开时会多领两个
            // 拦截区 id，若共用一条递增序号，排在它后面的
            // 浮层（以及浮层里的行）就会整体移位，上一帧解析出的
            // 点击目标随之对不上——表现为“点了穿透到下面”。
            focus.PushIds(950000 + i * 1000);
            p.Render(this);
            focus.PopIds();
        }
    }

    /// 本帧有活动的弹层层时为真。
    bool HasOverlays() { return overlays.Count > 0; }

    /// 当模态遮罩/弹层遮罩拥有指针时为真——无论是本帧
    /// （执行了 BlockHitsRect/BlockHitsBelow）还是上一帧
    /// （弹层已存在）。直接读取 mouseX/mouseY 的即时模式控件
    /// 必须用 `!PointerCaptured()` 约束其悬停/按下/点击，
    /// 防止指针穿过弹层落到其下方的层。
    bool PointerCaptured() {
        if (blocksInputBelow || inputBlockPrevious) { return true; }
        // 矩形范围的拦截器（浮动窗口、popover、下拉弹层、加载
        // 遮罩）在自身区域上捕获指针，而无需设置
        // 全局全窗口标志。其下的内容在遮罩注册之前
        // 渲染，因此读取上一帧的拦截器；
        // 拦截器自身主体（本帧已铺设遮罩）通过
        // BlockerAt 排除，以保持可交互。
        return hitTester.PrevBlockerAt(mouseX, mouseY)
            && !hitTester.BlockerAt(mouseX, mouseY);
    }

    /// 注册一个吞掉 [x,y,w,h] 区域点击的命中区域，
    /// 使模态/弹层表面拦截其下的控件。HitTester
    /// 后注册者优先，且遮罩在页面内容之后绘制，因此
    /// 在绘制背景时调用它——且在遮罩自身
    /// 按钮注册之前——可使拦截器除这些按钮外
    /// 处处优先。返回拦截器 id。
    int BlockHitsRect(int x, int y, int w, int h) {
        int id = focus.AllocId();
        hitTester.RegisterRect(id, x, y, w, h, -1);
        return id;
    }

    /// 为客户端区域抢占 [x,y,w,h]，对抗窗口边框的
    /// 边缘缩放手柄。紧贴窗口边缘绘制的控件——如滚动条
    /// 位于最后几像素——否则在那里无法点击：边框的
    /// 手柄先响应系统命中测试，按下永远到不了
    /// 客户区，只有滚轮还能滚动。角手柄保持优先，
    /// 保证对角缩放仍可操作。绘制期间每帧调用一次。
    void ReserveEdgeHit(int x, int y, int w, int h) {
        window.AddHitGuard(x, y, w, h);
    }

    /// 全窗口 BlockHitsRect：模态遮罩的标准遮罩，其
    /// 变暗背景覆盖整个窗口。
    /// 上下文菜单专用的全窗口阻挡：和 BlockHitsBelow 一样吞掉
    /// 主键，但右键仍解析到菜单下方的控件，于是在别处右键会把
    /// 菜单换到新位置重开（Windows 的一贯行为），而不是要求先
    /// 手动关掉当前菜单。
    int BlockHitsMenu() {
        menuBlock = true;
        return this.BlockHitsBelow();
    }

    /// 右键的命中目标。菜单的遮罩不拥有次要按钮，所以这里越过
    /// 阻挡区，解析到其下方的控件。
    int RightHitTest(int px, int py) {
        if (menuBlockPrevious) { return hitTester.HitTestBelowBlockers(px, py); }
        return hitTester.HitTest(px, py);
    }

    int BlockHitsBelow() {
        bool firstBlock = !blocksInputBelow;
        blocksInputBelow = true;
        int id = BlockHitsRect(0, 0, canvas.Width(), canvas.Height());
        hitOnlyBlockers.Add(id);
        if (firstBlock && !inputBlockPrevious) {
            focus.SetFocused(id);
            // 模态在本帧出现，因此正在
            // 分发的点击（打开它的那次）已消耗：否则，
            // 新模态内部与打开按钮同坐标处绘制的表面
            // 会收到同一次点击。
            clickClaimed = true;
        }
        return id;
    }

    /// 正在处理的 OS 事件类型；当事件属于
    /// 其他窗口时为 0（"无事件"）。原生事件状态是
    /// 进程全局的：直接读取 window.EventKind() 的表面也会看到
    /// 投递给兄弟或子窗口的点击和按键，并在 id 恰好
    /// 对齐时触发自己的控件。每个窗口拥有的表面
    /// 都必须询问其 App，而非共享的原生状态。
    int EventKind() {
        if (Window.EventHwnd() != window.GetHandle()) { return 0; }
        return window.EventKind();
    }

    /// 当正在处理的事件投递到了本 App 的窗口时为真。
    bool EventIsMine() { return Window.EventHwnd() == window.GetHandle(); }

    /// 当主点击（mouse-up）事件在本帧有效且
    /// 可由当前渲染的表面处理时为真。即时模式
    /// 表面应测试此函数而非 window.EventKind() == 3：
    /// 点击被认领（此点击恰好打开了模态）时为 false，
    /// 对绘制在*打开的模态遮罩之下*的内容也为 false——
    /// 模态上一帧已存在（inputBlockPrevious），但其 BlockHitsBelow
    /// 本帧尚未运行，意味着询问的代码渲染在其下方。
    /// 模态自身的内部在其遮罩之后渲染，那里此函数为 true，
    /// 因此点击永远不会穿过模态落到下面的页面。
    /// 一次释放只属于它首次被读到的那一帧。持续动画（星空、
    /// spinner）会在下个事件到来前反复出帧，而 EventKind 停留
    /// 在 3；不锁定的话按钮会在每个动画帧重新触发。同一帧内
    /// 多个表面照常都能读到（绑定只记帧序，不做独占）。
    bool ClickFrameCurrent() {
        if (this.clickSeenSeq < 0) { this.clickSeenSeq = this.frameSeq; }
        return this.clickSeenSeq == this.frameSeq;
    }

    /// 当前帧序号（BeginFrame 递增）。诊断用。
    int FrameSeq() { return frameSeq; }

    bool ClickAvailable() {
        if (this.EventKind() != 3 || clickClaimed) { return false; }
        // 触摸拖拽手势的收尾释放不是点击：手指落点随拖动走，
        // 若当点击会把拖窗口/滚动结束时压到的控件误触发。
        if (this.window.EventFlag() == 1) { return false; }
        if (!this.ClickFrameCurrent()) { return false; }
        // 只有主按钮算点击。右键的释放绝不能
        // 被当作点击，否则刚在其上打开上下文菜单的控件
        // 也会被选中/切换，菜单在同一次手势中被关闭。
        if (window.EventButton() != 0) { return false; }
        if (inputBlockPrevious && !blocksInputBelow) { return false; }
        // 矩形范围拦截器（浮动窗口、popover、
        // 下拉选择）同理：落在上一帧已存在拦截器上的点击
        // 属于该遮罩，而非其下的内容——除非询问的表面
        // 是遮罩自身主体（本帧已铺设遮罩）。
        if (hitTester.PrevBlockerAt(mouseX, mouseY)
            && !hitTester.BlockerAt(mouseX, mouseY)) { return false; }
        return true;
    }

    /// 将当前点击标记为本帧余下时间内已被消费。
    void ClaimClick() { clickClaimed = true; }

    /// 当前释放是否已被某表面认领（见 ClaimClick）。
    bool ClickClaimed() { return clickClaimed; }

    /// 当前点击（mouse-up）落到的控件 id，无则 -1。
    int ClickTarget() { return hitTester.AnchorIdOf(1); }

    /// 当前按下（mouse-down）落到的控件 id，无则 -1。
    int PressTarget() { return hitTester.AnchorIdOf(0); }

    /// 当前次要（右键）点击落到的控件 id，无则 -1。
    int RightClickTarget() { return hitTester.AnchorIdOf(3); }

    /// 当前次要（右键）按下落到的控件 id，无则 -1。
    int RightPressTarget() { return hitTester.AnchorIdOf(2); }

    /// 当完成的点击在双击时间窗内是同一控件上的第二次点击时
    /// 为真（见 Ui.DoubleClicked）。
    bool DoubleClickNow() { return doubleClickNow; }

    /// 记录 `id` 上的完成点击，并在 400 ms 内
    /// 同一 id 重复时标记双击。由鼠标释放路径调用。
    void NoteClickTarget(int id) {
        int t = Window.GetTickMs();
        if (id >= 0 && id == lastClickId && (t - lastClickMs) <= 400) {
            doubleClickNow = true;
        } else {
            doubleClickNow = false;
        }
        lastClickId = id;
        lastClickMs = t;
    }

    /// 快照按下目标/位置/时间，使手势（滑动、长按）
    /// 可从按下起推导。由鼠标按下路径调用。
    void NotePressStart(int id, int x, int y) {
        pressStartId = id;
        pressStartX = x;
        pressStartY = y;
        pressStartMs = Window.GetTickMs();
        longPressFired = false;
        swipeDir = 0;
    }

    /// 根据按下到释放的位移推导滑动方向：0 无，
    /// 1 左、2 右、3 上、4 下。由鼠标释放路径调用，
    /// 因此在释放帧通过 SwipeDir 读取是有效的。
    void NoteRelease(int x, int y) {
        int dx = x - pressStartX;
        int dy = y - pressStartY;
        int adx = dx; if (adx < 0) { adx = -adx; }
        int ady = dy; if (ady < 0) { ady = -ady; }
        swipeDir = 0;
        if (adx >= 48 || ady >= 48) {
            if (adx >= ady) {
                if (dx < 0) { swipeDir = 1; } else { swipeDir = 2; }
            } else {
                if (dy < 0) { swipeDir = 3; } else { swipeDir = 4; }
            }
        }
    }

    /// 当前释放帧解析出的滑动方向（见 NoteRelease）。
    int SwipeDir() { return swipeDir; }
    /// 进行中的手势起始控件（按下目标）。
    int SwipeTarget() { return pressStartId; }

    /// 当指针在 `id` 上按住超过阈值且未大幅移动时
    /// 报告长按。按住期间安排低频后续帧，
    /// 即使没有更多输入计时器也能推进；
    /// 每次按下恰好返回一次 true。移动超过小容差则取消
    /// （该手势随后成为拖拽/滑动，而非长按）。
    bool PollLongPress(int id) {
        if (longPressFired) { return false; }
        if (focus.pressedId != id) { return false; }
        if (pressStartId != id) { return false; }
        int mdx = mouseX - pressStartX; if (mdx < 0) { mdx = -mdx; }
        int mdy = mouseY - pressStartY; if (mdy < 0) { mdy = -mdy; }
        if (mdx > 12 || mdy > 12) { longPressFired = true; return false; }
        int t = Window.GetTickMs();
        if ((t - pressStartMs) >= 500) {
            longPressFired = true;
            RequestRedraw();
            return true;
        }
        RequestWakeFrameIn(80);
        return false;
    }
}
