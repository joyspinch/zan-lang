using System;
using Gui.Backend;

namespace Gui;

/// One keyed tween/state slot in App's retained animation store. Replaces the
/// six index-aligned animKeys/animVals/animTarget/animFrom/animStart/animDur
/// parallel lists: `key`=stable id, `cur`=current value, `dst`=target,
/// `src`=value at tween start, `startMs`=tween start time, `dur`=duration (ms).
class AnimSlot {
    int key;
    int cur;
    int dst;
    int src;
    int startMs;
    int dur;

    AnimSlot(int k, int c, int d, int s, int st, int du) {
        key = k;
        cur = c;
        dst = d;
        src = s;
        startMs = st;
        dur = du;
    }
}

class App {
    Window window;
    Canvas canvas;
    Theme theme;
    FocusManager focus;
    HitTester hitTester;
    bool isRunning;
    bool needsRedraw;
    int frameCount;
    int mouseX;
    int mouseY;
    int scrollY;
    int contentHeight;
    int scrollSpeed;
    int dpiScale;
    int titlebarH;
    int captionBtnW;
    int splitX;
    int sidebarScrollY;
    int sidebarContentHeight;
    bool isDark;
    bool isTopmost;
    bool showThemeButton;
    bool showPinButton;
    bool showMinimizeButton;
    bool showMaximizeButton;
    // Title-bar theme picker. When themeNames is non-empty the theme caption
    // button opens a dropdown menu listing these presets (a "color" glyph)
    // instead of toggling dark/light; themeMenuChange fires on a new pick and
    // themeMenuModel carries the chosen index. The option ids live in a stable
    // high WidgetId block so they never collide with the caption button ids.
    List<string> themeNames;
    SignalInt themeMenuModel;
    SignalBool themeMenuOpen;
    SignalInt themeMenuScroll;
    int themeMenuBaseId;
    UiEvent themeMenuChange;
    // Appearance-drawer extras: a forced backdrop-effect kind (-1 = follow the
    // skin) and an accent colour override (0 = skin default), both applied on
    // top of whichever preset is active.
    int fxKindOverride;
    int accentOverride;
    SignalInt themeDrawerTab;
    // Skin switching: when autoSkins is on the title-bar theme button is a menu
    // of the skins on disk (Skin.Names) and App applies the picked one itself
    // (no per-app handler). appliedSkin is the index last applied so RenderChrome
    // detects a new pick each frame. Every window gets this by default.
    bool autoSkins;
    int appliedSkin;
    // Every skin is a CSS pack (`skins/<name>/skin.css`): skinPacks is that list
    // in picker order, so a skin index is just an index into it. skinArt is the
    // artwork the active pack installed as the wallpaper, so switching to a pack
    // that ships none drops it without touching a wallpaper the user picked
    // themselves.
    List<string> skinPacks;
    string skinArt;
    // Opacity the active pack's art was installed with (percent), kept so the
    // art can be reinstalled at the same strength when the user wallpaper is
    // cleared.
    int skinArtOpacity;
    // Active skin stylesheet (CSS) every widget resolves its look against, and
    // the name of the skin pack it came from ("" = none, pure theme tokens).
    // Never null: an empty sheet means "theme defaults only", so widgets can
    // always resolve without a null check.
    StyleSheet sheet;
    // The application's own stylesheet (page layout and app-specific rules).
    // Kept apart from the skin and re-layered on top of every skin change, so
    // switching skins restyles the app without dropping its layout.
    string appCss;
    string skinName;
    // True while the OS is compositing a real translucent backdrop (Win11
    // acrylic / macOS vibrancy / Linux compositor blur) behind this window.
    // Set by ApplyTheme when a glass skin is active. When on, the frame is
    // cleared transparent and the in-app wallpaper is skipped so the blurred
    // desktop shows through the gaps.
    bool glassNative;
    // Whole-window opacity percent last set via SetWindowOpacity (0 = never
    // set, treated as 100/opaque).
    int windowOpacity;
    // Window silhouette: 0 = rectangle, 1 = shaped. Non-zero windows are
    // composed with per-pixel alpha (layered window) or a classic region when
    // DWM is off: BeginFrame clears the surface fully transparent, the tree
    // paints the shape, and the OS composites it. shapeSpec holds the union
    // spec ("t,x,y,w,h,r;..." logical px) and shapeRadius the first region's
    // corner radius (for WindowShapeRadius()).
    int shapeMode;
    int shapeRadius;
    string shapeSpec;
    // Shaped-silhouette drop shadow (logical px spread, 0 = none): painted by
    // RenderBackground before the tree, so each shape region casts a soft
    // shadow. The design's winShadow also makes formgen prepend a type-3
    // "shadow band" region (a full-window rounded rect) to the spec, so the OS
    // surface covers the shadow pixels. shapeRects mirrors the parsed spec in
    // logical px so App can draw the shadow without touching the backend.
    int shapeShadow;
    List<int> shapeRects;
    // Whether the custom title-bar chrome (brand + caption buttons) is drawn.
    // Hidden for shaped/borderless windows whose design supplies its own header;
    // the OS keeps the top TitlebarHeight() strip draggable either way.
    bool showChrome;
    // Rect (in canvas coords) that wants to consume mouse-wheel events this
    // frame — e.g. a DataTable body with its own internal row scroll. When the
    // pointer is inside it, ProcessEvent suppresses page scrolling so the wheel
    // drives the widget instead. Reset every frame in BeginFrame.
    int wheelCapX;
    int wheelCapY;
    int wheelCapW;
    int wheelCapH;
    int wheelClaimSeq;
    int wheelCapOrder;
    int wheelOwnerOrder;
    // Id of a focused widget that consumes Tab itself this frame (e.g. the
    // CodeEditor, which uses Tab/Shift+Tab for indentation). When set, Tab does
    // not step keyboard focus to the next widget. Reset every frame in
    // BeginFrame; set during render by the widget.
    int tabHoldId;
    bool blocksInputBelow;
    bool inputBlockPrevious;
    // The live primary click has been consumed for the rest of this frame --
    // set automatically when a modal scrim first appears mid-frame (the click
    // that opened it is spent) or explicitly via ClaimClick(). Surfaces that
    // read raw click events must test ClickAvailable() instead of the window
    // event directly so a click can never fall through into a modal that it
    // itself just opened. Reset every frame in BeginFrame.
    bool clickClaimed;

    // --- Event delegation ---
    // Target of the current mouse event, resolved once per event in
    // ProcessEvent against the PREVIOUS frame's complete hit regions (which
    // already include popups/overlays on top). Widgets ask Ui.Clicked/Pressed
    // whether they are this target, so a click is delivered to exactly one
    // widget — the top-most one under the pointer — instead of every widget
    // that happens to re-read the raw event during its own render.
    int clickTargetId;
    int pressTargetId;
    bool pointerDown;    // left button held (drags outside widgets need move redraws)
    // Secondary (right) mouse-button targets, resolved the same way as the
    // primary click/press targets but kept separate so a right-click never
    // trips Ui.Clicked or steals keyboard focus. Read via RightClickTarget()
    // / RightPressTarget() (see Ui.RightClicked).
    int rightClickTargetId;
    int rightPressTargetId;
    // Double-click / double-tap detection. lastClickId + lastClickMs record the
    // most recent completed click; doubleClickNow is a one-frame flag set when a
    // second click lands on the same id within the double-click window. Read via
    // DoubleClickNow() / Ui.DoubleClicked.
    int lastClickId;
    int lastClickMs;
    bool doubleClickNow;
    // Touch/pointer gesture state. On a press we snapshot the target id, the
    // pointer position and the wall-clock time; on release we derive a swipe
    // direction from the travel, and while held PollLongPress() reports a
    // long-press once the hold passes the threshold without much movement.
    // Single-finger touch arrives as a synthesized mouse sequence, so these
    // work on touchscreens without any runtime change (multi-touch/pinch would
    // need real WM_TOUCH / XInput2 support in the C runtime).
    int pressStartX;
    int pressStartY;
    int pressStartMs;
    int pressStartId;
    bool longPressFired;
    int swipeDir;
    // Deferred overlay popups (Select/SelectBox/Dropdown/Menu option lists).
    // They run AFTER the main content pass so they both paint above it and
    // register their hit regions last (making them the top-most target). Data,
    // not callbacks, because Zan delegates can't capture locals / bind `this`.
    // Collected during a frame, drained by RunOverlays, cleared in BeginFrame.
    List<OverlayPopup> overlays;

    // --- Animation clock ---
    // Per-key tween state. Widgets call AnimTo()/AnimPx() each frame with a
    // target; the value eases toward it and keeps requesting redraws until it
    // settles, giving smooth transitions on an otherwise event-driven loop.
    // AnimTo is *time-based*: progress = (now - start) / duration, so it is
    // immune to per-frame dt jitter (which used to make the motion stutter).
    // Each slot carries its own key / current value / target / tween-start
    // value / tween-start time (ms) / duration (ms) as an AnimSlot entity.
    List<AnimSlot> anims;
    int nowMs;
    int lastFrameMs;
    // Opt-in frame profiler (ZAN_FRAME_PROF=1): accumulates the render and
    // present cost of every frame and appends one averaged line per 120 frames
    // to zan_frame_perf.log in the process directory. 0 = env not read yet,
    // 1 = on, 2 = off.
    static int perfMode;
    int perfFrames;
    int perfRenderMs;
    int perfPresentMs;
    int perfBeginMs;
    int perfFxMs;
    int perfOverlayMs;
    int lastPresentMs;
    // Wall-clock deadline (ms) at which a *throttled* animation wants its next
    // repaint, or -1 when none is pending. Looping animations (e.g. a loading
    // spinner) register here via RequestAnimationFrame instead of
    // RequestRedraw, so the event loop sleeps between frames and repaints them
    // at a low cadence rather than busy-rendering the whole page at 60fps.
    int animNextMs;

    // True when the current frame processed a real OS event (input, resize,
    // etc). A pure animation repaint (spinner tick, easing step) wakes with no
    // event, leaving the backdrop behind glass unchanged so its blur/wallpaper
    // can be served from cache. See BackdropDirty().
    bool backdropDirty;

    // Per-frame counter handing each glass surface a stable blur-cache slot in
    // draw order. Reset in BeginFrame; incremented by NextBlurSlot().
    int blurSlotSeq;

    // Wallpaper-backdrop cache invalidation. The gradient + soft colour blobs
    // are static: they depend only on the window size and the active skin, not
    // on content/scroll/typing. bgThemeGen bumps on every theme change; the
    // backdrop snapshot records the gen it was painted with (bgSnapGen) so it
    // is restored with a cheap pixel copy on EVERY frame (not just non-dirty
    // ones) until the size or skin actually changes. Repainting the ~80 large
    // feathered blobs each dirty frame is what made glass/gradient skins janky
    // while scrolling or typing.
    int bgThemeGen;
    int bgSnapGen;

    // User wallpaper: an image file painted over the skin's own backdrop and
    // faded into it by bgImageOpacity percent (100 = the photo alone, lower =
    // more skin colour). Empty path = no wallpaper. Part of the backdrop
    // snapshot, so the scaled blit happens only on a skin/size/wallpaper change.
    string bgImagePath;
    int bgImageOpacity;
    // The USER's own wallpaper, distinct from the active skin pack's art: the
    // pack's illustration fills the backdrop only while this is empty, and a
    // skin switch never replaces it. Persisted by the app, so a user-chosen
    // background survives both skin switches and restarts.
    string userWallpaperPath;
    int userWallpaperOpacity;
    // Set when the appearance drawer asks for a wallpaper file. Hosts that own a
    // file picker consume it (ConsumeWallpaperPick) and call SetWallpaper with
    // the chosen path; windows without one ignore it.
    bool bgImagePickWanted;

    // Animated backdrop effects (Theme.fx / Gui.BackdropFx). On by default;
    // SetBackdropFx(false) turns a window's skin motion off. When the active
    // skin carries an effect, RenderBackground layers it over the static
    // wallpaper snapshot and re-arms a throttled animation frame.
    bool fxEnabled;

    // Animated-backdrop fast path. The effect layer is composited on top of
    // the finished frame in PresentFrame, which also snapshots the frame
    // *without* the effect (slot 7). A pure effect tick then costs one
    // full-frame restore + a few dozen small fills + present -- no widget
    // re-render, no glass re-blur. fxNextMs is the next tick deadline (-1 =
    // none); fxSnapValid says slot 7 holds the current frame.
    int fxNextMs;
    bool fxSnapValid;

    // ---- damage-clipped (partial) frames ------------------------------------
    // A pure hover move only changes the widget the pointer left and the one it
    // entered, yet it used to repaint (and re-blend) the whole window. When
    // nothing else happened, the next frame is clipped to the union of those two
    // widget rects: every widget still runs, but its drawing is clipped away, so
    // the cost drops to the damaged strip and Present uploads only that.
    bool partialPending;
    bool partialFrame;
    int dmgX;
    int dmgY;
    int dmgW;
    int dmgH;
    // Pixel rects (x,y,w,h quads) the effect layer touched in the last
    // composited frame; the next effect tick repairs just these from the
    // slot-7 snapshot instead of restoring the whole frame. null = unknown
    // (repair falls back to a full-frame restore once).
    List<int> fxDamage;

    static App Create(string title, int width, int height) {
        App app = new App();
        app.window = Window.Create(title, width, height);
        app.theme = Theme.Light();
        app.focus = FocusManager.Create();
        app.hitTester = HitTester.Create();
        app.isRunning = true;
        app.needsRedraw = true;
        app.frameCount = 0;
        app.mouseX = 0;
        app.mouseY = 0;
        app.scrollY = 0;
        app.contentHeight = 0;
        app.scrollSpeed = 40;
        app.dpiScale = 100;
        app.titlebarH = 32;
        app.captionBtnW = 46;
        app.splitX = 0;
        app.sidebarScrollY = 0;
        app.sidebarContentHeight = 0;
        app.wheelCapX = 0;
        app.wheelCapY = 0;
        app.wheelCapW = 0;
        app.wheelCapH = 0;
        app.wheelClaimSeq = 0;
        app.wheelCapOrder = 0;
        app.wheelOwnerOrder = 0;
        app.tabHoldId = -1;
        app.blocksInputBelow = false;
        app.inputBlockPrevious = false;
        app.clickTargetId = -1;
        app.pressTargetId = -1;
        app.pointerDown = false;
        app.rightClickTargetId = -1;
        app.rightPressTargetId = -1;
        app.lastClickId = -1;
        app.lastClickMs = 0;
        app.doubleClickNow = false;
        app.pressStartX = 0;
        app.pressStartY = 0;
        app.pressStartMs = 0;
        app.pressStartId = -1;
        app.longPressFired = false;
        app.swipeDir = 0;
        app.overlays = new List<OverlayPopup>();
        app.isDark = false;
        app.isTopmost = false;
        app.shapeMode = 0;
        app.shapeRadius = 0;
        app.shapeSpec = "";
        app.showChrome = true;
        app.showThemeButton = true;
        app.showPinButton = true;
        app.showMinimizeButton = true;
        app.showMaximizeButton = true;
        app.themeNames = new List<string>();
        app.themeMenuModel = SignalInt.Create(0);
        app.themeMenuOpen = SignalBool.Create(false);
        app.themeMenuScroll = SignalInt.Create(0);
        app.themeMenuBaseId = 0;
        app.themeMenuChange = UiEvent.Create();
        app.fxKindOverride = 0 - 1;
        app.accentOverride = 0;
        app.themeDrawerTab = SignalInt.Create(0);
        app.autoSkins = false;
        app.appliedSkin = -1;
        app.skinPacks = new List<string>();
        app.skinArt = "";
        app.skinArtOpacity = 100;
        app.sheet = StyleSheet.Create();
        app.appCss = "";
        app.skinName = "";
        app.anims = new List<AnimSlot>();
        app.nowMs = Window.GetTickMs();
        app.lastFrameMs = app.nowMs;
        app.perfFrames = 0;
        app.perfRenderMs = 0;
        app.perfPresentMs = 0;
        app.perfBeginMs = 0;
        app.lastPresentMs = 0;
        app.animNextMs = -1;
        app.fxEnabled = true;
        app.fxNextMs = -1;
        app.fxSnapValid = false;
        app.partialPending = false;
        app.partialFrame = false;
        app.dmgW = 0;
        app.dmgH = 0;
        app.fxDamage = null;
        app.backdropDirty = true;
        app.blurSlotSeq = 0;
        // gen != snapGen so the wallpaper is painted (and snapshotted) once up
        // front, then restored from cache until the skin/size changes.
        app.bgThemeGen = 1;
        app.bgSnapGen = 0;
        app.bgImagePath = "";
        app.bgImageOpacity = 100;
        app.userWallpaperPath = "";
        app.userWallpaperOpacity = 100;
        app.bgImagePickWanted = false;
        app.canvas = Canvas.Create(width, height);
        // Reset the UI-thread dispatch queue up front (on the UI thread) so
        // App.Post is safe the moment any background worker is spawned.
        Dispatcher.Init();
        // Every window gets the built-in skin picker in its title bar by
        // default (light window -> "Light" preselected). The id block is
        // allocated now, before any app WidgetId.Mark, so option ids stay
        // stable. Apps that persisted a skin just call EnableSkins(index).
        app.EnableSkins(1);
        return app;
    }

    static App CreateDark(string title, int width, int height) {
        App app = App.Create(title, width, height);
        app.theme = Theme.Dark();
        app.isDark = true;
        app.EnableSkins(0);
        return app;
    }

    /// Swaps the active theme (light/dark) and re-applies DPI scaling.
    void SetDark(bool dark) {
        isDark = dark;
        if (dark) { theme = Theme.Dark(); } else { theme = Theme.Light(); }
        theme.ScaleByDpi(dpiScale);
        needsRedraw = true;
    }

    /// Installs an arbitrary theme preset (re-applying DPI scaling). `dark`
    /// controls dark-appropriate chrome details (caption hover wash, etc.).
    void ApplyTheme(Theme t, bool dark) {
        isDark = dark;
        theme = t;
        theme.ScaleByDpi(dpiScale);
        // Frosted glass is rendered in-app: a software blur over the themed
        // wallpaper on an opaque window. A native OS-acrylic (layered) window
        // was tried but it altered the look and made the window resize itself
        // (UpdateLayeredWindow drove the window size), so glass skins stay
        // software-rendered here. Always drop any layered style if it was set.
        if (glassNative) { window.DisableGlass(); }
        glassNative = false;
        this.ApplySurfaceTranslucency();
        bgThemeGen = bgThemeGen + 1;
        // The cached frame snapshot and the glass blur caches still hold the
        // previous skin's pixels, and effect ticks restore from them -- leaving
        // them valid mixed the old skin into the new one after a few switches.
        fxSnapValid = false;
        fxDamage = null;
        backdropDirty = true;
        needsRedraw = true;
    }

    /// Loads the skin pack `name` (a `skins/<name>/skin.css` + artwork folder)
    /// and applies its tokens, stylesheet and illustration. Returns false when
    /// the pack was not found, leaving the current look untouched.
    bool UseSkin(string name) {
        Skin s = Skin.Load(name);
        if (!s.IsLoaded()) { return false; }
        s.Apply(this);
        this.ApplyAppCss();
        return true;
    }

    /// Re-reads the active skin's CSS from disk (live skin editing).
    bool ReloadSkin() {
        if (skinName == "") { return false; }
        Skin s = Skin.Reload(skinName);
        if (!s.IsLoaded()) { return false; }
        s.Apply(this);
        this.ApplyAppCss();
        return true;
    }

    /// Installs the application's own stylesheet: the CSS that lays its pages
    /// out (`display: flex`, widths, gaps) and styles its own element classes.
    /// Unlike UseCss it survives skin changes -- it is re-layered on top of each
    /// skin's sheet, whose look still wins for anything the app does not name.
    void UseAppCss(string css) {
        appCss = css;
        this.ApplyAppCss();
        bgThemeGen = bgThemeGen + 1;
        backdropDirty = true;
        needsRedraw = true;
    }

    /// Re-layers the application stylesheet over the active skin's sheet.
    void ApplyAppCss() {
        if (appCss == "") { return; }
        if (sheet == null) { sheet = StyleSheet.Create(); }
        sheet.MergeSheet(StyleSheet.FromCss(appCss));
    }

    /// Installs a stylesheet directly (CSS text authored in-app or shipped as a
    /// resource) without a skin folder.
    void UseCss(string css) {
        sheet = StyleSheet.FromCss(css);
        this.ApplyAppCss();
        bgThemeGen = bgThemeGen + 1;
        fxSnapValid = false;
        fxDamage = null;
        backdropDirty = true;
        needsRedraw = true;
    }

    /// Packed ARGB tint handed to the OS glass compositor: the active skin's
    /// primary background colour at ~59% alpha so the blurred desktop keeps
    /// colour and body presence while text stays readable.
    int GlassTint() {
        int rgb = theme.bgPrimary % 16777216;
        if (rgb < 0) { rgb = rgb + 16777216; }
        return 150 * 16777216 + rgb;
    }

    /// Turns the title-bar theme button into the skin picker (every pack
    /// `Skin.Names` found on disk) and has App apply the chosen skin itself --
    /// no per-app change handler or switch statement. Every window enables this
    /// by default (see Create); call again to preselect a persisted skin.
    /// `index` must be the skin whose theme is already active so the first frame
    /// does not re-apply it. Idempotent: the stable id block is allocated once.
    void EnableSkins(int index) {
        autoSkins = true;
        // Skins are data: `stdlib/Gui/skins`, `./skins` or $ZAN_GUI_SKINS, each
        // a folder with a skin.css of design tokens (and optional rules/art).
        skinPacks = Skin.Names();
        themeNames = Skin.Labels(skinPacks);
        if (themeMenuBaseId == 0) {
            themeMenuBaseId = WidgetId.Block(themeNames.Count + 40);
        }
        themeMenuModel.Set(index);
        appliedSkin = index;
        showThemeButton = true;
        window.SetCaptionButtons(ChromeButtonCount());
        needsRedraw = true;
    }

    void EnableSkins() { this.EnableSkins(0); }

    /// Number of skins the picker offers.
    int SkinCount() { return skinPacks.Count; }

    /// The name of skin `i` ("" when out of range).
    string SkinNameAt(int i) {
        if (i < 0 || i >= skinPacks.Count) { return ""; }
        return skinPacks[i];
    }

    /// The index of the pack named `name`, or -1 when no pack matches. Lookups
    /// by name (not index) let persisted settings survive skins being added or
    /// removed, which shifts every index.
    int SkinIndexOf(string name) {
        if (name == "") { return 0 - 1; }
        int i = 0;
        while (i < skinPacks.Count) {
            if (skinPacks[i] == name) { return i; }
            i = i + 1;
        }
        return 0 - 1;
    }

    /// Applies the pack named `name`, leaving the current look untouched when
    /// it is not installed (e.g. a config written against an older skin list).
    void ApplySkinName(string name) {
        int i = this.SkinIndexOf(name);
        if (i >= 0) { this.ApplySkin(i); }
    }

    /// The Theme skin index `i` installs -- used for the picker's previews, so
    /// each card shows its own palette.
    Theme SkinThemeAt(int i) {
        Skin s = Skin.Load(this.SkinNameAt(i));
        if (s.IsLoaded()) {
            Theme pt = s.NewTheme();
            if (pt != null) { return pt; }
        }
        return Theme.Dark();
    }

    /// Applies skin `i` (tokens + stylesheet + artwork) and records it as the
    /// active skin so the picker stays in sync.
    void ApplySkin(int i) {
        if (!this.UseSkin(this.SkinNameAt(i))) { return; }
        if (accentOverride != 0) {
            theme.primary = accentOverride;
            theme.borderFocus = accentOverride;
            theme.borderHover = accentOverride;
        }
        themeMenuModel.Set(i);
        appliedSkin = i;
    }

    /// When the built-in skin picker's selection changed (user pick), applies
    /// it. Called each frame start so content and chrome repaint together.
    void SyncSkin() {
        if (autoSkins && themeMenuModel.Get() != appliedSkin) {
            this.ApplySkin(themeMenuModel.Get());
            // Delegate event: notify listeners (e.g. so an app can propagate
            // the new skin to its child windows) after the skin is applied.
            themeMenuChange.Raise();
        }
    }

    /// Whole-window opacity in percent (10..100); 100 = opaque. Forwarded to
    /// the OS compositor, so widgets/text fade with the window uniformly.
    void SetWindowOpacity(int percent) {
        if (percent < 10) { percent = 10; }
        if (percent > 100) { percent = 100; }
        windowOpacity = percent;
        window.SetOpacity(percent);
    }

    /// The last opacity set via SetWindowOpacity (100 until changed).
    int WindowOpacity() {
        if (windowOpacity <= 0) { return 100; }
        return windowOpacity;
    }

    /// Window silhouette as the union of shape regions. `spec` is
    /// "t,x,y,w,h,r;t,x,y,w,h,r;..." in logical px: type 1 = rounded rect
    /// (r = corner radius), type 2 = ellipse (w/h = bounding box). "" restores
    /// a plain opaque rectangle. Multiple regions union into one silhouette,
    /// e.g. a big rounded card with a circle poking out of it. Composed with
    /// per-pixel alpha on Windows (region fallback without DWM, still Win7
    /// compatible); the area outside every region is transparent to paint and
    /// clicks. Mutually exclusive with native glass. Call before Run.
    void SetWindowShape(string spec) {
        shapeSpec = spec;
        shapeRects = new List<int>();
        if (spec.Length > 0) {
            List<string> parts = spec.Split(";");
            int i = 0;
            while (i < parts.Count) {
                List<string> nums = parts[i].Split(",");
                if (nums.Count >= 6) {
                    shapeRects.Add(Convert.ToInt32(nums[0]));
                    shapeRects.Add(Convert.ToInt32(nums[1]));
                    shapeRects.Add(Convert.ToInt32(nums[2]));
                    shapeRects.Add(Convert.ToInt32(nums[3]));
                    shapeRects.Add(Convert.ToInt32(nums[4]));
                    shapeRects.Add(Convert.ToInt32(nums[5]));
                }
                i = i + 1;
            }
        }
        if (spec.Length == 0) {
            shapeMode = 0;
            shapeRadius = 0;
        } else {
            shapeMode = 1;
            shapeRadius = 0;
            // Surface the first region's radius for WindowShapeRadius().
            int c1 = spec.IndexOf(",");
            if (c1 > 0) {
                int c2 = spec.IndexOf(",", c1 + 1);
                if (c2 > 0) {
                    int c3 = spec.IndexOf(",", c2 + 1);
                    if (c3 > 0) {
                        int c4 = spec.IndexOf(",", c3 + 1);
                        if (c4 > 0) {
                            int c5 = spec.IndexOf(",", c4 + 1);
                            if (c5 > 0) {
                                shapeRadius = Convert.ToInt32(spec.Substring(c4 + 1, c5 - c4 - 1));
                            }
                        }
                    }
                }
            }
        }
        if (shapeMode != 0 && glassNative) {
            window.DisableGlass();
            glassNative = false;
        }
        window.SetShape(spec);
        needsRedraw = true;
    }

    /// Soft drop shadow cast around the shaped silhouette. `px` is the logical
    /// spread of the shadow (0 disables). The design should also carry a
    /// winShadow so formgen prepends a type-3 shadow-band region to the shape
    /// spec — without it the OS surface stops at the silhouette and the shadow
    /// pixels are clipped away. Call before Run, after SetWindowShape.
    void SetWindowShadow(int px) {
        if (px < 0) { px = 0; }
        shapeShadow = px;
        needsRedraw = true;
    }

    /// The shaped-silhouette shadow spread in logical px (0 = none).
    int WindowShadow() { return shapeShadow; }

    /// The active window silhouette spec (see SetWindowShape); "" = rectangle.
    string WindowShapeSpec() { return shapeSpec; }

    /// The active window silhouette (see SetWindowShape).
    int WindowShape() { return shapeMode; }

    /// The corner radius of the rounded-rect silhouette (see SetWindowShape).
    int WindowShapeRadius() { return shapeRadius; }

    /// Shows/hides the custom title-bar chrome. Hidden: the OS still lets the
    /// top TitlebarHeight() strip drag the window and content starts at y=0.
    void SetChromeVisible(bool on) {
        showChrome = on;
        int n = 0;
        if (on) { n = ChromeButtonCount(); }
        window.SetCaptionButtons(n);
        needsRedraw = true;
    }

    /// True while the custom title-bar chrome is visible.
    bool ChromeVisible() { return showChrome; }

    /// Enables/disables OS-native translucent glass (Win11 acrylic): the
    /// desktop is blurred behind the window wherever the surface is
    /// semi-transparent. Distinct from the software-rendered frosted-glass
    /// skins. Mutually exclusive with a shaped window.
    void SetNativeGlass(bool on) {
        if (on) {
            if (shapeMode != 0) { this.SetWindowShape(""); }
            window.EnableGlass(this.GlassTint());
            glassNative = true;
        } else {
            window.DisableGlass();
            glassNative = false;
        }
        needsRedraw = true;
    }

    /// True while OS-native translucent glass is enabled (see SetNativeGlass).
    bool NativeGlass() { return glassNative; }

    // ---- user wallpaper image ----------------------------------------------

    /// Paints `path` (PNG/BMP/JPG) as this window's backdrop, scaled to cover,
    /// blended `opacity` percent (10..100) over the skin's own backdrop. An
    /// empty path clears it. Used for the skin pack's art and a user wallpaper
    /// alike; the skin layer decides which one is showing (see SetUserWallpaper).
    void SetWallpaper(string path, int opacity) {
        int op = opacity;
        if (op < 10) { op = 10; }
        if (op > 100) { op = 100; }
        if (bgImagePath != "" && bgImagePath != path) {
            Canvas.EvictImage(bgImagePath);
        }
        bgImagePath = path;
        bgImageOpacity = op;
        bgThemeGen = bgThemeGen + 1;
        fxSnapValid = false;
        needsRedraw = true;
        theme.bgPrimary   = App.WithAlpha(theme.bgPrimary, 255);
        theme.bgSecondary = App.WithAlpha(theme.bgSecondary, 255);
        theme.bgTertiary  = App.WithAlpha(theme.bgTertiary, 255);
        this.ApplySurfaceTranslucency();
    }

    /// The user's own wallpaper path ("" = none) -- the image the user picked,
    /// as opposed to the active skin pack's art. A skin switch never touches it,
    /// so a chosen backdrop survives changing skins.
    string UserWallpaperPath() { return userWallpaperPath; }

    /// The opacity the user's own wallpaper was set with (100 until set).
    int UserWallpaperOpacity() {
        if (userWallpaperOpacity <= 0) { return 100; }
        return userWallpaperOpacity;
    }

    /// Sets the USER's wallpaper: recorded separately from the skin's art so a
    /// pack switch never replaces it, then painted like any wallpaper. An empty
    /// path clears the user wallpaper and restores the active pack's art (if
    /// the pack ships one).
    void SetUserWallpaper(string path, int opacity) {
        int op = opacity;
        if (op < 10) { op = 10; }
        if (op > 100) { op = 100; }
        userWallpaperPath = path;
        userWallpaperOpacity = op;
        if (path == "") {
            // Back to the pack's own backdrop: the art it installed (at its
            // own strength), or nothing when it ships none.
            if (skinArt != "") { this.SetWallpaper(skinArt, skinArtOpacity); }
            else { this.SetWallpaper("", op); }
            return;
        }
        this.SetWallpaper(path, op);
    }

    /// Replaces the alpha byte of a packed ARGB colour.
    static int WithAlpha(int color, int alpha) {
        int rgb = color % 16777216;
        if (rgb < 0) { rgb = rgb + 16777216; }
        int a = alpha;
        if (a < 0) { a = 0; }
        if (a > 255) { a = 255; }
        return a * 16777216 + rgb;
    }

    /// With a wallpaper set the surfaces let it through, but only as a tint:
    /// the three surface levels stay within a few steps of each other so every
    /// panel reads as the same material. Letting the chrome fall far below the
    /// document surface is what made one panel look frosted, the next one
    /// glass and a third almost bare wallpaper, and it dragged the whole shell
    /// down to the wallpaper's own darkness.
    void ApplySurfaceTranslucency() {
        if (bgImagePath == "") {
            // No image, but skins that paint their own backdrop (a gradient or
            // frosted glass) need see-through surfaces just as much: an opaque
            // panel fill would cover the very wallpaper the window draws. Flat
            // skins keep fully opaque surfaces.
            if (theme.gradient == 0 && theme.glass == 0) { return; }
            theme.bgPrimary   = App.WithAlpha(theme.bgPrimary, 225);
            theme.bgSecondary = App.WithAlpha(theme.bgSecondary, 215);
            theme.bgTertiary  = App.WithAlpha(theme.bgTertiary, 205);
            return;
        }
        // The pack's OWN artwork is the skin's designed backdrop: surfaces sit
        // low so the illustration reads through the start page, panels and dock
        // alike. A user wallpaper is a personal choice layered over the skin, so
        // it tints the surfaces more; the wallpaper-opacity slider still varies
        // it (100% opacity ~= opaque panels, 10% ~= almost bare wallpaper).
        int strength = this.WallpaperOpacity();
        int alpha;
        int chrome;
        int rail;
        if (this.SkinArtWallpaper()) {
            alpha = 180;
            chrome = 168;
            rail = 156;
        } else {
            alpha = 255 - strength * 85 / 100;
            chrome = alpha - 10;
            rail = alpha - 20;
            if (alpha < 190) { alpha = 190; }
            if (chrome < 180) { chrome = 180; }
            if (rail < 170) { rail = 170; }
        }
        theme.bgPrimary   = App.WithAlpha(theme.bgPrimary, alpha);
        theme.bgSecondary = App.WithAlpha(theme.bgSecondary, chrome);
        theme.bgTertiary  = App.WithAlpha(theme.bgTertiary, rail);
    }

    /// True when the wallpaper currently painted is the active skin pack's own
    /// artwork rather than an image the user picked.
    bool SkinArtWallpaper() {
        return skinArt != "" && bgImagePath == skinArt;
    }

    /// True when the user has their own wallpaper set (distinct from the active
    /// pack's art). The user wallpaper always wins over the pack's art, and a
    /// skin switch never replaces it.
    bool HasUserWallpaper() {
        return userWallpaperPath != "";
    }

    /// True when `path` is ANY installed pack's own artwork (not just the active
    /// one). Persisted settings used to save the pack's art as the wallpaper, so
    /// a config written against an older skin list can point at a banner that no
    /// longer belongs to the active skin; the IDE ignores such stale paths.
    bool IsSkinArtPath(string path) {
        if (path == "") { return false; }
        string norm = path;
        norm = norm.Replace("\\", "/");
        norm = norm.ToLower();
        int i = 0;
        while (i < skinPacks.Count) {
            Skin s = Skin.Load(skinPacks[i]);
            string a = s.ArtPath();
            if (a != "") {
                string an = a.Replace("\\", "/").ToLower();
                if (an == norm) { return true; }
            }
            i = i + 1;
        }
        return false;
    }

    /// Drops the user wallpaper, restoring the skin's own backdrop.
    void ClearWallpaper() {
        this.SetWallpaper("", bgImageOpacity);
    }

    string WallpaperPath() { return bgImagePath; }

    int WallpaperOpacity() {
        if (bgImageOpacity <= 0) { return 100; }
        return bgImageOpacity;
    }

    /// Asks the host to pick a wallpaper file (see ConsumeWallpaperPick).
    void RequestWallpaperPick() {
        bgImagePickWanted = true;
        needsRedraw = true;
    }

    /// True when a wallpaper file was requested since the last call; clears the
    /// request so the host opens its picker once.
    bool ConsumeWallpaperPick() {
        if (!bgImagePickWanted) { return false; }
        bgImagePickWanted = false;
        return true;
    }

    /// Blits the wallpaper across [x,y,w,h], cropped centre-cover so the image
    /// keeps its aspect ratio, then fades it into the skin backdrop underneath.
    void RenderWallpaperImage(int x, int y, int w, int h) {
        if (bgImagePath == "") { return; }
        int iw = Canvas.ImageWidth(bgImagePath);
        int ih = Canvas.ImageHeight(bgImagePath);
        if (iw <= 0 || ih <= 0) { return; }
        // A zero-sized target would divide by zero in the cover ratio below.
        if (w <= 0 || h <= 0) { return; }
        // Cover: the largest centred source rect with the target's aspect ratio.
        int sw = iw;
        int sh = ih;
        if (iw * h > w * ih) {
            sw = w * ih / h;
        } else {
            sh = h * iw / w;
        }
        if (sw < 1) { sw = 1; }
        if (sh < 1) { sh = 1; }
        canvas.BlitImage(bgImagePath, x, y, w, h,
                         (iw - sw) / 2, (ih - sh) / 2, sw, sh);
        // Fade toward the skin backdrop: a scrim in the page colour at the
        // complement of the requested opacity. The skin's OWN artwork is
        // authored to be the backdrop -- it reads at full strength, with the
        // translucent surfaces doing the blending -- so only a user-picked
        // wallpaper gets the scrim.
        int fade = 100 - this.WallpaperOpacity();
        if (fade > 0 && !this.SkinArtWallpaper()) {
            int rgb = theme.bgPrimary % 16777216;
            if (rgb < 0) { rgb = rgb + 16777216; }
            canvas.FillRect(x, y, w, h, (fade * 255 / 100) * 16777216 + rgb);
        }
    }

    // ---- themed window backdrop (built-in, shared by every window) ---------
    // The wallpaper that makes gradient/glass/neon skins read as real: a
    // vertical gradient plus soft colour blobs the frosted panels blur. Lives
    // in the framework so the IDE, the gallery and any window render identical
    // skins — apps just call RenderBackground behind their content.

    /// One soft wallpaper glow: a smooth radial fade to a bright centre (no
    /// hard rim), giving the backdrop blur real colour to soften.
    void BackdropBlob(int cx, int cy, int r, int cr, int cg, int cb) {
        // One per-pixel radial fade (Canvas.FillRadial) rather than a stack of
        // translucent disks: stacked disks banded into visible "target" rings
        // at their edges, and this is a single blit instead of 20.
        canvas.FillRadial(cx, cy, r, Theme.Rgb(cr, cg, cb), 150);
    }

    /// A soft glow coloured from a packed ARGB theme accent.
    void BackdropDrift(int cx, int cy, int r, int color) {
        int cr = (color / 65536) % 256;
        int cg = (color / 256) % 256;
        int cb = color % 256;
        this.BackdropBlob(cx, cy, r, cr, cg, cb);
    }

    /// Colour blobs from the theme's own accents over the vertical gradient
    /// (non-glass gradient presets) so the ramp reads as a wallpaper.
    void BackdropGradientWallpaper(int ax, int ay, int aw, int ah) {
        Theme t = theme;
        int r = this.Scale(340);
        this.BackdropDrift(ax + aw * 20 / 100, ay + ah * 24 / 100, r, t.primary);
        this.BackdropDrift(ax + aw * 74 / 100, ay + ah * 18 / 100, r, t.info);
        this.BackdropDrift(ax + aw * 82 / 100, ay + ah * 72 / 100, r, t.success);
        this.BackdropDrift(ax + aw * 30 / 100, ay + ah * 84 / 100, r, t.error);
    }

    /// iOS-style multi-colour wallpaper for the frosted-glass presets.
    void BackdropGlassWallpaper(int ax, int ay, int aw, int ah) {
        this.BackdropBlob(ax + aw * 14 / 100, ay + ah * 20 / 100,
            this.Scale(320), 128, 96, 245);
        this.BackdropBlob(ax + aw * 40 / 100, ay + ah * 34 / 100,
            this.Scale(300), 236, 120, 175);
        this.BackdropBlob(ax + aw * 78 / 100, ay + ah * 16 / 100,
            this.Scale(320), 96, 156, 255);
        this.BackdropBlob(ax + aw * 62 / 100, ay + ah * 72 / 100,
            this.Scale(340), 240, 112, 196);
        this.BackdropBlob(ax + aw * 30 / 100, ay + ah * 86 / 100,
            this.Scale(300), 96, 222, 208);
        this.BackdropBlob(ax + aw * 90 / 100, ay + ah * 58 / 100,
            this.Scale(280), 156, 120, 250);
    }

    /// Paints the active skin's window backdrop into [x,y,w,h]: a gradient +
    /// soft colour blobs for gradient/glass presets (so frosted panels blur
    /// real colour), otherwise a flat bgPrimary fill. Cached per redraw —
    /// animation-only frames restore the pixels with one copy instead of
    /// repainting the (expensive) blobs. `slot` is a snapshot cache slot the
    /// caller reserves for its backdrop.
    void RenderBackground(int x, int y, int w, int h, int slot) {
        Canvas c = canvas;
        Theme t = theme;
        // Shaped window: the silhouette is drawn entirely by the tree, so the
        // backdrop stays transparent (the surface was cleared to alpha 0 in
        // BeginFrame and the OS composites the shape per-pixel). A soft drop
        // shadow (SetWindowShadow) paints first, under the tree.
        if (shapeMode != 0) {
            if (shapeShadow > 0) { this.PaintShapeShadow(); }
            return;
        }
        // Native glass: the window is a flat semi-transparent sheet (cleared in
        // BeginFrame) over the OS-blurred desktop. Add a soft top-down light
        // sheen so the glass reads with depth (brighter near the top) like real
        // acrylic instead of a flat slab.
        if (glassNative) {
            int hi = t.textPrimary % 16777216;
            if (hi < 0) { hi = hi + 16777216; }
            int bands = 18;
            int bh = h / 3 / bands;
            if (bh < 1) { bh = 1; }
            int i = 0;
            while (i < bands) {
                int a = 15 - (15 * i / bands);
                c.FillRect(x, y + i * bh, w, bh, a * 16777216 + hi);
                i = i + 1;
            }
            return;
        }
        if (t.gradient != 0 || bgImagePath != "") {
            // The wallpaper (gradient + soft blobs) is static per skin+size, so
            // restore it from the snapshot on every frame -- including dirty
            // ones -- as long as the skin generation matches. Only a skin change
            // (bgThemeGen bumped) or a resize (RestoreRect geometry mismatch)
            // forces the expensive repaint. This keeps glass/gradient skins
            // smooth while scrolling or typing instead of re-blobbing per frame.
            bool restored = false;
            if (bgSnapGen == bgThemeGen) {
                restored = c.RestoreRect(x, y, w, h, slot);
            }
            if (!restored) {
                if (t.gradient != 0) {
                    c.FillVGrad(x, y, w, h, t.bgGradTop, t.bgGradBottom);
                    if (t.glass != 0) {
                        this.BackdropGlassWallpaper(x, y, w, h);
                    } else {
                        this.BackdropGradientWallpaper(x, y, w, h);
                    }
                } else {
                    c.FillRect(x, y, w, h, t.bgPrimary);
                }
                this.RenderWallpaperImage(x, y, w, h);
                c.SnapshotRect(x, y, w, h, slot);
                bgSnapGen = bgThemeGen;
            }
        } else {
            c.FillRect(x, y, w, h, t.bgPrimary);
        }
    }

    /// Paints the soft drop shadow of the shaped silhouette into the surface,
    /// under the tree (called from RenderBackground). Every non-band region
    /// casts concentric anti-aliased rings — the software renderer has no
    /// gaussian shadow, so the falloff is layered like StyleBox's own shadow.
    /// Each ring is stroked ONCE (a 1px rounded-rect/circle outline), so the
    /// translucent layers never double-blend into a saturated dark edge the
    /// way overlapping fills did. Type-3 shadow-band regions (added by
    /// formgen for winShadow) only extend the OS surface; they cast no shadow.
    void PaintShapeShadow() {
        if (shapeRects.Count == 0 || shapeShadow <= 0) { return; }
        Canvas c = canvas;
        int blur = this.Scale(shapeShadow);
        if (blur <= 0) { return; }
        int baseCol = theme.shadowColor;
        if (baseCol == 0) { baseCol = 0x50000000; }
        // Peak alpha: the theme's shadow tint (very faint) but never so dark
        // the glow reads as a hard outline.
        int peak = (baseCol >> 24) & 255;
        if (peak < 40) { peak = 40; }
        if (peak > 110) { peak = 110; }
        int rgb = baseCol % 16777216;
        if (rgb < 0) { rgb = rgb + 16777216; }
        int i = 0;
        while (i + 5 < shapeRects.Count) {
            int t = shapeRects[i];
            if (t == 3) { i = i + 6; continue; }
            int x = this.Scale(shapeRects[i + 1]);
            int y = this.Scale(shapeRects[i + 2]);
            int w = this.Scale(shapeRects[i + 3]);
            int h = this.Scale(shapeRects[i + 4]);
            int r = this.Scale(shapeRects[i + 5]);
            // One ring per pixel of spread; adjacent rings tile without gaps
            // (a 1px stroke centred on the path covers [k-0.5, k+0.5]).
            int k = 1;
            while (k <= blur) {
                int a = peak * (blur - k + 1) / blur;
                int col = (a << 24) | rgb;
                if (t == 2) {
                    int rad = (w + k * 2) / 2;
                    c.DrawCircle(x + w / 2, y + h / 2, rad, col, 1);
                } else {
                    c.DrawRoundRect(x - k, y - k, w + k * 2, h + k * 2,
                                    r + k, col, 1);
                }
                k = k + 1;
            }
            i = i + 6;
        }
    }

    /// The backdrop-effect kind in force: the drawer's override when set,
    /// otherwise the active skin's own effect. 0 = none.
    int EffectiveFx() {
        if (fxKindOverride >= 0) { return fxKindOverride; }
        return theme.fx;
    }

    /// True when the active skin's animated backdrop effect is running. Never
    /// over a shaped window: the effect layer is composited across the whole
    /// surface, so its particles would light up the transparent pixels outside
    /// the silhouette instead of the design.
    bool FxActive() {
        return fxEnabled && this.EffectiveFx() != 0 && !glassNative
            && shapeMode == 0;
    }

    /// Enables/disables the animated backdrop effect for this window's skins.
    void SetBackdropFx(bool on) {
        fxEnabled = on;
        fxSnapValid = false;
        if (!on) { fxNextMs = -1; }
        needsRedraw = true;
    }

    /// Pure effect tick: restores the snapshot of the last fully rendered
    /// frame, re-composites the skin effect on top and presents. Returns false
    /// (caller falls back to a full render) when no valid snapshot exists,
    /// e.g. after a resize.
    bool FxPresent() {
        if (!fxSnapValid || !this.FxActive()) { fxNextMs = -1; return false; }
        if (!window.IsVisible()) {
            // The window cannot be seen (minimized or fully covered): stop
            // ticking entirely. A window that is merely unfocused is still on
            // screen, so its backdrop keeps animating. Any event -- including
            // the visibility wake -- re-arms the effect (ProcessEvent /
            // ApplyEvent).
            fxNextMs = -1;
            return true;
        }
        Canvas fc = canvas;
        List<int> repaired = fxDamage;
        bool ok;
        if (fxDamage == null) {
            ok = fc.RestoreRect(0, 0, fc.Width(), fc.Height(), 7);
        } else {
            // Repair only the pixels the previous effect frame touched: a few
            // hundred tiny copies instead of a full-frame restore.
            ok = true;
            int i = 0;
            while (ok && i + 3 < fxDamage.Count) {
                ok = fc.RestoreSubRect(fxDamage[i], fxDamage[i + 1],
                                       fxDamage[i + 2], fxDamage[i + 3], 7);
                i = i + 4;
            }
        }
        if (!ok) {
            fxSnapValid = false;
            return false;
        }
        BackdropFx.Render(fc, this.EffectiveFx(), 0, 0, fc.Width(), fc.Height(),
                          Window.GetTickMs(), theme, dpiScale);
        fxDamage = BackdropFx.TakeDamage();
        // Nothing outside the repaired pixels and the ones this effect frame
        // painted has changed, so the present uploads only those -- pushing the
        // whole surface is what an idle effect tick used to spend all its time
        // on. A full restore (no previous damage) still presents everything.
        if (repaired != null) {
            this.MarkPresentDirty(repaired);
            this.MarkPresentDirty(fxDamage);
        }
        window.Present(canvas);
        lastPresentMs = Window.GetTickMs();
        fxNextMs = lastPresentMs + this.FxIntervalMs();
        return true;
    }

    /// How long until the next effect tick: the skin's own frame interval.
    /// Only an invisible window stops ticking (see FxPresent).
    int FxIntervalMs() {
        return BackdropFx.IntervalMs(this.EffectiveFx());
    }

    /// Marks the next repaint as a damage-clipped frame covering the widget the
    /// pointer left and the one it entered (padded, so focus rings and hairlines
    /// just outside the hit region are included). Any other repaint reason in the
    /// same event pass cancels it via CancelPartialFrame().
    void NoteHoverDamage(int oldId, int newId) {
        if (this.HasOverlays() || this.PointerCaptured()) {
            partialPending = false;
            return;
        }
        List<int> ra = hitTester.RectOf(oldId);
        List<int> rb = hitTester.RectOf(newId);
        if (ra == null && rb == null) {
            partialPending = false;
            return;
        }
        int pad = this.Scale(6);
        int x0 = canvas.Width();
        int y0 = canvas.Height();
        int x1 = 0;
        int y1 = 0;
        if (ra != null) {
            if (ra[0] < x0) { x0 = ra[0]; }
            if (ra[1] < y0) { y0 = ra[1]; }
            if (ra[0] + ra[2] > x1) { x1 = ra[0] + ra[2]; }
            if (ra[1] + ra[3] > y1) { y1 = ra[1] + ra[3]; }
        }
        if (rb != null) {
            if (rb[0] < x0) { x0 = rb[0]; }
            if (rb[1] < y0) { y0 = rb[1]; }
            if (rb[0] + rb[2] > x1) { x1 = rb[0] + rb[2]; }
            if (rb[1] + rb[3] > y1) { y1 = rb[1] + rb[3]; }
        }
        x0 = x0 - pad;
        y0 = y0 - pad;
        x1 = x1 + pad;
        y1 = y1 + pad;
        if (x0 < 0) { x0 = 0; }
        if (y0 < 0) { y0 = 0; }
        if (x1 > canvas.Width()) { x1 = canvas.Width(); }
        if (y1 > canvas.Height()) { y1 = canvas.Height(); }
        if (x1 - x0 <= 0 || y1 - y0 <= 0) {
            partialPending = false;
            return;
        }
        dmgX = x0;
        dmgY = y0;
        dmgW = x1 - x0;
        dmgH = y1 - y0;
        partialPending = true;
    }

    /// Forces the next frame to repaint in full (anything that is not a plain
    /// hover move: scroll, typing, resize, animation, skin change...).
    void CancelPartialFrame() {
        partialPending = false;
    }

    /// Announces a flat [x,y,w,h,...] damage list to the next Present.
    void MarkPresentDirty(List<int> rects) {
        if (rects == null) { return; }
        int i = 0;
        while (i + 3 < rects.Count) {
            window.PresentDirty(rects[i], rects[i + 1], rects[i + 2], rects[i + 3]);
            i = i + 4;
        }
    }

    int ChromeButtonCount() {
        int count = 1;
        if (showThemeButton) { count = count + 1; }
        if (showPinButton) { count = count + 1; }
        if (showMinimizeButton) { count = count + 1; }
        if (showMaximizeButton) { count = count + 1; }
        return count;
    }

    void SetChromeButtons(
        bool themeButton,
        bool pinButton,
        bool minimizeButton,
        bool maximizeButton
    ) {
        showThemeButton = themeButton;
        showPinButton = pinButton;
        showMinimizeButton = minimizeButton;
        showMaximizeButton = maximizeButton;
        window.SetCaptionButtons(ChromeButtonCount());
        needsRedraw = true;
    }

    /// Turns the title-bar theme caption button into a dropdown menu that lists
    /// `names` (e.g. skin presets) instead of a plain dark/light toggle, and
    /// keeps it in the ORIGINAL caption-button slot so it stays non-draggable.
    /// Add a handler to the returned event to react to a pick, then read
    /// ThemeMenuIndex(). Call once, before WidgetId.Mark(), so the option-id
    /// block is stable for the app's lifetime.
    UiEvent SetThemeMenu(List<string> names, int index) {
        themeNames = names;
        themeMenuModel.Set(index);
        themeMenuBaseId = WidgetId.Block(names.Count);
        showThemeButton = true;
        window.SetCaptionButtons(ChromeButtonCount());
        needsRedraw = true;
        return themeMenuChange;
    }

    /// True when the title-bar theme button acts as a preset menu.
    bool ThemeMenuMode() { return themeNames.Count > 0; }

    /// Index currently selected in the title-bar theme menu.
    int ThemeMenuIndex() { return themeMenuModel.Get(); }

    /// Sync the menu selection without firing the change event (deep links).
    void SetThemeMenuIndex(int i) {
        themeMenuModel.Set(i);
        needsRedraw = true;
    }

    /// Moves the OS window's top-left to (x, y) in screen work-area pixels.
    void SetWindowPos(int x, int y) {
        window.SetPosition(x, y);
    }

    /// Centers the OS window on its monitor's work area.
    void CenterWindow() {
        window.Center();
    }

    void Show() {
        window.Show();
        int realW = window.ClientWidth();
        int realH = window.ClientHeight();
        if (realW != canvas.Width() || realH != canvas.Height()) {
            canvas.Destroy();
            canvas = Canvas.Create(realW, realH);
        }
        dpiScale = Canvas.GetDpiScale();
        theme.ScaleByDpi(dpiScale);
        scrollSpeed = 40 * dpiScale / 100;
        titlebarH = Window.TitlebarHeight();
        captionBtnW = Window.CaptionButtonWidth();
        if (titlebarH < 24) { titlebarH = Scale(32); }
        if (captionBtnW < 24) { captionBtnW = Scale(46); }
        int nCap = 0;
        if (showChrome) { nCap = ChromeButtonCount(); }
        window.SetCaptionButtons(nCap);
        // Arm the AI automation driver when ZAN_UI_SCRIPT is set (inert otherwise).
        UiDriver.Begin(this);
    }

    /// Shows the window and runs the standard event loop until it closes,
    /// painting just the title-bar chrome each frame. A one-call convenience
    /// for simple windows; to draw your own content, drive the
    /// BeginFrame / RenderChrome / PresentFrame loop directly instead.
    void Run(string title) {
        Show();
        while (isRunning) {
            if (!ProcessEvent()) { break; }
            if (!needsRedraw) { continue; }
            BeginFrame();
            RenderChrome(title);
            PresentFrame();
        }
    }

    /// Height reserved by the custom title bar; content should start below it.
    /// 0 when the chrome is hidden (see SetChromeVisible).
    int ContentTop() {
        if (!showChrome) { return 0; }
        return titlebarH;
    }

    /// Draws the borderless-window title bar (brand + drag area + min/max/close
    /// caption buttons) and processes clicks on the caption buttons. Should be
    /// drawn last each frame so it overlays content.
    void RenderChrome(string title) {
        // Shaped/borderless windows are their own design: no title-bar chrome
        // unless the app explicitly re-enables it with SetChromeVisible(true).
        if (!showChrome) { return; }
        Canvas c = canvas;
        Theme t = theme;
        int W = c.Width();
        int hbar = titlebarH;

        // Under the frosted-glass skin the title bar frosts the content behind
        // it too (blur + translucent themed tint + faint white sheen), so the
        // chrome matches the glass body instead of sitting on a flat opaque bar.
        if (t.glass != 0) {
            c.BlurRectCached(0, 0, W, hbar, Scale(22),
                NextBlurSlot(), BackdropDirty());
            c.FillRect(0, 0, W, hbar, 200 * 16777216 + (t.bgSecondary % 16777216));
            c.FillRect(0, 0, W, hbar, 26 * 16777216 + (t.textPrimary % 16777216));
        } else {
            c.FillRect(0, 0, W, hbar, t.bgSecondary);
        }
        c.FillRect(0, hbar - 1, W, 1, t.divider);

        int pad = t.paddingLarge;
        int brand = t.iconSizeSmall;
        c.DrawGlyph("home", pad, (hbar - brand) / 2, brand, t.primary);
        int txtY = (hbar - Canvas.FontHeight(t.fontSizeMedium)) / 2;
        c.DrawText(pad + brand + t.gapSmall, txtY, title, t.textPrimary, t.fontSizeMedium);


        int themeId = RenderCaptionButtons(c, t, W, hbar);

        // A native-glass (layered) window has no OS drop-shadow, so its edge can
        // vanish into a similar wallpaper. Stroke a subtle rim around the whole
        // window plus a brighter top highlight so the bounds stay clear.
        if (glassNative) {
            int H = c.Height();
            c.DrawRect(0, 0, W, H, 130 * 16777216 + (t.textPrimary % 16777216), 1);
            c.FillRect(0, 0, W, 1, 70 * 16777216 + (t.textPrimary % 16777216));
        }

        // Defer the preset menu to the overlay layer so it drops above all
        // content and its option hit regions win the z-order. Right-align the
        // menu under the caption button; nudge it in if it would clip the edge.
        if (themeMenuOpen.Get()) {
            AddOverlay(OverlayPopup.ThemeDrawer(themeMenuBaseId, themeId,
                themeMenuOpen, themeMenuScroll));
        }
    }

    /// Caption buttons (theme/pin/min/max/close): x-layout, hover wash, glyphs,
    /// hit regions and click handling. Returns the theme button's focus id so the
    /// caller can anchor the theme-preset drawer under it.
    int RenderCaptionButtons(Canvas c, Theme t, int W, int hbar) {
        int bw = captionBtnW;
        int closeX = W - bw;
        int nextX = closeX;
        int maxX = -bw;
        int minX = -bw;
        int pinX = -bw;
        int themeX = -bw;
        if (showMaximizeButton) { nextX = nextX - bw; maxX = nextX; }
        if (showMinimizeButton) { nextX = nextX - bw; minX = nextX; }
        if (showPinButton) { nextX = nextX - bw; pinX = nextX; }
        if (showThemeButton) { nextX = nextX - bw; themeX = nextX; }

        int themeId = focus.AllocId();
        int pinId = focus.AllocId();
        int minId = focus.AllocId();
        int maxId = focus.AllocId();
        int closeId = focus.AllocId();

        bool themeH = focus.IsHovered(themeId);
        bool pinH = focus.IsHovered(pinId);
        bool minH = focus.IsHovered(minId);
        bool maxH = focus.IsHovered(maxId);
        bool closeH = focus.IsHovered(closeId);

        // Caption hover wash follows the active theme's own hover token so the
        // window controls stay coordinated with every skin (a translucent wash
        // over glass/gradient, the themed grey on light/dark) instead of a
        // fixed grey. Close keeps the signature Windows red.
        int capHover = t.bgHover;
        int closeRed = 0xFFE81123;
        if (showThemeButton && themeH) {
            c.FillRect(themeX, 0, bw, hbar, capHover);
        }
        if (showPinButton && pinH) {
            c.FillRect(pinX, 0, bw, hbar, capHover);
        }
        if (showMinimizeButton && minH) {
            c.FillRect(minX, 0, bw, hbar, capHover);
        }
        if (showMaximizeButton && maxH) {
            c.FillRect(maxX, 0, bw, hbar, capHover);
        }
        if (closeH) { c.FillRect(closeX, 0, bw, hbar, closeRed); }

        // Caption glyphs render at the small "caption" size (~11px) that Windows
        // and WeChat use — thin and crisp rather than chunky — and are centered
        // in each 46-wide button for a refined, balanced title bar.
        int gl = (t.iconSizeCaption * 33) / 25;
        // The theme / pin glyphs are visually lighter than the geometric
        // min/max/close strokes, so draw them ~5% larger to look the same size.
        int glBig = (gl * 21) / 20;
        if (glBig <= gl) { glBig = gl + 1; }
        int gcolor = t.textSecondary;

        // Theme control: a "color" palette glyph; the button opens the skin
        // picker drawer.
        int themeColor = gcolor;
        if (themeH || themeMenuOpen.Get()) {
            themeColor = t.textPrimary;
        }
        string themeIcon = "color";
        if (showThemeButton) {
            c.DrawGlyphIn(themeIcon, themeX, 0, bw, hbar, glBig, themeColor);
        }

        // Pin (always-on-top): accent color + filled glyph when active.
        int pinColor = gcolor;
        if (pinH) { pinColor = t.textPrimary; }
        string pinIcon = "pin";
        if (isTopmost) { pinIcon = "unpin"; pinColor = t.primary; }
        if (showPinButton) {
            c.DrawGlyphIn(pinIcon, pinX, 0, bw, hbar, glBig, pinColor);
        }

        int minColor = gcolor;
        if (minH) { minColor = t.textPrimary; }
        if (showMinimizeButton) {
            c.DrawGlyphIn("minimize", minX, 0, bw, hbar, gl, minColor);
        }

        string maxName = "maximize";
        if (window.IsMaximized()) { maxName = "restore"; }
        int maxColor = gcolor;
        if (maxH) { maxColor = t.textPrimary; }
        if (showMaximizeButton) {
            c.DrawGlyphIn(maxName, maxX, 0, bw, hbar, gl, maxColor);
        }

        int xcolor = gcolor;
        if (closeH) { xcolor = 0xFFFFFFFF; }
        c.DrawGlyphIn("close", closeX, 0, bw, hbar, gl, xcolor);

        if (showThemeButton) {
            hitTester.Register(
                HitRegion.Create(themeId, themeX, 0, bw, hbar, 3));
        }
        if (showPinButton) {
            hitTester.Register(
                HitRegion.Create(pinId, pinX, 0, bw, hbar, 3));
        }
        if (showMinimizeButton) {
            hitTester.Register(
                HitRegion.Create(minId, minX, 0, bw, hbar, 3));
        }
        if (showMaximizeButton) {
            hitTester.Register(
                HitRegion.Create(maxId, maxX, 0, bw, hbar, 3));
        }
        hitTester.Register(HitRegion.Create(closeId, closeX, 0, bw, hbar, 3));

        if (this.EventKind() == 3) {
            int hit = hitTester.HitTest(mouseX, mouseY);
            if (showThemeButton && hit == themeId) {
                if (!themeMenuOpen.Get()) { themeMenuScroll.Set(0); }
                themeMenuOpen.Set(!themeMenuOpen.Get());
                needsRedraw = true;
            } else if (showPinButton && hit == pinId) {
                isTopmost = !isTopmost;
                window.SetTopmost(isTopmost);
                needsRedraw = true;
            } else if (showMinimizeButton && hit == minId) {
                window.Minimize();
            } else if (showMaximizeButton && hit == maxId) {
                window.ToggleMaximize();
            } else if (hit == closeId) {
                window.Close();
            }
        }
        return themeId;
    }

    void RequestRedraw() {
        needsRedraw = true;
    }

    /// Requests a *throttled* repaint for a looping animation: the next frame
    /// is scheduled at most `minIntervalMs` from now, and the event loop sleeps
    /// (idle, no CPU) until then instead of busy-rendering at 60fps. Unlike
    /// RequestRedraw this does not force an immediate frame, so a permanently
    /// animating widget (a spinner, a skeleton shimmer) repaints the page at a
    /// low cadence. An earlier deadline always wins if several animations are
    /// live in the same frame. Input still wakes the loop promptly.
    void RequestAnimationFrame(int minIntervalMs) {
        int due = Window.GetTickMs() + minIntervalMs;
        if (animNextMs < 0 || due < animNextMs) { animNextMs = due; }
    }

    /// True when the content behind glass surfaces may have changed this frame
    /// (any OS input / resize / theme), false when the frame is a pure
    /// animation tick over an unchanged backdrop. Glass surfaces pass this to
    /// Canvas.BlurRectCached so spinners/toasts reuse the cached blur.
    bool BackdropDirty() {
        return backdropDirty;
    }

    void ReuseBackdrop() {
        backdropDirty = false;
    }

    bool PointerPressed() {
        return focus.pressedId >= 0;
    }

    /// Hands out the next stable per-frame blur-cache slot (draw order). Slots
    /// beyond the cache capacity fall back to an uncached blur.
    int NextBlurSlot() {
        int s = blurSlotSeq;
        blurSlotSeq = blurSlotSeq + 1;
        if (s > 63) { return -1; }
        return s;
    }

    /// Report the focused text widget's caret (client-area px) so the IME
    /// composition/candidate window follows the cursor instead of pinning to
    /// the window origin. Called each frame by Input/TextArea while focused.
    void SetImeCaret(int x, int y) {
        Ime.SetCaret(x, y);
    }

    /// <summary>
    /// Marshals a delegate onto this window's UI thread — the equivalent of
    /// C#'s <c>Control.Invoke</c>/<c>BeginInvoke</c>. Safe to call from any
    /// thread: the delegate is queued (under an OS mutex in the runtime) and
    /// runs on the UI thread at the start of the next frame, after which a
    /// repaint is requested. A background worker uses this to hand results back
    /// without touching UI state off-thread.
    /// </summary>
    void Post(Action handler) {
        Dispatcher.Post(handler);
        // Wake the loop if it is blocked in WaitEvent so the queued work runs
        // promptly instead of waiting for the next input event.
        window.Wake();
    }

    /// <summary>
    /// Runs every delegate queued via <see cref="Post"/> on the UI thread and
    /// requests a repaint if any ran. Called automatically each event-loop
    /// iteration by ProcessEvent; a hand-rolled loop can also call it directly.
    /// </summary>
    void DrainPosts() {
        Action handler = Dispatcher.Take();
        while (handler != null) {
            handler();
            needsRedraw = true;
            handler = Dispatcher.Take();
        }
    }

    /// Finds the row index for an animation key, or -1. Rows are appended by
    /// AnimTo/AnimPx and kept index-aligned across all six columns.
    int AnimIndex(int key) {
        for (int i = 0; i < anims.Count; i = i + 1) {
            if (anims[i].key == key) { return i; }
        }
        return -1;
    }

    void AnimAdd(int key, int val, int target, int durMs) {
        anims.Add(new AnimSlot(key, val, target, val, nowMs, durMs));
    }

    /// Persistent per-key integer state (reuses the animation KV store as a
    /// generic retained-state map). Lets immediate-mode widgets whose model is
    /// rebuilt every frame keep interaction state (legend show/hide, dataZoom
    /// range, ...) keyed by a stable id. StateSet snaps the value with no tween.
    int StateGet(int key, int dflt) {
        int idx = AnimIndex(key);
        if (idx < 0) { return dflt; }
        return anims[idx].cur;
    }

    void StateSet(int key, int val) {
        int idx = AnimIndex(key);
        if (idx < 0) { AnimAdd(key, val, val, 1); return; }
        AnimSlot a = anims[idx];
        a.cur = val;
        a.dst = val;
        a.src = val;
    }

    /// Time-based eased tween of a per-key value (permille, 0..1000) toward
    /// `target` over `durMs`, returning the *already eased* current value (do
    /// NOT wrap in Ease again). Progress is (now - start)/duration so motion is
    /// smooth regardless of frame-rate or timer granularity. Retargeting mid-
    /// flight restarts the tween from the current value. First sighting snaps.
    int AnimTo(int key, int target, int durMs) {
        int idx = AnimIndex(key);
        if (idx < 0) {
            AnimAdd(key, target, target, durMs);
            return target;
        }
        AnimSlot a = anims[idx];
        if (a.dst != target) {
            a.src = a.cur;
            a.dst = target;
            a.startMs = nowMs;
            a.dur = durMs;
        }
        int from = a.src;
        int tgt = a.dst;
        if (from == tgt) { a.cur = tgt; return tgt; }
        int dur = a.dur;
        if (dur < 1) { dur = 1; }
        int elapsed = nowMs - a.startMs;
        if (elapsed < 0) { elapsed = 0; }
        int p = elapsed * 1000 / dur;
        if (p > 1000) { p = 1000; }
        int e = App.Ease(p);
        int val = from + (tgt - from) * e / 1000;
        a.cur = val;
        if (p < 1000) { needsRedraw = true; } else { a.cur = tgt; }
        return a.cur;
    }

    /// One-shot intro tween: eases a per-key value from 0 up to 1000 over
    /// `durMs` on first sighting, then holds at 1000. Unlike AnimTo (which snaps
    /// to its target on the first frame) this always plays the grow-in, so a
    /// chart, bar or card can animate up from its baseline the first time it is
    /// drawn. Keeps requesting repaints until it settles. Returns the eased
    /// 0..1000 progress.
    int AnimIntro(int key, int durMs) {
        int idx = AnimIndex(key);
        if (idx < 0) {
            anims.Add(new AnimSlot(key, 0, 1000, 0, nowMs, durMs));
            needsRedraw = true;
            return 0;
        }
        AnimSlot a = anims[idx];
        int from = a.src;
        int tgt = a.dst;
        if (from == tgt) { a.cur = tgt; return tgt; }
        int dur = a.dur;
        if (dur < 1) { dur = 1; }
        int elapsed = nowMs - a.startMs;
        if (elapsed < 0) { elapsed = 0; }
        int p = elapsed * 1000 / dur;
        if (p > 1000) { p = 1000; }
        int e = App.Ease(p);
        int val = from + (tgt - from) * e / 1000;
        a.cur = val;
        if (p < 1000) { needsRedraw = true; } else { a.cur = tgt; }
        return a.cur;
    }

    /// Eases a per-key value toward `target` in arbitrary (pixel) space using
    /// exponential smoothing, so it works for any range (unlike AnimTo which is
    /// 0..1000). `tauMs` is the smoothing time constant (larger = slower). Used
    /// for e.g. a tab underline sliding between tabs of differing widths.
    int AnimPx(int key, int target, int tauMs) {
        int idx = AnimIndex(key);
        if (idx < 0) {
            AnimAdd(key, target, target, tauMs);
            return target;
        }
        AnimSlot a = anims[idx];
        int cur = a.cur;
        if (cur == target) { return cur; }
        int dt = nowMs - lastFrameMs;
        if (dt < 1) { dt = 1; }
        if (dt > 64) { dt = 64; }
        if (tauMs < 1) { tauMs = 1; }
        int f = dt * 1000 / (dt + tauMs);
        int delta = (target - cur) * f / 1000;
        if (delta == 0) {
            if (target > cur) { delta = 1; } else { delta = -1; }
        }
        int next = cur + delta;
        if (delta > 0 && next > target) { next = target; }
        if (delta < 0 && next < target) { next = target; }
        a.cur = next;
        if (next != target) { needsRedraw = true; }
        return next;
    }

    /// Smoothstep (3t^2 - 2t^3) easing of a permille value for accel/decel.
    static int Ease(int p) {
        if (p <= 0) { return 0; }
        if (p >= 1000) { return 1000; }
        int t2 = p * p / 1000;
        int t3 = t2 * p / 1000;
        return 3 * t2 - 2 * t3;
    }

    /// Linear interpolation between a and b by permille p (0..1000).
    static int Lerp(int a, int b, int p) {
        return a + (b - a) * p / 1000;
    }

    /// Blend two packed RGB colors by permille p (0..1000), returning an opaque
    /// (0xFF alpha) color. Robust to colors stored as negative signed ints.
    static int LerpColor(int c0, int c1, int p) {
        // Packed 0xAARRGGBB colors are stored as signed ints, so any color with
        // a 0xFF alpha is negative. Extract the low 24 RGB bits with a floored
        // modulo first (truncating `c / 65536` would mis-decode negatives, e.g.
        // white -1 would read as pure blue), then split the positive value.
        int rgb0 = c0 % 16777216; if (rgb0 < 0) { rgb0 = rgb0 + 16777216; }
        int rgb1 = c1 % 16777216; if (rgb1 < 0) { rgb1 = rgb1 + 16777216; }
        int r0 = rgb0 / 65536;
        int g0 = (rgb0 / 256) % 256;
        int b0 = rgb0 % 256;
        int r1 = rgb1 / 65536;
        int g1 = (rgb1 / 256) % 256;
        int b1 = rgb1 % 256;
        int r = r0 + (r1 - r0) * p / 1000;
        int g = g0 + (g1 - g0) * p / 1000;
        int b = b0 + (b1 - b0) * p / 1000;
        return 4278190080 + r * 65536 + g * 256 + b;
    }

    /// Darkens a packed color toward opaque black by permille p (0..1000): a
    /// named shade anchor so widgets never spell out the black constant inline.
    static int Darken(int color, int p) { return App.LerpColor(color, 4278190080, p); }

    /// Lightens a packed color toward opaque white by permille p (0..1000).
    static int Lighten(int color, int p) { return App.LerpColor(color, 4294967295, p); }

    /// Scales a packed color's existing alpha channel by permille p (0..1000),
    /// keeping its RGB. p=1000 returns the color unchanged; p=0 makes it fully
    /// transparent. Works for both opaque colors and ones that already carry an
    /// alpha (e.g. glass tokens), so a fill/overlay can fade in and out. Robust
    /// to the signed-int color packing (see LerpColor).
    static int ScaleAlpha(int color, int p) {
        if (p >= 1000) { return color; }
        if (p < 0) { p = 0; }
        int rgb = color % 16777216; if (rgb < 0) { rgb = rgb + 16777216; }
        int a = (color - rgb) / 16777216; if (a < 0) { a = a + 256; }
        a = a * p / 1000;
        return rgb + a * 16777216;
    }

    /// A scrollable widget calls this during render to claim the wheel while
    /// hovered. The last hovered claim is the owner on the next input frame, so
    /// a nested view consumes the wheel without also scrolling its parent.
    bool CaptureWheel(int x, int y, int w, int h) {
        bool inside = mouseX >= x && mouseX < x + w
            && mouseY >= y && mouseY < y + h;
        if (!inside) { return false; }
        wheelClaimSeq = wheelClaimSeq + 1;
        wheelCapX = x;
        wheelCapY = y;
        wheelCapW = w;
        wheelCapH = h;
        wheelCapOrder = wheelClaimSeq;
        return this.EventKind() == 13
            && wheelOwnerOrder == wheelClaimSeq;
    }

    void SetContentHeight(int h) {
        contentHeight = h;
    }

    int ViewportHeight() {
        return canvas.Height();
    }

    int Scale(int v) {
        return v * dpiScale / 100;
    }

    /// Fills a structural chrome surface (sidebar, tab strip, tool pane): under
    /// a glass skin it frosts the backdrop so the whole shell reads as glass,
    /// otherwise it is a plain themed fill. `radius` of 0 fills a square rect.
    void FillChrome(int x, int y, int w, int h, int radius, int color) {
        if (theme.glass != 0) {
            this.FillGlass(x, y, w, h, radius, color, 1000);
        } else if (radius > 0) {
            canvas.FillRoundRect(x, y, w, h, radius, color);
        } else {
            canvas.FillRect(x, y, w, h, color);
        }
    }

    /// Fills an overlay surface, frosted when the skin is glass and the surface
    /// has settled (`a`, the permille fade alpha, >= 900): a backdrop blur plus
    /// the themed tint, so the wallpaper hue still reads through. Real OS glass
    /// already blurs the desktop, so it only needs the light tint. Everything
    /// else is a plain (optionally fading) fill.
    void FillGlass(int x, int y, int w, int h, int radius, int color, int a) {
        if (glassNative && a >= 900) {
            canvas.FillRoundRect(x, y, w, h, radius, Style.Fade(color, 300));
        } else if (theme.glass != 0 && a >= 900) {
            // Clip the frosted blur to the panel's corner radius so the corners
            // keep the sharp wallpaper; a translucent rounded tint over a square
            // blur can never repaint the blurred corners back to the backdrop.
            if (radius > 0) {
                canvas.BlurRoundCached(x, y, w, h, this.Scale(36),
                                       this.NextBlurSlot(), this.BackdropDirty(),
                                       radius, 15);
            } else {
                canvas.BlurRectCached(x, y, w, h, this.Scale(36),
                                      this.NextBlurSlot(), this.BackdropDirty());
            }
            canvas.FillRoundRect(x, y, w, h, radius, Style.Fade(color, 520));
        } else {
            canvas.FillRoundRect(x, y, w, h, radius, Style.Fade(color, a));
        }
    }

    void SetTheme(Theme t) {
        theme = t;
        theme.ScaleByDpi(dpiScale);
        this.ApplySurfaceTranslucency();
        bgThemeGen = bgThemeGen + 1;
        needsRedraw = true;
    }

    bool ProcessEvent() {
        // Advance any active automation script (injects synthetic events that
        // this same loop then polls & dispatches). No-op unless driver-armed.
        UiDriver.Tick();
        // If a repaint is already pending (e.g. a click handler changed state
        // mid-frame), don't block waiting for the next OS event — poll so the
        // new state paints immediately. Otherwise block until an event arrives.
        int result;
        if (needsRedraw) {
            // A repaint is pending (state change or an in-flight animation).
            // Cap the busy-poll to ~60fps so a running animation doesn't spin
            // the CPU at hundreds of fps; sleeping the remainder of the frame
            // budget also yields smoother, wall-clock-paced motion.
            int since = Window.GetTickMs() - lastPresentMs;
            if (lastPresentMs > 0 && since < 16) { Window.SleepMs(16 - since); }
            result = window.PollEvent();
        } else if (animNextMs >= 0 || fxNextMs >= 0) {
            // A throttled animation (spinner at animNextMs) and/or the skin
            // effect layer (fxNextMs) wants a future frame. Sleep (idle) until
            // the earliest deadline instead of busy-rendering at 60fps, but
            // poll in short slices so OS input still wakes the loop promptly.
            // An effect-only deadline is served by FxPresent (single restore +
            // re-composite, no page render); everything else flags a repaint.
            result = 1;
            bool waiting = true;
            while (waiting) {
                int now = Window.GetTickMs();
                int deadline = animNextMs;
                if (deadline < 0 || (fxNextMs >= 0 && fxNextMs < deadline)) {
                    deadline = fxNextMs;
                }
                if (deadline < 0) { waiting = false; }
                else if (now >= deadline) {
                    bool fxOnly = animNextMs < 0 || now < animNextMs;
                    if (fxOnly && this.FxPresent()) {
                        // Presented in place; keep waiting for the next tick.
                    } else {
                        needsRedraw = true;
                        waiting = false;
                    }
                } else {
                    // Idle in the kernel until input or the deadline: a single
                    // blocking wait, not poll + sleep slices, so waiting for
                    // the next animation frame costs no CPU.
                    result = window.WaitEventTimeout(deadline - now);
                    if (result != 1) { waiting = false; }
                }
            }
        } else {
            result = window.WaitEvent();
        }
        if (result < 0) {
            isRunning = false;
            return false;
        }

        // Run any work marshalled from background threads on the UI thread.
        // A Wake() delivers an empty (kind 0) event solely to trigger this.
        DrainPosts();

        int kind = window.EventKind();

        // A pure animation repaint wakes with no OS event (kind 0): the content
        // behind glass is unchanged, so its blur + the static wallpaper can be
        // restored from cache. Any real event (input/resize/etc) marks the
        // backdrop dirty so it is recomputed this frame -- EXCEPT a pure hover
        // move (kind 1 with no button held). Moving the pointer never changes
        // the pixels behind glass: the wallpaper is static and hover highlights
        // paint on foreground widgets over the glass, not behind it. Re-blurring
        // the whole chrome every time the cursor crosses a widget is what made
        // the frosted theme feel sluggish, so hover reuses the cached blur +
        // wallpaper snapshot. A held drag (pressedId >= 0) may scroll/select
        // content behind glass, so it still dirties the backdrop.
        bool hoverOnly = (kind == 1) && (focus.pressedId < 0);
        backdropDirty = (kind != 0) && !hoverOnly;

        if (kind == 8) {
            isRunning = false;
            return false;
        }

        // Keep the render surface locked to the real window size. Maximize/restore
        // sends WM_SIZE synchronously (inside ShowWindow), and the one-shot resize
        // event can be cleared before we read it — so drive the surface from the
        // persistent window dimensions, not the transient kind==7 event. This
        // guarantees Present() blits 1:1 (never stretched/blurry) and that layout
        // + hit-testing use the same coordinate space as the mouse.
        int curW = window.ClientWidth();
        int curH = window.ClientHeight();
        if (curW > 0 && curH > 0) {
            if (curW != canvas.Width() || curH != canvas.Height()) {
                canvas.Destroy();
                canvas = Canvas.Create(curW, curH);
                // Clamp scroll to the new viewport instead of snapping to the
                // top — resizing shouldn't jump the user's scroll position.
                int viewH = curH - titlebarH;
                int maxScroll = contentHeight - viewH;
                if (maxScroll < 0) { maxScroll = 0; }
                if (scrollY > maxScroll) { scrollY = maxScroll; }
                if (scrollY < 0) { scrollY = 0; }
                needsRedraw = true;
            }
        }

        if (kind == 1) {
            mouseX = window.EventX();
            mouseY = window.EventY();
            int hitId = hitTester.HitTest(mouseX, mouseY);
            int oldHover = focus.hoveredId;
            focus.SetHovered(hitId);
            if (hitId != oldHover) {
                needsRedraw = true;
                this.NoteHoverDamage(oldHover, hitId);
            }
            // While a widget is held (e.g. slider/scrollbar drag) keep repainting
            // as the pointer moves so the value tracks the cursor live.
            if (focus.pressedId >= 0) {
                needsRedraw = true;
            }
            int cursorId = hitId;
            if (focus.pressedId >= 0) { cursorId = focus.pressedId; }
            int wtype = hitTester.GetWidgetType(cursorId);
            if (wtype == 0) {
                Window.SetCursor(1);
            } else if (wtype == 1) {
                Window.SetCursor(2);
            } else if (wtype == 4) {
                Window.SetCursor(3);
            } else if (wtype == 5) {
                Window.SetCursor(4);
            } else {
                Window.SetCursor(0);
            }
        }

        if (kind == 2) {
            mouseX = window.EventX();
            mouseY = window.EventY();
            int hitId = hitTester.HitTest(mouseX, mouseY);
            if (window.EventButton() == 1) {
                // Secondary button: record the target for Ui.RightClicked but
                // leave the primary focus/press state untouched, so a right
                // click never steals keyboard focus or arms a primary click.
                rightPressTargetId = hitId;
            } else {
                focus.SetPressed(hitId);
                focus.SetFocused(hitId);
                pressTargetId = hitId;
                NotePressStart(hitId, mouseX, mouseY);
            }
            needsRedraw = true;
        }

        if (kind == 3) {
            mouseX = window.EventX();
            mouseY = window.EventY();
            int hitId = hitTester.HitTest(mouseX, mouseY);
            if (window.EventButton() == 1) {
                // Secondary button release: resolve the right-click target only;
                // the primary click target stays untouched so Ui.Clicked stays
                // quiet on a right click.
                rightClickTargetId = hitId;
            } else {
                // Resolve the click target against the still-intact previous-frame
                // hit regions (popups included, top-most wins) before BeginFrame
                // clears them, so exactly one widget sees Ui.Clicked this frame.
                clickTargetId = hitId;
                NoteRelease(mouseX, mouseY);
                NoteClickTarget(clickTargetId);
                focus.ClearPress();
            }
            needsRedraw = true;
        }

        // Tab / Shift+Tab move keyboard focus through the focusable ring built
        // last frame (see FocusManager.RegisterFocusable).
        if (kind == 4 && window.EventKeyCode() == 9) {
            if (!this.HasOverlays() && !blocksInputBelow && tabHoldId < 0) {
                int dir = 1;
                if (Modifiers.HasShift(window.EventMods())) { dir = -1; }
                focus.FocusStep(dir);
            }
            needsRedraw = true;
        }

        if (kind == 13) {
            int delta = window.EventKeyCode();
            int viewH = canvas.Height() - titlebarH;
            mouseX = window.EventX();
            mouseY = window.EventY();
            if (this.HasOverlays() || blocksInputBelow) {
                // Popups and modal scrims own this input frame. Let their
                // render path consume the wheel instead of moving content
                // underneath the floating surface.
                needsRedraw = true;
            } else if (splitX > 0 && mouseX < splitX) {
                // Scroll the sidebar when the pointer is over it.
                int oldS = sidebarScrollY;
                sidebarScrollY = sidebarScrollY - delta * scrollSpeed / 120;
                if (sidebarScrollY < 0) { sidebarScrollY = 0; }
                int maxS = sidebarContentHeight - viewH;
                if (maxS < 0) { maxS = 0; }
                if (sidebarScrollY > maxS) { sidebarScrollY = maxS; }
                if (sidebarScrollY != oldS) { needsRedraw = true; }
            } else if (mouseX >= wheelCapX && mouseX < wheelCapX + wheelCapW
                       && mouseY >= wheelCapY && mouseY < wheelCapY + wheelCapH) {
                // Pointer is over a widget that scrolls internally (e.g. the
                // DataTable body); let it handle the wheel during render instead
                // of scrolling the whole page.
                needsRedraw = true;
            } else {
                int oldScroll = scrollY;
                scrollY = scrollY - delta * scrollSpeed / 120;
                if (scrollY < 0) { scrollY = 0; }
                int maxScroll = contentHeight - viewH;
                if (maxScroll < 0) { maxScroll = 0; }
                if (scrollY > maxScroll) { scrollY = maxScroll; }
                if (scrollY != oldScroll) {
                    needsRedraw = true;
                }
            }
        }

        // Typed character (WM_CHAR) / key down: repaint so focused text fields
        // (e.g. the DataTable filter search box) can consume the keystroke this
        // frame. The event slot still holds the char for widgets to read.
        if (kind == 6 || kind == 4 || kind == 5) {
            needsRedraw = true;
        }

        // Resume a paused ambient effect once the window can be seen again
        // (FxPresent parks fxNextMs at -1 while hidden; the visibility-change
        // wake, like any event, lands here and re-arms it).
        if (fxSnapValid && fxNextMs < 0 && this.FxActive() && window.IsVisible()) {
            fxNextMs = Window.GetTickMs();
        }

        return true;
    }

    /// Native handle of this app's window (for multi-window event routing).
    nint WindowHandle() { return window.GetHandle(); }

    /// Applies the current, already-pumped native event to this window when the
    /// event originated from it (evHwnd == this window). This lets a single
    /// process drive several top-level windows (e.g. the IDE plus a floating
    /// dialog) from one shared event pump: the loop pumps once, reads the event
    /// hwnd, and offers the event to each App via ApplyEvent. Returns false if
    /// THIS window received a close event.
    bool ApplyEvent(nint evHwnd) {
        bool mine = evHwnd == window.GetHandle();
        int kind = window.EventKind();
        backdropDirty = mine && kind != 0;

        // Same contract as ProcessEvent: run the work widgets and background
        // threads marshalled onto the UI thread. A multi-window pump drives its
        // windows through here instead of ProcessEvent, so without this every
        // posted handler (TreeView.Context, Select, ...) queues up forever and
        // the features built on them -- context menus above all -- go dead.
        if (mine) { DrainPosts(); }

        if (mine && kind == 8) {
            isRunning = false;
            return false;
        }
        if (!mine) {
            // Not this window's event: leave every piece of interaction state
            // alone. Widgets no longer test the shared native event kind (they
            // go through App.EventKind, which reports "no event" here), so a
            // sibling window's click cannot reach this window's widgets, and
            // clearing press/click/focus state would instead break a drag or a
            // pressed button that is legitimately live in this window.
            return true;
        }

        int curW = window.ClientWidth();
        int curH = window.ClientHeight();
        if (curW > 0 && curH > 0) {
            if (curW != canvas.Width() || curH != canvas.Height()) {
                canvas.Destroy();
                canvas = Canvas.Create(curW, curH);
                int viewH = curH - titlebarH;
                int maxScroll = contentHeight - viewH;
                if (maxScroll < 0) { maxScroll = 0; }
                if (scrollY > maxScroll) { scrollY = maxScroll; }
                if (scrollY < 0) { scrollY = 0; }
                needsRedraw = true;
            }
        }

        if (kind == 1) {
            mouseX = window.EventX();
            mouseY = window.EventY();
            int hitId = hitTester.HitTest(mouseX, mouseY);
            int oldHover = focus.hoveredId;
            focus.SetHovered(hitId);
            if (hitId != oldHover) { needsRedraw = true; }
            if (focus.pressedId >= 0) { needsRedraw = true; }
            // Button held: immediate-mode drag logic (canvas elements, marquee,
            // resize handles) lives in render code, so every move while the
            // pointer is down must reach a frame even off any widget.
            if (pointerDown) { needsRedraw = true; }
            int cursorId = hitId;
            if (focus.pressedId >= 0) { cursorId = focus.pressedId; }
            int wtype = hitTester.GetWidgetType(cursorId);
            if (wtype == 0) { Window.SetCursor(1); }
            else if (wtype == 1) { Window.SetCursor(2); }
            else if (wtype == 4) { Window.SetCursor(3); }
            else if (wtype == 5) { Window.SetCursor(4); }
            else { Window.SetCursor(0); }
        }

        if (kind == 2) {
            mouseX = window.EventX();
            mouseY = window.EventY();
            int hitId = hitTester.HitTest(mouseX, mouseY);
            if (window.EventButton() == 1) {
                rightPressTargetId = hitId;
            } else {
                focus.SetPressed(hitId);
                focus.SetFocused(hitId);
                pressTargetId = hitId;
                pointerDown = true;
                NotePressStart(hitId, mouseX, mouseY);
            }
            needsRedraw = true;
        }

        if (kind == 3) {
            mouseX = window.EventX();
            mouseY = window.EventY();
            int hitId = hitTester.HitTest(mouseX, mouseY);
            if (window.EventButton() == 1) {
                rightClickTargetId = hitId;
            } else {
                clickTargetId = hitId;
                pointerDown = false;
                NoteRelease(mouseX, mouseY);
                NoteClickTarget(clickTargetId);
                focus.ClearPress();
            }
            needsRedraw = true;
        }

        if (kind == 4 && window.EventKeyCode() == 9) {
            if (!this.HasOverlays() && !blocksInputBelow && tabHoldId < 0) {
                int dir = 1;
                if (Modifiers.HasShift(window.EventMods())) { dir = -1; }
                focus.FocusStep(dir);
            }
            needsRedraw = true;
        }

        if (kind == 13) {
            mouseX = window.EventX();
            mouseY = window.EventY();
            int delta = window.EventKeyCode();
            int viewH = canvas.Height() - titlebarH;
            if (this.HasOverlays() || blocksInputBelow) {
                needsRedraw = true;
            } else if (mouseX >= wheelCapX && mouseX < wheelCapX + wheelCapW
                && mouseY >= wheelCapY && mouseY < wheelCapY + wheelCapH) {
                needsRedraw = true;
            } else {
                int oldScroll = scrollY;
                scrollY = scrollY - delta * scrollSpeed / 120;
                if (scrollY < 0) { scrollY = 0; }
                int maxScroll = contentHeight - viewH;
                if (maxScroll < 0) { maxScroll = 0; }
                if (scrollY > maxScroll) { scrollY = maxScroll; }
                if (scrollY != oldScroll) { needsRedraw = true; }
            }
        }

        if (kind == 6 || kind == 4 || kind == 5) { needsRedraw = true; }

        // Resume a paused ambient effect once the window can be seen again
        // (FxPresent parks fxNextMs at -1 while hidden; the visibility-change
        // wake, like any event, lands here and re-arms it).
        if (fxSnapValid && fxNextMs < 0 && this.FxActive() && window.IsVisible()) {
            fxNextMs = Window.GetTickMs();
        }

        return true;
    }

    void PresentFrame() {
        int perfT0 = 0;
        if (App.PerfOn()) { perfT0 = Window.GetTickMs(); }
        // Draw + dispatch popups last so they sit above all content and own the
        // top-most hit regions (framework-owned overlay/z-order layer).
        RunOverlays();
        int perfT1 = 0;
        if (App.PerfOn()) { perfT1 = Window.GetTickMs(); }
        // Signature skin motion: snapshot the finished frame (slot 7), then
        // composite the effect layer on top. Later pure effect ticks restore
        // the snapshot and re-composite (FxPresent) without re-rendering.
        if (this.FxActive()) {
            Canvas fc = canvas;
            // The snapshot only exists to let a later *idle* tick re-composite
            // the effect without re-rendering. While frames follow each other
            // back to back (scrolling, typing, dragging) the next frame is a
            // full render anyway, so copying the whole surface every frame is
            // pure overhead -- on a 2646x1646 window it is the single largest
            // block of pixel traffic in the frame. Skip it during that burst and
            // arm a wake shortly after activity stops; that frame is far enough
            // from its predecessor to snapshot and resume idle ticking.
            int fxNow = Window.GetTickMs();
            bool burst = lastPresentMs > 0 && fxNow - lastPresentMs < 120;
            if (burst) {
                fxSnapValid = false;
                fxDamage = null;
                fxNextMs = fxNow + 150;
            } else {
                fc.SnapshotRect(0, 0, fc.Width(), fc.Height(), 7);
                fxSnapValid = true;
            }
            BackdropFx.Render(fc, this.EffectiveFx(), 0, 0, fc.Width(), fc.Height(),
                              fxNow, theme, dpiScale);
            if (!burst) {
                fxDamage = BackdropFx.TakeDamage();
                fxNextMs = Window.GetTickMs() + this.FxIntervalMs();
            } else {
                BackdropFx.TakeDamage();
            }
            if (!window.IsVisible()) { fxNextMs = -1; }
        } else {
            fxNextMs = -1;
        }
        int perfPreMs = 0;
        if (App.PerfOn()) {
            perfPreMs = Window.GetTickMs();
            perfOverlayMs = perfOverlayMs + (perfT1 - perfT0);
            perfFxMs = perfFxMs + (perfPreMs - perfT1);
        }
        if (partialFrame) {
            canvas.PopClip();
            window.PresentDirty(dmgX, dmgY, dmgW, dmgH);
        }
        window.Present(canvas);
        if (App.PerfOn()) {
            int endMs = Window.GetTickMs();
            perfRenderMs = perfRenderMs + (perfPreMs - perfBeginMs);
            perfPresentMs = perfPresentMs + (endMs - perfPreMs);
            perfFrames = perfFrames + 1;
            if (perfFrames >= 30) {
                File.AppendAllText("zan_frame_perf.log",
                    "frames=" + Convert.ToString(perfFrames)
                    + " render_ms=" + Convert.ToString(perfRenderMs / perfFrames)
                    + " present_ms=" + Convert.ToString(perfPresentMs / perfFrames)
                    + " overlay_ms=" + Convert.ToString(perfOverlayMs / perfFrames)
                    + " fx_ms=" + Convert.ToString(perfFxMs / perfFrames)
                    + " surface=" + Convert.ToString(canvas.Width())
                    + "x" + Convert.ToString(canvas.Height()) + "\n");
                File.AppendAllText("zan_frame_perf.log",
                    "  raster/frame " + App.RasterLine(perfFrames) + "\n");
                perfFrames = 0;
                perfRenderMs = 0;
                perfPresentMs = 0;
                perfOverlayMs = 0;
                perfFxMs = 0;
            }
        }
        frameCount = frameCount + 1;
        lastPresentMs = Window.GetTickMs();
        // Snapshot hover/focus/press as this frame's "previous" baseline so the
        // next rendered frame can detect enter/leave and focus/blur transitions
        // (Ui.Entered/Left/FocusGained/FocusLost).
        focus.RollFrame();
    }

    /// True when the opt-in frame profiler is enabled (ZAN_FRAME_PROF=1).
    static bool PerfOn() {
        if (App.perfMode == 0) {
            App.perfMode = 2;
            if (Interop.EnvVar("ZAN_FRAME_PROF") == "1") { App.perfMode = 1; }
        }
        return App.perfMode == 1;
    }

    /// One line of per-frame rasterizer work for the frame profiler: calls and
    /// thousands of pixels per primitive, averaged over `frames` frames.
    static string RasterLine(int frames) {
        List<string> names = new List<string>();
        names.Add("fill");
        names.Add("blend");
        names.Add("grad");
        names.Add("round");
        names.Add("radial");
        names.Add("blur");
        names.Add("blurhit");
        names.Add("img");
        names.Add("snap");
        names.Add("restore");
        names.Add("glyph");
        string line = "";
        int i = 0;
        while (i < names.Count) {
            int calls = Canvas.RasterStat(i, 0);
            int kpx = Canvas.RasterStat(i, 1);
            if (calls > 0 || kpx > 0) {
                line = line + names[i] + "=" + Convert.ToString(calls / frames)
                    + "/" + Convert.ToString(kpx / frames) + "kpx ";
            }
            i = i + 1;
        }
        int rank = 0;
        while (rank < 6) {
            int kpx = Canvas.RasterTopBlend(rank, 0);
            int bx = Canvas.RasterTopBlend(rank, 1);
            int by = Canvas.RasterTopBlend(rank, 2);
            int bw = Canvas.RasterTopBlend(rank, 3);
            int ba = Canvas.RasterTopBlend(rank, 5);
            int bh = Canvas.RasterTopBlend(rank, 4);
            if (kpx > 0) {
                line = line + "top" + Convert.ToString(rank) + "="
                    + Convert.ToString(kpx) + "kpx@" + Convert.ToString(bx)
                    + "," + Convert.ToString(by) + "+" + Convert.ToString(bw)
                    + "x" + Convert.ToString(bh) + "a" + Convert.ToString(ba)
                    + " ";
            }
            rank = rank + 1;
        }
        return line;
    }

    void BeginFrame() {
        if (App.PerfOn()) { perfBeginMs = Window.GetTickMs(); }
        // Apply a freshly-picked built-in skin before anything paints, so the
        // whole window (content + chrome) redraws in the new theme this frame.
        this.SyncSkin();
        // Advance the animation clock. AnimTo() uses (nowMs - lastFrameMs) as
        // the elapsed step so eases run at a wall-clock rate regardless of fps.
        lastFrameMs = nowMs;
        nowMs = Window.GetTickMs();
        // Clear the redraw flag at frame start; handlers invoked during this
        // frame may set it again to request an immediate follow-up repaint.
        needsRedraw = false;
        // Clear any throttled-animation deadline too; still-live animations
        // (spinners etc.) re-arm it via RequestAnimationFrame during render.
        animNextMs = -1;
        // The frame is being re-rendered, so the slot-7 fx snapshot is stale.
        fxSnapValid = false;
        // Hand glass surfaces stable blur-cache slots again from the top.
        blurSlotSeq = 0;
        wheelOwnerOrder = wheelCapOrder;
        wheelClaimSeq = 0;
        wheelCapOrder = 0;
        wheelCapW = 0;
        wheelCapH = 0;
        tabHoldId = -1;
        inputBlockPrevious = blocksInputBelow;
        blocksInputBelow = false;
        clickClaimed = false;
        hitTester.Clear();
        window.ClearHitGuards();
        focus.ResetIds();
        overlays = new List<OverlayPopup>();
        partialFrame = false;
        if (partialPending && dmgW > 0 && dmgH > 0 && !this.FxActive()) {
            partialFrame = true;
        }
        partialPending = false;
        if (partialFrame) {
            // Everything below paints as usual; the clip keeps it inside the
            // damaged strip, so untouched pixels of the last frame stand.
            canvas.PushClip(dmgX, dmgY, dmgW, dmgH);
        }
        if (shapeMode != 0) {
            // Shaped window: clear the whole surface fully transparent so only
            // the tree's pixels define the silhouette (the OS composites it
            // with per-pixel alpha and anti-aliased edges).
            if (partialFrame) {
                canvas.FillRect(dmgX, dmgY, dmgW, dmgH, 0);
            } else {
                canvas.Clear(0);
            }
        } else if (glassNative) {
            // Frosted sheet: clear the whole window to a *semi-transparent* tint
            // (not fully transparent) so the OS backdrop shows through evenly
            // blurred while the window stays a solid, bordered glass panel. A
            // fully transparent clear left the window looking see-through/washed
            // (and borderless) over light backgrounds.
            int rgb = theme.bgPrimary % 16777216;
            if (rgb < 0) { rgb = rgb + 16777216; }
            if (partialFrame) {
                canvas.FillRect(dmgX, dmgY, dmgW, dmgH, 198 * 16777216 + rgb);
            } else {
                canvas.Clear(198 * 16777216 + rgb);
            }
        } else {
            if (partialFrame) {
                canvas.FillRect(dmgX, dmgY, dmgW, dmgH, theme.bgPrimary);
            } else {
                canvas.Clear(theme.bgPrimary);
            }
        }
    }

    /// Queues a popup to be painted and dispatched after the main content pass,
    /// so it sits above everything and owns the top-most hit regions. See
    /// <see cref="RunOverlays"/>.
    void AddOverlay(OverlayPopup p) {
        overlays.Add(p);
        // A popup/tooltip appearing during a damage-clipped frame would be
        // clipped away: ask for one full frame right after it registers.
        if (partialFrame) { needsRedraw = true; }
    }

    /// Draws + dispatches every overlay registered this frame, in registration
    /// order. Call once, right after the main render and before PresentFrame.
    void RunOverlays() {
        int i = 0;
        while (i < overlays.Count) {
            OverlayPopup p = overlays[i];
            p.Render(this);
            i = i + 1;
        }
    }

    /// True while a popup layer is active this frame.
    bool HasOverlays() { return overlays.Count > 0; }

    /// True while a modal overlay / popup scrim owns the pointer -- either this
    /// frame (a BlockHitsRect/BlockHitsBelow ran) or the previous one (the popup
    /// was already up). Immediate-mode widgets that read mouseX/mouseY directly
    /// must gate their hover/press/click on `!PointerCaptured()` so the pointer
    /// does not fall through the popup to the layer beneath it.
    bool PointerCaptured() {
        if (blocksInputBelow || inputBlockPrevious) { return true; }
        // A rect-scoped blocker (floating window, popover, select popup, loading
        // mask) captures the pointer over its area without ever setting the
        // global full-window flags. Content beneath it renders before the
        // overlay registers, so it reads the previous frame's blockers; a
        // blocker's own body (which already laid its scrim this frame) is
        // excluded via BlockerAt so it stays interactive.
        return hitTester.PrevBlockerAt(mouseX, mouseY)
            && !hitTester.BlockerAt(mouseX, mouseY);
    }

    /// Registers a hit region that swallows clicks over [x,y,w,h] so a modal /
    /// popup surface blocks the widgets beneath it. The HitTester is
    /// last-registered-wins and overlays paint after the page content, so
    /// calling this while drawing the backdrop -- and BEFORE the overlay's own
    /// buttons register -- makes the blocker win everywhere except on those
    /// buttons. Returns the blocker id.
    int BlockHitsRect(int x, int y, int w, int h) {
        int id = focus.AllocId();
        hitTester.Register(HitRegion.Create(id, x, y, w, h, -1));
        return id;
    }

    /// Claims [x,y,w,h] for the client area against the window frame's edge
    /// resize grips. A control drawn flush with the window edge -- a scrollbar
    /// in the last few pixels -- is otherwise unclickable there: the frame's
    /// grip answers the OS hit test first, so the press never reaches the
    /// client and only the wheel still scrolls. Corner grips keep priority, so
    /// a diagonal resize stays reachable. Call once per frame while drawing.
    void ReserveEdgeHit(int x, int y, int w, int h) {
        window.AddHitGuard(x, y, w, h);
    }

    /// Full-window BlockHitsRect: the standard scrim for a modal overlay whose
    /// dimmed backdrop covers the whole window.
    int BlockHitsBelow() {
        bool firstBlock = !blocksInputBelow;
        blocksInputBelow = true;
        int id = BlockHitsRect(0, 0, canvas.Width(), canvas.Height());
        if (firstBlock && !inputBlockPrevious) {
            focus.SetFocused(id);
            // The modal appeared during this frame, so the click being
            // dispatched (the one that opened it) is spent: without this, a
            // surface drawn inside the new modal at the same coordinates as
            // the opening button would receive that same click.
            clickClaimed = true;
        }
        return id;
    }

    /// The kind of the OS event being processed, or 0 ("no event") when that
    /// event belongs to a different window. The native event state is
    /// process-global: a surface that read window.EventKind() directly also saw
    /// clicks and keys delivered to a sibling or child window, and fired its own
    /// widget whenever the ids happened to line up. Every window-owned surface
    /// must ask its App, not the shared native state.
    int EventKind() {
        if (Window.EventHwnd() != window.GetHandle()) { return 0; }
        return window.EventKind();
    }

    /// True when the event being processed was delivered to this App's window.
    bool EventIsMine() { return Window.EventHwnd() == window.GetHandle(); }

    /// True while a primary click (mouse-up) event is live this frame and may
    /// be acted on by the surface being rendered right now. Immediate-mode
    /// surfaces should test this instead of window.EventKind() == 3: it is
    /// false when the click was claimed (a modal opened on this very click),
    /// and false for content painted *under* an open modal scrim -- a modal
    /// was up last frame (inputBlockPrevious) but its BlockHitsBelow has not
    /// run yet this frame, meaning the code asking renders below it. The
    /// modal's own internals render after its scrim, where this is true
    /// again, so clicks never fall through a modal to the page beneath.
    bool ClickAvailable() {
        if (this.EventKind() != 3 || clickClaimed) { return false; }
        // Only the primary button clicks. The right button's release must not
        // read as a click, or the widget the context menu was just opened over
        // also selects/toggles and the menu is dismissed in the same gesture.
        if (window.EventButton() != 0) { return false; }
        if (inputBlockPrevious && !blocksInputBelow) { return false; }
        // Same rule for rect-scoped blockers (floating windows, popovers,
        // selects): a click over a blocker that was up last frame belongs to
        // that overlay, not the content beneath it -- unless the surface asking
        // is the overlay's own body (it already laid its scrim this frame).
        if (hitTester.PrevBlockerAt(mouseX, mouseY)
            && !hitTester.BlockerAt(mouseX, mouseY)) { return false; }
        return true;
    }

    /// Marks the live click as consumed for the rest of this frame.
    void ClaimClick() { clickClaimed = true; }

    /// Id of the widget the current click (mouse-up) landed on, or -1.
    int ClickTarget() { return clickTargetId; }

    /// Id of the widget the current press (mouse-down) landed on, or -1.
    int PressTarget() { return pressTargetId; }

    /// Id of the widget the current secondary (right) click landed on, or -1.
    int RightClickTarget() { return rightClickTargetId; }

    /// Id of the widget the current secondary (right) press landed on, or -1.
    int RightPressTarget() { return rightPressTargetId; }

    /// True on the frame a completed click is the second of a double click on
    /// the same widget within the double-click window (see Ui.DoubleClicked).
    bool DoubleClickNow() { return doubleClickNow; }

    /// Records a completed click on `id` and flags a double click when it
    /// repeats on the same id within 400 ms. Called from the mouse-up paths.
    void NoteClickTarget(int id) {
        int t = Window.GetTickMs();
        if (id >= 0 && id == lastClickId && (t - lastClickMs) <= 400) {
            doubleClickNow = true;
        } else {
            doubleClickNow = false;
        }
        lastClickId = id;
        lastClickMs = t;
    }

    /// Snapshots the press target/position/time so gestures (swipe, long-press)
    /// can be derived from the press onward. Called from the mouse-down paths.
    void NotePressStart(int id, int x, int y) {
        pressStartId = id;
        pressStartX = x;
        pressStartY = y;
        pressStartMs = Window.GetTickMs();
        longPressFired = false;
        swipeDir = 0;
    }

    /// Derives a swipe direction from the press-to-release travel: 0 none,
    /// 1 left, 2 right, 3 up, 4 down. Called from the mouse-up paths, so it is
    /// valid to read (via SwipeDir) on a release frame.
    void NoteRelease(int x, int y) {
        int dx = x - pressStartX;
        int dy = y - pressStartY;
        int adx = dx; if (adx < 0) { adx = -adx; }
        int ady = dy; if (ady < 0) { ady = -ady; }
        swipeDir = 0;
        if (adx >= 48 || ady >= 48) {
            if (adx >= ady) {
                if (dx < 0) { swipeDir = 1; } else { swipeDir = 2; }
            } else {
                if (dy < 0) { swipeDir = 3; } else { swipeDir = 4; }
            }
        }
    }

    /// Swipe direction resolved on the current release frame (see NoteRelease).
    int SwipeDir() { return swipeDir; }
    /// The widget the in-flight gesture started on (press target).
    int SwipeTarget() { return pressStartId; }

    /// Reports a long press on `id` once the pointer has been held on it past
    /// the threshold without moving far. Arms a low-cadence follow-up frame
    /// while holding so the timer advances even with no further input; returns
    /// true exactly once per press. Movement beyond a small slop cancels it
    /// (the gesture is then a drag/swipe, not a long press).
    bool PollLongPress(int id) {
        if (longPressFired) { return false; }
        if (focus.pressedId != id) { return false; }
        if (pressStartId != id) { return false; }
        int mdx = mouseX - pressStartX; if (mdx < 0) { mdx = -mdx; }
        int mdy = mouseY - pressStartY; if (mdy < 0) { mdy = -mdy; }
        if (mdx > 12 || mdy > 12) { longPressFired = true; return false; }
        int t = Window.GetTickMs();
        if ((t - pressStartMs) >= 500) {
            longPressFired = true;
            RequestRedraw();
            return true;
        }
        RequestAnimationFrame(80);
        return false;
    }
}
