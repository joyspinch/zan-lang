using System;
using System.IO;
using System.Json;
using System.Diagnostics;

namespace Gui;

/// <summary>
/// 皮肤包：一个目录，含 `skin.css`（`:root` 里的语义令牌加上
/// 每控件规则）及其美术资源。皮肤是数据而非代码——用户可以在
/// 应用旁放一个文件夹并在运行时选用：
///
///     stdlib/Gui/skins/fortune/skin.css
///     stdlib/Gui/skins/fortune/banner.png
///
///     Skin s = Skin.Load("fortune");
///     s.Apply(app);            // 主题令牌 + 样式表 + 背景美术
///
/// `:root` 自定义属性供给语义 Theme（因此任何未被
/// CSS 样式化的东西仍得到皮肤的调色板），其余每条规则供给控件绘制所用的
/// 样式解析器（Style/StyleBox）。两半都可选：
/// 只有 `:root` 的皮肤就是换调色板，只有规则的皮肤在当前主题之上
/// 重设控件样式。
/// </summary>
class Skin {
    string name;
    string dir;
    StyleSheet sheet;
    Theme theme;
    bool dark;
    /// 背景插画（绝对或相对应用路径，皮肤不带则为 ""）
    /// 及其叠加在壁纸上的强度（百分比）。
    string art;
    int artOpacity;
    bool loaded;

    static List<string> cacheNames;
    static List<Skin> cacheSkins;

    Skin(string skinName) {
        this.name = skinName;
        this.dir = "";
        this.sheet = new StyleSheet();
        this.theme = null;
        this.dark = true;
        this.art = "";
        this.artOpacity = 100;
        this.loaded = false;
    }

    /// 加载（并记忆）名为 `name` 的皮肤，在皮肤根目录中查找。
    /// 找不到时返回带空样式表的皮肤，因此缺失的
    /// 皮肤会退化为当前主题而不是失败。
    static Skin Load(string name) {
        if (Skin.cacheNames == null) {
            Skin.cacheNames = new List<string>();
            Skin.cacheSkins = new List<Skin>();
        }
        for (int i = 0; i < Skin.cacheNames.Count; i = i + 1) {
            if (Skin.cacheNames[i] == name) { return Skin.cacheSkins[i]; }
        }
        Skin s = new Skin(name);
        s.dir = Skin.FindDir(name);
        // 从磁盘读取 CSS（让用户覆盖内置的包），否则从
        // exe 内嵌的资源读取。
        string css = "";
        if (s.dir != "") { css = Skin.ReadIfExists(s.dir + "/skin.css"); }
        if (css == "") { css = Skin.EmbedRead("skins/" + name + "/skin.css"); }
        if (css != "") {
            s.loaded = true;
            s.sheet = StyleSheet.FromCss(css);
            s.art = Skin.FindArt(s.dir);
            s.theme = Skin.ThemeOf(s.sheet);
            s.dark = Skin.DarkOf(s.sheet);
            string op = s.sheet.Var("--art-opacity");
            if (op != "") { s.artOpacity = StyleSheet.Num(op); }
        }
        Skin.cacheNames.Add(name);
        Skin.cacheSkins.Add(s);
        return s;
    }

    /// 从磁盘重新读取皮肤（供皮肤热重载路径使用，使 CSS
    /// 编辑无需重启应用即可生效）。
    static Skin Reload(string name) {
        if (Skin.cacheNames != null) {
            for (int i = 0; i < Skin.cacheNames.Count; i = i + 1) {
                if (Skin.cacheNames[i] == name) {
                    Skin.cacheNames.RemoveAt(i);
                    Skin.cacheSkins.RemoveAt(i);
                    i = Skin.cacheNames.Count;
                }
            }
        }
        return Skin.Load(name);
    }

    /// 在磁盘上找到该包时为 true。
    bool IsLoaded() { return loaded; }

    /// 该包自己的背景插画路径（不带时为 ""）。
    string ArtPath() { return art; }

    /// 由该包 `:root` 令牌构建的新 Theme；若包
    /// 只有规则则为 null。调用方拥有结果并可修改它。
    Theme NewTheme() {
        if (theme == null) { return null; }
        return Skin.ThemeOf(sheet);
    }

    /// 把皮肤安装到 `app`：`:root` 的 Theme（回退到
    /// 当前主题）、每个控件都要解析的样式表，以及
    /// 背景美术。只有用户未自选壁纸时，包的美术才填充背景——
    /// 用户壁纸永远优先，因此
    /// 切换皮肤永远不会拿包背景换掉用户自选的壁纸。
    void Apply(App app) {
        app.sheet = sheet;
        app.skinName = name;
        // 每次都新建 Theme：ApplyTheme 会修改传入的实例
        // （DPI 缩放、表面半透明），把缓存的实例交给它
        // 会在每次切回这个包时叠加这些修改。
        Theme fresh = this.NewTheme();
        if (fresh != null) { app.ApplyTheme(fresh, dark); }
        // 当前壁纸是上一个包的背景吗？（skinArt 这里仍指向
        // 旧包——this.ApplyTheme 不会碰它。）
        bool hadArt = app.SkinArtWallpaper();
        // 用户壁纸是任何非背景图像；在 skinArt 被
        // 下面覆盖之前记住它。
        bool hadUser = app.HasUserWallpaper();
        app.skinArt = art;
        app.skinArtOpacity = artOpacity;
        if (art != "" && !hadUser) {
            app.SetWallpaper(art, artOpacity);
        } else if (hadArt && art == "" && !hadUser) {
            // 离开一个安装了美术的包、换到没有美术的包：
            // 它的插画应一并移除（但绝不移除用户壁纸）。
            app.ClearWallpaper();
        }
        app.bgThemeGen = app.bgThemeGen + 1;
        app.needsRedraw = true;
    }

    // ---- discovery ----------------------------------------------------------

    /// 搜索皮肤包的根，最具体者优先：`$ZAN_GUI_SKINS`、
    /// 应用自己的 `skins/`，然后是 stdlib 副本（从构建树运行时）。
    static List<string> Roots() {
        List<string> r = new List<string>();
        string env = Skin.Env("ZAN_GUI_SKINS");
        if (env != "") { r.Add(env); }
        // 自解压启动器传入的安装目录（启动器把 exe 解压到
        // 每用户缓存目录）：skins/base.css 位于此处，而不在
        // 解压出的 exe 旁，因此也要经 ZAN_APP_DIR 解析它们。
        string appdir = Skin.Env("ZAN_APP_DIR");
        if (appdir != "") {
            r.Add(appdir + "/skins");
            r.Add(appdir + "/assets/skins");
            r.Add(appdir + "/stdlib/Gui/skins");
        }
        // 皮肤包随可执行文件存放（如 ide.css / SDL3.dll），因此
        // 先从 exe 所在位置解析，这样皮肤发现就不受
        // 进程启动时工作目录的影响。
        string exe = Skin.ExeDir();
        if (exe != "") {
            r.Add(exe + "/skins");
            r.Add(exe + "/assets/skins");
            // macOS .app 的 exe 在 Contents/MacOS，皮肤资源在 Contents/Resources。
            r.Add(exe + "/../Resources/skins");
            r.Add(exe + "/../Resources/assets/skins");
            r.Add(exe + "/stdlib/Gui/skins");
            r.Add(exe + "/../stdlib/Gui/skins");
            r.Add(exe + "/../../stdlib/Gui/skins");
        }
        r.Add("skins");
        r.Add("assets/skins");
        r.Add("stdlib/Gui/skins");
        r.Add("../stdlib/Gui/skins");
        r.Add("../../stdlib/Gui/skins");
        return r;
    }

    /// 正在运行的可执行文件所在目录（不含末尾分隔符），无法确定时返回 ""。
    /// 便于按 exe 目录定位资源，
    /// 而非当前工作目录。
    static string ExeDir() {
        string p = ProcessHost.SelfExe();
        int cut = 0 - 1;
        for (int i = 0; i < p.Length; i = i + 1) {
            string ch = p.Substring(i, 1);
            if (ch == "\\" || ch == "/") { cut = i; }
        }
        if (cut < 0) { return ""; }
        return p.Substring(0, cut);
    }

    /// 皮肤 `name` 所在目录，没有任何根目录持有该皮肤时返回 ""。
    static string FindDir(string name) {
        List<string> roots = Skin.Roots();
        int i = 0;
        while (i < roots.Count) {
            string cand = roots[i] + "/" + name;
            i = i + 1;
            if (File.Exists(cand + "/skin.css")) { return cand; }
        }
        return "";
    }

    /// 磁盘上所有可发现的皮肤包（包含 skin.css 的目录）。
    static List<string> Available() {
        List<string> names = new List<string>();
        List<string> roots = Skin.Roots();
        int i = 0;
        while (i < roots.Count) {
            string root = roots[i];
            i = i + 1;
            if (!Directory.Exists(root)) { continue; }
            List<string> dirs = Directory.GetDirectories(root);
            int k = 0;
            while (k < dirs.Count) {
                // Directory.GetDirectories 返回的是裸目录名，因此探测 skin.css 之前
                // 需要先重新拼回根路径。
                string nm = Skin.Leaf(dirs[k]);
                string d = root + "/" + nm;
                k = k + 1;
                if (!File.Exists(d + "/skin.css")) { continue; }
                if (Skin.Contains(names, nm)) { continue; }
                names.Add(nm);
            }
        }
        // 内置于 exe 的皮肤包（每个形如 "skins/<name>/skin.css"）。
        string emb = Skin.EmbedList("skins/");
        int start = 0;
        for (int p = 0; p <= emb.Length; p = p + 1) {
            bool brk = false;
            if (p == emb.Length) { brk = true; }
            else if (emb[p] == '\n') { brk = true; }
            if (brk) {
                if (p > start) {
                    string line = emb.Substring(start, p - start);
                    string nm = Skin.EmbedSkinName(line);
                    if (nm != "" && !Skin.Contains(names, nm)) { names.Add(nm); }
                }
                start = p + 1;
            }
        }
        return names;
    }

    /// "skins/dark/skin.css" -> "dark"；无包文件夹的名称返回 ""
    /// （例如顶层 "skins/base.css"）。
    static string EmbedSkinName(string line) {
        string pre = "skins/";
        if (line.Length <= pre.Length) { return ""; }
        if (line.Substring(0, pre.Length) != pre) { return ""; }
        string rest = line.Substring(pre.Length, line.Length - pre.Length);
        int slash = -1;
        int i = 0;
        while (i < rest.Length) {
            if (rest[i] == '/') { slash = i; i = rest.Length; }
            else { i = i + 1; }
        }
        if (slash <= 0) { return ""; }
        return rest.Substring(0, slash);
    }

    /// 所有皮肤，按选择器顺序：`--order` 在前（内置包自编号 0..n），
    /// 未声明顺序的包随后按字母序。这是
    /// 应用、标题栏选择器和持久化设置共同引用的
    /// 唯一一份皮肤列表。
    static List<string> Names() {
        List<string> names = Skin.Available();
        List<string> outp = new List<string>();
        while (names.Count > 0) {
            int best = 0;
            int i = 1;
            while (i < names.Count) {
                if (Skin.OrderOf(names[i]) < Skin.OrderOf(names[best])) {
                    best = i;
                }
                i = i + 1;
            }
            outp.Add(names[best]);
            names.RemoveAt(best);
        }
        return outp;
    }

    /// 来自 `--order` 的排序键（未声明的包排在内置包之后）。
    static int OrderOf(string name) {
        Skin s = Skin.Load(name);
        string v = s.sheet.Var("--order");
        if (v == "") { return 1000; }
        return StyleSheet.Num(v);
    }

    /// 显示名取自 `--name`，未设置时回退到文件夹名。
    static string LabelOf(string name) {
        Skin s = Skin.Load(name);
        string v = s.sheet.Var("--name");
        if (v == "") { return name; }
        return Skin.Unquote(v);
    }

    /// `names` 对应的显示名列表，保持相同顺序。
    static List<string> Labels(List<string> names) {
        List<string> outp = new List<string>();
        for (int i = 0; i < names.Count; i = i + 1) {
            outp.Add(Skin.LabelOf(names[i]));
        }
        return outp;
    }

    /// 皮肤的插图：`--art` 指定的文件，否则用包内约定的
    /// 横幅文件。
    static string FindArt(string dir) {
        List<string> cands = new List<string>{
            dir + "/banner.png",
            dir + "/banner.jpg",
            dir + "/backdrop.png",
            dir + "/backdrop.jpg" };
        for (int i = 0; i < cands.Count; i = i + 1) {
            if (File.Exists(cands[i])) { return cands[i]; }
        }
        return "";
    }

    // ---- :root tokens -> Theme ---------------------------------------------

    /// 从皮肤的 `:root` 自定义属性构建其 Theme。`--base`
    /// 选择起始预设（"dark"、"light" 或预设名/索引），
    /// 其余每个 `--token` 覆盖 Theme 的一个字段；CSS 拼写同样
    /// 被接受，所以 `--bg-primary` 设置 `bgPrimary`。皮肤未声明任何
    /// token 时返回 null（沿用应用当前主题）。
    static Theme ThemeOf(StyleSheet sheet) {
        if (sheet == null || sheet.vars == null || sheet.vars.Count() == 0) {
            return null;
        }
        Theme t = Skin.BaseOf(sheet);
        int i = 0;
        while (i < sheet.vars.Count()) {
            string key = sheet.vars.KeyAt(i);
            JsonValue v = sheet.vars.ValAt(i);
            i = i + 1;
            string tok = Skin.TokenName(key);
            if (tok == "base" || tok == "dark" || tok == "art"
                || tok == "artOpacity") { continue; }
            Theme.SetToken(t, tok, v);
        }
        return t;
    }

    /// 皮肤起步的 token 基线（`--base: light | dark`），默认
    /// 为 dark。只有这两种：其余皮肤都是
    /// 在它们之上覆写的 CSS 包。
    static Theme BaseOf(StyleSheet sheet) {
        if (sheet.Var("--base").ToLower() == "light") { return Theme.Light(); }
        return Theme.Dark();
    }

    /// 皮肤是否需要深色窗口边框（`--dark: 1`，否则
    /// 从 `--base` 推断）。
    static bool DarkOf(StyleSheet sheet) {
        string d = sheet.Var("--dark");
        if (d != "") { return StyleSheet.Num(d) != 0; }
        return sheet.Var("--base").ToLower() != "light";
    }

    /// `--bg-primary` / `--bgPrimary` / `bg-primary` 统一映射为 `bgPrimary`。
    static string TokenName(string key) {
        string k = key;
        if (k.Length >= 2 && k.Substring(0, 2) == "--") {
            k = k.Substring(2, k.Length - 2);
        }
        string outp = "";
        bool up = false;
        int i = 0;
        while (i < k.Length) {
            string ch = k.Substring(i, 1);
            i = i + 1;
            if (ch == "-" || ch == "_") { up = true; continue; }
            if (up) { outp = outp + ch.ToUpper(); up = false; }
            else { outp = outp + ch; }
        }
        return outp;
    }

    // ---- small helpers ------------------------------------------------------

    /// 去掉 CSS 字符串值两端的引号（`--name: "Liquid Glass"`）。
    static string Unquote(string v) {
        if (v.Length >= 2) {
            string q = v.Substring(0, 1);
            if (q == "\"" || q == "'") {
                if (v.Substring(v.Length - 1, 1) == q) {
                    return v.Substring(1, v.Length - 2);
                }
            }
        }
        return v;
    }

    static string ReadIfExists(string path) {
        if (!File.Exists(path)) { return ""; }
        return File.ReadAllText(path);
    }

    /// 内置组件基线 `base.css`，与皮肤包使用同样的搜索根。
    /// 它作为基础层垫在应用每个 sheet 之下，注入当前主题的 token，
    /// 使控件的默认外观由数据（CSS）决定，
    /// 而非硬编码在 Style.zan。没有根目录持有它时返回 ""。
    static string BaseCss() {
        List<string> roots = Skin.Roots();
        int i = 0;
        while (i < roots.Count) {
            string cand = roots[i] + "/base.css";
            i = i + 1;
            if (File.Exists(cand)) { return File.ReadAllText(cand); }
        }
        return Skin.EmbedRead("skins/base.css");
    }

    static string Leaf(string path) {
        int cut = -1;
        for (int i = 0; i < path.Length; i = i + 1) {
            string ch = path.Substring(i, 1);
            if (ch == "/" || ch == "\\") { cut = i; }
        }
        if (cut < 0) { return path; }
        return path.Substring(cut + 1, path.Length - cut - 1);
    }

    static bool Contains(List<string> list, string v) {
        for (int i = 0; i < list.Count; i = i + 1) {
            if (list[i] == v) { return true; }
        }
        return false;
    }

    static extern string getenv(string name);

    static string Env(string name) {
        string v = getenv(name);
        if (v == null) { return ""; }
        return v;
    }

    // ---- embedded resources (baked into the exe) ---------------------------
    static extern string zan_embed_read(string name);
    static extern int zan_embed_has(string name);
    static extern string zan_embed_list(string prefix);

    /// 内置于 exe 的文本资源，缺失（或未嵌入任何资源）时返回 ""。
    static string EmbedRead(string name) {
        string v = Skin.zan_embed_read(name);
        if (v == null) { return ""; }
        return v;
    }

    static bool EmbedHas(string name) { return Skin.zan_embed_has(name) != 0; }

    /// `prefix` 下以 '\n' 连接的内置资源名列表。
    static string EmbedList(string prefix) {
        string v = Skin.zan_embed_list(prefix);
        if (v == null) { return ""; }
        return v;
    }
}
