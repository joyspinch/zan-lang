using System;
using Gui.Backend;

namespace Gui;

/// <summary>Which corners of a rounded box are actually rounded, as a bit set
/// (`Corner.TL() + Corner.TR()` = the top two). Welded neighbours square off
/// their shared seam with it.</summary>
class Corner {
    static int TL() { return 1; }
    static int TR() { return 2; }
    static int BR() { return 4; }
    static int BL() { return 8; }
    static int All() { return 15; }
    /// The two corners on one side: `Corner.Top()`, `Corner.Left()`, ...
    static int Top() { return 3; }
    static int Right() { return 6; }
    static int Bottom() { return 12; }
    static int Left() { return 9; }
}

/// <summary>
/// 2D rendering canvas backed by zan_gui runtime (software renderer).
/// All drawing goes to a pixel buffer (Surface) which is presented to the OS window.
/// </summary>
class Canvas {
    [DllImport("zan_gui")]
    static extern int zan_gui_create_surface(int width, int height);

    [DllImport("zan_gui")]
    static extern int zan_gui_destroy_surface(int id);

    [DllImport("zan_gui")]
    static extern int zan_gui_surface_width(int id);

    [DllImport("zan_gui")]
    static extern int zan_gui_surface_height(int id);

    [DllImport("zan_gui")]
    static extern string zan_gui_get_pixels(int id);

    [DllImport("zan_gui")]
    static extern void zan_gui_clear(int surfaceId, int color);

    [DllImport("zan_gui")]
    static extern void zan_gui_fill_rect(int surfaceId, int x, int y, int w, int h, int color);

    [DllImport("zan_gui")]
    static extern int zan_gui_stat_read(int idx, int kind);

    [DllImport("zan_gui")]
    static extern int zan_gui_stat_top(int rank, int field);


    [DllImport("zan_gui")]
    static extern void zan_gui_draw_rect(int surfaceId, int x, int y, int w, int h, int color, int thickness);

    [DllImport("zan_gui")]
    static extern void zan_gui_fill_rounded_rect(int surfaceId, int x, int y, int w, int h, int radius, int color);

    [DllImport("zan_gui")]
    static extern void zan_gui_draw_rounded_rect(int surfaceId, int x, int y, int w, int h, int radius, int color, int thickness);

    [DllImport("zan_gui")]
    static extern void zan_gui_fill_rounded_rect_mask(int surfaceId, int x, int y, int w, int h, int radius, int corners, int color);

    [DllImport("zan_gui")]
    static extern void zan_gui_draw_rounded_rect_mask(int surfaceId, int x, int y, int w, int h, int radius, int corners, int color, int thickness);

    [DllImport("zan_gui")]
    static extern void zan_gui_blur_rect(int surfaceId, int x, int y, int w, int h, int radius);

    [DllImport("zan_gui")]
    static extern void zan_gui_blur_rect_cached(int surfaceId, int x, int y, int w, int h, int radius, int slot, int dirty);

    [DllImport("zan_gui")]
    static extern void zan_gui_blur_round_cached(int surfaceId, int x, int y, int w, int h, int radius, int slot, int dirty, int cornerRadius, int cornerMask);

    [DllImport("zan_gui")]
    static extern void zan_gui_snapshot_rect(int surfaceId, int x, int y, int w, int h, int slot);

    [DllImport("zan_gui")]
    static extern int zan_gui_restore_rect(int surfaceId, int x, int y, int w, int h, int slot);

    [DllImport("zan_gui")]
    static extern int zan_gui_restore_sub_rect(int surfaceId, int x, int y, int w, int h, int slot);

    [DllImport("zan_gui")]
    static extern void zan_gui_surface_release(int surfaceId, int slot);

    [DllImport("zan_gui")]
    static extern void zan_gui_fill_vgrad(int surfaceId, int x, int y, int w, int h, int colorTop, int colorBottom);

    [DllImport("zan_gui")]
    static extern void zan_gui_fill_circle(int surfaceId, int cx, int cy, int radius, int color);

    [DllImport("zan_gui")]
    static extern void zan_gui_draw_circle(int surfaceId, int cx, int cy, int radius, int color, int thickness);

    [DllImport("zan_gui")]
    static extern void zan_gui_fill_radial(int surfaceId, int cx, int cy, int radius, int color, int innerAlpha);

    [DllImport("zan_gui")]
    static extern void zan_gui_draw_line(int surfaceId, int x0, int y0, int x1, int y1, int color, int thickness);

    [DllImport("zan_gui")]
    static extern void zan_gui_fill_sector(int surfaceId, int cx, int cy, int rInner, int rOuter, int a0Deg, int a1Deg, int color);

    [DllImport("zan_gui")]
    static extern void zan_gui_draw_text(int surfaceId, int x, int y, string text, int color, int fontSize);

    [DllImport("zan_gui")]
    static extern int zan_gui_measure_text(string text, int fontSize);

    [DllImport("zan_gui")]
    static extern int zan_gui_font_height(int fontSize);

    #if !WINDOWS
    [DllImport("zan_gui")]
    static extern int zan_gui_get_dpi_scale();
    #endif

    [DllImport("zan_gui")]
    static extern int zan_gui_image_width(string path);

    [DllImport("zan_gui")]
    static extern int zan_gui_image_height(string path);

    [DllImport("zan_gui")]
    static extern void zan_gui_image_evict(string path);

    [DllImport("zan_gui")]
    static extern void zan_gui_blit_image(int surfaceId, string path,
        int dx, int dy, int dw, int dh,
        int sx, int sy, int sw, int sh);

    [DllImport("zan_gui")]
    static extern void zan_gui_push_clip(int surfaceId, int x, int y, int w, int h);

    [DllImport("zan_gui")]
    static extern void zan_gui_pop_clip(int surfaceId);

    [DllImport("zan_gui")]
    static extern void zan_gui_reset_clip(int surfaceId);

    int surfaceId;

    static Canvas Create(int width, int height) {
        Canvas c = new Canvas();
        c.surfaceId = zan_gui_create_surface(width, height);
        return c;
    }

    void Destroy() {
        zan_gui_destroy_surface(surfaceId);
    }

    int Width() { return zan_gui_surface_width(surfaceId); }
    int Height() { return zan_gui_surface_height(surfaceId); }
    string Pixels() { return zan_gui_get_pixels(surfaceId); }

    /// <summary>Clears the entire surface with a color (0xAARRGGBB).</summary>
    void Clear(int color) {
        zan_gui_clear(surfaceId, color);
    }

    /// <summary>Fills a rectangle.</summary>
    /// <summary>One rasterizer work counter: `kind` 0 = calls, 1 = touched
    /// pixels in thousands (reading kind 1 clears the counter). `idx` selects
    /// the primitive: 0 opaque fill, 1 blended fill, 2 gradient, 3 rounded
    /// rect, 4 radial, 5 blur computed, 6 blur cache hit, 7 image blit,
    /// 8 snapshot, 9 restore, 10 glyphs. Feeds App's frame profiler.</summary>
    static int RasterStat(int idx, int kind) {
        return zan_gui_stat_read(idx, kind);
    }

    /// The frame's widest translucent fills, ranked by area: `field` 0 = area in
    /// thousands of pixels, 1 = x, 2 = y, 3 = w, 4 = h (reading 4 clears the
    /// entry). Names the layers that dominate blending.
    static int RasterTopBlend(int rank, int field) {
        return zan_gui_stat_top(rank, field);
    }

    void FillRect(int x, int y, int w, int h, int color) {
        zan_gui_fill_rect(surfaceId, x, y, w, h, color);
    }

    /// <summary>Restricts subsequent drawing to the intersection of the current
    /// clip and (x,y,w,h). Nested pushes only shrink the region. Pair with
    /// PopClip. The clip resets to the full surface at the start of each frame
    /// (Clear), so containers never need to reset it manually.</summary>
    void PushClip(int x, int y, int w, int h) {
        zan_gui_push_clip(surfaceId, x, y, w, h);
    }

    /// <summary>Restores the clip region saved by the most recent PushClip.</summary>
    void PopClip() {
        zan_gui_pop_clip(surfaceId);
    }

    /// <summary>Drops all clip regions and draws to the whole surface again.</summary>
    void ResetClip() {
        zan_gui_reset_clip(surfaceId);
    }

    /// <summary>Draws a rectangle outline.</summary>
    void DrawRect(int x, int y, int w, int h, int color, int thickness) {
        zan_gui_draw_rect(surfaceId, x, y, w, h, color, thickness);
    }

    /// <summary>Fills a rounded rectangle.</summary>
    void FillRoundRect(int x, int y, int w, int h, int radius, int color) {
        zan_gui_fill_rounded_rect(surfaceId, x, y, w, h, radius, color);
    }

    /// <summary>Draws an anti-aliased rounded-rectangle outline whose corners
    /// hug a FillRoundRect of the same geometry (use this instead of DrawRect
    /// for bordered rounded surfaces).</summary>
    void DrawRoundRect(int x, int y, int w, int h, int radius, int color, int thickness) {
        zan_gui_draw_rounded_rect(surfaceId, x, y, w, h, radius, color, thickness);
    }

    /// <summary>Fills a rounded rectangle, rounding only the corners in
    /// `corners` (Corner.TL|TR|BR|BL, Corner.All for all four). Welded
    /// neighbours -- the buttons of a group, a tab against its panel -- square
    /// off their shared seam this way instead of leaving two rounded corners
    /// pinching together.</summary>
    void FillRoundRectIn(int x, int y, int w, int h, int radius, int corners, int color) {
        zan_gui_fill_rounded_rect_mask(surfaceId, x, y, w, h, radius, corners, color);
    }

    /// <summary>Strokes the outline of FillRoundRectIn's shape.</summary>
    void DrawRoundRectIn(int x, int y, int w, int h, int radius, int corners,
                         int color, int thickness) {
        zan_gui_draw_rounded_rect_mask(surfaceId, x, y, w, h, radius, corners, color, thickness);
    }

    /// <summary>Fills a rounded rectangle and strokes its outline in one call:
    /// a `FillRoundRect(fill)` immediately followed by a `DrawRoundRect(border)`
    /// of the same geometry. This is the common bordered-surface idiom shared by
    /// cards, popovers, tooltips and chips.</summary>
    void SurfaceRoundRect(int x, int y, int w, int h, int radius,
                          int fill, int border, int borderThickness) {
        zan_gui_fill_rounded_rect(surfaceId, x, y, w, h, radius, fill);
        zan_gui_draw_rounded_rect(surfaceId, x, y, w, h, radius, border, borderThickness);
    }

    /// <summary>Box-blurs a rectangular region in place (frosted-glass
    /// backdrop). Draw the backdrop first, blur, then overlay a translucent
    /// tint. `radius` is the blur strength (px, capped at 40).</summary>
    void BlurRect(int x, int y, int w, int h, int radius) {
        zan_gui_blur_rect(surfaceId, x, y, w, h, radius);
    }

    /// <summary>Same frosted-glass blur as BlurRect, but caches the blurred
    /// output in `slot`. When `dirty` is false and the region geometry is
    /// unchanged the cached pixels are restored with a plain copy instead of
    /// recomputing the (expensive) Gaussian blur -- so an on-screen animation
    /// (spinner, toast) no longer re-blurs a static backdrop every frame.
    /// Pass a stable slot per glass surface and dirty=true whenever the content
    /// behind the glass may have changed (input, scroll, resize, theme).</summary>
    void BlurRectCached(int x, int y, int w, int h, int radius,
                        int slot, bool dirty) {
        int d = 0;
        if (dirty) { d = 1; }
        zan_gui_blur_rect_cached(surfaceId, x, y, w, h, radius, slot, d);
    }

    /// <summary>Cached frosted-glass blur clipped to a rounded rect: the
    /// blurred output is written only inside the corner-radius mask so a glass
    /// panel's corners keep the sharp backdrop and line up with the translucent
    /// rounded tint drawn over them (a square blur under a rounded tint leaves
    /// blurred corners the tint can never repaint). `cornerMask` is a Corner
    /// bit set (Corner.All() for all four).</summary>
    void BlurRoundCached(int x, int y, int w, int h, int radius,
                         int slot, bool dirty, int cornerRadius, int cornerMask) {
        int d = 0;
        if (dirty) { d = 1; }
        zan_gui_blur_round_cached(surfaceId, x, y, w, h, radius, slot, d,
                                  cornerRadius, cornerMask);
    }

    /// <summary>Snapshots a region's pixels into `slot` so a later
    /// RestoreRect can repaint it without re-drawing. Used to cache a static
    /// backdrop (e.g. a wallpaper) so animation-only frames skip re-painting
    /// it.</summary>
    void SnapshotRect(int x, int y, int w, int h, int slot) {
        zan_gui_snapshot_rect(surfaceId, x, y, w, h, slot);
    }

    /// <summary>Restores a region previously captured by SnapshotRect.
    /// Returns true if the snapshot was present and its geometry matched (so
    /// the region is now painted); false if the caller must draw it
    /// normally.</summary>
    bool RestoreRect(int x, int y, int w, int h, int slot) {
        return zan_gui_restore_rect(surfaceId, x, y, w, h, slot) != 0;
    }

    /// <summary>Restores just the part of `slot` intersecting [x,y,w,h]; the
    /// rect need not match the snapshot's geometry, so many small damaged
    /// regions can be repaired without copying the whole snapshot back.
    /// Returns false when the slot holds no valid snapshot.</summary>
    bool RestoreSubRect(int x, int y, int w, int h, int slot) {
        return zan_gui_restore_sub_rect(surfaceId, x, y, w, h, slot) != 0;
    }

    /// <summary>Frees the pixel buffer a snapshot slot owns and invalidates it,
    /// handing the memory back instead of retaining it for the session. Use
    /// when a cached region scrolls out of view (e.g. a chart embedded in a
    /// grid cell). Safe to call on a free slot; no-op there.</summary>
    void ReleaseSlot(int slot) {
        zan_gui_surface_release(surfaceId, slot);
    }

    /// <summary>Fills a rectangle with a top-to-bottom linear gradient
    /// (0xAARRGGBB endpoints, opaque). Used for gradient wallpapers.</summary>
    void FillVGrad(int x, int y, int w, int h, int colorTop, int colorBottom) {
        zan_gui_fill_vgrad(surfaceId, x, y, w, h, colorTop, colorBottom);
    }

    /// <summary>Fills a circle.</summary>
    void FillCircle(int cx, int cy, int radius, int color) {
        zan_gui_fill_circle(surfaceId, cx, cy, radius, color);
    }

    /// <summary>Strokes a circle outline of the given thickness, centered on
    /// the radius (anti-aliased).</summary>
    void DrawCircle(int cx, int cy, int radius, int color, int thickness) {
        zan_gui_draw_circle(surfaceId, cx, cy, radius, color, thickness);
    }

    /// <summary>Fills a soft radial glow: alpha fades smoothly from innerAlpha
    /// (0..255) at the centre to 0 at radius, for luminous bloom. Only color's
    /// RGB is used.</summary>
    void FillRadial(int cx, int cy, int radius, int color, int innerAlpha) {
        zan_gui_fill_radial(surfaceId, cx, cy, radius, color, innerAlpha);
    }

    /// <summary>Draws a line.</summary>
    void DrawLine(int x0, int y0, int x1, int y1, int color, int thickness) {
        zan_gui_draw_line(surfaceId, x0, y0, x1, y1, color, thickness);
    }

    /// <summary>Fills a ring sector (pie/donut slice). Angles in degrees, 0 at
    /// 12 o'clock, clockwise. rInner=0 gives a solid pie slice.</summary>
    void FillSector(int cx, int cy, int rInner, int rOuter, int a0Deg, int a1Deg, int color) {
        zan_gui_fill_sector(surfaceId, cx, cy, rInner, rOuter, a0Deg, a1Deg, color);
    }

    /// <summary>Strokes a ring-sector arc (the outline of a pie/donut slice).
    /// Angles in degrees, 0 at 12 o'clock, clockwise. Drawn as a thin filled
    /// ring on the outer edge, so no separate native stroke primitive is
    /// needed; thickness is in device pixels.</summary>
    void DrawArc(int cx, int cy, int rInner, int rOuter, int a0Deg, int a1Deg, int color, int thickness) {
        if (thickness <= 0) { return; }
        int r0 = rInner;
        int r1 = rOuter;
        if (r1 < r0) { int tmp = r0; r0 = r1; r1 = tmp; }
        int s0 = r1 - thickness;
        if (s0 < r0) { s0 = r0; }
        zan_gui_fill_sector(surfaceId, cx, cy, s0, r1, a0Deg, a1Deg, color);
    }

    /// <summary>Draws text at the given position.</summary>
    void DrawText(int x, int y, string text, int color, int fontSize) {
        zan_gui_draw_text(surfaceId, x, y, text, color, fontSize);
    }

    /// <summary>Draws text centered within a rectangle.</summary>
    void DrawTextCentered(int rx, int ry, int rw, int rh, string text, int color, int fontSize) {
        int tw = zan_gui_measure_text(text, fontSize);
        int tx = rx + (rw - tw) / 2;
        int ty = Canvas.CenterTextY(ry, rh, fontSize);
        if (tx < rx) { tx = rx; }
        if (ty < ry) { ty = ry; }
        zan_gui_draw_text(surfaceId, tx, ty, text, color, fontSize);
    }

    /// <summary>Measures text width in pixels.</summary>
    static int MeasureText(string text, int fontSize) {
        return zan_gui_measure_text(text, fontSize);
    }

    /// <summary>Returns the font height in pixels.</summary>
    static int FontHeight(int fontSize) {
        return zan_gui_font_height(fontSize);
    }

    /// <summary>Blank rows the rasteriser leaves above the glyph ink inside
    /// FontHeight (the font's internal leading / line gap).
    ///
    /// Derived from the two metrics every backend already exports rather than
    /// from a metric call of its own: `fontSize` is the em size that was asked
    /// for and `FontHeight` is the line box the rasteriser reports for it, so
    /// the difference is exactly the leading it added. Keeping this in Zan also
    /// keeps the native ABI unchanged -- a new `zan_gui` export would not exist
    /// in the prebuilt per-platform drivers user projects link against.
    /// </summary>
    static int FontPadTop(int fontSize) {
        int pad = zan_gui_font_height(fontSize) - fontSize;
        if (pad < 0) { pad = 0; }
        return pad;
    }

    /// <summary>Top y that centres a line of text optically inside
    /// [rectY, rectY+rectH): the ink box is centred, not the full font box, so
    /// text does not sit low by half the font's internal leading. Every
    /// vertical text centring should go through this.</summary>
    static int CenterTextY(int rectY, int rectH, int fontSize) {
        return rectY
            + (rectH - zan_gui_font_height(fontSize)
               - Canvas.FontPadTop(fontSize)) / 2;
    }

    /// <summary>Draws an icon glyph (Unicode codepoint) inside a box, as
    /// vector primitives so it looks the same on every platform. See
    /// Gui.IconVector for the shapes.</summary>
    void DrawIcon(int x, int y, int box, int color, int codepoint) {
        IconVector.Draw(this, x, y, box, color, codepoint);
    }

    /// <summary>Draws text in the colour and size a resolved style carries,
    /// falling back to the caller's values for whatever the CSS leaves unset.
    /// Callers resolve the style themselves (Style.Of / Style.Part), so text
    /// painting needs no widget in between.</summary>
    void DrawStyledText(StyleBox s, int x, int y, string text,
                        int fallbackColor, int fallbackFont) {
        int fs = s.FontOr(fallbackFont);
        zan_gui_draw_text(surfaceId, x, y, text, s.FgOr(fallbackColor), fs);
    }

    /// <summary>Draws the icon `name` stands for (see Gui.Icon for the set) in
    /// a `size` box at (x,y). An unknown name draws nothing.</summary>
    void DrawGlyph(string name, int x, int y, int size, int color) {
        int cp = Icon.Codepoint(name);
        if (cp == 0) { return; }
        IconVector.Draw(this, x, y, size, color, cp);
    }

    /// <summary>Draws the icon `name` stands for centred in the rect, which is
    /// how an icon inside a control stays aligned whatever the control's
    /// height.</summary>
    void DrawGlyphIn(string name, int rx, int ry, int rw, int rh,
                     int size, int color) {
        int cp = Icon.Codepoint(name);
        if (cp == 0) { return; }
        IconVector.Draw(this, rx + (rw - size) / 2, ry + (rh - size) / 2,
                        size, color, cp);
    }

    /// <summary>Pixel width of an image file (PNG/BMP/JPG), decoding and
    /// caching it on first use. Returns 0 if the file cannot be loaded.</summary>
    static int ImageWidth(string path) {
        return zan_gui_image_width(path);
    }

    /// <summary>Pixel height of an image file. See ImageWidth.</summary>
    static int ImageHeight(string path) {
        return zan_gui_image_height(path);
    }

    /// <summary>Drops a cached decoded image so the next draw re-reads the
    /// file from disk (call after overwriting/replacing it on disk).</summary>
    static void EvictImage(string path) {
        zan_gui_image_evict(path);
    }

    /// <summary>Draws a rectangular region of an image file (decoded once and
    /// cached by path) onto the canvas, nearest-neighbour scaled to fit
    /// (dw,dh). Pass sw=0,sh=0 to use the whole image as the source.</summary>
    void BlitImage(string path, int dx, int dy, int dw, int dh,
                   int sx, int sy, int sw, int sh) {
        zan_gui_blit_image(surfaceId, path, dx, dy, dw, dh, sx, sy, sw, sh);
    }

    /// <summary>Draws the whole image file at (x,y) without scaling.</summary>
    void DrawImage(string path, int x, int y) {
        int w = Canvas.ImageWidth(path);
        int h = Canvas.ImageHeight(path);
        zan_gui_blit_image(surfaceId, path, x, y, w, h, 0, 0, 0, 0);
    }

    /// <summary>Draws a horizontal divider line.</summary>
    void DrawDivider(int x, int y, int width, int color) {
        zan_gui_fill_rect(surfaceId, x, y, width, 1, color);
    }

    /// <summary>Fills a rectangle with a Gui.Color object.</summary>
    void FillRectColor(int x, int y, int w, int h, Color col) {
        zan_gui_fill_rect(surfaceId, x, y, w, h, col.ToARGB());
    }

    /// <summary>Draws text with a Gui.Color object.</summary>
    void DrawTextColor(int x, int y, string text, Color col, int fontSize) {
        zan_gui_draw_text(surfaceId, x, y, text, col.ToARGB(), fontSize);
    }

    static int GetDpiScale() {
        #if WINDOWS
        return Win32Shell.DpiScale();
        #else
        return zan_gui_get_dpi_scale();
        #endif
    }
}
