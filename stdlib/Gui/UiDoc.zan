using System;
using System.Json;
using Gui.Widget;

namespace Gui;

/// JSON 定义的 UI 文档：把布局树解析为常驻 Controls，
/// 维护处理器名称注册表及（可选）绑定的状态模型，然后
/// 把每个 `on<Event>` 名称接到对应的 Action 并运行窗口。
///
///   UiDoc ui = UiDoc.FromJson(src);
///   ui.Handle("save", MyPage.Save);
///   ui.Bind(model);              // JSON 状态实体（可选）
///   ui.Run("Settings", 420, 380);
///
/// 结构键：`type`、`children`、`name`，以及布局提示 `gap`、`pad`、
/// `grow`、`visible`。其他非 `on*` 键通过控件的
/// SetProp 应用（控件属性集中在一处）。`on<Event>` 键存储处理器
/// 名称，Wire() 通过注册表解析并用 BindEvent 挂接。
class UiDoc {
    Control root;
    HandlerRegistry handlers;
    JsonValue model;
    StyleSheet sheet;

    UiDoc() {
        this.handlers = new HandlerRegistry();
    }

    /// 解析 JSON UI 文档并构建常驻控件树。
    static UiDoc FromJson(string src) {
        UiDoc d = new UiDoc();
        JsonValue tree = JsonValue.ParseLenient(src);
        d.root = UiDoc.BuildWith(tree, null);
        return d;
    }

    /// 解析 JSON UI 文档及类 CSS 样式表，将样式表的
    /// 声明级联到构建出的每个节点上。
    static UiDoc FromJsonStyled(string src, string styleSrc) {
        UiDoc d = new UiDoc();
        d.sheet = StyleSheet.FromJson(styleSrc);
        JsonValue tree = JsonValue.ParseLenient(src);
        d.root = UiDoc.BuildWith(tree, d.sheet);
        return d;
    }

    Control Root() { return root; }

    /// 为文档引用的处理器名称注册 Action。
    UiDoc Handle(string name, Action a) {
        handlers.Set(name, a);
        return this;
    }

    /// 挂接 JSON 状态实体，供 `bind` 路径双向绑定。
    UiDoc Bind(JsonValue m) {
        model = m;
        return this;
    }

    // ---- 树的构建 --------------------------------------------------

    /// 从 JSON 对象节点构建控件（及其子树）。
    static Control Build(JsonValue node) {
        return UiDoc.BuildWith(node, null);
    }

    /// 构建控件（及其子树），把 `sheet` 级联到每个节点，
    /// 再应用内联属性，保证内联值始终优先。
    static Control BuildWith(JsonValue node, StyleSheet sheet) {
        if (node == null || !node.IsObject()) { return null; }
        string type = node.Str("kind", "");
        if (type == "") { type = UiDoc.LegacyKind(node.Str("type", "")); }
        if (type == "") { return null; }
        Control c = UiDoc.Make(type, node);
        if (c == null) { return null; }

        if (node.Has("class")) { c.Class = node.Str("class", ""); }
        // 先做样式表级联；下方的内联属性覆盖之。
        if (sheet != null) {
            sheet.Apply(c, type, c.Class, node.Str("name", ""));
        }

        // 文档里的尺寸是逻辑像素（按 100% 书写）：一并记录下来，
        // 测量时按当前 DPI 换算（见 Control.ApplyDeclaredUnits）。
        if (node.Has("gap")) {
            c.gap = node.Int("gap", 0);
            c.logGap = c.gap;
        }
        if (node.Has("pad")) {
            c.Pad(node.Int("pad", 0));
            c.logPad = node.Int("pad", 0);
        }
        if (node.Has("padding")) {
            c.Pad(node.Int("padding", 0));
            c.logPad = node.Int("padding", 0);
        }
        if (node.Has("dock")) {
            JsonValue dv = node.Get("dock");
            if (dv.IsNumber()) {
                c.dock = dv.AsInt(0);
            } else {
                c.dock = UiDoc.DockValue(dv.AsString(""));
            }
        }
        if (node.Has("x")) {
            c.mx = node.Int("x", 0);
            c.logX = c.mx;
            c.logPlaceSet = true;
        }
        if (node.Has("y")) {
            c.my = node.Int("y", 0);
            c.logY = c.my;
            c.logPlaceSet = true;
        }
        if (node.Has("width")) {
            c.prefW = node.Int("width", c.prefW);
            c.logW = c.prefW;
            c.prefSet = true;
        }
        if (node.Has("height")) {
            c.prefH = node.Int("height", c.prefH);
            c.logH = c.prefH;
            c.prefSet = true;
        }
        if (node.Has("grow") && node.Bool("grow", false)) { c.Grow(); }
        if (node.Has("visible")) { c.visible = node.Bool("visible", true); }
        if (node.Has("bind")) {
            JsonValue bv = node.Get("bind");
            if (bv != null && bv.IsObject()) {
                c.bindPath = bv.Str("path", "");
                c.bindProp = bv.Str("prop", "");
            } else {
                c.bindPath = node.Str("bind", "");
            }
        }
        if (node.Has("bindProp")) { c.bindProp = node.Str("bindProp", ""); }

        // 剩余键：`on<Event>` 处理器名称与控件属性（SetProp）之分。
        List<string> events = c.Events();
        for (int i = 0; i < node.Count(); i = i + 1) {
            string k = node.KeyAt(i);
            JsonValue v = node.ValAt(i);
            if (!UiDoc.IsReserved(k)) {
                string ename = UiDoc.HandlerEvent(k, events);
                if (ename != "") {
                    c.SetHandler(ename, v.AsString(""));
                } else {
                    c.SetProp(k, UiDoc.Scalar(v));
                }
            }
        }

        // `name` 放最后：多个控件的 SetProp("text") 也会赋值 `name`，
        // 显式 id 必须优先于由文本派生的 id。
        if (node.Has("name")) { c.name = node.Str("name", c.name); }

        if (c.bindPath != "" && c.bindProp == "") {
            c.bindProp = UiDoc.DefaultBindProp(c);
        }

        if (node.Has("children")) {
            JsonValue kids = node.Get("children");
            if (kids != null && kids.IsArray()) {
                for (int j = 0; j < kids.Count(); j = j + 1) {
                    Control child = UiDoc.BuildWith(kids.At(j), sheet);
                    if (child != null) { c.Add(child); }
                }
            }
        }
        return c;
    }

    static string LegacyKind(string type) {
        if (type == "Text" || type == "H1" || type == "Title") { return "Label"; }
        if (type == "TextBox") { return "Input"; }
        if (type == "Select" || type == "Dropdown") { return "SelectBox"; }
        if (type == "Card" || type == "Column" || type == "Row") { return "Panel"; }
        return type;
    }

    /// 为 `kind` 标签实例化具体控件，填入构造函数所需
    /// 的属性（text/value）。未知类型交给项目注册表；
    /// 注册表未声明时返回 null，避免改变文档语义。
    static Control Make(string type, JsonValue node) {
        if (type == "ScrollColumn") { return new ScrollColumn(); }
        if (type == "Panel") { return new Panel(); }
        if (type == "Label") {
            return new Label(node.Str("text", ""));
        }
        if (type == "Button") { return new Button(node.Str("text", "Button")); }
        if (type == "Input") {
            return new Input(node.Str("hint", ""));
        }
        if (type == "Switch") { return new Switch(); }
        if (type == "Checkbox") {
            return new Checkbox(node.Str("label", node.Str("text", "")));
        }
        if (type == "Radio") {
            return new Radio(new SignalInt(0),
                             node.Int("option", 0),
                             node.Str("label", node.Str("text", "")));
        }
        if (type == "Slider") {
            return new Slider(node.Int("min", 0),
                              node.Int("max", 100),
                              new SignalInt(node.Int("value", 0)));
        }
        if (type == "SelectBox") {
            List<string> opts = new List<string>();
            JsonValue arr = node.Get("options");
            if (arr != null && arr.IsArray()) {
                for (int oi = 0; oi < arr.Count(); oi = oi + 1) {
                    opts.Add(arr.At(oi).AsString(""));
                }
            }
            return SelectBox.FromOptions(opts, node.Str("hint", ""));
        }
        if (type == "Progress") { return new Progress(node.Int("value", 0), 1); }
        if (type == "Divider") { return new Divider(node.Str("text", "")); }
        // Dynamic project components use the same string-kind registry as
        // FormBuilder. Unknown kinds remain invalid instead of becoming Panel.
        return ProjectComponents.Create(type);
    }

    /// 由 Build 显式处理的结构键（不转发给 SetProp）。
    static bool IsReserved(string k) {
        return k == "type" || k == "children" || k == "name"
            || k == "gap" || k == "pad" || k == "padding"
            || k == "dock" || k == "grow" || k == "visible"
            || k == "bind" || k == "bindProp" || k == "class" || k == "options"
            || k == "x" || k == "y" || k == "width" || k == "height";
    }

    static int DockValue(string text) {
        if (text == "top" || text == "Top") { return Dock.Top(); }
        if (text == "bottom" || text == "Bottom") { return Dock.Bottom(); }
        if (text == "left" || text == "Left") { return Dock.Left(); }
        if (text == "right" || text == "Right") { return Dock.Right(); }
        if (text == "fill" || text == "Fill") { return Dock.Fill(); }
        return Dock.Manual();
    }

    /// 若 `k` 是 `on<Event>` 键且其事件为该控件声明过的，
    /// 则返回事件名（如“onClick” -> “Click”）；否则返回“”。用
    /// 控件自身的 Events() 判断，这样“options”之类的属性
    /// 不会被误认为处理器，也无需大小写辅助函数。
    static string HandlerEvent(string k, List<string> events) {
        if (k.Length < 3) { return ""; }
        if (k.Substring(0, 2) != "on") { return ""; }
        string ename = k.Substring(2, k.Length - 2);
        if (events.Contains(ename)) { return ename; }
        return "";
    }

    /// 把标量 JSON 值渲染为 SetProp 期望的文本。
    static string Scalar(JsonValue v) {
        if (v.IsString()) { return v.AsString(""); }
        if (v.IsNumber()) { return v.AsString(""); }
        if (v.IsBool()) { if (v.AsBool(false)) { return "true"; } return "false"; }
        return "";
    }

    // ---- 处理器接线 -----------------------------------------------------

    /// 把存储的每个 `on<Event>` 处理器名称解析为已注册的 Action
    /// 并订阅到控件事件。遍历整棵树。
    void Wire() {
        if (root != null) { WireNode(root); }
    }

    void WireNode(Control c) {
        for (int i = 0; i < c.events.Count; i = i + 1) {
            string evt = c.events[i].key;
            string hname = c.events[i].val;
            if (hname != "" && handlers.Has(hname)) {
                Action a = handlers.Get(hname);
                c.BindEvent(evt, a);
            }
        }
        for (int j = 0; j < c.children.Count; j = j + 1) {
            WireNode(c.children[j]);
        }
    }

    // ---- 运行 ----------------------------------------------------------------

    /// 接好处理器，然后打开窗口并驱动常驻帧循环，
    /// 让文档树填满内容区域。
    /// 把绑定的状态实体值推入每个声明了
    /// `bind` 路径的控件（state -> UI）。不通过 SetProp 暴露
    /// “value”/“text”的控件会忽略写入，因此对所有控件类型都安全。
    void SyncFromModel() {
        if (model == null || root == null) { return; }
        SyncFromNode(root);
    }

    /// 控件发布了名为 `key` 的可编辑属性时为 true
    /// （通过其 Props() 列表）。用于把绑定的标量路由到控件的
    /// 标准属性，而不是盲目同时写入“value”和“text”。
    static bool HasProp(Control c, string key) {
        List<PropSpec> ps = c.Props();
        for (int i = 0; i < ps.Count; i = i + 1) {
            if (ps[i].key == key) { return true; }
        }
        return false;
    }

    static string DefaultBindProp(Control c) {
        if (UiDoc.HasProp(c, "value")) { return "value"; }
        if (UiDoc.HasProp(c, "text")) { return "text"; }
        return "";
    }

    void SyncFromNode(Control c) {
        if (c.bindPath != "") {
            JsonValue v = model.PathGet(c.bindPath);
            if (v != null) {
                string s = v.AsString("");
                if (c.bindProp != "") {
                    if (c.GetProp(c.bindProp) != s) {
                        c.SetProp(c.bindProp, s);
                    }
                } else {
                    c.SetProp("value", s);
                }
            }
            c.bindSnapshot = BoundValue(c);
        }
        for (int j = 0; j < c.children.Count; j = j + 1) {
            SyncFromNode(c.children[j]);
        }
    }

    /// 把每个绑定控件的当前值读回状态实体
    /// （UI -> state），使 `ToJson()`/保存能反映编辑结果。
    void SyncToModel() {
        if (model == null || root == null) { return; }
        SyncToNode(root);
    }

    string BoundValue(Control c) {
        if (c.bindProp != "") { return c.GetProp(c.bindProp); }
        if (UiDoc.HasProp(c, "value")) { return c.GetProp("value"); }
        if (UiDoc.HasProp(c, "text")) { return c.GetProp("text"); }
        string s = c.GetProp("value");
        if (s == "") { s = c.GetProp("text"); }
        return s;
    }

    void SyncChangedNode(Control c) {
        if (c.bindPath != "") {
            string s = BoundValue(c);
            if (s != c.bindSnapshot) { WriteBoundValue(c, s); }
        }
        for (int i = 0; i < c.children.Count; i = i + 1) {
            SyncChangedNode(c.children[i]);
        }
    }

    void WriteBoundValue(Control c, string s) {
        JsonValue cur = model.PathGet(c.bindPath);
        if (cur != null && cur.IsBool()) {
            model.PathSetValue(c.bindPath, JsonValue.NewBool(s == "true"));
        } else if (cur != null && cur.IsNumber()) {
            model.PathSetValue(c.bindPath, JsonValue.NewNum(s));
        } else {
            model.PathSet(c.bindPath, s);
        }
    }

    void SyncToNode(Control c) {
        if (c.bindPath != "") {
            string s = BoundValue(c);
            // 回写时保留叶子节点原有的 JSON 类型：bool 仍是 bool、数字仍是数字，
            // 而不会全部
            // 退化成字符串。当路径为新建/无类型时，
            // 回退为字符串叶子。
            WriteBoundValue(c, s);
        }
        for (int j = 0; j < c.children.Count; j = j + 1) {
            SyncToNode(c.children[j]);
        }
    }

    /// 把文档渲染到某帧的任意子矩形中——宿主
    /// （如 IDE）已开始该帧，而不是用 Run() 接管整个
    /// 窗口。每帧在 App.BeginFrame() 之后调用一次：它先推送
    /// state -> UI，在 (x,y,w,h) 布置并绘制树（控件在绘制时自行处理
    /// 输入），再收集 UI -> state。处理器需在开始前
    /// 用 Wire() 一次性接好。
    void RenderInto(App app, int x, int y, int w, int h) {
        if (root == null) { return; }
        SyncFromModel();
        root.MeasureTree(app);
        root.Arrange(x, y, w, h);
        root.RenderTree(app);
        SyncChangedNode(root);
    }

    void Run(string title, int w, int h) {
        Wire();
        SyncFromModel();
        Form f = new Form(title, w, h);
        if (root != null) {
            root.dock = 5;
            f.Add(root);
        }

        // 在这里驱动常驻循环，绑定才能在两个方向上保持活跃，
        // 而不是启动时只拷贝一次状态。
        App app = f.GetApp();
        app.Show();
        while (app.isRunning) {
            if (!app.ProcessEvent()) { break; }
            if (!app.needsRedraw) { continue; }
            app.BeginFrame();
            SyncFromModel();
            f.RenderFrame(app);
            if (model != null && root != null) { SyncChangedNode(root); }
            app.RenderChrome(title);
            app.PresentFrame();
        }
    }
}
