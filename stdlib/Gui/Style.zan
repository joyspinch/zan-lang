using System;
using System.Json;

namespace Gui;

/// <summary>
/// The style resolver: turns (control type, classes, state) into one resolved
/// StyleBox by layering the active theme's defaults, the active skin's
/// stylesheet and the control's own inline style, then cross-fading between
/// states so `transition` works.
///
/// This is what makes a widget skinnable without carrying per-skin drawing
/// code. A widget's whole visual layer becomes:
///
///     int st = Style.StateOf(app, id, disabled);
///     StyleBox s = Style.Eased(app, id, "button", "primary", disabled);
///     s.Paint(app, x, y, w, h);
///     s.DrawLabel(app, x, y, w, h, label);
///
/// Selectors follow CSS: `button`, `.primary`, `button.primary`, `#save` and
/// their `:hover / :active / :focus / :disabled / :checked / :selected` state
/// variants, resolved in ascending specificity (type, class, type.class, id).
/// The theme tokens provide the defaults, so a skin only declares what differs
/// and an app with no skin.css looks exactly like the built-in theme.
/// </summary>
class Style {
    // ---- interaction state bits --------------------------------------------

    static int SNormal()   { return 0; }
    static int SHover()    { return 1; }
    static int SActive()   { return 2; }
    static int SFocus()    { return 4; }
    static int SDisabled() { return 8; }
    static int SSelected() { return 16; }
    static int SChecked()  { return 32; }

    // ---- animation kinds (CSS `animation: <name> ...`) ---------------------

    static int AnimNone()    { return 0; }
    static int AnimSpin()    { return 1; }
    static int AnimPulse()   { return 2; }
    static int AnimBreath()  { return 3; }
    static int AnimShimmer() { return 4; }
    static int AnimFloat()   { return 5; }
    static int AnimGlow()    { return 6; }
    static int AnimAurora()  { return 7; }
    static int AnimMotes()   { return 8; }

    /// Maps a CSS animation name onto an Anim* kind (0 when unknown).
    static int AnimKind(string name) {
        if (name == "spin") { return Style.AnimSpin(); }
        if (name == "pulse") { return Style.AnimPulse(); }
        if (name == "breath") { return Style.AnimBreath(); }
        if (name == "shimmer") { return Style.AnimShimmer(); }
        if (name == "float") { return Style.AnimFloat(); }
        if (name == "glow") { return Style.AnimGlow(); }
        if (name == "aurora") { return Style.AnimAurora(); }
        if (name == "motes") { return Style.AnimMotes(); }
        return 0;
    }

    /// The CSS pseudo-class name for one state bit ("" for the base state).
    static string StateName(int bit) {
        if (bit == Style.SHover()) { return "hover"; }
        if (bit == Style.SActive()) { return "active"; }
        if (bit == Style.SFocus()) { return "focus"; }
        if (bit == Style.SDisabled()) { return "disabled"; }
        if (bit == Style.SSelected()) { return "selected"; }
        if (bit == Style.SChecked()) { return "checked"; }
        return "";
    }

    /// Live interaction state of widget `id` as a state-bit mask.
    static int StateOf(App app, int id, bool disabled) {
        if (disabled) { return Style.SDisabled(); }
        int st = 0;
        if (app.focus.IsHovered(id)) { st = st + Style.SHover(); }
        if (app.focus.IsPressed(id) && app.focus.IsHovered(id)) {
            st = st + Style.SActive();
        }
        if (app.focus.IsFocused(id)) { st = st + Style.SFocus(); }
        return st;
    }

    // ---- resolution cache --------------------------------------------------
    // Resolving walks the sheet's selector table, so the result is memoized per
    // (type, class, state) and dropped whenever the theme/skin generation
    // changes. Widgets resolve every frame; this keeps that free.

    static List<string> cacheKeys;
    static List<StyleBox> cacheVals;
    static int cacheGen;

    static void CacheReset(int gen) {
        Style.cacheKeys = new List<string>();
        Style.cacheVals = new List<StyleBox>();
        Style.cacheGen = gen;
    }

    static StyleBox CacheGet(App app, string key) {
        int gen = app.bgThemeGen;
        if (Style.cacheKeys == null || Style.cacheGen != gen) {
            Style.CacheReset(gen);
            return null;
        }
        int i = 0;
        while (i < Style.cacheKeys.Count) {
            if (Style.cacheKeys[i] == key) { return Style.cacheVals[i]; }
            i = i + 1;
        }
        return null;
    }

    static void CachePut(string key, StyleBox box) {
        if (Style.cacheKeys == null) { return; }
        if (Style.cacheKeys.Count >= 512) {
            Style.CacheReset(Style.cacheGen);
        }
        Style.cacheKeys.Add(key);
        Style.cacheVals.Add(box);
    }

    // ---- resolution --------------------------------------------------------

    /// Resolves the style of `type`.`cls` in `state` (theme defaults + skin).
    static StyleBox Of(App app, string type, string cls, int state) {
        return Style.Full(app, type, cls, "", state);
    }

    /// Resolution including an id selector (`#name`), the most specific level.
    static StyleBox Full(App app, string type, string cls, string id, int state) {
        string key = type + "|" + cls + "|" + id + "|" + Convert.ToString(state);
        StyleBox hit = Style.CacheGet(app, key);
        if (hit != null) { return hit.Clone(); }

        StyleBox b = StyleBox.Create();
        Style.Defaults(app, b, type, cls, state);
        StyleSheet sheet = app.sheet;
        if (sheet != null) {
            Style.ApplySheet(sheet, b, type, cls, id, state);
        }
        Style.CachePut(key, b);
        return b.Clone();
    }

    static StyleBox Part(App app, string type, string part, string fallbackType,
                         string cls, string id, int state) {
        string key = type + "::" + part + "|" + fallbackType + "|" + cls
            + "|" + id + "|" + Convert.ToString(state);
        StyleBox hit = Style.CacheGet(app, key);
        if (hit != null) { return hit.Clone(); }

        StyleBox b = StyleBox.Create();
        if (fallbackType != "") {
            Style.Defaults(app, b, fallbackType, cls, state);
        }
        StyleSheet sheet = app.sheet;
        if (sheet != null) {
            if (fallbackType != "") {
                Style.ApplySheet(sheet, b, fallbackType, cls, "", state);
            }
            Style.ApplyPartSheet(sheet, b, type, part, cls, id, state);
        }
        Style.CachePut(key, b);
        return b.Clone();
    }

    /// Layers the sheet's matching rules onto `b` in ascending specificity:
    /// type, each class, type.class, id — first for the base look, then once per
    /// active state bit so `:hover` only names what changes.
    static void ApplySheet(StyleSheet sheet, StyleBox b, string type, string cls,
                           string id, int state) {
        Style.ApplyLevel(sheet, b, type, cls, id, "");
        int bit = 1;
        while (bit <= Style.SChecked()) {
            if ((state / bit) % 2 == 1) {
                string st = Style.StateName(bit);
                if (st != "") { Style.ApplyLevel(sheet, b, type, cls, id, st); }
            }
            bit = bit * 2;
        }
    }

    static void ApplyLevel(StyleSheet sheet, StyleBox b, string type, string cls,
                           string id, string state) {
        string suffix = "";
        if (state != "") { suffix = ":" + state; }
        if (type != "") { sheet.ApplyBox(b, type + suffix); }
        List<string> classes = Style.Classes(cls);
        int i = 0;
        while (i < classes.Count) {
            string c = classes[i];
            if (c != "") {
                sheet.ApplyBox(b, "." + c + suffix);
                if (type != "") { sheet.ApplyBox(b, type + "." + c + suffix); }
            }
            i = i + 1;
        }
        if (id != "") { sheet.ApplyBox(b, "#" + id + suffix); }
    }

    static void ApplyPartSheet(StyleSheet sheet, StyleBox b, string type,
                               string part, string cls, string id, int state) {
        Style.ApplyPartLevel(sheet, b, type, part, cls, id, "");
        int bit = 1;
        while (bit <= Style.SChecked()) {
            if ((state / bit) % 2 == 1) {
                string st = Style.StateName(bit);
                if (st != "") {
                    Style.ApplyPartLevel(sheet, b, type, part, cls, id, st);
                }
            }
            bit = bit * 2;
        }
    }

    static void ApplyPartLevel(StyleSheet sheet, StyleBox b, string type,
                               string part, string cls, string id, string state) {
        string suffix = "::" + part;
        if (state != "") { suffix = suffix + ":" + state; }
        sheet.ApplyBox(b, suffix);
        if (type != "") { sheet.ApplyBox(b, type + suffix); }
        List<string> classes = Style.Classes(cls);
        int i = 0;
        while (i < classes.Count) {
            string c = classes[i];
            if (c != "") {
                sheet.ApplyBox(b, "." + c + suffix);
                if (type != "") {
                    sheet.ApplyBox(b, type + "." + c + suffix);
                }
            }
            i = i + 1;
        }
        if (id != "") { sheet.ApplyBox(b, "#" + id + suffix); }
    }

    /// Splits a space-separated class list ("primary ghost" -> [primary, ghost]).
    static List<string> Classes(string cls) {
        List<string> outp = new List<string>();
        if (cls == "") { return outp; }
        List<string> parts = cls.Split(" ");
        int i = 0;
        while (i < parts.Count) {
            string p = parts[i];
            if (p != "") { outp.Add(p); }
            i = i + 1;
        }
        return outp;
    }

    /// True when `cls` contains the given class token.
    static bool Has(string cls, string name) {
        List<string> parts = Style.Classes(cls);
        int i = 0;
        while (i < parts.Count) {
            if (parts[i] == name) { return true; }
            i = i + 1;
        }
        return false;
    }

    // ---- eased (transitioned) resolution -----------------------------------

    /// Resolves the style of a widget and cross-fades it between its base,
    /// hover and pressed looks using the eased interaction levels — the generic
    /// replacement for every widget's hand-written hover/press color lerping.
    /// A focused widget layers its `:focus` rules on top (also eased), and a
    /// disabled widget short-circuits to its `:disabled` look.
    static StyleBox Eased(App app, int id, string type, string cls, bool disabled) {
        return Style.EasedId(app, id, type, cls, "", disabled, false);
    }

    /// Eased resolution with an id selector and an explicit selected/checked
    /// flag (tabs, list rows, toggles: selection is a latched state, not an
    /// interaction, so it is layered before the hover/press fades).
    static StyleBox EasedId(App app, int id, string type, string cls, string name,
                            bool disabled, bool selected) {
        int latched = 0;
        if (selected) { latched = Style.SSelected(); }
        return Style.EasedStateId(app, id, type, cls, name, disabled, latched);
    }

    static StyleBox EasedStateId(App app, int id, string type, string cls,
                                 string name, bool disabled, int latched) {
        if (disabled) {
            return Style.Full(app, type, cls, name, Style.SDisabled() + latched);
        }
        StyleBox base0 = Style.Full(app, type, cls, name, latched);
        int ms = base0.TransitionOr(0 - 1);
        int hv = Ui.HoverLevelMs(app, id, ms);
        int pv = Ui.PressLevelMs(app, id, ms);
        int fv = Ui.FocusLevelMs(app, id, ms);
        StyleBox cur = base0;
        if (hv > 0) {
            StyleBox hover = Style.Full(app, type, cls, name, latched + Style.SHover());
            cur = StyleBox.Blend(cur, hover, Style.Curve(base0.easing, hv));
        }
        if (pv > 0) {
            StyleBox act = Style.Full(app, type, cls, name,
                                      latched + Style.SHover() + Style.SActive());
            cur = StyleBox.Blend(cur, act, Style.Curve(base0.easing, pv));
        }
        if (fv > 0) {
            StyleBox foc = Style.Full(app, type, cls, name, latched + Style.SFocus());
            cur = StyleBox.Blend(cur, foc, Style.Curve(base0.easing, fv));
        }
        return cur;
    }

    static StyleBox EasedPartId(App app, int id, string type, string part,
                                string fallbackType, string cls, string name,
                                bool disabled, bool selected) {
        int latched = 0;
        if (selected) { latched = Style.SSelected(); }
        return Style.EasedPartStateId(app, id, type, part, fallbackType, cls,
                                      name, disabled, latched);
    }

    static StyleBox EasedPartStateId(App app, int id, string type, string part,
                                     string fallbackType, string cls, string name,
                                     bool disabled, int latched) {
        if (disabled) {
            return Style.Part(app, type, part, fallbackType, cls, name,
                              Style.SDisabled() + latched);
        }
        StyleBox base0 = Style.Part(app, type, part, fallbackType, cls, name, latched);
        int ms = base0.TransitionOr(0 - 1);
        int hv = Ui.HoverLevelMs(app, id, ms);
        int pv = Ui.PressLevelMs(app, id, ms);
        int fv = Ui.FocusLevelMs(app, id, ms);
        StyleBox cur = base0;
        if (hv > 0) {
            StyleBox hover = Style.Part(app, type, part, fallbackType, cls, name,
                                        latched + Style.SHover());
            cur = StyleBox.Blend(cur, hover, Style.Curve(base0.easing, hv));
        }
        if (pv > 0) {
            StyleBox act = Style.Part(app, type, part, fallbackType, cls, name,
                                      latched + Style.SHover() + Style.SActive());
            cur = StyleBox.Blend(cur, act, Style.Curve(base0.easing, pv));
        }
        if (fv > 0) {
            StyleBox foc = Style.Part(app, type, part, fallbackType, cls, name,
                                      latched + Style.SFocus());
            cur = StyleBox.Blend(cur, foc, Style.Curve(base0.easing, fv));
        }
        return cur;
    }

    /// Applies a CSS timing function to a linear 0..1000 progress.
    static int Curve(int easing, int p) {
        if (easing == 1) { return p; }
        if (easing == 2) { return p * p / 1000; }
        if (easing == 3) {
            int q = 1000 - p;
            return 1000 - q * q / 1000;
        }
        return App.Ease(p);
    }

    // ---- theme defaults ----------------------------------------------------

    /// The role accent for a class list ("primary"/"info"/"success"/"warning"/
    /// "error"), or 0 when the control is neutral.
    static int RoleColor(Theme t, string cls, int state) {
        bool hover = (state / Style.SHover()) % 2 == 1;
        bool active = (state / Style.SActive()) % 2 == 1;
        if (Style.Has(cls, "primary")) {
            if (active) { return t.primaryPressed; }
            if (hover) { return t.primaryHover; }
            return t.primary;
        }
        if (Style.Has(cls, "info")) {
            if (active) { return t.infoPressed; }
            if (hover) { return t.infoHover; }
            return t.info;
        }
        if (Style.Has(cls, "success")) {
            if (active) { return t.successPressed; }
            if (hover) { return t.successHover; }
            return t.success;
        }
        if (Style.Has(cls, "warning")) {
            if (active) { return t.warningPressed; }
            if (hover) { return t.warningHover; }
            return t.warning;
        }
        if (Style.Has(cls, "error")) {
            if (active) { return t.errorPressed; }
            if (hover) { return t.errorPressed; }
            return t.error;
        }
        return 0;
    }

    /// The role's resting accent (unaffected by state) — used for ghost/text
    /// variants whose *label* carries the role color.
    static int RoleBase(Theme t, string cls) {
        return Style.RoleColor(t, cls, 0);
    }

    /// Fills `b` with the active theme's defaults for a control family, so a
    /// skin's CSS only has to declare what it wants to change and a themed app
    /// with no CSS at all keeps its exact built-in look.
    static void Defaults(App app, StyleBox b, string type, string cls, int state) {
        Theme t = app.theme;
        bool hover = (state / Style.SHover()) % 2 == 1;
        bool active = (state / Style.SActive()) % 2 == 1;
        bool focus = (state / Style.SFocus()) % 2 == 1;
        bool disabled = (state / Style.SDisabled()) % 2 == 1;
        bool selected = (state / Style.SSelected()) % 2 == 1;
        if ((state / Style.SChecked()) % 2 == 1) { selected = true; }

        // Metrics a widget derives from its own size scale (height, font size,
        // horizontal padding) are deliberately left unset here: the widget
        // passes them as the fallback (`s.HeightOr(myHeight)`), so CSS wins when
        // it declares one and the size scale still applies when it does not.
        b.transitionMs = t.animFastMs;
        b.fg = t.textPrimary;
        b.accent = t.primary;

        if (type == "button") {
            Style.ButtonDefaults(app, b, cls, hover, active, focus, disabled);
        } else if (type == "input" || type == "textarea" || type == "select") {
            Style.FieldDefaults(app, b, cls, hover, active, focus, disabled);
        } else if (type == "card" || type == "panel" || type == "popup"
                   || type == "dialog") {
            Style.SurfaceDefaults(app, b, cls);
        } else if (type == "tab") {
            Style.TabDefaults(app, b, cls, hover, selected, disabled);
        } else if (type == "tabs") {
            if (Style.Has(cls, "segment")) {
                b.bg = t.bgTertiary;
                b.SetRadius(t.borderRadiusMedium);
            } else {
                b.bg = 0;
                b.borderBottomW = 1;
                b.borderBottomColor = t.divider;
            }
        } else if (type == "option" || type == "item" || type == "row") {
            Style.ItemDefaults(app, b, cls, hover, active, selected, disabled);
        } else if (type == "checkbox" || type == "radio" || type == "switch"
                   || type == "slider" || type == "progress") {
            b.bg = 0;
            b.borderW = 0;
            b.shadow = 0;
        } else if (type == "label" || type == "text") {
            b.bg = 0;
            b.fg = t.textPrimary;
        } else {
            Style.SurfaceDefaults(app, b, cls);
        }

        if (disabled) { b.fg = t.textDisabled; }
        // Skin shells that apply to every control: neo-brutalism casts a hard
        // offset shadow and presses into it; glass skins frost their surfaces.
        bool internalParts = type == "checkbox" || type == "radio" || type == "switch"
            || type == "slider" || type == "progress";
        if (t.brutal == 1 && type != "label" && type != "text" && !internalParts) {
            b.shadow = t.shadowColor;
            b.shadowDx = 4;
            b.shadowDy = 4;
            b.shadowBlur = 0;
            b.borderColor = t.borderPrimary;
            b.borderW = t.borderWidth;
            if (active) { b.shadow = 0; b.tx = 4; b.ty = 4; }
        }
    }

    static void ButtonDefaults(App app, StyleBox b, string cls, bool hover,
                               bool active, bool focus, bool disabled) {
        Theme t = app.theme;
        int role = Style.RoleColor(t, cls, Style.MaskOf(hover, active));
        int roleBase = Style.RoleBase(t, cls);
        b.SetRadius(t.borderRadiusMedium);
        b.gap = t.gapSmall;
        b.align = 1;

        if (disabled) {
            // Keep a clearly visible muted shape on any theme: fill with the
            // (opaque) border grey and derive readable text from it.
            b.bg = t.borderPrimary;
            b.fg = App.LerpColor(t.borderPrimary, t.textPrimary, 110);
            b.borderColor = App.LerpColor(t.borderPrimary, t.textPrimary, 45);
            b.borderW = 1;
            return;
        }

        if (Style.Has(cls, "ghost")) {
            b.bg = 0;
            b.fg = roleBase;
            if (roleBase == 0) { b.fg = t.textPrimary; }
            b.borderColor = b.fg;
            b.borderW = 1;
            if (hover) { b.bg = App.ScaleAlpha(b.fg, 120); }
            if (active) { b.bg = App.ScaleAlpha(b.fg, 215); }
            return;
        }
        if (Style.Has(cls, "secondary")) {
            int mix = 90;
            if (hover) { mix = 150; }
            if (active) { mix = 200; }
            int tint = roleBase;
            if (tint == 0) { tint = t.textPrimary; }
            b.bg = App.LerpColor(t.bgPrimary, tint, mix);
            b.fg = tint;
            b.borderW = 0;
            return;
        }
        if (Style.Has(cls, "text")) {
            b.bg = 0;
            b.borderW = 0;
            b.fg = roleBase;
            if (roleBase == 0) { b.fg = t.textPrimary; }
            if (hover) { b.bg = t.bgHover; }
            if (active) { b.bg = t.bgActive; }
            return;
        }
        if (Style.Has(cls, "outline") || Style.Has(cls, "dashed")) {
            b.bg = t.bgPrimary;
            if (hover) { b.bg = t.bgHover; }
            if (active) { b.bg = t.bgActive; }
            b.fg = roleBase;
            if (roleBase == 0) { b.fg = t.textPrimary; }
            b.borderColor = b.fg;
            b.borderW = 1;
            return;
        }

        if (role != 0) {
            b.bg = role;
            b.fg = t.textInverse;
            b.borderColor = role;
            b.borderW = 0;
            return;
        }
        // Neutral (default) button: page surface with a border.
        b.bg = t.bgPrimary;
        if (hover) { b.bg = t.bgHover; }
        if (active) { b.bg = t.bgActive; }
        b.fg = t.textPrimary;
        b.borderColor = t.borderPrimary;
        if (hover || active) { b.borderColor = t.borderHover; }
        if (focus) { b.borderColor = t.borderFocus; }
        b.borderW = 1;
    }

    static void FieldDefaults(App app, StyleBox b, string cls, bool hover,
                              bool active, bool focus, bool disabled) {
        Theme t = app.theme;
        b.bg = t.bgPrimary;
        b.fg = t.textPrimary;
        b.SetRadius(t.borderRadiusMedium);
        b.borderColor = t.borderPrimary;
        b.borderW = 1;
        b.accent = t.primary;
        if (hover) { b.borderColor = t.borderHover; }
        if (focus) { b.borderColor = t.borderFocus; }
        if (disabled) {
            b.bg = t.bgDisabled;
            b.fg = t.textDisabled;
            b.borderColor = t.borderSecondary;
        }
        if (t.glass != 0) { b.bg = App.ScaleAlpha(t.bgPrimary, 700); }
    }

    static void SurfaceDefaults(App app, StyleBox b, string cls) {
        Theme t = app.theme;
        b.bg = t.bgPrimary;
        b.fg = t.textPrimary;
        b.SetRadius(t.borderRadiusMedium);
        b.borderColor = t.borderSecondary;
        b.borderW = 1;
        b.shadow = t.shadowColor;
        b.shadowDx = 1;
        b.shadowDy = 2;
        b.padL = t.paddingLarge;
        b.padT = t.paddingLarge;
        b.padR = t.paddingLarge;
        b.padB = t.paddingLarge;
        if (t.glass != 0) {
            // Frosted skins: blur the backdrop and lay a translucent tint over
            // it instead of an opaque fill.
            b.blur = 36;
            b.bg = App.ScaleAlpha(t.bgPrimary, 260);
            b.borderColor = App.ScaleAlpha(t.textPrimary, 110);
        }
    }

    static void TabDefaults(App app, StyleBox b, string cls, bool hover,
                            bool selected, bool disabled) {
        Theme t = app.theme;
        b.bg = 0;
        b.fg = t.textSecondary;
        b.align = 1;
        b.SetRadius(0);
        if (Style.Has(cls, "card")) {
            b.bg = t.bgSecondary;
            b.SetRadius(t.borderRadiusMedium);
        } else if (Style.Has(cls, "segment")) {
            b.SetRadius(t.borderRadiusSmall);
        } else if (Style.Has(cls, "document")) {
            // Editor document tab: an opaque strip tab, active one lifted to
            // the page background so it reads as the front sheet.
            b.bg = t.bgSecondary;
        }
        if (hover && !selected) {
            b.bg = t.bgHover;
            b.fg = t.textPrimary;
        }
        if (selected) {
            b.fg = t.primary;
            if (Style.Has(cls, "card")) {
                b.bg = t.bgPrimary;
                b.borderColor = t.borderPrimary;
                b.borderW = 1;
            } else if (Style.Has(cls, "segment")) {
                b.bg = t.bgPrimary;
                b.fg = t.textPrimary;
            } else if (Style.Has(cls, "document")) {
                b.bg = t.bgPrimary;
                b.fg = t.textPrimary;
            } else {
                b.borderBottomW = 2;
                b.borderBottomColor = t.primary;
            }
        }
        if (disabled) { b.fg = t.textDisabled; }
    }

    static void ItemDefaults(App app, StyleBox b, string cls, bool hover,
                             bool active, bool selected, bool disabled) {
        Theme t = app.theme;
        b.bg = 0;
        b.fg = t.textPrimary;
        b.SetRadius(t.borderRadiusSmall);
        b.align = 0;
        if (hover) { b.bg = t.bgHover; }
        if (active) { b.bg = t.bgActive; }
        if (selected) {
            b.bg = t.bgActive;
            b.fg = t.primary;
        }
        if (disabled) { b.fg = t.textDisabled; }
    }

    static int MaskOf(bool hover, bool active) {
        int m = 0;
        if (hover) { m = m + Style.SHover(); }
        if (active) { m = m + Style.SActive(); }
        return m;
    }

    // ---- inline (fluent / retained-mode) overrides --------------------------

    /// Layers a control's own inline style (Control.Bg/Radius/Border/... or the
    /// CSS applied by UiDoc) over a resolved box, so retained-mode controls and
    /// immediate-mode widgets share one resolution path.
    static void Inline(StyleBox b, Control c) {
        if (c == null) { return; }
        if (c.styleBg != 0) { b.bg = c.styleBg; b.bgTo = c.styleBgTo; }
        if (c.styleRadius != 0) { b.SetRadius(c.styleRadius); }
        if (c.styleBorderColor != 0) { b.borderColor = c.styleBorderColor; }
        if (c.styleBorderWidth != 0) { b.borderW = c.styleBorderWidth; }
        if (c.styleShadow != 0) {
            b.shadow = c.styleShadow;
            b.shadowDy = c.styleShadowDy;
        }
        if (c.styleColor != 0) { b.fg = c.styleColor; }
        if (c.styleFontPx != 0) { b.fontPx = c.styleFontPx; }
        if (c.styleTransitionMs != 0) { b.transitionMs = c.styleTransitionMs; }
    }
}
