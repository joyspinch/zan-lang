using System;
using System.Json;

namespace Gui;

/// <summary>
/// The style resolver: turns (control type, classes, state) into one resolved
/// StyleBox by layering the active theme's defaults, the active skin's
/// stylesheet and the control's own inline style, then cross-fading between
/// states so `transition` works.
///
/// This is what makes a widget skinnable without carrying per-skin drawing
/// code. A widget's whole visual layer becomes:
///
///     int st = Style.StateOf(app, id, disabled);
///     StyleBox s = Style.Eased(app, id, "button", "primary", disabled);
///     s.Paint(app, x, y, w, h);
///     s.DrawLabel(app, x, y, w, h, label);
///
/// Selectors follow CSS: `button`, `.primary`, `button.primary`, `#save` and
/// their `:hover / :active / :focus / :disabled / :checked / :selected` state
/// variants, resolved in ascending specificity (type, class, type.class, id).
/// The theme tokens provide the defaults, so a skin only declares what differs
/// and an app with no skin.css looks exactly like the built-in theme.
/// </summary>
class Style {
    // ---- interaction state bits --------------------------------------------

    static int SNormal()   { return 0; }
    static int SHover()    { return 1; }
    static int SActive()   { return 2; }
    static int SFocus()    { return 4; }
    static int SDisabled() { return 8; }
    static int SSelected() { return 16; }
    static int SChecked()  { return 32; }

    // ---- animation kinds (CSS `animation: <name> ...`) ---------------------

    static int AnimNone()    { return 0; }
    static int AnimSpin()    { return 1; }
    static int AnimPulse()   { return 2; }
    static int AnimBreath()  { return 3; }
    static int AnimShimmer() { return 4; }
    static int AnimFloat()   { return 5; }
    static int AnimGlow()    { return 6; }
    static int AnimAurora()  { return 7; }
    static int AnimMotes()   { return 8; }

    /// Maps a CSS animation name onto an Anim* kind (0 when unknown).
    static int AnimKind(string name) {
        if (name == "spin") { return Style.AnimSpin(); }
        if (name == "pulse") { return Style.AnimPulse(); }
        if (name == "breath") { return Style.AnimBreath(); }
        if (name == "shimmer") { return Style.AnimShimmer(); }
        if (name == "float") { return Style.AnimFloat(); }
        if (name == "glow") { return Style.AnimGlow(); }
        if (name == "aurora") { return Style.AnimAurora(); }
        if (name == "motes") { return Style.AnimMotes(); }
        return 0;
    }

    /// The CSS pseudo-class name for one state bit ("" for the base state).
    static string StateName(int bit) {
        if (bit == Style.SHover()) { return "hover"; }
        if (bit == Style.SActive()) { return "active"; }
        if (bit == Style.SFocus()) { return "focus"; }
        if (bit == Style.SDisabled()) { return "disabled"; }
        if (bit == Style.SSelected()) { return "selected"; }
        if (bit == Style.SChecked()) { return "checked"; }
        return "";
    }

    /// The state bit a CSS pseudo-class name stands for (0 when it names none).
    static int StateBit(string name) {
        if (name == "hover") { return Style.SHover(); }
        if (name == "active") { return Style.SActive(); }
        if (name == "focus" || name == "focus-visible") { return Style.SFocus(); }
        if (name == "disabled") { return Style.SDisabled(); }
        if (name == "selected") { return Style.SSelected(); }
        if (name == "checked") { return Style.SChecked(); }
        return 0;
    }

    /// Live interaction state of widget `id` as a state-bit mask.
    static int StateOf(App app, int id, bool disabled) {
        if (disabled) { return Style.SDisabled(); }
        int st = 0;
        if (app.focus.IsHovered(id)) { st = st + Style.SHover(); }
        if (app.focus.IsPressed(id) && app.focus.IsHovered(id)) {
            st = st + Style.SActive();
        }
        if (app.focus.IsFocused(id)) { st = st + Style.SFocus(); }
        return st;
    }

    // ---- resolution cache --------------------------------------------------
    // Resolving walks the sheet's selector table, so the result is memoized per
    // (type, class, state) and dropped whenever the theme/skin generation
    // changes. Widgets resolve every frame; this keeps that free.

    static List<string> cacheKeys;
    static List<StyleBox> cacheVals;
    static int cacheGen;

    static void CacheReset(int gen) {
        Style.cacheKeys = new List<string>();
        Style.cacheVals = new List<StyleBox>();
        Style.cacheGen = gen;
    }

    static StyleBox CacheGet(App app, string key) {
        int gen = app.bgThemeGen;
        if (Style.cacheKeys == null || Style.cacheGen != gen) {
            Style.CacheReset(gen);
            return null;
        }
        int i = 0;
        while (i < Style.cacheKeys.Count) {
            if (Style.cacheKeys[i] == key) { return Style.cacheVals[i]; }
            i = i + 1;
        }
        return null;
    }

    static void CachePut(string key, StyleBox box) {
        if (Style.cacheKeys == null) { return; }
        if (Style.cacheKeys.Count >= 512) {
            Style.CacheReset(Style.cacheGen);
        }
        Style.cacheKeys.Add(key);
        Style.cacheVals.Add(box);
    }

    // ---- resolution --------------------------------------------------------

    /// Resolves the style of `type`.`cls` in `state` (theme defaults + skin).
    static StyleBox Of(App app, string type, string cls, int state) {
        return Style.Full(app, type, cls, "", state);
    }

    /// Resolution including an id selector (`#name`), the most specific level.
    static StyleBox Full(App app, string type, string cls, string id, int state) {
        string key = type + "|" + cls + "|" + id + "|" + Convert.ToString(state)
            + "@" + Convert.ToString(app.dpiScale);
        StyleBox hit = Style.CacheGet(app, key);
        if (hit != null) { return hit.Clone(); }

        StyleBox b = StyleBox.Create();
        Style.Defaults(app, b, type, cls, state);
        StyleSheet basef = Style.BaseSheet(app);
        if (basef != null) { Style.ApplySheet(basef, b, type, cls, id, state); }
        StyleSheet sheet = app.sheet;
        if (sheet != null) {
            Style.ApplySheet(sheet, b, type, cls, id, state);
        }
        Style.Shell(app, b, type, cls, state);
        Style.ScaleLayout(app, b);
        Style.CachePut(key, b);
        return b.Clone();
    }

    static StyleBox Part(App app, string type, string part, string fallbackType,
                         string cls, string id, int state) {
        string key = type + "::" + part + "|" + fallbackType + "|" + cls
            + "|" + id + "|" + Convert.ToString(state);
        StyleBox hit = Style.CacheGet(app, key);
        if (hit != null) { return hit.Clone(); }

        StyleBox b = StyleBox.Create();
        if (fallbackType != "") {
            Style.Defaults(app, b, fallbackType, cls, state);
        }
        StyleSheet basef = Style.BaseSheet(app);
        if (basef != null && fallbackType != "") {
            Style.ApplySheet(basef, b, fallbackType, cls, "", state);
        }
        StyleSheet sheet = app.sheet;
        if (sheet != null) {
            if (fallbackType != "") {
                Style.ApplySheet(sheet, b, fallbackType, cls, "", state);
            }
            Style.ApplyPartSheet(sheet, b, type, part, cls, id, state);
        }
        if (fallbackType != "") { Style.Shell(app, b, fallbackType, cls, state); }
        Style.CachePut(key, b);
        return b.Clone();
    }

    /// Scales the stylesheet's layout lengths (box sizes and margins) to the
    /// display: CSS is authored at 100%, the theme's own metrics are already
    /// DPI-scaled, so a sheet's `width: 260px` must follow the same factor to
    /// stay the same physical size. Percentages need no scaling.
    static void ScaleLayout(App app, StyleBox b) {
        if (app.dpiScale == 100) { return; }
        if (b.width >= 0) { b.width = app.Scale(b.width); }
        if (b.height >= 0) { b.height = app.Scale(b.height); }
        if (b.minW >= 0) { b.minW = app.Scale(b.minW); }
        if (b.minH >= 0) { b.minH = app.Scale(b.minH); }
        if (b.maxW >= 0) { b.maxW = app.Scale(b.maxW); }
        if (b.maxH >= 0) { b.maxH = app.Scale(b.maxH); }
        if (b.gap >= 0) { b.gap = app.Scale(b.gap); }
        b.marL = app.Scale(b.marL);
        b.marT = app.Scale(b.marT);
        b.marR = app.Scale(b.marR);
        b.marB = app.Scale(b.marB);
        if (b.padL >= 0) { b.padL = app.Scale(b.padL); }
        if (b.padT >= 0) { b.padT = app.Scale(b.padT); }
        if (b.padR >= 0) { b.padR = app.Scale(b.padR); }
        if (b.padB >= 0) { b.padB = app.Scale(b.padB); }
    }

    /// Layers every rule of the sheet that selects this control onto `b`,
    /// weakest first (see StyleSheet.ApplyMatch).
    static void ApplySheet(StyleSheet sheet, StyleBox b, string type, string cls,
                           string id, int state) {
        sheet.ApplyMatch(b, type, cls, id, "", state);
    }

    /// The same for one `type::part` of a control (`menu::item`, `card::title`).
    static void ApplyPartSheet(StyleSheet sheet, StyleBox b, string type,
                               string part, string cls, string id, int state) {
        sheet.ApplyMatch(b, type, cls, id, part, state);
    }

    /// Splits a space-separated class list ("primary ghost" -> [primary, ghost]).
    static List<string> Classes(string cls) {
        List<string> outp = new List<string>();
        if (cls == "") { return outp; }
        List<string> parts = cls.Split(" ");
        int i = 0;
        while (i < parts.Count) {
            string p = parts[i];
            if (p != "") { outp.Add(p); }
            i = i + 1;
        }
        return outp;
    }

    /// True when `cls` contains the given class token.
    static bool Has(string cls, string name) {
        List<string> parts = Style.Classes(cls);
        int i = 0;
        while (i < parts.Count) {
            if (parts[i] == name) { return true; }
            i = i + 1;
        }
        return false;
    }

    // ---- eased (transitioned) resolution -----------------------------------

    /// Resolves the style of a widget and cross-fades it between its base,
    /// hover and pressed looks using the eased interaction levels — the generic
    /// replacement for every widget's hand-written hover/press color lerping.
    /// A focused widget layers its `:focus` rules on top (also eased), and a
    /// disabled widget short-circuits to its `:disabled` look.
    static StyleBox Eased(App app, int id, string type, string cls, bool disabled) {
        return Style.EasedId(app, id, type, cls, "", disabled, false);
    }

    /// Eased resolution with an id selector and an explicit selected/checked
    /// flag (tabs, list rows, toggles: selection is a latched state, not an
    /// interaction, so it is layered before the hover/press fades).
    static StyleBox EasedId(App app, int id, string type, string cls, string name,
                            bool disabled, bool selected) {
        int latched = 0;
        if (selected) { latched = Style.SSelected(); }
        return Style.EasedStateId(app, id, type, cls, name, disabled, latched);
    }

    static StyleBox EasedStateId(App app, int id, string type, string cls,
                                 string name, bool disabled, int latched) {
        if (disabled) {
            return Style.Full(app, type, cls, name, Style.SDisabled() + latched);
        }
        StyleBox base0 = Style.Full(app, type, cls, name, latched);
        base0.fxId = id;
        int ms = base0.TransitionOr(0 - 1);
        int hv = Ui.HoverLevelMs(app, id, ms);
        int pv = Ui.PressLevelMs(app, id, ms);
        int fv = Ui.FocusLevelMs(app, id, ms);
        StyleBox cur = base0;
        if (hv > 0) {
            StyleBox hover = Style.Full(app, type, cls, name, latched + Style.SHover());
            cur = StyleBox.Blend(cur, hover, Style.Curve(base0.easing, hv));
        }
        if (pv > 0) {
            StyleBox act = Style.Full(app, type, cls, name,
                                      latched + Style.SHover() + Style.SActive());
            cur = StyleBox.Blend(cur, act, Style.Curve(base0.easing, pv));
        }
        if (fv > 0) {
            StyleBox foc = Style.Full(app, type, cls, name, latched + Style.SFocus());
            cur = StyleBox.Blend(cur, foc, Style.Curve(base0.easing, fv));
        }
        cur.fxId = id;
        return cur;
    }

    static StyleBox EasedPartId(App app, int id, string type, string part,
                                string fallbackType, string cls, string name,
                                bool disabled, bool selected) {
        int latched = 0;
        if (selected) { latched = Style.SSelected(); }
        return Style.EasedPartStateId(app, id, type, part, fallbackType, cls,
                                      name, disabled, latched);
    }

    static StyleBox EasedPartStateId(App app, int id, string type, string part,
                                     string fallbackType, string cls, string name,
                                     bool disabled, int latched) {
        if (disabled) {
            return Style.Part(app, type, part, fallbackType, cls, name,
                              Style.SDisabled() + latched);
        }
        StyleBox base0 = Style.Part(app, type, part, fallbackType, cls, name, latched);
        int ms = base0.TransitionOr(0 - 1);
        int hv = Ui.HoverLevelMs(app, id, ms);
        int pv = Ui.PressLevelMs(app, id, ms);
        int fv = Ui.FocusLevelMs(app, id, ms);
        StyleBox cur = base0;
        if (hv > 0) {
            StyleBox hover = Style.Part(app, type, part, fallbackType, cls, name,
                                        latched + Style.SHover());
            cur = StyleBox.Blend(cur, hover, Style.Curve(base0.easing, hv));
        }
        if (pv > 0) {
            StyleBox act = Style.Part(app, type, part, fallbackType, cls, name,
                                      latched + Style.SHover() + Style.SActive());
            cur = StyleBox.Blend(cur, act, Style.Curve(base0.easing, pv));
        }
        if (fv > 0) {
            StyleBox foc = Style.Part(app, type, part, fallbackType, cls, name,
                                      latched + Style.SFocus());
            cur = StyleBox.Blend(cur, foc, Style.Curve(base0.easing, fv));
        }
        return cur;
    }

    /// Applies a CSS timing function to a linear 0..1000 progress.
    static int Curve(int easing, int p) {
        if (easing == 1) { return p; }
        if (easing == 2) { return p * p / 1000; }
        if (easing == 3) {
            int q = 1000 - p;
            return 1000 - q * q / 1000;
        }
        return App.Ease(p);
    }

    // ---- theme defaults ----------------------------------------------------

    /// The role accent for a class list ("primary"/"info"/"success"/"warning"/
    /// "error"), or 0 when the control is neutral.
    static int RoleColor(Theme t, string cls, int state) {
        bool hover = (state / Style.SHover()) % 2 == 1;
        bool active = (state / Style.SActive()) % 2 == 1;
        if (Style.Has(cls, "primary")) {
            if (active) { return t.primaryPressed; }
            if (hover) { return t.primaryHover; }
            return t.primary;
        }
        if (Style.Has(cls, "info")) {
            if (active) { return t.infoPressed; }
            if (hover) { return t.infoHover; }
            return t.info;
        }
        if (Style.Has(cls, "success")) {
            if (active) { return t.successPressed; }
            if (hover) { return t.successHover; }
            return t.success;
        }
        if (Style.Has(cls, "warning")) {
            if (active) { return t.warningPressed; }
            if (hover) { return t.warningHover; }
            return t.warning;
        }
        if (Style.Has(cls, "error")) {
            if (active) { return t.errorPressed; }
            if (hover) { return t.errorPressed; }
            return t.error;
        }
        return 0;
    }

    /// The role's resting accent (unaffected by state) — used for ghost/text
    /// variants whose *label* carries the role color.
    static int RoleBase(Theme t, string cls) {
        return Style.RoleColor(t, cls, 0);
    }

    /// Fills `b` with the active theme's defaults for a control family, so a
    /// skin's CSS only has to declare what it wants to change and a themed app
    /// with no CSS at all keeps its exact built-in look.
    static void Defaults(App app, StyleBox b, string type, string cls, int state) {
        Theme t = app.theme;
        bool hover = (state / Style.SHover()) % 2 == 1;
        bool active = (state / Style.SActive()) % 2 == 1;
        bool focus = (state / Style.SFocus()) % 2 == 1;
        bool disabled = (state / Style.SDisabled()) % 2 == 1;
        bool selected = (state / Style.SSelected()) % 2 == 1;
        if ((state / Style.SChecked()) % 2 == 1) { selected = true; }

        // Metrics a widget derives from its own size scale (height, font size,
        // horizontal padding) are deliberately left unset here: the widget
        // passes them as the fallback (`s.HeightOr(myHeight)`), so CSS wins when
        // it declares one and the size scale still applies when it does not.
        b.transitionMs = t.animFastMs;
        b.fg = t.textPrimary;
        b.accent = t.primary;

        if (type == "button" || type == "floatbutton") {
            Style.ButtonDefaults(app, b, cls, hover, active, focus, disabled,
                                 selected);
        } else if (type == "tab") {
            Style.TabDefaults(app, b, cls, hover, selected, disabled);
        } else if (Style.CssType(type)) {
            // Every other family is styled entirely by skins/base.css, layered
            // on top as the base floor sheet (see Style.BaseSheet). Nothing to
            // do here but the shared baseline set above.
        } else {
            // An unknown control type still gets the neutral surface look.
            Style.SurfaceDefaults(app, b, cls);
        }
    }

    /// True for the control families whose whole look now lives in
    /// skins/base.css (loaded as the base floor sheet). Buttons and individual
    /// tabs are the exceptions: their colours are computed at runtime.
    static bool CssType(string type) {
        return type == "input" || type == "textarea" || type == "select"
            || type == "card" || type == "panel" || type == "popup"
            || type == "dialog" || type == "contextmenu" || type == "prompt"
            || type == "tooltip" || type == "tabs" || type == "option"
            || type == "item" || type == "row" || type == "checkbox"
            || type == "radio" || type == "switch" || type == "slider"
            || type == "progress" || type == "tag" || type == "badge"
            || type == "avatar" || type == "label" || type == "text"
            || type == "statistic" || type == "empty" || type == "result"
            || type == "spin" || type == "timeline" || type == "steps"
            || type == "breadcrumb" || type == "pageheader"
            || type == "skeleton" || type == "ribbon" || type == "divider"
            || type == "stack" || type == "list" || type == "buttonbar"
            || type == "buttongroup"
            || type == "page" || type == "startpage" || type == "pagination"
            || type == "carousel" || type == "collapse" || type == "codeblock"
            || type == "tabview" || type == "menu" || type == "wizard";
    }

    /// Runtime treatments that no static CSS rule can express, applied after
    /// the sheets: a disabled control's muted text, glass frosting and the
    /// neo-brutalist offset-shadow shell (all gated on theme flags/state).
    static void Shell(App app, StyleBox b, string type, string cls, int state) {
        Theme t = app.theme;
        bool active = (state / Style.SActive()) % 2 == 1;
        bool disabled = (state / Style.SDisabled()) % 2 == 1;
        if (disabled) { b.fg = t.textDisabled; }
        if (t.glass != 0) {
            if (type == "input" || type == "textarea" || type == "select") {
                b.bg = App.ScaleAlpha(t.bgPrimary, 700);
            } else if (type == "card" || type == "panel" || type == "popup"
                       || type == "dialog") {
                b.blur = 36;
                b.bg = App.ScaleAlpha(t.bgPrimary, 260);
                b.borderW = 0;
            }
        }
        bool internalParts = type == "checkbox" || type == "radio" || type == "switch"
            || type == "slider" || type == "progress";
        if (t.brutal == 1 && !Style.FlatType(type) && !internalParts) {
            b.shadow = t.shadowColor;
            b.shadowDx = 4;
            b.shadowDy = 4;
            b.shadowBlur = 0;
            b.borderColor = t.borderPrimary;
            b.borderW = t.borderWidth;
            if (active) { b.shadow = 0; b.tx = 4; b.ty = 4; }
        }
    }

    // ---- base floor sheet --------------------------------------------------
    // The built-in component baseline (skins/base.css) parsed with the active
    // theme's tokens injected as :root, so its var() rules resolve to the live
    // palette. It is layered under the app's own sheet on every resolution and
    // cached per theme generation (rebuilt whenever the theme/skin changes).

    static StyleSheet baseSheet;
    static int baseSheetGen;

    static StyleSheet BaseSheet(App app) {
        int gen = app.bgThemeGen;
        if (Style.baseSheet != null && Style.baseSheetGen == gen) {
            return Style.baseSheet;
        }
        string css = Skin.BaseCss();
        if (css == "") {
            Style.baseSheet = StyleSheet.Create();
        } else {
            Style.baseSheet = StyleSheet.FromCss(
                Style.RootFromTheme(app.theme) + "\n" + css);
        }
        Style.baseSheetGen = gen;
        return Style.baseSheet;
    }

    /// The active theme's palette as a `:root` block, so base.css's var(--token)
    /// rules resolve to the live (possibly skin-overridden) colours. Values are
    /// emitted as plain decimals -- exactly what ParseColor stores -- so the CSS
    /// path reproduces the old code path's colours bit for bit.
    static string RootFromTheme(Theme t) {
        string s = ":root {\n";
        s = s + Style.Tok("primary", t.primary);
        s = s + Style.Tok("info", t.info);
        s = s + Style.Tok("success", t.success);
        s = s + Style.Tok("warning", t.warning);
        s = s + Style.Tok("error", t.error);
        s = s + Style.Tok("text-primary", t.textPrimary);
        s = s + Style.Tok("text-secondary", t.textSecondary);
        s = s + Style.Tok("text-tertiary", t.textTertiary);
        s = s + Style.Tok("text-disabled", t.textDisabled);
        s = s + Style.Tok("text-inverse", t.textInverse);
        s = s + Style.Tok("bg-primary", t.bgPrimary);
        s = s + Style.Tok("bg-secondary", t.bgSecondary);
        s = s + Style.Tok("bg-tertiary", t.bgTertiary);
        s = s + Style.Tok("bg-hover", t.bgHover);
        s = s + Style.Tok("bg-active", t.bgActive);
        s = s + Style.Tok("bg-disabled", t.bgDisabled);
        s = s + Style.Tok("border-primary", t.borderPrimary);
        s = s + Style.Tok("border-secondary", t.borderSecondary);
        s = s + Style.Tok("border-hover", t.borderHover);
        s = s + Style.Tok("border-focus", t.borderFocus);
        s = s + Style.Tok("divider", t.divider);
        s = s + Style.Tok("shadow-color", t.shadowColor);
        s = s + Style.Tok("tooltip-bg", t.tooltipBg);
        s = s + Style.Tok("tooltip-border", t.tooltipBorder);
        s = s + Style.Tok("tooltip-text", t.tooltipText);
        s = s + "}\n";
        return s;
    }

    static string Tok(string name, int v) {
        return "  --" + name + ": #" + Style.Hex8(v) + ";\n";
    }

    /// A 32-bit colour as 8 hex digits (#AARRGGBB), extracted two's-complement
    /// nibble by nibble so it round-trips through StyleSheet.HexToInt back to
    /// the exact same signed int -- independent of the `%` sign convention.
    static string Hex8(int v) {
        int x = v;
        string outp = "";
        int i = 0;
        while (i < 8) {
            int nib = x % 16;
            if (nib < 0) { nib = nib + 16; }
            outp = Style.HexDigit(nib) + outp;
            x = (x - nib) / 16;
            i = i + 1;
        }
        return outp;
    }

    static string HexDigit(int n) {
        if (n == 10) { return "A"; }
        if (n == 11) { return "B"; }
        if (n == 12) { return "C"; }
        if (n == 13) { return "D"; }
        if (n == 14) { return "E"; }
        if (n == 15) { return "F"; }
        return Convert.ToString(n);
    }

    /// True for types that paint text or marks straight into the area they are
    /// given and own no surface, so a skin's global border-and-shadow shell must
    /// not draw a box around them.
    static bool FlatType(string type) {
        return type == "ribbon" || type == "label" || type == "text"
            || type == "empty"
            || type == "result" || type == "spin" || type == "timeline"
            || type == "steps" || type == "breadcrumb" || type == "pageheader";
    }

    /// The size scale a `tiny` / `small` / `medium` / `large` class stands for,
    /// applied to height, font size and horizontal padding. Every sized widget
    /// (button, tag, ...) shares it, so `button.large` and `tag.large` mean the
    /// same step, and a skin can still override any of the three.
    static void SizeDefaults(App app, StyleBox b, string cls) {
        Theme t = app.theme;
        if (Style.Has(cls, "tiny")) {
            b.height = t.heightTiny; b.fontPx = t.fontSizeTiny;
            b.padL = t.paddingSmall; b.padR = t.paddingSmall;
        } else if (Style.Has(cls, "small")) {
            b.height = t.heightSmall; b.fontPx = t.fontSizeSmall;
            b.padL = t.paddingMedium; b.padR = t.paddingMedium;
        } else if (Style.Has(cls, "large")) {
            b.height = t.heightLarge; b.fontPx = t.fontSizeLarge;
            b.padL = t.paddingLarge + t.gapSmall;
            b.padR = t.paddingLarge + t.gapSmall;
        } else if (Style.Has(cls, "medium")) {
            b.height = t.heightMedium; b.fontPx = t.fontSizeMedium;
            b.padL = t.paddingLarge; b.padR = t.paddingLarge;
        }
        // No size class: nothing is set, so every reader falls back to the
        // medium theme metric it passes to HeightOr/FontOr/PadLOr.
    }

    // ---- design-system class names -----------------------------------------
    // The names below are the design system's vocabulary: a widget only ever
    // hands a class list to the resolver, and a skin restyles any of them in
    // CSS. The int forms exist for data-driven callers (a designer document, a
    // scene file) that store a variant as a number.

    /// Semantic type: 1 primary, 2 info, 3 success, 4 warning, 5 error.
    static string TypeClass(int type) {
        switch (type) {
            case 1: return "primary";
            case 2: return "info";
            case 3: return "success";
            case 4: return "warning";
            case 5: return "error";
            default: return "";
        }
    }

    /// The role class a list already carries ("primary" … "error"), or "" when
    /// it is neutral. Widgets that pick a glyph or a part style per role read
    /// this instead of testing every role name themselves.
    static string RoleClass(string cls) {
        int i = 1;
        while (i <= 5) {
            string role = Style.TypeClass(i);
            if (Style.Has(cls, role)) { return role; }
            i = i + 1;
        }
        return "";
    }

    /// Fill treatment: 1 outline, 2 text, 3 dashed (0 = solid, no class).
    static string FillClass(int fill) {
        switch (fill) {
            case 1: return "outline";
            case 2: return "text";
            case 3: return "dashed";
            default: return "";
        }
    }

    /// Size: 0 tiny, 1 small, 2 medium, 3 large.
    static string SizeClass(int size) {
        switch (size) {
            case 0: return "tiny";
            case 1: return "small";
            case 3: return "large";
            default: return "medium";
        }
    }

    /// Where an item sits in a sequence: `done` behind the current one,
    /// `active` on it, `pending` ahead of it, `error` when it failed. Shared by
    /// every sequence display (a step indicator, a timeline, a wizard rail) so
    /// one skin rule styles the same state everywhere.
    static string StateClass(int index, int current, int errorIndex) {
        if (index == errorIndex) { return "error"; }
        if (index < current) { return "done"; }
        if (index == current) { return "active"; }
        return "pending";
    }

    /// Scales the alpha of an opaque packed colour to `a` permille (0..1000),
    /// so anything can fade in and out by drawing through this.
    static int Fade(int color, int a) {
        if (a >= 1000) { return color; }
        if (a < 0) { a = 0; }
        int rgb = color % 16777216;
        if (rgb < 0) { rgb = rgb + 16777216; }
        return (255 * a / 1000) * 16777216 + rgb;
    }

    // ---- semantic type colours ---------------------------------------------
    // For widgets that paint button-typed surfaces without a StyleBox of their
    // own (button groups, ribbons, toolbars), which is why they take an int.

    /// Accent colour of a button type (default falls back to the primary text
    /// colour so tinted/ghost/text styles still read).
    static int TypeColor(Theme t, int type) {
        if (type == 1) { return t.primary; }
        if (type == 2) { return t.info; }
        if (type == 3) { return t.success; }
        if (type == 4) { return t.warning; }
        if (type == 5) { return t.error; }
        return t.textPrimary;
    }

    /// Background of a button-typed surface for the given interaction state.
    /// `style` 0 = solid, 1 = outline.
    static int TypeFill(Theme t, int type, int style, bool hovered, bool pressed) {
        int tc = Style.TypeColor(t, type);
        if (style == 1) {
            if (pressed) { return App.LerpColor(t.bgPrimary, tc, 55); }
            if (hovered) { return App.LerpColor(t.bgPrimary, tc, 28); }
            return t.bgPrimary;
        }
        if (type == 0) {
            if (pressed) { return t.bgActive; }
            if (hovered) { return t.bgHover; }
            return t.bgPrimary;
        }
        if (pressed) { return App.LerpColor(tc, 4278190080, 150); }
        if (hovered) { return App.LerpColor(tc, 4294967295, 150); }
        return tc;
    }

    /// Foreground (label) colour matching TypeFill.
    static int TypeFg(Theme t, int type, int style) {
        if (style == 1 || type == 0) {
            if (type == 0) { return t.textPrimary; }
            return Style.TypeColor(t, type);
        }
        return t.textInverse;
    }

    static void ButtonDefaults(App app, StyleBox b, string cls, bool hover,
                               bool active, bool focus, bool disabled,
                               bool selected) {
        Theme t = app.theme;
        int role = Style.RoleColor(t, cls, Style.MaskOf(hover, active));
        int roleBase = Style.RoleBase(t, cls);
        b.SetRadius(t.borderRadiusMedium);
        b.gap = t.gapSmall;
        b.align = 1;
        Style.SizeDefaults(app, b, cls);
        // A stacked command (icon over label) is measured from its content, so
        // it drops the size scale's fixed height and its wide side padding.
        if (Style.Has(cls, "stacked")) {
            b.height = -1;
            b.padL = t.paddingTiny;
            b.padR = t.paddingTiny;
            b.padT = t.paddingTiny;
            b.padB = t.paddingTiny;
            b.gap = t.paddingTiny;
        }
        if (Style.Has(cls, "align-left")) { b.align = 0; }
        // Shape and decoration are class-selected here so the widget paints one
        // resolved box and a skin can override any of it in CSS.
        if (Style.Has(cls, "round") || Style.Has(cls, "circle")) {
            b.SetRadius(9999);
        }
        if (Style.Has(cls, "dashed")) { b.borderStyle = 1; }
        if (Style.Has(cls, "specular")) { b.specular = 1; }
        if (t.neu == 1 && !disabled) {
            b.emboss = 1;
            if (active) { b.emboss = 2; }
        }

        if (disabled) {
            // Keep a clearly visible muted shape on any theme: fill with the
            // (opaque) border grey and derive readable text from it.
            b.bg = t.borderPrimary;
            b.fg = App.LerpColor(t.borderPrimary, t.textPrimary, 110);
            b.borderColor = App.LerpColor(t.borderPrimary, t.textPrimary, 45);
            b.borderW = 1;
            return;
        }

        if (Style.Has(cls, "ghost")) {
            b.bg = 0;
            b.fg = roleBase;
            if (roleBase == 0) { b.fg = t.textPrimary; }
            b.borderColor = b.fg;
            b.borderW = 1;
            if (hover) { b.bg = App.ScaleAlpha(b.fg, 120); }
            if (active) { b.bg = App.ScaleAlpha(b.fg, 215); }
            return;
        }
        if (Style.Has(cls, "secondary")) {
            int mix = 90;
            if (hover) { mix = 150; }
            if (active) { mix = 200; }
            int tint = roleBase;
            if (tint == 0) { tint = t.textPrimary; }
            b.bg = App.LerpColor(t.bgPrimary, tint, mix);
            b.fg = tint;
            b.borderW = 0;
            return;
        }
        if (Style.Has(cls, "text")) {
            b.bg = 0;
            b.borderW = 0;
            b.fg = roleBase;
            if (roleBase == 0) { b.fg = t.textPrimary; }
            // A latched flat command (a bound Checked) reads by its own weight:
            // lit in the accent, no filled chip, so a row of switches stays a
            // list instead of a block of colour.
            if (selected) {
                b.fg = t.primary;
                if (roleBase != 0) { b.fg = roleBase; }
                if (hover) { b.fg = t.primaryHover; }
            }
            if (hover) { b.bg = t.bgHover; }
            if (active) { b.bg = t.bgActive; }
            return;
        }
        if (Style.Has(cls, "outline") || Style.Has(cls, "dashed")) {
            b.bg = t.bgPrimary;
            if (hover) { b.bg = t.bgHover; }
            if (active) { b.bg = t.bgActive; }
            b.fg = roleBase;
            if (roleBase == 0) { b.fg = t.textPrimary; }
            b.borderColor = b.fg;
            b.borderW = 1;
            return;
        }

        if (role != 0) {
            b.bg = role;
            b.fg = t.textInverse;
            b.borderColor = role;
            b.borderW = 0;
            return;
        }
        // Neutral (default) button: page surface with a border.
        b.bg = t.bgPrimary;
        if (hover) { b.bg = t.bgHover; }
        if (active) { b.bg = t.bgActive; }
        b.fg = t.textPrimary;
        b.borderColor = t.borderPrimary;
        if (hover || active) { b.borderColor = t.borderHover; }
        if (focus) { b.borderColor = t.borderFocus; }
        b.borderW = 1;
    }

    static void SurfaceDefaults(App app, StyleBox b, string cls) {
        Theme t = app.theme;
        b.bg = t.bgPrimary;
        b.fg = t.textPrimary;
        b.SetRadius(t.borderRadiusMedium);
        b.borderColor = t.borderSecondary;
        b.borderW = 1;
        b.shadow = t.shadowColor;
        b.shadowDx = 1;
        b.shadowDy = 2;
        b.padL = t.paddingLarge;
        b.padT = t.paddingLarge;
        b.padR = t.paddingLarge;
        b.padB = t.paddingLarge;
        if (t.glass != 0) {
            // Frosted skins: blur the backdrop and lay a translucent tint over
            // it instead of an opaque fill.
            b.blur = 36;
            b.bg = App.ScaleAlpha(t.bgPrimary, 260);
            // No light rim: a hairline of near-white around every card, panel
            // and popup read as a drawn-on outline (and doubled up against the
            // dividers next to it). The frost and tint already separate a glass
            // surface from the backdrop.
            b.borderW = 0;
        }
    }

    static void TabDefaults(App app, StyleBox b, string cls, bool hover,
                            bool selected, bool disabled) {
        Theme t = app.theme;
        b.bg = 0;
        b.fg = t.textSecondary;
        b.align = 1;
        b.SetRadius(0);
        if (Style.Has(cls, "card")) {
            b.bg = t.bgSecondary;
            b.SetRadius(t.borderRadiusMedium);
        } else if (Style.Has(cls, "segment")) {
            b.SetRadius(t.borderRadiusSmall);
        } else if (Style.Has(cls, "document")) {
            // Editor document tab: an opaque strip tab, active one lifted to
            // the page background so it reads as the front sheet.
            b.bg = t.bgSecondary;
        }
        if (hover && !selected) {
            b.bg = t.bgHover;
            b.fg = t.textPrimary;
        }
        if (selected) {
            b.fg = t.primary;
            if (Style.Has(cls, "card")) {
                b.bg = t.bgPrimary;
                b.borderColor = t.borderPrimary;
                b.borderW = 1;
            } else if (Style.Has(cls, "segment")) {
                b.bg = t.bgPrimary;
                b.fg = t.textPrimary;
            } else if (Style.Has(cls, "document")) {
                b.bg = t.bgPrimary;
                b.fg = t.textPrimary;
            } else {
                b.borderBottomW = 2;
                b.borderBottomColor = t.primary;
            }
        }
        if (disabled) { b.fg = t.textDisabled; }
    }

    static int MaskOf(bool hover, bool active) {
        int m = 0;
        if (hover) { m = m + Style.SHover(); }
        if (active) { m = m + Style.SActive(); }
        return m;
    }

    // ---- inline (fluent / retained-mode) overrides --------------------------

    /// Layers a control's own inline style (Control.Bg/Radius/Border/... or the
    /// CSS applied by UiDoc) over a resolved box, so retained-mode controls and
    /// immediate-mode widgets share one resolution path.
    static void Inline(StyleBox b, Control c) {
        if (c == null) { return; }
        if (c.styleBg != 0) { b.bg = c.styleBg; b.bgTo = c.styleBgTo; }
        if (c.styleRadius != 0) { b.SetRadius(c.styleRadius); }
        if (c.styleBorderColor != 0) { b.borderColor = c.styleBorderColor; }
        if (c.styleBorderWidth != 0) { b.borderW = c.styleBorderWidth; }
        if (c.styleShadow != 0) {
            b.shadow = c.styleShadow;
            b.shadowDy = c.styleShadowDy;
        }
        if (c.styleColor != 0) { b.fg = c.styleColor; }
        if (c.styleFontPx != 0) { b.fontPx = c.styleFontPx; }
        if (c.styleTransitionMs != 0) { b.transitionMs = c.styleTransitionMs; }
    }
}
