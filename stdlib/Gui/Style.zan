using System;
using System.Json;

namespace Gui;

/// <summary>
/// 样式解析器：把（控件类型、类、状态）解析为一个
/// StyleBox——依次叠加当前主题的默认值、当前皮肤的
/// 样式表以及控件自身的 inline 样式，并在状态之间
/// 交叉淡入淡出，从而支持 `transition`。
///
/// 这正是控件无需携带各皮肤绘制代码即可换肤的关键。
/// 控件的整个视觉层变成：
///
///     int st = Style.StateOf(app, id, disabled);
///     StyleBox s = Style.Eased(app, id, "button", "primary", disabled);
///     s.Paint(app, x, y, w, h);
///     s.DrawLabel(app, x, y, w, h, label);
///
/// 选择器遵循 CSS：`button`、`.primary`、`button.primary`、`#save` 以及
/// 它们的 `:hover / :active / :focus / :disabled / :checked / :selected` 状态
/// 变体，按特异性升序解析（type、class、type.class、id）。
/// 主题 token 提供默认值，皮肤只需声明差异，
/// 没有 skin.css 的应用外观与内置主题完全一致。
/// </summary>
class Style {
    // ---- interaction state bits --------------------------------------------

    static int SNormal()   { return 0; }
    static int SHover()    { return 1; }
    static int SActive()   { return 2; }
    static int SFocus()    { return 4; }
    static int SDisabled() { return 8; }
    static int SSelected() { return 16; }
    static int SChecked()  { return 32; }

    // ---- animation kinds (CSS `animation: <name> ...`) ---------------------

    static int AnimNone()    { return 0; }
    static int AnimSpin()    { return 1; }
    static int AnimPulse()   { return 2; }
    static int AnimBreath()  { return 3; }
    static int AnimShimmer() { return 4; }
    static int AnimFloat()   { return 5; }
    static int AnimGlow()    { return 6; }
    static int AnimAurora()  { return 7; }
    static int AnimMotes()   { return 8; }

    /// 把 CSS 动画名映射为 Anim* 种类（未知返回 0）。
    static int AnimKind(string name) {
        if (name == "spin") { return Style.AnimSpin(); }
        if (name == "pulse") { return Style.AnimPulse(); }
        if (name == "breath") { return Style.AnimBreath(); }
        if (name == "shimmer") { return Style.AnimShimmer(); }
        if (name == "float") { return Style.AnimFloat(); }
        if (name == "glow") { return Style.AnimGlow(); }
        if (name == "aurora") { return Style.AnimAurora(); }
        if (name == "motes") { return Style.AnimMotes(); }
        return 0;
    }

    /// 某个状态位对应的 CSS 伪类名（基础状态返回 ""）。
    static string StateName(int bit) {
        if (bit == Style.SHover()) { return "hover"; }
        if (bit == Style.SActive()) { return "active"; }
        if (bit == Style.SFocus()) { return "focus"; }
        if (bit == Style.SDisabled()) { return "disabled"; }
        if (bit == Style.SSelected()) { return "selected"; }
        if (bit == Style.SChecked()) { return "checked"; }
        return "";
    }

    /// CSS 伪类名对应的状态位（不代表任何状态时返回 0）。
    static int StateBit(string name) {
        if (name == "hover") { return Style.SHover(); }
        if (name == "active") { return Style.SActive(); }
        if (name == "focus" || name == "focus-visible") { return Style.SFocus(); }
        if (name == "disabled") { return Style.SDisabled(); }
        if (name == "selected") { return Style.SSelected(); }
        if (name == "checked") { return Style.SChecked(); }
        return 0;
    }

    /// 控件 `id` 的实时交互状态，以状态位掩码表示。
    static int StateOf(App app, int id, bool disabled) {
        if (disabled) { return Style.SDisabled(); }
        int st = 0;
        if (app.focus.IsHovered(id)) { st = st + Style.SHover(); }
        if (app.focus.IsPressed(id) && app.focus.IsHovered(id)) {
            st = st + Style.SActive();
        }
        if (app.focus.IsFocused(id)) { st = st + Style.SFocus(); }
        return st;
    }

    // ---- resolution cache --------------------------------------------------
    // 解析需要遍历 sheet 的选择器表，因此结果按（type, class, state）
    // 记忆化，并在主题/皮肤代次变化时清空。
    // 控件每帧都要解析；缓存让这件事保持廉价。

    // 键 -> 解析结果的哈希表。线性表在一屏几百个控件、每个控件
    // 每帧解析数次时会退化：每次命中都要逐个比较字符串键，而一旦
    // 键数超过上限，整张表被清空，于是接下来的每一次解析都要重新
    // 走一遍 sheet 的选择器表——功能区换页、树展开这类整窗重绘因此
    // 变成 CPU 峰值。哈希表让命中是常数时间，容量也不再需要
    // 靠清空来控制（键的数量由界面里的 类型/类/id/状态 组合决定，
    // 本就有限，且皮肤代次一变就整体作废）。
    static Dict<string, StyleBox> cache;
    static int cacheGen;

    // 解析次数与命中次数（帧分析器读它们）。缓存命中不等于不花钱：
    // 命中一次也要拼一把键字符串、查一次哈希、克隆一个 StyleBox，
    // 所以“每帧解析了多少次”本身就是一个得盯的量。
    static int statResolve;
    static int statHit;

    static void CacheReset(int gen) {
        Style.cache = new Dict<string, StyleBox>();
        Style.cacheGen = gen;
    }

    /// 读解析计数但不清零，供按帧算差值（0 = 解析次数，1 = 命中次数）。
    static int StatPeek(int idx) {
        if (idx == 0) { return Style.statResolve; }
        return Style.statHit;
    }

    /// 取走并清零解析计数（0 = 解析次数，1 = 缓存命中次数）。
    static int StatRead(int idx) {
        if (idx == 0) {
            int v = Style.statResolve;
            Style.statResolve = 0;
            return v;
        }
        int h = Style.statHit;
        Style.statHit = 0;
        return h;
    }

    static StyleBox CacheGet(App app, string key) {
        Style.statResolve = Style.statResolve + 1;
        int gen = app.bgThemeGen;
        if (Style.cache == null || Style.cacheGen != gen) {
            Style.CacheReset(gen);
            return null;
        }
        StyleBox hit;
        if (Style.cache.TryGetValue(key, out hit)) {
            Style.statHit = Style.statHit + 1;
            return hit;
        }
        return null;
    }

    static void CachePut(string key, StyleBox box) {
        if (Style.cache == null) { return; }
        if (Style.cache.ContainsKey(key)) { return; }
        Style.cache.Add(key, box);
    }

    // ---- resolution --------------------------------------------------------

    /// 解析 `type`.`cls` 在 `state` 下的样式（主题默认值 + 皮肤）。
    static StyleBox Of(App app, string type, string cls, int state) {
        return Style.Full(app, type, cls, "", state);
    }

    /// 包含 id 选择器（`#name`）的解析，即特异性最高的一层。
    static StyleBox Full(App app, string type, string cls, string id, int state) {
        string key = type + "|" + cls + "|" + id + "|" + Convert.ToString(state)
            + "@" + Convert.ToString(app.dpiScale);
        StyleBox hit = Style.CacheGet(app, key);
        if (hit != null) { return hit.Clone(); }

        StyleBox b = new StyleBox();
        Style.Defaults(app, b, type, cls, state);
        // 主题自身的度量值会在此落入 box，且已按显示缩放；
        // 只有 sheet 之后才声明的长度（按 100% 编写）
        // 才需要再缩放，所以要保留 sheet 前的值来
        // 区分二者。
        StyleBox themed = b.Clone();
        StyleSheet basef = Style.BaseSheet(app);
        if (basef != null) { Style.ApplySheet(basef, b, type, cls, id, state); }
        StyleSheet sheet = app.sheet;
        if (sheet != null) {
            Style.ApplySheet(sheet, b, type, cls, id, state);
        }
        // Tailwind 拼写的工具类最后应用：它们写在控件上，因此像
        // Tailwind 一样胜过皮肤里的组件规则（见 Tailwind）。
        Tailwind.Apply(b, cls, state);
        Style.Shell(app, b, type, cls, state);
        Style.ScaleLayout(app, b, themed);
        Style.CachePut(key, b);
        return b.Clone();
    }

    static StyleBox Part(App app, string type, string part, string fallbackType,
                         string cls, string id, int state) {
        string key = type + "::" + part + "|" + fallbackType + "|" + cls
            + "|" + id + "|" + Convert.ToString(state);
        StyleBox hit = Style.CacheGet(app, key);
        if (hit != null) { return hit.Clone(); }

        StyleBox b = new StyleBox();
        if (fallbackType != "") {
            Style.Defaults(app, b, fallbackType, cls, state);
        }
        StyleBox themed = b.Clone();
        StyleSheet basef = Style.BaseSheet(app);
        if (basef != null) {
            if (fallbackType != "") {
                Style.ApplySheet(basef, b, fallbackType, cls, "", state);
            }
            Style.ApplyPartSheet(basef, b, type, part, cls, id, state);
        }
        StyleSheet sheet = app.sheet;
        if (sheet != null) {
            if (fallbackType != "") {
                Style.ApplySheet(sheet, b, fallbackType, cls, "", state);
            }
            Style.ApplyPartSheet(sheet, b, type, part, cls, id, state);
        }
        if (fallbackType != "") { Style.Shell(app, b, fallbackType, cls, state); }
        Style.ScaleLayout(app, b, themed);
        Style.CachePut(key, b);
        return b.Clone();
    }

    /// 把样式表的长度（box 尺寸、外边距、字号、圆角半径）
    /// 缩放到显示设备：CSS 按 100% 编写，而主题自身的
    /// 度量已按 DPI 缩放，因此 sheet 的 `width: 260px` 必须
    /// 按相同系数缩放才能保持相同的物理尺寸。百分比
    /// 无需缩放。
    ///
    /// `themed` 是主题默认值处理后的 box：若某长度仍等于
    /// 其主题值，说明它已带有显示缩放系数，不能再乘
    /// 第二次（否则 150% 显示下每个按钮、输入框和 chip 都会被放大
    /// 到 1.5 倍）。
    static void ScaleLayout(App app, StyleBox b, StyleBox themed) {
        if (app.dpiScale == 100) { return; }
        if (b.width >= 0 && b.width != themed.width) {
            b.width = app.Scale(b.width);
        }
        if (b.height >= 0 && b.height != themed.height) {
            b.height = app.Scale(b.height);
        }
        if (b.minW >= 0 && b.minW != themed.minW) { b.minW = app.Scale(b.minW); }
        if (b.minH >= 0 && b.minH != themed.minH) { b.minH = app.Scale(b.minH); }
        if (b.maxW >= 0 && b.maxW != themed.maxW) { b.maxW = app.Scale(b.maxW); }
        if (b.maxH >= 0 && b.maxH != themed.maxH) { b.maxH = app.Scale(b.maxH); }
        if (b.gap >= 0 && b.gap != themed.gap) { b.gap = app.Scale(b.gap); }
        if (b.fontPx > 0 && b.fontPx != themed.fontPx) {
            b.fontPx = app.Scale(b.fontPx);
        }
        if (b.radius >= 0 && b.radius != themed.radius) {
            b.radius = app.Scale(b.radius);
        }
        if (b.marL != themed.marL) { b.marL = app.Scale(b.marL); }
        if (b.marT != themed.marT) { b.marT = app.Scale(b.marT); }
        if (b.marR != themed.marR) { b.marR = app.Scale(b.marR); }
        if (b.marB != themed.marB) { b.marB = app.Scale(b.marB); }
        if (b.padL >= 0 && b.padL != themed.padL) { b.padL = app.Scale(b.padL); }
        if (b.padT >= 0 && b.padT != themed.padT) { b.padT = app.Scale(b.padT); }
        if (b.padR >= 0 && b.padR != themed.padR) { b.padR = app.Scale(b.padR); }
        if (b.padB >= 0 && b.padB != themed.padB) { b.padB = app.Scale(b.padB); }
    }

    /// 把 sheet 中选中该控件的每条规则叠加到 `b` 上，
    /// 按从弱到强的顺序（参见 StyleSheet.ApplyMatch）。
    ///
    /// 别名类型先应用：浮动按钮就是一颗圆按钮，它要吃到整套
    /// `button` 规则（角色、变体、状态），但皮肤仍能用
    /// `floatbutton` 只改它自己——因此是别名在前、本名在后，
    /// 而不是把上百条按钮规则在 CSS 里复制一遍。
    static void ApplySheet(StyleSheet sheet, StyleBox b, string type, string cls,
                           string id, int state) {
        string alias = Style.SheetAlias(type);
        if (alias != "") { sheet.ApplyMatch(b, alias, cls, id, "", state); }
        sheet.ApplyMatch(b, type, cls, id, "", state);
    }

    /// 该控件族借用哪个类型的 CSS 规则（"" = 不借）。
    static string SheetAlias(string type) {
        if (type == "floatbutton") { return "button"; }
        return "";
    }

    /// 控件某个 `type::part` 的同样处理（`menu::item`、`card::title`）。
    static void ApplyPartSheet(StyleSheet sheet, StyleBox b, string type,
                               string part, string cls, string id, int state) {
        sheet.ApplyMatch(b, type, cls, id, part, state);
    }

    /// 拆分以空格分隔的类列表（"primary ghost" -> [primary, ghost]）。
    static List<string> Classes(string cls) {
        List<string> outp = new List<string>();
        if (cls == "") { return outp; }
        List<string> parts = cls.Split(" ");
        for (int i = 0; i < parts.Count; i = i + 1) {
            string p = parts[i];
            if (p != "") { outp.Add(p); }
        }
        return outp;
    }

    /// `cls` 包含给定类 token 时返回 true。
    static bool Has(string cls, string name) {
        List<string> parts = Style.Classes(cls);
        for (int i = 0; i < parts.Count; i = i + 1) {
            if (parts[i] == name) { return true; }
        }
        return false;
    }

    // ---- eased (transitioned) resolution -----------------------------------

    /// 解析控件样式，并在基础、悬停和按下三种外观之间
    /// 用缓动后的交互程度做交叉淡入淡出——取代
    /// 所有控件手写的 hover/press 颜色插值。
    /// 获得焦点的控件会在最上层叠加其 `:focus` 规则（同样缓动），
    /// 禁用控件则直接采用 `:disabled` 外观。
    static StyleBox Eased(App app, int id, string type, string cls, bool disabled) {
        return Style.EasedId(app, id, type, cls, "", disabled, false);
    }

    /// 带 id 选择器以及显式 selected/checked 标志的缓动解析
    /// （标签页、列表行、开关：选中是锁定状态而非
    /// 交互，所以在 hover/press 淡入淡出之前叠加）。
    static StyleBox EasedId(App app, int id, string type, string cls, string name,
                            bool disabled, bool selected) {
        int latched = 0;
        if (selected) { latched = Style.SSelected(); }
        return Style.EasedStateId(app, id, type, cls, name, disabled, latched);
    }

    static StyleBox EasedStateId(App app, int id, string type, string cls,
                                 string name, bool disabled, int latched) {
        if (disabled) {
            return Style.Full(app, type, cls, name, Style.SDisabled() + latched);
        }
        StyleBox base0 = Style.Full(app, type, cls, name, latched);
        base0.fxId = id;
        int ms = base0.TransitionOr(0 - 1);
        int hv = Ui.HoverLevelMs(app, id, ms);
        int pv = Ui.PressLevelMs(app, id, ms);
        int fv = Ui.FocusLevelMs(app, id, ms);
        StyleBox cur = base0;
        if (hv > 0) {
            StyleBox hover = Style.Full(app, type, cls, name, latched + Style.SHover());
            cur = StyleBox.Blend(cur, hover, Style.Curve(base0.easing, hv));
        }
        if (pv > 0) {
            StyleBox act = Style.Full(app, type, cls, name,
                                      latched + Style.SHover() + Style.SActive());
            cur = StyleBox.Blend(cur, act, Style.Curve(base0.easing, pv));
        }
        if (fv > 0) {
            StyleBox foc = Style.Full(app, type, cls, name, latched + Style.SFocus());
            cur = StyleBox.Blend(cur, foc, Style.Curve(base0.easing, fv));
        }
        cur.fxId = id;
        return cur;
    }

    static StyleBox EasedPartId(App app, int id, string type, string part,
                                string fallbackType, string cls, string name,
                                bool disabled, bool selected) {
        int latched = 0;
        if (selected) { latched = Style.SSelected(); }
        return Style.EasedPartStateId(app, id, type, part, fallbackType, cls,
                                      name, disabled, latched);
    }

    static StyleBox EasedPartStateId(App app, int id, string type, string part,
                                     string fallbackType, string cls, string name,
                                     bool disabled, int latched) {
        if (disabled) {
            return Style.Part(app, type, part, fallbackType, cls, name,
                              Style.SDisabled() + latched);
        }
        StyleBox base0 = Style.Part(app, type, part, fallbackType, cls, name, latched);
        int ms = base0.TransitionOr(0 - 1);
        int hv = Ui.HoverLevelMs(app, id, ms);
        int pv = Ui.PressLevelMs(app, id, ms);
        int fv = Ui.FocusLevelMs(app, id, ms);
        StyleBox cur = base0;
        if (hv > 0) {
            StyleBox hover = Style.Part(app, type, part, fallbackType, cls, name,
                                        latched + Style.SHover());
            cur = StyleBox.Blend(cur, hover, Style.Curve(base0.easing, hv));
        }
        if (pv > 0) {
            StyleBox act = Style.Part(app, type, part, fallbackType, cls, name,
                                      latched + Style.SHover() + Style.SActive());
            cur = StyleBox.Blend(cur, act, Style.Curve(base0.easing, pv));
        }
        if (fv > 0) {
            StyleBox foc = Style.Part(app, type, part, fallbackType, cls, name,
                                      latched + Style.SFocus());
            cur = StyleBox.Blend(cur, foc, Style.Curve(base0.easing, fv));
        }
        return cur;
    }

    /// 对线性的 0..1000 进度应用 CSS 缓动函数。
    static int Curve(int easing, int p) {
        if (easing == 1) { return p; }
        if (easing == 2) { return p * p / 1000; }
        if (easing == 3) {
            int q = 1000 - p;
            return 1000 - q * q / 1000;
        }
        return App.Ease(p);
    }

    // ---- theme defaults ----------------------------------------------------

    /// 角色类（primary/info/success/warning/error）在某状态下的强调色，
    /// 无角色类时为 0。按钮/tab 的上色已经全在 skins/base.css 里，这里
    /// 留给自绘标记的控件（时间轴的圆点等）按角色取一个主题色。
    static int RoleColor(Theme t, string cls, int state) {
        bool hover = (state / Style.SHover()) % 2 == 1;
        bool active = (state / Style.SActive()) % 2 == 1;
        if (Style.Has(cls, "primary")) {
            if (active) { return t.primaryPressed; }
            if (hover) { return t.primaryHover; }
            return t.primary;
        }
        if (Style.Has(cls, "info")) {
            if (active) { return t.infoPressed; }
            if (hover) { return t.infoHover; }
            return t.info;
        }
        if (Style.Has(cls, "success")) {
            if (active) { return t.successPressed; }
            if (hover) { return t.successHover; }
            return t.success;
        }
        if (Style.Has(cls, "warning")) {
            if (active) { return t.warningPressed; }
            if (hover) { return t.warningHover; }
            return t.warning;
        }
        if (Style.Has(cls, "error")) {
            if (active) { return t.errorPressed; }
            if (hover) { return t.errorHover; }
            return t.error;
        }
        return 0;
    }

    /// 角色的静态强调色（不受状态影响）。
    static int RoleBase(Theme t, string cls) {
        return Style.RoleColor(t, cls, 0);
    }

    /// 用当前主题对某控件族的默认值填充 `b`，这样皮肤的
    /// CSS 只需声明想要改变的部分，而完全没有 CSS 的
    /// 主题应用外观与内置主题分毫不差。
    static void Defaults(App app, StyleBox b, string type, string cls, int state) {
        Theme t = app.theme;
        bool active = (state / Style.SActive()) % 2 == 1;
        bool disabled = (state / Style.SDisabled()) % 2 == 1;

        // 控件从自身尺寸比例推导的度量（高度、字号、
        // 水平内边距）在此有意不设置：控件会
        // 把它们作为回退值传入（`s.HeightOr(myHeight)`），因此 CSS 声明了
        // 就用 CSS 的，未声明时尺寸比例依然生效。
        b.transitionMs = t.animFastMs;
        b.fg = t.textPrimary;
        // 禁用态的弱化文字放在默认层，CSS 因此还能改写它
        // （皮肤的 `x:disabled { color: ... }` 以前被 Style.Shell 抹掉）。
        if (disabled) { b.fg = t.textDisabled; }
        b.accent = t.primary;

        if (type == "button" || type == "floatbutton") {
            Style.ButtonDefaults(app, b, cls, active, disabled);
        } else if (type == "tab") {
            Style.TabDefaults(app, b, cls);
        } else if (Style.CssType(type)) {
            // 其余控件族完全由 skins/base.css 定义样式，它作为基础底层 sheet
            // 叠加在最下面（参见 Style.BaseSheet）。除上面设置的
            // 共享基线外，这里无需再做任何事。
        } else {
            // 自定义组合控件（用户的 Control 子类、.zform 控件文档）
            // 是纯容器：不画卡片外框，也不吃 24px 内边距。
            // 过去这里套 SurfaceDefaults，等于给每个组合控件白送
            // 一个边框加四边内边距——父级给它 40px 高时，
            // 子控件就被挤成 0 高（搜索框消失），横向则被
            // 裁掉两侧（导轨文字截断）。外观由组合控件自己的
            // 子控件决定，皮肤仍可在 CSS 里按类型名给它上样式。
        }
    }

    /// 整体外观已迁入 skins/base.css（作为基础底层 sheet 加载）的控件族
    /// 返回 true。按钮和标签页不在此列，是因为它们还要在代码里
    /// 定几何量（尺寸档、堆叠命令、圆角形状），颜色同样只在 CSS 里。
    static bool CssType(string type) {
        return type == "input" || type == "textarea" || type == "select"
            || type == "card" || type == "panel" || type == "popup"
            || type == "dialog" || type == "contextmenu" || type == "prompt"
            || type == "tooltip" || type == "tabs" || type == "option"
            || type == "item" || type == "row" || type == "checkbox"
            || type == "radio" || type == "switch" || type == "slider"
            || type == "progress" || type == "tag" || type == "badge"
            || type == "avatar" || type == "label" || type == "text"
            || type == "statistic" || type == "empty" || type == "result"
            || type == "spin" || type == "timeline" || type == "steps"
            || type == "breadcrumb" || type == "pageheader"
            || type == "skeleton" || type == "ribbon" || type == "divider"
            || type == "stack" || type == "list" || type == "listrow"
            || type == "buttonbar"
            || type == "buttongroup"
            || type == "window"
            || type == "page" || type == "startpage" || type == "pagination"
        || type == "carousel" || type == "collapse" || type == "codeblock"
        || type == "tabview" || type == "menu" || type == "wizard"
        || type == "themedrawer" || type == "titlebar" || type == "windowbg"
        || type == "ellipsis" || type == "floatbutton" || type == "rate"
        || type == "statusbar" || type == "toolstrip" || type == "graphview"
        || type == "logview" || type == "cef" || type == "webview"
        || type == "state" || type == "styledtext" || type == "effects"
        || type == "propertygrid" || type == "chatview" || type == "pivottable"
        || type == "codeeditor";
    }

    /// 静态 CSS 规则无法表达的运行时处理，在
    /// sheet 之后应用：玻璃磨砂，以及新粗野主义的偏移阴影外壳
    /// （均受主题标志/状态控制）。禁用态的弱化文字不在这里——
    /// 它是默认层（Style.Defaults）的事，否则皮肤写的
    /// `button:disabled { color: ... }` 会被这里抹掉。
    static void Shell(App app, StyleBox b, string type, string cls, int state) {
        Theme t = app.theme;
        bool active = (state / Style.SActive()) % 2 == 1;
        // 磨砂玻璃不在这里：表面的背景、模糊、圆角、边框、投影
        // 和光泽均由 skins/base.css 根据主题导出的 `--surface-*`
        // token 声明（见 Style.RootFromTheme），皮肤在自己的 CSS 里
        // 改写即可。在 sheet 之后重写这些值只会把皮肤的声明抹掉。
        // 壁纸（或自行绘制背景的皮肤）会让主题的
        // 表面 token 变半透明，使背景透出外壳。
        // 皮肤 CSS 里命名了不透明表面颜色的——多数皮肤都是，
        // 且常用渐变——会在上面打出不透明孔洞，
        // 使卡片和工具面板像被贴到周围磨砂
        // 框架上。要让这些填充带上与 token 相同的 alpha；
        // 已经写好半透明填充的皮肤（dreamy 的 55% 紫色）保留
        // 自己的 alpha，否则卡片会暗到 token 的近不透明程度，
        // 不再与周围面板协调。
        int surfA = StyleBox.AlphaOf(t.bgPrimary);
        if (surfA < 255 && (type == "card" || type == "panel")) {
            if (b.bg != 0 && StyleBox.AlphaOf(b.bg) >= 255) {
                b.bg = App.WithAlpha(b.bg, surfA);
            }
            if (b.bgTo != 0 && StyleBox.AlphaOf(b.bgTo) >= 255) {
                b.bgTo = App.WithAlpha(b.bgTo, surfA);
            }
        }
        bool internalParts = type == "checkbox" || type == "radio" || type == "switch"
            || type == "slider" || type == "progress";
        // 未模糊的偏移阴影画在填充之下，因此没有自己的填充
        // 的盒子（sheet 保持透明的弹层族、自行绘制行
        // 的列表）会把阴影铺满整个区域，
        // 变成整块纯黑而非 4px 的边缘。仅对有填充的外壳生效。
        bool hasFill = b.bg != 0 || b.bgTo != 0;
        if (t.brutal == 1 && hasFill && !Style.FlatType(type) && !internalParts) {
            b.shadow = t.shadowColor;
            b.shadowDx = 4;
            b.shadowDy = 4;
            b.shadowBlur = 0;
            b.borderColor = t.borderPrimary;
            b.borderW = t.borderWidth;
            if (active) { b.shadow = 0; b.tx = 4; b.ty = 4; }
        }
    }

    // ---- base floor sheet --------------------------------------------------
    // 内置组件基线（skins/base.css），解析时把当前主题的
    // token 作为 :root 注入，使它的 var() 规则能解析到实时的
    // 调色板。每次解析都垫在应用自身 sheet 之下，并按主题代次
    // 缓存（主题/皮肤变化时重建）。

    static StyleSheet baseSheet;
    static int baseSheetGen;

    static StyleSheet BaseSheet(App app) {
        int gen = app.bgThemeGen;
        if (Style.baseSheet != null && Style.baseSheetGen == gen) {
            return Style.baseSheet;
        }
        string css = Skin.BaseCss();
        if (css == "") {
            Style.baseSheet = new StyleSheet();
        } else {
            Style.baseSheet = StyleSheet.FromCss(
                Style.RootFromTheme(app.theme) + "\n" + css);
        }
        Style.baseSheetGen = gen;
        return Style.baseSheet;
    }

    /// 当前主题的调色板输出为 `:root` 块，使 base.css 的 var(--token)
    /// 规则解析到当前（可能被皮肤覆写的）颜色。值以
    /// 纯十进制输出——正是 ParseColor 存储的格式——使 CSS
    /// 路径与旧代码路径的颜色逐位一致。
    static string RootFromTheme(Theme t) {
        string s = ":root {\n";
        s = s + Style.Tok("primary", t.primary);
        s = s + Style.Tok("info", t.info);
        s = s + Style.Tok("success", t.success);
        s = s + Style.Tok("warning", t.warning);
        s = s + Style.Tok("error", t.error);
        s = s + Style.Tok("text-primary", t.textPrimary);
        s = s + Style.Tok("text-secondary", t.textSecondary);
        s = s + Style.Tok("text-tertiary", t.textTertiary);
        s = s + Style.Tok("text-disabled", t.textDisabled);
        s = s + Style.Tok("text-inverse", t.textInverse);
        s = s + Style.Tok("bg-primary", t.bgPrimary);
        s = s + Style.Tok("bg-secondary", t.bgSecondary);
        s = s + Style.Tok("bg-tertiary", t.bgTertiary);
        s = s + Style.Tok("bg-hover", t.bgHover);
        s = s + Style.Tok("bg-active", t.bgActive);
        s = s + Style.Tok("bg-disabled", t.bgDisabled);
        s = s + Style.Tok("border-primary", t.borderPrimary);
        s = s + Style.Tok("border-secondary", t.borderSecondary);
        s = s + Style.Tok("border-hover", t.borderHover);
        s = s + Style.Tok("border-focus", t.borderFocus);
        s = s + Style.Tok("divider", t.divider);
        s = s + Style.Tok("shadow-color", t.shadowColor);
        s = s + Style.Tok("drawer-edge-shadow",
                          App.WithAlpha(t.shadowColor, 26));
        s = s + Style.Tok("titlebar-glass-bg",
                          App.WithAlpha(t.bgSecondary, 200));
        s = s + Style.Tok("titlebar-glass-sheen",
                          App.WithAlpha(t.textPrimary, 26));
        s = s + Style.Tok("window-glass-clear",
                          App.WithAlpha(t.bgPrimary, 198));
        s = s + Style.Tok("window-glass-sheen",
                          App.WithAlpha(t.textPrimary, 255));
        s = s + Style.Tok("window-glass-edge",
                          App.WithAlpha(t.textPrimary, 130));
        s = s + Style.Tok("window-glass-highlight",
                          App.WithAlpha(t.textPrimary, 70));
        s = s + Style.Tok("styledtext-selection",
                          App.ScaleAlpha(t.primary, 90));
        s = s + Style.Tok("styledtext-code-bg",
                          App.ScaleAlpha(t.bgTertiary, 160));
        s = s + Style.Tok("styledtext-rail-success", t.success);
        s = s + Style.Tok("styledtext-tint-success",
                          App.ScaleAlpha(t.success, 16));
        s = s + Style.Tok("styledtext-rail-primary", t.primary);
        s = s + Style.Tok("styledtext-tint-primary",
                          App.ScaleAlpha(t.primary, 34));
        s = s + Style.Tok("styledtext-rail-tool", t.textTertiary);
        s = s + Style.Tok("styledtext-tint-tool",
                          App.ScaleAlpha(t.bgTertiary, 90));
        s = s + Style.Tok("styledtext-rail-error", t.error);
        s = s + Style.Tok("styledtext-tint-error",
                          App.ScaleAlpha(t.error, 30));
        s = s + Style.Tok("caption-close-bg",
                          App.WithAlpha(Theme.Rgb(232, 17, 35), 255));
        s = s + Style.Tok("tooltip-bg", t.tooltipBg);
        s = s + Style.Tok("tooltip-border", t.tooltipBorder);
        s = s + Style.Tok("tooltip-text", t.tooltipText);
        // 表面形态 token：卡片/面板/停靠区的背景、磨砂、圆角、
        // 边框、投影和光泽都从这里取值，玻璃与不透明主题的差异
        // 就是这几个数字——玻璃的画法因此存在 base.css 里，
        // 而不是撑在控件或 Style.Shell 的分支里。皮肤可以改
        // `--glass-*` token，也可以直接改写组件规则。
        bool glass = t.glass != 0;
        int surfBg = t.bgPrimary;
        if (glass) { surfBg = App.ScaleAlpha(t.bgPrimary, t.glassTint); }
        s = s + Style.Tok("surface-bg", surfBg);
        int fieldBg = t.bgPrimary;
        if (glass) { fieldBg = App.ScaleAlpha(t.bgPrimary, 700); }
        s = s + Style.Tok("field-bg", fieldBg);
        // 字段选区与滚动条：过去在 Input/TextArea 每帧现混
        // （LerpColor），现在导出为 token，混色只在主题切换时发生一次。
        s = s + Style.Tok("selection-bg",
                          App.LerpColor(t.bgPrimary, t.primary, 96));
        s = s + Style.Tok("scrollbar", t.scrollbar);
        s = s + Style.Tok("scrollbar-hover", t.scrollbarHover);
        // 遮罩与媒体层：模态压暗层、全屏媒体 scrim 及其上的
        // 待机控件/文字色。浮层控件（Layer/Tooltip）从这些 token
        // 取色，绘制路径不再直接读主题字段。
        s = s + Style.Tok("overlay", t.overlay);
        s = s + Style.Tok("scrim", t.scrim);
        s = s + Style.Tok("scrim-chip", t.scrimChip);
        s = s + Style.Tok("scrim-chip-hover", t.scrimChipHover);
        s = s + Style.Tok("on-scrim", t.onScrim);
        s = s + Style.Tok("tooltip-text-muted", t.tooltipTextMuted);
        // 停靠区这类大面积外壳用更浓的色调：整块面板若只上卡片那么淡
        // 的一层，背后的壁纸会把文字压得读不清。
        int dockBg = t.bgTertiary;
        if (glass) { dockBg = App.ScaleAlpha(t.bgTertiary, t.glassChromeTint); }
        s = s + Style.Tok("dock-bg", dockBg);
        // 拖放高亮底色：过去由 DockHost 每帧 Style.Fade(t.primary, 260)
        // 计算，现在在换肤时导出为 token。
        s = s + Style.Tok("drop-tint", Style.Fade(t.primary, 260));
        int surfBlur = 0;
        int surfSheen = 0;
        // 这些是按 100% 书写的 CSS 长度（ScaleLayout 会按显示缩放），
        // 因此这里不能塞已经按 DPI 缩放过的主题度量。
        int surfRadius = 3;
        int surfBorderW = 1;
        int surfShadowDy = 2;
        int surfShadowBlur = 0;
        if (glass) {
            surfBlur = t.glassBlur;
            surfSheen = t.glassSheen;
            surfRadius = t.glassRadius;
            surfBorderW = 1;
            surfShadowDy = t.glassShadowDy;
            surfShadowBlur = t.glassShadowBlur;
        }
        s = s + Style.TokN("surface-blur", surfBlur);
        s = s + Style.TokN("surface-sheen", surfSheen);
        s = s + Style.TokN("surface-radius", surfRadius);
        s = s + Style.TokN("surface-border-w", surfBorderW);
        s = s + Style.TokN("surface-shadow-dy", surfShadowDy);
        s = s + Style.TokN("surface-shadow-blur", surfShadowBlur);
        // 按钮/tab 的角色色与其状态色：过去按钮的颜色在
        // ButtonDefaults 里按类名和状态现算，皮肤想改一个按下色
        // 也无从下手。现在主题只导出 token，“哪个 token 画哪个
        // 状态”写在 base.css 里。
        s = s + Style.Tok("primary-hover", t.primaryHover);
        s = s + Style.Tok("primary-pressed", t.primaryPressed);
        s = s + Style.Tok("info-hover", t.infoHover);
        s = s + Style.Tok("info-pressed", t.infoPressed);
        s = s + Style.Tok("success-hover", t.successHover);
        s = s + Style.Tok("success-pressed", t.successPressed);
        s = s + Style.Tok("warning-hover", t.warningHover);
        s = s + Style.Tok("warning-pressed", t.warningPressed);
        s = s + Style.Tok("error-hover", t.errorHover);
        s = s + Style.Tok("error-pressed", t.errorPressed);
        s = s + Style.VariantTokens("primary", t.primary, t.bgPrimary);
        s = s + Style.VariantTokens("info", t.info, t.bgPrimary);
        s = s + Style.VariantTokens("success", t.success, t.bgPrimary);
        s = s + Style.VariantTokens("warning", t.warning, t.bgPrimary);
        s = s + Style.VariantTokens("error", t.error, t.bgPrimary);
        // 中性（无角色类）的 ghost/secondary 以主文字色为色调。
        s = s + Style.VariantTokens("neutral", t.textPrimary, t.bgPrimary);
        // 禁用形状：在任何主题下都保持可见的弱化盒子。文字色由
        // Style.Shell 统一压成 --text-disabled，这里只给填充和描边。
        s = s + Style.Tok("disabled-bg", t.borderPrimary);
        s = s + Style.Tok("disabled-fg",
                          App.LerpColor(t.borderPrimary, t.textPrimary, 110));
        s = s + Style.Tok("disabled-border",
                          App.LerpColor(t.borderPrimary, t.textPrimary, 45));
        s = s + "}\n";
        return s;
    }

    /// 一个角色的 ghost / secondary 变体色。CSS 没有混色函数，而
    /// 这些混色只随主题变化，所以在导出 token 时算一次：
    /// ghost 用角色色的低透明度作悬停/按下底色，secondary 是
    /// 角色色与页面底色的浅混。皮肤可以逐个 token 改写。
    static string VariantTokens(string name, int tint, int surface) {
        string s = Style.Tok(name + "-ghost-hover-bg", App.ScaleAlpha(tint, 120));
        s = s + Style.Tok(name + "-ghost-active-bg", App.ScaleAlpha(tint, 215));
        s = s + Style.Tok(name + "-soft-bg", App.LerpColor(surface, tint, 90));
        s = s + Style.Tok(name + "-soft-hover-bg",
                          App.LerpColor(surface, tint, 150));
        s = s + Style.Tok(name + "-soft-active-bg",
                          App.LerpColor(surface, tint, 200));
        return s;
    }

    static string Tok(string name, int v) {
        return "  --" + name + ": #" + Style.Hex8(v) + ";\n";
    }

    /// 数值 token（长度/强度/开关），以十进制输出。
    static string TokN(string name, int v) {
        return "  --" + name + ": " + Convert.ToString(v) + ";\n";
    }

    /// 把 32 位颜色输出为 8 位十六进制（#AARRGGBB），按二进制补码
    /// 逐 nibble 提取，这样经 StyleSheet.HexToInt 能原样往返
    /// 回同一个带符号 int——与 `%` 的符号约定无关。
    static string Hex8(int v) {
        int x = v;
        string outp = "";
        for (int i = 0; i < 8; i = i + 1) {
            int nib = x % 16;
            if (nib < 0) { nib = nib + 16; }
            outp = Style.HexDigit(nib) + outp;
            x = (x - nib) / 16;
        }
        return outp;
    }

    static string HexDigit(int n) {
        if (n == 10) { return "A"; }
        if (n == 11) { return "B"; }
        if (n == 12) { return "C"; }
        if (n == 13) { return "D"; }
        if (n == 14) { return "E"; }
        if (n == 15) { return "F"; }
        return Convert.ToString(n);
    }

    /// 对直接绘制在给定区域内、不拥有表面的
    /// 类型返回 true，这样皮肤的全局边框和阴影外壳就不会
    /// 给它们框出盒子。
    static bool FlatType(string type) {
        return type == "ribbon" || type == "label" || type == "text"
            || type == "empty" || type == "window"
            || type == "result" || type == "spin" || type == "timeline"
            || type == "steps" || type == "breadcrumb" || type == "pageheader";
    }

    /// `tiny` / `small` / `medium` / `large` 类对应的尺寸档位，
    /// 作用于高度、字号和水平内边距。所有带尺寸的控件
    /// （button、tag 等）共用它，所以 `button.large` 和 `tag.large` 表示
    /// 同一档，皮肤仍可覆写其中任何一项。
    static void SizeDefaults(App app, StyleBox b, string cls) {
        Theme t = app.theme;
        if (Style.Has(cls, "tiny")) {
            b.height = t.heightTiny; b.fontPx = t.fontSizeTiny;
            b.padL = t.paddingSmall; b.padR = t.paddingSmall;
        } else if (Style.Has(cls, "small")) {
            b.height = t.heightSmall; b.fontPx = t.fontSizeSmall;
            b.padL = t.paddingMedium; b.padR = t.paddingMedium;
        } else if (Style.Has(cls, "large")) {
            b.height = t.heightLarge; b.fontPx = t.fontSizeLarge;
            b.padL = t.paddingLarge + t.gapSmall;
            b.padR = t.paddingLarge + t.gapSmall;
        } else if (Style.Has(cls, "medium")) {
            b.height = t.heightMedium; b.fontPx = t.fontSizeMedium;
            b.padL = t.paddingLarge; b.padR = t.paddingLarge;
        }
        // 无尺寸类：什么都不设置，所有读取方回退到
        // 传入 HeightOr/FontOr/PadLOr 的 medium 主题度量。
    }

    // ---- design-system class names -----------------------------------------
    // 下面的名称是设计系统的词汇表：控件始终只把
    // 类列表交给解析器，皮肤可以在 CSS 中重新定义其中任意一个。
    // int 形式服务于数据驱动的调用方（设计文档、
    // 场景文件），它们把变体存储为数字。

    /// 语义类型：1 primary，2 info，3 success，4 warning，5 error。
    static string TypeClass(int type) {
        switch (type) {
            case 1: return "primary";
            case 2: return "info";
            case 3: return "success";
            case 4: return "warning";
            case 5: return "error";
            default: return "";
        }
    }

    /// 列表已携带的角色类（"primary" … "error"），中性时返回 ""。
    /// 需要按角色选择图标或部件样式的控件
    /// 读取它，而不是自行逐个判断角色名。
    static string RoleClass(string cls) {
        int i = 1;
        while (i <= 5) {
            string role = Style.TypeClass(i);
            if (Style.Has(cls, role)) { return role; }
            i = i + 1;
        }
        return "";
    }

    /// 填充方式：1 outline，2 text，3 dashed（0 = solid，无类）。
    static string FillClass(int fill) {
        switch (fill) {
            case 1: return "outline";
            case 2: return "text";
            case 3: return "dashed";
            default: return "";
        }
    }

    /// 尺寸：0 tiny，1 small，2 medium，3 large。
    static string SizeClass(int size) {
        switch (size) {
            case 0: return "tiny";
            case 1: return "small";
            case 3: return "large";
            default: return "medium";
        }
    }

    /// 条目在序列中的位置：`done` 表示在当前项之前，
    /// `active` 是当前项，`pending` 在其后，失败时为 `error`。所有
    /// 序列展示（步骤指示器、时间线、向导轨道）共用它，
    /// 这样一条皮肤规则即可统一各处同一状态的样式。
    static string StateClass(int index, int current, int errorIndex) {
        if (index == errorIndex) { return "error"; }
        if (index < current) { return "done"; }
        if (index == current) { return "active"; }
        return "pending";
    }

    /// 把不透明打包颜色的 alpha 缩放到 `a` 千分比（0..1000），
    /// 任何元素都能通过它绘制来实现淡入淡出。
    static int Fade(int color, int a) {
        if (a >= 1000) { return color; }
        if (a < 0) { a = 0; }
        int rgb = color % 16777216;
        if (rgb < 0) { rgb = rgb + 16777216; }
        return (255 * a / 1000) * 16777216 + rgb;
    }

    // ---- semantic type colours ---------------------------------------------
    // 供没有自己的 StyleBox、直接绘制按钮型表面的控件使用
    // （按钮组、功能带、工具栏），所以它们接收 int。

    /// 按钮类型的强调色（默认回退到主文字色，
    /// 保证 tinted/ghost/text 样式仍然可读）。
    static int TypeColor(Theme t, int type) {
        if (type == 1) { return t.primary; }
        if (type == 2) { return t.info; }
        if (type == 3) { return t.success; }
        if (type == 4) { return t.warning; }
        if (type == 5) { return t.error; }
        return t.textPrimary;
    }

    /// 给定交互状态下按钮型表面的背景。
    /// `style` 0 = solid，1 = outline。
    static int TypeFill(Theme t, int type, int style, bool hovered, bool pressed) {
        int tc = Style.TypeColor(t, type);
        if (style == 1) {
            if (pressed) { return App.LerpColor(t.bgPrimary, tc, 55); }
            if (hovered) { return App.LerpColor(t.bgPrimary, tc, 28); }
            return t.bgPrimary;
        }
        if (type == 0) {
            if (pressed) { return t.bgActive; }
            if (hovered) { return t.bgHover; }
            return t.bgPrimary;
        }
        if (pressed) { return App.LerpColor(tc, (int)4278190080, 150); }
        if (hovered) { return App.LerpColor(tc, (int)4294967295, 150); }
        return tc;
    }

    /// 与 TypeFill 匹配的前景（label）颜色。
    static int TypeFg(Theme t, int type, int style) {
        if (style == 1 || type == 0) {
            if (type == 0) { return t.textPrimary; }
            return Style.TypeColor(t, type);
        }
        return t.textInverse;
    }

    /// 按钮的几何量与非声明式装饰。颜色（角色、变体、各状态）
    /// 全在 skins/base.css 里，这里一律不碰——否则皮肤写了
    /// `button.primary:active` 也改不动一个按下色。
    static void ButtonDefaults(App app, StyleBox b, string cls, bool active,
                               bool disabled) {
        Theme t = app.theme;
        b.SetRadius(t.borderRadiusMedium);
        b.gap = t.gapSmall;
        b.align = 1;
        Style.SizeDefaults(app, b, cls);
        // 堆叠命令（图标在上、文字在下）按内容测量，所以
        // 它去掉尺寸档的固定高度和过宽的侧边内边距。
        if (Style.Has(cls, "stacked")) {
            b.height = -1;
            b.padL = t.paddingTiny;
            b.padR = t.paddingTiny;
            b.padT = t.paddingTiny;
            b.padB = t.paddingTiny;
            b.gap = t.paddingTiny;
        }
        if (Style.Has(cls, "align-left")) { b.align = 0; }
        // 形状与装饰在此按类选择，这样控件只绘制一个
        // 已解析的 box，皮肤可以在 CSS 中覆写其中任意部分。
        if (Style.Has(cls, "round") || Style.Has(cls, "circle")) {
            b.SetRadius(9999);
        }
        if (Style.Has(cls, "dashed")) { b.borderStyle = 1; }
        if (Style.Has(cls, "specular")) { b.specular = 1; }
        if (t.neu == 1 && !disabled) {
            b.emboss = 1;
            if (active) { b.emboss = 2; }
        }
    }

    static void SurfaceDefaults(App app, StyleBox b, string cls) {
        Theme t = app.theme;
        b.bg = t.bgPrimary;
        b.fg = t.textPrimary;
        b.SetRadius(t.borderRadiusMedium);
        b.borderColor = t.borderSecondary;
        b.borderW = 1;
        b.shadow = t.shadowColor;
        b.shadowDx = 1;
        b.shadowDy = 2;
        b.padL = t.paddingLarge;
        b.padT = t.paddingLarge;
        b.padR = t.paddingLarge;
        b.padB = t.paddingLarge;
        if (t.glass != 0) {
            // 磨砂皮肤：模糊背景并叠加半透明色调，
            // 而不是不透明填充。
            b.blur = 36;
            b.bg = App.ScaleAlpha(t.bgPrimary, 260);
            // 不加浅色描边：每张卡片、面板和弹层外围的
            // 近白细线会显得像画上去的轮廓（并且与
            // 旁边的分隔线叠加变粗）。磨砂和色调已足够把玻璃表面
            // 与背景区分开。
            b.borderW = 0;
        }
    }

    /// 单个标签页的几何量。颜色（基础/悬停/选中、下划线与卡片
    /// 描边）在 skins/base.css 的 `tab`、`tab.card`、`tab.segment`、
    /// `tab.document` 规则里。
    static void TabDefaults(App app, StyleBox b, string cls) {
        Theme t = app.theme;
        b.align = 1;
        b.SetRadius(0);
        if (Style.Has(cls, "card")) {
            b.SetRadius(t.borderRadiusMedium);
        } else if (Style.Has(cls, "segment")) {
            b.SetRadius(t.borderRadiusSmall);
        }
    }

    // ---- inline (fluent / retained-mode) overrides --------------------------

    /// 把控件自身的 inline 样式（Control.Bg/Radius/Border/... 或 UiDoc 应用的
    /// CSS）叠加到已解析的 box 上，使 retained-mode 控件与
    /// immediate-mode 控件共用一条解析路径。
    static void Inline(StyleBox b, Control c) {
        if (c == null) { return; }
        if (c.styleBg != 0) { b.bg = c.styleBg; b.bgTo = c.styleBgTo; }
        if (c.styleRadius != 0) { b.SetRadius(c.styleRadius); }
        if (c.styleBorderColor != 0) { b.borderColor = c.styleBorderColor; }
        if (c.styleBorderWidth != 0) { b.borderW = c.styleBorderWidth; }
        if (c.styleShadow != 0) {
            b.shadow = c.styleShadow;
            b.shadowDy = c.styleShadowDy;
        }
        if (c.styleColor != 0) { b.fg = c.styleColor; }
        if (c.styleFontPx != 0) { b.fontPx = c.styleFontPx; }
        if (c.styleTransitionMs != 0) { b.transitionMs = c.styleTransitionMs; }
    }
}
