using System;
using Gui;
using Gui.Widget;

namespace Gui.Component;

/// 尾部滚动、可选择的控制台视图**控件**：把 LogView 的滚动与
/// 选择状态包进一个标准 retained 控件，于是声明式界面
/// （`.zform`）可以像放 ListView 一样直接声明一个控制台，
/// 宿主只需要绑定行列表。行颜色可选。
class ConsoleView : Control {
    /// 调用方的行，每帧读取（不拷贝）。
    List<string> data;
    /// 与 `data` 平行的行颜色（0 = 主题默认），可为空列表。
    List<int> colors;
    /// 滚动与选择状态（渲染共用一份，宿主可经 State() 持久化或复位）。
    LogState st;
    /// 无行时居中显示的提示（"" 则不绘制）。
    string Empty;
    /// false 时只绘制，不处理滚轮/选择（嵌入的小日志条）。
    bool live;

    /// 构造空视图：未绑定行，活动模式（滚轮/选择可用）。
    ConsoleView() {
        this.InitControl("console", 5);
        data = null;
        colors = new List<int>();
        st = new LogState();
        Empty = "";
        live = true;
    }

    /// 控件类型标识（"ConsoleView"）。
    override string Kind() { return "ConsoleView"; }

    /// 样式类别（沿用 LogView 的 "log"，两者皮肤一致）。
    override string StyleType() { return "log"; }

    /// 绑定调用方的行列表（实时视图，不拷贝）。
    ConsoleView Bind(List<string> lines) {
        data = lines;
        return this;
    }

    /// 绑定与行平行的颜色列表。
    ConsoleView WithColors(List<int> cols) {
        if (cols != null) { colors = cols; }
        return this;
    }

    /// 无行时的提示文案（"" 不显示）。
    ConsoleView EmptyText(string text) {
        if (text != null) { Empty = text; }
        return this;
    }

    /// 只读日志条：不接受滚轮与拖拽选择。
    ConsoleView Passive() {
        live = false;
        return this;
    }

    /// 视图的滚动/选择状态，供宿主持久化或复位。
    LogState State() { return st; }

    /// 跳回最新一行并清除选择。
    void Reset() { st.Reset(); }

    /// 当前选中的文本（无选择时为 ""）。
    string SelectedText() {
        List<string> lines = data;
        if (lines == null) { return ""; }
        if (!st.HasSelection()) { return ""; }
        return LogView.SelectionText(lines, st);
    }

    /// 绘制：整体委托给 LogView.Render（含滚轮、尾部滚动与选择）。
    override void OnPaint(App app) {
        List<string> lines = data;
        if (lines == null) { lines = new List<string>(); }
        List<int> cols = colors;
        if (cols == null) { cols = new List<int>(); }
        LogView.Render(app, bx, by, bw, bh, lines, cols, st, Empty, live);
    }
}
