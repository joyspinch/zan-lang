using System;
using Gui;
using Gui.Component.DataTable;

namespace Gui.Component;

/// PivotTable 交叉表（cross-tabulation）的配置。
/// rowField  ：列索引，其不同取值成为透视表的行
/// colField  ：列索引，其不同取值成为透视表的列
/// valueField：数值列索引，在每个交叉点处聚合
/// aggType   ：0 求和，1 计数，2 平均，3 最大，4 最小
///
/// 单个度量可内联给出（valueField/aggType）。若要多个
/// 度量并排显示，请调用 AddValue(...) 一次或多次；此时内联的
/// value 被忽略，每个 colKey 在两级列标题下展开为每个度量
/// 一个子列。
class PivotConfig {
    int rowField;
    int colField;
    int valueField;
    int aggType;
    string rowTitle;
    string colTitle;
    string valueTitle;

    List<PivotMeasure> measures; // 额外的度量（字段 + 聚合方式 + 标题）

    PivotConfig(int rowField, int colField, int valueField, int aggType) {
        this.rowField = rowField;
        this.colField = colField;
        this.valueField = valueField;
        this.aggType = aggType;
        this.rowTitle = "";
        this.colTitle = "";
        this.valueTitle = "";
        this.measures = new List<PivotMeasure>();
    }

    /// 添加一个度量（数值字段 + 聚合方式）。流式：返回配置本身。
    static PivotConfig AddValue(PivotConfig p, int field, int agg, string title) {
        p.measures.Add(new PivotMeasure(field, agg, title));
        return p;
    }
}

/// 单个透视单元格或合计的聚合累加器（求和/计数/最大/最小）。
/// 取代旧的 sum/cnt/mx/mn 平行列表约定。
class PivotAgg {
    int sum;
    int cnt;
    int mx;
    int mn;

    PivotAgg() {
        sum = 0;
        cnt = 0;
        mx = 0;
        mn = 0;
    }

    void Add(int v) {
        if (cnt == 0) {
            mx = v;
            mn = v;
        } else {
            if (v > mx) { mx = v; }
            if (v < mn) { mn = v; }
        }
        sum = sum + v;
        cnt = cnt + 1;
    }

    int Value(int aggType) {
        return PivotTable.AggValue(sum, cnt, mx, mn, aggType);
    }
}

/// 一个已解析的度量：读取哪一列、如何聚合以及它的
/// 显示标题。取代旧的 field/agg/title 平行列表。
class PivotMeasure {
    int field;
    int agg;
    string title;

    PivotMeasure(int f, int a, string tt) {
        field = f;
        agg = a;
        title = tt;
    }
}

/// 交叉表/透视表。按两个字段对原始 DataRows 分组，并在每个
/// 行列交叉点聚合一个或多个数值度量，带行
/// 合计、列合计和总计。聚合每帧运行（每个轴上的
/// 不同键数量预计不会太多）。
class PivotTable {

    static string AggName(int a) {
        if (a == 0) { return "Sum"; }
        if (a == 1) { return "Count"; }
        if (a == 2) { return "Avg"; }
        if (a == 3) { return "Max"; }
        return "Min";
    }

    static int AggValue(int s, int n, int mx, int mn, int a) {
        if (n == 0) { return 0; }
        if (a == 0) { return s; }
        if (a == 1) { return n; }
        if (a == 2) { return s / n; }
        if (a == 3) { return mx; }
        return mn;
    }

    // 子列标题的简短度量说明："Sum" 或 "Sum · Score"。
    static string MeasureLabel(int agg, string title) {
        string nm = PivotTable.AggName(agg);
        if (title.Length > 0) { return nm + " · " + title; }
        return nm;
    }

    // 字段的不同取值，返回时已排序。通过重复选择最小值
    // （仅追加）构建新列表。使用 int 标志而非
    // List<bool>，因为 bool 元素写入不能可靠保留。
    static List<string> SortedDistinct(List<DataRow> rows, int field) {
        List<string> raw = DataTable.Distinct(new RowListSource(rows), field);
        int n = raw.Count;
        List<int> used = new List<int>();
        for (int u = 0; u < n; u = u + 1) { used.Add(0); }
        List<string> res = new List<string>();
        for (int k = 0; k < n; k = k + 1) {
            int best = -1;
            for (int i = 0; i < n; i = i + 1) {
                if (used[i] == 0) {
                    if (best < 0 || DataTable.CompareCell(raw[i], raw[best], false) < 0) { best = i; }
                }
            }
            used[best] = 1;
            res.Add(raw[best]);
        }
        return res;
    }

    static void DrawNum(Canvas c, int cx, int cy, int cw, int rowH, int pad, string val, int color, int fs) {
        int tw = Canvas.MeasureText(val, fs);
        int ty = Canvas.CenterTextY(cy, rowH, fs);
        c.DrawText(cx + cw - tw - pad, ty, val, color, fs);
    }

    static void Render(App app, int x, int y, int viewW, int viewH,
                       List<DataRow> rows, PivotConfig cfg) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int fs = Style.FontFallback(app, "medium");
        int fsS = Style.FontFallback(app, "small");
        int pad = t.paddingSmall;

        // 解析度量列表：显式的 AddValue 度量，否则是单个
        // 内联数值字段。M 始终 >= 1。
        List<PivotMeasure> measures = new List<PivotMeasure>();
        if (cfg.measures.Count > 0) {
            foreach (PivotMeasure pm in cfg.measures) {
                measures.Add(new PivotMeasure(pm.field, pm.agg, pm.title));
            }
        } else {
            measures.Add(new PivotMeasure(cfg.valueField, cfg.aggType, cfg.valueTitle));
        }
        int M = measures.Count;

        List<string> rowKeys = PivotTable.SortedDistinct(rows, cfg.rowField);
        List<string> colKeys = PivotTable.SortedDistinct(rows, cfg.colField);
        int R = rowKeys.Count;
        int C = colKeys.Count;

        // 逐单元格累加器，按 (r, c, measure) 展平；每个一个 PivotAgg。
        int cells = R * C * M;
        List<PivotAgg> cell = new List<PivotAgg>();
        for (int k = 0; k < cells; k = k + 1) { cell.Add(new PivotAgg()); }

        // 逐行/逐列/总计累加器，每个按 (axis, measure) 组织。
        List<PivotAgg> rowAgg = new List<PivotAgg>();
        for (int ir = 0; ir < R * M; ir = ir + 1) { rowAgg.Add(new PivotAgg()); }
        List<PivotAgg> colAgg = new List<PivotAgg>();
        for (int ic = 0; ic < C * M; ic = ic + 1) { colAgg.Add(new PivotAgg()); }
        List<PivotAgg> grand = new List<PivotAgg>();
        for (int ig = 0; ig < M; ig = ig + 1) { grand.Add(new PivotAgg()); }

        for (int ri2 = 0; ri2 < rows.Count; ri2 = ri2 + 1) {
            DataRow row = rows[ri2];
            int ridx = rowKeys.IndexOf(row.At(cfg.rowField));
            int cidx = colKeys.IndexOf(row.At(cfg.colField));
            if (ridx >= 0 && cidx >= 0) {
                for (int m = 0; m < M; m = m + 1) {
                    int v = DataTable.ParseInt(row.At(measures[m].field));
                    cell[(ridx * C + cidx) * M + m].Add(v);
                    rowAgg[ridx * M + m].Add(v);
                    colAgg[cidx * M + m].Add(v);
                    grand[m].Add(v);
                }
            }
        }

        int headerH = t.heightMedium;
        int rowH = t.heightMedium;
        int rowHeadW = app.Scale(150);
        int subW = app.Scale(112);
        StyleBox surfaceStyle = Style.Part(app, "pivottable", "surface", "",
                                           "", "", Style.SNormal());
        StyleBox headStyle = Style.Part(app, "pivottable", "head", "",
                                        "", "", Style.SNormal());
        StyleBox totalStyle = Style.Part(app, "pivottable", "total", "",
                                         "", "", Style.SNormal());
        StyleBox cornerStyle = Style.Part(app, "pivottable", "corner", "",
                                          "", "", Style.SNormal());
        StyleBox headLabelStyle = Style.Part(app, "pivottable", "head-label", "",
                                             "", "", Style.SNormal());
        StyleBox headMutedStyle = Style.Part(app, "pivottable", "head-muted", "",
                                             "", "", Style.SNormal());
        StyleBox bodyLabelStyle = Style.Part(app, "pivottable", "body-label", "",
                                             "", "", Style.SNormal());
        StyleBox bodyValueStyle = Style.Part(app, "pivottable", "body-value", "",
                                             "", "", Style.SNormal());
        StyleBox bodyEmptyStyle = Style.Part(app, "pivottable", "body-empty", "",
                                             "", "", Style.SNormal());
        StyleBox gridStyle = Style.Part(app, "pivottable", "grid", "",
                                        "", "", Style.SNormal());
        StyleBox accentStyle = Style.Part(app, "pivottable", "accent", "",
                                          "", "", Style.SNormal());
        int gridColor = gridStyle.BgOr(0);

        // 多于一个度量时使用两行列标题：colKey 组在上，
        // 度量说明在下。单个度量保持紧凑标题。
        bool twoRow = M > 1;
        int hTop = headerH;
        int hBot = 0;
        if (twoRow) { hBot = headerH; }
        int headBand = hTop + hBot;

        int clipRight = x + viewW - app.Scale(2);
        int clipBottom = y + viewH - app.Scale(2);

        // 外框
        c.FillRoundRect(x, y, viewW, viewH, t.borderRadiusMedium, surfaceStyle.BgOr(0));
        c.DrawRoundRect(x, y, viewW, viewH, t.borderRadiusMedium,
                        surfaceStyle.BorderOr(0), 1);

        // 对视图框硬裁剪：逐列/行的 clipRight/clipBottom
        // 计算已阻止大部分溢出，但此处保证任何单元格、表头
        // 或网格线都不会画到表格自身的矩形之外。
        c.PushClip(x, y, viewW, viewH);

        // ---- 角格（聚合描述符）----
        c.FillRect(x, y, rowHeadW, headBand, headStyle.BgOr(0));
        string corner = PivotTable.AggName(measures[0].agg);
        if (M > 1) { corner = Convert.ToString(M) + " measures"; }
        else if (measures[0].title.Length > 0) { corner = corner + " of " + measures[0].title; }
        int cornerY = Canvas.CenterTextY(y, headBand, fsS);
        c.DrawText(x + pad, cornerY, corner, cornerStyle.FgOr(0), fsS);

        // ---- 列标题（colKey 组，每组 M 个子列宽）----
        int cx = x + rowHeadW;
        int cjj = 0;
        while (cjj < C) {
            if (cx >= clipRight) { cjj = C; } else {
                int groupW = subW * M;
                if (cx + groupW > clipRight) { groupW = clipRight - cx; }
                c.FillRect(cx, y, groupW, hTop, headStyle.BgOr(0));
                c.FillRect(cx, y, 1, headBand, gridColor);
                string ct = DataTable.Truncate(colKeys[cjj], fs, groupW - pad * 2);
                c.DrawTextCentered(cx, y, groupW, hTop, ct,
                                   headLabelStyle.FgOr(0), fs);
                if (twoRow) {
                    for (int mj = 0; mj < M; mj = mj + 1) {
                        int sx = cx + subW * mj;
                        if (sx < clipRight) {
                            int sw = subW;
                            if (sx + sw > clipRight) { sw = clipRight - sx; }
                            c.FillRect(sx, y + hTop, sw, hBot, headStyle.BgOr(0));
                            if (mj > 0) { c.FillRect(sx, y + hTop, 1, hBot, gridColor); }
                            string ml = DataTable.Truncate(PivotTable.MeasureLabel(measures[mj].agg, measures[mj].title), fsS, sw - pad * 2);
                            c.DrawTextCentered(sx, y + hTop, sw, hBot, ml,
                                               headMutedStyle.FgOr(0), fsS);
                        }
                    }
                }
                cx = cx + groupW;
                if (groupW < subW * M) { cjj = C; } else { cjj = cjj + 1; }
            }
        }
        int totalColX = cx;
        bool showTotalCol = (cx + subW * M) <= clipRight;
        if (showTotalCol) {
            int gW = subW * M;
            c.FillRect(cx, y, gW, hTop, totalStyle.BgOr(0));
            c.FillRect(cx, y, 1, headBand, gridColor);
            c.DrawTextCentered(cx, y, gW, hTop, "Total",
                               headLabelStyle.FgOr(0), fs);
            if (twoRow) {
                for (int mj = 0; mj < M; mj = mj + 1) {
                    int sx = cx + subW * mj;
                    c.FillRect(sx, y + hTop, subW, hBot, totalStyle.BgOr(0));
                    if (mj > 0) { c.FillRect(sx, y + hTop, 1, hBot, gridColor); }
                    string ml = DataTable.Truncate(PivotTable.MeasureLabel(measures[mj].agg, measures[mj].title), fsS, subW - pad * 2);
                    c.DrawTextCentered(sx, y + hTop, subW, hBot, ml,
                                       headMutedStyle.FgOr(0), fsS);
                }
            }
        }
        c.FillRect(x, y + headBand - 1, viewW, 1, gridColor);

        // ---- 主体行 ----
        int by = y + headBand;
        int rii = 0;
        while (rii < R) {
            if (by + rowH > clipBottom) { rii = R; } else {
                c.FillRect(x, by, rowHeadW, rowH, headStyle.BgOr(0));
                string rt = DataTable.Truncate(rowKeys[rii], fs, rowHeadW - pad * 2);
                c.DrawText(x + pad, Canvas.CenterTextY(by, rowH, fs), rt,
                           bodyLabelStyle.FgOr(0), fs);
                c.FillRect(x + rowHeadW, by, 1, rowH, gridColor);

                int cx2 = x + rowHeadW;
                int cj2 = 0;
                while (cj2 < C) {
                    if (cx2 >= clipRight) { cj2 = C; } else {
                        for (int mj = 0; mj < M; mj = mj + 1) {
                            int sx = cx2 + subW * mj;
                            if (sx < clipRight) {
                                int sw = subW;
                                if (sx + sw > clipRight) { sw = clipRight - sx; }
                                c.FillRect(sx, by, 1, rowH, gridColor);
                                int idx = (rii * C + cj2) * M + mj;
                                if (cell[idx].cnt > 0) {
                                    int v = cell[idx].Value(measures[mj].agg);
                                    PivotTable.DrawNum(c, sx, by, sw, rowH, pad,
                                                       Convert.ToString(v),
                                                       bodyValueStyle.FgOr(0), fs);
                                } else {
                                    c.DrawTextCentered(sx, by, sw, rowH, "-",
                                                       bodyEmptyStyle.FgOr(0), fs);
                                }
                            }
                        }
                        cx2 = cx2 + subW * M;
                        if (cx2 > clipRight) { cj2 = C; } else { cj2 = cj2 + 1; }
                    }
                }
                if (showTotalCol) {
                    for (int mj = 0; mj < M; mj = mj + 1) {
                        int sx = totalColX + subW * mj;
                        c.FillRect(sx, by, subW, rowH, headStyle.BgOr(0));
                        c.FillRect(sx, by, 1, rowH, gridColor);
                        int rm = rii * M + mj;
                        int vtt = rowAgg[rm].Value(measures[mj].agg);
                        PivotTable.DrawNum(c, sx, by, subW, rowH, pad,
                                           Convert.ToString(vtt),
                                           bodyValueStyle.FgOr(0), fs);
                    }
                }
                c.FillRect(x, by + rowH - 1, viewW, 1, gridColor);
                by = by + rowH;
                rii = rii + 1;
            }
        }

        // ---- 总计行 ----
        if (by + rowH <= clipBottom) {
            c.FillRect(x, by, viewW, rowH, totalStyle.BgOr(0));
            c.DrawText(x + pad, Canvas.CenterTextY(by, rowH, fs), "Total",
                       headLabelStyle.FgOr(0), fs);
            c.FillRect(x + rowHeadW, by, 1, rowH, gridColor);
            int cx3 = x + rowHeadW;
            int cj3 = 0;
            while (cj3 < C) {
                if (cx3 >= clipRight) { cj3 = C; } else {
                    for (int mj = 0; mj < M; mj = mj + 1) {
                        int sx = cx3 + subW * mj;
                        if (sx < clipRight) {
                            int sw = subW;
                            if (sx + sw > clipRight) { sw = clipRight - sx; }
                            c.FillRect(sx, by, 1, rowH, gridColor);
                            int cm = cj3 * M + mj;
                            if (colAgg[cm].cnt > 0) {
                                int v = colAgg[cm].Value(measures[mj].agg);
                                PivotTable.DrawNum(c, sx, by, sw, rowH, pad,
                                                   Convert.ToString(v),
                                                   bodyValueStyle.FgOr(0), fs);
                            }
                        }
                    }
                    cx3 = cx3 + subW * M;
                    if (cx3 > clipRight) { cj3 = C; } else { cj3 = cj3 + 1; }
                }
            }
            if (showTotalCol) {
                for (int mj = 0; mj < M; mj = mj + 1) {
                    int sx = totalColX + subW * mj;
                    c.FillRect(sx, by, 1, rowH, gridColor);
                    int vg = grand[mj].Value(measures[mj].agg);
                    PivotTable.DrawNum(c, sx, by, subW, rowH, pad,
                                       Convert.ToString(vg), accentStyle.FgOr(0), fs);
                }
            }
        }

        c.PopClip();
    }
}

