using System;
using System.IO;
using System.Diagnostics;

namespace Gui.Component.CefBrowser;

/// <summary>
/// 原生 zan_cef driver 的扁平句柄 API。
///
/// 和 WebViewBackend 不同，这里不能用 [DllImport]：CEF 的 C 结构体布局
/// 按版本绑定，同一份 driver 只能配一个 CEF 分支，而分支是运行时按系统
/// 决定的（旧 Windows → 109，其余 → 最新 stable），所以 driver 本身也要
/// 在运行时挑：zan_cef（最新）/ zan_cef109（109 变体），用 Interop
/// （LoadLibrary/dlopen）解析，缺失时 IsAvailable() 为 false 而不是加载
/// 失败——与 System.Scripting.Python 对待可选原生依赖的方式一致。
///
/// driver 自己再 dlopen CefRuntime 装好的 libcef，并在调用任何版本相关
/// 结构体前校验 CEF API hash，因此“driver 变体和运行时对不上”是一个
/// 明确的错误而不是内存踩踏。
/// </summary>
class CefBackend {
    static nint mod;
    static bool resolved;
    static string lastError = "";
    static string libName = "";

    static nint addr_lastError;
    static nint addr_ready;
    static nint addr_executeProcess;
    static nint addr_init;
    static nint addr_work;
    static nint addr_shutdown;
    static nint addr_create;
    static nint addr_close;
    static nint addr_alive;
    static nint addr_window;
    static nint addr_setBounds;
    static nint addr_setVisible;
    static nint addr_setClip;
    static nint addr_setFocus;
    static nint addr_setPopupPolicy;
    static nint addr_takePopupUrl;
    static nint addr_setZoom;
    static nint addr_getZoom;
    static nint addr_find;
    static nint addr_stopFind;
    static nint addr_print;
    static nint addr_showDevTools;
    static nint addr_closeDevTools;
    static nint addr_navigate;
    static nint addr_back;
    static nint addr_forward;
    static nint addr_reload;
    static nint addr_stop;
    static nint addr_canGoBack;
    static nint addr_canGoForward;
    static nint addr_isLoading;
    static nint addr_navSeq;
    static nint addr_lastStatus;
    static nint addr_lastErrorCode;
    static nint addr_url;
    static nint addr_title;
    static nint addr_executeJs;
    static nint addr_cdpSend;
    static nint addr_cdpPending;
    static nint addr_cdpDropped;
    static nint addr_cdpAttached;
    static nint addr_cdpTake;

    /// <summary>能加载到匹配当前运行时分支的 zan_cef driver 时为 true。
    /// </summary>
    static bool IsAvailable() {
        return CefBackend.Resolve("");
    }

    /// <summary>最近一次失败的原因（加载/解析/原生侧），成功为 ""。
    /// </summary>
    static string Error() {
        if (CefBackend.resolved && CefBackend.addr_lastError != 0) {
            CefStrFn f = (CefStrFn)CefBackend.addr_lastError;
            string native = f();
            if (native != "") { return native; }
        }
        return CefBackend.lastError;
    }

    /// <summary>已加载的 driver 文件名（未加载为 ""）。</summary>
    static string LibraryName() { return CefBackend.libName; }

    // ---------------------------------------------------------- 加载与解析

    /// <summary>加载 driver 并解析全部入口点。<paramref name="cefVersion"/>
    /// 是运行时的 CEF 版本（""=未知，按最新变体处理），用来在 109 与最新
    /// 两个变体之间挑选。幂等。
    ///
    /// <para>线程安全：本类没加锁；Zan 的 GUI/脚本进程一般只有一个 UI 线程调
    /// <see cref="Work"/>，多线程同时进 <c>Resolve</c> 会重复 dlopen + 重复
    /// 解析并可能 <c>Interop.Unload</c> 对方正在用的句柄。不要在多线程下
    /// 首次触发 CEF。</para></summary>
    static bool Resolve(string cefVersion) {
        if (CefBackend.resolved) { return true; }
        List<string> cands = CefBackend.Candidates(cefVersion);
        for (int i = 0; i < cands.Count; i = i + 1) {
            CefBackend.mod = Interop.Load(cands[i]);
            if (CefBackend.mod != 0) {
                CefBackend.libName = cands[i];
                break;
            }
        }
        if (CefBackend.mod == 0) {
            // 单文件发布（Windows --link-mode static）下 exe 旁边没有
            // driver，它就在 exe 里面：先落盘再交给系统加载器。
            string extracted = CefBackend.Extract(
                CefBackend.FileName(cefVersion));
            if (extracted != "") {
                CefBackend.mod = Interop.Load(extracted);
                if (CefBackend.mod != 0) { CefBackend.libName = extracted; }
            }
        }
        if (CefBackend.mod == 0) {
            // Extract() 失败时留下的原因要一起报出来，否则「内嵌了但没落
            // 盘成功」会被说成「找不到 driver」。
            string why = "";
            if (CefBackend.lastError != "") {
                why = "（" + CefBackend.lastError + "）";
            }
            CefBackend.lastError = "找不到原生 zan_cef driver（" + cands[0]
                + "）：" + Interop.LastError() + why;
            return false;
        }
        if (!CefBackend.ResolveSymbols()) {
            Interop.Unload(CefBackend.mod);
            CefBackend.mod = 0;
            CefBackend.libName = "";
            return false;
        }
        CefBackend.resolved = true;
        return true;
    }

    /// <summary>按平台命名规则和 CEF 分支列出候选 driver 路径：先按
    /// ZAN_CEF_DRIVER 指定的绝对路径，再是可执行文件同目录（--publish
    /// 会把 driver 拷到这里），最后交给系统加载器按名字找。</summary>
    static List<string> Candidates(string cefVersion) {
        string file = CefBackend.FileName(cefVersion);
        List<string> cands = new List<string>();
        string forced = CefOptions.DriverPath();
        if (forced != "") {
            if (Directory.Exists(forced)) { cands.Add(forced + "/" + file); }
            else { cands.Add(forced); }
        }
        string dir = ProcessHost.AppDir();
        if (dir != "") { cands.Add(dir + "/" + file); }
        cands.Add(file);
        return cands;
    }

    /// <summary>当前平台上该 CEF 分支对应的 driver 文件名。</summary>
    static string FileName(string cefVersion) {
        string baseName = "zan_cef";
        if (cefVersion.StartsWith("109.")) { baseName = "zan_cef109"; }
        #if WINDOWS
        return baseName + ".dll";
        #elif MACOS
        return "lib" + baseName + ".dylib";
        #else
        return "lib" + baseName + ".so";
        #endif
    }

    /// <summary>把随 exe 内嵌的 driver 写到 CEF 缓存目录并返回其路径；
    /// 没有内嵌副本或写入失败时返回 ""。
    ///
    /// 资源名自带构建指纹（"zan-drivers/&lt;fp&gt;/zan_cef.dll"，zanc 内嵌
    /// 时按字节算出），落盘目录沿用同一指纹：换了一份 exe 就是另一
    /// 个目录，因此无论缓存里还留着哪些旧 wrapper（旧的可能正被另一
    /// 个进程占着、覆盖不掉），都不会被加载到。</summary>
    static string Extract(string file) {
        List<string> names = File.EmbeddedNames("zan-drivers");
        string name = "";
        for (int i = 0; i < names.Count; i = i + 1) {
            if (names[i].EndsWith("/" + file)) { name = names[i]; break; }
        }
        if (name == "") { return ""; }
        string dir = CefRuntime.CacheRoot() + "/drivers/"
            + CefBackend.Fingerprint(name);
        Directory.CreateDirectoryRecursive(dir);
        string dest = dir + "/" + file;
        if (!File.ExtractEmbedded(name, dest)) {
            CefBackend.lastError = "内嵌的 " + file + " 无法写到 " + dest;
            return "";
        }
        return dest;
    }

    /// 内嵌资源名 "zan-drivers/&lt;fp&gt;/&lt;file&gt;" 中的 &lt;fp&gt;（构建指纹段）；
    /// 没有两段路径时为 "unknown"。
    static string Fingerprint(string name) {
        int end = name.LastIndexOf("/");
        if (end <= 0) { return "unknown"; }
        string head = name.Substring(0, end);
        int start = head.LastIndexOf("/");
        return head.Substring(start + 1, head.Length - start - 1);
    }

    /// 解析 driver 的全部导出符号到 addr_*；任一缺失即返回 false，
    /// 并把缺的符号名记进 Error()。
    static bool ResolveSymbols() {
        CefBackend.missing = "";
        CefBackend.addr_lastError = CefBackend.Sym("zan_cef_last_error");
        CefBackend.addr_ready = CefBackend.Sym("zan_cef_ready");
        CefBackend.addr_executeProcess = CefBackend.Sym("zan_cef_execute_process");
        CefBackend.addr_init = CefBackend.Sym("zan_cef_init");
        CefBackend.addr_work = CefBackend.Sym("zan_cef_work");
        CefBackend.addr_shutdown = CefBackend.Sym("zan_cef_shutdown");
        CefBackend.addr_create = CefBackend.Sym("zan_cef_create");
        CefBackend.addr_close = CefBackend.Sym("zan_cef_close");
        CefBackend.addr_alive = CefBackend.Sym("zan_cef_alive");
        CefBackend.addr_window = CefBackend.Sym("zan_cef_window");
        CefBackend.addr_setBounds = CefBackend.Sym("zan_cef_set_bounds");
        CefBackend.addr_setVisible = CefBackend.Sym("zan_cef_set_visible");
        CefBackend.addr_setClip = CefBackend.Sym("zan_cef_set_clip");
        CefBackend.addr_setFocus = CefBackend.Sym("zan_cef_set_focus");
        CefBackend.addr_navigate = CefBackend.Sym("zan_cef_navigate");
        CefBackend.addr_back = CefBackend.Sym("zan_cef_back");
        CefBackend.addr_forward = CefBackend.Sym("zan_cef_forward");
        CefBackend.addr_reload = CefBackend.Sym("zan_cef_reload");
        CefBackend.addr_stop = CefBackend.Sym("zan_cef_stop");
        CefBackend.addr_canGoBack = CefBackend.Sym("zan_cef_can_go_back");
        CefBackend.addr_canGoForward = CefBackend.Sym("zan_cef_can_go_forward");
        CefBackend.addr_isLoading = CefBackend.Sym("zan_cef_is_loading");
        CefBackend.addr_navSeq = CefBackend.Sym("zan_cef_nav_seq");
        CefBackend.addr_lastStatus = CefBackend.Sym("zan_cef_last_status");
        CefBackend.addr_lastErrorCode = CefBackend.Sym("zan_cef_last_error_code");
        CefBackend.addr_url = CefBackend.Sym("zan_cef_url");
        CefBackend.addr_title = CefBackend.Sym("zan_cef_title");
        CefBackend.addr_executeJs = CefBackend.Sym("zan_cef_execute_js");
        CefBackend.addr_cdpSend = CefBackend.Sym("zan_cef_cdp_send");
        CefBackend.addr_cdpPending = CefBackend.Sym("zan_cef_cdp_pending");
        CefBackend.addr_cdpDropped = CefBackend.Sym("zan_cef_cdp_dropped");
        CefBackend.addr_cdpAttached = CefBackend.Sym("zan_cef_cdp_attached");
        CefBackend.addr_cdpTake = CefBackend.Sym("zan_cef_cdp_take");
        CefBackend.addr_setPopupPolicy =
            CefBackend.Sym("zan_cef_set_popup_policy");
        CefBackend.addr_takePopupUrl =
            CefBackend.Sym("zan_cef_take_popup_url");
        CefBackend.addr_setZoom = CefBackend.Sym("zan_cef_set_zoom");
        CefBackend.addr_getZoom = CefBackend.Sym("zan_cef_get_zoom");
        CefBackend.addr_find = CefBackend.Sym("zan_cef_find");
        CefBackend.addr_stopFind = CefBackend.Sym("zan_cef_stop_find");
        CefBackend.addr_print = CefBackend.Sym("zan_cef_print");
        CefBackend.addr_showDevTools = CefBackend.Sym("zan_cef_show_devtools");
        CefBackend.addr_closeDevTools =
            CefBackend.Sym("zan_cef_close_devtools");
        return CefBackend.missing == "";
    }

    static string missing = "";

    /// 解析单个导出符号；缺失时记下符号名并返回 0（加载即判失败）。
    static nint Sym(string name) {
        nint a = Interop.Symbol(CefBackend.mod, name);
        if (a == 0) {
            CefBackend.missing = name;
            CefBackend.lastError = "zan_cef driver 缺少导出符号 " + name
                + "（" + CefBackend.libName + "）";
        }
        return a;
    }

    // ---------------------------------------------------------- 进程级 API

    /// <summary>本进程是 Chromium helper（render/gpu/utility）时跑完并返回
    /// 其退出码；是浏览器进程时返回 -1，调用方继续往下走。</summary>
    ///
    /// <para>注意三个参数的不对称：<paramref name="cefVersion"/> 只用于
    /// <see cref="Resolve"/> 在本进程里挑 driver 变体（109 vs 当前），不传到底层
    /// <c>zan_cef_execute_process</c>——那是个二参 C 导出（runtimeDir, switches），
    /// 版本信息已经在 <c>Resolve</c> 阶段由 driver 端 <c>cef_api_hash</c> 校验过了。
    /// 这里写三参只是为了让调用方不重复读 ready marker；保留这个签名不动，避免
    /// ABI 变更。</para>
    static int ExecuteProcess(string runtimeDir, string cefVersion,
                              string switches) {
        if (!CefBackend.Resolve(cefVersion)) { return 0 - 1; }
        CefExecuteFn f = (CefExecuteFn)CefBackend.addr_executeProcess;
        return f(runtimeDir, switches);
    }

    /// <summary>初始化 CEF 浏览器进程（driver 变体按 CEF 版本选）。
    /// </summary>
    static bool Init(string runtimeDir, string cefVersion, string cachePath,
                     string helperPath, string locale, string switches,
                     bool windowless) {
        if (!CefBackend.Resolve(cefVersion)) { return false; }
        CefInitFn f = (CefInitFn)CefBackend.addr_init;
        int wl = 0;
        if (windowless) { wl = 1; }
        return f(runtimeDir, cachePath, helperPath, locale, switches, wl) != 0;
    }

    /// CEF 浏览器进程已初始化且未 shutdown。
    static bool Ready() {
        if (!CefBackend.resolved) { return false; }
        CefIntFn f = (CefIntFn)CefBackend.addr_ready;
        return f() != 0;
    }

    /// <summary>推一轮 CEF 消息循环（每帧从宿主 UI 线程调用）。</summary>
    static void Work() {
        if (!CefBackend.resolved) { return; }
        CefVoidFn f = (CefVoidFn)CefBackend.addr_work;
        f();
    }

    /// 关闭全部浏览器并 shutdown CEF（进程退出前调用一次，不可逆）。
    static void Shutdown() {
        if (!CefBackend.resolved) { return; }
        CefVoidFn f = (CefVoidFn)CefBackend.addr_shutdown;
        f();
    }

    // ---------------------------------------------------------- 浏览器 API

    /// 以 (x,y,w,h) 在 `parent` 内创建浏览器并立即导航到 `url`，返回句柄
    /// （driver 未加载/失败为 0）。
    static int Create(nint parent, int x, int y, int w, int h, string url) {
        if (!CefBackend.resolved) { return 0; }
        CefCreateFn f = (CefCreateFn)CefBackend.addr_create;
        return f(parent, x, y, w, h, url);
    }

    /// 关闭并销毁浏览器；句柄之后失效。
    static void Close(int h) { CefBackend.CallVoid(CefBackend.addr_close, h); }

    /// 浏览器是否仍然存活（无效句柄为 false）。
    static bool Alive(int h) {
        return CefBackend.CallInt(CefBackend.addr_alive, h) != 0;
    }

    /// <summary>浏览器的原生窗口句柄（HWND / X11 Window），无则 0。
    /// </summary>
    static nint Window(int h) {
        if (!CefBackend.resolved) { return 0; }
        CefNintIntFn f = (CefNintIntFn)CefBackend.addr_window;
        return f(h);
    }

    /// 把浏览器摆到父窗口客户区坐标 (x,y,w,hh)。
    static void SetBounds(int h, int x, int y, int w, int hh) {
        if (!CefBackend.resolved) { return; }
        CefBoundsFn f = (CefBoundsFn)CefBackend.addr_setBounds;
        f(h, x, y, w, hh);
    }

    /// 显示或隐藏浏览器。
    static void SetVisible(int h, bool visible) {
        if (!CefBackend.resolved) { return; }
        CefIntIntFn f = (CefIntIntFn)CefBackend.addr_setVisible;
        f(h, visible ? 1 : 0);
    }

    /// <summary>把本帧未被遮挡的区域下发给原生窗口。签名匹配
    /// Gui.NativeClipFn，由 CefBrowser.Render 登记给 App，帧末统一回调
    /// （委托是纯函数指针，所以这里是静态方法）。</summary>
    static void ApplyClip(int h, string spec) {
        if (!CefBackend.resolved) { return; }
        CefIntStrVoidFn f = (CefIntStrVoidFn)CefBackend.addr_setClip;
        f(h, spec);
    }

    /// 把键盘焦点交给（focus=false 时收回自）浏览器。
    static void SetFocus(int h, bool focus) {
        if (!CefBackend.resolved) { return; }
        CefIntIntFn f = (CefIntIntFn)CefBackend.addr_setFocus;
        f(h, focus ? 1 : 0);
    }

    /// 导航到 URL。
    static void Navigate(int h, string url) {
        if (!CefBackend.resolved) { return; }
        CefIntStrVoidFn f = (CefIntStrVoidFn)CefBackend.addr_navigate;
        f(h, url);
    }

    /// 历史后退一页。
    static void Back(int h) { CefBackend.CallVoid(CefBackend.addr_back, h); }
    /// 历史前进一页。
    static void Forward(int h) { CefBackend.CallVoid(CefBackend.addr_forward, h); }
    /// 停止当前加载。
    static void Stop(int h) { CefBackend.CallVoid(CefBackend.addr_stop, h); }

    /// 重新加载；ignoreCache=true 绕过缓存（Ctrl+F5 语义）。
    static void Reload(int h, bool ignoreCache) {
        if (!CefBackend.resolved) { return; }
        CefIntIntFn f = (CefIntIntFn)CefBackend.addr_reload;
        f(h, ignoreCache ? 1 : 0);
    }

    /// 能否后退。
    static bool CanGoBack(int h) {
        return CefBackend.CallInt(CefBackend.addr_canGoBack, h) != 0;
    }
    /// 能否前进。
    static bool CanGoForward(int h) {
        return CefBackend.CallInt(CefBackend.addr_canGoForward, h) != 0;
    }
    /// 是否正在加载。
    static bool IsLoading(int h) {
        return CefBackend.CallInt(CefBackend.addr_isLoading, h) != 0;
    }
    /// 每次导航/源变化自增的序号（控件轮询它发现 URL/标题可能变了）。
    static int NavSeq(int h) {
        return CefBackend.CallInt(CefBackend.addr_navSeq, h);
    }
    /// 最近一次导航完成的状态码（无导航为 0）。
    static int LastStatus(int h) {
        return CefBackend.CallInt(CefBackend.addr_lastStatus, h);
    }
    /// <summary>最近一次加载失败的 CEF 错误码（成功为 0）。</summary>
    static int LastErrorCode(int h) {
        return CefBackend.CallInt(CefBackend.addr_lastErrorCode, h);
    }

    /// 当前 URL（无页面为 ""）。
    static string GetUrl(int h) {
        return CefBackend.CallStr(CefBackend.addr_url, h);
    }
    /// 当前页面标题（无页面为 ""）。
    static string GetTitle(int h) {
        return CefBackend.CallStr(CefBackend.addr_title, h);
    }

    /// <summary>在主框架里执行 JavaScript（无返回值；要取结果走 CDP 的
    /// Runtime.evaluate）。</summary>
    static void ExecuteJs(int h, string code, string scriptUrl, int startLine) {
        if (!CefBackend.resolved) { return; }
        CefJsFn f = (CefJsFn)CefBackend.addr_executeJs;
        f(h, code, scriptUrl, startLine);
    }

    // -------------------------------------------------------------- CDP

    /// <summary>发一条 CDP 命令，返回其消息 id（失败 0）。</summary>
    static int CdpSend(int h, string method, string paramsJson) {
        if (!CefBackend.resolved) { return 0; }
        CefCdpSendFn f = (CefCdpSendFn)CefBackend.addr_cdpSend;
        return f(h, method, paramsJson);
    }
    /// 队列里还没取走的 CDP 消息条数。
    static int CdpPending(int h) {
        return CefBackend.CallInt(CefBackend.addr_cdpPending, h);
    }
    /// <summary>因为 Zan 侧没有及时取走而被丢掉的消息数（队列有界）。
    /// </summary>
    static int CdpDropped(int h) {
        return CefBackend.CallInt(CefBackend.addr_cdpDropped, h);
    }
    /// DevTools 域是否已附接（CdpSend 送达的前提）。
    static bool CdpAttached(int h) {
        return CefBackend.CallInt(CefBackend.addr_cdpAttached, h) != 0;
    }
    /// <summary>取走一条 CDP 消息（结果或事件的原始 JSON），空队列为 ""。
    /// </summary>
    static string CdpTake(int h) {
        return CefBackend.CallStr(CefBackend.addr_cdpTake, h);
    }

    /// <summary>window.open / target=_blank 的处理方式：0 = CEF 自己开弹窗
    /// 窗口（默认）、1 = 拦掉、2 = 拦掉并把目标 URL 交给宿主。</summary>
    static void SetPopupPolicy(int h, int policy) {
        if (!CefBackend.resolved || CefBackend.addr_setPopupPolicy == 0) {
            return;
        }
        CefIntIntFn f = (CefIntIntFn)CefBackend.addr_setPopupPolicy;
        f(h, policy);
    }

    /// <summary>policy=2 下待处理的弹窗目标 URL，没有则 ""。</summary>
    static string TakePopupUrl(int h) {
        return CefBackend.CallStr(CefBackend.addr_takePopupUrl, h);
    }

    // ---------------------------------------------------- 缩放 / 查找 / 打印

    /// <summary>Chromium 的缩放级：0 = 100%，每 +1 乘 1.2。</summary>
    static void SetZoom(int h, double level) {
        if (!CefBackend.resolved || CefBackend.addr_setZoom == 0) { return; }
        CefZoomFn f = (CefZoomFn)CefBackend.addr_setZoom;
        f(h, level);
    }

    /// 当前缩放级（0 = 100%，每 +1 乘 1.2）。
    static double GetZoom(int h) {
        if (!CefBackend.resolved || CefBackend.addr_getZoom == 0) {
            return 0.0;
        }
        CefGetZoomFn f = (CefGetZoomFn)CefBackend.addr_getZoom;
        return f(h);
    }

    /// 页内查找：forward=false 向上、matchCase 区分大小写；findNext=false
    /// 开始新查找，true 在既有查找里继续步进。
    static void Find(int h, string text, bool forward, bool matchCase,
                     bool findNext) {
        if (!CefBackend.resolved || CefBackend.addr_find == 0) { return; }
        CefFindFn f = (CefFindFn)CefBackend.addr_find;
        f(h, text, forward ? 1 : 0, matchCase ? 1 : 0, findNext ? 1 : 0);
    }

    /// 结束页内查找；clearSelection=true 时同时清掉高亮选区。
    static void StopFind(int h, bool clearSelection) {
        if (!CefBackend.resolved || CefBackend.addr_stopFind == 0) { return; }
        CefIntIntFn f = (CefIntIntFn)CefBackend.addr_stopFind;
        f(h, clearSelection ? 1 : 0);
    }

    /// 弹出系统打印对话框，打印当前页面。
    static void Print(int h) { CefBackend.CallVoid(CefBackend.addr_print, h); }

    /// 打开本浏览器的 DevTools 窗口（CDP 附接的前提）。
    static void ShowDevTools(int h) {
        CefBackend.CallVoid(CefBackend.addr_showDevTools, h);
    }

    /// 关闭 DevTools 窗口。
    static void CloseDevTools(int h) {
        CefBackend.CallVoid(CefBackend.addr_closeDevTools, h);
    }

    // ---------------------------------------------------------- 调用小工具

    static void CallVoid(nint addr, int h) {
        if (!CefBackend.resolved || addr == 0) { return; }
        CefVoidIntFn f = (CefVoidIntFn)addr;
        f(h);
    }

    static int CallInt(nint addr, int h) {
        if (!CefBackend.resolved || addr == 0) { return 0; }
        CefIntIntRetFn f = (CefIntIntRetFn)addr;
        return f(h);
    }

    static string CallStr(nint addr, int h) {
        if (!CefBackend.resolved || addr == 0) { return ""; }
        CefStrIntFn f = (CefStrIntFn)addr;
        return f(h);
    }
}

// ---- driver 入口点的委托签名（与 native/zan_cef.c 的导出一一对应）----

delegate void CefVoidFn();
delegate int CefIntFn();
delegate string CefStrFn();
delegate int CefIntStrFn(string s);
delegate int CefExecuteFn(string runtimeDir, string switches);
delegate int CefInitFn(string runtimeDir, string cachePath, string helperPath,
                       string locale, string switches, int windowless);
delegate int CefCreateFn(nint parent, int x, int y, int w, int h, string url);
delegate void CefVoidIntFn(int h);
delegate int CefIntIntRetFn(int h);
delegate string CefStrIntFn(int h);
delegate nint CefNintIntFn(int h);
delegate void CefIntIntFn(int h, int v);
delegate void CefIntStrVoidFn(int h, string s);
delegate void CefBoundsFn(int h, int x, int y, int w, int hh);
delegate void CefJsFn(int h, string code, string scriptUrl, int startLine);
delegate int CefCdpSendFn(int h, string method, string paramsJson);
delegate void CefZoomFn(int h, double level);
delegate double CefGetZoomFn(int h);
delegate void CefFindFn(int h, string text, int forward, int matchCase,
                        int findNext);
