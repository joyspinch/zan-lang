using System;
using Gui;

namespace Gui.Component.CefBrowser;

/// 弹窗请求交给宿主时的回调（参数是要打开的 URL）。
delegate void CefPopupFn(string url);

/// 内嵌的 Chromium 浏览器（CEF）视图。
///
/// 和 Gui.Component.WebView 的分工：WebView 用系统自带引擎（Windows
/// WebView2 / macOS WKWebView），装机即用但能力受系统摆布；CefBrowser 自带
/// Chromium——完整的 H.264/AAC 媒体栈、统一的行为、CDP（Chrome DevTools
/// Protocol）自动化通道，代价是首次运行要下载官方 CEF 运行时
/// （<see cref="CefRuntime"/> 负责，按系统挑分支：Win7/8/8.1 用 109，
/// 其余用最新 stable）。两者独立并存，按需选用。
///
/// 原生浏览器窗口是浮在软件渲染表面之上的兄弟图层，因此要由所属区域
/// 每帧驱动它（和 WebView 一致）：
///   CefBrowser web = new CefBrowser();
///   web.NavComplete += () => { ... };
///   web.Navigate("https://example.com");
///   // 每帧，针对可见标签：
///   web.Render(app, x, y, w, h);
///   // 每帧，针对隐藏标签：
///   web.Hide();
///
/// 进程级初始化在 <see cref="CefBootstrap"/>：Main 首句
/// CefBootstrap.RunHelper()、之后 await CefBootstrap.StartAsync()。没启动成功时
/// IsSupported() 为 false，Render 画一个画布内占位符（说明原因），而不是崩掉。
class CefBrowser {
    #if WINDOWS
    /// 原生浏览器是宿主窗口的子 HWND，被点中时 Win32 键盘焦点就落在它上面，
    /// 此后所有按键都进 Chromium——宿主窗口再也收不到 WM_CHAR，界面上的
    /// 输入框（浏览器的地址栏就是一个）便无法输入。焦点交回宿主窗口要走
    /// Win32，CEF 自己的 set_focus 只管引擎内部。
    [DllImport("user32", EntryPoint = "SetFocus")]
    static extern nint Win32SetFocus(nint hwnd);
    [DllImport("user32", EntryPoint = "GetFocus")]
    static extern nint Win32GetFocus();
    #endif

    int handle;         // 原生浏览器句柄（0 = 尚未创建/不可用）
    bool created;       // 已尝试原生创建
    bool supported;     // 原生侧给出了可用的浏览器
    int lastNavSeq;     // 最近观察到的导航计数器
    string pendingUrl;  // 原生创建前请求的导航
    /// 上一帧界面上是否有控件持有键盘焦点（用于只在切换的那一刻搬焦点，
    /// 而不是每帧从浏览器手里抢，否则页面里就没法打字了）。
    bool guiHadFocus;

    string lastSeenTitle;
    bool lastSeenLoading;
    /// CDP 路由/Cookie 门面，第一次被要到时才建（没人用就没有额外开销）。
    CefCdp cdpRouter;
    /// 弹窗策略与宿主回调（policy 2 时每帧从原生侧取待处理的目标 URL）。
    int popupPolicy;
    CefPopupFn popupSink;
    CefCookies cookieApi;
    CefPage pageApi;
    CefFingerprint fpApi;

    SignalString url;
    SignalString title;

    /// 导航完成（或失败）时触发，即当前 URL/标题可能已变化。
    /// 响应式 Url()/Title() 会在其触发前更新。
    UiEvent NavComplete;
    /// 主框架开始加载时触发。
    UiEvent NavStart;
    /// 文档标题变化时触发，包括页面内的更新。
    UiEvent TitleChanged;
    /// 加载开始或结束时触发（IsLoading() 指示是哪种）。
    UiEvent LoadingChanged;

    /// 全默认状态：未创建、乐观地假定 CEF 可用。
    CefBrowser() {
        this.handle = 0;
        this.created = false;
        this.supported = true;
        this.lastNavSeq = 0;
        this.pendingUrl = "";
        this.guiHadFocus = false;
        this.lastSeenTitle = "";
        this.lastSeenLoading = false;
        this.cdpRouter = null;
        this.popupPolicy = 0;
        this.popupSink = null;
        this.cookieApi = null;
        this.pageApi = null;
        this.fpApi = null;
        this.url = new SignalString("");
        this.title = new SignalString("");
        this.NavComplete = new UiEvent();
        this.NavStart = new UiEvent();
        this.TitleChanged = new UiEvent();
        this.LoadingChanged = new UiEvent();
    }

    /// 原生浏览器可用（CEF 已启动且这个视图创建成功）时为 true。
    /// 首帧之前它是乐观的 true——创建发生在第一次 Render。
    bool IsSupported() { return supported; }

    /// 原生句柄（0 = 尚未创建）。
    int Handle() { return handle; }

    /// 响应式当前 URL/文档标题（每次导航后更新）。
    SignalString Url() { return url; }
    /// 响应式当前文档标题（每次导航后更新）。
    SignalString Title() { return title; }
    /// 当前 URL 的字符串形式。
    string CurrentUrl() { return url.Get(); }
    /// 当前文档标题的字符串形式。
    string CurrentTitle() { return title.Get(); }

    /// 首次 Render 时创建原生浏览器（用的是首帧矩形与挂起的 URL）。
    /// CEF 尚未启动时不标记 created，下一帧重试——「运行时下载完成后
    /// 自动出现」依赖这一点；创建失败则永久回退占位符。
    void EnsureCreated(App app, int x, int y, int w, int h) {
        if (created) { return; }
        if (!CefHost.IsRunning()) {
            // CEF 还没起来（宿主没调 CefHost.StartAsync，或运行时下载失败）：
            // 不标记 created，下一帧再试，这样“下载完成后自动出现”成立。
            supported = false;
            return;
        }
        created = true;
        handle = CefBackend.Create(app.window.GetHandle(), x, y, w, h,
        pendingUrl);
        if (handle == 0) {
            supported = false;
            return;
        }
        supported = true;
        pendingUrl = "";
        if (popupPolicy != 0) {
            CefBackend.SetPopupPolicy(handle, popupPolicy);
        }
    }

    /// 导航到 URL。无协议的裸主机名视为 https://。
    void Navigate(string target) {
        string u = CefBrowser.Normalize(target);
        if (handle == 0) {
            pendingUrl = u;
            return;
        }
        CefBackend.Navigate(handle, u);
    }

    /// 加载内存中的 HTML 字符串（走 data: URL，因此适合中小片段）。
    void LoadHtml(string html) {
        Navigate("data:text/html;charset=utf-8," + CefBrowser.UrlEscape(html));
    }

    /// 历史后退一页（未创建为空操作）。
    void Back() { if (handle != 0) { CefBackend.Back(handle); } }
    /// 历史前进一页。
    void Forward() { if (handle != 0) { CefBackend.Forward(handle); } }
    /// 停止当前加载。
    void Stop() { if (handle != 0) { CefBackend.Stop(handle); } }
    /// 重新加载当前页（走缓存）。
    void Reload() { if (handle != 0) { CefBackend.Reload(handle, false); } }
    /// 忽略缓存的强制刷新（Ctrl+F5）。
    void ReloadIgnoreCache() {
        if (handle != 0) { CefBackend.Reload(handle, true); }
    }

    /// 能否后退（未创建为 false）。
    bool CanGoBack() {
        if (handle == 0) { return false; }
        return CefBackend.CanGoBack(handle);
    }
    /// 能否前进（未创建为 false）。
    bool CanGoForward() {
        if (handle == 0) { return false; }
        return CefBackend.CanGoForward(handle);
    }
    /// 是否正在加载（未创建为 false）。
    bool IsLoading() {
        if (handle == 0) { return false; }
        return CefBackend.IsLoading(handle);
    }

    /// 最近一次主框架响应的 HTTP 状态码（无响应或非 HTTP 时为 0）。
    int LastStatus() {
        if (handle == 0) { return 0; }
        return CefBackend.LastStatus(handle);
    }

    /// 最近一次加载失败的 CEF 错误码（成功为 0）。
    int LastErrorCode() {
        if (handle == 0) { return 0; }
        return CefBackend.LastErrorCode(handle);
    }

    /// 在页面里执行 JavaScript（不取返回值）。要拿结果用
    /// <see cref="Evaluate"/>（走 CDP）。
    void ExecuteJs(string code) {
        if (handle != 0) { CefBackend.ExecuteJs(handle, code, "", 0); }
    }

    /// 键盘焦点交给/收回浏览器。
    void SetFocus(bool focus) {
        if (handle != 0) { CefBackend.SetFocus(handle, focus); }
    }

    /// 每帧跟随界面焦点：界面上有控件拿到键盘焦点（点了地址栏）的那一刻，
    /// 把 Win32 焦点从浏览器子窗口搬回宿主窗口；焦点被清掉（Esc / 点空白）
    /// 的那一刻交还给浏览器。只在切换沿动作，页面内的点击因此照旧把焦点
    /// 拿回去，网页里能正常打字。
    /// 另外，界面持有焦点期间每帧确认 Win32 焦点确实还在宿主窗口上：
    /// Chromium 会自己把焦点抢回去（导航提交、页面调 focus()、子进程重启），
    /// 只在切换沿搬一次的话，地址栏看着还在编辑态、按键却全进了页面——这正是
    /// “地址栏时好时坏”的成因。原生侧同时拒掉 CEF 主动要焦点的请求
    /// （cef_focus_handler_t::on_set_focus），这里是兜底。
    void SyncFocus(App app) {
        if (handle == 0) { return; }
        bool gui = app.focus.focusedId >= 0;
        if (gui != guiHadFocus) {
            guiHadFocus = gui;
            CefBackend.SetFocus(handle, !gui);
        }
        if (!gui) { return; }
        #if WINDOWS
        nint host = app.window.GetHandle();
        if (CefBrowser.Win32GetFocus() != host) {
            CefBrowser.Win32SetFocus(host);
        }
        #endif
    }

    // ---- CDP（Chrome DevTools Protocol）----------------------------------

    /// 发一条 CDP 命令，返回其消息 id（失败 0）。回复和事件从
    /// <see cref="TakeCdpMessage"/> 取，因此调用是异步的：
    ///   int id = web.SendCdp("Page.captureScreenshot", "{}");
    ///   // 之后的帧里
    ///   string msg = web.TakeCdpMessage();
    int SendCdp(string method, string paramsJson) {
        if (handle == 0) { return 0; }
        return CefBackend.CdpSend(handle, method, paramsJson);
    }

    /// 用 CDP 求值一个 JavaScript 表达式，返回其消息 id：结果会以
    /// Runtime.evaluate 的回复出现在 <see cref="TakeCdpMessage"/> 里。
    int Evaluate(string expression) {
        return SendCdp("Runtime.evaluate",
        "{\"expression\":" + CefBrowser.JsonString(expression)
        + ",\"returnByValue\":true}");
    }

    /// 队列里待取的 CDP 消息数。
    int CdpPending() {
        if (handle == 0) { return 0; }
        return CefBackend.CdpPending(handle);
    }

    /// 因为迟迟没被取走而丢掉的 CDP 消息数（队列有界，防止跑飞的页面
    /// 事件把内存吃光）。
    int CdpDropped() {
        if (handle == 0) { return 0; }
        return CefBackend.CdpDropped(handle);
    }

    /// CDP 通道已挂上（DevTools agent 已附着）。
    bool CdpAttached() {
        if (handle == 0) { return false; }
        return CefBackend.CdpAttached(handle);
    }

    /// 缩放级别：0 = 100%，每 +1 乘 1.2（Ctrl+滚轮的那一档），可为负。
    void SetZoom(double level) {
        if (handle != 0) { CefBackend.SetZoom(handle, level); }
    }
    /// 当前缩放级（未创建为 0）。
    double Zoom() {
        if (handle == 0) { return 0.0; }
        return CefBackend.GetZoom(handle);
    }
    /// 放大一档。
    void ZoomIn() { SetZoom(Zoom() + 1.0); }
    /// 缩小一档。
    void ZoomOut() { SetZoom(Zoom() - 1.0); }
    /// 回到 100%。
    void ResetZoom() { SetZoom(0.0); }

    /// 页内查找并高亮。第一次调用 findNext 传 false（开一次新搜索），之后
    /// 传 true 在同一批命中之间前后跳；<see cref="StopFind"/> 收尾。
    void Find(string text, bool forward, bool matchCase, bool findNext) {
        if (handle != 0) {
            CefBackend.Find(handle, text, forward, matchCase, findNext);
        }
    }
    /// 结束 <see cref="Find"/>：clearSelection=true 同时清掉高亮选区。
    void StopFind(bool clearSelection) {
        if (handle != 0) { CefBackend.StopFind(handle, clearSelection); }
    }

    /// 打开系统打印对话框。要无对话框地导出 PDF 用
    /// `Cdp().Send("Page.printToPDF", ...)`（回调里拿到 base64 的字节）。
    void Print() { if (handle != 0) { CefBackend.Print(handle); } }

    /// DevTools 开/关（CEF 自己的窗口）。
    void ShowDevTools() {
        if (handle != 0) { CefBackend.ShowDevTools(handle); }
    }
    /// 关闭 DevTools 窗口。
    void CloseDevTools() {
        if (handle != 0) { CefBackend.CloseDevTools(handle); }
    }

    /// 弹窗（window.open / target=_blank / 中键点击）交给 CEF 自己开一个
    /// 独立的浏览器窗口——默认行为。
    void AllowPopupWindows() { SetPopupPolicy(0, null); }

    /// 一律不开弹窗（页面里的 window.open 返回 null）。
    void BlockPopups() { SetPopupPolicy(1, null); }

    /// 弹窗不再自己开窗口，改为把目标 URL 交给宿主：标签式外壳在这里
    /// 新建一个标签，单页外壳可以直接 <see cref="Navigate"/>。回调在
    /// <see cref="Render"/> 里（UI 线程）被调用。
    void OnPopup(CefPopupFn handler) { SetPopupPolicy(2, handler); }

    /// 直接设置弹窗策略（0 = CEF 自开 / 1 = 拦掉 / 2 = 交宿主回调）；
    /// 一般经 AllowPopupWindows / BlockPopups / OnPopup 使用。
    void SetPopupPolicy(int policy, CefPopupFn handler) {
        popupPolicy = policy;
        popupSink = handler;
        if (handle != 0) { CefBackend.SetPopupPolicy(handle, policy); }
    }

    /// 取走一条 CDP 消息（命令回复或事件的原始 JSON），空队列为 ""。
    string TakeCdpMessage() {
        if (handle == 0) { return ""; }
        return CefBackend.CdpTake(handle);
    }

    /// 按事件名订阅 CDP 事件 / 给命令挂回调的路由（首次调用时建）。
    /// 拿到它之后，<see cref="Render"/> 每帧把消息队列交给它分派，
    /// 此时不要再直接用 <see cref="TakeCdpMessage"/>。
    CefCdp Cdp() {
        if (cdpRouter == null) { cdpRouter = new CefCdp(this); }
        return cdpRouter;
    }

    /// Cookie 读写（走 CDP，第一次调用时建）。
    CefCookies Cookies() {
        if (cookieApi == null) { cookieApi = new CefCookies(Cdp()); }
        return cookieApi;
    }

    /// 页面级钩子：下载、JS 对话框、console、网络（走 CDP）。
    CefPage Page() {
        if (pageApi == null) { pageApi = new CefPage(Cdp()); }
        return pageApi;
    }

    /// 指纹套用：UA/Client Hints、语言、时区、屏幕、WebGL、canvas 噪声。
    /// 填好字段后调 <see cref="CefFingerprint.Apply"/>；注入的补丁对下一个
    /// 文档生效，所以对已经打开的页要再 <see cref="Reload"/> 一次。
    CefFingerprint Fingerprint() {
        if (fpApi == null) { fpApi = new CefFingerprint(Cdp()); }
        return fpApi;
    }

    // ---- 生命周期 --------------------------------------------------------

    /// 隐藏原生窗口（对不在屏幕上的标签/面板调用）。
    void Hide() {
        if (handle != 0) { CefBackend.SetVisible(handle, false); }
    }

    /// 关闭浏览器并释放原生资源。
    ///
    /// CEF 的关闭是异步的：close_browser 之后还要靠消息循环转几圈才真正
    /// 销毁原生窗口，而这个视图从此不再 Render，没人再推循环——只 Close
    /// 就撒手的话，关掉的标签留下的 Chromium 子窗口会一直挂在宿主窗口上
    /// 盖住其他控件。因此原生侧先把窗口隐藏（立刻不再挡人），这里再当场
    /// 把循环推到它消失为止（有上限，别让病态页面把 UI 线程卡死；没推完
    /// 的收尾由后续帧或 CefHost.Shutdown 兜底）。
    void Destroy() {
        if (handle != 0) {
            NativeLayer.Forget(handle);
            CefBackend.Close(handle);
            for (int i = 0; i < 64; i = i + 1) {
                if (!CefBackend.Alive(handle)) { break; }
                CefHost.Work();
            }
        }
        handle = 0;
        created = false;
    }

    /// 把原生浏览器放到给定的客户区矩形里，推一轮 CEF 消息循环，然后
    /// 轮询引擎的变化，更新 Url()/Title() 并触发
    /// NavStart / LoadingChanged / TitleChanged / NavComplete。浏览器跑在
    /// 自己的进程/线程上，因此它的事件以这种每帧差异的形式到达 UI。
    /// CEF 不可用时画一个占位符（说明原因）。
    int Render(App app, int x, int y, int w, int h) {
        EnsureCreated(app, x, y, w, h);
        if (handle == 0) {
            CefBrowser.PaintPlaceholder(app, x, y, w, h);
            return 0;
        }
        // Chromium 的 UI 线程就是宿主线程（single-process message loop），
        // 所以每帧必须推它一轮，否则页面不动。
        CefHost.Work();
        CefBackend.SetBounds(handle, x, y, w, h);
        // 可见性不在这里定：原生窗口是 OS 兄弟层，永远画在画布之上，直接
        // 显示就会把右键菜单、下拉、模态对话框一起盖住。改为向 App 登记
        // 本帧占位，由 PresentFrame 在所有自绘 UI 之后算出未被遮挡的
        // 区域再下发（完全被盖住时隐藏）。
        NativeLayer.Register(app, handle, x, y, w, h, CefBackend.ApplyClip);
        SyncFocus(app);

        if (cdpRouter != null) { cdpRouter.Pump(); }
        if (popupPolicy == 2 && popupSink != null) {
            string popup = CefBackend.TakePopupUrl(handle);
            if (popup != "") { popupSink(popup); }
        }

        bool dirty = false;
        bool busy = CefBackend.IsLoading(handle);
        if (busy != lastSeenLoading) {
            lastSeenLoading = busy;
            if (busy) { NavStart.Raise(); }
            LoadingChanged.Raise();
            dirty = true;
        }

        int seq = CefBackend.NavSeq(handle);
        if (seq != lastNavSeq) {
            lastNavSeq = seq;
            url.Set(CefBackend.GetUrl(handle));
            title.Set(CefBackend.GetTitle(handle));
            NavComplete.Raise();
            dirty = true;
        }
        string docTitle = CefBackend.GetTitle(handle);
        if (docTitle != lastSeenTitle) {
            lastSeenTitle = docTitle;
            title.Set(docTitle);
            TitleChanged.Raise();
            dirty = true;
        }
        // 浏览器画面变化不会经过 Zan 的重绘逻辑，但原生窗口是自己刷新的，
        // 这里只在有语义变化时请求重绘（省电）。
        if (dirty) { app.RequestRedraw(); }
        // Chromium 的消息循环只在本方法里被推，而事件循环空闲时会阻塞在
        // WaitEvent 上——没有这一句，鼠标一停页面就冻住（加载中的页面停在
        // 半张，标题/导航事件也要等下一次输入才到）。所以只要浏览器还活着
        // 就预约下一帧：加载中密一点，空闲时降到约 30 Hz，并把重绘范围声明
        // 成浏览器这块矩形（原生窗口自己刷新，画布这块几乎没有开销）。
        int next = 30;
        if (busy) { next = 8; }
        app.RequestAnimationFrameIn(next, x, y, w, h);
        return handle;
    }

    /// CEF 不可用时的画布内占位：图标加一行说明文字。
    static void PaintPlaceholder(App app, int x, int y, int w, int h) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        StyleBox s = Style.Part(app, "cef", "placeholder", "", "",
        "", Style.SNormal());
        StyleBox icon = Style.Part(app, "cef", "icon", "", "",
        "", Style.SNormal());
        StyleBox label = Style.Part(app, "cef", "label", "", "",
        "", Style.SNormal());
        c.FillRect(x, y, w, h, s.BgOr(0));
        c.DrawRect(x, y, w, h, s.BorderOr(0), t.borderWidth);
        c.DrawGlyphIn("globe", x, y - app.Scale(28), w, h, t.iconSizeLarge,
        icon.FgOr(0));
        c.DrawTextCentered(x, y + app.Scale(18), w, h,
        CefBrowser.PlaceholderText(), label.FgOr(0), Style.FontFallback(app, "medium"));
    }

    /// 占位符文案：优先给出 CefHost 记下的失败原因，否则提示启动步骤。
    static string PlaceholderText() {
        string err = CefHost.Error();
        if (err != "") { return err; }
        return "CEF 未启动：Main 里先 CefBootstrap.RunHelper()"
        + " 再 await CefBootstrap.StartAsync()";
    }

    /// 导航目标补全：没有协议前缀的裸地址加 `https://`。
    static string Normalize(string target) {
        if (target == "") { return ""; }
        if (CefBrowser.HasScheme(target)) { return target; }
        return "https://" + target;
    }

    /// 是否带协议前缀（"://"，或 data:/about: 这类无 // 的 scheme）。
    static bool HasScheme(string s) {
        int n = s.Length;
        for (int i = 0; i + 2 < n; i = i + 1) {
            if (s[i] == ':' && s[i + 1] == '/' && s[i + 2] == '/') { return true; }
        }
        if (s.StartsWith("data:")) { return true; }
        if (s.StartsWith("about:")) { return true; }
        return false;
    }

    /// data: URL 里必须转义的字符（其余按 UTF-8 原样传，Chromium 接受）。
    static string UrlEscape(string s) {
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < s.Length; i = i + 1) {
            int c = s[i] & 255;
            if (c == 35) { sb.Append("%23"); }
            else if (c == 37) { sb.Append("%25"); }
            else if (c == 38) { sb.Append("%26"); }
            else if (c == 63) { sb.Append("%3F"); }
            else if (c == 32) { sb.Append("%20"); }
            else { sb.Append(s.Substring(i, 1)); }
        }
        return sb.ToString();
    }

    /// 把字符串包成 JSON 字面量（CDP 参数拼装用）。
    ///
    /// 控制字符按 JSON 规范用 `\u00XX` 转义，而不是像以前那样静默换成空格——
    /// 旧行为会让 NUL / 0x01-0x1F 被吃掉、CDF 收到的 expression 是错的。
    static string JsonString(string s) {
        StringBuilder sb = new StringBuilder();
        sb.Append("\"");
        for (int i = 0; i < s.Length; i = i + 1) {
            int c = s[i] & 255;
            if (c == 34) { sb.Append("\\\""); }
            else if (c == 92) { sb.Append("\\\\"); }
            else if (c == 10) { sb.Append("\\n"); }
            else if (c == 13) { sb.Append("\\r"); }
            else if (c == 9) { sb.Append("\\t"); }
            else if (c < 32) { sb.Append("\\u00"); sb.Append(CefBrowser.HexDigit((c >> 4) & 15)); sb.Append(CefBrowser.HexDigit(c & 15)); }
            else { sb.Append(s.Substring(i, 1)); }
        }
        sb.Append("\"");
        return sb.ToString();
    }

    /// 数字 0-15 转小写十六进制字符（JSON 转义用）。
    static string HexDigit(int n) {
        if (n < 10) { return Convert.ToString(n); }
        if (n == 10) { return "a"; }
        if (n == 11) { return "b"; }
        if (n == 12) { return "c"; }
        if (n == 13) { return "d"; }
        if (n == 14) { return "e"; }
        return "f";
    }
}
