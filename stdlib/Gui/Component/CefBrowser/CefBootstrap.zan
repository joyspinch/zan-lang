using System;
using System.Diagnostics;
using System.Net.Http.Download;
using Gui.Component.Downloader;

namespace Gui.Component.CefBrowser;

/// <summary>
/// CEF 的启动入口：把「运行时自举（<see cref="CefRuntime"/>）」和「进程
/// 初始化（<see cref="CefHost"/>）」接在一起，再加上 Chromium helper 子进程
/// 的分发。
///
/// Chromium 是多进程的：除浏览器进程外还要有 render/gpu/utility 子进程。
/// 默认让程序把自己当 helper 重新执行（browser_subprocess_path = 本程序），
/// 因此 **Main 的第一件事** 必须是让 helper 分支跑完并退出：
///
/// <code>
/// async int Main() {
///     CefBootstrap.RunHelper();              // helper 进程在这里就退出了
///     if (!await CefBootstrap.StartAsync()) { // 首次会下载官方 CEF 运行时
///         Console.WriteLine(CefHost.Error());
///         return 1;
///     }
///     App app = new App("browser", 1280, 800);
///     CefBrowserBox box = new CefBrowserBox();
///     box.SetStartUrl("https://example.com");
///     app.root.Add(box);
///     app.Show();                            // 每帧由 CefBrowser.Render 推循环
///     CefHost.Shutdown();
///     return 0;
/// }
/// </code>
///
/// 想避免「主程序被当 helper 再跑一遍」，用
/// <see cref="StartAsyncWithHelper"/> 指定一个独立的 helper 可执行文件。
/// </summary>
class CefBootstrap {
    [DllImport("crt", EntryPoint = "exit")]
    static extern void CrtExit(int code);

    /// <summary>本进程若是 Chromium helper（render/gpu/utility），跑完它的
    /// 消息循环并直接退出进程（不返回）；是浏览器进程时什么都不做。
    /// 必须是 Main 的第一句：Chromium 用同一个可执行文件启动子进程，
    /// helper 分支不能走到宿主程序自己的逻辑里。
    ///
    /// <para>配置继承：helper 进程是 <c>exec</c> 出来的新进程，<see cref="CefOptions"/>
    /// 那个进程内静态状态（<c>current</c>）在父进程设的 <c>Use(...)</c> 不会被
    /// helper 看到。helper 走的是环境变量 / 浏览器进程透传的 ENV：
    /// <c>ZAN_CEF_RUNTIME</c> / <c>ZAN_CEF_PROFILE</c> / <c>ZAN_CEF_CACHE</c> /
    /// <c>ZAN_CEF_DRIVER</c> / <c>ZAN_CEF_SWITCHES</c> / <c>ZAN_CEF_LOCALE</c> /
    /// <c>ZAN_CEF_HELPER</c> / <c>ZAN_CEF_DOWNLOAD_UI</c> / <c>ZAN_CEF_NO_DCOMP</c> /
    /// <c>ZAN_CEF_MIRROR</c> / <c>ZAN_CEF_ARCHIVE</c>，再加上浏览器进程
    /// <c>zc_export_helper_env</c> 在子进程起来前 <c>setenv</c> 的
    /// <c>ZAN_CEF_HELPER_RUNTIME/SWITCHES/DRIVER</c>（macOS/Linux 有效；
    /// Windows helper 就是自己，不需要这三条）。</para></summary>
    static void RunHelper() {
        string dir = CefBootstrap.LocalRuntimeDir();
        if (dir == "") { return; }
        int code = CefBackend.ExecuteProcess(dir, CefHost.MarkerVersion(dir),
                                            CefOptions.Switches());
        if (code >= 0) { CefBootstrap.CrtExit(code); }
    }

    /// <summary>不联网地找出本机已装好的运行时目录（helper 进程用；
    /// <see cref="CefOptions.runtimeDir"/> / ZAN_CEF_RUNTIME 可显式指定）。
    /// </summary>
    static string LocalRuntimeDir() {
        string forced = CefOptions.RuntimeDir();
        if (forced != "") { return forced; }
        return CefRuntime.Installed();
    }

    /// <summary>确保本机有 CEF 运行时（首次会按系统版本从官方 CDN 下载并
    /// 校验，几百 MB），然后初始化浏览器进程。已启动时直接返回 true；
    /// 首次需要运行时下载时默认自动显示独立的
    /// <see cref="DownloadDialog"/> 进度窗。无 GUI 宿主可通过
    /// <see cref="CefOptions.downloadUi"/> 关闭它，窗口创建失败也会回退到
    /// 静默自举路径；失败原因见 <see cref="CefHost.Error"/>。</summary>
    static async bool StartAsync() {
        return await CefBootstrap.StartAsyncWithHelper("");
    }

    /// <summary>同 <see cref="StartAsync"/>，但先应用一份
    /// <see cref="CefOptions"/>（运行时/缓存/profile/driver 路径、Chromium
    /// 开关、语言、helper）。helper 子进程也要按同一份配置找运行时，
    /// 因此应用自己拿不到默认位置时，<see cref="CefOptions.Use"/> 要在
    /// <see cref="RunHelper"/> 之前调，而不是只依赖这个重载。</summary>
    static async bool StartAsyncWith(CefOptions options) {
        CefOptions.Use(options);
        return await CefBootstrap.StartAsyncWithHelper("");
    }

    /// <summary>同 <see cref="StartAsync"/>，但用 <paramref name="helperPath"/>
    /// 作为 Chromium 子进程的可执行文件（""=复用本程序，此时 Main 首句必须
    /// 调用 <see cref="RunHelper"/>）。</summary>
    static async bool StartAsyncWithHelper(string helperPath) {
        if (CefHost.IsRunning()) { return true; }
        string dir = CefBootstrap.LocalRuntimeDir();
        if (dir == "") {
            if (CefOptions.DownloadUi()) {
                DownloadJob job = CefBootstrap.NewRuntimeJob();
                DownloadDialog dialog = null;
                try {
                    dialog = DownloadDialog.OpenStandalone(
                        "正在准备浏览器运行时", job);
                } catch (Exception) {
                    // 无显示器时仅回退到下面的静默自举路径。
                }
                if (dialog != null) {
                    dialog.SetIntro("首次运行会从官方 CDN 下载浏览器运行时，"
                        + "安装到用户级缓存后以后不再下载。");
                    job.Start();
                    bool done = await dialog.RunStandalone();
                    if (!done) {
                        string detail = CefRuntime.EnsureJobError(job);
                        dialog.SetIntro(detail);
                        dialog.WaitStandaloneClose();
                        CefHost.Fail("CEF 运行时自举失败："
                            + detail);
                        return false;
                    }
                    return CefBootstrap.FinishStart(helperPath);
                }
            }
            dir = await CefRuntime.EnsureAsync();
        }
        if (dir == "") {
            CefHost.Fail("CEF 运行时自举失败：" + CefRuntime.Error());
            return false;
        }
        return CefHost.Start(dir, helperPath);
    }

    /// <summary>带进度界面的自举：把运行时下载做成一个通用
    /// <see cref="DownloadJob"/>，宿主用 <see cref="DownloadDialog"/> 显示进度，
    /// 任务收工后再调 <see cref="FinishStart"/> 起浏览器进程。已经装好时任务
    /// 什么都不下、直接以“已完成”收工，所以这条路可以无条件走：
    ///
    /// <code>
    /// DownloadJob job = CefBootstrap.NewRuntimeJob();
    /// job.Start();
    /// DownloadDialog dlg = DownloadDialog.Show(app, "正在准备浏览器运行时", job);
    /// // …任务 Succeeded() 之后：
    /// CefBootstrap.FinishStart("");
    /// </code>
    ///
    /// 和 <see cref="StartAsync"/> 的分工：这条路给界面已经在跑的宿主用，
    /// 而 <see cref="StartAsync"/> 在主窗口创建前也会自动采用独立进度窗。
    /// 首次下载几百 MB 时窗口照旧响应，关掉窗口也不打断下载；无 GUI 宿主
    /// 可关闭 <see cref="CefOptions.downloadUi"/> 或依赖启动失败时的静默
    /// 回退。</summary>
    static DownloadJob NewRuntimeJob() {
        return CefRuntime.NewEnsureJob();
    }

    /// <summary><see cref="NewRuntimeJob"/> 的任务成功后初始化浏览器进程；
    /// 失败原因见 <see cref="CefHost.Error"/>。</summary>
    static bool FinishStart(string helperPath) {
        if (CefHost.IsRunning()) { return true; }
        string dir = CefBootstrap.LocalRuntimeDir();
        if (dir == "") { dir = CefRuntime.EnsuredDir(); }
        if (dir == "") {
            CefHost.Fail("CEF 运行时自举失败：" + CefRuntime.Error());
            return false;
        }
        return CefHost.Start(dir, helperPath);
    }

    /// <summary>当前下载进度（"已收/总计" 字节），未在下载时为 ""。
    /// 首次启动要拉几百 MB，宿主可以用它做进度显示。</summary>
    static string Progress(string archiveFileName) {
        return CefRuntime.Progress(archiveFileName);
    }
}
