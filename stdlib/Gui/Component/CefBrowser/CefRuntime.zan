using System;
using System.IO;
using System.IO.Compression;
using System.Json;
using System.Diagnostics;
using System.Management;
using System.Net.Http.Client;
using System.Security.Cryptography;
using System.Net.Http.Download;

namespace Gui.Component.CefBrowser;

/// <summary>镜像基址解析结果。</summary>
class CefHttpEndpoint {
    string host;
    int port;
    bool tls;
    string prefix;

    CefHttpEndpoint() {
        this.host = "";
        this.port = 0;
        this.tls = false;
        this.prefix = "";
    }
}

/// <summary>CEF 官方构建索引里的一个归档条目。</summary>
class CefArchive {
    /// <summary>完整 CEF 版本，如
    /// "109.1.18+gf1c41e4+chromium-109.0.5414.120"。</summary>
    public string cefVersion;
    /// <summary>对应的 Chromium 版本。</summary>
    public string chromiumVersion;
    /// <summary>官方平台标识，如 "windows64"。</summary>
    public string platform;
    /// <summary>归档文件名（.tar.bz2）。</summary>
    public string fileName;
    /// <summary>官方给出的 SHA-1（小写十六进制）。</summary>
    public string sha1;
    /// <summary>归档字节数。</summary>
    public long size;

    CefArchive() {
        this.cefVersion = "";
        this.chromiumVersion = "";
        this.platform = "";
        this.fileName = "";
        this.sha1 = "";
        this.size = 0;
    }

    /// <summary>该归档的请求路径（"+" 已按 URL 规则转义）。</summary>
    string Path() {
        return "/" + CefRuntime.UrlEncode(this.fileName);
    }
}

/// <summary>本地 CEF 运行时的自举：探测平台与应当使用的 CEF 主版本、
/// 优先按内置钉版本表选择归档，必要时从官方或镜像索引兜底、
/// 下载（可断点续传）并按官方 SHA-1 校验归档、
/// 解压到本地缓存并打上就绪标记，最后给出稳定的运行时目录，供原生
/// zan_cef driver 加载 libcef。
///
/// 版本策略：Windows 7/8/8.1 只能用 CEF 109（最后一个支持它们的分支），
/// 其他系统用当前绑定的 stable。运行时二进制不入库，只落在用户缓存目录。
///
/// 用法：
/// <code>
/// string dir = await CefRuntime.EnsureAsync();
/// if (dir == "") { Console.WriteLine(CefRuntime.Error()); }
/// </code>
/// </summary>
class CefRuntime {
    /// <summary>官方构建索引所在主机。</summary>
    static string IndexHost() { return "cef-builds.spotifycdn.com"; }

    /// <summary>索引路径。</summary>
    static string IndexPath() { return "/index.json"; }

    /// <summary>使用的归档类型：包含 include/、libcef_dll/、Release/、
    /// Resources/，但不含调试符号与静态库，足够构建
    /// libcef_dll_wrapper 并运行。</summary>
    static string ArchiveType() { return "minimal"; }

    /// <summary>就绪标记文件名，内容为已安装的 CEF 版本（与只依赖
    /// Interop 的 CefHost 共用同一个名字）。</summary>
    static string ReadyMarker() { return CefHost.ReadyMarker(); }

    static string lastError;

    /// <summary>最近一次失败的原因，成功时为 ""。</summary>
    static string Error() {
        if (CefRuntime.lastError == null) { return ""; }
        return CefRuntime.lastError;
    }

    static void Fail(string msg) {
        CefRuntime.lastError = msg;
    }

    // ---------------------------------------------------------------- 平台

    /// <summary>官方平台标识（"windows64" / "linux64" / "macosarm64" …），
    /// 无法映射时返回 ""。</summary>
    static string Platform() {
        #if WINDOWS
        #if ARM64
        return "windowsarm64";
        #else
        return "windows64";
        #endif
        #elif LINUX
        #if ARM64
        return "linuxarm64";
        #else
        return "linux64";
        #endif
        #elif MACOS
        #if ARM64
        return "macosarm64";
        #else
        return "macosx64";
        #endif
        #else
        return "";
        #endif
    }

    /// <summary>当前系统是否只能用 CEF 109：Windows 7 / 8 / 8.1
    /// （内核 6.0—6.3）。</summary>
    static bool LegacyWindows() {
        #if WINDOWS
        string kernel = SystemInfo.KernelVersion();
        int dot = kernel.IndexOf(".");
        if (dot <= 0) { return false; }
        int major = CefRuntime.ParseInt(kernel.Substring(0, dot));
        if (major <= 0) { return false; }
        if (major >= 10) { return false; }
        if (major < 6) { return true; }
        return true;
        #else
        return false;
        #endif
    }

    /// <summary>当前分支的 CEF 主版本前缀。
    ///
    /// 这里必须钉死而不是「取最新 stable」：CEF 的 C API 结构体布局按版本
    /// 绑定，原生 driver 是针对某个分支的头文件编译的，运行时换成别的分支
    /// 就是内存布局错位（driver 因此还会校验 cef_api_hash 并拒绝加载）。
    /// 升级流程是：改这里的前缀 + 重新用对应头文件编译 driver（见
    /// cmake/ZanCef.cmake 里的 ZAN_CEF_VERSION），两者一起动。</summary>
    static string CurrentBranch() { return "151."; }

    /// <summary>旧 Windows（7/8/8.1）能用的最后一个 CEF 分支。</summary>
    static string LegacyBranch() { return "109."; }

    /// <summary>需要的版本前缀："109."（旧 Windows）或当前分支。</summary>
    static string VersionPrefix() {
        if (CefRuntime.LegacyWindows()) { return CefRuntime.LegacyBranch(); }
        return CefRuntime.CurrentBranch();
    }

    // ---------------------------------------------------------------- 钉版本

    /// <summary>内置 stable + minimal 归档表。它跟 CurrentBranch() /
    /// LegacyBranch() 以及原生 driver 的 CEF 版本绑定在一起，升级 CEF
    /// 必须同时修改这张表、分支前缀和 driver。数据来自官方 index.json
    /// 的 stable + minimal 条目。</summary>
    static CefArchive Pinned(string version, string chromium, string platform,
            string sha1, long size) {
        CefArchive a = new CefArchive();
        a.cefVersion = version;
        a.chromiumVersion = chromium;
        a.platform = platform;
        a.fileName = "cef_binary_" + version + "_" + platform + "_"
            + CefRuntime.ArchiveType() + ".tar.bz2";
        a.sha1 = sha1;
        a.size = size;
        return a;
    }

    /// <summary>按平台和版本前缀查找内置归档，未命中返回 null。</summary>
    static CefArchive FindPinned(string platform, string versionPrefix) {
        CefArchive[] all = new CefArchive[8];
        all[0] = CefRuntime.Pinned(
            "151.3.23+gd211df0+chromium-151.0.7922.170",
            "151.0.7922.170", "windows64",
            "d8ec9eb5021852e33cd9dfeb3915971a6709e783", 170771122);
        all[1] = CefRuntime.Pinned(
            "151.3.23+gd211df0+chromium-151.0.7922.170",
            "151.0.7922.170", "windowsarm64",
            "e96d8e64472adfe0a2efeb67c3b92a5661271631", 165945014);
        all[2] = CefRuntime.Pinned(
            "151.3.23+gd211df0+chromium-151.0.7922.170",
            "151.0.7922.170", "linux64",
            "8c221485ef83ff4263a4170a215c05b48214391c", 321810032);
        all[3] = CefRuntime.Pinned(
            "151.3.23+gd211df0+chromium-151.0.7922.170",
            "151.0.7922.170", "linuxarm64",
            "50d5f193e41955b5a2dd59b6dcddbd159b95991b", 412699442);
        all[4] = CefRuntime.Pinned(
            "151.3.23+gd211df0+chromium-151.0.7922.170",
            "151.0.7922.170", "macosarm64",
            "94b409659401b34bf8616f9592ba5daeb9ee82d4", 130993494);
        all[5] = CefRuntime.Pinned(
            "151.3.23+gd211df0+chromium-151.0.7922.170",
            "151.0.7922.170", "macosx64",
            "e493896c0633b7630696d5d72bc17ef948be94b6", 136761682);
        all[6] = CefRuntime.Pinned(
            "109.1.18+gf1c41e4+chromium-109.0.5414.120",
            "109.0.5414.120", "windows64",
            "338ea5ebea4045405c1fe144d6ac82629120b8aa", 168318857);
        all[7] = CefRuntime.Pinned(
            "109.1.18+gf1c41e4+chromium-109.0.5414.120",
            "109.0.5414.120", "windowsarm64",
            "083f2e7821620c36b82336f4724b7852151d3ad6", 153534158);
        for (int i = 0; i < all.Length; i = i + 1) {
            if (all[i].platform != platform) { continue; }
            if (versionPrefix == "" || all[i].cefVersion.StartsWith(versionPrefix)) {
                return all[i];
            }
        }
        return null;
    }

    /// <summary>按平台和完整版本查找内置归档，未命中返回 null。</summary>
    static CefArchive FindPinnedExact(string platform, string version) {
        CefArchive a = CefRuntime.FindPinned(platform, version);
        if (a == null || a.cefVersion != version) { return null; }
        return a;
    }

    // ---------------------------------------------------------------- 缓存

    /// <summary>本地缓存根目录（可用 <see cref="CefOptions.cacheRoot"/> /
    /// ZAN_CEF_CACHE 覆盖）。</summary>
    static string CacheRoot() {
        string custom = CefOptions.CacheRoot();
        if (custom != "") { return CefRuntime.Slashes(custom); }
        #if WINDOWS
        string local = ProcessHost.Env("LOCALAPPDATA");
        if (local == "") { local = ProcessHost.Env("TEMP"); }
        if (local == "") { local = "C:/Temp"; }
        return CefRuntime.Slashes(local) + "/Zan/cef";
        #elif MACOS
        string home = ProcessHost.Env("HOME");
        if (home == "") { home = "/tmp"; }
        return CefRuntime.Slashes(home) + "/Library/Caches/Zan/cef";
        #else
        string xdg = ProcessHost.Env("XDG_CACHE_HOME");
        if (xdg == "") {
            string home2 = ProcessHost.Env("HOME");
            if (home2 == "") { home2 = "/tmp"; }
            xdg = CefRuntime.Slashes(home2) + "/.cache";
        }
        return CefRuntime.Slashes(xdg) + "/zan/cef";
        #endif
    }

    /// <summary>下载目录（归档与进度文件）。</summary>
    static string DownloadDir() {
        return CefRuntime.CacheRoot() + "/download";
    }

    /// <summary>某个 CEF 版本解包后的运行时目录。</summary>
    static string RuntimeDir(string cefVersion) {
        return CefRuntime.CacheRoot() + "/" + CefRuntime.Platform()
            + "-" + CefRuntime.SafeVersion(cefVersion);
    }

    /// <summary>该目录是否已完整安装（存在就绪标记与 Resources）。</summary>
    static bool IsReady(string dir) {
        if (!File.Exists(dir + "/" + CefRuntime.ReadyMarker())) { return false; }
        if (!Directory.Exists(dir + "/Resources")) { return false; }
        #if MACOS
        #else
        if (!File.Exists(dir + "/Release/icudtl.dat")) { return false; }
        #endif
        return true;
    }

    /// <summary>本地已安装且符合当前版本策略的运行时目录，没有则 ""。
    /// 不联网。</summary>
    static string Installed() {
        string root = CefRuntime.CacheRoot();
        if (!Directory.Exists(root)) { return ""; }
        string plat = CefRuntime.Platform();
        if (plat == "") { return ""; }
        string want = CefRuntime.VersionPrefix();
        string best = "";
        string bestVer = "";
        List<string> subs = Directory.GetDirectories(root);
        for (int i = 0; i < subs.Count; i = i + 1) {
            string name = subs[i];
            if (!name.StartsWith(plat + "-")) { continue; }
            string ver = name.Substring(plat.Length + 1,
                name.Length - plat.Length - 1);
            if (want != "" && !ver.StartsWith(CefRuntime.SafeVersion(want))) {
                continue;
            }
            string dir = root + "/" + name;
            if (!CefRuntime.IsReady(dir)) { continue; }
            if (best == "" || CefRuntime.VersionNewer(ver, bestVer)) {
                best = dir;
                bestVer = ver;
            }
        }
        return best;
    }

    /// <summary>删除整个 CEF 缓存（运行时与已下载归档）。</summary>
    static bool CleanCache() {
        return Directory.DeleteRecursive(CefRuntime.CacheRoot());
    }

    // ---------------------------------------------------------------- 地址

    /// <summary>当前 CEF 服务基址。镜像配置会去掉末尾斜杠。</summary>
    static string BaseUrl() {
        string custom = CefOptions.MirrorBase();
        if (custom == "") { return "https://" + CefRuntime.IndexHost(); }
        return CefRuntime.Slashes(custom);
    }

    /// <summary>把镜像路径前缀与请求路径拼成单个 HTTP 路径。</summary>
    static string BasePath(string path) {
        CefHttpEndpoint endpoint = CefRuntime.Endpoint();
        if (endpoint == null) { return path; }
        string prefix = endpoint.prefix;
        if (prefix == "") { return path; }
        if (path == "") { return prefix; }
        if (prefix.EndsWith("/") && path.StartsWith("/")) {
            return prefix.Substring(0, prefix.Length - 1) + path;
        }
        if (!prefix.EndsWith("/") && !path.StartsWith("/")) {
            return prefix + "/" + path;
        }
        return prefix + path;
    }

    /// <summary>解析镜像的 scheme、主机、端口与路径前缀。</summary>
    static CefHttpEndpoint Endpoint() {
        string baseUrl = CefRuntime.BaseUrl();
        int schemeAt = baseUrl.IndexOf("://");
        if (schemeAt <= 0) {
            CefRuntime.Fail("CEF 镜像地址必须是 http:// 或 https://：" + baseUrl);
            return null;
        }
        string scheme = baseUrl.Substring(0, schemeAt);
        bool tls = false;
        int port = 0;
        if (scheme == "https") {
            tls = true;
            port = 443;
        } else if (scheme == "http") {
            port = 80;
        } else {
            CefRuntime.Fail("CEF 镜像地址只支持 http:// 或 https://：" + baseUrl);
            return null;
        }
        string rest = baseUrl.Substring(schemeAt + 3,
            baseUrl.Length - schemeAt - 3);
        int slash = rest.IndexOf("/");
        string authority = rest;
        string prefix = "";
        if (slash >= 0) {
            authority = rest.Substring(0, slash);
            prefix = rest.Substring(slash, rest.Length - slash);
        }
        if (authority == "") {
            CefRuntime.Fail("CEF 镜像地址缺少主机名：" + baseUrl);
            return null;
        }
        int colon = authority.LastIndexOf(":");
        string host = authority;
        if (colon > 0) {
            host = authority.Substring(0, colon);
            int parsed = CefRuntime.ParseInt(
                authority.Substring(colon + 1, authority.Length - colon - 1));
            if (parsed <= 0 || parsed > 65535) {
                CefRuntime.Fail("CEF 镜像地址端口无效：" + baseUrl);
                return null;
            }
            port = parsed;
        }
        CefHttpEndpoint e = new CefHttpEndpoint();
        e.host = host;
        e.port = port;
        e.tls = tls;
        e.prefix = prefix;
        return e;
    }

    /// <summary>归档完整 URL（文件名中的 "+" 继续按 URL 规则转义）。</summary>
    static string ArchiveUrl(CefArchive a) {
        return CefRuntime.BaseUrl() + a.Path();
    }

    // ---------------------------------------------------------------- 索引

    /// <summary>把官方构建索引下载到 <paramref name="destPath"/>，
    /// 成功返回 true。索引每次都重新拉取（不做断点续传，避免续到
    /// 过期的半截文件上）。</summary>
    static async bool FetchIndexAsync(string destPath) {
        Directory.CreateDirectoryRecursive(CefRuntime.ParentDir(destPath));
        CefHttpEndpoint endpoint = CefRuntime.Endpoint();
        if (endpoint == null) { return false; }
        HttpClient client = endpoint.tls
            ? HttpClient.CreateHttps(endpoint.host, endpoint.port)
            : new HttpClient(endpoint.host, endpoint.port);
        client.SetTimeout(60000);
        long n = 0;
        // 索引是 10 MB 量级的单次传输，一次连接抖动就够让整个自举失败，
        // 而用户看到的只是「下载索引失败」；重试一次，并把传输返回值带进
        // 错误里（-1=连接/握手/响应不完整）。
        for (int attempt = 0; attempt < 2; attempt = attempt + 1) {
            if (File.Exists(destPath)) { File.Delete(destPath); }
            n = await client.DownloadBinaryToFileAsync(
                CefRuntime.BasePath(CefRuntime.IndexPath()),
                destPath, destPath + ".progress");
            if (n > 0) {
                File.Delete(destPath + ".progress");
                return true;
            }
        }
        CefRuntime.Fail("下载 CEF 构建索引失败（传输返回 "
            + Convert.ToString(n) + "，检查网络与代理）："
            + CefRuntime.BaseUrl() + CefRuntime.IndexPath());
        return false;
    }

    /// <summary>从索引文本里挑出该平台上符合前缀的最新 stable 归档。
    /// 纯函数，便于离线测试。失败返回 null。</summary>
    static CefArchive SelectArchive(string index, string platform,
            string versionPrefix) {
        int region = index.IndexOf("\"" + platform + "\"");
        if (region < 0) {
            CefRuntime.Fail("CEF 索引里没有平台 " + platform);
            return null;
        }
        int at = region;
        while (true) {
            int key = index.IndexOf("\"cef_version\"", at);
            if (key < 0) { break; }
            // 索引有 10 MB 量级，逐字符扫描整串代价太高：只在
            // "cef_version" 附近开一个足够放下整个版本对象的窗口。
            int winStart = key - 64;
            if (winStart < 0) { winStart = 0; }
            int winLen = 65536;
            if (winStart + winLen > index.Length) {
                winLen = index.Length - winStart;
            }
            string win = index.Substring(winStart, winLen);
            int open = CefRuntime.PrevBrace(win, key - winStart);
            if (open < 0) { at = key + 13; continue; }
            int close = CefRuntime.MatchBrace(win, open);
            if (close < 0) { at = key + 13; continue; }
            at = winStart + close;
            string text = win.Substring(open, close - open + 1);
            CefArchive found = CefRuntime.ReadVersion(text, platform,
                versionPrefix);
            if (found != null) { return found; }
            // 已经越过本平台的区段（版本对象里的文件名属于别的平台）。
            if (CefRuntime.OtherPlatform(text, platform)) { break; }
        }
        CefRuntime.Fail("CEF 索引里找不到 " + platform + " 的 stable 版本"
            + CefRuntime.PrefixNote(versionPrefix));
        return null;
    }

    /// <summary>解析单个版本对象，符合条件时返回归档，否则 null。</summary>
    static CefArchive ReadVersion(string text, string platform,
            string versionPrefix) {
        JsonValue v = JsonValue.Parse(text);
        if (v == null || !v.IsObject()) { return null; }
        if (v.Str("channel", "") != "stable") { return null; }
        string ver = v.Str("cef_version", "");
        if (ver == "") { return null; }
        if (versionPrefix != "" && !ver.StartsWith(versionPrefix)) { return null; }
        JsonValue files = v.Get("files");
        if (files == null || !files.IsArray()) { return null; }
        for (int i = 0; i < files.Count(); i = i + 1) {
            JsonValue f = files.At(i);
            if (f == null || !f.IsObject()) { continue; }
            if (f.Str("type", "") != CefRuntime.ArchiveType()) { continue; }
            string name = f.Str("name", "");
            if (name.IndexOf("_" + platform) < 0) { return null; }
            if (!name.EndsWith(".tar.bz2")) { return null; }
            CefArchive a = new CefArchive();
            a.cefVersion = ver;
            a.chromiumVersion = v.Str("chromium_version", "");
            a.platform = platform;
            a.fileName = name;
            a.sha1 = f.Str("sha1", "").ToLower();
            a.size = f.Long("size", 0);
            if (a.sha1.Length != 40) { return null; }
            return a;
        }
        return null;
    }

    /// <summary>版本对象里的文件名是否属于别的平台。</summary>
    static bool OtherPlatform(string text, string platform) {
        int at = text.IndexOf("\"name\"");
        if (at < 0) { return false; }
        return text.IndexOf("_" + platform, at) < 0;
    }

    static string PrefixNote(string versionPrefix) {
        if (versionPrefix == "") { return ""; }
        return "（要求前缀 " + versionPrefix + "）";
    }

    /// <summary>读取本机归档并校验其平台、版本和已知摘要。</summary>
    static CefArchive ReadLocalArchive(string path) {
        if (!File.Exists(path)) {
            CefRuntime.Fail("CEF 本机归档不存在：" + path);
            return null;
        }
        string name = Path.GetFileName(path);
        string head = "cef_binary_";
        string marker = "_" + CefRuntime.Platform() + "_";
        int start = head.Length;
        int at = name.IndexOf(marker);
        if (!name.StartsWith(head) || at <= start || !name.EndsWith(".tar.bz2")) {
            CefRuntime.Fail("CEF 本机归档命名必须是 cef_binary_<版本>_"
                + CefRuntime.Platform() + "_...tar.bz2，当前文件名：" + name);
            return null;
        }
        string version = name.Substring(start, at - start);
        string prefix = CefRuntime.VersionPrefix();
        if (prefix != "" && !version.StartsWith(prefix)) {
            CefRuntime.Fail("原生 driver 绑定 CEF " + prefix + "，这个归档是 "
                + version + "，ABI 不兼容");
            return null;
        }
        CefArchive pinned = CefRuntime.FindPinnedExact(
            CefRuntime.Platform(), version);
        if (pinned != null && !Sha1.VerifyFile(path, pinned.sha1)) {
            CefRuntime.Fail("CEF 本机归档 SHA-1 校验失败，文件可能损坏或版本不对："
                + path);
            return null;
        }
        CefArchive a = new CefArchive();
        a.cefVersion = version;
        a.chromiumVersion = "";
        a.platform = CefRuntime.Platform();
        a.fileName = name;
        if (pinned != null) {
            a.chromiumVersion = pinned.chromiumVersion;
            a.sha1 = pinned.sha1;
            a.size = pinned.size;
        }
        return a;
    }

    /// <summary>联网确定当前系统该用哪个 CEF 归档。优先使用内置表，
    /// 只有新平台或未登记分支才下载索引兜底。</summary>
    static async CefArchive ResolveAsync() {
        string plat = CefRuntime.Platform();
        if (plat == "") {
            CefRuntime.Fail("当前平台没有官方 CEF 构建");
            return null;
        }
        string prefix = CefRuntime.VersionPrefix();
        CefArchive pinned = CefRuntime.FindPinned(plat, prefix);
        if (pinned != null) { return pinned; }
        string indexPath = CefRuntime.CacheRoot() + "/index.json";
        bool ok = await CefRuntime.FetchIndexAsync(indexPath);
        if (!ok) {
            string detail = CefRuntime.Error();
            CefRuntime.Fail("内置表里没有 " + plat + "/" + prefix
                + "，且索引兜底也失败：" + detail);
            return null;
        }
        string text = File.ReadAllText(indexPath);
        if (text.Length == 0) {
            CefRuntime.Fail("内置表里没有 " + plat + "/" + prefix
                + "，且索引兜底也失败：CEF 构建索引为空");
            return null;
        }
        CefArchive selected = CefRuntime.SelectArchive(text, plat, prefix);
        if (selected == null) {
            string detail2 = CefRuntime.Error();
            CefRuntime.Fail("内置表里没有 " + plat + "/" + prefix
                + "，且索引兜底也失败：" + detail2);
        }
        return selected;
    }

    // ---------------------------------------------------------------- 安装

    /// <summary>确保本地有可用的 CEF 运行时，返回其目录；失败返回 ""
    /// （原因见 <see cref="Error"/>）。已装好时不联网。</summary>
    static async string EnsureAsync() {
        CefRuntime.lastError = "";
        string have = CefRuntime.Installed();
        if (have != "") { return have; }

        string localPath = CefOptions.ArchivePath();
        if (localPath != "") {
            CefArchive local = CefRuntime.ReadLocalArchive(localPath);
            if (local == null) { return ""; }
            string localDir = CefRuntime.RuntimeDir(local.cefVersion);
            if (CefRuntime.IsReady(localDir)) { return localDir; }
            if (!CefRuntime.Install(localPath, localDir, local.cefVersion)) {
                return "";
            }
            return localDir;
        }
        CefArchive a = await CefRuntime.ResolveAsync();
        if (a == null) { return ""; }
        string dir = CefRuntime.RuntimeDir(a.cefVersion);
        if (CefRuntime.IsReady(dir)) { return dir; }

        string archive = CefRuntime.DownloadDir() + "/" + a.fileName;
        bool got = await CefRuntime.DownloadArchiveAsync(a, archive);
        if (!got) { return ""; }
        if (!CefRuntime.Install(archive, dir, a.cefVersion)) { return ""; }
        return dir;
    }

    // ------------------------------------------- 带进度界面的自举（DownloadJob）

    /// 准备阶段选中的目标目录与版本：worker 线程上先写、随后同一个线程上的
    /// 安装步骤再读（DownloadJob 是单任务语义，见其类注释）。
    static string pendingDir;
    static string pendingVersion;

    /// <summary>把运行时自举做成一个通用下载任务，好让宿主用
    /// <see cref="DownloadDialog"/> 显示进度：
    ///
    /// <code>
    /// DownloadJob job = CefRuntime.NewEnsureJob();
    /// job.Start();
    /// DownloadDialog.Show(app, "正在准备浏览器运行时", job);
    /// // 任务成功后：CefRuntime.EnsuredDir() 就是运行时目录
    /// </code>
    ///
    /// 「下哪个归档」仍然由本类决定（优先查内置表、必要时联网拉索引），
    /// 解压/剥顶层目录/打就绪标记也仍然走本类的 <c>Install</c>——任务层只管
    /// 传输、校验与进度。已经装好时任务不下载任何东西，直接以“已完成”收工。
    /// </summary>
    static DownloadJob NewEnsureJob() {
        DownloadJob job = new DownloadJob();
        job.SetPrepare(CefRuntime.PrepareJob);
        return job;
    }

    /// <summary>任务的准备回调（跑在工作线程上）：确定归档并加条目；
    /// 本机归档模式直接安装，不产生下载条目。</summary>
    static bool PrepareJob(DownloadJob job) {
        CefRuntime.lastError = "";
        CefRuntime.pendingDir = "";
        CefRuntime.pendingVersion = "";
        if (CefRuntime.Installed() != "") { return true; }
        string localPath = CefOptions.ArchivePath();
        if (localPath != "") {
            CefArchive local = CefRuntime.ReadLocalArchive(localPath);
            if (local == null) { return false; }
            CefRuntime.pendingDir = CefRuntime.RuntimeDir(local.cefVersion);
            CefRuntime.pendingVersion = local.cefVersion;
            if (CefRuntime.IsReady(CefRuntime.pendingDir)) { return true; }
            return CefRuntime.Install(localPath, CefRuntime.pendingDir,
                CefRuntime.pendingVersion);
        }
        CefArchive a = await CefRuntime.ResolveAsync();
        if (a == null) { return false; }
        string dir = CefRuntime.RuntimeDir(a.cefVersion);
        CefRuntime.pendingDir = dir;
        CefRuntime.pendingVersion = a.cefVersion;
        if (CefRuntime.IsReady(dir)) { return true; }
        Directory.CreateDirectoryRecursive(CefRuntime.DownloadDir());
        string archive = CefRuntime.DownloadDir() + "/" + a.fileName;
        DownloadItem it = DownloadItem.FromUrl(
            CefRuntime.ArchiveUrl(a), archive);
        if (it == null) {
            CefRuntime.Fail("CEF 归档地址异常：" + a.fileName);
            return false;
        }
        job.Add(it.WithSha1(a.sha1).WithSize(a.size).WithName(a.fileName)
            .WithInstaller(CefRuntime.InstallItem));
        return true;
    }

    /// <summary>任务的安装步骤（跑在工作线程上）：CEF 的归档要剥掉顶层
    /// 目录、要打就绪标记，所以不能用任务层按扩展名的默认解压。</summary>
    static bool InstallItem(DownloadItem it) {
        return CefRuntime.Install(it.LocalPath(), CefRuntime.pendingDir,
            CefRuntime.pendingVersion);
    }

    /// <summary><see cref="NewEnsureJob"/> 的任务成功收工后，运行时所在
    /// 目录；没装好时 ""。</summary>
    static string EnsuredDir() {
        string have = CefRuntime.Installed();
        if (have != "") { return have; }
        if (CefRuntime.pendingDir == null) { return ""; }
        if (CefRuntime.pendingDir == "") { return ""; }
        if (!CefRuntime.IsReady(CefRuntime.pendingDir)) { return ""; }
        return CefRuntime.pendingDir;
    }

    /// <summary>下载归档（断点续传）并按官方 SHA-1 校验；校验不过会
    /// 重下一次。</summary>
    static async bool DownloadArchiveAsync(CefArchive a, string archive) {
        Directory.CreateDirectoryRecursive(CefRuntime.DownloadDir());
        if (File.Exists(archive) && Sha1.VerifyFile(archive, a.sha1)) {
            return true;
        }
        CefHttpEndpoint endpoint = CefRuntime.Endpoint();
        if (endpoint == null) { return false; }
        HttpClient client = endpoint.tls
            ? HttpClient.CreateHttps(endpoint.host, endpoint.port)
            : new HttpClient(endpoint.host, endpoint.port);
        client.SetTimeout(120000);
        for (int attempt = 0; attempt < 2; attempt = attempt + 1) {
            long n = await client.DownloadBinaryToFileAsync(
                CefRuntime.BasePath(a.Path()), archive, archive + ".progress");
            if (n > 0 && Sha1.VerifyFile(archive, a.sha1)) { return true; }
            // 半截或损坏：清掉后整包重下。
            if (File.Exists(archive)) { File.Delete(archive); }
        }
        CefRuntime.Fail("CEF 归档下载或 SHA-1 校验失败："
            + CefRuntime.ArchiveUrl(a));
        return false;
    }

    /// <summary>下载进度（"已收/总计" 字节），未在下载时返回 ""。</summary>
    static string Progress(string fileName) {
        string p = CefRuntime.DownloadDir() + "/" + fileName + ".progress";
        if (!File.Exists(p)) { return ""; }
        return File.ReadAllText(p).Trim();
    }

    /// <summary>解压 .tar.bz2 归档到运行时目录并打上就绪标记：归档里
    /// 只有一层 cef_binary_… 顶层目录，会被剥掉。</summary>
    static bool Install(string archive, string dir, string cefVersion) {
        Directory.CreateDirectoryRecursive(CefRuntime.DownloadDir());
        string tar = CefRuntime.DownloadDir() + "/" + Path.GetFileName(archive)
            + ".tar";
        string staging = dir + ".tmp";
        Directory.DeleteRecursive(staging);
        Directory.DeleteRecursive(dir);
        if (!BZip2.DecompressFile(archive, tar)) {
            CefRuntime.Fail("CEF 归档 bzip2 解压失败：" + archive);
            File.Delete(tar);
            return false;
        }
        int n = Tar.ExtractFile(tar, staging);
        File.Delete(tar);
        if (n <= 0) {
            CefRuntime.Fail("CEF 归档 tar 解包失败：" + archive);
            Directory.DeleteRecursive(staging);
            return false;
        }
        string src = staging;
        List<string> subs = Directory.GetDirectories(staging);
        List<string> tops = Directory.GetFiles(staging);
        if (subs.Count == 1 && tops.Count == 0) {
            src = staging + "/" + subs[0];
        }
        Directory.CreateDirectoryRecursive(CefRuntime.ParentDir(dir));
        File.Move(src, dir);
        if (!Directory.Exists(dir + "/Resources")) {
            CefRuntime.Fail("CEF 归档内容异常：缺少 Resources/（" + archive + "）");
            Directory.DeleteRecursive(staging);
            return false;
        }
        Directory.DeleteRecursive(staging);
        CefRuntime.MarkExecutables(dir);
        CefRuntime.StageResources(dir);
        File.WriteAllText(dir + "/" + CefRuntime.ReadyMarker(), cefVersion);
        return true;
    }

    /// <summary>把 Resources/ 的内容复制到 Release/：Chromium 只按 libcef
    /// 所在目录找 icudtl.dat，不看 resources_dir_path，所以运行时的资源
    /// 必须和二进制同目录（macOS 的 framework 布局自带资源，跳过）。</summary>
    static void StageResources(string dir) {
        #if MACOS
        #else
        string rel = dir + "/Release";
        string res = dir + "/Resources";
        if (!Directory.Exists(rel) || !Directory.Exists(res)) { return; }
        CefRuntime.CopyTree(res, rel);
        #endif
    }

    /// <summary>递归复制目录内容（已存在的同名文件会被覆盖）。</summary>
    static void CopyTree(string src, string dst) {
        Directory.CreateDirectoryRecursive(dst);
        List<string> files = Directory.GetFiles(src);
        for (int i = 0; i < files.Count; i = i + 1) {
            File.Copy(src + "/" + files[i], dst + "/" + files[i]);
        }
        List<string> subs = Directory.GetDirectories(src);
        for (int j = 0; j < subs.Count; j = j + 1) {
            CefRuntime.CopyTree(src + "/" + subs[j], dst + "/" + subs[j]);
        }
    }

    /// <summary>POSIX 上给 Release/ 下的产物补上可执行位（tar 里的 mode
    /// 已经带了，这里只是兜底 helper 进程能起来）。</summary>
    static void MarkExecutables(string dir) {
        #if WINDOWS
        #else
        string rel = dir + "/Release";
        if (!Directory.Exists(rel)) { return; }
        List<string> files = Directory.GetFiles(rel);
        for (int i = 0; i < files.Count; i = i + 1) {
            string name = files[i];
            if (name.EndsWith(".so") || name.EndsWith(".dylib")
                || name.IndexOf(".") < 0 || name.EndsWith("Helper")) {
                File.SetExecutable(rel + "/" + name, true);
            }
        }
        #endif
    }

    // ---------------------------------------------------------- 小工具

    /// <summary>把归档文件名转成 URL 路径片段（"+" → "%2B"）。</summary>
    static string UrlEncode(string name) {
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < name.Length; i = i + 1) {
            int c = name[i] & 255;
            if (c == 43) { sb.Append("%2B"); }
            else if (c == 32) { sb.Append("%20"); }
            else { sb.Append(name.Substring(i, 1)); }
        }
        return sb.ToString();
    }

    /// <summary>把版本串里不适合做目录名的字符换成 "-"。</summary>
    static string SafeVersion(string v) {
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < v.Length; i = i + 1) {
            int c = v[i] & 255;
            bool ok = (c >= 48 && c <= 57) || (c >= 97 && c <= 122)
                || (c >= 65 && c <= 90) || c == 46 || c == 45 || c == 95;
            if (ok) { sb.Append(v.Substring(i, 1)); }
            else { sb.Append("-"); }
        }
        return sb.ToString();
    }

    /// <summary>比较两个目录名里的版本，a 是否比 b 新（按点分数字段）。
    /// </summary>
    static bool VersionNewer(string a, string b) {
        if (b == "") { return true; }
        int ia = 0;
        int ib = 0;
        while (ia < a.Length || ib < b.Length) {
            int na = 0 - 1;
            int nb = 0 - 1;
            int ja = ia;
            while (ja < a.Length && (a[ja] & 255) >= 48 && (a[ja] & 255) <= 57) {
                if (na < 0) { na = 0; }
                na = na * 10 + ((a[ja] & 255) - 48);
                ja = ja + 1;
            }
            int jb = ib;
            while (jb < b.Length && (b[jb] & 255) >= 48 && (b[jb] & 255) <= 57) {
                if (nb < 0) { nb = 0; }
                nb = nb * 10 + ((b[jb] & 255) - 48);
                jb = jb + 1;
            }
            if (na != nb) { return na > nb; }
            if (na < 0) { return false; }
            ia = ja + 1;
            ib = jb + 1;
            if (ia > a.Length) { ia = a.Length; }
            if (ib > b.Length) { ib = b.Length; }
            if (ja >= a.Length && jb >= b.Length) { return false; }
        }
        return false;
    }

    static int ParseInt(string s) {
        int v = 0;
        bool any = false;
        for (int i = 0; i < s.Length; i = i + 1) {
            int c = s[i] & 255;
            if (c < 48 || c > 57) { break; }
            v = v * 10 + (c - 48);
            any = true;
        }
        if (!any) { return 0 - 1; }
        return v;
    }

    static string Slashes(string p) {
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < p.Length; i = i + 1) {
            if ((p[i] & 255) == 92) { sb.Append("/"); }
            else { sb.Append(p.Substring(i, 1)); }
        }
        string s = sb.ToString();
        while (s.Length > 1 && s.EndsWith("/")) {
            s = s.Substring(0, s.Length - 1);
        }
        return s;
    }

    static string ParentDir(string path) {
        int cut = 0 - 1;
        for (int i = 0; i < path.Length; i = i + 1) {
            int c = path[i] & 255;
            if (c == 47 || c == 92) { cut = i; }
        }
        if (cut <= 0) { return "."; }
        return path.Substring(0, cut);
    }

    /// <summary>from 之前最近的一个 '{'。</summary>
    static int PrevBrace(string s, int from) {
        for (int i = from; i >= 0; i = i - 1) {
            int c = s[i] & 255;
            if (c == 123) { return i; }
            if (c == 125 || c == 91 || c == 93) { return 0 - 1; }
        }
        return 0 - 1;
    }

    /// <summary>与 open 处 '{' 配对的 '}'，考虑字符串字面量与转义。</summary>
    static int MatchBrace(string s, int open) {
        int depth = 0;
        bool inStr = false;
        bool esc = false;
        for (int i = open; i < s.Length; i = i + 1) {
            int c = s[i] & 255;
            if (inStr) {
                if (esc) { esc = false; }
                else if (c == 92) { esc = true; }
                else if (c == 34) { inStr = false; }
                continue;
            }
            if (c == 34) { inStr = true; }
            else if (c == 123) { depth = depth + 1; }
            else if (c == 125) {
                depth = depth - 1;
                if (depth == 0) { return i; }
            }
        }
        return 0 - 1;
    }
}
