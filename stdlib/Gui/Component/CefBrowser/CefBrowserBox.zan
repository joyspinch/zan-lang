using System;
using Gui;

namespace Gui.Component.CefBrowser;

/// 可摆放的 Chromium 浏览器控件：把原生 CefBrowser 包成一个普通的保留式
/// Control，因此设计器 / .zform 里的 CEF 浏览器和别的控件一样，由布局给它
/// 一块矩形、由它自己负责绘制（与 WebViewBox 同构，只是引擎换成自带的
/// Chromium）。
///
///     CefBrowserBox box = new CefBrowserBox();
///     box.SetStartUrl("https://example.com");
///     tabs.Page(0).Add(box);              // 标签页里放一个浏览器
///     box.View().NavComplete += () => { ... };
///
/// 可见时按自己的已解析边界 Render，落在隐藏的标签页 / 折叠容器里时整棵
/// 子树不参与渲染，由 NativeLayer 兜底把没登记的原生层裁空（即隐藏）。
class CefBrowserBox : Control {
    /// 本控件拥有的原生浏览器（每个 CefBrowserBox 一个 Chromium 视图，
    /// 因此多标签浏览器就是多个 CefBrowserBox）。
    CefBrowser view;
    /// 设计期填写的起始地址，首帧导航一次。
    string startUrl;
    bool navigated;

    /// 默认构造：无起始地址。
    CefBrowserBox() {
        this.InitControl("cefbrowser", 5);
        this.view = new CefBrowser();
        this.startUrl = "";
        this.navigated = false;
    }

    /// 底层原生浏览器：历史、JS、CDP、事件都在它上面。
    /// <returns>本控件唯一拥有的 CefBrowser 实例。</returns>
    CefBrowser View() { return view; }

    /// <summary>起始地址（设计属性 `url`，.zform 里也可写成
    /// `placeholder`）。首帧之前设置只记录起始地址，待首次绘制时
    /// 导航一次；首帧之后设置立即等同于 Navigate。</summary>
    void SetStartUrl(string u) {
        startUrl = u;
        if (navigated && u != "") { view.Navigate(u); }
    }

    /// 当前设置的起始地址。
    string StartUrl() { return startUrl; }

    /// <summary>立即导航到 target（与 SetStartUrl 不同，不等首帧）。</summary>
    void Navigate(string target) {
        navigated = true;
        view.Navigate(target);
    }

    /// 历史后退一页（转发到底层浏览器）。
    void Back() { view.Back(); }
    /// 历史前进一页。
    void Forward() { view.Forward(); }
    /// 重新加载当前页。
    void Reload() { view.Reload(); }
    /// 停止当前加载。
    void Stop() { view.Stop(); }
    /// 能否后退。
    bool CanGoBack() { return view.CanGoBack(); }
    /// 能否前进。
    bool CanGoForward() { return view.CanGoForward(); }
    /// 是否正在加载。
    bool IsLoading() { return view.IsLoading(); }
    /// 最近一次响应的 HTTP 状态码（无为 0）。
    int LastStatus() { return view.LastStatus(); }
    /// 当前 URL 快照。
    string CurrentUrl() { return view.CurrentUrl(); }
    /// 当前文档标题快照。
    string CurrentTitle() { return view.CurrentTitle(); }

    /// 隐藏原生浏览器（本控件不再上屏时调用；隐藏的标签页由 NativeLayer
    /// 自动兜底，这里供宿主显式收起）。
    void Hide() { view.Hide(); }

    /// <summary>关闭原生浏览器（关闭标签页时调用），并把控件从树上
    /// 摘下。销毁后不要再 Render 本控件。</summary>
    void Destroy() {
        view.Destroy();
        if (parent != null) { parent.Remove(this); }
    }

    // ---- 设计器 / 序列化模型 --------------------------------------

    /// 控件类型标识（"CefBrowserBox"）。
    override string Kind() { return "CefBrowserBox"; }

    /// 设计器属性：起始地址（"url"）。
    override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        // 设计器把每个字段的文本属性存成 `placeholder`，所以起始地址
        // 同时应答这个键：在检查器里填的地址能原样往返。
        PropSpec u = PropSpec.Text("url", "Start URL").Also("placeholder");
        u.str = startUrl;
        ps.Add(u);
        return ps;
    }

    /// 控件事件清单：公共事件外加四个导航语义事件。
    override List<string> Events() {
        List<string> e = Control.CommonEvents();
        e.Add("NavStart");
        e.Add("NavComplete");
        e.Add("TitleChanged");
        e.Add("LoadingChanged");
        return e;
    }

    /// 浏览器的语义事件挂在原生视图上，设计里的 `onNavComplete` 之类
    /// 因此直接落到它的 UiEvent，宿主不必自己接线。
    override void BindEvent(string evt, Action a) {
        if (evt == "NavStart") { view.NavStart.Add(a); return; }
        if (evt == "NavComplete") { view.NavComplete.Add(a); return; }
        if (evt == "TitleChanged") { view.TitleChanged.Add(a); return; }
        if (evt == "LoadingChanged") { view.LoadingChanged.Add(a); return; }
        On.AddByName(evt, a);
    }

    // ---- 保留式钩子（Control） ---------------------------------------

    /// 绘制：零尺寸时隐藏原生浏览器；首帧前先消费起始地址（原生
    /// 浏览器在 Render 里才创建，创建时会消费这次挂起的导航），然后
    /// 每帧驱动底层浏览器。
    override void OnPaint(App app) {
        if (bw <= 0 || bh <= 0) {
            view.Hide();
            return;
        }
        // 导航要早于第一次 Render：原生浏览器在 Render 里才创建，创建时
        // 会消费这次挂起的导航。
        if (!navigated && startUrl != "") {
            navigated = true;
            view.Navigate(startUrl);
        }
        view.Render(app, bx, by, bw, bh);
    }
}
