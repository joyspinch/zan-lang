using System;

namespace Gui.Component.CefBrowser;

/// <summary>
/// Cookie 读写，走 CDP（<see cref="CefCdp"/>）。回复是异步到达的，所以每个
/// 查询都带一个回调：
///
/// <code>
/// CefCookies ck = web.Cookies();
/// ck.GetAll((json) => { Console.WriteLine(json); });   // {"cookies":[...]}
/// ck.Set("token", "abc", ".example.com", "/", true);
/// ck.Delete("token", ".example.com");
/// </code>
///
/// 值都是 CDP 的原始 JSON（Network.Cookie 结构），因为 Cookie 的字段还在随
/// Chromium 演进（SameParty、partitionKey…），包一层强类型只会挡住新字段。
/// Cookie 存在 profile 目录里（<see cref="CefOptions.profileDir"/>），
/// 由 Chromium 自己落盘，不需要显式 flush。
/// </summary>
class CefCookies {
    CefCdp cdp;
    bool networkOn;

    CefCookies(CefCdp channel) {
        cdp = channel;
        networkOn = false;
    }

    /// <summary>Network 域的 Cookie 命令要先 enable。</summary>
    void EnsureNetwork() {
        if (networkOn) { return; }
        cdp.Enable("Network");
        networkOn = true;
    }

    /// <summary>全部 Cookie（浏览器级）。回调收到
    /// `{"cookies":[{"name":...,"value":...,"domain":...},...]}`。</summary>
    int GetAll(CdpEventFn onResult) {
        return cdp.Send("Storage.getCookies", "{}", onResult);
    }

    /// <summary>某些 URL 下可见的 Cookie；<paramref name="urls"/> 为空表示当前
    /// 页面。</summary>
    int GetForUrl(string url, CdpEventFn onResult) {
        EnsureNetwork();
        string p = "{}";
        if (url != "") {
            p = "{\"urls\":[" + CefBrowser.JsonString(url) + "]}";
        }
        return cdp.Send("Network.getCookies", p, onResult);
    }

    /// <summary>按 domain/path 写一个 Cookie（会话 Cookie：不带 expires）。
    /// </summary>
    int Set(string name, string value, string domain, string path,
            bool secure) {
        return SetJson(CefCookies.Param(name, value, domain, path, secure,
                                        "", 0 - 1));
    }

    /// <summary>按 domain/path 写一个持久 Cookie，
    /// <paramref name="expiresUnixSeconds"/> 是绝对过期时间（UNIX 秒）。
    /// </summary>
    int SetPersistent(string name, string value, string domain, string path,
                      bool secure, long expiresUnixSeconds) {
        return SetJson(CefCookies.Param(name, value, domain, path, secure, "",
                                        expiresUnixSeconds));
    }

    /// <summary>按 URL 写一个 Cookie（domain/path 由 URL 推出）。</summary>
    int SetForUrl(string url, string name, string value) {
        return SetJson(CefCookies.Param(name, value, "", "", false, url,
                                        0 - 1));
    }

    /// <summary>写一个自己拼的 Network.CookieParam JSON（要用上 Chromium 的新
    /// 字段时）。</summary>
    int SetJson(string cookieParamJson) {
        return cdp.Send("Storage.setCookies",
                        "{\"cookies\":[" + cookieParamJson + "]}", null);
    }

    /// <summary>删除匹配 name + domain 的 Cookie。</summary>
    int Delete(string name, string domain) {
        EnsureNetwork();
        return cdp.Send("Network.deleteCookies",
            "{\"name\":" + CefBrowser.JsonString(name)
            + ",\"domain\":" + CefBrowser.JsonString(domain) + "}", null);
    }

    /// <summary>删除某个 URL 下匹配 name 的 Cookie。</summary>
    int DeleteForUrl(string name, string url) {
        EnsureNetwork();
        return cdp.Send("Network.deleteCookies",
            "{\"name\":" + CefBrowser.JsonString(name)
            + ",\"url\":" + CefBrowser.JsonString(url) + "}", null);
    }

    /// <summary>清空全部 Cookie。</summary>
    int Clear() {
        return cdp.Send("Storage.clearCookies", "{}", null);
    }

    /// <summary>拼一条 Network.CookieParam。url 非空时用 url 形式，否则
    /// domain/path；expires &lt; 0 表示会话 Cookie。</summary>
    static string Param(string name, string value, string domain, string path,
                        bool secure, string url, long expires) {
        StringBuilder sb = new StringBuilder();
        sb.Append("{\"name\":");
        sb.Append(CefBrowser.JsonString(name));
        sb.Append(",\"value\":");
        sb.Append(CefBrowser.JsonString(value));
        if (url != "") {
            sb.Append(",\"url\":");
            sb.Append(CefBrowser.JsonString(url));
        }
        if (domain != "") {
            sb.Append(",\"domain\":");
            sb.Append(CefBrowser.JsonString(domain));
        }
        if (path != "") {
            sb.Append(",\"path\":");
            sb.Append(CefBrowser.JsonString(path));
        }
        if (secure) { sb.Append(",\"secure\":true"); }
        if (expires >= 0) {
            sb.Append(",\"expires\":");
            sb.Append(expires.ToString());
        }
        sb.Append("}");
        return sb.ToString();
    }
}
