using System;
using Gui;
using Gui.Widget;
using Gui.Component.CodeEditor;

namespace Gui.Component;

/// LogView 的滚动和文本选择状态，由调用方持有，
/// 使视图在帧间保持位置。
class LogState {
    int scroll;     // 从末尾向上滚动的行数；0 表示跟随最新一行
    int selR0;      // 选择锚点行，无选择时为 -1
    int selC0;
    int selR1;      // 选择端点的行/列（可能位于锚点之前）
    int selC1;
    bool selDrag;
    bool barDrag;

    LogState() {
        this.scroll = 0;
        this.selR0 = 0 - 1; this.selC0 = 0;
        this.selR1 = 0 - 1; this.selC1 = 0;
        this.selDrag = false;
        this.barDrag = false;
    }

    void ClearSelection() {
        selR0 = 0 - 1; selC0 = 0;
        selR1 = 0 - 1; selC1 = 0;
    }

    /// 选择至少跨越一个字符时为 true。
    bool HasSelection() {
        if (selR0 < 0) { return false; }
        return !(selR0 == selR1 && selC0 == selC1);
    }

    void Reset() {
        scroll = 0;
        ClearSelection();
    }
}

/// 尾部滚动、可选择的文本日志（控制台视图）：最新一行位于
/// 底部，滚轮和可拖拽的滚动条可回溯历史，
/// 指针可跨行选择文本。行颜色由
/// 调用方提供，视图无需知道自己在记录什么。
class LogView {
    static int RowHeight(App app) { return app.Scale(18); }
    static int Padding(App app) { return app.Scale(6); }

    /// 高度为 `h` 的视图中能容纳的行数。
    static int VisibleRows(App app, int h) {
        int rows = h / LogView.RowHeight(app);
        if (rows < 1) { rows = 1; }
        return rows;
    }

    /// 给定滚动位置下绘制的第一行的索引。
    static int FirstRow(App app, int h, int count, int scroll) {
        int maxScroll = count - LogView.VisibleRows(app, h);
        if (maxScroll < 0) { maxScroll = 0; }
        if (scroll < 0) { scroll = 0; }
        if (scroll > maxScroll) { scroll = maxScroll; }
        return maxScroll - scroll;
    }

    /// `mouseY` 下的行索引；日志为空时为 -1。
    static int RowAt(App app, int y, int h, int count, int scroll, int mouseY) {
        if (count == 0) { return 0 - 1; }
        int rel = (mouseY - (y + LogView.Padding(app))) / LogView.RowHeight(app);
        if (rel < 0) { rel = 0; }
        int ri = LogView.FirstRow(app, h, count, scroll) + rel;
        if (ri < 0) { ri = 0; }
        if (ri >= count) { ri = count - 1; }
        return ri;
    }

    /// `line` 中最接近 `mouseX` 的字符边界。
    static int ColAt(string line, int textX, int fontSize, int mouseX) {
        for (int i = 0; i < line.Length; i = i + 1) {
            int wa = Canvas.MeasureText(Text.Left(line, i), fontSize);
            int wb = Canvas.MeasureText(Text.Left(line, i + 1), fontSize);
            if (mouseX < textX + (wa + wb) / 2) { return i; }
        }
        return line.Length;
    }

    /// `lines` 中被选中的文本，以换行连接（无选中时为
    /// ""）。
    static string SelectionText(List<string> lines, LogState st) {
        if (!st.HasSelection()) { return ""; }
        int r0 = st.selR0; int c0 = st.selC0;
        int r1 = st.selR1; int c1 = st.selC1;
        if (r0 > r1 || (r0 == r1 && c0 > c1)) {
            int tr = r0; r0 = r1; r1 = tr;
            int tc = c0; c0 = c1; c1 = tc;
        }
        string outp = "";
        int r = r0;
        while (r <= r1 && r < lines.Count) {
            string ln = lines[r];
            int s = 0;
            int e = ln.Length;
            if (r == r0) { s = c0; }
            if (r == r1) { e = c1; }
            if (s < 0) { s = 0; }
            if (e > ln.Length) { e = ln.Length; }
            if (s > e) { s = e; }
            outp = outp + ln.Substring(s, e - s);
            if (r < r1) { outp = outp + "\n"; }
            r = r + 1;
        }
        return outp;
    }

    /// 在 x,y,w,h 中绘制日志，并处理滚轮滚动、滚动条拖拽
    /// 和拖拽选择。`colors` 为空（每行使用主题的
    /// 主文本色）或与 `lines` 平行，其中 0 也表示
    /// "主题默认"。无内容可显示时绘制 `emptyText`。
    /// 传 `interactive` 为 false 可绘制指针不响应的日志。
    static void Render(App app, int x, int y, int w, int h,
                       List<string> lines, List<int> colors, LogState st,
                       string emptyText, bool interactive) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        if (w <= 0 || h <= 0) { return; }
        StyleBox normal = Style.Part(app, "logview", "text", "", "",
                                     "", Style.SNormal());
        StyleBox empty = Style.Part(app, "logview", "empty", "", "",
                                    "", Style.SNormal());

        int rowH = LogView.RowHeight(app);
        int pad = LogView.Padding(app);
        int maxRows = LogView.VisibleRows(app, h);
        int count = lines.Count;
        int maxScroll = count - maxRows;
        if (maxScroll < 0) { maxScroll = 0; }

        if (interactive) { LogView.HandleInput(app, x, y, w, h, lines, st); }
        if (st.scroll < 0) { st.scroll = 0; }
        if (st.scroll > maxScroll) { st.scroll = maxScroll; }

        if (count == 0) {
            if (emptyText != "") {
                c.DrawText(x + pad, y + pad, emptyText, empty.FgOr(0),
                           empty.FontOr(t.fontSizeSmall));
            }
            return;
        }

        int r0 = st.selR0; int c0 = st.selC0;
        int r1 = st.selR1; int c1 = st.selC1;
        if (r0 >= 0 && (r0 > r1 || (r0 == r1 && c0 > c1))) {
            int tr = r0; r0 = r1; r1 = tr;
            int tc = c0; c0 = c1; c1 = tc;
        }

        EditorPalette pal = EditorPalette.For(t);
        c.PushClip(x, y, w, h);
        int ri = LogView.FirstRow(app, h, count, st.scroll);
        int cy = y + pad;
        while (ri < count && cy + rowH <= y + h) {
            string ln = lines[ri];
            if (r0 >= 0 && ri >= r0 && ri <= r1) {
                int hs = 0;
                int he = ln.Length;
                if (ri == r0) { hs = c0; }
                if (ri == r1) { he = c1; }
                if (hs < 0) { hs = 0; }
                if (he > ln.Length) { he = ln.Length; }
                if (hs > he) { hs = he; }
                int hx0 = x + pad + Canvas.MeasureText(Text.Left(ln, hs), t.fontSizeSmall);
                int hx1 = x + pad + Canvas.MeasureText(Text.Left(ln, he), t.fontSizeSmall);
                // 完全位于多行选择内部的某行，其高亮要越过最后一个字形，
                // 这样行尾的换行符看起来也被选中。
                if (ri < r1) { hx1 = hx1 + pad; }
                if (hx1 < hx0 + 2) { hx1 = hx0 + 2; }
                c.FillRect(hx0, cy, hx1 - hx0, rowH, pal.selection);
            }
            int col = normal.FgOr(0);
            if (ri < colors.Count && colors[ri] != 0) { col = colors[ri]; }
            c.DrawText(x + pad, cy, ln, col, t.fontSizeSmall);
            cy = cy + rowH;
            ri = ri + 1;
        }
        c.PopClip();

        if (count > maxRows) {
            int barW = app.Scale(10);
            Scrollbar.RenderVertical(app, x + w - barW, y + pad, maxRows * rowH,
                count * rowH,
                LogView.FirstRow(app, h, count, st.scroll) * rowH);
            // 日志常延伸到窗口边缘，在那里窗口框架的调整大小
            // 握把会抢在滚动条之前响应按下。
            app.ReserveEdgeHit(x + w - barW, y, barW, h);
        }
    }

    /// 日志主体的滚轮、滚动条拖拽和拖拽选择。
    static void HandleInput(App app, int x, int y, int w, int h,
                            List<string> lines, LogState st) {
        Theme t = app.theme;
        int rowH = LogView.RowHeight(app);
        int pad = LogView.Padding(app);
        int maxRows = LogView.VisibleRows(app, h);
        int count = lines.Count;
        int maxScroll = count - maxRows;
        if (maxScroll < 0) { maxScroll = 0; }
        int kind = app.EventKind();

        // 在主体上注册命中区域，让指针移动事件在
        // 拖拽进行期间持续送达。
        int id = app.focus.AllocId();
        app.hitTester.RegisterRect(id, x, y, w, h, 1);

        if (app.CaptureWheel(x, y, w, h) && kind == 13) {
            int wd = app.window.EventKeyCode();
            int step = wd / 120;
            if (step == 0) {
                if (wd > 0) { step = 1; }
                else if (wd < 0) { step = 0 - 1; }
            }
            st.scroll = st.scroll + step;
            app.RequestRedraw();
        }

        int barW = app.Scale(10);
        int barX = x + w - barW;
        bool barVisible = count > maxRows;
        bool overBar = barVisible && Ui.Over(app, barX, y, barW, h);

        if (kind == 2 && app.window.EventButton() == 0 && overBar) { st.barDrag = true; }
        if (st.barDrag && (kind == 1 || kind == 2)) {
            int contentPx = count * rowH;
            int viewPx = maxRows * rowH;
            int thumbH = viewPx * viewPx / contentPx;
            int minThumb = app.Scale(20);
            if (thumbH < minThumb) { thumbH = minThumb; }
            int travel = viewPx - thumbH;
            if (travel < 1) { travel = 1; }
            int rel = (app.mouseY - thumbH / 2) - (y + pad);
            if (rel < 0) { rel = 0; }
            int firstRow = rel * (contentPx - viewPx) / travel / rowH;
            if (firstRow < 0) { firstRow = 0; }
            if (firstRow > maxScroll) { firstRow = maxScroll; }
            st.scroll = maxScroll - firstRow;
            app.RequestRedraw();
        }
        if (kind == 3) { st.barDrag = false; }

        bool overBody = !overBar && !st.barDrag && Ui.Over(app, x, y, w, h);

        if (kind == 2 && app.window.EventButton() == 0 && overBody) {
            int rr = LogView.RowAt(app, y, h, count, st.scroll, app.mouseY);
            int cc = 0;
            if (rr >= 0) {
                cc = LogView.ColAt(lines[rr], x + pad, t.fontSizeSmall, app.mouseX);
            }
            st.selR0 = rr; st.selC0 = cc;
            st.selR1 = rr; st.selC1 = cc;
            st.selDrag = true;
            app.RequestRedraw();
        }
        if (kind == 1 && st.selDrag) {
            int rr = LogView.RowAt(app, y, h, count, st.scroll, app.mouseY);
            int cc = 0;
            if (rr >= 0) {
                cc = LogView.ColAt(lines[rr], x + pad, t.fontSizeSmall, app.mouseX);
            }
            st.selR1 = rr; st.selC1 = cc;
            app.RequestRedraw();
        }
        if (kind == 3 && st.selDrag) {
            st.selDrag = false;
            app.RequestRedraw();
        }
    }
}
