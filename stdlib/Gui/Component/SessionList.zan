using System;
using Gui;
using Gui.Widget;

namespace Gui.Component;

/// SessionList 在单帧内报告的内容：切换、删除或新建聊天点击中至多一个。
/// 索引指向调用方自己的标题列表，
/// 宿主可直接将它们映射回自己的会话。
class SessionListAction {
    int selected;   // 用户点击以切换到的索引，或 -1
    int deleted;    // 其删除按钮 (x) 被点击的索引，或 -1
    int archived;   // 其归档框被点击的索引，或 -1
    bool created;   // "新建"按钮被点击
    int renamed;    // 用户刚为其输入新名称的索引，或 -1
    string title;   // 该新名称（仅与 `renamed` 一起有意义）

    static SessionListAction None() {
        SessionListAction a = new SessionListAction();
        a.selected = 0 - 1;
        a.deleted = 0 - 1;
        a.archived = 0 - 1;
        a.created = false;
        a.renamed = 0 - 1;
        a.title = "";
        return a;
    }

    bool Any() {
        return selected >= 0 || deleted >= 0 || archived >= 0 || created
            || renamed >= 0;
    }
}

/// 一个垂直、可搜索的命名条目列表，每行带删除按钮，顶部有
/// "新建"按钮——即聊天/会话侧边栏，保持通用：它只管理
/// 自己的搜索框和滚动，对行的含义一无所知。
/// 宿主每帧传入标题和活动索引，并
/// 根据返回的 SessionListAction 采取行动。
///
///     SessionList nav = new SessionList("Search chats...", "New chat");
///     ...
///     SessionListAction a = nav.Render(app, x, y, w, h, titles, current);
///     if (a.created) { ... }
///     if (a.selected >= 0) { ... }
///     if (a.deleted >= 0) { ... }
class SessionList {
    Input search;
    SignalInt scroll;
    Button newBtn;
    string emptyText;
    /// 底部开关：归档行在开启前保持隐藏。
    bool showArchived;
    string archiveTip;
    string deleteTip;
    string archivedLabel;
    string renameTip;
    /// 行内重命名：正在编辑的行（-1 表示无）及其字段。从第一条消息
    /// 推导出的标题只是猜测；用户有权决定
    /// 聊天叫什么。
    int editing;
    Input rename;
    bool takeFocus;

    SessionList(string searchHint, string newLabel) {
        this.search = new Input(searchHint);
        this.scroll = new SignalInt(0);
        this.newBtn = new Button { Text = newLabel, Class = "primary small" };
        this.emptyText = "";
        this.showArchived = false;
        this.archiveTip = "";
        this.deleteTip = "";
        this.archivedLabel = "Archived";
        this.renameTip = "";
        this.editing = 0 - 1;
        this.rename = new Input("");
        this.takeFocus = false;
    }

    /// 每行归档/删除点击区域以及底部开关的标签，
    /// 让宿主掌握措辞（及其翻译）。
    SessionList Labels(string archive, string delete, string archived) {
        archiveTip = archive;
        deleteTip = delete;
        archivedLabel = archived;
        return this;
    }

    /// 每行重命名框的提示（"" = 无）。
    SessionList RenameLabel(string rename2) { renameTip = rename2; return this; }

    /// 停止任何进行中的重命名（例如宿主在列表下方切换数据时）。
    void CancelRename() { editing = 0 - 1; }

    /// 无行匹配当前搜索时居中绘制的文本（"" = 无）。
    SessionList EmptyText(string text) { emptyText = text; return this; }

    /// 当前搜索文本，宿主也可据此过滤自己的状态。
    string Query() { return search.GetText(); }

    static int RowH(App app) { return app.Scale(30); }

    // 对 UTF-8 字节的不区分 ASCII 大小写的子串测试：只有 A-Z 折叠，
    // 因此中文标题精确匹配，拉丁查询忽略大小写。
    static int Fold(int b) {
        if (b >= 65 && b <= 90) { return b + 32; }
        return b;
    }

    static bool CiContains(string hay, string needle) {
        int m = needle.Length;
        if (m == 0) { return true; }
        int n = hay.Length;
        for (int i = 0; i + m <= n; i = i + 1) {
            int k = 0;
            for (; k < m; k = k + 1) {
                if (SessionList.Fold(hay[i + k]) != SessionList.Fold(needle[k])) {
                    k = 0 - 1;
                    break;
                }
            }
            if (k == m) { return true; }
        }
        return false;
    }

    /// 在给定矩形中绘制整个侧边栏，并返回被点击的内容。
    SessionListAction Render(App app, int x, int y, int w, int h,
                             List<string> titles, int cur) {
        return this.RenderEx(app, x, y, w, h, titles, cur, new List<int>());
    }

    /// 同上，但每个标题带归档标志（1 = 已归档）。归档行
    /// 隐藏在底部开关之后，每行在其删除叉号旁
    /// 多一个归档框。
    SessionListAction RenderEx(App app, int x, int y, int w, int h,
                               List<string> titles, int cur,
                               List<int> archived) {
        SessionListAction act = SessionListAction.None();
        Canvas c = app.canvas;
        Theme t = app.theme;
        int pad = app.Scale(6);
        int gap = app.Scale(6);

        int newId = newBtn.Render(app, x, y, w);
        if (Ui.Clicked(app, newId)) { act.created = true; }
        int nbH = newBtn.AutoHeight(app);

        int sy = y + nbH + gap;
        int srH = app.Scale(28);
        search.Render(app, x, sy, w, srH);
        StyleBox filter = Style.Part(app, "sessionlist", "filter", "", "",
                                     "", Style.SNormal());
        StyleBox filterHover = Style.Part(app, "sessionlist", "filter", "",
                                          "", "", Style.SHover());

        int ly = sy + srH + gap;
        int lh = y + h - ly;
        // 用于"已归档 (n)"开关的底部条带，独立于列表之外。
        int archCount = 0;
        for (int aci = 0; aci < titles.Count; aci = aci + 1) {
            if (aci < archived.Count && archived[aci] != 0) {
                archCount = archCount + 1;
            }
        }
        int footH = 0;
        if (archCount > 0) { footH = app.Scale(26); }
        lh = lh - footH;
        if (lh < app.Scale(20)) { lh = app.Scale(20); }

        string q = search.GetText();
        List<int> vis = new List<int>();
        for (int ti = 0; ti < titles.Count; ti = ti + 1) {
            bool isArch = ti < archived.Count && archived[ti] != 0;
            if ((showArchived || !isArch) && SessionList.CiContains(titles[ti], q)) {
                vis.Add(ti);
            }
        }

        if (footH > 0) {
            int fy = ly + lh;
            int ftId = app.focus.AllocId();
            app.hitTester.RegisterRect(ftId, x, fy, w, footH, 0);
            if (app.hitTester.HitTest(app.mouseX, app.mouseY) == ftId
                && app.ClickAvailable()) {
                showArchived = !showArchived;
                app.RequestRedraw();
            }
            int fcol = (showArchived || app.focus.IsHovered(ftId)
                        ? filterHover : filter).FgOr(0);
            string flab = archivedLabel + " (" + Convert.ToString(archCount) + ")";
            StyleBox divider = Style.Part(app, "sessionlist", "divider", "", "",
                                          "", Style.SNormal());
            c.FillRect(x, fy, w, 1, divider.BgOr(0));
            c.DrawGlyphIn(showArchived ? "chevron-up" : "chevron-down",
                x + pad, fy, app.Scale(14), footH, t.fontSizeSmall, fcol);
            c.DrawText(x + pad + app.Scale(18),
                Canvas.CenterTextY(fy, footH, t.fontSizeSmall),
                flab, fcol, t.fontSizeSmall);
        }

        if (vis.Count == 0) {
            if (emptyText != "") {
                int fw = Canvas.MeasureText(emptyText, t.fontSizeSmall);
                c.DrawText(x + (w - fw) / 2, ly + app.Scale(10), emptyText,
                    Style.Part(app, "sessionlist", "hint", "", "", "",
                               Style.SNormal()).FgOr(0),
                    t.fontSizeSmall);
            }
            return act;
        }

        int rowH = SessionList.RowH(app);
        int contentH = vis.Count * rowH;
        Scrollbar.HandleWheel(app, x, ly, w, lh, contentH, scroll);
        int maxOff = contentH - lh;
        if (maxOff < 0) { maxOff = 0; }
        if (scroll.Get() > maxOff) { scroll.Set(maxOff); }
        if (scroll.Get() < 0) { scroll.Set(0); }
        int off = scroll.Get();
        bool overflow = contentH > lh;
        int barW = app.Scale(10);
        int rowW = w;
        if (overflow) { rowW = w - barW; }
        int delW = app.Scale(26);
        int arcW = app.Scale(24);
        int renW = app.Scale(22);
        if (editing >= 0 && editing >= titles.Count) { editing = 0 - 1; }
        // Enter 确认新名称，Escape 放弃。在字段读取按键之前
        // 先读取按键，这样提交的文本就是用户输入的，且
        // 列表在同一帧内退出编辑模式。
        if (editing >= 0) {
            int ekind = app.EventKind();
            int ekey = app.window.EventKeyCode();
            if (ekind == 6 && ekey == 13) {
                act.renamed = editing;
                act.title = rename.GetText();
                editing = 0 - 1;
                app.RequestRedraw();
            } else if (ekind == 4 && ekey == 27) {
                editing = 0 - 1;
                app.RequestRedraw();
            }
        }

        StyleBox rowNormal = Style.Full(app, "listrow", "", "", Style.SNormal());
        StyleBox rowSelected = Style.Full(app, "listrow", "", "", Style.SSelected());
        StyleBox rowHover = Style.Full(app, "listrow", "", "", Style.SHover());
        StyleBox divider = Style.Part(app, "sessionlist", "divider", "", "",
                                      "", Style.SNormal());
        StyleBox title = Style.Part(app, "sessionlist", "title", "", "", "",
                                    Style.SNormal());
        StyleBox currentTitle = Style.Part(app, "sessionlist", "title", "",
                                           "current", "",
                                           Style.SNormal());
        StyleBox archivedTitle = Style.Part(app, "sessionlist", "title", "",
                                            "archived", "",
                                            Style.SNormal());
        StyleBox action = Style.Part(app, "sessionlist", "action", "", "", "",
                                     Style.SNormal());
        StyleBox actionHover = Style.Part(app, "sessionlist", "action", "",
                                          "", "", Style.SHover());

        c.PushClip(x, ly, rowW, lh);
        int first = off / rowH;
        int last = (off + lh) / rowH;
        if (last >= vis.Count) { last = vis.Count - 1; }
        int r = first;
        while (r <= last) {
            int orig = vis[r];
            int ry = ly + r * rowH - off;

            bool editRow = orig == editing;
            int selId = app.focus.AllocId();
            if (!editRow) {
                app.hitTester.RegisterRect(selId, x, ry,
                    rowW - delW - arcW - renW, rowH, 0);
            }
            bool selHover = app.focus.IsHovered(selId);
            if (!editRow && app.hitTester.HitTest(app.mouseX, app.mouseY) == selId
                && app.ClickAvailable()) {
                act.selected = orig;
                app.RequestRedraw();
            }

            int renId = app.focus.AllocId();
            app.hitTester.RegisterRect(renId,
                x + rowW - delW - arcW - renW, ry, renW, rowH, 0);
            bool renHover = app.focus.IsHovered(renId);
            if (app.hitTester.HitTest(app.mouseX, app.mouseY) == renId
                && app.ClickAvailable()) {
                editing = orig;
                rename.SetText(titles[orig]);
                takeFocus = true;
                app.RequestRedraw();
            }
            if (renHover && renameTip != "") {
                Tooltip.RequestBox(app, x + rowW - delW - arcW - renW, ry, renW,
                    rowH, renameTip, 0, app.Scale(220));
            }

            int arcId = app.focus.AllocId();
            app.hitTester.RegisterRect(arcId,
                x + rowW - delW - arcW, ry, arcW, rowH, 0);
            bool arcHover = app.focus.IsHovered(arcId);
            if (app.hitTester.HitTest(app.mouseX, app.mouseY) == arcId
                && app.ClickAvailable()) {
                act.archived = orig;
                app.RequestRedraw();
            }
            if (arcHover && archiveTip != "") {
                Tooltip.RequestBox(app, x + rowW - delW - arcW, ry, arcW, rowH,
                    archiveTip, 0, app.Scale(220));
            }

            int delId = app.focus.AllocId();
            app.hitTester.RegisterRect(delId, x + rowW - delW, ry, delW, rowH, 0);
            bool delHover = app.focus.IsHovered(delId);
            if (app.hitTester.HitTest(app.mouseX, app.mouseY) == delId
                && app.ClickAvailable()) {
                act.deleted = orig;
                app.RequestRedraw();
            }
            if (delHover && deleteTip != "") {
                Tooltip.RequestBox(app, x + rowW - delW, ry, delW, rowH,
                    deleteTip, 0, app.Scale(220));
            }

            if (orig == cur) {
                c.FillRect(x, ry, rowW, rowH, rowSelected.BgOr(rowNormal.BgOr(0)));
            } else if (selHover) {
                c.FillRect(x, ry, rowW, rowH, rowHover.BgOr(0));
            }
            if (r > first || off > 0) {
                c.FillRect(x, ry, rowW, 1, divider.BgOr(0));
            }

            int ty = Canvas.CenterTextY(ry, rowH, t.fontSizeSmall);
            bool rowArch = orig < archived.Count && archived[orig] != 0;
            int nameW = rowW - delW - arcW - renW - pad;
            if (editRow) {
                int inH = rowH - app.Scale(6);
                int inId = rename.Render(app, x + pad / 2, ry + app.Scale(3),
                    nameW, inH);
                if (takeFocus) {
                    app.focus.SetFocused(inId);
                    takeFocus = false;
                }
            } else {
                string label = titles[orig];
                if (label == "") { label = "..."; }
                label = Ellipsis.Fit(label, nameW - pad, t.fontSizeSmall);
                StyleBox titleStyle = title;
                if (orig == cur) { titleStyle = currentTitle; }
                if (rowArch) { titleStyle = archivedTitle; }
                int col = titleStyle.FgOr(0);
                c.DrawText(x + pad, ty, label, col, t.fontSizeSmall);
            }

            int rcol = (renHover ? actionHover : action).FgOr(0);
            c.DrawGlyphIn("edit", x + rowW - delW - arcW - renW, ry, renW, rowH,
                t.fontSizeSmall, rcol);

            int acol = (arcHover ? actionHover : action).FgOr(0);
            c.DrawGlyphIn(rowArch ? "upload" : "archive",
                x + rowW - delW - arcW, ry, arcW, rowH, t.fontSizeSmall, acol);

            int dcol = (delHover ? actionHover : action).FgOr(0);
            c.DrawText(x + rowW - delW + app.Scale(9), ty, "×", dcol, t.fontSizeSmall);

            r = r + 1;
        }
        c.PopClip();
        if (overflow) {
            Scrollbar.RenderVerticalScroll(app, x + w - barW, ly, lh, lh, contentH, scroll);
        }
        return act;
    }
}
