using System;

namespace Gui.Component.DataTable;

/// 本地内存查询源。源保存自己的行快照，按 QueryViewport 同步交付一页，
/// 不把当前页位置暴露为业务身份；无自定义键时使用带 temporary 标记的 legacy key。
class LocalDataSource : QueryDataSource {
    List<DataRow> rows;
    RowKeyProvider keyProvider;

    LocalDataSource(List<DataRow> values) {
        this.Setup();
        this.rows = new List<DataRow>();
        this.keyProvider = null;
        this.ReplaceRows(values);
    }

    void ReplaceRows(List<DataRow> values) {
        this.rows = new List<DataRow>();
        if (values != null) {
            for (int i = 0; i < values.Count; i = i + 1) {
                if (values[i] == null) { this.rows.Add(new DataRow()); }
                else { this.rows.Add(values[i].Copy()); }
            }
        }
        this.Refresh();
    }

    void SetKeyProvider(RowKeyProvider provider) {
        this.keyProvider = provider;
        this.Refresh();
    }

    List<DataRow> Snapshot() {
        List<DataRow> result = new List<DataRow>();
        for (int i = 0; i < this.rows.Count; i = i + 1) {
            result.Add(this.rows[i].Copy());
        }
        return result;
    }

    override int RowCount() {
        QueryResult current = this.CurrentResult();
        if (current != null && current.TotalKnown()) { return current.Total(); }
        return this.rows.Count;
    }

    RowKey RawKey(int row) {
        if (row < 0 || row >= this.rows.Count) { return null; }
        if (this.keyProvider != null) { return this.keyProvider.Key(this, row); }
        return RowKey.Legacy(row);
    }

    int SourceRowFor(int row) {
        QueryResult current = this.CurrentResult();
        if (current == null || !current.Covers(row)) {
            current = this.CachedRow(row);
        }
        if (current == null || !current.Covers(row)) { return row; }
        QueryRow queryRow = current.RowAt(row);
        if (queryRow == null || queryRow.Key() == null) { return -1; }
        for (int i = 0; i < this.rows.Count; i = i + 1) {
            RowKey candidate = this.RawKey(i);
            if (candidate != null && candidate.Same(queryRow.Key())) { return i; }
        }
        return -1;
    }

    override bool CellReady(int row, int col) {
        QueryResult current = this.CurrentResult();
        if (current != null && current.Covers(row)) { return true; }
        if (this.CachedRow(row) != null) { return true; }
        return current == null && row >= 0 && row < this.rows.Count;
    }

    override RowKey GetRowKey(int row) {
        QueryResult current = this.CurrentResult();
        if (current != null && current.Covers(row)) {
            QueryRow value = current.RowAt(row);
            if (value != null) { return value.Key(); }
        }
        QueryResult cached = this.CachedRow(row);
        if (cached != null) {
            QueryRow value = cached.RowAt(row);
            if (value != null) { return value.Key(); }
        }
        return this.RawKey(row);
    }

    override string CellText(int row, int col) {
        QueryResult current = this.CurrentResult();
        if (current != null && current.Covers(row)) {
            return current.CellText(row, col);
        }
        QueryResult cached = this.CachedRow(row);
        if (cached != null) { return cached.CellText(row, col); }
        if (current != null || row < 0 || row >= this.rows.Count) { return ""; }
        return this.rows[row].At(col);
    }

    override void SetCell(int row, int col, string value) {
        int sourceRow = this.SourceRowFor(row);
        if (sourceRow < 0 || sourceRow >= this.rows.Count) { return; }
        this.rows[sourceRow].Set(col, value);
        this.Refresh();
    }

    override bool CanInsert() { return true; }

    override bool InsertRow(int at) {
        if (at < 0 || at > this.rows.Count) { return false; }
        this.rows.Insert(at, new DataRow());
        this.Refresh();
        return true;
    }

    override bool RemoveRow(int at) {
        if (at < 0 || at >= this.rows.Count) { return false; }
        this.rows.RemoveAt(at);
        this.Refresh();
        return true;
    }

    int CompareValue(string leftText, string rightText, int kind) {
        if (leftText == null) { leftText = ""; }
        if (rightText == null) { rightText = ""; }
        if (kind == 1) {
            int left = DataTable.ParseInt(leftText);
            int right = DataTable.ParseInt(rightText);
            return left < right ? -1 : (left > right ? 1 : 0);
        }
        if (kind == 2) {
            double left = DataTable.ParseReal(leftText);
            double right = DataTable.ParseReal(rightText);
            return left < right ? -1 : (left > right ? 1 : 0);
        }
        if (kind == 3) {
            bool left = DataTable.ParseBool(leftText);
            bool right = DataTable.ParseBool(rightText);
            return left == right ? 0 : (left ? 1 : -1);
        }
        return DataTable.CompareStr(leftText, rightText);
    }

    bool FilterPass(string value, QueryFilterClause clause) {
        if (value == null) { value = ""; }
        string a = clause.Value();
        string b = clause.Value2();
        int cmp = this.CompareValue(value, a, clause.Kind());
        if (clause.Mode() == QueryFilterMode.Equals) { return cmp == 0; }
        if (clause.Mode() == QueryFilterMode.Contains) {
            if (a.Length == 0) { return true; }
            for (int i = 0; i + a.Length <= value.Length; i = i + 1) {
                if (value.Substring(i, a.Length) == a) { return true; }
            }
            return false;
        }
        if (clause.Mode() == QueryFilterMode.StartsWith) {
            return value.Length >= a.Length && value.Substring(0, a.Length) == a;
        }
        if (clause.Mode() == QueryFilterMode.EndsWith) {
            return value.Length >= a.Length
                && value.Substring(value.Length - a.Length, a.Length) == a;
        }
        if (clause.Mode() == QueryFilterMode.Greater) { return cmp > 0; }
        if (clause.Mode() == QueryFilterMode.GreaterOrEqual) { return cmp >= 0; }
        if (clause.Mode() == QueryFilterMode.Less) { return cmp < 0; }
        if (clause.Mode() == QueryFilterMode.LessOrEqual) { return cmp <= 0; }
        if (clause.Mode() == QueryFilterMode.Between) {
            int hi = this.CompareValue(value, b, clause.Kind());
            return cmp >= 0 && hi <= 0;
        }
        if (clause.Mode() == QueryFilterMode.Empty) { return value.Length == 0; }
        if (clause.Mode() == QueryFilterMode.NotEmpty) { return value.Length > 0; }
        return true;
    }

    bool RowPasses(int row, QueryDescriptor query) {
        for (int i = 0; i < query.Filters().Count; i = i + 1) {
            QueryFilterClause clause = query.Filters()[i];
            if (clause.Column() < 0 || !this.FilterPass(this.rows[row].At(clause.Column()), clause)) {
                return false;
            }
        }
        return true;
    }

    int CompareRows(int left, int right, QueryDescriptor query) {
        for (int i = 0; i < query.Sorts().Count; i = i + 1) {
            QuerySortClause clause = query.Sorts()[i];
            string a = this.rows[left].At(clause.Column());
            string b = this.rows[right].At(clause.Column());
            int cmp = this.CompareValue(a, b, clause.Kind());
            if (cmp != 0) {
                if (clause.Direction() == 2) { cmp = 0 - cmp; }
                return cmp;
            }
        }
        return left < right ? -1 : (left > right ? 1 : 0);
    }

    override QueryResult Execute(QueryDescriptor query,
                                  QueryViewport viewport,
                                  QueryRequestToken token) {
        if (token == null || viewport == null || query == null) { return null; }
        List<int> order = new List<int>();
        for (int row = 0; row < this.rows.Count; row = row + 1) {
            if (this.RowPasses(row, query)) { order.Add(row); }
        }
        for (int i = 1; i < order.Count; i = i + 1) {
            int value = order[i]; int j = i - 1;
            while (j >= 0 && this.CompareRows(order[j], value, query) > 0) {
                order[j + 1] = order[j]; j = j - 1;
            }
            order[j + 1] = value;
        }
        int start = viewport.Start();
        int requested = viewport.Count();
        List<QueryRow> resultRows = new List<QueryRow>();
        int end = start + requested;
        if (end > order.Count) { end = order.Count; }
        for (int pos = start; pos < end; pos = pos + 1) {
            int row = order[pos];
            RowKey key = this.GetRowKey(row);
            if (key == null) { key = RowKey.Legacy(row); }
            resultRows.Add(new QueryRow(key, 0, this.rows[row].Copy()));
        }
        bool more = end < order.Count;
        return new QueryResult(token.RequestId(), token.Generation(),
            token.QueryText(), token.QueryHash(), token.SchemaVersion(), token.ServerRevision(),
            start, requested, viewport.Cursor(), resultRows,
            order.Count, true, more, "", "");
    }
}
