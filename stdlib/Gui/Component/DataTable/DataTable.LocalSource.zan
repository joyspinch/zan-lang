using System;

namespace Gui.Component.DataTable;

/// 单个排序键的预计算值。文本仍直接读取源行；数值和 bool 只在
/// 查询开始时解析一次，避免稳定归并排序的比较热路径反复转换。
class LocalSortColumn {
    int kind;
    List<int> ints;
    List<double> reals;
    List<bool> bools;

    LocalSortColumn(int valueKind) {
        this.kind = valueKind;
        this.ints = new List<int>();
        this.reals = new List<double>();
        this.bools = new List<bool>();
    }

    void Add(string value) {
        if (value == null) { value = ""; }
        if (this.kind == 1) { this.ints.Add(DataTable.ParseInt(value)); }
        else if (this.kind == 2) { this.reals.Add(DataTable.ParseReal(value)); }
        else if (this.kind == 3) { this.bools.Add(DataTable.ParseBool(value)); }
    }

    int IntAt(int row) { return this.ints[row]; }
    double RealAt(int row) { return this.reals[row]; }
    bool BoolAt(int row) { return this.bools[row]; }
}

/// 过滤键的查询内缓存。列值只在 Execute 开始时解析一次，比较器
/// 只读取 primitive 数组；Empty/NotEmpty 仍依据原始文本判断。
class LocalFilterColumn {
    int kind;
    int mode;
    string aText;
    string bText;
    int aInt;
    int bInt;
    double aReal;
    double bReal;
    bool aBool;
    bool bBool;
    List<int> ints;
    List<double> reals;
    List<bool> bools;

    LocalFilterColumn(int valueKind, int op, string a, string b) {
        this.kind = valueKind;
        this.mode = op;
        this.aText = a;
        this.bText = b;
        if (this.aText == null) { this.aText = ""; }
        if (this.bText == null) { this.bText = ""; }
        this.aInt = 0;
        this.bInt = 0;
        this.aReal = 0.0;
        this.bReal = 0.0;
        this.aBool = false;
        this.bBool = false;
        if (this.kind == 1) {
            this.aInt = DataTable.ParseInt(this.aText);
            this.bInt = DataTable.ParseInt(this.bText);
        } else if (this.kind == 2) {
            this.aReal = DataTable.ParseReal(this.aText);
            this.bReal = DataTable.ParseReal(this.bText);
        } else if (this.kind == 3) {
            this.aBool = DataTable.ParseBool(this.aText);
            this.bBool = DataTable.ParseBool(this.bText);
        }
        this.ints = new List<int>();
        this.reals = new List<double>();
        this.bools = new List<bool>();
    }

    void Add(string value) {
        if (value == null) { value = ""; }
        if (this.kind == 1) { this.ints.Add(DataTable.ParseInt(value)); }
        else if (this.kind == 2) { this.reals.Add(DataTable.ParseReal(value)); }
        else if (this.kind == 3) { this.bools.Add(DataTable.ParseBool(value)); }
    }

    bool Pass(string raw, int row) {
        if (raw == null) { raw = ""; }
        if (this.kind == 1) {
            int value = this.ints[row];
            if (this.mode == QueryFilterMode.Equals) { return value == this.aInt; }
            if (this.mode == QueryFilterMode.Greater) { return value > this.aInt; }
            if (this.mode == QueryFilterMode.GreaterOrEqual) { return value >= this.aInt; }
            if (this.mode == QueryFilterMode.Less) { return value < this.aInt; }
            if (this.mode == QueryFilterMode.LessOrEqual) { return value <= this.aInt; }
            if (this.mode == QueryFilterMode.Between) { return value >= this.aInt && value <= this.bInt; }
        } else if (this.kind == 2) {
            double value = this.reals[row];
            if (this.mode == QueryFilterMode.Equals) { return value == this.aReal; }
            if (this.mode == QueryFilterMode.Greater) { return value > this.aReal; }
            if (this.mode == QueryFilterMode.GreaterOrEqual) { return value >= this.aReal; }
            if (this.mode == QueryFilterMode.Less) { return value < this.aReal; }
            if (this.mode == QueryFilterMode.LessOrEqual) { return value <= this.aReal; }
            if (this.mode == QueryFilterMode.Between) { return value >= this.aReal && value <= this.bReal; }
        } else if (this.kind == 3) {
            bool value = this.bools[row];
            if (this.mode == QueryFilterMode.Equals) { return value == this.aBool; }
        }
        return this.mode == QueryFilterMode.Empty ? raw.Length == 0
            : (this.mode == QueryFilterMode.NotEmpty ? raw.Length > 0
            : this.PassText(raw));
    }

    bool PassText(string value) {
        int cmp = DataTable.CompareStr(value, this.aText);
        if (this.mode == QueryFilterMode.Contains) {
            if (this.aText.Length == 0) { return true; }
            for (int i = 0; i + this.aText.Length <= value.Length; i = i + 1) {
                if (value.Substring(i, this.aText.Length) == this.aText) { return true; }
            }
            return false;
        }
        if (this.mode == QueryFilterMode.StartsWith) {
            return value.Length >= this.aText.Length
                && value.Substring(0, this.aText.Length) == this.aText;
        }
        if (this.mode == QueryFilterMode.EndsWith) {
            return value.Length >= this.aText.Length
                && value.Substring(value.Length - this.aText.Length, this.aText.Length) == this.aText;
        }
        if (this.mode == QueryFilterMode.Equals) { return cmp == 0; }
        if (this.mode == QueryFilterMode.Greater) { return cmp > 0; }
        if (this.mode == QueryFilterMode.GreaterOrEqual) { return cmp >= 0; }
        if (this.mode == QueryFilterMode.Less) { return cmp < 0; }
        if (this.mode == QueryFilterMode.LessOrEqual) { return cmp <= 0; }
        if (this.mode == QueryFilterMode.Between) {
            return cmp >= 0 && DataTable.CompareStr(value, this.bText) <= 0;
        }
        return true;
    }
}

/// 本地内存查询源。源保存自己的行快照，按 QueryViewport 同步交付一页，
/// 不把当前页位置暴露为业务身份；无自定义键时使用带 temporary 标记的 legacy key。
class LocalDataSource : QueryDataSource {
    List<DataRow> rows;
    RowKeyProvider keyProvider;

    LocalDataSource(List<DataRow> values) {
        this.Setup();
        this.rows = new List<DataRow>();
        this.keyProvider = null;
        this.ReplaceRows(values);
    }

    override QueryCapabilities Capabilities() {
        return QueryCapabilities.Of(QueryCapabilities.Filter
            + QueryCapabilities.Sort + QueryCapabilities.Page
            + QueryCapabilities.StableKeys + QueryCapabilities.Edit
            + QueryCapabilities.Insert + QueryCapabilities.Delete);
    }

    int ColumnCount() {
        int width = this.DescribeSchema().Count;
        for (int i = 0; i < this.rows.Count; i = i + 1) {
            if (this.rows[i] != null && this.rows[i].Count() > width) {
                width = this.rows[i].Count();
            }
        }
        return width;
    }

    void ReplaceRows(List<DataRow> values) {
        this.rows = new List<DataRow>();
        if (values != null) {
            for (int i = 0; i < values.Count; i = i + 1) {
                if (values[i] == null) { this.rows.Add(new DataRow()); }
                else { this.rows.Add(values[i].Copy()); }
            }
        }
        this.Refresh();
    }

    void SetKeyProvider(RowKeyProvider provider) {
        this.keyProvider = provider;
        this.Refresh();
    }

    List<DataRow> Snapshot() {
        List<DataRow> result = new List<DataRow>();
        for (int i = 0; i < this.rows.Count; i = i + 1) {
            result.Add(this.rows[i].Copy());
        }
        return result;
    }

    override int RowCount() {
        QueryResult current = this.CurrentResult();
        if (current != null && current.TotalKnown()) { return current.Total(); }
        return this.rows.Count;
    }

    RowKey RawKey(int row) {
        if (row < 0 || row >= this.rows.Count) { return null; }
        if (this.keyProvider != null) { return this.keyProvider.Key(this, row); }
        return RowKey.Legacy(row);
    }

    int SourceRowFor(int row) {
        QueryResult current = this.CurrentResult();
        if (current == null || !current.Covers(row)) {
            current = this.CachedRow(row);
        }
        if (current == null || !current.Covers(row)) { return row; }
        QueryRow queryRow = current.RowAt(row);
        if (queryRow == null || queryRow.Key() == null) { return -1; }
        for (int i = 0; i < this.rows.Count; i = i + 1) {
            RowKey candidate = this.RawKey(i);
            if (candidate != null && candidate.Same(queryRow.Key())) { return i; }
        }
        return -1;
    }

    override bool CellReady(int row, int col) {
        QueryResult current = this.CurrentResult();
        if (current != null && current.Covers(row)) { return true; }
        if (this.CachedRow(row) != null) { return true; }
        return current == null && row >= 0 && row < this.rows.Count;
    }

    override RowKey GetRowKey(int row) {
        QueryResult current = this.CurrentResult();
        if (current != null && current.Covers(row)) {
            QueryRow value = current.RowAt(row);
            if (value != null) { return value.Key(); }
        }
        QueryResult cached = this.CachedRow(row);
        if (cached != null) {
            QueryRow value = cached.RowAt(row);
            if (value != null) { return value.Key(); }
        }
        return this.RawKey(row);
    }

    override string CellText(int row, int col) {
        QueryResult current = this.CurrentResult();
        if (current != null && current.Covers(row)) {
            return current.CellText(row, col);
        }
        QueryResult cached = this.CachedRow(row);
        if (cached != null) { return cached.CellText(row, col); }
        if (current != null || row < 0 || row >= this.rows.Count) { return ""; }
        return this.rows[row].At(col);
    }

    override void SetCell(int row, int col, string value) {
        int sourceRow = this.SourceRowFor(row);
        if (sourceRow < 0 || sourceRow >= this.rows.Count) { return; }
        this.rows[sourceRow].Set(col, value);
        this.Refresh();
    }

    override bool CanInsert() { return true; }

    override bool InsertRow(int at) {
        if (at < 0 || at > this.rows.Count) { return false; }
        this.rows.Insert(at, new DataRow());
        this.Refresh();
        return true;
    }

    override bool RemoveRow(int at) {
        if (at < 0 || at >= this.rows.Count) { return false; }
        this.rows.RemoveAt(at);
        this.Refresh();
        return true;
    }

    int CompareValue(string leftText, string rightText, int kind) {
        if (leftText == null) { leftText = ""; }
        if (rightText == null) { rightText = ""; }
        if (kind == 1) {
            int left = DataTable.ParseInt(leftText);
            int right = DataTable.ParseInt(rightText);
            return left < right ? -1 : (left > right ? 1 : 0);
        }
        if (kind == 2) {
            double left = DataTable.ParseReal(leftText);
            double right = DataTable.ParseReal(rightText);
            return left < right ? -1 : (left > right ? 1 : 0);
        }
        if (kind == 3) {
            bool left = DataTable.ParseBool(leftText);
            bool right = DataTable.ParseBool(rightText);
            return left == right ? 0 : (left ? 1 : -1);
        }
        return DataTable.CompareStr(leftText, rightText);
    }

    bool FilterPassValues(string value, int mode, string a, string b, int kind) {
        if (value == null) { value = ""; }
        if (a == null) { a = ""; }
        if (b == null) { b = ""; }
        int cmp = this.CompareValue(value, a, kind);
        if (mode == QueryFilterMode.Equals) { return cmp == 0; }
        if (mode == QueryFilterMode.Contains) {
            if (a.Length == 0) { return true; }
            for (int i = 0; i + a.Length <= value.Length; i = i + 1) {
                if (value.Substring(i, a.Length) == a) { return true; }
            }
            return false;
        }
        if (mode == QueryFilterMode.StartsWith) {
            return value.Length >= a.Length && value.Substring(0, a.Length) == a;
        }
        if (mode == QueryFilterMode.EndsWith) {
            return value.Length >= a.Length
                && value.Substring(value.Length - a.Length, a.Length) == a;
        }
        if (mode == QueryFilterMode.Greater) { return cmp > 0; }
        if (mode == QueryFilterMode.GreaterOrEqual) { return cmp >= 0; }
        if (mode == QueryFilterMode.Less) { return cmp < 0; }
        if (mode == QueryFilterMode.LessOrEqual) { return cmp <= 0; }
        if (mode == QueryFilterMode.Between) {
            int hi = this.CompareValue(value, b, kind);
            return cmp >= 0 && hi <= 0;
        }
        if (mode == QueryFilterMode.Empty) { return value.Length == 0; }
        if (mode == QueryFilterMode.NotEmpty) { return value.Length > 0; }
        return true;
    }

    bool FilterPass(string value, QueryFilterClause clause) {
        if (clause == null) { return false; }
        return this.FilterPassValues(value, clause.Mode(), clause.Value(),
            clause.Value2(), clause.Kind());
    }

    List<LocalFilterColumn> BuildFilterColumns(QueryPlan plan) {
        List<LocalFilterColumn> columns = new List<LocalFilterColumn>();
        for (int i = 0; i < plan.FilterCount(); i = i + 1) {
            LocalFilterColumn column = new LocalFilterColumn(plan.FilterKindAt(i),
                plan.FilterModeAt(i), plan.FilterValueAt(i), plan.FilterValue2At(i));
            for (int row = 0; row < this.rows.Count; row = row + 1) {
                column.Add(this.rows[row].At(plan.FilterColumnAt(i)));
            }
            columns.Add(column);
        }
        return columns;
    }

    bool RowPasses(int row, QueryPlan plan, List<LocalFilterColumn> columns) {
        for (int i = 0; i < plan.FilterCount(); i = i + 1) {
            if (!columns[i].Pass(this.rows[row].At(plan.FilterColumnAt(i)), row)) {
                return false;
            }
        }
        return true;
    }

    List<LocalSortColumn> BuildSortColumns(QueryPlan plan) {
        List<LocalSortColumn> columns = new List<LocalSortColumn>();
        for (int i = 0; i < plan.SortCount(); i = i + 1) {
            LocalSortColumn column = new LocalSortColumn(plan.SortKindAt(i));
            for (int row = 0; row < this.rows.Count; row = row + 1) {
                column.Add(this.rows[row].At(plan.SortColumnAt(i)));
            }
            columns.Add(column);
        }
        return columns;
    }

    int CompareRows(int left, int right, QueryPlan plan,
                    List<LocalSortColumn> columns) {
        for (int i = 0; i < plan.SortCount(); i = i + 1) {
            int kind = plan.SortKindAt(i);
            int cmp = 0;
            if (kind == 1) {
                int a = columns[i].IntAt(left);
                int b = columns[i].IntAt(right);
                cmp = a < b ? -1 : (a > b ? 1 : 0);
            } else if (kind == 2) {
                double a = columns[i].RealAt(left);
                double b = columns[i].RealAt(right);
                cmp = a < b ? -1 : (a > b ? 1 : 0);
            } else if (kind == 3) {
                bool a = columns[i].BoolAt(left);
                bool b = columns[i].BoolAt(right);
                cmp = a == b ? 0 : (a ? 1 : -1);
            } else {
                cmp = DataTable.CompareStr(this.rows[left].At(plan.SortColumnAt(i)),
                    this.rows[right].At(plan.SortColumnAt(i)));
            }
            if (cmp != 0) {
                if (plan.SortDirectionAt(i) == 2) { cmp = 0 - cmp; }
                return cmp;
            }
        }
        return left < right ? -1 : (left > right ? 1 : 0);
    }

    void SortOrder(List<int> order, QueryPlan plan,
                   List<LocalSortColumn> columns) {
        int n = order.Count;
        if (n < 2 || plan.SortCount() == 0) { return; }
        List<int> work = new List<int>();
        for (int i = 0; i < n; i = i + 1) { work.Add(0); }
        int width = 1;
        while (width < n) {
            int left = 0;
            while (left < n) {
                int mid = left + width;
                int right = mid + width;
                if (mid > n) { mid = n; }
                if (right > n) { right = n; }
                int a = left; int b = mid; int outp = left;
                while (a < mid || b < right) {
                    if (b >= right || (a < mid && this.CompareRows(order[a], order[b], plan, columns) <= 0)) {
                        work[outp] = order[a]; a = a + 1;
                    } else {
                        work[outp] = order[b]; b = b + 1;
                    }
                    outp = outp + 1;
                }
                left = right;
            }
            for (int i = 0; i < n; i = i + 1) { order[i] = work[i]; }
            if (width > 1073741823) { width = n; }
            else { width = width * 2; }
        }
    }

    override QueryResult Execute(QueryDescriptor query,
                                  QueryViewport viewport,
                                  QueryRequestToken token) {
        if (token == null || viewport == null || query == null) { return null; }
        QueryPlan plan = query.BuildPlan(this.ColumnCount(), this.Capabilities());
        if (!plan.IsValid()) { return QueryResult.Failure(token, viewport, plan.Error()); }
        List<LocalFilterColumn> filterColumns = this.BuildFilterColumns(plan);
        List<int> order = new List<int>();
        for (int row = 0; row < this.rows.Count; row = row + 1) {
            if (this.RowPasses(row, plan, filterColumns)) { order.Add(row); }
        }
        List<LocalSortColumn> sortColumns = this.BuildSortColumns(plan);
        this.SortOrder(order, plan, sortColumns);
        int start = viewport.Start();
        int requested = viewport.Count();
        List<QueryRow> resultRows = new List<QueryRow>();
        int end = start + requested;
        if (end > order.Count) { end = order.Count; }
        for (int pos = start; pos < end; pos = pos + 1) {
            int row = order[pos];
            RowKey key = this.GetRowKey(row);
            if (key == null) { key = RowKey.Legacy(row); }
            resultRows.Add(new QueryRow(key, 0, this.rows[row].Copy()));
        }
        bool more = end < order.Count;
        return new QueryResult(token.RequestId(), token.Generation(),
            token.QueryText(), token.QueryHash(), token.SchemaVersion(), token.ServerRevision(),
            start, requested, viewport.Cursor(), resultRows,
            order.Count, true, more, "", "");
    }
}
