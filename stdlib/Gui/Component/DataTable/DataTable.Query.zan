using System;
using System.Json;

namespace Gui.Component.DataTable;

/// 查询数据源独立能力。各能力彼此正交，使用位掩码而不是单一
/// ServerControlled 开关，避免把“能服务端排序”误当成“能服务端聚合”。
class QueryCapabilities {
    static const int None = 0;
    static const int Filter = 1;
    static const int Sort = 2;
    static const int Group = 4;
    static const int Aggregate = 8;
    static const int Page = 16;
    static const int StableKeys = 32;
    static const int Edit = 64;
    static const int Insert = 128;
    static const int Delete = 256;
    static const int Server = 512;

    int mask;

    QueryCapabilities(int value) { this.mask = value; }

    static QueryCapabilities Of(int value) {
        return new QueryCapabilities(value);
    }

    int Mask() { return this.mask; }
    bool Has(int capability) { return (this.mask & capability) != 0; }
}

/// 声明式过滤操作。过滤值保持文本形式，执行器按 kind 解释它，
/// 因而本地和远端都能使用同一份可序列化描述。
class QueryFilterMode {
    static const int Equals = 1;
    static const int Contains = 2;
    static const int StartsWith = 3;
    static const int EndsWith = 4;
    static const int Greater = 5;
    static const int GreaterOrEqual = 6;
    static const int Less = 7;
    static const int LessOrEqual = 8;
    static const int Between = 9;
    static const int Empty = 10;
    static const int NotEmpty = 11;
}

/// 一个可传输的过滤谓词。column 是 schema 中的稳定列槽位；kind：
/// 0 文本、1 整数、2 实数、3 bool。
class QueryFilterClause {
    int column;
    int mode;
    int kind;
    string value;
    string value2;

    QueryFilterClause(int col, int op, string a, string b, int valueKind) {
        this.column = col;
        this.mode = op;
        this.kind = valueKind;
        this.value = a;
        if (this.value == null) { this.value = ""; }
        this.value2 = b;
        if (this.value2 == null) { this.value2 = ""; }
    }

    int Column() { return this.column; }
    int Mode() { return this.mode; }
    int Kind() { return this.kind; }
    string Value() { return this.value; }
    string Value2() { return this.value2; }
}

/// 一个可传输的稳定排序键。多个键按添加顺序组成字典序。
/// kind 与 QueryFilterClause 相同。
class QuerySortClause {
    int column;
    int direction;
    int kind;

    QuerySortClause(int col, int dir, int valueKind) {
        this.column = col;
        this.direction = dir;
        this.kind = valueKind;
    }

    int Column() { return this.column; }
    int Direction() { return this.direction; }
    int Kind() { return this.kind; }
}

/// 可传给本地/远端查询执行器的稳定查询快照。
/// 过滤器和排序键只使用声明式标量，不捕获 lambda 或 UI 对象，
/// 因而可以直接序列化、哈希和下推到服务端。
class QueryDescriptor {
    static const int FormatVersion = 1;

    int version;
    string dataset;
    int dataRevision;
    int queryRevision;
    int viewRevision;
    int capabilities;
    List<QueryFilterClause> filters;
    List<QuerySortClause> sorts;

    QueryDescriptor(string datasetName, int dataRev, int queryRev,
                    int viewRev, int caps) {
        this.version = QueryDescriptor.FormatVersion;
        if (datasetName == null) { datasetName = ""; }
        this.dataset = datasetName;
        this.dataRevision = dataRev;
        this.queryRevision = queryRev;
        this.viewRevision = viewRev;
        this.capabilities = caps;
        this.filters = new List<QueryFilterClause>();
        this.sorts = new List<QuerySortClause>();
    }

    static QueryDescriptor Of(DataTableState st, string datasetName, int caps) {
        return new QueryDescriptor(datasetName, st.dataRevision,
            st.queryRevision, st.viewRevision, caps);
    }

    string Dataset() { return this.dataset; }
    int DataRevision() { return this.dataRevision; }
    int QueryRevision() { return this.queryRevision; }
    int ViewRevision() { return this.viewRevision; }
    int Capabilities() { return this.capabilities; }
    List<QueryFilterClause> Filters() { return this.filters; }
    List<QuerySortClause> Sorts() { return this.sorts; }

    void AddFilter(QueryFilterClause clause) {
        if (clause != null) { this.filters.Add(clause); }
    }

    void AddSort(QuerySortClause clause) {
        if (clause != null) { this.sorts.Add(clause); }
    }

    void ClearFilters() { this.filters.Clear(); }
    void ClearSorts() { this.sorts.Clear(); }

    QueryPlan BuildPlan(int columnCount, QueryCapabilities supported) {
        return QueryPlan.Build(this, columnCount, supported);
    }

    /// 逻辑查询相同的判断不包含 viewRevision；列宽、隐藏和冻结不应
    /// 让远端查询缓存失效。
    bool SameQuery(QueryDescriptor other) {
        if (other == null) { return false; }
        return this.version == other.version
            && this.dataset == other.dataset
            && this.dataRevision == other.dataRevision
            && this.queryRevision == other.queryRevision
            && this.capabilities == other.capabilities
            && this.QueryJson() == other.QueryJson();
    }

    /// 渲染/显示快照是否仍对应当前状态。
    bool IsCurrent(DataTableState st) {
        if (st == null) { return false; }
        return this.dataRevision == st.dataRevision
            && this.queryRevision == st.queryRevision
            && this.viewRevision == st.viewRevision;
    }

    JsonValue FilterJson(QueryFilterClause clause) {
        JsonValue value = JsonValue.NewObject();
        value.Put("col", JsonValue.NewNum(Convert.ToString(clause.Column())));
        value.Put("op", JsonValue.NewNum(Convert.ToString(clause.Mode())));
        value.Put("kind", JsonValue.NewNum(Convert.ToString(clause.Kind())));
        value.Put("a", JsonValue.NewStr(clause.Value()));
        value.Put("b", JsonValue.NewStr(clause.Value2()));
        return value;
    }

    JsonValue SortJson(QuerySortClause clause) {
        JsonValue value = JsonValue.NewObject();
        value.Put("col", JsonValue.NewNum(Convert.ToString(clause.Column())));
        value.Put("dir", JsonValue.NewNum(Convert.ToString(clause.Direction())));
        value.Put("kind", JsonValue.NewNum(Convert.ToString(clause.Kind())));
        return value;
    }

    JsonValue ToJsonValue() {
        JsonValue root = JsonValue.NewObject();
        // 字段写入顺序固定，ToJson() 可作为稳定 canonical 文本。
        root.Put("ver", JsonValue.NewNum(Convert.ToString(this.version)));
        root.Put("dataset", JsonValue.NewStr(this.dataset));
        root.Put("data", JsonValue.NewNum(Convert.ToString(this.dataRevision)));
        root.Put("query", JsonValue.NewNum(Convert.ToString(this.queryRevision)));
        root.Put("view", JsonValue.NewNum(Convert.ToString(this.viewRevision)));
        root.Put("caps", JsonValue.NewNum(Convert.ToString(this.capabilities)));
        JsonValue filters = JsonValue.NewArray();
        for (int i = 0; i < this.filters.Count; i = i + 1) {
            filters.Append(this.FilterJson(this.filters[i]));
        }
        if (this.filters.Count > 0) { root.Put("filters", filters); }
        JsonValue sorts = JsonValue.NewArray();
        for (int i = 0; i < this.sorts.Count; i = i + 1) {
            sorts.Append(this.SortJson(this.sorts[i]));
        }
        if (this.sorts.Count > 0) { root.Put("sorts", sorts); }
        return root;
    }

    string ToJson() { return this.ToJsonValue().ToJson(); }

    /// 供查询执行和页缓存使用的逻辑 canonical。视图 revision 不属于
    /// 数据内容身份；列宽、隐藏和冻结变化不应丢弃已获取的查询页。
    string QueryJson() {
        JsonValue root = JsonValue.NewObject();
        root.Put("ver", JsonValue.NewNum(Convert.ToString(this.version)));
        root.Put("dataset", JsonValue.NewStr(this.dataset));
        root.Put("data", JsonValue.NewNum(Convert.ToString(this.dataRevision)));
        root.Put("query", JsonValue.NewNum(Convert.ToString(this.queryRevision)));
        root.Put("caps", JsonValue.NewNum(Convert.ToString(this.capabilities)));
        JsonValue filters = JsonValue.NewArray();
        for (int i = 0; i < this.filters.Count; i = i + 1) {
            filters.Append(this.FilterJson(this.filters[i]));
        }
        if (this.filters.Count > 0) { root.Put("filters", filters); }
        JsonValue sorts = JsonValue.NewArray();
        for (int i = 0; i < this.sorts.Count; i = i + 1) {
            sorts.Append(this.SortJson(this.sorts[i]));
        }
        if (this.sorts.Count > 0) { root.Put("sorts", sorts); }
        return root.ToJson();
    }

    /// FNV-1a 的 30 位稳定查询指纹；只是缓存键辅助，不替代文本比较。
    int QueryFingerprint() {
        int h = 2166136261;
        string text = this.QueryJson();
        for (int i = 0; i < text.Length; i = i + 1) {
            h = ((h ^ ((int)text[i] & 255)) * 16777619) & 1073741823;
        }
        return h;
    }

    /// 完整描述的旧入口保留兼容；查询缓存使用 QueryFingerprint。
    int Fingerprint() {
        int h = 2166136261;
        string text = this.ToJson();
        for (int i = 0; i < text.Length; i = i + 1) {
            h = ((h ^ ((int)text[i] & 255)) * 16777619) & 1073741823;
        }
        return h;
    }

    static QueryDescriptor FromJson(string text) {
        if (text == null || text.Length == 0) { return null; }
        JsonValue root = JsonValue.ParseLenient(text);
        if (root == null || !root.IsObject()) { return null; }
        if (!root.Has("ver") || !root.Has("dataset") || !root.Has("data")
            || !root.Has("query") || !root.Has("view") || !root.Has("caps")) {
            return null;
        }
        if (root.Int("ver", 0) != QueryDescriptor.FormatVersion) { return null; }
        int dataRev = root.Int("data", -1);
        int queryRev = root.Int("query", -1);
        int viewRev = root.Int("view", -1);
        int caps = root.Int("caps", -1);
        if (dataRev < 0 || queryRev < 0 || viewRev < 0 || caps < 0) { return null; }
        QueryDescriptor result = new QueryDescriptor(root.Str("dataset", ""),
            dataRev, queryRev, viewRev, caps);
        JsonValue filters = root.Get("filters");
        if (filters != null) {
            if (!filters.IsArray()) { return null; }
            for (int i = 0; i < filters.Count(); i = i + 1) {
                JsonValue item = filters.At(i);
                if (item == null || !item.IsObject()
                    || !item.Has("col") || !item.Has("op") || !item.Has("kind")
                    || !item.Has("a") || !item.Has("b")) { return null; }
                int col = item.Int("col", -1);
                int op = item.Int("op", 0);
                int kind = item.Int("kind", -1);
                if (col < 0 || op < QueryFilterMode.Equals
                    || op > QueryFilterMode.NotEmpty || kind < 0 || kind > 3) {
                    return null;
                }
                result.AddFilter(new QueryFilterClause(col, op,
                    item.Str("a", ""), item.Str("b", ""), kind));
            }
        }
        JsonValue sorts = root.Get("sorts");
        if (sorts != null) {
            if (!sorts.IsArray()) { return null; }
            for (int i = 0; i < sorts.Count(); i = i + 1) {
                JsonValue item = sorts.At(i);
                if (item == null || !item.IsObject()
                    || !item.Has("col") || !item.Has("dir") || !item.Has("kind")) {
                    return null;
                }
                int col = item.Int("col", -1);
                int dir = item.Int("dir", 0);
                int kind = item.Int("kind", -1);
                if (col < 0 || (dir != 1 && dir != 2) || kind < 0 || kind > 3) {
                    return null;
                }
                result.AddSort(new QuerySortClause(col, dir, kind));
            }
        }
        return result;
    }
}

partial class DataTable {
    /// 数据内容、行键或 schema 改变：所有派生查询和显示结果失效。
    static void InvalidateData(DataTableState st) {
        st.dataRevision = st.dataRevision + 1;
        st.queryRevision = st.queryRevision + 1;
        st.viewRevision = st.viewRevision + 1;
        st.rowKeysRevision = -1;
        st.rowKeys.Clear();
        st.dirty = true;
    }

    /// 过滤、排序、分组、汇总或分页参数改变：数据身份不变，
    /// 只使查询和依赖它的显示模型失效。
    static void InvalidateQuery(DataTableState st) {
        st.queryRevision = st.queryRevision + 1;
        st.viewRevision = st.viewRevision + 1;
        st.dirty = true;
    }

    /// 列宽、顺序、隐藏、冻结或主题显示状态改变：只使几何/帧失效。
    static void InvalidateView(DataTableState st) {
        st.viewRevision = st.viewRevision + 1;
        st.dirty = true;
    }
}
