using System;
using Gui;
using Gui.Widget;
using Gui.Backend;

namespace Gui.Component.DataTable;

/// DataTable 模块：表头筛选 UI——DevExpress 风格的分页筛选
/// 弹窗（值/规则/日历）、行内编辑器和集合筛选菜单。
partial class DataTable {
    // ---------- 分页筛选弹窗（DevExpress 风格）----------

    /// 打开 `col` 列的表头筛选菜单（重置页签/搜索/批量行并
    /// 预取去重值）。图标点击与表头上下文菜单的"筛选…"项
    /// 共用，保证两条入口的初始状态一致。
    static void OpenFilterMenu(DataTableState st, List<DataColumn> cols,
                               DataSource src, int col) {
        st.openMenu = col;
        st.filterTab = 0;
        st.searchText = "";
        st.valScroll = 0;
        st.editFocus = 0;
        st.batchLines = new List<string>();
        st.batchLines.Add("");
        st.batchExactFlag = 0;
        st.menuVals = DataTable.DistinctFiltered(st, cols, src, col);
        st.menuMatched = st.menuVals;
        st.menuSearchCache = "";
    }

    /// 打开的编辑器，绘制在单元格之上。文本和步进编辑器是
    /// 带光标的输入框；下拉和日历编辑器在下方（或上方，
    /// 当单元格靠近窗口底部时）附加弹层。校验失败的
    /// 会在弹层位置显示错误消息。
    static void RenderEditor(App app, List<DataColumn> cols, DataSource src,
                             DataTableState st, int edX, int edY, int edW, int edH) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        DataColumn col = cols[st.editCol];
        int epad = t.paddingSmall;
        int efs = Style.FontFallback(app, "medium");
        int etY = Canvas.CenterTextY(edY, edH, efs);

        // 被拒绝的值显示警示边框，
        // 即使消息被窗口边缘裁剪也清晰可见。
        string edCls = "";
        if (st.editError.Length > 0) { edCls = "invalid"; }
        StyleBox sEd = Style.Part(app, "datatable", "editor", "", edCls, "",
                                  Style.SNormal());
        StyleBox sEdBad = Style.Part(app, "datatable", "editor", "", "invalid",
                                     "", Style.SNormal());
        StyleBox sMenu = Style.Part(app, "datatable", "menu", "", "", "",
                                    Style.SNormal());
        StyleBox sAccent = Style.Part(app, "datatable", "accent", "", "", "",
                                      Style.SNormal());
        int bord = sEd.BorderOr(0);

        // 为编辑器自有的控件预留空间：步进按钮，或
        // 下拉 / 日历切换按钮。
        int btnW = 0;
        if (col.editorKind == 3) { btnW = app.Scale(34); }
        else if (col.editorKind == 1 || col.editorKind == 2) { btnW = app.Scale(20); }
        int textW = edW - btnW;
        if (textW < app.Scale(24)) { textW = app.Scale(24); }

        c.FillRect(edX, edY, edW, edH, sEd.BgOr(0));
        c.DrawRect(edX, edY, edW, edH, bord, sEd.BorderWOr(2));
        c.PushClip(edX + epad, edY, textW - epad * 2, edH);
        c.DrawText(edX + epad, etY, st.editBuf, sEd.FgOr(0), efs);
        int ecaretX = edX + epad + Canvas.MeasureText(Text.Left(st.editBuf, st.editCur), efs);
        c.FillRect(ecaretX, etY, 1, Canvas.FontHeight(efs), sAccent.BgOr(0));
        c.PopClip();
        app.SetImeCaret(ecaretX, etY + Canvas.FontHeight(efs));

        if (col.editorKind == 3) {
            // 两个半高步进按钮，与原生 spin box 一致。
            int sw = app.Scale(16);
            int sx = edX + edW - sw - app.Scale(3);
            int hh = (edH - app.Scale(6)) / 2;
            int sy = edY + app.Scale(3);
            if (DataTable.IconBtn(app, sx, sy, sw, hh, "chevron-up", false)) {
                st.editBuf = DataTable.StepValue(col, st.editBuf, 1);
                st.editCur = st.editBuf.Length;
                st.editError = "";
                app.RequestRedraw();
            }
            if (DataTable.IconBtn(app, sx, sy + hh, sw, hh, "chevron-down", false)) {
                st.editBuf = DataTable.StepValue(col, st.editBuf, -1);
                st.editCur = st.editBuf.Length;
                st.editError = "";
                app.RequestRedraw();
            }
        } else if (col.editorKind == 1 || col.editorKind == 2) {
            int sw = app.Scale(18);
            string ico = "chevron-down";
            if (col.editorKind == 2) { ico = "calendar"; }
            if (DataTable.IconBtn(app, edX + edW - sw - app.Scale(2),
                                  edY + (edH - sw) / 2, sw, sw, ico, st.edPopOpen)) {
                st.edPopOpen = !st.edPopOpen;
                app.RequestRedraw();
            }
        }

        // ---- 弹层 / 错误提示：放在单元格下方，除非会超出
        // 窗口底部 ----
        int popW = edW;
        int popH = 0;
        if (st.editError.Length > 0) {
            popH = app.Scale(24);
            int mw = Canvas.MeasureText(st.editError, Style.FontFallback(app, "small")) + app.Scale(16);
            if (mw > popW) { popW = mw; }
        } else if (st.edPopOpen && col.editorKind == 1) {
            int itemH = app.Scale(24);
            int n = st.edPopItems.Count;
            if (n > 8) { n = 8; }
            if (n < 1) { n = 1; }
            popH = n * itemH + app.Scale(8);
            if (popW < app.Scale(120)) { popW = app.Scale(120); }
        } else if (st.edPopOpen && col.editorKind == 2) {
            popW = app.Scale(224);
            popH = app.Scale(230);
        }
        if (popH == 0) { return; }

        int popX = edX;
        int popY = edY + edH;
        if (popX + popW > c.Width()) { popX = c.Width() - popW - app.Scale(4); }
        if (popX < app.Scale(2)) { popX = app.Scale(2); }
        if (popY + popH > c.Height()) { popY = edY - popH; }
        if (popY < app.titlebarH) { popY = app.titlebarH; }

        c.FillRoundRect(popX + app.Scale(2), popY + app.Scale(3), popW, popH,
                        t.borderRadiusSmall, t.overlay);
        c.FillRoundRect(popX, popY, popW, popH, t.borderRadiusSmall, sMenu.BgOr(0));

        if (st.editError.Length > 0) {
            c.DrawRect(popX, popY, popW, popH, sEdBad.BorderOr(0), 1);
            c.DrawText(popX + app.Scale(8),
                       Canvas.CenterTextY(popY, popH, Style.FontFallback(app, "small")),
                       st.editError, sEdBad.FgOr(0), Style.FontFallback(app, "small"));
            return;
        }

        c.DrawRect(popX, popY, popW, popH, sMenu.BorderOr(0), 1);
        app.CaptureWheel(popX, popY, popW, popH);
        app.BlockHitsRect(popX, popY, popW, popH);
        // 弹层在主体读取指针之前绘制，因此标记重叠区，
        // 供按下处理器使用：否则点击列表项也会
        // 落到下方单元格上，在项被选中前
        // 就提交并关闭编辑器。
        if (app.mouseX >= popX && app.mouseX < popX + popW
            && app.mouseY >= popY && app.mouseY < popY + popH) {
            st.edPopHot = true;
        }
        if (col.editorKind == 1) {
            DataTable.RenderChoiceList(app, col, st, popX, popY, popW, popH);
        } else {
            DataTable.RenderCalendar(app, col, st, popX, popY, popW, popH);
        }
    }

    /// 下拉列表：筛选后的候选中最多显示 8 行。
    static void RenderChoiceList(App app, DataColumn col, DataTableState st,
                                 int px, int py, int pw, int ph) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int fs = Style.FontFallback(app, "small");
        int itemH = app.Scale(24);
        int pad = app.Scale(4);
        int vis = (ph - pad * 2) / itemH;
        if (vis < 1) { vis = 1; }
        StyleBox sMenu = Style.Part(app, "datatable", "menu", "", "", "",
                                    Style.SNormal());
        StyleBox sRowHover = Style.Part(app, "datatable", "row", "", "", "",
                                        Style.SHover());
        StyleBox sRowSel = Style.Part(app, "datatable", "row", "", "", "",
                                      Style.SSelected());

        if (st.edPopItems.Count == 0) {
            c.DrawText(px + app.Scale(8), py + Canvas.CenterTextY(pad, itemH, fs),
                       DataTable.T("No match", "No match"),
                       Style.Part(app, "datatable", "hint", "", "", "",
                                  Style.SNormal()).FgOr(0), fs);
            return;
        }

        // 键盘移动后保持高亮在屏幕上。
        int selAt = -1;
        int q = 0;
        while (q < st.edPopItems.Count) {
            if (st.edPopItems[q] == st.edPopSel) { selAt = q; q = st.edPopItems.Count; }
            else { q = q + 1; }
        }
        if (selAt >= 0) {
            if (selAt < st.edPopScroll) { st.edPopScroll = selAt; }
            if (selAt >= st.edPopScroll + vis) { st.edPopScroll = selAt - vis + 1; }
        }
        int maxScroll = st.edPopItems.Count - vis;
        if (maxScroll < 0) { maxScroll = 0; }
        if (st.edPopScroll > maxScroll) { st.edPopScroll = maxScroll; }
        if (st.edPopScroll < 0) { st.edPopScroll = 0; }

        // 在列表上滚动滚轮可滚动列表（按表体已有的约定，
        // delta 以按键码形式出现在 kind-13 事件中）。
        if (app.EventKind() == 13 && maxScroll > 0
            && app.mouseX >= px && app.mouseX < px + pw
            && app.mouseY >= py && app.mouseY < py + ph) {
            int delta = app.window.EventKeyCode();
            int step = delta / 120;
            if (step == 0) { if (delta > 0) { step = 1; } else if (delta < 0) { step = 0 - 1; } }
            st.edPopScroll = st.edPopScroll - step;
            if (st.edPopScroll > maxScroll) { st.edPopScroll = maxScroll; }
            if (st.edPopScroll < 0) { st.edPopScroll = 0; }
            app.RequestRedraw();
        }

        for (int i = 0; i < vis && st.edPopScroll + i < st.edPopItems.Count; i = i + 1) {
            int ci = st.edPopItems[st.edPopScroll + i];
            int iy = py + pad + i * itemH;
            int id = app.focus.AllocId();
            bool hov = app.focus.IsHovered(id);
            if (ci == st.edPopSel) { c.FillRect(px + pad, iy, pw - pad * 2, itemH, sRowSel.BgOr(0)); }
            else if (hov) { c.FillRect(px + pad, iy, pw - pad * 2, itemH, sRowHover.BgOr(0)); }
            c.DrawText(px + app.Scale(8), Canvas.CenterTextY(iy, itemH, fs),
                       DataTable.Truncate(col.choices[ci], fs, pw - app.Scale(16)),
                       sMenu.FgOr(0), fs);
            app.hitTester.RegisterRect(id, px + pad, iy, pw - pad * 2, itemH, 0);
            if (app.EventKind() == 3 && app.hitTester.HitTest(app.mouseX, app.mouseY) == id) {
                st.editBuf = col.choices[ci];
                st.editCur = st.editBuf.Length;
                st.edPopSel = ci;
                st.editError = "";
                app.RequestRedraw();
            }
        }
    }

    /// 月历网格。点击日期按列自身的日期
    /// 格式写回，存储文本保持列声明的格式。
    static void RenderCalendar(App app, DataColumn col, DataTableState st,
                               int px, int py, int pw, int ph) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int fs = Style.FontFallback(app, "small");
        int pad = app.Scale(8);
        int hdrH = app.Scale(26);
        int cw = (pw - pad * 2) / 7;
        int chh = app.Scale(24);
        StyleBox sMenu = Style.Part(app, "datatable", "menu", "", "", "",
                                    Style.SNormal());
        StyleBox sHint = Style.Part(app, "datatable", "hint", "", "", "",
                                    Style.SNormal());
        StyleBox sAccent = Style.Part(app, "datatable", "accent", "", "", "",
                                      Style.SNormal());
        StyleBox sRowHover = Style.Part(app, "datatable", "row", "", "", "",
                                        Style.SHover());

        // 表头：月份名 + 上/下月按钮
        int y = DataTable.YmYear(st.edCalMonth);
        int m = DataTable.YmMonth(st.edCalMonth);
        if (DataTable.IconBtn(app, px + pad, py + app.Scale(3), app.Scale(22), hdrH,
                              "chevron-left", false)) {
            st.edCalMonth = st.edCalMonth - 1;
            app.RequestRedraw();
        }
        if (DataTable.IconBtn(app, px + pw - pad - app.Scale(22), py + app.Scale(3),
                              app.Scale(22), hdrH, "chevron-right", false)) {
            st.edCalMonth = st.edCalMonth + 1;
            app.RequestRedraw();
        }
        c.DrawTextCentered(px + pad + app.Scale(24), py + app.Scale(3),
                           pw - pad * 2 - app.Scale(48), hdrH,
                           DataTable.MonthAbbr(m) + " " + Convert.ToString(y),
                           sMenu.FgOr(0), Style.FontFallback(app, "medium"));

        // 星期标题
        List<string> dows = new List<string>{
            "Su", "Mo", "Tu", "We",
            "Th", "Fr", "Sa" };
        int dy = py + app.Scale(3) + hdrH;
        for (int di = 0; di < 7; di = di + 1) {
            c.DrawTextCentered(px + pad + di * cw, dy, cw, app.Scale(18),
                               dows[di], sHint.FgOr(0), Style.FontFallback(app, "small"));
        }

        int gridY = dy + app.Scale(18);
        List<int> cells = DataTable.MonthCells(st.edCalMonth);
        int today = DataTable.Today();
        for (int i = 0; i < 42; i = i + 1) {
            int day = cells[i];
            if (day > 0) {
                int gx = px + pad + (i % 7) * cw;
                int gy = gridY + (i / 7) * chh;
                int dnum = DateTime.DaysFromCivil(y, m, day);
                int id = app.focus.AllocId();
                bool hov = app.focus.IsHovered(id);
                int fg = sMenu.FgOr(0);
                if (dnum == st.edPopSel) {
                    c.FillRoundRect(gx + app.Scale(2), gy + app.Scale(1),
                                    cw - app.Scale(4), chh - app.Scale(2),
                                    t.borderRadiusSmall, sAccent.BgOr(0));
                    fg = sAccent.FgOr(0);
                } else if (hov) {
                    c.FillRoundRect(gx + app.Scale(2), gy + app.Scale(1),
                                    cw - app.Scale(4), chh - app.Scale(2),
                                    t.borderRadiusSmall, sRowHover.BgOr(0));
                } else if (dnum == today) {
                    c.DrawRect(gx + app.Scale(2), gy + app.Scale(1),
                               cw - app.Scale(4), chh - app.Scale(2), sAccent.BgOr(0), 1);
                }
                c.DrawTextCentered(gx, gy, cw, chh, Convert.ToString(day), fg, fs);
                app.hitTester.RegisterRect(id, gx, gy, cw, chh, 0);
                if (app.EventKind() == 3 && app.hitTester.HitTest(app.mouseX, app.mouseY) == id) {
                    st.edPopSel = dnum;
                    st.editBuf = DataTable.FormatDate(dnum, DataTable.DateStoreFormat(col));
                    st.editCur = st.editBuf.Length;
                    st.editError = "";
                    app.RequestRedraw();
                }
            }
        }
    }

    /// 筛选弹窗的分页标签按钮（Values/Text/Batch/Rules），
    /// active 时呈选中态；返回本次是否被点击。
    static bool TabBtn(App app, int bx, int by, int bw, int bh, string label, bool active) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int id = app.focus.AllocId();
        bool hov = app.focus.IsHovered(id);
        int toolState = Style.SNormal();
        if (active) { toolState = Style.SSelected(); }
        else if (hov) { toolState = Style.SHover(); }
        StyleBox sTool = Style.Part(app, "datatable", "tool", "", "", "",
                                    toolState);
        if (active || hov) { c.FillRect(bx, by, bw, bh, sTool.BgOr(0)); }
        c.DrawTextCentered(bx, by, bw, bh, label, sTool.FgOr(0), Style.FontFallback(app, "small"));
        if (active) { c.FillRect(bx, by + bh - app.Scale(2), bw, app.Scale(2), sTool.FgOr(0)); }
        app.hitTester.RegisterRect(id, bx, by, bw, bh, 0);
        return app.ClickAvailable() && app.hitTester.HitTest(app.mouseX, app.mouseY) == id;
    }

    /// 纯图标工具栏按钮，带"激活"（按下）外观。
    static bool IconBtn(App app, int bx, int by, int bw, int bh, string icon, bool active) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int id = app.focus.AllocId();
        int toolState = Style.SNormal();
        if (active) { toolState = Style.SSelected(); }
        else if (app.focus.IsHovered(id)) { toolState = Style.SHover(); }
        StyleBox sTool = Style.Part(app, "datatable", "tool", "", "", "",
                                    toolState);
        int col = sTool.FgOr(0);
        if (active || app.focus.IsHovered(id)) {
            app.FillChrome(bx, by, bw, bh, t.borderRadiusSmall, sTool.BgOr(0));
        }
        c.DrawGlyphIn(icon, bx, by, bw, bh, app.Scale(13), col);
        app.hitTester.RegisterRect(id, bx, by, bw, bh, 0);
        return app.ClickAvailable() && app.hitTester.HitTest(app.mouseX, app.mouseY) == id;
    }

    /// 带标签的工具栏按钮，`primary` 时用强调色填充。
    static bool TextBtn(App app, int bx, int by, int bw, int bh, string label, bool primary) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int id = app.focus.AllocId();
        bool hov = app.focus.IsHovered(id);
        string btnCls = "";
        if (primary) { btnCls = "primary"; }
        int btnState = Style.SNormal();
        if (hov) { btnState = Style.SHover(); }
        StyleBox sBtn = Style.Part(app, "datatable", "button", "", btnCls, "",
                                   btnState);
        int bg = sBtn.BgOr(0);
        int fg = sBtn.FgOr(0);
        c.FillRoundRect(bx, by, bw, bh, t.borderRadiusSmall, bg);
        if (!primary) { c.DrawRect(bx, by, bw, bh, sBtn.BorderOr(0), 1); }
        c.DrawTextCentered(bx, by, bw, bh, label, fg, Style.FontFallback(app, "small"));
        app.hitTester.RegisterRect(id, bx, by, bw, bh, 0);
        return app.ClickAvailable() && app.hitTester.HitTest(app.mouseX, app.mouseY) == id;
    }

    /// 绘制一个文本框：text 为内容，空文本时显示占位符 ph；
    /// focused 时画焦点框与光标。纯绘制，不处理输入。
    static void EditBox(App app, int bx, int by, int bw, int bh, string text, string ph, bool focused) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int fs = Style.FontFallback(app, "small");
        int fieldState = Style.SNormal();
        if (focused) { fieldState = Style.SFocus(); }
        StyleBox sField = Style.Part(app, "datatable", "field", "", "", "",
                                     fieldState);
        c.FillRoundRect(bx, by, bw, bh, t.borderRadiusSmall, sField.BgOr(0));
        c.DrawRoundRect(bx, by, bw, bh, t.borderRadiusSmall, sField.BorderOr(0), 1);
        int tpad = app.Scale(6);
        int ty = Canvas.CenterTextY(by, bh, fs);
        string shown = DataTable.Truncate(text, fs, bw - tpad * 2);
        if (text.Length == 0) {
            c.DrawText(bx + tpad, ty, ph,
                       Style.Part(app, "datatable", "hint", "", "", "",
                                  Style.SNormal()).FgOr(0), fs);
        } else {
            c.DrawText(bx + tpad, ty, shown, sField.FgOr(0), fs);
        }
        if (focused) {
            int cxp = bx + tpad + Canvas.MeasureText(shown, fs);
            if (cxp > bx + bw - tpad) { cxp = bx + bw - tpad; }
            c.FillRect(cxp, ty, app.Scale(1), Canvas.FontHeight(fs),
                       Style.Part(app, "datatable", "accent", "", "", "",
                                  Style.SNormal()).BgOr(0));
        }
    }

    /// 为单元格光标处理一次按下。按键被消费时
    /// 返回 true，调用方可阻止其进入滚动/选区处理。
    ///
    /// 移动按显示槽位进行（因此会跳过组表头），
    /// 并按可见列位置进行（隐藏与重排的列行为正确）。
    /// Shift 从锚点扩展范围；Ctrl 跳到边缘。
    static bool HandleNavKey(App app, List<DataColumn> cols, DataSource src,
                             DataTableState st, List<FrameColumn> columns, int visRows,
                             int dataViewW, int pinnedW, int kc, int emods) {
        if (columns.Count == 0) { return false; }
        bool shift = Modifiers.HasShift(emods);
        bool ctrl = Modifiers.HasCtrl(emods);

        // ---- 剪贴板 / 选区快捷键 ----
        if (ctrl && kc == 67) {                     // Ctrl+C
            Clipboard.SetText(DataTable.CopyText(st, cols, src));
            DataTable.Flash(st, DataTable.T("Copied to clipboard", "已复制到剪贴板"));
            return true;
        }
        if (ctrl && kc == 88) {                     // Ctrl+X：复制后清空
            Clipboard.SetText(DataTable.CopyText(st, cols, src));
            int cut = DataTable.ClearRangeCells(st, cols, src);
            if (cut > 0) { DataTable.Flash(st, DataTable.TN("Cut {n} cells", cut, "已剪切 {n} 个单元格")); }
            else { DataTable.Flash(st, DataTable.T("Copied to clipboard", "已复制到剪贴板")); }
            return true;
        }
        if (ctrl && kc == 86) {                     // Ctrl+V
            int n = DataTable.PasteText(st, cols, src, Clipboard.GetText());
            if (n > 0) { DataTable.Flash(st, DataTable.TN("Pasted {n} cells", n, "已粘贴 {n} 个单元格")); }
            else { DataTable.Flash(st, DataTable.T("No pasteable editable cells", "无可粘贴的可编辑单元格")); }
            return true;
        }
        if (ctrl && kc == 65) {                     // Ctrl+A：全选网格
            DataTable.SelectAllRows(st, src, true);
            int firstSlot = DataTable.FirstDataSlot(st);
            int lastSlot = DataTable.LastDataSlot(st);
            if (firstSlot >= 0) {
                st.rangeR0 = firstSlot;
                st.rangeR1 = lastSlot;
                st.rangeC0 = columns[0].column;
                st.rangeC1 = columns[columns.Count - 1].column;
            }
            st.SelectionChanged.Raise();
            return true;
        }
        if (ctrl && kc == 90) {                     // Ctrl+Z
            if (DataTable.Undo(st, cols, src)) {
                DataTable.Recompute(st, cols, src);
                DataTable.Flash(st, DataTable.T("Undone", "已撤销"));
            } else {
                DataTable.Flash(st, DataTable.T("Nothing to undo", "没有可撤销的操作"));
            }
            return true;
        }
        if (ctrl && kc == 90 && !shift) {           // Ctrl+Z
            if (DataTable.Undo(st, cols, src)) {
                DataTable.Recompute(st, cols, src);
                DataTable.Flash(st, DataTable.T("Undone", "已撤销"));
            } else {
                DataTable.Flash(st, DataTable.T("Nothing to undo", "没有可撤销的操作"));
            }
            return true;
        }
        if (ctrl && (kc == 89 || (kc == 90 && shift))) {   // Ctrl+Y / Ctrl+Shift+Z
            if (DataTable.Redo(st, cols, src)) {
                DataTable.Recompute(st, cols, src);
                DataTable.Flash(st, DataTable.T("Redone", "已重做"));
            } else {
                DataTable.Flash(st, DataTable.T("Nothing to redo", "没有可重做的操作"));
            }
            return true;
        }
        // Ctrl+D / Ctrl+R：选区内向下/向右填充（Excel 惯例）。
        if (ctrl && kc == 68 && DataTable.HasRange(st)) {
            int n = DataTable.FillDown(st, cols, src);
            if (n > 0) { DataTable.Flash(st, DataTable.TN("Filled {n} cells", n, "已填充 {n} 个单元格")); }
            else { DataTable.Flash(st, DataTable.T("Nothing to fill", "没有可填充的单元格")); }
            return true;
        }
        if (ctrl && kc == 82 && DataTable.HasRange(st)) {
            int n = DataTable.FillRight(st, cols, src);
            if (n > 0) { DataTable.Flash(st, DataTable.TN("Filled {n} cells", n, "已填充 {n} 个单元格")); }
            else { DataTable.Flash(st, DataTable.T("Nothing to fill", "没有可填充的单元格")); }
            return true;
        }
        // Ctrl+Delete 删除整行；普通 Delete 只清空单元格。
        // 破坏性操作刻意采用更不易误触的组合键。
        if (ctrl && kc == 46) {
            int killed = DataTable.DeleteSelectedRows(st, cols, src);
            if (killed == 0 && st.hitRow >= 0) {
                if (DataTable.DeleteRow(st, cols, src, st.hitRow)) { killed = 1; }
            }
            if (killed > 0) {
                DataTable.Recompute(st, cols, src);
                DataTable.Flash(st, DataTable.TN("Deleted {n} rows (Ctrl+Z to undo)", killed, "已删除 {n} 行（Ctrl+Z 撤销）"));
            } else {
                DataTable.Flash(st, DataTable.T("This data source does not support deleting rows", "该数据源不支持删除行"));
            }
            return true;
        }
        if (ctrl && kc == 45) {                     // Ctrl+Insert 追加一行
            int nr = DataTable.AppendRow(st, cols, src);
            if (nr >= 0) {
                DataTable.Recompute(st, cols, src);
                DataTable.FocusRow(st, cols, src, nr);
            } else {
                DataTable.Flash(st, DataTable.T("This data source does not support adding rows", "该数据源不支持添加行"));
            }
            return true;
        }
        if (kc == 46 && !ctrl) {                    // Delete 清空选区
            return DataTable.ClearRangeCells(st, cols, src) > 0;
        }
        if (kc == 32 && st.hitRow >= 0) {           // Space 勾选该行
            DataTable.SetSelected(st, src, st.hitRow,
                                  !DataTable.IsSelected(st, src, st.hitRow));
            st.SelectionChanged.Raise();
            return true;
        }

        if (!DataTable.IsNavKey(kc)) { return false; }
        // 即使光标已在边缘，导航键也被消费，
        // 防止方向键穿透到下层滚动页面。
        List<int> tgt = DataTable.NavTarget(st, columns, visRows, kc, emods);
        int newSlot = tgt[0];
        int newCol = tgt[1];
        if (newSlot < 0 || newCol < 0) { return true; }
        // Tab 像表单字段一样提交，即使按住 Shift
        // 也会收起选区（Shift+Tab 表示"后退"而非"扩展"）。
        bool extend = shift && kc != 9;
        if (!DataTable.MoveCursor(st, src, newSlot, newCol, extend)) { return true; }
        DataTable.ScrollSlotIntoView(st, newSlot, visRows);
        DataTable.ScrollColIntoView(st, columns, newCol, dataViewW, pinnedW);
        st.CellClick.Raise();
        return true;
    }

    /// `on` 时呈选中态的小胶囊。用于规则芯片，
    /// 行为类似单选：点击已激活的会关闭规则。
    static bool Chip(App app, int bx, int by, int bw, int bh, string label, bool on) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int id = app.focus.AllocId();
        int chipState = Style.SNormal();
        if (on) { chipState = Style.SSelected(); }
        else if (app.focus.IsHovered(id)) { chipState = Style.SHover(); }
        StyleBox sChip = Style.Part(app, "datatable", "chip", "", "rule", "",
                                    chipState);
        int bg = sChip.BgOr(0);
        int fg = sChip.FgOr(0);
        c.FillRoundRect(bx, by, bw, bh, bh / 2, bg);
        if (!on) { c.DrawRect(bx, by, bw, bh, sChip.BorderOr(0), 1); }
        c.DrawTextCentered(bx, by, bw, bh, label, fg, Style.FontFallback(app, "small"));
        app.hitTester.RegisterRect(id, bx, by, bw, bh, 0);
        return app.ClickAvailable() && app.hitTester.HitTest(app.mouseX, app.mouseY) == id;
    }

    /// "Rules" 筛选页：值比较、相对日期预设（仅日期
    /// 列）和 Top-N。返回所绘内容下方的 y。
    /// RenderRulesTab 为这个 筛选/列 组合占用的高度。
    /// 与渲染器并列维护以保持同步：其中的每次 `cy` 前进
    /// 在此都有对应项，包括仅日期列
    /// 或选定计数型前/后模式后才出现的部分。
    static int RulesTabHeight(App app, ColFilter f, DataColumn col) {
        int chipH = app.Scale(22);
        int gap = app.Scale(4);
        int boxH = app.Scale(26);
        int lblH = Canvas.FontHeight(Style.FontFallback(app, "small")) + app.Scale(4);

        int h = lblH;                            // "Compare"
        h = h + (chipH + gap) * 2;               // 八个运算符芯片
        h = h + chipH + app.Scale(6);            // 为空 / 非空
        if (f.cmpMode != 0 && f.cmpMode != 9 && f.cmpMode != 10) {
            h = h + boxH + app.Scale(4);         // 一或两个操作数输入框
        }
        h = h + app.Scale(6);
        if (col.isDate) {
            h = h + lblH + (chipH + gap) * 4 + app.Scale(6);
        }
        h = h + lblH;                            // "Top / bottom"
        h = h + (chipH + gap) * 2;               // 六个前/后芯片
        if (f.topMode >= 1 && f.topMode <= 4) { h = h + boxH; }
        return h;
    }

    /// 绘制 "Rules" 筛选页：比较运算符芯片与操作数输入框、
    /// 空值规则、日期预设（仅日期列）与 Top-N（含 N 输入框
    /// 与 +/- 步进）；改动即失效查询。返回绘制后的 y。
    static int RenderRulesTab(App app, int mx, int cy, int menuW, int pad,
                              ColFilter f, DataColumn col, DataTableState st) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int fs = Style.FontFallback(app, "small");
        int chipH = app.Scale(22);
        int gap = app.Scale(4);
        int innerW = menuW - pad * 2;
        StyleBox sLabel = Style.Part(app, "datatable", "label", "", "", "",
                                     Style.SNormal());

        // ---- 比较 ----
        c.DrawText(mx + pad, cy, DataTable.T("Compare", "Compare"), sLabel.FgOr(0), fs);
        cy = cy + Canvas.FontHeight(fs) + app.Scale(4);

        // 两行共八个运算符；再次点击芯片可关闭对应模式
        int cw4 = (innerW - gap * 3) / 4;
        List<string> ops = new List<string>{
            ">", ">=", "<", "<=",
            "=", "<>", "in", "not in" };
        for (int oi = 0; oi < ops.Count; oi = oi + 1) {
            int mode = oi + 1;
            int bx = mx + pad + (cw4 + gap) * (oi % 4);
            int by = cy + (chipH + gap) * (oi / 4);
            if (DataTable.Chip(app, bx, by, cw4, chipH, ops[oi], f.cmpMode == mode)) {
                if (f.cmpMode == mode) { f.cmpMode = 0; } else { f.cmpMode = mode; }
                st.editFocus = 4;
                DataTable.InvalidateQuery(st);
                st.FilterChanged.Raise();
                app.RequestRedraw();
            }
        }
        cy = cy + (chipH + gap) * 2;

        // 两个空值规则占用更宽芯片，因无需操作数
        int cw2 = (innerW - gap) / 2;
        if (DataTable.Chip(app, mx + pad, cy, cw2, chipH, DataTable.T("is empty", "is empty"), f.cmpMode == 9)) {
            if (f.cmpMode == 9) { f.cmpMode = 0; } else { f.cmpMode = 9; st.editFocus = 0; }
            DataTable.InvalidateQuery(st); st.FilterChanged.Raise(); app.RequestRedraw();
        }
        if (DataTable.Chip(app, mx + pad + cw2 + gap, cy, cw2, chipH, DataTable.T("not empty", "not empty"), f.cmpMode == 10)) {
            if (f.cmpMode == 10) { f.cmpMode = 0; } else { f.cmpMode = 10; st.editFocus = 0; }
            DataTable.InvalidateQuery(st); st.FilterChanged.Raise(); app.RequestRedraw();
        }
        cy = cy + chipH + app.Scale(6);

        // 操作数输入框：单边运算符一个，in/not in 两个。
        // 空值规则不需要操作数，因此完全没有输入框。
        bool twoSided = f.cmpMode == 7 || f.cmpMode == 8;
        bool needsA = f.cmpMode != 0 && f.cmpMode != 9 && f.cmpMode != 10;
        int boxH = app.Scale(26);
        if (needsA) {
            int aw = innerW;
            if (twoSided) { aw = (innerW - gap) / 2; }
            DataTable.EditBox(app, mx + pad, cy, aw, boxH, f.cmpA, "value", st.editFocus == 4);
            int aId = app.focus.AllocId();
            app.hitTester.RegisterRect(aId, mx + pad, cy, aw, boxH, 0);
            if (app.EventKind() == 3 && app.hitTester.HitTest(app.mouseX, app.mouseY) == aId) {
                st.editFocus = 4; app.RequestRedraw();
            }
            if (twoSided) {
                int bx2 = mx + pad + aw + gap;
                DataTable.EditBox(app, bx2, cy, aw, boxH, f.cmpB, "and", st.editFocus == 5);
                int bId = app.focus.AllocId();
                app.hitTester.RegisterRect(bId, bx2, cy, aw, boxH, 0);
                if (app.EventKind() == 3 && app.hitTester.HitTest(app.mouseX, app.mouseY) == bId) {
                    st.editFocus = 5; app.RequestRedraw();
                }
            }
            cy = cy + boxH + app.Scale(4);
        }
        cy = cy + app.Scale(6);

        // ---- 日期预设（仅日期列）----
        if (col.isDate) {
            c.DrawText(mx + pad, cy, DataTable.T("Date range", "Date range"), sLabel.FgOr(0), fs);
            cy = cy + Canvas.FontHeight(fs) + app.Scale(4);
            List<string> ps = new List<string>{
                DataTable.T("Today", "Today"), DataTable.T("Yesterday", "Yesterday"), DataTable.T("This week", "This week"),
                DataTable.T("Last 7d", "Last 7d"), DataTable.T("This month", "This month"), DataTable.T("Last 30d", "Last 30d"),
                DataTable.T("Quarter", "Quarter"), DataTable.T("This year", "This year"), DataTable.T("YTD", "YTD"),
                DataTable.T("Past", "Past"), DataTable.T("Future", "Future") };
            int cw3 = (innerW - gap * 2) / 3;
            for (int pi = 0; pi < ps.Count; pi = pi + 1) {
                int preset = pi + 1;
                int bx = mx + pad + (cw3 + gap) * (pi % 3);
                int by = cy + (chipH + gap) * (pi / 3);
                if (DataTable.Chip(app, bx, by, cw3, chipH, ps[pi], f.datePreset == preset)) {
                    if (f.datePreset == preset) { f.datePreset = 0; } else { f.datePreset = preset; }
                    DataTable.InvalidateQuery(st); st.FilterChanged.Raise(); app.RequestRedraw();
                }
            }
            cy = cy + (chipH + gap) * 4 + app.Scale(6);
        }

        // ---- Top-N ----
        c.DrawText(mx + pad, cy, DataTable.T("Top / bottom", "Top / bottom"), sLabel.FgOr(0), fs);
        cy = cy + Canvas.FontHeight(fs) + app.Scale(4);
        List<string> tops = new List<string>{
            DataTable.T("Top N", "Top N"), DataTable.T("Bottom N", "Bottom N"), DataTable.T("Top N%", "Top N%"),
            DataTable.T("Bot N%", "Bot N%"), DataTable.T("Above avg", "Above avg"), DataTable.T("Below avg", "Below avg") };
        int cw3b = (innerW - gap * 2) / 3;
        for (int ti = 0; ti < tops.Count; ti = ti + 1) {
            int mode = ti + 1;
            int bx = mx + pad + (cw3b + gap) * (ti % 3);
            int by = cy + (chipH + gap) * (ti / 3);
            if (DataTable.Chip(app, bx, by, cw3b, chipH, tops[ti], f.topMode == mode)) {
                if (f.topMode == mode) { f.topMode = 0; } else { f.topMode = mode; }
                DataTable.InvalidateQuery(st); st.FilterChanged.Raise(); app.RequestRedraw();
            }
        }
        cy = cy + (chipH + gap) * 2;

        // N 只对四种计数模式有意义
        if (f.topMode >= 1 && f.topMode <= 4) {
            int lw = app.Scale(20);
            c.DrawText(mx + pad, Canvas.CenterTextY(cy, boxH, fs), "N", sLabel.FgOr(0), fs);
            int nx = mx + pad + lw;
            int nw = app.Scale(64);
            DataTable.EditBox(app, nx, cy, nw, boxH, Convert.ToString(f.topN), "10", st.editFocus == 6);
            int nId = app.focus.AllocId();
            app.hitTester.RegisterRect(nId, nx, cy, nw, boxH, 0);
            if (app.EventKind() == 3 && app.hitTester.HitTest(app.mouseX, app.mouseY) == nId) {
                st.editFocus = 6; app.RequestRedraw();
            }
            int spw = app.Scale(24);
            if (DataTable.TextBtn(app, nx + nw + gap, cy, spw, boxH, "-", false)) {
                if (f.topN > 1) { f.topN = f.topN - 1; DataTable.InvalidateQuery(st); st.FilterChanged.Raise(); }
                app.RequestRedraw();
            }
            if (DataTable.TextBtn(app, nx + nw + gap + spw + gap, cy, spw, boxH, "+", false)) {
                f.topN = f.topN + 1; DataTable.InvalidateQuery(st); st.FilterChanged.Raise(); app.RequestRedraw();
            }
            cy = cy + boxH;
        }
        return cy;
    }

    /// 列头筛选弹窗总入口：标题 + 升/降序按钮、四个标签页
    /// （Values/Text/Batch/Rules）与页脚 Clear/Close；按键按
    /// editFocus 路由到对应编辑框，点击面板外（且不在列头上）
    /// 时关闭。锚定在 `mi` 列下方，整体限制在窗口内。
    static void RenderMenu(App app, int x, int y, int viewW, int headerH, int numW, int selW,
                           List<DataColumn> cols, DataSource src, DataTableState st) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int mi = st.openMenu;
        ColFilter f = st.filters[mi];
        StyleBox sMenu = Style.Part(app, "datatable", "menu", "", "", "",
                                    Style.SNormal());
        StyleBox sGrid = Style.Part(app, "datatable", "grid", "", "", "",
                                    Style.SNormal());
        StyleBox sHint = Style.Part(app, "datatable", "hint", "", "", "",
                                    Style.SNormal());
        StyleBox sLabel = Style.Part(app, "datatable", "label", "", "", "",
                                     Style.SNormal());
        StyleBox sRowHover = Style.Part(app, "datatable", "row", "", "", "",
                                        Style.SHover());
        StyleBox sAccent = Style.Part(app, "datatable", "accent", "", "", "",
                                      Style.SNormal());

        int pad = app.Scale(10);
        int fs = Style.FontFallback(app, "small");
        int fsM = Style.FontFallback(app, "medium");
        int rowH = app.Scale(28);
        int menuW = app.Scale(256);
        int menuH = app.Scale(348);
        // Rules 页堆叠多个高度不一的区块，面板
        // 用该页自身的布局算式确定尺寸，而非
        // 手工调优的常量——主题度量变化时不会裁切。
        if (st.filterTab == 3) {
            menuH = app.Scale(8) + rowH + app.Scale(6)      // 标题行
                  + rowH + app.Scale(8)                      // 标签条
                  + DataTable.RulesTabHeight(app, f, cols[mi])
                  + app.Scale(40);                           // 页脚
        }

        // 锚定在列下方，整体限制在窗口内
        int mx = x + numW + selW - st.scrollX;
        for (int k = 0; k < mi; k = k + 1) { mx = mx + st.dispW[k]; }
        if (mx + menuW > x + viewW) { mx = x + viewW - menuW; }
        if (mx < x) { mx = x; }
        int my = y + headerH;
        int canH = c.Height();
        if (my + menuH > canH) { my = canH - menuH - app.Scale(6); }
        if (my < app.titlebarH) { my = app.titlebarH; }

        // 接管弹窗上的滚轮，避免下层页面滚动
        app.CaptureWheel(mx, my, menuW, menuH);
        // 吞掉整个面板的点击，空白区域不穿透
        app.BlockHitsRect(mx, my, menuW, menuH);

        // 把按键路由到获得焦点的编辑框
        if (app.EventKind() == 6 && st.editFocus != 0) {
            int chv = app.window.EventKeyCode();
            if (st.editFocus == 1) {
                if (chv == 8) { st.searchText = DataTable.Backspace(st.searchText); }
                else { string ad = Text.CharStr(chv); if (ad.Length > 0) { st.searchText = st.searchText + ad; } }
            } else if (st.editFocus == 2) {
                if (chv == 8) { f.textQuery = DataTable.Backspace(f.textQuery); }
                else { string ad = Text.CharStr(chv); if (ad.Length > 0) { f.textQuery = f.textQuery + ad; } }
                DataTable.InvalidateQuery(st);
                st.FilterChanged.Raise();
            } else if (st.editFocus == 3) {
                int last = st.batchLines.Count - 1;
                if (last < 0) { st.batchLines.Add(""); last = 0; }
                if (chv == 13) { st.batchLines.Add(""); }
                else if (chv == 8) {
                    string cur = st.batchLines[last];
                    if (cur.Length > 0) { st.batchLines[last] = DataTable.Backspace(cur); }
                    else if (last > 0) { st.batchLines.RemoveAt(last); }
                } else {
                    string ad = Text.CharStr(chv);
                    if (ad.Length > 0) { st.batchLines[last] = st.batchLines[last] + ad; }
                }
            } else if (st.editFocus == 4 || st.editFocus == 5) {
                // 比较操作数：实时编辑，同 Text 页的查询
                string cur = f.cmpA;
                if (st.editFocus == 5) { cur = f.cmpB; }
                if (chv == 8) { cur = DataTable.Backspace(cur); }
                else { string ad = Text.CharStr(chv); if (ad.Length > 0) { cur = cur + ad; } }
                if (st.editFocus == 5) { f.cmpB = cur; } else { f.cmpA = cur; }
                DataTable.InvalidateQuery(st);
                st.FilterChanged.Raise();
            } else if (st.editFocus == 6) {
                // Top-N 数量：仅限数字，保证步进值始终是数字
                if (chv == 8) {
                    f.topN = f.topN / 10;
                } else if (chv >= 48 && chv <= 57 && f.topN < 100000) {
                    f.topN = f.topN * 10 + (chv - 48);
                }
                DataTable.InvalidateQuery(st);
                st.FilterChanged.Raise();
            }
            app.RequestRedraw();
        }

        // 面板
        c.FillRoundRect(mx + app.Scale(2), my + app.Scale(3), menuW, menuH, t.borderRadiusMedium, t.overlay);
        c.FillRoundRect(mx, my, menuW, menuH, t.borderRadiusMedium, sMenu.BgOr(0));
        c.DrawRoundRect(mx, my, menuW, menuH, t.borderRadiusMedium, sMenu.BorderOr(0), 1);

        // 表头：标题 + 升/降序
        int hy = my + app.Scale(8);
        c.DrawText(mx + pad, Canvas.CenterTextY(hy, rowH, fsM), cols[mi].title, sMenu.FgOr(0), fsM);
        int sbw = app.Scale(26);
        int sUpX = mx + menuW - pad - sbw * 2 - app.Scale(4);
        int sDnX = mx + menuW - pad - sbw;
        if (DataTable.IconBtn(app, sUpX, hy, sbw, rowH, "arrow-up", st.sortCol == mi && st.sortDir == 1)) {
            DataTable.SortBy(st, mi, 1); app.RequestRedraw();
        }
        if (DataTable.IconBtn(app, sDnX, hy, sbw, rowH, "arrow-down", st.sortCol == mi && st.sortDir == 2)) {
            DataTable.SortBy(st, mi, 2); app.RequestRedraw();
        }
        int cy = hy + rowH + app.Scale(6);

        // 标签页
        int tabW = (menuW - pad * 2) / 4;
        if (DataTable.TabBtn(app, mx + pad, cy, tabW, rowH, DataTable.T("Values", "Values"), st.filterTab == 0)) { st.filterTab = 0; st.editFocus = 0; app.RequestRedraw(); }
        if (DataTable.TabBtn(app, mx + pad + tabW, cy, tabW, rowH, DataTable.T("Text", "Text"), st.filterTab == 1)) { st.filterTab = 1; st.editFocus = 0; app.RequestRedraw(); }
        if (DataTable.TabBtn(app, mx + pad + tabW * 2, cy, tabW, rowH, DataTable.T("Batch", "Batch"), st.filterTab == 2)) { st.filterTab = 2; st.editFocus = 0; app.RequestRedraw(); }
        if (DataTable.TabBtn(app, mx + pad + tabW * 3, cy, tabW, rowH, DataTable.T("Rules", "Rules"), st.filterTab == 3)) { st.filterTab = 3; st.editFocus = 0; app.RequestRedraw(); }
        c.FillRect(mx + pad, cy + rowH, menuW - pad * 2, 1, sGrid.BgOr(0));
        cy = cy + rowH + app.Scale(8);

        int footerH = app.Scale(40);
        int contentBottom = my + menuH - footerH;

        if (st.filterTab == 0) {
            int boxH = app.Scale(26);
            DataTable.EditBox(app, mx + pad, cy, menuW - pad * 2, boxH, st.searchText, DataTable.T("Search values...", "Search values..."), st.editFocus == 1);
            int sId = app.focus.AllocId();
            app.hitTester.RegisterRect(sId, mx + pad, cy, menuW - pad * 2, boxH, 0);
            if (app.EventKind() == 3 && app.hitTester.HitTest(app.mouseX, app.mouseY) == sId) { st.editFocus = 1; app.RequestRedraw(); }
            cy = cy + boxH + app.Scale(6);

            int itemH = app.Scale(24);
            int allId = app.focus.AllocId();
            bool anyHidden = f.hidden.Count > 0;
            if (app.focus.IsHovered(allId)) { c.FillRect(mx + pad, cy, menuW - pad * 2, itemH, sRowHover.BgOr(0)); }
            DataTable.DrawMiniCheck(app, mx + pad, cy, itemH, !anyHidden);
            c.DrawText(mx + pad + app.Scale(22), Canvas.CenterTextY(cy, itemH, fs), "(Select All)", sMenu.FgOr(0), fs);
            app.hitTester.RegisterRect(allId, mx + pad, cy, menuW - pad * 2, itemH, 0);
            if (app.EventKind() == 3 && app.hitTester.HitTest(app.mouseX, app.mouseY) == allId) {
                f.hidden.Clear();
                DataTable.InvalidateQuery(st); st.FilterChanged.Raise(); app.RequestRedraw();
            }
            cy = cy + itemH;

            // 仅在搜索文本变化时重建筛选值列表
            // （而非每帧）：一列可能有数千个不同值，
            // 每帧重扫和重分配会卡顿。列表
            // 已虚拟化——只绘制可见窗口——因此
            // 无论有多少不同值都保持流畅。
            if (!(st.searchText == st.menuSearchCache)) {
                st.menuMatched = new List<string>();
                for (int vi0 = 0; vi0 < st.menuVals.Count; vi0 = vi0 + 1) {
                    if (DataTable.ContainsCI(st.menuVals[vi0], st.searchText)) { st.menuMatched.Add(st.menuVals[vi0]); }
                }
                st.menuSearchCache = st.searchText;
                st.valScroll = 0;
            }
            List<string> matched = st.menuMatched;

            int sbGW = app.Scale(10);
            int listX = mx + pad;
            int itemW = menuW - pad * 2 - sbGW;
            int listH = contentBottom - cy;
            int visN = listH / itemH;
            if (visN < 1) { visN = 1; }
            int maxScroll = matched.Count - visN;
            if (maxScroll < 0) { maxScroll = 0; }
            if (st.valScroll > maxScroll) { st.valScroll = maxScroll; }
            if (st.valScroll < 0) { st.valScroll = 0; }

            int listTop = cy;
            for (int r2 = 0; r2 < visN && (st.valScroll + r2) < matched.Count; r2 = r2 + 1) {
                string v = matched[st.valScroll + r2];
                int vId = app.focus.AllocId();
                if (app.focus.IsHovered(vId)) { c.FillRect(listX, cy, itemW, itemH, sRowHover.BgOr(0)); }
                bool visible = !f.IsHidden(v);
                DataTable.DrawMiniCheck(app, listX, cy, itemH, visible);
                string label = DataTable.Truncate(v, fs, itemW - app.Scale(26));
                c.DrawText(listX + app.Scale(22), Canvas.CenterTextY(cy, itemH, fs), label, sMenu.FgOr(0), fs);
                app.hitTester.RegisterRect(vId, listX, cy, itemW, itemH, 0);
                if (app.EventKind() == 3 && app.hitTester.HitTest(app.mouseX, app.mouseY) == vId) {
                    f.Toggle(v); DataTable.InvalidateQuery(st); st.FilterChanged.Raise(); app.RequestRedraw();
                }
                cy = cy + itemH;
            }

            // 虚拟化值列表的可拖拽滚动条
            if (matched.Count > visN) {
                int trackH = visN * itemH;
                SignalInt vsPx = new SignalInt(st.valScroll * itemH);
                Scrollbar.RenderVerticalScroll(app, listX + itemW + app.Scale(3),
                    listTop, trackH, matched.Count * itemH, trackH, vsPx);
                int nvs = vsPx.Get() / itemH;
                if (nvs > maxScroll) { nvs = maxScroll; }
                if (nvs < 0) { nvs = 0; }
                if (nvs != st.valScroll) { st.valScroll = nvs; app.RequestRedraw(); }
            }
            if (app.EventKind() == 13) {
                bool inside = app.mouseX >= mx && app.mouseX < mx + menuW && app.mouseY >= my && app.mouseY < my + menuH;
                if (inside) {
                    int delta = app.window.EventKeyCode();
                    st.valScroll = st.valScroll - delta / 120;
                    if (st.valScroll > maxScroll) { st.valScroll = maxScroll; }
                    if (st.valScroll < 0) { st.valScroll = 0; }
                    app.RequestRedraw();
                }
            }
        } else if (st.filterTab == 1) {
            int chipW = (menuW - pad * 2 - app.Scale(9)) / 4;
            int chipH = app.Scale(24);
            int gap = app.Scale(3);
            if (DataTable.TabBtn(app, mx + pad, cy, chipW, chipH, DataTable.T("Contains", "Contains"), f.textMode == 1)) { f.textMode = 1; DataTable.InvalidateQuery(st); st.FilterChanged.Raise(); app.RequestRedraw(); }
            if (DataTable.TabBtn(app, mx + pad + (chipW + gap), cy, chipW, chipH, DataTable.T("Equals", "Equals"), f.textMode == 2)) { f.textMode = 2; DataTable.InvalidateQuery(st); st.FilterChanged.Raise(); app.RequestRedraw(); }
            if (DataTable.TabBtn(app, mx + pad + (chipW + gap) * 2, cy, chipW, chipH, DataTable.T("Starts", "Starts"), f.textMode == 3)) { f.textMode = 3; DataTable.InvalidateQuery(st); st.FilterChanged.Raise(); app.RequestRedraw(); }
            if (DataTable.TabBtn(app, mx + pad + (chipW + gap) * 3, cy, chipW, chipH, DataTable.T("Ends", "Ends"), f.textMode == 4)) { f.textMode = 4; DataTable.InvalidateQuery(st); st.FilterChanged.Raise(); app.RequestRedraw(); }
            cy = cy + chipH + app.Scale(8);

            int boxH = app.Scale(26);
            DataTable.EditBox(app, mx + pad, cy, menuW - pad * 2, boxH, f.textQuery, DataTable.T("Enter filter text...", "Enter filter text..."), st.editFocus == 2);
            int qId = app.focus.AllocId();
            app.hitTester.RegisterRect(qId, mx + pad, cy, menuW - pad * 2, boxH, 0);
            if (app.EventKind() == 3 && app.hitTester.HitTest(app.mouseX, app.mouseY) == qId) { st.editFocus = 2; app.RequestRedraw(); }
            cy = cy + boxH + app.Scale(10);

            c.DrawText(mx + pad, cy, DataTable.T("Live-filters as you type", "Live-filters as you type"), sHint.FgOr(0), fs);
            cy = cy + Canvas.FontHeight(fs) + app.Scale(2);
            c.DrawText(mx + pad, cy, "(case-insensitive).", sHint.FgOr(0), fs);
        } else if (st.filterTab == 3) {
            cy = DataTable.RenderRulesTab(app, mx, cy, menuW, pad, f, cols[mi], st);
        } else {
            c.DrawText(mx + pad, cy, DataTable.T("One condition per line:", "One condition per line:"), sLabel.FgOr(0), fs);
            cy = cy + Canvas.FontHeight(fs) + app.Scale(4);
            int areaH = contentBottom - cy - app.Scale(66);
            if (areaH < app.Scale(48)) { areaH = app.Scale(48); }
            int aId = app.focus.AllocId();
            int areaState = Style.SNormal();
            if (st.editFocus == 3) { areaState = Style.SFocus(); }
            StyleBox sArea = Style.Part(app, "datatable", "field", "", "", "",
                                        areaState);
            c.FillRoundRect(mx + pad, cy, menuW - pad * 2, areaH, t.borderRadiusSmall, sArea.BgOr(0));
            c.DrawRoundRect(mx + pad, cy, menuW - pad * 2, areaH, t.borderRadiusSmall, sArea.BorderOr(0), 1);
            app.hitTester.RegisterRect(aId, mx + pad, cy, menuW - pad * 2, areaH, 0);
            if (app.EventKind() == 3 && app.hitTester.HitTest(app.mouseX, app.mouseY) == aId) { st.editFocus = 3; app.RequestRedraw(); }
            int lh = Canvas.FontHeight(fs) + app.Scale(3);
            int ly = cy + app.Scale(4);
            for (int li = 0; li < st.batchLines.Count && ly + lh < cy + areaH; li = li + 1) {
                string ln = DataTable.Truncate(st.batchLines[li], fs, menuW - pad * 2 - app.Scale(10));
                c.DrawText(mx + pad + app.Scale(5), ly, ln, sMenu.FgOr(0), fs);
                if (st.editFocus == 3 && li == st.batchLines.Count - 1) {
                    int cxp = mx + pad + app.Scale(5) + Canvas.MeasureText(ln, fs);
                    c.FillRect(cxp, ly, app.Scale(1), Canvas.FontHeight(fs), sAccent.BgOr(0));
                }
                ly = ly + lh;
            }
            cy = cy + areaH + app.Scale(6);

            int exId = app.focus.AllocId();
            bool exact = st.batchExactFlag == 1;
            DataTable.DrawMiniCheck(app, mx + pad, cy, app.Scale(22), exact);
            c.DrawText(mx + pad + app.Scale(22),
                       Canvas.CenterTextY(cy, app.Scale(22), fs),
                       DataTable.T("Exact match", "Exact match"), sMenu.FgOr(0), fs);
            app.hitTester.RegisterRect(exId, mx + pad, cy, app.Scale(130), app.Scale(22), 0);
            if (app.EventKind() == 3 && app.hitTester.HitTest(app.mouseX, app.mouseY) == exId) {
                if (st.batchExactFlag == 1) { st.batchExactFlag = 0; } else { st.batchExactFlag = 1; }
                app.RequestRedraw();
            }
            cy = cy + app.Scale(28);

            int bw = (menuW - pad * 2 - app.Scale(6)) / 2;
            int bh = app.Scale(26);
            bool keepClick = DataTable.TextBtn(app, mx + pad, cy, bw, bh, "Keep matching", true);
            bool exclClick = DataTable.TextBtn(app, mx + pad + bw + app.Scale(6), cy, bw, bh, "Exclude", false);
            if (keepClick || exclClick) {
                f.batchTerms.Clear();
                for (int bl = 0; bl < st.batchLines.Count; bl = bl + 1) {
                    if (st.batchLines[bl].Length > 0) { f.batchTerms.Add(st.batchLines[bl]); }
                }
                f.batchExact = st.batchExactFlag == 1;
                f.batchKeep = keepClick;
                DataTable.InvalidateQuery(st);
                st.FilterChanged.Raise();
                app.RequestRedraw();
            }
        }

        // 页脚：Clear / Close
        int fy = my + menuH - footerH + app.Scale(6);
        int fbw = (menuW - pad * 2 - app.Scale(6)) / 2;
        int fbh = app.Scale(28);
        c.FillRect(mx + pad, my + menuH - footerH, menuW - pad * 2, 1, sGrid.BgOr(0));
        bool clearClick = DataTable.TextBtn(app, mx + pad, fy, fbw, fbh, DataTable.T("Clear Filter", "Clear Filter"), false);
        bool closeClick = DataTable.TextBtn(app, mx + pad + fbw + app.Scale(6), fy, fbw, fbh, DataTable.T("Close", "Close"), false);
        if (clearClick) {
            st.filters[mi] = new ColFilter();
            st.searchText = "";
            st.batchLines = new List<string>();
            st.batchLines.Add("");
            st.batchExactFlag = 0;
            st.editFocus = 0;
            DataTable.InvalidateQuery(st);
            st.FilterChanged.Raise();
            app.RequestRedraw();
        }
        if (closeClick) { st.openMenu = -1; app.RequestRedraw(); }

        // 点击外部关闭菜单（并让编辑框失焦）
        if (app.EventKind() == 3) {
            bool inside = app.mouseX >= mx && app.mouseX < mx + menuW && app.mouseY >= my && app.mouseY < my + menuH;
            bool onIcon = app.mouseY >= y && app.mouseY < y + headerH;
            if (!inside && !onIcon) { st.openMenu = -1; app.RequestRedraw(); }
        }
    }

    /// 在行高 itemH 内垂直居中画一个小复选框；checked 为选中态。
    static void DrawMiniCheck(App app, int bx, int cy, int itemH, bool checked) {
        Theme t = app.theme;
        int box = app.Scale(15);
        int level = 0;
        if (checked) { level = 1000; }
        Checkbox.PaintBox(app, bx, cy + (itemH - box) / 2, box, level);
    }
}
