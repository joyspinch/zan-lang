using System;
using Gui;
using Gui.Widget;
using Gui.Backend;

namespace Gui.Component.DataTable;

/// DataTable part: the header filter UI — DevExpress-style tabbed filter
/// popup (values/rules/calendar), inline editors and the set-filter menu.
partial class DataTable {
    // ---------- tabbed filter popup (DevExpress-style) ----------

    /// The open inline editor, drawn over its cell. Text and spinner editors are
    /// a box with a caret; dropdown and calendar editors add a popup below (or
    /// above, when the cell sits near the bottom of the window). A failed
    /// validation shows its message in place of the popup.
    static void RenderEditor(App app, List<DataColumn> cols, DataSource src,
                             DataTableState st, int edX, int edY, int edW, int edH) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        DataColumn col = cols[st.editCol];
        int epad = t.paddingSmall;
        int efs = t.fontSizeMedium;
        int etY = Canvas.CenterTextY(edY, edH, efs);

        // A rejected value gets a danger border, so the error is visible even
        // when the message itself is clipped by the window edge.
        int bord = t.borderFocus;
        if (st.editError.Length > 0) { bord = t.error; }

        // Reserve room for the affordance the editor owns: spinner steppers, or
        // the dropdown / calendar toggle.
        int btnW = 0;
        if (col.editorKind == 3) { btnW = app.Scale(34); }
        else if (col.editorKind == 1 || col.editorKind == 2) { btnW = app.Scale(20); }
        int textW = edW - btnW;
        if (textW < app.Scale(24)) { textW = app.Scale(24); }

        c.FillRect(edX, edY, edW, edH, t.bgPrimary);
        c.DrawRect(edX, edY, edW, edH, bord, 2);
        c.PushClip(edX + epad, edY, textW - epad * 2, edH);
        c.DrawText(edX + epad, etY, st.editBuf, t.textPrimary, efs);
        int ecaretX = edX + epad + Canvas.MeasureText(Text.Left(st.editBuf, st.editCur), efs);
        c.FillRect(ecaretX, etY, 1, Canvas.FontHeight(efs), t.primary);
        c.PopClip();
        app.SetImeCaret(ecaretX, etY + Canvas.FontHeight(efs));

        if (col.editorKind == 3) {
            // Two half-height steppers, matching a native spin box.
            int sw = app.Scale(16);
            int sx = edX + edW - sw - app.Scale(3);
            int hh = (edH - app.Scale(6)) / 2;
            int sy = edY + app.Scale(3);
            if (DataTable.IconBtn(app, sx, sy, sw, hh, "chevron-up", false)) {
                st.editBuf = DataTable.StepValue(col, st.editBuf, 1);
                st.editCur = st.editBuf.Length;
                st.editError = "";
                app.RequestRedraw();
            }
            if (DataTable.IconBtn(app, sx, sy + hh, sw, hh, "chevron-down", false)) {
                st.editBuf = DataTable.StepValue(col, st.editBuf, -1);
                st.editCur = st.editBuf.Length;
                st.editError = "";
                app.RequestRedraw();
            }
        } else if (col.editorKind == 1 || col.editorKind == 2) {
            int sw = app.Scale(18);
            string ico = "chevron-down";
            if (col.editorKind == 2) { ico = "calendar"; }
            if (DataTable.IconBtn(app, edX + edW - sw - app.Scale(2),
                                  edY + (edH - sw) / 2, sw, sw, ico, st.edPopOpen)) {
                st.edPopOpen = !st.edPopOpen;
                app.RequestRedraw();
            }
        }

        // ---- popup / error, placed below the cell unless that would fall off
        // the bottom of the window ----
        int popW = edW;
        int popH = 0;
        if (st.editError.Length > 0) {
            popH = app.Scale(24);
            int mw = Canvas.MeasureText(st.editError, t.fontSizeSmall) + app.Scale(16);
            if (mw > popW) { popW = mw; }
        } else if (st.edPopOpen && col.editorKind == 1) {
            int itemH = app.Scale(24);
            int n = st.edPopItems.Count;
            if (n > 8) { n = 8; }
            if (n < 1) { n = 1; }
            popH = n * itemH + app.Scale(8);
            if (popW < app.Scale(120)) { popW = app.Scale(120); }
        } else if (st.edPopOpen && col.editorKind == 2) {
            popW = app.Scale(224);
            popH = app.Scale(230);
        }
        if (popH == 0) { return; }

        int popX = edX;
        int popY = edY + edH;
        if (popX + popW > c.Width()) { popX = c.Width() - popW - app.Scale(4); }
        if (popX < app.Scale(2)) { popX = app.Scale(2); }
        if (popY + popH > c.Height()) { popY = edY - popH; }
        if (popY < app.titlebarH) { popY = app.titlebarH; }

        c.FillRoundRect(popX + app.Scale(2), popY + app.Scale(3), popW, popH,
                        t.borderRadiusSmall, t.overlay);
        c.FillRoundRect(popX, popY, popW, popH, t.borderRadiusSmall, t.bgPrimary);

        if (st.editError.Length > 0) {
            c.DrawRect(popX, popY, popW, popH, t.error, 1);
            c.DrawText(popX + app.Scale(8),
                       Canvas.CenterTextY(popY, popH, t.fontSizeSmall),
                       st.editError, t.error, t.fontSizeSmall);
            return;
        }

        c.DrawRect(popX, popY, popW, popH, t.borderPrimary, 1);
        app.CaptureWheel(popX, popY, popW, popH);
        app.BlockHitsRect(popX, popY, popW, popH);
        // The popup draws before the body reads the pointer, so flag the overlap
        // for the press handler: without this a click on a list item would also
        // land on the cell underneath, committing and closing the editor before
        // the item could be picked.
        if (app.mouseX >= popX && app.mouseX < popX + popW
            && app.mouseY >= popY && app.mouseY < popY + popH) {
            st.edPopHot = true;
        }
        if (col.editorKind == 1) {
            DataTable.RenderChoiceList(app, col, st, popX, popY, popW, popH);
        } else {
            DataTable.RenderCalendar(app, col, st, popX, popY, popW, popH);
        }
    }

    /// The dropdown list: up to 8 visible rows out of the filtered choices.
    static void RenderChoiceList(App app, DataColumn col, DataTableState st,
                                 int px, int py, int pw, int ph) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int fs = t.fontSizeSmall;
        int itemH = app.Scale(24);
        int pad = app.Scale(4);
        int vis = (ph - pad * 2) / itemH;
        if (vis < 1) { vis = 1; }

        if (st.edPopItems.Count == 0) {
            c.DrawText(px + app.Scale(8), py + Canvas.CenterTextY(pad, itemH, fs),
                       "No match", t.textTertiary, fs);
            return;
        }

        // Keep the highlight on screen after keyboard movement.
        int selAt = -1;
        int q = 0;
        while (q < st.edPopItems.Count) {
            if (st.edPopItems[q] == st.edPopSel) { selAt = q; q = st.edPopItems.Count; }
            else { q = q + 1; }
        }
        if (selAt >= 0) {
            if (selAt < st.edPopScroll) { st.edPopScroll = selAt; }
            if (selAt >= st.edPopScroll + vis) { st.edPopScroll = selAt - vis + 1; }
        }
        int maxScroll = st.edPopItems.Count - vis;
        if (maxScroll < 0) { maxScroll = 0; }
        if (st.edPopScroll > maxScroll) { st.edPopScroll = maxScroll; }
        if (st.edPopScroll < 0) { st.edPopScroll = 0; }

        // Wheel over the list scrolls it (delta arrives as the key code on a
        // kind-13 event, per the convention the table body already uses).
        if (app.EventKind() == 13 && maxScroll > 0
            && app.mouseX >= px && app.mouseX < px + pw
            && app.mouseY >= py && app.mouseY < py + ph) {
            int delta = app.window.EventKeyCode();
            int step = delta / 120;
            if (step == 0) { if (delta > 0) { step = 1; } else if (delta < 0) { step = 0 - 1; } }
            st.edPopScroll = st.edPopScroll - step;
            if (st.edPopScroll > maxScroll) { st.edPopScroll = maxScroll; }
            if (st.edPopScroll < 0) { st.edPopScroll = 0; }
            app.RequestRedraw();
        }

        int i = 0;
        while (i < vis && st.edPopScroll + i < st.edPopItems.Count) {
            int ci = st.edPopItems[st.edPopScroll + i];
            int iy = py + pad + i * itemH;
            int id = app.focus.AllocId();
            bool hov = app.focus.IsHovered(id);
            if (ci == st.edPopSel) { c.FillRect(px + pad, iy, pw - pad * 2, itemH, t.bgActive); }
            else if (hov) { c.FillRect(px + pad, iy, pw - pad * 2, itemH, t.bgHover); }
            c.DrawText(px + app.Scale(8), Canvas.CenterTextY(iy, itemH, fs),
                       DataTable.Truncate(col.choices[ci], fs, pw - app.Scale(16)),
                       t.textPrimary, fs);
            app.hitTester.Register(HitRegion.Create(id, px + pad, iy, pw - pad * 2, itemH, 0));
            if (app.EventKind() == 3 && app.hitTester.HitTest(app.mouseX, app.mouseY) == id) {
                st.editBuf = col.choices[ci];
                st.editCur = st.editBuf.Length;
                st.edPopSel = ci;
                st.editError = "";
                app.RequestRedraw();
            }
            i = i + 1;
        }
    }

    /// A month grid. Clicking a day writes it back through the column's own date
    /// format, so the stored text keeps whatever shape the column declares.
    static void RenderCalendar(App app, DataColumn col, DataTableState st,
                               int px, int py, int pw, int ph) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int fs = t.fontSizeSmall;
        int pad = app.Scale(8);
        int hdrH = app.Scale(26);
        int cw = (pw - pad * 2) / 7;
        int chh = app.Scale(24);

        // header: month name with prev/next steppers
        int y = DataTable.YmYear(st.edCalMonth);
        int m = DataTable.YmMonth(st.edCalMonth);
        if (DataTable.IconBtn(app, px + pad, py + app.Scale(3), app.Scale(22), hdrH,
                              "chevron-left", false)) {
            st.edCalMonth = st.edCalMonth - 1;
            app.RequestRedraw();
        }
        if (DataTable.IconBtn(app, px + pw - pad - app.Scale(22), py + app.Scale(3),
                              app.Scale(22), hdrH, "chevron-right", false)) {
            st.edCalMonth = st.edCalMonth + 1;
            app.RequestRedraw();
        }
        c.DrawTextCentered(px + pad + app.Scale(24), py + app.Scale(3),
                           pw - pad * 2 - app.Scale(48), hdrH,
                           DataTable.MonthAbbr(m) + " " + Convert.ToString(y),
                           t.textPrimary, t.fontSizeMedium);

        // weekday captions
        List<string> dows = new List<string>{
            "Su", "Mo", "Tu", "We",
            "Th", "Fr", "Sa" };
        int dy = py + app.Scale(3) + hdrH;
        int di = 0;
        while (di < 7) {
            c.DrawTextCentered(px + pad + di * cw, dy, cw, app.Scale(18),
                               dows[di], t.textTertiary, t.fontSizeSmall);
            di = di + 1;
        }

        int gridY = dy + app.Scale(18);
        List<int> cells = DataTable.MonthCells(st.edCalMonth);
        int today = DataTable.Today();
        int i = 0;
        while (i < 42) {
            int day = cells[i];
            if (day > 0) {
                int gx = px + pad + (i % 7) * cw;
                int gy = gridY + (i / 7) * chh;
                int dnum = DateTime.DaysFromCivil(y, m, day);
                int id = app.focus.AllocId();
                bool hov = app.focus.IsHovered(id);
                int fg = t.textPrimary;
                if (dnum == st.edPopSel) {
                    c.FillRoundRect(gx + app.Scale(2), gy + app.Scale(1),
                                    cw - app.Scale(4), chh - app.Scale(2),
                                    t.borderRadiusSmall, t.primary);
                    fg = t.textInverse;
                } else if (hov) {
                    c.FillRoundRect(gx + app.Scale(2), gy + app.Scale(1),
                                    cw - app.Scale(4), chh - app.Scale(2),
                                    t.borderRadiusSmall, t.bgHover);
                } else if (dnum == today) {
                    c.DrawRect(gx + app.Scale(2), gy + app.Scale(1),
                               cw - app.Scale(4), chh - app.Scale(2), t.primary, 1);
                }
                c.DrawTextCentered(gx, gy, cw, chh, Convert.ToString(day), fg, fs);
                app.hitTester.Register(HitRegion.Create(id, gx, gy, cw, chh, 0));
                if (app.EventKind() == 3 && app.hitTester.HitTest(app.mouseX, app.mouseY) == id) {
                    st.edPopSel = dnum;
                    st.editBuf = DataTable.FormatDate(dnum, DataTable.DateStoreFormat(col));
                    st.editCur = st.editBuf.Length;
                    st.editError = "";
                    app.RequestRedraw();
                }
            }
            i = i + 1;
        }
    }

    static bool TabBtn(App app, int bx, int by, int bw, int bh, string label, bool active) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int id = app.focus.AllocId();
        bool hov = app.focus.IsHovered(id);
        if (active) { c.FillRect(bx, by, bw, bh, t.bgActive); }
        else if (hov) { c.FillRect(bx, by, bw, bh, t.bgHover); }
        int fg = t.textSecondary;
        if (active) { fg = t.primary; }
        c.DrawTextCentered(bx, by, bw, bh, label, fg, t.fontSizeSmall);
        if (active) { c.FillRect(bx, by + bh - app.Scale(2), bw, app.Scale(2), t.primary); }
        app.hitTester.Register(HitRegion.Create(id, bx, by, bw, bh, 0));
        return app.EventKind() == 3 && app.hitTester.HitTest(app.mouseX, app.mouseY) == id;
    }

    /// Icon-only toolbar button with an "active" (toggled) look.
    static bool IconBtn(App app, int bx, int by, int bw, int bh, string icon, bool active) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int id = app.focus.AllocId();
        int col = t.textSecondary;
        if (active) {
            app.FillChrome(bx, by, bw, bh, t.borderRadiusSmall, t.bgActive);
            col = t.primary;
        } else if (app.focus.IsHovered(id)) {
            app.FillChrome(bx, by, bw, bh, t.borderRadiusSmall, t.bgHover);
        }
        c.DrawGlyphIn(icon, bx, by, bw, bh, app.Scale(13), col);
        app.hitTester.Register(HitRegion.Create(id, bx, by, bw, bh, 0));
        return app.EventKind() == 3 && app.hitTester.HitTest(app.mouseX, app.mouseY) == id;
    }

    /// Labelled toolbar button, filled in the accent colour when `primary`.
    static bool TextBtn(App app, int bx, int by, int bw, int bh, string label, bool primary) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int id = app.focus.AllocId();
        bool hov = app.focus.IsHovered(id);
        int bg = t.bgSecondary;
        int fg = t.textPrimary;
        if (primary) {
            bg = t.primary;
            fg = t.textInverse;
            if (hov) { bg = t.primaryHover; }
        } else if (hov) {
            bg = t.bgHover;
        }
        c.FillRoundRect(bx, by, bw, bh, t.borderRadiusSmall, bg);
        if (!primary) { c.DrawRect(bx, by, bw, bh, t.borderPrimary, 1); }
        c.DrawTextCentered(bx, by, bw, bh, label, fg, t.fontSizeSmall);
        app.hitTester.Register(HitRegion.Create(id, bx, by, bw, bh, 0));
        return app.EventKind() == 3 && app.hitTester.HitTest(app.mouseX, app.mouseY) == id;
    }

    static void EditBox(App app, int bx, int by, int bw, int bh, string text, string ph, bool focused) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int fs = t.fontSizeSmall;
        int bc = t.borderPrimary;
        if (focused) { bc = t.borderFocus; }
        c.FillRoundRect(bx, by, bw, bh, t.borderRadiusSmall, t.bgPrimary);
        c.DrawRoundRect(bx, by, bw, bh, t.borderRadiusSmall, bc, 1);
        int tpad = app.Scale(6);
        int ty = Canvas.CenterTextY(by, bh, fs);
        string shown = DataTable.Truncate(text, fs, bw - tpad * 2);
        if (text.Length == 0) {
            c.DrawText(bx + tpad, ty, ph, t.textTertiary, fs);
        } else {
            c.DrawText(bx + tpad, ty, shown, t.textPrimary, fs);
        }
        if (focused) {
            int cxp = bx + tpad + Canvas.MeasureText(shown, fs);
            if (cxp > bx + bw - tpad) { cxp = bx + bw - tpad; }
            c.FillRect(cxp, ty, app.Scale(1), Canvas.FontHeight(fs), t.primary);
        }
    }

    /// Handle one key-down for the cell cursor. Returns true when the key was
    /// consumed, so the caller can stop it reaching scroll/selection handling.
    ///
    /// Movement works in display slots (so group headers are stepped over) and
    /// in visible-column positions (so hidden and reordered columns behave).
    /// Shift extends the range from its anchor; Ctrl jumps to the edge.
    static bool HandleNavKey(App app, List<DataColumn> cols, DataSource src,
                             DataTableState st, List<FrameColumn> columns, int visRows,
                             int dataViewW, int pinnedW, int kc, int emods) {
        if (columns.Count == 0) { return false; }
        bool shift = Modifiers.HasShift(emods);
        bool ctrl = Modifiers.HasCtrl(emods);

        // ---- clipboard / selection shortcuts ----
        if (ctrl && kc == 67) {                     // Ctrl+C
            Clipboard.SetText(DataTable.CopyText(st, cols, src));
            DataTable.Flash(st, "已复制到剪贴板");
            return true;
        }
        if (ctrl && kc == 88) {                     // Ctrl+X: copy, then blank
            Clipboard.SetText(DataTable.CopyText(st, cols, src));
            int cut = DataTable.ClearRangeCells(st, cols, src);
            if (cut > 0) { DataTable.Flash(st, "已剪切 " + Convert.ToString(cut) + " 个单元格"); }
            else { DataTable.Flash(st, "已复制到剪贴板"); }
            return true;
        }
        if (ctrl && kc == 86) {                     // Ctrl+V
            int n = DataTable.PasteText(st, cols, src, Clipboard.GetText());
            if (n > 0) { DataTable.Flash(st, "已粘贴 " + Convert.ToString(n) + " 个单元格"); }
            else { DataTable.Flash(st, "无可粘贴的可编辑单元格"); }
            return true;
        }
        if (ctrl && kc == 65) {                     // Ctrl+A: whole grid
            DataTable.SelectAllRows(st, true);
            int firstSlot = DataTable.FirstDataSlot(st);
            int lastSlot = DataTable.LastDataSlot(st);
            if (firstSlot >= 0) {
                st.rangeR0 = firstSlot;
                st.rangeR1 = lastSlot;
                st.rangeC0 = columns[0].column;
                st.rangeC1 = columns[columns.Count - 1].column;
            }
            st.SelectionChanged.Raise();
            return true;
        }
        if (ctrl && kc == 90) {                     // Ctrl+Z
            if (DataTable.Undo(st, cols, src)) {
                DataTable.Recompute(st, cols, src);
                DataTable.Flash(st, "已撤销");
            } else {
                DataTable.Flash(st, "没有可撤销的操作");
            }
            return true;
        }
        // Ctrl+Delete removes whole rows; plain Delete only blanks cells. The
        // destructive one is deliberately the harder chord to hit by accident.
        if (ctrl && kc == 46) {
            int killed = DataTable.DeleteSelectedRows(st, cols, src);
            if (killed == 0 && st.hitRow >= 0) {
                if (DataTable.DeleteRow(st, cols, src, st.hitRow)) { killed = 1; }
            }
            if (killed > 0) {
                DataTable.Recompute(st, cols, src);
                DataTable.Flash(st, "已删除 " + Convert.ToString(killed) + " 行（Ctrl+Z 撤销）");
            } else {
                DataTable.Flash(st, "该数据源不支持删除行");
            }
            return true;
        }
        if (ctrl && kc == 45) {                     // Ctrl+Insert appends a row
            int nr = DataTable.AppendRow(st, cols, src);
            if (nr >= 0) {
                DataTable.Recompute(st, cols, src);
                DataTable.FocusRow(st, cols, src, nr);
            } else {
                DataTable.Flash(st, "该数据源不支持添加行");
            }
            return true;
        }
        if (kc == 46 && !ctrl) {                    // Delete blanks the range
            return DataTable.ClearRangeCells(st, cols, src) > 0;
        }
        if (kc == 32 && st.hitRow >= 0) {           // Space checks the row
            st.selected[st.hitRow] = !st.selected[st.hitRow];
            st.SelectionChanged.Raise();
            return true;
        }

        if (!DataTable.IsNavKey(kc)) { return false; }
        // A navigation key is claimed even when the cursor is already at the
        // edge, so an arrow can't fall through and scroll the page instead.
        List<int> tgt = DataTable.NavTarget(st, columns, visRows, kc, emods);
        int newSlot = tgt[0];
        int newCol = tgt[1];
        if (newSlot < 0 || newCol < 0) { return true; }
        // Tab commits like a form field, so it always collapses the range even
        // when Shift is held (Shift+Tab means "backwards", not "extend").
        bool extend = shift && kc != 9;
        if (!DataTable.MoveCursor(st, newSlot, newCol, extend)) { return true; }
        DataTable.ScrollSlotIntoView(st, newSlot, visRows);
        DataTable.ScrollColIntoView(st, columns, newCol, dataViewW, pinnedW);
        st.CellClick.Raise();
        return true;
    }

    /// A small pill that reads as selected when `on`. Used for the rule chips,
    /// which are radio-like: clicking the active one turns the rule off.
    static bool Chip(App app, int bx, int by, int bw, int bh, string label, bool on) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int id = app.focus.AllocId();
        int bg = t.bgSecondary;
        int fg = t.textSecondary;
        if (on) { bg = t.primary; fg = t.textInverse; }
        else if (app.focus.IsHovered(id)) { bg = t.bgHover; }
        c.FillRoundRect(bx, by, bw, bh, bh / 2, bg);
        if (!on) { c.DrawRect(bx, by, bw, bh, t.borderPrimary, 1); }
        c.DrawTextCentered(bx, by, bw, bh, label, fg, t.fontSizeSmall);
        app.hitTester.Register(HitRegion.Create(id, bx, by, bw, bh, 0));
        return app.EventKind() == 3 && app.hitTester.HitTest(app.mouseX, app.mouseY) == id;
    }

    /// The "Rules" filter tab: value comparison, relative date presets (date
    /// columns only) and top-N. Returns the y below the content it drew.
    // Height RenderRulesTab will occupy for this filter/column pair. Kept
    // beside the renderer so the two stay in step: every `cy` advance there has
    // a matching term here, including the sections that only appear for date
    // columns or once a counted top/bottom mode is picked.
    static int RulesTabHeight(App app, ColFilter f, DataColumn col) {
        int chipH = app.Scale(22);
        int gap = app.Scale(4);
        int boxH = app.Scale(26);
        int lblH = Canvas.FontHeight(app.theme.fontSizeSmall) + app.Scale(4);

        int h = lblH;                            // "Compare"
        h = h + (chipH + gap) * 2;               // eight operator chips
        h = h + chipH + app.Scale(6);            // is empty / not empty
        if (f.cmpMode != 0 && f.cmpMode != 9 && f.cmpMode != 10) {
            h = h + boxH + app.Scale(4);         // one or two operand boxes
        }
        h = h + app.Scale(6);
        if (col.isDate) {
            h = h + lblH + (chipH + gap) * 4 + app.Scale(6);
        }
        h = h + lblH;                            // "Top / bottom"
        h = h + (chipH + gap) * 2;               // six top/bottom chips
        if (f.topMode >= 1 && f.topMode <= 4) { h = h + boxH; }
        return h;
    }

    static int RenderRulesTab(App app, int mx, int cy, int menuW, int pad,
                              ColFilter f, DataColumn col, DataTableState st) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int fs = t.fontSizeSmall;
        int chipH = app.Scale(22);
        int gap = app.Scale(4);
        int innerW = menuW - pad * 2;

        // ---- comparison ----
        c.DrawText(mx + pad, cy, "Compare", t.textSecondary, fs);
        cy = cy + Canvas.FontHeight(fs) + app.Scale(4);

        // two rows of four operators; a chip toggles its own mode off again
        int cw4 = (innerW - gap * 3) / 4;
        List<string> ops = new List<string>{
            ">", ">=", "<", "<=",
            "=", "<>", "in", "not in" };
        int oi = 0;
        while (oi < ops.Count) {
            int mode = oi + 1;
            int bx = mx + pad + (cw4 + gap) * (oi % 4);
            int by = cy + (chipH + gap) * (oi / 4);
            if (DataTable.Chip(app, bx, by, cw4, chipH, ops[oi], f.cmpMode == mode)) {
                if (f.cmpMode == mode) { f.cmpMode = 0; } else { f.cmpMode = mode; }
                st.editFocus = 4;
                st.dirty = true;
                st.FilterChanged.Raise();
                app.RequestRedraw();
            }
            oi = oi + 1;
        }
        cy = cy + (chipH + gap) * 2;

        // the two blank-ness rules take a wider chip since they need no operand
        int cw2 = (innerW - gap) / 2;
        if (DataTable.Chip(app, mx + pad, cy, cw2, chipH, "is empty", f.cmpMode == 9)) {
            if (f.cmpMode == 9) { f.cmpMode = 0; } else { f.cmpMode = 9; st.editFocus = 0; }
            st.dirty = true; st.FilterChanged.Raise(); app.RequestRedraw();
        }
        if (DataTable.Chip(app, mx + pad + cw2 + gap, cy, cw2, chipH, "not empty", f.cmpMode == 10)) {
            if (f.cmpMode == 10) { f.cmpMode = 0; } else { f.cmpMode = 10; st.editFocus = 0; }
            st.dirty = true; st.FilterChanged.Raise(); app.RequestRedraw();
        }
        cy = cy + chipH + app.Scale(6);

        // operand boxes: one for the one-sided operators, two for in/not in.
        // The blank-ness rules need none, so they get no boxes at all.
        bool twoSided = f.cmpMode == 7 || f.cmpMode == 8;
        bool needsA = f.cmpMode != 0 && f.cmpMode != 9 && f.cmpMode != 10;
        int boxH = app.Scale(26);
        if (needsA) {
            int aw = innerW;
            if (twoSided) { aw = (innerW - gap) / 2; }
            DataTable.EditBox(app, mx + pad, cy, aw, boxH, f.cmpA, "value", st.editFocus == 4);
            int aId = app.focus.AllocId();
            app.hitTester.Register(HitRegion.Create(aId, mx + pad, cy, aw, boxH, 0));
            if (app.EventKind() == 3 && app.hitTester.HitTest(app.mouseX, app.mouseY) == aId) {
                st.editFocus = 4; app.RequestRedraw();
            }
            if (twoSided) {
                int bx2 = mx + pad + aw + gap;
                DataTable.EditBox(app, bx2, cy, aw, boxH, f.cmpB, "and", st.editFocus == 5);
                int bId = app.focus.AllocId();
                app.hitTester.Register(HitRegion.Create(bId, bx2, cy, aw, boxH, 0));
                if (app.EventKind() == 3 && app.hitTester.HitTest(app.mouseX, app.mouseY) == bId) {
                    st.editFocus = 5; app.RequestRedraw();
                }
            }
            cy = cy + boxH + app.Scale(4);
        }
        cy = cy + app.Scale(6);

        // ---- date presets (date columns only) ----
        if (col.isDate) {
            c.DrawText(mx + pad, cy, "Date range", t.textSecondary, fs);
            cy = cy + Canvas.FontHeight(fs) + app.Scale(4);
            List<string> ps = new List<string>{
                "Today", "Yesterday", "This week",
                "Last 7d", "This month", "Last 30d",
                "Quarter", "This year", "YTD",
                "Past", "Future" };
            int cw3 = (innerW - gap * 2) / 3;
            int pi = 0;
            while (pi < ps.Count) {
                int preset = pi + 1;
                int bx = mx + pad + (cw3 + gap) * (pi % 3);
                int by = cy + (chipH + gap) * (pi / 3);
                if (DataTable.Chip(app, bx, by, cw3, chipH, ps[pi], f.datePreset == preset)) {
                    if (f.datePreset == preset) { f.datePreset = 0; } else { f.datePreset = preset; }
                    st.dirty = true; st.FilterChanged.Raise(); app.RequestRedraw();
                }
                pi = pi + 1;
            }
            cy = cy + (chipH + gap) * 4 + app.Scale(6);
        }

        // ---- top-N ----
        c.DrawText(mx + pad, cy, "Top / bottom", t.textSecondary, fs);
        cy = cy + Canvas.FontHeight(fs) + app.Scale(4);
        List<string> tops = new List<string>{
            "Top N", "Bottom N", "Top N%",
            "Bot N%", "Above avg", "Below avg" };
        int cw3b = (innerW - gap * 2) / 3;
        int ti = 0;
        while (ti < tops.Count) {
            int mode = ti + 1;
            int bx = mx + pad + (cw3b + gap) * (ti % 3);
            int by = cy + (chipH + gap) * (ti / 3);
            if (DataTable.Chip(app, bx, by, cw3b, chipH, tops[ti], f.topMode == mode)) {
                if (f.topMode == mode) { f.topMode = 0; } else { f.topMode = mode; }
                st.dirty = true; st.FilterChanged.Raise(); app.RequestRedraw();
            }
            ti = ti + 1;
        }
        cy = cy + (chipH + gap) * 2;

        // N only matters for the four counted modes
        if (f.topMode >= 1 && f.topMode <= 4) {
            int lw = app.Scale(20);
            c.DrawText(mx + pad, Canvas.CenterTextY(cy, boxH, fs), "N", t.textSecondary, fs);
            int nx = mx + pad + lw;
            int nw = app.Scale(64);
            DataTable.EditBox(app, nx, cy, nw, boxH, Convert.ToString(f.topN), "10", st.editFocus == 6);
            int nId = app.focus.AllocId();
            app.hitTester.Register(HitRegion.Create(nId, nx, cy, nw, boxH, 0));
            if (app.EventKind() == 3 && app.hitTester.HitTest(app.mouseX, app.mouseY) == nId) {
                st.editFocus = 6; app.RequestRedraw();
            }
            int spw = app.Scale(24);
            if (DataTable.TextBtn(app, nx + nw + gap, cy, spw, boxH, "-", false)) {
                if (f.topN > 1) { f.topN = f.topN - 1; st.dirty = true; st.FilterChanged.Raise(); }
                app.RequestRedraw();
            }
            if (DataTable.TextBtn(app, nx + nw + gap + spw + gap, cy, spw, boxH, "+", false)) {
                f.topN = f.topN + 1; st.dirty = true; st.FilterChanged.Raise(); app.RequestRedraw();
            }
            cy = cy + boxH;
        }
        return cy;
    }

    static void RenderMenu(App app, int x, int y, int viewW, int headerH, int numW, int selW,
                           List<DataColumn> cols, DataSource src, DataTableState st) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int mi = st.openMenu;
        ColFilter f = st.filters[mi];

        int pad = app.Scale(10);
        int fs = t.fontSizeSmall;
        int fsM = t.fontSizeMedium;
        int rowH = app.Scale(28);
        int menuW = app.Scale(256);
        int menuH = app.Scale(348);
        // The Rules tab stacks several sections of varying height, so its panel
        // is sized from the same layout math the tab itself uses rather than a
        // hand-tuned constant that would clip when the theme's metrics change.
        if (st.filterTab == 3) {
            menuH = app.Scale(8) + rowH + app.Scale(6)      // title row
                  + rowH + app.Scale(8)                      // tab strip
                  + DataTable.RulesTabHeight(app, f, cols[mi])
                  + app.Scale(40);                           // footer
        }

        // anchor under the column, clamp fully inside the window
        int mx = x + numW + selW - st.scrollX;
        int k = 0;
        while (k < mi) { mx = mx + st.dispW[k]; k = k + 1; }
        if (mx + menuW > x + viewW) { mx = x + viewW - menuW; }
        if (mx < x) { mx = x; }
        int my = y + headerH;
        int canH = c.Height();
        if (my + menuH > canH) { my = canH - menuH - app.Scale(6); }
        if (my < app.titlebarH) { my = app.titlebarH; }

        // claim the wheel over the popup so the page underneath doesn't scroll
        app.CaptureWheel(mx, my, menuW, menuH);
        // swallow clicks over the whole panel so empty areas don't fall through
        app.BlockHitsRect(mx, my, menuW, menuH);

        // route typed keys to the focused edit field
        if (app.EventKind() == 6 && st.editFocus != 0) {
            int chv = app.window.EventKeyCode();
            if (st.editFocus == 1) {
                if (chv == 8) { st.searchText = DataTable.Backspace(st.searchText); }
                else { string ad = Text.CharStr(chv); if (ad.Length > 0) { st.searchText = st.searchText + ad; } }
            } else if (st.editFocus == 2) {
                if (chv == 8) { f.textQuery = DataTable.Backspace(f.textQuery); }
                else { string ad = Text.CharStr(chv); if (ad.Length > 0) { f.textQuery = f.textQuery + ad; } }
                st.dirty = true;
                st.FilterChanged.Raise();
            } else if (st.editFocus == 3) {
                int last = st.batchLines.Count - 1;
                if (last < 0) { st.batchLines.Add(""); last = 0; }
                if (chv == 13) { st.batchLines.Add(""); }
                else if (chv == 8) {
                    string cur = st.batchLines[last];
                    if (cur.Length > 0) { st.batchLines[last] = DataTable.Backspace(cur); }
                    else if (last > 0) { st.batchLines.RemoveAt(last); }
                } else {
                    string ad = Text.CharStr(chv);
                    if (ad.Length > 0) { st.batchLines[last] = st.batchLines[last] + ad; }
                }
            } else if (st.editFocus == 4 || st.editFocus == 5) {
                // comparison operands: edited live, like the Text tab's query
                string cur = f.cmpA;
                if (st.editFocus == 5) { cur = f.cmpB; }
                if (chv == 8) { cur = DataTable.Backspace(cur); }
                else { string ad = Text.CharStr(chv); if (ad.Length > 0) { cur = cur + ad; } }
                if (st.editFocus == 5) { f.cmpB = cur; } else { f.cmpA = cur; }
                st.dirty = true;
                st.FilterChanged.Raise();
            } else if (st.editFocus == 6) {
                // top-N count: digits only, so the spinner value stays a number
                if (chv == 8) {
                    f.topN = f.topN / 10;
                } else if (chv >= 48 && chv <= 57 && f.topN < 100000) {
                    f.topN = f.topN * 10 + (chv - 48);
                }
                st.dirty = true;
                st.FilterChanged.Raise();
            }
            app.RequestRedraw();
        }

        // panel
        c.FillRoundRect(mx + app.Scale(2), my + app.Scale(3), menuW, menuH, t.borderRadiusMedium, t.overlay);
        c.FillRoundRect(mx, my, menuW, menuH, t.borderRadiusMedium, t.bgPrimary);
        c.DrawRoundRect(mx, my, menuW, menuH, t.borderRadiusMedium, t.borderPrimary, 1);

        // header: title + sort asc/desc
        int hy = my + app.Scale(8);
        c.DrawText(mx + pad, Canvas.CenterTextY(hy, rowH, fsM), cols[mi].title, t.textPrimary, fsM);
        int sbw = app.Scale(26);
        int sUpX = mx + menuW - pad - sbw * 2 - app.Scale(4);
        int sDnX = mx + menuW - pad - sbw;
        if (DataTable.IconBtn(app, sUpX, hy, sbw, rowH, "arrow-up", st.sortCol == mi && st.sortDir == 1)) {
            DataTable.SortBy(st, mi, 1); app.RequestRedraw();
        }
        if (DataTable.IconBtn(app, sDnX, hy, sbw, rowH, "arrow-down", st.sortCol == mi && st.sortDir == 2)) {
            DataTable.SortBy(st, mi, 2); app.RequestRedraw();
        }
        int cy = hy + rowH + app.Scale(6);

        // tabs
        int tabW = (menuW - pad * 2) / 4;
        if (DataTable.TabBtn(app, mx + pad, cy, tabW, rowH, "Values", st.filterTab == 0)) { st.filterTab = 0; st.editFocus = 0; app.RequestRedraw(); }
        if (DataTable.TabBtn(app, mx + pad + tabW, cy, tabW, rowH, "Text", st.filterTab == 1)) { st.filterTab = 1; st.editFocus = 0; app.RequestRedraw(); }
        if (DataTable.TabBtn(app, mx + pad + tabW * 2, cy, tabW, rowH, "Batch", st.filterTab == 2)) { st.filterTab = 2; st.editFocus = 0; app.RequestRedraw(); }
        if (DataTable.TabBtn(app, mx + pad + tabW * 3, cy, tabW, rowH, "Rules", st.filterTab == 3)) { st.filterTab = 3; st.editFocus = 0; app.RequestRedraw(); }
        c.FillRect(mx + pad, cy + rowH, menuW - pad * 2, 1, t.divider);
        cy = cy + rowH + app.Scale(8);

        int footerH = app.Scale(40);
        int contentBottom = my + menuH - footerH;

        if (st.filterTab == 0) {
            int boxH = app.Scale(26);
            DataTable.EditBox(app, mx + pad, cy, menuW - pad * 2, boxH, st.searchText, "Search values...", st.editFocus == 1);
            int sId = app.focus.AllocId();
            app.hitTester.Register(HitRegion.Create(sId, mx + pad, cy, menuW - pad * 2, boxH, 0));
            if (app.EventKind() == 3 && app.hitTester.HitTest(app.mouseX, app.mouseY) == sId) { st.editFocus = 1; app.RequestRedraw(); }
            cy = cy + boxH + app.Scale(6);

            int itemH = app.Scale(24);
            int allId = app.focus.AllocId();
            bool anyHidden = f.hidden.Count > 0;
            if (app.focus.IsHovered(allId)) { c.FillRect(mx + pad, cy, menuW - pad * 2, itemH, t.bgHover); }
            DataTable.DrawMiniCheck(app, mx + pad, cy, itemH, !anyHidden);
            c.DrawText(mx + pad + app.Scale(22), Canvas.CenterTextY(cy, itemH, fs), "(Select All)", t.textPrimary, fs);
            app.hitTester.Register(HitRegion.Create(allId, mx + pad, cy, menuW - pad * 2, itemH, 0));
            if (app.EventKind() == 3 && app.hitTester.HitTest(app.mouseX, app.mouseY) == allId) {
                f.hidden.Clear();
                st.dirty = true; st.FilterChanged.Raise(); app.RequestRedraw();
            }
            cy = cy + itemH;

            // Rebuild the filtered value list only when the search text changes
            // (not every frame): a column can have thousands of distinct values,
            // so re-scanning + reallocating each frame would stutter. The list
            // is virtualised — only the visible window is drawn — so it stays
            // smooth no matter how many distinct values there are.
            if (!(st.searchText == st.menuSearchCache)) {
                st.menuMatched = new List<string>();
                int vi0 = 0;
                while (vi0 < st.menuVals.Count) {
                    if (DataTable.ContainsCI(st.menuVals[vi0], st.searchText)) { st.menuMatched.Add(st.menuVals[vi0]); }
                    vi0 = vi0 + 1;
                }
                st.menuSearchCache = st.searchText;
                st.valScroll = 0;
            }
            List<string> matched = st.menuMatched;

            int sbGW = app.Scale(10);
            int listX = mx + pad;
            int itemW = menuW - pad * 2 - sbGW;
            int listH = contentBottom - cy;
            int visN = listH / itemH;
            if (visN < 1) { visN = 1; }
            int maxScroll = matched.Count - visN;
            if (maxScroll < 0) { maxScroll = 0; }
            if (st.valScroll > maxScroll) { st.valScroll = maxScroll; }
            if (st.valScroll < 0) { st.valScroll = 0; }

            int listTop = cy;
            int r2 = 0;
            while (r2 < visN && (st.valScroll + r2) < matched.Count) {
                string v = matched[st.valScroll + r2];
                int vId = app.focus.AllocId();
                if (app.focus.IsHovered(vId)) { c.FillRect(listX, cy, itemW, itemH, t.bgHover); }
                bool visible = !f.IsHidden(v);
                DataTable.DrawMiniCheck(app, listX, cy, itemH, visible);
                string label = DataTable.Truncate(v, fs, itemW - app.Scale(26));
                c.DrawText(listX + app.Scale(22), Canvas.CenterTextY(cy, itemH, fs), label, t.textPrimary, fs);
                app.hitTester.Register(HitRegion.Create(vId, listX, cy, itemW, itemH, 0));
                if (app.EventKind() == 3 && app.hitTester.HitTest(app.mouseX, app.mouseY) == vId) {
                    f.Toggle(v); st.dirty = true; st.FilterChanged.Raise(); app.RequestRedraw();
                }
                cy = cy + itemH;
                r2 = r2 + 1;
            }

            // draggable scrollbar for the virtualised value list
            if (matched.Count > visN) {
                int trackH = visN * itemH;
                SignalInt vsPx = SignalInt.Create(st.valScroll * itemH);
                Scrollbar.RenderVerticalScroll(app, listX + itemW + app.Scale(3),
                    listTop, trackH, matched.Count * itemH, trackH, vsPx);
                int nvs = vsPx.Get() / itemH;
                if (nvs > maxScroll) { nvs = maxScroll; }
                if (nvs < 0) { nvs = 0; }
                if (nvs != st.valScroll) { st.valScroll = nvs; app.RequestRedraw(); }
            }
            if (app.EventKind() == 13) {
                bool inside = app.mouseX >= mx && app.mouseX < mx + menuW && app.mouseY >= my && app.mouseY < my + menuH;
                if (inside) {
                    int delta = app.window.EventKeyCode();
                    st.valScroll = st.valScroll - delta / 120;
                    if (st.valScroll > maxScroll) { st.valScroll = maxScroll; }
                    if (st.valScroll < 0) { st.valScroll = 0; }
                    app.RequestRedraw();
                }
            }
        } else if (st.filterTab == 1) {
            int chipW = (menuW - pad * 2 - app.Scale(9)) / 4;
            int chipH = app.Scale(24);
            int gap = app.Scale(3);
            if (DataTable.TabBtn(app, mx + pad, cy, chipW, chipH, "Contains", f.textMode == 1)) { f.textMode = 1; st.dirty = true; st.FilterChanged.Raise(); app.RequestRedraw(); }
            if (DataTable.TabBtn(app, mx + pad + (chipW + gap), cy, chipW, chipH, "Equals", f.textMode == 2)) { f.textMode = 2; st.dirty = true; st.FilterChanged.Raise(); app.RequestRedraw(); }
            if (DataTable.TabBtn(app, mx + pad + (chipW + gap) * 2, cy, chipW, chipH, "Starts", f.textMode == 3)) { f.textMode = 3; st.dirty = true; st.FilterChanged.Raise(); app.RequestRedraw(); }
            if (DataTable.TabBtn(app, mx + pad + (chipW + gap) * 3, cy, chipW, chipH, "Ends", f.textMode == 4)) { f.textMode = 4; st.dirty = true; st.FilterChanged.Raise(); app.RequestRedraw(); }
            cy = cy + chipH + app.Scale(8);

            int boxH = app.Scale(26);
            DataTable.EditBox(app, mx + pad, cy, menuW - pad * 2, boxH, f.textQuery, "Enter filter text...", st.editFocus == 2);
            int qId = app.focus.AllocId();
            app.hitTester.Register(HitRegion.Create(qId, mx + pad, cy, menuW - pad * 2, boxH, 0));
            if (app.EventKind() == 3 && app.hitTester.HitTest(app.mouseX, app.mouseY) == qId) { st.editFocus = 2; app.RequestRedraw(); }
            cy = cy + boxH + app.Scale(10);

            c.DrawText(mx + pad, cy, "Live-filters as you type", t.textTertiary, fs);
            cy = cy + Canvas.FontHeight(fs) + app.Scale(2);
            c.DrawText(mx + pad, cy, "(case-insensitive).", t.textTertiary, fs);
        } else if (st.filterTab == 3) {
            cy = DataTable.RenderRulesTab(app, mx, cy, menuW, pad, f, cols[mi], st);
        } else {
            c.DrawText(mx + pad, cy, "One condition per line:", t.textSecondary, fs);
            cy = cy + Canvas.FontHeight(fs) + app.Scale(4);
            int areaH = contentBottom - cy - app.Scale(66);
            if (areaH < app.Scale(48)) { areaH = app.Scale(48); }
            int aId = app.focus.AllocId();
            int abc = t.borderPrimary;
            if (st.editFocus == 3) { abc = t.borderFocus; }
            c.FillRoundRect(mx + pad, cy, menuW - pad * 2, areaH, t.borderRadiusSmall, t.bgPrimary);
            c.DrawRoundRect(mx + pad, cy, menuW - pad * 2, areaH, t.borderRadiusSmall, abc, 1);
            app.hitTester.Register(HitRegion.Create(aId, mx + pad, cy, menuW - pad * 2, areaH, 0));
            if (app.EventKind() == 3 && app.hitTester.HitTest(app.mouseX, app.mouseY) == aId) { st.editFocus = 3; app.RequestRedraw(); }
            int lh = Canvas.FontHeight(fs) + app.Scale(3);
            int li = 0;
            int ly = cy + app.Scale(4);
            while (li < st.batchLines.Count && ly + lh < cy + areaH) {
                string ln = DataTable.Truncate(st.batchLines[li], fs, menuW - pad * 2 - app.Scale(10));
                c.DrawText(mx + pad + app.Scale(5), ly, ln, t.textPrimary, fs);
                if (st.editFocus == 3 && li == st.batchLines.Count - 1) {
                    int cxp = mx + pad + app.Scale(5) + Canvas.MeasureText(ln, fs);
                    c.FillRect(cxp, ly, app.Scale(1), Canvas.FontHeight(fs), t.primary);
                }
                ly = ly + lh;
                li = li + 1;
            }
            cy = cy + areaH + app.Scale(6);

            int exId = app.focus.AllocId();
            bool exact = st.batchExactFlag == 1;
            DataTable.DrawMiniCheck(app, mx + pad, cy, app.Scale(22), exact);
            c.DrawText(mx + pad + app.Scale(22),
                       Canvas.CenterTextY(cy, app.Scale(22), fs),
                       "Exact match", t.textPrimary, fs);
            app.hitTester.Register(HitRegion.Create(exId, mx + pad, cy, app.Scale(130), app.Scale(22), 0));
            if (app.EventKind() == 3 && app.hitTester.HitTest(app.mouseX, app.mouseY) == exId) {
                if (st.batchExactFlag == 1) { st.batchExactFlag = 0; } else { st.batchExactFlag = 1; }
                app.RequestRedraw();
            }
            cy = cy + app.Scale(28);

            int bw = (menuW - pad * 2 - app.Scale(6)) / 2;
            int bh = app.Scale(26);
            bool keepClick = DataTable.TextBtn(app, mx + pad, cy, bw, bh, "Keep matching", true);
            bool exclClick = DataTable.TextBtn(app, mx + pad + bw + app.Scale(6), cy, bw, bh, "Exclude", false);
            if (keepClick || exclClick) {
                f.batchTerms.Clear();
                int bl = 0;
                while (bl < st.batchLines.Count) {
                    if (st.batchLines[bl].Length > 0) { f.batchTerms.Add(st.batchLines[bl]); }
                    bl = bl + 1;
                }
                f.batchExact = st.batchExactFlag == 1;
                f.batchKeep = keepClick;
                st.dirty = true;
                st.FilterChanged.Raise();
                app.RequestRedraw();
            }
        }

        // footer: Clear / Close
        int fy = my + menuH - footerH + app.Scale(6);
        int fbw = (menuW - pad * 2 - app.Scale(6)) / 2;
        int fbh = app.Scale(28);
        c.FillRect(mx + pad, my + menuH - footerH, menuW - pad * 2, 1, t.divider);
        bool clearClick = DataTable.TextBtn(app, mx + pad, fy, fbw, fbh, "Clear Filter", false);
        bool closeClick = DataTable.TextBtn(app, mx + pad + fbw + app.Scale(6), fy, fbw, fbh, "Close", false);
        if (clearClick) {
            st.filters[mi] = ColFilter.Create();
            st.searchText = "";
            st.batchLines = new List<string>();
            st.batchLines.Add("");
            st.batchExactFlag = 0;
            st.editFocus = 0;
            st.dirty = true;
            st.FilterChanged.Raise();
            app.RequestRedraw();
        }
        if (closeClick) { st.openMenu = -1; app.RequestRedraw(); }

        // click outside closes the menu (and blurs the edit field)
        if (app.EventKind() == 3) {
            bool inside = app.mouseX >= mx && app.mouseX < mx + menuW && app.mouseY >= my && app.mouseY < my + menuH;
            bool onIcon = app.mouseY >= y && app.mouseY < y + headerH;
            if (!inside && !onIcon) { st.openMenu = -1; app.RequestRedraw(); }
        }
    }

    static void DrawMiniCheck(App app, int bx, int cy, int itemH, bool checked) {
        Theme t = app.theme;
        int box = app.Scale(15);
        int level = 0;
        if (checked) { level = 1000; }
        Checkbox.PaintBox(app, bx, cy + (itemH - box) / 2, box, level,
                          t.primary, t.borderPrimary);
    }
}
