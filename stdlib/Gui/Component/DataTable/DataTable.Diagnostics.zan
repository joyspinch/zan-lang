using System;

namespace Gui.Component.DataTable;

/// DataTable 的非致命结构诊断。诊断不改变旧 API 的返回值，
/// 供宿主在开发/遥测模式下显示重复键、过期结果和能力不匹配。
class TableDiagnostic {
    int code;
    string message;
    string field;
    int row;

    TableDiagnostic(int c, string msg, string f, int r) {
        this.code = c;
        this.message = msg;
        this.field = f;
        this.row = r;
    }

    int Code() { return this.code; }
    string Message() { return this.message; }
    string Field() { return this.field; }
    int Row() { return this.row; }
}

partial class DataTable {
    /// 诊断代码：0 无，1 重复键，2 缺少稳定键，3 过期结果，
    /// 4 schema 不匹配，5 查询能力不支持。
    static TableDiagnostic DuplicateKeyDiagnostic(string key, int row) {
        return new TableDiagnostic(1, "Duplicate DataTable row key: " + key, "", row);
    }

    static TableDiagnostic MissingKeyDiagnostic(int row) {
        return new TableDiagnostic(2, "DataTable row has no stable key; using a temporary key", "", row);
    }

    static TableDiagnostic StaleResultDiagnostic(int generation) {
        return new TableDiagnostic(3, "DataTable query result is stale", "", generation);
    }

    static TableDiagnostic SchemaDiagnostic(string field, string message) {
        return new TableDiagnostic(4, message, field, -1);
    }
}
