using System;
using Gui;

namespace Gui.Component.DataTable;

/// DataTable 分部：行生命周期——状态初始化、插入/追加/删除、
/// 焦点与撤销日志。
partial class DataTable {
    // ---------- 状态维护 ----------

    /// 补齐所有按列对齐的状态列表。列可以在网格首帧之后
    /// 动态增加；因此不能只补 selected/hidden/freeze，
    /// 否则筛选、宽度、聚合或条件格式会访问过短列表。
    static void EnsureColumnSlots(DataTableState st, List<DataColumn> cols) {
        int i = st.colWidths.Count;
        while (i < cols.Count) {
            st.colWidths.Add(cols[i].width);
            if (cols[i].summary > 0) { st.showSummary = true; }
            i = i + 1;
        }
        while (st.filters.Count < cols.Count) { st.filters.Add(new ColFilter()); }
        int a = st.aggMode.Count;
        while (a < cols.Count) {
            st.aggMode.Add(cols[a].summary);
            a = a + 1;
        }
        while (st.summaryText.Count < cols.Count) { st.summaryText.Add(""); }
        while (st.aggValue.Count < cols.Count) { st.aggValue.Add(0); }
        while (st.aggReal.Count < cols.Count) { st.aggReal.Add(0.0); }
        while (st.aggSumR.Count < cols.Count) { st.aggSumR.Add(0.0); }
        while (st.aggMinR.Count < cols.Count) { st.aggMinR.Add(0.0); }
        while (st.aggMaxR.Count < cols.Count) { st.aggMaxR.Add(0.0); }
        while (st.cfMin.Count < cols.Count) { st.cfMin.Add(0); }
        while (st.cfMax.Count < cols.Count) { st.cfMax.Add(0); }
        while (st.cfMinR.Count < cols.Count) { st.cfMinR.Add(0.0); }
        while (st.cfMaxR.Count < cols.Count) { st.cfMaxR.Add(0.0); }
        while (st.colHidden.Count < cols.Count) { st.colHidden.Add(false); }
        int fz = st.colFreeze.Count;
        while (fz < cols.Count) {
            st.colFreeze.Add(cols[fz].freeze);
            fz = fz + 1;
        }
        while (st.filterRowText.Count < cols.Count) { st.filterRowText.Add(""); }
        // colOrder 中每列只出现一次；追加尚未列出的列。
        for (int co = 0; co < cols.Count; co = co + 1) {
            if (st.colOrder.IndexOf(co) < 0) { st.colOrder.Add(co); }
        }
    }

    static void EnsureInit(DataTableState st, List<DataColumn> cols, DataSource src) {
        if (!st.inited) {
            int nrows = src.RowCount();
            int i = 0;
            while (i < nrows) {
                st.selected.Add(false);
                i = i + 1;
            }
            st.inited = true;
            st.dirty = true;
        }
        bool colsChanged = st.columnCount != cols.Count;
        DataTable.EnsureColumnSlots(st, cols);
        if (colsChanged) {
            st.columnCount = cols.Count;
            // 首次建表只建立初始快照；后续 schema 变化会使查询
            // 结果失效，不能依赖下一次偶然重绘。
            if (st.columnCount >= 0 && st.inited && st.rowKeysRevision >= 0) {
                DataTable.InvalidateQuery(st);
            } else {
                st.dirty = true;
            }
        }
        while (st.selected.Count < src.RowCount()) { st.selected.Add(false); }
        // 新绑定或外部刷新后，键快照必须与当前源重新对齐。
        if (st.rowKeys.Count != src.RowCount()) {
            DataTable.InvalidateData(st);
            DataTable.RebuildRowKeys(st, src);
            DataTable.PruneExpandedKeys(st, src);
        } else if (st.rowKeysRevision != st.dataRevision) {
            DataTable.RebuildRowKeys(st, src);
            DataTable.PruneExpandedKeys(st, src);
        }
        // 稳定键源：把旧 bool 选择投影进 SelectionModel（首次），
        // 之后反向投影回来——同 key 重排/过滤不丢选择。
        DataTable.SyncSelectionModel(st, src);
    }

    // ---------- 行添加/删除 + 撤销 ----------

    /// 源行插入/删除会改变后续的兼容索引；在 RowKey
    /// 完成迁移前，至少保持旧 expandedRows 的索引语义一致。
    static void ShiftExpandedOnInsert(DataTableState st, int at) {
        for (int i = 0; i < st.expandedRows.Count; i = i + 1) {
            if (st.expandedRows[i] >= at) { st.expandedRows[i] = st.expandedRows[i] + 1; }
        }
    }

    static void ShiftExpandedOnDelete(DataTableState st, int at) {
        int i = 0;
        while (i < st.expandedRows.Count) {
            int row = st.expandedRows[i];
            if (row == at) { st.expandedRows.RemoveAt(i); }
            else {
                if (row > at) { st.expandedRows[i] = row - 1; }
                i = i + 1;
            }
        }
    }

    /// 将可逆更改压入日志；达到上限时丢弃最旧的条目
    /// 。撤销本身产生的写入不会被记录——
    /// 否则撤销会立刻变成自己的重做。
    static void Journal(DataTableState st, RowEdit e) {
        if (st.undoing) { return; }
        e.group = st.undoGroup;
        st.undoLog.Add(e);
        while (st.undoLog.Count > st.undoLimit && st.undoLog.Count > 0) {
            st.undoLog.RemoveAt(0);
        }
    }

    /// 开始一次复合更改：到 EndUndoGroup 为止记录的所有内容
    /// 在单次撤销中一起回退。用于粘贴、范围内删除和
    /// 删除选中行等一次操作涉及多单元格/多行的情况。
    static void BeginUndoGroup(DataTableState st) {
        st.undoGroupSeq = st.undoGroupSeq + 1;
        st.undoGroup = st.undoGroupSeq;
    }

    static void EndUndoGroup(DataTableState st) { st.undoGroup = 0; }

    /// 日志还能承受的 Ctrl+Z 次数。分组条目
    /// 只计一次，因为它们会一起回退。
    static int UndoDepth(DataTableState st) {
        int n = 0;
        int lastG = 0;
        for (int i = 0; i < st.undoLog.Count; i = i + 1) {
            int g = st.undoLog[i].group;
            if (g == 0 || g != lastG) { n = n + 1; }
            lastG = g;
        }
        return n;
    }

    /// 清空日志（例如保存后）。
    static void ClearUndo(DataTableState st) { st.undoLog.Clear(); }

    /// 在数据索引 `at` 处插入空行并选中它。返回新行的索引，
    /// 源拒绝时返回 -1。
    ///
    /// `st.selected` 以数据行为索引，因此插入点及其后的
    /// 所有标记都要随之后移——否则新行会继承
    /// 原来在该索引上的行的选中状态。
    static int InsertRow(DataTableState st, List<DataColumn> cols, DataSource src, int at) {
        if (!src.CanInsert()) { return -1; }
        int n = src.RowCount();
        if (at < 0) { at = 0; }
        if (at > n) { at = n; }
        if (!src.InsertRow(at)) { return -1; }

        DataTable.ShiftExpandedOnInsert(st, at);
        while (st.selected.Count < at) { st.selected.Add(false); }
        st.selected.Insert(at, false);
        DataTable.InvalidateData(st);

        // 新行初始为空，但 bool 列没有空白：给它
        // 该列自身的 false 文本，使其读回为有效值。
        for (int c = 0; c < cols.Count; c = c + 1) {
            if (cols[c].isBool) { src.SetCell(at, c, cols[c].boolFalse); }
        }

        DataTable.Journal(st, RowEdit.Insert(at));
        st.lastAddedRow = at;
        st.hitRow = at;
        st.dirty = true;
        st.RowInserted.Raise();
        return at;
    }

    /// 在最后一行之后追加空行。
    static int AppendRow(DataTableState st, List<DataColumn> cols, DataSource src) {
        return DataTable.InsertRow(st, cols, src, src.RowCount());
    }

    /// 快照一行的所有单元格，使删除在源
    /// 忘记该行后仍可撤销。
    static List<string> RowCells(DataSource src, List<DataColumn> cols, int row) {
        List<string> out2 = new List<string>();
        for (int c = 0; c < cols.Count; c = c + 1) {
            out2.Add(src.CellText(row, c));
        }
        return out2;
    }

    /// 删除数据索引 `at` 处的行。成功删除时返回 true。
    static bool DeleteRow(DataTableState st, List<DataColumn> cols, DataSource src, int at) {
        if (!src.CanInsert()) { return false; }
        if (at < 0 || at >= src.RowCount()) { return false; }

        // 在源丢弃行之前快照——RemoveRow 之后单元格
        // 已不存在，这是让删除可撤销的唯一机会。
        List<string> cells = DataTable.RowCells(src, cols, at);
        RowKey deletedKey = DataTable.RowKeyAt(st, src, at);
        if (!src.RemoveRow(at)) { return false; }

        // 已删除的业务键从选择模型中移除；全选模式不新增排除项
        // （删除的行不应在未来同键行上复活为排除状态）。
        if (deletedKey != null && st.selectionModel != null) {
            st.selectionModel.ForgetKey(deletedKey.Canonical());
        }
        DataTable.ShiftExpandedOnDelete(st, at);
        if (at < st.selected.Count) { st.selected.RemoveAt(at); }
        DataTable.InvalidateData(st);

        // 被删行上打开的编辑器现在指向已不存在的行
        // （更糟的是指向后继行）；将其关闭，而不是让
        // 提交写入错误的位置。
        if (st.editing && st.editRow == at) { DataTable.CancelEdit(st); }
        else if (st.editing && st.editRow > at) { st.editRow = st.editRow - 1; }

        if (st.lastAddedRow == at) { st.lastAddedRow = -1; }
        else if (st.lastAddedRow > at) { st.lastAddedRow = st.lastAddedRow - 1; }

        DataTable.Journal(st, RowEdit.Delete(at, cells));
        st.hitRow = at;
        st.dirty = true;
        st.RowDeleted.Raise();
        return true;
    }

    /// 删除所有选中的行。返回删除的数量。
    ///
    /// 行从后往前删除：从前删会重新编号
    /// 尚未删除的行，导致每次删错对象。
    static int DeleteSelectedRows(DataTableState st, List<DataColumn> cols, DataSource src) {
        DataTable.BeginUndoGroup(st);
        int gone = 0;
        int i = src.RowCount() - 1;
        while (i >= 0) {
            if (i < st.selected.Count && DataTable.IsSelected(st, src, i)) {
                if (DataTable.DeleteRow(st, cols, src, i)) { gone = gone + 1; }
            }
            i = i - 1;
        }
        DataTable.EndUndoGroup(st);
        return gone;
    }

    /// 显示数据行 `row` 的槽位；没有时为 -1——该行
    /// 被过滤掉，或位于折叠的分组内。数据行索引
    /// 不是槽位索引，因此所有滚动或停靠光标的地方都必须
    /// 经过这里。
    static int SlotOfRow(DataTableState st, int row) {
        for (int i = 0; i < DataTable.DispCount(st); i = i + 1) {
            if (DataTable.DispKind(st, i) == 0 && DataTable.DispRowOf(st, i) == row) { return i; }
        }
        return -1;
    }

    /// 将单元格光标停靠在 `row` 上并打开其第一个可编辑列，
    /// 这样新添加的行无需二次点击即可使用。
    /// 当行当前未显示时不执行任何操作。
    static void FocusRow(DataTableState st, List<DataColumn> cols, DataSource src, int row) {
        int slot = DataTable.SlotOfRow(st, row);
        if (slot < 0) { return; }
        st.hitOrder = slot;
        st.hitRow = row;
        DataTable.ClearRange(st);
        for (int c = 0; c < cols.Count; c = c + 1) {
            // 隐藏列无法被编辑：跳过它，而不是
            // 打开用户看不到的编辑器。
            if (cols[c].editable && !cols[c].isBool
                && (c >= st.colHidden.Count || !st.colHidden[c])) {
                st.hitCol = c;
                DataTable.BeginEdit(st, cols, src, row, c);
                return;
            }
        }
    }

    /// 回退最近一次记录的更改；有回退时返回 true
    /// 。
    static bool Undo(DataTableState st, List<DataColumn> cols, DataSource src) {
        if (st.undoLog.Count == 0) { return false; }

        // 以下所有写入都走相同的公开操作，
        // 这些操作会自我记录，导致撤销永远可撤销；
        // 此标志在此过程中抑制该行为。
        st.undoing = true;

        // 弹出末尾条目；若它属于某个分组，则连同
        // 该组的所有条目一起弹出——从最新开始，每次回退都作用于
        // 前一次回退留下的行索引上。
        int grp = st.undoLog[st.undoLog.Count - 1].group;
        bool more = true;
        while (more && st.undoLog.Count > 0) {
            RowEdit e = st.undoLog[st.undoLog.Count - 1];
            st.undoLog.RemoveAt(st.undoLog.Count - 1);
            DataTable.UndoOne(st, cols, src, e);
            more = grp != 0 && st.undoLog.Count > 0
                   && st.undoLog[st.undoLog.Count - 1].group == grp;
        }

        st.undoing = false;
        st.dirty = true;
        return true;
    }

    /// 回退一条日志条目。假定 st.undoing 已设置。
    static void UndoOne(DataTableState st, List<DataColumn> cols, DataSource src, RowEdit e) {
        if (e.kind == 0) {
            if (e.row >= 0 && e.row < src.RowCount() && e.col >= 0 && e.col < cols.Count) {
                src.SetCell(e.row, e.col, e.before);
                st.hitRow = e.row;
                st.hitCol = e.col;
            }
        } else if (e.kind == 1) {
            // 撤销插入 = 再次删除
            DataTable.DeleteRow(st, cols, src, e.row);
        } else if (e.kind == 2) {
            // 撤销删除 = 逐单元格恢复该行
            int at = DataTable.InsertRow(st, cols, src, e.row);
            if (at >= 0) {
                for (int c = 0; c < cols.Count && c < e.cells.Count; c = c + 1) {
                    src.SetCell(at, c, e.cells[c]);
                }
            }
        }
    }

}
