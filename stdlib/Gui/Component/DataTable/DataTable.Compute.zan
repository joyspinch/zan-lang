using System;
using Gui;

namespace Gui.Component.DataTable;

/// DataTable 模块：派生显示——Top-N/集合过滤、行
/// 分组、主从详情展开、可见显示列表、页脚
/// 汇总与列统计。
partial class DataTable {
    // ---- Top-N / 高于平均值集合过滤 ----

    /// 从 `order` 中剔除某列筛选的集合相对阶段
    /// 排除的每一行。与逐单元格阶段不同，它需要整个幸存
    /// 集合，因此在行扫描后运行。
    static void ApplySetPass(DataTableState st, List<DataColumn> cols, DataSource src, int c) {
        ColFilter f = st.filters[c];
        int mode = f.topMode;
        if (mode == 0 || st.order.Count == 0) { return; }
        DataColumn col = cols[c];

        if (mode == 5 || mode == 6) {
            // 高于 / 低于幸存行平均值
            double sum = 0.0;
            for (int i = 0; i < st.order.Count; i = i + 1) {
                sum = sum + src.CellReal(st.order[i], c);
            }
            double avg = sum / (double)st.order.Count;
            List<int> kept = new List<int>();
            for (int k = 0; k < st.order.Count; k = k + 1) {
                double v = src.CellReal(st.order[k], c);
                bool ok = v > avg;
                if (mode == 6) { ok = v < avg; }
                if (ok) { kept.Add(st.order[k]); }
            }
            st.order = kept;
            return;
        }

        // 前/后 N 个（或 N%）：按值排名后保留前段。
        int n = f.topN;
        if (mode == 3 || mode == 4) { n = st.order.Count * f.topN / 100; }
        if (n < 1) { n = 1; }
        if (n >= st.order.Count) { return; }

        // 对幸存行的副本按值排序；原顺序通过
        // 用保留集合过滤 st.order 恢复，
        // 用户的排序不会被筛选打乱。
        List<int> byVal = new List<int>();
        for (int b = 0; b < st.order.Count; b = b + 1) { byVal.Add(st.order[b]); }
        bool desc = (mode == 1 || mode == 3);
        DataTable.SortRowsByReal(byVal, src, c, desc);

        // 截断线上的并列值保留所有并列行，如同排行榜
        // 显示并列名次而非在并列处截断。
        double cut = src.CellReal(byVal[n - 1], c);
        List<int> keep = new List<int>();
        for (int m = 0; m < st.order.Count; m = m + 1) {
            double v = src.CellReal(st.order[m], c);
            bool ok = v <= cut;
            if (desc) { ok = v >= cut; }
            if (ok) { keep.Add(st.order[m]); }
        }
        st.order = keep;
    }

    static void SortRowsByReal(List<int> rows, DataSource src, int col, bool desc) {
        // 插入排序：集合阶段只对通过
        // 单元格筛选的行排序，而实际 Top-N 场景中 N 都很小。
        int i = 1;
        while (i < rows.Count) {
            int r = rows[i];
            double v = src.CellReal(r, col);
            int j = i - 1;
            bool moving = true;
            while (j >= 0 && moving) {
                double w = src.CellReal(rows[j], col);
                bool swap = w > v;
                if (desc) { swap = w < v; }
                if (swap) {
                    rows[j + 1] = rows[j];
                    j = j - 1;
                } else {
                    moving = false;
                }
            }
            rows[j + 1] = r;
            i = i + 1;
        }
    }

    static void Recompute(DataTableState st, List<DataColumn> cols, DataSource src) {
        if (!st.dirty) { return; }
        st.order.Clear();
        int nrows = src.RowCount();

        // 收集确有活动筛选的列（通常没有）。
        // 常见的无筛选情况因此完全跳过 O(rows * cols) 谓词扫描，
        // 对百万行未筛选数据重排序时收益显著。
        List<int> af = new List<int>();
        List<int> sf = new List<int>();
        bool anyPreset = false;
        for (int fc = 0; fc < cols.Count; fc = fc + 1) {
            if (st.filters[fc].Active()) { af.Add(fc); }
            if (st.filters[fc].NeedsSetPass()) { sf.Add(fc); }
            if (st.filters[fc].datePreset != 0) { anyPreset = true; }
        }
        // 服务端控制的源自己掌握顺序和筛选集合：
        // 它给出的行已在服务端排序/筛选，本地
        // 筛选阶段（逐列、Top-N、筛选行）和本地排序不能
        // 作用于部分前缀——那会把数据的
        // 一部分当作全集排名。
        bool server = src.ServerControlled();
        if (server) { af.Clear(); sf.Clear(); }

        // 仅在用到相对预设时读取时钟，
        // 没有日期规则的网格不论日期如何都得到相同结果。
        int today = 0;
        if (anyPreset) { today = DataTable.Today(); }
        int i = 0;
        if (af.Count == 0) {
            while (i < nrows) { st.order.Add(i); i = i + 1; }
        } else {
            while (i < nrows) {
                if (DataTable.RowPassesActive(st, cols, src, af, i, today)) { st.order.Add(i); }
                i = i + 1;
            }
        }
        // Top-N / 高于平均值阶段需要幸存集合，因此
        // 在逐单元格扫描完成后运行一次。
        for (int si = 0; si < sf.Count; si = si + 1) {
            DataTable.ApplySetPass(st, cols, src, sf[si]);
        }
        if (st.groupCols.Count > 0 && !server) {
            DataTable.SortOrderGrouped(st, cols, src);
        } else if (st.sortKeys.Count == 1 && !server) {
            // 快路径：对单个键做装饰排序（sortCol 镜像 sortKeys[0]）
            DataTable.SortOrder(st, cols, src);
        } else if (st.sortKeys.Count > 1 && !server) {
            DataTable.SortOrderMulti(st, cols, src);
        }
        // 在 ColFilter 结果之上二次应用筛选行快速筛选。
        // 使其与弹出筛选正交，两者可以共存。
        if (st.showFilterRow && !server) {
            bool frAny = false;
            for (int fri = 0; fri < st.filterRowText.Count; fri = fri + 1) {
                if (st.filterRowText[fri].Length > 0) { frAny = true; }
            }
            if (frAny) {
                List<int> kept = new List<int>();
                for (int fro = 0; fro < st.order.Count; fro = fro + 1) {
                    if (DataTable.RowPassesFilterRow(st, src, st.order[fro])) { kept.Add(st.order[fro]); }
                }
                st.order = kept;
            }
        }
        DataTable.ComputeColStats(st, cols, src);
        // BuildDisplay 在页脚之前运行，分组表可复用其
        // 产生的每组聚合：总计再由
        // 组小计折叠（一次聚合），而无需重扫每一
        // 行。无分组表没有组，仍走直接扫描。
        DataTable.BuildDisplay(st, cols, src);
        if (st.showSummary) {
            if (st.groupCols.Count > 0) {
                DataTable.ComputeSummaryFromGroups(st, cols);
            } else {
                DataTable.ComputeSummary(st, cols, src);
            }
        }
        int maxScroll = DataTable.DispCount(st) - 1;
        if (st.scrollRow > maxScroll) { st.scrollRow = maxScroll; }
        if (st.scrollRow < 0) { st.scrollRow = 0; }
        st.dirty = false;
    }

    // summary==6 列的派生聚合，由其他列
    // 已聚合的值计算——O(1)，不扫描行。
    static int DeriveValue(DataColumn col, List<int> agg) {
        int a = 0;
        int b = 0;
        if (col.deriveA >= 0 && col.deriveA < agg.Count) { a = agg[col.deriveA]; }
        if (col.deriveB >= 0 && col.deriveB < agg.Count) { b = agg[col.deriveB]; }
        int op = col.deriveOp;
        if (op == 0) { if (b != 0) { return a * 100 / b; } return 0; }
        if (op == 1) { if (b != 0) { return a / b; } return 0; }
        if (op == 2) { return a - b; }
        if (op == 3) { return a + b; }
        if (op == 4) { return a * b; }
        return a;
    }

    // DeriveValue 的小数版：百分比和比率保留小数，
    // 而非截断为整数。
    static double DeriveReal(DataColumn col, List<double> agg) {
        double a = 0.0;
        double b = 0.0;
        if (col.deriveA >= 0 && col.deriveA < agg.Count) { a = agg[col.deriveA]; }
        if (col.deriveB >= 0 && col.deriveB < agg.Count) { b = agg[col.deriveB]; }
        int op = col.deriveOp;
        if (op == 0) { if (b != 0.0) { return a * 100.0 / b; } return 0.0; }
        if (op == 1) { if (b != 0.0) { return a / b; } return 0.0; }
        if (op == 2) { return a - b; }
        if (op == 3) { return a + b; }
        if (op == 4) { return a * b; }
        return a;
    }

    // ---------- 行分组 ----------
    static bool IsGrouped(DataTableState st) { return st.groupCols.Count > 0; }
    static int GroupCount(DataTableState st) { return st.groupCols.Count; }

    static void CollapseAll(DataTableState st) {
        foreach (GroupRow g in st.groups) {
            if (st.collapsedKeys.IndexOf(g.key) < 0) { st.collapsedKeys.Add(g.key); }
        }
        st.dirty = true;
    }

    static void ExpandAll(DataTableState st) {
        st.collapsedKeys.Clear();
        st.dirty = true;
    }

    static void GroupBy(DataTableState st, int col) {
        if (col < 0) { return; }
        if (st.groupCols.IndexOf(col) >= 0) { return; }
        st.groupCols.Add(col);
        st.dirty = true;
    }

    static void Ungroup(DataTableState st) {
        st.groupCols.Clear();
        st.collapsedKeys.Clear();
        st.dirty = true;
    }

    /// 从分组中移除一列，其余保持顺序。供
    /// 分组面板的逐芯片移除按钮使用，`Ungroup` 的全清
    /// 过于粗暴。
    static void UngroupOne(DataTableState st, int col) {
        int i = st.groupCols.IndexOf(col);
        if (i < 0) { return; }
        st.groupCols.RemoveAt(i);
        // 分组键由完整路径构成，针对旧嵌套记录的
        // 折叠状态不再指向任何分组：直接丢弃，
        // 而不是留下永远无法匹配的键。
        st.collapsedKeys.Clear();
        st.dirty = true;
    }

    /// 把已分组的列移到新的嵌套深度。`to` 是外层到内层列表中的
    /// 目标索引；越界值钳制到两端，
    /// 拖过任一边缘都会得到合理结果而非无响应。
    static void MoveGroup(DataTableState st, int col, int to) {
        int fi = st.groupCols.IndexOf(col);
        if (fi < 0) { return; }
        int dst = to;
        if (dst < 0) { dst = 0; }
        if (dst > st.groupCols.Count - 1) { dst = st.groupCols.Count - 1; }
        if (dst == fi) { return; }
        st.groupCols.RemoveAt(fi);
        st.groupCols.Insert(dst, col);
        st.collapsedKeys.Clear();
        st.dirty = true;
    }

    /// 分组列的嵌套深度（0 = 最外层）；列未分组时返回 -1。
    /// 列未分组时返回 -1。
    static int GroupDepth(DataTableState st, int col) {
        return st.groupCols.IndexOf(col);
    }

    /// 把列插入分组中的指定深度，而非像 `GroupBy` 那样
    /// 追加到最内层。供面板的按位置放置
    /// 手势使用；已分组的列被移动而非复制。
    static void GroupByAt(DataTableState st, int col, int at) {
        if (col < 0) { return; }
        if (st.groupCols.IndexOf(col) >= 0) { DataTable.MoveGroup(st, col, at); return; }
        int dst = at;
        if (dst < 0) { dst = 0; }
        if (dst > st.groupCols.Count) { dst = st.groupCols.Count; }
        st.groupCols.Insert(dst, col);
        st.collapsedKeys.Clear();
        st.dirty = true;
    }

    static bool IsCollapsed(DataTableState st, string key) {
        return st.collapsedKeys.IndexOf(key) >= 0;
    }

    static void ToggleCollapse(DataTableState st, string key) {
        int idx = st.collapsedKeys.IndexOf(key);
        if (idx >= 0) { st.collapsedKeys.RemoveAt(idx); }
        else { st.collapsedKeys.Add(key); }
        st.dirty = true;
    }

    // ---------- 主从详情 ----------
    // 行可在其下方展开面板：子表、表单或图表。
    // 展开状态按*源*行索引跟踪，行在排序和筛选后
    // 仍跟随该行，而非固定在显示位置。

    /// 挂接绘制详情面板的钩子以启用该功能。传入
    /// null 可关闭（所有行折叠；其余状态不受影响）。
    static void SetDetail(DataTableState st, DetailProvider p) {
        st.detail = p;
        if (p == null) { st.expandedRows.Clear(); }
        st.dirty = true;
    }

    /// 主从详情是否处于启用状态。
    static bool HasDetail(DataTableState st) { return st.detail != null; }

    /// 详情 band 的高度，以整行高计，至少 1。向
    /// provider 询问使每行不同大小（如每条子记录一个槽位）成为可能。
    static int DetailSlots(DataTableState st, DataSource src, int row) {
        if (st.detail == null) { return 0; }
        int n = st.detail.Slots(src, row);
        if (n < 1) { n = 1; }
        return n;
    }

    /// `row`（源索引）当前是否已展开。
    static bool IsExpanded(DataTableState st, int row) {
        return st.expandedRows.IndexOf(row) >= 0;
    }

    /// `row` 是否提供详情面板——功能关闭或
    /// provider 拒绝该行时返回 false，此时不绘制箭头。
    static bool CanExpand(DataTableState st, DataSource src, int row) {
        if (st.detail == null) { return false; }
        if (row < 0 || row >= src.RowCount()) { return false; }
        return st.detail.CanExpand(src, row);
    }

    /// 打开 `row` 的详情面板。provider 拒绝的行或已打开的
    /// 行保持不变。
    static void ExpandRow(DataTableState st, DataSource src, int row) {
        if (!DataTable.CanExpand(st, src, row)) { return; }
        if (st.expandedRows.IndexOf(row) >= 0) { return; }
        st.expandedRows.Add(row);
        st.dirty = true;
    }

    /// 关闭 `row` 的详情面板。未打开的行保持不变。
    static void CollapseRow(DataTableState st, int row) {
        int i = st.expandedRows.IndexOf(row);
        if (i < 0) { return; }
        st.expandedRows.RemoveAt(i);
        st.dirty = true;
    }

    /// 切换 `row` 详情面板的展开与收起。
    static void ToggleDetail(DataTableState st, DataSource src, int row) {
        if (DataTable.IsExpanded(st, row)) { DataTable.CollapseRow(st, row); }
        else { DataTable.ExpandRow(st, src, row); }
    }

    /// 关闭所有已展开的详情面板。
    static void CollapseAllDetail(DataTableState st) {
        if (st.expandedRows.Count == 0) { return; }
        st.expandedRows.Clear();
        st.dirty = true;
    }

    /// 当前有多少行的详情面板处于展开状态。
    static int ExpandedCount(DataTableState st) { return st.expandedRows.Count; }

    // 数据行 `rowIdx` 在嵌套层级
    // `level` 所属分组的路由键——到该层为止各分组列值的拼接，
    // 用控制分隔符连接，避免不同路径冲突。
    static string PathKey(DataTableState st, List<DataColumn> cols, DataSource src,
                          int rowIdx, int level) {
        string sep = Text.ByteChar(31);
        string k = "";
        for (int g = 0; g <= level && g < st.groupCols.Count; g = g + 1) {
            k = k + DataTable.GroupValue(cols, src, rowIdx, st.groupCols[g]) + sep;
        }
        return k;
    }

    // 行在列 `gc` 上对其分组贡献的值。日期列
    // 折叠为分桶标签（年 / 月 / 季度 / 星期），
    // 按日期分组不会每天生成一个组。
    static string GroupValue(List<DataColumn> cols, DataSource src, int rowIdx, int gc) {
        if (gc >= 0 && gc < cols.Count) {
            DataColumn c = cols[gc];
            if (c.isDate) {
                return DataTable.DateGroupKey(src.CellDay(rowIdx, gc, c.dateOrder), c.dateGroup);
            }
            // 只有两个桶，无论单元格怎么写。
            if (c.isBool) {
                if (src.CellBool(rowIdx, gc)) { return c.boolTrue; }
                return c.boolFalse;
            }
        }
        return src.CellText(rowIdx, gc);
    }

    // 先按分组列（外层→内层）比较两行，再按
    // 活动排序列作决胜键，同组行保持相邻。
    static int CmpGroupRow(DataTableState st, List<DataColumn> cols, DataSource src, int ra, int rb) {
        for (int g = 0; g < st.groupCols.Count; g = g + 1) {
            int gc = st.groupCols[g];
            // 每个分组列只计算一次比较。有效的
            // 列分支完全决定 `cmp`；只有越界的
            // 分组列才回退到普通字符串比较。
            int cmp = 0;
            if (gc >= 0 && gc < cols.Count) {
                DataColumn gcol = cols[gc];
                if (gcol.isDate) {
                    // 按桶而非原始日期排序：按星期分组
                    // 必须把所有周一聚在一起，按日号排序会
                    // 打散它们。同一桶内仍用原始日期
                    // 打破并列，行保持时间顺序。
                    cmp = DataTable.CmpDateGroup(gcol,
                                                 src.CellDay(ra, gc, gcol.dateOrder),
                                                 src.CellDay(rb, gc, gcol.dateOrder));
                } else {
                    cmp = DataTable.CompareCellCol(gcol, src.CellText(ra, gc), src.CellText(rb, gc));
                }
            } else {
                cmp = DataTable.CompareStr(src.CellText(ra, gc), src.CellText(rb, gc));
            }
            if (cmp != 0) { return cmp; }
        }
        return DataTable.CmpMultiKey(st, cols, src, ra, rb);
    }

    // 按分组桶比较两个日期单元格，回退到原始日期，
    // 使桶内行保持时间顺序。星期桶（模式 4）
    // 按周日..周六而非日期排列。
    static int CmpDateGroup(DataColumn col, int da, int db) {
        int ka = da;
        int kb = db;
        if (col.dateGroup == 4) {
            ka = DataTable.WeekdayOf(da);
            kb = DataTable.WeekdayOf(db);
        }
        if (ka < kb) { return -1; }
        if (ka > kb) { return 1; }
        if (da < db) { return -1; }
        if (da > db) { return 1; }
        return 0;
    }

    // 日号对应的星期几（0=周日）；空白排在最前。
    static int WeekdayOf(int days) {
        if (days == DataTable.NoDate()) { return -1; }
        return DateTime.FloorMod(days + 4, 7);
    }

    static void MergeGrp(DataTableState st, List<DataColumn> cols, DataSource src,
                         int lo, int mid, int hi, List<int> tmp) {
        int i = lo;
        int j = mid;
        int k = lo;
        while (i < mid && j < hi) {
            if (DataTable.CmpGroupRow(st, cols, src, st.order[i], st.order[j]) <= 0) {
                tmp[k] = st.order[i]; i = i + 1;
            } else {
                tmp[k] = st.order[j]; j = j + 1;
            }
            k = k + 1;
        }
        while (i < mid) { tmp[k] = st.order[i]; i = i + 1; k = k + 1; }
        while (j < hi) { tmp[k] = st.order[j]; j = j + 1; k = k + 1; }
        int p = lo;
        while (p < hi) { st.order[p] = tmp[p]; p = p + 1; }
    }

    // 按单个分组列比较两个代表行，与
    // CmpGroupRow 的逐列排序一致（先日期桶，再按列类型取值）。
    static int CmpGroupCol(DataColumn gcol, DataSource src, int ra, int rb, int kd, int col) {
        if (kd == 3) {
            return DataTable.CmpDateGroup(gcol,
                                          src.CellDay(ra, col, gcol.dateOrder),
                                          src.CellDay(rb, col, gcol.dateOrder));
        }
        return DataTable.CompareCellCol(gcol, src.CellText(ra, col), src.CellText(rb, col));
    }

    // 单分组列且无活动组内排序这一常见情况的 O(N) 分组排序：
    // 不用 O(N log N) 比较归并排序，而是
    // 单遍为每行分配小组槽位（用类型化哈希——数值列
    // 不用字符串键），按组顺序给少量不同槽位排名，
    // 再用稳定计数排序把行放入连续
    // 分组，省去对百万行约 20 趟归并扫描。
    static void SortOrderGroupBucket(DataTableState st, List<DataColumn> cols, DataSource src) {
        int n = st.order.Count;
        int col = st.groupCols[0];
        int kd = 0;                 // 0 文本/小数，1 整数，2 布尔，3 日期桶
        DataColumn gcol = cols[0];
        if (col >= 0 && col < cols.Count) {
            gcol = cols[col];
            if (gcol.isDate) { kd = 3; }
            else if (gcol.isBool) { kd = 2; }
            else if (gcol.numeric && gcol.decimals == 0) { kd = 1; }
        }

        List<int> rowSlot = new List<int>();
        for (int z = 0; z < n; z = z + 1) { rowSlot.Add(0); }
        List<int> repRow = new List<int>();

        if (kd == 1 || kd == 2) {
            Dictionary<int,int> di = new Dictionary<int,int>();
            for (int p = 0; p < n; p = p + 1) {
                int row = st.order[p];
                int v = 0;
                if (kd == 2) { if (src.CellBool(row, col)) { v = 1; } }
                else { v = src.CellNum(row, col); }
                int slot = 0;
                if (di.ContainsKey(v)) { slot = di[v]; }
                else { slot = repRow.Count; di[v] = slot; repRow.Add(row); }
                rowSlot[p] = slot;
            }
        } else {
            Dictionary<string,int> ds = new Dictionary<string,int>();
            for (int p = 0; p < n; p = p + 1) {
                int row = st.order[p];
                string v = "";
                if (kd == 3) { v = DataTable.DateGroupKey(src.CellDay(row, col, gcol.dateOrder), gcol.dateGroup); }
                else { v = src.CellText(row, col); }
                int slot = 0;
                if (ds.ContainsKey(v)) { slot = ds[v]; }
                else { slot = repRow.Count; ds[v] = slot; repRow.Add(row); }
                rowSlot[p] = slot;
            }
        }

        int K = repRow.Count;
        // 给（少量）不同槽位按组顺序排名；插入排序即可。
        List<int> slotOrder = new List<int>();
        for (int s = 0; s < K; s = s + 1) { slotOrder.Add(s); }
        int a = 1;
        while (a < K) {
            int cur = slotOrder[a];
            int b = a - 1;
            while (b >= 0 && DataTable.CmpGroupCol(gcol, src, repRow[slotOrder[b]], repRow[cur], kd, col) > 0) {
                slotOrder[b + 1] = slotOrder[b];
                b = b - 1;
            }
            slotOrder[b + 1] = cur;
            a = a + 1;
        }
        List<int> rank = new List<int>();
        for (int r0 = 0; r0 < K; r0 = r0 + 1) { rank.Add(0); }
        for (int r1 = 0; r1 < K; r1 = r1 + 1) { rank[slotOrder[r1]] = r1; }

        // 按组排名对行顺序做稳定计数排序。
        List<int> counts = new List<int>();
        for (int c0 = 0; c0 < K + 1; c0 = c0 + 1) { counts.Add(0); }
        for (int p2 = 0; p2 < n; p2 = p2 + 1) { int r = rank[rowSlot[p2]]; counts[r + 1] = counts[r + 1] + 1; }
        int c1 = 1;
        while (c1 <= K) { counts[c1] = counts[c1] + counts[c1 - 1]; c1 = c1 + 1; }
        List<int> outp = new List<int>();
        for (int o0 = 0; o0 < n; o0 = o0 + 1) { outp.Add(0); }
        for (int p3 = 0; p3 < n; p3 = p3 + 1) {
            int r = rank[rowSlot[p3]];
            outp[counts[r]] = st.order[p3];
            counts[r] = counts[r] + 1;
        }
        st.order = outp;
    }

    static void SortOrderGrouped(DataTableState st, List<DataColumn> cols, DataSource src) {
        int n = st.order.Count;
        if (n < 2) { return; }
        // O(N) 快路径：单分组列，无需保留组内排序。
        if (st.groupCols.Count == 1 && st.sortKeys.Count == 0) {
            DataTable.SortOrderGroupBucket(st, cols, src);
            return;
        }
        List<int> tmp = new List<int>();
        for (int z = 0; z < n; z = z + 1) { tmp.Add(0); }
        int width = 1;
        while (width < n) {
            int lo = 0;
            while (lo < n) {
                int mid = lo + width;
                if (mid > n) { mid = n; }
                int hi = lo + width * 2;
                if (hi > n) { hi = n; }
                if (mid < hi) { DataTable.MergeGrp(st, cols, src, lo, mid, hi, tmp); }
                lo = lo + width * 2;
            }
            width = width * 2;
        }
    }

    // 对 st.order[lo..hi) 连续片段计算逐列聚合，
    // 结果存入 grp.aggValues / grp.aggTexts（与
    // cols 索引对齐）。只扫描 aggMode > 0 且 != 6（派生）的列；
    // 派生列保持 0（它们引用页脚级聚合值，而非
    // 每组的值）。O(|hi-lo| * 聚合列数)。
    static void FillGroupAgg(DataTableState st, List<DataColumn> cols, DataSource src,
                             GroupRow grp, int lo, int hi, bool toGrand) {
        int nc = cols.Count;
        while (grp.aggValues.Count < nc) { grp.aggValues.Add(0); }
        while (grp.aggTexts.Count < nc) { grp.aggTexts.Add(""); }
        int col = 0;
        while (col < nc) {
            int m = 0;
            if (col < st.aggMode.Count) { m = st.aggMode[col]; }
            if (m == 0 || m == 6) { col = col + 1; continue; }
            int dec = cols[col].decimals;
            double s = 0.0;
            double mn = 0.0;
            double mx = 0.0;
            int cnt2 = 0;
            int k = lo;
            while (k < hi && k < st.order.Count) {
                double v = 0.0;
                if (dec > 0) { v = src.CellReal(st.order[k], col); }
                else { v = (double)src.CellNum(st.order[k], col); }
                if (cnt2 == 0) { mn = v; mx = v; }
                else { if (v < mn) { mn = v; } if (v > mx) { mx = v; } }
                s = s + v;
                cnt2 = cnt2 + 1;
                k = k + 1;
            }
            // 把该组的标量并入总计。每个 (组, 列)
            // 只在热行循环之外、且仅对 L==0 的组
            // 执行一次（这些组恰好覆盖每行一次，嵌套层级不会
            // 重复计数）。这正是页脚无需自行扫描的原因。
            if (toGrand && cnt2 > 0) {
                if (col < st.aggSumR.Count) { st.aggSumR[col] = st.aggSumR[col] + s; }
                if (col < st.aggMinR.Count && mn < st.aggMinR[col]) { st.aggMinR[col] = mn; }
                if (col < st.aggMaxR.Count && mx > st.aggMaxR[col]) { st.aggMaxR[col] = mx; }
            }
            double av = 0.0;
            if (m == 1) { av = s; }
            else if (m == 2) { if (cnt2 > 0) { av = s / (double)cnt2; } }
            else if (m == 3) { av = mn; }
            else if (m == 4) { av = mx; }
            else if (m == 5) { av = (double)cnt2; }
            grp.aggValues[col] = (int)av;
            // 平均值即使整数列也保留小数（DevExpress 同样如此），
            // 因此整数列也能显示如"3.5"的值。
            int showDec = dec;
            if (m == 2 && showDec == 0) { showDec = 2; }
            if (m == 5) { showDec = 0; }
            grp.aggTexts[col] = DataTable.FormatCell(cols[col], DataTable.FormatReal(av, showDec));
            col = col + 1;
        }
    }

    // 两行在列 `gc` 上是否同组，基于
    // 类型化值判断（kd：0 文本/小数文本，1 整数，2 布尔，3 日期桶），
    // 热行循环绝不构造字符串键。与 GroupValue 的同一性一致：
    // 整数列以整数为键，小数列和纯文本以
    // 格式化文本为键，布尔以标志为键，日期以桶标签为键。
    static bool GroupLevelEq(List<DataColumn> cols, DataSource src, int ra, int rb, int gc, int kd) {
        if (kd == 1) { return src.CellNum(ra, gc) == src.CellNum(rb, gc); }
        if (kd == 2) { return src.CellBool(ra, gc) == src.CellBool(rb, gc); }
        if (kd == 3) {
            DataColumn c = cols[gc];
            return DataTable.CompareStr(
                DataTable.DateGroupKey(src.CellDay(ra, gc, c.dateOrder), c.dateGroup),
                DataTable.DateGroupKey(src.CellDay(rb, gc, c.dateOrder), c.dateGroup)) == 0;
        }
        return DataTable.CompareStr(src.CellText(ra, gc), src.CellText(rb, gc)) == 0;
    }

    // 由已筛选+排序的 st.order 构建扁平显示模型
    // （组表头与数据行交错）。未分组时，
    // 模型与 st.order 一一对应，下游所有渲染/命中路径
    // 行为与之前完全相同。
    //
    // 分组路径单遍完成：通过比较
    // 当前行与上一行的类型化分组值来发现组边界（st.order
    // 已排序，成员连续），而非为每行重建
    // 约 4 次拼接字符串键。拼接键（用于折叠
    // 标识）只在每个组表头构建一次（数量极少），
    // 每个组的小计在组关闭时填充一次。
    /// 显示槽位总数（数据行 + 组表头 + 详情 band）。
    static int DispCount(DataTableState st) {
        if (st.dispFlat) { return st.order.Count; }
        return st.dispRows.Count;
    }

    /// 槽位类型：0 数据行，1 组表头，2 详情 band。
    static int DispKind(DataTableState st, int i) {
        if (st.dispFlat) { return 0; }
        return st.dispRows[i].kind;
    }

    /// 数据/详情槽位的源行索引（表头槽位为组索引）。
    static int DispRowOf(DataTableState st, int i) {
        if (st.dispFlat) { return st.order[i]; }
        return st.dispRows[i].row;
    }

    /// 行号边栏显示的从 1 开始的数据行号（非数据行为 0）。
    static int DispNo(DataTableState st, int i) {
        if (st.dispFlat) { return i + 1; }
        return st.dispRows[i].no;
    }

    /// 多槽详情 band 内的槽位序号（其他类型为 0）。
    static int DispPart(DataTableState st, int i) {
        if (st.dispFlat) { return 0; }
        return st.dispRows[i].part;
    }

    /// 组表头槽位的嵌套深度（其他类型为 0）。
    static int DispLevel(DataTableState st, int i) {
        if (st.dispFlat) { return 0; }
        return st.dispRows[i].level;
    }

    static void BuildDisplay(DataTableState st, List<DataColumn> cols, DataSource src) {
        st.dispRows.Clear();
        st.groups.Clear();
        int G = st.groupCols.Count;
        st.dispFlat = false;
        if (G == 0 && st.detail == null) {
            // 有序行之间没有插入内容，槽位 i 即 order[i]：
            // 显示模型按需推导而非实体化。
            // 百万行的源过去每次重算都会分配一百万个 DispRow 对象——
            // 这是实时更新网格的主要开销，
            // 而除了屏幕上几十个槽位外全部被丢弃。
            st.dispFlat = true;
            return;
        }
        if (G == 0) {
            for (int i = 0; i < st.order.Count; i = i + 1) {
                st.dispRows.Add(new DispRow(0, st.order[i], i + 1));
                DataTable.EmitDetail(st, src, st.order[i]);
            }
            return;
        }
        int N = st.order.Count;
        // 总计累加器在此播种，由 FillGroupAgg 在
        // 最外层分组上折叠，页脚因此无需自行扫描。
        DataTable.ResetGrandAgg(st, cols.Count);

        // 每层元数据：列索引和类型化键种类。只计算一次
        // （G 很小），使每行的边界判断只是简单的类型化比较。
        List<int> gc = new List<int>();
        List<int> gkind = new List<int>();
        for (int lm = 0; lm < G; lm = lm + 1) {
            int c = st.groupCols[lm];
            gc.Add(c);
            int kd = 0;
            if (c >= 0 && c < cols.Count) {
                if (cols[c].isDate) { kd = 3; }
                else if (cols[c].isBool) { kd = 2; }
                else if (cols[c].numeric && cols[c].decimals == 0) { kd = 1; }
            }
            gkind.Add(kd);
        }

        // 每层的打开组（null 表示无），及其在 st.order 中的起始位置。
        // 只在组边界写入（次数极少），绝不逐行写入。
        List<GroupRow> curGrp = new List<GroupRow>();
        List<int> grpStart = new List<int>();
        for (int li = 0; li < G; li = li + 1) { curGrp.Add(null); grpStart.Add(0); }

        int dataNo = 0;
        for (int p = 0; p < N; p = p + 1) {
            int rowIdx = st.order[p];

            // 与上一行分组不同的最外层级别。
            int firstNew = G;
            if (p == 0) { firstNew = 0; }
            else {
                int prev = st.order[p - 1];
                int L = 0;
                while (L < G) {
                    if (!DataTable.GroupLevelEq(cols, src, rowIdx, prev, gc[L], gkind[L])) {
                        firstNew = L; L = G;
                    } else { L = L + 1; }
                }
            }

            // 关闭在此结束的组（层级 firstNew..G-1），先内层
            // 后外层，在行范围已知后为每层填充一次小计。
            if (p > 0) {
                int fe = G - 1;
                while (fe >= firstNew) {
                    if (curGrp[fe] != null) {
                        curGrp[fe].count = p - grpStart[fe];
                        DataTable.FillGroupAgg(st, cols, src, curGrp[fe], grpStart[fe], p, fe == 0);
                    }
                    fe = fe - 1;
                }
            }

            // 打开新组（层级 firstNew..G-1），先外层。
            int nl = firstNew;
            while (nl < G) {
                bool ancColl = false;
                for (int a = 0; a < nl; a = a + 1) {
                    if (curGrp[a] != null && curGrp[a].collapsed) { ancColl = true; }
                }
                string key = DataTable.PathKey(st, cols, src, rowIdx, nl);
                int gi = st.groups.Count;
                GroupRow newGrp = new GroupRow(
                    cols[gc[nl]].title + ": " + DataTable.GroupValue(cols, src, rowIdx, gc[nl]),
                    nl, 0, key, DataTable.IsCollapsed(st, key));
                st.groups.Add(newGrp);
                curGrp[nl] = newGrp;
                grpStart[nl] = p;
                if (!ancColl) { st.dispRows.Add(new DispRow(1, gi, 0)); }
                nl = nl + 1;
            }

            bool anyColl = false;
            for (int a2 = 0; a2 < G; a2 = a2 + 1) {
                if (curGrp[a2] != null && curGrp[a2].collapsed) { anyColl = true; }
            }
            dataNo = dataNo + 1;
            if (!anyColl) {
                st.dispRows.Add(new DispRow(0, rowIdx, dataNo));
                DataTable.EmitDetail(st, src, rowIdx);
            }
        }

        // 关闭最后仍打开的组。
        int fz = G - 1;
        while (fz >= 0) {
            if (curGrp[fz] != null) {
                curGrp[fz].count = N - grpStart[fz];
                DataTable.FillGroupAgg(st, cols, src, curGrp[fz], grpStart[fz], N, fz == 0);
            }
            fz = fz - 1;
        }
    }

    /// `row` 展开时为其追加详情 band：`DetailSlots` 个
    /// 类型 2 条目，每个指向主行并以 `part` 编号。
    /// 折叠的行，或表中没有 provider 的行，不贡献任何内容——
    /// 未展开的网格与功能加入前的表现完全一致。
    ///
    /// band 占用整行槽位而非任意像素高度，
    /// 主体可用一次乘法在槽位与 Y 之间换算；见
    /// `DispRow`。
    static void EmitDetail(DataTableState st, DataSource src, int row) {
        if (st.detail == null) { return; }
        if (st.expandedRows.IndexOf(row) < 0) { return; }
        // provider 后来拒绝的行（例如子记录已删除）
        // 仍留在 expandedRows 但不产生 band，
        // 底层数据变化时也无需清理该列表。
        if (!st.detail.CanExpand(src, row)) { return; }
        int n = DataTable.DetailSlots(st, src, row);
        for (int k = 0; k < n; k = k + 1) {
            DispRow d = new DispRow(2, row, 0);
            d.part = k;
            st.dispRows.Add(d);
        }
    }

    // 对当前筛选集合（st.order）的逐列聚合，缓存为
    // 格式化字符串，使汇总行每帧重绘零成本。
    //
    // 基础聚合（求和/平均/最小/最大）在 SINGLE 一次遍历中收集：
    // 所有此类列一起累加，N 个聚合列
    // 只需一次遍历而非各一次。派生列
    // （summary==6）再以 O(1) 从缓存聚合计算，
    // 不再触碰行。
    static void ComputeSummary(DataTableState st, List<DataColumn> cols, DataSource src) {
        int nc = cols.Count;
        while (st.aggMode.Count < nc) { st.aggMode.Add(0); }
        int n = st.order.Count;

        // 逐列累加器 + 需要扫描的列的紧凑集合
        List<double> sumV = new List<double>();
        List<double> minV = new List<double>();
        List<double> maxV = new List<double>();
        List<int> baseCols = new List<int>();
        for (int col = 0; col < nc; col = col + 1) {
            sumV.Add(0.0);
            minV.Add(0.0);
            maxV.Add(0.0);
            int m = st.aggMode[col];
            if (m >= 1 && m <= 4) { baseCols.Add(col); }
        }

        // ---- 在可见行上累加每个基础列 ----
        // 累加保持在标量中，在行循环外一次性写回
        // 逐列列表：在百万次迭代的热循环内按下标写列表
        // 会触发 -O0 代码生成泄漏栈的 bug。
        // 仍是每个 (基础列, 行) 一次 CellNum 读取——与
        // 单次交错遍历的总工作量相同——而且只扫描
        // 需要聚合的列。
        for (int bi = 0; bi < baseCols.Count; bi = bi + 1) {
            int bc = baseCols[bi];
            bool realCol = cols[bc].decimals > 0;
            double s = 0.0;
            double mn = 0.0;
            double mx = 0.0;
            for (int k = 0; k < n; k = k + 1) {
                double v = 0.0;
                if (realCol) { v = src.CellReal(st.order[k], bc); }
                else { v = (double)src.CellNum(st.order[k], bc); }
                s = s + v;
                if (k == 0) { mn = v; mx = v; }
                else {
                    if (v < mn) { mn = v; }
                    if (v > mx) { mx = v; }
                }
            }
            sumV[bc] = s;
            minV[bc] = mn;
            maxV[bc] = mx;
        }

        DataTable.FinalizeSummary(st, cols, sumV, minV, maxV, n);
    }

    // 把逐列基础累加器（对 `n` 行的求和/最小/最大）转为
    // 缓存页脚：基础模式直接解析，派生（模式 6）列读取
    // 已完成的基础聚合，所有内容只格式化一次。
    // 由扁平行扫描路径（ComputeSummary）和分组合并路径
    // （ComputeSummaryFromGroups）共用，两者生成字节一致的页脚。
    static void FinalizeSummary(DataTableState st, List<DataColumn> cols,
                                List<double> sumV, List<double> minV,
                                List<double> maxV, int n) {
        int nc = cols.Count;
        st.aggValue.Clear();
        st.aggReal.Clear();
        int col = 0;
        for (; col < nc; col = col + 1) { st.aggValue.Add(0); st.aggReal.Add(0.0); }
        col = 0;
        while (col < nc) {
            int m = st.aggMode[col];
            if (m == 1) { st.aggReal[col] = sumV[col]; }
            else if (m == 2) { if (n > 0) { st.aggReal[col] = sumV[col] / (double)n; } }
            else if (m == 3) { st.aggReal[col] = minV[col]; }
            else if (m == 4) { st.aggReal[col] = maxV[col]; }
            else if (m == 5) { st.aggReal[col] = (double)n; }
            st.aggValue[col] = (int)st.aggReal[col];
            col = col + 1;
        }
        col = 0;
        while (col < nc) {
            if (st.aggMode[col] == 6) {
                st.aggValue[col] = DataTable.DeriveValue(cols[col], st.aggValue);
                st.aggReal[col] = DataTable.DeriveReal(cols[col], st.aggReal);
            }
            col = col + 1;
        }

        // 格式化（不扫描行）
        st.summaryText.Clear();
        col = 0;
        while (col < nc) {
            int m = st.aggMode[col];
            int dec = cols[col].decimals;
            // 平均值总是保留小数，即使整数列也是如此。
            int showDec = dec;
            if (m == 2 && showDec == 0) { showDec = 2; }
            string val = DataTable.FormatCell(cols[col], DataTable.FormatReal(st.aggReal[col], showDec));
            string txt = "";
            if (m == 1) { txt = "Σ " + val; }
            else if (m == 2) { txt = "avg " + val; }
            else if (m == 3) { txt = "min " + val; }
            else if (m == 4) { txt = "max " + val; }
            else if (m == 5) { txt = "n " + Convert.ToString(n); }
            else if (m == 6) {
                int ddec = dec;
                if (cols[col].deriveOp == 0 || cols[col].deriveOp == 1) {
                    if (ddec == 0) { ddec = 2; }
                }
                txt = DataTable.FormatReal(st.aggReal[col], ddec);
                if (cols[col].deriveOp == 0) { txt = txt + "%"; }
            }
            st.summaryText.Add(txt);
            col = col + 1;
        }
    }

    // 分组页脚：合并 BuildDisplay/FillGroupAgg 已收集的每组基础聚合
    // （L==0 组的 st.aggSumR/aggMinR/aggMaxR，
    // 这些组恰好划分每行一次）为总计，
    // 无需第二次百万行扫描。组和之和 = 总和，
    // 组最小之最小 = 总最小，组最大之最大 = 总最大，平均值 = 总和
    // / 总行数——页脚与扁平重算结果完全一致。
    static void ComputeSummaryFromGroups(DataTableState st, List<DataColumn> cols) {
        int nc = cols.Count;
        while (st.aggMode.Count < nc) { st.aggMode.Add(0); }
        int n = st.order.Count;
        List<double> sumV = new List<double>();
        List<double> minV = new List<double>();
        List<double> maxV = new List<double>();
        for (int col = 0; col < nc; col = col + 1) {
            double sv = 0.0;
            double mnv = 0.0;
            double mxv = 0.0;
            if (col < st.aggSumR.Count) { sv = st.aggSumR[col]; }
            if (col < st.aggMinR.Count) { mnv = st.aggMinR[col]; }
            if (col < st.aggMaxR.Count) { mxv = st.aggMaxR[col]; }
            // 没有任何组贡献（如空表）：回退为 0，
            // 使页脚与对零行重算的结果一致。
            if (mnv > 0.9e300) { mnv = 0.0; }
            if (mxv < -0.9e300) { mxv = 0.0; }
            sumV.Add(sv);
            minV.Add(mnv);
            maxV.Add(mxv);
        }
        DataTable.FinalizeSummary(st, cols, sumV, minV, maxV, n);
    }

    // 重置 FillGroupAgg 喂入的总计累加器。min/max 以
    // 哨兵值起步，使首个贡献的组无需逐列
    // "已见"标志即可播种；没有扫描行的列通过 FinalizeSummary
    // 的 aggMode 分支保持聚合为 0。
    static void ResetGrandAgg(DataTableState st, int nc) {
        st.aggSumR.Clear();
        st.aggMinR.Clear();
        st.aggMaxR.Clear();
        for (int col = 0; col < nc; col = col + 1) {
            st.aggSumR.Add(0.0);
            st.aggMinR.Add(1.0e300);
            st.aggMaxR.Add(-1.0e300);
        }
    }

    // 筛选集合上的逐列 min/max，用于数据条和色阶
    // 归一化。只扫描 cfMode 为 1 或 2 的列。
    static void ComputeColStats(DataTableState st, List<DataColumn> cols, DataSource src) {
        st.cfMin.Clear();
        st.cfMax.Clear();
        st.cfMinR.Clear();
        st.cfMaxR.Clear();
        int n = st.order.Count;
        for (int col = 0; col < cols.Count; col = col + 1) {
            double mn = 0.0;
            double mx = 0.0;
            if (cols[col].cfMode == 1 || cols[col].cfMode == 2) {
                bool realCol = cols[col].decimals > 0;
                for (int k = 0; k < n; k = k + 1) {
                    double v = 0.0;
                    if (realCol) { v = src.CellReal(st.order[k], col); }
                    else { v = (double)src.CellNum(st.order[k], col); }
                    if (k == 0) { mn = v; mx = v; }
                    else { if (v < mn) { mn = v; } if (v > mx) { mx = v; } }
                }
            }
            st.cfMinR.Add(mn);
            st.cfMaxR.Add(mx);
            st.cfMin.Add((int)mn);
            st.cfMax.Add((int)mx);
        }
    }

}
