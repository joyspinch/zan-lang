using System;
using Gui;

namespace Gui.Component.DataTable;

/// DataTable part: filter predicates — case-insensitive text matching,
/// per-column text/compare/preset filters used by the header filter menus.
partial class DataTable {
    // ---- case-insensitive string matching for the text/batch filters ----

    static int FoldC(int cc) {
        if (cc >= 65 && cc <= 90) { return cc + 32; }
        return cc;
    }

    static bool MatchAt(string hay, string needle, int off) {
        int j = 0;
        while (j < needle.Length) {
            char ch = hay[off + j];
            char cn = needle[j];
            if (DataTable.FoldC((int)ch) != DataTable.FoldC((int)cn)) { return false; }
            j = j + 1;
        }
        return true;
    }

    static bool EqCI(string a, string b) {
        if (a.Length != b.Length) { return false; }
        return DataTable.MatchAt(a, b, 0);
    }

    static bool ContainsCI(string hay, string needle) {
        int nl = needle.Length;
        int hl = hay.Length;
        if (nl == 0) { return true; }
        if (nl > hl) { return false; }
        int i = 0;
        while (i <= hl - nl) {
            if (DataTable.MatchAt(hay, needle, i)) { return true; }
            i = i + 1;
        }
        return false;
    }

    static bool StartsCI(string hay, string needle) {
        if (needle.Length > hay.Length) { return false; }
        return DataTable.MatchAt(hay, needle, 0);
    }

    static bool EndsCI(string hay, string needle) {
        int nl = needle.Length;
        int hl = hay.Length;
        if (nl > hl) { return false; }
        return DataTable.MatchAt(hay, needle, hl - nl);
    }

    static bool TextMatch(string v, string q, int mode) {
        if (q.Length == 0) { return true; }
        if (mode == 2) { return DataTable.EqCI(v, q); }
        if (mode == 3) { return DataTable.StartsCI(v, q); }
        if (mode == 4) { return DataTable.EndsCI(v, q); }
        return DataTable.ContainsCI(v, q);
    }

    // Remove the last character (not the last byte) so multi-byte characters
    // are deleted whole.
    static string Backspace(string s) {
        if (s.Length == 0) { return ""; }
        return Text.Left(s, Text.PrevCharStart(s, s.Length));
    }

    // Whether a single cell value survives every stage of the column filter.
    // Back-compat entry point: filters a value with no column type available,
    // so the comparison stage falls back to a plain text ordering.
    static bool CellPasses(ColFilter f, string v) {
        return DataTable.CellPassesCol(f, DataColumn.Create("", 0), v, 0);
    }

    /// Row-level filter stages for one cell. `today` is the current day number,
    /// passed in so every row of a pass resolves a date preset against the same
    /// instant. Top-N is not decided here: it needs the whole set.
    static bool CellPassesCol(ColFilter f, DataColumn col, string v, int today) {
        if (f.cmpMode != 0) {
            if (!DataTable.CmpPasses(f, col, v)) { return false; }
        }
        if (f.datePreset != 0) {
            if (!DataTable.PresetPasses(f, col, v, today)) { return false; }
        }
        if (f.hidden.Contains(v)) { return false; }
        if (f.textQuery.Length > 0) {
            if (!DataTable.TextMatch(v, f.textQuery, f.textMode)) { return false; }
        }
        if (f.batchTerms.Count > 0) {
            bool matched = false;
            int i = 0;
            while (i < f.batchTerms.Count) {
                bool hit = false;
                if (f.batchExact) { hit = DataTable.EqCI(v, f.batchTerms[i]); }
                else { hit = DataTable.ContainsCI(v, f.batchTerms[i]); }
                if (hit) { matched = true; i = f.batchTerms.Count; }
                else { i = i + 1; }
            }
            if (f.batchKeep) {
                if (!matched) { return false; }
            } else {
                if (matched) { return false; }
            }
        }
        return true;
    }

    // ---- comparison filter ----

    // Test one cell against the filter's comparison stage. Ordering comes from
    // the column, so a numeric column compares by value and a date column by
    // day; only an untyped column falls back to text.
    static bool CmpPasses(ColFilter f, DataColumn col, string v) {
        int m = f.cmpMode;
        if (m == 9) { return DataTable.TrimSpace(v).Length == 0; }
        if (m == 10) { return DataTable.TrimSpace(v).Length > 0; }
        int ca = DataTable.CompareCellCol(col, v, f.cmpA);
        if (m == 1) { return ca > 0; }
        if (m == 2) { return ca >= 0; }
        if (m == 3) { return ca < 0; }
        if (m == 4) { return ca <= 0; }
        if (m == 5) { return ca == 0; }
        if (m == 6) { return ca != 0; }
        if (m == 7 || m == 8) {
            // Accept the bounds in either order, so "between 10 and 1" still
            // describes the range a user meant.
            string lo = f.cmpA;
            string hi = f.cmpB;
            if (DataTable.CompareCellCol(col, lo, hi) > 0) { lo = f.cmpB; hi = f.cmpA; }
            bool inside = DataTable.CompareCellCol(col, v, lo) >= 0
                       && DataTable.CompareCellCol(col, v, hi) <= 0;
            if (m == 7) { return inside; }
            return !inside;
        }
        return true;
    }

    /// The inclusive day range a date preset covers, relative to `today`.
    /// Returns false when the preset is off or the range is open-ended on that
    /// side; lo/hi are written into a two-element list (0 = lo, 1 = hi).
    static List<int> PresetRange(int preset, int today) {
        List<int> r = new List<int>{
            DataTable.NoDate(),
            DataTable.NoDate() };
        if (preset == 0 || today == DataTable.NoDate()) { return r; }
        DateTime t = DateTime.FromUnixSeconds(today * 86400);
        int y = t.Year();
        int mo = t.Month();
        if (preset == 1) { r[0] = today; r[1] = today; }
        else if (preset == 2) { r[0] = today - 1; r[1] = today - 1; }
        else if (preset == 3) {
            int dow = DateTime.FloorMod(today + 4, 7);   // 0 = Sunday
            r[0] = today - dow;
            r[1] = r[0] + 6;
        }
        else if (preset == 4) { r[0] = today - 6; r[1] = today; }
        else if (preset == 5) {
            r[0] = DateTime.DaysFromCivil(y, mo, 1);
            r[1] = r[0] + DateTime.DaysInMonth(y, mo) - 1;
        }
        else if (preset == 6) { r[0] = today - 29; r[1] = today; }
        else if (preset == 7) {
            int qs = ((mo - 1) / 3) * 3 + 1;
            r[0] = DateTime.DaysFromCivil(y, qs, 1);
            int qe = qs + 2;
            r[1] = DateTime.DaysFromCivil(y, qe, DateTime.DaysInMonth(y, qe));
        }
        else if (preset == 8) {
            r[0] = DateTime.DaysFromCivil(y, 1, 1);
            r[1] = DateTime.DaysFromCivil(y, 12, 31);
        }
        else if (preset == 9) { r[0] = DateTime.DaysFromCivil(y, 1, 1); r[1] = today; }
        else if (preset == 10) { r[1] = today - 1; }   // past: open on the low side
        else if (preset == 11) { r[0] = today + 1; }   // future: open on the high side
        return r;
    }

    // Test one cell against the filter's date preset. A cell that holds no
    // recognisable date never satisfies a preset.
    static bool PresetPasses(ColFilter f, DataColumn col, string v, int today) {
        int d = DataTable.ParseDate(v, col.dateOrder);
        if (d == DataTable.NoDate()) { return false; }
        List<int> r = DataTable.PresetRange(f.datePreset, today);
        if (r[0] != DataTable.NoDate() && d < r[0]) { return false; }
        if (r[1] != DataTable.NoDate() && d > r[1]) { return false; }
        return true;
    }

    /// Today as a day number, for resolving relative date presets.
    static int Today() {
        return (int)DateTime.FloorDivL(DateTime.UtcNow().ToUnixSeconds(), 86400);
    }

    static int CompareCell(string a, string b, bool numeric) {
        if (numeric) {
            int va = ParseInt(a);
            int vb = ParseInt(b);
            if (va < vb) { return -1; }
            if (va > vb) { return 1; }
            return 0;
        }
        return DataTable.CompareStr(a, b);
    }

    // Column-aware cell comparison: fractional columns compare as doubles so
    // 1.5 and 1.9 no longer tie, integer columns keep the exact int path, and
    // everything else compares as text.
    static int CompareCellCol(DataColumn col, string a, string b) {
        if (col.isBool) {
            int ba = 0;
            int bb = 0;
            if (DataTable.ParseBool(a)) { ba = 1; }
            if (DataTable.ParseBool(b)) { bb = 1; }
            if (ba < bb) { return -1; }
            if (ba > bb) { return 1; }
            return 0;
        }
        if (col.isDate) {
            int ka = DataTable.ParseDate(a, col.dateOrder);
            int kb = DataTable.ParseDate(b, col.dateOrder);
            if (ka < kb) { return -1; }
            if (ka > kb) { return 1; }
            return 0;
        }
        if (col.numeric && col.decimals > 0) {
            double da = DataTable.ParseReal(a);
            double db = DataTable.ParseReal(b);
            if (da < db) { return -1; }
            if (da > db) { return 1; }
            return 0;
        }
        return DataTable.CompareCell(a, b, col.numeric);
    }

    static string Truncate(string text, int fontSize, int maxW) {
        if (maxW <= 0) { return ""; }
        if (Canvas.MeasureText(text, fontSize) <= maxW) { return text; }
        int n = text.Length;
        int k = n;
        while (k > 0) {
            string cand = text.Substring(0, k);
            string withDots = cand + "…";
            if (Canvas.MeasureText(withDots, fontSize) <= maxW) {
                return withDots;
            }
            k = k - 1;
        }
        return "…";
    }

    static int TypeColor(Theme t, int type) {
        if (type == 1) { return t.primary; }
        if (type == 2) { return t.info; }
        if (type == 3) { return t.success; }
        if (type == 4) { return t.warning; }
        if (type == 5) { return t.error; }
        return t.textSecondary;
    }

}
