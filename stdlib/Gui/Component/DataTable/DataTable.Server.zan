using System;
using Gui;

namespace Gui.Component.DataTable;

/// <summary>
/// 服务端/无限/视口数据源：网格以
/// 固定大小的块从底层服务拉取行，只缓存已获取的数据，
/// 总数未知，随用户滚动而增长。
///
/// 继承它并实现 FillBlock——实际的数据获取。两种交付模式：
///   - 同步（默认）：网格请求块时 FillBlock 在 UI 线程运行。
///     适合快速本地源（文件、计算视图、进程内查询）：
///     网格每帧的 Poll() 会
///     把刚填充的块并入，因此可见块最多延迟一帧。
///   - 异步：重写 FetchBlock 启动自己的后台获取
///     （Thread 工作线程、异步 I/O 调用），并在结果返回处
///     （例如 App.Post 的处理器）调用 FinishBlock(rows, count)。
///     Poll() 只在 FinishBlock 执行后才并入数据块，UI 线程从不
///     等待远端。获取进行中时 RequestBlock 保持合并，
///     慢服务器无法堆积无界的工作。
///
/// 行索引由服务器排序：ServerControlled() 返回 true，
/// 网格跳过本地排序/过滤，按源提供的顺序原样渲染
/// 。分组和聚合仍在本地运行，作用于已加载的
/// 前缀（这是部分数据集的固有属性，不是 bug）。
///
/// 总数模式：
///   - 未知（默认）：RowCount() 报告已获取前缀，HasMore() 保持 true，
///     直到一个短块（少于 blockSize 行）宣告
///     结束——或由 SetKnownTotal 显式固定。
///   - 已知：Create 后立即 SetKnownTotal(n) 让网格从一开始就有精确的
///     滚动条；数据块按需在其后流入。
/// </summary>
class ServerDataSource : DataSource {
    int blockSize;           // 每个获取块的行数（默认 100）
    List<DataRow> cache;     // 已获取的行，按索引对齐（0..RowCount）
    int knownTotal;          // 服务器声明的总行数，-1 = 未知
    bool loading;            // 获取进行中（合并 RequestBlock）
    int fetchStart;          // 进行中获取的首行
    bool blockDone;          // 进行中的获取已产生结果
    List<DataRow> blockRows; // 进行中获取的结果缓冲区
    int blockCount;          // 获取产生的行数（短块 = 数据结束）

    /// 以给定块大小创建服务端数据源。
    /// 之后调用 SetKnownTotal 固定总行数；不调用则保持未知并持续增长。
    ServerDataSource(int blockSize) {
        this.Setup(blockSize);
    }

    /// 初始化数据源。自行构建实例的子类（如
    /// RowListSource.Create 之类的静态工厂）在使用前调用它。
    void Setup(int blockSize) {
        this.blockSize = blockSize;
        if (this.blockSize < 1) { this.blockSize = 1; }
        this.cache = new List<DataRow>();
        this.knownTotal = -1;
        this.loading = false;
        this.fetchStart = 0;
        this.blockDone = false;
        this.blockRows = new List<DataRow>();
        this.blockCount = 0;
    }

    /// 固定总行数。传 -1 回到未知/增长模式。
    /// 数据源可随时调用——例如计数查询返回后——
    /// 网格会在下一次 Poll() 时获取。
    void SetKnownTotal(int total) {
        this.knownTotal = total;
    }

    /// 当前已知行数：服务器已声明时为其总数，
    /// 否则为已获取前缀（网格随数据到达而增长）。
    override int RowCount() {
        if (this.knownTotal >= 0) { return this.knownTotal; }
        return this.cache.Count;
    }

    /// 顺序由服务器掌控：网格不得在本地重新排序或过滤。
    override bool ServerControlled() { return true; }

    /// 只有已获取的行可读；其余渲染为加载
    /// 占位符并触发数据块请求。
    override bool CellReady(int row, int col) {
        return row >= 0 && row < this.cache.Count;
    }

    /// 总数已知且已全部获取，或出现短块
    /// 宣告结束时（未知模式），数据源即已耗尽。
    override bool HasMore() {
        if (this.knownTotal >= 0) { return this.cache.Count < this.knownTotal; }
        return true;
    }

    override void RequestBlock(int row) {
        if (this.loading) { return; }
        if (row < 0) { return; }
        if (!this.HasMore()) { return; }
        int start = (row / this.blockSize) * this.blockSize;
        // 该块已完全获取——无需操作。请求落在
        // 参差的缓存边界上（滚动到底落在块中间）仍会
        // 获取该块的剩余部分。
        if (start + this.blockSize <= this.cache.Count) { return; }
        this.StartFetch(start);
    }

    /// 获取已加载前缀之后的下一块。网格在
    /// 用户滚动到底部时调用：它覆盖参差边界的情况（
    /// 前缀在块中间结束，下一次获取补全该块）以及
    /// 块对齐的情况（前缀正好在边界结束，下一次
    /// 获取从新块开始）。
    override void RequestNextBlock() {
        if (this.loading) { return; }
        if (!this.HasMore()) { return; }
        int bs = this.blockSize;
        int start = (this.cache.Count / bs) * bs;
        if (start + bs <= this.cache.Count) { start = start + bs; }
        this.StartFetch(start);
    }

    void StartFetch(int start) {
        this.fetchStart = start;
        this.loading = true;
        this.blockDone = false;
        this.blockRows = new List<DataRow>();
        this.blockCount = 0;
        this.FetchBlock(start, this.blockSize);
    }

    /// 将完成的获取并入缓存。网格每帧调用；
    /// 在 FetchBlock 完成（同步）或调用 FinishBlock（异步）之前不做事。
    /// 有变化时返回 true，网格
    /// 据此标记自身为脏并用新行重绘。
    override bool Poll() {
        if (!this.loading) { return false; }
        if (!this.blockDone) { return false; }
        this.loading = false;
        this.blockDone = false;
        int n = this.blockCount;
        if (n > 0) {
            for (int i = 0; i < n; i = i + 1) { this.cache.Add(this.blockRows[i]); }
        }
        if (this.knownTotal < 0 && n < this.blockSize) {
            // 短块表示服务器在说“这是最后一块”。
            this.knownTotal = this.cache.Count;
        }
        this.blockRows = new List<DataRow>();
        this.blockCount = 0;
        return true;
    }

    /// 开始将行 [start, start+count) 取入块缓冲区。
    /// 默认在调用方（UI）线程上同步运行 FillBlock，
    /// 适合快速本地源。重写以真正异步交付，
    /// 并在完成路径中调用 FinishBlock。
    virtual void FetchBlock(int start, int count) {
        int n = this.FillBlock(start, count, this.blockRows);
        this.FinishBlock(this.blockRows, n);
    }

    /// 保存进行中获取的结果。Poll() 在下一帧
    /// 将其并入缓存。
    void FinishBlock(List<DataRow> rows, int count) {
        this.blockRows = rows;
        this.blockCount = count;
        this.blockDone = true;
    }

    /// 从 `start` 开始取最多 `count` 行，每行追加一个 DataRow
    /// 到 `dst`。返回追加的数量；少于 `count` 表示
    /// 服务器没有更多行了（此时固定总数）。同步
    /// 数据源只需实现这一个方法。
    virtual int FillBlock(int start, int count, List<DataRow> dst) { return 0; }

    // ---- 基于缓存的单元格读取 ----
    override string CellText(int row, int col) {
        if (row < 0 || row >= this.cache.Count) { return ""; }
        return this.cache[row].At(col);
    }

    override int CellNum(int row, int col) {
        if (row < 0 || row >= this.cache.Count) { return 0; }
        return DataTable.ParseInt(this.cache[row].At(col));
    }

    override double CellReal(int row, int col) {
        if (row < 0 || row >= this.cache.Count) { return 0.0; }
        return DataTable.ParseReal(this.cache[row].At(col));
    }

    override int CellDay(int row, int col, int order) {
        if (row < 0 || row >= this.cache.Count) { return DataTable.NoDate(); }
        return DataTable.ParseDate(this.cache[row].At(col), order);
    }

    override bool CellBool(int row, int col) {
        if (row < 0 || row >= this.cache.Count) { return false; }
        return DataTable.ParseBool(this.cache[row].At(col));
    }

    override void SetCell(int row, int col, string v) {
        if (row < 0 || row >= this.cache.Count) { return; }
        this.cache[row].Set(col, v);
    }
}
