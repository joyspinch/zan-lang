using System;
using Gui;

namespace Gui.Component.DataTable;

/// <summary>
/// 服务端/无限/视口数据源：网格以
/// 固定大小的块从底层服务拉取行，只缓存已获取的数据，
/// 总数未知，随用户滚动而增长。
///
/// 继承它并实现 FillBlock——实际的数据获取。两种交付模式：
///   - 同步（默认）：网格请求块时 FillBlock 在 UI 线程运行。
///     适合快速本地源（文件、计算视图、进程内查询）：
///     网格每帧的 Poll() 会
///     把刚填充的块并入，因此可见块最多延迟一帧。
///   - 异步：重写 FetchBlock 启动自己的后台获取
///     （Thread 工作线程、异步 I/O 调用），并在结果返回处
///     （例如 App.Post 的处理器）调用 FinishBlock(rows, count)。
///     Poll() 只在 FinishBlock 执行后才并入数据块，UI 线程从不
///     等待远端。获取进行中时 RequestBlock 保持合并，
///     慢服务器无法堆积无界的工作。
///
/// 行索引由服务器排序：ServerControlled() 返回 true，
/// 网格跳过本地排序/过滤，按源提供的顺序原样渲染
/// 。分组和聚合仍在本地运行，作用于已加载的
/// 前缀（这是部分数据集的固有属性，不是 bug）。
///
/// 总数模式：
///   - 未知（默认）：RowCount() 报告已获取前缀，HasMore() 保持 true，
///     直到一个短块（少于 blockSize 行）宣告
///     结束——或由 SetKnownTotal 显式固定。
///   - 已知：Create 后立即 SetKnownTotal(n) 让网格从一开始就有精确的
///     滚动条；数据块按需在其后流入。
/// </summary>
class ServerDataSource : DataSource {
    int blockSize;           // 每个获取块的行数（默认 100）
    List<DataRow> cache;     // 已获取的行，按索引对齐（0..RowCount）
    int knownTotal;          // 服务器声明的总行数，-1 = 未知
    bool loading;            // 获取进行中（合并 RequestBlock）
    int fetchStart;          // 进行中获取的首行
    bool blockDone;          // 进行中的获取已产生结果
    List<DataRow> blockRows; // 进行中的获取结果缓冲区
    int blockCount;          // 获取产生的行数（短块 = 数据结束）
    int nextFetchId;         // 单调请求 nonce
    int activeFetchId;       // 当前 in-flight 请求 nonce
    /// 可选的列 Field 名查找（cell 增量按名寻址）。
    /// null 时 cell 的 Field 按"纯数字 = 列索引"解释。
    CellFieldLookup cellFieldOf;


    /// 以给定块大小创建服务端数据源。
    /// 之后调用 SetKnownTotal 固定总行数；不调用则保持未知并持续增长。
    ServerDataSource(int blockSize) {
        this.Setup(blockSize);
    }

    /// 初始化数据源。自行构建实例的子类（如
    /// RowListSource.Create 之类的静态工厂）在使用前调用它。
    void Setup(int blockSize) {
        this.blockSize = blockSize;
        if (this.blockSize < 1) { this.blockSize = 1; }
        this.cache = new List<DataRow>();
        this.knownTotal = -1;
        this.loading = false;
        this.fetchStart = 0;
        this.blockDone = false;
        this.blockRows = new List<DataRow>();
        this.blockCount = 0;
        this.nextFetchId = 0;
        this.activeFetchId = 0;
    }

    /// 固定总行数。传 -1 回到未知/增长模式。
    /// 数据源可随时调用——例如计数查询返回后——
    /// 网格会在下一次 Poll() 时获取。
    void SetKnownTotal(int total) {
        if (total < 0) { this.knownTotal = -1; return; }
        if (total < this.cache.Count) { total = this.cache.Count; }
        this.knownTotal = total;
    }

    /// 安装列 Field 名查找（cell 增量按稳定名寻址）。
    void SetCellFieldLookup(CellFieldLookup lookup) {
        this.cellFieldOf = lookup;
    }

    /// 当前已知行数：服务器已声明时为其总数，
    /// 否则为已获取前缀（网格随数据到达而增长）。
    override int RowCount() {
        if (this.knownTotal >= 0) { return this.knownTotal; }
        return this.cache.Count;
    }

    /// 顺序由服务器掌控：网格不得在本地重新排序或过滤。
    override bool ServerControlled() { return true; }

    /// 只有已获取的行可读；其余渲染为加载
    /// 占位符并触发数据块请求。
    override bool CellReady(int row, int col) {
        return row >= 0 && row < this.cache.Count;
    }

    /// 总数已知且已全部获取，或出现短块
    /// 宣告结束时（未知模式），数据源即已耗尽。
    override bool HasMore() {
        if (this.knownTotal >= 0) { return this.cache.Count < this.knownTotal; }
        return true;
    }

    /// 请求包含 row 的块。连续前缀模型：row 落在已加载前缀内时为
    /// 空操作，只从当前前缀末端继续；获取进行中或数据已耗尽时忽略。
    override void RequestBlock(int row) {
        if (this.loading) { return; }
        if (row < 0) { return; }
        if (!this.HasMore()) { return; }
        // 旧源明确是连续前缀模型：随机落入未加载中间位置时，
        // 只能从当前前缀末端继续，不能把该页追加到错误的索引。
        if (row < this.cache.Count) { return; }
        this.StartFetch(this.cache.Count);
    }

    /// 获取已加载前缀之后的下一块。网格在
    /// 用户滚动到底部时调用：它覆盖参差边界的情况（
    /// 前缀在块中间结束，下一次获取补全该块）以及
    /// 块对齐的情况（前缀正好在边界结束，下一次
    /// 获取从新块开始）。
    override void RequestNextBlock() {
        if (this.loading) { return; }
        if (!this.HasMore()) { return; }
        this.StartFetch(this.cache.Count);
    }

    /// 从 start（钳制到当前前缀末端）发起一次块获取，并登记请求 nonce。
    void StartFetch(int start) {
        if (start < this.cache.Count) { start = this.cache.Count; }
        this.fetchStart = start;
        this.loading = true;
        this.blockDone = false;
        this.blockRows = new List<DataRow>();
        this.blockCount = 0;
        this.nextFetchId = this.nextFetchId + 1;
        this.activeFetchId = this.nextFetchId;
        this.FetchBlock(start, this.blockSize);
    }

    /// 将完成的获取并入缓存。网格每帧调用；
    /// 在 FetchBlock 完成（同步）或调用 FinishBlock（异步）之前不做事。
    /// 有变化时返回 true，网格
    /// 据此标记自身为脏并用新行重绘。
    override bool Poll() {
        if (!this.loading) { return false; }
        if (!this.blockDone) { return false; }
        this.loading = false;
        this.blockDone = false;
        int n = this.blockCount;
        if (this.fetchStart != this.cache.Count) { n = -1; }
        if (n < 0 || n > this.blockRows.Count || n > this.blockSize) {
            this.blockRows = new List<DataRow>();
            this.blockCount = 0;
            return false;
        }
        if (n > 0) {
            for (int i = 0; i < n; i = i + 1) { this.cache.Add(this.blockRows[i]); }
        }
        if (this.knownTotal >= 0 && this.cache.Count > this.knownTotal) {
            this.knownTotal = this.cache.Count;
        }
        if (this.knownTotal < 0 && n < this.blockSize) {
            // 短块表示服务器在说“这是最后一块”。
            this.knownTotal = this.cache.Count;
        }
        this.blockRows = new List<DataRow>();
        this.blockCount = 0;
        return true;
    }

    /// 开始将行 [start, start+count) 取入块缓冲区。
    /// 默认在调用方（UI）线程上同步运行 FillBlock，
    /// 适合快速本地源。重写以真正异步交付，
    /// 并在完成路径中调用 FinishBlock。
    virtual void FetchBlock(int start, int count) {
        int n = this.FillBlock(start, count, this.blockRows);
        this.FinishBlock(this.blockRows, n);
    }

    /// 保存进行中获取的结果。Poll() 在下一帧
    /// 将其并入缓存。
    void FinishBlock(List<DataRow> rows, int count) {
        this.FinishBlock(rows, count, this.activeFetchId);
    }

    /// 带 nonce 的底层完成入口：nonce 不匹配当前请求时丢弃；
    /// rows 为 null 或 count 越界视为失败块（Poll 将丢弃）。
    void FinishBlock(List<DataRow> rows, int count, int fetchId) {
        if (!this.loading || this.blockDone || fetchId != this.activeFetchId) { return; }
        if (rows == null || count < 0 || count > rows.Count
            || count > this.blockSize) {
            this.blockRows = new List<DataRow>();
            this.blockCount = -1;
            this.blockDone = true;
            return;
        }
        this.blockRows = rows;
        this.blockCount = count;
        this.blockDone = true;
    }

    /// 从 `start` 开始取最多 `count` 行，每行追加一个 DataRow
    /// 到 `dst`。返回追加的数量；少于 `count` 表示
    /// 服务器没有更多行了（此时固定总数）。同步
    /// 数据源只需实现这一个方法。
    virtual int FillBlock(int start, int count, List<DataRow> dst) { return 0; }

    // ---- 基于缓存的单元格读取 ----
    /// 缓存前缀内的单元格文本；未加载行为空串。
    override string CellText(int row, int col) {
        if (row < 0 || row >= this.cache.Count) { return ""; }
        return this.cache[row].At(col);
    }

    /// 缓存前缀内的整数解读（ParseInt）；未加载行为 0。
    override int CellNum(int row, int col) {
        if (row < 0 || row >= this.cache.Count) { return 0; }
        return DataTable.ParseInt(this.cache[row].At(col));
    }

    /// 缓存前缀内的实数解读（ParseReal）；未加载行为 0.0。
    override double CellReal(int row, int col) {
        if (row < 0 || row >= this.cache.Count) { return 0.0; }
        return DataTable.ParseReal(this.cache[row].At(col));
    }

    /// 缓存前缀内的日期解读（ParseDate）；未加载行为 NoDate。
    override int CellDay(int row, int col, int order) {
        if (row < 0 || row >= this.cache.Count) { return DataTable.NoDate(); }
        return DataTable.ParseDate(this.cache[row].At(col), order);
    }

    /// 缓存前缀内的布尔解读（ParseBool）；未加载行为 false。
    override bool CellBool(int row, int col) {
        if (row < 0 || row >= this.cache.Count) { return false; }
        return DataTable.ParseBool(this.cache[row].At(col));
    }

    /// 写缓存前缀内的单元格；越界为空操作。
    override void SetCell(int row, int col, string v) {
        if (row < 0 || row >= this.cache.Count) { return; }
        this.cache[row].Set(col, v);
    }

    /// 稳定行键入口：缓存前缀的行没有业务键，增量按
    /// legacy:<row> 位置键匹配。持有业务键的服务端源应
    /// 重写 GetRowKey 返回业务键，让 delta 以键身份合并。
    override RowKey GetRowKey(int row) {
        if (row < 0 || row >= this.cache.Count) { return RowKey.Legacy(row); }
        return RowKey.Legacy(row);
    }

    /// 把一批按键增量合并进已获取缓存：upsert 覆盖/追加，
    /// remove 幂等，cell 按列 Field 名（可选查找）或列索引寻址。
    /// 应用后使缓存语义与新行数一致——knownTotal 未知时前缀
    /// 行数即 RowCount；已知时按需抬高。行键为 legacy 前缀源
    /// 用 legacy:<row> 匹配。
    override DeltaResult ApplyDeltas(DeltaBatch batch) {
        if (batch == null) { return null; }
        batch.Compress();
        DeltaResult result = DeltaResult.Create();
        bool changed = false;
        for (int i = 0; i < batch.Count(); i = i + 1) {
            DeltaOp op = batch.At(i);
            string canonical = op.Key();
            int at = -1;
            for (int r = 0; r < this.cache.Count; r = r + 1) {
                if (RowKey.Legacy(r).Canonical() == canonical) { at = r; r = this.cache.Count; }
            }
            if (op.Kind() == DeltaOp.Remove) {
                if (at >= 0) {
                    this.cache.RemoveAt(at);
                    result.removed = result.removed + 1;
                    changed = true;
                }
            } else if (op.Kind() == DeltaOp.Upsert) {
                List<string> values = op.Cells();
                if (at >= 0) {
                    DataRow existing = this.cache[at];
                    for (int c = 0; c < values.Count; c = c + 1) {
                        existing.Set(c, values[c]);
                    }
                    result.updated = result.updated + 1;
                } else {
                    DataRow fresh = new DataRow();
                    for (int c = 0; c < values.Count; c = c + 1) {
                        fresh.Set(c, values[c]);
                    }
                    this.cache.Add(fresh);
                    result.inserted = result.inserted + 1;
                }
                changed = true;
            } else if (op.Kind() == DeltaOp.Cell) {
                if (at < 0) { result.missing = result.missing + 1; continue; }
                int col = -1;
                if (this.cellFieldOf != null) {
                    for (int c = 0; c < this.cache[at].Count(); c = c + 1) {
                        if (this.cellFieldOf(c) == op.Field()) { col = c; c = this.cache[at].Count(); }
                    }
                } else {
                    // 未安装查找时按"Field 是纯数字"解释为列索引。
                    bool numeric = true;
                    for (int k = 0; k < op.Field().Length; k = k + 1) {
                        int cc = (int)op.Field()[k];
                        if (cc < 48 || cc > 57) { numeric = false; k = op.Field().Length; }
                    }
                    if (numeric && op.Field().Length > 0) {
                        col = DataTable.ParseInt(op.Field());
                        if (col >= this.cache[at].Count()) { col = -1; }
                    }
                }
                if (col < 0) { result.missing = result.missing + 1; continue; }
                this.cache[at].Set(col, op.Value());
                result.cells = result.cells + 1;
                changed = true;
            }
        }
        if (changed) {
            if (this.knownTotal >= 0 && this.cache.Count > this.knownTotal) {
                this.knownTotal = this.cache.Count;
            }
            if (this.knownTotal >= 0 && this.cache.Count < this.knownTotal) {
                // 移除使前缀短于声明总数：总数跟随缓存，避免把
                // 已删除区域当作未加载。服务器有新权威总数时应
                // 显式 SetKnownTotal 覆盖。
                this.knownTotal = this.cache.Count;
            }
        }
        return result;
    }
}

/// 稀疏页服务端数据源：与旧的连续前缀 ServerDataSource 并存，
/// 允许已知总数时直接请求中间或尾部页，不把未加载区域误当成
/// 空字符串数据。每个页独立记录 Empty/Loading/Ready/Error 状态，
/// 同一时刻最多一个 in-flight 请求；generation 变化后旧响应直接丢弃。
///
/// 同步子类只需实现 FillPage；真正异步的子类重写 FetchPage，
/// 在完成路径调用 FinishPage(rows, count, total, generation)。
class SparseServerPage {
    int start;
    int count;
    int total;
    int generation;
    int state;                 // 0 empty, 1 loading, 2 ready, 3 error
    List<DataRow> rows;

    /// 构造空页（state=0），total 未知。
    SparseServerPage(int at, int gen) {
        this.start = at;
        this.count = 0;
        this.total = -1;
        this.generation = gen;
        this.state = 0;
        this.rows = new List<DataRow>();
    }

    /// 页处于 Ready 且覆盖 row 时为 true。
    bool Covers(int row) {
        return this.state == 2 && row >= this.start
            && row < this.start + this.count;
    }
}

class SparseServerDataSource : DataSource {
    int pageSize;
    int knownTotal;
    int generation;
    List<SparseServerPage> pages;
    bool loading;
    bool pageDone;
    SparseServerPage pendingPage;
    List<DataRow> pendingRows;
    int pendingCount;
    int pendingTotal;
    int pendingGeneration;
    int pendingPageId;
    int nextPageId;
    int activePageId;

    /// 以页大小创建稀疏页数据源；之后可 SetKnownTotal 固定总数。
    SparseServerDataSource(int size) { this.Setup(size); }

    /// 初始化/重置全部状态（供静态工厂式子类使用）；页大小钳制到 >=1。
    void Setup(int size) {
        this.pageSize = size;
        if (this.pageSize < 1) { this.pageSize = 1; }
        this.knownTotal = -1;
        this.generation = 1;
        this.pages = new List<SparseServerPage>();
        this.loading = false;
        this.pageDone = false;
        this.pendingPage = null;
        this.pendingRows = new List<DataRow>();
        this.pendingCount = 0;
        this.pendingTotal = -1;
        this.pendingGeneration = 0;
        this.pendingPageId = 0;
        this.nextPageId = 0;
        this.activePageId = 0;
    }

    /// 服务器总数已知时固定 RowCount，使中部/尾部可直接定位。
    /// 传 -1 恢复未知总数模式；下一次短页会重新固定尾部。
    void SetKnownTotal(int total) {
        if (total < 0) { this.knownTotal = -1; return; }
        int high = 0;
        for (int i = 0; i < this.pages.Count; i = i + 1) {
            SparseServerPage p = this.pages[i];
            if (p.state == 2 && p.start + p.count > high) {
                high = p.start + p.count;
            }
        }
        if (total < high) { total = high; }
        this.knownTotal = total;
    }

    /// 查询、schema 或服务器 revision 变化时调用。旧页和旧响应
    /// 均失效，但不会让旧 generation 的结果污染新查询。
    void Invalidate() {
        this.generation = this.generation + 1;
        this.knownTotal = -1;
        this.pages.Clear();
        this.loading = false;
        this.pageDone = false;
        this.pendingPage = null;
        this.pendingRows = new List<DataRow>();
        this.pendingCount = 0;
        this.pendingTotal = -1;
        this.pendingGeneration = 0;
        this.pendingPageId = 0;
        this.activePageId = this.activePageId + 1;
    }

    /// 当前 generation（Invalidate 递增）。
    int Generation() { return this.generation; }

    /// 总数已知时为其值，否则为已就绪页的最大尾部。
    override int RowCount() {
        if (this.knownTotal >= 0) { return this.knownTotal; }
        int high = 0;
        for (int i = 0; i < this.pages.Count; i = i + 1) {
            SparseServerPage p = this.pages[i];
            if (p.state == 2 && p.start + p.count > high) { high = p.start + p.count; }
        }
        return high;
    }

    /// 行序归服务器掌控：网格不做本地排序/筛选。
    override bool ServerControlled() { return true; }

    /// 起始行为 start 的页；不存在返回 null。
    SparseServerPage PageAt(int start) {
        for (int i = 0; i < this.pages.Count; i = i + 1) {
            if (this.pages[i].start == start) { return this.pages[i]; }
        }
        return null;
    }

    /// row 所属页（按页大小对齐），不存在则创建空页登记。
    SparseServerPage PageFor(int row) {
        int start = (row / this.pageSize) * this.pageSize;
        SparseServerPage p = this.PageAt(start);
        if (p == null) {
            p = new SparseServerPage(start, this.generation);
            this.pages.Add(p);
        }
        return p;
    }

    /// 该页在本 generation 下已就绪。
    bool IsPageReady(int start) {
        SparseServerPage p = this.PageAt(start);
        return p != null && p.state == 2 && p.generation == this.generation;
    }

    /// row 所在页已就绪且属于当前 generation。
    override bool CellReady(int row, int col) {
        if (row < 0) { return false; }
        int start = (row / this.pageSize) * this.pageSize;
        SparseServerPage p = this.PageAt(start);
        return p != null && p.Covers(row) && p.generation == this.generation;
    }

    /// 总数未知时为 true；已知时只要存在未就绪或过期的页就为
    /// true，全部页就绪为 false。
    override bool HasMore() {
        if (this.knownTotal < 0) { return true; }
        if (this.knownTotal == 0) { return false; }
        int pageCount = (this.knownTotal + this.pageSize - 1) / this.pageSize;
        for (int page = 0; page < pageCount; page = page + 1) {
            int start = page * this.pageSize;
            SparseServerPage p = this.PageAt(start);
            if (p == null || p.generation != this.generation || p.state != 2) {
                return true;
            }
        }
        return false;
    }

    /// 请求 row 所属页：页已就绪/加载中、总数已知且越界、或有请求
    /// 在途时忽略；否则启动该页获取。
    override void RequestBlock(int row) {
        if (row < 0) { return; }
        if (this.knownTotal >= 0 && row >= this.knownTotal) { return; }
        if (this.loading) { return; }
        SparseServerPage p = this.PageFor(row);
        if (p.state == 2 || p.state == 1) { return; }
        this.StartPage(p);
    }

    /// 将页置为 Loading 并发起获取，登记 generation 与页 nonce。
    void StartPage(SparseServerPage p) {
        p.state = 1;
        p.generation = this.generation;
        this.loading = true;
        this.pageDone = false;
        this.pendingPage = p;
        this.pendingRows = new List<DataRow>();
        this.pendingCount = 0;
        this.pendingTotal = -1;
        this.pendingGeneration = this.generation;
        this.nextPageId = this.nextPageId + 1;
        this.activePageId = this.nextPageId;
        this.pendingPageId = this.activePageId;
        this.FetchPage(p.start, this.pageSize, this.generation, this.activePageId);
    }

    /// 找到第一个未就绪/过期的页发起获取：总数已知时按页序扫描，
    /// 未知时从已就绪连续前缀的末端继续；无缺口时不请求。
    override void RequestNextBlock() {
        if (this.loading) { return; }
        int start = 0;
        if (this.knownTotal >= 0) {
            int pageCount = (this.knownTotal + this.pageSize - 1) / this.pageSize;
            for (int page = 0; page < pageCount; page = page + 1) {
                int candidate = page * this.pageSize;
                SparseServerPage p = this.PageAt(candidate);
                if (p == null || p.state != 2 || p.generation != this.generation) {
                    start = candidate;
                    break;
                }
                start = this.knownTotal;
            }
            if (start >= this.knownTotal) { return; }
        } else {
            int high = this.RowCount();
            start = 0;
            while (start < high) {
                SparseServerPage p = this.PageAt(start);
                if (p == null || p.state != 2 || p.generation != this.generation) {
                    break;
                }
                start = start + this.pageSize;
            }
        }
        SparseServerPage next = this.PageFor(start);
        if (next.state != 2 && next.state != 1) { this.StartPage(next); }
    }

    /// 每帧并入完成的页结果：nonce/generation 匹配时校验行数
    /// （总数已知时要求恰好填满本页剩余量），合法则入页，非法置
    /// Error；旧代结果被静默丢弃。返回是否处理了当前请求。
    override bool Poll() {
        if (!this.loading || !this.pageDone) { return false; }
        this.loading = false;
        this.pageDone = false;
        SparseServerPage p = this.pendingPage;
        bool current = p != null && this.pendingPageId == this.activePageId
            && this.pendingGeneration == this.generation
            && p.generation == this.generation;
        if (current) {
            int expected = -1;
            int resultTotal = this.pendingTotal;
            if (this.knownTotal >= 0) { resultTotal = this.knownTotal; }
            if (resultTotal >= 0) {
                expected = resultTotal - p.start;
                if (expected > this.pageSize) { expected = this.pageSize; }
            }
            bool valid = this.pendingCount >= 0
                && this.pendingCount <= this.pendingRows.Count
                && this.pendingCount <= this.pageSize;
            if (expected >= 0 && this.pendingCount != expected) { valid = false; }
            if (!valid) { p.state = 3; }
            else {
                p.rows = this.pendingRows;
                p.count = this.pendingCount;
                p.total = this.pendingTotal;
                p.state = 2;
                if (p.total >= 0) {
                    int total = p.total;
                    if (total < p.start + p.count) { total = p.start + p.count; }
                    this.SetKnownTotal(total);
                } else if (this.knownTotal < 0 && p.count < this.pageSize) {
                    this.SetKnownTotal(p.start + p.count);
                }
            }
        }
        this.pendingPage = null;
        this.pendingRows = new List<DataRow>();
        this.pendingCount = 0;
        this.pendingTotal = -1;
        this.pendingGeneration = 0;
        return current;
    }

    /// 同步扩展点：调用 FillPage 并立即 FinishPage；异步子类重写
    /// 它启动后台获取。
    virtual void FetchPage(int start, int count, int gen) {
        int n = this.FillPage(start, count, this.pendingRows);
        this.FinishPage(this.pendingRows, n, -1, gen, this.activePageId);
    }

    /// 带 nonce 的重载；基类忽略 nonce 直接委托。
    virtual void FetchPage(int start, int count, int gen, int pageId) {
        this.FetchPage(start, count, gen);
    }

    /// 异步完成页请求。pageId 与 generation 都必须匹配当前请求；
    /// 旧的同 generation 回调也因此不能覆盖新页。
    /// FinishPage 的四参便捷重载，nonce 取当前活动请求。
    void FinishPage(List<DataRow> rows, int count, int total, int gen) {
        this.FinishPage(rows, count, total, gen, this.activePageId);
    }

    /// 异步完成入口：nonce/generation 必须匹配当前请求，否则丢弃；
    /// rows 为 null 或 count 越界记为非法（Poll 判为 Error）。
    void FinishPage(List<DataRow> rows, int count, int total, int gen, int pageId) {
        if (!this.loading || this.pageDone || gen != this.generation
            || pageId != this.activePageId) { return; }
        if (rows == null) {
            this.pendingRows = new List<DataRow>();
            this.pendingCount = -1;
        } else {
            this.pendingRows = rows;
            if (count < 0 || count > rows.Count || count > this.pageSize) {
                this.pendingCount = -1;
            } else { this.pendingCount = count; }
        }
        this.pendingTotal = total;
        this.pendingGeneration = gen;
        this.pendingPageId = pageId;
        this.pageDone = true;
    }

    /// 从 start 取最多 count 行追加到 dst，返回实际行数；少于 count
    /// 视为尾页（未知总数模式下由此固定总数）。同步子类只需实现此方法。
    virtual int FillPage(int start, int count, List<DataRow> dst) { return 0; }

    /// 覆盖 row 且属于当前 generation 的就绪页；没有返回 null。
    SparseServerPage ReadyPage(int row) {
        for (int i = 0; i < this.pages.Count; i = i + 1) {
            if (this.pages[i].Covers(row) && this.pages[i].generation == this.generation) {
                return this.pages[i];
            }
        }
        return null;
    }

    /// 就绪页内的单元格文本；未加载/过期行为空串。
    override string CellText(int row, int col) {
        SparseServerPage p = this.ReadyPage(row);
        if (p == null) { return ""; }
        return p.rows[row - p.start].At(col);
    }

    /// 就绪页单元格的整数解读（ParseInt）。
    override int CellNum(int row, int col) { return DataTable.ParseInt(this.CellText(row, col)); }
    /// 就绪页单元格的实数解读（ParseReal）。
    override double CellReal(int row, int col) { return DataTable.ParseReal(this.CellText(row, col)); }
    /// 就绪页单元格的日期解读（ParseDate，order 为列的日期字段顺序）。
    override int CellDay(int row, int col, int order) {
        return DataTable.ParseDate(this.CellText(row, col), order);
    }
    /// 就绪页单元格的布尔解读（ParseBool）。
    override bool CellBool(int row, int col) { return DataTable.ParseBool(this.CellText(row, col)); }

    /// 写就绪页内的单元格；未就绪为空操作。
    override void SetCell(int row, int col, string v) {
        SparseServerPage p = this.ReadyPage(row);
        if (p != null) { p.rows[row - p.start].Set(col, v); }
    }
}
