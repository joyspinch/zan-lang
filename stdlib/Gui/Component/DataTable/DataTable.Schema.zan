using System;

namespace Gui.Component.DataTable;

/// DataTable 列的稳定身份和类型描述。DataColumn 仍是现有渲染/编辑
/// 配置的兼容入口；SchemaColumn 用于新查询、缓存和扩展能力。
class SchemaColumn {
    string id;
    string field;
    int valueType;
    string rendererId;
    string editorId;
    bool nullable;

    /// 构造列描述：渲染器/编辑器默认 "text"，默认可空。
    SchemaColumn(string columnId, string fieldName, int kind) {
        this.id = columnId;
        this.field = fieldName;
        this.valueType = kind;
        this.rendererId = "text";
        this.editorId = "text";
        this.nullable = true;
    }

    /// 列稳定标识。
    string Id() { return this.id; }
    /// 数据字段名（cell 增量按名寻址）。
    string Field() { return this.field; }
    /// 值类型，按 TableValue 的 kind 编号（0 null、1 text、2 int、3 real、4 bool、5 day）。
    int ValueType() { return this.valueType; }
    /// 列是否允许空值。
    bool Nullable() { return this.nullable; }
}

/// 类型化查询/编辑值的最小兼容表示。
/// kind: 0 null, 1 text, 2 int, 3 real, 4 bool, 5 day。
class TableValue {
    int kind;
    string text;
    int integer;
    double real;
    bool truth;

    /// kind=0 的空值，其余字段取零值。
    static TableValue Null() {
        TableValue v = new TableValue();
        v.kind = 0; v.text = ""; v.integer = 0; v.real = 0.0; v.truth = false;
        return v;
    }
    /// kind=1 的文本值。
    static TableValue Text(string s) {
        TableValue v = TableValue.Null();
        v.kind = 1; v.text = s; return v;
    }
    /// kind=2 的整数值。
    static TableValue Int(int n) {
        TableValue v = TableValue.Null();
        v.kind = 2; v.integer = n; return v;
    }
    /// kind=3 的实数值。
    static TableValue Real(double n) {
        TableValue v = TableValue.Null();
        v.kind = 3; v.real = n; return v;
    }
    /// kind=4 的布尔值。
    static TableValue Bool(bool b) {
        TableValue v = TableValue.Null();
        v.kind = 4; v.truth = b; return v;
    }
    /// kind=5 的日期值，integer 存日号（自 1970-01-01 起）。
    static TableValue Day(int n) {
        TableValue v = TableValue.Null();
        v.kind = 5; v.integer = n; return v;
    }

    /// 值类型 kind（0 null、1 text、2 int、3 real、4 bool、5 day）。
    int Kind() { return this.kind; }
    /// 文本字段（kind=1 有效）。
    string AsText() { return this.text; }
    /// 整数字段（kind=2/5 有效）。
    int AsInt() { return this.integer; }
    /// 实数字段（kind=3 有效）。
    double AsReal() { return this.real; }
    /// 布尔字段（kind=4 有效）。
    bool AsBool() { return this.truth; }
}
