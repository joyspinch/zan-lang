using System;

namespace Gui.Component.DataTable;

/// 计算列（Formula）分部：表达式解析与逐行求值。
///
/// `DataColumn.formula` 非空的列不读数据源：每个单元格的值
/// 是对表达式求值的结果。语法（单遍递归下降，运算优先级
/// 与 C 一致）：
///
/// ```text
/// expr    := term (('+' | '-') term)*
/// term    := unary (('*' | '/') unary)*
/// unary   := '-' unary | primary
/// primary := 数字 | 函数调用 | '(' expr ')' | 列引用
/// ```
///
/// - 数字：十进制字面量；一元负号由 unary 层处理；
/// - 函数：`min(a,b,...)`、`max(a,b,...)`（变参）、
///   `abs/round/floor/ceil/sqrt(x)`，`round` 可带第二参数
///   指定小数位；sqrt 用 Newton 迭代（运行时无 Math.Sqrt）；
/// - 列引用：裸标识符，先按 `field` 名解析，回退按 `title`；
///   嵌套公式列被引用时读到的是其**源数据**（未计算的），
///   因此跨公式引用应指向普通列；
/// - 括号深度上限 32，超出视为畸形。
///
/// 语义全部 fail-soft（商业网格惯例：公式列不抛异常、
/// 不打断渲染）：
/// - 解析（与行无关）：未知列名、未知函数、畸形表达式、
///   尾随垃圾 → 整列显示空；
/// - 求值（逐行）：除以 0 → 该行显示空。
///
/// 实现是两段式：构建/列变更时把表达式解析成逆波兰
/// token 序列（`FormulaExpr`），此后每行求值只是一次
/// 纯栈运算——不重复做名字查找与语法分析，O(rows ×
/// tokens)。
partial class DataTable {
    // ---------- Formula 解析 ----------

    // 逆波兰 token：0 数字，1 列引用，2 +，3 -，4 *，5 /，
    // 6 一元负号，7 min，8 max，9 abs，10 round，11 floor，
    // 12 ceil，13 sqrt。
    class FormulaExpr {
        public List<int> ops;
        public List<double> nums;
        public List<int> colIdx;
        // 变参函数的实参个数（min/max）；其余函数不使用。
        public List<int> argc;
        public bool err;

        public FormulaExpr(string src, List<DataColumn> cols) {
            this.ops = new List<int>();
            this.nums = new List<double>();
            this.colIdx = new List<int>();
            this.argc = new List<int>();
            this.err = false;
            this.Compile(src, cols);
        }

        // ---- 编译：递归下降 → 逆波兰 ----

        string src;
        int pos;
        int depth;
        List<DataColumn> cols;

        void Fail() {
            this.err = true;
            this.ops.Clear();
            this.nums.Clear();
            this.colIdx.Clear();
            this.argc.Clear();
        }

        // 每个 token 在四个平行数组里各占一格：运算符的
        // nums/colIdx/argc 只是占位 0，保证 ops[i] 与其余
        // 数组同索引对齐。
        void Emit(int op) {
            this.ops.Add(op);
            this.nums.Add(0.0);
            this.colIdx.Add(0);
            this.argc.Add(0);
        }

        void Compile(string src, List<DataColumn> cols) {
            this.src = src;
            this.pos = 0;
            this.depth = 0;
            this.cols = cols;
            this.ParseExpr();
            if (this.err) { return; }
            this.SkipWs();
            if (this.pos < this.src.Length) { this.Fail(); }
        }

        void SkipWs() {
            while (this.pos < this.src.Length) {
                int c = (int)this.src[this.pos];
                if (c != 32 && c != 9) { break; }
                this.pos = this.pos + 1;
            }
        }

        void ParseExpr() {
            this.ParseTerm();
            while (!this.err) {
                this.SkipWs();
                if (this.pos >= this.src.Length) { break; }
                int c = (int)this.src[this.pos];
                if (c != 43 && c != 45) { break; }
                this.pos = this.pos + 1;
                this.ParseTerm();
                if (this.err) { break; }
                this.Emit(c == 43 ? 2 : 3);
            }
        }

        void ParseTerm() {
            this.ParseUnary();
            while (!this.err) {
                this.SkipWs();
                if (this.pos >= this.src.Length) { break; }
                int c = (int)this.src[this.pos];
                if (c != 42 && c != 47) { break; }
                this.pos = this.pos + 1;
                this.ParseUnary();
                if (this.err) { break; }
                this.Emit(c == 42 ? 4 : 5);
            }
        }

        void ParseUnary() {
            this.SkipWs();
            if (this.pos < this.src.Length && (int)this.src[this.pos] == 45) {
                this.pos = this.pos + 1;
                this.ParseUnary();
                if (this.err) { return; }
                this.Emit(6);
                return;
            }
            this.ParsePrimary();
        }

        void ParsePrimary() {
            this.SkipWs();
            if (this.pos >= this.src.Length) { this.Fail(); return; }
            int c = (int)this.src[this.pos];
            // 括号子表达式
            if (c == 40) {
                this.pos = this.pos + 1;
                if (this.depth >= 32) { this.Fail(); return; }
                this.depth = this.depth + 1;
                this.ParseExpr();
                this.depth = this.depth - 1;
                if (this.err) { return; }
                this.SkipWs();
                if (this.pos < this.src.Length && (int)this.src[this.pos] == 41) {
                    this.pos = this.pos + 1;
                    return;
                }
                this.Fail();
                return;
            }
            // 数字字面量
            if ((c >= 48 && c <= 57) || c == 46) {
                int start = this.pos;
                while (this.pos < this.src.Length) {
                    int d = (int)this.src[this.pos];
                    if (d < 48 || d > 57) { break; }
                    this.pos = this.pos + 1;
                }
                if (this.pos < this.src.Length && (int)this.src[this.pos] == 46) {
                    this.pos = this.pos + 1;
                    while (this.pos < this.src.Length) {
                        int d = (int)this.src[this.pos];
                        if (d < 48 || d > 57) { break; }
                        this.pos = this.pos + 1;
                    }
                }
                this.Emit(0);
                this.nums[this.nums.Count - 1] = DataTable.ParseReal(this.src.Substring(start, this.pos - start));
                return;
            }
            // 标识符：函数调用或列引用
            if ((c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95) {
                int start = this.pos;
                while (this.pos < this.src.Length) {
                    int d = (int)this.src[this.pos];
                    bool alnum = (d >= 48 && d <= 57) || (d >= 65 && d <= 90) || (d >= 97 && d <= 122) || d == 95;
                    if (!alnum) { break; }
                    this.pos = this.pos + 1;
                }
                string ident = this.src.Substring(start, this.pos - start);
                int save = this.pos;
                this.SkipWs();
                if (this.pos < this.src.Length && (int)this.src[this.pos] == 40) {
                    this.pos = this.pos + 1;
                    string fn = DataTable.LowerAscii(ident);
                    this.SkipWs();
                    // 零实参调用：仅 min/max 有意义地失败，其他函数
                    // 在求值层统一检查实参个数。
                    if (this.pos < this.src.Length && (int)this.src[this.pos] == 41) {
                        this.pos = this.pos + 1;
                        this.PushFunc(fn, 0);
                        return;
                    }
                    int count = 0;
                    while (!this.err) {
                        this.ParseExpr();
                        if (this.err) { break; }
                        count = count + 1;
                        this.SkipWs();
                        if (this.pos < this.src.Length && (int)this.src[this.pos] == 44) {
                            this.pos = this.pos + 1;
                        } else {
                            if (this.pos < this.src.Length && (int)this.src[this.pos] == 41) {
                                this.pos = this.pos + 1;
                            } else { this.Fail(); }
                            break;
                        }
                    }
                    if (this.err) { return; }
                    this.PushFunc(fn, count);
                    return;
                }
                this.pos = save;
                // 列引用：先按 field 名，回退按 title。
                int ci = DataTable.Col(this.cols, ident);
                if (ci < 0) {
                    for (int k = 0; k < this.cols.Count; k = k + 1) {
                        if (this.cols[k].title == ident) { ci = k; break; }
                    }
                }
                if (ci < 0) { this.Fail(); return; }
                this.Emit(1);
                this.colIdx[this.colIdx.Count - 1] = ci;
                return;
            }
            this.Fail();
        }
        // 函数的逆波兰约定：先依次求值全部实参，然后函数 token
        // 弹出 argc 个操作数。这里把函数 token 压在实参之后输出，
        // 并记录实参个数（min/max 变参需要；固定元数函数求值层
        // 自行检查栈深）。
        void PushFunc(string fn, int count) {
            int op = 0;
            if (fn == "min") { op = 7; }
            else if (fn == "max") { op = 8; }
            else if (fn == "abs") { op = 9; }
            else if (fn == "round") { op = 10; }
            else if (fn == "floor") { op = 11; }
            else if (fn == "ceil") { op = 12; }
            else if (fn == "sqrt") { op = 13; }
            else { this.Fail(); return; }
            // 实参个数合法性：min/max ≥1；其余恰为 1（round 可 +1）。
            if (op == 7 || op == 8) {
                if (count < 1) { this.Fail(); return; }
            } else if (op == 10) {
                if (count < 1 || count > 2) { this.Fail(); return; }
            } else {
                if (count != 1) { this.Fail(); return; }
            }
            this.Emit(op);
            this.argc[this.argc.Count - 1] = count;
        }
    }

    // ---------- Formula 求值 ----------

    // 对编译好的表达式按行求值。返回 false 表示该行结果
    // 无效（除以 0），调用方渲染空文本。解析已失败的表达式
    // 由 FormulaExprOf 缓存为 null，不会进入这里。
    static bool FormulaEval(FormulaExpr e, DataSource src, int row, out double value) {
        value = 0.0;
        if (e == null || e.err) { return false; }
        List<double> st = new List<double>();
        int n = e.ops.Count;
        for (int i = 0; i < n; i = i + 1) {
            int op = e.ops[i];
            if (op == 0) { st.Add(e.nums[i]); }
            else if (op == 1) { st.Add(src.CellReal(row, e.colIdx[i])); }
            else if (op == 2 || op == 3 || op == 4 || op == 5) {
                if (st.Count < 2) { return false; }
                double b = st[st.Count - 1];
                double a = st[st.Count - 2];
                st.RemoveAt(st.Count - 1);
                st.RemoveAt(st.Count - 1);
                if (op == 2) { st.Add(a + b); }
                else if (op == 3) { st.Add(a - b); }
                else if (op == 4) { st.Add(a * b); }
                else {
                    // 除以 0：该行公式无效（fail-soft 显示空）。
                    if (b == 0.0) { return false; }
                    st.Add(a / b);
                }
            }
            else if (op == 6) {
                if (st.Count < 1) { return false; }
                int last = st.Count - 1;
                st[last] = 0.0 - st[last];
            }
            else {
                int argc = e.argc[i];
                if (st.Count < argc) { return false; }
                int base2 = st.Count - argc;
                double v = 0.0;
                if (op == 7) {
                    v = st[base2];
                    for (int k = 1; k < argc; k = k + 1) { if (st[base2 + k] < v) { v = st[base2 + k]; } }
                } else if (op == 8) {
                    v = st[base2];
                    for (int k = 1; k < argc; k = k + 1) { if (st[base2 + k] > v) { v = st[base2 + k]; } }
                } else if (op == 9) {
                    v = st[base2];
                    if (v < 0.0) { v = 0.0 - v; }
                } else if (op == 10) {
                    // round(x) / round(x, digits)
                    int digits = 0;
                    if (argc == 2) {
                        digits = (int)st[base2 + 1];
                        if (digits < 0) { digits = 0; }
                        if (digits > 10) { digits = 10; }
                    }
                    double m = DataTable.Pow10(digits);
                    double scaled = st[base2] * m;
                    if (scaled >= 0.0) { v = (double)((long)(scaled + 0.5)) / m; }
                    else { v = 0.0 - (double)((long)(0.0 - scaled + 0.5)) / m; }
                } else if (op == 11) {
                    double x = st[base2];
                    if (x >= 0.0 || x == (double)((long)x)) { v = (double)((long)x); }
                    else { v = 0.0 - (double)((long)(0.0 - x)) - 1.0; }
                } else if (op == 12) {
                    double x = st[base2];
                    if (x <= 0.0 || x == (double)((long)x)) { v = (double)((long)x); }
                    else { v = (double)((long)x) + 1.0; }
                } else if (op == 13) {
                    double x = st[base2];
                    if (x < 0.0) { return false; }
                    if (x == 0.0) { v = 0.0; }
                    else {
                        // Newton 迭代（运行时无 Math.Sqrt）。
                        double g = x;
                        for (int it = 0; it < 60; it = it + 1) {
                            double next = 0.5 * (g + x / g);
                            double d2 = next - g;
                            if (d2 < 0.0) { d2 = 0.0 - d2; }
                            if (d2 <= g * 1e-12) { g = next; break; }
                            g = next;
                        }
                        v = g;
                    }
                } else {
                    return false;
                }
                // 先弹出全部实参再压入结果（RemoveAt 自高向低）。
                for (int k = 0; k < argc; k = k + 1) { st.RemoveAt(st.Count - 1); }
                st.Add(v);
            }
        }
        if (st.Count != 1) { return false; }
        value = st[0];
        return true;
    }

    // ---------- Formula 路由入口 ----------

    // 列是否为计算列。
    static bool IsFormula(List<DataColumn> cols, int col) {
        if (col < 0 || col >= cols.Count) { return false; }
        return cols[col].formula.Length > 0;
    }

    // 计算列在 `row` 行的显示文本。非计算列返回 null（调用方
    // 回落普通读取路径）；计算列求值失败（畸形表达式、除以
    // 0、负数开方）返回 ""——fail-soft，绝不打断渲染。
    static string FormulaText(List<DataColumn> cols, DataSource src, int row, int col) {
        if (!DataTable.IsFormula(cols, col)) { return null; }
        FormulaExpr e = DataTable.FormulaExprOf(cols, col);
        if (e == null) { return ""; }
        double v;
        if (!DataTable.FormulaEval(e, src, row, out v)) { return ""; }
        return DataTable.FormatCell(cols[col], DataTable.FormatReal(v, cols[col].decimals));
    }

    // 计算列在 `row` 行的实数值。非计算列返回 false。
    static bool FormulaTryReal(List<DataColumn> cols, DataSource src, int row, int col, out double v) {
        v = 0.0;
        if (!DataTable.IsFormula(cols, col)) { return false; }
        FormulaExpr e = DataTable.FormulaExprOf(cols, col);
        if (e == null) { return false; }
        return DataTable.FormulaEval(e, src, row, out v);
    }

    // 每列表达式编译缓存。表达式对象不可变，列列表或表达式
    // 字符串变更时由 InvalidateFormulaCache 整体作废。
    static FormulaCacheEntry sFormulaCache;

    static FormulaExpr FormulaExprOf(List<DataColumn> cols, int col) {
        FormulaCacheEntry entry = DataTable.sFormulaCache;
        if (entry != null && entry.cols == cols && entry.exprs.Count == cols.Count) {
            return entry.exprs[col];
        }
        entry = new FormulaCacheEntry();
        entry.cols = cols;
        entry.exprs = new List<FormulaExpr>();
        for (int i = 0; i < cols.Count; i = i + 1) {
            DataColumn c = cols[i];
            if (c.formula.Length > 0) {
                entry.exprs.Add(new FormulaExpr(c.formula, cols));
            } else {
                entry.exprs.Add(null);
            }
        }
        DataTable.sFormulaCache = entry;
        return entry.exprs[col];
    }

    // 修改任意列的 formula 字段后调用：整体作废编译缓存。
    // FormulaText/FormulaTryReal 在下一次调用时重新编译。
    static void InvalidateFormulaCache() {
        DataTable.sFormulaCache = null;
    }
}

/// 表达式编译缓存的载体：一组列的编译结果。
class FormulaCacheEntry {
    public List<DataColumn> cols;
    public List<DataTable.FormulaExpr> exprs;
}
