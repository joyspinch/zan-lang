using System;
using Gui;
using Gui.Widget;
using Gui.Backend;

namespace Gui.Component.DataTable;

/// DataTable 模块：列选择器（Column Chooser）——
/// DevExpress/ag-Grid 风格的勾选列表弹层。勾选控制各列
/// 显隐（复用 HideField/ShowAllColumns 的 colHidden 状态，
/// 与右键菜单的隐藏条目、布局持久化天然一致），搜索框按
/// 标题实时过滤，行内 ←/→ 按钮在可见顺序中前移/后移
/// （复用 MoveColumn）。纯数据部分（ChooserOrder/
/// ChooserToggle/ChooserMove）可脱离渲染独立测试。
partial class DataTable {
    // ---------- 程序化 API ----------

    /// 打开/关闭列选择器弹层。打开时重置搜索与滚动，
    /// 使每次展开都从完整列表开始。
    static void SetColumnChooser(DataTableState st, bool open) {
        st.colChooserOpen = open;
        st.colChooserSearch = "";
        st.colChooserScroll = 0;
    }

    /// 列选择器弹层当前是否打开。
    static bool IsColumnChooserOpen(DataTableState st) {
        return st.colChooserOpen;
    }

    // ---------- 纯数据辅助（测试面） ----------

    /// 选择器列表的行序：用户列顺序（st.colOrder）在前、
    /// 未登记的列按声明序在后（与 VisibleOrder 的 seq 推导
    /// 一致，但不过滤隐藏列——隐藏列正是列表的主角）。
    /// 过滤掉搜索框匹配不到的列。
    static List<int> ChooserOrder(DataTableState st, List<DataColumn> cols) {
        List<int> seq = new List<int>();
        for (int s = 0; s < st.colOrder.Count; s = s + 1) {
            int ci = st.colOrder[s];
            if (ci >= 0 && ci < cols.Count && seq.IndexOf(ci) < 0) { seq.Add(ci); }
        }
        for (int a = 0; a < cols.Count; a = a + 1) {
            if (seq.IndexOf(a) < 0) { seq.Add(a); }
        }
        if (st.colChooserSearch.Length == 0) { return seq; }
        List<int> outp = new List<int>();
        for (int i = 0; i < seq.Count; i = i + 1) {
            if (DataTable.ContainsCI(cols[seq[i]].title, st.colChooserSearch)) {
                outp.Add(seq[i]);
            }
        }
        return outp;
    }

    /// 勾选/取消第 `col` 列（勾选 = 可见）。与
    /// HideField 落在同一份 st.colHidden 上。
    static void ChooserToggle(DataTableState st, List<DataColumn> cols, int col, bool visible) {
        DataTable.HideField(st, cols, cols[col].field, !visible);
    }

    /// 在可见顺序中把第 `col` 列前移/后移一位。邻位取
    /// 自 ChooserOrder 的全序列（不受搜索框过滤影响，
    /// 拖动芯片拖到哪就是哪），冻结/分组列的实际首屏
    /// 位置仍由 VisibleOrder 决定。
    ///
    /// 直接在完整序列上换位后整体重写 colOrder：
    /// MoveColumn 只在 colOrder 内寻位，目标列未登记时
    /// "插到它之前"会退化成"追加到末尾"，无法表达
    /// 未登记区段内的移动。
    static void ChooserMove(DataTableState st, List<DataColumn> cols, int col, bool left) {
        List<int> seq = new List<int>();
        for (int s = 0; s < st.colOrder.Count; s = s + 1) {
            int ci = st.colOrder[s];
            if (ci >= 0 && ci < cols.Count && seq.IndexOf(ci) < 0) { seq.Add(ci); }
        }
        for (int a = 0; a < cols.Count; a = a + 1) {
            if (seq.IndexOf(a) < 0) { seq.Add(a); }
        }
        int pos = seq.IndexOf(col);
        if (pos < 0) { return; }
        int swap = -1;
        if (left) {
            if (pos == 0) { return; }
            swap = pos - 1;
        } else {
            if (pos == seq.Count - 1) { return; }
            swap = pos + 1;
        }
        seq[pos] = seq[swap];
        seq[swap] = col;
        // colOrder 只需保留"非默认前缀"：从尾部剥掉恰好
        // 按声明序收尾的部分，余下全部登记。VisibleOrder/
        // ChooserOrder 会把未登记的列补回声明位，因此剥掉
        // 的尾段语义不变。
        int last = cols.Count - 1;
        while (seq.Count > 0 && seq[seq.Count - 1] == last) {
            seq.RemoveAt(seq.Count - 1);
            last = last - 1;
        }
        st.colOrder = seq;
        DataTable.InvalidateView(st);
    }

    // ---------- 弹层渲染 ----------

    // 列表行的三段布局：勾选框 + 标题 + 排序按钮。
    static int ChooserRowH(App app) {
        return app.Scale(26);
    }

    static void RenderColumnChooser(App app, int x, int y, int viewW, int viewH,
                                    List<DataColumn> cols, DataSource src, DataTableState st) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        StyleBox sMenu = Style.Part(app, "datatable", "menu", "", "", "",
                                    Style.SNormal());
        StyleBox sGrid = Style.Part(app, "datatable", "grid", "", "", "",
                                    Style.SNormal());
        StyleBox sHint = Style.Part(app, "datatable", "hint", "", "", "",
                                    Style.SNormal());
        StyleBox sRowHover = Style.Part(app, "datatable", "row", "", "", "",
                                        Style.SHover());
        int pad = app.Scale(10);
        int fs = Style.FontFallback(app, "small");
        int rowH = DataTable.ChooserRowH(app);
        int menuW = app.Scale(244);
        int boxH = app.Scale(26);
        int footerH = app.Scale(40);
        int listH = app.Scale(232);
        int menuH = app.Scale(8) + boxH + app.Scale(6) + listH + app.Scale(6) + footerH + app.Scale(8);

        // 锚定在网格右上角，整体限制在窗口内。
        int mx = x + viewW - menuW - app.Scale(4);
        int my = y + app.Scale(4);
        if (mx + menuW > x + viewW) { mx = x + viewW - menuW; }
        if (mx < x) { mx = x; }
        int canH = c.Height();
        if (my + menuH > canH) { my = canH - menuH - app.Scale(6); }
        if (my < app.titlebarH) { my = app.titlebarH; }

        // 接管弹层上的滚轮，吞掉整个面板的点击，
        // 空白区域不穿透到下层页面。
        app.CaptureWheel(mx, my, menuW, menuH);
        app.BlockHitsRect(mx, my, menuW, menuH);
        c.FillRoundRect(mx, my, menuW, menuH, t.borderRadiusMedium, sMenu.BgOr(0));
        c.DrawRoundRect(mx, my, menuW, menuH, t.borderRadiusMedium, sMenu.BorderOr(0), 1);

        int cy = my + app.Scale(8);

        // 搜索框：按列标题实时过滤（缓存于 colChooserSearch，
        // 变化时由 ChooserOrder 重新过滤）。
        DataTable.EditBox(app, mx + pad, cy, menuW - pad * 2, boxH, st.colChooserSearch,
                          "Search columns...", true);
        int sId = app.focus.AllocId();
        app.hitTester.RegisterRect(sId, mx + pad, cy, menuW - pad * 2, boxH, 0);
        if (app.EventKind() == 3 && app.hitTester.HitTest(app.mouseX, app.mouseY) == sId) {
            app.RequestRedraw();
        }
        if (app.EventKind() == 6) {
            int chv = app.window.EventKeyCode();
            if (chv == 8) { st.colChooserSearch = DataTable.Backspace(st.colChooserSearch); }
            else if (chv == 27) { st.colChooserOpen = false; }
            else {
                string ad = Text.CharStr(chv);
                if (ad.Length > 0) { st.colChooserSearch = st.colChooserSearch + ad; }
            }
            app.RequestRedraw();
        }
        cy = cy + boxH + app.Scale(6);

        // 虚拟化勾选列表（行序 = ChooserOrder）。
        List<int> rows = DataTable.ChooserOrder(st, cols);
        int listTop = cy;
        int visN = listH / rowH;
        if (visN < 1) { visN = 1; }
        int maxScroll = rows.Count - visN;
        if (maxScroll < 0) { maxScroll = 0; }
        if (st.colChooserScroll > maxScroll) { st.colChooserScroll = maxScroll; }
        if (st.colChooserScroll < 0) { st.colChooserScroll = 0; }

        int itemW = menuW - pad * 2 - app.Scale(10);
        for (int r2 = 0; r2 < visN && (st.colChooserScroll + r2) < rows.Count; r2 = r2 + 1) {
            int col = rows[st.colChooserScroll + r2];
            int vId = app.focus.AllocId();
            if (app.focus.IsHovered(vId)) { c.FillRect(mx + pad, cy, itemW, rowH, sRowHover.BgOr(0)); }
            bool visible = !(col < st.colHidden.Count && st.colHidden[col]);
            DataTable.DrawMiniCheck(app, mx + pad, cy, rowH, visible);
            string label = DataTable.Truncate(cols[col].title, fs, itemW - app.Scale(66));
            c.DrawText(mx + pad + app.Scale(22), Canvas.CenterTextY(cy, rowH, fs),
                       label, sMenu.FgOr(0), fs);
            app.hitTester.RegisterRect(vId, mx + pad, cy, itemW, rowH, 0);
            if (app.EventKind() == 3 && app.hitTester.HitTest(app.mouseX, app.mouseY) == vId) {
                DataTable.ChooserToggle(st, cols, col, !visible);
                st.ColumnResize.Raise();
                app.RequestRedraw();
            }
            // 行内排序按钮：← 前移一位、→ 后移一位。
            int abW = app.Scale(18);
            int abH = app.Scale(18);
            int abY = cy + (rowH - abH) / 2;
            int lx = mx + pad + itemW - abW * 2 - app.Scale(4);
            int rxp = mx + pad + itemW - abW;
            int[] abX = new int[2];
            abX[0] = lx;
            abX[1] = rxp;
            string[] abGlyph = new string[2];
            abGlyph[0] = "chevron-left";
            abGlyph[1] = "chevron-right";
            bool[] abDir = new bool[2];
            abDir[0] = true;
            abDir[1] = false;
            for (int ab = 0; ab < 2; ab = ab + 1) {
                int abId = app.focus.AllocId();
                if (app.focus.IsHovered(abId)) {
                    c.FillRoundRect(abX[ab], abY, abW, abH, app.Scale(4), sRowHover.BgOr(0));
                }
                c.DrawGlyphIn(abGlyph[ab], abX[ab], abY, abW, abH, app.Scale(11), sMenu.FgOr(0));
                app.hitTester.RegisterRect(abId, abX[ab], abY, abW, abH, 0);
                if (app.EventKind() == 3 && app.hitTester.HitTest(app.mouseX, app.mouseY) == abId) {
                    DataTable.ChooserMove(st, cols, col, abDir[ab]);
                    st.ColumnResize.Raise();
                    app.RequestRedraw();
                }
            }
            cy = cy + rowH;
        }

        // 虚拟化列表的可拖拽滚动条。
        if (rows.Count > visN) {
            int trackH = visN * rowH;
            SignalInt vsPx = new SignalInt(st.colChooserScroll * rowH);
            Scrollbar.RenderVerticalScroll(app, mx + pad + itemW + app.Scale(3),
                listTop, trackH, rows.Count * rowH, trackH, vsPx);
            int nvs = vsPx.Get() / rowH;
            if (nvs > maxScroll) { nvs = maxScroll; }
            if (nvs < 0) { nvs = 0; }
            if (nvs != st.colChooserScroll) { st.colChooserScroll = nvs; app.RequestRedraw(); }
        }
        cy = listTop + listH + app.Scale(6);

        // 页脚：全显 + 关闭。全显走 ShowAllColumns，
        // 与右键菜单的"显示所有列"同一落点。
        c.FillRect(mx + pad, cy, menuW - pad * 2, 1, sGrid.BgOr(0));
        int fy = cy + app.Scale(6);
        int fbw = (menuW - pad * 2 - app.Scale(6)) / 2;
        int fbh = app.Scale(28);
        bool allClick = DataTable.TextBtn(app, mx + pad, fy, fbw, fbh, "Show All", false);
        bool closeClick = DataTable.TextBtn(app, mx + pad + fbw + app.Scale(6), fy, fbw, fbh,
                                            "Close", false);
        if (allClick) {
            DataTable.ShowAllColumns(st);
            st.ColumnResize.Raise();
            app.RequestRedraw();
        }
        if (closeClick) { st.colChooserOpen = false; app.RequestRedraw(); }

        // 点击外部关闭弹层。
        if (app.EventKind() == 3) {
            bool inside = app.mouseX >= mx && app.mouseX < mx + menuW
                          && app.mouseY >= my && app.mouseY < my + menuH;
            if (!inside) { st.colChooserOpen = false; app.RequestRedraw(); }
        }
    }
}
