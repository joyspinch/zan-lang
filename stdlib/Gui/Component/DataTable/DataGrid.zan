using System;
using Gui;
using Gui.Widget;

namespace Gui.Component.DataTable;

/// 从绑定实体中读取一列的显示文本：
/// `grid.Col("Name", 140, u => u.name)`。
delegate string GridText<T>(T row);

/// 从实体读取整数键，用于让数值列按值而非渲染字符串
/// 排序 / 聚合。
delegate int GridInt<T>(T row);

/// 从实体读取小数键，用于声明了
/// `decimals > 0`（货币、汇率）的列：排序与合计保留小数。
delegate double GridReal<T>(T row);

/// 从实体读取布尔值，用于复选框 / bool 列。
delegate bool GridBool<T>(T row);

/// 把编辑后的值写回实体（就地编辑）。未提供时，
/// 即使网格其他部分允许编辑，该列也只读显示。
delegate void GridSet<T>(T row, string v);

/// 为"新行"占位符和右键菜单插入命令创建空白行实体
/// （`() => new User()`）。泛型前端无法
/// 自行 `new T()`，因此这是让 AllowAddRow 真正生效的关键；
/// 缺少它时网格行数保持只读。
delegate T GridNew<T>();

/// `DataGrid<T>` 的一列：引擎可理解的复用 `DataColumn` 描述符，
/// 配以直接读取该列绑定 `T` 值的访问器，
/// 使网格绑定到真实的
/// 领域对象（`List<User>`），而非按位置排列的字符串单元格。
///
/// 配置方法镜像 `DataColumn` 的（Money / Percent / Sortable / …），
/// 原地修改描述符，因此可以流畅地链式组合：
///
/// ```zan
/// grid.RealCol("Amount", 110, 2, o => o.amount).Money("¥").Sum();
/// ```
class GridColumn<T> {
    /// DataTable 引擎读取的描述符（标题、宽度、类型、格式、
    /// 汇总、编辑、冻结、band …）。与网格每帧交给引擎的列表
    /// 按引用共享。
    DataColumn desc;

    /// 显示文本。为 null 时网格从列持有的类型化
    /// 访问器推导，因此数值 / bool 列无需单独的
    /// 文本读取器。
    GridText<T> text;
    /// 整数排序/聚合键（数值列）。为 null 时回退为解析
    /// 显示文本。
    GridInt<T> num;
    /// 小数排序/聚合键（decimals > 0）。为 null 时回退为解析
    /// 显示文本。
    GridReal<T> real;
    /// 布尔键（bool 列）。回退为解析显示文本。
    GridBool<T> truth;
    /// 就地编辑的回写。null 表示该列只读显示。
    GridSet<T> setter;

    GridColumn(DataColumn d) {
        this.desc = d;
        this.text = null;
        this.num = null;
        this.real = null;
        this.truth = null;
        this.setter = null;
    }

    // ---- 编辑 ----
    /// 使该列可编辑，并把提交的值通过 `w` 写回
    /// 实体。
    GridColumn<T> Editable(GridSet<T> w) {
        this.setter = w;
        DataColumn.Editable(this.desc);
        return this;
    }

    // ---- 描述符透传（修改 desc，返回 this 以便链式调用）----
    GridColumn<T> Field(string name) { DataColumn.Field(this.desc, name); return this; }
    GridColumn<T> Right() { this.desc.align = 2; return this; }
    GridColumn<T> Center() { this.desc.align = 1; return this; }
    GridColumn<T> NotSortable() { this.desc.sortable = false; return this; }
    GridColumn<T> NotResizable() { DataColumn.NotResizable(this.desc); return this; }
    GridColumn<T> Money(string symbol) { DataColumn.Money(this.desc, symbol); return this; }
    GridColumn<T> Percent() { DataColumn.Percent(this.desc); return this; }
    GridColumn<T> Grouped() { DataColumn.Grouped(this.desc); return this; }
    GridColumn<T> Affix(string prefix, string suffix) { DataColumn.Affix(this.desc, prefix, suffix); return this; }
    GridColumn<T> Pin() { DataColumn.Pin(this.desc); return this; }
    GridColumn<T> PinRight() { DataColumn.PinRight(this.desc); return this; }
    GridColumn<T> Band(string path) { DataColumn.Band(this.desc, path); return this; }
    GridColumn<T> Sum() { DataColumn.Sum(this.desc); return this; }
    GridColumn<T> Avg() { DataColumn.Avg(this.desc); return this; }
    GridColumn<T> Min() { DataColumn.Min(this.desc); return this; }
    GridColumn<T> Max() { DataColumn.Max(this.desc); return this; }
    GridColumn<T> Count() { DataColumn.Count(this.desc); return this; }

    /// 引擎用于显示、排序
    /// 键和导出的原始（未格式化）单元格字符串。引擎在此基础上应用列的显示格式
    /// （千分位 / 前缀 / 后缀 / 日期 / bool），因此原始
    /// 值保持可解析。未提供文本读取器时，则
    /// 从类型化访问器推导。
    string Raw(T row) {
        if (this.text != null) { return this.text(row); }
        if (this.real != null) { return DataTable.FormatReal(this.real(row), this.desc.decimals); }
        if (this.num != null) { return Convert.ToString(this.num(row)); }
        if (this.truth != null) {
            if (this.truth(row)) { return this.desc.boolTrue; }
            return this.desc.boolFalse;
        }
        return "";
    }
}

/// 将 `List<T>` 及各列访问器适配为引擎的 `DataSource`，
/// 使强大的 DataTable 引擎（排序 / 筛选 / 分组 / 聚合 / 编辑 /
/// 虚拟化）能原样作用于调用方自己的对象。不复制任何数据：
/// 每帧都从活动列表读取单元格。
class GridSource<T> : DataSource {
    List<T> data;
    List<GridColumn<T>> cols;
    /// 空白行实体工厂；null 使数据源保持只读。
    GridNew<T> factory;

    override int RowCount() {
        if (this.data == null) { return 0; }
        return this.data.Count;
    }

    /// 行号在当前这份数据里有效。引擎按上一次重算出来的行号集合
    /// （`st.order`）取单元格，绑定的列表在那之后缩短过的话行号就会越界；
    /// 读单元格是每帧的事，越界一次就是整个程序退出，所以这里按列一样挡住。
    bool Row(int row) {
        if (this.data == null) { return false; }
        return row >= 0 && row < this.data.Count;
    }

    override string CellText(int row, int col) {
        if (col < 0 || col >= this.cols.Count) { return ""; }
        if (!this.Row(row)) { return ""; }
        return this.cols[col].Raw(this.data[row]);
    }

    override int CellNum(int row, int col) {
        if (col < 0 || col >= this.cols.Count || !this.Row(row)) { return 0; }
        GridColumn<T> gc = this.cols[col];
        if (gc.num != null) { return gc.num(this.data[row]); }
        return DataTable.ParseInt(this.CellText(row, col));
    }

    override double CellReal(int row, int col) {
        if (col < 0 || col >= this.cols.Count || !this.Row(row)) { return 0.0; }
        GridColumn<T> gc = this.cols[col];
        if (gc.real != null) { return gc.real(this.data[row]); }
        return DataTable.ParseReal(this.CellText(row, col));
    }

    override bool CellBool(int row, int col) {
        if (col < 0 || col >= this.cols.Count || !this.Row(row)) { return false; }
        GridColumn<T> gc = this.cols[col];
        if (gc.truth != null) { return gc.truth(this.data[row]); }
        return DataTable.ParseBool(this.CellText(row, col));
    }

    override void SetCell(int row, int col, string v) {
        if (col < 0 || col >= this.cols.Count) { return; }
        if (!this.Row(row)) { return; }
        GridColumn<T> gc = this.cols[col];
        if (gc.setter != null) { gc.setter(this.data[row], v); }
    }

    /// 含回写访问器的列使网格可编辑；
    /// 没有此类列的源保持只读。行插入/删除由
    /// `DataGrid.RowFactory` 开启，它提供泛型前端无法
    /// 合成的空白实体构造函数。
    override bool CanInsert() { return this.factory != null; }

    override bool InsertRow(int at) {
        if (this.factory == null) { return false; }
        if (at < 0 || at > this.data.Count) { return false; }
        this.data.Insert(at, this.factory());
        return true;
    }

    override bool RemoveRow(int at) {
        if (at < 0 || at >= this.data.Count) { return false; }
        this.data.RemoveAt(at);
        return true;
    }
}

/// 绑定到调用方自身实体列表的数据网格，形式与
/// `ListView<T>` / `Dropdown<T>` 一致——用访问器声明列，传入数据，
/// 布局、存储或单元格字符串等细节不会泄漏到
/// 调用处：
///
/// ```zan
/// DataGrid<User> grid = new DataGrid<User>();
/// grid.Col("Name", 140, u => u.name);
/// grid.Col("Email", 200, u => u.email);
/// grid.NumCol("Age", 80, u => u.age).Right();
/// grid.Bind(users);          // 调用方的 List<User>，每帧读取
/// side.Add(grid);
/// ```
///
/// 底层驱动完整的 DataTable 引擎（可排序 / 可筛选 /
/// 可分组 / 可编辑 / 虚拟化），泛型前端不损失任何
/// 能力——可通过 `DataGrid.State()` 访问原始
/// `DataTableState`。
class DataGrid<T> : Control {
    List<GridColumn<T>> gcols;
    List<T> data;
    DataTableState st;
    GridSource<T> source;
    /// 每帧交给引擎的 `List<DataColumn>`，与
    /// `gcols` 保持同步，使构造后新增的列也能显示。
    List<DataColumn> descs;
    /// 上一次 Bind 时的行数（-1 = 还没绑过）：行数变了必须让引擎重算行号集合。
    int boundN;

    void InitGrid() {
        this.InitControl("datatable", 5);
        this.gcols = new List<GridColumn<T>>();
        this.data = null;
        this.st = new DataTableState();
        this.source = new GridSource<T>();
        this.source.cols = this.gcols;
        this.source.data = null;
        this.source.factory = null;
        this.descs = new List<DataColumn>();
        this.boundN = 0 - 1;
        // 引擎自行完成整个网格的命中测试 / 绘制，
        // 因此基类控件不能再注册命中区域或绘制表面。
        this.wiresOwnEvents = true;
    }

    DataGrid() { this.InitGrid(); }

    override string Kind() { return "DataGrid"; }

    override string StyleType() { return "datatable"; }

    // ---- 数据 ---------------------------------------------------------------

    /// 绑定调用方的列表。不复制——网格每帧读取，
    /// 修改列表会在下一次绘制时生效。
    DataGrid<T> Bind(List<T> src) {
        int n = 0;
        if (src != null) { n = src.Count; }
        // 换了列表、或者行数变了：引擎里的行号集合（st.order）还是上一份数据
        // 的，不重算就会拿越界行号去取单元格。
        if (this.data != src || n != this.boundN) { this.st.dirty = true; }
        this.data = src;
        this.source.data = src;
        this.boundN = n;
        return this;
    }

    int Count() {
        if (this.data == null) { return 0; }
        return this.data.Count;
    }

    /// 实时的 `DataTableState`，用于链式方法未覆盖的
    /// 高级配置（自定义 `CellStyler`、主从详情 provider、绑定），
    /// 以及在处理器中读取交互上下文（HitRow / HitCol / …）。
    DataTableState State() { return this.st; }

    // ---- 列 ------------------------------------------------------------

    GridColumn<T> Add(GridColumn<T> col) {
        this.gcols.Add(col);
        return col;
    }

    /// 纯文本列。
    GridColumn<T> Col(string title, int width, GridText<T> read) {
        GridColumn<T> c = new GridColumn<T>(DataColumn.Text(title, width));
        c.text = read;
        return this.Add(c);
    }

    /// 整数列：右对齐，按值排序与合计。
    GridColumn<T> NumCol(string title, int width, GridInt<T> read) {
        GridColumn<T> c = new GridColumn<T>(DataColumn.Numeric(title, width));
        c.num = read;
        return this.Add(c);
    }

    /// 保留 `decimals` 位小数的数值列。
    GridColumn<T> RealCol(string title, int width, int decimals, GridReal<T> read) {
        GridColumn<T> c = new GridColumn<T>(DataColumn.Real(title, width, decimals));
        c.real = read;
        return this.Add(c);
    }

    /// 复选框 / 布尔列。
    GridColumn<T> BoolCol(string title, int width, GridBool<T> read) {
        GridColumn<T> c = new GridColumn<T>(DataColumn.Bool(title, width));
        c.truth = read;
        return this.Add(c);
    }

    /// 日期列；`order` 指定存储文本的字段顺序
    /// （0 y-m-d，1 d-m-y，2 m-d-y）。
    GridColumn<T> DateCol(string title, int width, int order, GridText<T> read) {
        GridColumn<T> c = new GridColumn<T>(DataColumn.AsDate(new DataColumn(title, width), order));
        c.text = read;
        return this.Add(c);
    }

    // ---- 外观开关（转发给 state）------------------------

    DataGrid<T> RowNumbers(bool on) { this.st.showRowNum = on; return this; }
    DataGrid<T> Selectable(bool on) { this.st.showSelect = on; return this; }
    DataGrid<T> Striped(bool on) { this.st.striped = on; return this; }
    DataGrid<T> Summary(bool on) { this.st.showSummary = on; return this; }
    DataGrid<T> FilterRow(bool on) { this.st.showFilterRow = on; return this; }
    DataGrid<T> StatusBar(bool on) { this.st.showStatusBar = on; return this; }
    DataGrid<T> GroupPanel(bool on) { this.st.showGroupPanel = on; return this; }
    DataGrid<T> ExternalRowMenu(bool on) {
        this.st.externalRowMenu = on;
        return this;
    }
    /// 在末行下方显示"点击添加"占位符，并启用
    /// 右键菜单的插入/删除命令。命令仅在安装行
    /// 工厂后生效——见 RowFactory。
    DataGrid<T> AllowAddRow(bool on) { this.st.allowAddRow = on; return this; }

    /// 为数据源提供构建空白实体的工厂，以启用行插入/删除：
    /// `grid.RowFactory(() => new User());`
    /// 没有工厂时泛型前端无法构造 `T`，网格将
    /// 无论 AllowAddRow 如何设置都保持固定行数。
    DataGrid<T> RowFactory(GridNew<T> f) {
        this.source.factory = f;
        return this;
    }

    // ---- 事件处理器 -----------------------------------------------------------
    // state 是事件发送者；处理器从 State() 读取上下文
    // （HitRow / HitCol / EditRow / EditValue / …），与引擎模型一致。

    DataGrid<T> OnRowClick(Action a) { this.st.RowClick.Add(a); return this; }
    DataGrid<T> OnRowContext(Action a) { this.st.RowContext.Add(a); return this; }
    DataGrid<T> OnRowDoubleClick(Action a) { this.st.RowDoubleClick.Add(a); return this; }
    DataGrid<T> OnCellClick(Action a) { this.st.CellClick.Add(a); return this; }
    DataGrid<T> OnCellEdit(Action a) { this.st.CellEdit.Add(a); return this; }
    DataGrid<T> OnSelectionChanged(Action a) { this.st.SelectionChanged.Add(a); return this; }
    DataGrid<T> OnSort(Action a) { this.st.Sort.Add(a); return this; }
    DataGrid<T> OnFilterChanged(Action a) { this.st.FilterChanged.Add(a); return this; }

    // ---- 内部实现 ----------------------------------------------------------

    /// 根据当前列刷新引擎的描述符列表。描述符
    /// 按引用共享，配置器的原地修改
    /// 立即可见；此处仅在新增列时重新同步列表长度，
    /// 以匹配列数。
    void SyncDescs() {
        if (this.descs.Count == this.gcols.Count) { return; }
        this.descs = new List<DataColumn>();
        for (int i = 0; i < this.gcols.Count; i = i + 1) {
            this.descs.Add(this.gcols[i].desc);
        }
    }

    // ---- 保留事件钩子 -----------------------------------------------------

    override void OnMeasure(App app) {
        this.prefW = app.Scale(360);
        this.prefH = app.Scale(240);
    }

    override void OnPaint(App app) {
        this.SyncDescs();
        DataTable.RenderSource(app, bx, by, bw, bh, this.descs, this.source, this.st);
    }

    override List<string> Events() {
        List<string> e = Control.CommonEvents();
        e.Add("RowClick");
        e.Add("RowContext");
        e.Add("RowDoubleClick");
        e.Add("CellClick");
        e.Add("CellEdit");
        e.Add("SelectionChanged");
        e.Add("Sort");
        e.Add("FilterChanged");
        return e;
    }

    /// 把网格的语义事件转发到引擎 state 自身的 UiEvent
    /// 字段（与链式 `OnRowClick`/… 订阅的队列相同），
    /// 使 JSON/设计器的 `onRowClick` 处理器生效；其余事件回退
    /// 到 `On` 上的通用事件集合。
    override void BindEvent(string evt, Action a) {
        if (evt == "RowClick") { this.st.RowClick.Add(a); return; }
        if (evt == "RowContext") { this.st.RowContext.Add(a); return; }
        if (evt == "RowDoubleClick") { this.st.RowDoubleClick.Add(a); return; }
        if (evt == "CellClick") { this.st.CellClick.Add(a); return; }
        if (evt == "CellEdit") { this.st.CellEdit.Add(a); return; }
        if (evt == "SelectionChanged") { this.st.SelectionChanged.Add(a); return; }
        if (evt == "Sort") { this.st.Sort.Add(a); return; }
        if (evt == "FilterChanged") { this.st.FilterChanged.Add(a); return; }
        On.AddByName(evt, a);
    }
}
