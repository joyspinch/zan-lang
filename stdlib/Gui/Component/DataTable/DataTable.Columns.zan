using System;
using Gui;
using Gui.Widget;

namespace Gui.Component.DataTable;

/// DataTable 模块：列模型——字段名寻址、可见性与
/// 自动适配、页脚聚合、固定/冻结及多级表头分组。
partial class DataTable {
    // ---------- 字段名寻址 ----------
    // 下面每个操作都接收列*索引*，使调用方与列声明顺序耦合：
    // 在开头插入一列，
    // 所有字面索引都会偏移。用 DataColumn.Field 命名列
    // 可打破这种耦合——保存的布局也存储名称，
    // 因此表被重排后布局依然有效。

    /// 名为 `field` 的列的索引；没有列叫这个名字时返回 -1。
    /// 未命名列（field == ""）永不匹配，空参数
    /// 不会意外选中第一列。
    static int Col(List<DataColumn> cols, string field) {
        if (field.Length == 0) { return -1; }
        for (int i = 0; i < cols.Count; i = i + 1) {
            if (cols[i].field == field) { return i; }
        }
        return -1;
    }

    /// `field` 是 `cols` 中某列名称时返回 true。
    static bool HasCol(List<DataColumn> cols, string field) {
        return DataTable.Col(cols, field) >= 0;
    }

    /// 按字段名寻址的单元格；字段未知时返回 ""——
    /// styler 或事件处理器可用 `Cell(src, cols, row, "state")` 代替
    /// 裸写 `src.CellText(row, 4)`。
    static string Cell(DataSource src, List<DataColumn> cols, int row, string field) {
        int c = DataTable.Col(cols, field);
        if (c < 0) { return ""; }
        return src.CellText(row, c);
    }

    /// 按字段名寻址的单元格数值；未知时返回 0.0。
    static double CellValue(DataSource src, List<DataColumn> cols, int row, string field) {
        int c = DataTable.Col(cols, field);
        if (c < 0) { return 0.0; }
        return src.CellReal(row, c);
    }

    /// 按字段名写入单元格。未知字段是空操作，而非
    /// 误写到其他列。
    static void SetCellField(DataSource src, List<DataColumn> cols, int row, string field, string v) {
        int c = DataTable.Col(cols, field);
        if (c < 0) { return; }
        src.SetCell(row, c, v);
    }

    /// 按命名列排序（dir：1 升序，2 降序）。未知字段：空操作。
    static void SortByField(DataTableState st, List<DataColumn> cols, string field, int dir) {
        int c = DataTable.Col(cols, field);
        if (c >= 0) { DataTable.SortBy(st, c, dir); }
    }

    /// 在命名列上追加次级排序键。未知字段：空操作。
    static void AddSortField(DataTableState st, List<DataColumn> cols, string field, int dir) {
        int c = DataTable.Col(cols, field);
        if (c >= 0) { DataTable.AddSort(st, c, dir); }
    }

    /// 按命名列分组。未知字段：空操作。
    static void GroupByField(DataTableState st, List<DataColumn> cols, string field) {
        int c = DataTable.Col(cols, field);
        if (c >= 0) { DataTable.GroupBy(st, c); }
    }

    /// 命名列的页脚聚合（见 SetAggregate）。未知字段：空操作。
    static void SetAggregateField(DataTableState st, List<DataColumn> cols, string field, int mode) {
        int c = DataTable.Col(cols, field);
        if (c >= 0) { DataTable.SetAggregate(st, c, mode); }
    }

    /// 冻结 / 取消冻结命名列。未知字段：空操作。
    static void PinField(DataTableState st, List<DataColumn> cols, string field, bool on) {
        int c = DataTable.Col(cols, field);
        if (c < 0) { return; }
        if (on) { DataTable.PinColumn(st, c); } else { DataTable.UnpinColumn(st, c); }
    }

    /// 显示 / 隐藏命名列。未知字段：空操作。
    static void HideField(DataTableState st, List<DataColumn> cols, string field, bool hidden) {
        int c = DataTable.Col(cols, field);
        if (c < 0 || c >= st.colHidden.Count) { return; }
        if (st.colHidden[c] == hidden) { return; }
        st.colHidden[c] = hidden;
        DataTable.InvalidateView(st);
    }

    /// 最近交互列的字段名（`st.hitCol`）；未命中或该列未命名时返回 ""。
    /// 让 CellClick 处理器
    /// 按名称分支，而不是把 HitCol() 与字面量比较。
    static string HitField(DataTableState st, List<DataColumn> cols) {
        int c = st.hitCol;
        if (c < 0 || c >= cols.Count) { return ""; }
        return cols[c].field;
    }

    /// 正在编辑的列的字段名（`st.editCol`），否则为 ""。
    static string EditField(DataTableState st, List<DataColumn> cols) {
        int c = st.editCol;
        if (c < 0 || c >= cols.Count) { return ""; }
        return cols[c].field;
    }

    // ---------- 列可见性 / 自动适配辅助 ----------

    static int HiddenCount(DataTableState st) {
        int n = 0;
        for (int i = 0; i < st.colHidden.Count; i = i + 1) {
            if (st.colHidden[i]) { n = n + 1; }
        }
        return n;
    }

    static void ShowAllColumns(DataTableState st) {
        bool changed = false;
        for (int i = 0; i < st.colHidden.Count; i = i + 1) {
            if (st.colHidden[i]) { st.colHidden[i] = false; changed = true; }
        }
        if (changed) { DataTable.InvalidateView(st); }
    }

    // ---------- 页脚聚合 ----------
    // 设置列的合计行聚合（0 无，1 求和，2 平均，3 最小，4 最大，5 计数）
    // 并根据是否仍有列在聚合自动切换页脚。
    static void SetAggregate(DataTableState st, int col, int mode) {
        while (st.aggMode.Count <= col) { st.aggMode.Add(0); }
        if (col < 0 || col >= st.aggMode.Count) { return; }
        st.aggMode[col] = mode;
        bool any = false;
        for (int i = 0; i < st.aggMode.Count; i = i + 1) { if (st.aggMode[i] > 0) { any = true; } }
        st.showSummary = any;
        DataTable.InvalidateQuery(st);
    }

    // ---------- 列固定 / 冻结 ----------
    // 冻结代码：0 随滚动，1 固定左缘，2 固定右缘。
    // 冻结列完全脱离滚动 band——不只是
    // 顺序提前，而是以固定 x 单独绘制。

    static void FreezeColumn(DataTableState st, int col, int side) {
        if (col < 0 || col >= st.colFreeze.Count) { return; }
        if (side < 0 || side > 2) { side = 0; }
        if (st.colFreeze[col] == side) { return; }
        st.colFreeze[col] = side;
        DataTable.InvalidateView(st);
    }

    static void PinColumn(DataTableState st, int col) {
        DataTable.FreezeColumn(st, col, 1);
    }

    static void PinColumnRight(DataTableState st, int col) {
        DataTable.FreezeColumn(st, col, 2);
    }

    static void UnpinColumn(DataTableState st, int col) {
        DataTable.FreezeColumn(st, col, 0);
    }

    /// 让列在 无 → 左 → 右 → 无 之间循环，
    /// 这正是单个菜单项或重复快捷键所需的行为。
    static void TogglePin(DataTableState st, int col) {
        if (col < 0 || col >= st.colFreeze.Count) { return; }
        DataTable.FreezeColumn(st, col, (st.colFreeze[col] + 1) % 3);
    }

    static int FreezeOf(DataTableState st, int col) {
        if (col < 0 || col >= st.colFreeze.Count) { return 0; }
        return st.colFreeze[col];
    }

    static bool IsPinned(DataTableState st, int col) {
        return DataTable.FreezeOf(st, col) == 1;
    }

    static bool IsPinnedRight(DataTableState st, int col) {
        return DataTable.FreezeOf(st, col) == 2;
    }

    /// 把命名列冻结到一侧（0 无，1 左，2 右）。未知
    /// 字段：空操作，与其他按字段寻址的操作一致。
    static void FreezeField(DataTableState st, List<DataColumn> cols, string field, int side) {
        int c = DataTable.Col(cols, field);
        if (c >= 0) { DataTable.FreezeColumn(st, c, side); }
    }

    // ---------- 表头分组（多级表头）----------
    // 列的 `band` 是其上方分组的斜杠分隔路径，
    // 表头结构由列自身携带，不会与列失步。
    // 下面的逻辑都从*可见
    // 顺序*推导跨列单元格，冻结、重排、隐藏因此自然成立：
    // 分组跨过所有共享其路径的相邻槽位，
    // 被切成两段的组自然成为两个跨区。

    /// 列的 band 路径；不属于任何分组时为 ""。
    static string BandOf(List<DataColumn> cols, int col) {
        if (col < 0 || col >= cols.Count) { return ""; }
        return cols[col].band;
    }

    /// band 路径的前 `depth` 段，如 Prefix("a/b/c", 2) 返回
    /// "a/b"。段数少于 `depth` 时返回完整路径。
    static string BandPrefix(string path, int depth) {
        if (path == "" || depth <= 0) { return ""; }
        List<string> parts = path.Split("/");
        string outp = "";
        for (int i = 0; i < parts.Count && i < depth; i = i + 1) {
            if (i > 0) { outp = outp + "/"; }
            outp = outp + parts[i];
        }
        return outp;
    }

    /// 列上方有多少层分组。
    static int BandDepth(string path) {
        if (path == "") { return 0; }
        return path.Split("/").Count;
    }

    /// 可见列中最深的 band 嵌套层数——即列标题上方
    /// 需要额外绘制的表头行数。0 表示普通表头。
    static int BandLevels(List<DataColumn> cols, List<int> vorder) {
        int m = 0;
        for (int i = 0; i < vorder.Count; i = i + 1) {
            int d = DataTable.BandDepth(DataTable.BandOf(cols, vorder[i]));
            if (d > m) { m = d; }
        }
        return m;
    }

    /// 某一层的跨列表头单元格，从左到右。相邻
    /// 共享前缀的槽位合并为一个跨区；该层无分组的槽位
    /// 不产生跨区，让列标题向上延伸到
    /// 上方的空行。
    static List<BandSpan> BandRow(DataTableState st, List<DataColumn> cols,
                                  List<int> vorder, int level) {
        List<BandSpan> spans = new List<BandSpan>();
        int i = 0;
        while (i < vorder.Count) {
            string p = DataTable.BandPrefix(DataTable.BandOf(cols, vorder[i]), level + 1);
            if (DataTable.BandDepth(p) <= level) {
                // 该层无分组：空间归下方的标题单元格。
                i = i + 1;
            } else {
                int j = i + 1;
                while (j < vorder.Count
                       && DataTable.BandPrefix(DataTable.BandOf(cols, vorder[j]), level + 1) == p) {
                    j = j + 1;
                }
                List<string> segs = p.Split("/");
                spans.Add(new BandSpan(segs[segs.Count - 1], p, level, i, j));
                i = j;
            }
        }
        return spans;
    }

    static List<BandSpan> BandRow(DataTableState st, List<DataColumn> cols,
                                  List<FrameColumn> columns, int level) {
        List<BandSpan> spans = new List<BandSpan>();
        int i = 0;
        while (i < columns.Count) {
            string p = DataTable.BandPrefix(DataTable.BandOf(cols, columns[i].column), level + 1);
            if (DataTable.BandDepth(p) <= level) {
                // 该层无分组：空间归下方的标题单元格。
                i = i + 1;
            } else {
                int j = i + 1;
                while (j < columns.Count
                       && DataTable.BandPrefix(DataTable.BandOf(cols, columns[j].column), level + 1) == p) {
                    j = j + 1;
                }
                List<string> segs = p.Split("/");
                spans.Add(new BandSpan(segs[segs.Count - 1], p, level, i, j));
                i = j;
            }
        }
        return spans;
    }

    /// 所有跨区单元格，最外层在前。
    static List<BandSpan> BandSpans(DataTableState st, List<DataColumn> cols,
                                    List<int> vorder) {
        List<BandSpan> all = new List<BandSpan>();
        int levels = DataTable.BandLevels(cols, vorder);
        for (int lv = 0; lv < levels; lv = lv + 1) {
            List<BandSpan> row = DataTable.BandRow(st, cols, vorder, lv);
            for (int i = 0; i < row.Count; i = i + 1) { all.Add(row[i]); }
        }
        return all;
    }

    static bool BandIsCollapsed(DataTableState st, string path) {
        if (path == "") { return false; }
        return st.bandCollapsed.IndexOf(path) >= 0;
    }

    /// 把 band 折叠到第一列，或展开。折叠是隐藏
    /// 组内其余列而非删除，因此它们的宽度、
    /// 筛选和排序键在往返后依然保留。
    static void SetBandCollapsed(DataTableState st, List<DataColumn> cols,
                                 string path, bool collapsed) {
        if (path == "") { return; }
        int at = st.bandCollapsed.IndexOf(path);
        if (collapsed && at < 0) { st.bandCollapsed.Add(path); }
        if (!collapsed && at >= 0) { st.bandCollapsed.RemoveAt(at); }
        DataTable.ApplyBandCollapse(st, cols);
        DataTable.InvalidateView(st);
    }

    static void ToggleBand(DataTableState st, List<DataColumn> cols, string path) {
        DataTable.SetBandCollapsed(st, cols, path, !DataTable.BandIsCollapsed(st, path));
    }

    /// 从折叠集合重新推导 `colHidden`：折叠的 band 内
    /// 除第一列外全部隐藏。
    ///
    /// `bandAutoHidden` 精确记录*本*机制隐藏的列，
    /// 展开时只恢复这些列。否则用户手动隐藏的列
    /// 会在下次折叠无关 band 时被悄悄恢复——
    /// 隐藏是用户的决定，折叠不能
    /// 悄悄覆盖它。
    static void ApplyBandCollapse(DataTableState st, List<DataColumn> cols) {
        List<int> nowHidden = new List<int>();
        for (int i = 0; i < cols.Count && i < st.colHidden.Count; i = i + 1) {
            string p = cols[i].band;
            if (p != "") {
                // 最外层折叠祖先优先：折叠外层组
                // 时，无论内层状态如何，其下所有内容一并折叠。
                string keep = "";
                int d = 1;
                while (d <= DataTable.BandDepth(p) && keep == "") {
                    string pref = DataTable.BandPrefix(p, d);
                    if (DataTable.BandIsCollapsed(st, pref)) { keep = pref; }
                    d = d + 1;
                }
                if (keep != "") {
                    // band 的第一列保留为可见的"桩"。
                    int first = -1;
                    for (int k = 0; k < cols.Count && first < 0; k = k + 1) {
                        if (DataTable.BandPrefix(cols[k].band, DataTable.BandDepth(keep)) == keep) {
                            first = k;
                        }
                    }
                    if (i != first) {
                        st.colHidden[i] = true;
                        nowHidden.Add(i);
                    } else if (st.bandAutoHidden.IndexOf(i) >= 0) {
                        st.colHidden[i] = false;
                    }
                } else if (st.bandAutoHidden.IndexOf(i) >= 0) {
                    st.colHidden[i] = false;
                }
            }
        }
        st.bandAutoHidden = nowHidden;
    }

    // 按屏幕显示顺序排列的列索引：左冻结列在前，然后是活动分组
    // 列、滚动列，最后是右冻结列。
    // 隐藏列被排除。所有布局流程（表头 / 筛选行 /
    // 单元格 / 命中测试 / 汇总）都遍历这一份列表，天然对齐，
    // 而非依赖四份重复计算保持一致。

    static List<int> VisibleOrder(DataTableState st, List<DataColumn> cols) {
        // 主序列是用户列顺序（可拖拽重排）；固定列和
        // 分组列仍会提到前面，但保留它们在原顺序中的
        // 相对位置。
        List<int> seq = new List<int>();
        for (int s = 0; s < st.colOrder.Count; s = s + 1) {
            int ci = st.colOrder[s];
            if (ci >= 0 && ci < cols.Count && seq.IndexOf(ci) < 0) { seq.Add(ci); }
        }
        for (int a = 0; a < cols.Count; a = a + 1) {
            if (seq.IndexOf(a) < 0) { seq.Add(a); }
        }

        List<int> ord = new List<int>();
        // 1) 左冻结列在前，按用户顺序。
        for (int p = 0; p < seq.Count; p = p + 1) {
            int pc = seq[p];
            if (!st.colHidden[pc] && DataTable.IsPinned(st, pc) && ord.IndexOf(pc) < 0) { ord.Add(pc); }
        }
        // 2) 活动分组列随后提前——但绝不含右冻结列：
        // 按停在右缘的列分组会把它拖回
        // 左侧，与冻结它的初衷相反。
        for (int g = 0; g < st.groupCols.Count; g = g + 1) {
            int gc = st.groupCols[g];
            if (gc >= 0 && gc < cols.Count && !st.colHidden[gc]
                && !DataTable.IsPinnedRight(st, gc) && ord.IndexOf(gc) < 0) {
                ord.Add(gc);
            }
        }
        // 3) 滚动列按用户顺序。
        for (int i = 0; i < seq.Count; i = i + 1) {
            int rc = seq[i];
            if (!st.colHidden[rc] && !DataTable.IsPinnedRight(st, rc) && ord.IndexOf(rc) < 0) {
                ord.Add(rc);
            }
        }
        // 4) 右冻结列最后，保证整体仍从左到右。
        for (int q = 0; q < seq.Count; q = q + 1) {
            int qc = seq[q];
            if (!st.colHidden[qc] && DataTable.IsPinnedRight(st, qc) && ord.IndexOf(qc) < 0) {
                ord.Add(qc);
            }
        }
        return ord;
    }

    /// `vorder` 开头有多少列冻结在左缘。
    /// 渲染流程用本函数和 RightFrozenCount 把顺序切成 [左 | 滚动 | 右]，
    /// 因此一列绝不会在两个 band 中绘制。
    static int LeftFrozenCount(DataTableState st, List<int> vorder) {
        int n = 0;
        for (; n < vorder.Count && DataTable.IsPinned(st, vorder[n]); n = n + 1) { }
        return n;
    }

    /// `vorder` 末尾有多少列冻结在右缘。
    static int RightFrozenCount(DataTableState st, List<int> vorder) {
        int n = 0;
        for (; n < vorder.Count && DataTable.IsPinnedRight(st, vorder[vorder.Count - 1 - n]); n = n + 1) {
        }
        return n;
    }

    // 在用户列顺序中重排：移动 `from` 使其恰好位于
    // `beforeCol` 之前（beforeCol < 0 时移到末尾）。若
    // 移动不会改变现状则空操作。
    static void MoveColumn(DataTableState st, int from, int beforeCol) {
        int fi = st.colOrder.IndexOf(from);
        if (fi < 0) { return; }
        if (from == beforeCol) { return; }
        st.colOrder.RemoveAt(fi);
        if (beforeCol < 0) {
            st.colOrder.Add(from);
        } else {
            int bi = st.colOrder.IndexOf(beforeCol);
            if (bi < 0) { st.colOrder.Add(from); }
            else { st.colOrder.Insert(bi, from); }
        }
        DataTable.InvalidateView(st);
    }

    // 左冻结列按自然宽度的总宽度。
    static int PinnedWidth(DataTableState st) {
        int w = 0;
        for (int i = 0; i < st.colWidths.Count; i = i + 1) {
            if (!st.colHidden[i] && DataTable.IsPinned(st, i)) { w = w + st.colWidths[i]; }
        }
        return w;
    }

    // 右冻结列的总宽度。
    static int PinnedRightWidth(DataTableState st) {
        int w = 0;
        for (int i = 0; i < st.colWidths.Count; i = i + 1) {
            if (!st.colHidden[i] && DataTable.IsPinnedRight(st, i)) { w = w + st.colWidths[i]; }
        }
        return w;
    }

    /// 给定滚动偏移后，列相对表格数据原点的屏幕 x——
    /// 这里唯一知道冻结列忽略 `scrollX`、
    /// 右冻结列从右缘往回测量的位置。
    ///
    /// `dataViewW` 是整个数据区域的宽度（不含边栏）。
    /// 返回相对数据原点的偏移；调用方自行加上 firstDataX。
    static int ColumnOffset(DataTableState st, List<int> vorder, int col,
                            int dataViewW, int scrollX) {
        int nL = DataTable.LeftFrozenCount(st, vorder);
        int nR = DataTable.RightFrozenCount(st, vorder);
        int pos = vorder.IndexOf(col);
        if (pos < 0) { return -1; }
        int off = 0;
        int i = 0;
        if (pos < nL) {
            while (i < pos) { off = off + st.dispW[vorder[i]]; i = i + 1; }
            return off;
        }
        if (pos >= vorder.Count - nR) {
            // 从右缘往回测量，使该 band 无论表格多宽
            // 都紧贴右缘。
            int rw = 0;
            i = vorder.Count - nR;
            while (i < vorder.Count) { rw = rw + st.dispW[vorder[i]]; i = i + 1; }
            off = dataViewW - rw;
            i = vorder.Count - nR;
            while (i < pos) { off = off + st.dispW[vorder[i]]; i = i + 1; }
            return off;
        }
        // 滚动 band：从左 band 之后开始，随 scrollX 平移。
        i = 0;
        while (i < nL) { off = off + st.dispW[vorder[i]]; i = i + 1; }
        int mid = 0;
        i = nL;
        while (i < pos) { mid = mid + st.dispW[vorder[i]]; i = i + 1; }
        return off + mid - scrollX;
    }

    // 列最宽的渲染单元格（标题 + 数据），供自动适配使用。扫描
    // 筛选后的视图，使宽度与实际显示一致。
    static int MeasureColWidth(App app, List<DataColumn> cols, DataSource src,
                               DataTableState st, int col) {
        int fs = Style.FontFallback(app, "medium");
        int w = Canvas.MeasureText(cols[col].title, fs);
        for (int i = 0; i < st.order.Count; i = i + 1) {
            int cw = Canvas.MeasureText(DataTable.FormatCell(cols[col], src.CellText(st.order[i], col)), fs);
            if (cw > w) { w = cw; }
        }
        // 两侧内边距 + 排序箭头 / 表头菜单图标的余量。
        int fit = w + app.theme.paddingSmall * 2 + app.Scale(26);
        if (fit < app.Scale(48)) { fit = app.Scale(48); }
        return fit;
    }

    static void AutoFitColumn(App app, List<DataColumn> cols, DataSource src,
                              DataTableState st, int col) {
        if (col < 0 || col >= st.colWidths.Count) { return; }
        st.colWidths[col] = DataTable.MeasureColWidth(app, cols, src, st, col);
    }

    static void AutoFitAll(App app, List<DataColumn> cols, DataSource src,
                           DataTableState st) {
        for (int i = 0; i < cols.Count && i < st.colWidths.Count; i = i + 1) {
            if (!st.colHidden[i]) {
                st.colWidths[i] = DataTable.MeasureColWidth(app, cols, src, st, i);
            }
        }
    }

    // 行是否通过筛选行快速筛选（逐列不区分大小写的 Contains
    // 匹配）。filterRowText 为空的列总是放行。
    static bool RowPassesFilterRow(DataTableState st, DataSource src, int row) {
        for (int c = 0; c < st.filterRowText.Count; c = c + 1) {
            string q = st.filterRowText[c];
            if (q.Length > 0) {
                if (!DataTable.ContainsCI(src.CellText(row, c), q)) { return false; }
            }
        }
        return true;
    }

    static bool RowPasses(DataTableState st, List<DataColumn> cols, DataSource src, int row) {
        int today = DataTable.Today();
        for (int i = 0; i < cols.Count; i = i + 1) {
            ColFilter f = st.filters[i];
            if (f.Active()) {
                if (!DataTable.CellPassesCol(f, cols[i], src.CellText(row, i), today)) { return false; }
            }
        }
        return true;
    }

    // 只对已知有活动筛选的列执行筛选谓词。
    static bool RowPassesActive(DataTableState st, List<DataColumn> cols, DataSource src,
                                List<int> af, int row, int today) {
        for (int a = 0; a < af.Count; a = a + 1) {
            int c = af[a];
            if (!DataTable.CellPassesCol(st.filters[c], cols[c], src.CellText(row, c), today)) { return false; }
        }
        return true;
    }

}
