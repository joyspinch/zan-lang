using System;
using Gui;

namespace Gui.Component.DataTable;

/// DataTable 分部：值解析、数字/实数/bool/日期格式化与
/// 日历计算——原始单元格字符串与其类型化/显示形式之间的纯静态转换。
/// 此处不触碰任何表格状态。
partial class DataTable {
    // ---------- 小工具函数 ----------

    /// 逐码点比较两个字符串，短者为小；返回 -1/0/1。
    static int CompareStr(string a, string b) {
        int la = a.Length;
        int lb = b.Length;
        int n = la;
        if (lb < n) { n = lb; }
        for (int i = 0; i < n; i = i + 1) {
            char cha = a[i];
            char chb = b[i];
            int ca = (int)cha;
            int cb = (int)chb;
            if (ca < cb) { return -1; }
            if (ca > cb) { return 1; }
        }
        if (la < lb) { return -1; }
        if (la > lb) { return 1; }
        return 0;
    }

    /// 仅由可选前导 '-' 与数字组成（至少一个数字）时为 true。
    static bool IsIntStr(string s) {
        int n = s.Length;
        if (n == 0) { return false; }
        for (int i = 0; i < n; i = i + 1) {
            char ch = s[i];
            int c = (int)ch;
            bool neg = (i == 0 && c == 45);
            if (!neg) {
                if (c < 48 || c > 57) { return false; }
            }
        }
        return true;
    }

    /// 宽松整数解析：可选前导 '-'，取前导十进制数字（遇非数字停止，
    /// 尾部忽略）；空串/无数字得 0。
    static int ParseInt(string s) {
        int n = s.Length;
        if (n == 0) { return 0; }
        int i = 0;
        bool neg = false;
        char c0 = s[0];
        if ((int)c0 == 45) { neg = true; i = 1; }
        int v = 0;
        while (i < n) {
            char ch = s[i];
            int c = (int)ch;
            if (c < 48 || c > 57) { i = n; } else {
                v = v * 10 + (c - 48);
                i = i + 1;
            }
        }
        if (neg) { return 0 - v; }
        return v;
    }

    // ---- real（定点小数）数值支持 ----
    // 单元格在数据层面仍是字符串，但 `decimals > 0` 的数值列
    // 会解析为 double 用于排序/聚合/条件格式，
    // 并以固定小数位重新渲染，1.5 与 1.9 不再比较相等，
    // 总计也保留小数部分。

    /// 10 的 n 次幂。
    static double Pow10(int n) {
        double p = 1.0;
        for (int i = 0; i < n; i = i + 1) { p = p * 10.0; }
        return p;
    }

    /// 宽松的实数解析：可选的前导 '-'、十进制数字和至多一个
    /// '.'；千位分隔符、货币符号和单位后缀会被
    /// 跳过，因此“¥1,234.56”和“-98%”都能正确解析。“”视为 0。
    static double ParseReal(string s) {
        int n = s.Length;
        int i = 0;
        bool neg = false;
        if (i < n && (int)s[i] == 45) { neg = true; i = i + 1; }
        double v = 0.0;
        bool seenDot = false;
        double scale = 1.0;
        while (i < n) {
            int c = (int)s[i];
            if (c >= 48 && c <= 57) {
                if (seenDot) { scale = scale * 10.0; v = v + (double)(c - 48) / scale; }
                else { v = v * 10.0 + (double)(c - 48); }
            } else if (c == 46 && !seenDot) {
                seenDot = true;
            }
            i = i + 1;
        }
        if (neg) { return 0.0 - v; }
        return v;
    }

    /// 将小数部分左补零到 `decimals` 位（“5”在 2 位时 -> “05”）。
    static string PadFrac(int fp, int decimals) {
        string fs = Convert.ToString(fp);
        while (fs.Length < decimals) { fs = "0" + fs; }
        return fs;
    }

    /// 将 double 渲染为恰好 `decimals` 位小数（四舍五入）。
    /// `Convert.ToString(double)` 只有约 6 位有效数字，因此
    /// 网格从不用它处理单元格值。
    static string FormatReal(double v, int decimals) {
        bool neg = v < 0.0;
        double a = v;
        if (neg) { a = 0.0 - a; }
        if (decimals <= 0) {
            long r = (long)(a + 0.5);
            string s0 = Convert.ToString(r);
            if (neg && r != 0) { s0 = "-" + s0; }
            return s0;
        }
        long iscale = (long)DataTable.Pow10(decimals);
        long total = (long)(a * (double)iscale + 0.5);
        long ip = total / iscale;
        long fp = total - ip * iscale;
        string s = Convert.ToString(ip) + "." + DataTable.PadFrac((int)fp, decimals);
        if (neg && total != 0) { s = "-" + s; }
        return s;
    }

    // ---- bool 支持 ----
    // bool 列存储文本但以真值作键，因此它按
    // false 在前 true 在后的顺序排序，并恰好分成两组，无论
    // 每个单元格如何拼写。

    /// 将单元格读作真值。“1”、“true”、“yes”、“y”、“on”、
    /// “t”和勾号视为 true；其他任何值（包括“”、“0”和“false”）
    /// 视为 false。不区分大小写且容忍首尾空格，
    /// 因此混用“Yes”/“TRUE”/“1”的列也能一致地读取。
    static bool ParseBool(string s) {
        string v = DataTable.LowerAscii(DataTable.TrimSpace(s));
        if (v == "1" || v == "true" || v == "yes" || v == "y" || v == "on" || v == "t") {
            return true;
        }
        return v == Text.CharStr(10003);   // ✓
    }

    /// 去除首尾空格和制表符。
    static string TrimSpace(string s) {
        int a = 0;
        int b = s.Length;
        while (a < b) {
            int c = (int)s[a];
            if (c == 32 || c == 9) { a = a + 1; } else { break; }
        }
        while (b > a) {
            int c = (int)s[b - 1];
            if (c == 32 || c == 9) { b = b - 1; } else { break; }
        }
        return s.Substring(a, b - a);
    }

    /// 仅对 ASCII 转小写；多字节序列保持不变。
    static string LowerAscii(string s) {
        string o = "";
        for (int i = 0; i < s.Length; i = i + 1) {
            int c = (int)s[i];
            if (c >= 65 && c <= 90) { o = o + Text.ByteChar(c + 32); }
            else { o = o + s.Substring(i, 1); }
        }
        return o;
    }

    // ---- 日期支持 ----
    // 日期列存储文本，但按天数（自 1970-01-01 起，之前为负）
    // 排序、分组和汇总，因此“2026-01-05”排在
    // “2025-12-31”之后，而不是在字符串比较中并列。天数
    // 走现有的 int 键路径，排序无需额外机制。

    /// 解析日期，返回自纪元起的天数；无法识别时返回
    /// `DataTable.NoDate`。接受任意单个非数字
    /// 分隔符（“2026-07-26”、“2026/7/6”、“2026.7.6”）、可选的尾部
    /// 时间（忽略），以及 `dateOrder` 指定的字段顺序：
    /// 0 = y-m-d，1 = d-m-y，2 = m-d-y。两位数年份映射到 2000..2069 /
    /// 1970..1999。单独的 8 位数字读作 YYYYMMDD。
    static int ParseDate(string s, int dateOrder) {
        int n = s.Length;
        List<int> nums = new List<int>();
        List<int> lens = new List<int>();
        int i = 0;
        // 取前三个数字段；尾部时间会产生更多数字段，
        // 直接丢弃。
        while (i < n && nums.Count < 3) {
            int c = (int)s[i];
            if (c >= 48 && c <= 57) {
                int v = 0;
                int len = 0;
                bool run = true;
                while (i < n && run) {
                    int d = (int)s[i];
                    if (d < 48 || d > 57) { run = false; } else {
                        v = v * 10 + (d - 48);
                        len = len + 1;
                        i = i + 1;
                    }
                }
                nums.Add(v);
                lens.Add(len);
            } else {
                i = i + 1;
            }
        }

        // 单个 8 位数字段是紧凑的 YYYYMMDD。
        if (nums.Count == 1 && lens[0] == 8) {
            int p = nums[0];
            int py = p / 10000;
            int pm = (p / 100) - py * 100;
            int pd = p - py * 10000 - pm * 100;
            return DataTable.DateFromYmd(py, pm, pd);
        }
        if (nums.Count < 3) { return DataTable.NoDate(); }

        int y = nums[0];
        int m = nums[1];
        int d = nums[2];
        if (dateOrder == 1) { d = nums[0]; m = nums[1]; y = nums[2]; }
        else if (dateOrder == 2) { m = nums[0]; d = nums[1]; y = nums[2]; }
        // 首位是 4 位数字段时始终优先于声明的
        // 顺序，因此 ISO 格式值在任何 dateOrder 下都能正确解析。
        if (lens[0] == 4) { y = nums[0]; m = nums[1]; d = nums[2]; }
        if (y < 100) {
            if (y < 70) { y = y + 2000; } else { y = y + 1900; }
        }
        return DataTable.DateFromYmd(y, m, d);
    }

    /// “非日期”的哨兵天数：排在所有真实日期之前，
    /// 并渲染为空单元格。
    static int NoDate() { return 0 - 100000000; }

    /// 校验字段，然后转换为天数；月/日越界返回 NoDate。
    static int DateFromYmd(int y, int m, int d) {
        if (m < 1 || m > 12) { return DataTable.NoDate(); }
        if (d < 1 || d > DateTime.DaysInMonth(y, m)) { return DataTable.NoDate(); }
        return DateTime.DaysFromCivil(y, m, d);
    }

    /// 按 `dateFmt` 指定的格式渲染天数：
    /// 0 = YYYY-MM-DD, 1 = DD/MM/YYYY, 2 = MM/DD/YYYY, 3 = YYYY年M月D日,
    /// 4 = YYYY-MM（月），5 = YYYY（年），6 = “1 Jan 2026”。
    static string FormatDate(int days, int dateFmt) {
        if (days == DataTable.NoDate()) { return ""; }
        DateTime t = DateTime.FromUnixSeconds(days * 86400);
        int y = t.Year();
        int m = t.Month();
        int d = t.Day();
        if (dateFmt == 1) {
            return DateTime.Pad2(d) + "/" + DateTime.Pad2(m) + "/" + Convert.ToString(y);
        }
        if (dateFmt == 2) {
            return DateTime.Pad2(m) + "/" + DateTime.Pad2(d) + "/" + Convert.ToString(y);
        }
        if (dateFmt == 3) {
            return Convert.ToString(y) + Text.CharStr(24180) + Convert.ToString(m)
                 + Text.CharStr(26376) + Convert.ToString(d) + Text.CharStr(26085);
        }
        if (dateFmt == 4) { return Convert.ToString(y) + "-" + DateTime.Pad2(m); }
        if (dateFmt == 5) { return Convert.ToString(y); }
        if (dateFmt == 6) {
            return Convert.ToString(d) + " " + DataTable.MonthAbbr(m) + " " + Convert.ToString(y);
        }
        return Convert.ToString(y) + "-" + DateTime.Pad2(m) + "-" + DateTime.Pad2(d);
    }

    /// 在该列 dateOrder 下 ParseDate 能读回的 FormatDate 格式。
    /// 渲染格式（dateFmt）可以任意——它甚至可以
    /// 完全去掉日——因此写入*单元格*的值必须使用
    /// 存储时的字段顺序，否则无法经受再次解析。
    static int DateStoreFormat(DataColumn c) {
        if (c.dateOrder == 1) { return 1; }
        if (c.dateOrder == 2) { return 2; }
        return 0;
    }

    /// 月份的英文三字母缩写（Jan..Dec）；越界为空串。
    static string MonthAbbr(int m) {
        if (m == 1) { return "Jan"; }
        if (m == 2) { return "Feb"; }
        if (m == 3) { return "Mar"; }
        if (m == 4) { return "Apr"; }
        if (m == 5) { return "May"; }
        if (m == 6) { return "Jun"; }
        if (m == 7) { return "Jul"; }
        if (m == 8) { return "Aug"; }
        if (m == 9) { return "Sep"; }
        if (m == 10) { return "Oct"; }
        if (m == 11) { return "Nov"; }
        if (m == 12) { return "Dec"; }
        return "";
    }

    /// 按 `dateGroup` 对日期单元格分组的分桶标签：
    /// 0 = 精确到日，1 = 年，2 = 年月，3 = 季度，4 = 星期。
    /// 按月分组会把一个月的每一天合并到一个标题下。
    static string DateGroupKey(int days, int dateGroup) {
        if (days == DataTable.NoDate()) { return ""; }
        if (dateGroup == 0) { return DataTable.FormatDate(days, 0); }
        DateTime t = DateTime.FromUnixSeconds(days * 86400);
        int y = t.Year();
        if (dateGroup == 1) { return Convert.ToString(y); }
        if (dateGroup == 2) { return Convert.ToString(y) + "-" + DateTime.Pad2(t.Month()); }
        if (dateGroup == 3) {
            int q = (t.Month() - 1) / 3 + 1;
            return Convert.ToString(y) + " Q" + Convert.ToString(q);
        }
        if (dateGroup == 4) { return DataTable.DayName(t.DayOfWeek()); }
        return DataTable.FormatDate(days, 0);
    }

    /// 星期几的英文名（Sunday..Saturday）；越界为空串。
    static string DayName(int dow) {
        if (dow == 0) { return "Sunday"; }
        if (dow == 1) { return "Monday"; }
        if (dow == 2) { return "Tuesday"; }
        if (dow == 3) { return "Wednesday"; }
        if (dow == 4) { return "Thursday"; }
        if (dow == 5) { return "Friday"; }
        if (dow == 6) { return "Saturday"; }
        return "";
    }

    /// 在一串数字中插入千位分隔符。若字符串
    /// 含有任何非数字字符则保持原样（以免破坏非数值单元格）。
    static string GroupDigits(string ipart) {
        int n = ipart.Length;
        for (int k = 0; k < n; k = k + 1) {
            int cc = (int)ipart[k];
            if (cc < 48 || cc > 57) { return ipart; }
        }
        if (n <= 3) { return ipart; }
        string outp = "";
        int cnt = 0;
        int i = n - 1;
        while (i >= 0) {
            outp = ipart.Substring(i, 1) + outp;
            cnt = cnt + 1;
            if (cnt % 3 == 0 && i > 0) { outp = "," + outp; }
            i = i - 1;
        }
        return outp;
    }

    /// 将列的显示格式应用于原始单元格值：可选的千位
    /// 分组（整数部分）加前缀/后缀。符号和小数
    /// 部分保持不变。fmt 关闭时原样返回原始值。
    static string FormatCell(DataColumn col, string raw) {
        // bool 列将所有可接受的拼写归一化为该列自己的
        // 一对文本，混用“1”/“Yes”/“TRUE”也能读成同一套词汇。
        // 复选框和字形样式直接绘制，不使用此文本。
        if (col.isBool) {
            if (DataTable.ParseBool(raw)) { return col.boolTrue; }
            return col.boolFalse;
        }
        // 日期列从解析出的天数重新渲染，因此混合的存储
        // 写法（“2026/7/6”、“20260706”）显示完全一致。
        // 解析不出日期的文本按原样显示，而非留空。
        if (col.isDate) {
            int dk = DataTable.ParseDate(raw, col.dateOrder);
            if (dk == DataTable.NoDate()) { return raw; }
            return DataTable.FormatDate(dk, col.dateFmt);
        }
        if (col.fmt == 0) { return raw; }
        if (raw.Length == 0) { return raw; }
        // 定点小数列从解析值重新渲染，使每个单元格
        // 显示相同的小数位（“5” -> “5.00”），无论输入时如何书写。
        if (col.decimals > 0) {
            raw = DataTable.FormatReal(DataTable.ParseReal(raw), col.decimals);
        }
        string sign = "";
        string body = raw;
        if ((int)raw[0] == 45) { sign = "-"; body = raw.Substring(1); }
        int dot = -1;
        int i = 0;
        while (i < body.Length) {
            if ((int)body[i] == 46) { dot = i; i = body.Length; } else { i = i + 1; }
        }
        string ipart = body;
        string fpart = "";
        if (dot >= 0) { ipart = body.Substring(0, dot); fpart = body.Substring(dot); }
        if (col.grouped) { ipart = DataTable.GroupDigits(ipart); }
        return sign + col.prefix + ipart + fpart + col.suffix;
    }

    // ---- 内联单元格编辑 ----

    /// 接受可选的前导 '-'、十进制数字和至多一个 '.'（至少一个数字）。
    static bool IsNumericStr(string s) {
        if (s.Length == 0) { return false; }
        int i = 0;
        if ((int)s[0] == 45) { i = 1; }
        if (i >= s.Length) { return false; }
        int dots = 0;
        while (i < s.Length) {
            int cc = (int)s[i];
            if (cc == 46) { dots = dots + 1; if (dots > 1) { return false; } }
            else if (cc < 48 || cc > 57) { return false; }
            i = i + 1;
        }
        return true;
    }

    /// 按列的声明式规则校验值，返回
    /// 拒绝信息；通过时返回“”。顺序很重要：先报空值，
    /// 再报格式，最后报范围，让用户始终看到
    /// 最根本的问题。
    static string ValidateCell(DataColumn c, string v) {
        string trimmed = DataTable.TrimSpace(v);
        if (c.required && trimmed.Length == 0) { return "Value required"; }
        if (c.maxLength > 0 && v.Length > c.maxLength) {
            return "At most " + Convert.ToString(c.maxLength) + " characters";
        }
        // 可选列的空值跳过值相关规则：“未输入”
        // 不同于“输入格式错误”。
        if (trimmed.Length == 0) { return ""; }
        if (c.isDate) {
            if (DataTable.ParseDate(trimmed, c.dateOrder) == DataTable.NoDate()) {
                return "Not a valid date";
            }
            return "";
        }
        if (c.numeric) {
            if (!DataTable.IsNumericStr(trimmed)) { return "Must be a number"; }
            double n = DataTable.ParseReal(trimmed);
            if (c.hasMin && n < c.editMin) {
                return "Must be >= " + DataTable.FormatReal(c.editMin, c.decimals);
            }
            if (c.hasMax && n > c.editMax) {
                return "Must be <= " + DataTable.FormatReal(c.editMax, c.decimals);
            }
        }
        if (c.editorKind == 1 && c.choicesStrict) {
            for (int i = 0; i < c.choices.Count; i = i + 1) {
                if (DataTable.EqCI(c.choices[i], trimmed)) { return ""; }
            }
            return "Not a listed value";
        }
        return "";
    }

    /// 与 `typed` 匹配（不区分大小写的
    /// 子串匹配）的下拉选项索引。空文本匹配所有项，打开编辑器时显示
    /// 完整列表。
    static List<int> FilterChoices(DataColumn c, string typed) {
        List<int> hits = new List<int>();
        string q = DataTable.TrimSpace(typed);
        for (int i = 0; i < c.choices.Count; i = i + 1) {
            if (q.Length == 0 || DataTable.ContainsCI(c.choices[i], q)) { hits.Add(i); }
        }
        return hits;
    }

    /// 按 `dir` 步进数字编辑器缓冲区，并夹紧到列的
    /// 声明边界内。非数字缓冲区从下界（或 0）开始，
    /// 确保微调器总是产生有效值。
    static string StepValue(DataColumn c, string cur, int dir) {
        string t = DataTable.TrimSpace(cur);
        double v = 0.0;
        if (t.Length > 0 && DataTable.IsNumericStr(t)) { v = DataTable.ParseReal(t); }
        else if (c.hasMin) { v = c.editMin; dir = 0; }
        v = v + c.editStep * (double)dir;
        if (c.hasMin && v < c.editMin) { v = c.editMin; }
        if (c.hasMax && v > c.editMax) { v = c.editMax; }
        return DataTable.FormatReal(v, c.decimals);
    }

    // ---- 日历辅助（editorKind 2） ----
    /// 将年和月打包成日历跟踪的单个 int。
    static int YearMonth(int y, int m) { return y * 12 + (m - 1); }
    /// 解出打包年月中的年份。
    static int YmYear(int ym) { return DateTime.FloorDiv(ym, 12); }
    /// 解出打包年月中的月份（1–12）。
    static int YmMonth(int ym) { return DateTime.FloorMod(ym, 12) + 1; }

    /// 某月 1 号的星期几，0 = 周日。纪元第 0 天是
    /// 星期四，因此有 +4。
    static int MonthFirstDow(int ym) {
        int d = DateTime.DaysFromCivil(DataTable.YmYear(ym), DataTable.YmMonth(ym), 1);
        return DateTime.FloorMod(d + 4, 7);
    }

    /// 月网格的 42 个单元格以日号表示，属于
    /// 相邻月份处为 0。固定六行，网格永不回流。
    static List<int> MonthCells(int ym) {
        List<int> cells = new List<int>();
        int lead = DataTable.MonthFirstDow(ym);
        int dim = DateTime.DaysInMonth(DataTable.YmYear(ym), DataTable.YmMonth(ym));
        for (int i = 0; i < 42; i = i + 1) {
            int day = i - lead + 1;
            if (day < 1 || day > dim) { cells.Add(0); } else { cells.Add(day); }
        }
        return cells;
    }
}
