using System;
using Gui;
using Gui.Widget;
using Gui.Backend;

namespace Gui.Component.DataTable;

/// DataTable 模块：单元格渲染（条件格式、单元格类型）
/// 与虚拟化的主渲染路径（表头 / 主体 / 页脚 /
/// 交互）。
partial class DataTable {
    // ---------- 拖动手柄 ----------

    /// 在 bx,by,bw,bh 内居中画一个 2×3 点阵的拖动手柄（列头 /
    /// 行号的专用拖动按钮）。用点阵而不是字体图标，
    /// 是因为图标集里没有 gripper 码点，而点阵在小尺寸下
    /// 也不会糊成一团。
    static void DrawGrip(App app, int bx, int by, int bw, int bh, int color) {
        Canvas c = app.canvas;
        int d = app.Scale(2);
        int gap = app.Scale(2);
        int gw = d * 2 + gap;
        int gh = d * 3 + gap * 2;
        int gx = bx + (bw - gw) / 2;
        int gy = by + (bh - gh) / 2;
        int row = 0;
        while (row < 3) {
            int col = 0;
            while (col < 2) {
                c.FillRect(gx + col * (d + gap), gy + row * (d + gap), d, d, color);
                col = col + 1;
            }
            row = row + 1;
        }
    }

    // ---------- 单元格渲染 ----------

    /// `fgOverride` 是 state 的 CellStyler 给出的打包颜色，0 表示
    /// 无。它替换普通和链接单元格的主题文本色，但
    /// 条件格式颜色仍然优先——在那里，颜色*就是*
    /// 单元格携带的信息。
    static void DrawCell(App app, DataColumn col, string val, int cx, int cy, int cw, int rowH, double cfLo, double cfHi, int fgOverride) {
        DataTable.DrawCellRangeCtx(app, col, val, cx, cy, cw, rowH, cfLo, cfHi, fgOverride, -1, -1, null);
    }

    /// 带行/列上下文的渲染入口：按钮列（cellType 7）的点击
    /// 需要行号和列号填充 HitRow/HitCol。主渲染路径走这里；
    /// 无上下文的调用方仍可用 DrawCell / DrawCellIndented。
    static void DrawCellCtx(App app, DataColumn col, string val, int cx, int cy, int cw, int rowH, double cfLo, double cfHi, int fgOverride, int rowIdx, int cc) {
        DataTable.DrawCellRangeCtx(app, col, val, cx, cy, cw, rowH, cfLo, cfHi, fgOverride, rowIdx, cc, null);
    }

    /// 树模式单元格：`indent` 层级换成左缩进；`isTreeCol`
    /// 的行首绘制展开箭头（叶子行留空白边距）。其余
    /// 列照常渲染——树列之外不受影响。
    static void DrawCellIndented(App app, DataColumn col, string val, int cx, int cy, int cw, int rowH,
                                 double cfLo, double cfHi, int fgOverride,
                                 int indent, bool isTreeCol, bool canExpand, bool expanded) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int pad = t.paddingSmall;
        // 树列的箭头占掉缩进头部：每层 16 逻辑像素。
        int indentPx = indent * app.Scale(16);
        if (isTreeCol && canExpand) {
            int exSz = app.Scale(12);
            int exX = cx + pad + indentPx;
            int exY = cy + (rowH - exSz) / 2;
            string chev = "chevron-down";
            if (!expanded) { chev = "chevron-right"; }
            c.DrawGlyph(chev, exX, exY, exSz, Style.Part(app, "datatable", "icon", "", "", "",
                                                         Style.SNormal()).FgOr(0));
            indentPx = indentPx + app.Scale(16);
        } else if (isTreeCol) {
            // 叶子行：与兄弟的箭头对齐的空白边距。
            indentPx = indentPx + app.Scale(16);
        }
        // 走原渲染器：把缩进折进 x/宽（条件格式、格式化、
        // 对齐全部保持原语义），箭头/缩进已画的部分靠
        // 负偏移保护不被文本覆盖。
        int inner = cx + indentPx;
        DataTable.DrawCellRangeCtx(app, col, val, inner, cy, cw - indentPx, rowH, cfLo, cfHi, fgOverride, -1, -1, null);
    }

    /// DrawCell 的主体（缩进版把 x/宽收缩后委托到这里）。
    /// 交互列（按钮，cellType 7）需要行/列上下文来填充
    /// CellClick 的事件语义：`rowIdx` 是数据行号，`cc` 是列号
    /// （-1 表示调用方没有行上下文——如独立的单元格渲染器，
    /// 此时按钮点击仅Raise事件，不设置 HitRow/HitCol）。
    static void DrawCellRange(App app, DataColumn col, string val, int cx, int cy, int cw, int rowH, double cfLo, double cfHi, int fgOverride) {
        DataTable.DrawCellRangeCtx(app, col, val, cx, cy, cw, rowH, cfLo, cfHi, fgOverride, -1, -1, null);
    }

    static void DrawCellRangeCtx(App app, DataColumn col, string val, int cx, int cy, int cw, int rowH, double cfLo, double cfHi, int fgOverride, int rowIdx, int cc, DataTableState st) {
        DataTable.DrawCellRangeCtx(app, col, val, cx, cy, cw, rowH, cfLo, cfHi, fgOverride, rowIdx, cc, st, null);
    }

    /// 带 `src` 的主入口：组件列（cellType 9）需要数据源取稳定
    /// 行键做控件池化；其余 cellType 忽略它。
    static void DrawCellRangeCtx(App app, DataColumn col, string val, int cx, int cy, int cw, int rowH, double cfLo, double cfHi, int fgOverride, int rowIdx, int cc, DataTableState st, DataSource src) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int fs = Style.FontFallback(app, "medium");
        int pad = t.paddingSmall;
        int innerW = cw - pad * 2;
        StyleBox sCell = Style.Part(app, "datatable", "cell", "", "", "",
                                    Style.SNormal());

        // ---- 条件格式（仅纯文本/数值单元格）----
        int cfText = sCell.FgOr(0);
        if (fgOverride != 0) { cfText = fgOverride; }
        if (col.cfMode != 0 && col.cellType == 0) {
            double v = DataTable.ParseReal(val);
            if (col.cfMode == 1) {
                // 数据条按值在列的 min..max 范围内成比例
                double span = cfHi - cfLo;
                if (span <= 0.0) { span = 1.0; }
                int frac = (int)((v - cfLo) * 100.0 / span);
                if (frac < 0) { frac = 0; }
                if (frac > 100) { frac = 100; }
                int barH = rowH - app.Scale(8);
                int barY = cy + app.Scale(4);
                int barW = frac * innerW / 100;
                int tint = DataTable.ColorAlpha(col.cfColor, 95);
                int rad = app.Scale(2);
                if (barW > 0) {
                    // 带轻微圆角的简洁扁平数据条；条太短无法圆角时
                    // 回退为普通矩形，避免
                    // 直线段计算下溢。
                    if (barW < rad * 2) { c.FillRect(cx + pad, barY, barW, barH, tint); }
                    else { c.FillRoundRect(cx + pad, barY, barW, barH, rad, tint); }
                }
                string sb = DataTable.Truncate(DataTable.FormatCell(col, val), fs, innerW);
                int twb = Canvas.MeasureText(sb, fs);
                int tyb = Canvas.CenterTextY(cy, rowH, fs);
                c.DrawText(cx + cw - pad - twb, tyb, sb, cfText, fs);
                return;
            } else if (col.cfMode == 2) {
                // 把 0..1 位置缩放到 0..1000 整数梯度，
                // 使 lerp 保持整数签名，小数列仍能
                // 在渐变上铺开。
                double cspan = cfHi - cfLo;
                if (cspan <= 0.0) { cspan = 1.0; }
                int pos = (int)((v - cfLo) * 1000.0 / cspan);
                if (pos < 0) { pos = 0; }
                if (pos > 1000) { pos = 1000; }
                c.FillRect(cx, cy, cw, rowH, DataTable.LerpColor(col.cfColor, col.cfColor2, pos, 1000));
            } else if (col.cfMode == 3 && v > (double)col.cfThreshold) {
                c.FillRect(cx, cy, cw, rowH, DataTable.ColorAlpha(col.cfColor, 38));
                cfText = col.cfColor;
            } else if (col.cfMode == 4 && v < (double)col.cfThreshold) {
                c.FillRect(cx, cy, cw, rowH, DataTable.ColorAlpha(col.cfColor, 38));
                cfText = col.cfColor;
            }
        }

        // ---- 布尔：复选框、对勾/叉字形或纯文本 ----
        if (col.isBool) {
            bool on = DataTable.ParseBool(val);
            if (col.boolStyle == 2) {
                string bt = col.boolFalse;
                if (on) { bt = col.boolTrue; }
                int btw = Canvas.MeasureText(bt, fs);
                int btx = cx + (cw - btw) / 2;
                if (col.align == 0) { btx = cx + pad; }
                if (col.align == 2) { btx = cx + cw - pad - btw; }
                c.DrawText(btx, Canvas.CenterTextY(cy, rowH, fs), bt, cfText, fs);
                return;
            }
            int box = app.Scale(16);
            int bx = cx + (cw - box) / 2;
            int by = cy + (rowH - box) / 2;
            int ins = app.Scale(3);
            if (col.boolStyle == 1) {
                // 字形样式：无边框，只有绿色对勾或淡色叉。
                string mcls = "";
                if (!on) { mcls = "off"; }
                StyleBox mark = Style.Part(app, "datatable", "mark", "", mcls, "",
                                           Style.SNormal());
                string mIco = "close";
                if (on) { mIco = "check"; }
                c.DrawGlyph(mIco, bx + ins, by + ins, box - ins * 2, mark.FgOr(0));
                return;
            }
            // 与真正的复选框吃同一套 checkbox::box / ::check 皮肤规则。
            int lvl = 0;
            if (on) { lvl = 1000; }
            Checkbox.PaintBox(app, bx, by, box, lvl);
            return;
        }

        // ---- 图片：contain 缩放居中；http(s) URL 经 ImageHttp
        // 后台取回（就绪后整帧重绘），加载中与失败画淡色占位。
        if (col.cellType == 5) {
            string src = val;
            if (src.Length >= 8 && (src.Substring(0, 7) == "http://"
                                    || src.Substring(0, 8) == "https://")) {
                src = ImageHttp.EnsureUrl(app, src);
            }
            int iw = 0;
            int ih = 0;
            if (src != null && src != "") {
                iw = Canvas.ImageWidth(src);
                ih = Canvas.ImageHeight(src);
            }
            int boxW = cw - pad * 2;
            int boxH = rowH - app.Scale(4);
            if (boxH < app.Scale(6)) { boxH = app.Scale(6); }
            if (iw > 0 && ih > 0 && boxW > 0) {
                int dw = boxW;
                int dh = boxW * ih / iw;
                if (dh > boxH) {
                    dh = boxH;
                    dw = boxH * iw / ih;
                }
                if (dw < 1) { dw = 1; }
                if (dh < 1) { dh = 1; }
                c.BlitImage(src, cx + (cw - dw) / 2, cy + (rowH - dh) / 2,
                            dw, dh, 0, 0, 0, 0);
            } else {
                // 占位：格内淡色圆角块（URL 取回中 / 取回失败 /
                // 空值共用；不区分文案，保持列表浏览的信息密度）。
                int phW = boxW;
                if (phW > app.Scale(28)) { phW = app.Scale(28); }
                int phH = boxH;
                if (phH > app.Scale(20)) { phH = app.Scale(20); }
                if (phW > 0) {
                    StyleBox ph = Style.Part(app, "datatable",
                                             "progress-track", "", "", "",
                                             Style.SNormal());
                    c.FillRoundRect(cx + (cw - phW) / 2,
                                    cy + (rowH - phH) / 2, phW, phH,
                                    t.borderRadiusSmall, ph.BgOr(0));
                }
            }
            return;
        }

        if (col.cellType == 3) {
            int pct = DataTable.ParseInt(val);
            if (pct < 0) { pct = 0; }
            if (pct > 100) { pct = 100; }
            int barH = app.Scale(6);
            int barY = cy + (rowH - barH) / 2;
            int barW = innerW - app.Scale(40);
            if (barW < app.Scale(20)) { barW = app.Scale(20); }
            StyleBox track = Style.Part(app, "datatable", "progress-track", "",
                                        "", "", Style.SNormal());
            c.FillRoundRect(cx + pad, barY, barW, barH, barH / 2, track.BgOr(0));
            int fillW = pct * barW / 100;
            string pcls = "";
            if (pct >= 100) { pcls = "done"; }
            StyleBox fill = Style.Part(app, "datatable", "progress-fill", "",
                                       pcls, "", Style.SNormal());
            c.FillRoundRect(cx + pad, barY, fillW, barH, barH / 2, fill.BgOr(0));
            StyleBox pctS = Style.Part(app, "datatable", "cell", "", "secondary",
                                       "", Style.SNormal());
            int txtY = Canvas.CenterTextY(cy, rowH, Style.FontFallback(app, "small"));
            c.DrawText(cx + pad + barW + app.Scale(6), txtY, Convert.ToString(pct) + "%", pctS.FgOr(0), Style.FontFallback(app, "small"));
            return;
        }

        if (col.cellType == 2) {
            int tc = DataTable.TypeColor(app, col.tagType);
            StyleBox tagS = Style.Part(app, "datatable", "tag", "", "", "",
                                       Style.SNormal());
            int tagH = t.heightSmall;
            int tagY = cy + (rowH - tagH) / 2;
            string label = DataTable.Truncate(val, Style.FontFallback(app, "small"), innerW - pad * 2);
            int tagW = Canvas.MeasureText(label, Style.FontFallback(app, "small")) + pad * 2;
            int tagX = cx + pad;
            if (col.align == 1) { tagX = cx + (cw - tagW) / 2; }
            c.FillRoundRect(tagX, tagY, tagW, tagH, t.borderRadiusSmall, tagS.BgOr(0));
            c.DrawRoundRect(tagX, tagY, tagW, tagH, t.borderRadiusSmall, tc, 1);
            int txtY = Canvas.CenterTextY(tagY, tagH, Style.FontFallback(app, "small"));
            c.DrawText(tagX + pad, txtY, label, tc, Style.FontFallback(app, "small"));
            return;
        }

        if (col.cellType == 4) {
            int dotR = app.Scale(4);
            string dcls = "";
            if (val == "0" || val == "" || val == "Offline" || val == "Idle" || val == "Inactive" || val == "Closed") { dcls = "off"; }
            int dotColor = Style.Part(app, "datatable", "mark", "", dcls, "",
                                      Style.SNormal()).FgOr(0);
            int cxc = cx + pad + dotR;
            if (col.align == 1) { cxc = cx + cw / 2 - Canvas.MeasureText(val, fs) / 2 - dotR - app.Scale(4); }
            c.FillCircle(cxc, cy + rowH / 2, dotR, dotColor);
            int txtY = Canvas.CenterTextY(cy, rowH, fs);
            c.DrawText(cxc + dotR + app.Scale(4), txtY, val, cfText, fs);
            return;
        }

        // ---- 图标：单元格值即 tabler 图标名，居中绘制 ----
        if (col.cellType == 6) {
            if (val != "") {
                int gsz = app.Scale(16);
                int gcol = cfText;
                if (fgOverride == 0) {
                    gcol = Style.Part(app, "datatable", "icon", "", "", "",
                                      Style.SNormal()).FgOr(0);
                }
                c.DrawGlyph(val, cx + (cw - gsz) / 2, cy + (rowH - gsz) / 2, gsz, gcol);
            }
            return;
        }

        // ---- 迷你图：逗号分隔数值序列 -> 格内等槽位迷你柱状图 ----
        if (col.cellType == 8) {
            List<string> seq = DataTable.NumSeries(val);
            int n = seq.Count;
            if (n > 0) {
                int plotW = innerW;
                if (plotW < app.Scale(8)) { plotW = app.Scale(8); }
                int plotH = rowH - app.Scale(8);
                if (plotH < app.Scale(4)) { plotH = app.Scale(4); }
                int plotX = cx + pad;
                int plotY = cy + app.Scale(4);
                int mx = 0;
                for (int si = 0; si < n; si = si + 1) {
                    int av = DataTable.ParseInt(seq[si]);
                    if (av < 0) { av = 0 - av; }
                    if (av > mx) { mx = av; }
                }
                if (mx < 1) { mx = 1; }
                int accent = Style.Part(app, "datatable", "accent", "", "", "",
                                        Style.SNormal()).FgOr(0);
                int slotW = plotW / n;
                if (slotW < 1) { slotW = 1; }
                int barW = slotW * 3 / 5;
                if (barW < 1) { barW = 1; }
                int areaTint = DataTable.ColorAlpha(accent, 45);
                for (int bi = 0; bi < n; bi = bi + 1) {
                    int bv = DataTable.ParseInt(seq[bi]);
                    if (bv < 0) { bv = 0 - bv; }
                    int bh = bv * plotH / mx;
                    if (bh < 1 && bv > 0) { bh = 1; }
                    int slotL = plotX + slotW * bi;
                    int bxc = slotL + (slotW - barW) / 2;
                    int byc = plotY + plotH - bh;
                    if (col.sparkArea && bv > 0 && bh >= 1) {
                        c.FillRect(bxc, plotY, barW, plotH, areaTint);
                    }
                    c.FillRect(bxc, byc, barW, bh, accent);
                }
            }
            return;
        }

        // ---- 组件：值序列灌进池化真控件（见 CellComp）----
        if (col.cellType == 9 && st != null) {
            DataTable.DrawCompCell(app, col, val, cx, cy, cw, rowH,
                                   rowIdx, cc, src, st);
            return;
        }
        if (col.cellType == 9 && st == null) {
            // 独立渲染入口（无 state）：无数据源键与事件上下文，
            // 画序列的静态占位（与加载中图片同语义的极简回退）。
            List<string> seqC = DataTable.NumSeries(val);
            int accC = Style.Part(app, "datatable", "accent", "", "", "",
                                  Style.SNormal()).FgOr(0);
            int n9 = seqC.Count;
            if (n9 < 1) { n9 = 1; }
            int slotC = innerW / n9;
            if (slotC < 1) { slotC = 1; }
            for (int ci = 0; ci < n9; ci = ci + 1) {
                int cv = 0;
                if (ci < seqC.Count) { cv = DataTable.ParseInt(seqC[ci]); }
                if (cv > 0) {
                    int chC = (rowH - app.Scale(8)) * cv / 5;
                    if (chC > rowH - app.Scale(8)) { chC = rowH - app.Scale(8); }
                    if (chC < 2) { chC = 2; }
                    c.FillRect(cx + pad + slotC * ci,
                               cy + rowH - app.Scale(4) - chC,
                               slotC - 1, chC, accC);
                }
            }
            return;
        }

        // ---- 按钮：整格居中一个 small 按钮，点击 -> CellClick ----
        if (col.cellType == 7) {
            string label = val;
            string icon = col.btnIcon;
            int bh = t.heightSmall;
            int bw = app.Scale(24);
            int bFont = Style.FontFallback(app, "small");
            if (label != "") {
                int tw2 = Canvas.MeasureText(label, bFont);
                bw = tw2 + app.Scale(20);
                if (icon != "") { bw = bw + app.Scale(14) + t.gapSmall; }
            } else if (icon != "") {
                bw = app.Scale(26);
            }
            if (bw > innerW) { bw = innerW; }
            if (bw < app.Scale(16)) { bw = app.Scale(16); }
            int bxc = cx + (cw - bw) / 2;
            int byc = cy + (rowH - bh) / 2;
            string cls = col.btnClass;
            if (cls != "") { cls = "small " + cls; } else { cls = "small"; }
            int bId = app.focus.AllocId();
            bool bHot = app.focus.IsHovered(bId);
            StyleBox bs = Style.Part(app, "datatable", "button", "", cls, "",
                                     Style.SNormal());
            if (bHot) {
                bs = Style.Part(app, "datatable", "button", "", cls, "",
                                Style.SHover());
            }
            int rad = bs.RadiusOr(t.borderRadiusSmall);
            c.FillRoundRect(bxc, byc, bw, bh, rad, bs.BgOr(0));
            int contentW = 0;
            int iconSz = app.Scale(14);
            int labelW = 0;
            if (label != "") { labelW = Canvas.MeasureText(label, bFont); }
            if (icon != "" && label != "") {
                contentW = iconSz + t.gapSmall + labelW;
            } else if (icon != "") {
                contentW = iconSz;
            } else {
                contentW = labelW;
            }
            int cx0 = bxc + (bw - contentW) / 2;
            int bFg = bs.FgOr(0);
            if (icon != "") {
                c.DrawGlyph(icon, cx0, byc + (bh - iconSz) / 2, iconSz, bFg);
                cx0 = cx0 + iconSz + t.gapSmall;
            }
            if (label != "") {
                c.DrawText(cx0, Canvas.CenterTextY(byc, bh, bFont), label, bFg, bFont);
            }
            // 点击：注册热区 + 键盘激活，命中后把事件上下文指向
            // 本格再 Raise CellClick——处理器与普通单元格点击
            // 读取同一份 HitRow()/HitCol()。st 为 null 的调用方
            // （独立渲染入口）只触发事件，不填事件上下文。
            if (Ui.Activate(app, bId, bxc, byc, bw, bh)) {
                if (st != null && rowIdx >= 0 && cc >= 0) {
                    st.hitRow = rowIdx;
                    st.hitCol = cc;
                }
                if (st != null) { st.CellClick.Raise(); }
                app.RequestRedraw();
            }
            return;
        }

        int color = cfText;
        if (col.cellType == 1 && fgOverride == 0) {
            color = Style.Part(app, "datatable", "cell", "", "link", "",
                               Style.SNormal()).FgOr(0);
        }
        string shown = DataTable.Truncate(DataTable.FormatCell(col, val), fs, innerW);
        int tw = Canvas.MeasureText(shown, fs);
        int tx = cx + pad;
        if (col.align == 1) { tx = cx + (cw - tw) / 2; }
        if (col.align == 2) { tx = cx + cw - pad - tw; }
        int ty = Canvas.CenterTextY(cy, rowH, fs);
        c.DrawText(tx, ty, shown, color, fs);
    }

    // ---------- 冻结 band 几何 ----------
    // 数据区域是三个并排条带：0 左冻结，1 滚动，
    // 2 右冻结。每个流程都向这三者索要自己的条带，而非
    // 重新计算，因此表头、筛选行、单元格和汇总
    // 不会错位。

    static int BandLeft(int band, int firstDataX, int bandX, int rightX) {
        if (band == 0) { return firstDataX; }
        if (band == 2) { return rightX; }
        return bandX;
    }

    static int BandRight(int band, int firstDataX, int bandX, int bandW,
                         int rightX, int pinnedW, int pinnedRW, int clipRight) {
        if (band == 0) { return firstDataX + pinnedW; }
        if (band == 2) { return rightX + pinnedRW; }
        int r = bandX + bandW;
        if (r > clipRight) { r = clipRight; }
        return r;
    }

    static void PushBandClip(Canvas c, int band, int firstDataX, int bandX, int bandW,
                             int rightX, int pinnedW, int pinnedRW,
                             int y, int h, int clipRight) {
        int l = DataTable.BandLeft(band, firstDataX, bandX, rightX);
        int r = DataTable.BandRight(band, firstDataX, bandX, bandW, rightX,
                                    pinnedW, pinnedRW, clipRight);
        int w = r - l;
        if (w < 0) { w = 0; }
        c.PushClip(l, y, w, h);
    }

    // ---------- 分组面板 ----------

    /// 分组面板芯片的 x 位置和宽度，由外到内。
    /// 条带绘制、命中测试和表头拖放共用，三者
    /// 几何上天然一致。
    static List<GroupChipGeometry> GroupChipLayout(App app, List<DataColumn> cols,
                                                   DataTableState st, int x) {
        Theme t = app.theme;
        int fs = Style.FontFallback(app, "small");
        List<GroupChipGeometry> chips = new List<GroupChipGeometry>();
        int cx = x + app.Scale(10);
        for (int i = 0; i < st.groupCols.Count; i = i + 1) {
            int w = Canvas.MeasureText(cols[st.groupCols[i]].title, fs) + app.Scale(38);
            chips.Add(new GroupChipGeometry(cx, w));
            cx = cx + w + app.Scale(8);
        }
        return chips;
    }

    /// 指针指向的插入槽位（0..count）：中点位于
    /// 指针左侧的芯片数量。
    static int GroupDropSlot(App app, List<GroupChipGeometry> chips) {
        int slot = 0;
        for (int i = 0; i < chips.Count; i = i + 1) {
            GroupChipGeometry chip = chips[i];
            if (app.mouseX > chip.x + chip.width / 2) { slot = i + 1; }
        }
        return slot;
    }

    /// 表头上方的分组条带：每个分组列一个芯片
    /// （由外到内），带移除按钮；有内容拖过时显示插入指示，
    /// 未分组时显示提示。
    /// 列头被拖动期间 `headerDrag` 为 true，条带
    /// 可标示自己为放置目标。
    static void RenderGroupPanel(App app, int x, int y, int viewW, int h,
                                 List<DataColumn> cols, DataTableState st,
                                 bool headerDrag) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int fs = Style.FontFallback(app, "small");
        bool over = app.mouseX >= x && app.mouseX < x + viewW
                    && app.mouseY >= y && app.mouseY < y + h;
        int panelState = Style.SNormal();
        if (headerDrag && over) { panelState = Style.SActive(); }
        StyleBox sPanel = Style.Part(app, "datatable", "panel", "", "", "",
                                     panelState);
        StyleBox sGrid = Style.Part(app, "datatable", "grid", "", "", "",
                                    Style.SNormal());
        StyleBox sHint = Style.Part(app, "datatable", "hint", "", "", "",
                                    Style.SNormal());
        StyleBox sChip = Style.Part(app, "datatable", "chip", "", "", "",
                                    Style.SNormal());
        StyleBox sChipDrag = Style.Part(app, "datatable", "chip", "", "", "",
                                        Style.SSelected());
        StyleBox sAccent = Style.Part(app, "datatable", "accent", "", "", "",
                                      Style.SNormal());
        c.FillRect(x, y, viewW, h, sPanel.BgOr(0));
        c.FillRect(x, y + h - 1, viewW, 1, sGrid.BgOr(0));
        c.PushClip(x, y, viewW, h);

        // 列选择器入口：条带右缘的 "Columns" 按钮。勾选列表
        // 就是分组/隐藏/重排的统一面板，商业网格的惯例是
        // 常驻可见而非藏进右键菜单。
        int ccBtnW = app.Scale(74);
        int ccBtnH = h - app.Scale(12);
        int ccBtnX = x + viewW - ccBtnW - app.Scale(6);
        int ccBtnY = y + app.Scale(6);
        if (DataTable.TextBtn(app, ccBtnX, ccBtnY, ccBtnW, ccBtnH, DataTable.T("Columns", "Columns"), false)) {
            DataTable.SetColumnChooser(st, !st.colChooserOpen);
            app.RequestRedraw();
        }
        int panelContentW = ccBtnX - x - app.Scale(6);

        List<GroupChipGeometry> chips = DataTable.GroupChipLayout(app, cols, st, x);
        int chipH = h - app.Scale(10);
        int chipY = y + app.Scale(5);

        if (st.groupCols.Count == 0) {
            c.DrawText(x + app.Scale(10), Canvas.CenterTextY(y, h, fs),
                       DataTable.Truncate("Drag a column header here to group by it",
                                          fs, panelContentW - app.Scale(20)),
                       sHint.FgOr(0), fs);
        }

        for (int i = 0; i < st.groupCols.Count; i = i + 1) {
            int col = st.groupCols[i];
            GroupChipGeometry chip = chips[i];
            int cxp = chip.x;
            int cwp = chip.width;
            bool dragged = st.dragChip == col;
            int fill = sChip.BgOr(0);
            if (dragged) { fill = sChipDrag.BgOr(0); }
            c.FillRoundRect(cxp, chipY, cwp, chipH, chipH / 2, fill);
            int lc = sChip.FgOr(0);
            if (dragged) { lc = sChipDrag.FgOr(0); }
            int rsz = app.Scale(14);
            int rx = cxp + cwp - rsz - app.Scale(6);
            int ry = chipY + (chipH - rsz) / 2;
            string lbl = DataTable.Truncate(cols[col].title, fs,
                                            rx - cxp - app.Scale(14));
            c.DrawText(cxp + app.Scale(10),
                       Canvas.CenterTextY(chipY, chipH, fs), lbl, lc, fs);
            int rmId = app.focus.AllocId();
            c.DrawGlyphIn("close", rx, ry, rsz, rsz, app.Scale(10), lc);
            app.hitTester.RegisterRect(rmId, rx, ry, rsz, rsz, 0);
            int chipId = app.focus.AllocId();
            app.hitTester.RegisterRect(chipId, cxp, chipY,
                                                    rx - cxp, chipH, 0);
            if (app.EventKind() == 3 && app.window.EventButton() == 0
                && app.hitTester.HitTest(app.mouseX, app.mouseY) == rmId) {
                DataTable.UngroupOne(st, col);
                st.GroupChanged.Raise();
                app.RequestRedraw();
            }
            if (app.EventKind() == 2 && app.window.EventButton() == 0
                && app.hitTester.HitTest(app.mouseX, app.mouseY) == chipId) {
                st.dragChip = col;
                app.RequestRedraw();
            }
        }

        if (st.dragChip >= 0 || (headerDrag && over)) {
            int slot = DataTable.GroupDropSlot(app, chips);
            int lineX = x + app.Scale(6);
            if (slot > 0) {
                GroupChipGeometry previous = chips[slot - 1];
                lineX = previous.x + previous.width + app.Scale(2);
            }
            c.FillRect(lineX, chipY, app.Scale(2), chipH, sAccent.BgOr(0));
        }
        c.PopClip();

        // 松开时完成芯片拖放（App 会先于本次渲染清除按下状态，
        // 与表头拖动的情形完全一致）。
        if (st.dragChip >= 0 && app.focus.pressedId < 0) {
            int from = DataTable.GroupDepth(st, st.dragChip);
            int dst = DataTable.GroupDropSlot(app, chips);
            if (dst > from) { dst = dst - 1; }
            if (from >= 0 && dst != from) {
                DataTable.MoveGroup(st, st.dragChip, dst);
                st.GroupChanged.Raise();
            }
            st.dragChip = -1;
            app.RequestRedraw();
        }
    }

    // ---------- 主渲染 ----------

    /// 便捷重载：渲染内存中的 List<DataRow>（包装为
    /// RowListSource）。大数据 / 虚拟数据请改用 RenderSource 配合自定义
    /// DataSource 子类。
    static void Render(App app, int x, int y, int viewW, int viewH,
                       List<DataColumn> cols, List<DataRow> rows, DataTableState st) {
        DataTable.RenderSource(app, x, y, viewW, viewH, cols, new RowListSource(rows), st);
    }

    /// 渲染前奏：把全部每帧布局几何解析到
    /// DataTableFrame——确保/同步/重算状态、表头与 band 度量、
    /// 行号/选择边栏、冻结 band 宽度和各列屏幕 x，
    /// 并绘制分组面板。之后的流程都读取 frame，
    /// 不再重算几何。
    static DataTableFrame ComputeFrame(App app, int x, int y, int viewW, int viewH,
                       List<DataColumn> cols, DataSource src, DataTableState st) {
        Canvas c = app.canvas;
        Theme t = app.theme;

        // 服务端数据源在帧间交付数据（完成的块、
        // 事务、固定的总数）。合并后重算，
        // 新行无需用户操作即可在本帧重绘中出现。
        if (src.Poll()) {
            st.dirty = true;
            app.RequestRedraw();
        }
        // 预取首块：总数未知的源初始为空，
        // 需立即请求初始块，否则网格在用户滚动前
        // 不会显示任何内容。
        if (src.HasMore() && src.RowCount() == 0) { src.RequestBlock(0); }

        DataTable.EnsureInit(st, cols, src);
        DataTable.SyncBindings(st, src);
        DataTable.Recompute(st, cols, src);

        int titleRowH = t.heightMedium;
        int rowH = t.heightMedium;
        int fs = Style.FontFallback(app, "medium");
        // 紧凑密度：st.rowH 以逻辑像素给出数据行/表头行高，
        // 0 表示沿用主题的 heightMedium。
        if (st.rowH > 0) {
            rowH = app.Scale(st.rowH);
            titleRowH = rowH;
        }
        // band 行位于列标题上方且略矮——
        // 只带组名，没有排序箭头或筛选图标。`headerH` 保持
        // 完整表头高度，后续所有测量（主体顶部、菜单
        // 锚点、外部点击测试）无需改动。
        int bandRowH = t.heightSmall;
        int bandLevels = 0;
        int headerH = titleRowH;

        // 分组面板是表头上方的条带，会把表头的
        // 顶边下移，而 `y` 仍是控件自身的顶部。下面所有垂直
        // 测量都从 `hdrY` 起算；条带隐藏时 `hdrY` 等于 `y`，
        // 没有面板的表格布局与之前完全相同。
        int groupPanelH = 0;
        if (st.showGroupPanel) { groupPanelH = app.Scale(34); }
        int hdrY = y + groupPanelH;
        int panelY = y;
        if (st.showGroupPanel) {
            DataTable.RenderGroupPanel(app, x, panelY, viewW, groupPanelH, cols, st,
                                       st.dragCol >= 0 && st.dragColMoved);
        }
        y = hdrY;
        viewH = viewH - groupPanelH;

        int numW = 0;
        if (st.showRowNum) {
            // 宽度足以容纳最大行号，7 位数计数也
            // 不会溢出到相邻列。
            numW = app.Scale(46);
            int needW = Canvas.MeasureText(Convert.ToString(src.RowCount()), Style.FontFallback(app, "small"))
                        + app.Scale(16);
            if (needW > numW) { numW = needW; }
        }
        int selW = 0;
        if (st.showSelect) { selW = app.Scale(40); }

        int gridColor = Style.Part(app, "datatable", "grid", "", "", "",
                                   Style.SNormal()).BgOr(0);
        int menuIconW = app.Scale(14);

        // 内容不得溢出的右边界（为
        // 垂直滚动条留位）。右缘超出此限的列被
        // 钳制，起点在此之后的列被跳过——
        // 单元格和表头永远不会画出表格边框。
        int sbGutter = app.Scale(12);
        int clipRight = x + viewW - sbGutter;

        // 数据总宽度（隐藏列不计入）
        int dataW = 0;
        for (int ci = 0; ci < st.colWidths.Count; ci = ci + 1) {
            if (!st.colHidden[ci]) { dataW = dataW + st.colWidths[ci]; }
        }
        int totalW = numW + selW + dataW;

        // 列保持自然宽度；总宽超过
        // 可用条带时数据区水平平移（st.scrollX），
        // 只绘制可见的列窗口——宽表因此滚动
        // 而非把每列硬塞进视口。隐藏列
        // 折叠为零宽；冻结（固定）列和分组列
        // 提前到可见顺序前部。
        int availData = clipRight - (x + numW + selW);
        if (availData < app.Scale(80)) { availData = app.Scale(80); }
        st.dispW.Clear();
        for (int di = 0; di < st.colWidths.Count; di = di + 1) {
            if (st.colHidden[di]) { st.dispW.Add(0); }
            else { st.dispW.Add(st.colWidths[di]); }
        }
        int firstDataX = x + numW + selW;
        int dataViewW = clipRight - firstDataX;

        // 列显示顺序，切成三段：[左冻结 |
        // 滚动 | 右冻结]。只计算一次，所有布局
        // 流程共用，表头 / 筛选行 / 单元格 / 命中测试 / 汇总天然
        // 对齐一致。
        List<int> vorder = DataTable.VisibleOrder(st, cols);
        int nLeft = DataTable.LeftFrozenCount(st, vorder);
        int nRight = DataTable.RightFrozenCount(st, vorder);
        int pinnedW = DataTable.PinnedWidth(st);
        int pinnedRW = DataTable.PinnedRightWidth(st);
        // 冻结 band 不能吞掉整个表格：超过该点
        // 就没有可滚动的内容，中间部分无法触及，
        // 因此右 band 先让步（它是用户刚添加的）。
        int minBand = app.Scale(80);
        while (nRight > 0 && dataViewW - pinnedW - pinnedRW < minBand) {
            pinnedRW = pinnedRW - st.dispW[vorder[vorder.Count - nRight]];
            nRight = nRight - 1;
        }
        while (nLeft > 1 && dataViewW - pinnedW - pinnedRW < minBand) {
            nLeft = nLeft - 1;
            pinnedW = pinnedW - st.dispW[vorder[nLeft]];
        }
        // 只有中间 band 滚动，因此只有其溢出决定范围。
        int bandX = firstDataX + pinnedW;                  // 中间的左边缘
        int bandW = dataViewW - pinnedW - pinnedRW;        // 其宽度
        if (bandW < 1) { bandW = 1; }
        int bandNatW = 0;
        int bi = nLeft;
        while (bi < vorder.Count - nRight) { bandNatW = bandNatW + st.dispW[vorder[bi]]; bi = bi + 1; }
        int maxScrollX = bandNatW - bandW;
        if (maxScrollX < 0) { maxScrollX = 0; }
        if (st.scrollX > maxScrollX) { st.scrollX = maxScrollX; }
        if (st.scrollX < 0) { st.scrollX = 0; }
        int rightX = firstDataX + dataViewW - pinnedRW;    // 右 band 的左边缘

        // 表头高度此刻才可知：带 band 的表格每层
        // 嵌套在标题上方增加一行。列标题保留
        // 底部的行，`y + headerH` 仍表示"整个表头之下"。
        bandLevels = DataTable.BandLevels(cols, vorder);
        headerH = titleRowH + bandLevels * bandRowH;
        int titleTop = y + bandLevels * bandRowH;

        // 每个可见列的屏幕 x 和所属 band，只计算一次。
        // 每个 band 裁剪到自己的条带内，滚动的中间列
        // 永远不会画到（或注册命中区域到）冻结列之上——
        // 这使 band 间绘制顺序无关紧要，下面四个
        // 流程各自只需一个循环。
        List<FrameColumn> frameColumns = new List<FrameColumn>();
        int cxAcc = firstDataX;
        for (int bpos = 0; bpos < vorder.Count; bpos = bpos + 1) {
            if (bpos == nLeft) { cxAcc = bandX - st.scrollX; }
            if (bpos == vorder.Count - nRight) { cxAcc = rightX; }
            int ownerBand = 1;
            if (bpos < nLeft) { ownerBand = 0; }
            else if (bpos >= vorder.Count - nRight) { ownerBand = 2; }
            frameColumns.Add(new FrameColumn(vorder[bpos], cxAcc, ownerBand));
            cxAcc = cxAcc + st.dispW[vorder[bpos]];
        }
        DataTableFrame f = new DataTableFrame();
        f.y = y;
        f.viewH = viewH;
        f.numW = numW;
        f.selW = selW;
        f.gridColor = gridColor;
        f.menuIconW = menuIconW;
        f.clipRight = clipRight;
        f.firstDataX = firstDataX;
        f.dataViewW = dataViewW;
        f.titleRowH = titleRowH;
        f.rowH = rowH;
        f.fs = fs;
        f.bandRowH = bandRowH;
        f.bandLevels = bandLevels;
        f.headerH = headerH;
        f.titleTop = titleTop;
        f.pinnedW = pinnedW;
        f.pinnedRW = pinnedRW;
        f.bandX = bandX;
        f.bandW = bandW;
        f.bandNatW = bandNatW;
        f.maxScrollX = maxScrollX;
        f.rightX = rightX;
        f.panelY = panelY;
        f.groupPanelH = groupPanelH;
        f.columns = frameColumns;
        return f;
    }

    static void RenderSource(App app, int x, int y, int viewW, int viewH,
                       List<DataColumn> cols, DataSource src, DataTableState st) {
        Canvas c = app.canvas;
        Theme t = app.theme;

        DataTableFrame f = DataTable.ComputeFrame(app, x, y, viewW, viewH, cols, src, st);
        int numW = f.numW;
        int selW = f.selW;
        int gridColor = f.gridColor;
        int menuIconW = f.menuIconW;
        int clipRight = f.clipRight;
        int firstDataX = f.firstDataX;
        int dataViewW = f.dataViewW;
        int titleRowH = f.titleRowH;
        int rowH = f.rowH;
        int fs = f.fs;
        int bandRowH = f.bandRowH;
        int bandLevels = f.bandLevels;
        int headerH = f.headerH;
        int titleTop = f.titleTop;
        int pinnedW = f.pinnedW;
        int pinnedRW = f.pinnedRW;
        int bandX = f.bandX;
        int bandW = f.bandW;
        int bandNatW = f.bandNatW;
        int maxScrollX = f.maxScrollX;
        int rightX = f.rightX;
        int panelY = f.panelY;
        int groupPanelH = f.groupPanelH;
        List<FrameColumn> frameColumns = f.columns;
        y = f.y;
        viewH = f.viewH;

        // 皮肤面：表面/表头/行/强调色全部来自 datatable 的 part 规则，
        // 每帧解析一次后在下方循环里只读局部变量。
        // 触摸设备没有悬停，表头的手柄/筛选图标常显、长按开菜单。
        bool touchUi = app.TouchDevice();
        StyleBox sSurface = Style.Full(app, "datatable", "", "", Style.SNormal());
        StyleBox sHeader = Style.Part(app, "datatable", "header", "", "", "",
                                      Style.SNormal());
        StyleBox sHeaderHover = Style.Part(app, "datatable", "header", "", "", "",
                                           Style.SHover());
        StyleBox sIcon = Style.Part(app, "datatable", "icon", "", "", "",
                                    Style.SNormal());
        StyleBox sIconHover = Style.Part(app, "datatable", "icon", "", "", "",
                                         Style.SHover());
        StyleBox sIconSel = Style.Part(app, "datatable", "icon", "", "", "",
                                       Style.SSelected());
        StyleBox sBandHdr = Style.Part(app, "datatable", "band", "", "", "",
                                       Style.SNormal());
        StyleBox sAccent = Style.Part(app, "datatable", "accent", "", "", "",
                                      Style.SNormal());
        StyleBox sRow = Style.Part(app, "datatable", "row", "", "", "",
                                   Style.SNormal());
        StyleBox sRowStriped = Style.Part(app, "datatable", "row", "", "striped",
                                          "", Style.SNormal());
        StyleBox sRowHover = Style.Part(app, "datatable", "row", "", "", "",
                                        Style.SHover());
        StyleBox sRowSel = Style.Part(app, "datatable", "row", "", "", "",
                                      Style.SSelected());
        StyleBox sGroupRow = Style.Part(app, "datatable", "group-row", "", "",
                                        "", Style.SNormal());
        StyleBox sDetail = Style.Part(app, "datatable", "detail", "", "", "",
                                      Style.SNormal());
        StyleBox sHint = Style.Part(app, "datatable", "hint", "", "", "",
                                    Style.SNormal());
        StyleBox sCellBox = Style.Part(app, "datatable", "cell", "", "", "",
                                       Style.SNormal());
        StyleBox sFooter = Style.Part(app, "datatable", "footer", "", "", "",
                                      Style.SNormal());
        StyleBox sToast = Style.Part(app, "datatable", "toast", "", "", "",
                                     Style.SNormal());
        StyleBox sSbar = Style.Part(app, "datatable", "scrollbar", "", "", "",
                                    Style.SNormal());
        StyleBox sSbarHover = Style.Part(app, "datatable", "scrollbar", "", "",
                                         "", Style.SHover());

        // 外边框
        c.FillRoundRect(x, y, viewW, viewH, t.borderRadiusMedium, sSurface.BgOr(0));
        c.DrawRoundRect(x, y, viewW, viewH, t.borderRadiusMedium, sSurface.BorderOr(0), 1);

        // ---------------- 表头 ----------------
        c.FillRect(x, y, viewW, headerH, sHeader.BgOr(0));
        int hx = x;

        if (st.showRowNum) {
            c.DrawTextCentered(hx, y, numW, headerH, "#", sIcon.FgOr(0), Style.FontFallback(app, "small"));
            hx = hx + numW;
            c.FillRect(hx, y, 1, headerH, gridColor);
        }
        if (st.showSelect) {
            // 全选复选框
            int allId = app.focus.AllocId();
            bool allChecked = st.order.Count > 0;
            int oi = 0;
            while (oi < st.order.Count) {
                if (!DataTable.IsSelected(st, src, st.order[oi])) { allChecked = false; oi = st.order.Count; } else { oi = oi + 1; }
            }
            int box = app.Scale(16);
            int bx = hx + (selW - box) / 2;
            int by = y + (headerH - box) / 2;
            int allLvl = 0;
            if (allChecked) { allLvl = 1000; }
            Checkbox.PaintBox(app, bx, by, box, allLvl);
            app.hitTester.RegisterRect(allId, hx, y, selW, headerH, 0);
            if (app.EventKind() == 3 && app.window.EventButton() == 0 && app.hitTester.HitTest(app.mouseX, app.mouseY) == allId) {
                bool target = !allChecked;
                DataTable.SelectAllRows(st, src, target);
                st.SelectionChanged.Raise();
                app.RequestRedraw();
            }
            hx = hx + selW;
            c.FillRect(hx, y, 1, headerH, gridColor);
        }

        // ---------------- band 行（多级表头）----------------
        // 标题上方每层嵌套一行。跨区覆盖可见顺序中
        // 相邻的槽位段，因此裁剪到自己的
        // 冻结条带内，与其下方列完全一致——
        // 被冻结边界切分的组画成两个跨区，每 band 一个，
        // 这也正是其含义：这些列已不再相邻。
        for (int blv = 0; blv < bandLevels; blv = blv + 1) {
            int by0 = y + blv * bandRowH;
            List<BandSpan> spans = DataTable.BandRow(st, cols, frameColumns, blv);
            for (int si = 0; si < spans.Count; si = si + 1) {
                BandSpan sp = spans[si];
                // 跨区只在一个条带内绘制；跨越
                // band 边界的连续段在其触及的每个条带各绘制一次。
                int seg = sp.from;
                while (seg < sp.to) {
                    int segBand = frameColumns[seg].band;
                    int segEnd = seg;
                    while (segEnd < sp.to && frameColumns[segEnd].band == segBand) { segEnd = segEnd + 1; }
                    int sx0 = frameColumns[seg].x;
                    FrameColumn lastSegmentColumn = frameColumns[segEnd - 1];
                    int sx1 = lastSegmentColumn.x + st.dispW[lastSegmentColumn.column];
                    int sbL = DataTable.BandLeft(segBand, firstDataX, bandX, rightX);
                    int sbR = DataTable.BandRight(segBand, firstDataX, bandX, bandW,
                                                  rightX, pinnedW, pinnedRW, clipRight);
                    if (sx1 > sbL && sx0 < sbR) {
                        DataTable.PushBandClip(c, segBand, firstDataX, bandX, bandW, rightX,
                                               pinnedW, pinnedRW, by0, bandRowH, clipRight);
                        int vx0 = sx0;
                        if (vx0 < sbL) { vx0 = sbL; }
                        int vx1 = sx1;
                        if (vx1 > sbR) { vx1 = sbR; }
                        c.FillRect(sx0, by0, sx1 - sx0, bandRowH - 1, sBandHdr.BgOr(0));
                        c.FillRect(sx1 - 1, by0, 1, bandRowH, gridColor);

                        // 箭头传达"此处还有更多"，因此
                        // 只在拥有该 band 第一列的区段提供，
                        // ——从冻结边界另一侧的碎片折叠
                        // 会收起用户根本没在看的列。
                        int capX = sx0;
                        int capW = sx1 - sx0;
                        bool owner = seg == sp.from;
                        if (owner) {
                            int chev = app.Scale(14);
                            int chId = app.focus.AllocId();
                            string chIcon = "chevron-down";
                            if (DataTable.BandIsCollapsed(st, sp.path)) { chIcon = "chevron-right"; }
                            int chX = sx0 + app.Scale(4);
                            c.DrawGlyphIn(chIcon, chX, by0, chev, bandRowH,
                                                app.Scale(11), sIcon.FgOr(0));
                            app.hitTester.RegisterRect(chId, chX, by0, chev, bandRowH, 0);
                            if (app.EventKind() == 3 && app.window.EventButton() == 0
                                && app.hitTester.HitTest(app.mouseX, app.mouseY) == chId) {
                                DataTable.ToggleBand(st, cols, sp.path);
                                st.BandToggled.Raise();
                                app.RequestRedraw();
                            }
                            capX = chX + chev;
                            capW = sx1 - capX;
                        }
                        int capPad = app.Scale(4);
                        capW = capW - capPad * 2;
                        if (capW < 0) { capW = 0; }
                        string capT = DataTable.Truncate(sp.label, Style.FontFallback(app, "small"), capW);
                        c.DrawTextCentered(capX + capPad, by0, capW, bandRowH, capT,
                                           sBandHdr.FgOr(0), Style.FontFallback(app, "small"));
                        c.PopClip();
                    }
                    seg = segEnd;
                }
            }
            c.FillRect(x, by0 + bandRowH - 1, viewW, 1, gridColor);
        }

        // 本帧进行中的列拖拽重排（按住表头标题且
        // 指针已越过启动阈值）。dropVisLocal 是
        // 被拖列将落入的视觉槽位；dropX 是其屏幕 x。
        bool colDragging = st.dragCol >= 0 && st.dragColMoved;
        int dropVisLocal = -1;
        int dropX = -1;

        int hoi = 0;
        int hcl = firstDataX;
        int hBand = -1;
        while (hoi < frameColumns.Count) {
            FrameColumn headerColumn = frameColumns[hoi];
            int i = headerColumn.column;
            DataColumn col = cols[i];
            int cw = st.dispW[i];
            // 每个 band 有各自的裁剪条带，band 变化时进入。
            // 中间段在两个冻结 band 之间裁剪，
            // 平移的列在边缘被截断，而非画到它们上面。
            if (headerColumn.band != hBand) {
                if (hBand >= 0) { c.PopClip(); }
                hBand = headerColumn.band;
                DataTable.PushBandClip(c, hBand, firstDataX, bandX, bandW, rightX,
                                       pinnedW, pinnedRW, titleTop, titleRowH, clipRight);
            }
            hcl = headerColumn.x;
            // 为每一列分配 id——无论可见与否——
            // 使平移时各帧 id 序列一致；否则
            // 表头之后注册的控件（滚动条）会在列进出视口时
            // 于拖拽中途改变 id。
            int titleId = app.focus.AllocId();
            int menuId = -1;
            if (col.filterable || col.sortable) { menuId = app.focus.AllocId(); }
            int rzId = app.focus.AllocId();
            int gripId = app.focus.AllocId();
            // 把命中区域同时裁剪到 band 和视口：滚到
            // 冻结 band 下方的中间列不能仍可点击，
            // 否则用户会点到自己看不见的列。
            int bandL = DataTable.BandLeft(headerColumn.band, firstDataX, bandX, rightX);
            int bandR = DataTable.BandRight(headerColumn.band, firstDataX, bandX, bandW,
                                            rightX, pinnedW, pinnedRW, clipRight);
            if (hcl + cw <= bandL || hcl >= bandR) {
                hoi = hoi + 1;
            } else {
            hx = hcl;
            // 此列的可见部分（用于命中区域 / 悬停填充）
            int visX = hx;
            if (visX < bandL) { visX = bandL; }
            int visR = hx + cw;
            if (visR > bandR) { visR = bandR; }
            int visW = visR - visX;
            // 拖拽重排的放置槽位：左半部包含
            // 指针的第一列成为插入目标。
            if (colDragging && dropVisLocal < 0 && app.mouseX < hx + cw / 2) {
                dropVisLocal = hoi;
                dropX = visX;
            }
            int pad = t.paddingSmall;
            // 悬停判定用几何而非悬停 id：按下那一帧
            // App 会把 hoveredId 清成 -1，若依赖 id，手柄会在
            // 正好按下它的那一帧消失。
            bool hHover = app.mouseX >= visX && app.mouseX < visR
                          && app.mouseY >= titleTop && app.mouseY < titleTop + titleRowH;
            if (hHover) { c.FillRect(visX, titleTop, visW, titleRowH, sHeaderHover.BgOr(0)); }

            // 列拖动的专用手柄：只在指针进入该表头单元格
            // （或该列正被拖动）时出现在标题左侧，标题文本
            // 同时右移，避免手柄压住列名；不悬停时表头
            // 一个像素都不让给手柄。手柄区含左侧内边距，
            // 与标题命中区严格不重叠。
            // 触摸设备没有悬停：手柄常显，重排始终可用
            //（排序仍走标题点击，两者不打架）。
            int gripW = 0;
            bool showGrip = hHover || st.dragCol == i || touchUi;
            if (showGrip) { gripW = pad + app.Scale(7); }

            int availTitle = cw - pad * 2 - menuIconW - gripW;
            string ht = DataTable.Truncate(col.title, fs, availTitle);
            int ty = Canvas.CenterTextY(titleTop, titleRowH, fs);
            int titleTextX = hx + pad;
            if (showGrip) { titleTextX = hx + gripW; }
            c.DrawText(titleTextX, ty, ht, sHeader.FgOr(0), fs);
            if (showGrip) {
                bool gripHot = app.mouseX >= hx && app.mouseX < hx + gripW
                               && app.mouseY >= titleTop && app.mouseY < titleTop + titleRowH;
                int gCol = sIcon.FgOr(0);
                if (gripHot || st.dragCol == i) { gCol = sIconSel.FgOr(0); }
                DataTable.DrawGrip(app, hx, titleTop, gripW, titleRowH, gCol);
                app.hitTester.RegisterRect(gripId, hx, titleTop, gripW, titleRowH, 0);
                if (gripHot && app.EventKind() == 2 && app.window.EventButton() == 0) {
                    st.dragCol = i;
                    st.dragColStartX = app.mouseX;
                    st.dragColMoved = false;
                }
            }

            // 排序指示——每键一个箭头，多列排序时
            // 再加从 1 开始的优先级徽标。
            int spos = DataTable.SortIndexOf(st, i);
            if (spos >= 0) {
                string arrow = "arrow-up";
                if (st.sortKeys[spos].dir == 2) { arrow = "arrow-down"; }
                int aw = app.Scale(12);
                int ax = titleTextX + Canvas.MeasureText(ht, fs) + app.Scale(4);
                c.DrawGlyph(arrow, ax, titleTop + (titleRowH - aw) / 2, aw, sIconSel.FgOr(0));
                if (st.sortKeys.Count > 1) {
                    c.DrawText(ax + aw + app.Scale(1), ty,
                               Convert.ToString(spos + 1), sIconSel.FgOr(0), Style.FontFallback(app, "small"));
                }
            }

            // 表头菜单图标——DevExpress 风格：仅当鼠标
            // 悬停在该表头单元格、该列有活动筛选或
            // 其菜单打开时显示。`menuId` 总是分配，
            // 控件 id 不随图标显隐而变。触摸设备没有悬停：
            // 图标常显（筛选是移动端的核心操作，不能
            // 靠探索发现），长按表头可打开列上下文菜单。
            if (menuId >= 0) {
                int mIx = hx + cw - menuIconW - app.Scale(1);
                bool active = st.filters[i].Active();
                bool cellHover = app.mouseX >= visX && app.mouseX < visR
                                 && app.mouseY >= titleTop && app.mouseY < titleTop + titleRowH;
                bool showIcon = active || cellHover || st.openMenu == i || touchUi;
                if (showIcon) {
                    int mColor = sIcon.FgOr(0);
                    if (active) { mColor = sIconSel.FgOr(0); }
                    if (app.focus.IsHovered(menuId)) { mColor = sIconHover.FgOr(0); }
                    c.DrawGlyphIn("filter", mIx, titleTop, menuIconW, titleRowH, app.Scale(10), mColor);
                    app.hitTester.RegisterRect(menuId, mIx, titleTop, menuIconW, titleRowH, 0);
                    if (!st.dragColMoved && app.EventKind() == 3 && app.window.EventButton() == 0 && app.hitTester.HitTest(app.mouseX, app.mouseY) == menuId) {
                        if (st.openMenu == i) { st.openMenu = -1; } else {
                            DataTable.OpenFilterMenu(st, cols, src, i);
                        }
                        app.RequestRedraw();
                    } else if (touchUi && st.openMenu < 0 && !st.hdrCtxOpen
                               && app.PollLongPress(menuId)) {
                        // 长按表头 => 列上下文菜单（排序/自动列宽/
                        // 隐藏/冻结……）。触摸设备没有右键，长按
                        // 是移动端的标准等价手势；只认菜单图标上的
                        // 按住，避免与范围拖拽/滚动打架。
                        st.hdrCtxOpen = true;
                        st.hdrCtxCol = i;
                        st.hdrCtxX = app.mouseX;
                        st.hdrCtxY = app.mouseY;
                        st.hitCol = i;
                        app.RequestRedraw();
                    }
                }
            }

            // 表头标题：点击循环切换排序（重排改由左侧
            // 手柄发起，避免想排序时误拖列）。拖动中的列变暗。
            int titleX = visX + gripW;
            int titleW = visW - menuIconW - gripW;
            if (titleW < 0) { titleW = 0; }
            app.hitTester.RegisterRect(titleId, titleX, titleTop, titleW, titleRowH, 0);
            if (st.dragCol == i && app.focus.pressedId >= 0) {
                int dd = app.mouseX - st.dragColStartX;
                if (dd < 0) { dd = 0 - dd; }
                if (!st.dragColMoved && dd > app.Scale(2)) {
                    st.dragColMoved = true;
                }
                if (st.dragColMoved) { app.RequestRedraw(); }
            }
            if (colDragging && st.dragCol == i) {
                c.FillRect(visX, titleTop, visW, titleRowH, sHeaderHover.BgOr(0));
            }
            if (col.sortable && !st.dragColMoved && app.EventKind() == 3 && app.window.EventButton() == 0 && app.ClickTarget() == titleId) {
                // 长按菜单已命中时松开不算排序点击：触摸上长按
                // 表头由 menuId 的按住驱动，这里只挡住随后的释放。
                if (!app.LongPressFired()) {
                    st.hitCol = i;
                    st.HeaderClick.Raise();
                    bool addSort = Modifiers.HasShift(app.window.EventMods());
                    DataTable.CycleSort(st, i, addSort);
                    st.dirty = true;
                    st.Sort.Raise();
                }
                app.RequestRedraw();
            }

            // 右键点击表头单元格 => 列上下文菜单（排序 / 自动适配 /
            // 隐藏）。基于几何判断，不受本单元格注册的
            // 标题 / 菜单图标 / 调整大小 id 重叠影响。
            if (app.EventKind() == 2 && app.window.EventButton() == 1
                && st.openMenu < 0
                && app.mouseX >= hx && app.mouseX < hx + cw
                && app.mouseY >= titleTop && app.mouseY < titleTop + titleRowH) {
                st.hdrCtxOpen = true;
                st.hdrCtxCol = i;
                st.hdrCtxX = app.mouseX;
                st.hdrCtxY = app.mouseY;
                st.hitCol = i;
                app.RequestRedraw();
            }

            // 调整大小手柄（右边界）。可拖列显示水平
            // 调整光标（控件类型 4）；固定列显示禁止
            // 光标（控件类型 6），手柄明确呈禁用态。
            // 触摸设备没有悬停光标反馈，手指目标也远大于
            // 6px：手柄加宽一倍（命中区左右各扩 Scale(6)），
            // 配合常显列拖动手柄，列宽调整在移动端可用。
            int rzW = app.Scale(6);
            int rzPad = touchUi ? app.Scale(6) : 0;
            int rzX = hx + cw - rzW / 2 - rzPad;
            int rzHitW = rzW + rzPad * 2;
            int rzCursor = 4;
            if (!col.resizable) { rzCursor = 6; }
            app.hitTester.RegisterRect(rzId, rzX, titleTop, rzHitW, titleRowH, rzCursor);
            if (col.resizable && app.EventKind() == 2 && app.window.EventButton() == 0 && app.PressTarget() == rzId) {
                st.resizeCol = i;
                st.resizeStartX = app.mouseX;
                st.resizeStartW = st.colWidths[i];
            }
            if (col.resizable && st.resizeCol == i && app.focus.pressedId == rzId) {
                int nw = st.resizeStartW + (app.mouseX - st.resizeStartX);
                if (nw < app.Scale(48)) { nw = app.Scale(48); }
                if (nw != st.colWidths[i]) {
                    st.colWidths[i] = nw;
                    st.hitCol = i;
                    st.ColumnResize.Raise();
                    app.RequestRedraw();
                }
            }

            if (st.resizeCol == i && app.EventKind() == 3 && app.window.EventButton() == 0) {
                st.hitCol = i;
                st.resizeCol = -1;
                st.ColumnResizeEnd.Raise();
            }

            c.FillRect(hx + cw, titleTop, 1, titleRowH, gridColor);
            hoi = hoi + 1;
            }
        }
        if (hBand >= 0) { c.PopClip(); }
        c.FillRect(x, y + headerH - 1, viewW, 1, gridColor);

        // 列拖拽反馈与放置：2px 强调线标记插入
        // 边界，浮动芯片跟随指针。松开时
        // 列移到目标槽位之前（或末尾）。
        if (colDragging) {
            if (dropVisLocal < 0) { dropX = hx; }
            // 插入线贯穿整个表头——包括 band
            // 行，因为两列之间放置也可能把列移出
            // 分组——但芯片跟随其来源的标题行。
            c.FillRect(dropX - 1, y, app.Scale(2), headerH, sAccent.BgOr(0));
            string dl = cols[st.dragCol].title;
            int chW = Canvas.MeasureText(dl, fs) + app.Scale(16);
            int chX = app.mouseX - chW / 2;
            if (chX < x) { chX = x; }
            if (chX + chW > x + viewW) { chX = x + viewW - chW; }
            c.FillRoundRect(chX, titleTop + app.Scale(3), chW, titleRowH - app.Scale(6),
                            t.borderRadiusSmall, sAccent.BgOr(0));
            c.DrawText(chX + app.Scale(8),
                       Canvas.CenterTextY(titleTop, titleRowH, fs), dl, sAccent.FgOr(0), fs);
        }
        // 按住按钮期间记住放置槽位，使下面的收尾
        // 使用最后一次实时拖拽位置，而非松手帧上
        // 指针恰好所在的位置。
        if (colDragging && app.focus.pressedId >= 0) { st.dropVis = dropVisLocal; }
        // 按钮松开时收尾。App 在本次渲染前
        // 就已清除 mouse-up 的按下状态，`pressedId < 0` 可靠标记
        // 松手帧，即使合成事件类型被合并。
        if (st.dragCol >= 0 && app.focus.pressedId < 0) {
            // 在分组条带上松开：这是"按此列分组"
            // 手势，作用于指针所指槽位，而非重排。
            bool toPanel = st.showGroupPanel && st.dragColMoved
                && app.mouseX >= x && app.mouseX < x + viewW
                && app.mouseY >= panelY && app.mouseY < panelY + groupPanelH;
            if (toPanel) {
                List<GroupChipGeometry> groupChips = DataTable.GroupChipLayout(app, cols, st, x);
                DataTable.GroupByAt(st, st.dragCol,
                                    DataTable.GroupDropSlot(app, groupChips));
                st.GroupChanged.Raise();
            } else if (st.dragColMoved) {
                int beforeCol = -1;
                if (st.dropVis >= 0 && st.dropVis < frameColumns.Count) {
                    beforeCol = frameColumns[st.dropVis].column;
                }
                if (beforeCol != st.dragCol) {
                    DataTable.MoveColumn(st, st.dragCol, beforeCol);
                    st.hitCol = st.dragCol;
                    st.ColumnReorder.Raise();
                }
            }
            st.dragCol = -1;
            st.dragColMoved = false;
            st.dropVis = -1;
            app.RequestRedraw();
        }

        // ---------------- 主体（虚拟化）----------------
        int total = DataTable.DispCount(st);
        int summaryH = 0;
        if (st.showSummary) { summaryH = rowH; }
        int pagerH = 0;
        if (st.paged) { pagerH = app.Scale(38); }

        int filterRowH = 0;
        if (st.showFilterRow) { filterRowH = rowH; }
        int statusBarH = 0;
        if (st.showStatusBar) { statusBarH = app.Scale(28); }
        int bodyTop = y + headerH + filterRowH;
        int bodyH = viewH - headerH - filterRowH - summaryH - pagerH - statusBarH;
        if (bodyH < rowH) { bodyH = rowH; }
        int visRows = bodyH / rowH;
        if (visRows < 1) { visRows = 1; }

        // 分页模式下可见窗口是一整页；否则是
        // 虚拟滚动偏移。
        int start = 0;
        if (st.paged) {
            st.pageRows = visRows;
            int totalPages = 1;
            if (total > 0) { totalPages = (total + visRows - 1) / visRows; }
            int cur = st.pageModel.Get();
            if (cur > totalPages) { cur = totalPages; st.pageModel.Set(cur); }
            if (cur < 1) { cur = 1; st.pageModel.Set(cur); }
            start = (cur - 1) * visRows;
        } else {
            start = st.scrollRow;
            if (start > total - visRows) { start = total - visRows; }
            if (start < 0) { start = 0; }
            st.scrollRow = start;
        }

        // 服务端数据源按需增长：用户滚动到
        // 已加载前缀底部时请求下一块，
        // 滚动条随数据到达不断延伸。RequestNextBlock 会合并，
        // 请求在途时每帧调用零开销。
        if (!st.paged && src.HasMore() && start >= total - visRows) {
            src.RequestNextBlock();
        }

        // ---------------- 筛选行（DevExpress 行内快速筛选）----------------
        // 表头正下方的一行逐列文本输入框。点击任意
        // 单元格使其聚焦；输入对该列应用实时 Contains 筛选，
        // 与弹出筛选相互正交。仅在 showFilterRow 时绘制。
        if (st.showFilterRow && filterRowH > 0) {
            int fry = y + headerH;
            c.FillRect(x + 1, fry, viewW - 2, filterRowH, sHeader.BgOr(0));
            c.FillRect(x + 1, fry, numW + selW - 2, filterRowH, sBandHdr.BgOr(0));

            // 边栏中的小漏斗图标，标示该行的用途
            if (st.showRowNum && numW > 0) {
                c.DrawGlyphIn("filter", x, fry, numW, filterRowH, app.Scale(12), sIcon.FgOr(0));
            }

            int frBand = -1;
            for (int froi = 0; froi < frameColumns.Count; froi = froi + 1) {
                FrameColumn filterColumn = frameColumns[froi];
                int fri = filterColumn.column;
                int fcw = st.dispW[fri];
                if (filterColumn.band != frBand) {
                    if (frBand >= 0) { c.PopClip(); }
                    frBand = filterColumn.band;
                    DataTable.PushBandClip(c, frBand, firstDataX, bandX, bandW, rightX,
                                           pinnedW, pinnedRW, fry, filterRowH, clipRight);
                }
                int frcl = filterColumn.x;
                int frBandL = DataTable.BandLeft(filterColumn.band, firstDataX, bandX, rightX);
                int frBandR = DataTable.BandRight(filterColumn.band, firstDataX, bandX, bandW,
                                                  rightX, pinnedW, pinnedRW, clipRight);
                if (frcl + fcw > frBandL && frcl < frBandR) {
                    int pad2 = t.paddingSmall;
                    bool frFoc = st.filterRowFocusCol == fri;
                    string frTxt = st.filterRowText[fri];
                    if (frFoc) { frTxt = st.filterRowBuf; }
                    int frid2 = app.focus.AllocId();
                    int frX = frcl;
                    int frW = fcw;
                    if (frX < frBandL) { frW = frW - (frBandL - frX); frX = frBandL; }
                    if (frX + frW > frBandR) { frW = frBandR - frX; }
                    bool frAct = frTxt.Length > 0 || frFoc;
                    string frCls = "";
                    if (frAct && !frFoc) { frCls = "active"; }
                    int frState = Style.SNormal();
                    if (frFoc) { frState = Style.SFocus(); }
                    StyleBox sField = Style.Part(app, "datatable", "field", "",
                                                 frCls, "", frState);
                    c.FillRect(frX + 2, fry + 3, frW - 4, filterRowH - 6, sField.BgOr(0));
                    int frBorder = sField.BorderOr(0);
                    c.DrawRoundRect(frX + 2, fry + 3, frW - 4, filterRowH - 6, t.borderRadiusSmall, frBorder, 1);
                    int frInner = frW - 4 - pad2 * 2;
                    if (frInner < 0) { frInner = 0; }
                    int frfs = Style.FontFallback(app, "small");
                    int frtY = Canvas.CenterTextY(fry, filterRowH, frfs);
                    c.PushClip(frX + 2 + pad2, fry, frInner, filterRowH);
                    if (frTxt.Length == 0 && !frFoc) {
                        c.DrawText(frX + 2 + pad2, frtY, DataTable.T("Search...", "搜索..."), sHint.FgOr(0), frfs);
                    } else {
                        c.DrawText(frX + 2 + pad2, frtY, frTxt, sField.FgOr(0), frfs);
                        if (frFoc) {
                            int fcaretW = Canvas.MeasureText(Text.Left(frTxt, st.filterRowCur), frfs);
                            c.FillRect(frX + 2 + pad2 + fcaretW, frtY, 1, Canvas.FontHeight(frfs), sAccent.BgOr(0));
                        }
                    }
                    c.PopClip();
                    app.hitTester.RegisterRect(frid2, frX, fry, frW, filterRowH, 1);
                    if (app.EventKind() == 3 && app.window.EventButton() == 0
                        && app.hitTester.HitTest(app.mouseX, app.mouseY) == frid2) {
                        if (st.filterRowFocusCol != fri) {
                            st.filterRowFocusCol = fri;
                            st.filterRowBuf = st.filterRowText[fri];
                            st.filterRowCur = st.filterRowBuf.Length;
                        }
                        app.RequestRedraw();
                    }
                }
            }
            if (frBand >= 0) { c.PopClip(); }
            c.FillRect(x + 1, fry + filterRowH - 1, viewW - 2, 1, gridColor);
        }

        // 归一化的单元格范围边界（顺序索引行 + 列索引），
        // 用于在单元格后方高亮拖选矩形。
        bool hasRange = DataTable.HasRange(st);
        int rgR0 = 0;
        int rgR1 = -1;
        int rgC0 = 0;
        int rgC1 = -1;
        if (hasRange) {
            rgR0 = DataTable.MinI(st.rangeR0, st.rangeR1);
            rgR1 = DataTable.MaxI(st.rangeR0, st.rangeR1);
            rgC0 = DataTable.MinI(st.rangeC0, st.rangeC1);
            rgC1 = DataTable.MaxI(st.rangeC0, st.rangeC1);
        }
        // Ctrl 追加出的归档区域同样高亮：单元格着色阶段逐区域
        // 命中测试（区域数小，直接顺序比较即可）。
        int multiN = DataTable.MultiCount(st);

        // 当前编辑单元格的屏幕矩形（循环中捕获，
        // 以便行绘制完成后在其上绘制行内编辑器）
        int edX = 0;
        int edY = 0;
        int edW = 0;
        int edH = 0;
        bool edVis = false;
        // 键盘/鼠标光标所在的焦点单元格（Excel 式描边），
        // 同样在循环中捕获、行绘制完成后统一描边。
        int fcX = 0;
        int fcY = 0;
        int fcW = 0;
        int fcH = 0;
        bool fcVis = false;

        int r = 0;
        while (r < visRows && (start + r) < total) {
            int oiRow = start + r;
            int ry = bodyTop + r * rowH;

            // 组表头行：缩进箭头 + 标题 + 行数。它
            // 占用一个显示槽位但不携带数据行内容。
            if (DataTable.DispKind(st, oiRow) == 1) {
                int gi = DataTable.DispRowOf(st, oiRow);
                GroupRow grp = st.groups[gi];
                int lvl = grp.level;
                c.FillRect(x + 1, ry, viewW - 2, rowH, sGroupRow.BgOr(0));
                int gcx = x + numW + selW + lvl * app.Scale(16) + app.Scale(6);
                bool gcoll = grp.collapsed;
                string chev = "chevron-down";
                if (gcoll) { chev = "chevron-right"; }
                int chSz = app.Scale(14);
                c.DrawGlyph(chev, gcx, ry + (rowH - chSz) / 2, chSz, sHeader.FgOr(0));
                string glbl = grp.label + "  (" + Convert.ToString(grp.count) + ")";
                // 为设置了 aggMode 的列追加组级聚合汇总
                // （DevExpress 风格组小计）。
                // 格式："  |  Revenue: ¥1,234,567  |  Avg CTR: 3.2%"
                for (int gagg = 0; gagg < grp.aggTexts.Count && gagg < cols.Count; gagg = gagg + 1) {
                    string gat = grp.aggTexts[gagg];
                    if (gat.Length > 0) {
                        glbl = glbl + "    " + cols[gagg].title + ": " + gat;
                    }
                }
                c.DrawText(gcx + chSz + app.Scale(4),
                    ry + (rowH - Style.FontFallback(app, "medium")) / 2, glbl, sGroupRow.FgOr(0), Style.FontFallback(app, "medium"));
                c.FillRect(x + 1, ry + rowH - 1, viewW - 2, 1, gridColor);
                r = r + 1;
                continue;
            }

            // 详情 band：展开行下方的主从详情面板。该 band
            // 跨越 DetailSlots 个连续槽位，在第一个槽位处绘制一次，
            // 覆盖完整高度，面板看到的是一整块矩形
            // 而非一系列行高条带。同一 band 的后续部分
            // 不再绘制——第一部分已覆盖其像素。
            if (DataTable.DispKind(st, oiRow) == 2) {
                if (DataTable.DispPart(st, oiRow) != 0) { r = r + 1; continue; }
                int dRow = DataTable.DispRowOf(st, oiRow);
                // 统计该 band 的剩余槽位，使面板在起点在屏内、
                // 延伸出底边时也能获得完整
                // 高度（裁剪使溢出部分不可见）。
                int span = 1;
                int ns = oiRow + 1;
                while (ns < total && DataTable.DispKind(st, ns) == 2
                       && DataTable.DispPart(st, ns) != 0 && DataTable.DispRowOf(st, ns) == dRow) {
                    span = span + 1;
                    ns = ns + 1;
                }
                int dh = span * rowH;
                c.FillRect(x + 1, ry, viewW - 2, dh, sDetail.BgOr(0));
                // 左侧强调线把面板与其上方的主行相连。
                c.FillRect(x + 1, ry, app.Scale(3), dh, sAccent.BgOr(0));
                if (st.detail != null) {
                    int dx = x + app.Scale(4);
                    int dw = viewW - app.Scale(6);
                    c.PushClip(dx, ry, dw, dh);
                    st.detail.Paint(app, src, dRow, dx, ry, dw, dh);
                    c.PopClip();
                }
                c.FillRect(x + 1, ry + dh - 1, viewW - 2, 1, gridColor);
                r = r + 1;
                continue;
            }

            int rowIdx = DataTable.DispRowOf(st, oiRow);
            bool rowInRange = hasRange && oiRow >= rgR0 && oiRow <= rgR1;

            // 服务端数据源可能尚未取到该行（用户
            // 滚入了未获取的块）：渲染加载占位符
            // 而非读取空单元格，并请求该块。该请求
            // 请求会合并，逐行重复调用几乎零成本。
            // 该行没有命中区域和选中状态——它不是真实
            // 数据，因此下面的 `st.selected[rowIdx]` 会越界
            // （未取回的行），所以此分支要先执行。
            if (!src.CellReady(rowIdx, 0)) {
                src.RequestBlock(rowIdx);
                c.FillRect(x + 1, ry, viewW - 2, rowH, sDetail.BgOr(0));
                c.DrawTextCentered(x, ry, viewW, rowH, "...", sHint.FgOr(0), Style.FontFallback(app, "small"));
                c.FillRect(x + 1, ry + rowH - 1, viewW - 2, 1, gridColor);
                r = r + 1;
                continue;
            }

            int rowId = app.focus.AllocId();
            app.hitTester.RegisterRect(rowId, x, ry, viewW, rowH, 0);
            bool rHover = app.focus.IsHovered(rowId);
            bool rSel = DataTable.IsSelected(st, src, rowIdx);

            int stripeBg = sRow.BgOr(0);
            if (st.striped && (DataTable.DispNo(st, oiRow) % 2 == 0)) { stripeBg = sRowStriped.BgOr(0); }
            int rowBg = DataTable.RowBackground(st, src, rowIdx, stripeBg,
                                                sRowSel.BgOr(0), sRowHover.BgOr(0), rSel, rHover);
            c.FillRect(x + 1, ry, viewW - 2, rowH, rowBg);
            // 选中行左缘的强调条：与 VirtualList / 树的选中条
            // 同一语言，给"这一行被选中"一个不依赖底色的信号。
            if (rSel) { c.FillRect(x + 1, ry, app.Scale(3), rowH, sAccent.BgOr(0)); }

            int cx2 = x;
            if (st.showRowNum) {
                // 在当前排序/过滤视图中的顺序显示位置（1,2,3…），
                // 而非原始数据索引，这样行号
                // 列保持有序，不会在用户
                // 排序或过滤时乱跳。
                // 行号列本身是多选区域，行的重排走右侧那个
                // 专用手柄（仅本行悬停/正被拖动时出现），
                // 这样在行号上拖动是框选行，而不是意外重排。
                int rowGripW = app.Scale(10);
                int rowGripX = cx2 + numW - rowGripW;
                // 手动重排只在未分组时有意义（分组视图里
                // 顺序由分组键决定）。
                // 悬停用几何判断：按下那一帧 hoveredId 会被清空，
                // 若依赖 id，手柄会在正好按下它时消失。
                // 触摸设备没有悬停：手柄常显，重排在移动端可达。
                bool rowHot = app.mouseY >= ry && app.mouseY < ry + rowH
                              && app.mouseX >= x && app.mouseX < x + viewW;
                bool showRowGrip = st.rowReorder && (rowHot || st.dragRow == oiRow || touchUi)
                                   && st.groupCols.Count == 0;
                int numTextW = numW;
                if (showRowGrip) { numTextW = numW - rowGripW; }
                c.DrawTextCentered(cx2, ry, numTextW, rowH, Convert.ToString(DataTable.DispNo(st, oiRow)), sHint.FgOr(0), Style.FontFallback(app, "small"));
                // id 每帧无条件分配，手柄显隐才不会让
                // 之后注册的控件 id 整体错位。
                int rgId = app.focus.AllocId();
                if (showRowGrip) {
                    app.hitTester.RegisterRect(rgId, rowGripX, ry, rowGripW, rowH, 0);
                    bool rgHot = rowHot && app.mouseX >= rowGripX && app.mouseX < rowGripX + rowGripW;
                    int rgCol = sIcon.FgOr(0);
                    if (rgHot || st.dragRow == oiRow) { rgCol = sIconSel.FgOr(0); }
                    DataTable.DrawGrip(app, rowGripX, ry, rowGripW, rowH, rgCol);
                    if (rgHot && app.EventKind() == 2 && app.window.EventButton() == 0) {
                        st.dragRow = oiRow;
                        st.dragStartY = app.mouseY;
                        st.dragMoved = false;
                        st.rowGripDrag = true;
                    }
                }
                // 主从详情展开箭头，嵌在行号栏左侧，
                // 让行号在旁边仍清晰可读。只有 provider
                // 接受的行才显示，无子行的行显示空白边距
                // 而不是一个无用的箭头。
                if (DataTable.CanExpand(st, src, rowIdx)) {
                    int exSz = app.Scale(12);
                    int exX = cx2 + app.Scale(2);
                    int exY = ry + (rowH - exSz) / 2;
                    bool isExp = DataTable.IsExpanded(st, src, rowIdx);
                    string exCh = "chevron-right";
                    if (isExp) { exCh = "chevron-down"; }
                    int exId = app.focus.AllocId();
                    app.hitTester.RegisterRect(exId, cx2, ry, app.Scale(16), rowH, 0);
                    int exCol = sIcon.FgOr(0);
                    if (app.focus.IsHovered(exId)) { exCol = sIconSel.FgOr(0); }
                    c.DrawGlyph(exCh, exX, exY, exSz, exCol);
                    if (app.EventKind() == 3 && app.window.EventButton() == 0
                        && app.hitTester.HitTest(app.mouseX, app.mouseY) == exId) {
                        DataTable.ToggleDetail(st, src, rowIdx);
                        app.RequestRedraw();
                    }
                }
                cx2 = cx2 + numW;
            }
            if (st.showSelect) {
                int box = app.Scale(16);
                int bx = cx2 + (selW - box) / 2;
                int by = ry + (rowH - box) / 2;
                int selLvl = 0;
                if (rSel) { selLvl = 1000; }
                Checkbox.PaintBox(app, bx, by, box, selLvl);
                int selId = app.focus.AllocId();
                app.hitTester.RegisterRect(selId, cx2, ry, selW, rowH, 0);
                if (app.EventKind() == 3 && app.window.EventButton() == 0 && app.hitTester.HitTest(app.mouseX, app.mouseY) == selId) {
                    DataTable.SetSelected(st, src, rowIdx, !rSel);
                    st.hitRow = rowIdx;
                    st.SelectionChanged.Raise();
                    app.RequestRedraw();
                }
                cx2 = cx2 + selW;
            }

            int cBand = -1;
            for (int coi = 0; coi < frameColumns.Count; coi = coi + 1) {
                FrameColumn bodyColumn = frameColumns[coi];
                int cc = bodyColumn.column;
                int cw = st.dispW[cc];
                if (bodyColumn.band != cBand) {
                    if (cBand >= 0) { c.PopClip(); }
                    cBand = bodyColumn.band;
                    DataTable.PushBandClip(c, cBand, firstDataX, bandX, bandW, rightX,
                                           pinnedW, pinnedRW, ry, rowH, clipRight);
                }
                int ccl = bodyColumn.x;
                int cBandL = DataTable.BandLeft(bodyColumn.band, firstDataX, bandX, rightX);
                int cBandR = DataTable.BandRight(bodyColumn.band, firstDataX, bandX, bandW,
                                                 rightX, pinnedW, pinnedRW, clipRight);
                if (ccl + cw > cBandL && ccl < cBandR) {
                    // 单元格级样式背景绘制在范围
                    // 高亮之下，选中的单元格仍能看出是选中状态。
                    int cellBg = DataTable.CellBackground(st, src, rowIdx, cc);
                    if (cellBg != 0) { c.FillRect(ccl, ry, cw, rowH, cellBg); }
                    bool cellInRange = rowInRange && cc >= rgC0 && cc <= rgC1;
                    for (int mi = 0; mi < multiN && !cellInRange; mi = mi + 1) {
                        int mr0 = -1; int mc0 = -1; int mr1 = -1; int mc1 = -1;
                        if (DataTable.MultiAt(st, mi, out mr0, out mc0, out mr1, out mc1)
                            && oiRow >= mr0 && oiRow <= mr1 && cc >= mc0 && cc <= mc1) {
                            cellInRange = true;
                        }
                    }
                    if (cellInRange) {
                        c.FillRect(ccl, ry, cw, rowH, sRowSel.BgOr(0));
                    }
                    // 填充拖拽的目标区域用半透明强调色铺出，
                    // 与源块（不透明选区色）区分。
                    if (st.fillDrag && oiRow >= st.fillTR0 && oiRow <= st.fillTR1
                        && cc >= st.fillTC0 && cc <= st.fillTC1) {
                        c.FillRect(ccl, ry, cw, rowH, DataTable.ColorAlpha(sAccent.BgOr(0), 40));
                    }
                    if (st.editing && rowIdx == st.editRow && cc == st.editCol) {
                        edX = ccl; edY = ry; edW = cw; edH = rowH; edVis = true;
                    }
                    if (rowIdx == st.hitRow && cc == st.hitCol) {
                        fcX = ccl; fcY = ry; fcW = cw; fcH = rowH; fcVis = true;
                    }
                    // 单元格控件插槽：真控件按格矩形渲染
                    // （PropertyGrid/设计器 PvCtrl 同款 Measure+Arrange+
                    // RenderTree 三步）。优先于自绘与内置渲染——它是
                    // 最明确的选择；provider 返回 null 的格退回后续
                    // 路径。控件在裁剪内渲染，异常实现不会溢出到
                    // 相邻单元格。
                    bool painted = false;
                    if (st.cellWidgets != null) {
                        c.PushClip(ccl, ry, cw, rowH);
                        Control wc = st.cellWidgets.Provide(app, src, rowIdx, cc, ccl, ry, cw, rowH);
                        if (wc != null) {
                            Rect cellRect = new Rect(ccl, ry, cw, rowH);
                            wc.MeasureTree(app);
                            wc.Arrange(cellRect.x, cellRect.y, cellRect.width, cellRect.height);
                            wc.RenderTree(app);
                            painted = true;
                        }
                        c.PopClip();
                    }
                    // 自定义绘制器完全接管单元格。将画布裁剪到
                    // 自身的矩形内，行为异常的绘制器不会溢出到
                    // 相邻单元格或表格之外。
                    if (!painted && st.styler != null) {
                        c.PushClip(ccl, ry, cw, rowH);
                        painted = st.styler.PaintCell(app, src, rowIdx, cc, ccl, ry, cw, rowH);
                        c.PopClip();
                    }
                    if (!painted) {
                        double cfLo = 0.0;
                        double cfHi = 0.0;
                        if (cc < st.cfMinR.Count) { cfLo = st.cfMinR[cc]; cfHi = st.cfMaxR[cc]; }
                        // 计算列：单元格文本来自公式求值（fail-soft，
                        // 求值失败显示空），其余渲染路径不变。
                        string cellText = src.CellText(rowIdx, cc);
                        string fText = DataTable.FormulaText(cols, src, rowIdx, cc);
                        if (fText != null) { cellText = fText; }
                        if (st.treeAdapter != null && cc == st.treeCol) {
                            // 树列：缩进 + 行首展开箭头。命中区注册在
                            // 箭头上（含缩进头部），点击切换展开。
                            int depth = DataTable.DispDepth(st, oiRow);
                            bool canExp = DataTable.CanTreeExpand(st, src, rowIdx);
                            bool isExp = DataTable.IsTreeExpanded(st, src, rowIdx);
                            if (canExp) {
                                int exId = app.focus.AllocId();
                                int exW = app.Scale(16) * (depth + 1);
                                app.hitTester.RegisterRect(exId, ccl, ry, exW, rowH, 0);
                                if (app.EventKind() == 3 && app.window.EventButton() == 0
                                    && app.hitTester.HitTest(app.mouseX, app.mouseY) == exId) {
                                    DataTable.TreeToggle(st, src, rowIdx);
                                    app.RequestRedraw();
                                }
                            }
                            DataTable.DrawCellIndented(app, cols[cc], cellText,
                                ccl, ry, cw, rowH, cfLo, cfHi,
                                DataTable.CellForeground(st, src, rowIdx, cc),
                                depth, true, canExp, isExp);
                        } else {
                            DataTable.DrawCellRangeCtx(app, cols[cc], cellText, ccl, ry, cw, rowH,
                                                  cfLo, cfHi, DataTable.CellForeground(st, src, rowIdx, cc),
                                                  rowIdx, cc, st, src);
                        }
                    }
                    // 可编辑的 bool 单元格单击即切换，
                    // 而不是打开内联编辑所用的文本编辑器。
                    if (cols[cc].isBool && cols[cc].editable) {
                        int tgId = app.focus.AllocId();
                        app.hitTester.RegisterRect(tgId, ccl, ry, cw, rowH, 0);
                        if (app.EventKind() == 3 && app.window.EventButton() == 0
                            && app.hitTester.HitTest(app.mouseX, app.mouseY) == tgId) {
                            DataTable.ToggleBoolCell(st, cols, src, rowIdx, cc);
                            app.RequestRedraw();
                        }
                    }
                }
            }
            if (cBand >= 0) { c.PopClip(); }

            c.FillRect(x + 1, ry + rowH - 1, viewW - 2, 1, gridColor);
            r = r + 1;
        }

        // ---------------- 焦点单元格描边 ----------------
        // Excel/DevExpress 式：单元格光标所在处一圈 1px 强调线，
        // 让键盘导航有落点。编辑器打开时不画——编辑器自带
        // 更粗的焦点边。行选择模式（hitCol = -1）没有光标单元格。
        if (fcVis && !st.editing) {
            int fvi = DataTable.VisPos(frameColumns, st.hitCol);
            if (fvi >= 0) {
                FrameColumn focusColumn = frameColumns[fvi];
                DataTable.PushBandClip(c, focusColumn.band, firstDataX, bandX, bandW,
                                       rightX, pinnedW, pinnedRW, fcY, fcH, clipRight);
                c.DrawRect(fcX, fcY, fcW, fcH, sAccent.BgOr(0), 1);
                c.PopClip();
            }
        }

        // ---------------- 空态/加载覆盖层 ----------------
        // AG Grid 的 noRowsOverlay / loadingOverlay：数据源
        // 尚未交付首块（HasMore 且行数为 0）→ 加载中；
        // 确认为空 → 暂无数据。文案可经 emptyText/loadingText
        // 覆盖；overlayKind 记录本帧渲染的覆盖层，供诊断
        // 与驱动探针断言。
        st.overlayKind = "";
        if (total == 0) {
            bool oloading = src.HasMore() && src.RowCount() == 0;
            string omsg = oloading ? st.loadingText : st.emptyText;
            if (omsg.Length == 0) {
                omsg = oloading ? DataTable.T("Loading…", "加载中…")
                                : DataTable.T("No data", "暂无数据");
            }
            st.overlayKind = oloading ? "loading" : "empty";
            int otx = firstDataX + (dataViewW - Canvas.MeasureText(omsg, fs)) / 2;
            if (otx < firstDataX) { otx = firstDataX; }
            c.DrawText(otx, Canvas.CenterTextY(bodyTop, bodyH, fs), omsg,
                       sHint.FgOr(0), fs);
        }

        // ---------------- 填充柄（Excel 式拖拽填充） ----------------
        // 活动范围右下角的小方块。角点滚出视口或列隐藏时
        // 不绘制也不拦截（fillHX=-1）；编辑中不显示。
        st.fillHX = -1;
        st.fillHY = -1;
        if (DataTable.HasRange(st) && !st.editing) {
            int hr1 = DataTable.MaxI(st.rangeR0, st.rangeR1);
            int hc1 = DataTable.MaxI(st.rangeC0, st.rangeC1);
            if (hc1 >= 0 && hc1 < st.dispW.Count && hr1 >= start && hr1 < start + r) {
                int hy = bodyTop + (hr1 - start + 1) * rowH;
                for (int fh = 0; fh < frameColumns.Count; fh = fh + 1) {
                    if (frameColumns[fh].column == hc1) {
                        int hx = frameColumns[fh].x + st.dispW[hc1];
                        int hsz = app.Scale(7);
                        st.fillHX = hx;
                        st.fillHY = hy;
                        c.FillRect(hx - hsz, hy - hsz, hsz, hsz, sAccent.BgOr(0));
                        c.DrawRect(hx - hsz, hy - hsz, hsz, hsz, sRow.BgOr(0), 1);
                    }
                }
            }
        }

        // ---------------- 新行占位符 ----------------
        // 最后一行下方的空行，即 DevExpress 的“点击此处添加”行。
        // 仅在视图滚动到底部时绘制（此时 `r` 恰好
        // 少于 visRows），因此它总是紧跟在最后一行之后，
        // 而不会浮在滚动页面的中间。它不是
        // 显示槽位：它不承载数据，无法被选中或排序。
        if (st.allowAddRow && src.CanInsert() && r < visRows) {
            int ay = bodyTop + r * rowH;
            int addId = app.focus.AllocId();
            app.hitTester.RegisterRect(addId, x, ay, viewW, rowH, 0);
            bool aHover = app.focus.IsHovered(addId);
            int aBg = sRow.BgOr(0);
            if (aHover) { aBg = sRowHover.BgOr(0); }
            c.FillRect(x + 1, ay, viewW - 2, rowH, aBg);
            int aIco = app.Scale(12);
            int aIx = x + app.Scale(8);
            int aFg = sIcon.FgOr(0);
            if (aHover) { aFg = sIconSel.FgOr(0); }
            c.DrawGlyph("plus", aIx, ay + (rowH - aIco) / 2, aIco, aFg);
            c.DrawText(aIx + aIco + app.Scale(6),
                       ay + (rowH - Style.FontFallback(app, "small")) / 2,
                       DataTable.T("Click to add row", "点击添加新行  Click to add row"), aFg, Style.FontFallback(app, "small"));
            c.FillRect(x + 1, ay + rowH - 1, viewW - 2, 1, gridColor);
            if (app.EventKind() == 3 && app.window.EventButton() == 0
                && app.hitTester.HitTest(app.mouseX, app.mouseY) == addId) {
                int newRow = DataTable.AppendRow(st, cols, src);
                if (newRow >= 0) {
                    // 先重算：行必须存在于显示顺序中，
                    // 光标才能停靠其上，否则 BeginEdit 会
                    // 在尚不存在的槽位上打开。
                    DataTable.Recompute(st, cols, src);
                    DataTable.FocusRow(st, cols, src, newRow);
                }
                app.RequestRedraw();
            }
        }

        // ---------------- 冻结边界 ----------------
        // 每个冻结带内缘的分隔线标出
        // 滚动区域的起止，让固定列看起来是
        // 有意停驻，而非渲染错误。
        if (pinnedW > 0 && bandX < clipRight) {
            c.FillRect(bandX, y, app.Scale(2), bodyTop + bodyH - y, sSurface.BorderOr(0));
        }
        if (pinnedRW > 0 && rightX > firstDataX) {
            c.FillRect(rightX - app.Scale(2), y, app.Scale(2), bodyTop + bodyH - y, sSurface.BorderOr(0));
        }

        // ---------------- 行拖放指示器 ----------------
        if (st.dragRow >= 0 && st.dragMoved) {
            int dropRow = (app.mouseY - bodyTop) / rowH;
            if (dropRow < 0) { dropRow = 0; }
            if (dropRow > visRows) { dropRow = visRows; }
            int dy = bodyTop + dropRow * rowH;
            if (dy < bodyTop) { dy = bodyTop; }
            if (dy > bodyTop + bodyH) { dy = bodyTop + bodyH; }
            c.FillRect(x + 1, dy - 1, viewW - 2, app.Scale(2), sAccent.BgOr(0));
            // 跟随指针的行芯片：拖动过程中一直能看到"正在搬
            // 哪一行"。行号随落点变化，不能标识行；用首个
            // 可见列的内容作为稳定的行身份。
            string rl = "";
            int dragSrcRow = DataTable.DispRowOf(st, st.dragRow);
            for (int dc = 0; dc < st.colOrder.Count; dc = dc + 1) {
                int dci = st.colOrder[dc];
                if (dci < st.colHidden.Count && st.colHidden[dci]) { continue; }
                rl = DataTable.CellTextRouted(cols, src, dragSrcRow, dci);
                if (rl != "") { break; }
            }
            int rchFs = sAccent.FontOr(Style.FontFallback(app, "small"));
            rl = DataTable.Truncate(rl, rchFs, app.Scale(180));
            if (rl != "") {
                int rchW = Canvas.MeasureText(rl, rchFs) + app.Scale(16);
                int rchX = app.mouseX + app.Scale(8);
                if (rchX + rchW > x + viewW) { rchX = x + viewW - rchW; }
                int rchY = app.mouseY - rowH / 2;
                if (rchY < bodyTop) { rchY = bodyTop; }
                c.FillRoundRect(rchX, rchY, rchW, rowH, t.borderRadiusSmall, sAccent.BgOr(0));
                c.DrawTextCentered(rchX, rchY, rchW, rowH, rl, sAccent.FgOr(0), rchFs);
            }
        }

        // ---------------- 内联单元格编辑器浮层 ----------------
        st.edPopHot = false;
        if (st.editing && edVis && edW > app.Scale(8)) {
            DataTable.RenderEditor(app, cols, src, st, edX, edY, edW, edH);
        }

        // ---------------- 表格体指针交互 ----------------
        // 仅凭几何位置将指针映射到顺序行和数据列
        // （即使在命中区域之外，也能用于扩展范围/重排）。
        int ptrOi = -1;
        if (app.mouseY >= bodyTop && app.mouseY < bodyTop + bodyH && app.mouseX >= x && app.mouseX < clipRight) {
            int rr2 = (app.mouseY - bodyTop) / rowH;
            if (rr2 >= 0 && rr2 < visRows && (start + rr2) < total) { ptrOi = start + rr2; }
            // 详情带是 provider 自己的区域，不是行：按压
            // 不应启动范围选择、重排拖拽或
            // 编辑器。在这里清零可让下方所有使用 ptrOi 的代码
            // 无需各自重新判断 kind。
            if (ptrOi >= 0 && DataTable.DispKind(st, ptrOi) == 2) { ptrOi = -1; }
        }
        int ptrCol = -1;
        if (ptrOi >= 0 && app.mouseX >= firstDataX) {
            // 从后往前扫描，让冻结带优先：中间列
            // 滚动到冻结列下方时 x 坐标相同，用户
            // 实际看到的列才是他们想点击的列。
            int pci = frameColumns.Count - 1;
            while (pci >= 0) {
                FrameColumn pointerColumn = frameColumns[pci];
                int cci = pointerColumn.column;
                int colL = pointerColumn.x;
                int colR = colL + st.dispW[cci];
                int pbL = DataTable.BandLeft(pointerColumn.band, firstDataX, bandX, rightX);
                int pbR = DataTable.BandRight(pointerColumn.band, firstDataX, bandX, bandW,
                                              rightX, pinnedW, pinnedRW, clipRight);
                if (colL < pbL) { colL = pbL; }
                if (colR > pbR) { colR = pbR; }
                if (app.mouseX >= colL && app.mouseX < colR) { ptrCol = cci; pci = -1; }
                else { pci = pci - 1; }
            }
        }

        // ---------------- 截断单元格的悬停提示 ----------------
        // 商业网格的惯例：文本放不下被截断的单元格，悬停
        // 片刻后弹出完整内容。只在纯文本/链接/标签单元格上
        // 生效；编辑器、菜单、拖选进行中一律不打扰。指针停稳
        // (DefaultDelayMs) 前持续请求该区域重绘，让计时器有帧可用；
        // 计时器在指针离开或换格时重置。触摸设备没有悬停——
        // 手指停留即长按手势，这里必须整体跳过（st.tipOi 常驻
        // -1），不与长按菜单抢帧。
        if (touchUi) { st.tipOi = -1; }
        else if (ptrOi >= 0 && ptrCol >= 0 && DataTable.DispKind(st, ptrOi) == 0
            && !st.editing && !st.ctxOpen && !st.hdrCtxOpen && !st.chartOpen
            && !st.pivotOpen && !st.colChooserOpen
            && st.openMenu < 0 && !st.rangeDrag && !st.rowSelDrag && st.dragRow < 0) {
            DataColumn tipCol = cols[ptrCol];
            if (!tipCol.isBool
                && (tipCol.cellType == 0 || tipCol.cellType == 1 || tipCol.cellType == 2)) {
                string tipFull = DataTable.CellTextRouted(cols, src, DataTable.DispRowOf(st, ptrOi), ptrCol);
                if (tipCol.cellType != 2) { tipFull = DataTable.FormatCell(tipCol, tipFull); }
                int tipW = st.dispW[ptrCol];
                if (Canvas.MeasureText(tipFull, fs) > tipW - t.paddingSmall * 2) {
                    int tipNowMs = Window.GetTickMs();
                    if (st.tipOi != ptrOi || st.tipCol != ptrCol) {
                        st.tipOi = ptrOi;
                        st.tipCol = ptrCol;
                        st.tipSinceMs = tipNowMs;
                    }
                    int tvi = DataTable.VisPos(frameColumns, ptrCol);
                    int tipRy = bodyTop + (ptrOi - start) * rowH;
                    if (tipNowMs - st.tipSinceMs < Tooltip.DefaultDelayMs()) {
                        if (tvi >= 0) {
                            app.RequestAnimationFrameIn(0, frameColumns[tvi].x, tipRy,
                                                        tipW, rowH);
                        }
                    } else if (tvi >= 0) {
                        Tooltip.RequestBox(app, frameColumns[tvi].x, tipRy, tipW, rowH,
                                           tipFull, Tooltip.Bottom(), app.Scale(280));
                    }
                } else { st.tipOi = -1; }
            } else { st.tipOi = -1; }
        } else { st.tipOi = -1; }

        int ek = app.EventKind();
        int eb = app.window.EventButton();
        int emods = app.window.EventMods();

        // ---------------- 筛选行键盘处理 ----------------
        // 筛选行单元格获得焦点时会吞掉键盘事件
        // （可打印字符、Backspace、Delete、左右方向键、Escape、Enter/Tab），
        // 使其不会到达表格体交互和内联编辑器。
        if (st.filterRowFocusCol >= 0) {
            int frc = st.filterRowFocusCol;
            bool frKeyHandled = false;
            if (ek == 6) {
                int fkc = app.window.EventKeyCode();
                if (fkc == 27) {
                    // Escape：清除该列筛选并失焦
                    st.filterRowBuf = "";
                    if (st.filterRowText[frc].Length > 0) {
                        st.filterRowText[frc] = "";
                        st.dirty = true;
                        st.FilterChanged.Raise();
                    }
                    st.filterRowFocusCol = -1;
                } else if (fkc == 8) {
                    // 退格
                    if (st.filterRowCur > 0) {
                        int prevStart = Text.PrevCharStart(st.filterRowBuf, st.filterRowCur);
                        st.filterRowBuf = Text.DeleteBefore(st.filterRowBuf, st.filterRowCur);
                        st.filterRowCur = prevStart;
                        st.filterRowText[frc] = st.filterRowBuf;
                        st.dirty = true;
                        st.FilterChanged.Raise();
                    }
                } else if (fkc == 46) {
                    // 删除键
                    if (st.filterRowCur < st.filterRowBuf.Length) {
                        st.filterRowBuf = Text.RemoveAt(st.filterRowBuf, st.filterRowCur);
                        st.filterRowText[frc] = st.filterRowBuf;
                        st.dirty = true;
                        st.FilterChanged.Raise();
                    }
                } else {
                    string fch = Text.CharStr(fkc);
                    if (fch.Length > 0) {
                        st.filterRowBuf = Text.InsertAt(st.filterRowBuf, st.filterRowCur, fch);
                        st.filterRowCur = st.filterRowCur + fch.Length;
                        st.filterRowText[frc] = st.filterRowBuf;
                        st.dirty = true;
                        st.FilterChanged.Raise();
                    }
                }
                frKeyHandled = true;
            } else if (ek == 4) {
                int fkc2 = app.window.EventKeyCode();
                if (fkc2 == 13 || fkc2 == 9) {
                    // Enter / Tab：提交并失焦
                    st.filterRowText[frc] = st.filterRowBuf;
                    st.filterRowFocusCol = -1;
                } else if (fkc2 == 37) {
                    if (st.filterRowCur > 0) { st.filterRowCur = Text.PrevCharStart(st.filterRowBuf, st.filterRowCur); }
                } else if (fkc2 == 39) {
                    if (st.filterRowCur < st.filterRowBuf.Length) { st.filterRowCur = Text.NextCharEnd(st.filterRowBuf, st.filterRowCur); }
                } else if (fkc2 == 36) {
                    st.filterRowCur = 0;
                } else if (fkc2 == 35) {
                    st.filterRowCur = st.filterRowBuf.Length;
                }
                frKeyHandled = true;
            }
            // 点击筛选行之外会使焦点单元格失焦
            if (ek == 2 && (app.mouseY < y + headerH || app.mouseY >= y + headerH + filterRowH)) {
                st.filterRowText[frc] = st.filterRowBuf;
                st.filterRowFocusCol = -1;
            }
            if (frKeyHandled) { ek = 0; app.RequestRedraw(); }
        }
        // 右键菜单打开时是模态的：吞掉表格体事件，
        // 避免点击菜单项时还在其下方触发范围/选择。
        // （RenderContextMenu 读取原始事件来驱动菜单项命中/关闭。）
        if (st.ctxOpen) { ek = 0; }
        if (st.hdrCtxOpen) { ek = 0; }
        if (st.colChooserOpen) { ek = 0; }
        // 打开的编辑器弹窗同理：其列表/日历已处理按压，
        // 下方的单元格不应将其视为新的选择。
        if (st.edPopHot) { ek = 0; }

        // ---------------- 内联编辑器按键处理 ----------------
        // 编辑器打开时独占键盘：可打印输入、光标
        // 移动和提交/取消。事件被吞掉，避免同时
        // 驱动编辑器背后的选择/滚动。
        // 这里只吞键盘事件；鼠标按下会落到
        // 按压处理器，它会在重新选择前先提交编辑。
        if (st.editing) {
            DataColumn ecol = cols[st.editCol];
            if (ek == 6) {
                int code = app.window.EventKeyCode();
                if (code == 13) { DataTable.CommitEdit(st, cols, src); }
                else if (code == 27) { DataTable.CancelEdit(st); }
                else if (code == 9) { DataTable.CommitEdit(st, cols, src); }
                else if (code == 8) {
                    if (st.editCur > 0) {
                        int startp = Text.PrevCharStart(st.editBuf, st.editCur);
                        st.editBuf = Text.DeleteBefore(st.editBuf, st.editCur);
                        st.editCur = startp;
                        // 输入会使之前的拒绝失效：
                        // 错误信息对应的值已不存在。
                        st.editError = "";
                        if (ecol.editorKind == 1) { DataTable.RefreshChoices(st, ecol); }
                    }
                } else {
                    string ch = Text.CharStr(code);
                    if (ch.Length > 0) {
                        st.editBuf = Text.InsertAt(st.editBuf, st.editCur, ch);
                        st.editCur = st.editCur + ch.Length;
                        st.editError = "";
                        if (ecol.editorKind == 1) {
                            st.edPopOpen = true;
                            DataTable.RefreshChoices(st, ecol);
                        }
                    }
                }
                app.RequestRedraw();
                ek = 0;
            } else if (ek == 4) {
                int kc = app.window.EventKeyCode();
                // 上/下方向键驱动编辑器的纵向控件：
                // 下拉高亮项、日历周或数字微调器。
                bool consumed = true;
                if (kc == 38 || kc == 40) {
                    int dir = 1;
                    if (kc == 38) { dir = -1; }
                    if (ecol.editorKind == 1) {
                        st.edPopOpen = true;
                        DataTable.MoveChoice(st, dir);
                    } else if (ecol.editorKind == 2) {
                        DataTable.CalendarStep(st, ecol, dir * 7);
                    } else if (ecol.editorKind == 3) {
                        st.editBuf = DataTable.StepValue(ecol, st.editBuf, 0 - dir);
                        st.editCur = st.editBuf.Length;
                        st.editError = "";
                    } else { consumed = false; }
                } else if (kc == 27) {
                    // Escape 先关闭弹窗，然后才关闭编辑器——
                    // 这样关闭列表不会丢掉已输入的文字。
                    if (st.edPopOpen) { st.edPopOpen = false; }
                    else { DataTable.CancelEdit(st); }
                } else if (kc == 13) { DataTable.CommitEdit(st, cols, src); }
                else if (kc == 37) {
                    if (ecol.editorKind == 2) { DataTable.CalendarStep(st, ecol, -1); }
                    else if (st.editCur > 0) { st.editCur = Text.PrevCharStart(st.editBuf, st.editCur); }
                } else if (kc == 39) {
                    if (ecol.editorKind == 2) { DataTable.CalendarStep(st, ecol, 1); }
                    else if (st.editCur < st.editBuf.Length) { st.editCur = Text.NextCharEnd(st.editBuf, st.editCur); }
                } else if (kc == 33 && ecol.editorKind == 2) { st.edCalMonth = st.edCalMonth - 1; }
                else if (kc == 34 && ecol.editorKind == 2) { st.edCalMonth = st.edCalMonth + 1; }
                else if (kc == 36) { st.editCur = 0; }
                else if (kc == 35) { st.editCur = st.editBuf.Length; }
                else if (kc == 46) {
                    if (st.editCur < st.editBuf.Length) {
                        st.editBuf = Text.RemoveAt(st.editBuf, st.editCur);
                        st.editError = "";
                        if (ecol.editorKind == 1) { DataTable.RefreshChoices(st, ecol); }
                    }
                } else { consumed = false; }
                app.RequestRedraw();
                if (consumed) { ek = 0; }
            }
        }

        // F2 / Enter 在当前可编辑单元格上打开编辑器（类似 Excel）。
        // bool 单元格没有可编辑的文本：同样的按键直接切换它。
        if (!st.editing && ek == 4) {
            int kc2 = app.window.EventKeyCode();
            if ((kc2 == 113 || kc2 == 13) && st.hitRow >= 0 && st.hitCol >= 0
                && st.hitCol < cols.Count && cols[st.hitCol].editable) {
                if (cols[st.hitCol].isBool) {
                    DataTable.ToggleBoolCell(st, cols, src, st.hitRow, st.hitCol);
                } else {
                    DataTable.BeginEdit(st, cols, src, st.hitRow, st.hitCol);
                }
                ek = 0;
                app.RequestRedraw();
            }
        }

        // ---------------- 单元格光标键盘导航 ----------------
        // 方向键 / PgUp / PgDn / Home / End 移动光标，Shift 扩展
        // 范围，Ctrl+C/V/X/A 作用于其上。以网格被
        // 交互过（st.hitRow）为前提，因为该控件自身没有键盘焦点——
        // 否则未被触碰的网格会吞掉 Tab 和方向键，
        // 使页面上其他控件无法使用。以下情况时同样让位：
        // 有其他东西占用键盘：打开的编辑器、获得焦点的筛选行
        // 单元格或模态弹窗。
        if (!st.editing && ek == 4 && st.hitRow >= 0
            && st.filterRowFocusCol < 0 && st.openMenu < 0 && !st.colChooserOpen) {
            if (DataTable.HandleNavKey(app, cols, src, st, frameColumns, visRows,
                                       dataViewW, pinnedW, app.window.EventKeyCode(), emods)) {
                ek = 0;
                app.RequestRedraw();
            }
        }

        // 左键按下。模态浮层（透视/图表/列选择器）打开时整个
        // 面板吞掉按下——浮层自身的命中按几何判定，不注册
        // 单元格区域，放行会穿透到格子上改掉选区/范围。
        if (ek == 2 && eb == 0 && ptrOi >= 0
            && !st.pivotOpen && !st.chartOpen && !st.colChooserOpen) {
            bool ctrlDrag = (emods & 1) != 0;          // Ctrl：追加选区区域
            // 填充柄按下：进入填充拖拽，不启动范围选择。
            int grabW = app.Scale(6);
            if (st.fillHX >= 0 && !st.editing
                && app.mouseX >= st.fillHX - grabW && app.mouseX < st.fillHX + grabW
                && app.mouseY >= st.fillHY - grabW && app.mouseY < st.fillHY + grabW) {
                st.fillDrag = true;
                st.fillSR0 = DataTable.MinI(st.rangeR0, st.rangeR1);
                st.fillSR1 = DataTable.MaxI(st.rangeR0, st.rangeR1);
                st.fillSC0 = DataTable.MinI(st.rangeC0, st.rangeC1);
                st.fillSC1 = DataTable.MaxI(st.rangeC0, st.rangeC1);
                st.fillTR0 = 0; st.fillTR1 = -1;
                st.fillTC0 = 0; st.fillTC1 = -1;
                app.RequestRedraw();
            } else if (DataTable.DispKind(st, ptrOi) == 1) {
                // 分组标题按下：切换该组折叠状态
                int gi = DataTable.DispRowOf(st, ptrOi);
                DataTable.ToggleCollapse(st, st.groups[gi].key);
                app.RequestRedraw();
            } else if (app.mouseX >= x && app.mouseX < x + numW && !st.rowGripDrag) {
                // 行号按下：选中该行并开始多选拖选（重排只能
                // 从行号右侧的专用手柄发起，已在上面处理）。
                DataTable.PickRow(st, src, ptrOi, emods);
                st.rowSelDrag = true;
                app.RequestRedraw();
            } else if (app.mouseX >= firstDataX && ptrCol >= 0) {
                // 点击已是唯一选中状态的单元格
                // （慢速二次点击）会打开内联编辑器；否则开始
                // 矩形范围选择。编辑中按下则先提交
                // ，再重新选择。
                bool sameCell = (!st.editing) && st.hitOrder == ptrOi && st.hitCol == ptrCol
                    && st.rangeR0 == st.rangeR1 && st.rangeC0 == st.rangeC1;
                if (st.editing) { DataTable.CommitEdit(st, cols, src); }
                // 被拒绝的提交保持编辑器打开；此时移动选择
                // 会让编辑器悬在无关的单元格上，因此这次按压
                // 用于显示错误信息。
                if (st.editing) {
                    app.RequestRedraw();
                } else if (sameCell && cols[ptrCol].editable && !cols[ptrCol].isBool
                           && !ctrlDrag) {
                    DataTable.BeginEdit(st, cols, src, DataTable.DispRowOf(st, ptrOi), ptrCol);
                    app.RequestRedraw();
                } else {
                    // Ctrl 按下（Excel 式追加区域）：固化当前范围、
                    // 在其上开新区域；普通按下丢弃全部归档，回到
                    // 单矩形选择。Ctrl+单格点击同样追加一个
                    // 单格区域——与 Excel "Ctrl+点击加选"一致。
                    // Ctrl 按下不复用 sameCell 快捷路径：重复
                    // Ctrl+点击同一格是"再次追加该格"，不是打开编辑。
                    if (ctrlDrag) {
                        if (DataTable.HasRange(st)) { DataTable.ArchiveRange(st); }
                    } else if (DataTable.HasMulti(st)) {
                        DataTable.ClearMulti(st);
                    }
                    st.rangeR0 = ptrOi;
                    st.rangeR1 = ptrOi;
                    st.rangeC0 = ptrCol;
                    st.rangeC1 = ptrCol;
                    st.rangeDrag = true;
                    st.rangeSelTouched.Clear();
                    st.selAnchor = ptrOi;
                    st.hitOrder = ptrOi;
                    st.hitRow = DataTable.DispRowOf(st, ptrOi);
                    st.hitCol = ptrCol;
                    // 触摸长按打开行菜单的锚点：App.PollLongPress
                    // 比对 pressStartId，这里用 -2 哨兵把单元格
                    // 按压与真实控件 id 区分开（桌面无副作用）。
                    if (touchUi) { app.NotePressSentinel(-2); }
                    st.CellClick.Raise();
                    app.RequestRedraw();
                }
            }
        }

        // 拖拽移动
        if (ek == 1) {
            // 填充拖拽：按指针位置推出单轴目标矩形
            // （源块内→无目标），渲染层铺色反馈。
            if (st.fillDrag) {
                st.fillTR0 = 0; st.fillTR1 = -1;
                st.fillTC0 = 0; st.fillTC1 = -1;
                if (ptrOi >= 0) {
                    if (ptrOi > st.fillSR1) {
                        st.fillTR0 = st.fillSR1 + 1; st.fillTR1 = ptrOi;
                        st.fillTC0 = st.fillSC0; st.fillTC1 = st.fillSC1;
                    } else if (ptrOi < st.fillSR0) {
                        st.fillTR0 = ptrOi; st.fillTR1 = st.fillSR0 - 1;
                        st.fillTC0 = st.fillSC0; st.fillTC1 = st.fillSC1;
                    } else if (ptrCol >= 0 && ptrCol > st.fillSC1) {
                        st.fillTC0 = st.fillSC1 + 1; st.fillTC1 = ptrCol;
                        st.fillTR0 = st.fillSR0; st.fillTR1 = st.fillSR1;
                    } else if (ptrCol >= 0 && ptrCol < st.fillSC0) {
                        st.fillTC0 = ptrCol; st.fillTC1 = st.fillSC0 - 1;
                        st.fillTR0 = st.fillSR0; st.fillTR1 = st.fillSR1;
                    }
                    app.RequestRedraw();
                }
            }
            // 行号列上拖动：从锚点到当前行连续选中（多选）
            if (st.rowSelDrag && ptrOi >= 0 && DataTable.DispKind(st, ptrOi) == 0) {
                DataTable.SelectRowSpan(st, src, st.selAnchor, ptrOi);
                st.hitOrder = ptrOi;
                st.hitRow = DataTable.DispRowOf(st, ptrOi);
                st.SelectionChanged.Raise();
                app.RequestRedraw();
            }
            if (st.rangeDrag && ptrOi >= 0) {
                st.rangeR1 = ptrOi;
                if (ptrCol >= 0) { st.rangeC1 = ptrCol; }
                // 选择列表格：高亮矩形覆盖到哪几行，
                // 勾选框就勾到哪几行（范围缩小时实时退勾）。
                DataTable.SyncRangeChecks(st, src);
                // 触摸设备：按住未动满 500ms => 长按打开行上下文
                // 菜单（桌面右键的移动端等价物）。PollLongPress
                // 只在 pressStartId == -2 的按压上生效（-2 是表格
                // 体内单元格按压的哨兵 id，不会与真实控件 id 撞车），
                // 返回一次 true；移动超差时它置 longPressFired，
                // 手势继续作为普通范围拖拽。长按命中后收窄选择到
                // 该行（菜单的复制/导出要有对象可用，镜像右键行为），
                // 并结束范围拖拽。
                if (touchUi && st.openMenu < 0 && !st.hdrCtxOpen && !st.colChooserOpen
                    && app.PollLongPress(-2)) {
                    st.ctxX = app.mouseX;
                    st.ctxY = app.mouseY;
                    st.ctxRow = -1;
                    st.ctxOrder = -1;
                    if (DataTable.DispKind(st, ptrOi) == 0) {
                        int ri = DataTable.DispRowOf(st, ptrOi);
                        st.ctxRow = ri;
                        st.ctxOrder = ptrOi;
                        if (!DataTable.IsSelected(st, src, ri)) {
                            DataTable.SelectAllRows(st, src, false);
                            DataTable.SetSelected(st, src, ri, true);
                            st.selAnchor = ptrOi;
                        }
                    }
                    st.RowContext.Raise();
                    if (!st.externalRowMenu) { st.ctxOpen = true; }
                    st.rangeDrag = false;
                    app.RequestRedraw();
                }
            }
            if (st.dragRow >= 0) {
                int dd = app.mouseY - st.dragStartY;
                if (dd < 0) { dd = 0 - dd; }
                if (dd > rowH / 2) { st.dragMoved = true; app.RequestRedraw(); }
            }
        }

        // 左键释放
        if (ek == 3 && eb == 0) {
            // 填充释放：把源块铺进目标（数值级差外推，其余复制）。
            if (st.fillDrag) {
                st.fillDrag = false;
                if (st.fillTR0 <= st.fillTR1 && st.fillTC0 <= st.fillTC1) {
                    int filled = DataTable.FillApply(st, cols, src,
                                                     st.fillSR0, st.fillSC0, st.fillSR1, st.fillSC1,
                                                     st.fillTR0, st.fillTC0, st.fillTR1, st.fillTC1);
                    if (filled > 0) {
                        DataTable.Flash(st, DataTable.TN("Filled {n} cells", filled, "已填充 {n} 个单元格"));
                    }
                }
                st.fillTR0 = 0; st.fillTR1 = -1;
                st.fillTC0 = 0; st.fillTC1 = -1;
                // 双击填充柄（快速二次点击落在柄上，未拖动）：
                // 一次性把源块铺到最后一行（Excel 惯例）。
                // 判断必须在释放路径——DoubleClickNow 由释放完成时
                // 的 NoteClickTarget 置位，按下阶段恒为上一次的值。
                int grabW = app.Scale(6);
                if (st.fillHX >= 0 && app.DoubleClickNow()
                    && app.mouseX >= st.fillHX - grabW && app.mouseX < st.fillHX + grabW
                    && app.mouseY >= st.fillHY - grabW && app.mouseY < st.fillHY + grabW) {
                    int lastSlot = DataTable.LastDataSlot(st);
                    if (lastSlot > st.fillSR1) {
                        int dfilled = DataTable.FillApply(st, cols, src,
                                                          st.fillSR0, st.fillSC0, st.fillSR1, st.fillSC1,
                                                          st.fillSR1 + 1, st.fillSC0, lastSlot, st.fillSC1);
                        if (dfilled > 0) {
                            DataTable.Flash(st, DataTable.TN("Filled {n} cells", dfilled, "已填充 {n} 个单元格"));
                        }
                    }
                }
                app.RequestRedraw();
            }
            if (st.rangeDrag) { st.rangeDrag = false; st.rangeSelTouched.Clear(); app.RequestRedraw(); }
            if (st.rowSelDrag) { st.rowSelDrag = false; app.RequestRedraw(); }
            if (st.dragRow >= 0) {
                if (st.groupCols.Count == 0 && st.dragMoved && ptrOi >= 0 && ptrOi != st.dragRow
                    && DataTable.DispKind(st, ptrOi) == 0) {
                    DataTable.MoveOrder(st, st.dragRow, ptrOi);
                    // 手动排序——清除当前排序而不重新执行
                    // Recompute（它会重建 st.order 并丢失本次移动）。
                    st.sortKeys.Clear();
                    DataTable.SyncPrimary(st);
                    app.RequestRedraw();
                } else if (!st.dragMoved && DataTable.DispKind(st, st.dragRow) == 0) {
                    // 手柄上没拖动就松手：当作按行选择的点击
                    DataTable.PickRow(st, src, st.dragRow, emods);
                    app.RequestRedraw();
                }
                st.dragRow = -1;
                st.dragMoved = false;
                st.rowGripDrag = false;
            }
        }

        // 双击表格体中的行
        if (ek == 3 && eb == 0 && ptrOi >= 0 && DataTable.DispKind(st, ptrOi) == 0 && app.DoubleClickNow()) {
            st.hitOrder = ptrOi;
            st.hitRow = DataTable.DispRowOf(st, ptrOi);
            st.RowDoubleClick.Raise();
        }

        // 右键按下 => 弹出上下文菜单
        if (ek == 2 && eb == 1 && st.openMenu < 0 && !st.colChooserOpen
            && app.mouseX >= x && app.mouseX < x + viewW
            && app.mouseY >= bodyTop && app.mouseY < bodyTop + bodyH) {
            // 如果右键点击的行不在当前范围/选择内，
            // 就选中该行，让菜单的复制/导出有对象可用。
            if (ptrOi >= 0 && DataTable.DispKind(st, ptrOi) == 0 && !DataTable.HasRange(st)) {
                int ri = DataTable.DispRowOf(st, ptrOi);
                if (!DataTable.IsSelected(st, src, ri)) {
                    DataTable.SelectAllRows(st, src, false);
                    DataTable.SetSelected(st, src, ri, true);
                    st.selAnchor = ptrOi;
                }
            }
            st.ctxX = app.mouseX;
            st.ctxY = app.mouseY;
            st.ctxRow = -1;
            st.ctxOrder = -1;
            if (ptrOi >= 0 && DataTable.DispKind(st, ptrOi) == 0) {
                st.ctxRow = DataTable.DispRowOf(st, ptrOi);
                st.ctxOrder = ptrOi;
            }
            st.RowContext.Raise();
            if (!st.externalRowMenu) { st.ctxOpen = true; }
            app.RequestRedraw();
        }

        // 空状态：文案已由上方空态/加载覆盖层统一绘制
        // （empty/loading 双态 + overlayKind 诊断），这里不再重复。

        // ---------------- 汇总（总计）行 ----------------
        if (st.showSummary) {
            int sumY = bodyTop + bodyH;
            c.FillRect(x + 1, sumY, viewW - 2, summaryH, sFooter.BgOr(0));
            c.FillRect(x + 1, sumY, viewW - 2, 1, gridColor);
            int sx = x + numW + selW;
            if (st.showRowNum || st.showSelect) {
                c.DrawTextCentered(x, sumY, numW + selW, summaryH, "Σ", sHint.FgOr(0), Style.FontFallback(app, "small"));
            }
            int sBand = -1;
            for (int soi = 0; soi < frameColumns.Count; soi = soi + 1) {
                FrameColumn summaryColumn = frameColumns[soi];
                int sc = summaryColumn.column;
                int cw = st.dispW[sc];
                if (summaryColumn.band != sBand) {
                    if (sBand >= 0) { c.PopClip(); }
                    sBand = summaryColumn.band;
                    DataTable.PushBandClip(c, sBand, firstDataX, bandX, bandW, rightX,
                                           pinnedW, pinnedRW, sumY, summaryH, clipRight);
                }
                sx = summaryColumn.x;
                int sBandL = DataTable.BandLeft(summaryColumn.band, firstDataX, bandX, rightX);
                int sBandR = DataTable.BandRight(summaryColumn.band, firstDataX, bandX, bandW,
                                                 rightX, pinnedW, pinnedRW, clipRight);
                if (sx + cw > sBandL && sx < sBandR) {
                    string stxt = "";
                    if (sc < st.summaryText.Count) { stxt = st.summaryText[sc]; }
                    if (stxt.Length > 0) {
                        int pad = t.paddingSmall;
                        string shown = DataTable.Truncate(stxt, fs, cw - pad * 2);
                        int tw = Canvas.MeasureText(shown, fs);
                        int tx = sx + pad;
                        if (cols[sc].align == 2) { tx = sx + cw - pad - tw; }
                        else if (cols[sc].align == 1) { tx = sx + (cw - tw) / 2; }
                        int ty = Canvas.CenterTextY(sumY, summaryH, fs);
                        c.DrawText(tx, ty, shown, sCellBox.FgOr(0), fs);
                    }
                }
            }
            if (sBand >= 0) { c.PopClip(); }
        }

        // ---------------- 分页器页脚（复用 Pagination 控件） ----------------
        if (st.paged) {
            int fY = bodyTop + bodyH + summaryH;
            c.FillRect(x + 1, fY, viewW - 2, pagerH, sFooter.BgOr(0));
            c.FillRect(x + 1, fY, viewW - 2, 1, gridColor);
            int totalPages = 1;
            if (total > 0) { totalPages = (total + visRows - 1) / visRows; }
            int cur = st.pageModel.Get();
            int pgW = Pagination.MeasureWidth(app, totalPages, cur);
            int pgX = x + (viewW - pgW) / 2;
            if (pgX < x + t.paddingMedium) { pgX = x + t.paddingMedium; }
            int pgY = fY + (pagerH - t.heightMedium) / 2;
            Pagination.Of(totalPages, st.pageModel).RenderAt(app, pgX, pgY);
            // 左侧显示范围信息
            int from = (cur - 1) * visRows + 1;
            int to = cur * visRows;
            if (to > total) { to = total; }
            if (total == 0) { from = 0; }
            string info = Convert.ToString(from) + "-" + Convert.ToString(to) + " / " + Convert.ToString(total);
            c.DrawText(x + t.paddingMedium, Canvas.CenterTextY(pgY, t.heightMedium, Style.FontFallback(app, "small")), info, sHint.FgOr(0), Style.FontFallback(app, "small"));
        }

        // ---------------- 状态栏（DevExpress 风格底部条） ----------------
        // 左侧：筛选/总行数 + 选中行数。右侧：当前
        // 单元格范围选择的实时总和/平均值/单元格数（仅数值列），
        // 让用户不用离开网格就能快速估算总计，
        // 与 Excel/DevExpress 的状态栏相同。
        if (st.showStatusBar) {
            int sbY = bodyTop + bodyH + summaryH + pagerH;
            c.FillRect(x + 1, sbY, viewW - 2, statusBarH, sFooter.BgOr(0));
            c.FillRect(x + 1, sbY, viewW - 2, 1, gridColor);
            int sbFs = Style.FontFallback(app, "small");
            int sbTy = Canvas.CenterTextY(sbY, statusBarH, sbFs);

            int totalSrc = src.RowCount();
            int shownRows = st.order.Count;
            string rowInfo = DataTable.T("Rows", "行数:") + " " + Convert.ToString(shownRows);
            if (shownRows != totalSrc) { rowInfo = rowInfo + " / " + Convert.ToString(totalSrc); }
            int selCount = 0;
            if (st.selectionModel != null && st.selectionModel.AllSelected()) { selCount = -1; }
            else { for (int sci = 0; sci < st.selected.Count; sci = sci + 1) { if (st.selected[sci]) { selCount = selCount + 1; } } }
            if (selCount > 0) { rowInfo = rowInfo + "    " + DataTable.T("Selected", "已选:") + " " + Convert.ToString(selCount); }
            c.DrawText(x + t.paddingMedium, sbTy, rowInfo, sFooter.FgOr(0), sbFs);

            // 活动筛选条件概览：rowInfo 之后逐个列出可清除的条件
            // chips（列标题 + 短描述），点击清除该列筛选；
            // 没有活动筛选时零开销（列表为空）。
            List<string> fitems = DataTable.FilterSummaryItems(st, cols);
            int chipX = x + t.paddingMedium + Canvas.MeasureText(rowInfo, sbFs) + app.Scale(16);
            int chipRight = x + viewW - t.paddingMedium;
            int chipH2 = statusBarH - app.Scale(8);
            for (int fi = 0; fi < fitems.Count && chipX < chipRight; fi = fi + 1) {
                string label = fitems[fi];
                int cw = Canvas.MeasureText(label, sbFs) + app.Scale(22);
                int cwx = chipX + cw;
                if (cwx > chipRight) { break; }
                int chipId = app.focus.AllocId();
                int chipState2 = Style.SNormal();
                if (app.focus.IsHovered(chipId)) { chipState2 = Style.SHover(); }
                StyleBox sChip2 = Style.Part(app, "datatable", "chip", "", "rule", "",
                                             chipState2);
                c.FillRoundRect(chipX, sbY + app.Scale(4), cw, chipH2, chipH2 / 2, sChip2.BgOr(0));
                c.DrawTextCentered(chipX, sbY + app.Scale(4), cw - app.Scale(12), chipH2,
                                   label, sChip2.FgOr(0), sbFs);
                // 清除 ×
                int xx = chipX + cw - app.Scale(14);
                c.DrawTextCentered(xx, sbY + app.Scale(4), app.Scale(12), chipH2,
                                   "×", sChip2.FgOr(0), sbFs);
                app.hitTester.RegisterRect(chipId, chipX, sbY + app.Scale(4), cw, chipH2, 0);
                if (app.EventKind() == 3 && app.window.EventButton() == 0
                    && app.hitTester.HitTest(app.mouseX, app.mouseY) == chipId) {
                    // 清除该条筛选：组合树条目清树，其余按列清 ColFilter
                    // 与筛选行文本。
                    if (fi >= cols.Count) {
                        DataTable.SetFilterTree(st, null);
                    } else {
                        st.filters[fi].Reset();
                        if (fi < st.filterRowText.Count) { st.filterRowText[fi] = ""; }
                    }
                    DataTable.InvalidateQuery(st);
                    st.FilterChanged.Raise();
                    app.RequestRedraw();
                }
                chipX = cwx + app.Scale(6);
            }

            if (DataTable.HasRange(st) || DataTable.HasMulti(st)) {
                // 多区域（Ctrl 追加）时按全部区域并集汇总；单矩形时
                // 即普通范围。跳过重叠（Excel 也不重复计重叠格）：
                // 逐格先查是否已被更早的区域统计过。
                int nRanges = DataTable.RangeCount(st);
                int rsum = 0;
                int rcount = 0;
                for (int qi = 0; qi < nRanges; qi = qi + 1) {
                    int qr0 = -1; int qc0 = -1; int qr1 = -1; int qc1 = -1;
                    if (!DataTable.RangeAt(st, qi, out qr0, out qc0, out qr1, out qc1)) { continue; }
                    int rri = qr0;
                    while (rri <= qr1 && rri < DataTable.DispCount(st)) {
                        if (DataTable.DispKind(st, rri) == 0) {
                            int drow = DataTable.DispRowOf(st, rri);
                            int rci = qc0;
                            while (rci <= qc1 && rci < cols.Count) {
                                bool dup = false;
                                for (int qj = 0; qj < qi && !dup; qj = qj + 1) {
                                    int jr0 = -1; int jc0 = -1; int jr1 = -1; int jc1 = -1;
                                    if (DataTable.RangeAt(st, qj, out jr0, out jc0, out jr1, out jc1)
                                        && rri >= jr0 && rri <= jr1 && rci >= jc0 && rci <= jc1) {
                                        dup = true;
                                    }
                                }
                                if (!dup && cols[rci].numeric) {
                                    // 计算列：选区统计按公式实数值累加。
                                    double frv = 0.0;
                                    if (cols[rci].formula.Length > 0
                                        && DataTable.FormulaTryReal(cols, src, drow, rci, out frv)) {
                                        rsum = rsum + (int)frv;
                                    } else {
                                        rsum = rsum + src.CellNum(drow, rci);
                                    }
                                    rcount = rcount + 1;
                                }
                                rci = rci + 1;
                            }
                        }
                        rri = rri + 1;
                    }
                }
                if (rcount > 0) {
                    int ravg = rsum / rcount;
                    string rangeInfo = DataTable.T("Sum", "选区求和:") + " " + Convert.ToString(rsum)
                        + "    " + DataTable.T("Average", "平均:") + " " + Convert.ToString(ravg)
                        + "    " + DataTable.T("Cells", "单元格:") + " " + Convert.ToString(rcount);
                    int rw = Canvas.MeasureText(rangeInfo, sbFs);
                    c.DrawText(x + viewW - t.paddingMedium - rw, sbTy, rangeInfo, sFooter.FgOr(0), sbFs);
                }
            }
        }

        // ---------------- 垂直/水平滚动条 ----------------
        // 拖拽以持久标志跟踪（见 dragHbar/dragVbar 字段注释）：横向
        // 滚动会平移滚动条自身的即时模式 id，逐帧比较
        // `pressedId == id` 在第一格滚出后即失配，滑块就冻住。
        // 松开主键的帧统一清除标志。
        if (app.focus.pressedId < 0) {
            st.dragVbar = false;
            st.dragHbar = false;
        }
        // ---------------- 垂直滚动条 ----------------
        if (!st.paged && total > visRows && visRows > 0) {
            int sbW = app.Scale(8);
            int sbX = x + viewW - sbW - app.Scale(2);
            int trackY = bodyTop + app.Scale(2);
            int trackH = bodyH - app.Scale(4);
            int thumbH = trackH * visRows / total;
            if (thumbH < app.Scale(24)) { thumbH = app.Scale(24); }
            int maxStart = total - visRows;
            int thumbY = trackY;
            if (maxStart > 0) { thumbY = trackY + (trackH - thumbH) * start / maxStart; }

            int sbId = app.focus.AllocId();
            bool sbHover = app.focus.IsHovered(sbId);
            int thumbColor = sSbar.BgOr(0);
            if (sbHover || st.dragVbar) { thumbColor = sSbarHover.BgOr(0); }
            c.FillRoundRect(sbX, thumbY, sbW, thumbH, sbW / 2, thumbColor);
            app.hitTester.RegisterRect(sbId, sbX, trackY, sbW, trackH, 0);
            // 按下发生在滚动条上即置位拖拽标志：随后的帧即使 id
            // 平移也继续拖；主键松开的帧由顶部统一清除。
            if (st.dragVbar || app.focus.pressedId == sbId) { st.dragVbar = true; }
            if (st.dragVbar && maxStart > 0) {
                int rel = app.mouseY - trackY - thumbH / 2;
                int denom = trackH - thumbH;
                if (denom < 1) { denom = 1; }
                int ns = rel * maxStart / denom;
                if (ns < 0) { ns = 0; }
                if (ns > maxStart) { ns = maxStart; }
                if (ns != st.scrollRow) { st.scrollRow = ns; st.ScrollChanged.Raise(); app.RequestRedraw(); }
            }
        }

        // ---------------- 水平滚动条 ----------------
        if (maxScrollX > 0) {
            int hbH = app.Scale(8);
            int hbY = bodyTop + bodyH - hbH - app.Scale(2);
            // 滚动条只覆盖实际滚动的带区，使滑块
            // 能真实反映中间区域的位置。
            int htrackX = bandX + app.Scale(2);
            int htrackW = bandW - app.Scale(4);
            if (htrackW < app.Scale(24)) { htrackW = app.Scale(24); }
            int thumbW = htrackW * bandW / bandNatW;
            if (thumbW < app.Scale(24)) { thumbW = app.Scale(24); }
            int thumbX = htrackX + (htrackW - thumbW) * st.scrollX / maxScrollX;
            int hbId = app.focus.AllocId();
            bool hbHover = app.focus.IsHovered(hbId);
            int hbColor = sSbar.BgOr(0);
            if (hbHover || st.dragHbar) { hbColor = sSbarHover.BgOr(0); }
            c.FillRoundRect(thumbX, hbY, thumbW, hbH, hbH / 2, hbColor);
            app.hitTester.RegisterRect(hbId, htrackX, hbY, htrackW, hbH, 0);
            // 按下发生在滚动条上即置位拖拽标志：随后的帧即使 id
            // 平移也继续拖；主键松开的帧由顶部统一清除。
            if (st.dragHbar || app.focus.pressedId == hbId) { st.dragHbar = true; }
            if (st.dragHbar) {
                int rel = app.mouseX - htrackX - thumbW / 2;
                int denom = htrackW - thumbW;
                if (denom < 1) { denom = 1; }
                int ns = rel * maxScrollX / denom;
                if (ns < 0) { ns = 0; }
                if (ns > maxScrollX) { ns = maxScrollX; }
                if (ns != st.scrollX) { st.scrollX = ns; app.RequestRedraw(); }
            }
        }

        // ---------------- 鼠标滚轮滚动表格体 ----------------
        // 指针位于表格体上时接管滚轮，
        // 避免外层页面被滚动，然后推进虚拟行窗口。
        bool ownsBodyWheel = false;
        if (visRows > 0) {
            ownsBodyWheel = app.CaptureWheel(x, bodyTop, viewW, bodyH);
        }
        if (st.openMenu < 0 && !st.colChooserOpen && ownsBodyWheel
            && maxScrollX > 0 && ((app.window.EventMods() & 4) != 0
                                  || (app.window.EventMods() & 2) != 0)) {
            // Alt+滚轮 / Shift+滚轮：水平平移列（Alt 为 Office 惯例，
            // Shift 保留旧习惯）。
            int hDelta = app.window.EventKeyCode();
            int hStep = hDelta / 120;
            if (hStep == 0) { if (hDelta > 0) { hStep = 1; } else if (hDelta < 0) { hStep = 0 - 1; } }
            int nsx = st.scrollX - hStep * app.Scale(48);
            if (nsx < 0) { nsx = 0; }
            if (nsx > maxScrollX) { nsx = maxScrollX; }
            if (nsx != st.scrollX) { st.scrollX = nsx; app.RequestRedraw(); }
        } else if (st.openMenu < 0 && !st.colChooserOpen && ownsBodyWheel
                   && (app.window.EventMods() & 1) != 0
                   && !st.paged && DataTable.HasRange(st)) {
            // Ctrl+滚轮纵向伸展当前选区（Excel 式加选的滚轮版）：
            // 活动区域的远端边界随滚动方向逐行推进/收缩，锚点
            // 边界不动。往上滚伸到还没选的行，往下滚收回末端。
            // 已滚出视口的边界由 ScrollSlotIntoView 跟随。
            int wDelta = app.window.EventKeyCode();
            int wStep = wDelta / 120;
            if (wStep == 0) { if (wDelta > 0) { wStep = 1; } else if (wDelta < 0) { wStep = 0 - 1; } }
            // 滚轮向上（wStep>0）：远端行 -1 收缩，缩到锚点行为止；
            // 向下（wStep<0）：远端行 +1 扩张。
            // rangeR0 是拖拽/键盘的锚点，远端恒为 rangeR1，
            // 不与 Min/Max 归一——向上拖出的选区（r0>r1）不响应
            // 滚轮伸展，锚点在任何情况下都不移动。
            int anchor = st.rangeR0;
            int far = st.rangeR1;
            if (far >= anchor && anchor >= 0) {
                int nf = far - wStep;
                // 远端不许越过锚点（区域翻转与拖拽行为不符），
                // 也不越过最后一行。
                if (nf < anchor) { nf = anchor; }
                if (nf > DataTable.DispCount(st) - 1) { nf = DataTable.DispCount(st) - 1; }
                if (nf != far) {
                    st.rangeR1 = nf;
                    st.rangeC1 = st.rangeC0;
                    DataTable.SyncRangeChecks(st, src);
                    DataTable.ScrollSlotIntoView(st, nf, visRows);
                    st.SelectionChanged.Raise();
                    app.RequestRedraw();
                }
            }
        } else if (st.openMenu < 0 && !st.colChooserOpen && ownsBodyWheel) {
            if (total > visRows) {
                int delta = app.window.EventKeyCode();
                int step = delta / 120;
                if (step == 0) { if (delta > 0) { step = 1; } else if (delta < 0) { step = 0 - 1; } }
                if (st.paged) {
                    // 滚轮翻整页
                    int totalPages = (total + visRows - 1) / visRows;
                    int cp = st.pageModel.Get();
                    int np = cp - step;
                    if (np < 1) { np = 1; }
                    if (np > totalPages) { np = totalPages; }
                    if (np != cp) { st.pageModel.Set(np); app.RequestRedraw(); }
                } else {
                    int ns = st.scrollRow - step * 3;
                    int maxStart = total - visRows;
                    if (ns < 0) { ns = 0; }
                    if (ns > maxStart) { ns = maxStart; }
                    if (ns != st.scrollRow) { st.scrollRow = ns; st.ScrollChanged.Raise(); app.RequestRedraw(); }
                }
            }
        }

        // ---------------- 表头集合筛选菜单（浮层，最后绘制） ----------------
        if (st.openMenu >= 0 && st.openMenu < cols.Count) {
            DataTable.RenderMenu(app, x, y, viewW, headerH, numW, selW, cols, src, st);
        }

        // ---------------- 右键上下文菜单（浮层） ----------------
        if (st.ctxOpen) {
            DataTable.RenderContextMenu(app, x, y, viewW, viewH, cols, src, st);
        }

        // ---------------- 表头列上下文菜单（浮层） ----------------
        if (st.hdrCtxOpen) {
            DataTable.RenderHeaderMenu(app, x, y, viewW, viewH, cols, src, st);
        }

        // ---------------- 列选择器弹层（浮层） ----------------
        if (st.colChooserOpen) {
            DataTable.RenderColumnChooser(app, x, y, viewW, viewH, cols, src, st);
        }

        // ---------------- 选区生成图表浮层 ----------------
        if (st.chartOpen) {
            DataTable.RenderChart(app, x, y, viewW, viewH, st);
        }

        // ---------------- 选区数据透视浮层 ----------------
        if (st.pivotOpen) {
            DataTable.RenderPivot(app, x, y, viewW, viewH, cols, src, st);
        }

        // ---------------- 临时 toast（复制/导出反馈） ----------------
        if (st.toastFrames > 0 && st.toast.Length > 0) {
            int tfs = Style.FontFallback(app, "small");
            int tw = Canvas.MeasureText(st.toast, tfs) + app.Scale(24);
            int th = t.heightMedium;
            int tx = x + (viewW - tw) / 2;
            int tyy = y + viewH - th - app.Scale(12);
            c.FillRoundRect(tx, tyy, tw, th, t.borderRadiusMedium, sToast.BgOr(0));
            c.DrawTextCentered(tx, tyy, tw, th, st.toast, sToast.FgOr(0), tfs);
            st.toastFrames = st.toastFrames - 1;
            if (st.toastFrames > 0) { app.RequestRedraw(); }
        }
    }

}
