using Gui;
using Gui.Widget;

namespace Gui.Component.DataTable;

/// <summary>
/// DataTable 家族（DataGrid/Transfer）的 HeavyControls 注册入口。
/// ControlFactory 主 switch 的 "DataGrid" 分支要求 Gui.Component.
/// DataTable 目录整体编译进图（DataGrid + HttpSource + 模型/渲染，
/// 0.8MB+，HttpSource 还拖 ImageHttp→网络栈），不用表格的程序发布
/// 也背上这份体积。改由宿主在启动时调用一次 <see cref="Install"/>：
/// 设计器生成代码直接 new DataGrid&lt;T&gt;()/Transfer&lt;T&gt;() 的程序不受
/// 影响；运行期经 JSON/HTML 按 kind 重建（Serialize/Html 克隆、
/// FormBuilder 的 ft 23/41/84 字段）需要注册。不注册的程序里
/// DataTable 目录整体被裁掉。
/// </summary>
class DataTableBootstrap {
    static bool installed;

    static void Install() {
        if (installed) { return; }
        installed = true;
        HeavyControls.Register("DataGrid", MakeDataGrid);
        HeavyControls.Register("Transfer", MakeTransfer);
        ImageHttp.Install();   // 图片列的远端取回（EnsureUrl）
    }

    static Control MakeDataGrid(string kind) {
        if (kind == "DataGrid") { return new DataGrid<string>(); }
        return null;
    }

    /// 泛型穿梭框：无参字符串工厂只能造 string 实例供设计器/运行期
    /// 预览；类型化的 Transfer&lt;T&gt; 由代码持有实体列表来绑定。
    static Control MakeTransfer(string kind) {
        if (kind == "Transfer") { return new Transfer<string>(); }
        return null;
    }
}
