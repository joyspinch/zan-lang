using System;
using Gui;
using Gui.Widget;

namespace Gui.Component.DataTable;

/// DataTable 的列描述符。
/// cellType：0 文本，1 链接，2 标签，3 进度，4 徽章，5 图片，
/// 6 图标，7 按钮，8 迷你图，9 组件
/// align：0 左对齐，1 居中，2 右对齐
class DataColumn {
    string title;
    /// 该列的稳定名称，与位置及其
    /// （可翻译的）标题无关。用 `DataColumn.Field(c, "name")` 设置，
    /// 传给 `DataTable.Col(cols, "name")` 获取索引，
    /// 使应用代码和保存的布局在列被插入、移动或重命名后依然有效。
    /// 空表示“未命名”：此类列只能按索引访问。
    string field;
    int width;
    int cellType;
    int align;
    bool sortable;
    bool filterable;
    bool resizable;
    int tagType;
    bool numeric;
    int summary;   // 总计行聚合：0 无，1 总和，2 平均，3 最小，4 最大，5 计数，6 派生

    // ---- 派生汇总（summary==6）：由其他列的聚合值计算，
    // 因此为 O(1)，从不扫描行。
    // deriveOp：0 百分比 (A*100/B)，1 比值 (A/B)，2 差值 (A-B)，3 和 (A+B)，4 积 (A*B)
    // deriveA / deriveB：聚合值作为运算输入的源列索引
    int deriveOp;
    int deriveA;
    int deriveB;

    // ---- 条件格式 ----
    int cfMode;    // 0 无，1 数据条，2 色阶，3 高亮 >，4 高亮 <
    int cfColor;   // 数据条/低端/高亮的强调色
    int cfColor2;  // 色阶高端颜色
    int cfThreshold; // 高亮比较值

    // ---- 显示格式化（仅影响渲染字符串；排序/过滤
    // 仍看到原始单元格值） ----
    int fmt;       // 0 原始，1 格式化（前缀 + 可选分组数字 + 后缀）
    bool grouped;  // 在整数部分插入千位分隔符
    string prefix; // 前置文本，例如货币符号
    string suffix; // 尾部文本，例如“%”

    // 数值列的小数位数。0 保持原有的整数
    // 路径（通过 CellNum 排序/聚合）；> 0 将该列切换到实数
    // 路径：值解析为 double，比较和汇总不丢失
    // 小数部分，并精确渲染到这么多位小数。
    int decimals;

    // 计算列的表达式（见 DataTable.Formula.zan）。空串表示普通列。
    // 非空时该列的值不来自数据源，而是对每行求值表达式：
    // 四则运算、括号、一元负号、数字字面量和
    // min/max/abs/round/floor/ceil/sqrt 函数；操作数是裸列名
    // （按 field 名解析，回退按 title）。列自动切换到
    // decimals 位小数的实数路径（排序/聚合/条件格式一致），
    // 且不可编辑——公式列是派生只读输出。
    string formula;

    // ---- 日期列 ----
    // isDate 将该列切换到天数键路径：单元格用 ParseDate 解析，
    // 按自纪元起的天数排序和分组，并用 FormatDate 渲染。
    // dateOrder 指定*存储*文本的字段顺序
    // （0 y-m-d，1 d-m-y，2 m-d-y）；dateFmt 指定渲染格式；
    // dateGroup 在分组时对值分桶（0 日，1 年，2 月，
    // 3 季度，4 星期）。
    bool isDate;
    int dateOrder;
    int dateFmt;
    int dateGroup;

    // ---- bool 列 ----
    // isBool 将该列切换到真值键路径：单元格用 ParseBool 读取，
    // 按 false 在前 true 在后排序，并按 boolStyle 绘制
    // （0 复选框，1 对勾/叉字形，2 文本）。boolTrue/boolFalse 指定切换时
    // 写回的文本形式，样式 2 也用它显示。
    bool isBool;
    int boolStyle;
    string boolTrue;
    string boolFalse;

    // ---- 编辑 ----
    bool editable; // 单元格值可内联编辑（需显式开启）

    // ---- 图标 / 按钮 / 迷你图列（cellType 6/7/8）----
    // 图标列（6）：单元格值即 tabler 图标名（如 "check"），
    //   用 Canvas.DrawGlyph 以 datatable::icon 的前景色绘制；
    //   空值画空。不参与编辑、汇总与 tooltip。
    // 按钮列（7）：单元格值作为按钮标签（空值画图标按钮，
    //   用 btnIcon）；整格热区居中一个 small 按钮，
    //   点击把 hitRow/hitCol 指向本格后 Raise CellClick。
    //   不参与编辑与内联校验。
    // 迷你图列（8）：单元格值是以逗号分隔的数值序列
    //   （如 "12,18,9,24"），ParseReal 宽松解析，格内
    //   画 accent 色迷你柱状图；序列为空画空。
    //   不参与编辑、汇总与 tooltip。
    string btnIcon; // 按钮列的图标（值为空时的按钮内容）
    string btnClass; // 按钮列的 class（如 "primary"、"danger text"）
    bool sparkArea; // 迷你图是否在柱下画半透明面积

    // ---- 组件列（cellType 9）----
    // 单元格值是逗号分隔的数值序列（同迷你图约定），渲染层
    // 按 compId 从 CellComp 注册表取适配器，把序列灌进一个
    // 池化的真控件（BandGrid 等），控件按格矩形渲染、事件
    // 归一为 CellClick。序列化边界在引擎内部——使用层只见
    // 类型化访问器（GridNums<T>），不接触控件与绘制。
    string compId;     // CellComp 注册表键（如 "bandgrid"）
    int shapeR;        // 矩阵形状：行数（shapeC 为列数；<=0 用组件默认）
    int shapeC;
    string heatBand;   // 数值→色带名（"" 关闭；见 HeatBands）

    // 单元格打开的编辑器：0 = 纯文本框；1 = 下拉框，从
    // `choices` 中选取；2 = 日历，用于日期列；3 = 数字微调器，按
    // `editStep` 步进。bool 列忽略此项——它们在原地切换。
    int editorKind;
    List<string> choices;   // 下拉项（editorKind 1）
    bool choicesStrict;     // 下拉框：拒绝不在 `choices` 中的值
    double editStep;        // 微调器步长（editorKind 3）

    // 声明式校验，提交时在 CellValidating 事件
    // 之前检查。列可以任意组合使用。
    bool required;          // 拒绝空值
    int maxLength;          // 拒绝过长输入（0 = 不限）
    bool hasMin;            // 将 editMin 作为下界强制生效
    bool hasMax;            // 将 editMax 作为上界强制生效
    double editMin;
    double editMax;

    // ---- 固定 / 冻结 ----
    // 0 = 随其余列滚动，1 = 冻结在左边缘，2 = 冻结在
    // 右边缘。冻结列被提升出滚动带区，
    // 中间区域在其下方平移时保持屏幕位置不变。
    int freeze;

    // ---- band（多级表头） ----
    // 该列所属表头分组的斜杠分隔路径，最外层
    // 在前：“”为不分组，“Contact”一层，“Contact/Address”两层。
    // 表头每层增加一行，分组横跨相邻的
    // 共享路径的列——因此分组是列自身的属性，
    // 不可能与列失去同步。
    string band;

    DataColumn(string title, int width) {
        this.title = title;
        this.field = "";
        this.width = width;
        this.cellType = 0;
        this.align = 0;
        this.sortable = true;
        this.filterable = true;
        this.resizable = true;
        this.tagType = 1;
        this.numeric = false;
        this.summary = 0;
        this.deriveOp = 0;
        this.deriveA = 0;
        this.deriveB = -1;
        this.cfMode = 0;
        this.cfColor = 0;
        this.cfColor2 = 0;
        this.cfThreshold = 0;
        this.fmt = 0;
        this.grouped = false;
        this.prefix = "";
        this.suffix = "";
        this.decimals = 0;
        this.formula = "";
        this.isDate = false;
        this.dateOrder = 0;
        this.dateFmt = 0;
        this.dateGroup = 0;
        this.isBool = false;
        this.boolStyle = 0;
        this.boolTrue = "true";
        this.boolFalse = "false";
        this.editable = false;
        this.editorKind = 0;
        this.btnIcon = "";
        this.btnClass = "";
        this.sparkArea = false;
        this.compId = "";
        this.shapeR = 0;
        this.shapeC = 0;
        this.heatBand = "";
        this.choices = new List<string>();
        this.choicesStrict = true;
        this.editStep = 1.0;
        this.required = false;
        this.maxLength = 0;
        this.hasMin = false;
        this.hasMax = false;
        this.editMin = 0.0;
        this.editMax = 0.0;
        this.freeze = 0;
        this.band = "";
    }

    /// 为列命名，使其可通过 `DataTable.Col(cols, name)` 访问
    /// 而非字面索引。与其他构建器一样可组合：
    ///
    /// ```zan
    /// cols.Add(DataColumn.Field(DataColumn.Text("Name", 140), "name"));
    /// int ci = DataTable.Col(cols, "name");
    /// ```
    static DataColumn Field(DataColumn c, string name) {
        c.field = name; return c;
    }

    /// 让列启用内联编辑（双击/第二次单击单元格，或按
    /// F2/Enter）。数值列在提交时校验输入。
    static DataColumn Editable(DataColumn c) {
        c.editable = true; return c;
    }

    // ---- 编辑器配置器（均隐含 Editable） ----
    /// 通过下拉列表编辑该列。键入会过滤列表，
    /// 默认只接受列表中的值提交；传 `strict = false` 可允许
    /// 在建议之外输入自由文本。
    static DataColumn Dropdown(DataColumn c, List<string> items, bool strict) {
        c.editable = true;
        c.editorKind = 1;
        c.choices = items;
        c.choicesStrict = strict;
        return c;
    }

    /// 通过月历编辑该列。隐含 `AsDate`，
    /// 所选日期经过该列自身的解析/格式化配对往返。
    static DataColumn DatePicker(DataColumn c) {
        c.editable = true;
        c.editorKind = 2;
        c.isDate = true;
        return c;
    }

    /// 通过数字微调器编辑该列：上/下方向键和 +/- 按钮
    /// 按 `step` 步进，值始终保持为数字。
    static DataColumn Spinner(DataColumn c, double step) {
        c.editable = true;
        c.editorKind = 3;
        c.numeric = true;
        c.align = 2;
        if (step <= 0.0) { step = 1.0; }
        c.editStep = step;
        return c;
    }

    // ---- 声明式校验（提交时检查） ----
    /// 拒绝空值。
    static DataColumn Required(DataColumn c) {
        c.required = true; return c;
    }

    /// 拒绝超过 `n` 个字符的输入（0 清除限制）。
    static DataColumn MaxLength(DataColumn c, int n) {
        if (n < 0) { n = 0; }
        c.maxLength = n; return c;
    }

    /// 提交时将数值列限制在 [lo, hi] 内。
    static DataColumn Range(DataColumn c, double lo, double hi) {
        c.numeric = true;
        c.hasMin = true; c.hasMax = true;
        c.editMin = lo; c.editMax = hi;
        return c;
    }

    /// 提交时将数值列限制为 >= lo。
    static DataColumn MinValue(DataColumn c, double lo) {
        c.numeric = true; c.hasMin = true; c.editMin = lo; return c;
    }

    /// 提交时将数值列限制为 <= hi。
    static DataColumn MaxValue(DataColumn c, double hi) {
        c.numeric = true; c.hasMax = true; c.editMax = hi; return c;
    }

    /// 将列冻结在左边缘：它被提升到滚动列之前，
    /// 并在它们于其下方平移时保持不动。
    static DataColumn Pin(DataColumn c) {
        c.freeze = 1; return c;
    }

    /// 将列冻结在右边缘，适合放累计总和或行的
    /// 操作按钮：无论中间区域滚多远，它始终可及，
    /// 这正是把它们放在那里的原因。
    static DataColumn PinRight(DataColumn c) {
        c.freeze = 2; return c;
    }

    /// 将列放入表头分组，表头相应增加一行：
    ///
    /// ```zan
    /// cols.Add(DataColumn.Band(DataColumn.Text("Street", 160), "Address"));
    /// cols.Add(DataColumn.Band(DataColumn.Text("City", 120), "Address"));
    /// ```
    ///
    /// 路径相同的相邻列共享一个跨列单元格。
    /// 用斜杠嵌套，最外层在前——“Contact/Address”位于一个
    /// 同样横跨其他名为 Contact 的列的单元格下。传“”取消分组。
    static DataColumn Band(DataColumn c, string path) {
        c.band = path; return c;
    }

    // ---- 显示格式配置器（可组合到任意列） ----
    /// 数值列的小数位数：将排序、聚合
    /// 和条件格式切换到实数（double）路径，并精确渲染到
    /// `n` 位小数。`Decimals(c, 0)` 恢复整数路径。
    static DataColumn Decimals(DataColumn c, int n) {
        if (n < 0) { n = 0; }
        c.decimals = n; c.numeric = true; c.align = 2;
        if (n > 0) { c.fmt = 1; }
        return c;
    }

    /// 小数数值列，例如 `DataColumn.Real("Rate", 90, 2)`。
    static DataColumn Real(string title, int width, int decimals) {
        return DataColumn.Decimals(new DataColumn(title, width), decimals);
    }

    /// 计算列：`expr` 是对每行求值的公式（语法与语义见
    /// DataTable.Formula.zan）。列自动走 `decimals` 位小数的
    /// 实数路径（默认 2 位：排序/聚合/条件格式全部一致），
    /// 并保持只读——公式列是派生输出，内联编辑与粘贴
    /// 对它无效。典型用法：
    ///
    /// ```zan
    /// cols.Add(DataColumn.Formula("Total", 100, "qty * price"));
    /// cols.Add(DataColumn.Formula("Share", 90, "a * 100 / (a + b)"));
    /// ```
    static DataColumn Formula(string title, int width, string expr) {
        return DataColumn.Formula(new DataColumn(title, width), expr);
    }

    /// 在既有列上启用公式（`expr` 传 "" 清除）。传入了
    /// decimals 的列保留其位数；否则默认 2 位。列引用
    /// 闭环（公式互相引用）不在构建期检测——求值层按
    /// 单遍顺序读取各列的底层值，公式列引用公式列时
    /// 读到的是后者的源数据，而非其计算结果。
    static DataColumn Formula(DataColumn c, string expr) {
        c.formula = expr;
        if (expr.Length > 0) {
            c.numeric = true;
            c.align = 2;
            c.editable = false;
            c.isDate = false;
            c.isBool = false;
            if (c.decimals == 0) { c.decimals = 2; }
            if (c.fmt == 0) { c.fmt = 1; }
        }
        return c;
    }

    // ---- 日期配置器 ----
    /// 将列视为日期：单元格解析为天数，按时间而非
    /// 字典序排序和分组。`order` 指定存储文本的字段
    /// 顺序（0 y-m-d，1 d-m-y，2 m-d-y）；开头的 4 位
    /// 字段无论何种顺序都读作年份。
    static DataColumn AsDate(DataColumn c, int order) {
        c.isDate = true;
        c.dateOrder = order;
        c.numeric = false;
        return c;
    }

    /// ISO 风格日期列，例如 `DataColumn.Date("Ordered", 110)`。
    static DataColumn Date(string title, int width) {
        return DataColumn.AsDate(new DataColumn(title, width), 0);
    }

    /// 渲染日期格式：0 YYYY-MM-DD，1 DD/MM/YYYY，2 MM/DD/YYYY，
    /// 3 YYYY年M月D日, 4 YYYY-MM, 5 YYYY, 6 "1 Jan 2026".
    static DataColumn DateFormat(DataColumn c, int fmt) {
        c.isDate = true; c.dateFmt = fmt; return c;
    }

    /// 该列分组时对日期分桶：0 精确到日，1 年，2 月，
    /// 3 季度，4 星期。
    static DataColumn DateGroup(DataColumn c, int mode) {
        c.isDate = true; c.dateGroup = mode; return c;
    }

    // ---- bool 配置器 ----
    /// 将列视为真值：单元格用 ParseBool 读取（“1”、
    /// “true”、“yes”、“y”、“on”、“\u2713”及其否定形式，不区分大小写），
    /// 按 false 在前 true 在后排序，并按 `style` 居中绘制
    /// （0 复选框，1 对勾/叉字形，2 文本）。
    static DataColumn AsBool(DataColumn c, int style) {
        c.isBool = true;
        c.boolStyle = style;
        c.align = 1;
        c.numeric = false;
        return c;
    }

    /// 复选框列，例如 `DataColumn.Bool("Active", 70)`。
    /// 结合 `Editable` 可让单击切换单元格。
    static DataColumn Bool(string title, int width) {
        return DataColumn.AsBool(new DataColumn(title, width), 0);
    }

    /// bool 单元格切换时写回的文本，样式 2 也用它显示。
    /// 默认为“true”/“false”；可用例如 `BoolText(c, "Yes", "No")`。
    static DataColumn BoolText(DataColumn c, string yes, string no) {
        c.isBool = true; c.boolTrue = yes; c.boolFalse = no; return c;
    }

    /// 货币：千位分组数字加前置符号，右对齐。
    /// 默认 2 位小数；之后用 `Decimals` 覆盖。
    static DataColumn Money(DataColumn c, string symbol) {
        c.fmt = 1; c.grouped = true; c.prefix = symbol; c.numeric = true; c.align = 2;
        if (c.decimals == 0) { c.decimals = 2; }
        return c;
    }
    /// 百分比：追加“%”，右对齐。
    static DataColumn Percent(DataColumn c) {
        c.fmt = 1; c.suffix = "%"; c.numeric = true; c.align = 2; return c;
    }
    /// 仅千位分隔符（例如 1234567 -> 1,234,567）。
    static DataColumn Grouped(DataColumn c) {
        c.fmt = 1; c.grouped = true; c.numeric = true; c.align = 2; return c;
    }
    /// 任意前缀/后缀（可任一为空），例如“ kg”这样的单位。
    static DataColumn Affix(DataColumn c, string prefix, string suffix) {
        c.fmt = 1; c.prefix = prefix; c.suffix = suffix; return c;
    }

    // ---- 条件格式配置器（静态，可无需
    // 实例方法链式调用即可组合） ----
    static DataColumn DataBar(DataColumn c, int color) {
        c.cfMode = 1; c.cfColor = color; return c;
    }
    static DataColumn ColorScale(DataColumn c, int lowColor, int highColor) {
        c.cfMode = 2; c.cfColor = lowColor; c.cfColor2 = highColor; return c;
    }
    static DataColumn HighlightGreater(DataColumn c, int threshold, int color) {
        c.cfMode = 3; c.cfThreshold = threshold; c.cfColor = color; return c;
    }
    static DataColumn HighlightLess(DataColumn c, int threshold, int color) {
        c.cfMode = 4; c.cfThreshold = threshold; c.cfColor = color; return c;
    }

    /// 将列标记为固定宽度：用户不能拖动其右边框，
    /// 指针在（本应出现的）调整大小手柄上显示禁止光标。
    static DataColumn NotResizable(DataColumn c) {
        c.resizable = false; return c;
    }

    static DataColumn Text(string title, int width) {
        return new DataColumn(title, width);
    }

    static DataColumn Numeric(string title, int width) {
        DataColumn c = new DataColumn(title, width);
        c.numeric = true;
        c.align = 2;
        return c;
    }

    static DataColumn Link(string title, int width) {
        DataColumn c = new DataColumn(title, width);
        c.cellType = 1;
        return c;
    }

    static DataColumn TagCol(string title, int width, int tagType) {
        DataColumn c = new DataColumn(title, width);
        c.cellType = 2;
        c.tagType = tagType;
        c.align = 1;
        return c;
    }

    static DataColumn ProgressCol(string title, int width) {
        DataColumn c = new DataColumn(title, width);
        c.cellType = 3;
        c.numeric = true;
        return c;
    }

    static DataColumn BadgeCol(string title, int width) {
        DataColumn c = new DataColumn(title, width);
        c.cellType = 4;
        c.align = 1;
        return c;
    }

    /// 图片列：单元格值是文件路径、`mem:` 已注册 key 或 http(s)
    /// URL（URL 由 ImageHttp 后台取回，就绪后自动重绘；加载中与
    /// 失败画淡色占位块）。图片在格内 contain 缩放居中，不参与
    /// 条件格式、汇总与内联编辑。
    static DataColumn ImageCol(string title, int width) {
        DataColumn c = new DataColumn(title, width);
        c.cellType = 5;
        c.align = 1;
        return c;
    }

    /// 图标列：单元格值即 tabler 图标名（"check"、"trash"、"pencil"），
    /// 以 datatable::icon 的前景色居中绘制；空值画空。
    /// 不可排序/筛选——图标名不是可比较的数据。
    static DataColumn IconCol(string title, int width) {
        DataColumn c = new DataColumn(title, width);
        c.cellType = 6;
        c.align = 1;
        c.sortable = false;
        c.filterable = false;
        return c;
    }

    /// 按钮列：整格居中一个 small 按钮。单元格值是按钮标签；
    /// 标签为空时用 `icon`（tabler 图标名）画图标按钮。
    /// 点击按钮把 hitRow/hitCol 指向本格并 Raise CellClick，
    /// 处理器与普通单元格点击走同一入口读取上下文。
    /// `cls` 是按钮 class（"primary"、"danger outline"、"text"…），
    /// 空串用默认外观。不可排序/筛选/编辑。
    static DataColumn ButtonCol(string title, int width, string icon, string cls) {
        DataColumn c = new DataColumn(title, width);
        c.cellType = 7;
        c.align = 1;
        c.btnIcon = icon;
        c.btnClass = cls;
        c.sortable = false;
        c.filterable = false;
        c.editable = false;
        return c;
    }

    /// 迷你图列：单元格值是以逗号分隔的数值序列
    /// （"12,18,9,24,30"），ParseReal 宽松解析（"¥1,234" 也能读），
    /// 格内以 accent 色画等槽位迷你柱状图，柱高以序列最大值为比例。
    /// `area` 为 true 时柱下叠加半透明 accent 面积。
    /// 不可排序/筛选——序列文本不构成可比较的键。
    static DataColumn SparklineCol(string title, int width, bool area) {
        DataColumn c = new DataColumn(title, width);
        c.cellType = 8;
        c.align = 1;
        c.btnIcon = "";
        c.btnClass = "";
        c.sparkArea = area;
        c.sortable = false;
        c.filterable = false;
        return c;
    }

    /// 组件列：单元格值（逗号分隔数值序列，同迷你图约定）被
    /// 灌进 `compId` 标识的池化真控件（如 "bandgrid"），控件按
    /// 格矩形渲染。`shapeR`/`shapeC` 声明矩阵形状（<=0 用组件
    /// 默认），`heat` 是数值→色带名（"" 关闭；"teal"/"amber"/
    /// "coral"/"blue"…）。点击矩阵格子把 hitRow/hitCol 指向本格、
    /// CompPos() 提供格内 (r,c) 后 Raise CellClick。
    /// 不可排序/筛选——序列文本不构成可比较的键。
    /// 序列化边界在引擎内部：使用层经 `DataGrid<T>.CompCol` 的
    /// 类型化访问器提供 `List<int>`，从不接触控件与绘制。
    static DataColumn CompCol(string title, int width, string compId) {
        DataColumn c = new DataColumn(title, width);
        c.cellType = 9;
        c.align = 1;
        c.compId = compId;
        c.shapeR = 0;
        c.shapeC = 0;
        c.heatBand = "";
        c.sortable = false;
        c.filterable = false;
        c.editable = false;
        return c;
    }

    /// 组件列的矩阵形状（行 × 格）。仅对 cellType 9 有意义。
    static DataColumn Shape(DataColumn c, int rows, int cols) {
        c.shapeR = rows;
        c.shapeC = cols;
        return c;
    }

    /// 组件列的数值→色带映射（"teal"/"amber"/"coral"/"blue"/
    /// "green"/"purple"，空串关闭）。仅对 cellType 9 有意义。
    static DataColumn Heat(DataColumn c, string band) {
        c.heatBand = band;
        return c;
    }

    /// 命名色带的两端颜色（0xAARRGGBB）。`name` 不识别时返回
    /// false，调用方回退 accent 单色。与文档第 1 节色板一致的
    /// 内置映射，组件列着色共用。
    static bool HeatBands(string name, ref int lo, ref int hi) {
        if (name == "teal") { lo = 0xFFE1F5EE; hi = 0xFF0D6E56; return true; }
        if (name == "amber") { lo = 0xFFFAEEDA; hi = 0xFFBA7517; return true; }
        if (name == "coral") { lo = 0xFFFAECE7; hi = 0xFFD85A30; return true; }
        if (name == "blue") { lo = 0xFFE6F1FB; hi = 0xFF185FA5; return true; }
        if (name == "green") { lo = 0xFFEAF3DE; hi = 0xFF3B6D11; return true; }
        if (name == "purple") { lo = 0xFFEEEDFE; hi = 0xFF534AB7; return true; }
        return false;
    }

    /// 汇总由其他列聚合值派生的数值列
    /// （不逐行扫描）。`op` 为 0 百分比 / 1 比值 / 2 差值 / 3 和 / 4 积；
    /// `a` 和 `b` 是源列索引。
    static DataColumn Derived(string title, int width, int op, int a, int b) {
        DataColumn c = new DataColumn(title, width);
        c.numeric = true;
        c.align = 2;
        c.summary = 6;
        c.deriveOp = op;
        c.deriveA = a;
        c.deriveB = b;
        return c;
    }

    // ---- 页脚聚合配置器（为该列显示总计行） ----
    static DataColumn Sum(DataColumn c) { c.summary = 1; return c; }
    static DataColumn Avg(DataColumn c) { c.summary = 2; return c; }
    static DataColumn Min(DataColumn c) { c.summary = 3; return c; }
    static DataColumn Max(DataColumn c) { c.summary = 4; return c; }
    static DataColumn Count(DataColumn c) { c.summary = 5; return c; }
}

/// 一行字符串单元格。先用 Create() 构建，再逐列 Push()。
class DataRow {
    List<string> cells;

    DataRow() {
        this.cells = new List<string>();
    }

    void Push(string v) {
        cells.Add(v);
    }

    string At(int i) {
        if (i < 0) { return ""; }
        if (i >= cells.Count) { return ""; }
        return cells[i];
    }

    int Count() { return this.cells.Count; }

    DataRow Copy() {
        DataRow result = new DataRow();
        for (int i = 0; i < this.cells.Count; i = i + 1) {
            result.Push(this.cells[i]);
        }
        return result;
    }

    void Set(int i, string v) {
        if (i < 0) { return; }
        while (cells.Count <= i) { cells.Add(""); }
        cells[i] = v;
    }
}

/// 逐列过滤器，由三个协作阶段组成（均可选）：
///  1. 集合筛选 \u2014 剔除 `hidden` 中存在的值（Values 标签页）；
///  2. 文本筛选 \u2014 `textMode`（1 包含 / 2 等于 / 3 开头 / 4 结尾）
///     对 `textQuery` 进行匹配（Text Filters 标签页）；
///  3. 批量筛选 \u2014 匹配 `batchTerms` 中的每一项（按 `batchExact`
///     精确或子串匹配）；`batchKeep` 保留匹配项，否则排除。
class ColFilter {
    List<string> hidden;
    int textMode;
    string textQuery;
    List<string> batchTerms;
    bool batchExact;
    bool batchKeep;

    // ---- 比较筛选（第 4 阶段） ----
    // 使用列自身的排序规则将单元格与 cmpA 比较（双边模式还用 cmpB），
    // 因此数值列按值比较，日期
    // 列按天、bool 列按真值比较——从不按字典序。
    // cmpMode：0 关闭，1 >，2 >=，3 <，4 <=，5 ==，6 !=，7 介于（含端点），
    //          8 不介于，9 为空，10 不为空
    int cmpMode;
    string cmpA;
    string cmpB;

    // ---- 日期预设（第 5 阶段） ----
    // 筛选时相对“今天”解析的窗口，因此保存的
    // 布局明天依然有效。解析为包含端点的日期范围。
    // 0 关闭，1 今天，2 昨天，3 本周（从周日算起），4 最近 7 天，
    // 5 本月，6 最近 30 天，7 本季度，8 今年，9 年初至今，
    // 10 过去（今天之前），11 未来（今天之后）
    int datePreset;

    // ---- Top-N（第 6 阶段，作用于整个集合而非逐行） ----
    // 0 关闭，1 前 N，2 后 N，3 前 N%，4 后 N%，
    // 5 高于平均值，6 低于平均值
    int topMode;
    int topN;

    ColFilter() {
        this.hidden = new List<string>();
        this.textMode = 1;
        this.textQuery = "";
        this.batchTerms = new List<string>();
        this.batchExact = false;
        this.batchKeep = true;
        this.cmpMode = 0;
        this.cmpA = "";
        this.cmpB = "";
        this.datePreset = 0;
        this.topMode = 0;
        this.topN = 10;
    }

    bool IsHidden(string v) {
        return hidden.Contains(v);
    }

    void Toggle(string v) {
        int idx = hidden.IndexOf(v);
        if (idx >= 0) {
            hidden.RemoveAt(idx);
        } else {
            hidden.Add(v);
        }
    }

    bool Active() {
        if (hidden.Count > 0) { return true; }
        if (textQuery.Length > 0) { return true; }
        if (batchTerms.Count > 0) { return true; }
        if (cmpMode != 0) { return true; }
        if (datePreset != 0) { return true; }
        if (topMode != 0) { return true; }
        return false;
    }

    /// 此过滤器是否需要在决定前取得整个过滤集合
    /// （Top-N 和高于/低于平均值），而不是逐行判断。
    bool NeedsSetPass() { return topMode != 0; }

    /// 移除所有阶段，恢复列为不过滤状态。
    void Reset() {
        hidden.Clear();
        textMode = 1;
        textQuery = "";
        batchTerms.Clear();
        batchExact = false;
        batchKeep = true;
        cmpMode = 0;
        cmpA = "";
        cmpB = "";
        datePreset = 0;
        topMode = 0;
        topN = 10;
    }
}

/// 一个生效的排序键：列索引及其方向（1 升序，2 降序）。
/// 取代旧的按索引对齐的 sortCols/sortDirs 并行列表。
class SortKey {
    int col;
    int dir;

    SortKey(int c, int d) {
        col = c;
        dir = d;
    }
}

/// 选区图表浮层中的一根条：其类别标签和值。
/// 取代旧的按索引对齐的 chartLabels/chartVals 并行列表。
class ChartBar {
    string label;
    int val;

    ChartBar(string l, int v) {
        label = l;
        val = v;
    }
}

/// 多级表头中的一个跨列单元格：组自身的标签、所在的
/// 表头行（0 = 最外层），以及它覆盖的可见顺序的
/// 半开区间 [from, to)。`path` 是完整的斜杠分隔键，
/// 折叠状态即以此为键存储——仅用标签会在不同父级下的
/// 两个同名叶节点分组之间发生冲突。
class BandSpan {
    string label;
    string path;
    int level;
    int from;
    int to;

    BandSpan(string l, string p, int lv, int f, int tt) {
        label = l;
        path = p;
        level = lv;
        from = f;
        to = tt;
    }
}

/// 扁平显示模型中的一条：`kind` 0 = 数据行，1 = 分组
/// 标题，2 = 详情带（展开的数据行下方的主从详情面板）；
/// `row` = 数据行索引（kind 0 和 2）或 GroupRow 索引（kind 1）；
/// `no` = 数据行从 1 起的数据序号，其余为 0。取代旧的
/// 按索引对齐的 dispKind/dispRow/dispNo 并行列表。
///
/// 详情带占据 `DataTable.DetailSlots(st)` 个*连续*的 kind-2
/// 条目，全部指向同一个主行。让详情带保持整数个
/// 行槽位，表格体才能继续用
/// `bodyTop + slot * rowH` 寻址行——真正可变的行高会迫使
/// 所有滚动、命中测试和拖拽计算依赖累计高度表。`part`
/// 说明这是详情带的第几个槽位（0 = 第一个），渲染器可在
/// 其第一个槽位绘制一次面板并跳过其余槽位。
class DispRow {
    int kind;
    int row;
    int no;
    /// 此槽位在多槽位详情带中的序号（其他
    /// kind 时为 0）。仅当 kind == 2 时有意义。
    int part;
    /// 树模式下该数据行的嵌套深度（根 = 0，其他
    /// kind 时为 0）。渲染把它换成树列的缩进。
    int depth;

    DispRow(int k, int r, int n) {
        kind = k;
        row = r;
        no = n;
        part = 0;
        depth = 0;
    }
}

/// 树模式适配器：把任意层级结构投影成"每行有若干子行"
/// 的形状，网格据此交错显示。行身份仍是源行索引（与
/// 排序/筛选/选择的读取路径一致）；适配器只回答结构问题。
///
/// 继承它并重写 RootCount / ChildCount / ChildOf：
///   - `RootCount` 返回顶层行数，`RootAt(i)` 返回第 i 个
///     顶层行的源索引。默认实现遍历源，把无父行（`ParentOf`
///     返回 -1）当根；按需重写成直接索引。
///   - `ChildCount(src, row)` 返回该行的子行数（0 = 叶子）；
///     `ChildOf(src, row, index)` 返回第 index 个子行的源索引。
///   - 可选重写 `ParentOf`（默认 -1）：无重写时根 = 全部行
///     中 ParentOf < 0 者，需要 O(n) 扫描；重写后 RootAt 走
///     RootCount 直接索引。
class TreeAdapter {
    /// 顶层行数。
    virtual int RootCount(DataSource src) {
        int n = 0;
        if (src == null) { return 0; }
        for (int row = 0; row < src.RowCount(); row = row + 1) {
            if (this.ParentOf(src, row) < 0) { n = n + 1; }
        }
        return n;
    }

    /// 第 i 个顶层行的源索引。默认实现再次扫描源，
    /// 与 RootCount 的判定保持一致。
    virtual int RootAt(DataSource src, int i) {
        if (src == null) { return -1; }
        int seen = 0;
        for (int row = 0; row < src.RowCount(); row = row + 1) {
            if (this.ParentOf(src, row) < 0) {
                if (seen == i) { return row; }
                seen = seen + 1;
            }
        }
        return -1;
    }

    /// `row` 的子行数；0 = 叶子。
    virtual int ChildCount(DataSource src, int row) { return 0; }

    /// `row` 的第 `index` 个子行的源索引；越界返回 -1。
    virtual int ChildOf(DataSource src, int row, int index) { return -1; }

    /// `row` 的父行源索引；顶层行返回 -1。仅默认
    /// RootCount/RootAt 的"无父即根"判定使用它。
    virtual int ParentOf(DataSource src, int row) { return -1; }
}

/// 分组表格中的一行分组标题：标题文本、嵌套层级、所含
/// 数据行数、完整路径键（折叠查找）和折叠快照。
/// 取代旧的按索引对齐的 grpLabel/grpLevel/grpCount/grpKey/grpCollapsed
/// 并行列表。
///
/// `aggValues` / `aggTexts` 是该组自身成员行的逐列小计
/// （与表格列列表按索引对齐），在
/// BuildDisplay 中一次性计算，让分组标题能显示 DevExpress 风格的分组汇总
/// （例如 "Category: Electronics (42)  Revenue: \u00a51,234,567"）而无需额外
/// 每帧开销。
class GroupRow {
    string label;
    int level;
    int count;
    string key;
    bool collapsed;
    List<int> aggValues;
    List<string> aggTexts;

    GroupRow(string lb, int lv, int cnt, string k, bool coll) {
        label = lb;
        level = lv;
        count = cnt;
        key = k;
        collapsed = coll;
        aggValues = new List<int>();
        aggTexts = new List<string>();
    }
}

/// 当前渲染中一个分组面板 chip 的几何信息。
class GroupChipGeometry {
    int x;
    int width;

    GroupChipGeometry(int xx, int w) {
        x = xx;
        width = w;
    }
}

/// 当前渲染中一个可见列的几何信息。`column` 是
/// DataColumn 索引；`band` 为 0 左侧冻结、1 滚动或 2 右侧冻结。
class FrameColumn {
    int column;
    int x;
    int band;

    FrameColumn(int c, int xx, int b) {
        column = c;
        x = xx;
        band = b;
    }
}

/// 单次 DataTable 渲染的每帧布局几何。由
/// `DataTable.ComputeFrame`（渲染前奏）一次性计算，供所有绘制/
/// 命中测试/交互阶段读取，表头/筛选行/单元格/汇总/
/// 滚动条在结构上始终保持对齐。纯瞬时数据：
/// 帧间不持久化任何内容（那是 `DataTableState` 的职责）。
///
/// `columns` 是切成三个带区的可见列顺序
/// [左侧冻结 | 滚动 | 右侧冻结]。所有坐标均已
/// 按当前 `scrollX`、分组面板条和冻结带夹取解析完毕。
class DataTableFrame {
    int y;                 // 表头顶部（分组面板下方，若显示）
    int viewH;             // 控件高度减去分组面板条
    int numW;              // 行号栏宽度（隐藏时为 0）
    int selW;              // 选择栏宽度（隐藏时为 0）
    int gridColor;
    int menuIconW;
    int clipRight;         // 内容不得溢出的右边界
    int firstDataX;        // 第一个数据列的左边缘
    int dataViewW;
    int titleRowH;
    int rowH;
    int fs;                // 正文字号
    int bandRowH;          // 多级表头 band 行高
    int bandLevels;        // 标题上方的 band 行数
    int headerH;           // 表头总高度（bands + 标题）
    int titleTop;          // 列标题行的顶部
    int pinnedW;           // 左侧冻结带宽度
    int pinnedRW;          // 右侧冻结带宽度
    int bandX;             // 中间滚动带的左边缘
    int bandW;             // 中间滚动带的宽度
    int bandNatW;          // 中间带的自然（未滚动）宽度
    int maxScrollX;        // 水平滚动范围
    int rightX;            // 右侧冻结带的左边缘
    int panelY;            // 分组面板条顶部
    int groupPanelH;       // 分组面板条高度（隐藏时为 0）
    List<FrameColumn> columns; // 可见列（左侧冻结|中间|右侧冻结）
}

/// DataTable 持久状态——创建一次（在帧循环外）并
/// 每帧传入，使选择/排序/过滤/滚动在重绘之间得以保留。
class DataTableState {
    bool inited;
    int sortCol;
    int sortDir;
    // 多列排序键（外→内优先级）。sortCol/sortDir 与
    // 主键（索引 0）保持一致以向后兼容；空列表表示“未排序”。
    List<SortKey> sortKeys;
    List<bool> selected;
    // 稳定 RowKey 选择模型：普通模式维护显式业务键；全选模式
    // 维护排除键。旧 selected 数组仅作为渲染兼容投影存在。
    SelectionModel selectionModel;
    // 首次 SyncSelectionModel 把旧 bool 选择导入模型之后置 true；
    // 此后模型是权威，selected 由模型投影生成。
    bool selectionModelAuthoritative;
    List<int> colWidths;
    List<int> dispW;
    List<int> order;
    List<ColFilter> filters;
    int openMenu;
    int scrollRow;
    int scrollX;               // 数据列的水平像素偏移
    int resizeCol;
    int resizeStartX;
    int resizeStartW;
    bool dirty;

    // ---- Enterprise identity / revision foundation ----
    // `order` and the legacy index fields remain for source compatibility,
    // while new stateful features can address rows by a stable key.
    RowKeyProvider keyProvider;
    List<RowKey> rowKeys;
    int rowKeysRevision;
    List<TableDiagnostic> diagnostics;
    int dataRevision;
    int queryRevision;
    int viewRevision;
    // 上一次初始化时的列数；列模型可在首帧后动态增加，
    // 变化必须使派生显示模型失效，否则新列只能到下一次偶然重算才出现。
    int columnCount;

    int filterTab;
    string searchText;
    int valScroll;
    int editFocus;
    List<string> batchLines;
    int batchExactFlag;
    List<string> menuVals;
    List<string> menuMatched;
    string menuSearchCache;

    bool showRowNum;
    bool showSelect;
    bool striped;
    int rowH;                  // 行高（逻辑像素，0 = 跟随主题 heightMedium）
    bool rowReorder;           // 允许用行手柄拖动重排（默认关闭）

    // ---- 汇总（总计）行 ----
    bool showSummary;
    List<int> aggMode;         // 逐列：0 无，1 总和，2 平均，3 最小，4 最大，5 计数，6 派生
    List<int> aggValue;        // 每列缓存的原始聚合值（供派生列使用）
    List<double> aggReal;      // 每列的精确聚合（小数列/平均值）
    List<string> summaryText;  // 每列缓存的格式化聚合值
    // 分组页脚复用的总计累加器：BuildDisplay 将
    // 每个最外层分组的基础总和/最小/最大汇入此处，页脚无需
    // 自己的百万行扫描。表格未分组时无意义。
    List<double> aggSumR;
    List<double> aggMinR;
    List<double> aggMaxR;

    // ---- 条件格式：过滤集合上每列的 min/max，
    // 缓存后，数据条/色阶单元格无需每帧扫描即可归一化 ----
    List<int> cfMin;
    List<int> cfMax;
    // 与 cfMin/cfMax 范围相同但更精确，使小数列上的
    // 数据条和色阶归一化时不会坍缩为整数桶。
    List<double> cfMinR;
    List<double> cfMaxR;

    // ---- 分页 ----
    bool paged;
    SignalInt pageModel;       // 从 1 起的当前页码，绑定到 Pagination 控件
    int pageRows;              // 每页行数（自动适配），每帧重新计算

    // ---- 双向数据绑定（编译器降级的 Binding；可选） ----
    /// 绑定的主选择：`st.selection = vm.selectedRow;` 使
    /// 选中行双向同步。绑定值是第一个选中行的
    /// 源行索引（无选中时为 -1）；从模型侧写入
    /// 会独占选中该行。
    Binding<int> selection;
    /// 绑定的当前页：`st.page = vm.page;` 使从 1 起的页码
    /// （pageModel）双向同步。
    Binding<int> page;
    int lastSelSync;           // 上次对账的选择值（较新一侧胜出）
    int lastPageSync;          // 上次对账的页码值（较新一侧胜出）

    // ---- 选择与交互 ----
    int selAnchor;             // Shift 范围选行的顺序索引锚点（-1 无）
    int rangeR0;               // 单元格范围起始行（顺序索引，-1 = 无范围）
    int rangeC0;               // 单元格范围起始列
    int rangeR1;               // 单元格范围结束行（顺序索引）
    int rangeC1;               // 单元格范围结束列
    bool rangeDrag;            // 正在拖拽选择单元格范围
    List<int> rangeSelTouched; // 本手势勾选的显示槽位（范围缩小时退勾用）
    int tipOi;                 // 悬停提示正在跟踪的显示槽位（-1 无）
    int tipCol;                // 悬停提示正在跟踪的列索引
    int tipSinceMs;            // 指针进入该单元格的时刻（毫秒时钟）
    int dragRow;               // 正在拖拽重排的行的顺序索引位置（-1 无）
    int dragStartY;            // 行按下时的指针 Y 坐标
    bool dragMoved;            // 指针移动足够远，变为重排拖拽
    bool rowGripDrag;          // 本次行拖拽由行号右侧的专用手柄发起
    bool rowSelDrag;           // 正在行号列上拖动多选行
    bool ctxOpen;              // 右键上下文菜单已打开
    bool externalRowMenu;      // 行右键交给外部菜单处理
    int ctxX;                  // 上下文菜单锚点 X
    int ctxY;                  // 上下文菜单锚点 Y
    int ctxRow;                // 最近一次行右键命中的源行索引（-1 = 空白/非数据行）
    int ctxOrder;              // 最近一次行右键命中的顺序索引（-1 = 空白/非数据行）
    List<bool> colHidden;      // 逐列可见性（true = 隐藏）
    List<int> colFreeze;       // 逐列冻结：0 无，1 左边缘，2 右边缘
    List<int> colOrder;        // 用户列顺序（列索引的主序列）
    // 用户折叠的表头带路径。折叠的带只显示其
    // 第一列，宽分组可折叠成一个小条，而无需
    // 完全隐藏——列保留各自状态，展开后完好恢复。
    List<string> bandCollapsed;
    // 上述折叠隐藏的列，展开时只恢复这些列，
    // 用户手动隐藏的列保持不变。
    List<int> bandAutoHidden;
    int dragCol;               // 正在表头拖拽重排的列索引（-1 无）
    int dragColStartX;         // 表头按下时的指针 X 坐标
    bool dragColMoved;         // 指针移动足够远，变为重排拖拽
    int dropVis;               // 列拖拽期间的视觉插入槽位（-1 无）
    bool hdrCtxOpen;           // 表头右键上下文菜单已打开
    int hdrCtxCol;             // 表头上下文菜单针对的列
    int hdrCtxX;               // 表头上下文菜单锚点 X
    int hdrCtxY;               // 表头上下文菜单锚点 Y
    string toast;              // 临时状态消息（复制/导出反馈）
    int toastFrames;           // toast 剩余显示帧数

    // ---- 筛选行（DevExpress 风格、表头下方的内联快速筛选） ----
    // 每个可见列都有一个文本输入框。在其中输入会实时过滤表格，
    // 使用不区分大小写的 Contains 匹配（同 textMode 1）。
    bool showFilterRow;        // 绘制筛选行（默认 false）
    List<string> filterRowText;// 每列当前的筛选文本（与 cols 对齐）
    int filterRowFocusCol;     // 当前获得焦点的输入框所在列（-1 无）
    string filterRowBuf;       // 焦点单元格的编辑缓冲区
    int filterRowCur;          // filterRowBuf 中的光标字节偏移

    // ---- 状态栏（DevExpress 风格底部条） ----
    // 显示当前单元格范围或选中行的
    // 行数/选中数/范围聚合（总和、平均、计数）——隐藏时零开销。
    bool showStatusBar;        // 绘制状态栏（默认 false）

    // ---- 列选择器（Column Chooser 弹层） ----
    //DevExpress/ag-Grid 风格：勾选列表控制各列显隐，
    //搜索框按标题过滤，重排按钮按显示顺序前移/后移。
    //程序化 API 见 SetColumnChooser / IsColumnChooserOpen；
    //UI 常驻入口是分组面板右侧的 "Columns" 按钮
    //（showGroupPanel 时）。隐藏时零开销。
    bool colChooserOpen;       // 绘制列选择器弹层（默认 false）
    string colChooserSearch;   // 选择器搜索框文本
    int colChooserScroll;      // 勾选列表的滚动起始索引

    // ---- 选区生成图表浮层 ----
    bool chartOpen;            // 绘制在网格上方的条形图浮层
    string chartTitle;         // 图表标题（值列名称）
    List<ChartBar> chartBars;  // 每根条 {类别标签, 值}
    int chartMax;              // 最大的条值（>=1），用于缩放

    // ---- 行分组（ag-Grid / DevExpress 风格） ----
    List<int> groupCols;       // 分组列，外→内（空 = 扁平表格）
    List<string> collapsedKeys;// 其行被折叠隐藏的分组路径键
    List<DispRow> dispRows;     // 扁平显示模型（见 DispRow）

    // ---- 树模式（TreeGrid） ----
    // 适配器非 null 即启用：显示模型按树交错（父行后跟
    // 其可见后代），树列渲染缩进与展开箭头。展开状态
    // 按源行索引保存在 expandedTree；行经历排序/筛选时
    // 身份随源索引走，与选择/详情一致。
    TreeAdapter treeAdapter;
    List<bool> expandedTree;   // 按源行索引对齐的展开标志
    int treeCol;               // 渲染缩进/箭头的列（-1 = 无，首列前不显示）

    // ---- 组合筛选树（Filter Builder） ----
    // 程序化构建的 AND/OR 嵌套树，与逐列 ColFilter 正交：
    // Recompute 在逐列筛选与筛选行之外整体求值。
    // null = 未启用（RowPassesFilterTree 恒真）。
    FilterGroup filterTree;
    /// 显示模型为隐式时为 true：未分组且无
    /// 展开详情带的表格，每个有序行对应一个显示槽位，
    /// 槽位可从 `order` 推导，`dispRows` 保持为空。
    /// 通过 DataTable.DispCount / DispKind / DispRowOf / DispNo / DispPart 读取模型，
    /// 而非 `dispRows`，后者仅在分组和
    /// 详情布局时才会物化。
    bool dispFlat;
    List<GroupRow> groups;     // 分组标题行（见 GroupRow）

    // ---- 分组面板（DevExpress 风格、表头上方的条） ----
    // 把“按此列分组”变成拖拽操作的放置目标：
    // 将列表头拖入条中即按它分组，横向拖动 chip 重新嵌套，
    // 点击 chip 的 × 只取消该列分组。条位于
    // 表头上方，显示时把表头和表格体向下推移。
    bool showGroupPanel;       // 绘制该条（默认 false）
    int dragChip;              // 正在条内拖拽的分组列（-1 无）
    int chipDropVis;           // 拖拽期间显示的插入槽位（-1 无）
    bool hdrDragToPanel;       // 表头拖拽已被拉到条上方

    // ---- 语义事件接口（sender = 此状态；处理器通过
    // HitRow()/HitCol()/SortColIndex()/... 按无参模型拉取上下文） ----
    UiEvent FilterChanged;     // 任何筛选变化（筛选行、弹窗、批量）
    UiEvent HeaderClick;       // 可排序/可筛选的表头标题被点击
    UiEvent Sort;              // 排序列/方向变化（读取 SortColIndex/SortDirection）
    UiEvent RowClick;          // 某行被点击（读取 HitRow/HitOrderIndex）
    UiEvent RowContext;        // 行体右键（读取 CtxRow/CtxX/CtxY）
    UiEvent RowDoubleClick;    // 某行被双击
    UiEvent CellClick;         // 某数据单元格被点击（读取 HitRow/HitCol）
    UiEvent CellEdit;          // 单元格内编辑已提交（读取 EditRow/EditCol/EditValue）
    UiEvent CellValidating;    // 正在校验一次提交：读取 EditRow/EditCol/EditValue
                               // 并调用 Reject(msg) 拒绝（见 editError）
    UiEvent SelectionChanged;  // 选中行集合变化
    UiEvent ColumnResize;      // 拖拽改变列宽（读取 HitCol）
    UiEvent ColumnResizeEnd;   // 列宽拖拽结束（读取 HitCol）
    UiEvent ScrollChanged;     // 虚拟行窗口滚动（读取 ScrollTop）
    UiEvent GroupChanged;      // 分组列变化（读取 GroupCount）
    UiEvent ColumnReorder;     // 列被拖拽重排（读取 HitCol）
    UiEvent RowInserted;       // 添加了一行（读取 HitRow 获取其索引）
    UiEvent RowDeleted;        // 移除了一行（读取 HitRow 获取其索引）
    UiEvent BandToggled;       // 表头带被折叠或展开
    int hitRow;                // 最近一次行/单元格交互的数据行索引
    int hitOrder;              // 该行（排序/过滤后）的顺序位置
    int hitCol;                // 最近一次表头/单元格交互的列索引
    int editRow;               // 正在编辑的数据行索引（CellEdit）
    int editCol;               // 正在编辑的列索引（CellEdit）
    string editVal;            // 已提交的值（CellEdit）
    bool editing;              // 当前有内联编辑器打开
    string editBuf;            // 打开编辑器中的工作文本
    int editCur;               // editBuf 中的光标位置（字符数）

    // ---- 校验 ----
    // 被拒绝的提交会保持编辑器打开并在其下方显示 editError，
    // 让用户能修正值而不是悄悄丢失。
    string editError;          // 拒绝信息（“” = 值有效）
    bool editRejected;         // CellValidating 运行期间由 Reject() 设置

    // ---- 编辑器弹窗（下拉列表 / 日历） ----
    bool edPopOpen;            // 打开的编辑器正在显示其弹窗
    int edPopSel;              // 高亮的下拉项，或日历日期
    int edPopScroll;           // 第一个可见的下拉项
    List<int> edPopItems;      // 下拉框：指向列 `choices` 的索引，
                               // 即与输入文本匹配的项，按列表顺序
    int edCalMonth;            // 日历：显示的月份，即 y * 12 + (m - 1)
    bool edPopHot;             // 每帧：指针位于编辑器弹窗上，
                               // 表格体不得同时响应按压

    // ---- 外观钩子 ----
    CellStyler styler;         // 可选的行/单元格着色 + 自定义单元格绘制
                               // （null = 默认外观；见 CellStyler）

    // ---- 单元格控件插槽 ----
    // 非 null 时渲染循环对每格调用 provider.Provide 取真控件
    // （PropertyGrid 同款控件内嵌），控件按格矩形渲染；
    // 返回 null 的格走内置 cellType 渲染。见 CellWidgetProvider。
    CellWidgetProvider cellWidgets;

    // ---- 组件列（cellType 9）----
    // 最近一次组件列点击在矩阵内的位置（CellClick 处理器经
    // DataTable.CompPosR/CompPosC 读取；-1 = 无）。
    int compR;
    int compC;

    // ---- 主从详情 ----
    // 用户展开的行，以*源*行索引保存，
    // 展开状态随行经历排序和过滤，而不是钉在
    // 某个显示位置上。provider 为 null = 功能关闭，零开销。
    DetailProvider detail;
    /// 兼容的源索引列表；新 API 以 expandedKeys 为权威身份。
    List<int> expandedRows;
    List<RowKey> expandedKeys;
    bool expandedByKey;

    // ---- 行添加/删除 + 撤销 ----
    // 日志有上限（undoLimit），长时间编辑不会让它无限增长，
    // 溢出时丢弃最旧的条目。
    List<RowEdit> undoLog;     // 可逆更改，最旧在前
    int undoLimit;             // 日志条目上限（默认 100）
    bool allowAddRow;          // 在最后一行下方显示新行占位符
    bool undoing;              // 正在应用撤销：不要记录其自身的写入
    int lastAddedRow;          // 最近一次插入的数据行索引（-1 无）
    int undoGroup;             // 盖在新条目上的分组 id（0 = 未分组）
    int undoGroupSeq;          // BeginUndoGroup 发出的最后一个分组 id

    DataTableState() {
        this.inited = false;
        this.sortCol = -1;
        this.sortDir = 1;
        this.sortKeys = new List<SortKey>();
        this.selected = new List<bool>();
        this.selectionModel = SelectionModel.Row();
        this.selectionModelAuthoritative = false;
        this.colWidths = new List<int>();
        this.dispW = new List<int>();
        this.order = new List<int>();
        this.filters = new List<ColFilter>();
        this.openMenu = -1;
        this.scrollRow = 0;
        this.scrollX = 0;
        this.resizeCol = -1;
        this.resizeStartX = 0;
        this.resizeStartW = 0;
        this.dirty = true;
        this.keyProvider = null;
        this.cellWidgets = null;
        this.compR = 0 - 1;
        this.compC = 0 - 1;
        this.rowKeys = new List<RowKey>();
        this.rowKeysRevision = -1;
        this.diagnostics = new List<TableDiagnostic>();
        this.dataRevision = 0;
        this.queryRevision = 0;
        this.viewRevision = 0;
        this.columnCount = 0 - 1;
        this.filterTab = 0;
        this.searchText = "";
        this.valScroll = 0;
        this.editFocus = 0;
        this.batchLines = new List<string>();
        this.batchLines.Add("");
        this.batchExactFlag = 0;
        this.menuVals = new List<string>();
        this.menuMatched = new List<string>();
        this.menuSearchCache = "";
        this.showRowNum = true;
        this.showSelect = true;
        this.striped = true;
        this.rowH = 0;
        this.rowReorder = false;
        this.showSummary = false;
        this.aggMode = new List<int>();
        this.aggValue = new List<int>();
        this.aggReal = new List<double>();
        this.summaryText = new List<string>();
        this.aggSumR = new List<double>();
        this.aggMinR = new List<double>();
        this.aggMaxR = new List<double>();
        this.cfMin = new List<int>();
        this.cfMax = new List<int>();
        this.cfMinR = new List<double>();
        this.cfMaxR = new List<double>();
        this.paged = false;
        this.pageModel = new SignalInt(1);
        this.pageRows = 0;
        this.lastSelSync = -1;
        this.lastPageSync = 1;
        this.selAnchor = -1;
        this.rangeR0 = -1;
        this.rangeC0 = -1;
        this.rangeR1 = -1;
        this.rangeC1 = -1;
        this.rangeDrag = false;
        this.rangeSelTouched = new List<int>();
        this.tipOi = -1;
        this.tipCol = -1;
        this.tipSinceMs = 0;
        this.dragRow = -1;
        this.dragStartY = 0;
        this.dragMoved = false;
        this.rowGripDrag = false;
        this.rowSelDrag = false;
        this.ctxOpen = false;
        this.externalRowMenu = false;
        this.ctxX = 0;
        this.ctxY = 0;
        this.ctxRow = -1;
        this.ctxOrder = -1;
        this.colHidden = new List<bool>();
        this.colFreeze = new List<int>();
        this.bandCollapsed = new List<string>();
        this.bandAutoHidden = new List<int>();
        this.colOrder = new List<int>();
        this.dragCol = -1;
        this.dragColStartX = 0;
        this.dragColMoved = false;
        this.dropVis = -1;
        this.hdrCtxOpen = false;
        this.hdrCtxCol = -1;
        this.hdrCtxX = 0;
        this.hdrCtxY = 0;
        this.toast = "";
        this.toastFrames = 0;
        this.showFilterRow = false;
        this.filterRowText = new List<string>();
        this.filterRowFocusCol = -1;
        this.filterRowBuf = "";
        this.filterRowCur = 0;
        this.showStatusBar = false;
        this.colChooserOpen = false;
        this.colChooserSearch = "";
        this.colChooserScroll = 0;
        this.chartOpen = false;
        this.chartTitle = "";
        this.chartBars = new List<ChartBar>();
        this.chartMax = 1;
        this.FilterChanged = new UiEvent();
        this.HeaderClick = new UiEvent();
        this.Sort = new UiEvent();
        this.RowClick = new UiEvent();
        this.RowContext = new UiEvent();
        this.RowDoubleClick = new UiEvent();
        this.CellClick = new UiEvent();
        this.CellEdit = new UiEvent();
        this.CellValidating = new UiEvent();
        this.SelectionChanged = new UiEvent();
        this.ColumnResize = new UiEvent();
        this.ColumnResizeEnd = new UiEvent();
        this.ScrollChanged = new UiEvent();
        this.GroupChanged = new UiEvent();
        this.ColumnReorder = new UiEvent();
        this.RowInserted = new UiEvent();
        this.RowDeleted = new UiEvent();
        this.BandToggled = new UiEvent();
        this.groupCols = new List<int>();
        this.collapsedKeys = new List<string>();
        this.treeAdapter = null;
        this.expandedTree = new List<bool>();
        this.treeCol = -1;
        this.filterTree = null;
        this.showGroupPanel = false;
        this.dragChip = -1;
        this.chipDropVis = -1;
        this.hdrDragToPanel = false;
        this.dispRows = new List<DispRow>();
        this.dispFlat = true;
        this.groups = new List<GroupRow>();
        this.hitRow = -1;
        this.hitOrder = -1;
        this.hitCol = -1;
        this.editRow = -1;
        this.editCol = -1;
        this.editVal = "";
        this.editing = false;
        this.editBuf = "";
        this.editCur = 0;
        this.editError = "";
        this.editRejected = false;
        this.edPopOpen = false;
        this.edPopSel = -1;
        this.edPopScroll = 0;
        this.edPopItems = new List<int>();
        this.edCalMonth = 0;
        this.edPopHot = false;
        this.styler = null;
        this.detail = null;
        this.expandedRows = new List<int>();
        this.expandedKeys = new List<RowKey>();
        this.expandedByKey = false;
        this.undoLog = new List<RowEdit>();
        this.undoLimit = 100;
        this.allowAddRow = false;
        this.undoing = false;
        this.lastAddedRow = -1;
        this.undoGroup = 0;
        this.undoGroupSeq = 0;
    }

    // ---- 事件上下文访问器（方案 A：处理器读取 sender） ----
    int HitRow() { return hitRow; }
    int HitOrderIndex() { return hitOrder; }
    int CtxRow() { return ctxRow; }
    int CtxOrder() { return ctxOrder; }
    int CtxX() { return ctxX; }
    int CtxY() { return ctxY; }
    int HitCol() { return hitCol; }
    int SortColIndex() { return sortCol; }
    int SortDirection() { return sortDir; }
    int ScrollTop() { return scrollRow; }
    int EditRow() { return editRow; }
    int EditCol() { return editCol; }
    string EditValue() { return editVal; }

    /// 返回当前全部选中行的源行索引，顺序与数据源索引一致。
    /// 业务侧可在 RowContext 处理器中读取多选对象。
    List<int> SelectedRowIndices() {
        List<int> rows = new List<int>();
        for (int i = 0; i < selected.Count; i = i + 1) {
            if (selected[i]) { rows.Add(i); }
        }
        return rows;
    }

    /// 拒绝正在校验的值。在 `CellValidating` 处理器中调用：
    /// 编辑器保持打开并在下方显示 `msg`，不会有写入
    /// 到达数据源。
    void Reject(string msg) {
        editRejected = true;
        editError = msg;
    }

    /// 当前的拒绝信息（上次提交被接受时为“”）。
    string EditError() { return editError; }
}

/// DataTable 的虚拟数据源（DevExpress 风格的 ValueNeeded）。
///
/// 网格自身从不存储行——它按需为可见窗口拉取单元格，
/// 并通过类型化键（`CellNum`）排序/聚合，无需
/// 重新解析字符串。继承此类并用列式存储（每列
/// 一个数组）支撑，可以远少于 `List<DataRow>`
/// 字符串单元格的内存容纳数百万行，排序/汇总也无需
/// 逐单元格解析字符串。
class DataSource {
    /// 源行数。
    virtual int RowCount() { return 0; }
    /// 单元格的显示文本（row = 源索引，col = 列索引）。
    virtual string CellText(int row, int col) { return ""; }
    /// 单元格的数值键，用于数值列的排序/聚合。
    /// 非数值列返回 0。
    virtual int CellNum(int row, int col) { return 0; }

    /// 单元格的小数键，用于声明了 `decimals > 0` 的列。
    /// 默认实现解析 CellText，现有数据源免费获得小数支持；
    /// 当底层存储已持有 double 时重写它。
    virtual double CellReal(int row, int col) {
        return DataTable.ParseReal(this.CellText(row, col));
    }

    /// 日期列单元格的天数键（自 1970-01-01 起的天数）。
    /// 默认实现按列声明的字段顺序解析 CellText，
    /// 现有数据源免费获得日期支持；
    /// 当底层存储已持有天数或时间戳时重写它。`order` 是
    /// 列的 `dateOrder`；空单元格返回 `DataTable.NoDate()`。
    virtual int CellDay(int row, int col, int order) {
        return DataTable.ParseDate(this.CellText(row, col), order);
    }

    /// bool 列单元格的真值。默认实现解析 CellText，
    /// 现有数据源免费获得复选框列；
    /// 当底层存储已持有标志位时重写它。
    virtual bool CellBool(int row, int col) {
        return DataTable.ParseBool(this.CellText(row, col));
    }

    /// 稳定行键入口。旧数据源默认使用仅当前源实例
    /// 有效的临时位置键；远程/领域源应重写为业务主键。
    virtual RowKey GetRowKey(int row) {
        return RowKey.Legacy(row);
    }

    /// 将单元格值写回底层数据（内联编辑）。
    /// 只读数据源忽略写入。
    virtual void SetCell(int row, int col, string v) { }

    /// 该数据源支持 InsertRow / RemoveRow 时为 true。为 false 时
    /// 网格隐藏添加/删除功能（以及新行占位符），
    /// 只读或计算型数据源无需额外防护。
    virtual bool CanInsert() { return false; }

    /// 插入空行使其落在索引 `at`（`at == RowCount()`
    /// 即追加）。实际插入时返回 true。
    virtual bool InsertRow(int at) { return false; }

    /// 移除 `at` 处的行。实际移除时返回 true。
    virtual bool RemoveRow(int at) { return false; }

    // ---- 服务端 / 无限 / 视口协议 ----
    // 无法一次性交出全部数据集的源（远程
    // 数据库、文件流、计算结果）实现这五个钩子，
    // 而不是预加载所有行。网格无需改动即可工作：
    // 它拉取源声明存在的行，用户滚动时请求更多，
    // 并且只要服务器掌控顺序，就绝不在本地排序或过滤。
    // 参考实现见 ServerDataSource。

    /// 数据源自行管理行顺序时为 true。网格随后跳过本地
    /// 排序和过滤——传给 CellText/CellNum/... 的 `row` 索引
    /// 已是源最终（服务器排序/过滤后）的顺序，
    /// 显示顺序即服务器给出的顺序。本地分组和
    /// 聚合仍然适用，作用于已加载的前缀。
    virtual bool ServerControlled() { return false; }

    /// 单元格所在行是否已获取、可读取。
    /// 未就绪的行渲染为加载占位符而非空文本，
    /// 网格调用 RequestBlock 拉取它们。默认为 true（本地
    /// 源按定义总是完整的）。
    virtual bool CellReady(int row, int col) { return true; }

    /// 请求数据源获取包含 `row` 的数据块。可以每帧调用：
    /// 实现必须合并重复/重叠的请求。
    virtual void RequestBlock(int row) { }

    /// 请求数据源获取当前已加载前缀之后的下一块
    /// （滚动到底持续拉取，直到 HasMore() 变为 false）。
    /// 与 RequestBlock(row) 不同：调用方不知道
    /// 未获取区域从哪一行开始，所以它请求“下一块是什么”。
    virtual void RequestNextBlock() { }

    /// 数据源是否可能还有 RowCount() 之外的行。
    /// 总数未知且仍在流式传输时为 true，
    /// 用户滚动到底部时网格会请求下一块。
    virtual bool HasMore() { return false; }

    /// 每帧轮询。每次重绘前、重算前调用一次；
    /// 有新数据到达（取回的数据块、服务器事务）时返回 true，
    /// 网格标记自身为脏并重绘。无数据到达时
    /// 开销极小且无副作用。
    virtual bool Poll() { return false; }

    /// 按稳定 RowKey 实时合并一批增量（upsert/remove/cell）。
    /// 默认不支持：返回 null。支持按键定位的源（本地列表源、
    /// 服务端缓存源）重写它；应用完成后源自行刷新页与缓存，
    /// 网格经由 Poll 感知变化。见 DataTable.Realtime.zan。
    virtual DeltaResult ApplyDeltas(DeltaBatch batch) { return null; }
}

/// 向后兼容适配器：通过 DataSource 接口提供内存中的
/// 字符串单元格 `List<DataRow>`，
/// 现有 `DataTable.Render(..., rows, ...)` 调用无需改动即可继续工作。
class RowListSource : DataSource {
    List<DataRow> rows;

    RowListSource(List<DataRow> rows) {
        this.rows = rows;
    }

    override int RowCount() { return this.rows.Count; }
    override string CellText(int row, int col) { return this.rows[row].At(col); }
    override int CellNum(int row, int col) { return DataTable.ParseInt(this.rows[row].At(col)); }
    override void SetCell(int row, int col, string v) { this.rows[row].Set(col, v); }

    /// 内存列表总能增长或收缩。
    override bool CanInsert() { return true; }

    override bool InsertRow(int at) {
        if (at < 0 || at > this.rows.Count) { return false; }
        this.rows.Insert(at, new DataRow());
        return true;
    }

    override bool RemoveRow(int at) {
        if (at < 0 || at >= this.rows.Count) { return false; }
        this.rows.RemoveAt(at);
        return true;
    }
}

/// 一条可逆更改，记录后 Ctrl+Z 可将其还原。
///
/// `kind` 为 0 单元格编辑、1 行插入、2 行删除。删除把整行
/// 文本保存在 `cells` 中，因为源在 RemoveRow 返回的
/// 那一刻就可以丢弃存储——
/// 让行可恢复的是日志，而非源。
class RowEdit {
    int kind;
    int row;          // 更改所作用的数据行索引
    int col;          // 单元格编辑：列；否则为 -1
    string before;    // 单元格编辑：原有的值
    string after;     // 单元格编辑：写入的值
    List<string> cells;  // 行删除：被删除的行，逐单元格

    /// 同组条目一起撤销。一次粘贴涉及五十个
    /// 单元格，必须一次 Ctrl+Z 全部回退，而不是五十次——
    /// 因此撤销的单位是组而非条目。0 表示“单独成组”。
    int group;

    static RowEdit Cell(int row, int col, string before, string after) {
        RowEdit e = new RowEdit();
        e.kind = 0;
        e.row = row;
        e.col = col;
        e.before = before;
        e.after = after;
        e.cells = new List<string>();
        e.group = 0;
        return e;
    }

    static RowEdit Insert(int row) {
        RowEdit e = new RowEdit();
        e.kind = 1;
        e.row = row;
        e.col = -1;
        e.before = "";
        e.after = "";
        e.cells = new List<string>();
        e.group = 0;
        return e;
    }

    static RowEdit Delete(int row, List<string> cells) {
        RowEdit e = new RowEdit();
        e.kind = 2;
        e.row = row;
        e.col = -1;
        e.before = "";
        e.after = "";
        e.cells = cells;
        e.group = 0;
        return e;
    }
}

/// DataTable 的外观 + 自定义绘制钩子（DevExpress 风格
/// RowStyle / CustomDrawCell）。
///
/// Zan 的委托不能捕获局部变量或绑定 `this`，因此逐单元格回调
/// 不能是视图模型上的 lambda——而是*子类*，
/// 就像 <see cref="DataSource"/> 一样。赋一个实例给 <c>st.styler</c>；
/// 每个方法都可选，默认保持网格的默认外观。
///
/// 颜色为打包的 ARGB。**0 表示“不覆盖”**——它是完全
/// 透明的黑色，永远不会与任何人想绘制的颜色冲突。
///
/// ```zan
/// class OverdueStyle : CellStyler {
///     override int RowBg(DataSource src, int row) {
///         if (src.CellText(row, 4) == "Overdue") { return DataTable.Rgb(255, 236, 236); }
///         return 0;
///     }
/// }
/// st.styler = new OverdueStyle();
/// ```
class CellStyler {
    /// 整行数据行的背景，0 则保留网格的斑马纹。
    /// 选中和悬停依然可见：它们与此颜色混合
    /// 而非替换它，行在激活时仍可辨认。
    virtual int RowBg(DataSource src, int row) { return 0; }

    /// 整行数据行的文本颜色，0 用主题默认色。
    virtual int RowFg(DataSource src, int row) { return 0; }

    /// 单个单元格的背景，0 则继承行背景。
    virtual int CellBg(DataSource src, int row, int col) { return 0; }

    /// 单个单元格的文本颜色，0 则继承 <see cref="RowFg"/>。
    virtual int CellFg(DataSource src, int row, int col) { return 0; }

    /// 自行绘制单元格。绘制了则返回 true——内置
    /// 渲染器将完全跳过该单元格（条件格式、
    /// 标签、进度条等全部跳过）。画布裁剪到 [x,y,w,h]，
    /// 自定义绘制器不会溢出到相邻单元格。
    virtual bool PaintCell(App app, DataSource src, int row, int col,
                           int x, int y, int w, int h) { return false; }
}

/// 主从详情钩子：提供展开行下方绘制的面板。
///
/// 继承它，重写 `Paint`（可选 `Slots` / `CanExpand`），
/// 并用 `DataTable.SetDetail(st, provider)` 交给网格。行随即在行号栏
/// 长出展开箭头；点击后在行下方打开一个
/// 供详情面板绘制的带区——子表格、表单、图表。
///
/// 详情带高度为整数个普通行槽位（`Slots`），
/// 这使表格体的滚动和命中测试运算保持一致；见 `DispRow`。
class DetailProvider {
    /// `row` 的详情带高度，以普通行高为单位。
    /// 网格会将其夹取到至少 1。可按行重写（例如根据
    /// 子记录数量）。
    virtual int Slots(DataSource src, int row) { return 3; }

    /// `row` 是否可以展开。无可展示内容的行返回 false，
    /// 它便显示空白边距而不是无用的箭头。
    virtual bool CanExpand(DataSource src, int row) { return true; }

    /// 将 `row` 的详情面板绘制到 [x,y,w,h]。画布裁剪到
    /// 该矩形内，面板不会溢出到相邻行。
    virtual void Paint(App app, DataSource src, int row,
                       int x, int y, int w, int h) { }
}

/// 单元格控件插槽：为网格列提供*真控件*而非自绘
/// （DevExpress 的 CustomRowCellEdit + RepositoryItem 语义）。
///
/// 继承并重写 <see cref="Provide"/>，赋给 <c>st.cellWidgets</c>。
/// 渲染循环每格调用 Provide 取控件，把控件按格矩形
/// 停靠、渲染——控件拥有完整交互（点击、编辑、悬停），
/// 事件经控件自身的处理器派发，与独立放置无异。
///
/// 控件实例必须由 provider *池化复用*：每帧每格调用
/// Provide，且 row 无固定身份（虚拟滚动下同一显示槽位
/// 会滚过任意多行），因此 provider 以 RowKey（稳定行
/// 身份，`src.GetRowKey(row)`）为键缓存控件实例，
/// 同一行在帧间拿回同一个控件——文本输入不丢焦点、
/// 复选框不闪、滚动往返不重置。列数与列身份每帧
/// 一致（由渲染循环保证）；返回 null 表示该格
/// 退回内置渲染。
///
/// ```zan
/// class OpCellHost : CellWidgetProvider {
///     List<Control> pool = new List<Control>();
///     override Control Provide(App app, DataSource src, int row, int col, int x, int y, int w, int h) {
///         RowKey k = src.GetRowKey(row);
///         Control ctl = this.Find(k, col);
///         if (ctl == null) {
///             Button b = new Button("Edit");
///             b.Class = "small text";
///             b.Click.Add(() => { ... });
///             ctl = b;
///             this.Remember(k, col, ctl);
///         }
///         return ctl;
///     }
/// }
/// st.cellWidgets = new OpCellHost();
/// ```
class CellWidgetProvider {
    /// 为 (row, col) 提供控件。可返回 null——该格退回
    /// 内置渲染路径（cellType 分派）。控件随后被渲染循环
    /// 摆放到 [x,y,w,h] 内（列头之下的格矩形），池化由
    /// 实现负责（见类注释）。
    virtual Control Provide(App app, DataSource src, int row, int col,
                            int x, int y, int w, int h) { return null; }

    /// （可选）框架在销毁/重建网格状态时通知 provider
    /// 清空池，控件随之可被 GC。
    virtual void Reset() { }
}
