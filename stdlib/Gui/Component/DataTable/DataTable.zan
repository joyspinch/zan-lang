using System;
using Gui;
using Gui.Widget;
using Gui.Backend;

namespace Gui.Component.DataTable;

/// Enterprise-style data grid: fixed row-number & selection columns, sortable
/// headers, Excel-style set-filter header menus, resizable columns, custom cell
/// renderers (text/link/tag/progress/badge) and virtualised rows (only the
/// visible window is drawn, so tens of thousands of rows stay smooth).
///
/// Data is supplied through a `DataSource` (see `Render` for the List<DataRow>
/// convenience overload, or `RenderSource` to pass a custom virtual source).
partial class DataTable {
    // ---------- selection / clipboard / export helpers ----------

    static int MinI(int a, int b) { if (a < b) { return a; } return b; }
    static int MaxI(int a, int b) { if (a > b) { return a; } return b; }

    static bool HasRange(DataTableState st) {
        return st.rangeR0 >= 0 && st.rangeC0 >= 0;
    }

    // Escape one CSV field (quote when it holds a comma, quote or newline).
    static string CsvField(string v) {
        bool needsQuote = false;
        int i = 0;
        while (i < v.Length) {
            char ch = v[i];
            int cc = (int)ch;
            if (cc == 44 || cc == 34 || cc == 10 || cc == 13) { needsQuote = true; i = v.Length; }
            else { i = i + 1; }
        }
        if (!needsQuote) { return v; }
        // Double any embedded quotes, copying runs with Substring so non-ASCII
        // characters survive intact (no char-by-char reconstruction).
        string body = "";
        int start = 0;
        int k = 0;
        while (k < v.Length) {
            if ((int)v[k] == 34) {
                body = body + v.Substring(start, k - start + 1) + "\"";
                start = k + 1;
            }
            k = k + 1;
        }
        body = body + v.Substring(start, v.Length - start);
        return "\"" + body + "\"";
    }

    // Build a tab-separated (clipboard) or comma-separated (CSV) block for the
    // active cell range if any, otherwise for the checkbox-selected rows, else
    // the whole (filtered/sorted) view. `csv` picks the delimiter + escaping;
    // `withHeader` prepends the column titles.
    static string BuildText(DataTableState st, List<DataColumn> cols, DataSource src, bool csv, bool withHeader) {
        string sep = "\t";
        if (csv) { sep = ","; }
        string nl = "\r\n";
        string outp = "";

        int c0 = 0;
        int c1 = cols.Count - 1;
        bool rangeMode = DataTable.HasRange(st);
        if (rangeMode) {
            c0 = DataTable.MinI(st.rangeC0, st.rangeC1);
            c1 = DataTable.MaxI(st.rangeC0, st.rangeC1);
        }

        if (withHeader) {
            string line = "";
            int cc = c0;
            while (cc <= c1) {
                string h = cols[cc].title;
                if (csv) { h = DataTable.CsvField(h); }
                if (cc > c0) { line = line + sep; }
                line = line + h;
                cc = cc + 1;
            }
            outp = line + nl;
        }

        if (rangeMode) {
            int r0 = DataTable.MinI(st.rangeR0, st.rangeR1);
            int r1 = DataTable.MaxI(st.rangeR0, st.rangeR1);
            int rr = r0;
            while (rr <= r1) {
                if (rr >= 0 && rr < st.order.Count) {
                    int srcRow = st.order[rr];
                    string line = "";
                    int cc = c0;
                    while (cc <= c1) {
                        string v = src.CellText(srcRow, cc);
                        if (csv) { v = DataTable.CsvField(v); }
                        if (cc > c0) { line = line + sep; }
                        line = line + v;
                        cc = cc + 1;
                    }
                    outp = outp + line + nl;
                }
                rr = rr + 1;
            }
            return outp;
        }

        // else: selected rows, or the whole view when nothing is checked
        bool anySel = false;
        int s = 0;
        while (s < st.order.Count) { if (st.selected[st.order[s]]) { anySel = true; s = st.order.Count; } else { s = s + 1; } }
        int oi = 0;
        while (oi < st.order.Count) {
            int ri = st.order[oi];
            if (!anySel || st.selected[ri]) {
                string line = "";
                int cc = c0;
                while (cc <= c1) {
                    string v = src.CellText(ri, cc);
                    if (csv) { v = DataTable.CsvField(v); }
                    if (cc > c0) { line = line + sep; }
                    line = line + v;
                    cc = cc + 1;
                }
                outp = outp + line + nl;
            }
            oi = oi + 1;
        }
        return outp;
    }

    static void SelectAllRows(DataTableState st, bool val) {
        int k = 0;
        while (k < st.order.Count) { st.selected[st.order[k]] = val; k = k + 1; }
    }

    /// Source-row index of the first selected row, or -1 when nothing is
    /// selected. This is the scalar exposed through the `selection` binding.
    static int PrimarySelected(DataTableState st) {
        int i = 0;
        while (i < st.selected.Count) {
            if (st.selected[i]) { return i; }
            i = i + 1;
        }
        return -1;
    }

    /// Exclusively select a single source row (clearing any other selection).
    /// row < 0 or out of range clears the selection. Used by the `selection`
    /// binding when the model side changes.
    static void SetPrimarySelected(DataTableState st, int row) {
        int i = 0;
        while (i < st.selected.Count) { st.selected[i] = false; i = i + 1; }
        if (row >= 0 && row < st.selected.Count) { st.selected[row] = true; }
    }

    /// Reconcile the optional `selection` / `page` bindings with the live state
    /// once per frame. Like Select, the side that changed since the last sync
    /// wins, so edits flow both model -> table and table -> model. Called at
    /// the top of RenderSource after the selection list is sized.
    static void SyncBindings(DataTableState st) {
        if (st.selection != null) {
            int cur = DataTable.PrimarySelected(st);
            int b = st.selection.Get();
            if (cur == b) { st.lastSelSync = cur; }
            else if (cur != st.lastSelSync) { st.selection.Set(cur); st.lastSelSync = cur; }
            else { DataTable.SetPrimarySelected(st, b); st.lastSelSync = b; }
        }
        if (st.page != null) {
            int m = st.pageModel.Get();
            int b = st.page.Get();
            if (m == b) { st.lastPageSync = m; }
            else if (m != st.lastPageSync) { st.page.Set(m); st.lastPageSync = m; }
            else { st.pageModel.Set(b); st.lastPageSync = b; }
        }
    }

    // Integer part of a loosely-formatted numeric cell (ignores separators and a
    // fractional tail): "1,234.56" -> 1234, "-98%" -> -98, "" -> 0.
    static int ParseIntLoose(string s) {
        int i = 0;
        bool neg = false;
        if (i < s.Length && (int)s[i] == 45) { neg = true; i = i + 1; }
        int v = 0;
        bool any = false;
        while (i < s.Length) {
            int cc = (int)s[i];
            if (cc == 46) { i = s.Length; }            // stop at the decimal point
            else if (cc >= 48 && cc <= 57) { v = v * 10 + (cc - 48); any = true; i = i + 1; }
            else { i = i + 1; }                        // skip separators / units
        }
        if (!any) { return 0; }
        if (neg) { return 0 - v; }
        return v;
    }

    // Build a bar chart from the active cell range: bars = range rows, values =
    // the rightmost numeric column in the range, labels = the range's first
    // column (or the row ordinal when that IS the value column). Returns false
    // when there is no range or the range holds no numeric column.
    static bool BuildChartFromRange(DataTableState st, List<DataColumn> cols, DataSource src) {
        if (!DataTable.HasRange(st)) { return false; }
        int c0 = DataTable.MinI(st.rangeC0, st.rangeC1);
        int c1 = DataTable.MaxI(st.rangeC0, st.rangeC1);
        int r0 = DataTable.MinI(st.rangeR0, st.rangeR1);
        int r1 = DataTable.MaxI(st.rangeR0, st.rangeR1);

        int valCol = -1;
        int cc = c1;
        while (cc >= c0) {
            if (cc >= 0 && cc < cols.Count && cols[cc].numeric) { valCol = cc; cc = c0 - 1; }
            else { cc = cc - 1; }
        }
        if (valCol < 0) { return false; }
        int labCol = c0;
        if (labCol == valCol) { labCol = -1; }

        st.chartBars = new List<ChartBar>();
        st.chartMax = 1;
        st.chartTitle = cols[valCol].title;

        int rr = r0;
        int n = 0;
        while (rr <= r1) {
            if (rr >= 0 && rr < st.order.Count) {
                int ri = st.order[rr];
                int v = DataTable.ParseIntLoose(src.CellText(ri, valCol));
                string lab = Convert.ToString(n + 1);
                if (labCol >= 0) { lab = src.CellText(ri, labCol); }
                st.chartBars.Add(new ChartBar(lab, v));
                int av = v;
                if (av < 0) { av = 0 - av; }
                if (av > st.chartMax) { st.chartMax = av; }
                n = n + 1;
            }
            rr = rr + 1;
        }
        return n > 0;
    }

    static void ClearRange(DataTableState st) {
        st.rangeR0 = -1;
        st.rangeC0 = -1;
        st.rangeR1 = -1;
        st.rangeC1 = -1;
    }

    // Move the row occupying order-position `from` so it lands at order-position
    // `to`, shifting the rest — the manual drag-reorder of the visible order.
    static void MoveOrder(DataTableState st, int from, int to) {
        if (from < 0 || from >= st.order.Count) { return; }
        if (to < 0) { to = 0; }
        if (to >= st.order.Count) { to = st.order.Count - 1; }
        if (from == to) { return; }
        int v = st.order[from];
        st.order.RemoveAt(from);
        st.order.Insert(to, v);
    }

    // ---------- keyboard navigation ----------

    /// The display slot at or after `from` that holds a data row, walking by
    /// `step`. Group headers are skipped, so the arrow keys move between cells
    /// rather than stalling on a caption. Returns -1 when the walk runs out.
    static int NextDataSlot(DataTableState st, int from, int step) {
        int i = from;
        while (i >= 0 && i < st.dispRows.Count) {
            if (st.dispRows[i].kind == 0) { return i; }
            i = i + step;
        }
        return -1;
    }

    static int FirstDataSlot(DataTableState st) {
        return DataTable.NextDataSlot(st, 0, 1);
    }

    static int LastDataSlot(DataTableState st) {
        return DataTable.NextDataSlot(st, st.dispRows.Count - 1, -1);
    }

    /// Position in `vorder` of the visible column `col`, or -1 when the column
    /// is hidden. Navigation moves through the visible order, so a hidden or
    /// reordered column never traps the cursor.
    static int VisPos(List<int> vorder, int col) {
        return vorder.IndexOf(col);
    }

    static int VisPos(List<FrameColumn> columns, int col) {
        int i = 0;
        while (i < columns.Count) {
            if (columns[i].column == col) { return i; }
            i = i + 1;
        }
        return -1;
    }

    static bool IsNavKey(int kc) {
        return kc == 37 || kc == 38 || kc == 39 || kc == 40
            || kc == 33 || kc == 34 || kc == 35 || kc == 36 || kc == 9;
    }

    /// Where a navigation key should put the cursor: a two-element list holding
    /// the target display slot (0) and column index (1), or -1/-1 when the grid
    /// has nowhere to go. Pure decision logic, kept out of the render path so it
    /// can be exercised headlessly.
    ///
    /// Rows move in display slots so group headers are stepped over; columns
    /// move in visible-order positions so hidden and reordered columns behave.
    static List<int> NavTarget(DataTableState st, List<int> vorder, int visRows,
                               int kc, int emods) {
        List<FrameColumn> columns = new List<FrameColumn>();
        int i = 0;
        while (i < vorder.Count) {
            columns.Add(new FrameColumn(vorder[i], 0, 1));
            i = i + 1;
        }
        return DataTable.NavTarget(st, columns, visRows, kc, emods);
    }

    static List<int> NavTarget(DataTableState st, List<FrameColumn> columns, int visRows,
                               int kc, int emods) {
        List<int> outp = new List<int>();
        outp.Add(-1);
        outp.Add(-1);
        if (columns.Count == 0 || !DataTable.IsNavKey(kc)) { return outp; }
        bool shift = Modifiers.HasShift(emods);
        bool ctrl = Modifiers.HasCtrl(emods);

        // A first press with no cursor yet lands on the top-left cell rather
        // than doing nothing.
        if (st.hitOrder < 0 || st.hitCol < 0) {
            int firstSlot = DataTable.FirstDataSlot(st);
            if (firstSlot < 0) { return outp; }
            outp[0] = firstSlot;
            outp[1] = columns[0].column;
            return outp;
        }

        int vp = DataTable.VisPos(columns, st.hitCol);
        if (vp < 0) { vp = 0; }
        int slot = st.hitOrder;
        int newSlot = slot;
        int newVp = vp;

        if (kc == 38) {                                   // Up
            newSlot = DataTable.NextDataSlot(st, slot - 1, -1);
            if (ctrl) { newSlot = DataTable.FirstDataSlot(st); }
        } else if (kc == 40) {                            // Down
            newSlot = DataTable.NextDataSlot(st, slot + 1, 1);
            if (ctrl) { newSlot = DataTable.LastDataSlot(st); }
        } else if (kc == 37) {                            // Left
            newVp = vp - 1;
            if (ctrl) { newVp = 0; }
        } else if (kc == 39) {                            // Right
            newVp = vp + 1;
            if (ctrl) { newVp = columns.Count - 1; }
        } else if (kc == 33) {                            // PageUp
            newSlot = DataTable.NextDataSlot(st, slot - visRows, -1);
            if (newSlot < 0) { newSlot = DataTable.FirstDataSlot(st); }
        } else if (kc == 34) {                            // PageDown
            newSlot = DataTable.NextDataSlot(st, slot + visRows, 1);
            if (newSlot < 0) { newSlot = DataTable.LastDataSlot(st); }
        } else if (kc == 36) {                            // Home: row start,
            newVp = 0;                                    // Ctrl+Home: grid start
            if (ctrl) { newSlot = DataTable.FirstDataSlot(st); }
        } else if (kc == 35) {                            // End: row end,
            newVp = columns.Count - 1;                     // Ctrl+End: grid end
            if (ctrl) { newSlot = DataTable.LastDataSlot(st); }
        } else if (kc == 9) {
            // Tab walks cell by cell, wrapping to the next row at the edge —
            // the way a spreadsheet moves through a form.
            if (shift) {
                newVp = vp - 1;
                if (newVp < 0) {
                    int prev = DataTable.NextDataSlot(st, slot - 1, -1);
                    if (prev >= 0) { newSlot = prev; newVp = columns.Count - 1; }
                    else { newVp = 0; }
                }
            } else {
                newVp = vp + 1;
                if (newVp >= columns.Count) {
                    int next = DataTable.NextDataSlot(st, slot + 1, 1);
                    if (next >= 0) { newSlot = next; newVp = 0; }
                    else { newVp = columns.Count - 1; }
                }
            }
        }

        // Running off an edge holds position rather than wrapping or clearing.
        if (newSlot < 0) { newSlot = slot; }
        if (newVp < 0) { newVp = 0; }
        if (newVp >= columns.Count) { newVp = columns.Count - 1; }
        if (newSlot == slot && newVp == vp) { return outp; }
        outp[0] = newSlot;
        outp[1] = columns[newVp].column;
        return outp;
    }

    /// Move the cell cursor to display slot `oi`, column `col`. `extend` grows
    /// the current range from the anchor instead of collapsing to one cell.
    /// Returns false when the target isn't a navigable cell.
    static bool MoveCursor(DataTableState st, int oi, int col, bool extend) {
        if (oi < 0 || oi >= st.dispRows.Count) { return false; }
        if (st.dispRows[oi].kind != 0) { return false; }
        if (col < 0) { return false; }
        st.hitOrder = oi;
        st.hitRow = st.dispRows[oi].row;
        st.hitCol = col;
        if (extend) {
            // The anchor is whatever the range started from; only the far
            // corner follows the cursor.
            if (st.rangeR0 < 0 || st.rangeC0 < 0) {
                st.rangeR0 = oi;
                st.rangeC0 = col;
            }
            st.rangeR1 = oi;
            st.rangeC1 = col;
        } else {
            st.rangeR0 = oi;
            st.rangeR1 = oi;
            st.rangeC0 = col;
            st.rangeC1 = col;
            st.selAnchor = oi;
        }
        return true;
    }

    /// Scroll the minimum amount that brings display slot `oi` into view.
    /// In paged mode the page containing it is selected instead.
    static void ScrollSlotIntoView(DataTableState st, int oi, int visRows) {
        if (oi < 0 || visRows < 1) { return; }
        if (st.paged) {
            if (st.pageRows > 0) { st.pageModel.Set(oi / st.pageRows + 1); }
            return;
        }
        if (oi < st.scrollRow) {
            st.scrollRow = oi;
            st.ScrollChanged.Raise();
        } else if (oi >= st.scrollRow + visRows) {
            st.scrollRow = oi - visRows + 1;
            st.ScrollChanged.Raise();
        }
    }

    /// Pan horizontally so column `col` is fully visible.
    ///
    /// A frozen column — either edge — is on screen by definition, so this is a
    /// no-op for one. For a scrolling column the visible band is narrowed by
    /// both frozen bands: scrolling it merely past `pinnedW` would still leave
    /// it hidden underneath the right-hand band.
    static void ScrollColIntoView(DataTableState st, List<int> vorder, int col,
                                  int dataViewW, int pinnedW) {
        int nL = DataTable.LeftFrozenCount(st, vorder);
        int nR = DataTable.RightFrozenCount(st, vorder);
        List<FrameColumn> columns = new List<FrameColumn>();
        int i = 0;
        while (i < vorder.Count) {
            int band = 1;
            if (i < nL) { band = 0; }
            else if (i >= vorder.Count - nR) { band = 2; }
            columns.Add(new FrameColumn(vorder[i], 0, band));
            i = i + 1;
        }
        DataTable.ScrollColIntoView(st, columns, col, dataViewW, pinnedW);
    }

    static void ScrollColIntoView(DataTableState st, List<FrameColumn> columns, int col,
                                  int dataViewW, int pinnedW) {
        int pos = DataTable.VisPos(columns, col);
        if (pos < 0) { return; }
        if (columns[pos].band != 1) { return; }

        // Offset of the column within the scrolling band alone, and the band's
        // own width — the frozen columns are not part of either.
        int off = 0;
        int i = 0;
        while (i < pos) {
            if (columns[i].band == 1) { off = off + st.dispW[columns[i].column]; }
            i = i + 1;
        }
        int w = st.dispW[col];
        int rightW = 0;
        i = 0;
        while (i < columns.Count) {
            if (columns[i].band == 2) { rightW = rightW + st.dispW[columns[i].column]; }
            i = i + 1;
        }
        int bandW = dataViewW - pinnedW - rightW;
        if (bandW < 1) { bandW = 1; }

        if (off < st.scrollX) {
            st.scrollX = off;
        } else if (off + w > st.scrollX + bandW) {
            st.scrollX = off + w - bandW;
        }
        if (st.scrollX < 0) { st.scrollX = 0; }
    }

    // ---------- clipboard ----------

    /// Tab-separated text for the current cell range (or selection). This is
    /// what Ctrl+C puts on the clipboard.
    static string CopyText(DataTableState st, List<DataColumn> cols, DataSource src) {
        return DataTable.BuildText(st, cols, src, false, false);
    }

    /// Paste tab-separated text into the grid starting at the cursor, filling
    /// down and right. Only editable, non-bool columns take a value; a bool
    /// column reads the pasted text through ParseBool so "Yes"/"1" both land.
    /// Returns the number of cells actually written.
    static int PasteText(DataTableState st, List<DataColumn> cols, DataSource src, string text) {
        if (text.Length == 0) { return 0; }
        int r0 = st.hitOrder;
        int c0 = st.hitCol;
        if (DataTable.HasRange(st)) {
            r0 = DataTable.MinI(st.rangeR0, st.rangeR1);
            c0 = DataTable.MinI(st.rangeC0, st.rangeC1);
        }
        if (r0 < 0 || c0 < 0) { return 0; }

        // The anchor may be a group header (e.g. the cursor sits on a caption);
        // start writing at the first data row from there.
        r0 = DataTable.NextDataSlot(st, r0, 1);
        if (r0 < 0) { return 0; }

        // One paste is one undo, however many cells it lands on.
        DataTable.BeginUndoGroup(st);
        List<string> lines = DataTable.SplitLines(text);
        int written = 0;
        int li = 0;
        int slot = r0;
        while (li < lines.Count) {
            // Trailing newline yields one empty line; pasting it would blank a
            // row the user never pointed at.
            if (lines[li].Length == 0 && li == lines.Count - 1) { li = li + 1; }
            else {
                slot = DataTable.NextDataSlot(st, slot, 1);
                if (slot < 0) { li = lines.Count; }
                else {
                    int row = st.dispRows[slot].row;
                    List<string> fields = DataTable.SplitTabs(lines[li]);
                    int fi = 0;
                    while (fi < fields.Count && c0 + fi < cols.Count) {
                        int col = c0 + fi;
                        if (cols[col].editable) {
                            string v = fields[fi];
                            if (cols[col].isBool) {
                                if (DataTable.ParseBool(v)) { v = cols[col].boolTrue; }
                                else { v = cols[col].boolFalse; }
                            }
                            // A paste is bound by the same rules as typing, so a
                            // bad field is skipped rather than smuggled past the
                            // column's validation. st.editError reports the last
                            // one so the caller can surface it.
                            string perr = DataTable.ValidateCell(cols[col], v);
                            if (perr.Length > 0) { st.editError = perr; }
                            else {
                                DataTable.Journal(st, RowEdit.Cell(row, col, src.CellText(row, col), v));
                                src.SetCell(row, col, v);
                                written = written + 1;
                            }
                        }
                        fi = fi + 1;
                    }
                    slot = slot + 1;
                    li = li + 1;
                }
            }
        }
        DataTable.EndUndoGroup(st);
        if (written > 0) {
            st.editRow = st.dispRows[r0].row;
            st.editCol = c0;
            st.CellEdit.Raise();
            st.dirty = true;
        }
        return written;
    }

    /// Clear every editable cell in the current range (the Delete key).
    /// Returns the number of cells cleared.
    static int ClearRangeCells(DataTableState st, List<DataColumn> cols, DataSource src) {
        int r0 = st.hitOrder;
        int r1 = st.hitOrder;
        int c0 = st.hitCol;
        int c1 = st.hitCol;
        if (DataTable.HasRange(st)) {
            r0 = DataTable.MinI(st.rangeR0, st.rangeR1);
            r1 = DataTable.MaxI(st.rangeR0, st.rangeR1);
            c0 = DataTable.MinI(st.rangeC0, st.rangeC1);
            c1 = DataTable.MaxI(st.rangeC0, st.rangeC1);
        }
        if (r0 < 0 || c0 < 0) { return 0; }
        // The reported edit row must be a data row, not a group caption the
        // range happens to start on.
        r0 = DataTable.NextDataSlot(st, r0, 1);
        if (r0 < 0 || r0 > r1) { return 0; }
        // One Delete press is one undo, however wide the range.
        DataTable.BeginUndoGroup(st);
        int cleared = 0;
        int rr = r0;
        while (rr <= r1) {
            if (rr >= 0 && rr < st.dispRows.Count && st.dispRows[rr].kind == 0) {
                int row = st.dispRows[rr].row;
                int cc = c0;
                while (cc <= c1) {
                    // A required column can't be blanked; skip it rather than
                    // write a value the column has declared illegal.
                    if (cc < cols.Count && cols[cc].editable && !cols[cc].required) {
                        string blank = "";
                        if (cols[cc].isBool) { blank = cols[cc].boolFalse; }
                        DataTable.Journal(st, RowEdit.Cell(row, cc, src.CellText(row, cc), blank));
                        src.SetCell(row, cc, blank);
                        cleared = cleared + 1;
                    }
                    cc = cc + 1;
                }
            }
            rr = rr + 1;
        }
        DataTable.EndUndoGroup(st);
        if (cleared > 0) {
            st.editRow = st.dispRows[r0].row;
            st.editCol = c0;
            st.CellEdit.Raise();
            st.dirty = true;
        }
        return cleared;
    }

    /// Split on '\n', dropping any '\r' — clipboard text arrives with either
    /// line ending depending on where it was copied from.
    static List<string> SplitLines(string s) {
        return s.Replace("\r", "").Split("\n");
    }

    static List<string> SplitTabs(string s) {
        return s.Split("\t");
    }
}
