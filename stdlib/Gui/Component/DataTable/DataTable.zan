using System;
using Gui;
using Gui.Widget;
using Gui.Backend;

namespace Gui.Component.DataTable;

/// 企业级数据网格：固定行号与选择列、可排序
/// 表头、Excel 式集合筛选表头菜单、可调列宽、自定义单元格
/// 渲染器（文本/链接/标签/进度/徽章）和虚拟化行（只绘制
/// 可见窗口，数万行也能保持流畅）。
///
/// 数据通过 `DataSource` 提供（List<DataRow> 便捷重载见 `Render`，
/// 或通过 `RenderSource` 传入自定义虚拟源）。
partial class DataTable {
    // ---------- 选择 / 剪贴板 / 导出辅助 ----------

    /// 两者中较小的整数。
    static int MinI(int a, int b) { if (a < b) { return a; } return b; }
    /// 两者中较大的整数。
    static int MaxI(int a, int b) { if (a > b) { return a; } return b; }

    /// 当前存在单元格范围选择时为 true。
    static bool HasRange(DataTableState st) {
        return st.rangeR0 >= 0 && st.rangeC0 >= 0;
    }

    // 转义单个 CSV 字段（含逗号、引号或换行时加引号）。
    /// 转义单个 CSV 字段（含逗号、引号或换行时加引号，内嵌引号翻倍）。
    static string CsvField(string v) {
        bool needsQuote = false;
        int i = 0;
        while (i < v.Length) {
            char ch = v[i];
            int cc = (int)ch;
            if (cc == 44 || cc == 34 || cc == 10 || cc == 13) { needsQuote = true; i = v.Length; }
            else { i = i + 1; }
        }
        if (!needsQuote) { return v; }
        // 将内嵌引号翻倍；用 Substring 复制片段，
        // 使非 ASCII 字符完整保留（不做逐字符重建）。
        string body = "";
        int start = 0;
        for (int k = 0; k < v.Length; k = k + 1) {
            if ((int)v[k] == 34) {
                body = body + v.Substring(start, k - start + 1) + "\"";
                start = k + 1;
            }
        }
        body = body + v.Substring(start, v.Length - start);
        return "\"" + body + "\"";
    }

    /// 为当前单元格范围构建制表符分隔（剪贴板）或逗号分隔（CSV）文本块；
    /// 无范围则用勾选的行，
    /// 否则用整个（过滤/排序后的）视图。`csv` 决定分隔符和转义方式；
    /// `withHeader` 在前面加上列标题。
    /// Ctrl 追加出的多区域选区按区域顺序逐块拼接（Excel 同款：
    /// 每个区域独立成段，区域间不共享行）。
    static string BuildText(DataTableState st, List<DataColumn> cols, DataSource src, bool csv, bool withHeader) {
        string sep = "\t";
        if (csv) { sep = ","; }
        string nl = "\r\n";
        string outp = "";

        // 多区域：逐区域追加文本段。
        if (DataTable.RangeCount(st) > 1) {
            int n = DataTable.RangeCount(st);
            for (int mi = 0; mi < n; mi = mi + 1) {
                int mr0 = -1; int mc0 = -1; int mr1 = -1; int mc1 = -1;
                if (!DataTable.RangeAt(st, mi, out mr0, out mc0, out mr1, out mc1)) { continue; }
                if (withHeader) {
                    string hline = "";
                    int hc = mc0;
                    while (hc <= mc1) {
                        string h = cols[hc].title;
                        if (csv) { h = DataTable.CsvField(h); }
                        if (hc > mc0) { hline = hline + sep; }
                        hline = hline + h;
                        hc = hc + 1;
                    }
                    outp = outp + hline + nl;
                }
                int mrr = mr0;
                while (mrr <= mr1) {
                    if (mrr >= 0 && mrr < st.order.Count) {
                        int srcRow = st.order[mrr];
                        string line = "";
                        int cc = mc0;
                        while (cc <= mc1) {
                            string v = DataTable.CellTextRouted(cols, src, srcRow, cc);
                            if (csv) { v = DataTable.CsvField(v); }
                            if (cc > mc0) { line = line + sep; }
                            line = line + v;
                            cc = cc + 1;
                        }
                        outp = outp + line + nl;
                    }
                    mrr = mrr + 1;
                }
            }
            return outp;
        }

        int c0 = 0;
        int c1 = cols.Count - 1;
        bool rangeMode = DataTable.HasRange(st);
        if (rangeMode) {
            c0 = DataTable.MinI(st.rangeC0, st.rangeC1);
            c1 = DataTable.MaxI(st.rangeC0, st.rangeC1);
        }

        if (withHeader) {
            string line = "";
            int cc = c0;
            while (cc <= c1) {
                string h = cols[cc].title;
                if (csv) { h = DataTable.CsvField(h); }
                if (cc > c0) { line = line + sep; }
                line = line + h;
                cc = cc + 1;
            }
            outp = line + nl;
        }

        if (rangeMode) {
            int r0 = DataTable.MinI(st.rangeR0, st.rangeR1);
            int r1 = DataTable.MaxI(st.rangeR0, st.rangeR1);
            int rr = r0;
            while (rr <= r1) {
                if (rr >= 0 && rr < st.order.Count) {
                    int srcRow = st.order[rr];
                    string line = "";
                    int cc = c0;
                    while (cc <= c1) {
                        string v = DataTable.CellTextRouted(cols, src, srcRow, cc);
                        if (csv) { v = DataTable.CsvField(v); }
                        if (cc > c0) { line = line + sep; }
                        line = line + v;
                        cc = cc + 1;
                    }
                    outp = outp + line + nl;
                }
                rr = rr + 1;
            }
            return outp;
        }

        // 否则：选中的行；未勾选任何行时用整个视图
        bool anySel = false;
        int s = 0;
        while (s < st.order.Count) { if (DataTable.IsSelected(st, src, st.order[s])) { anySel = true; s = st.order.Count; } else { s = s + 1; } }
        for (int oi = 0; oi < st.order.Count; oi = oi + 1) {
            int ri = st.order[oi];
            if (!anySel || DataTable.IsSelected(st, src, ri)) {
                string line = "";
                int cc = c0;
                while (cc <= c1) {
                    string v = DataTable.CellTextRouted(cols, src, ri, cc);
                    if (csv) { v = DataTable.CsvField(v); }
                    if (cc > c0) { line = line + sep; }
                    line = line + v;
                    cc = cc + 1;
                }
                outp = outp + line + nl;
            }
        }
        return outp;
    }

    /// 按当前显示顺序全选/反选。稳定键源走 SelectionModel
    /// （全选不物化 bool[N]，只置 allSelected 或排除集合），
    /// 兼容 keyless 源保持旧 bool 行为。
    static void SelectAllRows(DataTableState st, DataSource src, bool val) {
        if (src != null && st.selectionModel != null) {
            bool stable = false;
            for (int k = 0; k < st.order.Count; k = k + 1) {
                if (DataTable.HasStableKey(st, src, st.order[k])) {
                    stable = true;
                    k = st.order.Count;
                }
            }
            if (stable) {
                if (val) { st.selectionModel.SelectAll(); }
                else { st.selectionModel.Clear(); }
                DataTable.SyncSelectionModel(st, src);
                return;
            }
        }
        for (int k = 0; k < st.order.Count; k = k + 1) {
            int row = st.order[k];
            st.selected[row] = val;
        }
    }

    /// 把 `a`..`b`（顺序位置，可反向）之间的数据行设为唯一选中集合。
    /// 行号列上的拖动多选与 Shift 点击都走这里。
    static void SelectRowSpan(DataTableState st, DataSource src, int a, int b) {
        if (a < 0) { a = b; }
        int lo = DataTable.MinI(a, b);
        int hi = DataTable.MaxI(a, b);
        DataTable.SelectAllRows(st, src, false);
        int k = lo;
        while (k <= hi) {
            if (k >= 0 && k < DataTable.DispCount(st) && DataTable.DispKind(st, k) == 0) {
                int row = DataTable.DispRowOf(st, k);
                if (src != null) { DataTable.SetSelected(st, src, row, true); }
                else { st.selected[row] = true; }
            }
            k = k + 1;
        }
    }

    /// 行号列上的按行选择：Shift 连续扩展、Ctrl 增删、
    /// 其余情况单选并把锚点落在该行。
    static void PickRow(DataTableState st, DataSource src, int oi, int mods) {
        if (oi < 0 || DataTable.DispKind(st, oi) != 0) { return; }
        int ri = DataTable.DispRowOf(st, oi);
        st.hitOrder = oi;
        st.hitRow = ri;
        st.hitCol = -1;
        st.RowClick.Raise();
        bool shift = (mods & 2) != 0;
        bool ctrl = (mods & 1) != 0;
        if (shift && st.selAnchor >= 0) {
            DataTable.SelectRowSpan(st, src, st.selAnchor, oi);
        } else if (ctrl) {
            bool selected = false;
            if (src != null) { selected = DataTable.IsSelected(st, src, ri); }
            else { selected = st.selected[ri]; }
            if (src != null) { DataTable.SetSelected(st, src, ri, !selected); }
            else { st.selected[ri] = !selected; }
            st.selAnchor = oi;
        } else {
            DataTable.SelectAllRows(st, src, false);
            if (src != null) { DataTable.SetSelected(st, src, ri, true); }
            else { st.selected[ri] = true; }
            st.selAnchor = oi;
            DataTable.ClearRange(st);
        }
        st.SelectionChanged.Raise();
    }

    /// 第一个选中行的源行索引；无选中时为 -1。
    /// 这是通过 `selection` 绑定暴露的标量。
    static int PrimarySelected(DataTableState st) {
        for (int i = 0; i < st.selected.Count; i = i + 1) {
            if (st.selected[i]) { return i; }
        }
        return -1;
    }

    /// 独占选中单个源行（清除其他所有选择）。
    /// row < 0 或越界会清除选择。当模型侧变化时，
    /// 由 `selection` 绑定使用。
    static void SetPrimarySelected(DataTableState st, DataSource src, int row) {
        if (src != null) {
            DataTable.SelectAllRows(st, src, false);
            if (row >= 0 && row < src.RowCount()) {
                DataTable.SetSelected(st, src, row, true);
            }
            return;
        }
        for (int i = 0; i < st.selected.Count; i = i + 1) { st.selected[i] = false; }
        if (row >= 0 && row < st.selected.Count) { st.selected[row] = true; }
    }

    /// 每帧将可选的 `selection` / `page` 绑定与实时状态
    /// 对账一次。与 Select 类似，上次同步后变化的一侧
    /// 胜出，因此编辑双向流动：model -> table 与 table -> model。
    /// 在 RenderSource 开头、选择列表定好大小之后调用。
    static void SyncBindings(DataTableState st, DataSource src) {
        if (st.selection != null) {
            int cur = DataTable.PrimarySelected(st);
            int b = st.selection.Get();
            if (cur == b) { st.lastSelSync = cur; }
            else if (cur != st.lastSelSync) { st.selection.Set(cur); st.lastSelSync = cur; }
            else { DataTable.SetPrimarySelected(st, src, b); st.lastSelSync = b; }
        }
        if (st.page != null) {
            int m = st.pageModel.Get();
            int b = st.page.Get();
            if (m == b) { st.lastPageSync = m; }
            else if (m != st.lastPageSync) { st.page.Set(m); st.lastPageSync = m; }
            else { st.pageModel.Set(b); st.lastPageSync = b; }
        }
    }

    /// 宽松格式数值单元格的整数部分（忽略分隔符和
    /// 小数尾巴）：“1,234.56” -> 1234，“-98%” -> -98，“” -> 0。
    static int ParseIntLoose(string s) {
        int i = 0;
        bool neg = false;
        if (i < s.Length && (int)s[i] == 45) { neg = true; i = i + 1; }
        int v = 0;
        bool any = false;
        while (i < s.Length) {
            int cc = (int)s[i];
            if (cc == 46) { i = s.Length; }            // 在小数点处停止
            else if (cc >= 48 && cc <= 57) { v = v * 10 + (cc - 48); any = true; i = i + 1; }
            else { i = i + 1; }                        // 跳过分隔符/单位
        }
        if (!any) { return 0; }
        if (neg) { return 0 - v; }
        return v;
    }

    /// 从当前单元格范围（或多区域并集）构建条形图：条 = 范围行，
    /// 值 = 范围内最右侧的数值列，标签 = 范围的第一
    /// 列（若该列就是值列，则用行序号）。多区域时逐区域
    /// 追加条目（区域间以 "｜" 前缀区分第一列的类别标签）。
    /// 没有范围或范围内无数值列时返回 false。
    static bool BuildChartFromRange(DataTableState st, List<DataColumn> cols, DataSource src) {
        if (!DataTable.HasRange(st)) { return false; }
        int c0 = DataTable.MinI(st.rangeC0, st.rangeC1);
        int c1 = DataTable.MaxI(st.rangeC0, st.rangeC1);
        int r0 = DataTable.MinI(st.rangeR0, st.rangeR1);
        int r1 = DataTable.MaxI(st.rangeR0, st.rangeR1);

        int valCol = -1;
        int cc = c1;
        while (cc >= c0) {
            if (cc >= 0 && cc < cols.Count && cols[cc].numeric) { valCol = cc; cc = c0 - 1; }
            else { cc = cc - 1; }
        }
        if (valCol < 0) { return false; }
        int labCol = c0;
        if (labCol == valCol) { labCol = -1; }

        st.chartBars = new List<ChartBar>();
        st.chartMax = 1;
        st.chartTitle = cols[valCol].title;

        int rr = r0;
        int n = 0;
        while (rr <= r1) {
            if (rr >= 0 && rr < st.order.Count) {
                int ri = st.order[rr];
                // 计算列：图表取公式值四舍五入；普通列走源文本。
                int v;
                double fv;
                if (DataTable.FormulaTryReal(cols, src, ri, valCol, out fv)) {
                    v = (int)(fv + (fv >= 0.0 ? 0.5 : -0.5));
                } else {
                    v = DataTable.ParseIntLoose(src.CellText(ri, valCol));
                }
                string lab = Convert.ToString(n + 1);
                if (labCol >= 0) { lab = DataTable.CellTextRouted(cols, src, ri, labCol); }
                st.chartBars.Add(new ChartBar(lab, v));
                int av = v;
                if (av < 0) { av = 0 - av; }
                if (av > st.chartMax) { st.chartMax = av; }
                n = n + 1;
            }
            rr = rr + 1;
        }
        return n > 0;
    }

    /// 清除单元格范围选择。
    static void ClearRange(DataTableState st) {
        st.rangeR0 = -1;
        st.rangeC0 = -1;
        st.rangeR1 = -1;
        st.rangeC1 = -1;
    }

    // ---------- 多区域选区（Excel 式 Ctrl 追加） ----------

    /// 归档的多区域数（不含当前 range）。
    static int MultiCount(DataTableState st) {
        return st.multiRanges.Count / 4;
    }

    /// 当前是否处于多区域选区（有归档区域，或 Ctrl 追加已发生）。
    static bool HasMulti(DataTableState st) {
        return st.multiActive || st.multiRanges.Count > 0;
    }

    /// 取归档区域 i（0 基）的边界：out 依次为 r0,c0,r1,c1
    /// （已归一化为 lo/hi）。越界返回 false。
    static bool MultiAt(DataTableState st, int i, out int r0, out int c0,
                        out int r1, out int c1) {
        r0 = -1; c0 = -1; r1 = -1; c1 = -1;
        int b = i * 4;
        if (i < 0 || b + 3 >= st.multiRanges.Count) { return false; }
        r0 = st.multiRanges[b];
        c0 = st.multiRanges[b + 1];
        r1 = st.multiRanges[b + 2];
        c1 = st.multiRanges[b + 3];
        return true;
    }

    /// 把当前 range 归档为第 n 个区域并清空活动 range。
    /// 用于 Ctrl+按下时：上一区域就此固化，随后按下的新区域
    /// 继续作为 range 拖拽。
    static void ArchiveRange(DataTableState st) {
        if (!DataTable.HasRange(st)) { return; }
        int r0 = DataTable.MinI(st.rangeR0, st.rangeR1);
        int r1 = DataTable.MaxI(st.rangeR0, st.rangeR1);
        int c0 = DataTable.MinI(st.rangeC0, st.rangeC1);
        int c1 = DataTable.MaxI(st.rangeC0, st.rangeC1);
        st.multiRanges.Add(r0);
        st.multiRanges.Add(c0);
        st.multiRanges.Add(r1);
        st.multiRanges.Add(c1);
        st.multiActive = true;
        DataTable.ClearRange(st);
    }

    /// 丢弃全部归档区域，回到单矩形模式。
    static void ClearMulti(DataTableState st) {
        st.multiRanges.Clear();
        st.multiActive = false;
    }

    /// 区域数量（多区域时为 归档+当前；单矩形时 0 或 1）。
    /// 只统计有内容的区域；调用方以 RangeCount>1 判断"真的多区域"。
    static int RangeCount(DataTableState st) {
        int n = st.multiRanges.Count / 4;
        if (DataTable.HasRange(st)) { n = n + 1; }
        return n;
    }

    /// 取第 i 个区域（0 基，先归档区域后当前 range）的归一化
    /// 边界 r0,c0,r1,c1。越界返回 false。复制/汇总/清空等
    /// "逐区域"消费者统一走它，无感知多区域与单矩形。
    static bool RangeAt(DataTableState st, int i, out int r0, out int c0,
                        out int r1, out int c1) {
        if (i < st.multiRanges.Count / 4) {
            return DataTable.MultiAt(st, i, out r0, out c0, out r1, out c1);
        }
        r0 = -1; c0 = -1; r1 = -1; c1 = -1;
        if (!DataTable.HasRange(st)) { return false; }
        r0 = DataTable.MinI(st.rangeR0, st.rangeR1);
        r1 = DataTable.MaxI(st.rangeR0, st.rangeR1);
        c0 = DataTable.MinI(st.rangeC0, st.rangeC1);
        c1 = DataTable.MaxI(st.rangeC0, st.rangeC1);
        return true;
    }

    /// 让选择列的勾选框跟随当前单元格范围：范围跨多行
    /// （即一次"区域选择"）时，覆盖的行全部勾上；本手势
    /// 早先勾上、但已随拖动移出范围的行再取消——勾选框
    /// 实时镜像高亮的矩形，而不是等松手才对账。
    /// 单格点击（范围只有一行）不碰勾选框：那是单元格
    /// 选择，不是区域选择；勾选框自己的点击也不受影响。
    /// `st.rangeSelTouched` 只记录本手势勾过的行，
    /// 松手或重按即清空，绝不会退掉用户此前手动勾的行。
    static void SyncRangeChecks(DataTableState st, DataSource src) {
        if (!st.showSelect) { return; }
        int rLo = -1;
        int rHi = -1;
        if (DataTable.HasRange(st)) {
            rLo = DataTable.MinI(st.rangeR0, st.rangeR1);
            rHi = DataTable.MaxI(st.rangeR0, st.rangeR1);
        }
        bool span = rHi > rLo;
        bool changed = false;
        // 手势勾过、但现在已不在跨行范围内的行退勾。
        int ti = 0;
        while (ti < st.rangeSelTouched.Count) {
            int slot = st.rangeSelTouched[ti];
            bool inside = span && slot >= rLo && slot <= rHi
                          && slot < DataTable.DispCount(st)
                          && DataTable.DispKind(st, slot) == 0;
            if (!inside) {
                int ri = DataTable.DispRowOf(st, slot);
                if (ri >= 0 && ri < st.selected.Count
                    && DataTable.IsSelected(st, src, ri)) {
                    DataTable.SetSelected(st, src, ri, false);
                    changed = true;
                }
                st.rangeSelTouched.RemoveAt(ti);
            } else { ti = ti + 1; }
        }
        // 勾上当前范围内所有数据行；只把手势自己勾的
        // 记入 touched——范围内本来已勾的行与本手势无关。
        if (span) {
            int k = rLo;
            while (k <= rHi) {
                if (k >= 0 && k < DataTable.DispCount(st) && DataTable.DispKind(st, k) == 0) {
                    int ri = DataTable.DispRowOf(st, k);
                    if (!DataTable.IsSelected(st, src, ri)) {
                        DataTable.SetSelected(st, src, ri, true);
                        st.rangeSelTouched.Add(k);
                        changed = true;
                    }
                }
                k = k + 1;
            }
        }
        if (changed) { st.SelectionChanged.Raise(); }
    }

    /// 将位于顺序位置 `from` 的行移到顺序位置
    /// `to`，其余行顺移——即可见顺序的手动拖拽重排。
    static void MoveOrder(DataTableState st, int from, int to) {
        if (from < 0 || from >= st.order.Count) { return; }
        if (to < 0) { to = 0; }
        if (to >= st.order.Count) { to = st.order.Count - 1; }
        if (from == to) { return; }
        int v = st.order[from];
        st.order.RemoveAt(from);
        st.order.Insert(to, v);
    }

    // ---------- 键盘导航 ----------

    /// `from` 及其后、承载数据行的显示槽位，按
    /// `step` 步进。跳过分组标题，方向键在单元格间移动
    /// 而不会卡在标题上。走完返回 -1。
    static int NextDataSlot(DataTableState st, int from, int step) {
        int i = from;
        while (i >= 0 && i < DataTable.DispCount(st)) {
            if (DataTable.DispKind(st, i) == 0) { return i; }
            i = i + step;
        }
        return -1;
    }

    /// 第一个承载数据行的显示槽位；没有数据行时为 -1。
    static int FirstDataSlot(DataTableState st) {
        return DataTable.NextDataSlot(st, 0, 1);
    }

    /// 最后一个承载数据行的显示槽位；没有数据行时为 -1。
    static int LastDataSlot(DataTableState st) {
        return DataTable.NextDataSlot(st, DataTable.DispCount(st) - 1, -1);
    }

    /// 可见列 `col` 在 `vorder` 中的位置；列被
    /// 隐藏时为 -1。导航按可见顺序移动，隐藏或
    /// 重排的列不会困住光标。
    static int VisPos(List<int> vorder, int col) {
        return vorder.IndexOf(col);
    }

    /// 可见列 `col` 在帧列列表中的位置；列不存在时为 -1。
    static int VisPos(List<FrameColumn> columns, int col) {
        for (int i = 0; i < columns.Count; i = i + 1) {
            if (columns[i].column == col) { return i; }
        }
        return -1;
    }

    /// kc 是否为导航键（方向键/PageUp/PageDown/Home/End/Tab）。
    static bool IsNavKey(int kc) {
        return kc == 37 || kc == 38 || kc == 39 || kc == 40
            || kc == 33 || kc == 34 || kc == 35 || kc == 36 || kc == 9;
    }

    /// 导航键应把光标放到哪里：两元素列表，依次为
    /// 目标显示槽位 (0) 和列索引 (1)；网格无处可去时为 -1/-1。
    /// 纯决策逻辑，独立于渲染路径，
    /// 可在无界面环境下测试。
    ///
    /// 行按显示槽位移动以跳过分组标题；列
    /// 按可见顺序位置移动，隐藏和重排的列也能正常处理。
    static List<int> NavTarget(DataTableState st, List<int> vorder, int visRows,
                               int kc, int emods) {
        List<FrameColumn> columns = new List<FrameColumn>();
        for (int i = 0; i < vorder.Count; i = i + 1) {
            columns.Add(new FrameColumn(vorder[i], 0, 1));
        }
        return DataTable.NavTarget(st, columns, visRows, kc, emods);
    }

    /// NavTarget 的帧列重载（帧列自带冻结带信息）；决策语义与上一重载一致。
    static List<int> NavTarget(DataTableState st, List<FrameColumn> columns, int visRows,
                               int kc, int emods) {
        List<int> outp = new List<int>{
            -1,
            -1 };
        if (columns.Count == 0 || !DataTable.IsNavKey(kc)) { return outp; }
        bool shift = Modifiers.HasShift(emods);
        bool ctrl = Modifiers.HasCtrl(emods);

        // 尚无光标时的首次按键落在左上角单元格，
        // 而不是什么都不做。
        if (st.hitOrder < 0 || st.hitCol < 0) {
            int firstSlot = DataTable.FirstDataSlot(st);
            if (firstSlot < 0) { return outp; }
            outp[0] = firstSlot;
            outp[1] = columns[0].column;
            return outp;
        }

        int vp = DataTable.VisPos(columns, st.hitCol);
        if (vp < 0) { vp = 0; }
        int slot = st.hitOrder;
        int newSlot = slot;
        int newVp = vp;

        if (kc == 38) {                                   // 上
            newSlot = DataTable.NextDataSlot(st, slot - 1, -1);
            if (ctrl) { newSlot = DataTable.FirstDataSlot(st); }
        } else if (kc == 40) {                            // 下
            newSlot = DataTable.NextDataSlot(st, slot + 1, 1);
            if (ctrl) { newSlot = DataTable.LastDataSlot(st); }
        } else if (kc == 37) {                            // 左
            newVp = vp - 1;
            if (ctrl) { newVp = 0; }
        } else if (kc == 39) {                            // 右
            newVp = vp + 1;
            if (ctrl) { newVp = columns.Count - 1; }
        } else if (kc == 33) {                            // PageUp
            newSlot = DataTable.NextDataSlot(st, slot - visRows, -1);
            if (newSlot < 0) { newSlot = DataTable.FirstDataSlot(st); }
        } else if (kc == 34) {                            // PageDown
            newSlot = DataTable.NextDataSlot(st, slot + visRows, 1);
            if (newSlot < 0) { newSlot = DataTable.LastDataSlot(st); }
        } else if (kc == 36) {                            // Home：行首，
            newVp = 0;                                    // Ctrl+Home：网格起点
            if (ctrl) { newSlot = DataTable.FirstDataSlot(st); }
        } else if (kc == 35) {                            // End：行尾，
            newVp = columns.Count - 1;                     // Ctrl+End：网格末尾
            if (ctrl) { newSlot = DataTable.LastDataSlot(st); }
        } else if (kc == 9) {
            // Tab 逐格移动，到边缘时换行——
            // 就像电子表格在表单中移动。
            if (shift) {
                newVp = vp - 1;
                if (newVp < 0) {
                    int prev = DataTable.NextDataSlot(st, slot - 1, -1);
                    if (prev >= 0) { newSlot = prev; newVp = columns.Count - 1; }
                    else { newVp = 0; }
                }
            } else {
                newVp = vp + 1;
                if (newVp >= columns.Count) {
                    int next = DataTable.NextDataSlot(st, slot + 1, 1);
                    if (next >= 0) { newSlot = next; newVp = 0; }
                    else { newVp = columns.Count - 1; }
                }
            }
        }

        // 越界时保持原位，而不是回绕或清除。
        if (newSlot < 0) { newSlot = slot; }
        if (newVp < 0) { newVp = 0; }
        if (newVp >= columns.Count) { newVp = columns.Count - 1; }
        if (newSlot == slot && newVp == vp) { return outp; }
        outp[0] = newSlot;
        outp[1] = columns[newVp].column;
        return outp;
    }

    /// 将单元格光标移到显示槽位 `oi`、列 `col`。`extend` 从锚点
    /// 扩展当前范围，而不是收缩为单个单元格。
    /// 目标不是可导航单元格时返回 false。
    static bool MoveCursor(DataTableState st, DataSource src, int oi, int col, bool extend) {
        if (oi < 0 || oi >= DataTable.DispCount(st)) { return false; }
        if (DataTable.DispKind(st, oi) != 0) { return false; }
        if (col < 0) { return false; }
        st.hitOrder = oi;
        st.hitRow = DataTable.DispRowOf(st, oi);
        st.hitCol = col;
        if (extend) {
            // 锚点是范围起始处；只有远端的
            // 角跟随光标移动。
            if (st.rangeR0 < 0 || st.rangeC0 < 0) {
                st.rangeR0 = oi;
                st.rangeC0 = col;
            }
            st.rangeR1 = oi;
            st.rangeC1 = col;
            // 键盘 Shift 扩展与鼠标区域拖选同一语义：
            // 选择列的勾选框实时跟随范围行集。
            DataTable.SyncRangeChecks(st, src);
        } else {
            st.rangeR0 = oi;
            st.rangeR1 = oi;
            st.rangeC0 = col;
            st.rangeC1 = col;
            st.selAnchor = oi;
            // 上一个区域手势的勾选跟踪到此为止。
            st.rangeSelTouched.Clear();
        }
        return true;
    }

    /// 以最小滚动量将显示槽位 `oi` 滚入视野。
    /// 分页模式下改为选中包含它的页。
    static void ScrollSlotIntoView(DataTableState st, int oi, int visRows) {
        if (oi < 0 || visRows < 1) { return; }
        if (st.paged) {
            if (st.pageRows > 0) { st.pageModel.Set(oi / st.pageRows + 1); }
            return;
        }
        if (oi < st.scrollRow) {
            st.scrollRow = oi;
            st.ScrollChanged.Raise();
        } else if (oi >= st.scrollRow + visRows) {
            st.scrollRow = oi - visRows + 1;
            st.ScrollChanged.Raise();
        }
    }

    /// 水平平移使列 `col` 完全可见。
    ///
    /// 冻结列（任一边）按定义已在屏幕上，因此对它是
    /// 空操作。对滚动列，可见带区要减去
    /// 两侧冻结带：仅仅滚过 `pinnedW` 仍会
    /// 让它藏在右侧冻结带之下。
    static void ScrollColIntoView(DataTableState st, List<int> vorder, int col,
                                  int dataViewW, int pinnedW) {
        int nL = DataTable.LeftFrozenCount(st, vorder);
        int nR = DataTable.RightFrozenCount(st, vorder);
        List<FrameColumn> columns = new List<FrameColumn>();
        for (int i = 0; i < vorder.Count; i = i + 1) {
            int band = 1;
            if (i < nL) { band = 0; }
            else if (i >= vorder.Count - nR) { band = 2; }
            columns.Add(new FrameColumn(vorder[i], 0, band));
        }
        DataTable.ScrollColIntoView(st, columns, col, dataViewW, pinnedW);
    }

    /// ScrollColIntoView 的帧列重载：带区归属直接取帧列的 band。
    static void ScrollColIntoView(DataTableState st, List<FrameColumn> columns, int col,
                                  int dataViewW, int pinnedW) {
        int pos = DataTable.VisPos(columns, col);
        if (pos < 0) { return; }
        if (columns[pos].band != 1) { return; }

        // 列在滚动带区内的偏移，以及带区自身的
        // 宽度——冻结列不属于二者之一。
        int off = 0;
        int i = 0;
        for (; i < pos; i = i + 1) {
            if (columns[i].band == 1) { off = off + st.dispW[columns[i].column]; }
        }
        int w = st.dispW[col];
        int rightW = 0;
        i = 0;
        while (i < columns.Count) {
            if (columns[i].band == 2) { rightW = rightW + st.dispW[columns[i].column]; }
            i = i + 1;
        }
        int bandW = dataViewW - pinnedW - rightW;
        if (bandW < 1) { bandW = 1; }

        if (off < st.scrollX) {
            st.scrollX = off;
        } else if (off + w > st.scrollX + bandW) {
            st.scrollX = off + w - bandW;
        }
        if (st.scrollX < 0) { st.scrollX = 0; }
    }

    // ---------- 剪贴板 ----------

    /// 当前单元格范围（或选择）的制表符分隔文本。
    /// 这就是 Ctrl+C 复制到剪贴板的内容。
    static string CopyText(DataTableState st, List<DataColumn> cols, DataSource src) {
        return DataTable.BuildText(st, cols, src, false, false);
    }

    /// 从光标处开始向网格粘贴制表符分隔文本，向下
    /// 向右填充。只有可编辑且非 bool 的列接受值；bool
    /// 列通过 ParseBool 读取粘贴文本，“Yes”/“1”都能落库。
    /// 返回实际写入的单元格数。
    static int PasteText(DataTableState st, List<DataColumn> cols, DataSource src, string text) {
        if (text.Length == 0) { return 0; }
        int r0 = st.hitOrder;
        int c0 = st.hitCol;
        if (DataTable.HasRange(st)) {
            r0 = DataTable.MinI(st.rangeR0, st.rangeR1);
            c0 = DataTable.MinI(st.rangeC0, st.rangeC1);
        }
        if (r0 < 0 || c0 < 0) { return 0; }

        // 锚点可能是分组标题（例如光标停在标题上）；
        // 从那里起第一个数据行开始写入。
        r0 = DataTable.NextDataSlot(st, r0, 1);
        if (r0 < 0) { return 0; }

        // 一次粘贴记一次撤销，无论涉及多少单元格。
        DataTable.BeginUndoGroup(st);
        List<string> lines = DataTable.SplitLines(text);
        int written = 0;
        int li = 0;
        int slot = r0;
        while (li < lines.Count) {
            // 结尾换行会产生一个空行；粘贴它会清空
            // 用户并未指向的行。
            if (lines[li].Length == 0 && li == lines.Count - 1) { li = li + 1; }
            else {
                slot = DataTable.NextDataSlot(st, slot, 1);
                if (slot < 0) { li = lines.Count; }
                else {
                    int row = DataTable.DispRowOf(st, slot);
                    List<string> fields = DataTable.SplitTabs(lines[li]);
                    for (int fi = 0; fi < fields.Count && c0 + fi < cols.Count; fi = fi + 1) {
                        int col = c0 + fi;
                        if (cols[col].editable) {
                            string v = fields[fi];
                            if (cols[col].isBool) {
                                if (DataTable.ParseBool(v)) { v = cols[col].boolTrue; }
                                else { v = cols[col].boolFalse; }
                            }
                            // 粘贴与键入受相同规则约束，
                            // 非法字段会被跳过，而不是绕过
                            // 列的校验。st.editError 报告最后
                            // 一个，供调用方展示。
                            string perr = DataTable.ValidateCell(cols[col], v);
                            if (perr.Length > 0) { st.editError = perr; }
                            else {
                                DataTable.Journal(st, RowEdit.Cell(row, col, src.CellText(row, col), v));
                                src.SetCell(row, col, v);
                                written = written + 1;
                            }
                        }
                    }
                    slot = slot + 1;
                    li = li + 1;
                }
            }
        }
        DataTable.EndUndoGroup(st);
        if (written > 0) {
            st.editRow = DataTable.DispRowOf(st, r0);
            st.editCol = c0;
            st.CellEdit.Raise();
            st.dirty = true;
        }
        return written;
    }

    /// 清空当前范围内的所有可编辑单元格（Delete 键）。
    /// 多区域（Ctrl 追加）时先归并成互不重叠的行×列段，逐段
    /// 调用自身清空（此时 RangeCount==1，不会再次进入本分支）。
    /// 返回清空的单元格数。
    static int ClearRangeCells(DataTableState st, List<DataColumn> cols, DataSource src) {
        if (DataTable.RangeCount(st) > 1) {
            int n = DataTable.RangeCount(st);
            int total = 0;
            int segR0 = -1;
            int segR1 = -1;
            int segC0 = -1;
            int segC1 = -1;
            // 归并：按行段收集与既有段相交的区域，重叠消解后
            // 每个行段调用一次单矩形清空。调用方（Delete 键）
            // 一次操作仍记一组撤销。
            DataTable.BeginUndoGroup(st);
            for (int mi = 0; mi < n; mi = mi + 1) {
                int mr0 = -1; int mc0 = -1; int mr1 = -1; int mc1 = -1;
                if (!DataTable.RangeAt(st, mi, out mr0, out mc0, out mr1, out mc1)) { continue; }
                if (segR0 >= 0 && mr0 <= segR1 && mr1 >= segR0) {
                    if (mc0 < segC0) { segC0 = mc0; }
                    if (mc1 > segC1) { segC1 = mc1; }
                    continue;
                }
                if (segR0 >= 0) {
                    total = total + DataTable.ClearSeg(st, cols, src, segR0, segR1, segC0, segC1);
                }
                segR0 = mr0; segR1 = mr1; segC0 = mc0; segC1 = mc1;
            }
            if (segR0 >= 0) {
                total = total + DataTable.ClearSeg(st, cols, src, segR0, segR1, segC0, segC1);
            }
            DataTable.EndUndoGroup(st);
            return total;
        }
        int r0 = st.hitOrder;
        int r1 = st.hitOrder;
        int c0 = st.hitCol;
        int c1 = st.hitCol;
        if (DataTable.HasRange(st)) {
            r0 = DataTable.MinI(st.rangeR0, st.rangeR1);
            r1 = DataTable.MaxI(st.rangeR0, st.rangeR1);
            c0 = DataTable.MinI(st.rangeC0, st.rangeC1);
            c1 = DataTable.MaxI(st.rangeC0, st.rangeC1);
        }
        if (r0 < 0 || c0 < 0) { return 0; }
        // 报告的编辑行必须是数据行，而不是范围恰好
        // 起始处的分组标题。
        r0 = DataTable.NextDataSlot(st, r0, 1);
        if (r0 < 0 || r0 > r1) { return 0; }
        // 一次 Delete 记一次撤销，无论范围多大。
        // （多区域入口已开组；BeginUndoGroup 嵌套只前移序号，
        // 不破坏外层组。）
        DataTable.BeginUndoGroup(st);
        int cleared = DataTable.ClearSeg(st, cols, src, r0, r1, c0, c1);
        DataTable.EndUndoGroup(st);
        if (cleared > 0) {
            st.editRow = DataTable.DispRowOf(st, r0);
            st.editCol = c0;
            st.CellEdit.Raise();
            st.dirty = true;
        }
        return cleared;
    }

    /// 清空单个归一化行×列段内的可编辑单元格。
    /// ClearRangeCells 的共用内核：不做撤销分组，不读
    /// st.range*——边界全部来自参数。
    static int ClearSeg(DataTableState st, List<DataColumn> cols, DataSource src,
                        int r0, int r1, int c0, int c1) {
        int cleared = 0;
        int rr = r0;
        while (rr <= r1) {
            if (rr >= 0 && rr < DataTable.DispCount(st) && DataTable.DispKind(st, rr) == 0) {
                int row = DataTable.DispRowOf(st, rr);
                int cc = c0;
                while (cc <= c1) {
                    // 必填列不能留空；跳过它，而不是
                    // 写入列声明为非法的值。
                    if (cc < cols.Count && cols[cc].editable && !cols[cc].required) {
                        string blank = "";
                        if (cols[cc].isBool) { blank = cols[cc].boolFalse; }
                        DataTable.Journal(st, RowEdit.Cell(row, cc, src.CellText(row, cc), blank));
                        src.SetCell(row, cc, blank);
                        cleared = cleared + 1;
                    }
                    cc = cc + 1;
                }
            }
            rr = rr + 1;
        }
        return cleared;
    }

    /// 按 '\n' 分割并去掉 '\r'——剪贴板文本的
    /// 换行符因复制来源而异。
    static List<string> SplitLines(string s) {
        return s.Replace("\r", "").Split("\n");
    }

    /// 按 '\t' 分割文本。
    static List<string> SplitTabs(string s) {
        return s.Split("\t");
    }

    /// 迷你图数值序列：按 ',' 分割，丢弃空段
    /// （"1,,2" 与 "1,2" 等价）。元素交给 ParseInt/ParseReal
    /// 宽松解析——"¥12" 之类带修饰的文本也能读出数值。
    static List<string> NumSeries(string s) {
        List<string> outp = new List<string>();
        if (s == null) { return outp; }
        List<string> parts = s.Split(",");
        for (int i = 0; i < parts.Count; i = i + 1) {
            if (parts[i] != "") { outp.Add(parts[i]); }
        }
        return outp;
    }
}
