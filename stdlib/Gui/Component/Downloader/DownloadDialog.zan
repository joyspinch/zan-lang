using System;
using System.Net.Http.Download;
using Gui;
using Gui.Widget;

namespace Gui.Component.Downloader;

/// <summary>通用的“下载 + 安装（解压）”进度窗：一行总体进度（n/m 个
/// 文件）、一行当前文件进度、一行阶段提示，外加取消。
///
/// 它只是 <see cref="DownloadJob"/> 的观察者：任务跑在自己的工作线程上，
/// 关掉窗口不会打断它（标题下那句提示就是这个意思），因此同一个任务可以
/// 有窗口、也可以没有。CEF 运行时下载是第一个调用方，程序自更新、包管理
/// 器下载复用同一个类：
///
///   DownloadJob job = new DownloadJob();
///   job.Add(DownloadItem.FromUrl(url, dest).WithSha1(sha).WithExtractTo(dir));
///   job.Start();
///   DownloadDialog dlg = DownloadDialog.Show(app, "系统检查更新", job);
///
/// 没有主窗口的启动阶段可用 `OpenStandalone` + `RunStandalone`：它自己
/// 驱动唯一的顶层窗口，用户关窗不取消后台任务，关窗后任务静默跑完。
///
/// 刷新走 <c>App.RequestAnimationFrame(200)</c>：任务在跑时每 200ms 出一帧，
/// 跑完就不再武装截止时间，因此空闲时零 CPU（直接让 <c>Pending()</c> 恒真
/// 会让主循环满速忙渲染）。字节进度由 <see cref="DownloadJob.Poll"/> 从
/// 伴生进度文件读，所以外部下载器写同一个文件也能驱动这个窗口。</summary>
class DownloadDialog : ChildWindow {
    /// 当前窗口。设计里的事件处理器是非捕获的静态方法，取消按钮通过
    /// 它找到自己的窗口（与 ZanIDE 各子窗口一致的做法）。
    static DownloadDialog current;

    DownloadJob job;
    string caption;
    string intro;
    string hint;
    /// 界面文案，默认中文；换语言的宿主用 SetTexts 覆盖。
    string tFileProgress;
    string tDownloadFile;
    string tFilesUnit;
    string tCancel;
    string tClose;

    Label introLbl;
    Label hintLbl;
    Label fileProgressLbl;
    Label downloadFileLbl;
    Label countLbl;
    Label nameLbl;
    Label stageLbl;
    ScrollColumn introBox;
    Progress overall;
    Progress single;
    Button cancelBtn;

    /// 默认中文文案、无任务；控件在 BuildUi 时才建。
    DownloadDialog() {
        this.job = null;
        this.caption = "下载";
        this.intro = "";
        this.hint = "本窗消失不影响更新进度。";
        this.tFileProgress = "文件进度";
        this.tDownloadFile = "下载文件";
        this.tFilesUnit = "个文件";
        this.tCancel = "取消";
        this.tClose = "关闭";
    }

    /// <summary>开一个跟着 <paramref name="j"/> 的进度窗。任务可以先
    /// <c>Start()</c> 也可以后 <c>Start()</c>：窗口只读状态。</summary>
    static DownloadDialog Show(App parent, string title, DownloadJob j) {
        DownloadDialog d = new DownloadDialog();
        d.caption = title;
        d.job = j;
        d.Open(parent);
        return d;
    }

    /// <summary>在还没有主窗口时显示独立的下载进度窗。调用方负责在
    /// <c>RunStandalone</c> 前启动任务；窗口创建失败会把异常交给调用方，
    /// 方便无显示器宿主回退到静默路径。</summary>
    static DownloadDialog OpenStandalone(string title, DownloadJob j) {
        DownloadDialog d = new DownloadDialog();
        d.caption = title;
        d.job = j;
        DownloadDialog.current = d;
        d.BuildUi();
        d.OpenStandalone();
        return d;
    }

    /// <summary>驱动独立窗口直到任务成功或用户关窗，并返回是否成功。
    /// 失败/取消时窗口保留，调用方可以先更新说明文字，再调用
    /// <see cref="WaitStandaloneClose"/> 等用户关窗。用户关窗不会取消任务；
    /// 关窗后不再绘制界面，剩余工作静默等到收工。</summary>
    async bool RunStandalone() {
        this.PumpStandaloneUntilKeepOpen(() => {
            if (this.job == null) { return true; }
            return !this.job.Running() || !this.IsOpen();
        });
        while (this.job != null && this.job.Running()) {
            await Task.Delay(200);
        }
        if (this.job != null && this.job.Succeeded()) {
            if (this.IsOpen()) { this.Close(); }
            if (DownloadDialog.current == this) {
                DownloadDialog.current = null;
            }
            return true;
        }
        if (!this.IsOpen() && DownloadDialog.current == this) {
            DownloadDialog.current = null;
        }
        return false;
    }

    /// <summary>失败/取消后继续驱动窗口，直到用户关窗。</summary>
    void WaitStandaloneClose() {
        if (!this.IsOpen()) { return; }
        this.PumpStandaloneUntil(() => { return !this.IsOpen(); });
        if (DownloadDialog.current == this) {
            DownloadDialog.current = null;
        }
    }

    /// <summary>标题下面那段说明文字（"" = 不显示）。<c>Show</c> 之前
    /// 或之后都能调用。</summary>
    void SetIntro(string text) {
        this.intro = text;
        if (this.introLbl != null) { this.introLbl.Text = text; }
        // 没有说明文字时不留一个空的框：说明区是有边框的滚动块。
        if (this.introBox != null) { this.introBox.visible = text != ""; }
        this.RequestRedraw();
    }

    /// <summary>说明下面那行弱化提示（默认是“本窗消失不影响更新进度”）。
    /// </summary>
    void SetHint(string text) {
        this.hint = text;
        if (this.hintLbl != null) { this.hintLbl.Text = text; }
        this.RequestRedraw();
    }

    /// <summary>覆盖界面文案（宿主自己管界面语言时用）。</summary>
    void SetTexts(string fileProgress, string downloadFile, string filesUnit,
            string cancel, string close) {
        this.tFileProgress = fileProgress;
        this.tDownloadFile = downloadFile;
        this.tFilesUnit = filesUnit;
        this.tCancel = cancel;
        this.tClose = close;
        if (this.fileProgressLbl != null) {
            this.fileProgressLbl.Text = fileProgress;
        }
        if (this.downloadFileLbl != null) {
            this.downloadFileLbl.Text = downloadFile;
        }
        if (this.countLbl != null) { this.countLbl.Text = this.CountText(); }
        if (this.cancelBtn != null) {
            if (this.job != null && this.job.Running()) {
                this.cancelBtn.Text = cancel;
            } else {
                this.cancelBtn.Text = close;
            }
        }
        this.RequestRedraw();
    }

    /// 登记为当前窗口、构建界面并在 `parent` 内打开（Show 的实现步）。
    void Open(App parent) {
        DownloadDialog.current = this;
        this.BuildUi();
        this.OpenHost(parent);
    }

    /// 构建界面：固定的进度行/提示行/按钮停靠在底部先拿走高度，
    /// 说明文字放进可滚动区（长文本滚看不挤压后面的行）。
    void BuildUi() {
        // 进度行、提示行和按钮的高度是固定的，说明文字的高度不是：
        // 一段换行成八行的失败原因会把停靠可用的高度吃光，后面的行
        // 被压成零高并落在同一个 y 上（两条进度条叠在一起）。因此
        // 固定部分整体停靠在底部先拿走自己的高度，说明文字放进可
        // 滚动区，长到装不下就滚动。
        Panel root;
        Panel fixedRows;

        hintLbl = new Label(this.hint);
        hintLbl.wrap = true;
        hintLbl.Class = "secondary small";

        countLbl = new Label(this.CountText());
        countLbl.Class = "secondary small";
        fileProgressLbl = new Label(this.tFileProgress);
        overall = new Progress(0, 2);

        nameLbl = new Label(this.NameText());
        nameLbl.Class = "secondary small";
        downloadFileLbl = new Label(this.tDownloadFile);
        single = new Progress(0, 2);

        stageLbl = new Label(this.StatusText());
        stageLbl.Class = "secondary small";
        cancelBtn = new Button(this.tCancel);
        cancelBtn.Class = "secondary";
        cancelBtn.Click += DownloadDialog.OnCancel;
        Panel foot = Panel.Row() { Children = { stageLbl, cancelBtn } };
        foot.Gap(8);
        cancelBtn.DockRight();

        // 集合初始化器逐项 Add（With 语义）；DockBottom/Grow 这类
        // “与子节点自身相关”的修饰仍留在初始化器之后对控件调用。
        fixedRows = Panel.Column() {
            Children = {
                hintLbl,
                DownloadDialog.HeaderRow(fileProgressLbl, countLbl),
                overall,
                DownloadDialog.HeaderRow(downloadFileLbl, nameLbl),
                single,
                foot
            }
        };
        fixedRows.Pad(0);
        fixedRows.Gap(10);

        introLbl = new Label(this.intro);
        introLbl.wrap = true;
        introBox = new ScrollColumn();
        introBox.Add(introLbl);
        introBox.visible = this.intro != "";

        root = Panel.Column() { Children = { fixedRows, introBox } };
        root.Pad(18);
        root.Gap(10);
        fixedRows.DockBottom();
        introBox.Grow();

        this.SetRoot(root, null);
    }

    /// <summary>一行“标题 …… 右对齐的值”。</summary>
    static Panel HeaderRow(Label title, Label value) {
        Panel row = Panel.Row() { Children = { title, value } };
        row.Gap(8);
        value.DockRight();
        return row;
    }

    /// <summary>窗口标题：返回构造时设置的 caption。</summary>
    override string Title() { return this.caption; }
    /// <summary>窗口宽度：固定 520。</summary>
    override int Width() { return 520; }
    /// <summary>窗口高度：固定 320。</summary>
    override int Height() { return 320; }
    /// <summary>不显示最大化按钮。</summary>
    override bool ShowMaximize() { return false; }
    /// <summary>控件命中 id 基址：880000。</summary>
    override int IdBase() { return 880000; }

    /// <summary>关窗不取消任务：worker 线程照旧把更新装完（标题下那句
    /// 提示承诺的正是这一点）。要真的停下来请按取消。</summary>
    override void OnCloseRequested() {
        if (DownloadDialog.current == this) { DownloadDialog.current = null; }
    }

    /// <summary>取消按钮：请求任务在下一个块边界收工。已下载的部分留在
    /// 磁盘上，下次进来从断点续传。</summary>
    static void OnCancel() {
        DownloadDialog d = DownloadDialog.current;
        if (d == null) { return; }
        if (d.job != null && d.job.Running()) {
            d.job.Cancel();
            return;
        }
        d.Close();
    }

    /// <summary>每帧把任务状态搬到控件上，并在任务还在跑时武装下一次
    /// 限速重绘。</summary>
    override void AfterFrame() {
        if (this.job == null) { return; }
        this.job.Poll();
        this.overall.SetPercent(this.job.TotalPercent());
        this.single.SetPercent(this.job.ItemPercent());
        this.countLbl.Text = this.CountText();
        this.nameLbl.Text = this.NameText();
        this.stageLbl.Text = this.StatusText();
        // 失败原因归说明区（可滚动、可完整读到）；阶段行只有一行，
        // 放不下长文案。调用方自己写了说明就不覆盖它。
        if (this.job.Stage() == DownloadStage.Failed && this.intro == "") {
            this.SetIntro(this.job.Error());
        }
        if (this.job.Running()) {
            this.cancelBtn.Text = this.tCancel;
            App h = this.Host();
            if (h != null) { h.RequestAnimationFrame(200); }
        } else {
            this.cancelBtn.Text = this.tClose;
        }
    }

    /// <summary>"1/2 个文件"。</summary>
    string CountText() {
        if (this.job == null) { return ""; }
        return Convert.ToString(this.job.DoneCount()) + "/"
            + Convert.ToString(this.job.Count()) + " " + this.tFilesUnit;
    }

    /// <summary>当前文件名 + 已收/总量。</summary>
    string NameText() {
        if (this.job == null) { return ""; }
        string s = this.job.Current();
        if (this.job.Total() > 0) {
            s = s + "   " + DownloadJob.Human(this.job.Got()) + " / "
                + DownloadJob.Human(this.job.Total());
        }
        return s;
    }

    /// <summary>阶段一行。失败原因去说明区（可滚动），这里只留阶段，
    /// 免得同一段长文案在两处各自换行、把布局撑破。</summary>
    string StatusText() {
        if (this.job == null) { return ""; }
        return DownloadStage.Text(this.job.Stage());
    }
}
