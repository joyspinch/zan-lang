using System;
using System.Json;
using Gui;

namespace Gui.Component.Chart;

/// 纯 Zan 图表库 —— ECharts 2.2.x 的声明性子集，全部用
/// stdlib 组件与确定性的整数几何绘制，无 JS / DOM / WebView：
///   · 17 种原生 series.type：line / bar / pie / scatter / k /
///     radar / chord / force / map / gauge / funnel / eventRiver /
///     treemap / tree / wordCloud / heatmap，外加 custom kind
///     （sankey / box / error / waterfall / sunburst / radialBars /
///     venn）。
///   · 轴：category / value / time（整数天数，表格驱动日期）/
///     log（仅正值、10 的幂刻度），独立左右轴 min/max/reversed。
///   · 交互：hover tooltip、图例切换可见性、dataZoom 窗口、
///     markLine / markPoint / markArea、emphasis（hover）paint。
///   · 确定性：无随机数、无系统时钟；布局/命中/指纹均为整数运算，
///     conformance 测试可逐值断言。
/// Zan 扩展（超出 ECharts 2.2.x 的便捷 API）：ChartOption.Of /
/// OfRings、ChartSeries.Line / Bar / Area / OfRegions / OfEvents /
/// OfBoxes / OfErrors / OfPoints、pieRings 嵌套环、eventRiver 由
/// 数值系列驱动（按类别索引映射时间）、图表数据用 List<int> /
/// ChartData 直接表达。
/// 渲染由 ChartView（partial）分发到每类一个渲染器；所有绘制走
/// ChartOption -> ResolvedChart -> Canvas 管道。
///
/// 内部持有者：计算出的绘图矩形加上解析后的数值轴
/// 范围（左轴 + 可选右轴），使每个渲染器以相同方式
/// 映射数值 -> 像素。leftMin/leftMax 始终有效；rightMin/rightMax 仅在有右轴时有效。
/// leftLog/rightLog 为对数轴（仅正值）；isTime 为时间 X 轴
/// （整数天数，标签由 Chart.TimeLabel 生成）。
class ChartFrame {
    int plotX;
    int plotY;
    int plotW;
    int plotH;
    int leftMin;
    int leftMax;
    int rightMin;
    int rightMax;
    bool hasRight;
    bool reversed;       // 左轴翻转
    bool rightReversed;  // 右轴翻转（独立于左轴）
    bool leftLog;        // 左轴对数刻度
    bool rightLog;       // 右轴对数刻度
    bool isTime;         // X 轴时间刻度
    int timeMin;
    int timeMax;

    // 左轴（axisIndex 0）或右轴（1）上数值对应的像素 Y，
    // 遵循各轴预设的翻转标志。
    int YOf(int v, int axisIndex) {
        int lo = this.leftMin;
        int hi = this.leftMax;
        bool rev = this.reversed;
        if (axisIndex == 1) { lo = this.rightMin; hi = this.rightMax; rev = this.rightReversed; }
        int span = hi - lo;
        if (span == 0) { span = 1; }
        int d = (v - lo) * this.plotH / span;
        if (rev) { return this.plotY + d; }
        return this.plotY + this.plotH - d;
    }

    // 对数 Y 映射：仅正值（v < 1 钳制到 1），log10 线性化后
    // 按轴范围映射。低于/高于范围钳制在绘图区内。
    int YOfLog(int v, int axisIndex) {
        if (v < 1) { v = 1; }
        int lo = this.leftMin;
        int hi = this.leftMax;
        bool rev = this.reversed;
        if (axisIndex == 1) { lo = this.rightMin; hi = this.rightMax; rev = this.rightReversed; }
        if (lo < 1) { lo = 1; }
        if (hi < lo + 1) { hi = lo + 1; }
        int llo = Chart.Log10(lo);
        int lhi = Chart.Log10(hi);
        if (lhi <= llo) { lhi = llo + 1; }
        int d = (Chart.Log10(v) - llo) * this.plotH / (lhi - llo);
        if (d < 0) { d = 0; }
        if (d > this.plotH) { d = this.plotH; }
        if (rev) { return this.plotY + d; }
        return this.plotY + this.plotH - d;
    }

    // 时间 X 映射：整数时间值 → 像素 x，钳制在绘图区内。
    int XOfTime(int t) {
        int lo = this.timeMin;
        int hi = this.timeMax;
        int span = hi - lo;
        if (span == 0) { span = 1; }
        int d = (t - lo) * this.plotW / span;
        if (d < 0) { d = 0; }
        if (d > this.plotW) { d = this.plotW; }
        return this.plotX + d;
    }
}

/// 图表的虚拟、拉取式数据源——图表无需持有
/// 原始点数组，数百万点的系列也不产生逐单元对象
/// 分配（对应 DataTable 的 DataSource）。子类化它，
/// 按需从自己的列式/类型化存储读取点，或用 SeriesListSource 包装
/// 内存中的 List<ChartSeries>。
class ChartSource {
    virtual int SeriesCount() { return 0; }
    virtual string SeriesName(int s) { return ""; }
    virtual int SeriesColor(int s) { return 0; }   // 0 = 自动（调色板）
    virtual int PointCount(int s) { return 0; }
    virtual int ValueAt(int s, int i) { return 0; }
}

/// 适配器：把已有的 List<ChartSeries> 暴露为 ChartSource，
/// 高性能路径直接接受内存数据，无需重构。
class SeriesListSource : ChartSource {
    List<ChartSeries> series;

    static SeriesListSource Of(List<ChartSeries> series) {
        SeriesListSource s = new SeriesListSource();
        s.series = series;
        return s;
    }

    override int SeriesCount() { return this.series.Count; }
    override string SeriesName(int s) { return this.series[s].name; }
    override int SeriesColor(int s) { return this.series[s].color; }
    override int PointCount(int s) { return this.series[s].Count(); }
    override int ValueAt(int s, int i) { return this.series[s].Value(i); }
}

/// ChartView 渲染器共享的绘图工具：颜色、比例辅助、
/// 面板/图例框架、dataZoom 滑块、标记线/区域、直角坐标系和
/// 双轴坐标构建器。一次性的静态渲染器（Chart.Line/
/// Bar/Pie/...）已移除——所有图表现在声明为 ChartOption
/// 并由 ChartView 绘制。
class Chart {

    // ---- 颜色 ----

    // 不透明 0xFFRRGGBB 打包为正 int（Canvas 转为 u32）。
    static int Rgb(int r, int g, int b) {
        return (int)4278190080 + r * 65536 + g * 256 + b;
    }

    // 与打包不透明颜色相同的 RGB，但带自定义 alpha（用于面积填充）。
    static int WithAlpha(int packed, int a) {
        return (packed - (int)4278190080) + a * 16777216;
    }

    // ECharts 的默认定性调色板。
    static int Palette(Theme t, int i) {
        int m = i % 8;
        if (m == 0) { return Chart.Rgb(84, 112, 198); }   // 蓝色
        if (m == 1) { return Chart.Rgb(145, 204, 117); }  // 绿色
        if (m == 2) { return Chart.Rgb(250, 200, 88); }   // 黄色
        if (m == 3) { return Chart.Rgb(238, 102, 102); }  // 红色
        if (m == 4) { return Chart.Rgb(115, 192, 222); }  // 青色
        if (m == 5) { return Chart.Rgb(59, 162, 114); }   // 青绿色
        if (m == 6) { return Chart.Rgb(252, 132, 82); }   // 橙色
        return Chart.Rgb(154, 96, 180);                    // 紫色
    }

    // ---- 比例辅助 ----

    // 将原始最大值向上取整为友好的轴边界（2/5/10 * 10^n）。
    static int NiceMax(int v) {
        if (v <= 5) { return 5; }
        int mag = 1;
        while (mag * 10 <= v) { mag = mag * 10; }
        int unit = v / mag;
        int nice = 10;
        if (unit < 2) { nice = 2; } else if (unit < 5) { nice = 5; }
        return nice * mag;
    }

    static int MaxOf(List<ChartSeries> series) {
        int mx = 0;
        for (int i = 0; i < series.Count; i = i + 1) {
            ChartSeries s = series[i];
            for (int j = 0; j < s.Count(); j = j + 1) { if (s.Value(j) > mx) { mx = s.Value(j); } }
        }
        return mx;
    }

    // 仅索引窗口 [i0,i1]（含端点）内的最大值，供 dataZoom
    // 的索引视图使用（渲染循环直接读原系列，不做有损克隆）。
    static int MaxOfWindow(List<ChartSeries> series, int i0, int i1) {
        int mx = 0;
        for (int i = 0; i < series.Count; i = i + 1) {
            ChartSeries s = series[i];
            int j = i0;
            while (j <= i1 && j < s.Count()) {
                if (s.Value(j) > mx) { mx = s.Value(j); }
                j = j + 1;
            }
        }
        return mx;
    }

    // 各分类中的最大堆叠总量（用于堆叠柱状图）。
    // 共享 stackName 的系列堆叠在一起；轴适配最高的组，
    // 使多组堆叠柱（ECharts `stack` 组）正确缩放。
    static int MaxStack(List<ChartSeries> series, int n) {        List<string> grp = new List<string>();
        for (int g = 0; g < series.Count; g = g + 1) {
            ChartSeries cs = series[g];
            if (!ChartView.IsLineFamily(cs.type)) {
                bool found = false;
                for (int gi = 0; gi < grp.Count; gi = gi + 1) {
                    if (grp[gi] == cs.stackName) { found = true; }
                }
                if (!found) { grp.Add(cs.stackName); }
            }
        }
        int ng = grp.Count;
        if (ng < 1) { ng = 1; }
        int mx = 0;
        for (int i = 0; i < n; i = i + 1) {
            for (int gi = 0; gi < ng; gi = gi + 1) {
                int sum = 0;
                for (int s = 0; s < series.Count; s = s + 1) {
                    ChartSeries cs = series[s];
                    if (!ChartView.IsLineFamily(cs.type) && cs.stackName == grp[gi]) {
                        if (i < cs.Count()) { sum = sum + cs.Value(i); }
                    }
                }
                if (sum > mx) { mx = sum; }
            }
        }
        return mx;
    }

    // MaxStack 的索引窗口版：仅累计分类 j + i0（j 在 [0,n)）。
    static int MaxStackW(List<ChartSeries> series, int n, int i0) {
        List<string> grp = new List<string>();
        for (int g = 0; g < series.Count; g = g + 1) {
            ChartSeries cs = series[g];
            if (!ChartView.IsLineFamily(cs.type)) {
                bool found = false;
                for (int gi = 0; gi < grp.Count; gi = gi + 1) {
                    if (grp[gi] == cs.stackName) { found = true; }
                }
                if (!found) { grp.Add(cs.stackName); }
            }
        }
        int ng = grp.Count;
        if (ng < 1) { ng = 1; }
        int mx = 0;
        for (int i = 0; i < n; i = i + 1) {
            int oi = i0 + i;
            for (int gi = 0; gi < ng; gi = gi + 1) {
                int sum = 0;
                for (int s = 0; s < series.Count; s = s + 1) {
                    ChartSeries cs = series[s];
                    if (!ChartView.IsLineFamily(cs.type) && cs.stackName == grp[gi]) {
                        if (oi < cs.Count()) { sum = sum + cs.Value(oi); }
                    }
                }
                if (sum > mx) { mx = sum; }
            }
        }
        return mx;
    }

    // 所有系列堆叠成一条带时的最大累计总量（堆叠面积图
    // / 堆叠折线图：系列按顺序累加，与 stackName 无关）。
    // 隐藏的系列（图例关闭）被跳过，因此隐藏一个系列
    // 会重设轴范围，剩余条带正确重新堆叠。
    static int MaxStackAll(List<ChartSeries> series, int n) {
        int mx = 0;
        for (int i = 0; i < n; i = i + 1) {
            int sum = 0;
            for (int s = 0; s < series.Count; s = s + 1) {
                ChartSeries cs = series[s];
                if (!cs.hidden && i < cs.Count()) { sum = sum + cs.Value(i); }
            }
            if (sum > mx) { mx = sum; }
        }
        return mx;
    }

    // MaxStackAll 的索引窗口版：仅累计分类 j + i0。
    static int MaxStackAllW(List<ChartSeries> series, int n, int i0) {
        int mx = 0;
        for (int i = 0; i < n; i = i + 1) {
            int oi = i0 + i;
            int sum = 0;
            for (int s = 0; s < series.Count; s = s + 1) {
                ChartSeries cs = series[s];
                if (!cs.hidden && oi < cs.Count()) { sum = sum + cs.Value(oi); }
            }
            if (sum > mx) { mx = sum; }
        }
        return mx;
    }

    static int MaxInt(List<int> vs) {
        int mx = 0;
        for (int i = 0; i < vs.Count; i = i + 1) { if (vs[i] > mx) { mx = vs[i]; } }
        return mx;
    }

    // ---- 几何 ----

    // 整数 point-in-polygon（射线法，even-odd），无除法/浮点。
    // 半开约定：py >= 顶点 y 视为在射线之上，每条边最多计一次
    // 穿越；交点侧由叉积符号结合边方向判定。点在边界上属边缘
    // 情形，结果不保证——由命中层的 bbox 容差吸收。
    static bool PointInPoly(List<ChartMapPoint> poly, int px, int py) {
        int n = poly.Count;
        if (n < 3) { return false; }
        bool inside = false;
        int j = n - 1;
        for (int i = 0; i < n; i = i + 1) {
            ChartMapPoint pi = poly[i];
            ChartMapPoint pj = poly[j];
            if ((py >= pi.y) != (py >= pj.y)) {
                int cross = (pi.x - pj.x) * (py - pj.y) - (pi.y - pj.y) * (px - pj.x);
                if ((cross > 0) == (pi.y > pj.y)) { inside = !inside; }
            }
            j = i;
        }
        return inside;
    }

    // ---- 轴类型：Time / Log ----

    // 10 的整数对数（floor log10），仅正值（v < 1 → 0）。
    static int Log10(int v) {
        if (v < 1) { return 0; }
        int e = 0;
        int p = 1;
        while (p * 10 <= v) { p = p * 10; e = e + 1; }
        return e;
    }

    // 对数轴刻度：lo/hi 边界 + 中间的 10 的幂（去重）。
    static List<int> LogTicks(int lo, int hi) {
        if (hi < lo) { int tmp = lo; lo = hi; hi = tmp; }
        if (lo < 1) { lo = 1; }
        if (hi < lo) { hi = lo; }
        List<int> ts = new List<int>();
        ts.Add(lo);
        int p = 1;
        while (p * 10 <= hi) {
            p = p * 10;
            if (p > lo) { ts.Add(p); }
        }
        if (ts[ts.Count - 1] != hi) { ts.Add(hi); }
        return ts;
    }

    // 从整数天数生成确定性短日期 "YYYY-MM-DD"（非闰年，纯表驱动，
    // 无系统时间依赖）。t = 0 是 1970-01-01。
    static string TimeLabel(int t) {
        if (t < 0) { t = 0; }
        int year = 1970 + t / 365;
        int doy = t % 365;
        List<int> md = new List<int>{31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31};
        int month = 0;
        while (month < 11 && doy >= md[month]) {
            doy = doy - md[month];
            month = month + 1;
        }
        string mm = Convert.ToString(month + 1);
        if (mm.Length < 2) { mm = "0" + mm; }
        string dd = Convert.ToString(doy + 1);
        if (dd.Length < 2) { dd = "0" + dd; }
        return Convert.ToString(year) + "-" + mm + "-" + dd;
    }

    // 时间轴刻度：从 {1,2,5}×10^n 阶梯选步长，使
    // (t1-t0)/step ≤ maxTicks-1；生成 t0 起等距点，
    // 末点不落在网格上则补 t1。
    static List<int> TimeTicks(int t0, int t1, int maxTicks) {
        if (t1 < t0) { int tmp = t0; t0 = t1; t1 = tmp; }
        if (maxTicks < 2) { maxTicks = 2; }
        int span = t1 - t0;
        int step = 1;
        while (true) {
            if (span / step + 1 <= maxTicks) { break; }
            int mag = 1;
            while (step >= mag * 10) { mag = mag * 10; }
            int unit = step / mag;
            if (unit == 1) { step = 2 * mag; }
            else if (unit == 2) { step = 5 * mag; }
            else { step = 10 * mag; }
        }
        List<int> ts = new List<int>();
        for (int t = t0; t <= t1; t = t + step) { ts.Add(t); }
        if (ts[ts.Count - 1] != t1) { ts.Add(t1); }
        return ts;
    }

    // 固定小数位数的确定性格式化（四舍五入，无浮点打印依赖）。
    static string FormatFixed(double v, int precision) {
        if (precision < 0) { precision = 0; }
        if (precision > 4) { precision = 4; }
        int scale = 1;
        for (int i = 0; i < precision; i = i + 1) { scale = scale * 10; }
        bool neg = false;
        double av = v;
        if (av < 0) { neg = true; av = 0 - av; }
        int scaled = (int)(av * (double)scale + 0.5);
        int ip = scaled / scale;
        string s = Convert.ToString(ip);
        if (precision > 0) {
            int frac = scaled % scale;
            string fs = Convert.ToString(frac);
            while (fs.Length < precision) { fs = "0" + fs; }
            s = s + "." + fs;
        }
        if (neg) { s = "-" + s; }
        return s;
    }

    // ---- 共享框架 ----

    // 面板背景 + 标题 + 图例色块。返回标题/图例带
    // 下方紧邻的 y，调用方可在其下布局绘图区。
    static int DrawPanel(App app, int x, int y, int w, int h, string title,
                         List<ChartSeries> series, bool showLegend) {
        return Chart.DrawPanelI(app, x, y, w, h, title, series, 0, showLegend);
    }

    // 交互 id `wid` 下系列 `si` 的图例隐藏状态键。
    static int LegendKey(int wid, int si) { return 6000000 + wid * 64 + si; }

    // dataZoom 窗口状态键（分类范围的千分值 0..1000）。
    static int ZoomLoKey(int wid) { return 7000000 + wid * 2; }
    static int ZoomHiKey(int wid) { return 7000000 + wid * 2 + 1; }
    static int TreePanXKey(int wid) { return 8000000 + wid * 8; }
    static int TreePanYKey(int wid) { return 8000000 + wid * 8 + 1; }
    static int TreeDragXKey(int wid) { return 8000000 + wid * 8 + 2; }
    static int TreeDragYKey(int wid) { return 8000000 + wid * 8 + 3; }
    static int TreeDragPanXKey(int wid) { return 8000000 + wid * 8 + 4; }
    static int TreeDragPanYKey(int wid) { return 8000000 + wid * 8 + 5; }
    static int TreeDraggingKey(int wid) { return 8000000 + wid * 8 + 6; }
    // 树缩放，为自然节点间距的百分比。0 表示"未设置
    // "：首帧将整棵树适配进绘图区，
    // 而不是在超大布局的角落打开。
    static int TreeZoomKey(int wid) { return 8000000 + wid * 8 + 7; }

    // 快照槽位的 RenderCache 指纹键（见 ChartView.RenderCached）。
    static int CacheKey(int slot) { return 9000000 + slot; }

    // 将缩放窗口解析为包含端点的分类索引范围 [i0,i1]。
    static int ZoomI0(App app, ChartOption o, int wid, int n) {
        int lo = app.StateGet(Chart.ZoomLoKey(wid), 0 - 1);
        if (lo < 0) {
            lo = o.zoomStart * 10;
            app.StateSet(Chart.ZoomLoKey(wid), lo);
        }
        int i0 = lo * (n - 1) / 1000;
        if (i0 < 0) { i0 = 0; }
        if (i0 > n - 1) { i0 = n - 1; }
        return i0;
    }
    static int ZoomI1(App app, ChartOption o, int wid, int n) {
        int hi = app.StateGet(Chart.ZoomHiKey(wid), 0 - 1);
        if (hi < 0) {
            hi = o.zoomEnd * 10;
            app.StateSet(Chart.ZoomHiKey(wid), hi);
        }
        int i1 = hi * (n - 1) / 1000;
        if (i1 < 0) { i1 = 0; }
        if (i1 > n - 1) { i1 = n - 1; }
        return i1;
    }

    // 将标签窗口化为包含端点的索引范围 [i0,i1]（仅字符串
    // 拷贝；渲染器对系列值也按同一 [i0,i1] 直接读原系列，
    // 避免有损的系列克隆丢失 itemStyle/marks 等字段）。
    static List<string> WindowLabels(List<string> labels, int i0, int i1) {
        List<string> outp = new List<string>();
        int i = i0;
        while (i <= i1 && i < labels.Count) { outp.Add(labels[i]); i = i + 1; }
        return outp;
    }

    // 绘制 dataZoom 范围滑块并处理手柄拖拽。两个手柄设定
    // 窗口边界（千分值）；拖动选中的带可平移。
    // 窗口状态以 wid 为键持久化在 App 状态映射中。
    static void DrawZoomBar(App app, int plotX, int plotW, int barY, int barH,
                            int wid, int n) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        if (plotW < 4 || n < 2) { return; }

        int lo = app.StateGet(Chart.ZoomLoKey(wid), 0);
        int hi = app.StateGet(Chart.ZoomHiKey(wid), 1000);

        int hw = app.Scale(6);
        int loX = plotX + lo * plotW / 1000;
        int hiX = plotX + hi * plotW / 1000;

        // 轨道 + 选中窗口
        c.FillRoundRect(plotX, barY, plotW, barH, t.borderRadiusSmall, t.bgSecondary);
        c.FillRect(loX, barY, hiX - loX, barH, t.bgHover);
        c.DrawRect(loX, barY, hiX - loX, barH, t.borderHover, 1);

        // 手柄
        c.FillRoundRect(loX - hw, barY, hw * 2, barH, t.borderRadiusSmall, t.primary);
        c.FillRoundRect(hiX - hw, barY, hw * 2, barH, t.borderRadiusSmall, t.primary);

        int loId = app.focus.AllocId();
        int hiId = app.focus.AllocId();
        int bandId = app.focus.AllocId();
        app.hitTester.Register(new HitRegion(loId, loX - hw, barY, hw * 2, barH, 3));
        app.hitTester.Register(new HitRegion(hiId, hiX - hw, barY, hw * 2, barH, 3));
        app.hitTester.Register(new HitRegion(bandId, loX + hw, barY, hiX - loX - hw * 2, barH, 3));

        int mxPm = (app.mouseX - plotX) * 1000 / plotW;
        if (mxPm < 0) { mxPm = 0; }
        if (mxPm > 1000) { mxPm = 1000; }
        int minGap = 1000 / (n - 1);
        if (minGap < 20) { minGap = 20; }

        if (Ui.Pressed(app, loId)) {
            lo = mxPm;
            if (lo > hi - minGap) { lo = hi - minGap; }
            if (lo < 0) { lo = 0; }
            app.StateSet(Chart.ZoomLoKey(wid), lo);
            app.RequestRedraw();
        } else if (Ui.Pressed(app, hiId)) {
            hi = mxPm;
            if (hi < lo + minGap) { hi = lo + minGap; }
            if (hi > 1000) { hi = 1000; }
            app.StateSet(Chart.ZoomHiKey(wid), hi);
            app.RequestRedraw();
        } else if (Ui.Pressed(app, bandId)) {
            // 平移：保持带宽，以指针为中心
            int width = hi - lo;
            int nlo = mxPm - width / 2;
            if (nlo < 0) { nlo = 0; }
            if (nlo + width > 1000) { nlo = 1000 - width; }
            app.StateSet(Chart.ZoomLoKey(wid), nlo);
            app.StateSet(Chart.ZoomHiKey(wid), nlo + width);
            app.RequestRedraw();
        }
    }

    // 面板 + 交互式图例。wid != 0 时每个色块是一个命中区域：
    // 点击切换该系列的可见性（以 wid 为键持久化在
    // App 状态映射中），解析后的隐藏标志写入帧内系列
    // 快照，所有下游渲染器都会跳过它。隐藏的系列
    // 以变暗 + 删除线绘制，以便可以恢复显示。
    // showLegend=false 时既绘制也不解析隐藏状态——
    // 图例关闭时系列恒为可见，避免状态残留让图无声消失。
    static int DrawPanelI(App app, int x, int y, int w, int h, string title,
                          List<ChartSeries> series, int wid, bool showLegend) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int pad = t.paddingMedium;

        c.SurfaceRoundRect(x, y, w, h, t.borderRadiusMedium, t.bgPrimary, t.borderPrimary, 1);

        int top = y + pad;
        if (title.Length > 0) {
            c.DrawText(x + pad, top, title, t.textPrimary, t.fontSizeLarge);
        }

        if (showLegend) {
        // 图例（右上角），每系列一个色块 + 名称，从右到左
        int lx = x + w - pad;
        int sw = app.Scale(12);
        int lgY = y + pad;
        int si = series.Count - 1;
        while (si >= 0) {
            // 先解析持久化的可见性，使图例和
            // 绘图在本帧达成一致。
            bool hid = series[si].hidden;
            if (wid != 0) {
                hid = app.StateGet(Chart.LegendKey(wid, si), hid ? 1 : 0) == 1;
            }

            string nm = series[si].name;
            int tw = Canvas.MeasureText(nm, t.fontSizeSmall);
            int rowLeft = lx - tw - app.Scale(6) - sw;
            int swatchX = lx - tw - app.Scale(6) - sw;

            int txtCol = t.textSecondary;
            int swCol = series[si].color;
            if (hid) { txtCol = t.textTertiary; swCol = t.borderPrimary; }

            c.DrawText(lx - tw, lgY + app.Scale(2), nm, txtCol, t.fontSizeSmall);
            c.FillRoundRect(swatchX, lgY + app.Scale(3), sw, sw, t.borderRadiusSmall, swCol);
            if (hid) {
                int my = lgY + app.Scale(2) + Canvas.FontHeight(t.fontSizeSmall) / 2;
                c.FillRect(lx - tw, my, tw, 1, t.textTertiary);
            }

            if (wid != 0) {
                int hitId = app.focus.AllocId();
                app.hitTester.Register(new HitRegion(hitId, rowLeft,
                    lgY, (lx) - rowLeft, sw + app.Scale(4), 3));
                if (Ui.Clicked(app, hitId)) {
                    int nv = 1;
                    if (hid) { nv = 0; }
                    app.StateSet(Chart.LegendKey(wid, si), nv);
                    hid = (nv == 1);
                    app.RequestRedraw();
                }
            }

            series[si].hidden = hid;
            lx = rowLeft - app.Scale(14);
            si = si - 1;
        }
        }

        return top + Canvas.FontHeight(t.fontSizeLarge) + app.Scale(6);
    }

    // 左轴上的阴影 markArea 带 [markLo, markHi]（绘制在
    // 系列之下）。两个边界未全部设置时为空操作。
    static void DrawMarkArea(App app, ChartFrame f, ChartOption o) {
        if (o.markLo == ChartOption.Auto() || o.markHi == ChartOption.Auto()) { return; }
        Canvas c = app.canvas;
        Theme t = app.theme;
        int y0 = f.YOf(o.markHi, 0);
        int y1 = f.YOf(o.markLo, 0);
        if (y1 < y0) { int tmp = y0; y0 = y1; y1 = tmp; }
        c.FillRect(f.plotX, y0, f.plotW, y1 - y0, Chart.WithAlpha(t.primary, 28));
    }

    // 左轴 markLine 处的水平阈值线，带可选的
    // 右对齐标签（绘制在系列之上）。
    static void DrawMarkLine(App app, ChartFrame f, ChartOption o) {
        if (o.markLine == ChartOption.Auto()) { return; }
        Canvas c = app.canvas;
        Theme t = app.theme;
        int my = f.YOf(o.markLine, 0);
        // 虚线
        int dx = f.plotX;
        int dash = app.Scale(6);
        while (dx < f.plotX + f.plotW) {
            int seg = dash;
            if (dx + seg > f.plotX + f.plotW) { seg = f.plotX + f.plotW - dx; }
            c.FillRect(dx, my, seg, 1, t.error);
            dx = dx + dash * 2;
        }
        if (o.markLabel.Length > 0) {
            int fs = t.fontSizeSmall;
            int lw = Canvas.MeasureText(o.markLabel, fs);
            c.DrawText(f.plotX + f.plotW - lw, my - Canvas.FontHeight(fs) - app.Scale(1),
                o.markLabel, t.error, fs);
        }
    }

    // 带数值网格线（左）+ 分类标签（底部）的直角坐标系框架。
    static ChartFrame DrawFrame(App app, int x, int y, int w, int h, int plotTop,
                                List<string> labels, int maxV) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int pad = t.paddingMedium;
        int axisFs = t.fontSizeSmall;

        int leftGut = Canvas.MeasureText(Convert.ToString(maxV), axisFs) + app.Scale(12);
        int botGut = Canvas.FontHeight(axisFs) + app.Scale(8);

        int plotX = x + pad + leftGut;
        int plotY = plotTop;
        int plotW = (x + w - pad) - plotX;
        int plotH = (y + h - pad - botGut) - plotY;
        if (plotW < app.Scale(20)) { plotW = app.Scale(20); }
        if (plotH < app.Scale(20)) { plotH = app.Scale(20); }

        int ticks = 5;
        for (int k = 0; k <= ticks; k = k + 1) {
            int gy = plotY + plotH - (k * plotH / ticks);
            c.FillRect(plotX, gy, plotW, 1, t.divider);
            int val = maxV * k / ticks;
            string vs = Convert.ToString(val);
            int vw = Canvas.MeasureText(vs, axisFs);
            c.DrawText(plotX - app.Scale(6) - vw, Canvas.CenterTextYAt(gy, axisFs), vs, t.textTertiary, axisFs);
        }
        c.FillRect(plotX, plotY, 1, plotH, t.borderSecondary);
        c.FillRect(plotX, plotY + plotH, plotW, 1, t.borderSecondary);

        int n = labels.Count;
        if (n > 0) {
            int step = plotW / n;
            for (int ci = 0; ci < n; ci = ci + 1) {
                int cxs = plotX + ci * step;
                c.DrawTextCentered(cxs, plotY + plotH + app.Scale(4), step, botGut, labels[ci], t.textTertiary, axisFs);
            }
        }

        ChartFrame f = new ChartFrame();
        f.plotX = plotX;
        f.plotY = plotY;
        f.plotW = plotW;
        f.plotH = plotH;
        return f;
    }

    // 在显式数值范围 [lo, hi] 上的直角坐标系框架（支持非零
    // 基线/负数），用于蜡烛图、箱线图和误差图。
    static ChartFrame DrawFrameLoHi(App app, int x, int y, int w, int h, int plotTop,
                                    List<string> labels, int lo, int hi) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int pad = t.paddingMedium;
        int axisFs = t.fontSizeSmall;
        if (hi <= lo) { hi = lo + 1; }

        int gw0 = Canvas.MeasureText(Convert.ToString(hi), axisFs);
        int gw1 = Canvas.MeasureText(Convert.ToString(lo), axisFs);
        int leftGut = gw0;
        if (gw1 > leftGut) { leftGut = gw1; }
        leftGut = leftGut + app.Scale(12);
        int botGut = Canvas.FontHeight(axisFs) + app.Scale(8);

        int plotX = x + pad + leftGut;
        int plotY = plotTop;
        int plotW = (x + w - pad) - plotX;
        int plotH = (y + h - pad - botGut) - plotY;
        if (plotW < app.Scale(20)) { plotW = app.Scale(20); }
        if (plotH < app.Scale(20)) { plotH = app.Scale(20); }

        int span = hi - lo;
        int ticks = 5;
        for (int k = 0; k <= ticks; k = k + 1) {
            int gy = plotY + plotH - (k * plotH / ticks);
            c.FillRect(plotX, gy, plotW, 1, t.divider);
            int val = lo + span * k / ticks;
            string vs = Convert.ToString(val);
            int vw = Canvas.MeasureText(vs, axisFs);
            c.DrawText(plotX - app.Scale(6) - vw, Canvas.CenterTextYAt(gy, axisFs), vs, t.textTertiary, axisFs);
        }
        c.FillRect(plotX, plotY, 1, plotH, t.borderSecondary);
        c.FillRect(plotX, plotY + plotH, plotW, 1, t.borderSecondary);

        int n = labels.Count;
        if (n > 0) {
            int step = plotW / n;
            for (int ci = 0; ci < n; ci = ci + 1) {
                int cxs = plotX + ci * step;
                c.DrawTextCentered(cxs, plotY + plotH + app.Scale(4), step, botGut, labels[ci], t.textTertiary, axisFs);
            }
        }

        ChartFrame f = new ChartFrame();
        f.plotX = plotX;
        f.plotY = plotY;
        f.plotW = plotW;
        f.plotH = plotH;
        return f;
    }

    // ---- 坐标系（双轴 + 友好刻度 + 标题）----

    // 绑定到给定数值轴的（可见）系列中的最大值。
    static int AxisMaxFor(List<ChartSeries> series, int axisIndex) {
        int mx = 0;
        for (int i = 0; i < series.Count; i = i + 1) {
            ChartSeries s = series[i];
            if (!s.hidden && s.axisIndex == axisIndex) {
                for (int j = 0; j < s.Count(); j = j + 1) { if (s.Value(j) > mx) { mx = s.Value(j); } }
            }
        }
        return mx;
    }

    // 绑定到给定数值轴的（可见）系列中的最小值
    // （无负数时为 0），使轴天然覆盖负数。
    static int AxisMinFor(List<ChartSeries> series, int axisIndex) {
        int mn = 0;
        for (int i = 0; i < series.Count; i = i + 1) {
            ChartSeries s = series[i];
            if (!s.hidden && s.axisIndex == axisIndex) {
                for (int j = 0; j < s.Count(); j = j + 1) { if (s.Value(j) < mn) { mn = s.Value(j); } }
            }
        }
        return mn;
    }

    static bool AnyOnAxis(List<ChartSeries> series, int axisIndex) {
        for (int i = 0; i < series.Count; i = i + 1) {
            if (!series[i].hidden && series[i].axisIndex == axisIndex) { return true; }
        }
        return false;
    }

    // 将原始最小值向下取整为友好的负轴边界（2/5/10 * 10^n）；
    // 没有负数需要覆盖时返回 0。
    static int NiceMin(int v) {
        if (v >= 0) { return 0; }
        int av = 0 - v;
        if (av <= 5) { return 0 - 5; }
        int mag = 1;
        while (mag * 10 <= av) { mag = mag * 10; }
        int unit = av / mag;
        int nice = 10;
        if (unit < 2) { nice = 2; } else if (unit < 5) { nice = 5; }
        return 0 - nice * mag;
    }

    // 从数据 + 固定覆盖解析单个数值轴的 [lo, hi] 范围。
    // 有负值时下界自动扩展到 0 以下。
    static int AxisLo(int fixedLo, int dataMin) {
        if (fixedLo != ChartOption.Auto()) { return fixedLo; }
        return Chart.NiceMin(dataMin);
    }
    static int AxisHi(int fixedHi, int dataMax, int lo) {
        int hi = Chart.NiceMax(dataMax);
        if (fixedHi != ChartOption.Auto()) { hi = fixedHi; }
        if (hi <= lo) { hi = lo + 1; }
        return hi;
    }

    // [lo, hi] 范围分成 `ticks` 步时最宽的刻度标签（像素）。
    static int TickLabelW(int lo, int hi, int ticks, int fs) {
        int span = hi - lo;
        int wmax = 0;
        for (int k = 0; k <= ticks; k = k + 1) {
            int val = lo + span * k / ticks;
            int lw = Canvas.MeasureText(Convert.ToString(val), fs);
            if (lw > wmax) { wmax = lw; }
        }
        return wmax;
    }

    // 完整直角坐标系：左（+ 可选右）数值轴，
    // 友好刻度 / 固定边界 / 翻转、分类（或数值）x 轴、
    // 网格内边距覆盖和轴标题。返回携带两个轴范围的
    // ChartFrame，所有渲染器通过 f.YOf(v, axisIndex) 映射数值。
    static ChartFrame BuildAxes(App app, int x, int y, int w, int h, int plotTop,
                                List<string> labels, ChartOption o, List<ChartSeries> series) {
        return Chart.BuildAxesR(app, x, y, w, h, plotTop, labels, o, series, 0 - 1, 0 - 1);
    }

    // 同 BuildAxes，但左/右轴使用显式数据最大值
    // （-1 = 从系列逐点推导）；堆叠图传入堆叠总和。
    static ChartFrame BuildAxesR(App app, int x, int y, int w, int h, int plotTop,
                                 List<string> labels, ChartOption o, List<ChartSeries> series,
                                 int leftDataMax, int rightDataMax) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int pad = t.paddingMedium;
        int fs = t.fontSizeSmall;
        int fh = Canvas.FontHeight(fs);
        ChartAxis y0 = o.YAxis0();
        ChartAxis y1 = o.YAxis1();
        ChartAxis x0 = o.XAxis0();
        int ticks = y0.ticks;
        if (ticks < 1) { ticks = 5; }

        int lData = leftDataMax;
        if (lData < 0) { lData = Chart.AxisMaxFor(series, 0); }
        int leftLo = Chart.AxisLo(y0.min, Chart.AxisMinFor(series, 0));
        int leftHi = Chart.AxisHi(y0.max, lData, leftLo);
        bool hasRight = Chart.AnyOnAxis(series, 1);
        if (o.yAxes.Count > 1) { hasRight = true; }
        int rightLo = 0;
        int rightHi = 1;
        if (hasRight) {
            int rData = rightDataMax;
            if (rData < 0) { rData = Chart.AxisMaxFor(series, 1); }
            rightLo = Chart.AxisLo(y1.min, Chart.AxisMinFor(series, 1));
            rightHi = Chart.AxisHi(y1.max, rData, rightLo);
        }

        // 对数轴：仅正值，钳制下界到 ≥1（log10 对 ≤0 无定义）。
        bool leftLog = y0.type == ChartAxisType.Log;
        if (leftLog) {
            if (leftLo < 1) { leftLo = 1; }
            if (leftHi < leftLo + 1) { leftHi = leftLo + 1; }
        }
        bool rightLog = hasRight && y1.type == ChartAxisType.Log;
        if (rightLog) {
            if (rightLo < 1) { rightLo = 1; }
            if (rightHi < rightLo + 1) { rightHi = rightLo + 1; }
        }
        // 时间 X 轴：整数天数范围（Auto → 0..n-1）。
        bool isTime = x0.type == ChartAxisType.Time;
        int tMin = x0.min;
        int tMax = x0.max;
        if (tMin == ChartOption.Auto()) { tMin = 0; }
        if (tMax == ChartOption.Auto()) {
            tMax = labels.Count - 1;
            if (tMax < tMin + 1) { tMax = tMin + 1; }
        }

        int leftGut = Chart.TickLabelW(leftLo, leftHi, ticks, fs) + app.Scale(12);
        int rightGut = pad;
        if (hasRight) { rightGut = Chart.TickLabelW(rightLo, rightHi, ticks, fs) + app.Scale(12); }
        int botGut = fh + app.Scale(8);
        if (x0.title.Length > 0) { botGut = botGut + fh + app.Scale(2); }
        int topGut = 0;
        if (y0.title.Length > 0 || y1.title.Length > 0) { topGut = fh + app.Scale(2); }

        int plotX = x + pad + leftGut;
        if (o.gridLeft >= 0) { plotX = x + app.Scale(o.gridLeft); }
        int plotY = plotTop + topGut;
        if (o.gridTop >= 0) { plotY = y + app.Scale(o.gridTop); }
        int plotRight = x + w - rightGut;
        if (o.gridRight >= 0) { plotRight = x + w - app.Scale(o.gridRight); }
        int plotBot = y + h - pad - botGut;
        if (o.gridBottom >= 0) { plotBot = y + h - app.Scale(o.gridBottom); }
        int plotW = plotRight - plotX;
        int plotH = plotBot - plotY;
        if (plotW < app.Scale(20)) { plotW = app.Scale(20); }
        if (plotH < app.Scale(20)) { plotH = app.Scale(20); }

        ChartFrame f = new ChartFrame();
        f.plotX = plotX;
        f.plotY = plotY;
        f.plotW = plotW;
        f.plotH = plotH;
        f.leftMin = leftLo;
        f.leftMax = leftHi;
        f.rightMin = rightLo;
        f.rightMax = rightHi;
        f.hasRight = hasRight;
        f.reversed = y0.reversed;
        f.rightReversed = y1.reversed;
        f.leftLog = leftLog;
        f.rightLog = rightLog;
        f.isTime = isTime;
        f.timeMin = tMin;
        f.timeMax = tMax;

        // 网格线 + 左右数值标签（对数轴用 10 的幂刻度）
        bool grid = o.showGrid && y0.showGrid;
        if (leftLog) {
            List<int> lts = Chart.LogTicks(leftLo, leftHi);
            for (int li = 0; li < lts.Count; li = li + 1) {
                int lv = lts[li];
                int gy = f.YOfLog(lv, 0);
                if (grid) { c.FillRect(plotX, gy, plotW, 1, t.divider); }
                string ls = Convert.ToString(lv);
                int lw = Canvas.MeasureText(ls, fs);
                c.DrawText(plotX - app.Scale(6) - lw, gy - fh / 2, ls, t.textTertiary, fs);
            }
        } else {
            int leftSpan = leftHi - leftLo;
            for (int k = 0; k <= ticks; k = k + 1) {
                int lv = leftLo + leftSpan * k / ticks;
                int gy = f.YOf(lv, 0);
                if (grid) { c.FillRect(plotX, gy, plotW, 1, t.divider); }
                string ls = Convert.ToString(lv);
                int lw = Canvas.MeasureText(ls, fs);
                c.DrawText(plotX - app.Scale(6) - lw, gy - fh / 2, ls, t.textTertiary, fs);
            }
        }
        if (hasRight) {
            if (rightLog) {
                List<int> rts = Chart.LogTicks(rightLo, rightHi);
                for (int ri = 0; ri < rts.Count; ri = ri + 1) {
                    int rv = rts[ri];
                    int gy = f.YOfLog(rv, 1);
                    c.DrawText(plotRight + app.Scale(6), gy - fh / 2,
                        Convert.ToString(rv), t.textTertiary, fs);
                }
            } else {
                int rightSpan = rightHi - rightLo;
                for (int k = 0; k <= ticks; k = k + 1) {
                    int rv = rightLo + rightSpan * k / ticks;
                    int gy = f.YOf(rv, 1);
                    c.DrawText(plotRight + app.Scale(6), gy - fh / 2,
                        Convert.ToString(rv), t.textTertiary, fs);
                }
            }
        }
        c.FillRect(plotX, plotY, 1, plotH, t.borderSecondary);
        c.FillRect(plotX, plotY + plotH, plotW, 1, t.borderSecondary);
        if (hasRight) { c.FillRect(plotX + plotW, plotY, 1, plotH, t.borderSecondary); }

        // x 分类标签（时间轴用 TimeLabel 日期刻度）
        int n = labels.Count;
        if (n > 0) {
            if (isTime) {
                List<int> tts = Chart.TimeTicks(tMin, tMax, 6);
                for (int ti = 0; ti < tts.Count; ti = ti + 1) {
                    int tx = f.XOfTime(tts[ti]);
                    string ls = Chart.TimeLabel(tts[ti]);
                    int lw = Canvas.MeasureText(ls, fs);
                    int lx = tx - lw / 2;
                    if (lx < plotX) { lx = plotX; }
                    if (lx + lw <= plotX + plotW) {
                        c.DrawText(lx, plotBot + app.Scale(4), ls, t.textTertiary, fs);
                    }
                }
            } else {
                int step = plotW / n;
                int labelGap = app.Scale(6);
                int labelRight = plotX - labelGap;
                for (int ci = 0; ci < n; ci = ci + 1) {
                    int cxs = plotX + ci * step;
                    int labelW = Canvas.MeasureText(labels[ci], fs);
                    int labelLeft = cxs + (step - labelW) / 2;
                    if (labelLeft < cxs) { labelLeft = cxs; }
                    if (labelLeft >= labelRight + labelGap && labelLeft + labelW <= plotX + plotW) {
                        c.DrawTextCentered(cxs, plotBot + app.Scale(4), step, fh + app.Scale(4), labels[ci], t.textTertiary, fs);
                        labelRight = labelLeft + labelW;
                    }
                }
            }
        }

        // 轴标题
        if (x0.title.Length > 0) {
            c.DrawTextCentered(plotX, plotBot + app.Scale(6) + fh, plotW, fh, x0.title, t.textSecondary, fs);
        }
        if (y0.title.Length > 0) {
            c.DrawText(plotX, plotTop, y0.title, t.textSecondary, fs);
        }
        if (y1.title.Length > 0) {
            int yw = Canvas.MeasureText(y1.title, fs);
            c.DrawText(plotX + plotW - yw, plotTop, y1.title, t.textSecondary, fs);
        }

        return f;
    }
}
