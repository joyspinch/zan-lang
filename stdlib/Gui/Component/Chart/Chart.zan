using System;
using System.Json;
using Gui;

namespace Gui.Component.Chart;

/// 纯 Zan 图表库 —— ECharts 2.2.x 的声明性子集，全部用
/// stdlib 组件与确定性的整数几何绘制，无 JS / DOM / WebView：
///   · 17 种原生 series.type：line / bar / pie / scatter / k /
///     radar / chord / force / map / gauge / funnel / eventRiver /
///     treemap / tree / wordCloud / heatmap，外加 custom kind
///     （sankey / box / error / waterfall / sunburst / radialBars /
///     venn）。
///   · 轴：category / value / time（整数天数，表格驱动日期）/
///     log（仅正值、10 的幂刻度），独立左右轴 min/max/reversed。
///   · 交互：hover tooltip、图例切换可见性、dataZoom 窗口、
///     markLine / markPoint / markArea、emphasis（hover）paint。
///   · 确定性：无随机数、无系统时钟；布局/命中/指纹均为整数运算，
///     conformance 测试可逐值断言。
/// Zan 扩展（超出 ECharts 2.2.x 的便捷 API）：ChartOption.Of /
/// OfRings、ChartSeries.Line / Bar / Area / OfRegions / OfEvents /
/// OfBoxes / OfErrors / OfPoints、pieRings 嵌套环、eventRiver 由
/// 数值系列驱动（按类别索引映射时间）、图表数据用 List<int> /
/// ChartData 直接表达。
/// 渲染由 ChartView（partial）分发到每类一个渲染器；所有绘制走
/// ChartOption -> ResolvedChart -> Canvas 管道。
///
/// 内部持有者：计算出的绘图矩形加上解析后的数值轴
/// 范围（左轴 + 可选右轴），使每个渲染器以相同方式
/// 映射数值 -> 像素。leftMin/leftMax 始终有效；rightMin/rightMax 仅在有右轴时有效。
/// leftLog/rightLog 为对数轴（仅正值）；isTime 为时间 X 轴
/// （整数天数，标签由 Chart.TimeLabel 生成）。
class ChartFrame {
    int plotX;
    int plotY;
    int plotW;
    int plotH;
    int leftMin;
    int leftMax;
    int rightMin;
    int rightMax;
    bool hasRight;
    bool reversed;       // 左轴翻转
    bool rightReversed;  // 右轴翻转（独立于左轴）
    bool leftLog;        // 左轴对数刻度
    bool rightLog;       // 右轴对数刻度
    bool isTime;         // X 轴时间刻度
    int timeMin;
    int timeMax;

    // 第 i 类目左缘。用 i*W/n 而不是固定 step，余数摊到末格，
    // 最后一根柱/最后一个标签贴上绘图区右缘。
    int CatLeft(int i, int n) {
        if (n < 1) { return this.plotX; }
        return this.plotX + i * this.plotW / n;
    }
    int CatWidth(int i, int n) {
        return this.CatLeft(i + 1, n) - this.CatLeft(i, n);
    }
    int CatMid(int i, int n) {
        return this.CatLeft(i, n) + this.CatWidth(i, n) / 2;
    }

    // 左轴（axisIndex 0）或右轴（1）上数值对应的像素 Y，
    // 遵循各轴预设的翻转标志。
    int YOf(int v, int axisIndex) {
        int lo = this.leftMin;
        int hi = this.leftMax;
        bool rev = this.reversed;
        if (axisIndex == 1) { lo = this.rightMin; hi = this.rightMax; rev = this.rightReversed; }
        int span = hi - lo;
        if (span == 0) { span = 1; }
        int d = (v - lo) * this.plotH / span;
        if (rev) { return this.plotY + d; }
        return this.plotY + this.plotH - d;
    }

    // 对数 Y 映射：仅正值（v < 1 钳制到 1），log10 线性化后
    // 按轴范围映射。低于/高于范围钳制在绘图区内。
    int YOfLog(int v, int axisIndex) {
        if (v < 1) { v = 1; }
        int lo = this.leftMin;
        int hi = this.leftMax;
        bool rev = this.reversed;
        if (axisIndex == 1) { lo = this.rightMin; hi = this.rightMax; rev = this.rightReversed; }
        if (lo < 1) { lo = 1; }
        if (hi < lo + 1) { hi = lo + 1; }
        int llo = Chart.Log10(lo);
        int lhi = Chart.Log10(hi);
        if (lhi <= llo) { lhi = llo + 1; }
        int d = (Chart.Log10(v) - llo) * this.plotH / (lhi - llo);
        if (d < 0) { d = 0; }
        if (d > this.plotH) { d = this.plotH; }
        if (rev) { return this.plotY + d; }
        return this.plotY + this.plotH - d;
    }

    // 时间 X 映射：整数时间值 → 像素 x，钳制在绘图区内。
    int XOfTime(int t) {
        int lo = this.timeMin;
        int hi = this.timeMax;
        int span = hi - lo;
        if (span == 0) { span = 1; }
        int d = (t - lo) * this.plotW / span;
        if (d < 0) { d = 0; }
        if (d > this.plotW) { d = this.plotW; }
        return this.plotX + d;
    }
}

/// 图表的虚拟、拉取式数据源——图表无需持有
/// 原始点数组，数百万点的系列也不产生逐单元对象
/// 分配（对应 DataTable 的 DataSource）。子类化它，
/// 按需从自己的列式/类型化存储读取点，或用 SeriesListSource 包装
/// 内存中的 List<ChartSeries>。
class ChartSource {
    virtual int SeriesCount() { return 0; }
    virtual string SeriesName(int s) { return ""; }
    virtual int SeriesColor(int s) { return 0; }   // 0 = 自动（调色板）
    virtual int PointCount(int s) { return 0; }
    virtual int ValueAt(int s, int i) { return 0; }
}

/// 适配器：把已有的 List<ChartSeries> 暴露为 ChartSource，
/// 高性能路径直接接受内存数据，无需重构。
class SeriesListSource : ChartSource {
    List<ChartSeries> series;

    static SeriesListSource Of(List<ChartSeries> series) {
        SeriesListSource s = new SeriesListSource();
        s.series = series;
        return s;
    }

    override int SeriesCount() { return this.series.Count; }
    override string SeriesName(int s) { return this.series[s].name; }
    override int SeriesColor(int s) { return this.series[s].color; }
    override int PointCount(int s) { return this.series[s].Count(); }
    override int ValueAt(int s, int i) { return this.series[s].Value(i); }
}

/// ChartView 渲染器共享的绘图工具：颜色、比例辅助、
/// 面板/图例框架、dataZoom 滑块、标记线/区域、直角坐标系和
/// 双轴坐标构建器。一次性的静态渲染器（Chart.Line/
/// Bar/Pie/...）已移除——所有图表现在声明为 ChartOption
/// 并由 ChartView 绘制。
class Chart {

    // ---- 颜色 ----

    // 不透明 0xFFRRGGBB 打包为正 int（Canvas 转为 u32）。
    static int Rgb(int r, int g, int b) {
        return (int)4278190080 + r * 65536 + g * 256 + b;
    }

    // 与打包不透明颜色相同的 RGB，但带自定义 alpha（用于面积填充）。
    static int WithAlpha(int packed, int a) {
        return (packed - (int)4278190080) + a * 16777216;
    }

    /// 在 `bg` 上对比足够的前景：浅底深字、深底白字。
    /// 饼图扇区 / 地图填色上的标签用它，避免白字画在黄块上。
    static int ContrastFg(int bg) {
        int r = bg >> 16 & 255;
        int g = bg >> 8 & 255;
        int b = bg & 255;
        int lum = (r * 299 + g * 587 + b * 114) / 1000;
        if (lum > 155) { return Chart.Rgb(32, 36, 42); }
        return Chart.Rgb(255, 255, 255);
    }

    // 本帧工具箱占用的右上角宽度；DrawPanelI / PanelHead 让开它。
    static int toolReserve;

    // 多段线性色带插值（visualMap inRange）：t ∈ [0,1000] 均匀映射
    // 到 colors 首尾之间，段内线性混合。colors 少于 2 个时取首色。
    static int RampAt(List<int> colors, int t) {
        int n = colors.Count;
        if (n < 1) { return 0; }
        if (n == 1 || t <= 0) { return colors[0]; }
        if (t >= 1000) { return colors[n - 1]; }
        int seg = (n - 1) * t / 1000;
        int f = ((n - 1) * t) % 1000;
        int a = colors[seg];
        int b = colors[seg + 1];
        int r = (a >> 16 & 255) + ((b >> 16 & 255) - (a >> 16 & 255)) * f / 1000;
        int g = (a >> 8 & 255) + ((b >> 8 & 255) - (a >> 8 & 255)) * f / 1000;
        int bl = (a & 255) + ((b & 255) - (a & 255)) * f / 1000;
        return Chart.Rgb(r, g, bl);
    }

    // 定性调色板：优先取皮肤的 --chart-1 .. --chart-8 token
    // （Theme.chart1..8，0 = 该槽位未定义），缺的槽位回退到
    // ECharts 默认调色板，因此任何皮肤只需定义想要覆盖的色槽。
    static int Palette(Theme t, int i) {
        int m = i % 8;
        if (t != null) {
            if (m == 0 && t.chart1 != 0) { return t.chart1; }
            if (m == 1 && t.chart2 != 0) { return t.chart2; }
            if (m == 2 && t.chart3 != 0) { return t.chart3; }
            if (m == 3 && t.chart4 != 0) { return t.chart4; }
            if (m == 4 && t.chart5 != 0) { return t.chart5; }
            if (m == 5 && t.chart6 != 0) { return t.chart6; }
            if (m == 6 && t.chart7 != 0) { return t.chart7; }
            if (m == 7 && t.chart8 != 0) { return t.chart8; }
        }
        if (m == 0) { return Chart.Rgb(84, 112, 198); }   // 蓝色
        if (m == 1) { return Chart.Rgb(145, 204, 117); }  // 绿色
        if (m == 2) { return Chart.Rgb(250, 200, 88); }   // 黄色
        if (m == 3) { return Chart.Rgb(238, 102, 102); }  // 红色
        if (m == 4) { return Chart.Rgb(115, 192, 222); }  // 青色
        if (m == 5) { return Chart.Rgb(59, 162, 114); }   // 青绿色
        if (m == 6) { return Chart.Rgb(252, 132, 82); }   // 橙色
        return Chart.Rgb(154, 96, 180);                    // 紫色
    }

    // 符号形状族（ECharts series.symbol）：实心圆 / 空心圆（环）/
    // 矩形 / 菱形 / 三角形。r 为外接半径；borderWidth>0 时描边。
    // 菱形/三角用逐扫描线填充（顶点为半宽/半高的整数插值），
    // 与 FillCircle 同为不透明覆盖、无二次混合，指纹稳定。
    static void DrawSymbol(Canvas c, int cx, int cy, int r, string shape,
                           int color, int borderColor, int borderWidth) {
        if (r < 1) { r = 1; }
        if (shape == "rectangle") {
            int d = r * 71 / 100;  // 内接正方形半边（与圆同视觉重量）
            c.FillRect(cx - d, cy - d, d * 2 + 1, d * 2 + 1, color);
        } else if (shape == "diamond") {
            for (int dy = 0 - r; dy <= r; dy = dy + 1) {
                int hw = r - (dy < 0 ? 0 - dy : dy);
                c.FillRect(cx - hw, cy + dy, hw * 2 + 1, 1, color);
            }
        } else if (shape == "triangle") {
            // 上顶点，底边在下：行 r0 距顶点 dy，半宽 = r * dy / r。
            for (int dy = 0 - r; dy <= r; dy = dy + 1) {
                int hw = (r * (dy + r)) / (2 * r);
                if (hw < 0) { hw = 0; }
                c.FillRect(cx - hw, cy + dy, hw * 2 + 1, 1, color);
            }
        } else if (shape == "emptyCircle") {
            int th = r / 2;
            if (th < 1) { th = 1; }
            c.DrawCircle(cx, cy, r, color, th);
        } else {
            c.FillCircle(cx, cy, r, color);
        }
        if (borderWidth > 0 && borderColor != 0) {
            if (shape == "rectangle" || shape == "diamond" || shape == "triangle") {
                List<int> xs = new List<int>();
                List<int> ys = new List<int>();
                if (shape == "rectangle") {
                    int d = r * 71 / 100;
                    xs.Add(cx - d); ys.Add(cy - d);
                    xs.Add(cx + d); ys.Add(cy - d);
                    xs.Add(cx + d); ys.Add(cy + d);
                    xs.Add(cx - d); ys.Add(cy + d);
                } else if (shape == "diamond") {
                    xs.Add(cx); ys.Add(cy - r);
                    xs.Add(cx + r); ys.Add(cy);
                    xs.Add(cx); ys.Add(cy + r);
                    xs.Add(cx - r); ys.Add(cy);
                } else {
                    xs.Add(cx); ys.Add(cy - r);
                    xs.Add(cx + r); ys.Add(cy + r);
                    xs.Add(cx - r); ys.Add(cy + r);
                }
                xs.Add(xs[0]); ys.Add(ys[0]);
                c.DrawPolyline(xs, ys, borderColor, borderWidth);
            } else if (shape == "emptyCircle") {
                c.DrawCircle(cx, cy, r, borderColor, borderWidth);
            } else {
                c.DrawCircle(cx, cy, r, borderColor, borderWidth);
            }
        }
    }

    // symbolSize（像素直径，0 = 族默认）-> 外接半径。
    static int SymbolRadius(int symbolSize, int defaultR) {
        if (symbolSize > 0) { return symbolSize / 2; }
        return defaultR;
    }

    // ---- 比例辅助 ----

    // 将原始最大值向上取整为友好的轴边界（2/5/10 * 10^n）。
    static int NiceMax(int v) {
        if (v <= 5) { return 5; }
        int mag = 1;
        while (mag * 10 <= v) { mag = mag * 10; }
        int unit = v / mag;
        int nice = 10;
        if (unit < 2) { nice = 2; } else if (unit < 5) { nice = 5; }
        return nice * mag;
    }

    static int MaxOf(List<ChartSeries> series) {
        int mx = 0;
        for (int i = 0; i < series.Count; i = i + 1) {
            ChartSeries s = series[i];
            for (int j = 0; j < s.Count(); j = j + 1) { if (s.Value(j) > mx) { mx = s.Value(j); } }
        }
        return mx;
    }

    // 系列中的最小值（无负数时为 0）。水平条 / 旋风图用它
    // 把轴下界扩到 0 以下，而不是把负值裁成空柱。
    static int MinOf(List<ChartSeries> series) {
        int mn = 0;
        for (int i = 0; i < series.Count; i = i + 1) {
            ChartSeries s = series[i];
            if (!s.hidden) {
                for (int j = 0; j < s.Count(); j = j + 1) {
                    if (s.Value(j) < mn) { mn = s.Value(j); }
                }
            }
        }
        return mn;
    }

    // 数值 → 水平像素：plotX 对应 lo，plotX+plotW 对应 hi。
    static int ValueX(int plotX, int plotW, int lo, int hi, int v) {
        int span = hi - lo;
        if (span < 1) { span = 1; }
        return plotX + (v - lo) * plotW / span;
    }

    // 数值 → 垂直像素：plotY+plotH 对应 lo，plotY 对应 hi（向上增大）。
    static int ValueY(int plotY, int plotH, int lo, int hi, int v) {
        int span = hi - lo;
        if (span < 1) { span = 1; }
        return plotY + plotH - (v - lo) * plotH / span;
    }

    // 仅索引窗口 [i0,i1]（含端点）内的最大值，供 dataZoom
    // 的索引视图使用（渲染循环直接读原系列，不做有损克隆）。
    static int MaxOfWindow(List<ChartSeries> series, int i0, int i1) {
        int mx = 0;
        for (int i = 0; i < series.Count; i = i + 1) {
            ChartSeries s = series[i];
            int j = i0;
            while (j <= i1 && j < s.Count()) {
                if (s.Value(j) > mx) { mx = s.Value(j); }
                j = j + 1;
            }
        }
        return mx;
    }

    // 各分类中的最大堆叠总量（用于堆叠柱状图）。
    // 共享 stackName 的系列堆叠在一起；轴适配最高的组，
    // 使多组堆叠柱（ECharts `stack` 组）正确缩放。
    static int MaxStack(List<ChartSeries> series, int n) {        List<string> grp = new List<string>();
        for (int g = 0; g < series.Count; g = g + 1) {
            ChartSeries cs = series[g];
            if (!ChartView.IsLineFamily(cs.type)) {
                bool found = false;
                for (int gi = 0; gi < grp.Count; gi = gi + 1) {
                    if (grp[gi] == cs.stackName) { found = true; }
                }
                if (!found) { grp.Add(cs.stackName); }
            }
        }
        int ng = grp.Count;
        if (ng < 1) { ng = 1; }
        int mx = 0;
        for (int i = 0; i < n; i = i + 1) {
            for (int gi = 0; gi < ng; gi = gi + 1) {
                int sum = 0;
                for (int s = 0; s < series.Count; s = s + 1) {
                    ChartSeries cs = series[s];
                    if (!ChartView.IsLineFamily(cs.type) && cs.stackName == grp[gi]) {
                        if (i < cs.Count()) { sum = sum + cs.Value(i); }
                    }
                }
                if (sum > mx) { mx = sum; }
            }
        }
        return mx;
    }

    // MaxStack 的索引窗口版：仅累计分类 j + i0（j 在 [0,n)）。
    static int MaxStackW(List<ChartSeries> series, int n, int i0) {
        List<string> grp = new List<string>();
        for (int g = 0; g < series.Count; g = g + 1) {
            ChartSeries cs = series[g];
            if (!ChartView.IsLineFamily(cs.type)) {
                bool found = false;
                for (int gi = 0; gi < grp.Count; gi = gi + 1) {
                    if (grp[gi] == cs.stackName) { found = true; }
                }
                if (!found) { grp.Add(cs.stackName); }
            }
        }
        int ng = grp.Count;
        if (ng < 1) { ng = 1; }
        int mx = 0;
        for (int i = 0; i < n; i = i + 1) {
            int oi = i0 + i;
            for (int gi = 0; gi < ng; gi = gi + 1) {
                int sum = 0;
                for (int s = 0; s < series.Count; s = s + 1) {
                    ChartSeries cs = series[s];
                    if (!ChartView.IsLineFamily(cs.type) && cs.stackName == grp[gi]) {
                        if (oi < cs.Count()) { sum = sum + cs.Value(oi); }
                    }
                }
                if (sum > mx) { mx = sum; }
            }
        }
        return mx;
    }

    // 所有系列堆叠成一条带时的最大累计总量（堆叠面积图
    // / 堆叠折线图：系列按顺序累加，与 stackName 无关）。
    // 隐藏的系列（图例关闭）被跳过，因此隐藏一个系列
    // 会重设轴范围，剩余条带正确重新堆叠。
    static int MaxStackAll(List<ChartSeries> series, int n) {
        int mx = 0;
        for (int i = 0; i < n; i = i + 1) {
            int sum = 0;
            for (int s = 0; s < series.Count; s = s + 1) {
                ChartSeries cs = series[s];
                if (!cs.hidden && i < cs.Count()) { sum = sum + cs.Value(i); }
            }
            if (sum > mx) { mx = sum; }
        }
        return mx;
    }

    // MaxStackAll 的索引窗口版：仅累计分类 j + i0。
    static int MaxStackAllW(List<ChartSeries> series, int n, int i0) {
        int mx = 0;
        for (int i = 0; i < n; i = i + 1) {
            int oi = i0 + i;
            int sum = 0;
            for (int s = 0; s < series.Count; s = s + 1) {
                ChartSeries cs = series[s];
                if (!cs.hidden && oi < cs.Count()) { sum = sum + cs.Value(oi); }
            }
            if (sum > mx) { mx = sum; }
        }
        return mx;
    }

    static int MaxInt(List<int> vs) {
        int mx = 0;
        for (int i = 0; i < vs.Count; i = i + 1) { if (vs[i] > mx) { mx = vs[i]; } }
        return mx;
    }

    // ---- 几何 ----

    // 整数 point-in-polygon（射线法，even-odd），无除法/浮点。
    // 半开约定：py >= 顶点 y 视为在射线之上，每条边最多计一次
    // 穿越；交点侧由叉积符号结合边方向判定。点在边界上属边缘
    // 情形，结果不保证——由命中层的 bbox 容差吸收。
    static bool PointInPoly(List<ChartMapPoint> poly, int px, int py) {
        int n = poly.Count;
        if (n < 3) { return false; }
        bool inside = false;
        int j = n - 1;
        for (int i = 0; i < n; i = i + 1) {
            ChartMapPoint pi = poly[i];
            ChartMapPoint pj = poly[j];
            if ((py >= pi.y) != (py >= pj.y)) {
                int cross = (pi.x - pj.x) * (py - pj.y) - (pi.y - pj.y) * (px - pj.x);
                if ((cross > 0) == (pi.y > pj.y)) { inside = !inside; }
            }
            j = i;
        }
        return inside;
    }

    // ---- 轴类型：Time / Log ----

    // 10 的整数对数（floor log10），仅正值（v < 1 → 0）。
    static int Log10(int v) {
        if (v < 1) { return 0; }
        int e = 0;
        int p = 1;
        while (p * 10 <= v) { p = p * 10; e = e + 1; }
        return e;
    }

    // 对数轴刻度：lo/hi 边界 + 中间的 10 的幂（去重）。
    static List<int> LogTicks(int lo, int hi) {
        if (hi < lo) { int tmp = lo; lo = hi; hi = tmp; }
        if (lo < 1) { lo = 1; }
        if (hi < lo) { hi = lo; }
        List<int> ts = new List<int>();
        ts.Add(lo);
        int p = 1;
        while (p * 10 <= hi) {
            p = p * 10;
            if (p > lo) { ts.Add(p); }
        }
        if (ts[ts.Count - 1] != hi) { ts.Add(hi); }
        return ts;
    }

    // 从整数天数生成确定性短日期 "YYYY-MM-DD"（非闰年，纯表驱动，
    // 无系统时间依赖）。t = 0 是 1970-01-01。
    static string TimeLabel(int t) {
        if (t < 0) { t = 0; }
        int year = 1970 + t / 365;
        int doy = t % 365;
        List<int> md = new List<int>{31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31};
        int month = 0;
        while (month < 11 && doy >= md[month]) {
            doy = doy - md[month];
            month = month + 1;
        }
        string mm = Convert.ToString(month + 1);
        if (mm.Length < 2) { mm = "0" + mm; }
        string dd = Convert.ToString(doy + 1);
        if (dd.Length < 2) { dd = "0" + dd; }
        return Convert.ToString(year) + "-" + mm + "-" + dd;
    }

    // 时间轴刻度：从 {1,2,5}×10^n 阶梯选步长，使
    // (t1-t0)/step ≤ maxTicks-1；生成 t0 起等距点，
    // 末点不落在网格上则补 t1。
    static List<int> TimeTicks(int t0, int t1, int maxTicks) {
        if (t1 < t0) { int tmp = t0; t0 = t1; t1 = tmp; }
        if (maxTicks < 2) { maxTicks = 2; }
        int span = t1 - t0;
        int step = 1;
        while (true) {
            if (span / step + 1 <= maxTicks) { break; }
            int mag = 1;
            while (step >= mag * 10) { mag = mag * 10; }
            int unit = step / mag;
            if (unit == 1) { step = 2 * mag; }
            else if (unit == 2) { step = 5 * mag; }
            else { step = 10 * mag; }
        }
        List<int> ts = new List<int>();
        for (int t = t0; t <= t1; t = t + step) { ts.Add(t); }
        if (ts[ts.Count - 1] != t1) { ts.Add(t1); }
        return ts;
    }

    // 固定小数位数的确定性格式化（四舍五入，无浮点打印依赖）。
    static string FormatFixed(double v, int precision) {
        if (precision < 0) { precision = 0; }
        if (precision > 4) { precision = 4; }
        int scale = 1;
        for (int i = 0; i < precision; i = i + 1) { scale = scale * 10; }
        bool neg = false;
        double av = v;
        if (av < 0) { neg = true; av = 0 - av; }
        int scaled = (int)(av * (double)scale + 0.5);
        int ip = scaled / scale;
        string s = Convert.ToString(ip);
        if (precision > 0) {
            int frac = scaled % scale;
            string fs = Convert.ToString(frac);
            while (fs.Length < precision) { fs = "0" + fs; }
            s = s + "." + fs;
        }
        if (neg) { s = "-" + s; }
        return s;
    }

    // ---- 共享框架 ----

    // 面板背景 + 标题 + 图例色块。返回标题/图例带
    // 下方紧邻的 y，调用方可在其下布局绘图区。
    static int DrawPanel(App app, int x, int y, int w, int h, string title,
                         List<ChartSeries> series, bool showLegend) {
        return Chart.DrawPanelI(app, x, y, w, h, title, series, 0, showLegend);
    }

    // 交互 id `wid` 下系列 `si` 的图例隐藏状态键。
    static int LegendKey(int wid, int si) { return 6000000 + wid * 64 + si; }

    // 饼/漏斗/玫瑰扇区、和弦/力导节点：按 (系列, 数据项) 持久化隐藏。
    // 与 LegendKey 分段错开，避免单系列多扇区共用一个键把整图关掉。
    static int LegendSliceKey(int wid, int si, int di) {
        return 6200000 + wid * 1024 + si * 64 + di;
    }
    static int PieSelKey(int wid, int si, int di) {
        return 6400000 + wid * 1024 + si * 64 + di;
    }

    static int LegendChipW(App app, string label) {
        int lgFs = Style.FontFallback(app, "small");
        return app.Scale(12) + app.Scale(6)
            + Canvas.MeasureText(label, lgFs) + app.Scale(10);
    }

    // 标题行与工具箱行的底边：空标题不占大号行高，有工具箱时
    // 内容从工具箱下方开始，避免标题/色块和工具图标叠在一起。
    static int HeadBandBottom(App app, int y, string title) {
        int pad = app.theme.paddingMedium;
        int top = y + pad;
        int h = 0;
        if (title.Length > 0) {
            h = Canvas.FontHeight(Style.FontFallback(app, "large"));
        }
        if (Chart.toolReserve > 0) {
            int th = ChartToolbox.Height(app);
            if (th > h) { h = th; }
        }
        if (h < 1) { return top; }
        return top + h + app.Scale(4);
    }

    /// 右侧色块图例一行：独立 AllocId 命中，stateKey 跨帧持久化。
    /// 点一下切换隐藏（变暗 + 删除线），再点恢复。返回是否刚点中。
    static bool DrawLegendChip(App app, int lx, int ly, int legendW, int lh,
                               int color, string label, bool hidden, int stateKey) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int sw = app.Scale(12);
        int hitId = app.focus.AllocId();
        app.hitTester.RegisterRect(hitId, lx, ly, legendW, lh, 3);
        bool hot = app.mouseX >= lx && app.mouseX < lx + legendW
            && app.mouseY >= ly && app.mouseY < ly + lh;
        int rowCol = color;
        int lblColor = Style.Part(app, "chart", "label", "", "", "",
            Style.SNormal()).FgOr(0);
        if (hidden) {
            rowCol = Chart.WithAlpha(color, 90);
            lblColor = Chart.WithAlpha(lblColor, 110);
        }
        c.FillRoundRect(lx, ly + app.Scale(2), sw, sw, t.borderRadiusSmall, rowCol);
        if (hot && !hidden) {
            c.DrawRoundRect(lx - app.Scale(1), ly + app.Scale(1),
                sw + app.Scale(2), sw + app.Scale(2), t.borderRadiusSmall,
                t.primary, 1);
        }
        int lgFs = Style.FontFallback(app, "small");
        c.DrawText(lx + sw + app.Scale(6), ly + app.Scale(1), label, lblColor, lgFs);
        if (hidden) {
            int my = ly + app.Scale(2) + Canvas.FontHeight(lgFs) / 2;
            int tw = Canvas.MeasureText(label, lgFs);
            c.FillRect(lx + sw + app.Scale(6), my, tw, 1, lblColor);
        }
        if (stateKey != 0 && Ui.Clicked(app, hitId)) {
            int nv = 1;
            if (hidden) { nv = 0; }
            app.StateSet(stateKey, nv);
            app.RequestRedraw();
            return true;
        }
        return false;
    }

    // dataZoom 窗口状态键（分类范围的千分值 0..1000）。
    static int ZoomLoKey(int wid) { return 7000000 + wid * 2; }
    static int ZoomHiKey(int wid) { return 7000000 + wid * 2 + 1; }
    static int TreePanXKey(int wid) { return 8000000 + wid * 16; }
    static int TreePanYKey(int wid) { return 8000000 + wid * 16 + 1; }
    static int TreeDragXKey(int wid) { return 8000000 + wid * 16 + 2; }
    static int TreeDragYKey(int wid) { return 8000000 + wid * 16 + 3; }
    static int TreeDragPanXKey(int wid) { return 8000000 + wid * 16 + 4; }
    static int TreeDragPanYKey(int wid) { return 8000000 + wid * 16 + 5; }
    static int TreeDraggingKey(int wid) { return 8000000 + wid * 16 + 6; }
    // 树缩放，为自然节点间距的百分比。0 表示尚未适配：
    // 首帧（或工具箱「还原」）把整棵树放进视口中心，之后镜头
    // 就是无限画布——平移不夹紧、缩放不因窗口尺寸变化而重置。
    static int TreeZoomKey(int wid) { return 8000000 + wid * 16 + 7; }
    static int TreeSizeWKey(int wid) { return 8000000 + wid * 16 + 8; }
    static int TreeSizeHKey(int wid) { return 8000000 + wid * 16 + 9; }
    static int TreeHitKey(int wid) { return 8000000 + wid * 16 + 10; }

    // 快照槽位的 RenderCache 指纹键（见 ChartView.RenderCached）。
    static int CacheKey(int slot) { return 9000000 + slot; }

    // toolbox / 地图漫游 / 选中（与 Tree* 8000000 段错开）。
    static int TbViewKey(int wid) { return 8200000 + wid * 8; }
    static int TbMagicKey(int wid) { return 8200000 + wid * 8 + 1; }
    static int TbZoomKey(int wid) { return 8200000 + wid * 8 + 2; }
    static int MapZoomKey(int wid) { return 8200000 + wid * 8 + 3; }
    static int MapPanXKey(int wid) { return 8200000 + wid * 8 + 4; }
    static int MapPanYKey(int wid) { return 8200000 + wid * 8 + 5; }
    static int MapSelKey(int wid) { return 8200000 + wid * 8 + 6; }
    static int MapDragKey(int wid) { return 8200000 + wid * 8 + 7; }
    static int MapDragXKey(int wid) { return 8300000 + wid * 4; }
    static int MapDragYKey(int wid) { return 8300000 + wid * 4 + 1; }
    static int MapDragPanXKey(int wid) { return 8300000 + wid * 4 + 2; }
    static int MapDragPanYKey(int wid) { return 8300000 + wid * 4 + 3; }
    static int TbHitKey(int wid, int k) { return 8500000 + wid * 8 + k; }

    // 将缩放窗口解析为包含端点的分类索引范围 [i0,i1]。
    static int ZoomI0(App app, ChartOption o, int wid, int n) {
        int lo = app.StateGet(Chart.ZoomLoKey(wid), 0 - 1);
        if (lo < 0) {
            lo = o.zoomStart * 10;
            app.StateSet(Chart.ZoomLoKey(wid), lo);
        }
        int i0 = lo * (n - 1) / 1000;
        if (i0 < 0) { i0 = 0; }
        if (i0 > n - 1) { i0 = n - 1; }
        return i0;
    }
    static int ZoomI1(App app, ChartOption o, int wid, int n) {
        int hi = app.StateGet(Chart.ZoomHiKey(wid), 0 - 1);
        if (hi < 0) {
            hi = o.zoomEnd * 10;
            app.StateSet(Chart.ZoomHiKey(wid), hi);
        }
        int i1 = hi * (n - 1) / 1000;
        if (i1 < 0) { i1 = 0; }
        if (i1 > n - 1) { i1 = n - 1; }
        return i1;
    }

    // 将标签窗口化为包含端点的索引范围 [i0,i1]（仅字符串
    // 拷贝；渲染器对系列值也按同一 [i0,i1] 直接读原系列，
    // 避免有损的系列克隆丢失 itemStyle/marks 等字段）。
    static List<string> WindowLabels(List<string> labels, int i0, int i1) {
        List<string> outp = new List<string>();
        int i = i0;
        while (i <= i1 && i < labels.Count) { outp.Add(labels[i]); i = i + 1; }
        return outp;
    }

    // 绘制 dataZoom 范围滑块并处理手柄拖拽。两个手柄设定
    // 窗口边界（千分值）；拖动选中的带可平移。
    // 窗口状态以 wid 为键持久化在 App 状态映射中。
    static void DrawZoomBar(App app, int plotX, int plotW, int barY, int barH,
                            int wid, int n) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        if (plotW < 4 || n < 2) { return; }

        int lo = app.StateGet(Chart.ZoomLoKey(wid), 0);
        int hi = app.StateGet(Chart.ZoomHiKey(wid), 1000);

        int hw = app.Scale(6);
        int loX = plotX + lo * plotW / 1000;
        int hiX = plotX + hi * plotW / 1000;

        StyleBox sTrack = Style.Part(app, "chart", "zoom-track", "", "", "",
                                     Style.SNormal());
        StyleBox sWin = Style.Part(app, "chart", "zoom-window", "", "", "",
                                   Style.SNormal());
        StyleBox sHandle = Style.Part(app, "chart", "zoom-handle", "", "", "",
                                      Style.SNormal());

        // 轨道 + 选中窗口
        c.FillRoundRect(plotX, barY, plotW, barH, t.borderRadiusSmall, sTrack.BgOr(0));
        c.FillRect(loX, barY, hiX - loX, barH, sWin.BgOr(0));
        c.DrawRect(loX, barY, hiX - loX, barH, sWin.BorderOr(0), 1);

        // 手柄
        c.FillRoundRect(loX - hw, barY, hw * 2, barH, t.borderRadiusSmall, sHandle.BgOr(0));
        c.FillRoundRect(hiX - hw, barY, hw * 2, barH, t.borderRadiusSmall, sHandle.BgOr(0));

        int loId = app.focus.AllocId();
        int hiId = app.focus.AllocId();
        int bandId = app.focus.AllocId();
        app.hitTester.RegisterRect(loId, loX - hw, barY, hw * 2, barH, 3);
        app.hitTester.RegisterRect(hiId, hiX - hw, barY, hw * 2, barH, 3);
        app.hitTester.RegisterRect(bandId, loX + hw, barY, hiX - loX - hw * 2, barH, 3);

        int mxPm = (app.mouseX - plotX) * 1000 / plotW;
        if (mxPm < 0) { mxPm = 0; }
        if (mxPm > 1000) { mxPm = 1000; }
        int minGap = 1000 / (n - 1);
        if (minGap < 20) { minGap = 20; }

        if (Ui.Pressed(app, loId)) {
            lo = mxPm;
            if (lo > hi - minGap) { lo = hi - minGap; }
            if (lo < 0) { lo = 0; }
            app.StateSet(Chart.ZoomLoKey(wid), lo);
            app.RequestRedraw();
        } else if (Ui.Pressed(app, hiId)) {
            hi = mxPm;
            if (hi < lo + minGap) { hi = lo + minGap; }
            if (hi > 1000) { hi = 1000; }
            app.StateSet(Chart.ZoomHiKey(wid), hi);
            app.RequestRedraw();
        } else if (Ui.Pressed(app, bandId)) {
            // 平移：保持带宽，以指针为中心
            int width = hi - lo;
            int nlo = mxPm - width / 2;
            if (nlo < 0) { nlo = 0; }
            if (nlo + width > 1000) { nlo = 1000 - width; }
            app.StateSet(Chart.ZoomLoKey(wid), nlo);
            app.StateSet(Chart.ZoomHiKey(wid), nlo + width);
            app.RequestRedraw();
        }
    }

    // 右侧竖排图例的起始 y：工具箱占着标题行时下移，避免挡住色块。
    static int LegendStartY(App app, int y, int proposed) {
        if (Chart.toolReserve < 1) { return proposed; }
        int bandBot = y + app.theme.paddingMedium
            + ChartToolbox.Height(app) + app.Scale(4);
        if (proposed < bandBot) { return bandBot; }
        return proposed;
    }

    // 图例占用的行数：有工具箱时整排下移到标题行之下（至少 1 行）；
    // 否则与标题同行，仅统计放不下而换出的行。
    static int LegendRowCount(App app, int x, int w, string title,
                              List<ChartSeries> series) {
        if (series == null || series.Count < 1) { return 0; }
        int pad = app.theme.paddingMedium;
        int lgFs = Style.FontFallback(app, "small");
        int sw = app.Scale(12);
        bool below = Chart.toolReserve > 0;
        int extra = 0;
        if (below) {
            extra = 1;
            int xCur = x + pad;
            int maxX = x + w - pad;
            for (int si = 0; si < series.Count; si = si + 1) {
                int chipW = sw + app.Scale(6)
                    + Canvas.MeasureText(series[si].name, lgFs);
                if (xCur > x + pad && xCur + chipW > maxX) {
                    extra = extra + 1;
                    xCur = x + pad;
                }
                xCur = xCur + chipW + app.Scale(14);
            }
            return extra;
        }
        int lx = x + w - pad;
        int leftLimit = x + pad;
        if (title.Length > 0) {
            leftLimit = x + pad
                + Canvas.MeasureText(title, Style.FontFallback(app, "large"))
                + app.Scale(14);
        }
        int si = series.Count - 1;
        while (si >= 0) {
            int tw = Canvas.MeasureText(series[si].name, lgFs);
            int rowLeft = lx - tw - app.Scale(6) - sw;
            if (rowLeft < leftLimit) {
                extra = extra + 1;
                lx = x + w - pad;
                leftLimit = x + pad;
                rowLeft = lx - tw - app.Scale(6) - sw;
                if (rowLeft < leftLimit) { rowLeft = leftLimit; }
            }
            lx = rowLeft - app.Scale(14);
            si = si - 1;
        }
        return extra;
    }

    // 面板内容区顶部 y：标题/工具箱行 + 图例行 + 间隙。
    // DrawPanelI 与 PanelTopI 共用，悬停层才能与主体对齐。
    static int PanelContentTop(App app, int x, int y, int w, string title,
                               List<ChartSeries> series, bool showLegend) {
        int pad = app.theme.paddingMedium;
        int titleH = Canvas.FontHeight(Style.FontFallback(app, "large"));
        int headH = titleH;
        if (Chart.toolReserve > 0) {
            int th = ChartToolbox.Height(app);
            if (th > headH) { headH = th; }
        }
        int belowGap = 0;
        int extra = 0;
        if (showLegend) {
            extra = Chart.LegendRowCount(app, x, w, title, series);
            if (Chart.toolReserve > 0) { belowGap = app.Scale(4); }
        }
        int rowH = Canvas.FontHeight(Style.FontFallback(app, "small")) + app.Scale(6);
        return y + pad + headH + belowGap + extra * rowH + app.Scale(6);
    }

    // 面板 + 交互式图例。wid != 0 时每个色块是一个命中区域：
    // 点击切换该系列的可见性（以 wid 为键持久化在
    // App 状态映射中），解析后的隐藏标志写入帧内系列
    // 快照，所有下游渲染器都会跳过它。隐藏的系列
    // 以变暗 + 删除线绘制，以便可以恢复显示。
    // showLegend=false 时既绘制也不解析隐藏状态——
    // 图例关闭时系列恒为可见，避免状态残留让图无声消失。
    static int DrawPanelI(App app, int x, int y, int w, int h, string title,
                          List<ChartSeries> series, int wid, bool showLegend) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int pad = t.paddingMedium;

        StyleBox sPanel = Style.Full(app, "chart", "", "", Style.SNormal());
        c.SurfaceRoundRect(x, y, w, h, t.borderRadiusMedium, sPanel.BgOr(0), sPanel.BorderOr(0), 1);

        int top = y + pad;
        int titleFs = Style.FontFallback(app, "large");
        int titleH = Canvas.FontHeight(titleFs);
        int titleMax = x + w - pad - Chart.toolReserve - (x + pad) - app.Scale(8);
        if (title.Length > 0 && titleMax > 0) {
            c.PushClip(x + pad, top, titleMax, titleH);
            c.DrawText(x + pad, top, title, sPanel.FgOr(0), titleFs);
            c.PopClip();
        }

        if (showLegend) {
        // 有工具箱：图例整排下移到标题/工具箱行之下，永不互挡。
        // 无工具箱：仍与标题同行，从右往左排，放不下再换行。
        StyleBox sLegend = Style.Part(app, "chart", "legend", "", "", "",
                                      Style.SNormal());
        StyleBox sLegendOff = Style.Part(app, "chart", "legend", "", "off", "",
                                         Style.SNormal());
        int sw = app.Scale(12);
        int lgFs = Style.FontFallback(app, "small");
        int rowH = Canvas.FontHeight(lgFs) + app.Scale(6);
        bool below = Chart.toolReserve > 0;
        int headH = titleH;
        if (below) {
            int toolH = ChartToolbox.Height(app);
            if (toolH > headH) { headH = toolH; }
        }
        int lgY = y + pad;
        if (below) {
            lgY = y + pad + headH + app.Scale(4);
            int xCur = x + pad;
            int maxX = x + w - pad;
            int totW = 0;
            for (int sm = 0; sm < series.Count; sm = sm + 1) {
                totW = totW + sw + app.Scale(6)
                    + Canvas.MeasureText(series[sm].name, lgFs) + app.Scale(14);
            }
            if (series.Count > 0) { totW = totW - app.Scale(14); }
            if (totW > 0 && totW <= maxX - xCur) {
                xCur = xCur + (maxX - xCur - totW) / 2;
            }
            for (int si = 0; si < series.Count; si = si + 1) {
                bool hid = series[si].hidden;
                if (wid != 0) {
                    hid = app.StateGet(Chart.LegendKey(wid, si), hid ? 1 : 0) == 1;
                }
                string nm = series[si].name;
                int tw = Canvas.MeasureText(nm, lgFs);
                int chipW = sw + app.Scale(6) + tw;
                if (xCur > x + pad && xCur + chipW > maxX) {
                    xCur = x + pad;
                    lgY = lgY + rowH;
                }
                int txtCol = sLegend.FgOr(0);
                int swCol = series[si].color;
                if (hid) { txtCol = sLegendOff.FgOr(0); swCol = sLegendOff.BgOr(0); }
                c.FillRoundRect(xCur, lgY + app.Scale(3), sw, sw, t.borderRadiusSmall, swCol);
                c.DrawText(xCur + sw + app.Scale(6), lgY + app.Scale(2), nm, txtCol, lgFs);
                if (hid) {
                    int my = lgY + app.Scale(2) + Canvas.FontHeight(lgFs) / 2;
                    c.FillRect(xCur + sw + app.Scale(6), my, tw, 1, sLegendOff.FgOr(0));
                }
                if (wid != 0) {
                    int hitId = app.focus.AllocId();
                    app.hitTester.RegisterRect(hitId, xCur, lgY, chipW, rowH, 3);
                    if (Ui.Clicked(app, hitId)) {
                        int nv = 1;
                        if (hid) { nv = 0; }
                        app.StateSet(Chart.LegendKey(wid, si), nv);
                        hid = (nv == 1);
                        app.RequestRedraw();
                    }
                }
                series[si].hidden = hid;
                xCur = xCur + chipW + app.Scale(14);
            }
        } else {
        int lx = x + w - pad;
        int leftLimit = x + pad;
        if (title.Length > 0) {
            leftLimit = x + pad
                + Canvas.MeasureText(title, titleFs)
                + app.Scale(14);
        }
        int si = series.Count - 1;
        while (si >= 0) {
            bool hid = series[si].hidden;
            if (wid != 0) {
                hid = app.StateGet(Chart.LegendKey(wid, si), hid ? 1 : 0) == 1;
            }

            string nm = series[si].name;
            int tw = Canvas.MeasureText(nm, lgFs);
            int rowLeft = lx - tw - app.Scale(6) - sw;
            if (rowLeft < leftLimit) {
                lgY = lgY + rowH;
                lx = x + w - pad;
                leftLimit = x + pad;
                rowLeft = lx - tw - app.Scale(6) - sw;
                if (rowLeft < leftLimit) { rowLeft = leftLimit; }
            }
            int swatchX = rowLeft;

            int txtCol = sLegend.FgOr(0);
            int swCol = series[si].color;
            if (hid) { txtCol = sLegendOff.FgOr(0); swCol = sLegendOff.BgOr(0); }

            c.DrawText(lx - tw, lgY + app.Scale(2), nm, txtCol, lgFs);
            c.FillRoundRect(swatchX, lgY + app.Scale(3), sw, sw, t.borderRadiusSmall, swCol);
            if (hid) {
                int my = lgY + app.Scale(2) + Canvas.FontHeight(lgFs) / 2;
                c.FillRect(lx - tw, my, tw, 1, sLegendOff.FgOr(0));
            }

            if (wid != 0) {
                int hitId = app.focus.AllocId();
                app.hitTester.RegisterRect(hitId, rowLeft,
                    lgY, (lx) - rowLeft, sw + app.Scale(4), 3);
                if (Ui.Clicked(app, hitId)) {
                    int nv = 1;
                    if (hid) { nv = 0; }
                    app.StateSet(Chart.LegendKey(wid, si), nv);
                    hid = (nv == 1);
                    app.RequestRedraw();
                }
            }

            series[si].hidden = hid;
            lx = rowLeft - app.Scale(14);
            si = si - 1;
        }
        }
        }

        return Chart.PanelContentTop(app, x, y, w, title, series, showLegend);
    }

    /// 只算不画：与 DrawPanelI 完全一致的面板内容顶部
    /// （标题行高 + 图例换行占位，换行算法逐行镜像）。
    /// 悬停覆盖层用它与主体帧对齐——覆盖层绝不能调
    /// DrawPanelI / PanelHead，它们会重绘面板背景盖住图形。
    static int PanelTopI(App app, int x, int y, int w, string title,
                         List<ChartSeries> series, bool showLegend) {
        return Chart.PanelContentTop(app, x, y, w, title, series, showLegend);
    }

    // 左轴上的阴影 markArea 带 [markLo, markHi]（绘制在
    // 系列之下）。两个边界未全部设置时为空操作。
    static void DrawMarkArea(App app, ChartFrame f, ChartOption o) {
        if (o.markLo == ChartOption.Auto() || o.markHi == ChartOption.Auto()) { return; }
        Canvas c = app.canvas;
        Theme t = app.theme;
        int y0 = f.YOf(o.markHi, 0);
        int y1 = f.YOf(o.markLo, 0);
        if (y1 < y0) { int tmp = y0; y0 = y1; y1 = tmp; }
        int areaBase = Style.Part(app, "chart", "mark-area", "", "", "",
                                  Style.SNormal()).BgOr(0);
        c.FillRect(f.plotX, y0, f.plotW, y1 - y0, Chart.WithAlpha(areaBase, 28));
    }

    // 左轴 markLine 处的水平阈值线，带可选的
    // 右对齐标签（绘制在系列之上）。
    static void DrawMarkLine(App app, ChartFrame f, ChartOption o) {
        if (o.markLine == ChartOption.Auto()) { return; }
        Canvas c = app.canvas;
        Theme t = app.theme;
        int my = f.YOf(o.markLine, 0);
        StyleBox sMark = Style.Part(app, "chart", "mark", "", "", "",
                                    Style.SNormal());
        // 虚线
        int dx = f.plotX;
        int dash = app.Scale(6);
        while (dx < f.plotX + f.plotW) {
            int seg = dash;
            if (dx + seg > f.plotX + f.plotW) { seg = f.plotX + f.plotW - dx; }
            c.FillRect(dx, my, seg, 1, sMark.BgOr(0));
            dx = dx + dash * 2;
        }
        if (o.markLabel.Length > 0) {
            int fs = Style.FontFallback(app, "small");
            int lw = Canvas.MeasureText(o.markLabel, fs);
            c.DrawText(f.plotX + f.plotW - lw, my - Canvas.FontHeight(fs) - app.Scale(1),
                o.markLabel, sMark.FgOr(0), fs);
        }
    }

    // 带数值网格线（左）+ 分类标签（底部）的直角坐标系框架。
    static ChartFrame DrawFrame(App app, int x, int y, int w, int h, int plotTop,
                                List<string> labels, int maxV) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int pad = t.paddingMedium;
        int axisFs = Style.FontFallback(app, "small");

        int leftGut = Canvas.MeasureText(Convert.ToString(maxV), axisFs) + app.Scale(12);
        int botGut = Canvas.FontHeight(axisFs) + app.Scale(8);

        int plotX = x + pad + leftGut;
        int plotY = plotTop;
        int plotW = (x + w - pad) - plotX;
        int plotH = (y + h - pad - botGut) - plotY;
        if (plotW < app.Scale(20)) { plotW = app.Scale(20); }
        if (plotH < app.Scale(20)) { plotH = app.Scale(20); }

        StyleBox sGrid = Style.Part(app, "chart", "grid", "", "", "",
                                    Style.SNormal());
        StyleBox sAxis = Style.Part(app, "chart", "axis", "", "", "",
                                    Style.SNormal());
        int ticks = 5;
        for (int k = 0; k <= ticks; k = k + 1) {
            int gy = plotY + plotH - (k * plotH / ticks);
            c.FillRect(plotX, gy, plotW, 1, sGrid.BgOr(0));
            int val = maxV * k / ticks;
            string vs = Convert.ToString(val);
            int vw = Canvas.MeasureText(vs, axisFs);
            c.DrawText(plotX - app.Scale(6) - vw, Canvas.CenterTextYAt(gy, axisFs), vs, sAxis.FgOr(0), axisFs);
        }
        c.FillRect(plotX, plotY, 1, plotH, sAxis.BgOr(0));
        c.FillRect(plotX, plotY + plotH, plotW, 1, sAxis.BgOr(0));

        int n = labels.Count;
        if (n > 0) {
            for (int ci = 0; ci < n; ci = ci + 1) {
                int cxs = plotX + ci * plotW / n;
                int cellW = plotX + (ci + 1) * plotW / n - cxs;
                c.DrawTextCentered(cxs, plotY + plotH + app.Scale(4), cellW, botGut,
                    labels[ci], sAxis.FgOr(0), axisFs);
            }
        }

        ChartFrame f = new ChartFrame();
        f.plotX = plotX;
        f.plotY = plotY;
        f.plotW = plotW;
        f.plotH = plotH;
        return f;
    }

    // 在显式数值范围 [lo, hi] 上的直角坐标系框架（支持非零
    // 基线/负数），用于蜡烛图、箱线图和误差图。
    static ChartFrame DrawFrameLoHi(App app, int x, int y, int w, int h, int plotTop,
                                    List<string> labels, int lo, int hi) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int pad = t.paddingMedium;
        int axisFs = Style.FontFallback(app, "small");
        if (hi <= lo) { hi = lo + 1; }

        int gw0 = Canvas.MeasureText(Convert.ToString(hi), axisFs);
        int gw1 = Canvas.MeasureText(Convert.ToString(lo), axisFs);
        int leftGut = gw0;
        if (gw1 > leftGut) { leftGut = gw1; }
        leftGut = leftGut + app.Scale(12);
        int botGut = Canvas.FontHeight(axisFs) + app.Scale(8);

        int plotX = x + pad + leftGut;
        int plotY = plotTop;
        int plotW = (x + w - pad) - plotX;
        int plotH = (y + h - pad - botGut) - plotY;
        if (plotW < app.Scale(20)) { plotW = app.Scale(20); }
        if (plotH < app.Scale(20)) { plotH = app.Scale(20); }

        StyleBox sGrid = Style.Part(app, "chart", "grid", "", "", "",
                                    Style.SNormal());
        StyleBox sAxis = Style.Part(app, "chart", "axis", "", "", "",
                                    Style.SNormal());
        int span = hi - lo;
        int ticks = 5;
        for (int k = 0; k <= ticks; k = k + 1) {
            int gy = plotY + plotH - (k * plotH / ticks);
            c.FillRect(plotX, gy, plotW, 1, sGrid.BgOr(0));
            int val = lo + span * k / ticks;
            string vs = Convert.ToString(val);
            int vw = Canvas.MeasureText(vs, axisFs);
            c.DrawText(plotX - app.Scale(6) - vw, Canvas.CenterTextYAt(gy, axisFs), vs, sAxis.FgOr(0), axisFs);
        }
        c.FillRect(plotX, plotY, 1, plotH, sAxis.BgOr(0));
        c.FillRect(plotX, plotY + plotH, plotW, 1, sAxis.BgOr(0));

        int n = labels.Count;
        if (n > 0) {
            for (int ci = 0; ci < n; ci = ci + 1) {
                int cxs = plotX + ci * plotW / n;
                int cellW = plotX + (ci + 1) * plotW / n - cxs;
                c.DrawTextCentered(cxs, plotY + plotH + app.Scale(4), cellW, botGut,
                    labels[ci], sAxis.FgOr(0), axisFs);
            }
        }

        ChartFrame f = new ChartFrame();
        f.plotX = plotX;
        f.plotY = plotY;
        f.plotW = plotW;
        f.plotH = plotH;
        return f;
    }

    // ---- 坐标系（双轴 + 友好刻度 + 标题）----

    // 绑定到给定数值轴的（可见）系列中的最大值。
    static int AxisMaxFor(List<ChartSeries> series, int axisIndex) {
        int mx = 0;
        for (int i = 0; i < series.Count; i = i + 1) {
            ChartSeries s = series[i];
            if (!s.hidden && s.axisIndex == axisIndex) {
                for (int j = 0; j < s.Count(); j = j + 1) { if (s.Value(j) > mx) { mx = s.Value(j); } }
            }
        }
        return mx;
    }

    // 绑定到给定数值轴的（可见）系列中的最小值
    // （无负数时为 0），使轴天然覆盖负数。
    static int AxisMinFor(List<ChartSeries> series, int axisIndex) {
        int mn = 0;
        for (int i = 0; i < series.Count; i = i + 1) {
            ChartSeries s = series[i];
            if (!s.hidden && s.axisIndex == axisIndex) {
                for (int j = 0; j < s.Count(); j = j + 1) { if (s.Value(j) < mn) { mn = s.Value(j); } }
            }
        }
        return mn;
    }

    static bool AnyOnAxis(List<ChartSeries> series, int axisIndex) {
        for (int i = 0; i < series.Count; i = i + 1) {
            if (!series[i].hidden && series[i].axisIndex == axisIndex) { return true; }
        }
        return false;
    }

    // 将原始最小值向下取整为友好的负轴边界（2/5/10 * 10^n）；
    // 没有负数需要覆盖时返回 0。
    static int NiceMin(int v) {
        if (v >= 0) { return 0; }
        int av = 0 - v;
        if (av <= 5) { return 0 - 5; }
        int mag = 1;
        while (mag * 10 <= av) { mag = mag * 10; }
        int unit = av / mag;
        int nice = 10;
        if (unit < 2) { nice = 2; } else if (unit < 5) { nice = 5; }
        return 0 - nice * mag;
    }

    // 从数据 + 固定覆盖解析单个数值轴的 [lo, hi] 范围。
    // 有负值时下界自动扩展到 0 以下。
    static int AxisLo(int fixedLo, int dataMin) {
        if (fixedLo != ChartOption.Auto()) { return fixedLo; }
        return Chart.NiceMin(dataMin);
    }
    static int AxisHi(int fixedHi, int dataMax, int lo) {
        int hi = Chart.NiceMax(dataMax);
        if (fixedHi != ChartOption.Auto()) { hi = fixedHi; }
        if (hi <= lo) { hi = lo + 1; }
        return hi;
    }

    // [lo, hi] 范围分成 `ticks` 步时最宽的刻度标签（像素）。
    static int TickLabelW(int lo, int hi, int ticks, int fs) {
        int span = hi - lo;
        int wmax = 0;
        for (int k = 0; k <= ticks; k = k + 1) {
            int val = lo + span * k / ticks;
            int lw = Canvas.MeasureText(Convert.ToString(val), fs);
            if (lw > wmax) { wmax = lw; }
        }
        return wmax;
    }

    // 完整直角坐标系：左（+ 可选右）数值轴，
    // 友好刻度 / 固定边界 / 翻转、分类（或数值）x 轴、
    // 网格内边距覆盖和轴标题。返回携带两个轴范围的
    // ChartFrame，所有渲染器通过 f.YOf(v, axisIndex) 映射数值。
    static ChartFrame BuildAxes(App app, int x, int y, int w, int h, int plotTop,
                                List<string> labels, ChartOption o, List<ChartSeries> series) {
        return Chart.BuildAxesR(app, x, y, w, h, plotTop, labels, o, series, 0 - 1, 0 - 1);
    }

    // 同 BuildAxes，但左/右轴使用显式数据最大值
    // （-1 = 从系列逐点推导）；堆叠图传入堆叠总和。
    static ChartFrame BuildAxesR(App app, int x, int y, int w, int h, int plotTop,
                                 List<string> labels, ChartOption o, List<ChartSeries> series,
                                 int leftDataMax, int rightDataMax) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int pad = t.paddingMedium;
        int fs = Style.FontFallback(app, "small");
        int fh = Canvas.FontHeight(fs);
        ChartAxis y0 = o.YAxis0();
        ChartAxis y1 = o.YAxis1();
        ChartAxis x0 = o.XAxis0();
        int ticks = y0.ticks;
        if (ticks < 1) { ticks = 5; }

        int lData = leftDataMax;
        if (lData < 0) { lData = Chart.AxisMaxFor(series, 0); }
        int leftLo = Chart.AxisLo(y0.min, Chart.AxisMinFor(series, 0));
        int leftHi = Chart.AxisHi(y0.max, lData, leftLo);
        bool hasRight = Chart.AnyOnAxis(series, 1);
        if (o.yAxes.Count > 1) { hasRight = true; }
        int rightLo = 0;
        int rightHi = 1;
        if (hasRight) {
            int rData = rightDataMax;
            if (rData < 0) { rData = Chart.AxisMaxFor(series, 1); }
            rightLo = Chart.AxisLo(y1.min, Chart.AxisMinFor(series, 1));
            rightHi = Chart.AxisHi(y1.max, rData, rightLo);
        }

        // 对数轴：仅正值，钳制下界到 ≥1（log10 对 ≤0 无定义）。
        bool leftLog = y0.type == ChartAxisType.Log;
        if (leftLog) {
            if (leftLo < 1) { leftLo = 1; }
            if (leftHi < leftLo + 1) { leftHi = leftLo + 1; }
        }
        bool rightLog = hasRight && y1.type == ChartAxisType.Log;
        if (rightLog) {
            if (rightLo < 1) { rightLo = 1; }
            if (rightHi < rightLo + 1) { rightHi = rightLo + 1; }
        }
        // 时间 X 轴：整数天数范围（Auto → 0..n-1）。
        bool isTime = x0.type == ChartAxisType.Time;
        int tMin = x0.min;
        int tMax = x0.max;
        if (tMin == ChartOption.Auto()) { tMin = 0; }
        if (tMax == ChartOption.Auto()) {
            tMax = labels.Count - 1;
            if (tMax < tMin + 1) { tMax = tMin + 1; }
        }

        int leftGut = Chart.TickLabelW(leftLo, leftHi, ticks, fs) + app.Scale(12);
        int rightGut = pad;
        if (hasRight) { rightGut = Chart.TickLabelW(rightLo, rightHi, ticks, fs) + app.Scale(12); }
        int botGut = fh + app.Scale(12);
        if (x0.title.Length > 0) { botGut = botGut + fh + app.Scale(2); }
        int topGut = 0;
        if (y0.title.Length > 0 || y1.title.Length > 0) { topGut = fh + app.Scale(2); }

        int plotX = x + pad + leftGut;
        if (o.gridLeft >= 0) { plotX = x + app.Scale(o.gridLeft); }
        int plotY = plotTop + topGut;
        if (o.gridTop >= 0) { plotY = y + app.Scale(o.gridTop); }
        int plotRight = x + w - rightGut;
        if (o.gridRight >= 0) { plotRight = x + w - app.Scale(o.gridRight); }
        int plotBot = y + h - pad - botGut;
        if (o.gridBottom >= 0) { plotBot = y + h - app.Scale(o.gridBottom); }
        int plotW = plotRight - plotX;
        int plotH = plotBot - plotY;
        if (plotW < app.Scale(20)) { plotW = app.Scale(20); }
        if (plotH < app.Scale(20)) { plotH = app.Scale(20); }

        ChartFrame f = new ChartFrame();
        f.plotX = plotX;
        f.plotY = plotY;
        f.plotW = plotW;
        f.plotH = plotH;
        f.leftMin = leftLo;
        f.leftMax = leftHi;
        f.rightMin = rightLo;
        f.rightMax = rightHi;
        f.hasRight = hasRight;
        f.reversed = y0.reversed;
        f.rightReversed = y1.reversed;
        f.leftLog = leftLog;
        f.rightLog = rightLog;
        f.isTime = isTime;
        f.timeMin = tMin;
        f.timeMax = tMax;

        // 网格线 + 左右数值标签（对数轴用 10 的幂刻度）
        StyleBox sGrid = Style.Part(app, "chart", "grid", "", "", "",
                                    Style.SNormal());
        StyleBox sAxis = Style.Part(app, "chart", "axis", "", "", "",
                                    Style.SNormal());
        StyleBox sAxisTitle = Style.Part(app, "chart", "axis-title", "", "",
                                         "", Style.SNormal());
        bool grid = o.showGrid && y0.showGrid;
        if (leftLog) {
            List<int> lts = Chart.LogTicks(leftLo, leftHi);
            for (int li = 0; li < lts.Count; li = li + 1) {
                int lv = lts[li];
                int gy = f.YOfLog(lv, 0);
                if (grid) { c.FillRect(plotX, gy, plotW, 1, sGrid.BgOr(0)); }
                string ls = Convert.ToString(lv);
                int lw = Canvas.MeasureText(ls, fs);
                c.DrawText(plotX - app.Scale(6) - lw, Canvas.CenterTextYAt(gy, fs),
                    ls, sAxis.FgOr(0), fs);
            }
        } else {
            int leftSpan = leftHi - leftLo;
            for (int k = 0; k <= ticks; k = k + 1) {
                int lv = leftLo + leftSpan * k / ticks;
                int gy = f.YOf(lv, 0);
                if (grid) { c.FillRect(plotX, gy, plotW, 1, sGrid.BgOr(0)); }
                string ls = Convert.ToString(lv);
                int lw = Canvas.MeasureText(ls, fs);
                c.DrawText(plotX - app.Scale(6) - lw, Canvas.CenterTextYAt(gy, fs),
                    ls, sAxis.FgOr(0), fs);
            }
        }
        if (hasRight) {
            if (rightLog) {
                List<int> rts = Chart.LogTicks(rightLo, rightHi);
                for (int ri = 0; ri < rts.Count; ri = ri + 1) {
                    int rv = rts[ri];
                    int gy = f.YOfLog(rv, 1);
                    c.DrawText(plotRight + app.Scale(6), Canvas.CenterTextYAt(gy, fs),
                        Convert.ToString(rv), sAxis.FgOr(0), fs);
                }
            } else {
                int rightSpan = rightHi - rightLo;
                for (int k = 0; k <= ticks; k = k + 1) {
                    int rv = rightLo + rightSpan * k / ticks;
                    int gy = f.YOf(rv, 1);
                    c.DrawText(plotRight + app.Scale(6), Canvas.CenterTextYAt(gy, fs),
                        Convert.ToString(rv), sAxis.FgOr(0), fs);
                }
            }
        }
        c.FillRect(plotX, plotY, 1, plotH, sAxis.BgOr(0));
        c.FillRect(plotX, plotY + plotH, plotW, 1, sAxis.BgOr(0));
        if (hasRight) { c.FillRect(plotX + plotW, plotY, 1, plotH, sAxis.BgOr(0)); }

        // x 分类标签（时间轴用 TimeLabel 日期刻度）
        int n = labels.Count;
        if (n > 0) {
            if (isTime) {
                List<int> tts = Chart.TimeTicks(tMin, tMax, 6);
                for (int ti = 0; ti < tts.Count; ti = ti + 1) {
                    int tx = f.XOfTime(tts[ti]);
                    string ls = Chart.TimeLabel(tts[ti]);
                    int lw = Canvas.MeasureText(ls, fs);
                    int lx = tx - lw / 2;
                    if (lx < plotX) { lx = plotX; }
                    if (lx + lw <= plotX + plotW) {
                        c.DrawText(lx, plotBot + app.Scale(4), ls, sAxis.FgOr(0), fs);
                    }
                }
            } else {
                int labelGap = app.Scale(6);
                int labelRight = plotX - labelGap;
                for (int ci = 0; ci < n; ci = ci + 1) {
                    int cxs = f.CatLeft(ci, n);
                    int cellW = f.CatWidth(ci, n);
                    int labelW = Canvas.MeasureText(labels[ci], fs);
                    int labelLeft = cxs + (cellW - labelW) / 2;
                    if (labelLeft < cxs) { labelLeft = cxs; }
                    bool last = ci == n - 1;
                    if (last || labelLeft >= labelRight + labelGap) {
                        c.DrawTextCentered(cxs, plotBot + app.Scale(4), cellW,
                            fh + app.Scale(4), labels[ci], sAxis.FgOr(0), fs);
                        labelRight = labelLeft + labelW;
                    }
                }
            }
        }

        // 轴标题
        if (x0.title.Length > 0) {
            c.DrawTextCentered(plotX, plotBot + app.Scale(6) + fh, plotW, fh, x0.title, sAxisTitle.FgOr(0), fs);
        }
        if (y0.title.Length > 0) {
            c.DrawText(plotX, plotTop, y0.title, sAxisTitle.FgOr(0), fs);
        }
        // 右轴标题只在真的存在第二条轴时画（YAxis1 在单轴时会
        // 回退到 YAxis0，不设防会把左轴标题镜像到右上角）。
        if (hasRight && o.yAxes.Count > 1 && y1.title.Length > 0) {
            int yw = Canvas.MeasureText(y1.title, fs);
            c.DrawText(plotX + plotW - yw, plotTop, y1.title, sAxisTitle.FgOr(0), fs);
        }

        return f;
    }
}
