using System;
using System.Json;
using Gui;

namespace Gui.Component.Chart;

/// 纯 Zan 图表库 —— ECharts 2.2.x 的声明性子集，全部用
/// stdlib 组件与确定性的整数几何绘制，无 JS / DOM / WebView：
///   · 17 种原生 series.type：line / bar / pie / scatter / k /
///     radar / chord / force / map / gauge / funnel / eventRiver /
///     treemap / tree / wordCloud / heatmap，外加 custom kind
///     （sankey / box / error / waterfall / sunburst / radialBars /
///     venn）。
///   · 轴：category / value / time（整数天数，表格驱动日期）/
///     log（仅正值、10 的幂刻度），独立左右轴 min/max/reversed。
///   · 交互：hover tooltip、图例切换可见性、dataZoom 窗口、
///     markLine / markPoint / markArea、emphasis（hover）paint。
///   · 确定性：无随机数、无系统时钟；布局/命中/指纹均为整数运算，
///     conformance 测试可逐值断言。
/// Zan 扩展（超出 ECharts 2.2.x 的便捷 API）：ChartOption.Of /
/// OfRings、ChartSeries.Line / Bar / Area / OfRegions / OfEvents /
/// OfBoxes / OfErrors / OfPoints、pieRings 嵌套环、eventRiver 由
/// 数值系列驱动（按类别索引映射时间）、图表数据用 List<int> /
/// ChartData 直接表达。
/// 渲染由 ChartView（partial）分发到每类一个渲染器；所有绘制走
/// ChartOption -> ResolvedChart -> Canvas 管道。
///
/// 内部持有者：计算出的绘图矩形加上解析后的数值轴
/// 范围（左轴 + 可选右轴），使每个渲染器以相同方式
/// 映射数值 -> 像素。leftMin/leftMax 始终有效；rightMin/rightMax 仅在有右轴时有效。
/// leftLog/rightLog 为对数轴（仅正值）；isTime 为时间 X 轴
/// （整数天数，标签由 Chart.TimeLabel 生成）。
class ChartFrame {
    int plotX;
    int plotY;
    int plotW;
    int plotH;
    int leftMin;
    int leftMax;
    int leftMinF;        // 左轴 [lo,hi] ×1000 定点（小数轴专用，lo=hi=0 为整数轴）
    int leftMaxF;
    int rightMin;
    int rightMax;
    int rightMinF;       // 右轴同上（line6 降雨量 -1000..0 定点）
    int rightMaxF;
    bool hasRight;
    bool reversed;       // 左轴翻转
    bool rightReversed;  // 右轴翻转（独立于左轴）
    bool leftLog;        // 左轴对数刻度
    bool rightLog;       // 右轴对数刻度
    bool isTime;         // X 轴时间刻度
    int timeMin;
    int timeMax;
    bool catBoundaryGap; // X 类目轴 boundaryGap（false：点落在刻度线上）
    bool catY;           // Y 轴类目（ECharts 轴互换：数值在 X）
    int xLo;             // X 数值轴范围（catY / 值对折线用）
    int xHi;
    bool leftNegate;     // 左轴刻度/工具提示按 -值 显示（axisLabel.formatter=-v）
    bool rightNegate;    // 右轴同上

    /// 第 i 类目左缘。用 i*W/n 而不是固定 step，余数摊到末格，
    /// 最后一根柱/最后一个标签贴上绘图区右缘。boundaryGap=false
    /// （线落在刻度上）时槽位退化为刻度点：第 i 点 = i*W/(n-1)。
    int CatLeft(int i, int n) {
        if (n < 1) { return this.plotX; }
        if (!this.catBoundaryGap && n > 1) {
            int px = this.plotX + i * this.plotW / (n - 1);
            if (px > this.plotX + this.plotW) { px = this.plotX + this.plotW; }
            return px;
        }
        return this.plotX + i * this.plotW / n;
    }
    /// 第 i 类目的宽度（相邻左缘之差，余数摊在末格）。
    int CatWidth(int i, int n) {
        return this.CatLeft(i + 1, n) - this.CatLeft(i, n);
    }
    /// 第 i 类目的水平中线。
    int CatMid(int i, int n) {
        return this.CatLeft(i, n) + this.CatWidth(i, n) / 2;
    }

    /// 第 i 类目上「数据点」的 x：boundaryGap=true（带状，柱/K 线
    /// 默认）落格子中线；false（刻度线模式，ECharts 折线/散点的
    /// 默认轴形态）落刻度本身——首点贴 y 轴、末点贴绘图区右缘。
    /// 折线/散点/十字线/悬浮提示等点几何一律走这里；柱/K 线继续
    /// 用带状 CatLeft/CatMid。
    int CatX(int i, int n) {
        if (!this.catBoundaryGap && n > 1) { return this.CatLeft(i, n); }
        return this.CatMid(i, n);
    }

    /// 局部类目窗口内的像素 -> 类目索引反解；返回值与
    /// CatLeft/CatMid 使用同一整数分桶规则。
    int CatIndexAt(int px, int n) {
        if (n < 1 || this.plotW < 1) { return 0 - 1; }
        int q = px - this.plotX;
        if (q < 0) { q = 0; }
        if (q >= this.plotW) { q = this.plotW - 1; }
        if (!this.catBoundaryGap && n > 1) {
            // 刻度模式（boundaryGap=false，点贴刻度、末点贴绘图区
            // 右缘）：按等宽 n 格分桶、像素右缘 q+1 落格定类目——
            // ECharts axis tooltip 手感，最后一格也能选中末类目。
            // 带状「最后一个左缘 ≤ 像素」在这里永远够不到 n-1
            // （CatLeft(n-1)=plotW 是开右端点），末类目的
            // tooltip 就再也出不来。
            int fi = (q + 1) * n / this.plotW;
            if (fi > n - 1) { fi = n - 1; }
            return fi;
        }
        // 带状（boundaryGap=true）：CatLeft 用逐项 floor(i*W/n)
        // 分桶；反解必须在同一组边界上找最后一个左缘不超过像素
        // 的位置，不能用 q*n/W（非整除时会在每个余数边界错一格）。
        int lo = 0;
        int hi = n;
        while (lo + 1 < hi) {
            int mid = (lo + hi) / 2;
            if (this.CatLeft(mid, n) <= this.plotX + q) {
                lo = mid;
            } else {
                hi = mid;
            }
        }
        if (lo < 0) { lo = 0; }
        if (lo > n - 1) { lo = n - 1; }
        return lo;
    }

    /// 左轴（axisIndex 0）或右轴（1）上数值对应的像素 Y，
    /// 遵循各轴预设的翻转标志。
    int YOf(int v, int axisIndex) {
        int lo = this.leftMin;
        int hi = this.leftMax;
        bool rev = this.reversed;
        if (axisIndex == 1) { lo = this.rightMin; hi = this.rightMax; rev = this.rightReversed; }
        long span = (long)hi - (long)lo;
        if (span == 0) { span = 1; }
        int d = (int)(((long)v - (long)lo) * (long)this.plotH / span);
        if (rev) { return this.plotY + d; }
        return this.plotY + this.plotH - d;
    }

    /// YOf 的 16.8 定点版本（1/256 px）：堆叠面积带的填充边界走
    /// 亚像素光栅化（FillBandFx），整数 YOf 会把边界量化到整行，
    /// 缓坡上每列硬跳 1 行——正是"面积边缘锯齿"的来源。
    int YOfFx(int v, int axisIndex) {
        int lo = this.leftMin;
        int hi = this.leftMax;
        bool rev = this.reversed;
        if (axisIndex == 1) { lo = this.rightMin; hi = this.rightMax; rev = this.rightReversed; }
        long span = (long)hi - (long)lo;
        if (span == 0) { span = 1; }
        // ×256 定点：大数值时乘积必超 int32（10万×1500×256≈3.8e10）。
        int d = (int)(((long)v - (long)lo) * ((long)this.plotH * 256) / span);
        if (rev) { return (this.plotY + this.plotH) * 256 - d; }
        return this.plotY * 256 + this.plotH * 256 - d;
    }

    /// 小数轴的 Y 映射：v 为 值×1000 定点，leftMinF/leftMaxF（或右轴
    /// rightMinF/rightMaxF）是 ×1000 的轴界（line6 流量 0.86..1.5、
    /// 降雨量 -0.005..-0.955 这类数据在 int Value() 四舍五入后全折成
    /// 1..2 / 0..-1，画成平线）。轴不是小数轴时按整数轴界做定点
    /// 映射：vF=值×1000 对 [lo×1000, hi×1000] 比例映射，整数数据
    /// （vF 恰为 1000 的倍数）与 YOf 逐像素一致，小数数据不再被
    /// vF/1000 截断丢掉小数位。
    int YOfF(int vF, int axisIndex) {
        int loF = this.leftMinF;
        int hiF = this.leftMaxF;
        bool rev = this.reversed;
        if (axisIndex == 1) { loF = this.rightMinF; hiF = this.rightMaxF; rev = this.rightReversed; }
        if (loF == 0 && hiF == 0) {
            int lo = this.leftMin;
            int hi = this.leftMax;
            if (axisIndex == 1) { lo = this.rightMin; hi = this.rightMax; }
            long span = (long)hi - (long)lo;
            if (span == 0) { span = 1; }
            long d = ((long)vF - (long)lo * 1000L) * (long)this.plotH / (span * 1000L);
            if (rev) { return this.plotY + (int)d; }
            return this.plotY + this.plotH - (int)d;
        }
        long spanF = (long)hiF - (long)loF;
        if (spanF == 0) { spanF = 1; }
        int dF = (int)(((long)vF - (long)loF) * (long)this.plotH / spanF);
        if (rev) { return this.plotY + dF; }
        return this.plotY + this.plotH - dF;
    }

    /// YOfF 的 long 版：亿级整值（candlestick-touch 成交量
    /// 8.6e7、成交额）×1000 定点后 8.6e10 必爆 int32，调用方
    /// 以 long 承载定点值走这里；映射体与 YOfF 同式。
    int YOfFL(long vF, int axisIndex) {
        int loF = this.leftMinF;
        int hiF = this.leftMaxF;
        bool rev = this.reversed;
        if (axisIndex == 1) { loF = this.rightMinF; hiF = this.rightMaxF; rev = this.rightReversed; }
        if (loF == 0 && hiF == 0) {
            int lo = this.leftMin;
            int hi = this.leftMax;
            if (axisIndex == 1) { lo = this.rightMin; hi = this.rightMax; }
            long span = (long)hi - (long)lo;
            if (span == 0) { span = 1; }
            long d = (vF - (long)lo * 1000L) * (long)this.plotH / (span * 1000L);
            if (rev) { return this.plotY + (int)d; }
            return this.plotY + this.plotH - (int)d;
        }
        long spanFL = (long)hiF - (long)loF;
        if (spanFL == 0) { spanFL = 1; }
        long dFL = (vF - (long)loF) * (long)this.plotH / spanFL;
        if (rev) { return this.plotY + (int)dFL; }
        return this.plotY + this.plotH - (int)dFL;
    }

    /// 系列所在轴的零线像素（ECharts 面积/柱的填充基线）：
    /// 0 在该轴范围内时返回其映射（钳制进绘图区），否则返回
    /// 绘图区底——与 ECharts「0 不在范围内时填到对侧边缘」一致。
    int ZeroBase(int axisIndex) {
        int lo = this.leftMin;
        int hi = this.leftMax;
        if (axisIndex == 1) { lo = this.rightMin; hi = this.rightMax; }
        if (lo > 0 || hi < 0) { return this.plotY + this.plotH; }
        int zy = this.YOf(0, axisIndex);
        if (zy < this.plotY) { zy = this.plotY; }
        if (zy > this.plotY + this.plotH) { zy = this.plotY + this.plotH; }
        return zy;
    }

    /// 目标值轴（0 左 / 1 右）的 0 像素——axisLine.onZero 骑线的
    /// 落点（cartesianAxisHelper.ts 的 otherAxis.toGlobalCoord(
    /// dataToCoord(0))）。小数轴走 ×1000 定点域保亚像素精度；
    /// 结果钳制进绘图区（官方同样 clamp 进网格矩形）。
    int ZeroLineY(int axisIndex) {
        bool frac = axisIndex == 1
            ? (this.rightMinF != 0 || this.rightMaxF != 0)
            : (this.leftMinF != 0 || this.leftMaxF != 0);
        int zy;
        if (frac) {
            int loF = this.leftMinF;
            int hiF = this.leftMaxF;
            if (axisIndex == 1) { loF = this.rightMinF; hiF = this.rightMaxF; }
            zy = Chart.ValueYF1000(this.plotY, this.plotH, loF, hiF, 0);
        } else {
            zy = this.YOf(0, axisIndex);
        }
        if (zy < this.plotY) { zy = this.plotY; }
        if (zy > this.plotY + this.plotH) { zy = this.plotY + this.plotH; }
        return zy;
    }

    /// X 数值轴（catY / 值 X）的 0 像素——y 轴骑线时的落点，
    /// 同样钳制进绘图区。
    int ZeroLineX() {
        int zx = this.XOfValue(0);
        if (zx < this.plotX) { zx = this.plotX; }
        if (zx > this.plotX + this.plotW) { zx = this.plotX + this.plotW; }
        return zx;
    }

    /// Y 类目轴第 i 槽的垂直中线（轴互换折线的点行）。
    int CatMidY(int i, int n) {
        if (n < 1) { return this.plotY + this.plotH / 2; }
        // ECharts 类目 Y 轴 index 0 在底部（自下而上）。
        if (!this.catBoundaryGap && n > 1) {
            // boundaryGap=false：首尾类目贴绘图区上下缘（刻度线）。
            return this.plotY + this.plotH - i * this.plotH / (n - 1);
        }
        int band = this.plotH / n;
        if (band < 1) { band = 1; }
        int y = this.plotY + this.plotH - (i * band + band / 2);
        if (y < this.plotY) { y = this.plotY; }
        return y;
    }

    /// X 数值轴上数值 v 的像素（轴互换折线 / 值对折线）。
    int XOfValue(int v) {
        return Chart.ValueX(this.plotX, this.plotW, this.xLo, this.xHi, v);
    }

    /// 对数 Y 映射：仅正值（v < 1 钳制到 1），log10 连续线性化后
    /// 按轴范围映射。整数 floor-log10 会把同一数量级内的所有值
    /// 压到同一档（3、5、9 全同高），曲线呈台阶状——官方 type:'log'
    /// 是连续对数。lg 值用 ×1000 定点（Log10F），域差转像素走 long。
    /// 低于/高于范围钳制在绘图区内。
    int YOfLog(int v, int axisIndex) {
        if (v < 1) { v = 1; }
        int lo = this.leftMin;
        int hi = this.leftMax;
        bool rev = this.reversed;
        if (axisIndex == 1) { lo = this.rightMin; hi = this.rightMax; rev = this.rightReversed; }
        if (lo < 1) { lo = 1; }
        if (hi < lo + 1) { hi = lo + 1; }
        long llo = ChartFrame.Log10F(lo);
        long lhi = ChartFrame.Log10F(hi);
        if (lhi <= llo) { lhi = llo + 1000; }
        long d = (ChartFrame.Log10F(v) - llo) * (long)this.plotH / (lhi - llo);
        if (d < 0) { d = 0; }
        if (d > (long)this.plotH) { d = this.plotH; }
        if (rev) { return this.plotY + (int)d; }
        return this.plotY + this.plotH - (int)d;
    }

    /// 同 YOfLog 但参数是 ×1000 定点的对数轴投影，
    /// 供细分刻度（2.8/4.6 这类非整值）用。
    /// 比 YOfLog 的整数口径多一档尾数分辨率。
    int YOfLogF(long vF, int axisIndex) {
        int lo = this.leftMin;
        int hi = this.leftMax;
        bool rev = this.reversed;
        if (axisIndex == 1) { lo = this.rightMin; hi = this.rightMax; rev = this.rightReversed; }
        if (lo < 1) { lo = 1; }
        if (hi < lo + 1) { hi = lo + 1; }
        if (vF < 1000L) { vF = 1000L; }
        long llo = ChartFrame.Log10Fx((long)lo * 1000L);
        long lhi = ChartFrame.Log10Fx((long)hi * 1000L);
        if (lhi <= llo) { lhi = llo + 1000L; }
        long d = (ChartFrame.Log10Fx(vF) - llo) * (long)this.plotH / (lhi - llo);
        if (d < 0L) { d = 0L; }
        if (d > (long)this.plotH) { d = (long)this.plotH; }
        if (rev) { return this.plotY + (int)d; }
        return this.plotY + this.plotH - (int)d;
    }

    /// 10 的整数对数（floor log10），仅正值（v < 1 → 0）。
    static int Log10(int v) {
        if (v < 1) { return 0; }
        int e = 0;
        int p = 1;
        while (p * 10 <= v) { p = p * 10; e = e + 1; }
        return e;
    }

    /// 连续 log10 ×1000 定点（1/1000 档精度），对数轴前向映射用。
    /// lg 整数段逐档 +1000；尾数段 x∈[1,10) 用四段折线近似
    /// （节点 lg(1)=0、lg(3)≈477、lg(6)≈778、lg(10)=1000 的割线），
    /// 最大偏差 <0.03 档——视觉连续，曲线无台阶。纯整数运算。
    static long Log10F(int v) {
        if (v < 1) { return 0; }
        int e = 0;
        int x = v;
        while (x >= 10) {
            int p = 10;
            int se = 1;
            while (x / p >= 10) { p = p * 10; se = se + 1; }
            e = e + se;
            x = x / p;
        }
        long frac;
        if (x < 3) {
            frac = (long)(x - 1) * 239;
        } else if (x < 6) {
            frac = 477 + (long)(x - 3) * 100;
        } else {
            frac = 778 + (long)(x - 6) * 74;
        }
        return (long)e * 1000 + frac;
    }

    /// Log10F 的 ×1000 定点入口版：参数也是定点
    /// （v×1000），尾数段不再被整除截成整数。
    /// 折线节点与 Log10F 同源（lg1=0、lg3≈478、
    /// lg6≈778、lg10=1000），所以对整数点两者
    /// 输出完全一致（Log10Fx(8000*1000)==Log10F(8000)）。
    static long Log10Fx(long vF) {
        if (vF < 1000L) { return 0L; }
        long e = 0L;
        long x = vF;
        while (x >= 10000L) { x = x / 10L; e = e + 1L; }
        long frac;
        if (x < 3000L) { frac = (x - 1000L) * 477L / 2000L; }
        else if (x < 6000L) { frac = 477L + (x - 3000L) * 301L / 3000L; }
        else { frac = 778L + (x - 6000L) * 296L / 4000L; }
        return e * 1000L + frac;
    }

    /// 线性/对数 Y 的像素 -> 值域反解。对数轴与当前
    /// floor-log10 前向映射保持一致，返回所在十进制段的下界。
    int ValueAtY(int py, int axisIndex) {
        int lo = this.leftMin;
        int hi = this.leftMax;
        bool rev = this.reversed;
        bool log = this.leftLog;
        if (axisIndex == 1) {
            lo = this.rightMin; hi = this.rightMax;
            rev = this.rightReversed; log = this.rightLog;
        }
        if (this.plotH < 1) { return lo; }
        int q = py - this.plotY;
        if (q < 0) { q = 0; }
        if (q > this.plotH) { q = this.plotH; }
        if (log) {
            if (lo < 1) { lo = 1; }
            if (hi < lo + 1) { hi = lo + 1; }
            // 与连续前向映射（Log10F）同解：定点 lg 值回推所在
            // 十进制段的下界（精度对齐 YOfLog 的 1/1000 档）。
            long llo = ChartFrame.Log10F(lo);
            long lhi = ChartFrame.Log10F(hi);
            if (lhi <= llo) { lhi = llo + 1000; }
            long d = rev ? q : this.plotH - q;
            long e = llo + d * (lhi - llo) / this.plotH;
            int seg = (int)(e / 1000);
            int v = Chart.Pow10(seg);
            if (v < lo) { v = lo; }
            if (v > hi) { v = hi; }
            return v;
        }
        int d = rev ? q : this.plotH - q;
        long span = (long)hi - (long)lo;
        if (span == 0) { span = 1; }
        return lo + (int)((long)d * span / (long)this.plotH);
    }

    /// 时间 X 映射：整数时间值 → 像素 x，钳制在绘图区内。
    /// 时间跨度（秒/毫秒）× plotW 轻易超 int32，乘法走 long。
    int XOfTime(int t) {
        int lo = this.timeMin;
        int hi = this.timeMax;
        long span = (long)hi - (long)lo;
        if (span == 0) { span = 1; }
        int d = (int)(((long)t - (long)lo) * (long)this.plotW / span);
        if (d < 0) { d = 0; }
        if (d > this.plotW) { d = this.plotW; }
        return this.plotX + d;
    }

    /// 像素 Y → 数值文本（左/右轴，follows negate 标志）。轴是
    /// 小数轴（leftMinF/rightMinF 生效）时按 1/1000 定点输出小数，
    /// 整数轴与原 Commas 行为一致。
    string ValueTextAtY(int py, int axisIndex) {
        int loF = this.leftMinF;
        int hiF = this.leftMaxF;
        bool rev = this.reversed;
        bool yNeg = this.leftNegate;
        if (axisIndex == 1) { loF = this.rightMinF; hiF = this.rightMaxF; rev = this.rightReversed; yNeg = this.rightNegate; }
        int q = py - this.plotY;
        if (q < 0) { q = 0; }
        if (q > this.plotH) { q = this.plotH; }
        int d = rev ? q : this.plotH - q;
        if (loF != 0 || hiF != 0) {
            long vf = (long)loF + (long)d * ((long)hiF - (long)loF) / this.plotH;
            return Chart.FracText(yNeg ? (int)(0 - vf) : (int)vf);
        }
        int v = this.ValueAtY(py, axisIndex);
        return Chart.Commas(yNeg ? 0 - v : v);
    }
}

/// 图表的虚拟、拉取式数据源——图表无需持有
/// 原始点数组，数百万点的系列也不产生逐单元对象
/// 分配（对应 DataTable 的 DataSource）。子类化它，
/// 按需从自己的列式/类型化存储读取点，或用 SeriesListSource 包装
/// 内存中的 List<ChartSeries>。
class ChartSource {
    /// 系列数。
    virtual int SeriesCount() { return 0; }
    /// 系列 s 的名称。
    virtual string SeriesName(int s) { return ""; }
    /// 系列 s 的颜色；0 = 自动（调色板）。
    virtual int SeriesColor(int s) { return 0; }   // 0 = 自动（调色板）
    /// 系列 s 的数据点数。
    virtual int PointCount(int s) { return 0; }
    /// 系列 s 第 i 点的数值。
    virtual int ValueAt(int s, int i) { return 0; }
}

/// 适配器：把已有的 List<ChartSeries> 暴露为 ChartSource，
/// 高性能路径直接接受内存数据，无需重构。
class SeriesListSource : ChartSource {
    List<ChartSeries> series;

    /// 包装内存系列列表（直接持有引用，不复制）。
    static SeriesListSource Of(List<ChartSeries> series) {
        SeriesListSource s = new SeriesListSource();
        s.series = series;
        return s;
    }

    /// 系列数 = 内存列表长度。
    override int SeriesCount() { return this.series.Count; }
    /// 系列 s 的名称。
    override string SeriesName(int s) { return this.series[s].name; }
    /// 系列显式色，其次 itemStyle.normal.color，否则 0（调色板）。
    override int SeriesColor(int s) {
        ChartSeries item = this.series[s];
        if (item.color != 0) { return item.color; }
        if (item.itemStyle != null && item.itemStyle.normal != null
            && item.itemStyle.normal.color != 0) {
            return item.itemStyle.normal.color;
        }
        return 0;
    }
    /// 系列 s 的数据点数。
    override int PointCount(int s) { return this.series[s].Count(); }
    /// 系列 s 第 i 点的数值。
    override int ValueAt(int s, int i) { return this.series[s].Value(i); }
}

/// ChartView 渲染器共享的绘图工具：颜色、比例辅助、
/// 面板/图例框架、dataZoom 滑块、标记线/区域、直角坐标系和
/// 双轴坐标构建器。一次性的静态渲染器（Chart.Line/
/// Bar/Pie/...）已移除——所有图表现在声明为 ChartOption
/// 并由 ChartView 绘制。
class Chart {

    // ---- 颜色 ----

    /// 不透明 0xFFRRGGBB 打包为正 int（Canvas 转 u32）。
    /// r/g/b 各 0..255。
    static int Rgb(int r, int g, int b) {
        return (int)4278190080 + r * 65536 + g * 256 + b;
    }

    /// 与打包不透明颜色相同的 RGB，但替换 alpha（0 透明..255 不透明，
    /// 用于面积/扇区填充）。
    static int WithAlpha(int packed, int a) {
        return (packed - (int)4278190080) + a * 16777216;
    }

    /// ECharts 'transparent'：alpha 1/255 的白色——合成后每通道
    /// 偏移 ≤1，视觉不可见；取非 0 值是为了不与"0 = 继承系列色"
    /// 的图表着色语义冲突（瀑布图透明占位柱）。
    static int Transparent() {
        return Chart.WithAlpha(Chart.Rgb(255, 255, 255), 1);
    }

    /// 在 `bg` 上对比足够的前景：浅底深字、深底白字。
    /// 饼图扇区 / 地图填色上的标签用它，避免白字画在黄块上。
    static int ContrastFg(int bg) {
        int r = bg >> 16 & 255;
        int g = bg >> 8 & 255;
        int b = bg & 255;
        int lum = (r * 299 + g * 587 + b * 114) / 1000;
        if (lum > 155) { return Chart.Rgb(32, 36, 42); }
        return Chart.Rgb(255, 255, 255);
    }

    // ---- emphasis.focus 渐隐（帧内静态，ChartView 每帧重算） ----

    /// 本帧悬停且声明 emphasis.focus:'series' 的系列下标；-1 =
    /// 无聚焦。ChartView 绘制入口在重置命中前用上一帧 currentHit
    /// 重算（渲染期会重测命中），渲染器逐系列经 FadeFocusColor 查表。
    static int fadeFocusIdx = -1;

    /// 官方 blur 残透明：ECharts focus 聚焦时非聚焦系列乘默认
    /// blur opacity 0.1（bump 图悬停其余线淡出的量）。
    static int FadeFocusAlpha() { return 26; }

    /// 聚焦渐隐取色：无聚焦或 si 即聚焦系列时原色返回，其余
    /// 系列乘残透明。
    static int FadeFocusColor(int si, int color) {
        if (Chart.fadeFocusIdx < 0 || si == Chart.fadeFocusIdx) { return color; }
        return Chart.WithAlpha(color, Chart.FadeFocusAlpha());
    }

    /// 本帧工具箱占用的右上角宽度；DrawPanelI / PanelHead 让开它。
    static int toolReserve;

    /// 本帧 option（图例子字段 orient/selectedMode/formatter 的来源）；
    /// Render() 分派前置位，与 toolReserve 同为帧内静态。
    static ChartOption legendOpt;
    /// 本帧水平图例占用的底部高度（ECharts 6 默认图例在底部，
    /// BuildAxesR 从绘图区底边扣除；竖排图例在顶部占位，此值为 0）。
    static int legendBottomReserve;
    /// 多 grid 子面板帧内约定（DrawMultiGridPanels 置位/复位）：
    /// grid 矩形是纯绘图区，标题/工具箱是页级元素由派发层画一次，
    /// 子面板不再按 PanelContentTop 预留头部（96px 成交量条带曾被
    /// 59px 头部啃到 30px 绘图区）。
    static bool gridPanelSub;
    /// 多 grid 子面板：zoom 窗口全格生效（官方 dataZoom
    /// xAxisIndex:[0,1] 同窗联动），但滑条条带只随最后一个 grid
    /// 画一次——非末格置位，视图据它跳过 zoomH 预留与 DrawZoomBar。
    static bool zoomBarHidden;

    /// 多段线性色带插值（visualMap inRange）：t ∈ [0,1000] 均匀映射
    /// 到 colors 首尾之间，段内线性混合。colors 少于 2 个时取首色。
    static int RampAt(List<int> colors, int t) {
        int n = colors.Count;
        if (n < 1) { return 0; }
        if (n == 1 || t <= 0) { return colors[0]; }
        if (t >= 1000) { return colors[n - 1]; }
        int seg = (n - 1) * t / 1000;
        int f = ((n - 1) * t) % 1000;
        int a = colors[seg];
        int b = colors[seg + 1];
        int r = (a >> 16 & 255) + ((b >> 16 & 255) - (a >> 16 & 255)) * f / 1000;
        int g = (a >> 8 & 255) + ((b >> 8 & 255) - (a >> 8 & 255)) * f / 1000;
        int bl = (a & 255) + ((b & 255) - (a & 255)) * f / 1000;
        return Chart.Rgb(r, g, bl);
    }

    /// 定性调色板第 i 档：图表皮肤（ChartSkin）优先——图表配色是
    /// 独立板块，不占全局皮肤主题的 token；当前皮肤 8 档齐全，
    /// 命中即返回。皮肤之后依次是主题的 --chart-1 .. --chart-8
    /// token（Theme.chart1..8，0 = 该槽位未定义）与 ECharts 6.1
    /// 默认主题调色板（src/visual/tokens.ts，9 档）兜底。
    static int Palette(Theme t, int i) {
        int skc = ChartSkin.ColorAt(ChartSkin.Current(), i);
        if (skc != 0) { return skc; }
        int m = i % 8;
        if (t != null) {
            if (m == 0 && t.chart1 != 0) { return t.chart1; }
            if (m == 1 && t.chart2 != 0) { return t.chart2; }
            if (m == 2 && t.chart3 != 0) { return t.chart3; }
            if (m == 3 && t.chart4 != 0) { return t.chart4; }
            if (m == 4 && t.chart5 != 0) { return t.chart5; }
            if (m == 5 && t.chart6 != 0) { return t.chart6; }
            if (m == 6 && t.chart7 != 0) { return t.chart7; }
            if (m == 7 && t.chart8 != 0) { return t.chart8; }
        }
        // ECharts 6.1 默认主题调色板（src/visual/tokens.ts color.theme，
        // 9 档；v5 及更早为 #5470c6 系 9 档，2.2 为 #c12c2b 系 8 档）。
        int m9 = i % 9;
        if (m9 == 0) { return Chart.Rgb(80, 112, 221); }   // #5070DD
        if (m9 == 1) { return Chart.Rgb(182, 214, 52); }   // #B6D634
        if (m9 == 2) { return Chart.Rgb(80, 83, 114); }    // #505372
        if (m9 == 3) { return Chart.Rgb(255, 153, 77); }   // #FF994D
        if (m9 == 4) { return Chart.Rgb(12, 168, 223); }   // #0CA8DF
        if (m9 == 5) { return Chart.Rgb(255, 209, 10); }   // #FFD10A
        if (m9 == 6) { return Chart.Rgb(251, 98, 139); }   // #FB628B
        if (m9 == 7) { return Chart.Rgb(120, 93, 176); }   // #785DB0
        return Chart.Rgb(63, 190, 149);                    // #3FBE95
    }

    /// 系列普通状态的统一颜色回退：显式系列色、normal.color、调色板。
    /// ResolvedChart 会把结果物化到 series.color；此 seam 也保护
    /// DrawPanelI 与 ChartBig 这类可直接接收原始 series 的路径。
    static int SeriesPaintColor(ChartSeries s, Theme t, int index) {
        if (s != null) {
            if (s.color != 0) { return s.color; }
            if (s.itemStyle != null && s.itemStyle.normal != null
                && s.itemStyle.normal.color != 0) {
                return s.itemStyle.normal.color;
            }
        }
        return Chart.Palette(t, index);
    }

    /// 符号形状族绘制（ECharts series.symbol）：shape 取
    /// circle（默认实心圆）/ emptyCircle（环）/ rectangle / diamond /
    /// triangle。r 为外接半径；borderWidth>0 时用 borderColor 描边。
    /// 全部为不透明覆盖、无二次混合，指纹稳定。
    static void DrawSymbol(Canvas c, int cx, int cy, int r, string shape,
                           int color, int borderColor, int borderWidth) {
        if (shape == "none" || shape == "pass") { return; }
        if (r < 1) { r = 1; }
        if (shape == "rectangle") {
            int d = r * 71 / 100;  // 内接正方形半边（与圆同视觉重量）
            c.FillRect(cx - d, cy - d, d * 2 + 1, d * 2 + 1, color);
        } else if (shape == "diamond") {
            for (int dy = 0 - r; dy <= r; dy = dy + 1) {
                int hw = r - (dy < 0 ? 0 - dy : dy);
                c.FillRect(cx - hw, cy + dy, hw * 2 + 1, 1, color);
            }
        } else if (shape == "triangle") {
            // 上顶点，底边在下：行 r0 距顶点 dy，半宽 = r * dy / r。
            for (int dy = 0 - r; dy <= r; dy = dy + 1) {
                int hw = (r * (dy + r)) / (2 * r);
                if (hw < 0) { hw = 0; }
                c.FillRect(cx - hw, cy + dy, hw * 2 + 1, 1, color);
            }
        } else if (shape == "star" || shape == "star5" || shape == "star6"
                   || shape == "arrow"
                   || shape == "droplet" || shape == "pin"
                   || shape == "emptypin"
                   || shape == "heart" || shape == "emptyheart") {
            // ECharts 2.2.x 其余符号形状：顶点多边形扫描线填充
            // （顶点表见 Chart.PolyVerts1000）。empty* 变体按原语义
            // 画白芯（getSymbolShape：empty 符号 color='#fff' 填充、
            // 色环即本体，环宽缺省 2）。
            List<int> vx = new List<int>();
            List<int> vy = new List<int>();
            Chart.PolyVerts1000(shape, vx, vy);
            Chart.FillPoly1000(c, cx, cy, r, vx, vy, color);
            if (shape == "emptypin" || shape == "emptyheart") {
                int ew = borderWidth > 0 ? borderWidth : 2;
                if (r > ew) {
                    Chart.FillPoly1000(c, cx, cy, r - ew, vx, vy, 4294967295);
                }
            }
        } else if (shape == "emptyCircle") {
            // ECharts emptyCircle：白芯 + 色环（折线 emptyColor '#fff'，
            // 环宽 = borderWidth，缺省取 lineStyle.width，再缺省 2）。
            // 填充圆在像素中心采样下 dx=r 的格点覆盖为 0（外缘半像素
            // 落空），白芯抹掉内圈后色环缩进 1px——DrawCircle 在半径
            // 处再描 1px 把外缘补齐，测试与视觉的环外径都回到 r。
            int ew = borderWidth > 0 ? borderWidth : 2;
            c.FillCircle(cx, cy, r, color);
            if (r > ew) { c.FillCircle(cx, cy, r - ew, 4294967295); }
            c.DrawCircle(cx, cy, r, color, 1);
        } else {
            c.FillCircle(cx, cy, r, color);
        }
        if (borderWidth > 0 && borderColor != 0) {
            if (shape == "rectangle" || shape == "diamond" || shape == "triangle") {
                List<int> xs = new List<int>();
                List<int> ys = new List<int>();
                if (shape == "rectangle") {
                    int d = r * 71 / 100;
                    xs.Add(cx - d); ys.Add(cy - d);
                    xs.Add(cx + d); ys.Add(cy - d);
                    xs.Add(cx + d); ys.Add(cy + d);
                    xs.Add(cx - d); ys.Add(cy + d);
                } else if (shape == "diamond") {
                    xs.Add(cx); ys.Add(cy - r);
                    xs.Add(cx + r); ys.Add(cy);
                    xs.Add(cx); ys.Add(cy + r);
                    xs.Add(cx - r); ys.Add(cy);
                } else {
                    xs.Add(cx); ys.Add(cy - r);
                    xs.Add(cx + r); ys.Add(cy + r);
                    xs.Add(cx - r); ys.Add(cy + r);
                }
                xs.Add(xs[0]); ys.Add(ys[0]);
                c.DrawPolyline(xs, ys, borderColor, borderWidth);
            } else if (shape == "emptyCircle") {
                c.DrawCircle(cx, cy, r, borderColor, borderWidth);
            } else {
                c.DrawCircle(cx, cy, r, borderColor, borderWidth);
            }
        }
    }

    /// symbolSize -> 外接半径。ECharts2 语义 symbolSize 是「半宽
    /// （半径）参数」（config.js markPoint 注释：总宽度为
    /// symbolSize * 2），传入值本身就是半径，不再折半。
    static int SymbolRadius(int symbolSize, int defaultR) {
        if (symbolSize > 0) {
            // ECharts symbolSize 是符号直径（bump-chart 20 → 半径
            // 10）。此前当半径用，全部符号放大一倍。
            return symbolSize / 2;
        }
        return defaultR;
    }

    /// ECharts `chart/line/LineView.ts:472-492 canShowAllSymbolForCategory`：
    /// 类目轴每格可用宽度 `availSize = plotW / n`，抽样至多 5 个数据点，
    /// 任一点的符号尺寸 × 1.5（源码注 "Empirical number"）超过 availSize
    /// 即判定"放不下全量符号"。`showAllSymbol:'auto'`（缺省）靠它决定是否
    /// 按标签间隔抽稀——源码注释 "we show all symbols as possible as we
    /// can"，即能放就全放；把"标签放不下 ⇒ 符号也不放"当默认是错的。
    /// `symbolSizeF` = 系列符号直径（device 像素，调用方已 app.Scale）；
    /// `data`/`i0`/`dpiScale` 给逐点 symbolSize 覆盖（源码
    /// `getSymbolSize(data, dataIndex)`），逐点值同样折成 device 像素再比。
    /// 只抽样读，不物化整表（密集线 3079 点每帧都走这条）。
    static bool CanShowAllSymbolForCategory(int plotW, int n, int symbolSizeF,
                                           List<ChartData> data, int i0,
                                           int dpiScale) {
        if (n < 1) { return true; }
        int availSize = plotW / n;
        int step = n / 5;
        if (step < 1) { step = 1; }
        for (int i = 0; i < n; i = i + step) {
            int sz = symbolSizeF;
            int di = i0 + i;
            if (data != null && di >= 0 && di < data.Count
                && data[di].sizeSet && data[di].size > 0) {
                sz = data[di].size * dpiScale / 100;
            }
            if (sz * 3 / 2 > availSize) { return false; }
        }
        return true;
    }

    /// 符号形状的顶点表（千分比相对坐标，y 向下为正），由
    /// FillPoly1000 缩放到像素。star = 五角星（内接比 382），
    /// star6 = 六角星（内接比 577 ≈ 1/√3），arrow = 上指箭镞，
    /// droplet = 上尖水滴，heart = 心形（zrender Heart 贝塞尔
    /// 采样近似：底尖在下、双瓣在上），pin/emptypin = 地图气球。
    static void PolyVerts1000(string shape, List<int> vx, List<int> vy) {
        if (shape == "star" || shape == "star5") {
            int[] px = new int[] { 0, 225, 951, 363, 588, 0, -588, -363, -951, -225 };
            int[] py = new int[] { -1000, -309, -309, 118, 809, 382, 809, 118, -309, -309 };
            for (int i = 0; i < px.Length; i = i + 1) { vx.Add(px[i]); vy.Add(py[i]); }
        } else if (shape == "star6") {
            int[] px = new int[] { 0, 289, 866, 577, 866, 289, 0, -289, -866, -577, -866, -289 };
            int[] py = new int[] { -1000, -500, -500, 0, 500, 500, 1000, 500, 500, 0, -500, -500 };
            for (int i = 0; i < px.Length; i = i + 1) { vx.Add(px[i]); vy.Add(py[i]); }
        } else if (shape == "arrow") {
            vx.Add(0); vy.Add(-1000);
            vx.Add(1000); vy.Add(430);
            vx.Add(0); vy.Add(140);
            vx.Add(-1000); vy.Add(430);
        } else if (shape == "droplet") {
            int[] px = new int[] { 0, -400, -790, -1000, -790, -400, 0, 400, 790, 1000, 790, 400 };
            int[] py = new int[] { -1000, -500, -180, 150, 480, 730, 820, 730, 480, 150, -180, -500 };
            for (int i = 0; i < px.Length; i = i + 1) { vx.Add(px[i]); vy.Add(py[i]); }
        } else if (shape == "heart" || shape == "emptyheart") {
            // 心形：zrender Heart（a=w/2、b=0.8h、内尖锚在 0.2h 高度）
            // 两条贝塞尔的采样近似，底尖 (0,1000)、顶瓣 ±(1008,-331)。
            int[] px = new int[] { 0, 500, 914, 1008, 872, 599, 277, 0,
                -277, -599, -872, -1008, -914, -500 };
            int[] py = new int[] { 1000, 667, 151, -331, -711, -927, -910,
                -600, -910, -927, -711, -331, 151, 667 };
            for (int i = 0; i < px.Length; i = i + 1) { vx.Add(px[i]); vy.Add(py[i]); }
        } else {
            // pin / emptypin：气球头（全径圆） + 下尖尾
            int[] px = new int[] { 0, -545, -920, -575, 0, 575, 920, 545 };
            int[] py = new int[] { 1000, 120, -300, -830, -960, -830, -300, 120 };
            for (int i = 0; i < px.Length; i = i + 1) { vx.Add(px[i]); vy.Add(py[i]); }
        }
    }

    /// 顶点多边形扫描线填充（偶奇规则）：顶点为千分比相对坐标，
    /// 逐行求交点、成对 FillRect。顶点数 ≤ 12，插入排序开销可忽略。
    static void FillPoly1000(Canvas c, int cx, int cy, int r,
                             List<int> vx, List<int> vy, int color) {
        int vn = vx.Count;
        if (vn < 3 || r < 1) { return; }
        int ymin = vy[0];
        int ymax = vy[0];
        for (int i = 1; i < vn; i = i + 1) {
            if (vy[i] < ymin) { ymin = vy[i]; }
            if (vy[i] > ymax) { ymax = vy[i]; }
        }
        for (int py = ymin; py <= ymax; py = py + 1) {
            List<int> xs = new List<int>();
            for (int i = 0; i < vn; i = i + 1) {
                int j = i + 1 == vn ? 0 : i + 1;
                int y1 = vy[i];
                int y2 = vy[j];
                if ((y1 <= py && y2 > py) || (y2 <= py && y1 > py)) {
                    xs.Add(vx[i] + (py - y1) * (vx[j] - vx[i]) / (y2 - y1));
                }
            }
            for (int a = 1; a < xs.Count; a = a + 1) {
                int key = xs[a];
                int b = a - 1;
                while (b >= 0 && xs[b] > key) { xs[b + 1] = xs[b]; b = b - 1; }
                xs[b + 1] = key;
            }
            for (int p = 0; p + 1 < xs.Count; p = p + 2) {
                int x0 = cx + xs[p] * r / 1000;
                int x1 = cx + xs[p + 1] * r / 1000;
                int sy = cy + py * r / 1000;
                c.FillRect(x0, sy, x1 - x0 + 1, 1, color);
            }
        }
    }

    /// axisLabel.interval 语义（ECharts）：-1/非整数 = 自动（渲染器
    /// 走防重叠贪心），>=0 = 每 (interval+1) 个画一个。纯函数，
    /// conformance 直接断言。
    static bool LabelShown(int ci, int interval) {
        if (interval < 0) { return true; }
        return ci % (interval + 1) == 0;
    }

    /// 类目轴 auto 抽稀的共用判定：返回窗口内实际显示标签的类目
    /// 下标（升序）。ECharts 2 中 axisLabel.interval 缺省 'auto'，
    /// splitLine 与折线拐点符号（isMainIdx）与标签同源——密集类目
    /// 轴的竖网格和符号都只落在显示标签的刻度上，不再逐类目一条
    ///（雨量图 3079 点曾把竖线糊成整幅灰罩、折线满线小圆点）。
    /// 规则与 BuildAxesR 标签绘制一致：显式 interval 走 LabelShown、
    /// 旋转标签不抽稀、刻度模式（boundaryGap=false）首标签豁免
    ///（ECharts 始终画边界刻度），其余贪心让位。
    static List<int> CategoryTicks(ChartFrame f, List<string> labels, int fs,
                                    int plotX, int labelGap, ChartAxis x0) {
        List<int> shown = new List<int>();
        int n = labels.Count;
        if (f == null || n < 1) { return shown; }
        bool tickX = !f.catBoundaryGap && n > 1;
        int labelRight = plotX - labelGap;
        // 预抽稀步长（与 DrawFrameLoHiT 同一病灶）：candlestick-
        // large 成交量面板 2.2 万条类目，逐条 Replace+MeasureText
        // ≈ 0.7s/帧。自动间隔且不旋转时按估宽 24px 跳步，只对候
        // 选量宽；显式 interval / 旋转标签保留原语义。
        int stride = 1;
        if (n > 1 && x0.labelRotate == 0 && x0.labelInterval < 0) {
            stride = (n * Canvas.FontHeight(fs) + f.plotW - 1) / f.plotW;
            if (stride < 1) { stride = 1; }
        }
        for (int ci = 0; ci < n; ci = ci + stride) {
            string lab = labels[ci];
            if (x0.labelFormatter.Length > 0) {
                lab = x0.labelFormatter.Replace("{value}", lab);
            }
            // 富文本轴标签量宽用剥壳文本（图标宽不进文本测量——
            // 图标段是 backgroundColor image，本引擎退化留白）。
            if (x0.labelSt != null && x0.labelSt.rich != null) {
                lab = Chart.RichStrip(lab);
            }
            int labelW = Canvas.MeasureText(lab, fs);
            int cxs = f.CatLeft(ci, n);
            int cellW = f.CatWidth(ci, n);
            int labelLeft = tickX ? cxs - labelW / 2
                : cxs + (cellW - labelW) / 2;
            if (!tickX && labelLeft < cxs) { labelLeft = cxs; }
            bool show;
            if (x0.labelInterval >= 0) {
                show = Chart.LabelShown(ci, x0.labelInterval);
            } else if (x0.labelRotate != 0) {
                show = true;
            } else {
                show = (tickX && ci == 0)
                    || labelLeft >= labelRight + labelGap;
            }
            if (show) {
                shown.Add(ci);
                labelRight = labelLeft + labelW;
            }
        }
        return shown;
    }

    /// 旋转分类标签的竖直占位（像素）：行盒 w×h 绕锚点旋转
    /// |deg| 度后的垂直跨度 = w·|sin| + h·|cos|。用 ChartView 的
    /// 1000 倍三角表，确定性整数。
    static int RotatedLabelH(int maxW, int fh, int deg) {
        int a = deg < 0 ? 0 - deg : deg;
        if (a > 90) { a = 90; }
        int s = ChartView.SinDeg(a);
        int co = a >= 90 ? 0 : ChartView.CosDeg(a);
        return (maxW * s + fh * co) / 1000 + 2;
    }

    // ---- 比例辅助 ----

    /// 将原始最大值向上取整为友好的轴上界（2/5/10 * 10^n）：
    /// 37 -> 50、830 -> 1000。<=5 时返回 5。
    static int NiceMax(int v) {
        if (v <= 5) { return 5; }
        int mag = 1;
        while (mag * 10 <= v) { mag = mag * 10; }
        int unit = v / mag;
        int nice = 10;
        if (unit < 2) { nice = 2; } else if (unit < 5) { nice = 5; }
        return nice * mag;
    }

    // ======== ECharts 6.1 scale 基元（逐函数照抄，勿改语义）========
    // 源：_scratch/echarts-master/src/util/number.ts 与 src/scale/helper.ts
    // 上面那个 NiceMax(int) 是本仓库手写的旧近似（`<=5 → 5` 特例 +
    // 2/5/10 阶梯），与 ECharts 不符；下面 NiceD/NiceMode 才是对照源
    // 的忠实物。保留旧函数以便逐步迁移调用点。

    /// `number.ts:581 quantityExponent(val)`——十进制指数。
    /// 9876→3，0.09876→-2，0.0012→-3。val=0 按源码返回 0。
    /// 注意源码用 mathFloor；(int) 是向零截断，负数会差 1
    /// （log10(0.0012) = -2.92，必须 -3），故显式下取整。
    static int QuantityExponent(double val) {
        if (val == 0.0) { return 0; }
        double av = val < 0.0 ? 0.0 - val : val;
        double lg = Math.Log(av) / 2.302585092994046;
        int exp = (int)lg;
        if ((double)exp > lg) { exp = exp - 1; }
        // 源码 :594——Math.log 精度损失用 10^exp 还原，必要时 +1
        if (av / Chart.Pow10D(exp) >= 10.0) { exp = exp + 1; }
        return exp;
    }

    /// 10 的整数次幂（源码 Math.pow(10,e)，整数指数无舍入误差）。
    /// D 后缀避开本文件既有的 int 版 Pow10。
    static double Pow10D(int e) {
        double r = 1.0;
        int n = e < 0 ? 0 - e : e;
        for (int i = 0; i < n; i = i + 1) { r = r * 10.0; }
        return e < 0 ? 1.0 / r : r;
    }

    /// `number.ts:222 round(x, precision)` = `+x.toFixed(precision)`；
    /// precision 钳到 [0,20]（TO_FIXED_SUPPORTED_PRECISION_MAX）。
    static double RoundP(double x, int precision) {
        int p = precision < 0 ? 0 : precision;
        if (p > 20) { p = 20; }
        double sc = Chart.Pow10D(p);
        double v = x * sc;
        double r = v >= 0.0 ? (double)(long)(v + 0.5) : (double)(long)(v - 0.5);
        return r / sc;
    }

    /// `number.ts:297 getPrecisionSafe(val)`——字符串法小数位数。
    static int GetPrecisionSafe(double val) {
        string s = val.ToString();
        int eIdx = s.IndexOf('e');
        if (eIdx < 0) { eIdx = s.IndexOf('E'); }
        int exp = 0;
        int sigLen = s.Length;
        if (eIdx > 0) {
            exp = int.Parse(s.Substring(eIdx + 1));
            sigLen = eIdx;
        }
        int dot = s.IndexOf('.');
        int decLen = dot < 0 ? 0 : sigLen - 1 - dot;
        int r = decLen - exp;
        return r > 0 ? r : 0;
    }

    /// `number.ts:265 getPrecision(val)`——快路径 15 次循环，
    /// 否则退字符串法。
    static int GetPrecision(double val) {
        double av = val < 0.0 ? 0.0 - val : val;
        if (av > 1e-14) {
            double e = 1.0;
            for (int i = 0; i < 15; i = i + 1) {
                double v = av * e;
                double r = v >= 0.0 ? (double)(long)(v + 0.5) : (double)(long)(v - 0.5);
                if (r / e == av) { return i; }
                e = e * 10.0;
            }
        }
        return Chart.GetPrecisionSafe(av);
    }

    /// `helper.ts:147 getIntervalPrecision(niceInterval)`
    /// = getPrecision(interval) + 2。刻度标签小数位数由它决定。
    static int GetIntervalPrecision(double niceInterval) {
        return Chart.GetPrecision(niceInterval) + 2;
    }

    /// `number.ts:613 nice(val, mode)`。roundMode=true 走
    /// NICE_MODE_ROUND（helper.ts:103 的调用点）：
    ///   f<1.5→1  f<2.5→2  f<4→3  f<7→5  else→10
    /// false 走 mode=0 分支：f<1→1 f<2→2 f<3→3 f<5→5 else→10。
    /// 校验值（已对源逐值核过）：nice(1.4)=1 nice(3.7)=3 nice(7.2)=10
    /// nice(0.36)=0.3 nice(0.0012)=0.001 nice(70.1598)=100
    static double NiceD(double val) {
        return Chart.NiceMode(val, true);
    }
    static double NiceMode(double val, bool roundMode) {
        double av = val < 0.0 ? 0.0 - val : val;
        if (av == 0.0) { return 0.0; }
        int exponent = Chart.QuantityExponent(av);
        double exp10 = Chart.Pow10D(exponent);
        double f = av / exp10;
        double nf = 10.0;
        if (roundMode) {
            if (f < 1.5) { nf = 1.0; }
            else if (f < 2.5) { nf = 2.0; }
            else if (f < 4.0) { nf = 3.0; }
            else if (f < 7.0) { nf = 5.0; }
            else { nf = 10.0; }
        } else {
            if (f < 1.0) { nf = 1.0; }
            else if (f < 2.0) { nf = 2.0; }
            else if (f < 3.0) { nf = 3.0; }
            else if (f < 5.0) { nf = 5.0; }
            else { nf = 10.0; }
        }
        int p = 0 - exponent;
        if (p < 0) { p = 0; }
        double r = Chart.RoundP(nf * exp10, p);
        return val < 0.0 ? 0.0 - r : r;
    }

    /// `helper.ts:93 intervalScaleNiceTicks(extent, span, splitNumber,
    /// minInterval, maxInterval)`。
    ///   interval  = nice(span/splitNumber, ROUND)
    ///   precision = getIntervalPrecision(interval)
    ///   niceTickExtent = [round(ceil(e0/interval)·interval, precision),
    ///                     round(floor(e1/interval)·interval, precision)]
    /// minInterval/maxInterval 传 ChartOption.AutoD() 表示不设。
    static void IntervalScaleNiceTicks(double e0, double e1, int splitNumber,
                                       double minInterval, double maxInterval,
                                       out double interval, out int precision,
                                       out double nt0, out double nt1) {
        double span = e1 - e0;
        double sp = splitNumber > 0 ? span / (double)splitNumber : span;
        interval = Chart.NiceMode(sp, true);
        if (!ChartOption.IsAutoD(minInterval) && interval < minInterval) {
            interval = minInterval;
        }
        if (!ChartOption.IsAutoD(maxInterval) && interval > maxInterval) {
            interval = maxInterval;
        }
        precision = Chart.GetIntervalPrecision(interval);
        if (interval == 0.0) { nt0 = e0; nt1 = e1; return; }
        nt0 = Chart.RoundP(Math.Ceiling(e0 / interval) * interval, precision);
        nt1 = Chart.RoundP(Math.Floor(e1 / interval) * interval, precision);
    }

    /// `Interval.ts:183 getTicks()` —— 刻度序列（略去 break 分支）。
    /// 结果写进 out 列表；precision 决定标签小数位。
    static void ScaleTicks(double extent0, double extent1, double nt0, double nt1,
                           double interval, int precision, List<double> outTicks) {
        if (interval == 0.0) { return; }
        // extent 低于 nice 下界时补一个原始端点（源码 :215-221）
        if (extent0 < nt0) { outTicks.Add(extent0); }
        double tick = nt0;
        int guard = 0;
        while (guard < 3000) {
            if (tick > nt1) { break; }
            outTicks.Add(tick);
            double next = Chart.RoundP(tick + interval, precision);
            // 浮点饱和保护（源码 :266-270）
            if (next == outTicks[outTicks.Count - 1]) { break; }
            tick = next;
            guard = guard + 1;
        }
        double last = outTicks.Count > 0 ? outTicks[outTicks.Count - 1] : nt1;
        // extent 高于 nice 上界时补一个原始端点（源码 :279-288）
        if (extent1 > last) { outTicks.Add(extent1); }
    }

    /// `scale/helper.ts:125 increaseInterval(niceInterval)`：把 nice 步长
    /// 抬到下一个 nice 值（f 是十进制系数）——1→2、2→3、3→5、5→10。
    /// 用于 alignTicks 的 `loopIncreaseInterval` 搜索。
    static double IncreaseInterval(double iv) {
        if (iv <= 0.0) { return 1.0; }
        int e = Chart.QuantityExponent(iv);
        double exp10 = Chart.Pow10D(e);
        double f = Chart.RoundP(iv / exp10, 0);
        if (f == 0.0) { f = 1.0; }
        else if (f == 2.0) { f = 3.0; }
        else if (f == 3.0) { f = 5.0; }
        else { f = f * 2.0; }
        return Chart.RoundP(f * exp10, e < 0 ? 0 - e : 0);
    }

    /// A11：`axisNiceTicks.ts:130-138` 的 minInterval/maxInterval 钳制。
    /// 先按 NiceRange 解出引擎自己的 nice 区间，算出等效步长
    /// interval = (hi−lo)/ticks；若被钳制改变，则用钳后的步长重解端点
    /// （`niceExtent = [ceil(e0/iv)·iv, floor(e1/iv)·iv]`，出处同文件
    /// :140-143）。**未声明钳制的轴走原路，逐像素不变**。
    /// 注意本引擎 nice 是 ECharts 2.2.4 smartSteps（1/2/2.5/5），
    /// 与 6.1 的 1/2/5 端点天然不同——钳制语义（往哪边推）才是可移植的。
    static ChartSpan ClampNiceRange(int dataLo, int dataHi, bool scale,
                                    double minInterval, double maxInterval) {
        ChartSpan s = Chart.NiceRange(dataLo, dataHi, scale);
        if (ChartOption.IsAutoD(minInterval) && ChartOption.IsAutoD(maxInterval)) { return s; }
        if (s.ticks < 1) { return s; }
        double iv0 = (double)(s.hi - s.lo) / (double)s.ticks;
        if (iv0 <= 0.0) { return s; }
        double iv = iv0;
        if (!ChartOption.IsAutoD(minInterval) && iv < minInterval) { iv = minInterval; }
        if (!ChartOption.IsAutoD(maxInterval) && iv > maxInterval) { iv = maxInterval; }
        if (iv == iv0) { return s; }
        int p = Chart.GetIntervalPrecision(iv);
        // niceExtent = [ceil(e0/iv)·iv, floor(e1/iv)·iv] 落在数据域内部；
        // 但轴的 extent 不得被缩小（Interval.ts:238-282 的
        // 两个补 tick 分支：域外的那一格被推
        // 成 niceExtent ± interval）——数据超出的那一格
        // 必须补回来（min=2 时 0..3 官方出 0..4）。
        double nlo = Chart.RoundP(Math.Ceiling((double)dataLo / iv) * iv, p);
        double nhi = Chart.RoundP(Math.Floor((double)dataHi / iv) * iv, p);
        if (nlo > (double)dataLo) { nlo = Chart.RoundP(nlo - iv, p); }
        if (nhi < (double)dataHi) { nhi = Chart.RoundP(nhi + iv, p); }
        if (nhi <= nlo) { nhi = nlo + iv; }
        ChartSpan r = new ChartSpan();
        r.lo = (int)(nlo >= 0.0 ? nlo + 0.5 : nlo - 0.5);
        r.hi = (int)(nhi >= 0.0 ? nhi + 0.5 : nhi - 0.5);
        if (r.hi <= r.lo) { r.hi = r.lo + 1; }
        int nt = (int)Chart.RoundP(((double)r.hi - (double)r.lo) / iv, 0);
        r.ticks = nt < 1 ? 1 : nt;
        return r;
    }

    /// A12：`coord/axisAlignTicks.ts scaleCalcAlign` 的单侧实现——把目标轴
    /// 解成与对齐轴**段数相同、刻度对齐**的量程。`alignToSegs` = 对齐轴
    /// 的段数；`dataLo/dataHi` 是目标轴的原始 extent（incl0 已并入）。
    /// 对应源码 :250-300 的 `targetMinMaxFixed` 双 false 分支：
    ///   interval = nice(span / alignToNiceSegCount, NICE_MODE_MIN)
    ///   loopIncreaseInterval: minNice=ceil(e0/iv)·iv、maxNice=floor(e1/iv)·iv，
    ///     段数不足 alignToNiceSegCount 时按 incl0/居中规则向两侧补格，
    ///     直到 [min,max] 覆盖原 extent。
    /// 调用方给的单位是"轴自己的单位"（整数轴=值，小数轴=×1000 定点，
    /// 时间轴=天），因此同一函数三处复用。
    static ChartSpan AlignRange(double dataLo, double dataHi, int alignToSegs,
                                bool incl0) {
        if (alignToSegs < 1) { alignToSegs = 1; }
        // incl0 时先做与 NiceRange 同一个零锚定
        // （Chart.zan 的 NiceRange 原文 :1552-1555，出处 valueAxis
        // _reformValue）：全正数据下界归零、
        // 全负数据上界归零。不做这一步
        // 就会把 2000..23400 对成 -10000..30000
        // （官方 0..40000）——零锚定是
        // incl0 的前提，不是可选补丁。
        if (incl0) {
            if (dataLo >= 0.0 && dataHi >= 0.0) { dataLo = 0.0; }
            if (dataLo <= 0.0 && dataHi <= 0.0) { dataHi = 0.0; }
        }
        double span = dataHi - dataLo;
        if (span <= 0.0) { span = 1.0; }
        double iv = Chart.NiceMode(span / (double)alignToSegs, false);
        if (iv <= 0.0) { iv = 1.0; }
        double nlo = dataLo;
        double nhi = dataHi;
        for (int guard = 0; guard < 64; guard = guard + 1) {
            int p = Chart.GetIntervalPrecision(iv);
            nlo = Chart.RoundP(Math.Ceiling(dataLo / iv) * iv, p);
            nhi = Chart.RoundP(Math.Floor(dataHi / iv) * iv, p);
            int cnt = (int)Chart.RoundP((nhi - nlo) / iv, 0);
            if (cnt <= alignToSegs) {
                int more = alignToSegs - cnt;
                double mlo = 0.0;
                double mhi = 0.0;
                if (incl0 && dataLo == 0.0) { mlo = 0.0; mhi = (double)more; }
                else if (incl0 && dataHi == 0.0) { mlo = (double)more; mhi = 0.0; }
                else {
                    int half = more / 2;
                    if (more % 2 == 0) { mlo = (double)half; mhi = (double)half; }
                    else if (nlo + nhi < dataLo + dataHi) {
                        mlo = (double)half; mhi = (double)(half + 1);
                    } else {
                        mlo = (double)(half + 1); mhi = (double)half;
                    }
                }
                nlo = Chart.RoundP(nlo - iv * mlo, p);
                nhi = Chart.RoundP(nhi + iv * mhi, p);
                if (nlo <= dataLo && nhi >= dataHi) { break; }
            }
            iv = Chart.IncreaseInterval(iv);
        }
        ChartSpan r = new ChartSpan();
        r.lo = (int)(nlo >= 0.0 ? nlo + 0.5 : nlo - 0.5);
        r.hi = (int)(nhi >= 0.0 ? nhi + 0.5 : nhi - 0.5);
        if (r.hi <= r.lo) { r.hi = r.lo + 1; }
        r.ticks = alignToSegs;
        return r;
    }

    /// A12 minorTick 的刻度序列：scale/minorTicks.ts:22-81
    /// getMinorTicks(scale, splitNumber, breaks, scaleInterval)。
    /// 每两个相邻 nice 刻度之间均分 splitNumber
    /// 段，取内部点，且严格落在
    /// [extent0, extent1] 内（源码 :50 `minorTick > extent[0] &&
    /// minorTick < extent[1]`）——首末段因数不足而被
    /// 截掉的点就是这条规则。
    /// 入参域与 splitNumber 均为轴自己的单位
    /// （整数轴=值，小数轴=×1000 定点）。
    /// 对数轴版：刻度不等距（每个十倍），
    /// 不能用均分版。源码同 minorTicks.ts:41-63
    /// 的对点循环：逐对在**原值**空间插值
    /// （minorTick = prev + (c+1)*interval/splitNumber），再经对数映射落像素
    /// ——所以 1..10 的细分点是 2.8/4.6/6.4/8.2
    /// 而不是对数均分点（官方
    /// _scratch/a12_log.js 实测）。
    static void MinorTickValuesPairs(List<int> ticks, int splitNumber,
                                    List<double> into) {
        if (splitNumber < 2 || ticks.Count < 2) { return; }
        double e0 = (double)ticks[0];
        double e1 = (double)ticks[ticks.Count - 1];
        for (int i = 1; i < ticks.Count; i = i + 1) {
            double prev = (double)ticks[i - 1];
            double interval = (double)ticks[i] - prev;
            if (interval <= 0.0) { continue; }
            double minorInterval = interval / (double)splitNumber;
            int p = Chart.GetIntervalPrecision(minorInterval);
            for (int c = 1; c < splitNumber; c = c + 1) {
                double mt = Chart.RoundP(prev + (double)c * minorInterval, p);
                if (mt > e0 && mt < e1) { into.Add(mt); }
            }
        }
    }

    static void MinorTickValues(double e0, double e1, int segs, int splitNumber,
                                List<double> into) {
        if (segs < 1 || splitNumber < 2) { return; }
        double interval = (e1 - e0) / (double)segs;
        if (interval == 0.0) { return; }
        double minorInterval = interval / (double)splitNumber;
        int p = Chart.GetIntervalPrecision(minorInterval);
        for (int g = 0; g < segs; g = g + 1) {
            double prev = e0 + interval * (double)g;
            for (int c = 1; c < splitNumber; c = c + 1) {
                double mt = Chart.RoundP(prev + (double)c * minorInterval, p);
                if (mt > e0 && mt < e1) { into.Add(mt); }
            }
        }
    }

    /// ECharts 语义的数值轴 [lo, hi]（供 BuildAxes* 用）。
    /// 两个端点必须落在**同一 interval 的整数倍**上，否则两端刻度
    /// 间距会被截断成不等距——旧的 NiceMin/NiceMax 各自独立取整
    /// 就是这个毛病。退化域（单点/全等）先按
    /// `intervalScaleEnsureValidExtent` 撑开。
    static void AxisNiceRange(double fixedLo, double fixedHi,
                              double dataMin, double dataMax, int splitNumber,
                              double minInterval, double maxInterval,
                              out double lo, out double hi, out double interval,
                              out int precision) {
        double d0 = dataMin;
        double d1 = dataMax;
        if (d1 <= d0) {
            double pad = (d0 == 0.0) ? 1.0 : (d0 < 0.0 ? 0.0 - d0 : d0) * 0.5;
            d0 = d0 - pad;
            d1 = d1 + pad;
            if (d1 <= d0) { d1 = d0 + 1.0; }
        }
        double nt0 = 0.0;
        double nt1 = 0.0;
        Chart.IntervalScaleNiceTicks(d0, d1, splitNumber, minInterval, maxInterval,
            out interval, out precision, out nt0, out nt1);
        lo = ChartOption.IsAutoD(fixedLo) ? nt0 : fixedLo;
        hi = ChartOption.IsAutoD(fixedHi) ? nt1 : fixedHi;
        if (hi <= lo) { hi = lo + (interval > 0.0 ? interval : 1.0); }
    }


    /// AxisMinFor 的 1/1000 定点对偶：与 AxisMaxForF 成对——原始
    /// 数据下界直传（不许钳零），小数轴量程专用。i0/i1 窗口语义
    /// 同 AxisMaxFor。
    static int AxisMinForF(List<ChartSeries> series, int axisIndex, int i0, int i1, bool scale) {
        int mn = 0;
        // !scale：0 本身算一个候选点（`_reformValue` 的同号归零前置条件）；
        // scale：0 不参与，必须扫到真实数据才更新（否则正数据轴会被锚到 0）。
        bool any = !scale;
        for (int i = 0; i < series.Count; i = i + 1) {
            ChartSeries s = series[i];
            if (!s.hidden && s.axisIndex == axisIndex) {
                int j0 = 0; int j1 = s.Count() - 1;
                if (i0 >= 0 && i1 >= 0) {
                    j0 = i0; j1 = i1;
                    if (j0 > s.Count() - 1) { j0 = s.Count() - 1; }
                    if (j1 > s.Count() - 1) { j1 = s.Count() - 1; }
                    if (j1 < j0) { j1 = j0; }
                }
                for (int j = j0; j <= j1; j = j + 1) {
                    double v = s.Number(j);
                    int vi = (int)(v * 1000 + (v >= 0 ? 0.5 : 0 - 0.5));
                    if (!any || vi < mn) { mn = vi; any = true; }
                }
                // 类目 data 系列（`data:[2,7,...]`）没有点坐标。dataZoom
                // 窗口下 i0/i1>=0，p0/p1 会被钳成 -1，而 `j2 <= p1` 在
                // p0==p1==-1 时为真 → s.points[-1] 越界（bump-chart 的
                // list index out of bounds）。空表跳过点坐标段（上面的
                // data 段已计完）。
                if (s.points.Count < 1) { continue; }
                int p0 = 0; int p1 = s.points.Count - 1;
                if (i0 >= 0 && i1 >= 0) {
                    p0 = i0; p1 = i1;
                    if (p0 > s.points.Count - 1) { p0 = s.points.Count - 1; }
                    if (p1 > s.points.Count - 1) { p1 = s.points.Count - 1; }
                    if (p1 < p0) { p1 = p0; }
                }
                for (int j2 = p0; j2 <= p1; j2 = j2 + 1) {
                    int py = Chart.PointV(s.points[j2].y, s.pointG) * 1000;
                    if (!any || py < mn) { mn = py; any = true; }
                }
            }
        }
        return mn;
    }

    /// 轴上是否存在共享 stackName 的柱族系列（堆叠柱）。小数堆叠柱
    /// 的量程须按类目堆叠和推导，逐项极值会低估堆叠顶
    /// （normalization 各项 ≤0.57、堆叠顶达 1.0）。
    static bool HasStackedBarsF(List<ChartSeries> series, int axisIndex) {
        List<string> grp = new List<string>();
        for (int i = 0; i < series.Count; i = i + 1) {
            ChartSeries s = series[i];
            if (s.hidden || s.axisIndex != axisIndex) { continue; }
            if (!ChartView.IsBarFamily(s.type)) { continue; }
            // 默认空 stackName 不是堆叠组：分组柱状图（各系列独立
            // 并排）的量程必须按单值上限，不能按堆叠和——否则凡
            // ≥2 系列的分组柱轴都虚高 2-4 倍（ECharts stack 缺省
            // 即无堆叠）。
            if (s.stackName.Length == 0 && s.stack == 0) { continue; }
            if (ChartView.GroupIndex(grp, s.stackName) >= 0) { return true; }
            grp.Add(s.stackName);
        }
        // 堆叠面积折线（confidence-band L/U）同样抬升定点量程。
        for (int i2 = 0; i2 < series.Count; i2 = i2 + 1) {
            ChartSeries s2 = series[i2];
            if (s2.hidden || s2.axisIndex != axisIndex) { continue; }
            if (!ChartView.IsLineFamily(s2.type)) { continue; }
            if (s2.stackName.Length == 0 && s2.stack == 0) { continue; }
            return true;
        }
        return false;
    }

    /// 堆叠柱（共享 stackName 的柱族）逐类目正/负堆叠和（×1000
    /// 定点）：hi = 正累加器最大值，lo = 负累加器最小值。正负独立
    /// 累计与渲染路径同一语义（负段不与正段相加）。
    /// i0/i1 窗口语义同 AxisMaxFor：限制各类目逐组累加到可见段
    /// （与 ECharts filterMode:'weakFilter' Y 重定一致）。
    static ChartSpan StackExtentF(List<ChartSeries> series, int axisIndex, int i0, int i1) {
        List<string> grp = new List<string>();
        for (int g = 0; g < series.Count; g = g + 1) {
            ChartSeries cs = series[g];
            if (cs.hidden || cs.axisIndex != axisIndex) { continue; }
            if (!ChartView.IsBarFamily(cs.type)) { continue; }
            if (ChartView.GroupIndex(grp, cs.stackName) < 0) { grp.Add(cs.stackName); }
        }
        int ng = grp.Count;
        if (ng < 1) { ng = 1; }
        int n = 0;
        for (int c = 0; c < series.Count; c = c + 1) {
            ChartSeries cs2 = series[c];
            if (!cs2.hidden && cs2.axisIndex == axisIndex
                && ChartView.IsBarFamily(cs2.type)) {
                if (cs2.Count() > n) { n = cs2.Count(); }
            }
        }
        int loI = (i0 >= 0 && i1 >= 0) ? i0 : 0;
        int hiI = (i0 >= 0 && i1 >= 0) ? i1 : n - 1;
        if (loI > n - 1) { loI = n - 1; }
        if (hiI > n - 1) { hiI = n - 1; }
        if (hiI < loI) { hiI = loI; }
        int hi = 0;
        int lo = 0;
        // A9：组内顶端值走 processor/dataStack.ts 的
        // stackStrategy 链（逐系列取各自声明的策略）。
        // 旧的“正负双累加器”在“负值后跟 0”时与官方
        // 分岔（[10,-8,0] 官方给 -8/-8，旧给 10/10）。
        List<double> tops = new List<double>();
        for (int i = loI; i <= hiI; i = i + 1) {
            tops.Clear();
            ChartView.StackTopAll(series, i, tops);
            for (int s2 = 0; s2 < series.Count; s2 = s2 + 1) {
                ChartSeries cs3 = series[s2];
                if (cs3.hidden || cs3.axisIndex != axisIndex
                    || !ChartView.IsBarFamily(cs3.type)) { continue; }
                int gi = ChartView.GroupIndex(grp, cs3.stackName);
                if (gi < 0) { gi = 0; }
                if (i >= cs3.Count()) { continue; }
                double dv = cs3.Number(i);
                int vF = (int)(dv * 1000.0 + (dv >= 0 ? 0.5 : 0 - 0.5));
                double topD = s2 < tops.Count ? tops[s2] : 0.0;
                int topF = (int)(topD * 1000.0 + (topD >= 0 ? 0.5 : 0 - 0.5));
                if (topF > hi) { hi = topF; }
                if (topF - vF < lo) { lo = topF - vF; }
            }
        }
        // 堆叠面积折线（confidence-band L/U 带、stream-graph）：与
        // 柱族不同，渲染按原始值逐类累计（prev+val 链），极值取
        // 各类目全体堆叠折线之和（正负不分组）。
        int ln = 0;
        for (int c2 = 0; c2 < series.Count; c2 = c2 + 1) {
            ChartSeries cs4 = series[c2];
            if (!cs4.hidden && cs4.axisIndex == axisIndex
                && ChartView.IsLineFamily(cs4.type)
                && (cs4.stackName.Length > 0 || cs4.stack != 0)) {
                if (cs4.Count() > ln) { ln = cs4.Count(); }
            }
        }
        int loI3 = (i0 >= 0 && i1 >= 0) ? i0 : 0;
        int hiI3 = (i0 >= 0 && i1 >= 0) ? i1 : ln - 1;
        if (loI3 > ln - 1) { loI3 = ln - 1; }
        if (hiI3 > ln - 1) { hiI3 = ln - 1; }
        if (hiI3 < loI3) { hiI3 = loI3; }
        for (int i3 = loI3; i3 <= hiI3; i3 = i3 + 1) {
            int accL = 0;
            for (int s4 = 0; s4 < series.Count; s4 = s4 + 1) {
                ChartSeries cs5 = series[s4];
                if (cs5.hidden || cs5.axisIndex != axisIndex
                    || !ChartView.IsLineFamily(cs5.type)
                    || (cs5.stackName.Length == 0 && cs5.stack == 0)) {
                    continue;
                }
                if (i3 >= cs5.Count()) { continue; }
                double dv2 = cs5.Number(i3);
                accL = accL + (int)(dv2 * 1000.0 + (dv2 >= 0 ? 0.5 : 0 - 0.5));
            }
            if (accL > hi) { hi = accL; }
            if (accL < lo) { lo = accL; }
        }
        ChartSpan sp = new ChartSpan();
        sp.lo = lo;
        sp.hi = hi;
        sp.ticks = 5;
        return sp;
    }

    /// 小数轴 extent 下界（×1000 定点）：固定 min 直接生效，否则
    /// 原始数据下界直传（不预设 nice——向下取整是 smartSteps 的
    /// 职责，valueAxis._calculateValue 语义）。堆叠柱并入类目堆叠
    /// 和的负向极值。i0/i1 窗口语义同 AxisMaxFor。
    static int FracAxisLoF(int fixedLo, List<ChartSeries> series, int axisIndex, int i0, int i1,
                           bool scale) {
        if (fixedLo != ChartOption.Auto()) { return fixedLo * 1000; }
        int lo = Chart.AxisMinForF(series, axisIndex, i0, i1, scale);
        if (Chart.HasStackedBarsF(series, axisIndex)) {
            ChartSpan se = Chart.StackExtentF(series, axisIndex, i0, i1);
            if (se.lo < lo) { lo = se.lo; }
        }
        return lo;
    }

    /// 小数轴 extent 上界（×1000 定点）：固定 max 直接生效，否则
    /// 原始数据上界直传。堆叠柱并入类目堆叠和的正向极值。
    /// i0/i1 窗口语义同 AxisMaxFor。
    static int FracAxisHiF(int fixedHi, List<ChartSeries> series, int axisIndex, int i0, int i1,
                           bool scale) {
        if (fixedHi != ChartOption.Auto()) { return fixedHi * 1000; }
        int hi = Chart.AxisMaxForF(series, axisIndex, i0, i1, scale);
        if (Chart.HasStackedBarsF(series, axisIndex)) {
            ChartSpan se = Chart.StackExtentF(series, axisIndex, i0, i1);
            if (se.hi > hi) { hi = se.hi; }
        }
        return hi;
    }

    /// ECharts 2 数值轴 nice 量程结果（lo/hi 取整到步长倍数）。
    class ChartSpan {
        int lo;
        int hi;
        int ticks;
    }

    /// expNum 的 {c, e}：近似值 = c × 10^e。
    class ChartExp {
        int c;
        int e;
    }

    /// a / b 的数学 floor（Zan 的 / 与 % 向零截断）。
    static int FloorDivQ(int a, int b) {
        int q = a / b;
        if (a % b != 0 && a < 0) { q = q - 1; }
        return q;
    }

    /// a / b 的数学 ceil。
    static int CeilDivQ(int a, int b) {
        int q = a / b;
        if (a % b != 0 && a > 0) { q = q + 1; }
        return q;
    }

    /// 十进制位数（v ≥ 1）。
    static int DecDigits(int v) {
        int n = 1;
        while (v >= 10) { v = v / 10; n = n + 1; }
        return n;
    }

    /// 去掉十进制尾部 0（全精度有效位计数用）。
    static int StripZeros(int v) {
        while (v > 0 && v % 10 == 0) { v = v / 10; }
        return v;
    }

    /// JS Math.round(q / 2)（半数朝 +∞，q 可为负）。
    static int JSRoundHalf(int q) {
        if (q >= 0) { return (q + 1) / 2; }
        return q / 2;
    }

    /// expNum(num/den, 2 位精度，向上)：v = num/den ≥ 0 的两位有效数
    /// 上近似。对应 smartSteps 里 getCeil/expSpan 的 expNum(v, 2)。
    static ChartExp ExpNum2Rat(int num, int den) {
        ChartExp r = new ChartExp();
        r.c = 0;
        r.e = 0;
        if (num <= 0 || den <= 0) { return r; }
        int k;
        if (num >= den) {
            k = Chart.DecDigits(num / den) - 1;
        } else {
            k = 0;
            int p = num;
            while (p < den) { p = p * 10; k = k - 1; }
        }
        int expon = k - 1;
        // Pow10 只服务非负指数，k ≥ 1 时改走除法表达 10^(1-k)。
        int scaled;
        if (k >= 1) {
            scaled = Chart.CeilDivQ(num, den * Chart.Pow10(k - 1));
        } else {
            scaled = Chart.CeilDivQ(num * Chart.Pow10(1 - k), den);
        }
        if (scaled >= 100) { scaled = scaled / 10; expon = expon + 1; }
        r.c = scaled;
        r.e = expon;
        return r;
    }

    /// expNum(n, 全精度)：整数 n 的精确分解（c × 10^e = n）。
    /// byFloor 只在指数对齐除法时区分 floor/ceil。
    static ChartExp ExpNumFull(int n, bool byFloor) {
        ChartExp r = new ChartExp();
        r.c = 0;
        r.e = 0;
        if (n == 0) { return r; }
        int ad = n < 0 ? 0 - n : n;
        int digit = Chart.DecDigits(Chart.StripZeros(ad));
        int expon = Chart.DecDigits(ad) - digit;
        r.e = expon;
        r.c = n / Chart.Pow10(expon);
        return r;
    }

    /// getCeil：两位尾数向上吸附到步长备选 [10,20,25,50]。
    static void SmartCeilStep(ChartExp n) {
        if (n.c <= 10) { n.c = 10; return; }
        if (n.c <= 20) { n.c = 20; return; }
        if (n.c <= 25) { n.c = 25; return; }
        if (n.c <= 50) { n.c = 50; return; }
        n.e = n.e + 1;
        n.c = 10;
    }

    /// expFixTo：把 x 的指数对齐到 ref（缩指数乘 10 精确，升指数
    /// 按 byFloor floor / 否则 ceil 除）。
    static void ExpAlign(ChartExp x, ChartExp refx, bool byFloor) {
        int delta = refx.e - x.e;
        if (delta == 0) { return; }
        x.e = refx.e;
        if (delta < 0) {
            x.c = x.c * Chart.Pow10(0 - delta);
        } else {
            int q = Chart.Pow10(delta);
            x.c = byFloor ? Chart.FloorDivQ(x.c, q) : Chart.CeilDivQ(x.c, q);
        }
    }

    /// smartSteps 的 forInteger：跨度小于段数时向两侧延展跨度
    /// （section ≤ 0 时取 5 段），输出压回与原数据同侧。
    static ChartSpan SmartForInteger(int min, int max, int section) {
        if (section < 1) { section = 5; }
        int delta = section - (max - min);
        int newMin = Chart.JSRoundHalf(min * 2 - delta);
        int newMax = Chart.JSRoundHalf(max * 2 + delta);
        if (min >= 0 && newMin < 0) {
            newMax = newMax - newMin;
            newMin = 0;
        } else if (max <= 0 && newMax > 0) {
            newMin = newMin - newMax;
            newMax = 0;
        }
        ChartSpan s = new ChartSpan();
        s.lo = newMin;
        s.hi = newMax;
        s.ticks = section;
        return s;
    }

    /// smartSteps 的 tryForInt：原最值同号（含 0）时尽量取整数步长，
    /// 剩余误差向两侧均衡（可能改写 expMin/expMax 并强制 e = 0）。
    static int SmartTryForInt(int min, int max, ChartExp expMin, ChartExp expMax, int secs) {
        int span = expMax.c - expMin.c;
        int expon = expMax.e;
        int step;
        bool stepInt;
        if (expon >= 0) {
            int num = span * Chart.Pow10(expon);
            step = num / secs;
            stepInt = num % secs == 0;
        } else {
            int den = secs * Chart.Pow10(0 - expon);
            step = span / den;
            stepInt = span % den == 0;
        }
        if (stepInt) { return secs; }
        int spanN = step * secs;
        if (spanN < max - min) {
            step = step + 1;
            spanN = step * secs;
            // section = 0（自适应段数）恒走这一支。
            if (step * (secs - 1) >= max - min) {
                secs = secs - 1;
                spanN = step * secs;
            }
        }
        if (spanN >= max - min) {
            int delta = spanN - (max - min);
            expMin.c = Chart.JSRoundHalf(min * 2 - delta);
            expMax.c = Chart.JSRoundHalf(max * 2 + delta);
            expMin.e = 0;
            expMax.e = 0;
        }
        return secs;
    }

    /// smartSteps 的 coreCalc（section = 0 自适应路径）：
    /// 步长基准取 ceil(span/6)，段数在 [6,5,4] 中选（调整后跨度最小、
    /// 同跨度步长小者胜），整数输入尽量整数步长并均衡误差。
    static ChartSpan SmartCoreCalc(int min, int max) {
        ChartExp expStep = Chart.ExpNum2Rat(max - min, 6);
        Chart.SmartCeilStep(expStep);
        ChartExp expSpan = Chart.ExpNum2Rat(max - min, 1);
        ChartExp expMin = Chart.ExpNumFull(min, true);
        ChartExp expMax = Chart.ExpNumFull(max, false);
        Chart.ExpAlign(expSpan, expStep, false);
        Chart.ExpAlign(expMin, expStep, true);
        Chart.ExpAlign(expMax, expStep, false);

        // look4sections。对齐单位可能是 10^e（e < 0 的细步长），
        // 整体放大 100 倍参与整数运算，随后把指数一并回退 2。
        int baseC = expMin.c * 100;
        int spanC = (expMax.c - expMin.c) * 100;
        int bestSpan = 0;
        int bestStep = 0;
        int bestMin = 0;
        int bestMax = 0;
        for (int section = 6; section >= 4; section = section - 1) {
            ChartExp ts = Chart.ExpNum2Rat(spanC, section);
            Chart.SmartCeilStep(ts);
            int stepN = ts.c * Chart.Pow10(ts.e);
            int tMin = Chart.FloorDivQ(baseC, stepN) * stepN;
            int tMax = Chart.CeilDivQ(baseC + spanC, stepN) * stepN;
            int sp = tMax - tMin;
            if (section == 6 || sp < bestSpan || (sp == bestSpan && stepN < bestStep)) {
                bestSpan = sp;
                bestStep = stepN;
                bestMin = tMin;
                bestMax = tMax;
            }
        }
        int secs = bestSpan / bestStep;
        if (secs < 3) { secs = secs * 2; }
        expMin.c = bestMin;
        expMin.e = expStep.e - 2;
        expMax.c = bestMax;
        expMax.e = expStep.e - 2;

        // 原最值同号（reform 后必有一端为 0）时尝试整数步长。
        if (min * max >= 0) {
            if (max - min < secs) { return Chart.SmartForInteger(min, max, secs); }
            secs = Chart.SmartTryForInt(min, max, expMin, expMax, secs);
        }
        // cross0：原数据在某侧时输出压回同侧。
        if (min >= 0 && expMin.c < 0) {
            expMax.c = expMax.c - expMin.c;
            expMin.c = 0;
        } else if (max <= 0 && expMax.c > 0) {
            expMin.c = expMin.c - expMax.c;
            expMax.c = 0;
        }
        // makeResult 对整数输入在 lo/hi 上是恒等（只影响小数位与
        // 标签数组），按各自指数还原即可。
        ChartSpan sp2 = new ChartSpan();
        sp2.lo = Chart.ExpRestore(expMin);
        sp2.hi = Chart.ExpRestore(expMax);
        sp2.ticks = secs;
        return sp2;
    }

    /// c × 10^e 的整数还原（e < 0 时 c 必是 10^-e 的倍数）。
    static int ExpRestore(ChartExp x) {
        if (x.e >= 0) { return x.c * Chart.Pow10(x.e); }
        return x.c / Chart.Pow10(0 - x.e);
    }

    /// ECharts 2.2.4 valueAxis 自动刻度（与演示站一致）：
    /// 内层是 src/util/smartSteps.js（section=0 自适应路径）的忠实
    /// 移植，外层套 valueAxis._reformValue 的非 scale 规则——
    /// 同号数据一端归零（全正 min→0、全负 max→0）与 min==max 整形。
    /// -2..15 → -5..15/4 段、0..1320 → 0..1500/6 段、0..2570 →
    /// 0..3000/6 段。固定 min/max 不走此函数（尊重不取整）。
    static ChartSpan NiceRange(int lo, int hi) {
        return Chart.NiceRange(lo, hi, false);
    }

    /// scale 版（axis.scale:true）：跳过 `_reformValue` 的同号归零——
    /// 出处 ECharts 2 `component/valueAxis.js:666 _reformValue(scale)`：
    /// `if (!scale && this._min >= 0 && this._max >= 0) this._min = 0;`
    /// `if (!scale && this._min <= 0 && this._max <= 0) this._max = 0;`
    /// 其余（min==max 整形、smartSteps）与 !scale 完全一致。
    static ChartSpan NiceRange(int lo, int hi, bool scale) {
        int min = lo;
        int max = hi;
        if (max < min) {
            int tmp = min;
            min = max;
            max = tmp;
        }
        if (min == max) {
            // valueAxis 的 min==max 修复：全 0 → max=1；正数把 min
            // 压到 0（源码 splitNumber ?? 5 实际取 null→0）；负数把
            // max 抬到 0。此段在源码里位于 _reformValue 之前
            // （_calculateValue 内），不受 scale 影响。
            if (max == 0) {
                max = 1;
            } else if (max > 0) {
                min = 0;
            } else {
                max = 0;
            }
        }
        if (!scale) {
            if (min >= 0 && max >= 0) { min = 0; }
            if (min <= 0 && max <= 0) { max = 0; }
        }
        if (min == max) { max = min + 1; }
        if (max - min < 5) {
            return Chart.SmartForInteger(min, max, 0);
        }
        return Chart.SmartCoreCalc(min, max);
    }

    /// ECharts2 valueAxis scale:true（不强制含 0）+ boundaryGap
    /// [0.01,0.01] 的量程：数据域两端各外扩 1% 后对齐 nice 步长
    /// （1/2/2.5/5×10^k，splitNumber 5 预估），一端不归零——若按
    /// NiceRange 的非 scale 规则把全正数据零锚定，2200..2450 的
    /// 蜡烛会被压进 0..2500 步长 500 的底部。k1 原版 → 2200..2450
    /// 步长 50。
    static ChartSpan ScaleRange(int lo, int hi) {
        if (hi < lo) {
            int tmp = lo;
            lo = hi;
            hi = tmp;
        }
        if (lo == hi) { hi = lo + 1; }
        int pad = (hi - lo) / 100;
        if (pad < 1) { pad = 1; }
        return Chart.ScatterAutoRange(lo - pad, hi + pad);
    }

    /// 全部系列中的最大值（隐藏系列不计），下界 0。
    static int MaxOf(List<ChartSeries> series) {
        int mx = 0;
        for (int i = 0; i < series.Count; i = i + 1) {
            ChartSeries s = series[i];
            for (int j = 0; j < s.Count(); j = j + 1) { if (s.Value(j) > mx) { mx = s.Value(j); } }
        }
        return mx;
    }

    /// 系列中的最小值（无负数时为 0，隐藏系列不计）。水平条 / 旋风图用
    /// 它把轴下界扩到 0 以下，而不是把负值裁成空柱。
    static int MinOf(List<ChartSeries> series) {
        int mn = 0;
        for (int i = 0; i < series.Count; i = i + 1) {
            ChartSeries s = series[i];
            if (!s.hidden) {
                for (int j = 0; j < s.Count(); j = j + 1) {
                    if (s.Value(j) < mn) { mn = s.Value(j); }
                }
            }
        }
        return mn;
    }

    /// 数值 → 水平像素：plotX 对应 lo，plotX+plotW 对应 hi。
    /// 大数值 × plotW 会超 int32（bar3 Population 到百万：
    /// 1000000×2601≈2.6e9），乘法走 long。
    static int ValueX(int plotX, int plotW, int lo, int hi, int v) {
        long span = (long)hi - (long)lo;
        if (span < 1) { span = 1; }
        return plotX + (int)(((long)v - (long)lo) * (long)plotW / span);
    }

    /// 定点数值 → 水平像素：v 以 值×g 承载（PointV 约定），分母按
    /// span×g 缩放后再除——亚单位像素精度不丢（先 PointV 取整会把
    /// 小数坐标量化到整数值格点，scatter3 的 3 位小数云会塌成点阵）。
    static int ValueXF(int plotX, int plotW, int lo, int hi, int v, int g) {
        if (g <= 1) { return Chart.ValueX(plotX, plotW, lo, hi, v); }
        long span = ((long)hi - (long)lo) * (long)g;
        if (span < 1) { span = 1; }
        return plotX + (int)(((long)v - (long)lo * (long)g) * (long)plotW / span);
    }

    /// 定点数值 → 垂直像素（ValueXF 的纵轴对偶）。
    static int ValueYF(int plotY, int plotH, int lo, int hi, int v, int g) {
        if (g <= 1) { return Chart.ValueY(plotY, plotH, lo, hi, v); }
        long span = ((long)hi - (long)lo) * (long)g;
        if (span < 1) { span = 1; }
        return plotY + plotH - (int)(((long)v - (long)lo * (long)g) * (long)plotH / span);
    }

    /// 数值 → 垂直像素：plotY+plotH 对应 lo，plotY 对应 hi（向上增大）。
    /// 同 ValueX：乘法走 long 防大数值 × plotH 溢出。
    static int ValueY(int plotY, int plotH, int lo, int hi, int v) {
        long span = (long)hi - (long)lo;
        if (span < 1) { span = 1; }
        return plotY + plotH - (int)(((long)v - (long)lo) * (long)plotH / span);
    }

    /// 1/1000 定点值 → 垂直像素：lo/hi（值×1000）之间的线性映射，
    /// 小数轴（leftMinF 定点域）的 YOfF 用——与 ValueY 同构，
    /// 分子分母同放大 1000 后 long 相除，亚单位值不再量化。
    static int ValueYF1000(int plotY, int plotH, int loF, int hiF, int vF) {
        long span = (long)hiF - (long)loF;
        if (span < 1) { span = 1; }
        return plotY + plotH
            - (int)(((long)vF - (long)loF) * (long)plotH / span);
    }

    /// ECharts axisLine.show 三态判定（cartesianAxisHelper.ts:169-181
    /// axisLineAutoShow）：显式 true/false 照办；未声明（-1）按 'auto'
    /// ——只有当**同网格**对侧轴是 value/log（isIntervalOrLogScale）
    /// 时才画，与本轴自身类型无关。time 轴也走 'auto'（实测
    /// x时间/y时间 一条线都不画）。
    static bool AxisLineDraws(int axisLineShow, bool otherIsValueOrLog) {
        if (axisLineShow > 0) { return true; }
        if (axisLineShow == 0) { return false; }
        return otherIsValueOrLog;
    }

    /// 0 相对数值域 [lo,hi] 的位置：2 = 严格在内，1 = 恰是端点
    /// （EDGE——官方允许骑线），0 = 在域外（禁止骑线）。
    /// scale/helper.ts getScaleValuePositionKind 的语义。
    static int ZeroKindOf(int lo, int hi) {
        if (lo > 0 || hi < 0) { return 0; }
        if (lo == 0 || hi == 0) { return 1; }
        return 2;
    }

    /// ECharts Grid.canOnZeroToAxis（Grid.ts:677-717）：目标轴是
    /// value/log（category/time 的 0 无数值意义）、0 不在目标域外
    /// （EDGE 允许）、骑线轴的 axisLine.onZero 非 false（-1 未声明
    /// 按 'auto'，与 true 等价——discourageOnAxisZero 只在
    /// containShape 真的扩过量程时置位，本引擎不产生）。
    static bool CanOnZeroTo(ChartAxis target, int targetLo, int targetHi,
                            int riderOnZero) {
        if (riderOnZero == 0) { return false; }
        if (target.type != ChartAxisType.Value
            && target.type != ChartAxisType.Log) { return false; }
        return Chart.ZeroKindOf(targetLo, targetHi) > 0;
    }

    // ---- 饼标签矩阵（ECharts PieSeries.ts:265-300 缺省 +
    // labelLayout.ts 布局；系列型缺省差异经三态传到这里解析） ----

    /// label.show 三态 → 画不画：饼缺省 true（PieSeries.ts:269）。
    /// 线柱缺省 false，走 labelShow 布尔不经此函数。
    static bool PieLabelShows(int showT) {
        return showT != 0;
    }

    /// position 属内位（不出引线）：'inside'/'inner'（同义，
    /// PieSeries.ts:285 注）/ 'center'。
    static bool PieLabelInside(string pos) {
        return pos == "inside" || pos == "inner" || pos == "center";
    }

    /// labelLine.show 三态 → 画不画引线：缺省 true（PieSeries.ts:289）；
    /// false 只藏线，文本仍落在 x3（labelLayout.ts:226 只判 linePoints）。
    static bool PieLeaderDraws(int lineShowT) {
        return lineShowT != 0;
    }

    /// alignTo:'edge' 时水平段终点 x3（labelLayout.ts:236-243）：
    /// 左半球 = 视口左缘 + edgeDistance + 文本宽 + 文距，右半球镜像
    /// （百分比 edgeDistance 按 viewWidth 折算后传入 px）。
    static int PieEdgeX3(bool rightSide, int viewL, int viewW, int edgeDist,
                         int textW, int dist) {
        if (rightSide) {
            return viewL + viewW - edgeDist - textW - dist;
        }
        return viewL + edgeDist + textW + dist;
    }

    /// 扇区百分比：ECharts percent = Math.round(v/sum*100)
    /// （乘 200 加 tot 除 2tot = 正数域四舍五入）。
    static int PiePct(int v, long tot) {
        if (tot <= 0) { return 0; }
        return (int)((v * 200 + tot) / (tot * 2));
    }

    // ---- 富文本标签（ECharts label.rich + {style|content} 令牌） ----
    // 源语义：官方"富文本标签"文档 + zrender rich 段排版——按 \n 分
    // 行，行内 {name|content} 段用 rich.name 样式，行高 = 段声明
    // lineHeight / height 或字号行盒的最大值，width:'100%' 随整块
    // 宽。分词在 Chart（纯字符串，conformance 可测），量测/绘制在
    // ChartView（要 App 缩放与 Canvas 度量）。

    /// 展开模板令牌 {a}{b}{c}{d}{@dim}（**保留** {style|...} 壳——
    /// 是否剥壳由调用方按有无 rich 样式表决定）。
    static string RichFmtRaw(ChartSeries s, string fmt,
                             string name, int val, int pct) {
        string f = fmt;
        if (f.Length == 0) { return name; }
        f = f.Replace("{a}", s.name);
        f = f.Replace("{b}", name);
        f = f.Replace("{c}", Convert.ToString(val));
        f = f.Replace("{d}", Convert.ToString(pct));
        while (true) {
            int at = f.IndexOf("{@");
            if (at < 0) { break; }
            int cb = f.IndexOf("}", at);
            if (cb < 0) { break; }
            f = f.Substring(0, at) + Convert.ToString(val) + f.Substring(cb + 1);
        }
        return f;
    }

    /// rich 样式表里按名取样式；没有返回 null。
    static ChartRichStyle RichStyleOf(ChartTextStyle st, string nm) {
        if (st == null || st.rich == null || nm.Length == 0) { return null; }
        for (int i = 0; i < st.rich.Count; i = i + 1) {
            if (st.rich[i].name == nm) { return st.rich[i]; }
        }
        return null;
    }

    /// 富文本分词：按 \n 分行（行号记 seg.line），{name|content} 段
    /// 挂样式（查表挂 st 引用，纯文本段 st=null）。未知样式名按纯
    /// 文本段处理但保留内容。返回扁平段表（顺序 = 阅读序）。
    /// 约定：空段（{hr|}）text = ""，调用方靠 width/borderWidth 识别
    /// 线块。
    static List<RichSeg> RichTokenize(string f, ChartTextStyle st) {
        List<RichSeg> outSegs = new List<RichSeg>();
        int line = 0;
        int i = 0;
        int segLineStart = 0;
        bool lineHasSeg = false;
        while (i < f.Length) {
            char ch = f.Substring(i, 1)[0];
            if (ch == '\n') {
                // 行尾文本（非空）或整行空行——空行也要占行号。
                if (i > segLineStart || !lineHasSeg) {
                    RichSeg done = new RichSeg();
                    done.text = f.Substring(segLineStart, i - segLineStart);
                    done.line = line;
                    done.st = null;
                    outSegs.Add(done);
                }
                line = line + 1;
                i = i + 1;
                segLineStart = i;
                lineHasSeg = false;
                continue;
            }
            if (ch == '{') {
                int cb = f.IndexOf("}", i);
                if (cb >= 0) {
                    int bar = f.IndexOf("|", i);
                    if (bar >= 0 && bar < cb) {
                        // 段前的行首文本（若非空）先行进表。
                        if (i > segLineStart) {
                            RichSeg pre = new RichSeg();
                            pre.text = f.Substring(segLineStart, i - segLineStart);
                            pre.line = line;
                            pre.st = null;
                            outSegs.Add(pre);
                            lineHasSeg = true;
                        }
                        RichSeg sg = new RichSeg();
                        sg.st = Chart.RichStyleOf(st,
                            f.Substring(i + 1, bar - i - 1));
                        sg.text = f.Substring(bar + 1, cb - bar - 1);
                        sg.line = line;
                        outSegs.Add(sg);
                        lineHasSeg = true;
                        i = cb + 1;
                        segLineStart = i;
                        continue;
                    }
                }
            }
            i = i + 1;
        }
        if (segLineStart < f.Length || !lineHasSeg || outSegs.Count == 0) {
            RichSeg last = new RichSeg();
            last.text = f.Substring(segLineStart);
            last.line = line;
            last.st = null;
            outSegs.Add(last);
        }
        return outSegs;
    }

    /// 段盒高贡献：声明 height 用 height，否则行盒 fontH；均加纵向
    /// padding（负 padding 官方允许——gauge-speed 的 [0,0,-20,10]，
    /// 结果可为负，排版时按 max(1, ·) 兜底）。
    static int RichSegH(int declaredH, int fontH, int padT, int padB) {
        int h = declaredH >= 0 ? declaredH : fontH;
        return h + padT + padB;
    }

    /// 剥壳文本：富文本格式串去掉 `{name|…}` 壳后的纯内容（未知样式
    /// 名同样保留内容）。供量宽（CategoryTicks）、旋转/退化路径和
    /// 系列标签文本（LabelText）——带壳串直接 DrawText 会把花括号
    /// 画出来。无 `{` 快速返回原串。
    static string RichStrip(string f) {
        if (f.IndexOf("{") < 0) { return f; }
        List<RichSeg> segs = Chart.RichTokenize(f, null);
        string r = "";
        for (int i = 0; i < segs.Count; i = i + 1) {
            r = r + segs[i].text;
        }
        return r;
    }

    /// 轴刻度标签绘制：轴声明了 axisLabel.rich 且文本带壳时走富文本
    /// 块（RichLayout+RichDraw，锚 = 块左上，调用方按原纯文本左缘
    /// 定位），否则原样 DrawText。旋转路径不在此（块不能整体旋转，
    /// 调用方先 RichStrip 后走 DrawTextRot）。
    static void DrawAxisLabel(App app, Canvas c, ChartAxis a, string lab,
                              int bx, int by, int defCol, int fs) {
        if (a.labelSt != null && a.labelSt.rich != null
            && lab.IndexOf("{") >= 0) {
            RichBlock blk = ChartView.RichLayout(app,
                Chart.RichTokenize(lab, a.labelSt), a.labelSt, fs);
            ChartView.RichDraw(app, c, bx, by, blk, defCol);
            return;
        }
        c.DrawText(bx, by, lab, defCol, fs);
    }

    /// DrawTextCentered 语义的富文本版：矩形内水平+垂直居中；富文本
    /// 块按矩形居中（几何与 plain 路径逐像素同位——带状类目标签
    /// 此前走 DrawTextCentered，不能因换路漂移 2px）。
    static void DrawAxisLabelCentered(App app, Canvas c, ChartAxis a, string lab,
                                      int rx, int ry, int rw, int rh,
                                      int defCol, int fs) {
        if (a.labelSt != null && a.labelSt.rich != null
            && lab.IndexOf("{") >= 0) {
            RichBlock blk = ChartView.RichLayout(app,
                Chart.RichTokenize(lab, a.labelSt), a.labelSt, fs);
            int bx = rx + (rw - blk.w) / 2;
            int by = ry + (rh - blk.h) / 2;
            if (bx < rx) { bx = rx; }
            if (by < ry) { by = ry; }
            ChartView.RichDraw(app, c, bx, by, blk, defCol);
            return;
        }
        c.DrawTextCentered(rx, ry, rw, rh, lab, defCol, fs);
    }

    /// 仅索引窗口 [i0,i1]（含端点）内的最大值，供 dataZoom
    /// 的索引视图使用（渲染循环直接读原系列，不做有损克隆）。
    static int MaxOfWindow(List<ChartSeries> series, int i0, int i1) {
        int mx = 0;
        for (int i = 0; i < series.Count; i = i + 1) {
            ChartSeries s = series[i];
            int j = i0;
            while (j <= i1 && j < s.Count()) {
                if (s.Value(j) > mx) { mx = s.Value(j); }
                j = j + 1;
            }
        }
        return mx;
    }

    /// 各分类中的最大堆叠总量（用于堆叠柱状图）。
    /// 共享 stackName 的系列堆叠在一起；轴适配最高的组，
    /// 使多组堆叠柱（ECharts `stack` 组）正确缩放。`n` 为分类数。
    static int MaxStack(List<ChartSeries> series, int n) {        List<string> grp = new List<string>();
        for (int g = 0; g < series.Count; g = g + 1) {
            ChartSeries cs = series[g];
            if (!ChartView.IsLineFamily(cs.type)) {
                bool found = false;
                for (int gi = 0; gi < grp.Count; gi = gi + 1) {
                    if (grp[gi] == cs.stackName) { found = true; }
                }
                if (!found) { grp.Add(cs.stackName); }
            }
        }
        int ng = grp.Count;
        if (ng < 1) { ng = 1; }
        int mx = 0;
        for (int i = 0; i < n; i = i + 1) {
            for (int gi = 0; gi < ng; gi = gi + 1) {
                int sum = 0;
                for (int s = 0; s < series.Count; s = s + 1) {
                    ChartSeries cs = series[s];
                    if (!ChartView.IsLineFamily(cs.type) && cs.stackName == grp[gi]) {
                        if (i < cs.Count()) { sum = sum + cs.Value(i); }
                    }
                }
                if (sum > mx) { mx = sum; }
            }
        }
        return mx;
    }

    /// MaxStack 的索引窗口版：仅累计分类 j + i0（j 在 [0,n)）。
    static int MaxStackW(List<ChartSeries> series, int n, int i0) {
        List<string> grp = new List<string>();
        for (int g = 0; g < series.Count; g = g + 1) {
            ChartSeries cs = series[g];
            if (!ChartView.IsLineFamily(cs.type)) {
                bool found = false;
                for (int gi = 0; gi < grp.Count; gi = gi + 1) {
                    if (grp[gi] == cs.stackName) { found = true; }
                }
                if (!found) { grp.Add(cs.stackName); }
            }
        }
        int ng = grp.Count;
        if (ng < 1) { ng = 1; }
        int mx = 0;
        for (int i = 0; i < n; i = i + 1) {
            int oi = i0 + i;
            for (int gi = 0; gi < ng; gi = gi + 1) {
                int sum = 0;
                for (int s = 0; s < series.Count; s = s + 1) {
                    ChartSeries cs = series[s];
                    if (!ChartView.IsLineFamily(cs.type) && cs.stackName == grp[gi]) {
                        if (oi < cs.Count()) { sum = sum + cs.Value(oi); }
                    }
                }
                if (sum > mx) { mx = sum; }
            }
        }
        return mx;
    }

    /// 所有系列堆叠成一条带时的最大累计总量（堆叠面积图
    /// / 堆叠折线图：系列按顺序累加，与 stackName 无关）。
    /// 隐藏的系列（图例关闭）被跳过，因此隐藏一个系列
    /// 会重设轴范围，剩余条带正确重新堆叠。
    static int MaxStackAll(List<ChartSeries> series, int n) {
        int mx = 0;
        for (int i = 0; i < n; i = i + 1) {
            int sum = 0;
            for (int s = 0; s < series.Count; s = s + 1) {
                ChartSeries cs = series[s];
                if (!cs.hidden && i < cs.Count()) { sum = sum + cs.Value(i); }
            }
            if (sum > mx) { mx = sum; }
        }
        return mx;
    }

    /// MaxStackAll 的索引窗口版：仅累计分类 j + i0。
    static int MaxStackAllW(List<ChartSeries> series, int n, int i0) {
        int mx = 0;
        for (int i = 0; i < n; i = i + 1) {
            int oi = i0 + i;
            int sum = 0;
            for (int s = 0; s < series.Count; s = s + 1) {
                ChartSeries cs = series[s];
                if (!cs.hidden && oi < cs.Count()) { sum = sum + cs.Value(oi); }
            }
            if (sum > mx) { mx = sum; }
        }
        return mx;
    }

    /// 堆叠感知的窗口最大值：逐 stackName 组累计组顶，未堆叠
    /// 系列（stack=0）只按绝对值计入（ECharts 轴量程覆盖组顶与
    /// 绝对值的最大者，绝对值不进累加和——多级控制混合图）。
    static int MaxStackGroupsW(List<ChartSeries> series, int n, int i0) {
        return Chart.MaxBarStackGroupsW(series, n, i0);
    }

    /// 堆叠柱（含逐系列 stackStrategy）在窗口内的**正侧组顶**最大值。
    /// 逐点用 ChartView.StackTopAll 取各系列堆叠结果，取正的最大值；
    /// 未堆叠系列按自身值参与（与旧 absMx 口径一致）。
    static int MaxBarStackGroupsW(List<ChartSeries> series, int n, int i0) {
        int mx = 0;
        List<double> tops = new List<double>();
        for (int i = 0; i < n; i = i + 1) {
            int oi = i0 + i;
            tops.Clear();
            ChartView.StackTopAll(series, oi, tops);
            for (int s = 0; s < series.Count; s = s + 1) {
                ChartSeries cs = series[s];
                if (cs.hidden || oi >= cs.Count()) { continue; }
                bool stackedOne = cs.stackName.Length > 0 || cs.stack != 0;
                double top = s < tops.Count ? tops[s] : 0.0;
                double cand = stackedOne ? top : cs.Number(oi);
                int cF = (int)(cand >= 0.0 ? cand + 0.5 : cand - 0.5);
                if (cF > mx) { mx = cF; }
            }
        }
        return mx;
    }

    /// MaxBarStackGroupsW 的负侧对偶：各组堆叠结果的负侧最小值，
    /// 返回值 ≤ 0（原始值单位，与调用方 NiceMin 一致）。
    static int MinBarStackGroupsW(List<ChartSeries> series, int n, int i0) {
        int mn = 0;
        List<double> tops = new List<double>();
        for (int i = 0; i < n; i = i + 1) {
            int oi = i0 + i;
            tops.Clear();
            ChartView.StackTopAll(series, oi, tops);
            for (int s = 0; s < series.Count; s = s + 1) {
                ChartSeries cs = series[s];
                if (cs.hidden || oi >= cs.Count()) { continue; }
                bool stackedOne = cs.stackName.Length > 0 || cs.stack != 0;
                double top = s < tops.Count ? tops[s] : 0.0;
                double cand = stackedOne ? top : cs.Number(oi);
                int cF = (int)(cand >= 0.0 ? cand + 0.5 : cand - 0.5);
                if (cF < mn) { mn = cF; }
            }
        }
        return mn;
    }

    /// 列表最大值，下界 0（无负值语义）。
    static int MaxInt(List<int> vs) {
        int mx = 0;
        for (int i = 0; i < vs.Count; i = i + 1) { if (vs[i] > mx) { mx = vs[i]; } }
        return mx;
    }

    // ---- 几何 ----

    /// 整数 point-in-polygon（射线法，even-odd），无除法/浮点。
    /// 半开约定：py >= 顶点 y 视为在射线之上，每条边最多计一次
    /// 穿越；交点侧由叉积符号结合边方向判定。点在边界上属边缘
    /// 情形，结果不保证——由命中层的 bbox 容差吸收。
    static bool PointInPoly(List<ChartMapPoint> poly, int px, int py) {
        int n = poly.Count;
        if (n < 3) { return false; }
        bool inside = false;
        int j = n - 1;
        for (int i = 0; i < n; i = i + 1) {
            ChartMapPoint pi = poly[i];
            ChartMapPoint pj = poly[j];
            long dx = (long)pi.x - (long)pj.x;
            long dy = (long)pi.y - (long)pj.y;
            long qx = (long)px - (long)pj.x;
            long qy = (long)py - (long)pj.y;
            long cross = dx * qy - dy * qx;
            if (cross == 0 && px >= (pi.x < pj.x ? pi.x : pj.x)
                && px <= (pi.x > pj.x ? pi.x : pj.x)
                && py >= (pi.y < pj.y ? pi.y : pj.y)
                && py <= (pi.y > pj.y ? pi.y : pj.y)) {
                return true;
            }
            if ((py >= pi.y) != (py >= pj.y)) {
                if ((cross > 0) == (pi.y > pj.y)) { inside = !inside; }
            }
            j = i;
        }
        return inside;
    }

    // ---- 轴类型：Time / Log ----

    /// 10 的整数对数（floor log10），仅正值（v < 1 → 0）。
    static int Log10(int v) {
        if (v < 1) { return 0; }
        int e = 0;
        int p = 1;
        while (p * 10 <= v) { p = p * 10; e = e + 1; }
        return e;
    }

    /// floor(log10) 的确定性整数逆；超出 int 范围时饱和为 2147483647。
    static int Pow10(int e) {
        if (e <= 0) { return 1; }
        int p = 1;
        for (int i = 0; i < e; i = i + 1) {
            if (p > 214748364) { return 2147483647; }
            p = p * 10;
        }
        return p;
    }

    /// 对数轴刻度：lo/hi 边界 + 中间的 10 的幂（去重，升序）。
    static List<int> LogTicks(int lo, int hi) {
        if (hi < lo) { int tmp = lo; lo = hi; hi = tmp; }
        if (lo < 1) { lo = 1; }
        if (hi < lo) { hi = lo; }
        List<int> ts = new List<int>();
        ts.Add(lo);
        int p = 1;
        while (p * 10 <= hi) {
            p = p * 10;
            if (p > lo) { ts.Add(p); }
        }
        if (ts[ts.Count - 1] != hi) { ts.Add(hi); }
        return ts;
    }

    /// 从 epoch 天生成确定性短日期 "YYYY-MM-DD"（真实公历，经
    /// DateTime 的 civil-from-days；t = 0 是 1970-01-01）。纯表
    /// 驱动、无系统时间依赖，供图表演示与 conformance 断言。
    static string TimeLabel(int t) {
        if (t < 0) { t = 0; }
        DateTime d = DateTime.FromUnixSeconds((long)t * 86400);
        string mm = Convert.ToString(d.Month());
        if (mm.Length < 2) { mm = "0" + mm; }
        string dd = Convert.ToString(d.Day());
        if (dd.Length < 2) { dd = "0" + dd; }
        return Convert.ToString(d.Year()) + "-" + mm + "-" + dd;
    }

    /// 时间轴刻度：从 {1,2,5}×10^n 阶梯选步长，使
    /// (t1-t0)/step ≤ maxTicks-1；生成 t0 起等距点，
    /// 末点不落在网格上则补 t1。跨度全程 64 位——int32 域
    /// 相减回绕成负会让步长卡在 1、循环 43 亿次撑爆内存。
    static List<int> TimeTicks(int t0, int t1, int maxTicks) {
        if (t1 < t0) { int tmp = t0; t0 = t1; t1 = tmp; }
        if (maxTicks < 2) { maxTicks = 2; }
        long span = (long)t1 - (long)t0;
        long step = 1;
        while (span / step + 1 > maxTicks) {
            long mag = 1;
            while (step >= mag * 10) { mag = mag * 10; }
            long unit = step / mag;
            if (unit == 1) { step = 2 * mag; }
            else if (unit == 2) { step = 5 * mag; }
            else { step = 10 * mag; }
        }
        List<int> ts = new List<int>();
        for (long t = t0; t <= t1; t = t + step) { ts.Add((int)t); }
        if (ts[ts.Count - 1] != t1) { ts.Add(t1); }
        return ts;
    }

    /// 固定小数位数的确定性格式化（四舍五入，无浮点打印依赖）。
    /// precision 钳制在 0..4。
    static string FormatFixed(double v, int precision) {
        if (precision < 0) { precision = 0; }
        if (precision > 4) { precision = 4; }
        int scale = 1;
        for (int i = 0; i < precision; i = i + 1) { scale = scale * 10; }
        bool neg = false;
        double av = v;
        if (av < 0) { neg = true; av = 0 - av; }
        int scaled = (int)(av * (double)scale + 0.5);
        int ip = scaled / scale;
        string s = Convert.ToString(ip);
        if (precision > 0) {
            int frac = scaled % scale;
            string fs = Convert.ToString(frac);
            while (fs.Length < precision) { fs = "0" + fs; }
            s = s + "." + fs;
        }
        if (neg) { s = "-" + s; }
        return s;
    }

    // ---- 共享框架 ----

    /// 面板背景 + 标题 + 图例色块。返回标题/图例带
    /// 下方紧邻的 y，调用方可在其下布局绘图区。
    /// 非交互版（wid=0）：图例色块不可点击。需要图例交互时
    /// 用 DrawPanelI。
    static int DrawPanel(App app, int x, int y, int w, int h, string title,
                         List<ChartSeries> series, bool showLegend) {
        return Chart.DrawPanelI(app, x, y, w, h, title, series, 0, showLegend);
    }

    /// 交互 id `wid` 下系列 `si` 的图例隐藏状态键。
    static int LegendKey(int wid, int si) { return 6000000 + wid * 64 + si; }
    /// dataRange 交互态：calculable 滑条两端（0..1000 量化，同
    /// zoom 条约定）与 splitList 分段隐藏位（1 = 该段被点掉）。
    static int DRangeLoKey(int wid) { return 7300000 + wid * 4; }
    /// dataRange calculable 滑条上界状态键（千分值 0..1000）。
    static int DRangeHiKey(int wid) { return 7300000 + wid * 4 + 1; }
    /// splitList 第 bi 段的隐藏位键（1 = 该段被点掉）。
    static int DRangeBandKey(int wid, int bi) { return 7400000 + wid * 32 + bi; }
    /// dataRange.hoverLink：指针悬停在 dataRange 条上时该图的高亮键
    /// （0 = 无；1 = 悬停中，消费方把接近值域的区域/点描边强调）。
    static int DRangeHoverKey(int wid) { return 7300000 + wid * 4 + 2; }

    /// legend.formatter 纯 seam：{name} 占位替换（模板空 = 原名）。
    static string LegendLabel(string fmt, string name) {
        if (fmt.Length < 1) { return name; }
        return fmt.Replace("{name}", name);
    }

    // ---- legend 选项帧内访问器（Chart.legendOpt 未置 = 保持旧行为）----
    /// 本帧图例是否纵向排布（legendOpt 未置 = 横向）。
    static bool LegendVertical() {
        ChartOption lo = Chart.legendOpt;
        if (lo == null) { return false; }
        return lo.legendOrient == "vertical";
    }
    /// 本帧图例 formatter 模板（legendOpt 未置 = 空模板 = 原名）。
    static string LegendFmt() {
        ChartOption lo = Chart.legendOpt;
        if (lo == null) { return ""; }
        return lo.legendFormatter;
    }
    /// 本帧卡片底色（ECharts option.backgroundColor）。
    /// 官方语义（core/echarts.ts:1927）：未声明 → 'transparent'，
    /// 由 zrender 底层呈现；Zan 的等价物是主题面板色（0 = 跟随主题）。
    /// 声明了就整卡铺它——pie-custom 的 #2c343c 深底配白字标签、
    /// gauge-car 的 #000 都是这个用途。
    static int PanelBgOr(int themeBg) {
        ChartOption lo = Chart.legendOpt;
        if (lo == null) { return themeBg; }
        if (lo.backgroundColor == 0) { return themeBg; }
        return lo.backgroundColor;
    }

    /// 本帧标题副标题（ECharts title.subtext；legendOpt 未置 = 空）。
    static string TitleSubText() {
        ChartOption lo = Chart.legendOpt;
        if (lo == null) { return ""; }
        return lo.titleSub;
    }
    /// 本帧标题水平对齐："left" | "center"（官方默认）| "right"。
    static string TitleAlignMode() {
        ChartOption lo = Chart.legendOpt;
        if (lo == null) { return ""; }
        return lo.titleAlign;
    }
    /// 标题正文色。官方 tokens.color.primary = neutral80 = #3c3c41；
    /// option.title.textStyle.color 显式给出时以它为准。
    static int TitleColor() {
        ChartOption lo = Chart.legendOpt;
        if (lo != null && lo.titleColor != 0) { return lo.titleColor; }
        return Chart.TitleNeutral(0x3c, 0x3c, 0x41);
    }
    /// 标题副文本色。官方 tokens.color.quaternary = neutral50 = #86878c。
    static int TitleSubColor() {
        ChartOption lo = Chart.legendOpt;
        if (lo != null && lo.titleSubColor != 0) { return lo.titleSubColor; }
        return Chart.TitleNeutral(0x86, 0x87, 0x8c);
    }
    /// 打包 RGB 为不透明 ARGB（alpha 0 在 DrawText 里视为不透明）。
    static int TitleNeutral(int r, int g, int b) {
        return (r << 16) | (g << 8) | b;
    }
    /// 本帧图例水平对齐："left" | "center"（默认）| "right"。
    static string LegendAlignX() {
        ChartOption lo = Chart.legendOpt;
        if (lo == null) { return ""; }
        return lo.legendX;
    }
    /// legend.left/right 的等效水平对齐（官方盒模型）：显式
    /// left/right/center 关键字直接返回；数值/百分比锚返回 ""（走 px
    /// 通路）；两锚都未声明时返回官方默认 "center"。
    static string LegendBoxAlignX() {
        ChartOption lo = Chart.legendOpt;
        if (lo == null) { return "center"; }
        if (lo.legendHasLeft) {
            if (lo.legendLeft == "left" || lo.legendLeft == "center"
                || lo.legendLeft == "right") { return lo.legendLeft; }
            return "";
        }
        if (lo.legendHasRight) {
            if (lo.legendRight == "right") { return "right"; }
            if (lo.legendRight == "left") { return "left"; }
            if (lo.legendRight == "center") { return "center"; }
            return "";
        }
        return "center"; // 官方 LegendModel.defaultOption: left 'center'
    }
    /// legend.left 数值锚（px）；未声明数值锚返回 -1。
    static int LegendAnchorLeftPx() {
        ChartOption lo = Chart.legendOpt;
        if (lo == null) { return 0 - 1; }
        if (lo.legendHasLeft && lo.legendLeftPx >= 0) { return lo.legendLeftPx; }
        return 0 - 1;
    }
    /// legend.right 数值锚（px）；未声明返回 -1。
    static int LegendAnchorRightPx() {
        ChartOption lo = Chart.legendOpt;
        if (lo == null) { return 0 - 1; }
        if (lo.legendHasRight && lo.legendRightPx >= 0) { return lo.legendRightPx; }
        return 0 - 1;
    }
    /// legend.top 数值锚（px）；未声明返回 -1。
    static int LegendAnchorTopPx() {
        ChartOption lo = Chart.legendOpt;
        if (lo == null) { return 0 - 1; }
        if (lo.legendHasTop && lo.legendTopPx >= 0) { return lo.legendTopPx; }
        return 0 - 1;
    }
    /// legend.bottom 数值锚（px）；未声明返回 -1（布局侧按官方默认
    /// tokens.size.m = 15 处理）。
    static int LegendAnchorBottomPx() {
        ChartOption lo = Chart.legendOpt;
        if (lo == null) { return 0 - 1; }
        if (lo.legendHasBottom && lo.legendBottomPx >= 0) { return lo.legendBottomPx; }
        return 0 - 1;
    }
    /// legend.top/bottom 是否声明为 top/middle/bottom 关键字。
    static string LegendBoxAlignY() {
        ChartOption lo = Chart.legendOpt;
        if (lo == null) { return ""; }
        if (lo.legendHasTop) {
            if (lo.legendTop == "top" || lo.legendTop == "middle"
                || lo.legendTop == "bottom") { return lo.legendTop; }
        }
        if (lo.legendHasBottom) {
            if (lo.legendBottom == "top" || lo.legendBottom == "middle"
                || lo.legendBottom == "bottom") { return lo.legendBottom; }
        }
        return "";
    }

    /// 图例浮层顶边 Y（官方盒模型，供各视图共用）：
    /// 显式 top 锚贴顶、显式 bottom 锚贴底（值即距底 px）、关键字
    /// top/middle/bottom 对应上/中/下，均未声明时按官方默认
    /// bottom = tokens.size.m = 15 贴底。lgH = 图例整体高度。
    static int LegendFloatTop(App app, int y, int h, int lgH, int pad) {
        int vTop = Chart.LegendAnchorTopPx();
        int vBot = Chart.LegendAnchorBottomPx();
        string vAlign = Chart.LegendBoxAlignY();
        if (vTop >= 0) { return y + app.Scale(vTop); }
        if (vBot >= 0) { return y + h - app.Scale(vBot) - lgH; }
        if (vAlign == "top") { return y + pad; }
        if (vAlign == "middle") { return y + (h - lgH) / 2; }
        return y + h - app.Scale(15) - lgH; // 官方默认 bottom 15
    }

    /// 图例浮层左边 X（官方盒模型）：显式 left/right 数值锚优先，其次
    /// 关键字 left/center/right，均未声明时官方默认 center（在
    /// [x0, maxX] 内居中）。contentW = 图例整行/整列宽度。
    static int LegendFloatLeft(App app, int x, int w, int contentW,
                               int pad, int x0, int maxX) {
        int lAnc = Chart.LegendAnchorLeftPx();
        int rAnc = Chart.LegendAnchorRightPx();
        if (lAnc >= 0) { return x + app.Scale(lAnc); }
        if (rAnc >= 0) { return maxX - app.Scale(rAnc) - contentW; }
        string lax = Chart.LegendBoxAlignX();
        if (lax == "left") { return x0; }
        if (lax == "right") { return maxX - contentW; }
        if (contentW > 0 && contentW <= maxX - x0) {
            return x0 + (maxX - x0 - contentW) / 2;
        }
        return x0;
    }

    /// 本帧图例点击模式：0 = multiple（现状）| 1 = single |
    /// -1 = false（不可点）。
    static int LegendSelMode() {
        ChartOption lo = Chart.legendOpt;
        if (lo == null) { return 0; }
        if (lo.legendSelectedMode == "single") { return 1; }
        if (lo.legendSelectedMode == "false") { return 0 - 1; }
        return 0;
    }

    /// dataRange calculable 滑条位置（0..1000）到值域的线性映射
    /// （纯 seam）：q=0 → dLo、q=1000 → dHi。q 越界钳制。
    static int DataRangeValue(int dLo, int dHi, int q) {
        int span = dHi - dLo;
        if (span < 0) { span = 0; }
        if (q < 0) { q = 0; }
        if (q > 1000) { q = 1000; }
        return dLo + span * q / 1000;
    }

    /// 饼/漏斗/玫瑰扇区、和弦/力导节点：按 (系列, 数据项) 持久化隐藏。
    /// 与 LegendKey 分段错开，避免单系列多扇区共用一个键把整图关掉。
    static int LegendSliceKey(int wid, int si, int di) {
        return 6200000 + wid * 1024 + si * 64 + di;
    }
    /// 饼扇区静态选中位（点击扇区切换 data.selected 的持久键）。
    static int PieSelKey(int wid, int si, int di) {
        return 6400000 + wid * 1024 + si * 64 + di;
    }

    /// 单个图例色块占宽：色块 + 间隙 + 标签文本宽 + 右侧留白。
    static int LegendChipW(App app, string label) {
        int lgFs = ChartFonts.Legend(app);
        return app.Scale(12) + app.Scale(6)
            + Canvas.MeasureText(label, lgFs) + app.Scale(10);
    }

    /// 标题行与工具箱行的底边：空标题不占大号行高，有工具箱时
    /// 内容从工具箱下方开始，避免标题/色块和工具图标叠在一起。
    static int HeadBandBottomValues(int y, int pad, int titleH,
                                    int toolboxH, int gap) {
        int h = titleH;
        if (toolboxH > h) { h = toolboxH; }
        if (h < 1) { return y + pad; }
        return y + pad + h + gap;
    }

    /// 按主题内边距与标题/工具箱行高算出面板内容起始 y
    ///（工具箱存在性取本帧 toolReserve）。
    static int HeadBandBottom(App app, int y, string title) {
        int pad = app.theme.paddingMedium;
        int titleH = 0;
        if (title.Length > 0) {
            titleH = Canvas.FontHeight(Style.FontFallback(app, "large"));
            if (Chart.TitleSubText().Length > 0) {
                titleH = titleH + Canvas.FontHeight(ChartFonts.SeriesLabel(app))
                    + app.Scale(2);
            }
        }
        int toolboxH = 0;
        if (Chart.toolReserve > 0) {
            toolboxH = ChartToolbox.Height(app);
        }
        return Chart.HeadBandBottomValues(y, pad, titleH, toolboxH,
            app.Scale(4));
    }

    /// 右侧色块图例一行（独立 AllocId 命中）。stateKey 跨帧持久化：
    /// 点一下切换隐藏（变暗 + 删除线），再点恢复。stateKey=0 时
    /// 纯展示不可点。返回是否刚点中。
    static bool DrawLegendChip(App app, int lx, int ly, int legendW, int lh,
                               int color, string label, bool hidden, int stateKey) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int sw = app.Scale(12);
        int hitId = app.focus.AllocId();
        app.hitTester.RegisterRect(hitId, lx, ly, legendW, lh, 3);
        bool hot = app.mouseX >= lx && app.mouseX < lx + legendW
            && app.mouseY >= ly && app.mouseY < ly + lh;
        int rowCol = color;
        int lblColor = Style.Part(app, "chart", "label", "", "", "",
            Style.SNormal()).FgOr(0);
        if (hidden) {
            rowCol = Chart.WithAlpha(color, 90);
            lblColor = Chart.WithAlpha(lblColor, 110);
        }
        c.FillRoundRect(lx, ly + app.Scale(2), sw, sw, t.borderRadiusSmall, rowCol);
        if (hot && !hidden) {
            c.DrawRoundRect(lx - app.Scale(1), ly + app.Scale(1),
                sw + app.Scale(2), sw + app.Scale(2), t.borderRadiusSmall,
                t.primary, 1);
        }
        int lgFs = ChartFonts.Legend(app);
        c.DrawText(lx + sw + app.Scale(6), ly + app.Scale(1), label, lblColor, lgFs);
        if (hidden) {
            int my = ly + app.Scale(2) + Canvas.FontHeight(lgFs) / 2;
            int tw = Canvas.MeasureText(label, lgFs);
            c.FillRect(lx + sw + app.Scale(6), my, tw, 1, lblColor);
        }
        if (stateKey != 0 && Ui.Clicked(app, hitId)) {
            int nv = 1;
            if (hidden) { nv = 0; }
            app.StateSet(stateKey, nv);
            app.RequestRedraw();
            return true;
        }
        return false;
    }

    /// dataZoom 窗口状态键（分类范围的千分值 0..1000）。
    static int ZoomLoKey(int wid) { return 7000000 + wid * 2; }
    /// dataZoom 窗口上界状态键（千分值 0..1000，配对 ZoomLoKey）。
    static int ZoomHiKey(int wid) { return 7000000 + wid * 2 + 1; }
    /// 树图视口平移 X（像素；世界原点相对视口的偏移）。
    static int TreePanXKey(int wid) { return 8000000 + wid * 16; }
    /// 树图视口平移 Y（像素）。
    static int TreePanYKey(int wid) { return 8000000 + wid * 16 + 1; }
    /// 树图拖拽中最近一次指针 X。
    static int TreeDragXKey(int wid) { return 8000000 + wid * 16 + 2; }
    /// 树图拖拽中最近一次指针 Y。
    static int TreeDragYKey(int wid) { return 8000000 + wid * 16 + 3; }
    /// 树图拖拽按下瞬间的视口平移 X 快照（拖拽期间平移 = 快照 - 位移）。
    static int TreeDragPanXKey(int wid) { return 8000000 + wid * 16 + 4; }
    /// 树图拖拽按下瞬间的视口平移 Y 快照。
    static int TreeDragPanYKey(int wid) { return 8000000 + wid * 16 + 5; }
    /// 树图拖拽进行中标志（1 = 按下未释放；释放帧清零）。
    static int TreeDraggingKey(int wid) { return 8000000 + wid * 16 + 6; }
    /// 树图本次拖拽是否实际移动过（1 = 移动过；释放时吞掉 click）。
    static int TreeDragMovedKey(int wid) { return 8000000 + wid * 16 + 11; }
    /// 树缩放，为自然节点间距的百分比。0 表示尚未适配：
    /// 首帧（或工具箱「还原」）把整棵树放进视口中心，之后镜头
    /// 就是无限画布——平移不夹紧、缩放不因窗口尺寸变化而重置。
    static int TreeZoomKey(int wid) { return 8000000 + wid * 16 + 7; }
    /// 树图漫游（平移/滚轮/拖拽）的稳定命中 id：AllocId 每帧换号
    /// 会让滚轮/拖拽丢目标，此键给出跨帧稳定的 id。
    static int TreeHitKey(int wid) { return 8000000 + wid * 16 + 10; }

    /// 快照槽位的 RenderCache 指纹键（见 ChartView.RenderCached）。
    static int CacheKey(int slot) { return 9000000 + slot; }

    /// toolbox / 地图漫游 / 选中（与 Tree* 8000000 段错开）。
    /// 数据视图覆盖层开关（1 = 打开，由工具箱「数据视图」切换）。
    static int TbViewKey(int wid) { return 8200000 + wid * 8; }
    /// 魔法类型切换状态（1 = 切为折线，2 = 切为柱状，0 = 关）。
    static int TbMagicKey(int wid) { return 8200000 + wid * 8 + 1; }
    /// 区域缩放工具开关（1 = 开）。
    static int TbZoomKey(int wid) { return 8200000 + wid * 8 + 2; }
    /// 地图漫游缩放（百分比 40..280；读到的值 < 40 视为未初始化，
    /// 重置为 100）。
    static int MapZoomKey(int wid) { return 8200000 + wid * 8 + 3; }
    /// 地图漫游平移 X（像素）。
    static int MapPanXKey(int wid) { return 8200000 + wid * 8 + 4; }
    /// 地图漫游平移 Y（像素）。
    static int MapPanYKey(int wid) { return 8200000 + wid * 8 + 5; }
    /// 地图单选（selectedMode ""/"single"）选中区域下标（-1 = 无）。
    static int MapSelKey(int wid) { return 8200000 + wid * 8 + 6; }
    /// selectedMode="multiple"：按区域持久化选中位（8500000 段，
    /// wid*2048 容区域数，与上方各段无重叠）。
    static int MapRegionSelKey(int wid, int region) {
        return 8500000 + wid * 2048 + region;
    }
    /// 地图拖拽进行中标志（1 = 按下未释放；释放帧清零）。
    static int MapDragKey(int wid) { return 8200000 + wid * 8 + 7; }
    /// 地图拖拽中最近一次指针 X。
    static int MapDragXKey(int wid) { return 8300000 + wid * 4; }
    /// 地图拖拽中最近一次指针 Y。
    static int MapDragYKey(int wid) { return 8300000 + wid * 4 + 1; }
    /// 地图拖拽按下瞬间的平移 X 快照。
    static int MapDragPanXKey(int wid) { return 8300000 + wid * 4 + 2; }
    /// 地图拖拽按下瞬间的平移 Y 快照。
    static int MapDragPanYKey(int wid) { return 8300000 + wid * 4 + 3; }
    /// 工具箱第 k 个按钮的命中 id（k 为按钮在当排中的序号）。
    static int TbHitKey(int wid, int k) { return 8500000 + wid * 8 + k; }

    // ---- connect() 多图联动（ECharts connect：同组图表共享交互态）----
    // 组号由调用方声明（ConnectGroup()），组内所有图表把交互态键
    // 重定向到「组长」的 wid 上（同组第一张图），于是任何一张图里
    // 的 dataZoom 窗口 / 图例开关 / 十字线悬停类别，组内其余图同帧
    // 生效——键段 8600000（组长 wid * 16 + 槽）。
    /// 组登记键：同组第一张到达 Resolve 的图把自己的 wid（组长）
    /// 写进这里，其余图读它得到共享键基址；读到 0 = 尚未登记。
    static int ConnectGroupKey(int wid) { return 8600000 + wid * 16; }
    /// connect 组共享的「悬停类别下标」状态键（读写都落在组长
    /// wid 上）：组内图指针在绘图区内时写入自己的类别下标，
    /// 其余图同帧读它对齐十字线；组长登记时初始化为 -1（无悬停）。
    static int ConnectHoverKey(int wid) { return 8600000 + wid * 16 + 1; }
    /// connect 组键段槽 2（8600000 + wid*16 + 2），当前仓库内无读写方。
    static int ConnectHoverGenKey(int wid) { return 8600000 + wid * 16 + 2; }

    /// 将缩放窗口（千分值）解析为包含端点的分类索引范围 [i0,i1]。
    /// 首次调用时从 ChartOption.zoomStart/zoomEnd 初始化状态。
    static int ZoomI0(App app, ChartOption o, int wid, int n) {
        int lo = app.StateGet(Chart.ZoomLoKey(wid), 0 - 1);
        if (lo < 0) {
            lo = o.zoomStart * 10;
            // startValue 按类目名定位窗口起点（line-aqi 的
            // "2014-06-01"）；未声明或找不到类目回落百分比域。
            if (o.zoomStartValue != null && o.zoomStartValue.Length > 0 && n > 1) {
                int zi = Chart.CategoryIndexOf(o.XCategories(),
                    o.zoomStartValue);
                if (zi >= 0) { lo = zi * 1000 / (n - 1); }
            }
            app.StateSet(Chart.ZoomLoKey(wid), lo);
        }
        int i0 = lo * (n - 1) / 1000;
        if (i0 < 0) { i0 = 0; }
        if (i0 > n - 1) { i0 = n - 1; }
        return i0;
    }
    /// 窗口末端索引（与 ZoomI0 成对）。
    static int ZoomI1(App app, ChartOption o, int wid, int n) {
        int hi = app.StateGet(Chart.ZoomHiKey(wid), 0 - 1);
        if (hi < 0) {
            hi = o.zoomEnd * 10;
            if (o.zoomEndValue != null && o.zoomEndValue.Length > 0 && n > 1) {
                int zi = Chart.CategoryIndexOf(o.XCategories(),
                    o.zoomEndValue);
                if (zi >= 0) { hi = zi * 1000 / (n - 1); }
            }
            app.StateSet(Chart.ZoomHiKey(wid), hi);
        }
        int i1 = hi * (n - 1) / 1000;
        if (i1 < 0) { i1 = 0; }
        if (i1 > n - 1) { i1 = n - 1; }
        return i1;
    }

    /// 将标签窗口化为包含端点的索引范围 [i0,i1]（仅字符串
    /// 拷贝；渲染器对系列值也按同一 [i0,i1] 直接读原系列，
    /// 避免有损的系列克隆丢失 itemStyle/marks 等字段）。
    static List<string> WindowLabels(List<string> labels, int i0, int i1) {
        List<string> outp = new List<string>();
        int i = i0;
        while (i <= i1 && i < labels.Count) { outp.Add(labels[i]); i = i + 1; }
        return outp;
    }

    /// 类目名精确匹配的首个下标；未命中 -1（dataZoom
    /// startValue/endValue 的类目定位用）。
    static int CategoryIndexOf(List<string> cats, string name) {
        for (int i = 0; i < cats.Count; i = i + 1) {
            if (cats[i] == name) { return i; }
        }
        return 0 - 1;
    }

    /// 绘制 dataZoom 范围滑块并处理手柄拖拽。两个手柄设定
    /// 窗口边界（千分值 0..1000）；拖动选中的带可平移。
    /// 窗口状态以 wid 为键持久化在 App 状态映射中。
    static void DrawZoomBar(App app, int plotX, int plotW, int barY, int barH,
                            int wid, int n) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        if (plotW < 4 || n < 2) { return; }

        int lo = app.StateGet(Chart.ZoomLoKey(wid), 0);
        int hi = app.StateGet(Chart.ZoomHiKey(wid), 1000);

        int hw = app.Scale(6);
        int loX = plotX + lo * plotW / 1000;
        int hiX = plotX + hi * plotW / 1000;

        StyleBox sTrack = Style.Part(app, "chart", "zoom-track", "", "", "",
                                     Style.SNormal());
        StyleBox sWin = Style.Part(app, "chart", "zoom-window", "", "", "",
                                   Style.SNormal());
        StyleBox sHandle = Style.Part(app, "chart", "zoom-handle", "", "", "",
                                      Style.SNormal());

        // 轨道 + 选中窗口
        c.FillRoundRect(plotX, barY, plotW, barH, t.borderRadiusSmall, sTrack.BgOr(0));
        c.FillRect(loX, barY, hiX - loX, barH, sWin.BgOr(0));
        c.DrawRect(loX, barY, hiX - loX, barH, sWin.BorderOr(0), 1);

        // 手柄
        c.FillRoundRect(loX - hw, barY, hw * 2, barH, t.borderRadiusSmall, sHandle.BgOr(0));
        c.FillRoundRect(hiX - hw, barY, hw * 2, barH, t.borderRadiusSmall, sHandle.BgOr(0));

        int loId = app.focus.AllocId();
        int hiId = app.focus.AllocId();
        int bandId = app.focus.AllocId();
        app.hitTester.RegisterRect(loId, loX - hw, barY, hw * 2, barH, 3);
        app.hitTester.RegisterRect(hiId, hiX - hw, barY, hw * 2, barH, 3);
        app.hitTester.RegisterRect(bandId, loX + hw, barY, hiX - loX - hw * 2, barH, 3);

        int mxPm = (app.mouseX - plotX) * 1000 / plotW;
        if (mxPm < 0) { mxPm = 0; }
        if (mxPm > 1000) { mxPm = 1000; }
        int minGap = 1000 / (n - 1);
        if (minGap < 20) { minGap = 20; }

        if (Ui.Pressed(app, loId)) {
            lo = mxPm;
            if (lo > hi - minGap) { lo = hi - minGap; }
            if (lo < 0) { lo = 0; }
            app.StateSet(Chart.ZoomLoKey(wid), lo);
            app.RequestRedraw();
        } else if (Ui.Pressed(app, hiId)) {
            hi = mxPm;
            if (hi < lo + minGap) { hi = lo + minGap; }
            if (hi > 1000) { hi = 1000; }
            app.StateSet(Chart.ZoomHiKey(wid), hi);
            app.RequestRedraw();
        } else if (Ui.Pressed(app, bandId)) {
            // 平移：保持带宽，以指针为中心
            int width = hi - lo;
            int nlo = mxPm - width / 2;
            if (nlo < 0) { nlo = 0; }
            if (nlo + width > 1000) { nlo = 1000 - width; }
            app.StateSet(Chart.ZoomLoKey(wid), nlo);
            app.StateSet(Chart.ZoomHiKey(wid), nlo + width);
            app.RequestRedraw();
        }
    }

    /// 轴名几何：ECharts `AxisBuilder.ts:855-880` 的**基位**（即
    /// nameMoveOverlap 求解之前的确定量）+ 官方缺省
    /// `coord/axisDefault.ts:34 nameLocation:'end'`、`:47 nameGap:15`。
    ///
    /// 标准坐标系里的公式（sig = inverse ? -1 : 1、extent 沿轴方向）：
    ///   start  -> pos.x = extent[0] - sig*gap（nameMoveDir.x = -sig）
    ///   end    -> pos.x = extent[1] + sig*gap（nameMoveDir.x =  +sig）
    ///   middle -> pos.x = (extent[0]+extent[1])/2
    ///             pos.y = labelOffset + nameDirection*gap
    /// 渲染到屏幕要再叠 transformGroup：
    ///   x 轴：rotation 0，translate (plotX, 轴线 y)，nameDirection +1
    ///   y 轴：rotation +90°，translate (轴线 x, plotBot)，
    ///         nameDirection = left ? -1 : +1，映射 (a,b) -> (b, -a) + t
    /// 把两式合成、代入 nameGap=15，实测（关掉 nameMoveOverlap，
    /// `_scratch/chart_oracle/axisname.js`，rect=100,100,400,200）得到：
    ///   x start  (85,300) 右对齐锚   x middle (300,315) 居中、字盒顶贴锚
    ///   x end    (515,300) 左对齐锚  y start  (100,315) 居中、字盒顶贴锚
    ///   y middle (85,200) 绕锚点逆时针 90°（自下而上读），贴轴线内侧
    ///   y end    (100,85) 居中、字盒底贴锚
    /// inverse 只翻 start/end 的端：yAxes[1].inverse 的 area-rainfall
    /// 实测 start 落顶、end 落底（与不翻转相反）。
    class ChartAxisName {
        int ax;       // 行盒左上角 x（rot=-90 时是旋转锚点的 x）
        int ay;       // 行盒左上角 y（rot=-90 时锚点置于文本垂直中心）
        int rot;      // 0 | -90
        int anchor;   // 0=left 1=center 2=right（rot=0 时生效）
    }

    /// nameGap 像素（官方缺省 15，已按 DPI 缩放）。
    static int NameGapPx(App app, ChartAxis a) {
        int g = 15;
        if (a.nameGap >= 0) { g = a.nameGap; }
        return app.Scale(g);
    }

    /// 轴名基位（纯整数几何，字体度量由调用方喂进来）——conformance
    /// 用例据此在没有 App/Canvas 的情况下钉死三态落点。`fh` = 行盒高，
    /// `centerTop` = 垂直居中一行文本时的行盒顶边偏移（= CenterTextYAt(0)）。
    static ChartAxisName AxisNamePosPx(ChartAxis a, bool isX, int plotX,
                                       int plotY, int plotW, int plotH,
                                       bool far, int gap, int fh, int centerTop) {
        return Chart.AxisNamePosPx(a, isX, plotX, plotY, plotW, plotH, far,
            gap, fh, centerTop, 0 - 1);
    }

    /// 同上，另给轴线位置覆盖（page 坐标）：`axisLine` = x 轴的轴线 y /
    /// y 轴的轴线 x，-1 = 按绘图区边界推（x 轴底边、y 轴左/右缘）。
    /// T3b 的 axisLine.onZero 让轴线骑到零线上时从这条缝进来。
    static ChartAxisName AxisNamePosPx(ChartAxis a, bool isX, int plotX,
                                       int plotY, int plotW, int plotH,
                                       bool far, int gap, int fh, int centerTop,
                                       int axisLine) {
        int sig = 1;
        if (a.reversed) { sig = 0 - 1; }
        int len = plotW;
        if (!isX) { len = plotH; }
        // extent[0] = 数据下界的 local 坐标；翻转时落在轴的远端。
        int ext0 = 0;
        if (a.reversed) { ext0 = len; }
        int ext1 = len - ext0;
        int plotBot = plotY + plotH;
        // 未移动的边界基位（骑线覆盖只搬 start/end，middle 永远回到这里）。
        int baseLine = plotBot;
        if (!isX) { baseLine = plotX; if (far) { baseLine = plotX + plotW; } }
        if (axisLine < 0) { axisLine = baseLine; }
        string loc = a.nameLocation;
        if (loc != "start" && loc != "middle") { loc = "end"; }
        // onZero 只搬 start/end 态的名字（贴轴线走）；middle 的官方
        // pos.y = labelOffset + nameDirection*gap，labelOffset 是轴线
        // 位移的补偿，页面坐标里抵回原位 ⇒ 名字留在绘图区边界
        // （_scratch/chart_oracle/onzero_namemid.js 实测）。
        if (loc == "middle") { axisLine = baseLine; }
        ChartAxisName n = new ChartAxisName();
        n.rot = 0;
        n.anchor = 1;
        if (isX) {
            if (loc == "middle") {
                n.ax = plotX + len / 2;
                n.ay = axisLine + gap;              // 字盒顶贴锚
            } else if (loc == "start") {
                n.ax = plotX + ext0 - sig * gap;
                n.anchor = 2;                       // 右对齐
                n.ay = axisLine + centerTop;
            } else {
                n.ax = plotX + ext1 + sig * gap;
                n.anchor = 0;                       // 左对齐
                n.ay = axisLine + centerTop;
            }
            return n;
        }
        if (loc == "middle") {
            n.rot = 0 - 90;                         // 自下而上读
            // 旋转 −90° 后文字盒占 x∈[ax, ax+行高]；ECharts 的实测是把这个
            // 盒**以轴线内侧 gap 处为中心**（左轴实测盒 [79,93]，axisLine
            // =100、gap=15 ⇒ 中心 86 ≈ axisLine−gap），故锚点回退半个行高。
            n.ax = axisLine - gap - fh / 2;
            if (far) { n.ax = axisLine + gap - fh / 2; }
            n.ay = plotBot - len / 2;               // 锚点中线
            return n;
        }
        n.ax = axisLine;
        // 锚点（AxisBuilder.ts:855-864 的 pos.x 经 transformGroup 映射到
        // 页面 y：page_y = plotBot - pos.x）。
        int anchorY = plotBot - ext1 - sig * gap;
        if (loc == "start") { anchorY = plotBot - ext0 + sig * gap; }
        // 轴名恒在绘图区**外侧**：锚点落在下侧时字盒顶贴锚，落在上侧
        // 时字盒底贴锚（`endTextLayout` 的 onLeft → verticalAlign
        // bottom/top）。inverse 把 start/end 的落点对调，所以"是否在
        // 下侧"= (loc == "start") != inverse。
        bool below = (loc == "start");
        if (a.reversed) { below = !below; }
        n.ay = anchorY;
        if (!below) { n.ay = anchorY - fh; }
        return n;
    }

    /// App 版：换算 nameGap（缺省 15）并取字体度量。
    static ChartAxisName AxisNamePos(App app, ChartAxis a, bool isX,
                                    int plotX, int plotY, int plotW, int plotH,
                                    bool far, int fs) {
        return Chart.AxisNamePos(app, a, isX, plotX, plotY, plotW, plotH, far,
            fs, 0 - 1);
    }

    /// App 版 + 轴线位置覆盖（onZero 让轴线离开绘图区边界时用）。
    static ChartAxisName AxisNamePos(App app, ChartAxis a, bool isX,
                                    int plotX, int plotY, int plotW, int plotH,
                                    bool far, int fs, int axisLine) {
        return Chart.AxisNamePosPx(a, isX, plotX, plotY, plotW, plotH, far,
            Chart.NameGapPx(app, a), Canvas.FontHeight(fs),
            Canvas.CenterTextYAt(0, fs), axisLine);
    }

    /// 轴名占据的像素盒（用于给绘图区让出上下栏）。rot=-90 的行盒
    /// （tw x fh）绕 (ax, ay) 逆时针转 90° 后占 x∈[ax,ax+fh]、
    /// y∈[ay-tw, ay]（见 AxisNameY 的推导），故 y 区间以 ay 为下界。
    class ChartNameBox {
        int left;
        int top;
        int right;
        int bottom;
    }

    static ChartNameBox AxisNameBoxPx(ChartAxis a, bool isX, int plotX,
                                      int plotY, int plotW, int plotH,
                                      bool far, int gap, int fh, int centerTop,
                                      int tw, int axisLine) {
        ChartNameBox b = new ChartNameBox();
        ChartAxisName n = Chart.AxisNamePosPx(a, isX, plotX, plotY, plotW,
            plotH, far, gap, fh, centerTop, axisLine);
        if (n.rot == 0) {
            int l = n.ax;
            if (n.anchor == 1) { l = n.ax - tw / 2; }
            if (n.anchor == 2) { l = n.ax - tw; }
            b.left = l; b.right = l + tw;
            b.top = n.ay; b.bottom = n.ay + fh;
        } else {
            b.left = n.ax; b.right = n.ax + fh;
            b.top = n.ay - tw / 2; b.bottom = n.ay + tw / 2;
        }
        return b;
    }

    /// 轴名行盒左缘（rot=0 时按 anchor 对齐）。
    static int AxisNameX(App app, ChartAxis a, ChartAxisName n, int fs) {
        if (n.rot != 0) { return n.ax; }
        int tw = Canvas.MeasureText(a.title, fs);
        if (n.anchor == 1) { return n.ax - tw / 2; }
        if (n.anchor == 2) { return n.ax - tw; }
        return n.ax;
    }

    /// 轴名行盒顶边：rot=-90 的行盒（tw x fh）绕 (ax, ay) 逆时针转 90°
    /// 后占 y∈[ay-tw, ay]，故把锚点下移半个文本宽使文本以锚点为中心。
    static int AxisNameY(App app, ChartAxis a, ChartAxisName n, int fs) {
        if (n.rot == 0) { return n.ay; }
        return n.ay + Canvas.MeasureText(a.title, fs) / 2;
    }

    /// 画一根轴的轴名（三态 + nameGap + inverse + y 轴 position=right）。
    static void DrawAxisName(App app, Canvas c, ChartAxis a, bool isX,
                            int plotX, int plotY, int plotW, int plotH, bool far,
                            StyleBox sTitle, int fs) {
        Chart.DrawAxisNameAt(app, c, a, isX, plotX, plotY, plotW, plotH, far,
            sTitle, fs, 0 - 1);
    }

    /// 同上，另给轴线位置覆盖（page 坐标）：onZero 让轴线骑到零线上时，
    /// start/end 态的名字贴轴线走，middle 态留在绘图区边界（官方
    /// AxisBuilder.ts:869 的 middle pos.y = labelOffset + nameDir*gap，
    /// labelOffset 恰好抵回原位；start/end 的 pos.y=0 直接收组的平移）。
    static void DrawAxisNameAt(App app, Canvas c, ChartAxis a, bool isX,
                              int plotX, int plotY, int plotW, int plotH, bool far,
                              StyleBox sTitle, int fs, int axisLine) {
        if (a == null || a.title.Length == 0 || !a.show) { return; }
        ChartAxisName n = Chart.AxisNamePos(app, a, isX, plotX, plotY, plotW,
            plotH, far, fs, axisLine);
        int ax = Chart.AxisNameX(app, a, n, fs);
        int ay = Chart.AxisNameY(app, a, n, fs);
        if (n.rot == 0) {
            c.DrawText(ax, ay, a.title, sTitle.FgOr(0), fs);
        } else {
            c.DrawTextRot(ax, ay, a.title, sTitle.FgOr(0), fs, n.rot);
        }
    }

    /// 右侧竖排图例的起始 y（官方盒模型）：先按 legend.top/bottom 锚
    /// （未声明时官方默认 bottom 15）算贴底位置，再受工具箱避让约束
    /// 下移。rowsH 为图例整列高度；<= 0 时退化为仅工具箱避让。
    static int LegendStartY(App app, int y, int proposed) {
        return Chart.LegendStartYRows(app, y, proposed, 0, 0, 0);
    }

    /// 带容器尺寸的版本：h/rowsH 给出时按官方 bottom 锚贴底。
    static int LegendStartYRows(App app, int y, int proposed, int h, int rowsH, int pad) {
        int startY = proposed;
        if (h > 0 && rowsH > 0) {
            startY = Chart.LegendFloatTop(app, y, h, rowsH, pad);
        }
        if (Chart.toolReserve < 1) { return startY; }
        int bandBot = y + app.theme.paddingMedium
            + ChartToolbox.Height(app) + app.Scale(4);
        if (startY < bandBot) { return bandBot; }
        return startY;
    }

    /// 图例占用的行数：有工具箱时整排下移到标题行之下（至少 1 行）；
    /// 否则与标题同行，仅统计放不下而换出的行。
    /// 图例项 = 唯一系列名（ECharts2 图例按名字去重：bar9 同名的
    /// 可见段与透明孔段共用一个图例项）。返回每个名字首个系列
    /// 的下标；DrawPanelI 与 LegendRowCount 必须同用本函数，
    /// 两边的行高/换行才能对齐。
    static List<int> LegendPrimIdx(List<ChartSeries> series) {
        List<int> prim = new List<int>();
        // 混搭面板（ECharts2 同 option 混排）：与主体不同族的
        // Pie/Gauge/Funnel 系列经 DrawOverlaySeries 叠绘在笛卡尔
        // 坐标系上，不占图例项；piePerPoint 饼在散点核内逐点绘制，
        // 同样不占。legend.data 白名单存在时只列白名单内的名字。
        ChartOption lo = Chart.legendOpt;
        ChartType leadT = series.Count > 0 ? series[0].type : ChartType.Line;
        if (lo != null && lo.series.Count > 0) {
            leadT = lo.series[0].type;
            if (leadT == ChartType.Pie && lo.series[0].piePerPoint) {
                leadT = ChartType.Scatter;
            }
        }
        for (int ui = 0; ui < series.Count; ui = ui + 1) {
            ChartSeries cs = series[ui];
            bool ov = (cs.type == ChartType.Pie || cs.type == ChartType.Gauge
                || cs.type == ChartType.Funnel) && cs.type != leadT;
            if (cs.type == ChartType.Pie && cs.piePerPoint) { ov = true; }
            if (lo != null && ov) { continue; }
            if (lo != null && lo.legendData != null
                && lo.legendData.Count > 0) {
                bool white = false;
                for (int wl = 0; wl < lo.legendData.Count; wl = wl + 1) {
                    if (lo.legendData[wl] == cs.name) { white = true; break; }
                }
                if (!white) { continue; }
            }
            bool dup = false;
            for (int uj = 0; uj < prim.Count; uj = uj + 1) {
                if (series[prim[uj]].name == cs.name) { dup = true; break; }
            }
            if (!dup) { prim.Add(ui); }
        }
        return prim;
    }

    static int LegendRowCount(App app, int x, int w, string title,
                              List<ChartSeries> series) {
        if (series == null || series.Count < 1) { return 0; }
        List<int> prim = Chart.LegendPrimIdx(series);
        if (Chart.LegendVertical()) { return prim.Count; }
        string fmt = Chart.LegendFmt();
        int pad = app.theme.paddingMedium;
        int lgFs = ChartFonts.Legend(app);
        int sw = app.Scale(12);
        bool below = Chart.toolReserve > 0;
        int extra = 0;
        if (below) {
            extra = 1;
            int xCur = x + pad;
            int maxX = x + w - pad;
            for (int pi = 0; pi < prim.Count; pi = pi + 1) {
                int chipW = sw + app.Scale(6)
                    + Canvas.MeasureText(Chart.LegendLabel(fmt, series[prim[pi]].name), lgFs);
                if (xCur > x + pad && xCur + chipW > maxX) {
                    extra = extra + 1;
                    xCur = x + pad;
                }
                xCur = xCur + chipW + app.Scale(14);
            }
            return extra;
        }
        int lx = x + w - pad;
        int leftLimit = x + pad;
        if (title.Length > 0) {
            leftLimit = x + pad
                + Canvas.MeasureText(title, Style.FontFallback(app, "large"))
                + app.Scale(14);
        }
        int pi2 = prim.Count - 1;
        while (pi2 >= 0) {
            int tw = Canvas.MeasureText(Chart.LegendLabel(fmt, series[prim[pi2]].name), lgFs);
            int rowLeft = lx - tw - app.Scale(6) - sw;
            if (rowLeft < leftLimit) {
                extra = extra + 1;
                lx = x + w - pad;
                leftLimit = x + pad;
                rowLeft = lx - tw - app.Scale(6) - sw;
                if (rowLeft < leftLimit) { rowLeft = leftLimit; }
            }
            lx = rowLeft - app.Scale(14);
            pi2 = pi2 - 1;
        }
        return extra;
    }

    /// 面板内容区顶部 y：标题/工具箱行 + 图例行 + 间隙。
    /// DrawPanelI 与 PanelTopI 共用，悬停层才能与主体对齐。
    static int PanelContentTop(App app, int x, int y, int w, string title,
                               List<ChartSeries> series, bool showLegend) {
        int pad = app.theme.paddingMedium;
        // grid 子面板是纯绘图区：不预留标题/工具箱头部（ECharts
        // grid 语义，页级元素由派发层在面板坐标画一次）。
        if (Chart.gridPanelSub) { return y + pad; }
        int titleH = Canvas.FontHeight(Style.FontFallback(app, "large"));
        if (title.Length > 0 && Chart.TitleSubText().Length > 0) {
            titleH = titleH + Canvas.FontHeight(ChartFonts.SeriesLabel(app))
                + app.Scale(2);
        }
        int headH = titleH;
        if (Chart.toolReserve > 0) {
            int th = ChartToolbox.Height(app);
            if (th > headH) { headH = th; }
        }
        int belowGap = 0;
        int extra = 0;
        // ECharts 6：水平图例在面板底部（legendBottomReserve，
        // BuildAxesR 扣除），只有竖排图例还从内容区顶部占行。
        if (showLegend && Chart.LegendVertical()) {
            extra = Chart.LegendRowCount(app, x, w, title, series);
            if (Chart.toolReserve > 0) { belowGap = app.Scale(4); }
        }
        int rowH = Canvas.FontHeight(ChartFonts.Legend(app)) + app.Scale(6);
        return y + pad + headH + belowGap + extra * rowH + app.Scale(6);
    }

    /// 面板 + 交互式图例。wid != 0 时每个色块是一个命中区域：
    /// 点击切换该系列的可见性（以 wid 为键持久化在
    /// App 状态映射中），解析后的隐藏标志写入帧内系列
    /// 快照，所有下游渲染器都会跳过它。隐藏的系列
    /// 以变暗 + 删除线绘制，以便可以恢复显示。
    /// showLegend=false 时既绘制也不解析隐藏状态——
    /// 图例关闭时系列恒为可见，避免状态残留让图无声消失。
    /// 返回内容区顶部 y。悬停覆盖层请用 PanelTopI。
    static int DrawPanelI(App app, int x, int y, int w, int h, string title,
                          List<ChartSeries> series, int wid, bool showLegend) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int pad = t.paddingMedium;

        StyleBox sPanel = Style.Full(app, "chart", "", "", Style.SNormal());
        // option.backgroundColor 优先于主题面板色（A13）：整卡底色。
        c.SurfaceRoundRect(x, y, w, h, t.borderRadiusMedium,
            Chart.PanelBgOr(sPanel.BgOr(0)), sPanel.BorderOr(0), 1);

        int top = y + pad;
        // ECharts 6 TitleModel.defaultOption：textStyle.fontSize 18 / bold /
        // color tokens.color.primary(#3c3c41)；subtextStyle.fontSize 12 /
        // color tokens.color.quaternary(#86878c)。按官方 px 值缩放，不跟随
        // IDE 主题字号档（图表是契约兼容，默认值须与官方一致）。
        int titleFs = app.Scale(18);
        int titleSubFs = app.Scale(12);
        int titleH = Canvas.FontHeight(titleFs);
        string titleSub = Chart.TitleSubText();
        if (title.Length > 0 && titleSub.Length > 0) {
            titleH = titleH + Canvas.FontHeight(titleSubFs) + app.Scale(2);
        }
        int titleMax = x + w - pad - Chart.toolReserve - (x + pad) - app.Scale(8);
        if (title.Length > 0 && titleMax > 0) {
            int tW = Canvas.MeasureText(title, titleFs);
            string tal = Chart.TitleAlignMode();
            int tx = x + pad;
            if (tal == "center") { tx = x + pad + (titleMax - tW) / 2; }
            else if (tal == "right") { tx = x + pad + titleMax - tW; }
            if (tx < x + pad) { tx = x + pad; }
            c.PushClip(x + pad, top, titleMax, titleH);
            // 官方 title.textStyle.fontWeight 默认 'bold'。
            c.DrawTextBold(tx, top, title, Chart.TitleColor(), titleFs);
            if (titleSub.Length > 0) {
                int subFs = titleSubFs;
                int subW = Canvas.MeasureText(titleSub, subFs);
                int sx = tx;
                if (tal == "center") { sx = x + pad + (titleMax - subW) / 2; }
                else if (tal == "right") { sx = x + pad + titleMax - subW; }
                if (sx < x + pad) { sx = x + pad; }
                c.DrawText(sx, top + Canvas.FontHeight(titleFs), titleSub,
                    Chart.TitleSubColor(), subFs);
            }
            c.PopClip();
        }

        if (showLegend) {
        // 图例项按系列名去重（LegendPrimIdx）；先把全部系列的
        // 隐藏态从状态映射同步进来——同名非主系列没有自己的
        // 色块，靠这一步跟随主项显隐。
        List<int> prim = Chart.LegendPrimIdx(series);
        for (int hsi = 0; hsi < series.Count; hsi = hsi + 1) {
            bool hs0 = series[hsi].hidden;
            if (wid != 0) {
                hs0 = app.StateGet(Chart.LegendKey(wid, hsi), hs0 ? 1 : 0) == 1;
            }
            series[hsi].hidden = hs0;
        }
        // ECharts 6 默认（LegendModel defaultOption：left 'center' +
        // bottom tokens.size.m）：水平图例画在面板底部居中，行数计入
        // legendBottomReserve，由 BuildAxesR 从绘图区底边扣除；竖排
        // 图例保持顶部标题行之下左对齐（官方例显式 orient:'vertical'
        // 才纵向，位置随例声明）。
        StyleBox sLegend = Style.Part(app, "chart", "legend", "", "", "",
                                      Style.SNormal());
        StyleBox sLegendOff = Style.Part(app, "chart", "legend", "", "off", "",
                                         Style.SNormal());
        int sw = app.Scale(12);
        int lgFs = ChartFonts.Legend(app);
        int rowH = Canvas.FontHeight(lgFs) + app.Scale(6);
        string fmt = Chart.LegendFmt();
        int lmode = Chart.LegendSelMode();
        bool vert = Chart.LegendVertical();
        int headH = titleH;
        if (vert) {
            int toolH = ChartToolbox.Height(app);
            if (toolH > headH) { headH = toolH; }
        }
        int lgY = y + pad;
        if (vert) {
            lgY = y + pad + headH + app.Scale(4);
            // 官方盒模型：显式 top 数值锚贴顶，显式 bottom 数值锚贴底，
            // 关键字 top/middle/bottom 对应上/中/下。竖排图例官方默认
            // 仍是 left 'center' + bottom 15（LegendModel.defaultOption），
            // 故未声明垂直锚时按 bottom 15 贴底。
            int rowsV = prim.Count;
            if (rowsV < 1) { rowsV = 1; }
            lgY = Chart.LegendFloatTop(app, y, h, rowsV * rowH, pad);
            Chart.legendBottomReserve = 0; // 竖排不占横带
        } else {
            // 底部：先用与绘制完全相同的换行规则量出行数，再从面板
            // 底边起排（绘图区一侧留 app.Scale(4) 间隙）。
            int availL = x + pad;
            int availR = x + w - pad;
            int rows = 1;
            int wCur = availL;
            for (int sm = 0; sm < prim.Count; sm = sm + 1) {
                int chipW = sw + app.Scale(6)
                    + Canvas.MeasureText(Chart.LegendLabel(fmt, series[prim[sm]].name), lgFs);
                if (wCur > availL && wCur + chipW > availR) {
                    rows = rows + 1;
                    wCur = availL;
                }
                wCur = wCur + chipW + app.Scale(14);
            }
            lgY = y + h - pad - rows * rowH;
            // 除图例行高外，还要给 x 轴刻度文本带留 gutter
            // （BuildAxesR 的 botGut = 刻度字高 + Scale(8)），
            // 否则类目标签与图例同行相撞。
            Chart.legendBottomReserve = rows * rowH + app.Scale(4)
                + Canvas.FontHeight(lgFs) + app.Scale(8);
        }
            int xCur = x + pad;
            int maxX = x + w - pad;
            if (!vert) {
                int totW = 0;
                for (int sm = 0; sm < prim.Count; sm = sm + 1) {
                    totW = totW + sw + app.Scale(6)
                        + Canvas.MeasureText(Chart.LegendLabel(fmt, series[prim[sm]].name), lgFs)
                        + app.Scale(14);
                }
                if (prim.Count > 0) { totW = totW - app.Scale(14); }
                if (totW > 0 && totW <= maxX - xCur) {
                    // 官方盒模型：left/right/center 关键字，或 left/right
                    // 数值锚（px）。两者都未声明时 = 官方默认 center。
                    xCur = Chart.LegendFloatLeft(app, x, w, totW, pad,
                        x + pad, maxX);
                }
            }
            for (int pi = 0; pi < prim.Count; pi = pi + 1) {
                int p = prim[pi];
                bool hid = series[p].hidden;
                string nm = Chart.LegendLabel(fmt, series[p].name);
                int tw = Canvas.MeasureText(nm, lgFs);
                int chipW = sw + app.Scale(6) + tw;
                if (xCur > x + pad && (vert || xCur + chipW > maxX)) {
                    xCur = x + pad;
                    lgY = lgY + rowH;
                }
                int txtCol = sLegend.FgOr(0);
                int swCol = Chart.SeriesPaintColor(series[p], t, p);
                if (hid) { txtCol = sLegendOff.FgOr(0); swCol = sLegendOff.BgOr(0); }
                c.FillRoundRect(xCur, lgY + app.Scale(3), sw, sw, t.borderRadiusSmall, swCol);
                c.DrawText(xCur + sw + app.Scale(6), lgY + app.Scale(2), nm, txtCol, lgFs);
                if (hid) {
                    int my = lgY + app.Scale(2) + Canvas.FontHeight(lgFs) / 2;
                    c.FillRect(xCur + sw + app.Scale(6), my, tw, 1, sLegendOff.FgOr(0));
                }
                if (wid != 0 && lmode != 0 - 1) {
                    int hitId = app.focus.AllocId();
                    app.hitTester.RegisterRect(hitId, xCur, lgY, chipW, rowH, 3);
                    if (Ui.Clicked(app, hitId)) {
                        hid = Chart.LegendClick(app, wid, series, p, hid, lmode);
                        // 同名系列随主项一起开关（single 模式下
                        // LegendClick 先全隐藏，这里把本组改回来）。
                        for (int gm = 0; gm < series.Count; gm = gm + 1) {
                            if (gm != p && series[gm].name == series[p].name) {
                                app.StateSet(Chart.LegendKey(wid, gm), hid ? 1 : 0);
                            }
                        }
                    }
                }
                series[p].hidden = hid;
                xCur = xCur + chipW + app.Scale(14);
            }
        }

        return Chart.PanelContentTop(app, x, y, w, title, series, showLegend);
    }

    /// legend 色块点击（单一实现供两个布局分支复用）：写隐藏态，
    /// single 模式下「显示一个」同时隐藏其余系列。返回点击后的 hid。
    /// 触发 LegendSelected 交互事件。
    static bool LegendClick(App app, int wid, List<ChartSeries> series,
                            int si, bool hid, int mode) {
        int nv = 1;
        if (hid) { nv = 0; }
        app.StateSet(Chart.LegendKey(wid, si), nv);
        ChartInteractionEvent le = ChartInteractionEvent.Series(
            ChartEventType.LegendSelected, wid, si, series[si].name);
        le.selected = nv == 0;
        ChartView.RaiseActive(le);
        if (nv == 0 && mode == 1) {
            for (int oi = 0; oi < series.Count; oi = oi + 1) {
                if (oi != si) {
                    app.StateSet(Chart.LegendKey(wid, oi), 1);
                    series[oi].hidden = true;
                }
            }
        }
        app.RequestRedraw();
        return nv == 1;
    }

    /// 只算不画：与 DrawPanelI 完全一致的面板内容顶部
    /// （标题行高 + 图例换行占位，换行算法逐行镜像）。
    /// 悬停覆盖层用它与主体帧对齐——覆盖层绝不能调
    /// DrawPanelI / PanelHead，它们会重绘面板背景盖住图形。
    static int PanelTopI(App app, int x, int y, int w, string title,
                         List<ChartSeries> series, bool showLegend) {
        return Chart.PanelContentTop(app, x, y, w, title, series, showLegend);
    }

    /// 左轴上的阴影 markArea 带 [markLo, markHi]（绘制在
    /// 系列之下）。两个边界未全部设置时为空操作。
    static void DrawMarkArea(App app, ChartFrame f, ChartOption o) {
        if (o.markLo == ChartOption.Auto() || o.markHi == ChartOption.Auto()) { return; }
        Canvas c = app.canvas;
        Theme t = app.theme;
        int y0 = f.YOf(o.markHi, 0);
        int y1 = f.YOf(o.markLo, 0);
        if (y1 < y0) { int tmp = y0; y0 = y1; y1 = tmp; }
        int areaBase = Style.Part(app, "chart", "mark-area", "", "", "",
                                  Style.SNormal()).BgOr(0);
        c.FillRect(f.plotX, y0, f.plotW, y1 - y0, Chart.WithAlpha(areaBase, 28));
    }

    // ---- dataRange 值过滤（消费方共用 seam）----

    /// 生效筛选窗口的单边边界：固定 dataRangeLo/Hi 优先（Auto →
    /// dMin/dMax）；calculable 时再取滑条状态位（q 0..1000，默认
    /// 不裁剪）线性映射后与固定值取更收紧的一侧。upper=false 取下界。
    static int DRangeEff(App app, ChartOption o, int wid, int dMin, int dMax,
                         bool upper) {
        int baseV = upper ? o.dataRangeHi : o.dataRangeLo;
        if (baseV == ChartOption.Auto()) { baseV = upper ? dMax : dMin; }
        if (o.dataRangeCalculable && wid != 0) {
            int q = app.StateGet(upper ? Chart.DRangeHiKey(wid)
                                       : Chart.DRangeLoKey(wid),
                                 upper ? 1000 : 0);
            int sv = Chart.DataRangeValue(dMin, dMax, q);
            if (upper) { if (sv < baseV) { baseV = sv; } }
            else { if (sv > baseV) { baseV = sv; } }
        }
        return baseV;
    }

    /// 值 v 是否落在 splitList 的某个「未点掉」分段里（无列表 = 放行）。
    static bool DRangeBandOk(App app, ChartOption o, int wid, int v) {
        if (o.dataRangeList.Count < 1) { return true; }
        for (int bi = 0; bi < o.dataRangeList.Count; bi = bi + 1) {
            ChartRangeSplit sp = o.dataRangeList[bi];
            if ((sp.lo == ChartOption.Auto() || v >= sp.lo)
                && (sp.hi == ChartOption.Auto() || v <= sp.hi)) {
                if (wid != 0 && app.StateGet(Chart.DRangeBandKey(wid, bi), 0) != 0) {
                    return false;
                }
                return true;
            }
        }
        return false;
    }

    /// 统一消费 seam：值 v 是否通过当前 dataRange 过滤
    /// （滑条窗口 + splitList 分段可见性）。dataRangeShow=false 时放行。
    static bool DRangeOk(App app, ChartOption o, int wid, int dMin, int dMax, int v) {
        if (!o.dataRangeShow) { return true; }
        if (v < Chart.DRangeEff(app, o, wid, dMin, dMax, false)) { return false; }
        if (v > Chart.DRangeEff(app, o, wid, dMin, dMax, true)) { return false; }
        return Chart.DRangeBandOk(app, o, wid, v);
    }

    /// 左轴 markLine 处的水平阈值线（虚线），带可选的
    /// 右对齐标签（绘制在系列之上）。markLine 未设置时为空操作。
    static void DrawMarkLine(App app, ChartFrame f, ChartOption o) {
        if (o.markLine == ChartOption.Auto()) { return; }
        Canvas c = app.canvas;
        Theme t = app.theme;
        int my = f.YOf(o.markLine, 0);
        StyleBox sMark = Style.Part(app, "chart", "mark", "", "", "",
                                    Style.SNormal());
        // 虚线
        int dx = f.plotX;
        int dash = app.Scale(6);
        while (dx < f.plotX + f.plotW) {
            int seg = dash;
            if (dx + seg > f.plotX + f.plotW) { seg = f.plotX + f.plotW - dx; }
            c.FillRect(dx, my, seg, 1, sMark.BgOr(0));
            dx = dx + dash * 2;
        }
        if (o.markLabel.Length > 0) {
            int fs = ChartFonts.SeriesLabel(app);
            int lw = Canvas.MeasureText(o.markLabel, fs);
            c.DrawText(f.plotX + f.plotW - lw, my - Canvas.FontHeight(fs) - app.Scale(1),
                o.markLabel, sMark.FgOr(0), fs);
        }
    }

    /// 轴线公共尾（DrawFrameTO/DrawFrameLoHiO 用）：竖线 = y 轴、
    /// 横线 = x 轴，按 axisLine 三态/'auto'（cartesianAxisHelper.ts
    /// axisLineAutoShow：'auto' 只画对侧为 value/log 的轴）定画不画，
    /// onZero 骑线把 x 轴线搬到 y 轴的 0 位（Grid.ts:614-717，
    /// EDGE 也算、钳在绘图区内）。yLo/yHi 为 y 轴数值域；
    /// o = null 时两根线都画（旧形态）。
    static void FrameLines(App app, Canvas c, ChartOption o, int yLo, int yHi,
                           int plotX, int plotY, int plotW, int plotH, int ink) {
        ChartAxis frX = o == null ? null : o.XAxis0();
        ChartAxis frY = o == null ? null : o.YAxis0();
        bool frXIsVL = frX != null && (frX.type == ChartAxisType.Value
            || frX.type == ChartAxisType.Log);
        bool frYIsVL = frY != null && (frY.type == ChartAxisType.Value
            || frY.type == ChartAxisType.Log);
        bool yLine = frY == null || (frY.show
            && Chart.AxisLineDraws(frY.axisLineShow, frXIsVL));
        bool xLine = frX == null || (frX.show
            && Chart.AxisLineDraws(frX.axisLineShow, frYIsVL));
        int xLineY = plotY + plotH;
        if (o != null && Chart.CanOnZeroTo(frY, yLo, yHi, frX.onZero)) {
            long spanL = (long)yHi - (long)yLo;
            if (spanL < 1) { spanL = 1; }
            int zy = plotY + plotH
                - (int)((long)(0 - yLo) * (long)plotH / spanL);
            if (zy < plotY) { zy = plotY; }
            if (zy > plotY + plotH) { zy = plotY + plotH; }
            xLineY = zy;
        }
        if (yLine) { c.FillRect(plotX, plotY, app.Scale(2), plotH, ink); }
        if (xLine) { c.FillRect(plotX, xLineY, plotW, app.Scale(2), ink); }
    }

    /// 带数值网格线（左）+ 分类标签（底部）的直角坐标系框架。
    /// 轴范围 [0, maxV]。需要双轴/固定范围/时间轴时用 BuildAxes。
    static ChartFrame DrawFrame(App app, int x, int y, int w, int h, int plotTop,
                                List<string> labels, int maxV) {
        return Chart.DrawFrameT(app, x, y, w, h, plotTop, labels, maxV, 5);
    }

    /// 同 DrawFrame，但刻度数显式给定（ECharts nice 步长的
    /// 刻度数可不同于 5，如 0..1400 每 200 = 7 格）。
    static ChartFrame DrawFrameT(App app, int x, int y, int w, int h, int plotTop,
                                 List<string> labels, int maxV, int ticks) {
        return Chart.DrawFrameTO(app, x, y, w, h, plotTop, labels, maxV, ticks,
            null);
    }

    /// 同 DrawFrameT，另吃 ChartOption：按 axisLine 三态/骑线画
    /// 轴线（o = null 保持旧形态，两根线都画）。y 域 [0, maxV] 的
    /// 0 是 EDGE，x 轴线骑过去仍是底边。
    static ChartFrame DrawFrameTO(App app, int x, int y, int w, int h, int plotTop,
                                  List<string> labels, int maxV, int ticks,
                                  ChartOption o) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int pad = t.paddingMedium;
        int axisFs = ChartFonts.AxisLabel(app);
        if (ticks < 1) { ticks = 5; }

        int leftGut = Canvas.MeasureText(Chart.Commas(maxV), axisFs) + app.Scale(12);
        int botGut = Canvas.FontHeight(axisFs) + app.Scale(8);

        int plotX = x + pad + leftGut;
        int plotY = plotTop;
        int plotW = (x + w - pad) - plotX;
        // 底部图例（ECharts 6 默认）从绘图区底边扣除。
        int plotH = (y + h - pad - botGut - Chart.legendBottomReserve) - plotY;
        if (plotW < app.Scale(20)) { plotW = app.Scale(20); }
        if (plotH < app.Scale(20)) { plotH = app.Scale(20); }

        StyleBox sGrid = Style.Part(app, "chart", "grid", "", "", "",
                                    Style.SNormal());
        StyleBox sAxis = Style.Part(app, "chart", "axis", "", "", "",
                                    Style.SNormal());
        for (int k = 0; k <= ticks; k = k + 1) {
            int gy = plotY + plotH - (k * plotH / ticks);
            c.FillRect(plotX, gy, plotW, 1, sGrid.BgOr(0));
            int val = maxV * k / ticks;
            string vs = Chart.Commas(val);
            int vw = Canvas.MeasureText(vs, axisFs);
            c.DrawText(plotX - app.Scale(6) - vw, Canvas.CenterTextYAt(gy, axisFs), vs, sAxis.FgOr(0), axisFs);
        }
        Chart.FrameLines(app, c, o, 0, maxV, plotX, plotY, plotW, plotH,
            sAxis.BgOr(0));

        int n = labels.Count;
        if (n > 0) {
            for (int ci = 0; ci < n; ci = ci + 1) {
                int cxs = plotX + ci * plotW / n;
                int cellW = plotX + (ci + 1) * plotW / n - cxs;
                c.DrawTextCentered(cxs, plotY + plotH + app.Scale(4), cellW, botGut,
                    labels[ci], sAxis.FgOr(0), axisFs);
            }
        }

        ChartFrame f = new ChartFrame();
        f.plotX = plotX;
        f.plotY = plotY;
        f.plotW = plotW;
        f.plotH = plotH;
        f.leftMin = 0;
        f.leftMax = maxV;
        f.catBoundaryGap = true;
        return f;
    }

    /// 在显式数值范围 [lo, hi] 上的直角坐标系框架（支持非零
    /// 基线/负数），用于蜡烛图、箱线图和误差图。
    static ChartFrame DrawFrameLoHi(App app, int x, int y, int w, int h, int plotTop,
                                    List<string> labels, int lo, int hi) {
        return Chart.DrawFrameLoHiT(app, x, y, w, h, plotTop, labels, lo, hi, 5);
    }

    /// 同 DrawFrameLoHi，但 y 刻度数显式给定（smartSteps 包络的
    /// 步长数可为 4..7，如 2200..2450 每 50 = 5 格）。
    static ChartFrame DrawFrameLoHiT(App app, int x, int y, int w, int h, int plotTop,
                                     List<string> labels, int lo, int hi, int ticks) {
        return Chart.DrawFrameLoHiO(app, x, y, w, h, plotTop, labels, lo, hi,
            ticks, null);
    }

    /// 同 DrawFrameLoHiT，另吃 ChartOption：按 axisLine 三态/'auto'
    /// 与 onZero 骑线画轴线（boxplot-multi 的 x 轴线骑 y0 零线；
    /// 蜡烛/箱线 y 'auto' 不画左线）。o = null 保持旧形态。
    static ChartFrame DrawFrameLoHiO(App app, int x, int y, int w, int h, int plotTop,
                                     List<string> labels, int lo, int hi, int ticks,
                                     ChartOption o) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int pad = t.paddingMedium;
        int axisFs = ChartFonts.AxisLabel(app);
        if (hi <= lo) { hi = lo + 1; }

        int gw0 = Canvas.MeasureText(Chart.Commas(hi), axisFs);
        int gw1 = Canvas.MeasureText(Chart.Commas(lo), axisFs);
        int leftGut = gw0;
        if (gw1 > leftGut) { leftGut = gw1; }
        leftGut = leftGut + app.Scale(12);
        int botGut = Canvas.FontHeight(axisFs) + app.Scale(8);

        int plotX = x + pad + leftGut;
        int plotY = plotTop;
        int plotW = (x + w - pad) - plotX;
        // 底部图例（ECharts 6 默认）从绘图区底边扣除。
        int plotH = (y + h - pad - botGut - Chart.legendBottomReserve) - plotY;
        if (plotW < app.Scale(20)) { plotW = app.Scale(20); }
        if (plotH < app.Scale(20)) { plotH = app.Scale(20); }

        StyleBox sGrid = Style.Part(app, "chart", "grid", "", "", "",
                                    Style.SNormal());
        StyleBox sAxis = Style.Part(app, "chart", "axis", "", "", "",
                                    Style.SNormal());
        int span = hi - lo;
        if (ticks < 1) { ticks = 5; }
        for (int k = 0; k <= ticks; k = k + 1) {
            int gy = plotY + plotH - (k * plotH / ticks);
            c.FillRect(plotX, gy, plotW, 1, sGrid.BgOr(0));
            int val = lo + span * k / ticks;
            string vs = Chart.Commas(val);
            int vw = Canvas.MeasureText(vs, axisFs);
            c.DrawText(plotX - app.Scale(6) - vw, Canvas.CenterTextYAt(gy, axisFs), vs, sAxis.FgOr(0), axisFs);
        }
        Chart.FrameLines(app, c, o, lo, hi, plotX, plotY, plotW, plotH,
            sAxis.BgOr(0));

        // 类目标签 auto 抽稀（ECharts2 axisLabel.interval 缺省 'auto'）：
        // 宽日期标签逐个画会互相叠字，贪心让位规则与 BuildAxesR/
        // CategoryTicks 同一套（带状模式居中在格子内、不越左缘）。
        int n = labels.Count;
        if (n > 0) {
            int labelGap = app.Scale(6);
            List<int> shown = new List<int>();
            int labelRight = plotX - labelGap;
            // 预抽稀步长：槽宽连一个最小标签（估 24px）都放不下时，
            // 逐条 MeasureText 纯烧帧——candlestick-large 2.2 万条
            // 标签量宽 ≈ 0.9s/帧（鼠标每事件全帧重绘即卡顿）。按
            // ceil(n×估宽/plotW) 先跳步，只对候选量宽再贪心。
            int stride = 1;
            if (n > 1) {
                stride = (n * app.Scale(24) + plotW - 1) / plotW;
                if (stride < 1) { stride = 1; }
            }
            for (int ci = 0; ci < n; ci = ci + stride) {
                int labelW = Canvas.MeasureText(labels[ci], axisFs);
                int cxs = plotX + ci * plotW / n;
                int cellW = plotX + (ci + 1) * plotW / n - cxs;
                int labelLeft = cxs + (cellW - labelW) / 2;
                if (labelLeft < cxs) { labelLeft = cxs; }
                if (labelLeft >= labelRight + labelGap) {
                    shown.Add(ci);
                    labelRight = labelLeft + labelW;
                }
            }
            for (int si = 0; si < shown.Count; si = si + 1) {
                int ci = shown[si];
                int cxs = plotX + ci * plotW / n;
                int cellW = plotX + (ci + 1) * plotW / n - cxs;
                c.DrawTextCentered(cxs, plotY + plotH + app.Scale(4), cellW, botGut,
                    labels[ci], sAxis.FgOr(0), axisFs);
            }
        }

        ChartFrame f = new ChartFrame();
        f.plotX = plotX;
        f.plotY = plotY;
        f.plotW = plotW;
        f.plotH = plotH;
        f.leftMin = lo;
        f.leftMax = hi;
        f.catBoundaryGap = true;
        return f;
    }

    // ---- 坐标系（双轴 + 友好刻度 + 标题）----

    /// 点坐标定点值除回真实值（points 存 值×pointG，g<=1 原值跳过）：
    /// 四舍五入、负值对称。散点/值对折线的渲染映射、量程、命中与
    /// tooltip 统一走这里（ECharts 小数坐标在 int 管线的承载约定，
    /// 与折线 value 的 g/1000 同构）。
    static int PointV(int v, int g) {
        if (g <= 1) { return v; }
        if (v >= 0) { return (v + g / 2) / g; }
        return 0 - ((0 - v + g / 2) / g);
    }

    /// 点坐标定点值的提示文本：g<=1 直接整数；g>1 按 g 的十进制
    /// 位数输出定点小数（1000 → 3 位，-1500/1000 → "-1.5"），
    /// tooltip/状态栏展示与 PointV 的除回约定配套。
    static string PointText(int v, int g) {
        if (g <= 1) { return Convert.ToString(v); }
        bool neg = v < 0;
        int av = neg ? 0 - v : v;
        int ip = av / g;
        int fr = av - ip * g;
        int dg = g;
        int dc = 0;
        while (dg > 1) { dg = dg / 10; dc = dc + 1; }
        string fs = Convert.ToString(fr);
        while (fs.Length < dc) { fs = "0" + fs; }
        return (neg ? "-" : "") + Convert.ToString(ip) + "." + fs;
    }

    /// 散点双 value 轴缺省 scale:true 的紧致 nice 量程：不强制含 0，
    /// 数据域两端对齐到 nice 步长（NiceRange 的零锚定对身高体重这
    /// 类有自然域的散点会把云挤进角落，ECharts2 原版贴数据包络）。
    /// 步长候选同 echarts2 smartSteps：1/2/2.5/5 × 10^k，splitNumber
    /// （5）只是预估——实际分段数取包络/步长。
    /// ECharts 6 单侧并入 0（`coord/scaleRawExtentInfo.ts:302-312`）：
    /// `if (eff[0] > 0 && eff[1] > 0 && !fixMM[0]) eff[0] = 0;`
    /// `if (eff[0] < 0 && eff[1] < 0 && !fixMM[1]) eff[1] = 0;`
    /// 仅在需要并入 0（!scale）且该端未被显式 min/max 固定时生效。
    /// 调用顺序必须是 lo 再 hi——源码按序读改写后的数组。
    static int ZeroAnchorLo(bool scale, bool fixLo, int lo, int hi) {
        if (scale || fixLo) { return lo; }
        if (lo > 0 && hi > 0) { return 0; }
        return lo;
    }

    /// 见 ZeroAnchorLo：全负数据把上界归 0。
    static int ZeroAnchorHi(bool scale, bool fixHi, int lo, int hi) {
        if (scale || fixHi) { return hi; }
        if (lo < 0 && hi < 0) { return 0; }
        return hi;
    }

    static ChartSpan ScatterAutoRange(int lo, int hi) {
        if (hi < lo) {
            int tmp = lo;
            lo = hi;
            hi = tmp;
        }
        if (lo == hi) {
            if (lo == 0) {
                hi = lo + 1;
            } else if (lo > 0) {
                lo = 0;
            } else {
                hi = 0;
            }
        }
        if (lo == hi) { hi = lo + 1; }
        int span = hi - lo;
        if (span < 5) {
            return Chart.SmartForInteger(lo, hi, 0);
        }
        int avg = span / 5;
        if (span % 5 > 0) { avg = avg + 1; }
        int step = Chart.NiceStepUp(avg);
        ChartSpan s = new ChartSpan();
        s.lo = Chart.FloorDivQ(lo, step) * step;
        s.hi = Chart.CeilDivQ(hi, step) * step;
        s.ticks = (s.hi - s.lo) / step;
        return s;
    }

    /// ≥ v 的最小 1/2/2.5/5 × 10^k（echarts2 nice 步长候选）。
    static int NiceStepUp(int v) {
        if (v < 1) { return 1; }
        int d = 1;
        while (d * 10 <= v) { d = d * 10; }
        if (v <= d) { return d; }
        if (v <= 2 * d) { return 2 * d; }
        if (v <= 25 * d / 10) { return 25 * d / 10; }
        if (v <= 5 * d) { return 5 * d; }
        return 10 * d;
    }

    /// 绑定到给定数值轴的（可见）系列中的最大值。
    /// 窗口参数 i0/i1 把扫描范围限制到 dataZoom 可见段（ECharts 6
    /// 默认 filterMode:'weakFilter' 即窗口内数据重定 Y 量程；此前
    /// 一律全量扫描，area-time-axis / area-rainfall 这类 65..85%
    /// 窗口图保留 -2000..2000 全域，画面被压到顶端 1% 像素可见）。
    /// i0<0 || i1<0 = 扫描全量（旧默认行为）。
    static int AxisMaxFor(List<ChartSeries> series, int axisIndex, int i0, int i1, bool scale) {
        int mx = 0;
        // scale（axis.scale:true）：0 不并入量程——ECharts 的 incl0 由
        // `needIncludeZero() = !option.scale` 决定（axisModelCommonMixin.ts:33）。
        bool any = !scale;
        for (int i = 0; i < series.Count; i = i + 1) {
            ChartSeries s = series[i];
            if (!s.hidden && s.axisIndex == axisIndex) {
                int j0 = 0; int j1 = s.Count() - 1;
                if (i0 >= 0 && i1 >= 0) {
                    j0 = i0; j1 = i1;
                    if (j0 > s.Count() - 1) { j0 = s.Count() - 1; }
                    if (j1 > s.Count() - 1) { j1 = s.Count() - 1; }
                    if (j1 < j0) { j1 = j0; }
                }
                // points 系列（[[x,y],...] 数值对）的 y 由下方 points
                // 环按 PointV 除回真值取极值——Value() 读到的是
                // ×pointG 定点原值，混进来会把量程放大 1000 倍
                // （line-in-cartesian 的 y 轴曾画成 0..100,000，
                // 声明 min/max 与真值域错位）。
                if (s.data.Count > 0) {
                    for (int j = j0; j <= j1; j = j + 1) {
                        int v = s.Value(j);
                        if (!any || v > mx) { mx = v; any = true; }
                    }
                }
                if (s.points.Count < 1) { continue; }
                int p0 = 0; int p1 = s.points.Count - 1;
                if (i0 >= 0 && i1 >= 0) {
                    p0 = i0; p1 = i1;
                    if (p0 > s.points.Count - 1) { p0 = s.points.Count - 1; }
                    if (p1 > s.points.Count - 1) { p1 = s.points.Count - 1; }
                    if (p1 < p0) { p1 = p0; }
                }
                for (int j2 = p0; j2 <= p1; j2 = j2 + 1) {
                    int py = Chart.PointV(s.points[j2].y, s.pointG);
                    if (!any || py > mx) { mx = py; any = true; }
                }
            }
        }
        return mx;
    }

    /// AxisMaxFor 的 1/1000 定点对偶：小数系列按 Number（未取整）
    /// 比较，整数按 Value×1000。ECharts extent 语义：原始数据上界
    /// 直传（不许钳零），锚定/取整全部由 NiceRange（smartSteps）
    /// 承担——见 valueAxis._calculateValue/_reformValue。
    /// i0/i1 窗口语义同 AxisMaxFor。
    static int AxisMaxForF(List<ChartSeries> series, int axisIndex, int i0, int i1, bool scale) {
        int mx = 0;
        // 与 AxisMinForF 成对：scale 时 0 不参与，取不到数据才回退 0
        // （空轴仍要能渲染）。
        bool any = !scale;
        for (int i = 0; i < series.Count; i = i + 1) {
            ChartSeries s = series[i];
            if (!s.hidden && s.axisIndex == axisIndex) {
                int j0 = 0; int j1 = s.Count() - 1;
                if (i0 >= 0 && i1 >= 0) {
                    j0 = i0; j1 = i1;
                    if (j0 > s.Count() - 1) { j0 = s.Count() - 1; }
                    if (j1 > s.Count() - 1) { j1 = s.Count() - 1; }
                    if (j1 < j0) { j1 = j0; }
                }
                for (int j = j0; j <= j1; j = j + 1) {
                    double v = s.Number(j);
                    int vi = (int)(v * 1000 + (v >= 0 ? 0.5 : 0 - 0.5));
                    if (!any || vi > mx) { mx = vi; any = true; }
                }
                if (s.points.Count < 1) { continue; }
                int p0 = 0; int p1 = s.points.Count - 1;
                if (i0 >= 0 && i1 >= 0) {
                    p0 = i0; p1 = i1;
                    if (p0 > s.points.Count - 1) { p0 = s.points.Count - 1; }
                    if (p1 > s.points.Count - 1) { p1 = s.points.Count - 1; }
                    if (p1 < p0) { p1 = p0; }
                }
                for (int j2 = p0; j2 <= p1; j2 = j2 + 1) {
                    int py = Chart.PointV(s.points[j2].y, s.pointG) * 1000;
                    if (!any || py > mx) { mx = py; any = true; }
                }
            }
        }
        return mx;
    }

    /// 绑定到给定轴的可见系列是否存在小数数据（numberSet 且值
    /// 非整数）。小数轴渲染/量程/提示共用的判定开关。
    static bool SeriesFracAny(List<ChartSeries> series, int axisIndex) {
        for (int i = 0; i < series.Count; i = i + 1) {
            ChartSeries s = series[i];
            if (s.hidden || s.axisIndex != axisIndex) { continue; }
            for (int j = 0; j < s.Count(); j = j + 1) {
                if (s.SeriesFrac(j)) { return true; }
            }
            // points 系列（[[x,y],...] 数值对）：坐标以 ×pointG 定点
            // 承载，y 非整倍数即小数坐标（line-easing y 0..1 步长
            // 1/30、line-function 的 sin 值）——交给小数轴管线
            // （×1000 定点域）承载；SeriesFrac 只认 data[]，points
            // 全部漏判会让小数轴被 PointV 取整压扁。
            if (s.pointG > 1 && s.data.Count == 0) {
                for (int j = 0; j < s.points.Count; j = j + 1) {
                    if (s.points[j].y % s.pointG != 0) { return true; }
                }
            }
        }
        return false;
    }

    /// 散点轴的小数判定（B18）：坐标在 points 以 ×pointG 定点承载，
    /// 非整倍数即小数坐标。xAxis=true 查 x 列（scatter-linear-regression
    /// 的 0.03..0.99），false 查 y 列；data[] 小数判定只对 y 有意义
    /// （SeriesFrac）。类目下标定点（CatIdx1000）恰为整倍数不误报；
    /// 时间对（epoch 天，pointG=1）不进。
    static bool ScatterAxisFrac(List<ChartSeries> series, bool xAxis) {
        for (int i = 0; i < series.Count; i = i + 1) {
            ChartSeries s = series[i];
            if (s.hidden || s.points.Count < 1) { continue; }
            if (s.pointG > 1 && s.data.Count == 0) {
                for (int j = 0; j < s.points.Count; j = j + 1) {
                    int v = xAxis ? s.points[j].x : s.points[j].y;
                    if (v % s.pointG != 0) { return true; }
                }
            }
        }
        return false;
    }

    /// 绑定到给定数值轴的（可见）系列中的最小值
    /// （无负数时为 0），使轴天然覆盖负数。i0/i1 窗口语义同
    /// AxisMaxFor。
    static int AxisMinFor(List<ChartSeries> series, int axisIndex, int i0, int i1, bool scale) {
        int mn = 0;
        // 见 AxisMaxFor：scale 时 0 不参与（incl0 = !scale）。
        bool any = !scale;
        for (int i = 0; i < series.Count; i = i + 1) {
            ChartSeries s = series[i];
            if (!s.hidden && s.axisIndex == axisIndex) {
                int j0 = 0; int j1 = s.Count() - 1;
                if (i0 >= 0 && i1 >= 0) {
                    j0 = i0; j1 = i1;
                    if (j0 > s.Count() - 1) { j0 = s.Count() - 1; }
                    if (j1 > s.Count() - 1) { j1 = s.Count() - 1; }
                    if (j1 < j0) { j1 = j0; }
                }
                if (s.data.Count > 0) {
                    for (int j = j0; j <= j1; j = j + 1) {
                        int v = s.Value(j);
                        if (!any || v < mn) { mn = v; any = true; }
                    }
                }
                if (s.points.Count < 1) { continue; }
                int p0 = 0; int p1 = s.points.Count - 1;
                if (i0 >= 0 && i1 >= 0) {
                    p0 = i0; p1 = i1;
                    if (p0 > s.points.Count - 1) { p0 = s.points.Count - 1; }
                    if (p1 > s.points.Count - 1) { p1 = s.points.Count - 1; }
                    if (p1 < p0) { p1 = p0; }
                }
                for (int j2 = p0; j2 <= p1; j2 = j2 + 1) {
                    int py = Chart.PointV(s.points[j2].y, s.pointG);
                    if (!any || py < mn) { mn = py; any = true; }
                }
            }
        }
        return mn;
    }

    /// X 数值轴最小值：值对系列取 points.x，轴互换系列取 values
    ///（gap 项不计）；固定覆盖在调用方处理。
    static int XMinFor(List<ChartSeries> series, bool fromValues, bool scale) {
        int mn = 0;
        // scale（axis.scale:true）时不并入 0，同 AxisMinFor。
        bool any = !scale;
        for (int i = 0; i < series.Count; i = i + 1) {
            ChartSeries s = series[i];
            if (s.hidden) { continue; }
            if (fromValues) {
                for (int j = 0; j < s.data.Count; j = j + 1) {
                    if (!s.data[j].gap) {
                        int v = s.data[j].val;
                        if (!any || v < mn) { mn = v; any = true; }
                    }
                }
            } else {
                for (int j = 0; j < s.points.Count; j = j + 1) {
                    int px = Chart.PointV(s.points[j].x, s.pointG);
                    if (!any || px < mn) { mn = px; any = true; }
                }
            }
        }
        return mn;
    }
    /// X 数值轴最大值（XMinFor 的对偶）。
    static int XMaxFor(List<ChartSeries> series, bool fromValues, bool scale) {
        int mx = 0;
        bool any = !scale;
        for (int i = 0; i < series.Count; i = i + 1) {
            ChartSeries s = series[i];
            if (s.hidden) { continue; }
            if (fromValues) {
                for (int j = 0; j < s.data.Count; j = j + 1) {
                    if (!s.data[j].gap) {
                        int v = s.data[j].val;
                        if (!any || v > mx) { mx = v; any = true; }
                    }
                }
            } else {
                for (int j = 0; j < s.points.Count; j = j + 1) {
                    int px = Chart.PointV(s.points[j].x, s.pointG);
                    if (!any || px > mx) { mx = px; any = true; }
                }
            }
        }
        return mx;
    }

    /// 格式化标签比裸数值多占的宽度（axisLabel.formatter 模板，
    /// 如 "{value} °C"），供轴栏预留。
    static int FormatterExtraW(string fmt, int v, int fs) {
        string raw = Chart.Commas(v);
        string full = fmt.Replace("{value}", raw);
        return Canvas.MeasureText(full, fs) - Canvas.MeasureText(raw, fs);
    }

    /// 是否存在绑定 axisIndex 轴的可见系列。
    static bool AnyOnAxis(List<ChartSeries> series, int axisIndex) {
        for (int i = 0; i < series.Count; i = i + 1) {
            if (!series[i].hidden && series[i].axisIndex == axisIndex) { return true; }
        }
        return false;
    }

    /// 将原始最小值向下取整为友好的负轴下界（-2/-5/-10 * 10^n）；
    /// 没有负数需要覆盖时返回 0。
    static int NiceMin(int v) {
        if (v >= 0) { return 0; }
        int av = 0 - v;
        if (av <= 5) { return 0 - 5; }
        int mag = 1;
        while (mag * 10 <= av) { mag = mag * 10; }
        int unit = av / mag;
        int nice = 10;
        if (unit < 2) { nice = 2; } else if (unit < 5) { nice = 5; }
        return 0 - nice * mag;
    }

    /// double 重载：显式界可能是 -0.4 这类小数（line-easing），
    /// 走 int 会截断成 0。语义改用 ECharts 的 NICE_MODE_MIN
    /// （number.ts:633 `mode===NICE_MODE_MIN` 恒取 nf=1，即 10^exponent
    /// 向上覆盖到 |v|），而不是旧的 2/5/10 阶梯。
    static double NiceMin(double v) {
        if (v >= 0.0) { return 0.0; }
        double av = 0.0 - v;
        int exponent = Chart.QuantityExponent(av);
        double n = Chart.Pow10D(exponent);
        if (n < av) { n = n * 10.0; }
        return 0.0 - n;
    }

    /// 从数据 + 固定覆盖解析数值轴的 [lo, hi] 范围（fixedLo/fixedHi
    /// 取 ChartOption.Auto() 时从数据推导）。有负值时下界自动扩展
    /// 到 0 以下。
    static int AxisLo(int fixedLo, int dataMin) {
        return Chart.AxisLo(fixedLo, dataMin, false);
    }
    /// scale 版：axis.scale:true 时不做同号归零（原始数据下界直传，
    /// 取整交给 NiceRange/smartSteps）。出处 ECharts 2
    /// `valueAxis._reformValue(scale)`：`!scale && _min>=0 && _max>=0`
    /// 才 `_min = 0`。
    static int AxisLo(int fixedLo, int dataMin, bool scale) {
        if (fixedLo != ChartOption.Auto()) { return fixedLo; }
        if (scale) { return dataMin; }
        return Chart.NiceMin(dataMin);
    }
    /// 数值轴上界：固定覆盖优先，否则 NiceMax；保证 hi > lo。
    /// 数据全为非正（dataMax <= 0 且有负值）时上界归 0——雨量图
    /// 这类全负系列的上界不该被 NiceMax(0)=5 顶出一段空白。
    ///
    /// 注意这里**不**按 axis.scale 分叉：ECharts 6 的 ECharts 侧
    /// `scaleRawExtentInfo` 在 scale:true 下确实不做单侧并入 0，但本函
    /// 数只服务"整数近似"这条老管道（NiceMax 对负数返回 5 本身就不合
    /// 源），归 0 比 5 更接近源；自动量程那条路（leftDataMax<0 或
    /// y0.scale）由 NiceRange 接管，scale 语义在那里生效。
    static int AxisHi(int fixedHi, int dataMax, int lo) {
        int hi = Chart.NiceMax(dataMax);
        if (fixedHi != ChartOption.Auto()) { hi = fixedHi; }
        if (fixedHi == ChartOption.Auto() && dataMax <= 0 && lo < 0) { hi = 0; }
        if (hi <= lo) { hi = lo + 1; }
        return hi;
    }

    /// ECharts 2.x 数值默认千分位（axisLabel 的 {value}、tooltip 数值
    /// 都过 addCommas）：3000 → "3,000"，负号不占分组位。
    static string Commas(int v) {
        bool neg = v < 0;
        string d = Convert.ToString(neg ? 0 - v : v);
        string o = "";
        int n = d.Length;
        for (int i = 0; i < n; i = i + 1) {
            if (i > 0 && (n - i) % 3 == 0) { o = o + ","; }
            o = o + d.Substring(i, 1);
        }
        return neg ? "-" + o : o;
    }

    /// 1/1000 定点 → 小数文本：fr 为 0 时输出整数（500000 → "500"、
    /// -1000 → "-1"），否则两位小数去尾零（500 → "0.5"、860 →
    /// "0.86"）。折线小数值（line6 流量 0.86..1.5）在 int 渲染
    /// 管线的承载约定：值 ×1000 存整型，展示前经此除回。
    static string FracText(int v) {
        bool neg = v < 0;
        int av = neg ? 0 - v : v;
        int ip = av / 1000;
        int fr = (av - ip * 1000 + 5) / 10;
        if (fr >= 100) { ip = ip + 1; fr = fr - 100; }
        if (fr == 0) {
            string whole = Chart.Commas(ip);
            return neg ? "-" + whole : whole;
        }
        string fs = Convert.ToString(fr);
        while (fs.Length > 1 && fs.Substring(fs.Length - 1, 1) == "0") {
            fs = fs.Substring(0, fs.Length - 1);
        }
        string o = Convert.ToString(ip) + "." + fs;
        return neg ? "-" + o : o;
    }

    /// 系列第 i 项的展示文本：小数系列（numberSet 且非整数）输出
    /// 两位小数（ECharts2 数值默认 ×1000 定点），整数系列仍是
    /// 千分位整数——与轴刻度、tooltip 的展示约定一致。
    /// labelLayout moveOverlap 的一维解叠（labelLayoutHelper.ts
    /// shiftLayoutOnXY:324 的化简——sort by rect pos + 前向顶开，
    /// delta = pos - 前盒末缘，负则推到前盒末缘；他们的 bounds
    /// squeeze / balanceShift 不在语料路径，未移）。pos 须按升序
    /// 给定（调用方带索引排序），size 为各盒沿轴长度，gap = 盒间缝。
    static List<int> LlShift1D(List<int> pos, List<int> size, int gap) {
        int n = pos.Count;
        List<int> cur = new List<int>();
        for (int i = 0; i < n; i = i + 1) { cur.Add(pos[i]); }
        for (int i = 1; i < n; i = i + 1) {
            int lim = cur[i - 1] + size[i - 1] + gap;
            if (cur[i] < lim) { cur[i] = lim; }
        }
        return cur;
    }

    static string SeriesNumText(ChartSeries s, int i) {
        if (s.SeriesFrac(i)) {
            double dn = s.Number(i);
            return Chart.FracText((int)(dn * 1000 + (dn >= 0 ? 0.5 : 0 - 0.5)));
        }
        return Chart.Commas(s.Value(i));
    }

    /// [lo, hi] 范围分成 `ticks` 步时最宽的刻度标签（像素），
    /// 用于预留左/右轴 gut 宽度。
    static int TickLabelW(int lo, int hi, int ticks, int fs) {
        int span = hi - lo;
        int wmax = 0;
        for (int k = 0; k <= ticks; k = k + 1) {
            int val = lo + span * k / ticks;
            int lw = Canvas.MeasureText(Chart.Commas(val), fs);
            if (lw > wmax) { wmax = lw; }
        }
        return wmax;
    }

    /// TickLabelW 的 ×1000 定点对偶：小数轴刻度文本（FracText）
    /// 的最宽像素。
    static int TickLabelWF(int loF, int hiF, int ticks, int fs) {
        int span = hiF - loF;
        int wmax = 0;
        for (int k = 0; k <= ticks; k = k + 1) {
            int lw = Canvas.MeasureText(Chart.FracText(loF + span * k / ticks), fs);
            if (lw > wmax) { wmax = lw; }
        }
        return wmax;
    }

    /// 完整直角坐标系：左（+ 可选右）数值轴，友好刻度 / 固定边界 /
    /// 翻转 / 对数 / 时间 X 轴、分类标签防重叠、网格内边距覆盖和轴
    /// 标题。返回携带两个轴范围的 ChartFrame，所有渲染器通过
    /// f.YOf(v, axisIndex) 映射数值。
    static ChartFrame BuildAxes(App app, int x, int y, int w, int h, int plotTop,
                                List<string> labels, ChartOption o, List<ChartSeries> series) {
        return Chart.BuildAxesR(app, x, y, w, h, plotTop, labels, o, series, 0 - 1, 0 - 1,
            0 - 1, 0 - 1);
    }

    /// 带 dataZoom 窗口的 BuildAxes：Y 量程按原始系列上的
    /// [i0, i1] 扫描（labels 须已是对应窗口切片）。
    static ChartFrame BuildAxesW(App app, int x, int y, int w, int h, int plotTop,
                                 List<string> labels, ChartOption o, List<ChartSeries> series,
                                 int i0, int i1) {
        return Chart.BuildAxesR(app, x, y, w, h, plotTop, labels, o, series, 0 - 1, 0 - 1, i0, i1);
    }

    /// 同 BuildAxes，但左/右轴使用显式数据最大值
    /// （-1 = 从系列逐点推导）；堆叠图传入堆叠总和。
    /// winI0/winI1 = dataZoom 可见窗口在**原始系列**上的下标区间
    /// （-1,-1 = 无窗口）。Y 量程必须按该区间扫描：调用方（渲染器）
    /// 传入的 labels 已是窗口切片，在这里再按 labels.Count 反解窗口
    /// 会**二次开窗**（area-simple：2000 个窗口标签再取 10% → 200 点，
    /// 量程被压到首个 1%，填充被放大到 1.65×）。窗口只有一个来源：
    /// 渲染器算好传进来。
    static ChartFrame BuildAxesR(App app, int x, int y, int w, int h, int plotTop,
                                 List<string> labels, ChartOption o, List<ChartSeries> series,
                                 int leftDataMax, int rightDataMax,
                                 int winI0, int winI1) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int pad = t.paddingMedium;
        int fs = ChartFonts.AxisLabel(app);
        int fh = Canvas.FontHeight(fs);
        ChartAxis y0 = o.YAxis0();
        ChartAxis y1 = o.YAxis1();
        ChartAxis x0 = o.XAxis0();
        int ticks = y0.ticks;
        if (ticks < 1) { ticks = 5; }

        // dataZoom 可见窗口（-1,-1 = 无窗口，按全量）。窗口由调用方
        // 传入——本函数收到的 labels 已经是窗口切片，不能再自行反解。
        // ECharts 6 默认 filterMode 下 Y 量程随窗口重定：窗口化只
        // 在真的缩放（窗口 ≠ 全量）时生效，未缩放图与旧行为逐像素
        // 一致。长度基准与渲染器 DrawLines/Scatter 的 fullN 同源：
        // 类目 X 用 labels.Count，数值/时间 X 用最长系列长度。
        int zI0 = winI0;
        int zI1 = winI1;

        int lData = leftDataMax;
        if (lData < 0) { lData = Chart.AxisMaxFor(series, 0, zI0, zI1, y0.scale); }
        bool leftFrac = Chart.SeriesFracAny(series, 0);
        int leftLo = Chart.AxisLo(y0.min, Chart.AxisMinFor(series, 0, zI0, zI1, y0.scale), y0.scale);
        int leftHi = Chart.AxisHi(y0.max, lData, leftLo);
        // alignTicks 需要的是 **nice 之前**的原始 extent
        // （axisAlignTicks.ts:176 的 targetExtent = 原始域，不是 niceExtent）。
        // 本引擎两条路径的原始域都要留下副本。
        double lRawLo = 0.0;
        double lRawHi = 0.0;
        int leftLoF = 0;
        int leftHiF = 0;
        if (leftFrac) {
            // 小数轴（valueAxis 源码流程）：extent = 固定 min/max 或
            // 原始数据上下界（×1000 定点）；双正锚 min=0 / 双负锚
            // max=0 与向下/向上取整全部由 NiceRange（smartSteps）
            // 承担（line6 流量 0.46..365 + 固定 max 500 → 0..500000
            // 定点 5 段）。两端都固定走 _customerValue——精确等分
            // 不取整（line8 0..30）。
            if (!ChartOption.IsAutoD(y0.minD)) {
                leftLoF = (int)(y0.minD >= 0.0 ? y0.minD * 1000.0 + 0.5
                    : y0.minD * 1000.0 - 0.5);
            } else {
                leftLoF = Chart.FracAxisLoF(y0.min, series, 0, zI0, zI1, y0.scale);
            }
            if (!ChartOption.IsAutoD(y0.maxD)) {
                leftHiF = (int)(y0.maxD >= 0.0 ? y0.maxD * 1000.0 + 0.5
                    : y0.maxD * 1000.0 - 0.5);
            } else {
                leftHiF = Chart.FracAxisHiF(y0.max, series, 0, zI0, zI1, y0.scale);
            }
            if (!ChartOption.IsAutoD(y0.minD) && !ChartOption.IsAutoD(y0.maxD)) {
                leftLo = leftLoF / 1000;
                leftHi = leftHiF / 1000;
                lRawLo = (double)leftLoF; lRawHi = (double)leftHiF;
            } else {
                // minInterval/maxInterval 在数据单位上声明，定点域 ×1000。
                // 未声明（AutoD 哨兵）不能乘，否则哨兵失效。
                lRawLo = (double)leftLoF; lRawHi = (double)leftHiF;
                double lmn = ChartOption.IsAutoD(y0.minInterval)
                    ? ChartOption.AutoD() : y0.minInterval * 1000.0;
                double lmx = ChartOption.IsAutoD(y0.maxInterval)
                    ? ChartOption.AutoD() : y0.maxInterval * 1000.0;
                ChartSpan fs2 = Chart.ClampNiceRange(leftLoF, leftHiF, y0.scale, lmn, lmx);
                leftLoF = fs2.lo;
                leftHiF = fs2.hi;
                ticks = fs2.ticks;
                leftLo = leftLoF / 1000;
                leftHi = leftHiF / 1000;
            }
        }
        bool hasRight = Chart.AnyOnAxis(series, 1);
        if (o.yAxes.Count > 1) { hasRight = true; }
        int rightLo = 0;
        int rightHi = 1;
        int rightLoF = 0;
        int rightHiF = 0;
        double rRawLo = 0.0;
        double rRawHi = 0.0;
        bool rightFrac = false;
        int rt = ticks;
        if (hasRight) {
            int rData = rightDataMax;
            if (rData < 0) { rData = Chart.AxisMaxFor(series, 1, zI0, zI1, y1.scale); }
            rightLo = Chart.AxisLo(y1.min, Chart.AxisMinFor(series, 1, zI0, zI1, y1.scale), y1.scale);
            rightHi = Chart.AxisHi(y1.max, rData, rightLo);
            rightFrac = Chart.SeriesFracAny(series, 1);
            if (rightFrac) {
                // 右小数轴（line6 降雨量 -0.955..-0.005 → 定点域
                // -1000..0 步长 200），同左轴流程。
                if (!ChartOption.IsAutoD(y1.minD)) {
                    rightLoF = (int)(y1.minD >= 0.0 ? y1.minD * 1000.0 + 0.5
                        : y1.minD * 1000.0 - 0.5);
                } else {
                    rightLoF = Chart.FracAxisLoF(y1.min, series, 1, zI0, zI1, y1.scale);
                }
                if (!ChartOption.IsAutoD(y1.maxD)) {
                    rightHiF = (int)(y1.maxD >= 0.0 ? y1.maxD * 1000.0 + 0.5
                        : y1.maxD * 1000.0 - 0.5);
                } else {
                    rightHiF = Chart.FracAxisHiF(y1.max, series, 1, zI0, zI1, y1.scale);
                }
                rRawLo = (double)rightLoF; rRawHi = (double)rightHiF;
                if (!ChartOption.IsAutoD(y1.minD) && !ChartOption.IsAutoD(y1.maxD)) {
                    rightLo = rightLoF / 1000;
                    rightHi = rightHiF / 1000;
                    rt = y1.ticks < 1 ? 5 : y1.ticks;
                } else {
                    double rmn = ChartOption.IsAutoD(y1.minInterval)
                        ? ChartOption.AutoD() : y1.minInterval * 1000.0;
                    double rmx = ChartOption.IsAutoD(y1.maxInterval)
                        ? ChartOption.AutoD() : y1.maxInterval * 1000.0;
                    ChartSpan rs2 = Chart.ClampNiceRange(rightLoF, rightHiF, y1.scale, rmn, rmx);
                    rightLoF = rs2.lo;
                    rightHiF = rs2.hi;
                    rt = rs2.ticks;
                }
                rightLo = rightLoF / 1000;
                rightHi = rightHiF / 1000;
            }
        }
        // 对数轴：仅正值，钳制下界到 ≥1（log10 对 ≤0 无定义）。
        bool leftLog = y0.type == ChartAxisType.Log;
        bool rightLog = hasRight && y1.type == ChartAxisType.Log;
        // 自动量程走 ECharts nice 步长（-76..15 → -80..20，
        // 0..1320 → 0..1400），刻度数随步长；固定 min/max 尊重不取整。
        if (!leftLog && !leftFrac && y0.type == ChartAxisType.Value
            && y0.min == ChartOption.Auto() && y0.max == ChartOption.Auto()
            && (leftDataMax < 0 || y0.scale)) {
            lRawLo = (double)Chart.AxisMinFor(series, 0, zI0, zI1, y0.scale);
            lRawHi = (double)lData;
            ChartSpan ls = Chart.ClampNiceRange((int)lRawLo, (int)lRawHi, y0.scale,
                y0.minInterval, y0.maxInterval);
            leftLo = ls.lo;
            leftHi = ls.hi;
            ticks = ls.ticks;
            rt = ticks;
        }
        if (leftLog) {
            if (leftLo < 1) { leftLo = 1; }
            if (leftHi < leftLo + 1) { leftHi = leftLo + 1; }
        }
        if (rightLog) {
            if (rightLo < 1) { rightLo = 1; }
            if (rightHi < rightLo + 1) { rightHi = rightLo + 1; }
        } else if (hasRight && !rightFrac && y1.type == ChartAxisType.Value
            && y1.min == ChartOption.Auto() && y1.max == ChartOption.Auto()
            && (rightDataMax < 0 || y1.scale)) {
            rRawLo = (double)Chart.AxisMinFor(series, 1, zI0, zI1, y1.scale);
            rRawHi = (double)Chart.AxisMaxFor(series, 1, zI0, zI1, y1.scale);
            ChartSpan rs = Chart.ClampNiceRange((int)rRawLo, (int)rRawHi, y1.scale,
                y1.minInterval, y1.maxInterval);
            rightLo = rs.lo;
            rightHi = rs.hi;
            rt = rs.ticks;
        }
        // ---- A12 alignTicks（coord/axisAlignTicks.ts scaleCalcAlign）----
        // 只在左/右两条**数值轴**之间做：Grid.ts:738-756 逆序扫描
        // 挑 alignTo（不要求对齐的最后一条）；两槽都要求则取 y0。
        // 本引擎只有左/右两槽，第 3 条以上的 y 轴不参与对齐（记债）。
        if (hasRight && !leftLog && !rightLog
            && y0.type == ChartAxisType.Value && y1.type == ChartAxisType.Value
            && (y0.alignTicks || y1.alignTicks)) {
            // 只 y1 要求：把右轴对齐到左轴；
            // 只 y0 要求：把左轴对齐到右轴。
            bool alignRight = y1.alignTicks;
            int segs = alignRight ? ticks : rt;
            if (segs < 1) { segs = 1; }
            if (alignRight) {
                ChartSpan ar = Chart.AlignRange(rRawLo, rRawHi, segs, !y1.scale);
                if (rightFrac) { rightLoF = ar.lo; rightHiF = ar.hi; rightLo = rightLoF / 1000; rightHi = rightHiF / 1000; }
                else { rightLo = ar.lo; rightHi = ar.hi; }
                rt = ar.ticks;
            } else {
                ChartSpan al = Chart.AlignRange(lRawLo, lRawHi, segs, !y0.scale);
                if (leftFrac) { leftLoF = al.lo; leftHiF = al.hi; leftLo = leftLoF / 1000; leftHi = leftHiF / 1000; }
                else { leftLo = al.lo; leftHi = al.hi; }
                ticks = al.ticks;
            }
        }
        // 时间 X 轴：显式 min/max 优先；否则时间域取全部可见系列
        // 时间点（points.x，epoch 天）在 dataZoom 窗口内的 min/max
        // ——窗口化与渲染器的 [i0,i1] 同一语义（官方 area-time-axis
        // start/end 20% 即放大到首段）。此前一律 0..labels-1 整数
        // 天数域，epoch/日期串数据没有落点路径。无时间点的旧整数
        // 天数形态保持原域。
        bool isTime = x0.type == ChartAxisType.Time;
        int tMin = x0.min;
        int tMax = x0.max;
        if (isTime) {
            int fullN = 0;
            for (int fni = 0; fni < series.Count; fni = fni + 1) {
                if (!series[fni].hidden && series[fni].points.Count > fullN) {
                    fullN = series[fni].points.Count;
                }
            }
            int w0 = 0;
            int w1 = fullN - 1;
            if (o.zoom && o.iwid != 0 && fullN > 1) {
                w0 = Chart.ZoomI0(app, o, o.iwid, fullN);
                w1 = Chart.ZoomI1(app, o, o.iwid, fullN);
            }
            int dMin = 0;
            int dMax = 0;
            bool have = false;
            for (int tsi = 0; tsi < series.Count; tsi = tsi + 1) {
                ChartSeries tss = series[tsi];
                if (tss.hidden) { continue; }
                int pcnt = tss.points.Count;
                if (pcnt > w1 + 1) { pcnt = w1 + 1; }
                for (int tpi = w0; tpi < pcnt; tpi = tpi + 1) {
                    // points.x 是 epoch 天 × pointG 的定点值（值对/时间
                    // 系列 pointG=1000），时间域是**裸天**整数：不除回
                    // 会得到 1000× 的天数，TimeLabel 再按天解释就跳回
                    // 1961 年（area-time-axis 比例坏掉的根因）。
                    int tx = Chart.PointV(tss.points[tpi].x, tss.pointG);
                    if (!have || tx < dMin) { dMin = tx; }
                    if (!have || tx > dMax) { dMax = tx; }
                    have = true;
                }
            }
            if (have) {
                if (tMin == ChartOption.Auto()) { tMin = dMin; }
                if (tMax == ChartOption.Auto()) { tMax = dMax; }
                if (tMax <= tMin) { tMax = tMin + 1; }
            }
        }
        if (tMin == ChartOption.Auto()) { tMin = 0; }
        if (tMax == ChartOption.Auto()) {
            tMax = labels.Count - 1;
            if (tMax < tMin + 1) { tMax = tMin + 1; }
        }

        // 轴互换（ECharts yAxis category + xAxis value）与值对折线：
        // X 变成数值轴，范围从 x0.min/max 或数据推导。
        bool catY = y0.type == ChartAxisType.Category;
        bool xValue = catY || x0.type == ChartAxisType.Value;
        int xLo = 0;
        int xHi = 100;
        int xt = ticks;
        if (xValue) {
            // 自动量程走 ECharts nice 步长（气温 -76..15 →
            // -80..20 步长 20）；固定 min/max 尊重不取整。
            if (x0.min != ChartOption.Auto() || x0.max != ChartOption.Auto()) {
                xLo = x0.min;
                if (xLo == ChartOption.Auto()) { xLo = Chart.XMinFor(series, catY, x0.scale); }
                xHi = x0.max;
                if (xHi == ChartOption.Auto()) { xHi = Chart.XMaxFor(series, catY, x0.scale); }
                if (xHi <= xLo) { xHi = xLo + 1; }
            } else {
                // A11：minInterval/maxInterval 同样作用于 X 数值轴
                // （axisNiceTicks.ts:263-264 的 isIntervalOrTime 不分轴）。
                ChartSpan xsp = Chart.ClampNiceRange(
                    Chart.XMinFor(series, catY, x0.scale),
                    Chart.XMaxFor(series, catY, x0.scale), x0.scale,
                    x0.minInterval, x0.maxInterval);
                xLo = xsp.lo;
                xHi = xsp.hi;
                xt = xsp.ticks;
            }
        }

        // ---- axisLine 解算（Grid.ts:614-717 fixAxisOnZero +
        // cartesianAxisHelper.ts axisLineAutoShow）----
        // 骑线：x 轴先挑目标（候选按 y 轴序），y 轴后挑；目标被认领
        // 后不再复用（双 y 轴都够得着 x0 时 y0 赢、y1 留在原位——
        // _scratch/chart_oracle/onzero_multi.js 实测）。TARGET 必须是
        // value/log 且 0 不在域外（EDGE 也算）。像素在 plot 矩形
        // （含 markPad 外扩）定下后再落，这里只定「骑不骑」。
        bool x0RidesY0 = Chart.CanOnZeroTo(y0, leftLo, leftHi, x0.onZero);
        bool x0RidesY1 = false;
        if (!x0RidesY0 && hasRight && o.yAxes.Count > 1) {
            x0RidesY1 = Chart.CanOnZeroTo(y1, rightLo, rightHi, x0.onZero);
        }
        bool y0RidesX0 = Chart.CanOnZeroTo(x0, xLo, xHi, y0.onZero);
        bool y1RidesX0 = false;
        if (!y0RidesX0 && hasRight && o.yAxes.Count > 1) {
            y1RidesX0 = Chart.CanOnZeroTo(x0, xLo, xHi, y1.onZero);
        }
        // axisLine.show 三态：'auto' 只画「对侧是 value/log」的轴
        // （isIntervalOrLogScale；time 不算）。类目轴缺省恒画、
        // value/time/log 缺省 'auto'——标准柱/线图从此只画底部一
        // 根线，与官方 SSR 逐一致（axisline.scan.txt 69/15 清单）。
        bool x0IsVL = x0.type == ChartAxisType.Value
            || x0.type == ChartAxisType.Log;
        bool y0IsVL = y0.type == ChartAxisType.Value
            || y0.type == ChartAxisType.Log;
        bool y0Line = y0.show && Chart.AxisLineDraws(y0.axisLineShow, x0IsVL);
        bool x0Line = x0.show && Chart.AxisLineDraws(x0.axisLineShow, y0IsVL);
        bool y1Line = hasRight && y1.show
            && Chart.AxisLineDraws(y1.axisLineShow, x0IsVL);

        int leftGut;
        if (catY && y0.categories.Count > 0) {
            // 类目 Y：左栏取最宽类目标签（含 formatter 展开）。
            int mw = 0;
            for (int cgi = 0; cgi < y0.categories.Count; cgi = cgi + 1) {
                string cgl = y0.categories[cgi];
                if (y0.labelFormatter.Length > 0) { cgl = y0.labelFormatter.Replace("{value}", cgl); }
                int wgi = Canvas.MeasureText(cgl, fs);
                if (wgi > mw) { mw = wgi; }
            }
            leftGut = mw + app.Scale(12) + app.Scale(y0.labelMargin);
        } else {
            leftGut = Chart.TickLabelW(leftLo, leftHi, ticks, fs) + app.Scale(12) + app.Scale(y0.labelMargin);
            if (leftFrac) {
                // 小数轴标签（"0.5"）比整数影子值（"0"）宽，按定点
                // 域重估最宽刻度文本。
                int fw = Chart.TickLabelWF(leftLoF, leftHiF, ticks, fs);
                if (fw > leftGut) { leftGut = fw + app.Scale(12) + app.Scale(y0.labelMargin); }
            }
            if (y0.labelFormatter.Length > 0) {
                leftGut = leftGut + Chart.FormatterExtraW(y0.labelFormatter, leftHi, fs);
            }
        }
        int rightGut = pad + app.Scale(y1.labelMargin);
        if (hasRight) { rightGut = Chart.TickLabelW(rightLo, rightHi, rt, fs) + app.Scale(12) + app.Scale(y1.labelMargin); }
        if (rightFrac) {
            int rw = Chart.TickLabelWF(rightLoF, rightHiF, rt, fs) + app.Scale(12) + app.Scale(y1.labelMargin);
            if (rw > rightGut) { rightGut = rw; }
        }
        int botGut = fh + app.Scale(12) + app.Scale(x0.labelMargin);
        // x 轴名的垂直落点随 nameLocation 变（AxisNamePos）：end/middle 在
        // 轴线下方（middle 再多一整个 gap）、start 骑在轴线上。量出名字
        // 盒底相对"轴线 + 半个行高"多出来的部分补进底栏，否则名字压住
        // 刻度标签。start 态盒底高于轴线下缘，不补。
        // onZero 骑线时例外：end/start 名字贴轴线走进绘图区（middle
        // 留在边界），底部不再需要让位——官方网格从不为轴名留白。
        if (x0.title.Length > 0 && x0.show && !(x0RidesY0 || x0RidesY1)) {
            int xTw = Canvas.MeasureText(x0.title, fs);
            ChartNameBox xb = Chart.AxisNameBoxPx(x0, true, 0, 0, 100, 100,
                false, Chart.NameGapPx(app, x0), fh, Canvas.CenterTextYAt(0, fs),
                xTw, 0 - 1);
            int below = xb.bottom - (fh + fh / 2);
            if (below > 0) { botGut = botGut + below; }
        }
        if (xValue) { botGut = botGut + fh + app.Scale(2); }
        // 旋转分类标签：按最宽标签的旋转后垂直跨度扩底栏（未旋转
        // 与旋转都成立——interval>=0 抽稀时贪心不再兜底防重叠）。
        if (x0.labelRotate != 0 && labels.Count > 0) {
            int rotMaxW = 0;
            for (int ri = 0; ri < labels.Count; ri = ri + 1) {
                int rwi = Canvas.MeasureText(labels[ri], fs);
                if (rwi > rotMaxW) { rotMaxW = rwi; }
            }
            int need = Chart.RotatedLabelH(rotMaxW, fh, x0.labelRotate) + app.Scale(4);
            int baseNeed = fh + app.Scale(12);
            if (need > baseNeed) {
                botGut = botGut - baseNeed + need;
            }
        }
        // y 轴名 end 态落在绘图区上方、start/middle 在区内：量出名字盒顶
        // 相对绘图区顶边高出多少，按最高的一根让出上栏。
        int topGut = 0;
        if (y0.title.Length > 0 && y0.show) {
            int yTw = Canvas.MeasureText(y0.title, fs);
            ChartNameBox yb = Chart.AxisNameBoxPx(y0, false, 0, 0, 100, 100,
                false, Chart.NameGapPx(app, y0), fh, Canvas.CenterTextYAt(0, fs),
                yTw, 0 - 1);
            int above = (0 - yb.top) + app.Scale(2);
            if (above > topGut) { topGut = above; }
        }
        if (hasRight && o.yAxes.Count > 1 && y1.title.Length > 0 && y1.show) {
            int y1Tw = Canvas.MeasureText(y1.title, fs);
            ChartNameBox yb2 = Chart.AxisNameBoxPx(y1, false, 0, 0, 100, 100,
                y1.position == "right", Chart.NameGapPx(app, y1), fh,
                Canvas.CenterTextYAt(0, fs), y1Tw, 0 - 1);
            int above2 = (0 - yb2.top) + app.Scale(2);
            if (above2 > topGut) { topGut = above2; }
        }

        int plotX = x + pad + leftGut;
        if (o.gridLeft >= 0) {
            plotX = x + app.Scale(o.gridLeft) + (o.containLabel ? leftGut : 0);
        } else if (o.gridLeftPct >= 0) {
            plotX = x + w * o.gridLeftPct / 100 + (o.containLabel ? leftGut : 0);
        }
        int plotY = plotTop + topGut;
        if (o.gridTop >= 0) {
            // grid.top 是 ECharts 绝对偏移，但不得小于面板头
            //（标题/副标题/图例行）底边——头部内容永远优先显示，
            // gridTop 只在头部之下继续往下推（bar12 的 70 压住
            // 图例行的根因）。
            int topAbs = y + app.Scale(o.gridTop) + (o.containLabel ? topGut : 0);
            if (topAbs > plotY) { plotY = topAbs; }
        } else if (o.gridTopPct >= 0) {
            int topAbs = y + h * o.gridTopPct / 100 + (o.containLabel ? topGut : 0);
            if (topAbs > plotY) { plotY = topAbs; }
        }
        int plotRight = x + w - rightGut;
        if (o.gridRight >= 0) {
            plotRight = x + w - app.Scale(o.gridRight) - (o.containLabel ? rightGut : 0);
        } else if (o.gridRightPct >= 0) {
            plotRight = x + w - w * o.gridRightPct / 100
                - (o.containLabel ? rightGut : 0);
        }
        // 底部图例（ECharts 6 默认）从绘图区底边扣除。
        int plotBot = y + h - pad - botGut - Chart.legendBottomReserve;
        if (o.gridBottom >= 0) {
            plotBot = y + h - app.Scale(o.gridBottom) - (o.containLabel ? botGut : 0);
        } else if (o.gridBottomPct >= 0) {
            plotBot = y + h - h * o.gridBottomPct / 100 - (o.containLabel ? botGut : 0);
        }
        int plotW = plotRight - plotX;
        int plotH = plotBot - plotY;
        if (plotW < app.Scale(20)) { plotW = app.Scale(20); }
        if (plotH < app.Scale(20)) { plotH = app.Scale(20); }

        // 极值贴边留出约半个徽标高度：数据最值逼近 nice 端点时
        // 映射范围向外扩，顶点符号与 min/max 徽标不再被绘图区
        // 裁切；网格/刻度仍取 nice 端点（Tick 副本），端格线悬在
        // 绘图区内侧。0 基线不外扩——面积/柱的填充锚在零线。
        // ECharts 本身从不外扩：只有真的要画 markPoint 徽标
        // （o.markPoint 或显式 marks）才留白，否则 line5 这类
        // 无标注图的量程与原版对不齐。
        bool anyYMark0 = false;
        bool anyYMark1 = false;
        bool anyXMark = false;
        for (int msc = 0; msc < series.Count; msc = msc + 1) {
            ChartSeries msp = series[msc];
            if (msp.hidden) { continue; }
            if (!(o.markPoint || msp.marks.Count > 0)) { continue; }
            if (msp.axisIndex == 1) { anyYMark1 = true; } else { anyYMark0 = true; }
            for (int mkc = 0; mkc < msp.marks.Count; mkc = mkc + 1) {
                if (msp.marks[mkc].valueIndex == 0) { anyXMark = true; }
            }
        }
        int pxPad = app.Scale(16);
        int leftTickLo = leftLo;
        int leftTickHi = leftHi;
        if (anyYMark0 && !leftLog && y0.min == ChartOption.Auto()
            && y0.max == ChartOption.Auto()) {
            int lpad = ((leftHi - leftLo) * pxPad + plotH - 1) / plotH;
            int lDataMin = Chart.AxisMinFor(series, 0, zI0, zI1, y0.scale);
            if (lpad > 0) {
                if (leftHi - lData < lpad) { leftHi = lData + lpad; }
                if (leftLo != 0 && lDataMin > leftLo
                    && lDataMin - leftLo < lpad) {
                    leftLo = lDataMin - lpad;
                }
            }
        }
        int rightTickLo = rightLo;
        int rightTickHi = rightHi;
        if (anyYMark1 && hasRight && !rightLog && y1.min == ChartOption.Auto()
            && y1.max == ChartOption.Auto()) {
            int rpad = ((rightHi - rightLo) * pxPad + plotH - 1) / plotH;
            int rDataMax = rightDataMax;
            if (rDataMax < 0) { rDataMax = Chart.AxisMaxFor(series, 1, zI0, zI1, y1.scale); }
            int rDataMin = Chart.AxisMinFor(series, 1, zI0, zI1, y1.scale);
            if (rpad > 0) {
                if (rightHi - rDataMax < rpad) { rightHi = rDataMax + rpad; }
                if (rightLo != 0 && rDataMin > rightLo
                    && rDataMin - rightLo < rpad) {
                    rightLo = rDataMin - rpad;
                }
            }
        }
        int xTickLo = xLo;
        int xTickHi = xHi;
        if (anyXMark && xValue && !isTime && x0.min == ChartOption.Auto()
            && x0.max == ChartOption.Auto()) {
            int xpad = ((xHi - xLo) * pxPad + plotW - 1) / plotW;
            int xDataMin = Chart.XMinFor(series, catY, x0.scale);
            int xDataMax = Chart.XMaxFor(series, catY, x0.scale);
            if (xpad > 0) {
                if (xHi - xDataMax < xpad) { xHi = xDataMax + xpad; }
                if (xLo != 0 && xDataMin > xLo && xDataMin - xLo < xpad) {
                    xLo = xDataMin - xpad;
                }
                if (xHi <= xLo) { xHi = xLo + 1; }
            }
        }

        ChartFrame f = new ChartFrame();
        f.plotX = plotX;
        f.plotY = plotY;
        f.plotW = plotW;
        f.plotH = plotH;
        f.leftMin = leftLo;
        f.leftMax = leftHi;
        f.leftMinF = leftLoF;
        f.leftMaxF = leftHiF;
        f.rightMin = rightLo;
        f.rightMax = rightHi;
        f.rightMinF = rightLoF;
        f.rightMaxF = rightHiF;
        f.hasRight = hasRight;
        f.reversed = y0.reversed;
        f.rightReversed = y1.reversed;
        f.leftLog = leftLog;
        f.rightLog = rightLog;
        f.isTime = isTime;
        f.timeMin = tMin;
        f.timeMax = tMax;
        f.catBoundaryGap = x0.boundaryGap;
        f.catY = catY;
        f.xLo = xLo;
        f.xHi = xHi;
        f.leftNegate = y0.labelNegate;
        f.rightNegate = y1.labelNegate;

        // 网格线 + 左右数值标签（对数轴用 10 的幂刻度）
        StyleBox sGrid = Style.Part(app, "chart", "grid", "", "", "",
                                    Style.SNormal());
        StyleBox sAxis = Style.Part(app, "chart", "axis", "", "", "",
                                    Style.SNormal());
        StyleBox sAxisTitle = Style.Part(app, "chart", "axis-title", "", "",
                                         "", Style.SNormal());
        bool grid = o.showGrid && y0.showGrid;
        // ECharts axis.show：false 时整条轴（线/刻度/标签）不画，
        // 网格线仍随 splitLine 语义保留。
        bool y0Show = y0.show;
        bool x0Show = x0.show;
        // ECharts splitArea.show：相邻刻度交替底纹。2.2 数值轴默
        // 认开、5.x 默认关——引擎字段随 5.x 默认 false，按轴打开。
        // 对白底取 3%/5.5% 黑的 alpha 叠加，视觉即参照站的
        // #F7F7F7/#F2F2F2。类目 Y（轴互换）与对数轴不画。
        if (grid && y0.splitArea && !catY && !leftLog
            && y0.type == ChartAxisType.Value
            && plotW > 0 && plotH > 0) {
            int sSpan = leftTickHi - leftTickLo;
            for (int sk = 0; sk < ticks; sk = sk + 1) {
                int sLo = leftTickLo + sSpan * sk / ticks;
                int sHi = leftTickLo + sSpan * (sk + 1) / ticks;
                int syTop = f.YOf(sHi, 0);
                int syBot = f.YOf(sLo, 0);
                if (syBot <= syTop) { continue; }
                c.FillRect(plotX, syTop, plotW, syBot - syTop,
                    sk % 2 == 0 ? 0x08000000 : 0x0E000000);
            }
        }
        // 薄面板（多 grid 成交量条带这类）：刻度行距小于一行字高
        // 时标签隔行画（网格线照画），避免上下叠字糊成一团。
        int yLblStep = 1;
        if (plotH < (ticks + 1) * (fh + app.Scale(4))) { yLblStep = 2; }
        if (catY) {
            // 类目 Y（轴互换）：水平网格线 + 槽中类目标签。
            int cn = y0.categories.Count;
            for (int ci = 0; ci < cn; ci = ci + 1) {
                int gy = f.CatMidY(ci, cn);
                if (grid) { c.FillRect(plotX, gy, plotW, 1, sGrid.BgOr(0)); }
                if (!y0Show) { continue; }
                string ls = y0.categories[ci];
                if (y0.labelFormatter.Length > 0) { ls = y0.labelFormatter.Replace("{value}", ls); }
                int lw = Canvas.MeasureText(ls, fs);
                c.DrawText(plotX - app.Scale(6) - lw, Canvas.CenterTextYAt(gy, fs),
                    ls, sAxis.FgOr(0), fs);
            }
        } else if (leftLog) {
            List<int> lts = Chart.LogTicks(leftLo, leftHi);
            for (int li = 0; li < lts.Count; li = li + 1) {
                int lv = lts[li];
                int gy = f.YOfLog(lv, 0);
                if (grid) { c.FillRect(plotX, gy, plotW, 1, sGrid.BgOr(0)); }
                if (!y0Show) { continue; }
                string ls = Convert.ToString(lv);
                if (leftLog) { ls = Chart.Commas(lv); }
                int lw = Canvas.MeasureText(ls, fs);
                c.DrawText(plotX - app.Scale(6) - lw, Canvas.CenterTextYAt(gy, fs),
                    ls, sAxis.FgOr(0), fs);
            }
        } else if (leftFrac) {
            // 小数轴刻度：×1000 定点域等分，标签 FracText 除回
            // （0..500000 定点 5 段 → 0/100/…/500）。
            int leftSpanF = leftHiF - leftLoF;
            for (int k = 0; k <= ticks; k = k + 1) {
                int lvF = leftLoF + leftSpanF * k / ticks;
                int gy = f.YOfF(lvF, 0);
                if (grid) { c.FillRect(plotX, gy, plotW, 1, sGrid.BgOr(0)); }
                if (!y0Show || k % yLblStep != 0) { continue; }
                string ls = Chart.FracText(y0.labelNegate ? 0 - lvF : lvF);
                if (y0.labelFormatter.Length > 0) { ls = y0.labelFormatter.Replace("{value}", ls); }
                int lw = Canvas.MeasureText(ls, fs);
                c.DrawText(plotX - app.Scale(6) - lw, Canvas.CenterTextYAt(gy, fs),
                    ls, sAxis.FgOr(0), fs);
            }
        } else {
            // 刻度取 Tick 副本（nice 端点）：映射范围留白外扩后，
            // 网格/标签仍落在整数 nice 值上，端格线悬在绘图区内侧。
            int leftSpan = leftTickHi - leftTickLo;
            for (int k = 0; k <= ticks; k = k + 1) {
                int lv = leftTickLo + leftSpan * k / ticks;
                int gy = f.YOf(lv, 0);
                if (grid) { c.FillRect(plotX, gy, plotW, 1, sGrid.BgOr(0)); }
                if (!y0Show || k % yLblStep != 0) { continue; }
                string ls = Chart.Commas(y0.labelNegate ? 0 - lv : lv);
                if (y0.labelFormatter.Length > 0) { ls = y0.labelFormatter.Replace("{value}", ls); }
                int lw = Canvas.MeasureText(ls, fs);
                c.DrawText(plotX - app.Scale(6) - lw, Canvas.CenterTextYAt(gy, fs),
                    ls, sAxis.FgOr(0), fs);
            }
        }
        // ---- A12 minorSplitLine（CartesianAxisView.ts:170-200）----
        // 细分网格线：每两个 nice 刻度之间 splitNumber 等分处画一条
        // 横线（数值轴）。颜色走 chart::minor-grid，缺省回落主网格色。
        // 类目轴不支持（Axis.ts:204 isOrdinalScale 直接返回空）。
        if (grid && (y0.minorSplitLineShow || (hasRight && y1.minorSplitLineShow))) {
            StyleBox sMinor = Style.Part(app, "chart", "minor-grid", "", "", "",
                                        Style.SNormal());
            int mcol = sMinor.BgOr(0) != 0 ? sMinor.BgOr(0) : sGrid.BgOr(0);
            if (y0.minorSplitLineShow && !catY && leftLog) {
                // 对数轴：刻度非等距，逐对插值
                // （minorTicks.ts:41-63），投影走
                // YOfLogF 的定点对数轴。
                List<int> ltsM = Chart.LogTicks(leftLo, leftHi);
                List<double> mtsL = new List<double>();
                Chart.MinorTickValuesPairs(ltsM, y0.minorTickSplitNumber, mtsL);
                for (int mi = 0; mi < mtsL.Count; mi = mi + 1) {
                    long mf = (long)(mtsL[mi] * 1000.0 + 0.5);
                    c.FillRect(plotX, f.YOfLogF(mf, 0), plotW, 1, mcol);
                }
            }
            if (y0.minorSplitLineShow && !catY && !leftLog
                && y0.type == ChartAxisType.Value && ticks > 0) {
                List<double> mts = new List<double>();
                if (leftFrac) {
                    Chart.MinorTickValues((double)leftLoF, (double)leftHiF, ticks,
                        y0.minorTickSplitNumber, mts);
                    for (int mi = 0; mi < mts.Count; mi = mi + 1) {
                        int gy = f.YOfF((int)(mts[mi] + 0.5), 0);
                        c.FillRect(plotX, gy, plotW, 1, mcol);
                    }
                } else {
                    Chart.MinorTickValues((double)leftTickLo, (double)leftTickHi, ticks,
                        y0.minorTickSplitNumber, mts);
                    for (int mi = 0; mi < mts.Count; mi = mi + 1) {
                        int gy = f.YOf((int)(mts[mi] + 0.5), 0);
                        c.FillRect(plotX, gy, plotW, 1, mcol);
                    }
                }
            }
            if (hasRight && y1.minorSplitLineShow && !rightLog
                && y1.type == ChartAxisType.Value && rt > 0) {
                List<double> mts = new List<double>();
                if (rightFrac) {
                    Chart.MinorTickValues((double)rightLoF, (double)rightHiF, rt,
                        y1.minorTickSplitNumber, mts);
                    for (int mi = 0; mi < mts.Count; mi = mi + 1) {
                        int gy = f.YOfF((int)(mts[mi] + 0.5), 1);
                        c.FillRect(plotX, gy, plotW, 1, mcol);
                    }
                } else {
                    Chart.MinorTickValues((double)rightTickLo, (double)rightTickHi, rt,
                        y1.minorTickSplitNumber, mts);
                    for (int mi = 0; mi < mts.Count; mi = mi + 1) {
                        int gy = f.YOf((int)(mts[mi] + 0.5), 1);
                        c.FillRect(plotX, gy, plotW, 1, mcol);
                    }
                }
            }
        }
        if (hasRight) {
            if (rightLog) {
                List<int> rts = Chart.LogTicks(rightLo, rightHi);
                for (int ri = 0; ri < rts.Count; ri = ri + 1) {
                    int rv = rts[ri];
                    int gy = f.YOfLog(rv, 1);
                    c.DrawText(plotRight + app.Scale(6), Canvas.CenterTextYAt(gy, fs),
                        Chart.Commas(rv), sAxis.FgOr(0), fs);
                }
            } else if (rightFrac) {
                int rightSpanF = rightHiF - rightLoF;
                for (int k = 0; k <= rt; k = k + 1) {
                    int rvF = rightLoF + rightSpanF * k / rt;
                    int gy = f.YOfF(rvF, 1);
                    if (grid) { c.FillRect(plotX, gy, plotW, 1, sGrid.BgOr(0)); }
                    if (k % yLblStep != 0) { continue; }
                    string rs = Chart.FracText(y1.labelNegate ? 0 - rvF : rvF);
                    if (y1.labelFormatter.Length > 0) { rs = y1.labelFormatter.Replace("{value}", rs); }
                    c.DrawText(plotRight + app.Scale(6), Canvas.CenterTextYAt(gy, fs),
                        rs, sAxis.FgOr(0), fs);
                }
            } else {
                int rightSpan = rightTickHi - rightTickLo;
                for (int k = 0; k <= rt; k = k + 1) {
                    int rv = rightTickLo + rightSpan * k / rt;
                    int gy = f.YOf(rv, 1);
                    if (k % yLblStep != 0) { continue; }
                    string rs = Chart.Commas(y1.labelNegate ? 0 - rv : rv);
                    if (y1.labelFormatter.Length > 0) { rs = y1.labelFormatter.Replace("{value}", rs); }
                    c.DrawText(plotRight + app.Scale(6), Canvas.CenterTextYAt(gy, fs),
                        rs, sAxis.FgOr(0), fs);
                }
            }
        }
        // 轴线落点：骑线像素取目标轴的 0 位（钳在绘图区内，EDGE 态
        // 就是边界本身）；不骑线回退各自的边界基位。tick 标签不随
        // 骑线移动（官方实测标签恒在网格边界，见 T3b 账本 B10）。
        int xLineY = plotY + plotH;
        if (x0RidesY0) { xLineY = f.ZeroLineY(0); }
        else if (x0RidesY1) { xLineY = f.ZeroLineY(1); }
        int yLineX = plotX;
        if (y0RidesX0) { yLineX = f.ZeroLineX(); }
        int y1LineX = plotX + plotW;
        if (y1RidesX0) { y1LineX = f.ZeroLineX(); }
        if (y0Line) {
            c.FillRect(yLineX, plotY, app.Scale(2), plotH,
                y0.axisLineColor != 0 ? y0.axisLineColor : sAxis.BgOr(0));
        }
        if (x0Line) {
            c.FillRect(plotX, xLineY, plotW, app.Scale(2), sAxis.BgOr(0));
        }
        if (y1Line) {
            c.FillRect(y1LineX, plotY, 1, plotH,
                y1.axisLineColor != 0 ? y1.axisLineColor : sAxis.BgOr(0));
        }

        // x 分类标签（时间轴用 TimeLabel 日期刻度；值轴画数值刻度）
        int n = labels.Count;
        if (x0.show && (catY || xValue)) {
            // 轴互换：类目在 Y（上面已画），X 画数值刻度。
            // ECharts 数值轴 splitLine 默认开（类目轴默认关）：
            // 竖向辅助线是轴互换图（line5 类目 Y + 数值 X）唯一
            // 的网格，横线随类目 Y 的 showGrid=false 不画。
            bool gridX = o.showGrid && x0.showGrid;
            // X 刻度同左/右轴取 nice 端点副本（xLo/xHi 已留白外扩）。
            int xspan = xTickHi - xTickLo;
            // ---- A12 minorSplitLine（X 数值轴）----
            // CartesianAxisView.ts:170-200 同一函数按
            // isHorizontal 分支：x 轴画竖线。
            // 类目轴不支持（Axis.ts:204 返回空）。
            if (x0.minorSplitLineShow && !catY && !isTime
                && x0.type == ChartAxisType.Value && xt > 0) {
                StyleBox sMinorX = Style.Part(app, "chart", "minor-grid", "", "", "",
                                             Style.SNormal());
                int mcolX = sMinorX.BgOr(0) != 0 ? sMinorX.BgOr(0) : sGrid.BgOr(0);
                List<double> mtsX = new List<double>();
                Chart.MinorTickValues((double)xTickLo, (double)xTickHi, xt,
                    x0.minorTickSplitNumber, mtsX);
                for (int miX = 0; miX < mtsX.Count; miX = miX + 1) {
                    int gmx = f.XOfValue((int)(mtsX[miX] + 0.5));
                    if (gmx > plotX && gmx < plotX + plotW) {
                        c.FillRect(gmx, plotY, 1, plotH, mcolX);
                    }
                }
            }
            for (int k = 0; k <= xt; k = k + 1) {
                int xv = xTickLo + xspan * k / xt;
                int gx = f.XOfValue(xv);
                if (gridX) { c.FillRect(gx, plotY, 1, plotH, sGrid.BgOr(0)); }
                string xs2 = Chart.Commas(xv);
                if (x0.labelFormatter.Length > 0) { xs2 = x0.labelFormatter.Replace("{value}", xs2); }
                string xs2m = x0.labelSt != null && x0.labelSt.rich != null
                    ? Chart.RichStrip(xs2) : xs2;
                int lw = Canvas.MeasureText(xs2m, fs);
                int lx = gx - lw / 2;
                if (lx < plotX) { lx = plotX; }
                if (lx + lw > plotX + plotW) { lx = plotX + plotW - lw; }
                Chart.DrawAxisLabel(app, c, x0, xs2, lx, plotBot + app.Scale(4),
                    sAxis.FgOr(0), fs);
            }
        } else if (x0.show && (n > 0 || isTime)) {
            if (isTime) {
                List<int> tts = Chart.TimeTicks(tMin, tMax, 6);
                for (int ti = 0; ti < tts.Count; ti = ti + 1) {
                    int tx = f.XOfTime(tts[ti]);
                    string ls = Chart.TimeLabel(tts[ti]);
                    if (x0.labelFormatter.Length > 0) { ls = x0.labelFormatter.Replace("{value}", ls); }
                    string lsm = x0.labelSt != null && x0.labelSt.rich != null
                        ? Chart.RichStrip(ls) : ls;
                    int lw = Canvas.MeasureText(lsm, fs);
                    int lx = tx - lw / 2;
                    if (lx < plotX) { lx = plotX; }
                    if (lx + lw > plotX + plotW) { lx = plotX + plotW - lw; }
                    Chart.DrawAxisLabel(app, c, x0, ls, lx, plotBot + app.Scale(4),
                        sAxis.FgOr(0), fs);
                }
            } else {
                int labelGap = app.Scale(6);
                int rot = x0.labelRotate;
                // 刻度线模式（boundaryGap=false）标签以刻度为中心，
                // 首尾标签允许越出绘图区（与数值轴标签同形态）；
                // 带状模式居中在格子内、不越左缘。
                bool tickX = !f.catBoundaryGap && n > 1;
                // ECharts 2 类目轴 splitLine 默认开、interval 缺省
                // 'auto'（与 axisLabel 同源抽稀）：竖线只落在显示标签
                // 的刻度上——刻度模式落在类目刻度（CatX），带状模式落
                // 在格子边界（CatLeft）；首线与 y 轴重合、末线贴绘图区
                // 右缘，都跳过。密集类目（雨量图 3079 点）不再逐类目
                // 一条竖线糊成灰罩。
                List<int> tickShown = Chart.CategoryTicks(f, labels, fs,
                    plotX, labelGap, x0);
                if (o.showGrid && x0.showGrid) {
                    for (int si3 = 0; si3 < tickShown.Count; si3 = si3 + 1) {
                        int gvi = tickShown[si3];
                        if (!tickX && gvi == 0) { continue; }
                        int gvx = tickX ? f.CatX(gvi, n) : f.CatLeft(gvi, n);
                        if (gvx > plotX && gvx < plotX + plotW) {
                            c.FillRect(gvx, plotY, 1, plotH, sGrid.BgOr(0));
                        }
                    }
                }
                for (int ti5 = 0; ti5 < tickShown.Count; ti5 = ti5 + 1) {
                    int ci = tickShown[ti5];
                    string lab = labels[ci];
                    if (x0.labelFormatter.Length > 0) { lab = x0.labelFormatter.Replace("{value}", lab); }
                    bool labRich = x0.labelSt != null && x0.labelSt.rich != null;
                    string labm = labRich ? Chart.RichStrip(lab) : lab;
                    int cxs = f.CatLeft(ci, n);
                    int cellW = f.CatWidth(ci, n);
                    int labelW = Canvas.MeasureText(labm, fs);
                    int labelLeft = tickX ? cxs - labelW / 2
                        : cxs + (cellW - labelW) / 2;
                    if (!tickX && labelLeft < cxs) { labelLeft = cxs; }
                    // 直接迭代 tickShown（CategoryTicks 已抽稀），
                    // 不再对未显示的类目做 Replace/MeasureText。
                    if (rot != 0) {
                        // DrawTextRot 绕未旋转行盒左上角顺时针旋转：
                        // 负角取行盒右缘为锚（文本向右下伸展、标签尾
                        // 对齐格子中线），正角取左缘（文本向右上收）。
                        // 富文本块不能整体旋转——画剥壳文本。
                        int ax = labelLeft + labelW;
                        if (rot > 0) { ax = labelLeft; }
                        c.DrawTextRot(ax, plotBot + app.Scale(4), labm,
                            sAxis.FgOr(0), fs, rot);
                    } else if (tickX) {
                        Chart.DrawAxisLabel(app, c, x0, lab, cxs - labelW / 2,
                            plotBot + app.Scale(4), sAxis.FgOr(0), fs);
                    } else {
                        Chart.DrawAxisLabelCentered(app, c, x0, lab, cxs,
                            plotBot + app.Scale(4), cellW, fh + app.Scale(4),
                            sAxis.FgOr(0), fs);
                    }
                }
            }
        }

        // 轴名：ECharts 三态（缺省 'end'）+ nameGap（缺省 15）。
        // 几何与实测出处见 Chart.AxisNamePos。骑线时 start/end 态
        // 的名字贴轴线走（middle 留在边界，AxisBuilder.ts:869 的
        // labelOffset 抵回原位）。
        Chart.DrawAxisNameAt(app, c, x0, true, plotX, plotY, plotW, plotH, false,
            sAxisTitle, fs, xLineY);
        Chart.DrawAxisNameAt(app, c, y0, false, plotX, plotY, plotW, plotH,
            y0.position == "right", sAxisTitle, fs, yLineX);
        // 右轴名只在真的存在第二条轴时画（YAxis1 在单轴时会回退
        // 到 YAxis0，不设防会把左轴名镜像到右缘）。
        if (hasRight && o.yAxes.Count > 1) {
            Chart.DrawAxisNameAt(app, c, y1, false, plotX, plotY, plotW, plotH,
                y1.position == "right", sAxisTitle, fs, y1LineX);
        }

        return f;
    }
}
