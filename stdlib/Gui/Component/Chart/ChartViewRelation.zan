using System;
using System.Json;
using Gui;

namespace Gui.Component.Chart;

partial class ChartView {
    // ---- 弦图（ECharts type 'chord'；外环节点弧 + 连接 ribbon） ----

    // 力导向布局的逐帧记忆化：布局是数据与几何的纯函数（局部
    // 坐标，与卡片在屏幕上的位置无关），即时模式调用方每帧重建
    // option，按内容指纹复用同一次弹簧模拟，滚动/悬停帧不再
    // 重算 O(n²) 迭代。小容量即可——同屏一般只有一两个力导向图。
    static List<ForceLayoutCache> forceCache;

    static int ForceFingerprint(List<ChartLink> links, int r, int w, int h,
                                int scaling, int gravity) {
        int fp = (r * 17 + w * 19 + h * 23 + scaling * 29 + gravity * 31) % 2000000000;
        for (int i = 0; i < links.Count; i = i + 1) {
            ChartLink lk = links[i];
            fp = ChartView.FoldStr(fp, lk.from, 21);
            fp = ChartView.FoldStr(fp, lk.to, 22);
            fp = (fp * 31 + lk.val) % 2000000000;
        }
        return fp;
    }

    static ForceLayout CachedForceLayout(List<ChartLink> links,
                                         int r, int w, int h,
                                         int scaling, int gravity) {
        if (links.Count < 1) { return ForceLayout.Of(links, r, w, h, scaling, gravity); }
        int fp = ChartView.ForceFingerprint(links, r, w, h, scaling, gravity);
        if (ChartView.forceCache == null) {
            ChartView.forceCache = new List<ForceLayoutCache>();
        }
        ForceLayout hit = ForceLayoutCache.Lookup(ChartView.forceCache, fp);
        if (hit != null) { return hit; }
        ForceLayout layout = ForceLayout.Of(links, r, w, h, scaling, gravity);
        ForceLayoutCache.Store(ChartView.forceCache, fp, layout, 4);
        return layout;
    }

    static void DrawChord(App app, int x, int y, int w, int h,
                          ChartOption o, int g) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int pad = t.paddingMedium;
        int top = ChartView.PanelHead(app, x, y, w, h, o.title);
        ChartSeries lead = ChartView.LeadSeries(o);
        if (lead == null || lead.links.Count < 1) { return; }

        ChordLayout layout = ChordLayout.Of(lead.links, lead.chordSort,
            lead.chordSortSub, lead.chordGapDeg);
        int nn = layout.nodes.Count;
        if (nn < 1) { return; }
        int nr = layout.ribbons.Count;
        List<bool> nodeHid = new List<bool>();
        for (int ni = 0; ni < nn; ni = ni + 1) {
            bool h = false;
            if (o.iwid != 0) {
                h = app.StateGet(Chart.LegendSliceKey(o.iwid, 0, ni), 0) == 1;
            }
            nodeHid.Add(h);
        }

        int hoverNode = 0 - 1;
        int bodyY = top;
        if (o.showLegend) {
            int x0 = x + pad;
            int xCur = x0;
            int yCur = top;
            int maxX = x + w - pad;
            int rowH = Canvas.FontHeight(Style.FontFallback(app, "small")) + app.Scale(6);
            for (int i = 0; i < nn; i = i + 1) {
                ChordNodeArc naL = layout.nodes[i];
                int cw = Chart.LegendChipW(app, naL.name);
                if (xCur > x0 && xCur + cw > maxX) {
                    xCur = x0;
                    yCur = yCur + rowH;
                }
                if (app.mouseX >= xCur && app.mouseX < xCur + cw
                    && app.mouseY >= yCur && app.mouseY < yCur + rowH) {
                    hoverNode = i;
                }
                int key = 0;
                if (o.iwid != 0) { key = Chart.LegendSliceKey(o.iwid, 0, i); }
                bool hid = false;
                if (i < nodeHid.Count) { hid = nodeHid[i]; }
                Chart.DrawLegendChip(app, xCur, yCur, cw, rowH,
                    Chart.Palette(t, i), naL.name, hid, key);
                xCur = xCur + cw + app.Scale(8);
                bodyY = yCur + rowH + app.Scale(4);
            }
        }

        int areaW = w - pad * 2;
        int areaH = (y + h - pad) - bodyY;
        int r = ChartView.RadialRadius(areaW, areaH, 56);
        if (r < app.Scale(20)) { r = app.Scale(20); }
        int cx = x + pad + areaW / 2;
        int cy = bodyY + areaH / 2;
        int boxX = x + pad;
        int boxY = bodyY;
        int boxW = areaW;
        int boxH = areaH;

        int maxVal = 1;
        for (int i = 0; i < nr; i = i + 1) {
            if (layout.ribbons[i].val > maxVal) { maxVal = layout.ribbons[i].val; }
        }
        int ribbonR = r * 88 / 100;
        bool thin = lead.chordRibbonType == "path" || lead.innerPct > 0;
        // chordStyle：外环宽（占半径 %，默认 22 = 现状 78/100）。
        int ringW = lead.chordRingWidthPct > 0 ? lead.chordRingWidthPct : 22;
        int rInner0 = r * (100 - ringW) / 100;
        int hoverRibbon = 0 - 1;
        int mxH = app.mouseX;
        int myH = app.mouseY;
        int distH = ChartView.ISqrt((mxH - cx) * (mxH - cx) + (myH - cy) * (myH - cy));
        if (myH >= bodyY && distH >= rInner0 && distH <= r + app.Scale(4)) {
            int angH = ChartView.AngleOf(mxH - cx, myH - cy);
            for (int hi = 0; hi < nn; hi = hi + 1) {
                if (hi < nodeHid.Count && nodeHid[hi]) { continue; }
                if (ChartView.InSweep(angH, layout.nodes[hi].a0, layout.nodes[hi].a1)) {
                    hoverNode = hi;
                }
            }
        }
        if (hoverNode < 0 && myH >= bodyY) {
            for (int ri = 0; ri < nr; ri = ri + 1) {
                ChordRibbon rbh = layout.ribbons[ri];
                if (rbh.from < nodeHid.Count && nodeHid[rbh.from]) { continue; }
                if (rbh.to < nodeHid.Count && nodeHid[rbh.to]) { continue; }
                int x1h = ChartView.FillX(cx, ribbonR, rbh.srcAngle);
                int y1h = ChartView.FillY(cy, ribbonR, rbh.srcAngle);
                int x2h = ChartView.FillX(cx, ribbonR, rbh.dstAngle);
                int y2h = ChartView.FillY(cy, ribbonR, rbh.dstAngle);
                int segsH = 12;
                int pxh = x1h;
                int pyh = y1h;
                for (int sih = 1; sih <= segsH; sih = sih + 1) {
                    int tq = sih * 100 / segsH;
                    int it = 100 - tq;
                    int bx = (it * it * x1h + 2 * it * tq * cx + tq * tq * x2h) / 10000;
                    int by = (it * it * y1h + 2 * it * tq * cy + tq * tq * y2h) / 10000;
                    if (ChartView.DistToSeg(mxH, myH, pxh, pyh, bx, by) <= app.Scale(8)) {
                        hoverRibbon = ri;
                    }
                    pxh = bx;
                    pyh = by;
                }
            }
        }

        // 先画 ribbon：端点落在对应节点子弧上（FillSector 角）。
        for (int i = 0; i < nr; i = i + 1) {
            ChordRibbon rb = layout.ribbons[i];
            if (rb.from < nodeHid.Count && nodeHid[rb.from]) { continue; }
            if (rb.to < nodeHid.Count && nodeHid[rb.to]) { continue; }
            int col = Chart.Palette(t, rb.from);
            bool related = i == hoverRibbon
                || rb.from == hoverNode || rb.to == hoverNode;
            int alpha = 90;
            if (related) { alpha = 160; }
            if (thin) {
                int x1 = ChartView.FillX(cx, ribbonR, rb.srcAngle);
                int y1 = ChartView.FillY(cy, ribbonR, rb.srcAngle);
                int x2 = ChartView.FillX(cx, ribbonR, rb.dstAngle);
                int y2 = ChartView.FillY(cy, ribbonR, rb.dstAngle);
                int th = app.Scale(2);
                if (related) { th = app.Scale(3); }
                ChartView.StrokeQuad(c, x1, y1, cx, cy, x2, y2,
                    Chart.WithAlpha(col, alpha + 40), th);
            } else {
                ChartView.FillChordRibbon(c, cx, cy, ribbonR,
                    rb.srcA0, rb.srcA1, rb.dstA0, rb.dstA1, col, alpha);
            }
        }

        // 节点弧：外环上按权重分的扇区，随 g 扫入。
        int rInner = rInner0;
        int sweepMax = 360 * g / 1000;
        for (int i = 0; i < nn; i = i + 1) {
            if (i < nodeHid.Count && nodeHid[i]) { continue; }
            ChordNodeArc na = layout.nodes[i];
            int a0 = na.a0;
            int a1 = na.a1;
            if (a1 > a0 + sweepMax) { a1 = a0 + sweepMax; }
            if (a1 > a0) {
                int ncol = Chart.Palette(t, i);
                c.FillSector(cx, cy, rInner, r, a0, a1, ncol);
                if (i == hoverNode || (hoverRibbon >= 0
                    && (layout.ribbons[hoverRibbon].from == i
                        || layout.ribbons[hoverRibbon].to == i))) {
                    c.FillSector(cx, cy, rInner, r, a0, a1,
                        Chart.WithAlpha(ncol, 220));
                }
            }
            string nm = na.name;
            int mid = (na.a0 + na.a1) / 2;
            int gapL = app.Scale(6);
            int fsN = Style.FontFallback(app, "small");
            int twN = Canvas.MeasureText(nm, fsN);
            int lxN = ChartView.FillX(cx, r + gapL, mid);
            int lyN = Canvas.CenterTextYAt(ChartView.FillY(cy, r + gapL, mid), fsN);
            if (ChartView.FillDx(mid) < 0) { lxN = lxN - twN; }
            ChartView.DrawTextClamped(c, lxN, lyN, nm,
                Style.Part(app, "chart", "label", "", "", "", Style.SNormal()).FgOr(0),
                fsN, boxX, boxY, boxW, boxH);
        }

        if (o.showTooltip) {
            int mx = app.mouseX;
            int my = app.mouseY;
            if (my < bodyY) { return; }
            int ddx = mx - cx;
            int ddy = my - cy;
            int dist = ChartView.ISqrt(ddx * ddx + ddy * ddy);
            // 节点命中优先：外环带内且角度落在该弧。
            if (dist >= rInner && dist <= r + app.Scale(4)) {
                int ang = ChartView.AngleOf(ddx, ddy);
                for (int i = 0; i < nn; i = i + 1) {
                    ChordNodeArc na = layout.nodes[i];
                    if (ChartView.InSweep(ang, na.a0, na.a1)) {
                        if (i < nodeHid.Count && nodeHid[i]) { continue; }
                        List<TooltipRow> rows = new List<TooltipRow>{
                            TooltipRow.Of(0, o.title),
                            TooltipRow.Of(Chart.Palette(t, i),
                                na.name + "  " + Convert.ToString(na.weight)) };
                        ChartView.TooltipCard(app, mx, my, x + w, rows);
                        return;
                    }
                }
            }
            // ribbon 命中：到线段的距离小于半带宽。
            for (int i = 0; i < nr; i = i + 1) {
                ChordRibbon rb = layout.ribbons[i];
                if (rb.from < nodeHid.Count && nodeHid[rb.from]) { continue; }
                if (rb.to < nodeHid.Count && nodeHid[rb.to]) { continue; }
                int x1 = ChartView.FillX(cx, ribbonR, rb.srcAngle);
                int y1 = ChartView.FillY(cy, ribbonR, rb.srcAngle);
                int x2 = ChartView.FillX(cx, ribbonR, rb.dstAngle);
                int y2 = ChartView.FillY(cy, ribbonR, rb.dstAngle);
                int th = app.Scale(2) + app.Scale(6) * rb.val / maxVal;
                int hitR = app.Scale(4) + th / 2;
                // 命中沿同一条贝塞尔折线逐段测距。
                int segs = 18;
                int px = x1;
                int py = y1;
                bool hit = false;
                for (int si = 1; si <= segs; si = si + 1) {
                    int tq = si * 100 / segs;
                    int it = 100 - tq;
                    int bx = (it * it * x1 + 2 * it * tq * cx + tq * tq * x2) / 10000;
                    int by = (it * it * y1 + 2 * it * tq * cy + tq * tq * y2) / 10000;
                    if (ChartView.DistToSeg(mx, my, px, py, bx, by) <= hitR) {
                        hit = true;
                        break;
                    }
                    px = bx;
                    py = by;
                }
                if (hit) {
                    string fn = layout.nodes[rb.from].name;
                    string tn = layout.nodes[rb.to].name;
                    List<TooltipRow> rows = new List<TooltipRow>{
                        TooltipRow.Of(0, o.title),
                        TooltipRow.Of(Chart.Palette(t, rb.from),
                            fn + " → " + tn + "  " + Convert.ToString(rb.val)) };
                    ChartView.TooltipCard(app, mx, my, x + w, rows);
                    return;
                }
            }
        }

        // markPoint：权重最大节点弧的外侧标 pin（ECharts chord.html 在弦图
        // 叠 markPoint 的少见用法；这里按「max 一个」的确定性规则落地）。
        if (o.markPoint) {
            int bestN = 0 - 1;
            int bestW = 0 - 1;
            for (int mi = 0; mi < nn; mi = mi + 1) {
                if (mi < nodeHid.Count && nodeHid[mi]) { continue; }
                if (layout.nodes[mi].weight > bestW) {
                    bestW = layout.nodes[mi].weight; bestN = mi;
                }
            }
            if (bestN >= 0) {
                ChordNodeArc nb = layout.nodes[bestN];
                int midM = (nb.a0 + nb.a1) / 2;
                int pxM = ChartView.FillX(cx, r, midM);
                int pyM = ChartView.FillY(cy, r, midM);
                int offM = app.Scale(10);
                int exM = ChartView.FillX(cx, r + offM, midM);
                int eyM = ChartView.FillY(cy, r + offM, midM);
                int fgM = Style.Part(app, "chart", "value", "", "", "", Style.SNormal()).FgOr(0);
                int fsM = Style.FontFallback(app, "small");
                c.DrawLine(pxM, pyM, exM, eyM, fgM, 1);
                c.FillCircle(exM, eyM, app.Scale(2), fgM);
                string txtM = "max " + Convert.ToString(nb.weight);
                int twM = Canvas.MeasureText(txtM, fsM);
                int thM = Canvas.FontHeight(fsM);
                int txM = exM;
                if (ChartView.FillDx(midM) < 0) { txM = exM - twM; }
                int tyM = eyM - thM;
                if (tyM < boxY) { tyM = boxY; }
                if (txM < boxX) { txM = boxX; }
                if (txM + twM > boxX + boxW) { txM = boxX + boxW - twM; }
                c.DrawText(txM, tyM, txtM, fgM, fsM);
            }
        }
    }

    static void AppendArcPts(List<int> px, List<int> py,
                             int cx, int cy, int r, int a0, int a1) {
        int span = a1 - a0;
        if (span < 1) { span = 1; }
        int steps = span / 2;
        if (steps < 4) { steps = 4; }
        if (steps > 48) { steps = 48; }
        for (int i = 0; i <= steps; i = i + 1) {
            int a = a0 + span * i / steps;
            px.Add(ChartView.FillX(cx, r, a));
            py.Add(ChartView.FillY(cy, r, a));
        }
    }

    static void AppendQuadPts(List<int> px, List<int> py,
                              int x1, int y1, int cx, int cy, int x2, int y2) {
        int segs = 16;
        for (int si = 1; si <= segs; si = si + 1) {
            int tq = si * 100 / segs;
            int it = 100 - tq;
            px.Add((it * it * x1 + 2 * it * tq * cx + tq * tq * x2) / 10000);
            py.Add((it * it * y1 + 2 * it * tq * cy + tq * tq * y2) / 10000);
        }
    }

    static void StrokeQuad(Canvas c, int x1, int y1, int cx, int cy,
                           int x2, int y2, int color, int th) {
        List<int> fx = new List<int>();
        List<int> fy = new List<int>();
        fx.Add(x1 * 256);
        fy.Add(y1 * 256);
        int segs = 24;
        for (int si = 1; si <= segs; si = si + 1) {
            int tq = si * 100 / segs;
            int it = 100 - tq;
            int bx = (it * it * x1 + 2 * it * tq * cx + tq * tq * x2) / 10000;
            int by = (it * it * y1 + 2 * it * tq * cy + tq * tq * y2) / 10000;
            fx.Add(bx * 256);
            fy.Add(by * 256);
        }
        c.DrawPolylineFx(fx, fy, color, th);
    }

    static void FillChordRibbon(Canvas c, int cx, int cy, int r,
                                int sa0, int sa1, int da0, int da1,
                                int color, int alpha) {
        if (sa1 <= sa0) { sa1 = sa0 + 1; }
        if (da1 <= da0) { da1 = da0 + 1; }
        List<int> px = new List<int>();
        List<int> py = new List<int>();
        ChartView.AppendArcPts(px, py, cx, cy, r, sa0, sa1);
        int xS1 = ChartView.FillX(cx, r, sa1);
        int yS1 = ChartView.FillY(cy, r, sa1);
        int xD0 = ChartView.FillX(cx, r, da0);
        int yD0 = ChartView.FillY(cy, r, da0);
        ChartView.AppendQuadPts(px, py, xS1, yS1, cx, cy, xD0, yD0);
        ChartView.AppendArcPts(px, py, cx, cy, r, da0, da1);
        int xD1 = ChartView.FillX(cx, r, da1);
        int yD1 = ChartView.FillY(cy, r, da1);
        int xS0 = ChartView.FillX(cx, r, sa0);
        int yS0 = ChartView.FillY(cy, r, sa0);
        ChartView.AppendQuadPts(px, py, xD1, yD1, cx, cy, xS0, yS0);
        ChartView.FillPolyWinding(c, px, py, color, alpha);
        ChartView.StrokePolyFx(c, px, py, Chart.WithAlpha(color, alpha + 50), 1);
    }

    // 角度（FillSector 约定，0 = 12 点）是否落在 [a0,a1)（含跨 0 回绕）。
    static bool InSweep(int ang, int a0, int a1) {
        if (a1 > a0) { return ang >= a0 && ang < a1; }
        return ang >= a0 || ang < a1;
    }

    // ---- 力导向图（ECharts type 'force'；边 + 节点 + 标签） ----

    static void DrawForce(App app, int x, int y, int w, int h,
                          ChartOption o, int g) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int pad = t.paddingMedium;
        int top = ChartView.PanelHead(app, x, y, w, h, o.title);
        ChartSeries lead = ChartView.LeadSeries(o);
        if (lead == null || lead.links.Count < 1) { return; }

        int legendW = 0;
        if (o.showLegend) { legendW = app.Scale(120); }
        int areaW = w - pad * 2 - legendW;
        int areaH = (y + h - pad) - top;
        int r = areaW * 2 / 5;
        if (areaH * 2 / 5 < r) { r = areaH * 2 / 5; }
        if (r < app.Scale(10)) { r = app.Scale(10); }
        // 布局在局部坐标里模拟（原点 = 绘图区左上角）；绘制与
        // 命中时统一平移回屏幕，形状不随卡片滚动位置变化。
        int ox = x + pad;
        int oy = top;

        ForceLayout layout = ChartView.CachedForceLayout(lead.links,
            r, areaW, areaH, lead.forceScaling, lead.forceGravity);
        // 逐节点形状 + minRadius/maxRadius 权重插值（不改几何，仅
        // symbol/size 元数据，幂等重放，对共享缓存安全）。
        ForceLayout.ApplyShapes(layout, lead.tree,
            app.Scale(lead.forceMinRadius), app.Scale(lead.forceMaxRadius));
        int nn = layout.nodes.Count;
        if (nn < 1) { return; }
        List<bool> nodeHid = new List<bool>();
        for (int ni = 0; ni < nn; ni = ni + 1) {
            bool h = false;
            if (o.iwid != 0) {
                h = app.StateGet(Chart.LegendSliceKey(o.iwid, 0, ni), 0) == 1;
            }
            nodeHid.Add(h);
        }

        int maxVal = 1;
        for (int i = 0; i < layout.edges.Count; i = i + 1) {
            if (layout.edges[i].val > maxVal) { maxVal = layout.edges[i].val; }
        }
        // linkStyle/nodeStyle 显式色（0 = 逐节点调色板，现状）。
        int linkCol0 = lead.forceLinkColor;
        int nodeCol0 = lead.forceNodeColor;
        // 悬停节点（若有）：相邻边高亮。
        int hoverNode = 0 - 1;
        if (o.showTooltip) {
            int mx = app.mouseX;
            int my = app.mouseY;
            int best = 0 - 1;
            int bestD = 0;
            for (int i = 0; i < nn; i = i + 1) {
                if (i < nodeHid.Count && nodeHid[i]) { continue; }
                int ddx = mx - (ox + layout.nodes[i].x);
                int ddy = my - (oy + layout.nodes[i].y);
                int d2 = ddx * ddx + ddy * ddy;
                int rad = app.Scale(6);
                if (d2 <= rad * rad) {
                    if (best < 0 || d2 < bestD) { best = i; bestD = d2; }
                }
            }
            hoverNode = best;
        }

        // 边：先画普通边，再盖悬停高亮。
        int alpha = 120 * g / 1000;
        for (int i = 0; i < layout.edges.Count; i = i + 1) {
            ForceEdge e = layout.edges[i];
            if (e.a < nodeHid.Count && nodeHid[e.a]) { continue; }
            if (e.b < nodeHid.Count && nodeHid[e.b]) { continue; }
            int col = linkCol0;
            if (col == 0) { col = Chart.Palette(t, e.a); }
            int w2 = 1 + app.Scale(2) * e.val / maxVal;
            c.DrawLine(ox + layout.nodes[e.a].x, oy + layout.nodes[e.a].y,
                ox + layout.nodes[e.b].x, oy + layout.nodes[e.b].y,
                Chart.WithAlpha(col, alpha), w2);
        }
        if (hoverNode >= 0) {
            for (int i = 0; i < layout.edges.Count; i = i + 1) {
                ForceEdge e = layout.edges[i];
                if (e.a != hoverNode && e.b != hoverNode) { continue; }
                int col = linkCol0;
                if (col == 0) { col = Chart.Palette(t, e.a); }
                c.DrawLine(ox + layout.nodes[e.a].x, oy + layout.nodes[e.a].y,
                    ox + layout.nodes[e.b].x, oy + layout.nodes[e.b].y,
                    col, app.Scale(3));
            }
        }

        // 节点 + 标签。显式形状经 series.tree 的 ChartNode.Shaped
        // 叶按名匹配（ECharts force 的逐节点 symbol/symbolSize）。
        int nodeR = app.Scale(5);
        for (int i = 0; i < nn; i = i + 1) {
            if (i < nodeHid.Count && nodeHid[i]) { continue; }
            ForceNode nd = layout.nodes[i];
            int col = nodeCol0;
            if (col == 0) { col = Chart.Palette(t, i); }
            int nr = nodeR;
            if (nd.size > 0) { nr = app.Scale(nd.size) / 2; }
            Chart.DrawSymbol(c, ox + nd.x, oy + nd.y, nr, nd.symbol, col,
                4294967295, app.Scale(1));
            string nm = nd.name;
            int tw = Canvas.MeasureText(nm, Style.FontFallback(app, "small"));
            int fs = Style.FontFallback(app, "small");
            ChartView.DrawTextClamped(c, ox + nd.x - tw / 2, oy + nd.y + nr + app.Scale(3),
                nm,
                Style.Part(app, "chart", "label", "", "", "", Style.SNormal()).FgOr(0),
                fs, ox, oy, areaW, areaH);
        }

        // 图例：节点名 + 对应颜色（每节点一行）。
        if (o.showLegend) {
            int lx2 = x + w - pad - legendW;
            int ly2 = Chart.LegendStartY(app, y, top);
            int lh2 = Canvas.FontHeight(Style.FontFallback(app, "small")) + app.Scale(6);
            for (int i = 0; i < nn; i = i + 1) {
                ForceNode nd = layout.nodes[i];
                int key = 0;
                if (o.iwid != 0) { key = Chart.LegendSliceKey(o.iwid, 0, i); }
                bool hid = false;
                if (i < nodeHid.Count) { hid = nodeHid[i]; }
                Chart.DrawLegendChip(app, lx2, ly2, legendW, lh2,
                    Chart.Palette(t, i), nd.name, hid, key);
                ly2 = ly2 + lh2;
            }
        }

        if (hoverNode >= 0) {
            ForceNode nd = layout.nodes[hoverNode];
            List<TooltipRow> rows = new List<TooltipRow>{
                TooltipRow.Of(0, o.title),
                TooltipRow.Of(Chart.Palette(t, hoverNode),
                    nd.name + "  " + Convert.ToString(nd.weight)) };
            ChartView.TooltipCard(app, app.mouseX, app.mouseY, x + w, rows);
        }
    }
}
