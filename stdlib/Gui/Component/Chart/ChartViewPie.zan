using System;
using System.Json;
using Gui;

namespace Gui.Component.Chart;

/// 饼图一个扇区（归一化后）：值、颜色、显示名、所属系列/数据项
/// 索引、角度区间 [a0,a1]（度，Canvas 顺时针，0 在 12 点）与环索引。
/// 环索引在 pieRings 模式下是可见 Pie 系列的顺序；否则恒为 0。
class PieSlice {
    int value;
    int color;
    string name;
    int seriesIndex;
    int dataIndex;
    int a0;
    int a1;
    int ring;
    bool selected;  // data.selected：静态选中，绘制时外偏 selectedOffset

    static PieSlice Of(int value, int color, string name,
                       int seriesIndex, int dataIndex, int a0, int a1, int ring) {
        PieSlice s = new PieSlice();
        s.value = value;
        s.color = color;
        s.name = name;
        s.seriesIndex = seriesIndex;
        s.dataIndex = dataIndex;
        s.a0 = a0;
        s.a1 = a1;
        s.ring = ring;
        s.selected = false;
        return s;
    }
}

/// 纯饼图布局：把可见 Pie 系列的 data 项归一化为扇区，供
/// chart_pie_layout 测试直接断言几何。语义：
///  - 每条可见 Pie series 的每个 ChartData 是一个扇区；
///  - 隐藏扇区（data.hidden 或系列 hidden）不进 total，也不占角度；
///  - pieRings=true 时每条可见系列 = 一独立环，各自计算 total
///    （各自 360°）；否则所有可见系列的扇区合并进同一张饼；
///  - 颜色解析：数据项色 > 单数据项系列的系列色 > 按扇区序调色板。
/// 不触碰 App/Canvas —— (主题, 选项) 进，扇区几何出。
class PieLayout {
    List<PieSlice> slices;
    int total;          // 非环模式：所有可见扇区值之和；环模式：各环之和
    int ringCount;      // 环数（非环模式 = 1）
    List<int> ringTotal; // 每环各自可见值之和（环模式角度分母）
    List<int> ringInner; // 每环有效内径百分比（innerPct>0 ? innerPct : donutPct）
    int rot;            // 起始边顺时针偏移（度）：90 - series.startAngle

    static PieLayout Of(Theme t, ChartOption o) {
        PieLayout l = new PieLayout();
        l.slices = new List<PieSlice>();
        l.ringTotal = new List<int>();
        l.ringInner = new List<int>();
        l.total = 0;
        l.ringCount = 0;
        l.rot = 0;

        // 可见 Pie 系列（隐藏系列不参与）。origIdx 记录其在
        // o.series 里的原始下标——扇区命中要回查该系列的 itemStyle。
        List<ChartSeries> pies = new List<ChartSeries>();
        List<int> origIdx = new List<int>();
        for (int i = 0; i < o.series.Count; i = i + 1) {
            ChartSeries s = o.series[i];
            if (!s.hidden && s.type == ChartType.Pie) {
                pies.Add(s);
                origIdx.Add(i);
            }
        }
        if (pies.Count < 1) { return l; }
        // ECharts startAngle 是数学角（0=3 点钟，逆时针），默认 90
        // 视觉上=12 点钟；本库扇区角 0=12 点钟顺时针，换算 90-值。
        l.rot = ((90 - pies[0].startAngle) % 360 + 360) % 360;

        if (o.pieRings) {
            // 每条可见系列 = 一环，各自 total。
            l.ringCount = pies.Count;
            for (int r = 0; r < pies.Count; r = r + 1) {
                ChartSeries s = pies[r];
                int inner = s.innerPct;
                if (inner <= 0) { inner = o.donutPct; }
                if (inner < 0) { inner = 0; }
                if (inner > 95) { inner = 95; }
                l.ringInner.Add(inner);
                int rt = 0;
                for (int di = 0; di < s.Count(); di = di + 1) {
                    if (!s.data[di].hidden) { rt = rt + s.Value(di); }
                }
                l.ringTotal.Add(rt);
                l.total = l.total + rt;
                if (rt < 1) { continue; }
                int acc = 0;
                for (int di2 = 0; di2 < s.Count(); di2 = di2 + 1) {
                    ChartData d = s.data[di2];
                    if (d.hidden) { continue; }
                    int v = s.Value(di2);
                    int a0 = acc * 360 / rt;
                    int a1 = (acc + v) * 360 / rt;
                    l.slices.Add(PieSlice.Of(v, PieLayout.SliceColor(t, s, di2, origIdx[r] * 16 + di2),
                        PieLayout.SliceName(s, di2), origIdx[r], di2, a0, a1, r));
                    l.slices[l.slices.Count - 1].selected = d.selected;
                    acc = acc + v;
                }
            }
            return l;
        }

        // 非环模式：合并所有可见系列的扇区，共享一个 total。
        l.ringCount = 1;
        int leadInner = 0;
        if (pies[0].innerPct > 0) { leadInner = pies[0].innerPct; }
        else { leadInner = o.donutPct; }
        if (leadInner < 0) { leadInner = 0; }
        if (leadInner > 95) { leadInner = 95; }
        l.ringInner.Add(leadInner);
        int total = 0;
        for (int p = 0; p < pies.Count; p = p + 1) {
            ChartSeries s = pies[p];
            for (int di = 0; di < s.Count(); di = di + 1) {
                if (!s.data[di].hidden) { total = total + s.Value(di); }
            }
        }
        l.ringTotal.Add(total);
        l.total = total;
        if (total < 1) { return l; }
        int acc2 = 0;
        for (int p2 = 0; p2 < pies.Count; p2 = p2 + 1) {
            ChartSeries s = pies[p2];
            for (int di2 = 0; di2 < s.Count(); di2 = di2 + 1) {
                ChartData d = s.data[di2];
                if (d.hidden) { continue; }
                int v = s.Value(di2);
                int a0 = acc2 * 360 / total;
                int a1 = (acc2 + v) * 360 / total;
                l.slices.Add(PieSlice.Of(v, PieLayout.SliceColor(t, s, di2, origIdx[p2] * 16 + di2),
                    PieLayout.SliceName(s, di2), origIdx[p2], di2, a0, a1, 0));
                l.slices[l.slices.Count - 1].selected = d.selected;
                acc2 = acc2 + v;
            }
        }
        return l;
    }

    /// 扇区颜色：数据项色 > 单数据项系列的系列色 > 按数据项下标调色板。
    /// 用 di（而不是可见扇区序）着色，图例开关后颜色不会错位。
    static int SliceColor(Theme t, ChartSeries s, int di, int sliceIndex) {
        if (di >= 0 && di < s.data.Count && s.data[di].color != 0) {
            return s.data[di].color;
        }
        if (s.data.Count <= 1 && s.color != 0) { return s.color; }
        return Chart.Palette(t, sliceIndex);
    }

    /// 扇区名：数据项名优先，其次系列名，最后回退到序号。
    static string SliceName(ChartSeries s, int di) {
        if (di >= 0 && di < s.data.Count && s.data[di].name.Length > 0) {
            return s.data[di].name;
        }
        if (s.name.Length > 0) { return s.name; }
        return "Item " + Convert.ToString(di + 1);
    }
}

partial class ChartView {
    static void DrawPie(App app, int x, int y, int w, int h,
                        ChartOption o, bool sliceLabels, int g) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int pad = t.paddingMedium;
        ChartView.ApplyDataLegend(app, o);
        int top = ChartView.PanelHead(app, x, y, w, h, o.title);
        PieLayout layout = PieLayout.Of(t, o);
        List<PieSlice> slices = layout.slices;
        int total = layout.total;
        int ringCount = layout.ringCount;
        if (ringCount < 1) { ringCount = 1; }

        int hotSi = 0 - 1;
        int hotDi = 0 - 1;
        int bodyY = top;
        if (o.showLegend) {
            int x0 = x + pad;
            int maxX = x + w - pad;
            int rowH = Canvas.FontHeight(Style.FontFallback(app, "small")) + app.Scale(6);
            int gap = app.Scale(8);
            int rowW = 0;
            int nChip = 0;
            for (int sm = 0; sm < o.series.Count; sm = sm + 1) {
                ChartSeries pm = o.series[sm];
                if (pm.type != ChartType.Pie) { continue; }
                int visM = 0;
                for (int dvm = 0; dvm < pm.data.Count; dvm = dvm + 1) {
                    if (!pm.data[dvm].hidden) { visM = visM + pm.Value(dvm); }
                }
                for (int dim = 0; dim < pm.data.Count; dim = dim + 1) {
                    string nmm = PieLayout.SliceName(pm, dim);
                    int pctM = 0;
                    if (!pm.data[dim].hidden && visM > 0) {
                        pctM = pm.Value(dim) * 100 / visM;
                    }
                    string lbm = nmm + "  " + Convert.ToString(pctM) + "%";
                    rowW = rowW + Chart.LegendChipW(app, lbm) + gap;
                    nChip = nChip + 1;
                }
            }
            if (nChip > 0) { rowW = rowW - gap; }
            int xCur = x0;
            if (nChip > 0 && rowW > 0 && rowW <= maxX - x0) {
                xCur = x0 + (maxX - x0 - rowW) / 2;
            }
            int yCur = top;
            for (int si = 0; si < o.series.Count; si = si + 1) {
                ChartSeries ps = o.series[si];
                if (ps.type != ChartType.Pie) { continue; }
                int visTot = 0;
                for (int dv = 0; dv < ps.data.Count; dv = dv + 1) {
                    if (!ps.data[dv].hidden) { visTot = visTot + ps.Value(dv); }
                }
                for (int di = 0; di < ps.data.Count; di = di + 1) {
                    int col = PieLayout.SliceColor(t, ps, di, si * 16 + di);
                    string nm = PieLayout.SliceName(ps, di);
                    bool hid = ps.data[di].hidden;
                    int pctL = 0;
                    if (!hid && visTot > 0) { pctL = ps.Value(di) * 100 / visTot; }
                    string lbl = nm + "  " + Convert.ToString(pctL) + "%";
                    int cw = Chart.LegendChipW(app, lbl);
                    if (xCur > x0 && xCur + cw > maxX) {
                        xCur = x0;
                        yCur = yCur + rowH;
                    }
                    if (app.mouseX >= xCur && app.mouseX < xCur + cw
                        && app.mouseY >= yCur && app.mouseY < yCur + rowH) {
                        hotSi = si;
                        hotDi = di;
                    }
                    int key = 0;
                    if (o.iwid != 0) { key = Chart.LegendSliceKey(o.iwid, si, di); }
                    Chart.DrawLegendChip(app, xCur, yCur, cw, rowH, col, lbl, hid, key);
                    xCur = xCur + cw + app.Scale(8);
                    bodyY = yCur + rowH + app.Scale(4);
                }
            }
        }

        int areaW = w - pad * 2;
        int areaH = (y + h - pad) - bodyY;
        int pct = 72;
        if (sliceLabels) { pct = 52; }
        if (ringCount > 1) { pct = 64; }
        int rOuter = ChartView.RadialRadius(areaW, areaH, pct);
        int cx = x + pad + areaW / 2;
        int cy = bodyY + areaH / 2;
        int sweepMax = 360 * g / 1000;
        int rot = layout.rot;

        int band = 0;
        if (ringCount > 1) { band = rOuter / ringCount; }
        if (band < app.Scale(2)) { band = app.Scale(2); }

        int hoverK = 0 - 1;
        int mx0 = app.mouseX;
        int my0 = app.mouseY;
        int dist0 = ChartView.ISqrt((mx0 - cx) * (mx0 - cx) + (my0 - cy) * (my0 - cy));
        int angR0 = ((ChartView.AngleOf(mx0 - cx, my0 - cy) - rot) % 360 + 360) % 360;
        if (my0 >= bodyY) {
            for (int kh = slices.Count - 1; kh >= 0; kh = kh - 1) {
                PieSlice sh = slices[kh];
                int ringH = sh.ring;
                if (ringH >= ringCount) { ringH = ringCount - 1; }
                if (ringH < 0) { ringH = 0; }
                int riH = rOuter - (ringH + 1) * band;
                int roH = rOuter - ringH * band;
                if (ringCount == 1 && layout.ringInner.Count > 0) {
                    riH = rOuter * layout.ringInner[0] / 100;
                    roH = rOuter;
                }
                if (riH < 0) { riH = 0; }
                if (dist0 >= riH && dist0 <= roH && angR0 >= sh.a0 && angR0 < sh.a1) {
                    hoverK = kh;
                    break;
                }
            }
        }
        if (hoverK >= 0 && o.iwid != 0
            && app.EventKind() == 3 && app.ClickFrameCurrent()
            && !app.ClickClaimed()) {
            PieSlice clk = slices[hoverK];
            if (clk.seriesIndex >= 0 && clk.seriesIndex < o.series.Count) {
                int key = Chart.PieSelKey(o.iwid, clk.seriesIndex, clk.dataIndex);
                int nv = 1;
                if (clk.selected) { nv = 0; }
                app.StateSet(key, nv);
                app.RequestRedraw();
            }
        }

        for (int k = 0; k < slices.Count; k = k + 1) {
            PieSlice sl = slices[k];
            int ring = sl.ring;
            if (ring >= ringCount) { ring = ringCount - 1; }
            if (ring < 0) { ring = 0; }
            int ri = rOuter - (ring + 1) * band;
            if (ringCount > 1 && ring == ringCount - 1 && layout.ringInner.Count > ring
                && layout.ringInner[ring] > 0) {
                // 最内环仍按配置开孔，让中心不糊成实心；但开孔不得
                // 越过本环带的内缘——默认 donutPct(55%) 在多环时会
                // 把最内环夹成空带（55% > 50%），整环消失。
                int hole = rOuter * layout.ringInner[ring] / 100;
                int holeMax = rOuter - band - app.Scale(2);
                if (holeMax < 0) { holeMax = 0; }
                if (hole > holeMax) { hole = holeMax; }
                ri = hole;
            }
            int ro = rOuter - ring * band;
            if (ringCount == 1) {
                ri = rOuter * layout.ringInner[0] / 100;
                ro = rOuter;
            }
            if (ri < 0) { ri = 0; }
            if (ri >= ro) { ri = ro - 1; }
            if (ri < 0) { ri = 0; }
            int a0 = sl.a0;
            int a1 = sl.a1;
            // 入场扫掠沿旋转后的起始边顺时针推进；扇区可见弧段
            // = [rot+a0, rot+min(a1, sweepMax)]（FillSector 自带
            // 角度回绕，>360 安全）。
            int aEnd = a1;
            if (aEnd > sweepMax) { aEnd = sweepMax; }
            // 静态选中：沿中角方向向外偏 selectedOffset 像素。
            int sx = 0;
            int sy = 0;
            bool pop = sl.selected || k == hoverK
                || (sl.seriesIndex == hotSi && sl.dataIndex == hotDi);
            if (pop && sl.seriesIndex >= 0
                && sl.seriesIndex < o.series.Count) {
                int offPx = app.Scale(o.series[sl.seriesIndex].selectedOffset);
                if (offPx < 1) { offPx = app.Scale(8); }
                int midSel = rot + (a0 + a1) / 2;
                sx = ChartView.FillDx(midSel) * offPx / 1000;
                sy = ChartView.FillDy(midSel) * offPx / 1000;
            }
            int scx = cx + sx;
            int scy = cy + sy;
            int pa0 = a0 + rot;
            int paEnd = aEnd + rot;
            if (paEnd > pa0) {
                int aHi = paEnd;
                if (aHi > pa0 + 2) { aHi = paEnd - 1; }
                c.FillSector(scx, scy, ri, ro, pa0, aHi, sl.color);
                if (pop) {
                    StrokeSector(c, scx, scy, ri, ro, pa0, aHi,
                        Chart.ContrastFg(sl.color), app.Scale(2));
                }
                if (sl.seriesIndex >= 0 && sl.seriesIndex < o.series.Count) {
                    ChartSeries bs = o.series[sl.seriesIndex];
                    if (bs.itemStyle.normal.borderWidth > 0
                        && bs.itemStyle.normal.borderColor != 0) {
                        StrokeSector(c, scx, scy, ri, ro, pa0, aHi,
                            bs.itemStyle.normal.borderColor,
                            app.Scale(bs.itemStyle.normal.borderWidth));
                    }
                }
            }
        }

        // 可选的分片百分比标签，位于扇区中角处。百分比按
        // 该片所属环的 total 计算（环模式各环独立）。
        if (sliceLabels) {
            for (int p = 0; p < slices.Count; p = p + 1) {
                PieSlice sl = slices[p];
                int ring = sl.ring;
                if (ring >= ringCount) { ring = ringCount - 1; }
                if (ring < 0) { ring = 0; }
                int ringTot = total;
                if (ring < layout.ringTotal.Count && layout.ringTotal[ring] > 0) {
                    ringTot = layout.ringTotal[ring];
                }
                int pct = sl.value * 100 / ringTot;
                // 系列级外置标签：series.label.show + labelLine（ECharts
                // 2.x 语义）。引导线两段：沿中角出弧 L1，再水平收尾；
                // 文本按左右半球锚定在水平段外侧。
                bool outerLabel = sliceLabels && ringCount == 1;
                ChartTextStyle lblStyle = null;
                if (sl.seriesIndex >= 0 && sl.seriesIndex < o.series.Count) {
                    lblStyle = o.series[sl.seriesIndex].label;
                    if (o.series[sl.seriesIndex].labelShow) { outerLabel = true; }
                }
                int lblColor = Chart.ContrastFg(sl.color);
                if (lblStyle != null && lblStyle.color != 0) { lblColor = lblStyle.color; }
                int outerFg = Style.Part(app, "chart", "label", "", "", "",
                    Style.SNormal()).FgOr(0);
                int lcx = cx;
                int lcy = cy;
                bool popL = sl.selected || p == hoverK
                    || (sl.seriesIndex == hotSi && sl.dataIndex == hotDi);
                if (popL && sl.seriesIndex >= 0
                    && sl.seriesIndex < o.series.Count) {
                    int offPx = app.Scale(o.series[sl.seriesIndex].selectedOffset);
                    if (offPx < 1) { offPx = app.Scale(8); }
                    int midPop = rot + (sl.a0 + sl.a1) / 2;
                    lcx = cx + ChartView.FillDx(midPop) * offPx / 1000;
                    lcy = cy + ChartView.FillDy(midPop) * offPx / 1000;
                }
                if (sl.a1 <= sweepMax && pct >= 4 && !outerLabel) {
                    int rLbl = 0;
                    if (ringCount > 1) {
                        rLbl = rOuter - ring * band - band / 2;
                    } else {
                        int ri0 = rOuter * layout.ringInner[0] / 100;
                        rLbl = (ri0 + rOuter) / 2;
                        if (ri0 < app.Scale(4)) { rLbl = rOuter * 62 / 100; }
                    }
                    int mid = rot + (sl.a0 + sl.a1) / 2;
                    int lxp = ChartView.FillX(lcx, rLbl, mid);
                    int lyp = ChartView.FillY(lcy, rLbl, mid);
                    string pl = Convert.ToString(pct) + "%";
                    int pw = Canvas.MeasureText(pl, Style.FontFallback(app, "small"));
                    c.DrawText(lxp - pw / 2, Canvas.CenterTextYAt(lyp, Style.FontFallback(app, "small")),
                        pl, lblColor, Style.FontFallback(app, "small"));
                } else if (sl.a1 <= sweepMax && pct >= 2 && outerLabel) {
                    int roLbl = rOuter - ring * band;
                    int midO = rot + (sl.a0 + sl.a1) / 2;
                    int dirX = ChartView.FillDx(midO);
                    int dirY = ChartView.FillDy(midO);
                    int l1 = app.Scale(12);
                    int tail = app.Scale(8);
                    int x1 = lcx + dirX * (roLbl + app.Scale(2)) / 1000;
                    int y1 = lcy + dirY * (roLbl + app.Scale(2)) / 1000;
                    int x2 = lcx + dirX * (roLbl + app.Scale(2) + l1) / 1000;
                    int y2 = lcy + dirY * (roLbl + app.Scale(2) + l1) / 1000;
                    bool rightSide = dirX >= 0;
                    int x3 = rightSide ? x2 + tail : x2 - tail;
                    c.DrawLine(x1, y1, x2, y2, sl.color, 1);
                    c.DrawLine(x2, y2, x3, y2, sl.color, 1);
                    string txt = sl.name;
                    if (txt.Length > 0) { txt = txt + " "; }
                    txt = txt + Convert.ToString(pct) + "%";
                    int tw2 = Canvas.MeasureText(txt, Style.FontFallback(app, "small"));
                    int txp = rightSide ? x3 + app.Scale(3) : x3 - app.Scale(3) - tw2;
                    if (txp < x + pad) { txp = x + pad; }
                    if (txp + tw2 > x + w - pad) { txp = x + w - pad - tw2; }
                    int fsO = Style.FontFallback(app, "small");
                    int tyo = Canvas.CenterTextYAt(y2, fsO);
                    if (tyo < bodyY) { tyo = bodyY; }
                    int tyMax = y + h - pad - Canvas.FontHeight(fsO);
                    if (tyo > tyMax) { tyo = tyMax; }
                    c.DrawText(txp, tyo, txt, outerFg, fsO);
                }
            }
        }

        // markPoint：最大/最小扇区外侧标出数值（ECharts markPoint）。
        // 不画在饼块内（与 sliceLabels 冲突），放在外径 + offset 处
        // 连一条小引线。只标两个极值避免视觉嘈杂。
        if (o.markPoint) {
            int bestI = 0 - 1;
            int worstI = 0 - 1;
            int bestV = 0 - 2147483647 - 1;
            int worstV = 2147483647;
            for (int k4 = 0; k4 < slices.Count; k4 = k4 + 1) {
                int v4 = slices[k4].value;
                if (v4 > bestV) { bestV = v4; bestI = k4; }
                if (v4 < worstV) { worstV = v4; worstI = k4; }
            }
            ChartView.DrawPieMark(app, c, cx, cy, rOuter, rot, slices, bestI, "max", t);
            ChartView.DrawPieMark(app, c, cx, cy, rOuter, rot, slices, worstI, "min", t);
        }

        // 环形图中心标注：选中扇区名优先，否则累计值。
        if (ringCount == 1 && layout.ringInner.Count > 0) {
            int centerInner = rOuter * layout.ringInner[0] / 100;
            if (centerInner > app.Scale(18) && total > 0) {
                string tot = Convert.ToString(total);
                for (int ks = 0; ks < slices.Count; ks = ks + 1) {
                    if (slices[ks].selected && slices[ks].name.Length > 0) {
                        tot = slices[ks].name;
                    }
                }
                int tw = Canvas.MeasureText(tot, Style.FontFallback(app, "large"));
                c.DrawText(cx - tw / 2, Canvas.CenterTextYAt(cy, Style.FontFallback(app, "large")),
                    tot, Style.Part(app, "chart", "value", "", "", "", Style.SNormal()).FgOr(0),
                    Style.FontFallback(app, "large"));
            }
        }

        // 图例已在饼上方横向绘制。

        if (o.showTooltip) {
            int mx = app.mouseX;
            int my = app.mouseY;
            if (my < bodyY) { return; }
            int ddx = mx - cx;
            int ddy = my - cy;
            int dist = ChartView.ISqrt(ddx * ddx + ddy * ddy);
            int ang = ChartView.AngleOf(ddx, ddy);
            // 与绘制循环同一旋转平移（同域相减，约定无关）。
            int angR = ((ang - rot) % 360 + 360) % 360;
            for (int k3 = slices.Count - 1; k3 >= 0; k3 = k3 - 1) {
                PieSlice sl = slices[k3];
                int ring = sl.ring;
                if (ring >= ringCount) { ring = ringCount - 1; }
                if (ring < 0) { ring = 0; }
                int ri = rOuter - (ring + 1) * band;
                if (ringCount > 1 && ring == ringCount - 1 && layout.ringInner.Count > ring
                    && layout.ringInner[ring] > 0) {
                    ri = rOuter * layout.ringInner[ring] / 100;
                }
                int ro = rOuter - ring * band;
                if (ringCount == 1) {
                    ri = rOuter * layout.ringInner[0] / 100;
                    ro = rOuter;
                }
                if (ri < 0) { ri = 0; }
                if (dist >= ri && dist <= ro && angR >= sl.a0 && angR < sl.a1) {
                    int ringTot = total;
                    if (ring < layout.ringTotal.Count && layout.ringTotal[ring] > 0) {
                        ringTot = layout.ringTotal[ring];
                    }
                    // emphasis 高亮：命中扇区按强调色重画（覆盖普通
                    // 绘制，不改写源系列），再按配置描强调边框。
                    // 角度与绘制循环同域：rot 平移 + 原生角。
                    if (sl.seriesIndex >= 0 && sl.seriesIndex < o.series.Count) {
                        ChartSeries hs2 = o.series[sl.seriesIndex];
                        int hiFill = sl.color;
                        if (hs2.itemStyle.emphasis.color != 0) {
                            hiFill = hs2.itemStyle.emphasis.color;
                        }
                        int aEnd2 = sl.a1;
                        if (aEnd2 > sweepMax) { aEnd2 = sweepMax; }
                        if (aEnd2 > sl.a0 && hs2.itemStyle.emphasis.color != 0) {
                            int offH = app.Scale(hs2.selectedOffset);
                            if (offH < 1) { offH = app.Scale(8); }
                            int midH = rot + (sl.a0 + sl.a1) / 2;
                            int hcx = cx + ChartView.FillDx(midH) * offH / 1000;
                            int hcy = cy + ChartView.FillDy(midH) * offH / 1000;
                            c.FillSector(hcx, hcy, ri, ro,
                                rot + sl.a0, rot + aEnd2, hiFill);
                            int bc = hs2.itemStyle.emphasis.borderColor;
                            int bw2 = hs2.itemStyle.emphasis.borderWidth;
                            if (bc == 0) { bc = hs2.itemStyle.normal.borderColor; }
                            if (bw2 <= 0) { bw2 = hs2.itemStyle.normal.borderWidth; }
                            StrokeSector(c, hcx, hcy, ri, ro,
                                rot + sl.a0, rot + aEnd2, bc,
                                app.Scale(bw2));
                        }
                    }
                    int pct3 = sl.value * 100 / ringTot;
                    List<TooltipRow> rows = new List<TooltipRow>{
                        TooltipRow.Of(0, o.title),
                        TooltipRow.Of(sl.color,
                            sl.name + "  " + Convert.ToString(sl.value)
                            + "  (" + Convert.ToString(pct3) + "%)") };
                    ChartView.TooltipCard(app, mx, my, x + w, rows);
                    break;
                }
            }
        }
    }
    // ---- 仪表盘（每序列一个表盘；Canvas 角度顺时针） ----

    static int GaugeSweep(GaugeOption gauge) {
        int sweep = gauge.startAngle - gauge.endAngle;
        while (sweep <= 0) { sweep = sweep + 360; }
        if (sweep > 360) { sweep = 360; }
        return sweep;
    }

    static int GaugeStart(GaugeOption gauge) {
        int start = 90 - gauge.startAngle;
        while (start < 0) { start = start + 360; }
        while (start >= 360) { start = start - 360; }
        return start;
    }

    static int GaugeScalar(App app, ChartScalar scalar, int extent) {
        if (scalar.percent) { return extent * scalar.amount / 100; }
        return app.Scale(scalar.amount);
    }

    // FillSector 以 12 点钟方向为 0 度并顺时针递增。保持
    // 仪表盘的矢量几何处于同一坐标系。
    static int GaugeX(int angle) { return ChartView.SinDeg(angle); }
    static int GaugeY(int angle) { return 0 - ChartView.CosDeg(angle); }

    static void GaugeSector(Canvas c, int cx, int cy, int inner, int outer,
                            int start, int sweep, int color) {
        if (sweep <= 0 || outer <= inner) { return; }
        while (start < 0) { start = start + 360; }
        while (start >= 360) { start = start - 360; }
        int first = sweep;
        if (start + first > 360) { first = 360 - start; }
        if (first > 0) { c.FillSector(cx, cy, inner, outer, start, start + first, color); }
        int rest = sweep - first;
        if (rest > 0) { c.FillSector(cx, cy, inner, outer, 0, rest, color); }
    }

    static int GaugeColor(GaugeOption gauge, int perMille) {
        for (int i = 0; i < gauge.axisLine.colors.Count; i = i + 1) {
            GaugeColorStop stop = gauge.axisLine.colors[i];
            if (perMille <= stop.stop) { return stop.color; }
        }
        if (gauge.axisLine.colors.Count > 0) {
            return gauge.axisLine.colors[gauge.axisLine.colors.Count - 1].color;
        }
        return 0;
    }

    /// 仪表文字大小：表盘的标签、标题和读数按表盘定尺寸，
    /// 而非窗口。固定 px 字号（ECharts 的 30px detail）只在
    /// demo 的表盘尺寸下合适 —— 小卡片上同样字号会盖住
    /// 刻度标签并溢出圆弧，这正是此前
    /// 仪表与参照完全不像的原因。`permilleOfRadius` 把
    /// 请求字号限制在半径的一定比例内。
    static int GaugeFont(App app, int requested, int fallback, int radius,
                         int permilleOfRadius) {
        int size = fallback;
        if (requested > 0) { size = app.Scale(requested); }
        int cap = radius * permilleOfRadius / 1000;
        if (cap < 8) { cap = 8; }
        if (size > cap) { size = cap; }
        if (size < 8) { size = 8; }
        return size;
    }

    static void DrawGauge(App app, int x, int y, int w, int h,
                          ChartOption o, int g) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int pad = t.paddingMedium;
        int top = ChartView.PanelHead(app, x, y, w, h, o.title);
        int bodyX = x + pad;
        int bodyY = top;
        int bodyW = w - pad * 2;
        int bodyH = y + h - pad - top;
        int baseSize = bodyW;
        if (bodyH < baseSize) { baseSize = bodyH; }
        for (int si = 0; si < o.series.Count; si = si + 1) {
            ChartSeries s = o.series[si];
            if (!s.hidden && s.type == ChartType.Gauge) {
                GaugeOption gauge = s.gauge;
                int min = gauge.min;
                int max = gauge.max;
                double rawVal = (double)min;
                if (s.Count() > 0) { rawVal = s.Number(0); }
                if (rawVal < (double)min) { rawVal = (double)min; }
                if (rawVal > (double)max) { rawVal = (double)max; }
                int val = (int)rawVal;
                int span = max - min;
                if (span < 1) { span = 1; }
                int perMille = (int)((rawVal - (double)min) * 1000.0 / (double)span);
                int startAngle = ChartView.GaugeStart(gauge);
                int sweep = ChartView.GaugeSweep(gauge);
                int cx = bodyX + ChartView.GaugeScalar(app, gauge.center.x, bodyW);
                int cy = bodyY + ChartView.GaugeScalar(app, gauge.center.y, bodyH);
                int radius = ChartView.GaugeScalar(app, gauge.radius, baseSize / 2);
                if (radius < app.Scale(12)) { radius = app.Scale(12); }
                int axisW = app.Scale(gauge.axisLine.lineStyle.width);
                if (axisW < 1) { axisW = 1; }
                // innerRadius（环形仪表）：轴带从内半径铺到外半径；
                // 未设置（0）时退化为外缘轴宽带。
                int innerR = ChartView.GaugeScalar(app, gauge.innerRadius, radius);
                if (innerR < 0) { innerR = 0; }
                int bandInner = radius - axisW;
                if (bandInner < innerR) { bandInner = innerR; }

                if (gauge.axisLine.show) {
                    int prev = 0;
                    for (int stops = 0; stops < gauge.axisLine.colors.Count; stops = stops + 1) {
                        GaugeColorStop colorStop = gauge.axisLine.colors[stops];
                        int stop = colorStop.stop;
                        int col = colorStop.color;
                        if (stop < prev) { stop = prev; }
                        if (stop > 1000) { stop = 1000; }
                        int segStart = startAngle + sweep * prev / 1000;
                        int segSweep = sweep * (stop - prev) / 1000;
                        int grown = sweep * g / 1000;
                        int rel = segStart - startAngle;
                        if (rel < grown) {
                            if (rel + segSweep > grown) { segSweep = grown - rel; }
                            ChartView.GaugeSector(c, cx, cy, bandInner, radius,
                                segStart, segSweep, col);
                        }
                        prev = stop;
                    }
                }

                if ((gauge.axisTick.show || gauge.splitLine.show) && gauge.splitNumber > 0) {
                    int minor = gauge.axisTick.splitNumber;
                    if (minor < 1) { minor = 1; }
                    int totalTicks = gauge.splitNumber * minor;
                    for (int ti = 0; ti <= totalTicks; ti = ti + 1) {
                        bool major = ti % minor == 0;
                        int len = app.Scale(gauge.axisTick.length);
                        int thick = app.Scale(gauge.axisTick.lineStyle.width);
                        int tickColor = gauge.axisTick.lineStyle.color;
                        bool showTick = gauge.axisTick.show;
                        if (major) {
                            len = app.Scale(gauge.splitLine.length);
                            thick = app.Scale(gauge.splitLine.lineStyle.width);
                            tickColor = gauge.splitLine.lineStyle.color;
                            showTick = gauge.splitLine.show;
                        }
                        int ang = startAngle + sweep * ti / totalTicks;
                        int x0 = cx + ChartView.GaugeX(ang) * (radius - axisW) / 1000;
                        int y0 = cy + ChartView.GaugeY(ang) * (radius - axisW) / 1000;
                        int x1 = cx + ChartView.GaugeX(ang) * (radius - axisW - len) / 1000;
                        int y1 = cy + ChartView.GaugeY(ang) * (radius - axisW - len) / 1000;
                        if (showTick) { c.DrawLine(x0, y0, x1, y1, tickColor, thick); }
                    }
                }

                if (gauge.axisLabel.show && gauge.splitNumber > 0) {
                    for (int li = 0; li <= gauge.splitNumber; li = li + 1) {
                        int ang2 = startAngle + sweep * li / gauge.splitNumber;
                        int lv = min + span * li / gauge.splitNumber;
                        string ls = Convert.ToString(lv);
                        if (gauge.axisLabel.formatter.Length > 0) {
                            ls = gauge.axisLabel.formatter.Replace("{value}", ls);
                        }
                        int labelSize = ChartView.GaugeFont(app,
                            gauge.axisLabel.textStyle.fontSize, Style.FontFallback(app, "small"),
                            radius, 150);
                        // 标签紧贴分隔线内侧。钳制环半径
                        // 可在表盘小到刻度 + 间隙几乎占据整个
                        // 半径时，避免标签与标题/读数
                        // 重叠。
                        int lr = radius - axisW - app.Scale(gauge.splitLine.length)
                            - labelSize;
                        int lrMin = radius * 55 / 100;
                        if (lr < lrMin) { lr = lrMin; }
                        int labelColor = gauge.axisLabel.textStyle.color;
                        if (labelColor == 0) {
                            labelColor = Style.Part(app, "chart", "hint", "", "", "", Style.SNormal()).FgOr(0);
                        }
                        int lx = cx + ChartView.GaugeX(ang2) * lr / 1000;
                        int ly = cy + ChartView.GaugeY(ang2) * lr / 1000;
                        c.DrawText(lx - Canvas.MeasureText(ls, labelSize) / 2,
                            Canvas.CenterTextYAt(ly, labelSize),
                            ls, labelColor, labelSize);
                    }
                }

                int valueSweep = sweep * perMille / 1000;
                valueSweep = valueSweep * g / 1000;
                int pointerAngle = startAngle + valueSweep;
                int pointerR = ChartView.GaugeScalar(app, gauge.pointer.length, radius);
                int px = cx + ChartView.GaugeX(pointerAngle) * pointerR / 1000;
                int py = cy + ChartView.GaugeY(pointerAngle) * pointerR / 1000;
                int pointerColor = gauge.pointer.color;
                if (pointerColor == 0) { pointerColor = s.color; }
                if (pointerColor == 0) { pointerColor = ChartView.GaugeColor(gauge, perMille); }
                // ECharts 指针：细长矛头形，轮毂处最宽，
                // 尖端收成一点。以一系列抗锯齿圆盘光栅化成锥体，
                // 主体无空隙、边缘平滑
                // —— 逐行垂直扫描线会留下可见的
                // 对角网格，而在数值角对面绘制尾翼
                // 会产生从表盘远侧刺出的尖刺。
                int halfPointerW = app.Scale(gauge.pointer.width) / 2;
                if (halfPointerW < 1) { halfPointerW = 1; }
                if (pointerR > 0) {
                    int ux = ChartView.GaugeX(pointerAngle);
                    int uy = ChartView.GaugeY(pointerAngle);
                    // 指针阴影：沿指针方向有限偏移的合成圆盘
                    // （无真实模糊，确定性）。
                    if (gauge.pointer.shadowBlur > 0 && gauge.pointer.shadowColor != 0) {
                        int soff = app.Scale(gauge.pointer.shadowBlur);
                        if (soff < 1) { soff = 1; }
                        if (soff > radius / 3) { soff = radius / 3; }
                        int pmx = cx + ux * pointerR / 2 / 1000;
                        int pmy = cy + uy * pointerR / 2 / 1000;
                        c.FillCircle(pmx + ux * soff / 1000, pmy + uy * soff / 1000,
                            halfPointerW * 2 / 3 + 1,
                            Chart.WithAlpha(gauge.pointer.shadowColor, 120));
                    }
                    int tail = halfPointerW;
                    int step = 0 - tail;
                    while (step <= pointerR) {
                        int rr;
                        if (step < 0) { rr = halfPointerW * (tail + step) / tail; }
                        else { rr = halfPointerW * (pointerR - step) / pointerR; }
                        if (rr < 1) { rr = 1; }
                        int ax = cx + ux * step / 1000;
                        int ay = cy + uy * step / 1000;
                        c.FillCircle(ax, ay, rr, pointerColor);
                        step = step + 1;
                    }
                    c.FillCircle(cx, cy, halfPointerW + app.Scale(1), pointerColor);
                }

                string titleText = s.name;
                if (s.data.Count > 0 && s.data[0].name.Length > 0) {
                    titleText = s.data[0].name;
                }
                int titleSize = ChartView.GaugeFont(app,
                    gauge.title.textStyle.fontSize, Style.FontFallback(app, "small"),
                    radius, 180);
                int titleBottom = cy
                    + ChartView.GaugeScalar(app, gauge.title.offsetCenter.y, radius)
                    + titleSize / 2;
                bool titleDrawn = gauge.title.show && titleText.Length > 0;
                if (titleDrawn) {
                    int titleColor = gauge.title.textStyle.color;
                    if (titleColor == 0) {
                        titleColor = Style.Part(app, "chart", "label", "", "", "", Style.SNormal()).FgOr(0);
                    }
                    int tx = cx + ChartView.GaugeScalar(app, gauge.title.offsetCenter.x, radius);
                    int ty = titleBottom - titleSize / 2;
                    c.DrawText(tx - Canvas.MeasureText(titleText, titleSize) / 2,
                        Canvas.CenterTextY(ty - titleSize / 2, titleSize, titleSize),
                        titleText, titleColor, titleSize);
                }
                if (gauge.detail.show) {
                    string detail = gauge.detail.formatter;
                    if (detail.Length == 0) { detail = "{value}"; }
                    string valueText = Convert.ToString(val);
                    if (gauge.precision > 0) {
                        valueText = Chart.FormatFixed(rawVal, gauge.precision);
                    } else if (rawVal != (double)val) {
                        valueText = Convert.ToString(rawVal);
                    }
                    detail = detail.Replace("{value}", valueText);
                    int detailSize = ChartView.GaugeFont(app,
                        gauge.detail.textStyle.fontSize, Style.FontFallback(app, "large"),
                        radius, 300);
                    int detailColor = gauge.detail.textStyle.color;
                    if (detailColor == 0) {
                        detailColor = Style.Part(app, "chart", "value", "", "", "", Style.SNormal()).FgOr(0);
                    }
                    int dx = cx + ChartView.GaugeScalar(app, gauge.detail.offsetCenter.x, radius);
                    int dy = cy + ChartView.GaugeScalar(app, gauge.detail.offsetCenter.y, radius);
                    // 读数与上方的名称保持间距：两个偏移
                    // 都相对同一圆心，小表盘上配置的
                    // 20%/40% 环间距会小于两者的
                    // 字形高度，导致文字互相重叠。
                    int detailTopMin = titleBottom + app.Scale(2) + detailSize / 2;
                    if (titleDrawn && dy < detailTopMin) { dy = detailTopMin; }
                    // 读数背景 + 边框（detail.backgroundColor / borderColor /
                    // borderWidth / width / height；0 宽度/透明背景则无框）。
                    int dTextW = Canvas.MeasureText(detail, detailSize);
                    int boxW = app.Scale(gauge.detail.width);
                    if (dTextW + app.Scale(10) > boxW) { boxW = dTextW + app.Scale(10); }
                    int boxH = app.Scale(gauge.detail.height);
                    if (detailSize + app.Scale(6) > boxH) { boxH = detailSize + app.Scale(6); }
                    int bx = dx - boxW / 2;
                    int by = dy - boxH / 2;
                    if (gauge.detail.backgroundColor != 0) {
                        c.FillRoundRect(bx, by, boxW, boxH, t.borderRadiusSmall,
                            gauge.detail.backgroundColor);
                    }
                    if (gauge.detail.borderWidth > 0) {
                        c.DrawRoundRect(bx, by, boxW, boxH, t.borderRadiusSmall,
                            gauge.detail.borderColor, app.Scale(gauge.detail.borderWidth));
                    }
                    c.DrawText(dx - Canvas.MeasureText(detail, detailSize) / 2,
                        Canvas.CenterTextY(dy - detailSize / 2, detailSize, detailSize),
                        detail, detailColor, detailSize);
                }
            }
        }

        if (o.showTooltip) {
            int mx = app.mouseX;
            int my = app.mouseY;
            int hit = o.series.Count - 1;
            while (hit >= 0) {
                ChartSeries hs = o.series[hit];
                if (!hs.hidden && hs.type == ChartType.Gauge) {
                    GaugeOption hitGauge = hs.gauge;
                    int hcx = bodyX + ChartView.GaugeScalar(app, hitGauge.center.x, bodyW);
                    int hcy = bodyY + ChartView.GaugeScalar(app, hitGauge.center.y, bodyH);
                    int hr = ChartView.GaugeScalar(app, hitGauge.radius, baseSize / 2);
                    int ddx = mx - hcx;
                    int ddy = my - hcy;
                    if (ChartView.ISqrt(ddx * ddx + ddy * ddy) <= hr) {
                        double hitRaw = (double)hitGauge.min;
                        if (hs.Count() > 0) { hitRaw = hs.Number(0); }
                        string hitValue = Convert.ToString((int)hitRaw);
                        if (hitGauge.precision > 0 || hitRaw != (double)((int)hitRaw)) {
                            hitValue = Convert.ToString(hitRaw);
                        }
                        List<TooltipRow> rows = new List<TooltipRow>();
                        rows.Add(TooltipRow.Of(0, o.title));
                        string hitDetail = hitGauge.detail.formatter;
                        if (hitDetail.Length == 0) { hitDetail = "{value}"; }
                        hitDetail = hitDetail.Replace("{value}", hitValue);
                        rows.Add(TooltipRow.Of(hs.color, hs.name + "  " + hitDetail
                            + "  [" + Convert.ToString(hitGauge.min) + ", " + Convert.ToString(hitGauge.max) + "]"));
                        ChartView.TooltipCard(app, mx, my, x + w, rows);
                        break;
                    }
                }
                hit = hit - 1;
            }
        }
    }

    // ---- 径向柱状图（同心进度环；扫掠角随 g 增长） ----

    static void DrawRadialBars(App app, int x, int y, int w, int h,
                               ChartOption o, int g) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int pad = t.paddingMedium;
        int top = ChartView.PanelHead(app, x, y, w, h, o.title);

        int max = o.gaugeMax;
        if (max <= 0) { max = 100; }
        int n = o.series.Count;
        if (n < 1) { return; }

        int legendW = app.Scale(120);
        int areaW = w - pad * 2 - legendW;
        int areaH = (y + h - pad) - top;
        int rMax = areaW / 2;
        if (areaH / 2 < rMax) { rMax = areaH / 2; }
        if (rMax < app.Scale(20)) { rMax = app.Scale(20); }
        int cx = x + pad + areaW / 2;
        int cy = top + areaH / 2;

        int band = rMax * 78 / 100 / n;
        int gap = app.Scale(3);
        if (gap > band / 3) { gap = band / 3; }
        for (int i = 0; i < n; i = i + 1) {
            ChartSeries ring = o.series[i];
            int ringOuter = rMax - i * band;
            int ringInner = ringOuter - band + gap;
            if (ringInner < 0) { ringInner = 0; }
            int val = 0;
            if (o.series[i].Count() > 0) { val = o.series[i].Value(0); }
            if (val < 0) { val = 0; }
            if (val > max) { val = max; }
            c.FillSector(cx, cy, ringInner, ringOuter, 0, 360,
                Style.Part(app, "chart", "cell", "", "", "", Style.SNormal()).BgOr(0));
            int sweep = 360 * val / max;
            sweep = sweep * g / 1000;
            if (sweep > 0) {
                c.FillSector(cx, cy, ringInner, ringOuter, 0, sweep, o.series[i].color);
            }
        }

        // 图例：色块 + 名称 + 值。
        int lx = x + w - pad - legendW;
        int ly = Chart.LegendStartY(app, y, top);
        int sw = app.Scale(12);
        int lh = Canvas.FontHeight(Style.FontFallback(app, "small")) + app.Scale(6);
        for (int j = 0; j < n; j = j + 1) {
            int val = 0;
            if (o.series[j].Count() > 0) { val = o.series[j].Value(0); }
            c.FillRoundRect(lx, ly + app.Scale(2), sw, sw, t.borderRadiusSmall, o.series[j].color);
            string lbl = o.series[j].name + "  " + Convert.ToString(val);
            c.DrawText(lx + sw + app.Scale(6), ly + app.Scale(1), lbl,
                Style.Part(app, "chart", "label", "", "", "", Style.SNormal()).FgOr(0),
                Style.FontFallback(app, "small"));
            ly = ly + lh;
        }

        if (o.showTooltip) {
            int mx = app.mouseX;
            int my = app.mouseY;
            int ddx = mx - cx;
            int ddy = my - cy;
            int dist = ChartView.ISqrt(ddx * ddx + ddy * ddy);
            for (int i2 = 0; i2 < n; i2 = i2 + 1) {
                int ringOuter = rMax - i2 * band;
                int ringInner = ringOuter - band + gap;
                if (ringInner < 0) { ringInner = 0; }
                if (dist >= ringInner && dist <= ringOuter) {
                    int v2 = 0;
                    if (o.series[i2].Count() > 0) { v2 = o.series[i2].Value(0); }
                    List<TooltipRow> rows = new List<TooltipRow>{
                        TooltipRow.Of(0, o.title),
                        TooltipRow.Of(o.series[i2].color,
                            o.series[i2].name + "  " + Convert.ToString(v2)
                            + " / " + Convert.ToString(max)) };
                    ChartView.TooltipCard(app, mx, my, x + w, rows);
                    break;
                }
            }
        }
    }

    // ---- 热力图（行=序列，列=数值索引；强度随 g 渐显） ----
    // 收集漏斗/金字塔/玫瑰图各阶段：每阶段一个值+颜色+名称，来源为
    // 多个单值序列或一个多值序列。
    static List<ChartStage> GatherStages(App app, List<ChartSeries> series) {
        Theme t = app.theme;
        List<ChartStage> stages = new List<ChartStage>();
        // 过滤隐藏系列——legend toggle 隐藏后立即不画（重绘时
        // GatherStages 在 DrawFunnel/DrawRose 入口被调用，stage
        // 集合随 hidden 同步缩放）。
        if (series.Count > 1) {
            for (int i = 0; i < series.Count; i = i + 1) {
                if (series[i].hidden) { continue; }
                int v = 0;
                if (series[i].Count() > 0) { v = series[i].Value(0); }
                int col = series[i].color;
                if (col == 0) { col = Chart.Palette(t, i); }
                stages.Add(new ChartStage(v, col, series[i].name, i));
            }
        } else if (series.Count == 1) {
            int n = series[0].Count();
            for (int i = 0; i < n; i = i + 1) {
                if (series[0].data[i].hidden) { continue; }
                int col = Chart.Palette(t, i);
                if (series[0].data[i].color != 0) { col = series[0].data[i].color; }
                string nm = series[0].data[i].name;
                ChartStage st = new ChartStage(series[0].Value(i), col, nm, 0);
                st.dataIndex = i;
                stages.Add(st);
            }
        }
        return stages;
    }

    // ---- 漏斗图 / 金字塔图 ----

    static void DrawFunnel(App app, int x, int y, int w, int h,
                           ChartOption o, int g, bool pyramid) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int pad = t.paddingMedium;
        int top = ChartView.PanelHead(app, x, y, w, h, o.title);

        ChartView.ApplyDataLegend(app, o);
        List<ChartStage> stages = ChartView.GatherStages(app, o.series);
        int n = stages.Count;
        int legendW = 0;
        if (o.showLegend) { legendW = app.Scale(120); }
        if (n < 1) {
            if (o.showLegend) {
                ChartView.DrawStageLegend(app, o, x + w - pad - legendW,
                    Chart.LegendStartY(app, y, top), legendW);
            }
            return;
        }
        int maxV = 1;
        foreach (ChartStage st in stages) { if (st.val > maxV) { maxV = st.val; } }

        // 系列级参数（首系列承载）：funnelAlign 三态、层间隙 px、
        // 转化率百分比（ECharts funnel.funnelAlign / gap / label.formatter）。
        ChartSeries fs0 = ChartView.LeadSeries(o);
        string fAlign = "";
        int fGap = 0 - 1;
        bool fPct = false;
        if (fs0 != null) {
            fAlign = fs0.funnelAlign;
            fGap = fs0.funnelGap;
            fPct = fs0.funnelPercent;
        }
        int areaW = w - pad * 2 - legendW;
        int areaH = (y + h - pad) - top;
        int cx = x + pad + areaW / 2;
        if (fAlign == "left") { cx = x + pad; }
        else if (fAlign == "right") { cx = x + pad + areaW; }
        int gapPx = app.Scale(3);
        if (fGap >= 0) { gapPx = app.Scale(fGap); }
        int rowH = areaH / n;

        for (int i2 = 0; i2 < n; i2 = i2 + 1) {
            int idx = i2;
            if (pyramid) { idx = n - 1 - i2; }
            int vTop = stages[idx].val;
            int vBot = vTop;
            int nextIdx = idx + 1;
            if (pyramid) { nextIdx = idx - 1; }
            if (nextIdx >= 0 && nextIdx < n) { vBot = stages[nextIdx].val; }
            int wTop = vTop * areaW / maxV * g / 1000;
            int wBot = vBot * areaW / maxV * g / 1000;
            int ry = top + i2 * rowH;
            int col = stages[idx].color;
            int strip = rowH - gapPx;
            int wTopF = wTop * 256;      // 1/256 px，使斜边获得
            int wBotF = wBot * 256;      // 亚像素覆盖率而非阶梯状
            int cxF = cx * 256;
            for (int r = 0; r < strip; r = r + 1) {
                int tt = 0;
                if (strip > 0) { tt = r * 1000 / strip; }
                int wwF = wTopF + (wBotF - wTopF) * tt / 1000;
                int xlF = cxF - wwF / 2;
                int xrF = xlF + wwF;
                int xl = xlF / 256;
                if (xlF < 0) { xl = (xlF - 255) / 256; }
                int xr = (xrF + 255) / 256;
                int yRow = ry + r;
                // 边缘像素获得小数覆盖率；内部行保持
                // 实心，使倾斜轮廓平滑而非
                // 锯齿。左侧覆盖率 = 像素 xl 的右缘减去
                // 形状左边界；右侧覆盖率 = 形状右
                // 边界减去像素 xr-1 的左缘。
                int lcov = (xl + 1) * 256 - xlF;
                if (lcov >= 256) { c.FillRect(xl, yRow, 1, 1, col); }
                else if (lcov > 0) { c.FillRect(xl, yRow, 1, 1, Chart.WithAlpha(col, lcov)); }
                int m0 = xl + 1;
                int m1 = xr - 1;         // 实心中间段（不含端点）
                if (m1 > m0) { c.FillRect(m0, yRow, m1 - m0, 1, col); }
                int rcov = xrF - (xr - 1) * 256;
                if (rcov >= 256) { c.FillRect(xr - 1, yRow, 1, 1, col); }
                else if (rcov > 0) { c.FillRect(xr - 1, yRow, 1, 1, Chart.WithAlpha(col, rcov)); }
            }
            string lbl = stages[idx].name;
            if (lbl.Length == 0) { lbl = Convert.ToString(stages[idx].val); }
            if (fPct) { lbl = lbl + ChartView.FunnelPct(stages, idx); }
            c.DrawTextCentered(cx - areaW / 2, ry + rowH / 2 - Canvas.FontHeight(Style.FontFallback(app, "small")) / 2,
                areaW, Canvas.FontHeight(Style.FontFallback(app, "small")), lbl,
                Style.Part(app, "chart", "value", "", "", "", Style.SNormal()).FgOr(0),
                Style.FontFallback(app, "small"));
        }

        if (o.showLegend) {
            int lx = x + w - pad - legendW;
            int ly = Chart.LegendStartY(app, y, top);
            ChartView.DrawStageLegend(app, o, lx, ly, legendW);
        }

        if (o.showTooltip) {
            int mx = app.mouseX;
            int my = app.mouseY;
            if (mx >= x + pad && mx < x + w - pad - legendW
                && my >= top && my < y + h - pad) {
                int idx = (my - top) / rowH;
                if (idx < 0) { idx = 0; }
                if (idx > n - 1) { idx = n - 1; }
                ChartStage st = stages[idx];
                string nm = st.name;
                if (nm.Length == 0) { nm = ChartView.StageName(idx); }
                // axisPointer 漏斗版：行中线处 1px 横线（数据带外
                // 缘 + 1px 指示线）+ 行号 chip（与 CartesianTooltip
                // 的 axis label 等价）。径向无法画纵线故不画。
                int cy = top + idx * rowH + rowH / 2;
                int crossCol = Style.Part(app, "chart", "crosshair", "", "",
                    "", Style.SNormal()).BgOr(0);
                c.FillRect(x + pad, cy, x + w - pad - legendW - (x + pad), 1,
                    Chart.WithAlpha(crossCol, 200));
                string lblF = nm + "  " + Convert.ToString(st.val);
                if (fPct) { lblF = lblF + ChartView.FunnelPct(stages, idx); }
                int fs = Style.FontFallback(app, "small");
                int lw = Canvas.MeasureText(lblF, fs);
                int labelX = x + pad - lw - app.Scale(6);
                if (labelX < 0) { labelX = 0; }
                int labelY = cy - Canvas.FontHeight(fs) / 2;
                c.FillRoundRect(labelX - app.Scale(2), labelY, lw + app.Scale(4),
                    Canvas.FontHeight(fs), app.Scale(2), crossCol);
c.DrawText(labelX, labelY, lblF, Style.Part(app, "chart",
                    "crosshair-label", "", "", "", Style.SNormal()).FgOr(crossCol), fs);
                List<TooltipRow> rows = new List<TooltipRow>{
                    TooltipRow.Of(0, o.title),
                    TooltipRow.Of(st.color, nm + "  " + Convert.ToString(st.val)
                        + (fPct ? ChartView.FunnelPct(stages, idx) : "")) };
                ChartView.TooltipCard(app, mx, my, x + w, rows);
            }
        }
    }

    static string StageName(int i) { return "Stage " + Convert.ToString(i + 1); }

    /// 转化率（ECharts funnel 的逐层转化）：相对上一阶段的百分比
    /// 后缀 " (x%)"；顶层恒 100%；除零返回空串。
    static string FunnelPct(List<ChartStage> stages, int idx) {
        if (idx == 0) { return " (100%)"; }
        if (idx < 1 || idx >= stages.Count) { return ""; }
        int prev = stages[idx - 1].val;
        if (prev < 1) { return ""; }
        return " (" + Convert.ToString(stages[idx].val * 100 / prev) + "%)";
    }

    static int DrawStageLegendWrap(App app, ChartOption o, int x, int y, int w, int top) {
        int pad = app.theme.paddingMedium;
        int x0 = x + pad;
        int xCur = x0;
        int yCur = top;
        int maxX = x + w - pad;
        int rowH = Canvas.FontHeight(Style.FontFallback(app, "small")) + app.Scale(6);
        int bodyY = top;
        Theme t = app.theme;
        if (o.series.Count > 1) {
            for (int si = 0; si < o.series.Count; si = si + 1) {
                ChartSeries s = o.series[si];
                int col = s.color;
                if (col == 0) { col = Chart.Palette(t, si); }
                string nm = s.name;
                if (nm.Length == 0) { nm = ChartView.StageName(si); }
                int v = 0;
                if (s.Count() > 0) { v = s.Value(0); }
                string lbl = nm + "  " + Convert.ToString(v);
                int cw = Chart.LegendChipW(app, lbl);
                if (xCur > x0 && xCur + cw > maxX) {
                    xCur = x0;
                    yCur = yCur + rowH;
                }
                int key = 0;
                if (o.iwid != 0) { key = Chart.LegendKey(o.iwid, si); }
                Chart.DrawLegendChip(app, xCur, yCur, cw, rowH, col, lbl, s.hidden, key);
                xCur = xCur + cw;
                bodyY = yCur + rowH + app.Scale(4);
            }
        } else if (o.series.Count == 1) {
            ChartSeries s = o.series[0];
            for (int di = 0; di < s.data.Count; di = di + 1) {
                int col = Chart.Palette(t, di);
                if (s.data[di].color != 0) { col = s.data[di].color; }
                string nm = s.data[di].name;
                if (nm.Length == 0) { nm = ChartView.StageName(di); }
                string lbl = nm + "  " + Convert.ToString(s.Value(di));
                int cw = Chart.LegendChipW(app, lbl);
                if (xCur > x0 && xCur + cw > maxX) {
                    xCur = x0;
                    yCur = yCur + rowH;
                }
                int key = 0;
                if (o.iwid != 0) { key = Chart.LegendSliceKey(o.iwid, 0, di); }
                Chart.DrawLegendChip(app, xCur, yCur, cw, rowH, col, lbl,
                    s.data[di].hidden, key);
                xCur = xCur + cw;
                bodyY = yCur + rowH + app.Scale(4);
            }
        }
        return bodyY;
    }

    static void DrawStageLegend(App app, ChartOption o, int lx, int ly, int legendW) {
        Theme t = app.theme;
        int lh = Canvas.FontHeight(Style.FontFallback(app, "small")) + app.Scale(6);
        if (o.series.Count > 1) {
            for (int si = 0; si < o.series.Count; si = si + 1) {
                ChartSeries s = o.series[si];
                int col = s.color;
                if (col == 0) { col = Chart.Palette(t, si); }
                string nm = s.name;
                if (nm.Length == 0) { nm = ChartView.StageName(si); }
                int v = 0;
                if (s.Count() > 0) { v = s.Value(0); }
                int key = 0;
                if (o.iwid != 0) { key = Chart.LegendKey(o.iwid, si); }
                Chart.DrawLegendChip(app, lx, ly, legendW, lh, col,
                    nm + "  " + Convert.ToString(v), s.hidden, key);
                ly = ly + lh;
            }
        } else if (o.series.Count == 1) {
            ChartSeries s = o.series[0];
            for (int di = 0; di < s.data.Count; di = di + 1) {
                int col = Chart.Palette(t, di);
                if (s.data[di].color != 0) { col = s.data[di].color; }
                string nm = s.data[di].name;
                if (nm.Length == 0) { nm = ChartView.StageName(di); }
                int key = 0;
                if (o.iwid != 0) { key = Chart.LegendSliceKey(o.iwid, 0, di); }
                Chart.DrawLegendChip(app, lx, ly, legendW, lh, col,
                    nm + "  " + Convert.ToString(s.Value(di)),
                    s.data[di].hidden, key);
                ly = ly + lh;
            }
        }
    }

    // ---- 玫瑰图 / 南丁格尔图（等角，半径按值） ----

    static void DrawRose(App app, int x, int y, int w, int h,
                         ChartOption o, int g) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int pad = t.paddingMedium;
        int top = ChartView.PanelHead(app, x, y, w, h, o.title);

        ChartView.ApplyDataLegend(app, o);
        List<ChartStage> stages = ChartView.GatherStages(app, o.series);
        int n = stages.Count;
        int bodyY = top;
        if (o.showLegend) {
            bodyY = ChartView.DrawStageLegendWrap(app, o, x, y, w, top);
        }
        if (n < 1) { return; }
        int maxV = 1;
        foreach (ChartStage st in stages) { if (st.val > maxV) { maxV = st.val; } }

        int areaW = w - pad * 2;
        int areaH = (y + h - pad) - bodyY;
        int rMax = ChartView.RadialRadius(areaW, areaH, 58);
        int cx = x + pad + areaW / 2;
        int cy = bodyY + areaH / 2;
        int sweepMax = 360 * g / 1000;
        // 模式与起始角取自首条可见玫瑰系列：
        //  radius —— 圆心角 ∝ 数值占比，半径线性于数值；
        //  area   —— 圆心角均分，半径 ∝ √数值（面积正比于数值）。
        string mode = "radius";
        int rot = 0;
        foreach (ChartSeries rs in o.series) {
            if (!rs.hidden && rs.type == ChartType.Pie
                && rs.roseType.Length > 0) {
                mode = rs.roseType;
                rot = ((90 - rs.startAngle) % 360 + 360) % 360;
                break;
            }
        }

        // 预计算每扇区 [a0,a1) 与外半径；hover 与绘制共用。
        List<int> secA0 = new List<int>();
        List<int> secR = new List<int>();
        int totalV = 0;
        foreach (ChartStage st in stages) { totalV = totalV + st.val; }
        if (totalV < 1) { totalV = 1; }
        int acc = 0;
        for (int i = 0; i < n; i = i + 1) {
            int v = stages[i].val;
            int a0;
            if (mode == "area") {
                a0 = i * 360 / n;
            } else {
                a0 = acc * 360 / totalV;
                acc = acc + v;
            }
            secA0.Add(a0);
            int r;
            if (mode == "area") {
                r = rMax * ChartView.ISqrt(v * 10000 / maxV) / 100;
            } else {
                r = rMax * v / maxV;
            }
            if (r < app.Scale(6)) { r = app.Scale(6); }
            secR.Add(r);
        }

        for (int i = 0; i < n; i = i + 1) {
            int a0 = rot + secA0[i];
            int a1;
            if (mode == "area") { a1 = rot + (i + 1) * 360 / n; }
            else if (i + 1 < n) { a1 = rot + secA0[i + 1]; }
            else { a1 = rot + 360; }
            int aEnd = a1;
            if (aEnd > sweepMax + rot) { aEnd = sweepMax + rot; }
            int r = secR[i];
            if (aEnd > a0) {
                c.FillSector(cx, cy, 0, r, a0, aEnd, stages[i].color);
            }
        }

        if (o.showTooltip) {
            int mx = app.mouseX;
            int my = app.mouseY;
            if (my < bodyY) { return; }
            int ddx = mx - cx;
            int ddy = my - cy;
            int dist = ChartView.ISqrt(ddx * ddx + ddy * ddy);
            // 命中：与绘制同域旋转后，按预计算边界与每扇区半径匹配。
            int angR = ((ChartView.AngleOf(ddx, ddy) - rot) % 360 + 360) % 360;
            int idx = 0 - 1;
            for (int q = n - 1; q >= 0; q = q - 1) {
                if (angR >= secA0[q] && dist <= secR[q]) { idx = q; break; }
            }
            if (idx >= 0) {
                ChartStage st = stages[idx];
                string nm = st.name;
                if (nm.Length == 0) { nm = "Item " + Convert.ToString(idx + 1); }
                // axisPointer 玫瑰版：命中扇区的中角方向画 1px
                // 径向引线 + 外端 label chip（与 DrawPieMark 同
                // 屏幕位置约定：pos = (SinDeg m, SinDeg m+270)）。
                int crossCol2 = Style.Part(app, "chart", "crosshair", "",
                    "", "", Style.SNormal()).BgOr(0);
                int midR = rot + (secA0[idx] + secA0[idx] + 1) / 2;
                // secA0 是分块起始角；中点角 = secA0[idx] + (secA0[idx+1]-secA0[idx])/2。
                // 末块没有 idx+1 项：终点就是整圈 360（area 模式同理按等分补上），
                // 悬停最后一块不再越界。
                int a0Here = secA0[idx];
                int a1Here;
                if (idx + 1 < n) { a1Here = secA0[idx + 1]; }
                else if (mode == "area") { a1Here = a0Here + 360 / n; }
                else { a1Here = 360; }
                if (a1Here <= a0Here) { a1Here = a0Here + 1; }
                int midFull = a0Here + ((a1Here - a0Here) / 2);
                int dRx = ChartView.SinDeg(midFull);
                int dRy = ChartView.SinDeg(midFull + 270);
                int sR2 = ChartView.ISqrt(dRx * dRx + dRy * dRy);
                if (sR2 < 1) { sR2 = 1; }
                int rNorm = ChartView.ISqrt(dRx * dRx + dRy * dRy);
                if (rNorm < 1) { rNorm = 1; }
                int rX = dRx * 1000 / rNorm;
                int rY = dRy * 1000 / rNorm;
                int rHit = secR[idx];
                int rTip = rHit + app.Scale(12);
                c.DrawLine(cx + rX * rHit / 1000, cy + rY * rHit / 1000,
                    cx + rX * rTip / 1000, cy + rY * rTip / 1000,
                    Chart.WithAlpha(crossCol2, 200), 1);
                string lblF = nm + "  " + Convert.ToString(st.val);
                int fs = Style.FontFallback(app, "small");
                int lw = Canvas.MeasureText(lblF, fs);
                int labelX = cx + rX * rTip / 1000;
                int labelY = cy + rY * rTip / 1000 - Canvas.FontHeight(fs) / 2;
                // 右半圈 (rX >= 0) 文本左锚；左半圈右锚。
                if (rX >= 0) { labelX = labelX + app.Scale(4); }
                else { labelX = labelX - app.Scale(4) - lw; }
                c.FillRoundRect(labelX - app.Scale(2), labelY, lw + app.Scale(4),
                    Canvas.FontHeight(fs), app.Scale(2), crossCol2);
                c.DrawText(labelX, labelY, lblF, Style.Part(app, "chart",
                    "crosshair-label", "", "", "", Style.SNormal()).FgOr(crossCol2), fs);
                List<TooltipRow> rows = new List<TooltipRow>{
                    TooltipRow.Of(0, o.title),
                    TooltipRow.Of(st.color, nm + "  " + Convert.ToString(st.val)) };
                ChartView.TooltipCard(app, mx, my, x + w, rows);
            }
        }
    }

    // 饼图 markPoint：在扇区中角方向延伸一个标签。线 + 圆 + 文字。
    // idx < 0 时不画；与 SliceOutMidAngle 共享角度约定（rot + 中角），
    // 屏幕位置按数学域 +270° 换算（与 selectOffset 路径同源）。
    static void DrawPieMark(App app, Canvas c, int cx, int cy, int rOuter,
                            int rot, List<PieSlice> slices, int idx,
                            string lbl, Theme t) {
        if (idx < 0 || idx >= slices.Count) { return; }
        PieSlice sl = slices[idx];
        int mid = rot + (sl.a0 + sl.a1) / 2;
        int px = cx + ChartView.SinDeg(mid) * rOuter / 1000;
        int py = cy + ChartView.SinDeg(mid + 270) * rOuter / 1000;
        int off = app.Scale(18);
        int ex = cx + ChartView.SinDeg(mid) * (rOuter + off) / 1000;
        int ey = cy + ChartView.SinDeg(mid + 270) * (rOuter + off) / 1000;
        int sCol = Style.Part(app, "chart", "value", "", "", "", Style.SNormal()).FgOr(0);
        c.DrawLine(px, py, ex, ey, sCol, 1);
        c.FillCircle(ex, ey, app.Scale(2), sCol);
        string txt = lbl + " " + Convert.ToString(sl.value);
        int fs = Style.FontFallback(app, "small");
        int tw = Canvas.MeasureText(txt, fs);
        int tx = ex;
        int ty = ey - Canvas.FontHeight(fs) - app.Scale(2);
        // 屏幕位置约定 x = SinDeg(mid)；mid 在 0..360 环上——
        // 右半圈（x >= 0）文本左对齐在 ex 处，左半圈右对齐。
        if (ChartView.SinDeg(mid) >= 0) { tx = ex + app.Scale(4); }
        else { tx = ex - app.Scale(4) - tw; }
        c.DrawText(tx, ty, txt, sCol, fs);
    }
}
