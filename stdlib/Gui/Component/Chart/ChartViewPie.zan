using System;
using System.Json;
using Gui;

namespace Gui.Component.Chart;

partial class ChartView {
    static void DrawPie(App app, int x, int y, int w, int h,
                        ChartOption o, int innerPct, bool sliceLabels, int g) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int pad = t.paddingMedium;

        c.SurfaceRoundRect(x, y, w, h, t.borderRadiusMedium, t.bgPrimary, t.borderPrimary, 1);
        int top = y + pad;
        if (o.title.Length > 0) {
            c.DrawText(x + pad, top, o.title, t.textPrimary, t.fontSizeLarge);
        }
        top = top + Canvas.FontHeight(t.fontSizeLarge) + app.Scale(6);

        // 合计来自完整数据（未按 g 缩放），使饼图几何稳定；
        // 渐入动画是扫到 sweepMax 度的径向扫掠。这避免了
        // 整数除法把早期帧的小值截断为 0（此前
        // 会导致整张图空白）。
        int total = 0;
        for (int i = 0; i < o.series.Count; i = i + 1) {
            ChartSeries s = o.series[i];
            int v = 0;
            if (s.Count() > 0) { v = s.Value(0); }
            total = total + v;
        }
        if (total <= 0) { return; }

        int legendW = app.Scale(120);
        int areaW = w - pad * 2 - legendW;
        int areaH = (y + h - pad) - top;
        int rOuter = areaW / 2;
        if (areaH / 2 < rOuter) { rOuter = areaH / 2; }
        if (rOuter < app.Scale(10)) { rOuter = app.Scale(10); }
        int cx = x + pad + areaW / 2;
        int cy = top + areaH / 2;
        int rInner = rOuter * innerPct / 100;
        int sweepMax = 360 * g / 1000;

        int acc = 0;
        for (int k = 0; k < o.series.Count; k = k + 1) {
            ChartSeries s = o.series[k];
            int v = 0;
            if (s.Count() > 0) { v = s.Value(0); }
            int a0 = acc * 360 / total;
            int a1 = (acc + v) * 360 / total;
            int aEnd = a1;
            if (aEnd > sweepMax) { aEnd = sweepMax; }
            if (aEnd > a0) {
                c.FillSector(cx, cy, rInner, rOuter, a0, aEnd, s.color);
            }
            acc = acc + v;
        }

        // 可选的分片百分比标签，位于扇区中角处。
        if (sliceLabels) {
            int rLbl = (rInner + rOuter) / 2;
            if (rInner < app.Scale(4)) { rLbl = rOuter * 62 / 100; }
            int acc2 = 0;
            for (int p = 0; p < o.series.Count; p = p + 1) {
                ChartSeries s = o.series[p];
                int v2 = 0;
                if (s.Count() > 0) { v2 = s.Value(0); }
                int a0 = acc2 * 360 / total;
                int a1 = (acc2 + v2) * 360 / total;
                int pct = v2 * 100 / total;
                if (a1 <= sweepMax && pct >= 4) {
                    int mid = (a0 + a1) / 2;
                    int lxp = cx + ChartView.CosDeg(mid) * rLbl / 1000;
                    int lyp = cy + ChartView.SinDeg(mid) * rLbl / 1000;
                    string pl = Convert.ToString(pct) + "%";
                    int pw = Canvas.MeasureText(pl, t.fontSizeSmall);
                    c.DrawText(lxp - pw / 2, Canvas.CenterTextYAt(lyp, t.fontSizeSmall),
                        pl, 4294967295, t.fontSizeSmall);
                }
                acc2 = acc2 + v2;
            }
        }

        // 环形图中心标注：当前累计值，让中心空洞有意义。
        if (rInner > app.Scale(18)) {
            string tot = Convert.ToString(total);
            int tw = Canvas.MeasureText(tot, t.fontSizeLarge);
            c.DrawText(cx - tw / 2, Canvas.CenterTextYAt(cy, t.fontSizeLarge),
                tot, t.textPrimary, t.fontSizeLarge);
        }

        // 图例：色块 + 名称 + 百分比（始终绘制）。
        int lx = x + w - pad - legendW;
        int ly = top;
        int sw = app.Scale(12);
        int lh = Canvas.FontHeight(t.fontSizeSmall) + app.Scale(6);
        for (int j = 0; j < o.series.Count; j = j + 1) {
            ChartSeries s = o.series[j];
            int v = 0;
            if (s.Count() > 0) { v = s.Value(0); }
            c.FillRoundRect(lx, ly + app.Scale(2), sw, sw, t.borderRadiusSmall, s.color);
            int pct = v * 100 / total;
            string lbl = s.name + "  " + Convert.ToString(pct) + "%";
            c.DrawText(lx + sw + app.Scale(6), ly + app.Scale(1), lbl, t.textSecondary, t.fontSizeSmall);
            ly = ly + lh;
        }

        if (o.showTooltip) {
            int mx = app.mouseX;
            int my = app.mouseY;
            int ddx = mx - cx;
            int ddy = my - cy;
            int dist = ChartView.ISqrt(ddx * ddx + ddy * ddy);
            if (dist >= rInner && dist <= rOuter) {
                int ang = ChartView.AngleOf(ddx, ddy);
                int acc3 = 0;
                for (int k3 = 0; k3 < o.series.Count; k3 = k3 + 1) {
                    ChartSeries s = o.series[k3];
                    int v3 = 0;
                    if (s.Count() > 0) { v3 = s.Value(0); }
                    int a0 = acc3 * 360 / total;
                    int a1 = (acc3 + v3) * 360 / total;
                    if (ang >= a0 && ang < a1) {
                        int pct3 = v3 * 100 / total;
                        List<TooltipRow> rows = new List<TooltipRow>{
                            TooltipRow.Of(0, o.title),
                            TooltipRow.Of(s.color,
                                s.name + "  " + Convert.ToString(v3)
                                + "  (" + Convert.ToString(pct3) + "%)") };
                        ChartView.TooltipCard(app, mx, my, x + w, rows);
                        break;
                    }
                    acc3 = acc3 + v3;
                }
            }
        }
    }
    // ---- 仪表盘（每序列一个表盘；Canvas 角度顺时针） ----

    static int GaugeSweep(GaugeOption gauge) {
        int sweep = gauge.startAngle - gauge.endAngle;
        while (sweep <= 0) { sweep = sweep + 360; }
        if (sweep > 360) { sweep = 360; }
        return sweep;
    }

    static int GaugeStart(GaugeOption gauge) {
        int start = 90 - gauge.startAngle;
        while (start < 0) { start = start + 360; }
        while (start >= 360) { start = start - 360; }
        return start;
    }

    static int GaugeScalar(App app, ChartScalar scalar, int extent) {
        if (scalar.percent) { return extent * scalar.amount / 100; }
        return app.Scale(scalar.amount);
    }

    // FillSector 以 12 点钟方向为 0 度并顺时针递增。保持
    // 仪表盘的矢量几何处于同一坐标系。
    static int GaugeX(int angle) { return ChartView.SinDeg(angle); }
    static int GaugeY(int angle) { return 0 - ChartView.CosDeg(angle); }

    static void GaugeSector(Canvas c, int cx, int cy, int inner, int outer,
                            int start, int sweep, int color) {
        if (sweep <= 0 || outer <= inner) { return; }
        while (start < 0) { start = start + 360; }
        while (start >= 360) { start = start - 360; }
        int first = sweep;
        if (start + first > 360) { first = 360 - start; }
        if (first > 0) { c.FillSector(cx, cy, inner, outer, start, start + first, color); }
        int rest = sweep - first;
        if (rest > 0) { c.FillSector(cx, cy, inner, outer, 0, rest, color); }
    }

    static int GaugeColor(GaugeOption gauge, int perMille) {
        for (int i = 0; i < gauge.axisLine.colors.Count; i = i + 1) {
            GaugeColorStop stop = gauge.axisLine.colors[i];
            if (perMille <= stop.stop) { return stop.color; }
        }
        if (gauge.axisLine.colors.Count > 0) {
            return gauge.axisLine.colors[gauge.axisLine.colors.Count - 1].color;
        }
        return 0;
    }

    /// 仪表文字大小：表盘的标签、标题和读数按表盘定尺寸，
    /// 而非窗口。固定 px 字号（ECharts 的 30px detail）只在
    /// demo 的表盘尺寸下合适 —— 小卡片上同样字号会盖住
    /// 刻度标签并溢出圆弧，这正是此前
    /// 仪表与参照完全不像的原因。`permilleOfRadius` 把
    /// 请求字号限制在半径的一定比例内。
    static int GaugeFont(App app, int requested, int fallback, int radius,
                         int permilleOfRadius) {
        int size = fallback;
        if (requested > 0) { size = app.Scale(requested); }
        int cap = radius * permilleOfRadius / 1000;
        if (cap < 8) { cap = 8; }
        if (size > cap) { size = cap; }
        if (size < 8) { size = 8; }
        return size;
    }

    static void DrawGauge(App app, int x, int y, int w, int h,
                          ChartOption o, int g) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int pad = t.paddingMedium;
        int top = ChartView.PanelHead(app, x, y, w, h, o.title);
        int bodyX = x + pad;
        int bodyY = top;
        int bodyW = w - pad * 2;
        int bodyH = y + h - pad - top;
        int baseSize = bodyW;
        if (bodyH < baseSize) { baseSize = bodyH; }
        for (int si = 0; si < o.series.Count; si = si + 1) {
            ChartSeries s = o.series[si];
            if (!s.hidden && s.type == ChartType.Gauge) {
                GaugeOption gauge = s.gauge;
                int min = gauge.min;
                int max = gauge.max;
                double rawVal = (double)min;
                if (s.Count() > 0) { rawVal = s.Number(0); }
                if (rawVal < (double)min) { rawVal = (double)min; }
                if (rawVal > (double)max) { rawVal = (double)max; }
                int val = (int)rawVal;
                int span = max - min;
                if (span < 1) { span = 1; }
                int perMille = (int)((rawVal - (double)min) * 1000.0 / (double)span);
                int startAngle = ChartView.GaugeStart(gauge);
                int sweep = ChartView.GaugeSweep(gauge);
                int cx = bodyX + ChartView.GaugeScalar(app, gauge.center.x, bodyW);
                int cy = bodyY + ChartView.GaugeScalar(app, gauge.center.y, bodyH);
                int radius = ChartView.GaugeScalar(app, gauge.radius, baseSize / 2);
                if (radius < app.Scale(12)) { radius = app.Scale(12); }
                int axisW = app.Scale(gauge.axisLine.lineStyle.width);
                if (axisW < 1) { axisW = 1; }

                if (gauge.axisLine.show) {
                    int prev = 0;
                    for (int stops = 0; stops < gauge.axisLine.colors.Count; stops = stops + 1) {
                        GaugeColorStop colorStop = gauge.axisLine.colors[stops];
                        int stop = colorStop.stop;
                        int col = colorStop.color;
                        if (stop < prev) { stop = prev; }
                        if (stop > 1000) { stop = 1000; }
                        int segStart = startAngle + sweep * prev / 1000;
                        int segSweep = sweep * (stop - prev) / 1000;
                        int grown = sweep * g / 1000;
                        int rel = segStart - startAngle;
                        if (rel < grown) {
                            if (rel + segSweep > grown) { segSweep = grown - rel; }
                            ChartView.GaugeSector(c, cx, cy, radius - axisW, radius,
                                segStart, segSweep, col);
                        }
                        prev = stop;
                    }
                }

                if ((gauge.axisTick.show || gauge.splitLine.show) && gauge.splitNumber > 0) {
                    int minor = gauge.axisTick.splitNumber;
                    if (minor < 1) { minor = 1; }
                    int totalTicks = gauge.splitNumber * minor;
                    for (int ti = 0; ti <= totalTicks; ti = ti + 1) {
                        bool major = ti % minor == 0;
                        int len = app.Scale(gauge.axisTick.length);
                        int thick = app.Scale(gauge.axisTick.lineStyle.width);
                        int tickColor = gauge.axisTick.lineStyle.color;
                        bool showTick = gauge.axisTick.show;
                        if (major) {
                            len = app.Scale(gauge.splitLine.length);
                            thick = app.Scale(gauge.splitLine.lineStyle.width);
                            tickColor = gauge.splitLine.lineStyle.color;
                            showTick = gauge.splitLine.show;
                        }
                        int ang = startAngle + sweep * ti / totalTicks;
                        int x0 = cx + ChartView.GaugeX(ang) * (radius - axisW) / 1000;
                        int y0 = cy + ChartView.GaugeY(ang) * (radius - axisW) / 1000;
                        int x1 = cx + ChartView.GaugeX(ang) * (radius - axisW - len) / 1000;
                        int y1 = cy + ChartView.GaugeY(ang) * (radius - axisW - len) / 1000;
                        if (showTick) { c.DrawLine(x0, y0, x1, y1, tickColor, thick); }
                    }
                }

                if (gauge.axisLabel.show && gauge.splitNumber > 0) {
                    for (int li = 0; li <= gauge.splitNumber; li = li + 1) {
                        int ang2 = startAngle + sweep * li / gauge.splitNumber;
                        int lv = min + span * li / gauge.splitNumber;
                        string ls = Convert.ToString(lv);
                        int labelSize = ChartView.GaugeFont(app,
                            gauge.axisLabel.textStyle.fontSize, t.fontSizeSmall,
                            radius, 150);
                        // 标签紧贴分隔线内侧。钳制环半径
                        // 可在表盘小到刻度 + 间隙几乎占据整个
                        // 半径时，避免标签与标题/读数
                        // 重叠。
                        int lr = radius - axisW - app.Scale(gauge.splitLine.length)
                            - labelSize;
                        int lrMin = radius * 55 / 100;
                        if (lr < lrMin) { lr = lrMin; }
                        int labelColor = gauge.axisLabel.textStyle.color;
                        if (labelColor == 0) { labelColor = t.textTertiary; }
                        int lx = cx + ChartView.GaugeX(ang2) * lr / 1000;
                        int ly = cy + ChartView.GaugeY(ang2) * lr / 1000;
                        c.DrawText(lx - Canvas.MeasureText(ls, labelSize) / 2,
                            Canvas.CenterTextYAt(ly, labelSize),
                            ls, labelColor, labelSize);
                    }
                }

                int valueSweep = sweep * perMille / 1000;
                valueSweep = valueSweep * g / 1000;
                int pointerAngle = startAngle + valueSweep;
                int pointerR = ChartView.GaugeScalar(app, gauge.pointer.length, radius);
                int px = cx + ChartView.GaugeX(pointerAngle) * pointerR / 1000;
                int py = cy + ChartView.GaugeY(pointerAngle) * pointerR / 1000;
                int pointerColor = gauge.pointer.color;
                if (pointerColor == 0) { pointerColor = s.color; }
                if (pointerColor == 0) { pointerColor = ChartView.GaugeColor(gauge, perMille); }
                // ECharts 指针：细长矛头形，轮毂处最宽，
                // 尖端收成一点。以一系列抗锯齿圆盘光栅化成锥体，
                // 主体无空隙、边缘平滑
                // —— 逐行垂直扫描线会留下可见的
                // 对角网格，而在数值角对面绘制尾翼
                // 会产生从表盘远侧刺出的尖刺。
                int halfPointerW = app.Scale(gauge.pointer.width) / 2;
                if (halfPointerW < 1) { halfPointerW = 1; }
                if (pointerR > 0) {
                    int ux = ChartView.GaugeX(pointerAngle);
                    int uy = ChartView.GaugeY(pointerAngle);
                    int tail = halfPointerW;
                    int step = 0 - tail;
                    while (step <= pointerR) {
                        int rr;
                        if (step < 0) { rr = halfPointerW * (tail + step) / tail; }
                        else { rr = halfPointerW * (pointerR - step) / pointerR; }
                        if (rr < 1) { rr = 1; }
                        int ax = cx + ux * step / 1000;
                        int ay = cy + uy * step / 1000;
                        c.FillCircle(ax, ay, rr, pointerColor);
                        step = step + 1;
                    }
                    c.FillCircle(cx, cy, halfPointerW + app.Scale(1), pointerColor);
                }

                string titleText = s.name;
                if (s.data.Count > 0 && s.data[0].name.Length > 0) {
                    titleText = s.data[0].name;
                }
                int titleSize = ChartView.GaugeFont(app,
                    gauge.title.textStyle.fontSize, t.fontSizeSmall,
                    radius, 180);
                int titleBottom = cy
                    + ChartView.GaugeScalar(app, gauge.title.offsetCenter.y, radius)
                    + titleSize / 2;
                bool titleDrawn = gauge.title.show && titleText.Length > 0;
                if (titleDrawn) {
                    int titleColor = gauge.title.textStyle.color;
                    if (titleColor == 0) { titleColor = t.textSecondary; }
                    int tx = cx + ChartView.GaugeScalar(app, gauge.title.offsetCenter.x, radius);
                    int ty = titleBottom - titleSize / 2;
                    c.DrawText(tx - Canvas.MeasureText(titleText, titleSize) / 2,
                        Canvas.CenterTextY(ty - titleSize / 2, titleSize, titleSize),
                        titleText, titleColor, titleSize);
                }
                if (gauge.detail.show) {
                    string detail = gauge.detail.formatter;
                    if (detail.Length == 0) { detail = "{value}"; }
                    string valueText = Convert.ToString(val);
                    if (gauge.precision > 0 || rawVal != (double)val) {
                        valueText = Convert.ToString(rawVal);
                    }
                    detail = detail.Replace("{value}", valueText);
                    int detailSize = ChartView.GaugeFont(app,
                        gauge.detail.textStyle.fontSize, t.fontSizeLarge,
                        radius, 300);
                    int detailColor = gauge.detail.textStyle.color;
                    if (detailColor == 0) { detailColor = t.textPrimary; }
                    int dx = cx + ChartView.GaugeScalar(app, gauge.detail.offsetCenter.x, radius);
                    int dy = cy + ChartView.GaugeScalar(app, gauge.detail.offsetCenter.y, radius);
                    // 读数与上方的名称保持间距：两个偏移
                    // 都相对同一圆心，小表盘上配置的
                    // 20%/40% 环间距会小于两者的
                    // 字形高度，导致文字互相重叠。
                    int detailTopMin = titleBottom + app.Scale(2) + detailSize / 2;
                    if (titleDrawn && dy < detailTopMin) { dy = detailTopMin; }
                    c.DrawText(dx - Canvas.MeasureText(detail, detailSize) / 2,
                        Canvas.CenterTextY(dy - detailSize / 2, detailSize, detailSize),
                        detail, detailColor, detailSize);
                }
            }
        }

        if (o.showTooltip) {
            int mx = app.mouseX;
            int my = app.mouseY;
            int hit = o.series.Count - 1;
            while (hit >= 0) {
                ChartSeries hs = o.series[hit];
                if (!hs.hidden && hs.type == ChartType.Gauge) {
                    GaugeOption hitGauge = hs.gauge;
                    int hcx = bodyX + ChartView.GaugeScalar(app, hitGauge.center.x, bodyW);
                    int hcy = bodyY + ChartView.GaugeScalar(app, hitGauge.center.y, bodyH);
                    int hr = ChartView.GaugeScalar(app, hitGauge.radius, baseSize / 2);
                    int ddx = mx - hcx;
                    int ddy = my - hcy;
                    if (ChartView.ISqrt(ddx * ddx + ddy * ddy) <= hr) {
                        double hitRaw = (double)hitGauge.min;
                        if (hs.Count() > 0) { hitRaw = hs.Number(0); }
                        string hitValue = Convert.ToString((int)hitRaw);
                        if (hitGauge.precision > 0 || hitRaw != (double)((int)hitRaw)) {
                            hitValue = Convert.ToString(hitRaw);
                        }
                        List<TooltipRow> rows = new List<TooltipRow>();
                        rows.Add(TooltipRow.Of(0, o.title));
                        string hitDetail = hitGauge.detail.formatter;
                        if (hitDetail.Length == 0) { hitDetail = "{value}"; }
                        hitDetail = hitDetail.Replace("{value}", hitValue);
                        rows.Add(TooltipRow.Of(hs.color, hs.name + "  " + hitDetail
                            + "  [" + Convert.ToString(hitGauge.min) + ", " + Convert.ToString(hitGauge.max) + "]"));
                        ChartView.TooltipCard(app, mx, my, x + w, rows);
                        break;
                    }
                }
                hit = hit - 1;
            }
        }
    }

    // ---- 径向柱状图（同心进度环；扫掠角随 g 增长） ----

    static void DrawRadialBars(App app, int x, int y, int w, int h,
                               ChartOption o, int g) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int pad = t.paddingMedium;
        int top = ChartView.PanelHead(app, x, y, w, h, o.title);

        int max = o.gaugeMax;
        if (max <= 0) { max = 100; }
        int n = o.series.Count;
        if (n < 1) { return; }

        int legendW = app.Scale(120);
        int areaW = w - pad * 2 - legendW;
        int areaH = (y + h - pad) - top;
        int rMax = areaW / 2;
        if (areaH / 2 < rMax) { rMax = areaH / 2; }
        if (rMax < app.Scale(20)) { rMax = app.Scale(20); }
        int cx = x + pad + areaW / 2;
        int cy = top + areaH / 2;

        int band = rMax * 78 / 100 / n;
        int gap = app.Scale(3);
        if (gap > band / 3) { gap = band / 3; }
        for (int i = 0; i < n; i = i + 1) {
            ChartSeries ring = o.series[i];
            int ringOuter = rMax - i * band;
            int ringInner = ringOuter - band + gap;
            if (ringInner < 0) { ringInner = 0; }
            int val = 0;
            if (o.series[i].Count() > 0) { val = o.series[i].Value(0); }
            if (val < 0) { val = 0; }
            if (val > max) { val = max; }
            c.FillSector(cx, cy, ringInner, ringOuter, 0, 360, t.bgTertiary);
            int sweep = 360 * val / max;
            sweep = sweep * g / 1000;
            if (sweep > 0) {
                c.FillSector(cx, cy, ringInner, ringOuter, 0, sweep, o.series[i].color);
            }
        }

        // 图例：色块 + 名称 + 值。
        int lx = x + w - pad - legendW;
        int ly = top;
        int sw = app.Scale(12);
        int lh = Canvas.FontHeight(t.fontSizeSmall) + app.Scale(6);
        for (int j = 0; j < n; j = j + 1) {
            int val = 0;
            if (o.series[j].Count() > 0) { val = o.series[j].Value(0); }
            c.FillRoundRect(lx, ly + app.Scale(2), sw, sw, t.borderRadiusSmall, o.series[j].color);
            string lbl = o.series[j].name + "  " + Convert.ToString(val);
            c.DrawText(lx + sw + app.Scale(6), ly + app.Scale(1), lbl, t.textSecondary, t.fontSizeSmall);
            ly = ly + lh;
        }

        if (o.showTooltip) {
            int mx = app.mouseX;
            int my = app.mouseY;
            int ddx = mx - cx;
            int ddy = my - cy;
            int dist = ChartView.ISqrt(ddx * ddx + ddy * ddy);
            for (int i2 = 0; i2 < n; i2 = i2 + 1) {
                int ringOuter = rMax - i2 * band;
                int ringInner = ringOuter - band + gap;
                if (ringInner < 0) { ringInner = 0; }
                if (dist >= ringInner && dist <= ringOuter) {
                    int v2 = 0;
                    if (o.series[i2].Count() > 0) { v2 = o.series[i2].Value(0); }
                    List<TooltipRow> rows = new List<TooltipRow>{
                        TooltipRow.Of(0, o.title),
                        TooltipRow.Of(o.series[i2].color,
                            o.series[i2].name + "  " + Convert.ToString(v2)
                            + " / " + Convert.ToString(max)) };
                    ChartView.TooltipCard(app, mx, my, x + w, rows);
                    break;
                }
            }
        }
    }

    // ---- 热力图（行=序列，列=数值索引；强度随 g 渐显） ----
    // 收集漏斗/金字塔/玫瑰图各阶段：每阶段一个值+颜色+名称，来源为
    // 多个单值序列或一个多值序列。
    static List<ChartStage> GatherStages(App app, List<ChartSeries> series) {
        Theme t = app.theme;
        List<ChartStage> stages = new List<ChartStage>();
        if (series.Count > 1) {
            for (int i = 0; i < series.Count; i = i + 1) {
                int v = 0;
                if (series[i].Count() > 0) { v = series[i].Value(0); }
                int col = series[i].color;
                if (col == 0) { col = Chart.Palette(t, i); }
                stages.Add(new ChartStage(v, col, series[i].name));
            }
        } else if (series.Count == 1) {
            int n = series[0].Count();
            for (int i = 0; i < n; i = i + 1) {
                stages.Add(new ChartStage(series[0].Value(i), Chart.Palette(t, i), ""));
            }
        }
        return stages;
    }

    // ---- 漏斗图 / 金字塔图 ----

    static void DrawFunnel(App app, int x, int y, int w, int h,
                           ChartOption o, int g, bool pyramid) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int pad = t.paddingMedium;
        int top = ChartView.PanelHead(app, x, y, w, h, o.title);

        List<ChartStage> stages = ChartView.GatherStages(app, o.series);
        int n = stages.Count;
        if (n < 1) { return; }
        int maxV = 1;
        foreach (ChartStage st in stages) { if (st.val > maxV) { maxV = st.val; } }

        int legendW = app.Scale(120);
        int areaW = w - pad * 2 - legendW;
        int areaH = (y + h - pad) - top;
        int cx = x + pad + areaW / 2;
        int rowH = areaH / n;

        for (int i2 = 0; i2 < n; i2 = i2 + 1) {
            int idx = i2;
            if (pyramid) { idx = n - 1 - i2; }
            int vTop = stages[idx].val;
            int vBot = vTop;
            int nextIdx = idx + 1;
            if (pyramid) { nextIdx = idx - 1; }
            if (nextIdx >= 0 && nextIdx < n) { vBot = stages[nextIdx].val; }
            int wTop = vTop * areaW / maxV * g / 1000;
            int wBot = vBot * areaW / maxV * g / 1000;
            int ry = top + i2 * rowH;
            int col = stages[idx].color;
            int strip = rowH - app.Scale(3);
            int wTopF = wTop * 256;      // 1/256 px，使斜边获得
            int wBotF = wBot * 256;      // 亚像素覆盖率而非阶梯状
            int cxF = cx * 256;
            for (int r = 0; r < strip; r = r + 1) {
                int tt = 0;
                if (strip > 0) { tt = r * 1000 / strip; }
                int wwF = wTopF + (wBotF - wTopF) * tt / 1000;
                int xlF = cxF - wwF / 2;
                int xrF = xlF + wwF;
                int xl = xlF / 256;
                if (xlF < 0) { xl = (xlF - 255) / 256; }
                int xr = (xrF + 255) / 256;
                int yRow = ry + r;
                // 边缘像素获得小数覆盖率；内部行保持
                // 实心，使倾斜轮廓平滑而非
                // 锯齿。左侧覆盖率 = 像素 xl 的右缘减去
                // 形状左边界；右侧覆盖率 = 形状右
                // 边界减去像素 xr-1 的左缘。
                int lcov = (xl + 1) * 256 - xlF;
                if (lcov >= 256) { c.FillRect(xl, yRow, 1, 1, col); }
                else if (lcov > 0) { c.FillRect(xl, yRow, 1, 1, Chart.WithAlpha(col, lcov)); }
                int m0 = xl + 1;
                int m1 = xr - 1;         // 实心中间段（不含端点）
                if (m1 > m0) { c.FillRect(m0, yRow, m1 - m0, 1, col); }
                int rcov = xrF - (xr - 1) * 256;
                if (rcov >= 256) { c.FillRect(xr - 1, yRow, 1, 1, col); }
                else if (rcov > 0) { c.FillRect(xr - 1, yRow, 1, 1, Chart.WithAlpha(col, rcov)); }
            }
            string lbl = stages[idx].name;
            if (lbl.Length == 0) { lbl = Convert.ToString(stages[idx].val); }
            c.DrawTextCentered(cx - areaW / 2, ry + rowH / 2 - Canvas.FontHeight(t.fontSizeSmall) / 2,
                areaW, Canvas.FontHeight(t.fontSizeSmall), lbl, t.textPrimary, t.fontSizeSmall);
        }

        int lx = x + w - pad - legendW;
        int ly = top;
        int sw = app.Scale(12);
        int lh = Canvas.FontHeight(t.fontSizeSmall) + app.Scale(6);
        for (int j = 0; j < n; j = j + 1) {
            ChartStage st = stages[j];
            c.FillRoundRect(lx, ly + app.Scale(2), sw, sw, t.borderRadiusSmall, st.color);
            string nm = st.name;
            if (nm.Length == 0) { nm = ChartView.StageName(j); }
            c.DrawText(lx + sw + app.Scale(6), ly + app.Scale(1),
                nm + "  " + Convert.ToString(st.val), t.textSecondary, t.fontSizeSmall);
            ly = ly + lh;
        }

        if (o.showTooltip) {
            int mx = app.mouseX;
            int my = app.mouseY;
            if (mx >= x + pad && mx < x + w - pad - legendW
                && my >= top && my < y + h - pad) {
                int idx = (my - top) / rowH;
                if (idx < 0) { idx = 0; }
                if (idx > n - 1) { idx = n - 1; }
                ChartStage st = stages[idx];
                string nm = st.name;
                if (nm.Length == 0) { nm = ChartView.StageName(idx); }
                List<TooltipRow> rows = new List<TooltipRow>{
                    TooltipRow.Of(0, o.title),
                    TooltipRow.Of(st.color, nm + "  " + Convert.ToString(st.val)) };
                ChartView.TooltipCard(app, mx, my, x + w, rows);
            }
        }
    }

    static string StageName(int i) { return "Stage " + Convert.ToString(i + 1); }

    // ---- 玫瑰图 / 南丁格尔图（等角，半径按值） ----

    static void DrawRose(App app, int x, int y, int w, int h,
                         ChartOption o, int g) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int pad = t.paddingMedium;
        int top = ChartView.PanelHead(app, x, y, w, h, o.title);

        List<ChartStage> stages = ChartView.GatherStages(app, o.series);
        int n = stages.Count;
        if (n < 1) { return; }
        int maxV = 1;
        foreach (ChartStage st in stages) { if (st.val > maxV) { maxV = st.val; } }

        int legendW = app.Scale(120);
        int areaW = w - pad * 2 - legendW;
        int areaH = (y + h - pad) - top;
        int rMax = areaW / 2;
        if (areaH / 2 < rMax) { rMax = areaH / 2; }
        if (rMax < app.Scale(10)) { rMax = app.Scale(10); }
        int cx = x + pad + areaW / 2;
        int cy = top + areaH / 2;
        int sweepMax = 360 * g / 1000;

        for (int i = 0; i < n; i = i + 1) {
            int a0 = i * 360 / n;
            int a1 = (i + 1) * 360 / n;
            if (a1 > sweepMax) { a1 = sweepMax; }
            int r = rMax * stages[i].val / maxV;
            if (r < app.Scale(6)) { r = app.Scale(6); }
            if (a1 > a0) { c.FillSector(cx, cy, 0, r, a0, a1, stages[i].color); }
        }

        int lx = x + w - pad - legendW;
        int ly = top;
        int sw = app.Scale(12);
        int lh = Canvas.FontHeight(t.fontSizeSmall) + app.Scale(6);
        for (int j = 0; j < n; j = j + 1) {
            ChartStage st = stages[j];
            c.FillRoundRect(lx, ly + app.Scale(2), sw, sw, t.borderRadiusSmall, st.color);
            string nm = st.name;
            if (nm.Length == 0) { nm = "Item " + Convert.ToString(j + 1); }
            c.DrawText(lx + sw + app.Scale(6), ly + app.Scale(1),
                nm + "  " + Convert.ToString(st.val), t.textSecondary, t.fontSizeSmall);
            ly = ly + lh;
        }

        if (o.showTooltip) {
            int mx = app.mouseX;
            int my = app.mouseY;
            int ddx = mx - cx;
            int ddy = my - cy;
            int dist = ChartView.ISqrt(ddx * ddx + ddy * ddy);
            if (dist <= rMax) {
                int ang = ChartView.AngleOf(ddx, ddy);
                int idx = ang * n / 360;
                if (idx > n - 1) { idx = n - 1; }
                ChartStage st = stages[idx];
                string nm = st.name;
                if (nm.Length == 0) { nm = "Item " + Convert.ToString(idx + 1); }
                List<TooltipRow> rows = new List<TooltipRow>{
                    TooltipRow.Of(0, o.title),
                    TooltipRow.Of(st.color, nm + "  " + Convert.ToString(st.val)) };
                ChartView.TooltipCard(app, mx, my, x + w, rows);
            }
        }
    }
}
