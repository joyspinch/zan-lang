using System;
using System.Json;
using Gui;

namespace Gui.Component.Chart;

partial class ChartView {
    // ---- 蜡烛图 / 金融图（大数据时分桶到绘图宽度） ----

    static void DrawCandles(App app, int x, int y, int w, int h,
                            ChartOption o, int g) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        List<Candle> cs = o.series[0].candles;
        int fullN = cs.Count;
        int plotTop = ChartView.PanelHead(app, x, y, w, h, o.title);
        if (fullN < 1) { return; }

        // dataZoom：窗口索引 [i0,i1]（含端点）；价格范围、
        // 分桶和均线覆盖都只在窗口内。
        int zoomH = 0;
        int i0 = 0;
        int i1 = fullN - 1;
        if (o.zoom && o.iwid != 0 && fullN > 1) {
            i0 = Chart.ZoomI0(app, o, o.iwid, fullN);
            i1 = Chart.ZoomI1(app, o, o.iwid, fullN);
            zoomH = app.Scale(24);
        }
        int n = i1 - i0 + 1;
        if (n < 1) { n = 1; }

        int lo = cs[i0].low;
        int hi = cs[i0].high;
        for (int i = i0; i <= i1; i = i + 1) {
            if (cs[i].low < lo) { lo = cs[i].low; }
            if (cs[i].high > hi) { hi = cs[i].high; }
        }
        // 折线族覆盖层（如 MA 均线）共用价格轴，
        // 因此 lo/hi 也要包含它们的范围。
        int ov0 = 1;
        while (ov0 < o.series.Count) {
            ChartSeries s = o.series[ov0];
            if (!s.hidden && ChartView.IsLineFamily(s.type)) {
                for (int k = i0; k <= i1 && k < s.Count(); k = k + 1) {
                    int v = s.Value(k);
                    if (v < lo) { lo = v; }
                    if (v > hi) { hi = v; }
                }
            }
            ov0 = ov0 + 1;
        }
        int pad2 = (hi - lo) / 20;
        if (pad2 < 1) { pad2 = 1; }
        lo = lo - pad2;
        hi = hi + pad2;
        // 分类轴携带交易日日期（ECharts xAxis.data）时画到
        // 底轴：与蜡烛同宽均布，n 与蜡烛数一致时逐根对齐。
        List<string> kLabs = new List<string>();
        if (o.xAxes.Count > 0) { kLabs = o.xAxes[0].categories; }
        ChartFrame f = Chart.DrawFrameLoHi(app, x, y, w, h - zoomH, plotTop, kLabs, lo, hi);
        if (zoomH > 0) {
            Chart.DrawZoomBar(app, f.plotX, f.plotW, y + h - app.Scale(18),
                app.Scale(12), o.iwid, fullN);
        }
        int span = hi - lo;
        if (span < 1) { span = 1; }

        int cols = f.plotW / app.Scale(5);
        if (cols < 1) { cols = 1; }
        if (cols > n) { cols = n; }
        int cw = f.plotW / cols;
        // ECharts 2.x 涨跌色约定：itemStyle.normal.color = 阳线
        // 填充，color0 = 阴线填充；lineStyle.color / color0 分别
        // 为阳/阴影线色，缺省回落到对应填充色。
        int upC = Chart.Rgb(38, 166, 89);
        int dnC = Chart.Rgb(229, 72, 77);
        ChartSeries ksrc = o.series[0];
        if (ksrc.itemStyle.normal.color != 0) { upC = ksrc.itemStyle.normal.color; }
        if (ksrc.itemStyle.normal.color0 != 0) { dnC = ksrc.itemStyle.normal.color0; }
        int wickUp = upC;
        int wickDn = dnC;
        if (ksrc.itemStyle.normal.lineStyle.color != 0) { wickUp = ksrc.itemStyle.normal.lineStyle.color; }
        if (ksrc.itemStyle.normal.lineStyle.color0 != 0) { wickDn = ksrc.itemStyle.normal.lineStyle.color0; }

        ChartView.PushPlotClip(app, f.plotX, f.plotY, f.plotW, f.plotH);
        for (int bc = 0; bc < cols; bc = bc + 1) {
            int c0 = bc * n / cols;
            int c1 = (bc + 1) * n / cols;
            if (c1 <= c0) { c1 = c0 + 1; }
            if (c1 > n) { c1 = n; }
            int open = cs[i0 + c0].open;
            int close = cs[i0 + c1 - 1].close;
            int chi = cs[i0 + c0].high;
            int clo = cs[i0 + c0].low;
            int k = c0;
            while (k < c1) {
                if (cs[i0 + k].high > chi) { chi = cs[i0 + k].high; }
                if (cs[i0 + k].low < clo) { clo = cs[i0 + k].low; }
                k = k + 1;
            }
            int cx = f.plotX + bc * cw + cw / 2;
            int yHigh = f.plotY + f.plotH - (chi - lo) * f.plotH / span;
            int yLow = f.plotY + f.plotH - (clo - lo) * f.plotH / span;
            int yOpen = f.plotY + f.plotH - (open - lo) * f.plotH / span;
            int yClose = f.plotY + f.plotH - (close - lo) * f.plotH / span;
            int col = upC;
            int wick = wickUp;
            if (close < open) { col = dnC; wick = wickDn; }
            c.DrawLine(cx, yHigh, cx, yLow, wick, app.Scale(1));
            int bw = cw * 6 / 10;
            if (bw < app.Scale(2)) { bw = app.Scale(2); }
            int bodyTop = yOpen;
            int bodyBot = yClose;
            if (yClose < yOpen) { bodyTop = yClose; bodyBot = yOpen; }
            int bh = bodyBot - bodyTop;
            if (bh < app.Scale(1)) { bh = app.Scale(1); }
            c.FillRoundRect(cx - bw / 2, bodyTop, bw, bh, app.Scale(1), col);
        }

        // 折线覆盖层（MA 线）绘制在同一价格轴，
        // 与蜡烛柱对齐分桶，使均线与柱条对齐。
        int ov = 1;
        while (ov < o.series.Count) {
            ChartSeries s = o.series[ov];
            if (!s.hidden && ChartView.IsLineFamily(s.type)) {
                List<int> lpx = new List<int>();
                List<int> lpy = new List<int>();
                for (int k2 = 0; k2 < cols && k2 < s.Count(); k2 = k2 + 1) {
                    int li2 = (k2 + 1) * n / cols;
                    if (li2 > n) { li2 = n; }
                    if (li2 < 1) { li2 = 1; }
                    int v = s.Value(i0 + li2 - 1);
                    lpx.Add(f.plotX + k2 * cw + cw / 2);
                    lpy.Add(f.plotY + f.plotH - (v - lo) * f.plotH / span);
                }
                bool smooth = o.smooth;
                if (s.smooth == 1) { smooth = true; } else if (s.smooth == 0) { smooth = false; }
                ChartView.PolyLine(c, lpx, lpy, smooth, s.color, app.Scale(2));
            }
            ov = ov + 1;
        }
        c.PopClip();

        string cap = Convert.ToString(n) + " bars";
        int cwid = Canvas.MeasureText(cap, Style.FontFallback(app, "small"));
        c.DrawText(x + w - t.paddingMedium - cwid, y + h - t.paddingMedium - Canvas.FontHeight(Style.FontFallback(app, "small")),
            cap,
            Style.Part(app, "chart", "hint", "", "", "", Style.SNormal()).FgOr(0),
            Style.FontFallback(app, "small"));

        if (o.showTooltip) {
            int mx = app.mouseX;
            int my = app.mouseY;
            if (mx >= f.plotX && mx < f.plotX + f.plotW
                && my >= f.plotY && my < f.plotY + f.plotH) {
                int tIdx = (mx - f.plotX) / cw;
                if (tIdx < 0) { tIdx = 0; }
                if (tIdx > cols - 1) { tIdx = cols - 1; }
                // 十字光标（ECharts axisPointer cross）：竖线吸附
                // 桶中心，横线跟随指针，细线弱化色。
                int crossC = Chart.WithAlpha(
                    Style.Part(app, "chart", "axis", "", "", "",
                               Style.SNormal()).FgOr(0), 150);
                int gx2 = f.plotX + tIdx * cw + cw / 2;
                c.DrawLine(gx2, f.plotY, gx2, f.plotY + f.plotH - 1, crossC, 1);
                c.DrawLine(f.plotX, my, f.plotX + f.plotW - 1, my, crossC, 1);
                int tI0 = tIdx * n / cols;
                int tI1 = (tIdx + 1) * n / cols;
                if (tI1 <= tI0) { tI1 = tI0 + 1; }
                if (tI1 > n) { tI1 = n; }
                int g0 = i0 + tI0;
                int g1 = i0 + tI1 - 1;
                int topen = cs[g0].open;
                int tclose = cs[g1].close;
                int thi = cs[g0].high;
                int tlo = cs[g0].low;
                int tk = tI0;
                while (tk < tI1) {
                    if (cs[i0 + tk].high > thi) { thi = cs[i0 + tk].high; }
                    if (cs[i0 + tk].low < tlo) { tlo = cs[i0 + tk].low; }
                    tk = tk + 1;
                }
                int dirC = upC;
                if (tclose < topen) { dirC = dnC; }
                List<TooltipRow> rows = new List<TooltipRow>();
                string thdr = "#" + Convert.ToString(g0 + 1);
                if (g1 > g0) { thdr = thdr + "-" + Convert.ToString(g1 + 1); }
                rows.Add(TooltipRow.Of(0, thdr));
                rows.Add(TooltipRow.Of(dirC, "O  " + Convert.ToString(topen)));
                rows.Add(TooltipRow.Of(dirC, "H  " + Convert.ToString(thi)));
                rows.Add(TooltipRow.Of(dirC, "L  " + Convert.ToString(tlo)));
                rows.Add(TooltipRow.Of(dirC, "C  " + Convert.ToString(tclose)));
                ChartView.TooltipCard(app, mx, my, f.plotX + f.plotW, rows);
            }
        }
    }

    // ---- 加权散点 / 气泡图（大数据跨步采样） ----

    static void DrawBubbles(App app, int x, int y, int w, int h,
                            ChartOption o, int g) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int pad = t.paddingMedium;
        int axisFs = Style.FontFallback(app, "small");
        int plotTop = Chart.DrawPanelI(app, x, y, w, h, o.title, o.series,
                                      o.iwid, o.showLegend);

        int fullN = 0;
        for (int si0 = 0; si0 < o.series.Count; si0 = si0 + 1) {
            if (o.series[si0].bubbles.Count > fullN) {
                fullN = o.series[si0].bubbles.Count;
            }
        }
        if (fullN < 1) { return; }

        int zoomH = 0;
        int i0 = 0;
        int i1 = fullN - 1;
        if (o.zoom && o.iwid != 0 && fullN > 1) {
            i0 = Chart.ZoomI0(app, o, o.iwid, fullN);
            i1 = Chart.ZoomI1(app, o, o.iwid, fullN);
            zoomH = app.Scale(24);
        }

        int maxX = 0;
        int maxY = 0;
        int maxW = 1;
        for (int si = 0; si < o.series.Count; si = si + 1) {
            ChartSeries s = o.series[si];
            if (!s.hidden) {
                int j = i0;
                while (j <= i1 && j < s.bubbles.Count) {
                    if (s.bubbles[j].x > maxX) { maxX = s.bubbles[j].x; }
                    if (s.bubbles[j].y > maxY) { maxY = s.bubbles[j].y; }
                    if (s.bubbles[j].weight > maxW) { maxW = s.bubbles[j].weight; }
                    j = j + 1;
                }
            }
        }
        int maxXN = Chart.NiceMax(maxX);
        int maxYN = Chart.NiceMax(maxY);
        int xLo = 0;
        int yLo = 0;
        if (o.xAxes.Count > 0 && o.xAxes[0].min != ChartOption.Auto()) {
            xLo = o.xAxes[0].min;
        }
        if (o.yAxes.Count > 0 && o.yAxes[0].min != ChartOption.Auto()) {
            yLo = o.yAxes[0].min;
        }
        if (o.xAxes.Count > 0 && o.xAxes[0].max != ChartOption.Auto()) {
            maxXN = o.xAxes[0].max;
        }
        if (o.yAxes.Count > 0 && o.yAxes[0].max != ChartOption.Auto()) {
            maxYN = o.yAxes[0].max;
        }
        int leftGut = Canvas.MeasureText(Convert.ToString(maxYN), axisFs) + app.Scale(12);
        int botGut = Canvas.FontHeight(axisFs) + app.Scale(8);
        int plotX = x + pad + leftGut;
        int plotY = plotTop;
        int plotW = (x + w - pad) - plotX;
        int plotH = (y + h - zoomH - pad - botGut) - plotY;
        if (plotW < app.Scale(20)) { plotW = app.Scale(20); }
        if (plotH < app.Scale(20)) { plotH = app.Scale(20); }

        StyleBox sGrid = Style.Part(app, "chart", "grid", "", "", "",
                                    Style.SNormal());
        StyleBox sAxis = Style.Part(app, "chart", "axis", "", "", "",
                                    Style.SNormal());
        int ticks = 5;
        int xSpan = maxXN - xLo;
        int ySpan = maxYN - yLo;
        if (xSpan < 1) { xSpan = 1; }
        if (ySpan < 1) { ySpan = 1; }
        for (int k = 0; k <= ticks; k = k + 1) {
            int gy = Chart.ValueY(plotY, plotH, yLo, maxYN, yLo + ySpan * k / ticks);
            c.FillRect(plotX, gy, plotW, 1, sGrid.BgOr(0));
            string vs = Convert.ToString(yLo + ySpan * k / ticks);
            int vw = Canvas.MeasureText(vs, axisFs);
            c.DrawText(plotX - app.Scale(6) - vw, Canvas.CenterTextYAt(gy, axisFs),
                vs, sAxis.FgOr(0), axisFs);
            int gx = Chart.ValueX(plotX, plotW, xLo, maxXN, xLo + xSpan * k / ticks);
            c.DrawTextCentered(gx - app.Scale(20), plotY + plotH + app.Scale(4),
                app.Scale(40), botGut,
                Convert.ToString(xLo + xSpan * k / ticks), sAxis.FgOr(0), axisFs);
        }
        c.FillRect(plotX, plotY, 1, plotH, sAxis.BgOr(0));
        c.FillRect(plotX, plotY + plotH, plotW, 1, sAxis.BgOr(0));
        if (zoomH > 0) {
            Chart.DrawZoomBar(app, plotX, plotW, y + h - app.Scale(18),
                app.Scale(12), o.iwid, fullN);
        }

        int maxR = app.Scale(20);
        int rootMaxW = ChartView.ISqrt(maxW);
        if (rootMaxW < 1) { rootMaxW = 1; }

        ChartView.PushPlotClip(app, plotX, plotY, plotW, plotH);
        for (int r = 0; r < o.series.Count; r = r + 1) {
            ChartSeries s = o.series[r];
            if (!s.hidden) {
                int j = i0;
                while (j <= i1 && j < s.bubbles.Count) {
                    int px = Chart.ValueX(plotX, plotW, xLo, maxXN, s.bubbles[j].x);
                    int py = Chart.ValueY(plotY, plotH, yLo, maxYN, s.bubbles[j].y);
                    int rr = ChartView.ISqrt(s.bubbles[j].weight) * maxR / rootMaxW;
                    if (rr < app.Scale(2)) { rr = app.Scale(2); }
                    rr = rr * g / 1000;
                    int col = s.color;
                    if (col == 0) { col = Chart.Palette(t, r); }
                    c.FillCircle(px, py, rr, Chart.WithAlpha(col, 80));
                    j = j + 1;
                }
            }
        }
        c.PopClip();

        int mx = app.mouseX;
        int my = app.mouseY;
        if (mx >= plotX && mx < plotX + plotW
            && my >= plotY && my < plotY + plotH) {
            int bestS = 0 - 1;
            int bestJ = 0;
            int bestD = 0;
            for (int r2 = 0; r2 < o.series.Count; r2 = r2 + 1) {
                ChartSeries s2 = o.series[r2];
                if (!s2.hidden) {
                    int j2 = i0;
                    while (j2 <= i1 && j2 < s2.bubbles.Count) {
                        Bubble b2 = s2.bubbles[j2];
                        int px2 = Chart.ValueX(plotX, plotW, xLo, maxXN, b2.x);
                        int py2 = Chart.ValueY(plotY, plotH, yLo, maxYN, b2.y);
                        int rr2 = ChartView.ISqrt(b2.weight) * maxR / rootMaxW;
                        if (rr2 < app.Scale(2)) { rr2 = app.Scale(2); }
                        rr2 = rr2 * g / 1000;
                        int hitR2 = rr2 + app.Scale(2);
                        int ddx = mx - px2;
                        int ddy = my - py2;
                        int d2 = ddx * ddx + ddy * ddy;
                        if (rr2 > 0 && d2 <= hitR2 * hitR2
                            && (bestS < 0 || d2 < bestD)) {
                            bestS = r2;
                            bestJ = j2;
                            bestD = d2;
                        }
                        j2 = j2 + 1;
                    }
                }
            }
            if (bestS >= 0) {
                ChartSeries bs = o.series[bestS];
                Bubble bb = bs.bubbles[bestJ];
                int pxHit = Chart.ValueX(plotX, plotW, xLo, maxXN, bb.x);
                int pyHit = Chart.ValueY(plotY, plotH, yLo, maxYN, bb.y);
                ChartHit bh = ChartHit.Of(ChartElementType.ScatterPoint,
                    bestS, bs.name, bestJ, "#" + Convert.ToString(bestJ + 1),
                    bb.y, pxHit, pyHit);
                bh.xValueSet = true;
                bh.xValue = (double)bb.x;
                bh.yValueSet = true;
                bh.yValue = (double)bb.y;
                bh.axisIndex = bs.axisIndex;
                ChartView.OfferActiveHit(bh);
                if (o.showTooltip) {
                    int col = bs.color;
                    if (col == 0) { col = Chart.Palette(t, bestS); }
                    List<TooltipRow> rows = new List<TooltipRow>{
                        TooltipRow.Of(col, bs.name),
                        TooltipRow.Of(col, "x  " + Convert.ToString(bb.x)),
                        TooltipRow.Of(col, "y  " + Convert.ToString(bb.y)),
                        TooltipRow.Of(col, "w  " + Convert.ToString(bb.weight)) };
                    ChartView.TooltipCard(app, mx, my, plotX + plotW, rows);
                }
            }
        }
    }

    static List<string> BoxLabels(List<BoxItem> items) {
        List<string> labels = new List<string>();
        for (int i = 0; i < items.Count; i = i + 1) { labels.Add(items[i].label); }
        return labels;
    }

    static List<string> ErrorLabels(List<ErrorItem> items) {
        List<string> labels = new List<string>();
        for (int i = 0; i < items.Count; i = i + 1) { labels.Add(items[i].label); }
        return labels;
    }

    // ---- 箱线图 ----

    static void DrawBox(App app, int x, int y, int w, int h,
                        ChartOption o, int g) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        List<BoxItem> bx = o.series[0].boxes;
        int n = bx.Count;
        int plotTop = ChartView.PanelHead(app, x, y, w, h, o.title);
        if (n < 1) { return; }

        int lo = bx[0].lo;
        int hi = bx[0].hi;
        for (int i = 0; i < n; i = i + 1) {
            if (bx[i].lo < lo) { lo = bx[i].lo; }
            if (bx[i].hi > hi) { hi = bx[i].hi; }
        }
        int pad2 = (hi - lo) / 20;
        if (pad2 < 1) { pad2 = 1; }
        lo = lo - pad2;
        hi = hi + pad2;
        ChartFrame f = Chart.DrawFrameLoHi(app, x, y, w, h, plotTop, ChartView.BoxLabels(bx), lo, hi);
        int span = hi - lo;
        if (span < 1) { span = 1; }
        int step = f.plotW / n;
        int bw = step * 5 / 10;
        if (bw < app.Scale(6)) { bw = app.Scale(6); }

        ChartView.PushPlotClip(app, f.plotX, f.plotY, f.plotW, f.plotH);
        for (int k = 0; k < n; k = k + 1) {
            int cx = f.plotX + k * step + step / 2;
            int col = Chart.Palette(t, k);
            if (o.series[0].color != 0) { col = o.series[0].color; }
            int yLo = f.plotY + f.plotH - (bx[k].lo - lo) * f.plotH / span;
            int yQ1 = f.plotY + f.plotH - (bx[k].q1 - lo) * f.plotH / span;
            int yMed = f.plotY + f.plotH - (bx[k].med - lo) * f.plotH / span;
            int yQ3 = f.plotY + f.plotH - (bx[k].q3 - lo) * f.plotH / span;
            int yHi = f.plotY + f.plotH - (bx[k].hi - lo) * f.plotH / span;
            c.DrawLine(cx, yHi, cx, yQ3, col, app.Scale(1));
            c.DrawLine(cx, yQ1, cx, yLo, col, app.Scale(1));
            c.DrawLine(cx - bw / 4, yHi, cx + bw / 4, yHi, col, app.Scale(1));
            c.DrawLine(cx - bw / 4, yLo, cx + bw / 4, yLo, col, app.Scale(1));
            int boxH = yQ1 - yQ3;
            if (boxH < app.Scale(1)) { boxH = app.Scale(1); }
            c.SurfaceRoundRect(cx - bw / 2, yQ3, bw, boxH, app.Scale(2), Chart.WithAlpha(col, 70), col, 1);
            c.DrawLine(cx - bw / 2, yMed, cx + bw / 2, yMed, col, app.Scale(2));
        }
        c.PopClip();

        if (o.showTooltip) {
            int mx = app.mouseX;
            int my = app.mouseY;
            if (mx >= f.plotX && mx < f.plotX + f.plotW
                && my >= f.plotY && my < f.plotY + f.plotH) {
                int tIdx = (mx - f.plotX) / step;
                if (tIdx < 0) { tIdx = 0; }
                if (tIdx > n - 1) { tIdx = n - 1; }
                string hdr = bx[tIdx].label;
                if (hdr.Length == 0) { hdr = "Service " + Convert.ToString(tIdx + 1); }
                int col = Chart.Palette(t, tIdx);
                if (o.series[0].color != 0) { col = o.series[0].color; }
                List<TooltipRow> rows = new List<TooltipRow>{
                    TooltipRow.Of(0, hdr),
                    TooltipRow.Of(col, "min   " + Convert.ToString(bx[tIdx].lo)),
                    TooltipRow.Of(col, "Q1    " + Convert.ToString(bx[tIdx].q1)),
                    TooltipRow.Of(col, "med   " + Convert.ToString(bx[tIdx].med)),
                    TooltipRow.Of(col, "Q3    " + Convert.ToString(bx[tIdx].q3)),
                    TooltipRow.Of(col, "max   " + Convert.ToString(bx[tIdx].hi)) };
                ChartView.TooltipCard(app, mx, my, f.plotX + f.plotW, rows);
            }
        }
    }

    // ---- 误差棒（类别上的值 ± 误差） ----

    static void DrawError(App app, int x, int y, int w, int h,
                          ChartOption o, int g) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        List<ErrorItem> es = o.series[0].errors;
        int n = es.Count;
        int plotTop = ChartView.PanelHead(app, x, y, w, h, o.title);
        if (n < 1) { return; }

        int maxV = 0;
        for (int i = 0; i < n; i = i + 1) {
            int top = es[i].y + es[i].err;
            if (top > maxV) { maxV = top; }
        }
        int nice = Chart.NiceMax(maxV);
        if (nice < 1) { nice = 1; }
        ChartFrame f = Chart.DrawFrame(app, x, y, w, h, plotTop, ChartView.ErrorLabels(es), nice);
        int step = f.plotW / n;
        int color = Style.Part(app, "chart", "accent", "", "", "",
                               Style.SNormal()).BgOr(0);
        if (o.series[0].color != 0) { color = o.series[0].color; }
        ChartView.PushPlotClip(app, f.plotX, f.plotY, f.plotW, f.plotH);
        List<int> lx = new List<int>();
        List<int> ly = new List<int>();
        for (int k = 0; k < n; k = k + 1) {
            int cx = f.plotX + k * step + step / 2;
            int vy = f.plotY + f.plotH - (es[k].y * g / 1000 * f.plotH / nice);
            int eTop = f.plotY + f.plotH - ((es[k].y + es[k].err) * f.plotH / nice);
            int eBot = f.plotY + f.plotH - ((es[k].y - es[k].err) * f.plotH / nice);
            c.DrawLine(cx, eTop, cx, eBot, Chart.WithAlpha(color, 160), app.Scale(1));
            c.DrawLine(cx - app.Scale(4), eTop, cx + app.Scale(4), eTop, color, app.Scale(1));
            c.DrawLine(cx - app.Scale(4), eBot, cx + app.Scale(4), eBot, color, app.Scale(1));
            lx.Add(cx);
            ly.Add(vy);
            c.FillCircle(cx, vy, app.Scale(3), color);
        }
        if (lx.Count > 1) { c.DrawPolyline(lx, ly, color, app.Scale(2)); }
        c.PopClip();

        if (o.showTooltip) {
            int mx = app.mouseX;
            int my = app.mouseY;
            if (mx >= f.plotX && mx < f.plotX + f.plotW
                && my >= f.plotY && my < f.plotY + f.plotH) {
                int tIdx = (mx - f.plotX) / step;
                if (tIdx < 0) { tIdx = 0; }
                if (tIdx > n - 1) { tIdx = n - 1; }
                List<string> labs = o.XCategories();
                string hdr = "";
                if (tIdx < labs.Count) { hdr = labs[tIdx]; }
                if (hdr.Length == 0) { hdr = "Item " + Convert.ToString(tIdx + 1); }
                List<TooltipRow> rows = new List<TooltipRow>{
                    TooltipRow.Of(0, hdr),
                    TooltipRow.Of(color,
                        Convert.ToString(es[tIdx].y) + " ± " + Convert.ToString(es[tIdx].err)) };
                ChartView.TooltipCard(app, mx, my, f.plotX + f.plotW, rows);
            }
        }
    }
}
