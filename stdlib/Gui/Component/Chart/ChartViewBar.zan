using System;
using System.Json;
using Gui;

namespace Gui.Component.Chart;

partial class ChartView {
    // ---- 柱状图（分组 / 堆叠 / 水平） ----

    static void DrawBars(App app, int x, int y, int w, int h,
                         ChartOption o, int g, bool stacked, bool horizontal) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        List<ChartSeries> series = o.series;
        List<string> labels = o.XCategories();

        if (horizontal) {
            // 水平布局委托给 HBar 渲染器，
            // 增长因子通过预缩放临时序列集施加。任何
            // 带 stackName 的序列都会使布局成为水平堆叠组。
            bool hstack = false;
            for (int hsi = 0; hsi < series.Count; hsi = hsi + 1) {
                if (series[hsi].stackName.Length > 0) { hstack = true; }
            }
            ChartView.HBarCore(app, x, y, w, h, o.title, labels, ChartView.Scaled(series, g), hstack, o.showLegend);
            return;
        }

        // dataZoom：锁定窗口索引 [i0,i1]（含端点）并预留底部
        // 滑块条带。渲染循环直接读原系列（数据索引 = i0+i），
        // 不做有损的系列克隆；标签按窗口取子列表。
        int zoomH = 0;
        int fullN = labels.Count;
        int i0 = 0;
        int i1 = fullN - 1;
        if (o.zoom && o.iwid != 0 && fullN > 1) {
            i0 = Chart.ZoomI0(app, o, o.iwid, fullN);
            i1 = Chart.ZoomI1(app, o, o.iwid, fullN);
            zoomH = app.Scale(24);
        }
        List<string> winLabels = Chart.WindowLabels(labels, i0, i1);

        int n = winLabels.Count;
        int ns = series.Count;

        int leftData = 0 - 1;
        if (stacked) { leftData = Chart.MaxStackW(series, n, i0); }
        int plotTop = Chart.DrawPanelI(app, x, y, w, h, o.title, series, o.iwid, o.showLegend);
        ChartFrame f = Chart.BuildAxesR(app, x, y, w, h - zoomH, plotTop, winLabels, o, series, leftData, 0 - 1);
        if (zoomH > 0) {
            Chart.DrawZoomBar(app, f.plotX, f.plotW, y + h - app.Scale(18),
                app.Scale(12), o.iwid, fullN);
        }
        Chart.DrawMarkArea(app, f, o);
        int maxV = f.leftMax;
        if (n < 1 || ns < 1) { return; }

        int step = f.plotW / n;
        int rad = app.Scale(3);
        if (!o.rounded) { rad = app.Scale(1); }

        // 可见柱状族序列数量（折线族覆盖层不占槽位）
        int nsVis = 0;
        for (int cs = 0; cs < ns; cs = cs + 1) {
            ChartSeries sc = series[cs];
            if (!sc.hidden && !ChartView.IsLineFamily(sc.type)) { nsVis = nsVis + 1; }
        }
        if (nsVis < 1) { nsVis = 1; }

        if (stacked) {
            // 按 stackName 分组的堆叠柱（ECharts `stack` 分组）：
            // 共享 stackName 的序列堆成一列；不同组并排
            // 排列。折线族覆盖层画在上方，从不堆叠。
            List<string> grp = new List<string>();
            for (int gsi = 0; gsi < ns; gsi = gsi + 1) {
                ChartSeries sc = series[gsi];
                if (!sc.hidden && !ChartView.IsLineFamily(sc.type)) {
                    if (ChartView.GroupIndex(grp, sc.stackName) < 0) { grp.Add(sc.stackName); }
                }
            }
            int ng = grp.Count;
            if (ng < 1) { ng = 1; }
            int groupW = step * 9 / 10;
            int barW = groupW / ng;
            if (barW < app.Scale(2)) { barW = app.Scale(2); }
            int groupX0 = (step - groupW) / 2;
            List<int> accs = new List<int>();
            for (int ai = 0; ai < ng; ai = ai + 1) { accs.Add(0); }
            // 每组最后（最顶）一个序列：只有它带圆角顶，
            // 使堆叠色带以平整直角相接，与 ECharts 一致。
            List<int> topSi = new List<int>();
            for (int ti = 0; ti < ng; ti = ti + 1) { topSi.Add(0 - 1); }
            for (int ts = 0; ts < ns; ts = ts + 1) {
                ChartSeries tc = series[ts];
                if (!tc.hidden && !ChartView.IsLineFamily(tc.type)) {
                    int g2 = ChartView.GroupIndex(grp, tc.stackName);
                    if (g2 < 0) { g2 = 0; }
                    topSi[g2] = ts;
                }
            }
            for (int i = 0; i < n; i = i + 1) {
                int oi = i0 + i;
                for (int a2 = 0; a2 < ng; a2 = a2 + 1) { accs[a2] = 0; }
                for (int si = 0; si < ns; si = si + 1) {
                    ChartSeries sc = series[si];
                    if (!sc.hidden && !ChartView.IsLineFamily(sc.type)) {
                        int gi = ChartView.GroupIndex(grp, sc.stackName);
                        if (gi < 0) { gi = 0; }
                        int v = 0;
                        if (oi < sc.Count()) { v = sc.Value(oi); }
                        int bx = f.plotX + i * step + groupX0 + gi * barW;
                        int yTop = f.YOf((accs[gi] + v) * g / 1000, 0);
                        int yBot = f.YOf(accs[gi] * g / 1000, 0);
                        int segH = yBot - yTop;
                        // 色带边缘相接（无 1px 缝隙）：圆角柱内的缺口
                        // 会显得像渲染瑕疵，而颜色
                        // 变化本身已足以区分各层。
                        int drawTop = yTop;
                        int segRad = rad;
                        if (si != topSi[gi]) { segRad = 0; }
                        ChartView.BarCell(c, bx, drawTop, barW, segH, segRad, sc.color, o.gradient);
                        accs[gi] = accs[gi] + v;
                    }
                }
            }
            // 折线覆盖层（如堆叠柱上方的合计线）。
            for (int ov = 0; ov < ns; ov = ov + 1) {
                ChartSeries s = series[ov];
                if (!s.hidden && ChartView.IsLineFamily(s.type)) {
                    List<int> lpx = new List<int>();
                    List<int> lpy = new List<int>();
                    for (int oi2 = 0; oi2 < n; oi2 = oi2 + 1) {
                        int oi3 = i0 + oi2;
                        if (oi3 >= s.Count()) { continue; }
                        lpx.Add(f.plotX + oi2 * step + step / 2);
                        lpy.Add(f.YOf(s.Value(oi3) * g / 1000, s.axisIndex));
                    }
                    bool smooth = o.smooth;
                    if (s.smooth == 1) { smooth = true; } else if (s.smooth == 0) { smooth = false; }
                    ChartView.PolyLine(c, lpx, lpy, smooth, s.color, app.Scale(2));
                    for (int d2 = 0; d2 < lpx.Count; d2 = d2 + 1) { c.FillCircle(lpx[d2], lpy[d2], app.Scale(3), s.color); }
                }
            }
        } else {
            // 分组柱 + 可选折线族覆盖层（混合图表）
            int groupW = step * 7 / 10;
            int gap = app.Scale(2);
            int barW = (groupW - gap * (nsVis - 1)) / nsVis;
            if (barW < app.Scale(2)) { barW = app.Scale(2); }
            int groupX0 = (step - groupW) / 2;

            int barSlot = 0;
            for (int si = 0; si < ns; si = si + 1) {
                ChartSeries s = series[si];
                if (!s.hidden) {
                    int ax = s.axisIndex;
                    if (ChartView.IsLineFamily(s.type)) {
                        // 在组中心上方以折线绘制
                        List<int> lpx = new List<int>();
                        List<int> lpy = new List<int>();
                        for (int li = 0; li < n; li = li + 1) {
                            int oiL = i0 + li;
                            if (oiL >= s.Count()) { continue; }
                            lpx.Add(f.plotX + li * step + step / 2);
                            lpy.Add(f.YOf(s.Value(oiL) * g / 1000, ax));
                        }
                        bool smooth = o.smooth;
                        if (s.smooth == 1) { smooth = true; } else if (s.smooth == 0) { smooth = false; }
                        ChartView.PolyLine(c, lpx, lpy, smooth, s.color, app.Scale(2));
                        for (int di = 0; di < lpx.Count; di = di + 1) { c.FillCircle(lpx[di], lpy[di], app.Scale(3), s.color); }
                    } else if (s.type == ChartType.Scatter) {
                        for (int sp = 0; sp < n; sp = sp + 1) {
                            int oiS = i0 + sp;
                            if (oiS >= s.Count()) { continue; }
                            int v = s.Value(oiS) * g / 1000;
                            int px2 = f.plotX + sp * step + step / 2;
                            int py2 = f.YOf(v, ax);
                            c.FillCircle(px2, py2, app.Scale(3), s.color);
                        }
                    } else {
                        int zeroY = f.YOf(0, ax);
                        for (int i = 0; i < n; i = i + 1) {
                            int oi = i0 + i;
                            int v = 0;
                            if (oi < s.Count()) { v = s.Value(oi); }
                            // 逐项颜色（ChartData.Colored）优先于
                            // 序列颜色 —— ECharts 的三级颜色控制。
                            int col = s.color;
                            if (oi < s.data.Count && s.data[oi].color != 0) { col = s.data[oi].color; }
                            int by = f.YOf(v * g / 1000, ax);
                            int bx = f.plotX + i * step + groupX0 + barSlot * (barW + gap);
                            if (v < 0) {
                                // 负值柱条垂挂在零基线下方
                                int bh = zeroY - by;
                                if (bh < 0) { bh = 0 - bh; }
                                ChartView.BarCell(c, bx, zeroY, barW, bh, rad, col, o.gradient);
                                if (o.showValues || s.labelShow) {
                                    string lbl = Convert.ToString(v);
                                    int lw = Canvas.MeasureText(lbl, Style.FontFallback(app, "small"));
                                    c.DrawText(bx + (barW - lw) / 2, by + app.Scale(4), lbl,
                                        Style.Part(app, "chart", "label", "", "", "", Style.SNormal()).FgOr(0),
                                        Style.FontFallback(app, "small"));
                                }
                            } else {
                                int bh = zeroY - by;
                                if (bh < 0) { bh = 0; }
                                ChartView.BarCell(c, bx, by, barW, bh, rad, col, o.gradient);
                                if ((o.showValues || s.labelShow) && v > 0) {
                                    string lbl = Convert.ToString(v);
                                    int lw = Canvas.MeasureText(lbl, Style.FontFallback(app, "small"));
                                    c.DrawText(bx + (barW - lw) / 2, by - app.Scale(14), lbl,
                                        Style.Part(app, "chart", "label", "", "", "", Style.SNormal()).FgOr(0),
                                        Style.FontFallback(app, "small"));
                                }
                            }
                        }
                        barSlot = barSlot + 1;
                    }
                }
            }
        }

        Chart.DrawMarkLine(app, f, o);
        // markPoint：自动 max/min + 显式 marks（仅柱状族）。
        for (int msi = 0; msi < ns; msi = msi + 1) {
            ChartSeries ms = series[msi];
            if (!ms.hidden && !ChartView.IsLineFamily(ms.type)) {
                ChartView.DrawSeriesMarks(app, f, ms, i0, i1, step, step / 2, o);
            }
        }
        if (o.showTooltip) {
            ChartView.CartesianTooltip(app, f, winLabels, series, maxV, step, step / 2, i0);
        }
    }

    /// 单个柱格，可选垂直渐变（color -> 更浅色）。
    static void BarCell(Canvas c, int x, int y, int w, int h, int rad,
                        int color, bool gradient) {
        if (h <= 0) { return; }
        if (gradient) {
            int top = App.LerpColor(color, 4294967295, 150);
            c.FillRoundRect(x, y, w, h, rad, color);
            // 渐变裁切为相同的圆角轮廓（保留边角抗锯齿）：
            // 直接 FillVGrad 会用不透明渐变覆盖圆弧的混合边缘像素，
            // 把圆角变成锯齿。
            c.FillVGradMask(x, y, w, h / 2, rad, 15, top, color);
        } else {
            c.FillRoundRect(x, y, w, h, rad, color);
        }
    }

    /// 返回 `series` 的副本，每个值按 g/1000 缩放（用于
    /// 给只接受普通序列列表的渲染器做动画）。
    static List<ChartSeries> Scaled(List<ChartSeries> series, int g) {
        List<ChartSeries> outp = new List<ChartSeries>();
        for (int i = 0; i < series.Count; i = i + 1) {
            ChartSeries s = series[i];
            List<int> vs = new List<int>();
            for (int j = 0; j < s.Count(); j = j + 1) {
                vs.Add(s.Value(j) * g / 1000);
            }
            ChartSeries d = ChartSeries.Of(s.name, s.type, vs);
            d.axisIndex = s.axisIndex;
            d.stack = s.stack;
            d.color = s.color;
            d.hidden = s.hidden;
            d.smooth = s.smooth;
            outp.Add(d);
        }
        return outp;
    }

    /// 水平柱状图：类别在左纵排，数值横伸。stacked 为 true 时，
    /// 共享 stackName 的序列每组堆成一条水平色带，
    /// （对应 ECharts stacked bar4），各行上下排列各组。
    static void HBarCore(App app, int x, int y, int w, int h, string title,
                         List<string> labels, List<ChartSeries> series, bool stacked,
                         bool showLegend) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        c.PushClip(x, y, w, h);
        int pad = t.paddingMedium;
        int axisFs = Style.FontFallback(app, "small");
        int n = labels.Count;
        int ns = series.Count;
        int maxV = Chart.NiceMax(Chart.MaxOf(series));
        if (stacked) { maxV = Chart.NiceMax(Chart.MaxStackAll(series, n)); }
        int plotTop = Chart.DrawPanel(app, x, y, w, h, title, series, showLegend);

        if (n < 1 || ns < 1) { c.PopClip(); return; }

        // 最宽的类别标签决定左侧留白
        int leftGut = app.Scale(20);
        for (int li = 0; li < n; li = li + 1) {
            int lw = Canvas.MeasureText(labels[li], axisFs);
            if (lw + app.Scale(12) > leftGut) { leftGut = lw + app.Scale(12); }
        }
        int botGut = Canvas.FontHeight(axisFs) + app.Scale(8);
        int plotX = x + pad + leftGut;
        int plotY = plotTop;
        int plotW = (x + w - pad) - plotX;
        int plotH = (y + h - pad - botGut) - plotY;
        if (plotW < app.Scale(20)) { plotW = app.Scale(20); }

        // 垂直数值网格线 + 标签
        StyleBox sGrid = Style.Part(app, "chart", "grid", "", "", "",
                                    Style.SNormal());
        StyleBox sAxis = Style.Part(app, "chart", "axis", "", "", "",
                                    Style.SNormal());
        StyleBox sLabel = Style.Part(app, "chart", "label", "", "", "",
                                     Style.SNormal());
        int ticks = 5;
        for (int k = 0; k <= ticks; k = k + 1) {
            int gx = plotX + k * plotW / ticks;
            c.FillRect(gx, plotY, 1, plotH, sGrid.BgOr(0));
            string vs = Convert.ToString(maxV * k / ticks);
            c.DrawTextCentered(gx - app.Scale(20), plotY + plotH + app.Scale(4), app.Scale(40), botGut, vs, sAxis.FgOr(0), axisFs);
        }
        c.FillRect(plotX, plotY, 1, plotH, sAxis.BgOr(0));

        int rowH = plotH / n;
        int rad = app.Scale(2);

        if (stacked) {
            // 堆叠组（ECharts stackName）：同名序列从左侧起
            // 在同一色带内累计；不同组平分该行。
            List<string> grp = new List<string>();
            for (int gsi = 0; gsi < ns; gsi = gsi + 1) {
                ChartSeries sc = series[gsi];
                if (!sc.hidden && ChartView.GroupIndex(grp, sc.stackName) < 0) { grp.Add(sc.stackName); }
            }
            int ng = grp.Count;
            if (ng < 1) { ng = 1; }
            int groupH = rowH * 9 / 10;
            int barH = groupH / ng;
            if (barH < app.Scale(2)) { barH = app.Scale(2); }
            int groupY0 = (rowH - groupH) / 2;
            List<int> accs = new List<int>();
            for (int ai = 0; ai < ng; ai = ai + 1) { accs.Add(0); }
            // 每组最顶层的序列带圆角右端帽；其下色带
            // 以直角边相接并留 1px 缝隙。
            List<int> topSi = new List<int>();
            for (int ti = 0; ti < ng; ti = ti + 1) { topSi.Add(0 - 1); }
            for (int ts = 0; ts < ns; ts = ts + 1) {
                ChartSeries tc = series[ts];
                if (!tc.hidden) {
                    int g2 = ChartView.GroupIndex(grp, tc.stackName);
                    if (g2 < 0) { g2 = 0; }
                    topSi[g2] = ts;
                }
            }
            for (int i = 0; i < n; i = i + 1) {
                int rowY = plotY + i * rowH;
                c.DrawTextCentered(x + pad, rowY, leftGut - app.Scale(6), rowH, labels[i], sLabel.FgOr(0), axisFs);
                for (int a2 = 0; a2 < ng; a2 = a2 + 1) { accs[a2] = 0; }
                for (int si = 0; si < ns; si = si + 1) {
                    ChartSeries sc = series[si];
                    if (!sc.hidden) {
                        int gi = ChartView.GroupIndex(grp, sc.stackName);
                        if (gi < 0) { gi = 0; }
                        int v = 0;
                        if (i < sc.Count()) { v = sc.Value(i); }
                        int accW = (accs[gi] + v) * plotW / maxV;
                        int by = rowY + groupY0 + gi * barH;
                        int segW = accW - accs[gi] * plotW / maxV;
                        int drawX = plotX + 1 + accs[gi] * plotW / maxV;
                        // 色带边缘相接（无 1px 缝隙），
                        // 与垂直堆叠柱一致：颜色变化
                        // 即可区分各层，无需缺口。
                        int segRad = rad;
                        if (si != topSi[gi]) { segRad = 0; }
                        c.FillRoundRect(drawX, by, segW, barH, segRad, sc.color);
                        accs[gi] = accs[gi] + v;
                    }
                }
            }
        } else {
            int groupH = rowH * 7 / 10;
            int gap = app.Scale(2);
            int barH = (groupH - gap * (ns - 1)) / ns;
            if (barH < app.Scale(2)) { barH = app.Scale(2); }
            int groupY0 = (rowH - groupH) / 2;

            for (int i = 0; i < n; i = i + 1) {
                int rowY = plotY + i * rowH;
                c.DrawTextCentered(x + pad, rowY, leftGut - app.Scale(6), rowH, labels[i], sLabel.FgOr(0), axisFs);
                for (int si = 0; si < ns; si = si + 1) {
                    int v = 0;
                    if (i < series[si].Count()) { v = series[si].Value(i); }
                    int bw = v * plotW / maxV;
                    int by = rowY + groupY0 + si * (barH + gap);
                    c.FillRoundRect(plotX + 1, by, bw, barH, rad, series[si].color);
                }
            }
        }
        c.PopClip();
    }

    // ---- 饼图 / 环形图（扫掠角随 g 增长） ----
    static void DrawWaterfall(App app, int x, int y, int w, int h,
                              ChartOption o, int g) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        List<ChartSeries> series = o.series;
        if (series.Count < 1) { return; }
        ChartSeries s = series[0];
        List<string> labels = o.XCategories();
        int fullN = labels.Count;
        if (fullN < 1) { return; }

        // dataZoom：窗口索引 [i0,i1]（含端点）。累计量在整个
        // 数据上计算后再切片，使窗口内的柱条延续窗口前的
        // 累计值，而不是从 0 重启。
        int zoomH = 0;
        int i0 = 0;
        int i1 = fullN - 1;
        if (o.zoom && o.iwid != 0 && fullN > 1) {
            i0 = Chart.ZoomI0(app, o, o.iwid, fullN);
            i1 = Chart.ZoomI1(app, o, o.iwid, fullN);
            zoomH = app.Scale(24);
        }
        List<string> winLabels = Chart.WindowLabels(labels, i0, i1);
        int n = winLabels.Count;
        if (n < 1) { return; }

        List<int> cumAll = new List<int>();
        int acc = 0;
        for (int ii = 0; ii < fullN; ii = ii + 1) {
            int v = 0;
            if (ii < s.Count()) { v = s.Value(ii); }
            if (ii < s.data.Count && s.data[ii].name == "total") { cumAll.Add(acc); }
            else { acc = acc + v; cumAll.Add(acc); }
        }
        int maxC = acc;
        int minC = 0;
        int fi = 0;
        while (fi < fullN) {
            if (cumAll[fi] > maxC) { maxC = cumAll[fi]; }
            if (cumAll[fi] < minC) { minC = cumAll[fi]; }
            fi = fi + 1;
        }
        if (maxC < 1 && minC >= 0) { maxC = 1; }

        // 自动数值轴，覆盖负的累计值（基线为 0）。
        if (o.yAxes.Count == 0 && minC < 0) {
            o.yAxes.Add(ChartAxis.ValueRange(minC, Chart.NiceMax(maxC)));
        }
        int plotTop = Chart.DrawPanelI(app, x, y, w, h, o.title, series, o.iwid, o.showLegend);
        ChartFrame f = Chart.BuildAxesR(app, x, y, w, h - zoomH, plotTop, winLabels, o, series, maxC, 0 - 1);
        if (zoomH > 0) {
            Chart.DrawZoomBar(app, f.plotX, f.plotW, y + h - app.Scale(18),
                app.Scale(12), o.iwid, fullN);
        }
        int step = f.plotW / n;
        if (step < 1) { step = 1; }
        int barW = step * 5 / 10;
        if (barW < app.Scale(2)) { barW = app.Scale(2); }
        int bx0 = (step - barW) / 2;
        int rad = app.Scale(3);
        if (!o.rounded) { rad = app.Scale(1); }

        StyleBox sAccent = Style.Part(app, "chart", "accent", "", "", "",
                                      Style.SNormal());
        StyleBox sMark = Style.Part(app, "chart", "mark", "", "", "",
                                    Style.SNormal());
        StyleBox sGrid = Style.Part(app, "chart", "grid", "", "", "",
                                    Style.SNormal());
        int prev = 0;
        if (i0 > 0) { prev = cumAll[i0 - 1]; }
        for (int ci = 0; ci < n; ci = ci + 1) {
            int oi = i0 + ci;
            int v = 0;
            if (oi < s.Count()) { v = s.Value(oi); }
            bool isTotal = (oi < s.data.Count && s.data[oi].name == "total");
            int topV = prev;
            int botV = prev;
            if (isTotal) { topV = acc; botV = 0; }
            else { topV = prev + v; botV = prev; }
            int yTop = f.YOf(topV, 0);
            int yBot = f.YOf(botV, 0);
            if (yBot < yTop) { int tmp = yTop; yTop = yBot; yBot = tmp; }
            int col = s.color;
            if (col == 0) { col = Chart.Palette(t, 0); }
            if (isTotal) { col = sAccent.BgOr(0); }
            else if (v < 0) { col = sMark.BgOr(0); }
            ChartView.BarCell(c, f.plotX + ci * step + bx0, yTop, barW, yBot - yTop, rad, col, o.gradient);

            // 从前一柱顶到当前柱底的连接线
            if (ci > 0) {
                int px0 = f.plotX + (ci - 1) * step + bx0 + barW;
                int px1 = f.plotX + ci * step + bx0;
                int pyc = f.YOf(prev, 0);
                c.DrawLine(px0, pyc, px1, pyc, sGrid.BgOr(0), app.Scale(1));
            }
            if (!isTotal) { prev = prev + v; }

            if (o.showValues || s.labelShow) {
                string lbl = Convert.ToString(v);
                int lw = Canvas.MeasureText(lbl, Style.FontFallback(app, "small"));
                int lx2 = f.plotX + ci * step + bx0 + (barW - lw) / 2;
                int ly2 = yTop - app.Scale(14);
                if (ly2 < f.plotY) { ly2 = yTop + app.Scale(2); }
                c.DrawText(lx2, ly2, lbl,
                    Style.Part(app, "chart", "label", "", "", "", Style.SNormal()).FgOr(0),
                    Style.FontFallback(app, "small"));
            }
        }
        Chart.DrawMarkLine(app, f, o);

        if (o.showTooltip) {
            int mx = app.mouseX;
            int my = app.mouseY;
            if (mx >= f.plotX && mx < f.plotX + f.plotW
                && my >= f.plotY && my < f.plotY + f.plotH) {
                int tIdx = (mx - f.plotX) / step;
                if (tIdx < 0) { tIdx = 0; }
                if (tIdx > n - 1) { tIdx = n - 1; }
                int oiT = i0 + tIdx;
                int tv = 0;
                if (oiT < s.Count()) { tv = s.Value(oiT); }
                bool tIsTotal = (oiT < s.data.Count && s.data[oiT].name == "total");
                string nm = winLabels[tIdx];
                if (nm.Length == 0) { nm = "Step " + Convert.ToString(tIdx + 1); }
                string vtxt = Convert.ToString(tv);
                if (tv >= 0) { vtxt = "+" + vtxt; }
                if (tIsTotal) { vtxt = Convert.ToString(acc); }
                int col = s.color;
                if (col == 0) { col = Chart.Palette(t, 0); }
                if (tIsTotal) { col = sAccent.BgOr(0); }
                else if (tv < 0) { col = sMark.BgOr(0); }
                List<TooltipRow> rows = new List<TooltipRow>{
                    TooltipRow.Of(0, o.title),
                    TooltipRow.Of(col, nm + "  " + vtxt) };
                ChartView.TooltipCard(app, mx, my, f.plotX + f.plotW, rows);
            }
        }
    }
}
