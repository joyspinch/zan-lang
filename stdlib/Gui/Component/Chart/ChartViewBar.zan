using System;
using System.Json;
using Gui;

namespace Gui.Component.Chart;

partial class ChartView {
    // ---- bars (grouped / stacked / horizontal) ----

    static void DrawBars(App app, int x, int y, int w, int h,
                         ChartOption o, int g, bool stacked, bool horizontal) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        List<ChartSeries> series = o.series;
        List<string> labels = o.XCategories();

        if (horizontal) {
            // Delegate the horizontal layout to the HBar renderer, then the
            // grow factor is applied by pre-scaling a temporary series set. Any
            // series with a stackName makes the layout a horizontal stack group.
            bool hstack = false;
            for (int hsi = 0; hsi < series.Count; hsi = hsi + 1) {
                if (series[hsi].stackName.Length > 0) { hstack = true; }
            }
            ChartView.HBarCore(app, x, y, w, h, o.title, labels, ChartView.Scaled(series, g), hstack);
            return;
        }

        // dataZoom: window the categories and reserve a bottom strip.
        int zoomH = 0;
        int fullN = labels.Count;
        if (o.zoom && o.iwid != 0 && fullN > 1) {
            int wi0 = Chart.ZoomI0(app, o.iwid, fullN);
            int wi1 = Chart.ZoomI1(app, o.iwid, fullN);
            series = Chart.Window(series, wi0, wi1);
            labels = Chart.WindowLabels(labels, wi0, wi1);
            zoomH = app.Scale(24);
        }

        int n = labels.Count;
        int ns = series.Count;

        int leftData = 0 - 1;
        if (stacked) { leftData = Chart.MaxStack(series, n); }
        int plotTop = Chart.DrawPanelI(app, x, y, w, h, o.title, series, o.iwid);
        ChartFrame f = Chart.BuildAxesR(app, x, y, w, h - zoomH, plotTop, labels, o, series, leftData, 0 - 1);
        if (zoomH > 0) {
            Chart.DrawZoomBar(app, f.plotX, f.plotW, y + h - app.Scale(18),
                app.Scale(12), o.iwid, fullN);
        }
        Chart.DrawMarkArea(app, f, o);
        int maxV = f.leftMax;
        if (n < 1 || ns < 1) { return; }

        int step = f.plotW / n;
        int rad = app.Scale(3);
        if (!o.rounded) { rad = app.Scale(1); }

        // number of visible bar-family series (line-family overlays don't take a slot)
        int nsVis = 0;
        for (int cs = 0; cs < ns; cs = cs + 1) {
            ChartSeries sc = series[cs];
            if (!sc.hidden && !ChartView.IsLineFamily(sc.type)) { nsVis = nsVis + 1; }
        }
        if (nsVis < 1) { nsVis = 1; }

        if (stacked) {
            // Stacked bars, grouped by stackName (ECharts `stack` groups): series
            // sharing a stackName stack into one column; different groups sit side
            // by side. Line-family overlays draw on top, never stacked.
            List<string> grp = new List<string>();
            for (int gsi = 0; gsi < ns; gsi = gsi + 1) {
                ChartSeries sc = series[gsi];
                if (!sc.hidden && !ChartView.IsLineFamily(sc.type)) {
                    if (ChartView.GroupIndex(grp, sc.stackName) < 0) { grp.Add(sc.stackName); }
                }
            }
            int ng = grp.Count;
            if (ng < 1) { ng = 1; }
            int groupW = step * 9 / 10;
            int barW = groupW / ng;
            if (barW < app.Scale(2)) { barW = app.Scale(2); }
            int groupX0 = (step - groupW) / 2;
            List<int> accs = new List<int>();
            for (int ai = 0; ai < ng; ai = ai + 1) { accs.Add(0); }
            // Last (topmost) series per group: only it carries the rounded top,
            // so the stacked bands meet on clean square edges, ECharts-style.
            List<int> topSi = new List<int>();
            for (int ti = 0; ti < ng; ti = ti + 1) { topSi.Add(0 - 1); }
            for (int ts = 0; ts < ns; ts = ts + 1) {
                ChartSeries tc = series[ts];
                if (!tc.hidden && !ChartView.IsLineFamily(tc.type)) {
                    int g2 = ChartView.GroupIndex(grp, tc.stackName);
                    if (g2 < 0) { g2 = 0; }
                    topSi[g2] = ts;
                }
            }
            for (int i = 0; i < n; i = i + 1) {
                for (int a2 = 0; a2 < ng; a2 = a2 + 1) { accs[a2] = 0; }
                for (int si = 0; si < ns; si = si + 1) {
                    ChartSeries sc = series[si];
                    if (!sc.hidden && !ChartView.IsLineFamily(sc.type)) {
                        int gi = ChartView.GroupIndex(grp, sc.stackName);
                        if (gi < 0) { gi = 0; }
                        int v = 0;
                        if (i < sc.Count()) { v = sc.Value(i); }
                        int bx = f.plotX + i * step + groupX0 + gi * barW;
                        int yTop = f.YOf((accs[gi] + v) * g / 1000, 0);
                        int yBot = f.YOf(accs[gi] * g / 1000, 0);
                        int segH = yBot - yTop;
                        // Bands meet edge-to-edge (no 1px seam): a notch inside
                        // a rounded column reads as an artifact, and the color
                        // change itself already separates the layers.
                        int drawTop = yTop;
                        int segRad = rad;
                        if (si != topSi[gi]) { segRad = 0; }
                        ChartView.BarCell(c, bx, drawTop, barW, segH, segRad, sc.color, o.gradient);
                        accs[gi] = accs[gi] + v;
                    }
                }
            }
            // Line overlays (e.g. a total line over the stacked columns).
            for (int ov = 0; ov < ns; ov = ov + 1) {
                ChartSeries s = series[ov];
                if (!s.hidden && ChartView.IsLineFamily(s.type)) {
                    List<int> lpx = new List<int>();
                    List<int> lpy = new List<int>();
                    for (int oi = 0; oi < n && oi < s.Count(); oi = oi + 1) {
                        lpx.Add(f.plotX + oi * step + step / 2);
                        lpy.Add(f.YOf(s.Value(oi) * g / 1000, s.axisIndex));
                    }
                    bool smooth = o.smooth;
                    if (s.smooth == 1) { smooth = true; } else if (s.smooth == 0) { smooth = false; }
                    ChartView.PolyLine(c, lpx, lpy, smooth, s.color, app.Scale(2));
                    for (int d2 = 0; d2 < lpx.Count; d2 = d2 + 1) { c.FillCircle(lpx[d2], lpy[d2], app.Scale(3), s.color); }
                }
            }
        } else {
            // Grouped bars + optional line-family overlays (mixed charts)
            int groupW = step * 7 / 10;
            int gap = app.Scale(2);
            int barW = (groupW - gap * (nsVis - 1)) / nsVis;
            if (barW < app.Scale(2)) { barW = app.Scale(2); }
            int groupX0 = (step - groupW) / 2;

            int barSlot = 0;
            for (int si = 0; si < ns; si = si + 1) {
                ChartSeries s = series[si];
                if (!s.hidden) {
                    int ax = s.axisIndex;
                    if (ChartView.IsLineFamily(s.type)) {
                        // draw as a polyline over the group centers
                        List<int> lpx = new List<int>();
                        List<int> lpy = new List<int>();
                        for (int li = 0; li < n && li < s.Count(); li = li + 1) {
                            lpx.Add(f.plotX + li * step + step / 2);
                            lpy.Add(f.YOf(s.Value(li) * g / 1000, ax));
                        }
                        bool smooth = o.smooth;
                        if (s.smooth == 1) { smooth = true; } else if (s.smooth == 0) { smooth = false; }
                        ChartView.PolyLine(c, lpx, lpy, smooth, s.color, app.Scale(2));
                        for (int di = 0; di < lpx.Count; di = di + 1) { c.FillCircle(lpx[di], lpy[di], app.Scale(3), s.color); }
                    } else if (s.type == ChartType.Scatter) {
                        for (int sp = 0; sp < n && sp < s.Count(); sp = sp + 1) {
                            int v = s.Value(sp) * g / 1000;
                            int px2 = f.plotX + sp * step + step / 2;
                            int py2 = f.YOf(v, ax);
                            c.FillCircle(px2, py2, app.Scale(3), s.color);
                        }
                    } else {
                        int zeroY = f.YOf(0, ax);
                        for (int i = 0; i < n; i = i + 1) {
                            int v = 0;
                            if (i < s.Count()) { v = s.Value(i); }
                            // per-item colour (ChartData.Colored) overrides the
                            // series colour -- ECharts' three-level control.
                            int col = s.color;
                            if (i < s.data.Count && s.data[i].color != 0) { col = s.data[i].color; }
                            int by = f.YOf(v * g / 1000, ax);
                            int bx = f.plotX + i * step + groupX0 + barSlot * (barW + gap);
                            if (v < 0) {
                                // negative bar hangs below the zero baseline
                                int bh = zeroY - by;
                                if (bh < 0) { bh = 0 - bh; }
                                ChartView.BarCell(c, bx, zeroY, barW, bh, rad, col, o.gradient);
                                if (o.showValues) {
                                    string lbl = Convert.ToString(v);
                                    int lw = Canvas.MeasureText(lbl, t.fontSizeSmall);
                                    c.DrawText(bx + (barW - lw) / 2, by + app.Scale(4), lbl,
                                        t.textSecondary, t.fontSizeSmall);
                                }
                            } else {
                                int bh = zeroY - by;
                                if (bh < 0) { bh = 0; }
                                ChartView.BarCell(c, bx, by, barW, bh, rad, col, o.gradient);
                                if (o.showValues && v > 0) {
                                    string lbl = Convert.ToString(v);
                                    int lw = Canvas.MeasureText(lbl, t.fontSizeSmall);
                                    c.DrawText(bx + (barW - lw) / 2, by - app.Scale(14), lbl,
                                        t.textSecondary, t.fontSizeSmall);
                                }
                            }
                        }
                        barSlot = barSlot + 1;
                    }
                }
            }
        }

        Chart.DrawMarkLine(app, f, o);
        if (o.showTooltip) {
            ChartView.CartesianTooltip(app, f, labels, series, maxV, step, step / 2);
        }
    }

    /// One bar cell, optionally with a vertical gradient (color -> lighter).
    static void BarCell(Canvas c, int x, int y, int w, int h, int rad,
                        int color, bool gradient) {
        if (h <= 0) { return; }
        if (gradient) {
            int top = App.LerpColor(color, 4294967295, 150);
            c.FillRoundRect(x, y, w, h, rad, color);
            // Gradient cut to the same rounded silhouette (corner AA preserved):
            // a plain FillVGrad would overwrite the arc's blended edge pixels
            // with opaque gradient and turn the corners into jagged teeth.
            c.FillVGradMask(x, y, w, h / 2, rad, 15, top, color);
        } else {
            c.FillRoundRect(x, y, w, h, rad, color);
        }
    }

    /// Returns a copy of `series` with every value scaled by g/1000 (used to
    /// animate renderers that only accept a plain series list).
    static List<ChartSeries> Scaled(List<ChartSeries> series, int g) {
        List<ChartSeries> outp = new List<ChartSeries>();
        for (int i = 0; i < series.Count; i = i + 1) {
            ChartSeries s = series[i];
            List<int> vs = new List<int>();
            for (int j = 0; j < s.Count(); j = j + 1) {
                vs.Add(s.Value(j) * g / 1000);
            }
            ChartSeries d = ChartSeries.Of(s.name, s.type, vs);
            d.axisIndex = s.axisIndex;
            d.stack = s.stack;
            d.color = s.color;
            d.hidden = s.hidden;
            d.smooth = s.smooth;
            outp.Add(d);
        }
        return outp;
    }

    /// Horizontal bars: categories down the left, values across. With stacked
    /// true, series sharing a stackName stack into one horizontal band per group
    /// (ECharts stacked bar4), groups sitting above each other per row.
    static void HBarCore(App app, int x, int y, int w, int h, string title,
                         List<string> labels, List<ChartSeries> series, bool stacked) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        c.PushClip(x, y, w, h);
        int pad = t.paddingMedium;
        int axisFs = t.fontSizeSmall;
        int n = labels.Count;
        int ns = series.Count;
        int maxV = Chart.NiceMax(Chart.MaxOf(series));
        if (stacked) { maxV = Chart.NiceMax(Chart.MaxStackAll(series, n)); }
        int plotTop = Chart.DrawPanel(app, x, y, w, h, title, series);

        if (n < 1 || ns < 1) { c.PopClip(); return; }

        // widest category label sets the left gutter
        int leftGut = app.Scale(20);
        for (int li = 0; li < n; li = li + 1) {
            int lw = Canvas.MeasureText(labels[li], axisFs);
            if (lw + app.Scale(12) > leftGut) { leftGut = lw + app.Scale(12); }
        }
        int botGut = Canvas.FontHeight(axisFs) + app.Scale(8);
        int plotX = x + pad + leftGut;
        int plotY = plotTop;
        int plotW = (x + w - pad) - plotX;
        int plotH = (y + h - pad - botGut) - plotY;
        if (plotW < app.Scale(20)) { plotW = app.Scale(20); }

        // vertical value gridlines + labels
        int ticks = 5;
        for (int k = 0; k <= ticks; k = k + 1) {
            int gx = plotX + k * plotW / ticks;
            c.FillRect(gx, plotY, 1, plotH, t.divider);
            string vs = Convert.ToString(maxV * k / ticks);
            c.DrawTextCentered(gx - app.Scale(20), plotY + plotH + app.Scale(4), app.Scale(40), botGut, vs, t.textTertiary, axisFs);
        }
        c.FillRect(plotX, plotY, 1, plotH, t.borderSecondary);

        int rowH = plotH / n;
        int rad = app.Scale(2);

        if (stacked) {
            // Stack groups (ECharts stackName): series sharing a name accumulate
            // in one band from the left edge; different groups split the row.
            List<string> grp = new List<string>();
            for (int gsi = 0; gsi < ns; gsi = gsi + 1) {
                ChartSeries sc = series[gsi];
                if (!sc.hidden && ChartView.GroupIndex(grp, sc.stackName) < 0) { grp.Add(sc.stackName); }
            }
            int ng = grp.Count;
            if (ng < 1) { ng = 1; }
            int groupH = rowH * 9 / 10;
            int barH = groupH / ng;
            if (barH < app.Scale(2)) { barH = app.Scale(2); }
            int groupY0 = (rowH - groupH) / 2;
            List<int> accs = new List<int>();
            for (int ai = 0; ai < ng; ai = ai + 1) { accs.Add(0); }
            // Topmost series per group carries the rounded right cap; bands below
            // meet on square edges with a 1px seam.
            List<int> topSi = new List<int>();
            for (int ti = 0; ti < ng; ti = ti + 1) { topSi.Add(0 - 1); }
            for (int ts = 0; ts < ns; ts = ts + 1) {
                ChartSeries tc = series[ts];
                if (!tc.hidden) {
                    int g2 = ChartView.GroupIndex(grp, tc.stackName);
                    if (g2 < 0) { g2 = 0; }
                    topSi[g2] = ts;
                }
            }
            for (int i = 0; i < n; i = i + 1) {
                int rowY = plotY + i * rowH;
                c.DrawTextCentered(x + pad, rowY, leftGut - app.Scale(6), rowH, labels[i], t.textSecondary, axisFs);
                for (int a2 = 0; a2 < ng; a2 = a2 + 1) { accs[a2] = 0; }
                for (int si = 0; si < ns; si = si + 1) {
                    ChartSeries sc = series[si];
                    if (!sc.hidden) {
                        int gi = ChartView.GroupIndex(grp, sc.stackName);
                        if (gi < 0) { gi = 0; }
                        int v = 0;
                        if (i < sc.Count()) { v = sc.Value(i); }
                        int accW = (accs[gi] + v) * plotW / maxV;
                        int by = rowY + groupY0 + gi * barH;
                        int segW = accW - accs[gi] * plotW / maxV;
                        int drawX = plotX + 1 + accs[gi] * plotW / maxV;
                        // Bands meet edge-to-edge (no 1px seam), matching the
                        // vertical stacked bars: the color change separates
                        // the layers without a notch.
                        int segRad = rad;
                        if (si != topSi[gi]) { segRad = 0; }
                        c.FillRoundRect(drawX, by, segW, barH, segRad, sc.color);
                        accs[gi] = accs[gi] + v;
                    }
                }
            }
        } else {
            int groupH = rowH * 7 / 10;
            int gap = app.Scale(2);
            int barH = (groupH - gap * (ns - 1)) / ns;
            if (barH < app.Scale(2)) { barH = app.Scale(2); }
            int groupY0 = (rowH - groupH) / 2;

            for (int i = 0; i < n; i = i + 1) {
                int rowY = plotY + i * rowH;
                c.DrawTextCentered(x + pad, rowY, leftGut - app.Scale(6), rowH, labels[i], t.textSecondary, axisFs);
                for (int si = 0; si < ns; si = si + 1) {
                    int v = 0;
                    if (i < series[si].Count()) { v = series[si].Value(i); }
                    int bw = v * plotW / maxV;
                    int by = rowY + groupY0 + si * (barH + gap);
                    c.FillRoundRect(plotX + 1, by, bw, barH, rad, series[si].color);
                }
            }
        }
        c.PopClip();
    }

    // ---- pie / donut (sweep grows with g) ----
    static void DrawWaterfall(App app, int x, int y, int w, int h,
                              ChartOption o, int g) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        List<ChartSeries> series = o.series;
        if (series.Count < 1) { return; }
        ChartSeries s = series[0];
        List<string> labels = o.XCategories();
        int n = labels.Count;
        if (n < 1) { return; }

        List<int> cum = new List<int>();
        int acc = 0;
        int i = 0;
        for (; i < n; i = i + 1) {
            int v = 0;
            if (i < s.Count()) { v = s.Value(i); }
            if (i < s.data.Count && s.data[i].name == "total") { cum.Add(acc); }
            else { acc = acc + v; cum.Add(acc); }
        }
        int maxC = acc;
        int minC = 0;
        i = 0;
        while (i < n) {
            if (cum[i] > maxC) { maxC = cum[i]; }
            if (cum[i] < minC) { minC = cum[i]; }
            i = i + 1;
        }
        if (maxC < 1 && minC >= 0) { maxC = 1; }

        // Auto value axis covering negative running totals (baseline at 0).
        if (o.yAxes.Count == 0 && minC < 0) {
            o.yAxes.Add(ChartAxis.ValueRange(minC, Chart.NiceMax(maxC)));
        }
        int plotTop = Chart.DrawPanelI(app, x, y, w, h, o.title, series, o.iwid);
        ChartFrame f = Chart.BuildAxesR(app, x, y, w, h, plotTop, labels, o, series, maxC, 0 - 1);
        int step = f.plotW / n;
        if (step < 1) { step = 1; }
        int barW = step * 5 / 10;
        if (barW < app.Scale(2)) { barW = app.Scale(2); }
        int bx0 = (step - barW) / 2;
        int rad = app.Scale(3);
        if (!o.rounded) { rad = app.Scale(1); }

        int prev = 0;
        for (int ci = 0; ci < n; ci = ci + 1) {
            int v = 0;
            if (ci < s.Count()) { v = s.Value(ci); }
            bool isTotal = (ci < s.data.Count && s.data[ci].name == "total");
            int topV = prev;
            int botV = prev;
            if (isTotal) { topV = acc; botV = 0; }
            else { topV = prev + v; botV = prev; }
            int yTop = f.YOf(topV, 0);
            int yBot = f.YOf(botV, 0);
            if (yBot < yTop) { int tmp = yTop; yTop = yBot; yBot = tmp; }
            int col = s.color;
            if (col == 0) { col = Chart.Palette(t, 0); }
            if (isTotal) { col = t.primary; }
            else if (v < 0) { col = t.error; }
            ChartView.BarCell(c, f.plotX + ci * step + bx0, yTop, barW, yBot - yTop, rad, col, o.gradient);

            // connector line from the previous bar top to this bar's base
            if (ci > 0) {
                int px0 = f.plotX + (ci - 1) * step + bx0 + barW;
                int px1 = f.plotX + ci * step + bx0;
                int pyc = f.YOf(prev, 0);
                c.DrawLine(px0, pyc, px1, pyc, t.divider, app.Scale(1));
            }
            if (!isTotal) { prev = prev + v; }

            if (o.showValues) {
                string lbl = Convert.ToString(v);
                int lw = Canvas.MeasureText(lbl, t.fontSizeSmall);
                int lx2 = f.plotX + ci * step + bx0 + (barW - lw) / 2;
                int ly2 = yTop - app.Scale(14);
                if (ly2 < f.plotY) { ly2 = yTop + app.Scale(2); }
                c.DrawText(lx2, ly2, lbl, t.textSecondary, t.fontSizeSmall);
            }
        }
        Chart.DrawMarkLine(app, f, o);

        if (o.showTooltip) {
            int mx = app.mouseX;
            int my = app.mouseY;
            if (mx >= f.plotX && mx < f.plotX + f.plotW
                && my >= f.plotY && my < f.plotY + f.plotH) {
                int tIdx = (mx - f.plotX) / step;
                if (tIdx < 0) { tIdx = 0; }
                if (tIdx > n - 1) { tIdx = n - 1; }
                int tv = 0;
                if (tIdx < s.Count()) { tv = s.Value(tIdx); }
                bool tIsTotal = (tIdx < s.data.Count && s.data[tIdx].name == "total");
                string nm = labels[tIdx];
                if (nm.Length == 0) { nm = "Step " + Convert.ToString(tIdx + 1); }
                string vtxt = Convert.ToString(tv);
                if (tv >= 0) { vtxt = "+" + vtxt; }
                if (tIsTotal) { vtxt = Convert.ToString(acc); }
                int col = s.color;
                if (col == 0) { col = Chart.Palette(t, 0); }
                if (tIsTotal) { col = t.primary; }
                else if (tv < 0) { col = t.error; }
                List<TooltipRow> rows = new List<TooltipRow>{
                    TooltipRow.Of(0, o.title),
                    TooltipRow.Of(col, nm + "  " + vtxt) };
                ChartView.TooltipCard(app, mx, my, f.plotX + f.plotW, rows);
            }
        }
    }
}
