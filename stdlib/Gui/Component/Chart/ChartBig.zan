using System;
using System.Json;
using Gui;

namespace Gui.Component.Chart;

/// 高性能图表路径的缓存 min/max 抽取。每个大图表
/// 持有一个（类似 DataTableState）；底层数据变化时
/// 调用 Invalidate()。ChartBig 惰性填充并在帧间复用。
class ChartState {
    int version;        // 数据变化时调用方递增（通过 Invalidate）
    int builtVersion;   // 构建缓存时的数据版本
    int builtW;         // 构建缓存时的控件宽度
    int builtSeries;    // 构建缓存时的系列数量
    int cols;           // 缓存中每个系列最宽的列数
    int axisLo;         // 解析后的数值轴边界
    int axisHi;
    List<List<int>> colMin;   // 每系列：每个抽取列的最小值
    List<List<int>> colMax;   // 每系列：每个抽取列的最大值

    ChartState() {
        this.version = 1;
        this.builtVersion = 0;
        this.builtW = -1;
        this.builtSeries = -1;
        this.cols = 0;
        this.axisLo = 0;
        this.axisHi = 0;
        this.colMin = new List<List<int>>();
        this.colMax = new List<List<int>>();
    }

    /// 将缓存标记为过期，使下次渲染重新抽取源数据。
    void Invalidate() { this.version = this.version + 1; }
}

/// 虚拟 ChartSource 的高性能渲染器。每个系列被缩减为
/// 最多约绘图区宽度列的 min/max 包络，缓存在 ChartState 中，
/// 仅在数据版本或宽度变化时重建——
/// 数百万点的折线/面积图每帧只需 O(width) 而非 O(points)，
/// 图表从不持有每点一个对象的数组。用法：
///
///   ChartState st = new ChartState();          // 创建一次，由调用方保存
///   ChartBig.Render(app, st, mySource, ChartOption.Create(), x, y, w, h, "CPU");
class ChartBig {

    static bool NeedsRebuild(ChartState st, ChartSource src, int w) {
        if (st.builtVersion != st.version) { return true; }
        if (st.builtW != w) { return true; }
        if (st.builtSeries != src.SeriesCount()) { return true; }
        return false;
    }

    // 将每个系列抽取为约 `target` 个 min/max 列。只追加的构建
    // （不做索引写入）——任何优化级别下都安全快速；
    // 每次数据/尺寸变化运行一次，复杂度 O(总点数)。
    static void Build(ChartState st, ChartSource src, int target) {
        if (target < 2) { target = 2; }
        st.colMin = new List<List<int>>();
        st.colMax = new List<List<int>>();
        int ns = src.SeriesCount();
        int lo = 0;
        int hi = 0;
        bool seen = false;
        int cols = 0;

        for (int s = 0; s < ns; s = s + 1) {
            int n = src.PointCount(s);
            List<int> mn = new List<int>();
            List<int> mx = new List<int>();
            if (n > 0) {
                int C = target;
                if (C > n) { C = n; }
                int curCol = 0;
                int cMin = src.ValueAt(s, 0);
                int cMax = cMin;
                int i = 1;
                while (i < n) {
                    int col = i * C / n;
                    int v = src.ValueAt(s, i);
                    if (col != curCol) {
                        mn.Add(cMin);
                        mx.Add(cMax);
                        curCol = col;
                        cMin = v;
                        cMax = v;
                    } else {
                        if (v < cMin) { cMin = v; }
                        if (v > cMax) { cMax = v; }
                    }
                    i = i + 1;
                }
                mn.Add(cMin);
                mx.Add(cMax);
            }

            for (int j = 0; j < mn.Count; j = j + 1) {
                int a = mn[j];
                int b = mx[j];
                if (!seen) { lo = a; hi = b; seen = true; }
                if (a < lo) { lo = a; }
                if (b > hi) { hi = b; }
            }
            if (mn.Count > cols) { cols = mn.Count; }
            st.colMin.Add(mn);
            st.colMax.Add(mx);
        }

        st.cols = cols;
        int axisLo = lo;
        if (axisLo > 0) { axisLo = 0; }   // 全非负时以零为锚点
        int axisHi = Chart.NiceMax(hi);
        if (axisHi <= axisLo) { axisHi = axisLo + 1; }
        st.axisLo = axisLo;
        st.axisHi = axisHi;
    }

    static int DrawHead(App app, int x, int y, int w, int h, string title, ChartSource src) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int pad = t.paddingMedium;
        StyleBox sPanel = Style.Full(app, "chart", "", "", Style.SNormal());
        c.SurfaceRoundRect(x, y, w, h, t.borderRadiusMedium, sPanel.BgOr(0), sPanel.BorderOr(0), 1);
        int top = y + pad;
        if (title.Length > 0) {
            c.DrawText(x + pad, top, title, sPanel.FgOr(0), Style.FontFallback(app, "large"));
        }
        int lx = x + w - pad;
        int sw = app.Scale(12);
        int si = src.SeriesCount() - 1;
        while (si >= 0) {
            string nm = src.SeriesName(si);
            int tw = Canvas.MeasureText(nm, Style.FontFallback(app, "small"));
            lx = lx - tw;
            c.DrawText(lx, top + app.Scale(2), nm,
                Style.Part(app, "chart", "legend", "", "", "", Style.SNormal()).FgOr(0),
                Style.FontFallback(app, "small"));
            int col = src.SeriesColor(si);
            if (col == 0) { col = Chart.Palette(t, si); }
            lx = lx - app.Scale(6) - sw;
            c.FillRoundRect(lx, top + app.Scale(3), sw, sw, t.borderRadiusSmall, col);
            lx = lx - app.Scale(14);
            si = si - 1;
        }
        return top + Canvas.FontHeight(Style.FontFallback(app, "large")) + app.Scale(6);
    }

    /// 将源数据作为抽取后的折线/面积图绘制到给定矩形中。
    static void Render(App app, ChartState st, ChartSource src, ChartOption o,
                       int x, int y, int w, int h, string title) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int pad = t.paddingMedium;
        int axisFs = Style.FontFallback(app, "small");

        // 控件每水平像素一个抽取列是绘图区宽度的
        // 上界，因此缓存与边距无关。
        if (ChartBig.NeedsRebuild(st, src, w)) {
            ChartBig.Build(st, src, w);
            st.builtVersion = st.version;
            st.builtW = w;
            st.builtSeries = src.SeriesCount();
        }

        int plotTop = ChartBig.DrawHead(app, x, y, w, h, title, src);

        // 将绘图区/轴裁剪到图表盒内，
        // 即使数百万点，抽取列和轴标签也保持在控件内。
        c.PushClip(x, y, w, h);

        int leftGut = Canvas.MeasureText(Convert.ToString(st.axisHi), axisFs) + app.Scale(12);
        int botGut = Canvas.FontHeight(axisFs) + app.Scale(8);
        int plotX = x + pad + leftGut;
        int plotY = plotTop;
        int plotW = (x + w - pad) - plotX;
        int plotH = (y + h - pad - botGut) - plotY;
        if (plotW < app.Scale(20)) { plotW = app.Scale(20); }
        if (plotH < app.Scale(20)) { plotH = app.Scale(20); }

        int span = st.axisHi - st.axisLo;
        if (span < 1) { span = 1; }

        StyleBox sGrid = Style.Part(app, "chart", "grid", "", "", "",
                                    Style.SNormal());
        StyleBox sAxis = Style.Part(app, "chart", "axis", "", "", "",
                                    Style.SNormal());
        int ticks = 5;
        for (int k = 0; k <= ticks; k = k + 1) {
            int gy = plotY + plotH - (k * plotH / ticks);
            c.FillRect(plotX, gy, plotW, 1, sGrid.BgOr(0));
            int val = st.axisLo + span * k / ticks;
            string vs = Convert.ToString(val);
            int vw = Canvas.MeasureText(vs, axisFs);
            c.DrawText(plotX - app.Scale(6) - vw, Canvas.CenterTextYAt(gy, axisFs), vs, sAxis.FgOr(0), axisFs);
        }
        c.FillRect(plotX, plotY, 1, plotH, sAxis.BgOr(0));
        c.FillRect(plotX, plotY + plotH, plotW, 1, sAxis.BgOr(0));

        int ns = src.SeriesCount();
        if (st.cols < 1) { c.PopClip(); return; }
        int baseY = plotY + plotH;
        int g = 1000;
        if (o.animate) {
            g = app.AnimIntroIn(5200000 + w, o.animMs,
                                 plotX, plotY, plotW, plotH);
        }

        for (int s = 0; s < ns; s = s + 1) {
            int color = src.SeriesColor(s);
            if (color == 0) { color = Chart.Palette(t, s); }
            List<int> mn = st.colMin[s];
            List<int> mx = st.colMax[s];
            int cn = mn.Count;
            int fillTop = Chart.WithAlpha(color, 120);
            int fillBot = Chart.WithAlpha(color, 12);

            int prevX = plotX;
            int prevY = baseY;
            bool first = true;
            for (int cc = 0; cc < cn; cc = cc + 1) {
                int px = plotX + cc * plotW / cn;
                int vTop = mx[cc] * g / 1000;
                int vBot = mn[cc] * g / 1000;
                int yTop = plotY + plotH - (vTop - st.axisLo) * plotH / span;
                int yBot = plotY + plotH - (vBot - st.axisLo) * plotH / span;
                if (ChartView.HasArea(o)) {
                    if (o.gradient) {
                        c.FillVGrad(px, yTop, 1, baseY - yTop, fillTop, fillBot);
                    } else {
                        c.FillRect(px, yTop, 1, baseY - yTop, Chart.WithAlpha(color, 56));
                    }
                }
                c.FillRect(px, yTop, 1, yBot - yTop + 1, color);
                if (!first) { c.DrawLine(prevX, prevY, px, yTop, color, app.Scale(1)); }
                prevX = px;
                prevY = yTop;
                first = false;
            }
        }

        int total = 0;
        for (int ci = 0; ci < ns; ci = ci + 1) { total = total + src.PointCount(ci); }
        string cap = Convert.ToString(total) + " pts";
        int cw = Canvas.MeasureText(cap, axisFs);
        c.DrawText(x + w - pad - cw, y + h - pad - Canvas.FontHeight(axisFs), cap,
            Style.Part(app, "chart", "hint", "", "", "", Style.SNormal()).FgOr(0), axisFs);
        c.PopClip();
    }
}
