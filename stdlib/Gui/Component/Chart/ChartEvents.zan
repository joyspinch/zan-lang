using System;

namespace Gui.Component.Chart;

/// ECharts 2.2.7 风格的图表交互事件类型。
/// 类型使用独立枚举，避免与 Event River 的 ChartEvent 数据实体重名。
enum ChartEventType {
    Click,
    DoubleClick,
    Hover,
    MouseOut,
    LegendSelected,
    PieSelected,
    MapSelected,
    MapRoam,
    DataZoom,
    DataRange,
    TimelineChanged,
    MagicTypeChanged,
    Restore,
    Resize,
    DataChanged,
    Refresh,
    ForceLayoutEnd
}

/// 图表元素分类。Chart 表示整图空白区域，其余类型表示具体
/// 数据图元；这是有限整数枚举，不承诺 ECharts DOM 的完整组件树。
enum ChartElementType {
    Chart,
    LinePoint,
    Bar,
    ScatterPoint,
    HeatmapCell,
    PieSlice,
    MapRegion,
    FunnelStage,
    Node,
    Link,
    VennCircle,
    EventBand,
    RadarAxis,
    Candlestick,
    BoxPlot,
    ErrorBar,
    Gauge,
    WordTag
}

/// 渲染器提供给 ChartView 的当前几何命中。命中身份不包含
/// 像素坐标，指针在同一数据点内移动时不会重复触发 Hover。
class ChartHit {
    ChartElementType elementType;
    int seriesIndex;
    string seriesName;
    int dataIndex;
    string dataName;
    int value;
    bool numberValueSet;
    double numberValue;
    bool xValueSet;
    double xValue;
    bool yValueSet;
    double yValue;
    int pixelX;
    int pixelY;
    int axisIndex;

    static ChartHit Of(ChartElementType elementType, int seriesIndex,
                       string seriesName, int dataIndex, string dataName,
                       int value, int pixelX, int pixelY) {
        ChartHit h = new ChartHit();
        h.elementType = elementType;
        h.seriesIndex = seriesIndex;
        h.seriesName = seriesName;
        h.dataIndex = dataIndex;
        h.dataName = dataName;
        h.value = value;
        h.numberValueSet = false;
        h.numberValue = 0.0;
        h.xValueSet = false;
        h.xValue = 0.0;
        h.yValueSet = false;
        h.yValue = 0.0;
        h.pixelX = pixelX;
        h.pixelY = pixelY;
        h.axisIndex = 0;
        return h;
    }

    static bool Same(ChartHit a, ChartHit b) {
        if (a == null || b == null) { return a == b; }
        return a.elementType == b.elementType
            && a.seriesIndex == b.seriesIndex
            && a.dataIndex == b.dataIndex;
    }

    static ChartHit Copy(ChartHit src) {
        if (src == null) { return null; }
        ChartHit h = ChartHit.Of(src.elementType, src.seriesIndex,
            src.seriesName, src.dataIndex, src.dataName, src.value,
            src.pixelX, src.pixelY);
        h.numberValueSet = src.numberValueSet;
        h.numberValue = src.numberValue;
        h.xValueSet = src.xValueSet;
        h.xValue = src.xValue;
        h.yValueSet = src.yValueSet;
        h.yValue = src.yValue;
        h.axisIndex = src.axisIndex;
        return h;
    }
}

/// 图表交互事件的稳定载荷。未适用的字段使用 -1/空串/false，
/// 这样同一 handler 可以按 type 选择需要的 ECharts 风格字段。
class ChartInteractionEvent {
    ChartEventType type;
    ChartElementType elementType;
    bool dataHit;
    int chartWid;
    int seriesIndex;
    string seriesName;
    int dataIndex;
    string dataName;
    int value;
    bool numberValueSet;
    double numberValue;
    bool xValueSet;
    double xValue;
    bool yValueSet;
    double yValue;
    int x;
    int y;
    int axisIndex;
    bool selected;
    int zoomStart;
    int zoomEnd;

    static ChartInteractionEvent Of(ChartEventType type, int chartWid) {
        ChartInteractionEvent e = new ChartInteractionEvent();
        e.type = type;
        e.elementType = ChartElementType.Chart;
        e.dataHit = false;
        e.chartWid = chartWid;
        e.seriesIndex = 0 - 1;
        e.seriesName = "";
        e.dataIndex = 0 - 1;
        e.dataName = "";
        e.value = 0;
        e.numberValueSet = false;
        e.numberValue = 0.0;
        e.xValueSet = false;
        e.xValue = 0.0;
        e.yValueSet = false;
        e.yValue = 0.0;
        e.x = 0;
        e.y = 0;
        e.axisIndex = 0;
        e.selected = false;
        e.zoomStart = 0;
        e.zoomEnd = 1000;
        return e;
    }

    static ChartInteractionEvent Series(ChartEventType type, int wid,
                                        int seriesIndex, string seriesName) {
        ChartInteractionEvent e = ChartInteractionEvent.Of(type, wid);
        e.seriesIndex = seriesIndex;
        e.seriesName = seriesName;
        return e;
    }

    static ChartInteractionEvent DataPoint(ChartEventType type, int wid,
                                           int seriesIndex, string seriesName,
                                           int dataIndex, string dataName,
                                           ChartElementType elementType) {
        ChartInteractionEvent e = ChartInteractionEvent.Series(
            type, wid, seriesIndex, seriesName);
        e.dataHit = true;
        e.elementType = elementType;
        e.dataIndex = dataIndex;
        e.dataName = dataName;
        return e;
    }

    static string ElementName(ChartElementType type) {
        if (type == ChartElementType.LinePoint) { return "linePoint"; }
        if (type == ChartElementType.Bar) { return "bar"; }
        if (type == ChartElementType.ScatterPoint) { return "scatterPoint"; }
        if (type == ChartElementType.HeatmapCell) { return "heatmapCell"; }
        if (type == ChartElementType.PieSlice) { return "pieSlice"; }
        if (type == ChartElementType.MapRegion) { return "mapRegion"; }
        if (type == ChartElementType.FunnelStage) { return "funnelStage"; }
        if (type == ChartElementType.Node) { return "node"; }
        if (type == ChartElementType.Link) { return "link"; }
        if (type == ChartElementType.VennCircle) { return "vennCircle"; }
        if (type == ChartElementType.EventBand) { return "eventBand"; }
        if (type == ChartElementType.RadarAxis) { return "radarAxis"; }
        if (type == ChartElementType.Candlestick) { return "candlestick"; }
        if (type == ChartElementType.BoxPlot) { return "boxPlot"; }
        if (type == ChartElementType.ErrorBar) { return "errorBar"; }
        if (type == ChartElementType.Gauge) { return "gauge"; }
        if (type == ChartElementType.WordTag) { return "wordTag"; }
        return "chart";
    }

    string TypeName() {
        return ChartInteractionEvent.TypeNameOf(this.type);
    }

    static string TypeNameOf(ChartEventType type) {
        if (type == ChartEventType.Click) { return "click"; }
        if (type == ChartEventType.DoubleClick) { return "doubleClick"; }
        if (type == ChartEventType.Hover) { return "hover"; }
        if (type == ChartEventType.MouseOut) { return "mouseOut"; }
        if (type == ChartEventType.LegendSelected) { return "legendSelected"; }
        if (type == ChartEventType.PieSelected) { return "pieSelected"; }
        if (type == ChartEventType.MapSelected) { return "mapSelected"; }
        if (type == ChartEventType.MapRoam) { return "mapRoam"; }
        if (type == ChartEventType.DataZoom) { return "dataZoom"; }
        if (type == ChartEventType.DataRange) { return "dataRange"; }
        if (type == ChartEventType.TimelineChanged) { return "timelineChanged"; }
        if (type == ChartEventType.MagicTypeChanged) { return "magicTypeChanged"; }
        if (type == ChartEventType.Restore) { return "restore"; }
        if (type == ChartEventType.Resize) { return "resize"; }
        if (type == ChartEventType.DataChanged) { return "dataChanged"; }
        if (type == ChartEventType.Refresh) { return "refresh"; }
        if (type == ChartEventType.ForceLayoutEnd) { return "forceLayoutEnd"; }
        return "unknown";
    }
}

delegate void ChartInteractionHandler(ChartInteractionEvent e);

class ChartEventSubscription {
    ChartEventType type;
    ChartInteractionHandler handler;

    ChartEventSubscription(ChartEventType type, ChartInteractionHandler handler) {
        this.type = type;
        this.handler = handler;
    }
}

/// 按类型分发带载荷图表事件的保留式多播表。
class ChartEventHub {
    List<ChartEventSubscription> subscriptions;

    ChartEventHub() {
        this.subscriptions = new List<ChartEventSubscription>();
    }

    void On(ChartEventType type, ChartInteractionHandler handler) {
        if (handler == null) { return; }
        this.subscriptions.Add(new ChartEventSubscription(type, handler));
    }

    void Off(ChartEventType type, ChartInteractionHandler handler) {
        int i = this.subscriptions.Count - 1;
        while (i >= 0) {
            ChartEventSubscription s = this.subscriptions[i];
            if (s.type == type && s.handler == handler) {
                this.subscriptions.RemoveAt(i);
                return;
            }
            i = i - 1;
        }
    }

    int Count(ChartEventType type) {
        int n = 0;
        for (int i = 0; i < this.subscriptions.Count; i = i + 1) {
            if (this.subscriptions[i].type == type) { n = n + 1; }
        }
        return n;
    }

    void Clear() {
        this.subscriptions = new List<ChartEventSubscription>();
    }

    void Raise(ChartInteractionEvent eventArgs) {
        if (eventArgs == null) { return; }
        // 处理器可以在回调中 Off/ClearEvents；对当前派发取快照，
        // 避免就地删除导致后一个订阅被跳过。
        List<ChartEventSubscription> snapshot =
            new List<ChartEventSubscription>(this.subscriptions);
        for (int i = 0; i < snapshot.Count; i = i + 1) {
            ChartEventSubscription s = snapshot[i];
            if (s.type == eventArgs.type) {
                ChartInteractionHandler h = s.handler;
                if (h != null) { h(eventArgs); }
            }
        }
    }
}
