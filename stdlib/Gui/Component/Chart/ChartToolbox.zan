using System;
using Gui;
using Gui.Widget;

namespace Gui.Component.Chart;

/// ECharts 风格工具箱：右上角图标按钮组 + 悬停 tip。
/// 按钮组占位由 Chart.toolReserve 告诉标题/图例，避免互相遮挡。
class ChartToolbox {
    static int Btn(App app) { return app.Scale(22); }
    static int Gap(App app) { return app.Scale(2); }
    static int Chrome(App app) { return app.Scale(2); }
    static int Height(App app) {
        return ChartToolbox.Btn(app) + app.Scale(4);
    }
    // 与 DrawPanelI 同一套内边距（Theme 已按 DPI 缩放，禁止再 Scale）。
    static int Pad(App app) { return app.theme.paddingMedium; }

    static bool Cartesian(ChartOption o) {
        ChartType lead = ChartView.LeadType(o);
        return lead == ChartType.Line || lead == ChartType.Bar
            || lead == ChartType.Scatter || lead == ChartType.K;
    }

    /// 工具箱占用的宽度（含右侧内边距外的按钮排）。
    static int Width(App app, ChartOption o) {
        int n = 3;
        if (ChartToolbox.Cartesian(o)) { n = 6; }
        int btn = ChartToolbox.Btn(app);
        int gap = ChartToolbox.Gap(app);
        int chrome = ChartToolbox.Chrome(app);
        // 按钮排 + 两侧描边 + 与标题/图例的间隙，供 toolReserve 让开。
        return n * btn + (n - 1) * gap + chrome * 2 + app.Scale(8);
    }

    static void Draw(App app, int x, int y, int w, int h, int wid, ChartOption o) {
        Canvas c = app.canvas;
        int btn = ChartToolbox.Btn(app);
        int gap = ChartToolbox.Gap(app);
        int pad = ChartToolbox.Pad(app);
        int chrome = ChartToolbox.Chrome(app);
        List<int> ids = new List<int>{ 0, 3, 4 };
        if (ChartToolbox.Cartesian(o)) { ids = new List<int>{ 0, 1, 2, 3, 4, 5 }; }
        int n = ids.Count;
        int rowW = n * btn + (n - 1) * gap;
        int baseX = x + w - pad - rowW;
        int baseY = y + pad;
        // 按钮排底座走 chart::toolbox 部件规则；单个图标的
        // 悬停/开启态另走 chart::toolbox-btn，见 base.css。
        StyleBox sStrip = Style.Part(app, "chart", "toolbox", "", "", "",
            Style.SNormal());
        int bg = sStrip.BgOr(0);
        int bd = sStrip.BorderOr(0);
        int fg = sStrip.FgOr(0);

        string[] icons = new string[]{
            "table", "chart-line", "chart-bar", "undo", "save", "search" };
        string[] tips = new string[]{
            "数据视图", "切换为折线", "切换为柱状", "还原", "保存为图片", "区域缩放" };

        c.FillRoundRect(baseX - chrome, baseY - chrome,
            rowW + chrome * 2, btn + chrome * 2, app.Scale(4), bg);
        c.DrawRoundRect(baseX - chrome, baseY - chrome,
            rowW + chrome * 2, btn + chrome * 2, app.Scale(4), bd, 1);

        int magic = app.StateGet(Chart.TbMagicKey(wid), 0);
        int zOn = app.StateGet(Chart.TbZoomKey(wid), 0);
        int glyph = app.Scale(14);
        for (int k = 0; k < n; k = k + 1) {
            int action = ids[k];
            int bx = baseX + k * (btn + gap);
            int by = baseY;
            int cid = Chart.TbHitKey(wid, k);
            bool on = (action == 1 && magic == 1) || (action == 2 && magic == 2)
                || (action == 5 && zOn != 0);
            bool hot = app.mouseX >= bx && app.mouseX < bx + btn
                && app.mouseY >= by && app.mouseY < by + btn;
            int fill = 0;
            int icol = fg;
            if (on) {
                StyleBox sOn = Style.Part(app, "chart", "toolbox-btn", "",
                    "on", "", Style.SNormal());
                fill = sOn.BgOr(0);
                icol = sOn.FgOr(fg);
            } else if (hot) {
                fill = Style.Part(app, "chart", "toolbox-btn", "", "", "",
                    Style.SHover()).BgOr(0);
            }
            if (fill != 0) {
                c.FillRoundRect(bx, by, btn, btn, app.Scale(3), fill);
            }
            c.DrawGlyphIn(icons[action], bx, by, btn, btn, glyph, icol);
            app.hitTester.RegisterRect(cid, bx, by, btn, btn, 0);
            if (hot) {
                Tooltip.RequestBox(app, bx, by, btn, btn, tips[action],
                    Tooltip.Bottom(), 0);
            }
            if (Ui.Clicked(app, cid)) {
                ChartToolbox.Click(app, action, wid, o, x, y, w, h, magic, zOn);
                if (action == 1) {
                    if (magic == 1) { magic = 0; } else { magic = 1; }
                } else if (action == 2) {
                    if (magic == 2) { magic = 0; } else { magic = 2; }
                } else if (action == 5) {
                    if (zOn == 0) { zOn = 1; } else { zOn = 0; }
                }
            }
        }
        if (app.StateGet(Chart.TbViewKey(wid), 0) != 0) {
            ChartView.DrawDataView(app, x, y, w, h, wid, o);
        }
    }

    static void Click(App app, int action, int wid, ChartOption o,
                      int x, int y, int w, int h, int magic, int zOn) {
        if (action == 0) {
            int open = app.StateGet(Chart.TbViewKey(wid), 0);
            if (open == 0) { open = 1; } else { open = 0; }
            app.StateSet(Chart.TbViewKey(wid), open);
            app.RequestRedraw();
        } else if (action == 1) {
            if (magic == 1) { magic = 0; } else { magic = 1; }
            app.StateSet(Chart.TbMagicKey(wid), magic);
            app.RequestRedraw();
        } else if (action == 2) {
            if (magic == 2) { magic = 0; } else { magic = 2; }
            app.StateSet(Chart.TbMagicKey(wid), magic);
            app.RequestRedraw();
        } else if (action == 3) {
            ChartView.ToolboxRestore(app, wid, o);
        } else if (action == 4) {
            ChartView.QueueToolboxSave(wid, x, y, w, h);
        } else if (action == 5) {
            if (zOn == 0) { zOn = 1; } else { zOn = 0; }
            app.StateSet(Chart.TbZoomKey(wid), zOn);
            app.RequestRedraw();
        }
    }
}
