using System;
using System.Json;
using Gui;

namespace Gui.Component.Chart;

/// ECharts 2.2.7 原生 series.type。样式、堆叠、半径等行为由 series 子实体表达，不能伪装成类型。
enum ChartType {
    Line, Bar, Pie, Scatter, K, Radar, Chord, Force, Map, Gauge,
    Funnel, EventRiver, Treemap, Tree, WordCloud, Heatmap, Custom
}

/// ECharts xAxis/yAxis.type。
enum ChartAxisType {
    Category, Value, Time, Log
}

/// 图表类型字符串与 ChartType 枚举互转，以及 symbol / selectedMode
/// 等字段的词法规范化小工具。
class ChartKinds {
    /// ECharts type 字符串转 ChartType；未知名（含扩展渲染器标签）
    /// 返回 ChartType.Custom。
    static ChartType TypeOf(string s) {
        if (s == "line") { return ChartType.Line; }
        if (s == "bar") { return ChartType.Bar; }
        if (s == "pie") { return ChartType.Pie; }
        if (s == "scatter") { return ChartType.Scatter; }
        // effectScatter 涟漪强调散点：本引擎按普通散点渲染。
        if (s == "effectScatter") { return ChartType.Scatter; }
        if (s == "k" || s == "candlestick") { return ChartType.K; }
        if (s == "radar") { return ChartType.Radar; }
        if (s == "chord") { return ChartType.Chord; }
        if (s == "force") { return ChartType.Force; }
        // ECharts v5/v6 关系图：layout 字段选 force/none/circular，
        // 复用力导向渲染器（DrawForce 按布局分支）。
        if (s == "graph") { return ChartType.Force; }
        if (s == "map") { return ChartType.Map; }
        if (s == "gauge") { return ChartType.Gauge; }
        if (s == "funnel") { return ChartType.Funnel; }
        if (s == "eventRiver") { return ChartType.EventRiver; }
        if (s == "treemap") { return ChartType.Treemap; }
        if (s == "tree") { return ChartType.Tree; }
        if (s == "wordCloud") { return ChartType.WordCloud; }
        if (s == "heatmap") { return ChartType.Heatmap; }
        return ChartType.Custom;
    }

    /// 非 ECharts 2.2.7 原生类型的扩展渲染器标签（"box"、"error"、
    /// "sankey"、"waterfall"、"sunburst"、"radialBars"、"venn"、
    /// "pictorialBar"、"themeRiver"、"parallel"、"lines"）；
    /// ECharts boxplot 折算为 "box"（同一箱线渲染器）；原生类型为 ""。
    static string CustomOf(string s) {
        if (s == "boxplot") { return "box"; }
        if (s == "box" || s == "error" || s == "sankey" || s == "waterfall"
            || s == "sunburst" || s == "radialBars" || s == "venn") { return s; }
        if (s == "pictorialBar" || s == "themeRiver" || s == "parallel"
            || s == "lines") { return s; }
        return "";
    }

    /// ChartType 转回 ECharts type 字符串；Custom 返回 "custom"。
    static string TypeName(ChartType t) {
        if (t == ChartType.Line) { return "line"; }
        if (t == ChartType.Bar) { return "bar"; }
        if (t == ChartType.Pie) { return "pie"; }
        if (t == ChartType.Scatter) { return "scatter"; }
        if (t == ChartType.K) { return "k"; }
        if (t == ChartType.Radar) { return "radar"; }
        if (t == ChartType.Chord) { return "chord"; }
        if (t == ChartType.Force) { return "force"; }
        if (t == ChartType.Map) { return "map"; }
        if (t == ChartType.Gauge) { return "gauge"; }
        if (t == ChartType.Funnel) { return "funnel"; }
        if (t == ChartType.EventRiver) { return "eventRiver"; }
        if (t == ChartType.Treemap) { return "treemap"; }
        if (t == ChartType.Tree) { return "tree"; }
        if (t == ChartType.WordCloud) { return "wordCloud"; }
        if (t == ChartType.Heatmap) { return "heatmap"; }
        return "custom";
    }

    /// ECharts series.symbol 形状族规范化：2.2.x 全部符号形状
    /// （circle/emptyCircle/rectangle/diamond/triangle/star/star5/
    /// star6/arrow/droplet/pin/emptypin/heart/emptyHeart）+ "none"
    /// （该点不画符号，系列级与数据级都合法；渲染器入口统一跳过）。
    /// 未知名返回 ""（渲染器按族默认圆点）。star5 是 star 的
    /// ECharts2 别名（五角星），归一到 star。
    static string SymbolSanitize(string s) {
        if (s == "star5") { return "star"; }
        if (s == "emptyCircle" || s == "rectangle" || s == "diamond"
            || s == "triangle" || s == "circle" || s == "star"
            || s == "star6" || s == "arrow" || s == "droplet"
            || s == "pin" || s == "emptypin" || s == "none") { return s; }
        if (s == "heart") { return "heart"; }
        if (s == "emptyHeart") { return "emptyheart"; }
        return "";
    }

    /// ECharts map.selectedMode 白名单："" 与 "single" 同义（单区域）；
    /// "multiple" 多选；"false" 禁用点击选中。其余回落 ""。
    static string SelectedModeSanitize(string s) {
        if (s == "multiple" || s == "false") { return s; }
        return "";
    }

    /// selectedMode seam：是否允许点击选中（"false" 关闭）。
    static bool SelectedModeEnabled(string s) { return s != "false"; }

    /// 地图滚轮策略：zoom（默认消费并缩放）或 pass/none（交给外层滚动容器）。
    static string RoamWheelModeSanitize(string s) {
        if (s == "pass" || s == "none") { return "pass"; }
        return "zoom";
    }

    /// legend.selectedMode 白名单："single" | "false" | 其余（含
    /// "multiple"）归一为 ""（多选 = 现状默认）。
    static string LegendModeSanitize(string s) {
        if (s == "single" || s == "false") { return s; }
        return "";
    }

    /// ECharts axis.type 字符串转 ChartAxisType；未知名返回 Category。
    static ChartAxisType AxisOf(string s) {
        if (s == "value") { return ChartAxisType.Value; }
        if (s == "time") { return ChartAxisType.Time; }
        if (s == "log") { return ChartAxisType.Log; }
        return ChartAxisType.Category;
    }

    /// ChartAxisType 转回 ECharts axis.type 字符串。
    static string AxisName(ChartAxisType t) {
        if (t == ChartAxisType.Value) { return "value"; }
        if (t == ChartAxisType.Time) { return "time"; }
        if (t == ChartAxisType.Log) { return "log"; }
        return "category";
    }
}

/// 一个数据点（ECharts series.data[i]）：一个值加可选名称
/// （扇区/分类标签）和颜色。颜色 0 表示"继承系列
/// 颜色"——这是 ECharts 三级控制的第三级
/// （option < series < data item）。
class ChartData {
    int val;
    double number;
    bool numberSet;
    string name;    // "" = 继承系列名称
    int color;      // 0 = 继承系列颜色
    bool hidden;    // 饼图扇区隐藏（不进 total/角度/tooltip）
    bool selected;  // 饼图扇区静态选中：沿中角外偏 selectedOffset
    int size;       // ECharts symbolSize 逐项覆盖；sizeSet=false 时忽略
    bool sizeSet;
    bool gap;       // ECharts data 项 '-'（断线）：不画点/不连线/不进极值
    string symbol;  // ECharts 逐项 symbol 覆盖（"" = 继承系列）
    string labelText; // ECharts data[i].label.formatter 结果覆盖：非空时数值
                      //   标签直接显示该文本（bar10 Forecast 的标签是两系
                      //   列之和，模板无法表达）
    int labelSide;    // ECharts label.position 逐项覆盖：0 = 继承系列，
                      //   1 = 左、2 = 右（bar8 正负交错标签）
    bool labelHide;   // ECharts data[i].label.show=false：graph 节点标签
                      //   逐点隐藏（les-miserables 仅 5 个枢纽节点显标）
    string labelFmtT; // ECharts data[i].label.formatter **模板**（含 {a}{b}
                      //   {c}{d} 或 rich 标记，pie-rich-text 的 {title|{b}}
                      //   多行底板标签）；"" = 跟随系列模板。与 labelText
                      //   区分：那是无令牌的成品文本（bar10 两系列之和）。
    ChartTextStyle dlabel; // ECharts data[i].label 完整文本样式（color/
                      //   fontSize/rich/盒底板），非 null 时饼标签按它
                      //   渲染（覆盖系列级 label）；null = 跟随系列。
    bool hasCat;      // graph 节点声明了 category（下文 cat 生效）
    int cat;          // graph 节点类别下标（颜色 = 类别调色板）
    ChartItemStyle itemStyle; // ECharts data 项逐根 itemStyle（bar-data-color
                              //   的逐柱颜色、bar-stack-borderRadius 的逐柱
                              //   圆角）；null = 跟随系列 itemStyle。渲染器
                              //   只读 normal 态，读前须判空。
    int calDay;       // calendar 坐标系：该项的日期（1970 起天序）；-1 = 无
                      //   （series.coordinateSystem == "calendar" 时由解析器
                      //   从 [[日期串,值],...] 或 {value:[日期串,值]} 解出）

    /// 以整数值构造数据点（名称空、继承系列色、不隐藏、无逐项尺寸）。
    static ChartData Of(int v) {
        ChartData d = new ChartData();
        d.val = v;
        d.number = (double)v;
        d.numberSet = true;
        d.name = "";
        d.color = 0;
        d.hidden = false;
        d.selected = false;
        d.size = 0;
        d.sizeSet = false;
        d.gap = false;
        d.symbol = "";
        d.labelText = "";
        d.labelSide = 0;
        d.labelFmtT = "";
        d.dlabel = null;
        d.calDay = 0 - 1;
        return d;
    }

    /// ECharts data 项 '-'：该类目缺数据，折线在此断开。
    static ChartData Gap() {
        ChartData d = ChartData.Of(0);
        d.gap = true;
        return d;
    }

    /// 以 double 值构造数据点；整数字段 val 同步取截断值。
    static ChartData Numeric(double v) {
        ChartData d = ChartData.Of((int)v);
        d.number = v;
        return d;
    }

    /// 带 double 值与名称（扇区/分类标签）的数据点。
    static ChartData NamedNumber(double v, string name) {
        ChartData d = ChartData.Numeric(v);
        d.name = name;
        return d;
    }

    /// 带整数值与名称的数据点。
    static ChartData Named(int v, string name) {
        ChartData d = ChartData.Of(v);
        d.name = name;
        return d;
    }

    /// 带整数值与显式颜色的数据点。
    static ChartData Colored(int v, int color) {
        ChartData d = ChartData.Of(v);
        d.color = color;
        return d;
    }

    /// 同时带值、名称与颜色的数据点。
    static ChartData Full(int v, string name, int color) {
        ChartData d = ChartData.Of(v);
        d.name = name;
        d.color = color;
        return d;
    }

    /// 深复制；src 为 null 时返回 null。
    static ChartData Clone(ChartData src) {
        if (src == null) { return null; }
        ChartData d = new ChartData();
        d.val = src.val; d.number = src.number; d.numberSet = src.numberSet;
        d.name = src.name; d.color = src.color; d.hidden = src.hidden;
        d.selected = src.selected; d.size = src.size; d.sizeSet = src.sizeSet;
        d.gap = src.gap; d.symbol = src.symbol;
        d.labelText = src.labelText; d.labelSide = src.labelSide;
        d.labelFmtT = src.labelFmtT;
        d.dlabel = ChartTextStyle.Clone(src.dlabel);
        d.labelHide = src.labelHide;
        d.calDay = src.calDay;
        d.itemStyle = ChartItemStyle.Clone(src.itemStyle);
        return d;
    }
}

/// 金融/蜡烛图的一个 OHLC 柱。
class Candle {
    int open;
    int high;
    int low;
    int close;
    // ECharts data 项逐根 itemStyle 覆盖（k1 首根蓝色阴线）；
    // null = 跟随系列 itemStyle。渲染器只读 normal 态。
    ChartItemStyle itemStyle;
    /// 构造一根 OHLC 柱。
    static Candle Of(int open, int high, int low, int close) {
        Candle c = new Candle();
        c.open = open;
        c.high = high;
        c.low = low;
        c.close = close;
        return c;
    }

    /// 深复制；src 为 null 时返回 null。
    static Candle Clone(Candle src) {
        if (src == null) { return null; }
        Candle c = Candle.Of(src.open, src.high, src.low, src.close);
        c.itemStyle = ChartItemStyle.Clone(src.itemStyle);
        return c;
    }
}

/// 加权散点（x、y 和一个决定气泡大小的权重）。
class Bubble {
    int x;
    int y;
    int weight;
    /// 构造一个加权散点。
    static Bubble Of(int x, int y, int weight) {
        Bubble b = new Bubble();
        b.x = x;
        b.y = y;
        b.weight = weight;
        return b;
    }

    /// 深复制；src 为 null 时返回 null。
    static Bubble Clone(Bubble src) {
        if (src == null) { return null; }
        return Bubble.Of(src.x, src.y, src.weight);
    }
}

/// 箱线图统计量（最小值、下四分位数、中位数、上四分位数、最大值）。
/// 分类标签与统计值一起携带，调用方不会因
/// 并行列表而使标签与数值失同步。
class BoxItem {
    string label;
    int lo;
    int q1;
    int med;
    int q3;
    int hi;
    /// 构造一个箱线统计项（五数概括 + 分类标签）。
    static BoxItem Of(string label, int lo, int q1, int med, int q3, int hi) {
        BoxItem b = new BoxItem();
        b.label = label;
        b.lo = lo;
        b.q1 = q1;
        b.med = med;
        b.q3 = q3;
        b.hi = hi;
        return b;
    }

    /// 深复制；src 为 null 时返回 null。
    static BoxItem Clone(BoxItem src) {
        if (src == null) { return null; }
        return BoxItem.Of(src.label, src.lo, src.q1, src.med, src.q3, src.hi);
    }
}

/// 带对称误差范围（y +/- err）的数值，用于误差条图。
/// 分类标签与测量值一起携带。
class ErrorItem {
    string label;
    int y;
    int err;
    /// 构造一个误差条项（值 y、对称误差 ±err、分类标签）。
    static ErrorItem Of(string label, int y, int err) {
        ErrorItem e = new ErrorItem();
        e.label = label;
        e.y = y;
        e.err = err;
        return e;
    }

    /// 深复制；src 为 null 时返回 null。
    static ErrorItem Clone(ErrorItem src) {
        if (src == null) { return null; }
        return ErrorItem.Of(src.label, src.y, src.err);
    }
}

/// 漏斗/玫瑰/饼图的一个阶段：值、填充色和显示名。
class ChartStage {
    int val;
    int color;
    string name;
    int seriesIndex;  // 对应的 o.series 下标（legend hit toggle 用）
    int dataIndex;    // 单系列多数据项时的 data[] 下标

    /// 构造一个阶段；si 为所属系列下标，dataIndex 初始为 0。
    ChartStage(int v, int col, string nm, int si) {
        val = v;
        color = col;
        name = nm;
        seriesIndex = si;
        dataIndex = 0;
    }
}

/// Treemap / Sunburst 图的层级节点：名称、值和
/// 嵌套子节点。叶子携带值；组的值由
/// 其子节点推导（渲染为组的总量 / 环扫掠）。
class ChartNode {
    string name;
    int val;
    string symbol;   // ECharts force symbol 逐节点形状（"" = 圆）
    int size;        // 逐节点尺寸（直径像素；0 = 自动）
    List<ChartNode> children;

    /// 构造叶子节点（自带值，无子节点）。
    static ChartNode Leaf(string name, int val) {
        ChartNode n = new ChartNode();
        n.name = name;
        n.val = val;
        n.symbol = "";
        n.size = 0;
        n.children = new List<ChartNode>();
        return n;
    }

    /// 构造组节点（值由子节点推导，val 置 0）。
    static ChartNode Group(string name, List<ChartNode> children) {
        ChartNode n = new ChartNode();
        n.name = name;
        n.val = 0;
        n.symbol = "";
        n.size = 0;
        n.children = children;
        return n;
    }

    /// 带显式 value 的组节点（ECharts data 节点的 value 字段，
    /// 不等于子树累计时以显式值为准，tooltip 用）。
    static ChartNode GroupVal(string name, int val, List<ChartNode> children) {
        ChartNode n = ChartNode.Group(name, children);
        n.val = val;
        return n;
    }

    /// 形状 + 尺寸变体（force 分类符号：diamond/triangle/rectangle…）。
    static ChartNode Shaped(string name, int val, string symbol, int size) {
        ChartNode n = ChartNode.Leaf(name, val);
        n.symbol = ChartKinds.SymbolSanitize(symbol);
        n.size = size;
        return n;
    }

    /// 深复制整棵子树；src 为 null 时返回 null。
    static ChartNode Clone(ChartNode src) {
        if (src == null) { return null; }
        ChartNode n = new ChartNode();
        n.name = src.name; n.val = src.val; n.symbol = src.symbol; n.size = src.size;
        n.children = new List<ChartNode>();
        int childCount = src.children == null ? 0 : src.children.Count;
        for (int i = 0; i < childCount; i = i + 1) {
            ChartNode child = ChartNode.Clone(src.children[i]);
            if (child != null) { n.children.Add(child); }
        }
        return n;
    }

    /// 此节点下所有叶子值的总和（组的总量）。
    int Total() {
        if (this.children == null || this.children.Count == 0) { return this.val; }
        int sum = 0;
        for (int i = 0; i < this.children.Count; i = i + 1) {
            if (this.children[i] != null) { sum = sum + this.children[i].Total(); }
        }
        return sum;
    }
}

/// Sankey 图的有向流转链接：从节点 -> 到节点，带一个值
/// （链接粗细）。节点在渲染时从链接推导。
class ChartLink {
    string from;
    string to;
    int val;

    /// 构造一条流转链接；val 为链接粗细。
    static ChartLink Of(string from, string to, int val) {
        ChartLink l = new ChartLink();
        l.from = from;
        l.to = to;
        l.val = val;
        return l;
    }

    /// 深复制；src 为 null 时返回 null。
    static ChartLink Clone(ChartLink src) {
        if (src == null) { return null; }
        return ChartLink.Of(src.from, src.to, src.val);
    }
}

/// 直角坐标系散点的一个 x/y 数据点，可带逐点尺寸与颜色
///（散点/折线的 points 专用列表用）。
class ChartPoint {
    int x;
    int y;
    int z;       // 第三维（ECharts data [x,y,z] 的末维）：dataRange/
                 // 色带按它映射（非 0 时），散点气泡值等用
    int size;    // 逐点 symbolSize；sizeSet=false 时忽略
    bool sizeSet;
    int color;   // 逐点颜色；0 = 继承系列颜色
    string name; // ECharts data[i].name——系列 labelShow 时的逐点
                 // 标签文本（formatter {b}，散点省名标注等用）

    /// 构造一个点（无逐点尺寸，继承系列颜色）。
    static ChartPoint Of(int x, int y) {
        return new ChartPoint { x = x, y = y, z = 0, size = 0, sizeSet = false, color = 0, name = "" };
    }

    /// 构造带逐点尺寸（直径像素）的点。
    static ChartPoint Sized(int x, int y, int size) {
        ChartPoint p = ChartPoint.Of(x, y);
        p.size = size;
        p.sizeSet = true;
        return p;
    }

    /// 深复制；src 为 null 时返回 null。
    static ChartPoint Clone(ChartPoint src) {
        if (src == null) { return null; }
        return new ChartPoint { x = src.x, y = src.y, z = src.z, size = src.size,
            sizeSet = src.sizeSet, color = src.color, name = src.name };
    }
}

/// 地图多边形的一个顶点（已规范化为整数）。
class ChartMapPoint {
    int x;
    int y;

    /// 构造一个地图多边形顶点。
    static ChartMapPoint Of(int x, int y) { return new ChartMapPoint { x = x, y = y }; }
}

/// 地图区域的一条环：外环勾出区域轮廓，hole=true 的环是其中的洞。
/// 多部件区域用多条外环表达。
class ChartMapRing {
    List<ChartMapPoint> points;
    bool hole;

    /// 构造一条环；points 至少 3 个才被 JSON 解析接受。
    static ChartMapRing Of(List<ChartMapPoint> points, bool hole) {
        return new ChartMapRing { points = points, hole = hole };
    }
}

/// 地图区域：名称、值（驱动连续色域）、可选颜色和多条环
/// （单环=单部件；多外环=多部件；hole=true 的环减去面积）。
class ChartMapRegion {
    string name;
    int value;
    int color;   // 0 = 由 value 映射到连续色域
    List<ChartMapRing> rings;

    /// 构造地图区域（颜色由 value 映射到连续色域）。
    static ChartMapRegion Of(string name, int value, List<ChartMapRing> rings) {
        ChartMapRegion r = new ChartMapRegion();
        r.name = name; r.value = value; r.color = 0; r.rings = rings;
        return r;
    }
    /// 构造带显式颜色的地图区域（不参与值→色映射）。
    static ChartMapRegion Colored(string name, int value, int color, List<ChartMapRing> rings) {
        ChartMapRegion r = ChartMapRegion.Of(name, value, rings);
        r.color = color;
        return r;
    }

    /// 深复制全部环与顶点；src 为 null 时返回 null。
    static ChartMapRegion Clone(ChartMapRegion src) {
        if (src == null) { return null; }
        List<ChartMapRing> rings = new List<ChartMapRing>();
        for (int i = 0; i < src.rings.Count; i = i + 1) {
            ChartMapRing sr = src.rings[i];
            List<ChartMapPoint> points = new List<ChartMapPoint>();
            for (int j = 0; j < sr.points.Count; j = j + 1) {
                points.Add(ChartMapPoint.Of(sr.points[j].x, sr.points[j].y));
            }
            rings.Add(ChartMapRing.Of(points, sr.hole));
        }
        return ChartMapRegion.Colored(src.name, src.value, src.color, rings);
    }
}

/// ECharts geo 组件：一张底图地图 + 按名区域覆盖。解析后由
/// FromJsonValue 的合成块折算成 isGeoBase 的 type=Map 载体系列
/// （几何经 ChartMaps.BindSeries 注入）。
class ChartGeo {
    string map;          // 注册表地图名
    bool roam;           // 漫游（缩放/平移）
    bool labelShow;      // label.show：区域名标签
    ChartTextStyle labelSt; // geo.label 文本样式（textBorder*/textShadow*，
                            // geo-graph/geo-seatmap-flight/geo-organ）；null = 未声明
    string selectedMode; // ""/"single" | "multiple" | "false"
    int areaColor;       // itemStyle.areaColor；0 = 不覆盖
    int borderColor;     // itemStyle.borderColor；0 = 不覆盖
    List<ChartMapRegion> regions; // regions[] 覆盖（stub 或带 ring）

    static ChartGeo Of() {
        ChartGeo g = new ChartGeo();
        g.map = "";
        g.roam = false;
        g.labelShow = false;
        g.labelSt = null;
        g.selectedMode = "";
        g.areaColor = 0;
        g.borderColor = 0;
        g.regions = new List<ChartMapRegion>();
        return g;
    }

    static ChartGeo Clone(ChartGeo src) {
        if (src == null) { return null; }
        ChartGeo g = ChartGeo.Of();
        g.map = src.map;
        g.roam = src.roam;
        g.labelShow = src.labelShow;
        g.labelSt = ChartTextStyle.Clone(src.labelSt);
        g.selectedMode = src.selectedMode;
        g.areaColor = src.areaColor;
        g.borderColor = src.borderColor;
        for (int i = 0; i < src.regions.Count; i = i + 1) {
            g.regions.Add(ChartMapRegion.Clone(src.regions[i]));
        }
        return g;
    }
}

/// 平行坐标的一根轴（ECharts parallelAxis[dim]）：轴名、显式
/// min/max、类目维的类目表。渲染时 min/max 缺省由该维数据推导。
class ChartParAxis {
    string name;
    int dim;    // parallelAxis.dim：绑定的数据列下标（缺省 = 数组槽位）
    int min;    // 显式下界；minSet=false 时取数据维最小
    int max;    // 显式上界；maxSet=false 时取数据维最大
    bool minSet;
    bool maxSet;
    bool inverse;      // parallelAxis.inverse：反向刻度
    List<string> cats; // type:"category" 的类目表（值取下标）

    static ChartParAxis Of() {
        ChartParAxis a = new ChartParAxis();
        a.name = "";
        a.dim = 0 - 1; // -1 = 未声明，渲染按数组槽位取列
        a.min = 0; a.max = 0;
        a.minSet = false; a.maxSet = false;
        a.inverse = false;
        a.cats = new List<string>();
        return a;
    }

    static ChartParAxis Clone(ChartParAxis src) {
        if (src == null) { return null; }
        ChartParAxis a = ChartParAxis.Of();
        a.name = src.name;
        a.dim = src.dim;
        a.min = src.min; a.max = src.max;
        a.minSet = src.minSet; a.maxSet = src.maxSet;
        a.inverse = src.inverse;
        for (int i = 0; i < src.cats.Count; i = i + 1) { a.cats.Add(src.cats[i]); }
        return a;
    }
}

/// ECharts 5/6 极坐标的一根轴（angleAxis / radiusAxis）：值轴或
/// 类目轴。圆心/外径在 polar 组件（RadarPolar 已承载），量程、
/// 类目与角度基准在这——coordinateSystem:"polar" 的系列经
/// polarIndex 绑定到第几组角度/半径轴。
class PolarAxisSpec {
    bool isAngle;       // true = angleAxis，false = radiusAxis
    ChartAxisType type; // Value（ECharts 极轴缺省）/ Category
    int polarIndex;     // 绑定第几个 polar（缺省 = 数组槽位）
    int min;            // 显式量程；minSet=false 时从数据推导
    int max;
    bool minSet;
    bool maxSet;
    int startAngle;     // 仅角度轴：起始角（ECharts 缺省 90 = 12 点）。这是
                        //   "顺时针为正"的屏幕角：clockwise（缺省）时角度
                        //   随值递减。见 ChartView.PolarAngleAt。
    int endAngle;       // 仅角度轴：终止角。未声明时 = startAngle - 360
                        //   （clockwise:true）。
    bool endAngleSet;   // endAngle 是否显式声明。`endAngle:0` 是合法显式值
                        //   （四分之一圈，polar-endAngle 两个 polar 都这么用），
                        //   不能拿 0 当"未声明"哨兵——旧代码正是如此，于是
                        //   polar-endAngle 的扇区被撑成满圈。
    bool clockwise;     // 仅角度轴：ECharts 缺省 true（角度随值递减，屏幕上
                        //   是顺时针）。false 时角度递增。
    bool boundaryGap;   // 类目轴（缺省 true：点落在带中央）
    List<string> cats;  // 类目数据

    static PolarAxisSpec Of(bool angle) {
        PolarAxisSpec a = new PolarAxisSpec();
        a.isAngle = angle;
        a.type = ChartAxisType.Value;
        a.polarIndex = 0;
        a.min = ChartOption.Auto();
        a.max = ChartOption.Auto();
        a.minSet = false; a.maxSet = false;
        a.startAngle = 90;
        a.endAngle = 0;
        a.endAngleSet = false;
        a.clockwise = true;
        a.boundaryGap = true;
        a.cats = new List<string>();
        return a;
    }

    static PolarAxisSpec Clone(PolarAxisSpec src) {
        if (src == null) { return null; }
        PolarAxisSpec a = PolarAxisSpec.Of(src.isAngle);
        a.type = src.type;
        a.polarIndex = src.polarIndex;
        a.min = src.min; a.max = src.max;
        a.minSet = src.minSet; a.maxSet = src.maxSet;
        a.startAngle = src.startAngle;
        a.endAngle = src.endAngle;
        a.endAngleSet = src.endAngleSet;
        a.clockwise = src.clockwise;
        a.boundaryGap = src.boundaryGap;
        for (int i = 0; i < src.cats.Count; i = i + 1) { a.cats.Add(src.cats[i]); }
        return a;
    }
}

/// Event River 的一个事件：名称、时间区间 [start, end]、值
/// （驱动带宽）、可选颜色。普通标量 data 兼容转换为等距事件。
class ChartEvent {
    string name;
    int start;
    int end;
    int value;
    int color;   // 0 = 继承系列颜色

    /// 构造一个事件；color 为 0 表示继承系列颜色。
    static ChartEvent Of(string name, int start, int end, int value) {
        ChartEvent e = new ChartEvent();
        e.name = name; e.start = start; e.end = end; e.value = value; e.color = 0;
        return e;
    }

    /// 深复制；src 为 null 时返回 null。
    static ChartEvent Clone(ChartEvent src) {
        if (src == null) { return null; }
        ChartEvent e = ChartEvent.Of(src.name, src.start, src.end, src.value);
        e.color = src.color;
        return e;
    }
}

/// 标记点（ECharts markPoint.data）：在线/柱系列上标注极值或显式点。
/// kind = "max" | "min" | "point"；dataIndex 命中系列内的数据点；
/// xValue/yValue 用于显式坐标（dataIndex < 0 时）。
class ChartMarkPoint {
    string kind;
    string name;   // ECharts data 项的 name（最大值/最小值/…），tooltip 用
    int dataIndex;
    int xValue;
    int yValue;
    string label;
    int color;   // 0 = 继承系列颜色
    string symbol; // ECharts symbol（"emptyCircle"/"star"/…）；"" = 默认实心圆
    int size;    // ECharts symbolSize；sizeSet=false 时用引擎默认

    /// 构造"最大值"标记点（渲染时从系列窗口数据推导位置）。
    int valueIndex; // ECharts valueIndex：-1 = 值轴(y)，0 = x 轴标注
    bool sizeSet;

    static ChartMarkPoint Max() {
        return ChartMarkPoint.Max("");
    }
    /// 带 name 的版本（ECharts data 项 {type:'max', name:'最大值'}）。
    static ChartMarkPoint Max(string name) {
        return new ChartMarkPoint { kind = "max", name = name, dataIndex = 0 - 1, xValue = 0, yValue = 0, label = "", color = 0, valueIndex = 0 - 1, symbol = "", size = 0, sizeSet = false };
    }
    /// 构造"最小值"标记点（渲染时从系列窗口数据推导位置）。
    static ChartMarkPoint Min() {
        return ChartMarkPoint.Min("");
    }
    /// 带 name 的版本（ECharts data 项 {type:'min', name:'最小值'}）。
    static ChartMarkPoint Min(string name) {
        return new ChartMarkPoint { kind = "min", name = name, dataIndex = 0 - 1, xValue = 0, yValue = 0, label = "", color = 0, valueIndex = 0 - 1, symbol = "", size = 0, sizeSet = false };
    }
    /// 构造显式坐标 (xValue,yValue) 的标记点并附标签。
    static ChartMarkPoint Point(int xValue, int yValue, string label) {
        return new ChartMarkPoint { kind = "point", name = "", dataIndex = 0 - 1, xValue = xValue, yValue = yValue, label = label, color = 0, valueIndex = 0 - 1, symbol = "", size = 0, sizeSet = false };
    }

    /// 深复制；src 为 null 时返回 null。
    static ChartMarkPoint Clone(ChartMarkPoint src) {
        if (src == null) { return null; }
        return new ChartMarkPoint { kind = src.kind, name = src.name, dataIndex = src.dataIndex,
            xValue = src.xValue, yValue = src.yValue, label = src.label,
            color = src.color, valueIndex = src.valueIndex,
            symbol = src.symbol, size = src.size, sizeSet = src.sizeSet };
    }
}

/// ECharts series.markLine.data 的一条阈值线：kind 为
/// "average"/"min"/"max" 时从窗口数据自动推导；显式线用
/// yValue（水平线）；xValue + yValue 为定点斜线。label 支持
/// {value} 占位；lineType "" = 虚线（ECharts 默认）。
class ChartMarkLine {
    string kind;
    string name;   // ECharts data 项的 name（平均值/…），tooltip 用
    int xValue;
    int yValue;
    bool hasPoint;
    string label;
    string lineType;
    int color;
    bool labelShow;   // markLine.label.show（默认 true；area-pieces 关）
    bool startArrow;  // markLine.symbol[0]："arrow" 才画（默认 none）
    bool endArrow;    // markLine.symbol[1]：ECharts 默认 ['none','arrow']
    bool hasEnd;      // 两点斜线（coord 对）：回归/趋势线（anscombe 等）
    int x2Value;      // 终点 x（原始值域，x 为数值轴时按值映射）
    int y2Value;      // 终点 y

    /// 按 kind 构造阈值线（"average"/"min"/"max" 或 "" = 显式线）。
    int valueIndex; // ECharts valueIndex：-1 = 值轴(y 水平线)，0 = x 轴(竖线)

    static ChartMarkLine Of(string kind) {
        return ChartMarkLine.Of(kind, "");
    }
    /// 带 name 的版本（ECharts data 项 {type:'average', name:'平均值'}）。
    static ChartMarkLine Of(string kind, string name) {
        return new ChartMarkLine { kind = kind, name = name, xValue = 0, yValue = 0,
            hasPoint = false, label = "", lineType = "", color = 0,
            valueIndex = 0 - 1, labelShow = true, startArrow = false,
            endArrow = true, hasEnd = false, x2Value = 0, y2Value = 0 };
    }
    /// 平均线：窗口数据的算术平均。
    static ChartMarkLine Average() { return ChartMarkLine.Of("average"); }
    /// 带 name 的平均线。
    static ChartMarkLine Average(string name) { return ChartMarkLine.Of("average", name); }
    /// 最小值线。
    static ChartMarkLine Min() { return ChartMarkLine.Of("min"); }
    /// 最大值线。
    static ChartMarkLine Max() { return ChartMarkLine.Of("max"); }
    /// 显式水平线：y = yValue 处，label 支持 {value} 占位。
    static ChartMarkLine At(int yValue, string label) {
        ChartMarkLine m = ChartMarkLine.Of("");
        m.yValue = yValue;
        m.label = label;
        return m;
    }

    /// 深复制；src 为 null 时返回 null。
    static ChartMarkLine Clone(ChartMarkLine src) {
        if (src == null) { return null; }
        ChartMarkLine m = ChartMarkLine.Of(src.kind, src.name);
        m.xValue = src.xValue; m.yValue = src.yValue; m.hasPoint = src.hasPoint;
        m.label = src.label; m.lineType = src.lineType; m.color = src.color;
        m.valueIndex = src.valueIndex;
        m.labelShow = src.labelShow; m.startArrow = src.startArrow;
        m.endArrow = src.endArrow;
        m.hasEnd = src.hasEnd; m.x2Value = src.x2Value; m.y2Value = src.y2Value;
        return m;
    }
}

/// 长度/位置标量：像素（Px）或相对主体的百分比（Pct，0..100）。
class ChartScalar {
    int amount;
    bool percent;

    /// 固定像素标量。
    static ChartScalar Px(int amount) { return new ChartScalar { amount = amount, percent = false }; }
    /// 百分比标量（amount = 百分数）。
    static ChartScalar Pct(int amount) { return new ChartScalar { amount = amount, percent = true }; }

    /// 深复制；src 为 null 时返回 null。
    static ChartScalar Clone(ChartScalar src) {
        if (src == null) { return null; }
        return new ChartScalar { amount = src.amount, percent = src.percent };
    }
}

/// 二维标量坐标（仪表盘 center、指针 offsetCenter 等用）。
class ChartPosition {
    ChartScalar x;
    ChartScalar y;

    /// 构造一个 (x,y) 标量坐标。
    static ChartPosition Of(ChartScalar x, ChartScalar y) {
        return new ChartPosition { x = x, y = y };
    }

    /// 深复制（含两个标量）；src 为 null 时返回 null。
    static ChartPosition Clone(ChartPosition src) {
        if (src == null) { return null; }
        return ChartPosition.Of(ChartScalar.Clone(src.x), ChartScalar.Clone(src.y));
    }
}

/// 富文本单样式（ECharts label.rich.<name>，官方文档"富文本标签"；
/// 存储按声明序的 name→样式 对——JsonValue 对象键序即声明序）。
/// 数值字段 -1 = 未声明；color 0 = 跟随外层标签色。
/// backgroundColor:{image:...} 素材在 Zan 不可得：bgIsImage=1 只保留
/// width/height 占位（行高/盒宽不塌），不绘制底图。
class ChartRichStyle {
    string name;
    int color;
    int fontSize;
    string fontWeight;
    string fontFamily;
    // A14 rich 段的 textBorder*/textShadow*（ECharts labelStyle.ts:522,550
    // ——zrender stroke 文本 = 先描边后填充，paint-order:stroke）。
    // borderColor 0 = 无；borderWidth -1 = 未声明；shadowColor 0 = 无。
    int tbColor;
    int tbWidth;
    int tsColor;
    int tsBlur;
    int tsDx;
    int tsDy;
    int align;         // 0 left / 1 center / 2 right；-1 未声明（左）
    int lineHeight;
    int backgroundColor;
    int bgIsImage;
    int borderColor;
    int borderWidth;   // 官方可 0.5（pie-rich-text/treemap hr）：四舍五入存 px
    int radTL;         // borderRadius：数字 = 四角同值；数组 [左上,右上,
    int radTR;         //   右下,左下]（pie-rich-text abg 的 [4,4,0,0] 只
    int radBR;         //   圆上面两角）。-1 未声明。
    int radBL;
    int padT;
    int padR;
    int padB;
    int padL;
    int width;         // -2 = '100%'（随富文本整块宽）；≥0 像素
    int height;

    /// 构造默认：全未声明。
    static ChartRichStyle Create() {
        ChartRichStyle r = new ChartRichStyle();
        r.name = "";
        r.color = 0;
        r.fontSize = 0 - 1;
        r.fontWeight = "";
        r.fontFamily = "";
        r.tbColor = 0;
        r.tbWidth = 0 - 1;
        r.tsColor = 0;
        r.tsBlur = 0 - 1;
        r.tsDx = 0;
        r.tsDy = 0;
        r.align = 0 - 1;
        r.lineHeight = 0 - 1;
        r.backgroundColor = 0;
        r.bgIsImage = 0;
        r.borderColor = 0;
        r.borderWidth = 0 - 1;
        r.radTL = 0 - 1;
        r.radTR = 0 - 1;
        r.radBR = 0 - 1;
        r.radBL = 0 - 1;
        r.padT = 0 - 1;
        r.padR = 0 - 1;
        r.padB = 0 - 1;
        r.padL = 0 - 1;
        r.width = 0 - 1;
        r.height = 0 - 1;
        return r;
    }
}

/// 文本样式（颜色、字号、字体族、阴影），JSON 可逐字段覆盖。
/// 另承载 ECharts label 的整块盒样式（backgroundColor/border/padding，
/// pie-rich-text 的 data.label 底板）与 label.rich 富文本样式表；
/// rich 非 null 即声明过富文本（可为空表——`rich:{}` 合法）。
class ChartTextStyle {
    int color;
    int fontSize;
    string fontStyle;
    string fontWeight;
    string fontFamily;
    int shadowColor;
    int shadowBlur;
    // A14 label 级 textBorder*/textShadow*（label-position / sunburst-
    // label-rotate / geo-graph / geo-seatmap-flight / geo-organ）。宽度
    // -1 = 未声明；颜色 0 = 无。offset/blur 与 Canvas 无模糊的现实下
    // 按描边渲染（见 ChartView.DrawTextStyled）。
    int tbColor;
    int tbWidth;
    int tsColor;
    int tsBlur;
    int tsDx;
    int tsDy;
    int lineHeight; // label 级 lineHeight：段未声明自身 lineHeight 时的
                    //   行高缺省（gauge-speed detail.lineHeight 40）；
                    //   -1 = 未声明
    List<ChartRichStyle> rich;
    int boxBg;      // label.backgroundColor（整块底板）；0 = 无
    int boxBorder;  // label.borderColor；0 = 无
    int boxBorderW; // label.borderWidth；-1 未声明
    int boxRadius;  // label.borderRadius；-1 未声明
    int padT;       // label.padding；-1 未声明
    int padR;
    int padB;
    int padL;

    /// 构造默认样式：颜色 0（跟随主题）、字号 0（渲染器缺省）。
    static ChartTextStyle Create() {
        ChartTextStyle s = new ChartTextStyle {
            color = 0, fontSize = 0, fontStyle = "normal", fontWeight = "normal",
            fontFamily = "", shadowColor = 0, shadowBlur = 0
        };
        s.tbColor = 0;
        s.tbWidth = 0 - 1;
        s.tsColor = 0;
        s.tsBlur = 0 - 1;
        s.tsDx = 0;
        s.tsDy = 0;
        s.lineHeight = 0 - 1;
        s.rich = null;
        s.boxBg = 0;
        s.boxBorder = 0;
        s.boxBorderW = 0 - 1;
        s.boxRadius = 0 - 1;
        s.padT = 0 - 1;
        s.padR = 0 - 1;
        s.padB = 0 - 1;
        s.padL = 0 - 1;
        return s;
    }

    /// 深复制；src 为 null 时返回 null。
    static ChartTextStyle Clone(ChartTextStyle src) {
        if (src == null) { return null; }
        ChartTextStyle s = new ChartTextStyle { color = src.color, fontSize = src.fontSize,
            fontStyle = src.fontStyle, fontWeight = src.fontWeight,
            fontFamily = src.fontFamily, shadowColor = src.shadowColor,
            shadowBlur = src.shadowBlur };
        s.tbColor = src.tbColor;
        s.tbWidth = src.tbWidth;
        s.tsColor = src.tsColor;
        s.tsBlur = src.tsBlur;
        s.tsDx = src.tsDx;
        s.tsDy = src.tsDy;
        s.lineHeight = src.lineHeight;
        s.boxBg = src.boxBg;
        s.boxBorder = src.boxBorder;
        s.boxBorderW = src.boxBorderW;
        s.boxRadius = src.boxRadius;
        s.padT = src.padT;
        s.padR = src.padR;
        s.padB = src.padB;
        s.padL = src.padL;
        if (src.rich != null) {
            s.rich = new List<ChartRichStyle>();
            for (int i = 0; i < src.rich.Count; i = i + 1) {
                ChartRichStyle a = src.rich[i];
                ChartRichStyle b = new ChartRichStyle();
                b.name = a.name;
                b.color = a.color;
                b.fontSize = a.fontSize;
                b.fontWeight = a.fontWeight;
                b.fontFamily = a.fontFamily;
                b.tbColor = a.tbColor;
                b.tbWidth = a.tbWidth;
                b.tsColor = a.tsColor;
                b.tsBlur = a.tsBlur;
                b.tsDx = a.tsDx;
                b.tsDy = a.tsDy;
                b.align = a.align;
                b.lineHeight = a.lineHeight;
                b.backgroundColor = a.backgroundColor;
                b.bgIsImage = a.bgIsImage;
                b.borderColor = a.borderColor;
                b.borderWidth = a.borderWidth;
                b.radTL = a.radTL;
                b.radTR = a.radTR;
                b.radBR = a.radBR;
                b.radBL = a.radBL;
                b.padT = a.padT;
                b.padR = a.padR;
                b.padB = a.padB;
                b.padL = a.padL;
                b.width = a.width;
                b.height = a.height;
                s.rich.Add(b);
            }
        }
        return s;
    }
}

/// 富文本段（Chart.RichTokenize 产出；ChartView.RichLayout 填排版
/// 结果）。x/y/w/h 是段盒（含 padding，px）；lh 为所在行行高；
/// fsPx/tw 是解析像素字号与文本净宽。
class RichSeg {
    string text;
    int line;          // 行号 0..
    ChartRichStyle st; // null = 纯文本段
    int x;
    int y;
    int w;
    int h;
    int fsPx;
    int tw;
    int lh;

    static RichSeg Create() {
        RichSeg s = new RichSeg();
        s.text = "";
        s.line = 0;
        s.st = null;
        s.x = 0;
        s.y = 0;
        s.w = 0;
        s.h = 0;
        s.fsPx = 0;
        s.tw = 0;
        s.lh = 0;
        return s;
    }
}

/// 富文本整块（ChartView.RichLayout 产出）：段表 + 块盒（含外层
/// label.padding）+ 行数；st 为生效样式表（绘制底板用）。
class RichBlock {
    List<RichSeg> segs;
    ChartTextStyle st;
    int w;
    int h;
    int lines;
}

/// 线样式：颜色、线宽、线型（"solid"/"dashed"/"dotted"）与阴影。
/// color0 为 ECharts 2.x K 线阴线配色对。
class ChartLineStyle {
    int color;
    int color0; // ECharts 2.x K线：阴线影线/边框色（与 color 配对）
    int width;
    string type;
    int shadowColor;
    int shadowBlur;
    // 横向线性渐变描边色标（zrColor.getLinearGradient 横向渐变的
    // 颜色序列，等距停靠；≥2 个生效）。null = 纯色。
    List<int> gradStops;
    // lineStyle.opacity:0（confidence-band L/U 隐藏描边线）：带体
    // 照常填充，仅跳过描边。
    bool transparent;
    // lineStyle.opacity 声明时的 0..255（round(opacity×255)）；
    // 0 = 未声明，渲染器按不透明兜底。部分透明由消费方取用
    // （parallel 行折线等密度叠加图——官方 nutrients 用
    // opacity 0.05 的逐行叠加累积出密度图）。
    int alpha;

    /// 构造实线样式；type 置 "solid"，阴影关闭。
    static ChartLineStyle Of(int color, int width) {
        ChartLineStyle ls = new ChartLineStyle {
            color = color, width = width, type = "solid", shadowColor = 0, shadowBlur = 0
        };
        ls.color0 = 0;
        return ls;
    }

    /// 深复制；src 为 null 时返回 null。
    static ChartLineStyle Clone(ChartLineStyle src) {
        if (src == null) { return null; }
        ChartLineStyle ls = new ChartLineStyle { color = src.color, color0 = src.color0,
            width = src.width, type = src.type, shadowColor = src.shadowColor,
            shadowBlur = src.shadowBlur, transparent = src.transparent,
            alpha = src.alpha };
        if (src.gradStops != null) {
            ls.gradStops = new List<int>();
            for (int i = 0; i < src.gradStops.Count; i = i + 1) {
                ls.gradStops.Add(src.gradStops[i]);
            }
        }
        return ls;
    }
}

/// 面积填充样式（颜色 + 填充类型字符串）。
class ChartAreaStyle {
    int color;
    string type;
    // areaStyle.opacity：0..255（解析 round(opacity×255)）。
    // 0 = 未声明——ECharts 6.1 LineView.ts 面积多边形缺省
    // opacity 0.7（fill=系列色/显式色同权），渲染器按 179 兜底；
    // 旧 128/256（zrColor.alpha 0.5）是 ECharts2 遗留，已清除。
    int alpha;
    // areaStyle.color 为 __grad 渐变对象时的 colorStops（ARGB）；
    // null = 无渐变。
    List<int> gradStops;

    /// 构造默认样式：颜色 0（跟随系列色）、type "default"。
    static ChartAreaStyle Create() {
        return new ChartAreaStyle { color = 0, type = "default", gradStops = null, alpha = 0 };
    }
}

/// 单状态（normal/emphasis）图形样式：填充、描边、圆角与线/面积子样式。
class ChartItemStateStyle {
    int color;
    int color0; // ECharts 2.x K线：阴线填充色（与 color 配对）
    int borderColor;
    int borderWidth;
    // itemStyle.borderRadius：最多四个元素 [tl,tr,br,bl]；
    // 单数值解析为四角同值。空表 = 未设置（渲染器用缺省圆角）。
    List<int> borderRadius;
    ChartLineStyle lineStyle;
    ChartAreaStyle areaStyle;

    /// 构造空样式（颜色 0 = 跟随主题，borderRadius 空表 = 缺省圆角）。
    static ChartItemStateStyle Create() {
        ChartItemStateStyle st = new ChartItemStateStyle {
            color = 0, borderColor = 0, borderWidth = 0,
            lineStyle = ChartLineStyle.Of(0, 0), areaStyle = ChartAreaStyle.Create()
        };
        st.borderRadius = new List<int>();
        return st;
    }
}

/// ECharts itemStyle：normal 与 emphasis 两套状态样式。
class ChartItemStyle {
    ChartItemStateStyle normal;
    ChartItemStateStyle emphasis;

    /// 构造 normal/emphasis 均为空样式的项样式。
    static ChartItemStyle Create() {
        return new ChartItemStyle {
            normal = ChartItemStateStyle.Create(), emphasis = ChartItemStateStyle.Create()
        };
    }

    /// 深复制单个状态（含 borderRadius 列表与线/面积子样式）；
    /// src 为 null 时返回 null。
    static ChartItemStateStyle CloneState(ChartItemStateStyle src) {
        if (src == null) { return null; }
        ChartItemStateStyle st = ChartItemStateStyle.Create();
        st.color = src.color; st.color0 = src.color0;
        st.borderColor = src.borderColor; st.borderWidth = src.borderWidth;
        st.lineStyle = ChartLineStyle.Of(src.lineStyle.color, src.lineStyle.width);
        st.lineStyle.color0 = src.lineStyle.color0; st.lineStyle.type = src.lineStyle.type;
        st.lineStyle.transparent = src.lineStyle.transparent;
        st.lineStyle.alpha = src.lineStyle.alpha;
        st.lineStyle.shadowColor = src.lineStyle.shadowColor;
        st.lineStyle.shadowBlur = src.lineStyle.shadowBlur;
        st.areaStyle = ChartAreaStyle.Create(); st.areaStyle.color = src.areaStyle.color;
        st.areaStyle.type = src.areaStyle.type;
        st.areaStyle.alpha = src.areaStyle.alpha;
        if (src.areaStyle.gradStops != null) {
            st.areaStyle.gradStops = new List<int>();
            for (int gsi = 0; gsi < src.areaStyle.gradStops.Count; gsi = gsi + 1) {
                st.areaStyle.gradStops.Add(src.areaStyle.gradStops[gsi]);
            }
        }
        st.borderRadius = new List<int>();
        for (int i = 0; i < src.borderRadius.Count; i = i + 1) { st.borderRadius.Add(src.borderRadius[i]); }
        return st;
    }

    /// 深复制 normal/emphasis 两套状态；src 为 null 时返回 null。
    static ChartItemStyle Clone(ChartItemStyle src) {
        if (src == null) { return null; }
        return new ChartItemStyle { normal = ChartItemStyle.CloneState(src.normal),
            emphasis = ChartItemStyle.CloneState(src.emphasis) };
    }
}

/// 仪表盘轴线色带的一个停靠点：stop 为 0..1000 的弧长千分位，
/// color 为自该点起的颜色。
class GaugeColorStop {
    int stop;
    int color;

    /// 构造一个色带停靠点。
    static GaugeColorStop Of(int stop, int color) {
        return new GaugeColorStop { stop = stop, color = color };
    }

    /// 深复制；src 为 null 时返回 null。
    static GaugeColorStop Clone(GaugeColorStop src) {
        if (src == null) { return null; }
        return GaugeColorStop.Of(src.stop, src.color);
    }
}

/// 仪表盘轴线：线样式 + 渐变色带（colors 按 stop 顺序着色）。
class GaugeAxisLine {
    bool show;
    ChartLineStyle lineStyle;
    List<GaugeColorStop> colors;

    /// 构造默认轴线：显示、宽 10，并预置 ECharts 风格三段色带
    ///（20% 以下绿、80% 以下蓝、以上红）。
    static GaugeAxisLine Create() {
        GaugeAxisLine a = new GaugeAxisLine {
            show = true, lineStyle = ChartLineStyle.Of(0, 10), colors = new List<GaugeColorStop>()
        };
        // ECharts 自带的仪表盘调色板（20% 以下绿、80% 以下蓝、以上红），
        // 未设置任何颜色的仪表盘看起来像参考示例，
        // 而不是在深色皮肤下消失的纯灰环。
        a.colors.Add(GaugeColorStop.Of(200, Chart.Rgb(34, 139, 34)));
        a.colors.Add(GaugeColorStop.Of(800, Chart.Rgb(68, 136, 187)));
        a.colors.Add(GaugeColorStop.Of(1000, Chart.Rgb(255, 69, 0)));
        return a;
    }

    /// 深复制（含色带列表）；src 为 null 时返回 null。
    static GaugeAxisLine Clone(GaugeAxisLine src) {
        if (src == null) { return null; }
        GaugeAxisLine a = new GaugeAxisLine { show = src.show,
            lineStyle = ChartLineStyle.Clone(src.lineStyle), colors = new List<GaugeColorStop>() };
        if (src.colors != null) {
            for (int i = 0; i < src.colors.Count; i = i + 1) {
                a.colors.Add(GaugeColorStop.Clone(src.colors[i]));
            }
        }
        return a;
    }
}

/// 仪表盘刻度线：主刻度数、刻度长度与线样式。
class GaugeAxisTick {
    bool show;
    int splitNumber;
    int length;
    ChartLineStyle lineStyle;

    /// 构造默认刻度：显示、5 个主刻度、长 6px、灰细线。
    static GaugeAxisTick Create() {
        return new GaugeAxisTick {
            show = true, splitNumber = 5, length = 6,
            lineStyle = ChartLineStyle.Of(Chart.Rgb(200, 203, 210), 1)
        };
    }

    /// 深复制；src 为 null 时返回 null。
    static GaugeAxisTick Clone(GaugeAxisTick src) {
        if (src == null) { return null; }
        return new GaugeAxisTick { show = src.show, splitNumber = src.splitNumber,
            length = src.length, lineStyle = ChartLineStyle.Clone(src.lineStyle) };
    }
}

/// 仪表盘轴标签：开关、formatter（"" = 显示原值）与文本样式。
class GaugeAxisLabel {
    bool show;
    string formatter;
    ChartTextStyle textStyle;

    /// 构造默认标签：显示、无 formatter、默认文本样式。
    static GaugeAxisLabel Create() {
        return new GaugeAxisLabel { show = true, formatter = "", textStyle = ChartTextStyle.Create() };
    }

    /// 深复制；src 为 null 时返回 null。
    static GaugeAxisLabel Clone(GaugeAxisLabel src) {
        if (src == null) { return null; }
        return new GaugeAxisLabel { show = src.show, formatter = src.formatter,
            textStyle = ChartTextStyle.Clone(src.textStyle) };
    }
}

/// 仪表盘分隔线：开关、长度与线样式。
class GaugeSplitLine {
    bool show;
    int length;
    ChartLineStyle lineStyle;

    /// 构造默认分隔线：显示、长 10px、灰粗线（宽 3）。
    static GaugeSplitLine Create() {
        return new GaugeSplitLine {
            show = true, length = 10,
            lineStyle = ChartLineStyle.Of(Chart.Rgb(180, 184, 192), 3)
        };
    }

    /// 深复制；src 为 null 时返回 null。
    static GaugeSplitLine Clone(GaugeSplitLine src) {
        if (src == null) { return null; }
        return new GaugeSplitLine { show = src.show, length = src.length,
            lineStyle = ChartLineStyle.Clone(src.lineStyle) };
    }
}

/// 仪表盘指针：长度（标量）、宽度、颜色（0 = 默认）与阴影。
class GaugePointer {
    ChartScalar length;
    int width;
    int color;
    int shadowColor;
    int shadowBlur;

    /// 构造默认指针：ECharts2 默认长 80%、宽 8px；
    /// color 0 = 'auto'（跟随轴线色阶段色，见 DrawGauge）。
    static GaugePointer Create() {
        return new GaugePointer {
            length = ChartScalar.Pct(80), width = 8, color = 0, shadowColor = 0, shadowBlur = 0
        };
    }

    /// 深复制；src 为 null 时返回 null。
    static GaugePointer Clone(GaugePointer src) {
        if (src == null) { return null; }
        return new GaugePointer { length = ChartScalar.Clone(src.length), width = src.width,
            color = src.color, shadowColor = src.shadowColor, shadowBlur = src.shadowBlur };
    }
}

/// 仪表盘标题（系列名）：开关、相对圆心的偏移与文本样式。
class GaugeTitle {
    bool show;
    ChartPosition offsetCenter;
    ChartTextStyle textStyle;

    /// 构造默认标题：显示、位于 (0px, 20%)、灰字 16px。
    static GaugeTitle Create() {
        ChartTextStyle text = ChartTextStyle.Create();
        text.color = Chart.Rgb(84, 89, 99);
        text.fontSize = 16;
        return new GaugeTitle {
            show = true, offsetCenter = ChartPosition.Of(ChartScalar.Px(0), ChartScalar.Pct(20)),
            textStyle = text
        };
    }

    /// 深复制；src 为 null 时返回 null。
    static GaugeTitle Clone(GaugeTitle src) {
        if (src == null) { return null; }
        return new GaugeTitle { show = src.show,
            offsetCenter = ChartPosition.Clone(src.offsetCenter),
            textStyle = ChartTextStyle.Clone(src.textStyle) };
    }
}

/// 仪表盘数值牌：背景/边框、相对圆心偏移与 formatter
///（{value} 占位替换为当前值）。
class GaugeDetail {
    bool show;
    int backgroundColor;
    int borderWidth;
    int borderColor;
    int width;
    int height;
    ChartPosition offsetCenter;
    string formatter;
    ChartTextStyle textStyle;

    /// 构造默认数值牌：显示、无边框底色、100x40、(0px, 40%)、30px 字。
    static GaugeDetail Create() {
        ChartTextStyle text = ChartTextStyle.Create();
        text.fontSize = 30;
        return new GaugeDetail {
            show = true, backgroundColor = 0, borderWidth = 0,
            borderColor = Chart.Rgb(204, 204, 204), width = 100, height = 40,
            offsetCenter = ChartPosition.Of(ChartScalar.Px(0), ChartScalar.Pct(40)),
            formatter = "", textStyle = text
        };
    }

    /// 深复制；src 为 null 时返回 null。
    static GaugeDetail Clone(GaugeDetail src) {
        if (src == null) { return null; }
        return new GaugeDetail { show = src.show, backgroundColor = src.backgroundColor,
            borderWidth = src.borderWidth, borderColor = src.borderColor,
            width = src.width, height = src.height,
            offsetCenter = ChartPosition.Clone(src.offsetCenter), formatter = src.formatter,
            textStyle = ChartTextStyle.Clone(src.textStyle) };
    }
}

/// 仪表盘完整配置（ECharts gauge.*）：圆心/半径、角度区间
///（数学角，默认 225°→-45°）、值域 [min,max]、小数位与分割数，
/// 以及轴线/刻度/标签/分隔线/指针/标题/数值牌子配置。
class GaugeOption {
    ChartPosition center;
    ChartScalar innerRadius;
    ChartScalar radius;
    int startAngle;
    int endAngle;
    int min;
    int max;
    int precision;
    int splitNumber;
    GaugeAxisLine axisLine;
    GaugeAxisTick axisTick;
    GaugeAxisLabel axisLabel;
    GaugeSplitLine splitLine;
    GaugePointer pointer;
    GaugeTitle title;
    GaugeDetail detail;

    /// 构造默认配置：中心 50%/50%、内径 0、半径 75%、
    /// 角度 225→-45、值域 0..100、precision 0、10 分割。
    static GaugeOption Create() {
        return new GaugeOption {
            center = ChartPosition.Of(ChartScalar.Pct(50), ChartScalar.Pct(50)),
            innerRadius = ChartScalar.Px(0), radius = ChartScalar.Pct(75),
            startAngle = 225, endAngle = 0 - 45, min = 0, max = 100,
            precision = 0, splitNumber = 10,
            axisLine = GaugeAxisLine.Create(), axisTick = GaugeAxisTick.Create(),
            axisLabel = GaugeAxisLabel.Create(), splitLine = GaugeSplitLine.Create(),
            pointer = GaugePointer.Create(), title = GaugeTitle.Create(), detail = GaugeDetail.Create()
        };
    }

    /// 深复制全部子配置；src 为 null 时返回 null。
    static GaugeOption Clone(GaugeOption src) {
        if (src == null) { return null; }
        return new GaugeOption { center = ChartPosition.Clone(src.center),
            innerRadius = ChartScalar.Clone(src.innerRadius), radius = ChartScalar.Clone(src.radius),
            startAngle = src.startAngle, endAngle = src.endAngle, min = src.min, max = src.max,
            precision = src.precision, splitNumber = src.splitNumber,
            axisLine = GaugeAxisLine.Clone(src.axisLine), axisTick = GaugeAxisTick.Clone(src.axisTick),
            axisLabel = GaugeAxisLabel.Clone(src.axisLabel), splitLine = GaugeSplitLine.Clone(src.splitLine),
            pointer = GaugePointer.Clone(src.pointer), title = GaugeTitle.Clone(src.title),
            detail = GaugeDetail.Clone(src.detail) };
    }
}

/// 雷达/极坐标系统（ECharts2 polar[]）：一个 option 可带多个
/// polar，radar 系列用 polarIndex 绑定到对应坐标系。指示器
/// （轴名+满刻度）、圆心/半径、起始角、环数、网格形状与
/// 指示器名样式都按 polar 独立配置。
class RadarPolar {
    List<string> indicatorText; // 每轴指示器名；空 = 回退 option 类目（dims）
    List<int> indicatorMax;     // 每轴满刻度；0/缺 = 从该 polar 的系列推导
    ChartPosition center;       // 圆心（% 相对面板宽高 / px）；null = 单 polar 自动居中
    ChartScalar radius;         // 外径（% 相对 min(areaW,areaH)/2 / px）；0 = 自动
    ChartScalar radiusInner;    // 内径（polar.radius:[30,'80%'] 的首元）；
                                //   Px(0) = 从圆心起（ECharts 缺省 [0,'80%']）
    int startAngle;             // 第一轴的数学角（90 = 正上，ECharts2 默认）
    int splitNumber;            // 环数；0 = 4（与单 polar 现状一致）
    string type;                // "" / "circle" / "polygon"；"" = 跟全局 radarShape
    int nameColor;              // 指示器名颜色；0 = 主题轴色
    string nameFormat;          // 指示器名模板（ECharts name.formatter 字符串版，
                                //   "{value}" 占位；"" = 原名）
    int axisLineColor;          // 轴线颜色；0 = 主题网格色
    int axisLineWidth;          // 轴线宽；0 = 1
    int splitLineColor;         // 分隔环线颜色；0 = 主题网格色
    int splitLineWidth;         // 分隔环线宽；0 = 1
    List<int> splitAreaColors;  // 环带交替色（约 30% 透明绘制）；空 = 跟全局

    static RadarPolar Create() {
        RadarPolar p = new RadarPolar {
            indicatorText = new List<string>(), indicatorMax = new List<int>(),
            center = null, radius = ChartScalar.Px(0),
            radiusInner = ChartScalar.Px(0), startAngle = 90,
            splitNumber = 0, type = "", nameColor = 0, nameFormat = "",
            axisLineColor = 0, axisLineWidth = 0, splitLineColor = 0,
            splitLineWidth = 0, splitAreaColors = new List<int>()
        };
        return p;
    }

    static RadarPolar Clone(RadarPolar src) {
        if (src == null) { return null; }
        RadarPolar p = new RadarPolar {
            indicatorText = new List<string>(), indicatorMax = new List<int>(),
            center = ChartPosition.Clone(src.center),
            radius = ChartScalar.Clone(src.radius),
            radiusInner = ChartScalar.Clone(src.radiusInner),
            startAngle = src.startAngle, splitNumber = src.splitNumber,
            type = src.type, nameColor = src.nameColor, nameFormat = src.nameFormat,
            axisLineColor = src.axisLineColor, axisLineWidth = src.axisLineWidth,
            splitLineColor = src.splitLineColor, splitLineWidth = src.splitLineWidth,
            splitAreaColors = new List<int>()
        };
        for (int i = 0; i < src.indicatorText.Count; i = i + 1) {
            p.indicatorText.Add(src.indicatorText[i]);
        }
        for (int i = 0; i < src.indicatorMax.Count; i = i + 1) {
            p.indicatorMax.Add(src.indicatorMax[i]);
        }
        for (int i = 0; i < src.splitAreaColors.Count; i = i + 1) {
            p.splitAreaColors.Add(src.splitAreaColors[i]);
        }
        return p;
    }
}

/// 一个数据系列（ECharts series[i]）。每个系列携带自己的类型，
/// 混合图表自然实现：带折线叠加的柱状图只是
/// 共享同一坐标系的两个不同类型系列——无需 AsKind 垫片。
/// axisIndex 将系列绑定到 yAxis（0 = 左/主，1 = 右/次）；
/// stack 将系列归入一个堆叠柱/面积（相同正 id；
/// StackedBar / StackedArea 工厂默认 stack = 1）。
/// 旧的伪类型（Area、StepLine、Donut、Rose 等）已移除：其行为现由
/// 系列子实体表达——areaStyle、step、innerPct、roseType、sort
/// ——与 ECharts 的建模完全一致。数据为统一的 List<ChartData>；
/// 多值系列族（candle/bubble/box/error/scatter）使用专用的
/// 列表。
class ChartSeries {
    string name;
    ChartType type;
    int axisIndex;   // 0 = 左/主 Y 轴，1 = 右/次 Y 轴
    int xIndex;      // ECharts series.xAxisIndex（多 grid 布局分组）
    bool visBlocked; // lineStyle.color 显式声明（visualMap 不覆盖线色）
    int stack;       // 0 = 无；共享正 id 的系列堆叠在一起
    string stackName; // ECharts 堆叠组：同名系列堆叠
    // ECharts series.stackStrategy（util/types.ts:2098）：同一 stack
    // 组内哪些系列参与累加。源码
    // processor/dataStack.ts:112 缺省 "samesign"——只同号累加（正堆上正、
    // 负堆下负）；"all" 无视符号、"positive"/"negative" 只累加指定符号。
    int stackStrategy;  // 0 = samesign（缺省）| 1 = all | 2 = positive | 3 = negative
    int color;       // 0 = 自动（调色板）
    bool hidden;     // 通过交互式图例关闭
    int smooth;      // -1 = 跟随 option.smooth，0/1 = 逐系列覆盖
    bool areaStyle;  // ECharts line.areaStyle.show：填充折线下方区域
    bool endLabelShow;        // ECharts line.endLabel.show：线尾标注
    int endLabelDistance;     // endLabel.distance：与线尾端点的间距（px）
    string endLabelFormatter; // endLabel.formatter：'{a}' 占位系列名
    string step;     // ECharts line.step: "" | "start" | "middle" | "end"
    string sort;     // ECharts funnel.sort："descending"（默认）| "ascending"（金字塔）
    string roseType; // ECharts pie.roseType："" | "radius" | "area"（玫瑰图）
    ChartPosition center;   // ECharts pie.center：['25%', 200]——null = 未设，
                            //   多系列共享圆心；Px 的 y 相对绘图区顶
    ChartScalar radius;     // ECharts pie.radius 外径：'55%' | 80（null = 未设，
                            //   % 相对 min(绘图区宽,高)/2）
    ChartScalar radiusInner; // radius [min, max] 的 min（环内径，null = 未设）
    int startAngle;  // ECharts pie.startAngle：数学角（0=3点钟，逆时针增）。
                     // 默认 90 = 12 点钟起始；内部换算为顺时针偏移 90-值。
    bool clockWise;  // ECharts pie.clockWise：false = 扇区从起始边逆时针铺
                     //（默认 true 顺时针）
    int polarIndex;  // ECharts2 series.polarIndex：绑定到 option.polars[]
                     //   的第几个坐标系（默认 0；单 polar 时忽略）
    int selectedOffset; // ECharts pie.selectedOffset：选中扇区外偏像素（默认 10）
    int barWidth;    // ECharts bar.barWidth：柱宽像素；0 = 自动
    int barWidthPct; // ECharts bar.barWidth 的百分比形式（"60%"）：类目
                     //   带宽的百分比；0 = 未设（跟随 barWidth/自动）
    int barHeight;   // ECharts bar.barHeight：>0 时双数值轴值对柱画横条
                     //   （厚度 px、垂直中心在 y 值、从 x=0 基线长到 x 值，
                     //   官方 _buildOther 横向分支）；0 = 竖柱
    int barMinHeight; // ECharts bar.barMinHeight：柱条最小像素高（直角坐标）/
                     //   最小像素半径跨度（极坐标径向柱）。|高| < 该值时按符号补足
                     //   （layout/barGrid.ts:456-472，竖向分支的判定是 h<=0——零值柱
                     //   也归负方向，结果是向上 1px）；0 = 不设（官方 `|| 0` 缺省）
    int barMinAngle; // ECharts bar.barMinAngle：极坐标切向柱最小角度跨度
                     //   （layout/barPolar.ts:165-167）；0 = 不设
    bool roundCap;   // ECharts bar.roundCap：极坐标**切向**柱的端点圆头
                     //   （BarView.polar 的 `(!isRadial && roundCap) ?
                     //   Sausage : Sector`）。缺省 false（BarSeries.ts:149
                     //   的 defaultOption）。它同时是 barPolar 的 clampLayout
                     //   开关：切向柱圆头时**不**把值钳回轴量程
                     //   （barPolar.ts:112-113），端点才能伸出外环。
    int barGapPct;   // ECharts bar.barGap：同系列柱间距百分比；-1 = 旧固定缝
    // 柱布局原始选项（ECharts layout/barGrid.ts:createLayoutInfoListOnAxis
    // 的系列侧输入）。字符串原样保留 `'N%'` / 数值两种形态，布局期才按
    // 带宽用 parsePercent 折算：上面几个折算成 int 的字段在 300/7 = 42.857
    // 这类带宽上丢精度，柱宽因此系统性偏差。"" = 选项缺省。
    string barWidthRaw;
    string barGapRaw;
    string barCategoryGapRaw;
    string barMinWidthRaw;
    string barMaxWidthRaw;
    bool large;      // ECharts bar.large：大数据量退化渲染标志
    int largeThreshold; // ECharts bar.largeThreshold（缺省 400）
    bool silent;     // ECharts series.silent：true = 不响应鼠标命中（不出
                     //     tooltip），图形照画（waterfall2 占位柱）
    string symbol;   // ECharts series.symbol 形状族（Sanitized：circle/emptyCircle/
                     //   rectangle/diamond/triangle；"" = 按族默认）
    int symbolSize;  // ECharts series.symbolSize 像素；0 = 自动（族默认）
    int pointG;      // 点坐标放大器：points 的 x/y 存的是值×pointG（定点），
                     // 渲染/量程/命中/tooltip 统一除回——ECharts 小数坐标
                     //（scatter3 的 (Math.random()*10).toFixed(3)）在 int
                     // 管线里这样承载；1 = 原值（缺省，除法跳过）。
    string symbolSizeFn; // ECharts symbolSize:function(val){...} 的确定性替代：
                         // "y"      -> 半径 = y 值（平方根比例可选）
                         // "ySqrt"  -> 半径 = ISqrt(y)（面积∝值，气泡图常用）
                         // "x"|"xSqrt" 同理按 x
                         // ""      = 关（用 symbolSize / 逐点 size）
                         // 随 val 而变，非逐点常量——函数回调无法确定性
                         // 复刻，以公式字段表达同一语义。
    int showSymbol;  // ECharts line.showSymbol：-1 自动 | 0 隐藏点 | 1 显示
    // ECharts line.showAllSymbol：-1 'auto'（缺省）| 0 false | 1 true。
    // 出处 `chart/line/LineView.ts:367-401 getIsIgnoreFunc`：true 全显；
    // 'auto' 且 CanShowAllSymbolForCategory 通过时全显（源码注释："we show
    // all symbols as possible as we can"）；否则按类目标签间隔抽稀。
    int showAllSymbol;
    bool showBackground; // ECharts bar.showBackground：零线到满刻度的底带
    int backgroundColor; // backgroundStyle.color；0 = 网格线色
    int innerPct;    // 饼图环形孔占外半径的百分比（0 = 实心饼）
    bool hbar;       // 柱状图布局：水平绘制（ECharts 交换 value-x/category-y）
    string treeOrient; // ECharts tree.orient："" = 垂直 | "horizontal"
    ChartLineStyle treeLine; // ECharts2 tree itemStyle.normal.lineStyle：
                             //   color/type(curve|solid|broken|dashed|dotted)/
                             //   shadow*；color 0 且 type "" = 现状直角网格色
    bool piePerPoint; // ECharts2 mix7「以饼代点」：散点坐标系里逐点画
                      //   小饼。同 option 内所有 piePerPoint 系列按下标
                      //   配对——圆心取首个系列 points[i] 的 (x,y) 值
                      //   坐标，半径取 points[i].size，扇区值取各系列
                      //   points[i].z、各用系列色
    string custom;   // ChartType.Custom 的扩展渲染器："box" | "error" |
    string emphasisFocus; // ECharts series.emphasis.focus："series" =
                     //   悬停本系列时其余系列渐隐（ECharts 6 fadeFocus
                     //   语义：非悬停系列描边/填充乘残alpha，本系列
                     //   加粗），"" = 无高亮聚焦。渲染端读
                     //   Chart.EmphHoverKey(iwid) 的悬停系列下标。
    string selectedMode; // ECharts map.selectedMode（Sanitized）：""/"single" | "multiple" | "false"
                     //   "sankey" | "waterfall" | "sunburst" | "radialBars" | "venn" | ""
    string mapName;  // ECharts series.map：注册表地图名（"" = 未用）；
                     //   渲染前由 ChartMaps.BindSeries 注入区域几何
    int geoIndex;    // ECharts series.geoIndex：绑定的 geo 组件下标
    bool isGeoBase;  // geo 组件合成的底图载体系列（非用户声明）
    // ---- pictorialBar（custom == "pictorialBar"）----
    string picSymbol; // 原始 symbol 串：内置形状名 / path:// / image://
    string picRepeat; // symbolRepeat："true" | "fixed" | ""
    bool picClip;     // symbolClip：符号裁到值高
    string picPos;    // symbolPosition："start"（默认）| "end"
    int picBound;     // symbolBoundingData 标量（0 = 用轴最大值）
    int picW;         // symbolSize 宽（像素形态）
    int picH;         // symbolSize 高（像素形态）
    int picWPct;      // symbolSize 宽（% 相对类目槽宽）
    int picHPct;      // symbolSize 高（% 相对绘图区高）
    // ---- parallel / themeRiver ----
    List<List<int>> parRows;   // parallel：每行一个维值数组（平行坐标）
    List<string> riverTimes;   // themeRiver：逐点时间标签
    List<int> riverVals;       // themeRiver：逐点值
    List<int> riverCat;        // themeRiver：逐点名字下标（ riverNames ）
    List<string> riverNames;   // themeRiver：名字表（图例 + 调色板）
    // ---- 批 6：force / chord / funnel / wordCloud 参数化 ----
    int forceScaling;       // ECharts force.scaling（%）；100 = 现状
    int forceGravity;       // ECharts force.gravity（%）；100 = 现状
    int forceMinRadius;     // ECharts force.minRadius（px 节点半径下限）；0 = 关
    int forceMaxRadius;     // ECharts force.maxRadius（px 节点半径上限）
    int forceNodeColor;     // force.nodeStyle.color；0 = 逐节点调色板
    int forceLinkColor;     // force.linkStyle.color；0 = 调色板半透明
    string forceLinkSymbol; // force.linkSymbol："arrow" = 目标端箭头；
                            //   ""/none = 无（现状）
    string chordRibbonType; // ECharts chord ribbonType："path" = 细线；"" = 弧带
    int chordSort;          // ECharts chord.sort：0 首现 | 1 descending | 2 ascending
    bool chordSortSub;      // ECharts chord.sortSub：子弧按值降序
    int chordGapDeg;        // 外环节点间隙（度）；-1 = 自动（2，拥挤归 0）
    int chordRingWidthPct;  // 外环宽（占半径 %）；0 = 默认 22
    List<List<int>> matrix; // ECharts2 chord.matrix：n×n 权重阵；非空时与
                            //   data[i].name 组成节点（含对角自环），展开为
                            //   links 渲染（links 非空时优先用 links）
    string funnelAlign;     // ECharts funnel.funnelAlign：""=center | left | right
    int funnelGap;          // 漏斗层间隙 px；-1 = 默认 0（官方层间无缝衔接）
    bool funnelPercent;     // 标签/提示行值后追加「（x%）」转化率
    int maxSizePct;         // ECharts funnel.maxSize '80%'：最宽层占宽百分比（0=100）
    bool funnelLabelOut;    // 阶段名外标：层右端标注（官方 label.formatter '{b}预期'）
    int forceCurveness;     // ECharts force.linkStyle.normal.curveness ×1000
                            //（0 = 直线；200 = 0.2，二次贝塞尔弯曲连线）
    int wcMinFontSize;      // wordCloud sizeRange[0] px；0 = 默认 Scale(11)
    int wcMaxFontSize;      // wordCloud sizeRange[1] px；0 = 默认自适应
    string wcRotate;        // wordCloud.rotate："vary" = 横向/竖向交替；"" = 现状
    string wcRotateList;    // wordCloud.rotate 自定义角度集，逗号分隔（"0,45,-45"）；
                            // 非空时优先于 wcRotate（ECharts textRotation 数组）
    ChartItemStyle itemStyle; // ECharts series.itemStyle：normal / emphasis
    ChartTextStyle label;     // ECharts series.label 的静态样式
    bool labelShow;           // series.label.show；渲染器可选择显示数据值
    bool pieLabels;           // 系列级内标百分比（多饼同板逐系列开关，
                              //   覆盖 option.pieLabels；false = 跟随 option）
    string labelFmt;          // ECharts label.formatter 模板：{a}=系列名 {b}=类目 {c}=值
    string labelPos;          // ECharts label.position："top"/"bottom"/"insideTop"/
    int labelShowT;           // label.show 三态：-1 未声明 / 0 false / 1 true。
                              //   缺省随系列型（ECharts PieSeries.ts:269 饼
                              //   =true；线柱=false），故存原始三态由渲染器解
                              //   析；labelShow 保留线柱语义（=1 才真）。
    int labelLineShow;        // labelLine.show 三态：-1 未声明 / 0 / 1（饼外
                              //   标引线；0 只藏线，文本仍在 x3）
    int labelLineLen;         // labelLine.length：第一段径向长 px；-1 = 缺省 15
    int labelLineLen2;        // labelLine.length2：第二段水平长 px；-1 = 缺省 30
    int labelDist;            // label.distanceToLabelLine：文本离水平段 px；
                              //   -1 = 缺省 5
    int labelEdgeDist;        // label.edgeDistance：alignTo:'edge' 时离面板边
                              //   px（数字形态）；-1 = 缺省 '25%'
    int labelAlignTo;         // label.alignTo：0 'none' / 1 'labelLine' / 2 'edge'
    int labelRotate;          // ECharts label.rotate：系列数值标签整体旋转
                              //   （度，ECharts 正值=逆时针；0 = 水平）
                              //   "left"/"right"/"insideLeft"/"insideRight"；"" = 渲染器缺省
    List<ChartData> data;
    List<Candle> candles;      // 蜡烛图种类
    List<Bubble> bubbles;      // 气泡图种类
    List<BoxItem> boxes;       // 箱线图种类
    List<ErrorItem> errors;    // 误差条种类
    List<ChartPoint> points;    // 散点图种类
    List<ChartNode> tree;      // Treemap / Sunburst（层级根列表）
    List<ChartLink> links;     // Sankey / Chord / Force 种类
    List<ChartMapRegion> regions;  // Map 种类
    List<ChartEvent> events;       // Event River 种类
    List<ChartMarkPoint> marks;    // markPoint.data（线/柱系列）
    string markLabelFmt;  // series 级 markPoint.label.formatter 模板
                          //   （bar-rich-text "{a|{a}\n}{b|{b} }{c|{c}}"；
                          //   {a}=系列名 {b}=mark name {c}=值）
    ChartTextStyle markLabelSt; // series 级 markPoint.label 富文本/盒样式；
                                //   null = 未声明 rich（pin 徽标走原路径）
    string markLabelPos;  // markPoint.label.position："right"/"top"（缺省 top）
    int markLabelDist;    // markPoint.label.distance：-1 = 未声明（官方缺省 5）
    int markSymbolSize;   // series 级 markPoint.symbolSize：-1 = 未声明
                          //   （声明后显式 mark 不再画 pin 气球，画小点）
    List<ChartMarkLine> markLines; // markLine.data（阈值/平均线，线/柱系列）

    // series.labelLayout（ECharts 5 标签布局）：绝对 x/y（容器系，像素）
    // 与相对偏移 dx/dy、水平对齐、重叠隐藏与解叠。语料形：dx:-20
    // （scatter-*-regression）、y:20+align+hideOverlap+shiftX
    // （scatter-label-align-top）、shiftY（line-race 逐系列）、
    // hideOverlap（graph-label-overlap）。
    bool llDeclared;      // 声明了 labelLayout（参与标签布局组的门）
    int llDx;             // dx：标签 x 偏移（px，缺省 0）
    int llDy;             // dy：标签 y 偏移（px，缺省 0）
    int llX;              // x：绝对横位（容器系；LL_UNSET = 未声明）
    int llY;              // y：绝对纵位（容器系；LL_UNSET = 未声明）
    string llAlign;       // align："" | "left" | "center" | "right"
    bool llHideOverlap;   // hideOverlap: true = 与已放标签相交则隐藏
    string llMove;        // moveOverlap："" | "shiftX" | "shiftY"
    static int LL_UNSET = 0 - 1000000000;  // labelLayout x/y 未声明哨兵

    string graphLayout;   // ECharts graph.layout："" | "force" | "none" | "circular"
    List<int> nodeX;      // graph layout:'none' 的逐节点 x（数据坐标；-1 = 未给）
    List<int> nodeY;      // graph layout:'none' 的逐节点 y（数据坐标；-1 = 未给）
    List<string> graphCats; // graph categories 名称表（图例 + 类别调色板）
    string coordSys;      // ECharts series.coordinateSystem："geo" = 地理坐标
                          //   （散点/lines/graph 系列叠加在地图底图上）；
                          //   "calendar" = 日历坐标（日期落在日历格）；
                          //   "" = 直角/默认坐标系
    int calIndex;         // series.calendarIndex（coordSys == "calendar" 的目标日历）
    int calCenter;        // calendar 坐标系下 pie.center 的日期（1970 起天序）；-1 = 未给
    string typeName;      // 原始 ECharts type 字符串（"effectScatter"/"graph"/
                          //   "candlestick"..."）。ChartType 是粗粒度归并
                          //   （effectScatter->Scatter、graph->Force），
                          //   渲染器需要细分时读它。
    List<List<ChartPoint>> geoLines; // lines(coordSys=geo)：每项一条折线
                                     //   （coords 0.01° 定点，y = -lat×100）

    GaugeOption gauge;

    /// 从纯 int 值构建系列（每个值变为 ChartData.Of(v)）。
    static ChartSeries Of(string name, ChartType type, List<int> values) {
        ChartSeries s = new ChartSeries();
        s.name = name;
        s.type = type;
        s.axisIndex = 0;
        s.stack = 0;
        s.stackName = "";
        s.stackStrategy = 0;
        s.color = 0;
        s.hidden = false;
        s.smooth = 0 - 1;
        s.areaStyle = false;
        s.endLabelShow = false;
        s.endLabelDistance = 5;
        s.endLabelFormatter = "";
        s.step = "";
        s.sort = "descending";
        s.roseType = "";
        s.startAngle = 90;
        s.clockWise = true;
        s.polarIndex = 0;
        s.selectedOffset = 10;
        s.barWidth = 0;
        s.barWidthPct = 0;
        s.barHeight = 0;
        s.barMinHeight = 0;
        s.barMinAngle = 0;
        // ECharts BarSeries.defaultOption.roundCap = false（BarSeries.ts:149）。
        // 源里 `get('roundCap', true)` 的第二个参数只是"取不到时的兜底"，
        // 而 defaultOption 已经给了 false，实际永远取不到兜底值。
        // 旧代码缺省 true，于是切向柱全画成圆头香肠。
        s.roundCap = false;
        s.barGapPct = 0 - 1;
        s.barWidthRaw = "";
        s.barGapRaw = "";
        s.barCategoryGapRaw = "";
        s.barMinWidthRaw = "";
        s.barMaxWidthRaw = "";
        s.large = false;
        s.largeThreshold = 400;
        s.silent = false;
        s.symbol = "";
        s.symbolSize = 0;
        s.pointG = 1;
        s.symbolSizeFn = "";
        s.showSymbol = 0 - 1;
        s.showAllSymbol = 0 - 1;
        s.showBackground = false;
        s.backgroundColor = 0;
        s.innerPct = 0;
        s.hbar = false;
        s.treeOrient = "";
        s.treeLine = ChartLineStyle.Of(0, 0);
        s.treeLine.type = "";
        s.piePerPoint = false;
        s.custom = "";
        s.emphasisFocus = "";
        s.selectedMode = "";
        s.mapName = "";
        s.geoIndex = 0;
        s.isGeoBase = false;
        s.picSymbol = "";
        s.picRepeat = "";
        s.picClip = false;
        s.picPos = "";
        s.picBound = 0;
        s.picW = 0;
        s.picH = 0;
        s.picWPct = 0;
        s.picHPct = 0;
        s.parRows = new List<List<int>>();
        s.riverTimes = new List<string>();
        s.riverVals = new List<int>();
        s.riverCat = new List<int>();
        s.riverNames = new List<string>();
        s.forceScaling = 100;
        s.forceGravity = 100;
        s.forceMinRadius = 0;
        s.forceMaxRadius = 0;
        s.forceNodeColor = 0;
        s.forceLinkColor = 0;
        s.forceLinkSymbol = "";
        s.chordRibbonType = "";
        s.chordSort = 0;
        s.chordSortSub = false;
        s.chordGapDeg = 0 - 1;
        s.chordRingWidthPct = 0;
        s.matrix = new List<List<int>>();
        s.funnelAlign = "";
        s.funnelGap = 0 - 1;
        s.funnelPercent = false;
        s.maxSizePct = 0;
        s.funnelLabelOut = false;
        s.forceCurveness = 0;
        s.wcMinFontSize = 0;
        s.wcMaxFontSize = 0;
        s.wcRotate = "";
        s.wcRotateList = "";
        s.itemStyle = ChartItemStyle.Create();
        s.label = ChartTextStyle.Create();
        s.labelShow = false;
        s.labelShowT = 0 - 1;
        s.labelLineShow = 0 - 1;
        s.labelLineLen = 0 - 1;
        s.labelLineLen2 = 0 - 1;
        s.labelDist = 0 - 1;
        s.labelEdgeDist = 0 - 1;
        s.labelAlignTo = 0;
        s.pieLabels = false;
        s.labelFmt = "";
        s.labelPos = "";
        s.labelRotate = 0;
        s.data = new List<ChartData>();
        for (int i = 0; i < values.Count; i = i + 1) { s.data.Add(ChartData.Of(values[i])); }
        s.candles = new List<Candle>();
        s.bubbles = new List<Bubble>();
        s.boxes = new List<BoxItem>();
        s.errors = new List<ErrorItem>();
        s.points = new List<ChartPoint>();
        s.tree = new List<ChartNode>();
        s.links = new List<ChartLink>();
        s.regions = new List<ChartMapRegion>();
        s.events = new List<ChartEvent>();
        s.marks = new List<ChartMarkPoint>();
        s.markLines = new List<ChartMarkLine>();
        s.markLabelFmt = "";
        s.markLabelSt = null;
        s.markLabelPos = "";
        s.markLabelDist = 0 - 1;
        s.markSymbolSize = 0 - 1;
        s.llDeclared = false;
        s.llDx = 0;
        s.llDy = 0;
        s.llX = ChartSeries.LL_UNSET;
        s.llY = ChartSeries.LL_UNSET;
        s.llAlign = "";
        s.llHideOverlap = false;
        s.llMove = "";
        s.graphLayout = "";
        s.nodeX = new List<int>();
        s.nodeY = new List<int>();
        s.graphCats = new List<string>();
        s.coordSys = "";
        s.calIndex = 0;
        s.calCenter = 0 - 1;
        s.typeName = "";
        s.geoLines = new List<List<ChartPoint>>();
        s.gauge = GaugeOption.Create();
        return s;
    }

    /// 从显式数据项构建系列（名称 / 逐项颜色）。
    static ChartSeries Named(string name, ChartType type, List<ChartData> data) {
        ChartSeries s = ChartSeries.Of(name, type, new List<int>());
        s.data = data;
        return s;
    }

    // ---- 类型化工厂：每次调用一个系列，ECharts series[i] 风格 ----
    // `ChartSeries.Line("邮件营销", new List<int>{ ... })` reads like
    // `{ 名称: '邮件营销', type: 'line', 数据: [...] }` in ECharts.

    /// 折线系列。
    static ChartSeries Line(string name, List<int> values) { return ChartSeries.Of(name, ChartType.Line, values); }
    /// 面积折线系列（areaStyle = true，折线下方填充）。
    static ChartSeries Area(string name, List<int> values) {
        ChartSeries s = ChartSeries.Of(name, ChartType.Line, values);
        s.areaStyle = true;
        return s;
    }
    /// 柱状系列。
    static ChartSeries Bar(string name, List<int> values) { return ChartSeries.Of(name, ChartType.Bar, values); }
    /// 堆叠柱系列（stack = 1；同名 stackName 分组可用 JSON 覆盖）。
    static ChartSeries StackedBar(string name, List<int> values) {
        ChartSeries s = ChartSeries.Of(name, ChartType.Bar, values);
        s.stack = 1;
        return s;
    }
    /// 水平条形系列（类目在 Y 轴）。
    static ChartSeries HBar(string name, List<int> values) {
        ChartSeries s = ChartSeries.Of(name, ChartType.Bar, values);
        s.hbar = true;
        return s;
    }
    /// 水平堆叠条形系列（hbar + stack = 1；同名 stackName 分组）。
    static ChartSeries HStacked(string name, List<int> values) {
        ChartSeries s = ChartSeries.HBar(name, values);
        s.stack = 1;
        return s;
    }
    /// 值对柱状系列（ECharts 双数值轴柱形 bar13）：柱画在 points[i].x
    /// 处、从零线长到 points[i].y；x/y 都是数值轴。
    static ChartSeries OfBarPoints(string name, List<ChartPoint> pts) {
        ChartSeries s = ChartSeries.Of(name, ChartType.Bar, new List<int>());
        s.points = pts;
        return s;
    }
    /// 阶梯折线系列（step = "middle"）。
    static ChartSeries StepLine(string name, List<int> values) {
        ChartSeries s = ChartSeries.Of(name, ChartType.Line, values);
        s.step = "middle";
        return s;
    }
    /// 堆叠折线系列（stack = 1）。
    static ChartSeries StackedLine(string name, List<int> values) {
        ChartSeries s = ChartSeries.Of(name, ChartType.Line, values);
        s.stack = 1;
        return s;
    }
    /// 堆叠面积系列（stack = 1 且 areaStyle = true）。
    static ChartSeries StackedArea(string name, List<int> values) {
        ChartSeries s = ChartSeries.Of(name, ChartType.Line, values);
        s.stack = 1;
        s.areaStyle = true;
        return s;
    }
    /// 饼图系列（数据项名称作扇区标签）。
    static ChartSeries Pie(string name, List<int> values) { return ChartSeries.Of(name, ChartType.Pie, values); }
    /// 环形图系列（innerPct = 55）。
    static ChartSeries Donut(string name, List<int> values) {
        ChartSeries s = ChartSeries.Of(name, ChartType.Pie, values);
        s.innerPct = 55;
        return s;
    }
    /// 仪表盘系列：单值，值域由 GaugeRange / option.gaugeMax 决定。
    static ChartSeries Gauge(string name, int val) {
        ChartSeries s = ChartSeries.Named(name, ChartType.Gauge,
            new List<ChartData>{ ChartData.Named(val, name) });
        return s;
    }
    /// 仪表盘系列（double 值版本，保留小数）。
    static ChartSeries GaugeNumber(string name, double val) {
        ChartSeries s = ChartSeries.Named(name, ChartType.Gauge,
            new List<ChartData>{ ChartData.NamedNumber(val, name) });
        return s;
    }
    /// 雷达（极坐标）系列；每轴满刻度由 option.radarMax 声明。
    static ChartSeries Polar(string name, List<int> values) { return ChartSeries.Of(name, ChartType.Radar, values); }
    /// 词云系列；data 项名称为词、值为权重。
    static ChartSeries WordCloud(string name, List<ChartData> words) {
        return ChartSeries.Named(name, ChartType.WordCloud, words);
    }
    /// 漏斗系列（默认按值降序）。
    static ChartSeries Funnel(string name, List<int> values) { return ChartSeries.Of(name, ChartType.Funnel, values); }
    /// 金字塔系列（sort = "ascending"，倒漏斗）。
    static ChartSeries Pyramid(string name, List<int> values) {
        ChartSeries s = ChartSeries.Of(name, ChartType.Funnel, values);
        s.sort = "ascending";
        return s;
    }
    /// 玫瑰图系列（roseType = "radius"，扇区半径随值变化）。
    static ChartSeries Rose(string name, List<int> values) {
        ChartSeries s = ChartSeries.Of(name, ChartType.Pie, values);
        s.roseType = "radius";
        return s;
    }

    /// 由 OHLC 柱构建蜡烛图系列（ECharts type "k"）。
    static ChartSeries OfCandles(string name, List<Candle> candles) {
        ChartSeries s = ChartSeries.Of(name, ChartType.K, new List<int>());
        s.candles = candles;
        return s;
    }

    /// 由气泡构建加权散点系列（ECharts scatter + symbolSize）。
    static ChartSeries OfBubbles(string name, List<Bubble> bubbles) {
        ChartSeries s = ChartSeries.Of(name, ChartType.Scatter, new List<int>());
        s.bubbles = bubbles;
        return s;
    }

    /// 由逐分类统计量构建箱线图系列（扩展渲染器：
    /// ECharts 2.2.7 没有 boxplot 类型）。
    static ChartSeries OfBoxes(string name, List<BoxItem> boxes) {
        ChartSeries s = ChartSeries.Of(name, ChartType.Custom, new List<int>());
        s.custom = "box";
        s.boxes = boxes;
        return s;
    }

    /// 由值 +/- 误差对构建误差条系列（扩展渲染器）。
    static ChartSeries OfErrors(string name, List<ErrorItem> errors) {
        ChartSeries s = ChartSeries.Of(name, ChartType.Custom, new List<int>());
        s.custom = "error";
        s.errors = errors;
        return s;
    }

    /// 由显式 x/y 点构建散点系列。
    static ChartSeries OfPoints(string name, List<ChartPoint> points) {
        ChartSeries s = ChartSeries.Of(name, ChartType.Scatter, new List<int>());
        s.points = points;
        return s;
    }

    /// 值对折线系列（ECharts series.type='line' 且 data 为
    /// [[x,y],...]：line7 双数值轴）。与 OfPoints（散点点云）的
    /// 区别在类型：折线渲染器画连线+符号+markLine 全套。
    static ChartSeries OfLinePoints(string name, List<ChartPoint> points) {
        ChartSeries s = ChartSeries.Of(name, ChartType.Line, new List<int>());
        s.points = points;
        return s;
    }

    /// 由根节点构建层级系列（Treemap / Tree / Sunburst）。
    /// 系列持有根列表；子节点可任意深度嵌套。
    static ChartSeries OfTree(string name, ChartType type, ChartNode root) {
        ChartSeries s = ChartSeries.Of(name, type, new List<int>());
        s.tree.Add(root);
        return s;
    }

    /// 带显式布局方向的树系列（ECharts tree.orient）。
    /// 树默认显示节点标签（ECharts label.show 默认 true），
    /// JSON label.show=false / labelShow=false 时隐藏、悬停显。
    static ChartSeries OfTreeOrient(string name, ChartNode root, string orient) {
        ChartSeries s = ChartSeries.OfTree(name, ChartType.Tree, root);
        s.treeOrient = orient;
        s.labelShow = true;
        return s;
    }

    /// 由有向流转链接构建 Sankey 系列（节点从链接推导；
    /// 扩展渲染器——ECharts 2.2.7 没有 sankey 类型）。
    static ChartSeries OfLinks(string name, List<ChartLink> links) {
        ChartSeries s = ChartSeries.Of(name, ChartType.Custom, new List<int>());
        s.custom = "sankey";
        s.links = links;
        return s;
    }

    /// 和弦图系列：节点从 links 的 from/to 推导。
    static ChartSeries Chord(string name, List<ChartLink> links) {
        ChartSeries s = ChartSeries.Of(name, ChartType.Chord, new List<int>());
        s.links = links;
        return s;
    }

    /// ECharts2 chord 矩阵形式：matrix[i][j] = 节点 i → j 的权重
    ///（对角 = 自环），节点名/逐点色取 data（按行序补齐 ChartData）。
    static ChartSeries ChordMatrix(string name, List<string> nodes,
                                   List<List<int>> matrix) {
        ChartSeries s = ChartSeries.Of(name, ChartType.Chord, new List<int>());
        for (int i = 0; i < nodes.Count; i = i + 1) {
            ChartData d = ChartData.Named(0, nodes[i]);
            s.data.Add(d);
        }
        s.matrix = matrix;
        return s;
    }

    /// 力导向图系列：节点从 links 的 from/to 推导。
    static ChartSeries Force(string name, List<ChartLink> links) {
        ChartSeries s = ChartSeries.Of(name, ChartType.Force, new List<int>());
        s.links = links;
        return s;
    }

    /// 韦恩图系列：data 项依次为 [A, B, A∩B]（名称 + 值）。
    static ChartSeries Venn(string name, List<ChartData> data) {
        ChartSeries s = ChartSeries.Named(name, ChartType.Custom, data);
        s.custom = "venn";
        return s;
    }

    /// 由命名的累计柱数据构建瀑布图系列（渲染器构建
    /// 不可见的堆叠基底；扩展渲染器）。
    static ChartSeries Waterfall(string name, List<ChartData> data) {
        ChartSeries s = ChartSeries.Of(name, ChartType.Custom, new List<int>());
        s.custom = "waterfall";
        s.data = data;
        return s;
    }

    /// 由层级根构建 Sunburst 系列（径向环；
    /// 扩展渲染器——ECharts 2.2.7 没有 sunburst 类型）。
    static ChartSeries SunburstTree(string name, ChartNode root) {
        ChartSeries s = ChartSeries.Of(name, ChartType.Custom, new List<int>());
        s.custom = "sunburst";
        s.tree.Add(root);
        return s;
    }

    /// 同心进度环，一个系列 = 一个环（扩展渲染器；
    /// option 的 gaugeMax 为满刻度）。
    static ChartSeries RadialBars(string name, int val) {
        ChartSeries s = ChartSeries.Of(name, ChartType.Custom, new List<int>{ val });
        s.custom = "radialBars";
        return s;
    }

    /// 地图系列：从调用方提供的多部件区域构建。渲染器
    /// 不硬编码世界地图，polygon 由调用方决定（确定性
    /// 样例见 gallery）。
    static ChartSeries OfRegions(string name, List<ChartMapRegion> regions) {
        ChartSeries s = ChartSeries.Of(name, ChartType.Map, new List<int>());
        s.regions = regions;
        return s;
    }

    /// Event River 系列：从显式事件构建。
    static ChartSeries OfEvents(string name, List<ChartEvent> events) {
        ChartSeries s = ChartSeries.Of(name, ChartType.EventRiver, new List<int>());
        s.events = events;
        return s;
    }

    /// 给线/柱系列追加一个 markPoint。option.markPoint=true 时
    /// 渲染器也会自动推导 max/min；显式 marks 优先展示。
    ChartSeries MarkPoint(ChartMarkPoint m) { this.marks.Add(m); return this; }

    /// 给线/柱系列追加一条 markLine（threshold/average/min/max）。
    ChartSeries MarkLine(ChartMarkLine m) { this.markLines.Add(m); return this; }

    /// 仪表盘的几何与范围。百分比相对图表主体。
    ChartSeries GaugeRange(int min, int max) { this.gauge.min = min; this.gauge.max = max; return this; }
    /// 以钟面约定设置起止角（0 = 12 点钟、顺时针增），
    /// 内部换算为数学角 360-角度。
    ChartSeries GaugeArc(int startAngle, int endAngle) {
        this.gauge.startAngle = 360 - startAngle;
        this.gauge.endAngle = 360 - endAngle;
        return this;
    }
    /// 设置圆心（百分比）与半径（百分比，相对图表主体）。
    ChartSeries GaugeLayout(int centerXPct, int centerYPct, int radiusPct) {
        this.gauge.center = ChartPosition.Of(ChartScalar.Pct(centerXPct), ChartScalar.Pct(centerYPct));
        this.gauge.radius = ChartScalar.Pct(radiusPct);
        return this;
    }
    /// 设置主刻度数与每主格内的细刻度数（axisTick.splitNumber）。
    ChartSeries GaugeTicks(int splitNumber, int minorTicks) {
        this.gauge.splitNumber = splitNumber; this.gauge.axisTick.splitNumber = minorTicks; return this;
    }
    /// 一次性设置轴线宽、刻度长、分隔线长与指针长（百分比）/宽。
    ChartSeries GaugeSizes(int axisWidth, int tickLength, int splitLength,
                           int pointerLengthPct, int pointerWidth) {
        this.gauge.axisLine.lineStyle.width = axisWidth; this.gauge.axisTick.length = tickLength;
        this.gauge.splitLine.length = splitLength; this.gauge.pointer.length = ChartScalar.Pct(pointerLengthPct);
        this.gauge.pointer.width = pointerWidth; return this;
    }
    /// 逐项开关轴线 / 刻度 / 轴标签 / 标题 / 数值牌。
    ChartSeries GaugeVisible(bool axis, bool ticks, bool labels, bool title, bool detail) {
        this.gauge.axisLine.show = axis; this.gauge.axisTick.show = ticks; this.gauge.axisLabel.show = labels;
        this.gauge.title.show = title; this.gauge.detail.show = detail; return this;
    }
    /// 标题/数值牌改用像素偏移，并把数值牌 formatter 设为
    /// "{value}" + suffix。
    ChartSeries GaugeText(int titleX, int titleY, int detailX, int detailY, string suffix) {
        this.gauge.title.offsetCenter = ChartPosition.Of(ChartScalar.Px(titleX), ChartScalar.Px(titleY));
        this.gauge.detail.offsetCenter = ChartPosition.Of(ChartScalar.Px(detailX), ChartScalar.Px(detailY));
        this.gauge.detail.formatter = "{value}" + suffix; return this;
    }
    /// 以四段停靠点替换轴线色带；stop1..stop4 为百分比（0..100），
    /// 存储时乘 10 换算为 0..1000 千分位。
    ChartSeries GaugeColors(int stop1, int color1, int stop2, int color2,
                            int stop3, int color3, int stop4, int color4) {
        this.gauge.axisLine.colors = new List<GaugeColorStop>();
        this.gauge.axisLine.colors.Add(GaugeColorStop.Of(stop1 * 10, color1));
        this.gauge.axisLine.colors.Add(GaugeColorStop.Of(stop2 * 10, color2));
        this.gauge.axisLine.colors.Add(GaugeColorStop.Of(stop3 * 10, color3));
        this.gauge.axisLine.colors.Add(GaugeColorStop.Of(stop4 * 10, color4));
        return this;
    }

    /// data 项数；纯值对系列（[[x,y],...]，无 data 项）返回
    /// points 数——极值/均值/markLine 等窗口推导据此看到值对。
    int Count() {
        if (this.data.Count > 0) { return this.data.Count; }
        return this.points.Count;
    }

    /// ECharts `layout/barGrid.ts:510` `isInLargeMode`：`pipelineContext.large`
    /// 为真 = 声明了 `large` 且数据量超过 `largeThreshold`（缺省 400）。
    /// 只影响 barMinWidth 的缺省（0.5 而非 1）。
    bool InLargeMode() {
        if (!this.large) { return false; }
        int thr = this.largeThreshold;
        if (thr < 1) { thr = 400; }
        return this.Count() > thr;
    }

    /// 第 i 项的 double 值；i 越界返回 0.0，整型项返回其 val。
    /// 值对系列取第 i 对的 y。
    double Number(int i) {
        if (i < 0) { return 0.0; }
        if (this.data.Count > 0) {
            if (i >= this.data.Count) { return 0.0; }
            if (this.data[i].numberSet) { return this.data[i].number; }
            return (double)this.data[i].val;
        }
        if (i < this.points.Count) { return (double)this.points[i].y; }
        return 0.0;
    }

    /// 第 i 项的值取整为 int（四舍五入、半数远离零；越界同 Number
    /// 返回 0）。不截断：小数数据（line6 流量基流 0.86..1.5）截断后
    /// 全体归 0，画出的基线与悬停数值（number 保留小数）对不上。
    int Value(int i) {
        double v = this.Number(i);
        if (v < 0) { return (int)(v - 0.5); }
        return (int)(v + 0.5);
    }

    /// 第 i 项是否小数（numberSet 且值非整）。折线族渲染/量程/
    /// 提示对这类数据按 1/1000 定点承载（line6 流量 0.46..365、
    /// 降雨量 -0.005..-0.955），轴走 leftMinF/rightMinF 定点域。
    bool SeriesFrac(int i) {
        if (this.data.Count > 0 && i >= 0 && i < this.data.Count) {
            if (this.data[i].numberSet) {
                return this.data[i].number != (double)this.data[i].val;
            }
        }
        return false;
    }

    /// 复制系列外壳和所有可变数据列表。Merge 只会替换这些列表
    /// 或显式样式字段，因此不会反向修改输入 option。
    /// shareData（阶段 B 克隆税豁免）：data/points/candles 等
    /// 逐项大集合只读共享引用，不逐项深拷。仅当本帧渲染路径
    /// 对这些集合零写入时才允许（见 ResolvedChart.DrawOption：
    /// pie/rose/funnel 会经 ApplyDataLegend 写 data[].hidden/
    /// selected，必须排除）；外壳字段（hidden/type/areaStyle/
    /// itemStyle 等）仍走新对象，工具箱魔法切换等就地写不漏源。
    static ChartSeries Clone(ChartSeries src) {
        return ChartSeries.Clone(src, false);
    }

    static ChartSeries Clone(ChartSeries src, bool shareData) {
        if (src == null) { return null; }
        ChartSeries s = ChartSeries.Of(src.name, src.type, new List<int>());
        s.axisIndex = src.axisIndex; s.stack = src.stack; s.stackName = src.stackName;
        s.stackStrategy = src.stackStrategy;
        s.color = src.color; s.hidden = src.hidden; s.smooth = src.smooth;
        s.xIndex = src.xIndex; s.visBlocked = src.visBlocked;
        s.areaStyle = src.areaStyle; s.step = src.step; s.sort = src.sort;
        s.endLabelShow = src.endLabelShow; s.endLabelDistance = src.endLabelDistance;
        s.endLabelFormatter = src.endLabelFormatter;
        s.roseType = src.roseType; s.startAngle = src.startAngle;
        s.clockWise = src.clockWise;
        s.polarIndex = src.polarIndex;
        s.center = ChartPosition.Clone(src.center);
        s.radius = ChartScalar.Clone(src.radius);
        s.radiusInner = ChartScalar.Clone(src.radiusInner);
        s.selectedOffset = src.selectedOffset; s.barWidth = src.barWidth;
        s.barWidthPct = src.barWidthPct;
        s.silent = src.silent;
        s.barHeight = src.barHeight;
        s.barMinHeight = src.barMinHeight;
        s.barMinAngle = src.barMinAngle;
        s.roundCap = src.roundCap;
        s.barGapPct = src.barGapPct; s.symbol = src.symbol;
        s.barWidthRaw = src.barWidthRaw; s.barGapRaw = src.barGapRaw;
        s.barCategoryGapRaw = src.barCategoryGapRaw;
        s.barMinWidthRaw = src.barMinWidthRaw;
        s.barMaxWidthRaw = src.barMaxWidthRaw;
        s.large = src.large; s.largeThreshold = src.largeThreshold;
        s.symbolSize = src.symbolSize; s.symbolSizeFn = src.symbolSizeFn;
        s.pointG = src.pointG;
        s.showSymbol = src.showSymbol; s.showAllSymbol = src.showAllSymbol;
        s.showSymbol = src.showSymbol; s.showBackground = src.showBackground;
        s.backgroundColor = src.backgroundColor; s.innerPct = src.innerPct;
        s.hbar = src.hbar; s.treeOrient = src.treeOrient;
        s.custom = src.custom;
        s.emphasisFocus = src.emphasisFocus;
        s.treeLine = ChartLineStyle.Clone(src.treeLine);
        s.piePerPoint = src.piePerPoint;
        s.selectedMode = src.selectedMode; s.forceScaling = src.forceScaling;
        s.mapName = src.mapName; s.geoIndex = src.geoIndex;
        s.isGeoBase = src.isGeoBase;
        s.picSymbol = src.picSymbol; s.picRepeat = src.picRepeat;
        s.picClip = src.picClip; s.picPos = src.picPos;
        s.picBound = src.picBound; s.picW = src.picW; s.picH = src.picH;
        s.picWPct = src.picWPct; s.picHPct = src.picHPct;
        // 标量外壳字段必须在早退之前全部抄完——它们按值传递，与数据
        // 集合共享无关；漏抄会让 shareData 路径物化出的系列丢掉
        // force/chord/funnel/wordCloud 参数（conformance drb6 抓出）。
        s.forceGravity = src.forceGravity; s.forceMinRadius = src.forceMinRadius;
        s.forceMaxRadius = src.forceMaxRadius; s.forceNodeColor = src.forceNodeColor;
        s.forceLinkColor = src.forceLinkColor;
        s.forceLinkSymbol = src.forceLinkSymbol;
        s.chordRibbonType = src.chordRibbonType;
        s.chordSort = src.chordSort; s.chordSortSub = src.chordSortSub;
        s.chordGapDeg = src.chordGapDeg; s.chordRingWidthPct = src.chordRingWidthPct;
        s.funnelAlign = src.funnelAlign; s.funnelGap = src.funnelGap;
        s.funnelPercent = src.funnelPercent; s.wcMinFontSize = src.wcMinFontSize;
        s.maxSizePct = src.maxSizePct; s.funnelLabelOut = src.funnelLabelOut;
        s.forceCurveness = src.forceCurveness;
        s.wcMaxFontSize = src.wcMaxFontSize; s.wcRotate = src.wcRotate;
        s.wcRotateList = src.wcRotateList;
        s.labelShow = src.labelShow;
        s.labelShowT = src.labelShowT;
        s.labelLineShow = src.labelLineShow;
        s.labelLineLen = src.labelLineLen;
        s.labelLineLen2 = src.labelLineLen2;
        s.labelDist = src.labelDist;
        s.labelEdgeDist = src.labelEdgeDist;
        s.labelAlignTo = src.labelAlignTo;
        s.pieLabels = src.pieLabels;
        s.labelFmt = src.labelFmt; s.labelPos = src.labelPos;
        s.labelRotate = src.labelRotate;
        s.graphLayout = src.graphLayout;
        s.coordSys = src.coordSys;
        s.calIndex = src.calIndex;
        s.calCenter = src.calCenter;
        s.typeName = src.typeName;
        if (shareData) {
            // 阶段 B：渲染帧对数据集合只读，直接共享引用（scatter-large
            // /scatter-weibo 的逐项克隆税由此归零）。写方（图例态
            // ApplyDataLegend、交互回写）必须走「s.data = 新列表或经
            // Clone(shareData:false)」的路径，绝不能经共享引用就地写。
            s.data = src.data;
            s.candles = src.candles;
            s.bubbles = src.bubbles;
            s.boxes = src.boxes;
            s.errors = src.errors;
            s.points = src.points;
            s.tree = src.tree;
            s.links = src.links;
            s.regions = src.regions;
            s.events = src.events;
            s.marks = src.marks;
            s.markLines = src.markLines;
            s.parRows = src.parRows;
            s.matrix = src.matrix;
            s.nodeX = src.nodeX;
            s.nodeY = src.nodeY;
            s.graphCats = src.graphCats;
            s.geoLines = src.geoLines;
            s.riverTimes = src.riverTimes;
            s.riverVals = src.riverVals;
            s.riverCat = src.riverCat;
            s.riverNames = src.riverNames;
            s.itemStyle = src.itemStyle;
            s.label = src.label;
            s.markLabelFmt = src.markLabelFmt;
            s.markLabelSt = src.markLabelSt;
            s.markLabelPos = src.markLabelPos;
            s.markLabelDist = src.markLabelDist;
            s.markSymbolSize = src.markSymbolSize;
            s.llDeclared = src.llDeclared;
            s.llDx = src.llDx;
            s.llDy = src.llDy;
            s.llX = src.llX;
            s.llY = src.llY;
            s.llAlign = src.llAlign;
            s.llHideOverlap = src.llHideOverlap;
            s.llMove = src.llMove;
            s.gauge = src.gauge;
            return s;
        }
        s.parRows = new List<List<int>>();
        for (int pr = 0; pr < src.parRows.Count; pr = pr + 1) {
            List<int> row = src.parRows[pr];
            List<int> cp = new List<int>();
            for (int pc = 0; pc < row.Count; pc = pc + 1) { cp.Add(row[pc]); }
            s.parRows.Add(cp);
        }
        s.riverTimes = new List<string>();
        for (int rt = 0; rt < src.riverTimes.Count; rt = rt + 1) { s.riverTimes.Add(src.riverTimes[rt]); }
        s.riverVals = new List<int>();
        for (int rv = 0; rv < src.riverVals.Count; rv = rv + 1) { s.riverVals.Add(src.riverVals[rv]); }
        s.riverCat = new List<int>();
        for (int rc = 0; rc < src.riverCat.Count; rc = rc + 1) { s.riverCat.Add(src.riverCat[rc]); }
        s.riverNames = new List<string>();
        for (int rn = 0; rn < src.riverNames.Count; rn = rn + 1) { s.riverNames.Add(src.riverNames[rn]); }
        s.matrix = new List<List<int>>();
        for (int mi = 0; mi < src.matrix.Count; mi = mi + 1) {
            List<int> row = new List<int>();
            for (int mj = 0; mj < src.matrix[mi].Count; mj = mj + 1) {
                row.Add(src.matrix[mi][mj]);
            }
            s.matrix.Add(row);
        }
        s.itemStyle = ChartItemStyle.Clone(src.itemStyle);
        s.label = ChartTextStyle.Clone(src.label);
        s.gauge = GaugeOption.Clone(src.gauge);
        s.data = new List<ChartData>();
        for (int i = 0; i < src.data.Count; i = i + 1) { s.data.Add(ChartData.Clone(src.data[i])); }
        s.candles = new List<Candle>();
        for (int i = 0; i < src.candles.Count; i = i + 1) { s.candles.Add(Candle.Clone(src.candles[i])); }
        s.bubbles = new List<Bubble>();
        for (int i = 0; i < src.bubbles.Count; i = i + 1) { s.bubbles.Add(Bubble.Clone(src.bubbles[i])); }
        s.boxes = new List<BoxItem>();
        for (int i = 0; i < src.boxes.Count; i = i + 1) { s.boxes.Add(BoxItem.Clone(src.boxes[i])); }
        s.errors = new List<ErrorItem>();
        for (int i = 0; i < src.errors.Count; i = i + 1) { s.errors.Add(ErrorItem.Clone(src.errors[i])); }
        s.points = new List<ChartPoint>();
        for (int i = 0; i < src.points.Count; i = i + 1) { s.points.Add(ChartPoint.Clone(src.points[i])); }
        s.tree = new List<ChartNode>();
        for (int i = 0; i < src.tree.Count; i = i + 1) { s.tree.Add(ChartNode.Clone(src.tree[i])); }
        s.links = new List<ChartLink>();
        for (int i = 0; i < src.links.Count; i = i + 1) { s.links.Add(ChartLink.Clone(src.links[i])); }
        s.regions = new List<ChartMapRegion>();
        for (int i = 0; i < src.regions.Count; i = i + 1) { s.regions.Add(ChartMapRegion.Clone(src.regions[i])); }
        s.events = new List<ChartEvent>();
        for (int i = 0; i < src.events.Count; i = i + 1) { s.events.Add(ChartEvent.Clone(src.events[i])); }
        s.marks = new List<ChartMarkPoint>();
        for (int i = 0; i < src.marks.Count; i = i + 1) { s.marks.Add(ChartMarkPoint.Clone(src.marks[i])); }
        s.markLines = new List<ChartMarkLine>();
        for (int i = 0; i < src.markLines.Count; i = i + 1) { s.markLines.Add(ChartMarkLine.Clone(src.markLines[i])); }
        s.markLabelFmt = src.markLabelFmt;
        s.markLabelSt = ChartTextStyle.Clone(src.markLabelSt);
        s.markLabelPos = src.markLabelPos;
        s.markLabelDist = src.markLabelDist;
        s.markSymbolSize = src.markSymbolSize;
        s.llDeclared = src.llDeclared;
        s.llDx = src.llDx;
        s.llDy = src.llDy;
        s.llX = src.llX;
        s.llY = src.llY;
        s.llAlign = src.llAlign;
        s.llHideOverlap = src.llHideOverlap;
        s.llMove = src.llMove;
        s.nodeX = new List<int>();
        for (int i = 0; i < src.nodeX.Count; i = i + 1) { s.nodeX.Add(src.nodeX[i]); }
        s.nodeY = new List<int>();
        for (int i = 0; i < src.nodeY.Count; i = i + 1) { s.nodeY.Add(src.nodeY[i]); }
        s.graphCats = new List<string>();
        for (int i = 0; i < src.graphCats.Count; i = i + 1) { s.graphCats.Add(src.graphCats[i]); }
        s.geoLines = new List<List<ChartPoint>>();
        for (int i = 0; i < src.geoLines.Count; i = i + 1) {
            List<ChartPoint> line = new List<ChartPoint>();
            for (int k = 0; k < src.geoLines[i].Count; k = k + 1) {
                line.Add(ChartPoint.Clone(src.geoLines[i][k]));
            }
            s.geoLines.Add(line);
        }
        return s;
    }
}

/// 一个坐标轴（ECharts xAxis/yAxis 条目）。分类轴携带其
/// 标签；数值轴携带可选固定范围（ChartOption.Auto()
/// 从数据推导）和刻度数。
class ChartAxis {
    ChartAxisType type;
    string title;     // 轴名称（ECharts name），"" = 无
    // 显式下/上界。int 是旧接口（其它渲染视图/hash 仍读它）；
    // D 后缀是 double 真值：line-easing 写 min:-0.4 / max:1.4，
    // 只留 int 会把 -0.4 截成 0，轴整体错位、刻度全变整数。
    // Auto() / AutoD() = 从数据推导。写的时候两个一起维护（见 SetRange）。
    int min;
    int max;
    double minD;
    double maxD;
    bool minDataB;       // min:'dataMin' 字面量（本 slice 按未声明处理，接线待续）
    bool maxDataB;       // max:'dataMax' 字面量
    // ECharts ValueAxisBaseOption.scale：true = 量程只按数据（不并入 0）。
    // 出处 `coord/axisModelCommonMixin.ts:33 needIncludeZero() = !option.scale`，
    // 且只对 interval scale（数值轴）适用——对数/时间/类目轴不适用
    // （`coord/scaleRawExtentInfo.ts:301-303`）。
    bool scale;
    bool reversed;    // 翻转轴（ECharts inverse）
    int ticks;        // 数值轴刻度数（默认 5）
    bool showGrid;    // 为此轴绘制网格线
    bool splitArea;   // ECharts splitArea.show：数值轴相邻刻度交替底纹
                      //   （2.2 数值轴默认开，5.x 默认关——引擎随 5.x）
    int labelRotate;   // ECharts axisLabel.rotate：度（钳 -90..90），0 = 水平
    int labelInterval; // ECharts axisLabel.interval：-1 = 自动防重叠，>=0 = 每 (n+1) 个画一个
    int labelMargin;   // ECharts axisLabel.margin：标签与轴线的像素距离（bump-chart 30）
    string nameLocation; // ECharts nameLocation："start"|"middle"|"end"
                         //   官方缺省 'end'（coord/axisDefault.ts:34）
    int nameGap;         // ECharts nameGap：轴名与轴线的像素间距，
                         //   官方缺省 15（coord/axisDefault.ts:47）；
                         //   -1 = 未声明（走缺省）
    string labelFormatter; // ECharts axisLabel.formatter，"{value} °C" 模板
    ChartTextStyle labelSt; // axisLabel 富文本/盒样式表；null = 未声明 rich。
                            //   bar-race-country 旗标、bar-rich-text 天气图标、
                            //   intraday-breaks-1 周末置灰。声明了 rich 才建
                            //   （ParseTextStyle 单点解析），其余轴渲染不变
    bool labelNegate;  // ECharts axisLabel.formatter 为 function(v){return -v}
                       // 的等价开关：刻度/工具提示按 -值 显示（雨量图负值轴）
    bool boundaryGap;  // ECharts boundaryGap（类目轴默认 true：点落在格中）
    int axisLineColor; // ECharts axisLine.lineStyle.color；0 = 主题色
    int axisLineShow;  // ECharts axisLine.show 三态：-1 = 未声明（走 'auto'）、
                       //   0 = 显式 false、1 = 显式 true。'auto' 的判定：
                       //   类目轴恒画（axisDefault.ts:162 的 show:true，
                       //   categoryAxis 不覆盖）；value/log/time 在
                       //   cartesianAxisHelper.ts:169-181 里只有当**同网格**
                       //   对侧轴是 value/log 时才画。
    int onZero;        // ECharts axisLine.onZero 三态：-1 = 未声明（按 'auto'）、
                       //   0 = 显式 false、1 = 显式 true。'auto' 与 true 在
                       //   本引擎里等价（discourageOnAxisZero 只在
                       //   containShape 真的扩过量程时才置位，见 Grid.ts:677）。
    bool show;         // ECharts axis.show：false = 整条轴（线/刻度/标签）不画
    string position;   // ECharts xAxis/yAxis.position，轴级键（不是
                       //   axisLabel.position）：x = "bottom"/"top"，
                       //   y = "left"/"right"；"" = 未声明（官方缺省
                       //   bottom/left，见 Grid.ts:464-479）。
    string axisId;     // ECharts axis.id：series 经 xAxisId/yAxisId 按名引用
    // ECharts axis.minInterval / axis.maxInterval（axisCommonTypes.ts:174/178）：
    // nice 步长的钳制上下界，只对 interval/time 刻度生效
    // （axisNiceTicks.ts:263-264 `isIntervalOrTime ? model.get(...) : null`）。
    // AutoD() = 未声明（源码里的 null 分支）。语义出处
    // axisNiceTicks.ts:130-138：interval = nice(span/splitNumber)，
    // 再 `if (minInterval != null && interval < minInterval) interval = minInterval;`
    // `if (maxInterval != null && interval > maxInterval) interval = maxInterval;`。
    double minInterval;
    double maxInterval;
    // ECharts axis.alignTicks（axisCommonTypes.ts:186）：与**同网格**
    // 的对齐轴共用刻度（Grid.ts:738-756 挑 alignTo）。本引擎的
    // BuildAxesR 一次只解左/右两条轴，对齐只在这两条之间做。
    bool alignTicks;
    // ECharts minorTick.show（axisDefault.ts:192 缺省 false）+
    // minorSplitLine.show（:202 缺省 false）：细分刻度线与细分网格线。
    // 类目轴不支持（Axis.ts:204 isOrdinalScale 直接返回空）。
    bool minorTickShow;
    int minorTickSplitNumber;   // 缺省 5（axisDefault.ts:194）
    bool minorSplitLineShow;
    List<string> categories;

    /// 分类轴工厂：携带标签列表，无网格线，标签自动防重叠。
    static ChartAxis Category(List<string> cats) {
        ChartAxis a = new ChartAxis();
        a.type = ChartAxisType.Category;
        a.title = "";
        a.SetRange(ChartOption.AutoD(), ChartOption.AutoD());
        a.scale = false;
        a.reversed = false;
        a.ticks = 5;
        // ECharts 2 类目轴 splitLine 默认开（竖向 #eee 网格线）。
        a.showGrid = true;
        a.splitArea = false;
        a.labelRotate = 0;
        a.labelInterval = 0 - 1;
        a.labelMargin = 0;
        a.nameLocation = "end";
        a.nameGap = 0 - 1;
        a.labelFormatter = "";
        a.labelNegate = false;
        a.axisLineColor = 0;
        a.minInterval = ChartOption.AutoD();
        a.maxInterval = ChartOption.AutoD();
        a.alignTicks = false;
        a.minorTickShow = false;
        a.minorTickSplitNumber = 5;
        a.minorSplitLineShow = false;
        // 类目轴：axisLine.show 官方缺省 true、axisLine.onZero 'auto'
        // （axisDefault.ts:162 / :66）。
        a.axisLineShow = 1;
        a.onZero = 0 - 1;
        a.show = true;
        a.boundaryGap = true;
        a.axisId = "";
        a.categories = cats;
        return a;
    }

    /// 分类轴工厂（带轴名称）。
    static ChartAxis CategoryTitled(List<string> cats, string title) {
        ChartAxis a = ChartAxis.Category(cats);
        a.title = title;
        return a;
    }

    /// 数值轴工厂：范围自动推导、显示网格线。ticks 0 = 自动
    /// （ECharts splitNumber 缺省，刻度数由量程算法给出；消费方
    /// 一律 <1 回落 5），显式 splitNumber 才赋 ticks。
    static ChartAxis Value() {
        ChartAxis a = new ChartAxis();
        a.type = ChartAxisType.Value;
        a.title = "";
        a.SetRange(ChartOption.AutoD(), ChartOption.AutoD());
        a.scale = false;
        a.reversed = false;
        a.ticks = 0;
        a.showGrid = true;
        a.splitArea = false;
        a.labelRotate = 0;
        a.labelInterval = 0 - 1;
        a.labelMargin = 0;
        a.nameLocation = "end";
        a.nameGap = 0 - 1;
        a.labelFormatter = "";
        a.labelNegate = false;
        a.axisLineColor = 0;
        a.minInterval = ChartOption.AutoD();
        a.maxInterval = ChartOption.AutoD();
        a.alignTicks = false;
        a.minorTickShow = false;
        a.minorTickSplitNumber = 5;
        a.minorSplitLineShow = false;
        // 数值轴：axisLine.show 官方缺省 'auto'（axisDefault.ts:176，
        // valueAxis 覆盖），故记 -1；onZero 仍是 'auto'。
        a.axisLineShow = 0 - 1;
        a.onZero = 0 - 1;
        a.show = true;
        a.boundaryGap = false;
        a.axisId = "";
        a.categories = new List<string>();
        return a;
    }

    /// 数值轴工厂（固定范围 [min,max]）。
    static ChartAxis ValueRange(int min, int max) {
        ChartAxis a = ChartAxis.Value();
        a.min = min;
        a.max = max;
        return a;
    }

    /// 数值轴工厂（带轴名称）。
    static ChartAxis ValueTitled(string title) {
        ChartAxis a = ChartAxis.Value();
        a.title = title;
        return a;
    }

    /// 时间轴工厂（type = Time，其余同数值轴）。
    static ChartAxis Time() {
        ChartAxis a = ChartAxis.Value();
        a.type = ChartAxisType.Time;
        return a;
    }

    /// 对数轴工厂（type = Log，其余同数值轴）。
    static ChartAxis Log() {
        ChartAxis a = ChartAxis.Value();
        a.type = ChartAxisType.Log;
        return a;
    }

    /// 对数轴工厂（带轴名称）。
    static ChartAxis LogTitled(string title) {
        ChartAxis a = ChartAxis.Log();
        a.title = title;
        return a;
    }

    /// 同时写 int 与 double 两套范围（JSON 解析/工厂/clone 都必须走这里，
    /// 否则两套值会漂移：hash 读 int、渲染读 double）。
    void SetRange(double lo, double hi) {
        this.minD = lo;
        this.maxD = hi;
        this.min = ChartOption.IsAutoD(lo) ? ChartOption.Auto() : (int)lo;
        this.max = ChartOption.IsAutoD(hi) ? ChartOption.Auto() : (int)hi;
    }

    /// 深复制（含分类标签列表）；src 为 null 时返回 null。
    static ChartAxis Clone(ChartAxis src) {
        if (src == null) { return null; }
        ChartAxis a = new ChartAxis();
        a.type = src.type; a.title = src.title;
        a.min = src.min; a.max = src.max;
        a.minD = src.minD; a.maxD = src.maxD;
        a.minDataB = src.minDataB; a.maxDataB = src.maxDataB;
        a.scale = src.scale;
        a.minInterval = src.minInterval; a.maxInterval = src.maxInterval;
        a.alignTicks = src.alignTicks;
        a.minorTickShow = src.minorTickShow;
        a.minorTickSplitNumber = src.minorTickSplitNumber;
        a.minorSplitLineShow = src.minorSplitLineShow;
        a.reversed = src.reversed; a.ticks = src.ticks; a.showGrid = src.showGrid;
        a.splitArea = src.splitArea;
        a.labelRotate = src.labelRotate; a.labelInterval = src.labelInterval;
        a.labelMargin = src.labelMargin;
        a.nameLocation = src.nameLocation; a.nameGap = src.nameGap;
        a.labelFormatter = src.labelFormatter;
        a.labelSt = ChartTextStyle.Clone(src.labelSt);
        a.labelNegate = src.labelNegate;
        a.axisLineColor = src.axisLineColor;
        a.axisLineShow = src.axisLineShow;
        a.onZero = src.onZero;
        a.show = src.show;
        a.position = src.position;
        a.axisId = src.axisId;
        a.boundaryGap = src.boundaryGap; a.categories = new List<string>();
        if (src.categories != null) {
            for (int i = 0; i < src.categories.Count; i = i + 1) {
                a.categories.Add(src.categories[i]);
            }
        }
        return a;
    }
}

/// 完整图表配置（ECharts option）：标题、坐标轴、
/// 系列和所有展示选项集中一处。用 Create() /
/// Of(series) / FromJson() 构建，直接调整字段，然后交给
/// ChartView.Of(option).Render(app, x, y, w, h)。三级控制对应
/// ECharts：option.*（全局）< series.*（逐系列）< data[i].*（逐项）。
class ChartOption {
    string title;
    string titleSub;   // ECharts title.subtext（标题下的小字副标题）
    string titleAlign; // ECharts title.left："center"（官方默认）| "left" | "right"
    int titleColor;    // ECharts title.textStyle.color；0 = 官方默认 #3c3c41
    int titleSubColor; // ECharts title.subtextStyle.color；0 = 官方默认 #86878c
    List<ChartAxis> xAxes;
    List<ChartJsonDataset> datasets; // ECharts dataset：id/source/transform
    List<ChartVisualMap> visualMaps; // ECharts visualMap：分段/连续视映射
    List<ChartTitleSpec> titles;     // title 数组（多标题）
    List<ChartGridSpec> grids;       // grid 数组（多 grid 布局）
    List<ChartMarkArea> markAreas;   // markArea 区间带（x 类目竖带 / y 横带）
    List<ChartAxis> yAxes;
    List<ChartSeries> series;
    List<ChartGeo> geos;   // ECharts geo 组件（底图地图，可多个）
    List<ChartCalendarSpec> calendars; // ECharts calendar[]（日历坐标系）
    List<ChartParAxis> parAxes; // ECharts parallelAxis[]（平行坐标维）
    List<PolarAxisSpec> angleAxes;  // ECharts angleAxis（对象或数组，polarIndex 绑定）
    List<PolarAxisSpec> radiusAxes; // ECharts radiusAxis
    // parallel 组件：layout 命名轴的"排布方向"——'vertical'（轴自上
    // 而下堆叠，每根轴横置，nutrients 官方图）| 'horizontal'（轴从
    // 左到右排开，每根轴竖置）。缺省 horizontal（与 ECharts 2.x
    // 时代的既有渲染一致）。axisIndex 映射为数据列号 parAxes[i].dim。
    string parLayout;

    ChartType defaultType; // Add(name, values) / AddLabel 使用的类型

    bool showLegend;  // 面板标题中的系列图例
    bool showTooltip; // 悬停十字线 + 数值工具提示（直角坐标系图表）
    string tooltipTrigger; // ECharts tooltip.trigger："item"（默认）| "axis"
    string tooltipTriggerOn; // tooltip.triggerOn："mousemove|click"（默认）|
                             //   "click" | "none"——none = 不随鼠标出框
    bool toolboxShow; // ECharts toolbox：数据视图 / 类型切换 / 还原 / 保存 / 缩放
    // toolbox.feature 声明掩码：JSON 路径只渲染声明的按钮；对象 API
    // 保持 Create 的全按钮（2.x 全套兼容）。
    bool toolboxDataView;
    bool toolboxMagicLine;
    bool toolboxMagicBar;
    bool toolboxRestore;
    bool toolboxSave;
    bool toolboxZoom;
    bool roam;        // 地图漫游（滚轮缩放 + 拖拽平移）
    string roamWheelMode; // "zoom" 消费滚轮；"pass" 交给外层滚动容器
    bool mapSelect;   // 地图点击选中区域
    bool showGrid;    // 数值网格线
    bool showValues;  // 点/柱顶上的数值标签
    bool animate;     // 首次渲染时的增长入场动画
    bool smooth;      // 全局平滑（默认 true：ECharts 2.2.x 折线不写 smooth 也渲染曲线）；系列的 smooth 字段覆盖它
    bool pointerCross; // tooltip.axisPointer.type='cross'（line7 双数值轴：十字虚线 + ( x , y ) 轴值读数）
    bool gradient;    // 垂直渐变填充（面积 / 柱状）
    bool rounded;     // 圆角柱帽
    int animMs;       // 入场动画时长（毫秒）
    int donutPct;     // 环形内半径占外半径的百分比
    int gaugeMax;     // Gauge / 径向条形图的满刻度值（默认 100）
    bool pieLabels;   // 在饼/环扇区上绘制百分比标签
    bool pieCenterText; // 环心总数/选中项名标注（ECharts 默认无此行为，
                        //   仅 emphasis 时显示；显式开启才画）
    bool pieRings;    // 多系列嵌套环饼图
    bool overlay;     // 混搭覆盖层 option（DrawOverlaySeries 内部构造）：
                      //   跳过面板底/头，直接在同一面板上叠加绘制
                      //   （ECharts2 同 option 混排 pie/gauge/funnel + 笛卡尔）
    List<int> radarMax; // 雷达每轴满刻度（空 = 从数据推导）
    string radarShape;  // ECharts radar.shape："circle"（默认=现状）| "polygon"
    bool radarSplitArea; // ECharts radar.splitArea.show：环带交替色
    List<RadarPolar> polars; // ECharts2 polar[]：多雷达坐标系；空 = 单 polar
                             //   （用上面的 radarMax/radarShape/dims 全局字段）
    // ---- legend 选项（ECharts legend）----
    string legendOrient;        // "horizontal"（默认）| "vertical"
    string legendX;             // ECharts legend.x："left"|"center"(默认)|"right"
    string legendSelectedMode;  // ""=multiple | "single" | "false"
    string legendFormatter;     // 标签模板，{name} = 系列名（"" = 原名）
    List<string> legendData;    // ECharts legend.data：图例项白名单（按此顺序
                                //   显示；空 = 全部系列）。同名系列共享一项
    // ---- legend 盒模型锚（官方 LegendModel.defaultOption: left 'center'、
    //      bottom tokens.size.m = 15；图例盒由 left/right/top/bottom
    //      四锚求，不再只认旧 legend.x）----
    string legendLeft;          // 原始写法（"left"/"center"/"right"/"12%"/数字）
    string legendRight;
    string legendTop;
    string legendBottom;
    bool legendHasLeft;         // 该锚是否显式声明（区分"未声明"与"声明为0"）
    bool legendHasRight;
    bool legendHasTop;
    bool legendHasBottom;
    int legendLeftPx;           // 已换算的像素锚（仅当 legendHas* 为真）
    int legendRightPx;
    int legendTopPx;
    int legendBottomPx;
    int legendBoxW;             // 解析 "N%" 锚时的百分比基数。0 = 未知（解析
    int legendBoxH;             //   发生在 option 载入时，容器尚未布局）
    // ---- dataRange（ECharts 2.x 值域筛选组件）----
    bool dataRangeShow;
    int dataRangeLo;            // 固定下界（Auto = 数据最小值）
    int dataRangeHi;            // 固定上界（Auto = 数据最大值）
    bool dataRangeCalculable;   // true = 双把手滑条；false = 分段点选
    int dataRangeSplit;         // splitList 为空时的均分段数（<=0 视为 5）
    bool dataRangeHoverLink;    // hoverLink：悬停 dataRange 条 → 主图值域强调
    List<ChartRangeSplit> dataRangeList; // splitList：命名区间
    bool zoom;        // 在直角坐标系图表下方显示 dataZoom 范围滑块
    int markLine;     // 左轴上的水平阈值线（Auto = 无）
    bool markPoint;   // 折线系列的最大值标记
    string markLabel; // 显示在 markLine 处的标签
    int markLo;       // 阴影 markArea 带 [markLo, markHi]（Auto = 无）
    int markHi;
    int gridLeft;     // 绘图区内边距覆盖（像素；-1 = 根据标签自动）
    int gridRight;
    int gridTop;
    int gridBottom;
    // grid.{left,right,top,bottom} 的百分比形态（"3%"；-1 = 非 %）。
    // ECharts grid 还支持 containLabel：边距之外再包住轴标签。
    int gridLeftPct;
    int gridRightPct;
    int gridTopPct;
    int gridBottomPct;
    bool containLabel;
    int zoomStart;    // dataZoom 初始窗口，百分比 0..100
    int zoomEnd;      // dataZoom 初始窗口，百分比 0..100
    string zoomStartValue; // dataZoom startValue：按类目名定位窗口起点
    string zoomEndValue;   // dataZoom endValue：按类目名定位窗口终点
    int windowStart;  // 渲染器实际使用的窗口（类别索引，含端点）
    int windowEnd;    // 由 ResolvedChart 从 app 状态解析；-1 = 未窗口化
    int backgroundColor; // 0 = 跟随主题，不主动填充背景
    int iwid;         // 交互键（由 ChartView.Render 每帧设置）；0 = 无
    int connectGroup; // connect() 组号（0 = 不参与联动；同组非 0 值共享交互态）

    // visualMap 式连续色域（ECharts visualMap.min/max + inRange）：
    // 配置 ≥2 个颜色停止点后，热力图等按单元格**值**在色带上取色，
    // 而不是每序列一色。rampColors 为空 = 关闭（默认逐序列着色）。
    List<int> rampColors;
    int rampLo;       // 显式值域下界；Auto() = 用数据最小值
    int rampHi;       // 显式值域上界；Auto() = 用数据最大值

    /// 哨兵值，表示"此边界从数据推导"。
    static int Auto() { return 0 - 2000000000; }
    /// visualMap 声明的边界按**原始数据单位**取整（o.rampLo/Hi 的消费者
    /// 都按原值比较）。超出 int 可表示范围（>2e9，如 epoch-ms）时返回
    /// Auto() 按未声明处理，避免强转溢出（同 B17 的轴 min/max 护栏）。
    static int RawBound(double d) {
        if (d > 2000000000.0 || d < 0.0 - 2000000000.0) { return ChartOption.Auto(); }
        if (d < 0.0) { return (int)(d - 0.5); }
        return (int)(d + 0.5);
    }
    /// double 版（ChartAxis.min/max 是 double；直接 cast 2000000000 会被
    /// 强转工具链看作溢出风险，统一走这里）。
    static double AutoD() { return 0.0 - 2000000000.0; }
    /// 测试 double 是否为 Auto 哨兵。
    static bool IsAutoD(double v) { return v <= 0.0 - 1999999999.0; }
    /// 两个 double 在 1/1000 容差内相等（判断"是不是整数界"用）。
    static bool SameIsh(double a, double b) {
        double d = a - b;
        if (d < 0.0) { d = 0.0 - d; }
        return d < 0.0005;
    }

    /// 声明本图加入 connect 组（ECharts connect：多图共享交互态）。
    /// 组内所有图传同一个 groupId（任意稳定 int，通常用组长图的
    /// wid）。返回 this 便于链式装配。组内图共享：dataZoom 窗口、
    /// 图例开关、十字线悬停类别。
    ChartOption ConnectGroup(int groupId) {
        this.connectGroup = groupId;
        return this;
    }

    /// 深复制 option 的可变容器，供 timeline 合并和快照使用。
    /// 返回值与输入共享的只有不可变标量字符串，不共享列表/样式外壳。
    static ChartOption Clone(ChartOption src) {
        if (src == null) { return null; }
        ChartOption o = ChartOption.Create();
        o.title = src.title; o.defaultType = src.defaultType;
        o.titleSub = src.titleSub; o.titleAlign = src.titleAlign;
        o.titleColor = src.titleColor; o.titleSubColor = src.titleSubColor;
        o.showLegend = src.showLegend; o.showTooltip = src.showTooltip;
        o.tooltipTrigger = src.tooltipTrigger;
        o.tooltipTriggerOn = src.tooltipTriggerOn;
        o.toolboxShow = src.toolboxShow; o.roam = src.roam; o.mapSelect = src.mapSelect;
        o.toolboxDataView = src.toolboxDataView; o.toolboxMagicLine = src.toolboxMagicLine;
        o.toolboxMagicBar = src.toolboxMagicBar; o.toolboxRestore = src.toolboxRestore;
        o.toolboxSave = src.toolboxSave; o.toolboxZoom = src.toolboxZoom;
        o.roamWheelMode = src.roamWheelMode;
        o.showGrid = src.showGrid; o.showValues = src.showValues; o.animate = src.animate;
        o.smooth = src.smooth; o.gradient = src.gradient; o.rounded = src.rounded;
        o.animMs = src.animMs; o.donutPct = src.donutPct; o.gaugeMax = src.gaugeMax;
        o.pieLabels = src.pieLabels; o.pieRings = src.pieRings;
        o.pieCenterText = src.pieCenterText;
        o.overlay = src.overlay;
        o.radarShape = src.radarShape; o.radarSplitArea = src.radarSplitArea;
        o.legendOrient = src.legendOrient; o.legendSelectedMode = src.legendSelectedMode;
        o.legendX = src.legendX;
        o.legendLeft = src.legendLeft; o.legendRight = src.legendRight;
        o.legendTop = src.legendTop; o.legendBottom = src.legendBottom;
        o.legendHasLeft = src.legendHasLeft; o.legendHasRight = src.legendHasRight;
        o.legendHasTop = src.legendHasTop; o.legendHasBottom = src.legendHasBottom;
        o.legendLeftPx = src.legendLeftPx; o.legendRightPx = src.legendRightPx;
        o.legendTopPx = src.legendTopPx; o.legendBottomPx = src.legendBottomPx;
        o.legendBoxW = src.legendBoxW; o.legendBoxH = src.legendBoxH;
        o.legendData = src.legendData;
        o.legendFormatter = src.legendFormatter; o.dataRangeShow = src.dataRangeShow;
        o.dataRangeLo = src.dataRangeLo; o.dataRangeHi = src.dataRangeHi;
        o.dataRangeCalculable = src.dataRangeCalculable; o.dataRangeSplit = src.dataRangeSplit;
        o.dataRangeHoverLink = src.dataRangeHoverLink; o.zoom = src.zoom;
        o.markLine = src.markLine; o.markPoint = src.markPoint; o.markLabel = src.markLabel;
        o.markLo = src.markLo; o.markHi = src.markHi; o.gridLeft = src.gridLeft;
        o.gridRight = src.gridRight; o.gridTop = src.gridTop; o.gridBottom = src.gridBottom;
        o.gridLeftPct = src.gridLeftPct; o.gridRightPct = src.gridRightPct;
        o.gridTopPct = src.gridTopPct; o.gridBottomPct = src.gridBottomPct;
        o.containLabel = src.containLabel;
        o.zoomStart = src.zoomStart; o.zoomEnd = src.zoomEnd;
        o.zoomStartValue = src.zoomStartValue; o.zoomEndValue = src.zoomEndValue;
        o.windowStart = src.windowStart; o.windowEnd = src.windowEnd;
        o.backgroundColor = src.backgroundColor; o.iwid = src.iwid;
        o.parLayout = src.parLayout;
        o.connectGroup = src.connectGroup; o.rampLo = src.rampLo; o.rampHi = src.rampHi;
        o.radarMax = new List<int>();
        for (int i = 0; i < src.radarMax.Count; i = i + 1) { o.radarMax.Add(src.radarMax[i]); }
        o.polars = new List<RadarPolar>();
        for (int i = 0; i < src.polars.Count; i = i + 1) {
            o.polars.Add(RadarPolar.Clone(src.polars[i]));
        }
        o.rampColors = new List<int>();
        for (int i = 0; i < src.rampColors.Count; i = i + 1) { o.rampColors.Add(src.rampColors[i]); }
        o.xAxes = new List<ChartAxis>();
        for (int i = 0; i < src.xAxes.Count; i = i + 1) { o.xAxes.Add(ChartAxis.Clone(src.xAxes[i])); }
        o.datasets = new List<ChartJsonDataset>();
        for (int di2 = 0; di2 < src.datasets.Count; di2 = di2 + 1) { o.datasets.Add(src.datasets[di2]); }
        o.visualMaps = new List<ChartVisualMap>();
        for (int vi2 = 0; vi2 < src.visualMaps.Count; vi2 = vi2 + 1) {
            o.visualMaps.Add(ChartVisualMap.Clone(src.visualMaps[vi2]));
        }
        o.titles = new List<ChartTitleSpec>();
        for (int ti2 = 0; ti2 < src.titles.Count; ti2 = ti2 + 1) { o.titles.Add(src.titles[ti2]); }
        o.grids = new List<ChartGridSpec>();
        for (int gi2 = 0; gi2 < src.grids.Count; gi2 = gi2 + 1) { o.grids.Add(src.grids[gi2]); }
        o.markAreas = new List<ChartMarkArea>();
        for (int mai = 0; mai < src.markAreas.Count; mai = mai + 1) { o.markAreas.Add(src.markAreas[mai]); }
        o.yAxes = new List<ChartAxis>();
        for (int i = 0; i < src.yAxes.Count; i = i + 1) { o.yAxes.Add(ChartAxis.Clone(src.yAxes[i])); }
        o.series = new List<ChartSeries>();
        for (int i = 0; i < src.series.Count; i = i + 1) { o.series.Add(ChartSeries.Clone(src.series[i])); }
        o.geos = new List<ChartGeo>();
        for (int gci = 0; gci < src.geos.Count; gci = gci + 1) {
            o.geos.Add(ChartGeo.Clone(src.geos[gci]));
        }
        o.calendars = new List<ChartCalendarSpec>();
        for (int cai = 0; cai < src.calendars.Count; cai = cai + 1) {
            o.calendars.Add(src.calendars[cai]);
        }
        o.parAxes = new List<ChartParAxis>();
        for (int pai = 0; pai < src.parAxes.Count; pai = pai + 1) {
            o.parAxes.Add(ChartParAxis.Clone(src.parAxes[pai]));
        }
        o.angleAxes = new List<PolarAxisSpec>();
        for (int pai2 = 0; pai2 < src.angleAxes.Count; pai2 = pai2 + 1) {
            o.angleAxes.Add(PolarAxisSpec.Clone(src.angleAxes[pai2]));
        }
        o.radiusAxes = new List<PolarAxisSpec>();
        for (int pai3 = 0; pai3 < src.radiusAxes.Count; pai3 = pai3 + 1) {
            o.radiusAxes.Add(PolarAxisSpec.Clone(src.radiusAxes[pai3]));
        }
        o.dataRangeList = new List<ChartRangeSplit>();
        for (int i = 0; i < src.dataRangeList.Count; i = i + 1) {
            o.dataRangeList.Add(ChartRangeSplit.Clone(src.dataRangeList[i]));
        }
        return o;
    }

    /// 构造全默认 option：无标题无系列，图例与提示开启，
    /// 入场动画 650ms，其余字段见字段注释。
    static ChartOption Create() {
        ChartOption o = new ChartOption();
        o.title = "";
        o.xAxes = new List<ChartAxis>();
        o.datasets = new List<ChartJsonDataset>();
        o.visualMaps = new List<ChartVisualMap>();
        o.titles = new List<ChartTitleSpec>();
        o.grids = new List<ChartGridSpec>();
        o.markAreas = new List<ChartMarkArea>();
        o.yAxes = new List<ChartAxis>();
        o.series = new List<ChartSeries>();
        o.geos = new List<ChartGeo>();
        o.calendars = new List<ChartCalendarSpec>();
        o.parAxes = new List<ChartParAxis>();
        o.angleAxes = new List<PolarAxisSpec>();
        o.radiusAxes = new List<PolarAxisSpec>();
        o.parLayout = "";
        o.defaultType = ChartType.Line;
        o.showLegend = true;
        o.showTooltip = true;
        o.tooltipTrigger = "";
        o.tooltipTriggerOn = "";
        o.toolboxShow = false;
        // 对象 API（不经 FromJson）保持全套工具按钮的 2.x 兼容行为；
        // JSON 路径由 FromJson 按 feature 声明重置。
        o.toolboxDataView = true; o.toolboxMagicLine = true;
        o.toolboxMagicBar = true; o.toolboxRestore = true;
        o.toolboxSave = true; o.toolboxZoom = true;
        o.roam = false;
        o.roamWheelMode = "zoom";
        o.mapSelect = false;
        o.rampColors = new List<int>();
        o.rampLo = ChartOption.Auto();
        o.rampHi = ChartOption.Auto();
        o.showGrid = true;
        o.showValues = false;
        o.animate = true;
        // ECharts 5/6 折线默认不平滑（smooth:false）；2.2.x 才默认
        // 曲线。要平滑的调用方显式置 true，或系列级 smooth:1 /
        // smooth:true 覆盖。
        o.smooth = false;
        o.gradient = false;
        o.rounded = true;
        o.animMs = 650;
        o.donutPct = 55;
        o.gaugeMax = 100;
        o.pieLabels = false;
        o.pieRings = false;
        o.overlay = false;
        o.radarMax = new List<int>();
        o.radarShape = "circle";
        o.radarSplitArea = false;
        o.polars = new List<RadarPolar>();
        o.legendOrient = "horizontal";
        o.legendX = "";
        o.legendLeft = ""; o.legendRight = "";
        o.legendTop = ""; o.legendBottom = "";
        o.legendHasLeft = false; o.legendHasRight = false;
        o.legendHasTop = false; o.legendHasBottom = false;
        o.legendLeftPx = 0 - 1; o.legendRightPx = 0 - 1;
        o.legendTopPx = 0 - 1; o.legendBottomPx = 0 - 1;
        o.legendBoxW = 0; o.legendBoxH = 0;
        o.legendSelectedMode = "";
        o.legendFormatter = "";
        o.legendData = null;
        o.titleSub = "";
        o.titleAlign = "";
        o.titleColor = 0;
        o.titleSubColor = 0;
        o.dataRangeShow = false;
        o.dataRangeLo = ChartOption.Auto();
        o.dataRangeHi = ChartOption.Auto();
        o.dataRangeCalculable = false;
        o.dataRangeHoverLink = false;
        o.dataRangeSplit = 0 - 1;
        o.dataRangeList = new List<ChartRangeSplit>();
        o.zoom = false;
        o.markLine = ChartOption.Auto();
        o.markPoint = false;
        o.markLabel = "";
        o.markLo = ChartOption.Auto();
        o.markHi = ChartOption.Auto();
        o.gridLeft = 0 - 1;
        o.gridRight = 0 - 1;
        o.gridTop = 0 - 1;
        o.gridBottom = 0 - 1;
        o.gridLeftPct = 0 - 1;
        o.gridRightPct = 0 - 1;
        o.gridTopPct = 0 - 1;
        o.gridBottomPct = 0 - 1;
        o.containLabel = false;
        o.zoomStart = 0;
        o.zoomEnd = 100;
        // startValue/endValue 字符串必须跟着初始化：null 时
        // ZoomI0/ZoomI1 的 .Length 探针每帧抛软错误，dataZoom
        // 窗口初始化被打断（空面板）。
        o.zoomStartValue = "";
        o.zoomEndValue = "";
        o.windowStart = 0;
        o.windowEnd = 0 - 1;
        o.backgroundColor = 0;
        o.iwid = 0;
        o.connectGroup = 0;
        return o;
    }

    /// 以现成系列列表构造 option（标题为空，轴另配）。
    static ChartOption Of(List<ChartSeries> series) {
        ChartOption o = ChartOption.Create();
        o.series = series;
        return o;
    }

    /// 声明式一次性构建：标题 + 分类轴 + 完整系列列表——
    /// 对应 ECharts `{ title, xAxis.data, series }`。混合图表只是
    /// 列表中不同类型的系列。
    static ChartOption Of(string title, List<string> categories, List<ChartSeries> series) {
        ChartOption o = ChartOption.Create();
        o.title = title;
        if (categories != null && categories.Count > 0) { o.Categories(categories); }
        o.series = series;
        return o;
    }

    /// 单系列 option 便捷形式。
    static ChartOption Single(ChartSeries s) {
        List<ChartSeries> ss = new List<ChartSeries>();
        ss.Add(s);
        return ChartOption.Of(ss);
    }

    /// 多系列嵌套环饼图：每个 Pie 系列绘制为一层环。
    static ChartOption OfRings(string title, List<ChartSeries> series) {
        ChartOption o = ChartOption.Of(series);
        o.title = title;
        o.pieRings = true;
        return o;
    }

    // ---- 声明式工厂：一次调用构建默认类型 + 轴 ----

    /// 基础工厂：默认系列类型 + 可选分类轴。饼/环
    /// 系列族将分类用作扇区标签；直角坐标系系列族用作
    /// x 轴标签。
    static ChartOption With(ChartType t, string title, List<string> cats) {
        ChartOption o = ChartOption.Create();
        o.title = title;
        o.defaultType = t;
        if (cats != null && cats.Count > 0) { o.Categories(cats); }
        return o;
    }

    /// 折线图 option（标题 + 分类轴，后续 Add 系列默认 Line）。
    static ChartOption Line(string title, List<string> cats) { return ChartOption.With(ChartType.Line, title, cats); }
    /// 柱状图 option。
    static ChartOption Bar(string title, List<string> cats) { return ChartOption.With(ChartType.Bar, title, cats); }
    /// 饼图 option（cats 用作扇区标签）。
    static ChartOption Pie(string title, List<string> cats) { return ChartOption.With(ChartType.Pie, title, cats); }
    /// 散点图 option（无分类轴，数据走 points/专用列表）。
    static ChartOption Scatter(string title) { return ChartOption.With(ChartType.Scatter, title, null); }
    /// 矩形树图 option。
    static ChartOption Treemap(string title) { return ChartOption.With(ChartType.Treemap, title, null); }

    /// 添加一个选项默认类型的系列；颜色自动分配。
    ChartOption Add(string name, List<int> values) {
        this.series.Add(ChartSeries.Of(name, this.defaultType, values));
        return this;
    }

    /// 添加显式类型的系列（混合图表：柱 + 折线叠加）。
    ChartOption Add(string name, ChartType type, List<int> values) {
        this.series.Add(ChartSeries.Of(name, type, values));
        return this;
    }

    /// 从带名称/颜色的数据项添加系列（饼图的逐项标签、
    /// 瀑布图总量柱、逐扇区颜色等）。
    ChartOption AddLabel(string name, List<ChartData> data) {
        this.series.Add(ChartSeries.Named(name, this.defaultType, data));
        return this;
    }

    /// 添加现成系列（显式颜色 / 专用数据列表）。
    ChartOption Add(ChartSeries s) { this.series.Add(s); return this; }

    /// 快速设置分类 x 轴（ECharts xAxis.data）。
    ChartOption Categories(List<string> cats) {
        this.xAxes.Add(ChartAxis.Category(cats));
        return this;
    }

    /// 设置地图滚轮策略；非法值回退到兼容默认 zoom。
    ChartOption RoamWheel(string mode) {
        this.roamWheelMode = ChartKinds.RoamWheelModeSanitize(mode);
        return this;
    }

    /// 追加一个 x 轴。
    ChartOption X(ChartAxis ax) { this.xAxes.Add(ax); return this; }
    /// 追加一个 y 轴（第二个 y 轴 = 右/次轴，系列用 axisIndex 绑定）。
    ChartOption Y(ChartAxis ax) { this.yAxes.Add(ax); return this; }

    /// 声明雷达每轴满刻度（按指标顺序；空表 = 从数据推导）。
    ChartOption RadarMax(List<int> maxs) {
        this.radarMax = maxs;
        return this;
    }

    /// visualMap 连续映射：值域 [lo,hi] 线性经过 colors（≥2 个
    /// 停止点，ECharts visualMap.inRange.color）。热力图按单元格
    /// 值取色；未设的边界用数据最小/最大值。
    ChartOption VisualRange(int lo, int hi, List<int> colors) {
        this.rampLo = lo;
        this.rampHi = hi;
        this.rampColors = colors;
        return this;
    }

    /// 设置 dataZoom 的初始窗口（百分比，自动钳制到 0..100）。
    ChartOption DataZoom(int start, int end) {
        if (start < 0) { start = 0; }
        if (start > 100) { start = 100; }
        if (end < 0) { end = 0; }
        if (end > 100) { end = 100; }
        if (end < start) { int t = start; start = end; end = t; }
        this.zoom = true;
        this.zoomStart = start;
        this.zoomEnd = end;
        return this;
    }

    /// 覆盖绘图区边距，等价于 ECharts grid.left/right/top/bottom。
    ChartOption Grid(int left, int right, int top, int bottom) {
        this.gridLeft = left; this.gridRight = right;
        this.gridTop = top; this.gridBottom = bottom;
        return this;
    }

    // ---- 解析视图（渲染器使用；视为只读）----

    /// 第一个 x 轴；未配置时用 XCategories() 现场拼一个分类轴。
    ChartAxis XAxis0() {
        if (this.xAxes.Count > 0) { return this.xAxes[0]; }
        return ChartAxis.Category(this.XCategories());
    }

    /// 第一个 y 轴；未配置时返回默认数值轴（不写入列表）。
    ChartAxis YAxis0() {
        if (this.yAxes.Count > 0) { return this.yAxes[0]; }
        return ChartAxis.Value();
    }

    /// 第二个 y 轴；只有一根时回退为 YAxis0()（双轴图右轴）。
    ChartAxis YAxis1() {
        if (this.yAxes.Count > 1) { return this.yAxes[1]; }
        return this.YAxis0();
    }

    /// x 轴的分类标签：第一个 x 轴的分类，否则为
    /// 第一个系列的数据名，再否则 1..N。
    List<string> XCategories() {
        if (this.xAxes.Count > 0 && this.xAxes[0].categories.Count > 0) {
            return this.xAxes[0].categories;
        }
        if (this.series.Count > 0 && this.series[0].data.Count > 0) {
            List<string> outp = new List<string>();
            int n = this.series[0].data.Count;
            for (int i = 0; i < n; i = i + 1) {
                string nm = this.series[0].data[i].name;
                if (nm.Length > 0) { outp.Add(nm); }
                else { outp.Add(Convert.ToString(i + 1)); }
            }
            return outp;
        }
        return new List<string>();
    }

    // ---- JSON ----

    /// 解析 ECharts 风格的选项文档。结构：
    ///
    ///   {"title":"Revenue",
    ///    "xAxis":{"type":"category","data":["Q1","Q2","Q3"]},
    ///    "yAxis":{"type":"value"},
    ///    "series":[{"type":"bar","name":"Rev","data":[12,28,20]},
    ///              {"type":"line","name":"Cost","data":[{"value":8,"name":"Q1"},14]}]}
    ///
    /// 旧的紧凑结构（labels + series[].values）仍然接受。
    static ChartOption FromJson(string src) {
        return ChartOption.FromJsonValue(JsonValue.ParseLenient(src));
    }

    /// ECharts 时间值归一为 epoch 秒：数值 ≥1e11 视为毫秒（官方
    /// 面积时间轴数据形态），其余为秒；字符串取其中的数字段按
    /// "YYYY-MM-DD"、"YYYY/M/D" 或 "M/D/YYYY"（可带 HH:MM(:SS)）
    /// 解析（dynamic-data2 的 ["1997/10/4", 730] 形态）。不可解析
    /// 返回 dflt。
    static long TimeValueSec(JsonValue v, long dflt) {
        if (v == null) { return dflt; }
        if (v.IsNumber()) {
            double d = v.AsDouble((double)dflt);
            if (d >= 1e11) { d = d / 1000.0; }
            return (long)d;
        }
        if (v.IsString()) { return ChartOption.TimeStringSec(v.AsString("")); }
        return dflt;
    }

    /// 时间轴 x 域归一：epoch 毫秒/秒/日期串 → epoch 天。引擎的
    /// 时间域是天（TimeLabel/XOfTime/旧整数天数路径同域）。秒直接
    /// 装 int32 会在 2038 后回绕成负值，TimeTicks 的 span 随之整型
    /// 溢出、步长卡在 1 → 43 亿次刻度循环把内存撑爆（area-time-
    /// axis 20k 天数据挂死的根因）。天域 int32 安全到 ±580 万年。
    static int TimeDayOf(JsonValue v) {
        long tv = ChartOption.TimeValueSec(v, 0 - 1);
        if (tv < 0) { return 0 - 1; }
        return (int)(tv / 86400);
    }

    /// 提取字符串中的数字段（至多 6 段：年 月 日 时 分 秒），
    /// 按日历转 epoch 秒；段数 <3 或字段非法返回 -1。
    static long TimeStringSec(string s) {
        int[] p = new int[6];
        int n = 0;
        int i = 0;
        while (i < s.Length && n < 6) {
            int d = DateTime.Digit(s.Substring(i, 1));
            if (d < 0) { i = i + 1; continue; }
            int v = 0;
            while (i < s.Length) {
                d = DateTime.Digit(s.Substring(i, 1));
                if (d < 0) { break; }
                v = v * 10 + d;
                i = i + 1;
            }
            p[n] = v;
            n = n + 1;
        }
        if (n < 3) { return 0 - 1; }
        int y; int mo; int da;
        if (p[0] >= 1000) { y = p[0]; mo = p[1]; da = p[2]; }
        else if (p[0] >= 1 && p[0] <= 12 && p[2] >= 1000) {
            mo = p[0]; da = p[1]; y = p[2];
        } else { return 0 - 1; }
        if (mo < 1 || mo > 12 || da < 1 || da > 31 || y > 2200) { return 0 - 1; }
        int hh = n > 3 ? p[3] : 0;
        int mi = n > 4 ? p[4] : 0;
        int ss = n > 5 ? p[5] : 0;
        return (long)DateTime.DaysFromCivil(y, mo, da) * 86400
            + hh * 3600 + mi * 60 + ss;
    }

    /// 解析标量：数字按像素；字符串带 "%" 按百分比，否则按像素。
    /// v 为 null 时返回 dflt。
    static ChartScalar ParseScalar(JsonValue v, ChartScalar dflt) {
        if (v == null) { return dflt; }
        if (v.IsNumber()) { return ChartScalar.Px(v.AsInt(0)); }
        string s = v.AsString("");
        int pct = s.IndexOf("%");
        if (pct >= 0) { return ChartScalar.Pct((int)JsonValue.DoubleOf(s.Substring(0, pct))); }
        return ChartScalar.Px((int)JsonValue.DoubleOf(s));
    }

    /// 解析颜色：数字直接用；"auto" 归 0（继承）；字符串经
    /// StyleSheet.ParseColor，无法解析且非空时返回 dflt。
    /// "transparent" 返回 alpha≈0 的哨兵色（非 0，不与"继承系列色"
    /// 的 0 值语义冲突；视觉上不可见——瀑布图占位柱依赖它）。
    static int ParseColor(JsonValue v, int dflt) {
        if (v == null) { return dflt; }
        if (v.IsNumber()) { return v.AsInt(dflt); }
        string s = v.AsString("");
        if (s == "auto") { return 0; }
        if (s == "transparent") { return Chart.Transparent(); }
        int color = StyleSheet.ParseColor(s);
        if (color == 0 && s.Length > 0) { return dflt; }
        return color;
    }

    /// __grad 渐变对象（converter 序列化 echarts.graphic.
    /// LinearGradient 的产物）的 colorStops → ARGB 表。offset 暂
    /// 忽略（等分插值，绝大多数示例是 0/1 双停）；非渐变对象
    /// 或停点不足两个返回 null。
    static List<int> ParseGradStops(JsonValue cv) {
        if (cv == null || !cv.IsObject()) { return null; }
        JsonValue stops = cv.Get("colorStops");
        if (stops == null || !stops.IsArray()) { return null; }
        List<int> outv = new List<int>();
        for (int i = 0; i < stops.Count(); i = i + 1) {
            JsonValue stp = stops.At(i);
            if (stp == null || !stp.IsObject()) { continue; }
            outv.Add(ChartOption.ParseColor(stp.Get("color"), 0));
        }
        if (outv.Count < 2) { return null; }
        return outv;
    }

    /// 把 JSON textStyle 逐字段并入 text（缺省字段保持原值）。
    static void ParseTextStyle(JsonValue v, ChartTextStyle text) {
        if (v == null || !v.IsObject()) { return; }
        if (v.Has("color")) { text.color = ChartOption.ParseColor(v.Get("color"), text.color); }
        text.fontSize = v.Int("fontSize", text.fontSize);
        text.fontStyle = v.Str("fontStyle", text.fontStyle);
        text.fontWeight = v.Str("fontWeight", text.fontWeight);
        text.fontFamily = v.Str("fontFamily", text.fontFamily);
        if (v.Has("shadowColor")) { text.shadowColor = ChartOption.ParseColor(v.Get("shadowColor"), text.shadowColor); }
        text.shadowBlur = v.Int("shadowBlur", text.shadowBlur);
        // A14：label 级 textBorder*/textShadow*（ParseTextStyle 单点
        // 解析全量文本样式的既有约定）。
        if (v.Has("textBorderColor")) { text.tbColor = ChartOption.ParseColor(v.Get("textBorderColor"), text.tbColor); }
        JsonValue tbw2 = v.Get("textBorderWidth");
        if (tbw2 != null && tbw2.IsNumber()) { text.tbWidth = ChartOption.RoundOff(tbw2.AsDouble(0.0)); }
        if (v.Has("textShadowColor")) { text.tsColor = ChartOption.ParseColor(v.Get("textShadowColor"), text.tsColor); }
        JsonValue tsb2 = v.Get("textShadowBlur");
        if (tsb2 != null && tsb2.IsNumber()) { text.tsBlur = ChartOption.RoundOff(tsb2.AsDouble(0.0)); }
        text.tsDx = v.Int("textShadowOffsetX", text.tsDx);
        text.tsDy = v.Int("textShadowOffsetY", text.tsDy);
        text.lineHeight = v.Int("lineHeight", text.lineHeight);
        // 整块盒样式（label.backgroundColor/border/padding，官方 label
        // 文档同名列；pie-rich-text 的 data.label 底板走这里）。
        JsonValue bg = v.Get("backgroundColor");
        if (bg != null) {
            if (bg.IsObject()) {
                // {image:...}：素材不可得，仅盒样式占位。
                text.boxBg = 0 - 1;
            } else {
                text.boxBg = ChartOption.ParseColor(bg, 0);
            }
        }
        if (v.Has("borderColor")) { text.boxBorder = ChartOption.ParseColor(v.Get("borderColor"), text.boxBorder); }
        JsonValue bw = v.Get("borderWidth");
        if (bw != null && bw.IsNumber()) {
            text.boxBorderW = ChartOption.RoundOff(bw.AsDouble(0.0));
        }
        JsonValue br = v.Get("borderRadius");
        if (br != null) {
            if (br.IsArray() && br.Count() > 0) { br = br.At(0); }
            if (br.IsNumber()) { text.boxRadius = ChartOption.RoundOff(br.AsDouble(0.0)); }
        }
        ChartOption.ParsePaddingInto(v.Get("padding"), text, null);
        // label.rich：对象键序 = 声明序（JsonValue keys 保序）。
        JsonValue rv = v.Get("rich");
        if (rv != null && rv.IsObject()) {
            text.rich = new List<ChartRichStyle>();
            for (int i = 0; i < rv.keys.Count; i = i + 1) {
                ChartRichStyle rs = ChartRichStyle.Create();
                rs.name = rv.keys[i];
                ChartOption.ParseRichStyle(rv.vals[i], rs);
                text.rich.Add(rs);
            }
        }
    }

    /// padding：number → 四边；[v,h] → 纵横；[t,r,b,l] → 逐边。
    /// 写入 text（非 null）或 rs（非 null）的 pad 四字段。负值合法
    /// （gauge-speed 的 [0,0,-20,10]），按四舍五入（远离零）取整。
    static void ParsePaddingInto(JsonValue pv, ChartTextStyle text, ChartRichStyle rs) {
        int t = 0 - 1;
        int r = 0 - 1;
        int b = 0 - 1;
        int l = 0 - 1;
        if (pv != null && pv.IsNumber()) {
            int n = ChartOption.RoundOff(pv.AsDouble(0.0));
            t = n; r = n; b = n; l = n;
        } else if (pv != null && pv.IsArray()) {
            int c = pv.Count();
            if (c == 1) {
                int n1 = ChartOption.RoundOff(pv.At(0).AsDouble(0.0));
                t = n1; r = n1; b = n1; l = n1;
            } else if (c == 2) {
                t = ChartOption.RoundOff(pv.At(0).AsDouble(0.0));
                b = t;
                r = ChartOption.RoundOff(pv.At(1).AsDouble(0.0));
                l = r;
            } else if (c >= 4) {
                t = ChartOption.RoundOff(pv.At(0).AsDouble(0.0));
                r = ChartOption.RoundOff(pv.At(1).AsDouble(0.0));
                b = ChartOption.RoundOff(pv.At(2).AsDouble(0.0));
                l = ChartOption.RoundOff(pv.At(3).AsDouble(0.0));
            }
        }
        if (text != null) { text.padT = t; text.padR = r; text.padB = b; text.padL = l; }
        if (rs != null) { rs.padT = t; rs.padR = r; rs.padB = b; rs.padL = l; }
    }

    /// double 四舍五入（负域远离零；C 的 (int) 截断朝零，-19.5 会
    /// 变 -19——gauge-speed 的 -20 padding 需要真正的 round）。
    static int RoundOff(double d) {
        if (d >= 0.0) { return (int)(d + 0.5); }
        return (int)(d - 0.5);
    }

    /// rich.<name> 单样式（官方"富文本标签"文档样式键；fontWeight
    /// 官方也接受数字 800，gauge-car 用到）。
    static void ParseRichStyle(JsonValue v, ChartRichStyle rs) {
        if (v == null || !v.IsObject()) { return; }
        if (v.Has("color")) { rs.color = ChartOption.ParseColor(v.Get("color"), rs.color); }
        JsonValue fs = v.Get("fontSize");
        if (fs != null && fs.IsNumber()) { rs.fontSize = fs.AsInt(rs.fontSize); }
        JsonValue fw = v.Get("fontWeight");
        if (fw != null) {
            if (fw.IsString()) { rs.fontWeight = fw.AsString(rs.fontWeight); }
            else if (fw.IsNumber()) { rs.fontWeight = Convert.ToString(fw.AsInt(0)); }
        }
        rs.fontFamily = v.Str("fontFamily", rs.fontFamily);
        // A14：rich 段 textBorder*/textShadow*（bar-rich-text 摘要卡
        // 卡头白字、text-options 的 textBorder/textShadow 段）。
        if (v.Has("textBorderColor")) { rs.tbColor = ChartOption.ParseColor(v.Get("textBorderColor"), rs.tbColor); }
        JsonValue tbw = v.Get("textBorderWidth");
        if (tbw != null && tbw.IsNumber()) { rs.tbWidth = ChartOption.RoundOff(tbw.AsDouble(0.0)); }
        if (v.Has("textShadowColor")) { rs.tsColor = ChartOption.ParseColor(v.Get("textShadowColor"), rs.tsColor); }
        JsonValue tsb = v.Get("textShadowBlur");
        if (tsb != null && tsb.IsNumber()) { rs.tsBlur = ChartOption.RoundOff(tsb.AsDouble(0.0)); }
        rs.tsDx = v.Int("textShadowOffsetX", rs.tsDx);
        rs.tsDy = v.Int("textShadowOffsetY", rs.tsDy);
        string al = v.Str("align", "");
        if (al == "left") { rs.align = 0; }
        else if (al == "center") { rs.align = 1; }
        else if (al == "right") { rs.align = 2; }
        rs.lineHeight = v.Int("lineHeight", rs.lineHeight);
        JsonValue bg = v.Get("backgroundColor");
        if (bg != null) {
            if (bg.IsObject()) { rs.bgIsImage = 1; }
            else { rs.backgroundColor = ChartOption.ParseColor(bg, rs.backgroundColor); }
        }
        if (v.Has("borderColor")) { rs.borderColor = ChartOption.ParseColor(v.Get("borderColor"), rs.borderColor); }
        JsonValue bw = v.Get("borderWidth");
        if (bw != null && bw.IsNumber()) {
            rs.borderWidth = ChartOption.RoundOff(bw.AsDouble(0.0));
        }
        JsonValue br = v.Get("borderRadius");
        if (br != null) {
            if (br.IsArray() && br.Count() >= 4) {
                rs.radTL = ChartOption.RoundOff(br.At(0).AsDouble(0.0));
                rs.radTR = ChartOption.RoundOff(br.At(1).AsDouble(0.0));
                rs.radBR = ChartOption.RoundOff(br.At(2).AsDouble(0.0));
                rs.radBL = ChartOption.RoundOff(br.At(3).AsDouble(0.0));
            } else if (br.IsArray() && br.Count() > 0) {
                int r0 = ChartOption.RoundOff(br.At(0).AsDouble(0.0));
                rs.radTL = r0; rs.radTR = r0; rs.radBR = r0; rs.radBL = r0;
            } else if (br.IsNumber()) {
                int rn = ChartOption.RoundOff(br.AsDouble(0.0));
                rs.radTL = rn; rs.radTR = rn; rs.radBR = rn; rs.radBL = rn;
            }
        }
        JsonValue wd = v.Get("width");
        if (wd != null) {
            if (wd.IsNumber()) { rs.width = wd.AsInt(rs.width); }
            else if (wd.IsString() && wd.AsString("") == "100%") { rs.width = 0 - 2; }
        }
        rs.height = v.Int("height", rs.height);
        ChartOption.ParsePaddingInto(v.Get("padding"), null, rs);
    }

    /// 把 JSON lineStyle 逐字段并入 line（color/color0 不接受数组形式）。
    static void ParseLineStyle(JsonValue v, ChartLineStyle line) {
        if (v == null || !v.IsObject()) { return; }
        JsonValue lineColor = v.Get("color");
        if (lineColor != null && !lineColor.IsArray()) {
            if (lineColor.IsObject()) {
                // __grad 渐变线色：stops 存表（横向逐段取色），首停
                // 当兜底纯色。
                List<int> stops = ChartOption.ParseGradStops(lineColor);
                if (stops != null) {
                    line.gradStops = stops;
                    line.color = stops[0];
                }
            } else {
                line.color = ChartOption.ParseColor(lineColor, line.color);
            }
        }
        JsonValue lineColor0 = v.Get("color0");
        if (lineColor0 != null && !lineColor0.IsArray()) {
            line.color0 = ChartOption.ParseColor(lineColor0, line.color0);
        }
        // 宽度按 double 取 round：官方发丝线 width 0.5 经整型截断
        // 会打成 0，渲染器只能落回缺省粗线（ECharts 语义 0.5px =
        // 引擎最细 1px）。
        line.width = (int)(v.Double("width", (double)line.width) + 0.5);
        line.type = v.Str("type", line.type);
        // opacity:0 隐藏描边（面积带叠加的隐线）；>0 记 0..255
        // 供消费方取用（parallel 行折线的密度叠加）。
        if (v.Has("opacity")) {
            double op = v.Double("opacity", 1.0);
            line.transparent = op == 0.0;
            line.alpha = (int)(op * 255.0 + 0.5);
        }
        if (v.Has("shadowColor")) { line.shadowColor = ChartOption.ParseColor(v.Get("shadowColor"), line.shadowColor); }
        line.shadowBlur = v.Int("shadowBlur", line.shadowBlur);
    }

    /// 解析 [x,y] 数组为标量坐标；元素不足两个或非数组时返回 dflt。
    /// dflt 允许 null（cs.center 等字段语义就是 null = 未设）：此时
    /// 元素缺失用 Auto 兜底，不能解引用 dflt。
    static ChartPosition ParsePoint(JsonValue v, ChartPosition dflt) {
        if (v == null || !v.IsArray() || v.Count() < 2) { return dflt; }
        if (dflt == null) {
            // ECharts center 缺省即 ['50%','50%']，元素缺失按它兜底。
            return ChartPosition.Of(ChartOption.ParseScalar(v.At(0), ChartScalar.Pct(50)),
                ChartOption.ParseScalar(v.At(1), ChartScalar.Pct(50)));
        }
        return ChartPosition.Of(ChartOption.ParseScalar(v.At(0), dflt.x),
            ChartOption.ParseScalar(v.At(1), dflt.y));
    }

    /// 把 JSON gauge 段逐字段并入 gauge（center/radius/角度/值域与
    /// 轴线、刻度、标签、分隔线、指针、标题、数值牌子对象）。
    static void ParseGauge(JsonValue v, GaugeOption gauge) {
        if (v == null || !v.IsObject()) { return; }
        gauge.center = ChartOption.ParsePoint(v.Get("center"), gauge.center);
        JsonValue radius = v.Get("radius");
        if (radius != null && radius.IsArray() && radius.Count() >= 2) {
            gauge.innerRadius = ChartOption.ParseScalar(radius.At(0), gauge.innerRadius);
            gauge.radius = ChartOption.ParseScalar(radius.At(1), gauge.radius);
        } else if (radius != null) {
            gauge.radius = ChartOption.ParseScalar(radius, gauge.radius);
        }
        gauge.startAngle = v.Int("startAngle", gauge.startAngle);
        gauge.endAngle = v.Int("endAngle", gauge.endAngle);
        gauge.min = v.Int("min", gauge.min);
        gauge.max = v.Int("max", gauge.max);
        gauge.precision = v.Int("precision", gauge.precision);
        gauge.splitNumber = v.Int("splitNumber", gauge.splitNumber);

        JsonValue axisLine = v.Get("axisLine");
        if (axisLine != null && axisLine.IsObject()) {
            gauge.axisLine.show = axisLine.Bool("show", gauge.axisLine.show);
            JsonValue line = axisLine.Get("lineStyle");
            ChartOption.ParseLineStyle(line, gauge.axisLine.lineStyle);
            if (line != null && line.IsObject()) {
                JsonValue colors = line.Get("color");
                if (colors != null && colors.IsArray()) {
                    gauge.axisLine.colors = new List<GaugeColorStop>();
                    for (int i = 0; i < colors.Count(); i = i + 1) {
                        JsonValue pair = colors.At(i);
                        if (pair.IsArray() && pair.Count() >= 2) {
                            int stop = (int)(pair.At(0).AsDouble(0.0) * 1000.0);
                            int color = ChartOption.ParseColor(pair.At(1), 0);
                            gauge.axisLine.colors.Add(GaugeColorStop.Of(stop, color));
                        }
                    }
                }
            }
        }

        JsonValue tick = v.Get("axisTick");
        if (tick != null && tick.IsObject()) {
            gauge.axisTick.show = tick.Bool("show", gauge.axisTick.show);
            gauge.axisTick.splitNumber = tick.Int("splitNumber", gauge.axisTick.splitNumber);
            gauge.axisTick.length = tick.Int("length", gauge.axisTick.length);
            ChartOption.ParseLineStyle(tick.Get("lineStyle"), gauge.axisTick.lineStyle);
        }
        JsonValue label = v.Get("axisLabel");
        if (label != null && label.IsObject()) {
            gauge.axisLabel.show = label.Bool("show", gauge.axisLabel.show);
            gauge.axisLabel.formatter = label.Str("formatter", gauge.axisLabel.formatter);
            ChartOption.ParseTextStyle(label.Get("textStyle"), gauge.axisLabel.textStyle);
        }
        JsonValue split = v.Get("splitLine");
        if (split != null && split.IsObject()) {
            gauge.splitLine.show = split.Bool("show", gauge.splitLine.show);
            gauge.splitLine.length = split.Int("length", gauge.splitLine.length);
            ChartOption.ParseLineStyle(split.Get("lineStyle"), gauge.splitLine.lineStyle);
        }
        JsonValue pointer = v.Get("pointer");
        if (pointer != null && pointer.IsObject()) {
            gauge.pointer.length = ChartOption.ParseScalar(pointer.Get("length"), gauge.pointer.length);
            gauge.pointer.width = pointer.Int("width", gauge.pointer.width);
            if (pointer.Has("color")) { gauge.pointer.color = ChartOption.ParseColor(pointer.Get("color"), gauge.pointer.color); }
            if (pointer.Has("shadowColor")) { gauge.pointer.shadowColor = ChartOption.ParseColor(pointer.Get("shadowColor"), gauge.pointer.shadowColor); }
            gauge.pointer.shadowBlur = pointer.Int("shadowBlur", gauge.pointer.shadowBlur);
        }
        JsonValue title = v.Get("title");
        if (title != null && title.IsObject()) {
            gauge.title.show = title.Bool("show", gauge.title.show);
            gauge.title.offsetCenter = ChartOption.ParsePoint(title.Get("offsetCenter"), gauge.title.offsetCenter);
            ChartOption.ParseTextStyle(title.Get("textStyle"), gauge.title.textStyle);
        }
        JsonValue detail = v.Get("detail");
        if (detail != null && detail.IsObject()) {
            gauge.detail.show = detail.Bool("show", gauge.detail.show);
            if (detail.Has("backgroundColor")) { gauge.detail.backgroundColor = ChartOption.ParseColor(detail.Get("backgroundColor"), gauge.detail.backgroundColor); }
            gauge.detail.borderWidth = detail.Int("borderWidth", gauge.detail.borderWidth);
            if (detail.Has("borderColor")) { gauge.detail.borderColor = ChartOption.ParseColor(detail.Get("borderColor"), gauge.detail.borderColor); }
            gauge.detail.width = detail.Int("width", gauge.detail.width);
            gauge.detail.height = detail.Int("height", gauge.detail.height);
            gauge.detail.offsetCenter = ChartOption.ParsePoint(detail.Get("offsetCenter"), gauge.detail.offsetCenter);
            gauge.detail.formatter = detail.Str("formatter", gauge.detail.formatter);
            ChartOption.ParseTextStyle(detail.Get("textStyle"), gauge.detail.textStyle);
            // ECharts 5 把样式键直接挂在 detail 上（gauge-speed 的
            // lineHeight 40 / rich / 盒样式），detail.textStyle 是旧形态
            // ——detail 级后解析、同键覆盖。
            ChartOption.ParseTextStyle(detail, gauge.detail.textStyle);
        }
    }

    /// 把 JSON 单状态样式并入 style：颜色对、描边、borderRadius
    ///（数组最多取 4 个，单数值展开为四角同值）与线/面积子样式。
    static void ParseItemStateStyle(JsonValue v, ChartItemStateStyle style) {
        if (v == null || !v.IsObject()) { return; }
        if (v.Has("color")) { style.color = ChartOption.ParseColor(v.Get("color"), style.color); }
        if (v.Has("color0")) { style.color0 = ChartOption.ParseColor(v.Get("color0"), style.color0); }
        if (v.Has("borderColor")) { style.borderColor = ChartOption.ParseColor(v.Get("borderColor"), style.borderColor); }
        style.borderWidth = v.Int("borderWidth", style.borderWidth);
        JsonValue brad = v.Get("borderRadius");
        if (brad != null) {
            style.borderRadius.Clear();
            if (brad.IsArray()) {
                for (int bi = 0; bi < brad.Count() && bi < 4; bi = bi + 1) {
                    style.borderRadius.Add(brad.At(bi).AsInt(0));
                }
            } else if (brad.IsNumber()) {
                int bv = brad.AsInt(0);
                style.borderRadius.Add(bv);
                style.borderRadius.Add(bv);
                style.borderRadius.Add(bv);
                style.borderRadius.Add(bv);
            }
        }
        ChartOption.ParseLineStyle(v.Get("lineStyle"), style.lineStyle);
        JsonValue area = v.Get("areaStyle");
        if (area != null && area.IsObject()) {
            JsonValue acol2 = area.Has("color") ? area.Get("color") : null;
            if (acol2 != null && acol2.IsObject()) {
                List<int> stops2 = ChartOption.ParseGradStops(acol2);
                if (stops2 != null) {
                    style.areaStyle.gradStops = stops2;
                    style.areaStyle.color = stops2[0];
                }
            } else if (acol2 != null) {
                style.areaStyle.color = ChartOption.ParseColor(acol2, style.areaStyle.color);
            }
            style.areaStyle.type = area.Str("type", style.areaStyle.type);
            // opacity 显式声明（0..1）按 0..255 记录；缺省 0 由渲染器
            // 兜底 v6 多边形缺省 0.7。
            if (area.Has("opacity")) {
                double oa = area.Double("opacity", 1.0);
                int ai = (int)(oa * 255.0 + 0.5);
                if (ai < 0) { ai = 0; }
                if (ai > 255) { ai = 255; }
                style.areaStyle.alpha = ai;
            }
        } else if (area != null && area.IsString()) {
            style.areaStyle.color = ChartOption.ParseColor(area, style.areaStyle.color);
        }
    }

    /// 解析 itemStyle：顶层字段并入 normal，再叠加
    /// normal/emphasis 子对象（ECharts 的紧凑与完整两种形式）。
    static void ParseItemStyle(JsonValue v, ChartItemStyle style) {
        if (v == null || !v.IsObject()) { return; }
        // ECharts accepts the compact form {color: ...} as well as
        // {normal: {...}, emphasis: {...}}.
        ChartOption.ParseItemStateStyle(v, style.normal);
        ChartOption.ParseItemStateStyle(v.Get("normal"), style.normal);
        ChartOption.ParseItemStateStyle(v.Get("emphasis"), style.emphasis);
    }

    /// 解析系列级样式：itemStyle、顶层 lineStyle、areaStyle
    ///（对象 {show,color,type} 或 bool）、label/{show,label}，
    /// 以及顶层 color/show 覆盖。
    static void ParseSeriesStyle(JsonValue v, ChartSeries s) {
        if (v == null || !v.IsObject()) { return; }
        ChartOption.ParseItemStyle(v.Get("itemStyle"), s.itemStyle);
        // ECharts itemStyle.normal.color = 系列主色（线/点/扇区）。
        if (s.color == 0 && s.itemStyle.normal.color != 0) {
            s.color = s.itemStyle.normal.color;
        }
        ChartOption.ParseLineStyle(v.Get("lineStyle"), s.itemStyle.normal.lineStyle);
        JsonValue area = v.Get("areaStyle");
        if (area != null && area.IsObject()) {
            s.areaStyle = area.Bool("show", true);
            JsonValue acol = area.Has("color") ? area.Get("color") : null;
            if (acol != null && acol.IsObject()) {
                // __grad 线性渐变面积（area-simple 橙→桃红）：stops
                // 存表，首停当兜底纯色。
                List<int> stops = ChartOption.ParseGradStops(acol);
                if (stops != null) {
                    s.itemStyle.normal.areaStyle.gradStops = stops;
                    s.itemStyle.normal.areaStyle.color = stops[0];
                }
            } else if (acol != null) {
                s.itemStyle.normal.areaStyle.color = ChartOption.ParseColor(
                    acol, s.itemStyle.normal.areaStyle.color);
            }
            s.itemStyle.normal.areaStyle.type = area.Str("type", s.itemStyle.normal.areaStyle.type);
        } else if (area != null && area.IsBool()) {
            s.areaStyle = area.AsBool(false);
        }
        JsonValue label = v.Get("label");
        if (label != null && label.IsObject()) {
            if (label.Has("show")) {
                s.labelShowT = label.Bool("show", false) ? 1 : 0;
                s.labelShow = s.labelShowT == 1;
            }
            // 系列级模板（{a}{b}{c}{d} / rich 壳），饼与柱标共用；
            // 一直缺失，此前声明 formatter 的标签全部按缺省文本渲染。
            s.labelFmt = label.Str("formatter", s.labelFmt);
            s.pieLabels = label.Bool("pieLabels", s.pieLabels);
            string lpos = label.Str("position", "");
            if (lpos.Length > 0) { s.labelPos = lpos; }
            s.labelRotate = label.Int("rotate", s.labelRotate);
            if (s.labelRotate < 0 - 90) { s.labelRotate = 0 - 90; }
            if (s.labelRotate > 90) { s.labelRotate = 90; }
            // 饼外标微调（PieSeries.ts:273-282）：alignTo 三枚举、
            // distanceToLabelLine、edgeDistance（只认 px 数字形态，
            // '25%' 百分比串走缺省路径）。
            string ato = label.Str("alignTo", "");
            if (ato == "labelLine") { s.labelAlignTo = 1; }
            else if (ato == "edge") { s.labelAlignTo = 2; }
            else if (ato.Length > 0) { s.labelAlignTo = 0; }
            s.labelDist = label.Int("distanceToLabelLine", s.labelDist);
            JsonValue edv = label.Get("edgeDistance");
            if (edv != null && edv.IsNumber()) { s.labelEdgeDist = edv.AsInt(0 - 1); }
            ChartOption.ParseTextStyle(label, s.label);
        }
        // labelLine 是 series 的兄弟键（PieSeries.ts:288），不是 label
        // 的子键：show 三态 + 两段长度；长度 <0 视为未声明走缺省。
        JsonValue lln = v.Get("labelLine");
        if (lln != null && lln.IsObject()) {
            if (lln.Has("show")) {
                s.labelLineShow = lln.Bool("show", false) ? 1 : 0;
            }
            int ll1 = lln.Int("length", 0 - 1);
            if (ll1 >= 0) { s.labelLineLen = ll1; }
            int ll2 = lln.Int("length2", 0 - 1);
            if (ll2 >= 0) { s.labelLineLen2 = ll2; }
        }
        if (v.Has("show")) { s.labelShow = v.Bool("show", s.labelShow); }
        if (v.Has("color")) { s.color = ChartOption.ParseColor(v.Get("color"), s.color); }
    }

    /// 解析 grid.left/right/top/bottom 绘图区边距覆盖。
    /// grid.{left,top,right,bottom}：数字=像素；"N%"=面板尺寸百分
    /// 比（ECharts grid 双形态）。containLabel=true 时边距之外再
    /// 包住轴标签（标签计入 grid 内）。
    static void ParseGrid(JsonValue v, ChartOption o) {
        if (v != null && v.IsArray()) {
            // grid 数组（多 grid 布局）：单格 legacy 字段取第一项，
            // 其余进 grids 供渲染器分组重入。
            for (int gvi = 0; gvi < v.Count(); gvi = gvi + 1) {
                if (v.At(gvi) != null && v.At(gvi).IsObject()) {
                    o.grids.Add(ChartOption.ParseGridOne(v.At(gvi)));
                }
            }
        }
        ChartOption.ParseGridBody(v, o);
    }

    static void ParseGridBody(JsonValue v, ChartOption o) {
        if (v == null || !v.IsObject()) { return; }
        ChartOption.ParseGridEdge(v.Get("left"), true, false, o);
        ChartOption.ParseGridEdge(v.Get("right"), false, false, o);
        ChartOption.ParseGridEdge(v.Get("top"), true, true, o);
        ChartOption.ParseGridEdge(v.Get("bottom"), false, true, o);
        o.containLabel = v.Bool("containLabel", o.containLabel);
    }

    /// 解析 grid 单边：isLeft 选 gridLeft/gridRight，isVert 选水
    /// 平/垂直字段对（px 与 pct 互斥，后写覆盖）。
    static void ParseGridEdge(JsonValue e, bool isLeft, bool isVert, ChartOption o) {
        if (e == null) { return; }
        if (e.IsNumber()) {
            if (isVert) {
                if (isLeft) { o.gridTop = e.AsInt(0 - 1); o.gridTopPct = 0 - 1; }
                else { o.gridBottom = e.AsInt(0 - 1); o.gridBottomPct = 0 - 1; }
            } else {
                if (isLeft) { o.gridLeft = e.AsInt(0 - 1); o.gridLeftPct = 0 - 1; }
                else { o.gridRight = e.AsInt(0 - 1); o.gridRightPct = 0 - 1; }
            }
            return;
        }
        int pct = ChartOption.PercentOf(e.AsString(""), 0 - 1);
        if (pct < 0) { return; }
        if (isVert) {
            if (isLeft) { o.gridTopPct = pct; o.gridTop = 0 - 1; }
            else { o.gridBottomPct = pct; o.gridBottom = 0 - 1; }
        } else {
            if (isLeft) { o.gridLeftPct = pct; o.gridLeft = 0 - 1; }
            else { o.gridRightPct = pct; o.gridRight = 0 - 1; }
        }
    }

    /// "3%" -> 3；无 % 或空串返回 dflt。
    static int PercentOf(string s, int dflt) {
        if (s == null) { return dflt; }
        int at = s.IndexOf("%");
        if (at <= 0) { return dflt; }
        return (int)JsonValue.DoubleOf(s.Substring(0, at));
    }

    /// 解析 dataZoom（对象或数组取首项）：show/start/end 百分比，
    /// startValue/endValue 按类目名定位窗口（line-aqi），钳制到
    /// 0..100 且 end < start 时交换。
    static void ParseDataZoom(JsonValue v, ChartOption o) {
        if (v == null) { return; }
        JsonValue z = v;
        if (v.IsArray()) {
            if (v.Count() < 1) { return; }
            z = v.At(0);
        }
        if (z == null || !z.IsObject()) { return; }
        o.zoom = z.Bool("show", true);
        o.zoomStart = z.Int("start", o.zoomStart);
        o.zoomEnd = z.Int("end", o.zoomEnd);
        o.zoomStartValue = z.Str("startValue", o.zoomStartValue);
        o.zoomEndValue = z.Str("endValue", o.zoomEndValue);
        if (o.zoomStart < 0) { o.zoomStart = 0; }
        if (o.zoomStart > 100) { o.zoomStart = 100; }
        if (o.zoomEnd < 0) { o.zoomEnd = 0; }
        if (o.zoomEnd > 100) { o.zoomEnd = 100; }
        if (o.zoomEnd < o.zoomStart) {
            int t = o.zoomStart; o.zoomStart = o.zoomEnd; o.zoomEnd = t;
        }
    }

    /// 解析 legend 单边锚（官方盒模型 left/right/top/bottom）：数字与
    /// "N%" 都换算成 px（百分比基数未知时退回 sidePx），关键字
    /// （left/center/right、top/middle/bottom）原样记入 raw。isVert
    /// 选水平/垂直锚位，isFar 选远端（right/bottom）。`legendHas*`
    /// 区分"未声明"与"声明为 0"——官方 getLayoutRect 里 0 是合法锚。
    static void ParseLegendAnchor(JsonValue v, string key, bool isVert,
                                  bool isFar, ChartOption o, int sidePx) {
        if (v == null || !v.Has(key)) { return; }
        JsonValue pv = v.Get(key);
        string raw = "";
        int px = 0 - 1;
        if (pv != null && pv.IsNumber()) {
            px = pv.AsInt(0 - 1);
            raw = Convert.ToString(px);
        } else {
            raw = pv == null ? "" : pv.AsString("");
            if (raw.EndsWith("%")) {
                int pct = Convert.ToInt(raw.Substring(0, raw.Length - 1));
                int boxLen = isVert ? o.legendBoxH : o.legendBoxW;
                if (boxLen < 1) { boxLen = sidePx; }
                px = boxLen * pct / 100;
            }
        }
        if (!isVert) {
            if (isFar) { o.legendRight = raw; o.legendHasRight = true; o.legendRightPx = px; }
            else { o.legendLeft = raw; o.legendHasLeft = true; o.legendLeftPx = px; }
        } else {
            if (isFar) { o.legendBottom = raw; o.legendHasBottom = true; o.legendBottomPx = px; }
            else { o.legendTop = raw; o.legendHasTop = true; o.legendTopPx = px; }
        }
    }

    /// 解析 markArea（option 级与 series 级各挂一次）。data 的每对
    /// [{xAxis|yAxis, name?}, {...}]：x 对按类目名/序号成竖带，
    /// y 对成横带。首对"无名无色"的纯 y 影子带仍走旧
    /// markLo/markHi 通道（等价绘制，避免与旧金样重复）。
    static void ParseMarkArea(JsonValue v, ChartOption o) {
        if (v == null || !v.IsObject()) { return; }
        JsonValue data = v.Get("data");
        if (data == null || !data.IsArray() || data.Count() < 1) { return; }
        JsonValue st = v.Get("itemStyle");
        int pairColor = st != null && st.IsObject()
            ? ChartOption.ParseColor(st.Get("color"), 0) : 0;
        for (int pi = 0; pi < data.Count(); pi = pi + 1) {
            JsonValue pair = data.At(pi);
            if (pair == null || !pair.IsArray() || pair.Count() < 2) { continue; }
            JsonValue lo = pair.At(0);
            JsonValue hi = pair.At(1);
            bool loObj = lo != null && lo.IsObject();
            bool hiObj = hi != null && hi.IsObject();
            if (!(loObj && lo.Has("xAxis")) && !(hiObj && hi.Has("xAxis"))) {
                if (!loObj || !lo.Has("yAxis") || !hiObj || !hi.Has("yAxis")) {
                    continue;
                }
                int c0 = pairColor;
                JsonValue lis = lo.Has("itemStyle") ? lo.Get("itemStyle") : null;
                if (c0 == 0 && lis != null) {
                    c0 = ChartOption.ParseColor(lis.Get("color"), 0);
                }
                if (pi == 0 && lo.Str("name", "").Length == 0 && c0 == 0) {
                    o.markLo = lo.Int("yAxis", o.markLo);
                    o.markHi = hi.Int("yAxis", o.markHi);
                    continue;
                }
                ChartMarkArea ya = ChartMarkArea.Of();
                ya.xMode = false;
                ya.v0 = lo.Int("yAxis", 0);
                ya.v1 = hi.Int("yAxis", 0);
                ya.name = lo.Str("name", "");
                ya.color = c0;
                o.markAreas.Add(ya);
                continue;
            }
            int c0x = ChartOption.MarkAreaCatIdx(o, loObj ? lo.Get("xAxis") : null);
            int c1x = ChartOption.MarkAreaCatIdx(o, hiObj ? hi.Get("xAxis") : null);
            if (c0x == ChartOption.MarkAreaNone() || c1x == ChartOption.MarkAreaNone()) {
                continue;
            }
            ChartMarkArea a = ChartMarkArea.Of();
            a.xMode = true;
            a.v0 = c0x;
            a.v1 = c1x;
            a.color = pairColor;
            if (loObj) {
                a.name = lo.Str("name", "");
                JsonValue xis = lo.Has("itemStyle") ? lo.Get("itemStyle") : null;
                if (xis != null) {
                    a.color = ChartOption.ParseColor(xis.Get("color"), a.color);
                }
            }
            o.markAreas.Add(a);
        }
    }

    /// markArea x 端点找不到时的哨兵。
    static int MarkAreaNone() { return 0 - 2147483648; }

    /// markArea 的 x 端解析：字符串在 x 类目表里查序号，数字直接
    /// 取；"min"/"max"（scatter-weight 的数据范围矩形）暂不展开，
    /// 返回哨兵跳过。
    static int MarkAreaCatIdx(ChartOption o, JsonValue xv) {
        if (xv == null) { return ChartOption.MarkAreaNone(); }
        if (xv.IsNumber()) { return xv.AsInt(ChartOption.MarkAreaNone()); }
        string nm = xv.AsString("");
        if (nm == "min" || nm == "max") { return ChartOption.MarkAreaNone(); }
        if (o.xAxes.Count < 1) { return ChartOption.MarkAreaNone(); }
        List<string> cats = o.xAxes[0].categories;
        for (int i = 0; i < cats.Count; i = i + 1) {
            if (cats[i] == nm) { return i; }
        }
        return ChartOption.MarkAreaNone();
    }

    // ---- 专用数据列表解析（ECharts series.data 的多种形状） ----
    // 这些专用列表此前完全未从 JSON 填充：一个 candlestick/
    // boxplot/scatter-points 系列虽能设对 type/custom，但专用列表
    // 留空，渲染器拿不到数据。

    /// 把 ECharts 字符串 stack 组名映射为稳定正 int id
    ///（字符散列 + 1；空名返回 1；0 保留表示"无堆叠"）。
    static int StackIdFor(string name) {
        // ECharts stack 是字符串分组；ChartSeries.stack 是整数 id。
        // 用名称字符和分配稳定正 id（0 仍表示"无堆叠"）。
        if (name.Length == 0) { return 1; }
        int h = 0;
        for (int i = 0; i < name.Length; i = i + 1) {
            h = (h * 31 + name[i]) % 1000000000;
            if (h < 0) { h = 0 - h; }
        }
        if (h == 0) { h = 1; }
        return h + 1;
    }

    /// 解析 links 数组：source/from + target/to + value/val
    ///（缺省 1，负值归 0）；端点名为空的项跳过。
    static void ParseLinks(JsonValue v, List<ChartLink> into) {
        if (v == null || !v.IsArray()) { return; }
        for (int i = 0; i < v.Count(); i = i + 1) {
            JsonValue lk = v.At(i);
            if (!lk.IsObject()) { continue; }
            string from = lk.Str("source", lk.Str("from", ""));
            string to = lk.Str("target", lk.Str("to", ""));
            if (from.Length == 0 || to.Length == 0) { continue; }
            int val = lk.Int("value", lk.Int("val", 1));
            if (val < 0) { val = 0; }
            into.Add(ChartLink.Of(from, to, val));
        }
    }

    /// series.data 的层级数据通道（tree/treemap/sunburst 官方形态）：
    /// [{name, value, children:[...]}...] 递归。value 缺省 0（组节点
    /// 由渲染器按子树累计）。此通道此前缺失，JSON 声明的三类层级
    /// 系列拿到空 tree → 空板。
    static void ParseTree(JsonValue v, List<ChartNode> into) {
        if (v == null || !v.IsArray()) { return; }
        for (int i = 0; i < v.Count(); i = i + 1) {
            JsonValue it = v.At(i);
            if (!it.IsObject()) { continue; }
            string name = it.Str("name", "");
            JsonValue ch = it.Get("children");
            List<ChartNode> kids = new List<ChartNode>();
            if (ch != null && ch.IsArray()) { ChartOption.ParseTree(ch, kids); }
            ChartNode n = kids.Count > 0
                ? ChartNode.GroupVal(name, it.Int("value", 0), kids)
                : ChartNode.Leaf(name, it.Int("value", 0));
            into.Add(n);
        }
    }

    /// graph 系列的 links 解析：端点可以是节点名、id 字符串
    ///（les-miserables 的 "1"）或数字序号（graph-grid source:0）。
    /// 名字精确命中优先；否则按 gnames 序号解析；解析失败跳过。
    static void ParseGraphLinks(JsonValue v, List<ChartLink> into,
                                List<string> gnames) {
        if (v == null || !v.IsArray()) { return; }
        for (int i = 0; i < v.Count(); i = i + 1) {
            JsonValue lk = v.At(i);
            if (!lk.IsObject()) { continue; }
            string from = ChartOption.GraphNodeName(lk.Get("source"),
                lk.Get("from"), gnames);
            string to = ChartOption.GraphNodeName(lk.Get("target"),
                lk.Get("to"), gnames);
            if (from.Length == 0 || to.Length == 0) { continue; }
            int val = lk.Int("value", lk.Int("val", 1));
            if (val < 0) { val = 0; }
            into.Add(ChartLink.Of(from, to, val));
        }
    }

    /// graph link 端点解析（见 ParseGraphLinks）：JsonValue 取
    /// source/from 与 target/to 中第一个存在的；名字精确命中优先，
    /// 其次全数字串/数字按序号落到 gnames。
    static string GraphNodeName(JsonValue a, JsonValue b,
                                List<string> gnames) {
        JsonValue ep = a != null ? a : b;
        if (ep == null) { return ""; }
        if (ep.IsNumber()) {
            int idx = ep.AsInt(0 - 1);
            if (idx >= 0 && idx < gnames.Count) { return gnames[idx]; }
            return "";
        }
        string nm = ep.AsString("");
        if (nm.Length == 0) { return ""; }
        for (int i = 0; i < gnames.Count; i = i + 1) {
            if (gnames[i] == nm) { return nm; }
        }
        // id/序号字符串（"1"）：数字且在范围内按序号落。
        bool digits = nm.Length > 0;
        for (int ci = 0; ci < nm.Length; ci = ci + 1) {
            if (nm[ci] < '0' || nm[ci] > '9') { digits = false; break; }
        }
        if (digits) {
            int idx = Convert.ToInt(nm);
            if (idx >= 0 && idx < gnames.Count) { return gnames[idx]; }
        }
        return "";
    }

    /// 解析蜡烛数据：[open,high,low,close] 数组或同名键对象。
    static void ParseCandles(JsonValue v, List<Candle> into) {
        if (v == null || !v.IsArray()) { return; }
        for (int i = 0; i < v.Count(); i = i + 1) {
            JsonValue it = v.At(i);
            if (it.IsArray() && it.Count() >= 4) {
                into.Add(Candle.Of(it.At(0).AsInt(0), it.At(1).AsInt(0),
                    it.At(2).AsInt(0), it.At(3).AsInt(0)));
            } else if (it.IsObject()) {
                into.Add(Candle.Of(it.Int("open", 0), it.Int("high", 0),
                    it.Int("low", 0), it.Int("close", 0)));
            }
        }
    }

    /// 解析气泡数据：[x,y,weight] 数组（weight 缺省 1）或
    /// {x,y,value|weight} 对象。
    static void ParseBubbles(JsonValue v, List<Bubble> into) {
        if (v == null || !v.IsArray()) { return; }
        for (int i = 0; i < v.Count(); i = i + 1) {
            JsonValue it = v.At(i);
            if (it.IsArray() && it.Count() >= 3) {
                into.Add(Bubble.Of(it.At(0).AsInt(0), it.At(1).AsInt(0), it.At(2).AsInt(1)));
            } else if (it.IsObject()) {
                into.Add(Bubble.Of(it.Int("x", 0), it.Int("y", 0), it.Int("value", it.Int("weight", 1))));
            }
        }
    }

    /// 解析箱线数据：[lo,q1,med,q3,hi] 数组（标签空）或
    /// {name,value:[...]} 对象（不足五值跳过）。
    static void ParseBoxes(JsonValue v, List<BoxItem> into) {
        if (v == null || !v.IsArray()) { return; }
        for (int i = 0; i < v.Count(); i = i + 1) {
            JsonValue it = v.At(i);
            if (it.IsArray() && it.Count() >= 5) {
                into.Add(BoxItem.Of("", it.At(0).AsInt(0), it.At(1).AsInt(0),
                    it.At(2).AsInt(0), it.At(3).AsInt(0), it.At(4).AsInt(0)));
            } else if (it.IsObject()) {
                string nm = it.Str("name", "");
                JsonValue vs = it.Get("value");
                if (vs != null && vs.IsArray() && vs.Count() >= 5) {
                    into.Add(BoxItem.Of(nm, vs.At(0).AsInt(0), vs.At(1).AsInt(0),
                        vs.At(2).AsInt(0), vs.At(3).AsInt(0), vs.At(4).AsInt(0)));
                }
            }
        }
    }

    /// 解析误差条数据：{value,err|y±err} 对象（err 取绝对值）。
    static void ParseErrors(JsonValue v, List<ErrorItem> into) {
        if (v == null || !v.IsArray()) { return; }
        for (int i = 0; i < v.Count(); i = i + 1) {
            JsonValue it = v.At(i);
            if (it.IsObject()) {
                int y = it.Int("value", 0);
                int err = it.Int("err", 0);
                if (err < 0) { err = 0 - err; }
                into.Add(ErrorItem.Of(it.Str("name", ""), y, err));
            }
        }
    }

    /// 度 → 0.01° 定点整数（半值远离零，与 ChartGeoJson 量化
    /// 一致）；geo 系列坐标（lines/scatter/graph）统一走这里。
    static int GeoQ(double d) {
        if (d >= 0.0) { return (int)(d * 100.0 + 0.5); }
        return 0 - (int)((0.0 - d) * 100.0 + 0.5);
    }

    /// 解析散点数据：[x,y] 数组或 {x,y,symbolSize?,color?} 对象。
    /// 坐标按 ×1000 定点存（ECharts 值是浮点：[8.07,6.95]）；调用方
    /// 必须同时把 cs.pointG 置 1000，否则渲染端不除回。
    static void ParsePoints(JsonValue v, List<ChartPoint> into) {
        if (v == null || !v.IsArray()) { return; }
        for (int i = 0; i < v.Count(); i = i + 1) {
            JsonValue it = v.At(i);
            if (it.IsArray() && it.Count() >= 2) {
                into.Add(ChartPoint.Of(ChartOption.Mul1000(it.At(0).AsDouble(0.0)),
                    ChartOption.Mul1000(it.At(1).AsDouble(0.0))));
            } else if (it.IsObject()) {
                ChartPoint p = ChartPoint.Of(
                    ChartOption.Mul1000(it.Double("x", 0.0)),
                    ChartOption.Mul1000(it.Double("y", 0.0)));
                if (it.Has("symbolSize")) {
                    p.size = it.Int("symbolSize", 0);
                    p.sizeSet = true;
                }
                if (it.Has("color")) {
                    p.color = ChartOption.ParseColor(it.Get("color"), 0);
                }
                into.Add(p);
            }
        }
    }

    /// double → ×1000 定点（四舍五入，负数向下）。
    static int Mul1000(double d) {
        if (d >= 0.0) { return (int)(d * 1000.0 + 0.5); }
        return (int)(d * 1000.0 - 0.5);
    }

    /// 解析事件数据：{name,start,end,value?}（end < start 交换、
    /// value 缺省 1 且负值归 0，color 可选）。
    static void ParseEvents(JsonValue v, List<ChartEvent> into) {
        if (v == null || !v.IsArray()) { return; }
        for (int i = 0; i < v.Count(); i = i + 1) {
            JsonValue it = v.At(i);
            if (!it.IsObject()) { continue; }
            string nm = it.Str("name", "");
            int st = it.Int("start", 0);
            int en = it.Int("end", st);
            if (en < st) { int t = st; st = en; en = t; }
            int val = it.Int("value", 1);
            if (val < 0) { val = 0; }
            ChartEvent e = ChartEvent.Of(nm, st, en, val);
            if (it.Has("color")) { e.color = ChartOption.ParseColor(it.Get("color"), 0); }
            into.Add(e);
        }
    }

    /// 解析顶点数组：[x,y] 或 {x,y}；非数组输入返回空表。
    static List<ChartMapPoint> ParseMapPoints(JsonValue arr) {
        List<ChartMapPoint> pts = new List<ChartMapPoint>();
        if (arr == null || !arr.IsArray()) { return pts; }
        for (int i = 0; i < arr.Count(); i = i + 1) {
            JsonValue p = arr.At(i);
            if (p.IsArray() && p.Count() >= 2) {
                pts.Add(ChartMapPoint.Of(p.At(0).AsInt(0), p.At(1).AsInt(0)));
            } else if (p.IsObject()) {
                pts.Add(ChartMapPoint.Of(p.Int("x", 0), p.Int("y", 0)));
            }
        }
        return pts;
    }

    /// 解析地图区域：{name,value,color?,rings:[{points,hole?}]}，
    /// 或单环快捷形式 {points:[...]}；环不足 3 点或区域无环则跳过。
    static void ParseRegions(JsonValue v, List<ChartMapRegion> into) {
        if (v == null || !v.IsArray()) { return; }
        for (int i = 0; i < v.Count(); i = i + 1) {
            JsonValue it = v.At(i);
            if (!it.IsObject()) { continue; }
            string nm = it.Str("name", "");
            int val = it.Int("value", 0);
            int col = 0;
            if (it.Has("color")) { col = ChartOption.ParseColor(it.Get("color"), 0); }
            List<ChartMapRing> rings = new List<ChartMapRing>();
            JsonValue rg = it.Get("rings");
            if (rg == null || !rg.IsArray()) {
                // 单环快捷形式：直接 region.geoCoord 坐标数组
                JsonValue single = it.Get("points");
                List<ChartMapPoint> pts = ChartOption.ParseMapPoints(single);
                if (pts.Count >= 3) { rings.Add(ChartMapRing.Of(pts, false)); }
            } else {
                for (int r = 0; r < rg.Count(); r = r + 1) {
                    JsonValue ring = rg.At(r);
                    if (!ring.IsObject()) { continue; }
                    List<ChartMapPoint> pts = ChartOption.ParseMapPoints(ring.Get("points"));
                    if (pts.Count < 3) { continue; }
                    bool hole = ring.Bool("hole", false);
                    rings.Add(ChartMapRing.Of(pts, hole));
                }
            }
            if (rings.Count == 0 && nm.Length == 0) { continue; }
            // 无环项是注册表地图的按名覆盖 stub（值/显式色），由
            // ChartMaps.BindSeries 并进克隆几何；直接消费方遇空环
            // 自然跳过（不进布局/填充）。
            if (col == 0) {
                into.Add(ChartMapRegion.Of(nm, val, rings));
            } else {
                into.Add(ChartMapRegion.Colored(nm, val, col, rings));
            }
        }
    }

    /// ECharts geo 组件（对象或数组）。
    static void ParseGeo(JsonValue v, ChartOption o) {
        if (v == null) { return; }
        if (v.IsArray()) {
            for (int i = 0; i < v.Count(); i = i + 1) {
                ChartOption.ParseGeoOne(v.At(i), o, i);
            }
        } else {
            ChartOption.ParseGeoOne(v, o, 0);
        }
    }

    /// ECharts parallelAxis：数组按 dim 下标落位（dim 缺省用数组序）。
    static void ParseParAxes(JsonValue v, ChartOption o) {
        if (v == null || !v.IsArray()) { return; }
        for (int i = 0; i < v.Count(); i = i + 1) {
            JsonValue a = v.At(i);
            if (a == null || !a.IsObject()) { continue; }
            int dim = a.Int("dim", i);
            ChartParAxis ax = ChartParAxis.Of();
            ax.name = a.Str("name", "");
            ax.dim = dim;
            ax.inverse = a.Bool("inverse", false);
            if (a.Has("min")) { ax.min = a.Int("min", 0); ax.minSet = true; }
            if (a.Has("max")) { ax.max = a.Int("max", 0); ax.maxSet = true; }
            JsonValue tyj = a.Get("type");
            if (tyj != null && tyj.IsString()
                && tyj.AsString("") == "category") {
                JsonValue cd = a.Get("data");
                if (cd != null && cd.IsArray()) {
                    for (int ci = 0; ci < cd.Count(); ci = ci + 1) {
                        ax.cats.Add(cd.At(ci).AsString(""));
                    }
                }
            }
            while (o.parAxes.Count < dim) { o.parAxes.Add(ChartParAxis.Of()); }
            if (o.parAxes.Count == dim) { o.parAxes.Add(ax); } else { o.parAxes[dim] = ax; }
        }
    }

    /// ECharts angleAxis/radiusAxis：对象或数组形态（数组按
    /// polarIndex 声明落位，缺省用数组序）。
    static void ParsePolarAxes(JsonValue v, ChartOption o, bool isAngle) {
        if (v == null) { return; }
        if (v.IsArray()) {
            for (int i = 0; i < v.Count(); i = i + 1) {
                ChartOption.ParsePolarAxisOne(v.At(i), o, isAngle, i);
            }
            return;
        }
        ChartOption.ParsePolarAxisOne(v, o, isAngle, 0);
    }

    static void ParsePolarAxisOne(JsonValue a, ChartOption o, bool isAngle,
                                  int slot) {
        if (a == null || !a.IsObject()) { return; }
        PolarAxisSpec ax = PolarAxisSpec.Of(isAngle);
        ax.polarIndex = a.Int("polarIndex", slot);
        string ty = a.Str("type", "");
        if (ty == "category") { ax.type = ChartAxisType.Category; }
        else if (ty == "value") { ax.type = ChartAxisType.Value; }
        if (a.Has("min")) { ax.min = a.Int("min", 0); ax.minSet = true; }
        if (a.Has("max")) { ax.max = a.Int("max", 0); ax.maxSet = true; }
        if (isAngle) {
            ax.startAngle = a.Int("startAngle", ax.startAngle);
            // `endAngle` 只在**显式声明**时记入：0 是合法角度值
            // （polar-endAngle 的 polar 0 就是 endAngle:0），不能拿
            // 0 当"未声明"哨兵——旧代码那样做，把四分之一圈撑成满圈。
            if (a.Has("endAngle")) {
                ax.endAngle = a.Int("endAngle", ax.endAngle);
                ax.endAngleSet = true;
            }
            ax.clockwise = a.Bool("clockwise", ax.clockwise);
        }
        JsonValue da = a.Get("data");
        if (da != null && da.IsArray()) {
            ax.type = ChartAxisType.Category;
            for (int i = 0; i < da.Count(); i = i + 1) {
                ax.cats.Add(da.At(i).AsString(""));
            }
        }
        JsonValue bg = a.Get("boundaryGap");
        if (bg != null && bg.IsBool()) { ax.boundaryGap = bg.AsBool(true); }
        List<PolarAxisSpec> into = isAngle ? o.angleAxes : o.radiusAxes;
        while (into.Count < ax.polarIndex) { into.Add(PolarAxisSpec.Of(isAngle)); }
        if (into.Count == ax.polarIndex) { into.Add(ax); } else { into[ax.polarIndex] = ax; }
    }

    static void ParseGeoOne(JsonValue g, ChartOption o, int index) {
        if (g == null || !g.IsObject()) { return; }
        ChartGeo geo = ChartGeo.Of();
        geo.map = g.Str("map", "");
        if (geo.map.Length == 0) { return; }
        geo.roam = g.Bool("roam", false);
        geo.labelShow = g.Bool("labelShow", false);
        geo.selectedMode = ChartKinds.SelectedModeSanitize(
            g.Str("selectedMode", ""));
        JsonValue its = g.Get("itemStyle");
        if (its != null && its.IsObject()) {
            geo.areaColor = ChartOption.ParseColor(its.Get("areaColor"), 0);
            geo.borderColor = ChartOption.ParseColor(its.Get("borderColor"), 0);
        }
        JsonValue lb = g.Get("label");
        if (lb != null && lb.IsObject()) {
            geo.labelShow = lb.Bool("show", geo.labelShow);
            // A14：geo.label 的 textBorder*/textShadow*（emphasis/select
            // 层由 labelSt 同表覆盖近似——状态切换在 hover 才可见，
            // 静帧取顶层声明）。
            ChartTextStyle gst = ChartTextStyle.Create();
            ChartOption.ParseTextStyle(lb, gst);
            if (gst.tbColor != 0 || gst.tbWidth >= 0 || gst.tsColor != 0) {
                geo.labelSt = gst;
            }
        }
        ChartOption.ParseRegions(g.Get("regions"), geo.regions);
        while (o.geos.Count < index) {
            o.geos.Add(ChartGeo.Of());
        }
        if (o.geos.Count == index) { o.geos.Add(geo); } else { o.geos[index] = geo; }
        if (geo.roam) { o.roam = true; }
    }

    /// ECharts series.markLine：{data:[{type:'average'}|{yAxis:3}
    /// |[{xAxis,yAxis},{xAxis,yAxis}], label|name]}。也吃裸数组。
    /// markLine 两点形式的单点坐标：{coord:[x,y]} 优先，退回
    /// {xAxis,xValue} / {yAxis,yValue} 字段。
    static int MarkCoordX(JsonValue p, int dft) {
        if (p == null || !p.IsObject()) { return dft; }
        JsonValue cd = p.Get("coord");
        if (cd != null && cd.IsArray() && cd.Count() > 0) {
            return cd.At(0).AsInt(dft);
        }
        return p.Int("xAxis", p.Int("xValue", dft));
    }

    static int MarkCoordY(JsonValue p, int dft) {
        if (p == null || !p.IsObject()) { return dft; }
        JsonValue cd = p.Get("coord");
        if (cd != null && cd.IsArray() && cd.Count() > 1) {
            return cd.At(1).AsInt(dft);
        }
        return p.Int("yAxis", p.Int("yValue", dft));
    }

    static void ParseMarkLines(JsonValue v, List<ChartMarkLine> into) {
        if (v == null) { return; }
        JsonValue data = v;
        // markLine 级 label.show 与 symbol:['none','arrow'|'none']：
        // 作用于全部 data 项（ECharts 语义）。
        bool lvlLabelShow = true;
        bool symStart = false;
        bool symEnd = true;
        if (v.IsObject()) {
            JsonValue llb = v.Get("label");
            if (llb != null && llb.IsObject() && llb.Has("show")) {
                lvlLabelShow = llb.Bool("show", true);
            }
            JsonValue sym = v.Get("symbol");
            if (sym != null && sym.IsArray()) {
                symEnd = false;
                if (sym.Count() > 0 && sym.At(0).AsString("") == "arrow") { symStart = true; }
                if (sym.Count() > 1 && sym.At(1).AsString("") == "arrow") { symEnd = true; }
            }
        }
        if (v.IsObject()) { data = v.Get("data"); }
        if (data == null || !data.IsArray()) { return; }
        for (int i = 0; i < data.Count(); i = i + 1) {
            JsonValue it = data.At(i);
            if (it.IsArray() && it.Count() >= 2) {
                // 两点斜线：[{coord:[x,y]}|{xAxis,yAxis}, ...]——回归/
                // 趋势线（anscombe 四重奏）。label/lineStyle 配置在首
                // 点对象上；缺终点退回单点水平线近似。
                JsonValue p0 = it.At(0);
                JsonValue p1 = it.Count() > 1 ? it.At(1) : null;
                ChartMarkLine m = ChartMarkLine.Of("");
                m.hasPoint = true;
                m.xValue = ChartOption.MarkCoordX(p0, 0);
                m.yValue = ChartOption.MarkCoordY(p0, 0);
                if (p1 != null && p1.IsObject()) {
                    m.hasEnd = true;
                    m.x2Value = ChartOption.MarkCoordX(p1, m.xValue);
                    m.y2Value = ChartOption.MarkCoordY(p1, m.yValue);
                    JsonValue plb = p0.Get("label");
                    if (plb != null && plb.IsObject()) {
                        m.label = plb.Str("formatter", "");
                    }
                    JsonValue pls = p0.Get("lineStyle");
                    if (pls != null && pls.IsObject()) {
                        m.lineType = pls.Str("type", "");
                        JsonValue plc = pls.Get("color");
                        if (plc != null) { m.color = ChartOption.ParseColor(plc, 0); }
                    }
                }
                m.labelShow = lvlLabelShow; m.startArrow = symStart; m.endArrow = symEnd;
                into.Add(m);
                continue;
            }
            if (!it.IsObject()) { continue; }
            string kind = it.Str("type", it.Str("kind", ""));
            ChartMarkLine m;
            if (kind == "average" || kind == "min" || kind == "max") {
                m = ChartMarkLine.Of(kind);
            } else {
                m = ChartMarkLine.Of("");
                if (it.Has("xAxis") && !it.Has("yAxis") && !it.Has("value")
                    && !it.Has("yValue")) {
                    // {xAxis:n}：类目/数值 x 处的竖直标注线
                    // （area-pieces 的区间分隔线）。
                    m.valueIndex = 0;
                    m.xValue = it.Int("xAxis", 0);
                } else {
                    m.yValue = it.Int("yAxis", it.Int("value", it.Int("yValue", 0)));
                }
            }
            m.labelShow = lvlLabelShow; m.startArrow = symStart; m.endArrow = symEnd;
            m.label = it.Str("label", it.Str("name", ""));
            if (m.label.Length == 0) {
                JsonValue lb = it.Get("label");
                if (lb != null && lb.IsObject()) { m.label = lb.Str("formatter", ""); }
            }
            JsonValue ilb = it.Get("label");
            if (ilb != null && ilb.IsObject() && ilb.Has("show")) {
                m.labelShow = ilb.Bool("show", true);
            }
            JsonValue ls = it.Get("lineStyle");
            if (ls != null && ls.IsObject()) {
                m.lineType = ls.Str("type", "");
                JsonValue lc = ls.Get("color");
                if (lc != null) { m.color = ChartOption.ParseColor(lc, 0); }
            }
            // ECharts itemStyle.normal.color（2.x 标注线常用色）。
            JsonValue ist = it.Get("itemStyle");
            if (ist != null && ist.IsObject()) {
                JsonValue nrm = ist.Get("normal");
                JsonValue csrc = nrm != null ? nrm.Get("color") : ist.Get("color");
                if (csrc != null) { m.color = ChartOption.ParseColor(csrc, m.color); }
            }
            if (it.Has("valueIndex")) { m.valueIndex = it.Int("valueIndex", 0 - 1); }
            into.Add(m);
        }
    }

    /// 位置值：数字 = 像素，"N%" = 面板百分比，center/middle = 居中。
    static void ParseTitlePos(JsonValue v, string key, ChartTitleSpec ts, bool isTop) {
        if (!v.Has(key)) { return; }
        JsonValue pv = v.Get(key);
        if (pv != null && pv.IsNumber()) {
            if (isTop) { ts.topPx = pv.AsInt(0 - 1); } else { ts.leftPx = pv.AsInt(0 - 1); }
            return;
        }
        string sv = pv == null ? "" : pv.AsString("");
        if (sv.EndsWith("%")) {
            int pct = Convert.ToInt(sv.Substring(0, sv.Length - 1));
            if (isTop) { ts.topPct = pct; } else { ts.leftPct = pct; }
        } else if (sv == "center" || sv == "middle") {
            if (isTop) { ts.topPct = 50; } else { ts.align = "center"; }
        } else if (sv == "right") {
            if (!isTop) { ts.align = "right"; }
        }
    }

    static ChartTitleSpec ParseTitleOne(JsonValue tit) {
        ChartTitleSpec ts = ChartTitleSpec.Of();
        ts.text = tit.Str("text", "");
        ts.sub = tit.Str("subtext", "");
        ChartOption.ParseTitlePos(tit, "top", ts, true);
        ChartOption.ParseTitlePos(tit, "left", ts, false);
        return ts;
    }

    /// calendar 单项。range 归一化到天序区间，cellSize 归一化到 cellW/cellH
    /// （-1 = auto）；显式 width/height 或 left+right / top+bottom 会把对应
    /// 维强制 auto（官方 mergeAndNormalizeLayoutParams 的 sizeCalculable）。
    static ChartCalendarSpec ParseCalendarOne(JsonValue it) {
        ChartCalendarSpec c = ChartCalendarSpec.Of();
        c.vertical = it.Str("orient", "horizontal") == "vertical";

        // ---- range ----
        JsonValue rv = it.Get("range");
        if (rv != null) {
            string rs0 = "";
            string rs1 = "";
            bool isArr = rv.IsArray();
            if (isArr) {
                if (rv.Count() > 0) { rs0 = rv.At(0).AsString(""); }
                if (rv.Count() > 1) { rs1 = rv.At(1).AsString(""); }
                else { rs1 = rs0; }
            } else {
                rs0 = rv.AsString("");
                rs1 = rs0;
            }
            int t0 = ChartOption.ParseDateDay(rs0, 0 - 1);
            int t1 = t0;
            if (!isArr && ChartOption.IsYearOnly(rs0)) {
                // "2017" -> 整年（官方 _initRangeOption）
                int yy = Convert.ToInt(rs0);
                t0 = DateTime.DaysFromCivil(yy, 1, 1);
                t1 = DateTime.DaysFromCivil(yy, 12, 31);
            } else if (!isArr && ChartOption.IsYearMonthOnly(rs0)) {
                // "2017-2" -> 整月
                int sl = rs0.IndexOf("-");
                if (sl < 0) { sl = rs0.IndexOf("/"); }
                int yy = Convert.ToInt(rs0.Substring(0, sl));
                int mm = Convert.ToInt(rs0.Substring(sl + 1));
                if (mm < 1) { mm = 1; }
                if (mm > 12) { mm = 12; }
                t0 = DateTime.DaysFromCivil(yy, mm, 1);
                t1 = DateTime.DaysFromCivil(yy, mm,
                                            DateTime.DaysInMonth(yy, mm));
            } else if (isArr && rs1 != rs0) {
                t1 = ChartOption.ParseDateDay(rs1, t0);
                // 数组两端也允许缩写（["2017-02","2017-03-31"] 的左端）
                if (ChartOption.IsYearOnly(rs0)) {
                    int yy = Convert.ToInt(rs0);
                    t0 = DateTime.DaysFromCivil(yy, 1, 1);
                } else if (ChartOption.IsYearMonthOnly(rs0)) {
                    int sl = rs0.IndexOf("-");
                    if (sl < 0) { sl = rs0.IndexOf("/"); }
                    int yy = Convert.ToInt(rs0.Substring(0, sl));
                    int mm = Convert.ToInt(rs0.Substring(sl + 1));
                    if (mm < 1) { mm = 1; }
                    if (mm > 12) { mm = 12; }
                    t0 = DateTime.DaysFromCivil(yy, mm, 1);
                }
            }
            if (t0 >= 0 && t1 >= 0) {
                if (t0 <= t1) { c.rangeT0 = t0; c.rangeT1 = t1; }
                else { c.rangeT0 = t1; c.rangeT1 = t0; }
            }
        }

        // ---- 盒模型锚（官方默认 left 80 / top 60）----
        // 支持三种形态：
        //   数值 / 数字串      -> 边距像素（hasXxx = true, xxxCenter = false）
        //   "center"/"middle"  -> 该维居中（xxxCenter = true，渲染器算偏移）
        //   "N%"               -> 本引擎按未声明处理（回落默认锚）
        string[] anks = new string[] { "left", "right", "top", "bottom" };
        for (int ai = 0; ai < anks.Length; ai = ai + 1) {
            if (!it.Has(anks[ai])) { continue; }
            JsonValue av = it.Get(anks[ai]);
            int ax = 0 - 1;
            bool isCenter = false;
            if (av != null && av.IsNumber()) { ax = av.AsInt(0 - 1); }
            else if (av != null && av.IsString()) {
                string sv = av.AsString("");
                if (sv == "center" || sv == "middle") { isCenter = true; }
                else if (sv.EndsWith("%")) { continue; }
                else if (!ChartOption.AllDigits(sv)) { continue; }
                else { ax = Convert.ToInt(sv); }
            }
            if (!isCenter && ax < 0) { continue; }
            // "center"/"middle" 覆盖默认锚（Of() 里 left/top 默认 = 80/60
            // 且 hasXxx = true）。必须把同维的 hasXxx 清掉，否则渲染器会
            // 先按 80 摆再被 center 覆盖，default 值仍然参与 width 推导
            //（left+right 判据），居中日历会算错位。
            if (anks[ai] == "left") {
                if (isCenter) { c.leftCenter = true; c.hasLeft = false; c.leftPx = 0; }
                else { c.leftPx = ax; c.hasLeft = true; c.leftCenter = false; }
            } else if (anks[ai] == "right") {
                if (isCenter) { c.rightCenter = true; c.hasRight = false; c.rightPx = 0; }
                else { c.rightPx = ax; c.hasRight = true; c.rightCenter = false; }
            } else if (anks[ai] == "top") {
                if (isCenter) { c.topCenter = true; c.hasTop = false; c.topPx = 0; }
                else { c.topPx = ax; c.hasTop = true; c.topCenter = false; }
            } else {
                if (isCenter) { c.bottomCenter = true; c.hasBottom = false; c.bottomPx = 0; }
                else { c.bottomPx = ax; c.hasBottom = true; c.bottomCenter = false; }
            }
        }
        if (it.Has("width")) {
            JsonValue wv = it.Get("width");
            if (wv != null && wv.IsNumber()) { c.widthPx = wv.AsInt(0 - 1); }
        }
        if (it.Has("height")) {
            JsonValue hv = it.Get("height");
            if (hv != null && hv.IsNumber()) { c.heightPx = hv.AsInt(0 - 1); }
        }

        // ---- cellSize（官方默认 20；数字 -> 两维同；数组 -> [w,h]）----
        JsonValue cv = it.Get("cellSize");
        int cw = 0 - 1;
        int chh = 0 - 1;
        if (cv != null && cv.IsArray()) {
            cw = ChartOption.CellSizeOf(cv.At(0));
            if (cv.Count() > 1) { chh = ChartOption.CellSizeOf(cv.At(1)); }
            else { chh = cw; }
        } else if (cv != null) {
            cw = ChartOption.CellSizeOf(cv);
            chh = cw;
        } else {
            cw = 20; chh = 20;
        }
        // sizeCalculable：显式 width/height 或 left+right / top+bottom 时该维 auto
        if (c.widthPx >= 0 || (c.hasLeft && c.hasRight)) { cw = 0 - 1; }
        if (c.heightPx >= 0 || (c.hasTop && c.hasBottom)) { chh = 0 - 1; }
        c.cellW = cw;
        c.cellH = chh;

        // ---- itemStyle ----
        JsonValue isv = it.Get("itemStyle");
        if (isv != null && isv.IsObject()) {
            if (isv.Has("borderWidth")) {
                JsonValue bwv = isv.Get("borderWidth");
                if (bwv != null && bwv.IsNumber()) { c.itemBorderWidth = bwv.AsInt(0); }
            }
            c.itemColor = ChartOption.ParseColor(isv.Get("color"), 0);
            c.itemBorderColor = ChartOption.ParseColor(isv.Get("borderColor"), 0);
        }

        // ---- splitLine ----
        JsonValue slv = it.Get("splitLine");
        if (slv != null && slv.IsObject()) {
            c.showSplitLine = slv.Bool("show", true);
            JsonValue lsv = slv.Get("lineStyle");
            if (lsv != null && lsv.IsObject()) {
                c.splitColor = ChartOption.ParseColor(lsv.Get("color"), 0);
                JsonValue swv = lsv.Get("width");
                if (swv != null && swv.IsNumber()) { c.splitWidth = swv.AsInt(1); }
            }
        }

        // ---- dayLabel / monthLabel / yearLabel ----
        JsonValue dl = it.Get("dayLabel");
        if (dl != null && dl.IsObject()) {
            c.showDayLabel = dl.Bool("show", true);
            c.dayMargin = dl.Int("margin", c.dayMargin);
            c.dayPos = dl.Str("position", c.dayPos);
            c.dayFirstDay = dl.Int("firstDay", c.dayFirstDay);
            c.dayNameMap = ChartOption.NameMapOf(dl.Get("nameMap"));
            c.dayColor = ChartOption.ParseColor(dl.Get("color"), 0);
            c.dayFontSize = ChartOption.FontSizeOf(dl.Get("fontSize"), c.dayFontSize);
        }
        JsonValue ml = it.Get("monthLabel");
        if (ml != null && ml.IsObject()) {
            c.showMonthLabel = ml.Bool("show", true);
            c.monthMargin = ml.Int("margin", c.monthMargin);
            c.monthPos = ml.Str("position", c.monthPos);
            c.monthAlign = ml.Str("align", c.monthAlign);
            c.monthNameMap = ChartOption.NameMapOf(ml.Get("nameMap"));
            c.monthColor = ChartOption.ParseColor(ml.Get("color"), 0);
            c.monthFontSize = ChartOption.FontSizeOf(ml.Get("fontSize"), c.monthFontSize);
        }
        JsonValue yl = it.Get("yearLabel");
        if (yl != null && yl.IsObject()) {
            c.showYearLabel = yl.Bool("show", true);
            c.yearMargin = yl.Int("margin", c.yearMargin);
            c.yearPos = yl.Str("position", c.yearPos);
            c.yearFormatter = yl.Str("formatter", c.yearFormatter);
            c.yearColor = ChartOption.ParseColor(yl.Get("color"), 0);
            c.yearFontSize = ChartOption.FontSizeOf(yl.Get("fontSize"), c.yearFontSize);
        }
        return c;
    }

    /// 解析 calendar（对象或数组，逐项调 ParseCalendarOne）。
    static void ParseCalendar(JsonValue v, ChartOption o) {
        if (v == null) { return; }
        if (v.IsArray()) {
            for (int i = 0; i < v.Count(); i = i + 1) {
                if (v.At(i) != null && v.At(i).IsObject()) {
                    o.calendars.Add(ChartOption.ParseCalendarOne(v.At(i)));
                }
            }
            return;
        }
        if (v.IsObject()) { o.calendars.Add(ChartOption.ParseCalendarOne(v)); }
    }

    /// cellSize 单项：数字 -> 值（<=0 视作 auto）；"auto"/其它 -> -1。
    static int CellSizeOf(JsonValue v) {
        if (v == null) { return 0 - 1; }
        if (v.IsNumber()) {
            int px = v.AsInt(0 - 1);
            if (px <= 0) { return 0 - 1; }
            return px;
        }
        return 0 - 1;
    }

    /// nameMap：字符串（"cn"）原样；数组 -> 逗号拼接；其它 -> ""。
    static string NameMapOf(JsonValue v) {
        if (v == null) { return ""; }
        if (v.IsString()) { return v.AsString(""); }
        if (!v.IsArray()) { return ""; }
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < v.Count(); i = i + 1) {
            if (i > 0) { sb.Append(","); }
            sb.Append(v.At(i).AsString(""));
        }
        return sb.ToString();
    }

    /// fontSize 解析：数字取整；数字字符串也接受；否则 dflt。
    static int FontSizeOf(JsonValue v, int dflt) {
        if (v == null) { return dflt; }
        if (v.IsNumber()) { return v.AsInt(dflt); }
        if (v.IsString()) {
            string sv = v.AsString("");
            if (ChartOption.AllDigits(sv)) { return Convert.ToInt(sv); }
        }
        return dflt;
    }

    /// "2017" / "2017-02" / "2017/2/1" / "2017-02-01" -> 天序；
    /// 无法解析 -> dflt。也接受纯天序数字（官方允许 time 数值）。
    static int ParseDateDay(string s, int dflt) {
        if (s == "") { return dflt; }
        int dash = s.IndexOf("-");
        if (dash < 0) { dash = s.IndexOf("/"); }
        if (dash < 0) {
            if (!ChartOption.AllDigits(s)) { return dflt; }
            return Convert.ToInt(s);
        }
        if (!ChartOption.AllDigits(s.Substring(0, dash))) { return dflt; }
        int y = Convert.ToInt(s.Substring(0, dash));
        int rest = dash + 1;
        int dash2 = s.IndexOf("-", rest);
        if (dash2 < 0) { dash2 = s.IndexOf("/", rest); }
        int mo = 1;
        int da = 1;
        if (dash2 < 0) {
            if (!ChartOption.AllDigits(s.Substring(rest))) { return dflt; }
            mo = Convert.ToInt(s.Substring(rest));
        } else {
            string ms = s.Substring(rest, dash2 - rest);
            string ds = s.Substring(dash2 + 1);
            if (!ChartOption.AllDigits(ms) || !ChartOption.AllDigits(ds)) {
                return dflt;
            }
            mo = Convert.ToInt(ms);
            da = Convert.ToInt(ds);
        }
        if (mo < 1) { mo = 1; }
        if (mo > 12) { mo = 12; }
        if (da < 1) { da = 1; }
        int dim = DateTime.DaysInMonth(y, mo);
        if (da > dim) { da = dim; }
        return DateTime.DaysFromCivil(y, mo, da);
    }

    /// range 字符串形如 "2017"（4 位纯年）。
    static bool IsYearOnly(string s) {
        if (s.Length != 4) { return false; }
        return ChartOption.AllDigits(s);
    }

    /// range 字符串形如 "2017-2" / "2017/02"（年月，无日）。
    static bool IsYearMonthOnly(string s) {
        int dash = s.IndexOf("-");
        if (dash < 0) { dash = s.IndexOf("/"); }
        if (dash <= 0) { return false; }
        if (s.IndexOf("-", dash + 1) >= 0) { return false; }
        if (s.IndexOf("/", dash + 1) >= 0) { return false; }
        return ChartOption.AllDigits(s.Substring(0, dash))
            && ChartOption.AllDigits(s.Substring(dash + 1));
    }

    /// 全数字串（非空）。
    static bool AllDigits(string s) {
        if (s.Length == 0) { return false; }
        for (int i = 0; i < s.Length; i = i + 1) {
            char ch = s[i];
            if (ch < '0' || ch > '9') { return false; }
        }
        return true;
    }

    /// grid 数组单项：四边 inset 解析（数字 px / "N%" pct）。
    static ChartGridSpec ParseGridOne(JsonValue it) {
        ChartGridSpec gs = ChartGridSpec.Of();
        gs.containLabel = it.Bool("containLabel", false);
        string[] keys = new string[] { "left", "top", "right", "bottom",
                                       "width", "height" };
        for (int ki = 0; ki < keys.Length; ki = ki + 1) {
            if (!it.Has(keys[ki])) { continue; }
            JsonValue pv = it.Get(keys[ki]);
            int pct = 0 - 1;
            int px = 0 - 1;
            if (pv != null && pv.IsNumber()) { px = pv.AsInt(0 - 1); }
            else {
                string sv = pv == null ? "" : pv.AsString("");
                if (sv.EndsWith("%")) { pct = Convert.ToInt(sv.Substring(0, sv.Length - 1)); }
                else if (pv != null) { px = pv.AsInt(0 - 1); }
            }
            if (keys[ki] == "left") { gs.lPct = pct; gs.lPx = px; }
            else if (keys[ki] == "top") { gs.tPct = pct; gs.tPx = px; }
            else if (keys[ki] == "right") { gs.rPct = pct; gs.rPx = px; }
            else if (keys[ki] == "bottom") { gs.bPct = pct; gs.bPx = px; }
            else if (keys[ki] == "width") { gs.wPct = pct; gs.wPx = px; }
            else { gs.hPct = pct; gs.hPx = px; }
        }
        return gs;
    }

    /// 解析 visualMap（对象或数组，逐项调 ParseVisualMapOne）。
    static void ParseVisualMap(JsonValue v, List<ChartVisualMap> into) {
        if (v == null) { return; }
        if (v.IsArray()) {
            for (int i = 0; i < v.Count(); i = i + 1) {
                ChartOption.ParseVisualMapOne(v.At(i), into);
            }
            return;
        }
        ChartOption.ParseVisualMapOne(v, into);
    }

    static void ParseVisualMapOne(JsonValue v, List<ChartVisualMap> into) {
        if (v == null || !v.IsObject()) { return; }
        ChartVisualMap vm = ChartVisualMap.Of();
        // ECharts：写 pieces 即隐式 piecewise（无 type 字段同理）。
        vm.type = v.Str("type", v.Has("pieces") ? "piecewise" : "continuous")
            == "piecewise" ? 1 : 0;
        vm.show = v.Bool("show", true);
        vm.dimension = v.Int("dimension", 0 - 1);
        vm.seriesIndex = v.Int("seriesIndex", 0 - 1);
        if (v.Has("min")) {
            vm.hasMin = true;
            double mn = v.Double("min", 0.0);
            vm.minV = (int)(mn * 1000.0 + 0.5);
            vm.minRaw = ChartOption.RawBound(mn);
        }
        if (v.Has("max")) {
            vm.hasMax = true;
            double mx = v.Double("max", 0.0);
            vm.maxV = (int)(mx * 1000.0 + 0.5);
            vm.maxRaw = ChartOption.RawBound(mx);
        }
        JsonValue cl = null;
        JsonValue ir = v.Get("inRange");
        if (ir != null && ir.IsObject()) {
            cl = ir.Get("color");
            // inRange.opacity（0..1）按 0..1000 千分位定点记录（与
            // App.ScaleAlpha 同刻度）：官方 lunar 用 0.3 让 heatmap
            // 半透明，底下的格线与上面的农历日名都可见。
            if (ir.Has("opacity")) {
                double iop = ir.Double("opacity", 1.0);
                if (iop < 0.0) { iop = 0.0; }
                if (iop > 1.0) { iop = 1.0; }
                vm.inOpacity = (int)(iop * 1000.0 + 0.5);
            }
        }
        if (cl == null) { cl = v.Get("color"); }  // 2.x dataRange 遗留
        if (cl != null) { vm.colorsExplicit = true; }
        if (cl != null && cl.IsArray()) {
            for (int i = 0; i < cl.Count(); i = i + 1) {
                vm.rangeColors.Add(ChartOption.ParseColor(cl.At(i), 0));
            }
        } else if (cl != null) {
            vm.rangeColors.Add(ChartOption.ParseColor(cl, 0));
        }
        // piecewise 类目模式：categories + inRange.color 等长一一
        // 对应（官方 nutrients 的 25 组彩虹着色）。
        JsonValue cjs = v.Get("categories");
        if (cjs != null && cjs.IsArray()) {
            for (int i = 0; i < cjs.Count(); i = i + 1) {
                vm.vmCats.Add(cjs.At(i).AsString(""));
            }
        }
        JsonValue pcs = v.Get("pieces");
        if (pcs != null && pcs.IsArray()) {
            for (int i = 0; i < pcs.Count(); i = i + 1) {
                JsonValue pi = pcs.At(i);
                if (!pi.IsObject()) { continue; }
                ChartVisualPiece p = ChartVisualPiece.Of();
                p.color = ChartOption.ParseColor(pi.Get("color"), 0);
                p.label = pi.Str("label", "");
                if (pi.Has("gt")) { p.hasLo = true; p.lo = pi.Int("gt", 0); p.loIncl = false; }
                if (pi.Has("gte")) { p.hasLo = true; p.lo = pi.Int("gte", 0); p.loIncl = true; }
                if (pi.Has("lt")) { p.hasHi = true; p.hi = pi.Int("lt", 0); p.hiIncl = false; }
                if (pi.Has("lte")) { p.hasHi = true; p.hi = pi.Int("lte", 0); p.hiIncl = true; }
                if (pi.Has("value")) { p.hasEq = true; p.eq = pi.Int("value", 0); }
                if (pi.Has("eq")) { p.hasEq = true; p.eq = pi.Int("eq", 0); }
                vm.pieces.Add(p);
            }
        }
        if (vm.type == 0 && vm.rangeColors.Count == 0) {
            // ECharts visualMap continuous 缺省 inRange 色带
            // （visualMap-continuous defaultOption.color）。
            string[] ramp = new string[] { "#313695", "#4575b4", "#74add1",
                "#abd9e9", "#e0f3f8", "#ffffbf", "#fee090", "#fdae61",
                "#f46d43", "#d73027", "#a50026" };
            for (int ri3 = 0; ri3 < ramp.Length; ri3 = ri3 + 1) {
                vm.rangeColors.Add(StyleSheet.ParseColor(ramp[ri3]));
            }
        }
        into.Add(vm);
    }

    /// 两色中点插值（tF 0..1000）。
    static int Lerp2(int a, int b, int tF) {
        List<int> two = new List<int>();
        two.Add(a); two.Add(b);
        return ChartVisualMap.Lerp(two, tF);
    }

    /// dimension 0（类目序号域）上子段区间 [k0,k1] 与 piece 区间
    /// 的重叠命中——ECharts 的 piece 是 x 域范围而非逐点判定，
    /// area-pieces 的 (1,3) 段同时覆盖 1-2、2-3 两个子段。返回 0
    /// 表示未命中。
    static int VisualSegmentColorAt(ChartOption o, int seriesIndex, int k0, int k1) {
        for (int i = 0; i < o.visualMaps.Count; i = i + 1) {
            ChartVisualMap vm = o.visualMaps[i];
            if (vm.seriesIndex != 0 - 1 && vm.seriesIndex != seriesIndex) { continue; }
            if (vm.dimension > 0) { continue; }  // 值域判定走 VisualColorAt
            if (vm.type != 1) { continue; }
            for (int k = 0; k < vm.pieces.Count; k = k + 1) {
                ChartVisualPiece p = vm.pieces[k];
                if (p.color == 0) { continue; }
                if (p.hasEq) {
                    if (k0 <= p.eq && p.eq <= k1) { return p.color; }
                    continue;
                }
                if (!p.hasLo && !p.hasHi) { continue; }
                bool ok = true;
                if (p.hasLo) { ok = p.loIncl ? k1 >= p.lo : k1 > p.lo; }
                if (ok && p.hasHi) { ok = p.hiIncl ? k0 <= p.hi : k0 < p.hi; }
                if (ok) { return p.color; }
            }
        }
        return 0;
    }

    /// visualMap 对某系列第 absIdx 个数据项的颜色覆盖（dimension
    /// 0 = 类目序号，1 = 数据值 val）；未命中返回 0。
    static int VisualColorAt(ChartOption o, int seriesIndex, int absIdx, int val) {
        for (int i = 0; i < o.visualMaps.Count; i = i + 1) {
            ChartVisualMap vm = o.visualMaps[i];
            // 仅 -1 是"全部系列"通配；多 grid 重映射用 -999 屏蔽。
            if (vm.seriesIndex != 0 - 1 && vm.seriesIndex != seriesIndex) { continue; }
            // dimension 缺省取数据值域（ECharts 取最后一维：单值
            // 数据即 y 值）；显式 0 = 类目序号，1 = 数据值。
            int dim = vm.dimension;
            int probe = dim == 0 ? absIdx : val;
            if (vm.type == 1) {
                for (int k = 0; k < vm.pieces.Count; k = k + 1) {
                    ChartVisualPiece p = vm.pieces[k];
                    if (p.color != 0 && p.Hit(probe)) { return p.color; }
                }
            } else if (vm.rangeColors.Count > 0
                && vm.hasMin && vm.hasMax && vm.maxV > vm.minV) {
                int pf = probe * 1000;
                int tF = (int)(((long)(pf - vm.minV)) * 1000L / (long)(vm.maxV - vm.minV));
                return ChartVisualMap.Lerp(vm.rangeColors, tF);
            }
        }
        return 0;
    }

    /// 解析 markPoint.data：{type:"max"|"min"} 或显式
    /// {xAxis,yAxis|dataIndex,name}；label/color 可选。
    static void ParseMarks(JsonValue v, List<ChartMarkPoint> into) {
        if (v == null || !v.IsObject()) { return; }
        JsonValue data = v.Get("data");
        if (data == null || !data.IsArray()) { return; }
        for (int i = 0; i < data.Count(); i = i + 1) {
            JsonValue it = data.At(i);
            if (!it.IsObject()) { continue; }
            string kind = it.Str("type", it.Str("kind", ""));
            ChartMarkPoint m;
            if (kind == "max") { m = ChartMarkPoint.Max(); }
            else if (kind == "min") { m = ChartMarkPoint.Min(); }
            else {
                m = ChartMarkPoint.Point(it.Int("xAxis", it.Int("xValue", 0)),
                    it.Int("yAxis", it.Int("yValue", 0)), it.Str("name", ""));
                if (it.Has("dataIndex")) { m.dataIndex = it.Int("dataIndex", 0 - 1); }
            }
            if (it.Has("color")) { m.color = ChartOption.ParseColor(it.Get("color"), 0); }
            if (it.Has("label")) { m.label = it.Str("label", it.Str("name", "")); }
            m.valueIndex = it.Int("valueIndex", 0 - 1);
            into.Add(m);
        }
    }

    /// 解析整个 option 文档为 ChartOption：title/subtitle、grid、
    /// dataZoom、legend、dataRange、tooltip、connectGroup、markLine/
    /// markPoint/markArea、radar、xAxis/yAxis（对象或数组）与
    /// series 数组；未知字段忽略，缺省字段保持 Create() 默认。
    /// 用户声明的 map 系列是否存在（geo 合成载体系列不算）。
    static bool HasUserMapSeries(ChartOption o) {
        for (int i = 0; i < o.series.Count; i = i + 1) {
            if (o.series[i].type == ChartType.Map && !o.series[i].isGeoBase) {
                return true;
            }
        }
        return false;
    }

    static ChartOption FromJsonValue(JsonValue v) {
        ChartOption o = ChartOption.Create();
        if (v == null) { return o; }
        // ECharts timeline/media 顶层形态：顶层没有 series 而
        // baseOption + options[] 在。取 baseOption 骨架，并入
        // options 首项的系列（时间轴第一帧）；media 查询忽略。
        if (v.Get("series") == null && v.Get("baseOption") != null) {
            ChartOption base0 = ChartOption.FromJsonValue(v.Get("baseOption"));
            JsonValue opts = v.Get("options");
            if (opts != null && opts.IsArray() && opts.Count() > 0) {
                ChartOption step0 = ChartOption.FromJsonValue(opts.At(0));
                for (int so = 0; so < step0.series.Count; so = so + 1) {
                    base0.series.Add(ChartSeries.Clone(step0.series[so]));
                }
            }
            return base0;
        }
        JsonValue tj = v.Get("title");
        if (tj != null && tj.IsArray()) {
            // title 数组（line-gradient 双标题）：逐项位置/文本。
            for (int tji = 0; tji < tj.Count(); tji = tji + 1) {
                JsonValue tit = tj.At(tji);
                if (!tit.IsObject()) { continue; }
                ChartTitleSpec ts = ChartOption.ParseTitleOne(tit);
                o.titles.Add(ts);
            }
        } else if (tj != null && tj.IsObject()) {
            o.title = tj.Str("text", "");
            o.titleSub = tj.Str("subtext", "");
            // ECharts 6 TitleModel.defaultOption: left 'center'（不是 left）。
            // left/x 只是位置表达式，官方默认居中；"left"/"right" 才是
            // 显式对齐。x 是 2.x 遗留别名，优先级低于 left。
            string tv_left = tj.Str("left", "");
            if (tv_left.Length == 0) { tv_left = tj.Str("x", ""); }
            o.titleAlign = tv_left;
            // 官方 title 字号/字重/颜色在 textStyle/subtextStyle 下；
            // 颜色可显式覆盖（0 = 用官方默认）。
            JsonValue ttsx = tj.Get("textStyle");
            if (ttsx != null && ttsx.IsObject() && ttsx.Has("color")) {
                o.titleColor = ChartOption.ParseColor(ttsx.Get("color"), 0);
            }
            JsonValue tssx = tj.Get("subtextStyle");
            if (tssx != null && tssx.IsObject() && tssx.Has("color")) {
                o.titleSubColor = ChartOption.ParseColor(tssx.Get("color"), 0);
            }
        } else {
            o.title = v.Str("title", "");
        }
        if (v.Has("backgroundColor")) { o.backgroundColor = ChartOption.ParseColor(v.Get("backgroundColor"), o.backgroundColor); }
        o.roamWheelMode = ChartKinds.RoamWheelModeSanitize(
            v.Str("roamWheelMode", o.roamWheelMode));
        ChartOption.ParseGrid(v.Get("grid"), o);
        ChartOption.ParseDataZoom(v.Get("dataZoom"), o);

        // ECharts：未声明的组件不渲染。legend/tooltip 只有 JSON
        // 真的写了才出现（对象 API 保持 Create 的 2.x 兼容默认）。
        o.showLegend = false;
        JsonValue lg = v.Get("legend");
        if (lg != null && lg.IsObject()) {
            o.showLegend = lg.Bool("show", true);
            string ori = lg.Str("orient", o.legendOrient);
            if (ori == "vertical") { o.legendOrient = "vertical"; }
            o.legendX = lg.Str("x", o.legendX);
            // 官方盒模型：left/right/top/bottom 四锚（sidePx = 0，即
            // 百分比锚在 option 载入期无容器基数，退回原始 pct 语义，
            // 由布局侧 LegendFloatLeft/Top 回填实际容器尺寸）。
            ChartOption.ParseLegendAnchor(lg, "left", false, false, o, 0);
            ChartOption.ParseLegendAnchor(lg, "right", false, true, o, 0);
            ChartOption.ParseLegendAnchor(lg, "top", true, false, o, 0);
            ChartOption.ParseLegendAnchor(lg, "bottom", true, true, o, 0);
            o.legendSelectedMode = ChartKinds.LegendModeSanitize(
                lg.Str("selectedMode", o.legendSelectedMode));
            o.legendFormatter = lg.Str("formatter", o.legendFormatter);
        }

        // dataRange（2.x）：min/max/calculable/splitNumber/data[]。
        JsonValue dr = v.Get("dataRange");
        if (dr != null && dr.IsObject()) {
            o.dataRangeShow = dr.Bool("show", true);
            if (dr.Has("min")) { o.dataRangeLo = dr.Int("min", o.dataRangeLo); }
            if (dr.Has("max")) { o.dataRangeHi = dr.Int("max", o.dataRangeHi); }
            o.dataRangeCalculable = dr.Bool("calculable", false);
            o.dataRangeHoverLink = dr.Bool("hoverLink", o.dataRangeHoverLink);
            o.dataRangeSplit = dr.Int("splitNumber", 0 - 1);
            JsonValue drd = dr.Get("data");
            if (drd != null && drd.IsArray()) {
                for (int di2 = 0; di2 < drd.Count(); di2 = di2 + 1) {
                    JsonValue e = drd.At(di2);
                    if (!e.IsObject()) { continue; }
                    int bLo = e.Has("start") ? e.Int("start", 0) : ChartOption.Auto();
                    int bHi = e.Has("end") ? e.Int("end", 0) : ChartOption.Auto();
                    o.dataRangeList.Add(ChartRangeSplit.Of(
                        e.Str("name", e.Str("label", "")), bLo, bHi));
                }
            }
            JsonValue drColors = dr.Get("color");
            if (drColors != null && drColors.IsArray() && o.rampColors.Count < 1) {
                for (int ci2 = 0; ci2 < drColors.Count(); ci2 = ci2 + 1) {
                    o.rampColors.Add(ChartOption.ParseColor(
                        drColors.At(ci2), 0));
                }
            }
        }
        // ECharts：未声明 tooltip 组件就没有提示框；trigger 记下
        // 供渲染器区分 item/axis。
        o.showTooltip = false;
        JsonValue tp = v.Get("tooltip");
        if (tp != null && tp.IsObject()) {
            o.showTooltip = tp.Bool("show", true);
            o.tooltipTrigger = tp.Str("trigger", o.tooltipTrigger);
            // triggerOn:"none"（candlestick-touch / line-draggable /
            // line-tooltip-touch）= 只由 dispatchAction 触发；引擎无
            // action 通道，等价关提示框（解析期门控，渲染零改动）。
            o.tooltipTriggerOn = tp.Str("triggerOn", o.tooltipTriggerOn);
            if (o.tooltipTriggerOn == "none") { o.showTooltip = false; }
            // tooltip.axisPointer.type:"cross"（line7 双数值轴、
            // line-polar 极坐标）：十字虚线 + 双轴值读数。
            JsonValue apj = tp.Get("axisPointer");
            if (apj != null && apj.IsObject()
                && apj.Str("type", "") == "cross") {
                o.pointerCross = true;
            }
        }
        // ECharts toolbox：声明了组件才渲染，且只渲染 feature 中
        // 声明的按钮（未声明 feature = 空工具箱）。
        JsonValue tbj = v.Get("toolbox");
        if (tbj != null && tbj.IsObject()) {
            o.toolboxShow = tbj.Bool("show", true);
            o.toolboxDataView = false; o.toolboxMagicLine = false;
            o.toolboxMagicBar = false; o.toolboxRestore = false;
            o.toolboxSave = false; o.toolboxZoom = false;
            JsonValue ftr = tbj.Get("feature");
            if (ftr != null && ftr.IsObject()) {
                o.toolboxDataView = ftr.Has("dataView");
                o.toolboxSave = ftr.Has("saveAsImage");
                o.toolboxRestore = ftr.Has("restore");
                o.toolboxZoom = ftr.Has("dataZoom");
                JsonValue mtj = ftr.Get("magicType");
                if (mtj != null && mtj.IsObject()) {
                    JsonValue mta = mtj.Get("type");
                    if (mta != null && mta.IsArray()) {
                        for (int mti = 0; mti < mta.Count(); mti = mti + 1) {
                            string mtv = mta.At(mti).AsString("");
                            if (mtv == "line") { o.toolboxMagicLine = true; }
                            if (mtv == "bar") { o.toolboxMagicBar = true; }
                        }
                    } else {
                        o.toolboxMagicLine = true; o.toolboxMagicBar = true;
                    }
                }
            }
        }
        // connect 组（ECharts connect(group)）：非 0 组号参与多图联动。
        o.connectGroup = v.Int("connectGroup", o.connectGroup);
        if (v.Has("markLine")) { o.markLine = v.Int("markLine", o.markLine); }
        // markPoint 同时支持旧 bool 形式和 ECharts 对象 {data:[...]}。
        // 对象形式的数据项解析推迟到系列构建之后（见本函数末尾），
        // 以便挂接到第一个 line/bar 系列。
        JsonValue mpj = v.Get("markPoint");
        if (mpj != null && mpj.IsObject()) { o.markPoint = true; }
        else { o.markPoint = v.Bool("markPoint", o.markPoint); }
        o.markLabel = v.Str("markLabel", o.markLabel);
        ChartOption.ParseMarkArea(v.Get("markArea"), o);

        // radar.indicator[].max -> radarMax（每轴独立满刻度）。
        JsonValue rj = v.Get("radar");
        if (rj != null && rj.IsObject()) {
            JsonValue ind = rj.Get("indicator");
            if (ind != null && ind.IsArray()) {
                for (int ri = 0; ri < ind.Count(); ri = ri + 1) {
                    JsonValue ax = ind.At(ri);
                    o.radarMax.Add(ax.Int("max", 0));
                }
            }
            string shp = rj.Str("shape", o.radarShape);
            if (shp == "polygon") { o.radarShape = "polygon"; }
            JsonValue sa = rj.Get("splitArea");
            if (sa != null && sa.IsObject()) { o.radarSplitArea = sa.Bool("show", false); }
            else { o.radarSplitArea = rj.Bool("splitArea", o.radarSplitArea); }
        }

        // ECharts2 polar[]：多雷达坐标系。radius 数组的 [min,max]
        // 形式取外径（内环雷达不支持，与单 polar 一致）。
        JsonValue pj = v.Get("polar");
        if (pj != null && pj.IsArray()) {
            for (int pi = 0; pi < pj.Count(); pi = pi + 1) {
                JsonValue ps = pj.At(pi);
                if (ps == null || !ps.IsObject()) { continue; }
                RadarPolar p = RadarPolar.Create();
                p.startAngle = ps.Int("startAngle", p.startAngle);
                p.splitNumber = ps.Int("splitNumber", p.splitNumber);
                string ptype = ps.Str("type", "");
                if (ptype == "circle" || ptype == "polygon") { p.type = ptype; }
                JsonValue pc = ps.Get("center");
                if (pc != null && pc.IsArray() && pc.Count() >= 2) {
                    p.center = ChartOption.ParsePoint(pc,
                        ChartPosition.Of(ChartScalar.Pct(50), ChartScalar.Pct(50)));
                }
                JsonValue prad = ps.Get("radius");
                if (prad != null && prad.IsArray() && prad.Count() >= 2) {
                    p.radiusInner = ChartOption.ParseScalar(prad.At(0), ChartScalar.Px(0));
                    p.radius = ChartOption.ParseScalar(prad.At(1), ChartScalar.Px(0));
                } else if (prad != null) {
                    p.radius = ChartOption.ParseScalar(prad, ChartScalar.Px(0));
                }
                JsonValue ind = ps.Get("indicator");
                if (ind != null && ind.IsArray()) {
                    for (int ii = 0; ii < ind.Count(); ii = ii + 1) {
                        JsonValue ax = ind.At(ii);
                        p.indicatorText.Add(ax.Str("text", ""));
                        p.indicatorMax.Add(ax.Int("max", 0));
                    }
                }
                JsonValue nm = ps.Get("name");
                if (nm != null && nm.IsObject()) {
                    string fmt = nm.Str("formatter", "");
                    if (fmt.Length > 0) { p.nameFormat = fmt; }
                    JsonValue nts = nm.Get("textStyle");
                    if (nts != null && nts.IsObject()) {
                        p.nameColor = ChartOption.ParseColor(nts.Get("color"), p.nameColor);
                    }
                }
                JsonValue pal = ps.Get("axisLine");
                if (pal != null && pal.IsObject()) {
                    JsonValue pls = pal.Get("lineStyle");
                    if (pls != null && pls.IsObject()) {
                        p.axisLineColor = ChartOption.ParseColor(pls.Get("color"), p.axisLineColor);
                        p.axisLineWidth = pls.Int("width", p.axisLineWidth);
                    }
                }
                JsonValue psl = ps.Get("splitLine");
                if (psl != null && psl.IsObject()) {
                    JsonValue psls = psl.Get("lineStyle");
                    if (psls != null && psls.IsObject()) {
                        p.splitLineColor = ChartOption.ParseColor(psls.Get("color"), p.splitLineColor);
                        p.splitLineWidth = psls.Int("width", p.splitLineWidth);
                    }
                }
                JsonValue psa = ps.Get("splitArea");
                if (psa != null && psa.IsObject()) {
                    JsonValue pas = psa.Get("areaStyle");
                    if (pas != null && pas.IsObject()) {
                        JsonValue pac = pas.Get("color");
                        if (pac != null && pac.IsArray()) {
                            for (int ci = 0; ci < pac.Count(); ci = ci + 1) {
                                int cc = ChartOption.ParseColor(pac.At(ci), 0);
                                if (cc != 0) { p.splitAreaColors.Add(cc); }
                            }
                        }
                    }
                }
                o.polars.Add(p);
            }
        } else if (pj != null && pj.IsObject()) {
            // ECharts5/6 polar:{} 单对象形态（无 indicator）：只承载
            // 圆心/外径/起始角，落 RadarPolar[0]（DrawPolarCoord 用）。
            RadarPolar p = RadarPolar.Create();
            p.startAngle = pj.Int("startAngle", p.startAngle);
            p.splitNumber = pj.Int("splitNumber", p.splitNumber);
            JsonValue pc = pj.Get("center");
            if (pc != null && pc.IsArray() && pc.Count() >= 2) {
                p.center = ChartOption.ParsePoint(pc,
                    ChartPosition.Of(ChartScalar.Pct(50), ChartScalar.Pct(50)));
            }
            JsonValue prad = pj.Get("radius");
            if (prad != null && prad.IsArray() && prad.Count() >= 2) {
                // `radius:[30,'80%']` 的语义是 [内径, 外径]（polarCreator.ts:63-76
                // 的 parsedRadius[0]/[1]）——旧代码取 At(0) 当外径，于是
                // bar-polar-label-* 的外径塌成 30px、内径丢失。
                p.radiusInner = ChartOption.ParseScalar(prad.At(0), ChartScalar.Px(0));
                p.radius = ChartOption.ParseScalar(prad.At(1), ChartScalar.Px(0));
            } else if (prad != null) {
                p.radius = ChartOption.ParseScalar(prad, ChartScalar.Px(0));
            }
            o.polars.Add(p);
        }

        ChartOption.ParseAxis(v.Get("xAxis"), o.xAxes, true);
        ChartOption.ParseAxis(v.Get("yAxis"), o.yAxes, false);
        ChartOption.ParseVisualMap(v.Get("visualMap"), o.visualMaps);
        // visualMap.inRange.color → 全局色带。地图/热力图/散点/日历渲染器
        // 读的是 o.rampColors + o.rampLo/rampHi（单条全局色带），而
        // visualMap 的色带此前只进 visualMaps[]，两边从不交汇——29 个带
        // inRange.color 的 demo 因此全走缺省色域（地图浅蓝→深蓝、
        // 日历底→系列色），官方色带形同不存在。
        // 取**首个显式声明颜色的 continuous visualMap**：语料普查确认
        // 没有任何 demo 声明 ≥2 条带色的 visualMap，"首个"不产生歧义；
        // piecewise 走 pieces 通道，不在这里接线。dataRange（2.x 遗留）
        // 已填时不覆盖——它更具体。
        if (o.rampColors.Count < 1) {
            for (int vmi = 0; vmi < o.visualMaps.Count; vmi = vmi + 1) {
                ChartVisualMap vm = o.visualMaps[vmi];
                if (vm.type != 0 || !vm.colorsExplicit
                    || vm.rangeColors.Count < 2) { continue; }
                for (int ci = 0; ci < vm.rangeColors.Count; ci = ci + 1) {
                    o.rampColors.Add(vm.rangeColors[ci]);
                }
                if (vm.hasMin && vm.minRaw != ChartOption.Auto()) { o.rampLo = vm.minRaw; }
                if (vm.hasMax && vm.maxRaw != ChartOption.Auto()) { o.rampHi = vm.maxRaw; }
                break;
            }
        }

        // ECharts dataset：数据集与 transform 先于系列解析——系列用
        // datasetId/datasetIndex + encode 绑定列（缺省绑 index 0）。
        // dataset 支持数组与单对象两种形态（官方基础例全是对象形态）。
        JsonValue dsj = v.Get("dataset");
        int dsN = 0;
        if (dsj != null && dsj.IsArray()) { dsN = dsj.Count(); }
        else if (dsj != null && dsj.IsObject()) { dsN = 1; }
        for (int di = 0; di < dsN; di = di + 1) {
            JsonValue dj = dsj.IsArray() ? dsj.At(di) : dsj;
            if (dj == null || !dj.IsObject()) { continue; }
            ChartJsonDataset ds = new ChartJsonDataset();
            ds.id = dj.Str("id", "");
            ds.rows = new List<int>();
            // dimensions 形态：表头来自 dimensions 数组，source 里
            // 全是数据行（无表头行）；常规形态首行是表头。
            JsonValue dimj = dj.Get("dimensions");
            if (dimj != null && dimj.IsArray()) {
                ds.dims = new List<string>();
                for (int di2 = 0; di2 < dimj.Count(); di2 = di2 + 1) {
                    ds.dims.Add(dimj.At(di2).AsString(""));
                }
            }
            ds.source = dj.Get("source");
            if (ds.source != null && ds.source.IsArray()) {
                for (int ri = 0; ri < ds.source.Count(); ri = ri + 1) { ds.rows.Add(ri); }
                // 无表头推断：首行与数据行同构（全数值观测行等）。
                ds.noHdr = !ChartJsonDataset.HeaderEvidence(ds.source);
            }
            // transform 的上游（ECharts sourceManager 语义）：
            // fromDatasetId 优先，其后 fromDatasetIndex，都缺省时
            // 默认 datasetIndex 0。
            JsonValue trj = dj.Get("transform");
            if (trj != null) {
                ChartJsonDataset from = null;
                if (dj.Has("fromDatasetId")) {
                    from = ChartJsonDataset.ById(o.datasets, dj.Str("fromDatasetId", ""));
                } else if (dj.Has("fromDatasetIndex")) {
                    from = ChartJsonDataset.At(o.datasets, dj.Int("fromDatasetIndex", 0));
                } else {
                    from = ChartJsonDataset.At(o.datasets, 0);
                }
                if (from != null) {
                    if (trj.IsObject()) {
                        ChartJsonDataset.Transform(from, ds, trj);
                    } else if (trj.IsArray()) {
                        // 变换链：每步过中间数据集（transform 结果是
                        // 合成数据时，链上后续步骤必须读上一步的结果）。
                        ChartJsonDataset cur = from;
                        for (int ti = 0; ti < trj.Count(); ti = ti + 1) {
                            ChartJsonDataset step = new ChartJsonDataset();
                            step.rows = new List<int>();
                            ChartJsonDataset.Transform(cur, step, trj.At(ti));
                            cur = step;
                        }
                        ds.source = cur.source;
                        ds.rows = cur.rows;
                        ds.dims = cur.dims;
                        ds.source1 = cur.source1;
                        ds.rows1 = cur.rows1;
                    }
                }
            } else if (dj.Has("fromTransformResult")) {
                // 只有 fromTransformResult：克隆上游第 N 个变换结果。
                ChartJsonDataset from2 = null;
                if (dj.Has("fromDatasetId")) {
                    from2 = ChartJsonDataset.ById(o.datasets, dj.Str("fromDatasetId", ""));
                } else if (dj.Has("fromDatasetIndex")) {
                    from2 = ChartJsonDataset.At(o.datasets, dj.Int("fromDatasetIndex", 0));
                } else {
                    from2 = ChartJsonDataset.At(o.datasets, 0);
                }
                if (from2 != null) {
                    if (dj.Int("fromTransformResult", 0) == 1 && from2.source1 != null) {
                        ds.source = from2.source1;
                        ds.rows = from2.rows1;
                    } else {
                        ds.source = from2.source;
                        ds.rows = from2.rows;
                    }
                    ds.dims = from2.dims;
                }
            }
            o.datasets.Add(ds);
        }

        // ECharts geo 组件：底图地图（对象或数组），系列解析后
        // 由合成块挂载。
        ChartOption.ParseGeo(v.Get("geo"), o);
        ChartOption.ParseCalendar(v.Get("calendar"), o);
        ChartOption.ParseParAxes(v.Get("parallelAxis"), o);
        // ECharts 极坐标轴（angleAxis/radiusAxis）：对象或数组形态，
        // polarIndex 绑定到 polar[]（coordinateSystem:"polar" 系列）。
        ChartOption.ParsePolarAxes(v.Get("angleAxis"), o, true);
        ChartOption.ParsePolarAxes(v.Get("radiusAxis"), o, false);
        // parallel 组件块：layout 命名轴排布方向（'vertical' = 轴横
        // 置自上而下堆叠，nutrients 官方图；'horizontal'/缺省 = 既有
        // 竖轴从左到右）。
        JsonValue parj = v.Get("parallel");
        if (parj != null && parj.IsObject()) {
            o.parLayout = parj.Str("layout", o.parLayout);
        }
        JsonValue series = v.Get("series");
        // ECharts 单系列可以把 series 直接写成对象（line-aqi），
        // 与数组形态同一路解析，否则整图被当空数据画 "(no data)"。
        bool seriesObj = series != null && series.IsObject();
        if (seriesObj || (series != null && series.IsArray())) {
            int ns = seriesObj ? 1 : series.Count();
            // seriesLayoutBy 行/列系列的序号表（key = dataset|布局，
            // value = 已消费个数）：ECharts 语义是同类序的第 k 个
            // 系列绑第 k 条行/列。
            List<string> bindKeys = new List<string>();
            List<int> bindOrd = new List<int>();
            for (int i = 0; i < ns; i = i + 1) {
                JsonValue s = seriesObj ? series : series.At(i);
                string sty = s.Str("type", "line");
                ChartSeries cs = ChartSeries.Of(s.Str("name", ""),
                    ChartKinds.TypeOf(sty), new List<int>());
                cs.custom = ChartKinds.CustomOf(sty);
                cs.typeName = sty;
                cs.selectedMode = ChartKinds.SelectedModeSanitize(
                    s.Str("selectedMode", ""));
                cs.mapName = s.Str("map", "");
                cs.geoIndex = s.Int("geoIndex", 0);
                // ECharts MapSeries.getMapType()：**显式声明了 geoIndex**
                // 的 map 系列挂在 geo 组件上，此时 option.map/mapType 被
                // 忽略（MapSeries.ts:190 `(this.getHostGeoModel() || this).option.map`），
                // 地图名一律取宿主 geo 的 map。真实示例（geo-map-scatter /
                // geo-choropleth-scatter）正是这个形态：map 缺省或空串 +
                // geoIndex:0。不接这一步，系列名空 → BindSeries 直接返回，
                // 系列 data 的值落不到区域上，底图只能靠合成系列画出
                // 一片同色（visualMap 分级/着色全失效）。
                // 判定必须用"显式声明"而非字段值：geoIndex 缺省 0 与显式
                // 0 在数值上无法区分，但 ECharts 的 getHostGeoModel() 走
                // getReferringComponents(..., {useDefault:false})——没写
                // geoIndex 的 map 系列自建独占 geo，自己的 map 优先。
                if (cs.type == ChartType.Map && s.Has("geoIndex")
                    && cs.geoIndex >= 0 && o.geos.Count > cs.geoIndex) {
                    cs.mapName = o.geos[cs.geoIndex].map;
                }
                // coordinateSystem:"geo"（散点/lines/graph 叠加地图）。
                string csys = s.Str("coordinateSystem", "");
                if (csys == "geo") { cs.coordSys = "geo"; }
                // coordinateSystem:"polar"（ECharts5/6 极坐标：角度轴/
                // 半径轴圆框，line/scatter 点投影）。
                if (csys == "polar") { cs.coordSys = "polar"; }
                // coordinateSystem:"calendar"（calendar-heatmap/scatter/
                // graph/pie 叠加日历）。calendarIndex 选目标日历。
                if (csys == "calendar") {
                    cs.coordSys = "calendar";
                    cs.calIndex = s.Int("calendarIndex", 0);
                    // pie.center 在 calendar 坐标系下是日期串（"2017-02-01"）
                    // 而非 [x,y] 坐标，ParsePoint 的解不出像素，改存 calDay。
                    if (cs.type == ChartType.Pie) {
                        JsonValue ctr = s.Get("center");
                        if (ctr != null && ctr.IsString()) {
                            int cdd = ChartOption.ParseDateDay(ctr.AsString(""), 0 - 1);
                            if (cdd < 0) { cdd = ChartOption.TimeDayOf(ctr); }
                            if (cdd >= 0) { cs.calCenter = cdd; }
                        }
                    }
                }
                if (cs.custom == "pictorialBar") {
                    JsonValue psm = s.Get("symbol");
                    if (psm != null && psm.IsString()) {
                        cs.picSymbol = psm.AsString("");
                    }
                    JsonValue prp = s.Get("symbolRepeat");
                    if (prp != null) {
                        cs.picRepeat = prp.IsString()
                            ? prp.AsString("") : (prp.AsBool(false) ? "true" : "");
                    }
                    cs.picClip = s.Bool("symbolClip", false);
                    cs.picPos = s.Str("symbolPosition", "");
                    JsonValue pbd = s.Get("symbolBoundingData");
                    if (pbd != null && pbd.IsNumber()) { cs.picBound = pbd.AsInt(0); }
                    JsonValue psz = s.Get("symbolSize");
                    if (psz != null && psz.IsArray() && psz.Count() >= 2) {
                        JsonValue w0 = psz.At(0);
                        JsonValue h0 = psz.At(1);
                        if (w0.IsNumber()) { cs.picW = w0.AsInt(0); }
                        else if (w0.IsString() && w0.AsString("").EndsWith("%")) {
                            cs.picWPct = Convert.ToInt(
                                w0.AsString("").Substring(0, w0.AsString("").Length - 1));
                        }
                        if (h0.IsNumber()) { cs.picH = h0.AsInt(0); }
                        else if (h0.IsString() && h0.AsString("").EndsWith("%")) {
                            cs.picHPct = Convert.ToInt(
                                h0.AsString("").Substring(0, h0.AsString("").Length - 1));
                        }
                    } else if (psz != null && psz.IsNumber()) {
                        cs.picW = psz.AsInt(0);
                        cs.picH = cs.picW;
                    }
                }
                if (cs.custom == "parallel") {
                    JsonValue pd = s.Get("data");
                    if (pd != null && pd.IsArray()) {
                        for (int ri = 0; ri < pd.Count(); ri = ri + 1) {
                            JsonValue row = pd.At(ri);
                            List<int> nums = new List<int>();
                            if (row != null && row.IsArray()) {
                                for (int ci = 0; ci < row.Count(); ci = ci + 1) {
                                    JsonValue cell = row.At(ci);
                                    // 类目维：值是类目下标；数值维：AsInt 取整。
                                    if (cell != null && cell.IsNumber()) {
                                        nums.Add(cell.AsInt(0));
                                    } else {
                                        nums.Add(Convert.ToInt(cell.AsString("")));
                                    }
                                }
                            } else if (row != null && row.IsObject()) {
                                // {value:[...]} 形态
                                JsonValue vv = row.Get("value");
                                if (vv != null && vv.IsArray()) {
                                    for (int ci = 0; ci < vv.Count(); ci = ci + 1) {
                                        nums.Add(vv.At(ci).AsInt(0));
                                    }
                                }
                            }
                            if (nums.Count > 0) { cs.parRows.Add(nums); }
                        }
                    }
                }
                if (cs.custom == "themeRiver") {
                    JsonValue rd = s.Get("data");
                    if (rd != null && rd.IsArray()) {
                        for (int ri = 0; ri < rd.Count(); ri = ri + 1) {
                            JsonValue row = rd.At(ri);
                            if (row == null || !row.IsArray() || row.Count() < 3) { continue; }
                            // [时间, 值, 名字] 三元组；时间支持 "2015/11/08"
                            // 字符串与数值（lastfm 用下标）。
                            JsonValue tj = row.At(0);
                            JsonValue vj = row.At(1);
                            JsonValue nj = row.At(2);
                            string time = tj.IsString()
                                ? tj.AsString("") : tj.AsInt(0) + "";
                            int val = vj.IsNumber() ? vj.AsInt(0)
                                : Convert.ToInt(vj.AsString(""));
                            string nm = nj.AsString("");
                            if (time.Length == 0 || nm.Length == 0) { continue; }
                            int cat = -1;
                            for (int ci = 0; ci < cs.riverNames.Count; ci = ci + 1) {
                                if (cs.riverNames[ci] == nm) { cat = ci; break; }
                            }
                            if (cat < 0) { cs.riverNames.Add(nm); cat = cs.riverNames.Count - 1; }
                            cs.riverTimes.Add(time);
                            cs.riverVals.Add(val);
                            cs.riverCat.Add(cat);
                        }
                    }
                }
                // series.color：数字（2.x int 通道）与字符串 "#xxx" 双
                // 形态——字符串经 ParseColor，int-only 会把官方 demo
                // 的命名色静默丢成"继承调色板"。
                cs.color = s.Get("color") != null
                    ? ChartOption.ParseColor(s.Get("color"), 0) : 0;
                cs.axisIndex = s.Int("yAxisIndex", s.Int("axisIndex", 0));
                cs.xIndex = s.Int("xAxisIndex", 0);
                // ECharts id 绑定：series.xAxisId/yAxisId 按轴 id 串接
                // （散点矩阵类 demo 的轴/网格全用 id 命名引用）。命中
                // 同名轴时覆盖索引绑定；未命中保留索引值。
                string xid = s.Str("xAxisId", "");
                if (xid.Length > 0) {
                    for (int ai = 0; ai < o.xAxes.Count; ai = ai + 1) {
                        if (o.xAxes[ai].axisId == xid) { cs.xIndex = ai; break; }
                    }
                }
                string yid = s.Str("yAxisId", "");
                if (yid.Length > 0) {
                    for (int ai = 0; ai < o.yAxes.Count; ai = ai + 1) {
                        if (o.yAxes[ai].axisId == yid) { cs.axisIndex = ai; break; }
                    }
                }
                // stack 同时接受整数（旧形式）和字符串（ECharts stackName 分组）。
                JsonValue stk = s.Get("stack");
                if (stk != null && stk.IsString()) {
                    cs.stackName = stk.AsString("");
                    cs.stack = ChartOption.StackIdFor(cs.stackName);
                } else {
                    cs.stack = s.Int("stack", 0);
                }
                // stackStrategy（processor/dataStack.ts:112）：默认 samesign。
                // 字符串值映射到枚举整；未声明或
                // 不认识的值回落 samesign。
                string sst = s.Str("stackStrategy", "");
                if (sst == "all") { cs.stackStrategy = 1; }
                else if (sst == "positive") { cs.stackStrategy = 2; }
                else if (sst == "negative") { cs.stackStrategy = 3; }
                else { cs.stackStrategy = 0; }
                cs.areaStyle = s.Bool("areaStyle", cs.areaStyle);
                cs.step = s.Str("step", cs.step);
                // series.emphasis.focus："series" = 悬停本系列时其余
                // 系列渐隐（官方 bump/折线族聚焦观感的核心表达）。
                JsonValue emphF = s.Get("emphasis");
                if (emphF != null && emphF.IsObject()) {
                    cs.emphasisFocus = emphF.Str("focus", cs.emphasisFocus);
                }
                cs.sort = s.Str("sort", cs.sort);
                cs.roseType = s.Str("roseType", cs.roseType);
                cs.clockWise = s.Bool("clockWise", cs.clockWise);
                cs.polarIndex = s.Int("polarIndex", cs.polarIndex);
                string lsym = s.Str("linkSymbol", "");
                if (lsym == "arrow") { cs.forceLinkSymbol = "arrow"; }
                // pie.center / pie.radius（ECharts：['25%', 200] 与
                // '55%' | 80 | [110, 140]）。
                cs.center = ChartOption.ParsePoint(s.Get("center"), cs.center);
                JsonValue pieR = s.Get("radius");
                if (pieR != null && pieR.IsArray() && pieR.Count() >= 2) {
                    cs.radiusInner = ChartOption.ParseScalar(pieR.At(0), cs.radiusInner);
                    cs.radius = ChartOption.ParseScalar(pieR.At(1), cs.radius);
                } else if (pieR != null) {
                    cs.radius = ChartOption.ParseScalar(pieR, cs.radius);
                }
                cs.startAngle = s.Int("startAngle", cs.startAngle);
                cs.selectedOffset = s.Int("selectedOffset", cs.selectedOffset);
                // barWidth 百分比形式（"60%"）单独入 barWidthPct，
                // 像素形式照旧；渲染按带宽百分比定柱宽。
                JsonValue bwp = s.Get("barWidth");
                if (bwp != null && bwp.IsString() && bwp.AsString("").EndsWith("%")) {
                    string wpct = bwp.AsString("");
                    cs.barWidthPct = Convert.ToInt(wpct.Substring(0, wpct.Length - 1));
                } else {
                    cs.barWidth = s.Int("barWidth", cs.barWidth);
                }
                cs.barHeight = s.Int("barHeight", cs.barHeight);
                cs.barMinHeight = s.Int("barMinHeight", cs.barMinHeight);
                cs.barMinAngle = s.Int("barMinAngle", cs.barMinAngle);
                cs.roundCap = s.Bool("roundCap", cs.roundCap);
                cs.silent = s.Bool("silent", cs.silent);
                // 柱布局原始选项（barGrid 的输入）：`Str` 对字符串原样、
                // 对数字给原始字面量（numRaw），缺省 "" —— 正是
                // layout/barGrid.ts:createLayoutInfoListOnAxis 需要的形态。
                cs.barWidthRaw = s.Str("barWidth", "");
                cs.barGapRaw = s.Str("barGap", "");
                cs.barCategoryGapRaw = s.Str("barCategoryGap", "");
                cs.barMinWidthRaw = s.Str("barMinWidth", "");
                cs.barMaxWidthRaw = s.Str("barMaxWidth", "");
                cs.large = s.Bool("large", cs.large);
                cs.largeThreshold = s.Int("largeThreshold", cs.largeThreshold);
                JsonValue bgp = s.Get("barGap");
                if (bgp != null && bgp.IsString() && bgp.AsString("").EndsWith("%")) {
                    string pct = bgp.AsString("");
                    cs.barGapPct = Convert.ToInt(pct.Substring(0, pct.Length - 1));
                } else {
                    cs.barGapPct = s.Int("barGap", cs.barGapPct);
                }
                // smooth：系列级平滑覆盖（bool 或 0/1；缺省继承 option）。
                JsonValue smt = s.Get("smooth");
                if (smt != null && smt.IsBool()) { cs.smooth = smt.AsBool(false) ? 1 : 0; }
                else if (smt != null && smt.IsNumber()) {
                    // ECharts smooth 可为 0..1 平滑系数（0.6 等）：
                    // 非 0 即开平滑（引擎暂不分级张力）。
                    cs.smooth = smt.AsDouble(0.0) != 0.0 ? 1 : 0;
                }
                cs.showBackground = s.Bool("showBackground", cs.showBackground);
                // symbol 形状族 / 尺寸 / showSymbol（bool 或 int 形式）。
                cs.symbol = ChartKinds.SymbolSanitize(s.Str("symbol", cs.symbol));
                cs.symbolSize = s.Int("symbolSize", cs.symbolSize);
                // symbolSize 回调的公式化表达（见 symbolSizeFn 字段注释）。
                string szf = s.Str("symbolSizeFn", "");
                if (szf == "y" || szf == "ySqrt" || szf == "x" || szf == "xSqrt") {
                    cs.symbolSizeFn = szf;
                }
                JsonValue sym = s.Get("showSymbol");
                if (sym != null && sym.IsBool()) {
                    cs.showSymbol = sym.AsBool(true) ? 1 : 0;
                } else if (sym != null && sym.IsNumber()) {
                    cs.showSymbol = sym.AsInt(1);
                }
                // showAllSymbol：'auto'（缺省）= 能放下就全放、放不下才按标签
                // 间隔抽稀；true = 全放；false = 一律按标签间隔。
                // 出处 chart/line/LineView.ts:367-401 getIsIgnoreFunc。
                JsonValue sas = s.Get("showAllSymbol");
                if (sas != null && sas.IsBool()) {
                    cs.showAllSymbol = sas.AsBool(true) ? 1 : 0;
                } else if (sas != null && sas.IsNumber()) {
                    cs.showAllSymbol = sas.AsInt(0 - 1);
                } else if (sas != null && sas.IsString()
                           && sas.AsString("") == "auto") {
                    cs.showAllSymbol = 0 - 1;
                }
                JsonValue bgs = s.Get("backgroundStyle");
                if (bgs != null && bgs.IsObject()) {
                    if (bgs.Has("color")) {
                        cs.backgroundColor = ChartOption.ParseColor(bgs.Get("color"), cs.backgroundColor);
                    }
                }
                cs.innerPct = s.Int("innerPct", cs.innerPct);
                cs.hbar = s.Bool("hbar", cs.hbar);
                cs.treeOrient = s.Str("orient", cs.treeOrient);
                cs.custom = s.Str("custom", cs.custom);
                // ---- 批 6：force / chord / funnel / wordCloud 参数 ----
                JsonValue fc = s.Get("force");
                if (fc != null && fc.IsObject()) {
                    cs.forceScaling = fc.Int("scaling", cs.forceScaling);
                    cs.forceGravity = fc.Int("gravity", cs.forceGravity);
                    cs.forceMinRadius = fc.Int("minRadius", cs.forceMinRadius);
                    cs.forceMaxRadius = fc.Int("maxRadius", cs.forceMaxRadius);
                    JsonValue fns = fc.Get("nodeStyle");
                    if (fns != null && fns.IsObject()) {
                        cs.forceNodeColor = ChartOption.ParseColor(fns.Get("color"),
                            cs.forceNodeColor);
                    }
                    JsonValue fls = fc.Get("linkStyle");
                    if (fls != null && fls.IsObject()) {
                        cs.forceLinkColor = ChartOption.ParseColor(fls.Get("color"),
                            cs.forceLinkColor);
                    }
                }
                JsonValue ch = s.Get("chord");
                if (ch != null && ch.IsObject()) {
                    if (ch.Str("ribbonType", "") == "path") {
                        cs.chordRibbonType = "path";
                    }
                    string cso = ch.Str("sort", "");
                    if (cso == "descending") { cs.chordSort = 1; }
                    else if (cso == "ascending") { cs.chordSort = 2; }
                    cs.chordSortSub = ch.Bool("sortSub", cs.chordSortSub);
                    cs.chordGapDeg = ch.Int("gap", cs.chordGapDeg);
                    cs.chordRingWidthPct = ch.Int("ringWidth", cs.chordRingWidthPct);
                }
                // ECharts2 chord.matrix：n×n 权重阵（节点名取 data[i].name）。
                JsonValue mx = s.Get("matrix");
                if (mx != null && mx.IsArray()) {
                    for (int mri = 0; mri < mx.Count(); mri = mri + 1) {
                        JsonValue mrow = mx.At(mri);
                        List<int> row = new List<int>();
                        if (mrow != null && mrow.IsArray()) {
                            for (int mci = 0; mci < mrow.Count(); mci = mci + 1) {
                                row.Add(mrow.At(mci).AsInt(0));
                            }
                        }
                        cs.matrix.Add(row);
                    }
                }
                cs.funnelAlign = s.Str("funnelAlign", cs.funnelAlign);
                cs.funnelGap = s.Int("funnelGap", cs.funnelGap);
                cs.funnelPercent = s.Bool("funnelPercent", cs.funnelPercent);
                cs.maxSizePct = s.Int("maxSizePct", cs.maxSizePct);
                cs.funnelLabelOut = s.Bool("funnelLabelOut", cs.funnelLabelOut);
                cs.forceCurveness = s.Int("forceCurveness", cs.forceCurveness);
                JsonValue sr = s.Get("sizeRange");
                if (sr != null && sr.IsArray() && sr.Count() >= 2) {
                    cs.wcMinFontSize = sr.At(0).AsInt(cs.wcMinFontSize);
                    cs.wcMaxFontSize = sr.At(1).AsInt(cs.wcMaxFontSize);
                }
                if (s.Str("rotate", "") == "vary") { cs.wcRotate = "vary"; }
                // textRotation:[0,90,...]（ECharts 2.x 词云角度候选）：
                // 逗号串接进 wcRotateList，非空时渲染器按序取角度。
                JsonValue rotArr = s.Get("textRotation");
                if (rotArr != null && rotArr.IsArray() && rotArr.Count() > 0) {
                    string rl = "";
                    for (int ra = 0; ra < rotArr.Count(); ra = ra + 1) {
                        int deg = rotArr.At(ra).AsInt(0);
                        deg = ((deg % 360) + 360) % 360;
                        if (deg > 180) { deg = deg - 360; }
                        if (rl.Length > 0) { rl = rl + ","; }
                        rl = rl + Convert.ToString(deg);
                    }
                    cs.wcRotateList = rl;
                }
                ChartOption.ParseSeriesStyle(s, cs);
                // ECharts 2.x 把折线面积藏在 itemStyle.normal.areaStyle
                // （对象/true 即启用）。只能看 JSON 是否真的写了这个
                // 键——结构体的 type 默认就是 "default"，拿默认值判
                // 会把每条 v5/v6 折线都误开成面积图（line-simple 渲
                // 染成面积图的根因）。
                if (cs.type == ChartType.Line) {
                    JsonValue itm2x = s.Get("itemStyle");
                    if (itm2x != null && itm2x.IsObject()) {
                        JsonValue nrm2x = itm2x.Get("normal");
                        if (nrm2x != null && nrm2x.IsObject()) {
                            JsonValue na2x = nrm2x.Get("areaStyle");
                            if (na2x != null
                                && (na2x.IsObject() || na2x.AsBool(false))) {
                                cs.areaStyle = true;
                            }
                        }
                    }
                }
                // ECharts line.endLabel：线尾标注 {show,formatter,distance}。
                JsonValue elab = s.Get("endLabel");
                if (elab != null && elab.IsObject()) {
                    cs.endLabelShow = elab.Bool("show", true);
                    cs.endLabelDistance = elab.Int("distance", cs.endLabelDistance);
                    cs.endLabelFormatter = elab.Str("formatter", cs.endLabelFormatter);
                }
                if (cs.type == ChartType.Gauge) { ChartOption.ParseGauge(s, cs.gauge); }
                // pie radius:[inner,outer] -> innerPct（内/外半径百分比）。
                JsonValue rad = s.Get("radius");
                if (rad != null && rad.IsArray() && rad.Count() >= 2) {
                    int innerPx = rad.At(0).AsInt(0);
                    int outerPx = rad.At(1).AsInt(0);
                    if (outerPx > 0 && innerPx >= 0 && innerPx <= outerPx) {
                        cs.innerPct = innerPx * 100 / outerPx;
                    }
                }
                // 专用数据列表：links（Sankey/Chord/Force）、candle、bubble、
                // box、error、scatter points、event、map regions、markPoint.data。
                ChartOption.ParseLinks(s.Get("links"), cs.links);
                ChartOption.ParseCandles(s.Get("candles"), cs.candles);
                ChartOption.ParseBubbles(s.Get("bubbles"), cs.bubbles);
                ChartOption.ParseBoxes(s.Get("boxes"), cs.boxes);
                ChartOption.ParseErrors(s.Get("errors"), cs.errors);
                ChartOption.ParsePoints(s.Get("points"), cs.points);
                if (cs.points.Count > 0 && cs.pointG <= 1) { cs.pointG = 1000; }
                ChartOption.ParseEvents(s.Get("events"), cs.events);
                ChartOption.ParseRegions(s.Get("regions"), cs.regions);
                // 层级数据（tree/treemap/sunburst 的 children 递归）。
                ChartOption.ParseTree(s.Get("data"), cs.tree);
                ChartOption.ParseMarks(s.Get("markPoint"), cs.marks);
                // series 级 markPoint.label（对象形态）：模板 + 富文本/
                // 盒样式 + 位置/距离；symbolSize 声明后 mark 点画小点
                // 不画 pin 气球（bar-rich-text 的 symbolSize:1 摘要卡）。
                JsonValue mpObj = s.Get("markPoint");
                if (mpObj != null && mpObj.IsObject()) {
                    JsonValue mpLbl = mpObj.Get("label");
                    if (mpLbl != null && mpLbl.IsObject()) {
                        cs.markLabelFmt = mpLbl.Str("formatter", cs.markLabelFmt);
                        cs.markLabelPos = mpLbl.Str("position", cs.markLabelPos);
                        cs.markLabelDist = mpLbl.Int("distance", cs.markLabelDist);
                        if (mpLbl.Get("rich") != null) {
                            ChartTextStyle mst = ChartTextStyle.Create();
                            ChartOption.ParseTextStyle(mpLbl, mst);
                            cs.markLabelSt = mst;
                        }
                    }
                    cs.markSymbolSize = mpObj.Int("symbolSize", cs.markSymbolSize);
                }
                // series.labelLayout：标签绝对位/偏移/对齐/解叠（对象
                // 形态；官方 JS 函数形 JSON 导出已丢失，见 skill 11）。
                JsonValue llj = s.Get("labelLayout");
                if (llj != null && llj.IsObject()) {
                    cs.llDeclared = true;
                    cs.llDx = llj.Int("dx", cs.llDx);
                    cs.llDy = llj.Int("dy", cs.llDy);
                    if (llj.Has("x")) { cs.llX = llj.Int("x", cs.llX); }
                    if (llj.Has("y")) { cs.llY = llj.Int("y", cs.llY); }
                    cs.llAlign = llj.Str("align", cs.llAlign);
                    cs.llHideOverlap = llj.Bool("hideOverlap", cs.llHideOverlap);
                    cs.llMove = llj.Str("moveOverlap", cs.llMove);
                }
                ChartOption.ParseMarkLines(s.Get("markLine"), cs.markLines);
                ChartOption.ParseMarkArea(s.Get("markArea"), o);
                JsonValue da = s.Get("data");
                if (da != null && da.IsArray()) {
                    for (int j = 0; j < da.Count(); j = j + 1) {
                        JsonValue it = da.At(j);
                        int xai = cs.axisIndex < o.xAxes.Count
                            ? cs.axisIndex : 0;
                        // calendar 坐标系没有直角轴，但 series.data 同样是
                        // [[日期串, 值],...] 形态，必须走时间值对通道。
                        bool timePair = (o.xAxes.Count > 0
                            && o.xAxes[xai].type == ChartAxisType.Time)
                            || cs.coordSys == "calendar";
                        if (it.IsArray() && it.Count() >= 2) {
                            // K 线四元裸数组 [open,high,low,close]（可带
                            // 第 5 位 itemStyle 对象）：进 candles。此前
                            // 只认 candles 键与 dataset 两条路，裸 data
                            // 写法（candlestick-touch 等）全空板。
                            if (cs.type == ChartType.K && it.Count() >= 4
                                && it.At(0).IsNumber() && it.At(1).IsNumber()) {
                                Candle cd = Candle.Of(it.At(0).AsInt(0),
                                    it.At(1).AsInt(0), it.At(2).AsInt(0),
                                    it.At(3).AsInt(0));
                                if (it.Count() >= 5 && it.At(4).IsObject()) {
                                    JsonValue pisj = it.At(4).Get("itemStyle");
                                    if (pisj == null) { pisj = it.At(4); }
                                    if (pisj != null && pisj.IsObject()) {
                                        cd.itemStyle = ChartItemStyle.Create();
                                        ChartOption.ParseItemStyle(pisj, cd.itemStyle);
                                    }
                                }
                                cs.candles.Add(cd);
                                continue;
                            }
                            // 极坐标值对 [[radius, angle(, value)],...]：
                            // ECharts 数据序 [r, θ]；x=radius y=angle
                            // z=value 千倍定点进 points（类目轴的坐标是
                            // 类目下标，同为数值）。必须在 catPair 之前
                            // 拦截——无 xAxis 时折线值对会被当 [名,值]。
                            if (cs.coordSys == "polar") {
                                cs.pointG = 1000;
                                double rv = it.At(0).AsDouble(0.0);
                                double av = it.At(1).AsDouble(0.0);
                                ChartPoint pp = ChartPoint.Of(
                                    (int)(rv >= 0 ? rv * 1000 + 0.5 : rv * 1000 - 0.5),
                                    (int)(av >= 0 ? av * 1000 + 0.5 : av * 1000 - 0.5));
                                if (it.Count() >= 3) {
                                    double zv = it.At(2).AsDouble(0.0);
                                    pp.z = (int)(zv >= 0 ? zv * 1000 + 0.5
                                                         : zv * 1000 - 0.5);
                                }
                                cs.points.Add(pp);
                                continue;
                            }
                            // ECharts 数值对 [[x,y],...]：数值轴上是点
                            // 数据；类目轴折线上是 [类目名, 值] 对
                            // （area-pieces 的时间串首列），空类目轴从
                            // 首个系列回填。蜡烛图等多维数组不走这。
                            bool catPair = cs.type == ChartType.Line
                                && (o.xAxes.Count == 0
                                    || o.xAxes[xai].type == ChartAxisType.Category);
                            if (catPair) {
                                string cn = it.At(0).AsString("");
                                cs.data.Add(ChartData.NamedNumber(
                                    it.At(1).AsDouble(0.0), cn));
                            } else if (timePair) {
                                // 时间轴值对 [[epoch毫秒|日期串, 值],...]：
                                // 首元归一成 epoch 天存 points.x（XOfTime
                                // 域；毫秒/秒直接装 int 会溢出塌到左缘——
                                // area-time-axis 竖线的根因），次元为 y。
                                int td = ChartOption.TimeDayOf(it.At(0));
                                if (td >= 0) {
                                    double dv2 = it.At(1).AsDouble(0.0);
                                    cs.points.Add(ChartPoint.Of(td,
                                        (int)(dv2 >= 0 ? dv2 + 0.5 : dv2 - 0.5)));
                                    // calendar：同一对也进 data（日历渲染器
                                    // 按 data 逐日取色，heat/pie 两用）。
                                    if (cs.coordSys == "calendar") {
                                        ChartData cd2 = ChartData.Numeric(dv2);
                                        cd2.calDay = td;
                                        // 第 3 元是官方 lunar 示例的农历日名
                                        // （["2017-1-1", 1, "初四", null]），
                                        // 直接当逐项 label 文本用。
                                        if (it.Count() >= 3 && it.At(2).IsString()) {
                                            cd2.labelText = it.At(2).AsString("");
                                        }
                                        cs.data.Add(cd2);
                                    }
                                }
                            } else {
                                // 数值对 [[x,y],...]：必须走 ×1000 定点。
                                // ECharts 散点坐标是浮点（scatter-simple
                                // 的 [8.07,6.95]、bubble 的 [31163,77.4]），
                                // 用 AsInt 会把每一点截到整数格——35 个
                                // 散点/地图/自定义系列整体走形。定点约定
                                // 与 dataset 路（Mul1000）一致，渲染端已经
                                // 按 Chart.PointV(x, s.pointG) 除回。
                                cs.pointG = 1000;
                                double rpx = it.At(0).AsDouble(0.0);
                                double rpy = it.At(1).AsDouble(0.0);
                                cs.points.Add(ChartPoint.Of(
                                    (int)(rpx >= 0.0 ? rpx * 1000.0 + 0.5
                                        : rpx * 1000.0 - 0.5),
                                    (int)(rpy >= 0.0 ? rpy * 1000.0 + 0.5
                                        : rpy * 1000.0 - 0.5)));
                            }
                        } else if (it.IsObject()) {
                            // 时间轴的对象项 {name, value:[日期串, 值]}
                            // （dynamic-data2）：value 是数组而非标量，
                            // 按时间值对进 points，否则 Double("value")
                            // 取不到数、全序列塌成 0。
                            JsonValue vv = it.Get("value");
                            if (timePair && vv != null && vv.IsArray()
                                && vv.Count() >= 2) {
                                int td = ChartOption.TimeDayOf(vv.At(0));
                                if (td >= 0) {
                                    double dv2 = vv.At(1).AsDouble(0.0);
                                    cs.points.Add(ChartPoint.Of(td,
                                        (int)(dv2 >= 0 ? dv2 + 0.5 : dv2 - 0.5)));
                                }
                            }
                            ChartData item = ChartData.NamedNumber(it.Double("value", 0.0), it.Str("name", ""));
                            item.color = it.Get("color") != null
                                ? ChartOption.ParseColor(it.Get("color"), 0) : 0;
                            item.hidden = it.Bool("hidden", item.hidden);
                            item.selected = it.Bool("selected", item.selected);
                            // calendar + 对象项（calendar-graph 的节点 /
                            // calendar-pie 的扇区）：value 是 [日期串, 值]，
                            // 日期进 calDay 供日历布局定位。
                            if (timePair && cs.coordSys == "calendar"
                                && vv != null && vv.IsArray() && vv.Count() >= 1) {
                                int cdd = ChartOption.TimeDayOf(vv.At(0));
                                if (cdd < 0) {
                                    cdd = ChartOption.ParseDateDay(vv.At(0).AsString(""), 0 - 1);
                                }
                                if (cdd >= 0) { item.calDay = cdd; }
                            }
                            if (it.Has("symbolSize")) {
                                item.size = it.Int("symbolSize", 0);
                                item.sizeSet = true;
                            }
                            item.symbol = ChartKinds.SymbolSanitize(it.Str("symbol", ""));
                            // 逐根 itemStyle：逐柱颜色/圆角/透明
                            //（bar-data-color、bar-stack-borderRadius、瀑布图
                            // 透明占位）。color 未显式声明时镜像入 item.color
                            // （渲染器读 item.color 优先，与系列级同约定）。
                            if (it.Has("itemStyle")) {
                                item.itemStyle = ChartItemStyle.Create();
                                ChartOption.ParseItemStyle(it.Get("itemStyle"), item.itemStyle);
                                if (item.color == 0 && item.itemStyle.normal.color != 0) {
                                    item.color = item.itemStyle.normal.color;
                                }
                            }
                            // 逐项 label：position 覆盖（左/右记 labelSide，
                            // 与 bar8 同一承载），字符串 formatter 进 labelText；
                            // 模板语义（含 {} 令牌）另存 labelFmtT（饼逐扇
                            // 区模板，pie-rich-text），完整样式进 dlabel。
                            JsonValue lbl = it.Get("label");
                            if (lbl != null && lbl.IsObject()) {
                                string pos = lbl.Str("position", "");
                                if (pos == "left" || pos == "insideLeft") { item.labelSide = 1; }
                                else if (pos == "right" || pos == "insideRight") { item.labelSide = 2; }
                                JsonValue lsh = lbl.Get("show");
                                if (lsh != null && lsh.IsBool()) { item.labelHide = !lsh.AsBool(false); }
                                JsonValue lf = lbl.Get("formatter");
                                if (lf != null && lf.IsString()) {
                                    item.labelText = lf.AsString("");
                                    item.labelFmtT = item.labelText;
                                }
                                ChartTextStyle dts = ChartTextStyle.Create();
                                ChartOption.ParseTextStyle(lbl, dts);
                                if (dts.color != 0 || dts.fontSize != 0
                                    || dts.rich != null || dts.boxBg != 0
                                    || dts.boxBorder != 0
                                    || dts.tbColor != 0 || dts.tbWidth >= 0
                                    || dts.tsColor != 0) {
                                    item.dlabel = dts;
                                }
                            }
                            cs.data.Add(item);
                        } else if (it.IsNumber()) {
                            cs.data.Add(ChartData.Numeric(it.AsDouble(0.0)));
                        } else if (it.AsString("") == "-") {
                            // '-'：缺数据项，折线断开（ECharts gap 语义）。
                            cs.data.Add(ChartData.Gap());
                        } else {
                            cs.data.Add(ChartData.Of(it.AsInt(0)));
                        }
                    }
                }
                // 旧格式：series[].values
                JsonValue vals = s.Get("values");
                if (vals != null && vals.IsArray() && cs.data.Count == 0) {
                    for (int j2 = 0; j2 < vals.Count(); j2 = j2 + 1) {
                        cs.data.Add(ChartData.Of(vals.At(j2).AsInt(0)));
                    }
                }
                // lines 系列（非 geo 坐标兜底）：data 是点对数组
                // [[x,y],[x,y],...]——把相邻点对拆进 points（x0y0x1y1
                // 交错），渲染端每两点画一线。嵌套 [[ [x,y],[x,y] ],...]
                // 的多层形态由 ParsePoints 类似路径在下方 linesCustom
                // 块里兜住。coordSys=geo 的 lines 走下方 geoLines 块。
                if (cs.custom == "lines" && cs.coordSys.Length == 0
                    && cs.points.Count == 0
                    && da != null && da.IsArray()) {
                    for (int li = 0; li < da.Count(); li = li + 1) {
                        JsonValue pair = da.At(li);
                        if (pair != null && pair.IsArray() && pair.Count() >= 2
                            && pair.At(0).IsArray() && pair.At(1).IsArray()) {
                            cs.points.Add(ChartPoint.Of(pair.At(0).At(0).AsInt(0),
                                pair.At(0).At(1).AsInt(0)));
                            cs.points.Add(ChartPoint.Of(pair.At(1).At(0).AsInt(0),
                                pair.At(1).At(1).AsInt(0)));
                        }
                    }
                }
                // lines 系列 coordinateSystem:"geo"：data 是
                // [{coords:[[lng,lat],[lng,lat],...]}]（coords 可两点
                // 也可 polyline 多点）——坐标按 0.01° 定点（×100，
                // 半值远离零）收进 geoLines，y = -lat×100（北朝上，
                // 与注册表地图几何同一数据系）；渲染端由地图底图
                // 的布局仿射直接投影（DrawGeoOverlay）。
                if (cs.custom == "lines" && cs.coordSys == "geo"
                    && da != null && da.IsArray()) {
                    for (int li2 = 0; li2 < da.Count(); li2 = li2 + 1) {
                        JsonValue it2 = da.At(li2);
                        if (it2 == null || !it2.IsObject()) { continue; }
                        JsonValue cds = it2.Get("coords");
                        if (cds == null || !cds.IsArray() || cds.Count() < 2) { continue; }
                        List<ChartPoint> line = new List<ChartPoint>();
                        for (int cp = 0; cp < cds.Count(); cp = cp + 1) {
                            JsonValue cv = cds.At(cp);
                            if (cv == null || !cv.IsArray() || cv.Count() < 2) { continue; }
                            line.Add(ChartPoint.Of(
                                ChartOption.GeoQ(cv.At(0).AsDouble(0.0)),
                                ChartOption.GeoQ(0.0 - cv.At(1).AsDouble(0.0))));
                        }
                        if (line.Count >= 2) { cs.geoLines.Add(line); }
                    }
                }
                // scatter（含 effectScatter）coordinateSystem:"geo"：
                // data 是 [lng,lat,z?] 数组或 {name,value:[lng,lat,z?]}，
                // 同样按 0.01° 定点进 points（z 作值/气泡权重）。
                if (cs.type == ChartType.Scatter && cs.coordSys == "geo"
                    && da != null && da.IsArray()) {
                    for (int gi3 = 0; gi3 < da.Count(); gi3 = gi3 + 1) {
                        JsonValue git = da.At(gi3);
                        if (git == null) { continue; }
                        JsonValue gv = git.IsObject() ? git.Get("value") : git;
                        if (gv == null || !gv.IsArray() || gv.Count() < 2) { continue; }
                        string gnm = git.IsObject() ? git.Str("name", "") : "";
                        ChartPoint gp = ChartPoint.Of(
                            ChartOption.GeoQ(gv.At(0).AsDouble(0.0)),
                            ChartOption.GeoQ(0.0 - gv.At(1).AsDouble(0.0)));
                        if (gv.Count() >= 3 && gv.At(2).IsNumber()) {
                            gp.z = gv.At(2).AsInt(0);
                        }
                        if (gnm.Length > 0) { gp.name = gnm; }
                        if (git.IsObject() && git.Has("symbolSize")) {
                            gp.size = git.Int("symbolSize", 0);
                            gp.sizeSet = true;
                        }
                        cs.points.Add(gp);
                    }
                }
                // map 系列：注册表几何 + data 值 + regions 覆盖，
                // 在 data/regions 都解析完后统一绑定。
                ChartMaps.BindSeries(cs);
                // ECharts graph 系列：layout 选布局（force/none/circular）；
                // nodes 是 data 的别名（对象形这里解析 name/id/symbolSize/
                // itemStyle/xy）；links 端点可能是名字、id 串（"1"）或序号
                // ——统一按节点名表解析；lineStyle.curveness 即边弯曲。
                if (cs.type == ChartType.Force) {
                    string gly = s.Str("layout", "");
                    if (gly == "force" || gly == "none" || gly == "circular") {
                        cs.graphLayout = gly;
                    }
                    JsonValue esy = s.Get("edgeSymbol");
                    if (esy != null && esy.IsArray()) {
                        for (int ei2 = 0; ei2 < esy.Count(); ei2 = ei2 + 1) {
                            if (esy.At(ei2).AsString("") == "arrow") {
                                cs.forceLinkSymbol = "arrow";
                            }
                        }
                    }
                    JsonValue gls = s.Get("lineStyle");
                    if (gls != null && gls.IsObject()) {
                        JsonValue gcv = gls.Get("curveness");
                        if (gcv != null && gcv.IsNumber()) {
                            cs.forceCurveness =
                                (int)(gcv.AsDouble(0.0) * 1000 + 0.5);
                        }
                    }
                    JsonValue nds = s.Get("nodes");
                    if (nds == null || !nds.IsArray()) { nds = s.Get("data"); }
                    if (nds != null && nds.IsArray()) {
                        for (int ni2 = 0; ni2 < nds.Count(); ni2 = ni2 + 1) {
                            JsonValue nit = nds.At(ni2);
                            ChartData gitem;
                            if (nit.IsObject()) {
                                gitem = ChartData.NamedNumber(
                                    nit.Double("value", 0.0),
                                    nit.Str("name", nit.Str("id", "")));
                                if (nit.Has("symbolSize")) {
                                    gitem.size = nit.Int("symbolSize", 0);
                                    gitem.sizeSet = true;
                                }
                                if (nit.Has("category")) {
                                    gitem.hasCat = true;
                                    gitem.cat = nit.Int("category", 0);
                                }
                                JsonValue glbl = nit.Get("label");
                                if (glbl != null && glbl.IsObject()) {
                                    if (!glbl.Bool("show", true)) {
                                        gitem.labelHide = true;
                                    }
                                    string gpos = glbl.Str("position", "");
                                    if (gpos == "right") { gitem.labelSide = 2; }
                                    else if (gpos == "left") { gitem.labelSide = 1; }
                                }
                                JsonValue gits = nit.Get("itemStyle");
                                if (gits != null && gits.IsObject()) {
                                    gitem.itemStyle = ChartItemStyle.Create();
                                    ChartOption.ParseItemStyle(gits, gitem.itemStyle);
                                    if (gitem.itemStyle.normal.color != 0) {
                                        gitem.color = gitem.itemStyle.normal.color;
                                    }
                                }
                                JsonValue nxv = nit.Get("x");
                                JsonValue nyv = nit.Get("y");
                                if (nxv == null || !nxv.IsNumber()) {
                                    // geo 坐标系：value 是 [lng,lat,...]，
                                    // 折算 0.01° 定点作节点固定坐标
                                    //（layout 缺省即 none 语义）。
                                    JsonValue gvv = nit.Get("value");
                                    if (cs.coordSys == "geo" && gvv != null
                                        && gvv.IsArray() && gvv.Count() >= 2
                                        && gvv.At(0).IsNumber()
                                        && gvv.At(1).IsNumber()) {
                                        nxv = gvv.At(0);
                                        nyv = gvv.At(1);
                                    }
                                }
                                if (nxv != null && nxv.IsNumber()
                                    && nyv != null && nyv.IsNumber()) {
                                    if (cs.coordSys == "geo") {
                                        cs.nodeX.Add(ChartOption.GeoQ(nxv.AsDouble(0.0)));
                                        cs.nodeY.Add(ChartOption.GeoQ(0.0 - nyv.AsDouble(0.0)));
                                    } else {
                                        cs.nodeX.Add(nxv.AsInt(0 - 1));
                                        cs.nodeY.Add(nyv.AsInt(0 - 1));
                                    }
                                } else {
                                    cs.nodeX.Add(0 - 1);
                                    cs.nodeY.Add(0 - 1);
                                }
                            } else {
                                gitem = ChartData.Of(nit.AsInt(0));
                                gitem.name = Convert.ToString(nit.AsInt(0));
                                cs.nodeX.Add(0 - 1);
                                cs.nodeY.Add(0 - 1);
                            }
                            if (gitem.name.Length < 1) {
                                gitem.name = "node-" + Convert.ToString(ni2);
                            }
                            cs.data.Add(gitem);
                        }
                    }
                    // 节点名表：data 项 name（空 = 值串，再空 = node-i）。
                    List<string> gnames = new List<string>();
                    for (int gi = 0; gi < cs.data.Count; gi = gi + 1) {
                        string gn = cs.data[gi].name;
                        if (gn.Length < 1) {
                            gn = Convert.ToString(cs.data[gi].val);
                        }
                        if (gn.Length < 1) {
                            gn = "node-" + Convert.ToString(gi);
                        }
                        gnames.Add(gn);
                    }
                    JsonValue glinks = s.Get("links");
                    if (glinks == null || !glinks.IsArray()) {
                        // links 的别名（geo-graph 用 edges）。
                        glinks = s.Get("edges");
                    }
                    if (glinks != null && glinks.IsArray()) {
                        cs.links = new List<ChartLink>();
                        ChartOption.ParseGraphLinks(glinks, cs.links,
                            gnames);
                    }
                    // 类别名表（图例按类别、节点色 = 类别调色板）。
                    JsonValue gcats = s.Get("categories");
                    if (gcats != null && gcats.IsArray()) {
                        for (int ci2 = 0; ci2 < gcats.Count(); ci2 = ci2 + 1) {
                            JsonValue ct = gcats.At(ci2);
                            if (ct.IsObject()) {
                                cs.graphCats.Add(ct.Str("name", ""));
                            } else {
                                cs.graphCats.Add(ct.AsString(""));
                            }
                        }
                    }
                }
                // ECharts dataset 系列绑定：无内联数据的系列缺省绑
                // datasetIndex 0（显式 datasetId/datasetIndex 覆盖）。
                // 按系列类型分派：pie 取 itemName/value 列、candlestick
                // 取 4 值列 + 类目列、scatter 走数值点（千倍定点）、
                // boxplot（custom=="box"）取五数列，line/bar 走类目-
                // 数值对；seriesLayoutBy:'row' 行转列。
                if (cs.data.Count == 0 && cs.points.Count == 0
                    && cs.candles.Count == 0 && o.datasets.Count > 0
                    && (cs.type != ChartType.Custom || cs.custom == "box")) {
                    ChartJsonDataset ds2 = s.Has("datasetId")
                        ? ChartJsonDataset.ById(o.datasets, s.Str("datasetId", ""))
                        : ChartJsonDataset.At(o.datasets, s.Int("datasetIndex", 0));
                    if (ds2 != null && ds2.RowCount() > 0) {
                        // 同类（同 dataset、同布局）序号：缺省编码的第
                        // ord 条系列取第 ord+1 条值列/行（ECharts 缺省
                        // encode 分派）。
                        string layKey = Convert.ToString(s.Int("datasetIndex", 0)) + "|"
                            + s.Str("seriesLayoutBy", "column");
                        int ord = 0;
                        bool ordSeen = false;
                        for (int bk = 0; bk < bindKeys.Count; bk = bk + 1) {
                            if (bindKeys[bk] == layKey) {
                                ord = bindOrd[bk];
                                bindOrd[bk] = ord + 1;
                                ordSeen = true;
                                break;
                            }
                        }
                        if (!ordSeen) { bindKeys.Add(layKey); bindOrd.Add(1); }
                        JsonValue enc = s.Get("encode");
                        bool encObj = enc != null && enc.IsObject();
                        int xcol = 0;
                        int ycol = 1;
                        if (encObj) {
                            JsonValue exj = enc.Get("x");
                            if (exj != null) {
                                if (exj.IsArray() && exj.Count() > 0) { exj = exj.At(0); }
                                int ex = ds2.ColumnOf(exj);
                                if (ex >= 0) { xcol = ex; }
                            }
                            JsonValue eyj = enc.Get("y");
                            if (eyj != null) {
                                if (eyj.IsArray() && eyj.Count() > 0) { eyj = eyj.At(0); }
                                int ey = ds2.ColumnOf(eyj);
                                if (ey >= 0) { ycol = ey; }
                            }
                        } else if (s.Str("seriesLayoutBy", "column") != "row") {
                            // 缺省编码：第 ord 条系列取值列 ord+1（三根
                            // 裸柱绑 2015/2016/2017 三列）。
                            int dc = ord + 1;
                            if (dc < ds2.Width()) { ycol = dc; }
                        }
                        if (cs.type == ChartType.Pie) {
                            // dataset 饼：itemName 列（缺省 0）作名、
                            // value 列（缺省 1）作值；系列名取值列头。
                            int icol = 0;
                            int vcol = 1;
                            if (encObj) {
                                int ei = ds2.ColumnOf(enc.Get("itemName"));
                                if (ei >= 0) { icol = ei; }
                                int ev = ds2.ColumnOf(enc.Get("value"));
                                if (ev >= 0) { vcol = ev; }
                            }
                            for (int r = 0; r < ds2.RowCount(); r = r + 1) {
                                cs.data.Add(ChartData.NamedNumber(
                                    ds2.Num(r, vcol), ds2.Text(r, icol)));
                            }
                            if (cs.name.Length == 0) { cs.name = ds2.Header(vcol); }
                        } else if (s.Str("seriesLayoutBy", "column") == "row") {
                            // 行转列：第 ord 条数据行就是一条系列，首列
                            // 是系列名，表头行第 1.. 列是类目。
                            if (ord < ds2.RowCount()) {
                                if (cs.name.Length == 0) { cs.name = ds2.Text(ord, 0); }
                                int cols = ds2.Width();
                                for (int c2 = 1; c2 < cols; c2 = c2 + 1) {
                                    cs.data.Add(ChartData.NamedNumber(
                                        ds2.Num(ord, c2), ds2.Header(c2)));
                                }
                            }
                        } else if (cs.type == ChartType.K) {
                            // dataset K 线：encode.y 四元 [open,high,low,
                            // close]（candlestick-large 的 [1,4,3,2]），
                            // 缺省列 1..4；x 列文本回填空类目轴。
                            int oc = 1; int hc = 2; int lc = 3; int cc = 4;
                            if (encObj) {
                                JsonValue kyj = enc.Get("y");
                                if (kyj != null && kyj.IsArray() && kyj.Count() >= 4) {
                                    oc = kyj.At(0).AsInt(1);
                                    hc = kyj.At(1).AsInt(2);
                                    lc = kyj.At(2).AsInt(3);
                                    cc = kyj.At(3).AsInt(4);
                                }
                            }
                            for (int r2 = 0; r2 < ds2.RowCount(); r2 = r2 + 1) {
                                cs.candles.Add(Candle.Of((int)ds2.Num(r2, oc),
                                    (int)ds2.Num(r2, hc), (int)ds2.Num(r2, lc),
                                    (int)ds2.Num(r2, cc)));
                            }
                            int xci = 0;
                            if (encObj) {
                                JsonValue kxj = enc.Get("x");
                                if (kxj != null) {
                                    if (kxj.IsArray() && kxj.Count() > 0) { kxj = kxj.At(0); }
                                    int ex2 = ds2.ColumnOf(kxj);
                                    if (ex2 >= 0) { xci = ex2; }
                                }
                            }
                            if (o.xAxes.Count > 0
                                && o.xAxes[0].type == ChartAxisType.Category
                                && o.xAxes[0].categories.Count == 0) {
                                for (int r3 = 0; r3 < ds2.RowCount(); r3 = r3 + 1) {
                                    o.xAxes[0].categories.Add(ds2.Text(r3, xci));
                                }
                            }
                        } else if (cs.custom == "box") {
                            // dataset 箱线：值列缺省 1..5（low,Q1,Q2,Q3,
                            // high），encode.x 五元覆盖；标签列
                            // encode.itemName（缺省 0）。标签回填到
                            // category 侧的轴（离群点散点按它定位）。
                            int lc = 0;
                            int b0 = 1; int b1 = 2; int b2 = 3; int b3 = 4; int b4 = 5;
                            if (encObj) {
                                JsonValue ixj = enc.Get("itemName");
                                if (ixj != null) {
                                    if (ixj.IsArray() && ixj.Count() > 0) { ixj = ixj.At(0); }
                                    int ei2 = ds2.ColumnOf(ixj);
                                    if (ei2 >= 0) { lc = ei2; }
                                }
                                JsonValue bxj = enc.Get("x");
                                if (bxj != null && bxj.IsArray() && bxj.Count() >= 5) {
                                    int e0 = ds2.ColumnOf(bxj.At(0));
                                    int e1 = ds2.ColumnOf(bxj.At(1));
                                    int e2 = ds2.ColumnOf(bxj.At(2));
                                    int e3 = ds2.ColumnOf(bxj.At(3));
                                    int e4 = ds2.ColumnOf(bxj.At(4));
                                    if (e0 >= 0) { b0 = e0; }
                                    if (e1 >= 0) { b1 = e1; }
                                    if (e2 >= 0) { b2 = e2; }
                                    if (e3 >= 0) { b3 = e3; }
                                    if (e4 >= 0) { b4 = e4; }
                                }
                            }
                            for (int rb = 0; rb < ds2.RowCount(); rb = rb + 1) {
                                cs.boxes.Add(BoxItem.Of(ds2.Text(rb, lc),
                                    ChartJsonDataset.Rint(ds2.Num(rb, b0)),
                                    ChartJsonDataset.Rint(ds2.Num(rb, b1)),
                                    ChartJsonDataset.Rint(ds2.Num(rb, b2)),
                                    ChartJsonDataset.Rint(ds2.Num(rb, b3)),
                                    ChartJsonDataset.Rint(ds2.Num(rb, b4))));
                            }
                            if (cs.name.Length == 0) { cs.name = ds2.Header(b0); }
                            if (o.xAxes.Count > 0
                                && o.xAxes[0].type == ChartAxisType.Category
                                && o.xAxes[0].categories.Count == 0) {
                                for (int rb2 = 0; rb2 < ds2.RowCount(); rb2 = rb2 + 1) {
                                    o.xAxes[0].categories.Add(ds2.Text(rb2, lc));
                                }
                            } else if (o.yAxes.Count > 0
                                && o.yAxes[0].type == ChartAxisType.Category
                                && o.yAxes[0].categories.Count == 0) {
                                for (int rb3 = 0; rb3 < ds2.RowCount(); rb3 = rb3 + 1) {
                                    o.yAxes[0].categories.Add(ds2.Text(rb3, lc));
                                }
                            }
                        } else {
                            // line/bar/scatter 共用：先按列样本推断缺省
                            // 类目轴是否实为数值轴（ECharts 智能推断——
                            // 全数值列 + 轴无显式类目 = value）。
                            int xai2 = cs.axisIndex < o.xAxes.Count ? cs.axisIndex : 0;
                            if (o.xAxes.Count > 0
                                && o.xAxes[xai2].type == ChartAxisType.Category
                                && o.xAxes[xai2].categories.Count == 0
                                && ChartJsonDataset.ColNumeric(ds2, xcol)) {
                                o.xAxes[xai2].type = ChartAxisType.Value;
                            }
                            bool xIsCat = o.xAxes.Count > 0
                                && o.xAxes[xai2].type == ChartAxisType.Category;
                            int yai2 = cs.axisIndex < o.yAxes.Count ? cs.axisIndex : 0;
                            bool yIsCat = o.yAxes.Count > 0
                                && o.yAxes[yai2].type == ChartAxisType.Category;
                            if (cs.type == ChartType.Scatter) {
                                // 散点：千倍定点存 points。类目侧（箱线
                                // 离群点 / 聚合明细散点）在回填好的类目
                                // 轴里查序号 ×1000，数值侧取值 ×1000。
                                // 第三维（聚类号/气泡值）进 point.z。
                                cs.pointG = 1000;
                                int w = ds2.Width();
                                for (int r4 = 0; r4 < ds2.RowCount(); r4 = r4 + 1) {
                                    int px = xIsCat
                                        ? ChartJsonDataset.CatIdx1000(
                                            o.xAxes[xai2], ds2.Text(r4, xcol))
                                        : ChartJsonDataset.Mul1000(ds2.Num(r4, xcol));
                                    int py = yIsCat
                                        ? ChartJsonDataset.CatIdx1000(
                                            o.yAxes[yai2], ds2.Text(r4, ycol))
                                        : ChartJsonDataset.Mul1000(ds2.Num(r4, ycol));
                                    ChartPoint p = ChartPoint.Of(px, py);
                                    if (w > 2) { p.z = (int)ds2.Num(r4, 2); }
                                    cs.points.Add(p);
                                }
                                ChartJsonDataset.PieceColorPoints(o, cs);
                            } else if (yIsCat && !xIsCat) {
                                // 横条（encode0）：类目在 y 列，值取 x 列。
                                for (int r5 = 0; r5 < ds2.RowCount(); r5 = r5 + 1) {
                                    cs.data.Add(ChartData.NamedNumber(
                                        ds2.Num(r5, xcol), ds2.Text(r5, ycol)));
                                }
                                if (cs.name.Length == 0) { cs.name = ds2.Header(xcol); }
                            } else if (xIsCat) {
                                for (int r6 = 0; r6 < ds2.RowCount(); r6 = r6 + 1) {
                                    cs.data.Add(ChartData.NamedNumber(
                                        ds2.Num(r6, ycol), ds2.Text(r6, xcol)));
                                }
                                if (cs.name.Length == 0) { cs.name = ds2.Header(ycol); }
                            } else if (cs.type == ChartType.Line) {
                                // 双数值轴折线（回归拟合线）：数值点。
                                cs.pointG = 1000;
                                for (int r7 = 0; r7 < ds2.RowCount(); r7 = r7 + 1) {
                                    cs.points.Add(ChartPoint.Of(
                                        ChartJsonDataset.Mul1000(ds2.Num(r7, xcol)),
                                        ChartJsonDataset.Mul1000(ds2.Num(r7, ycol))));
                                }
                            }
                        }
                    }
                }
                // 全部子系列解析完后：calendar 坐标系的系列若数据项自身不带
                // 日期（calendar-pie 的 {name,value}），统一落到系列的
                // calCenter（即 pie.center 的日期），否则渲染器无处定位。
                if (cs.coordSys == "calendar" && cs.calCenter >= 0) {
                    for (int q = 0; q < cs.data.Count; q = q + 1) {
                        if (cs.data[q].calDay < 0) { cs.data[q].calDay = cs.calCenter; }
                    }
                }
                o.series.Add(cs);
            }
        }

        // geo 组件合成底图系列：每个 geo 一个 type=Map 的载体系列
        // （isGeoBase）。没有用户 map 系列时插到队首（lead=Map，分发
        // "map"）；有则追加。geo 绑定的散点/路线叠加渲染在
        // DrawGeoMap（后续批次）。
        if (o.geos.Count > 0) {
            for (int gi = 0; gi < o.geos.Count; gi = gi + 1) {
                ChartGeo g = o.geos[gi];
                bool owned = false;
                for (int si = 0; si < o.series.Count; si = si + 1) {
                    ChartSeries s6 = o.series[si];
                    if (s6.type == ChartType.Map && s6.mapName == g.map
                        && s6.geoIndex == gi) { owned = true; break; }
                }
                if (owned) { continue; }
                ChartSeries gs = ChartSeries.Of("", ChartType.Map, new List<int>());
                gs.mapName = g.map;
                gs.geoIndex = gi;
                gs.isGeoBase = true;
                gs.selectedMode = g.selectedMode;
                gs.labelShow = g.labelShow;
                for (int ri = 0; ri < g.regions.Count; ri = ri + 1) {
                    gs.regions.Add(ChartMapRegion.Clone(g.regions[ri]));
                }
                if (g.areaColor != 0) {
                    // itemStyle.areaColor：覆盖前先记成区域显式色。
                    for (int ri2 = 0; ri2 < gs.regions.Count; ri2 = ri2 + 1) {
                        gs.regions[ri2].color = g.areaColor;
                    }
                }
                ChartMaps.BindSeries(gs);
                if (g.areaColor != 0) {
                    for (int ri3 = 0; ri3 < gs.regions.Count; ri3 = ri3 + 1) {
                        gs.regions[ri3].color = g.areaColor;
                    }
                }
                if (!HasUserMapSeries(o)) { o.series.Insert(0, gs); }
                else { o.series.Add(gs); }
            }
        }

        // option 级 markPoint.data 挂到第一个 line/bar 系列（ECharts
        // 全局 markPoint 语义）。bool 形式仅置位标志，渲染器自动推导
        // max/min；对象形式的显式数据项优先于自动推导。
        JsonValue mpOpt = v.Get("markPoint");
        if (mpOpt != null && mpOpt.IsObject()) {
            for (int mi = 0; mi < o.series.Count; mi = mi + 1) {
                ChartSeries ms = o.series[mi];
                if (ms.type == ChartType.Line || ms.type == ChartType.Bar) {
                    ChartOption.ParseMarks(mpOpt, ms.marks);
                    break;
                }
            }
        }

        // ECharts：类目轴未给 data 时，类目来自系列数据（[名, 值]
        // 对或 dataset x 列）。取首个有名字的折线/柱系列按序回填
        // （dataset 绑定的裸柱系列类目全在这里落地）。
        if (o.xAxes.Count > 0
            && o.xAxes[0].type == ChartAxisType.Category
            && o.xAxes[0].categories.Count == 0) {
            for (int sf = 0; sf < o.series.Count; sf = sf + 1) {
                ChartSeries s3 = o.series[sf];
                if (s3.type != ChartType.Line && s3.type != ChartType.Bar) { continue; }
                if (s3.data.Count == 0) { continue; }
                bool anyName = false;
                for (int df = 0; df < s3.data.Count; df = df + 1) {
                    if (s3.data[df].name.Length > 0) {
                        o.xAxes[0].categories.Add(s3.data[df].name);
                        anyName = true;
                    }
                }
                if (anyName) { break; }
            }
        }
        // 旧格式：顶层 labels -> x 轴分类
        JsonValue labels = v.Get("labels");
        if (labels != null && labels.IsArray() && o.xAxes.Count == 0) {
            List<string> cats = new List<string>();
            for (int i2 = 0; i2 < labels.Count(); i2 = i2 + 1) { cats.Add(labels.At(i2).AsString("")); }
            o.xAxes.Add(ChartAxis.Category(cats));
        }
        // ECharts 柱状族方向语义：yAxis category 且 x 侧不是"带类目
        // 的 category 轴"（值轴、无 data 的空类目轴）= 横条
        // （bar-y-category、dataset-encode0）。渲染分派按系列
        // hbar 标志走 HBar。
        if (o.yAxes.Count > 0 && o.yAxes[0].type == ChartAxisType.Category
            && (o.xAxes.Count == 0
                || o.xAxes[0].type != ChartAxisType.Category
                || o.xAxes[0].categories.Count == 0)) {
            for (int hb = 0; hb < o.series.Count; hb = hb + 1) {
                ChartSeries hs = o.series[hb];
                if (hs.type == ChartType.Bar && !hs.hbar) { hs.hbar = true; }
            }
        }
        return o;
    }

    /// 解析 xAxis/yAxis（对象或数组，逐项调 ParseAxisOne）。
    static void ParseAxis(JsonValue v, List<ChartAxis> into, bool isX) {
        if (v == null) { return; }
        if (v.IsArray()) {
            for (int i = 0; i < v.Count(); i = i + 1) {
                ChartOption.ParseAxisOne(v.At(i), into, isX);
            }
            return;
        }
        ChartOption.ParseAxisOne(v, into, isX);
    }

    /// 解析单根轴：category 轴读 data[]，数值轴读 min/max；
    /// name/inverse/nameLocation 与 axisLabel.rotate（钳 -90..90）、
    /// axisLabel.interval 通用。
    static void ParseAxisOne(JsonValue v, List<ChartAxis> into, bool isX) {
        if (v == null || !v.IsObject()) { return; }
        // ECharts 缺省 type（axisModelCreator.ts:143）：option.type ||
        // (option.data ? 'category' : 'value') —— x/y 同一规则，"轴自己
        // 带 data 才是类目轴"。type-less 又无 data 的空对象（scatter-large
        // 的 xAxis:[{}]、scatter-simple 的 xAxis:{}）是**数值轴**；按 x
        // 一律缺省 category 会把散点图的 y 轴线 'auto' 判定错（对侧
        // 类目 ⇒ 不画），而官方画出双线。
        string tyS = v.Str("type", "");
        ChartAxisType ty;
        if (tyS.Length > 0) {
            ty = ChartKinds.AxisOf(tyS);
        } else {
            JsonValue dflt = v.Get("data");
            ty = dflt != null && dflt.IsArray()
                ? ChartAxisType.Category : ChartAxisType.Value;
        }
        ChartAxis a;
        if (ty == ChartAxisType.Category) {
            List<string> cats = new List<string>();
            JsonValue da = v.Get("data");
            if (da != null && da.IsArray()) {
                for (int i = 0; i < da.Count(); i = i + 1) { cats.Add(da.At(i).AsString("")); }
            }
            a = ChartAxis.Category(cats);
        } else {
            a = ChartAxis.Value();
            a.type = ty;
        }
        // 显式 min/max 走公共路径：数值轴固定量程；无 type 缺省成
        // category 的轴也可能只声明 gridIndex/min/max（anscombe 四
        // 重奏，ECharts 依 series 数据推断数值轴），散点视图按它
        // 固定定义域。
        // 显式 min/max（数值形态）：此前 v.AsDouble(AutoD) 作用在轴
        // 对象上恒返回缺省——声明从未生效（line-easing 0..1、anscombe
        // 0..20 全按 auto nice 画）。'dataMin'/'dataMax' 字面量记布尔
        // （精确数据界语义待接线，本 slice 按未声明处理）；超出 int
        // 影子量程的（custom-profile 的 epoch-ms）按未声明，防溢出。
        JsonValue mnv = v.Get("min");
        JsonValue mxv = v.Get("max");
        if (mnv != null || mxv != null) {
            double loD = ChartOption.AutoD();
            double hiD = ChartOption.AutoD();
            if (mnv != null) {
                if (mnv.IsString()) { a.minDataB = mnv.AsString("") == "dataMin"; }
                else { loD = mnv.AsDouble(ChartOption.AutoD()); }
            }
            if (mxv != null) {
                if (mxv.IsString()) { a.maxDataB = mxv.AsString("") == "dataMax"; }
                else { hiD = mxv.AsDouble(ChartOption.AutoD()); }
            }
            if (loD > 2000000000.0 || loD < 0.0 - 2000000000.0) { loD = ChartOption.AutoD(); }
            if (hiD > 2000000000.0 || hiD < 0.0 - 2000000000.0) { hiD = ChartOption.AutoD(); }
            a.SetRange(loD, hiD);
        }
        // yAxis.interval：数值轴刻度步长（bump-chart 的 1）。显式
        // min/max 存在时换算成刻度区间数，轴标签按整数步长落。
        JsonValue ivv = v.Get("interval");
        if (ivv != null && ivv.IsNumber() && !ChartOption.IsAutoD(a.minD)
            && !ChartOption.IsAutoD(a.maxD) && a.maxD > a.minD) {
            double step = ivv.AsDouble(1.0);
            if (step > 0.0) { a.ticks = (int)((a.maxD - a.minD) / step); }
        }
        a.title = v.Str("name", "");
        a.axisId = v.Str("id", "");
        a.reversed = v.Bool("inverse", false);
        // ECharts axis.minInterval / axis.maxInterval（axisCommonTypes.ts:174/178）：
        // nice 步长钳制。未声明记 AutoD()（源码里的 null 分支，
        // axisNiceTicks.ts:263-264）。**0 是合法显式值**，所以只能靠
        // AutoD 哨兵区分"未声明"与"显式 0"，不能用 Has(key) 判定。
        a.minInterval = v.Double("minInterval", ChartOption.AutoD());
        a.maxInterval = v.Double("maxInterval", ChartOption.AutoD());
        // ECharts axis.alignTicks（axisCommonTypes.ts:186），缺省 false。
        a.alignTicks = v.Bool("alignTicks", a.alignTicks);
        // minorTick / minorSplitLine（axisDefault.ts:190-207），缺省 show:false、
        // splitNumber:5。类目轴不支持细分刻度，但解析照收——渲染侧按
        // Axis.ts:204 isOrdinalScale 判定不画。
        JsonValue mtv = v.Get("minorTick");
        if (mtv != null && mtv.IsObject()) {
            a.minorTickShow = mtv.Bool("show", a.minorTickShow);
            int msn = mtv.Int("splitNumber", a.minorTickSplitNumber);
            // Axis.ts:207 保护：不在 (0,100) 内回落 5。
            a.minorTickSplitNumber = (msn > 0 && msn < 100) ? msn : 5;
        }
        JsonValue msv = v.Get("minorSplitLine");
        if (msv != null && msv.IsObject()) {
            a.minorSplitLineShow = msv.Bool("show", a.minorSplitLineShow);
        }
        // axis.scale：ECharts 无默认值（`axisCommonTypes.ts:235 scale?: boolean`），
        // 只在 scaleRawExtentInfo 里按真值判断，缺省等价 false。
        a.scale = v.Bool("scale", a.scale);
        a.nameLocation = v.Str("nameLocation", a.nameLocation);
        a.nameGap = v.Int("nameGap", a.nameGap);
        a.splitArea = v.Bool("splitArea", a.splitArea);
        // ECharts axis.show：整条轴（轴线/刻度/标签）显隐。
        a.show = v.Bool("show", a.show);
        // 轴级 position（**不是** axisLabel.position——旧实现读错了键，
        // 语料里轴级 37 处、axisLabel 级 0 处）。官方对非法/缺省值按
        // "该边已被占则翻对边"定缺省（Grid.ts:464-479），这里保留空串
        // 让消费方按 left/bottom 缺省处理。
        a.position = v.Str("position", a.position);
        // axisLine：onZero 三态（未声明 = 'auto'）、show 三态
        // （未声明 = 'auto'，但类目轴工厂已把缺省记成显式 true，
        // 与官方 axisDefault/categoryAxis 的合并结果一致）、
        // lineStyle.color（24 处语料此前整块丢弃）。
        JsonValue aln = v.Get("axisLine");
        if (aln != null && aln.IsObject()) {
            bool hasOnZero = aln.Has("onZero");
            JsonValue oz = aln.Get("onZero");
            if (hasOnZero && oz != null && oz.IsBool()) {
                a.onZero = oz.AsBool(true) ? 1 : 0;
            } else if (hasOnZero) {
                // 'auto' 或非法值：等价未声明。
                a.onZero = 0 - 1;
            }
            bool hasShow = aln.Has("show");
            JsonValue ls = aln.Get("show");
            if (hasShow && ls != null && ls.IsBool()) {
                a.axisLineShow = ls.AsBool(true) ? 1 : 0;
            } else if (hasShow) {
                a.axisLineShow = 0 - 1;
            }
            JsonValue lstyle = aln.Get("lineStyle");
            if (lstyle != null && lstyle.IsObject()) {
                a.axisLineColor = ChartOption.ParseColor(lstyle.Get("color"), a.axisLineColor);
            }
        }
        // boundaryGap：类目轴点/柱落在格子中间（默认）还是刻度线上。
        if (v.Has("boundaryGap")) {
            JsonValue bg = v.Get("boundaryGap");
            if (bg != null && bg.IsBool()) { a.boundaryGap = bg.AsBool(true); }
        }
        JsonValue al = v.Get("axisLabel");
        if (al != null && al.IsObject()) {
            a.labelRotate = al.Int("rotate", a.labelRotate);
            if (a.labelRotate > 90) { a.labelRotate = 90; }
            if (a.labelRotate < 0 - 90) { a.labelRotate = 0 - 90; }
            JsonValue iv = al.Get("interval");
            if (iv != null && iv.IsNumber()) { a.labelInterval = iv.AsInt(0 - 1); }
            // 标签与轴线像素距离（bump-chart Y=30，X=30）——此前丢弃。
            a.labelMargin = al.Int("margin", a.labelMargin);
            // 模板标签："{value} °C"——{value} 替换为刻度值。
            a.labelFormatter = al.Str("formatter", a.labelFormatter);
            // axisLabel.rich：富文本刻度标签。声明了 rich 才建 labelSt
            // （ParseTextStyle 单点解析全量样式，含 fontSize/color——
            // bar-race-country 的 fontSize:14 也从这里走）；未声明的
            // 轴走原标量路径，渲染不变。
            if (al.Get("rich") != null) {
                ChartTextStyle ast = ChartTextStyle.Create();
                ChartOption.ParseTextStyle(al, ast);
                a.labelSt = ast;
            }
        }
        into.Add(a);
    }
}

/// title 数组的一项（line-gradient 等多标题示例）。top/left 支持
/// 百分比（pct 0..100）或像素（px）；-1 = 未声明（走缺省头位）。
class ChartTitleSpec {
    string text;
    string sub;
    int topPct; int topPx;
    int leftPct; int leftPx;
    string align;   // "center"/"left"/"right"（left 值为关键词时）

    static ChartTitleSpec Of() {
        ChartTitleSpec t = new ChartTitleSpec();
        t.text = ""; t.sub = "";
        t.topPct = 0 - 1; t.topPx = 0 - 1;
        t.leftPct = 0 - 1; t.leftPx = 0 - 1;
        t.align = "";
        return t;
    }
}

/// ECharts calendar 坐标系的一项（calendar 可为对象或数组）。
/// 语义（官方 CalendarModel.defaultOption + Calendar.ts + CalendarView.ts）：
///   range    : "2017"（整年）| "2017-02"（整月）| "2017-02-01"（单日）
///              | ["起点","终点"]
///   orient   : "horizontal"（默认，周为行、横向排月）|
///              "vertical"（周为列、纵向排月）
///   cellSize : 20（两维同）| [w,h]，任一维可为 "auto"（按容器等分）；
///              显式声明 width/height 或 left+right 时该维强制 auto
///   left/top : 官方默认 80 / 60（不是 0）
///   dayLabel/monthLabel/yearLabel : 刻度文字
/// 日期一律存成 1970-01-01 起的天序（负值 = 之前），与时间轴同基准。
class ChartCalendarSpec {
    int rangeT0;        // 起始天序
    int rangeT1;        // 结束天序（含）
    bool vertical;      // orient == "vertical"
    int cellW;          // 单元格宽 px；-1 = auto（按容器等分）
    int cellH;          // 单元格高 px；-1 = auto
    int leftPx; int rightPx; int topPx; int bottomPx;
    bool hasLeft; bool hasRight; bool hasTop; bool hasBottom;
    bool leftCenter; bool rightCenter; bool topCenter; bool bottomCenter;
    int widthPx; int heightPx;   // 显式 width/height（-1 = 未声明）

    // ---- 三种刻度文字（官方默认全部 show:true）----
    bool showDayLabel;    int dayMargin;    string dayPos;    // "start"/"end"
    int dayFirstDay;      string dayNameMap;  int dayColor;   int dayFontSize;
    bool showMonthLabel;  int monthMargin;  string monthPos;  string monthAlign;
    string monthNameMap;  int monthColor;   int monthFontSize;
    bool showYearLabel;   int yearMargin;   string yearPos;
    string yearFormatter; int yearColor;    int yearFontSize;

    // ---- 网格/格线 ----
    bool showSplitLine;   int splitColor;   int splitWidth;
    int itemColor;        int itemBorderWidth; int itemBorderColor;

    static ChartCalendarSpec Of() {
        ChartCalendarSpec c = new ChartCalendarSpec();
        c.rangeT0 = 0; c.rangeT1 = 0;
        c.vertical = false;
        c.cellW = 0 - 1; c.cellH = 0 - 1;
        // 官方 CalendarModel.defaultOption: left 80, top 60
        c.leftPx = 80; c.rightPx = 0 - 1; c.topPx = 60; c.bottomPx = 0 - 1;
        c.hasLeft = true; c.hasRight = false; c.hasTop = true; c.hasBottom = false;
        c.leftCenter = false; c.rightCenter = false;
        c.topCenter = false; c.bottomCenter = false;
        c.widthPx = 0 - 1; c.heightPx = 0 - 1;

        // dayLabel: show true, margin size.s=10, position "start", firstDay 0
        c.showDayLabel = true; c.dayMargin = 10; c.dayPos = "start";
        c.dayFirstDay = 0; c.dayNameMap = ""; c.dayColor = 0; c.dayFontSize = 12;
        // monthLabel: show true, margin 10, position "start", align "center"
        c.showMonthLabel = true; c.monthMargin = 10; c.monthPos = "start";
        c.monthAlign = "center"; c.monthNameMap = ""; c.monthColor = 0;
        c.monthFontSize = 12;
        // yearLabel: show true, margin size.xl=30, position null（按 orient 推）
        c.showYearLabel = true; c.yearMargin = 30; c.yearPos = "";
        c.yearFormatter = ""; c.yearColor = 0; c.yearFontSize = 20;

        c.showSplitLine = true; c.splitColor = 0; c.splitWidth = 1;
        c.itemColor = 0; c.itemBorderWidth = 1; c.itemBorderColor = 0;
        return c;
    }
}

/// grid 数组的一项：矩形四边 inset（百分比或像素），或直接声明
/// width/height（scatter-matrix 的 15 宫格形态）。多 grid 布局按
/// series.xAxisIndex 分组入格。
class ChartGridSpec {
    int lPct; int lPx;
    int tPct; int tPx;
    int rPct; int rPx;
    int bPct; int bPx;
    int wPct; int wPx;
    int hPct; int hPx;
    bool containLabel;

    static ChartGridSpec Of() {
        ChartGridSpec gs = new ChartGridSpec();
        gs.lPct = 0 - 1; gs.lPx = 0 - 1;
        gs.tPct = 0 - 1; gs.tPx = 0 - 1;
        gs.rPct = 0 - 1; gs.rPx = 0 - 1;
        gs.bPct = 0 - 1; gs.bPx = 0 - 1;
        gs.wPct = 0 - 1; gs.wPx = 0 - 1;
        gs.hPct = 0 - 1; gs.hPx = 0 - 1;
        gs.containLabel = false;
        return gs;
    }
}

/// visualMap.piecewise 的一段：[lo,hi]（含端与否）或等值 eq，
/// 命中数据项（dimension 0 = 类目序号 / 1 = 数据值）映射 color。
class ChartVisualPiece {
    bool hasLo; int lo; bool loIncl;
    bool hasHi; int hi; bool hiIncl;
    bool hasEq; int eq;
    int color;
    string label;

    static ChartVisualPiece Of() {
        return new ChartVisualPiece { hasLo = false, lo = 0, loIncl = true,
            hasHi = false, hi = 0, hiIncl = true, hasEq = false, eq = 0,
            color = 0, label = "" };
    }
    /// probe 是否落在本段内。
    bool Hit(int probe) {
        if (hasEq) { return probe == eq; }
        if (!hasLo && !hasHi) { return false; }
        if (hasLo) {
            if (loIncl && probe < lo) { return false; }
            if (!loIncl && probe <= lo) { return false; }
        }
        if (hasHi) {
            if (hiIncl && probe > hi) { return false; }
            if (!hiIncl && probe >= hi) { return false; }
        }
        return true;
    }
}

/// ECharts series.markArea 单条区间带。xMode = 类目 x 竖带
/// （v0/v1 为类目序号）；否则 y 值横带（v0/v1 原始整数域）。
/// color 0 = 主题 mark-area 缺省底色；name 非空时带内顶部
/// 绘制标签（系列色）。
class ChartMarkArea {
    bool xMode;
    int v0; int v1;
    int color;
    string name;

    static ChartMarkArea Of() {
        return new ChartMarkArea { xMode = true, v0 = 0, v1 = 0,
            color = 0, name = "" };
    }
}

/// ECharts visualMap（type = continuous | piecewise）。先覆盖数据
/// 着色通道（面积/符号按 dimension 命中换色）；控件面板绘制
/// （continuous 渐变条 / piecewise 色块列表）随 heatmap/scatter
/// 示例补。min/max/分段界暂按整数域（类目序号与整数值已覆盖
/// 大多数示例；小数值域在 scatter 轮扩 ×1000 定点）。
class ChartVisualMap {
    int type;          // 0 = continuous，1 = piecewise
    bool show;         // 是否绘制控件面板
    bool hasMin; bool hasMax;
    int minV; int maxV;    // ×1000 定点域
    int dimension;     // -1 = 默认（按 0 处理）
    int seriesIndex;   // -1 = 全部系列
    List<int> rangeColors;      // inRange.color 渐变 stop（continuous）
    // 显式声明过 inRange.color（/2.x 的 color）。rangeColors 在
    // "continuous 且未声明颜色"时会填官方缺省彩虹带，那不是用户的
    // 着色意图——接线到全局 o.rampColors 时只能认显式声明，否则
    // scatter-nutrients 的 symbolSize-only visualMap 会把分组色
    // 覆盖成按值彩虹（官方是 piecewise 分组色）。
    bool colorsExplicit;
    // 声明的边界按**原始数据单位**另存一份：minV/maxV 是 ×1000 定点，
    // 大数（map-usa max:38000000 → 3.8e10）强转会溢出成 INT_MIN；
    // 而 o.rampLo/Hi 的消费者（ChartViewMap/Heatmap/Scatter）都按
    // 原值比较，需要原值。超出 int 范围时记 Auto() 按未声明处理。
    int minRaw; int maxRaw;
    List<ChartVisualPiece> pieces;
    // piecewise 类目模式（官方 nutrients）：categories 列出数据列里
    // 出现过的字符串类目，inRange.color 同序一一对应；行按该列的
    // 字符串值查下标取色，找不到的类目走 outOfRange（#ccc）。
    List<string> vmCats;
    // inRange.opacity（0..1000 千分位）：官方 lunar 的 heatmap 是 0.3，
    // 让底下的日历格与叠在上面的农历日名都透出来。0 = 未声明（不透明）。
    int inOpacity;

    static ChartVisualMap Of() {
        ChartVisualMap vm = new ChartVisualMap();
        vm.type = 0; vm.show = true; vm.hasMin = false; vm.hasMax = false;
        vm.minV = 0; vm.maxV = 0; vm.dimension = 0 - 1; vm.seriesIndex = 0 - 1;
        vm.rangeColors = new List<int>();
        vm.colorsExplicit = false;
        vm.minRaw = ChartOption.Auto(); vm.maxRaw = ChartOption.Auto();
        vm.pieces = new List<ChartVisualPiece>();
        vm.vmCats = new List<string>();
        vm.inOpacity = 0;
        return vm;
    }

    static ChartVisualMap Clone(ChartVisualMap src) {
        if (src == null) { return null; }
        ChartVisualMap vm = ChartVisualMap.Of();
        vm.type = src.type; vm.show = src.show;
        vm.hasMin = src.hasMin; vm.hasMax = src.hasMax;
        vm.minV = src.minV; vm.maxV = src.maxV;
        vm.dimension = src.dimension; vm.seriesIndex = src.seriesIndex;
        for (int i = 0; i < src.rangeColors.Count; i = i + 1) {
            vm.rangeColors.Add(src.rangeColors[i]);
        }
        vm.colorsExplicit = src.colorsExplicit;
        vm.minRaw = src.minRaw; vm.maxRaw = src.maxRaw;
        for (int i = 0; i < src.pieces.Count; i = i + 1) { vm.pieces.Add(src.pieces[i]); }
        for (int i = 0; i < src.vmCats.Count; i = i + 1) { vm.vmCats.Add(src.vmCats[i]); }
        vm.inOpacity = src.inOpacity;
        return vm;
    }

    /// inRange.color 多 stop 线性插值；tF 为 0..1000 归一位置。
    static int Lerp(List<int> stops, int tF) {
        int k = stops.Count;
        if (k < 1) { return 0; }
        if (k == 1 || tF <= 0) { return stops[0]; }
        if (tF >= 1000) { return stops[k - 1]; }
        int seg = tF * (k - 1);
        int i = seg / 1000;
        if (i > k - 2) { return stops[k - 1]; }
        int f = seg - i * 1000;
        int a = stops[i]; int b = stops[i + 1];
        int rr = ((a >> 16) & 255) * (1000 - f) / 1000 + ((b >> 16) & 255) * f / 1000;
        int gg = ((a >> 8) & 255) * (1000 - f) / 1000 + ((b >> 8) & 255) * f / 1000;
        int bb = (a & 255) * (1000 - f) / 1000 + (b & 255) * f / 1000;
        int aa = ((a >> 24) & 255) * (1000 - f) / 1000 + ((b >> 24) & 255) * f / 1000;
        return (aa << 24) | (rr << 16) | (gg << 8) | bb;
    }
}

/// ECharts dataset：一个命名数据集。source 保留原始 JSON（首行
/// 约定为表头），rows 是 transform 过滤/排序后的有效行号表。
class ChartJsonDataset {
    string id;
    JsonValue source;
    List<int> rows;
    // dimensions 形态的表头：此时 source 全是数据行（无表头行），
    // 列名查找/表头读取都走 dims。
    List<string> dims;
    // 推断出的无表头形态（首行与数据行同构，如全数值的原始观测
    // 行）：行 0 就是数据。Header/ColumnOf 对它返回空/-1。
    bool noHdr;
    // transform 的第二个结果（如 boxplot 的离群点表），
    // fromTransformResult:1 的数据集克隆这里。
    JsonValue source1;
    List<int> rows1;

    /// 表头占的行数：dimensions / 无表头形态为 0，常规 source 形态
    /// 首行按约定是表头，占 1 行。行号换算全走这里。
    int HdrRows() {
        return (dims != null || noHdr) ? 0 : 1;
    }

    /// 表头行推断（ECharts sourceHeader:'auto' 的对应物）：行 0 至
    /// 少一列是字符串而同列后续行出现数值 => 行 0 是表头；全数值
    /// 或全列同构（K 线日期列）=> 无表头。样本不足两行按有表头。
    static bool HeaderEvidence(JsonValue source) {
        if (source == null || !source.IsArray() || source.Count() < 2) { return true; }
        JsonValue r0 = source.At(0);
        if (!r0.IsArray()) { return true; }
        int cols = r0.Count();
        int check = source.Count() < 20 ? source.Count() : 20;
        for (int c2 = 0; c2 < cols; c2 = c2 + 1) {
            JsonValue h = r0.At(c2);
            if (h == null || h.IsNumber()) { continue; }
            if (h.AsString("").Length == 0) { continue; }
            for (int r = 1; r < check; r = r + 1) {
                JsonValue row = source.At(r);
                if (row == null || !row.IsArray() || c2 >= row.Count()) { continue; }
                JsonValue cell = row.At(c2);
                if (cell != null && cell.IsNumber()) { return true; }
            }
        }
        return false;
    }

    /// 按 id 查数据集；找不到返回 null。
    static ChartJsonDataset ById(List<ChartJsonDataset> list, string want) {
        if (want == null || want.Length == 0) { return null; }
        for (int i = 0; i < list.Count; i = i + 1) {
            if (list[i].id == want) { return list[i]; }
        }
        return null;
    }

    /// datasetIndex 旧形式取数据集；越界返回 null。
    static ChartJsonDataset At(List<ChartJsonDataset> list, int index) {
        if (index < 0 || index >= list.Count) { return null; }
        return list[index];
    }

    /// 行数（不含表头行）。
    int RowCount() {
        if (source == null || !source.IsArray() || rows.Count < 1) { return 0; }
        int n = rows.Count - this.HdrRows();
        return n < 0 ? 0 : n;
    }

    /// 数据列数：dimensions 形态取 dims 长度，常规形态取表头行
    /// 宽度（无表头时取首数据行宽度）。
    int Width() {
        if (dims != null) { return dims.Count; }
        if (source == null || !source.IsArray() || source.Count() < 1) { return 0; }
        JsonValue head = source.At(0);
        if (head == null) { return 0; }
        return head.Count();
    }

    /// 表头列名；越界或无表头返回 ""。第 0 行按约定是表头；
    /// dimensions 形态直接查 dims。
    string Header(int col) {
        if (dims != null) {
            if (col < 0 || col >= dims.Count) { return ""; }
            return dims[col];
        }
        if (source == null || !source.IsArray() || source.Count() < 1) { return ""; }
        JsonValue head = source.At(0);
        if (!head.IsArray() || col < 0 || col >= head.Count()) { return ""; }
        return head.At(col).AsString("");
    }

    /// 列名/序号 -> 列下标（encode 的两种形态）。找不到返回 -1。
    int ColumnOf(JsonValue dim) {
        if (dim == null) { return 0 - 1; }
        if (dim.IsNumber()) { return dim.AsInt(0 - 1); }
        string name = dim.AsString("");
        if (dims != null) {
            for (int c2 = 0; c2 < dims.Count; c2 = c2 + 1) {
                if (dims[c2] == name) { return c2; }
            }
            return 0 - 1;
        }
        if (source == null || !source.IsArray() || source.Count() < 1) { return 0 - 1; }
        JsonValue head = source.At(0);
        if (!head.IsArray()) { return 0 - 1; }
        for (int c = 0; c < head.Count(); c = c + 1) {
            if (head.At(c).AsString("") == name) { return c; }
        }
        return 0 - 1;
    }

    /// 读单元格（绝对行号，含表头行）；越界返回 null。
    JsonValue CellAbs(int absRow, int col) {
        if (source == null || !source.IsArray()) { return null; }
        if (absRow < 0 || absRow >= source.Count()) { return null; }
        JsonValue row = source.At(absRow);
        if (row == null || !row.IsArray() || col < 0 || col >= row.Count()) { return null; }
        return row.At(col);
    }

    /// 读单元格原始 JsonValue；越界返回 null。
    JsonValue Cell(int rowIdx, int col) {
        if (source == null || !source.IsArray()) { return null; }
        if (rowIdx < 0 || rowIdx >= rows.Count) { return null; }
        JsonValue row = source.At(rows[rowIdx]);
        if (row == null || !row.IsArray() || col < 0 || col >= row.Count()) { return null; }
        return row.At(col);
    }

    /// 数据行 r（0 = 第一条数据行）、列 c 的数值。
    double Num(int r, int c) {
        JsonValue cell = Cell(r + this.HdrRows(), c);
        if (cell == null) { return 0.0; }
        if (cell.IsNumber()) { return cell.AsDouble(0.0); }
        return JsonValue.DoubleOf(cell.AsString(""));
    }

    /// 数据行 r、列 c 的文本形态。
    string Text(int r, int c) {
        JsonValue cell = Cell(r + this.HdrRows(), c);
        if (cell == null) { return ""; }
        return cell.AsString("");
    }

    /// 应用 transform（filter / sort / ecStat 回归·聚类；boxplot
    /// 等其余类型暂原样透传源行集）。into 的 source 指向结果数据，
    /// rows 为有效行号表；dims 随上游继承。
    static void Transform(ChartJsonDataset from, ChartJsonDataset into, JsonValue tr) {
        if (tr == null || !tr.IsObject()) { into.rows = from.rows; return; }
        into.source = from.source;
        into.dims = from.dims;
        string type = tr.Str("type", "");
        JsonValue cfg = tr.Get("config");
        if (type == "ecStat:regression") {
            ChartJsonDataset.Regression(from, into, cfg);
            return;
        }
        if (type == "ecStat:clustering") {
            ChartJsonDataset.Clustering(from, into, cfg);
            return;
        }
        if (type == "boxplot") {
            ChartJsonDataset.Boxplot(from, into, cfg);
            return;
        }
        if (type == "ecSimpleTransform:aggregate") {
            ChartJsonDataset.Aggregate(from, into, cfg);
            return;
        }
        if (type == "filter" && cfg != null && cfg.IsObject()) {
            List<int> outRows = new List<int>();
            for (int r = 1; r < from.rows.Count; r = r + 1) {
                if (ChartJsonDataset.FilterRow(from, from.rows[r], cfg)) { outRows.Add(from.rows[r]); }
            }
            into.rows = outRows;
            return;
        }
        if (type == "sort" && cfg != null && (cfg.IsObject() || cfg.IsArray())) {
            List<int> outRows = new List<int>();
            if (from.rows.Count > 0) { outRows.Add(from.rows[0]); }
            for (int sr = 1; sr < from.rows.Count; sr = sr + 1) { outRows.Add(from.rows[sr]); }
            List<JsonValue> cfgs = new List<JsonValue>();
            if (cfg.IsArray()) {
                for (int ci = 0; ci < cfg.Count(); ci = ci + 1) { cfgs.Add(cfg.At(ci)); }
            } else { cfgs.Add(cfg); }
            // 稳定插入排序（行数典型几百，足够）。
            for (int i2 = 1; i2 < outRows.Count; i2 = i2 + 1) {
                int key = outRows[i2];
                int j = i2 - 1;
                while (j >= 0 && ChartJsonDataset.RowLess(from, outRows[j], key, cfgs)) {
                    outRows[j + 1] = outRows[j];
                    j = j - 1;
                }
                outRows[j + 1] = key;
            }
            into.rows = outRows;
            return;
        }
        into.rows = from.rows;
    }

    /// 排序比较：a 行是否应排在 b 行前（按各 cfg 维度/顺序）。
    static bool RowLess(ChartJsonDataset ds, int a, int b, List<JsonValue> cfgs) {
        for (int i = 0; i < cfgs.Count; i = i + 1) {
            JsonValue cfg = cfgs[i];
            if (cfg == null || !cfg.IsObject()) { continue; }
            int col = ds.ColumnOf(cfg.Get("dimension"));
            if (col < 0) { continue; }
            bool asc = cfg.Str("order", "asc") != "desc";
            JsonValue av = ds.CellAbs(a, col);
            JsonValue bv = ds.CellAbs(b, col);
            if (av != null && bv != null && av.IsNumber() && bv.IsNumber()) {
                double ad = av.AsDouble(0.0);
                double bd = bv.AsDouble(0.0);
                if (ad == bd) { continue; }
                return asc ? ad < bd : bd < ad;
            }
            string asv = av == null ? "" : av.AsString("");
            string bsv = bv == null ? "" : bv.AsString("");
            if (asv == bsv) { continue; }
            int cmp = String.CompareOrdinal(asv, bsv);
            return asc ? cmp < 0 : cmp > 0;
        }
        return false;
    }

    // ---- ecStat 变换（回归 / 聚类）--------------------------------
    // 输出按常规 source 形态合成（首行表头），列：回归 [x,y]、
    // 聚类 [x,y,cluster]（outputClusterIndexDimension 固定第 3 列，
    // 与 scatter-clustering 的 visualMap.dimension=2 对齐）。

    /// 用数值行集合成结果 source（带表头行）。
    static JsonValue SynthRows(string[] header, List<List<double>> rows) {
        JsonValue arr = JsonValue.NewArray();
        JsonValue head = JsonValue.NewArray();
        for (int h = 0; h < header.Length; h = h + 1) { head.Append(JsonValue.NewStr(header[h])); }
        arr.Append(head);
        for (int r = 0; r < rows.Count; r = r + 1) {
            JsonValue row = JsonValue.NewArray();
            List<double> src = rows[r];
            for (int c = 0; c < src.Count; c = c + 1) { row.Append(JsonValue.NewDouble(src[c])); }
            arr.Append(row);
        }
        return arr;
    }

    /// echarts boxplot 变换（对照 boxplotTransform.ts）：逐输入行
    /// 一只箱——行内数值升序后取四分位（H=(n−1)p+1 线性插值），
    /// 默认 1.5×IQR 须界（boundIQR:"none" 取极值），结果 0 = 每行
    /// [ItemName, low, Q1, Q2, Q3, high]，结果 1 = 离群点
    /// [ItemName, value]（fromTransformResult:1 取）。itemName 取
    /// 行号或 itemNameFormatter 模板（{value} = 行号）。
    static void Boxplot(ChartJsonDataset from, ChartJsonDataset into, JsonValue cfg) {
        string fmt = cfg == null ? "" : cfg.Str("itemNameFormatter", "");
        double biqr = 1.5;
        if (cfg != null && cfg.Has("boundIQR")) {
            JsonValue bj = cfg.Get("boundIQR");
            if (bj != null && bj.IsNumber()) { biqr = bj.AsDouble(1.5); }
            else if (bj != null && bj.AsString("") == "none") { biqr = 0.0; }
        }
        JsonValue arr0 = JsonValue.NewArray();
        JsonValue head0 = JsonValue.NewArray();
        head0.Append(JsonValue.NewStr("ItemName"));
        head0.Append(JsonValue.NewStr("low"));
        head0.Append(JsonValue.NewStr("Q1"));
        head0.Append(JsonValue.NewStr("Q2"));
        head0.Append(JsonValue.NewStr("Q3"));
        head0.Append(JsonValue.NewStr("high"));
        arr0.Append(head0);
        JsonValue arr1 = JsonValue.NewArray();
        JsonValue head1 = JsonValue.NewArray();
        head1.Append(JsonValue.NewStr("ItemName"));
        head1.Append(JsonValue.NewStr("value"));
        arr1.Append(head1);
        int n = from.RowCount();
        int cols = from.Width();
        for (int r = 0; r < n; r = r + 1) {
            List<double> vals = new List<double>();
            for (int c2 = 0; c2 < cols; c2 = c2 + 1) {
                JsonValue cell = from.Cell(r + from.HdrRows(), c2);
                if (cell != null && cell.IsNumber()) { vals.Add(cell.AsDouble(0.0)); }
            }
            if (vals.Count < 1) { continue; }
            // 升序插入排序（行内数值典型几十个，足够）。
            for (int i = 1; i < vals.Count; i = i + 1) {
                double key = vals[i];
                int j = i - 1;
                while (j >= 0 && vals[j] > key) {
                    vals[j + 1] = vals[j];
                    j = j - 1;
                }
                vals[j + 1] = key;
            }
            double q1 = ChartJsonDataset.Quantile(vals, 0.25);
            double q2 = ChartJsonDataset.Quantile(vals, 0.5);
            double q3 = ChartJsonDataset.Quantile(vals, 0.75);
            double bound = biqr * (q3 - q1);
            double lo = q1 - bound;
            if (lo < vals[0]) { lo = vals[0]; }
            double hi = q3 + bound;
            if (hi > vals[vals.Count - 1]) { hi = vals[vals.Count - 1]; }
            string label = fmt.Length > 0
                ? fmt.Replace("{value}", Convert.ToString(r))
                : Convert.ToString(r);
            JsonValue row0 = JsonValue.NewArray();
            row0.Append(JsonValue.NewStr(label));
            row0.Append(JsonValue.NewDouble(lo));
            row0.Append(JsonValue.NewDouble(q1));
            row0.Append(JsonValue.NewDouble(q2));
            row0.Append(JsonValue.NewDouble(q3));
            row0.Append(JsonValue.NewDouble(hi));
            arr0.Append(row0);
            for (int i2 = 0; i2 < vals.Count; i2 = i2 + 1) {
                if (vals[i2] < lo || vals[i2] > hi) {
                    JsonValue row1 = JsonValue.NewArray();
                    row1.Append(JsonValue.NewStr(label));
                    row1.Append(JsonValue.NewDouble(vals[i2]));
                    arr1.Append(row1);
                }
            }
        }
        into.dims = null;
        into.source = arr0;
        into.rows = new List<int>();
        for (int ri = 0; ri < arr0.Count(); ri = ri + 1) { into.rows.Add(ri); }
        into.source1 = arr1;
        into.rows1 = new List<int>();
        for (int ri2 = 0; ri2 < arr1.Count(); ri2 = ri2 + 1) { into.rows1.Add(ri2); }
    }

    /// ecSimpleTransform:aggregate——按 groupBy 列分组（组序按
    /// 首现顺序），resultDimensions 逐列聚合：method = min/Q1/
    /// median/Q3/max/sum/average/count，缺 method 为直通（取组内
    /// 首行原值）。输出表头 = 各 resultDimension.name。
    static void Aggregate(ChartJsonDataset from, ChartJsonDataset into, JsonValue cfg) {
        JsonValue arr = JsonValue.NewArray();
        JsonValue head = JsonValue.NewArray();
        List<JsonValue> rds = new List<JsonValue>();
        int gcol = 0 - 1;
        if (cfg != null && cfg.IsObject()) {
            JsonValue rj = cfg.Get("resultDimensions");
            if (rj != null && rj.IsArray()) {
                for (int i = 0; i < rj.Count(); i = i + 1) {
                    rds.Add(rj.At(i));
                    head.Append(JsonValue.NewStr(rj.At(i).Str("name", "")));
                }
            }
            gcol = from.ColumnOf(cfg.Get("groupBy"));
        }
        arr.Append(head);
        if (rds.Count > 0) {
            int n = from.RowCount();
            List<string> keys = new List<string>();
            List<List<int>> groups = new List<List<int>>();
            for (int r = 0; r < n; r = r + 1) {
                string key = gcol >= 0 ? from.Text(r, gcol) : "";
                int gi = 0 - 1;
                for (int k = 0; k < keys.Count; k = k + 1) {
                    if (keys[k] == key) { gi = k; break; }
                }
                if (gi < 0) {
                    keys.Add(key);
                    groups.Add(new List<int>());
                    gi = groups.Count - 1;
                }
                groups[gi].Add(r);
            }
            for (int g = 0; g < groups.Count; g = g + 1) {
                List<int> grp = groups[g];
                JsonValue row = JsonValue.NewArray();
                for (int d = 0; d < rds.Count; d = d + 1) {
                    JsonValue rd = rds[d];
                    int col = from.ColumnOf(rd.Get("from"));
                    string method = rd.Str("method", "");
                    if (method.Length == 0 || col < 0) {
                        // 直通：组内首行原值（文本/数值照抄）。
                        JsonValue cell = grp.Count > 0
                            ? from.Cell(grp[0] + from.HdrRows(), col < 0 ? 0 : col)
                            : null;
                        if (cell != null && cell.IsNumber()) {
                            row.Append(JsonValue.NewDouble(cell.AsDouble(0.0)));
                        } else {
                            row.Append(JsonValue.NewStr(cell == null ? "" : cell.AsString("")));
                        }
                        continue;
                    }
                    List<double> vals = new List<double>();
                    for (int gi2 = 0; gi2 < grp.Count; gi2 = gi2 + 1) {
                        JsonValue cell2 = from.Cell(grp[gi2] + from.HdrRows(), col);
                        if (cell2 != null && cell2.IsNumber()) {
                            vals.Add(cell2.AsDouble(0.0));
                        }
                    }
                    double outv = 0.0;
                    if (method == "count") {
                        outv = vals.Count;
                    } else if (vals.Count > 0) {
                        if (method == "sum") {
                            for (int vi = 0; vi < vals.Count; vi = vi + 1) { outv = outv + vals[vi]; }
                        } else if (method == "average") {
                            for (int vi2 = 0; vi2 < vals.Count; vi2 = vi2 + 1) { outv = outv + vals[vi2]; }
                            outv = outv / vals.Count;
                        } else {
                            for (int i3 = 1; i3 < vals.Count; i3 = i3 + 1) {
                                double key = vals[i3];
                                int j = i3 - 1;
                                while (j >= 0 && vals[j] > key) {
                                    vals[j + 1] = vals[j];
                                    j = j - 1;
                                }
                                vals[j + 1] = key;
                            }
                            if (method == "min") { outv = vals[0]; }
                            else if (method == "max") { outv = vals[vals.Count - 1]; }
                            else if (method == "Q1") { outv = ChartJsonDataset.Quantile(vals, 0.25); }
                            else if (method == "median") { outv = ChartJsonDataset.Quantile(vals, 0.5); }
                            else if (method == "Q3") { outv = ChartJsonDataset.Quantile(vals, 0.75); }
                        }
                    }
                    row.Append(JsonValue.NewDouble(outv));
                }
                arr.Append(row);
            }
        }
        ChartJsonDataset.TakeSynth(into, arr);
    }

    /// 分位数（升序序列，H=(n−1)p+1 线性插值，与 echarts
    /// quantile 一致）。
    static double Quantile(List<double> asc, double p) {
        int n = asc.Count;
        if (n < 1) { return 0.0; }
        if (n == 1) { return asc[0]; }
        double h = (n - 1) * p + 1.0;
        int fl = (int)h;
        if (fl < 1) { fl = 1; }
        if (fl > n) { fl = n; }
        double v = asc[fl - 1];
        double e = h - fl;
        if (e > 0.0 && fl < n) { return v + e * (asc[fl] - v); }
        return v;
    }

    /// 合成结果落 into：source 指向新数组，rows 全量、dims 清空。
    static void TakeSynth(ChartJsonDataset into, JsonValue arr) {
        into.dims = null;
        into.source = arr;
        into.rows = new List<int>();
        for (int ri = 0; ri < arr.Count(); ri = ri + 1) { into.rows.Add(ri); }
    }

    /// 列是否全为数值单元格（轴型智能推断：全数值 + 类目轴无显式
    /// data = 该轴实为 value，与 ECharts 行为一致）。
    static bool ColNumeric(ChartJsonDataset ds, int col) {
        int n = ds.RowCount();
        if (n <= 0) { return false; }
        for (int r = 0; r < n; r = r + 1) {
            JsonValue cell = ds.Cell(r + ds.HdrRows(), col);
            if (cell == null || !cell.IsNumber()) { return false; }
        }
        return true;
    }

    /// double -> 千倍定点 int（四舍五入，散点/数值点存储形态）。
    static int Mul1000(double v) {
        return (int)(v >= 0.0 ? v * 1000.0 + 0.5 : v * 1000.0 - 0.5);
    }

    /// double -> 就近 int（箱线五数取整）。
    static int Rint(double v) {
        return (int)(v >= 0.0 ? v + 0.5 : v - 0.5);
    }

    /// 类目位置（×1000 定点）：文本在类目轴里查序号；查不到回落
    /// 0（类目列与轴回填同源，正常都命中）。
    static int CatIdx1000(ChartAxis a, string text) {
        if (a != null) {
            for (int i = 0; i < a.categories.Count; i = i + 1) {
                if (a.categories[i] == text) { return i * 1000; }
            }
        }
        return 0;
    }

    /// piecewise visualMap（pieces 为 value 精确匹配形态）按 point.z
    /// 给散点逐点上色（scatter-clustering 的 cluster 分色）。
    static void PieceColorPoints(ChartOption o, ChartSeries cs) {
        for (int vi = 0; vi < o.visualMaps.Count; vi = vi + 1) {
            ChartVisualMap vm = o.visualMaps[vi];
            if (vm.type != 1 || vm.pieces.Count == 0) { continue; }
            if (vm.dimension >= 0 && vm.dimension != 2) { continue; }
            if (vm.seriesIndex >= 0) { continue; }
            for (int pi = 0; pi < vm.pieces.Count; pi = pi + 1) {
                ChartVisualPiece pc = vm.pieces[pi];
                if (!pc.hasEq || pc.color == 0) { continue; }
                for (int pt = 0; pt < cs.points.Count; pt = pt + 1) {
                    if (cs.points[pt].z == pc.eq) { cs.points[pt].color = pc.color; }
                }
            }
            return;
        }
    }

    /// ecStat:regression——最小二乘拟合。linear/logarithmic/
    /// exponential 输出定义域两端点（与 ecStat 相同的直线形态），
    /// polynomial 输出 33 个等距点勾出曲线。
    static void Regression(ChartJsonDataset from, ChartJsonDataset into, JsonValue cfg) {
        string method = cfg == null ? "linear" : cfg.Str("method", "linear");
        int order = cfg == null ? 2 : cfg.Int("order", 2);
        if (order < 1) { order = 1; }
        if (order > 4) { order = 4; }
        bool lnX = method == "logarithmic";
        bool lnY = method == "exponential";
        List<double> xs = new List<double>();
        List<double> ys = new List<double>();
        int n = from.RowCount();
        for (int r = 0; r < n; r = r + 1) {
            double x = from.Num(r, 0);
            double y = from.Num(r, 1);
            // 定义域保护（与 ecStat 一致：跳过取不到对数的非法行）。
            if (lnX && x <= 0.0) { continue; }
            if (lnY && y <= 0.0) { continue; }
            xs.Add(lnX ? ChartJsonDataset.Ln(x) : x);
            ys.Add(lnY ? ChartJsonDataset.Ln(y) : y);
        }
        List<List<double>> outRows = new List<List<double>>();
        int m = xs.Count;
        if (m >= 2) {
            double minX = 0.0; double maxX = 0.0;
            for (int i = 0; i < m; i = i + 1) {
                if (i == 0 || xs[i] < minX) { minX = xs[i]; }
                if (i == 0 || xs[i] > maxX) { maxX = xs[i]; }
            }
            if (method == "polynomial") {
                // 正规方程 A·c = b（A[i][j] = Σx^(i+j)，b[i] = Σx^i·y），
                // 列主元高斯消元解系数。
                int k = order + 1;
                List<List<double>> A = new List<List<double>>();
                List<double> b = new List<double>();
                for (int i2 = 0; i2 < k; i2 = i2 + 1) {
                    List<double> rowA = new List<double>();
                    for (int j = 0; j < k; j = j + 1) {
                        double s = 0.0;
                        for (int t = 0; t < m; t = t + 1) {
                            s = s + ChartJsonDataset.Pow(xs[t], i2 + j);
                        }
                        rowA.Add(s);
                    }
                    A.Add(rowA);
                    double s2 = 0.0;
                    for (int t2 = 0; t2 < m; t2 = t2 + 1) {
                        s2 = s2 + ys[t2] * ChartJsonDataset.Pow(xs[t2], i2);
                    }
                    b.Add(s2);
                }
                List<double> coef = ChartJsonDataset.Solve(A, b, k);
                int steps = 32;
                for (int si = 0; si <= steps; si = si + 1) {
                    double x = minX + (maxX - minX) * si / steps;
                    double y = 0.0;
                    for (int ci = 0; ci < k; ci = ci + 1) {
                        y = y + coef[ci] * ChartJsonDataset.Pow(x, ci);
                    }
                    List<double> pr = new List<double>();
                    pr.Add(lnX ? ChartJsonDataset.Exp(x) : x);
                    pr.Add(lnY ? ChartJsonDataset.Exp(y) : y);
                    outRows.Add(pr);
                }
            } else {
                double sx = 0.0; double sy = 0.0;
                double sxx = 0.0; double sxy = 0.0;
                for (int i3 = 0; i3 < m; i3 = i3 + 1) {
                    sx = sx + xs[i3]; sy = sy + ys[i3];
                    sxx = sxx + xs[i3] * xs[i3];
                    sxy = sxy + xs[i3] * ys[i3];
                }
                double den = m * sxx - sx * sx;
                double b2 = den != 0.0 ? (m * sxy - sx * sy) / den : 0.0;
                double a = (sy - b2 * sx) / m;
                double y0 = a + b2 * minX;
                double y1 = a + b2 * maxX;
                List<double> p0 = new List<double>();
                p0.Add(lnX ? ChartJsonDataset.Exp(minX) : minX);
                p0.Add(lnY ? ChartJsonDataset.Exp(y0) : y0);
                outRows.Add(p0);
                List<double> p1 = new List<double>();
                p1.Add(lnX ? ChartJsonDataset.Exp(maxX) : maxX);
                p1.Add(lnY ? ChartJsonDataset.Exp(y1) : y1);
                outRows.Add(p1);
            }
        }
        List<string> head = new List<string>();
        head.Add("x");
        head.Add("y");
        ChartJsonDataset.TakeSynth(into, ChartJsonDataset.SynthRows(head.ToArray(), outRows));
    }

    /// ecStat:clustering——确定性 k-means：k-means++ 初始化
    /// （固定种子 LCG，截图回归不抖）+ Lloyd 迭代至多 30 轮。
    /// 输出 [x,y,cluster]。
    static void Clustering(ChartJsonDataset from, ChartJsonDataset into, JsonValue cfg) {
        int k = cfg == null ? 4 : cfg.Int("clusterCount", 4);
        if (k < 1) { k = 1; }
        if (k > 8) { k = 8; }
        List<double> xs = new List<double>();
        List<double> ys = new List<double>();
        int n = from.RowCount();
        if (n > 20000) { n = 20000; }
        for (int r = 0; r < n; r = r + 1) {
            xs.Add(from.Num(r, 0));
            ys.Add(from.Num(r, 1));
        }
        List<List<double>> outRows = new List<List<double>>();
        if (n > 0 && k > n) { k = n; }
        if (n > 0) {
            long seed = 20240601;
            List<double> cx = new List<double>();
            List<double> cy = new List<double>();
            // k-means++：首心取固定种子落点，其后按 D² 加权抽取。
            for (int c = 0; c < k; c = c + 1) {
                if (c == 0) {
                    seed = (seed * 1103515245 + 12345) % 2147483648;
                    int i0 = (int)(seed % n);
                    cx.Add(xs[i0]); cy.Add(ys[i0]);
                    continue;
                }
                double total = 0.0;
                List<double> dist = new List<double>();
                for (int i = 0; i < n; i = i + 1) {
                    double best = 0.0 - 1.0;
                    for (int c2 = 0; c2 < cx.Count; c2 = c2 + 1) {
                        double dx = xs[i] - cx[c2];
                        double dy = ys[i] - cy[c2];
                        double d2 = dx * dx + dy * dy;
                        if (best < 0.0 || d2 < best) { best = d2; }
                    }
                    dist.Add(best < 0.0 ? 0.0 : best);
                    total = total + (best < 0.0 ? 0.0 : best);
                }
                seed = (seed * 1103515245 + 12345) % 2147483648;
                double target = total * (double)(seed % 1000000) / 1000000.0;
                double acc = 0.0;
                int pick = n - 1;
                for (int i2 = 0; i2 < n; i2 = i2 + 1) {
                    acc = acc + dist[i2];
                    if (acc >= target) { pick = i2; break; }
                }
                cx.Add(xs[pick]); cy.Add(ys[pick]);
            }
            List<int> assign = new List<int>();
            for (int i3 = 0; i3 < n; i3 = i3 + 1) { assign.Add(0 - 1); }
            for (int iter = 0; iter < 30; iter = iter + 1) {
                bool changed = false;
                for (int i4 = 0; i4 < n; i4 = i4 + 1) {
                    int bestK = 0;
                    double bestD = 0.0;
                    for (int c3 = 0; c3 < k; c3 = c3 + 1) {
                        double dx = xs[i4] - cx[c3];
                        double dy = ys[i4] - cy[c3];
                        double d2 = dx * dx + dy * dy;
                        if (c3 == 0 || d2 < bestD) { bestD = d2; bestK = c3; }
                    }
                    if (assign[i4] != bestK) { changed = true; assign[i4] = bestK; }
                }
                if (!changed && iter > 0) { break; }
                for (int c4 = 0; c4 < k; c4 = c4 + 1) {
                    double sx = 0.0; double sy = 0.0; int cnt = 0;
                    for (int i5 = 0; i5 < n; i5 = i5 + 1) {
                        if (assign[i5] == c4) {
                            sx = sx + xs[i5]; sy = sy + ys[i5]; cnt = cnt + 1;
                        }
                    }
                    if (cnt > 0) { cx[c4] = sx / cnt; cy[c4] = sy / cnt; }
                }
            }
            for (int i6 = 0; i6 < n; i6 = i6 + 1) {
                List<double> pr = new List<double>();
                pr.Add(xs[i6]);
                pr.Add(ys[i6]);
                pr.Add(assign[i6] < 0 ? 0.0 : (double)assign[i6]);
                outRows.Add(pr);
            }
        }
        List<string> head2 = new List<string>();
        head2.Add("x");
        head2.Add("y");
        head2.Add("cluster");
        ChartJsonDataset.TakeSynth(into, ChartJsonDataset.SynthRows(head2.ToArray(), outRows));
    }

    /// 列主元高斯消元解 k 元线性方程组；奇异时回落零解。
    static List<double> Solve(List<List<double>> A, List<double> b, int k) {
        List<double> x = new List<double>();
        for (int i = 0; i < k; i = i + 1) { x.Add(0.0); }
        for (int col = 0; col < k; col = col + 1) {
            int piv = col;
            double pivAbs = A[piv][col] < 0.0 ? 0.0 - A[piv][col] : A[piv][col];
            for (int r = col + 1; r < k; r = r + 1) {
                double rAbs = A[r][col] < 0.0 ? 0.0 - A[r][col] : A[r][col];
                if (rAbs > pivAbs) { piv = r; pivAbs = rAbs; }
            }
            List<double> tmp = A[col]; A[col] = A[piv]; A[piv] = tmp;
            double tv = b[col]; b[col] = b[piv]; b[piv] = tv;
            double pv = A[col][col];
            if (pv == 0.0) { continue; }
            for (int r2 = col + 1; r2 < k; r2 = r2 + 1) {
                double f = A[r2][col] / pv;
                if (f == 0.0) { continue; }
                for (int c2 = col; c2 < k; c2 = c2 + 1) {
                    A[r2][c2] = A[r2][c2] - f * A[col][c2];
                }
                b[r2] = b[r2] - f * b[col];
            }
        }
        for (int row = k - 1; row >= 0; row = row - 1) {
            double s = b[row];
            for (int c3 = row + 1; c3 < k; c3 = c3 + 1) { s = s - A[row][c3] * x[c3]; }
            x[row] = A[row][row] != 0.0 ? s / A[row][row] : 0.0;
        }
        return x;
    }

    /// 整指数幂（回归正规方程用；负指数回落 0）。
    static double Pow(double b, int e) {
        if (e < 0) { return 0.0; }
        double r = 1.0;
        for (int i = 0; i < e; i = i + 1) { r = r * b; }
        return r;
    }

    const double Ln2 = 0.6931471805599453;

    /// 自然对数：归一到 [0.5,2] 后 atanh 级数
    /// ln(x) = 2(t + t³/3 + t⁵/5 + …)，t = (x−1)/(x+1)。
    static double Ln(double v) {
        if (v <= 0.0) { return 0.0; }
        int k = 0;
        while (v > 2.0) { v = v / 2.0; k = k + 1; }
        while (v < 0.5) { v = v * 2.0; k = k - 1; }
        double t = (v - 1.0) / (v + 1.0);
        double t2 = t * t;
        double s = 0.0;
        double tp = t;
        for (int i = 1; i <= 19; i = i + 2) {
            s = s + tp / i;
            tp = tp * t2;
        }
        return 2.0 * s + k * ChartJsonDataset.Ln2;
    }

    /// 指数：归一到 r∈[−ln2/2, ln2/2] 后泰勒展开，再按 2^k 缩放。
    static double Exp(double v) {
        if (v < 0 - 700.0) { return 0.0; }
        int k = (int)(v / ChartJsonDataset.Ln2 + (v >= 0.0 ? 0.5 : 0 - 0.5));
        double r = v - k * ChartJsonDataset.Ln2;
        double s = 1.0;
        double term = 1.0;
        for (int i = 1; i <= 15; i = i + 1) {
            term = term * r / i;
            s = s + term;
        }
        double p = 1.0;
        int e = k < 0 ? 0 - k : k;
        double b2 = 2.0;
        while (e > 0) {
            if ((e & 1) == 1) { p = p * b2; }
            b2 = b2 * b2;
            e = e >> 1;
        }
        return k < 0 ? s / p : s * p;
    }

    /// 过滤子句：{and:[...]} / {or:[...]} / {dimension, op 值对}。
    static bool FilterRow(ChartJsonDataset ds, int absRow, JsonValue cfg) {
        JsonValue andL = cfg.Get("and");
        if (andL != null && andL.IsArray()) {
            for (int i = 0; i < andL.Count(); i = i + 1) {
                if (!ChartJsonDataset.FilterRow(ds, absRow, andL.At(i))) { return false; }
            }
            return true;
        }
        JsonValue orL = cfg.Get("or");
        if (orL != null && orL.IsArray()) {
            for (int j = 0; j < orL.Count(); j = j + 1) {
                if (ChartJsonDataset.FilterRow(ds, absRow, orL.At(j))) { return true; }
            }
            return false;
        }
        int col = ds.ColumnOf(cfg.Get("dimension"));
        if (col < 0) { return true; }
        JsonValue row = ds.source.At(absRow);
        JsonValue cell = row.IsArray() && col < row.Count() ? row.At(col) : null;
        double cnum = 0.0;
        bool cIsNum = false;
        JsonValue vj = cfg.Get("value");
        if (vj != null) {
            cIsNum = vj.IsNumber();
            if (cIsNum) { cnum = vj.AsDouble(0.0); }
        }
        // ops：'='/='=='/eq、'!='/'ne'、'>'/'gt'、'>='/'gte'、
        // '<'/'lt'、'<='/'lte'。Zan JSON 对象键访问用 Has/Get。
        if (cfg.Has("=") || cfg.Has("==") || cfg.Has("eq")) {
            JsonValue opv = cfg.Has("=") ? cfg.Get("=")
                : (cfg.Has("==") ? cfg.Get("==") : cfg.Get("eq"));
            return ChartJsonDataset.CellEq(cell, opv);
        }
        if (cfg.Has("!=") || cfg.Has("ne")) {
            JsonValue opv2 = cfg.Has("!=") ? cfg.Get("!=") : cfg.Get("ne");
            return !ChartJsonDataset.CellEq(cell, opv2);
        }
        if (cfg.Has(">") || cfg.Has("gt") || cfg.Has(">=") || cfg.Has("gte")
            || cfg.Has("<") || cfg.Has("lt") || cfg.Has("<=") || cfg.Has("lte")) {
            string opk = cfg.Has(">") ? ">" : cfg.Has("gt") ? "gt"
                : cfg.Has(">=") ? ">=" : cfg.Has("gte") ? "gte"
                : cfg.Has("<") ? "<" : cfg.Has("lt") ? "lt"
                : cfg.Has("<=") ? "<=" : "lte";
            JsonValue opv3 = cfg.Get(opk);
            if (opv3 == null) { return true; }
            double cd = opv3.IsNumber() ? opv3.AsDouble(0.0)
                : JsonValue.DoubleOf(opv3.AsString(""));
            double cv = cell == null ? 0.0
                : (cell.IsNumber() ? cell.AsDouble(0.0)
                    : JsonValue.DoubleOf(cell.AsString("")));
            if (opk == ">") { return cv > cd; }
            if (opk == ">=" || opk == "gte") { return cv >= cd; }
            if (opk == "<") { return cv < cd; }
            return cv <= cd;
        }
        return true;
    }

    static bool CellEq(JsonValue cell, JsonValue want) {
        if (cell == null || want == null) { return false; }
        if (want.IsNumber()) {
            double cv = cell.IsNumber() ? cell.AsDouble(0.0)
                : JsonValue.DoubleOf(cell.AsString(""));
            return cv == want.AsDouble(0.0);
        }
        return cell.AsString("") == want.AsString("");
    }
}

/// dataRange.splitList 的一个命名值区间（ECharts dataRange.data）。
/// lo/hi 用 ChartOption.Auto() 表示开口。
class ChartRangeSplit {
    string label;
    int lo;
    int hi;

    /// 构造一个命名区间；lo/hi 可为 ChartOption.Auto() 表示开口。
    static ChartRangeSplit Of(string label, int lo, int hi) {
        ChartRangeSplit s = new ChartRangeSplit();
        s.label = label;
        s.lo = lo;
        s.hi = hi;
        return s;
    }

    /// 深复制；src 为 null 时返回 null。
    static ChartRangeSplit Clone(ChartRangeSplit src) {
        if (src == null) { return null; }
        return ChartRangeSplit.Of(src.label, src.lo, src.hi);
    }
}

/// 一个命名、按列存储的数据集维度。
class ChartDimension {
    string name;
    List<int> values;

    /// 构造一个维度（直接持有 values 列表，不复制）。
    static ChartDimension Of(string name, List<int> values) {
        ChartDimension d = new ChartDimension();
        d.name = name;
        d.values = values;
        return d;
    }
}

/// ECharts 风格共享数据源：命名维度按列存储，外加
/// 可选的 x 轴分类标签。一个数据集可通过
/// EncodeBy / EncodeNamed 选择不同维度来驱动多个图表——
/// 调用方从不复制或重构底层列表。
class ChartDataset {
    List<ChartDimension> dimensions;
    List<string> cats;         // 可选的 x 轴分类标签（可为空）

    /// 构造数据集（cats 初始为空，用 Labels() 的 1..N 兜底）。
    static ChartDataset Of(List<ChartDimension> dimensions) {
        ChartDataset d = new ChartDataset();
        d.dimensions = dimensions;
        d.cats = new List<string>();
        return d;
    }

    /// 构造数据集并附带显式 x 轴分类标签。
    static ChartDataset WithCats(List<ChartDimension> dimensions,
                                 List<string> cats) {
        ChartDataset d = ChartDataset.Of(dimensions);
        d.cats = cats;
        return d;
    }

    /// 行数 = 第一维度的值数；无维度时为 0。
    int RowCount() {
        if (this.dimensions.Count == 0) { return 0; }
        return this.dimensions[0].values.Count;
    }

    /// 按名称查找维度的索引，不存在返回 -1。
    int DimOf(string name) {
        for (int i = 0; i < this.dimensions.Count; i = i + 1) {
            if (this.dimensions[i].name == name) { return i; }
        }
        return 0 - 1;
    }

    /// x 轴分类标签：给定 `cats` 时用显式值，否则
    /// 用字符串形式的 1..RowCount。
    List<string> Labels() {
        if (this.cats.Count > 0) { return this.cats; }
        List<string> outp = new List<string>();
        int n = this.RowCount();
        for (int i = 0; i < n; i = i + 1) { outp.Add(Convert.ToString(i + 1)); }
        return outp;
    }

    /// 从一组数值维度（按索引）构建 ChartOption。
    /// 系列名取自维度名；颜色从主题自动解析。
    ChartOption EncodeBy(string title, List<int> yDims, ChartType type) {
        List<ChartSeries> ser = new List<ChartSeries>();
        for (int i = 0; i < yDims.Count; i = i + 1) {
            int d = yDims[i];
            if (d >= 0 && d < this.dimensions.Count) {
                ChartDimension dim = this.dimensions[d];
                ser.Add(ChartSeries.Of(dim.name, type, dim.values));
            }
        }
        ChartOption o = ChartOption.Of(ser);
        o.title = title;
        o.Categories(this.Labels());
        return o;
    }

    /// 同 EncodeBy，但按名称选择维度。
    ChartOption EncodeNamed(string title, List<string> yNames, ChartType type) {
        List<int> yd = new List<int>();
        for (int i = 0; i < yNames.Count; i = i + 1) {
            int d = this.DimOf(yNames[i]);
            if (d >= 0) { yd.Add(d); }
        }
        return this.EncodeBy(title, yd, type);
    }
}
