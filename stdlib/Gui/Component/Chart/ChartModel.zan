using System;
using System.Json;
using Gui;

namespace Gui.Component.Chart;

/// Chart family constants, mirroring ECharts series.type. An enum (not bare
/// strings or magic ints) so typos fail at compile time and the IDE completes
/// members; JSON documents map through ChartKinds.TypeOf/TypeName.
enum ChartType {
    Line, Area, Bar, StackedBar, HBar, Pie, Donut, Scatter, Gauge,
    RadialBars, Heatmap, StepLine, StackedArea, Candlestick, Bubble,
    Box, ErrorBar, Polar, Funnel, Pyramid, Rose,
    Waterfall, Treemap, Sunburst, Sankey, StackedLine
}

/// Axis kind, mirroring ECharts xAxis/yAxis.type.
enum ChartAxisType {
    Category, Value, Time
}

/// ECharts-style string <-> enum mapping for ChartType / ChartAxisType, so the
/// same chart can be declared in code (ChartType.Bar) or in a JSON document
/// ("type": "bar") without the two ever drifting apart.
class ChartKinds {
    static ChartType TypeOf(string s) {
        if (s == "area") { return ChartType.Area; }
        if (s == "bar") { return ChartType.Bar; }
        if (s == "stackedbar") { return ChartType.StackedBar; }
        if (s == "hbar") { return ChartType.HBar; }
        if (s == "pie") { return ChartType.Pie; }
        if (s == "donut") { return ChartType.Donut; }
        if (s == "scatter") { return ChartType.Scatter; }
        if (s == "gauge") { return ChartType.Gauge; }
        if (s == "radialbars") { return ChartType.RadialBars; }
        if (s == "heatmap") { return ChartType.Heatmap; }
        if (s == "stepline") { return ChartType.StepLine; }
        if (s == "stackedarea") { return ChartType.StackedArea; }
        if (s == "candlestick" || s == "k") { return ChartType.Candlestick; }
        if (s == "bubble") { return ChartType.Bubble; }
        if (s == "box") { return ChartType.Box; }
        if (s == "errorbar") { return ChartType.ErrorBar; }
        if (s == "polar" || s == "radar") { return ChartType.Polar; }
        if (s == "funnel") { return ChartType.Funnel; }
        if (s == "pyramid") { return ChartType.Pyramid; }
        if (s == "rose") { return ChartType.Rose; }
        if (s == "waterfall") { return ChartType.Waterfall; }
        if (s == "treemap") { return ChartType.Treemap; }
        if (s == "sunburst") { return ChartType.Sunburst; }
        if (s == "sankey") { return ChartType.Sankey; }
        if (s == "stackedline") { return ChartType.StackedLine; }
        return ChartType.Line;
    }

    static string TypeName(ChartType t) {
        if (t == ChartType.Area) { return "area"; }
        if (t == ChartType.Bar) { return "bar"; }
        if (t == ChartType.StackedBar) { return "stackedbar"; }
        if (t == ChartType.HBar) { return "hbar"; }
        if (t == ChartType.Pie) { return "pie"; }
        if (t == ChartType.Donut) { return "donut"; }
        if (t == ChartType.Scatter) { return "scatter"; }
        if (t == ChartType.Gauge) { return "gauge"; }
        if (t == ChartType.RadialBars) { return "radialbars"; }
        if (t == ChartType.Heatmap) { return "heatmap"; }
        if (t == ChartType.StepLine) { return "stepline"; }
        if (t == ChartType.StackedArea) { return "stackedarea"; }
        if (t == ChartType.Candlestick) { return "candlestick"; }
        if (t == ChartType.Bubble) { return "bubble"; }
        if (t == ChartType.Box) { return "box"; }
        if (t == ChartType.ErrorBar) { return "errorbar"; }
        if (t == ChartType.Polar) { return "polar"; }
        if (t == ChartType.Funnel) { return "funnel"; }
        if (t == ChartType.Pyramid) { return "pyramid"; }
        if (t == ChartType.Rose) { return "rose"; }
        if (t == ChartType.Waterfall) { return "waterfall"; }
        if (t == ChartType.Treemap) { return "treemap"; }
        if (t == ChartType.Sunburst) { return "sunburst"; }
        if (t == ChartType.Sankey) { return "sankey"; }
        if (t == ChartType.StackedLine) { return "stackedline"; }
        return "line";
    }

    static ChartAxisType AxisOf(string s) {
        if (s == "value") { return ChartAxisType.Value; }
        if (s == "time") { return ChartAxisType.Time; }
        return ChartAxisType.Category;
    }

    static string AxisName(ChartAxisType t) {
        if (t == ChartAxisType.Value) { return "value"; }
        if (t == ChartAxisType.Time) { return "time"; }
        return "category";
    }
}

/// One data point (ECharts series.data[i]): a value plus an optional name
/// (slice / category label) and color. Color 0 means "inherit the series
/// color" — this is the third level of ECharts' three-level control
/// (option < series < data item).
class ChartData {
    int val;
    string name;    // "" = inherit the series name
    int color;      // 0 = inherit the series color

    static ChartData Of(int v) {
        ChartData d = new ChartData();
        d.val = v;
        d.name = "";
        d.color = 0;
        return d;
    }

    static ChartData Named(int v, string name) {
        ChartData d = ChartData.Of(v);
        d.name = name;
        return d;
    }

    static ChartData Colored(int v, int color) {
        ChartData d = ChartData.Of(v);
        d.color = color;
        return d;
    }

    static ChartData Full(int v, string name, int color) {
        ChartData d = ChartData.Of(v);
        d.name = name;
        d.color = color;
        return d;
    }
}

/// One OHLC bar for a financial / candlestick chart.
class Candle {
    int open;
    int high;
    int low;
    int close;
    static Candle Of(int open, int high, int low, int close) {
        Candle c = new Candle();
        c.open = open;
        c.high = high;
        c.low = low;
        c.close = close;
        return c;
    }
}

/// A weighted scatter point (x, y and a weight that sizes the bubble).
class Bubble {
    int x;
    int y;
    int weight;
    static Bubble Of(int x, int y, int weight) {
        Bubble b = new Bubble();
        b.x = x;
        b.y = y;
        b.weight = weight;
        return b;
    }
}

/// A box-and-whisker statistic (min, lower quartile, median, upper quartile, max).
class BoxItem {
    int lo;
    int q1;
    int med;
    int q3;
    int hi;
    static BoxItem Of(int lo, int q1, int med, int q3, int hi) {
        BoxItem b = new BoxItem();
        b.lo = lo;
        b.q1 = q1;
        b.med = med;
        b.q3 = q3;
        b.hi = hi;
        return b;
    }
}

/// A value with a symmetric error margin (y +/- err) for error-bar charts.
class ErrorItem {
    int y;
    int err;
    static ErrorItem Of(int y, int err) {
        ErrorItem e = new ErrorItem();
        e.y = y;
        e.err = err;
        return e;
    }
}

/// One funnel/rose/pie stage: a value, its fill color and a display name.
class ChartStage {
    int val;
    int color;
    string name;

    ChartStage(int v, int col, string nm) {
        val = v;
        color = col;
        name = nm;
    }
}

/// A hierarchical node for Treemap / Sunburst charts: a name, a value and
/// nested children. Leaves carry the value; a Group's value is derived from
/// its children (rendered as the group's total / ring sweep).
class ChartNode {
    string name;
    int val;
    List<ChartNode> children;

    static ChartNode Leaf(string name, int val) {
        ChartNode n = new ChartNode();
        n.name = name;
        n.val = val;
        n.children = new List<ChartNode>();
        return n;
    }

    static ChartNode Group(string name, List<ChartNode> children) {
        ChartNode n = new ChartNode();
        n.name = name;
        n.val = 0;
        n.children = children;
        return n;
    }

    /// Sum of the leaf values under this node (the group's total).
    int Total() {
        if (this.children.Count == 0) { return this.val; }
        int sum = 0;
        int i = 0;
        while (i < this.children.Count) { sum = sum + this.children[i].Total(); i = i + 1; }
        return sum;
    }
}

/// A directed flow link for Sankey charts: from node -> to node with a value
/// (the link thickness). Nodes are derived from the links at render time.
class ChartLink {
    string from;
    string to;
    int val;

    static ChartLink Of(string from, string to, int val) {
        ChartLink l = new ChartLink();
        l.from = from;
        l.to = to;
        l.val = val;
        return l;
    }
}

/// One data series (ECharts series[i]). Every series carries its own type, so
/// mixed charts fall out naturally: a bar chart with a line overlay is just two
/// series of different types sharing one coordinate system — no AsKind shim.
/// axisIndex binds the series to a yAxis (0 = left/primary, 1 = right/secondary);
/// stack groups series into one stacked column/area (same positive id; the
/// StackedBar / StackedArea types default to stack = 1). Data is a uniform
/// List<ChartData>; the multi-value families (candle/bubble/box/error/scatter)
/// use their dedicated lists instead.
class ChartSeries {
    string name;
    ChartType type;
    int axisIndex;   // 0 = left/primary Y axis, 1 = right/secondary Y axis
    int stack;       // 0 = none; series sharing a positive id stack together
    string stackName; // ECharts stack group: series with the same name stack
    int color;       // 0 = auto (palette)
    bool hidden;     // toggled off via the interactive legend
    int smooth;      // -1 = follow option.smooth, 0/1 = per-series override
    List<ChartData> data;
    List<Candle> candles;      // Candlestick kind
    List<Bubble> bubbles;      // Bubble kind
    List<BoxItem> boxes;       // Box kind
    List<ErrorItem> errors;    // ErrorBar kind
    List<int> scatterX;        // Scatter kind
    List<int> scatterY;
    List<ChartNode> tree;      // Treemap / Sunburst (hierarchical root list)
    List<ChartLink> links;     // Sankey kind

    /// Build a series from plain int values (each becomes a ChartData.Of(v)).
    static ChartSeries Of(string name, ChartType type, List<int> values) {
        ChartSeries s = new ChartSeries();
        s.name = name;
        s.type = type;
        s.axisIndex = 0;
        s.stack = 0;
        s.stackName = "";
        s.color = 0;
        s.hidden = false;
        s.smooth = 0 - 1;
        s.data = new List<ChartData>();
        int i = 0;
        while (i < values.Count) { s.data.Add(ChartData.Of(values[i])); i = i + 1; }
        s.candles = new List<Candle>();
        s.bubbles = new List<Bubble>();
        s.boxes = new List<BoxItem>();
        s.errors = new List<ErrorItem>();
        s.scatterX = new List<int>();
        s.scatterY = new List<int>();
        s.tree = new List<ChartNode>();
        s.links = new List<ChartLink>();
        if (type == ChartType.StackedBar || type == ChartType.StackedArea) { s.stack = 1; }
        return s;
    }

    /// Build a series from explicit data items (names / per-item colors).
    static ChartSeries Named(string name, ChartType type, List<ChartData> data) {
        ChartSeries s = ChartSeries.Of(name, type, new List<int>());
        s.data = data;
        return s;
    }

    // ---- typed factories: one series per call, ECharts series[i] style ----
    // `ChartSeries.Line("邮件营销", new List<int>{ ... })` reads like
    // `{ name: '邮件营销', type: 'line', data: [...] }` in ECharts.

    static ChartSeries Line(string name, List<int> values) { return ChartSeries.Of(name, ChartType.Line, values); }
    static ChartSeries Area(string name, List<int> values) { return ChartSeries.Of(name, ChartType.Area, values); }
    static ChartSeries Bar(string name, List<int> values) { return ChartSeries.Of(name, ChartType.Bar, values); }
    static ChartSeries StackedBar(string name, List<int> values) { return ChartSeries.Of(name, ChartType.StackedBar, values); }
    static ChartSeries HBar(string name, List<int> values) { return ChartSeries.Of(name, ChartType.HBar, values); }
    static ChartSeries StepLine(string name, List<int> values) { return ChartSeries.Of(name, ChartType.StepLine, values); }
    static ChartSeries StackedLine(string name, List<int> values) { return ChartSeries.Of(name, ChartType.StackedLine, values); }
    static ChartSeries StackedArea(string name, List<int> values) { return ChartSeries.Of(name, ChartType.StackedArea, values); }
    static ChartSeries Pie(string name, List<int> values) { return ChartSeries.Of(name, ChartType.Pie, values); }
    static ChartSeries Donut(string name, List<int> values) { return ChartSeries.Of(name, ChartType.Donut, values); }
    static ChartSeries Polar(string name, List<int> values) { return ChartSeries.Of(name, ChartType.Polar, values); }
    static ChartSeries Funnel(string name, List<int> values) { return ChartSeries.Of(name, ChartType.Funnel, values); }
    static ChartSeries Pyramid(string name, List<int> values) { return ChartSeries.Of(name, ChartType.Pyramid, values); }
    static ChartSeries Rose(string name, List<int> values) { return ChartSeries.Of(name, ChartType.Rose, values); }

    /// Candlestick series from OHLC bars.
    static ChartSeries OfCandles(string name, List<Candle> candles) {
        ChartSeries s = ChartSeries.Of(name, ChartType.Candlestick, new List<int>());
        s.candles = candles;
        return s;
    }

    /// Weighted-scatter series from bubbles.
    static ChartSeries OfBubbles(string name, List<Bubble> bubbles) {
        ChartSeries s = ChartSeries.Of(name, ChartType.Bubble, new List<int>());
        s.bubbles = bubbles;
        return s;
    }

    /// Box-plot series from per-category statistics.
    static ChartSeries OfBoxes(string name, List<BoxItem> boxes) {
        ChartSeries s = ChartSeries.Of(name, ChartType.Box, new List<int>());
        s.boxes = boxes;
        return s;
    }

    /// Error-bar series from value +/- margin pairs.
    static ChartSeries OfErrors(string name, List<ErrorItem> errors) {
        ChartSeries s = ChartSeries.Of(name, ChartType.ErrorBar, new List<int>());
        s.errors = errors;
        return s;
    }

    /// Scatter series from parallel x/y point lists.
    static ChartSeries OfPoints(string name, List<int> xs, List<int> ys) {
        ChartSeries s = ChartSeries.Of(name, ChartType.Scatter, new List<int>());
        s.scatterX = xs;
        s.scatterY = ys;
        return s;
    }

    /// Hierarchical series (Treemap / Sunburst) from a root node. The series
    /// holds the root list; children nest arbitrarily deep.
    static ChartSeries OfTree(string name, ChartType type, ChartNode root) {
        ChartSeries s = ChartSeries.Of(name, type, new List<int>());
        s.tree.Add(root);
        return s;
    }

    /// Sankey series from directed flow links (nodes are derived from links).
    static ChartSeries OfLinks(string name, List<ChartLink> links) {
        ChartSeries s = ChartSeries.Of(name, ChartType.Sankey, new List<int>());
        s.links = links;
        return s;
    }

    int Count() { return this.data.Count; }

    int Value(int i) {
        if (i < 0 || i >= this.data.Count) { return 0; }
        return this.data[i].val;
    }
}

/// One coordinate axis (ECharts xAxis/yAxis entry). Category axes carry their
/// labels; value axes carry an optional fixed range (ChartOption.Auto() derives
/// from the data) and a tick count.
class ChartAxis {
    ChartAxisType type;
    string title;     // axis name (ECharts name), "" = none
    int min;          // ChartOption.Auto() = derive from data
    int max;
    bool reversed;    // flip the axis (ECharts inverse)
    int ticks;        // value-axis divisions (default 5)
    bool showGrid;    // draw gridlines for this axis
    List<string> categories;

    static ChartAxis Category(List<string> cats) {
        ChartAxis a = new ChartAxis();
        a.type = ChartAxisType.Category;
        a.title = "";
        a.min = ChartOption.Auto();
        a.max = ChartOption.Auto();
        a.reversed = false;
        a.ticks = 5;
        a.showGrid = false;
        a.categories = cats;
        return a;
    }

    static ChartAxis CategoryTitled(List<string> cats, string title) {
        ChartAxis a = ChartAxis.Category(cats);
        a.title = title;
        return a;
    }

    static ChartAxis Value() {
        ChartAxis a = new ChartAxis();
        a.type = ChartAxisType.Value;
        a.title = "";
        a.min = ChartOption.Auto();
        a.max = ChartOption.Auto();
        a.reversed = false;
        a.ticks = 5;
        a.showGrid = true;
        a.categories = new List<string>();
        return a;
    }

    static ChartAxis ValueRange(int min, int max) {
        ChartAxis a = ChartAxis.Value();
        a.min = min;
        a.max = max;
        return a;
    }

    static ChartAxis ValueTitled(string title) {
        ChartAxis a = ChartAxis.Value();
        a.title = title;
        return a;
    }

    static ChartAxis Time() {
        ChartAxis a = ChartAxis.Value();
        a.type = ChartAxisType.Time;
        return a;
    }
}

/// The full chart configuration (ECharts option): title, coordinate axes,
/// series and every presentation knob in one place. Build with Create() /
/// Of(series) / FromJson(), tweak fields directly, then hand it to
/// ChartView.Of(option).Render(app, x, y, w, h). Three-level control mirrors
/// ECharts: option.* (global) < series.* (per series) < data[i].* (per item).
class ChartOption {
    string title;
    List<ChartAxis> xAxes;
    List<ChartAxis> yAxes;
    List<ChartSeries> series;

    ChartType defaultType; // type used by Add(name, values) / AddLabel

    bool showLegend;  // series legend in the panel header
    bool showTooltip; // hover crosshair + value tooltip (cartesian charts)
    bool showGrid;    // value gridlines
    bool showValues;  // value labels on points / bar tops
    bool animate;     // grow-in intro animation on first render
    bool smooth;      // global smoothing; a series' smooth field overrides it
    bool gradient;    // vertical gradient fills (area / bars)
    bool rounded;     // rounded bar caps
    int animMs;       // intro animation duration (ms)
    int donutPct;     // donut inner radius as a % of the outer
    int gaugeMax;     // full-scale value for Gauge / RadialBars (default 100)
    bool pieLabels;   // draw percentage labels on pie/donut slices
    bool zoom;        // show a dataZoom range slider below cartesian charts
    int markLine;     // horizontal threshold line on the left axis (Auto = none)
    string markLabel; // label shown at the markLine
    int markLo;       // shaded markArea band [markLo, markHi] (Auto = none)
    int markHi;
    int gridLeft;     // plot inset overrides in px (-1 = auto from labels)
    int gridRight;
    int gridTop;
    int gridBottom;
    int iwid;         // interaction key (set per-frame by ChartView.Render); 0 = none

    /// Sentinel meaning "derive this bound from the data".
    static int Auto() { return 0 - 2000000000; }

    static ChartOption Create() {
        ChartOption o = new ChartOption();
        o.title = "";
        o.xAxes = new List<ChartAxis>();
        o.yAxes = new List<ChartAxis>();
        o.series = new List<ChartSeries>();
        o.defaultType = ChartType.Line;
        o.showLegend = true;
        o.showTooltip = true;
        o.showGrid = true;
        o.showValues = false;
        o.animate = true;
        o.smooth = false;
        o.gradient = true;
        o.rounded = true;
        o.animMs = 650;
        o.donutPct = 55;
        o.gaugeMax = 100;
        o.pieLabels = false;
        o.zoom = false;
        o.markLine = ChartOption.Auto();
        o.markLabel = "";
        o.markLo = ChartOption.Auto();
        o.markHi = ChartOption.Auto();
        o.gridLeft = 0 - 1;
        o.gridRight = 0 - 1;
        o.gridTop = 0 - 1;
        o.gridBottom = 0 - 1;
        o.iwid = 0;
        return o;
    }

    static ChartOption Of(List<ChartSeries> series) {
        ChartOption o = ChartOption.Create();
        o.series = series;
        return o;
    }

    /// Declarative one-shot: title + category axis + the whole series list —
    /// mirrors ECharts `{ title, xAxis.data, series }`. Mixed charts are just
    /// series of different types in the list.
    static ChartOption Of(string title, List<string> categories, List<ChartSeries> series) {
        ChartOption o = ChartOption.Create();
        o.title = title;
        if (categories != null && categories.Count > 0) { o.Categories(categories); }
        o.series = series;
        return o;
    }

    static ChartOption Single(ChartSeries s) {
        List<ChartSeries> ss = new List<ChartSeries>();
        ss.Add(s);
        return ChartOption.Of(ss);
    }

    // ---- declarative factories: one call builds the default type + axes ----

    /// Base factory: default series type + optional category axis. Pie/donut
    /// families use the categories as slice labels; cartesian families as the
    /// x-axis labels.
    static ChartOption With(ChartType t, string title, List<string> cats) {
        ChartOption o = ChartOption.Create();
        o.title = title;
        o.defaultType = t;
        if (cats != null && cats.Count > 0) { o.Categories(cats); }
        return o;
    }

    static ChartOption Line(string title, List<string> cats) { return ChartOption.With(ChartType.Line, title, cats); }
    static ChartOption Area(string title, List<string> cats) { return ChartOption.With(ChartType.Area, title, cats); }
    static ChartOption Bar(string title, List<string> cats) { return ChartOption.With(ChartType.Bar, title, cats); }
    static ChartOption StackedBar(string title, List<string> cats) { return ChartOption.With(ChartType.StackedBar, title, cats); }
    static ChartOption HBar(string title, List<string> cats) { return ChartOption.With(ChartType.HBar, title, cats); }
    static ChartOption Pie(string title, List<string> cats) { return ChartOption.With(ChartType.Pie, title, cats); }
    static ChartOption Donut(string title, List<string> cats) { return ChartOption.With(ChartType.Donut, title, cats); }
    static ChartOption Waterfall(string title, List<string> cats) { return ChartOption.With(ChartType.Waterfall, title, cats); }
    static ChartOption Scatter(string title) { return ChartOption.With(ChartType.Scatter, title, null); }
    static ChartOption Treemap(string title) { return ChartOption.With(ChartType.Treemap, title, null); }
    static ChartOption Sunburst(string title) { return ChartOption.With(ChartType.Sunburst, title, null); }
    static ChartOption Sankey(string title) { return ChartOption.With(ChartType.Sankey, title, null); }

    /// Add a series of the option's default type; color auto-assigned.
    ChartOption Add(string name, List<int> values) {
        this.series.Add(ChartSeries.Of(name, this.defaultType, values));
        return this;
    }

    /// Add a series with an explicit type (mixed charts: bar + line overlay).
    ChartOption Add(string name, ChartType type, List<int> values) {
        this.series.Add(ChartSeries.Of(name, type, values));
        return this;
    }

    /// Add a series from named/colored data items (per-item labels for pie,
    /// waterfall total bars, per-slice colors, ...).
    ChartOption AddLabel(string name, List<ChartData> data) {
        this.series.Add(ChartSeries.Named(name, this.defaultType, data));
        return this;
    }

    /// Add a ready-made series (explicit color / dedicated data lists).
    ChartOption Add(ChartSeries s) { this.series.Add(s); return this; }

    /// Quick way to set a category x axis (ECharts xAxis.data).
    ChartOption Categories(List<string> cats) {
        this.xAxes.Add(ChartAxis.Category(cats));
        return this;
    }

    ChartOption X(ChartAxis ax) { this.xAxes.Add(ax); return this; }
    ChartOption Y(ChartAxis ax) { this.yAxes.Add(ax); return this; }

    // ---- resolved views (renderers use these; treat as read-only) ----

    ChartAxis XAxis0() {
        if (this.xAxes.Count > 0) { return this.xAxes[0]; }
        return ChartAxis.Category(this.XCategories());
    }

    ChartAxis YAxis0() {
        if (this.yAxes.Count > 0) { return this.yAxes[0]; }
        return ChartAxis.Value();
    }

    ChartAxis YAxis1() {
        if (this.yAxes.Count > 1) { return this.yAxes[1]; }
        return this.YAxis0();
    }

    /// Category labels for the x axis: the first x axis' categories, else the
    /// first series' data names, else 1..N.
    List<string> XCategories() {
        if (this.xAxes.Count > 0 && this.xAxes[0].categories.Count > 0) {
            return this.xAxes[0].categories;
        }
        if (this.series.Count > 0) {
            List<string> outp = new List<string>();
            int n = this.series[0].Count();
            int i = 0;
            while (i < n) {
                string nm = this.series[0].data[i].name;
                if (nm.Length > 0) { outp.Add(nm); }
                else { outp.Add(Convert.ToString(i + 1)); }
                i = i + 1;
            }
            return outp;
        }
        return new List<string>();
    }

    // ---- JSON ----

    /// Parses an ECharts-style option document. Shape:
    ///
    ///   {"title":"Revenue",
    ///    "xAxis":{"type":"category","data":["Q1","Q2","Q3"]},
    ///    "yAxis":{"type":"value"},
    ///    "series":[{"type":"bar","name":"Rev","data":[12,28,20]},
    ///              {"type":"line","name":"Cost","data":[{"value":8,"name":"Q1"},14]}]}
    ///
    /// The old compact shape (labels + series[].values) is still accepted.
    static ChartOption FromJson(string src) {
        return ChartOption.FromJsonValue(JsonValue.ParseLenient(src));
    }

    static ChartOption FromJsonValue(JsonValue v) {
        ChartOption o = ChartOption.Create();
        if (v == null) { return o; }
        o.title = v.Str("title", "");

        JsonValue lg = v.Get("legend");
        if (lg != null && lg.IsObject()) { o.showLegend = lg.Bool("show", o.showLegend); }
        JsonValue tp = v.Get("tooltip");
        if (tp != null && tp.IsObject()) { o.showTooltip = tp.Bool("show", o.showTooltip); }

        ChartOption.ParseAxis(v.Get("xAxis"), o.xAxes, true);
        ChartOption.ParseAxis(v.Get("yAxis"), o.yAxes, false);

        JsonValue series = v.Get("series");
        if (series != null && series.IsArray()) {
            int i = 0;
            while (i < series.Count()) {
                JsonValue s = series.At(i);
                ChartSeries cs = ChartSeries.Of(s.Str("name", ""),
                    ChartKinds.TypeOf(s.Str("type", "line")), new List<int>());
                cs.color = s.Int("color", 0);
                cs.axisIndex = s.Int("yAxisIndex", s.Int("axisIndex", 0));
                cs.stack = s.Int("stack", 0);
                if (cs.type == ChartType.StackedBar || cs.type == ChartType.StackedArea) { cs.stack = 1; }
                JsonValue da = s.Get("data");
                if (da != null && da.IsArray()) {
                    int j = 0;
                    while (j < da.Count()) {
                        JsonValue it = da.At(j);
                        if (it.IsObject()) {
                            cs.data.Add(ChartData.Full(it.Int("value", 0),
                                it.Str("name", ""), it.Int("color", 0)));
                        } else {
                            cs.data.Add(ChartData.Of(it.AsInt(0)));
                        }
                        j = j + 1;
                    }
                }
                // legacy: series[].values
                JsonValue vals = s.Get("values");
                if (vals != null && vals.IsArray() && cs.data.Count == 0) {
                    int j2 = 0;
                    while (j2 < vals.Count()) {
                        cs.data.Add(ChartData.Of(vals.At(j2).AsInt(0)));
                        j2 = j2 + 1;
                    }
                }
                o.series.Add(cs);
                i = i + 1;
            }
        }

        // legacy: top-level labels -> x-axis categories
        JsonValue labels = v.Get("labels");
        if (labels != null && labels.IsArray() && o.xAxes.Count == 0) {
            List<string> cats = new List<string>();
            int i2 = 0;
            while (i2 < labels.Count()) { cats.Add(labels.At(i2).AsString("")); i2 = i2 + 1; }
            o.xAxes.Add(ChartAxis.Category(cats));
        }
        return o;
    }

    static void ParseAxis(JsonValue v, List<ChartAxis> into, bool isX) {
        if (v == null) { return; }
        if (v.IsArray()) {
            int i = 0;
            while (i < v.Count()) {
                ChartOption.ParseAxisOne(v.At(i), into);
                i = i + 1;
            }
            return;
        }
        ChartOption.ParseAxisOne(v, into);
    }

    static void ParseAxisOne(JsonValue v, List<ChartAxis> into) {
        if (v == null || !v.IsObject()) { return; }
        ChartAxisType ty = ChartKinds.AxisOf(v.Str("type", "category"));
        ChartAxis a;
        if (ty == ChartAxisType.Category) {
            List<string> cats = new List<string>();
            JsonValue da = v.Get("data");
            if (da != null && da.IsArray()) {
                int i = 0;
                while (i < da.Count()) { cats.Add(da.At(i).AsString("")); i = i + 1; }
            }
            a = ChartAxis.Category(cats);
        } else {
            a = ChartAxis.Value();
            a.type = ty;
            if (v.Has("min")) { a.min = v.Int("min", ChartOption.Auto()); }
            if (v.Has("max")) { a.max = v.Int("max", ChartOption.Auto()); }
        }
        a.title = v.Str("name", "");
        a.reversed = v.Bool("inverse", false);
        into.Add(a);
    }
}

/// ECharts-style shared data source: named dimensions stored column-major, plus
/// optional category labels for the x axis. One dataset can drive several
/// charts by selecting different dimensions with EncodeBy / EncodeNamed — the
/// caller never copies or reshapes the underlying lists.
class ChartDataset {
    List<string> dims;         // dimension (column) names
    List<List<int>> cols;      // column-major values; cols[d] aligns with dims[d]
    List<string> cats;         // optional x-axis category labels (may be empty)

    static ChartDataset Of(List<string> dims, List<List<int>> cols) {
        ChartDataset d = new ChartDataset();
        d.dims = dims;
        d.cols = cols;
        d.cats = new List<string>();
        return d;
    }

    static ChartDataset WithCats(List<string> dims, List<List<int>> cols,
                                 List<string> cats) {
        ChartDataset d = ChartDataset.Of(dims, cols);
        d.cats = cats;
        return d;
    }

    int RowCount() {
        if (this.cols.Count == 0) { return 0; }
        return this.cols[0].Count;
    }

    /// Index of a dimension by name, or -1 if absent.
    int DimOf(string name) {
        int i = 0;
        while (i < this.dims.Count) {
            if (this.dims[i] == name) { return i; }
            i = i + 1;
        }
        return 0 - 1;
    }

    /// Category labels for the x axis: the explicit `cats` if given, otherwise
    /// 1..RowCount as strings.
    List<string> Labels() {
        if (this.cats.Count > 0) { return this.cats; }
        List<string> outp = new List<string>();
        int n = this.RowCount();
        int i = 0;
        while (i < n) { outp.Add(Convert.ToString(i + 1)); i = i + 1; }
        return outp;
    }

    /// Build a ChartOption from a set of value dimensions (by index). Series
    /// names come from the dimension names; colors auto-resolve from the theme.
    ChartOption EncodeBy(string title, List<int> yDims, ChartType type) {
        List<ChartSeries> ser = new List<ChartSeries>();
        int i = 0;
        while (i < yDims.Count) {
            int d = yDims[i];
            if (d >= 0 && d < this.cols.Count) {
                ser.Add(ChartSeries.Of(this.dims[d], type, this.cols[d]));
            }
            i = i + 1;
        }
        ChartOption o = ChartOption.Of(ser);
        o.title = title;
        o.Categories(this.Labels());
        return o;
    }

    /// Same as EncodeBy but selecting dimensions by name.
    ChartOption EncodeNamed(string title, List<string> yNames, ChartType type) {
        List<int> yd = new List<int>();
        int i = 0;
        while (i < yNames.Count) {
            int d = this.DimOf(yNames[i]);
            if (d >= 0) { yd.Add(d); }
            i = i + 1;
        }
        return this.EncodeBy(title, yd, type);
    }
}
