using System;
using System.Json;
using Gui;

namespace Gui.Component.Chart;

partial class ChartView {
    // ---- polar / radar (series polygons over angular categories) ----

    static void DrawPolar(App app, int x, int y, int w, int h,
                          ChartOption o, int g) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int pad = t.paddingMedium;
        int ci = 0;
        while (ci < o.series.Count) {
            if (o.series[ci].color == 0) { o.series[ci].color = Chart.Palette(t, ci); }
            ci = ci + 1;
        }
        int top = Chart.DrawPanelI(app, x, y, w, h, o.title, o.series, o.iwid);
        List<string> labels = o.XCategories();
        int n = labels.Count;
        if (n < 1 && o.series.Count > 0) { n = o.series[0].Count(); }
        if (n < 1) { return; }
        int maxV = Chart.NiceMax(Chart.MaxOf(o.series));
        if (maxV < 1) { maxV = 1; }

        int areaW = w - pad * 2;
        int areaH = (y + h - pad) - top;
        int r = areaW / 2;
        if (areaH / 2 < r) { r = areaH / 2; }
        if (r < app.Scale(10)) { r = app.Scale(10); }
        int cx = x + pad + areaW / 2;
        int cy = top + areaH / 2;

        int rings = 4;
        int rr = 1;
        while (rr <= rings) {
            ChartView.RingOutline(c, cx, cy, r * rr / rings, t.divider);
            rr = rr + 1;
        }
        int a = 0;
        while (a < n) {
            int ang = a * 360 / n - 90;
            int ex = cx + ChartView.CosDeg(ang) * r / 1000;
            int ey = cy + ChartView.SinDeg(ang) * r / 1000;
            c.DrawLine(cx, cy, ex, ey, t.divider, 1);
            string lbl = "";
            if (a < labels.Count) { lbl = labels[a]; }
            if (lbl.Length > 0) {
                int lx = cx + ChartView.CosDeg(ang) * (r + app.Scale(10)) / 1000;
                int ly = cy + ChartView.SinDeg(ang) * (r + app.Scale(10)) / 1000;
                c.DrawText(lx - Canvas.MeasureText(lbl, t.fontSizeSmall) / 2, ly - Canvas.FontHeight(t.fontSizeSmall) / 2,
                    lbl, t.textTertiary, t.fontSizeSmall);
            }
            a = a + 1;
        }

        int si = 0;
        while (si < o.series.Count) {
            ChartSeries s = o.series[si];
            int col = s.color;
            // The whole radar polygon (with its closing edge) is one stroke,
            // so the vertices are clean round joins, not per-segment seams.
            List<int> lx = new List<int>();
            List<int> ly = new List<int>();
            int j = 0;
            while (j < n && j < s.Count()) {
                int ang = j * 360 / n - 90;
                int rad = s.Value(j) * g / 1000 * r / maxV;
                int px = cx + ChartView.CosDeg(ang) * rad / 1000;
                int py = cy + ChartView.SinDeg(ang) * rad / 1000;
                lx.Add(px);
                ly.Add(py);
                c.FillCircle(px, py, app.Scale(3), col);
                j = j + 1;
            }
            if (n > 1 && s.Count() >= n && lx.Count > 0) {
                lx.Add(lx[0]);
                ly.Add(ly[0]);
            }
            if (lx.Count > 1) { c.DrawPolyline(lx, ly, col, app.Scale(2)); }
            si = si + 1;
        }

        if (o.showTooltip) {
            int mx = app.mouseX;
            int my = app.mouseY;
            int ddx = mx - cx;
            int ddy = my - cy;
            int dist = ChartView.ISqrt(ddx * ddx + ddy * ddy);
            if (dist <= r + app.Scale(8)) {
                int ang = ChartView.AngleOf(ddx, ddy) + 90;
                if (ang >= 360) { ang = ang - 360; }
                int axis = (ang * n + 180) / 360;
                if (axis < 0) { axis = 0; }
                if (axis > n - 1) { axis = n - 1; }
                List<int> tcols = new List<int>();
                List<string> tlines = new List<string>();
                string hdr = "Axis " + Convert.ToString(axis + 1);
                if (axis < labels.Count) { hdr = labels[axis]; }
                tcols.Add(0); tlines.Add(hdr);
                int si2 = 0;
                while (si2 < o.series.Count) {
                    ChartSeries s2 = o.series[si2];
                    if (!s2.hidden && axis < s2.Count()) {
                        tcols.Add(s2.color);
                        tlines.Add(s2.name + "  " + Convert.ToString(s2.Value(axis)));
                    }
                    si2 = si2 + 1;
                }
                ChartView.TooltipCard(app, mx, my, x + w, tcols, tlines);
            }
        }
    }
}
