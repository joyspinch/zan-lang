using System;
using System.Json;
using Gui;

namespace Gui.Component.Chart;

class WordCloudItem {
    ChartData data;
    int x;
    int y;
    int w;
    int h;
    int fontSize;
    int color;
    // 旋转角（度，0/90 来自 ECharts rotateRange 的两态，自定义角度集
    // 由 wcRotateList 提供）；旋转项的 x/y/w/h 存的是旋转后的包围盒。
    int rot;

    static WordCloudItem Of(ChartData data, int x, int y, int w, int h,
                            int fontSize, int color, int rot) {
        WordCloudItem item = new WordCloudItem();
        item.data = data;
        item.x = x;
        item.y = y;
        item.w = w;
        item.h = h;
        item.fontSize = fontSize;
        item.color = color;
        item.rot = rot;
        return item;
    }
}

/// 词云放置结果的逐帧记忆化条目：螺旋放置只依赖词条内容与
/// 盒子几何，即时模式调用方每帧重建 option 对象，按内容指纹
/// 复用同一次放置搜索（见 ChartView.DrawWordCloud）。
class WordCloudCacheEntry {
    int fp;
    List<WordCloudItem> items;
    static WordCloudCacheEntry Lookup(List<WordCloudCacheEntry> cache, int fp) {
        for (int i = 0; i < cache.Count; i = i + 1) {
            if (cache[i].fp == fp) { return cache[i]; }
        }
        return null;
    }
    /// 存入放置结果（同指纹去重；超出容量时挤掉最旧的一条）。
    static void Store(List<WordCloudCacheEntry> cache, int fp,
                      List<WordCloudItem> items, int capacity) {
        for (int i = 0; i < cache.Count; i = i + 1) {
            if (cache[i].fp == fp) { return; }
        }
        WordCloudCacheEntry e = new WordCloudCacheEntry();
        e.fp = fp;
        e.items = items;
        if (cache.Count >= capacity) { cache.RemoveAt(0); }
        cache.Add(e);
    }
}

class TreeLayoutNode {
    ChartNode node;
    int depth;
    int lo;
    int count;

    static TreeLayoutNode Of(ChartNode node, int depth, int lo, int count) {
        TreeLayoutNode layout = new TreeLayoutNode();
        layout.node = node;
        layout.depth = depth;
        layout.lo = lo;
        layout.count = count;
        return layout;
    }
}

class SankeyNodeLayout {
    string name;
    int layer;
    int flowOut;
    int flowIn;
    int x;
    int y;
    int h;

    static SankeyNodeLayout Of(string name) {
        SankeyNodeLayout node = new SankeyNodeLayout();
        node.name = name;
        node.layer = 0;
        node.flowOut = 0;
        node.flowIn = 0;
        node.x = 0;
        node.y = 0;
        node.h = 0;
        return node;
    }
}

partial class ChartView {
    static string TreeNodeName(ChartNode n) {
        if (n == null || n.name == null) { return ""; }
        return n.name;
    }

    static int TreeChildCount(ChartNode n) {
        if (n == null || n.children == null) { return 0; }
        return n.children.Count;
    }

    // Treemap 面积只接受正值；负值/零值不占像素，且累计和饱和到
    // int 上限，避免异常输入把布局边界推进到负数或溢出。
    static int TreemapValue(ChartNode n) {
        if (n == null) { return 0; }
        int kids = n.children == null ? 0 : n.children.Count;
        if (kids == 0) { return n.val > 0 ? n.val : 0; }
        int sum = 0;
        for (int i = 0; i < kids; i = i + 1) {
            int v = ChartView.TreemapValue(n.children[i]);
            if (v > 2147483647 - sum) { return 2147483647; }
            sum = sum + v;
        }
        return sum;
    }

    static int TreemapTotal(List<ChartNode> nodes) {
        if (nodes == null) { return 0; }
        int total = 0;
        for (int i = 0; i < nodes.Count; i = i + 1) {
            int v = ChartView.TreemapValue(nodes[i]);
            if (v > 2147483647 - total) { return 2147483647; }
            total = total + v;
        }
        return total;
    }

    static int TreemapAdd(int left, int right) {
        if (left < 0) { left = 0; }
        if (right < 0) { right = 0; }
        if (right > 2147483647 - left) { return 2147483647; }
        return left + right;
    }

    // ---- 矩形树图（递归切片，交替分割方向） ----

    static void DrawTreemap(App app, int x, int y, int w, int h,
                            ChartOption o, int g) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        ChartSeries lead = ChartView.LeadSeries(o);
        if (lead == null || lead.tree == null || lead.tree.Count < 1) { return; }
        ChartNode root = lead.tree[0];
        if (root == null) { return; }
        int plotTop = ChartView.PanelHead(app, x, y, w, h, o.title);
        int pad = t.paddingMedium;
        int areaX = x + pad;
        int areaY = plotTop;
        int areaW = w - pad * 2;
        int areaH = (y + h - pad) - plotTop;
        if (areaW < app.Scale(10) || areaH < app.Scale(10)) { return; }
        int gw = areaW * g / 1000;
        int gh = areaH * g / 1000;
        areaX = areaX + (areaW - gw) / 2;
        areaY = areaY + (areaH - gh) / 2;
        areaW = gw;
        areaH = gh;
        if (areaW < app.Scale(4) || areaH < app.Scale(4)) { return; }

        int rootValue = ChartView.TreemapValue(root);
        int rootKids = root.children == null ? 0 : root.children.Count;
        if (rootKids == 0) {
            if (rootValue > 0) {
                c.FillRoundRect(areaX, areaY, areaW, areaH,
                    ChartView.TreemapCornerRadius(0, app.Scale(1)), Chart.Palette(t, 0));
                ChartView.TreemapCell(app, areaX, areaY, areaW, areaH,
                    ChartView.TreeNodeName(root), Convert.ToString(rootValue));
            }
        } else {
            ChartView.TreemapSlice(app, areaX, areaY, areaW, areaH, root.children, 0);
        }

        int mx = app.mouseX;
        int my = app.mouseY;
        ChartView.ttName = "";
        ChartView.ttVal = 0;
        ChartView.ttNode = null;
        int rootRadius = ChartView.TreemapCornerRadius(0, app.Scale(1));
        if (ChartView.TreemapContains(mx, my, areaX, areaY,
                areaW, areaH, rootRadius)) {
            if (rootKids == 0) {
                if (rootValue > 0) {
                    ChartView.ttNode = root;
                    ChartView.ttName = ChartView.TreeNodeName(root);
                    ChartView.ttVal = rootValue;
                }
                ChartView.ttX = areaX;
                ChartView.ttY = areaY;
                ChartView.ttW = areaW;
                ChartView.ttH = areaH;
                ChartView.ttRadius = rootRadius;
            } else {
                ChartView.TreemapHit(app, areaX, areaY, areaW, areaH,
                    root.children, 0, mx, my);
            }
            if (ChartView.ttNode != null
                && ChartView.activeEventView != null) {
                ChartHit th = ChartHit.Of(ChartElementType.Node,
                    ChartView.SeriesIndexOf(o, lead), lead.name,
                    ChartView.TreeNodeIndex(root, ChartView.ttNode),
                    ChartView.ttName, ChartView.ttVal, mx, my);
                th.axisIndex = lead.axisIndex;
                ChartView.OfferActiveHit(th);
            }
            if (o.showTooltip && ChartView.ttName.Length > 0) {
                // 描出精确悬停单元格的轮廓。
                c.DrawRoundRect(ChartView.ttX, ChartView.ttY,
                    ChartView.ttW, ChartView.ttH, ChartView.ttRadius,
                    4294967295, app.Scale(2));
                List<TooltipRow> rows = new List<TooltipRow>{
                    TooltipRow.Of(0, o.title),
                    TooltipRow.Of(4294967295,
                        ChartView.ttName + "  " + Convert.ToString(ChartView.ttVal)) };
                ChartView.TooltipCard(app, mx, my, x + w, rows);
            }
        }
    }

    // 一层分割；单元格足够大时递归进子节点，
    // 否则以名称 + 值标记该单元格。
    static void TreemapSlice(App app, int x, int y, int w, int h,
                             List<ChartNode> nodes, int depth) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int total = ChartView.TreemapTotal(nodes);
        if (total < 1) { return; }
        bool vert = (depth % 2) == 0;
        int acc = 0;
        for (int j = 0; j < nodes.Count; j = j + 1) {
            ChartNode nd = nodes[j];
            if (nd == null) { continue; }
            int v = ChartView.TreemapValue(nd);
            int cell = vert
                ? ChartView.TreemapSliceSize(h, acc, v, total)
                : ChartView.TreemapSliceSize(w, acc, v, total);
            int start = vert
                ? ChartView.TreemapSliceStart(h, acc, total)
                : ChartView.TreemapSliceStart(w, acc, total);
            int cx = x;
            int cy = y;
            int cw = w;
            int ch = h;
            if (vert) { ch = cell; cy = y + start; }
            else { cw = cell; cx = x + start; }
            acc = ChartView.TreemapAdd(acc, v);

            if (v < 1) { continue; }
            int col = Chart.Palette(t, j);
            int panelBg = Style.Full(app, "chart", "", "", Style.SNormal()).BgOr(0);
            if (depth > 0) { col = App.LerpColor(col, panelBg, depth * 130); }
            int rr = ChartView.TreemapCornerRadius(depth, app.Scale(1));
            if (cw > app.Scale(2) && ch > app.Scale(2)) {
                c.FillRoundRect(cx, cy, cw, ch, rr, col);
                c.DrawRoundRect(cx, cy, cw, ch, rr, panelBg, app.Scale(1));
            }
            int kids = nd.children == null ? 0 : nd.children.Count;
            if (kids > 0 && cw > app.Scale(34) && ch > app.Scale(26)) {
                int inset = app.Scale(3);
                ChartView.TreemapSlice(app, cx + inset, cy + inset,
                    cw - inset * 2, ch - inset * 2, nd.children, depth + 1);
            } else {
                ChartView.TreemapCell(app, cx, cy, cw, ch,
                    ChartView.TreeNodeName(nd), Convert.ToString(v));
            }
        }
    }

    // 矩形树图单元格内的名称（+ 值）标签，仅放得下时绘制，
    // 并用单元格矩形裁剪，避免长名称画出格子。
    static void TreemapCell(App app, int x, int y, int w, int h, string name, string val) {
        Canvas c = app.canvas;
        int fs = Style.FontFallback(app, "small");
        int fh = Canvas.FontHeight(fs);
        if (w < app.Scale(20) || h < fh + app.Scale(4)) { return; }
        c.PushClip(x, y, w, h);
        ChartView.DrawTextClamped(c, x + app.Scale(3), y + app.Scale(2),
            name, 4294967295, fs, x, y, w, h);
        if (h > fh * 2 + app.Scale(4) && val.Length > 0) {
            ChartView.DrawTextClamped(c, x + app.Scale(3), y + app.Scale(2) + fh, val,
                Chart.WithAlpha(4294967295, 200), fs, x, y, w, h);
        }
        c.PopClip();
    }

    // ---- 旭日图（同心环；最内环 = 根的子节点） ----

    static int TreeDepth(ChartNode n) {
        int md = 0;
        int childCount = ChartView.TreeChildCount(n);
        for (int i = 0; i < childCount; i = i + 1) {
            int d = ChartView.TreeDepth(n.children[i]);
            if (d > md) { md = d; }
        }
        return md + 1;
    }

    // Sunburst 实际绘制的是父子边数对应的环，根节点本身
    // 不占一圈；因此 root->leaf 应为 1 圈，而不是 TreeDepth=2
    // 再额外除以一圈，造成外径只到 rMax/3。
    static int SunburstRingCount(ChartNode root) {
        if (root == null) { return 0; }
        int rings = ChartView.TreeDepth(root) - 1;
        if (rings < 1) { rings = 1; }
        return rings;
    }

    static int SunburstRingHeight(int rMax, int rings) {
        if (rMax < 1 || rings < 1) { return 0; }
        int ringH = rMax / rings;
        if (ringH < 1) { ringH = 1; }
        return ringH;
    }

    static int TreemapCornerRadius(int depth, int scale) {
        int rr = scale * 2;
        if (depth == 0) { rr = scale * 4; }
        return rr;
    }

    static int TreeNodeCount(ChartNode n) {
        if (n == null || n.children == null) { return n == null ? 0 : 1; }
        int count = 1;
        for (int i = 0; i < n.children.Count; i = i + 1) {
            count = count + ChartView.TreeNodeCount(n.children[i]);
        }
        return count;
    }

    // 稳定 preorder 下标供 Tree/Treemap 的 dataIndex 使用；节点对象
    // 没有独立 id，因此不能使用每帧重新分配的命中句柄。
    static int TreeNodeIndex(ChartNode root, ChartNode target) {
        if (root == null || target == null) { return 0 - 1; }
        if (root == target) { return 0; }
        int offset = 1;
        int childCount = ChartView.TreeChildCount(root);
        for (int i = 0; i < childCount; i = i + 1) {
            ChartNode child = root.children[i];
            int found = ChartView.TreeNodeIndex(child, target);
            if (found >= 0) { return offset + found; }
            offset = offset + ChartView.TreeNodeCount(child);
        }
        return 0 - 1;
    }

    static bool TreeRoamEnabled(bool roam) { return roam; }

    static int TreeHitRadius(int radius, int zoom, int scale) {
        if (radius < 0) { radius = 0; }
        if (scale < 1) { scale = 1; }
        // 命中热区只补固定的可访问性余量；不能随 zoom 无限扩大，
        // 否则空白或相邻节点会被远距离圆点吞掉。
        int extra = scale * 3;
        if (zoom < 50) { extra = scale * 2; }
        return radius + extra;
    }

    static bool TreemapContains(int px, int py, int x, int y, int w, int h, int radius) {
        if (w < 1 || h < 1 || px < x || px >= x + w || py < y || py >= y + h) {
            return false;
        }
        int rr = radius;
        if (rr < 0) { rr = 0; }
        if (rr > w / 2) { rr = w / 2; }
        if (rr > h / 2) { rr = h / 2; }
        if (rr < 1) { return true; }
        int dx = 0;
        if (px < x + rr) { dx = x + rr - px; }
        if (px >= x + w - rr) { dx = px - (x + w - rr - 1); }
        int dy = 0;
        if (py < y + rr) { dy = y + rr - py; }
        if (py >= y + h - rr) { dy = py - (y + h - rr - 1); }
        if (dx > 0 && dy > 0) {
            return dx * dx + dy * dy <= rr * rr;
        }
        return true;
    }

    // 按累计值计算像素边界；绘制和命中必须使用同一组边界，
    // 避免逐项 floor 后在最后一列/最后一行留下不可命中的空带。
    static int TreemapSliceStart(int dimension, int prefix, int total) {
        if (dimension < 1 || prefix < 0 || total < 1) { return 0; }
        if (prefix > total) { prefix = total; }
        return (int)((long)dimension * (long)prefix / (long)total);
    }

    static int TreemapSliceEnd(int dimension, int prefix, int value, int total) {
        if (dimension < 1 || prefix < 0 || value < 0 || total < 1) { return 0; }
        if (prefix > total) { prefix = total; }
        long end = (long)prefix + (long)value;
        if (end > (long)total) { end = (long)total; }
        return (int)((long)dimension * end / (long)total);
    }

    static int TreemapSliceSize(int dimension, int prefix, int value, int total) {
        int start = ChartView.TreemapSliceStart(dimension, prefix, total);
        int end = ChartView.TreemapSliceEnd(dimension, prefix, value, total);
        if (end < start) { return 0; }
        return end - start;
    }

    // 矩形树图命中测试：按 TreemapSlice 相同的切片布局遍历，
    // 仅当指针位于子单元格内（且深度足够
    // 被分割）时才递归。填充静态命中字段 ttName/ttVal。
    static void TreemapHit(App app, int x, int y, int w, int h,
                           List<ChartNode> nodes, int depth, int px, int py) {
        int total = ChartView.TreemapTotal(nodes);
        if (total < 1) { return; }
        bool vert = (depth % 2) == 0;
        int acc = 0;
        for (int j = 0; j < nodes.Count; j = j + 1) {
            ChartNode nd = nodes[j];
            if (nd == null) { continue; }
            int v = ChartView.TreemapValue(nd);
            int cell = vert
                ? ChartView.TreemapSliceSize(h, acc, v, total)
                : ChartView.TreemapSliceSize(w, acc, v, total);
            int start = vert
                ? ChartView.TreemapSliceStart(h, acc, total)
                : ChartView.TreemapSliceStart(w, acc, total);
            int cx = x;
            int cy = y;
            int cw = w;
            int ch = h;
            if (vert) { ch = cell; cy = y + start; }
            else { cw = cell; cx = x + start; }
            acc = ChartView.TreemapAdd(acc, v);
            int rr = ChartView.TreemapCornerRadius(depth, app.Scale(1));
            if (ChartView.TreemapContains(px, py, cx, cy, cw, ch, rr)) {
                // 先登记父格作为 fallback；若子格命中，递归会覆盖
                // 这些字段。父格边框/gutter 因而不会变成无主空带。
                ChartView.ttNode = nd;
                ChartView.ttName = ChartView.TreeNodeName(nd);
                ChartView.ttVal = v;
                ChartView.ttX = cx;
                ChartView.ttY = cy;
                ChartView.ttW = cw;
                ChartView.ttH = ch;
                ChartView.ttRadius = rr;
                int kids = nd.children == null ? 0 : nd.children.Count;
                if (kids > 0 && cw > app.Scale(34) && ch > app.Scale(26)) {
                    int inset = app.Scale(3);
                    ChartView.TreemapHit(app, cx + inset, cy + inset,
                        cw - inset * 2, ch - inset * 2, nd.children, depth + 1, px, py);
                }
                return;
            }
        }
    }

    // 旭日图环形命中测试：按 SunburstRing 相同的角扫掠遍历，
    // 指针位于子扇形内时递归。填充
    // 静态命中字段 ttName/ttVal。
    static int SunburstVisibleEnd(int rawEnd, int sweepMax) {
        if (sweepMax < 0) { sweepMax = 0; }
        if (sweepMax > 360) { sweepMax = 360; }
        if (rawEnd < 0) { return rawEnd; }
        if (rawEnd > sweepMax) { return sweepMax; }
        return rawEnd;
    }

    static void SunburstHit(App app, int cx, int cy, int ringH, ChartNode node,
                            int depth, int a0, int a1, int sweepMax,
                            int px, int py) {
        int total = node.Total();
        if (total < 1) { return; }
        int kids = node.children.Count;
        if (kids == 0) { return; }
        int ddx = px - cx;
        int ddy = py - cy;
        int dist = ChartView.ISqrt(ddx * ddx + ddy * ddy);
        if (dist < depth * ringH || dist > (depth + 1) * ringH) { return; }
        int ang = ChartView.AngleOf(ddx, ddy);
        int a = a0;
        int visibleEnd = ChartView.SunburstVisibleEnd(a1, sweepMax);
        if (visibleEnd <= a0) { return; }
        for (int i = 0; i < kids; i = i + 1) {
            ChartNode k = node.children[i];
            int v = k.Total();
            int span = (a1 - a0) * v / total;
            int aEnd = a + span;
            int hitEnd = aEnd;
            if (hitEnd > visibleEnd) { hitEnd = visibleEnd; }
            if (ang >= a && ang < hitEnd) {
                if (k.children.Count > 0) {
                    ChartView.SunburstHit(app, cx, cy, ringH, k, depth + 1,
                        a, aEnd, sweepMax, px, py);
                } else {
                    ChartView.ttName = k.name;
                    ChartView.ttVal = v;
                    ChartView.ttA0 = a;
                    // 高亮必须和本帧实际 reveal 的扇区相同，不能
                    // 用未裁剪的 raw end 把尚未绘制的尾部画出来。
                    ChartView.ttA1 = hitEnd;
                    ChartView.ttDepth = depth;
                }
                return;
            }
            a = a + span;
        }
    }

    static void DrawSunburst(App app, int x, int y, int w, int h,
                             ChartOption o, int g) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        List<ChartSeries> series = o.series;
        if (series.Count < 1 || series[0].tree.Count < 1) { return; }
        ChartNode root = series[0].tree[0];
        int top = ChartView.PanelHead(app, x, y, w, h, o.title);
        int pad = t.paddingMedium;
        int areaY = top;
        int areaH = (y + h - pad) - top;
        if (areaH < app.Scale(16)) { areaH = app.Scale(16); }
        int cx = x + w / 2;
        int cy = areaY + areaH / 2;
        int rMax = (w - pad * 2) / 2;
        if (areaH / 2 < rMax) { rMax = areaH / 2; }
        if (rMax < app.Scale(10)) { rMax = app.Scale(10); }
        int sweepMax = 360 * g / 1000;

        int rings = ChartView.SunburstRingCount(root);
        int ringH = ChartView.SunburstRingHeight(rMax, rings);
        ChartView.SunburstRing(app, cx, cy, ringH, root, 0, 0, 360, sweepMax, 0);

        // 中心标签 = 根节点名称
        if (root.name.Length > 0) {
            int fs = Style.FontFallback(app, "small");
            c.DrawTextCentered(cx - ringH / 2, Canvas.CenterTextYAt(cy, fs),
                ringH, Canvas.FontHeight(fs), root.name,
                Style.Part(app, "chart", "label", "", "", "", Style.SNormal()).FgOr(0), fs);
        }

        if (o.showTooltip) {
            int mx = app.mouseX;
            int my = app.mouseY;
            int ddx = mx - cx;
            int ddy = my - cy;
            int dist = ChartView.ISqrt(ddx * ddx + ddy * ddy);
            if (dist <= rMax) {
                ChartView.ttName = "";
                ChartView.ttVal = 0;
                ChartView.SunburstHit(app, cx, cy, ringH, root, 0, 0, 360,
                    sweepMax, mx, my);
                if (ChartView.ttName.Length > 0) {
                    // 悬停扇区外缘的高亮圆环。
                    int hiInner = (ChartView.ttDepth + 1) * ringH - app.Scale(2);
                    int hiOuter = (ChartView.ttDepth + 1) * ringH;
                    if (hiInner < 0) { hiInner = 0; }
                    c.FillSector(cx, cy, hiInner, hiOuter,
                        ChartView.ttA0, ChartView.ttA1, 4294967295);
                    List<TooltipRow> rows = new List<TooltipRow>{
                        TooltipRow.Of(0, o.title),
                        TooltipRow.Of(4294967295,
                            ChartView.ttName + "  " + Convert.ToString(ChartView.ttVal)) };
                    ChartView.TooltipCard(app, mx, my, x + w, rows);
                }
            }
        }
    }

    static void SunburstRing(App app, int cx, int cy, int ringH, ChartNode node,
                             int depth, int a0, int a1, int sweepMax, int parentCol) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int total = node.Total();
        if (total < 1) { return; }
        int kids = node.children.Count;
        if (kids == 0) { return; }
        int rInner = depth * ringH;
        int rOuter = (depth + 1) * ringH;
        int a = a0;
        for (int i = 0; i < kids; i = i + 1) {
            ChartNode k = node.children[i];
            int v = k.Total();
            int span = (a1 - a0) * v / total;
            int rawEnd = a + span;
            int visibleEnd = ChartView.SunburstVisibleEnd(rawEnd, sweepMax);
            int col = Chart.Palette(t, i);
            if (depth > 0) { col = App.LerpColor(parentCol, 4294967295, 100 + depth * 70); }
            if (visibleEnd > a && rOuter > rInner) {
                c.FillSector(cx, cy, rInner, rOuter, a, visibleEnd, col);
                if (k.children.Count > 0) {
                    ChartView.SunburstRing(app, cx, cy, ringH, k, depth + 1,
                        a, rawEnd, sweepMax, col);
                }
            }
            a = rawEnd;
        }
    }

    // ---- 桑基图（分层节点间的流量连线） ----

    static int SankeyIndex(List<SankeyNodeLayout> nodes, string name) {
        for (int i = 0; i < nodes.Count; i = i + 1) {
            if (nodes[i].name == name) { return i; }
        }
        return 0 - 1;
    }

    static int SankeyRevealAlpha(int progress) {
        if (progress < 0) { progress = 0; }
        if (progress > 1000) { progress = 1000; }
        return 255 * progress / 1000;
    }

    static void DrawSankey(App app, int x, int y, int w, int h,
                           ChartOption o, int g) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        List<ChartSeries> series = o.series;
        if (series.Count < 1 || series[0].links.Count < 1) { return; }
        List<ChartLink> links = series[0].links;
        int top = ChartView.PanelHead(app, x, y, w, h, o.title);
        int pad = t.paddingMedium;

        // 按首次出现顺序的节点列表。
        List<SankeyNodeLayout> nodes = new List<SankeyNodeLayout>();
        int li = 0;
        for (; li < links.Count; li = li + 1) {
            ChartLink lk = links[li];
            if (ChartView.SankeyIndex(nodes, lk.from) < 0) {
                nodes.Add(SankeyNodeLayout.Of(lk.from));
            }
            if (ChartView.SankeyIndex(nodes, lk.to) < 0) {
                nodes.Add(SankeyNodeLayout.Of(lk.to));
            }
        }
        // 最长路径分层：layer(to) >= layer(from) + 1。循环图会让
        // 朴素松弛永不收敛，因此最多跑（节点数-1）轮——简单
        // 路径长度的上界；剩下的回边把目标压到源节点同层，
        // 保证终止且布局稳定。
        int relaxRounds = nodes.Count - 1;
        if (relaxRounds < 1) { relaxRounds = 1; }
        for (int rr = 0; rr < relaxRounds; rr = rr + 1) {
            bool changed = false;
            li = 0;
            while (li < links.Count) {
                ChartLink lk = links[li];
                int fi = ChartView.SankeyIndex(nodes, lk.from);
                int ti = ChartView.SankeyIndex(nodes, lk.to);
                if (nodes[ti].layer < nodes[fi].layer + 1) {
                    nodes[ti].layer = nodes[fi].layer + 1;
                    changed = true;
                }
                li = li + 1;
            }
            if (!changed) { break; }
        }
        // 回边固定：目标层未领先源层的边，把目标放到源同层
        // （循环边的水平退化布局），此后每条边都满足
        // layer(to) >= layer(from)，不再有反向边。
        li = 0;
        while (li < links.Count) {
            ChartLink lk = links[li];
            int fi = ChartView.SankeyIndex(nodes, lk.from);
            int ti = ChartView.SankeyIndex(nodes, lk.to);
            if (nodes[ti].layer < nodes[fi].layer) {
                nodes[ti].layer = nodes[fi].layer;
            }
            li = li + 1;
        }
        int maxLayer = 0;
        for (int nk = 0; nk < nodes.Count; nk = nk + 1) {
            if (nodes[nk].layer > maxLayer) { maxLayer = nodes[nk].layer; }
        }
        if (maxLayer < 1) { maxLayer = 1; }
        int nLayers = maxLayer + 1;

        // 节点流量（入/出取较大者）决定节点高度。
        int nn = nodes.Count;
        li = 0;
        while (li < links.Count) {
            ChartLink lk = links[li];
            int fi = ChartView.SankeyIndex(nodes, lk.from);
            int ti = ChartView.SankeyIndex(nodes, lk.to);
            nodes[fi].flowOut = nodes[fi].flowOut + lk.val;
            nodes[ti].flowIn = nodes[ti].flowIn + lk.val;
            li = li + 1;
        }

        int colW = (w - pad * 2) / nLayers;
        int nodeW = colW * 3 / 8;
        if (nodeW < app.Scale(18)) { nodeW = app.Scale(18); }
        int areaH = (y + h - pad) - top;
        int colH = areaH * 8 / 10;

        // 每列流量合计，用于垂直堆叠。
        List<int> colTotal = new List<int>();
        List<int> colCum = new List<int>();
        for (int lc = 0; lc < nLayers; lc = lc + 1) { colTotal.Add(0); colCum.Add(0); }
        int ni = 0;
        for (; ni < nn; ni = ni + 1) {
            SankeyNodeLayout node = nodes[ni];
            int fl = node.flowOut;
            if (fl < node.flowIn) { fl = node.flowIn; }
            colTotal[node.layer] = colTotal[node.layer] + fl;
        }

        ni = 0;
        while (ni < nn) {
            SankeyNodeLayout node = nodes[ni];
            int fl = node.flowOut;
            if (fl < node.flowIn) { fl = node.flowIn; }
            int th2 = colTotal[node.layer];
            if (th2 < 1) { th2 = 1; }
            node.h = colH * fl / th2;
            if (node.h < app.Scale(4)) { node.h = app.Scale(4); }
            node.x = x + pad + node.layer * colW;
            node.y = top + (areaH - colH) / 2 + colCum[node.layer];
            colCum[node.layer] = colCum[node.layer] + node.h + app.Scale(4);
            ni = ni + 1;
        }

        // 先画连线（节点会盖住其边缘）：从
        // 源节点右缘到目标节点左缘的粗圆角色带。
        int maxFlow = 1;
        li = 0;
        while (li < links.Count) { if (links[li].val > maxFlow) { maxFlow = links[li].val; } li = li + 1; }
        int maxTh = app.Scale(10);
        int revealAlpha = ChartView.SankeyRevealAlpha(g);
        ChartView.PushPlotClip(app, x + pad, top, w - pad * 2, areaH);
        li = 0;
        while (li < links.Count) {
            ChartLink lk = links[li];
            int fi = ChartView.SankeyIndex(nodes, lk.from);
            int ti = ChartView.SankeyIndex(nodes, lk.to);
            int th = maxTh * lk.val / maxFlow;
            if (th < app.Scale(2)) { th = app.Scale(2); }
            SankeyNodeLayout fromNode = nodes[fi];
            SankeyNodeLayout toNode = nodes[ti];
            int x0 = fromNode.x + nodeW;
            int y0 = fromNode.y + fromNode.h / 2;
            int x1 = toNode.x;
            int y1 = toNode.y + toNode.h / 2;
            c.DrawLine(x0, y0, x1, y1,
                Chart.WithAlpha(Chart.Palette(t, fi), 170 * revealAlpha / 255), th);
            li = li + 1;
        }
        c.PopClip();

        // 节点 + 标签（源列标签左对齐，其余右对齐）。
        ni = 0;
        while (ni < nn) {
            SankeyNodeLayout node = nodes[ni];
            c.FillRoundRect(node.x, node.y, nodeW, node.h,
                app.Scale(3), Chart.WithAlpha(Chart.Palette(t, ni), revealAlpha));
            int fs = Style.FontFallback(app, "small");
            int fh = Canvas.FontHeight(fs);
            int lx2 = node.x + nodeW + app.Scale(4);
            if (node.layer == 0) {
                lx2 = node.x - app.Scale(4) - Canvas.MeasureText(node.name, fs);
            }
            c.DrawText(lx2, node.y + node.h / 2 - fh / 2,
                node.name,
                Chart.WithAlpha(Style.Part(app, "chart", "label", "", "", "", Style.SNormal()).FgOr(0), revealAlpha), fs);
            ni = ni + 1;
        }

        int mx = app.mouseX;
        int my = app.mouseY;
        bool insideSankey = g > 0 && mx >= x + pad && mx < x + w - pad
            && my >= top && my < top + areaH;
        // 连线悬停：使用与绘制相同的实际线宽，并限制在绘图区。
        int bestL = 0 - 1;
        int bestD = 0;
        if (insideSankey) {
            li = 0;
            while (li < links.Count) {
                ChartLink lk = links[li];
                int fi = ChartView.SankeyIndex(nodes, lk.from);
                int ti = ChartView.SankeyIndex(nodes, lk.to);
                SankeyNodeLayout fromNode = nodes[fi];
                SankeyNodeLayout toNode = nodes[ti];
                int x0 = fromNode.x + nodeW;
                int y0 = fromNode.y + fromNode.h / 2;
                int x1 = toNode.x;
                int y1 = toNode.y + toNode.h / 2;
                int d = ChartView.DistToSeg(mx, my, x0, y0, x1, y1);
                int th = maxTh * lk.val / maxFlow;
                if (th < app.Scale(2)) { th = app.Scale(2); }
                int linkR = th / 2 + app.Scale(1);
                if (d <= linkR && (bestL < 0 || d < bestD)) {
                    bestL = li;
                    bestD = d;
                }
                li = li + 1;
            }
        }
        if (bestL >= 0) {
            ChartLink hk = links[bestL];
            int fi = ChartView.SankeyIndex(nodes, hk.from);
            int ti = ChartView.SankeyIndex(nodes, hk.to);
            SankeyNodeLayout fromNode = nodes[fi];
            SankeyNodeLayout toNode = nodes[ti];
            int x0 = fromNode.x + nodeW;
            int y0 = fromNode.y + fromNode.h / 2;
            int x1 = toNode.x;
            int y1 = toNode.y + toNode.h / 2;
            int th = maxTh * hk.val / maxFlow;
            if (th < app.Scale(2)) { th = app.Scale(2); }
            int linkR = th / 2 + app.Scale(1);
            if (bestD <= linkR) {
                string linkName = hk.from + " -> " + hk.to;
                ChartHit sk = ChartHit.Of(ChartElementType.Link, 0,
                    series[0].name, bestL, linkName, hk.val, mx, my);
                ChartView.OfferActiveHit(sk);
                if (o.showTooltip) {
                    c.DrawLine(x0, y0, x1, y1,
                        Chart.WithAlpha(4294967295, revealAlpha), app.Scale(3));
                    List<TooltipRow> rows = new List<TooltipRow>{
                        TooltipRow.Of(0, o.title),
                        TooltipRow.Of(Chart.WithAlpha(Chart.Palette(t, fi), revealAlpha),
                            hk.from + " → " + hk.to + "  " + Convert.ToString(hk.val)) };
                    ChartView.TooltipCard(app, mx, my, x + w, rows);
                }
            }
        }
    }

    // ---- 树形图（ECharts type 'tree'；分层节点连接图） ----

    /// 节点下的叶子槽位数（一个叶子 = 1 个槽位）。
    static int TreeLeafCount(ChartNode n) {
        int childCount = ChartView.TreeChildCount(n);
        if (childCount == 0) { return 1; }
        int s = 0;
        for (int i = 0; i < childCount; i = i + 1) { s = s + ChartView.TreeLeafCount(n.children[i]); }
        return s;
    }

    /// 为每个节点分配 span 坐标：节点跨越叶子 [lo, hi)，
    /// 其中心位于该叶子范围中点。span 在垂直树中
    /// 从左到右，在水平树中从上到下。
    static void TreeAssign(ChartNode n, int lo, int depth,
                           List<TreeLayoutNode> layout) {
        layout.Add(TreeLayoutNode.Of(n, depth, lo, ChartView.TreeLeafCount(n)));
        int childCount = ChartView.TreeChildCount(n);
        if (childCount > 0) {
            int acc = lo;
            for (int i = 0; i < childCount; i = i + 1) {
                ChartView.TreeAssign(n.children[i], acc, depth + 1, layout);
                acc = acc + ChartView.TreeLeafCount(n.children[i]);
            }
        }
    }

    /// 布局节点在增长缩放后的 span 上叶子范围的中心。
    static int TreeSpan(TreeLayoutNode node, int spanG, int leaves) {
        long pos = (long)(2 * node.lo + node.count) * spanG / (2 * leaves);
        return (int)pos;
    }

    static int TreeLabelWidth(ChartNode n, int fs) {
        int widest = Canvas.MeasureText(ChartView.TreeNodeName(n), fs);
        int childCount = ChartView.TreeChildCount(n);
        for (int i = 0; i < childCount; i = i + 1) {
            int childW = ChartView.TreeLabelWidth(n.children[i], fs);
            if (childW > widest) { widest = childW; }
        }
        return widest;
    }

    static bool WordCloudFits(List<WordCloudItem> placed, int x, int y, int w, int h) {
        for (int i = 0; i < placed.Count; i = i + 1) {
            WordCloudItem item = placed[i];
            if (x < item.x + item.w && x + w > item.x
                && y < item.y + item.h && y + h > item.y) { return false; }
        }
        return true;
    }

    static void DrawWordCloud(App app, int x, int y, int w, int h,
                              ChartOption o, int g) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        ChartSeries lead = ChartView.LeadSeries(o);
        int top = Chart.DrawPanelI(app, x, y, w, h, o.title, o.series,
            o.iwid, o.showLegend);
        if (lead == null || lead.data.Count == 0) { return; }

        int pad = app.Scale(10);
        int ax = x + pad;
        int ay = top + app.Scale(2);
        int aw = w - pad * 2;
        int ah = (y + h - pad) - ay;
        if (aw < app.Scale(24) || ah < app.Scale(24)) { return; }

        int maxV = 1;
        for (int i = 0; i < lead.data.Count; i = i + 1) {
            if (lead.data[i].val > maxV) { maxV = lead.data[i].val; }
        }

        int minFs = lead != null && lead.wcMinFontSize > 0
            ? app.Scale(lead.wcMinFontSize) : app.Scale(11);
        int maxFs = lead != null && lead.wcMaxFontSize > 0
            ? app.Scale(lead.wcMaxFontSize) : app.Scale(36);
        if (maxFs > ah / 3) { maxFs = ah / 3; }
        if (maxFs > aw / 6) { maxFs = aw / 6; }
        if (maxFs < minFs) { maxFs = minFs; }
        bool vary = lead != null && lead.wcRotate == "vary";
        string rotList = lead != null ? lead.wcRotateList : "";
        if (rotList == "0") { rotList = ""; }   // 单一 0° = 不旋转，等同空
        if (rotList.Length > 0) { vary = false; }

        int wfp = ChartView.WordCloudFingerprint(lead.data, aw, ah, minFs, maxFs,
            vary ? 1 : 0 + ChartView.WordCloudRotListKey(rotList));
        if (ChartView.wcCache == null) {
            ChartView.wcCache = new List<WordCloudCacheEntry>();
        }
        List<WordCloudItem> placed = null;
        WordCloudCacheEntry hit = WordCloudCacheEntry.Lookup(ChartView.wcCache, wfp);
        if (hit != null) { placed = hit.items; }

        if (placed == null) {
            placed = ChartView.PlaceWordCloud(app, t, lead.data, aw, ah,
                minFs, maxFs, maxV, vary, rotList);
            WordCloudCacheEntry.Store(ChartView.wcCache, wfp, placed, 4);
        }

        int alpha = 255 * g / 1000;
        if (alpha < 0) { alpha = 0; }
        if (alpha > 255) { alpha = 255; }
        c.PushClip(ax, ay, aw, ah);
        for (int wi = 0; wi < placed.Count; wi = wi + 1) {
            WordCloudItem it = placed[wi];
            int col = Chart.WithAlpha(it.color, alpha);
            if (it.rot == 0) {
                c.DrawText(ax + it.x, ay + it.y, it.data.name, col, it.fontSize);
            } else {
                // 绕锚点顺时针 90°：锚点取旋转后包围盒右上角，字形
                // 落回 [x, x+w]×[y, y+h]（w/h 已是交换后的包围盒）。
                c.DrawTextRot(ax + it.x + it.w, ay + it.y, it.data.name,
                    col, it.fontSize, it.rot);
            }
        }
        c.PopClip();
    }

    /// 阿基米德螺旋放置：字号按权重，放不下就缩小，坐标相对绘图区。
    /// vary 为真时奇数词条旋转 90°（ECharts wordCloud rotateRange
    /// 的 0/90 两态）；rotList 非空时按词条序号对角度集取模轮转
    /// （ECharts textRotation 数组的确定性取法——随机/任意角度会破坏
    /// 布局缓存与截图回归，角度仍限于 ±90 内由 DrawTextRot 支持）。
    /// 旋转项的包围盒按 |sin|/|cos| 投影计算（非 90° 角不再简单交换
    /// 宽高），碰撞检测与裁剪都用包围盒。
    static List<WordCloudItem> PlaceWordCloud(App app, Theme t, List<ChartData> src,
                                              int aw, int ah, int minFs, int maxFs,
                                              int maxV, bool vary, string rotList) {
        List<int> angles = new List<int>();
        if (rotList != null && rotList.Length > 0) {
            List<string> parts = rotList.Split(',');
            for (int pi = 0; pi < parts.Count; pi = pi + 1) {
                int deg = Convert.ToInt32(parts[pi].Trim());
                if (deg != 0) { angles.Add(deg); }
            }
            if (angles.Count == 0) { angles.Add(0); }
        }
        List<ChartData> words = new List<ChartData>();
        for (int i = 0; i < src.Count; i = i + 1) { words.Add(src[i]); }
        for (int a = 0; a < words.Count; a = a + 1) {
            int best = a;
            for (int b = a + 1; b < words.Count; b = b + 1) {
                if (words[b].val > words[best].val) { best = b; }
            }
            if (best != a) {
                ChartData tmp = words[a];
                words[a] = words[best];
                words[best] = tmp;
            }
        }

        List<WordCloudItem> placed = new List<WordCloudItem>();
        int maxR = (aw < ah ? aw : ah) / 2;
        if (maxR < app.Scale(24)) { maxR = app.Scale(24); }
        int attempts = 480;
        for (int wi = 0; wi < words.Count; wi = wi + 1) {
            ChartData word = words[wi];
            if (word.name.Length < 1) { continue; }
            int fs = minFs + (maxFs - minFs) * word.val / maxV;
            int color = word.color;
            if (color == 0) { color = Chart.Palette(t, wi); }
            int rotDeg = 0;
            if (angles.Count > 0) {
                rotDeg = angles[wi % angles.Count];
            } else if (vary && wi % 2 == 1) {
                rotDeg = 90;
            }
            // 非零角度的占位盒：文本行绕锚点刚性旋转后的轴对齐包围盒。
            // 90° 即宽高交换；其余角度按 |sin|/|cos| 投影（DrawTextRot
            // 钳制 ±90，sin/cos 用同一张千分表）。
            bool rot = rotDeg != 0;
            int ad = rotDeg < 0 ? 0 - rotDeg : rotDeg;
            int sPct = ChartView.SinDeg(ad);
            int cPct = ChartView.CosDeg(ad);
            bool done = false;
            int shrink = 0;
            while (!done && shrink < 10) {
                int tw = Canvas.MeasureText(word.name, fs) + app.Scale(6);
                int th = Canvas.FontHeight(fs) + app.Scale(2);
                // 旋转项占位盒 = 原行绕锚点旋转后的轴对齐包围盒。
                int bw = rot ? (tw * cPct + th * sPct) / 1000 : tw;
                int bh = rot ? (tw * sPct + th * cPct) / 1000 : th;
                if (bw < 1) { bw = 1; }
                if (bh < 1) { bh = 1; }
                if (bw > aw - 2) {
                    if (fs <= minFs) { done = true; }
                    else { fs = fs - 2; if (fs < minFs) { fs = minFs; } }
                    shrink = shrink + 1;
                    continue;
                }
                if (bh > ah - 2) {
                    if (fs <= minFs) { done = true; }
                    else { fs = fs - 2; if (fs < minFs) { fs = minFs; } }
                    shrink = shrink + 1;
                    continue;
                }
                int attempt = 0;
                while (attempt < attempts && !done) {
                    int angle = (attempt * 137 + wi * 53) % 360;
                    int radius = maxR * attempt / attempts;
                    int cx = aw / 2 + ChartView.CosDeg(angle) * radius / 1000;
                    int cy = ah / 2 + ChartView.SinDeg(angle) * radius / 1000;
                    int tx = cx - bw / 2;
                    int ty = cy - bh / 2;
                    if (tx < 0) { tx = 0; }
                    if (ty < 0) { ty = 0; }
                    if (tx + bw > aw) { tx = aw - bw; }
                    if (ty + bh > ah) { ty = ah - bh; }
                    if (tx >= 0 && ty >= 0 && tx + bw <= aw && ty + bh <= ah
                        && ChartView.WordCloudFits(placed, tx, ty, bw, bh)) {
                        placed.Add(WordCloudItem.Of(word, tx, ty, bw, bh, fs, color,
                            rotDeg));
                        done = true;
                    } else {
                        attempt = attempt + 1;
                    }
                }
                if (!done) {
                    if (fs <= minFs) { done = true; }
                    else { fs = fs - 2; if (fs < minFs) { fs = minFs; } }
                    shrink = shrink + 1;
                }
            }
        }
        return placed;
    }

    static int WordCloudFingerprint(List<ChartData> data, int aw, int ah,
                                    int minFs, int maxFs, int rotate) {
        int fp = (aw * 7 + ah * 13 + minFs * 17 + maxFs * 19 + rotate * 29)
            % 2000000000;
        for (int i = 0; i < data.Count; i = i + 1) {
            fp = ChartView.FoldStr(fp, data[i].name, 23);
            fp = (fp * 31 + data[i].val) % 2000000000;
        }
        return fp;
    }

    /// 自定义角度集的指纹成分："0,45,-45" → 稳定小整数（空串 = 0）。
    static int WordCloudRotListKey(string rotList) {
        if (rotList == null || rotList.Length == 0) { return 0; }
        int h = 977;
        for (int i = 0; i < rotList.Length; i = i + 1) {
            h = (h * 31 + rotList[i]) % 997;
        }
        return h + 2;
    }

    // 词云布局缓存：指纹 → 放置结果（小容量，见 WordCloudCacheEntry）。
    static List<WordCloudCacheEntry> wcCache;

    /// 无限画布网格：世界原点落在视口 (ax - panX, ay - panY)，
    /// 间距随缩放变稀/变密，密到看不清时跳级。
    static int TreeGridFirst(int origin, int view0, int gs) {
        if (gs < 1) { return view0; }
        int x = origin;
        if (x < view0) {
            int d = view0 - x;
            x = x + (d / gs) * gs;
            if (x < view0) { x = x + gs; }
        } else if (x > view0) {
            int d = x - view0;
            x = x - (d / gs) * gs;
        }
        return x;
    }

    static void DrawTreeCanvasGrid(App app, Canvas c, int ax, int ay, int aw, int ah,
                                   int panX, int panY, int zoom) {
        int worldStep = app.Scale(28);
        int gs = worldStep * zoom / 100;
        while (gs < app.Scale(18) && worldStep < 512) {
            worldStep = worldStep * 2;
            gs = worldStep * zoom / 100;
        }
        if (gs < 8) { return; }
        int col = Chart.WithAlpha(Style.Part(app, "chart", "grid", "", "", "",
            Style.SNormal()).BgOr(0), 55);
        int originX = ax - panX;
        int originY = ay - panY;
        int gx = ChartView.TreeGridFirst(originX, ax, gs);
        int n = 0;
        while (gx < ax + aw && n < 256) {
            if (gx >= ax) { c.FillRect(gx, ay, 1, ah, col); }
            int nx = gx + gs;
            if (nx <= gx) { n = 256; } else { gx = nx; }
            n = n + 1;
        }
        int gy = ChartView.TreeGridFirst(originY, ay, gs);
        n = 0;
        while (gy < ay + ah && n < 256) {
            if (gy >= ay) { c.FillRect(ax, gy, aw, 1, col); }
            int ny = gy + gs;
            if (ny <= gy) { n = 256; } else { gy = ny; }
            n = n + 1;
        }
    }

    static void DrawTree(App app, int x, int y, int w, int h,
                         ChartOption o, int g) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        ChartSeries lead = ChartView.LeadSeries(o);
        if (lead == null || lead.tree == null || lead.tree.Count < 1) { return; }
        ChartNode root = lead.tree[0];
        if (root == null) { return; }
        int plotTop = ChartView.PanelHead(app, x, y, w, h, o.title);
        int pad = t.paddingMedium;
        int ax = x + pad;
        int ay = plotTop;
        int aw = w - pad * 2;
        int ah = (y + h - pad) - plotTop;
        int hintFs = Style.FontFallback(app, "small");
        int hintH = Canvas.FontHeight(hintFs) + app.Scale(6);
        if (ah > hintH + app.Scale(24)) { ah = ah - hintH; }
        if (aw < app.Scale(10) || ah < app.Scale(10)) { return; }

        bool horiz = false;
        if (lead.treeOrient == "horizontal") { horiz = true; }

        int leaves = ChartView.TreeLeafCount(root);
        int depth = ChartView.TreeDepth(root);
        if (leaves < 1) { leaves = 1; }
        if (depth < 1) { depth = 1; }

        // 稳定命中 id（AllocId 每帧换号会让滚轮/拖拽丢目标）。
        // roam 关闭时不注册抓手区域；开启时优先复用图表根命中区，
        // 避免独立 panId 覆盖 ChartView 的 Click/DoubleClick 所有权。
        int panId = Chart.TreeHitKey(o.iwid);
        if (ChartView.activeEventView != null
            && ChartView.activeEventView.eventHitId >= 0) {
            panId = ChartView.activeEventView.eventHitId;
        }
        if (ChartView.TreeRoamEnabled(o.roam)) {
            app.hitTester.RegisterRect(panId, ax, ay, aw, ah, 0);
        }

        // 字号保持可读：缩放改节点间距，标签跟节点走、越出视口裁掉。
        int fs = Style.FontFallback(app, "small");
        int fh = Canvas.FontHeight(fs);
        int labelW = ChartView.TreeLabelWidth(root, fs);
        int rad = app.Scale(4);
        int gapSpan = 0;
        int gapDep = 0;
        if (horiz) {
            gapSpan = fh + app.Scale(14);
            if (gapSpan < app.Scale(22)) { gapSpan = app.Scale(22); }
            gapDep = labelW + rad * 2 + app.Scale(28);
            if (gapDep < app.Scale(40)) { gapDep = app.Scale(40); }
        } else {
            gapSpan = labelW + app.Scale(16);
            if (gapSpan < app.Scale(36)) { gapSpan = app.Scale(36); }
            gapDep = rad * 2 + fh + app.Scale(22);
            if (gapDep < app.Scale(32)) { gapDep = app.Scale(32); }
        }

        int natSpan = leaves * gapSpan;
        int natDep = depth * gapDep + app.Scale(8);
        int natW = horiz ? (natDep + labelW + rad) : natSpan;
        int natH = horiz ? natSpan : (natDep + fh + rad);

        int zoom = app.StateGet(Chart.TreeZoomKey(o.iwid), 0);
        int panX = app.StateGet(Chart.TreePanXKey(o.iwid), 0);
        int panY = app.StateGet(Chart.TreePanYKey(o.iwid), 0);
        if (zoom == 0) {
            zoom = 100;
            if (natW > aw && natW > 0) { zoom = aw * 90 / natW; }
            int zH = 100;
            if (natH > ah && natH > 0) { zH = ah * 90 / natH; }
            if (zH < zoom) { zoom = zH; }
            if (zoom < 20) { zoom = 20; }
            if (zoom > 100) { zoom = 100; }
            panX = natW * zoom / 200 - aw / 2;
            panY = natH * zoom / 200 - ah / 2;
            app.StateSet(Chart.TreeZoomKey(o.iwid), zoom);
            app.StateSet(Chart.TreePanXKey(o.iwid), panX);
            app.StateSet(Chart.TreePanYKey(o.iwid), panY);
        }
        // 滚轮缩放走 CaptureWheel 仲裁（与 ScrollView/DataTable 同一
        // 机制）：只按 hover-id 消费会和外层滚动条打架——指针悬在树
        // 图上滚一格，图缩放的同时整页也滚 60px，图从指针底下挪走后
        // hover 又断，滚轮步幅忽大忽小（用户报告的“滚轮跳跃”）。声明
        // 本绘图区后，最后声明者（即最内层）独占这一格，外层不再滚。
        if (ChartView.TreeRoamEnabled(o.roam)
            && app.CaptureWheel(ax, ay, aw, ah)) {
            int ticks = ChartView.WheelTicks(app);
            int next = ChartView.ZoomByTicks(zoom, ticks, 20, 400);
            if (next != zoom && zoom > 0) {
                panX = (app.mouseX - ax + panX) * next / zoom - (app.mouseX - ax);
                panY = (app.mouseY - ay + panY) * next / zoom - (app.mouseY - ay);
                zoom = next;
                app.StateSet(Chart.TreeZoomKey(o.iwid), zoom);
                app.StateSet(Chart.TreePanXKey(o.iwid), panX);
                app.StateSet(Chart.TreePanYKey(o.iwid), panY);
                app.RequestRedraw();
            }
        }
        gapSpan = gapSpan * zoom / 100;
        gapDep = gapDep * zoom / 100;
        if (gapSpan < 2) { gapSpan = 2; }
        if (gapDep < 2) { gapDep = 2; }

        int contentSpan = leaves * gapSpan;
        int contentDep = depth * gapDep + app.Scale(8);
        if (contentSpan < 2) { contentSpan = 2; }
        if (contentDep < 2) { contentDep = 2; }
        int contentW = horiz ? (contentDep + labelW + rad) : contentSpan;
        int contentH = horiz ? contentSpan : (contentDep + fh + rad);

        if (ChartView.TreeRoamEnabled(o.roam)
            && Ui.PressedDown(app, panId) && app.window.EventButton() == 0) {
            app.StateSet(Chart.TreeDragXKey(o.iwid), app.mouseX);
            app.StateSet(Chart.TreeDragYKey(o.iwid), app.mouseY);
            app.StateSet(Chart.TreeDragPanXKey(o.iwid), panX);
            app.StateSet(Chart.TreeDragPanYKey(o.iwid), panY);
            app.StateSet(Chart.TreeDragMovedKey(o.iwid), 0);
            app.StateSet(Chart.TreeDraggingKey(o.iwid), 1);
        }
        bool treeDragging = app.StateGet(Chart.TreeDraggingKey(o.iwid), 0) == 1;
        if (ChartView.TreeRoamEnabled(o.roam) && treeDragging
            && Ui.Pressed(app, panId) && app.EventKind() == 1) {
            int dxMove = app.mouseX - app.StateGet(Chart.TreeDragXKey(o.iwid), app.mouseX);
            int dyMove = app.mouseY - app.StateGet(Chart.TreeDragYKey(o.iwid), app.mouseY);
            if (dxMove != 0 || dyMove != 0) {
                app.StateSet(Chart.TreeDragMovedKey(o.iwid), 1);
            }
            panX = app.StateGet(Chart.TreeDragPanXKey(o.iwid), panX) - dxMove;
            panY = app.StateGet(Chart.TreeDragPanYKey(o.iwid), panY) - dyMove;
            app.RequestRedraw();
        }
        if (app.EventKind() == 3) {
            if (treeDragging
                && app.StateGet(Chart.TreeDragMovedKey(o.iwid), 0) == 1) {
                app.ClaimClick();
            }
            app.StateSet(Chart.TreeDraggingKey(o.iwid), 0);
            app.StateSet(Chart.TreeDragMovedKey(o.iwid), 0);
        }
        panX = ChartView.ClampPan(panX, contentW, aw);
        panY = ChartView.ClampPan(panY, contentH, ah);
        app.StateSet(Chart.TreePanXKey(o.iwid), panX);
        app.StateSet(Chart.TreePanYKey(o.iwid), panY);

        int span0 = (horiz ? ay - panY : ax - panX);
        int dep0 = (horiz ? ax - panX : ay - panY) + app.Scale(8) * zoom / 100;
        int spanG = contentSpan;
        int depG = contentDep;

        int alpha = 255 * g / 1000;
        if (alpha < 40) { alpha = 40; }
        if (alpha > 255) { alpha = 255; }

        c.PushClip(ax, ay, aw, ah);
        ChartView.DrawTreeCanvasGrid(app, c, ax, ay, aw, ah, panX, panY, zoom);
        List<TreeLayoutNode> layout = new List<TreeLayoutNode>();
        ChartView.TreeAssign(root, 0, 0, layout);

        int col = 0;
        if (lead != null) { col = lead.color; }
        if (col == 0) { col = Chart.Palette(t, 0); }
        int nodeCol = Chart.WithAlpha(col, alpha);
        int linkCol = Chart.WithAlpha(Style.Part(app, "chart", "grid", "", "", "",
            Style.SNormal()).BgOr(0), alpha);
        int lblCol = Chart.WithAlpha(Style.Part(app, "chart", "label", "", "", "",
            Style.SNormal()).FgOr(0), alpha);

        int i = 0;
        while (i < layout.Count) {
            TreeLayoutNode parent = layout[i];
            ChartNode n = parent.node;
            int childCount = ChartView.TreeChildCount(n);
            if (childCount == 0) { i = i + 1; continue; }
            int pSpan = ChartView.TreeSpan(parent, spanG, leaves);
            int pDep = parent.depth * gapDep;
            for (int c0 = 0; c0 < childCount; c0 = c0 + 1) {
                ChartNode ch = n.children[c0];
                int ci = 0;
                for (; ci < layout.Count; ci = ci + 1) {
                    if (layout[ci].node == ch) { break; }
                }
                if (ci >= layout.Count) { continue; }
                TreeLayoutNode child = layout[ci];
                int cSpan = ChartView.TreeSpan(child, spanG, leaves);
                int cDep = child.depth * gapDep;
                int p0 = span0 + pSpan;
                int p1 = dep0 + pDep;
                int q0 = span0 + cSpan;
                int q1 = dep0 + cDep;
                if (horiz) {
                    int mid = (p1 + q1) / 2;
                    c.DrawLine(p1, p0, mid, p0, linkCol, app.Scale(1));
                    c.DrawLine(mid, p0, mid, q0, linkCol, app.Scale(1));
                    c.DrawLine(mid, q0, q1, q0, linkCol, app.Scale(1));
                } else {
                    int mid = (p1 + q1) / 2;
                    c.DrawLine(p0, p1, p0, mid, linkCol, app.Scale(1));
                    c.DrawLine(p0, mid, q0, mid, linkCol, app.Scale(1));
                    c.DrawLine(q0, mid, q0, q1, linkCol, app.Scale(1));
                }
            }
            i = i + 1;
        }

        for (int j = 0; j < layout.Count; j = j + 1) {
            TreeLayoutNode item = layout[j];
            ChartNode n = item.node;
            int span = ChartView.TreeSpan(item, spanG, leaves);
            int d = item.depth * gapDep;
            int nx = horiz ? dep0 + d : span0 + span;
            int ny = horiz ? span0 + span : dep0 + d;
            if (nx + rad < ax || nx - rad > ax + aw
                || ny + rad + fh + app.Scale(6) < ay || ny - rad > ay + ah) {
                continue;
            }
            c.FillCircle(nx, ny, rad, nodeCol);
            string lbl = ChartView.TreeNodeName(n);
            int lw = Canvas.MeasureText(lbl, fs);
            int lx = 0;
            int ly = 0;
            if (horiz) {
                lx = nx + rad + app.Scale(6);
                ly = Canvas.CenterTextYAt(ny, fs);
            } else {
                lx = nx - lw / 2;
                ly = ny + rad + app.Scale(4);
            }
            c.DrawText(lx, ly, lbl, lblCol, fs);
        }
        c.PopClip();

        c.DrawText(ax + app.Scale(4), ay + ah + app.Scale(2),
            "滚轮缩放  ·  拖拽平移  ·  还原适配",
            Style.Part(app, "chart", "hint", "", "", "", Style.SNormal()).FgOr(0),
            hintFs);

        if (app.mouseX >= ax && app.mouseX < ax + aw
            && app.mouseY >= ay && app.mouseY < ay + ah
            && app.StateGet(Chart.TreeDraggingKey(o.iwid), 0) == 0) {
            int mx = app.mouseX;
            int my = app.mouseY;
            int best = 0 - 1;
            int bestD2 = 0;
            bool bestDot = false;
            int hitRad = ChartView.TreeHitRadius(rad, zoom, app.Scale(1));
            for (int k = 0; k < layout.Count; k = k + 1) {
                TreeLayoutNode item = layout[k];
                int span = ChartView.TreeSpan(item, spanG, leaves);
                int d = item.depth * gapDep;
                int nx = horiz ? dep0 + d : span0 + span;
                int ny = horiz ? span0 + span : dep0 + d;
                if (nx + hitRad < ax || nx - hitRad >= ax + aw
                    || ny + hitRad + fh < ay || ny - hitRad >= ay + ah) {
                    continue;
                }
                string lbl = ChartView.TreeNodeName(item.node);
                int lw = Canvas.MeasureText(lbl, fs);
                int lx = horiz ? nx + rad + app.Scale(6) : nx - lw / 2;
                int ly = horiz ? Canvas.CenterTextYAt(ny, fs) : ny + rad + app.Scale(4);
                int dx = mx - nx;
                int dy = my - ny;
                int d2 = dx * dx + dy * dy;
                bool onDot = dx >= 0 - hitRad && dx <= hitRad
                    && dy >= 0 - hitRad && dy <= hitRad
                    && d2 <= hitRad * hitRad;
                bool onLbl = mx >= lx && mx < lx + lw && my >= ly && my < ly + fh;
                bool candidate = onDot || onLbl;
                if (!candidate) { continue; }
                // 节点圆点优先于标签；同一优先级取离指针最近者，
                // 避免低 zoom 时 preorder 的前节点吞掉后节点。
                bool replace = best < 0;
                if (!replace && onDot && !bestDot) { replace = true; }
                if (!replace && onDot == bestDot && d2 < bestD2) { replace = true; }
                if (replace) {
                    best = k;
                    bestD2 = d2;
                    bestDot = onDot;
                }
            }
            if (best >= 0) {
                ChartNode hn = layout[best].node;
                int nodeSeries = ChartView.SeriesIndexOf(o, lead);
                ChartHit th = ChartHit.Of(ChartElementType.Node,
                    nodeSeries, lead != null ? lead.name : "", best,
                    ChartView.TreeNodeName(hn), hn.Total(), mx, my);
                if (lead != null) { th.axisIndex = lead.axisIndex; }
                ChartView.OfferActiveHit(th);
                if (o.showTooltip) {
                    List<TooltipRow> rows = new List<TooltipRow>();
                    rows.Add(TooltipRow.Of(0, o.title));
                    string tv = Convert.ToString(hn.Total());
                    rows.Add(TooltipRow.Of(col,
                        ChartView.TreeNodeName(hn) + "  " + tv));
                    ChartView.TooltipCard(app, mx, my, x + w, rows);
                }
            }
        }
    }
}
