using System;
using System.Json;
using Gui;

namespace Gui.Component.Chart;

class WordCloudItem {
    ChartData data;
    int x;
    int y;
    int w;
    int h;
    int fontSize;

    static WordCloudItem Of(ChartData data, int x, int y, int w, int h, int fontSize) {
        WordCloudItem item = new WordCloudItem();
        item.data = data;
        item.x = x;
        item.y = y;
        item.w = w;
        item.h = h;
        item.fontSize = fontSize;
        return item;
    }
}

class TreeLayoutNode {
    ChartNode node;
    int depth;
    int lo;
    int count;

    static TreeLayoutNode Of(ChartNode node, int depth, int lo, int count) {
        TreeLayoutNode layout = new TreeLayoutNode();
        layout.node = node;
        layout.depth = depth;
        layout.lo = lo;
        layout.count = count;
        return layout;
    }
}

class SankeyNodeLayout {
    string name;
    int layer;
    int flowOut;
    int flowIn;
    int x;
    int y;
    int h;

    static SankeyNodeLayout Of(string name) {
        SankeyNodeLayout node = new SankeyNodeLayout();
        node.name = name;
        node.layer = 0;
        node.flowOut = 0;
        node.flowIn = 0;
        node.x = 0;
        node.y = 0;
        node.h = 0;
        return node;
    }
}

partial class ChartView {
    // ---- 矩形树图（递归切片，交替分割方向） ----

    static void DrawTreemap(App app, int x, int y, int w, int h,
                            ChartOption o, int g) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        List<ChartSeries> series = o.series;
        if (series.Count < 1 || series[0].tree.Count < 1) { return; }
        ChartNode root = series[0].tree[0];
        int plotTop = ChartView.PanelHead(app, x, y, w, h, o.title);
        int pad = t.paddingMedium;
        int areaX = x + pad;
        int areaY = plotTop;
        int areaW = w - pad * 2;
        int areaH = (y + h - pad) - plotTop;
        if (areaW < app.Scale(10) || areaH < app.Scale(10)) { return; }
        int gw = areaW * g / 1000;
        int gh = areaH * g / 1000;
        areaX = areaX + (areaW - gw) / 2;
        areaY = areaY + (areaH - gh) / 2;
        areaW = gw;
        areaH = gh;
        if (areaW < app.Scale(4) || areaH < app.Scale(4)) { return; }

        if (root.children.Count == 0) {
            c.FillRoundRect(areaX, areaY, areaW, areaH, app.Scale(4), Chart.Palette(t, 0));
            ChartView.TreemapCell(app, areaX, areaY, areaW, areaH, root.name,
                Convert.ToString(root.val));
            return;
        }
        ChartView.TreemapSlice(app, areaX, areaY, areaW, areaH, root.children, 0);

        if (o.showTooltip) {
            int mx = app.mouseX;
            int my = app.mouseY;
            if (mx >= areaX && mx < areaX + areaW
                && my >= areaY && my < areaY + areaH) {
                ChartView.ttName = "";
                ChartView.ttVal = 0;
                ChartView.TreemapHit(app, areaX, areaY, areaW, areaH,
                    root.children, 0, mx, my);
                if (ChartView.ttName.Length > 0) {
                    // 描出精确悬停单元格的轮廓。
                    c.DrawRoundRect(ChartView.ttX, ChartView.ttY,
                        ChartView.ttW, ChartView.ttH, app.Scale(2), 4294967295, app.Scale(2));
                    List<TooltipRow> rows = new List<TooltipRow>{
                        TooltipRow.Of(0, o.title),
                        TooltipRow.Of(4294967295,
                            ChartView.ttName + "  " + Convert.ToString(ChartView.ttVal)) };
                    ChartView.TooltipCard(app, mx, my, x + w, rows);
                }
            }
        }
    }

    // 一层分割；单元格足够大时递归进子节点，
    // 否则以名称 + 值标记该单元格。
    static void TreemapSlice(App app, int x, int y, int w, int h,
                             List<ChartNode> nodes, int depth) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int total = 0;
        for (int i = 0; i < nodes.Count; i = i + 1) { total = total + nodes[i].Total(); }
        if (total < 1) { return; }
        bool vert = (depth % 2) == 0;
        int acc = 0;
        for (int j = 0; j < nodes.Count; j = j + 1) {
            ChartNode nd = nodes[j];
            int v = nd.Total();
            int cell = vert ? (h * v / total) : (w * v / total);
            int cx = x;
            int cy = y;
            int cw = w;
            int ch = h;
            if (vert) { ch = cell; cy = y + acc; }
            else { cw = cell; cx = x + acc; }
            acc = acc + cell;

            int col = Chart.Palette(t, j);
            if (depth > 0) { col = App.LerpColor(col, t.bgPrimary, depth * 130); }
            int rr = app.Scale(2);
            if (depth == 0) { rr = app.Scale(4); }
            if (cw > app.Scale(2) && ch > app.Scale(2)) {
                c.FillRoundRect(cx, cy, cw, ch, rr, col);
                c.DrawRoundRect(cx, cy, cw, ch, rr, t.bgPrimary, app.Scale(1));
            }
            if (nd.children.Count > 0 && cw > app.Scale(34) && ch > app.Scale(26)) {
                int inset = app.Scale(3);
                ChartView.TreemapSlice(app, cx + inset, cy + inset,
                    cw - inset * 2, ch - inset * 2, nd.children, depth + 1);
            } else {
                ChartView.TreemapCell(app, cx, cy, cw, ch, nd.name, Convert.ToString(v));
            }
        }
    }

    // 矩形树图单元格内的名称（+ 值）标签，仅放得下时绘制。
    static void TreemapCell(App app, int x, int y, int w, int h, string name, string val) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int fs = t.fontSizeSmall;
        int fh = Canvas.FontHeight(fs);
        if (w < app.Scale(20) || h < fh + app.Scale(4)) { return; }
        int nw = Canvas.MeasureText(name, fs);
        if (nw > w - app.Scale(6)) { nw = w - app.Scale(6); }
        c.DrawText(x + app.Scale(3), y + app.Scale(2), name, 4294967295, fs);
        if (h > fh * 2 + app.Scale(4) && val.Length > 0) {
            c.DrawText(x + app.Scale(3), y + app.Scale(2) + fh, val,
                Chart.WithAlpha(4294967295, 200), fs);
        }
    }

    // ---- 旭日图（同心环；最内环 = 根的子节点） ----

    static int TreeDepth(ChartNode n) {
        int md = 0;
        for (int i = 0; i < n.children.Count; i = i + 1) {
            int d = ChartView.TreeDepth(n.children[i]);
            if (d > md) { md = d; }
        }
        return md + 1;
    }

    // 矩形树图命中测试：按 TreemapSlice 相同的切片布局遍历，
    // 仅当指针位于子单元格内（且深度足够
    // 被分割）时才递归。填充静态命中字段 ttName/ttVal。
    static void TreemapHit(App app, int x, int y, int w, int h,
                           List<ChartNode> nodes, int depth, int px, int py) {
        int total = 0;
        for (int i = 0; i < nodes.Count; i = i + 1) { total = total + nodes[i].Total(); }
        if (total < 1) { return; }
        bool vert = (depth % 2) == 0;
        int acc = 0;
        for (int j = 0; j < nodes.Count; j = j + 1) {
            ChartNode nd = nodes[j];
            int v = nd.Total();
            int cell = vert ? (h * v / total) : (w * v / total);
            int cx = x;
            int cy = y;
            int cw = w;
            int ch = h;
            if (vert) { ch = cell; cy = y + acc; }
            else { cw = cell; cx = x + acc; }
            acc = acc + cell;
            if (px >= cx && px < cx + cw && py >= cy && py < cy + ch) {
                if (nd.children.Count > 0 && cw > app.Scale(34) && ch > app.Scale(26)) {
                    int inset = app.Scale(3);
                    ChartView.TreemapHit(app, cx + inset, cy + inset,
                        cw - inset * 2, ch - inset * 2, nd.children, depth + 1, px, py);
                } else {
                    ChartView.ttName = nd.name;
                    ChartView.ttVal = v;
                    ChartView.ttX = cx;
                    ChartView.ttY = cy;
                    ChartView.ttW = cw;
                    ChartView.ttH = ch;
                }
                return;
            }
        }
    }

    // 旭日图环形命中测试：按 SunburstRing 相同的角扫掠遍历，
    // 指针位于子扇形内时递归。填充
    // 静态命中字段 ttName/ttVal。
    static void SunburstHit(App app, int cx, int cy, int ringH, ChartNode node,
                            int depth, int a0, int a1, int px, int py) {
        int total = node.Total();
        if (total < 1) { return; }
        int kids = node.children.Count;
        if (kids == 0) { return; }
        int ddx = px - cx;
        int ddy = py - cy;
        int dist = ChartView.ISqrt(ddx * ddx + ddy * ddy);
        if (dist < depth * ringH || dist > (depth + 1) * ringH) { return; }
        int ang = ChartView.AngleOf(ddx, ddy);
        int a = a0;
        for (int i = 0; i < kids; i = i + 1) {
            ChartNode k = node.children[i];
            int v = k.Total();
            int span = (a1 - a0) * v / total;
            int aEnd = a + span;
            if (ang >= a && ang < aEnd) {
                if (k.children.Count > 0) {
                    ChartView.SunburstHit(app, cx, cy, ringH, k, depth + 1,
                        a, aEnd, px, py);
                } else {
                    ChartView.ttName = k.name;
                    ChartView.ttVal = v;
                    ChartView.ttA0 = a;
                    ChartView.ttA1 = aEnd;
                    ChartView.ttDepth = depth;
                }
                return;
            }
            a = a + span;
        }
    }

    static void DrawSunburst(App app, int x, int y, int w, int h,
                             ChartOption o, int g) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        List<ChartSeries> series = o.series;
        if (series.Count < 1 || series[0].tree.Count < 1) { return; }
        ChartNode root = series[0].tree[0];
        int top = ChartView.PanelHead(app, x, y, w, h, o.title);
        int pad = t.paddingMedium;
        int areaY = top;
        int areaH = (y + h - pad) - top;
        if (areaH < app.Scale(16)) { areaH = app.Scale(16); }
        int cx = x + w / 2;
        int cy = areaY + areaH / 2;
        int rMax = (w - pad * 2) / 2;
        if (areaH / 2 < rMax) { rMax = areaH / 2; }
        if (rMax < app.Scale(10)) { rMax = app.Scale(10); }
        int sweepMax = 360 * g / 1000;

        int rings = ChartView.TreeDepth(root);
        if (rings < 1) { rings = 1; }
        int ringH = rMax / (rings + 1);
        if (ringH < app.Scale(4)) { ringH = app.Scale(4); }
        ChartView.SunburstRing(app, cx, cy, ringH, root, 0, 0, 360, sweepMax, 0);

        // 中心标签 = 根节点名称
        if (root.name.Length > 0) {
            int fs = t.fontSizeSmall;
            c.DrawTextCentered(cx - ringH / 2, Canvas.CenterTextYAt(cy, fs),
                ringH, Canvas.FontHeight(fs), root.name, t.textSecondary, fs);
        }

        if (o.showTooltip) {
            int mx = app.mouseX;
            int my = app.mouseY;
            int ddx = mx - cx;
            int ddy = my - cy;
            int dist = ChartView.ISqrt(ddx * ddx + ddy * ddy);
            if (dist <= rMax) {
                ChartView.ttName = "";
                ChartView.ttVal = 0;
                ChartView.SunburstHit(app, cx, cy, ringH, root, 0, 0, 360, mx, my);
                if (ChartView.ttName.Length > 0) {
                    // 悬停扇区外缘的高亮圆环。
                    int hiInner = (ChartView.ttDepth + 1) * ringH - app.Scale(2);
                    int hiOuter = (ChartView.ttDepth + 1) * ringH;
                    if (hiInner < 0) { hiInner = 0; }
                    c.FillSector(cx, cy, hiInner, hiOuter,
                        ChartView.ttA0, ChartView.ttA1, 4294967295);
                    List<TooltipRow> rows = new List<TooltipRow>{
                        TooltipRow.Of(0, o.title),
                        TooltipRow.Of(4294967295,
                            ChartView.ttName + "  " + Convert.ToString(ChartView.ttVal)) };
                    ChartView.TooltipCard(app, mx, my, x + w, rows);
                }
            }
        }
    }

    static void SunburstRing(App app, int cx, int cy, int ringH, ChartNode node,
                             int depth, int a0, int a1, int sweepMax, int parentCol) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int total = node.Total();
        if (total < 1) { return; }
        int kids = node.children.Count;
        if (kids == 0) { return; }
        int rInner = depth * ringH;
        int rOuter = (depth + 1) * ringH;
        int a = a0;
        for (int i = 0; i < kids; i = i + 1) {
            ChartNode k = node.children[i];
            int v = k.Total();
            int span = (a1 - a0) * v / total;
            int aEnd = a + span;
            if (aEnd > sweepMax) { aEnd = sweepMax; }
            int col = Chart.Palette(t, i);
            if (depth > 0) { col = App.LerpColor(parentCol, 4294967295, 100 + depth * 70); }
            if (aEnd > a && rOuter > rInner) {
                c.FillSector(cx, cy, rInner, rOuter, a, aEnd, col);
                if (k.children.Count > 0) {
                    ChartView.SunburstRing(app, cx, cy, ringH, k, depth + 1,
                        a, aEnd, sweepMax, col);
                }
            }
            a = a + span;
        }
    }

    // ---- 桑基图（分层节点间的流量连线） ----

    static int SankeyIndex(List<SankeyNodeLayout> nodes, string name) {
        for (int i = 0; i < nodes.Count; i = i + 1) {
            if (nodes[i].name == name) { return i; }
        }
        return 0 - 1;
    }

    static void DrawSankey(App app, int x, int y, int w, int h,
                           ChartOption o, int g) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        List<ChartSeries> series = o.series;
        if (series.Count < 1 || series[0].links.Count < 1) { return; }
        List<ChartLink> links = series[0].links;
        int top = ChartView.PanelHead(app, x, y, w, h, o.title);
        int pad = t.paddingMedium;

        // 按首次出现顺序的节点列表。
        List<SankeyNodeLayout> nodes = new List<SankeyNodeLayout>();
        int li = 0;
        for (; li < links.Count; li = li + 1) {
            ChartLink lk = links[li];
            if (ChartView.SankeyIndex(nodes, lk.from) < 0) {
                nodes.Add(SankeyNodeLayout.Of(lk.from));
            }
            if (ChartView.SankeyIndex(nodes, lk.to) < 0) {
                nodes.Add(SankeyNodeLayout.Of(lk.to));
            }
        }
        // 最长路径分层：layer(to) >= layer(from) + 1。循环图会让
        // 朴素松弛永不收敛，因此最多跑（节点数-1）轮——简单
        // 路径长度的上界；剩下的回边把目标压到源节点同层，
        // 保证终止且布局稳定。
        int relaxRounds = nodes.Count - 1;
        if (relaxRounds < 1) { relaxRounds = 1; }
        for (int rr = 0; rr < relaxRounds; rr = rr + 1) {
            bool changed = false;
            li = 0;
            while (li < links.Count) {
                ChartLink lk = links[li];
                int fi = ChartView.SankeyIndex(nodes, lk.from);
                int ti = ChartView.SankeyIndex(nodes, lk.to);
                if (nodes[ti].layer < nodes[fi].layer + 1) {
                    nodes[ti].layer = nodes[fi].layer + 1;
                    changed = true;
                }
                li = li + 1;
            }
            if (!changed) { break; }
        }
        // 回边固定：目标层未领先源层的边，把目标放到源同层
        // （循环边的水平退化布局），此后每条边都满足
        // layer(to) >= layer(from)，不再有反向边。
        li = 0;
        while (li < links.Count) {
            ChartLink lk = links[li];
            int fi = ChartView.SankeyIndex(nodes, lk.from);
            int ti = ChartView.SankeyIndex(nodes, lk.to);
            if (nodes[ti].layer < nodes[fi].layer) {
                nodes[ti].layer = nodes[fi].layer;
            }
            li = li + 1;
        }
        int maxLayer = 0;
        for (int nk = 0; nk < nodes.Count; nk = nk + 1) {
            if (nodes[nk].layer > maxLayer) { maxLayer = nodes[nk].layer; }
        }
        if (maxLayer < 1) { maxLayer = 1; }
        int nLayers = maxLayer + 1;

        // 节点流量（入/出取较大者）决定节点高度。
        int nn = nodes.Count;
        li = 0;
        while (li < links.Count) {
            ChartLink lk = links[li];
            int fi = ChartView.SankeyIndex(nodes, lk.from);
            int ti = ChartView.SankeyIndex(nodes, lk.to);
            nodes[fi].flowOut = nodes[fi].flowOut + lk.val;
            nodes[ti].flowIn = nodes[ti].flowIn + lk.val;
            li = li + 1;
        }

        int colW = (w - pad * 2) / nLayers;
        int nodeW = colW * 3 / 8;
        if (nodeW < app.Scale(18)) { nodeW = app.Scale(18); }
        int areaH = (y + h - pad) - top;
        int colH = areaH * 8 / 10;

        // 每列流量合计，用于垂直堆叠。
        List<int> colTotal = new List<int>();
        List<int> colCum = new List<int>();
        for (int lc = 0; lc < nLayers; lc = lc + 1) { colTotal.Add(0); colCum.Add(0); }
        int ni = 0;
        for (; ni < nn; ni = ni + 1) {
            SankeyNodeLayout node = nodes[ni];
            int fl = node.flowOut;
            if (fl < node.flowIn) { fl = node.flowIn; }
            colTotal[node.layer] = colTotal[node.layer] + fl;
        }

        ni = 0;
        while (ni < nn) {
            SankeyNodeLayout node = nodes[ni];
            int fl = node.flowOut;
            if (fl < node.flowIn) { fl = node.flowIn; }
            int th2 = colTotal[node.layer];
            if (th2 < 1) { th2 = 1; }
            node.h = colH * fl / th2;
            if (node.h < app.Scale(4)) { node.h = app.Scale(4); }
            node.x = x + pad + node.layer * colW;
            node.y = top + (areaH - colH) / 2 + colCum[node.layer];
            colCum[node.layer] = colCum[node.layer] + node.h + app.Scale(4);
            ni = ni + 1;
        }

        // 先画连线（节点会盖住其边缘）：从
        // 源节点右缘到目标节点左缘的粗圆角色带。
        int maxFlow = 1;
        li = 0;
        while (li < links.Count) { if (links[li].val > maxFlow) { maxFlow = links[li].val; } li = li + 1; }
        int maxTh = app.Scale(10);
        li = 0;
        while (li < links.Count) {
            ChartLink lk = links[li];
            int fi = ChartView.SankeyIndex(nodes, lk.from);
            int ti = ChartView.SankeyIndex(nodes, lk.to);
            int th = maxTh * lk.val / maxFlow;
            if (th < app.Scale(2)) { th = app.Scale(2); }
            SankeyNodeLayout fromNode = nodes[fi];
            SankeyNodeLayout toNode = nodes[ti];
            int x0 = fromNode.x + nodeW;
            int y0 = fromNode.y + fromNode.h / 2;
            int x1 = toNode.x;
            int y1 = toNode.y + toNode.h / 2;
            c.DrawLine(x0, y0, x1, y1, Chart.WithAlpha(Chart.Palette(t, fi), 170), th);
            li = li + 1;
        }

        // 节点 + 标签（源列标签左对齐，其余右对齐）。
        ni = 0;
        while (ni < nn) {
            SankeyNodeLayout node = nodes[ni];
            c.FillRoundRect(node.x, node.y, nodeW, node.h,
                app.Scale(3), Chart.Palette(t, ni));
            int fs = t.fontSizeSmall;
            int fh = Canvas.FontHeight(fs);
            int lx2 = node.x + nodeW + app.Scale(4);
            if (node.layer == 0) {
                lx2 = node.x - app.Scale(4) - Canvas.MeasureText(node.name, fs);
            }
            c.DrawText(lx2, node.y + node.h / 2 - fh / 2,
                node.name, t.textSecondary, fs);
            ni = ni + 1;
        }

        if (o.showTooltip) {
            int mx = app.mouseX;
            int my = app.mouseY;
            // 连线悬停：半厚度色带内的最近连线。
            int bestL = 0 - 1;
            int bestD = 0;
            li = 0;
            while (li < links.Count) {
                ChartLink lk = links[li];
                int fi = ChartView.SankeyIndex(nodes, lk.from);
                int ti = ChartView.SankeyIndex(nodes, lk.to);
                SankeyNodeLayout fromNode = nodes[fi];
                SankeyNodeLayout toNode = nodes[ti];
                int x0 = fromNode.x + nodeW;
                int y0 = fromNode.y + fromNode.h / 2;
                int x1 = toNode.x;
                int y1 = toNode.y + toNode.h / 2;
                int d = ChartView.DistToSeg(mx, my, x0, y0, x1, y1);
                if (bestL < 0 || d < bestD) { bestL = li; bestD = d; }
                li = li + 1;
            }
            int linkR = app.Scale(8);
            if (bestL >= 0 && bestD <= linkR) {
                ChartLink hk = links[bestL];
                int fi = ChartView.SankeyIndex(nodes, hk.from);
                int ti = ChartView.SankeyIndex(nodes, hk.to);
                SankeyNodeLayout fromNode = nodes[fi];
                SankeyNodeLayout toNode = nodes[ti];
                int x0 = fromNode.x + nodeW;
                int y0 = fromNode.y + fromNode.h / 2;
                int x1 = toNode.x;
                int y1 = toNode.y + toNode.h / 2;
                c.DrawLine(x0, y0, x1, y1, 4294967295, app.Scale(3));
                List<TooltipRow> rows = new List<TooltipRow>{
                    TooltipRow.Of(0, o.title),
                    TooltipRow.Of(Chart.Palette(t, fi),
                        hk.from + " → " + hk.to + "  " + Convert.ToString(hk.val)) };
                ChartView.TooltipCard(app, mx, my, x + w, rows);
            }
        }
    }

    // ---- 树形图（ECharts type 'tree'；分层节点连接图） ----

    /// 节点下的叶子槽位数（一个叶子 = 1 个槽位）。
    static int TreeLeafCount(ChartNode n) {
        if (n.children.Count == 0) { return 1; }
        int s = 0;
        for (int i = 0; i < n.children.Count; i = i + 1) { s = s + ChartView.TreeLeafCount(n.children[i]); }
        return s;
    }

    /// 节点下方最深路径的深度（边数）。
    static int TreeDepth(ChartNode n) {
        int md = 0;
        for (int i = 0; i < n.children.Count; i = i + 1) {
            int d = ChartView.TreeDepth(n.children[i]) + 1;
            if (d > md) { md = d; }
        }
        return md;
    }

    /// 为每个节点分配 span 坐标：节点跨越叶子 [lo, hi)，
    /// 其中心位于该叶子范围中点。span 在垂直树中
    /// 从左到右，在水平树中从上到下。
    static void TreeAssign(ChartNode n, int lo, int depth,
                           List<TreeLayoutNode> layout) {
        layout.Add(TreeLayoutNode.Of(n, depth, lo, ChartView.TreeLeafCount(n)));
        if (n.children.Count > 0) {
            int acc = lo;
            for (int i = 0; i < n.children.Count; i = i + 1) {
                ChartView.TreeAssign(n.children[i], acc, depth + 1, layout);
                acc = acc + ChartView.TreeLeafCount(n.children[i]);
            }
        }
    }

    /// 布局节点在增长缩放后的 span 上叶子范围的中心。
    static int TreeSpan(TreeLayoutNode node, int spanG, int leaves) {
        long pos = (long)(2 * node.lo + node.count) * spanG / (2 * leaves);
        return (int)pos;
    }

    static int TreeLabelWidth(ChartNode n, int fs) {
        string label = n.name;
        if (n.children.Count == 0 && n.val > 0) {
            label = n.name + " " + Convert.ToString(n.val);
        }
        int widest = Canvas.MeasureText(label, fs);
        for (int i = 0; i < n.children.Count; i = i + 1) {
            int childW = ChartView.TreeLabelWidth(n.children[i], fs);
            if (childW > widest) { widest = childW; }
        }
        return widest;
    }

    static bool WordCloudFits(List<WordCloudItem> placed, int x, int y, int w, int h) {
        for (int i = 0; i < placed.Count; i = i + 1) {
            WordCloudItem item = placed[i];
            if (x < item.x + item.w && x + w > item.x
                && y < item.y + item.h && y + h > item.y) { return false; }
        }
        return true;
    }

    static void DrawWordCloud(App app, int x, int y, int w, int h,
                              ChartOption o, int g) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        ChartSeries lead = ChartView.LeadSeries(o);
        List<ChartSeries> header = new List<ChartSeries>();
        int top = Chart.DrawPanelI(app, x, y, w, h, o.title, header, 0, o.showLegend);
        if (lead == null || lead.data.Count == 0) { return; }

        int pad = app.Scale(12);
        int ax = x + pad;
        int ay = top + app.Scale(2);
        int aw = w - pad * 2;
        int ah = y + h - pad - ay;
        if (aw < 1 || ah < 1) { return; }

        int maxV = 1;
        for (int i = 0; i < lead.data.Count; i = i + 1) {
            if (lead.data[i].val > maxV) { maxV = lead.data[i].val; }
        }

        List<WordCloudItem> placed = new List<WordCloudItem>();
        int minFs = app.Scale(11);
        int maxFs = app.Scale(34);
        c.PushClip(ax, ay, aw, ah);
        for (int wi = 0; wi < lead.data.Count; wi = wi + 1) {
            ChartData word = lead.data[wi];
            int fs = minFs + (maxFs - minFs) * word.val / maxV;
            fs = minFs + (fs - minFs) * g / 1000;
            string text = word.name;
            int tw = Canvas.MeasureText(text, fs) + app.Scale(4);
            int th = Canvas.FontHeight(fs) + app.Scale(2);
            int attempt = 0;
            while (attempt < 180) {
                int angle = (attempt * 137 + wi * 47) % 360;
                int radius = app.Scale(2 + attempt * 2);
                int cx = ax + aw / 2 + ChartView.CosDeg(angle) * radius / 1000;
                int cy = ay + ah / 2 + ChartView.SinDeg(angle) * radius / 1000;
                int tx = cx - tw / 2;
                int ty = cy - th / 2;
                if (tx >= ax && ty >= ay && tx + tw <= ax + aw && ty + th <= ay + ah
                    && ChartView.WordCloudFits(placed, tx, ty, tw, th)) {
                    int color = word.color;
                    if (color == 0) { color = Chart.Palette(t, wi); }
                    c.DrawText(tx + app.Scale(2), ty, text, color, fs);
                    placed.Add(WordCloudItem.Of(word, tx, ty, tw, th, fs));
                    attempt = 180;
                } else {
                    attempt = attempt + 1;
                }
            }
        }
        c.PopClip();
    }

    static void DrawTree(App app, int x, int y, int w, int h,
                         ChartOption o, int g) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        if (o.series.Count < 1 || o.series[0].tree.Count < 1) { return; }
        ChartNode root = o.series[0].tree[0];
        int plotTop = ChartView.PanelHead(app, x, y, w, h, o.title);
        int pad = t.paddingMedium;
        int ax = x + pad;
        int ay = plotTop;
        int aw = w - pad * 2;
        int ah = (y + h - pad) - plotTop;
        if (aw < app.Scale(10) || ah < app.Scale(10)) { return; }

        ChartSeries lead = ChartView.LeadSeries(o);
        bool horiz = false;
        if (lead != null && lead.treeOrient == "horizontal") { horiz = true; }

        int leaves = ChartView.TreeLeafCount(root);
        int depth = ChartView.TreeDepth(root);
        if (leaves < 1) { leaves = 1; }
        if (depth < 1) { depth = 1; }

        int panId = app.focus.AllocId();
        app.hitTester.RegisterRect(panId, ax, ay, aw, ah, 2);

        int labelWidth = ChartView.TreeLabelWidth(root, t.fontSizeSmall);
        int labelHeight = Canvas.FontHeight(t.fontSizeSmall);
        int leafGap = labelHeight + app.Scale(16);
        int levelGap = labelWidth + app.Scale(36);
        if (!horiz) {
            leafGap = labelWidth * 2 + app.Scale(36);
            levelGap = labelHeight + app.Scale(24);
        }
        if (leafGap < app.Scale(40)) { leafGap = app.Scale(40); }
        if (levelGap < app.Scale(48)) { levelGap = app.Scale(48); }

        int spanLen = horiz ? ah : aw;
        int depLen = horiz ? aw : ah;

        // 缩放：滚轮调整节点间距（标签大小随之缩放），
        // 使放不下的树可收拢，而不是只能
        // 四处拖动。未设置缩放时适配整棵树，这是树
        // 打开时的预期形态 —— 平移只是可选，而非
        // 查看其余部分的唯一方式。
        int zoom = app.StateGet(Chart.TreeZoomKey(o.iwid), 0);
        if (zoom == 0) {
            zoom = 100;
            int natSpan = leaves * leafGap;
            int natDepth = (depth + 1) * levelGap + app.Scale(8);
            if (natSpan > spanLen) { zoom = spanLen * 100 / natSpan; }
            int depZoom = 100;
            if (natDepth > depLen) { depZoom = depLen * 100 / natDepth; }
            if (depZoom < zoom) { zoom = depZoom; }
            if (zoom < 25) { zoom = 25; }
            app.StateSet(Chart.TreeZoomKey(o.iwid), zoom);
        }
        if (Ui.Wheeled(app, panId)) {
            int notches = Ui.WheelDelta(app);
            int next = zoom;
            int steps = notches;
            while (steps > 0) { next = next * 115 / 100; steps = steps - 1; }
            while (steps < 0) { next = next * 100 / 115; steps = steps + 1; }
            if (next < 20) { next = 20; }
            if (next > 400) { next = 400; }
            if (next != zoom) {
                // 保持光标下的内容不动，使缩放表现为
                // 树的缩放而非跳到树的另一部分。
                int oldPanX = app.StateGet(Chart.TreePanXKey(o.iwid), 0);
                int oldPanY = app.StateGet(Chart.TreePanYKey(o.iwid), 0);
                int anchorX = app.mouseX - ax + oldPanX;
                int anchorY = app.mouseY - ay + oldPanY;
                app.StateSet(Chart.TreePanXKey(o.iwid),
                    anchorX * next / zoom - (app.mouseX - ax));
                app.StateSet(Chart.TreePanYKey(o.iwid),
                    anchorY * next / zoom - (app.mouseY - ay));
                zoom = next;
                app.StateSet(Chart.TreeZoomKey(o.iwid), zoom);
            }
            app.RequestRedraw();
        }
        leafGap = leafGap * zoom / 100;
        levelGap = levelGap * zoom / 100;
        if (leafGap < app.Scale(6)) { leafGap = app.Scale(6); }
        if (levelGap < app.Scale(8)) { levelGap = app.Scale(8); }

        int contentSpan = leaves * leafGap;
        int contentDepth = (depth + 1) * levelGap + app.Scale(8);
        if (contentSpan < spanLen) { contentSpan = spanLen; }
        if (contentDepth < depLen) { contentDepth = depLen; }

        int contentW = horiz ? contentDepth : contentSpan;
        int contentH = horiz ? contentSpan : contentDepth;
        int maxPanX = contentW - aw;
        int maxPanY = contentH - ah;
        int panX = app.StateGet(Chart.TreePanXKey(o.iwid), 0);
        int panY = app.StateGet(Chart.TreePanYKey(o.iwid), 0);
        if (panX < 0) { panX = 0; }
        if (panY < 0) { panY = 0; }
        if (panX > maxPanX) { panX = maxPanX; }
        if (panY > maxPanY) { panY = maxPanY; }
        app.StateSet(Chart.TreePanXKey(o.iwid), panX);
        app.StateSet(Chart.TreePanYKey(o.iwid), panY);

        if (Ui.PressedDown(app, panId) && app.window.EventButton() == 0) {
            app.StateSet(Chart.TreeDragXKey(o.iwid), app.mouseX);
            app.StateSet(Chart.TreeDragYKey(o.iwid), app.mouseY);
            app.StateSet(Chart.TreeDragPanXKey(o.iwid), panX);
            app.StateSet(Chart.TreeDragPanYKey(o.iwid), panY);
            app.StateSet(Chart.TreeDraggingKey(o.iwid), 1);
        }
        if (app.EventKind() == 3) {
            app.StateSet(Chart.TreeDraggingKey(o.iwid), 0);
        }
        if (app.StateGet(Chart.TreeDraggingKey(o.iwid), 0) == 1
            && Ui.Pressed(app, panId) && app.EventKind() == 1) {
            panX = app.StateGet(Chart.TreeDragPanXKey(o.iwid), panX)
                - (app.mouseX - app.StateGet(Chart.TreeDragXKey(o.iwid), app.mouseX));
            panY = app.StateGet(Chart.TreeDragPanYKey(o.iwid), panY)
                - (app.mouseY - app.StateGet(Chart.TreeDragYKey(o.iwid), app.mouseY));
            if (panX < 0) { panX = 0; }
            if (panY < 0) { panY = 0; }
            if (panX > maxPanX) { panX = maxPanX; }
            if (panY > maxPanY) { panY = maxPanY; }
            app.StateSet(Chart.TreePanXKey(o.iwid), panX);
            app.StateSet(Chart.TreePanYKey(o.iwid), panY);
            app.RequestRedraw();
        }

        int span0 = horiz ? ay - panY : ax - panX;
        int dep0 = (horiz ? ax - panX : ay - panY) + app.Scale(8);

        // 渐入动画：整棵树沿两轴绕中心缩放。
        int spanG = contentSpan * g / 1000;
        int depG = contentDepth * g / 1000;
        int spanG0 = span0 + (contentSpan - spanG) / 2;
        int depG0 = dep0 + (contentDepth - depG) / 2;
        if (spanG < app.Scale(4)) { spanG = app.Scale(4); }
        if (depG < app.Scale(4)) { depG = app.Scale(4); }

        c.PushClip(ax, ay, aw, ah);
        List<TreeLayoutNode> layout = new List<TreeLayoutNode>();
        ChartView.TreeAssign(root, 0, 0, layout);

        int rad = app.Scale(4) * zoom / 100;
        if (rad > app.Scale(4)) { rad = app.Scale(4); }
        if (rad < 2) { rad = 2; }
        int lvlH = depG / (depth + 1);
        int col = 0;
        if (lead != null) { col = lead.color; }
        if (col == 0) { col = Chart.Palette(t, 0); }

        // 先画连线（折线式正交连接器，ECharts lineStyle
        // type:'broken'），再在顶层画节点，使圆点盖住线端。
        int i = 0;
        while (i < layout.Count) {
            TreeLayoutNode parent = layout[i];
            ChartNode n = parent.node;
            if (n.children.Count == 0) { i = i + 1; continue; }
            int pSpan = ChartView.TreeSpan(parent, spanG, leaves);
            int pDep = parent.depth * lvlH;
            for (int c0 = 0; c0 < n.children.Count; c0 = c0 + 1) {
                ChartNode ch = n.children[c0];
                int ci = 0;
                for (; ci < layout.Count; ci = ci + 1) {
                    if (layout[ci].node == ch) { break; }
                }
                TreeLayoutNode child = layout[ci];
                int cSpan = ChartView.TreeSpan(child, spanG, leaves);
                int cDep = child.depth * lvlH;
                int p0 = spanG0 + pSpan;
                int p1 = depG0 + pDep;
                int q0 = spanG0 + cSpan;
                int q1 = depG0 + cDep;
                if (horiz) {
                    // span = y，depth = x：父节点在 (p1, p0)，子节点在 (q1, q0)
                    int mid = (p1 + q1) / 2;
                    c.DrawLine(p1, p0, mid, p0, t.divider, app.Scale(1));
                    c.DrawLine(mid, p0, mid, q0, t.divider, app.Scale(1));
                    c.DrawLine(mid, q0, q1, q0, t.divider, app.Scale(1));
                } else {
                    int mid = (p1 + q1) / 2;
                    c.DrawLine(p0, p1, p0, mid, t.divider, app.Scale(1));
                    c.DrawLine(p0, mid, q0, mid, t.divider, app.Scale(1));
                    c.DrawLine(q0, mid, q0, q1, t.divider, app.Scale(1));
                }
            }
            i = i + 1;
        }

        // 节点 + 标签。
        for (int j = 0; j < layout.Count; j = j + 1) {
            TreeLayoutNode item = layout[j];
            ChartNode n = item.node;
            int span = ChartView.TreeSpan(item, spanG, leaves);
            int d = item.depth * lvlH;
            int nx = horiz ? depG0 + d : spanG0 + span;
            int ny = horiz ? spanG0 + span : depG0 + d;
            c.FillCircle(nx, ny, rad, col);
            int fs = t.fontSizeSmall * zoom / 100;
            if (fs > t.fontSizeSmall) { fs = t.fontSizeSmall; }
            if (fs < app.Scale(7)) { fs = app.Scale(7); }
            string lbl = n.name;
            if (n.children.Count == 0 && n.val > 0) {
                lbl = n.name + " " + Convert.ToString(n.val);
            }
            int lw = Canvas.MeasureText(lbl, fs);
            c.DrawText(nx + rad + app.Scale(5), Canvas.CenterTextYAt(ny, fs),
                lbl, t.textSecondary, fs);
        }
        c.PopClip();

        if (o.showTooltip && app.mouseX >= ax && app.mouseX < ax + aw
            && app.mouseY >= ay && app.mouseY < ay + ah) {
            int mx = app.mouseX;
            int my = app.mouseY;
            int best = 0 - 1;
            int hitRad = rad + app.Scale(6);
            for (int k = 0; k < layout.Count; k = k + 1) {
                TreeLayoutNode item = layout[k];
                int span = ChartView.TreeSpan(item, spanG, leaves);
                int d = item.depth * lvlH;
                int nx = horiz ? depG0 + d : spanG0 + span;
                int ny = horiz ? spanG0 + span : depG0 + d;
                int dx = mx - nx;
                int dy = my - ny;
                if (dx >= 0 - hitRad && dx <= hitRad
                    && dy >= 0 - hitRad && dy <= hitRad
                    && dx * dx + dy * dy <= hitRad * hitRad) {
                    best = k;
                    break;
                }
            }
            if (best >= 0) {
                ChartNode hn = layout[best].node;
                List<TooltipRow> rows = new List<TooltipRow>();
                rows.Add(TooltipRow.Of(0, o.title));
                string tv = Convert.ToString(hn.Total());
                rows.Add(TooltipRow.Of(col, hn.name + "  " + tv));
                ChartView.TooltipCard(app, mx, my, x + w, rows);
            }
        }
    }
}
