using System;
using System.Json;
using Gui;

namespace Gui.Component.Chart;

class TooltipRow {
    int color;
    string text;

    static TooltipRow Of(int color, string text) {
        TooltipRow row = new TooltipRow();
        row.color = color;
        row.text = text;
        return row;
    }
}

partial class ChartView {
    // ---- 共享面板外观：背景 + 边框 + 标题，返回内容顶部 y ----

    static int PanelHead(App app, int x, int y, int w, int h, string title) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int pad = t.paddingMedium;
        StyleBox sPanel = Style.Full(app, "chart", "", "", Style.SNormal());
        c.SurfaceRoundRect(x, y, w, h, t.borderRadiusMedium, sPanel.BgOr(0), sPanel.BorderOr(0), 1);
        int top = y + pad;
        if (title.Length > 0) {
            c.DrawText(x + pad, top, title, sPanel.FgOr(0), Style.FontFallback(app, "large"));
        }
        return top + Canvas.FontHeight(Style.FontFallback(app, "large")) + app.Scale(6);
    }

    // ---- 工具箱：图表右下角的 3 个浮动按钮（保存/数据视图/还原）----
    // 按钮 id 跨帧稳定由 wid 派生（7000000+wid*3+k）。点击行为
    // 最小化：保存调 Canvas.DumpRaw 把整张 surface 转 .raw，
    // 数据视图切换 showValues、还原触发 RequestRedraw。
    // 行为不依赖外部状态——任何 app 都能开箱即用。
    static void DrawToolbox(App app, int x, int y, int w, int h, int wid) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int btnR = app.Scale(11);
        int gap = app.Scale(4);
        // 3 个按钮宽 + 2 个间隙，水平排列，右贴齐。
        int rowW = btnR * 2 * 3 + gap * 2;
        int baseX = x + w - app.Scale(t.paddingMedium) - rowW;
        int baseY = y + h - app.Scale(t.paddingMedium) - btnR * 2;
        int idBase = 7000000 + wid * 4;
        StyleBox sBtn = Style.Full(app, "chart", "toolbox", "", Style.SNormal());
        int bg = sBtn.BgOr(0);
        int bd = sBtn.BorderOr(0);
        int fg = sBtn.FgOr(0);
        if (bg == 0) { bg = Chart.WithAlpha(t.textPrimary, 100); }
        if (bd == 0) { bd = t.divider; }
        if (fg == 0) { fg = t.textPrimary; }
        string[] glyphs = new string[]{ "S", "D", "R" };  // Save / Data / Reset
        for (int k = 0; k < 3; k = k + 1) {
            int bx = baseX + k * (btnR * 2 + gap);
            int by = baseY;
            int cid = idBase + k;
            c.FillRoundRect(bx, by, btnR * 2, btnR * 2, btnR, bg);
            c.DrawRoundRect(bx, by, btnR * 2, btnR * 2, btnR, bd, 1);
            c.DrawTextCentered(bx, by, btnR * 2, btnR * 2, glyphs[k], fg,
                Style.FontFallback(app, "small"));
            app.hitTester.RegisterRect(cid, bx, by, btnR * 2, btnR * 2, 0);
            // 点击响应：直接由本渲染函数后续帧统一处理（避免
            // 错过的本帧点击走专门的回调管线）。这里只更新状态。
            if (Ui.Clicked(app, cid)) {
                if (k == 0) {
                    // 保存：把整张 surface 转存到 _scratch/uidrv/ 下的
                    // chart_$wid.raw，dump2png 工具可直接还原。
                    ChartView.tbSavePending = true;
                    ChartView.tbSaveWid = wid;
                } else if (k == 1) {
                    // 数据视图：翻转 o.showValues；让 ChartView 在
                    // 下一次 Render 读 Resolved.DrawOption 时也带上。
                    ChartView.tbDataViewPending = true;
                    ChartView.tbDataViewWid = wid;
                } else {
                    // 还原：重置缩放窗口（iwid 槽位的 zoomStart/End
                    // 归位）+ 强制重绘。chart 层只发起重绘请求。
                    app.RequestRedraw();
                }
            }
        }
    }

    // toolbox 按钮点击后挂起状态。Render 后由 App/ChartView
    // 的本帧末统一执行。简单字符串级 inband 信令。
    static bool tbSavePending;
    static int tbSaveWid;
    static bool tbDataViewPending;
    static int tbDataViewWid;
    // ---- 悬停十字准线 + 数值提示（笛卡尔图表） ----
    // baseIdx 是 dataZoom 窗口起点：labels 已是窗口内子列表，
    // 系列值按窗口内索引 baseIdx + idx 读取（无 zoom 时为 0）。

    static void CartesianTooltip(App app, ChartFrame f, List<string> labels,
                                 List<ChartSeries> series, int maxV,
                                 int step, int half, int baseIdx) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int mx = app.mouseX;
        int my = app.mouseY;
        bool inside = mx >= f.plotX && mx < f.plotX + f.plotW
            && my >= f.plotY && my < f.plotY + f.plotH;
        if (!inside) { return; }
        int n = labels.Count;
        if (n < 1 || step < 1) { return; }
        int idx = (mx - f.plotX) / step;
        if (idx < 0) { idx = 0; }
        if (idx > n - 1) { idx = n - 1; }

        int gx = f.plotX + idx * step + half;
        // axisPointer 竖线（ECharts cross）：1px 半透明线，居中
        // 落在数据点上；不再使用 2px 实心（2px 在折线族看起来像柱，
        // 与数据点混淆）。alpha 80 让线"穿过"图形而不抢眼。
        int crossCol = Style.Part(app, "chart", "crosshair", "", "", "",
                                  Style.SNormal()).BgOr(0);
        if (crossCol != 0) {
            crossCol = Chart.WithAlpha(crossCol, 200);
        } else {
            crossCol = Chart.WithAlpha(t.textPrimary, 120);
        }
        c.FillRect(gx, f.plotY, 1, f.plotH, crossCol);
        // axisPointer 横线：在鼠标 y 处贯通整个绘图区，作为
        // 高度参考；ECharts axisPointer.type='line' 行为一致。
        if (my > f.plotY && my < f.plotY + f.plotH) {
            c.FillRect(f.plotX, my, f.plotW, 1, crossCol);
        }

        // axisPointer axis label：ECharts axisPointer 实际上包含
        // 沿轴的小标签（底轴显示类别，左轴显示数值）。这里也画——
        // X 类别在底轴正下方，Y 数值（用 maxV 的最近刻度）在左轴
        // 正左方。颜色与竖线一致，让"准线"和"标签"作为一个整体。
        int fs = Style.FontFallback(app, "small");
        string lblX = labels[idx];
        int xw = Canvas.MeasureText(lblX, fs);
        int lxX = gx - xw / 2;
        if (lxX < f.plotX) { lxX = f.plotX; }
        if (lxX + xw > f.plotX + f.plotW) { lxX = f.plotX + f.plotW - xw; }
        int lyX = f.plotY + f.plotH + app.Scale(2);
        c.FillRoundRect(lxX - app.Scale(2), lyX, xw + app.Scale(4),
            Canvas.FontHeight(fs), app.Scale(2), crossCol);
        int labelFg = t.textInverse;
        if (labelFg == 0) { labelFg = 4294967295; }
        c.DrawText(lxX, lyX, lblX, labelFg, fs);

        // Y 轴 label（最近刻度数值）— 沿左轴外侧。
        int ticks = 4;
        if (ticks < 1) { ticks = 1; }
        int yIdx = ticks - (my - f.plotY) * ticks / f.plotH;
        if (yIdx < 0) { yIdx = 0; }
        if (yIdx > ticks) { yIdx = ticks; }
        int vAt = yIdx * maxV / ticks;
        string lblY = Convert.ToString(vAt);
        int yw = Canvas.MeasureText(lblY, fs);
        int lxY = f.plotX - yw - app.Scale(6);
        if (lxY < 0) { lxY = 0; }
        int lyY = my - Canvas.FontHeight(fs) / 2;
        c.FillRoundRect(lxY - app.Scale(2), lyY, yw + app.Scale(4),
            Canvas.FontHeight(fs), app.Scale(2), crossCol);
        c.DrawText(lxY, lyY, lblY, labelFg, fs);

        // 提示卡片：类别标签 + 每个*可见*序列的值 + 色块。
        List<TooltipRow> rows = new List<TooltipRow>();
        rows.Add(TooltipRow.Of(0, labels[idx]));
        int oi = baseIdx + idx;
        for (int si = 0; si < series.Count; si = si + 1) {
            ChartSeries s = series[si];
            if (!s.hidden) {
                int v = 0;
                if (oi < s.Count()) { v = s.Value(oi); }
                rows.Add(TooltipRow.Of(s.color,
                    s.name + "  " + Convert.ToString(v)));
            }
        }
        ChartView.TooltipCard(app, mx, my, f.plotX + f.plotW, rows);
    }

    /// 扇区轮廓描边：外缘与内缘各一条环带，两条半径边用
    /// 细楔形近似（角度宽度按外半径换算）。pie/rose 的
    /// itemStyle 边框与 emphasis 高亮共用。
    static void StrokeSector(Canvas c, int cx, int cy, int ri, int ro,
                             int a0, int a1, int color, int w) {
        if (w <= 0 || color == 0 || a1 <= a0) { return; }
        if (ri < 0) { ri = 0; }
        if (ro <= ri) { return; }
        c.DrawArc(cx, cy, ri, ro, a0, a1, color, w);
        if (ri >= w) { c.DrawArc(cx, cy, ri - w, ri, a0, a1, color, w); }
        int deg = w * 57 / ro + 1;
        c.FillSector(cx, cy, ri, ro, a0 - deg, a0, color);
        c.FillSector(cx, cy, ri, ro, a1, a1 + deg, color);
    }

    /// 矩形四边描边（用四条填充边实现，避免依赖原生
    /// 描边图元的透明度语义）。柱条 itemStyle 边框与
    /// emphasis 高亮共用。
    static void StrokeRect(Canvas c, int x, int y, int w, int h,
                           int color, int t2) {
        if (t2 <= 0 || color == 0 || w <= 0 || h <= 0) { return; }
        c.FillRect(x, y, w, t2, color);
        c.FillRect(x, y + h - t2, w, t2, color);
        c.FillRect(x, y, t2, h, color);
        c.FillRect(x + w - t2, y, t2, h, color);
    }

    // ---- 延迟工具提示 ----
    // 提示卡片必须绘制在一切之上，但图表在帧内绘制较早：同页
    // 之后渲染的控件会盖住它，图表自身的 PushClip 也会把越出
    // 图表矩形的卡片裁掉。因此悬停时只*记录*请求（与 Widget.Tooltip
    // 的 Request/Flush 契约一致；本帧最后一次请求胜出——指针只在
    // 一个图表上），由 App.PresentFrame 在所有内容与弹层之后调用
    // FlushTooltips 统一绘制。
    static List<TooltipRow> tipRows;
    static int tipPx;
    static int tipPy;
    static int tipRight;

    // 带彩色色块行的悬停提示卡片请求。px/py 是锚点（
    // 十字准线 / 指针）；当卡片会越过图表右缘（maxRight）时
    // 翻转到左侧。
    static void TooltipCard(App app, int px, int py, int maxRight,
                            List<TooltipRow> rows) {
        if (rows.Count < 1) { return; }
        // 调用方的列表可能是跨帧复用的缓冲，拷贝一份快照
        // （new List<T>(src) 拷贝构造，元素随 src 保留）。
        ChartView.tipRows = new List<TooltipRow>(rows);
        ChartView.tipPx = px;
        ChartView.tipPy = py;
        ChartView.tipRight = maxRight;
        app.RequestRedraw();
    }

    /// 绘制本帧请求的图表提示卡片（若有）并清空队列。
    /// 由 App.PresentFrame 在所有内容与弹层之后调用。
    static void FlushTooltips(App app) {
        if (ChartView.tipRows == null || ChartView.tipRows.Count < 1) { return; }
        List<TooltipRow> rows = ChartView.tipRows;
        ChartView.tipRows = null;
        Canvas c = app.canvas;
        Theme t = app.theme;
        int fs = Style.FontFallback(app, "small");
        int lh = Canvas.FontHeight(fs) + app.Scale(4);
        int rowCount = rows.Count;
        int boxW = app.Scale(28);
        for (int i = 0; i < rowCount; i = i + 1) {
            int w2 = Canvas.MeasureText(rows[i].text, fs);
            if (w2 + app.Scale(30) > boxW) { boxW = w2 + app.Scale(30); }
        }
        int boxH = rowCount * lh + app.Scale(10);
        int bx = ChartView.tipPx + app.Scale(10);
        if (bx + boxW > ChartView.tipRight) { bx = ChartView.tipPx - app.Scale(10) - boxW; }
        if (bx < app.Scale(2)) { bx = app.Scale(2); }
        // 默认在指针下方；会超出画布底部时翻转到上方，
        // 确保卡片永不被窗口边缘裁剪。
        int by = ChartView.tipPy + app.Scale(8);
        int margin = app.Scale(4);
        int cH = c.Height();
        if (by + boxH > cH - margin) {
            by = ChartView.tipPy - app.Scale(8) - boxH;
        }
        if (by < margin) { by = margin; }

        StyleBox sTip = Style.Part(app, "chart", "tooltip", "", "", "",
                                   Style.SNormal());
        c.SurfaceRoundRect(bx, by, boxW, boxH, t.borderRadiusMedium, sTip.BgOr(0), sTip.BorderOr(0), 1);
        int ty = by + app.Scale(5);
        for (int ri = 0; ri < rowCount; ri = ri + 1) {
            int sw = app.Scale(9);
            TooltipRow row = rows[ri];
            if (ri > 0 && row.color != 0) {
                c.FillRoundRect(bx + app.Scale(8), ty + app.Scale(2), sw, sw,
                    t.borderRadiusSmall, row.color);
            }
            c.DrawText(bx + app.Scale(8) + sw + app.Scale(6), ty, row.text,
                sTip.FgOr(0), fs);
            ty = ty + lh;
        }
    }

    // 系列在窗口 [i0,i1]（含端点）内最大/最小值的下标；
    // 窗口外或空数据返回 -1。markPoint 自动推导共用。
    static int SeriesMaxIndex(ChartSeries s, int i0, int i1) {
        int maxI = 0 - 1;
        int maxV = 0 - 2147483647 - 1;
        for (int j = i0; j <= i1 && j < s.Count(); j = j + 1) {
            int v = s.Value(j);
            if (v > maxV) { maxV = v; maxI = j; }
        }
        return maxI;
    }
    static int SeriesMinIndex(ChartSeries s, int i0, int i1) {
        int minI = 0 - 1;
        int minV = 2147483647;
        for (int j = i0; j <= i1 && j < s.Count(); j = j + 1) {
            int v = s.Value(j);
            if (v < minV) { minV = v; minI = j; }
        }
        return minI;
    }

    // 系列 markPoint 标记：o.markPoint=true 时自动标出窗口
    // [i0,i1] 内的最大/最小值；series.marks 的显式项也绘制
    // （dataIndex 定位；kind=max/min 回退到自动推导的极值）。
    // 柱状图与折线图共用。f 提供 YOf 映射。
    static void DrawSeriesMarks(App app, ChartFrame f, ChartSeries s,
                                int i0, int i1, int step, int half, ChartOption o) {
        if (!o.markPoint && s.marks.Count < 1) { return; }
        int maxI = ChartView.SeriesMaxIndex(s, i0, i1);
        int minI = ChartView.SeriesMinIndex(s, i0, i1);
        if (o.markPoint) {
            if (maxI >= 0) { ChartView.MarkAt(app, f, s, maxI, maxI - i0, step, half, "max"); }
            if (minI >= 0 && minI != maxI) { ChartView.MarkAt(app, f, s, minI, minI - i0, step, half, "min"); }
        }
        for (int mi = 0; mi < s.marks.Count; mi = mi + 1) {
            ChartMarkPoint m = s.marks[mi];
            int idx = m.dataIndex;
            if (idx < 0) {
                if (m.kind == "max") { idx = maxI; }
                else if (m.kind == "min") { idx = minI; }
                else { idx = 0 - 1; }
            }
            if (idx < i0 || idx > i1 || idx >= s.Count()) { continue; }
            string lbl = m.label;
            if (lbl.Length == 0) {
                if (m.kind == "max") { lbl = "max"; }
                else if (m.kind == "min") { lbl = "min"; }
                else { lbl = Convert.ToString(s.Value(idx)); }
            }
            ChartView.MarkAt(app, f, s, idx, idx - i0, step, half, lbl);
        }
    }

    // 在数据点（类别下标 idx，槽位 slot = idx - i0）上绘制单个
    // 标记：系列色实心圆 + 白描边 + 上方小标签。
    static void MarkAt(App app, ChartFrame f, ChartSeries s, int idx,
                       int slot, int step, int half, string lbl) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int rad = app.Scale(4);
        int lx = f.plotX + slot * step + half;
        int ly = f.YOf(s.Value(idx), s.axisIndex);
        c.FillCircle(lx, ly, rad, s.color);
        ChartView.RingOutline(c, lx, ly, rad, 4294967295);
        int lw = Canvas.MeasureText(lbl, Style.FontFallback(app, "small"));
        c.DrawText(lx - lw / 2, ly - app.Scale(16), lbl,
            Style.Part(app, "chart", "label", "", "", "", Style.SNormal()).FgOr(0),
            Style.FontFallback(app, "small"));
    }

    // 指针角度（度，0..360，从 12 点方向顺时针——与 FillSector
    // 的扫掠方向/角度零位一致），通过对 CosDeg/SinDeg 二分查找求解，
    // 无需浮点运算。dx/dy 是相对圆心的像素偏移。
    static int AngleOf(int dx, int dy) {
        if (dx == 0 && dy == 0) { return 0; }
        int lo = 0;
        int hi = 360;
        for (int i = 0; i < 10; i = i + 1) {
            int mid = (lo + hi) / 2;
            int cx2 = ChartView.CosDeg(mid);
            int cy2 = ChartView.SinDeg(mid);
            // cross = direction(mid) × pointer；> 0 表示指针在
            // mid 的顺时针方向（屏幕 Y 轴向下）。
            int cr = cx2 * dy - cy2 * dx;
            if (cr > 0) { lo = mid; } else { hi = mid; }
        }
        // 二分查找给出从 +x 起算的角度；+90° 换算到 FillSector
        // 的 12 点零位（扇区/花瓣/弦弧命中统一用同一约定）。
        return ((lo + hi) / 2 + 90) % 360;
    }

    // 点到线段距离（像素，定点数）。
    static int DistToSeg(int px, int py, int x0, int y0, int x1, int y1) {
        int dx = x1 - x0;
        int dy = y1 - y0;
        int len2 = dx * dx + dy * dy;
        if (len2 == 0) {
            int ddx = px - x0;
            int ddy = py - y0;
            return ChartView.ISqrt(ddx * ddx + ddy * ddy);
        }
        int t = ((px - x0) * dx + (py - y0) * dy) * 1000 / len2;
        if (t < 0) { t = 0; }
        if (t > 1000) { t = 1000; }
        int qx = x0 + dx * t / 1000;
        int qy = y0 + dy * t / 1000;
        int ddx = px - qx;
        int ddy = py - qy;
        return ChartView.ISqrt(ddx * ddx + ddy * ddy);
    }

    // 沿折线分段绘制虚线/点线：每边独立按 dash 实 / gap 空
    // 交替（相位在顶点处重置），整数坐标，确定性。
    static void DrawDashed(Canvas c, List<int> px, List<int> py, int color,
                           int width, int dash, int gap) {
        int n = px.Count;
        if (n < 2) { return; }
        int cycle = dash + gap;
        if (cycle < 1) { cycle = 1; }
        for (int i = 1; i < n; i = i + 1) {
            int x0 = px[i - 1];
            int y0 = py[i - 1];
            int x1 = px[i];
            int y1 = py[i];
            int dx = x1 - x0;
            int dy = y1 - y0;
            int len = ChartView.ISqrt(dx * dx + dy * dy);
            if (len < 1) { continue; }
            int traveled = 0;
            while (traveled < len) {
                int off = traveled % cycle;
                int take = len - traveled;
                if (off < dash) {
                    int rem = dash - off;
                    if (rem < take) { take = rem; }
                    int ex = x0 + dx * (traveled + take) / len;
                    int ey = y0 + dy * (traveled + take) / len;
                    c.DrawLine(x0 + dx * traveled / len, y0 + dy * traveled / len,
                        ex, ey, color, width);
                } else {
                    int rem = cycle - off;
                    if (rem < take) { take = rem; }
                }
                traveled = traveled + take;
            }
        }
    }

    // 多边形扫描线填充（半透明，用于雷达 areaStyle）。逐行求
    // 边交点、排序后成对填段；顶点数少（雷达 ≤ 十几轴），
    // O(高×边) 足够。
    static void FillPolyAlpha(Canvas c, List<int> px, List<int> py,
                              int color, int alpha) {
        int n = px.Count;
        if (n < 3 || py.Count < n) { return; }
        int y0 = py[0];
        int y1 = py[0];
        for (int i = 1; i < n; i = i + 1) {
            if (py[i] < y0) { y0 = py[i]; }
            if (py[i] > y1) { y1 = py[i]; }
        }
        List<int> xs = new List<int>();
        for (int y = y0; y <= y1; y = y + 1) {
            xs.Clear();
            for (int i2 = 0; i2 < n; i2 = i2 + 1) {
                int j = i2 + 1;
                if (j == n) { j = 0; }
                int ya = py[i2];
                int yb = py[j];
                if (ya == yb) { continue; }
                if ((y >= ya && y < yb) || (y >= yb && y < ya)) {
                    xs.Add(px[i2] + (y - ya) * (px[j] - px[i2]) / (yb - ya));
                }
            }
            // 插入排序（xs 通常 2~4 个元素）。
            for (int a = 1; a < xs.Count; a = a + 1) {
                int v = xs[a];
                int b = a - 1;
                while (b >= 0 && xs[b] > v) { xs[b + 1] = xs[b]; b = b - 1; }
                xs[b + 1] = v;
            }
            for (int k = 0; k + 1 < xs.Count; k = k + 2) {
                int w = xs[k + 1] - xs[k];
                if (w > 0) { c.FillRect(xs[k], y, w, 1, Chart.WithAlpha(color, alpha)); }
            }
        }
    }

    // ==== 整数 / 三角函数辅助（定点数，*1000） ====

    static int ISqrt(int v) {
        if (v <= 0) { return 0; }
        int r = 1;
        while (r * r <= v) { r = r + 1; }
        return r - 1;
    }

    // sin(deg) * 1000，Bhaskara I 近似（误差 < 0.2%）。
    static int SinDeg(int deg) {
        int d = deg % 360;
        if (d < 0) { d = d + 360; }
        int sign = 1;
        if (d >= 180) { d = d - 180; sign = 0 - 1; }
        int num = 4 * d * (180 - d);
        int den = 40500 - d * (180 - d);
        if (den == 0) { den = 1; }
        return sign * (num * 1000 / den);
    }

    static int CosDeg(int deg) { return ChartView.SinDeg(deg + 90); }

    static void RingOutline(Canvas c, int cx, int cy, int r, int color) {
        int seg = 36;
        List<int> lx = new List<int>();
        List<int> ly = new List<int>();
        for (int i = 0; i <= seg; i = i + 1) {
            int ang = i * 360 / seg;
            lx.Add(cx + ChartView.CosDeg(ang) * r / 1000);
            ly.Add(cy + ChartView.SinDeg(ang) * r / 1000);
        }
        c.DrawPolyline(lx, ly, color, 1);
    }
}
