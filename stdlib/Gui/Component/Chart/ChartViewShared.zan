using System;
using System.Json;
using Gui;

namespace Gui.Component.Chart;

class TooltipRow {
    int color;
    string text;

    static TooltipRow Of(int color, string text) {
        TooltipRow row = new TooltipRow();
        row.color = color;
        row.text = text;
        return row;
    }
}

partial class ChartView {
    // ---- shared panel chrome: bg + border + title, returns content top y ----

    static int PanelHead(App app, int x, int y, int w, int h, string title) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int pad = t.paddingMedium;
        c.SurfaceRoundRect(x, y, w, h, t.borderRadiusMedium, t.bgPrimary, t.borderPrimary, 1);
        int top = y + pad;
        if (title.Length > 0) {
            c.DrawText(x + pad, top, title, t.textPrimary, t.fontSizeLarge);
        }
        return top + Canvas.FontHeight(t.fontSizeLarge) + app.Scale(6);
    }
    // ---- hover crosshair + value tooltip (cartesian charts) ----

    static void CartesianTooltip(App app, ChartFrame f, List<string> labels,
                                 List<ChartSeries> series, int maxV,
                                 int step, int half) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int mx = app.mouseX;
        int my = app.mouseY;
        bool inside = mx >= f.plotX && mx < f.plotX + f.plotW
            && my >= f.plotY && my < f.plotY + f.plotH;
        if (!inside) { return; }
        int n = labels.Count;
        if (n < 1 || step < 1) { return; }
        int idx = (mx - f.plotX) / step;
        if (idx < 0) { idx = 0; }
        if (idx > n - 1) { idx = n - 1; }

        int gx = f.plotX + idx * step + half;
        c.FillRect(gx, f.plotY, 1, f.plotH, t.borderHover);

        // Tooltip card: category label + each *visible* series value + swatch.
        List<TooltipRow> rows = new List<TooltipRow>();
        rows.Add(TooltipRow.Of(0, labels[idx]));
        for (int si = 0; si < series.Count; si = si + 1) {
            ChartSeries s = series[si];
            if (!s.hidden) {
                int v = 0;
                if (idx < s.Count()) { v = s.Value(idx); }
                rows.Add(TooltipRow.Of(s.color,
                    s.name + "  " + Convert.ToString(v)));
            }
        }
        ChartView.TooltipCard(app, mx, my, f.plotX + f.plotW, rows);
    }

    // One hover tooltip card with colour-swatch rows. px/py is the anchor (the
    // crosshair / pointer); the card flips to the left side when it would pass
    // the chart's right edge (maxRight).
    static void TooltipCard(App app, int px, int py, int maxRight,
                            List<TooltipRow> rows) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int fs = t.fontSizeSmall;
        int lh = Canvas.FontHeight(fs) + app.Scale(4);
        int rowCount = rows.Count;
        if (rowCount < 1) { return; }
        int boxW = app.Scale(28);
        for (int i = 0; i < rowCount; i = i + 1) {
            int w2 = Canvas.MeasureText(rows[i].text, fs);
            if (w2 + app.Scale(30) > boxW) { boxW = w2 + app.Scale(30); }
        }
        int boxH = rowCount * lh + app.Scale(10);
        int bx = px + app.Scale(10);
        if (bx + boxW > maxRight) { bx = px - app.Scale(10) - boxW; }
        if (bx < app.Scale(2)) { bx = app.Scale(2); }
        // Below the pointer by default; flip above when it would run off the
        // bottom of the canvas so the card is never clipped at the chart edge.
        int by = py + app.Scale(8);
        int margin = app.Scale(4);
        int cH = c.Height();
        if (by + boxH > cH - margin) {
            by = py - app.Scale(8) - boxH;
        }
        if (by < margin) { by = margin; }

        c.SurfaceRoundRect(bx, by, boxW, boxH, t.borderRadiusMedium, t.bgSecondary, t.borderPrimary, 1);
        int ty = by + app.Scale(5);
        for (int ri = 0; ri < rowCount; ri = ri + 1) {
            int sw = app.Scale(9);
            TooltipRow row = rows[ri];
            if (ri > 0 && row.color != 0) {
                c.FillRoundRect(bx + app.Scale(8), ty + app.Scale(2), sw, sw,
                    t.borderRadiusSmall, row.color);
            }
            c.DrawText(bx + app.Scale(8) + sw + app.Scale(6), ty, row.text,
                t.textSecondary, fs);
            ty = ty + lh;
        }
        app.RequestRedraw();
    }

    // Pointer angle in degrees (0..360, clockwise from +x, matching FillSector's
    // sweep direction), resolved by binary search over CosDeg/SinDeg so no float
    // math is needed. dx/dy are pixel offsets from the centre.
    static int AngleOf(int dx, int dy) {
        if (dx == 0 && dy == 0) { return 0; }
        int lo = 0;
        int hi = 360;
        for (int i = 0; i < 10; i = i + 1) {
            int mid = (lo + hi) / 2;
            int cx2 = ChartView.CosDeg(mid);
            int cy2 = ChartView.SinDeg(mid);
            // cross = direction(mid) x pointer; > 0 means the pointer is
            // clockwise of mid (screen Y grows downward).
            int cr = cx2 * dy - cy2 * dx;
            if (cr > 0) { lo = mid; } else { hi = mid; }
        }
        return (lo + hi) / 2;
    }

    // Distance from a point to a line segment (pixels, fixed-point).
    static int DistToSeg(int px, int py, int x0, int y0, int x1, int y1) {
        int dx = x1 - x0;
        int dy = y1 - y0;
        int len2 = dx * dx + dy * dy;
        if (len2 == 0) {
            int ddx = px - x0;
            int ddy = py - y0;
            return ChartView.ISqrt(ddx * ddx + ddy * ddy);
        }
        int t = ((px - x0) * dx + (py - y0) * dy) * 1000 / len2;
        if (t < 0) { t = 0; }
        if (t > 1000) { t = 1000; }
        int qx = x0 + dx * t / 1000;
        int qy = y0 + dy * t / 1000;
        int ddx = px - qx;
        int ddy = py - qy;
        return ChartView.ISqrt(ddx * ddx + ddy * ddy);
    }

    // ==== integer / trig helpers (fixed-point, *1000) ====

    static int ISqrt(int v) {
        if (v <= 0) { return 0; }
        int r = 1;
        while (r * r <= v) { r = r + 1; }
        return r - 1;
    }

    // sin(deg) * 1000, Bhaskara I approximation (error < 0.2%).
    static int SinDeg(int deg) {
        int d = deg % 360;
        if (d < 0) { d = d + 360; }
        int sign = 1;
        if (d >= 180) { d = d - 180; sign = 0 - 1; }
        int num = 4 * d * (180 - d);
        int den = 40500 - d * (180 - d);
        if (den == 0) { den = 1; }
        return sign * (num * 1000 / den);
    }

    static int CosDeg(int deg) { return ChartView.SinDeg(deg + 90); }

    static void RingOutline(Canvas c, int cx, int cy, int r, int color) {
        int seg = 36;
        List<int> lx = new List<int>();
        List<int> ly = new List<int>();
        for (int i = 0; i <= seg; i = i + 1) {
            int ang = i * 360 / seg;
            lx.Add(cx + ChartView.CosDeg(ang) * r / 1000);
            ly.Add(cy + ChartView.SinDeg(ang) * r / 1000);
        }
        c.DrawPolyline(lx, ly, color, 1);
    }
}
