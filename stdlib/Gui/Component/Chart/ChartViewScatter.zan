using System;
using System.Json;
using Gui;

namespace Gui.Component.Chart;

partial class ChartView {
    // ---- 散点图（双数值轴） ----

    static void DrawScatter(App app, int x, int y, int w, int h,
                            ChartOption o, int g) {
        ChartView.DrawScatterCore(app, x, y, w, h, o, g);
        ChartView.ScatterHover(app, x, y, w, h, o);
    }

    /// 仅散点图主体（面板、坐标轴、点）—— 不含悬停覆盖层，
    /// 可由 RenderCached 缓存（2000 点的散点云每帧只需一次像素
    /// 拷贝），命中后指针反馈再绘制于其上。
    static void DrawScatterCore(App app, int x, int y, int w, int h,
                                ChartOption o, int g) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int pad = t.paddingMedium;
        int axisFs = t.fontSizeSmall;

        int top = ChartView.PanelHead(app, x, y, w, h, o.title);

        // dataZoom：窗口索引 [i0,i1]（含端点）；范围与点绘制
        // 都只在窗口内。点下标是各系列 points 列表的全局下标。
        int zoomH = 0;
        int fullN = 0;
        for (int si0 = 0; si0 < o.series.Count; si0 = si0 + 1) {
            if (o.series[si0].points.Count > fullN) { fullN = o.series[si0].points.Count; }
        }
        int i0 = 0;
        int i1 = fullN - 1;
        if (o.zoom && o.iwid != 0 && fullN > 1) {
            i0 = Chart.ZoomI0(app, o, o.iwid, fullN);
            i1 = Chart.ZoomI1(app, o, o.iwid, fullN);
            zoomH = app.Scale(24);
        }

        int maxX = 0;
        int maxY = 0;
        for (int si = 0; si < o.series.Count; si = si + 1) {
            ChartSeries s = o.series[si];
            if (!s.hidden) {
                int j = i0;
                while (j <= i1 && j < s.points.Count) {
                    if (s.points[j].x > maxX) { maxX = s.points[j].x; }
                    if (s.points[j].y > maxY) { maxY = s.points[j].y; }
                    j = j + 1;
                }
            }
        }
        int maxXN = Chart.NiceMax(maxX);
        int maxYN = Chart.NiceMax(maxY);
        int leftGut = Canvas.MeasureText(Convert.ToString(maxYN), axisFs) + app.Scale(12);
        int botGut = Canvas.FontHeight(axisFs) + app.Scale(8);
        int plotX = x + pad + leftGut;
        int plotY = top;
        int plotW = (x + w - pad) - plotX;
        int plotH = (y + h - zoomH - pad - botGut) - plotY;
        if (plotW < app.Scale(20)) { plotW = app.Scale(20); }
        if (plotH < app.Scale(20)) { plotH = app.Scale(20); }

        int ticks = 5;
        for (int k = 0; k <= ticks; k = k + 1) {
            int gy = plotY + plotH - (k * plotH / ticks);
            c.FillRect(plotX, gy, plotW, 1, t.divider);
            string vs = Convert.ToString(maxYN * k / ticks);
            int vw = Canvas.MeasureText(vs, axisFs);
            c.DrawText(plotX - app.Scale(6) - vw, Canvas.CenterTextYAt(gy, axisFs), vs, t.textTertiary, axisFs);
            int gx = plotX + k * plotW / ticks;
            c.DrawTextCentered(gx - app.Scale(20), plotY + plotH + app.Scale(4), app.Scale(40), botGut, Convert.ToString(maxXN * k / ticks), t.textTertiary, axisFs);
        }
        c.FillRect(plotX, plotY, 1, plotH, t.borderSecondary);
        c.FillRect(plotX, plotY + plotH, plotW, 1, t.borderSecondary);
        if (zoomH > 0) {
            Chart.DrawZoomBar(app, plotX, plotW, y + h - app.Scale(18),
                app.Scale(12), o.iwid, fullN);
        }

        int rad = app.Scale(4);
        for (int r = 0; r < o.series.Count; r = r + 1) {
            ChartSeries s = o.series[r];
            if (!s.hidden) {
                // 散点空间中的 Line 序列绘制为连接的
                // 折线（如穿过点云的回归拟合线）；
                // 其余序列均以点绘制。
                if (s.type == ChartType.Line && s.points.Count > 1) {
                    List<int> lx = new List<int>();
                    List<int> ly = new List<int>();
                    int j0 = i0;
                    while (j0 <= i1 && j0 < s.points.Count) {
                        lx.Add(plotX + s.points[j0].x * plotW / maxXN);
                        ly.Add(plotY + plotH - (s.points[j0].y * plotH / maxYN));
                        j0 = j0 + 1;
                    }
                    c.DrawPolyline(lx, ly, s.color, app.Scale(2));
                } else {
                    int j = i0;
                    while (j <= i1 && j < s.points.Count) {
                        int px = plotX + s.points[j].x * plotW / maxXN;
                        int py = plotY + plotH - (s.points[j].y * plotH / maxYN);
                        c.FillCircle(px, py, rad, s.color);
                        j = j + 1;
                    }
                }
            }
        }
    }

    /// 散点图悬停覆盖层：在命中半径内查找最近点
    /// 并显示其坐标。在 DrawScatterCore（或
    /// RenderCached 恢复）之后绘制，使缓存的密集点云仍有实时提示。
    /// 窗口与 DrawScatterCore 锁定同一 [i0,i1]。
    static void ScatterHover(App app, int x, int y, int w, int h, ChartOption o) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int pad = t.paddingMedium;
        int axisFs = t.fontSizeSmall;

        // 仅做布局：这里绝不调用 PanelHead（它会重绘整个面板
        // 背景盖住点）。主体已由 Core 绘制。
        int top = y + pad + Canvas.FontHeight(t.fontSizeLarge) + app.Scale(6);

        int zoomH = 0;
        int fullN = 0;
        for (int si0 = 0; si0 < o.series.Count; si0 = si0 + 1) {
            if (o.series[si0].points.Count > fullN) { fullN = o.series[si0].points.Count; }
        }
        int i0 = 0;
        int i1 = fullN - 1;
        if (o.zoom && o.iwid != 0 && fullN > 1) {
            i0 = Chart.ZoomI0(app, o, o.iwid, fullN);
            i1 = Chart.ZoomI1(app, o, o.iwid, fullN);
            zoomH = app.Scale(24);
        }

        int maxX = 0;
        int maxY = 0;
        for (int si = 0; si < o.series.Count; si = si + 1) {
            ChartSeries s = o.series[si];
            if (!s.hidden) {
                int j = i0;
                while (j <= i1 && j < s.points.Count) {
                    if (s.points[j].x > maxX) { maxX = s.points[j].x; }
                    if (s.points[j].y > maxY) { maxY = s.points[j].y; }
                    j = j + 1;
                }
            }
        }
        int maxXN = Chart.NiceMax(maxX);
        int maxYN = Chart.NiceMax(maxY);
        int leftGut = Canvas.MeasureText(Convert.ToString(maxYN), axisFs) + app.Scale(12);
        int botGut = Canvas.FontHeight(axisFs) + app.Scale(8);
        int plotX = x + pad + leftGut;
        int plotY = top;
        int plotW = (x + w - pad) - plotX;
        int plotH = (y + h - zoomH - pad - botGut) - plotY;
        if (plotW < app.Scale(20)) { plotW = app.Scale(20); }
        if (plotH < app.Scale(20)) { plotH = app.Scale(20); }

        if (o.showTooltip) {
            int mx = app.mouseX;
            int my = app.mouseY;
            if (mx >= plotX && mx < plotX + plotW
                && my >= plotY && my < plotY + plotH) {
                int bestS = 0 - 1;
                int bestJ = 0;
                int bestD = 0;
                for (int r2 = 0; r2 < o.series.Count; r2 = r2 + 1) {
                    ChartSeries s2 = o.series[r2];
                    if (!s2.hidden && s2.type != ChartType.Line) {
                        int j2 = i0;
                        while (j2 <= i1 && j2 < s2.points.Count) {
                            int px2 = plotX + s2.points[j2].x * plotW / maxXN;
                            int py2 = plotY + plotH - (s2.points[j2].y * plotH / maxYN);
                            int ddx = mx - px2;
                            int ddy = my - py2;
                            int d2 = ddx * ddx + ddy * ddy;
                            if (bestS < 0 || d2 < bestD) { bestS = r2; bestJ = j2; bestD = d2; }
                            j2 = j2 + 1;
                        }
                    }
                }
                int hitR = app.Scale(8);
                if (bestS >= 0 && bestD <= hitR * hitR) {
                    ChartSeries bs = o.series[bestS];
                    List<TooltipRow> rows = new List<TooltipRow>{
                        TooltipRow.Of(bs.color, bs.name),
                        TooltipRow.Of(bs.color,
                            "x  " + Convert.ToString(bs.points[bestJ].x)
                            + "   y  " + Convert.ToString(bs.points[bestJ].y)) };
                    ChartView.TooltipCard(app, mx, my, plotX + plotW, rows);
                }
            }
        }
    }
}
