using System;
using System.Json;
using Gui;

namespace Gui.Component.Chart;

partial class ChartView {
    // ---- scatter (dual value axes) ----

    static void DrawScatter(App app, int x, int y, int w, int h,
                            ChartOption o, int g) {
        ChartView.DrawScatterCore(app, x, y, w, h, o, g);
        ChartView.ScatterHover(app, x, y, w, h, o);
    }

    /// The scatter body only (panel, axes, points) — no hover overlay, so it
    /// can be cached by RenderCached (a 2000-point cloud then costs one pixel
    /// copy per frame) and the pointer feedback redrawn on top after a hit.
    static void DrawScatterCore(App app, int x, int y, int w, int h,
                                ChartOption o, int g) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int pad = t.paddingMedium;
        int axisFs = t.fontSizeSmall;

        int top = ChartView.PanelHead(app, x, y, w, h, o.title);

        int maxX = 0;
        int maxY = 0;
        int si = 0;
        while (si < o.series.Count) {
            ChartSeries s = o.series[si];
            if (!s.hidden) {
                int j = 0;
                while (j < s.scatterX.Count) {
                    if (s.scatterX[j] > maxX) { maxX = s.scatterX[j]; }
                    if (s.scatterY[j] > maxY) { maxY = s.scatterY[j]; }
                    j = j + 1;
                }
            }
            si = si + 1;
        }
        int maxXN = Chart.NiceMax(maxX);
        int maxYN = Chart.NiceMax(maxY);
        int leftGut = Canvas.MeasureText(Convert.ToString(maxYN), axisFs) + app.Scale(12);
        int botGut = Canvas.FontHeight(axisFs) + app.Scale(8);
        int plotX = x + pad + leftGut;
        int plotY = top;
        int plotW = (x + w - pad) - plotX;
        int plotH = (y + h - pad - botGut) - plotY;
        if (plotW < app.Scale(20)) { plotW = app.Scale(20); }
        if (plotH < app.Scale(20)) { plotH = app.Scale(20); }

        int ticks = 5;
        int k = 0;
        while (k <= ticks) {
            int gy = plotY + plotH - (k * plotH / ticks);
            c.FillRect(plotX, gy, plotW, 1, t.divider);
            string vs = Convert.ToString(maxYN * k / ticks);
            int vw = Canvas.MeasureText(vs, axisFs);
            c.DrawText(plotX - app.Scale(6) - vw, gy - Canvas.FontHeight(axisFs) / 2, vs, t.textTertiary, axisFs);
            int gx = plotX + k * plotW / ticks;
            c.DrawTextCentered(gx - app.Scale(20), plotY + plotH + app.Scale(4), app.Scale(40), botGut, Convert.ToString(maxXN * k / ticks), t.textTertiary, axisFs);
            k = k + 1;
        }
        c.FillRect(plotX, plotY, 1, plotH, t.borderSecondary);
        c.FillRect(plotX, plotY + plotH, plotW, 1, t.borderSecondary);

        int rad = app.Scale(4);
        int r = 0;
        while (r < o.series.Count) {
            ChartSeries s = o.series[r];
            if (!s.hidden) {
                // A Line series in the scatter space draws as a connected
                // polyline (e.g. a fitted regression line through the cloud);
                // every other series plots as points.
                if (s.type == ChartType.Line && s.scatterX.Count > 1) {
                    int j0 = 0;
                    while (j0 < s.scatterX.Count - 1) {
                        int xa = plotX + s.scatterX[j0] * plotW / maxXN;
                        int ya = plotY + plotH - (s.scatterY[j0] * plotH / maxYN);
                        int xb = plotX + s.scatterX[j0 + 1] * plotW / maxXN;
                        int yb = plotY + plotH - (s.scatterY[j0 + 1] * plotH / maxYN);
                        c.DrawLine(xa, ya, xb, yb, s.color, app.Scale(2));
                        j0 = j0 + 1;
                    }
                } else {
                    int j = 0;
                    while (j < s.scatterX.Count) {
                        int px = plotX + s.scatterX[j] * plotW / maxXN;
                        int py = plotY + plotH - (s.scatterY[j] * plotH / maxYN);
                        c.FillCircle(px, py, rad, s.color);
                        j = j + 1;
                    }
                }
            }
            r = r + 1;
        }
    }

    /// Hover overlay for a scatter: finds the nearest point within hit radius
    /// and shows its coordinates. Drawn after DrawScatterCore (or after a
    /// RenderCached restore) so a cached dense cloud still has live tooltips.
    static void ScatterHover(App app, int x, int y, int w, int h, ChartOption o) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int pad = t.paddingMedium;
        int axisFs = t.fontSizeSmall;

        int top = ChartView.PanelHead(app, x, y, w, h, o.title);

        int maxX = 0;
        int maxY = 0;
        int si = 0;
        while (si < o.series.Count) {
            ChartSeries s = o.series[si];
            if (!s.hidden) {
                int j = 0;
                while (j < s.scatterX.Count) {
                    if (s.scatterX[j] > maxX) { maxX = s.scatterX[j]; }
                    if (s.scatterY[j] > maxY) { maxY = s.scatterY[j]; }
                    j = j + 1;
                }
            }
            si = si + 1;
        }
        int maxXN = Chart.NiceMax(maxX);
        int maxYN = Chart.NiceMax(maxY);
        int leftGut = Canvas.MeasureText(Convert.ToString(maxYN), axisFs) + app.Scale(12);
        int botGut = Canvas.FontHeight(axisFs) + app.Scale(8);
        int plotX = x + pad + leftGut;
        int plotY = top;
        int plotW = (x + w - pad) - plotX;
        int plotH = (y + h - pad - botGut) - plotY;
        if (plotW < app.Scale(20)) { plotW = app.Scale(20); }
        if (plotH < app.Scale(20)) { plotH = app.Scale(20); }

        if (o.showTooltip) {
            int mx = app.mouseX;
            int my = app.mouseY;
            if (mx >= plotX && mx < plotX + plotW
                && my >= plotY && my < plotY + plotH) {
                int bestS = 0 - 1;
                int bestJ = 0;
                int bestD = 0;
                int r2 = 0;
                while (r2 < o.series.Count) {
                    ChartSeries s2 = o.series[r2];
                    if (!s2.hidden && s2.type != ChartType.Line) {
                        int j2 = 0;
                        while (j2 < s2.scatterX.Count) {
                            int px2 = plotX + s2.scatterX[j2] * plotW / maxXN;
                            int py2 = plotY + plotH - (s2.scatterY[j2] * plotH / maxYN);
                            int ddx = mx - px2;
                            int ddy = my - py2;
                            int d2 = ddx * ddx + ddy * ddy;
                            if (bestS < 0 || d2 < bestD) { bestS = r2; bestJ = j2; bestD = d2; }
                            j2 = j2 + 1;
                        }
                    }
                    r2 = r2 + 1;
                }
                int hitR = app.Scale(8);
                if (bestS >= 0 && bestD <= hitR * hitR) {
                    ChartSeries bs = o.series[bestS];
                    List<int> tcols = new List<int>();
                    List<string> tlines = new List<string>();
                    tcols.Add(bs.color); tlines.Add(bs.name);
                    tcols.Add(bs.color);
                    tlines.Add("x  " + Convert.ToString(bs.scatterX[bestJ])
                        + "   y  " + Convert.ToString(bs.scatterY[bestJ]));
                    ChartView.TooltipCard(app, mx, my, plotX + plotW, tcols, tlines);
                }
            }
        }
    }
}
