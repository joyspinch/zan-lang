using System;
using Gui;

namespace Gui.Component.Chart;

/// 单个源系列的只读绘制快照。保留 source 引用，使渲染器
/// 无需复制数据，同时把继承值和交互状态隔离在当前帧。
class ResolvedSeries {
    ChartSeries source;
    int color;
    int lineColor;
    int lineWidth;
    int areaColor;
    int labelColor;
    int labelFontSize;
    int emphColor;        // itemStyle.emphasis.color（0 = 同 normal）
    int emphBorderColor;  // 强调描边色
    int emphBorderWidth;  // 强调描边宽（0 = 无强调描边）
    bool hidden;
    int wid;
    bool animate;

    static ResolvedSeries Of(ChartSeries source, Theme theme, int index,
                             int wid, bool animate, bool hidden) {
        ResolvedSeries r = new ResolvedSeries();
        r.source = source;
        r.color = source.color;
        if (r.color == 0) { r.color = source.itemStyle.normal.color; }
        if (r.color == 0) { r.color = Chart.Palette(theme, index); }
        r.lineColor = source.itemStyle.normal.lineStyle.color;
        if (r.lineColor == 0) { r.lineColor = r.color; }
        r.lineWidth = source.itemStyle.normal.lineStyle.width;
        if (r.lineWidth <= 0) { r.lineWidth = 2; }
        r.areaColor = source.itemStyle.normal.areaStyle.color;
        if (r.areaColor == 0) { r.areaColor = r.color; }
        r.labelColor = source.label.color;
        r.labelFontSize = source.label.fontSize;
        if (r.labelFontSize <= 0) { r.labelFontSize = theme.fontSizeSmall; }
        // 强调（hover）paint：解析到 ResolvedSeries，命中时
        // 渲染器用 Effective* 取色，源系列永不被改写。
        r.emphColor = source.itemStyle.emphasis.color;
        if (r.emphColor == 0) { r.emphColor = r.color; }
        r.emphBorderColor = source.itemStyle.emphasis.borderColor;
        if (r.emphBorderColor == 0) { r.emphBorderColor = source.itemStyle.normal.borderColor; }
        r.emphBorderWidth = source.itemStyle.emphasis.borderWidth;
        if (r.emphBorderWidth < 0) { r.emphBorderWidth = 0; }
        r.hidden = hidden;
        r.wid = wid;
        r.animate = animate;
        return r;
    }

    int DataColor(int index) {
        if (index >= 0 && index < this.source.data.Count
            && this.source.data[index].color != 0) {
            return this.source.data[index].color;
        }
        return this.color;
    }

    /// CSS 覆写入口（chart::series-N）：替换系列主色并同步
    /// 未被显式指定的派生色（线/面积/强调色跟随主色）。
    void OverrideColor(int cssColor) {
        if (cssColor == 0) { return; }
        this.color = cssColor;
        if (this.source.itemStyle.normal.lineStyle.color == 0) { this.lineColor = cssColor; }
        if (this.source.itemStyle.normal.areaStyle.color == 0) { this.areaColor = cssColor; }
        if (this.source.itemStyle.emphasis.color == 0) { this.emphColor = cssColor; }
    }

    // 命中（hover）后的有效 paint：强调色优先；普通状态
    // 返回解析色。两者都只读，不触碰源系列。
    int EffectiveColor(bool hovered) {
        if (hovered) { return this.emphColor; }
        return this.color;
    }
    int EffectiveBorderColor(bool hovered) {
        if (hovered) { return this.emphBorderColor; }
        return this.source.itemStyle.normal.borderColor;
    }
    int EffectiveBorderWidth(bool hovered) {
        if (hovered) { return this.emphBorderWidth; }
        return this.source.itemStyle.normal.borderWidth;
    }

    ChartSeries Materialize() {
        ChartSeries src = this.source;
        ChartSeries s = ChartSeries.Of(src.name, src.type, new List<int>());
        s.axisIndex = src.axisIndex; s.stack = src.stack; s.stackName = src.stackName;
        s.color = this.color; s.hidden = this.hidden; s.smooth = src.smooth;
        s.areaStyle = src.areaStyle; s.step = src.step; s.sort = src.sort;
        s.roseType = src.roseType; s.innerPct = src.innerPct; s.hbar = src.hbar;
        s.treeOrient = src.treeOrient; s.custom = src.custom;
        s.selectedMode = src.selectedMode;
        s.forceScaling = src.forceScaling; s.forceGravity = src.forceGravity;
        s.forceMinRadius = src.forceMinRadius; s.forceMaxRadius = src.forceMaxRadius;
        s.forceNodeColor = src.forceNodeColor; s.forceLinkColor = src.forceLinkColor;
        s.chordRibbonType = src.chordRibbonType; s.chordSort = src.chordSort;
        s.chordSortSub = src.chordSortSub; s.chordGapDeg = src.chordGapDeg;
        s.chordRingWidthPct = src.chordRingWidthPct;
        s.funnelAlign = src.funnelAlign; s.funnelGap = src.funnelGap;
        s.funnelPercent = src.funnelPercent;
        s.wcMinFontSize = src.wcMinFontSize; s.wcMaxFontSize = src.wcMaxFontSize;
        s.wcRotate = src.wcRotate; s.wcRotateList = src.wcRotateList;
        s.startAngle = src.startAngle; s.selectedOffset = src.selectedOffset;
        s.barWidth = src.barWidth; s.barGapPct = src.barGapPct;
        s.symbol = src.symbol; s.symbolSize = src.symbolSize;
        s.symbolSizeFn = src.symbolSizeFn;
        s.showSymbol = src.showSymbol;
        s.showBackground = src.showBackground; s.backgroundColor = src.backgroundColor;
        s.itemStyle = src.itemStyle; s.label = src.label; s.labelShow = src.labelShow;
        s.data = src.data; s.candles = src.candles; s.bubbles = src.bubbles;
        s.boxes = src.boxes; s.errors = src.errors; s.points = src.points;
        s.tree = src.tree; s.links = src.links; s.gauge = src.gauge;
        s.regions = src.regions; s.events = src.events; s.marks = src.marks;
        s.markLines = src.markLines;
        ChartItemStyle style = ChartItemStyle.Create();
        style.normal.color = src.itemStyle.normal.color;
        style.normal.color0 = src.itemStyle.normal.color0;
        style.normal.borderColor = src.itemStyle.normal.borderColor;
        style.normal.borderWidth = src.itemStyle.normal.borderWidth;
        style.normal.lineStyle.color = this.lineColor;
        style.normal.lineStyle.color0 = src.itemStyle.normal.lineStyle.color0;
        style.normal.lineStyle.width = this.lineWidth;
        style.normal.lineStyle.type = src.itemStyle.normal.lineStyle.type;
        style.normal.lineStyle.shadowColor = src.itemStyle.normal.lineStyle.shadowColor;
        style.normal.lineStyle.shadowBlur = src.itemStyle.normal.lineStyle.shadowBlur;
        style.normal.areaStyle.color = this.areaColor;
        style.normal.areaStyle.type = src.itemStyle.normal.areaStyle.type;
        // borderRadius 表只读共享（Materialize 不改写）。
        style.normal.borderRadius = src.itemStyle.normal.borderRadius;
        style.emphasis = src.itemStyle.emphasis;
        s.itemStyle = style;
        ChartTextStyle label = ChartTextStyle.Create();
        label.color = this.labelColor; label.fontSize = this.labelFontSize;
        label.fontStyle = src.label.fontStyle; label.fontWeight = src.label.fontWeight;
        label.fontFamily = src.label.fontFamily; label.shadowColor = src.label.shadowColor;
        label.shadowBlur = src.label.shadowBlur; s.label = label;
        return s;
    }
}

/// ChartOption 的只读、逐帧规范化结果。
class ResolvedChart {
    ChartOption source;
    List<ResolvedSeries> series;
    int wid;
    int stateWid;      // connect 组的交互态基址（组长 wid）；无组 = wid
    bool animate;
    int windowStart;   // dataZoom 窗口（类别索引，含端点）；
    int windowEnd;     //   无 zoom 时 = 全范围 [0, n-1]

    static ResolvedChart Resolve(ChartOption source, Theme theme, App app, int wid) {
        ResolvedChart outp = new ResolvedChart();
        outp.source = source;
        outp.series = new List<ResolvedSeries>();
        outp.wid = wid;
        outp.animate = source.animate;
        // connect() 联动：交互态（dataZoom 窗口 / 图例开关）统一
        // 存取在组长 wid 上。组长登记在组键里（组内第一张图写入），
        // 本图非组长时用组长 wid 读写这些状态，实现跨图同帧联动。
        int stateWid = wid;
        if (app != null && wid != 0 && source.connectGroup != 0) {
            int gk = Chart.ConnectGroupKey(source.connectGroup);
            int leader = app.StateGet(gk, 0);
            if (leader == 0) {
                app.StateSet(gk, wid);
                app.StateSet(Chart.ConnectHoverKey(wid), 0 - 1);
            } else if (leader != wid) {
                stateWid = leader;
            }
        }
        outp.stateWid = stateWid;
        // dataZoom 窗口在解析期锁定一次，使指纹读取的窗口
        // 与渲染器读取的一致。无 zoom（或 n < 2）时
        // 是干净的全范围，不触发任何 App 状态读写。
        outp.windowStart = 0;
        outp.windowEnd = 0 - 1;
        int n = source.XCategories().Count;
        if (n < 1) { n = 1; }
        if (source.zoom && app != null && stateWid != 0 && n > 1) {
            outp.windowStart = Chart.ZoomI0(app, source, stateWid, n);
            outp.windowEnd = Chart.ZoomI1(app, source, stateWid, n);
            if (outp.windowEnd < outp.windowStart) { outp.windowEnd = outp.windowStart; }
        } else {
            outp.windowStart = 0;
            outp.windowEnd = n - 1;
        }
        for (int i = 0; i < source.series.Count; i = i + 1) {
            ChartSeries s = source.series[i];
            bool hidden = s.hidden;
            if (app != null && stateWid != 0) {
                hidden = app.StateGet(Chart.LegendKey(stateWid, i), hidden ? 1 : 0) == 1;
            }
            ResolvedSeries rs = ResolvedSeries.Of(s, theme, i, wid, source.animate, hidden);
            // CSS 通道：样式表可用 chart::series-1..8 的 background
            // 覆写该系列的定性色。仅显式规则生效——规则不存在时
            // BgOr 为 0，自动回退 token 调色板 / ECharts 默认色。
            if (app != null) {
                int cssCol = Style.Part(app, "chart",
                                        "series-" + Convert.ToString(i + 1),
                                        "", "", "", Style.SNormal()).BgOr(0);
                if (cssCol != 0) { rs.OverrideColor(cssCol); }
            }
            outp.series.Add(rs);
        }
        return outp;
    }

    ResolvedSeries For(ChartSeries source) {
        for (int i = 0; i < this.series.Count; i = i + 1) {
            if (this.series[i].source == source) { return this.series[i]; }
        }
        return null;
    }

    List<ChartSeries> MaterializeSeries() {
        List<ChartSeries> outp = new List<ChartSeries>();
        for (int i = 0; i < this.series.Count; i = i + 1) {
            outp.Add(this.series[i].Materialize());
        }
        return outp;
    }

    /// 创建渲染器使用的帧内 option。数据集合继续共享，可能被旧
    /// 渲染器修改的 option/series 外壳则复制并与源模型隔离。
    /// iwid 用 stateWid（connect 组的组长 wid）：渲染器所有交互
    /// 键（dataZoom/图例/十字线）自动落到组共享的键上。
    ChartOption DrawOption(int wid, bool animate) {
        ChartOption o = ChartOption.Create();
        ChartOption s = this.source;
        o.title = s.title;
        o.xAxes = new List<ChartAxis>();
        for (int xi = 0; xi < s.xAxes.Count; xi = xi + 1) { o.xAxes.Add(s.xAxes[xi]); }
        o.yAxes = new List<ChartAxis>();
        for (int yi = 0; yi < s.yAxes.Count; yi = yi + 1) { o.yAxes.Add(s.yAxes[yi]); }
        o.series = this.MaterializeSeries(); o.defaultType = s.defaultType;
        o.showLegend = s.showLegend; o.showTooltip = s.showTooltip;
        o.toolboxShow = s.toolboxShow;
        o.roam = s.roam; o.mapSelect = s.mapSelect;
        o.showGrid = s.showGrid; o.showValues = s.showValues;
        o.animate = animate; o.smooth = s.smooth; o.gradient = s.gradient;
        o.rounded = s.rounded; o.animMs = s.animMs; o.donutPct = s.donutPct;
        o.gaugeMax = s.gaugeMax; o.pieLabels = s.pieLabels; o.pieRings = s.pieRings;
        o.radarMax = s.radarMax; o.zoom = s.zoom; o.markLine = s.markLine;
        o.markPoint = s.markPoint; o.markLabel = s.markLabel; o.markLo = s.markLo;
        o.markHi = s.markHi; o.gridLeft = s.gridLeft; o.gridRight = s.gridRight;
        o.gridTop = s.gridTop; o.gridBottom = s.gridBottom;
        o.zoomStart = s.zoomStart; o.zoomEnd = s.zoomEnd;
        o.windowStart = this.windowStart; o.windowEnd = this.windowEnd;
        o.backgroundColor = s.backgroundColor; o.iwid = this.stateWid;
        o.connectGroup = s.connectGroup;
        o.rampColors = s.rampColors; o.rampLo = s.rampLo; o.rampHi = s.rampHi;
        o.radarShape = s.radarShape; o.radarSplitArea = s.radarSplitArea;
        o.legendOrient = s.legendOrient; o.legendSelectedMode = s.legendSelectedMode;
        o.legendFormatter = s.legendFormatter;
        o.dataRangeShow = s.dataRangeShow; o.dataRangeLo = s.dataRangeLo;
        o.dataRangeHi = s.dataRangeHi; o.dataRangeCalculable = s.dataRangeCalculable;
        o.dataRangeHoverLink = s.dataRangeHoverLink;
        o.dataRangeSplit = s.dataRangeSplit; o.dataRangeList = s.dataRangeList;
        return o;
    }
}
