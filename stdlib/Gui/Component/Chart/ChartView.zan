using System;
using System.Json;
using Gui;

namespace Gui.Component.Chart;

/// 组件化、带动画的图表控件（Chart 控件的现代形态）。
/// 一次性绑定 ChartOption（ECharts 风格：标题 + 轴 + 系列，
/// 每个系列携带自己的类型），然后每帧调用 Render。
/// 它会播放增长入场动画，绘制渐变/平滑系列和可选的悬停
/// 十字线 + 数值工具提示。多级控制对应 ECharts：option.*
/// （全局）< series.*（逐系列）< data[i].*（逐项），因此混合图表
/// 只是共享同一坐标系的不同类型系列。
partial class ChartView {
    ChartOption option;
    ChartOption sourceOption;
    ChartOption initialOption;
    ChartController controller;
    string directStatus;
    string directStatusMessage;
    ResolvedChart resolved;
    bool staticFrame;
    // 每个图表稳定的动画键。默认为新 WidgetId，但
    // 即时模式/虚拟化列表中的调用方（控件 id 顺序随
    // 行滚动进出而变动）应通过 Keyed() 传入自有稳定键，
    // 避免增长入场动画每帧被重置为 0。
    int wid;

    // 保留式生命周期通知。图表仍由 Render 驱动，但调用方
    // 可以在创建后订阅，不必改写每个 renderer 的交互分支。
    UiEvent Rendered;
    UiEvent Resized;
    UiEvent Updated;
    UiEvent Disposed;
    int lastRenderW;
    int lastRenderH;
    int directVersion;
    int lastControllerVersion;
    int lastDirectVersion;
    bool hasRendered;
    bool disposed;
    ChartEventHub eventHub;
    int eventHitId;
    bool pointerWasOver;
    ChartHit currentHit;
    ChartHit previousHit;
    int lastZoomLo;
    int lastZoomHi;
    int lastEventStateWid;
    static ChartView activeEventView;

    void InitLifecycle() {
        Rendered = new UiEvent();
        Resized = new UiEvent();
        Updated = new UiEvent();
        Disposed = new UiEvent();
        lastRenderW = 0;
        lastRenderH = 0;
        directVersion = 1;
        lastControllerVersion = 0 - 1;
        lastDirectVersion = 0 - 1;
        hasRendered = false;
        disposed = false;
        eventHub = new ChartEventHub();
        eventHitId = 0 - 1;
        pointerWasOver = false;
        currentHit = null;
        previousHit = null;
        lastZoomLo = 0 - 1;
        lastZoomHi = 0 - 1;
        lastEventStateWid = 0 - 1;
        directStatus = "ready";
        directStatusMessage = "";
    }

    /// 把图例开关写回 data.hidden（多数据项）或 series.hidden（单值系列）。
    /// 画廊每帧重建 option，必须从 App 状态恢复，否则点了等于没点。
    static void ApplyDataLegend(App app, ChartOption o) {
        if (o.iwid == 0) { return; }
        for (int si = 0; si < o.series.Count; si = si + 1) {
            ChartSeries s = o.series[si];
            if (s.data.Count > 1) {
                for (int di = 0; di < s.data.Count; di = di + 1) {
                    s.data[di].hidden = app.StateGet(
                        Chart.LegendSliceKey(o.iwid, si, di), 0) == 1;
                    int sel0 = 0;
                    if (s.data[di].selected) { sel0 = 1; }
                    s.data[di].selected = app.StateGet(
                        Chart.PieSelKey(o.iwid, si, di), sel0) == 1;
                }
            } else {
                s.hidden = app.StateGet(Chart.LegendKey(o.iwid, si), 0) == 1;
            }
        }
    }

    // 层级图表（treemap/sunburst）最近一次的悬停命中。
    // 由命中追踪辅助函数设置，调用方立即读取以绘制工具提示，
    // 因此不会跨帧存留。
    static string ttName;
    static int ttVal;
    static int ttX;        // treemap：命中单元格矩形
    static int ttY;
    static int ttW;
    static int ttH;
    static int ttA0;       // sunburst：命中扇区扫掠 + 环深度
    static int ttA1;
    static int ttDepth;

    static ChartView Of(ChartOption o) {
        if (o == null) { o = ChartOption.Create(); }
        ChartView v = new ChartView();
        v.InitLifecycle();
        v.option = o;
        v.sourceOption = o;
        v.initialOption = ChartOption.Clone(o);
        v.staticFrame = false;
        v.wid = WidgetId.Next();
        return v;
    }

    /// 绑定一个选项及调用方所有的稳定动画键。
    static ChartView Keyed(ChartOption o, int key) {
        if (o == null) { o = ChartOption.Create(); }
        ChartView v = new ChartView();
        v.InitLifecycle();
        v.option = o;
        v.controller = null;
        v.sourceOption = o;
        v.initialOption = ChartOption.Clone(o);
        v.staticFrame = false;
        v.wid = key;
        return v;
    }

    /// 静态首绘的 Keyed 变体：跳过增长入场动画，首帧即最终
    /// 形态（对齐 ECharts 官方示例站的静态示例）。文档预览、
    /// 虚拟化单元格与滚动路径上的图表用它，避免卡片滚入视口时
    /// 入场动画触发数百毫秒的连续重绘突发。
    static ChartView KeyedStatic(ChartOption o, int key) {
        ChartView v = ChartView.Keyed(o, key);
        v.staticFrame = true;
        return v;
    }

    /// 将 ChartView 绑定到可变 controller。Render 时读取 controller 的当前 option。
    static ChartView Bind(ChartController controller) {
        ChartView v = new ChartView();
        v.InitLifecycle();
        v.controller = controller;
        if (controller != null) {
            v.option = controller.Option(); v.sourceOption = v.option;
            v.initialOption = controller.GetOption();
        } else {
            v.option = ChartOption.Create(); v.sourceOption = v.option;
            v.initialOption = ChartOption.Clone(v.option);
        }
        v.staticFrame = false;
        v.wid = WidgetId.Next();
        return v;
    }

    /// 带稳定交互键的 controller 绑定，适合列表和虚拟化单元格。
    static ChartView BindKeyed(ChartController controller, int key) {
        ChartView v = ChartView.Bind(controller);
        v.wid = key;
        return v;
    }

    /// 生命周期事件：在保留的 ChartView 实例上订阅。
    ChartView OnRendered(Action a) { Rendered.Add(a); return this; }
    ChartView OnResize(Action a) { Resized.Add(a); return this; }
    ChartView OnUpdated(Action a) { Updated.Add(a); return this; }
    ChartView OnDisposed(Action a) { Disposed.Add(a); return this; }

    /// 注册/移除带载荷的图表交互事件。
    ChartView On(ChartEventType type, ChartInteractionHandler handler) {
        if (!this.disposed) { this.eventHub.On(type, handler); }
        return this;
    }

    ChartView Off(ChartEventType type, ChartInteractionHandler handler) {
        if (!this.disposed) { this.eventHub.Off(type, handler); }
        return this;
    }

    ChartView ClearEvents() {
        if (!this.disposed) { this.eventHub.Clear(); }
        return this;
    }

    void RaiseInteraction(ChartInteractionEvent eventArgs) {
        if (this.disposed || eventArgs == null) { return; }
        this.eventHub.Raise(eventArgs);
        if (this.controller != null
            && eventArgs.type != ChartEventType.DataChanged) {
            this.controller.RaiseEvent(eventArgs);
        }
    }

    void RaiseLocal(ChartInteractionEvent eventArgs) {
        if (this.disposed || eventArgs == null) { return; }
        this.eventHub.Raise(eventArgs);
    }

    static void RaiseActive(ChartInteractionEvent eventArgs) {
        if (ChartView.activeEventView != null) {
            ChartView.activeEventView.RaiseInteraction(eventArgs);
        }
    }

    static ChartInteractionEvent EventAt(ChartEventType type, int wid,
                                         int px, int py) {
        ChartInteractionEvent e = ChartInteractionEvent.Of(type, wid);
        e.x = px;
        e.y = py;
        return e;
    }

    static ChartInteractionEvent EventFromHit(ChartEventType type, int wid,
                                               ChartHit hit) {
        if (hit == null) { return ChartInteractionEvent.Of(type, wid); }
        ChartInteractionEvent e = ChartInteractionEvent.DataPoint(type, wid,
            hit.seriesIndex, hit.seriesName, hit.dataIndex, hit.dataName,
            hit.elementType);
        e.value = hit.value;
        e.numberValueSet = hit.numberValueSet;
        e.numberValue = hit.numberValue;
        e.xValueSet = hit.xValueSet;
        e.xValue = hit.xValue;
        e.yValueSet = hit.yValueSet;
        e.yValue = hit.yValue;
        e.x = hit.pixelX;
        e.y = hit.pixelY;
        e.axisIndex = hit.axisIndex;
        return e;
    }

    /// 当前帧由 renderer 提供的命中候选。renderer 按绘制顺序调用，
    /// 后来的具体图元覆盖早先的候选，但不会产生额外事件。
    static void OfferActiveHit(ChartHit hit) {
        if (ChartView.activeEventView != null && hit != null) {
            ChartView.activeEventView.currentHit = hit;
        }
    }

    // 混合 Cartesian 图在渲染结束后才复算部分 overlay 命中。
    // 系列索引与主体绘制顺序一致：后面的系列视觉上覆盖前面的
    // 系列；较早系列的延迟命中不能反过来遮掉已经命中的后层。
    static void OfferTopmostCategoryHit(ChartHit hit) {
        if (ChartView.activeEventView == null || hit == null) { return; }
        ChartHit old = ChartView.activeEventView.currentHit;
        if (old == null || hit.seriesIndex >= old.seriesIndex) {
            ChartView.activeEventView.currentHit = hit;
        }
    }

    static ChartHit MakeDataHit(ChartSeries s, int seriesIndex, int dataIndex,
                                string fallbackName, ChartElementType elementType,
                                int px, int py, int value) {
        if (s == null) { return null; }
        string dataName = fallbackName;
        if (dataIndex >= 0 && dataIndex < s.data.Count
            && s.data[dataIndex].name.Length > 0) {
            dataName = s.data[dataIndex].name;
        }
        ChartHit h = ChartHit.Of(elementType, seriesIndex, s.name,
            dataIndex, dataName, value, px, py);
        h.axisIndex = s.axisIndex;
        if (dataIndex >= 0 && dataIndex < s.data.Count) {
            ChartData d = s.data[dataIndex];
            h.numberValueSet = d.numberSet;
            h.numberValue = d.number;
        }
        return h;
    }

    static void OfferCategoryPointHits(App app, ChartFrame f,
                                       List<string> labels,
                                       List<ChartSeries> series, int baseIdx,
                                       int g, ChartElementType elementType) {
        if (f == null || labels == null || labels.Count < 1 || series == null) { return; }
        int mx = app.mouseX;
        int my = app.mouseY;
        if (mx < f.plotX || mx >= f.plotX + f.plotW
            || my < f.plotY || my >= f.plotY + f.plotH) { return; }
        int n = labels.Count;
        int bestD = 0;
        ChartHit best = null;
        for (int si = 0; si < series.Count; si = si + 1) {
            ChartSeries s = series[si];
            if (s == null || s.hidden || s.type != ChartType.Line) { continue; }
            for (int vi = 0; vi < n; vi = vi + 1) {
                int oi = baseIdx + vi;
                if (oi < 0 || oi >= s.Count()) { continue; }
                int px = f.CatMid(vi, n);
                int py = f.YOf(s.Value(oi) * g / 1000, s.axisIndex);
                int dx = mx - px;
                int dy = my - py;
                int d2 = dx * dx + dy * dy;
                if (best == null || d2 < bestD) {
                    bestD = d2;
                    best = ChartView.MakeDataHit(s, si, oi, labels[vi],
                        elementType, px, py, s.Value(oi));
                }
            }
        }
        int hitR = app.Scale(10);
        if (best != null && bestD <= hitR * hitR) {
            best.pixelX = mx;
            best.pixelY = my;
            ChartView.OfferTopmostCategoryHit(best);
        }
    }

    static bool HasInteraction(ChartView v, ChartEventType type) {
        if (v == null) { return false; }
        if (v.eventHub != null && v.eventHub.Count(type) > 0) { return true; }
        if (v.controller != null && v.controller.HasEvent(type)) { return true; }
        return false;
    }

    static bool OwnsActiveClick(App app, int id) {
        if (ChartView.activeEventView == null || id < 0) { return false; }
        return Ui.OwnsClick(app, id);
    }

    void DispatchPointerEvents(App app, int x, int y, int w, int h,
                               string statusNow) {
        bool over = statusNow == "ready"
            && app.mouseX >= x && app.mouseX < x + w
            && app.mouseY >= y && app.mouseY < y + h;
        ChartHit hit = over ? this.currentHit : null;
        if (hit != null) {
            hit.pixelX = app.mouseX;
            hit.pixelY = app.mouseY;
        }
        bool entered = over && !this.pointerWasOver;
        bool left = !over && this.pointerWasOver;
        bool hitChanged = !ChartHit.Same(this.previousHit, hit);
        if ((hitChanged || left) && this.previousHit != null) {
            ChartInteractionEvent me = ChartView.EventFromHit(
                ChartEventType.MouseOut, this.wid, this.previousHit);
            this.RaiseInteraction(me);
        }
        if ((hitChanged || entered) && hit != null) {
            ChartInteractionEvent he = ChartView.EventFromHit(
                ChartEventType.Hover, this.wid, hit);
            this.RaiseInteraction(he);
        } else if (entered && hit == null) {
            ChartInteractionEvent he2 = ChartView.EventAt(
                ChartEventType.Hover, this.wid, app.mouseX, app.mouseY);
            this.RaiseInteraction(he2);
        } else if (left && hit == null && this.previousHit == null) {
            ChartInteractionEvent me2 = ChartView.EventAt(
                ChartEventType.MouseOut, this.wid, app.mouseX, app.mouseY);
            this.RaiseInteraction(me2);
        }
        this.pointerWasOver = over;
        if (statusNow == "ready" && this.eventHitId >= 0
            && Ui.Clicked(app, this.eventHitId)) {
            if (hit != null) {
                ChartInteractionEvent ce = ChartView.EventFromHit(
                    ChartEventType.Click, this.wid, hit);
                this.RaiseInteraction(ce);
            } else {
                ChartInteractionEvent ce2 = ChartView.EventAt(
                    ChartEventType.Click, this.wid, app.mouseX, app.mouseY);
                this.RaiseInteraction(ce2);
            }
        }
        if (statusNow == "ready" && this.eventHitId >= 0
            && Ui.DoubleClicked(app, this.eventHitId)) {
            ChartInteractionEvent de = hit != null
                ? ChartView.EventFromHit(ChartEventType.DoubleClick, this.wid, hit)
                : ChartView.EventAt(ChartEventType.DoubleClick, this.wid,
                                    app.mouseX, app.mouseY);
            this.RaiseInteraction(de);
        }
        this.previousHit = ChartHit.Copy(hit);
        ChartView.activeEventView = null;
    }

    ChartView OnClick(ChartInteractionHandler handler) {
        return this.On(ChartEventType.Click, handler);
    }
    ChartView OnDoubleClick(ChartInteractionHandler handler) {
        return this.On(ChartEventType.DoubleClick, handler);
    }
    ChartView OnHover(ChartInteractionHandler handler) {
        return this.On(ChartEventType.Hover, handler);
    }
    ChartView OnMouseOut(ChartInteractionHandler handler) {
        return this.On(ChartEventType.MouseOut, handler);
    }
    ChartView OnLegendSelected(ChartInteractionHandler handler) {
        return this.On(ChartEventType.LegendSelected, handler);
    }
    ChartView OnPieSelected(ChartInteractionHandler handler) {
        return this.On(ChartEventType.PieSelected, handler);
    }
    ChartView OnMapSelected(ChartInteractionHandler handler) {
        return this.On(ChartEventType.MapSelected, handler);
    }
    ChartView OnMapRoam(ChartInteractionHandler handler) {
        return this.On(ChartEventType.MapRoam, handler);
    }
    ChartView OnTimelineChanged(ChartInteractionHandler handler) {
        return this.On(ChartEventType.TimelineChanged, handler);
    }
    ChartView OnMagicTypeChanged(ChartInteractionHandler handler) {
        return this.On(ChartEventType.MagicTypeChanged, handler);
    }
    ChartView OnRefresh(ChartInteractionHandler handler) {
        return this.On(ChartEventType.Refresh, handler);
    }
    ChartView OnForceLayoutEnd(ChartInteractionHandler handler) {
        return this.On(ChartEventType.ForceLayoutEnd, handler);
    }
    ChartView OnDataZoom(ChartInteractionHandler handler) {
        return this.On(ChartEventType.DataZoom, handler);
    }
    ChartView OnDataRange(ChartInteractionHandler handler) {
        return this.On(ChartEventType.DataRange, handler);
    }
    ChartView OnRestore(ChartInteractionHandler handler) {
        return this.On(ChartEventType.Restore, handler);
    }
    ChartView OnResizeEvent(ChartInteractionHandler handler) {
        return this.On(ChartEventType.Resize, handler);
    }
    ChartView OnDataChanged(ChartInteractionHandler handler) {
        return this.On(ChartEventType.DataChanged, handler);
    }

    /// 返回 option 快照；controller 绑定和直接 option 两种模式都不暴露
    /// 内部可变对象。
    ChartOption GetOption() {
        if (this.controller != null) { return this.controller.GetOption(); }
        return ChartOption.Clone(this.sourceOption);
    }

    string Status() {
        if (this.disposed) { return "disposed"; }
        if (this.controller != null) { return this.controller.Status(); }
        return this.directStatus;
    }

    string StatusMessage() {
        if (this.disposed) { return ""; }
        if (this.controller != null) { return this.controller.StatusMessage(); }
        return this.directStatusMessage;
    }

    bool IsDisposed() { return this.disposed; }

    /// 替换 option；绑定 controller 时保留 controller 身份。
    ChartView SetOption(ChartOption next) {
        if (this.disposed || next == null) { return this; }
        if (this.controller != null) { this.controller.SetOption(next); }
        else {
            this.sourceOption = next; this.option = next;
            this.initialOption = ChartOption.Clone(next);
            this.directStatus = "ready"; this.directStatusMessage = "";
            this.directVersion = this.directVersion + 1;
        }
        return this;
    }

    /// 立即模式的显式刷新入口。Render 每帧都会读取最新 option，
    /// 因此这里仅提供与 ECharts refresh() 对齐的可链式语义。
    ChartView Refresh() { return this; }

    ChartView Restore() {
        if (this.disposed) { return this; }
        if (this.controller != null) { this.controller.Restore(); }
        else {
            this.sourceOption = ChartOption.Clone(this.initialOption); this.option = this.sourceOption;
            this.directStatus = "ready"; this.directStatusMessage = "";
            this.directVersion = this.directVersion + 1;
            ChartInteractionEvent re = ChartInteractionEvent.Of(
                ChartEventType.Restore, this.wid);
            this.RaiseInteraction(re);
        }
        return this;
    }

    ChartView Clear() {
        if (this.disposed) { return this; }
        if (this.controller != null) { this.controller.Clear(); }
        else {
            for (int i = 0; i < this.sourceOption.series.Count; i = i + 1) {
                this.sourceOption.series[i].data = new List<ChartData>();
            }
            this.directStatus = "empty"; this.directStatusMessage = "";
            this.directVersion = this.directVersion + 1;
        }
        return this;
    }

    ChartView ShowLoading(string message) {
        if (this.disposed) { return this; }
        if (this.controller != null) { this.controller.ShowLoading(message); }
        else {
            this.directStatus = "loading"; this.directStatusMessage = message;
            this.directVersion = this.directVersion + 1;
        }
        return this;
    }

    ChartView HideLoading() {
        if (this.disposed) { return this; }
        if (this.controller != null) { this.controller.HideLoading(); }
        else {
            this.directStatus = "ready"; this.directStatusMessage = "";
            this.directVersion = this.directVersion + 1;
        }
        return this;
    }

    ChartView SetEmptyMessage(string message) {
        if (this.disposed) { return this; }
        if (this.controller != null) { this.controller.SetEmptyMessage(message); }
        else {
            this.directStatus = "empty"; this.directStatusMessage = message;
            this.directVersion = this.directVersion + 1;
        }
        return this;
    }

    ChartView SetErrorMessage(string message) {
        if (this.disposed) { return this; }
        if (this.controller != null) { this.controller.SetErrorMessage(message); }
        else {
            this.directStatus = "error"; this.directStatusMessage = message;
            this.directVersion = this.directVersion + 1;
        }
        return this;
    }

    /// 释放 view 的事件订阅并使后续 Render/操作失效。
    /// controller 的生命周期由创建它的调用方拥有，view 不会替其 Dispose。
    void Dispose() {
        if (this.disposed) { return; }
        this.disposed = true;
        this.directStatus = "disposed"; this.directStatusMessage = "";
        if (this.Disposed.Count() > 0) { this.Disposed.Raise(); }
        this.Rendered.Clear(); this.Resized.Clear(); this.Updated.Clear();
        this.eventHub.Clear();
    }

    // RenderCached 的动态快照槽位分配器：运行时池按需增长
    // （ZAN_SNAP_CACHE_MAX_SLOTS = 512），任意数量的缓存
    // 图表可以共存；将图表嵌入会滚走的单元格的调用方
    // 应 ReleaseCached(slot) 归还像素缓冲区。
    static int cacheSeq = 16;
    static int AllocCacheSlot() {
        int s = ChartView.cacheSeq;
        ChartView.cacheSeq = ChartView.cacheSeq + 1;
        if (s >= 512) { ChartView.cacheSeq = 16; s = 16; }
        return s;
    }

    /// 释放 RenderCached 槽位拥有的像素缓冲区（在区域
    /// 离开视口时调用，如网格单元格滚走）。槽位稍后
    /// 可复用——指纹键按槽位区分，过期的快照
    /// 直接失配并重新渲染。
    static void ReleaseCached(Canvas c, int slot) {
        c.ReleaseSlot(slot);
    }

    /// 静态且光栅化成本高的图表的缓存区域渲染（热力图、
    /// 密集系列）：首次调用把最终形态（关闭动画）绘制进
    /// 快照槽位 0-7 并记录数据指纹；后续调用以单次拷贝
    /// 恢复缓存像素而非重新光栅化，
    /// 因此 100x50 热力图每帧成本为 O(区域) 而非 O(单元格)。
    /// 缓存对任何数据 / 可见性 / 缩放 / 主题 /
    /// 几何变化自动失效（指纹比较 + 几何匹配）。
    /// 悬停反馈（如 HeatmapHover）由调用方在命中*之后*绘制，
    /// 使工具提示保持活跃。帧由缓存提供时返回 true。
    static bool RenderCached(App app, ChartOption o, int slot,
                             int x, int y, int w, int h) {
        Canvas c = app.canvas;
        // 由槽位推导的稳定交互 id，使指纹读取的
        // dataZoom 窗口状态与渲染器读取的一致。
        int zwid = 300000 + slot;
        ResolvedChart resolved = ResolvedChart.Resolve(o, app.theme, app, zwid);
        int fp = ChartView.CacheFingerprint(app, o, resolved, x, y, w, h);
        if (app.StateGet(Chart.CacheKey(slot), 0) == fp
            && c.RestoreRect(x, y, w, h, slot)) {
            return true;
        }
        ChartView view = ChartView.Keyed(o, zwid);
        view.staticFrame = true;          // 快照始终是最终形态
        view.Render(app, x, y, w, h);
        c.SnapshotRect(x, y, w, h, slot);
        app.StateSet(Chart.CacheKey(slot), fp);
        return false;
    }

    /// RenderCached 的数据指纹：系列值 + 类型/轴/隐藏、
    /// dataZoom 窗口、当前主题，以及全部专用数据
    /// （links/tree/points/candles/bubbles/boxes/errors/events/
    /// regions/marks/gauge/radarMax）。任何会改变
    /// 像素的因素都使缓存快照失效；悬停位置刻意不
    /// 不（悬停层在缓存命中后绘制于其上）。
    static int CacheFingerprint(App app, ChartOption o, ResolvedChart resolved,
                                int x, int y, int w, int h) {
        int zoomLo = 0;
        int zoomHi = 0;
        if (o.zoom) {
            zoomLo = app.StateGet(Chart.ZoomLoKey(resolved.stateWid), o.zoomStart * 10);
            zoomHi = app.StateGet(Chart.ZoomHiKey(resolved.stateWid), o.zoomEnd * 10);
        }
        int fp = ChartView.FingerprintCore(
            app.ThemeMenuIndex() * 7919 + app.bgThemeGen, zoomLo, zoomHi, o, resolved);
        // dataRange 交互态（滑条 q + 分段隐藏位）会改快照像素
        // （条本体也在快照里），故折入缓存指纹。
        if (o.dataRangeShow && resolved.stateWid != 0) {
            fp = (fp * 31 + app.StateGet(Chart.DRangeLoKey(resolved.stateWid), 0)
                + app.StateGet(Chart.DRangeHiKey(resolved.stateWid), 1000) * 7
                + 1) % 2000000000;
            for (int bi = 0; bi < o.dataRangeList.Count; bi = bi + 1) {
                fp = (fp * 31 + app.StateGet(Chart.DRangeBandKey(resolved.stateWid, bi), 0)
                    + 3) % 2000000000;
            }
        }
        // 视口：快照槽位绑定像素矩形；控件移动 / 缩放而
        // 复用旧快照会画出错位像素，因此矩形进入指纹。
        fp = (fp * 31 + x * 7 + y * 13 + w * 17 + h * 19) % 2000000000;
        return fp;
    }

    /// 把字符串内容折叠进指纹。Zan 没有 char 值类型，但
    /// s[i] 给出字符编码（UTF-8 字节）；逐字节折叠使长度相同、
    /// 内容不同的标签/名称折叠出不同值，避免陈旧缓存。
    /// 空串返回 h 原值。
    static int FoldStr(int h, string s, int seed) {
        for (int i = 0; i < s.Length; i = i + 1) {
            h = (h * 31 + (s[i] & 255) + i * 5 + seed) % 2000000000;
        }
        return h;
    }

    /// 指纹的纯核心。主题代（themeGen）与 dataZoom 状态
    /// （zoomLo/zoomHi）作为整数注入，使 conformance 测试
    /// 无需 App 即可验证数据/可见性/主题/缩放变化都会改变指纹；
    /// CacheFingerprint 从 App 读取这两个状态，语义与旧版完全一致。
    static int FingerprintCore(int themeGen, int zoomLo, int zoomHi,
                               ChartOption o, ResolvedChart resolved) {
        int h = themeGen;
        h = (h * 31 + resolved.wid) % 2000000000;
        // connect 组改变交互键基址（状态随组长 wid 存取），
        // 指纹须随组号变化以正确失效缓存。
        h = (h * 31 + o.connectGroup * 7) % 2000000000;
        if (resolved.animate) { h = (h * 31 + 17) % 2000000000; }
        h = (h * 31 + o.zoomStart + o.zoomEnd + o.backgroundColor) % 2000000000;
        h = (h * 31 + o.donutPct + (o.pieRings ? 1 : 0) + (o.pieLabels ? 1 : 0)
            + o.gaugeMax) % 2000000000;
        // 改变布局/像素的 option 开关与边距。
        h = (h * 31 + (o.showLegend ? 1 : 0) + (o.showGrid ? 1 : 0)
            + (o.showValues ? 1 : 0) + (o.smooth ? 1 : 0)) % 2000000000;
        h = (h * 31 + (o.gradient ? 1 : 0) + (o.rounded ? 1 : 0)
            + o.markLine + o.markLo + o.markHi) % 2000000000;
        h = ChartView.FoldStr(h, o.markLabel, 1);
        h = ChartView.FoldStr(h, o.title, 2);
        h = (h * 31 + o.gridLeft + o.gridRight + o.gridTop + o.gridBottom) % 2000000000;
        for (int ri = 0; ri < o.radarMax.Count; ri = ri + 1) {
            h = (h * 31 + o.radarMax[ri]) % 2000000000;
        }
        h = ChartView.FoldStr(h, o.radarShape, 26);
        h = (h * 31 + (o.radarSplitArea ? 1 : 0)) % 2000000000;
        // legend 布局/格式与 dataRange 配置改像素，须入指纹。
        h = ChartView.FoldStr(h, o.legendOrient, 32);
        h = ChartView.FoldStr(h, o.legendFormatter, 33);
        h = (h * 31 + (o.dataRangeShow ? 1 : 0) + (o.dataRangeCalculable ? 2 : 0)
            + o.dataRangeLo + o.dataRangeHi + o.dataRangeSplit) % 2000000000;
        for (int di = 0; di < o.dataRangeList.Count; di = di + 1) {
            h = ChartView.FoldStr(h, o.dataRangeList[di].label, 34);
            h = (h * 31 + o.dataRangeList[di].lo + o.dataRangeList[di].hi) % 2000000000;
        }
        // 轴配置：类型/范围/翻转/刻度/网格/标题 + 分类标签
        // （标签直接决定绘制文字，长度哈希与系列名约定一致）。
        for (int ai = 0; ai < o.xAxes.Count; ai = ai + 1) {
            ChartAxis ax = o.xAxes[ai];
            h = (h * 31 + ax.type + ax.min + ax.max + ax.ticks) % 2000000000;
            h = (h * 31 + (ax.reversed ? 1 : 0) + (ax.showGrid ? 1 : 0)) % 2000000000;
            h = ChartView.FoldStr(h, ax.title, 3);
            h = (h * 31 + ax.labelRotate + ax.labelInterval) % 2000000000;
            h = ChartView.FoldStr(h, ax.nameLocation, 23);
            for (int cj = 0; cj < ax.categories.Count; cj = cj + 1) {
                h = ChartView.FoldStr(h, ax.categories[cj], cj * 31);
            }
        }
        for (int ai = 0; ai < o.yAxes.Count; ai = ai + 1) {
            ChartAxis ay = o.yAxes[ai];
            h = (h * 31 + ay.type + ay.min + ay.max + ay.ticks) % 2000000000;
            h = (h * 31 + (ay.reversed ? 1 : 0) + (ay.showGrid ? 1 : 0)) % 2000000000;
            h = ChartView.FoldStr(h, ay.title, 4);
        }
        h = (h * 31 + o.series.Count) % 2000000000;
        for (int s = 0; s < o.series.Count; s = s + 1) {
            ChartSeries cs = o.series[s];
            ResolvedSeries rs = resolved.series[s];
            h = (h * 31 + cs.type + cs.axisIndex) % 2000000000;
            h = ChartView.FoldStr(h, cs.name, 5);
            h = (h * 31 + cs.stack + cs.innerPct) % 2000000000;
            h = ChartView.FoldStr(h, cs.stackName, 6);
            h = ChartView.FoldStr(h, cs.custom, 7);
            h = ChartView.FoldStr(h, cs.selectedMode, 27);
            h = (h * 31 + rs.color + rs.lineColor + rs.lineWidth + rs.areaColor) % 2000000000;
            h = (h * 31 + rs.labelColor + rs.labelFontSize) % 2000000000;
            h = (h * 31 + cs.itemStyle.normal.borderColor
                + cs.itemStyle.normal.borderWidth) % 2000000000;
            h = ChartView.FoldStr(h, cs.itemStyle.normal.lineStyle.type, 8);
            // 逐系列绘制开关：平滑覆盖 / 面积填充 / 阶梯 /
            // 漏斗排序 / 玫瑰 / 水平柱 / 树方向。
            h = (h * 31 + cs.smooth + (cs.areaStyle ? 1 : 0)) % 2000000000;
            h = ChartView.FoldStr(h, cs.step, 9);
            h = ChartView.FoldStr(h, cs.sort, 10);
            h = ChartView.FoldStr(h, cs.roseType, 11);
            h = (h * 31 + (cs.hbar ? 1 : 0)) % 2000000000;
            h = ChartView.FoldStr(h, cs.treeOrient, 12);
            // symbol 形状族 / 尺寸 / 点显隐改像素，须入指纹。
            h = ChartView.FoldStr(h, cs.symbol, 21);
            h = (h * 31 + cs.symbolSize + cs.showSymbol) % 2000000000;
            h = ChartView.FoldStr(h, cs.symbolSizeFn, 46);
            // 批 6：force/chord/funnel/wordCloud 参数化字段全部入指纹。
            h = (h * 31 + cs.forceScaling + cs.forceGravity * 3
                + cs.forceMinRadius * 7 + cs.forceMaxRadius * 13
                + cs.chordSort * 17 + (cs.chordSortSub ? 1 : 0)
                + cs.chordGapDeg * 19 + cs.chordRingWidthPct * 23
                + cs.funnelGap * 31) % 2000000000;
            h = ChartView.FoldStr(h, cs.chordRibbonType, 38);
            h = ChartView.FoldStr(h, cs.funnelAlign, 39);
            h = ChartView.FoldStr(h, cs.wcRotate, 40);
            h = ChartView.FoldStr(h, cs.wcRotateList, 47);
            h = (h * 31 + cs.wcMinFontSize * 5 + cs.wcMaxFontSize * 11) % 2000000000;
            if (cs.funnelPercent) { h = (h * 31 + 3) % 2000000000; }
            h = (h * 31 + cs.forceNodeColor + cs.forceLinkColor * 3) % 2000000000;
            if (cs.labelShow) { h = (h * 31 + 13) % 2000000000; }
            if (rs.hidden) { h = (h * 31 + 7) % 2000000000; }
            for (int v = 0; v < cs.Count(); v = v + 1) {
                h = (h * 31 + cs.Value(v)) % 2000000000;
            }
            for (int di = 0; di < cs.data.Count; di = di + 1) {
                if (cs.data[di].color != 0) {
                    h = (h * 31 + cs.data[di].color) % 2000000000;
                }
                if (cs.data[di].sizeSet) {
                    h = (h * 31 + 29 + cs.data[di].size) % 2000000000;
                }
            }
            for (int li = 0; li < cs.links.Count; li = li + 1) {
                h = ChartView.FoldStr(h, cs.links[li].from, 13);
                h = ChartView.FoldStr(h, cs.links[li].to, 14);
                h = (h * 31 + cs.links[li].val) % 2000000000;
            }
            for (int pi = 0; pi < cs.points.Count; pi = pi + 1) {
                h = (h * 31 + cs.points[pi].x + cs.points[pi].y
                    + cs.points[pi].color) % 2000000000;
                if (cs.points[pi].sizeSet) {
                    h = (h * 31 + 31 + cs.points[pi].size) % 2000000000;
                }
            }
            for (int ci = 0; ci < cs.candles.Count; ci = ci + 1) {
                h = (h * 31 + cs.candles[ci].open + cs.candles[ci].high
                    + cs.candles[ci].low + cs.candles[ci].close) % 2000000000;
            }
            for (int bi = 0; bi < cs.bubbles.Count; bi = bi + 1) {
                h = (h * 31 + cs.bubbles[bi].x + cs.bubbles[bi].y + cs.bubbles[bi].weight) % 2000000000;
            }
            for (int xi = 0; xi < cs.boxes.Count; xi = xi + 1) {
                h = ChartView.FoldStr(h, cs.boxes[xi].label, 15);
                h = (h * 31 + cs.boxes[xi].lo + cs.boxes[xi].q1
                    + cs.boxes[xi].med + cs.boxes[xi].q3 + cs.boxes[xi].hi) % 2000000000;
            }
            for (int ei = 0; ei < cs.errors.Count; ei = ei + 1) {
                h = ChartView.FoldStr(h, cs.errors[ei].label, 16);
                h = (h * 31 + cs.errors[ei].y + cs.errors[ei].err) % 2000000000;
            }
            for (int ti = 0; ti < cs.tree.Count; ti = ti + 1) {
                h = ChartView.FoldStr(h, cs.tree[ti].name, 17);
                h = (h * 31 + cs.tree[ti].Total()) % 2000000000;
                // 力导向逐节点形状（series.tree 携带）改像素，入指纹。
                h = ChartView.FoldStr(h, cs.tree[ti].symbol, 22);
                h = (h * 31 + cs.tree[ti].size) % 2000000000;
            }
            for (int vi = 0; vi < cs.events.Count; vi = vi + 1) {
                h = ChartView.FoldStr(h, cs.events[vi].name, 18);
                h = (h * 31 + cs.events[vi].start + cs.events[vi].end
                    + cs.events[vi].value) % 2000000000;
            }
            for (int gi = 0; gi < cs.regions.Count; gi = gi + 1) {
                h = ChartView.FoldStr(h, cs.regions[gi].name, 19);
                h = (h * 31 + cs.regions[gi].value
                    + cs.regions[gi].rings.Count) % 2000000000;
            }
            for (int mi = 0; mi < cs.marks.Count; mi = mi + 1) {
                h = ChartView.FoldStr(h, cs.marks[mi].kind, 20);
                h = (h * 31 + cs.marks[mi].dataIndex
                    + cs.marks[mi].xValue + cs.marks[mi].yValue) % 2000000000;
            }
            for (int mi2 = 0; mi2 < cs.markLines.Count; mi2 = mi2 + 1) {
                h = ChartView.FoldStr(h, cs.markLines[mi2].kind, 24);
                h = (h * 31 + cs.markLines[mi2].yValue
                    + cs.markLines[mi2].xValue) % 2000000000;
                h = ChartView.FoldStr(h, cs.markLines[mi2].lineType, 25);
            }
            h = (h * 31 + cs.gauge.min + cs.gauge.max + cs.gauge.precision
                + cs.gauge.splitNumber + cs.gauge.innerRadius.amount) % 2000000000;
        }
        if (o.zoom) {
            h = (h * 31 + zoomLo) % 2000000000;
            h = (h * 31 + zoomHi) % 2000000000;
        }
        return h;
    }

    /// 第一个可见序列（整图系列族从中选取布局
    /// 标志位 —— innerPct、roseType、sort、hbar、custom）。
    static ChartSeries LeadSeries(ChartOption o) {
        if (o.series.Count < 1) { return null; }
        for (int i = 0; i < o.series.Count; i = i + 1) {
            if (!o.series[i].hidden) { return o.series[i]; }
        }
        return o.series[0];
    }

    static int LeadSeriesIndex(ChartOption o) {
        if (o == null || o.series.Count < 1) { return 0 - 1; }
        for (int i = 0; i < o.series.Count; i = i + 1) {
            if (!o.series[i].hidden) { return i; }
        }
        return 0;
    }

    static int SeriesIndexOf(ChartOption o, ChartSeries target) {
        if (o == null || target == null) { return 0 - 1; }
        for (int i = 0; i < o.series.Count; i = i + 1) {
            if (o.series[i] == target) { return i; }
        }
        return 0 - 1;
    }

    /// 主导图表族：第一个可见序列的类型（
    /// 整图系列族 —— pie、gauge、heatmap 等 —— 从中选择布局，
    /// 笛卡尔系列族则逐序列混用）。全部隐藏时仍用首条系列类型，
    /// 保留坐标轴/图例，而不是整图变成空状态。
    static ChartType LeadType(ChartOption o) {
        for (int i = 0; i < o.series.Count; i = i + 1) {
            if (!o.series[i].hidden) { return o.series[i].type; }
        }
        if (o.series.Count > 0) { return o.series[0].type; }
        return ChartType.Line;
    }

    /// 渲染器分发键：每个 ChartType 和 custom kind 都映射到
    /// 一个显式渲染器；没有未知类型回退为折线图。
    /// 未知/空 kind 返回 "empty"（渲染明确的空状态）。
    /// 这是 chart_kinds_complete 测试的确定性锚点。
    static string DispatchKind(ChartOption o) {
        // 无系列才画空状态。图例关掉最后一条系列时仍按原类型
        // 分发，只是渲染器跳过隐藏序列（坐标轴/图例还在）。
        if (o.series.Count < 1) { return "empty"; }
        ChartType t = ChartView.LeadType(o);
        ChartSeries leadS = ChartView.LeadSeries(o);
        if (t == ChartType.Pie) {
            if (leadS != null && leadS.roseType.Length > 0) { return "rose"; }
            return "pie";
        }
        if (t == ChartType.Gauge) { return "gauge"; }
        if (t == ChartType.Heatmap) { return "heatmap"; }
        if (t == ChartType.WordCloud) { return "wordCloud"; }
        if (t == ChartType.Radar) { return "radar"; }
        if (t == ChartType.Funnel) { return "funnel"; }
        if (t == ChartType.Treemap) { return "treemap"; }
        if (t == ChartType.Tree) { return "tree"; }
        if (t == ChartType.K) { return "k"; }
        if (t == ChartType.Chord) { return "chord"; }
        if (t == ChartType.Force) { return "force"; }
        if (t == ChartType.Map) { return "map"; }
        if (t == ChartType.EventRiver) { return "eventRiver"; }
        if (t == ChartType.Custom) {
            string ck = "";
            if (leadS != null) { ck = leadS.custom; }
            if (ck == "sankey") { return "sankey"; }
            if (ck == "box") { return "box"; }
            if (ck == "error") { return "error"; }
            if (ck == "waterfall") { return "waterfall"; }
            if (ck == "sunburst") { return "sunburst"; }
            if (ck == "radialBars") { return "radialBars"; }
            if (ck == "venn") { return "venn"; }
            return "empty";
        }
        if (t == ChartType.Bar) {
            bool stacked = (leadS != null && leadS.stack != 0);
            bool hbar = (leadS != null && leadS.hbar);
            if (stacked && hbar) { return "barStackedHbar"; }
            if (stacked) { return "barStacked"; }
            if (hbar) { return "hbar"; }
            return "bar";
        }
        if (t == ChartType.Scatter) {
            if (leadS != null && leadS.bubbles.Count > 0) { return "bubbles"; }
            return "scatter";
        }
        // 点系列（OfPoints / JSON 的 data:[[x,y],...]）带 Line 类型：
        // ECharts line7 双数值轴——连线画在散点空间里，x 与 y 都按
        // 数值映射。特征是 data 为空而 points 非空；分类轴折线
        // 渲染器只读 data，会缩放成默认 0-5 空轴、什么都不画。
        // DrawScatterCore 把 Line 类型的点系列画成折线，
        // ScatterHover 提示 x/y 数值。
        if (leadS != null && leadS.data.Count == 0
            && leadS.points.Count > 0) {
            return "scatter";
        }
        // 折线族：堆叠的引导序列渲染累计填充带，其余绘制折线。
        if (leadS != null && leadS.stack != 0) { return "stackedArea"; }
        return "lines";
    }

    /// 未知 / 空 kind 的明确空状态：不绘制错误的图表。
    static void DrawEmptyState(App app, int x, int y, int w, int h, ChartOption o) {
        Theme t = app.theme;
        StyleBox sPanel = Style.Full(app, "chart", "", "", Style.SNormal());
        app.canvas.SurfaceRoundRect(x, y, w, h, t.borderRadiusMedium, sPanel.BgOr(0), sPanel.BorderOr(0), 1);
        if (o.title.Length > 0) {
            app.canvas.DrawText(x + t.paddingMedium, y + t.paddingMedium,
                o.title, sPanel.FgOr(0), Style.FontFallback(app, "large"));
        }
        string msg = "(no data)";
        int mw = Canvas.MeasureText(msg, Style.FontFallback(app, "small"));
        app.canvas.DrawText(x + w / 2 - mw / 2,
            Canvas.CenterTextYAt(y + h / 2, Style.FontFallback(app, "small")),
            msg, Style.Part(app, "chart", "hint", "", "", "", Style.SNormal()).FgOr(0),
            Style.FontFallback(app, "small"));
    }

    static void DrawStatusState(App app, int x, int y, int w, int h,
                                string status, string message) {
        if (status == "ready") { return; }
        Theme t = app.theme;
        StyleBox panel = Style.Full(app, "chart", "", "", Style.SNormal());
        int bg = panel.BgOr(0);
        int fg = panel.FgOr(0);
        if (status == "loading") { bg = 0xCCFFFFFF; }
        if (status == "error") { fg = 0xFFC0392B; }
        app.canvas.SurfaceRoundRect(x, y, w, h, t.borderRadiusMedium, bg,
            panel.BorderOr(0), 1);
        string msg = message;
        if (msg.Length == 0) {
            if (status == "loading") { msg = "Loading..."; }
            else if (status == "empty") { msg = "(no data)"; }
            else if (status == "error") { msg = "Chart error"; }
            else { msg = "(disposed)"; }
        }
        int fs = Style.FontFallback(app, "small");
        int mw = Canvas.MeasureText(msg, fs);
        app.canvas.DrawText(x + w / 2 - mw / 2,
            Canvas.CenterTextYAt(y + h / 2, fs), msg, fg, fs);
    }

    /// 任一序列为面积线时返回 true（对应 ECharts line.areaStyle.show）。
    static bool HasArea(ChartOption o) {
        for (int i = 0; i < o.series.Count; i = i + 1) {
            if (o.series[i].areaStyle) {
                return true;
            }
        }
        return false;
    }

    /// 折线族类型以折线绘制（可选填充 / 阶梯 /
    /// 堆叠 —— 目前均为 Line 类型；它们是序列的子实体）。
    static bool IsLineFamily(ChartType t) {
        return t == ChartType.Line;
    }

    /// 柱状族类型占据一个柱位（分组 / 堆叠 / 水平）。
    static bool IsBarFamily(ChartType t) {
        return t == ChartType.Bar;
    }

    /// 堆叠组名称的索引，无则 -1（柱状图按 stackName 分组）。
    static int GroupIndex(List<string> groups, string name) {
        for (int i = 0; i < groups.Count; i = i + 1) {
            if (groups[i] == name) { return i; }
        }
        return 0 - 1;
    }

    void Render(App app, int x, int y, int w, int h) {
        if (this.disposed) { return; }
        bool resized = this.hasRendered && (this.lastRenderW != w || this.lastRenderH != h);
        bool updated = false;
        if (this.controller != null) {
            int cv = this.controller.Version();
            updated = this.hasRendered && cv != this.lastControllerVersion;
            ChartOption current = this.controller.Option();
            // Controller.Dispose() 清空其 option，但 view 仍可把最后一帧
            // 作为背景绘出，并由状态层显示 disposed，而不是把 null
            // 传给 resolved/layout。
            if (current != null) { this.sourceOption = current; }
        } else {
            updated = this.hasRendered && this.directVersion != this.lastDirectVersion;
        }
        if (this.sourceOption == null) { this.sourceOption = ChartOption.Create(); }
        Theme t = app.theme;
        this.resolved = ResolvedChart.Resolve(this.sourceOption, t, app, wid);
        bool animate = this.resolved.animate;
        if (this.staticFrame) { animate = false; }
        string kind0 = ChartView.DispatchKind(this.sourceOption);
        if (kind0 == "map" || kind0 == "heatmap" || kind0 == "wordCloud"
            || kind0 == "force" || kind0 == "treemap") {
            animate = false;
        }
        if (this.sourceOption.backgroundColor != 0) {
            app.canvas.FillRect(x, y, w, h, this.sourceOption.backgroundColor);
        }

        int g = 1000;
        if (animate) {
            g = app.AnimIntroIn(5000000 + wid, this.sourceOption.animMs,
                                x, y, w, h);
        }

        ChartOption drawOption = this.resolved.DrawOption(wid, animate);
        if (app.StateGet(Chart.TbZoomKey(wid), 0) != 0) { drawOption.zoom = true; }
        ChartView.ApplyMagic(drawOption, app.StateGet(Chart.TbMagicKey(wid), 0));
        // connect() 联动：drawOption.iwid 已是组共享基址（组长 wid，
        // 由 Resolve 期登记），渲染器的全部交互键同帧落到组键上。
        option = drawOption;
        Chart.toolReserve = 0;
        Chart.legendOpt = drawOption;   // 图例 orient/selectedMode/formatter 的帧内来源
        if (drawOption.toolboxShow) {
            Chart.toolReserve = ChartToolbox.Width(app, drawOption);
        }
        // dataRange 条固定在控件底部：分派前把高度扣掉，面板与
        // 绘图区只在剩余矩形里布局（同 toolReserve 的帧内约定）。
        int drH = ChartViewDataRange.Height(app, drawOption);
        int innerH = h - drH;
        if (drH > 0 && innerH < app.Scale(80)) { drH = 0; innerH = h; }

        // 把每种图表裁剪到自己的矩形，防止绘图线、柱条、
        // 轴标签和图例溢出到相邻控件。
        ChartView.activeEventView = this;
        this.currentHit = null;
        string pointerKind = ChartView.DispatchKind(drawOption);
        bool selectionSurface = (pointerKind == "pie" || pointerKind == "rose")
            ? drawOption.iwid != 0
            : (pointerKind == "map" && drawOption.mapSelect && drawOption.iwid != 0);
        if (this.eventHitId < 0 && (ChartView.HasInteraction(this, ChartEventType.Click)
            || ChartView.HasInteraction(this, ChartEventType.DoubleClick)
            || ChartView.HasInteraction(this, ChartEventType.Hover)
            || ChartView.HasInteraction(this, ChartEventType.MouseOut)
            || ChartView.HasInteraction(this, ChartEventType.PieSelected)
            || ChartView.HasInteraction(this, ChartEventType.MapSelected)
            || selectionSurface)) {
            // 独立高位段，不随即时模式控件的分配顺序漂移。
            this.eventHitId = 9700000 + this.wid;
        }
        if (this.eventHitId >= 0 && this.Status() == "ready") {
            // 根命中区放在所有 renderer 之前；系列、图例和工具箱
            // 后续注册的区域优先，未被更具体区域命中的空白点击
            // 才到达图表级 Click。
            app.hitTester.RegisterRect(this.eventHitId, x, y, w, h, 0);
        }
        app.canvas.PushClip(x, y, w, h);
        this.DispatchRender(app, x, y, w, innerH, g);
        if (drH > 0) {
            ChartViewDataRange.Draw(app, x, y + innerH, w, drH, drawOption);
        }
        app.canvas.PopClip();

        // ECharts 工具箱：右上角。o.toolboxShow 关闭时不画。
        if (drawOption.toolboxShow) {
            ChartView.DrawToolbox(app, x, y, w, h, this.wid, drawOption);
            ChartView.FlushToolboxSave(app, this.wid);
        }
        ChartView.DrawStatusState(app, x, y, w, h,
            this.Status(), this.StatusMessage());

        string statusNow = this.Status();
        this.DispatchPointerEvents(app, x, y, w, h, statusNow);
        int zlo = statusNow == "ready"
            ? app.StateGet(Chart.ZoomLoKey(this.wid), 0) : 0;
        int zhi = statusNow == "ready"
            ? app.StateGet(Chart.ZoomHiKey(this.wid), 1000) : 1000;
        if (this.lastZoomLo >= 0 && (zlo != this.lastZoomLo || zhi != this.lastZoomHi)) {
            ChartInteractionEvent ze = ChartInteractionEvent.Of(
                ChartEventType.DataZoom, this.wid);
            ze.zoomStart = zlo;
            ze.zoomEnd = zhi;
            ze.x = app.mouseX;
            ze.y = app.mouseY;
            this.RaiseInteraction(ze);
        }
        this.lastZoomLo = zlo;
        this.lastZoomHi = zhi;
        if (resized && this.Resized.Count() > 0) { this.Resized.Raise(); }
        if (resized) {
            ChartInteractionEvent re = ChartView.EventAt(
                ChartEventType.Resize, this.wid, w, h);
            this.RaiseInteraction(re);
        }
        if (updated && this.Updated.Count() > 0) { this.Updated.Raise(); }
        if (updated && this.controller == null) {
            ChartInteractionEvent ue = ChartInteractionEvent.Of(
                ChartEventType.DataChanged, this.wid);
            this.RaiseInteraction(ue);
        }
        if (updated && this.controller != null) {
            ChartInteractionEvent ue2 = ChartInteractionEvent.Of(
                ChartEventType.DataChanged, this.wid);
            this.RaiseLocal(ue2);
        }
        if (this.Rendered.Count() > 0) { this.Rendered.Raise(); }
        this.lastRenderW = w;
        this.lastRenderH = h;
        if (this.controller != null) { this.lastControllerVersion = this.controller.Version(); }
        else { this.lastDirectVersion = this.directVersion; }
        this.hasRendered = true;
        ChartView.activeEventView = null;
    }

    /// connect() 组交互键重定向：组内第一张到达的图把「组长 wid」
    /// 记到组登记键（ConnectGroupKey(groupId)），组内所有图（含
    /// 组长自己）的交互态键都以组长 wid 为基——任意一张图里改的
    /// dataZoom 窗口/图例开关/悬停类别，组内其余图同帧读到。
    /// 未入组（group == 0）返回图自己的 wid（无联动）。
    /// 主路径在 ResolvedChart.Resolve（stateWid）；此处保留给无
    /// Resolve 的轻量调用方。
    static int ConnectedWid(App app, int wid, int group) {
        if (group == 0 || wid == 0) { return wid; }
        int gk = Chart.ConnectGroupKey(group);
        int leader = app.StateGet(gk, 0);
        if (leader == 0) {
            app.StateSet(gk, wid);
            app.StateSet(Chart.ConnectHoverKey(wid), 0 - 1);
            return wid;
        }
        return leader;
    }

    static void ApplyMagic(ChartOption o, int magic) {
        if (magic != 1 && magic != 2) { return; }
        ChartType t = ChartType.Line;
        if (magic == 2) { t = ChartType.Bar; }
        for (int i = 0; i < o.series.Count; i = i + 1) {
            ChartSeries s = o.series[i];
            if (s.type == ChartType.Line || s.type == ChartType.Bar) {
                s.type = t;
                if (t == ChartType.Bar) { s.areaStyle = false; }
            }
        }
    }

    /// 显式分发：每个 kind 都有一个明确的分支。没有未知
    /// kind 回退为折线图；未知/空 kind 绘制明确空状态。
    void DispatchRender(App app, int x, int y, int w, int h, int g) {
        ChartOption option = this.option;
        string kind = ChartView.DispatchKind(option);
        ChartSeries leadS = ChartView.LeadSeries(option);
        if (kind == "pie") {
            ChartView.DrawPie(app, x, y, w, h, option, option.pieLabels, g);
        } else if (kind == "rose") {
            ChartView.DrawRose(app, x, y, w, h, option, g);
        } else if (kind == "gauge") {
            ChartView.DrawGauge(app, x, y, w, h, option, g);
        } else if (kind == "heatmap") {
            ChartView.DrawHeatmap(app, x, y, w, h, option, g);
        } else if (kind == "wordCloud") {
            ChartView.DrawWordCloud(app, x, y, w, h, option, g);
        } else if (kind == "radar") {
            ChartView.DrawPolar(app, x, y, w, h, option, g);
        } else if (kind == "funnel") {
            bool pyramid = false;
            if (leadS != null && leadS.sort == "ascending") { pyramid = true; }
            ChartView.DrawFunnel(app, x, y, w, h, option, g, pyramid);
        } else if (kind == "treemap") {
            ChartView.DrawTreemap(app, x, y, w, h, option, g);
        } else if (kind == "tree") {
            ChartView.DrawTree(app, x, y, w, h, option, g);
        } else if (kind == "k") {
            ChartView.DrawCandles(app, x, y, w, h, option, g);
        } else if (kind == "chord") {
            ChartView.DrawChord(app, x, y, w, h, option, g);
        } else if (kind == "force") {
            ChartView.DrawForce(app, x, y, w, h, option, g);
        } else if (kind == "map") {
            ChartView.DrawMap(app, x, y, w, h, option, g);
        } else if (kind == "eventRiver") {
            ChartView.DrawEventRiver(app, x, y, w, h, option, g);
        } else if (kind == "sankey") {
            ChartView.DrawSankey(app, x, y, w, h, option, g);
        } else if (kind == "box") {
            ChartView.DrawBox(app, x, y, w, h, option, g);
        } else if (kind == "error") {
            ChartView.DrawError(app, x, y, w, h, option, g);
        } else if (kind == "waterfall") {
            ChartView.DrawWaterfall(app, x, y, w, h, option, g);
        } else if (kind == "sunburst") {
            ChartView.DrawSunburst(app, x, y, w, h, option, g);
        } else if (kind == "radialBars") {
            ChartView.DrawRadialBars(app, x, y, w, h, option, g);
        } else if (kind == "venn") {
            ChartView.DrawVenn(app, x, y, w, h, option, g);
        } else if (kind == "bar" || kind == "hbar"
                   || kind == "barStacked" || kind == "barStackedHbar") {
            bool stacked = kind == "barStacked" || kind == "barStackedHbar";
            bool hbar = kind == "hbar" || kind == "barStackedHbar";
            ChartView.DrawBars(app, x, y, w, h, option, g, stacked, hbar);
        } else if (kind == "scatter") {
            ChartView.DrawScatter(app, x, y, w, h, option, g);
        } else if (kind == "bubbles") {
            ChartView.DrawBubbles(app, x, y, w, h, option, g);
        } else if (kind == "stackedArea") {
            ChartView.DrawStackedArea(app, x, y, w, h, option, g);
        } else if (kind == "lines") {
            ChartView.DrawLines(app, x, y, w, h, option, g);
        } else {
            ChartView.DrawEmptyState(app, x, y, w, h, option);
        }
    }
}
