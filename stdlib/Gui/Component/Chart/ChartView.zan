using System;
using System.Json;
using Gui;

namespace Gui.Component.Chart;

/// Componentized, animated chart control (the modern face of the Chart widget).
/// Bind a ChartOption once (ECharts-style: title + axes + series, where every
/// series carries its own type), then call Render each frame. It plays a
/// grow-in intro, draws gradient/smoothed series and an optional hover
/// crosshair + value tooltip. Multi-level control mirrors ECharts: option.*
/// (global) < series.* (per series) < data[i].* (per item), so mixed charts are
/// just series of different types sharing one coordinate system.
partial class ChartView {
    ChartOption option;
    // Stable per-chart animation key. Defaults to a fresh WidgetId, but callers
    // in an immediate-mode / virtualized list (where widget-id order churns as
    // rows scroll in and out) should pass a caller-owned stable key via Keyed()
    // so the grow-in intro is not re-seeded to 0 every frame.
    int wid;

    // Last hover-hit for the hierarchical charts (treemap/sunburst). Set by the
    // hit-trace helpers and read immediately by the caller to draw the tooltip,
    // so it never survives across frames.
    static string ttName;
    static int ttVal;
    static int ttX;        // treemap: hit cell rect
    static int ttY;
    static int ttW;
    static int ttH;
    static int ttA0;       // sunburst: hit sector sweep + ring depth
    static int ttA1;
    static int ttDepth;

    static ChartView Of(ChartOption o) {
        ChartView v = new ChartView();
        v.option = o;
        v.wid = WidgetId.Next();
        return v;
    }

    /// Bind an option with a caller-owned stable animation key.
    static ChartView Keyed(ChartOption o, int key) {
        ChartView v = new ChartView();
        v.option = o;
        v.wid = key;
        return v;
    }

    // Dynamic snapshot-slot allocator for RenderCached: the runtime pool grows
    // on demand (ZAN_SNAP_CACHE_MAX_SLOTS = 512), so any number of cached
    // charts can coexist; a caller that embeds charts in cells that scroll away
    // should ReleaseCached(slot) to hand the pixel buffers back.
    static int cacheSeq = 16;
    static int AllocCacheSlot() {
        int s = ChartView.cacheSeq;
        ChartView.cacheSeq = ChartView.cacheSeq + 1;
        if (s >= 512) { ChartView.cacheSeq = 16; s = 16; }
        return s;
    }

    /// Release the pixel buffer a RenderCached slot owns (call when the region
    /// leaves the viewport, e.g. a grid cell scrolled away). The slot may be
    /// reused later -- the fingerprint key is per-slot, so a stale snapshot
    /// simply misses and re-renders.
    static void ReleaseCached(Canvas c, int slot) {
        c.ReleaseSlot(slot);
    }

    /// Cached-region render for static charts with heavy raster cost (heatmaps,
    /// dense series): the first call paints the final form (animation off) into
    /// snapshot slot 0-7 and records a data fingerprint; later calls restore the
    /// cached pixels with a single copy instead of re-rasterizing, so a
    /// 100x50 heatmap costs O(region) per frame instead of O(cells).
    /// The cache self-invalidates on any data / visibility / zoom / theme /
    /// geometry change (fingerprint compare + geometry match). Hover feedback
    /// (e.g. HeatmapHover) is drawn by the caller *after* a hit so tooltips
    /// stay live. Returns true when the frame was served from cache.
    static bool RenderCached(App app, ChartOption o, int slot,
                             int x, int y, int w, int h) {
        Canvas c = app.canvas;
        // Stable interaction id derived from the slot, so the dataZoom window
        // state read by the fingerprint matches the one the renderer reads.
        int zwid = 300000 + slot;
        o.iwid = zwid;
        int fp = ChartView.CacheFingerprint(app, o);
        if (app.StateGet(Chart.CacheKey(slot), 0) == fp
            && c.RestoreRect(x, y, w, h, slot)) {
            return true;
        }
        bool anim = o.animate;
        o.animate = false;               // the snapshot is always the final form
        ChartView.Keyed(o, zwid).Render(app, x, y, w, h);
        o.animate = anim;
        c.SnapshotRect(x, y, w, h, slot);
        app.StateSet(Chart.CacheKey(slot), fp);
        return false;
    }

    /// Data fingerprint for RenderCached: series values + type/axis/hidden,
    /// the dataZoom window and the active theme. Anything that changes the
    /// pixels invalidates the cached snapshot; hover position deliberately does
    /// not (it is drawn on top after a cache hit).
    static int CacheFingerprint(App app, ChartOption o) {
        int h = app.ThemeMenuIndex() * 7919;
        h = (h * 31 + o.series.Count) % 2000000000;
        for (int s = 0; s < o.series.Count; s = s + 1) {
            ChartSeries cs = o.series[s];
            h = (h * 31 + cs.type + cs.axisIndex + cs.name.Length * 3) % 2000000000;
            if (cs.hidden) { h = (h * 31 + 7) % 2000000000; }
            for (int v = 0; v < cs.Count(); v = v + 1) {
                h = (h * 31 + cs.Value(v)) % 2000000000;
            }
        }
        if (o.zoom) {
            h = (h * 31 + app.StateGet(Chart.ZoomLoKey(o.iwid), 0)) % 2000000000;
            h = (h * 31 + app.StateGet(Chart.ZoomHiKey(o.iwid), 1000)) % 2000000000;
        }
        return h;
    }

    /// The first visible series (the whole-chart families pick their layout
    /// flags — innerPct, roseType, sort, hbar, custom — from it).
    static ChartSeries LeadSeries(ChartOption o) {
        if (o.series.Count < 1) { return null; }
        for (int i = 0; i < o.series.Count; i = i + 1) {
            if (!o.series[i].hidden) { return o.series[i]; }
        }
        return o.series[0];
    }

    /// The dominant chart family: the type of the first visible series (the
    /// whole-chart families — pie, gauge, heatmap, ... — pick their layout from
    /// it; cartesian families mix per series).
    static ChartType LeadType(ChartOption o) {
        for (int i = 0; i < o.series.Count; i = i + 1) {
            if (!o.series[i].hidden) { return o.series[i].type; }
        }
        return ChartType.Line;
    }

    /// True when any series is a filled line (ECharts line.areaStyle.show).
    static bool HasArea(ChartOption o) {
        for (int i = 0; i < o.series.Count; i = i + 1) {
            if (o.series[i].areaStyle) {
                return true;
            }
        }
        return false;
    }

    /// Line-family types draw as polylines (optionally filled / stepped /
    /// stacked — all Line type now; those are series sub-entities).
    static bool IsLineFamily(ChartType t) {
        return t == ChartType.Line;
    }

    /// Bar-family types occupy a bar slot (grouped / stacked / horizontal).
    static bool IsBarFamily(ChartType t) {
        return t == ChartType.Bar;
    }

    /// Index of a stack group name, or -1 (stackName grouping for bars).
    static int GroupIndex(List<string> groups, string name) {
        for (int i = 0; i < groups.Count; i = i + 1) {
            if (groups[i] == name) { return i; }
        }
        return 0 - 1;
    }

    void Render(App app, int x, int y, int w, int h) {
        Theme t = app.theme;
        // Resolve auto (0) series colors from the palette so JSON/model data
        // that omits colors still renders a distinct hue per series.
        for (int i = 0; i < option.series.Count; i = i + 1) {
            if (option.series[i].color == 0) {
                option.series[i].color = Chart.Palette(t, i);
            }
        }

        int g = 1000;
        if (option.animate) { g = app.AnimIntro(5000000 + wid, option.animMs); }

        // Publish the stable interaction key so DrawPanel can wire an
        // interactive legend (click a swatch to show/hide that series).
        option.iwid = wid;

        // Clip every chart kind to its own rectangle so plot lines, bars,
        // axis labels and legends can never bleed into a neighbouring widget.
        app.canvas.PushClip(x, y, w, h);
        ChartType lead = ChartView.LeadType(option);
        ChartSeries leadS = ChartView.LeadSeries(option);
        if (lead == ChartType.Pie) {
            int inner = 0;
            if (leadS != null) { inner = leadS.innerPct; }
            if (leadS != null && leadS.roseType.Length > 0) {
                ChartView.DrawRose(app, x, y, w, h, option, g);
            } else {
                ChartView.DrawPie(app, x, y, w, h, option, inner, option.pieLabels, g);
            }
        } else if (lead == ChartType.Gauge) {
            ChartView.DrawGauge(app, x, y, w, h, option, g);
        } else if (lead == ChartType.Heatmap) {
            ChartView.DrawHeatmap(app, x, y, w, h, option, g);
        } else if (lead == ChartType.WordCloud) {
            ChartView.DrawWordCloud(app, x, y, w, h, option, g);
        } else if (lead == ChartType.Radar) {
            ChartView.DrawPolar(app, x, y, w, h, option, g);
        } else if (lead == ChartType.Funnel) {
            bool pyramid = false;
            if (leadS != null && leadS.sort == "ascending") { pyramid = true; }
            ChartView.DrawFunnel(app, x, y, w, h, option, g, pyramid);
        } else if (lead == ChartType.Treemap) {
            ChartView.DrawTreemap(app, x, y, w, h, option, g);
        } else if (lead == ChartType.Tree) {
            ChartView.DrawTree(app, x, y, w, h, option, g);
        } else if (lead == ChartType.K) {
            ChartView.DrawCandles(app, x, y, w, h, option, g);
        } else if (lead == ChartType.Custom) {
            string ck = "";
            if (leadS != null) { ck = leadS.custom; }
            if (ck == "sankey") {
                ChartView.DrawSankey(app, x, y, w, h, option, g);
            } else if (ck == "box") {
                ChartView.DrawBox(app, x, y, w, h, option, g);
            } else if (ck == "error") {
                ChartView.DrawError(app, x, y, w, h, option, g);
            } else if (ck == "waterfall") {
                ChartView.DrawWaterfall(app, x, y, w, h, option, g);
            } else if (ck == "sunburst") {
                ChartView.DrawSunburst(app, x, y, w, h, option, g);
            } else if (ck == "radialBars") {
                ChartView.DrawRadialBars(app, x, y, w, h, option, g);
            } else {
                ChartView.DrawLines(app, x, y, w, h, option, g);
            }
        } else if (lead == ChartType.Bar) {
            bool stacked = false;
            bool hbar = false;
            if (leadS != null) {
                stacked = (leadS.stack != 0);
                hbar = leadS.hbar;
            }
            ChartView.DrawBars(app, x, y, w, h, option, g, stacked, hbar);
        } else if (lead == ChartType.Scatter) {
            bool bubbles = false;
            if (leadS != null) { bubbles = (leadS.bubbles.Count > 0); }
            if (bubbles) {
                ChartView.DrawBubbles(app, x, y, w, h, option, g);
            } else {
                ChartView.DrawScatter(app, x, y, w, h, option, g);
            }
        } else {
            // Line family. A stacked lead renders cumulative filled bands
            // (ECharts line + stack); anything else draws plain lines.
            bool stacked = false;
            if (leadS != null) { stacked = (leadS.stack != 0); }
            if (stacked) {
                ChartView.DrawStackedArea(app, x, y, w, h, option, g);
            } else {
                ChartView.DrawLines(app, x, y, w, h, option, g);
            }
        }
        app.canvas.PopClip();
    }
}
