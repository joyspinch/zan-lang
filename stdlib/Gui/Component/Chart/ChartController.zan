using System;

namespace Gui.Component.Chart;

/// ChartOption 的可变持有者。用于立即模式 GUI 中的动态数据：
/// 控件可以每帧重新绑定同一个 controller，而不需要重建 ChartView。
class ChartController {
    ChartOption option;
    ChartOption initialOption;
    int version;
    string status;
    string statusMessage;
    bool disposed;
    ChartEventHub eventHub;

    static ChartController Of(ChartOption option) {
        ChartController c = new ChartController();
        if (option == null) { option = ChartOption.Create(); }
        c.option = option;
        c.initialOption = ChartOption.Clone(option);
        c.version = 1;
        c.status = "ready";
        c.statusMessage = "";
        c.disposed = false;
        c.eventHub = new ChartEventHub();
        return c;
    }

    ChartOption Option() { return this.option; }
    /// 返回当前 option 的深复制，调用方不能通过返回值改写 controller。
    ChartOption GetOption() { return ChartOption.Clone(this.option); }
    int Version() { return this.version; }
    string Status() { return this.status; }
    string StatusMessage() { return this.statusMessage; }
    bool IsDisposed() { return this.disposed; }

    ChartController On(ChartEventType type, ChartInteractionHandler handler) {
        if (!this.disposed) { this.eventHub.On(type, handler); }
        return this;
    }

    ChartController Off(ChartEventType type, ChartInteractionHandler handler) {
        if (!this.disposed) { this.eventHub.Off(type, handler); }
        return this;
    }

    ChartController ClearEvents() {
        if (!this.disposed) { this.eventHub.Clear(); }
        return this;
    }

    void RaiseEvent(ChartInteractionEvent eventArgs) {
        if (!this.disposed && this.eventHub != null) {
            this.eventHub.Raise(eventArgs);
        }
    }

    void RaiseType(ChartEventType type) {
        this.RaiseEvent(ChartInteractionEvent.Of(type, 0));
    }

    ChartController OnClick(ChartInteractionHandler handler) {
        return this.On(ChartEventType.Click, handler);
    }
    ChartController OnDoubleClick(ChartInteractionHandler handler) {
        return this.On(ChartEventType.DoubleClick, handler);
    }
    ChartController OnHover(ChartInteractionHandler handler) {
        return this.On(ChartEventType.Hover, handler);
    }
    ChartController OnMouseOut(ChartInteractionHandler handler) {
        return this.On(ChartEventType.MouseOut, handler);
    }
    ChartController OnLegendSelected(ChartInteractionHandler handler) {
        return this.On(ChartEventType.LegendSelected, handler);
    }
    ChartController OnPieSelected(ChartInteractionHandler handler) {
        return this.On(ChartEventType.PieSelected, handler);
    }
    ChartController OnMapSelected(ChartInteractionHandler handler) {
        return this.On(ChartEventType.MapSelected, handler);
    }
    ChartController OnMapRoam(ChartInteractionHandler handler) {
        return this.On(ChartEventType.MapRoam, handler);
    }
    ChartController OnTimelineChanged(ChartInteractionHandler handler) {
        return this.On(ChartEventType.TimelineChanged, handler);
    }
    ChartController OnMagicTypeChanged(ChartInteractionHandler handler) {
        return this.On(ChartEventType.MagicTypeChanged, handler);
    }
    ChartController OnRefresh(ChartInteractionHandler handler) {
        return this.On(ChartEventType.Refresh, handler);
    }
    ChartController OnForceLayoutEnd(ChartInteractionHandler handler) {
        return this.On(ChartEventType.ForceLayoutEnd, handler);
    }
    ChartController OnDataZoom(ChartInteractionHandler handler) {
        return this.On(ChartEventType.DataZoom, handler);
    }
    ChartController OnDataRange(ChartInteractionHandler handler) {
        return this.On(ChartEventType.DataRange, handler);
    }
    ChartController OnRestore(ChartInteractionHandler handler) {
        return this.On(ChartEventType.Restore, handler);
    }
    ChartController OnDataChanged(ChartInteractionHandler handler) {
        return this.On(ChartEventType.DataChanged, handler);
    }

    /// 替换整个 option，保留 controller 身份与图表交互键；显式
    /// SetOption 同时成为 Restore() 的新基线。
    ChartController SetOption(ChartOption next) {
        if (this.disposed) { return this; }
        if (next != null) {
            this.option = next;
            this.initialOption = ChartOption.Clone(next);
        }
        this.status = "ready";
        this.statusMessage = "";
        this.version = this.version + 1;
        ChartInteractionEvent e = ChartInteractionEvent.Of(
            ChartEventType.DataChanged, 0);
        this.RaiseEvent(e);
        return this;
    }

    /// 替换一个系列的数据项。
    ChartController SetData(int seriesIndex, List<ChartData> data) {
        if (this.disposed || this.option == null || seriesIndex < 0 || seriesIndex >= this.option.series.Count) { return this; }
        if (data == null) { this.option.series[seriesIndex].data = new List<ChartData>(); }
        else { this.option.series[seriesIndex].data = data; }
        this.status = "ready";
        this.version = this.version + 1;
        this.RaiseType(ChartEventType.DataChanged);
        return this;
    }

    /// 追加已命名/着色的数据项，适合实时折线和滚动窗口。
    ChartController AppendData(int seriesIndex, List<ChartData> data) {
        if (this.disposed || this.option == null || seriesIndex < 0 || seriesIndex >= this.option.series.Count || data == null) { return this; }
        ChartSeries s = this.option.series[seriesIndex];
        for (int i = 0; i < data.Count; i = i + 1) { s.data.Add(data[i]); }
        this.status = "ready";
        this.version = this.version + 1;
        this.RaiseType(ChartEventType.DataChanged);
        return this;
    }

    /// 追加纯数值数据的快捷形式。
    ChartController AppendValues(int seriesIndex, List<int> values) {
        if (values == null) { return this; }
        List<ChartData> data = new List<ChartData>();
        for (int i = 0; i < values.Count; i = i + 1) { data.Add(ChartData.Of(values[i])); }
        return this.AppendData(seriesIndex, data);
    }

    /// 清空一个系列的数据，保留系列名称、类型、样式和轴绑定。
    ChartController ClearData(int seriesIndex) {
        if (this.disposed || this.option == null || seriesIndex < 0 || seriesIndex >= this.option.series.Count) { return this; }
        this.option.series[seriesIndex].data = new List<ChartData>();
        this.status = "empty";
        this.version = this.version + 1;
        this.RaiseType(ChartEventType.DataChanged);
        return this;
    }

    /// 清空所有系列的数据，保留 option 的图表类型、样式和轴配置。
    ChartController Clear() {
        if (this.disposed || this.option == null) { return this; }
        for (int i = 0; i < this.option.series.Count; i = i + 1) {
            this.option.series[i].data = new List<ChartData>();
        }
        this.status = "empty";
        this.statusMessage = "";
        this.version = this.version + 1;
        this.RaiseType(ChartEventType.DataChanged);
        return this;
    }

    /// 恢复到最近一次 SetOption/Of 的 option 快照。
    ChartController Restore() {
        if (this.disposed) { return this; }
        this.option = ChartOption.Clone(this.initialOption);
        this.status = "ready";
        this.statusMessage = "";
        this.version = this.version + 1;
        this.RaiseType(ChartEventType.Restore);
        this.RaiseType(ChartEventType.DataChanged);
        return this;
    }

    ChartController ShowLoading(string message) {
        if (this.disposed) { return this; }
        this.status = "loading";
        this.statusMessage = message;
        this.version = this.version + 1;
        return this;
    }

    ChartController HideLoading() {
        if (this.disposed) { return this; }
        this.status = "ready";
        this.statusMessage = "";
        this.version = this.version + 1;
        return this;
    }

    ChartController SetEmptyMessage(string message) {
        if (this.disposed) { return this; }
        this.status = "empty";
        this.statusMessage = message;
        this.version = this.version + 1;
        return this;
    }

    ChartController SetErrorMessage(string message) {
        if (this.disposed) { return this; }
        this.status = "error";
        this.statusMessage = message;
        this.version = this.version + 1;
        return this;
    }

    /// 释放 controller 的 option 和快照；后续 mutation 变为 no-op。
    void Dispose() {
        this.option = null;
        this.initialOption = null;
        this.status = "disposed";
        this.statusMessage = "";
        this.disposed = true;
        this.version = this.version + 1;
        if (this.eventHub != null) { this.eventHub.Clear(); }
    }
}
