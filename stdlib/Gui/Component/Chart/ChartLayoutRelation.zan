using System;
using System.Json;
using Gui;

namespace Gui.Component.Chart;

// ---- 关系图表布局：Chord / Force ----
//
// 与 ChartLayoutSpecial 相同约定：只吃 (模型, 目标几何) 并输出整数
// 角度/坐标/命中区，不接触 App/Canvas。全部确定性整数/定点运算。

/// 弦图的一个节点弧（布局输出；角度为度，0=12 点钟方向，顺时针）。
class ChordNodeArc {
    string name;
    int weight;   // 入 + 出
    int a0;       // 起始角（含）
    int a1;       // 结束角（开）

    /// 构造一个节点弧（weight 为入+出权重，[a0,a1) 为整数角度弧）。
    static ChordNodeArc Of(string name, int weight, int a0, int a1) {
        ChordNodeArc n = new ChordNodeArc();
        n.name = name;
        n.weight = weight;
        n.a0 = a0;
        n.a1 = a1;
        return n;
    }
}

/// 弦图的一条 ribbon（布局输出）：源/目标节点子弧的中心角与端点。
class ChordRibbon {
    int from;       // 节点下标
    int to;
    int val;
    int srcAngle;   // 源节点上该 link 的子弧中心角
    int dstAngle;   // 目标节点上该 link 的子弧中心角
    int srcA0;
    int srcA1;
    int dstA0;
    int dstA1;

    /// 构造一条 ribbon；子弧范围退化为中心角单点（OfSpan 的简式）。
    static ChordRibbon Of(int from, int to, int val, int srcAngle, int dstAngle) {
        return ChordRibbon.OfSpan(from, to, val, srcAngle, dstAngle,
            srcAngle, srcAngle, dstAngle, dstAngle);
    }

    /// 构造一条 ribbon；val 为流量值，src/dstAngle 为源/目标子弧
    /// 中心角，srcA0/srcA1、dstA0/dstA1 为对应子弧起止角。
    static ChordRibbon OfSpan(int from, int to, int val, int srcAngle, int dstAngle,
                              int srcA0, int srcA1, int dstA0, int dstA1) {
        ChordRibbon r = new ChordRibbon();
        r.from = from;
        r.to = to;
        r.val = val;
        r.srcAngle = srcAngle;
        r.dstAngle = dstAngle;
        r.srcA0 = srcA0;
        r.srcA1 = srcA1;
        r.dstA0 = dstA0;
        r.dstA1 = dstA1;
        return r;
    }
}

/// 弦图布局：节点 = links 的 from/to 首现序；节点权重 = 入 + 出；
/// 圆周 360° 先扣除每节点稳定 gap，再按权重以最大余数法分整数弧；
/// 每个节点内 incident links（按 link 原序）再分子弧，ribbon
/// 连接源/目标子弧中心。输出节点弧 + ribbon 角度。
class ChordLayout {
    List<ChordNodeArc> nodes;
    List<ChordRibbon> ribbons;
    int gap;        // 每节点稳定间隙（度）
    int arcTotal;   // 所有节点弧总度数（= 360 - n*gap）

    /// sortMode：0 = 首现序（现状逐像素一致）| 1 = 权重降序 | 2 = 升序
    /// （ECharts 2.x chord.sort）。sortSub = sortSub：true 时子弧按
    /// link 值降序（ECharts chord.sortSub），false = 旧对端序。
    /// gapDeg：节点间隙度数，-1 = 自动（2，拥挤时 0；现状）。
    static ChordLayout Of(List<ChartLink> links, int sortMode, bool sortSub,
                          int gapDeg) {
        ChordLayout l = new ChordLayout();
        l.ribbons = new List<ChordRibbon>();
        l.nodes = new List<ChordNodeArc>();
        int n = links.Count;
        if (n < 1) { l.gap = 2; l.arcTotal = 360; return l; }

        // 节点首现序 + 权重。
        for (int li = 0; li < n; li = li + 1) {
            ChartLink lk = links[li];
            if (ChordLayout.NodeIndex(l.nodes, lk.from) < 0) {
                l.nodes.Add(ChordNodeArc.Of(lk.from, 0, 0, 0));
            }
            if (ChordLayout.NodeIndex(l.nodes, lk.to) < 0) {
                l.nodes.Add(ChordNodeArc.Of(lk.to, 0, 0, 0));
            }
        }
        int nn = l.nodes.Count;
        for (int li = 0; li < n; li = li + 1) {
            ChartLink lk = links[li];
            int fi = ChordLayout.NodeIndex(l.nodes, lk.from);
            int ti = ChordLayout.NodeIndex(l.nodes, lk.to);
            l.nodes[fi].weight = l.nodes[fi].weight + lk.val;
            if (ti != fi) {
                l.nodes[ti].weight = l.nodes[ti].weight + lk.val;
            }
        }

        // 节点弧序（ECharts chord.sort）：权重稳定插入排序；
        // 索引随 nodes 移动，ribbon 端点由下方按名重映射。
        if (sortMode == 1 || sortMode == 2) {
            for (int a = 1; a < nn; a = a + 1) {
                ChordNodeArc cur = l.nodes[a];
                int b = a - 1;
                while (b >= 0) {
                    bool keep;
                    if (sortMode == 1) {
                        keep = l.nodes[b].weight >= cur.weight;
                    } else {
                        keep = l.nodes[b].weight <= cur.weight;
                    }
                    if (keep) { break; }
                    l.nodes[b + 1] = l.nodes[b];
                    b = b - 1;
                }
                l.nodes[b + 1] = cur;
            }
        }

        // 稳定间隙 + 总弧长。
        int gap = 2;
        if (gapDeg >= 0) { gap = gapDeg; }
        int arcTotal = 360 - nn * gap;
        if (arcTotal < 180) {
            if (gapDeg < 0) { gap = 0; arcTotal = 360; }
        }
        if (arcTotal < 1) { arcTotal = 1; }
        l.gap = gap;
        l.arcTotal = arcTotal;

        // 节点弧：最大余数法分整数弧。
        int totalW = 0;
        for (int i = 0; i < nn; i = i + 1) { totalW = totalW + l.nodes[i].weight; }
        if (totalW < 1) { totalW = 1; }
        List<int> arcSz = new List<int>();
        int rem = arcTotal;
        for (int i = 0; i < nn; i = i + 1) {
            int sz = arcTotal * l.nodes[i].weight / totalW;
            arcSz.Add(sz);
            rem = rem - sz;
        }
        int rr = 0;
        while (rr < rem && nn > 0) { arcSz[rr % nn] = arcSz[rr % nn] + 1; rr = rr + 1; }
        int ang = gap / 2;
        for (int i = 0; i < nn; i = i + 1) {
            l.nodes[i].a0 = ang;
            l.nodes[i].a1 = ang + arcSz[i];
            ang = ang + arcSz[i] + gap;
        }

        // 每节点 incident links（link 原序）→ 子弧中心角。
        List<List<int>> inc = new List<List<int>>();
        for (int i = 0; i < nn; i = i + 1) { inc.Add(new List<int>()); }
        for (int li = 0; li < n; li = li + 1) {
            ChartLink lk = links[li];
            int fi = ChordLayout.NodeIndex(l.nodes, lk.from);
            int ti = ChordLayout.NodeIndex(l.nodes, lk.to);
            inc[fi].Add(li);
            if (ti != fi) { inc[ti].Add(li); }
        }
        for (int i = 0; i < nn; i = i + 1) {
            ChordLayout.SortInc(inc[i], links, l.nodes, i, sortSub);
        }
        // subC[i][pos] = 节点 i 第 pos 个 incident link 的子弧中心角。
        List<List<int>> subC = new List<List<int>>();
        List<List<int>> subA0 = new List<List<int>>();
        List<List<int>> subA1 = new List<List<int>>();
        for (int i = 0; i < nn; i = i + 1) {
            List<int> ctrs = new List<int>();
            List<int> a0s = new List<int>();
            List<int> a1s = new List<int>();
            int subArc = l.nodes[i].a1 - l.nodes[i].a0;
            int wsum = l.nodes[i].weight;
            if (wsum < 1) { wsum = 1; }
            List<int> sizes = new List<int>();
            int srem = subArc;
            for (int p = 0; p < inc[i].Count; p = p + 1) {
                int sz = subArc * links[inc[i][p]].val / wsum;
                sizes.Add(sz);
                srem = srem - sz;
            }
            int sr = 0;
            while (sr < srem && sizes.Count > 0) {
                sizes[sr % sizes.Count] = sizes[sr % sizes.Count] + 1;
                sr = sr + 1;
            }
            int cum = l.nodes[i].a0;
            for (int p = 0; p < inc[i].Count; p = p + 1) {
                ctrs.Add(cum + sizes[p] / 2);
                a0s.Add(cum);
                a1s.Add(cum + sizes[p]);
                cum = cum + sizes[p];
            }
            subC.Add(ctrs);
            subA0.Add(a0s);
            subA1.Add(a1s);
        }

        for (int li = 0; li < n; li = li + 1) {
            ChartLink lk = links[li];
            int fi = ChordLayout.NodeIndex(l.nodes, lk.from);
            int ti = ChordLayout.NodeIndex(l.nodes, lk.to);
            int sPos = ChordLayout.Pos(inc[fi], li);
            int dPos = ChordLayout.Pos(inc[ti], li);
            int sA = 0;
            int dA = 0;
            int sa0 = 0;
            int sa1 = 0;
            int da0 = 0;
            int da1 = 0;
            if (sPos >= 0 && sPos < subC[fi].Count) {
                sA = subC[fi][sPos];
                sa0 = subA0[fi][sPos];
                sa1 = subA1[fi][sPos];
            }
            if (dPos >= 0 && dPos < subC[ti].Count) {
                dA = subC[ti][dPos];
                da0 = subA0[ti][dPos];
                da1 = subA1[ti][dPos];
            }
            l.ribbons.Add(ChordRibbon.OfSpan(fi, ti, lk.val, sA, dA, sa0, sa1, da0, da1));
        }
        return l;
    }

    /// link 的对端节点下标（self 为 from 时返回 to，否则返回 from）。
    static int OtherIndex(List<ChordNodeArc> nodes, ChartLink lk, int self) {
        int fi = ChordLayout.NodeIndex(nodes, lk.from);
        int ti = ChordLayout.NodeIndex(nodes, lk.to);
        if (fi == self) { return ti; }
        return fi;
    }

    /// 稳定插入排序某节点的 incident link 下标：byValue（sortSub）
    /// 时按 link 值降序，否则按对端节点下标升序；同序保持 link
    /// 原序。
    static void SortInc(List<int> inc, List<ChartLink> links,
                        List<ChordNodeArc> nodes, int self, bool byValue) {
        for (int a = 1; a < inc.Count; a = a + 1) {
            int v = inc[a];
            int ov = ChordLayout.OtherIndex(nodes, links[v], self);
            int b = a - 1;
            while (b >= 0) {
                int ou = ChordLayout.OtherIndex(nodes, links[inc[b]], self);
                bool keep;
                if (byValue) {
                    // sortSub：子弧按 link 值降序，同值保持 link 原序。
                    keep = links[inc[b]].val >= links[v].val;
                    if (!keep && links[inc[b]].val == links[v].val
                        && inc[b] <= v) { keep = true; }
                } else {
                    keep = ou < ov;
                    if (!keep && ou == ov && inc[b] <= v) { keep = true; }
                }
                if (keep) { break; }
                inc[b + 1] = inc[b];
                b = b - 1;
            }
            inc[b + 1] = v;
        }
    }

    /// 按名查节点下标，无则 -1。
    static int NodeIndex(List<ChordNodeArc> nodes, string name) {
        for (int i = 0; i < nodes.Count; i = i + 1) {
            if (nodes[i].name == name) { return i; }
        }
        return 0 - 1;
    }

    /// 在下标表里找 v 的位置，无则 -1。
    static int Pos(List<int> list, int v) {
        for (int i = 0; i < list.Count; i = i + 1) {
            if (list[i] == v) { return i; }
        }
        return 0 - 1;
    }
}

/// 力导向图的一个节点（布局输出；整数像素坐标）。
class ForceNode {
    string name;
    int x;
    int y;
    int weight;   // 入 + 出
    string symbol; // 形状族（系列显式 tree 节点按名匹配；"" = 圆）
    int size;      // 直径像素；0 = 按权重自动

    /// 构造一个力导向节点（symbol = ""、size = 0 即圆 + 按权重
    /// 自动直径）。
    static ForceNode Of(string name, int x, int y, int weight) {
        ForceNode nd = new ForceNode();
        nd.name = name;
        nd.x = x;
        nd.y = y;
        nd.weight = weight;
        nd.symbol = "";
        nd.size = 0;
        return nd;
    }
}

/// 力导向图的一条边（布局输出；去重后的无向对）。
class ForceEdge {
    int a;        // 节点下标
    int b;
    int val;      // 该对 link 值之和

    /// 构造一条无向边；val 为该无向对的 link 值之和。
    static ForceEdge Of(int a, int b, int val) {
        ForceEdge e = new ForceEdge();
        e.a = a;
        e.b = b;
        e.val = val;
        return e;
    }
}

/// 力导向布局：节点 = links 首现序；边 = 无向对（自环丢弃、
/// 重复边求和）。初始位置为圆周（无随机）；固定轮数的整数
/// 定点弹簧模拟（近距离斥力 + 边吸引 + 中心引力 + 边界钳制）。
/// 节点数 > 60 时降迭代。相同输入 → 相同输出。
class ForceLayout {
    List<ForceNode> nodes;
    List<ForceEdge> edges;
    int iterations;   // 实际执行轮数
    // 入场动画补间的初始位（圆周初值的快照，与 nodes 同序）；
    // iterations==0（单节点/退化）或模拟后为空时为 null。
    List<int> startX;
    List<int> startY;

    /// 在**局部坐标**里模拟：绘图区左上角为原点，中心在
    /// (w/2, h/2)，钳制到 [0..w]×[0..h]。调用方绘制时再平移到
    /// 屏幕位置。这样布局只取决于数据与盒子尺寸——卡片滚动
    /// 时形状不变，逐帧缓存也能跨滚动位置命中。
    /// scaling / gravity（百分比，100 = 现状逐像素一致）：
    /// 分别缩放弹簧斥力/边吸引与中心引力（ECharts force.scaling /
    /// force.gravity）。
    static ForceLayout Of(List<ChartLink> links, int r, int w, int h,
                          int scaling, int gravity) {
        ForceLayout l = new ForceLayout();
        l.edges = new List<ForceEdge>();
        l.nodes = new List<ForceNode>();
        int n = links.Count;
        if (n < 1) { l.iterations = 0; return l; }

        // 节点首现序 + 权重。
        for (int li = 0; li < n; li = li + 1) {
            ChartLink lk = links[li];
            if (ForceLayout.NodeIndex(l.nodes, lk.from) < 0) {
                l.nodes.Add(ForceNode.Of(lk.from, 0, 0, 0));
            }
            if (ForceLayout.NodeIndex(l.nodes, lk.to) < 0) {
                l.nodes.Add(ForceNode.Of(lk.to, 0, 0, 0));
            }
        }
        int nn = l.nodes.Count;
        for (int li = 0; li < n; li = li + 1) {
            ChartLink lk = links[li];
            int fi = ForceLayout.NodeIndex(l.nodes, lk.from);
            int ti = ForceLayout.NodeIndex(l.nodes, lk.to);
            l.nodes[fi].weight = l.nodes[fi].weight + lk.val;
            l.nodes[ti].weight = l.nodes[ti].weight + lk.val;
        }

        // 边：自环丢弃；同一无向对累加值。
        for (int li = 0; li < n; li = li + 1) {
            ChartLink lk = links[li];
            int fi = ForceLayout.NodeIndex(l.nodes, lk.from);
            int ti = ForceLayout.NodeIndex(l.nodes, lk.to);
            if (fi == ti) { continue; }
            int a = fi;
            int b = ti;
            if (b < a) { int sw = a; a = b; b = sw; }
            int ei = ForceLayout.EdgeIndex(l.edges, a, b);
            if (ei < 0) { l.edges.Add(ForceEdge.Of(a, b, lk.val)); }
            else { l.edges[ei].val = l.edges[ei].val + lk.val; }
        }

        // 初始位置：圆周。
        int cx = w / 2;
        int cy = h / 2;
        int rad = r;
        if (rad < 1) { rad = 1; }
        for (int i = 0; i < nn; i = i + 1) {
            int ang = i * 360 / nn;
            l.nodes[i].x = cx + rad * ChartView.CosDeg(ang) / 1000;
            l.nodes[i].y = cy + rad * ChartView.SinDeg(ang) / 1000;
        }
        // 圆周初值快照：入场补间从这份坐标出发按进度插值到终态，
        // 复刻 ECharts force「节点自初始位收敛」的入场观感。
        l.startX = new List<int>();
        l.startY = new List<int>();
        for (int i = 0; i < nn; i = i + 1) {
            l.startX.Add(l.nodes[i].x);
            l.startY.Add(l.nodes[i].y);
        }

        if (nn < 2) {
            l.nodes[0].x = cx;
            l.nodes[0].y = cy;
            l.iterations = 0;
            return l;
        }

        // 固定轮数的弹簧模拟（整数定点，每轮施加后钳制）。
        int iters = 60;
        if (nn > 60) { iters = 30; }
        l.iterations = iters;
        int k = rad;
        if (k < 8) { k = 8; }
        int rest = rad / 2;
        if (rest < 1) { rest = 1; }
        int maxDisp = rad * 4;
        if (maxDisp < 8) { maxDisp = 8; }
        for (int it = 0; it < iters; it = it + 1) {
            for (int i = 0; i < nn; i = i + 1) {
                int xi = l.nodes[i].x;
                int yi = l.nodes[i].y;
                int dx = 0;
                int dy = 0;
                // 斥力：近距离成对推开（方向归一化，量级 ∝ (k-d)）。
                for (int j = 0; j < nn; j = j + 1) {
                    if (j == i) { continue; }
                    int dijx = l.nodes[j].x - xi;
                    int dijy = l.nodes[j].y - yi;
                    if (dijx == 0 && dijy == 0) { dijx = 1; dijy = 0; }
                    int d2 = dijx * dijx + dijy * dijy;
                    int d = ChartView.ISqrt(d2);
                    if (d < 8) { d = 8; }
                    if (d < k) {
                        int fr = (k - d) * 4 * scaling / 1000;
                        dx = dx - dijx * fr / d;
                        dy = dy - dijy * fr / d;
                    }
                }
                // 边吸引：拉向对方（拉伸时吸引，压缩时推开；
                // 方向归一化，量级 ∝ (d-rest)）。
                for (int ei = 0; ei < l.edges.Count; ei = ei + 1) {
                    ForceEdge e = l.edges[ei];
                    int j = 0 - 1;
                    if (e.a == i) { j = e.b; }
                    if (e.b == i) { j = e.a; }
                    if (j < 0) { continue; }
                    int dijx = l.nodes[j].x - xi;
                    int dijy = l.nodes[j].y - yi;
                    if (dijx == 0 && dijy == 0) { dijx = 1; dijy = 0; }
                    int d2 = dijx * dijx + dijy * dijy;
                    int d = ChartView.ISqrt(d2);
                    if (d < 8) { d = 8; }
                    int fa = (d - rest) * 2 * scaling / 1000;
                    dx = dx + dijx * fa / d;
                    dy = dy + dijy * fa / d;
                }
                if (dx > maxDisp) { dx = maxDisp; }
                if (dx < 0 - maxDisp) { dx = 0 - maxDisp; }
                if (dy > maxDisp) { dy = maxDisp; }
                if (dy < 0 - maxDisp) { dy = 0 - maxDisp; }
                int nx = xi + dx * 3 / 8;
                int ny = yi + dy * 3 / 8;
                // 中心引力 + 边界钳制。
                nx = nx + (cx - nx) * gravity / 3200;
                ny = ny + (cy - ny) * gravity / 3200;
                if (nx < 0) { nx = 0; }
                if (nx > w) { nx = w; }
                if (ny < 0) { ny = 0; }
                if (ny > h) { ny = h; }
                l.nodes[i].x = nx;
                l.nodes[i].y = ny;
            }
        }
        return l;
    }

    /// 按名查节点下标，无则 -1。
    static int NodeIndex(List<ForceNode> nodes, string name) {
        for (int i = 0; i < nodes.Count; i = i + 1) {
            if (nodes[i].name == name) { return i; }
        }
        return 0 - 1;
    }

    /// ECharts force 的 symbol/symbolSize 是**逐节点**声明：调用方把
    /// 节点形状放在 series.tree（ChartNode.Shaped 叶），布局仍由 links
    /// 推导，这里按名匹配把 symbol/size 抄到 ForceNode 上。未匹配的
    /// 节点保持圆 + 自动尺寸。
    /// minR/maxR（ECharts force.minSize/maxSize，像素，0 = 关闭）：
    /// 无显式 size 的节点直径按权重在两者间线性插值；显式 size 仍
    /// 优先。绘制端用 size/2 当半径。
    static void ApplyShapes(ForceLayout l, List<ChartNode> shapes,
                            int minR, int maxR) {
        int maxW = 1;
        for (int i = 0; i < l.nodes.Count; i = i + 1) {
            if (l.nodes[i].weight > maxW) { maxW = l.nodes[i].weight; }
        }
        for (int i = 0; i < l.nodes.Count; i = i + 1) {
            ForceNode nd = l.nodes[i];
            if (minR > 0) {
                int hi = maxR > 0 ? maxR : minR;
                if (hi < minR) { hi = minR; }
                nd.size = 2 * (minR + (hi - minR) * nd.weight / maxW);
            }
        }
        if (shapes == null) { return; }
        for (int si = 0; si < shapes.Count; si = si + 1) {
            int idx = ForceLayout.NodeIndex(l.nodes, shapes[si].name);
            if (idx >= 0) {
                l.nodes[idx].symbol = shapes[si].symbol;
                if (shapes[si].size > 0) { l.nodes[idx].size = shapes[si].size; }
            }
        }
    }

    /// 查无向对 (a,b)（调用方保证小端在前）的边下标，无则 -1。
    static int EdgeIndex(List<ForceEdge> edges, int a, int b) {
        for (int i = 0; i < edges.Count; i = i + 1) {
            if (edges[i].a == a && edges[i].b == b) { return i; }
        }
        return 0 - 1;
    }
}

/// 力导向布局的逐帧记忆化条目：布局是数据与几何的纯函数，
/// 即时模式调用方每帧重建 option 对象，按内容指纹复用
/// 同一次弹簧模拟，避免滚动/悬停帧反复重算 O(n²) 迭代。
class ForceLayoutCache {
    int fp;
    ForceLayout layout;
    /// 指纹命中则返回缓存布局；未命中返回 null。
    static ForceLayout Lookup(List<ForceLayoutCache> cache, int fp) {
        for (int i = 0; i < cache.Count; i = i + 1) {
            if (cache[i].fp == fp) { return cache[i].layout; }
        }
        return null;
    }
    /// 存入布局（同指纹去重；超出容量时挤掉最旧的一条）。
    static void Store(List<ForceLayoutCache> cache, int fp, ForceLayout l,
                      int capacity) {
        for (int i = 0; i < cache.Count; i = i + 1) {
            if (cache[i].fp == fp) { return; }
        }
        ForceLayoutCache e = new ForceLayoutCache();
        e.fp = fp;
        e.layout = l;
        if (cache.Count >= capacity) { cache.RemoveAt(0); }
        cache.Add(e);
    }
}
