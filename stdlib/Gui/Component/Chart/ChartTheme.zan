using System;
using Gui;

namespace Gui.Component.Chart;

/// 图表主题包（图表自己的皮肤层）：`themes/<名>.css` 纯 CSS 配置，
/// 调色板走 `chart::series-N`，轴线/网格/图例/缩放柄等走
/// `chart::<part>`，深色包另带 `chart` 画布底色。由
/// `App.UseChartTheme(name)` 按名叠加到样式表顶层，与 Gui 皮肤
/// 相互独立、分层生效——换 Gui 皮肤不动图表配色，换图表主题
/// 不动界面。
///
/// 本类只负责发现与读取（磁盘优先、exe 内嵌兜底），不含任何
/// 色值：图表的颜色全部在 CSS 包里，改主题请改包，不要把色值
/// 写进代码。包的属性映射见各包文件头注释。
class ChartTheme {
    /// 读取主题包 `themes/<name>.css` 的文本。name 为 ""（= 完全卸
    /// 载，图表跟随 Gui 皮肤 token 回落）或找不到包时返回 ""；
    /// "default" = ECharts 6.1 官方基线包 echarts6.css——App 构造
    /// 即装载，UseChartTheme("default") 随时回到它。
    /// 搜索根：$ZAN_CHART_THEMES、exe 旁与自解包布局、cwd 上溯的
    /// stdlib 副本；磁盘优先（用户可整包覆盖），编译进 exe 的
    /// 内嵌资源 `chartthemes/<name>.css` 兜底（zanc 对用到 Chart
    /// 符号的程序自动内嵌该目录；发布后的单文件程序靠它找到
    /// 内建包）。
    static string Css(string name) {
        string key = name == "default" ? "echarts6" : name;
        if (key == "") { return ""; }
        List<string> roots = ChartTheme.Roots();
        int i = 0;
        while (i < roots.Count) {
            string cand = roots[i] + "/" + key + ".css";
            i = i + 1;
            if (File.Exists(cand)) { return File.ReadAllText(cand); }
        }
        return Skin.EmbedRead("chartthemes/" + key + ".css");
    }

    /// 可发现的主题包名（各搜索根下 `*.css` 的文件名 + exe 内嵌
    /// 的 `chartthemes/*.css` 资源），去重、字典序。
    static List<string> Names() {
        List<string> names = new List<string>();
        List<string> roots = ChartTheme.Roots();
        int i = 0;
        while (i < roots.Count) {
            if (Directory.Exists(roots[i])) {
                List<string> files = Directory.GetFiles(roots[i]);
                int k = 0;
                while (k < files.Count) {
                    string f = Skin.Leaf(files[k]);
                    k = k + 1;
                    if (!f.EndsWith(".css")) { continue; }
                    string nm = f.Substring(0, f.Length - 4);
                    if (!Skin.Contains(names, nm)) { names.Add(nm); }
                }
            }
            i = i + 1;
        }
        // 内嵌资源名形如 "chartthemes/<name>.css"。
        string emb = Skin.EmbedList("chartthemes/");
        int start = 0;
        for (int p = 0; p <= emb.Length; p = p + 1) {
            bool brk = false;
            if (p == emb.Length) { brk = true; }
            else if (emb[p] == '\n') { brk = true; }
            if (brk) {
                if (p > start) {
                    string nm = Skin.Leaf(emb.Substring(start, p - start));
                    if (nm.EndsWith(".css")) {
                        nm = nm.Substring(0, nm.Length - 4);
                        if (nm != "" && !Skin.Contains(names, nm)) { names.Add(nm); }
                    }
                }
                start = p + 1;
            }
        }
        // 插入排序：包数量少（十几个），无泛型 Sort 依赖。
        for (int a = 1; a < names.Count; a = a + 1) {
            string key = names[a];
            int b = a - 1;
            while (b >= 0 && names[b].CompareTo(key) > 0) {
                names[b + 1] = names[b];
                b = b - 1;
            }
            names[b + 1] = key;
        }
        return names;
    }

    /// 主题包搜索根（最具体者优先）：环境变量指定的目录、exe
    /// 所在位置与自解包/发布布局、cwd 上溯到源码树的 stdlib 副本
    /// （从构建树或工程目录运行时命中）。
    static List<string> Roots() {
        List<string> r = new List<string>();
        string env = Skin.Env("ZAN_CHART_THEMES");
        if (env != "") { r.Add(env); }
        string exe = Skin.ExeDir();
        if (exe != "") {
            r.Add(exe + "/chartthemes");
            r.Add(exe + "/themes");
            r.Add(exe + "/stdlib/Gui/Component/Chart/themes");
            r.Add(exe + "/../stdlib/Gui/Component/Chart/themes");
            r.Add(exe + "/../../stdlib/Gui/Component/Chart/themes");
        }
        r.Add("stdlib/Gui/Component/Chart/themes");
        r.Add("../stdlib/Gui/Component/Chart/themes");
        r.Add("../../stdlib/Gui/Component/Chart/themes");
        return r;
    }
}
