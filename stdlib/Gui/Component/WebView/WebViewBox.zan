using System;
using Gui;

namespace Gui.Component.WebView;

/// 可摆放的网页视图控件：把原生 WebView 包成一个普通的保留式
/// Control，因此设计器 / .zform 里的网页视图和别的控件一样，
/// 由布局给它一块矩形、由它自己负责绘制。
///
///     WebViewBox box = new WebViewBox();
///     box.SetStartUrl("https://example.com");
///     tabs.Page(0).Add(box);              // 标签页里放一个浏览器
///     box.View().NavComplete += () => { ... };
///
/// 与直接用 WebView 的区别在于「谁驱动它」：WebView 是原生兄弟层，
/// 必须每帧被告知矩形，隐藏时还要有人替它调 Hide()。这个控件把
/// 两件事都接了过来——可见时按自己的已解析边界 Render，落在隐藏
/// 的标签页 / 折叠容器里时整棵子树不参与渲染，由 NativeLayer 兜底
/// 把没登记的原生层裁空（即隐藏）。
class WebViewBox : Control {
    /// 本控件拥有的原生视图（每个 WebViewBox 一个浏览器实例，
    /// 因此多标签浏览器就是多个 WebViewBox）。
    WebView view;
    /// 设计期填写的起始地址，首帧导航一次。
    string startUrl;
    bool navigated;

    /// 默认构造：使用共享默认存储（"" profile）。
    WebViewBox() : this("") { }

    /// 绑定到隔离配置文件的网页视图（见 WebView 的 profileId）。
    WebViewBox(string profileId) {
        this.InitControl("webview", 5);
        this.view = new WebView(profileId);
        this.startUrl = "";
        this.navigated = false;
    }

    /// 底层原生视图：历史、Cookie、Eval、事件都在它上面。
    /// <returns>本控件唯一拥有的 WebView 实例。</returns>
    WebView View() { return view; }

    /// <summary>起始地址（设计属性 `url`，.zform 里也可写成
    /// `placeholder`）。首帧之前设置只记录起始地址，待首次绘制时
    /// 导航一次；首帧之后设置立即等同于 Navigate。</summary>
    void SetStartUrl(string u) {
        startUrl = u;
        if (navigated && u != "") { view.Navigate(u); }
    }

    /// 当前设置的起始地址。
    string StartUrl() { return startUrl; }

    /// <summary>立即导航到 target（与 SetStartUrl 不同，不等首帧）。</summary>
    void Navigate(string target) {
        navigated = true;
        view.Navigate(target);
    }

    /// 历史后退一页（转发到底层视图）。
    void Back() { view.Back(); }
    /// 历史前进一页。
    void Forward() { view.Forward(); }
    /// 重新加载当前页。
    void Reload() { view.Reload(); }
    /// 停止当前加载。
    void Stop() { view.Stop(); }
    /// 能否后退。
    bool CanGoBack() { return view.CanGoBack(); }
    /// 能否前进。
    bool CanGoForward() { return view.CanGoForward(); }
    /// 是否正在加载。
    bool IsLoading() { return view.IsLoading(); }
    /// 最近一次响应的 HTTP 状态码（无为 0）。
    int LastStatus() { return view.LastStatus(); }
    /// 当前 URL 快照。
    string CurrentUrl() { return view.CurrentUrl(); }
    /// 当前文档标题快照。
    string CurrentTitle() { return view.CurrentTitle(); }

    /// 隐藏原生视图（本控件不再上屏时调用；隐藏的标签页由
    /// NativeLayer 自动兜底，这里供宿主显式收起）。
    void Hide() { view.Hide(); }

    /// <summary>销毁原生视图（关闭标签页时调用），并把控件从树上
    /// 摘下。销毁后不要再 Render 本控件。</summary>
    void Destroy() {
        view.Destroy();
        if (parent != null) { parent.Remove(this); }
    }

    // ---- 设计器 / 序列化模型 --------------------------------------

    /// 控件类型标识（"WebViewBox"）。
    override string Kind() { return "WebViewBox"; }

    /// 设计器属性：起始地址（"url"）。
    override List<PropSpec> Props() {
        List<PropSpec> ps = new List<PropSpec>();
        // 设计器把每个字段的文本属性存成 `placeholder`，所以起始
        // 地址同时应答这个键：在检查器里填的地址能原样往返。
        PropSpec u = PropSpec.Text("url", "Start URL").Also("placeholder");
        u.str = startUrl;
        ps.Add(u);
        return ps;
    }

    /// 控件事件清单：公共事件外加四个导航语义事件。
    override List<string> Events() {
        List<string> e = Control.CommonEvents();
        e.Add("NavStart");
        e.Add("NavComplete");
        e.Add("TitleChanged");
        e.Add("LoadingChanged");
        return e;
    }

    /// 浏览器的语义事件挂在原生视图上，设计里的 `onNavComplete`
    /// 之类因此直接落到它的 UiEvent，宿主不必自己接线。
    override void BindEvent(string evt, Action a) {
        if (evt == "NavStart") { view.NavStart.Add(a); return; }
        if (evt == "NavComplete") { view.NavComplete.Add(a); return; }
        if (evt == "TitleChanged") { view.TitleChanged.Add(a); return; }
        if (evt == "LoadingChanged") { view.LoadingChanged.Add(a); return; }
        On.AddByName(evt, a);
    }

    // ---- 保留式钩子（Control） ---------------------------------------

    /// 绘制：零尺寸时隐藏原生视图；首帧前先消费起始地址（原生视图
    /// 在 Render 里才创建，创建时会消费这次挂起的导航），然后每帧
    /// 驱动底层视图。
    override void OnPaint(App app) {
        if (bw <= 0 || bh <= 0) {
            view.Hide();
            return;
        }
        // 导航要早于第一次 Render：原生视图在 Render 里才创建，
        // 创建时会消费这次挂起的导航。
        if (!navigated && startUrl != "") {
            navigated = true;
            view.Navigate(startUrl);
        }
        view.Render(app, bx, by, bw, bh);
    }
}
