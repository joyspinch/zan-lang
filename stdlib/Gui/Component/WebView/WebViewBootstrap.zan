using Gui;
using Gui.Component.WebView;

namespace Gui.Component.WebView;

/// <summary>
/// WebView 家族的 HeavyControls 注册入口。IDE、浏览器示例等真正
/// 用到 WebViewBox 的宿主在启动时调用一次 <see cref="Install"/>；
/// 不调用的程序里整个 WebView 家族被 globaldce 删光，发布不再
/// 携带 WebView2Loader.dll（bundle 的 "if WebView2_" 前缀条件）。
/// </summary>
class WebViewBootstrap {
    static bool installed;

    static void Install() {
        if (installed) { return; }
        installed = true;
        HeavyControls.Register("WebViewBox", MakeWebViewBox);
    }

    static Control MakeWebViewBox(string kind) {
        if (kind == "WebViewBox") { return new WebViewBox(); }
        return null;
    }
}
