using System;
using Gui;

namespace Gui.Component.WebView;

/// 内嵌的原生 Web 视图（浏览器控件）。
///
/// 由平台浏览器引擎（WebViewBackend）支撑：Windows 上是 Edge WebView2
/// 控制器，由 Zan 直接通过其 COM 接口驱动，
/// macOS 上是 WKWebView，其他平台为占位符（没有原生引擎的后端
/// 返回无句柄，因此 IsSupported() 为 false，Render 绘制
/// 画布内提示而不是嵌入实时浏览器）。
///
/// 原生视图是浮在软件渲染表面之上的兄弟图层，
/// 因此要由所属区域每帧驱动它：
///   WebView web = WebView.CreateWithProfile("");
///   web.NavComplete += () => { ... };   // 加载完成时触发
///   web.Navigate("https://example.com");
///   // 每帧，针对可见标签：
///   web.Render(app, x, y, w, h);
///   // 每帧，针对隐藏标签：
///   web.Hide();
///
/// 暴露常用浏览器功能：历史（Back/Forward/Reload/Stop）、
/// URL 和标题监控（响应式 Url()/Title() 信号 + NavComplete）、
/// 最近一次请求的 URL 和 HTTP 状态、JavaScript 求值（Eval 是
/// 读取请求参数/响应体的通用后门）以及
/// Cookie 访问（GetCookies/SetCookie/ClearCookies）。
class WebView {
    int handle;        // 原生 webview 句柄（0 = 尚未创建/不支持）
    string profileId;  // 隔离配置文件："" = 共享默认存储，否则按账户隔离
    bool created;      // 已尝试原生创建
    bool supported;    // 原生后端已产出可用的 webview
    int lastNavSeq;    // 最近观察到的导航计数器（URL 变化监视器）
    string pendingUrl; // 原生创建前请求的导航
    string pendingHtml;
    string pendingBase;

    string lastSeenRequest;
    string lastSeenTitle;
    bool lastSeenLoading;

    SignalString url;
    SignalString title;

    /// 导航完成（或失败）时触发，即当前 URL/标题
    /// 可能已变化。响应式 Url()/Title() 会在其触发前更新。
    UiEvent NavComplete;
    /// 请求新导航时触发（LastRequest() 即其 URL）。
    UiEvent NavStart;
    /// 文档标题变化时触发，包括页面内的更新。
    UiEvent TitleChanged;
    /// 加载开始或结束时触发（IsLoading() 指示是哪种）。
    UiEvent LoadingChanged;

    /// 创建绑定到隔离配置文件的 WebView。共享同一
    /// 非空 profileId 的 WebView 共享 Cookie/localStorage/会话（同一
    /// 账户）；不同 profileId 完全隔离，因此多个账户
    /// 可同时保持登录。空的 profileId 使用共享默认
    /// 存储（旧行为）。配置文件在 Windows（每配置文件一个
    /// WebView2 用户数据文件夹）和 macOS 上生效；其他平台接受并忽略
    /// 该 id。
    WebView(string profileId) {
        this.handle = 0;
        this.profileId = profileId;
        this.created = false;
        this.supported = true;
        this.lastNavSeq = 0;
        this.pendingUrl = "";
        this.pendingHtml = "";
        this.pendingBase = "";
        this.lastSeenRequest = "";
        this.lastSeenTitle = "";
        this.lastSeenLoading = false;
        this.url = new SignalString("");
        this.title = new SignalString("");
        this.NavComplete = new UiEvent();
        this.NavStart = new UiEvent();
        this.TitleChanged = new UiEvent();
        this.LoadingChanged = new UiEvent();
    }

    /// 使用共享的默认存储创建 WebView。
    WebView() : this("") { }

    static WebView CreateWithProfile(string profileId) {
        return new WebView(profileId);
    }

    /// 此视图创建时使用的隔离配置文件 id（"" = 共享）。
    string ProfileId() { return profileId; }

    void EnsureCreated(App app) {
        if (created) { return; }
        created = true;
        handle = WebViewBackend.Create(app.window.GetHandle(), profileId);
        if (handle == 0) {
            supported = false;
            return;
        }
        supported = true;
        if (pendingUrl != "") {
            WebViewBackend.Navigate(handle, pendingUrl);
            pendingUrl = "";
        } else if (pendingHtml != "") {
            WebViewBackend.LoadHtml(handle, pendingHtml, pendingBase);
            pendingHtml = "";
            pendingBase = "";
        }
    }

    /// 当前平台有可用的原生 Web 视图时为 true。
    bool IsSupported() { return supported; }

    /// 响应式当前 URL/文档标题（每次导航后更新）。
    SignalString Url() { return url; }
    SignalString Title() { return title; }
    string CurrentUrl() { return url.Get(); }
    string CurrentTitle() { return title.Get(); }

    /// 导航到 URL。无协议的裸主机名视为 https://。
    void Navigate(string target) {
        string u = WebView.Normalize(target);
        if (!created || !supported) {
            pendingUrl = u;
            pendingHtml = "";
            return;
        }
        WebViewBackend.Navigate(handle, u);
    }

    /// 加载内存中的 HTML 字符串（baseUrl 解析相对链接；可为 ""）。
    void LoadHtml(string html, string baseUrl) {
        if (!created || !supported) {
            pendingHtml = html;
            pendingBase = baseUrl;
            pendingUrl = "";
            return;
        }
        WebViewBackend.LoadHtml(handle, html, baseUrl);
    }

    void Back() { if (supported && handle != 0) { WebViewBackend.Back(handle); } }
    void Forward() { if (supported && handle != 0) { WebViewBackend.Forward(handle); } }
    void Reload() { if (supported && handle != 0) { WebViewBackend.Reload(handle); } }
    void Stop() { if (supported && handle != 0) { WebViewBackend.Stop(handle); } }

    bool CanGoBack() {
        if (!supported || handle == 0) { return false; }
        return WebViewBackend.CanGoBack(handle);
    }
    bool CanGoForward() {
        if (!supported || handle == 0) { return false; }
        return WebViewBackend.CanGoForward(handle);
    }
    bool IsLoading() {
        if (!supported || handle == 0) { return false; }
        return WebViewBackend.IsLoading(handle);
    }

    /// 最近一次响应的 HTTP 状态码（无响应或非 HTTP 时为 0）。
    int LastStatus() {
        if (!supported || handle == 0) { return 0; }
        return WebViewBackend.LastStatus(handle);
    }
    /// 视图最近一次看到的导航请求 URL。
    string LastRequest() {
        if (!supported || handle == 0) { return ""; }
        return WebViewBackend.LastRequest(handle);
    }

    /// 在页面中运行 JavaScript 并返回字符串化的结果（出错/无结果时为
    /// ""）。用于读取请求参数、DOM 状态或
    /// 从页面获取的响应体。
    string Eval(string js) {
        if (!supported || handle == 0) { return ""; }
        return WebViewBackend.Eval(handle, js);
    }

    /// `url` 的 Cookie，序列化为 "name=value; name2=value2"（无则为 ""）。
    /// 传 "" 获取存储中的所有 Cookie。
    string GetCookies(string forUrl) {
        if (!supported || handle == 0) { return ""; }
        return WebViewBackend.GetCookies(handle, forUrl);
    }
    /// 为 `url` 的主机在存储中设置 Cookie（路径默认为 "/"）。
    void SetCookie(string forUrl, string cookieName, string cookieValue) {
        if (supported && handle != 0) {
            WebViewBackend.SetCookie(handle, forUrl, cookieName, cookieValue);
        }
    }
    /// 清除共享存储中的所有 Cookie。
    void ClearCookies() {
        if (supported && handle != 0) { WebViewBackend.ClearCookies(handle); }
    }

    /// 隐藏原生视图（对不在屏幕上的标签/面板调用）。
    void Hide() {
        if (created && supported && handle != 0) {
            WebViewBackend.SetVisible(handle, false);
        }
    }

    /// 销毁原生视图并释放其资源。
    void Destroy() {
        if (created && supported && handle != 0) {
            NativeLayer.Forget(handle);
            WebViewBackend.Destroy(handle);
        }
        handle = 0;
        created = false;
    }

    /// 将原生视图放到给定的客户区矩形中并显示，然后
    /// 轮询引擎的变化，更新 Url()/Title() 并触发
    /// NavStart / LoadingChanged / TitleChanged / NavComplete。浏览器运行在
    /// 自己的线程上，因此其事件以这种每帧差异的形式到达 UI。
    /// 在没有原生 Web 视图的平台上，它绘制一个覆盖相同矩形的
    /// 画布内占位符。
    int Render(App app, int x, int y, int w, int h) {
        EnsureCreated(app);
        if (!supported) {
            WebView.PaintPlaceholder(app, x, y, w, h);
            return handle;
        }
        WebViewBackend.SetFrame(handle, x, y, w, h);
        // 可见性不在这里定：原生视图是 OS 兄弟层，永远画在画布之上，
        // 直接 SetVisible(true) 就会把标签条之外的右键菜单、下拉、
        // 模态对话框一起盖住。改为向 App 登记本帧占位，由
        // PresentFrame 在所有自绘 UI 之后算出未被遮挡的区域再下发
        // （完全被盖住时隐藏）。
        NativeLayer.Register(app, handle, x, y, w, h, WebViewBackend.ApplyClip);

        bool dirty = false;
        string request = WebViewBackend.LastRequest(handle);
        if (request != lastSeenRequest) {
            lastSeenRequest = request;
            if (request != "") { NavStart.Raise(); }
            dirty = true;
        }
        bool busy = WebViewBackend.IsLoading(handle);
        if (busy != lastSeenLoading) {
            lastSeenLoading = busy;
            LoadingChanged.Raise();
            dirty = true;
        }

        int seq = WebViewBackend.NavSeq(handle);
        if (seq != lastNavSeq) {
            lastNavSeq = seq;
            url.Set(WebViewBackend.GetUrl(handle));
            title.Set(WebViewBackend.GetTitle(handle));
            NavComplete.Raise();
            dirty = true;
        }
        string docTitle = title.Get();
        if (docTitle != lastSeenTitle) {
            lastSeenTitle = docTitle;
            TitleChanged.Raise();
            dirty = true;
        }
        if (dirty) { app.RequestRedraw(); }
        return handle;
    }

    static void PaintPlaceholder(App app, int x, int y, int w, int h) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        c.FillRect(x, y, w, h, t.bgSecondary);
        c.DrawRect(x, y, w, h, t.borderPrimary, t.borderWidth);
        c.DrawGlyphIn("globe", x, y - app.Scale(28),
            w, h, t.iconSizeLarge, t.textTertiary);
        c.DrawTextCentered(x, y + app.Scale(18), w, h,
            "WebView needs a native backend (Windows WebView2 / macOS WKWebView)",
            t.textSecondary, t.fontSizeMedium);
    }

    static string Normalize(string target) {
        if (target == "") { return ""; }
        if (WebView.HasScheme(target)) { return target; }
        return "https://" + target;
    }

    static bool HasScheme(string s) {
        int n = s.Length;
        for (int i = 0; i + 2 < n; i = i + 1) {
            if (s[i] == ':' && s[i + 1] == '/' && s[i + 2] == '/') { return true; }
        }
        return false;
    }
}
