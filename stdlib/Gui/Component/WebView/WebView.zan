using System;
using Gui;

namespace Gui.Component.WebView;

/// 内嵌的原生 Web 视图（浏览器控件）。
///
/// 由平台浏览器引擎（WebViewBackend）支撑：Windows 上是 Edge WebView2
/// 控制器，由 Zan 直接通过其 COM 接口驱动，
/// macOS 上是 WKWebView，其他平台为占位符（没有原生引擎的后端
/// 返回无句柄，因此 IsSupported() 为 false，Render 绘制
/// 画布内提示而不是嵌入实时浏览器）。
///
/// 原生视图是浮在软件渲染表面之上的兄弟图层，
/// 因此要由所属区域每帧驱动它：
///   WebView web = WebView.CreateWithProfile("");
///   web.NavComplete += () => { ... };   // 加载完成时触发
///   web.Navigate("https://example.com");
///   // 每帧，针对可见标签：
///   web.Render(app, x, y, w, h);
///   // 每帧，针对隐藏标签：
///   web.Hide();
///
/// 暴露常用浏览器功能：历史（Back/Forward/Reload/Stop）、
/// URL 和标题监控（响应式 Url()/Title() 信号 + NavComplete）、
/// 最近一次请求的 URL 和 HTTP 状态、JavaScript 求值（Eval 是
/// 读取请求参数/响应体的通用后门）以及
/// Cookie 访问（GetCookies/SetCookie/ClearCookies）。
class WebView {
    int handle;        // 原生 webview 句柄（0 = 尚未创建/不支持）
    string profileId;  // 隔离配置文件："" = 共享默认存储，否则按账户隔离
    bool created;      // 已尝试原生创建
    bool supported;    // 原生后端已产出可用的 webview
    int lastNavSeq;    // 最近观察到的导航计数器（URL 变化监视器）
    string pendingUrl; // 原生创建前请求的导航
    string pendingHtml;
    string pendingBase;

    string lastSeenRequest;
    string lastSeenTitle;
    bool lastSeenLoading;

    // 原生视图创建前登记的桥接内容，创建时补上（宿主通常在构造后、
    // 第一帧之前就注册 handler / 注入脚本）。
    List<string> pendingHandlers;
    List<string> pendingScripts;   // 每项 "0"/"1" + js，前缀是注入时机
    List<string> pendingStyles;

    SignalString url;
    SignalString title;

    /// 导航完成（或失败）时触发，即当前 URL/标题
    /// 可能已变化。响应式 Url()/Title() 会在其触发前更新。
    UiEvent NavComplete;
    /// 请求新导航时触发（LastRequest() 即其 URL）。
    UiEvent NavStart;
    /// 文档标题变化时触发，包括页面内的更新。
    UiEvent TitleChanged;
    /// 加载开始或结束时触发（IsLoading() 指示是哪种）。
    UiEvent LoadingChanged;

    /// 创建绑定到隔离配置文件的 WebView。共享同一
    /// 非空 profileId 的 WebView 共享 Cookie/localStorage/会话（同一
    /// 账户）；不同 profileId 完全隔离，因此多个账户
    /// 可同时保持登录。空的 profileId 使用共享默认
    /// 存储（旧行为）。配置文件在 Windows（每配置文件一个
    /// WebView2 用户数据文件夹）和 macOS 上生效；其他平台接受并忽略
    /// 该 id。
    WebView(string profileId) {
        this.handle = 0;
        this.profileId = profileId;
        this.created = false;
        this.supported = true;
        this.lastNavSeq = 0;
        this.pendingUrl = "";
        this.pendingHtml = "";
        this.pendingBase = "";
        this.lastSeenRequest = "";
        this.lastSeenTitle = "";
        this.lastSeenLoading = false;
        this.pendingHandlers = new List<string>();
        this.pendingScripts = new List<string>();
        this.pendingStyles = new List<string>();
        this.url = new SignalString("");
        this.title = new SignalString("");
        this.NavComplete = new UiEvent();
        this.NavStart = new UiEvent();
        this.TitleChanged = new UiEvent();
        this.LoadingChanged = new UiEvent();
    }

    /// 使用共享的默认存储创建 WebView。
    WebView() : this("") { }

    /// 同构造：绑定到指定隔离配置文件的 WebView（"" = 共享默认存储）。
    static WebView CreateWithProfile(string profileId) {
        return new WebView(profileId);
    }

    /// 此视图创建时使用的隔离配置文件 id（"" = 共享）。
    string ProfileId() { return profileId; }

    /// 首次 Render 时创建原生视图，并把创建前挂起的内容按序补上：
    /// 消息 handler → 注入脚本 → 注入样式 → 挂起的导航（或 HTML）。
    /// 创建失败则永久回退占位符。
    void EnsureCreated(App app) {
        if (created) { return; }
        created = true;
        handle = WebViewBackend.Create(app.window.GetHandle(), profileId);
        if (handle == 0) {
            supported = false;
            return;
        }
        supported = true;
        for (int i = 0; i < pendingHandlers.Count; i = i + 1) {
            WebViewBackend.AddHandler(handle, pendingHandlers[i]);
        }
        pendingHandlers = new List<string>();
        for (int i = 0; i < pendingScripts.Count; i = i + 1) {
            string spec = pendingScripts[i];
            WebViewBackend.AddScript(handle, spec.Substring(1, spec.Length - 1),
                                     spec[0] == '1');
        }
        pendingScripts = new List<string>();
        for (int i = 0; i < pendingStyles.Count; i = i + 1) {
            WebViewBackend.AddStyle(handle, pendingStyles[i]);
        }
        pendingStyles = new List<string>();
        if (pendingUrl != "") {
            WebViewBackend.Navigate(handle, pendingUrl);
            pendingUrl = "";
        } else if (pendingHtml != "") {
            WebViewBackend.LoadHtml(handle, pendingHtml, pendingBase);
            pendingHtml = "";
            pendingBase = "";
        }
    }

    /// <summary>当前平台有可用的原生 Web 视图时为 true；false 时
    /// Render 画占位符，其余方法皆为安全空操作。</summary>
    bool IsSupported() { return supported; }

    /// <summary>响应式当前 URL/文档标题（每次导航后更新）；非响应式
    /// 快照用 CurrentUrl/CurrentTitle。</summary>
    SignalString Url() { return url; }
    /// 响应式当前文档标题（每次导航后更新）。
    SignalString Title() { return title; }
    /// 当前 URL 的字符串形式（非响应式快照）。
    string CurrentUrl() { return url.Get(); }
    /// 当前文档标题的字符串形式（非响应式快照）。
    string CurrentTitle() { return title.Get(); }

    /// <summary>导航到 URL。无协议的裸主机名视为 https://。原生视图
    /// 创建前调用会把地址挂起，创建时自动消费（后调的 LoadHtml 会
    /// 覆盖挂起的 Navigate，反之亦然）。</summary>
    void Navigate(string target) {
        string u = WebView.Normalize(target);
        if (!created || !supported) {
            pendingUrl = u;
            pendingHtml = "";
            return;
        }
        WebViewBackend.Navigate(handle, u);
    }

    /// <summary>加载内存中的 HTML 字符串（baseUrl 解析相对链接；可为
    /// ""）。原生视图创建前调用同样挂起，创建时消费。</summary>
    void LoadHtml(string html, string baseUrl) {
        if (!created || !supported) {
            pendingHtml = html;
            pendingBase = baseUrl;
            pendingUrl = "";
            return;
        }
        WebViewBackend.LoadHtml(handle, html, baseUrl);
    }

    /// 历史后退一页（未创建/不支持为空操作）。
    void Back() { if (supported && handle != 0) { WebViewBackend.Back(handle); } }
    /// 历史前进一页。
    void Forward() { if (supported && handle != 0) { WebViewBackend.Forward(handle); } }
    /// 重新加载当前页。
    void Reload() { if (supported && handle != 0) { WebViewBackend.Reload(handle); } }
    /// 停止当前加载。
    void Stop() { if (supported && handle != 0) { WebViewBackend.Stop(handle); } }

    /// 能否后退（未创建/不支持为 false）。
    bool CanGoBack() {
        if (!supported || handle == 0) { return false; }
        return WebViewBackend.CanGoBack(handle);
    }
    /// 能否前进（未创建/不支持为 false）。
    bool CanGoForward() {
        if (!supported || handle == 0) { return false; }
        return WebViewBackend.CanGoForward(handle);
    }
    /// 是否正在加载（未创建/不支持为 false）。
    bool IsLoading() {
        if (!supported || handle == 0) { return false; }
        return WebViewBackend.IsLoading(handle);
    }

    /// 最近一次响应的 HTTP 状态码（无响应或非 HTTP 时为 0）。
    int LastStatus() {
        if (!supported || handle == 0) { return 0; }
        return WebViewBackend.LastStatus(handle);
    }
    /// 视图最近一次看到的导航请求 URL。
    string LastRequest() {
        if (!supported || handle == 0) { return ""; }
        return WebViewBackend.LastRequest(handle);
    }

    /// 在页面中运行 JavaScript 并返回字符串化的结果（出错/无结果时为
    /// ""）。用于读取请求参数、DOM 状态或
    /// 从页面获取的响应体。
    string Eval(string js) {
        if (!supported || handle == 0) { return ""; }
        return WebViewBackend.Eval(handle, js);
    }

    // ---- JS ↔ 原生 -------------------------------------------------------

    /// 这个运行时上能不能收页面发来的消息（macOS 的 WKScriptMessageHandler；
    /// 其他后端目前只有 Native→JS 的 <see cref="Eval"/>）。
    bool SupportsMessages() { return WebViewBackend.HasBridge(); }

    /// 让页面可以用
    ///   window.webkit.messageHandlers.&lt;name&gt;.postMessage(x)
    /// 给宿主发消息；消息按 <see cref="TakeMessage"/> 逐条取（和 CEF 那边的
    /// CDP 队列同一套用法）。可在原生视图创建前调用。
    void AddMessageHandler(string handlerName) {
        if (handlerName == "") { return; }
        if (!created || !supported || handle == 0) {
            pendingHandlers.Add(handlerName);
            return;
        }
        WebViewBackend.AddHandler(handle, handlerName);
    }

    /// 撤掉 AddMessageHandler 注册的消息通道（不支持的后端为空操作）。
    void RemoveMessageHandler(string handlerName) {
        if (supported && handle != 0) {
            WebViewBackend.RemoveHandler(handle, handlerName);
        }
    }

    /// 取走一条页面消息，格式 "&lt;handler&gt;\t&lt;body&gt;"（body 是字符串原文，
    /// 其他类型的 postMessage 参数是 JSON）；空队列为 ""。
    string TakeMessage() {
        if (!supported || handle == 0) { return ""; }
        return WebViewBackend.TakeMessage(handle);
    }

    /// 队列里待取的消息数。
    int MessagePending() {
        if (!supported || handle == 0) { return 0; }
        return WebViewBackend.PendingMessages(handle);
    }

    /// 因为迟迟没被取走而丢掉的消息数（队列有界，防止跑飞的页面把内存
    /// 吃光）。
    int MessageDropped() {
        if (!supported || handle == 0) { return 0; }
        return WebViewBackend.DroppedMessages(handle);
    }

    /// 每次导航都注入的脚本：atDocumentEnd=true 在文档解析完后跑（能用
    /// document/window），false 则在页面自己的脚本之前跑（适合装桥）。
    void InjectScript(string js, bool atDocumentEnd) {
        if (js == "") { return; }
        if (!created || !supported || handle == 0) {
            string tag = "0";
            if (atDocumentEnd) { tag = "1"; }
            pendingScripts.Add(tag + js);
            return;
        }
        WebViewBackend.AddScript(handle, js, atDocumentEnd);
    }

    /// 每次导航都注入的 CSS。
    void InjectStyle(string css) {
        if (css == "") { return; }
        if (!created || !supported || handle == 0) {
            pendingStyles.Add(css);
            return;
        }
        WebViewBackend.AddStyle(handle, css);
    }

    /// 撤掉此前注入的所有脚本/样式（下一次导航起生效）。
    void ClearInjected() {
        pendingScripts = new List<string>();
        pendingStyles = new List<string>();
        if (supported && handle != 0) { WebViewBackend.RemoveScripts(handle); }
    }

    /// Native→JS，但不等结果：<see cref="Eval"/> 要等返回值，会自旋事件
    /// 循环，从绘制/事件回调里调不合适。
    void EvalAsync(string js) {
        if (supported && handle != 0) { WebViewBackend.EvalAsync(handle, js); }
    }

    /// `url` 的 Cookie，序列化为 "name=value; name2=value2"（无则为 ""）。
    /// 传 "" 获取存储中的所有 Cookie。
    string GetCookies(string forUrl) {
        if (!supported || handle == 0) { return ""; }
        return WebViewBackend.GetCookies(handle, forUrl);
    }
    /// 为 `url` 的主机在存储中设置 Cookie（路径默认为 "/"）。
    void SetCookie(string forUrl, string cookieName, string cookieValue) {
        if (supported && handle != 0) {
            WebViewBackend.SetCookie(handle, forUrl, cookieName, cookieValue);
        }
    }
    /// 清除共享存储中的所有 Cookie。
    void ClearCookies() {
        if (supported && handle != 0) { WebViewBackend.ClearCookies(handle); }
    }

    /// 清掉这个配置文件的全部网站数据：Cookie、缓存、localStorage、
    /// IndexedDB…（“退出登录并忘记我”）。运行时只支持 Cookie 时退化为
    /// <see cref="ClearCookies"/>。
    void ClearBrowsingData() {
        if (supported && handle != 0) { WebViewBackend.ClearData(handle); }
    }

    /// 隐藏原生视图（对不在屏幕上的标签/面板调用）。
    void Hide() {
        if (created && supported && handle != 0) {
            WebViewBackend.SetVisible(handle, false);
        }
    }

    /// <summary>销毁原生视图并释放其资源。销毁后再调用其他方法均为
    /// 空操作；如需重用应新建实例。</summary>
    void Destroy() {
        if (created && supported && handle != 0) {
            NativeLayer.Forget(handle);
            WebViewBackend.Destroy(handle);
        }
        handle = 0;
        created = false;
    }

    /// 将原生视图放到给定的客户区矩形中并显示，然后
    /// 轮询引擎的变化，更新 Url()/Title() 并触发
    /// NavStart / LoadingChanged / TitleChanged / NavComplete。浏览器运行在
    /// 自己的线程上，因此其事件以这种每帧差异的形式到达 UI。
    /// 在没有原生 Web 视图的平台上，它绘制一个覆盖相同矩形的
    /// 画布内占位符。
    /// <summary>每帧驱动：摆放原生视图、登记裁剪占位并轮询引擎差异
    /// 事件（NavStart/LoadingChanged/TitleChanged/NavComplete）。浏览器
    /// 运行在自己的线程上，事件以这种每帧差异的形式到达 UI，因此
    /// 隐藏的实例必须有人替它调 Hide()（WebViewBox 自动处理）。
    /// 返回原生句柄（不支持时为 0 并画占位符）。</summary>
    int Render(App app, int x, int y, int w, int h) {
        EnsureCreated(app);
        if (!supported) {
            WebView.PaintPlaceholder(app, x, y, w, h);
            return handle;
        }
        WebViewBackend.SetFrame(handle, x, y, w, h);
        // 可见性不在这里定：原生视图是 OS 兄弟层，永远画在画布之上，
        // 直接 SetVisible(true) 就会把标签条之外的右键菜单、下拉、
        // 模态对话框一起盖住。改为向 App 登记本帧占位，由
        // PresentFrame 在所有自绘 UI 之后算出未被遮挡的区域再下发
        // （完全被盖住时隐藏）。
        NativeLayer.Register(app, handle, x, y, w, h, WebViewBackend.ApplyClip);

        bool dirty = false;
        string request = WebViewBackend.LastRequest(handle);
        if (request != lastSeenRequest) {
            lastSeenRequest = request;
            if (request != "") { NavStart.Raise(); }
            dirty = true;
        }
        bool busy = WebViewBackend.IsLoading(handle);
        if (busy != lastSeenLoading) {
            lastSeenLoading = busy;
            LoadingChanged.Raise();
            dirty = true;
        }

        int seq = WebViewBackend.NavSeq(handle);
        if (seq != lastNavSeq) {
            lastNavSeq = seq;
            url.Set(WebViewBackend.GetUrl(handle));
            title.Set(WebViewBackend.GetTitle(handle));
            NavComplete.Raise();
            dirty = true;
        }
        string docTitle = title.Get();
        if (docTitle != lastSeenTitle) {
            lastSeenTitle = docTitle;
            TitleChanged.Raise();
            dirty = true;
        }
        if (dirty) { app.RequestRedraw(); }
        return handle;
    }

    /// 无原生后端时的画布内占位：图标加一行说明文字。
    static void PaintPlaceholder(App app, int x, int y, int w, int h) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        StyleBox s = Style.Part(app, "webview", "placeholder", "", "",
                                "", Style.SNormal());
        StyleBox icon = Style.Part(app, "webview", "icon", "", "",
                                   "", Style.SNormal());
        StyleBox label = Style.Part(app, "webview", "label", "", "",
                                    "", Style.SNormal());
        c.FillRect(x, y, w, h, s.BgOr(0));
        c.DrawRect(x, y, w, h, s.BorderOr(0), t.borderWidth);
        c.DrawGlyphIn("globe", x, y - app.Scale(28),
            w, h, t.iconSizeLarge, icon.FgOr(0));
        c.DrawTextCentered(x, y + app.Scale(18), w, h,
            "WebView needs a native backend (Windows WebView2 / macOS WKWebView / Android system WebView)",
            label.FgOr(0), Style.FontFallback(app, "medium"));
    }

    /// 导航目标补全：没有协议前缀的裸地址加 `https://`。
    static string Normalize(string target) {
        if (target == "") { return ""; }
        if (WebView.HasScheme(target)) { return target; }
        return "https://" + target;
    }

    /// 是否带协议前缀（"://"）。
    static bool HasScheme(string s) {
        int n = s.Length;
        for (int i = 0; i + 2 < n; i = i + 1) {
            if (s[i] == ':' && s[i + 1] == '/' && s[i + 2] == '/') { return true; }
        }
        return false;
    }
}
