# Native driver libraries owned by this component (one -l basename per line;
# blank lines and '#' comments are ignored). zanc discovers this file to bundle
# the driver on --publish; see src/compiler/main.c (zan_discover_drivers).
#
# "<lib> if <symbol-prefix>" = run-time loaded driver: WebView2 dlopens it
# (Interop.Load("WebView2Loader.dll")) instead of declaring [DllImport], so it
# never appears among the linked libs and is bundled only when the image
# actually contains the WebView2 COM binding (any WebView* symbol).
#
# Windows-only payload: on macOS/Android the webview lives inside the zan_gui
# runtime (WKWebView / system WebView), so there are no drivers/<target> dirs
# for those targets and zanc simply skips this driver there.
WebView2Loader if WebView
