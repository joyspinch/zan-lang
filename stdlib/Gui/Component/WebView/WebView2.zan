using System;
using Gui;

namespace Gui.Component.WebView;

/// ICoreWebView2CreateCoreWebView2EnvironmentCompletedHandler::Invoke 及其
/// 控制器/脚本孪生签名：(this, HRESULT, result)。
delegate int WvResultFn(nint self, int hr, nint result);
/// 事件处理器：(this, sender, args)。
delegate int WvEventFn(nint self, nint sender, nint args);
delegate int WvQueryInterfaceFn(nint self, nint riid, nint ppv);
delegate int WvRefFn(nint self);
/// CreateCoreWebView2EnvironmentWithOptions，加载器唯一的扁平导出。
delegate int WvCreateEnvFn(nint browserFolder, nint userDataFolder,
                           nint options, nint handler);

/// <summary>
/// Edge WebView2，由 Zan 直接驱动。
///
/// WebView2 是 COM API：除加载器唯一的扁平导出外，其余都是
/// vtable 分发，其异步调用把结果交给调用方实现的
/// COM 对象。这两者都可用本语言表达——`Com.Call*`
/// 调用 vtable 槽，`ComVtbl` 用 Zan 方法构建回调对象——
/// 因此该后端不需要任何原生垫片。
///
/// 实例通过小整数句柄寻址：回调必须是静态的
/// （它们必须是普通函数地址），每个回调把句柄放在其 COM 对象的
/// 状态字中，事件正是借此找回它的视图。
/// </summary>
class WebView2 {
    static List<WebView2> views;
    static nint loader;
    static nint createEnv;
    static bool comReady;

    int handle;
    nint env;
    nint ctrl;
    nint core;
    nint envSink;
    nint ctlSink;
    nint navSink;
    nint startSink;
    nint srcSink;
    long navToken;
    long startToken;
    long srcToken;
    int navSeq;
    int lastStatus;
    bool loading;
    string url;
    string title;
    string lastRequest;
    string evalResult;
    string cookieResult;
    PumpGate gate;

    /// ICoreWebView2 的 vtable 槽。
    static int SlotGetSource() { return 4; }
    static int SlotNavigate() { return 5; }
    static int SlotNavigateToString() { return 6; }
    static int SlotAddNavigationStarting() { return 7; }
    static int SlotRemoveNavigationStarting() { return 8; }
    static int SlotAddSourceChanged() { return 11; }
    static int SlotRemoveSourceChanged() { return 12; }
    static int SlotAddNavigationCompleted() { return 15; }
    static int SlotRemoveNavigationCompleted() { return 16; }
    static int SlotExecuteScript() { return 29; }
    static int SlotReload() { return 31; }
    static int SlotCanGoBack() { return 38; }
    static int SlotCanGoForward() { return 39; }
    static int SlotGoBack() { return 40; }
    static int SlotGoForward() { return 41; }
    static int SlotStop() { return 43; }
    static int SlotGetDocumentTitle() { return 48; }
    /// ICoreWebView2_2（新增 Cookie 管理器）的 vtable 槽。
    static int SlotGetCookieManager() { return 66; }
    static string IidWebView2_2() {
        return "9E8F0CF8-E670-4B5E-B2BC-73E061E3184C";
    }
    /// ICoreWebView2Controller 的 vtable 槽。
    static int SlotPutIsVisible() { return 4; }
    static int SlotPutBounds() { return 6; }
    static int SlotControllerClose() { return 24; }
    static int SlotGetCoreWebView2() { return 25; }
    /// ICoreWebView2Environment 的 vtable 槽。
    static int SlotCreateController() { return 3; }
    /// ICoreWebView2CookieManager 的 vtable 槽。
    static int SlotCreateCookie() { return 3; }
    static int SlotGetCookies() { return 5; }
    static int SlotAddOrUpdateCookie() { return 6; }
    static int SlotDeleteAllCookies() { return 10; }
    /// ICoreWebView2Cookie / CookieList 的 vtable 槽。
    static int SlotCookieName() { return 3; }
    static int SlotCookieValue() { return 4; }
    static int SlotCookieCount() { return 3; }
    static int SlotCookieAt() { return 4; }
    /// ICoreWebView2NavigationCompletedEventArgs 的 vtable 槽。
    static int SlotIsSuccess() { return 3; }
    static int SlotWebErrorStatus() { return 4; }
    /// ICoreWebView2NavigationStartingEventArgs 的 vtable 槽。
    static int SlotArgsUri() { return 3; }

    static List<WebView2> All() {
        if (WebView2.views == null) { WebView2.views = new List<WebView2>(); }
        return WebView2.views;
    }

    static WebView2 Get(int h) {
        List<WebView2> all = WebView2.All();
        if (h <= 0 || h > all.Count) { return null; }
        return all[h - 1];
    }

    /// 存在 WebView2Loader.dll 和运行时环境时为 true。
    static bool IsAvailable() {
        if (WebView2.createEnv != 0) { return true; }
        if (WebView2.loader == 0) {
            WebView2.loader = Interop.Load("WebView2Loader.dll");
        }
        if (WebView2.loader == 0) { return false; }
        WebView2.createEnv = Interop.Symbol(
            WebView2.loader, "CreateCoreWebView2EnvironmentWithOptions");
        return WebView2.createEnv != 0;
    }

    /// 创建以 `hwnd` 为父窗口的视图，按 `profileId` 隔离（共享同一 id 的视图
    /// 共享 Cookie 和存储）。WebView2 缺失或创建失败时返回 0，
    /// 调用方回退到占位符。
    static int Create(nint hwnd, string profileId) {
        if (hwnd == 0) { return 0; }
        if (!WebView2.IsAvailable()) { return 0; }
        if (!WebView2.comReady) {
            Com.Initialize();
            WebView2.comReady = true;
        }

        WebView2 w = new WebView2();
        w.env = 0;
        w.ctrl = 0;
        w.core = 0;
        w.navSeq = 0;
        w.lastStatus = 0;
        w.loading = false;
        w.url = "";
        w.title = "";
        w.lastRequest = "";
        w.evalResult = "";
        w.cookieResult = "";
        w.gate = new PumpGate();

        List<WebView2> all = WebView2.All();
        all.Add(w);
        w.handle = all.Count;

        if (!w.Start(hwnd, profileId)) {
            w.Dispose();
            return 0;
        }
        return w.handle;
    }

    /// 构建这些 API 所需的四槽 IUnknown+Invoke 回调对象之一，
    /// 并打上本视图句柄的标签。
    nint Sink(nint invoke) {
        ComVtbl v = ComVtbl.Create(4);
        v.Add((nint)WebView2.OnQueryInterface);
        v.Add((nint)WebView2.OnAddRef);
        v.Add((nint)WebView2.OnRelease);
        v.Add(invoke);
        nint obj = v.Build();
        v.SetState(handle);
        return obj;
    }

    bool Start(nint hwnd, string profileId) {
        envSink = this.Sink((nint)WebView2.OnEnvironment);
        nint folder = Wide.Of(WebView2.ProfileDir(profileId));
        WvCreateEnvFn create = (WvCreateEnvFn)WebView2.createEnv;
        gate.Reset();
        int hr = create(0, folder, 0, envSink);
        Wide.Free(folder);
        if (!Com.Ok(hr)) { return false; }
        Pump.Until(gate, 8000);
        if (env == 0) { return false; }

        ctlSink = this.Sink((nint)WebView2.OnController);
        gate.Reset();
        hr = Com.Call2(env, WebView2.SlotCreateController(), hwnd, ctlSink);
        if (Com.Ok(hr)) { Pump.Until(gate, 12000); }
        if (core == 0) { return false; }

        navSink = this.Sink((nint)WebView2.OnNavigationCompleted);
        navToken = this.Subscribe(WebView2.SlotAddNavigationCompleted(), navSink);
        startSink = this.Sink((nint)WebView2.OnNavigationStarting);
        startToken = this.Subscribe(WebView2.SlotAddNavigationStarting(), startSink);
        srcSink = this.Sink((nint)WebView2.OnSourceChanged);
        srcToken = this.Subscribe(WebView2.SlotAddSourceChanged(), srcSink);

        // 以隐藏和空白状态启动；控件每帧从其所占区域
        // 驱动边界和可见性。
        this.SetFrame(0, 0, 0, 0);
        this.SetVisible(false);
        return true;
    }

    /// add_* 接受处理器和一个 EventRegistrationToken 输出参数；
    /// 稍后 remove_* 需要的就是这个 token。
    long Subscribe(int slot, nint sink) {
        nint token = NativeMemory.Alloc(8);
        new Span<long>(token, 1)[0] = 0;
        Com.Call2(core, slot, sink, token);
        long t = new Span<long>(token, 1)[0];
        NativeMemory.Free(token);
        return t;
    }

    void Unsubscribe(int slot, long token) {
        nint cell = NativeMemory.Alloc(8);
        new Span<long>(cell, 1)[0] = token;
        // token 是按值传递的结构体；8 字节时它在寄存器中传递，
        // 因此其值就是参数。
        Com.Call1(core, slot, (nint)token);
        NativeMemory.Free(cell);
    }

    /// %LOCALAPPDATA%\ZanGui\WebView2\<profile>；WebView2 按此文件夹
    /// 划分 Cookie 和存储，这正是配置文件隔离的原理。
    static string ProfileDir(string profileId) {
        string id = profileId;
        if (id == "") { id = "default"; }
        string safe = "";
        for (int i = 0; i < id.Length; i = i + 1) {
            char ch = id[i];
            if (WebView2.IsSafeChar(ch)) { safe = safe + id.Substring(i, 1); }
            else { safe = safe + "_"; }
        }
        string root = Interop.EnvVar("LOCALAPPDATA");
        if (root == "") { root = Interop.EnvVar("TEMP"); }
        return root + "\\ZanGui\\WebView2\\" + safe;
    }

    /// 保证配置文件文件夹是单个安全的路径段。
    static bool IsSafeChar(char ch) {
        if (ch >= 'a' && ch <= 'z') { return true; }
        if (ch >= 'A' && ch <= 'Z') { return true; }
        if (ch >= '0' && ch <= '9') { return true; }
        if (ch == '-' || ch == '_') { return true; }
        return false;
    }

    // ---- 回调（普通函数地址；视图通过句柄查找）----

    /// WebView2 只索取它拿到的接口，因此对任何 riid 都返回
    /// `this` 是完成处理器惯常的应答方式。
    static int OnQueryInterface(nint self, nint riid, nint ppv) {
        if (ppv == 0) { return Com.Fail(); }
        new Span<long>(ppv, 1)[0] = self;
        return 0;
    }

    /// 回调对象与视图同生命周期，因此引用计数只是名义上的。
    static int OnAddRef(nint self) { return 2; }
    static int OnRelease(nint self) { return 1; }

    static int OnEnvironment(nint self, int hr, nint result) {
        WebView2 w = WebView2.Get(ComVtbl.State(self));
        if (w == null) { return 0; }
        if (Com.Ok(hr)) { w.env = Com.Keep(result); }
        w.gate.Signal();
        return 0;
    }

    static int OnController(nint self, int hr, nint result) {
        WebView2 w = WebView2.Get(ComVtbl.State(self));
        if (w == null) { return 0; }
        if (Com.Ok(hr) && result != 0) {
            w.ctrl = Com.Keep(result);
            w.core = Com.Get(w.ctrl, WebView2.SlotGetCoreWebView2());
        }
        w.gate.Signal();
        return 0;
    }

    static int OnNavigationStarting(nint self, nint sender, nint args) {
        WebView2 w = WebView2.Get(ComVtbl.State(self));
        if (w == null) { return 0; }
        if (args != 0) {
            w.lastRequest = Com.GetString(args, WebView2.SlotArgsUri());
        }
        w.loading = true;
        return 0;
    }

    static int OnNavigationCompleted(nint self, nint sender, nint args) {
        WebView2 w = WebView2.Get(ComVtbl.State(self));
        if (w == null) { return 0; }
        if (args != 0) {
            int ok = Com.GetInt(args, WebView2.SlotIsSuccess());
            int status = Com.GetInt(args, WebView2.SlotWebErrorStatus());
            // 以近似 HTTP 的状态报告：加载成功为 200，
            // 否则为 400 + WebView2 错误枚举，调用方可区分
            // 各类失败而无需 WebView2 专属词汇。
            if (ok != 0) { w.lastStatus = 200; }
            else { w.lastStatus = 400 + status; }
        }
        if (sender != 0) {
            w.url = Com.GetString(sender, WebView2.SlotGetSource());
            w.title = Com.GetString(sender, WebView2.SlotGetDocumentTitle());
        }
        w.loading = false;
        w.navSeq = w.navSeq + 1;
        return 0;
    }

    /// SPA 导航无需完整加载即可改变 URL；此回调保持 Url()
    /// 的真实性。
    static int OnSourceChanged(nint self, nint sender, nint args) {
        WebView2 w = WebView2.Get(ComVtbl.State(self));
        if (w == null) { return 0; }
        if (sender != 0) {
            w.url = Com.GetString(sender, WebView2.SlotGetSource());
        }
        w.navSeq = w.navSeq + 1;
        return 0;
    }

    static int OnScriptCompleted(nint self, int hr, nint json) {
        WebView2 w = WebView2.Get(ComVtbl.State(self));
        if (w == null) { return 0; }
        if (Com.Ok(hr)) { w.evalResult = Wide.Read(json); }
        w.gate.Signal();
        return 0;
    }

    static int OnCookiesCompleted(nint self, int hr, nint list) {
        WebView2 w = WebView2.Get(ComVtbl.State(self));
        if (w == null) { return 0; }
        if (Com.Ok(hr) && list != 0) { w.cookieResult = WebView2.Serialize(list); }
        w.gate.Signal();
        return 0;
    }

    /// 将 Cookie 列表呈现为 "name=value; name2=value2"。
    static string Serialize(nint list) {
        int n = Com.GetInt(list, WebView2.SlotCookieCount());
        string outp = "";
        for (int i = 0; i < n; i = i + 1) {
            nint cell = NativeMemory.Alloc(8);
            new Span<long>(cell, 1)[0] = 0;
            int hr = Com.Call2(list, WebView2.SlotCookieAt(), i, cell);
            nint cookie = new Span<long>(cell, 1)[0];
            NativeMemory.Free(cell);
            if (Com.Ok(hr) && cookie != 0) {
                string name = Com.GetString(cookie, WebView2.SlotCookieName());
                string val = Com.GetString(cookie, WebView2.SlotCookieValue());
                if (name != "") {
                    if (outp != "") { outp = outp + "; "; }
                    outp = outp + name + "=" + val;
                }
                Com.Release(cookie);
            }
        }
        return outp;
    }

    // ---- 操作 ----

    void SetFrame(int x, int y, int w, int h) {
        if (ctrl == 0) { return; }
        nint rect = NativeMemory.Alloc(16);
        new Span<int>(rect, 1)[0] = x;
        new Span<int>(rect + 4, 1)[0] = y;
        new Span<int>(rect + 8, 1)[0] = x + w;
        new Span<int>(rect + 12, 1)[0] = y + h;
        // 在 Windows x64 ABI 中，16 字节的 RECT 按地址传递。
        Com.Call1(ctrl, WebView2.SlotPutBounds(), rect);
        NativeMemory.Free(rect);
    }

    void SetVisible(bool visible) {
        if (ctrl == 0) { return; }
        int v = 0;
        if (visible) { v = 1; }
        Com.Call1(ctrl, WebView2.SlotPutIsVisible(), v);
    }

    void Navigate(string target) {
        if (core == 0) { return; }
        nint u = Wide.Of(target);
        Com.Call1(core, WebView2.SlotNavigate(), u);
        Wide.Free(u);
    }

    /// WebView2 没有带 base-url 的 NavigateToString 形式，因此 `baseUrl`
    /// 被接受但忽略。
    void LoadHtml(string html, string baseUrl) {
        if (core == 0) { return; }
        nint h = Wide.Of(html);
        Com.Call1(core, WebView2.SlotNavigateToString(), h);
        Wide.Free(h);
    }

    void Back() { Com.Call0(core, WebView2.SlotGoBack()); }
    void Forward() { Com.Call0(core, WebView2.SlotGoForward()); }
    void Reload() { Com.Call0(core, WebView2.SlotReload()); }
    void StopLoading() { Com.Call0(core, WebView2.SlotStop()); }

    bool CanGoBack() {
        return Com.GetInt(core, WebView2.SlotCanGoBack()) != 0;
    }
    bool CanGoForward() {
        return Com.GetInt(core, WebView2.SlotCanGoForward()) != 0;
    }
    bool IsLoading() { return loading; }
    int NavSeq() { return navSeq; }
    int LastStatus() { return lastStatus; }
    string LastRequest() { return lastRequest; }

    string GetUrl() {
        if (core != 0) { url = Com.GetString(core, WebView2.SlotGetSource()); }
        return url;
    }

    string GetTitle() {
        if (core != 0) {
            title = Com.GetString(core, WebView2.SlotGetDocumentTitle());
        }
        return title;
    }

    /// 运行 JavaScript 并等待其 JSON 结果（出错/超时返回 ""）。
    string Eval(string js) {
        if (core == 0) { return ""; }
        nint sink = this.Sink((nint)WebView2.OnScriptCompleted);
        nint script = Wide.Of(js);
        evalResult = "";
        gate.Reset();
        int hr = Com.Call2(core, WebView2.SlotExecuteScript(), script, sink);
        Wide.Free(script);
        if (Com.Ok(hr)) { Pump.Until(gate, 5000); }
        return evalResult;
    }

    /// ICoreWebView2_2 带有 Cookie 管理器；较旧的运行时
    /// 则不产生任何 Cookie。
    nint Cookies() {
        if (core == 0) { return 0; }
        nint c2 = Com.Query(core, WebView2.IidWebView2_2());
        if (c2 == 0) { return 0; }
        nint cm = Com.Get(c2, WebView2.SlotGetCookieManager());
        Com.Release(c2);
        return cm;
    }

    /// `forUrl` 的 Cookie，形如 "name=value; ..."；"" 表示整个存储。
    string GetCookies(string forUrl) {
        nint cm = this.Cookies();
        if (cm == 0) { return ""; }
        nint sink = this.Sink((nint)WebView2.OnCookiesCompleted);
        nint u = 0;
        if (forUrl != "") { u = Wide.Of(forUrl); }
        cookieResult = "";
        gate.Reset();
        int hr = Com.Call2(cm, WebView2.SlotGetCookies(), u, sink);
        if (u != 0) { Wide.Free(u); }
        if (Com.Ok(hr)) { Pump.Until(gate, 5000); }
        Com.Release(cm);
        return cookieResult;
    }

    /// WebView2 按主机和路径而非 URL 存储 Cookie，因此
    /// 从 `forUrl` 提取主机，并把 Cookie 写到站点根路径。
    void SetCookie(string forUrl, string cookieName, string cookieValue) {
        nint cm = this.Cookies();
        if (cm == 0) { return; }
        string host = WebView2.HostOf(forUrl);
        if (host != "") {
            nint n = Wide.Of(cookieName);
            nint val = Wide.Of(cookieValue);
            nint d = Wide.Of(host);
            nint p = Wide.Of("/");
            nint cell = NativeMemory.Alloc(8);
            new Span<long>(cell, 1)[0] = 0;
            int hr = Com.Call5(cm, WebView2.SlotCreateCookie(), n, val, d, p, cell);
            nint cookie = new Span<long>(cell, 1)[0];
            NativeMemory.Free(cell);
            if (Com.Ok(hr) && cookie != 0) {
                Com.Call1(cm, WebView2.SlotAddOrUpdateCookie(), cookie);
                Com.Release(cookie);
            }
            Wide.Free(n);
            Wide.Free(val);
            Wide.Free(d);
            Wide.Free(p);
        }
        Com.Release(cm);
    }

    void ClearCookies() {
        nint cm = this.Cookies();
        if (cm == 0) { return; }
        Com.Call0(cm, WebView2.SlotDeleteAllCookies());
        Com.Release(cm);
    }

    /// URL 的主机部分：去掉协议、路径、查询和端口。
    static string HostOf(string url) {
        int n = url.Length;
        int start = 0;
        int i = 0;
        while (i + 2 < n) {
            if (url[i] == ':' && url[i + 1] == '/' && url[i + 2] == '/') {
                start = i + 3;
                i = n;
            } else {
                i = i + 1;
            }
        }
        string host = "";
        i = start;
        while (i < n) {
            char ch = url[i];
            if (ch == '/' || ch == '?' || ch == '#' || ch == ':') { return host; }
            host = host + url.Substring(i, 1);
            i = i + 1;
        }
        return host;
    }

    void Dispose() {
        if (core != 0) {
            this.Unsubscribe(WebView2.SlotRemoveNavigationCompleted(), navToken);
            this.Unsubscribe(WebView2.SlotRemoveNavigationStarting(), startToken);
            this.Unsubscribe(WebView2.SlotRemoveSourceChanged(), srcToken);
            Com.Release(core);
            core = 0;
        }
        if (ctrl != 0) {
            Com.Call0(ctrl, WebView2.SlotControllerClose());
            Com.Release(ctrl);
            ctrl = 0;
        }
        if (env != 0) {
            Com.Release(env);
            env = 0;
        }
    }
}
