using System;
using Gui;
using Gui.Widget;

namespace Gui.Component;

/// 具名停靠边，布局中写 `DockSide.Left()` 而不是魔法整数。
/// Left/Right 是通高列，Bottom 是中央区域下方的条，
/// Center 是其他所有面板围绕停靠的区域。
class DockSide {
    static int Left() { return 0; }
    static int Right() { return 1; }
    static int Bottom() { return 2; }
    static int Center() { return 3; }
}

/// 一个可停靠面板：稳定 id（用于持久化和查找）、
/// 标签页上显示的标题，以及上次布局解析出的内容矩形。
/// `headerless` 面板（如 IDE 的文档区）不绘制标签页，也不能被
/// 拖拽或关闭——其他面板围绕它们停靠。
class DockPanel {
    string id;
    string title;
    /// 宿主面板切换器的图标名（见 DockHost.AddSwitches）。
    string icon;
    /// 一行说明面板用途的文字，显示在其切换器的悬停提示中。
    string tip;
    bool closable;
    bool headerless;
    bool hidden;
    /// 面板上次停靠的边——Show() 将其放回的地方。
    int home;
    /// 关闭时所在分组的 key、在该分组里的标签序号，以及该分组
    /// 在同侧分组中的序号——Show() 据此把面板放回原来的位置，
    /// 而不是简单地并到该侧最后一个分组的末尾。
    int homeKey;
    int homeAt;
    int homeSideIdx;
    Rect body;

    DockPanel(string id, string title, bool closable) {
        this.id = id;
        this.title = title;
        this.icon = "grid";
        this.tip = "";
        this.closable = closable;
        this.headerless = false;
        this.hidden = false;
        this.home = DockSide.Left();
        this.homeKey = 0;
        this.homeAt = 0;
        this.homeSideIdx = 0;
        this.body = new Rect(0, 0, 0, 0);
    }
}

/// 共享同一区域的面板堆栈：顶部是标签条，
/// 下方是活动面板的内容。同一侧的分组沿该侧的
/// 交叉轴排列（left/right 垂直堆叠，bottom/center 并排），
/// 相邻分组之间有可拖拽的分隔条。
class DockGroup {
    /// 在列表变动中保持稳定的身份（停靠时分组会被移动和移除），
    /// 代码可以跨一次变更持有一个分组。
    int key;
    static int nextKey;

    int side;
    List<string> ids;
    int active;
    /// 交叉轴尺寸（像素）。首次布局得出实际值前 <= 0
    /// `weight`；此后由拖拽分隔手柄决定。
    int extent;
    int weight;
    Rect bounds;
    Rect header;
    Rect body;

    DockGroup(int side, int weight) {
        DockGroup.nextKey = DockGroup.nextKey + 1;
        this.key = DockGroup.nextKey;
        this.side = side;
        this.ids = new List<string>();
        this.active = 0;
        this.extent = 0;
        this.weight = weight;
        this.bounds = new Rect(0, 0, 0, 0);
        this.header = new Rect(0, 0, 0, 0);
        this.body = new Rect(0, 0, 0, 0);
    }
}

/// <summary>
/// 停靠布局管理器——IDE 风格窗口的外壳。面板位于
/// 停靠到左、右、下或中央的标签组中；每个组都可以
/// 拖动分隔手柄调整大小，每个标签可拖到另一个
/// 组（或拖到边缘以在那里新建组）并关闭，整个
/// 布局会序列化为字符串，重启后仍能恢复。
///
/// 保留模式：宿主只创建一次、面板只注册一次，然后每帧
/// 在 Begin 与 End 之间驱动它，把每个面板画进宿主交回的矩形
/// 中：
///
///   // 仅一次：
///   DockHost dock = new DockHost();
///   dock.Register("explorer", "EXPLORER", DockSide.Left(), true, true);
///   dock.Register("outline",  "OUTLINE",  DockSide.Left(), true, true);
///   dock.RegisterFixed("editor", "Editor");            // 中央文档区
///   dock.Register("output", "OUTPUT", DockSide.Bottom(), true, true);
///   dock.LoadLayout(File.ReadAllText(layoutPath));     // 可选
///
///   // 每帧：
///   dock.Begin(app, area);
///   RenderExplorer(app, dock.Content("explorer"));     // 隐藏时为空矩形
///   RenderEditor(app, dock.Content("editor"));
///   RenderOutput(app, dock.Content("output"));
///   dock.End(app);                                     // 拖拽幽灵 + 放置提示
///   if (dock.TakeChanged()) { File.WriteAllText(layoutPath, dock.SaveLayout()); }
///
/// 关闭的面板只是隐藏而不会被遗忘：HiddenIds() 为"恢复
/// 面板"菜单提供数据，Show(id) 可将其停靠回原位置。
/// </summary>
class DockHost {
    List<DockPanel> panels;
    List<DockGroup> groups;

    /// 各侧尺寸（像素）：左右为宽度，底部为高度。
    int leftW;
    int rightW;
    int bottomH;
    bool sized;

    /// 拖拽状态：正在拖拽的面板和已解析的放置目标。
    /// dropKind：0 = 无，1 = 并入 `dropGroup`，2 = 在 `dropSide` 新建组
    /// ，索引为 `dropIndex`。
    bool dragging;
    bool dragArmed;
    string dragId;
    int dropKind;
    int dropGroup;
    int dropSide;
    int dropIndex;
    Rect dropRect;

    /// 面板菜单（右键标签条）：列出已关闭的面板，以便
    /// 重新停靠。无关闭面板时显示 `emptyMenuLabel`，它
    /// 可设置，方便宿主本地化。
    bool menuOpen;
    int menuX;
    int menuY;
    string emptyMenuLabel;

    /// Ribbon 面板开关：它们对应的 id 以及在
    /// 宿主命令列表中的起始位置（见 AddSwitches）。
    List<string> switchIds;
    int switchBase;
    /// 点击开关会做什么，附加到其提示中（见 SetSwitchHints）。
    string switchHideHint;
    string switchShowHint;

    string lastClosed;
    bool changed;
    /// 正在进行的调整大小拖拽：松开时提升为 `changed`，让宿主
    /// 持久化布局时只写入一次，而不是每帧一次。
    bool pendingResize;
    Rect area;
    int headerH;

    DockHost() {
        this.panels = new List<DockPanel>();
        this.groups = new List<DockGroup>();
        this.leftW = 0;
        this.rightW = 0;
        this.bottomH = 0;
        this.sized = false;
        this.dragging = false;
        this.dragArmed = false;
        this.dragId = "";
        this.dropKind = 0;
        this.dropGroup = -1;
        this.dropSide = -1;
        this.dropIndex = 0;
        this.dropRect = new Rect(0, 0, 0, 0);
        this.menuOpen = false;
        this.menuX = 0;
        this.menuY = 0;
        this.emptyMenuLabel = "No closed panels";
        this.switchIds = new List<string>();
        this.switchBase = 0 - 1;
        this.switchHideHint = "Click to hide this panel";
        this.switchShowHint = "Click to show this panel";
        this.lastClosed = "";
        this.changed = false;
        this.pendingResize = false;
        this.area = new Rect(0, 0, 0, 0);
        this.headerH = 0;
    }

    // ---- 模型 ----

    DockPanel Find(string id) {
        for (int i = 0; i < panels.Count; i = i + 1) {
            if (panels[i].id == id) { return panels[i]; }
        }
        return null;
    }

    /// 包含 `id` 的组索引；面板已关闭时为 -1。
    int GroupOf(string id) {
        for (int i = 0; i < groups.Count; i = i + 1) {
            DockGroup g = groups[i];
            for (int j = 0; j < g.ids.Count; j = j + 1) {
                if (g.ids[j] == id) { return i; }
            }
        }
        return -1;
    }

    /// 注册面板。`newGroup` 在该侧新建一个标签组；
    /// 否则面板加入该侧最后一个组。注册是
    /// 幂等的，因此宿主可以在恢复的布局上重建。
    void Register(string id, string title, int side, bool closable, bool newGroup) {
        if (this.Find(id) != null) { return; }
        DockPanel p = new DockPanel(id, title, closable);
        p.home = side;
        panels.Add(p);
        DockGroup g = null;
        if (!newGroup) { g = this.LastGroupOf(side); }
        if (g == null) {
            g = new DockGroup(side, 100);
            groups.Add(g);
        }
        g.ids.Add(id);
    }

    /// 注册固定文档区：一个无标题栏、不可关闭的中央面板，
    /// 其他面板围绕它停靠（宿主不为它绘制标签，因此
    /// 屏幕上只有调用方自己的文档标签栏）。
    void RegisterFixed(string id, string title) {
        this.Register(id, title, DockSide.Center(), false, true);
        DockPanel p = this.Find(id);
        if (p != null) { p.headerless = true; }
    }

    DockGroup LastGroupOf(int side) {
        DockGroup found = null;
        for (int i = 0; i < groups.Count; i = i + 1) {
            if (groups[i].side == side) { found = groups[i]; }
        }
        return found;
    }

    /// 为包含 `id` 的组设置其所在侧交叉轴的初始占比
    /// （相对于该侧其他组）。用户拖动过手柄或恢复过保存的布局后
    /// 此设置将被忽略。
    void SetWeight(string id, int weight) {
        int gi = this.GroupOf(id);
        if (gi < 0) { return; }
        groups[gi].weight = weight;
    }

    /// 设置某一侧的像素尺寸（左右为宽度，底部为高度）。
    void SetSideExtent(int side, int px) {
        if (side == 0) { leftW = px; }
        else if (side == 1) { rightW = px; }
        else if (side == 2) { bottomH = px; }
        sized = true;
    }

    bool Visible(string id) {
        DockPanel p = this.Find(id);
        if (p == null) { return false; }
        if (p.hidden) { return false; }
        return p.body.width > 0 && p.body.height > 0;
    }

    /// 上一次 Begin() 解析出的内容矩形。隐藏（或未激活）的
    /// 面板得到零尺寸矩形，调用方可以用
    /// 单个 `if (r.width <= 0) { }` 守卫跳过渲染，或直接画到空处。
    Rect Content(string id) {
        DockPanel p = this.Find(id);
        if (p == null) { return new Rect(0, 0, 0, 0); }
        return p.body;
    }

    /// 与 Content 类似，但隐藏面板得到一个停在屏幕外远处的 1x1 矩形，
    /// 而不是零尺寸矩形。始终渲染（并注册命中区域）的即时模式内容
    /// 可以不加守卫：它只是画在屏幕外而已。
    Rect ContentParked(string id) {
        DockPanel p = this.Find(id);
        if (p == null || p.hidden || p.body.width <= 0 || p.body.height <= 0) {
            return new Rect(0 - 30000, 0 - 30000, 1, 1);
        }
        return p.body;
    }

    string Title(string id) {
        DockPanel p = this.Find(id);
        if (p == null) { return ""; }
        return p.title;
    }

    /// 重命名面板标题（例如跟随 UI 语言切换）。
    void SetTitle(string id, string title) {
        DockPanel p = this.Find(id);
        if (p != null) { p.title = title; }
    }

    /// 设置面板 Ribbon 开关显示的图标。
    void SetIcon(string id, string icon) {
        DockPanel p = this.Find(id);
        if (p != null) { p.icon = icon; }
    }

    /// 描述面板用途；其 Ribbon 开关悬停时显示该描述。
    void SetTip(string id, string text) {
        DockPanel p = this.Find(id);
        if (p != null) { p.tip = text; }
    }

    /// 附加到每个开关提示的本地化"点击作用"说明。
    void SetSwitchHints(string hideHint, string showHint) {
        switchHideHint = hideHint;
        switchShowHint = showHint;
    }

    string SwitchTip(DockPanel p) {
        string hint = switchShowHint;
        if (!p.hidden) { hint = switchHideHint; }
        if (p.tip == "") { return hint; }
        if (hint == "") { return p.tip; }
        return p.tip + "\n" + hint;
    }

    // ---- 面板开关 ----

    /// 为每个可关闭面板向 ribbon 命令列表追加一个图标开关——
    /// 即工具栏的"面板"区段。开关位于列表尾部，
    /// 因此宿主仍可按索引访问自己的命令，
    /// HandleRibbon() 消费它们的点击。（重新）构建命令列表后立即调用；
    /// 返回开关起始的索引。
    ///
    ///   dock.AddSwitches(cmds);                    // 在 BuildRibbon() 之后
    ///   dock.SyncSwitches(cmds);                   // 每帧
    ///   int pos = Ribbon.Render(app, x, y, w, h, cmds);
    ///   if (!dock.HandleRibbon(pos)) { ...own commands... }
    int AddSwitches(List<RibbonCmd> cmds) {
        switchBase = cmds.Count;
        switchIds = new List<string>();
        for (int i = 0; i < panels.Count; i = i + 1) {
            DockPanel p = panels[i];
            if (p.closable && !p.headerless) {
                switchIds.Add(p.id);
                cmds.Add(RibbonCmd.Switch(p.icon, p.title, !p.hidden));
            }
        }
        return switchBase;
    }

    /// 向选项卡式 ribbon 的组列表追加一个带标题的"面板"图标开关区段（每个可关闭面板一个）——
    /// 即 View 选项卡对应的停靠版本。
    /// 每帧构建组，开关承载实时的
    /// 可见性；HandleRibbon() 消费它们的点击：
    ///
    ///   List<RibbonGroup> groups = BuildMyGroups(tab);
    ///   if (tab == viewTab) { dock.AddSwitchGroup(groups, "Panels"); }
    ///   else { dock.ClearSwitches(); }
    ///   int pos = Ribbon.RenderTabbed(app, x, y, w, tabs, activeTab, groups);
    ///   if (!dock.HandleRibbon(pos)) { ...own commands... }
    void AddSwitchGroup(List<RibbonGroup> groups, string title) {
        switchBase = 0;
        for (int g = 0; g < groups.Count; g = g + 1) {
            switchBase = switchBase + groups[g].items.Count;
        }
        switchIds = new List<string>();
        RibbonGroup grp = new RibbonGroup(title);
        for (int i = 0; i < panels.Count; i = i + 1) {
            DockPanel p = panels[i];
            if (p.closable && !p.headerless) {
                switchIds.Add(p.id);
                grp.Add(RibbonItem.Toggle(p.icon, p.title, !p.hidden)
                    .SetTip(this.SwitchTip(p)));
            }
        }
        groups.Add(grp);
    }

    /// 丢弃开关映射——用于显示它们的工具栏消失时（另一个 ribbon 选项卡），
    /// 这样任何点击都不会被误认为是开关点击。
    void ClearSwitches() {
        switchIds = new List<string>();
        switchBase = 0 - 1;
    }

    /// 根据实时布局刷新开关的点亮状态（和标签）。
    void SyncSwitches(List<RibbonCmd> cmds) {
        for (int i = 0; i < switchIds.Count; i = i + 1) {
            int at = switchBase + i;
            if (at >= cmds.Count) { return; }
            DockPanel p = this.Find(switchIds[i]);
            if (p != null) {
                cmds[at].SetOn(!p.hidden);
                cmds[at].label = p.title;
                cmds[at].icon = p.icon;
            }
        }
    }

    /// 切换 ribbon 点击命中的面板。点击是面板开关时返回 true
    /// （宿主不应将其作为命令分发）。
    bool HandleRibbon(int pos) {
        if (switchBase < 0) { return false; }
        int i = pos - switchBase;
        if (i < 0 || i >= switchIds.Count) { return false; }
        this.Toggle(switchIds[i]);
        return true;
    }

    /// 隐藏面板并将其移出所在组（若它是最后一个标签则删除该组）。
    /// 面板仍保持注册状态，可随时恢复。
    void Close(string id) {
        DockPanel p = this.Find(id);
        if (p == null) { return; }
        if (p.hidden) { return; }
        this.NoteHome(p);
        p.hidden = true;
        p.body = new Rect(0, 0, 0, 0);
        this.Detach(id);
        lastClosed = id;
        changed = true;
    }

    /// 记住面板当前所在的分组、标签序号和该分组在同侧的序号，
    /// 供 Show() 原位恢复。
    void NoteHome(DockPanel p) {
        int gi = this.GroupOf(p.id);
        if (gi < 0) { return; }
        DockGroup g = groups[gi];
        p.home = g.side;
        p.homeKey = g.key;
        p.homeAt = this.IndexIn(g, p.id);
        p.homeSideIdx = this.SideIndexOf(gi);
    }

    /// 分组在同侧分组中的序号（0 = 该侧第一个）。
    int SideIndexOf(int gi) {
        int n = 0;
        for (int i = 0; i < gi; i = i + 1) {
            if (groups[i].side == groups[gi].side) { n = n + 1; }
        }
        return n;
    }

    /// 同侧第 `at` 个分组在 groups 列表中的插入位置。
    int InsertPosFor(int side, int at) {
        int n = 0;
        for (int i = 0; i < groups.Count; i = i + 1) {
            if (groups[i].side != side) { continue; }
            if (n == at) { return i; }
            n = n + 1;
        }
        return groups.Count;
    }

    int GroupWithKey(int key) {
        for (int i = 0; i < groups.Count; i = i + 1) {
            if (groups[i].key == key) { return i; }
        }
        return 0 - 1;
    }

    void Detach(string id) {
        int gi = this.GroupOf(id);
        if (gi < 0) { return; }
        DockGroup g = groups[gi];
        for (int j = 0; j < g.ids.Count; j = j + 1) {
            if (g.ids[j] == id) {
                g.ids.RemoveAt(j);
                if (g.active > j) { g.active = g.active - 1; }
                if (g.active >= g.ids.Count) { g.active = g.ids.Count - 1; }
                if (g.active < 0) { g.active = 0; }
                break;
            }
        }
        if (g.ids.Count == 0) { groups.RemoveAt(gi); }
    }

    /// 重新停靠已关闭的面板：若 `side` 上有打开的组则并入其中，
    /// 否则在该侧新建组。同时选中该面板。
    void ShowOn(string id, int side) {
        DockPanel p = this.Find(id);
        if (p == null) { return; }
        p.hidden = false;
        p.home = side;
        if (this.GroupOf(id) < 0) {
            DockGroup g = this.LastGroupOf(side);
            if (g == null) {
                g = new DockGroup(side, 100);
                groups.Add(g);
            }
            g.ids.Add(id);
        }
        int gi = this.GroupOf(id);
        if (gi >= 0) { groups[gi].active = this.IndexIn(groups[gi], id); }
        changed = true;
    }

    bool IsHidden(string id) {
        DockPanel p = this.Find(id);
        if (p == null) { return true; }
        return p.hidden;
    }

    /// 面板的显示/隐藏开关——"面板"工具栏按钮所驱动的内容。
    void Toggle(string id) {
        if (this.IsHidden(id)) { this.Show(id); } else { this.Close(id); }
    }

    /// 把已关闭的面板放回关闭前的位置：原分组还在就插回原来的
    /// 标签序号，原分组已经空掉被移除就在同侧原来的位置重建它。
    void Show(string id) {
        DockPanel p = this.Find(id);
        if (p == null) { return; }
        if (!p.hidden) { this.Focus(id); return; }
        if (this.GroupOf(id) >= 0) { this.ShowOn(id, p.home); return; }
        int gi = this.GroupWithKey(p.homeKey);
        if (gi < 0) {
            DockGroup ng = new DockGroup(p.home, 100);
            int at = this.InsertPosFor(p.home, p.homeSideIdx);
            groups.Insert(at, ng);
            gi = this.GroupWithKey(ng.key);
        }
        DockGroup g = groups[gi];
        int slot = p.homeAt;
        if (slot < 0) { slot = 0; }
        if (slot > g.ids.Count) { slot = g.ids.Count; }
        g.ids.Insert(slot, id);
        p.hidden = false;
        p.home = g.side;
        g.active = this.IndexIn(g, id);
        changed = true;
    }

    int IndexIn(DockGroup g, string id) {
        for (int j = 0; j < g.ids.Count; j = j + 1) {
            if (g.ids[j] == id) { return j; }
        }
        return 0;
    }

    /// 所有已关闭面板的 id，按注册顺序——供"恢复面板"菜单
    /// 作为数据模型。
    List<string> HiddenIds() {
        List<string> outIds = new List<string>();
        for (int i = 0; i < panels.Count; i = i + 1) {
            if (panels[i].hidden) { outIds.Add(panels[i].id); }
        }
        return outIds;
    }

    /// 将面板带到其组的最前面（若已关闭，先停靠回原位
    /// ）。
    void Focus(string id) {
        DockPanel p = this.Find(id);
        if (p == null) { return; }
        if (p.hidden) {
            this.Show(id);
            return;
        }
        int gi = this.GroupOf(id);
        if (gi >= 0) { groups[gi].active = this.IndexIn(groups[gi], id); }
    }

    /// 自上次调用以来被关闭的面板，或 ""——让宿主记录它或
    /// 销毁面板的资源。
    string TakeClosed() {
        string s = lastClosed;
        lastClosed = "";
        return s;
    }

    /// 布局发生变化（调整大小、停靠、关闭、恢复）时返回一次 true——
    /// 提示应持久化 SaveLayout()。
    bool TakeChanged() {
        bool c = changed;
        changed = false;
        return c;
    }

    // ---- 持久化 ----

    /// 将各侧、组和隐藏面板序列化为一行，例如
    /// `v1;S=240,280,160;G=0,180,0,explorer|outline;G=3,0,0,editor;H=terminal:2`
    /// （隐藏面板携带它应恢复到的侧边）。
    /// 加载时跳过未知 id，因此该格式能容忍不同版本间
    /// 出现和消失的面板。
    string SaveLayout() {
        string s = "v1;S=" + Convert.ToString(leftW) + ","
            + Convert.ToString(rightW) + "," + Convert.ToString(bottomH);
        for (int i = 0; i < groups.Count; i = i + 1) {
            DockGroup g = groups[i];
            s = s + ";G=" + Convert.ToString(g.side) + ","
                + Convert.ToString(g.extent) + "," + Convert.ToString(g.active);
            for (int j = 0; j < g.ids.Count; j = j + 1) {
                if (j == 0) { s = s + ","; } else { s = s + "|"; }
                s = s + g.ids[j];
            }
        }
        string hid = "";
        for (int k = 0; k < panels.Count; k = k + 1) {
            if (panels[k].hidden) {
                if (hid != "") { hid = hid + "|"; }
                hid = hid + panels[k].id + ":" + Convert.ToString(panels[k].home);
            }
        }
        if (hid != "") { s = s + ";H=" + hid; }
        return s;
    }

    /// 恢复 SaveLayout 写入的布局。布局未提及的面板
    /// 保留其注册位置；布局提到但未注册的 id 被忽略。
    /// 当字符串不是本版本能理解的布局时返回 false
    /// （调用方此时保留默认设置）。
    bool LoadLayout(string text) {
        if (text == null) { return false; }
        List<string> parts = DockHost.SplitOn(text, ";");
        if (parts.Count == 0) { return false; }
        if (parts[0] != "v1") { return false; }

        List<DockGroup> loaded = new List<DockGroup>();
        List<string> hidden = new List<string>();
        int i = 1;
        while (i < parts.Count) {
            string seg = parts[i];
            if (DockHost.HasPrefix(seg, "S=")) {
                List<string> nums = DockHost.SplitOn(DockHost.After(seg, 2), ",");
                if (nums.Count >= 3) {
                    leftW = Convert.ToInt32(nums[0]);
                    rightW = Convert.ToInt32(nums[1]);
                    bottomH = Convert.ToInt32(nums[2]);
                    sized = true;
                }
            } else if (DockHost.HasPrefix(seg, "G=")) {
                List<string> f = DockHost.SplitOn(DockHost.After(seg, 2), ",");
                if (f.Count >= 4) {
                    DockGroup g = new DockGroup(Convert.ToInt32(f[0]), 100);
                    g.extent = Convert.ToInt32(f[1]);
                    g.active = Convert.ToInt32(f[2]);
                    List<string> ids = DockHost.SplitOn(f[3], "|");
                    for (int j = 0; j < ids.Count; j = j + 1) {
                        if (this.Find(ids[j]) != null) { g.ids.Add(ids[j]); }
                    }
                    if (g.ids.Count > 0) {
                        if (g.active >= g.ids.Count) { g.active = g.ids.Count - 1; }
                        if (g.active < 0) { g.active = 0; }
                        loaded.Add(g);
                    }
                }
            } else if (DockHost.HasPrefix(seg, "H=")) {
                List<string> hs = DockHost.SplitOn(DockHost.After(seg, 2), "|");
                for (int hi = 0; hi < hs.Count; hi = hi + 1) {
                    List<string> hf = DockHost.SplitOn(hs[hi], ":");
                    if (hf.Count >= 1) {
                        hidden.Add(hf[0]);
                        DockPanel hp = this.Find(hf[0]);
                        if (hp != null && hf.Count >= 2) {
                            hp.home = Convert.ToInt32(hf[1]);
                        }
                    }
                }
            }
            i = i + 1;
        }
        if (loaded.Count == 0) { return false; }

        // 保留保存的布局从未提及的面板：将它们重新停靠到
        // 其注册所在侧的最后一个组（或新建组）。
        List<string> placed = new List<string>();
        for (int gi = 0; gi < loaded.Count; gi = gi + 1) {
            for (int j = 0; j < loaded[gi].ids.Count; j = j + 1) {
                placed.Add(loaded[gi].ids[j]);
            }
        }
        List<DockGroup> old = groups;
        groups = loaded;
        for (int p = 0; p < panels.Count; p = p + 1) {
            DockPanel pan = panels[p];
            pan.hidden = DockHost.ListHas(hidden, pan.id);
            if (!DockHost.ListHas(placed, pan.id) && !pan.hidden) {
                int side = DockHost.SideOfIn(old, pan.id);
                DockGroup g = this.LastGroupOf(side);
                if (g == null) {
                    g = new DockGroup(side, 100);
                    groups.Add(g);
                }
                g.ids.Add(pan.id);
            }
        }
        // 记住每个停靠面板最终所在的位置，这样关闭后再恢复
        // 它时能回到同一侧。
        for (int hp2 = 0; hp2 < panels.Count; hp2 = hp2 + 1) {
            int hg = this.GroupOf(panels[hp2].id);
            if (hg >= 0) { panels[hp2].home = groups[hg].side; }
        }
        return true;
    }

    static int SideOfIn(List<DockGroup> gs, string id) {
        for (int i = 0; i < gs.Count; i = i + 1) {
            for (int j = 0; j < gs[i].ids.Count; j = j + 1) {
                if (gs[i].ids[j] == id) { return gs[i].side; }
            }
        }
        return DockSide.Left();
    }

    static bool ListHas(List<string> xs, string v) {
        for (int i = 0; i < xs.Count; i = i + 1) {
            if (xs[i] == v) { return true; }
        }
        return false;
    }

    static bool HasPrefix(string s, string p) {
        if (s.Length < p.Length) { return false; }
        return s.Substring(0, p.Length) == p;
    }

    static string After(string s, int n) {
        if (s.Length <= n) { return ""; }
        return s.Substring(n, s.Length - n);
    }

    /// 按单字符分隔符拆分，丢弃空段。
    static List<string> SplitOn(string s, string sep) {
        List<string> outp = new List<string>();
        int start = 0;
        int n = s.Length;
        for (int i = 0; i < n; i = i + 1) {
            if (s.Substring(i, 1) == sep) {
                if (i > start) { outp.Add(s.Substring(start, i - start)); }
                start = i + 1;
            }
        }
        if (n > start) { outp.Add(s.Substring(start, n - start)); }
        return outp;
    }

    // ---- 布局 ----

    bool SideHasVisible(int side) {
        for (int i = 0; i < groups.Count; i = i + 1) {
            if (groups[i].side == side && this.GroupHasVisible(groups[i])) { return true; }
        }
        return false;
    }

    bool GroupHasVisible(DockGroup g) {
        for (int j = 0; j < g.ids.Count; j = j + 1) {
            DockPanel p = this.Find(g.ids[j]);
            if (p != null && !p.hidden) { return true; }
        }
        return false;
    }

    List<DockGroup> VisibleGroups(int side) {
        List<DockGroup> gs = new List<DockGroup>();
        for (int i = 0; i < groups.Count; i = i + 1) {
            if (groups[i].side == side && this.GroupHasVisible(groups[i])) { gs.Add(groups[i]); }
        }
        return gs;
    }

    /// 在 `a` 内布置整个停靠区，绘制分隔手柄和每个
    /// 组的标签条，并处理调整大小拖拽、标签点击、关闭和
    /// 标签拖拽的开始。每帧在绘制面板之前调用一次。
    void Begin(App app, Rect a) {
        area = a;
        if (pendingResize && app.EventKind() == 3) {
            pendingResize = false;
            changed = true;
        }
        headerH = app.theme.heightMedium;
        int hs = app.Scale(5);
        int minSide = app.Scale(140);
        int minCenter = app.Scale(240);
        int minBottom = app.Scale(72);

        if (!sized) {
            leftW = app.Scale(240);
            rightW = app.Scale(280);
            bottomH = app.Scale(170);
            sized = true;
        }

        for (int i = 0; i < panels.Count; i = i + 1) {
            panels[i].body = new Rect(0, 0, 0, 0);
        }

        bool hasL = this.SideHasVisible(DockSide.Left());
        bool hasR = this.SideHasVisible(DockSide.Right());
        bool hasB = this.SideHasVisible(DockSide.Bottom());

        int lw = 0;
        int rw = 0;
        int bh = 0;
        int hl = 0;
        int hr = 0;
        int hb = 0;
        if (hasL) { lw = leftW; hl = hs; }
        if (hasR) { rw = rightW; hr = hs; }
        if (hasB) { bh = bottomH; hb = hs; }

        // 最小化的窗口会报告一个极小的客户区矩形（如 237x39），而且窗口
        // 可以被缩得远小于侧边面板所需。此处的
        // 钳制在这种情况下仅用于显示：写回钳制后的
        // 宽度会永久缩小用户调好的面板，因此
        // 最小化 -> 恢复会让每个分隔跳到最小值。只有
        // 实际未被钳制布局过的尺寸才应持久化。
        bool lClamped = false;
        bool rClamped = false;
        bool bClamped = false;
        if (hasL && lw < minSide) { lw = minSide; lClamped = true; }
        if (hasR && rw < minSide) { rw = minSide; rClamped = true; }
        int budget = a.width - hl - hr - minCenter;
        if (budget < 0) { budget = 0; }
        int over = lw + rw - budget;
        if (over > 0) {
            int cut = over;
            if (cut > rw) { cut = rw; }
            rw = rw - cut;
            if (cut > 0) { rClamped = true; }
            over = over - cut;
            if (over > 0) {
                lw = lw - over;
                if (lw < 0) { lw = 0; }
                lClamped = true;
            }
        }
        if (hasB) {
            int maxB = a.height - hb - app.Scale(120);
            if (bh > maxB) { bh = maxB; bClamped = true; }
            if (bh < minBottom) { bh = minBottom; bClamped = true; }
            if (bh < 0) { bh = 0; bClamped = true; }
        }
        if (hasL && !lClamped) { leftW = lw; }
        if (hasR && !rClamped) { rightW = rw; }
        if (hasB && !bClamped) { bottomH = bh; }

        int midX = a.x + lw + hl;
        int midW = a.width - lw - hl - rw - hr;
        if (midW < 0) { midW = 0; }

        // ---- 侧边分隔手柄 ----
        if (hasL) {
            int nx = this.Handle(app, a.x + lw, a.y, hs, a.height, true);
            if (nx >= 0) { leftW = nx - a.x; pendingResize = true; }
        }
        if (hasR) {
            int nx = this.Handle(app, a.Right() - rw - hs, a.y, hs, a.height, true);
            if (nx >= 0) { rightW = a.Right() - nx - hs; pendingResize = true; }
        }
        int centerH = a.height;
        if (hasB) {
            centerH = a.height - bh - hb;
            int ny = this.Handle(app, midX, a.y + centerH, midW, hs, false);
            if (ny >= 0) { bottomH = a.Bottom() - ny - hs; pendingResize = true; }
        }
        if (centerH < 0) { centerH = 0; }

        // ---- 各侧组布局 ----
        if (hasL) {
            this.LayoutSide(app, this.VisibleGroups(DockSide.Left()),
                new Rect(a.x, a.y, lw, a.height), true, hs);
        }
        if (hasR) {
            this.LayoutSide(app, this.VisibleGroups(DockSide.Right()),
                new Rect(a.Right() - rw, a.y, rw, a.height), true, hs);
        }
        this.LayoutSide(app, this.VisibleGroups(DockSide.Center()),
            new Rect(midX, a.y, midW, centerH), false, hs);
        if (hasB) {
            this.LayoutSide(app, this.VisibleGroups(DockSide.Bottom()),
                new Rect(midX, a.Bottom() - bh, midW, bh), false, hs);
        }
    }

    /// 单个分隔手柄。拖动时返回新的起始坐标
    /// （垂直手柄返回 x，水平手柄返回 y），否则返回 -1。
    int Handle(App app, int x, int y, int w, int h, bool vertical) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        int id = app.focus.AllocId();
        int col = t.divider;
        bool live = app.focus.IsHovered(id) || app.focus.IsPressed(id);
        if (live) { col = t.primary; }
        c.FillRect(x, y, w, h, col);
        int cursor = 4;
        if (!vertical) { cursor = 5; }
        app.hitTester.RegisterRect(id, x, y, w, h, cursor);
        if (app.focus.IsPressed(id) && !dragging) {
            app.RequestRedraw();
            if (vertical) { return app.mouseX; }
            return app.mouseY;
        }
        return -1;
    }

    /// 沿交叉轴在侧边各组之间分割 `r`，在相邻组之间绘制
    /// 手柄以及每个组的边框装饰。
    void LayoutSide(App app, List<DockGroup> gs, Rect r, bool vertical, int hs) {
        int n = gs.Count;
        if (n == 0) { return; }
        int total = r.width;
        if (vertical) { total = r.height; }
        total = total - hs * (n - 1);
        if (total < n) { total = n; }
        int minG = app.Scale(56);
        // 窗口太小，无法给每个组最小尺寸（最小化的
        // 窗口报告极小客户区，如 237x39）时，不得重新缩放
        // 已持久化的尺寸：窗口不可用时布局仅用于显示，
        // 这样恢复时绝不会移动用户的分隔
        // 位置。`tiny` 用于阻止下方的尺寸写入生效。
        bool tiny = minG * n > total;
        if (minG * n > total) { minG = total / n; }

        // 首次根据权重具体化尺寸，之后保持其总和
        // 等于可用交叉轴，这样窗口缩放时会按比例调整。
        int sum = 0;
        int wsum = 0;
        int unset = 0;
        int i = 0;
        for (; i < n; i = i + 1) {
            if (gs[i].extent <= 0) { unset = unset + 1; wsum = wsum + gs[i].weight; }
            else { sum = sum + gs[i].extent; }
        }
        if (unset > 0 && !tiny) {
            int rest = total - sum;
            if (rest < unset * minG) { rest = unset * minG; }
            if (wsum <= 0) { wsum = unset; }
            i = 0;
            while (i < n) {
                if (gs[i].extent <= 0) {
                    gs[i].extent = rest * gs[i].weight / wsum;
                    if (gs[i].extent < minG) { gs[i].extent = minG; }
                    sum = sum + gs[i].extent;
                }
                i = i + 1;
            }
        }
        if (sum != total && sum > 0 && !tiny) {
            int acc = 0;
            i = 0;
            while (i < n - 1) {
                int e = gs[i].extent * total / sum;
                if (e < minG) { e = minG; }
                gs[i].extent = e;
                acc = acc + e;
                i = i + 1;
            }
            int last = total - acc;
            if (last < minG) { last = minG; }
            gs[n - 1].extent = last;
        }

        // 分隔条拖动只在相邻两组之间挪高度，其余组一律不动。
        // 必须等整轮布局跑完再写回：循环中途改 gs[i + 1].extent
        // 会让本帧后面的组按新值排布，末组再把差额吃掉，
        // 结果就是拖第一条分隔线时第三组也跟着变。
        int rsAt = 0 - 1;
        int rsA1 = 0;
        int rsA2 = 0;

        int pos = r.y;
        if (!vertical) { pos = r.x; }
        i = 0;
        while (i < n) {
            DockGroup g = gs[i];
            int ext = g.extent;
            if (i == n - 1) {
                if (vertical) { ext = r.Bottom() - pos; }
                else { ext = r.Right() - pos; }
                if (ext < 1) { ext = 1; }
                // 最后一个组总是吸收余量，但该
                // 余量只有在窗口足够大、能正常布局时才是真实尺寸；
                // 窗口很小时它仅用于显示。
                if (!tiny) { g.extent = ext; }
            }
            if (vertical) { g.bounds = new Rect(r.x, pos, r.width, ext); }
            else { g.bounds = new Rect(pos, r.y, ext, r.height); }
            this.RenderGroup(app, g);
            pos = pos + ext;

            if (i < n - 1) {
                int nv = -1;
                if (vertical) { nv = this.Handle(app, r.x, pos, r.width, hs, false); }
                else { nv = this.Handle(app, pos, r.y, hs, r.height, true); }
                if (nv >= 0 && rsAt < 0) {
                    int start = g.bounds.y;
                    if (!vertical) { start = g.bounds.x; }
                    int delta = nv - start - ext;
                    int a1 = ext + delta;
                    int a2 = gs[i + 1].extent - delta;
                    if (a1 >= minG && a2 >= minG) {
                        rsAt = i;
                        rsA1 = a1;
                        rsA2 = a2;
                    }
                }
                pos = pos + hs;
            }
            i = i + 1;
        }

        if (rsAt >= 0) {
            gs[rsAt].extent = rsA1;
            gs[rsAt + 1].extent = rsA2;
            pendingResize = true;
        }
    }

    /// 绘制一个组的表面和标签条，解析活动面板的
    /// 内容矩形，并处理其标签上的选择/关闭/开始拖拽。
    void RenderGroup(App app, DockGroup g) {
        Canvas c = app.canvas;
        Theme t = app.theme;
        Rect b = g.bounds;

        List<string> vis = new List<string>();
        int i = 0;
        for (; i < g.ids.Count; i = i + 1) {
            DockPanel p = this.Find(g.ids[i]);
            if (p != null && !p.hidden) { vis.Add(p.id); }
        }
        if (vis.Count == 0) { return; }
        if (g.active >= g.ids.Count) { g.active = g.ids.Count - 1; }
        if (g.active < 0) { g.active = 0; }
        string activeId = g.ids[g.active];
        DockPanel ap = this.Find(activeId);
        if (ap == null || ap.hidden) {
            activeId = vis[0];
            g.active = this.IndexIn(g, activeId);
            ap = this.Find(activeId);
        }

        bool chrome = !ap.headerless || vis.Count > 1;
        int hh = 0;
        if (chrome) { hh = headerH; }
        if (hh > b.height) { hh = b.height; }
        g.header = new Rect(b.x, b.y, b.width, hh);
        g.body = new Rect(b.x, b.y + hh, b.width, b.height - hh);

        // 停靠区拥有所有面板表面（包括固定中央区）：
        // 半透明宿主（文档、起始页）与相邻面板看起来材质一致，
        // 而不是让窗口壁纸透出来
        // 形成更暗、更杂乱的表面。自行绘制表面的宿主
        // （编辑器填充文档区）直接覆盖它即可。
        app.FillChrome(b.x, b.y, b.width, b.height, 0, t.bgTertiary);
        if (!chrome) {
            ap.body = g.body;
            return;
        }

        // 标签条与面板表面共用同一底色——单独的 bgSecondary
        // 填充会让每个停靠面板与相邻面板
        // 色调不同。只用分隔线区分即可。
        c.FillRect(b.x, b.y + hh - 1, b.width, 1, t.divider);

        // 右键单击标签条打开面板菜单（恢复已关闭的面板）。
        if (app.EventKind() == 2 && app.window.EventButton() == 1
            && Ui.Over(app, b.x, b.y, b.width, hh)) {
            menuOpen = true;
            menuX = app.mouseX;
            menuY = app.mouseY;
            app.RequestRedraw();
        }

        c.PushClip(b.x, b.y, b.width, hh);

        int fontSize = t.fontSizeSmall;
        int padX = t.paddingMedium;
        int gap = t.gapSmall;
        int closeBox = fontSize;
        int textY = Canvas.CenterTextY(b.y, hh, fontSize);
        int tabX = b.x;

        i = 0;
        while (i < vis.Count) {
            DockPanel p = this.Find(vis[i]);
            int tabId = app.focus.AllocId();
            int closeId = app.focus.AllocId();
            int labelW = Canvas.MeasureText(p.title, fontSize);
            int tabW = padX + labelW + padX;
            if (p.closable) { tabW = padX + labelW + gap + closeBox + padX; }
            bool isActive = p.id == activeId;
            bool hovered = app.focus.IsHovered(tabId);
            bool closeHover = app.focus.IsHovered(closeId);

            if (isActive) {
                c.FillRect(tabX, b.y, tabW, hh - 1, Style.Fade(t.bgPrimary, 420));
            } else if (hovered || closeHover) {
                c.FillRect(tabX, b.y, tabW, hh - 1, t.bgHover);
            }
            int textColor = t.textTertiary;
            if (isActive) { textColor = t.textPrimary; }
            else if (hovered) { textColor = t.textSecondary; }
            c.DrawText(tabX + padX, textY, p.title, textColor, fontSize);
            if (isActive) { c.FillRect(tabX, b.y + hh - 2, tabW, 2, t.primary); }

            // 标签整体先注册，关闭按钮后注册：命中测试取最后注册的
            // 区域，关闭按钮才不会被标签吞掉。
            this.RegisterClipped(app, tabId, tabX, b.y, tabW, hh, b.x, b.width);
            if (p.closable) {
                int cbx = tabX + padX + labelW + gap;
                int cby = b.y + (hh - closeBox) / 2;
                int closeColor = t.textTertiary;
                if (closeHover) {
                    c.FillRoundRect(cbx - 2, cby - 2, closeBox + 4, closeBox + 4,
                        t.borderRadiusSmall, t.bgActive);
                    closeColor = t.textPrimary;
                }
                c.DrawGlyphIn("close", cbx, cby, closeBox, closeBox, closeBox - 3, closeColor);
                this.RegisterClipped(app, closeId, cbx - 2, cby - 2, closeBox + 4, closeBox + 4, b.x, b.width);
            }

            // 在标签上按下并移动会开始停靠拖拽；从未移动的按下
            // 保持为普通点击（选择），在松开时处理。
            if (app.focus.IsPressed(tabId) && !dragging) {
                int dx = app.mouseX - app.pressStartX;
                int dy = app.mouseY - app.pressStartY;
                if (dx < 0) { dx = 0 - dx; }
                if (dy < 0) { dy = 0 - dy; }
                if (dx + dy > app.Scale(6)) {
                    dragging = true;
                    dragId = p.id;
                    app.RequestRedraw();
                }
            }

            if (app.EventKind() == 3 && !dragging && !dragArmed) {
                int hit = app.ClickTarget();
                if (p.closable && hit == closeId) {
                    this.Close(p.id);
                    app.RequestRedraw();
                } else if (hit == tabId) {
                    g.active = this.IndexIn(g, p.id);
                    app.RequestRedraw();
                }
            }

            tabX = tabX + tabW;
            i = i + 1;
        }
        c.PopClip();

        ap = this.Find(activeId);
        if (ap != null && !ap.hidden) { ap.body = g.body; }
    }

    /// 绘制右键单击标签条打开的面板菜单：每个
    /// 关闭的面板一个条目，选中即将其停靠回原位置。
    void RenderMenu(App app) {
        if (!menuOpen) { return; }
        List<string> ids = this.HiddenIds();
        List<string> labels = new List<string>();
        for (int i = 0; i < ids.Count; i = i + 1) {
            labels.Add(this.Title(ids[i]));
        }
        if (labels.Count == 0) { labels.Add(emptyMenuLabel); }
        int pick = ContextMenu.Render(app, menuX, menuY, labels);
        if (pick == 0 - 2) {
            menuOpen = false;
            app.RequestRedraw();
        } else if (pick >= 0) {
            if (pick < ids.Count) { this.Show(ids[pick]); }
            menuOpen = false;
            app.RequestRedraw();
        }
    }

    void RegisterClipped(App app, int id, int rx, int ry, int rw, int rh, int clipX, int clipW) {
        int x0 = rx;
        int x1 = rx + rw;
        if (x0 < clipX) { x0 = clipX; }
        if (x1 > clipX + clipW) { x1 = clipX + clipW; }
        if (x1 <= x0) { return; }
        app.hitTester.RegisterRect(id, x0, ry, x1 - x0, rh, 0);
    }

    // ---- 拖拽与放置 ----

    /// 结束一帧：标签拖拽期间解析放置
    /// 目标、高亮它并绘制拖拽幽灵；松开时
    /// 重新停靠面板。每帧在绘制面板之后调用一次，这样
    /// 提示会绘制在最上层。
    void End(App app) {
        this.RenderMenu(app);
        if (!dragging) {
            dragArmed = false;
            return;
        }
        dragArmed = true;
        Canvas c = app.canvas;
        Theme t = app.theme;

        this.ResolveDrop(app);
        if (dropKind != 0) {
            int tint = Style.Fade(t.primary, 260);
            c.FillRect(dropRect.x, dropRect.y, dropRect.width, dropRect.height, tint);
            c.DrawRoundRect(dropRect.x, dropRect.y, dropRect.width, dropRect.height,
                t.borderRadiusSmall, t.primary, 2);
        }

        DockPanel p = this.Find(dragId);
        if (p != null) {
            int fontSize = t.fontSizeSmall;
            int pad = t.paddingMedium;
            int gw = Canvas.MeasureText(p.title, fontSize) + pad * 2;
            int gh = headerH;
            int gx = app.mouseX + app.Scale(8);
            int gy = app.mouseY + app.Scale(8);
            c.SurfaceRoundRect(gx, gy, gw, gh, t.borderRadiusSmall, t.bgPrimary, t.primary, 1);
            c.DrawTextCentered(gx, gy, gw, gh, p.title, t.textPrimary, fontSize);
        }
        app.RequestRedraw();

        if (app.EventKind() == 3 && app.window.EventButton() == 0) {
            this.ApplyDrop();
            dragging = false;
            dragArmed = false;
            dragId = "";
            dropKind = 0;
            app.RequestRedraw();
        }
    }

    /// 选取指针下方的放置目标：组的标签条或其中部并入该组，
    /// 组的边缘带在旁侧新建组，
    /// 整个停靠区的外侧带停靠到相应侧边。
    void ResolveDrop(App app) {
        dropKind = 0;
        dropGroup = -1;
        dropSide = -1;
        dropIndex = 0;
        int mx = app.mouseX;
        int my = app.mouseY;
        if (!area.Contains(mx, my)) { return; }

        for (int gi = 0; gi < groups.Count; gi = gi + 1) {
            DockGroup g = groups[gi];
            if (this.GroupHasVisible(g) && g.bounds.Contains(mx, my)) {
                if (g.header.height > 0 && g.header.Contains(mx, my)) {
                    dropKind = 1;
                    dropGroup = gi;
                    dropRect = g.bounds;
                    return;
                }
                int zone = DockHost.EdgeZone(g.bounds, mx, my);
                if (zone == 0) {
                    dropKind = 1;
                    dropGroup = gi;
                    dropRect = g.bounds;
                    return;
                }
                bool vertical = g.side == DockSide.Left() || g.side == DockSide.Right();
                bool along = false;
                if (vertical && (zone == 3 || zone == 4)) { along = true; }
                if (!vertical && (zone == 1 || zone == 2)) { along = true; }
                if (along) {
                    dropKind = 2;
                    dropSide = g.side;
                    dropIndex = this.SideIndexOf(g);
                    if (zone == 2 || zone == 4) { dropIndex = dropIndex + 1; }
                    dropRect = DockHost.HalfRect(g.bounds, zone);
                    return;
                }
                // 跨越组的排列方向：停靠到边缘所指的宿主侧，
                // 而不是以错误方向拆分该组。
                dropKind = 2;
                dropSide = DockHost.SideForZone(zone);
                dropIndex = this.SideCount(dropSide);
                if (dropSide == DockSide.Left() && zone == 1) { dropIndex = 0; }
                dropRect = this.SideStrip(app, dropSide);
                return;
            }
        }

        int zoneA = DockHost.EdgeZone(area, mx, my);
        if (zoneA == 0) { zoneA = 2; }
        dropKind = 2;
        dropSide = DockHost.SideForZone(zoneA);
        dropIndex = this.SideCount(dropSide);
        dropRect = this.SideStrip(app, dropSide);
    }

    /// 0 = 中部，1 = 左带，2 = 右带，3 = 顶带，4 = 底带。
    static int EdgeZone(Rect r, int mx, int my) {
        int bx = r.width / 4;
        int by = r.height / 4;
        if (bx < 8) { bx = 8; }
        if (by < 8) { by = 8; }
        int dl = mx - r.x;
        int dr = r.Right() - mx;
        int dt = my - r.y;
        int db = r.Bottom() - my;
        int best = 0;
        int bestD = 0;
        if (dl < bx) { best = 1; bestD = dl; }
        if (dr < bx && (best == 0 || dr < bestD)) { best = 2; bestD = dr; }
        if (dt < by && (best == 0 || dt < bestD)) { best = 3; bestD = dt; }
        if (db < by && (best == 0 || db < bestD)) { best = 4; bestD = db; }
        return best;
    }

    static Rect HalfRect(Rect r, int zone) {
        if (zone == 1) { return new Rect(r.x, r.y, r.width / 2, r.height); }
        if (zone == 2) { return new Rect(r.x + r.width / 2, r.y, r.width / 2, r.height); }
        if (zone == 3) { return new Rect(r.x, r.y, r.width, r.height / 2); }
        return new Rect(r.x, r.y + r.height / 2, r.width, r.height / 2);
    }

    static int SideForZone(int zone) {
        if (zone == 1) { return DockSide.Left(); }
        if (zone == 2) { return DockSide.Right(); }
        if (zone == 4) { return DockSide.Bottom(); }
        return DockSide.Center();
    }

    /// 某一侧将占据的条带，用作侧边停靠的放置提示。
    Rect SideStrip(App app, int side) {
        int w = leftW;
        if (side == DockSide.Right()) { w = rightW; }
        if (w <= 0) { w = app.Scale(240); }
        if (side == DockSide.Center()) { return area; }
        if (side == DockSide.Left()) { return new Rect(area.x, area.y, w, area.height); }
        if (side == DockSide.Right()) { return new Rect(area.Right() - w, area.y, w, area.height); }
        int h = bottomH;
        if (h <= 0) { h = app.Scale(170); }
        return new Rect(area.x, area.Bottom() - h, area.width, h);
    }

    /// `g` 在其所在侧各组中的位置。
    int SideIndexOf(DockGroup g) {
        int n = 0;
        for (int i = 0; i < groups.Count; i = i + 1) {
            if (groups[i].key == g.key) { return n; }
            if (groups[i].side == g.side) { n = n + 1; }
        }
        return n;
    }

    int SideCount(int side) {
        int n = 0;
        for (int i = 0; i < groups.Count; i = i + 1) {
            if (groups[i].side == side) { n = n + 1; }
        }
        return n;
    }

    /// 新组成为 `side` 的第 `k` 组时的全局索引。
    int InsertPos(int side, int k) {
        int n = 0;
        for (int i = 0; i < groups.Count; i = i + 1) {
            if (groups[i].side == side) {
                if (n == k) { return i; }
                n = n + 1;
            }
        }
        return groups.Count;
    }

    void ApplyDrop() {
        if (dropKind == 0) { return; }
        DockPanel p = this.Find(dragId);
        if (p == null) { return; }
        if (dropKind == 1) {
            if (dropGroup < 0 || dropGroup >= groups.Count) { return; }
            DockGroup target = groups[dropGroup];
            if (DockHost.ListHas(target.ids, dragId)) {
                target.active = this.IndexIn(target, dragId);
                return;
            }
            int tkey = target.key;
            this.Detach(dragId);
            // Detach 可能已解散了目标之前被清空的组。
            int ti = this.IndexOfKey(tkey);
            if (ti < 0) { return; }
            groups[ti].ids.Add(dragId);
            groups[ti].active = groups[ti].ids.Count - 1;
            p.home = groups[ti].side;
            changed = true;
            return;
        }

        int side = dropSide;
        int k = dropIndex;
        p.home = side;
        int fromGroup = this.GroupOf(dragId);
        if (fromGroup >= 0 && groups[fromGroup].side == side
            && groups[fromGroup].ids.Count == 1) {
            // 该侧已是唯一组：只需重新排序。
            DockGroup solo = groups[fromGroup];
            groups.RemoveAt(fromGroup);
            int pos = this.InsertPos(side, k);
            if (pos > groups.Count) { pos = groups.Count; }
            groups.Insert(pos, solo);
            changed = true;
            return;
        }
        this.Detach(dragId);
        DockGroup ng = new DockGroup(side, 100);
        ng.ids.Add(dragId);
        ng.active = 0;
        int at = this.InsertPos(side, k);
        if (at > groups.Count) { at = groups.Count; }
        groups.Insert(at, ng);
        changed = true;
    }

    int IndexOfKey(int key) {
        for (int i = 0; i < groups.Count; i = i + 1) {
            if (groups[i].key == key) { return i; }
        }
        return -1;
    }

    /// 标签正在拖拽时为 true——宿主可以抑制自己本帧的
    /// 悬停/拖拽处理。
    bool Dragging() { return dragging; }
}
