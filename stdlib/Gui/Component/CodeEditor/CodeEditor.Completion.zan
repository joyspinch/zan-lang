using System;
using Gui;

namespace Gui.Component.CodeEditor;

/// CodeEditor 分部：自动补全弹窗、符号索引和
/// 感知 using 的补全引擎（成员/类型/标识符建议）。
partial class CodeEditor {
    // ---- 自动补全 ----

    /// 列表 `xs` 已包含 `v` 时返回 true。
    static bool Has(List<string> xs, string v) {
        for (int i = 0; i < xs.Count; i = i + 1) {
            if (xs[i] == v) { return true; }
        }
        return false;
    }

    /// `s` 以 `pre` 开头时返回 true。
    static bool StartsWithP(string s, string pre) {
        if (pre.Length > s.Length) { return false; }
        return s.Substring(0, pre.Length) == pre;
    }

    /// 把语言关键字追加到 `outk`。
    static void KeywordList(List<string> outk) {
        string kws = "using namespace class struct enum interface static extern void int string bool float double char long short byte uint new return if else while for foreach do in break continue true false null this base public private protected internal override virtual abstract sealed const readonly var switch case default try catch finally throw is as typeof sizeof ref out params get set operator async await yield from where select orderby group join let into ascending descending on equals when and or not with record init required global file scoped allows value partial event delegate fixed lock checked unchecked unsafe stackalloc nameof";
        string cur = "";
        int n = kws.Length;
        for (int i = 0; i < n; i = i + 1) {
            string ch = kws.Substring(i, 1);
            if (ch == " ") {
                if (cur.Length > 0) { outk.Add(cur); cur = ""; }
            } else {
                cur = cur + ch;
            }
        }
        if (cur.Length > 0) { outk.Add(cur); }
    }

    /// 追加常用标准库类型和成员用于补全。
    static void StdlibList(List<string> outk) {
        string types = "Console List Dictionary StringBuilder String Math File Directory Path Environment Process Convert Array DateTime TimeSpan Task Thread App Canvas Theme Rect Button Label Input Panel Split Modal TreeView CodeEditor Ribbon Icon SignalInt SignalBool SignalString Window TreeNode RibbonCmd HitRegion Point Size";
        string methods = "WriteLine ReadLine Write ToString Add Remove RemoveAt Insert IndexOf Contains Count Length Clear Sort Reverse Join Split Substring Replace Trim StartsWith EndsWith ToUpper ToLower Format Concat Exists ReadAllText WriteAllText CreateDirectory GetFiles GetDirectories Append AppendLine Max Min Abs Round Sqrt Floor Ceiling Pow Parse TryParse GetText LoadText Render Create SetText";
        string snippets = "Program Main InitializeComponent EventArgs Dispose Override";
        string all = types + " " + methods + " " + snippets;
        string cur = "";
        int n = all.Length;
        for (int i = 0; i < n; i = i + 1) {
            string ch = all.Substring(i, 1);
            if (ch == " ") {
                if (cur.Length > 0 && !CodeEditor.Has(outk, cur)) { outk.Add(cur); cur = ""; }
            } else {
                cur = cur + ch;
            }
        }
        if (cur.Length > 0 && !CodeEditor.Has(outk, cur)) { outk.Add(cur); }
    }

    /// 收集缓冲区中出现的唯一标识符 token（长度 >= 2），
    /// 使编辑器能补全用户已输入过的符号。
    static void CollectWords(List<string> ls, List<string> outw) {
        string idstart = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_";
        string idrest = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_";
        for (int li = 0; li < ls.Count; li = li + 1) {
            string line = ls[li];
            int n = line.Length;
            int i = 0;
            while (i < n) {
                string ch = line.Substring(i, 1);
                if (CodeEditor.InSet(idstart, ch)) {
                    int j = i;
                    string w = "";
                    while (j < n) {
                        string cj = line.Substring(j, 1);
                        if (CodeEditor.InSet(idrest, cj)) { w = w + cj; j = j + 1; }
                        else { break; }
                    }
                    if (w.Length >= 2 && !CodeEditor.Has(outw, w)) { outw.Add(w); }
                    i = j;
                } else {
                    i = i + 1;
                }
            }
        }
    }

    /// 通过应用当前种类过滤器，从 acAllItems/acAllKinds 重建可见的
    /// acItems/acKinds，然后更新弹窗激活状态。
    void ApplyKindFilter() {
        acItems = new List<string>();
        acKinds = new List<string>();
        int i = 0;
        for (; i < acAllItems.Count; i = i + 1) {
            string k = "";
            if (i < acAllKinds.Count) { k = acAllKinds[i]; }
            if (acFilter == "" || acFilter == k) {
                acItems.Add(acAllItems[i]);
                acKinds.Add(k);
            }
        }
        if (acItems.Count == 0 && acAllItems.Count > 0) {
            // 用户保留的种类过滤器对正在输入的字词没有候选项，
            // 保留它只会显示空弹窗（且 Enter/Tab
            // 会接受并不存在的行），因此丢弃该过滤器。
            acFilter = "";
            i = 0;
            while (i < acAllItems.Count) {
                acItems.Add(acAllItems[i]);
                if (i < acAllKinds.Count) { acKinds.Add(acAllKinds[i]); }
                else { acKinds.Add("W"); }
                i = i + 1;
            }
        }
        if (acItems.Count > 0) {
            acActive = true;
            if (acSel >= acItems.Count) { acSel = acItems.Count - 1; }
            if (acSel < 0) { acSel = 0; }
        } else {
            acActive = false;
            acFilter = "";
        }
    }

    /// 未过滤的候选列表至少包含一个
    /// 指定种类条目时返回 true（用于灰显不可用的过滤按钮）。
    bool HasKind(string kind) {
        for (int i = 0; i < acAllKinds.Count; i = i + 1) {
            if (acAllKinds[i] == kind) { return true; }
        }
        return false;
    }

    /// 根据光标左侧紧邻的字词重新计算补全弹窗；
    /// 无前缀或无候选项时关闭弹窗。
    /// `cand` 对输入 `pfx` 的相关度，不匹配时为 -1。
    /// 越高越好。排序遵循 VS 风格补全的隐含顺序：
    /// 大小写精确前缀 > 不区分大小写前缀 >
    /// 驼峰首字母缩写（`rdal` -> `ReadAllLines`）> 普通
    /// 子序列（`rdll` -> `ReadAllLines`）；并列时更短者胜出，
    /// 因此前缀 `add` 时 `Add` 排在 `AddRange` 之前。
    static int MatchScore(string cand, string pfx) {
        if (pfx.Length == 0) { return 1; }
        if (cand.Length < pfx.Length) { return 0 - 1; }
        int bonus = 0 - cand.Length;
        if (cand.StartsWith(pfx)) { return 4000 + bonus; }
        if (CodeEditor.StartsWithI(cand, pfx)) { return 3000 + bonus; }
        if (CodeEditor.HumpMatch(cand, pfx)) { return 2000 + bonus; }
        if (CodeEditor.SubseqMatchI(cand, pfx)) { return 1000 + bonus; }
        return 0 - 1;
    }

    /// `pfx` 拼出 `cand` 的大写字母（加首字符）时返回 true：
    /// `rdal` 和 `RAL` 都能匹配 `ReadAllLines`。
    static bool HumpMatch(string cand, string pfx) {
        string upper = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
        List<string> humps = new List<string>();
        for (int i = 0; i < cand.Length; i = i + 1) {
            string ch = cand.Substring(i, 1);
            if (i == 0 || CodeEditor.InSet(upper, ch) || ch == "_") {
                if (ch != "_") { humps.Add(ch); }
            }
        }
        if (humps.Count < pfx.Length) { return false; }
        for (int h = 0; h < pfx.Length; h = h + 1) {
            if (!CodeEditor.EqI(humps[h], pfx.Substring(h, 1))) { return false; }
        }
        return true;
    }

    /// `pfx` 的每个字符按顺序出现在 `cand` 中时返回 true，
    /// 忽略大小写。
    static bool SubseqMatchI(string cand, string pfx) {
        int pi = 0;
        for (int ci = 0; pi < pfx.Length && ci < cand.Length; ci = ci + 1) {
            if (CodeEditor.EqI(cand.Substring(ci, 1), pfx.Substring(pi, 1))) { pi = pi + 1; }
        }
        return pi >= pfx.Length;
    }

    /// 两个单字符字符串的不区分大小写比较。
    static bool EqI(string a, string b) {
        return CodeEditor.StartsWithI(a, b) && a.Length == b.Length;
    }

    /// 按相关度降序原地排序候选/种类列表。
    static void SortByScore(List<string> items, List<string> kinds, List<int> scores) {
        int i = 1;
        while (i < items.Count) {
            string it = items[i];
            string kd = kinds[i];
            int sc = scores[i];
            int j = i - 1;
            while (j >= 0 && scores[j] < sc) {
                items[j + 1] = items[j];
                kinds[j + 1] = kinds[j];
                scores[j + 1] = scores[j];
                j = j - 1;
            }
            items[j + 1] = it;
            kinds[j + 1] = kd;
            scores[j + 1] = sc;
            i = i + 1;
        }
    }

    /// 显式打开补全（Ctrl+Space），列出作用域内所有内容，
    /// 即使尚未输入前缀。
    void ForceCompletion() {
        acDot = false;
        acActive = true;
        acForced = true;
        UpdateCompletion();
        acForced = false;
    }

    void UpdateCompletion() {
        string idrest = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_";
        string ln = lines[curLine];

        // 若处于点号模式，按输入的前缀过滤完整成员列表
        if (acDot) {
            if (acStart > curCol || acStart < 0) { acActive = false; acDot = false; return; }
            string prefix = ln.Substring(acStart, curCol - acStart);
            acAllItems = new List<string>();
            acAllKinds = new List<string>();
            List<int> dscores = new List<int>();
            for (int fi = 0; fi < acFull.Count; fi = fi + 1) {
                int sc = CodeEditor.MatchScore(acFull[fi], prefix);
                if (sc >= 0) {
                    acAllItems.Add(acFull[fi]);
                    acAllKinds.Add(CodeEditor.MemberKind(acFull[fi]));
                    dscores.Add(sc);
                }
            }
            CodeEditor.SortByScore(acAllItems, acAllKinds, dscores);
            if (acAllItems.Count == 0) { acActive = false; acDot = false; return; }
            acSel = 0;
            ApplyKindFilter();
            return;
        }

        // 常规字词补全
        int st = curCol;
        while (st > 0) {
            string ch = ln.Substring(st - 1, 1);
            if (CodeEditor.InSet(idrest, ch)) { st = st - 1; }
            else { break; }
        }
        acStart = st;
        string pfx = ln.Substring(st, curCol - st);
        if (pfx.Length < 1 && !acForced) { acActive = false; return; }

        List<string> cand = new List<string>();
        List<string> candKinds = new List<string>();
        if (InAttributeContext()) {
            // 在 `[ ... ]` 内：这里只有真正的特性。编译器
            // 只识别 DllImport 和 StructLayout（见 parser.c）。
            CodeEditor.AddKindWords(cand, candKinds, "DllImport StructLayout", "M");
        } else {
            CodeEditor.SnippetListK(cand, candKinds);
            CodeEditor.KeywordListK(cand, candKinds);
            AddStdlibCandidates(cand, candKinds);
            AddProjectCandidates(cand, candKinds);
            CodeEditor.CollectWordsK(lines, cand, candKinds);
        }
        acAllItems = new List<string>();
        acAllKinds = new List<string>();
        List<int> scores = new List<int>();
        for (int i = 0; i < cand.Count; i = i + 1) {
            string w = cand[i];
            int sc = CodeEditor.MatchScore(w, pfx);
            if (w != pfx && sc >= 0 && !CodeEditor.Has(acAllItems, w)) {
                acAllItems.Add(w);
                if (i < candKinds.Count) { acAllKinds.Add(candKinds[i]); }
                else { acAllKinds.Add("W"); }
                scores.Add(sc);
            }
        }
        if (acAllItems.Count == 0) { acActive = false; return; }
        // 先排序再保留最优的少数：按收集顺序截断会
        // 在明显候选项扫描较晚时将其丢弃。
        CodeEditor.SortByScore(acAllItems, acAllKinds, scores);
        while (acAllItems.Count > 60) {
            acAllItems.RemoveAt(acAllItems.Count - 1);
            acAllKinds.RemoveAt(acAllKinds.Count - 1);
        }
        acSel = 0;
        ApplyKindFilter();
    }

    /// 成员名的启发式种类标签：camelCase → 字段，已知名词 →
    /// 属性，*Changed/*Click → 事件，否则为方法。
    static string MemberKind(string name) {
        if (name.Length == 0) { return "M"; }
        string lower = "abcdefghijklmnopqrstuvwxyz";
        if (CodeEditor.InSet(lower, name.Substring(0, 1))) { return "F"; }
        if (CodeEditor.Find(name, "Changed") >= 0 || CodeEditor.Find(name, "Click") >= 0) { return "E"; }
        string props = " Count Length Keys Values Now Today UtcNow Year Month Day Hour Minute Second DayOfWeek DayOfYear Ticks PI E Capacity Empty Chars ForegroundColor BackgroundColor ResetColor Title WindowWidth WindowHeight ExitCode HasExited Id ProcessName StandardOutput StandardError StandardInput NewLine MachineName UserName OSVersion ProcessorCount TickCount StackTrace CommandLine CurrentDirectory Is64BitOperatingSystem DirectorySeparatorChar AltDirectorySeparatorChar ";
        if (CodeEditor.Find(props, " " + name + " ") >= 0) { return "P"; }
        return "M";
    }

    /// `w` 是看似调用的控制流关键字时返回 true。
    static bool IsControlWord(string w) {
        string ctrl = " if for while switch catch foreach using lock return sizeof typeof new ";
        return CodeEditor.Find(ctrl, " " + w + " ") >= 0;
    }

    /// `trimmed` 中 `at` 位置之前声明的标识符（`at` 是其后的
    /// '(' 或 '{' 的位置）；没有或前面无内容时返回 ""
    /// —— 声明前总有类型或修饰符，
    /// 这正是它与调用或裸代码块的区别。
    static string DeclIdentBefore(string trimmed, int at) {
        string idset = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_";
        int e = at;
        while (e > 0) {
            string ch = trimmed.Substring(e - 1, 1);
            if (CodeEditor.InSet(idset, ch)) { e = e - 1; }
            else { break; }
        }
        string name = trimmed.Substring(e, at - e);
        if (name.Length == 0 || e == 0) { return ""; }
        if (CodeEditor.IsControlWord(name)) { return ""; }
        return name;
    }

    /// `line` 声明的属性名（如 `public int page { get; set; } = 1;`），未声明则返回 ""
    /// 访问器是区分属性与类型声明
    /// 或普通代码块的关键：'{' 前的头部不含 '('（那是
    /// 方法或控制语句）、不含 '='（赋值）也不含 '['
    /// （索引器），花括号内是 get / set。
    static string PropNameAt(string trimmed) {
        int bo = CodeEditor.Find(trimmed, "{");
        if (bo <= 0) { return ""; }
        string head = trimmed.Substring(0, bo);
        if (CodeEditor.Find(head, "(") >= 0) { return ""; }
        if (CodeEditor.Find(head, "=") >= 0) { return ""; }
        if (CodeEditor.Find(head, "[") >= 0) { return ""; }
        if (CodeEditor.Find(head, ":") >= 0) { return ""; }
        string body = trimmed.Substring(bo + 1, trimmed.Length - bo - 1);
        if (CodeEditor.Find(body, "get") < 0
            && CodeEditor.Find(body, "set") < 0) {
            return "";
        }
        int he = bo;
        while (he > 0) {
            string ch = trimmed.Substring(he - 1, 1);
            if (ch != " " && ch != "\t") { break; }
            he = he - 1;
        }
        string name = CodeEditor.DeclIdentBefore(trimmed, he);
        if (name.Length == 0) { return ""; }
        string before = CodeEditor.TrimStr(
            trimmed.Substring(0, he - name.Length));
        if (before.Length == 0) { return ""; }
        // 名称之前的内容必须以类型或修饰符结尾。`} else {`
        // 以花括号结尾，其内部可能有 "set"（如 "settings.Save()"），
        // 这就是代码块被误判为属性的原因。
        string tail = before.Substring(before.Length - 1, 1);
        string idset = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_";
        if (!CodeEditor.InSet(idset, tail) && tail != ">" && tail != "]"
            && tail != "?") {
            return "";
        }
        // `class A { get; }` 不是属性，且类型名已由
        // 大纲而非引用计数报告。
        string types = " class struct interface enum namespace ";
        if (CodeEditor.Find(types, " " + before + " ") >= 0) { return ""; }
        return name;
    }

    /// 若 `line` 声明了成员则返回其名称，否则返回 ""。
    /// 方法是标识符后跟参数列表，其匹配的 ')'
    /// 后跟方法体的 '{'，且不是控制语句；
    /// 属性是标识符后跟 get / set 访问器。
    static string DeclNameAt(string line) {
        string trimmed = CodeEditor.TrimStr(line);
        if (trimmed.Length == 0) { return ""; }
        // 必须包含一个 '('，其匹配的 ')' 后跟方法体的 '{'。
        // 方法体可能在同一行结束 —— 像 `WebApp Views(string d) { views = d; return this; }`
        // 这样的单行访问器同样是声明，
        // 与花括号结束行尾的声明无异。
        // 先判断属性：其初始化器可能包含该行唯一的
        // 圆括号（如 `{ get; set; } = new List<T>();`），方法路径
        // 会误将其读作参数列表。
        string prop = CodeEditor.PropNameAt(trimmed);
        if (prop.Length > 0) { return prop; }
        int paren = CodeEditor.Find(trimmed, "(");
        if (paren <= 0) { return ""; }
        int depth = 0;
        int close = 0 - 1;
        int ci = paren;
        while (ci < trimmed.Length) {
            string ch = trimmed.Substring(ci, 1);
            if (ch == "(") { depth = depth + 1; }
            else if (ch == ")") {
                depth = depth - 1;
                if (depth == 0) { close = ci; break; }
            }
            ci = ci + 1;
        }
        if (close < 0) { return ""; }
        int bo = close + 1;
        while (bo < trimmed.Length) {
            string ch = trimmed.Substring(bo, 1);
            if (ch != " " && ch != "\t") { break; }
            bo = bo + 1;
        }
        if (bo >= trimmed.Length || trimmed.Substring(bo, 1) != "{") { return ""; }
        // 拒绝明显的非声明：参数列表前有赋值。
        string dhead = trimmed.Substring(0, paren);
        if (CodeEditor.Find(dhead, "=") >= 0) { return ""; }
        return CodeEditor.DeclIdentBefore(trimmed, paren);
    }

    /// `line` 中注释与字符串/字符字面量被抹除后的版本（长度
    /// 不变，偏移仍可映射回原文），扫描因此永远不会
    /// 匹配到注释文字或字面量中的名称。
    static string StripCode(string line) {
        string outp = "";
        int i = 0;
        bool inStr = false;
        bool inChr = false;
        while (i < line.Length) {
            string ch = line.Substring(i, 1);
            if (inStr || inChr) {
                outp = outp + " ";
                if (ch == "\\" && i + 1 < line.Length) {
                    outp = outp + " ";
                    i = i + 2;
                    continue;
                }
                if (inStr && ch == "\"") { inStr = false; }
                if (inChr && ch == "'") { inChr = false; }
                i = i + 1;
                continue;
            }
            if (ch == "/" && i + 1 < line.Length && line.Substring(i + 1, 1) == "/") {
                while (i < line.Length) { outp = outp + " "; i = i + 1; }
                return outp;
            }
            if (ch == "\"") { inStr = true; outp = outp + " "; i = i + 1; continue; }
            if (ch == "'") { inChr = true; outp = outp + " "; i = i + 1; continue; }
            outp = outp + ch;
            i = i + 1;
        }
        return outp;
    }

    /// `code` 中从 `from` 起 `name` 第一个调用点的偏移，
    /// 无则 -1。调用点是后跟 `(` 的整词出现，这正是
    /// 真实引用与命名实参（`Upload = true`）、
    /// 类型名（`class Index`）或同名成员声明的区别。
    static int FindCallSite(string code, string name, int from) {
        string idset = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_";
        int at = from;
        while (true) {
            int p = CodeEditor.FindFrom(code, name, at);
            if (p < 0) { return -1; }
            at = p + name.Length;
            bool word = true;
            if (p > 0 && CodeEditor.InSet(idset, code.Substring(p - 1, 1))) { word = false; }
            if (at < code.Length && CodeEditor.InSet(idset, code.Substring(at, 1))) { word = false; }
            if (word) {
                int q = at;
                while (q < code.Length && code.Substring(q, 1) == " ") { q = q + 1; }
                if (q < code.Length && code.Substring(q, 1) == "(") { return p; }
            }
        }
    }

    /// 统计 `name` 在 `declLine` 上的声明（及其他同名声明）之外的
    /// 调用点数量，给定 `outLines` 时把每处
    /// 行号追加到其中。
    int ScanRefs(string name, int declLine, List<int> outLines) {
        // 成员的引用应通过其所属类型到达。仅按名称
        // 时，`WebApp.Create` 的列表曾包含其他所有类型的 `Create`。
        string owner = CodeEditor.EnclosingTypeAt(lines, declLine);
        if (owner.Length > 0) {
            return CodeEditor.CountMemberRefsIn(lines, name, owner, outLines);
        }
        int total = 0;
        for (int li = 0; li < lines.Count; li = li + 1) {
            if (li != declLine && CodeEditor.DeclNameAt(lines[li]) != name) {
                string s = CodeEditor.StripCode(lines[li]);
                int from = 0;
                while (true) {
                    int p = CodeEditor.FindCallSite(s, name, from);
                    if (p < 0) { break; }
                    from = p + name.Length;
                    total = total + 1;
                    if (outLines != null) { outLines.Add(li); }
                }
            }
        }
        return total;
    }

    /// 本缓冲区声明的成员的跨文件调用点计数，
    /// 以 "Owner.member" 为键。一次性遍历其他项目源码构建
    /// —— 每个声明只拆分一次 —— 并保留到宿主重新提供
    /// 源码或加载其他文件为止。
    void EnsureExternRefs() {
        if (!extRefDirty) { return; }
        extRefDirty = false;
        extRefKeys = new List<string>();
        extRefVals = new List<int>();
        List<string> owners = new List<string>();
        CodeEditor.OwnerPerLine(lines, owners);
        List<string> dOwner = new List<string>();
        List<string> dName = new List<string>();
        for (int li = 0; li < lines.Count; li = li + 1) {
            string dn = CodeEditor.DeclNameAt(lines[li]);
            if (dn.Length > 0 && li < owners.Count && owners[li].Length > 0) {
                string key = owners[li] + "." + dn;
                if (!CodeEditor.Has(extRefKeys, key)) {
                    extRefKeys.Add(key);
                    extRefVals.Add(0);
                    dOwner.Add(owners[li]);
                    dName.Add(dn);
                }
            }
        }
        if (dName.Count == 0) { return; }
        for (int f = 0; f < projFileSrc.Count; f = f + 1) {
            List<string> fl = CodeEditor.SplitLines(projFileSrc[f]);
            for (int d = 0; d < dName.Count; d = d + 1) {
                extRefVals[d] = extRefVals[d]
                    + CodeEditor.CountMemberRefsIn(fl, dName[d], dOwner[d], null);
            }
        }
    }

    /// 本缓冲区之外 `owner.member` 的调用点数（未知为 0）。
    int ExternRefCount(string owner, string member) {
        EnsureExternRefs();
        string key = owner + "." + member;
        for (int i = 0; i < extRefKeys.Count; i = i + 1) {
            if (extRefKeys[i] == key) { return extRefVals[i]; }
        }
        return 0;
    }

    /// CodeLens 显示的计数：本缓冲区内的使用数加
    /// 项目其他文件中的。只统计缓冲区时，调用方在其他文件的方法
    /// 会显示 "0 references"，而这正是
    /// 项目对外暴露内容的常态。
    int LensRefCount(string name, int declLine) {
        int local = ScanRefs(name, declLine, null);
        string owner = CodeEditor.EnclosingTypeAt(lines, declLine);
        if (owner.Length == 0) { return local; }
        return local + ExternRefCount(owner, name);
    }

    /// LensRefCount() 按成员名记忆化，每帧至多重算 `lensBudget`
    /// 个成员。预算耗尽时返回记忆的计数，
    /// 连过期值都没有则返回 -1，调用方不绘制
    /// 未经统计的数字。
    int LensRefCountBudgeted(string name, int declLine) {
        int at = 0 - 1;
        for (int k = 0; k < lensKeys.Count; k = k + 1) {
            if (lensKeys[k] == name) { at = k; break; }
        }
        if (at >= 0 && lensFresh[at] == 1) { return lensVals[at]; }
        if (lensBudget <= 0) {
            if (at >= 0) { return lensVals[at]; }
            lensPending = true;
            return 0 - 1;
        }
        lensBudget = lensBudget - 1;
        int v = LensRefCount(name, declLine);
        if (at >= 0) {
            lensVals[at] = v;
            lensFresh[at] = 1;
            return v;
        }
        // 浏览大型项目时记忆表不能无界增长。
        if (lensKeys.Count >= 512) {
            lensKeys = new List<string>();
            lensVals = new List<int>();
            lensFresh = new List<int>();
        }
        lensKeys.Add(name);
        lensVals.Add(v);
        lensFresh.Add(1);
        return v;
    }

    /// 开启一帧的 CodeLens 预算，缓冲区变化时
    /// 使记忆过期。指纹在此只取一次，因为 TextStamp() 会遍历
    /// 每一行，而一屏可容纳数十个声明。
    ///
    /// 重算等待输入停止：每次击键都会使
    /// 所有计数失效，每帧统计两个也要各遍历
    /// 整个缓冲区。缓冲区静置片刻前，面板显示
    /// 上次的计数，即一次击键前的值。
    void BeginLensFrame(App app) {
        lensPending = false;
        int stamp = TextStamp();
        if (lensStamp != stamp) {
            lensStamp = stamp;
            lensQuietMs = app.nowMs;
            for (int i = 0; i < lensFresh.Count; i = i + 1) { lensFresh[i] = 0; }
        }
        if (app.nowMs - lensQuietMs < 250) {
            lensBudget = 0;
            app.RequestRedraw();
        } else {
            lensBudget = 2;
        }
    }

    /// 本帧有 CodeLens 计数未统计时返回 true，调用方
    /// 据此请求再算一次。
    bool LensPending() { return lensPending; }

    /// 把光标移到 `declLine` 之后 `name` 的下一个调用点
    /// （循环回绕）并选中。没有则不做任何事。
    void JumpToNextRef(string name, int declLine) {
        int total = lines.Count;
        int li = declLine + 1;
        for (int scanned = 0; scanned < total; scanned = scanned + 1) {
            if (li >= lines.Count) { li = 0; }
            if (li != declLine && CodeEditor.DeclNameAt(lines[li]) != name) {
                int p = CodeEditor.FindCallSite(CodeEditor.StripCode(lines[li]), name, 0);
                if (p >= 0) {
                    ClearExtraCarets();
                    selActive = true;
                    selAnchorLine = li; selAnchorCol = p;
                    curLine = li; curCol = p + name.Length;
                    return;
                }
            }
            li = li + 1;
        }
    }

    /// 收集 `name` 每个调用点的行号（排除其在 `declLine` 上的
    /// 声明），按文件顺序存入 `outLines`。
    void CollectRefs(string name, int declLine, List<int> outLines) {
        ScanRefs(name, declLine, outLines);
    }

    /// 把光标移到 `targetLine` 上 `name` 的第一个调用点并
    /// 选中（供引用列表弹窗使用）。
    void JumpToRefLine(string name, int targetLine) {
        if (targetLine < 0 || targetLine >= lines.Count) { return; }
        int p = CodeEditor.FindCallSite(
            CodeEditor.StripCode(lines[targetLine]), name, 0);
        if (p < 0) { return; }
        ClearExtraCarets();
        selActive = true;
        selAnchorLine = targetLine; selAnchorCol = p;
        curLine = targetLine; curCol = p + name.Length;
        if (curLine < scrollLine || curLine >= scrollLine + 4) {
            scrollLine = curLine - 4;
            if (scrollLine < 0) { scrollLine = 0; }
        }
    }

    /// `s` 中从 `start` 起 `sub` 首次出现的索引，无则 -1。
    static int FindFrom(string s, string sub, int start) {
        if (sub.Length == 0) { return start; }
        int limit = s.Length - sub.Length;
        int i = start;
        if (i < 0) { i = 0; }
        while (i <= limit) {
            if (s.Substring(i, sub.Length) == sub) { return i; }
            i = i + 1;
        }
        return 0 - 1;
    }

    /// 去除 `s` 首尾的空格和制表符。
    static string TrimStr(string s) {
        int a = 0;
        while (a < s.Length) {
            string ch = s.Substring(a, 1);
            if (ch == " " || ch == "\t") { a = a + 1; }
            else { break; }
        }
        int b = s.Length;
        while (b > a) {
            string ch = s.Substring(b - 1, 1);
            if (ch == " " || ch == "\t" || ch == "\r") { b = b - 1; }
            else { break; }
        }
        return s.Substring(a, b - a);
    }

    /// 返回鼠标指针下的标识符，没有则 ""。
    string WordAtMouse(App app, Rect area, int gutterW, int fontSize) {
        int textX = area.x + gutterW + app.theme.paddingSmall;
        if (app.mouseX < textX || app.mouseX >= area.x + area.width) { return ""; }
        if (app.mouseY < area.y || app.mouseY >= area.y + area.height) { return ""; }
        int ln = LineAtY(Canvas.FontHeight(fontSize) + app.Scale(4), app.mouseY);
        if (ln < 0 || ln >= lines.Count) { return ""; }
        string s = lines[ln];
        int col = CodeEditor.ColFromX(s, app.mouseX - textX, fontSize);
        if (col < 0 || col > s.Length) { return ""; }
        string idset = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_";
        int a = col;
        while (a > 0 && CodeEditor.InSet(idset, s.Substring(a - 1, 1))) { a = a - 1; }
        int b = col;
        while (b < s.Length && CodeEditor.InSet(idset, s.Substring(b, 1))) { b = b + 1; }
        if (b <= a) { return ""; }
        return s.Substring(a, b - a);
    }

    static void KeywordListK(List<string> outk, List<string> kinds) {
        List<string> tmp = new List<string>();
        CodeEditor.KeywordList(tmp);
        for (int i = 0; i < tmp.Count; i = i + 1) {
            outk.Add(tmp[i]);
            kinds.Add("K");
        }
    }

    static void CollectWordsK(List<string> ls, List<string> outw, List<string> kinds) {
        List<string> tmp = new List<string>();
        CodeEditor.CollectWords(ls, tmp);
        for (int i = 0; i < tmp.Count; i = i + 1) {
            if (!CodeEditor.Has(outw, tmp[i])) {
                outw.Add(tmp[i]);
                kinds.Add("W");
            }
        }
    }

    /// 不区分大小写的 StartsWith 检查。
    static bool StartsWithI(string s, string pre) {
        if (pre.Length > s.Length) { return false; }
        string lower = "abcdefghijklmnopqrstuvwxyz";
        string upper = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
        for (int i = 0; i < pre.Length; i = i + 1) {
            string a = s.Substring(i, 1);
            string b = pre.Substring(i, 1);
            // 统一为相同大小写
            string la = a;
            string lb = b;
            for (int ai = 0; ai < 26; ai = ai + 1) {
                if (upper.Substring(ai, 1) == a) { la = lower.Substring(ai, 1); }
                if (upper.Substring(ai, 1) == b) { lb = lower.Substring(ai, 1); }
            }
            if (la != lb) { return false; }
        }
        return true;
    }

    /// 用选中的候选项替换正在输入的字词。`viaTab`
    /// 为 true 且候选项为代码片段时展开其模板。
    void AcceptCompletion(bool viaTab) {
        if (!acActive) { return; }
        if (acSel < 0 || acSel >= acItems.Count) { acActive = false; return; }
        string ln = lines[curLine];
        string chosen = acItems[acSel];
        string chosenKind = "";
        if (acSel < acKinds.Count) { chosenKind = acKinds[acSel]; }
        if (viaTab && chosenKind == "S") { SaveUndo(); ExpandSnippet(chosen); return; }
        string left = Text.Left(ln, acStart);
        string right = Text.Right(ln, curCol);
        lines[curLine] = left + chosen + right;
        curCol = acStart + chosen.Length;
        acActive = false;
        acDot = false;
        acFilter = "";
    }

    /// 紧挨 `dotPos` 处点号之前书写的接收者表达式：
    /// `WebApp.Create` 中的 `WebApp`、`app.MaxBody` 中的 `app`，以及链中调用自身的
    /// 接收者（`items.Where(x).Select` -> `items`，因为调用的
    /// 实参列表会整体跳过）。没有则返回空。
    string ReceiverBefore(string ln, int dotPos) {
        string idchars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_";
        int pos = dotPos;
        if (pos > 0 && ln.Substring(pos - 1, 1) == ")") {
            int depth = 1;
            pos = pos - 1;
            while (pos > 0 && depth > 0) {
                pos = pos - 1;
                string pc = ln.Substring(pos, 1);
                if (pc == ")") { depth = depth + 1; }
                else if (pc == "(") { depth = depth - 1; }
            }
        }
        int end = pos;
        while (pos > 0) {
            string pc = ln.Substring(pos - 1, 1);
            if (CodeEditor.InSet(idchars, pc)) { pos = pos - 1; }
            else { break; }
        }
        string word = ln.Substring(pos, end - pos);
        if (word.Length > 0) { return word; }
        // 前面只有点号（跨行断开的链式调用后的 `.Select`）：
        // 回退到该点号之前的片段。
        if (pos > 0 && ln.Substring(pos - 1, 1) == ".") {
            int oEnd = pos - 1;
            int oStart = oEnd;
            while (oStart > 0) {
                string pc = ln.Substring(oStart - 1, 1);
                if (CodeEditor.InSet(idchars, pc)) { oStart = oStart - 1; }
                else { break; }
            }
            return ln.Substring(oStart, oEnd - oStart);
        }
        return "";
    }

    /// 声明光标下成员的类型，通过其前面的接收者解析：
    /// `WebApp.Create` 和 `app.MaxBody`（`app` 声明为 `WebApp`）都得到 `WebApp`，
    /// 成员为继承所得时则得到基类型。
    /// 符号不是成员访问或接收者无法解析时返回空，
    /// 调用方随后回退为仅按名称搜索。
    /// 这使转到定义 / 查找引用不会命中
    /// 无关类型的同名成员。
    string OwnerTypeAtCaret() {
        if (curLine < 0 || curLine >= lines.Count) { return ""; }
        string s = lines[curLine];
        int col = curCol;
        if (col >= s.Length) { col = s.Length - 1; }
        if (col < 0) { return ""; }
        if (!CodeEditor.IsIdentChar(s.Substring(col, 1))) { return ""; }
        int a = col;
        while (a > 0 && CodeEditor.IsIdentChar(s.Substring(a - 1, 1))) { a = a - 1; }
        if (a == 0 || s.Substring(a - 1, 1) != ".") { return ""; }
        string member = CodeEditor.WordAt(s, col);
        string recv = ReceiverBefore(s, a - 1);
        if (recv.Length == 0) { return ""; }
        string t = CodeEditor.NormalizeStdlibType(recv);
        if (!CodeEditor.HasSymbolType(t) && !IsProjectType(t)) {
            // 不是类型名，则是值：取其声明类型。
            string vt = ResolveVarType(recv);
            if (vt.Length == 0) { return ""; }
            t = CodeEditor.NormalizeStdlibType(vt);
        }
        string decl = CodeEditor.SymbolDeclaringType(t, member);
        if (decl.Length > 0) { return decl; }
        return t;
    }

    /// 光标正位于其声明上的成员所属的类型，
    /// 使从声明发起的查找引用也限定在该类型内。
    /// 光标不在成员声明上时返回 ""。
    string EnclosingTypeOfCaretDecl() {
        if (curLine < 0 || curLine >= lines.Count) { return ""; }
        string w = WordAtCaret();
        if (w.Length == 0) { return ""; }
        if (!CodeEditor.IsMemberDeclOf(lines[curLine], w)) { return ""; }
        return CodeEditor.EnclosingTypeAt(lines, curLine);
    }

    /// 用户输入 '.' 时触发。查看点号前的字词并
    /// 建议该类型的已知成员，或链式调用的返回类型。
    void DotCompletion() {
        string ln = lines[curLine];
        int dotPos = curCol - 1;
        if (dotPos < 0) { acActive = false; return; }

        // 在 `using X.` 指令中，补全子命名空间而非成员。
        if (CodeEditor.StartsWithP(CodeEditor.TrimStr(ln), "using ")) {
            UsingDotCompletion();
            return;
        }

        // 基于识别出的类型构建成员列表
        acStart = curCol;
        acFull = new List<string>();
        acDot = true;

        // 解析接收者类型，然后只列出该类型的真实成员。
        // 优先级：硬编码 stdlib 静态类型 -> 用户/项目类型 ->
        // 局部变量声明类型 -> 通用对象成员。
        // 对无法解析的接收者，绝不臆测地罗列字符串/集合/LINQ 辅助方法
        // （那会产出虚假的 `Utils.OrderByDescending`）。
        string recv = ReceiverBefore(ln, dotPos);
        string norm = CodeEditor.NormalizeStdlibType(recv);
        if (CodeEditor.IsKnownStdlibType(norm)) {
            // 接收者就是类型本身，只能访问其静态成员。
            CodeEditor.AddMembersIn(acFull, norm, 1);
            if (CodeEditor.IsCollectionType(norm) && UsesLinq()) { CodeEditor.AddLinqMembers(acFull); }
        } else {
            List<string> mem = new List<string>();
            bool found = FindTypeMembers(recv, mem);
            bool coll = false;
            if (!found) {
                string vt = ResolveVarType(recv);
                if (vt.Length > 0) {
                    string nvt = CodeEditor.NormalizeStdlibType(vt);
                    if (CodeEditor.IsKnownStdlibType(nvt)) {
                        // 接收者是值：列出其实例成员。
                        CodeEditor.AddMembersIn(acFull, nvt, 0);
                        found = true;
                        if (CodeEditor.IsCollectionType(nvt)) { coll = true; }
                    } else if (FindTypeMembers(vt, mem)) {
                        found = true;
                    }
                }
            }
            if (found) {
                for (int mi = 0; mi < mem.Count; mi = mi + 1) {
                    if (!CodeEditor.Has(acFull, mem[mi])) { acFull.Add(mem[mi]); }
                }
                if (coll && UsesLinq()) { CodeEditor.AddLinqMembers(acFull); }
                // 所有对象都继承的通用成员。
                if (!CodeEditor.Has(acFull, "ToString")) { acFull.Add("ToString"); }
                if (!CodeEditor.Has(acFull, "Equals")) { acFull.Add("Equals"); }
                if (!CodeEditor.Has(acFull, "GetHashCode")) { acFull.Add("GetHashCode"); }
                if (!CodeEditor.Has(acFull, "GetType")) { acFull.Add("GetType"); }
            } else {
                acFull.Add("ToString"); acFull.Add("Equals");
                acFull.Add("GetHashCode"); acFull.Add("GetType");
            }
        }

        acFilter = "";
        acAllItems = new List<string>();
        acAllKinds = new List<string>();
        for (int fi = 0; fi < acFull.Count; fi = fi + 1) {
            acAllItems.Add(acFull[fi]);
            acAllKinds.Add(CodeEditor.MemberKind(acFull[fi]));
        }
        if (acAllItems.Count == 0) { acActive = false; acDot = false; return; }
        acSel = 0;
        ApplyKindFilter();
    }

    /// `using X.` 指令的命名空间补全：列出已输入前缀的
    /// 子命名空间（如 `using System.` -> Data、
    /// Net、IO、Text 等）。源自 stdlib 命名空间目录，
    /// 绝不臆造成员，也绝不落入类型成员路径。
    void UsingDotCompletion() {
        string ln = lines[curLine];
        int dotPos = curCol - 1;
        string nsset = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_.";
        int s = dotPos;
        while (s > 0 && CodeEditor.InSet(nsset, ln.Substring(s - 1, 1))) { s = s - 1; }
        string prefix = ln.Substring(s, dotPos - s);
        while (prefix.Length > 0 && prefix.Substring(prefix.Length - 1, 1) == ".") {
            prefix = prefix.Substring(0, prefix.Length - 1);
        }
        acStart = curCol;
        acDot = true;
        acFull = new List<string>();
        List<string> kids = new List<string>();
        CodeEditor.ChildNamespaces(prefix, kids);
        for (int ki = 0; ki < kids.Count; ki = ki + 1) { acFull.Add(kids[ki]); }
        acFilter = "";
        acAllItems = new List<string>();
        acAllKinds = new List<string>();
        for (int fi = 0; fi < acFull.Count; fi = fi + 1) {
            acAllItems.Add(acFull[fi]);
            acAllKinds.Add("M");
        }
        if (acAllItems.Count == 0) { acActive = false; acDot = false; return; }
        acSel = 0;
        ApplyKindFilter();
    }

    /// 把 `prefix` 去重后的下一段子命名空间追加到 `out2`，
    /// 来自 stdlib 目录（如前缀 "System.Data" -> Orm、Sqlite、
    /// Postgres）。
    static void ChildNamespaces(string prefix, List<string> out2) {
        string data = CodeEditor.StdlibNsData();
        string pre = prefix + ".";
        string cur = "";
        for (int i = 0; i <= data.Length; i = i + 1) {
            string ch = "";
            if (i < data.Length) { ch = data.Substring(i, 1); }
            if (ch == ";" || i == data.Length) {
                string key = cur;
                int eq = CodeEditor.Find(cur, "=");
                if (eq > 0) { key = cur.Substring(0, eq); }
                if (key.Length > pre.Length && CodeEditor.StartsWithP(key, pre)) {
                    string rest = key.Substring(pre.Length, key.Length - pre.Length);
                    string seg = rest;
                    int dotp = CodeEditor.Find(rest, ".");
                    if (dotp > 0) { seg = rest.Substring(0, dotp); }
                    if (seg.Length > 0 && !CodeEditor.Has(out2, seg)) { out2.Add(seg); }
                }
                cur = "";
            } else {
                cur = cur + ch;
            }
        }
    }

    /// 通过一种接收者可访问的 `typeName` 成员：
    /// `wantStatic` 为 1 表示类型本身（`WebApp.`），0 表示值（`app.`）。
    /// 索引未描述的内容回退到 AddMembers，
    /// 其手写表不区分静态/实例。
    static void AddMembersIn(List<string> out2, string typeName, int wantStatic) {
        if (!CodeEditor.HasSymbolType(typeName)) {
            CodeEditor.AddMembers(out2, typeName);
            return;
        }
        CodeEditor.SymbolMembersIn(typeName, out2, wantStatic);
        if (wantStatic != 1) { CodeEditor.SymbolExtensionsFor(typeName, out2); }
        if (out2.Count > 0) { return; }
        // 内置类型目录按类型而非按成员标记静态性，
        // 因此内置类型在请求的上下文中可能没有任何成员。
        // 索引拥有的任何内容都胜过空弹窗。
        CodeEditor.SymbolMembersIn(typeName, out2, 0 - 1);
        CodeEditor.SymbolExtensionsFor(typeName, out2);
    }

    /// 为已知类型填充成员列表。
    static void AddMembers(List<string> out2, string typeName) {
        // 编译器生成的索引优先：它列出编译器
        // 真正拥有的成员，而下面的表已与其脱节。它们保留为
        // 尚未建立索引的工作区的回退方案。
        if (CodeEditor.HasSymbolType(typeName)) {
            CodeEditor.SymbolMembers(typeName, out2);
            CodeEditor.SymbolExtensionsFor(typeName, out2);
            return;
        }
        if (typeName == "Console") {
            out2.Add("WriteLine"); out2.Add("ReadLine"); out2.Add("Write");
            out2.Add("Clear"); out2.Add("ReadKey"); out2.Add("SetCursorPosition");
            out2.Add("ForegroundColor"); out2.Add("BackgroundColor"); out2.Add("ResetColor");
            out2.Add("Title"); out2.Add("WindowWidth"); out2.Add("WindowHeight");
            out2.Add("Beep"); out2.Add("Error"); out2.Add("Out"); out2.Add("In");
        } else if (typeName == "Math") {
            out2.Add("Max"); out2.Add("Min"); out2.Add("Abs"); out2.Add("Sqrt");
            out2.Add("Round"); out2.Add("Floor"); out2.Add("Ceiling"); out2.Add("Pow");
            out2.Add("Log"); out2.Add("Log10"); out2.Add("Sin"); out2.Add("Cos");
            out2.Add("Tan"); out2.Add("Atan"); out2.Add("Atan2"); out2.Add("Exp");
            out2.Add("Sign"); out2.Add("Truncate"); out2.Add("Clamp");
            out2.Add("PI"); out2.Add("E");
        } else if (typeName == "File") {
            out2.Add("ReadAllText"); out2.Add("WriteAllText"); out2.Add("ReadAllLines");
            out2.Add("WriteAllLines"); out2.Add("AppendAllText"); out2.Add("Exists");
