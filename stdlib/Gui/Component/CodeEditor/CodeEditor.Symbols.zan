using System;
using System.IO;
using Gui;
using Gui.Widget;

namespace Gui.Component.CodeEditor;

/// CodeEditor part: the symbol index produced by `zanc --emit-symbols`.
///
/// Completion used to answer member queries from tables written by hand in
/// CodeEditor.Completion.zan, which drifted from the compiler: it offered
/// File.OpenRead(), Math.Clamp() and Convert.ToDecimal() (none of which exist)
/// while hiding File.GetSize(). Whatever the compiler wrote into the index wins
/// over those tables; they stay as the fallback for a workspace that has not
/// been indexed yet.
partial class CodeEditor {
    static List<string> symOwners;   // owning type of each member record
    static List<string> symNames;    // member name
    static List<string> symKinds;    // M method, P property, F field, C ctor, E event
    static List<string> symSigs;     // display signature
    static List<string> symStatics;  // "1" when the member is static
    static List<string> symTypes;    // every type name in the index
    static List<string> symBases;    // base list of symTypes[i], comma-separated

    /// True once an index has been loaded successfully.
    static bool SymbolIndexLoaded() {
        return symTypes != null && symTypes.Count > 0;
    }

    /// Drops the loaded index (used before reloading after a build).
    static void ClearSymbolIndex() {
        symOwners = new List<string>();
        symNames = new List<string>();
        symKinds = new List<string>();
        symSigs = new List<string>();
        symStatics = new List<string>();
        symTypes = new List<string>();
        symBases = new List<string>();
    }

    /// Loads the index written by `zanc --emit-symbols <path>`: TAB-separated
    /// `T kind namespace name bases` and `M owner name kind static signature`
    /// records. Returns false when the file is missing or has no records, in
    /// which case completion keeps using its built-in tables.
    static bool LoadSymbolIndex(string path) {
        CodeEditor.ClearSymbolIndex();
        if (path.Length == 0 || !File.Exists(path)) { return false; }
        string text = File.ReadAllText(path);
        if (text.Length == 0) { return false; }
        List<string> ls = text.Split("\n");
        int i = 0;
        while (i < ls.Count) {
            string line = ls[i];
            i = i + 1;
            if (line.Length == 0) { continue; }
            if (line.EndsWith("\r")) { line = line.Substring(0, line.Length - 1); }
            if (line.StartsWith("#")) { continue; }
            List<string> f = line.Split("\t");
            if (f.Count < 4) { continue; }
            if (f[0] == "T") {
                string tn = f[3];
                if (tn.Length > 0 && !CodeEditor.Has(symTypes, tn)) {
                    symTypes.Add(tn);
                    if (f.Count > 4) { symBases.Add(f[4]); } else { symBases.Add(""); }
                }
            } else if (f[0] == "M" && f.Count >= 6) {
                // An extern (DllImport) declaration is an FFI binding, not API
                // to offer: WebApp's crt `time`/`fopen`/`fwrite`/`fclose` are
                // members of the type and looked like WebApp's own methods.
                if (f.Count > 6 && CodeEditor.Find(f[6], "x") >= 0) { continue; }
                symOwners.Add(f[1]);
                symNames.Add(f[2]);
                symKinds.Add(f[3]);
                symSigs.Add(f[5]);
                symStatics.Add(f[4]);
            }
        }
        return symTypes.Count > 0;
    }

    /// True when the index describes `typeName`.
    static bool HasSymbolType(string typeName) {
        if (!CodeEditor.SymbolIndexLoaded()) { return false; }
        return CodeEditor.Has(symTypes, typeName);
    }

    // ---- type-scoped source search -----------------------------------------
    // Go to Definition and Find References used to search by name alone, so
    // `WebApp.Create` landed on whichever `Create(` came first in the project
    // and its reference list held every unrelated `Create` call. These walk the
    // text with the one thing that distinguishes them: the type a member
    // belongs to. They take plain lines so the editor can use them on its
    // buffer and the IDE on files it has not opened.

    /// The type name declared on `line` (`class`, `struct`, `interface`,
    /// `enum`, with any modifiers in front), or "".
    static string TypeNameOn(string line) {
        List<string> kws = new List<string>{
            "class", "struct", "interface", "enum" };
        int k = 0;
        while (k < kws.Count) {
            string kw = kws[k];
            int p = CodeEditor.FindWordFrom(line, kw, 0);
            if (p >= 0) {
                int q = p + kw.Length;
                while (q < line.Length && line.Substring(q, 1) == " ") { q = q + 1; }
                string name = "";
                while (q < line.Length && CodeEditor.IsIdentChar(line.Substring(q, 1))) {
                    name = name + line.Substring(q, 1);
                    q = q + 1;
                }
                if (name.Length > 0) { return name; }
            }
            k = k + 1;
        }
        return "";
    }

    /// Offset of the first whole-word occurrence of `word` in `s` at or after
    /// `from`, or -1.
    static int FindWordFrom(string s, string word, int from) {
        int at = from;
        while (true) {
            int p = CodeEditor.FindFrom(s, word, at);
            if (p < 0) { return 0 - 1; }
            at = p + word.Length;
            bool okL = p == 0 || !CodeEditor.IsIdentChar(s.Substring(p - 1, 1));
            bool okR = at >= s.Length || !CodeEditor.IsIdentChar(s.Substring(at, 1));
            if (okL && okR) { return p; }
        }
    }

    /// Net brace nesting `line` contributes, ignoring literals and comments.
    static int BraceDelta(string line) {
        string s = CodeEditor.StripCode(line);
        int d = 0;
        int i = 0;
        while (i < s.Length) {
            string ch = s.Substring(i, 1);
            if (ch == "{") { d = d + 1; }
            else if (ch == "}") { d = d - 1; }
            i = i + 1;
        }
        return d;
    }

    /// For every line of `ls`, the name of the type whose body contains it
    /// ("" outside any type), appended to `outOwners` in line order.
    static void OwnerPerLine(List<string> ls, List<string> outOwners) {
        List<string> stack = new List<string>();
        List<int> depths = new List<int>();
        int depth = 0;
        int i = 0;
        while (i < ls.Count) {
            string tn = CodeEditor.TypeNameOn(CodeEditor.StripCode(ls[i]));
            if (tn.Length > 0) { stack.Add(tn); depths.Add(depth); }
            if (stack.Count > 0) { outOwners.Add(stack[stack.Count - 1]); }
            else { outOwners.Add(""); }
            depth = depth + CodeEditor.BraceDelta(ls[i]);
            while (stack.Count > 0 && depth <= depths[depths.Count - 1]) {
                stack.RemoveAt(stack.Count - 1);
                depths.RemoveAt(depths.Count - 1);
            }
            i = i + 1;
        }
    }

    /// The type whose body contains line `at` of `ls`, or "".
    static string EnclosingTypeAt(List<string> ls, int at) {
        if (at < 0 || at >= ls.Count) { return ""; }
        List<string> owners = new List<string>();
        CodeEditor.OwnerPerLine(ls, owners);
        if (at >= owners.Count) { return ""; }
        return owners[at];
    }

    /// The identifier ending right before offset `end` in `s` ("" when the
    /// character there is not part of one).
    static string IdentBefore(string s, int end) {
        int a = end;
        while (a > 0 && CodeEditor.IsIdentChar(s.Substring(a - 1, 1))) { a = a - 1; }
        if (a >= end) { return ""; }
        return s.Substring(a, end - a);
    }

    /// Names in `ls` that hold a value of type `typeName`: a `Type name`
    /// declaration, or a `name = Type.` / `name = new Type(` assignment. These
    /// are the receivers through which the type's members are reached in this
    /// file, which is how `app.MaxBody` is recognised as WebApp's MaxBody.
    static void CollectTypedVars(List<string> ls, string typeName,
            List<string> outNames) {
        int i = 0;
        while (i < ls.Count) {
            string s = CodeEditor.StripCode(ls[i]);
            int at = 0;
            while (true) {
                int p = CodeEditor.FindWordFrom(s, typeName, at);
                if (p < 0) { break; }
                at = p + typeName.Length;
                int q = at;
                // A generic argument list still declares that type.
                if (q < s.Length && s.Substring(q, 1) == "<") {
                    int d = 1;
                    q = q + 1;
                    while (q < s.Length && d > 0) {
                        string c = s.Substring(q, 1);
                        if (c == "<") { d = d + 1; }
                        else if (c == ">") { d = d - 1; }
                        q = q + 1;
                    }
                }
                if (q < s.Length && s.Substring(q, 1) == " ") {
                    while (q < s.Length && s.Substring(q, 1) == " ") { q = q + 1; }
                    string nm = "";
                    while (q < s.Length && CodeEditor.IsIdentChar(s.Substring(q, 1))) {
                        nm = nm + s.Substring(q, 1);
                        q = q + 1;
                    }
                    while (q < s.Length && s.Substring(q, 1) == " ") { q = q + 1; }
                    string after = "";
                    if (q < s.Length) { after = s.Substring(q, 1); }
                    bool decl = after == "=" || after == ";" || after == ","
                        || after == ")";
                    if (nm.Length > 0 && decl && !CodeEditor.Has(outNames, nm)) {
                        outNames.Add(nm);
                    }
                }
                // `name = Type.Something(...)` / `name = new Type(...)`.
                int eq = p;
                while (eq > 0 && s.Substring(eq - 1, 1) == " ") { eq = eq - 1; }
                if (CodeEditor.IdentBefore(s, eq) == "new") { eq = eq - 3; }
                while (eq > 0 && s.Substring(eq - 1, 1) == " ") { eq = eq - 1; }
                if (eq > 0 && s.Substring(eq - 1, 1) == "=") {
                    int lhs = eq - 1;
                    while (lhs > 0 && s.Substring(lhs - 1, 1) == " ") { lhs = lhs - 1; }
                    string nm2 = CodeEditor.IdentBefore(s, lhs);
                    if (nm2.Length > 0 && !CodeEditor.Has(outNames, nm2)) {
                        outNames.Add(nm2);
                    }
                }
            }
            i = i + 1;
        }
    }

    /// Occurrences of `member` in `ls` that belong to type `owner`: reached
    /// through the type name, through `this`/`base`, through a variable of that
    /// type, or written unqualified inside the owner's own body. Declarations of
    /// the same name are skipped. Lines are appended to `outLines` when given.
    static int CountMemberRefsIn(List<string> ls, string member, string owner,
            List<int> outLines) {
        List<string> recvs = new List<string>();
        recvs.Add("this");
        recvs.Add("base");
        // The member belongs to `owner`, but it is *reached* through any type
        // that inherits it: a call written on a derived type name, or on a
        // variable declared with one, is a reference to this same member.
        List<string> family = new List<string>();
        family.Add(owner);
        CodeEditor.SymbolSubtypesOf(owner, family);
        int fi = 0;
        while (fi < family.Count) {
            if (!CodeEditor.Has(recvs, family[fi])) { recvs.Add(family[fi]); }
            CodeEditor.CollectTypedVars(ls, family[fi], recvs);
            fi = fi + 1;
        }
        List<string> owners = new List<string>();
        CodeEditor.OwnerPerLine(ls, owners);
        int total = 0;
        int li = 0;
        while (li < ls.Count) {
            if (CodeEditor.DeclNameAt(ls[li]) != member) {
                string s = CodeEditor.StripCode(ls[li]);
                int from = 0;
                while (true) {
                    int p = CodeEditor.FindWordFrom(s, member, from);
                    if (p < 0) { break; }
                    from = p + member.Length;
                    bool ok = false;
                    if (p > 0 && s.Substring(p - 1, 1) == ".") {
                        ok = CodeEditor.Has(recvs, CodeEditor.IdentBefore(s, p - 1));
                    } else if (li < owners.Count) {
                        ok = CodeEditor.Has(family, owners[li]);
                    }
                    if (ok) {
                        total = total + 1;
                        if (outLines != null) { outLines.Add(li); }
                    }
                }
            }
            li = li + 1;
        }
        return total;
    }

    /// Line index where type `owner` declares `member` in `ls`, or -1. Only the
    /// owner's own body is searched, so a same-named member of another type in
    /// the same file is never the answer.
    static int FindMemberDeclLineIn(List<string> ls, string owner, string member) {
        List<string> owners = new List<string>();
        CodeEditor.OwnerPerLine(ls, owners);
        int i = 0;
        while (i < ls.Count && i < owners.Count) {
            if (owners[i] == owner && CodeEditor.TypeNameOn(CodeEditor.StripCode(ls[i])).Length == 0) {
                if (CodeEditor.IsMemberDeclOf(ls[i], member)) { return i; }
            }
            i = i + 1;
        }
        return 0 - 1;
    }

    /// True when `line` declares `member`: a method header (`... member(`) or a
    /// field/property (`Type member;` / `Type member =` / `Type member {`),
    /// rather than a use of it.
    static bool IsMemberDeclOf(string line, string member) {
        string s = CodeEditor.TrimStr(CodeEditor.StripCode(line));
        if (s.Length == 0) { return false; }
        if (CodeEditor.TypeNameOn(s).Length > 0) { return false; }
        int p = CodeEditor.FindWordFrom(s, member, 0);
        if (p <= 0) { return false; }
        if (s.Substring(p - 1, 1) != " ") { return false; }
        string before = CodeEditor.TrimStr(s.Substring(0, p - 1));
        // A declaration is preceded by its type (and modifiers) only: a use is
        // preceded by an operator, a dot, or a control keyword.
        if (before.Length == 0) { return false; }
        string lastCh = before.Substring(before.Length - 1, 1);
        if (!CodeEditor.IsIdentChar(lastCh) && lastCh != ">" && lastCh != "]"
            && lastCh != "?") { return false; }
        if (CodeEditor.Find(before, "=") >= 0) { return false; }
        if (CodeEditor.Find(before, "(") >= 0) { return false; }
        if (CodeEditor.Find(before, ".") >= 0) { return false; }
        string first = CodeEditor.IdentAt(before, 0);
        if (CodeEditor.IsControlWord(first)) { return false; }
        int q = p + member.Length;
        while (q < s.Length && s.Substring(q, 1) == " ") { q = q + 1; }
        string after = "";
        if (q < s.Length) { after = s.Substring(q, 1); }
        return after == "(" || after == ";" || after == "=" || after == "{"
            || after == "<";
    }

    /// The identifier starting at `at` in `s` ("" when none).
    static string IdentAt(string s, int at) {
        string o = "";
        int i = at;
        while (i < s.Length && CodeEditor.IsIdentChar(s.Substring(i, 1))) {
            o = o + s.Substring(i, 1);
            i = i + 1;
        }
        return o;
    }

    /// The type in `typeName`'s base chain that actually declares `member`, or
    /// "" when the index knows of no such member. `app.ToString()` on a type
    /// that inherits it must lead to the base that declares it, not to the
    /// derived type it was called on.
    static string SymbolDeclaringType(string typeName, string member) {
        if (!CodeEditor.SymbolIndexLoaded()) { return ""; }
        string cur = typeName;
        int depth = 0;
        while (cur.Length > 0 && depth < 8) {
            int i = 0;
            while (i < symOwners.Count) {
                if (symOwners[i] == cur && symNames[i] == member) { return cur; }
                i = i + 1;
            }
            cur = CodeEditor.SymbolFirstBase(cur);
            depth = depth + 1;
        }
        return "";
    }

    /// Appends the members the compiler really has for `typeName`, following
    /// base types so inherited members show up too.
    static void SymbolMembers(string typeName, List<string> out2) {
        CodeEditor.SymbolMembersIn(typeName, out2, 0 - 1);
    }

    /// The members of `typeName` in one access context: `wantStatic` 1 lists
    /// only the static ones (the receiver is the type itself: `WebApp.`), 0 only
    /// the instance ones (the receiver is a value: `app.`), -1 both. Mixing the
    /// two is what put a type's whole instance state behind `TypeName.`.
    static void SymbolMembersIn(string typeName, List<string> out2,
            int wantStatic) {
        if (!CodeEditor.SymbolIndexLoaded()) { return; }
        string cur = typeName;
        int depth = 0;
        while (cur.Length > 0 && depth < 8) {
            int i = 0;
            while (i < symOwners.Count) {
                if (symOwners[i] == cur && symKinds[i] != "C") {
                    bool want = wantStatic < 0;
                    if (!want && i < symStatics.Count) {
                        bool st = symStatics[i] == "1";
                        want = st == (wantStatic == 1);
                    }
                    if (want && !CodeEditor.Has(out2, symNames[i])) {
                        out2.Add(symNames[i]);
                    }
                }
                i = i + 1;
            }
            cur = CodeEditor.SymbolFirstBase(cur);
            depth = depth + 1;
        }
    }

    /// True when the index describes `typeName` and attributes no `member` to
    /// it or to any of its bases -- the one case where a same-named member of
    /// an unrelated type is definitely the wrong answer.
    static bool SymbolTypeLacksMember(string typeName, string member) {
        if (!CodeEditor.HasSymbolType(typeName)) { return false; }
        return CodeEditor.SymbolDeclaringType(typeName, member).Length == 0;
    }

    /// Appends every indexed type whose base chain reaches `typeName` -- the
    /// types through which its members are also reached.
    static void SymbolSubtypesOf(string typeName, List<string> out2) {
        if (!CodeEditor.SymbolIndexLoaded()) { return; }
        int i = 0;
        while (i < symTypes.Count) {
            string cur = CodeEditor.SymbolFirstBase(symTypes[i]);
            int depth = 0;
            while (cur.Length > 0 && depth < 8) {
                if (cur == typeName) {
                    if (!CodeEditor.Has(out2, symTypes[i])) { out2.Add(symTypes[i]); }
                    break;
                }
                cur = CodeEditor.SymbolFirstBase(cur);
                depth = depth + 1;
            }
            i = i + 1;
        }
    }

    /// The first base type of `typeName` in the index ("" when none).
    static string SymbolFirstBase(string typeName) {
        if (!CodeEditor.SymbolIndexLoaded()) { return ""; }
        int i = 0;
        while (i < symTypes.Count) {
            if (symTypes[i] == typeName) {
                string b = symBases[i];
                if (b.Length == 0) { return ""; }
                int c = b.IndexOf(",");
                if (c >= 0) { b = b.Substring(0, c); }
                int lt = b.IndexOf("<");
                if (lt >= 0) { b = b.Substring(0, lt); }
                return b;
            }
            i = i + 1;
        }
        return "";
    }

    /// The declared signature of `typeName.member` ("" when the index has no
    /// such member). With overloads this is the first declaration.
    static string SymbolSignature(string typeName, string member) {
        if (!CodeEditor.SymbolIndexLoaded()) { return ""; }
        string cur = typeName;
        int depth = 0;
        while (cur.Length > 0 && depth < 8) {
            int i = 0;
            while (i < symOwners.Count) {
                if (symOwners[i] == cur && symNames[i] == member) { return symSigs[i]; }
                i = i + 1;
            }
            cur = CodeEditor.SymbolFirstBase(cur);
            depth = depth + 1;
        }
        // An extension method is declared on another type ("static string
        // PadLeft(this string s, ...)"), so look for a `this <typeName>`
        // receiver as well.
        string want = "(this " + typeName;
        int k = 0;
        while (k < symOwners.Count) {
            if (symNames[k] == member) {
                int at = symSigs[k].IndexOf(want);
                if (at >= 0) { return symSigs[k]; }
            }
            k = k + 1;
        }
        return "";
    }

    /// The first signature the index has for a member of any type, used for the
    /// hover/signature strip where the receiver type is unknown.
    static string SymbolSignatureAny(string member) {
        if (!CodeEditor.SymbolIndexLoaded()) { return ""; }
        int i = 0;
        while (i < symNames.Count) {
            if (symNames[i] == member) { return symSigs[i]; }
            i = i + 1;
        }
        return "";
    }

    /// Every signature declared for `typeName.member`, i.e. the overload set.
    static void SymbolOverloads(string typeName, string member, List<string> out2) {
        if (!CodeEditor.SymbolIndexLoaded()) { return; }
        string want = "(this " + typeName;
        int i = 0;
        while (i < symOwners.Count) {
            bool mine = symOwners[i] == typeName && symNames[i] == member;
            bool ext = symNames[i] == member && symSigs[i].IndexOf(want) >= 0;
            if (mine || ext) {
                if (!CodeEditor.Has(out2, symSigs[i])) { out2.Add(symSigs[i]); }
            }
            i = i + 1;
        }
    }

    /// The kind letter completion shows for `typeName.member`, or "" when the
    /// index does not describe it.
    static string SymbolKind(string typeName, string member) {
        if (!CodeEditor.SymbolIndexLoaded()) { return ""; }
        int i = 0;
        while (i < symOwners.Count) {
            if (symOwners[i] == typeName && symNames[i] == member) { return symKinds[i]; }
            i = i + 1;
        }
        return "";
    }

    /// Every indexed type name whose spelling starts with `prefix`
    /// (case-insensitive), for type-name completion.
    static void SymbolTypesStartingWith(string prefix, List<string> out2) {
        if (!CodeEditor.SymbolIndexLoaded()) { return; }
        int i = 0;
        while (i < symTypes.Count) {
            if (CodeEditor.StartsWithI(symTypes[i], prefix)) {
                if (!CodeEditor.Has(out2, symTypes[i])) { out2.Add(symTypes[i]); }
            }
            i = i + 1;
        }
    }

    /// Extension methods in the index that apply to `typeName`: a static method
    /// whose first parameter is declared `this <typeName>`.
    static void SymbolExtensionsFor(string typeName, List<string> out2) {
        if (!CodeEditor.SymbolIndexLoaded()) { return; }
        string want = "(this " + typeName;
        int i = 0;
        while (i < symOwners.Count) {
            string sig = symSigs[i];
            int at = sig.IndexOf(want);
            if (at >= 0) {
                int after = at + want.Length;
                string next = "";
                if (after < sig.Length) { next = sig.Substring(after, 1); }
                if (next == " " || next == "<") {
                    if (!CodeEditor.Has(out2, symNames[i])) { out2.Add(symNames[i]); }
                }
            }
            i = i + 1;
        }
    }
}
