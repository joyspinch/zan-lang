using System;

namespace Gui.Component.CodeEditor;

/// One debugger variable row (name / type / value) shown in the Variables
/// panel and the editor's debug hover tooltip. One entity instead of the old
/// tab-separated "name\ttype\tvalue" strings.
class DbgVar {
    string name;
    string type;
    string val;

    static DbgVar Create(string name, string type, string val) {
        DbgVar v = new DbgVar();
        v.name = name;
        v.type = type;
        v.val = val;
        return v;
    }
}
