using System;

namespace Gui.Component.CodeEditor;

/// 代码编辑器语法高亮及其
/// 弹出组件（右键菜单、自动补全、悬停提示、引用列表）的语义颜色。
/// 语法与选区颜色跟随当前皮肤（亮/暗
/// 背景）；弹出组件在任何皮肤下都保持经典暗色调色板，
/// 确保浮层在任意编辑器背景上都清晰可读。
class EditorPalette {
    // ---- 语法（随皮肤变化）----
    int keyword;
    int type;
    int str;
    int comment;
    int number;
    int plain;          // 默认（未高亮）代码文本
    int selection;

    // ---- 弹出组件（共用暗色调色板）----
    int popupBg;        // 菜单 / 补全 / 悬停表面
    int panelBg;        // 次级面板（筛选条、文档面板、表头）
    int hoverBg;        // 参数提示气泡表面
    int border;         // 弹层描边与分隔线
    int selBg;          // 选中/悬停行填充
    int accent;         // 强调边框与关键字类图标
    int signature;      // 签名文本与字段类图标
    int menuText;       // 空闲项标签
    int text;           // 正文/文档文本
    int textSel;        // 选中行上的标签
    int muted;          // 快捷键、类型说明、占位符
    int lineNo;         // 引用列表的行号
    int link;           // Ctrl+悬停下划线

    // ---- 补全类型图标 ----
    int iconMethod;
    int iconType;
    int iconSnippet;
    int iconEnum;
    int iconDefault;
    int iconDisabled;
    int iconGlyph;          // 彩色图标块上的字母
    int iconGlyphDisabled;

    // ---- 诊断 ----
    int error;          // 编译器错误下划线 / 概览刻度
    int errorDim;       // 启发式错误下划线
    int errTipBg;
    int errTipText;
    int warn;           // 执行行标记
    int warnLineBg;     // 执行行底色
    int changeLabel;    // CodeLens 引用计数
    int caretSecondary; // 多光标

    // ---- 概览标尺 / 弹出滚动条 ----
    int minimapBg;
    int minimapThumb;
    int scrollThumb;

    // ---- 弹出框投影 ----
    int shadowSoft;
    int shadow;
    int shadowMed;
    int shadowStrong;

    /// 经典暗色调色板（VS 风格）。
    static EditorPalette Dark() {
        EditorPalette p = EditorPalette.Chrome();
        p.keyword   = 0xFF569CD6;
        p.type      = 0xFF4EC9B0;
        p.str       = 0xFFCE9178;
        p.comment   = 0xFF6A9955;
        p.number    = 0xFFB5CEA8;
        p.plain     = 0xFFD4D4D4;
        p.selection = 0x40264F78;
        return p;
    }

    /// 浅色背景语法，弹出组件保持不变。
    static EditorPalette Light() {
        EditorPalette p = EditorPalette.Chrome();
        p.keyword   = 0xFF0000FF;
        p.type      = 0xFF267F99;
        p.str       = 0xFFA31515;
        p.comment   = 0xFF008000;
        p.number    = 0xFF098658;
        p.plain     = 0xFF1E1E1E;
        p.selection = 0x663399FF;
        // 概览标尺画在编辑器表面上，跟随皮肤而非暗色 chrome。
        p.minimapBg   = 0xFFF3F3F3;
        p.minimapThumb = 0x60000000;
        return p;
    }

    /// 根据皮肤背景亮度选择对应的调色板。
    static EditorPalette For(Gui.Theme t) {
        if (t.IsLightBg()) { return EditorPalette.Light(); }
        return EditorPalette.Dark();
    }

    /// 编辑器配色主题选择器使用的命名预设语法调色板，基于
    /// 暗色 chrome。idx：0 = Dark+（默认），1 = Monokai，2 = Dracula，
    /// 3 = Solarized Dark，4 = Night Owl，5 = High Contrast。
    static EditorPalette Preset(int idx) {
        EditorPalette p = EditorPalette.Dark();
        if (idx == 1) { // Monokai
            p.keyword = 0xFFF92672; p.type   = 0xFF66D9EF; p.str   = 0xFFE6DB74;
            p.comment = 0xFF75715E; p.number = 0xFFAE81FF; p.plain = 0xFFF8F8F2;
        } else if (idx == 2) { // Dracula
            p.keyword = 0xFFFF79C6; p.type   = 0xFF8BE9FD; p.str   = 0xFFF1FA8C;
            p.comment = 0xFF6272A4; p.number = 0xFFBD93F9; p.plain = 0xFFF8F8F2;
        } else if (idx == 3) { // Solarized Dark
            p.keyword = 0xFF859900; p.type   = 0xFFB58900; p.str   = 0xFF2AA198;
            p.comment = 0xFF586E75; p.number = 0xFFD33682; p.plain = 0xFF93A1A1;
        } else if (idx == 4) { // Night Owl
            p.keyword = 0xFFC792EA; p.type   = 0xFF7FDBCA; p.str   = 0xFFECC48D;
            p.comment = 0xFF637777; p.number = 0xFFF78C6C; p.plain = 0xFFD6DEEB;
        } else if (idx == 5) { // High Contrast
            p.keyword = 0xFF00BFFF; p.type   = 0xFF00FF7F; p.str   = 0xFFFFA07A;
            p.comment = 0xFF7FBF7F; p.number = 0xFFFFD700; p.plain = 0xFFFFFFFF;
        }
        return p;
    }

    /// 命名预设随皮肤背景亮度的变体：暗色背景沿用经典暗色预设；
    /// 浅色背景返回同色系加深、白底上可读的浅色变体。没有这一层，
    /// 宿主把暗底预设推给编辑器后，亮色皮肤的白底上画的就是
    /// 浅灰/亮蓝的暗底文字——刺眼且不可读。
    /// idx 含义见 <see cref="Preset"/>。
    static EditorPalette PresetFor(int idx, bool lightBg) {
        if (!lightBg) { return EditorPalette.Preset(idx); }
        if (idx <= 0 || idx > 5) { return EditorPalette.Light(); }
        EditorPalette p = EditorPalette.Chrome();
        p.selection = 0x663399FF;
        // 概览标尺画在编辑器表面上，跟随皮肤而非暗色 chrome。
        p.minimapBg   = 0xFFF3F3F3;
        p.minimapThumb = 0x60000000;
        if (idx == 1) { // Monokai（浅底变体）
            p.keyword = 0xFFB51C52; p.type   = 0xFF1F97A2; p.str   = 0xFF8F7A08;
            p.comment = 0xFF75715E; p.number = 0xFF6A3DC8; p.plain = 0xFF2E2D2A;
        } else if (idx == 2) { // Dracula（浅底变体）
            p.keyword = 0xFFC21F79; p.type   = 0xFF118BA8; p.str   = 0xFF87870A;
            p.comment = 0xFF6272A4; p.number = 0xFF5B4BC4; p.plain = 0xFF282A36;
        } else if (idx == 3) { // Solarized Light（同色系，官方双底设计）
            p.keyword = 0xFF859900; p.type   = 0xFFB58900; p.str   = 0xFF2AA198;
            p.comment = 0xFF586E75; p.number = 0xFFD33682; p.plain = 0xFF657B83;
        } else if (idx == 4) { // Night Owl Light（同作者官方浅底版）
            p.keyword = 0xFF8A4FBF; p.type   = 0xFF1B9E8F; p.str   = 0xFF9C6F1E;
            p.comment = 0xFF637777; p.number = 0xFFC94F33; p.plain = 0xFF403F53;
        } else { // idx == 5：High Contrast（白底最大对比）
            p.keyword = 0xFF0000FF; p.type   = 0xFF006A4E; p.str   = 0xFFAA0000;
            p.comment = 0xFF006400; p.number = 0xFF8B6508; p.plain = 0xFF000000;
        }
        return p;
    }

    /// 两种调色板共用的暗色弹出组件。
    static EditorPalette Chrome() {
        EditorPalette p = new EditorPalette();
        p.popupBg  = 0xFF252526;
        p.panelBg  = 0xFF2D2D30;
        p.hoverBg  = 0xFF1E1E1E;
        p.border   = 0xFF3E3E42;
        p.selBg    = 0xFF094771;
        p.accent   = 0xFF569CD6;
        p.signature = 0xFF9CDCFE;
        p.menuText = 0xFFD4D4D4;
        p.text     = 0xFFCCCCCC;
        p.textSel  = 0xFFFFFFFF;
        p.muted    = 0xFF808080;
        p.lineNo   = 0xFF858585;
        p.link     = 0xFF4EA1D3;

        p.iconMethod  = 0xFF9B6DCA;
        p.iconType    = 0xFF4EC9B0;
        p.iconSnippet = 0xFFDCDCAA;
        p.iconEnum    = 0xFFB8D7A3;
        p.iconDefault = 0xFFCCCCCC;
        p.iconDisabled = 0xFF4A4A4A;
        p.iconGlyph   = 0xFF1E1E1E;
        p.iconGlyphDisabled = 0xFF6A6A6A;

        p.error      = 0xFFFF4444;
        p.errorDim   = 0xAAFF4444;
        p.errTipBg   = 0xFF5A1D1D;
        p.errTipText = 0xFFFF8888;
        p.warn       = 0xFFFFB020;
        p.warnLineBg = 0x40FFB020;
        p.changeLabel = 0xFF608B4E;
        p.caretSecondary = 0xFF00D0A0;

        p.minimapBg   = 0xFF2A2A2E;
        p.minimapThumb = 0x50FFFFFF;
        p.scrollThumb = 0xFF555555;

        p.shadowSoft   = 0x40000000;
        p.shadow       = 0x50000000;
        p.shadowMed    = 0x60000000;
        p.shadowStrong = 0x80000000;
        return p;
    }
}
