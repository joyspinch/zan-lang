using System;
using Gui;
using Gui.Widget;
using Gui.Component.CodeEditor;

namespace Gui.Component;

/// 气泡头像被点击：告诉宿主命中的是 `data` 里的第几条消息
/// （宿主据此弹出发言人的资料面板之类的名片界面）。
delegate void ChatAvatarClick(int msgIndex);

/// 一条聊天消息：记录里显示的角色（user / assistant / tool / error）、
/// 正文，以及这一轮的思考过程（没有则 ""）。
///
/// 多智能体（团队）会话再带一层信封：说话的成员 id、寻址给谁、协议
/// 节拍、所属任务与进度。单助手会话里这些字段全为空，因此**同一种
/// 记录格式**既能服务单助手也能服务团队，存档也能互相打开。
class ChatMessage {
    string role;
    string text;
    string reason;
    string agent;
    string to;
    string kind;
    string taskId;
    int progress;
    /// 这一拍实际发出的工具调用（宿主自己的格式，原样留档）。它不进聊天区
    /// 的正文——那是给人看的；宿主把请求发回模型时带上它，模型才看得到自己
    /// 上一拍真正的调用长什么样。
    string call;
    /// 这条消息产生的时刻（Unix 秒，UTC）。0 = 不知道（旧存档里没有这个
    /// 字段），头行就不显示时刻。流式那条气泡在建出来时定下这个值，后面
    /// 每一拍只改正文，因此显示的是「这一轮开始说话的时间」。
    long at;
    /// 图片附件路径（本地文件 / http(s) / data URI，交给 `Gui.Widget.Image`
    /// 解码）。非空时这一轮在气泡模式里画成一张图片气泡；正文仍然保留，
    /// 供记录模式（ChatStyle.Log）与复制使用。
    string img;

    /// 一条普通消息：无思考、无信封，时间戳取当前 UTC 时刻。
    static ChatMessage Create(string role, string text) {
        ChatMessage m = new ChatMessage();
        m.role = role;
        m.text = text;
        m.reason = "";
        m.agent = "";
        m.to = "";
        m.kind = "";
        m.taskId = "";
        m.progress = 0;
        m.call = "";
        m.at = DateTime.UtcNow().ToUnixSeconds();
        m.img = "";
        return m;
    }

    /// 一条带图片的消息（气泡模式画图片，记录模式画正文）。
    static ChatMessage CreateImage(string role, string path, string text) {
        ChatMessage m = ChatMessage.Create(role, text);
        m.img = path;
        return m;
    }

    /// 带思考过程的普通消息。
    static ChatMessage CreateWithReason(string role, string text, string reason) {
        ChatMessage m = ChatMessage.Create(role, text);
        m.reason = reason;
        return m;
    }

    /// 一条带信封的团队消息。
    static ChatMessage CreateFrom(string role, string text, string agent,
            string to, string kind, string taskId, int progress) {
        ChatMessage m = ChatMessage.Create(role, text);
        m.agent = agent;
        m.to = to;
        m.kind = kind;
        m.taskId = taskId;
        m.progress = progress;
        return m;
    }
}

/// 一位发言者的外观：显示名、色调与 Tag 类名。多智能体程序用它把
/// 成员 id 翻成头行上看到的样子；单助手程序用不到。
class ChatSpeaker {
    string name;
    int tint;
    string tagCls;

    /// 组装一位发言者外观。
    static ChatSpeaker Of(string name, int tint, string tagCls) {
        ChatSpeaker s = new ChatSpeaker();
        s.name = name;
        s.tint = tint;
        s.tagCls = tagCls;
        return s;
    }
}

/// 把成员 id 解析成外观；返回 null 表示「不认识这个 id，按默认助手画」。
delegate ChatSpeaker ChatSpeakerOf(string agent);

/// 把协议节拍（`ChatMessage.kind`）翻成头行右侧的状态标签。
delegate string ChatKindLabel(string kind);

/// 把消息时刻翻成要显示的文本（气泡模式下是分隔时刻与气泡尾巴上的小字）。
/// 给了它就由宿主决定格式（含时区与本地化）；不给时组件用本机时区的 HH:MM。
delegate string ChatClock(long at);

/// 聊天视图的排版模式。
class ChatStyle {
    /// 工具调用式记录（默认）：整宽行、轮次色块、头行横幅。适合助手/工具
    /// 会话——那里每一条背后都跟着一大段工件，气泡会把它挤成窄柱。
    static int Log() { return 0; }
    /// IM 气泡：左右分置的圆角气泡、头像、时刻与发送者名字在外的聊天记录。
    /// 适合人对人的会话（微信/QQ 那种一次一两句的往来）。
    static int Bubble() { return 1; }
}

/// 气泡模式里的一条：一条消息在内容坐标里的位置，以及它要画的东西。
/// 由 `ChatView.BuildBubbles` 生成、`PaintBubbles` 消费，宿主看不到。
///
/// 与记录模式的行表（`TextRun`）分开，是因为两者不是一回事：记录模式
/// 的消息是「若干等高的展示行」，气泡模式的消息是「一个宽度按内容、
/// 高度按换行结果的可变盒子」。把气泡硬塞进行表，量出来的宽度与画出来
/// 的盒子迟早对不上。
class ChatBubble {
    /// 消息在 `data` 里的下标；-1 表示这不是一条消息（busy 提示行）。
    int idx;
    /// 内容坐标里的顶边，以及这块占的高度（含名字行与时刻分隔）。
    int top;
    int h;
    /// 顶部为时刻分隔预留的高度（0 = 这条不画分隔）与要画的文本。
    int divH;
    string divText;
    /// 名字行高度（群聊里别人的消息才有）与名字。
    int nameH;
    string name;
    /// 气泡正文的换行结果与最长行宽（图片气泡为空 / 0）。
    List<string> lines;
    int textW;
    /// 图片气泡的画面尺寸（0 = 文本气泡）。
    int imgW;
    int imgH;
    /// 图片气泡的图片路径（`imgW > 0` 时有效）。
    string imgPath;
    /// 头像首字与配色类名（busy 行没有头像）。
    string initial;
    string avaCls;
    /// 这条是「我」发的（右对齐、头像在右）。
    bool mine;
    /// 气泡自身的宽高（含内边距）。
    int bw;
    int bh;
    /// busy 提示行：气泡用弱色画、不跟任何消息关联。
    bool waiting;

    /// 全部字段显式归零：`new` 出来的实例不依赖语言对未赋值字段的默认值。
    ChatBubble() {
        idx = 0 - 1;
        top = 0;
        h = 0;
        divH = 0;
        divText = "";
        nameH = 0;
        name = "";
        lines = new List<string>();
        textW = 0;
        imgW = 0;
        imgH = 0;
        imgPath = "";
        initial = "";
        avaCls = "";
        mine = false;
        bw = 0;
        bh = 0;
        waiting = false;
    }
}

/// 聊天视图要显示的所有文案。全部由宿主给出，组件本身不依赖任何
/// 翻译层，于是同一个组件可以出现在任意语言的程序里。
class ChatStrings {
    string you;
    string assistant;
    string tool;
    string error;
    string thinkShow;
    string thinkHide;
    string codeMorePre;
    string codeMorePost;
    string codeCollapse;
    string busy;
    string empty;

    /// 英文默认文案；宿主按需覆盖字段即可。
    static ChatStrings Default() {
        ChatStrings s = new ChatStrings();
        s.you = "You";
        s.assistant = "Assistant";
        s.tool = "Tool";
        s.error = "Error";
        s.thinkShow = "Thinking (click to show)";
        s.thinkHide = "Thinking (click to hide)";
        s.codeMorePre = "show ";
        s.codeMorePost = " more code lines";
        s.codeCollapse = "collapse code";
        s.busy = "Thinking...";
        s.empty = "";
        return s;
    }
}

/// 可复用的**聊天视图控件**：消息流 + markdown-lite 排版 + 思考过程与
/// 工具调用折叠 + 长代码块折叠 + 选区复制 + 底端锚定滚动 + busy 提示。
///
///     ChatView chat = new ChatView();
///     chat.WithStrings(myStrings).Bind(msgs);
///     chat.SetBusy(waitingForModel);
///
/// 宿主只提供数据与文案：换行缓存（只重排正在流式输出的那一轮）、
/// 滚轮、选择、折叠状态、Ctrl+C 复制全在控件内部。绘制交给
/// `Gui.Widget.StyledText`，因此宿主一行画布代码也不需要写。
///
/// 声明式界面里可以直接写 `{"kind": "ChatView", "name": "Chat"}`，
/// code-behind 只调用 `Bind` / `SetBusy`。
class ChatView : Control {
    /// 调用方的消息列表（实时视图，不拷贝）。
    List<ChatMessage> data;
    ChatStrings str;
    ChatSpeakerOf speakerOf;
    ChatKindLabel kindLabelOf;
    /// 排版模式（ChatStyle.Log / ChatStyle.Bubble）。
    int style;
    /// 时刻格式化钩子（null = 组件内置的本机时区 HH:MM）。
    ChatClock clockOf;
    /// 气泡头像被点中时的宿主回调（bubble 模式专用，见 AvatarHit）。
    ChatAvatarClick avatarClick;
    /// 命中测试要从鼠标坐标换算气泡几何，而点击事件到达时手里没有
    /// App 参数——OnPaint 把当帧的 app 缓存下来供 AvatarHit 用。
    App uiApp;

    /// 正在排的那份行表，以及增量重排用的水位线：`cacheTurns` 之前的
    /// 轮次已定型，`cachePrefix` 是它们占的行数。
    List<TextRun> cache;
    int cacheTurns;
    int cachePrefix;
    string cacheKey;
    string cacheSig;
    /// 画出来的那份行表：整份重排要跨好几帧，把半成品直接画出去，看到的
    /// 就是「底端锚定的最后一行」一帧一帧往下长——改一次窗口大小，记录就
    /// 自己从头滚到底一遍。所以排好的那一份才换上来。
    List<TextRun> show;
    /// 这次重排是整份重排（行号会全部重映射，换上来时要丢掉选区）。
    bool showStale;

    /// 展开的消息下标（工具结果与长代码块共用一份）。
    List<int> toolOpen;
    SignalInt thinkOpen;
    SignalInt scrollSig;
    LogState sel;
    bool busy;
    /// 记录网格与空态提示：常驻子控件，绘制全在它们内部。
    StyledText grid;
    Label emptyLbl;

    // ---- 气泡模式（ChatStyle.Bubble）----------------------------------
    //
    // 气泡不是等高行：每条消息是一个宽度按内容、高度按换行结果的可变
    // 盒子，所以它不走 StyledText 的行网格，而是在这里量一遍、
    // 在 OnPaint 里按同一份几何画。几何按「宽度 + 字号 + 数据签名」
    // 缓存，只在真正变了的那一帧重算——否则每帧重新量一遍
    // MeasureText 会把一段长会话的帧预算吃光。
    /// 量好的气泡几何（内容坐标，不含滚动偏移）。
    List<ChatBubble> bub;
    /// 几何缓存对应的输入签名（"" = 还没量过）。
    string bubKey;
    /// 几何的总高度（内容坐标），滚动条的界限由它和视口高算出。
    int bubH;
    /// 本次几何是整份重排（会丢弃选区）。
    bool bubStale;
    /// 气泡模式的像素滚动信号（0 = 贴住最新一条）。
    SignalInt bscr;
    /// 气泡正文的最大宽度比例（千分比），由 `WithBubbleWidth` 给。
    int bubWMille;
    /// 上次量气泡用的布局签名（`BubbleLayoutSig`），变了就是整份重排。
    string bubSig;
    /// 别人的气泡上方显示发言人名字（群聊）。自己发的永远不显示。
    bool showNames;

    /// 空视图：英文默认文案，常驻的记录网格与空态提示都已建好
    /// （是否显示由每帧绘制决定）。
    ChatView() {
        this.InitControl("chat", 5);
        this.Pad(0);
        this.gap = 0;
        data = null;
        str = ChatStrings.Default();
        speakerOf = null;
        kindLabelOf = null;
        style = 0;
        clockOf = null;
        // 气泡模式的点击落在子网格 StyledText 上，到不了这里；整条
        // 点击链由 AvatarHit 用当帧几何自己判（日志模式它自会退出）。
        this.OnClick(() => { this.AvatarHit(); });
        cache = new List<TextRun>();
        cacheTurns = 0;
        cachePrefix = 0;
        cacheKey = "";
        cacheSig = "";
        show = new List<TextRun>();
        showStale = false;
        toolOpen = new List<int>();
        thinkOpen = new SignalInt(0);
        scrollSig = new SignalInt(0);
        bub = new List<ChatBubble>();
        bubKey = "";
        bubH = 0;
        bubStale = false;
        bscr = new SignalInt(0);
        bubWMille = 620;
        bubSig = "";
        showNames = false;
        sel = new LogState();
        busy = false;
        grid = new StyledText();
        grid.DockFill();
        // 两个子控件按数据互斥显示：显示与否由 OnPaint 决定，而绘制发生在
        // 同一帧的排版之后，所以出生时先都收起来——否则首帧排版会看到两个
        // 满框的兄弟叠在一起（重叠自检会把它报成手打布局事故）。
        grid.SetShown(false);
        this.Add(grid);
        emptyLbl = new Label();
        emptyLbl.wrap = true;
        emptyLbl.Class = "hint small";
        emptyLbl.DockFill();
        emptyLbl.SetShown(false);
        this.Add(emptyLbl);
    }

    /// 控件类型标识（序列化/设计器用）。
    override string Kind() { return "ChatView"; }

    /// 覆写：CSS 类型选择器名（"log"）。
    override string StyleType() { return "log"; }

    // ---- 宿主接口 ---------------------------------------------------

    /// 绑定调用方的消息列表（实时视图，不拷贝）。
    ChatView Bind(List<ChatMessage> msgs) {
        data = msgs;
        return this;
    }

    /// 全部可见文案（宿主已本地化）。
    ChatView WithStrings(ChatStrings s) {
        if (s != null) { str = s; }
        this.Invalidate();
        return this;
    }

    /// 多智能体会话的外观解析钩子（单助手程序不必调用）。
    ChatView WithSpeakers(ChatSpeakerOf who, ChatKindLabel kindLabel) {
        speakerOf = who;
        kindLabelOf = kindLabel;
        this.Invalidate();
        return this;
    }

    /// 排版模式（ChatStyle.Log / ChatStyle.Bubble）。换了模式要整份重排。
    ChatView WithStyle(int st) {
        style = st;
        this.Invalidate();
        return this;
    }

    /// 时刻格式化钩子（气泡模式的时刻分隔与气泡尾巴小字都走它）。
    ChatView WithClock(ChatClock c) {
        clockOf = c;
        this.Invalidate();
        return this;
    }

    /// 气泡正文的最大宽度（占视口宽的千分比，默认 620 = 六成）。窗口
    /// 很宽时一条短消息拉满整屏并不好读，这个上限就是「一句话最长能
    /// 占多宽」；窗口变窄时气泡仍然按可用宽度收窄，不会溢出。
    ChatView WithBubbleWidth(int mille) {
        if (mille < 250) { mille = 250; }
        if (mille > 1000) { mille = 1000; }
        bubWMille = mille;
        this.Invalidate();
        return this;
    }

    /// 当前排版模式。
    int Style() { return style; }

    /// 别人的气泡上方是否显示发言人名字（群聊场景）。一对一聊天关掉它：
    /// 左边永远只有一个人，名字行只是白占一行高度。
    ChatView WithSpeakerNames(bool on) {
        showNames = on;
        this.Invalidate();
        return this;
    }

    /// 本机时区下这条消息的显示文本；没有记时间的旧消息返回 ""。
    string Clock(long at) {
        if (clockOf != null) { return clockOf(at); }
        if (at <= 0) { return ""; }
        DateTime d = DateTime.FromUnixSeconds(at).ToLocalTime();
        return Text.Left(d.ToTimeString(), 5);
    }

    /// 一条消息头行右侧的本机时区时刻（HH:MM）；没有记时间的旧消息返回 ""。
    static string ClockText(long at) {
        if (at <= 0) { return ""; }
        DateTime d = DateTime.FromUnixSeconds(at).ToLocalTime();
        return Text.Left(d.ToTimeString(), 5);
    }

    /// 模型正在回答：记录末尾显示 busy 行。
    void SetBusy(bool on) { busy = on; }

    /// 选区状态（宿主可持久化或复位）。
    LogState Selection() { return sel; }

    /// 底端锚定的滚动偏移信号（0 = 贴住最新一行）。
    SignalInt Scroll() { return scrollSig; }

    /// 气泡模式的像素滚动偏移信号（0 = 贴住最新一条）。宿主把它接到
    /// 自己的滚动记忆上时用；不接也不影响滚轮与拖动。
    SignalInt BubbleScroll() { return bscr; }

    /// 换掉一整份记录（切换会话）：缓存、折叠、选区与滚动全部归零。
    void Reset() {
        cache = new List<TextRun>();
        cacheTurns = 0;
        cachePrefix = 0;
        cacheKey = "";
        cacheSig = "";
        show = new List<TextRun>();
        showStale = false;
        toolOpen = new List<int>();
        bub = new List<ChatBubble>();
        bubKey = "";
        bubH = 0;
        bubStale = false;
        bscr.Set(0);
        sel.Reset();
        scrollSig.Set(0);
    }

    /// 下一帧整份重排（文案、字号或钩子变了）。
    void Invalidate() {
        cacheKey = "";
        cacheSig = "";
        bubKey = "";
    }

    /// 当前选中的文本（未选中则 ""）。
    string SelectedText() { return ChatView.SelectionText(show, sel); }

    // ---- retained 钩子 ----------------------------------------------

    /// 绘制：按有无消息在记录网格与空态提示间切换；消费滚轮、做
    /// 增量重排（受时间预算约束），把排好的行、滚动、选区与折叠
    /// 状态交给常驻的 StyledText 呈现。
    override void OnPaint(App app) {
        uiApp = app;
        bool has = data != null && data.Count > 0;
        bool bubMode = style == ChatStyle.Bubble();
        emptyLbl.SetShown(!has && !busy);
        // 记录网格只在记录模式下出现：气泡模式的行不是等高的展示行，
        // 走的是这里自己的几何，网格留着只会把上一份记录又画一遍。
        grid.SetShown(!bubMode && (has || busy));
        if (!has && !busy) {
            emptyLbl.Text = str.empty;
            return;
        }
        if (bubMode) {
            this.TakeBubbleWheel(app);
            this.BuildBubble(app);
            this.PaintBubbles(app);
            return;
        }
        this.TakeWheel(app);
        this.Build(app);
        grid.lines = show;
        grid.scroll = scrollSig.Get();
        grid.busy = busy;
        grid.sel = sel;
        grid.interactive = true;
        grid.thinkOpen = thinkOpen;
        grid.toolOpen = toolOpen;
        grid.busyText = str.busy;
        // 记录网格自己画纵向滚动条（它才知道行高与可见行数），这里只把同一个
        // 滚动信号交给它，滚轮与拖动于是动的是同一个量。
        grid.scrollBar = scrollSig;
        // StyledText 在绘制时算出最大滚动，绘制发生在子控件那一步，
        // 因此这里读到的是上一帧的界限——足够用来夹住滚动值。
        int max = grid.maxScroll;
        if (scrollSig.Get() > max) { scrollSig.Set(max); }
        if (scrollSig.Get() < 0) { scrollSig.Set(0); }
        this.TakeCopy(app);
    }

    /// 宿主注册「气泡头像被点」回调；链式返回自己。
    ChatView OnAvatarClick(ChatAvatarClick cb) {
        avatarClick = cb;
        return this;
    }

    /// 点击命中测试：只有 bubble 模式响应。点击坐标来自缓存的
    /// uiApp（事件到达在两帧之间，没有 app 参数），气泡几何与
    /// PaintBubbles 同一套换算：先滚动态偏移出每条气泡的 y，
    /// 头像在气泡同行一侧（我方在右、对方在左），直径 34 缩放像素。
    void AvatarHit() {
        if (avatarClick == null || uiApp == null) { return; }
        if (style != ChatStyle.Bubble() || bubKey == "") { return; }
        App app = uiApp;
        if (app.mouseX < bx || app.mouseX >= bx + bw) { return; }
        if (app.mouseY < by || app.mouseY >= by + bh) { return; }
        int pad = app.Scale(12); int padV = app.Scale(10); int avaD = app.Scale(34);
        int viewH = bh - padV * 2; if (viewH < 0) { viewH = 0; }
        int over = bubH - viewH; if (over < 0) { over = 0; }
        int y0 = by + padV - (over - bscr.Get());
        for (int i = 0; i < bub.Count; i = i + 1) {
            ChatBubble b = bub[i];
            if (b.waiting) { continue; }
            int ry = y0 + b.top;
            if (app.mouseY < ry || app.mouseY >= ry + avaD) { continue; }
            int avaX = bx + pad;
            if (b.mine) { avaX = bx + bw - pad - avaD; }
            if (app.mouseX >= avaX && app.mouseX < avaX + avaD) {
                avatarClick(b.idx);
                return;
            }
        }
    }

    /// 指针在气泡区上时滚轮滚动：气泡是像素滚动的，一档滚 40px（约一
    /// 行多一点），而不是记录模式的一整行。
    void TakeBubbleWheel(App app) {
        if (!app.CaptureWheel(bx, by, bw, bh)) { return; }
        int d = app.window.EventKeyCode();
        int step = d / 120;
        if (step == 0) {
            if (d > 0) { step = 1; }
            else if (d < 0) { step = 0 - 1; }
        }
        int padV = app.Scale(10);
        int viewH = bh - padV * 2;
        int over = bubH - viewH;
        if (over < 0) { over = 0; }
        bscr.Set(bscr.Get() - step * app.Scale(40));
        if (bscr.Get() > over) { bscr.Set(over); }
        if (bscr.Get() < 0) { bscr.Set(0); }
        app.RequestRedraw();
    }

    /// 指针在记录上时滚轮滚动。
    void TakeWheel(App app) {
        if (!app.CaptureWheel(bx, by, bw, bh)) { return; }
        int d = app.window.EventKeyCode();
        int step = d / 120;
        if (step == 0) {
            if (d > 0) { step = 1; }
            else if (d < 0) { step = 0 - 1; }
        }
        scrollSig.Set(scrollSig.Get() + step);
        app.RequestRedraw();
    }

    /// 指针在记录上时 Ctrl+C 复制选中的文本。
    void TakeCopy(App app) {
        if (app.EventKind() != 4) { return; }
        if (app.window.EventKeyCode() != 67) { return; }
        if (!Modifiers.HasCtrl(app.window.EventMods())) { return; }
        if (!sel.HasSelection()) { return; }
        if (app.mouseX < bx || app.mouseX > bx + bw) { return; }
        if (app.mouseY < by || app.mouseY > by + bh) { return; }
        Clipboard.SetText(this.SelectedText());
        app.RequestRedraw();
    }

    /// 换行缓存：只有记录、宽度、字号或折叠状态变了才重建，而且只有
    /// 正在流式输出的最后一轮会重排——1000 轮的会话和空会话一样便宜。
    void Build(App app) {
        if (bw <= 0 || bh <= 0) { return; }
        // 纵向滚动条的宽度始终预留：换行宽度跟着滚动条的有无变，就会在「刚
        // 好多一行」附近每帧重排一次。
        int textW = bw - app.Scale(28) - StyledText.BarW(app);
        if (textW < app.Scale(20)) { textW = app.Scale(20); }
        // 尾轮签名：流式输出时变的不只是长度，成员、状态和进度都会改
        // 名字行上的头像与状态芯片，只看长度会让那一行停在旧状态上。
        string tailSig = "-";
        if (data.Count > 0) {
            ChatMessage tail = data[data.Count - 1];
            tailSig = Convert.ToString(tail.text.Length + tail.reason.Length)
                + "/" + tail.role + "/" + tail.agent + "/" + tail.kind
                + "/" + Convert.ToString(tail.progress);
        }
        int toolSig = toolOpen.Count;
        for (int i = 0; i < toolOpen.Count; i = i + 1) {
            toolSig = toolSig * 131 + toolOpen[i] + 1;
        }
        // 布局输入：这里任何变化都让每一行失效，整份记录要重排。
        // 主题代次也算布局输入：行缓存里烘焙的是上一主题解析出的
        // 文字颜色（chatview::body 等），换肤后表面即时变暗而文字
        // 停留在旧配色，正是「暗色皮肤下聊天内容看不见」的来源——
        // 代次一变就整份重排，颜色跟着皮肤走。
        string layoutSig = Convert.ToString(textW)
            + ":" + Convert.ToString(StyledText.FontPx(app))
            + ":" + Convert.ToString(thinkOpen.Get())
            + ":" + Convert.ToString(toolSig)
            + ":" + Convert.ToString(app.bgThemeGen);
        string keyNow = layoutSig + ":" + Convert.ToString(data.Count)
            + ":" + tailSig;
        if (keyNow == cacheKey) { return; }
        bool full = layoutSig != cacheSig
            || data.Count < cacheTurns + 1
            || cache.Count < cachePrefix;
        int stable = data.Count - 1;
        if (stable < 0) { stable = 0; }
        if (full) {
            cache = new List<TextRun>();
            cacheTurns = 0;
            cachePrefix = 0;
            cacheSig = layoutSig;
            // 重排会重映射每个行号，留着的选区会高亮错的文本；旧的一份还在
            // 画着，所以等排完换上来的那一下再丢选区。
            showStale = true;
        } else {
            while (cache.Count > cachePrefix) {
                cache.RemoveAt(cache.Count - 1);
            }
        }
        if (cacheTurns < stable) {
            // 整份重排按拍切开做：一份长记录（工具贴过整个文件、几十轮
            // 回答）改一次宽度就要重排每一行，整帧做完是秒级的，GUI
            // 线程停一秒就是窗口标题上的「未响应」。每帧只排到预算用完，
            // 剩下的下一帧接着排（缓存的水位线本来就是为增量重排准备的）。
            int budget = ChatView.BuildBudgetMs();
            int began = Window.GetTickMs();
            while (cacheTurns < stable) {
                int upto = cacheTurns + ChatView.BuildChunk();
                if (upto > stable) { upto = stable; }
                this.BuildRange(app, cacheTurns, upto, textW);
                cacheTurns = upto;
                cachePrefix = cache.Count;
                if (Window.GetTickMs() - began >= budget) { break; }
            }
            if (cacheTurns < stable) {
                // 还没排完：这一帧先把已排好的部分画出来，下一帧接着排。
                // cacheKey 留空 = 缓存未完成，cacheSig 已跟上本次布局，于是
                // 下一帧从水位线继续而不是从头重来。
                cacheKey = "";
                // 第一次填充（切换会话、刚打开）没有旧的一份可画，这时画半
                // 成品是「越排越多」而不是「跳着滚」，比空白好。
                if (show.Count == 0) { show = cache; }
                app.NoteDamage(bx, by, bw, bh);
                app.window.Wake();
                return;
            }
        }
        this.BuildRange(app, stable, data.Count, textW);
        cacheKey = keyNow;
        // 排完了才换上来：整份重排跨了多少帧，画的都还是上一份完整布局。
        show = cache;
        if (showStale) {
            sel.ClearSelection();
            showStale = false;
        }
    }

    // ---- 排版 -------------------------------------------------------

    /// 折叠长代码块前保留的行数。
    static int CodeFoldLines() { return 14; }

    /// 整份重排时每帧的时间预算（毫秒）：排完这么久就把控制权交
    /// 回循环，下一帧接着排。一帧 16ms 的预算里留出绘制的份。
    static int BuildBudgetMs() { return 8; }

    /// 一个切片重排多少轮：太小会把时间花在重新取时间上，太大则一个
    /// 切片就可能超出预算。
    static int BuildChunk() { return 4; }

    /// 列表是否含有 `v`。
    static bool HasInt(List<int> xs, int v) {
        for (int i = 0; i < xs.Count; i = i + 1) {
            if (xs[i] == v) { return true; }
        }
        return false;
    }

    /// 发言者编码，用于整块着色：0 我 / 1 助手 / 2 工具 / 3 错误。
    static int RoleCode(string role) {
        if (role == "user") { return 0; }
        if (role == "tool") { return 2; }
        if (role == "error") { return 3; }
        return 1;
    }

    /// 把 `s` 贪心换行到 `maxW` 像素，结果追加进 `outLines`。
    static void WrapInto(string s, int maxW, int fontSize,
            List<string> outLines) {
        List<string> hard = CodeEditor.SplitLines(s);
        if (hard.Count == 0) { hard.Add(""); }
        for (int li = 0; li < hard.Count; li = li + 1) {
            string line = hard[li];
            if (line == "") { outLines.Add(""); }
            while (line != "") {
                int n = line.Length;
                // 先倍增探出一个放不下的上界，再只在这段里二分：每排一行
                // 都先量整条剩余文本，是平方级的开销——一条几十 KB 的工具
                // 输出于是要量掉几百次几十 KB 的文本，正是 GUI 线程一停
                // 一两秒、窗口标题变「未响应」的那份活。排一行只需要量到
                // 它自己那一段。
                int lo = 0;
                int probe = 64;
                if (probe > n) { probe = n; }
                while (probe < n
                        && Canvas.MeasureText(line.Substring(0, probe),
                            fontSize) <= maxW) {
                    lo = probe;
                    probe = probe * 2;
                    if (probe > n) { probe = n; }
                }
                if (probe >= n
                        && Canvas.MeasureText(line, fontSize) <= maxW) {
                    outLines.Add(line);
                    line = "";
                } else {
                    // prefix(lo) 放得下，prefix(hi) 放不下：二分出最长前缀。
                    int hi = probe;
                    while (lo + 1 < hi) {
                        int mid = (lo + hi) / 2;
                        if (Canvas.MeasureText(line.Substring(0, mid), fontSize)
                                <= maxW) { lo = mid; }
                        else { hi = mid; }
                    }
                    // 绝不在多字节字符内部断行，且至少保留一个完整字符，
                    // 保证循环推进。
                    if (lo < 1) { lo = 1; }
                    lo = Text.ClampCharStart(line, lo);
                    if (lo <= 0) { lo = Text.NextCharEnd(line, 0); }
                    outLines.Add(line.Substring(0, lo));
                    line = line.Substring(lo, line.Length - lo);
                }
            }
        }
    }

    /// 把 `s` 换行后作为展示行追加进缓存（至少追加一行）。
    void WrapRows(string s, int maxW, int fontSize, int color, int kind) {
        List<string> wrapped = new List<string>();
        ChatView.WrapInto(s, maxW, fontSize, wrapped);
        for (int i = 0; i < wrapped.Count; i = i + 1) {
            cache.Add(TextRun.Create(wrapped[i], color, kind));
        }
    }

    /// 收束一个轮次：最后一行带上分隔标记。StyledText 把它画成块底部的
    /// 一条细线，比追加一整行空行省掉整整一行行高——记录里那些空行
    /// 就是这么来的。
    void MarkBlockEnd() {
        if (cache.Count > 0) { cache[cache.Count - 1].last = true; }
    }

    /// 这一行正文该不该丢掉：markdown 段落之间的空行只留一条，紧跟
    /// 名字行 / 折叠行的空行直接不要，间距统一交给行高与分隔线。
    bool SkipBlank(string s) {
        if (s != "") { return false; }
        if (cache.Count == 0) { return true; }
        TextRun prev = cache[cache.Count - 1];
        if (prev.kind == 3 || prev.kind == 4 || prev.kind == 5) { return true; }
        return prev.text == "";
    }

    /// 去掉 `floorIdx` 之后结尾处的空正文行（模型爱在答案末尾留空行）。
    void TrimTrailBlank(int floorIdx) {
        while (cache.Count > floorIdx
            && cache[cache.Count - 1].kind == 0
            && cache[cache.Count - 1].text == "") {
            cache.RemoveAt(cache.Count - 1);
        }
    }

    /// 给 `start` 之后新增的行标注所属发言者，以便整块着色。
    void OwnRows(int start, int owner) {
        for (int i = start; i < cache.Count; i = i + 1) {
            cache[i].owner = owner;
        }
    }

    /// 去掉轻量 markdown 标记（标题井号、`**` 粗体、单反引号），保留列表短横。
    static string MdStrip(string ln) {
        string s = ln;
        int h = 0;
        for (; h < s.Length && s.Substring(h, 1) == "#"; h = h + 1) { }
        if (h > 0 && h < s.Length && s.Substring(h, 1) == " ") {
            s = s.Substring(h + 1, s.Length - h - 1);
        }
        StringBuilder sb = new StringBuilder();
        int i = 0;
        while (i < s.Length) {
            string ch = s.Substring(i, 1);
            if (ch == "*" && i + 1 < s.Length
                    && s.Substring(i + 1, 1) == "*") { i = i + 2; }
            else if (ch == "`") { i = i + 1; }
            else { sb.Append(ch); i = i + 1; }
        }
        return sb.ToString();
    }

    /// 记录里是否有需要折叠的长代码块。
    static bool HasLongCode(List<string> src) {
        int i = 0;
        while (i < src.Count) {
            string ln = src[i];
            bool fence = ln.Length >= 3 && ln.Substring(0, 3) == "```";
            if (fence) {
                int endAt = i + 1;
                for (endAt = i + 1; endAt < src.Count; endAt = endAt + 1) {
                    string el = src[endAt];
                    if (el.Length >= 3 && el.Substring(0, 3) == "```") { break; }
                }
                if (endAt - i - 1 > ChatView.CodeFoldLines() + 2) { return true; }
                i = endAt + 1;
                continue;
            }
            i = i + 1;
        }
        return false;
    }

    /// 只排 [from, to) 这几轮并**追加**进缓存。这样切分让已定型轮次的
    /// 换行结果留下来，只重排正在流式输出的那一轮。
    void BuildRange(App app, int from, int to, int textW) {
        Theme t = app.theme;
        StyleBox headStyle = Style.Part(app, "chatview", "head", "",
                                        "", "", Style.SNormal());
        StyleBox headPrimaryStyle = Style.Part(app, "chatview", "head", "",
                                               "primary", "", Style.SNormal());
        StyleBox headErrorStyle = Style.Part(app, "chatview", "head", "",
                                             "error", "", Style.SNormal());
        StyleBox headToolStyle = Style.Part(app, "chatview", "head", "",
                                            "tool", "", Style.SNormal());
        StyleBox bodyStyle = Style.Part(app, "chatview", "body", "",
                                        "", "", Style.SNormal());
        StyleBox bodyErrorStyle = Style.Part(app, "chatview", "body", "",
                                             "error", "", Style.SNormal());
        StyleBox bodyToolStyle = Style.Part(app, "chatview", "body", "",
                                            "tool", "", Style.SNormal());
        StyleBox mutedStyle = Style.Part(app, "chatview", "muted", "",
                                         "", "", Style.SNormal());
        StyleBox codeStyle = Style.Part(app, "chatview", "code", "",
                                        "", "", Style.SNormal());
        List<int> togPos = new List<int>();
        List<int> togMsg = new List<int>();
        int i = from;
        if (i < 0) { i = 0; }
        int stop = to;
        if (stop > data.Count) { stop = data.Count; }
        while (i < stop) {
            ChatMessage msg = data[i];
            // 空气泡不画：一拍只发了工具调用（正文和思考都空）时，留下的就是
            // 一个光有名字的空框，下面紧跟着的工具行才是内容。
            if (msg.text == "" && msg.reason == ""
                && i < data.Count - 1) {
                i = i + 1;
                continue;
            }
            string head = str.assistant;
            int headCol = headStyle.FgOr(0);
            int bodyCol = bodyStyle.FgOr(0);
            string headCls = "success";
            if (msg.role == "user") {
                head = str.you;
                headCol = headPrimaryStyle.FgOr(0);
                headCls = "primary";
            } else if (msg.role == "error") {
                head = str.error;
                headCol = headErrorStyle.FgOr(0);
                bodyCol = bodyErrorStyle.FgOr(0);
                headCls = "danger";
            } else if (msg.role == "tool") {
                head = str.tool;
                headCol = headToolStyle.FgOr(0);
                bodyCol = bodyToolStyle.FgOr(0);
                headCls = "";
            }
            // 团队会话里说话的是某位成员，而不是「助手」；读者一眼想看的
            // 就是谁在做、做到哪了，细节仍然折叠在下面。
            string headStatus = "";
            int headPct = 0 - 1;
            bool named = false;
            if (msg.agent != "" && speakerOf != null) {
                ChatSpeaker who = speakerOf(msg.agent);
                if (who != null) {
                    named = true;
                    head = who.name;
                    headCol = who.tint;
                    headCls = who.tagCls;
                    if (msg.kind != "" && kindLabelOf != null) {
                        headStatus = kindLabelOf(msg.kind);
                    }
                    if (msg.progress > 0) { headPct = msg.progress; }
                }
            }
            // 工具调用/结果折叠成**一行**可点摘要（它的首行，例如
            // "list_dir src/"），点开才显示完整结果：长输出不再埋掉答案，
            // 又随时可查。
            if (msg.role == "tool") {
                int msgStart = cache.Count;
                List<string> tl = CodeEditor.SplitLines(msg.text);
                string summary = "";
                if (tl.Count > 0) { summary = tl[0]; }
                bool open = ChatView.HasInt(toolOpen, i);
                bool expandable = tl.Count > 1;
                string prefix = "  ";
                if (expandable) {
                    if (open) { prefix = "▼ "; } else { prefix = "▶ "; }
                }
                List<string> tmp = new List<string>();
                ChatView.WrapInto(prefix + head + ": " + summary, textW,
                    Style.FontFallback(app, "small"), tmp);
                string sline = prefix + head;
                if (tmp.Count > 0) {
                    sline = tmp[0];
                    if (tmp.Count > 1) { sline = sline + " …"; }
                }
                if (expandable) {
                    togPos.Add(cache.Count);
                    togMsg.Add(i);
                    cache.Add(TextRun.Create(sline, headCol, 5));
                } else {
                    cache.Add(TextRun.Create(sline, headCol, 3));
                }
                if (open) {
                    for (int k = 1; k < tl.Count; k = k + 1) {
                        this.WrapRows(tl[k], textW, Style.FontFallback(app, "small"), bodyCol, 0);
                    }
                }
                this.TrimTrailBlank(msgStart + 1);
                this.OwnRows(msgStart, 2);
                this.MarkBlockEnd();
                i = i + 1;
                continue;
            }
            int msgStart = cache.Count;
            TextRun hln = TextRun.Create(head, headCol, 3);
            hln.ava = StyledText.Initial(head);
            hln.tagCls = headCls;
            hln.status = headStatus;
            hln.pct = headPct;
            // 这一轮是何时说的：贴在头行右缘，不挤名字、节拍标签和百分比。
            hln.time = ChatView.ClockText(msg.at);
            cache.Add(hln);
            // 思考过程是答案上方一段暗色的独立区块，默认折叠成一行可点
            // 提示，绝不埋掉答案。
            bool think = thinkOpen.Get() == 1;
            if (msg.role == "assistant" && msg.reason != "") {
                if (think) {
                    cache.Add(TextRun.Create(str.thinkHide, mutedStyle.FgOr(0), 4));
                } else {
                    cache.Add(TextRun.Create(str.thinkShow, mutedStyle.FgOr(0), 4));
                }
                if (think) {
                    List<string> rsrc = CodeEditor.SplitLines(msg.reason);
                    for (int rk = 0; rk < rsrc.Count; rk = rk + 1) {
                        this.WrapRows(ChatView.MdStrip(rsrc[rk]), textW,
                            Style.FontFallback(app, "small"), mutedStyle.FgOr(0), 0);
                    }
                }
            }
            // markdown-lite：围栏代码块有代码底纹与配色；标题 / 列表 /
            // 行内 `code` / `**粗体**` 简化成可读的纯文本。
            List<string> src = CodeEditor.SplitLines(msg.text);
            bool inCode = false;
            // 超长代码块（模型打印的整份文件，或中断答案留下的半份）折叠
            // 成前若干行加一行「展开剩余 N 行」，和工具结果一个待遇。
            bool codeOpen = ChatView.HasInt(toolOpen, i);
            if (codeOpen && ChatView.HasLongCode(src)) {
                togPos.Add(cache.Count);
                togMsg.Add(i);
                cache.Add(TextRun.Create("▼ " + str.codeCollapse,
                    mutedStyle.FgOr(0), 5));
            }
            int li = 0;
            while (li < src.Count) {
                string ln = src[li];
                bool fence = ln.Length >= 3 && ln.Substring(0, 3) == "```";
                if (fence && !inCode && !codeOpen) {
                    // 开围栏：先量整块，再决定要不要折叠。
                    int endAt = li + 1;
                    for (endAt = li + 1; endAt < src.Count; endAt = endAt + 1) {
                        string el = src[endAt];
                        if (el.Length >= 3
                                && el.Substring(0, 3) == "```") { break; }
                    }
                    int blockLen = endAt - li - 1;
                    if (blockLen > ChatView.CodeFoldLines() + 2) {
                        int keep = ChatView.CodeFoldLines();
                        for (int ck = li + 1; ck < li + 1 + keep; ck = ck + 1) {
                            this.WrapRows(src[ck], textW - app.Scale(8),
                                Style.FontFallback(app, "small"), codeStyle.FgOr(0), 1);
                        }
                        togPos.Add(cache.Count);
                        togMsg.Add(i);
                        cache.Add(TextRun.Create("▶ " + str.codeMorePre
                            + Convert.ToString(blockLen - keep)
                            + str.codeMorePost, mutedStyle.FgOr(0), 5));
                        li = endAt + 1;
                        continue;
                    }
                }
                if (fence) {
                    inCode = !inCode;
                } else if (inCode) {
                    this.WrapRows(ln, textW - app.Scale(8), Style.FontFallback(app, "small"),
                        codeStyle.FgOr(0), 1);
                } else {
                    string shown = ChatView.MdStrip(ln);
                    int kind = 0;
                    int col = bodyCol;
                    if (ln.Length >= 2 && ln.Substring(0, 1) == "#") {
                        kind = 2;
                        col = bodyStyle.FgOr(0);
                    }
                    if (!this.SkipBlank(shown)) {
                        this.WrapRows(shown, textW, Style.FontFallback(app, "small"), col, kind);
                    }
                }
                li = li + 1;
            }
            int ownCode = ChatView.RoleCode(msg.role);
            // 有说话人的 user 消息不是用户发言（多智能体会话里那是流程自己发的
            // 指令）：染成「我」那种色块，读起来就是用户发了一屏自己没发过的话。
            if (msg.role == "user" && named) { ownCode = 2; }
            this.TrimTrailBlank(msgStart + 1);
            this.OwnRows(msgStart, ownCode);
            // 一条细分隔线收束一轮：六个成员轮流说话时，紧贴的色块会读成
            // 一整片，而整行空行又把记录撑得半屏空白。
            this.MarkBlockEnd();
            i = i + 1;
        }
        // kind-5 折叠行控制的消息下标（其余为 -1）。
        for (int tpi = 0; tpi < togPos.Count; tpi = tpi + 1) {
            int at = togPos[tpi];
            if (at >= 0 && at < cache.Count) { cache[at].meta = togMsg[tpi]; }
        }
    }

    // ---- 气泡排版（ChatStyle.Bubble）----------------------------------

    /// 两条消息相隔多久才插一条时刻分隔。5 分钟内连着说的几句算一轮，
    /// 只在轮次开头报一次时间——和 IM 客户端的手感一致。
    static int BubbleTimeGap() { return 300; }

    /// 气泡正文的字号。
    static int BubbleFont(App app) {
        return Style.FontFallback(app, "small");
    }

    /// 话轮几何的输入签名。它一变，整份重排（行宽全变），因此与
    /// 缓存键分开算：`layoutSig` 记账、`keyNow` 判断这一帧要不要干活。
    string BubbleLayoutSig(App app) {
        return Convert.ToString(bw) + ":" + Convert.ToString(ChatView.BubbleFont(app))
            + ":" + Convert.ToString(bubWMille)
            + ":" + Convert.ToString(app.bgThemeGen)
            + ":" + (showNames ? "1" : "0");
    }

    /// 把消息流量成一列可变高的气泡盒子（内容坐标）。换行结果缓存在
    /// `bub` 里，只有签名变了才重算——`TextWrap.Lines` 是逐字符量宽，
    /// 每次绘制都重排一份长会话会把帧预算吃光。
    void BuildBubble(App app) {
        if (bw <= 0 || bh <= 0) { return; }
        int count = 0;
        if (data != null) { count = data.Count; }
        if (count == 0 && !busy) {
            bub = new List<ChatBubble>();
            bubH = 0;
            bubKey = "empty";
            return;
        }
        int fontPx = ChatView.BubbleFont(app);
        string tailSig = "-";
        if (count > 0) {
            ChatMessage tm = data[count - 1];
            tailSig = Convert.ToString(tm.text.Length + tm.img.Length)
                + "/" + tm.role;
        }
        string layoutSig = this.BubbleLayoutSig(app);
        string keyNow = layoutSig + ":" + Convert.ToString(count) + ":" + tailSig
            + ":" + (busy ? "1" : "0");
        if (keyNow == bubKey) { return; }
        // 行宽变了就整份重排：留着的选区会框住错的文本，换上来的那一帧
        // 一起丢掉（与记录模式同一条约定）。
        bubStale = layoutSig != bubSig;
        bubSig = layoutSig;

        int pad = app.Scale(12);
        int padV = app.Scale(10);
        int avaD = app.Scale(34);
        int gapA = app.Scale(8);
        int tailW = app.Scale(6);
        int padX = app.Scale(12);
        int padY = app.Scale(9);
        int lineH = Canvas.FontHeight(fontPx) + app.Scale(3);
        int nameH = 0;
        if (showNames) {
            nameH = Canvas.FontHeight(Style.FontFallback(app, "tiny"))
                + app.Scale(3);
        }
        int maxBub = bw - pad * 2 - avaD - gapA - tailW;
        int cap = bw * bubWMille / 1000;
        if (cap < maxBub && cap > app.Scale(120)) { maxBub = cap; }
        if (maxBub < app.Scale(120)) { maxBub = app.Scale(120); }
        int textW = maxBub - padX * 2;
        if (textW < app.Scale(40)) { textW = app.Scale(40); }

        List<ChatBubble> rows = new List<ChatBubble>();
        List<int> prevAt = new List<int>();
        prevAt.Add(0);
        int yy = 0;
        int i = 0;
        while (i < count) {
            ChatMessage msg = data[i];
            // 一拍只发了工具调用（正文、图片、思考全空）时留下的是空壳，
            // 记录模式不画它，气泡模式同样不画。
            if (msg.text == "" && msg.img == "" && msg.reason == ""
                && i < count - 1) {
                i = i + 1;
                continue;
            }
            bool mine = msg.role == "user";
            ChatBubble b = new ChatBubble();
            b.idx = i;
            b.mine = mine;
            if (mine) {
                b.initial = this.InitialOf(str.you);
                b.avaCls = "bubble-mine";
            } else {
                b.initial = this.SpeakerInitial(msg);
                b.avaCls = "bubble-other";
            }
            if (showNames && !mine) {
                b.nameH = nameH;
                b.name = this.SpeakerName(msg);
            }
            // 时刻分隔：轮次开头、或与上一句隔得够久。
            if (msg.at > 0 && msg.at - prevAt[0] >= ChatView.BubbleTimeGap()) {
                b.divH = lineH + app.Scale(8);
                b.divText = this.Clock(msg.at);
                prevAt[0] = msg.at;
            }
            // 图片气泡：按图片的自然尺寸缩进可用盒子，不放大。
            if (msg.img != "") {
                int natW = Canvas.ImageWidth(msg.img);
                int natH = Canvas.ImageHeight(msg.img);
                if (natW > 0 && natH > 0) {
                    int iw = natW;
                    int ih = natH;
                    int maxH = app.Scale(260);
                    if (iw > textW) {
                        ih = ih * textW / iw;
                        iw = textW;
                    }
                    if (ih > maxH) {
                        iw = iw * maxH / ih;
                        ih = maxH;
                    }
                    b.imgW = iw;
                    b.imgH = ih;
                    b.imgPath = msg.img;
                    b.bw = iw + padX * 2;
                    b.bh = ih + padY * 2;
                }
            }
            if (b.imgW <= 0) {
                List<string> ls = TextWrap.Lines(msg.text, textW, fontPx);
                int widest = 0;
                for (int li = 0; li < ls.Count; li = li + 1) {
                    int lw = Canvas.MeasureText(ls[li], fontPx);
                    if (lw > widest) { widest = lw; }
                }
                b.lines = ls;
                b.textW = widest;
                b.bw = widest + padX * 2;
                if (b.bw > maxBub) { b.bw = maxBub; }
                b.bh = ls.Count * lineH + padY * 2;
            }
            b.top = yy + b.divH + b.nameH;
            int rowH = avaD;
            if (b.bh > rowH) { rowH = b.bh; }
            b.h = b.divH + b.nameH + rowH;
            yy = b.top + rowH + app.Scale(10);
            rows.Add(b);
            i = i + 1;
        }
        if (busy) {
            ChatBubble b = new ChatBubble();
            b.waiting = true;
            b.lines = TextWrap.Lines(str.busy, textW, fontPx);
            int widest = 0;
            for (int li = 0; li < b.lines.Count; li = li + 1) {
                int lw = Canvas.MeasureText(b.lines[li], fontPx);
                if (lw > widest) { widest = lw; }
            }
            b.textW = widest;
            b.bw = widest + padX * 2;
            b.bh = b.lines.Count * lineH + padY * 2;
            b.top = yy;
            b.h = b.bh;
            yy = b.top + b.bh + app.Scale(10);
            rows.Add(b);
        }
        bub = rows;
        bubH = yy + padV;
        bubKey = keyNow;
    }

    /// 发言者显示名（多智能体会话走 `speakerOf`，否则用文案里的助手名）。
    string SpeakerName(ChatMessage msg) {
        if (msg.agent != "" && speakerOf != null) {
            ChatSpeaker who = speakerOf(msg.agent);
            if (who != null) { return who.name; }
        }
        return str.assistant;
    }

    /// 发言者头像里的首字。
    string SpeakerInitial(ChatMessage msg) {
        return StyledText.Initial(this.SpeakerName(msg));
    }

    /// 名字首字（与 `StyledText.Initial` 同一套字符边界规则）。
    string InitialOf(string name) {
        return StyledText.Initial(name);
    }

    /// 画一列气泡：时刻分隔居中、气泡靠发送者一侧、头像在最外侧，
    /// 图片气泡按 contain 铺进盒内。滚动是「离底部多少像素」，
    /// 滚轮与滚动条动的是同一个量。
    void PaintBubbles(App app) {
        if (bubKey == "") { return; }
        Canvas c = app.canvas;
        Theme t = app.theme;
        StyleBox mineBox = Style.Part(app, "chatview", "bubble", "",
                                      "mine", "", Style.SNormal());
        StyleBox otherBox = Style.Part(app, "chatview", "bubble", "",
                                       "other", "", Style.SNormal());
        StyleBox waitBox = Style.Part(app, "chatview", "bubble", "",
                                      "waiting", "", Style.SNormal());
        StyleBox timeBox = Style.Part(app, "chatview", "time", "",
                                      "", "", Style.SNormal());
        StyleBox nameBox = Style.Part(app, "chatview", "name", "",
                                      "", "", Style.SNormal());
        int pad = app.Scale(12);
        int padV = app.Scale(10);
        int avaD = app.Scale(34);
        int gapA = app.Scale(8);
        int tailW = app.Scale(6);
        // 尾巴不是贴在气泡外角，而是沿外缘下移一段：四角保持圆角，
        // 尾巴变成侧缘上的一枚小鼓包，压在头像与气泡之间。
        int tailDrop = app.Scale(12);
        int padX = app.Scale(12);
        int padY = app.Scale(9);
        int fontPx = ChatView.BubbleFont(app);
        int lineH = Canvas.FontHeight(fontPx) + app.Scale(3);
        int radius = app.Scale(6);
        int viewH = bh - padV * 2;
        if (viewH < 0) { viewH = 0; }
        int over = bubH - viewH;
        if (over < 0) { over = 0; }
        if (bscr.Get() > over) { bscr.Set(over); }
        if (bscr.Get() < 0) { bscr.Set(0); }
        int y0 = by + padV - (over - bscr.Get());
        c.PushClip(bx, by, bw, bh);
        for (int i = 0; i < bub.Count; i = i + 1) {
            ChatBubble b = bub[i];
            // 分隔与名字行都在 `b.top` 之上，先算它们的绝对 y。
            int dvy = y0 + b.top - b.divH - b.nameH;
            if (b.divH > 0) {
                int tf = timeBox.FontOr(Style.FontFallback(app, "tiny"));
                int tw = Canvas.MeasureText(b.divText, tf);
                int tx = bx + (bw - tw) / 2;
                int ty = dvy + (b.divH - Canvas.FontHeight(tf)) / 2;
                if (ty + Canvas.FontHeight(tf) > by
                    && ty < by + bh) {
                    c.DrawText(tx, ty, b.divText, timeBox.FgOr(0), tf);
                }
            }
            int ry = y0 + b.top;
            int rowH = avaD;
            if (b.bh > rowH) { rowH = b.bh; }
            if (ry + rowH < by || ry > by + bh) { continue; }
            int bx0 = 0;
            int avaX = 0;
            int mask = 0;
            int cy = 0;
            if (b.waiting || !b.mine) {
                avaX = bx + pad;
                bx0 = avaX + avaD + gapA + tailW;
                mask = 15;   // 四角全圆：尾巴已下移到侧缘
                cy = ry;
            } else {
                avaX = bx + bw - pad - avaD;
                bx0 = avaX - gapA - tailW - b.bw;
                mask = 15;
                cy = ry;
            }
            if (b.nameH > 0 && !b.waiting) {
                int nf = nameBox.FontOr(Style.FontFallback(app, "tiny"));
                int ny = ry - b.nameH
                    + (b.nameH - Canvas.FontHeight(nf)) / 2;
                if (b.mine) {
                    int nw = Canvas.MeasureText(b.name, nf);
                    c.DrawText(bx0 + b.bw - nw, ny, b.name, nameBox.FgOr(0), nf);
                } else {
                    c.DrawText(bx0, ny, b.name, nameBox.FgOr(0), nf);
                }
            }
            int fill = mineBox.BgOr(0);
            int fg = mineBox.FgOr(0);
            if (b.waiting) {
                fill = waitBox.BgOr(0);
                fg = waitBox.FgOr(0);
            } else if (!b.mine) {
                fill = otherBox.BgOr(0);
                fg = otherBox.FgOr(0);
            }
            c.FillRoundRectIn(bx0, ry, b.bw, b.bh, radius, mask, fill);
            // 尾巴：贴在侧缘（外角下方 tailDrop 处）的一枚四分之一圆，
            // 直边与气泡的边缘重合，并起来就是带小鼓包的完整气泡。
            if (b.waiting || !b.mine) {
                c.FillSector(bx0, ry + tailDrop, 0, tailW, 180, 270, fill);
            } else {
                c.FillSector(bx0 + b.bw, ry + tailDrop, 0, tailW, 90, 180, fill);
            }
            if (b.imgW > 0) {
                c.BlitImage(b.imgPath, bx0 + padX, ry + padY, b.imgW, b.imgH,
                    0, 0, 0, 0);
            } else {
                int ty = ry + padY;
                for (int li = 0; li < b.lines.Count; li = li + 1) {
                    c.DrawText(bx0 + padX, ty, b.lines[li], fg, fontPx);
                    ty = ty + lineH;
                }
            }
            if (!b.waiting) {
                Avatar av = ChatView.BubbleAvatar();
                av.Text = b.initial;
                av.Size = 34;
                av.Class = b.avaCls;
                int d = av.Diameter(app);
                int ay = ry;
                if (d > avaD) { d = avaD; }
                av.RenderAt(app, avaX, ay, d);
            }
        }
        c.PopClip();
        // 滚动条：它说的是「从顶算的像素」，这里换一下再把拖动结果写回
        // 调用方的「从底算」信号。
        if (over > 0) {
            int barW = app.Scale(10);
            SignalInt px = ChatView.BubbleBarSig();
            px.Set(over - bscr.Get());
            Scrollbar.RenderVerticalScrollIn(app, bx + bw - barW, by + padV,
                viewH, viewH, bubH, px, bx, by, bw, bh);
            int top = px.Get();
            int want = over - top;
            if (want < 0) { want = 0; }
            if (want > over) { want = over; }
            if (want != bscr.Get()) { bscr.Set(want); app.RequestRedraw(); }
        }
    }

    /// 滚动条要的是「像素、从顶算」，气泡滚动是「像素、从底算」；
    /// 常驻一个转换信号，免得每帧新分配。
    static SignalInt bubbleBar;
    static SignalInt BubbleBarSig() {
        if (ChatView.bubbleBar == null) {
            ChatView.bubbleBar = new SignalInt(0);
        }
        return ChatView.bubbleBar;
    }

    /// 气泡头像复用同一实例：每个可见气泡都要一枚，每帧每气泡新分配
    /// 一个控件正是长会话卡顿的来源（与 StyledText 的头行头像同理）。
    static Avatar bubbleAva;
    static Avatar BubbleAvatar() {
        if (ChatView.bubbleAva == null) {
            ChatView.bubbleAva = new Avatar();
        }
        return ChatView.bubbleAva;
    }

    /// `cache` 中选中的文本（换行拼接，未选中则 ""）。
    static string SelectionText(List<TextRun> rows, LogState st) {
        if (!st.HasSelection()) { return ""; }
        int r0 = st.selR0; int c0 = st.selC0;
        int r1 = st.selR1; int c1 = st.selC1;
        if (r0 > r1 || (r0 == r1 && c0 > c1)) {
            int tr = r0; r0 = r1; r1 = tr;
            int tc = c0; c0 = c1; c1 = tc;
        }
        string outp = "";
        for (int r = r0; r <= r1 && r < rows.Count; r = r + 1) {
            string ln = rows[r].text;
            int s = 0;
            int e = ln.Length;
            if (r == r0) { s = c0; }
            if (r == r1) { e = c1; }
            if (s < 0) { s = 0; }
            if (e > ln.Length) { e = ln.Length; }
            if (s > e) { s = e; }
            outp = outp + ln.Substring(s, e - s);
            if (r < r1) { outp = outp + "\n"; }
        }
        return outp;
    }
}
