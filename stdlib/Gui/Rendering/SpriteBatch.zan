using System;
using Gui.Backend;

namespace Gui;

/// <summary>
/// 打包精灵批（A356 P0）：把一层的全部精灵四边形装进一块预分配的
/// NativeMemory 缓冲，跨帧复用——热路径零分配，整层一次 FFI 提交
/// （<see cref="Canvas.DrawSprites"/>）。GPU 路径并入 zan_gui 的顶点批
/// （贴图四边形不再逐个落 CPU 光栅）；CPU 兜底逐个 blit。
///
/// 每精灵 10 个 float：dx,dy,dw,dh, sx,sy,sw,sh, tint(0xAABBGGRR，
/// -1=不染色)，保留位。源 w/h&lt;=0 取整图。坐标单位=画布像素，
/// 源坐标单位=图源像素。
/// </summary>
class SpriteBatch {
    nint buf;
    int capSprites;
    int count;

    SpriteBatch() {
        this.buf = 0;
        this.capSprites = 0;
        this.count = 0;
    }

    /// <summary>分配可容纳 capSprites 个精灵的批缓冲。</summary>
    public static SpriteBatch Create(int capSprites) {
        if (capSprites <= 0) { return null; }
        SpriteBatch sb = new SpriteBatch();
        sb.buf = NativeMemory.Alloc(capSprites * 40);
        sb.capSprites = capSprites;
        sb.count = 0;
        return sb;
    }

    /// <summary>清空批（不释放缓冲），开始装新一层。</summary>
    public void Begin() {
        this.count = 0;
    }

    /// <summary>本批已装填的精灵数。</summary>
    public int Count() {
        return this.count;
    }

    /// <summary>装一个精灵。缓冲满时静默丢弃（容量在 Create 时定）。</summary>
    public void Add(float dx, float dy, float dw, float dh,
                    float sx, float sy, float sw, float sh, int tint) {
        if (this.count >= this.capSprites) { return; }
        nint p = this.buf + this.count * 40;
        new Span<float>(p, 8)[0] = dx;
        new Span<float>(p, 8)[1] = dy;
        new Span<float>(p, 8)[2] = dw;
        new Span<float>(p, 8)[3] = dh;
        new Span<float>(p, 8)[4] = sx;
        new Span<float>(p, 8)[5] = sy;
        new Span<float>(p, 8)[6] = sw;
        new Span<float>(p, 8)[7] = sh;
        new Span<int>(p + 32, 1)[0] = tint;
        this.count = this.count + 1;
    }

    /// <summary>整层一次提交到画布。handle 来自 Canvas.SpriteHandle。</summary>
    public void Draw(Canvas c, int handle) {
        if (this.count > 0) {
            c.DrawSprites(handle, this.buf, this.count);
        }
    }

    /// <summary>释放底层缓冲。此后本对象不可再用。</summary>
    public void Dispose() {
        if (this.buf != 0) {
            NativeMemory.Free(this.buf);
            this.buf = 0;
        }
        this.capSprites = 0;
        this.count = 0;
    }
}
