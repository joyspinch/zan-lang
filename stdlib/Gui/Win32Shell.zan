using System;

namespace Gui;

#if WINDOWS

/// Win32 window procedure, implemented in Zan and handed to RegisterClassExW.
delegate nint ZanWndProc(nint hwnd, int msg, nint wp, nint lp);

/// SetWindowCompositionAttribute (undocumented user32 entry, resolved lazily).
delegate int SetWinCompAttrFn(nint hwnd, nint data);
/// SetProcessDpiAwareness (Shcore) / SetProcessDPIAware (user32) fallbacks.
delegate int SetProcessDpiAwarenessFn(int level);
delegate int SetProcessDpiAwareFn();

/// <summary>
/// The Windows window shell -- class registration, the window procedure, the
/// event queue, DIB presentation, acrylic glass, IME placement, the clipboard
/// and the automation injection queue -- written in Zan against user32/gdi32
/// instead of a C runtime file. Pixels still come from the rasterizer surface
/// (Canvas), which hands over its buffer through zan_gui_get_pixels.
///
/// Everything the widget layer sees goes through Gui.Window, so this class is
/// the Windows half of that abstraction and mirrors, one for one, the flat
/// exports the other platforms' backends provide.
/// </summary>
class Win32Shell {
