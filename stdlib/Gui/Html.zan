using System;
using System.Web;
// 控件映射用的是裸 Button/TextArea/Checkbox/Input/Image——这些类型在
// Gui.Widget 命名空间里，必须显式 import；不写的话只靠 binder 的全局
// 唯一简单名兜底才能编过，一旦用户项目定义了同名全局类（如 class
// TextArea）这里就会炸。同 A314。
using Gui.Widget;

namespace Gui;

/// WEB_GUI_ROADMAP P5：HTML 声明层的 Gui 侧——把 System.Web.HtmlParser
/// 的声明记录构建成控件树。解析/空白/实体/记录全在纯层（生成器
/// GenHtml 也吃同一份记录，运行时与编译期同构）；本文件只负责
/// tag→控件映射与属性协议（事件接线、绑定路径、样式类）。
///
/// tag 映射：容器 tag → Element（UA 样式表给 web 缺省语义），
/// button → Button、input → Input/Checkbox、textarea → TextArea、
/// img → Image；select 等未映射 tag 落 Element 占位。
///
/// 属性协议：id → 选择器名（nodeName），class → AddClass，
/// style → 合成 .zgen-N 规则（复用整套级联与 !important 机制），
/// data-on-<evt>="名" 经 HtmlHandlers 注册表接 BindEvent，
/// data-bind → bindPath，data-if → bindIf。其余属性（Element 进
/// 原始属性表；真控件忽略）。

/// 解析产物：body 根 + 收集的样式。root 恒为 body 元素——片段没有
/// body 标签时包一层隐式 body（对齐 Chrome 的文档语义）。
class HtmlDoc {
    Control root;
    string css;
    int gen;        // style 属性合成类的计数器（zgen-N）
}

/// data-on-* 的处理器注册表：`handlers.Add("submit", () => ...)`，
/// HTML 里 `data-on-click="submit"` 命中同名条目即接线。带参变体
/// `AddArg("row", a => ...)` 配 `data-arg` 使用（见 Html.WireArg）。
class HtmlHandlers {
    Dict<string, Action> map;
    Dict<string, Action<string>> argMap;

    void Add(string name, Action a) {
        if (this.map == null) { this.map = new Dict<string, Action>(); }
        this.map.Add(name, a);
    }

    /// 注册带参处理器：同名文档节点写了 `data-arg="x"`，触发时
    /// 收到 "x"。
    void AddArg(string name, Action<string> a) {
        if (this.argMap == null) {
            this.argMap = new Dict<string, Action<string>>();
        }
        this.argMap.Add(name, a);
    }

    /// 未注册的名字返回 null（静默不接线——HTML 是声明，事件在
    /// 宿主语言里，名字打错表现为按钮没反应而非崩溃）。
    Action Find(string name) {
        if (this.map == null) { return null; }
        Action a = null;
        if (this.map.TryGetValue(name, out a)) { return a; }
        return null;
    }

    /// 带参槽查找，未注册返回 null。
    Action<string> FindArg(string name) {
        if (this.argMap == null) { return null; }
        Action<string> a = null;
        if (this.argMap.TryGetValue(name, out a)) { return a; }
        return null;
    }
}

class Html {
    /// 解析 `html`（整文档或片段）并建树。`baseDir` 是 `<link>`
    /// 相对路径的基目录（空 = 不解析 link）。`handlers` 可为 null。
    static HtmlDoc Parse(string html, string baseDir, HtmlHandlers handlers) {
        WDoc wd = HtmlParser.Parse(html, baseDir);
        HtmlDoc doc = new HtmlDoc();
        doc.css = wd.css;
        doc.gen = 0;
        List<Control> built = new List<Control>();
        for (int i = 0; i < wd.nodes.Count; i = i + 1) {
            built.Add(Html.Build(wd.nodes[i], doc, handlers));
        }
        // 装配：逐父按 items 文档序走一遍——AddText 与 AddChild 的
        // 交错顺序就是 HTML 的行内内容顺序（混排行盒依赖）。
        for (int i = 0; i < wd.nodes.Count; i = i + 1) {
            WNode n = wd.nodes[i];
            Control c = built[i];
            for (int k = 0; k < n.items.Count; k = k + 1) {
                WItem it = n.items[k];
                if (it.kid < 0) {
                    // 真控件下的游离文本无处安放（映射控件的文本走
                    // 自己的协议——button 吃捕获文本）
                    if (c is Element) { ((Element)c).AddText(it.text); }
                } else {
                    Html.AddChild(c, built[it.kid]);
                }
            }
        }
        doc.root = built.Count > 0 ? built[0] : null;
        return doc;
    }

    /// 一条记录 → 一个控件（构造 + 属性协议）。容器自己的文本不在这
    /// 里加——装配阶段按 items 文档序与子控件交错加入。
    static Control Build(WNode n, HtmlDoc doc, HtmlHandlers handlers) {
        string tag = n.tag;
        string id = HtmlText.Attr(n.attrNames, n.attrVals, "id");
        string type = HtmlText.Attr(n.attrNames, n.attrVals,
                                    "type").ToLower();
        Control c = null;
        if (tag == "button") {
            Button b = new Button();
            b.InitButton(n.text);
            c = b;
        } else if (tag == "textarea") {
            TextArea ta = new TextArea();
            ta.InitTextArea(new SignalString(n.text), "");
            c = ta;
        } else if (tag == "input" && type == "checkbox") {
            Checkbox cb = new Checkbox();
            cb.InitCheckbox("", new SignalBool(false));
            c = cb;
        } else if (tag == "input") {
            Input inp = new Input();
            inp.InitInput(
                new SignalString(HtmlText.Attr(n.attrNames, n.attrVals,
                                               "value")),
                HtmlText.Attr(n.attrNames, n.attrVals, "placeholder"));
            c = inp;
        } else if (tag == "img") {
            Image img = new Image();
            img.InitImage(HtmlText.Attr(n.attrNames, n.attrVals, "src"),
                          HtmlText.Attr(n.attrNames, n.attrVals, "alt"),
                          "cover");
            c = img;
        } else {
            Element el = new Element();
            el.InitElement(tag, id);
            // 真实属性表：全部原始属性进表（class/style/data-* 与
            // 构造消费的 id/src 等都存原文），CSS 属性选择器与
            // content:attr() 的取值源。布尔属性值为空串也照存——
            // 存在性走 CssHasAttr，不看值。
            for (int i = 0; i < n.attrNames.Count; i = i + 1) {
                el.SetAttr(n.attrNames[i], n.attrVals[i]);
            }
            c = el;
        }
        // 真控件的 id 不进 nodeName（那是 Element 的），走选择器名
        if (id != "" && !(c is Element)) { c.SetProp("name", id); }
        // data-arg 预扫：属性顺序不保证（data-arg 可写在 data-on-*
        // 之后），先取出来供本节点全部事件共用；同时落 handlerArg
        // 字段，ChildWindow.WireNode 的二次接线同源。
        string darg = HtmlText.Attr(n.attrNames, n.attrVals, "data-arg");
        if (darg != "") { c.handlerArg = darg; }
        // 属性协议（与 GenHtml 生成的建树代码同一套语义）
        for (int i = 0; i < n.attrNames.Count; i = i + 1) {
            string k = n.attrNames[i];
            string v = n.attrVals[i];
            if (k == "id" || k == "type" || k == "value"
                || k == "placeholder" || k == "src" || k == "alt") {
                continue;   // 构造时已用
            }
            if (k == "class") {
                List<string> cs = HtmlText.SplitClass(v);
                for (int j = 0; j < cs.Count; j = j + 1) {
                    c.AddClass(cs[j]);
                }
                continue;
            }
            if (k == "style") {
                // 行内样式合成专属类规则，复用整套级联/!important 机制
                string gen = "zgen-" + Convert.ToString(doc.gen);
                doc.gen = doc.gen + 1;
                c.AddClass(gen);
                doc.css = doc.css + "." + gen + " { " + v + " }\n";
                continue;
            }
            if (k == "data-bind") {
                c.bindPath = v;
                continue;
            }
            if (k == "data-if") {
                c.bindIf = v;
                continue;
            }
            if (k.Length > 8 && HtmlText.StartsWith(k, "data-on-")) {
                string suffix = k.Substring(8, k.Length - 8);
                string evt = HtmlText.EventKind(suffix);
                if (evt != "") {
                    // Wire/WireArg 负责落名（SetHandler）+ 接线，见上。
                    if (darg != "") {
                        Html.WireArg(handlers, c, evt, v, darg);
                    } else {
                        Html.Wire(handlers, c, evt, v);
                    }
                }
                continue;
            }
            // 其余属性（href/title/disabled/...）忽略（台账）
        }
        return c;
    }

    /// 挂子节点：Element 父走 AddKid（与 AddText 的文档序交错，
    /// 行盒混排依赖），控件父走普通 Add。
    static void AddChild(Control parent, Control c) {
        if (parent is Element) {
            ((Element)parent).AddKid(c);
            return;
        }
        parent.Add(c);
    }

    /// 深拷贝一棵控件树（`<template data-for>` 行展开用）。Element
    /// 走同构克隆——Props() 没有覆写、Serialize 无法往返，标签/文本/
    /// 原始属性表必须特判搬运；Class 原样带上（行内 style 的 zgen-N
    /// 规则已在应用样式表里，克隆件挂同名类即生效）。其余控件按注册
    /// kind 重建（未注册返回 null，调用侧跳过不占位），Props 声明槽
    /// 与事件名照搬；几何与绑定声明逐项复制，子树递归。
    static Control Clone(Control c) {
        if (c is Element) {
            Element src = (Element)c;
            Element el = new Element();
            el.InitElement(src.Kind(), src.name);
            el.CopyAttrsFrom(src);
            el.SetText(src.Text());
            el.Class = src.Class;
            el.dock = src.dock;
            el.padL = src.padL;
            el.padT = src.padT;
            el.padR = src.padR;
            el.padB = src.padB;
            el.gap = src.gap;
            el.mx = src.mx;
            el.my = src.my;
            el.prefW = src.prefW;
            el.prefH = src.prefH;
            el.logW = src.logW;
            el.logH = src.logH;
            el.logX = src.logX;
            el.logY = src.logY;
            el.logGap = src.logGap;
            el.logPad = src.logPad;
            el.logPlaceSet = src.logPlaceSet;
            el.bindPath = src.bindPath;
            el.bindProp = src.bindProp;
            el.bindIf = src.bindIf;
            el.handlerArg = src.handlerArg;
            for (int ei = 0; ei < src.events.Count; ei = ei + 1) {
                el.SetHandler(src.events[ei].key, src.events[ei].val);
            }
            // 文档序重放（AddText/AddKid 交错是行盒混排的依据）
            if (src.elOrder != null) {
                for (int i = 0; i < src.elOrder.Count; i = i + 1) {
                    FlowEntry o = src.elOrder[i];
                    if (o.kid != null) {
                        Control kid = Html.Clone(o.kid);
                        if (kid != null) { el.AddKid(kid); }
                    } else {
                        el.AddText(o.text);
                    }
                }
            } else {
                List<Control> kids = src.children;
                for (int i = 0; i < kids.Count; i = i + 1) {
                    Control kid = Html.Clone(kids[i]);
                    if (kid != null) { el.AddKid(kid); }
                }
            }
            return el;
        }
        Control n = ControlFactory.Create(c.Kind());
        if (n == null) { return null; }
        n.name = c.name;
        n.Class = c.Class;
        n.dock = c.dock;
        n.padL = c.padL;
        n.padT = c.padT;
        n.padR = c.padR;
        n.padB = c.padB;
        n.gap = c.gap;
        n.mx = c.mx;
        n.my = c.my;
        n.prefW = c.prefW;
        n.prefH = c.prefH;
        n.logW = c.logW;
        n.logH = c.logH;
        n.logX = c.logX;
        n.logY = c.logY;
        n.logGap = c.logGap;
        n.logPad = c.logPad;
        n.logPlaceSet = c.logPlaceSet;
        n.bindPath = c.bindPath;
        n.bindProp = c.bindProp;
        n.bindIf = c.bindIf;
        n.handlerArg = c.handlerArg;
        List<PropSpec> ps = c.Props();
        for (int i = 0; i < ps.Count; i = i + 1) {
            n.SetProp(ps[i].key, c.GetProp(ps[i].key));
        }
        for (int ei = 0; ei < c.events.Count; ei = ei + 1) {
            n.SetHandler(c.events[ei].key, c.events[ei].val);
        }
        for (int i = 0; i < c.children.Count; i = i + 1) {
            Control kid = Html.Clone(c.children[i]);
            if (kid != null) { n.Add(kid); }
        }
        return n;
    }

    /// data-on-* 接线的公开钩子：生成的/手写的建树代码统一走这里，
    /// 由它消化"名字 → 注册表 Action → BindEvent"与 Button 等控件
    /// 把事件路由到专属槽位的差异（BindEvent 多态分派）。名字无论
    /// 有没有注册表都落控件（SetHandler）——与 GenForm 生成的建树
    /// 代码同一契约，ChildWindow.Wire 等宿主才能二次解析。
    static void Wire(HtmlHandlers handlers, Control c, string evt,
                     string name) {
        if (evt == "") { return; }
        c.SetHandler(evt, name);
        if (handlers == null) { return; }
        Action a = handlers.Find(name);
        if (a != null) { c.BindEvent(evt, a); }
    }

    /// 带参接线（`data-arg`）：按名查带参槽，把实参闭包进无参
    /// Action 再 BindEvent（实参是只读捕获的局部——创建时值快照，
    /// 语义即"这个控件永远带着它的参数"）。名字照落控件；带参槽
    /// 未命中时静默不接（与 Wire 同一契约）。
    static void WireArg(HtmlHandlers handlers, Control c, string evt,
                        string name, string arg) {
        if (evt == "") { return; }
        c.SetHandler(evt, name);
        if (handlers == null) { return; }
        Action<string> a = handlers.FindArg(name);
        if (a == null) { return; }
        string captured = arg;
        c.BindEvent(evt, () => { a(captured); });
    }
}
