using System;
using System.IO;
using System.Diagnostics;

namespace Gui;

/// <summary>界面层的错误记录。一帧里抛出的异常不应该结束进程，
/// 但也不能无声消失：异常记录在这里，落到 exe 旁边的
/// <c>zan_ui_errors.log</c>（硬崩溃另有原生的 <c>zan_crash.log</c>），
/// 并留在内存环里，供「帮助与反馈」面板直接读取，
/// 不必去翻文件。</summary>
class UiErrorLog {
    /// 内存里保留的最近条数（面板显示用）。
    static int keep = 100;
    static List<string> recent;
    static int total;
    /// 上一条记录的正文与它连续重复的次数：一次坏帧通常每帧
    /// 重复一次，逐条写盘会在几秒内塞满日志。
    static string lastBody = "";
    static int repeats;

    /// <summary>记录一条界面错误，返回本进程累计的条数。
    /// <paramref name="origin"/> 是发生位置（如 "frame"、"event"）。</summary>
    static int Record(string origin, string message) {
        if (recent == null) { recent = new List<string>(); }
        string body = origin + ": " + message;
        total = total + 1;
        if (body == lastBody) {
            repeats = repeats + 1;
            // 同一条错误：只在 1、2、4、8… 次时落盘，避免刷爆日志。
            if ((repeats & (repeats - 1)) != 0) { return total; }
            body = body + " (x" + Convert.ToString(repeats + 1) + ")";
        } else {
            lastBody = body;
            repeats = 0;
        }
        string line = DateTime.Now().ToString() + " " + body;
        recent.Add(line);
        while (recent.Count > keep) { recent.RemoveAt(0); }
        UiErrorLog.Append(line);
        return total;
    }

    /// <summary>本进程记录过的错误条数。</summary>
    static int Count() { return total; }

    /// <summary>最近的错误行（最旧在前）。</summary>
    static List<string> Recent() {
        if (recent == null) { recent = new List<string>(); }
        return recent;
    }

    /// <summary>日志文件路径（与可执行文件同目录）。</summary>
    static string LogPath() {
        string exe = ProcessList.ExePath(ProcessList.SelfPid());
        string dir = Path.GetDirectoryName(exe);
        if (dir == "") { return "zan_ui_errors.log"; }
        return Path.Combine(dir, "zan_ui_errors.log");
    }

    /// <summary>清空内存里的记录（不删日志文件）。</summary>
    static void Clear() {
        if (recent != null) { recent.Clear(); }
        lastBody = "";
        repeats = 0;
    }

    /// 写盘失败（只读目录、磁盘满）不能反过来把进程弄崩：
    /// 内存里的记录仍然可用。
    static void Append(string line) {
        try {
            File.AppendAllText(UiErrorLog.LogPath(), line + "\n");
        } catch (Exception ex) {
            // 无处可报；忽略。
        }
    }
}
