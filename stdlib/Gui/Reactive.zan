using System;

namespace Gui;

/// Vue 风格的响应式数据绑定。
/// Signal：可变的响应式值。Set 触发版本号递增。
/// 双向绑定：控件读 signal.Get()，写 signal.Set(v)。
class SignalInt {
    int val;
    int version;
    /// 值实际变化时由 Set 触发。每个绑定到
    /// signal 的控件（页码、选中的标签、打开的面板、滑块值……）都会
    /// 从这里收到变更事件，因此变更通知无需
    /// 逐个控件地添加。Set 存入相同值时不触发。
    UiEvent Changed;

    SignalInt(int initial) {
        this.val = initial;
        this.version = 0;
        this.Changed = new UiEvent();
    }

    int Get() { return val; }

    void Set(int v) {
        bool moved = (val != v);
        val = v;
        version = version + 1;
        if (moved && Changed != null) { Changed.Raise(); }
    }

    int Version() { return version; }
}

class SignalBool {
    bool val;
    int version;
    /// 值实际变化时由 Set / Toggle 触发。
    UiEvent Changed;

    SignalBool(bool initial) {
        this.val = initial;
        this.version = 0;
        this.Changed = new UiEvent();
    }

    bool Get() { return val; }

    void Set(bool v) {
        bool moved = (val != v);
        val = v;
        version = version + 1;
        if (moved && Changed != null) { Changed.Raise(); }
    }

    void Toggle() {
        val = !val;
        version = version + 1;
        if (Changed != null) { Changed.Raise(); }
    }

    int Version() { return version; }
}

class SignalString {
    string val;
    int version;
    /// 文本实际变化时由 Set 触发。
    UiEvent Changed;

    SignalString(string initial) {
        this.val = initial;
        this.version = 0;
        this.Changed = new UiEvent();
    }

    string Get() { return val; }

    void Set(string v) {
        bool moved = (val != v);
        val = v;
        version = version + 1;
        if (moved && Changed != null) { Changed.Raise(); }
    }

    int Version() { return version; }
}

/// 跟踪多个 signal 的版本号以检测变化。
class ChangeTracker {
    int lastVersion;

    ChangeTracker() {
        this.lastVersion = -1;
    }

    bool Changed(int currentVersion) {
        if (currentVersion != lastVersion) {
            lastVersion = currentVersion;
            return true;
        }
        return false;
    }
}
