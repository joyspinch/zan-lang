using System;

namespace Gui;

/// Vue-style reactive data binding.
/// Signal: mutable reactive value. Set triggers version bump.
/// Two-way binding: widget reads signal.Get(), writes signal.Set(v).
class SignalInt {
    int val;
    int version;
    /// Raised by Set when the value actually changes. Every widget bound to a
    /// signal (page index, selected tab, open panel, slider value, ...) gets a
    /// change event from here, so a change notification never has to be added
    /// widget by widget. Not raised when Set stores the same value.
    UiEvent Changed;

    SignalInt(int initial) {
        this.val = initial;
        this.version = 0;
        this.Changed = new UiEvent();
    }

    int Get() { return val; }

    void Set(int v) {
        bool moved = (val != v);
        val = v;
        version = version + 1;
        if (moved && Changed != null) { Changed.Raise(); }
    }

    int Version() { return version; }
}

class SignalBool {
    bool val;
    int version;
    /// Raised by Set / Toggle when the value actually changes.
    UiEvent Changed;

    SignalBool(bool initial) {
        this.val = initial;
        this.version = 0;
        this.Changed = new UiEvent();
    }

    bool Get() { return val; }

    void Set(bool v) {
        bool moved = (val != v);
        val = v;
        version = version + 1;
        if (moved && Changed != null) { Changed.Raise(); }
    }

    void Toggle() {
        val = !val;
        version = version + 1;
        if (Changed != null) { Changed.Raise(); }
    }

    int Version() { return version; }
}

class SignalString {
    string val;
    int version;
    /// Raised by Set when the text actually changes.
    UiEvent Changed;

    SignalString(string initial) {
        this.val = initial;
        this.version = 0;
        this.Changed = new UiEvent();
    }

    string Get() { return val; }

    void Set(string v) {
        bool moved = (val != v);
        val = v;
        version = version + 1;
        if (moved && Changed != null) { Changed.Raise(); }
    }

    int Version() { return version; }
}

/// Tracks version numbers of multiple signals to detect changes.
class ChangeTracker {
    int lastVersion;

    ChangeTracker() {
        this.lastVersion = -1;
    }

    bool Changed(int currentVersion) {
        if (currentVersion != lastVersion) {
            lastVersion = currentVersion;
            return true;
        }
        return false;
    }
}
