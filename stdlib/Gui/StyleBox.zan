using System;

namespace Gui;

/// <summary>
/// 已解析的视觉样式：主题默认值加上皮肤样式表中
/// 匹配某个控件某个状态的声明，展平后的结果。
///
/// 这是 GUI 唯一知道如何 *paint* 一个带样式 box 的地方，
/// 控件无需再携带按皮肤分叉的绘制代码，它只解析一次
/// 然后绘制：
///
///     StyleBox s = Style.Eased(app, id, "button", "primary", disabled);
///     s.Paint(app, x, y, w, h);
///     s.DrawLabel(app, x, y, w, h, "Save");
///
/// 每个字段都是 int（GUI 栈不使用浮点）。`0` 表示颜色"未设置"，
/// `-1` 表示度量未设置，因此声明可以把任何一项留给主题默认值；
/// 通过接收回退值的 `*Or` 访问器读取它们。
/// </summary>
class StyleBox {
    // ---- fill ---------------------------------------------------------------
    int bg;          // 背景色（0 = 无）
    int bgTo;        // 渐变终点色（0 = 纯色）
    int bgVia;       // 可选的中间渐变断点（0 = 无）
    int bgDir;       // 0 向下，1 向右，2 右下，3 向上
    int opacity;     // 0..1000 千分比，乘到每个绘制的 alpha 上
    int blur;        // backdrop-filter 模糊半径（px，0 = 关闭）

    // ---- text ---------------------------------------------------------------
    int fg;          // 文字/图标颜色
    int accent;      // 指示符的强调色（下划线、光标、标记）
    int fontPx;
    int fontWeight;  // 0 未设置，400 常规，700 加粗（模拟双重绘制）
    int lineHeight;
    int letterSpacing;
    int align;       // -1 未设置，0 左，1 居中，2 右
    int valign;      // -1 未设置，0 顶，1 居中，2 底
    int textCase;    // 0 无，1 大写，2 小写
    int ellipsis;    // 1 = text-overflow: ellipsis
    int nowrap;      // 1 = white-space: nowrap

    // ---- border / corners ---------------------------------------------------
    int borderColor;
    int borderW;
    int borderTopW;    int borderTopColor;
    int borderRightW;  int borderRightColor;
    int borderBottomW; int borderBottomColor;
    int borderLeftW;   int borderLeftColor;
    int radius;
    int radiusTL; int radiusTR; int radiusBR; int radiusBL;

    // ---- shadow -------------------------------------------------------------
    int shadow;      // 颜色（0 = 无）
    int shadowDx;
    int shadowDy;
    int shadowBlur;
    int shadowInset; // 1 = 内阴影

    // ---- decoration ---------------------------------------------------------
    // 皮肤按名称请求的外观，绘制 box 的每个控件都会应用
    // （`border-style: dashed`、`-zan-emboss: raised|inset`、`-zan-specular: 1`），
    // 因此没有控件需要自带的按变体绘制代码。
    int borderStyle; // 0 实线，1 虚线
    int emboss;      // 0 无，1 凸起，2 凹陷（新拟态）
    int specular;    // 1 = 边框上跟随光标的高光
    int fxId;        // 高光跟踪悬停所用的控件 id（0 = 无）

    // ---- box metrics --------------------------------------------------------
    int padL; int padT; int padR; int padB;
    int marL; int marT; int marR; int marB;
    int width; int height;
    int minW; int minH; int maxW; int maxH;
    /// 上述六种度量的百分比形式，以包含块内容框的
    /// 千分比表示（-1 未设置）。`width: 34%` 设置 widthPm = 340，布局
    /// 再针对父级给出的空间解析它。
    int widthPm; int heightPm;
    int minWPm; int minHPm; int maxWPm; int maxHPm;
    int gap;

    // ---- layout -------------------------------------------------------------
    int display;     // 0 block，1 flex，2 none
    int flexDir;     // 0 row，1 column
    int justify;     // 0 start，1 center，2 end，3 space-between，4 space-around
    int alignItems;  // 0 stretch，1 start，2 center，3 end
    int wrap;        // 1 = flex-wrap: wrap
    int grow;
    int order;
    int position;    // 0 static，1 relative，2 absolute
    int posT; int posR; int posB; int posL;
    int overflow;    // 1 = hidden（裁剪子项）
    int zIndex;
    int cursor;      // Cursor.* 代码，0 = 默认
    int visible;     // 0 = visibility: hidden

    // ---- motion -------------------------------------------------------------
    int transitionMs;
    int easing;      // 0 ease，1 linear，2 ease-in，3 ease-out，4 ease-in-out
    int anim;        // Style.Anim* 种类（0 无）
    int animMs;
    int tx; int ty;  // transform: translate()
    int scale;       // transform: scale()，千分比（1000 = 1x）
    int rotate;      // transform: rotate()，角度

    static int Unset() { return 0 - 1; }

    /// 空 box：什么都不设置，所有访问器都返回其回退值。
    StyleBox() {
        this.bg = 0; this.bgTo = 0; this.bgVia = 0; this.bgDir = 0;
        this.opacity = 1000; this.blur = 0;
        this.fg = 0; this.accent = 0;
        this.fontPx = 0; this.fontWeight = 0; this.lineHeight = 0; this.letterSpacing = 0;
        this.align = 0 - 1; this.valign = 0 - 1; this.textCase = 0;
        this.ellipsis = 0; this.nowrap = 0;
        this.borderColor = 0; this.borderW = 0 - 1;
        this.borderTopW = 0 - 1;    this.borderTopColor = 0;
        this.borderRightW = 0 - 1;  this.borderRightColor = 0;
        this.borderBottomW = 0 - 1; this.borderBottomColor = 0;
        this.borderLeftW = 0 - 1;   this.borderLeftColor = 0;
        this.radius = 0 - 1;
        this.radiusTL = 0 - 1; this.radiusTR = 0 - 1; this.radiusBR = 0 - 1; this.radiusBL = 0 - 1;
        this.shadow = 0; this.shadowDx = 0; this.shadowDy = 0; this.shadowBlur = 0; this.shadowInset = 0;
        this.borderStyle = 0; this.emboss = 0; this.specular = 0; this.fxId = 0;
        this.padL = 0 - 1; this.padT = 0 - 1; this.padR = 0 - 1; this.padB = 0 - 1;
        this.marL = 0; this.marT = 0; this.marR = 0; this.marB = 0;
        this.width = 0 - 1; this.height = 0 - 1;
        this.minW = 0 - 1; this.minH = 0 - 1; this.maxW = 0 - 1; this.maxH = 0 - 1;
        this.widthPm = 0 - 1; this.heightPm = 0 - 1;
        this.minWPm = 0 - 1; this.minHPm = 0 - 1; this.maxWPm = 0 - 1; this.maxHPm = 0 - 1;
        this.gap = 0 - 1;
        this.display = 0; this.flexDir = 0; this.justify = 0; this.alignItems = 0;
        this.wrap = 0; this.grow = 0; this.order = 0;
        this.position = 0;
        this.posT = StyleBox.Unset(); this.posR = StyleBox.Unset();
        this.posB = StyleBox.Unset(); this.posL = StyleBox.Unset();
        this.overflow = 0; this.zIndex = 0; this.cursor = 0; this.visible = 1;
        this.transitionMs = 0 - 1; this.easing = 0;
        this.anim = 0; this.animMs = 0;
        this.tx = 0; this.ty = 0; this.scale = 1000; this.rotate = 0;
    }

    /// 逐字段复制（解析缓存发放副本，以便控件可以
    /// 微调自己的 box 而不污染缓存）。
    StyleBox Clone() {
        StyleBox d = new StyleBox();
        d.bg = bg; d.bgTo = bgTo; d.bgVia = bgVia; d.bgDir = bgDir;
        d.opacity = opacity; d.blur = blur;
        d.fg = fg; d.accent = accent;
        d.fontPx = fontPx; d.fontWeight = fontWeight;
        d.lineHeight = lineHeight; d.letterSpacing = letterSpacing;
        d.align = align; d.valign = valign; d.textCase = textCase;
        d.ellipsis = ellipsis; d.nowrap = nowrap;
        d.borderColor = borderColor; d.borderW = borderW;
        d.borderTopW = borderTopW;       d.borderTopColor = borderTopColor;
        d.borderRightW = borderRightW;   d.borderRightColor = borderRightColor;
        d.borderBottomW = borderBottomW; d.borderBottomColor = borderBottomColor;
        d.borderLeftW = borderLeftW;     d.borderLeftColor = borderLeftColor;
        d.radius = radius;
        d.radiusTL = radiusTL; d.radiusTR = radiusTR;
        d.radiusBR = radiusBR; d.radiusBL = radiusBL;
        d.shadow = shadow; d.shadowDx = shadowDx; d.shadowDy = shadowDy;
        d.shadowBlur = shadowBlur; d.shadowInset = shadowInset;
        d.borderStyle = borderStyle; d.emboss = emboss;
        d.specular = specular; d.fxId = fxId;
        d.padL = padL; d.padT = padT; d.padR = padR; d.padB = padB;
        d.marL = marL; d.marT = marT; d.marR = marR; d.marB = marB;
        d.width = width; d.height = height;
        d.minW = minW; d.minH = minH; d.maxW = maxW; d.maxH = maxH;
        d.widthPm = widthPm; d.heightPm = heightPm;
        d.minWPm = minWPm; d.minHPm = minHPm; d.maxWPm = maxWPm; d.maxHPm = maxHPm;
        d.gap = gap;
        d.display = display; d.flexDir = flexDir; d.justify = justify;
        d.alignItems = alignItems; d.wrap = wrap; d.grow = grow; d.order = order;
        d.position = position;
        d.posT = posT; d.posR = posR; d.posB = posB; d.posL = posL;
        d.overflow = overflow; d.zIndex = zIndex; d.cursor = cursor;
        d.visible = visible;
        d.transitionMs = transitionMs; d.easing = easing;
        d.anim = anim; d.animMs = animMs;
        d.tx = tx; d.ty = ty; d.scale = scale; d.rotate = rotate;
        return d;
    }

    // ---- fallback accessors -------------------------------------------------

    int BgOr(int fb)      { if (bg != 0) { return bg; } return fb; }
    int FgOr(int fb)      { if (fg != 0) { return fg; } return fb; }
    int AccentOr(int fb)  { if (accent != 0) { return accent; } return fb; }
    int FontOr(int fb)    { if (fontPx > 0) { return fontPx; } return fb; }
    int RadiusOr(int fb)  { if (radius >= 0) { return radius; } return fb; }
    int BorderWOr(int fb) { if (borderW >= 0) { return borderW; } return fb; }
    int BorderOr(int fb)  { if (borderColor != 0) { return borderColor; } return fb; }
    int GapOr(int fb)     { if (gap >= 0) { return gap; } return fb; }
    int HeightOr(int fb)  { if (height >= 0) { return height; } return fb; }
    int WidthOr(int fb)   { if (width >= 0) { return width; } return fb; }

    /// 圆角实际应用的角（Corner.TL|TR|BR|BL）。
    /// 声明自身圆角为 0 的角是直角，所以 `border-radius:
    /// 6 6 0 0`（标签页、焊接组的末尾按钮）会绘制成真正的
    /// 半圆角盒子，而不是四角全圆。
    int Corners() {
        if (radiusTL < 0 && radiusTR < 0 && radiusBR < 0 && radiusBL < 0) {
            return Corner.All();
        }
        int m = 0;
        if (radiusTL != 0) { m = m + Corner.TL(); }
        if (radiusTR != 0) { m = m + Corner.TR(); }
        if (radiusBR != 0) { m = m + Corner.BR(); }
        if (radiusBL != 0) { m = m + Corner.BL(); }
        return m;
    }

    /// 把 `m` 之外的角改为直角，其余角保留圆角。
    void SetCorners(int m) {
        int r = radius;
        if (r < 0) { r = 0; }
        radiusTL = 0; radiusTR = 0; radiusBR = 0; radiusBL = 0;
        if (m / Corner.TL() % 2 == 1) { radiusTL = r; }
        if (m / Corner.TR() % 2 == 1) { radiusTR = r; }
        if (m / Corner.BR() % 2 == 1) { radiusBR = r; }
        if (m / Corner.BL() % 2 == 1) { radiusBL = r; }
    }

    /// 按包含块解析度量：百分比优先，其次
    /// 绝对值声明，最后才是调用方的回退值。
    static int MetricIn(int pm, int abs, int avail, int fb) {
        if (pm >= 0) { return avail * pm / 1000; }
        if (abs >= 0) { return abs; }
        return fb;
    }

    /// 在 `avail` px 的包含块内声明的宽度（样式未声明时用 `fb`），
    /// 所以 `width: 50%` 和 `width: 200px` 都可用。
    int WidthIn(int avail, int fb) {
        return StyleBox.MetricIn(widthPm, width, avail, fb);
    }

    int HeightIn(int avail, int fb) {
        return StyleBox.MetricIn(heightPm, height, avail, fb);
    }

    /// 将 `v` 限制在 min/max-width 内，百分比边界相对
    /// containing block 解析。
    int ClampWIn(int avail, int v) {
        int r = v;
        int lo = StyleBox.MetricIn(minWPm, minW, avail, 0 - 1);
        int hi = StyleBox.MetricIn(maxWPm, maxW, avail, 0 - 1);
        if (lo >= 0 && r < lo) { r = lo; }
        if (hi >= 0 && r > hi) { r = hi; }
        return r;
    }

    int ClampHIn(int avail, int v) {
        int r = v;
        int lo = StyleBox.MetricIn(minHPm, minH, avail, 0 - 1);
        int hi = StyleBox.MetricIn(maxHPm, maxH, avail, 0 - 1);
        if (lo >= 0 && r < lo) { r = lo; }
        if (hi >= 0 && r > hi) { r = hi; }
        return r;
    }
    int TransitionOr(int fb) { if (transitionMs >= 0) { return transitionMs; } return fb; }

    int PadLOr(int fb) { if (padL >= 0) { return padL; } return fb; }
    int PadTOr(int fb) { if (padT >= 0) { return padT; } return fb; }
    int PadROr(int fb) { if (padR >= 0) { return padR; } return fb; }
    int PadBOr(int fb) { if (padB >= 0) { return padB; } return fb; }

    /// 将 `w` 限制在盒子的 min/max-width 内（未设置的边界忽略）。
    int ClampW(int w) {
        int v = w;
        if (minW >= 0 && v < minW) { v = minW; }
        if (maxW >= 0 && v > maxW) { v = maxW; }
        return v;
    }

    int ClampH(int h) {
        int v = h;
        if (minH >= 0 && v < minH) { v = minH; }
        if (maxH >= 0 && v > maxH) { v = maxH; }
        return v;
    }

    /// 一次设置所有 padding 边（`padding: n` 简写用）。
    void SetPad(int v) { padL = v; padT = v; padR = v; padB = v; }

    void SetMargin(int v) { marL = v; marT = v; marR = v; marB = v; }

    /// 一次设置四个圆角半径。
    void SetRadius(int v) {
        radius = v;
        radiusTL = v; radiusTR = v; radiusBR = v; radiusBL = v;
    }

    void SetBorder(int w, int color) {
        borderW = w;
        borderColor = color;
    }

    // ---- 插值 -----

    /// 按千分数 `p` 线性混合两个已解析的盒子——`transition` 如何
    /// 让控件在基础外观与状态外观之间淡入淡出。颜色
    /// 通过 App.LerpColor 混合（一侧未设置时用 ScaleAlpha 保留 alpha），
    /// 度量值插值，flags/枚举在
    /// 中点处切换。
    static StyleBox Blend(StyleBox a, StyleBox b, int p) {
        if (p <= 0) { return a; }
        if (p >= 1000) { return b; }
        StyleBox d = b.Clone();
        d.bg = StyleBox.MixColor(a.bg, b.bg, p);
        d.bgTo = StyleBox.MixColor(a.bgTo, b.bgTo, p);
        d.bgVia = StyleBox.MixColor(a.bgVia, b.bgVia, p);
        d.fg = StyleBox.MixColor(a.fg, b.fg, p);
        d.accent = StyleBox.MixColor(a.accent, b.accent, p);
        d.borderColor = StyleBox.MixColor(a.borderColor, b.borderColor, p);
        d.borderTopColor = StyleBox.MixColor(a.borderTopColor, b.borderTopColor, p);
        d.borderRightColor = StyleBox.MixColor(a.borderRightColor, b.borderRightColor, p);
        d.borderBottomColor = StyleBox.MixColor(a.borderBottomColor, b.borderBottomColor, p);
        d.borderLeftColor = StyleBox.MixColor(a.borderLeftColor, b.borderLeftColor, p);
        d.shadow = StyleBox.MixColor(a.shadow, b.shadow, p);
        d.opacity = App.Lerp(a.opacity, b.opacity, p);
        d.blur = App.Lerp(a.blur, b.blur, p);
        d.borderW = StyleBox.MixMetric(a.borderW, b.borderW, p);
        d.borderTopW = StyleBox.MixMetric(a.borderTopW, b.borderTopW, p);
        d.borderRightW = StyleBox.MixMetric(a.borderRightW, b.borderRightW, p);
        d.borderBottomW = StyleBox.MixMetric(a.borderBottomW, b.borderBottomW, p);
        d.borderLeftW = StyleBox.MixMetric(a.borderLeftW, b.borderLeftW, p);
        d.radius = StyleBox.MixMetric(a.radius, b.radius, p);
        d.radiusTL = StyleBox.MixMetric(a.radiusTL, b.radiusTL, p);
        d.radiusTR = StyleBox.MixMetric(a.radiusTR, b.radiusTR, p);
        d.radiusBR = StyleBox.MixMetric(a.radiusBR, b.radiusBR, p);
        d.radiusBL = StyleBox.MixMetric(a.radiusBL, b.radiusBL, p);
        d.shadowDx = App.Lerp(a.shadowDx, b.shadowDx, p);
        d.shadowDy = App.Lerp(a.shadowDy, b.shadowDy, p);
        d.shadowBlur = App.Lerp(a.shadowBlur, b.shadowBlur, p);
        d.fontPx = StyleBox.MixMetric(a.fontPx, b.fontPx, p);
        d.lineHeight = StyleBox.MixMetric(a.lineHeight, b.lineHeight, p);
        d.letterSpacing = App.Lerp(a.letterSpacing, b.letterSpacing, p);
        d.tx = App.Lerp(a.tx, b.tx, p);
        d.ty = App.Lerp(a.ty, b.ty, p);
        d.scale = App.Lerp(a.scale, b.scale, p);
        d.rotate = App.Lerp(a.rotate, b.rotate, p);
        d.padL = StyleBox.MixMetric(a.padL, b.padL, p);
        d.padT = StyleBox.MixMetric(a.padT, b.padT, p);
        d.padR = StyleBox.MixMetric(a.padR, b.padR, p);
        d.padB = StyleBox.MixMetric(a.padB, b.padB, p);
        d.marL = App.Lerp(a.marL, b.marL, p);
        d.marT = App.Lerp(a.marT, b.marT, p);
        d.marR = App.Lerp(a.marR, b.marR, p);
        d.marB = App.Lerp(a.marB, b.marB, p);
        d.height = StyleBox.MixMetric(a.height, b.height, p);
        d.width = StyleBox.MixMetric(a.width, b.width, p);
        d.minW = StyleBox.MixMetric(a.minW, b.minW, p);
        d.minH = StyleBox.MixMetric(a.minH, b.minH, p);
        d.maxW = StyleBox.MixMetric(a.maxW, b.maxW, p);
        d.maxH = StyleBox.MixMetric(a.maxH, b.maxH, p);
        d.gap = StyleBox.MixMetric(a.gap, b.gap, p);
        return d;
    }

    /// 混合两个颜色，把 0（未设置）视为“淡出另一个颜色”，这样
    /// 只*添加*填充的状态仍会平滑淡入而非突然出现。
    static int MixColor(int c0, int c1, int p) {
        if (c0 == c1) { return c0; }
        if (c0 == 0) { return App.ScaleAlpha(c1, p); }
        if (c1 == 0) { return App.ScaleAlpha(c0, 1000 - p); }
        int rgb = App.LerpColor(c0, c1, p);
        int a0 = StyleBox.AlphaOf(c0);
        int a1 = StyleBox.AlphaOf(c1);
        int a = a0 + (a1 - a0) * p / 1000;
        return App.ScaleAlpha(rgb, a * 1000 / 255);
    }

    /// 插值一个度量值，-1 表示“未设置”（未设置的一侧保留
    /// 另一侧的值，而不是从无效的 -1 过渡）。
    static int MixMetric(int v0, int v1, int p) {
        if (v0 < 0) { return v1; }
        if (v1 < 0) { return v0; }
        return v0 + (v1 - v0) * p / 1000;
    }

    static int AlphaOf(int color) {
        int rgb = color % 16777216;
        if (rgb < 0) { rgb = rgb + 16777216; }
        int a = (color - rgb) / 16777216;
        if (a < 0) { a = a + 256; }
        return a;
    }

    /// 对颜色应用 `opacity`（完全不透明时不做任何事）。
    int Fade(int color) {
        if (color == 0) { return 0; }
        if (opacity >= 1000) { return color; }
        return App.ScaleAlpha(color, opacity);
    }

    // ---- 绘制 -----

    /// 绘制盒子：背景模糊、投影、填充（纯色或渐变）、
    /// 各边边框，然后叠加任意 `animation`。遵循 `transform`
    /// （translate/scale）和 `opacity`；`display: none` / `visibility: hidden` 的
    /// 盒子不绘制任何内容。
    void Paint(App app, int x, int y, int w, int h) {
        if (display == 2 || visible == 0) { return; }
        if (w <= 0 || h <= 0) { return; }
        Canvas c = app.canvas;

        int rx = x + tx;
        int ry = y + ty;
        int rw = w;
        int rh = h;
        if (scale != 1000 && scale > 0) {
            int nw = w * scale / 1000;
            int nh = h * scale / 1000;
            rx = rx + (w - nw) / 2;
            ry = ry + (h - nh) / 2;
            rw = nw;
            rh = nh;
        }
        int r = this.RadiusOr(0);
        // CSS 会把圆角限制为盒子的一半，所以 `border-radius: 999px` 就是
        // 胶囊形状，控件无需自己处理圆角/圆形计算。
        int rmax = rh / 2;
        if (rw < rh) { rmax = rw / 2; }
        if (r > rmax) { r = rmax; }

        if (blur > 0) {
            c.BlurRectCached(rx, ry, rw, rh, app.Scale(blur),
                             app.NextBlurSlot(), app.BackdropDirty());
        }

        if (shadow != 0 && shadowInset == 0) {
            this.PaintShadow(app, rx, ry, rw, rh, r);
        }

        // Neumorphism 效果在填充下方：一对凸起/内陷的柔和边缘。
        if (emboss != 0) {
            Fx.Emboss(app, rx, ry, rw, rh, r, emboss == 2);
        }

        int corners = this.Corners();
        int fill = this.Fade(bg);
        if (bgTo != 0) {
            this.PaintGradient(app, rx, ry, rw, rh, r);
        } else if (fill != 0) {
            if (r > 0) { c.FillRoundRectIn(rx, ry, rw, rh, r, corners, fill); }
            else { c.FillRect(rx, ry, rw, rh, fill); }
        }

        if (shadow != 0 && shadowInset == 1) {
            int ia = 1;
            while (ia <= 3) {
                c.DrawRoundRect(rx + ia - 1, ry + ia - 1, rw - (ia - 1) * 2,
                                rh - (ia - 1) * 2, r,
                                App.ScaleAlpha(this.Fade(shadow), 1000 - ia * 250), 1);
                ia = ia + 1;
            }
        }

        this.PaintBorders(app, rx, ry, rw, rh, r);
        if (specular == 1 && fxId != 0) {
            Fx.Specular(app, fxId, rx, ry, rw, rh, r, 4294967295);
        }
        this.PaintAnim(app, rx, ry, rw, rh, r);
    }

    /// 投影：一个偏移的形状，加上数圈逐渐扩张的半透明环，
    /// 当 `shadowBlur` 需要柔和边缘时（软件渲染器没有
    /// 高斯阴影，因此衰减用分层实现）。
    void PaintShadow(App app, int x, int y, int w, int h, int r) {
        Canvas c = app.canvas;
        int col = this.Fade(shadow);
        int dx = x + app.Scale(shadowDx);
        int dy = y + app.Scale(shadowDy);
        if (shadowBlur <= 0) {
            if (r > 0) { c.FillRoundRect(dx, dy, w, h, r, col); }
            else { c.FillRect(dx, dy, w, h, col); }
            return;
        }
        int steps = shadowBlur / 2;
        if (steps < 1) { steps = 1; }
        if (steps > 6) { steps = 6; }
        // 之前每层衰减都会作为整个圆角矩形填充，因此
        // 柔和阴影每层都要混合一次面板的全部区域（这是玻璃框
        // 最大的开销）。反复混合同一种颜色
        // 与顺序无关，所以每层只绘制一次，只覆盖
        // 它新增的那圈环，alpha 取各重叠层合成的结果——
        // 像素结果相同，工作量却只有一小部分。最内层区域（盒子
        // 正下方）一次填充即可获得完整合成后的 alpha。
        int acc = 0;
        int i = steps;
        while (i >= 1) {
            int spread = app.Scale(shadowBlur) * i / steps;
            int a = 1000 / (steps + 1) * (steps - i + 1);
            int layer = StyleBox.AlphaOf(App.ScaleAlpha(col, a * 600 / 1000));
            acc = acc + layer * (255 - acc) / 255;
            int inner = app.Scale(shadowBlur) * (i - 1) / steps;
            this.PaintShadowRing(c, dx - spread, dy - spread, w + spread * 2,
                                 h + spread * 2, r + spread, spread - inner,
                                 acc * 16777216 + (col % 16777216));
            i = i - 1;
        }
        if (acc > 0) {
            c.FillRoundRect(dx, dy, w, h, r, acc * 16777216 + (col % 16777216));
        }
    }

    /// 只填充圆角矩形 (x,y,w,h,radius) 的 `t` 宽边框环，
    /// 通过把填充裁剪到环的四条条带来实现，使圆角轮廓
    /// 得以保留，且不触碰内部像素。
    void PaintShadowRing(Canvas c, int x, int y, int w, int h, int radius,
                         int t, int color) {
        if (t <= 0 || w <= 0 || h <= 0) { return; }
        if (t * 2 >= w || t * 2 >= h) {
            c.FillRoundRect(x, y, w, h, radius, color);
            return;
        }
        c.PushClip(x, y, w, t);
        c.FillRoundRect(x, y, w, h, radius, color);
        c.PopClip();
        c.PushClip(x, y + h - t, w, t);
        c.FillRoundRect(x, y, w, h, radius, color);
        c.PopClip();
        c.PushClip(x, y + t, t, h - t * 2);
        c.FillRoundRect(x, y, w, h, radius, color);
        c.PopClip();
        c.PushClip(x + w - t, y + t, t, h - t * 2);
        c.FillRoundRect(x, y, w, h, radius, color);
        c.PopClip();
    }

    /// 带圆角半径的渐变填充：盒子为方形时直接用 FillVGrad，
    /// 否则使用内缩到圆角轮廓的分带填充（渲染器
    /// 没有圆角渐变原语）。
    void PaintGradient(App app, int x, int y, int w, int h, int r) {
        Canvas c = app.canvas;
        int from = this.Fade(bg);
        int to = this.Fade(bgTo);
        if (bgDir == 3) {
            int sw = from; from = to; to = sw;
        }
        if (r <= 0 && bgDir != 1) {
            c.FillVGrad(x, y, w, h, from, to);
            return;
        }
        if (bgDir == 1) {
            // 水平：垂直条带（无原生原语）。穿过
            // 圆角弧的列做逐列内缩（与
            // 垂直路径的逐行内缩镜像对应），使弧成为平滑的 1px
            // 贴合圆角遮罩的切口；中间直线部分用
            // 满高条带填充。在此之前，圆角只是在方形填充上
            // 描一圈 1px 轮廓，导致每个渐变
            // 按钮方形上都带着一道淡淡的弧。
            int bands = w / 4;
            if (bands < 8) { bands = 8; }
            if (bands > 96) { bands = 96; }
            int bw = (w + bands - 1) / bands;
            int corners = this.Corners();
            int i = 0;
            while (i < bands) {
                int bx = x + i * bw;
                if (bx >= x + w) { i = bands; }
                else {
                    int seg = bw;
                    if (bx + seg > x + w) { seg = x + w - bx; }
                    int p = i * 1000 / bands;
                    int col = StyleBox.MixColor(from, to, p);
                    if (bgVia != 0) { col = StyleBox.ViaColor(from, bgVia, to, p); }
                    if (r > 0 && (bx < x + r || bx + seg > x + w - r)) {
                        int colX = bx;
                        while (colX < bx + seg) {
                            int insetT = 0;
                            int insetB = 0;
                            int dl = colX - x;
                            int dr = x + w - colX - 1;
                            if (dl < r) {
                                int ins = StyleBox.CornerInsetAt(r, dl);
                                if ((corners / Corner.TL() % 2) == 1) { insetT = ins; }
                                if ((corners / Corner.BL() % 2) == 1) { insetB = ins; }
                            }
                            if (dr < r) {
                                int ins = StyleBox.CornerInsetAt(r, dr);
                                if ((corners / Corner.TR() % 2) == 1) {
                                    if (ins > insetT) { insetT = ins; }
                                }
                                if ((corners / Corner.BR() % 2) == 1) {
                                    if (ins > insetB) { insetB = ins; }
                                }
                            }
                            int top = y + insetT;
                            int bot = y + h - insetB;
                            if (bot > top) { c.FillRect(colX, top, 1, bot - top, col); }
                            colX = colX + 1;
                        }
                    } else {
                        c.FillRect(bx, y, seg, h, col);
                    }
                    i = i + 1;
                }
            }
            if (r > 0) { this.PaintCornerMask(app, x, y, w, h, r); }
            return;
        }
        // 垂直（或近似垂直的对角线）带圆角：
        // 中间直线部分用条带，圆角弧用单像素行。
        // 整条条带内缩到弧内会把圆角变成
        // 与条带等高的阶梯，在大表面上看起来像锯齿；
        // 逐行内缩遵循 FillRoundRect 绘制的同一轮廓，并且
        // 尊重圆角遮罩，使焊接邻居的方形接缝保持
        // 方形，而不会被圆成小凸块。
        int corners = this.Corners();
        int bands = h / 3;
        if (bands < 8) { bands = 8; }
        if (bands > 96) { bands = 96; }
        int bh = (h + bands - 1) / bands;
        int k = 0;
        while (k < bands) {
            int by = y + k * bh;
            if (by >= y + h) { k = bands; }
            else {
                int seg = bh;
                if (by + seg > y + h) { seg = y + h - by; }
                int p = k * 1000 / bands;
                int col = StyleBox.MixColor(from, to, p);
                if (bgVia != 0) { col = StyleBox.ViaColor(from, bgVia, to, p); }
                if (by < y + r || by + seg > y + h - r) {
                    int row = by;
                    while (row < by + seg) {
                        int rowRel = row - y;
                        int insetL = 0;
                        int insetR = 0;
                        if (rowRel < r) {
                            int ins = StyleBox.CornerInsetAt(r, rowRel);
                            if ((corners / Corner.TL() % 2) == 1) { insetL = ins; }
                            if ((corners / Corner.TR() % 2) == 1) { insetR = ins; }
                        }
                        if (rowRel >= h - r) {
                            int ins = StyleBox.CornerInsetAt(r, h - rowRel - 1);
                            if ((corners / Corner.BL() % 2) == 1) {
                                if (ins > insetL) { insetL = ins; }
                            }
                            if ((corners / Corner.BR() % 2) == 1) {
                                if (ins > insetR) { insetR = ins; }
                            }
                        }
                        c.FillRect(x + insetL, row, w - insetL - insetR, 1, col);
                        row = row + 1;
                    }
                } else {
                    c.FillRect(x, by, w, seg, col);
                }
                k = k + 1;
            }
        }
        if (r > 0) { this.PaintCornerMask(app, x, y, w, h, r); }
    }

    /// 重新绘制圆角轮廓，使分带渐变填充保持干净的
    /// 抗锯齿圆角。裁剪到每个角的方形区域，只描弧的 AA
    /// 环——条带的直线边已经是精确的
    /// 像素填充，用单一平色重画会让渐变
    /// 出现条纹。每个弧使用盒子对应端的渐变颜色（左/上角用
    /// 起始色，右/下角用结束色），并且
    /// 只有盒子实际圆角的角（圆角遮罩）才画弧，因此
    /// 焊接组的方形接缝保持方形。
    void PaintCornerMask(App app, int x, int y, int w, int h, int r) {
        Canvas c = app.canvas;
        int corners = this.Corners();
        if (corners == 0 || r <= 0) { return; }
        int colA = this.Fade(bg);
        int colB = colA;
        if (bgTo != 0) {
            colB = this.Fade(bgTo);
            if (bgDir == 3) { int sw = colA; colA = colB; colB = sw; }
        }
        // 水平：渐变从左到右，左角取
        // 起始色，右角取结束色。垂直/对角：
        // 渐变从上到下，上角取起始色。
        bool horiz = bgDir == 1;
        int colTL = colA;
        int colTR = 0;
        int colBL = 0;
        int colBR = colB;
        if (horiz) { colTR = colB; colBL = colA; }
        else { colTR = colA; colBL = colB; }
        if ((corners / Corner.TL() % 2) == 1) {
            c.PushClip(x, y, r, r);
            c.DrawRoundRectIn(x, y, w, h, r, Corner.TL(), colTL, 1);
            c.PopClip();
        }
        if ((corners / Corner.TR() % 2) == 1) {
            c.PushClip(x + w - r, y, r, r);
            c.DrawRoundRectIn(x + w - r, y, w, h, r, Corner.TR(), colTR, 1);
            c.PopClip();
        }
        if ((corners / Corner.BL() % 2) == 1) {
            c.PushClip(x, y + h - r, r, r);
            c.DrawRoundRectIn(x, y + h - r, w, h, r, Corner.BL(), colBL, 1);
            c.PopClip();
        }
        if ((corners / Corner.BR() % 2) == 1) {
            c.PushClip(x + w - r, y + h - r, r, r);
            c.DrawRoundRectIn(x + w - r, y + h - r, w, h, r, Corner.BR(), colBR, 1);
            c.PopClip();
        }
    }

    /// 圆角矩形在行偏移 `dy` 处的水平内缩（在圆角弧
    /// 之外为 0），使条带能贴合轮廓。
    static int CornerInset(int r, int dy, int seg, int h) {
        if (r <= 0) { return 0; }
        int d = dy;
        if (dy > h - r) { d = h - dy - seg; }
        else { d = dy; }
        if (d >= r) { return 0; }
        if (d < 0) { d = 0; }
        int arm = r - d;
        int inner = r * r - arm * arm;
        if (inner < 0) { inner = 0; }
        return r - Fx.Isqrt(inner);
    }

    /// 距盒子边缘 `d` px 处圆角弧的内缩量（边缘处为 0，弧顶处为 r）：
    /// 该偏移处轮廓的内缩量，超出弧之后为 0。
    /// 让渐变条带能沿任一轴跟随圆角轮廓——
    /// 垂直条带在其所在列按弧内缩上下，
    /// 水平条带在其所在行内缩左右——无需逐像素采样。
    static int CornerInsetAt(int r, int d) {
        if (r <= 0 || d >= r) { return 0; }
        if (d < 0) { d = 0; }
        int arm = r - d;
        int inner = r * r - arm * arm;
        if (inner < 0) { inner = 0; }
        return r - Fx.Isqrt(inner);
    }

    /// 三段渐变采样（`from` -> 50% 处的 `via` -> `to`）。
    static int ViaColor(int from, int via, int to, int p) {
        if (p < 500) { return StyleBox.MixColor(from, via, p * 2); }
        return StyleBox.MixColor(via, to, (p - 500) * 2);
    }

    /// 任一侧已设置时绘制各边边框，否则绘制统一边框。
    void PaintBorders(App app, int x, int y, int w, int h, int r) {
        Canvas c = app.canvas;
        bool anySide = borderTopW > 0 || borderRightW > 0
            || borderBottomW > 0 || borderLeftW > 0;
        if (!anySide) {
            int bw = this.BorderWOr(0);
            int bc = this.Fade(borderColor);
            if (bw > 0 && bc != 0) {
                if (borderStyle == 1) { Fx.DashedBorder(app, x, y, w, h, bc); }
                else if (r > 0) { c.DrawRoundRectIn(x, y, w, h, r, this.Corners(), bc, bw); }
                else { c.DrawRect(x, y, w, h, bc, bw); }
            }
            return;
        }
        if (borderTopW > 0) {
            c.FillRect(x, y, w, borderTopW, this.SideColor(borderTopColor));
        }
        if (borderBottomW > 0) {
            c.FillRect(x, y + h - borderBottomW, w, borderBottomW,
                       this.SideColor(borderBottomColor));
        }
        if (borderLeftW > 0) {
            c.FillRect(x, y, borderLeftW, h, this.SideColor(borderLeftColor));
        }
        if (borderRightW > 0) {
            c.FillRect(x + w - borderRightW, y, borderRightW, h,
                       this.SideColor(borderRightColor));
        }
    }

    int SideColor(int col) {
        if (col != 0) { return this.Fade(col); }
        return this.Fade(borderColor);
    }

    /// `animation` 层：在盒子内绘制的关键帧式动画，
    /// 且自触发（运行期间持续请求帧）。
    void PaintAnim(App app, int x, int y, int w, int h, int r) {
        if (anim == 0) { return; }
        int ms = animMs;
        if (ms <= 0) { ms = 2400; }
        int tint = this.AccentOr(this.FgOr(0));
        if (anim == Style.AnimShimmer()) {
            Fx.CardSheen(app, x, y, w, h, tint, ms);
        } else if (anim == Style.AnimGlow()) {
            Fx.BorderGlow(app, x, y, w, h, r, tint, ms, 220);
        } else if (anim == Style.AnimBreath()) {
            Fx.CardBreath(app, x, y, w, h, tint, ms);
        } else if (anim == Style.AnimAurora()) {
            Fx.CardAurora(app, x, y, w, h, tint);
        } else if (anim == Style.AnimMotes()) {
            Fx.CardMotes(app, x, y, w, h, tint);
        } else if (anim == Style.AnimPulse()) {
            int a = Fx.Pulse(app, ms) * 140 / 1000;
            Canvas c = app.canvas;
            c.FillRoundRect(x, y, w, h, r, App.ScaleAlpha(tint, a * 1000 / 255));
            app.RequestAnimationFrame(32);
        }
    }

    /// 本帧 `float` 动画贡献的额外偏移（控件把它加到
    /// 内容原点，使整个控件上下浮动）。
    int FloatOffset(App app) {
        if (anim != Style.AnimFloat()) { return 0; }
        int ms = animMs;
        if (ms <= 0) { ms = 2600; }
        app.RequestAnimationFrame(32);
        int p = Fx.Pulse(app, ms);
        return app.Scale(3) * (p - 500) / 500;
    }

    /// 本帧 `spin` 动画贡献的旋转角度（度）。
    int SpinDeg(App app) {
        if (anim != Style.AnimSpin()) { return rotate; }
        int ms = animMs;
        if (ms <= 0) { ms = 900; }
        app.RequestAnimationFrame(16);
        return rotate + Fx.Saw(app, ms) * 360 / 1000;
    }

    // ---- 文本 -----

    /// 在 [x,y,w,h] 内绘制标签，遵循颜色、字号/字重、
    /// text-align、vertical-align、letter-spacing、text-transform 和
    /// text-overflow: ellipsis。返回实际绘制的宽度。
    int DrawLabel(App app, int x, int y, int w, int h, string label) {
        if (label == "" || visible == 0 || display == 2) { return 0; }
        Canvas c = app.canvas;
        int fs = this.FontOr(app.theme.fontSizeMedium);
        int col = this.Fade(this.FgOr(app.theme.textPrimary));
        string s = label;
        if (textCase == 1) { s = s.ToUpper(); }
        else if (textCase == 2) { s = s.ToLower(); }

        int avail = w - this.PadLOr(0) - this.PadROr(0);
        int tw = StyleBox.MeasureSpaced(s, fs, letterSpacing);
        if (ellipsis == 1 && avail > 0 && tw > avail) {
            s = StyleBox.Truncate(s, fs, letterSpacing, avail);
            tw = StyleBox.MeasureSpaced(s, fs, letterSpacing);
        }

        int tx0 = x + this.PadLOr(0);
        if (align == 1) { tx0 = x + (w - tw) / 2; }
        else if (align == 2) { tx0 = x + w - this.PadROr(0) - tw; }

        int fh = Canvas.FontHeight(fs);
        int ty0 = y + this.PadTOr(0);
        if (align >= 0 && valign < 0) { ty0 = y + (h - fh) / 2; }
        if (valign == 1) { ty0 = y + (h - fh) / 2; }
        else if (valign == 2) { ty0 = y + h - this.PadBOr(0) - fh; }
        if (lineHeight > 0) { ty0 = y + (lineHeight - fh) / 2; }

        this.DrawRun(c, tx0, ty0, s, col, fs);
        return tw;
    }

    /// 在精确原点绘制一段文本（无盒子对齐），应用
    /// 字间距以及 `font-weight >= 600` 的模拟加粗。
    void DrawRun(Canvas c, int x, int y, string s, int color, int fs) {
        if (letterSpacing == 0) {
            c.DrawText(x, y, s, color, fs);
            if (fontWeight >= 600) { c.DrawText(x + 1, y, s, color, fs); }
            return;
        }
        int cx = x;
        for (int i = 0; i < s.Length; i = i + 1) {
            string ch = s.Substring(i, 1);
            c.DrawText(cx, y, ch, color, fs);
            if (fontWeight >= 600) { c.DrawText(cx + 1, y, ch, color, fs); }
            cx = cx + Canvas.MeasureText(ch, fs) + letterSpacing;
        }
    }

    static int MeasureSpaced(string s, int fs, int spacing) {
        int w = Canvas.MeasureText(s, fs);
        if (spacing != 0) { w = w + spacing * s.Length; }
        return w;
    }

    /// `s` 的最长前缀加 “...”，且能放入 `avail` px 内。
    static string Truncate(string s, int fs, int spacing, int avail) {
        int ell = StyleBox.MeasureSpaced("...", fs, spacing);
        if (avail <= ell) { return "..."; }
        // 一次回退一个完整的 UTF-8 字符：逐字节丢弃
        // 会在切口留下断裂的多字节字符。
        int keep = s.Length;
        while (keep > 0) {
            string head = s.Substring(0, keep);
            if (StyleBox.MeasureSpaced(head, fs, spacing) + ell <= avail) {
                return head + "...";
            }
            keep = Text.PrevCharStart(s, keep);
        }
        return "...";
    }
}
