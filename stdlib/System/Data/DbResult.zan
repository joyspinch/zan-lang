using System;
using System.Text;

namespace System.Data;

/// <summary>一行结果：各单元格的字符串值及逐格的 SQL NULL 标记。
/// 用单一实体承载，避免值与 NULL 标记脱节。</summary>
class DbRow {
    List<string> values;
    List<bool> nulls;

    DbRow(List<string> values, List<bool> nulls) {
        this.values = values;
        this.nulls = nulls;
    }
}

/// <summary>
/// 表示一次数据库查询的结果集。
/// 以字符串值列表存储各行，并附带列名元数据。
/// </summary>
class DbResult {
    List<DbRow> rows;
    List<string> columnNames;
    int columnCount;

    DbResult() {
        this.rows = new List<DbRow>();
        this.columnNames = new List<string>();
        this.columnCount = 0;
    }

    /// <summary>创建空结果（无行）。</summary>
    static DbResult Empty() {
        return new DbResult();
    }

    /// <summary>设置列数。</summary>
    void SetColumnCount(int count) {
        this.columnCount = count;
    }

    /// <summary>添加一个列名。</summary>
    void AddColumnName(string name) {
        this.columnNames.Add(name);
    }

    /// <summary>添加一行值（不含 SQL NULL）。</summary>
    void AddRow(List<string> row) {
        this.rows.Add(new DbRow(row, new List<bool>()));
    }

    /// <summary>添加一行，并附逐列的 SQL NULL 标记，调用方
    /// 可通过 IsNull() 区分 NULL 与空字符串。</summary>
    void AddRowNulls(List<string> row, List<bool> nullFlags) {
        this.rows.Add(new DbRow(row, nullFlags));
    }

    /// <summary>单元格为 SQL NULL 时为 true（空字符串则相反，
    /// GetString 对空字符串同样返回 ""）。</summary>
    bool IsNull(int row, int col) {
        if (row >= 0 && row < this.rows.Count) {
            List<bool> flags = this.rows[row].nulls;
            if (col >= 0 && col < flags.Count) {
                return flags[col];
            }
        }
        return false;
    }

    /// <summary>按列名检查是否为 NULL。</summary>
    bool IsNullByName(int row, string columnName) {
        return IsNull(row, GetColumnIndex(columnName));
    }

    /// <summary>返回行数。</summary>
    int RowCount() {
        return this.rows.Count;
    }

    /// <summary>返回列数。</summary>
    int ColumnCount() {
        return this.columnCount;
    }

    /// <summary>获取指定行列索引处的字符串值。</summary>
    string GetString(int row, int col) {
        if (row >= 0 && row < this.rows.Count) {
            List<string> r = this.rows[row].values;
            if (col >= 0 && col < r.Count) {
                return r[col];
            }
        }
        return "";
    }

    /// <summary>获取指定行列索引处的整数值。</summary>
    int GetInt(int row, int col) {
        string val = GetString(row, col);
        if (val.Length == 0) { return 0; }
        return Convert.ToInt(val);
    }

    /// <summary>获取指定行列索引处的 64 位整数值。</summary>
    long GetLong(int row, int col) {
        string val = GetString(row, col);
        if (val.Length == 0) { return 0; }
        return Convert.ToInt64(val);
    }

    /// <summary>获取指定行列索引处的双精度值。</summary>
    double GetDouble(int row, int col) {
        string val = GetString(row, col);
        if (val.Length == 0) { return 0.0; }
        return Encoding.ParseDouble(val);
    }

    /// <summary>获取指定行列索引处的布尔值。</summary>
    bool GetBool(int row, int col) {
        string val = GetString(row, col);
        return val == "1" || val == "true" || val == "True";
    }

    /// <summary>按行索引和列名取值。</summary>
    string GetByName(int row, string columnName) {
        int col = GetColumnIndex(columnName);
        if (col >= 0) {
            return GetString(row, col);
        }
        return "";
    }

    /// <summary>按列名获取列索引。</summary>
    int GetColumnIndex(string name) {
        for (int i = 0; i < this.columnNames.Count; i = i + 1) {
            if (this.columnNames[i] == name) {
                return i;
            }
        }
        return -1;
    }

    /// <summary>获取指定索引处的列名。</summary>
    string GetColumnName(int index) {
        if (index >= 0 && index < this.columnNames.Count) {
            return this.columnNames[index];
        }
        return "";
    }

    /// <summary>返回所有列名（内部列表的副本，调用方改动
    /// 不会影响本结果集）。</summary>
    List<string> GetColumnNames() {
        List<string> copy = new List<string>();
        for (int i = 0; i < this.columnNames.Count; i = i + 1) {
            copy.Add(this.columnNames[i]);
        }
        return copy;
    }

    /// <summary>检查结果集是否包含行。</summary>
    bool HasRows() {
        return this.rows.Count > 0;
    }

    /// <summary>将整行作为字符串列表返回（内部行的副本）。</summary>
    List<string> GetRow(int index) {
        if (index >= 0 && index < this.rows.Count) {
            List<string> src = this.rows[index].values;
            List<string> copy = new List<string>();
            for (int i = 0; i < src.Count; i = i + 1) {
                copy.Add(src[i]);
            }
            return copy;
        }
        return new List<string>();
    }

    /// <summary>获取第一行（便捷方法）。</summary>
    List<string> First() {
        return GetRow(0);
    }

    /// <summary>将结果集打印到控制台（用于调试）。</summary>
    void Print() {
        // 打印列标题
        StringBuilder headerSb = new StringBuilder();
        for (int c = 0; c < this.columnNames.Count; c = c + 1) {
            if (c > 0) { headerSb.Append("\t"); }
            headerSb.Append(this.columnNames[c]);
        }
        Console.WriteLine(headerSb.ToString());

        // 打印分隔线
        Console.WriteLine("---");

        // 打印各行
        for (int r = 0; r < this.rows.Count; r = r + 1) {
            StringBuilder rowSb = new StringBuilder();
            List<string> row = this.rows[r].values;
            for (int cc = 0; cc < row.Count; cc = cc + 1) {
                if (cc > 0) { rowSb.Append("\t"); }
                rowSb.Append(row[cc]);
            }
            Console.WriteLine(rowSb.ToString());
        }
    }
}
