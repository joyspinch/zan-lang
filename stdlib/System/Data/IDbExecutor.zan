using System;

namespace System.Data;

/// <summary>
/// Minimal execution contract shared by database connections, in a synchronous
/// and an asynchronous flavour of the same four operations. Any implementing
/// connection can drive the FreeSQL-style ORM (System.Data.Orm.Model /
/// QueryBuilder), so the ORM works identically over the ODBC DbConnection and
/// the native SQLite / PostgreSQL / MySQL drivers.
///
/// Both flavours exist because the drivers differ in kind, not in API: an
/// embedded engine (SQLite) answers from a local file and has nothing to wait
/// for, while a networked engine must wait for the server -- and doing that on
/// a blocking socket stops the whole worker's event loop, capping database
/// concurrency at the number of workers. A driver whose IO is coroutine-ized
/// (MySqlConnection) therefore implements the *Async methods for real and lets
/// the synchronous ones fail loudly, and a synchronous driver implements the
/// *Async methods as thin forwarders. Callers -- including the generated ORM
/// terminals -- can then use the asynchronous chain unconditionally and get
/// non-blocking IO wherever the driver has it.
/// </summary>
interface IDbExecutor {
    DbResult Query(string sql, DbParams prms);
    int Execute(string sql, DbParams prms);
    DbResult Query(string sql);
    int Execute(string sql);
    string ExecuteScalar(string sql);
    string ExecuteScalar(string sql, DbParams prms);
    int GetProvider();

    /// <summary>Coroutine twin of <see cref="Query"/>: suspends instead of
    /// blocking the worker on drivers with asynchronous IO.</summary>
    async DbResult QueryAsync(string sql, DbParams prms);
    async int ExecuteAsync(string sql, DbParams prms);
    async DbResult QueryAsync(string sql);
    async int ExecuteAsync(string sql);
    async string ExecuteScalarAsync(string sql);
    async string ExecuteScalarAsync(string sql, DbParams prms);
}
