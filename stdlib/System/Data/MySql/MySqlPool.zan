using System;
using System.Data;
using System.Threading;

namespace System.Data.MySql;

/// <summary>
/// Coroutine-aware connection pool for <see cref="MySqlConnection"/>.
///
/// Connections are opened lazily up to <c>maxSize</c> and reused across
/// coroutines. When every connection is checked out and the cap is reached,
/// <see cref="AcquireAsync"/> suspends the calling coroutine on an
/// event-driven <see cref="Gate"/> (no polling, no timer) instead of blocking
/// the worker thread, and is resumed the moment a connection is returned with
/// <see cref="Release"/>. Because both opening a connection
/// and running queries are already coroutine-ized on the IO reactor, the whole
/// acquire/query/release cycle stays non-blocking.
///
/// The pool relies on the cooperative single-thread-per-scheduler model: the
/// free-list is only touched between await points, so no lock is required.
///
/// Usage:
///   MySqlPool pool = new MySqlPool("127.0.0.1", 3306, "test", "root", "secret", 8);
///   MySqlConnection db = await pool.AcquireAsync();
///   DbResult r = await db.QueryAsync("SELECT 1");
///   pool.Release(db);
///   pool.Close();
/// </summary>
class MySqlPool {
    string host;
    int port;
    string database;
    string user;
    string password;
    PoolCore<MySqlConnection> core;

    MySqlPool(string host, int port, string database, string user,
            string password, int maxSize) {
        this.host = host;
        this.port = port;
        this.database = database;
        this.user = user;
        this.password = password;
        this.core = new PoolCore<MySqlConnection>(maxSize);
    }

    async MySqlConnection OpenOne() {
        return await MySqlConnection.OpenParamsAsync(this.host, this.port,
                                                     this.database, this.user,
                                                     this.password);
    }

    /// <summary>Checks out a connection: reuses an idle one, opens a new one if
    /// under the cap, otherwise suspends the coroutine until one is released.
    /// Returns null once the pool has been closed.</summary>
    async MySqlConnection AcquireAsync() {{
        while (true) {{
            if (this.core.IsClosed()) {{
                return null;
            }}
            MySqlConnection pooled = this.core.TakeIdle();
            while (pooled != null) {{
                // A connection can rot while parked (server restart, idle
                // timeout): evict it and free its slot for a waiter.
                if (pooled.IsConnected()) {{
                    return pooled;
                }}
                this.core.Drop();
                pooled = this.core.TakeIdle();
            }}
            if (this.core.TryReserve()) {{
                MySqlConnection opened = await this.OpenOne();
                if (opened == null || !opened.IsConnected()) {{
                    this.core.UndoReserve();
                }}
                return opened;
            }}
            // Pool saturated: park until a connection is released.
            this.core.EnterWait();
            await this.core.Waiter().Wait();
            this.core.LeaveWait();
        }}
        return null;
    }}

    /// <summary>Returns a connection to the pool. A broken or post-Close()
    /// connection is closed and dropped instead of being pooled.</summary>
    void Release(MySqlConnection c) {{
        if (c == null) {{
            return;
        }}
        if (this.core.IsClosed() || !c.IsConnected()) {{
            if (c.IsConnected()) {{
                c.Close();
            }}
            this.core.Drop();
            return;
        }}
        this.core.Pool(c);
    }}

    /// <summary>Number of idle (pooled, ready-to-use) connections.</summary>
    int IdleCount() {{
        return this.core.IdleCount();
    }}

    /// <summary>Total live connections (idle + checked out).</summary>
    int LiveCount() {{
        return this.core.LiveCount();
    }}

    /// <summary>Closes all idle connections and marks the pool closed. Connections
    /// still checked out are closed when they are released.</summary>
    void Close() {{
        this.core.MarkClosed();
        MySqlConnection c = this.core.TakeIdle();
        while (c != null) {{
            c.Close();
            this.core.Drop();
            c = this.core.TakeIdle();
        }}
        this.core.WakeAll();
    }}
}}
