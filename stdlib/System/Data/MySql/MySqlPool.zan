using System;
using System.Data;
using System.Threading;

namespace System.Data.MySql;

/// <summary>
/// 面向 <see cref="MySqlConnection"/> 的协程感知连接池。
///
/// 连接按需懒打开，最多 <c>maxSize</c> 条，并在协程间
/// 复用。当所有连接都被借出且达到上限时，
/// <see cref="AcquireAsync"/> 会让调用协程挂起在事件驱动的
/// <see cref="Gate"/> 上（无轮询、无定时器），而非阻塞
/// 工作线程；一旦有连接通过 <see cref="Release"/>
/// 归还，它便立即恢复。由于打开连接
/// 与执行查询都已协程化于 IO reactor 上，
/// 整个 获取/查询/释放 周期保持非阻塞。
///
/// 连接池依赖协作式「每调度器单线程」模型：
/// 空闲列表只在 await 之间被访问，因此无需加锁。
///
/// 用法：
///   MySqlPool pool = new MySqlPool("127.0.0.1", 3306, "test", "root", "secret", 8);
///   MySqlConnection db = await pool.AcquireAsync();
///   DbResult r = await db.QueryAsync("SELECT 1");
///   pool.Release(db);
///   pool.Close();
/// </summary>
class MySqlPool {
    string host;
    int port;
    string database;
    string user;
    string password;
    PoolCore<MySqlConnection> core;

    MySqlPool(string host, int port, string database, string user,
            string password, int maxSize) {
        this.host = host;
        this.port = port;
        this.database = database;
        this.user = user;
        this.password = password;
        this.core = new PoolCore<MySqlConnection>(maxSize);
    }

    async MySqlConnection OpenOne() {
        return await MySqlConnection.OpenParamsAsync(this.host, this.port,
                                                     this.database, this.user,
                                                     this.password);
    }

    /// <summary>借出一个连接：复用空闲的，未达上限则新建，
    /// 否则挂起协程直到有连接被释放。
    /// 连接池关闭后返回 null。</summary>
    async MySqlConnection AcquireAsync() {
        while (true) {
            if (this.core.IsClosed()) {
                return null;
            }
            MySqlConnection pooled = this.core.TakeIdle();
            while (pooled != null) {
                // 连接在停放期间可能已失效（服务器重启、空闲
                // 超时等）：将其逐出，把槽位让给等待者。
                if (pooled.IsConnected()) {
                    return pooled;
                }
                this.core.Drop(pooled);
                pooled = this.core.TakeIdle();
            }
            if (this.core.TryReserve()) {
                MySqlConnection opened = await this.OpenOne();
                if (opened == null || !opened.IsConnected()) {
                    this.core.UndoReserve();
                    return null;
                }
                this.core.Borrow(opened);
                return opened;
            }
            // 连接池已满：挂起等待，直到有连接被释放。
            this.core.EnterWait();
            await this.core.Waiter().Wait();
            this.core.LeaveWait();
        }
        return null;
    }

    /// <summary>将连接归还连接池。损坏的或 Close() 之后的
    /// 连接会被关闭丢弃，不再入池。</summary>
    void Release(MySqlConnection c) {
        if (c == null) {
            return;
        }
        if (this.core.IsClosed() || !c.IsConnected()) {
            if (c.IsConnected()) {
                c.Close();
            }
            this.core.Drop(c);
            return;
        }
        this.core.Pool(c);
    }

    /// <summary>空闲（已入池、可直接使用）连接数。</summary>
    int IdleCount() {
        return this.core.IdleCount();
    }

    /// <summary>活跃连接总数（空闲 + 已借出）。</summary>
    int LiveCount() {
        return this.core.LiveCount();
    }

    /// <summary>关闭所有空闲连接并将连接池标记为已关闭。
    /// 仍被借出的连接在归还时关闭。</summary>
    void Close() {
        this.core.MarkClosed();
        MySqlConnection c = this.core.TakeIdle();
        while (c != null) {
            c.Close();
            this.core.Drop(c);
            c = this.core.TakeIdle();
        }
        this.core.WakeAll();
    }
}
