using System;
using System.Data;
using System.Threading;

namespace System.Data.TDengine;

/// <summary>
/// Coroutine-aware connection pool for <see cref="TDengineConnection"/>.
///
/// Same contract as <see cref="DbPool"/> -- lazy growth up to <c>maxSize</c>,
/// <see cref="Gate"/>-driven waiting rather than polling, eviction of dead
/// connections -- but typed, so the coroutine query API (<c>QueryAsync</c>,
/// <c>ExecuteAsync</c>) stays reachable. Opening and every statement run on the
/// IO reactor, so the pool size is what bounds concurrency against
/// taosAdapter, not the number of worker threads.
///
/// Usage:
///   TDenginePool pool = TDenginePool.Create("127.0.0.1", 6041, "root", "taosdata", "power", 8);
///   TDengineConnection db = await pool.AcquireAsync();
///   DbResult r = await db.QueryAsync("SELECT * FROM meters LIMIT 10");
///   pool.Release(db);
///   pool.Close();
/// </summary>
class TDenginePool {
    string host;
    int port;
    string user;
    string password;
    string token;       // "" = use user/password
    string database;
    int maxSize;
    List<TDengineConnection> idle;
    int liveCount;      // total opened connections (idle + checked out)
    int waiting;        // coroutines currently parked in AcquireAsync
    Gate gate;
    bool closed;

    TDenginePool(string host, int port, string user, string password,
            string token, string database, int maxSize) {
        this.host = host;
        this.port = port;
        this.user = user;
        this.password = password;
        this.token = token;
        this.database = database;
        this.maxSize = maxSize;
        this.idle = new List<TDengineConnection>();
        this.liveCount = 0;
        this.waiting = 0;
        this.gate = Gate.Create();
        this.closed = false;
    }

    /// <summary>Pool authenticating with user/password.</summary>
    static TDenginePool Create(string host, int port, string user, string password,
            string database, int maxSize) {
        if (maxSize < 1) {
            maxSize = 1;
        }
        return new TDenginePool(host, port, user, password, "", database, maxSize);
    }

    /// <summary>Pool authenticating with a taosAdapter token.</summary>
    static TDenginePool CreateToken(string host, int port, string token,
            string database, int maxSize) {
        if (maxSize < 1) {
            maxSize = 1;
        }
        return new TDenginePool(host, port, "", "", token, database, maxSize);
    }

    async TDengineConnection OpenOne() {
        if (this.token != "") {
            return await TDengineConnection.OpenTokenAsync(this.host, this.port,
                                                           this.token, this.database);
        }
        return await TDengineConnection.OpenAsync(this.host, this.port, this.user,
                                                  this.password, this.database);
    }

    /// <summary>Checks out a connection. Reuses an idle one, opens a new one if
    /// under the cap, otherwise suspends the coroutine until one is released.</summary>
    async TDengineConnection AcquireAsync() {
        while (true) {
            if (this.closed) {
                return null;
            }
            if (this.idle.Count > 0) {
                int last = this.idle.Count - 1;
                TDengineConnection c = this.idle[last];
                this.idle.RemoveAt(last);
                if (c.IsConnected()) {
                    return c;
                }
                if (this.liveCount > 0) {
                    this.liveCount = this.liveCount - 1;
                }
                continue;
            }
            if (this.liveCount < this.maxSize) {
                // Reserve the slot before suspending, so concurrent acquirers
                // cannot all see room and overshoot maxSize.
                this.liveCount = this.liveCount + 1;
                TDengineConnection c = await OpenOne();
                if (c == null || !c.IsConnected()) {
                    this.liveCount = this.liveCount - 1;
                    if (this.waiting > 0) {
                        this.gate.Signal();
                    }
                }
                return c;
            }
            this.waiting = this.waiting + 1;
            await this.gate.Wait();
            this.waiting = this.waiting - 1;
        }
        return null;
    }

    /// <summary>Returns a connection to the pool. A broken or post-Close()
    /// connection is closed and dropped instead of being pooled.</summary>
    void Release(TDengineConnection c) {
        if (c == null) {
            return;
        }
        if (this.closed || !c.IsConnected()) {
            c.Close();
            if (this.liveCount > 0) {
                this.liveCount = this.liveCount - 1;
            }
            if (this.waiting > 0) {
                this.gate.Signal();
            }
            return;
        }
        this.idle.Add(c);
        if (this.waiting > 0) {
            this.gate.Signal();
        }
    }

    /// <summary>Number of idle (pooled, ready-to-use) connections.</summary>
    int IdleCount() {
        return this.idle.Count;
    }

    /// <summary>Total live connections (idle + checked out).</summary>
    int LiveCount() {
        return this.liveCount;
    }

    /// <summary>Coroutines currently parked waiting for a connection.</summary>
    int WaitingCount() {
        return this.waiting;
    }

    /// <summary>Upper bound on live connections.</summary>
    int MaxSize() {
        return this.maxSize;
    }

    /// <summary>Closes all idle connections and marks the pool closed. Waiters
    /// are woken and get null; connections still checked out are closed when
    /// they are released.</summary>
    void Close() {
        this.closed = true;
        while (this.idle.Count > 0) {
            int last = this.idle.Count - 1;
            TDengineConnection c = this.idle[last];
            this.idle.RemoveAt(last);
            c.Close();
            if (this.liveCount > 0) {
                this.liveCount = this.liveCount - 1;
            }
        }
        int n = this.waiting;
        int k = 0;
        while (k < n) {
            this.gate.Signal();
            k = k + 1;
        }
    }
}
