using System;
using System.Data;

namespace System.Data.TDengine;

/// <summary>
/// TDengine REST 驱动，见 <see cref="IDbConnector"/>。这里的"连接"
/// 就是端点加 Authorization 请求头——taosAdapter 无状态——
/// 因此池化限制了同时在途的语句数，并把
/// 准备好的凭据交给每个协程。
///
/// 用法：
///   DbPool pool = TDengineConnector.Pool("127.0.0.1", 6041, "root", "taosdata", "power", 8);
///   IDbConnection db = await pool.AcquireAsync();
///   DbResult r = db.Query("SELECT * FROM meters LIMIT 10");
///   pool.Release(db);
///
/// 当需要协程查询 API 时请改用 <see cref="TDenginePool"/>
/// （QueryAsync/ExecuteAsync）：它会返回驱动类型。
/// </summary>
class TDengineConnector : IDbConnector {
    string host;
    int port;
    string user;
    string password;
    string token;
    string database;

    TDengineConnector(string host, int port, string user, string password,
            string token, string database) {
        this.host = host;
        this.port = port;
        this.user = user;
        this.password = password;
        this.token = token;
        this.database = database;
    }

    /// <summary>使用预先签发的 taosAdapter token 的连接器。</summary>
    static TDengineConnector CreateToken(string host, int port, string token,
            string database) {
        return new TDengineConnector(host, port, "", "", token, database);
    }

    /// <summary>使用用户名/密码认证的连接池。</summary>
    static DbPool Pool(string host, int port, string user, string password,
            string database, int maxSize) {
        return new DbPool(
            new TDengineConnector(host, port, user, password, "", database),
            maxSize);
    }

    /// <summary>使用 token 认证的连接池。</summary>
    static DbPool PoolToken(string host, int port, string token,
            string database, int maxSize) {
        return new DbPool(
            TDengineConnector.CreateToken(host, port, token, database),
            maxSize);
    }

    async IDbConnection ConnectAsync() {
        if (this.token != "") {
            return await TDengineConnection.OpenTokenAsync(this.host, this.port,
                                                           this.token, this.database);
        }
        return await TDengineConnection.OpenAsync(this.host, this.port, this.user,
                                                  this.password, this.database);
    }

    int GetProvider() {
        return DbProvider.TDengine;
    }
}
