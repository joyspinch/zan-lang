using System;
using System.Data;
using System.Json;
using System.Net.Http;
using System.Net.Sockets;
using System.Security.Cryptography;

namespace System.Data.TDengine;

/// <summary>
/// 原生、无依赖的 TDengine 连接，通过 REST API 通信，
/// taosAdapter 在 6041 端口提供服务（`POST /rest/sql`）。
///
/// 与 ODBC 方式不同，目标机器无需安装任何东西：
/// 整个协议就是 HTTP + JSON，任何能访问到 adapter 的机器都能用，
/// 包括没有 taosc 客户端库的交叉编译目标。
///
/// TDengine 的 REST 没有客户端语句协议，因此 `?`
/// 占位符在这里被渲染进 SQL 文本——文本值会被加引号
/// 并转义，数字按格式输出，NULL 输出为关键字。
/// 渲染器只替换字符串字面量之外的占位符，
/// 因此 SQL 中的字面量问号不会被处理。
///
/// 主机必须是点分 IPv4 地址（socket 层不解析主机名）。
/// TDengine 没有事务，因此这里没有 Begin/Commit
/// 等操作可用。
///
/// 语句失败（服务端报错、无法到达 taosAdapter、占位符
/// 个数不匹配）时抛出 <see cref="DbException"/>，
/// 携带 taosAdapter 响应中的错误码；空结果集总意味着
/// 「无行」。错误文本仍可通过 GetError() 获取。
///
/// 用法：
///   TDengineConnection db = TDengineConnection.Open("127.0.0.1", 6041,
///                               "root", "taosdata", "demo");
///   db.Execute("CREATE TABLE IF NOT EXISTS t (ts TIMESTAMP, v INT)");
///   db.Execute("INSERT INTO t VALUES (NOW, ?)", new DbParams().AddInt(7));
///   DbResult r = db.Query("SELECT * FROM t WHERE v > ?",
///                         new DbParams().AddInt(3));
///   db.Close();
/// </summary>
class TDengineConnection : IDbConnection {
    string host;
    int port;
    string auth;          // 完整的 Authorization 请求头值
    string database;      // "" 表示未设置默认数据库
    bool connected;
    string lastError;
    int lastCode;         // taosAdapter 的错误码（响应 JSON 的 `code`）
    int affected;

    TDengineConnection() {
        this.host = "";
        this.port = 6041;
        this.auth = "";
        this.database = "";
        this.connected = false;
        this.lastError = "";
        this.lastCode = 0;
        this.affected = 0;
    }

    /// <summary>使用 HTTP Basic 凭据打开连接，不
    /// 选择数据库。</summary>
    static TDengineConnection Open(string host, int port, string user, string password) {
        return TDengineConnection.Open(host, port, user, password, "");
    }

    /// <summary>使用 HTTP Basic 凭据打开连接，并指定默认
    /// 数据库（语句随后可直接使用不带库名的表名）。
    /// 连接时会先与服务器通信一次以校验凭据，可检查 IsConnected()。</summary>
    static TDengineConnection Open(string host, int port, string user, string password,
                                   string database) {
        TDengineConnection conn = new TDengineConnection();
        conn.host = host;
        conn.port = port;
        conn.database = database;
        string cred = user + ":" + password;
        conn.auth = "Basic " + Base64.Encode(cred, cred.Length);
        conn.connected = conn.Ping();
        return conn;
    }

    /// <summary>使用 taosAdapter 登录 token 打开连接
    /// （`Authorization: Taosd &lt;token&gt;`），由
    /// `GET /rest/login/&lt;user&gt;/&lt;password&gt;` 返回。</summary>
    static TDengineConnection OpenToken(string host, int port, string token, string database) {
        TDengineConnection conn = new TDengineConnection();
        conn.host = host;
        conn.port = port;
        conn.database = database;
        conn.auth = "Taosd " + token;
        conn.connected = conn.Ping();
        return conn;
    }

    /// <summary>使用 HTTP Basic 凭据打开连接且不阻塞 worker：
    /// 校验请求在 IO reactor 上执行。</summary>
    static async TDengineConnection OpenAsync(string host, int port, string user,
                                              string password, string database) {
        TDengineConnection conn = new TDengineConnection();
        conn.host = host;
        conn.port = port;
        conn.database = database;
        string cred = user + ":" + password;
        conn.auth = "Basic " + Base64.Encode(cred, cred.Length);
        conn.connected = await conn.PingAsync();
        return conn;
    }

    /// <summary>OpenAsync 的 token 版本。</summary>
    static async TDengineConnection OpenTokenAsync(string host, int port, string token,
                                                   string database) {
        TDengineConnection conn = new TDengineConnection();
        conn.host = host;
        conn.port = port;
        conn.database = database;
        conn.auth = "Taosd " + token;
        conn.connected = await conn.PingAsync();
        return conn;
    }

    /// <summary>执行一条简单语句，检查 adapter 是否响应且
    /// 凭据是否被接受。</summary>
    bool Ping() {
        string body = Post("SELECT SERVER_VERSION()");
        if (body.Length == 0) { return false; }
        JsonValue root = JsonValue.ParseLenient(body);
        return !Failed(root);
    }

    /// <summary>在 reactor 上 Ping，挂起而非阻塞。</summary>
    async bool PingAsync() {
        string body = await PostAsync("SELECT SERVER_VERSION()");
        if (body.Length == 0) { return false; }
        JsonValue root = JsonValue.ParseLenient(body);
        return !Failed(root);
    }

    /// <summary>服务器版本字符串，查询失败时返回 ""。</summary>
    string ServerVersion() {
        DbResult r = Query("SELECT SERVER_VERSION()");
        if (r.RowCount() == 0) { return ""; }
        return r.GetString(0, 0);
    }

    /// <summary>选择后续语句使用的默认数据库。</summary>
    void Use(string database) {
        this.database = database;
    }

    // ===== SQL 文本渲染 =====

    /// <summary>对 TDengine 单引号字符串字面量中的值进行转义：
    /// 解析器只特殊处理反斜杠和引号
    /// 这两个字符。</summary>
    static string EscapeText(string val) {
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < val.Length; i = i + 1) {
            int c = val[i] & 255;
            if (c == 92 || c == 39) { sb.Append("\\"); }   // '\' or '\''
            sb.Append(val.Substring(i, 1));
        }
        return sb.ToString();
    }

    /// <summary>将单个参数渲染为 SQL 字面量。</summary>
    static string Literal(DbParams prms, int i) {
        int kind = prms.KindAt(i);
        if (kind == DbParams.KindInt) { return Convert.ToString(prms.IntAt(i)); }
        if (kind == DbParams.KindDouble) { return Convert.ToString(prms.DoubleAt(i)); }
        if (kind == DbParams.KindText) {
            return "'" + TDengineConnection.EscapeText(prms.TextAt(i)) + "'";
        }
        return "NULL";
    }

    /// <summary>
    /// 将 `?` 占位符替换为转义后的参数字面量。
    /// 只有字符串字面量之外的占位符才有效，所以 `WHERE note = 'a?b'`
    /// 中的问号会保留；字面量内的反斜杠会转义下一个字符，
    /// 与服务器解析器行为一致。
    ///
    /// 当 SQL 与参数列表的占位符数量不一致时返回 ""，
    /// 避免不匹配时发送半绑定的语句。
    /// </summary>
    static string RenderSql(string sql, DbParams prms) {
        StringBuilder sb = new StringBuilder();
        int quote = 0;      // 0 = 在字面量之外，否则为引号字节
        int used = 0;
        int i = 0;
        while (i < sql.Length) {
            int c = sql[i] & 255;
            if (quote != 0) {
                sb.Append(sql.Substring(i, 1));
                if (c == 92 && i + 1 < sql.Length) {
                    sb.Append(sql.Substring(i + 1, 1));
                    i = i + 2;
                    continue;
                }
                if (c == quote) { quote = 0; }
            } else if (c == 39 || c == 34) {                 // '\'' or '"'
                quote = c;
                sb.Append(sql.Substring(i, 1));
            } else if (c == 63) {                            // '?'
                if (used >= prms.Count()) { return ""; }
                sb.Append(TDengineConnection.Literal(prms, used));
                used = used + 1;
            } else {
                sb.Append(sql.Substring(i, 1));
            }
            i = i + 1;
        }
        if (used != prms.Count()) { return ""; }
        return sb.ToString();
    }

    // ===== HTTP 传输 =====

    /// <summary>解除 `Transfer-Encoding: chunked` 分块。taosAdapter 对
    /// 事先不知道大小的结果集使用它，
    /// 而响应解析器交出的 body 仍带分块。</summary>
    static string Dechunk(string body) {
        StringBuilder sb = new StringBuilder();
        int pos = 0;
        while (pos < body.Length) {
            int lineEnd = pos;
            while (lineEnd < body.Length && (body[lineEnd] & 255) != 10) {
                lineEnd = lineEnd + 1;
            }
            int size = TDengineConnection.HexOf(body.Substring(pos, lineEnd - pos));
            if (size <= 0) { return sb.ToString(); }
            int start = lineEnd + 1;
            if (start + size > body.Length) { size = body.Length - start; }
            if (size <= 0) { return sb.ToString(); }
            sb.Append(body.Substring(start, size));
            pos = start + size + 2;             // 跳过 chunk 末尾的 CRLF
        }
        return sb.ToString();
    }

    /// <summary>解析 chunk-size 行（十六进制，可带 ";extension"，以 CR 结尾）。</summary>
    static int HexOf(string text) {
        int v = 0;
        int i = 0;
        bool any = false;
        while (i < text.Length) {
            int c = text[i] & 255;
            int d = 0 - 1;
            if (c >= 48 && c <= 57) { d = c - 48; }
            else if (c >= 97 && c <= 102) { d = c - 87; }
            else if (c >= 65 && c <= 70) { d = c - 55; }
            else { i = text.Length; }
            if (d >= 0) {
                v = v * 16 + d;
                any = true;
                i = i + 1;
            }
        }
        if (!any) { return 0 - 1; }
        return v;
    }

    /// <summary>响应声明使用分块传输时返回 true。</summary>
    static bool IsChunked(HttpResponse resp) {
        for (int i = 0; i < resp.headers.Count; i = i + 1) {
            string h = resp.headers[i].ToLower();
            if (h.StartsWith("transfer-encoding:") && h.Contains("chunked")) {
                return true;
            }
        }
        return false;
    }

    /// <summary>当前默认数据库的 REST 端点。</summary>
    string SqlPath() {
        if (this.database.Length == 0) { return "/rest/sql"; }
        return "/rest/sql/" + this.database;
    }

    /// <summary>携带单条语句的 HTTP/1.1 请求。</summary>
    string Request(string sql) {
        StringBuilder req = new StringBuilder();
        req.Append("POST ");
        req.Append(SqlPath());
        req.Append(" HTTP/1.1\r\nHost: ");
        req.Append(this.host);
        req.Append(":");
        req.Append(Convert.ToString(this.port));
        req.Append("\r\nAuthorization: ");
        req.Append(this.auth);
        req.Append("\r\nContent-Type: text/plain\r\nContent-Length: ");
        req.Append(Convert.ToString(sql.Length));
        req.Append("\r\nConnection: close\r\n\r\n");
        req.Append(sql);
        return req.ToString();
    }

    /// <summary>从原始 HTTP 交换中提取响应 body，
    /// 解除分块，并记录非 200 状态码。</summary>
    string BodyOf(string raw) {
        HttpResponse resp = HttpResponse.Parse(raw);
        string body = resp.body;
        if (TDengineConnection.IsChunked(resp)) {
            body = TDengineConnection.Dechunk(body);
        }
        if (resp.statusCode != 200 && body.Length == 0) {
            this.lastError = "HTTP " + Convert.ToString(resp.statusCode) + " "
                + resp.statusText;
        }
        return body;
    }

    string Unreachable() {
        return "cannot reach taosAdapter at " + this.host + ":"
            + Convert.ToString(this.port);
    }

    /// <summary>发送一条语句并返回响应 body，请求无法完成时
    /// 返回 "" 并设置 lastError。</summary>
    string Post(string sql) {
        this.lastError = "";
        this.lastCode = 0;
        nint sock = Socket.CreateTcp();
        if (sock <= 0) {
            this.lastError = "socket creation failed";
            return "";
        }
        if (Socket.Connect(sock, this.host, this.port) != 0) {
            Socket.Close(sock);
            this.lastError = Unreachable();
            return "";
        }

        if (Socket.SendString(sock, Request(sql)) < 0) {
            Socket.Close(sock);
            this.lastError = "sending the statement failed";
            return "";
        }

        StringBuilder raw = new StringBuilder();
        bool reading = true;
        while (reading) {
            string chunk = Socket.Receive(sock, 65536);
            if (chunk.Length == 0) { reading = false; } else { raw.Append(chunk); }
        }
        Socket.Close(sock);
        return BodyOf(raw.ToString());
    }

    /// <summary>在 IO reactor 上执行 Post：连接、发送、接收都挂起
    /// 协程而不是阻塞 worker 线程，因此这样的连接组成池后
    /// 可以同时有多条语句在途。</summary>
    async string PostAsync(string sql) {
        this.lastError = "";
        this.lastCode = 0;
        nint sock = Socket.CreateTcp();
        if (sock <= 0) {
            this.lastError = "socket creation failed";
            return "";
        }
        Socket.SetNonBlocking(sock);
        int rc = await AsyncSocket.Connect(sock, this.host, this.port);
        if (rc != 0) {
            Socket.Close(sock);
            this.lastError = Unreachable();
            return "";
        }

        int sent = await AsyncSocket.SendString(sock, Request(sql));
        if (sent < 0) {
            Socket.Close(sock);
            this.lastError = "sending the statement failed";
            return "";
        }

        StringBuilder raw = new StringBuilder();
        bool reading = true;
        while (reading) {
            string chunk = await AsyncSocket.Receive(sock, 65536);
            if (chunk.Length == 0) { reading = false; } else { raw.Append(chunk); }
        }
        Socket.Close(sock);
        return BodyOf(raw.ToString());
    }

    // ===== 响应解码 =====

    /// <summary>响应报告服务端错误时返回 true；
    /// 错误描述保存在 lastError 中，错误码保存在 lastCode 中。
    /// 3.x 的（`code` != 0）和 2.x 的（`status` == "error"）
    /// 都会被识别。</summary>
    bool Failed(JsonValue root) {
        if (!root.IsObject()) {
            this.lastError = "malformed response from taosAdapter";
            this.lastCode = 0;
            return true;
        }
        bool bad = root.Int("code", 0) != 0 || root.Str("status", "succ") == "error";
        if (bad) {
            this.lastError = root.Str("desc", root.Str("status", "unknown error"));
            this.lastCode = root.Int("code", 0);
        }
        return bad;
    }

    /// <summary>抛出记录的失败，携带 taosAdapter 自身的
    /// 错误码，调用方无需解析消息即可分支处理。</summary>
    void Fail() {
        string why = this.lastError;
        if (why.Length == 0) {
            why = "the statement failed";
        }
        throw new DbException(why, this.lastCode, DbProvider.TDengine);
    }

    /// <summary>将一个 `/rest/sql` 响应文档转换为结果集，
    /// 列名取自 `column_meta`（3.x）或 `head`（2.x），
    /// 并区分 JSON null 与空字符串。</summary>
    DbResult Decode(string body) {
        DbResult result = new DbResult();
        this.affected = 0;
        if (body.Length == 0) {
            if (this.lastError.Length == 0) { this.lastError = "empty response"; }
            return result;
        }
        JsonValue root = JsonValue.ParseLenient(body);
        if (Failed(root)) { return result; }

        List<string> names = new List<string>();
        JsonValue meta = root.Get("column_meta");
        if (meta != null && meta.IsArray()) {
            for (int i = 0; i < meta.Count(); i = i + 1) {
                JsonValue col = meta.At(i);
                if (col.IsArray() && col.Count() > 0) {
                    names.Add(col.At(0).AsString(""));
                } else {
                    names.Add(col.AsString(""));
                }
            }
        } else {
            JsonValue head = root.Get("head");
            if (head != null && head.IsArray()) {
                for (int i = 0; i < head.Count(); i = i + 1) {
                    names.Add(head.At(i).AsString(""));
                }
            }
        }
        result.SetColumnCount(names.Count);
        for (int n = 0; n < names.Count; n = n + 1) {
            result.AddColumnName(names[n]);
        }

        JsonValue data = root.Get("data");
        if (data != null && data.IsArray()) {
            for (int r = 0; r < data.Count(); r = r + 1) {
                JsonValue jrow = data.At(r);
                List<string> row = new List<string>();
                List<bool> nulls = new List<bool>();
                for (int c = 0; c < jrow.Count(); c = c + 1) {
                    JsonValue cell = jrow.At(c);
                    row.Add(cell.AsString(""));
                    nulls.Add(cell.IsNull());
                }
                result.AddRowNulls(row, nulls);
            }
        }

        // 非查询语句返回单个 `affected_rows` 单元格；查询语句
        // 报告它产生了多少行。
        if (names.Count == 1 && names[0] == "affected_rows" && result.RowCount() == 1) {
            this.affected = result.GetInt(0, 0);
        } else {
            this.affected = root.Int("rows", result.RowCount());
        }
        return result;
    }

    // ===== IDbExecutor =====

    /// <summary>执行查询并返回结果集。服务器报错或无法到达
    /// taosAdapter 时抛出 <see cref="DbException"/>，
    /// 因此空结果总意味着「无行」；错误信息仍可通过
    /// <see cref="GetError"/> 获取。</summary>
    DbResult Query(string sql) {
        if (!this.connected) {
            this.lastError = "not connected";
            this.lastCode = 0;
            this.Fail();
        }
        DbResult r = Decode(Post(sql));
        if (this.lastError.Length > 0) { this.Fail(); }
        return r;
    }

    /// <summary>执行查询，其中 `?` 占位符从
    /// <paramref name="prms"/> 填充。占位符个数不匹配时
    /// 抛出 <see cref="DbException"/>。</summary>
    DbResult Query(string sql, DbParams prms) {
        if (!this.connected) {
            this.lastError = "not connected";
            this.lastCode = 0;
            this.Fail();
        }
        string text = TDengineConnection.RenderSql(sql, prms);
        if (text.Length == 0 && sql.Length > 0) {
            this.lastError = "parameter count does not match the placeholders";
            this.lastCode = 0;
            this.Fail();
        }
        return Query(text);
    }

    /// <summary>执行语句并返回受影响的行数。失败时抛出
    /// <see cref="DbException"/>。</summary>
    int Execute(string sql) {
        if (!this.connected) {
            this.lastError = "not connected";
            this.lastCode = 0;
            this.Fail();
        }
        DbResult r = Decode(Post(sql));
        if (this.lastError.Length > 0) { this.Fail(); }
        return this.affected;
    }

    /// <summary>执行带参数的语句。占位符个数不匹配或语句
    /// 失败时抛出 <see cref="DbException"/>。</summary>
    int Execute(string sql, DbParams prms) {
        if (!this.connected) {
            this.lastError = "not connected";
            this.lastCode = 0;
            this.Fail();
        }
        string text = TDengineConnection.RenderSql(sql, prms);
        if (text.Length == 0 && sql.Length > 0) {
            this.lastError = "parameter count does not match the placeholders";
            this.lastCode = 0;
            this.Fail();
        }
        return Execute(text);
    }

    /// <summary>第一行第一列的值，否则返回 ""。</summary>
    string ExecuteScalar(string sql) {
        DbResult r = Query(sql);
        if (r.RowCount() == 0) { return ""; }
        return r.GetString(0, 0);
    }

    /// <summary>参数化查询第一行第一列的值。</summary>
    string ExecuteScalar(string sql, DbParams prms) {
        DbResult r = Query(sql, prms);
        if (r.RowCount() == 0) { return ""; }
        return r.GetString(0, 0);
    }

    // ===== 协程 API =====

    /// <summary>查询，不阻塞 worker 线程。失败时抛出
    /// <see cref="DbException"/>。</summary>
    async DbResult QueryAsync(string sql) {
        if (!this.connected) {
            this.lastError = "not connected";
            this.lastCode = 0;
            this.Fail();
        }
        string body = await PostAsync(sql);
        DbResult r = Decode(body);
        if (this.lastError.Length > 0) { this.Fail(); }
        return r;
    }

    /// <summary>参数化查询，不阻塞 worker 线程。占位符个数
    /// 不匹配时抛出 <see cref="DbException"/>。</summary>
    async DbResult QueryAsync(string sql, DbParams prms) {
        if (!this.connected) {
            this.lastError = "not connected";
            this.lastCode = 0;
            this.Fail();
        }
        string text = TDengineConnection.RenderSql(sql, prms);
        if (text.Length == 0 && sql.Length > 0) {
            this.lastError = "parameter count does not match the placeholders";
            this.lastCode = 0;
            this.Fail();
        }
        return await QueryAsync(text);
    }

    /// <summary>执行语句，不阻塞 worker 线程。失败时抛出
    /// <see cref="DbException"/>。</summary>
    async int ExecuteAsync(string sql) {
        if (!this.connected) {
            this.lastError = "not connected";
            this.lastCode = 0;
            this.Fail();
        }
        string body = await PostAsync(sql);
        DbResult r = Decode(body);
        if (this.lastError.Length > 0) { this.Fail(); }
        return this.affected;
    }

    /// <summary>执行参数化语句，不阻塞 worker 线程。失败时
    /// 抛出 <see cref="DbException"/>。</summary>
    async int ExecuteAsync(string sql, DbParams prms) {
        if (!this.connected) {
            this.lastError = "not connected";
            this.lastCode = 0;
            this.Fail();
        }
        string text = TDengineConnection.RenderSql(sql, prms);
        if (text.Length == 0 && sql.Length > 0) {
            this.lastError = "parameter count does not match the placeholders";
            this.lastCode = 0;
            this.Fail();
        }
        return await ExecuteAsync(text);
    }

    /// <summary>第一行第一列的值，不阻塞。</summary>
    async string ExecuteScalarAsync(string sql) {
        DbResult r = await QueryAsync(sql);
        if (r.RowCount() == 0) { return ""; }
        return r.GetString(0, 0);
    }

    /// <summary>参数化语句第一行第一列的值。</summary>
    async string ExecuteScalarAsync(string sql, DbParams prms) {
        DbResult r = await QueryAsync(sql, prms);
        if (r.RowCount() == 0) { return ""; }
        return r.GetString(0, 0);
    }

    /// <summary>空操作：TDengine 没有事务。参见 BeginTransaction。</summary>
    async bool BeginTransactionAsync() { return true; }
    async bool CommitAsync() { return true; }
    async bool RollbackAsync() { return true; }

    /// <summary>上一条语句影响的行数。</summary>
    int AffectedRows() { return this.affected; }

    /// <summary>最近一次失败的描述，否则返回 ""。</summary>
    string GetError() { return this.lastError; }

    /// <summary>连接打开时 adapter 是否正常响应。</summary>
    /// <summary>空操作：TDengine 没有事务。仅用于满足
    /// <see cref="IDbConnection"/> 接口；任何需要原子性的操作都不应
    /// 在 TDengine 上执行。</summary>
    void BeginTransaction() { }

    /// <summary>空操作：TDengine 没有事务（写入在
    /// Execute 返回时即已持久化）。</summary>
    void Commit() { }

    /// <summary>空操作：TDengine 没有事务，因此无法撤销任何操作。</summary>
    void Rollback() { }

    bool IsConnected() { return this.connected; }

    /// <summary>释放连接状态。REST 协议是无状态的，因此
    /// 不会向服务器发送任何内容。</summary>
    void Close() {
        this.connected = false;
        this.auth = "";
    }

    /// <summary>返回 provider id（DbProvider.TDengine）。</summary>
    int GetProvider() { return DbProvider.TDengine; }
}
