using System;
using System.Data;
using System.Data.Orm;

namespace System.Data;

/// <summary>One dynamic column value: its column name, its kind (the
/// <see cref="DbParams"/> Kind* codes) and the payload matching that kind.
/// </summary>
class DbValue {
    string name;
    int kind;
    string text;
    int ival;
    double dval;

    DbValue(string name, int kind, string text, int ival, double dval) {
        this.name = name;
        this.kind = kind;
        this.text = text;
        this.ival = ival;
        this.dval = dval;
    }
}

/// <summary>
/// An ordered, typed column bag for data that only exists at runtime -- a
/// submitted form, a parsed JSON body, a spreadsheet row -- so dynamic writes
/// need no hand-built SQL:
///
///   DbValues form = new DbValues()
///       .Set(BlogCols.title, "hello")
///       .Set(BlogCols.clicks, 5);
///
///   db.Insert&lt;Blog&gt;().AppendDict(form).ExecuteAffrows();
///   db.Update&lt;Blog&gt;().SetDict(form).Where(a =&gt; a.id == id).ExecuteAffrows();
///
/// Keys are checked against the entity's columns by the generated code, and
/// values are always bound as parameters, never inlined into the SQL text.
/// The `&lt;Entity&gt;Cols` class the ORM generates gives the column names
/// autocompletion instead of bare string literals.
/// </summary>
class DbValues {
    List<DbValue> items;

    DbValues() {
        this.items = new List<DbValue>();
    }

    /// <summary>Sets a text column (replacing an earlier value).</summary>
    DbValues Set(string name, string val) {
        return this.push(name, DbParams.KindText, val, 0, 0.0);
    }

    /// <summary>Sets an integer column.</summary>
    DbValues Set(string name, int val) {
        return this.push(name, DbParams.KindInt, "", val, 0.0);
    }

    /// <summary>Sets a floating-point column.</summary>
    DbValues Set(string name, double val) {
        return this.push(name, DbParams.KindDouble, "", 0, val);
    }

    /// <summary>Sets a boolean column (stored as 0/1).</summary>
    DbValues Set(string name, bool val) {
        int v = 0;
        if (val) { v = 1; }
        return this.push(name, DbParams.KindInt, "", v, 0.0);
    }

    /// <summary>Sets a column to SQL NULL.</summary>
    DbValues SetNull(string name) {
        return this.push(name, DbParams.KindNull, "", 0, 0.0);
    }

    DbValues push(string name, int kind, string t, int i, double d) {
        int at = this.IndexOf(name);
        if (at >= 0) {
            this.items[at] = new DbValue(name, kind, t, i, d);
            return this;
        }
        this.items.Add(new DbValue(name, kind, t, i, d));
        return this;
    }

    /// <summary>Number of columns present.</summary>
    int Count() { return this.items.Count; }

    /// <summary>Column name at index i.</summary>
    string NameAt(int i) { return this.items[i].name; }

    /// <summary>Value kind at index i (see DbParams.Kind*).</summary>
    int KindAt(int i) { return this.items[i].kind; }

    /// <summary>Index of a column, or -1.</summary>
    int IndexOf(string name) {
        for (int i = 0; i < this.items.Count; i = i + 1) {
            if (this.items[i].name == name) { return i; }
        }
        return 0 - 1;
    }

    /// <summary>True when the column is present.</summary>
    bool Has(string name) { return this.IndexOf(name) >= 0; }

    /// <summary>Drops a column, so it is left untouched by the write.</summary>
    DbValues Remove(string name) {
        int at = this.IndexOf(name);
        if (at >= 0) { this.items.RemoveAt(at); }
        return this;
    }

    /// <summary>Appends the value at index i to a parameter list, as given.
    /// </summary>
    void BindTo(DbParams ps, int i) {
        DbValue v = this.items[i];
        if (v.kind == DbParams.KindInt) { ps.AddInt(v.ival); }
        else if (v.kind == DbParams.KindDouble) { ps.AddDouble(v.dval); }
        else if (v.kind == DbParams.KindText) { ps.Add(v.text); }
        else { ps.AddNull(); }
    }

    /// <summary>Appends the value at index i converted to the column's
    /// declared kind (a DbParams.Kind* code), so a form that carries every
    /// field as text still binds an INTEGER column as a number. Values that
    /// cannot be converted raise an Exception naming the column, instead of
    /// reaching the database as a type error.</summary>
    void BindAs(DbParams ps, int i, int want) {
        DbValue v = this.items[i];
        if (v.kind == DbParams.KindNull || want == DbParams.KindNull ||
            want == v.kind) {
            this.BindTo(ps, i);
            return;
        }
        if (want == DbParams.KindInt) {
            if (v.kind == DbParams.KindDouble) {
                double d = v.dval;
                int r = (int)d;
                if ((double)r != d) { this.reject(v, "int"); }
                ps.AddInt(r);
                return;
            }
            ps.AddInt(this.parseInt(v));
            return;
        }
        if (want == DbParams.KindDouble) {
            if (v.kind == DbParams.KindInt) { ps.AddDouble((double)v.ival); return; }
            ps.AddDouble(this.parseDouble(v));
            return;
        }
        if (v.kind == DbParams.KindInt) { ps.Add(Convert.ToString(v.ival)); return; }
        ps.Add(Convert.ToString(v.dval));
    }

    int parseInt(DbValue v) {
        string t = v.text.Trim();
        if (t == "true") { return 1; }
        if (t == "false") { return 0; }
        int n = t.Length;
        if (n == 0) { this.reject(v, "int"); }
        int i = 0;
        int sign = 1;
        if (t[0] == 45) { sign = 0 - 1; i = 1; }
        else if (t[0] == 43) { i = 1; }
        if (i >= n) { this.reject(v, "int"); }
        int acc = 0;
        while (i < n) {
            int c = t[i] & 255;
            if (c < 48 || c > 57) { this.reject(v, "int"); }
            acc = acc * 10 + (c - 48);
            i = i + 1;
        }
        return acc * sign;
    }

    double parseDouble(DbValue v) {
        string t = v.text.Trim();
        if (t.Length == 0) { this.reject(v, "double"); }
        int i = 0;
        int n = t.Length;
        if (t[0] == 45 || t[0] == 43) { i = 1; }
        bool digit = false;
        bool dot = false;
        while (i < n) {
            int c = t[i] & 255;
            if (c >= 48 && c <= 57) { digit = true; }
            else if (c == 46 && !dot) { dot = true; }
            else { this.reject(v, "double"); }
            i = i + 1;
        }
        if (!digit) { this.reject(v, "double"); }
        return Convert.ToDouble(t);
    }

    void reject(DbValue v, string want) {
        throw new Exception("column " + v.name + ": cannot use \"" + v.text
            + "\" as " + want);
    }
}
