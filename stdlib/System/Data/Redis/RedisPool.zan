using System;
using System.Data;

namespace System.Data.Redis;

class RedisPool {
    string host;
    int port;
    int connectTimeoutMs;
    PoolCore<RedisClient> core;

    RedisPool(string host, int port, int maxSize) : this(host, port, maxSize, 3000) {
    }

    RedisPool(string host, int port, int maxSize, int connectTimeoutMs) {
        this.host = host;
        this.port = port;
        this.connectTimeoutMs = connectTimeoutMs;
        this.core = new PoolCore<RedisClient>(maxSize);
    }

    async RedisClient OpenOne() {
        RedisClient client = await RedisClient.ConnectAsync(
            this.host, this.port, this.connectTimeoutMs);
        if (client == null) { return null; }
        try {
            if (!await client.PingAsync()) {
                client.Close();
                return null;
            }
            return client;
        } catch {
            client.Close();
            return null;
        }
    }

    async RedisClient AcquireAsync() {
        while (true) {
            if (this.core.IsClosed()) { return null; }
            RedisClient pooled = this.core.TakeIdle();
            while (pooled != null) {
                if (pooled.IsConnected()) { return pooled; }
                this.core.Drop(pooled);
                pooled = this.core.TakeIdle();
            }
            // 上一次建连失败后退避：后端不可达时，若每次获取都重试建连，
            // 失败本身就成了每请求的固定开销（失败的本地 open 也要约
            // 125us），足以让命中路由的吞吐掉一个数量级。
            if (this.core.OpenBlocked()) {
                return null;
            }
            if (this.core.TryReserve()) {
                RedisClient opened = null;
                try {
                    opened = await this.OpenOne();
                } catch {
                    this.core.NoteOpenFailed();
                    this.core.UndoReserve();
                    return null;
                }
                if (opened == null || !opened.IsConnected()) {
                    this.core.NoteOpenFailed();
                    this.core.UndoReserve();
                    return null;
                }
                if (this.core.IsClosed()) {
                    opened.Close();
                    this.core.UndoReserve();
                    return null;
                }
                this.core.NoteOpenOk();
                this.core.Borrow(opened);
                return opened;
            }
            this.core.EnterWait();
            await this.core.Waiter().Wait();
            this.core.LeaveWait();
        }
        return null;
    }

    void Release(RedisClient client) {
        if (client == null) { return; }
        if (this.core.IsClosed() || !client.IsConnected()) {
            if (client.IsConnected()) { client.Close(); }
            this.core.Drop(client);
            return;
        }
        this.core.Pool(client);
    }

    int IdleCount() { return this.core.IdleCount(); }
    int LiveCount() { return this.core.LiveCount(); }
    int WaitingCount() { return this.core.WaitingCount(); }
    int MaxSize() { return this.core.MaxSize(); }
    bool IsClosed() { return this.core.IsClosed(); }

    void Close() {
        this.core.MarkClosed();
        RedisClient client = this.core.TakeIdle();
        while (client != null) {
            client.Close();
            this.core.Drop(client);
            client = this.core.TakeIdle();
        }
        this.core.WakeAll();
    }
}
