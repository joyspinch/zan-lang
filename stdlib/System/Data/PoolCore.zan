using System;
using System.Threading;

namespace System.Data;

/// <summary>
/// 所有驱动连接池共享的簿记数据：空闲列表、
/// 存活/等待计数器、唤醒闸门和关闭标志。驱动连接池
/// 只保留端点参数和自身的建连方式
/// （通常为协程），其余都委托到这里。
///
/// 核心本身从不直接接触连接——既不做活性探测，也
/// 不关闭任何连接——因此适用于任意连接类型，包括
/// 接口类型 <see cref="DbPool"/>。驱动连接池负责判断
/// 从空闲列表取出的连接是否仍可用，并报告结论
/// ——通过 <see cref="Pool"/> 或 <see cref="Drop"/>。
///
/// 连接池依赖每调度器单线程的协作模型：空闲
/// 列表只在 await 点之间被访问，因此无需加锁。停泊
/// 逻辑留在驱动连接池中——<c>EnterWait</c>、
/// <c>await core.Waiter().Wait()</c>、<c>LeaveWait</c>——因此挂起的协程
/// 正是调用方所等待的那个协程。
/// </summary>
class PoolCore<T> {
    int maxSize;
    List<T> idle;
    List<T> borrowed;   // 当前已借出、尚未归还的连接
    int liveCount;      // 已打开的连接总数（空闲 + 借出）
    int waiting;        // 当前停泊等待连接的协程数
    Gate gate;          // 面向等待者的事件驱动唤醒（取代轮询）
    bool closed;

    /// <summary>创建核心，存活连接数上限为 <paramref name="maxSize"/>
    /// （至少一个）。</summary>
    PoolCore(int maxSize) {
        if (maxSize < 1) {
            maxSize = 1;
        }
        this.maxSize = maxSize;
        this.idle = new List<T>();
        this.borrowed = new List<T>();
        this.liveCount = 0;
        this.waiting = 0;
        this.gate = new Gate();
        this.closed = false;
    }

    /// <summary>从空闲列表取出最近归还的连接，
    /// 列表为空时返回 null。调用方检查其是否仍可用，
    /// 对停泊期间已失效的连接调用 <see cref="Drop"/>
    /// （服务器重启、空闲超时）。</summary>
    T TakeIdle() {
        if (this.idle.Count == 0) {
            return null;
        }
        int last = this.idle.Count - 1;
        T c = this.idle[last];
        this.idle.RemoveAt(last);
        this.borrowed.Add(c);
        return c;
    }

    /// <summary>将可用连接放入空闲列表并唤醒一个等待者。
    /// 仅接受当前处于借出状态的连接，重复归还会被忽略。</summary>
    void Pool(T c) {
        if (!this.RemoveBorrowed(c)) {
            return;
        }
        this.idle.Add(c);
        if (this.waiting > 0) {
            this.gate.Signal();
        }
    }

    /// <summary>登记一条永久离开连接池的连接（关闭、
    /// 损坏或被驱逐）：释放其槽位，等待者可新建
    /// 连接顶替它。</summary>
    void Drop(T c) {
        this.RemoveBorrowed(c);
        if (this.liveCount > 0) {
            this.liveCount = this.liveCount - 1;
        }
        if (this.waiting > 0) {
            this.gate.Signal();
        }
    }

    /// <summary>记录新打开的连接已借出。在 <see cref="TryReserve"/>
    /// 预留槽位并成功打开后调用。</summary>
    void Borrow(T c) {
        this.borrowed.Add(c);
    }

    /// <summary>为即将打开的连接预留槽位。预先
    /// 预留可防止并发获取者同时判定
    /// 有空位而超出上限。</summary>
    bool TryReserve() {
        if (this.liveCount < this.maxSize) {
            this.liveCount = this.liveCount + 1;
            return true;
        }
        return false;
    }

    /// <summary>归还因打开失败而空出的槽位，并让等待者重试。</summary>
    void UndoReserve() {
        if (this.liveCount > 0) {
            this.liveCount = this.liveCount - 1;
        }
        if (this.waiting > 0) {
            this.gate.Signal();
        }
    }

    bool RemoveBorrowed(T c) {
        int i = 0;
        int n = this.borrowed.Count;
        while (i < n) {
            if (this.borrowed[i] == c) {
                this.borrowed.RemoveAt(i);
                return true;
            }
            i = i + 1;
        }
        return false;
    }

    /// <summary>连接池饱和时停泊获取者的闸门。其计数
    /// 语义加上调用方的复查循环，可保证不丢失唤醒。</summary>
    Gate Waiter() {
        return this.gate;
    }

    /// <summary>在协程 await 闸门之前，将其登记为停泊状态，
    /// 这样释放者就知道必须发信号唤醒。</summary>
    void EnterWait() {
        this.waiting = this.waiting + 1;
    }

    /// <summary>注销从闸门唤醒的协程。</summary>
    void LeaveWait() {
        this.waiting = this.waiting - 1;
    }

    /// <summary>空闲（已入池、立即可用）连接数。</summary>
    int IdleCount() {
        return this.idle.Count;
    }

    /// <summary>存活连接总数（空闲 + 借出）。</summary>
    int LiveCount() {
        return this.liveCount;
    }

    /// <summary>当前停泊等待连接的协程数。</summary>
    int WaitingCount() {
        return this.waiting;
    }

    /// <summary>最大并发存活连接数。</summary>
    int MaxSize() {
        return this.maxSize;
    }

    /// <summary>连接池关闭后为 true。</summary>
    bool IsClosed() {
        return this.closed;
    }

    /// <summary>标记连接池已关闭：获取者返回 null，归还的
    /// 连接将被销毁而不入池。</summary>
    void MarkClosed() {
        this.closed = true;
    }

    /// <summary>唤醒所有停泊的等待者；每个都会重新检查已关闭的池并
    /// 返回 null。</summary>
    void WakeAll() {
        int n = this.waiting;
        for (int k = 0; k < n; k = k + 1) {
            this.gate.Signal();
        }
    }
}
