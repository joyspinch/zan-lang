using System;
using System.Data.MySql;

namespace System.Data;

/// <summary>
/// FreeSQL 风格 ORM 支持的数据库 provider 类型。
///
/// 默认的 <see cref="DbConnection"/> 即可连接其中大多数引擎
/// 通过 its ODBC driver (the "对应的驱动"), so a single, dependency-light
/// 其连接类型服务于整个 ORM。另有原生、更高性能的驱动
/// 可供选择：
///   - System.Data.MySql：原生 MySQL/MariaDB 线协议（无需 ODBC；
///                           OpenMySQL 自动选用它，因为无需
///                           外部驱动）。
///   - System.Data.Sqlite：通过 sqlite3 C 库使用嵌入式 SQLite。
///   - System.Data.Postgres：PostgreSQL 及兼容 PG 线协议的引擎（openGauss、
///                           KingbaseES/人大金仓, Vastbase, GaussDB, QuestDB) via libpq.
///   - System.Data.TDengine：通过 taosAdapter REST API 访问 TDengine（无需任何客户端
///                           库）。
/// </summary>
class DbProvider {
    static int Unknown    = 0 - 1;  // 未到达服务器的失败
    static int ODBC       = 0;   // 通用 ODBC DSN / 连接字符串
    static int SQLite     = 1;
    static int MySQL      = 2;   // + MariaDB / TiDB / OceanBase / PolarDB-X
    static int PostgreSQL = 3;
    static int SqlServer  = 4;
    static int Oracle     = 5;
    static int ClickHouse = 7;
    static int QuestDB     = 8;
    static int Firebird   = 9;
    static int DuckDB     = 10;
    static int TDengine   = 11;
    static int MariaDB    = 12;
    static int Kingbase   = 13;  // 人大金仓 (PG-wire compatible)
    static int OpenGauss  = 14;  // openGauss / GaussDB（兼容 PG 线协议）
    static int DM          = 15;  // 达梦
}

/// <summary>
/// 基于平台 ODBC 驱动管理器的通用数据库连接
/// （Windows 为 odbc32，Linux/macOS 为 unixODBC）。
///
/// 任何提供 ODBC 驱动的引擎都可用：SQL Server、Oracle、
/// MySQL/MariaDB/TiDB/OceanBase、PostgreSQL、ClickHouse、QuestDB、Firebird 等。
/// DuckDB, TDengine, 达梦DM, SQLite, ... The convenience factories 下方 build
/// 只需正确的连接字符串；OpenODBC 接受任意 DSN 或驱动字符串。
///
/// 所有操作均支持协程，便于异步访问数据库。
///
/// 用法：
///   DbConnection db = DbConnection.OpenSqlServer("127.0.0.1", 1433,
///                          "app", "sa", "secret");
///   db.Execute("CREATE TABLE users (id INT PRIMARY KEY, name VARCHAR(64))");
///   db.Execute("INSERT INTO users (id, name) VALUES (1, 'Alice')");
///   DbResult result = db.Query("SELECT * FROM users");
///   db.Close();
///
///   DbConnection any = DbConnection.OpenODBC("DSN=mydsn;UID=u;PWD=p;");
/// </summary>
class DbConnection : IDbConnection {
    nint handle;       // ODBC 连接（dbc）句柄
    nint env;          // ODBC 环境句柄
    int provider;      // DbProvider.*
    string connectionString;
    bool connected;
    string lastError;

    // --- ODBC 驱动管理器 FFI ---
    // ODBC 管理器提供统一的基于缓冲区的 API（SQLGetData），因此一套
    // 实现即可服务所有提供 ODBC 驱动的引擎。
    #if WINDOWS
    [DllImport("odbc32")]
    static extern int SQLAllocHandle(int handleType, nint inputHandle, string outputHandle);

    [DllImport("odbc32")]
    static extern int SQLSetEnvAttr(nint env, int attr, nint valuePtr, int strLen);

    [DllImport("odbc32")]
    static extern int SQLDriverConnect(nint dbc, nint hwnd, string inConn, int inLen,
        string outConn, int outBufLen, string outLenPtr, int completion);

    [DllImport("odbc32")]
    static extern int SQLExecDirect(nint stmt, string sql, int textLength);

    [DllImport("odbc32")]
    static extern int SQLNumResultCols(nint stmt, string colCountPtr);

    [DllImport("odbc32")]
    static extern int SQLDescribeCol(nint stmt, int colNum, string colName, int bufLen,
        string nameLenPtr, string typePtr, string sizePtr, string decPtr, string nullPtr);

    [DllImport("odbc32")]
    static extern int SQLFetch(nint stmt);

    [DllImport("odbc32")]
    static extern int SQLGetData(nint stmt, int colNum, int targetType, string buf,
        int bufLen, string strLenOrIndPtr);

    [DllImport("odbc32")]
    static extern int SQLRowCount(nint stmt, string rowCountPtr);

    [DllImport("odbc32")]
    static extern int SQLFreeHandle(int handleType, nint handle);

    [DllImport("odbc32")]
    static extern int SQLDisconnect(nint dbc);

    [DllImport("odbc32")]
    static extern int SQLFreeStmt(nint stmt, int option);
    #else
    [DllImport("odbc")]
    static extern int SQLAllocHandle(int handleType, nint inputHandle, string outputHandle);

    [DllImport("odbc")]
    static extern int SQLSetEnvAttr(nint env, int attr, nint valuePtr, int strLen);

    [DllImport("odbc")]
    static extern int SQLDriverConnect(nint dbc, nint hwnd, string inConn, int inLen,
        string outConn, int outBufLen, string outLenPtr, int completion);

    [DllImport("odbc")]
    static extern int SQLExecDirect(nint stmt, string sql, int textLength);

    [DllImport("odbc")]
    static extern int SQLNumResultCols(nint stmt, string colCountPtr);

    [DllImport("odbc")]
    static extern int SQLDescribeCol(nint stmt, int colNum, string colName, int bufLen,
        string nameLenPtr, string typePtr, string sizePtr, string decPtr, string nullPtr);

    [DllImport("odbc")]
    static extern int SQLFetch(nint stmt);

    [DllImport("odbc")]
    static extern int SQLGetData(nint stmt, int colNum, int targetType, string buf,
        int bufLen, string strLenOrIndPtr);

    [DllImport("odbc")]
    static extern int SQLRowCount(nint stmt, string rowCountPtr);

    [DllImport("odbc")]
    static extern int SQLFreeHandle(int handleType, nint handle);

    [DllImport("odbc")]
    static extern int SQLDisconnect(nint dbc);

    [DllImport("odbc")]
    static extern int SQLFreeStmt(nint stmt, int option);
    #endif

    DbConnection() {
        this.handle = 0;
        this.env = 0;
        this.provider = DbProvider.ODBC;
        this.connectionString = "";
        this.connected = false;
        this.lastError = "";
    }

    // ============================================================
    // 指针 / 缓冲区辅助函数
    // ============================================================

    /// <summary>重建写入 out 缓冲区中的 64 位句柄/指针。
    /// 64 位平台上句柄为指针大小（8 字节），因此必须读回全部八个
    /// 小端字节。</summary>
    static nint HandleFromBuf(string p) {
        long v = 0;
        v = v + (p[0] & 255);
        v = v + ((long)(p[1] & 255) << 8);
        v = v + ((long)(p[2] & 255) << 16);
        v = v + ((long)(p[3] & 255) << 24);
        v = v + ((long)(p[4] & 255) << 32);
        v = v + ((long)(p[5] & 255) << 40);
        v = v + ((long)(p[6] & 255) << 48);
        v = v + ((long)(p[7] & 255) << 56);
        return (nint)v;
    }

    /// <summary>从 out 缓冲区读取 16 位小端值。</summary>
    static int Int16FromBuf(string p) {
        return (p[0] & 255) + ((p[1] & 255) << 8);
    }

    /// <summary>驱动填充的文本缓冲区中第一个 NUL 字节的索引。</summary>
    static int ScanNul(string buf, int max) {
        for (int i = 0; i < max; i = i + 1) {
            if (buf[i] == 0) { return i; }
        }
        return max;
    }

    /// <summary>将 NUL 结尾的 C 缓冲区复制为 Zan 字符串。</summary>
    static string BufToString(string buf, int max) {
        return buf.Substring(0, ScanNul(buf, max));
    }

    static bool OdbcSuccess(int rc) {
        return rc == 0 || rc == 1;
    }

    // ============================================================
    // 连接工厂
    // ============================================================

    /// <summary>用完整的 ODBC 连接字符串 / DSN 打开任意数据源。</summary>
    static DbConnection OpenODBC(string connectionString) {
        return OpenWith(connectionString, DbProvider.ODBC);
    }

    /// <summary>打开 Microsoft SQL Server。</summary>
    static DbConnection OpenSqlServer(string host, int port, string database,
            string user, string password) {
        string cs = "Driver={ODBC Driver 17 for SQL Server};Server=" + host
            + "," + Convert.ToString(port) + ";Database=" + database
            + ";UID=" + user + ";PWD=" + password + ";TrustServerCertificate=yes;";
        return OpenWith(cs, DbProvider.SqlServer);
    }

    /// <summary>打开 MySQL / MariaDB / TiDB / OceanBase。优先使用原生
    /// 线协议客户端（System.Data.MySql）——无需安装 ODBC 驱动，
    /// 不可用时回退到 ODBC 驱动。</summary>
    static IDbConnection OpenMySQL(string host, int port, string database,
            string user, string password) {
        MySqlSyncConnection native = MySqlSyncConnection.OpenParams(
            host, port, database, user, password);
        if (native != null && native.IsConnected()) {
            return native;
        }
        string cs = "Driver={MySQL ODBC 8.0 Unicode Driver};Server=" + host
            + ";Port=" + Convert.ToString(port) + ";Database=" + database
            + ";User=" + user + ";Password=" + password + ";";
        return OpenWith(cs, DbProvider.MySQL);
    }

    /// <summary>打开 MariaDB（默认使用原生 MySQL 协议）。</summary>
    static IDbConnection OpenMariaDB(string host, int port, string database,
            string user, string password) {
        return OpenMySQL(host, port, database, user, password);
    }

    /// <summary>通过 psqlODBC 驱动打开 PostgreSQL。</summary>
    static DbConnection OpenPostgreSQL(string host, int port, string database,
            string user, string password) {
        string cs = "Driver={PostgreSQL Unicode};Server=" + host
            + ";Port=" + Convert.ToString(port) + ";Database=" + database
            + ";Uid=" + user + ";Pwd=" + password + ";";
        return OpenWith(cs, DbProvider.PostgreSQL);
    }

    /// <summary>通过 PostgreSQL ODBC 驱动打开 openGauss / GaussDB。</summary>
    static DbConnection OpenOpenGauss(string host, int port, string database,
            string user, string password) {
        DbConnection c = OpenPostgreSQL(host, port, database, user, password);
        c.provider = DbProvider.OpenGauss;
        return c;
    }

    /// <summary>Opens KingbaseES / 人大金仓 via the PostgreSQL ODBC driver.</summary>
    static DbConnection OpenKingbase(string host, int port, string database,
            string user, string password) {
        DbConnection c = OpenPostgreSQL(host, port, database, user, password);
        c.provider = DbProvider.Kingbase;
        return c;
    }

    /// <summary>通过 PostgreSQL ODBC 驱动打开 QuestDB。</summary>
    static DbConnection OpenQuestDB(string host, int port, string user, string password) {
        DbConnection c = OpenPostgreSQL(host, port, "qdb", user, password);
        c.provider = DbProvider.QuestDB;
        return c;
    }

    /// <summary>打开 Oracle（dbq = host:port/service）。</summary>
    static DbConnection OpenOracle(string host, int port, string service,
            string user, string password) {
        string cs = "Driver={Oracle in OraClient};DBQ=" + host + ":"
            + Convert.ToString(port) + "/" + service
            + ";UID=" + user + ";PWD=" + password + ";";
        return OpenWith(cs, DbProvider.Oracle);
    }

    /// <summary>打开 Firebird（嵌入式或服务器模式）。</summary>
    static DbConnection OpenFirebird(string host, int port, string dbPath,
            string user, string password) {
        string cs = "Driver={Firebird/InterBase(r) driver};DBNAME=" + host
            + "/" + Convert.ToString(port) + ":" + dbPath
            + ";UID=" + user + ";PWD=" + password + ";";
        return OpenWith(cs, DbProvider.Firebird);
    }

    /// <summary>打开 ClickHouse。</summary>
    static DbConnection OpenClickHouse(string host, int port, string database,
            string user, string password) {
        string cs = "Driver={ClickHouse ODBC Driver (Unicode)};Server=" + host
            + ";Port=" + Convert.ToString(port) + ";Database=" + database
            + ";UID=" + user + ";PWD=" + password + ";";
        return OpenWith(cs, DbProvider.ClickHouse);
    }

    /// <summary>打开 TDengine。</summary>
    static DbConnection OpenTDengine(string host, int port, string database,
            string user, string password) {
        string cs = "Driver={TDengine};Server=" + host + ":"
            + Convert.ToString(port) + ";Database=" + database
            + ";UID=" + user + ";PWD=" + password + ";";
        return OpenWith(cs, DbProvider.TDengine);
    }

    /// <summary>打开 DuckDB 数据库（嵌入式 OLAP）。</summary>
    static DbConnection OpenDuckDB(string path) {
        string cs = "Driver={DuckDB Driver};Database=" + path + ";";
        return OpenWith(cs, DbProvider.DuckDB);
    }

    /// <summary>Opens 达梦 DM.</summary>
    static DbConnection OpenDM(string host, int port, string user, string password) {
        string cs = "Driver={DM ODBC DRIVER};Server=" + host + ":"
            + Convert.ToString(port) + ";UID=" + user + ";PWD=" + password + ";";
        return OpenWith(cs, DbProvider.DM);
    }

    /// <summary>通过 SQLite ODBC 驱动打开 SQLite 文件。
    /// 如需免依赖的嵌入式访问，请使用 System.Data.Sqlite.SqliteConnection。</summary>
    static DbConnection OpenSQLite(string path) {
        string cs = "Driver={SQLite3 ODBC Driver};Database=" + path + ";";
        return OpenWith(cs, DbProvider.SQLite);
    }

    static DbConnection OpenWith(string connectionString, int provider) {
        DbConnection conn = new DbConnection();
        conn.provider = provider;
        conn.connectionString = connectionString;

        // 分配环境句柄（SQL_HANDLE_ENV = 1）。
        byte[] pEnv = new byte[8];
        int rc = SQLAllocHandle(1, 0, pEnv);
        if (!OdbcSuccess(rc)) {
            conn.lastError = "SQLAllocHandle(ENV) failed";
            return conn;
        }
        nint envH = HandleFromBuf(pEnv);

        // SQL_ATTR_ODBC_VERSION = 200, SQL_OV_ODBC3 = 3.
        rc = SQLSetEnvAttr(envH, 200, 3, 0);
        if (!OdbcSuccess(rc)) {
            SQLFreeHandle(1, envH);
            conn.lastError = "SQLSetEnvAttr failed";
            return conn;
        }

        // 分配连接句柄（SQL_HANDLE_DBC = 2）。
        byte[] pDbc = new byte[8];
        rc = SQLAllocHandle(2, envH, pDbc);
        if (!OdbcSuccess(rc)) {
            SQLFreeHandle(1, envH);
            conn.lastError = "SQLAllocHandle(DBC) failed";
            return conn;
        }
        nint dbcH = HandleFromBuf(pDbc);

        // 建立连接。SQL_NTS = -3、SQL_DRIVER_NOPROMPT = 0。
        byte[] outConn = new byte[1024];
        byte[] pOutLen = new byte[8];
        rc = SQLDriverConnect(dbcH, 0, connectionString, -3, outConn, 1024, pOutLen, 0);

        if (OdbcSuccess(rc)) {
            conn.env = envH;
            conn.handle = dbcH;
            conn.connected = true;
        } else {
            SQLFreeHandle(2, dbcH);
            SQLFreeHandle(1, envH);
            conn.lastError = "SQLDriverConnect failed";
        }
        return conn;
    }

    // ============================================================
    // 执行 / 查询
    // ============================================================

    /// <summary>分配语句句柄（SQL_HANDLE_STMT = 3）；失败时返回 0。</summary>
    nint AllocStmt() {
        byte[] pStmt = new byte[8];
        int rc = SQLAllocHandle(3, this.handle, pStmt);
        if (!OdbcSuccess(rc)) { return 0; }
        nint stmt = HandleFromBuf(pStmt);
        return stmt;
    }

    /// <summary>执行非查询语句（INSERT/UPDATE/DELETE/DDL）。</summary>
    int Execute(string sql) {
        if (!this.connected) { return -1; }
        nint stmt = AllocStmt();
        if (stmt == 0) { this.lastError = "SQLAllocHandle(STMT) failed"; return -1; }

        int rc = SQLExecDirect(stmt, sql, -3);   // SQL_NTS
        if (!OdbcSuccess(rc)) {
            this.lastError = "SQLExecDirect failed";
            SQLFreeHandle(3, stmt);
            return -1;
        }

        byte[] pRows = new byte[8];
        SQLRowCount(stmt, pRows);
        int affected = (int)HandleFromBuf(pRows);

        SQLFreeHandle(3, stmt);
        return affected;
    }

    /// <summary>执行非查询语句（包装方法：ODBC 为同步操作）。</summary>
    async int ExecuteAsync(string sql) {
        return Execute(sql);
    }

    async int ExecuteAsync(string sql, DbParams prms) {
        return Execute(sql, prms);
    }

    /// <summary>执行查询并返回结果集。</summary>
    DbResult Query(string sql) {
        if (!this.connected) { return DbResult.Empty(); }
        DbResult result = new DbResult();
        nint stmt = AllocStmt();
        if (stmt == 0) { this.lastError = "SQLAllocHandle(STMT) failed"; return result; }

        int rc = SQLExecDirect(stmt, sql, -3);   // SQL_NTS
        if (!OdbcSuccess(rc)) {
            this.lastError = "SQLExecDirect failed";
            SQLFreeHandle(3, stmt);
            return result;
        }

        byte[] pcc = new byte[4];
        SQLNumResultCols(stmt, pcc);
        int colCount = Int16FromBuf(pcc);
        result.SetColumnCount(colCount);

        int c = 0;
        for (; c < colCount; c = c + 1) {
            byte[] nameBuf = new byte[256];
            byte[] pNameLen = new byte[4];
            byte[] pType = new byte[4];
            byte[] pSize = new byte[8];
            byte[] pDec = new byte[4];
            byte[] pNull = new byte[4];
            SQLDescribeCol(stmt, c + 1, nameBuf, 256, pNameLen, pType, pSize, pDec, pNull);
            result.AddColumnName(BufToString(nameBuf, 256));
        }

        // SQL_SUCCESS = 0, SQL_SUCCESS_WITH_INFO = 1, SQL_NO_DATA = 100.
        int fr = SQLFetch(stmt);
        while (fr == 0 || fr == 1) {
            List<string> row = new List<string>();
            c = 0;
            while (c < colCount) {
                byte[] buf = new byte[4096];
                byte[] pInd = new byte[8];
                int g = SQLGetData(stmt, c + 1, 1, buf, 4096, pInd);   // SQL_C_CHAR = 1
                if (g == 100) {
                    row.Add("");
                } else {
                    row.Add(BufToString(buf, 4096));
                }
                c = c + 1;
            }
            result.AddRow(row);
            fr = SQLFetch(stmt);
        }

        SQLFreeStmt(stmt, 0);        // SQL_CLOSE
        SQLFreeHandle(3, stmt);
        return result;
    }

    /// <summary>执行查询（包装方法：ODBC 为同步操作）。</summary>
    async DbResult QueryAsync(string sql) {
        return Query(sql);
    }

    async DbResult QueryAsync(string sql, DbParams prms) {
        return Query(sql, prms);
    }

    /// <summary>执行标量查询（以字符串形式返回第一行第一列）。</summary>
    string ExecuteScalar(string sql) {
        DbResult result = Query(sql);
        if (result.RowCount() > 0) {
            return result.GetString(0, 0);
        }
        return "";
    }

    string ExecuteScalar(string sql, DbParams prms) {
        DbResult result = Query(sql, prms);
        if (result.RowCount() > 0) {
            return result.GetString(0, 0);
        }
        return "";
    }

    /// <summary>执行标量查询（包装方法：ODBC 为同步操作）。</summary>
    async string ExecuteScalarAsync(string sql) {
        return ExecuteScalar(sql);
    }

    async string ExecuteScalarAsync(string sql, DbParams prms) {
        return ExecuteScalar(sql, prms);
    }

    async bool BeginTransactionAsync() { this.BeginTransaction(); return true; }
    async bool CommitAsync() { this.Commit(); return true; }
    async bool RollbackAsync() { this.Rollback(); return true; }

    /// <summary>获取此连接记录的最后一条错误信息。</summary>
    string GetError() {
        return this.lastError;
    }

    /// <summary>开始事务。</summary>
    void BeginTransaction() {
        Execute("BEGIN");
    }

    /// <summary>提交当前事务。</summary>
    void Commit() {
        Execute("COMMIT");
    }

    /// <summary>回滚当前事务。</summary>
    void Rollback() {
        Execute("ROLLBACK");
    }

    /// <summary>关闭数据库连接。</summary>
    void Close() {
        if (this.connected) {
            SQLDisconnect(this.handle);
            SQLFreeHandle(2, this.handle);   // SQL_HANDLE_DBC
            SQLFreeHandle(1, this.env);      // SQL_HANDLE_ENV
            this.connected = false;
            this.handle = 0;
            this.env = 0;
        }
    }

    /// <summary>返回连接是否打开。</summary>
    bool IsConnected() {
        return this.connected;
    }

    /// <summary>返回 provider 类型。</summary>
    int GetProvider() {
        return this.provider;
    }

    /// <summary>执行带参数的非查询语句。ODBC 路径没有
    /// 统一的参数绑定接口，因此 `?` 占位符在执行前经加引号和转义
    /// 后内联进 SQL。</summary>
    int Execute(string sql, DbParams prms) {
        return Execute(InlineParams(sql, prms));
    }

    /// <summary>执行带参数的查询（ODBC 路径上参数的绑定方式
    /// 参见 Execute 重载）。</summary>
    DbResult Query(string sql, DbParams prms) {
        return Query(InlineParams(sql, prms));
    }

    /// <summary>将 `?` 占位符（引号字面量之外的）替换为
    /// 加引号并转义后的参数值。</summary>
    static string InlineParams(string sql, DbParams prms) {
        if (prms.Count() == 0) { return sql; }
        StringBuilder sb = new StringBuilder();
        int n = sql.Length;
        int next = 0;
        bool inQuote = false;
        for (int i = 0; i < n; i = i + 1) {
            int c = sql[i] & 255;
            if (c == 39) {                       // '
                inQuote = !inQuote;
                sb.Append("'");
            } else if (c == 63 && !inQuote && next < prms.Count()) {   // ?
                if (prms.IsNull(next)) {
                    sb.Append("NULL");
                } else {
                    sb.Append("'");
                    sb.Append(EscapeSqlString(prms.AsText(next)));
                    sb.Append("'");
                }
                next = next + 1;
            } else {
                sb.Append(sql.Substring(i, 1));
            }
        }
        return sb.ToString();
    }

    /// <summary>转义字符串中的单引号以保证 SQL 安全。</summary>
    static string EscapeSqlString(string val) {
        StringBuilder sb = new StringBuilder();
        int len = val.Length;
        for (int i = 0; i < len; i = i + 1) {
            string ch = val.Substring(i, 1);
            if (ch == "'") {
                sb.Append("''");
            } else {
                sb.Append(ch);
            }
        }
        return sb.ToString();
    }
}
