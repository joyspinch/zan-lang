using System;
using System.Threading;

namespace System.Data;

/// <summary>
/// Driver-agnostic, coroutine-aware connection pool.
///
/// Connections are opened lazily through an <see cref="IDbConnector"/> up to
/// <c>maxSize</c> and reused across coroutines. When every connection is
/// checked out and the cap is reached, <see cref="AcquireAsync"/> suspends the
/// calling coroutine on an event-driven <see cref="Gate"/> (no polling, no
/// timer) instead of blocking the worker thread, and is resumed the moment a
/// connection comes back through <see cref="Release"/>. A connection that has
/// died is evicted rather than pooled, freeing its slot for a waiter.
///
/// The pool relies on the cooperative single-thread-per-scheduler model: the
/// free-list is only touched between await points, so no lock is required.
///
/// Usage:
///   DbPool pool = SqliteConnector.Pool("app.sqlite3", 8);
///   IDbConnection db = await pool.AcquireAsync();
///   DbResult r = db.Query("SELECT * FROM users");
///   pool.Release(db);
///   pool.Close();
///
/// Drivers whose queries are themselves coroutines (MySQL, PostgreSQL) also
/// ship a typed pool -- <c>MySqlPool</c>, <c>PgPool</c> -- returning the
/// concrete connection so <c>QueryAsync</c> stays reachable.
/// </summary>
class DbPool {
    IDbConnector connector;
    PoolCore<IDbConnection> core;

    DbPool(IDbConnector connector, int maxSize) {
        this.connector = connector;
        this.core = PoolCore<IDbConnection>.Create(maxSize);
    }

    /// <summary>Creates a pool that opens at most <paramref name="maxSize"/>
    /// connections through <paramref name="connector"/>.</summary>
    static DbPool Create(IDbConnector connector, int maxSize) {
        return new DbPool(connector, maxSize);
    }

    async IDbConnection OpenOne() {
        return await this.connector.ConnectAsync();
    }

    /// <summary>Checks out a connection: reuses an idle one, opens a new one if
    /// under the cap, otherwise suspends the coroutine until one is released.
    /// Returns null once the pool has been closed.</summary>
    async IDbConnection AcquireAsync() {{
        while (true) {{
            if (this.core.IsClosed()) {{
                return null;
            }}
            IDbConnection pooled = this.core.TakeIdle();
            while (pooled != null) {{
                // A connection can rot while parked (server restart, idle
                // timeout): evict it and free its slot for a waiter.
                if (pooled.IsConnected()) {{
                    return pooled;
                }}
                this.core.Drop();
                pooled = this.core.TakeIdle();
            }}
            if (this.core.TryReserve()) {{
                IDbConnection opened = await this.OpenOne();
                if (opened == null || !opened.IsConnected()) {{
                    this.core.UndoReserve();
                }}
                return opened;
            }}
            // Pool saturated: park until a connection is released.
            this.core.EnterWait();
            await this.core.Waiter().Wait();
            this.core.LeaveWait();
        }}
        return null;
    }}

    /// <summary>Returns a connection to the pool. A broken or post-Close()
    /// connection is closed and dropped instead of being pooled.</summary>
    void Release(IDbConnection c) {{
        if (c == null) {{
            return;
        }}
        if (this.core.IsClosed() || !c.IsConnected()) {{
            if (c.IsConnected()) {{
                c.Close();
            }}
            this.core.Drop();
            return;
        }}
        this.core.Pool(c);
    }}

    /// <summary>Number of idle (pooled, ready-to-use) connections.</summary>
    int IdleCount() {{
        return this.core.IdleCount();
    }}

    /// <summary>Total live connections (idle + checked out).</summary>
    int LiveCount() {{
        return this.core.LiveCount();
    }}

    /// <summary>Coroutines currently parked waiting for a connection.</summary>
    int WaitingCount() {
        return this.core.WaitingCount();
    }

    /// <summary>Maximum number of concurrently live connections.</summary>
    int MaxSize() {
        return this.core.MaxSize();
    }

    /// <summary>True once <see cref="Close"/> has run.</summary>
    bool IsClosed() {
        return this.core.IsClosed();
    }

    /// <summary>The <see cref="DbProvider"/> id served by this pool.</summary>
    int GetProvider() {
        return this.connector.GetProvider();
    }

    /// <summary>Closes all idle connections and marks the pool closed. Connections
    /// still checked out are closed when they are released.</summary>
    void Close() {{
        this.core.MarkClosed();
        IDbConnection c = this.core.TakeIdle();
        while (c != null) {{
            c.Close();
            this.core.Drop();
            c = this.core.TakeIdle();
        }}
        this.core.WakeAll();
    }}
}}
