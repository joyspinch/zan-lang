using System;
using System.Data;
using System.Threading;

namespace System.Data.Sqlite;

/// <summary>
/// Coroutine-aware connection pool for <see cref="SqliteConnection"/>.
///
/// SQLite is an embedded, file-based engine — there is no network socket to
/// wait on, so a query cannot be made "async" in the reactor sense. What this
/// pool provides is coroutine-aware *lifecycle* management: connections are
/// reused instead of being opened/closed per request, and the number of
/// concurrently checked-out connections is capped. When the pool is at
/// capacity, <see cref="AcquireAsync"/> suspends the calling coroutine on an
/// event-driven <see cref="Gate"/> (no polling) instead of blocking the worker
/// thread, so other coroutines keep running until a connection is returned with
/// <see cref="Release"/>.
///
/// The pool relies on the cooperative single-thread-per-scheduler model: the
/// free-list is only touched between await points, so no lock is required.
///
/// Usage:
///   SqlitePool pool = new SqlitePool("app.sqlite3", 8);
///   SqliteConnection db = await pool.AcquireAsync();
///   DbResult r = db.Query("SELECT * FROM users");
///   pool.Release(db);
///   pool.Close();
/// </summary>
class SqlitePool {
    string filename;
    PoolCore<SqliteConnection> core;

    SqlitePool(string filename, int maxSize) {
        this.filename = filename;
        this.core = new PoolCore<SqliteConnection>(maxSize);
    }

    /// <summary>Opening a SQLite database is a local, non-blocking call; the
    /// coroutine shape keeps the acquire path identical to the network drivers'.</summary>
    async SqliteConnection OpenOne() {
        return SqliteConnection.Open(this.filename);
    }

    /// <summary>Checks out a connection: reuses an idle one, opens a new one if
    /// under the cap, otherwise suspends the coroutine until one is released.
    /// Returns null once the pool has been closed.</summary>
    async SqliteConnection AcquireAsync() {{
        while (true) {{
            if (this.core.IsClosed()) {{
                return null;
            }}
            SqliteConnection pooled = this.core.TakeIdle();
            while (pooled != null) {{
                // A connection can rot while parked (server restart, idle
                // timeout): evict it and free its slot for a waiter.
                if (pooled.IsConnected()) {{
                    return pooled;
                }}
                this.core.Drop();
                pooled = this.core.TakeIdle();
            }}
            if (this.core.TryReserve()) {{
                SqliteConnection opened = await this.OpenOne();
                if (opened == null || !opened.IsConnected()) {{
                    this.core.UndoReserve();
                }}
                return opened;
            }}
            // Pool saturated: park until a connection is released.
            this.core.EnterWait();
            await this.core.Waiter().Wait();
            this.core.LeaveWait();
        }}
        return null;
    }}

    /// <summary>Returns a connection to the pool. A broken or post-Close()
    /// connection is closed and dropped instead of being pooled.</summary>
    void Release(SqliteConnection c) {{
        if (c == null) {{
            return;
        }}
        if (this.core.IsClosed() || !c.IsConnected()) {{
            if (c.IsConnected()) {{
                c.Close();
            }}
            this.core.Drop();
            return;
        }}
        this.core.Pool(c);
    }}

    /// <summary>Number of idle (pooled, ready-to-use) connections.</summary>
    int IdleCount() {{
        return this.core.IdleCount();
    }}

    /// <summary>Total live connections (idle + checked out).</summary>
    int LiveCount() {{
        return this.core.LiveCount();
    }}

    /// <summary>Closes all idle connections and marks the pool closed. Connections
    /// still checked out are closed when they are released.</summary>
    void Close() {{
        this.core.MarkClosed();
        SqliteConnection c = this.core.TakeIdle();
        while (c != null) {{
            c.Close();
            this.core.Drop();
            c = this.core.TakeIdle();
        }}
        this.core.WakeAll();
    }}
}}
