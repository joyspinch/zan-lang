using System;
using System.Data;
using System.Threading;

namespace System.Data.Sqlite;

/// <summary>
/// 为 <see cref="SqliteConnection"/> 设计的协程感知连接池。
///
/// SQLite 是嵌入式的基于文件的引擎，没有网络 socket 可等待，
/// 因此查询无法在 reactor 意义上"异步"。这个连接池提供的是
/// 协程感知的生命周期管理：连接被复用，
/// 而不是每次请求都新建/关闭，并发借出的
/// 连接数也有上限。当池满时，
/// <see cref="AcquireAsync"/> 让调用协程挂起在
/// 事件驱动的 <see cref="Gate"/> 上（不轮询），而不是阻塞 worker 线程，
/// 所以其他协程可以继续运行，直到有连接通过
/// <see cref="Release"/> 归还。
///
/// 该池依赖每个 scheduler 单线程的协作模型：
/// free-list 只在 await 点之间被访问，因此无需加锁。
///
/// 用法：
///   SqlitePool pool = new SqlitePool("app.sqlite3", 8);
///   SqliteConnection db = await pool.AcquireAsync();
///   DbResult r = db.Query("SELECT * FROM users");
///   pool.Release(db);
///   pool.Close();
/// </summary>
class SqlitePool {
    string filename;
    PoolCore<SqliteConnection> core;

    SqlitePool(string filename, int maxSize) {
        this.filename = filename;
        this.core = new PoolCore<SqliteConnection>(maxSize);
    }

    /// <summary>打开 SQLite 数据库是本地非阻塞调用；
    /// 协程形态让获取连接的过程与网络驱动一致。</summary>
    async SqliteConnection OpenOne() {
        return SqliteConnection.Open(this.filename);
    }

    /// <summary>借出一个连接：复用空闲连接，未达上限则新建，
    /// 否则挂起协程，直到有连接被归还。
    /// 池已关闭后返回 null。</summary>
    async SqliteConnection AcquireAsync() {
        while (true) {
            if (this.core.IsClosed()) {
                return null;
            }
            SqliteConnection pooled = this.core.TakeIdle();
            while (pooled != null) {
                // 连接在停放期间可能失效（服务器重启、空闲超时），
                // 将其逐出，把位置让给等待者。
                if (pooled.IsConnected()) {
                    return pooled;
                }
                this.core.Drop(pooled);
                pooled = this.core.TakeIdle();
            }
            if (this.core.TryReserve()) {
                SqliteConnection opened = await this.OpenOne();
                if (opened == null || !opened.IsConnected()) {
                    this.core.UndoReserve();
                    return null;
                }
                this.core.Borrow(opened);
                return opened;
            }
            // 连接池已满：挂起等待连接被归还。
            this.core.EnterWait();
            await this.core.Waiter().Wait();
            this.core.LeaveWait();
        }
        return null;
    }

    /// <summary>将连接归还给池。已损坏或 Close() 之后的
    /// 连接会被直接关闭丢弃，不再入池。</summary>
    void Release(SqliteConnection c) {
        if (c == null) {
            return;
        }
        if (this.core.IsClosed() || !c.IsConnected()) {
            if (c.IsConnected()) {
                c.Close();
            }
            this.core.Drop(c);
            return;
        }
        this.core.Pool(c);
    }

    /// <summary>空闲（已入池、可用）连接数。</summary>
    int IdleCount() {
        return this.core.IdleCount();
    }

    /// <summary>存活连接总数（空闲 + 已借出）。</summary>
    int LiveCount() {
        return this.core.LiveCount();
    }

    /// <summary>关闭所有空闲连接并将池标记为已关闭。
    /// 仍借出的连接会在归还时被关闭。</summary>
    void Close() {
        this.core.MarkClosed();
        SqliteConnection c = this.core.TakeIdle();
        while (c != null) {
            c.Close();
            this.core.Drop(c);
            c = this.core.TakeIdle();
        }
        this.core.WakeAll();
    }
}
