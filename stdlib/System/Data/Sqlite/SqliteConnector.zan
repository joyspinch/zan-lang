using System;
using System.Data;

namespace System.Data.Sqlite;

/// <summary>
/// <see cref="IDbConnector"/> for the bundled SQLite driver.
///
/// SQLite is embedded: opening a database and running a statement are library
/// calls, not IO on the reactor, so pooling here means connection reuse plus a
/// cap on concurrent connections with coroutine (not thread) waiting.
///
/// Usage:
///   DbPool pool = SqliteConnector.Pool("app.sqlite3", 8);
///   IDbConnection db = await pool.AcquireAsync();
///   DbResult r = db.Query("SELECT * FROM users");
///   pool.Release(db);
///
/// <see cref="SqlitePool"/> is the equivalent typed pool, handing back a
/// <see cref="SqliteConnection"/> with the SQLite-only members
/// (LastInsertId, transactions).
/// </summary>
class SqliteConnector : IDbConnector {
    string filename;

    SqliteConnector(string filename) {
        this.filename = filename;
    }

    /// <summary>Pool of connections to <paramref name="filename"/>.</summary>
    static DbPool Pool(string filename, int maxSize) {
        return new DbPool(new SqliteConnector(filename), maxSize);
    }

    async IDbConnection ConnectAsync() {
        return SqliteConnection.Open(this.filename);
    }

    int GetProvider() {
        return DbProvider.SQLite;
    }
}
