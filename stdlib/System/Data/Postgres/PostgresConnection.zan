using System;
using System.Data;
using System.Net.Sockets;
using System.Text;

namespace System.Data.Postgres;

/// <summary>
/// 通过 libpq 的原生 PostgreSQL 连接，同样适用于 PG wire 兼容的
/// engines: openGauss / GaussDB, KingbaseES (人大金仓), Vastbase and QuestDB.
///
/// libpq 提供按单元格的文本取值器（PQgetvalue -> char*），可干净地映射
/// 到 Zan 字符串，无需手动做缓冲区编组。需要
/// 在构建/运行时提供 libpq 共享库。
///
/// 用法：
///   PostgresConnection db = PostgresConnection.Open(
///       "host=127.0.0.1 port=5432 dbname=app user=postgres password=secret");
///   db.Execute("CREATE TABLE users (id SERIAL PRIMARY KEY, name TEXT)");
///   DbResult r = db.Query("SELECT * FROM users");
///   db.Close();
///
/// 参数化（推荐做法——值从不进入 SQL 文本；`?`
/// 占位符会转换为 libpq 的 $1..$n 形式）：
///   db.Execute("INSERT INTO users (name) VALUES (?)", new DbParams().Add(name));
///   DbResult r = db.Query("SELECT * FROM users WHERE name = ?",
///       new DbParams().Add(name));
/// </summary>
class PgConnection : IDbConnection {
    nint handle;     // PGconn*
    bool connected;
    string lastError;

    [DllImport("libpq")]
    static extern nint PQconnectdb(string conninfo); // -> PGconn*

    [DllImport("libpq")]
    static extern int PQstatus(nint conn); // 0 == CONNECTION_OK

    [DllImport("libpq")]
    static extern string PQerrorMessage(nint conn);

    [DllImport("libpq")]
    static extern void PQfinish(nint conn);

    [DllImport("libpq")]
    static extern nint PQexec(nint conn, string query); // -> PGresult*

    [DllImport("libpq")]
    static extern int PQresultStatus(nint res); // 1=CMD_OK, 2=TUPLES_OK

    [DllImport("libpq")]
    static extern int PQntuples(nint res);

    [DllImport("libpq")]
    static extern int PQnfields(nint res);

    [DllImport("libpq")]
    static extern string PQfname(nint res, int col);

    [DllImport("libpq")]
    static extern string PQgetvalue(nint res, int row, int col);

    [DllImport("libpq")]
    static extern int PQgetisnull(nint res, int row, int col);

    [DllImport("libpq")]
    static extern string PQcmdTuples(nint res); // 受影响行数（文本形式）

    [DllImport("libpq")]
    static extern void PQclear(nint res);

    [DllImport("libpq")]
    static extern nint PQexecParams(nint conn, string command, int nParams,
        nint paramTypes, nint paramValues, nint paramLengths, nint paramFormats,
        int resultFormat);   // -> PGresult*

    [DllImport("libpq")]
    static extern int PQsendQueryParams(nint conn, string command, int nParams,
        nint paramTypes, nint paramValues, nint paramLengths, nint paramFormats,
        int resultFormat);   // 1 = ok, 0 = fail


    [DllImport("crt")]
    static extern nint memcpy(string dest, string src, long n); // 返回 dest 指针

    // ---- 非阻塞（异步）libpq 入口 ----
    [DllImport("libpq")]
    static extern nint PQconnectStart(string conninfo); // -> PGconn*（异步连接）

    [DllImport("libpq")]
    static extern int PQconnectPoll(nint conn); // PGRES_POLLING_*: 0 fail,1 read,2 write,3 ok

    [DllImport("libpq")]
    static extern int PQsocket(nint conn); // 底层套接字 fd（无则为 -1）

    [DllImport("libpq")]
    static extern int PQsetnonblocking(nint conn, int arg);// 0 = ok

    [DllImport("libpq")]
    static extern int PQsendQuery(nint conn, string query);// 1 = ok, 0 = fail

    [DllImport("libpq")]
    static extern int PQflush(nint conn); // 0 完成，1 还有待发送，-1 出错

    [DllImport("libpq")]
    static extern int PQconsumeInput(nint conn); // 1 = ok, 0 = error

    [DllImport("libpq")]
    static extern int PQisBusy(nint conn); // 1 = 忙（结果未就绪）

    [DllImport("libpq")]
    static extern nint PQgetResult(nint conn); // -> PGresult*（没有更多时为 0）

    /// <summary>
    /// 将 libpq 返回的 C 字符串复制成由 ARC 管理的自有 Zan
    /// 字符串。PQgetvalue/PQfname/PQerrorMessage 返回指向
    /// PGresult/PGconn 缓冲区的指针，PQclear()（或下一次 libpq 调用）会
    /// 使其失效；直接保存会让结果集或
    /// lastError 指向已释放的内存。与 "" 拼接可在源指针仍有效时
    /// 分配一份新的托管副本。
    /// </summary>
    static string CopyText(string s) {
        return "" + s;
    }

    /// <summary>将 `?` 占位符（SQL 结构位置）改写为 libpq 的
    /// 位置参数 $1..$n 形式，使所有驱动统一使用 `?` 语法。
    /// 上下文感知：字符串字面量、转义引号、双引号标识符、
    /// 行/块注释以及美元引用（$$..$$ / $tag$..$tag$）内部的
    /// `?` 一律原样保留——此前无脑改写，
    /// SELECT * FROM t WHERE note = 'a?b' 会变成 $1 参数错位、
    /// 注释里的示例 SQL 直接破坏语句。</summary>
    static string ToDollarParams(string sql) {
        StringBuilder sb = new StringBuilder();
        int n = sql.Length;
        int next = 1;
        int i = 0;
        while (i < n) {
            int c = sql[i] & 255;
            if (c == 45 && i + 1 < n && (sql[i + 1] & 255) == 45) {
                // 行注释：-- 直到换行。
                while (i < n && (sql[i] & 255) != 10) {
                    sb.Append(sql.Substring(i, 1));
                    i = i + 1;
                }
                continue;
            }
            if (c == 47 && i + 1 < n && (sql[i + 1] & 255) == 42) {
                // 块注释：/* .. */（未闭合则吞到末尾）。
                while (i < n) {
                    sb.Append(sql.Substring(i, 1));
                    bool closed = (sql[i] & 255) == 42 && i + 1 < n
                        && (sql[i + 1] & 255) == 47;
                    i = i + 1;
                    if (closed) { sb.Append("/"); i = i + 1; break; }
                }
                continue;
            }
            if (c == 39 || c == 34) {
                // 引号区域（'..' 字符串含 '' 转义；".." 标识符）。
                int q = c;
                sb.Append(sql.Substring(i, 1));
                i = i + 1;
                while (i < n) {
                    int d = sql[i] & 255;
                    sb.Append(sql.Substring(i, 1));
                    i = i + 1;
                    if (d == q) {
                        if (q == 39 && i < n && (sql[i] & 255) == 39) {
                            sb.Append("'");       // '' 转义
                            i = i + 1;
                        } else {
                            break;
                        }
                    }
                }
                continue;
            }
            if (c == 36) {
                // 美元引用：$ 后跟 [A-Za-z0-9_]* 再跟 $ 即开标签；
                // 找不到闭合标签就按开标签吞到串尾。
                int j = i + 1;
                while (j < n) {
                    int d = sql[j] & 255;
                    bool tagch = (d >= 48 && d <= 57) || (d >= 65 && d <= 90)
                        || (d >= 97 && d <= 122) || d == 95;
                    if (!tagch) { break; }
                    j = j + 1;
                }
                if (j < n && (sql[j] & 255) == 36) {
                    string opener = sql.Substring(i, j - i + 1);
                    int end = sql.IndexOf(opener, j + 1);
                    int stop = end < 0 ? n : end + opener.Length;
                    while (i < stop) {
                        sb.Append(sql.Substring(i, 1));
                        i = i + 1;
                    }
                    continue;
                }
                sb.Append(sql.Substring(i, 1));
                i = i + 1;
                continue;
            }
            if (c == 63) {                        // ?
                sb.Append("$");
                sb.Append(Convert.ToString(next));
                next = next + 1;
                i = i + 1;
                continue;
            }
            sb.Append(sql.Substring(i, 1));
            i = i + 1;
        }
        return sb.ToString();
    }

    /// <summary>为 PQexecParams 构建 char** paramValues 块：一个
    /// 指向各值 NUL 结尾副本的指针数组（SQL NULL 用 0）。
    /// 值缓冲区会追加到 keepAlive 中，调用方须保证其在
    /// libpq 调用返回前一直存活。</summary>
    static byte[] BuildParamBlock(DbParams prms, List<byte[]> keepAlive) {
        int n = prms.Count();
        byte[] block = new byte[n * 8 + 8];
        for (int i = 0; i < n; i = i + 1) {
            nint p = 0;
            if (!prms.IsNull(i)) {
                string t = prms.AsText(i);
                byte[] buf = new byte[t.Length + 1];
                p = memcpy(buf, t, t.Length);
                keepAlive.Add(buf);
            }
            int off = i * 8;
            block[off] = (byte)(p & 255);
            block[off + 1] = (byte)((p >> 8) & 255);
            block[off + 2] = (byte)((p >> 16) & 255);
            block[off + 3] = (byte)((p >> 24) & 255);
            block[off + 4] = (byte)((p >> 32) & 255);
            block[off + 5] = (byte)((p >> 40) & 255);
            block[off + 6] = (byte)((p >> 48) & 255);
            block[off + 7] = (byte)((p >> 56) & 255);
        }
        return block;
    }

    /// <summary>将 TUPLES_OK 的 PGresult 复制为 DbResult（NULL 单元格变为 ""）。</summary>
    static DbResult ReadTuples(nint res) {
        DbResult result = new DbResult();
        int cols = PQnfields(res);
        result.SetColumnCount(cols);
        int c = 0;
        for (; c < cols; c = c + 1) {
            result.AddColumnName(CopyText(PQfname(res, c)));
        }
        int rows = PQntuples(res);
        for (int r = 0; r < rows; r = r + 1) {
            List<string> row = new List<string>();
            List<bool> nullFlags = new List<bool>();
            c = 0;
            while (c < cols) {
                if (PQgetisnull(res, r, c) == 1) {
                    row.Add("");
                    nullFlags.Add(true);
                } else {
                    row.Add(CopyText(PQgetvalue(res, r, c)));
                    nullFlags.Add(false);
                }
                c = c + 1;
            }
            result.AddRowNulls(row, nullFlags);
        }
        return result;
    }

    PgConnection() {
        this.handle = 0;
        this.connected = false;
        this.lastError = "";
    }

    /// <summary>从 libpq conninfo 字符串打开连接。</summary>
    static PgConnection Open(string conninfo) {
        PgConnection conn = new PgConnection();
        nint c = PQconnectdb(conninfo);
        conn.handle = c;
        if (c != 0 && PQstatus(c) == 0) {   // CONNECTION_OK
            conn.connected = true;
        } else {
            if (c != 0) { conn.lastError = CopyText(PQerrorMessage(c)); }
            else { conn.lastError = "PQconnectdb returned null"; }
        }
        return conn;
    }

    /// <summary>从分散参数打开连接。</summary>
    static PgConnection OpenParams(string host, int port, string database,
            string user, string password) {
        string conninfo = "host=" + host + " port=" + Convert.ToString(port)
            + " dbname=" + database + " user=" + user + " password=" + password;
        return Open(conninfo);
    }

    /// <summary>执行非查询语句；返回受影响行数或 -1。</summary>
    int Execute(string sql) {
        if (!this.connected) { return -1; }
        nint res = PQexec(this.handle, sql);
        if (res == 0) { this.lastError = CopyText(PQerrorMessage(this.handle)); return -1; }
        int st = PQresultStatus(res);
        if (st != 1 && st != 2) {   // not COMMAND_OK / TUPLES_OK
            this.lastError = CopyText(PQerrorMessage(this.handle));
            PQclear(res);
            return -1;
        }
        int affected = Encoding.ParseInt(PQcmdTuples(res));
        PQclear(res);
        return affected;
    }

    /// <summary>执行查询并返回结果集。</summary>
    DbResult Query(string sql) {
        if (!this.connected) { return DbResult.Empty(); }
        DbResult result = new DbResult();
        nint res = PQexec(this.handle, sql);
        if (res == 0) { this.lastError = CopyText(PQerrorMessage(this.handle)); return result; }
        if (PQresultStatus(res) != 2) {   // TUPLES_OK
            this.lastError = CopyText(PQerrorMessage(this.handle));
            PQclear(res);
            return result;
        }

        int cols = PQnfields(res);
        result.SetColumnCount(cols);
        int c = 0;
        for (; c < cols; c = c + 1) {
            result.AddColumnName(CopyText(PQfname(res, c)));
        }

        int rows = PQntuples(res);
        for (int r = 0; r < rows; r = r + 1) {
            List<string> row = new List<string>();
            List<bool> nullFlags = new List<bool>();
            c = 0;
            while (c < cols) {
                if (PQgetisnull(res, r, c) == 1) {
                    row.Add("");
                    nullFlags.Add(true);
                } else {
                    row.Add(CopyText(PQgetvalue(res, r, c)));
                    nullFlags.Add(false);
                }
                c = c + 1;
            }
            result.AddRowNulls(row, nullFlags);
        }

        PQclear(res);
        return result;
    }

    /// <summary>通过 PQexecParams 执行参数化非查询语句：
    /// 值带外传输，绝不拼入 SQL 文本。</summary>
    int Execute(string sql, DbParams prms) {
        if (!this.connected) { return -1; }
        List<byte[]> keepAlive = new List<byte[]>();
        byte[] block = BuildParamBlock(prms, keepAlive);
        nint res = PQexecParams(this.handle, ToDollarParams(sql), prms.Count(),
            0, block, 0, 0, 0);
        if (res == 0) { this.lastError = CopyText(PQerrorMessage(this.handle)); return -1; }
        int st = PQresultStatus(res);
        if (st != 1 && st != 2) {
            this.lastError = CopyText(PQerrorMessage(this.handle));
            PQclear(res);
            return -1;
        }
        int affected = Encoding.ParseInt(PQcmdTuples(res));
        PQclear(res);
        return affected;
    }

    /// <summary>通过 PQexecParams 执行参数化查询。</summary>
    DbResult Query(string sql, DbParams prms) {
        if (!this.connected) { return DbResult.Empty(); }
        List<byte[]> keepAlive = new List<byte[]>();
        byte[] block = BuildParamBlock(prms, keepAlive);
        nint res = PQexecParams(this.handle, ToDollarParams(sql), prms.Count(),
            0, block, 0, 0, 0);
        if (res == 0) { this.lastError = CopyText(PQerrorMessage(this.handle)); return new DbResult(); }
        if (PQresultStatus(res) != 2) {
            this.lastError = CopyText(PQerrorMessage(this.handle));
            PQclear(res);
            return new DbResult();
        }
        DbResult result = ReadTuples(res);
        PQclear(res);
        return result;
    }

    /// <summary>执行标量查询（第一行第一列）。</summary>
    string ExecuteScalar(string sql) {
        DbResult result = Query(sql);
        if (result.RowCount() > 0) {
            return result.GetString(0, 0);
        }
        return "";
    }

    /// <summary>执行参数化标量查询。</summary>
    string ExecuteScalar(string sql, DbParams prms) {
        DbResult result = Query(sql, prms);
        if (result.RowCount() > 0) {
            return result.GetString(0, 0);
        }
        return "";
    }

    /// <summary>打开连接而不阻塞线程：驱动 libpq 的
    /// 非阻塞握手（PQconnectStart / PQconnectPoll），并在
    /// 各轮询步骤之间于 IO reactor 上挂起等待套接字就绪。</summary>
    static async PgConnection OpenAsync(string conninfo) {
        Socket.Initialize();
        PgConnection conn = new PgConnection();
        nint c = PQconnectStart(conninfo);
        conn.handle = c;
        if (c == 0) {
            conn.lastError = "PQconnectStart returned null";
            return conn;
        }
        if (PQstatus(c) == 1) {   // CONNECTION_BAD
            conn.lastError = CopyText(PQerrorMessage(c));
            return conn;
        }
        while (true) {
            int pr = PQconnectPoll(c);
            if (pr == 3) {        // PGRES_POLLING_OK
                break;
            }
            if (pr == 0) {        // PGRES_POLLING_FAILED
                conn.lastError = CopyText(PQerrorMessage(c));
                return conn;
            }
            int fd = PQsocket(c);
            if (fd < 0) {
                conn.lastError = "PQsocket returned an invalid descriptor";
                return conn;
            }
            if (pr == 1) {        // PGRES_POLLING_READING
                await Socket.ReadReady(fd);
            } else {              // PGRES_POLLING_WRITING (2)
                await Socket.WriteReady(fd);
            }
        }
        PQsetnonblocking(c, 1);
        conn.connected = true;
        return conn;
    }

    /// <summary>从分散参数异步打开连接。</summary>
    static async PgConnection OpenParamsAsync(string host, int port,
            string database, string user, string password) {
        string conninfo = "host=" + host + " port=" + Convert.ToString(port)
            + " dbname=" + database + " user=" + user + " password=" + password;
        PgConnection conn = await OpenAsync(conninfo);
        return conn;
    }

    /// <summary>将缓冲输出刷新到服务器，在 libpq 仍有待发数据时
    /// 挂起等待可写就绪。成功返回 0。</summary>
    async int flushOutput() {
        int fd = PQsocket(this.handle);
        while (true) {
            int rc = PQflush(this.handle);
            if (rc == 0) {
                return 0;
            }
            if (rc < 0) {
                this.lastError = CopyText(PQerrorMessage(this.handle));
                return -1;
            }
            await Socket.WriteReady(fd);
        }
        return 0;
    }

    /// <summary>等待 libpq 能无阻塞地产出下一条结果，
    /// 在可读就绪时消费输入。出错返回 false。</summary>
    async bool waitReady() {
        int fd = PQsocket(this.handle);
        while (PQisBusy(this.handle) == 1) {
            await Socket.ReadReady(fd);
            if (PQconsumeInput(this.handle) == 0) {
                this.lastError = CopyText(PQerrorMessage(this.handle));
                return false;
            }
        }
        return true;
    }

    /// <summary>发送查询并异步收完所有结果，保留
    /// 最后一个返回行的结果集。在 reactor 上挂起等待 IO 就绪，
    /// 使工作线程可供其他协程使用。</summary>
    async DbResult QueryAsync(string sql) {
        if (!this.connected) {
            this.lastError = "not connected";
            this.fail();
        }
        DbResult result = new DbResult();
        if (PQsendQuery(this.handle, sql) == 0) {
            this.lastError = CopyText(PQerrorMessage(this.handle));
            this.fail();
        }
        int f = await this.flushOutput();
        if (f < 0) {
            this.lastError = "cannot send the query";
            this.fail();
        }
        bool failed = false;
        while (true) {
            bool ready = await this.waitReady();
            if (!ready) {
                this.lastError = "the connection went away mid-statement";
                this.fail();
            }
            nint res = PQgetResult(this.handle);
            if (res == 0) {
                break;
            }
            if (PQresultStatus(res) == 2) {   // TUPLES_OK
                int cols = PQnfields(res);
                result = new DbResult();
                result.SetColumnCount(cols);
                int c = 0;
                for (; c < cols; c = c + 1) {
                    result.AddColumnName(CopyText(PQfname(res, c)));
                }
                int rows = PQntuples(res);
                for (int r = 0; r < rows; r = r + 1) {
                    List<string> row = new List<string>();
                    List<bool> nullFlags = new List<bool>();
                    c = 0;
                    while (c < cols) {
                        if (PQgetisnull(res, r, c) == 1) {
                            row.Add("");
                            nullFlags.Add(true);
                        } else {
                            row.Add(CopyText(PQgetvalue(res, r, c)));
                            nullFlags.Add(false);
                        }
                        c = c + 1;
                    }
                    result.AddRowNulls(row, nullFlags);
                }
            } else if (PQresultStatus(res) != 1) {   // not COMMAND_OK
                this.lastError = CopyText(PQerrorMessage(this.handle));
                failed = true;
            }
            PQclear(res);
        }
        if (failed) { this.fail(); }
        return result;
    }

    /// <summary>异步发送参数化查询（PQsendQueryParams）
    /// 并在 IO reactor 上收完结果。语句失败时抛出
    /// <see cref="DbException"/>。</summary>
    async DbResult QueryParamsAsync(string sql, DbParams prms) {
        if (!this.connected) {
            this.lastError = "not connected";
            this.fail();
        }
        DbResult result = new DbResult();
        List<byte[]> keepAlive = new List<byte[]>();
        byte[] block = BuildParamBlock(prms, keepAlive);
        int ok = PQsendQueryParams(this.handle, ToDollarParams(sql), prms.Count(),
            0, block, 0, 0, 0);
        if (ok == 0) {
            this.lastError = CopyText(PQerrorMessage(this.handle));
            this.fail();
        }
        int f = await this.flushOutput();
        if (f < 0) {
            this.lastError = "cannot send the query";
            this.fail();
        }
        bool failedP = false;
        while (true) {
            bool ready = await this.waitReady();
            if (!ready) {
                this.lastError = "the connection went away mid-statement";
                this.fail();
            }
            nint res = PQgetResult(this.handle);
            if (res == 0) {
                break;
            }
            if (PQresultStatus(res) == 2) {   // TUPLES_OK
                result = ReadTuples(res);
            } else if (PQresultStatus(res) != 1) {   // not COMMAND_OK
                this.lastError = CopyText(PQerrorMessage(this.handle));
                failedP = true;
            }
            PQclear(res);
        }
        if (failedP) { this.fail(); }
        return result;
    }

    /// <summary>异步发送参数化非查询语句并返回
    /// 受影响行数。语句失败时抛出 <see cref="DbException"/>。
    /// </summary>
    async int ExecuteParamsAsync(string sql, DbParams prms) {
        if (!this.connected) {
            this.lastError = "not connected";
            this.fail();
        }
        List<byte[]> keepAlive = new List<byte[]>();
        byte[] block = BuildParamBlock(prms, keepAlive);
        int ok = PQsendQueryParams(this.handle, ToDollarParams(sql), prms.Count(),
            0, block, 0, 0, 0);
        if (ok == 0) {
            this.lastError = CopyText(PQerrorMessage(this.handle));
            this.fail();
        }
        int f2 = await this.flushOutput();
        if (f2 < 0) {
            this.lastError = "cannot send the statement";
            this.fail();
        }
        int affected2 = 0;
        bool failed2 = false;
        while (true) {
            bool ready = await this.waitReady();
            if (!ready) {
                this.lastError = "the connection went away mid-statement";
                this.fail();
            }
            nint res = PQgetResult(this.handle);
            if (res == 0) {
                break;
            }
            int st = PQresultStatus(res);
            if (st == 1 || st == 2) {
                affected2 = Encoding.ParseInt(PQcmdTuples(res));
            } else {
                this.lastError = CopyText(PQerrorMessage(this.handle));
                failed2 = true;
            }
            PQclear(res);
        }
        if (failed2) {
            this.fail();
        }
        return affected2;
    }

    /// <summary>异步发送非查询语句并返回
    /// 受影响行数。语句失败时抛出 <see cref="DbException"/>。
    /// </summary>
    async int ExecuteAsync(string sql) {
        if (!this.connected) {
            this.lastError = "not connected";
            this.fail();
        }
        if (PQsendQuery(this.handle, sql) == 0) {
            this.lastError = CopyText(PQerrorMessage(this.handle));
            this.fail();
        }
        int f = await this.flushOutput();
        if (f < 0) {
            this.lastError = "cannot send the statement";
            this.fail();
        }
        int affected = 0;
        bool failed = false;
        while (true) {
            bool ready = await this.waitReady();
            if (!ready) {
                this.lastError = "the connection went away mid-statement";
                this.fail();
            }
            nint res = PQgetResult(this.handle);
            if (res == 0) {
                break;
            }
            int st = PQresultStatus(res);
            if (st == 1 || st == 2) {   // COMMAND_OK / TUPLES_OK
                affected = Encoding.ParseInt(PQcmdTuples(res));
            } else {
                this.lastError = CopyText(PQerrorMessage(this.handle));
                failed = true;
            }
            PQclear(res);
        }
        if (failed) {
            this.fail();
        }
        return affected;
    }

    /// <summary>抛出记录的失败。libpq 的消息来自服务器本身，
    /// 因此能原样到达调用方，而不会被
    /// 空结果或 -1 吞掉。</summary>
    void fail() {
        string why = this.lastError;
        if (why.Length == 0) {
            why = "the statement failed";
        }
        throw new DbException(why, 0, DbProvider.PostgreSQL);
    }

    /// <summary>获取最后一条错误消息。</summary>
    string GetError() { return this.lastError; }

    /// <summary>开始一个事务。</summary>
    // ===== 协程对应方法 =====
    // 参数化协程历来命名为 QueryParamsAsync /
    // ExecuteParamsAsync；这些重载让它们采用接口
    // 命名，使生成的 ORM 终端节点可以用统一名称调用。
    async DbResult QueryAsync(string sql, DbParams prms) {
        return await this.QueryParamsAsync(sql, prms);
    }

    async int ExecuteAsync(string sql, DbParams prms) {
        return await this.ExecuteParamsAsync(sql, prms);
    }

    async string ExecuteScalarAsync(string sql) {
        DbResult r = await this.QueryAsync(sql);
        if (r.RowCount() == 0) { return ""; }
        return r.GetString(0, 0);
    }

    async string ExecuteScalarAsync(string sql, DbParams prms) {
        DbResult r = await this.QueryParamsAsync(sql, prms);
        if (r.RowCount() == 0) { return ""; }
        return r.GetString(0, 0);
    }

    async bool BeginTransactionAsync() { int _n = await this.ExecuteAsync("BEGIN"); return true; }
    async bool CommitAsync() { int _n = await this.ExecuteAsync("COMMIT"); return true; }
    async bool RollbackAsync() { int _n = await this.ExecuteAsync("ROLLBACK"); return true; }

    void BeginTransaction() { Execute("BEGIN"); }

    /// <summary>提交当前事务。</summary>
    void Commit() { Execute("COMMIT"); }

    /// <summary>回滚当前事务。</summary>
    void Rollback() { Execute("ROLLBACK"); }

    /// <summary>关闭数据库连接。</summary>
    void Close() {
        // 句柄存在即释放，哪怕连接已判死：查询中途死掉的连接
        // connected 已被清掉但 PGconn 还在——只看 connected 会泄漏。
        if (this.connected || this.handle != 0) {
            PQfinish(this.handle);
            this.connected = false;
            this.handle = 0;
        }
    }

    /// <summary>返回连接是否已打开。</summary>
    bool IsConnected() { return this.connected; }

    /// <summary>返回提供程序 ID（DbProvider.PostgreSQL）。</summary>
    int GetProvider() { return DbProvider.PostgreSQL; }
}
