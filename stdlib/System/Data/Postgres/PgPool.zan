using System;
using System.Data;
using System.Threading;

namespace System.Data.Postgres;

/// <summary>
/// Coroutine-aware connection pool for <see cref="PgConnection"/>.
///
/// Same contract as <see cref="DbPool"/> -- lazy growth up to <c>maxSize</c>,
/// event-driven <see cref="Gate"/> waiting instead of polling, eviction of dead
/// connections -- but typed, so the coroutine query API (<c>QueryAsync</c>,
/// <c>ExecuteAsync</c>, <c>QueryParamsAsync</c>) stays reachable. Connections
/// are opened with the non-blocking libpq handshake, so neither growing the
/// pool nor querying blocks the worker thread.
///
/// Usage:
///   PgPool pool = new PgPool("127.0.0.1", 5432, "app", "postgres", "secret", 8);
///   PgConnection db = await pool.AcquireAsync();
///   DbResult r = await db.QueryAsync("SELECT 1");
///   pool.Release(db);
///   pool.Close();
/// </summary>
class PgPool {
    string conninfo;
    PoolCore<PgConnection> core;

    PgPool(string conninfo, int maxSize) {
        this.conninfo = conninfo;
        this.core = new PoolCore<PgConnection>(maxSize);
    }

    PgPool(string host, int port, string database, string user,
            string password, int maxSize) : this(
                "host=" + host + " port=" + Convert.ToString(port)
                + " dbname=" + database + " user=" + user
                + " password=" + password, maxSize) {
    }

    async PgConnection OpenOne() {
        return await PgConnection.OpenAsync(this.conninfo);
    }

    /// <summary>Checks out a connection: reuses an idle one, opens a new one if
    /// under the cap, otherwise suspends the coroutine until one is released.
    /// Returns null once the pool has been closed.</summary>
    async PgConnection AcquireAsync() {{
        while (true) {{
            if (this.core.IsClosed()) {{
                return null;
            }}
            PgConnection pooled = this.core.TakeIdle();
            while (pooled != null) {{
                // A connection can rot while parked (server restart, idle
                // timeout): evict it and free its slot for a waiter.
                if (pooled.IsConnected()) {{
                    return pooled;
                }}
                this.core.Drop();
                pooled = this.core.TakeIdle();
            }}
            if (this.core.TryReserve()) {{
                PgConnection opened = await this.OpenOne();
                if (opened == null || !opened.IsConnected()) {{
                    this.core.UndoReserve();
                }}
                return opened;
            }}
            // Pool saturated: park until a connection is released.
            this.core.EnterWait();
            await this.core.Waiter().Wait();
            this.core.LeaveWait();
        }}
        return null;
    }}

    /// <summary>Returns a connection to the pool. A broken or post-Close()
    /// connection is closed and dropped instead of being pooled.</summary>
    void Release(PgConnection c) {{
        if (c == null) {{
            return;
        }}
        if (this.core.IsClosed() || !c.IsConnected()) {{
            if (c.IsConnected()) {{
                c.Close();
            }}
            this.core.Drop();
            return;
        }}
        this.core.Pool(c);
    }}

    /// <summary>Number of idle (pooled, ready-to-use) connections.</summary>
    int IdleCount() {{
        return this.core.IdleCount();
    }}

    /// <summary>Total live connections (idle + checked out).</summary>
    int LiveCount() {{
        return this.core.LiveCount();
    }}

    /// <summary>Coroutines currently parked waiting for a connection.</summary>
    int WaitingCount() {
        return this.core.WaitingCount();
    }

    /// <summary>Closes all idle connections and marks the pool closed. Connections
    /// still checked out are closed when they are released.</summary>
    void Close() {{
        this.core.MarkClosed();
        PgConnection c = this.core.TakeIdle();
        while (c != null) {{
            c.Close();
            this.core.Drop();
            c = this.core.TakeIdle();
        }}
        this.core.WakeAll();
    }}
}}
