using System;
using System.Data;
using System.Threading;

namespace System.Data.Postgres;

/// <summary>
/// Coroutine-aware connection pool for <see cref="PgConnection"/>.
///
/// Same contract as <see cref="DbPool"/> -- lazy growth up to <c>maxSize</c>,
/// event-driven <see cref="Gate"/> waiting instead of polling, eviction of dead
/// connections -- but typed, so the coroutine query API (<c>QueryAsync</c>,
/// <c>ExecuteAsync</c>, <c>QueryParamsAsync</c>) stays reachable. Connections
/// are opened with the non-blocking libpq handshake, so neither growing the
/// pool nor querying blocks the worker thread.
///
/// Usage:
///   PgPool pool = PgPool.Create("127.0.0.1", 5432, "app", "postgres", "secret", 8);
///   PgConnection db = await pool.AcquireAsync();
///   DbResult r = await db.QueryAsync("SELECT 1");
///   pool.Release(db);
///   pool.Close();
/// </summary>
class PgPool {
    string conninfo;
    int maxSize;
    List<PgConnection> idle;
    int liveCount;      // total opened connections (idle + checked out)
    int waiting;        // coroutines currently parked in AcquireAsync
    Gate gate;          // event-driven wakeup for waiters (replaces poll)
    bool closed;

    PgPool(string conninfo, int maxSize) {
        this.conninfo = conninfo;
        this.maxSize = maxSize;
        this.idle = new List<PgConnection>();
        this.liveCount = 0;
        this.waiting = 0;
        this.gate = Gate.Create();
        this.closed = false;
    }

    /// <summary>Creates a pool from a libpq connection string.</summary>
    static PgPool Create(string conninfo, int maxSize) {
        if (maxSize < 1) {
            maxSize = 1;
        }
        return new PgPool(conninfo, maxSize);
    }

    /// <summary>Creates a pool bound to a PostgreSQL endpoint.</summary>
    static PgPool Create(string host, int port, string database, string user,
            string password, int maxSize) {
        string conninfo = "host=" + host + " port=" + Convert.ToString(port)
            + " dbname=" + database + " user=" + user + " password=" + password;
        return PgPool.Create(conninfo, maxSize);
    }

    /// <summary>Checks out a connection. Reuses an idle one, opens a new one if
    /// under the cap, otherwise suspends the coroutine until one is released.</summary>
    async PgConnection AcquireAsync() {
        while (true) {
            if (this.closed) {
                return null;
            }
            if (this.idle.Count > 0) {
                int last = this.idle.Count - 1;
                PgConnection c = this.idle[last];
                this.idle.RemoveAt(last);
                if (c.IsConnected()) {
                    return c;
                }
                // Died while parked (server restart / idle timeout): drop it.
                if (this.liveCount > 0) {
                    this.liveCount = this.liveCount - 1;
                }
                continue;
            }
            if (this.liveCount < this.maxSize) {
                this.liveCount = this.liveCount + 1;
                PgConnection c = await PgConnection.OpenAsync(this.conninfo);
                if (c == null || !c.IsConnected()) {
                    this.liveCount = this.liveCount - 1;
                    if (this.waiting > 0) {
                        this.gate.Signal();
                    }
                }
                return c;
            }
            // Pool saturated: park until a connection is released. The gate's
            // counting semantics + this recheck loop guarantee no lost wakeup.
            this.waiting = this.waiting + 1;
            await this.gate.Wait();
            this.waiting = this.waiting - 1;
        }
        return null;
    }

    /// <summary>Returns a connection to the pool. A broken or post-Close()
    /// connection is closed and dropped instead of being pooled.</summary>
    void Release(PgConnection c) {
        if (c == null) {
            return;
        }
        if (this.closed || !c.IsConnected()) {
            if (c.IsConnected()) {
                c.Close();
            }
            if (this.liveCount > 0) {
                this.liveCount = this.liveCount - 1;
            }
            if (this.waiting > 0) {
                this.gate.Signal();
            }
            return;
        }
        this.idle.Add(c);
        if (this.waiting > 0) {
            this.gate.Signal();
        }
    }

    /// <summary>Number of idle (pooled, ready-to-use) connections.</summary>
    int IdleCount() {
        return this.idle.Count;
    }

    /// <summary>Total live connections (idle + checked out).</summary>
    int LiveCount() {
        return this.liveCount;
    }

    /// <summary>Coroutines currently parked waiting for a connection.</summary>
    int WaitingCount() {
        return this.waiting;
    }

    /// <summary>Closes all idle connections and marks the pool closed. Connections
    /// still checked out are closed when they are released.</summary>
    void Close() {
        this.closed = true;
        while (this.idle.Count > 0) {
            int last = this.idle.Count - 1;
            PgConnection c = this.idle[last];
            this.idle.RemoveAt(last);
            c.Close();
            if (this.liveCount > 0) {
                this.liveCount = this.liveCount - 1;
            }
        }
        int n = this.waiting;
        int k = 0;
        while (k < n) {
            this.gate.Signal();
            k = k + 1;
        }
    }
}
