using System;
using System.Data;

namespace System.Data.Firebird;

/// <summary>Firebird SQL 类型码（表示“可空”的奇数变体
/// 在解析元数据时并入对应的偶数基础类型）。</summary>
class FbType {
    static int TEXT         = 452;
    static int VARYING      = 448;
    static int SHORT        = 500;
    static int LONG         = 496;
    static int FLOAT        = 482;
    static int DOUBLE       = 480;
    static int D_FLOAT      = 530;
    static int TIMESTAMP    = 510;
    static int BLOB         = 520;
    static int ARRAY        = 540;
    static int QUAD         = 550;
    static int TIME         = 560;
    static int DATE         = 570;
    static int INT64        = 580;
    static int INT128       = 32752;
    static int TIMESTAMP_TZ = 32754;
    static int TIME_TZ      = 32756;
    static int DEC_FIXED    = 32758;
    static int DEC64        = 32760;
    static int DEC128       = 32762;
    static int BOOLEAN      = 32764;
    static int NULL         = 32766;

    // describe 请求的 isc_info_sql_* 项
    static int INFO_END           = 1;
    static int INFO_TRUNCATED     = 2;
    static int INFO_SELECT        = 4;
    static int INFO_BIND          = 5;
    static int INFO_DESCRIBE_VARS = 7;
    static int INFO_DESCRIBE_END  = 8;
    static int INFO_SQLDA_SEQ     = 9;
    static int INFO_TYPE          = 11;
    static int INFO_SUB_TYPE      = 12;
    static int INFO_SCALE         = 13;
    static int INFO_LENGTH        = 14;
    static int INFO_NULL_IND      = 15;
    static int INFO_FIELD         = 16;
    static int INFO_RELATION      = 17;
    static int INFO_OWNER         = 18;
    static int INFO_ALIAS         = 19;
    static int INFO_SQLDA_START   = 20;
    static int INFO_STMT_TYPE     = 21;
    static int INFO_RECORDS       = 23;

    // isc_info_sql_records 中的 isc_info_req_* 计数器
    static int REQ_SELECT_COUNT = 13;
    static int REQ_INSERT_COUNT = 14;
    static int REQ_UPDATE_COUNT = 15;
    static int REQ_DELETE_COUNT = 16;

    // 语句类型
    static int STMT_SELECT = 1;
    static int STMT_INSERT = 2;
    static int STMT_UPDATE = 3;
    static int STMT_DELETE = 4;
    static int STMT_DDL    = 5;
    static int STMT_EXEC_PROCEDURE = 8;
    static int STMT_SELECT_FOR_UPD = 12;
}

/// <summary>预编译语句输出行中的一列。</summary>
class FbColumn {
    int sqltype;
    int subtype;
    int scale;
    int sqllen;
    bool nullOk;
    string field;
    string relation;
    string owner;
    string alias;

    FbColumn() {
        this.sqltype = 0;
        this.subtype = 0;
        this.scale = 0;
        this.sqllen = 0;
        this.nullOk = false;
        this.field = "";
        this.relation = "";
        this.owner = "";
        this.alias = "";
    }

    /// <summary>已知形状的列，用于在缺少 describe 缓冲区时
    /// 解码某个值。</summary>
    static FbColumn Of(int sqltype, int scale, int sqllen) {
        FbColumn c = new FbColumn();
        c.sqltype = sqltype;
        c.scale = scale;
        c.sqllen = sqllen;
        return c;
    }

    int SqlType() { return this.sqltype; }
    int SubType() { return this.subtype; }
    int Scale() { return this.scale; }
    int Length() { return this.sqllen; }
    bool NullOk() { return this.nullOk; }
    string Field() { return this.field; }
    string Relation() { return this.relation; }

    /// <summary>结果集应展示的列名：有 SELECT 别名时
    /// 用别名，否则用底层字段名。</summary>
    string Name() {
        if (this.alias.Length > 0) { return this.alias; }
        return this.field;
    }

    /// <summary>该列在取回的行中占用的字节数，
    /// 带长度前缀（VARCHAR）时为 -1。</summary>
    int IoLength() {
        int t = this.sqltype;
        if (t == FbType.TEXT) { return this.sqllen; }
        if (t == FbType.VARYING) { return 0 - 1; }
        if (t == FbType.SHORT || t == FbType.LONG || t == FbType.FLOAT
                || t == FbType.TIME || t == FbType.DATE) { return 4; }
        if (t == FbType.DOUBLE || t == FbType.TIMESTAMP || t == FbType.BLOB
                || t == FbType.ARRAY || t == FbType.QUAD || t == FbType.INT64
                || t == FbType.DEC64 || t == FbType.TIME_TZ) { return 8; }
        if (t == FbType.INT128 || t == FbType.DEC128
                || t == FbType.DEC_FIXED) { return 16; }
        if (t == FbType.TIMESTAMP_TZ) { return 12; }
        if (t == FbType.BOOLEAN) { return 1; }
        return this.sqllen;
    }
}

/// <summary>预编译语句输出行的布局；
/// 该布局从服务器的 describe 缓冲区解码而来。</summary>
class FbXsqlda {
    List<FbColumn> cols;
    int stmtType;

    FbXsqlda() {
        this.cols = new List<FbColumn>();
        this.stmtType = 0;
    }

    int Count() { return this.cols.Count; }
    FbColumn At(int i) { return this.cols[i]; }
    int StmtType() { return this.stmtType; }
    void SetStmtType(int t) { this.stmtType = t; }

    /// <summary>当语句需要逐行取回结果时为 true。</summary>
    bool IsSelect() {
        return this.stmtType == FbType.STMT_SELECT
            || this.stmtType == FbType.STMT_SELECT_FOR_UPD;
    }

    void Resize(int n) {
        while (this.cols.Count < n) {
            this.cols.Add(new FbColumn());
        }
    }

    /// <summary>
    /// 将 describe 缓冲区读入本布局。返回服务器截断处的 1 起始索引，
    /// 以便调用方用 <c>isc_info_sql_sqlda_start</c> 请求剩余部分；
    /// 描述完整时返回 -1，
    /// 缓冲区根本不是 describe 应答时返回 -2。
    /// </summary>
    int Parse(FbBytes buf) {
        FbReader r = FbReader.Over(buf);
        int next = 0 - 1;
        while (!r.Eof()) {
            int item = r.U8();
            if (item == FbType.INFO_END) {
                return next;
            }
            if (item == FbType.INFO_STMT_TYPE) {
                int ln = r.U16LE();
                this.stmtType = r.IntLE(ln);
            } else if (item == FbType.INFO_SELECT) {
                if (r.U8() != FbType.INFO_DESCRIBE_VARS) { return 0 - 2; }
                int ln = r.U16LE();
                int n = r.IntLE(ln);
                Resize(n);
                next = ParseItems(r);
                if (next > 0) { return next; }
            } else if (item == FbType.INFO_TRUNCATED) {
                return next;
            } else {
                return 0 - 2;
            }
        }
        return next;
    }

    /// <summary>读取逐列条目；服务器缓冲区耗尽时返回续读索引，
    /// 列表读完时返回 -1。</summary>
    int ParseItems(FbReader r) {
        int index = 0;
        while (!r.Eof()) {
            int item = r.U8();
            if (item == FbType.INFO_END) { return 0 - 1; }
            if (item == FbType.INFO_TRUNCATED) { return index; }
            if (item == FbType.INFO_DESCRIBE_END) { continue; }
            int ln = r.U16LE();
            if (item == FbType.INFO_SQLDA_SEQ) {
                index = r.IntLE(ln);
                Resize(index);
                continue;
            }
            if (index < 1) {
                r.Skip(ln);
                continue;
            }
            FbColumn c = this.cols[index - 1];
            if (item == FbType.INFO_TYPE) {
                // 类型的最低位标记“可为 NULL”；类型本体
                // 为偶数。
                int tv = r.IntLE(ln);
                c.sqltype = tv - (tv & 1);
            } else if (item == FbType.INFO_SUB_TYPE) {
                c.subtype = r.IntLE(ln);
            } else if (item == FbType.INFO_SCALE) {
                c.scale = r.IntLE(ln);
            } else if (item == FbType.INFO_LENGTH) {
                c.sqllen = r.IntLE(ln);
            } else if (item == FbType.INFO_NULL_IND) {
                c.nullOk = r.IntLE(ln) != 0;
            } else if (item == FbType.INFO_FIELD) {
                c.field = r.Text(ln);
            } else if (item == FbType.INFO_RELATION) {
                c.relation = r.Text(ln);
            } else if (item == FbType.INFO_OWNER) {
                c.owner = r.Text(ln);
            } else if (item == FbType.INFO_ALIAS) {
                c.alias = r.Text(ln);
            } else {
                r.Skip(ln);
            }
        }
        return 0 - 1;
    }

    /// <summary>服务器返回取回行时使用的行格式。</summary>
    FbBytes CalcBlr() {
        FbBuf b = new FbBuf();
        int ln = this.cols.Count * 2;
        b.U8(5); b.U8(2); b.U8(4); b.U8(0);
        b.U8(ln & 255); b.U8((ln >> 8) & 255);
        for (int i = 0; i < this.cols.Count; i = i + 1) {
            FbColumn c = this.cols[i];
            int t = c.sqltype;
            if (t == FbType.VARYING) {
                b.U8(37); b.U8(c.sqllen & 255); b.U8((c.sqllen >> 8) & 255);
            } else if (t == FbType.TEXT) {
                b.U8(14); b.U8(c.sqllen & 255); b.U8((c.sqllen >> 8) & 255);
            } else if (t == FbType.LONG) {
                b.U8(8); b.U8(c.scale & 255);
            } else if (t == FbType.SHORT) {
                b.U8(7); b.U8(c.scale & 255);
            } else if (t == FbType.INT64) {
                b.U8(16); b.U8(c.scale & 255);
            } else if (t == FbType.INT128 || t == FbType.DEC_FIXED) {
                b.U8(26); b.U8(c.scale & 255);
            } else if (t == FbType.QUAD) {
                b.U8(9); b.U8(c.scale & 255);
            } else if (t == FbType.DOUBLE) {
                b.U8(27);
            } else if (t == FbType.FLOAT) {
                b.U8(10);
            } else if (t == FbType.D_FLOAT) {
                b.U8(11);
            } else if (t == FbType.DATE) {
                b.U8(12);
            } else if (t == FbType.TIME) {
                b.U8(13);
            } else if (t == FbType.TIMESTAMP) {
                b.U8(35);
            } else if (t == FbType.BLOB || t == FbType.ARRAY) {
                b.U8(9); b.U8(0);
            } else if (t == FbType.BOOLEAN) {
                b.U8(23);
            } else if (t == FbType.DEC64) {
                b.U8(24);
            } else if (t == FbType.DEC128) {
                b.U8(25);
            } else if (t == FbType.TIME_TZ) {
                b.U8(28);
            } else if (t == FbType.TIMESTAMP_TZ) {
                b.U8(29);
            } else {
                b.U8(14); b.U8(c.sqllen & 255); b.U8((c.sqllen >> 8) & 255);
            }
            b.U8(7); b.U8(0);           // blr_short：NULL 指示符
        }
        b.U8(255); b.U8(76);            // blr_end, blr_eoc
        return b.ToBytes();
    }
}

/// <summary>按 <c>op_execute</c> 所需方式编码的输入参数：
/// 一条描述取值的 BLR 消息，以及取值本身。</summary>
class FbParamBlock {
    FbBytes blr;
    FbBytes values;

    FbParamBlock(FbBytes blr, FbBytes values) {
        this.blr = blr;
        this.values = values;
    }

    static FbParamBlock Of(FbBytes blr, FbBytes values) {
        return new FbParamBlock(blr, values);
    }

    FbBytes Blr() { return this.blr; }
    FbBytes Values() { return this.values; }

    void Release() {
        this.blr.Release();
        this.values.Release();
    }
}

/// <summary>语句取值的编码器与解码器。</summary>
class FbValue {
    static string HEX = "0123456789abcdef";

    /// <summary>double 的 IEEE-754 位模式：语言没有
    /// 重新解释转换（reinterpret cast），故需手工规范化。
    /// ±∞/NaN 单独处理：∞ 除以 2 仍是 ∞，归一化循环永不终止，
    /// 一次非有限参数就把协程永久钉死（与 TDS 侧同修）。</summary>
    static long DoubleBits(double v) {
        if (v != v) { return 0x7FF8000000000000L; }          // NaN（quiet）
        if (v == 0.0) { return 0; }
        long sign = 0;
        if (v < 0.0) {
            sign = 1;
            v = 0.0 - v;
        }
        if (v > 1.7976931348623157e308) {                    // ±Infinity
            return (sign << 63) | 0x7FF0000000000000L;
        }
        int exp = 0;
        while (v >= 2.0) { v = v / 2.0; exp = exp + 1; }
        while (v < 1.0) { v = v * 2.0; exp = exp - 1; }
        double frac = v - 1.0;
        long mant = 0;
        for (int i = 0; i < 52; i = i + 1) {
            frac = frac * 2.0;
            int bit = 0;
            if (frac >= 1.0) {
                bit = 1;
                frac = frac - 1.0;
            }
            mant = (mant << 1) | bit;
        }
        long e = exp + 1023;
        return (sign << 63) | (e << 52) | mant;
    }

    /// <summary>以 double 表示的 2^e（e 可为负）。</summary>
    static double Pow2(int e) {
        double v = 1.0;
        int i = 0;
        if (e >= 0) {
            while (i < e) { v = v * 2.0; i = i + 1; }
        } else {
            while (i > e) { v = v / 2.0; i = i - 1; }
        }
        return v;
    }

    static string Ieee(int sign, int exp, long mant, int bias, int mantBits) {
        if (exp == 0 && mant == 0) { return "0"; }
        double m = 1.0;
        int b = mantBits - 1;
        while (b >= 0) {
            if (((mant >> b) & 1) == 1) { m = m + FbValue.Pow2(b - mantBits); }
            b = b - 1;
        }
        double v = m * FbValue.Pow2(exp - bias);
        if (sign == 1) { v = 0.0 - v; }
        return Convert.ToString(v);
    }

    static string Pad2(int v) {
        if (v < 10) { return "0" + Convert.ToString(v); }
        return Convert.ToString(v);
    }

    static string Pad4(int v) {
        string s = Convert.ToString(v);
        while (s.Length < 4) { s = "0" + s; }
        return s;
    }

    /// <summary>由相对于 1970-01-01 的天数得到公历日期。</summary>
    static string CivilDate(int z) {
        z = z + 719468;
        int era = z / 146097;
        if (z < 0) { era = (z - 146096) / 146097; }
        int doe = z - era * 146097;
        int yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
        int y = yoe + era * 400;
        int doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
        int mp = (5 * doy + 2) / 153;
        int d = doy - (153 * mp + 2) / 5 + 1;
        int m = mp + 3;
        if (mp >= 10) { m = mp - 9; }
        if (m <= 2) { y = y + 1; }
        return FbValue.Pad4(y) + "-" + FbValue.Pad2(m) + "-" + FbValue.Pad2(d);
    }

    /// <summary>Firebird 以自 1858-11-17 起的天数存储日期（修正的
    /// 儒略历纪元）；其中有 40587 天在 1970-01-01 之前。</summary>
    static string Date(int nday) {
        return FbValue.CivilDate(nday - 40587);
    }

    /// <summary>一天内的时间，单位为万分之一秒。</summary>
    static string Time(int n) {
        int frac = n % 10000;
        int secs = n / 10000;
        string s = FbValue.Pad2(secs / 3600) + ":" + FbValue.Pad2((secs / 60) % 60)
            + ":" + FbValue.Pad2(secs % 60);
        if (frac == 0) { return s; }
        string f = Convert.ToString(frac);
        while (f.Length < 4) { f = "0" + f; }
        return s + "." + f;
    }

    /// <summary>渲染带有 <paramref name="scale"/> 个隐含小数的整数
    /// （Firebird 元数据中 scale 为负数）。</summary>
    static string Scaled(long units, int scale) {
        if (scale >= 0) { return Convert.ToString(units); }
        int digitsAfter = 0 - scale;
        bool neg = units < 0;
        if (neg) { units = 0 - units; }
        string digits = Convert.ToString(units);
        while (digits.Length <= digitsAfter) { digits = "0" + digits; }
        int cut = digits.Length - digitsAfter;
        string outp = digits.Substring(0, cut) + "."
            + digits.Substring(cut, digitsAfter);
        if (neg) { outp = "-" + outp; }
        return outp;
    }

    /// <summary>任意宽度的二进制补码大端整数的十进制文本
    /// （INT128 放不进机器字）。</summary>
    static string WideDecimal(FbBytes raw, int scale) {
        int n = raw.Len();
        List<int> mag = new List<int>();
        bool neg = (raw.At(0) & 128) != 0;
        int carry = 1;
        int i = n - 1;
        while (i >= 0) {
            int v = raw.At(i);
            if (neg) {
                v = (v ^ 255) + carry;
                carry = (v >> 8) & 1;
                v = v & 255;
            }
            mag.Add(v);                 // 小端序的数值大小
            i = i - 1;
        }
        StringBuilder rev = new StringBuilder();
        bool any = true;
        while (any) {
            int rem = 0;
            int k = mag.Count - 1;
            any = false;
            while (k >= 0) {
                int cur = (rem << 8) | mag[k];
                int q = cur / 10;
                rem = cur - q * 10;
                mag[k] = q;
                if (q != 0) { any = true; }
                k = k - 1;
            }
            rev.Append(FbValue.HEX.Substring(rem, 1));
        }
        StringBuilder fwd = new StringBuilder();
        string s = rev.ToString();
        int j = s.Length - 1;
        while (j >= 0) {
            fwd.Append(s.Substring(j, 1));
            j = j - 1;
        }
        string digits = fwd.ToString();
        while (digits.Length > 1 && digits.Substring(0, 1) == "0") {
            digits = digits.Substring(1, digits.Length - 1);
        }
        if (scale < 0) {
            int after = 0 - scale;
            while (digits.Length <= after) { digits = "0" + digits; }
            int cut = digits.Length - after;
            digits = digits.Substring(0, cut) + "." + digits.Substring(cut, after);
        }
        if (neg && digits != "0") { digits = "-" + digits; }
        return digits;
    }

    static string Hex(FbBytes raw) {
        return "0x" + raw.Hex();
    }

    /// <summary>
    /// 把取回的一个值渲染为文本。BLOB 列不在此解码——
    /// 其载荷需要另外几轮往返，连接层
    /// 会在组装行之前先取回它们。
    /// </summary>
    static string Decode(FbColumn col, FbBytes raw) {
        int t = col.SqlType();
        FbReader r = FbReader.Over(raw);
        if (t == FbType.TEXT) {
            string s = r.Text(raw.Len());
            int end = s.Length;
            while (end > 0 && s.Substring(end - 1, 1) == " ") { end = end - 1; }
            return s.Substring(0, end);
        }
        if (t == FbType.VARYING) {
            return r.Text(raw.Len());
        }
        if (t == FbType.SHORT || t == FbType.LONG || t == FbType.INT64) {
            return FbValue.Scaled(r.LongBE(raw.Len()), col.Scale());
        }
        if (t == FbType.INT128 || t == FbType.DEC_FIXED) {
            return FbValue.WideDecimal(raw, col.Scale());
        }
        if (t == FbType.BOOLEAN) {
            if (r.U8() == 0) { return "0"; }
            return "1";
        }
        if (t == FbType.FLOAT) {
            int bits = r.Int() & 4294967295;
            return FbValue.Ieee((bits >> 31) & 1, (bits >> 23) & 255,
                                bits & 8388607, 127, 23);
        }
        if (t == FbType.DOUBLE || t == FbType.D_FLOAT) {
            long bits = r.LongBE(8);
            return FbValue.Ieee((int)((bits >> 63) & 1), (int)((bits >> 52) & 2047),
                                bits & 4503599627370495, 1023, 52);
        }
        if (t == FbType.DATE) {
            return FbValue.Date(r.IntBE(4));
        }
        if (t == FbType.TIME) {
            return FbValue.Time(r.IntBE(4));
        }
        if (t == FbType.TIMESTAMP) {
            string d = FbValue.Date(r.IntBE(4));
            return d + " " + FbValue.Time(r.IntBE(4));
        }
        if (t == FbType.TIME_TZ) {
            // 丢弃时区 id：将 id 映射为名称需要服务器的
            // 时区表。时间本身仍以记录时的时区为准。
            return FbValue.Time(r.IntBE(4));
        }
        if (t == FbType.TIMESTAMP_TZ) {
            string d = FbValue.Date(r.IntBE(4));
            return d + " " + FbValue.Time(r.IntBE(4));
        }
        // DECFLOAT 及任何无法识别的类型保留原始字节，
        // 而不是被悄悄弄成一个错误的数值。
        return FbValue.Hex(raw);
    }

    /// <summary>
    /// 把参数列表编码成 BLR 消息加上 <c>op_execute</c> 携带的取值。
    /// 协议 13 在取值前放置 NULL 位图，所以 NULL 参数
    /// 只贡献自己的一个位。
    /// </summary>
    static FbParamBlock Params(DbParams prms) {
        int count = 0;
        if (prms != null) { count = prms.Count(); }
        FbBuf blr = new FbBuf();
        int ln = count * 2;
        blr.U8(5); blr.U8(2); blr.U8(4); blr.U8(0);
        blr.U8(ln & 255); blr.U8((ln >> 8) & 255);

        FbBuf vals = new FbBuf();
        int nbytes = count / 8;
        if ((count % 8) != 0) { nbytes = nbytes + 1; }
        if ((nbytes % 4) != 0) { nbytes = nbytes + 4 - (nbytes % 4); }
        int i = 0;
        for (; i < nbytes; i = i + 1) {
            int bits = 0;
            for (int k = 0; k < 8; k = k + 1) {
                int idx = i * 8 + k;
                if (idx < count && prms.KindAt(idx) == DbParams.KindNull) {
                    bits = bits | (1 << k);
                }
            }
            vals.U8(bits);
        }

        i = 0;
        while (i < count) {
            int kind = prms.KindAt(i);
            if (kind == DbParams.KindNull) {
                blr.U8(14); blr.U8(0); blr.U8(0);       // blr_text，长度为 0
            } else if (kind == DbParams.KindInt) {
                blr.U8(16); blr.U8(0);                  // blr_int64
                FbValue.appendBE(vals, prms.IntAt(i), 8);
            } else if (kind == DbParams.KindDouble) {
                blr.U8(27);                             // blr_double
                FbValue.appendBE(vals, FbValue.DoubleBits(prms.DoubleAt(i)), 8);
            } else {
                string s = prms.TextAt(i);
                int n = s.Length;
                blr.U8(14); blr.U8(n & 255); blr.U8((n >> 8) & 255);
                vals.Raw(s);
                int pad = (4 - (n % 4)) % 4;
                for (int p = 0; p < pad; p = p + 1) {
                    vals.U8(0);
                }
            }
            blr.U8(7); blr.U8(0);                       // blr_short：NULL 标志
            i = i + 1;
        }
        blr.U8(255); blr.U8(76);                        // blr_end, blr_eoc
        return FbParamBlock.Of(blr.ToBytes(), vals.ToBytes());
    }

    static void appendBE(FbBuf b, long v, int n) {
        int i = n - 1;
        while (i >= 0) {
            b.U8((int)((v >> (i * 8)) & 255));
            i = i - 1;
        }
    }
}
