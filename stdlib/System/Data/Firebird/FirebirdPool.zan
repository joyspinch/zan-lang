using System;
using System.Data;
using System.Threading;

namespace System.Data.Firebird;

/// <summary>
/// Coroutine-aware connection pool for <see cref="FirebirdConnection"/>.
///
/// Same contract as <see cref="DbPool"/> -- lazy growth up to <c>maxSize</c>,
/// <see cref="Gate"/>-driven waiting rather than polling, eviction of dead
/// connections -- but typed, so the coroutine query API (<c>QueryAsync</c>,
/// <c>ExecuteAsync</c>) stays reachable. An attach costs an SRP exchange and
/// several round trips, which is the reason to keep sessions alive rather than
/// open one per statement.
///
/// Usage:
///   FirebirdPool pool = FirebirdPool.Create("127.0.0.1", 3050,
///       "/var/lib/firebird/data/test.fdb", "SYSDBA", "secret", 8);
///   FirebirdConnection db = await pool.AcquireAsync();
///   DbResult r = await db.QueryAsync("SELECT id, name FROM t1");
///   pool.Release(db);
///   pool.Close();
/// </summary>
class FirebirdPool {
    string host;
    int port;
    string database;
    string user;
    string password;
    bool wireCrypt;
    PoolCore<FirebirdConnection> core;

    FirebirdPool(string host, int port, string database, string user,
            string password, bool wireCrypt, int maxSize) {
        this.host = host;
        this.port = port;
        this.database = database;
        this.user = user;
        this.password = password;
        this.wireCrypt = wireCrypt;
        this.core = PoolCore<FirebirdConnection>.Create(maxSize);
    }

    static FirebirdPool Create(string host, int port, string database,
            string user, string password, int maxSize) {
        return FirebirdPool.Create(host, port, database, user, password, true,
                                   maxSize);
    }

    static FirebirdPool Create(string host, int port, string database,
            string user, string password, bool wireCrypt, int maxSize) {
        return new FirebirdPool(host, port, database, user, password, wireCrypt,
                                maxSize);
    }

    async FirebirdConnection OpenOne() {
        return await FirebirdConnection.OpenAsync(this.host, this.port,
                                                  this.database, this.user,
                                                  this.password,
                                                  this.wireCrypt);
    }

    /// <summary>Checks out a connection: reuses an idle one, opens a new one if
    /// under the cap, otherwise suspends the coroutine until one is released.
    /// Returns null once the pool has been closed.</summary>
    async FirebirdConnection AcquireAsync() {{
        while (true) {{
            if (this.core.IsClosed()) {{
                return null;
            }}
            FirebirdConnection pooled = this.core.TakeIdle();
            while (pooled != null) {{
                // A connection can rot while parked (server restart, idle
                // timeout): evict it and free its slot for a waiter.
                if (pooled.IsConnected()) {{
                    return pooled;
                }}
                this.core.Drop();
                pooled = this.core.TakeIdle();
            }}
            if (this.core.TryReserve()) {{
                FirebirdConnection opened = await this.OpenOne();
                if (opened == null || !opened.IsConnected()) {{
                    this.core.UndoReserve();
                }}
                return opened;
            }}
            // Pool saturated: park until a connection is released.
            this.core.EnterWait();
            await this.core.Waiter().Wait();
            this.core.LeaveWait();
        }}
        return null;
    }}

    /// <summary>Returns a connection to the pool. A broken or post-Close()
    /// connection is closed and dropped instead of being pooled.</summary>
    void Release(FirebirdConnection c) {{
        if (c == null) {{
            return;
        }}
        if (this.core.IsClosed() || !c.IsConnected()) {{
            if (c.IsConnected()) {{
                c.Close();
            }}
            this.core.Drop();
            return;
        }}
        this.core.Pool(c);
    }}

    /// <summary>Number of idle (pooled, ready-to-use) connections.</summary>
    int IdleCount() {{
        return this.core.IdleCount();
    }}

    /// <summary>Total live connections (idle + checked out).</summary>
    int LiveCount() {{
        return this.core.LiveCount();
    }}

    /// <summary>Coroutines currently parked waiting for a connection.</summary>
    int WaitingCount() {
        return this.core.WaitingCount();
    }

    /// <summary>Maximum number of concurrently live connections.</summary>
    int MaxSize() {
        return this.core.MaxSize();
    }

    /// <summary>True once <see cref="Close"/> has run.</summary>
    bool IsClosed() {
        return this.core.IsClosed();
    }

    int GetProvider() {
        return DbProvider.Firebird;
    }

    /// <summary>Closes all idle connections and marks the pool closed. Connections
    /// still checked out are closed when they are released.</summary>
    void Close() {{
        this.core.MarkClosed();
        FirebirdConnection c = this.core.TakeIdle();
        while (c != null) {{
            c.Close();
            this.core.Drop();
            c = this.core.TakeIdle();
        }}
        this.core.WakeAll();
    }}
}}
