using System;
using System.Data;
using System.Threading;

namespace System.Data.Firebird;

/// <summary>
/// Coroutine-aware connection pool for <see cref="FirebirdConnection"/>.
///
/// Same contract as <see cref="DbPool"/> -- lazy growth up to <c>maxSize</c>,
/// <see cref="Gate"/>-driven waiting rather than polling, eviction of dead
/// connections -- but typed, so the coroutine query API (<c>QueryAsync</c>,
/// <c>ExecuteAsync</c>) stays reachable. An attach costs an SRP exchange and
/// several round trips, which is the reason to keep sessions alive rather than
/// open one per statement.
///
/// Usage:
///   FirebirdPool pool = FirebirdPool.Create("127.0.0.1", 3050,
///       "/var/lib/firebird/data/test.fdb", "SYSDBA", "secret", 8);
///   FirebirdConnection db = await pool.AcquireAsync();
///   DbResult r = await db.QueryAsync("SELECT id, name FROM t1");
///   pool.Release(db);
///   pool.Close();
/// </summary>
class FirebirdPool {
    string host;
    int port;
    string database;
    string user;
    string password;
    bool wireCrypt;
    int maxSize;
    List<FirebirdConnection> idle;
    int liveCount;      // total opened connections (idle + checked out)
    int waiting;        // coroutines currently parked in AcquireAsync
    Gate gate;
    bool closed;

    FirebirdPool(string host, int port, string database, string user,
            string password, bool wireCrypt, int maxSize) {
        this.host = host;
        this.port = port;
        this.database = database;
        this.user = user;
        this.password = password;
        this.wireCrypt = wireCrypt;
        this.maxSize = maxSize;
        this.idle = new List<FirebirdConnection>();
        this.liveCount = 0;
        this.waiting = 0;
        this.gate = Gate.Create();
        this.closed = false;
    }

    /// <summary>Pool that uses wire encryption when the server offers it.</summary>
    static FirebirdPool Create(string host, int port, string database,
            string user, string password, int maxSize) {
        return FirebirdPool.Create(host, port, database, user, password, true,
                                   maxSize);
    }

    /// <summary>Pool that can decline wire encryption, for a server already
    /// reached over an encrypted tunnel or one with WireCrypt disabled.</summary>
    static FirebirdPool Create(string host, int port, string database,
            string user, string password, bool wireCrypt, int maxSize) {
        if (maxSize < 1) {
            maxSize = 1;
        }
        return new FirebirdPool(host, port, database, user, password, wireCrypt,
                                maxSize);
    }

    async FirebirdConnection OpenOne() {
        return await FirebirdConnection.OpenAsync(this.host, this.port,
                                                  this.database, this.user,
                                                  this.password,
                                                  this.wireCrypt);
    }

    /// <summary>Checks out a connection. Reuses an idle one, opens a new one if
    /// under the cap, otherwise suspends the coroutine until one is released.</summary>
    async FirebirdConnection AcquireAsync() {
        while (true) {
            if (this.closed) {
                return null;
            }
            if (this.idle.Count > 0) {
                int last = this.idle.Count - 1;
                FirebirdConnection c = this.idle[last];
                this.idle.RemoveAt(last);
                if (c.IsConnected()) {
                    return c;
                }
                if (this.liveCount > 0) {
                    this.liveCount = this.liveCount - 1;
                }
                continue;
            }
            if (this.liveCount < this.maxSize) {
                // Reserve the slot before suspending, so concurrent acquirers
                // cannot all see room and overshoot maxSize.
                this.liveCount = this.liveCount + 1;
                FirebirdConnection c = await OpenOne();
                if (c == null || !c.IsConnected()) {
                    this.liveCount = this.liveCount - 1;
                    if (this.waiting > 0) {
                        this.gate.Signal();
                    }
                }
                return c;
            }
            this.waiting = this.waiting + 1;
            await this.gate.Wait();
            this.waiting = this.waiting - 1;
        }
        return null;
    }

    /// <summary>Returns a connection to the pool. A broken or post-Close()
    /// connection is closed and dropped instead of being pooled.</summary>
    void Release(FirebirdConnection c) {
        if (c == null) {
            return;
        }
        if (this.closed || !c.IsConnected()) {
            c.Close();
            if (this.liveCount > 0) {
                this.liveCount = this.liveCount - 1;
            }
            if (this.waiting > 0) {
                this.gate.Signal();
            }
            return;
        }
        this.idle.Add(c);
        if (this.waiting > 0) {
            this.gate.Signal();
        }
    }

    /// <summary>Number of idle (pooled, ready-to-use) connections.</summary>
    int IdleCount() {
        return this.idle.Count;
    }

    /// <summary>Total live connections (idle + checked out).</summary>
    int LiveCount() {
        return this.liveCount;
    }

    /// <summary>Coroutines currently parked waiting for a connection.</summary>
    int WaitingCount() {
        return this.waiting;
    }

    /// <summary>Upper bound on live connections.</summary>
    int MaxSize() {
        return this.maxSize;
    }

    /// <summary>True once <see cref="Close"/> has run.</summary>
    bool IsClosed() {
        return this.closed;
    }

    int GetProvider() {
        return DbProvider.Firebird;
    }

    /// <summary>Closes all idle connections and marks the pool closed. Waiters
    /// are woken and get null; connections still checked out are closed when
    /// they are released.</summary>
    void Close() {
        this.closed = true;
        while (this.idle.Count > 0) {
            int last = this.idle.Count - 1;
            FirebirdConnection c = this.idle[last];
            this.idle.RemoveAt(last);
            c.Close();
            if (this.liveCount > 0) {
                this.liveCount = this.liveCount - 1;
            }
        }
        int n = this.waiting;
        int k = 0;
        while (k < n) {
            this.gate.Signal();
            k = k + 1;
        }
    }
}
