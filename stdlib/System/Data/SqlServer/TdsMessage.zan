using System;
using System.Data;

namespace System.Data.SqlServer;

/// <summary>TDS 报文类型及报文头的状态位。</summary>
class TdsPacket {
    static int SQLBATCH = 1;      // 0x01
    static int RPC      = 3;      // 0x03
    static int REPLY    = 4;      // 0x04
    static int ATTENTION = 6;     // 0x06
    static int LOGIN7   = 16;     // 0x10
    static int PRELOGIN = 18;     // 0x12

    static int STATUS_NORMAL = 0;
    static int STATUS_EOM    = 1;

    static int HEADER_LEN = 8;
    static int DEFAULT_SIZE = 4096;

    /// <summary>将载荷包进八字节报文头。
    /// 长度字段包含报文头本身且为大端序，与协议中其他
    /// 整数不同。</summary>
    static TdsBytes Frame(int type, int status, int packetId, TdsBytes payload,
            int off, int len) {
        TdsBuf b = new TdsBuf();
        b.U8(type);
        b.U8(status);
        b.U16BE(len + TdsPacket.HEADER_LEN);
        b.U16BE(0);                 // SPID
        b.U8(packetId & 255);
        b.U8(0);                    // window
        for (int i = 0; i < len; i = i + 1) {
            b.U8(payload.At(off + i));
        }
        return b.ToBytes();
    }
}

/// <summary>解码一条 TDS 响应消息的结果。</summary>
class TdsResponse {
    DbResult rows;
    int affected;
    string error;
    int errorNumber;
    string serverVersion;
    string database;

    TdsResponse() {
        this.rows = new DbResult();
        this.affected = 0;
        this.error = "";
        this.errorNumber = 0;
        this.serverVersion = "";
        this.database = "";
    }

    DbResult Rows() { return this.rows; }
    int Affected() { return this.affected; }
    string Error() { return this.error; }
    int ErrorNumber() { return this.errorNumber; }
    string ServerVersion() { return this.serverVersion; }
    string Database() { return this.database; }
    bool Failed() { return this.error.Length > 0; }
}

/// <summary>
/// TDS 7.4 客户端消息的构建器，以及返回的
/// token 流的解码器。不涉及 IO，
/// 无需服务器即可测试线格式。
/// </summary>
class TdsMessage {
    static int TDS74 = 1946157060;      // 0x74000004

    // ============================================================
    // 客户端消息
    // ============================================================

    /// <summary>PRELOGIN：一张 (token, offset, length) 条目表，后跟
    /// 各条目载荷。<paramref name="encrypt"/> 是 ENCRYPTION 字节——0x02
    /// (NOT_SUP) 表示客户端不支持 TLS，配置了
    /// "force encryption" 的服务器会拒绝。</summary>
    static TdsBytes Prelogin(int encrypt) {
        // 三个选项：VERSION(0, 6 字节)、ENCRYPTION(1, 1)、MARS(4, 1)。
        int tableLen = 3 * 5 + 1;
        TdsBuf b = new TdsBuf();
        b.U8(0);                        // VERSION
        b.U16BE(tableLen);
        b.U16BE(6);
        b.U8(1);                        // ENCRYPTION
        b.U16BE(tableLen + 6);
        b.U16BE(1);
        b.U8(4);                        // MARS
        b.U16BE(tableLen + 7);
        b.U16BE(1);
        b.U8(255);                      // 终止符
        b.U8(16);                       // 版本 16.0.0.0
        b.U8(0);
        b.U16BE(0);
        b.U16BE(0);                     // 子构建号
        b.U8(encrypt);
        b.U8(0);                        // MARS 关闭
        return b.ToBytes();
    }

    /// <summary>服务器对 PRELOGIN 的应答，只取其中的 ENCRYPTION 字节
    /// （0 关闭、1 开启、2 不支持、3 必须）。</summary>
    static int PreloginEncryption(TdsBytes payload) {
        TdsReader r = TdsReader.Over(payload);
        while (!r.Eof()) {
            int token = r.U8();
            if (token == 255) { return 2; }
            int off = r.U16BE();
            int len = r.U16BE();
            if (token == 1 && len >= 1 && off < payload.Len()) {
                return payload.At(off);
            }
        }
        return 2;
    }

    /// <summary>LOGIN7：固定 94 字节的 offset/length 对头部，后跟
    /// 其指向的 UCS-2 字符串。</summary>
    static TdsBytes Login7(string host, string user, string password,
            string appName, string server, string database, int packetSize) {
        string libName = "zan";
        int dataStart = 94;
        int hostLen = host.Length;
        int userLen = user.Length;
        int passLen = password.Length;
        int appLen = appName.Length;
        int srvLen = server.Length;
        int libLen = libName.Length;
        int dbLen = database.Length;

        int off = dataStart;
        int hostOff = off; off = off + hostLen * 2;
        int userOff = off; off = off + userLen * 2;
        int passOff = off; off = off + passLen * 2;
        int appOff = off;  off = off + appLen * 2;
        int srvOff = off;  off = off + srvLen * 2;
        int libOff = off;  off = off + libLen * 2;
        int dbOff = off;   off = off + dbLen * 2;
        int total = off;

        TdsBuf b = new TdsBuf();
        b.U32LE(total);
        b.U32LE(TdsMessage.TDS74);
        b.U32LE(packetSize);
        b.U32LE(0);                     // 客户端程序版本
        b.U32LE(0);                     // 客户端 PID
        b.U32LE(0);                     // 连接 ID
        b.U8(0);                        // OptionFlags1：小端、ASCII、IEEE 浮点
        b.U8(0);                        // OptionFlags2
        b.U8(0);                        // TypeFlags
        b.U8(0);                        // OptionFlags3
        b.U32LE(0);                     // 客户端时区
        b.U32LE(0);                     // 客户端 LCID

        b.U16LE(hostOff); b.U16LE(hostLen);
        b.U16LE(userOff); b.U16LE(userLen);
        b.U16LE(passOff); b.U16LE(passLen);
        b.U16LE(appOff);  b.U16LE(appLen);
        b.U16LE(srvOff);  b.U16LE(srvLen);
        b.U16LE(0);       b.U16LE(0);   // 未使用 / 扩展
        b.U16LE(libOff);  b.U16LE(libLen);
        b.U16LE(0);       b.U16LE(0);   // 语言：服务器默认
        b.U16LE(dbOff);   b.U16LE(dbLen);
        for (int i = 0; i < 6; i = i + 1) { b.U8(0); }   // 客户端 MAC 地址
        b.U16LE(0); b.U16LE(0);         // SSPI
        b.U16LE(0); b.U16LE(0);         // 附加的数据库文件
        b.U16LE(0); b.U16LE(0);         // 修改密码
        b.U32LE(0);                     // 长 SSPI 长度

        b.Ucs2(host);
        b.Ucs2(user);
        b.Password(password);
        b.Ucs2(appName);
        b.Ucs2(server);
        b.Ucs2(libName);
        b.Ucs2(database);
        return b.ToBytes();
    }

    /// <summary>TDS 7.2 及以上要求在批次或 RPC 之前
    /// 的 ALL_HEADERS 块：只需要事务描述符。</summary>
    static TdsBuf AllHeaders(TdsBuf b) {
        b.U32LE(22);                    // 总长度
        b.U32LE(18);                    // 本头长度
        b.U16LE(2);                     // 类型：事务描述符
        b.U64LE(0);                     // 事务描述符
        b.U32LE(1);                     // 未完成的请求数
        return b;
    }

    /// <summary>SQLBatch 载荷：头部加 UCS-2 编码的语句。</summary>
    static TdsBytes SqlBatch(string sql) {
        TdsBuf b = new TdsBuf();
        TdsMessage.AllHeaders(b);
        b.Ucs2(sql);
        return b.ToBytes();
    }

    /// <summary>
    /// 调用 sp_executesql 的 RPC 载荷，参数正是借此
    /// 带外传输：值从不拼进语句文本，因此无需转义，
    /// 服务器也能复用执行计划。
    /// </summary>
    static TdsBytes RpcExecuteSql(string sql, DbParams prms) {
        TdsBuf b = new TdsBuf();
        TdsMessage.AllHeaders(b);
        b.U16LE(65535);                 // 后跟 ID 而非名称
        b.U16LE(10);                    // sp_executesql
        b.U16LE(0);                     // 选项标志

        TdsMessage.NVarcharParam(b, "", sql);
        TdsMessage.NVarcharParam(b, "", TdsMessage.Declaration(prms));
        for (int i = 0; i < prms.Count(); i = i + 1) {
            string name = "@P" + Convert.ToString(i + 1);
            int kind = prms.KindAt(i);
            if (kind == DbParams.KindInt) {
                TdsMessage.IntParam(b, name, prms.IntAt(i));
            } else if (kind == DbParams.KindDouble) {
                TdsMessage.FloatParam(b, name, prms.DoubleAt(i));
            } else if (kind == DbParams.KindNull) {
                TdsMessage.NullParam(b, name);
            } else {
                TdsMessage.NVarcharParam(b, name, prms.TextAt(i));
            }
        }
        return b.ToBytes();
    }

    /// <summary>sp_executesql 所需的 "@P1 bigint, @P2 float" 声明串。</summary>
    static string Declaration(DbParams prms) {
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < prms.Count(); i = i + 1) {
            if (i > 0) { sb.Append(", "); }
            sb.Append("@P");
            sb.Append(Convert.ToString(i + 1));
            int kind = prms.KindAt(i);
            if (kind == DbParams.KindInt) {
                sb.Append(" bigint");
            } else {
                if (kind == DbParams.KindDouble) {
                    sb.Append(" float");
                } else {
                    sb.Append(" nvarchar(max)");
                }
            }
        }
        return sb.ToString();
    }

    static void ParamHeader(TdsBuf b, string name) {
        b.U8(name.Length);
        b.Ucs2(name);
        b.U8(0);                        // 状态：输入参数
    }

    /// <summary>NVARCHAR 参数。超过 4000 字符的文本无法放入
    /// 定长格式，改为以 PLP 分块按 NVARCHAR(MAX) 发送。</summary>
    static void NVarcharParam(TdsBuf b, string name, string val) {
        TdsMessage.ParamHeader(b, name);
        b.U8(TdsType.NVARCHAR);
        int bytes = val.Length * 2;
        if (val.Length <= 4000) {
            b.U16LE(8000);
            b.U32LE(0); b.U8(0);        // 排序规则：服务器默认
            b.U16LE(bytes);
            b.Ucs2(val);
            return;
        }
        b.U16LE(65535);                 // MAX
        b.U32LE(0); b.U8(0);
        b.U64LE(bytes);                 // PLP 总长度
        b.U32LE(bytes);                 // 单个分块
        b.Ucs2(val);
        b.U32LE(0);                     // 终止符
    }

    static void IntParam(TdsBuf b, string name, long val) {
        TdsMessage.ParamHeader(b, name);
        b.U8(TdsType.INTN);
        b.U8(8);                        // 声明为 bigint
        b.U8(8);                        // 存在，八字节
        b.U64LE(val);
    }

    static void FloatParam(TdsBuf b, string name, double val) {
        TdsMessage.ParamHeader(b, name);
        b.U8(TdsType.FLTN);
        b.U8(8);
        b.U8(8);
        b.U64LE(TdsMessage.DoubleBits(val));
    }

    static void NullParam(TdsBuf b, string name) {
        TdsMessage.ParamHeader(b, name);
        b.U8(TdsType.NVARCHAR);
        b.U16LE(8000);
        b.U32LE(0); b.U8(0);
        b.U16LE(65535);                 // NULL
    }

    /// <summary>double 的 IEEE-754 位模式：对数值做归一化来构造，
    /// 因为语言没有 reinterpret 转换。非有限值单独处理：±∞ 与 NaN
    /// 会让下面的归一化循环永不终止（∞/2 还是 ∞）——一次
    /// AddDouble(Infinity) 就把协程永久钉死。</summary>
    static long DoubleBits(double v) {
        if (v != v) { return 0x7FF8000000000000L; }          // NaN（quiet）
        if (v == 0.0) { return 0; }
        int sign = 0;
        if (v < 0.0) {
            sign = 1;
            v = 0.0 - v;
        }
        if (v > 1.7976931348623157e308) {                    // ±Infinity
            return ((long)sign << 63) | 0x7FF0000000000000L;
        }
        int exp = 0;
        while (v >= 2.0) { v = v / 2.0; exp = exp + 1; }
        while (v < 1.0) { v = v * 2.0; exp = exp - 1; }
        double frac = v - 1.0;
        long mant = 0;
        for (int i = 0; i < 52; i = i + 1) {
            frac = frac * 2.0;
            int bit = 0;
            if (frac >= 1.0) {
                bit = 1;
                frac = frac - 1.0;
            }
            mant = (mant << 1) | bit;
        }
        return ((long)sign << 63) | ((long)(exp + 1023) << 52) | mant;
    }

    // ============================================================
    // Token 流
    // ============================================================

    static int TOK_RETURNSTATUS = 121;  // 0x79
    static int TOK_COLMETADATA  = 129;  // 0x81
    static int TOK_TABNAME      = 164;  // 0xA4
    static int TOK_COLINFO      = 165;  // 0xA5
    static int TOK_ORDER        = 169;  // 0xA9
    static int TOK_ERROR        = 170;  // 0xAA
    static int TOK_INFO         = 171;  // 0xAB
    static int TOK_RETURNVALUE  = 172;  // 0xAC
    static int TOK_LOGINACK     = 173;  // 0xAD
    static int TOK_FEATUREACK   = 174;  // 0xAE
    static int TOK_ROW          = 209;  // 0xD1
    static int TOK_NBCROW       = 210;  // 0xD2
    static int TOK_SSPI         = 237;  // 0xED
    static int TOK_ENVCHANGE    = 227;  // 0xE3
    static int TOK_DONE         = 253;  // 0xFD
    static int TOK_DONEPROC     = 254;  // 0xFE
    static int TOK_DONEINPROC   = 255;  // 0xFF

    /// <summary>解码完整的响应消息。</summary>
    static TdsResponse Decode(TdsBytes buf) {
        TdsResponse resp = new TdsResponse();
        TdsReader r = TdsReader.Over(buf);
        List<TdsColumn> cols = new List<TdsColumn>();
        bool haveRows = false;

        while (!r.Eof()) {
            int token = r.U8();
            if (token == TdsMessage.TOK_COLMETADATA) {
                cols = TdsMessage.ReadColumns(r, resp);
                haveRows = cols.Count > 0;
            } else if (token == TdsMessage.TOK_ROW) {
                TdsMessage.ReadRow(r, cols, resp, false);
            } else if (token == TdsMessage.TOK_NBCROW) {
                TdsMessage.ReadRow(r, cols, resp, true);
            } else if (token == TdsMessage.TOK_ERROR) {
                TdsMessage.ReadError(r, resp);
            } else if (token == TdsMessage.TOK_INFO) {
                r.Skip(r.U16LE());
            } else if (token == TdsMessage.TOK_LOGINACK) {
                TdsMessage.ReadLoginAck(r, resp);
            } else if (token == TdsMessage.TOK_ENVCHANGE) {
                TdsMessage.ReadEnvChange(r, resp);
            } else if (token == TdsMessage.TOK_DONE
                    || token == TdsMessage.TOK_DONEPROC
                    || token == TdsMessage.TOK_DONEINPROC) {
                int status = r.U16LE();
                r.U16LE();                      // 当前命令
                long count = r.UIntLE(8);
                if ((status & 16) != 0 && !haveRows) {
                    resp.affected = (int)count;
                }
            } else if (token == TdsMessage.TOK_RETURNSTATUS) {
                r.Skip(4);
            } else if (token == TdsMessage.TOK_ORDER
                    || token == TdsMessage.TOK_TABNAME
                    || token == TdsMessage.TOK_COLINFO
                    || token == TdsMessage.TOK_SSPI) {
                r.Skip(r.U16LE());
            } else if (token == TdsMessage.TOK_FEATUREACK) {
                TdsMessage.SkipFeatureAck(r);
            } else if (token == TdsMessage.TOK_RETURNVALUE) {
                TdsMessage.SkipReturnValue(r);
            } else {
                // 未知 token 没有长度前缀可供跳过，因此剩余
                // 的流无法再解析。
                return resp;
            }
        }
        if (haveRows) {
            resp.affected = resp.rows.RowCount();
        }
        return resp;
    }

    static List<TdsColumn> ReadColumns(TdsReader r, TdsResponse resp) {
        List<TdsColumn> cols = new List<TdsColumn>();
        int count = r.U16LE();
        if (count == 65535) { return cols; }    // 该批次无元数据
        for (int i = 0; i < count; i = i + 1) {
            r.Skip(4);                          // 用户类型
            r.Skip(2);                          // 标志
            TdsColumn c = new TdsColumn();
            TdsValue.ReadTypeInfo(r, c);
            c.name = r.BVarchar();
            cols.Add(c);
        }
        resp.rows.SetColumnCount(cols.Count);
        for (int j = 0; j < cols.Count; j = j + 1) {
            resp.rows.AddColumnName(cols[j].Name());
        }
        return cols;
    }

    /// <summary>ROW，或 NBCROW——前导位图标记 NULL 列，
    /// 这些列的值完全省略。</summary>
    static void ReadRow(TdsReader r, List<TdsColumn> cols, TdsResponse resp,
            bool nbc) {
        List<int> bitmap = new List<int>();
        if (nbc) {
            int bytes = (cols.Count + 7) / 8;
            for (int i = 0; i < bytes; i = i + 1) {
                bitmap.Add(r.U8());
            }
        }
        List<string> row = new List<string>();
        List<bool> nulls = new List<bool>();
        for (int c = 0; c < cols.Count; c = c + 1) {
            bool isNull = false;
            if (nbc && ((bitmap[c / 8] >> (c % 8)) & 1) == 1) {
                isNull = true;
            }
            if (isNull) {
                row.Add("");
                nulls.Add(true);
            } else {
                TdsCell cell = TdsValue.ReadValue(r, cols[c]);
                row.Add(cell.Text());
                nulls.Add(cell.IsNull());
            }
        }
        resp.rows.AddRowNulls(row, nulls);
    }

    static void ReadError(TdsReader r, TdsResponse resp) {
        int len = r.U16LE();
        int end = r.Pos() + len;
        int number = r.U32LE();
        r.U8();                             // 状态
        r.U8();                             // 严重级别
        string msg = r.UsVarchar();
        r.Seek(end);
        if (resp.error.Length == 0) {
            resp.error = msg;
            resp.errorNumber = number;
        }
    }

    static void ReadLoginAck(TdsReader r, TdsResponse resp) {
        int len = r.U16LE();
        int end = r.Pos() + len;
        r.U8();                             // 接口
        r.Skip(4);                          // TDS 版本
        r.BVarchar();                       // 程序名
        int major = r.U8();
        int minor = r.U8();
        int build = r.U16BE();
        resp.serverVersion = Convert.ToString(major) + "." + Convert.ToString(minor)
            + "." + Convert.ToString(build);
        r.Seek(end);
    }

    /// <summary>ENVCHANGE 报告登录带来的环境变化；只有数据库名
    /// 值得保留，其余只需跳过。</summary>
    static void ReadEnvChange(TdsReader r, TdsResponse resp) {
        int len = r.U16LE();
        int end = r.Pos() + len;
        int kind = r.U8();
        if (kind == 1) {                    // 数据库
            resp.database = r.BVarchar();
        }
        r.Seek(end);
    }

    static void SkipFeatureAck(TdsReader r) {
        bool more = true;
        while (more) {
            int id = r.U8();
            if (id == 255) {
                more = false;
            } else {
                r.Skip(r.U32LE());
            }
        }
    }

    static void SkipReturnValue(TdsReader r) {
        r.Skip(2);                          // 参数序号
        r.BVarchar();                       // 参数名
        r.U8();                             // 状态
        r.Skip(4);                          // 用户类型
        r.Skip(2);                          // 标志
        TdsColumn c = new TdsColumn();
        TdsValue.ReadTypeInfo(r, c);
        TdsValue.ReadValue(r, c);
    }
}
