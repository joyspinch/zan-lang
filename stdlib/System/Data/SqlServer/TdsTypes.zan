using System;
using System.Data;

namespace System.Data.SqlServer;

/// <summary>TDS data type ids (TYPE_INFO), grouped by how their length is
/// carried on the wire.</summary>
class TdsType {
    // Fixed length, no length byte on the wire.
    static int NULLTYPE  = 31;    // 0x1F
    static int INT1      = 48;    // 0x30
    static int BIT       = 50;    // 0x32
    static int INT2      = 52;    // 0x34
    static int INT4      = 56;    // 0x38
    static int DATETIM4  = 58;    // 0x3A
    static int FLT4      = 59;    // 0x3B
    static int MONEY     = 60;    // 0x3C
    static int DATETIME  = 61;    // 0x3D
    static int FLT8      = 62;    // 0x3E
    static int MONEY4    = 122;   // 0x7A
    static int INT8      = 127;   // 0x7F

    // One length byte in TYPE_INFO and in the row.
    static int GUIDN     = 36;    // 0x24
    static int INTN      = 38;    // 0x26
    static int DECIMAL   = 55;    // 0x37
    static int NUMERIC   = 63;    // 0x3F
    static int BITN      = 104;   // 0x68
    static int DECIMALN  = 106;   // 0x6A
    static int NUMERICN  = 108;   // 0x6C
    static int FLTN      = 109;   // 0x6D
    static int MONEYN    = 110;   // 0x6E
    static int DATETIMN  = 111;   // 0x6F
    static int DATEN     = 40;    // 0x28
    static int TIMEN     = 41;    // 0x29
    static int DATETIME2N = 42;   // 0x2A
    static int DTOFFSETN = 43;    // 0x2B
    static int CHAR      = 47;    // 0x2F
    static int VARCHAR   = 39;    // 0x27
    static int BINARY    = 45;    // 0x2D
    static int VARBINARY = 37;    // 0x25

    // Two length bytes; 0xFFFF as the declared size means MAX (PLP rows).
    static int BIGVARBIN = 165;   // 0xA5
    static int BIGVARCHR = 167;   // 0xA7
    static int BIGBINARY = 173;   // 0xAD
    static int BIGCHAR   = 175;   // 0xAF
    static int NVARCHAR  = 231;   // 0xE7
    static int NCHAR     = 239;   // 0xEF
    static int XML       = 241;   // 0xF1
    static int UDT       = 240;   // 0xF0

    // Four length bytes plus a text pointer in the row.
    static int TEXT      = 35;    // 0x23
    static int IMAGE     = 34;    // 0x22
    static int NTEXT     = 99;    // 0x63

    /// <summary>Whether the type's text is UCS-2 rather than single-byte.</summary>
    static bool IsWide(int t) {
        return t == TdsType.NVARCHAR || t == TdsType.NCHAR
            || t == TdsType.NTEXT || t == TdsType.XML;
    }

    /// <summary>Whether values of the type are raw bytes (rendered as hex).</summary>
    static bool IsBinary(int t) {
        return t == TdsType.BINARY || t == TdsType.VARBINARY
            || t == TdsType.BIGBINARY || t == TdsType.BIGVARBIN
            || t == TdsType.IMAGE || t == TdsType.UDT;
    }
}

/// <summary>One column of a result set, as described by COLMETADATA.</summary>
class TdsColumn {
    string name;
    int type;
    int size;       // declared length; 0xFFFF marks a MAX (PLP) column
    int precision;
    int scale;

    TdsColumn() {
        this.name = "";
        this.type = 0;
        this.size = 0;
        this.precision = 0;
        this.scale = 0;
    }

    static TdsColumn Create() { return new TdsColumn(); }

    string Name() { return this.name; }
    int Type() { return this.type; }
    int Size() { return this.size; }
    int Scale() { return this.scale; }
    int Precision() { return this.precision; }
}

/// <summary>One decoded cell: NULL is distinct from the empty string, which is
/// why the text cannot carry the answer on its own.</summary>
class TdsCell {
    string text;
    bool isNull;

    TdsCell(string text, bool isNull) {
        this.text = text;
        this.isNull = isNull;
    }

    static TdsCell Of(string text) { return new TdsCell(text, false); }
    static TdsCell Null() { return new TdsCell("", true); }

    string Text() { return this.text; }
    bool IsNull() { return this.isNull; }
}

/// <summary>
/// Decoding of TYPE_INFO descriptors and of the row values that follow them.
/// Every value is rendered to text: SQL Server sends fifteen-odd binary
/// encodings and <see cref="DbResult"/> is text-based, so the conversion has to
/// happen somewhere and doing it here keeps it shared by every caller.
/// </summary>
class TdsValue {
    static string HEX = "0123456789abcdef";

    /// <summary>Reads a TYPE_INFO descriptor into <paramref name="col"/>.</summary>
    static void ReadTypeInfo(TdsReader r, TdsColumn col) {
        int t = r.U8();
        col.type = t;
        if (t == TdsType.GUIDN || t == TdsType.INTN || t == TdsType.BITN
                || t == TdsType.FLTN || t == TdsType.MONEYN
                || t == TdsType.DATETIMN || t == TdsType.CHAR
                || t == TdsType.VARCHAR || t == TdsType.BINARY
                || t == TdsType.VARBINARY) {
            col.size = r.U8();
            return;
        }
        if (t == TdsType.DECIMAL || t == TdsType.NUMERIC
                || t == TdsType.DECIMALN || t == TdsType.NUMERICN) {
            col.size = r.U8();
            col.precision = r.U8();
            col.scale = r.U8();
            return;
        }
        if (t == TdsType.DATEN) { return; }
        if (t == TdsType.TIMEN || t == TdsType.DATETIME2N || t == TdsType.DTOFFSETN) {
            col.scale = r.U8();
            return;
        }
        if (t == TdsType.BIGVARBIN || t == TdsType.BIGBINARY) {
            col.size = r.U16LE();
            return;
        }
        if (t == TdsType.BIGVARCHR || t == TdsType.BIGCHAR
                || t == TdsType.NVARCHAR || t == TdsType.NCHAR) {
            col.size = r.U16LE();
            r.Skip(5);              // collation
            return;
        }
        if (t == TdsType.TEXT || t == TdsType.NTEXT) {
            col.size = r.U32LE();
            r.Skip(5);              // collation
            TdsValue.SkipTableName(r);
            return;
        }
        if (t == TdsType.IMAGE) {
            col.size = r.U32LE();
            TdsValue.SkipTableName(r);
            return;
        }
        if (t == TdsType.XML) {
            int schema = r.U8();
            if (schema == 1) {
                r.BVarchar();       // database
                r.BVarchar();       // owning schema
                r.UsVarchar();      // schema collection
            }
            col.size = 65535;
            return;
        }
        if (t == TdsType.UDT) {
            col.size = r.U16LE();
            r.BVarchar();
            r.BVarchar();
            r.BVarchar();
            r.UsVarchar();
            return;
        }
        // Fixed-length types carry their width in the id itself.
        col.size = TdsValue.FixedWidth(t);
    }

    static void SkipTableName(TdsReader r) {
        int parts = r.U8();
        int i = 0;
        while (i < parts) {
            r.UsVarchar();
            i = i + 1;
        }
    }

    static int FixedWidth(int t) {
        if (t == TdsType.INT1 || t == TdsType.BIT) { return 1; }
        if (t == TdsType.INT2) { return 2; }
        if (t == TdsType.INT4 || t == TdsType.FLT4 || t == TdsType.DATETIM4
                || t == TdsType.MONEY4) { return 4; }
        if (t == TdsType.INT8 || t == TdsType.FLT8 || t == TdsType.MONEY
                || t == TdsType.DATETIME) { return 8; }
        return 0;
    }

    /// <summary>Reads one row value for <paramref name="col"/>.</summary>
    static TdsCell ReadValue(TdsReader r, TdsColumn col) {
        int t = col.type;
        int fixedLen = TdsValue.FixedWidth(t);
        if (fixedLen > 0 && t != TdsType.INTN) {
            return TdsValue.Scalar(r, t, fixedLen, col);
        }
        if (t == TdsType.NULLTYPE) { return TdsCell.Null(); }

        if (t == TdsType.TEXT || t == TdsType.NTEXT || t == TdsType.IMAGE) {
            int ptrLen = r.U8();
            if (ptrLen == 0) { return TdsCell.Null(); }
            r.Skip(ptrLen);
            r.Skip(8);              // timestamp
            return TdsValue.Text(r, r.U32LE(), t);
        }

        if (TdsValue.IsLarge(t)) {
            if (col.size == 65535) {
                return TdsValue.ReadPlp(r, t);
            }
            int n = r.U16LE();
            if (n == 65535) { return TdsCell.Null(); }
            return TdsValue.Text(r, n, t);
        }

        // Everything else is length-prefixed by a single byte.
        int n = r.U8();
        if (n == 0) { return TdsCell.Null(); }
        if (t == TdsType.CHAR || t == TdsType.VARCHAR
                || t == TdsType.BINARY || t == TdsType.VARBINARY) {
            if (n == 255) { return TdsCell.Null(); }
            return TdsValue.Text(r, n, t);
        }
        return TdsValue.Scalar(r, t, n, col);
    }

    static bool IsLarge(int t) {
        return t == TdsType.BIGVARCHR || t == TdsType.BIGCHAR
            || t == TdsType.BIGVARBIN || t == TdsType.BIGBINARY
            || t == TdsType.NVARCHAR || t == TdsType.NCHAR
            || t == TdsType.XML || t == TdsType.UDT;
    }

    /// <summary>PLP: an eight-byte total length (or the unknown/NULL markers),
    /// then chunks until a zero-length one. The chunks are gathered into one
    /// counted block first, since a value may straddle them.</summary>
    static TdsCell ReadPlp(TdsReader r, int t) {
        int hi = r.U32LE();
        int lo = r.U32LE();
        if (hi == 0 - 1 && lo == 0 - 1) { return TdsCell.Null(); }
        TdsBuf acc = TdsBuf.Create();
        bool more = true;
        while (more) {
            int chunk = r.U32LE();
            if (chunk <= 0) {
                more = false;
            } else {
                int i = 0;
                while (i < chunk) {
                    acc.U8(r.U8());
                    i = i + 1;
                }
            }
        }
        TdsBytes all = acc.ToBytes();
        TdsReader rr = TdsReader.Over(all);
        TdsCell cell = TdsValue.Text(rr, all.Len(), t);
        all.Release();
        return cell;
    }

    /// <summary>Renders the next <paramref name="n"/> bytes according to the
    /// column's family: hex for binary, UCS-2 for the national types, raw
    /// otherwise.</summary>
    static TdsCell Text(TdsReader r, int n, int t) {
        if (TdsType.IsBinary(t)) {
            return TdsCell.Of(TdsValue.Hex(r, n));
        }
        if (TdsType.IsWide(t)) {
            return TdsCell.Of(r.Ucs2(n / 2));
        }
        return TdsCell.Of(r.Narrow(n));
    }

    static string Hex(TdsReader r, int n) {
        StringBuilder sb = new StringBuilder();
        sb.Append("0x");
        int i = 0;
        while (i < n) {
            int v = r.U8();
            sb.Append(TdsValue.HEX.Substring((v >> 4) & 15, 1));
            sb.Append(TdsValue.HEX.Substring(v & 15, 1));
            i = i + 1;
        }
        return sb.ToString();
    }

    /// <summary>Numeric, temporal and GUID values, whose meaning depends on the
    /// byte count actually sent (INTN 4 is an int, INTN 8 a bigint).</summary>
    static TdsCell Scalar(TdsReader r, int t, int n, TdsColumn col) {
        if (t == TdsType.BIT || t == TdsType.BITN) {
            int v = r.U8();
            if (v == 0) { return TdsCell.Of("0"); }
            return TdsCell.Of("1");
        }
        if (t == TdsType.INT1) { return TdsCell.Of(Convert.ToString(r.U8())); }
        if (t == TdsType.INT2 || t == TdsType.INT4 || t == TdsType.INT8
                || t == TdsType.INTN) {
            return TdsCell.Of(Convert.ToString(r.IntLE(n)));
        }
        if (t == TdsType.FLT4 || t == TdsType.FLT8 || t == TdsType.FLTN) {
            return TdsCell.Of(TdsValue.Float(r, n));
        }
        if (t == TdsType.MONEY || t == TdsType.MONEY4 || t == TdsType.MONEYN) {
            return TdsCell.Of(TdsValue.Money(r, n));
        }
        if (t == TdsType.DECIMAL || t == TdsType.NUMERIC
                || t == TdsType.DECIMALN || t == TdsType.NUMERICN) {
            return TdsCell.Of(TdsValue.Numeric(r, n, col.scale));
        }
        if (t == TdsType.DATETIME || t == TdsType.DATETIM4
                || t == TdsType.DATETIMN) {
            return TdsCell.Of(TdsValue.LegacyDateTime(r, n));
        }
        if (t == TdsType.DATEN) {
            return TdsCell.Of(TdsValue.CivilDate((int)r.UIntLE(3) - 719162));
        }
        if (t == TdsType.TIMEN) {
            return TdsCell.Of(TdsValue.TimeOfDay(r.UIntLE(n), col.scale));
        }
        if (t == TdsType.DATETIME2N) {
            int timeLen = n - 3;
            string tod = TdsValue.TimeOfDay(r.UIntLE(timeLen), col.scale);
            string day = TdsValue.CivilDate((int)r.UIntLE(3) - 719162);
            return TdsCell.Of(day + " " + tod);
        }
        if (t == TdsType.DTOFFSETN) {
            int timeLen = n - 5;
            string tod = TdsValue.TimeOfDay(r.UIntLE(timeLen), col.scale);
            string day = TdsValue.CivilDate((int)r.UIntLE(3) - 719162);
            int off = (int)r.IntLE(2);
            return TdsCell.Of(day + " " + tod + " " + TdsValue.Offset(off));
        }
        if (t == TdsType.GUIDN) {
            return TdsCell.Of(TdsValue.Guid(r, n));
        }
        return TdsCell.Of(TdsValue.Hex(r, n));
    }

    static string Float(TdsReader r, int n) {
        if (n == 4) {
            long bits = r.UIntLE(4);
            return TdsValue.Ieee((int)((bits >> 31) & 1), (int)((bits >> 23) & 255),
                                 bits & 8388607, 127, 23);
        }
        long bits = r.UIntLE(8);
        return TdsValue.Ieee((int)((bits >> 63) & 1), (int)((bits >> 52) & 2047),
                             bits & 4503599627370495, 1023, 52);
    }

    /// <summary>2^e as a double (e may be negative).</summary>
    static double Pow2(int e) {
        double v = 1.0;
        int i = 0;
        if (e >= 0) {
            while (i < e) { v = v * 2.0; i = i + 1; }
        } else {
            while (i > e) { v = v / 2.0; i = i - 1; }
        }
        return v;
    }

    static string Ieee(int sign, int exp, long mant, int bias, int mantBits) {
        if (exp == 0 && mant == 0) { return "0"; }
        double m = 1.0;
        int b = mantBits - 1;
        while (b >= 0) {
            if (((mant >> b) & 1) == 1) { m = m + TdsValue.Pow2(b - mantBits); }
            b = b - 1;
        }
        double v = m * TdsValue.Pow2(exp - bias);
        if (sign == 1) { v = 0.0 - v; }
        return Convert.ToString(v);
    }

    /// <summary>MONEY is a scaled integer: four ten-thousandths per unit, with
    /// the eight-byte form sending its halves high word first.</summary>
    static string Money(TdsReader r, int n) {
        long units = 0;
        if (n == 4) {
            units = r.IntLE(4);
        } else {
            long hi = r.IntLE(4);
            long lo = r.UIntLE(4);
            units = (hi << 32) | lo;
        }
        return TdsValue.Scaled(units, 4);
    }

    /// <summary>DECIMAL/NUMERIC: a sign byte then a little-endian magnitude of
    /// up to sixteen bytes, which is why the digits are produced by repeated
    /// division over 32-bit limbs instead of by integer arithmetic.</summary>
    static string Numeric(TdsReader r, int n, int scale) {
        int sign = r.U8();
        int mlen = n - 1;
        List<int> limbs = new List<int>();       // little-endian 32-bit limbs
        int i = 0;
        while (i < mlen) {
            int shift = (i % 4) * 8;
            int byteVal = r.U8();
            if (shift == 0) {
                limbs.Add(byteVal);
            } else {
                int idx = limbs.Count - 1;
                limbs[idx] = limbs[idx] | (byteVal << shift);
            }
            i = i + 1;
        }
        string digits = TdsValue.LimbsToDecimal(limbs);
        while (digits.Length <= scale) { digits = "0" + digits; }
        string outp = digits;
        if (scale > 0) {
            int cut = digits.Length - scale;
            outp = digits.Substring(0, cut) + "." + digits.Substring(cut, scale);
        }
        if (sign == 0 && digits != "0") { outp = "-" + outp; }
        return outp;
    }

    static string LimbsToDecimal(List<int> limbs) {
        StringBuilder rev = new StringBuilder();
        bool any = true;
        while (any) {
            int rem = 0;
            int i = limbs.Count - 1;
            any = false;
            while (i >= 0) {
                long cur = ((long)rem << 32) | ((long)limbs[i] & 4294967295);
                long q = cur / 10;
                rem = (int)(cur - q * 10);
                limbs[i] = (int)(q & 4294967295);
                if (limbs[i] != 0) { any = true; }
                i = i - 1;
            }
            rev.Append(TdsValue.Digit(rem));
        }
        string s = rev.ToString();
        StringBuilder outp = new StringBuilder();
        int j = s.Length - 1;
        while (j >= 0) {
            outp.Append(s.Substring(j, 1));
            j = j - 1;
        }
        string res = outp.ToString();
        while (res.Length > 1 && res.Substring(0, 1) == "0") {
            res = res.Substring(1, res.Length - 1);
        }
        return res;
    }

    static string Digit(int v) {
        return TdsValue.HEX.Substring(v, 1);
    }

    /// <summary>Renders an integer that carries <paramref name="scale"/> implied
    /// decimals.</summary>
    static string Scaled(long units, int scale) {
        bool neg = units < 0;
        if (neg) { units = 0 - units; }
        string digits = Convert.ToString(units);
        while (digits.Length <= scale) { digits = "0" + digits; }
        int cut = digits.Length - scale;
        string outp = digits.Substring(0, cut) + "." + digits.Substring(cut, scale);
        if (neg) { outp = "-" + outp; }
        return outp;
    }

    /// <summary>DATETIME (8 bytes: days since 1900 plus 300ths of a second) and
    /// SMALLDATETIME (4 bytes: days plus whole minutes).</summary>
    static string LegacyDateTime(TdsReader r, int n) {
        if (n == 4) {
            int days = (int)r.UIntLE(2);
            int mins = (int)r.UIntLE(2);
            return TdsValue.CivilDate(days - 25567) + " "
                + TdsValue.Pad2(mins / 60) + ":" + TdsValue.Pad2(mins % 60) + ":00";
        }
        int days = (int)r.IntLE(4);
        int ticks = (int)r.UIntLE(4);
        int ms = (ticks * 10 + 1) / 3;      // 300ths of a second -> milliseconds
        int secs = ms / 1000;
        return TdsValue.CivilDate(days - 25567) + " "
            + TdsValue.Pad2(secs / 3600) + ":" + TdsValue.Pad2((secs / 60) % 60)
            + ":" + TdsValue.Pad2(secs % 60) + "." + TdsValue.Pad3(ms % 1000);
    }

    /// <summary>TIME/DATETIME2 keep a count of 10^-scale seconds. At scale 7 a
    /// day's worth of them is 8.64e11, so the count is a <c>long</c>.</summary>
    static string TimeOfDay(long ticks, int scale) {
        long div = 1;
        int i = 0;
        while (i < scale) { div = div * 10; i = i + 1; }
        int secs = (int)(ticks / div);
        string outp = TdsValue.Pad2(secs / 3600) + ":"
            + TdsValue.Pad2((secs / 60) % 60) + ":" + TdsValue.Pad2(secs % 60);
        if (scale > 0) {
            string frac = Convert.ToString(ticks - secs * div);
            while (frac.Length < scale) { frac = "0" + frac; }
            outp = outp + "." + frac;
        }
        return outp;
    }

    static string Offset(int minutes) {
        string sign = "+";
        if (minutes < 0) {
            sign = "-";
            minutes = 0 - minutes;
        }
        return sign + TdsValue.Pad2(minutes / 60) + ":" + TdsValue.Pad2(minutes % 60);
    }

    /// <summary>Gregorian date for a day count relative to 1970-01-01.</summary>
    static string CivilDate(int z) {
        z = z + 719468;
        int era = z / 146097;
        if (z < 0) { era = (z - 146096) / 146097; }
        int doe = z - era * 146097;
        int yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
        int y = yoe + era * 400;
        int doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
        int mp = (5 * doy + 2) / 153;
        int d = doy - (153 * mp + 2) / 5 + 1;
        int m = mp + 3;
        if (mp >= 10) { m = mp - 9; }
        if (m <= 2) { y = y + 1; }
        return TdsValue.Pad4(y) + "-" + TdsValue.Pad2(m) + "-" + TdsValue.Pad2(d);
    }

    /// <summary>Canonical GUID text: the first three groups are little-endian on
    /// the wire, the last two big-endian.</summary>
    static string Guid(TdsReader r, int n) {
        if (n < 16) {
            r.Skip(n);
            return "";
        }
        List<int> raw = new List<int>();
        int k = 0;
        while (k < 16) {
            raw.Add(r.U8());
            k = k + 1;
        }
        if (n > 16) { r.Skip(n - 16); }
        StringBuilder sb = new StringBuilder();
        sb.Append(TdsValue.HexAt(raw, 3));
        sb.Append(TdsValue.HexAt(raw, 2));
        sb.Append(TdsValue.HexAt(raw, 1));
        sb.Append(TdsValue.HexAt(raw, 0));
        sb.Append("-");
        sb.Append(TdsValue.HexAt(raw, 5));
        sb.Append(TdsValue.HexAt(raw, 4));
        sb.Append("-");
        sb.Append(TdsValue.HexAt(raw, 7));
        sb.Append(TdsValue.HexAt(raw, 6));
        sb.Append("-");
        sb.Append(TdsValue.HexAt(raw, 8));
        sb.Append(TdsValue.HexAt(raw, 9));
        sb.Append("-");
        int i = 10;
        while (i < 16) {
            sb.Append(TdsValue.HexAt(raw, i));
            i = i + 1;
        }
        return sb.ToString();
    }

    static string HexAt(List<int> raw, int i) {
        int v = raw[i] & 255;
        return TdsValue.HEX.Substring((v >> 4) & 15, 1) + TdsValue.HEX.Substring(v & 15, 1);
    }

    static string Pad2(int v) {
        if (v < 10) { return "0" + Convert.ToString(v); }
        return Convert.ToString(v);
    }

    static string Pad3(int v) {
        string s = Convert.ToString(v);
        while (s.Length < 3) { s = "0" + s; }
        return s;
    }

    static string Pad4(int v) {
        string s = Convert.ToString(v);
        while (s.Length < 4) { s = "0" + s; }
        return s;
    }
}
