using System;
using System.Data;
using System.Threading;

namespace System.Data.SqlServer;

/// <summary>
/// Coroutine-aware connection pool for <see cref="SqlServerConnection"/>.
///
/// Same contract as <see cref="DbPool"/> -- lazy growth up to <c>maxSize</c>,
/// <see cref="Gate"/>-driven waiting rather than polling, eviction of dead
/// connections -- but typed, so the coroutine query API (<c>QueryAsync</c>,
/// <c>ExecuteAsync</c>) stays reachable. A TDS login costs several round trips,
/// which is the reason to keep sessions rather than open one per statement.
///
/// Usage:
///   SqlServerPool pool = SqlServerPool.Create("127.0.0.1", 1433, "master", "sa", "secret", 8);
///   SqlServerConnection db = await pool.AcquireAsync();
///   DbResult r = await db.QueryAsync("SELECT TOP 10 * FROM sys.objects");
///   pool.Release(db);
///   pool.Close();
/// </summary>
class SqlServerPool {
    string host;
    int port;
    string database;
    string user;
    string password;
    PoolCore<SqlServerConnection> core;

    SqlServerPool(string host, int port, string database, string user,
            string password, int maxSize) {
        this.host = host;
        this.port = port;
        this.database = database;
        this.user = user;
        this.password = password;
        this.core = PoolCore<SqlServerConnection>.Create(maxSize);
    }

    static SqlServerPool Create(string host, int port, string database,
            string user, string password, int maxSize) {
        return new SqlServerPool(host, port, database, user, password, maxSize);
    }

    async SqlServerConnection OpenOne() {
        return await SqlServerConnection.OpenAsync(this.host, this.port,
                                                   this.database, this.user,
                                                   this.password);
    }

    /// <summary>Checks out a connection: reuses an idle one, opens a new one if
    /// under the cap, otherwise suspends the coroutine until one is released.
    /// Returns null once the pool has been closed.</summary>
    async SqlServerConnection AcquireAsync() {{
        while (true) {{
            if (this.core.IsClosed()) {{
                return null;
            }}
            SqlServerConnection pooled = this.core.TakeIdle();
            while (pooled != null) {{
                // A connection can rot while parked (server restart, idle
                // timeout): evict it and free its slot for a waiter.
                if (pooled.IsConnected()) {{
                    return pooled;
                }}
                this.core.Drop();
                pooled = this.core.TakeIdle();
            }}
            if (this.core.TryReserve()) {{
                SqlServerConnection opened = await this.OpenOne();
                if (opened == null || !opened.IsConnected()) {{
                    this.core.UndoReserve();
                }}
                return opened;
            }}
            // Pool saturated: park until a connection is released.
            this.core.EnterWait();
            await this.core.Waiter().Wait();
            this.core.LeaveWait();
        }}
        return null;
    }}

    /// <summary>Returns a connection to the pool. A broken or post-Close()
    /// connection is closed and dropped instead of being pooled.</summary>
    void Release(SqlServerConnection c) {{
        if (c == null) {{
            return;
        }}
        if (this.core.IsClosed() || !c.IsConnected()) {{
            if (c.IsConnected()) {{
                c.Close();
            }}
            this.core.Drop();
            return;
        }}
        this.core.Pool(c);
    }}

    /// <summary>Number of idle (pooled, ready-to-use) connections.</summary>
    int IdleCount() {{
        return this.core.IdleCount();
    }}

    /// <summary>Total live connections (idle + checked out).</summary>
    int LiveCount() {{
        return this.core.LiveCount();
    }}

    /// <summary>Coroutines currently parked waiting for a connection.</summary>
    int WaitingCount() {
        return this.core.WaitingCount();
    }

    /// <summary>Maximum number of concurrently live connections.</summary>
    int MaxSize() {
        return this.core.MaxSize();
    }

    /// <summary>Closes all idle connections and marks the pool closed. Connections
    /// still checked out are closed when they are released.</summary>
    void Close() {{
        this.core.MarkClosed();
        SqlServerConnection c = this.core.TakeIdle();
        while (c != null) {{
            c.Close();
            this.core.Drop();
            c = this.core.TakeIdle();
        }}
        this.core.WakeAll();
    }}
}}
