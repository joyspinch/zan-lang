using System;
using System.Data;
using System.Threading;

namespace System.Data.SqlServer;

/// <summary>
/// Coroutine-aware connection pool for <see cref="SqlServerConnection"/>.
///
/// Same contract as <see cref="DbPool"/> -- lazy growth up to <c>maxSize</c>,
/// <see cref="Gate"/>-driven waiting rather than polling, eviction of dead
/// connections -- but typed, so the coroutine query API (<c>QueryAsync</c>,
/// <c>ExecuteAsync</c>) stays reachable. A TDS login costs several round trips,
/// which is the reason to keep sessions rather than open one per statement.
///
/// Usage:
///   SqlServerPool pool = SqlServerPool.Create("127.0.0.1", 1433, "master", "sa", "secret", 8);
///   SqlServerConnection db = await pool.AcquireAsync();
///   DbResult r = await db.QueryAsync("SELECT TOP 10 * FROM sys.objects");
///   pool.Release(db);
///   pool.Close();
/// </summary>
class SqlServerPool {
    string host;
    int port;
    string database;
    string user;
    string password;
    int maxSize;
    List<SqlServerConnection> idle;
    int liveCount;      // total opened connections (idle + checked out)
    int waiting;        // coroutines currently parked in AcquireAsync
    Gate gate;
    bool closed;

    SqlServerPool(string host, int port, string database, string user,
            string password, int maxSize) {
        this.host = host;
        this.port = port;
        this.database = database;
        this.user = user;
        this.password = password;
        this.maxSize = maxSize;
        this.idle = new List<SqlServerConnection>();
        this.liveCount = 0;
        this.waiting = 0;
        this.gate = Gate.Create();
        this.closed = false;
    }

    /// <summary>Pool using SQL Server authentication.</summary>
    static SqlServerPool Create(string host, int port, string database,
            string user, string password, int maxSize) {
        if (maxSize < 1) {
            maxSize = 1;
        }
        return new SqlServerPool(host, port, database, user, password, maxSize);
    }

    async SqlServerConnection OpenOne() {
        return await SqlServerConnection.OpenAsync(this.host, this.port,
                                                   this.database, this.user,
                                                   this.password);
    }

    /// <summary>Checks out a connection. Reuses an idle one, opens a new one if
    /// under the cap, otherwise suspends the coroutine until one is released.</summary>
    async SqlServerConnection AcquireAsync() {
        while (true) {
            if (this.closed) {
                return null;
            }
            if (this.idle.Count > 0) {
                int last = this.idle.Count - 1;
                SqlServerConnection c = this.idle[last];
                this.idle.RemoveAt(last);
                if (c.IsConnected()) {
                    return c;
                }
                if (this.liveCount > 0) {
                    this.liveCount = this.liveCount - 1;
                }
                continue;
            }
            if (this.liveCount < this.maxSize) {
                // Reserve the slot before suspending, so concurrent acquirers
                // cannot all see room and overshoot maxSize.
                this.liveCount = this.liveCount + 1;
                SqlServerConnection c = await OpenOne();
                if (c == null || !c.IsConnected()) {
                    this.liveCount = this.liveCount - 1;
                    if (this.waiting > 0) {
                        this.gate.Signal();
                    }
                }
                return c;
            }
            this.waiting = this.waiting + 1;
            await this.gate.Wait();
            this.waiting = this.waiting - 1;
        }
        return null;
    }

    /// <summary>Returns a connection to the pool. A broken or post-Close()
    /// connection is closed and dropped instead of being pooled.</summary>
    void Release(SqlServerConnection c) {
        if (c == null) {
            return;
        }
        if (this.closed || !c.IsConnected()) {
            c.Close();
            if (this.liveCount > 0) {
                this.liveCount = this.liveCount - 1;
            }
            if (this.waiting > 0) {
                this.gate.Signal();
            }
            return;
        }
        this.idle.Add(c);
        if (this.waiting > 0) {
            this.gate.Signal();
        }
    }

    /// <summary>Number of idle (pooled, ready-to-use) connections.</summary>
    int IdleCount() {
        return this.idle.Count;
    }

    /// <summary>Total live connections (idle + checked out).</summary>
    int LiveCount() {
        return this.liveCount;
    }

    /// <summary>Coroutines currently parked waiting for a connection.</summary>
    int WaitingCount() {
        return this.waiting;
    }

    /// <summary>Upper bound on live connections.</summary>
    int MaxSize() {
        return this.maxSize;
    }

    /// <summary>Closes all idle connections and marks the pool closed. Waiters
    /// are woken and get null; connections still checked out are closed when
    /// they are released.</summary>
    void Close() {
        this.closed = true;
        while (this.idle.Count > 0) {
            int last = this.idle.Count - 1;
            SqlServerConnection c = this.idle[last];
            this.idle.RemoveAt(last);
            c.Close();
            if (this.liveCount > 0) {
                this.liveCount = this.liveCount - 1;
            }
        }
        int n = this.waiting;
        int k = 0;
        while (k < n) {
            this.gate.Signal();
            k = k + 1;
        }
    }
}
