using System;

namespace System.Data;

/// <summary>
/// Opens fresh connections for a <see cref="DbPool"/>. Each driver ships a
/// connector holding its own endpoint/credentials, which is the only
/// provider-specific part of pooling; the pool itself is driver agnostic.
///
/// <c>ConnectAsync</c> is a coroutine: a driver with real network IO (MySQL,
/// PostgreSQL, TDengine, SQL Server, ...) must connect on the reactor so a
/// pool that grows never blocks the worker thread. Embedded engines (SQLite,
/// DuckDB) open synchronously and simply return -- the pool still gives them
/// coroutine-aware capacity control.
/// </summary>
interface IDbConnector {
    /// <summary>Opens one new connection, or returns a connection whose
    /// <c>IsConnected()</c> is false when the attempt failed.</summary>
    async IDbConnection ConnectAsync();

    /// <summary>The <see cref="DbProvider"/> id of the connections produced.</summary>
    int GetProvider();
}
