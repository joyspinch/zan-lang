using System;
using System.Data;
using System.Linq;

namespace System.Data.Orm;

/// <summary>
/// 类型化 SELECT 链的运行期实现：条件片段、绑定值、分组、排序、
/// 分页、连接与终端 SQL 都在这里，一份实现服务所有实体。生成的
/// `__DbQ_<E>` 只是它的类型化门面（转发 + 用实体类型收口结果）。
/// </summary>
class OrmSelect {
    IDbExecutor db;
    OrmMeta meta;
    string tbl;
    string w;
    DbParams ps;
    string ob;
    string gb;
    string h;
    bool distinct;
    int limN;
    int offN;
    bool on;
    List<bool> navOn;

    /// 私有构造；统一经 <see cref="Create"/> 创建。
    OrmSelect(IDbExecutor db, OrmMeta meta) {
        this.db = db;
        this.meta = meta;
        this.tbl = meta.Table;
        this.w = "";
        this.ps = new DbParams();
        this.ob = "";
        this.gb = "";
        this.h = "";
        this.distinct = false;
        this.limN = -1;
        this.offN = -1;
        this.on = true;
        this.navOn = new List<bool>();
        for (int i = 0; i < meta.Navs.Count; i = i + 1) { this.navOn.Add(false); }
    }

    /// 为实体创建一个空 SELECT 链。
    static OrmSelect Create(IDbExecutor db, OrmMeta meta) {
        return new OrmSelect(db, meta);
    }

    /// 实体元数据（类型化门面读取列信息用）。
    OrmMeta Meta() { return this.meta; }
    /// 当前积累的 WHERE 参数（类型化门面直接执行时复用）。
    DbParams Params() { return this.ps; }
    /// 分组键（类型化门面按分组取值用）。
    string GroupKey() { return this.gb; }
    /// 第 i 个导航字段是否被包含。
    bool NavOn(int i) { return this.navOn[i]; }

    /// WHERE 片段：多个片段以 AND 连接（列名一般带 "t." 别名）。
    void W(string f) {
        if (!this.on) { return; }
        if (this.w.Length == 0) { this.w = f; }
        else { this.w = this.w + " AND " + f; }
    }

    /// <summary>lambda 降级出的表达式树：SQL 片段与绑定值都由
    /// <see cref="ExprSql"/> 产出。</summary>
    void WExpr(ExprNode root) {
        if (!this.on) { return; }
        if (root == null) { return; }
        StringBuilder sb = new StringBuilder();
        ExprSql.Build(root, sb, this.ps);
        this.W(sb.ToString());
    }

    /// <summary>动态列集合等值条件：列名按实体校验，值按列声明类型
    /// 绑定。</summary>
    void WhereDict(DbValues v) {
        if (!this.on) { return; }
        int i = 0;
        while (i < v.Count()) {
            string c = this.meta.Require(v.NameAt(i));
            this.W("t." + c + " = ?");
            v.BindAs(this.ps, i, this.meta.KindOf(c));
            i = i + 1;
        }
    }

    /// 条件开关：false 期间 W/P* 收集的片段全部失效（ORM 内部
    /// 按条件组合调用）。
    void CondBegin(bool c) { this.on = c; }
    /// 结束条件区间，恢复片段收集。
    void CondEnd() { this.on = true; }
    /// 查另一张表（标识符校验，防注入）。
    void AsTable(string t) { this.tbl = QueryBuilder.RequireIdent(t); }
    /// WHERE 参数：与 W 片段中占位符的出现顺序一致。
    void P(string v) { if (this.on) { this.ps.Add(v); } }
    /// WHERE 整数参数。
    void Pi(int v) { if (this.on) { this.ps.AddInt(v); } }
    /// WHERE 64 位整数参数。
    void Pl(long v) { if (this.on) { this.ps.AddLong(v); } }
    /// WHERE 浮点参数。
    void Pd(double v) { if (this.on) { this.ps.AddDouble(v); } }

    /// IN 列表参数（配合 W 片段里的 "t.col IN (?)"）。
    void InI(List<int> vs) {
        if (!this.on) { return; }
        int i = 0;
        while (i < vs.Count) { this.ps.AddInt(vs[i]); i = i + 1; }
    }

    /// <see cref="InI"/> 的 long 版本。
    void InL(List<long> vs) {
        if (!this.on) { return; }
        int i = 0;
        while (i < vs.Count) { this.ps.AddLong(vs[i]); i = i + 1; }
    }

    /// <see cref="InI"/> 的 string 版本。
    void InS(List<string> vs) {
        if (!this.on) { return; }
        int i = 0;
        while (i < vs.Count) { this.ps.Add(vs[i]); i = i + 1; }
    }

    /// <see cref="InI"/> 的 double 版本。
    void InD(List<double> vs) {
        if (!this.on) { return; }
        int i = 0;
        while (i < vs.Count) { this.ps.AddDouble(vs[i]); i = i + 1; }
    }

    /* ---- 值自带条件原语：应用层拼条件的唯一入口 ----
     * 条件与其值在同一次调用里原子绑定，片段与参数没有分开传递的
     * 通道，顺序错配在编译期就写不出来。列名按实体元数据校验
     * （可省略 "t." 别名），不属于实体的列一律抛异常。 */

    /// 校验列名属于本实体并补全 "t." 别名；未知列抛异常。
    string RequireCol(string c) {
        string n = c;
        if (n.Length > 2 && n.IndexOf("t.") == 0) { n = n.Substring(2); }
        if (!this.meta.Has(n)) {
            throw new Exception(this.meta.Table + " has no column: " + c);
        }
        return "t." + n;
    }

    /// column = 文本值。
    void WhereEq(string c, string v) {
        if (!this.on) { return; }
        this.W(this.RequireCol(c) + " = ?");
        this.ps.Add(v);
    }

    /// column = 整数值。
    void WhereEq(string c, int v) {
        if (!this.on) { return; }
        this.W(this.RequireCol(c) + " = ?");
        this.ps.AddInt(v);
    }

    /// column = 64 位整数值。
    void WhereEq(string c, long v) {
        if (!this.on) { return; }
        this.W(this.RequireCol(c) + " = ?");
        this.ps.AddLong(v);
    }

    /// column &gt;= 整数值。
    void WhereGe(string c, long v) {
        if (!this.on) { return; }
        this.W(this.RequireCol(c) + " >= ?");
        this.ps.AddLong(v);
    }

    /// column &lt;= 整数值。
    void WhereLe(string c, long v) {
        if (!this.on) { return; }
        this.W(this.RequireCol(c) + " <= ?");
        this.ps.AddLong(v);
    }

    /// column IN (逐个占位符)；空列表按恒假处理，不生成 `IN ()`。
    void WhereIn(string c, List<int> vs) {
        if (!this.on) { return; }
        if (vs.Count == 0) { this.W("1 = 0"); return; }
        StringBuilder sb = new StringBuilder(this.RequireCol(c) + " IN (");
        for (int i = 0; i < vs.Count; i = i + 1) {
            if (i > 0) { sb.Append(", "); }
            sb.Append("?");
            this.ps.AddInt(vs[i]);
        }
        this.W(sb.Append(")").ToString());
    }

    /// <see cref="WhereIn"/> 的 long 版本。
    void WhereIn(string c, List<long> vs) {
        if (!this.on) { return; }
        if (vs.Count == 0) { this.W("1 = 0"); return; }
        StringBuilder sb = new StringBuilder(this.RequireCol(c) + " IN (");
        for (int i = 0; i < vs.Count; i = i + 1) {
            if (i > 0) { sb.Append(", "); }
            sb.Append("?");
            this.ps.AddLong(vs[i]);
        }
        this.W(sb.Append(")").ToString());
    }

    /// <see cref="WhereIn"/> 的 string 版本。
    void WhereIn(string c, List<string> vs) {
        if (!this.on) { return; }
        if (vs.Count == 0) { this.W("1 = 0"); return; }
        StringBuilder sb = new StringBuilder(this.RequireCol(c) + " IN (");
        for (int i = 0; i < vs.Count; i = i + 1) {
            if (i > 0) { sb.Append(", "); }
            sb.Append("?");
            this.ps.Add(vs[i]);
        }
        this.W(sb.Append(")").ToString());
    }

    /// 多列 OR LIKE："username|email" 一并子串匹配同一个值，每列绑定
    /// 自己的参数，列名逐一校验。
    void WhereLikeAny(string cols, string v) {
        if (!this.on) { return; }
        List<string> parts = cols.Split("|");
        StringBuilder sb = new StringBuilder("(");
        int n = 0;
        for (int i = 0; i < parts.Count; i = i + 1) {
            string part = parts[i].Trim();
            if (part.Length == 0) { continue; }
            if (n > 0) { sb.Append(" OR "); }
            sb.Append(this.RequireCol(part) + " LIKE ?");
            this.ps.Add("%" + v + "%");
            n = n + 1;
        }
        if (n == 0) { throw new Exception("WhereLikeAny without columns"); }
        this.W(sb.Append(")").ToString());
    }

    /// 恒假条件：数据边界为空集时用它表达"一行都不许看"。
    void WhereNone() {
        if (!this.on) { return; }
        this.W("1 = 0");
    }

    /// 声明式条件（<see cref="OrmCond"/> 列表）落成参数化 WHERE：
    /// LIKE 走多列 OR 匹配，EQ/GE/LE 按宽松数字解析后绑定。
    void WhereConds(List<OrmCond> cs) {
        if (cs == null) { return; }
        for (int i = 0; i < cs.Count; i = i + 1) {
            OrmCond q = cs[i];
            if (q.kind == "LIKE") {
                this.WhereLikeAny(q.col, q.value);
            } else if (q.kind == "EQ") {
                this.WhereEq(q.col, (int)OrmCond.Num(q.value));
            } else if (q.kind == "GE") {
                this.WhereGe(q.col, OrmCond.Num(q.value));
            } else if (q.kind == "LE") {
                this.WhereLe(q.col, OrmCond.Num(q.value));
            } else {
                throw new Exception("unknown cond kind: " + q.kind);
            }
        }
    }

    /// ORDER BY 追加一列（升序）。
    void OB(string col) {
        if (this.ob.Length == 0) { this.ob = col; }
        else { this.ob = this.ob + ", " + col; }
    }

    /// ORDER BY 别名（支持带 DESC/ASC 的原生表达式片段）。
    void OrderBy(string col) { this.OB(col); }

    /// ORDER BY 追加一列（降序）。
    void OBD(string col) { this.OB(col + " DESC"); }
    /// GROUP BY 单列。
    void GB(string col) { this.gb = col; }
    /// 便捷：按分组键排序（升序）。
    void OBK() { this.OB(this.gb); }
    /// 便捷：按分组键排序（降序）。
    void OBDK() { this.OBD(this.gb); }

    /// HAVING 片段：多个片段以 AND 连接。
    void H(string f) {
        if (this.h.Length == 0) { this.h = f; }
        else { this.h = this.h + " AND " + f; }
    }

    /// SELECT DISTINCT。
    void DISTINCT() { this.distinct = true; }
    /// LIMIT n。
    void Take(int n) { this.limN = n; }
    /// OFFSET n。
    void SkipN(int n) { this.offN = n; }

    /// 1 起始的分页（换算成 LIMIT/OFFSET，方言在 BuildSelect 处理）。
    void Page(int index, int size) {
        if (index < 1) { index = 1; }
        this.limN = size;
        this.offN = (index - 1) * size;
    }

    /// <summary>包含第 i 个导航字段（LEFT JOIN + 它的列）。</summary>
    void Include(int i) { this.navOn[i] = true; }

    /// <summary>被包含的导航字段在结果里的起始列号。</summary>
    int NavAt(int i) {
        int at = this.meta.Cols.Count;
        for (int k = 0; k < i; k = k + 1) {
            if (this.navOn[k]) { at = at + this.meta.Navs[k].Cols.Count; }
        }
        return at;
    }

    /// 把 WHERE/GROUP BY/HAVING/ORDER BY 片段追加到 SELECT 文本之后。
    void tail(StringBuilder sb) {
        if (this.w.Length > 0) { sb.Append(" WHERE "); sb.Append(this.w); }
        if (this.gb.Length > 0) { sb.Append(" GROUP BY "); sb.Append(this.gb); }
        if (this.h.Length > 0) { sb.Append(" HAVING "); sb.Append(this.h); }
        if (this.ob.Length > 0) { sb.Append(" ORDER BY "); sb.Append(this.ob); }
    }

    /// <summary>实体行的 SELECT。分页写法按方言：SQL Server/Oracle 用
    /// OFFSET ... FETCH（且必须有 ORDER BY）。</summary>
    string BuildSelect() {
        StringBuilder sb = new StringBuilder();
        sb.Append("SELECT ");
        if (this.distinct) { sb.Append("DISTINCT "); }
        sb.Append(this.meta.SelectList());
        for (int i = 0; i < this.meta.Navs.Count; i = i + 1) {
            if (this.navOn[i]) { sb.Append(this.meta.Navs[i].SelectList()); }
        }
        sb.Append(" FROM ");
        sb.Append(this.tbl);
        sb.Append(" t");
        for (int i = 0; i < this.meta.Navs.Count; i = i + 1) {
            if (this.navOn[i]) { sb.Append(this.meta.Navs[i].Join()); }
        }
        this.tail(sb);
        int pv = this.db.GetProvider();
        if (pv == DbProvider.SqlServer || pv == DbProvider.Oracle) {
            int off = this.offN;
            if (off < 0) { off = 0; }
            if (this.ob.Length == 0) {
                if (pv == DbProvider.SqlServer) {
                    sb.Append(" ORDER BY (SELECT 0)");
                } else {
                    sb.Append(" ORDER BY (SELECT 0 FROM DUAL)");
                }
            }
            sb.Append(" OFFSET ");
            sb.Append(Convert.ToString(off));
            sb.Append(" ROWS");
            if (this.limN >= 0) {
                sb.Append(" FETCH NEXT ");
                sb.Append(Convert.ToString(this.limN));
                sb.Append(" ROWS ONLY");
            }
        } else {
            if (this.limN >= 0) {
                sb.Append(" LIMIT ");
                sb.Append(Convert.ToString(this.limN));
            }
            if (this.offN >= 0) {
                sb.Append(" OFFSET ");
                sb.Append(Convert.ToString(this.offN));
            }
        }
        return sb.ToString();
    }

    /// 执行实体行查询。
    DbResult Rows() { return this.db.Query(this.BuildSelect(), this.ps); }

    /// 异步执行实体行查询。
    async DbResult RowsAsync() {
        string sql = this.BuildSelect();
        return await this.db.QueryAsync(sql, this.ps);
    }

    /// <summary>单列/投影的 SELECT（分页在 DTO 版里按 LIMIT/OFFSET）。</summary>
    string BuildCol(string col) {
        StringBuilder sb = new StringBuilder();
        sb.Append("SELECT " + col + " FROM " + this.tbl + " t");
        this.tail(sb);
        return sb.ToString();
    }

    /// 投影 SELECT 的语句文本（固定 LIMIT/OFFSET 分页写法）。
    string BuildDto(string cols) {
        StringBuilder sb = new StringBuilder();
        sb.Append("SELECT " + cols + " FROM " + this.tbl + " t");
        this.tail(sb);
        if (this.limN >= 0) {
            sb.Append(" LIMIT " + Convert.ToString(this.limN));
        }
        if (this.offN >= 0) {
            sb.Append(" OFFSET " + Convert.ToString(this.offN));
        }
        return sb.ToString();
    }

    /// 把结果集第一列抽成字符串列表。
    List<string> MapCol(DbResult r) {
        List<string> outp = new List<string>();
        int row = 0;
        while (row < r.RowCount()) {
            outp.Add(r.GetString(row, 0));
            row = row + 1;
        }
        return outp;
    }

    /// 执行单列查询并返回字符串列表。
    List<string> ToListCol(string col) {
        return this.MapCol(this.db.Query(this.BuildCol(col), this.ps));
    }

    /// <see cref="ToListCol"/> 的异步版本。
    async List<string> ToListColAsync(string col) {
        string sql = this.BuildCol(col);
        DbResult r = await this.db.QueryAsync(sql, this.ps);
        return this.MapCol(r);
    }

    /// 执行投影查询（DTO 列表，LIMIT/OFFSET 分页）。
    DbResult Dto(string cols) {
        return this.db.Query(this.BuildDto(cols), this.ps);
    }

    /// 异步执行投影查询。
    async DbResult DtoAsync(string cols) {
        string sql = this.BuildDto(cols);
        return await this.db.QueryAsync(sql, this.ps);
    }

    /// 只取一行（LIMIT 1）。
    void One() { this.limN = 1; }

    /// <summary>分组后的行数：分组键上的 COUNT 要套一层子查询。
    /// 派生表必须带别名——MySQL/PostgreSQL/SQL Server 对无别名
    /// 的子查询直接报语法错。</summary>
    string BuildCount() {
        StringBuilder sb = new StringBuilder();
        sb.Append("SELECT COUNT(*) FROM (SELECT 1 FROM " + this.tbl + " t");
        if (this.w.Length > 0) { sb.Append(" WHERE " + this.w); }
        sb.Append(" GROUP BY " + this.gb);
        if (this.h.Length > 0) { sb.Append(" HAVING " + this.h); }
        sb.Append(") AS cnt");
        return sb.ToString();
    }

    /// 聚合 SELECT 的语句文本（表达式如 "COUNT(*)"、"SUM(t.n)"），
    /// 复用 WHERE/GROUP BY/HAVING，忽略排序与分页。
    string BuildAgg(string expr) {
        StringBuilder sb = new StringBuilder();
        sb.Append("SELECT " + expr + " FROM " + this.tbl + " t");
        if (this.w.Length > 0) { sb.Append(" WHERE "); sb.Append(this.w); }
        if (this.gb.Length > 0) { sb.Append(" GROUP BY "); sb.Append(this.gb); }
        if (this.h.Length > 0) { sb.Append(" HAVING "); sb.Append(this.h); }
        return sb.ToString();
    }

    /// 执行聚合查询，返回原始结果集。
    DbResult AggR(string expr) {
        return this.db.Query(this.BuildAgg(expr), this.ps);
    }

    /// <see cref="AggR"/> 的异步版本。
    async DbResult AggRAsync(string expr) {
        string sql = this.BuildAgg(expr);
        return await this.db.QueryAsync(sql, this.ps);
    }

    /// 聚合结果取 int；无行时为 0。
    int AggI(string expr) {
        DbResult r = this.AggR(expr);
        if (r.RowCount() == 0) { return 0; }
        return r.GetInt(0, 0);
    }

    /// 聚合结果取 long；无行时为 0。
    long AggL(string expr) {
        DbResult r = this.AggR(expr);
        if (r.RowCount() == 0) { return 0; }
        return r.GetLong(0, 0);
    }

    /// 聚合结果取 double；无行时为 0.0。
    double AggD(string expr) {
        DbResult r = this.AggR(expr);
        if (r.RowCount() == 0) { return 0.0; }
        return r.GetDouble(0, 0);
    }

    /// <see cref="AggI"/> 的异步版本。
    async int AggIAsync(string expr) {
        DbResult r = await this.AggRAsync(expr);
        if (r.RowCount() == 0) { return 0; }
        return r.GetInt(0, 0);
    }

    /// <see cref="AggL"/> 的异步版本。
    async long AggLAsync(string expr) {
        DbResult r = await this.AggRAsync(expr);
        if (r.RowCount() == 0) { return 0; }
        return r.GetLong(0, 0);
    }

    /// <see cref="AggD"/> 的异步版本。
    async double AggDAsync(string expr) {
        DbResult r = await this.AggRAsync(expr);
        if (r.RowCount() == 0) { return 0.0; }
        return r.GetDouble(0, 0);
    }

    /// 匹配的行数（分组查询时数分组数）。
    int Count() {
        if (this.gb.Length > 0) {
            DbResult r = this.db.Query(this.BuildCount(), this.ps);
            if (r.RowCount() == 0) { return 0; }
            return r.GetInt(0, 0);
        }
        return this.AggI("COUNT(*)");
    }

    /// 异步行数。
    async int CountAsync() {
        if (this.gb.Length > 0) {
            string sql = this.BuildCount();
            DbResult r = await this.db.QueryAsync(sql, this.ps);
            if (r.RowCount() == 0) { return 0; }
            return r.GetInt(0, 0);
        }
        return await this.AggIAsync("COUNT(*)");
    }

    /// 是否存在匹配行。
    bool Any() { return this.Count() > 0; }

    /// 异步判断是否存在匹配行。
    async bool AnyAsync() {
        int n = await this.CountAsync();
        return n > 0;
    }
}
