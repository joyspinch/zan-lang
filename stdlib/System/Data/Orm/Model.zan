using System;
using System.Data;
using System.Data.Orm;
using System.Json;

namespace System.Data.Orm;

/// <summary>单个列定义：列名及完整 SQL 类型文本（含
/// NOT NULL / PRIMARY KEY / DEFAULT 等后缀）。用一个实体代替并行的
/// 名称/类型列表。</summary>
class ModelColumn {
    string name;
    string type;

    ModelColumn(string name, string type) {
        this.name = name;
        this.type = QueryBuilder.RequireDdlType(type);
    }
}

/// <summary>
/// 仿 FreeSQL 的 ORM 模型基类。
/// 提供自动生成 SQL 的 CRUD 操作。
/// 模型通过列到字段的映射关联数据库表。
///
/// 用法：
///   // 定义模型
///   Model userModel = Model.Define("users")
///       .Column("id", "INTEGER", true)
///       .Column("name", "TEXT")
///       .Column("email", "TEXT")
///       .Column("age", "INTEGER")
///       .Column("created_at", "TEXT");
///
///   // 建表
///   userModel.CreateTable(db);
///
///   // 插入
///   ModelRow row = new ModelRow()
///       .Set("name", "Alice").Set("email", "alice@example.com").Set("age", "30");
///   userModel.Insert(db, row);
///
///   // 查询
///   List<ModelRow> users = userModel.Select(db).Where("age > 18").Execute();
///
///   // 更新
///   userModel.Update(db).Set("name", "Bob").Where("id = 1").Execute();
///
///   // 删除
///   userModel.Delete(db).Where("id = 1").Execute();
/// </summary>
class Model {
    string tableName;
    List<ModelColumn> columns;
    string primaryKey;
    IDbExecutor db;

    Model(string tableName) {
        this.tableName = QueryBuilder.RequireIdent(tableName);
        this.columns = new List<ModelColumn>();
        this.primaryKey = "";
    }

    /// <summary>以表名定义一个新模型。</summary>
    static Model Define(string tableName) {
        return new Model(tableName);
    }

    /// <summary>添加一个列定义。</summary>
    Model Column(string name, string type) {
        this.columns.Add(new ModelColumn(QueryBuilder.RequireIdent(name), type));
        return this;
    }

    /// <summary>将一列设为主键。</summary>
    Model Column(string name, string type, bool isPrimaryKey) {
        string ident = QueryBuilder.RequireIdent(name);
        if (isPrimaryKey) {
            this.columns.Add(new ModelColumn(ident, type + " PRIMARY KEY AUTOINCREMENT"));
            this.primaryKey = name;
        } else {
            this.columns.Add(new ModelColumn(ident, type));
        }
        return this;
    }

    /// <summary>添加一个 NOT NULL 列。</summary>
    Model ColumnNotNull(string name, string type) {
        this.columns.Add(new ModelColumn(QueryBuilder.RequireIdent(name), type + " NOT NULL"));
        return this;
    }

    /// <summary>添加带默认值的列。</summary>
    Model ColumnDefault(string name, string type, string defaultVal) {
        this.columns.Add(new ModelColumn(QueryBuilder.RequireIdent(name), type + " DEFAULT '" + QueryBuilder.EscapeDdlLiteral(defaultVal) + "'"));
        return this;
    }

    /// <summary>添加一个 UNIQUE 列。</summary>
    Model ColumnUnique(string name, string type) {
        this.columns.Add(new ModelColumn(QueryBuilder.RequireIdent(name), type + " UNIQUE"));
        return this;
    }

    /// <summary>在数据库中创建表。</summary>
    void CreateTable(IDbExecutor db) {
        StringBuilder sb = new StringBuilder();
        sb.Append("CREATE TABLE IF NOT EXISTS ");
        sb.Append(this.tableName);
        sb.Append(" (");
        bool first = true;
        foreach (ModelColumn col in this.columns) {
            if (!first) { sb.Append(", "); }
            sb.Append(col.name);
            sb.Append(" ");
            sb.Append(col.type);
            first = false;
        }
        sb.Append(")");
        db.Execute(sb.ToString());
    }

    /// <summary>创建表（包装方法）。</summary>
    void CreateTableAsync(IDbExecutor db) {
        CreateTable(db);
    }

    /// <summary>从数据库中删除表。</summary>
    void DropTable(IDbExecutor db) {
        db.Execute("DROP TABLE IF EXISTS " + this.tableName);
    }

    /// <summary>检查表是否存在。（tableName 在 Define 时已通过标识符校验，
    /// 因此这里直接内联是安全的。）</summary>
    bool TableExists(IDbExecutor db) {
        string sql = "SELECT COUNT(*) FROM sqlite_master WHERE type='table' AND name='" + this.tableName + "'";
        string result = db.ExecuteScalar(sql);
        return result == "1";
    }

    /// <summary>向表中插入一行。</summary>
    int Insert(IDbExecutor db, ModelRow row) {
        QueryBuilder qb = QueryBuilder.InsertInto(this.tableName);
        List<string> keys = row.GetKeys();
        for (int i = 0; i < keys.Count; i = i + 1) {
            string key = keys[i];
            string val = row.Get(key);
            qb.Set(key, val);
        }
        return db.Execute(qb.BuildInsertParams(), qb.InsertParams());
    }

    /// <summary>插入一行（包装方法）。</summary>
    int InsertAsync(IDbExecutor db, ModelRow row) {
        return Insert(db, row);
    }

    /// <summary>为该模型开启 SELECT 查询构建器。</summary>
    ModelQuery Select(IDbExecutor db) {
        return ModelQuery.NewSelect(db, this.tableName);
    }

    /// <summary>为该模型开启 UPDATE 查询构建器。</summary>
    ModelUpdate UpdateQuery(IDbExecutor db) {
        return ModelUpdate.New(db, this.tableName);
    }

    /// <summary>为该模型开启 DELETE 查询构建器。</summary>
    ModelDelete DeleteQuery(IDbExecutor db) {
        return ModelDelete.New(db, this.tableName);
    }

    /// <summary>按主键查找一行。</summary>
    ModelRow FindById(IDbExecutor db, int id) {
        string pk = this.primaryKey;
        if (pk.Length == 0) { pk = "id"; }
        string sql = "SELECT * FROM " + this.tableName + " WHERE " + pk + " = " + Convert.ToString(id);
        DbResult result = db.Query(sql);
        if (result.RowCount() > 0) {
            return ModelRow.FromDbResult(result, 0);
        }
        return new ModelRow();
    }

    /// <summary>按主键查找一行（包装方法）。</summary>
    ModelRow FindByIdAsync(IDbExecutor db, int id) {
        return FindById(db, id);
    }

    /// <summary>统计表中的总行数。</summary>
    int Count(IDbExecutor db) {
        string sql = "SELECT COUNT(*) FROM " + this.tableName;
        string result = db.ExecuteScalar(sql);
        return Convert.ToInt(result);
    }

    /// <summary>统计满足条件的行数。</summary>
    int CountWhere(IDbExecutor db, string condition) {
        string sql = "SELECT COUNT(*) FROM " + this.tableName + " WHERE " + condition;
        string result = db.ExecuteScalar(sql);
        return Convert.ToInt(result);
    }

    /// <summary>按主键删除一行。</summary>
    void DeleteById(IDbExecutor db, int id) {
        string pk = this.primaryKey;
        if (pk.Length == 0) { pk = "id"; }
        db.Execute("DELETE FROM " + this.tableName + " WHERE " + pk + " = " + Convert.ToString(id));
    }

    /// <summary>返回所有行。</summary>
    List<ModelRow> All(IDbExecutor db) {
        DbResult result = db.Query("SELECT * FROM " + this.tableName);
        return ModelRow.FromDbResultAll(result);
    }

    /// <summary>返回表名。</summary>
    string GetTableName() {
        return this.tableName;
    }

    /// <summary>返回主键列名。</summary>
    string GetPrimaryKey() {
        return this.primaryKey;
    }

    // ===== 反向映射：从已有表构建 Model =====
    // 与 CreateTable()（模型 -> 表）互补，提供表 -> 模型，即
    // FreeSQL 风格的“数据库优先”方向。内省 SQL 由
    // 连接的 provider 决定；数据库原始列类型会原样保留。

    /// <summary>该模型定义的列数。</summary>
    int ColumnCount() { return this.columns.Count; }

    /// <summary>索引 i 处的列名。</summary>
    string ColumnNameAt(int i) { return this.columns[i].name; }

    /// <summary>索引 i 处的列类型（含 NOT NULL / PRIMARY KEY 后缀）。</summary>
    string ColumnTypeAt(int i) { return this.columns[i].type; }

    static bool EqIgnoreCase(string a, string b) {
        if (a.Length != b.Length) { return false; }
        for (int i = 0; i < a.Length; i = i + 1) {
            int ca = a[i] & 255;
            int cb = b[i] & 255;
            if (ca >= 65 && ca <= 90) { ca = ca + 32; }
            if (cb >= 65 && cb <= 90) { cb = cb + 32; }
            if (ca != cb) { return false; }
        }
        return true;
    }

    static int ColIndex(DbResult r, string name) {
        List<string> cols = r.GetColumnNames();
        for (int i = 0; i < cols.Count; i = i + 1) {
            if (Model.EqIgnoreCase(cols[i], name)) { return i; }
        }
        return 0 - 1;
    }

    static void FillFromSqlite(Model m, IDbExecutor db, string t) {
        DbResult r = db.Query("PRAGMA table_info(" + t + ")");
        if (r == null) { return; }
        int ni = Model.ColIndex(r, "name");
        int ti = Model.ColIndex(r, "type");
        int nn = Model.ColIndex(r, "notnull");
        int pk = Model.ColIndex(r, "pk");
        for (int row = 0; row < r.RowCount(); row = row + 1) {
            string name = r.GetString(row, ni);
            string type = r.GetString(row, ti);
            bool isPk = pk >= 0 && r.GetString(row, pk) != "0"
                && r.GetString(row, pk) != "";
            bool notNull = nn >= 0 && r.GetString(row, nn) == "1";
            m.AddIntrospected(name, type, isPk, notNull);
        }
    }

    static void FillFromMysql(Model m, IDbExecutor db, string t) {
        DbResult r = db.Query("SHOW COLUMNS FROM " + t);
        if (r == null) { return; }
        int ni = Model.ColIndex(r, "Field");
        int ti = Model.ColIndex(r, "Type");
        int nu = Model.ColIndex(r, "Null");
        int ky = Model.ColIndex(r, "Key");
        for (int row = 0; row < r.RowCount(); row = row + 1) {
            string name = r.GetString(row, ni);
            string type = r.GetString(row, ti);
            bool isPk = ky >= 0 && r.GetString(row, ky) == "PRI";
            bool notNull = nu >= 0 && Model.EqIgnoreCase(r.GetString(row, nu), "NO");
            m.AddIntrospected(name, type, isPk, notNull);
        }
    }

    static void FillFromInformationSchema(Model m, IDbExecutor db, string t) {
        DbResult r = db.Query("SELECT column_name, data_type, is_nullable "
            + "FROM information_schema.columns WHERE table_name = '" + t
            + "' ORDER BY ordinal_position");
        if (r == null) { return; }
        int ni = Model.ColIndex(r, "column_name");
        int ti = Model.ColIndex(r, "data_type");
        int nu = Model.ColIndex(r, "is_nullable");
        // 尽力获取主键列（ANSI catalog；PG / SQL Server）。
        string pkCol = Model.PrimaryKeyFromCatalog(db, t);
        for (int row = 0; row < r.RowCount(); row = row + 1) {
            string name = r.GetString(row, ni);
            string type = r.GetString(row, ti);
            bool isPk = pkCol.Length > 0 && Model.EqIgnoreCase(name, pkCol);
            bool notNull = nu >= 0 && Model.EqIgnoreCase(r.GetString(row, nu), "NO");
            m.AddIntrospected(name, type, isPk, notNull);
        }
    }

    static void FillFromTdengine(Model m, IDbExecutor db, string t) {
        DbResult r = db.Query("DESCRIBE " + t);
        if (r == null) { return; }
        int ni = Model.ColIndex(r, "field");
        int ti = Model.ColIndex(r, "type");
        int li = Model.ColIndex(r, "length");
        for (int row = 0; row < r.RowCount(); row = row + 1) {
            string name = r.GetString(row, ni);
            string type = r.GetString(row, ti);
            // BINARY/NCHAR 的宽度存放在单独的列中。
            if (li >= 0 && (Model.EqIgnoreCase(type, "BINARY")
                    || Model.EqIgnoreCase(type, "VARCHAR")
                    || Model.EqIgnoreCase(type, "NCHAR"))) {
                type = type + "(" + r.GetString(row, li) + ")";
            }
            // DESCRIBE 会把 timestamp 列列在第一位；它是每个
            // TDengine 表排序和查询所依据的键。
            m.AddIntrospected(name, type, row == 0, row == 0);
        }
    }

    static string PrimaryKeyFromCatalog(IDbExecutor db, string t) {
        DbResult r = db.Query("SELECT kcu.column_name "
            + "FROM information_schema.table_constraints tc "
            + "JOIN information_schema.key_column_usage kcu "
            + "ON tc.constraint_name = kcu.constraint_name "
            + "WHERE tc.table_name = '" + t
            + "' AND tc.constraint_type = 'PRIMARY KEY'");
        if (r == null) { return ""; }
        if (r.RowCount() == 0) { return ""; }
        return r.GetString(0, 0);
    }

    void AddIntrospected(string name, string type, bool isPk, bool notNull) {
        if (isPk) {
            this.columns.Add(new ModelColumn(name, type + " PRIMARY KEY"));
            this.primaryKey = name;
        } else if (notNull) {
            this.columns.Add(new ModelColumn(name, type + " NOT NULL"));
        } else {
            this.columns.Add(new ModelColumn(name, type));
        }
    }

    /// <summary>通过反射现有表结构来构建 Model（即
    /// “数据库优先”方向）。Provider 自动检测：SQLite 使用
    /// PRAGMA table_info，MySQL/MariaDB 使用 SHOW COLUMNS，TDengine 使用
    /// DESCRIBE，其余情况回退到 ANSI information_schema
    /// 目录。原始 DB 列类型会被保留，以便后续
    /// CreateTable() 能够往返重建。</summary>
    static Model FromTable(IDbExecutor db, string tableName) {
        Model m = new Model(tableName);
        if (db == null) { return m; }
        int p = db.GetProvider();
        if (p == DbProvider.SQLite) {
            Model.FillFromSqlite(m, db, tableName);
        } else if (p == DbProvider.MySQL || p == DbProvider.MariaDB) {
            Model.FillFromMysql(m, db, tableName);
        } else if (p == DbProvider.TDengine) {
            Model.FillFromTdengine(m, db, tableName);
        } else {
            Model.FillFromInformationSchema(m, db, tableName);
        }
        return m;
    }

    static string StripMods(string type) {
        string t = type;
        int at = Model.IndexOfSub(t, " PRIMARY KEY");
        if (at >= 0) { t = t.Substring(0, at); }
        at = Model.IndexOfSub(t, " NOT NULL");
        if (at >= 0) { t = t.Substring(0, at); }
        at = Model.IndexOfSub(t, " UNIQUE");
        if (at >= 0) { t = t.Substring(0, at); }
        return t;
    }

    static int IndexOfSub(string s, string sub) {
        int n = s.Length;
        int m = sub.Length;
        if (m == 0) { return 0; }
        for (int i = 0; i + m <= n; i = i + 1) {
            if (s.Substring(i, m) == sub) { return i; }
        }
        return 0 - 1;
    }

    /// <summary>生成重建该模型的 Zan 源码，形式为
    /// Model.Define(...) 链式调用——方便从现有表
    /// 生成模型文件骨架（`FromTable(...).ToDefineCode()`）。</summary>
    string ToDefineCode() {
        StringBuilder sb = new StringBuilder();
        sb.Append("Model.Define(\"");
        sb.Append(this.tableName);
        sb.Append("\")");
        foreach (ModelColumn col in this.columns) {
            string nm = col.name;
            string ty = col.type;
            string bt = Model.StripMods(ty);
            if (nm == this.primaryKey) {
                sb.Append("\n    .Column(\"");
                sb.Append(nm); sb.Append("\", \""); sb.Append(bt);
                sb.Append("\", true)");
            } else if (Model.IndexOfSub(ty, " NOT NULL") >= 0) {
                sb.Append("\n    .ColumnNotNull(\"");
                sb.Append(nm); sb.Append("\", \""); sb.Append(bt); sb.Append("\")");
            } else {
                sb.Append("\n    .Column(\"");
                sb.Append(nm); sb.Append("\", \""); sb.Append(bt); sb.Append("\")");
            }
        }
        sb.Append(";");
        return sb.ToString();
    }
}

/// <summary>行上的单个列值：键和字符串值，组合成一个
/// 实体，避免两者不同步。</summary>
class ModelCell {
    string key;
    string val;

    ModelCell(string key, string val) {
        this.key = key;
        this.val = val;
    }
}

/// <summary>
/// 表示模型数据的单行（键值对）。
/// </summary>
class ModelRow {
    List<ModelCell> cells;

    ModelRow() {
        this.cells = new List<ModelCell>();
    }

    /// <summary>设置行上的一个值。</summary>
    ModelRow Set(string key, string val) {
        foreach (ModelCell cell in this.cells) {
            if (cell.key == key) {
                cell.val = val;
                return this;
            }
        }
        this.cells.Add(new ModelCell(key, val));
        return this;
    }

    /// <summary>设置一个整数值。</summary>
    ModelRow SetInt(string key, int val) {
        return Set(key, Convert.ToString(val));
    }

    /// <summary>按键获取字符串值。</summary>
    string Get(string key) {
        foreach (ModelCell cell in this.cells) {
            if (cell.key == key) { return cell.val; }
        }
        return "";
    }

    /// <summary>按键获取整数值。</summary>
    int GetInt(string key) {
        string val = Get(key);
        if (val.Length == 0) { return 0; }
        return Convert.ToInt(val);
    }

    /// <summary>检查行中是否存在某个键。</summary>
    bool Has(string key) {
        foreach (ModelCell cell in this.cells) {
            if (cell.key == key) { return true; }
        }
        return false;
    }

    /// <summary>按插入顺序返回所有键。</summary>
    List<string> GetKeys() {
        List<string> keys = new List<string>();
        foreach (ModelCell cell in this.cells) { keys.Add(cell.key); }
        return keys;
    }

    /// <summary>按插入顺序返回所有值。</summary>
    List<string> GetValues() {
        List<string> values = new List<string>();
        foreach (ModelCell cell in this.cells) { values.Add(cell.val); }
        return values;
    }

    /// <summary>从 DbResult 的一行创建 ModelRow。</summary>
    static ModelRow FromDbResult(DbResult result, int rowIndex) {
        ModelRow row = new ModelRow();
        List<string> columns = result.GetColumnNames();
        for (int c = 0; c < columns.Count; c = c + 1) {
            row.Set(columns[c], result.GetString(rowIndex, c));
        }
        return row;
    }

    /// <summary>从 DbResult 的所有行创建 ModelRow 列表。</summary>
    static List<ModelRow> FromDbResultAll(DbResult result) {
        List<ModelRow> rows = new List<ModelRow>();
        for (int r = 0; r < result.RowCount(); r = r + 1) {
            rows.Add(FromDbResult(result, r));
        }
        return rows;
    }

    /// <summary>将行转换为 JSON 字符串。</summary>
    string ToJson() {
        JsonValue o = JsonValue.NewObject();
        foreach (ModelCell cell in this.cells) {
            o.Put(cell.key, JsonValue.NewStr(cell.val));
        }
        return o.ToJson();
    }
}

/// <summary>
/// 模型级 SELECT 查询构建器。
/// </summary>
class ModelQuery {
    IDbExecutor db;
    string tableName;
    QueryBuilder qb;

    ModelQuery(IDbExecutor db, string tableName) {
        this.db = db;
        this.tableName = tableName;
        this.qb = QueryBuilder.From(tableName);
    }

    static ModelQuery NewSelect(IDbExecutor db, string tableName) {
        return new ModelQuery(db, tableName);
    }

    ModelQuery Where(string condition) {
        this.qb.Where(condition);
        return this;
    }

    ModelQuery WhereEq(string column, string val) {
        this.qb.WhereEq(column, val);
        return this;
    }

    ModelQuery WhereEqInt(string column, int val) {
        this.qb.WhereEqInt(column, val);
        return this;
    }

    ModelQuery OrderBy(string column) {
        this.qb.OrderBy(column);
        return this;
    }

    ModelQuery OrderByDesc(string column) {
        this.qb.OrderByDesc(column);
        return this;
    }

    ModelQuery OrderByDescending(string column) {
        return OrderByDesc(column);
    }

    /// <summary>添加 `column LIKE ?`，使用绑定模式。</summary>
    ModelQuery WhereLike(string column, string pattern) {
        this.qb.WhereLike(column, pattern);
        return this;
    }

    /// <summary>添加 `column LIKE %value%`（子串匹配，已绑定）。</summary>
    ModelQuery WhereContains(string column, string val) {
        this.qb.WhereContains(column, val);
        return this;
    }

    /// <summary>添加 `(col1 LIKE ? OR col2 LIKE ? OR ...)` — 一个关键字
    /// 在多个列中搜索，全部绑定。这是典型的列表页
    /// 关键字搜索；通过外层查询与 AND 组合。</summary>
    ModelQuery WhereAnyLike(List<string> columns, string val) {
        this.qb.WhereAnyLike(columns, val);
        return this;
    }

    /// <summary>添加 `column <> ?`，使用绑定值。</summary>
    ModelQuery WhereNe(string column, string val) {
        this.qb.WhereNe(column, val);
        return this;
    }

    /// <summary>添加 `column > ?`，使用绑定整数。</summary>
    ModelQuery WhereGtInt(string column, int val) {
        this.qb.WhereGtInt(column, val);
        return this;
    }

    /// <summary>添加 `column >= ?`，使用绑定整数。</summary>
    ModelQuery WhereGeInt(string column, int val) {
        this.qb.WhereGeInt(column, val);
        return this;
    }

    /// <summary>添加 `column < ?`，使用绑定整数。</summary>
    ModelQuery WhereLtInt(string column, int val) {
        this.qb.WhereLtInt(column, val);
        return this;
    }

    /// <summary>添加 `column <= ?`，使用绑定整数。</summary>
    ModelQuery WhereLeInt(string column, int val) {
        this.qb.WhereLeInt(column, val);
        return this;
    }

    /// <summary>添加 `column BETWEEN ? AND ?`，使用绑定值。</summary>
    ModelQuery WhereBetween(string column, string low, string high) {
        this.qb.WhereBetween(column, low, high);
        return this;
    }

    /// <summary>添加 `column IS NULL`。</summary>
    ModelQuery WhereNull(string column) {
        this.qb.WhereNull(column);
        return this;
    }

    /// <summary>添加 `column IS NOT NULL`。</summary>
    ModelQuery WhereNotNull(string column) {
        this.qb.WhereNotNull(column);
        return this;
    }

    /// <summary>添加 `column IN (?, ...)`，使用绑定值。</summary>
    ModelQuery WhereIn(string column, List<string> values) {
        this.qb.WhereIn(column, values);
        return this;
    }

    /// <summary>添加 `column NOT IN (?, ...)`，使用绑定值。</summary>
    ModelQuery WhereNotIn(string column, List<string> values) {
        this.qb.WhereNotIn(column, values);
        return this;
    }

    /// <summary>一次调用设置 LIMIT n OFFSET (index-1)*size（index 从 1 开始）。</summary>
    ModelQuery Page(int index, int size) {
        if (index < 1) { index = 1; }
        this.qb.Limit(size);
        this.qb.Offset((index - 1) * size);
        return this;
    }

    /// <summary>至少有一行匹配时返回 true。</summary>
    bool Any() {
        return Count() > 0;
    }

    ModelQuery Limit(int count) {
        this.qb.Limit(count);
        return this;
    }

    ModelQuery Offset(int count) {
        this.qb.Offset(count);
        return this;
    }

    /// <summary>执行查询并返回 ModelRow 列表。</summary>
    List<ModelRow> Execute() {
        DbResult result = this.db.Query(this.qb.BuildSelectParams("*"), this.qb.SelectParams());
        return ModelRow.FromDbResultAll(result);
    }

    /// <summary>执行查询（包装方法）。</summary>
    List<ModelRow> ExecuteAsync() {
        return Execute();
    }

    /// <summary>返回第一条结果，无结果时返回空行。</summary>
    ModelRow First() {
        this.qb.Limit(1);
        List<ModelRow> rows = Execute();
        if (rows.Count > 0) {
            return rows[0];
        }
        return new ModelRow();
    }

    /// <summary>返回满足查询条件的数量。</summary>
    int Count() {
        string result = this.db.ExecuteScalar(
            this.qb.BuildSelectParams("COUNT(*)"), this.qb.SelectParams());
        return Convert.ToInt(result);
    }
}

/// <summary>
/// 模型级 UPDATE 查询构建器。
/// </summary>
class ModelUpdate {
    IDbExecutor db;
    QueryBuilder qb;

    ModelUpdate(IDbExecutor db, string tableName) {
        this.db = db;
        this.qb = QueryBuilder.Update(tableName);
    }

    static ModelUpdate New(IDbExecutor db, string tableName) {
        return new ModelUpdate(db, tableName);
    }

    ModelUpdate Set(string column, string val) {
        this.qb.Set(column, val);
        return this;
    }

    ModelUpdate SetInt(string column, int val) {
        this.qb.SetInt(column, val);
        return this;
    }

    ModelUpdate Where(string condition) {
        this.qb.Where(condition);
        return this;
    }

    ModelUpdate WhereEq(string column, string val) {
        this.qb.WhereEq(column, val);
        return this;
    }

    /// <summary>执行 UPDATE 并返回受影响的行数。</summary>
    int Execute() {
        return this.db.Execute(this.qb.BuildUpdateParams(), this.qb.UpdateParams());
    }

    int ExecuteAsync() {
        return Execute();
    }
}

/// <summary>
/// 模型级 DELETE 查询构建器。
/// </summary>
class ModelDelete {
    IDbExecutor db;
    QueryBuilder qb;

    ModelDelete(IDbExecutor db, string tableName) {
        this.db = db;
        this.qb = QueryBuilder.DeleteFrom(tableName);
    }

    static ModelDelete New(IDbExecutor db, string tableName) {
        return new ModelDelete(db, tableName);
    }

    ModelDelete Where(string condition) {
        this.qb.Where(condition);
        return this;
    }

    ModelDelete WhereEq(string column, string val) {
        this.qb.WhereEq(column, val);
        return this;
    }

    /// <summary>执行 DELETE 并返回受影响的行数。</summary>
    int Execute() {
        return this.db.Execute(this.qb.BuildDeleteParams(), this.qb.SelectParams());
    }

    int ExecuteAsync() {
        return Execute();
    }
}

/// <summary>
/// 用于管理数据库 schema 演进的迁移辅助工具。
/// </summary>
class Migration {
    string name;
    string upSql;
    string downSql;

    Migration(string name, string up, string down) {
        this.name = name;
        this.upSql = up;
        this.downSql = down;
    }

    /// <summary>执行迁移（运行 UP SQL）。</summary>
    void Up(IDbExecutor db) {
        db.Execute(this.upSql);
    }

    /// <summary>回退迁移（运行 DOWN SQL）。</summary>
    void Down(IDbExecutor db) {
        db.Execute(this.downSql);
    }

    /// <summary>确保迁移记录表存在。SQLite 可以以
    /// TEXT 为键；MySQL/MariaDB 禁止无长度前缀的 TEXT 作键，因此它们
    /// 使用 VARCHAR(255)。</summary>
    static void EnsureTable(IDbExecutor db) {
        int p = db.GetProvider();
        if (p == DbProvider.MySQL || p == DbProvider.MariaDB) {
            db.Execute("CREATE TABLE IF NOT EXISTS _migrations "
                + "(name VARCHAR(255) PRIMARY KEY, applied_at VARCHAR(64))");
        } else {
            db.Execute("CREATE TABLE IF NOT EXISTS _migrations (name TEXT PRIMARY KEY, applied_at TEXT)");
        }
    }

    /// <summary>检查某个迁移是否已执行。</summary>
    static bool IsApplied(IDbExecutor db, string name) {
        string result = db.ExecuteScalar(
            "SELECT COUNT(*) FROM _migrations WHERE name = ?",
            new DbParams().Add(name));
        return result == "1";
    }

    /// <summary>按顺序运行迁移列表。</summary>
    static void RunAll(IDbExecutor db, List<Migration> migrations) {
        EnsureTable(db);
        for (int i = 0; i < migrations.Count; i = i + 1) {
            Migration m = migrations[i];
            if (!IsApplied(db, m.name)) {
                m.Up(db);
                db.Execute(
                    "INSERT INTO _migrations (name, applied_at) VALUES (?, 'now')",
                    new DbParams().Add(m.name));
                Console.WriteLine("[Migration] Applied: " + m.name);
            }
        }
    }
}
