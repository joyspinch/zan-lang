using System;
using System.Data;

namespace System.Data.Orm;

/// <summary>
/// CodeFirst：缺表建表、缺列加列、缺索引补索引。DDL 从实体元数据
/// 直接算出来，同步与异步两条路径共用同一段文本构造。
/// </summary>
class OrmSync {
    /// <summary>CREATE TABLE 语句。复合主键写成表级约束（列定义里
    /// 不能各自带 PRIMARY KEY）。</summary>
    static string CreateDdl(int p, OrmMeta m, string t) {
        string pks = m.PkList();
        bool comp = pks.Length > 0;
        StringBuilder sb = new StringBuilder();
        sb.Append("CREATE TABLE " + t + " (");
        for (int i = 0; i < m.Cols.Count; i = i + 1) {
            OrmCol c = m.Cols[i];
            if (i > 0) { sb.Append(", "); }
            sb.Append(c.Col + " ");
            sb.Append(OrmDialect.Ty(p, c.TyCode(), c.IsPk && !comp, c.IsIdent,
                                    c.StrLen));
        }
        if (comp) { sb.Append(", PRIMARY KEY (" + pks + ")"); }
        sb.Append(")");
        return sb.ToString();
    }

    /// ALTER TABLE ... ADD COLUMN 语句（新列不带主键/自增修饰）。
    static string AddColDdl(int p, OrmCol c, string t) {
        return "ALTER TABLE " + t + " ADD COLUMN " + c.Col + " "
            + OrmDialect.Ty(p, c.TyCode(), false, false, c.StrLen);
    }

    /// <summary>执行一条 DDL；执行器以负数报告失败（内置驱动
    /// 语句失败会直接抛 DbException，这里给不抛异常的
    /// 自定义执行器兜底）时同样抛出，绝不让建表/加列悄悄落空。</summary>
    static void ExecDdl(IDbExecutor db, string ddl) {
        int n = db.Execute(ddl);
        if (n < 0) {
            throw new DbException("DDL failed: " + ddl, 0, DbProvider.Unknown);
        }
    }

    /// <see cref="ExecDdl"/> 的协程版本，失败约定相同。
    static async void ExecDdlAsync(IDbExecutor db, string ddl) {
        int n = await db.ExecuteAsync(ddl);
        if (n < 0) {
            throw new DbException("DDL failed: " + ddl, 0, DbProvider.Unknown);
        }
    }

    /// 同步路径的 schema 同步：缺表则建表并建全部索引；表已存在时
    /// 逐列比对、缺列加列，最后补齐索引（幂等，可重复调用）。
    static void Sync(IDbExecutor db, OrmMeta m) {
        int p = db.GetProvider();
        string t = m.Table;
        if (!OrmDialect.HasTable(db, t)) {
            OrmSync.ExecDdl(db, OrmSync.CreateDdl(p, m, t));
            OrmSync.Indexes(db, m, t);
            return;
        }
        List<string> have = OrmDialect.Cols(db, t);
        for (int i = 0; i < m.Cols.Count; i = i + 1) {
            OrmCol c = m.Cols[i];
            if (!OrmDialect.Has(have, c.Col)) {
                OrmSync.ExecDdl(db, OrmSync.AddColDdl(p, c, t));
            }
        }
        OrmSync.Indexes(db, m, t);
    }

    /// <see cref="Sync"/> 的协程版本。
    static async void SyncAsync(IDbExecutor db, OrmMeta m) {
        int p = db.GetProvider();
        string t = m.Table;
        bool exists = await OrmDialect.HasTableAsync(db, t);
        if (!exists) {
            await OrmSync.ExecDdlAsync(db, OrmSync.CreateDdl(p, m, t));
            await OrmSync.IndexesAsync(db, m, t);
            return;
        }
        List<string> have = await OrmDialect.ColsAsync(db, t);
        for (int i = 0; i < m.Cols.Count; i = i + 1) {
            OrmCol c = m.Cols[i];
            if (!OrmDialect.Has(have, c.Col)) {
                await OrmSync.ExecDdlAsync(db, OrmSync.AddColDdl(p, c, t));
            }
        }
        await OrmSync.IndexesAsync(db, m, t);
    }

    /// 按元数据补齐实体声明的全部索引（EnsureIndex 幂等）。
    static void Indexes(IDbExecutor db, OrmMeta m, string t) {
        for (int i = 0; i < m.Idx.Count; i = i + 1) {
            OrmIndex x = m.Idx[i];
            OrmDialect.EnsureIndex(db, x.Name, t, x.Cols, x.Unique);
        }
    }

    /// <see cref="Indexes"/> 的协程版本。
    static async void IndexesAsync(IDbExecutor db, OrmMeta m, string t) {
        for (int i = 0; i < m.Idx.Count; i = i + 1) {
            OrmIndex x = m.Idx[i];
            await OrmDialect.EnsureIndexAsync(db, x.Name, t, x.Cols, x.Unique);
        }
    }
}
