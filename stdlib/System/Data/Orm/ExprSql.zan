using System;
using System.Data;
using System.Linq;

namespace System.Data.Orm;

/// <summary>
/// Pure-Zan expression-tree to SQL builder. Walks an <see cref="ExprNode"/>
/// tree produced by the dbgen pass (a lambda lowered into inspectable nodes)
/// and appends a parameterized SQL fragment to a StringBuilder, binding
/// constants into a DbParams list. All WHERE-clause SQL construction for the
/// typed ORM lives here — the compiler only lowers `Where(o => ...)` lambdas
/// into Expr trees; nothing SQL-shaped is generated by the C pass.
///
/// Column references map member names to `t.<name>` (column = field name,
/// the default ORM convention). Supported:
///   member / const (int, double, string, bool)
///   binary: == != &lt; &gt; &lt;= &gt;= + - * / %  && (AND)  || (OR)
///   not: !expr
///   calls: StartsWith / EndsWith / Contains  →  LIKE with a bound pattern
/// </summary>
class ExprSql {
    /// <summary>Renders a constant node as text (for LIKE pattern assembly).</summary>
    static string EvalText(ExprNode n) {
        if (n == null) { return ""; }
        if (n.Kind == 1 && n.TVal == 2) { return n.SVal; }
        if (n.Kind == 1 && n.TVal == 0) { return Convert.ToString(n.IVal); }
        return "";
    }

    /// <summary>The SQL spelling of a Zan comparison operator. SQLite happens
    /// to accept `==` and `!=`, but standard SQL (MySQL, PostgreSQL, SQL Server)
    /// does not -- an untranslated operator is a syntax error there, so the
    /// operator must be mapped, not passed through.</summary>
    static string SqlOp(string op) {
        if (op == "==") { return "="; }
        if (op == "!=") { return "<>"; }
        return op;
    }

    /// <summary>Builds a WHERE fragment for the tree rooted at n.</summary>
    static void Build(ExprNode n, StringBuilder sb, DbParams ps) {
        if (n == null) { return; }
        if (n.Kind == 4) {
            Build(n.A, sb, ps);
        } else if (n.Kind == 0) {
            sb.Append("t.");
            sb.Append(n.Name);
        } else if (n.Kind == 1) {
            if (n.TVal == 2) {
                ps.Add(n.SVal);
            } else if (n.TVal == 3) {
                ps.AddInt(n.BVal ? 1 : 0);
            } else if (n.TVal == 1) {
                ps.AddDouble(n.DVal);
            } else {
                ps.AddInt(n.IVal);
            }
            sb.Append("?");
        } else if (n.Kind == 2) {
            if (n.Name == "&&") {
                sb.Append("(");
                Build(n.A, sb, ps);
                sb.Append(" AND ");
                Build(n.B, sb, ps);
                sb.Append(")");
            } else if (n.Name == "||") {
                sb.Append("(");
                Build(n.A, sb, ps);
                sb.Append(" OR ");
                Build(n.B, sb, ps);
                sb.Append(")");
            } else {
                sb.Append("(");
                Build(n.A, sb, ps);
                sb.Append(" ");
                sb.Append(SqlOp(n.Name));
                sb.Append(" ");
                Build(n.B, sb, ps);
                sb.Append(")");
            }
        } else if (n.Kind == 5) {
            sb.Append("NOT (");
            Build(n.A, sb, ps);
            sb.Append(")");
        } else if (n.Kind == 3) {
            if (n.Name == "StartsWith" || n.Name == "EndsWith" ||
                n.Name == "Contains") {
                Build(n.A, sb, ps);
                sb.Append(" LIKE ?");
                string pat = EvalText(n.B);
                if (n.Name == "StartsWith") {
                    pat = pat + "%";
                } else if (n.Name == "EndsWith") {
                    pat = "%" + pat;
                } else {
                    pat = "%" + pat + "%";
                }
                ps.Add(pat);
            } else {
                sb.Append("1=1");
            }
        } else {
            sb.Append("1=1");
        }
    }
}
