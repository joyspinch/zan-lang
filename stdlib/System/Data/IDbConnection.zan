using System;

namespace System.Data;

/// <summary>
/// 可入池的数据库连接：一个 <see cref="IDbExecutor"/>，同时还能
/// 报告自身是否仍可用、可被关闭。这正是
/// <see cref="DbPool"/> 所需的全部能力，因此一个连接池实现即可服务所有
/// 同步执行 SQL 的驱动（ODBC、SQLite、PostgreSQL、TDengine 等），
/// 而调用方仍持有可用的连接类型 —— <c>Query</c>/<c>Execute</c>
/// 可直接通过接口调用，无需向下转型。
/// </summary>
interface IDbConnection : IDbExecutor {
    /// <summary>连接关闭或损坏后为 false；此类连接会被
    /// 剔除而非归还空闲列表。</summary>
    bool IsConnected();

    /// <summary>释放底层句柄/套接字。</summary>
    void Close();

    /// <summary>在 THIS 连接上开启事务。事务属于
    /// 会话的属性，参与事务的每条语句都必须在
    /// 同一连接上执行 —— 这正是它们放在这里而非
    /// 具体驱动里的原因：持有接口的代码（池化连接、DAO）
    /// 否则无法开启事务。
    ///
    /// 不支持事务的引擎（如 TDengine）按文档实现为
    /// 空操作；不要在需要原子性的代码中使用它们。</summary>
    void BeginTransaction();

    /// <summary>提交事务的写入。</summary>
    void Commit();

    /// <summary>回滚事务的写入。</summary>
    void Rollback();

    /// <summary>上述三个事务调用的协程版本。IO 为异步的驱动
    /// 无法同步执行 BEGIN/COMMIT，因此必须在所有驱动上
    /// 工作的代码（请求作用域的工作单元、DAO）
    /// 应使用这些方法。</summary>
    async void BeginTransactionAsync();
    async void CommitAsync();
    async void RollbackAsync();
}
