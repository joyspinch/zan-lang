using System;

namespace System.Data;

/// <summary>
/// A poolable database connection: an <see cref="IDbExecutor"/> that can also
/// report whether it is still usable and be closed. This is everything
/// <see cref="DbPool"/> needs, so one pool implementation serves every driver
/// that speaks SQL synchronously (ODBC, SQLite, PostgreSQL, TDengine, ...)
/// while callers keep a usable connection type -- <c>Query</c>/<c>Execute</c>
/// are reachable straight through the interface, no downcast required.
/// </summary>
interface IDbConnection : IDbExecutor {
    /// <summary>False once the link is closed or broken; such a connection is
    /// evicted instead of returned to the free list.</summary>
    bool IsConnected();

    /// <summary>Releases the underlying handle/socket.</summary>
    void Close();

    /// <summary>Starts a transaction on THIS connection. Transactions are a
    /// property of the session, so every statement that must take part has to
    /// run on the same connection -- which is why they belong here rather than
    /// on the concrete drivers only: code holding the interface (a pooled
    /// connection, a DAO) could not open one otherwise.
    ///
    /// Engines without transactions (TDengine) implement these as documented
    /// no-ops; do not target them with code that needs atomicity.</summary>
    void BeginTransaction();

    /// <summary>Makes the transaction's writes permanent.</summary>
    void Commit();

    /// <summary>Discards the transaction's writes.</summary>
    void Rollback();

    /// <summary>Coroutine twins of the three transaction calls. A driver whose
    /// IO is asynchronous cannot run BEGIN/COMMIT synchronously, so code that
    /// must work over every driver -- a request-scoped unit of work, a DAO --
    /// uses these.</summary>
    async void BeginTransactionAsync();
    async void CommitAsync();
    async void RollbackAsync();
}
