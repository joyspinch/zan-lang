using System;
using System.IO;
using System.Threading;

namespace System.Data.ZanDb;

/// <summary>在写临界区内根据当前值计算新值
/// （键不存在时 current 为 ""）。</summary>
delegate string KvUpdater(string current);

/// <summary>
/// 嵌入式键值存储：单文件、写时复制 B+Tree 索引、LRU 页
/// 缓存（有硬性内存上限）、通过交替 meta 页实现原子提交。
/// 打开即可使用的门面：
///
///   KvStore db = KvStore.Open("app.zdb");
///   db.Put("user:1", "alice");
///   string v = db.Get("user:1");
///   db.Close();
///
/// 并发模型为单写多读：读取者从不阻塞
/// 也不加锁，因为它们所读快照的页面
/// 绝不会被原地修改；写入者通过跨进程锁串行化，因此
/// 多个进程（例如 Web 服务器的工作进程）可以安全地
/// 打开同一个文件。
///
/// 写入自动提交。把多次写入包进 Begin()/Commit() 可使其成为
/// 一个原子事务——也快得多，对 SSD 也更友好：
/// 在一个事务内，无论页中有多少键改变，每页只复制一次。
/// 协程安全的异步版本（GetAsync/PutAsync/UpdateAtomic）
/// 还会额外串行化同一进程内的协程。
/// </summary>
class KvStore {
    Pager pager;
    BTree tree;
    AsyncRwLock rw;
    int txDepth;
    string lastError;

    KvStore() {
        this.txDepth = 0;
        this.lastError = "";
    }

    /// <summary>打开（必要时创建）带 256 页（1 MB）
    /// 缓存、每次提交都 fsync 的存储。</summary>
    static KvStore Open(string path) {
        return KvStore.Open(path, 256);
    }

    /// <summary>以显式页缓存容量打开（页大小为 4 KB）。</summary>
    static KvStore Open(string path, int cachePages) {
        KvStore s = new KvStore();
        s.pager = Pager.Open(path, cachePages);
        if (!s.pager.IsOpen()) {
            s.lastError = s.pager.GetError();
            return s;
        }
        s.tree = BTree.Open(s.pager);
        s.rw = new AsyncRwLock();
        return s;
    }

    /// 是否处于打开状态（打开无错误且底层 Pager 可用）。
    bool IsOpen() { return this.lastError.Length == 0 && this.pager.IsOpen(); }

    /// 最近一次打开失败的错误文本；Open 失败时由它给出原因。
    string GetError() { return this.lastError; }

    /// <summary>数据页 fsync 频率：1 = 每次提交（默认），N = 每
    /// N 次提交。meta 页总是在数据页之后写入，因此
    /// 更大的 N 最多丢失最近几次提交，绝不会损坏数据库。</summary>
    void SetSyncEvery(int n) { this.pager.SetSyncEvery(n); }

    /// <summary>该句柄上次读取的快照的事务 id。</summary>
    long Version() { return this.pager.CommitId(); }

    /// <summary>文件中的页数，以及空闲列表中的页数——衡量
    /// 空间增长的这两个数字。</summary>
    int PageCount() { return this.pager.PageCount(); }

    /// 空闲列表中的页数（已删除但可复用的空间）。
    int FreePages() { return this.pager.FreePages(); }

    /// <summary>自该句柄打开以来写入磁盘的页数：写放大
    /// 测量的输入（写入的页数 vs. 实际变更的数据字节数）
    /// 。</summary>
    int PageWrites() { return this.pager.PageWrites(); }

    // ===== 同步核心 =====

    /// <summary>固定一个快照供多次读取：直到
    /// EndSnapshot() 为止读到的都是同一版本的数据库，即使其他
    /// 进程在提交。读取者不加锁；长快照的代价是
    /// 其仍可见的页面在此期间不会被复用。</summary>
    void BeginSnapshot() { this.pager.BeginRead(); }

    /// 结束快照：释放对旧版本页面的引用，使其可被复用。
    void EndSnapshot() { this.pager.EndRead(); }

    /// <summary>返回值；不存在时返回 ""（参见 Contains）。</summary>
    string Get(string key) {
        this.pager.BeginRead();
        List<string> outv = new List<string>();
        bool ok = this.tree.Get(key, outv);
        this.pager.EndRead();
        if (ok) { return outv[0]; }
        return "";
    }

    /// 键是否存在（与 Get("") 无法区分「值为空串」不同）。
    bool Contains(string key) {
        this.pager.BeginRead();
        bool ok = this.tree.Contains(key);
        this.pager.EndRead();
        return ok;
    }

    /// <summary>插入或替换一个键。除非处于
    /// Begin()/Commit() 内，否则自动提交。</summary>
    void Put(string key, string val) {
        if (this.txDepth > 0) {
            this.tree.Put(key, val);
            return;
        }
        if (!this.pager.BeginWrite()) {
            this.lastError = this.pager.GetError();
            return;
        }
        this.tree.Put(key, val);
        if (!this.pager.Commit()) { this.lastError = this.pager.GetError(); }
    }

    /// <summary>删除键；键存在时返回 true。</summary>
    bool Delete(string key) {
        if (this.txDepth > 0) {
            return this.tree.Delete(key);
        }
        if (!this.pager.BeginWrite()) {
            this.lastError = this.pager.GetError();
            return false;
        }
        bool existed = this.tree.Delete(key);
        if (!this.pager.Commit()) { this.lastError = this.pager.GetError(); }
        return existed;
    }

    /// <summary>在单个事务中删除所有满足 startKey &lt;= key &lt;= endKey
    /// （endKey "" 表示一直到末尾）的键；返回删除的
    /// 数量。完全落在区间内的叶子节点按整页
    /// 释放，而非逐键重写，因此删除一批数据
    /// 大约每个树层级一次页写入——当一批记录
    /// （一个方案、一个租户、一天）被整体替换时应使用此路径。</summary>
    int DeleteRange(string startKey, string endKey) {
        if (this.txDepth > 0) { return this.tree.DeleteRange(startKey, endKey); }
        if (!this.pager.BeginWrite()) {
            this.lastError = this.pager.GetError();
            return 0;
        }
        int n = this.tree.DeleteRange(startKey, endKey);
        if (!this.pager.Commit()) { this.lastError = this.pager.GetError(); }
        return n;
    }

    /// <summary>删除所有以 prefix 开头的键（参见 DeleteRange）。</summary>
    int DeletePrefix(string prefix) {
        if (this.txDepth > 0) { return this.tree.DeletePrefix(prefix); }
        if (!this.pager.BeginWrite()) {
            this.lastError = this.pager.GetError();
            return 0;
        }
        int n = this.tree.DeletePrefix(prefix);
        if (!this.pager.Commit()) { this.lastError = this.pager.GetError(); }
        return n;
    }

    /// <summary>开始一个批次：取得写锁，累积写入，并在
    /// Commit() 时原子提交。可嵌套：只有最外层
    /// 的 Commit 才会持久化。保持事务打开会占用写锁，因此
    /// 批次要控制规模。</summary>
    void Begin() {
        if (this.txDepth == 0) {
            if (!this.pager.BeginWrite()) {
                this.lastError = this.pager.GetError();
                return;
            }
        }
        this.txDepth = this.txDepth + 1;
    }

    /// <summary>原子地持久化自最外层 Begin() 以来的所有内容。</summary>
    bool Commit() {
        if (this.txDepth > 0) { this.txDepth = this.txDepth - 1; }
        if (this.txDepth > 0) { return true; }
        return this.pager.Commit();
    }

    /// <summary>丢弃自最外层 Begin() 以来写入的所有内容；
    /// 数据库保持在之前的版本。</summary>
    void Rollback() {
        this.txDepth = 0;
        this.pager.Rollback();
    }

    /// <summary>范围扫描：startKey &lt;= key &lt;= endKey（endKey "" 表示到末尾），
    /// limit 0 表示不限。返回追加的条目数。</summary>
    int Scan(string startKey, string endKey, int limit, List<KvEntry> output) {
        this.pager.BeginRead();
        int n = this.tree.Scan(startKey, endKey, limit, output);
        this.pager.EndRead();
        return n;
    }

    /// <summary>所有带给定前缀的键（例如 "user:"）。</summary>
    int ScanPrefix(string prefix, int limit, List<KvEntry> output) {
        List<KvEntry> entries = new List<KvEntry>();
        Scan(prefix, "", 0, entries);
        int added = 0;
        for (int i = 0; i < entries.Count; i = i + 1) {
            string k = entries[i].key;
            if (k.Length < prefix.Length) { break; }
            if (k.Substring(0, prefix.Length) != prefix) { break; }
            output.Add(entries[i]);
            added = added + 1;
            if (limit > 0 && added >= limit) { break; }
        }
        return added;
    }

    /// 键的总数（遍历整棵树统计）。
    int Count() {
        this.pager.BeginRead();
        int n = this.tree.Count();
        this.pager.EndRead();
        return n;
    }

    /// <summary>将迄今写入的所有内容强制落盘到稳定存储。</summary>
    void Checkpoint() { this.pager.Checkpoint(); }

    /// 关闭底层存储与进程内读写锁。
    void Close() {
        this.pager.Close();
        this.rw.Close();
    }

    // ===== 协程安全的异步 API =====

    /// <summary>共享锁读取；可安全地与并发写入共存。</summary>
    async string GetAsync(string key) {
        await this.rw.EnterRead();
        string v = Get(key);
        this.rw.ExitRead();
        return v;
    }

    /// <summary>独占锁写入并自动提交。</summary>
    async void PutAsync(string key, string val) {
        await this.rw.EnterWrite();
        Put(key, val);
        this.rw.ExitWrite();
    }

    /// 独占锁删除一个键；返回键此前是否存在。
    async bool DeleteAsync(string key) {
        await this.rw.EnterWrite();
        bool existed = Delete(key);
        this.rw.ExitWrite();
        return existed;
    }

    /// <summary>原子读改写：fn 在写临界区内看到
    /// 最新的已提交值（不存在时为 ""），因此
    /// 同一键上的并发 UpdateAtomic 调用不会丢失更新。返回
    /// 最终存储的结果。</summary>
    async string UpdateAtomic(string key, KvUpdater fn) {
        await this.rw.EnterWrite();
        Begin();
        string cur = Get(key);
        string next = fn(cur);
        Put(key, next);
        Commit();
        this.rw.ExitWrite();
        return next;
    }
}
