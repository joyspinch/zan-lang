using System;
using System.IO;
using System.Threading;

namespace System.Data.ZanDb;

/// <summary>Computes the new value from the current one inside the write
/// critical section (current is "" when the key is absent).</summary>
delegate string KvUpdater(string current);

/// <summary>
/// Embedded key/value store: one file, copy-on-write B+Tree index, LRU page
/// cache with a hard memory cap, atomic commits through alternating meta
/// pages. Open-and-go facade:
///
///   KvStore db = KvStore.Open("app.zdb");
///   db.Put("user:1", "alice");
///   string v = db.Get("user:1");
///   db.Close();
///
/// Concurrency is the single-writer / many-reader model: readers never block
/// and never take a lock, because the pages of the snapshot they are reading
/// are never modified in place; writers serialise on a cross-process lock, so
/// several processes (for instance the workers of a web server) may open the
/// same file safely.
///
/// Writes auto-commit. Wrap several writes in Begin()/Commit() to make them
/// one atomic -- and much faster, and much easier on an SSD -- transaction:
/// inside one transaction a page is copied once no matter how many keys in it
/// change. Coroutine-safe async variants (GetAsync/PutAsync/UpdateAtomic)
/// additionally serialise the coroutines of one process.
/// </summary>
class KvStore {
    Pager pager;
    BTree tree;
    AsyncRwLock rw;
    int txDepth;
    string lastError;

    KvStore() {
        this.txDepth = 0;
        this.lastError = "";
    }

    /// <summary>Opens (creating if needed) a store with a 256-page (1 MB)
    /// cache, fsyncing every commit.</summary>
    static KvStore Open(string path) {
        return KvStore.Open(path, 256);
    }

    /// <summary>Opens with an explicit page-cache capacity (pages are 4 KB).</summary>
    static KvStore Open(string path, int cachePages) {
        KvStore s = new KvStore();
        s.pager = Pager.Open(path, cachePages);
        if (!s.pager.IsOpen()) {
            s.lastError = s.pager.GetError();
            return s;
        }
        s.tree = BTree.Open(s.pager);
        s.rw = AsyncRwLock.Create();
        return s;
    }

    bool IsOpen() { return this.lastError.Length == 0 && this.pager.IsOpen(); }

    string GetError() { return this.lastError; }

    /// <summary>Data-page fsync cadence: 1 = every commit (default), N = every
    /// N commits. The meta page is always written after the data pages, so a
    /// larger N risks losing the last commits, never a broken database.</summary>
    void SetSyncEvery(int n) { this.pager.SetSyncEvery(n); }

    /// <summary>Transaction id of the snapshot this handle last read.</summary>
    long Version() { return this.pager.CommitId(); }

    /// <summary>Pages in the file, and pages on the free list -- the two
    /// numbers space growth is judged by.</summary>
    int PageCount() { return this.pager.PageCount(); }

    int FreePages() { return this.pager.FreePages(); }

    /// <summary>Pages written to disk since this handle was opened: the input
    /// for a write-amplification measurement (pages written vs. bytes of data
    /// actually changed).</summary>
    int PageWrites() { return this.pager.PageWrites(); }

    // ===== Synchronous core =====

    /// <summary>Pins one snapshot for several reads: everything read until
    /// EndSnapshot() sees the same version of the database, even while other
    /// processes commit. Readers take no lock; the cost of a long snapshot is
    /// that pages it can still see are not reused meanwhile.</summary>
    void BeginSnapshot() { this.pager.BeginRead(); }

    void EndSnapshot() { this.pager.EndRead(); }

    /// <summary>Returns the value, or "" when absent (see Contains).</summary>
    string Get(string key) {
        this.pager.BeginRead();
        List<string> outv = new List<string>();
        bool ok = this.tree.Get(key, outv);
        this.pager.EndRead();
        if (ok) { return outv[0]; }
        return "";
    }

    bool Contains(string key) {
        this.pager.BeginRead();
        bool ok = this.tree.Contains(key);
        this.pager.EndRead();
        return ok;
    }

    /// <summary>Inserts or replaces a key. Auto-commits unless inside
    /// Begin()/Commit().</summary>
    void Put(string key, string val) {
        if (this.txDepth > 0) {
            this.tree.Put(key, val);
            return;
        }
        if (!this.pager.BeginWrite()) {
            this.lastError = this.pager.GetError();
            return;
        }
        this.tree.Put(key, val);
        if (!this.pager.Commit()) { this.lastError = this.pager.GetError(); }
    }

    /// <summary>Removes a key; true when it existed.</summary>
    bool Delete(string key) {
        if (this.txDepth > 0) {
            return this.tree.Delete(key);
        }
        if (!this.pager.BeginWrite()) {
            this.lastError = this.pager.GetError();
            return false;
        }
        bool existed = this.tree.Delete(key);
        if (!this.pager.Commit()) { this.lastError = this.pager.GetError(); }
        return existed;
    }

    /// <summary>Deletes every key with startKey &lt;= key &lt;= endKey
    /// (endKey "" = to the end) in one transaction; returns how many were
    /// removed. Leaves that fall entirely inside the range are freed as whole
    /// pages instead of being rewritten key by key, so dropping a batch costs
    /// about one page write per tree level -- the path to use when a batch of
    /// records (a plan, a tenant, a day) is replaced wholesale.</summary>
    int DeleteRange(string startKey, string endKey) {
        if (this.txDepth > 0) { return this.tree.DeleteRange(startKey, endKey); }
        if (!this.pager.BeginWrite()) {
            this.lastError = this.pager.GetError();
            return 0;
        }
        int n = this.tree.DeleteRange(startKey, endKey);
        if (!this.pager.Commit()) { this.lastError = this.pager.GetError(); }
        return n;
    }

    /// <summary>Deletes every key starting with prefix (see DeleteRange).</summary>
    int DeletePrefix(string prefix) {
        if (this.txDepth > 0) { return this.tree.DeletePrefix(prefix); }
        if (!this.pager.BeginWrite()) {
            this.lastError = this.pager.GetError();
            return 0;
        }
        int n = this.tree.DeletePrefix(prefix);
        if (!this.pager.Commit()) { this.lastError = this.pager.GetError(); }
        return n;
    }

    /// <summary>Starts a batch: takes the writer lock, accumulates writes and
    /// commits them atomically on Commit(). Nestable: only the outermost
    /// Commit persists. Holding a transaction open holds the writer lock, so
    /// keep batches bounded.</summary>
    void Begin() {
        if (this.txDepth == 0) {
            if (!this.pager.BeginWrite()) {
                this.lastError = this.pager.GetError();
                return;
            }
        }
        this.txDepth = this.txDepth + 1;
    }

    /// <summary>Atomically persists everything since the outermost Begin().</summary>
    bool Commit() {
        if (this.txDepth > 0) { this.txDepth = this.txDepth - 1; }
        if (this.txDepth > 0) { return true; }
        return this.pager.Commit();
    }

    /// <summary>Throws away everything written since the outermost Begin();
    /// the database stays on the previous version.</summary>
    void Rollback() {
        this.txDepth = 0;
        this.pager.Rollback();
    }

    /// <summary>Range scan: startKey &lt;= key &lt;= endKey (endKey "" = to end),
    /// limit 0 = unlimited. Returns number of entries appended.</summary>
    int Scan(string startKey, string endKey, int limit, List<KvEntry> output) {
        this.pager.BeginRead();
        int n = this.tree.Scan(startKey, endKey, limit, output);
        this.pager.EndRead();
        return n;
    }

    /// <summary>All keys with the given prefix (e.g. "user:").</summary>
    int ScanPrefix(string prefix, int limit, List<KvEntry> output) {
        List<KvEntry> entries = new List<KvEntry>();
        Scan(prefix, "", 0, entries);
        int added = 0;
        int i = 0;
        while (i < entries.Count) {
            string k = entries[i].key;
            if (k.Length < prefix.Length) { break; }
            if (k.Substring(0, prefix.Length) != prefix) { break; }
            output.Add(entries[i]);
            added = added + 1;
            if (limit > 0 && added >= limit) { break; }
            i = i + 1;
        }
        return added;
    }

    int Count() {
        this.pager.BeginRead();
        int n = this.tree.Count();
        this.pager.EndRead();
        return n;
    }

    /// <summary>Forces everything written so far to stable storage.</summary>
    void Checkpoint() { this.pager.Checkpoint(); }

    void Close() {
        this.pager.Close();
        this.rw.Close();
    }

    // ===== Coroutine-safe async API =====

    /// <summary>Shared-lock read; safe alongside concurrent writers.</summary>
    async string GetAsync(string key) {
        await this.rw.EnterRead();
        string v = Get(key);
        this.rw.ExitRead();
        return v;
    }

    /// <summary>Exclusive-lock write with auto-commit.</summary>
    async void PutAsync(string key, string val) {
        await this.rw.EnterWrite();
        Put(key, val);
        this.rw.ExitWrite();
    }

    async bool DeleteAsync(string key) {
        await this.rw.EnterWrite();
        bool existed = Delete(key);
        this.rw.ExitWrite();
        return existed;
    }

    /// <summary>Atomic read-modify-write: fn sees the latest committed value
    /// ("" when absent) inside the write critical section, so concurrent
    /// UpdateAtomic calls on the same key never lose updates. Returns the
    /// stored result.</summary>
    async string UpdateAtomic(string key, KvUpdater fn) {
        await this.rw.EnterWrite();
        Begin();
        string cur = Get(key);
        string next = fn(cur);
        Put(key, next);
        Commit();
        this.rw.ExitWrite();
        return next;
    }
}
