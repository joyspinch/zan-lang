using System;
using System.IO;
using System.Text;

namespace System.Data.ZanDb;

/// <summary>
/// Decoded form of one B+Tree node (leaf or internal). Nodes are encoded
/// into fixed-size pager pages; mutation happens on the decoded lists and the
/// node is re-encoded, splitting when it no longer fits a page.
/// </summary>
class BNode {
    bool leaf;
    List<string> keys;
    List<string> vals;      // leaf only
    List<int> ovf;          // leaf only: first overflow page id (0 = inline)
    List<int> children;     // internal only: keys.Count + 1 entries

    BNode(bool isLeaf) {
        this.leaf = isLeaf;
        this.keys = new List<string>();
        this.vals = new List<string>();
        this.ovf = new List<int>();
        this.children = new List<int>();
    }

    static BNode Leaf() { return new BNode(true); }
    static BNode Internal() { return new BNode(false); }

    /// <summary>Independent copy. A node decoded from a committed page is
    /// shared with the node cache and with concurrent readers of that
    /// snapshot, so a writer mutates a copy and stores it in a new page.</summary>
    BNode Copy() {
        BNode c = new BNode(this.leaf);
        int i = 0;
        while (i < this.keys.Count) { c.keys.Add(this.keys[i]); i = i + 1; }
        i = 0;
        while (i < this.vals.Count) { c.vals.Add(this.vals[i]); i = i + 1; }
        i = 0;
        while (i < this.ovf.Count) { c.ovf.Add(this.ovf[i]); i = i + 1; }
        i = 0;
        while (i < this.children.Count) { c.children.Add(this.children[i]); i = i + 1; }
        return c;
    }
}

/// <summary>
/// Fixed-capacity cache of decoded nodes keyed by page id, so hot lookups
/// skip re-decoding a page into keys/values on every visit. Entries describe
/// immutable page contents: a page that is copied, freed or reused is dropped
/// from the cache, and the whole cache is dropped when the snapshot moves.
/// </summary>
class NodeCache {
    int slots;          // power of two
    int capacity;
    int count;
    int dead;           // tombstones
    List<int> ids;      // pageId + 1; 0 = empty, -1 = tombstone
    List<BNode> nodes;

    NodeCache(int cap) {
        this.capacity = cap;
        int s = 16;
        while (s < cap * 4) { s = s * 2; }
        this.slots = s;
        this.count = 0;
        this.dead = 0;
        this.ids = new List<int>();
        this.nodes = new List<BNode>();
        int i = 0;
        while (i < s) {
            this.ids.Add(0);
            this.nodes.Add(BNode.Leaf());
            i = i + 1;
        }
    }

    static NodeCache Create(int cap) { return new NodeCache(cap); }

    int FindSlot(int pageId) {
        int mask = this.slots - 1;
        int h = (pageId * 2654435761) & mask;
        if (h < 0) { h = -h & mask; }
        while (true) {
            int k = this.ids[h];
            if (k == 0) { return -(h + 1); }        // free slot, encoded
            if (k == pageId + 1) { return h; }
            h = (h + 1) & mask;
        }
        return 0;
    }

    /// <summary>Cached node or null.</summary>
    BNode Get(int pageId) {
        int s = FindSlot(pageId);
        if (s < 0) { return null; }
        return this.nodes[s];
    }

    void Put(int pageId, BNode n) {
        int s = FindSlot(pageId);
        if (s >= 0) {
            this.nodes[s] = n;
            return;
        }
        if (this.count + this.dead >= this.capacity) { Clear(); s = FindSlot(pageId); }
        int slot = -s - 1;
        this.ids[slot] = pageId + 1;
        this.nodes[slot] = n;
        this.count = this.count + 1;
    }

    /// <summary>Forgets one page: its id is about to hold different content
    /// (copy-on-write or free-list reuse), so a stale decode must not survive.</summary>
    void Remove(int pageId) {
        int s = FindSlot(pageId);
        if (s < 0) { return; }
        this.ids[s] = -1;
        this.nodes[s] = BNode.Leaf();
        this.count = this.count - 1;
        this.dead = this.dead + 1;
    }

    void Clear() {
        int i = 0;
        BNode empty = BNode.Leaf();
        while (i < this.slots) {
            this.ids[i] = 0;
            this.nodes[i] = empty;
            i = i + 1;
        }
        this.count = 0;
        this.dead = 0;
    }
}

/// <summary>
/// Copy-on-write disk B+Tree over a <see cref="Pager"/>: sorted string keys,
/// string values, cursor-based range scans.
///
/// No page is ever modified in place once it is part of a committed snapshot:
/// an update copies the leaf to a new page and rewrites the path up to the
/// root, which the pager then publishes in the meta page. That is what makes
/// a reader safe without any lock -- the pages it walks cannot change under
/// it -- and what makes a commit atomic without a redo log.
///
/// Because a page's parent is rewritten anyway, leaves carry no sibling
/// pointer (it could not be maintained under copy-on-write without touching
/// the left neighbour); range scans keep an explicit cursor stack instead.
///
/// Values larger than INLINE_MAX live in chained overflow pages, so value
/// size is unbounded; keys must fit a node.
/// </summary>
class BTree {
    static int PAGE_SIZE = 4096;
    static int MATCH_RANGE = 0;    // startKey <= key <= endKey ("" = to end)
    static int MATCH_PREFIX = 1;   // key starts with startKey
    static int TYPE_LEAF = 1;      // legacy: plain key/val strings
    static int TYPE_INTERNAL = 2;
    static int TYPE_LEAF2 = 3;     // per-entry flag: inline or overflow ref
    static int INLINE_MAX = 1024;  // values above this go to overflow pages
    static int OVF_CHUNK = 4000;   // payload bytes per overflow page

    Pager pager;
    string lastError;
    NodeCache nodeCache;

    BTree() {
        this.lastError = "";
    }

    /// <summary>Opens the tree stored in the pager, creating an empty root on
    /// a fresh database.</summary>
    static BTree Open(Pager pager) {
        BTree t = new BTree();
        t.pager = pager;
        t.nodeCache = NodeCache.Create(1024);
        if (pager.RootId() == 0) {
            if (!pager.BeginWrite()) {
                t.lastError = pager.GetError();
                return t;
            }
            if (pager.RootId() == 0) {
                int root = pager.AllocPage();
                t.WriteNode(root, BNode.Leaf());
                pager.SetRoot(root);
                pager.Commit();
            } else {
                pager.Rollback();
            }
        }
        return t;
    }

    string GetError() { return this.lastError; }

    int RootId() { return this.pager.RootId(); }

    /// <summary>Drops decoded nodes when the pager adopted another process's
    /// commit: page ids may now hold different content.</summary>
    void Sync() {
        if (this.pager.TakeInvalidation()) { this.nodeCache.Clear(); }
    }

    static void InsStr(List<string> l, int idx, string v) {
        l.Add("");
        int m = l.Count - 1;
        while (m > idx) {
            l[m] = l[m - 1];
            m = m - 1;
        }
        l[idx] = v;
    }

    static void InsInt(List<int> l, int idx, int v) {
        l.Add(0);
        int m = l.Count - 1;
        while (m > idx) {
            l[m] = l[m - 1];
            m = m - 1;
        }
        l[idx] = v;
    }

    static int Compare(string a, string b) {
        int la = a.Length;
        int lb = b.Length;
        int n = la;
        if (lb < n) { n = lb; }
        int i = 0;
        while (i < n) {
            int ca = a[i] & 255;
            int cb = b[i] & 255;
            if (ca != cb) { return ca - cb; }
            i = i + 1;
        }
        return la - lb;
    }

    // ===== Node encode/decode =====

    /// <summary>Reads a whole overflow chain back into one string.</summary>
    string ReadChain(int firstPage) {
        StringBuilder sb = new StringBuilder();
        int pid = firstPage;
        while (pid != 0) {
            ByteBuffer pg = this.pager.GetPage(pid);
            pg.SeekRead(0);
            int nxt = Pager.PageIdOf(pg.ReadU64());
            sb.Append(pg.ReadString());
            pid = nxt;
        }
        return sb.ToString();
    }

    /// <summary>Writes val into a chain of freshly allocated overflow pages;
    /// returns the first page id.</summary>
    int WriteChain(string val) {
        int total = val.Length;
        int nchunks = (total + BTree.OVF_CHUNK - 1) / BTree.OVF_CHUNK;
        if (nchunks == 0) { nchunks = 1; }
        // Build back-to-front so each page knows its successor.
        List<int> ids = new List<int>();
        int i = 0;
        while (i < nchunks) { ids.Add(this.pager.AllocPage()); i = i + 1; }
        i = 0;
        while (i < nchunks) {
            int off = i * BTree.OVF_CHUNK;
            int len = total - off;
            if (len > BTree.OVF_CHUNK) { len = BTree.OVF_CHUNK; }
            ByteBuffer pg = this.pager.GetPage(ids[i]);
            pg.Clear();
            if (i + 1 < nchunks) { pg.WriteU64(ids[i + 1]); } else { pg.WriteU64(0); }
            pg.WriteString(val.Substring(off, len));
            pg.SetLength(BTree.PAGE_SIZE);
            i = i + 1;
        }
        return ids[0];
    }

    /// <summary>Hands an overflow chain to the free list. The pages stay
    /// readable until no snapshot references them.</summary>
    void FreeChain(int firstPage) {
        int pid = firstPage;
        while (pid != 0) {
            ByteBuffer pg = this.pager.GetPage(pid);
            pg.SeekRead(0);
            int nxt = Pager.PageIdOf(pg.ReadU64());
            this.pager.FreeLater(pid);
            pid = nxt;
        }
    }

    BNode ReadNode(int pageId) {
        BNode cached = this.nodeCache.Get(pageId);
        if (cached != null) { return cached; }
        ByteBuffer pg = this.pager.GetPage(pageId);
        pg.SeekRead(0);
        int type = pg.ReadU8();
        int nkeys = pg.ReadU16();
        if (type == BTree.TYPE_LEAF) {
            BNode n = BNode.Leaf();
            pg.ReadU64();                       // legacy sibling pointer
            int i = 0;
            while (i < nkeys) {
                n.keys.Add(pg.ReadString());
                n.vals.Add(pg.ReadString());
                n.ovf.Add(0);
                i = i + 1;
            }
            this.nodeCache.Put(pageId, n);
            return n;
        }
        if (type == BTree.TYPE_LEAF2) {
            BNode n = BNode.Leaf();
            pg.ReadU64();                       // reserved (was sibling pointer)
            int i = 0;
            while (i < nkeys) {
                n.keys.Add(pg.ReadString());
                int flag = pg.ReadU8();
                if (flag == 0) {
                    n.vals.Add(pg.ReadString());
                    n.ovf.Add(0);
                } else {
                    int first = Pager.PageIdOf(pg.ReadU64());
                    n.vals.Add(ReadChain(first));
                    n.ovf.Add(first);
                }
                i = i + 1;
            }
            this.nodeCache.Put(pageId, n);
            return n;
        }
        BNode m = BNode.Internal();
        m.children.Add(Pager.PageIdOf(pg.ReadU64()));
        int j = 0;
        while (j < nkeys) {
            m.keys.Add(pg.ReadString());
            m.children.Add(Pager.PageIdOf(pg.ReadU64()));
            j = j + 1;
        }
        this.nodeCache.Put(pageId, m);
        return m;
    }

    static int EncodedSize(BNode n) {
        int size = 3;   // type + nkeys
        if (n.leaf) {
            size = size + 8;   // reserved
            int i = 0;
            while (i < n.keys.Count) {
                size = size + 5 + n.keys[i].Length + 1;   // key + flag
                if (n.vals[i].Length > BTree.INLINE_MAX) {
                    size = size + 8;                       // overflow page ref
                } else {
                    size = size + 5 + n.vals[i].Length;
                }
                i = i + 1;
            }
            return size;
        }
        size = size + 8;
        int j = 0;
        while (j < n.keys.Count) {
            size = size + 5 + n.keys[j].Length + 8;
            j = j + 1;
        }
        return size;
    }

    /// <summary>Encodes a node into a page that belongs to the running
    /// transaction.</summary>
    void WriteNode(int pageId, BNode n) {
        if (n.leaf) {
            // Move large values out to overflow chains first (allocating
            // pages may touch the pager, so do it before encoding).
            int i = 0;
            while (i < n.keys.Count) {
                if (n.vals[i].Length > BTree.INLINE_MAX && n.ovf[i] == 0) {
                    n.ovf[i] = WriteChain(n.vals[i]);
                }
                i = i + 1;
            }
        }
        ByteBuffer pg = this.pager.GetPage(pageId);
        pg.Clear();
        if (n.leaf) {
            pg.WriteU8(BTree.TYPE_LEAF2);
            pg.WriteU16(n.keys.Count);
            pg.WriteU64(0);
            int i = 0;
            while (i < n.keys.Count) {
                pg.WriteString(n.keys[i]);
                if (n.ovf[i] != 0) {
                    pg.WriteU8(1);
                    pg.WriteU64(n.ovf[i]);
                } else {
                    pg.WriteU8(0);
                    pg.WriteString(n.vals[i]);
                }
                i = i + 1;
            }
        } else {
            pg.WriteU8(BTree.TYPE_INTERNAL);
            pg.WriteU16(n.keys.Count);
            pg.WriteU64(n.children[0]);
            int j = 0;
            while (j < n.keys.Count) {
                pg.WriteString(n.keys[j]);
                pg.WriteU64(n.children[j + 1]);
                j = j + 1;
            }
        }
        pg.SetLength(BTree.PAGE_SIZE);
        this.nodeCache.Put(pageId, n);
    }

    /// <summary>Stores a modified node: in place when the page was created by
    /// this transaction, otherwise in a new page whose id is returned while the
    /// old page goes to the free list (copy-on-write).</summary>
    int WriteNodeCow(int oldPageId, BNode n) {
        if (this.pager.IsFresh(oldPageId)) {
            WriteNode(oldPageId, n);
            return oldPageId;
        }
        int nid = this.pager.AllocPage();
        WriteNode(nid, n);
        this.nodeCache.Remove(oldPageId);
        this.pager.FreeLater(oldPageId);
        return nid;
    }

    /// <summary>Returns the node to mutate: the cached one when the page
    /// belongs to this transaction (nobody else can see it), a copy
    /// otherwise.</summary>
    BNode NodeForWrite(int pageId) {
        BNode n = ReadNode(pageId);
        if (this.pager.IsFresh(pageId)) { return n; }
        return n.Copy();
    }

    // ===== Search =====

    /// <summary>Index of the child to descend into for key: binary search
    /// for the first separator strictly greater than key.</summary>
    static int ChildIndex(BNode n, string key) {
        int lo = 0;
        int hi = n.keys.Count;
        while (lo < hi) {
            int mid = (lo + hi) / 2;
            if (BTree.Compare(key, n.keys[mid]) >= 0) { lo = mid + 1; } else { hi = mid; }
        }
        return lo;
    }

    /// <summary>Binary search for the first index whose key is >= key
    /// (n.keys.Count when all keys are smaller).</summary>
    static int LowerBound(BNode n, string key) {
        int lo = 0;
        int hi = n.keys.Count;
        while (lo < hi) {
            int mid = (lo + hi) / 2;
            if (BTree.Compare(n.keys[mid], key) < 0) { lo = mid + 1; } else { hi = mid; }
        }
        return lo;
    }

    /// <summary>Position of key in a leaf, or -1.</summary>
    static int LeafFind(BNode n, string key) {
        int lb = BTree.LowerBound(n, key);
        if (lb < n.keys.Count && BTree.Compare(n.keys[lb], key) == 0) { return lb; }
        return -1;
    }

    /// <summary>Looks up a key. Returns true and stores the value in outVal
    /// (single-element list) when found.</summary>
    bool Get(string key, List<string> outVal) {
        Sync();
        int pid = RootId();
        BNode n = ReadNode(pid);
        while (!n.leaf) {
            pid = n.children[BTree.ChildIndex(n, key)];
            n = ReadNode(pid);
        }
        int pos = BTree.LeafFind(n, key);
        if (pos < 0) { return false; }
        outVal.Add(n.vals[pos]);
        return true;
    }

    bool Contains(string key) {
        List<string> tmp = new List<string>();
        return Get(key, tmp);
    }

    // ===== Insert =====

    /// <summary>Inserts or replaces key -> val inside the running write
    /// transaction (durable once the pager commits).</summary>
    void Put(string key, string val) {
        Sync();
        List<int> path = new List<int>();       // page ids root..parent of leaf
        List<int> pathIdx = new List<int>();    // child index taken at each internal
        int pid = RootId();
        BNode probe = ReadNode(pid);
        while (!probe.leaf) {
            int ci = BTree.ChildIndex(probe, key);
            path.Add(pid);
            pathIdx.Add(ci);
            pid = probe.children[ci];
            probe = ReadNode(pid);
        }

        BNode n = NodeForWrite(pid);
        int ins = BTree.LowerBound(n, key);
        if (ins < n.keys.Count && BTree.Compare(n.keys[ins], key) == 0) {
            if (n.ovf[ins] != 0) { FreeChain(n.ovf[ins]); n.ovf[ins] = 0; }
            n.vals[ins] = val;
        } else {
            BTree.InsStr(n.keys, ins, key);
            BTree.InsStr(n.vals, ins, val);
            BTree.InsInt(n.ovf, ins, 0);
        }

        if (BTree.EncodedSize(n) <= BTree.PAGE_SIZE) {
            int newLeaf = WriteNodeCow(pid, n);
            if (newLeaf != pid) {
                ReplaceUp(path, pathIdx, path.Count - 1, newLeaf);
            }
            return;
        }

        // Split the leaf. Normally left/right each keep half. But for
        // monotonically increasing keys (auto-increment ids, timestamps) a
        // 50/50 split leaves every full leaf permanently ~half empty, since all
        // later inserts land in the right sibling. When the key just written is
        // the node maximum, move only that entry to the new right page so the
        // left page stays nearly full -- roughly doubling density for the
        // common append workload.
        int mid = n.keys.Count / 2;
        if (ins > mid) { mid = ins; }
        BNode right = BNode.Leaf();
        int k = mid;
        while (k < n.keys.Count) {
            right.keys.Add(n.keys[k]);
            right.vals.Add(n.vals[k]);
            right.ovf.Add(n.ovf[k]);
            k = k + 1;
        }
        while (n.keys.Count > mid) {
            n.keys.RemoveAt(n.keys.Count - 1);
            n.vals.RemoveAt(n.vals.Count - 1);
            n.ovf.RemoveAt(n.ovf.Count - 1);
        }
        int rightId = this.pager.AllocPage();
        WriteNode(rightId, right);
        int leftId = WriteNodeCow(pid, n);
        InsertUp(path, pathIdx, path.Count - 1, leftId, right.keys[0], rightId);
    }

    /// <summary>Rewrites the path above a copied node so it points at the new
    /// page, up to the root (which the pager republishes).</summary>
    void ReplaceUp(List<int> path, List<int> pathIdx, int level, int newChildId) {
        int child = newChildId;
        int lv = level;
        while (lv >= 0) {
            int ppid = path[lv];
            int ci = pathIdx[lv];
            BNode p = NodeForWrite(ppid);
            p.children[ci] = child;
            int np = WriteNodeCow(ppid, p);
            if (np == ppid) { return; }      // page already belonged to this txn
            child = np;
            lv = lv - 1;
        }
        this.pager.SetRoot(child);
    }

    /// <summary>Propagates a split upward: the (possibly copied) left child,
    /// a separator key and the new right child.</summary>
    void InsertUp(List<int> path, List<int> pathIdx, int level,
            int leftId, string sep, int rightId) {
        int curLeft = leftId;
        string curSep = sep;
        int curRight = rightId;
        int lv = level;
        while (lv >= 0) {
            int ppid = path[lv];
            int ci = pathIdx[lv];
            BNode n = NodeForWrite(ppid);
            n.children[ci] = curLeft;
            BTree.InsStr(n.keys, ci, curSep);
            BTree.InsInt(n.children, ci + 1, curRight);
            if (BTree.EncodedSize(n) <= BTree.PAGE_SIZE) {
                int np = WriteNodeCow(ppid, n);
                if (np != ppid) { ReplaceUp(path, pathIdx, lv - 1, np); }
                return;
            }
            // Split internal: middle key moves up.
            int mid = n.keys.Count / 2;
            string upKey = n.keys[mid];
            BNode right = BNode.Internal();
            int k = mid + 1;
            while (k < n.keys.Count) {
                right.keys.Add(n.keys[k]);
                k = k + 1;
            }
            k = mid + 1;
            while (k < n.children.Count) {
                right.children.Add(n.children[k]);
                k = k + 1;
            }
            while (n.keys.Count > mid) {
                n.keys.RemoveAt(n.keys.Count - 1);
            }
            while (n.children.Count > mid + 1) {
                n.children.RemoveAt(n.children.Count - 1);
            }
            int newRightId = this.pager.AllocPage();
            WriteNode(newRightId, right);
            curLeft = WriteNodeCow(ppid, n);
            curSep = upKey;
            curRight = newRightId;
            lv = lv - 1;
        }
        // Root split: grow the tree by one level.
        BNode newRoot = BNode.Internal();
        newRoot.children.Add(curLeft);
        newRoot.keys.Add(curSep);
        newRoot.children.Add(curRight);
        int newRootId = this.pager.AllocPage();
        WriteNode(newRootId, newRoot);
        this.pager.SetRoot(newRootId);
    }

    // ===== Delete =====

    /// <summary>Removes a key. Returns true when it existed. Empty leaves are
    /// left in place and reclaimed by future compaction (no merge yet).</summary>
    bool Delete(string key) {
        Sync();
        List<int> path = new List<int>();
        List<int> pathIdx = new List<int>();
        int pid = RootId();
        BNode probe = ReadNode(pid);
        while (!probe.leaf) {
            int ci = BTree.ChildIndex(probe, key);
            path.Add(pid);
            pathIdx.Add(ci);
            pid = probe.children[ci];
            probe = ReadNode(pid);
        }
        if (BTree.LeafFind(probe, key) < 0) { return false; }

        BNode n = NodeForWrite(pid);
        int pos = BTree.LeafFind(n, key);
        if (pos < 0) { return false; }
        if (n.ovf[pos] != 0) { FreeChain(n.ovf[pos]); }
        n.keys.RemoveAt(pos);
        n.vals.RemoveAt(pos);
        n.ovf.RemoveAt(pos);
        int newLeaf = WriteNodeCow(pid, n);
        if (newLeaf != pid) {
            ReplaceUp(path, pathIdx, path.Count - 1, newLeaf);
        }
        return true;
    }

    // ===== Range delete =====

    /// <summary>Frees a leaf page and the overflow chains it references,
    /// without decoding values: dropping a batch must not pay for reading the
    /// data it throws away.</summary>
    void FreeLeafPage(int pageId) {
        ByteBuffer pg = this.pager.GetPage(pageId);
        pg.SeekRead(0);
        int type = pg.ReadU8();
        int nkeys = pg.ReadU16();
        pg.ReadU64();
        if (type == BTree.TYPE_LEAF2) {
            int i = 0;
            while (i < nkeys) {
                pg.ReadString();
                if (pg.ReadU8() == 0) {
                    pg.ReadString();
                } else {
                    FreeChain(Pager.PageIdOf(pg.ReadU64()));
                }
                i = i + 1;
            }
        }
        this.nodeCache.Remove(pageId);
        this.pager.FreeLater(pageId);
    }

    /// <summary>Deletes every key with startKey &lt;= key &lt;= endKey
    /// (endKey "" = to the end) and returns how many were removed.
    ///
    /// This is the batch path: a leaf entirely inside the range is handed to
    /// the free list as a whole page -- not decoded, not rewritten -- and each
    /// parent on the way is rewritten once, so dropping a batch costs about
    /// one page write per tree level plus the two boundary leaves, instead of
    /// one path rewrite per key. Keys of one batch must therefore share a
    /// prefix (for example "kw:&lt;planId&gt;:") so the batch is one range.</summary>
    int DeleteRange(string startKey, string endKey) {
        return DeleteMatching(startKey, endKey, BTree.MATCH_RANGE);
    }

    /// <summary>Deletes every key starting with prefix -- "drop this batch" --
    /// and returns how many were removed.</summary>
    int DeletePrefix(string prefix) {
        return DeleteMatching(prefix, prefix, BTree.MATCH_PREFIX);
    }

    int DeleteMatching(string startKey, string endKey, int mode) {
        Sync();
        List<int> removed = new List<int>();
        removed.Add(0);
        int root = RootId();
        int nr = PruneNode(root, startKey, endKey, mode, removed);
        if (nr == 0) {
            int freshRoot = this.pager.AllocPage();
            WriteNode(freshRoot, BNode.Leaf());
            this.pager.SetRoot(freshRoot);
        } else if (nr != root) {
            this.pager.SetRoot(nr);
        }
        return removed[0];
    }

    static bool InRange(string key, string startKey, string endKey, int mode) {
        if (mode == BTree.MATCH_PREFIX) {
            if (key.Length < startKey.Length) { return false; }
            return key.Substring(0, startKey.Length) == startKey;
        }
        if (BTree.Compare(key, startKey) < 0) { return false; }
        if (endKey.Length == 0) { return true; }
        return BTree.Compare(key, endKey) <= 0;
    }

    /// <summary>Removes a range inside one subtree. Returns the (possibly
    /// copied) page id, or 0 when the whole subtree fell inside the range and
    /// its pages went to the free list.</summary>
    int PruneNode(int pageId, string startKey, string endKey, int mode,
            List<int> removed) {
        BNode node = ReadNode(pageId);
        if (node.leaf) {
            int inRange = 0;
            int i = 0;
            while (i < node.keys.Count) {
                if (BTree.InRange(node.keys[i], startKey, endKey, mode)) {
                    inRange = inRange + 1;
                }
                i = i + 1;
            }
            if (inRange == 0) { return pageId; }
            if (inRange == node.keys.Count) {
                removed[0] = removed[0] + inRange;
                FreeLeafPage(pageId);
                return 0;
            }
            BNode n = NodeForWrite(pageId);
            int j = n.keys.Count - 1;
            while (j >= 0) {
                if (BTree.InRange(n.keys[j], startKey, endKey, mode)) {
                    if (n.ovf[j] != 0) { FreeChain(n.ovf[j]); }
                    n.keys.RemoveAt(j);
                    n.vals.RemoveAt(j);
                    n.ovf.RemoveAt(j);
                    removed[0] = removed[0] + 1;
                }
                j = j - 1;
            }
            return WriteNodeCow(pageId, n);
        }

        int lo = BTree.ChildIndex(node, startKey);
        int hi = node.children.Count - 1;
        if (mode == BTree.MATCH_PREFIX) {
            // Separators are keys, so a child may hold the prefix as long as
            // the separator that opens it still starts with (or is below) it.
            hi = lo;
            while (hi + 1 < node.children.Count
                    && BTree.InRange(node.keys[hi], startKey, endKey, mode)) {
                hi = hi + 1;
            }
        } else if (endKey.Length > 0) {
            hi = BTree.ChildIndex(node, endKey);
        }
        if (hi > node.children.Count - 1) { hi = node.children.Count - 1; }

        List<int> results = new List<int>();
        bool changed = false;
        int ci = lo;
        while (ci <= hi) {
            int before = node.children[ci];
            int after = PruneNode(before, startKey, endKey, mode, removed);
            results.Add(after);
            if (after != before) { changed = true; }
            ci = ci + 1;
        }
        if (!changed) { return pageId; }

        // Rebuild the node keeping the children that survived. keys[i] is the
        // lower bound of children[i], so a surviving child keeps the separator
        // that precedes it -- everything between two survivors is gone.
        BNode n = NodeForWrite(pageId);
        List<int> keptChildren = new List<int>();
        List<string> keptKeys = new List<string>();
        int k = 0;
        while (k < n.children.Count) {
            int child = n.children[k];
            if (k >= lo && k <= hi) { child = results[k - lo]; }
            if (child != 0) {
                if (keptChildren.Count > 0) { keptKeys.Add(n.keys[k - 1]); }
                keptChildren.Add(child);
            }
            k = k + 1;
        }
        n.children = keptChildren;
        n.keys = keptKeys;
        if (n.children.Count == 0) {
            this.nodeCache.Remove(pageId);
            this.pager.FreeLater(pageId);
            return 0;
        }
        return WriteNodeCow(pageId, n);
    }

    // ===== Range scan =====

    /// <summary>Collects up to limit entries with startKey &lt;= key &lt;= endKey
    /// (endKey "" = unbounded) into outKeys/outVals. Walks the tree with a
    /// cursor stack: under copy-on-write a leaf cannot keep a pointer to its
    /// sibling, since inserting there would have to rewrite the left
    /// neighbour too.</summary>
    int Scan(string startKey, string endKey, int limit,
            List<string> outKeys, List<string> outVals) {
        Sync();
        List<int> stackIds = new List<int>();
        List<int> stackIdx = new List<int>();
        int pid = RootId();
        BNode n = ReadNode(pid);
        while (!n.leaf) {
            int ci = BTree.ChildIndex(n, startKey);
            stackIds.Add(pid);
            stackIdx.Add(ci);
            pid = n.children[ci];
            n = ReadNode(pid);
        }
        int found = 0;
        int i = BTree.LowerBound(n, startKey);
        while (true) {
            while (i < n.keys.Count) {
                if (endKey.Length > 0 && BTree.Compare(n.keys[i], endKey) > 0) {
                    return found;
                }
                outKeys.Add(n.keys[i]);
                outVals.Add(n.vals[i]);
                found = found + 1;
                if (limit > 0 && found >= limit) { return found; }
                i = i + 1;
            }
            // Next leaf: climb until a parent has another child, then descend
            // its leftmost path.
            bool advanced = false;
            while (stackIds.Count > 0) {
                int lv = stackIds.Count - 1;
                BNode p = ReadNode(stackIds[lv]);
                int ci = stackIdx[lv] + 1;
                if (ci < p.children.Count) {
                    stackIdx[lv] = ci;
                    pid = p.children[ci];
                    n = ReadNode(pid);
                    while (!n.leaf) {
                        stackIds.Add(pid);
                        stackIdx.Add(0);
                        pid = n.children[0];
                        n = ReadNode(pid);
                    }
                    i = 0;
                    advanced = true;
                    break;
                }
                stackIds.RemoveAt(lv);
                stackIdx.RemoveAt(lv);
            }
            if (!advanced) { return found; }
        }
        return found;
    }

    /// <summary>Total number of keys. Walks the tree but only reads the entry
    /// count out of each leaf header, so values are never decoded.</summary>
    int Count() {
        Sync();
        return CountNode(RootId());
    }

    int CountNode(int pageId) {
        ByteBuffer pg = this.pager.GetPage(pageId);
        pg.SeekRead(0);
        int type = pg.ReadU8();
        int nkeys = pg.ReadU16();
        if (type != BTree.TYPE_INTERNAL) { return nkeys; }
        BNode n = ReadNode(pageId);
        int total = 0;
        int i = 0;
        while (i < n.children.Count) {
            total = total + CountNode(n.children[i]);
            i = i + 1;
        }
        return total;
    }
}
