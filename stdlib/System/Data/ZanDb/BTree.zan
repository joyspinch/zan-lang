using System;
using System.IO;
using System.Text;

namespace System.Data.ZanDb;

/// <summary>范围或前缀扫描返回的一条键/值记录。</summary>
class KvEntry {
    string key;
    string val;

    KvEntry(string key, string val) {
        this.key = key;
        this.val = val;
    }
}

/// <summary>一条已解码的叶子记录。内联值（inline value）的 overflowPage 为 0。</summary>
class BLeafEntry {
    string key;
    string val;
    int overflowPage;

    BLeafEntry(string key, string val, int overflowPage) {
        this.key = key;
        this.val = val;
        this.overflowPage = overflowPage;
    }
}

/// <summary>
/// 单个 B+Tree 节点（叶子或内部）的解码形式。节点被编码为
/// 固定大小的 pager 页；修改作用于解码后的列表，然后
/// 重新编码节点，放不下时分裂。
/// </summary>
class BNode {
    bool leaf;
    List<BLeafEntry> entries; // 仅叶子
    List<string> keys;        // 仅内部节点
    List<int> children;       // 仅内部节点：keys.Count + 1 项

    BNode(bool isLeaf) {
        this.leaf = isLeaf;
        this.entries = new List<BLeafEntry>();
        this.keys = new List<string>();
        this.children = new List<int>();
    }

    static BNode Leaf() { return new BNode(true); }
    static BNode Internal() { return new BNode(false); }

    /// <summary>独立副本。从已提交页面解码出的节点
    /// 会与节点缓存以及该快照的并发读者共享，
    /// 因此写入方修改副本并存放到新页面。</summary>
    BNode Copy() {
        BNode c = new BNode(this.leaf);
        int i = 0;
        for (; i < this.entries.Count; i = i + 1) {
            BLeafEntry e = this.entries[i];
            c.entries.Add(new BLeafEntry(e.key, e.val, e.overflowPage));
        }
        i = 0;
        while (i < this.keys.Count) { c.keys.Add(this.keys[i]); i = i + 1; }
        i = 0;
        while (i < this.children.Count) { c.children.Add(this.children[i]); i = i + 1; }
        return c;
    }
}

/// <summary>
/// 以页面 id 为键的固定容量解码节点缓存，热门查找
/// 不必每次访问都重新把页面解码成键/值。条目描述的是
/// 不可变的页面内容：被复制、释放或复用的页面会从
/// 缓存中移除，快照推进时整个缓存也会清空。
/// </summary>
class NodeCache {
    int slots;          // 2 的幂
    int capacity;
    int count;
    int dead;           // 墓碑标记
    List<int> ids;      // pageId + 1；0 表示空，-1 表示墓碑
    List<BNode> nodes;

    NodeCache(int cap) {
        this.capacity = cap;
        int s = 16;
        while (s < cap * 4) { s = s * 2; }
        this.slots = s;
        this.count = 0;
        this.dead = 0;
        this.ids = new List<int>();
        this.nodes = new List<BNode>();
        for (int i = 0; i < s; i = i + 1) {
            this.ids.Add(0);
            this.nodes.Add(BNode.Leaf());
        }
    }

    int FindSlot(int pageId) {
        int mask = this.slots - 1;
        int h = (pageId * 2654435761) & mask;
        if (h < 0) { h = -h & mask; }
        while (true) {
            int k = this.ids[h];
            if (k == 0) { return -(h + 1); }        // 空闲槽位（已编码）
            if (k == pageId + 1) { return h; }
            h = (h + 1) & mask;
        }
        return 0;
    }

    /// <summary>缓存的节点，没有则返回 null。</summary>
    BNode Get(int pageId) {
        int s = FindSlot(pageId);
        if (s < 0) { return null; }
        return this.nodes[s];
    }

    void Put(int pageId, BNode n) {
        int s = FindSlot(pageId);
        if (s >= 0) {
            this.nodes[s] = n;
            return;
        }
        if (this.count + this.dead >= this.capacity) { Clear(); s = FindSlot(pageId); }
        int slot = -s - 1;
        this.ids[slot] = pageId + 1;
        this.nodes[slot] = n;
        this.count = this.count + 1;
    }

    /// <summary>忘记某个页面：它的 id 即将存放不同的内容
    /// （写时复制或 free-list 复用），过期的解码结果不能继续存在。</summary>
    void Remove(int pageId) {
        int s = FindSlot(pageId);
        if (s < 0) { return; }
        this.ids[s] = -1;
        this.nodes[s] = BNode.Leaf();
        this.count = this.count - 1;
        this.dead = this.dead + 1;
    }

    void Clear() {
        BNode empty = BNode.Leaf();
        for (int i = 0; i < this.slots; i = i + 1) {
            this.ids[i] = 0;
            this.nodes[i] = empty;
        }
        this.count = 0;
        this.dead = 0;
    }
}

/// <summary>
/// 基于 <see cref="Pager"/> 的写时复制磁盘 B+Tree：字符串键有序，
/// 值为字符串，支持基于游标的范围扫描。
///
/// 页面一旦属于已提交快照就绝不就地修改：
/// 更新时把叶子复制到新页面，并重写直至根节点的路径，
/// 随后 pager 在 meta 页中发布新根。这正是
/// 读者无需加锁也安全的原因——它遍历的页面不会在脚下改变——
/// 也正是不需要 redo log 提交也原子的原因。
///
/// 因为页面的父节点反正会被重写，叶子不带兄弟指针
/// （写时复制下不修改左邻节点就没法维护它）；
/// 范围扫描改用显式的游标栈。
///
/// 大于 INLINE_MAX 的值存放在链式 overflow 页面中，因此值的
/// 大小没有上限；键必须能放进一个节点。
/// </summary>
class BTree {
    static int PAGE_SIZE = 4096;
    static int MATCH_RANGE = 0;    // startKey <= key <= endKey（"" = 直到末尾）
    static int MATCH_PREFIX = 1;   // 键以 startKey 开头
    static int TYPE_LEAF = 1;      // 旧版：普通 key/val 字符串
    static int TYPE_INTERNAL = 2;
    static int TYPE_LEAF2 = 3;     // 逐条目标志：内联或 overflow 引用
    static int INLINE_MAX = 1024;  // 超过该大小的值写入 overflow 页面
    static int OVF_CHUNK = 4000;   // 每个 overflow 页面的负载字节数

    Pager pager;
    string lastError;
    NodeCache nodeCache;

    BTree() {
        this.lastError = "";
    }

    /// <summary>打开 pager 中存储的树；新数据库会创建空根节点
    /// 。</summary>
    static BTree Open(Pager pager) {
        BTree t = new BTree();
        t.pager = pager;
        t.nodeCache = new NodeCache(1024);
        if (pager.RootId() == 0) {
            if (!pager.BeginWrite()) {
                t.lastError = pager.GetError();
                return t;
            }
            if (pager.RootId() == 0) {
                int root = pager.AllocPage();
                t.WriteNode(root, BNode.Leaf());
                pager.SetRoot(root);
                pager.Commit();
            } else {
                pager.Rollback();
            }
        }
        return t;
    }

    string GetError() { return this.lastError; }

    int RootId() { return this.pager.RootId(); }

    /// <summary>当 pager 采纳了另一进程的提交时丢弃已解码的节点：
    /// 页面 id 现在可能存放了不同的内容。</summary>
    void Sync() {
        if (this.pager.TakeInvalidation()) { this.nodeCache.Clear(); }
    }

    static void InsEntry(List<BLeafEntry> l, int idx, BLeafEntry v) {
        l.Add(new BLeafEntry("", "", 0));
        int m = l.Count - 1;
        while (m > idx) {
            l[m] = l[m - 1];
            m = m - 1;
        }
        l[idx] = v;
    }

    static void InsStr(List<string> l, int idx, string v) {
        l.Add("");
        int m = l.Count - 1;
        while (m > idx) {
            l[m] = l[m - 1];
            m = m - 1;
        }
        l[idx] = v;
    }

    static void InsInt(List<int> l, int idx, int v) {
        l.Add(0);
        int m = l.Count - 1;
        while (m > idx) {
            l[m] = l[m - 1];
            m = m - 1;
        }
        l[idx] = v;
    }

    static int Compare(string a, string b) {
        int la = a.Length;
        int lb = b.Length;
        int n = la;
        if (lb < n) { n = lb; }
        for (int i = 0; i < n; i = i + 1) {
            int ca = a[i] & 255;
            int cb = b[i] & 255;
            if (ca != cb) { return ca - cb; }
        }
        return la - lb;
    }

    // ===== 节点编码/解码 =====

    /// <summary>将整条 overflow 链读回为一个字符串。</summary>
    string ReadChain(int firstPage) {
        StringBuilder sb = new StringBuilder();
        int pid = firstPage;
        while (pid != 0) {
            ByteBuffer pg = this.pager.GetPage(pid);
            pg.SeekRead(0);
            int nxt = Pager.PageIdOf(pg.ReadU64());
            sb.Append(pg.ReadString());
            pid = nxt;
        }
        return sb.ToString();
    }

    /// <summary>把 val 写入一串新分配的 overflow 页面，
    /// 返回第一个页面的 id。</summary>
    int WriteChain(string val) {
        int total = val.Length;
        int nchunks = (total + BTree.OVF_CHUNK - 1) / BTree.OVF_CHUNK;
        if (nchunks == 0) { nchunks = 1; }
        // 从后往前构建，使每个页面都知道它的后继。
        List<int> ids = new List<int>();
        int i = 0;
        for (; i < nchunks; i = i + 1) { ids.Add(this.pager.AllocPage()); }
        i = 0;
        while (i < nchunks) {
            int off = i * BTree.OVF_CHUNK;
            int len = total - off;
            if (len > BTree.OVF_CHUNK) { len = BTree.OVF_CHUNK; }
            ByteBuffer pg = this.pager.GetPage(ids[i]);
            pg.Clear();
            if (i + 1 < nchunks) { pg.WriteU64(ids[i + 1]); } else { pg.WriteU64(0); }
            pg.WriteString(val.Substring(off, len));
            pg.SetLength(BTree.PAGE_SIZE);
            i = i + 1;
        }
        return ids[0];
    }

    /// <summary>把一条 overflow 链交给 free list。这些页面在
    /// 没有快照引用前仍保持可读。</summary>
    void FreeChain(int firstPage) {
        int pid = firstPage;
        while (pid != 0) {
            ByteBuffer pg = this.pager.GetPage(pid);
            pg.SeekRead(0);
            int nxt = Pager.PageIdOf(pg.ReadU64());
            this.pager.FreeLater(pid);
            pid = nxt;
        }
    }

    BNode ReadNode(int pageId) {
        BNode cached = this.nodeCache.Get(pageId);
        if (cached != null) { return cached; }
        ByteBuffer pg = this.pager.GetPage(pageId);
        pg.SeekRead(0);
        int type = pg.ReadU8();
        int nkeys = pg.ReadU16();
        if (type == BTree.TYPE_LEAF) {
            BNode n = BNode.Leaf();
            pg.ReadU64();                       // 旧版兄弟指针
            for (int i = 0; i < nkeys; i = i + 1) {
                n.entries.Add(new BLeafEntry(pg.ReadString(), pg.ReadString(), 0));
            }
            this.nodeCache.Put(pageId, n);
            return n;
        }
        if (type == BTree.TYPE_LEAF2) {
            BNode n = BNode.Leaf();
            pg.ReadU64();                       // 保留（原为兄弟指针）
            for (int i = 0; i < nkeys; i = i + 1) {
                string key = pg.ReadString();
                int flag = pg.ReadU8();
                if (flag == 0) {
                    n.entries.Add(new BLeafEntry(key, pg.ReadString(), 0));
                } else {
                    int first = Pager.PageIdOf(pg.ReadU64());
                    n.entries.Add(new BLeafEntry(key, ReadChain(first), first));
                }
            }
            this.nodeCache.Put(pageId, n);
            return n;
        }
        BNode m = BNode.Internal();
        m.children.Add(Pager.PageIdOf(pg.ReadU64()));
        for (int j = 0; j < nkeys; j = j + 1) {
            m.keys.Add(pg.ReadString());
            m.children.Add(Pager.PageIdOf(pg.ReadU64()));
        }
        this.nodeCache.Put(pageId, m);
        return m;
    }

    static int EncodedSize(BNode n) {
        int size = 3;   // 类型 + 键数
        if (n.leaf) {
            size = size + 8;   // 保留字段
            for (int i = 0; i < n.entries.Count; i = i + 1) {
                BLeafEntry e = n.entries[i];
                size = size + 5 + e.key.Length + 1;   // 键 + 标志
                if (e.val.Length > BTree.INLINE_MAX) {
                    size = size + 8;                   // overflow 页面引用
                } else {
                    size = size + 5 + e.val.Length;
                }
            }
            return size;
        }
        size = size + 8;
        for (int j = 0; j < n.keys.Count; j = j + 1) {
            size = size + 5 + n.keys[j].Length + 8;
        }
        return size;
    }

    /// <summary>把节点编码进属于当前事务的页面
    /// 。</summary>
    void WriteNode(int pageId, BNode n) {
        if (n.leaf) {
            // 先把大值移入 overflow 链（分配页面
            // 会接触 pager，所以要在编码前做）。
            for (int i = 0; i < n.entries.Count; i = i + 1) {
                BLeafEntry e = n.entries[i];
                if (e.val.Length > BTree.INLINE_MAX && e.overflowPage == 0) {
                    e.overflowPage = WriteChain(e.val);
                }
            }
        }
        ByteBuffer pg = this.pager.GetPage(pageId);
        pg.Clear();
        if (n.leaf) {
            pg.WriteU8(BTree.TYPE_LEAF2);
            pg.WriteU16(n.entries.Count);
            pg.WriteU64(0);
            for (int i = 0; i < n.entries.Count; i = i + 1) {
                BLeafEntry e = n.entries[i];
                pg.WriteString(e.key);
                if (e.overflowPage != 0) {
                    pg.WriteU8(1);
                    pg.WriteU64(e.overflowPage);
                } else {
                    pg.WriteU8(0);
                    pg.WriteString(e.val);
                }
            }
        } else {
            pg.WriteU8(BTree.TYPE_INTERNAL);
            pg.WriteU16(n.keys.Count);
            pg.WriteU64(n.children[0]);
            for (int j = 0; j < n.keys.Count; j = j + 1) {
                pg.WriteString(n.keys[j]);
                pg.WriteU64(n.children[j + 1]);
            }
        }
        pg.SetLength(BTree.PAGE_SIZE);
        this.nodeCache.Put(pageId, n);
    }

    /// <summary>存储修改后的节点：页面由当前事务创建时原地写入，
    /// 否则写入新页面并返回其 id，
    /// 旧页面进入 free list（写时复制）。</summary>
    int WriteNodeCow(int oldPageId, BNode n) {
        if (this.pager.IsFresh(oldPageId)) {
            WriteNode(oldPageId, n);
            return oldPageId;
        }
        int nid = this.pager.AllocPage();
        WriteNode(nid, n);
        this.nodeCache.Remove(oldPageId);
        this.pager.FreeLater(oldPageId);
        return nid;
    }

    /// <summary>返回要修改的节点：当页面属于当前事务时返回缓存的节点
    /// （没有别人能看到它），否则返回
    /// 副本。</summary>
    BNode NodeForWrite(int pageId) {
        BNode n = ReadNode(pageId);
        if (this.pager.IsFresh(pageId)) { return n; }
        return n.Copy();
    }

    // ===== 查找 =====

    /// <summary>给定 key 要下钻到的子节点索引：二分查找
    /// 第一个严格大于 key 的分隔键。</summary>
    static int ChildIndex(BNode n, string key) {
        int lo = 0;
        int hi = n.keys.Count;
        while (lo < hi) {
            int mid = (lo + hi) / 2;
            if (BTree.Compare(key, n.keys[mid]) >= 0) { lo = mid + 1; } else { hi = mid; }
        }
        return lo;
    }

    /// <summary>二分查找第一个键 >= key 的叶子条目。</summary>
    static int LowerBound(BNode n, string key) {
        int lo = 0;
        int hi = n.entries.Count;
        while (lo < hi) {
            int mid = (lo + hi) / 2;
            if (BTree.Compare(n.entries[mid].key, key) < 0) { lo = mid + 1; } else { hi = mid; }
        }
        return lo;
    }

    /// <summary>key 在叶子中的位置，未找到返回 -1。</summary>
    static int LeafFind(BNode n, string key) {
        int lb = BTree.LowerBound(n, key);
        if (lb < n.entries.Count && BTree.Compare(n.entries[lb].key, key) == 0) { return lb; }
        return -1;
    }

    /// <summary>查找键。找到时返回 true 并把值存入 outVal
    /// （单元素列表）。</summary>
    bool Get(string key, List<string> outVal) {
        Sync();
        int pid = RootId();
        BNode n = ReadNode(pid);
        while (!n.leaf) {
            pid = n.children[BTree.ChildIndex(n, key)];
            n = ReadNode(pid);
        }
        int pos = BTree.LeafFind(n, key);
        if (pos < 0) { return false; }
        outVal.Add(n.entries[pos].val);
        return true;
    }

    bool Contains(string key) {
        List<string> tmp = new List<string>();
        return Get(key, tmp);
    }

    // ===== 插入 =====

    /// <summary>在当前进行中的写入事务里插入或替换 key -> val
    /// （pager 提交后即持久化）。</summary>
    void Put(string key, string val) {
        Sync();
        List<int> path = new List<int>();       // 从根到叶子父节点的页面 id 序列
        List<int> pathIdx = new List<int>();    // 在每个内部节点选取的子节点索引
        int pid = RootId();
        BNode probe = ReadNode(pid);
        while (!probe.leaf) {
            int ci = BTree.ChildIndex(probe, key);
            path.Add(pid);
            pathIdx.Add(ci);
            pid = probe.children[ci];
            probe = ReadNode(pid);
        }

        BNode n = NodeForWrite(pid);
        int ins = BTree.LowerBound(n, key);
        if (ins < n.entries.Count && BTree.Compare(n.entries[ins].key, key) == 0) {
            BLeafEntry existing = n.entries[ins];
            if (existing.overflowPage != 0) {
                FreeChain(existing.overflowPage);
                existing.overflowPage = 0;
            }
            existing.val = val;
        } else {
            BTree.InsEntry(n.entries, ins, new BLeafEntry(key, val, 0));
        }

        if (BTree.EncodedSize(n) <= BTree.PAGE_SIZE) {
            int newLeaf = WriteNodeCow(pid, n);
            if (newLeaf != pid) {
                ReplaceUp(path, pathIdx, path.Count - 1, newLeaf);
            }
            return;
        }

        // 分裂叶子节点。通常左右各保留一半，但对于
        // 单调递增的键（自增 id、时间戳），
        // 50/50 分裂会让每个满叶子永久空一半，因为之后
        // 的插入都落在右兄弟上。当刚写入的键正好是
        // 节点最大值时，只把该条目移到新的右页面，
        // 让左页面几乎保持满——对常见的追加负载，
        // 密度大约翻倍。
        int mid = n.entries.Count / 2;
        if (ins > mid) { mid = ins; }
        BNode right = BNode.Leaf();
        int k = mid;
        while (k < n.entries.Count) {
            right.entries.Add(n.entries[k]);
            k = k + 1;
        }
        while (n.entries.Count > mid) {
            n.entries.RemoveAt(n.entries.Count - 1);
        }
        int rightId = this.pager.AllocPage();
        WriteNode(rightId, right);
        int leftId = WriteNodeCow(pid, n);
        InsertUp(path, pathIdx, path.Count - 1, leftId, right.entries[0].key, rightId);
    }

    /// <summary>重写被复制节点之上的路径，让它指向新页面，
    /// 直到根节点（pager 会重新发布根）。</summary>
    void ReplaceUp(List<int> path, List<int> pathIdx, int level, int newChildId) {
        int child = newChildId;
        int lv = level;
        while (lv >= 0) {
            int ppid = path[lv];
            int ci = pathIdx[lv];
            BNode p = NodeForWrite(ppid);
            p.children[ci] = child;
            int np = WriteNodeCow(ppid, p);
            if (np == ppid) { return; }      // 页面已属于当前事务
            child = np;
            lv = lv - 1;
        }
        this.pager.SetRoot(child);
    }

    /// <summary>向上传播分裂：把（可能被复制的）左子节点、
    /// 分隔键和新的右子节点插入父节点。</summary>
    void InsertUp(List<int> path, List<int> pathIdx, int level,
            int leftId, string sep, int rightId) {
        int curLeft = leftId;
        string curSep = sep;
        int curRight = rightId;
        int lv = level;
        while (lv >= 0) {
            int ppid = path[lv];
            int ci = pathIdx[lv];
            BNode n = NodeForWrite(ppid);
            n.children[ci] = curLeft;
            BTree.InsStr(n.keys, ci, curSep);
            BTree.InsInt(n.children, ci + 1, curRight);
            if (BTree.EncodedSize(n) <= BTree.PAGE_SIZE) {
                int np = WriteNodeCow(ppid, n);
                if (np != ppid) { ReplaceUp(path, pathIdx, lv - 1, np); }
                return;
            }
            // 分裂内部节点：中间键上移。
            int mid = n.keys.Count / 2;
            string upKey = n.keys[mid];
            BNode right = BNode.Internal();
            int k = mid + 1;
            while (k < n.keys.Count) {
                right.keys.Add(n.keys[k]);
                k = k + 1;
            }
            k = mid + 1;
            while (k < n.children.Count) {
                right.children.Add(n.children[k]);
                k = k + 1;
            }
            while (n.keys.Count > mid) {
                n.keys.RemoveAt(n.keys.Count - 1);
            }
            while (n.children.Count > mid + 1) {
                n.children.RemoveAt(n.children.Count - 1);
            }
            int newRightId = this.pager.AllocPage();
            WriteNode(newRightId, right);
            curLeft = WriteNodeCow(ppid, n);
            curSep = upKey;
            curRight = newRightId;
            lv = lv - 1;
        }
        // 根节点分裂：树增加一层。
        BNode newRoot = BNode.Internal();
        newRoot.children.Add(curLeft);
        newRoot.keys.Add(curSep);
        newRoot.children.Add(curRight);
        int newRootId = this.pager.AllocPage();
        WriteNode(newRootId, newRoot);
        this.pager.SetRoot(newRootId);
    }

    // ===== 删除 =====

    /// <summary>删除一个键，存在时返回 true。空叶子节点
    /// 留在原位，由以后压缩回收（暂无合并）。</summary>
    bool Delete(string key) {
        Sync();
        List<int> path = new List<int>();
        List<int> pathIdx = new List<int>();
        int pid = RootId();
        BNode probe = ReadNode(pid);
        while (!probe.leaf) {
            int ci = BTree.ChildIndex(probe, key);
            path.Add(pid);
            pathIdx.Add(ci);
            pid = probe.children[ci];
            probe = ReadNode(pid);
        }
        if (BTree.LeafFind(probe, key) < 0) { return false; }

        BNode n = NodeForWrite(pid);
        int pos = BTree.LeafFind(n, key);
        if (pos < 0) { return false; }
        BLeafEntry entry = n.entries[pos];
        if (entry.overflowPage != 0) { FreeChain(entry.overflowPage); }
        n.entries.RemoveAt(pos);
        int newLeaf = WriteNodeCow(pid, n);
        if (newLeaf != pid) {
            ReplaceUp(path, pathIdx, path.Count - 1, newLeaf);
        }
        return true;
    }

    // ===== 范围删除 =====

    /// <summary>释放一个叶子页面及其引用的 overflow 链，
    /// 不解码其中的值：批量删除不应为读取
    /// 即将丢弃的数据付出代价。</summary>
    void FreeLeafPage(int pageId) {
        ByteBuffer pg = this.pager.GetPage(pageId);
        pg.SeekRead(0);
        int type = pg.ReadU8();
        int nkeys = pg.ReadU16();
        pg.ReadU64();
        if (type == BTree.TYPE_LEAF2) {
            for (int i = 0; i < nkeys; i = i + 1) {
                pg.ReadString();
                if (pg.ReadU8() == 0) {
                    pg.ReadString();
                } else {
                    FreeChain(Pager.PageIdOf(pg.ReadU64()));
                }
            }
        }
        this.nodeCache.Remove(pageId);
        this.pager.FreeLater(pageId);
    }

    /// <summary>删除满足 startKey &lt;= key &lt;= endKey 的所有键
    /// （endKey 为 "" 表示直到末尾），返回删除的数量。
    ///
    /// 这是批量路径：完全落在范围内的叶子页会整页交给
    /// free list——不解码、不重写——沿途每个
    /// 父节点只重写一次，所以删除一批的开销约为
    /// 每层一次页面写入加两个边界叶子，而不是
    /// 每个键重写一次路径。因此同一批的键必须共享一个
    /// 前缀（例如 "kw:&lt;planId&gt;:"），使整批成为单个范围。</summary>
    int DeleteRange(string startKey, string endKey) {
        return DeleteMatching(startKey, endKey, BTree.MATCH_RANGE);
    }

    /// <summary>删除所有以 prefix 开头的键——“丢弃这一批”——
    /// 并返回被删除的键数量。</summary>
    int DeletePrefix(string prefix) {
        return DeleteMatching(prefix, prefix, BTree.MATCH_PREFIX);
    }

    int DeleteMatching(string startKey, string endKey, int mode) {
        Sync();
        List<int> removed = new List<int>();
        removed.Add(0);
        int root = RootId();
        int nr = PruneNode(root, startKey, endKey, mode, removed);
        if (nr == 0) {
            int freshRoot = this.pager.AllocPage();
            WriteNode(freshRoot, BNode.Leaf());
            this.pager.SetRoot(freshRoot);
        } else if (nr != root) {
            this.pager.SetRoot(nr);
        }
        return removed[0];
    }

    static bool InRange(string key, string startKey, string endKey, int mode) {
        if (mode == BTree.MATCH_PREFIX) {
            if (key.Length < startKey.Length) { return false; }
            return key.Substring(0, startKey.Length) == startKey;
        }
        if (BTree.Compare(key, startKey) < 0) { return false; }
        if (endKey.Length == 0) { return true; }
        return BTree.Compare(key, endKey) <= 0;
    }

    /// <summary>删除一个子树内的区间。返回（可能是
    /// 复制后的）页 id；若整个子树都落在区间内则返回 0，且
    /// 其页面进入了空闲列表。</summary>
    int PruneNode(int pageId, string startKey, string endKey, int mode,
            List<int> removed) {
        BNode node = ReadNode(pageId);
        if (node.leaf) {
            int inRange = 0;
            for (int i = 0; i < node.entries.Count; i = i + 1) {
                if (BTree.InRange(node.entries[i].key, startKey, endKey, mode)) {
                    inRange = inRange + 1;
                }
            }
            if (inRange == 0) { return pageId; }
            if (inRange == node.entries.Count) {
                removed[0] = removed[0] + inRange;
                FreeLeafPage(pageId);
                return 0;
            }
            BNode n = NodeForWrite(pageId);
            int j = n.entries.Count - 1;
            while (j >= 0) {
                BLeafEntry entry = n.entries[j];
                if (BTree.InRange(entry.key, startKey, endKey, mode)) {
                    if (entry.overflowPage != 0) { FreeChain(entry.overflowPage); }
                    n.entries.RemoveAt(j);
                    removed[0] = removed[0] + 1;
                }
                j = j - 1;
            }
            return WriteNodeCow(pageId, n);
        }

        int lo = BTree.ChildIndex(node, startKey);
        int hi = node.children.Count - 1;
        if (mode == BTree.MATCH_PREFIX) {
            // 分隔符也是键，因此只要
            // 打开它的分隔符仍以该前缀开头（或小于它），子节点就能持有该前缀。
            hi = lo;
            while (hi + 1 < node.children.Count
                    && BTree.InRange(node.keys[hi], startKey, endKey, mode)) {
                hi = hi + 1;
            }
        } else if (endKey.Length > 0) {
            hi = BTree.ChildIndex(node, endKey);
        }
        if (hi > node.children.Count - 1) { hi = node.children.Count - 1; }

        List<int> results = new List<int>();
        bool changed = false;
        int ci = lo;
        while (ci <= hi) {
            int before = node.children[ci];
            int after = PruneNode(before, startKey, endKey, mode, removed);
            results.Add(after);
            if (after != before) { changed = true; }
            ci = ci + 1;
        }
        if (!changed) { return pageId; }

        // 重建节点，只保留存活的子节点。keys[i] 是
        // children[i] 的下界，因此存活的子节点保留其前面的
        // 分隔符——两个存活子节点之间的内容已全部删除。
        BNode n = NodeForWrite(pageId);
        List<int> keptChildren = new List<int>();
        List<string> keptKeys = new List<string>();
        for (int k = 0; k < n.children.Count; k = k + 1) {
            int child = n.children[k];
            if (k >= lo && k <= hi) { child = results[k - lo]; }
            if (child != 0) {
                if (keptChildren.Count > 0) { keptKeys.Add(n.keys[k - 1]); }
                keptChildren.Add(child);
            }
        }
        n.children = keptChildren;
        n.keys = keptKeys;
        if (n.children.Count == 0) {
            this.nodeCache.Remove(pageId);
            this.pager.FreeLater(pageId);
            return 0;
        }
        return WriteNodeCow(pageId, n);
    }

    // ===== 区间扫描 =====

    /// <summary>收集最多 limit 条满足 startKey &lt;= key &lt;= endKey 的条目
    /// （endKey "" 表示无上限）写入 output。用游标栈遍历树：
    /// 在写时复制下，叶子节点无法保留指向兄弟节点的指针，
    /// 因为在那里插入就必须同时重写左侧邻居。</summary>
    int Scan(string startKey, string endKey, int limit, List<KvEntry> output) {
        Sync();
        List<int> stackIds = new List<int>();
        List<int> stackIdx = new List<int>();
        int pid = RootId();
        BNode n = ReadNode(pid);
        while (!n.leaf) {
            int ci = BTree.ChildIndex(n, startKey);
            stackIds.Add(pid);
            stackIdx.Add(ci);
            pid = n.children[ci];
            n = ReadNode(pid);
        }
        int found = 0;
        int i = BTree.LowerBound(n, startKey);
        while (true) {
            while (i < n.entries.Count) {
                BLeafEntry entry = n.entries[i];
                if (endKey.Length > 0 && BTree.Compare(entry.key, endKey) > 0) {
                    return found;
                }
                output.Add(new KvEntry(entry.key, entry.val));
                found = found + 1;
                if (limit > 0 && found >= limit) { return found; }
                i = i + 1;
            }
            // 下一个叶子：向上爬直到某个父节点还有另一个子节点，然后沿
            // 其最左路径下行。
            bool advanced = false;
            while (stackIds.Count > 0) {
                int lv = stackIds.Count - 1;
                BNode p = ReadNode(stackIds[lv]);
                int ci = stackIdx[lv] + 1;
                if (ci < p.children.Count) {
                    stackIdx[lv] = ci;
                    pid = p.children[ci];
                    n = ReadNode(pid);
                    while (!n.leaf) {
                        stackIds.Add(pid);
                        stackIdx.Add(0);
                        pid = n.children[0];
                        n = ReadNode(pid);
                    }
                    i = 0;
                    advanced = true;
                    break;
                }
                stackIds.RemoveAt(lv);
                stackIdx.RemoveAt(lv);
            }
            if (!advanced) { return found; }
        }
        return found;
    }

    /// <summary>键的总数。遍历整棵树，但只读取每个叶子头部的
    /// 条目计数，因此值永远不会被解码。</summary>
    int Count() {
        Sync();
        return CountNode(RootId());
    }

    int CountNode(int pageId) {
        ByteBuffer pg = this.pager.GetPage(pageId);
        pg.SeekRead(0);
        int type = pg.ReadU8();
        int nkeys = pg.ReadU16();
        if (type != BTree.TYPE_INTERNAL) { return nkeys; }
        BNode n = ReadNode(pageId);
        int total = 0;
        for (int i = 0; i < n.children.Count; i = i + 1) {
            total = total + CountNode(n.children[i]);
        }
        return total;
    }
}
