using System;
using System.IO;
using System.Threading;

namespace System.Data.ZanDb;

/// <summary>
/// Random-access page-granular file used by the ZanDB storage engine.
///
/// All reads and writes are positional (pread/pwrite on POSIX, seek+read on
/// the file descriptor on Windows): they do not depend on a shared file
/// position, so several database handles -- and several processes -- can work
/// on the same file without stepping on each other's offsets. The stdio
/// FILE* is only used to create/open the file portably; no buffered stdio
/// read/write is ever issued, so fd-level IO and fsync see everything.
///
///   PageFile f = PageFile.Open("data.zdb");
///   ByteBuffer page = ByteBuffer.Alloc(4096);
///   f.ReadAt(0, page, 4096);
///   f.WriteAt(4096, page.Raw(), page.Length());
///   f.Sync();
///   f.Close();
/// </summary>
class PageFile {
    /// <summary>How long <see cref="LockExclusive"/> waits for the current
    /// holder before it reports failure.</summary>
    static int LOCK_TIMEOUT_MS = 60000;

    nint fp;
    int fd;
    string path;
    string lastError;

    [DllImport("crt")]
    static extern nint fopen(string path, string mode);

    [DllImport("crt")]
    static extern int fclose(nint fp);

    #if WINDOWS
    [DllImport("crt", EntryPoint = "_fileno")]
    static extern int FileNo(nint fp);

    [DllImport("crt", EntryPoint = "_commit")]
    static extern int SyncFd(int fd);

    [DllImport("crt", EntryPoint = "_lseeki64")]
    static extern long SeekFd(int fd, long offset, int origin);

    [DllImport("crt", EntryPoint = "_read")]
    static extern int ReadFd(int fd, nint buf, int count);

    [DllImport("crt", EntryPoint = "_write")]
    static extern int WriteFd(int fd, nint buf, int count);

    // _locking() locks a byte range starting at the current file position;
    // mode 1 (_LK_LOCK) blocks (retrying for ~10s), 2 (_LK_NBLCK) fails fast,
    // 0 (_LK_UNLCK) releases.
    [DllImport("crt", EntryPoint = "_locking")]
    static extern int LockFd(int fd, int mode, int length);
    #else
    [DllImport("crt", EntryPoint = "fileno")]
    static extern int FileNo(nint fp);

    [DllImport("crt", EntryPoint = "fsync")]
    static extern int SyncFd(int fd);

    [DllImport("crt", EntryPoint = "lseek")]
    static extern long SeekFd(int fd, long offset, int origin);

    [DllImport("crt", EntryPoint = "pread")]
    static extern int PReadFd(int fd, nint buf, int count, long offset);

    [DllImport("crt", EntryPoint = "pwrite")]
    static extern int PWriteFd(int fd, nint buf, int count, long offset);

    // flock(): 2 = LOCK_EX, 8 = LOCK_UN, 4 = LOCK_NB
    [DllImport("crt", EntryPoint = "flock")]
    static extern int FlockFd(int fd, int op);
    #endif

    PageFile() {
        this.fp = 0;
        this.fd = -1;
        this.path = "";
        this.lastError = "";
    }

    /// <summary>Opens (or creates) a file for random read/write access.</summary>
    static PageFile Open(string path) {
        PageFile f = new PageFile();
        f.path = path;
        f.fp = fopen(path, "r+b");
        if (f.fp == 0) {
            f.fp = fopen(path, "w+b");
        }
        if (f.fp == 0) {
            f.lastError = "cannot open " + path;
            return f;
        }
        f.fd = FileNo(f.fp);
        return f;
    }

    bool IsOpen() { return this.fp != 0; }

    string GetError() { return this.lastError; }

    /// <summary>Reads count bytes at offset into buf (cleared first).
    /// Returns the number of bytes actually read.</summary>
    int ReadAt(long offset, ByteBuffer buf, int count) {
        if (this.fp == 0) { return -1; }
        buf.Clear();
        buf.EnsureCapacity(count);
        int n = ReadRaw(offset, buf.Raw(), count);
        if (n < 0) { n = 0; }
        buf.SetLength(n);
        return n;
    }

    /// <summary>Positional read into a raw block.</summary>
    int ReadRaw(long offset, nint raw, int count) {
        if (this.fp == 0) { return -1; }
        #if WINDOWS
        if (SeekFd(this.fd, offset, 0) < 0) {
            this.lastError = "seek failed";
            return -1;
        }
        return ReadFd(this.fd, raw, count);
        #else
        return PReadFd(this.fd, raw, count, offset);
        #endif
    }

    /// <summary>Writes count bytes from a raw block at offset.
    /// Returns bytes written.</summary>
    int WriteAt(long offset, nint raw, int count) {
        if (this.fp == 0) { return -1; }
        #if WINDOWS
        if (SeekFd(this.fd, offset, 0) < 0) {
            this.lastError = "seek failed";
            return -1;
        }
        return WriteFd(this.fd, raw, count);
        #else
        return PWriteFd(this.fd, raw, count, offset);
        #endif
    }

    /// <summary>Appends count bytes at end of file; returns the offset the
    /// data landed at, or -1 on error.</summary>
    long Append(nint raw, int count) {
        if (this.fp == 0) { return -1; }
        long end = Size();
        if (end < 0) { return -1; }
        if (WriteAt(end, raw, count) != count) { return -1; }
        return end;
    }

    /// <summary>Current file size in bytes.</summary>
    long Size() {
        if (this.fp == 0) { return -1; }
        return SeekFd(this.fd, 0, 2);
    }

    /// <summary>Buffered-write flush; positional IO is unbuffered, so this is
    /// only kept for API compatibility.</summary>
    void Flush() { }

    /// <summary>Forces written data to stable storage. Returns true on
    /// success.</summary>
    bool Sync() {
        if (this.fp == 0) { return false; }
        return SyncFd(this.fd) == 0;
    }

    /// <summary>Takes an exclusive whole-file lock, waiting for the current
    /// holder. The lock is released by the operating system if the process
    /// dies, so a crashed writer cannot wedge the database.</summary>
    bool LockExclusive() {
        if (this.fp == 0) { return false; }
        #if WINDOWS
        if (SeekFd(this.fd, 0, 0) < 0) { return false; }
        // _LK_NBLCK in a spin loop rather than _LK_LOCK: _LK_LOCK sleeps a
        // whole second between its own retries, so a writer that commits in
        // milliseconds would hand the lock to a waiter only once per second.
        for (int waited = 0; waited < PageFile.LOCK_TIMEOUT_MS; waited = waited + 1) {
            if (LockFd(this.fd, 2, 1) == 0) { return true; }
            Thread.Sleep(1);
        }
        return false;
        #else
        return FlockFd(this.fd, 2) == 0;
        #endif
    }

    bool Unlock() {
        if (this.fp == 0) { return false; }
        #if WINDOWS
        if (SeekFd(this.fd, 0, 0) < 0) { return false; }
        return LockFd(this.fd, 0, 1) == 0;                     // _LK_UNLCK
        #else
        return FlockFd(this.fd, 8) == 0;
        #endif
    }

    void Close() {
        if (this.fp != 0) {
            fclose(this.fp);
            this.fp = 0;
            this.fd = -1;
        }
    }
}
