using System;
using System.IO;
using System.Threading;

namespace System.Data.ZanDb;

/// <summary>
/// 单个数据库文件的跨进程协调，分三部分：
///
///   * 写入互斥锁——对侧文件（"<db>-lock"）的独占锁。
///     持有者死亡时操作系统会自动释放，因此崩溃的
///     写入者绝不会卡死数据库（共享内存互斥锁则会）；
///   * 最后提交的事务 id，发布在共享内存中，因此
///     读取者可在约 100 纳秒内判断其缓存的页面是否仍然有效，
///     而不必在每次查找时重新从磁盘读取 meta 页；
///   * 读取者表：每个进程发布其当前正在读取的
///     最旧快照，这样写入者就知道哪些已释放的页仍对
///     某些进程可见、尚不能复用（MVCC）。
///
/// 所有内容都通过哈希寻址（SharedTable 的 ByHash API），因此
/// 热路径上不会格式化键，也不会分配字符串。
/// </summary>
class DbRegistry {
    static int MAX_READERS = 512;

    SharedTable table;
    string dbName;
    PageFile lockFile;
    int slot;              // 本进程的读取者槽位，-1 表示没有
    long slotHash;
    long wtxnHash;
    long slotsHash;
    long procsHash;
    int pid;
    bool locked;

    #if WINDOWS
    [DllImport("crt", EntryPoint = "_getpid")]
    static extern int GetPid();

    [DllImport("kernel32", EntryPoint = "OpenProcess")]
    static extern nint OpenProcess(int access, int inherit, int pid);

    [DllImport("kernel32", EntryPoint = "CloseHandle")]
    static extern int CloseHandle(nint handle);
    #else
    [DllImport("crt", EntryPoint = "getpid")]
    static extern int GetPid();

    [DllImport("crt", EntryPoint = "kill")]
    static extern int KillSignal(int pid, int sig);
    #endif

    DbRegistry() {
        this.dbName = "";
        this.slot = -1;
        this.locked = false;
    }

    /// <summary>从数据库路径派生共享内存名称（只取文件名，
    /// 这样打开同一数据库的所有进程都会在同一个
    /// 注册表中相遇）。</summary>
    static string NameOf(string path) {
        string s = path;
        int i = s.Length - 1;
        while (i >= 0) {
            int c = s[i] & 255;
            if (c == 47 || c == 92 || c == 58) { s = s.Substring(i + 1, s.Length - i - 1); break; }
            i = i - 1;
        }
        return "zandb:" + s;
    }

    /// <summary>附加到（首次使用时创建）某个
    /// 数据库文件的注册表。</summary>
    static DbRegistry Attach(string path) {
        DbRegistry r = new DbRegistry();
        r.dbName = DbRegistry.NameOf(path);
        r.pid = GetPid();

        SharedTable t = SharedTable.Open(r.dbName);
        if (!t.IsOpen()) {
            SharedTable fresh = new SharedTable(r.dbName, DbRegistry.MAX_READERS + 16);
            fresh.KeySize(16);
            fresh.ColumnInt("pid");
            fresh.ColumnInt("txn");
            if (fresh.Create()) {
                t = fresh;
            } else {
                // 另一个进程在 Open 和 Create 之间创建了它。
                t = SharedTable.Open(r.dbName);
            }
        }
        r.table = t;
        r.wtxnHash = SharedTable.Hash(r.dbName + "#wtxn");
        r.slotsHash = SharedTable.Hash(r.dbName + "#slots");
        r.procsHash = SharedTable.Hash(r.dbName + "#procs");
        r.lockFile = PageFile.Open(path + "-lock");
        if (r.table.IsOpen()) {
            r.table.IncrementAt(r.procsHash, "pid", 1);
        }
        return r;
    }

    bool IsShared() { return this.table.IsOpen(); }

    /// <summary>当前打开该数据库的进程数。</summary>
    /// 单进程数据库可以完全跳过快照发布。</summary>
    int Processes() {
        if (!this.table.IsOpen()) { return 1; }
        return (int)this.table.GetIntAt(this.procsHash, "pid");
    }

    /// <summary>写入者发布的最后已提交事务 id
    /// （注册表出现后未提交过任何内容时为 0）。</summary>
    long CommittedTxn() {
        if (!this.table.IsOpen()) { return 0; }
        return this.table.GetIntAt(this.wtxnHash, "txn");
    }

    void PublishTxn(long txnid) {
        if (!this.table.IsOpen()) { return; }
        this.table.SetIntAt(this.wtxnHash, "txn", txnid);
    }

    // ===== 写入互斥锁 =====

    /// <summary>阻塞直到本进程获得唯一的写入者槽位。</summary>
    bool LockWrite() {
        if (this.locked) { return true; }
        if (!this.lockFile.IsOpen()) { return true; }
        if (!this.lockFile.LockExclusive()) { return false; }
        this.locked = true;
        return true;
    }

    void UnlockWrite() {
        if (!this.locked) { return; }
        this.lockFile.Unlock();
        this.locked = false;
    }

    // ===== 读取者表 =====

    long HashOfSlot(int index) {
        return SharedTable.Hash(this.dbName + "#r" + Convert.ToString(index));
    }

    bool Alive(int otherPid) {
        if (otherPid == 0) { return false; }
        if (otherPid == this.pid) { return true; }
        #if WINDOWS
        nint h = OpenProcess(1024, 0, otherPid);   // PROCESS_QUERY_LIMITED_INFORMATION
        if (h == 0) { return false; }
        CloseHandle(h);
        return true;
        #else
        return KillSignal(otherPid, 0) == 0;
        #endif
    }

    /// <summary>为本进程认领一个读取者槽位，复用
    /// 已死亡进程的槽位。每个数据库句柄调用一次。</summary>
    void ClaimSlot() {
        if (this.slot >= 0 || !this.table.IsOpen()) { return; }
        long used = this.table.GetIntAt(this.slotsHash, "txn");
        for (int i = 0; i < used; i = i + 1) {
            long h = HashOfSlot(i);
            int owner = (int)this.table.GetIntAt(h, "pid");
            if (!Alive(owner)) {
                this.table.SetIntAt(h, "txn", 0);
                this.table.SetIntAt(h, "pid", this.pid);
                this.slot = i;
                this.slotHash = h;
                return;
            }
        }
        if (used >= DbRegistry.MAX_READERS) { return; }
        int idx = (int)this.table.IncrementAt(this.slotsHash, "txn", 1) - 1;
        if (idx >= DbRegistry.MAX_READERS) { return; }
        this.slot = idx;
        this.slotHash = HashOfSlot(idx);
        this.table.SetIntAt(this.slotHash, "txn", 0);
        this.table.SetIntAt(this.slotHash, "pid", this.pid);
    }

    /// <summary>发布本进程正在读取的快照（0 表示空闲）。
    /// 单个共享内存存储，无需加锁。</summary>
    void PublishSnapshot(long txnid) {
        if (this.slot < 0) { return; }
        this.table.SetIntAt(this.slotHash, "txn", txnid);
    }

    /// <summary>当前存活的进程正在读取的最旧快照；若没有进程
    /// 在读取则返回 0。比它更新的事务释放的页面必须保持
    /// 不动；更旧的页面则可复用。</summary>
    long OldestSnapshot() {
        if (!this.table.IsOpen()) { return 0; }
        long used = this.table.GetIntAt(this.slotsHash, "txn");
        if (used > DbRegistry.MAX_READERS) { used = DbRegistry.MAX_READERS; }
        long oldest = 0;
        for (int i = 0; i < used; i = i + 1) {
            long h = HashOfSlot(i);
            long txn = this.table.GetIntAt(h, "txn");
            if (txn > 0) {
                int owner = (int)this.table.GetIntAt(h, "pid");
                if (Alive(owner)) {
                    if (oldest == 0 || txn < oldest) { oldest = txn; }
                } else {
                    this.table.SetIntAt(h, "txn", 0);
                }
            }
        }
        return oldest;
    }

    void Close() {
        UnlockWrite();
        if (this.slot >= 0 && this.table.IsOpen()) {
            this.table.SetIntAt(this.slotHash, "txn", 0);
            this.table.SetIntAt(this.slotHash, "pid", 0);
            this.slot = -1;
        }
        if (this.table.IsOpen()) {
            this.table.IncrementAt(this.procsHash, "pid", -1);
            this.table.Close();
        }
        this.lockFile.Close();
    }
}
