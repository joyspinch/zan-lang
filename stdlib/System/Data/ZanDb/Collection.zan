using System;
using System.IO;
using System.Json;
using System.Text;
using System.Threading;

namespace System.Data.ZanDb;

/// <summary>
/// A named set of documents inside a <see cref="ZanDatabase"/>. Documents are
/// JsonValue object trees; each gets an auto-incrementing integer _id.
/// Storage keys are namespaced in the shared B+Tree:
///   c:{name}:{id}                    document body (key-dict encoded JSON)
///   m:{name}:keys                    field-name dictionary (JSON array)
///   m:{name}:seq                     last assigned id
///   m:{name}:idx                     comma list of indexed fields
///   m:{name}:idxpos:{field}          batch index build cursor (absent = built)
///   i:{name}:{field}:{value}\t{id}   secondary index entry -> id
/// Ids are zero-padded so B+Tree order == insertion order, making FindAll
/// and range iteration sequential page reads.
/// </summary>
class Collection {
    KvStore kv;
    AsyncRwLock rw;
    string name;
    List<string> indexedFields;
    List<string> keyDict;
    bool keyDictDirty;
    int metaVersion;

    /// <summary>Documents indexed per transaction by the batch index build.</summary>
    static int INDEX_BATCH = 500;

    // Records are escaped to keep 0x00 out of them (see EncodeDoc); the escape
    // byte is 0xFF and almost never appears, so the read path asks memchr --
    // one vectorized pass in C -- whether unescaping is needed at all instead
    // of copying every record through a second buffer byte by byte.
    [DllImport("crt", EntryPoint = "memchr")]
    static extern nint MemChr(nint p, int c, int n);

    Collection() {
        this.name = "";
        this.indexedFields = new List<string>();
        this.keyDict = new List<string>();
        this.keyDictDirty = false;
        this.metaVersion = 0 - 1;
    }

    static Collection Attach(KvStore kv, AsyncRwLock rw, string name) {
        Collection c = new Collection();
        c.kv = kv;
        c.rw = rw;
        c.name = name;
        c.LoadIndexMeta();
        c.LoadKeyDict();
        c.metaVersion = kv.Version();
        return c;
    }

    /// <summary>Re-reads the cached metadata (field-name dictionary, index
    /// list) when the database moved to a newer version, i.e. when another
    /// process committed. Both are needed before touching documents: the
    /// dictionary decodes and encodes object keys, so a stale copy would
    /// decode a peer's document with the wrong field names and reuse its ids
    /// for different names. Cheap: one version compare, and two reads only
    /// when something actually changed.</summary>
    void SyncMeta() {
        int v = this.kv.Version();
        if (v == this.metaVersion) { return; }
        // Never reload on top of dictionary entries that are not on disk yet
        // (mid-encode inside a transaction) -- they would be lost.
        if (this.keyDictDirty) { return; }
        this.metaVersion = v;
        LoadIndexMeta();
        LoadKeyDict();
    }

    string Name() { return this.name; }

    // Ids appear in every document key and every index entry, so their text
    // form is a large part of the file. They are written as six base-64 digits
    // over the printable alphabet '?'..'~' (0x3F..0x7E): byte order still
    // equals numeric order, so B+Tree order remains insertion order, the
    // alphabet contains neither 0x00 nor the ':' and tab that delimit keys, and
    // six digits still cover 64^6 = 68 billion ids -- half the width of the
    // twelve decimal digits used before.
    static int ID_DIGITS = 6;

    static string PadId(int id) {
        ByteBuffer b = ByteBuffer.Alloc(Collection.ID_DIGITS);
        int shift = (Collection.ID_DIGITS - 1) * 6;
        while (shift >= 0) {
            b.WriteU8(63 + ((id >> shift) & 63));
            shift = shift - 6;
        }
        string s = b.ToStr();
        b.Free();
        return s;
    }

    /// <summary>Inverse of PadId.</summary>
    static int UnpadId(string s) {
        int v = 0;
        int i = 0;
        while (i < s.Length) {
            v = (v << 6) | ((s[i] & 255) - 63);
            i = i + 1;
        }
        return v;
    }

    string DocKey(int id) {
        return "c:" + this.name + ":" + Collection.PadId(id);
    }

    string SeqKey() {
        return "m:" + this.name + ":seq";
    }

    string IdxMetaKey() {
        return "m:" + this.name + ":idx";
    }

    string KeysMetaKey() {
        return "m:" + this.name + ":keys";
    }

    string IdxPosKey(string field) {
        return "m:" + this.name + ":idxpos:" + field;
    }

    /// <summary>Prefix shared by every entry of one indexed field. The field
    /// is named by its dictionary id rather than spelled out, so a long field
    /// name costs nothing per entry.</summary>
    string IdxPrefix(string field, string val) {
        return "i:" + this.name + ":" + Collection.PadId(KeyIdOf(field)) + ":"
               + val + "\t";
    }

    string IdxKey(string field, string val, int id) {
        return IdxPrefix(field, val) + Collection.PadId(id);
    }

    void LoadIndexMeta() {
        this.indexedFields = new List<string>();
        string meta = this.kv.Get(IdxMetaKey());
        if (meta.Length == 0) { return; }
        int start = 0;
        int i = 0;
        while (i <= meta.Length) {
            if (i == meta.Length || (meta[i] & 255) == 44) {
                if (i > start) { this.indexedFields.Add(meta.Substring(start, i - start)); }
                start = i + 1;
            }
            i = i + 1;
        }
    }

    // ===== Field-name dictionary =====
    //
    // Object keys repeat in every document, so storing them verbatim wastes
    // space proportional to collection size. Each collection keeps a
    // persistent field-name dictionary; on disk object keys are 1-based
    // dictionary ids, and document bodies are a compact binary record with
    // typed varint-encoded values (not JSON text) -- see EncodeDoc/DecodeDoc.

    void LoadKeyDict() {
        this.keyDict = new List<string>();
        this.keyDictDirty = false;
        string meta = this.kv.Get(KeysMetaKey());
        if (meta.Length == 0) { return; }
        JsonValue arr = JsonValue.ParseLenient(meta);
        int i = 0;
        while (i < arr.Count()) {
            this.keyDict.Add(arr.At(i).AsString(""));
            i = i + 1;
        }
    }

    int KeyId(string k) {
        int i = 0;
        while (i < this.keyDict.Count) {
            if (this.keyDict[i] == k) { return i + 1; }
            i = i + 1;
        }
        this.keyDict.Add(k);
        this.keyDictDirty = true;
        return this.keyDict.Count;
    }

    /// <summary>Dictionary id of a field name, or 0 when this collection has
    /// never stored that field. Unlike KeyId this never grows the dictionary,
    /// so it is safe on the read path.</summary>
    int KeyIdOf(string k) {
        int i = 0;
        while (i < this.keyDict.Count) {
            if (this.keyDict[i] == k) { return i + 1; }
            i = i + 1;
        }
        return 0;
    }

    string KeyName(int id) {
        if (id >= 1 && id <= this.keyDict.Count) { return this.keyDict[id - 1]; }
        return "?" + Convert.ToString(id);
    }

    void PersistKeyDict() {
        if (!this.keyDictDirty) { return; }
        JsonValue arr = JsonValue.NewArray();
        int i = 0;
        while (i < this.keyDict.Count) {
            arr.Append(JsonValue.NewStr(this.keyDict[i]));
            i = i + 1;
        }
        this.kv.Put(KeysMetaKey(), arr.ToJson());
        this.keyDictDirty = false;
    }

    // Binary record value tags: 0 null, 1 false, 2 true, 3 non-negative int
    // (varint), 8 negative int (varint of the magnitude), 9 integer zero (no
    // payload), 4 number-as-text (non-integer), 5 string, 10 empty string (no
    // payload), 6 array, 7 object. Tags 9/10 give SQLite-style "value in the
    // type" for the two overwhelmingly common cells (0 and "") -- they also
    // keep 0x00 out of the record so the NUL escaping below almost never fires.
    static bool IsIntStr(string s) {
        int n = s.Length;
        if (n == 0) { return false; }
        int i = 0;
        if ((s[0] & 255) == 45) { i = 1; if (n == 1) { return false; } }
        if (n - i > 18) { return false; }   // keep within zigzag varint range
        while (i < n) {
            int c = s[i] & 255;
            if (c < 48 || c > 57) { return false; }
            i = i + 1;
        }
        return true;
    }

    // Parses a signed base-10 integer. Used instead of Convert.ToInt, which
    // currently lowers to C atoi (declared with an i64 return) and so fails to
    // sign-extend -- negatives and values > 2^31 come back as zero-extended
    // garbage.
    static int ParseI64(string s) {
        int n = s.Length;
        int i = 0;
        bool neg = false;
        if (n > 0 && (s[0] & 255) == 45) { neg = true; i = 1; }   // '-'
        int acc = 0;
        while (i < n) {
            int c = s[i] & 255;
            if (c < 48 || c > 57) { break; }
            acc = acc * 10 + (c - 48);
            i = i + 1;
        }
        if (neg) { return 0 - acc; }
        return acc;
    }

    void WriteVal(ByteBuffer b, JsonValue v) {
        if (v.IsNull()) { b.WriteU8(0); return; }
        if (v.IsBool()) {
            if (v.AsBool(false)) { b.WriteU8(2); } else { b.WriteU8(1); }
            return;
        }
        if (v.IsNumber()) {
            string raw = v.AsString("");
            if (Collection.IsIntStr(raw)) {
                int iv = Collection.ParseI64(raw);
                if (iv == 0) { b.WriteU8(9); }
                else if (iv < 0) { b.WriteU8(8); b.WriteVarInt(0 - iv); }
                else { b.WriteU8(3); b.WriteVarInt(iv); }
            } else {
                b.WriteU8(4);
                b.WriteString(raw);
            }
            return;
        }
        if (v.IsString()) {
            string sv = v.AsString("");
            if (sv.Length == 0) { b.WriteU8(10); }
            else { b.WriteU8(5); b.WriteString(sv); }
            return;
        }
        if (v.IsArray()) {
            b.WriteU8(6);
            b.WriteVarInt(v.Count());
            int i = 0;
            while (i < v.Count()) { WriteVal(b, v.At(i)); i = i + 1; }
            return;
        }
        b.WriteU8(7);
        b.WriteVarInt(v.Count());
        int i = 0;
        while (i < v.Count()) {
            b.WriteVarInt(KeyId(v.KeyAt(i)));
            WriteVal(b, v.ValAt(i));
            i = i + 1;
        }
    }

    /// <summary>Serializes a document into a compact binary record: a 'B'
    /// format byte, then the top-level object's fields (dictionary-id key +
    /// typed value). The redundant "_id" is omitted -- it is the row key and is
    /// re-attached on read. Must run inside a kv transaction: new field names
    /// are persisted alongside the body.</summary>
    string EncodeDoc(JsonValue doc) {
        ByteBuffer b = ByteBuffer.Alloc(64);
        b.WriteU8(66);   // 'B'
        int n = 0;
        int i = 0;
        while (i < doc.Count()) {
            if (doc.KeyAt(i) != "_id") { n = n + 1; }
            i = i + 1;
        }
        b.WriteVarInt(n);
        i = 0;
        while (i < doc.Count()) {
            string k = doc.KeyAt(i);
            if (k != "_id") {
                b.WriteVarInt(KeyId(k));
                WriteVal(b, doc.ValAt(i));
            }
            i = i + 1;
        }
        PersistKeyDict();
        // Escape to a NUL-free byte stream. The runtime string type (and
        // NativeMemory.GetString, used by both ToStr and the B+Tree's own
        // ReadString) stops at the first 0x00, so a raw record -- which
        // routinely contains 0x00 bytes (e.g. the integer 0, an empty string,
        // a zero count) -- cannot survive a string round-trip. 0xFF is the
        // escape: 0x00 -> FF 01, 0xFF -> FF 02; all other bytes pass through.
        ByteBuffer e = ByteBuffer.Alloc(b.Length() + 8);
        b.SeekRead(0);
        while (b.Remaining() > 0) {
            int by = b.ReadU8();
            if (by == 0) { e.WriteU8(255); e.WriteU8(1); }
            else if (by == 255) { e.WriteU8(255); e.WriteU8(2); }
            else { e.WriteU8(by); }
        }
        string s = e.ToStr();
        b.Free();
        e.Free();
        return s;
    }

    JsonValue ReadVal(ByteBuffer b) {
        int tag = b.ReadU8();
        if (tag == 0) { return JsonValue.NewNull(); }
        if (tag == 1) { return JsonValue.NewBool(false); }
        if (tag == 2) { return JsonValue.NewBool(true); }
        if (tag == 3) { return JsonValue.NewNum(Convert.ToString(b.ReadVarInt())); }
        if (tag == 8) { return JsonValue.NewNum(Convert.ToString(0 - b.ReadVarInt())); }
        if (tag == 9) { return JsonValue.NewNum("0"); }
        if (tag == 4) { return JsonValue.NewNum(b.ReadString()); }
        if (tag == 5) { return JsonValue.NewStr(b.ReadString()); }
        if (tag == 10) { return JsonValue.NewStr(""); }
        if (tag == 6) {
            JsonValue a = JsonValue.NewArray();
            int c = b.ReadVarInt();
            int i = 0;
            while (i < c) { a.Append(ReadVal(b)); i = i + 1; }
            return a;
        }
        JsonValue o = JsonValue.NewObject();
        int c = b.ReadVarInt();
        int i = 0;
        while (i < c) {
            int kid = b.ReadVarInt();
            o.Set(KeyName(kid), ReadVal(b));
            i = i + 1;
        }
        return o;
    }

    /// <summary>Id encoded in the trailing digits of a key. Both row keys and
    /// index entries end with a fixed-width id, so no delimiter is searched
    /// for -- an id digit may legitimately look like one.</summary>
    static int IdOfKey(string key) {
        int off = key.Length - Collection.ID_DIGITS;
        if (off < 0) { return 0; }
        return Collection.UnpadId(key.Substring(off, Collection.ID_DIGITS));
    }

    static string IdFromKey(string key) {
        return Convert.ToString(Collection.IdOfKey(key));
    }

    /// <summary>Decodes a binary record body (see EncodeDoc) back into a
    /// JsonValue object. "_id" is not stored in the body; callers attach it
    /// from the row key.</summary>
    /// <summary>Wraps a stored record for reading, undoing the escaping only
    /// when the record actually contains an escape byte. Records written by
    /// EncodeDoc rarely do (tags 9 and 10 keep 0x00 out of the common cells),
    /// so the usual case is one buffer and no byte-by-byte copy.</summary>
    ByteBuffer OpenRecord(string body) {
        ByteBuffer e = ByteBuffer.FromStr(body);
        if (Collection.MemChr(e.Raw(), 255, e.Length()) == 0) {
            e.SeekRead(0);
            return e;
        }
        ByteBuffer b = ByteBuffer.Alloc(e.Length() + 4);
        e.SeekRead(0);
        while (e.Remaining() > 0) {
            int by = e.ReadU8();
            if (by == 255) {
                int nx = e.ReadU8();
                if (nx == 1) { b.WriteU8(0); } else { b.WriteU8(255); }
            } else {
                b.WriteU8(by);
            }
        }
        e.Free();
        b.SeekRead(0);
        return b;
    }

    /// <summary>Steps over one encoded value without building anything from
    /// it. Strings and numbers-as-text are skipped by length rather than
    /// copied.</summary>
    void SkipVal(ByteBuffer b) {
        int tag = b.ReadU8();
        if (tag == 3 || tag == 8) { b.ReadVarInt(); return; }
        if (tag == 4 || tag == 5) {
            int len = b.ReadVarInt();
            b.SeekRead(b.ReadPos() + len);
            return;
        }
        if (tag == 6) {
            int c = b.ReadVarInt();
            int i = 0;
            while (i < c) { SkipVal(b); i = i + 1; }
            return;
        }
        if (tag == 7) {
            int c = b.ReadVarInt();
            int i = 0;
            while (i < c) { b.ReadVarInt(); SkipVal(b); i = i + 1; }
            return;
        }
        // tags 0, 1, 2, 9, 10 carry no payload.
    }

    /// <summary>One field straight out of a stored record: the other fields are
    /// stepped over instead of being decoded, so a filter over a large
    /// collection does not build a JsonValue tree per document. Returns null
    /// when the record has no such field.</summary>
    JsonValue FieldOf(string body, int kid) {
        if (kid == 0) { return null; }
        ByteBuffer b = OpenRecord(body);
        b.ReadU8();                     // 'B'
        int n = b.ReadVarInt();
        JsonValue found = null;
        int i = 0;
        while (i < n) {
            int k = b.ReadVarInt();
            if (k == kid) {
                found = ReadVal(b);
                i = n;
            } else {
                SkipVal(b);
                i = i + 1;
            }
        }
        b.Free();
        return found;
    }

    JsonValue DecodeDoc(string body) {
        ByteBuffer b = OpenRecord(body);
        int fmt = b.ReadU8();   // 'B' = 66
        JsonValue o = JsonValue.NewObject();
        int n = b.ReadVarInt();
        int i = 0;
        while (i < n) {
            int kid = b.ReadVarInt();
            JsonValue v = ReadVal(b);
            o.Set(KeyName(kid), v);
            i = i + 1;
        }
        b.Free();
        return o;
    }

    void AddIndexEntries(int id, JsonValue doc) {
        int i = 0;
        while (i < this.indexedFields.Count) {
            string f = this.indexedFields[i];
            if (doc.Has(f)) {
                this.kv.Put(IdxKey(f, doc.Get(f).AsString(""), id), "");
            }
            i = i + 1;
        }
    }

    void RemoveIndexEntries(int id, JsonValue doc) {
        if (doc == null) { return; }
        int i = 0;
        while (i < this.indexedFields.Count) {
            string f = this.indexedFields[i];
            if (doc.Has(f)) {
                this.kv.Delete(IdxKey(f, doc.Get(f).AsString(""), id));
            }
            i = i + 1;
        }
    }

    int NextId() {
        string cur = this.kv.Get(SeqKey());
        int id = 1;
        if (cur.Length > 0) { id = Convert.ToInt(cur) + 1; }
        this.kv.Put(SeqKey(), Convert.ToString(id));
        return id;
    }

    // ===== CRUD =====

    /// <summary>Stores a new document, assigning and returning its _id
    /// (also written into the document).</summary>
    int Insert(JsonValue doc) {
        this.kv.Begin();
        SyncMeta();
        int id = NextId();
        doc.Set("_id", JsonValue.NewNum(Convert.ToString(id)));
        this.kv.Put(DocKey(id), EncodeDoc(doc));
        AddIndexEntries(id, doc);
        this.kv.Commit();
        return id;
    }

    /// <summary>Bulk insert in one atomic commit (one WAL flush for the whole
    /// batch). Returns the first assigned id.</summary>
    int InsertBulk(List<JsonValue> docs) {
        this.kv.Begin();
        SyncMeta();
        int first = 0;
        int i = 0;
        while (i < docs.Count) {
            int id = NextId();
            if (first == 0) { first = id; }
            docs[i].Set("_id", JsonValue.NewNum(Convert.ToString(id)));
            this.kv.Put(DocKey(id), EncodeDoc(docs[i]));
            AddIndexEntries(id, docs[i]);
            i = i + 1;
        }
        this.kv.Commit();
        return first;
    }

    /// <summary>Returns the document, or null when absent.</summary>
    JsonValue FindById(int id) {
        this.kv.BeginSnapshot();
        SyncMeta();
        string body = this.kv.Get(DocKey(id));
        JsonValue doc = null;
        if (body.Length > 0) {
            doc = DecodeDoc(body);
            doc.Set("_id", JsonValue.NewNum(Convert.ToString(id)));
        }
        this.kv.EndSnapshot();
        return doc;
    }

    bool Exists(int id) { return this.kv.Contains(DocKey(id)); }

    /// <summary>Replaces an existing document; false when the id is absent.</summary>
    bool Update(int id, JsonValue doc) {
        if (!this.kv.Contains(DocKey(id))) { return false; }
        this.kv.Begin();
        SyncMeta();
        if (this.indexedFields.Count > 0) { RemoveIndexEntries(id, FindById(id)); }
        doc.Set("_id", JsonValue.NewNum(Convert.ToString(id)));
        this.kv.Put(DocKey(id), EncodeDoc(doc));
        AddIndexEntries(id, doc);
        this.kv.Commit();
        return true;
    }

    /// <summary>Insert-or-replace under an explicit id. Advances the auto-id
    /// sequence past id so later inserts cannot collide.</summary>
    void Upsert(int id, JsonValue doc) {
        this.kv.Begin();
        SyncMeta();
        string cur = this.kv.Get(SeqKey());
        int seq = 0;
        if (cur.Length > 0) { seq = Convert.ToInt(cur); }
        if (id > seq) { this.kv.Put(SeqKey(), Convert.ToString(id)); }
        if (this.indexedFields.Count > 0 && this.kv.Contains(DocKey(id))) {
            RemoveIndexEntries(id, FindById(id));
        }
        doc.Set("_id", JsonValue.NewNum(Convert.ToString(id)));
        this.kv.Put(DocKey(id), EncodeDoc(doc));
        AddIndexEntries(id, doc);
        this.kv.Commit();
    }

    bool DeleteById(int id) {
        this.kv.Begin();
        SyncMeta();
        if (this.indexedFields.Count > 0) { RemoveIndexEntries(id, FindById(id)); }
        bool existed = this.kv.Delete(DocKey(id));
        this.kv.Commit();
        return existed;
    }

    // ===== Secondary indexes =====

    void PersistIndexMeta() {
        string meta = "";
        int i = 0;
        while (i < this.indexedFields.Count) {
            if (i > 0) { meta = meta + ","; }
            meta = meta + this.indexedFields[i];
            i = i + 1;
        }
        this.kv.Put(IdxMetaKey(), meta);
    }

    /// <summary>Creates (or rebuilds) a secondary index on a field, indexing
    /// existing documents in bounded batches. Maintained automatically by
    /// later writes. Resumes an interrupted build instead of restarting
    /// it.</summary>
    void EnsureIndex(string field) {
        EnsureIndex(field, Collection.INDEX_BATCH);
    }

    /// <summary>EnsureIndex with an explicit batch size (documents per
    /// transaction).</summary>
    void EnsureIndex(string field, int batchSize) {
        bool done = false;
        while (!done) { done = BuildIndexStep(field, batchSize); }
    }

    /// <summary>Indexes the next batch of documents, one transaction per call,
    /// and returns true once the whole collection is covered.
    ///
    /// Building an index over a large collection in a single transaction pins
    /// every touched page until the commit and holds the cross-process writer
    /// lock for the whole build; batching bounds both. The cursor
    /// (m:{name}:idxpos:{field}) is part of the same commit as the entries it
    /// covers, so a crash or a kill mid-build loses nothing and the next call
    /// picks up where the last commit left off.
    ///
    /// The field joins the index list in the first batch, so concurrent writers
    /// (including other processes) already maintain entries for documents the
    /// build has not reached; those writes and the build agree because both
    /// derive the entry from the same document. Until the build finishes,
    /// IndexReady is false and FindByIndex falls back to a scan, so a partial
    /// index never yields partial results.</summary>
    bool BuildIndexStep(string field, int batchSize) {
        if (batchSize <= 0) { batchSize = Collection.INDEX_BATCH; }
        this.kv.Begin();
        SyncMeta();
        if (!HasIndex(field)) {
            this.indexedFields.Add(field);
            PersistIndexMeta();
        }
        int from = 0;
        string cursor = this.kv.Get(IdxPosKey(field));
        if (cursor.Length > 0) { from = Collection.ParseI64(cursor) + 1; }
        // Only the indexed field is read out of each record: building an index
        // never needs the rest of the document.
        List<string> ks = new List<string>();
        List<string> vs = new List<string>();
        this.kv.Scan(DocKey(from), "c:" + this.name + ";", batchSize, ks, vs);
        int kid = KeyIdOf(field);
        int last = from;
        int i = 0;
        while (i < vs.Count) {
            int id = Collection.IdOfKey(ks[i]);
            JsonValue f = FieldOf(vs[i], kid);
            if (f != null) {
                this.kv.Put(IdxKey(field, f.AsString(""), id), "");
            }
            if (id > last) { last = id; }
            i = i + 1;
        }
        bool done = vs.Count < batchSize;
        if (done) { this.kv.Delete(IdxPosKey(field)); }
        else { this.kv.Put(IdxPosKey(field), Convert.ToString(last)); }
        this.kv.Commit();
        return done;
    }

    bool HasIndex(string field) {
        int i = 0;
        while (i < this.indexedFields.Count) {
            if (this.indexedFields[i] == field) { return true; }
            i = i + 1;
        }
        return false;
    }

    /// <summary>True when the field is indexed and its batch build has
    /// finished, i.e. when the index covers every document.</summary>
    bool IndexReady(string field) {
        this.kv.BeginSnapshot();
        SyncMeta();
        bool ready = HasIndex(field) && !this.kv.Contains(IdxPosKey(field));
        this.kv.EndSnapshot();
        return ready;
    }

    /// <summary>Index lookup: documents whose field equals val (string form),
    /// via the secondary index -- no full scan. Falls back to a scan while an
    /// index build is still running, so the answer is always complete.</summary>
    List<JsonValue> FindByIndex(string field, string val) {
        this.kv.BeginSnapshot();
        SyncMeta();
        List<JsonValue> docs = new List<JsonValue>();
        if (HasIndex(field) && !this.kv.Contains(IdxPosKey(field))) {
            List<string> ks = new List<string>();
            List<string> vs = new List<string>();
            this.kv.ScanPrefix(IdxPrefix(field, val), 0, ks, vs);
            int i = 0;
            while (i < ks.Count) {
                JsonValue d = FindById(Collection.IdOfKey(ks[i]));
                if (d != null) { docs.Add(d); }
                i = i + 1;
            }
            this.kv.EndSnapshot();
            return docs;
        }
        this.kv.EndSnapshot();
        return FindByFieldScan(field, val);
    }

    /// <summary>Documents whose field equals val, found by scanning: every
    /// record is asked for that one field, and only the matches are decoded in
    /// full. Used when the field has no usable index.</summary>
    List<JsonValue> FindByFieldScan(string field, string val) {
        this.kv.BeginSnapshot();
        SyncMeta();
        List<JsonValue> docs = new List<JsonValue>();
        int kid = KeyIdOf(field);
        if (kid == 0) {
            this.kv.EndSnapshot();
            return docs;
        }
        List<string> ks = new List<string>();
        List<string> vs = new List<string>();
        this.kv.Scan(DocKey(0), "c:" + this.name + ";", 0, ks, vs);
        int i = 0;
        while (i < vs.Count) {
            JsonValue f = FieldOf(vs[i], kid);
            if (f != null && f.AsString("") == val) {
                JsonValue doc = DecodeDoc(vs[i]);
                doc.Set("_id", JsonValue.NewNum(Collection.IdFromKey(ks[i])));
                docs.Add(doc);
            }
            i = i + 1;
        }
        this.kv.EndSnapshot();
        return docs;
    }

    /// <summary>How many documents have field == val, without materializing
    /// any of them.</summary>
    int CountByField(string field, string val) {
        this.kv.BeginSnapshot();
        SyncMeta();
        int n = 0;
        if (HasIndex(field) && !this.kv.Contains(IdxPosKey(field))) {
            // A ready index answers from its keys alone: no document is read.
            List<string> ks = new List<string>();
            List<string> vs = new List<string>();
            n = this.kv.ScanPrefix(IdxPrefix(field, val), 0, ks, vs);
            this.kv.EndSnapshot();
            return n;
        }
        int kid = KeyIdOf(field);
        if (kid == 0) {
            this.kv.EndSnapshot();
            return 0;
        }
        List<string> ks2 = new List<string>();
        List<string> vs2 = new List<string>();
        this.kv.Scan(DocKey(0), "c:" + this.name + ";", 0, ks2, vs2);
        int i = 0;
        while (i < vs2.Count) {
            JsonValue f = FieldOf(vs2[i], kid);
            if (f != null && f.AsString("") == val) { n = n + 1; }
            i = i + 1;
        }
        this.kv.EndSnapshot();
        return n;
    }

    /// <summary>Number of documents (range scan over the namespace).</summary>
    int Count() {
        List<string> ks = new List<string>();
        List<string> vs = new List<string>();
        return this.kv.ScanPrefix("c:" + this.name + ":", 0, ks, vs);
    }

    /// <summary>All documents in id order.</summary>
    List<JsonValue> FindAll() {
        return FindRange(0, 0, 0);
    }

    /// <summary>Documents with fromId <= _id <= toId (0 = unbounded),
    /// limit 0 = unlimited, in id order.</summary>
    List<JsonValue> FindRange(int fromId, int toId, int limit) {
        this.kv.BeginSnapshot();
        SyncMeta();
        string lo = DocKey(fromId);
        string hi = "";
        if (toId > 0) { hi = DocKey(toId); }
        else { hi = "c:" + this.name + ";"; }   // ';' sorts just after ':'
        List<string> ks = new List<string>();
        List<string> vs = new List<string>();
        this.kv.Scan(lo, hi, limit, ks, vs);
        List<JsonValue> docs = new List<JsonValue>();
        int i = 0;
        while (i < vs.Count) {
            if (ks[i].Length > 2 && ks[i].Substring(0, 2) == "c:") {
                JsonValue doc = DecodeDoc(vs[i]);
                doc.Set("_id", JsonValue.NewNum(Collection.IdFromKey(ks[i])));
                docs.Add(doc);
            }
            i = i + 1;
        }
        this.kv.EndSnapshot();
        return docs;
    }

    /// <summary>Starts a fluent LINQ-style query over this collection.</summary>
    DocQuery Query() {
        return DocQuery.Of(this);
    }

    // ===== Coroutine-safe async API =====

    async JsonValue FindByIdAsync(int id) {
        await this.rw.EnterRead();
        JsonValue v = FindById(id);
        this.rw.ExitRead();
        return v;
    }

    async int InsertAsync(JsonValue doc) {
        await this.rw.EnterWrite();
        int id = Insert(doc);
        this.rw.ExitWrite();
        return id;
    }

    async bool UpdateAsync(int id, JsonValue doc) {
        await this.rw.EnterWrite();
        bool ok = Update(id, doc);
        this.rw.ExitWrite();
        return ok;
    }

    async bool DeleteByIdAsync(int id) {
        await this.rw.EnterWrite();
        bool ok = DeleteById(id);
        this.rw.ExitWrite();
        return ok;
    }

    /// <summary>Atomic read-modify-write on one document: fn runs inside the
    /// write critical section against the latest committed version, so
    /// concurrent updates never lose writes (the decision and the write are
    /// one atomic step). Returns true when the document existed and fn
    /// returned a replacement.</summary>
    async bool UpdateAtomic(int id, DocUpdater fn) {
        await this.rw.EnterWrite();
        JsonValue cur = FindById(id);
        if (cur == null) {
            this.rw.ExitWrite();
            return false;
        }
        JsonValue next = fn(cur);
        bool ok = false;
        if (next != null) {
            ok = Update(id, next);
        }
        this.rw.ExitWrite();
        return ok;
    }
}
