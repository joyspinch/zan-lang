using System;
using System.IO;

namespace System.Data.ZanDb;

/// <summary>小型开放寻址页 id 集合：写入者触及的每个节点都要
/// 回答“该页是否由当前运行中的事务分配？”这个问题，
/// 因此不能是线性扫描。</summary>
class PageIdSet {
    int slots;
    int count;
    List<int> keys;   // pageId + 1，0 表示空

    PageIdSet() {
        this.slots = 256;
        this.count = 0;
        this.keys = new List<int>();
        for (int i = 0; i < this.slots; i = i + 1) { this.keys.Add(0); }
    }

    int Count() { return this.count; }

    int SlotOf(int pageId) {
        int mask = this.slots - 1;
        int h = (pageId * 2654435761) & mask;
        if (h < 0) { h = -h & mask; }
        while (true) {
            int k = this.keys[h];
            if (k == 0) { return -(h + 1); }
            if (k == pageId + 1) { return h; }
            h = (h + 1) & mask;
        }
        return 0;
    }

    bool Has(int pageId) { return SlotOf(pageId) >= 0; }

    void Grow() {
        List<int> old = this.keys;
        int oldSlots = this.slots;
        this.slots = oldSlots * 2;
        this.keys = new List<int>();
        int i = 0;
        for (; i < this.slots; i = i + 1) { this.keys.Add(0); }
        this.count = 0;
        i = 0;
        while (i < oldSlots) {
            if (old[i] != 0) { Add(old[i] - 1); }
            i = i + 1;
        }
    }

    void Add(int pageId) {
        if (this.count * 2 >= this.slots) { Grow(); }
        int s = SlotOf(pageId);
        if (s >= 0) { return; }
        this.keys[-s - 1] = pageId + 1;
        this.count = this.count + 1;
    }

    void Clear() {
        for (int i = 0; i < this.slots; i = i + 1) { this.keys[i] = 0; }
        this.count = 0;
    }
}

/// <summary>
/// 固定容量的 LRU 缓存，映射 page id -> ByteBuffer。开放寻址
/// 哈希表，带侵入式双向链表维护 LRU 顺序。
/// 运行中事务写入的页会被钉住（不驱逐），直到提交。
/// </summary>
class PageCache {
    int capacity;      // 常驻页数上限
    int slots;         // 哈希槽位数（2 的幂，> capacity）
    List<int> keys;    // pageId + 1；0 为空，-1 为墓碑
    List<ByteBuffer> vals;
    List<bool> pinned;
    List<int> lruPrev; // 槽位索引链接，-1 表示无
    List<int> lruNext;
    int lruHead;       // 最近使用的槽位
    int lruTail;       // 最久未使用的槽位
    int count;

    PageCache(int cap) {
        this.capacity = cap;
        int s = 16;
        while (s < cap * 2) { s = s * 2; }
        this.slots = s;
        this.keys = new List<int>();
        this.vals = new List<ByteBuffer>();
        this.pinned = new List<bool>();
        this.lruPrev = new List<int>();
        this.lruNext = new List<int>();
        for (int i = 0; i < s; i = i + 1) {
            this.keys.Add(0);
            this.vals.Add(ByteBuffer.Alloc(16));
            this.pinned.Add(false);
            this.lruPrev.Add(-1);
            this.lruNext.Add(-1);
        }
        this.lruHead = -1;
        this.lruTail = -1;
        this.count = 0;
    }

    int Count() { return this.count; }

    int FindSlot(int pageId) {
        int mask = this.slots - 1;
        int h = (pageId * 2654435761) & mask;
        if (h < 0) { h = -h & mask; }
        for (int probes = 0; probes < this.slots; probes = probes + 1) {
            int k = this.keys[h];
            if (k == 0) { return -1; }
            if (k == pageId + 1) { return h; }
            h = (h + 1) & mask;
        }
        return -1;
    }

    int FindInsertSlot(int pageId) {
        int mask = this.slots - 1;
        int h = (pageId * 2654435761) & mask;
        if (h < 0) { h = -h & mask; }
        while (this.keys[h] != 0 && this.keys[h] != -1) {
            h = (h + 1) & mask;
        }
        return h;
    }

    void LruUnlink(int slot) {
        int p = this.lruPrev[slot];
        int n = this.lruNext[slot];
        if (p >= 0) { this.lruNext[p] = n; } else { this.lruHead = n; }
        if (n >= 0) { this.lruPrev[n] = p; } else { this.lruTail = p; }
        this.lruPrev[slot] = -1;
        this.lruNext[slot] = -1;
    }

    void LruPushFront(int slot) {
        this.lruPrev[slot] = -1;
        this.lruNext[slot] = this.lruHead;
        if (this.lruHead >= 0) { this.lruPrev[this.lruHead] = slot; }
        this.lruHead = slot;
        if (this.lruTail < 0) { this.lruTail = slot; }
    }

    bool Has(int pageId) { return FindSlot(pageId) >= 0; }

    ByteBuffer Get(int pageId) {
        int slot = FindSlot(pageId);
        if (slot < 0) { return ByteBuffer.Alloc(16); }
        LruUnlink(slot);
        LruPushFront(slot);
        return this.vals[slot];
    }

    void SetPinned(int pageId, bool p) {
        int slot = FindSlot(pageId);
        if (slot >= 0) { this.pinned[slot] = p; }
    }

    /// <summary>解除全部钉住（事务结束时调用）。</summary>
    void UnpinAll() {
        for (int i = 0; i < this.slots; i = i + 1) { this.pinned[i] = false; }
    }

    /// <summary>丢弃一页（其 id 即将用于不同
    /// 内容，旧的副本不能残留）。</summary>
    void Remove(int pageId) {
        int slot = FindSlot(pageId);
        if (slot < 0) { return; }
        this.vals[slot].Free();
        this.vals[slot] = ByteBuffer.Alloc(16);
        this.keys[slot] = -1;
        this.pinned[slot] = false;
        LruUnlink(slot);
        this.count = this.count - 1;
    }

    /// <summary>丢弃所有页（另一进程已提交，缓存的页
    /// 内容可能属于已不存在的版本）。</summary>
    void Clear() {
        for (int i = 0; i < this.slots; i = i + 1) {
            if (this.keys[i] > 0) {
                this.vals[i].Free();
                this.vals[i] = ByteBuffer.Alloc(16);
            }
            this.keys[i] = 0;
            this.pinned[i] = false;
            this.lruPrev[i] = -1;
            this.lruNext[i] = -1;
        }
        this.lruHead = -1;
        this.lruTail = -1;
        this.count = 0;
    }

    int EvictableSlot() {
        int s = this.lruTail;
        while (s >= 0) {
            if (!this.pinned[s]) { return s; }
            s = this.lruPrev[s];
        }
        return -1;
    }

    void Grow() {
        List<int> oldKeys = this.keys;
        List<ByteBuffer> oldVals = this.vals;
        List<bool> oldPinned = this.pinned;
        int oldSlots = this.slots;

        this.slots = oldSlots * 2;
        this.keys = new List<int>();
        this.vals = new List<ByteBuffer>();
        this.pinned = new List<bool>();
        this.lruPrev = new List<int>();
        this.lruNext = new List<int>();
        int i = 0;
        for (; i < this.slots; i = i + 1) {
            this.keys.Add(0);
            this.vals.Add(ByteBuffer.Alloc(16));
            this.pinned.Add(false);
            this.lruPrev.Add(-1);
            this.lruNext.Add(-1);
        }
        this.lruHead = -1;
        this.lruTail = -1;
        this.count = 0;

        i = 0;
        while (i < oldSlots) {
            if (oldKeys[i] > 0) {
                int id = oldKeys[i] - 1;
                int slot = FindInsertSlot(id);
                this.keys[slot] = id + 1;
                this.vals[slot] = oldVals[i];
                this.pinned[slot] = oldPinned[i];
                LruPushFront(slot);
                this.count = this.count + 1;
            }
            i = i + 1;
        }
    }

    /// <summary>插入一页并接管 buf 的所有权；满了时驱逐 LRU
    /// 中未钉住的页。</summary>
    void Put(int pageId, ByteBuffer buf, bool pin) {
        if (this.count >= this.capacity) {
            int ev = EvictableSlot();
            if (ev >= 0) {
                this.vals[ev].Free();
                this.vals[ev] = ByteBuffer.Alloc(16);
                this.keys[ev] = -1;
                LruUnlink(ev);
                this.count = this.count - 1;
            }
        }
        if (this.count * 2 >= this.slots) { Grow(); }
        int slot = FindInsertSlot(pageId);
        this.keys[slot] = pageId + 1;
        this.vals[slot] = buf;
        this.pinned[slot] = pin;
        LruPushFront(slot);
        this.count = this.count + 1;
    }
}

/// <summary>
/// 页管理器，单写者/多读者 MVCC（LMDB 模型）。
///
/// 第 0 页和第 1 页是交替写入的 meta 页；每页包含
/// 事务 id、B+Tree 根、空闲链表头、页数及
/// CRC。打开数据库时选择事务 id 最高且有效的 meta 页，
/// 从而无需 redo log 即可原子提交：崩溃时
/// 新 meta 页要么完整（新版本），要么不完整（旧版本，
/// 因页面从不原地修改而保持原样）。
///
/// 写事务从不覆盖在用页：<see cref="PageForWrite"/>
/// 会将其复制到新分配的页，旧页交给
/// 带提交事务 id 标记的空闲链表。页只有在
/// 没有任何读者仍查看比释放它的事务更旧的快照时，
/// 才能复用——这正是 <see cref="DbRegistry"/> 所跟踪的。
///
///   pager.BeginWrite();
///   int np = pager.PageForWrite(oldPage);   // copy-on-write
///   ...mutate pager.GetPage(np)...
///   pager.SetRoot(newRoot);
///   pager.Commit();                          // fsync data, then meta
/// </summary>
class Pager {
    static int PAGE_SIZE = 4096;
    static int MAGIC = 859980122;        // "ZDB3" 小端；ZDB2 把
                                         // id 写成十二位十进制数
    static int META_FIELDS = 48;         // meta CRC 覆盖的字节数
    static int FREE_PER_PAGE = 255;      // 单个空闲链表页中的 (id, txn) 对数

    // 页号是 32 位（文件格式按 u64 存储，
    // 格式本身允许更大）：2^31 页 × 4 KiB 即 8 TiB 的数据库，
    // 用 `int` 保存可使每个索引、列表和缓存键只占一个字。
    // 声称更大 id 的文件要么损坏、要么由未来格式写入，
    // 因此在这里直接拒绝，而不是静默截断。
    static int PageIdOf(long stored) {
        if (stored < 0 || stored > 2147483647) { return 0; }
        return (int)stored;
    }

    PageFile file;
    PageCache cache;
    DbRegistry registry;
    string lastError;

    long txnid;         // 该句柄正在查看的快照
    int rootId;
    int freeHead;
    int pageCount;      // 文件中的页总数（>= 2）

    PageIdSet fresh;    // 当前运行中写事务分配的页
    List<int> freshIds; // 同上，按分配顺序排列（提交写入集）
    List<int> freeIds;  // 空闲链表：页 id……
    List<long> freeTxns; // ……以及释放各页的事务
    List<int> reusable; // 已无读者可见的空闲页
    List<int> pendingFree;   // 由当前运行中的事务释放
    List<int> freeChain;     // 承载已持久化空闲链表的页

    int writeDepth;
    int readDepth;
    int pageWrites;     // 自该句柄打开以来写入磁盘的页数
    int syncEvery;
    int commitsSinceSync;
    bool freeLoaded;
    bool cacheDirty;    // 缓存已失效：BTree 必须重新加载根节点

    Pager() {
        this.lastError = "";
        this.txnid = 0;
        this.rootId = 0;
        this.freeHead = 0;
        this.pageCount = 2;
        this.writeDepth = 0;
        this.readDepth = 0;
        this.pageWrites = 0;
        this.syncEvery = 1;
        this.commitsSinceSync = 0;
        this.freeLoaded = false;
        this.cacheDirty = false;
        this.fresh = new PageIdSet();
        this.freshIds = new List<int>();
        this.freeIds = new List<int>();
        this.freeTxns = new List<long>();
        this.reusable = new List<int>();
        this.pendingFree = new List<int>();
        this.freeChain = new List<int>();
    }

    /// <summary>打开数据库文件（不存在则创建）。</summary>
    static Pager Open(string path, int cacheCapacity) {
        Pager p = new Pager();
        p.file = PageFile.Open(path);
        if (!p.file.IsOpen()) {
            p.lastError = p.file.GetError();
            return p;
        }
        p.cache = new PageCache(cacheCapacity);
        p.registry = DbRegistry.Attach(path);

        if (p.file.Size() < Pager.PAGE_SIZE * 2) {
            if (!p.registry.LockWrite()) {
                p.lastError = "cannot lock database for initialization";
                return p;
            }
            if (p.file.Size() < Pager.PAGE_SIZE * 2) {
                p.txnid = 1;
                p.rootId = 0;
                p.freeHead = 0;
                p.pageCount = 2;
                ByteBuffer zero = ByteBuffer.Alloc(Pager.PAGE_SIZE);
                zero.Clear();
                zero.SetLength(Pager.PAGE_SIZE);
                p.file.WriteAt(0, zero.Raw(), Pager.PAGE_SIZE);
                p.file.WriteAt(Pager.PAGE_SIZE, zero.Raw(), Pager.PAGE_SIZE);
                zero.Free();
                p.WriteMeta(1);
                p.file.Sync();
                p.registry.PublishTxn(1);
            } else {
                p.LoadMeta();
            }
            p.registry.UnlockWrite();
        } else {
            p.LoadMeta();
        }
        p.registry.ClaimSlot();
        return p;
    }

    bool IsOpen() { return this.lastError.Length == 0 && this.file.IsOpen(); }

    string GetError() { return this.lastError; }

    int PageCount() { return this.pageCount; }

    long CommitId() { return this.txnid; }

    int RootId() { return this.rootId; }

    void SetRoot(int id) { this.rootId = id; }

    /// <summary>空闲链表上的页数加上已可复用的页数
    /// （文件增长前即可复用的空间）。</summary>
    int FreePages() { return this.freeIds.Count + this.reusable.Count; }

    /// <summary>自该句柄打开以来写入磁盘的页数（含 meta 页）：
    /// 用它除以工作负载实际修改的页数，可得到
    /// 写放大倍数。</summary>
    int PageWrites() { return this.pageWrites; }

    /// <summary>仍被任意进程读取的最旧快照；比它更新的已释放页
    /// 还不能再复用。0 = 无人读取。</summary>
    long OldestReader() { return this.registry.OldestSnapshot(); }

    /// <summary>提交时数据页的 fsync 频率：1 = 完全
    /// 持久性（默认），N = 每 N 次提交 fsync 一次数据。meta 页
    /// 总是最后写入，因此更低的频率是用“最近 N 次提交可能
    /// 丢失”换取吞吐量——但绝不会损坏数据库。</summary>
    void SetSyncEvery(int n) {
        if (n >= 1) { this.syncEvery = n; }
    }

    // ===== meta 页 =====

    void WriteMeta(long newTxn) {
        ByteBuffer h = ByteBuffer.Alloc(Pager.PAGE_SIZE);
        h.Clear();
        h.WriteU32(Pager.MAGIC);
        h.WriteU32(Pager.PAGE_SIZE);
        h.WriteU64(newTxn);
        h.WriteU64(this.rootId);
        h.WriteU64(this.freeHead);
        h.WriteU64(this.pageCount);
        h.WriteU64(0);
        h.SetLength(Pager.META_FIELDS);
        long crc = h.Crc32(Pager.META_FIELDS);
        h.SetLength(Pager.META_FIELDS);
        h.WriteU32(crc);
        h.SetLength(Pager.PAGE_SIZE);
        long slot = newTxn & 1;
        this.file.WriteAt(slot * Pager.PAGE_SIZE, h.Raw(), Pager.PAGE_SIZE);
        this.pageWrites = this.pageWrites + 1;
        h.Free();
    }

    /// <summary>读取一个 meta 页；返回其事务 id，若页
    /// 不存在、非本库或 CRC 损坏（撕裂的提交）则返回 0。</summary>
    long ReadMetaSlot(int slot, ByteBuffer h) {
        int n = this.file.ReadAt((long)slot * Pager.PAGE_SIZE, h, Pager.PAGE_SIZE);
        if (n < Pager.PAGE_SIZE) { return 0; }
        h.SeekRead(0);
        if (h.ReadU32() != Pager.MAGIC) { return 0; }
        if (h.ReadU32() != Pager.PAGE_SIZE) { return 0; }
        long txn = h.ReadU64();
        h.SeekRead(Pager.META_FIELDS);
        long stored = h.ReadU32();
        if (h.Crc32(Pager.META_FIELDS) != stored) { return 0; }
        return txn;
    }

    /// <summary>将最新且有效的 meta 页采纳为该句柄的快照。</summary>
    void LoadMeta() {
        ByteBuffer a = ByteBuffer.Alloc(Pager.PAGE_SIZE);
        ByteBuffer b = ByteBuffer.Alloc(Pager.PAGE_SIZE);
        long ta = ReadMetaSlot(0, a);
        long tb = ReadMetaSlot(1, b);
        ByteBuffer pick = a;
        long txn = ta;
        if (tb > ta) { pick = b; txn = tb; }
        if (txn == 0) {
            this.lastError = "not a ZanDB file (no valid meta page)";
            a.Free();
            b.Free();
            return;
        }
        pick.SeekRead(8);
        this.txnid = pick.ReadU64();
        this.rootId = Pager.PageIdOf(pick.ReadU64());
        this.freeHead = Pager.PageIdOf(pick.ReadU64());
        this.pageCount = Pager.PageIdOf(pick.ReadU64());
        a.Free();
        b.Free();
        this.freeLoaded = false;
        this.freeIds = new List<int>();
        this.freeTxns = new List<long>();
        this.reusable = new List<int>();
        this.freeChain = new List<int>();
    }

    /// <summary>自该句柄上次读取 meta 页以来，另一进程
    /// 是否可能已提交。事务 id 由共享的
    /// registry 分配，在整库内唯一：若已发布 id 等于
    /// 我们的 id，说明我们的快照就是最新版本。存活进程数
    /// 在此说明不了什么——已提交后退出的进程
    /// 会把其版本留给本进程采纳。</summary>
    bool MaybeStale() {
        if (!this.registry.IsShared()) { return false; }
        long published = this.registry.CommittedTxn();
        if (published == 0) { return false; }
        return published != this.txnid;
    }

    /// <summary>当另一进程已提交时重新读取 meta 页，并
    /// 丢弃旧版本的缓存页。若快照移动了
    /// 则返回 true。</summary>
    bool Refresh() {
        if (!MaybeStale()) { return false; }
        long before = this.txnid;
        LoadMeta();
        if (this.txnid == before) { return false; }
        this.cache.Clear();
        this.cacheDirty = true;
        return true;
    }

    /// <summary>缓存中的已解码状态（B+Tree 节点）是否需要丢弃，
    /// 因为快照已移动。并清除该标志。</summary>
    bool TakeInvalidation() {
        bool v = this.cacheDirty;
        this.cacheDirty = false;
        return v;
    }

    // ===== 空闲链表 =====

    void LoadFreeList() {
        if (this.freeLoaded) { return; }
        this.freeIds = new List<int>();
        this.freeTxns = new List<long>();
        this.freeChain = new List<int>();
        int pid = this.freeHead;
        ByteBuffer pg = ByteBuffer.Alloc(Pager.PAGE_SIZE);
        while (pid != 0) {
            this.file.ReadAt((long)pid * Pager.PAGE_SIZE, pg, Pager.PAGE_SIZE);
            pg.SeekRead(0);
            int next = Pager.PageIdOf(pg.ReadU64());
            long cnt = pg.ReadU64();
            for (int i = 0; i < cnt && i < Pager.FREE_PER_PAGE; i = i + 1) {
                this.freeIds.Add(Pager.PageIdOf(pg.ReadU64()));
                this.freeTxns.Add(pg.ReadU64());
            }
            // 链表页本身在每次提交时都会被重写。
            this.freeChain.Add(pid);
            pid = next;
        }
        pg.Free();
        this.freeLoaded = true;
    }

    /// <summary>将无存活读者可达的空闲页移入
    /// 可复用池。</summary>
    void ReclaimFree() {
        LoadFreeList();
        long oldest = this.registry.OldestSnapshot();
        List<int> keepIds = new List<int>();
        List<long> keepTxns = new List<long>();
        for (int i = 0; i < this.freeIds.Count; i = i + 1) {
            long freedBy = this.freeTxns[i];
            if (oldest == 0 || freedBy <= oldest) {
                this.reusable.Add(this.freeIds[i]);
            } else {
                keepIds.Add(this.freeIds[i]);
                keepTxns.Add(this.freeTxns[i]);
            }
        }
        this.freeIds = keepIds;
        this.freeTxns = keepTxns;
    }

    /// <summary>将空闲链表写为全新的页链并返回其
    /// 头（空时为 0）。在 Commit 内、新事务 id
    /// 确定后调用。</summary>
    int PersistFreeList(long newTxn) {
        int total = this.freeIds.Count;
        this.freeChain = new List<int>();
        if (total == 0) { return 0; }
        int head = 0;
        int written = 0;
        while (written < total) {
            int cnt = total - written;
            if (cnt > Pager.FREE_PER_PAGE) { cnt = Pager.FREE_PER_PAGE; }
            int pid = AllocPage();
            ByteBuffer pg = GetPage(pid);
            pg.Clear();
            pg.WriteU64(head);
            pg.WriteU64(cnt);
            for (int i = 0; i < cnt; i = i + 1) {
                pg.WriteU64(this.freeIds[written + i]);
                pg.WriteU64(this.freeTxns[written + i]);
            }
            pg.SetLength(Pager.PAGE_SIZE);
            this.freeChain.Add(pid);
            head = pid;
            written = written + cnt;
        }
        return head;
    }

    // ===== 事务 =====

    /// <summary>注册该句柄读取的快照，防止另一进程的写入者
    /// 回收其下的页。开销很小：
    /// 仅一个共享内存存储；数据库在单进程内打开时，
    /// 什么都不做。</summary>
    void BeginRead() {
        this.readDepth = this.readDepth + 1;
        if (this.readDepth > 1 || this.writeDepth > 0) { return; }
        if (!this.registry.IsShared()) { return; }
        Refresh();
        this.registry.PublishSnapshot(this.txnid);
    }

    void EndRead() {
        if (this.readDepth > 0) { this.readDepth = this.readDepth - 1; }
        if (this.readDepth == 0 && this.writeDepth == 0) {
            this.registry.PublishSnapshot(0);
        }
    }

    /// <summary>占用唯一的写者槽位（阻塞）并在最新已提交快照上
    /// 开始写事务。可嵌套。</summary>
    bool BeginWrite() {
        this.writeDepth = this.writeDepth + 1;
        if (this.writeDepth > 1) { return true; }
        if (!this.registry.LockWrite()) {
            this.writeDepth = 0;
            this.lastError = "cannot acquire the writer lock";
            return false;
        }
        // 在之上构建前，先采纳其他进程的提交；若
        // 没有变动，缓存页和空闲链表依然有效。
        if (MaybeStale()) {
            LoadMeta();
            this.cache.Clear();
            this.cacheDirty = true;
        }
        this.fresh.Clear();
        this.freshIds = new List<int>();
        this.pendingFree = new List<int>();
        ReclaimFree();
        // 写入者同时也是其构建所基于快照的读者。
        this.registry.PublishSnapshot(this.txnid);
        return true;
    }

    bool InWrite() { return this.writeDepth > 0; }

    /// <summary>当页属于当前运行中的写事务时为 true
    /// （因此可原地修改）。</summary>
    bool IsFresh(int pageId) { return this.fresh.Has(pageId); }

    /// <summary>分配一页：有可复用的空闲页就复用，
    /// 否则文件增长。该页在提交前保持钉住。</summary>
    int AllocPage() {
        int id = 0;
        if (this.reusable.Count > 0) {
            id = this.reusable[this.reusable.Count - 1];
            this.reusable.RemoveAt(this.reusable.Count - 1);
            this.cache.Remove(id);
        } else {
            id = this.pageCount;
            this.pageCount = this.pageCount + 1;
        }
        ByteBuffer buf = ByteBuffer.Alloc(Pager.PAGE_SIZE);
        buf.Clear();
        buf.SetLength(Pager.PAGE_SIZE);
        this.cache.Put(id, buf, true);
        this.fresh.Add(id);
        this.freshIds.Add(id);
        return id;
    }

    /// <summary>写时复制：返回一个可修改的页 id。
    /// 已提交快照的页会复制到新页，旧页
    /// 进入空闲链表队列；本事务创建的页
    /// 原样返回。</summary>
    int PageForWrite(int pageId) {
        if (pageId == 0) { return AllocPage(); }
        if (this.fresh.Has(pageId)) { return pageId; }
        int nid = AllocPage();
        // 新页已钉住，因此读取旧页不会把它驱逐。
        ByteBuffer src = GetPage(pageId);
        ByteBuffer dst = GetPage(nid);
        dst.Clear();
        dst.WriteBytes(src.Raw(), Pager.PAGE_SIZE);
        dst.SetLength(Pager.PAGE_SIZE);
        FreeLater(pageId);
        return nid;
    }

    /// <summary>将页排队，待无读者可见时复用。
    /// 当前事务创建的页立即回收——
    /// 从没有人见过它们。</summary>
    void FreeLater(int pageId) {
        if (pageId == 0) { return; }
        if (this.fresh.Has(pageId)) {
            this.reusable.Add(pageId);
            return;
        }
        this.pendingFree.Add(pageId);
    }

    /// <summary>返回页缓冲区（带缓存；未命中时从文件读取）。
    /// 缓冲区归 pager 所有，只有当
    /// 页属于当前运行中的事务时才可写。</summary>
    ByteBuffer GetPage(int pageId) {
        if (this.cache.Has(pageId)) {
            return this.cache.Get(pageId);
        }
        ByteBuffer buf = ByteBuffer.Alloc(Pager.PAGE_SIZE);
        if (pageId < this.pageCount) {
            this.file.ReadAt((long)pageId * Pager.PAGE_SIZE, buf, Pager.PAGE_SIZE);
        }
        buf.SetLength(Pager.PAGE_SIZE);
        this.cache.Put(pageId, buf, this.fresh.Has(pageId));
        return buf;
    }

    /// <summary>为兼容 API 而保留：写时复制下，每个被修改的
    /// 页都是新分配的，因此无需标记。</summary>
    void MarkDirty(int pageId) { }

    /// <summary>发布事务：先数据页（fsync），再
    /// meta 页（fsync）。meta 写入前崩溃会保留旧版本
    /// 完好无损，因此无需 redo log 即可实现提交的原子性。</summary>
    bool Commit() {
        if (this.writeDepth > 1) {
            this.writeDepth = this.writeDepth - 1;
            return true;
        }
        if (this.writeDepth == 0) { return true; }

        // 事务 id 来自整个数据库，而非本句柄：
        // 从同一快照开始的两个进程不能都把
        // 自己的提交称为“n + 1”，否则双方都不会察觉对方
        // 已推进数据库（且一个分支会静默覆盖
        // 另一方的 meta 页）。此处持有写者锁，因此 max + 1
        // 跨进程唯一且单调递增。
        long newTxn = this.txnid + 1;
        long published = this.registry.CommittedTxn();
        if (published >= newTxn) { newTxn = published + 1; }

        // 承载上一空闲链表的页将在下方重写。
        for (int c = 0; c < this.freeChain.Count; c = c + 1) {
            this.pendingFree.Add(this.freeChain[c]);
        }

        // 本事务释放的页可供后续事务复用。
        int i = 0;
        for (; i < this.pendingFree.Count; i = i + 1) {
            this.freeIds.Add(this.pendingFree[i]);
            this.freeTxns.Add(newTxn);
        }
        this.pendingFree = new List<int>();
        this.freeHead = PersistFreeList(newTxn);

        // 写入本事务创建的每一页。它们都是新页，
        // 不会覆盖在用数据，顺序无关紧要。
        i = 0;
        while (i < this.freshIds.Count) {
            int pid = this.freshIds[i];
            ByteBuffer pg = GetPage(pid);
            if (this.file.WriteAt((long)pid * Pager.PAGE_SIZE, pg.Raw(), Pager.PAGE_SIZE)
                    != Pager.PAGE_SIZE) {
                this.lastError = "page write failed";
                Rollback();
                return false;
            }
            this.pageWrites = this.pageWrites + 1;
            i = i + 1;
        }

        this.commitsSinceSync = this.commitsSinceSync + 1;
        if (this.commitsSinceSync >= this.syncEvery) {
            this.file.Sync();
            this.commitsSinceSync = 0;
        }

        WriteMeta(newTxn);
        this.file.Sync();
        this.txnid = newTxn;
        this.registry.PublishTxn(newTxn);

        this.cache.UnpinAll();
        this.fresh.Clear();
        this.freshIds = new List<int>();
        this.writeDepth = 0;
        this.registry.PublishSnapshot(0);
        this.registry.UnlockWrite();
        return true;
    }

    /// <summary>丢弃事务写入的一切：未写入任何
    /// 持久化内容，因此只需丢弃新页，meta 页仍
    /// 指向旧版本。</summary>
    void Rollback() {
        if (this.writeDepth == 0) { return; }
        for (int i = 0; i < this.freshIds.Count; i = i + 1) {
            this.cache.Remove(this.freshIds[i]);
        }
        this.fresh.Clear();
        this.freshIds = new List<int>();
        this.pendingFree = new List<int>();
        this.writeDepth = 0;
        LoadMeta();
        this.cache.Clear();
        this.cacheDirty = true;
        this.registry.PublishSnapshot(0);
        this.registry.UnlockWrite();
    }

    /// <summary>将迄今写入的所有内容强制刷入稳定存储。</summary>
    void Checkpoint() {
        this.file.Sync();
        this.commitsSinceSync = 0;
    }

    void Close() {
        if (this.writeDepth > 0) { Rollback(); }
        Checkpoint();
        this.registry.Close();
        this.file.Close();
    }
}
