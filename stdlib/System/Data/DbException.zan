using System;

namespace System.Data;

/// <summary>
/// Thrown when a statement fails: the server rejected it, the session is not
/// connected, or the driver cannot carry out the request. The drivers used to
/// answer such failures with an empty result and leave the reason in
/// <c>GetError()</c>, which meant a caller that forgot to check kept working
/// with rows that were never there.
///
/// <see cref="Code"/> is the driver's own error number (Firebird SQL code,
/// MySQL error number, SQL Server number, TDengine code); it is 0 when the
/// failure never reached the server. <see cref="Provider"/> is the
/// <see cref="DbProvider"/> id, so a handler can tell which driver raised it
/// without parsing the message.
/// </summary>
class DbException : Exception {
    public int Code;
    public int Provider;

    public DbException(string message, int code, int provider) {
        Message = message;
        Code = code;
        Provider = provider;
    }

    /// <summary>A failure that never reached a server, so it carries no error
    /// number and no provider.</summary>
    static DbException Of(string message) {
        return new DbException(message, 0, DbProvider.Unknown);
    }
}
