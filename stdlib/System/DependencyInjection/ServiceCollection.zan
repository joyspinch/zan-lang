using System;
using System.Threading;

namespace System.DependencyInjection;

public enum ServiceLifetime {
    Singleton = 0,
    Scoped = 1,
    Transient = 2
}

public interface IServiceProvider {
    object GetService(string serviceType);
}

public interface IServiceScope : IDisposable {
    IServiceProvider GetServiceProvider();
}

public interface IServiceScopeFactory {
    IServiceScope CreateScope();
}

public delegate object ServiceFactory(IServiceProvider sp);

public class ServiceDescriptor {
    public string serviceType;
    public ServiceLifetime lifetime;
    public ServiceFactory factory;
    public object implementationInstance;

    public ServiceDescriptor(string serviceType, ServiceLifetime lifetime, ServiceFactory factory) {
        this.serviceType = serviceType;
        this.lifetime = lifetime;
        this.factory = factory;
        this.implementationInstance = null;
    }

    public ServiceDescriptor(string serviceType, object instance) {
        this.serviceType = serviceType;
        this.lifetime = ServiceLifetime.Singleton;
        this.factory = null;
        this.implementationInstance = instance;
    }
}

public class ServiceCollection {
    List<ServiceDescriptor> descriptors;

    public ServiceCollection() {
        this.descriptors = new List<ServiceDescriptor>();
    }

    public void Add(ServiceDescriptor descriptor) {
        if (descriptor != null) {
            this.descriptors.Add(descriptor);
        }
    }

    public void AddTransient(string serviceType, ServiceFactory factory) {
        this.Add(new ServiceDescriptor(serviceType, ServiceLifetime.Transient, factory));
    }

    public void AddScoped(string serviceType, ServiceFactory factory) {
        this.Add(new ServiceDescriptor(serviceType, ServiceLifetime.Scoped, factory));
    }

    public void AddSingleton(string serviceType, ServiceFactory factory) {
        this.Add(new ServiceDescriptor(serviceType, ServiceLifetime.Singleton, factory));
    }

    public void AddSingletonInstance(string serviceType, object instance) {
        this.Add(new ServiceDescriptor(serviceType, instance));
    }

    public List<ServiceDescriptor> Descriptors {
        get { return this.descriptors; }
    }

    public ServiceProvider BuildServiceProvider() {
        return new ServiceProvider(this.descriptors, null);
    }
}

public class ServiceScope : IServiceScope {
    ServiceProvider scopedProvider;
    bool isDisposed;

    public ServiceScope(ServiceProvider scopedProvider) {
        this.scopedProvider = scopedProvider;
        this.isDisposed = false;
    }

    public IServiceProvider GetServiceProvider() {
        return this.scopedProvider;
    }

    public void Dispose() {
        if (this.isDisposed) { return; }
        this.isDisposed = true;
        if (this.scopedProvider != null) {
            this.scopedProvider.Dispose();
        }
    }
}

public class ServiceProvider : IServiceProvider, IServiceScopeFactory, IDisposable {
    Dictionary<string, ServiceDescriptor> descriptorMap;
    Dictionary<string, object> singletons;
    Dictionary<string, object> scopedInstances;
    ServiceProvider rootProvider;
    nint syncLock;
    bool isDisposed;

    public ServiceProvider(List<ServiceDescriptor> descriptors, ServiceProvider root) {
        this.syncLock = Mutex.Create();
        this.isDisposed = false;
        this.rootProvider = root;
        this.descriptorMap = new Dictionary<string, ServiceDescriptor>();

        if (descriptors != null) {
            for (int i = 0; i < descriptors.Count; i = i + 1) {
                ServiceDescriptor d = descriptors[i];
                this.descriptorMap[d.serviceType] = d;
            }
        }

        if (this.rootProvider == null) {
            this.singletons = new Dictionary<string, object>();
        } else {
            this.scopedInstances = new Dictionary<string, object>();
        }
    }

    public object GetService(string serviceType) {
        if (serviceType == null) { return null; }
        if (this.isDisposed) {
            throw new Exception("Cannot resolve service from a disposed ServiceProvider.");
        }

        if (serviceType == "IServiceProvider") {
            return this;
        }
        if (serviceType == "IServiceScopeFactory") {
            return this;
        }

        ServiceDescriptor d = null;
        if (this.descriptorMap.ContainsKey(serviceType)) {
            d = this.descriptorMap[serviceType];
        } else if (this.rootProvider != null && this.rootProvider.descriptorMap.ContainsKey(serviceType)) {
            d = this.rootProvider.descriptorMap[serviceType];
        }

        if (d == null) {
            return null;
        }

        // 1. Singleton
        if (d.lifetime == ServiceLifetime.Singleton) {
            ServiceProvider targetRoot = this.rootProvider != null ? this.rootProvider : this;
            if (d.implementationInstance != null) {
                return d.implementationInstance;
            }

            Mutex.Lock(targetRoot.syncLock);
            if (targetRoot.singletons.ContainsKey(serviceType)) {
                object existing = targetRoot.singletons[serviceType];
                Mutex.Unlock(targetRoot.syncLock);
                return existing;
            }

            object created = d.factory != null ? d.factory(this) : null;
            if (created != null) {
                targetRoot.singletons[serviceType] = created;
            }
            Mutex.Unlock(targetRoot.syncLock);
            return created;
        }

        // 2. Scoped
        if (d.lifetime == ServiceLifetime.Scoped) {
            if (this.rootProvider == null) {
                Mutex.Lock(this.syncLock);
                if (this.singletons.ContainsKey(serviceType)) {
                    object existing = this.singletons[serviceType];
                    Mutex.Unlock(this.syncLock);
                    return existing;
                }
                Mutex.Unlock(this.syncLock);

                object created = d.factory != null ? d.factory(this) : null;
                if (created != null) {
                    Mutex.Lock(this.syncLock);
                    this.singletons[serviceType] = created;
                    Mutex.Unlock(this.syncLock);
                }
                return created;
            }

            Mutex.Lock(this.syncLock);
            if (this.scopedInstances.ContainsKey(serviceType)) {
                object existing = this.scopedInstances[serviceType];
                Mutex.Unlock(this.syncLock);
                return existing;
            }
            Mutex.Unlock(this.syncLock);

            object scCreated = d.factory != null ? d.factory(this) : null;
            if (scCreated != null) {
                Mutex.Lock(this.syncLock);
                this.scopedInstances[serviceType] = scCreated;
                Mutex.Unlock(this.syncLock);
            }
            return scCreated;
        }

        // 3. Transient
        if (d.factory != null) {
            return d.factory(this);
        }
        return null;
    }

    public IServiceScope CreateScope() {
        ServiceProvider root = this.rootProvider != null ? this.rootProvider : this;
        ServiceProvider scopedSp = new ServiceProvider(null, root);
        return new ServiceScope(scopedSp);
    }

    public void Dispose() {
        if (this.isDisposed) { return; }
        this.isDisposed = true;

        if (this.scopedInstances != null) {
            Mutex.Lock(this.syncLock);
            List<string> keys = this.scopedInstances.Keys;
            for (int i = 0; i < keys.Count; i = i + 1) {
                object obj = this.scopedInstances[keys[i]];
                if (obj is IDisposable) {
                    IDisposable disp = (IDisposable)obj;
                    disp.Dispose();
                }
            }
            Mutex.Unlock(this.syncLock);
        }

        if (this.singletons != null) {
            Mutex.Lock(this.syncLock);
            List<string> keys = this.singletons.Keys;
            for (int i = 0; i < keys.Count; i = i + 1) {
                object obj = this.singletons[keys[i]];
                if (obj is IDisposable) {
                    IDisposable disp = (IDisposable)obj;
                    disp.Dispose();
                }
            }
            Mutex.Unlock(this.syncLock);
        }

        if (this.syncLock != 0) {
            Mutex.Destroy(this.syncLock);
            this.syncLock = 0;
        }
    }
}
