namespace System;

/// The 16 standard console colours, in the same order (0..15) as C#'s
/// System.ConsoleColor. Assign one to Console.ForegroundColor or
/// Console.BackgroundColor; the runtime maps it to an ANSI SGR escape.
enum ConsoleColor {
    Black,
    DarkBlue,
    DarkGreen,
    DarkCyan,
    DarkRed,
    DarkMagenta,
    DarkYellow,
    Gray,
    DarkGray,
    Blue,
    Green,
    Cyan,
    Red,
    Magenta,
    Yellow,
    White
}
