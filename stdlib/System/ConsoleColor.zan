namespace System;

/// 16 种标准控制台颜色，顺序（0..15）与 C# 的
/// System.ConsoleColor 一致。可赋给 Console.ForegroundColor 或
/// Console.BackgroundColor；运行时将其映射为 ANSI SGR 转义序列。
enum ConsoleColor {
    Black,
    DarkBlue,
    DarkGreen,
    DarkCyan,
    DarkRed,
    DarkMagenta,
    DarkYellow,
    Gray,
    DarkGray,
    Blue,
    Green,
    Cyan,
    Red,
    Magenta,
    Yellow,
    White
}
