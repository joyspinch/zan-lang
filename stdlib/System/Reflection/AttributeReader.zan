using System;

namespace System.Reflection;

// Reads the versioned declaration data returned by TypeInfo. Entries and
// arguments follow source order. An empty argument name denotes a positional
// argument. Literal values carry their kind independently of their text.
// Kind E holds a symbolic name, a dotted name, or names joined by |.
// Kind X marks an unsupported expression and has empty text.
public class AttributeReader {
    private string data;
    private int offset;

    public string Name;
    public string ArgumentName;
    public char ArgumentKind;
    public string ArgumentValue;

    public AttributeReader(string data) {
        this.data = data != null ? data : "";
        this.offset = this.data.StartsWith("!1;") ? 3 : this.data.Length;
    }

    private string ReadText() {
        int end = this.data.IndexOf(":", this.offset);
        int size = 0;
        if (end < 0 || !int.TryParse(this.data.Substring(this.offset, end - this.offset), out size)
            || size < 0 || size > this.data.Length - end - 1) {
            this.offset = this.data.Length;
            return null;
        }
        this.offset = end + 1 + size;
        return this.data.Substring(end + 1, size);
    }

    public bool MoveNext() {
        while (this.MoveNextArgument()) { }
        if (this.offset >= this.data.Length || this.data[this.offset] != 'A') { return false; }
        this.offset = this.offset + 1;
        this.Name = this.ReadText();
        return this.Name != null;
    }

    public bool MoveNextArgument() {
        if (this.offset >= this.data.Length || this.data[this.offset] == 'A') { return false; }
        this.ArgumentKind = this.data[this.offset];
        this.offset = this.offset + 1;
        this.ArgumentName = this.ReadText();
        this.ArgumentValue = this.ReadText();
        if (this.ArgumentName == null || this.ArgumentValue == null
            || this.offset >= this.data.Length || this.data[this.offset] != ';') {
            this.offset = this.data.Length;
            return false;
        }
        this.offset = this.offset + 1;
        return true;
    }
}
