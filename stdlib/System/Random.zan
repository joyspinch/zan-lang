using System;

namespace System;

/// <summary>
/// 通用（非加密）伪随机数生成器。
/// 使用 64 位线性同余序列（Knuth MMIX 常数）；
/// 速度快，可由种子复现，但绝不能用于安全用途——参见
/// <c>System.RandomNumberGenerator</c>。
/// </summary>
class Random {
    [DllImport("crt")]
    static extern long time(nint ptr);

    long state;

    /// <summary>以当前时间作为种子。</summary>
    Random() {
        state = time(0);
        if (state == 0) { state = 1; }
    }

    /// <summary>用显式种子创建生成器（可复现）。</summary>
    static Random Seeded(long seed) {
        Random r = new Random();
        r.state = seed;
        if (r.state == 0) { r.state = 1; }
        return r;
    }

    /// <summary>推进状态并返回原始 64 位结果。</summary>
    long NextRaw() {
        state = state * 6364136223846793005 + 1442695040888963407;
        return state;
    }

    /// <summary>非负伪随机整数。</summary>
    int Next() {
        long r = NextRaw();
        if (r < 0) { r = -r; }
        if (r < 0) { r = 0; }   // 保护唯一不可取负的值
        return (int)(r & 2147483647);
    }

    /// <summary>[0, bound) 区间内的非负整数。</summary>
    int NextBelow(int bound) {
        if (bound <= 0) { return 0; }
        int r = Next();
        return r - (r / bound) * bound;
    }

    /// <summary>[lo, hi) 区间内的整数。</summary>
    int Between(int lo, int hi) {
        if (hi <= lo) { return lo; }
        return lo + NextBelow(hi - lo);
    }

    /// <summary>[0.0, 1.0) 区间内的 double。</summary>
    double NextDouble() {
        int r = Next();
        int m = r - (r / 1000000) * 1000000;
        return (double)m / 1000000.0;
    }

    /// <summary>伪随机布尔值。</summary>
    bool NextBool() {
        int r = Next();
        return (r - (r / 2) * 2) == 1;
    }
}
