using System;
using System.Threading;

namespace System;

// 通用（非加密）伪随机数生成器。
// 使用 64 位线性同余序列（Knuth MMIX 常数）；
// 速度快，可由种子复现，但绝不能用于安全用途——参见
// <c>System.RandomNumberGenerator</c>。
// ⚠ 安全警告：本类【非加密安全】——线性同余序列可由两三个输出直接
// 反推全部内部状态。session token、CSRF nonce、密钥/盐、验证码等
// 一切安全敏感场景【必须】用 <c>System.RandomNumberGenerator</c>
// （OS CSPRNG）。用错本类等于把秘密写在了脸上。
public class Random {
    static AtomicInt counter = new AtomicInt(1442695040888963407L);

    // LCG 状态（构造与 Seeded 都保证非 0）。
    public long state;

    // 以高熵 CSPRNG 随机数/高精度时钟混合计数器作为种子，避免高并发下实例碰撞。
    public Random() {
        byte[] b = RandomNumberGenerator.GetBytes(8);
        if (b != null) {
            this.state = BitConverter.ToInt64(b, 0);
        } else {
            long t = DateTime.GetCurrentUnixMilliseconds();
            long c = Random.counter != null ? Random.counter.Add(6364136223846793005L) : 0L;
            this.state = (t * 6364136223846793005L) ^ c;
        }
        if (this.state == 0) { this.state = 1; }
    }

    // 用显式指定种子创建生成器（构造函数）。
    public Random(long seed) {
        this.state = seed;
        if (this.state == 0) { this.state = 1; }
    }

    // 用显式种子创建生成器（可复现）。
    public static Random Seeded(long seed) {
        return new Random(seed);
    }

    // 推进状态并返回原始 64 位结果。
    public long NextRaw() {
        this.state = this.state * 6364136223846793005L + 1442695040888963407L;
        return this.state;
    }

    // 非负伪随机整数（31 位）。LCG 低位周期短（低 k 位周期仅 2^k），
    // 曾直接取状态低 31 位：NextBool 取最低位退化成周期 2 的交替
    //（true/false 严格轮流），NextBelow(2 的幂) 走短周期、%1000000
    // 的 NextDouble 只有 10^6 离散刻度——取状态高位段（63..33 位）
    // 则位周期满 2^63，统计性质最好。
    public int Next() {
        long r = NextRaw();
        return (int)((r >> 33) & 2147483647L);
    }

    // 无符号 32 位原料（Lemire 无偏取模用）：取状态高 32 位。
    private long NextUInt32() {
        long r = NextRaw();
        return (r >> 32) & 4294967295L;
    }

    // [0, bound) 区间内的非负整数。Lemire 乘法取模（随机数 × bound
    // 取高 32 位）：无 % 模偏置（旧实现 r % bound 在 bound 不整除
    // 2^31 时偏小值），bound 为 2 的幂时也只吃高位段不踩短周期。
    public int NextBelow(int bound) {
        if (bound <= 0) { return 0; }
        return (int)((NextUInt32() * (long)bound) >> 32);
    }

    // [lo, hi) 区间内的整数。
    public int Between(int lo, int hi) {
        if (hi <= lo) { return lo; }
        return lo + NextBelow(hi - lo);
    }

    // [0.0, 1.0) 区间内的 double：31 位均匀刻度（2^31 个离散值；
    // 旧实现 %1000000 只有 10^6 刻度且吃 LCG 低位）。
    public double NextDouble() {
        return (double)Next() / 2147483648.0;
    }

    // 伪随机布尔值。
    public bool NextBool() {
        return (Next() & 1) == 1;
    }
}
