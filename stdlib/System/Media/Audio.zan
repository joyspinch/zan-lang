using System;

namespace System.Media;

/// <summary>原生音频设备：一次打开，之后所有声音都混到这一个设备上。
///
/// 零依赖原生实现（WASAPI 先行），取代原 SDL3 的音频桥。
/// <see cref="AudioClip"/> 是解码好的采样（WAV/OGG），
/// <see cref="AudioVoice"/> 是它的一次播放；同一个 clip 可以同时起多个
/// voice（叠加音效），混音由运行时后台线程完成。</summary>
class Audio {
    /// <summary>打开默认播放设备（已打开时直接返回 true）。</summary>
    static bool Open() {
        return AudioNative.zan_audio_open() != 0;
    }

    /// 播放设备已打开时为真。
    static bool IsOpen() {
        return AudioNative.zan_audio_is_open() != 0;
    }

    /// <summary>主音量（0..1，可放大到 1 以上）。对已经在响的声音同样
    /// 生效，所以静音/淡出立即听得到。</summary>
    static void SetVolume(double volume) {
        AudioNative.zan_audio_set_volume(volume);
    }

    /// 当前主音量（0..1）。
    static double Volume() {
        return AudioNative.zan_audio_volume();
    }

    /// <summary>原生音频后端名（Windows 上是 "wasapi"；其他平台的
    /// 原生后端尚未落地，返回空串）。</summary>
    static string DriverName() {
        return AudioNative.zan_audio_driver_name();
    }

    /// <summary>还在响的声音数：一次性音效播完即回收，不用调用方登记。</summary>
    static int ActiveVoices() {
        return AudioNative.zan_audio_active_voices();
    }

    /// <summary>立刻停掉所有声音（切场景/退出时用）。</summary>
    static void StopAll() {
        AudioNative.zan_audio_stop_all();
    }

    /// <summary>关闭设备，并停掉设备上剩下的声音。</summary>
    static void Close() {
        AudioNative.zan_audio_close();
    }

    /// <summary>最近一次失败的原因（设备打开失败/解码失败等）；
    /// 没有失败记录时为空串。</summary>
    static string LastError() {
        return AudioNative.zan_audio_last_error();
    }
}

/// <summary>一次播放（voice）。
///
/// 句柄带世代号：声音播完后句柄失效，<see cref="IsPlaying"/> 老实返回
/// false、<see cref="Stop"/> 什么也不做，因此一个存活时间比声音长的
/// AudioVoice 变量是安全的，不会碰到被回收的槽位。</summary>
class AudioVoice {
    long handle;

    /// <summary>包装一个原生 voice 句柄；0 表示没起来的声音，此时对象
    /// 依然可用（IsPlaying 为 false），调用方不需要判空。</summary>
    static AudioVoice Of(long handle) {
        AudioVoice voice = new AudioVoice();
        voice.handle = handle;
        return voice;
    }

    /// <summary>声音是否成功起播（设备没开、voice 池满时为 false）。</summary>
    bool IsValid() { return this.handle != 0; }

    /// 声音仍在响时为真；播完或已 Stop 即 false（句柄按世代号失效）。
    bool IsPlaying() {
        return AudioNative.zan_audio_voice_playing(this.handle) != 0;
    }

    /// <summary>这一个声音的音量（会再乘上主音量）。</summary>
    void SetGain(double gain) {
        AudioNative.zan_audio_voice_set_gain(this.handle, gain);
    }

    /// 停掉这一个声音并使句柄失效；对已失效句柄无操作。
    void Stop() {
        AudioNative.zan_audio_voice_stop(this.handle);
        this.handle = 0;
    }
}

/// <summary>加载到内存的采样（s16 PCM）。<see cref="Play"/> 每次返回
/// 一个新的 <see cref="AudioVoice"/>，所以同一个 clip 可以叠着响。</summary>
class AudioClip : IDisposable {
    nint handle;

    /// <summary>加载 WAV 文件（PCM 8/16/24/32 位与 32 位浮点，含
    /// WAVE_FORMAT_EXTENSIBLE）。失败时返回的对象 IsValid() 为 false
    /// （原因见 <c>Audio.LastError()</c>），不返回 null。</summary>
    static AudioClip LoadWav(string path) {
        AudioClip clip = new AudioClip();
        clip.handle = AudioNative.zan_audio_load_wav(path);
        return clip;
    }

    /// <summary>加载 OGG Vorbis 文件（背景音乐）。失败时返回的对象
    /// IsValid() 为 false，不返回 null。</summary>
    static AudioClip LoadOgg(string path) {
        AudioClip clip = new AudioClip();
        clip.handle = AudioNative.zan_audio_load_ogg(path);
        return clip;
    }

    /// <summary>从内存字节解析 WAV。<paramref name="data"/> 是完整的
    /// WAV 文件字节（如从加密资源包解密出来的内容），全程不落盘。
    /// 字节只在本次调用内同步读取（PCM 会被拷出），返回后即可释放
    /// 缓冲区，不转移所有权。失败时返回的对象 IsValid() 为 false
    /// （原因见 <c>Audio.LastError()</c>），不返回 null。</summary>
    static AudioClip LoadWavFromMem(string data, int len) {
        AudioClip clip = new AudioClip();
        clip.handle = AudioNative.zan_audio_load_wav_mem(data, len);
        return clip;
    }

    /// <summary>从内存字节解码 OGG Vorbis（背景音乐）。字节只在本次
    /// 调用内同步读取（PCM 会被拷出），返回后即可释放缓冲区。
    /// 失败时返回的对象 IsValid() 为 false。</summary>
    static AudioClip LoadOggFromMem(string data, int len) {
        AudioClip clip = new AudioClip();
        clip.handle = AudioNative.zan_audio_load_ogg_mem(data, len);
        return clip;
    }

    /// 加载成功时为真（失败时为假对象，不返回 null）。
    bool IsValid() { return this.handle != 0; }

    /// <summary>采样率（Hz）。</summary>
    int Frequency() { return AudioNative.zan_audio_clip_frequency(this.handle); }

    /// 声道数（1 单声道、2 立体声）。
    int Channels() { return AudioNative.zan_audio_clip_channels(this.handle); }

    /// 时长（毫秒）。
    int DurationMs() { return AudioNative.zan_audio_clip_duration_ms(this.handle); }

    /// <summary>用默认音量播一次。</summary>
    AudioVoice Play() {
        return this.Play(1.0, 0);
    }

    /// <summary>播一次。<paramref name="gain"/> 是这一个声音的音量，
    /// <paramref name="loop"/> 非 0 表示循环（背景音乐）。</summary>
    AudioVoice Play(double gain, int loop) {
        return AudioVoice.Of(AudioNative.zan_audio_play(this.handle, gain, loop));
    }

    /// <summary>循环播放，直到 <see cref="AudioVoice.Stop"/>。</summary>
    AudioVoice PlayLooping(double gain) {
        return this.Play(gain, 1);
    }

    /// <summary>释放采样，并停掉还在读它的声音。</summary>
    void Close() {
        if (this.handle != 0) {
            AudioNative.zan_audio_free_clip(this.handle);
            this.handle = 0;
        }
    }

    /// <summary>释放采样资源（实现 IDisposable，等同于 Close）。</summary>
    void Dispose() {
        this.Close();
    }
}

/// <summary>zan_audio 原生桥（音频随 zan_gui 运行时导出）。</summary>
class AudioNative {
    [DllImport("zan_gui")]
    static extern int zan_audio_open();

    [DllImport("zan_gui")]
    static extern void zan_audio_close();

    [DllImport("zan_gui")]
    static extern int zan_audio_is_open();

    [DllImport("zan_gui")]
    static extern void zan_audio_set_volume(double volume);

    [DllImport("zan_gui")]
    static extern double zan_audio_volume();

    [DllImport("zan_gui")]
    static extern string zan_audio_driver_name();

    [DllImport("zan_gui")]
    static extern int zan_audio_active_voices();

    [DllImport("zan_gui")]
    static extern void zan_audio_stop_all();

    [DllImport("zan_gui")]
    static extern string zan_audio_last_error();

    [DllImport("zan_gui")]
    static extern nint zan_audio_load_wav(string path);

    [DllImport("zan_gui")]
    static extern nint zan_audio_load_ogg(string path);

    [DllImport("zan_gui")]
    static extern nint zan_audio_load_wav_mem(string data, int len);

    [DllImport("zan_gui")]
    static extern nint zan_audio_load_ogg_mem(string data, int len);

    [DllImport("zan_gui")]
    static extern void zan_audio_free_clip(nint clip);

    [DllImport("zan_gui")]
    static extern int zan_audio_clip_frequency(nint clip);

    [DllImport("zan_gui")]
    static extern int zan_audio_clip_channels(nint clip);

    [DllImport("zan_gui")]
    static extern int zan_audio_clip_duration_ms(nint clip);

    [DllImport("zan_gui")]
    static extern long zan_audio_play(nint clip, double gain, int loop);

    [DllImport("zan_gui")]
    static extern int zan_audio_voice_playing(long voice);

    [DllImport("zan_gui")]
    static extern void zan_audio_voice_stop(long voice);

    [DllImport("zan_gui")]
    static extern void zan_audio_voice_set_gain(long voice, double gain);
}
