using System;

namespace System;

/// 泛型弱引用包装器（对齐 .NET System.WeakReference<T> 标准契约）。
/// 弱引用引用对象的同时允许 ARC 自动释放该对象。
/// 广泛应用于缓存、事件监听器、观察者列表与父子节点双向引用场景，
/// 根除强引用成环导致的内存泄漏。
public class WeakReference<T> {
    private weak T _target;

    public WeakReference(T target) {
        this._target = target;
    }

    public WeakReference(T target, bool trackResurrection) {
        this._target = target;
    }

    /// 获取或设置弱引用所引用的目标对象。若目标已被释放，返回 null。
    public T Target {
        get { return this._target; }
        set { this._target = value; }
    }

    /// 指示弱引用引用的目标对象是否仍然存活（未被释放且非 null）。
    public bool IsAlive {
        get { return this._target != null; }
    }

    /// 尝试获取被引用的目标对象。若目标对象存活，赋值给 target 并返回 true；若已释放返回 false。
    public bool TryGetTarget(out T target) {
        target = this._target;
        return target != null;
    }

    /// 设置新的引用目标对象。
    public void SetTarget(T target) {
        this._target = target;
    }
}
