using System;

namespace System;

// 当套接字操作失败时抛出（创建、绑定、监听、
// 连接失败），消息携带平台错误码（Windows 的
// WSAGetLastError / POSIX 的 errno）。<paramref name="code"/> 以
// 数值形式携带同一错误码，供程序检查而非解析消息文本。
public class SocketException : Exception {
    // 平台错误码（Windows 的 WSAGetLastError / POSIX 的 errno）。
    public int code;

    public SocketException() {
        this.code = 0;
        Message = "A socket operation encountered an error.";
    }

    public SocketException(int code) {
        this.code = code;
        Message = "Socket error code: " + Convert.ToString(code);
    }

    // 以平台错误码与消息构造。
    public SocketException(int code, string message) {
        this.code = code;
        Message = message;
    }

    // 平台原生错误码属性（遵循 .NET 生产级惯用命名）
    public int ErrorCode {
        get { return this.code; }
    }
}

// 当 HTTP 请求无法发送或完成时抛出
// （连接失败、TLS 握手失败）。
