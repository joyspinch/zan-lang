// GenRoute.zan -- System.Web 属性路由生成器(routegen.c 迁移)。
//
// 扫描单元里呈 Controller 形状的类,为每个公开 action 生成一个
// async HttpContext 蹦床(__h_<Controller>_<Action>)与一条
// app.Map(...) 注册(方法/路径/名称/元数据/参数文档),全部放进
// 合成的 __AttrRoutes 类。属性三层合并(类默认 → 方法覆盖),
// 请求参数从 action 体内的 this.In/InInt/Need/Paged 调用点发现——
// 调用本身就是参数的声明,没有第二处可声明。
//
// 本模块只消费 genmeta 导出的单元元数据(classes + calls),不碰 AST。
namespace System.Compiler;

/// 路由参数文档模型 (单一实体结构，彻底消灭并行 List 坏味道)
class RouteParamDoc {
    public string name;
    public string type;
    public bool required;
    public string def;
    public string desc;
    public string source;

    public RouteParamDoc(string name, string type, bool required, string def, string desc, string source) {
        this.name = name;
        this.type = type;
        this.required = required;
        this.def = def;
        this.desc = desc;
        this.source = source;
    }
}

/// 属性与约定路由生成器: 消费 genmeta 单元元数据, 合成 __AttrRoutes 路由注册源码。
class GenRoute {
    /// 输出容器: 合成源码与诊断写进这里(reply)。
    static JsonValue Reply;
    static Dict<string, JsonValue> ClassOf;   /* 类名 → 类 JSON */
    /// 输入的编译单元元数据(req.unit)。
    static JsonValue Unit;

    /* 属性元数据累积(prop → kind/sval):kind 0 int 1 bool 2 string 3 enum */
    static Dict<string, int> MetaKind;
    static Dict<string, string> MetaVal;
    static List<string> MetaOrder;            /* 插入序,保证 .Meta 输出顺序 */

    /* 参数文档(每个 action 重建: 聚合单记录结构) */
    static List<RouteParamDoc> ParamDocs;

    /* ctor 参数 → 属性名映射(编译期属性类的赋值扫描: O(1) 哈希字典) */
    static Dict<string, string> ParamToProp;

    /* 常量求值输出 */
    static int ConstKind;
    static string ConstSval;

    /* 模块单一初始化发现与继承 */
    static Dict<string, string> ModTitle;
    static Dict<string, string> ModIcon;
    static Dict<string, string> ModOrder;
    static Dict<string, string> ModNs;
    static List<string> ModKeys;

    /* reader 描述(rg_readers 表) */
    static string RType;
    static bool RRequired;
    static bool RHasDefault;
    static bool RHasLabel;
    static string RWhere;

    /// 按名字查类声明, 不存在返回 null。
    static JsonValue ClassGet(string name) {
        JsonValue v;
        if (GenRoute.ClassOf.TryGetValue(name, out v)) { return v; }
        return null;
    }

    /// 入口: 扫描全部控制器生成路由; 无路由或已有诊断时不产出。
    /// 产物是名为 __AttrRoutes 的合成源码(蹦床方法 + Register)。
    static void Run(JsonValue req, JsonValue reply) {
        GenRoute.Reply = reply;
        GenRoute.ClassOf = new Dict<string, JsonValue>();
        GenRoute.ModTitle = new Dict<string, string>();
        GenRoute.ModIcon = new Dict<string, string>();
        GenRoute.ModOrder = new Dict<string, string>();
        GenRoute.ModNs = new Dict<string, string>();
        GenRoute.ModKeys = new List<string>();

        GenRoute.Unit = req.Get("unit");
        if (GenRoute.Unit == null) { return; }
        JsonValue classes = GenRoute.Unit.Get("classes");
        if (classes != null && classes.IsArray()) {
            for (int i = 0; i < classes.Count(); i = i + 1) {
                JsonValue c = classes.At(i);
                GenRoute.ClassOf.Add(c.Str("name", ""), c);

                // 模块声明自动发现：凡标注 [AdminModule] 的类（模块清单类或模块级控制器）均作为模块事实源登记
                if (GenRoute.AttrNamed(c, "AdminModule")) {
                    string mkey = GenRoute.AttrNamedArg(c, "AdminModule", "Key");
                    if (mkey.Length == 0) {
                        mkey = GenRoute.AttrStringArg(c, "AdminModule");
                    }
                    if (mkey.Length == 0) {
                        string cn = c.Str("name", "");
                        if (cn.EndsWith("Module")) {
                            mkey = GenRoute.Lower(cn.Substring(0, cn.Length - 6));
                        } else {
                            mkey = GenRoute.ControllerToken(c);
                        }
                    }
                    if (mkey.Length > 0 && !GenRoute.ModTitle.ContainsKey(mkey)) {
                        string mtitle = GenRoute.AttrNamedArg(c, "AdminModule", "Title");
                        if (mtitle.Length == 0) { mtitle = GenRoute.AttrStringArg(c, "Description"); }
                        string micon = GenRoute.AttrNamedArg(c, "AdminModule", "Icon");
                        string morder = GenRoute.AttrNamedArg(c, "AdminModule", "Order");
                        string mns = c.Str("ns", "");

                        GenRoute.ModTitle.Add(mkey, mtitle);
                        GenRoute.ModIcon.Add(mkey, micon);
                        GenRoute.ModOrder.Add(mkey, morder);
                        GenRoute.ModNs.Add(mkey, mns);
                        GenRoute.ModKeys.Add(mkey);
                    }
                }
            }
        }
        StringBuilder handlers = new StringBuilder();
        StringBuilder reg = new StringBuilder();
        int nroutes = 0;
        if (classes != null && classes.IsArray()) {
            for (int i = 0; i < classes.Count(); i = i + 1) {
                JsonValue cls = classes.At(i);
                if (!GenRoute.IsController(cls)) { continue; }
                nroutes = nroutes + GenRoute.GenController(cls, handlers, reg);
            }
        }
        if (nroutes == 0 || GenCommon.HasError(GenRoute.Reply)) { return; }
        StringBuilder out0 = new StringBuilder();
        out0.Append("class __AttrRoutes {\n");
        out0.Append(handlers.ToString());
        out0.Append("    static void Register(WebApp app) {\n");
        out0.Append(reg.ToString());
        out0.Append("    }\n}\n");
        GenCommon.AddSource(GenRoute.Reply, "__AttrRoutes", out0);
    }

    /* ---- 字符串工具 ---- */

    /// 转义为 Zan 字符串字面量正文(与 routegen 的 rg_put_qstr 一致:
    /// 反斜杠/双引号/LF/CR/TAB 转义,其余原样)。
    static string Esc(string s) {
        if (s == null || s.Length == 0) { return ""; }
        StringBuilder b = new StringBuilder();
        int n = s.Length;
        int start = 0;
        for (int i = 0; i < n; i = i + 1) {
            int c = s[i] & 255;
            if (c == 92 || c == 34 || c == 10 || c == 13 || c == 9) {
                if (i > start) { b.Append(s.Substring(start, i - start)); }
                if (c == 92) { b.Append("\\\\"); }
                else if (c == 34) { b.Append("\\\""); }
                else if (c == 10) { b.Append("\\n"); }
                else if (c == 13) { b.Append("\\r"); }
                else if (c == 9) { b.Append("\\t"); }
                start = i + 1;
            }
        }
        if (n > start) {
            b.Append(s.Substring(start, n - start));
        }
        return b.ToString();
    }

    /// 小写(对应 C 的 lower_inplace)。
    static string Lower(string s) {
        if (s == null) { return ""; }
        return s.ToLower();
    }

    /// 十进制解析(rg_cval 的 sval 反推 ival)。
    static int Atoi(string s) {
        int v = 0;
        int i = 0;
        bool neg = false;
        if (s.Length > 0 && (s[0] & 255) == 45) { neg = true; i = 1; }
        while (i < s.Length) {
            int c = s[i] & 255;
            if (c < 48 || c > 57) { break; }
            v = v * 10 + (c - 48);
            i = i + 1;
        }
        if (neg) { v = 0 - v; }
        return v;
    }

    /* ---- 属性帮助 ---- */

    /// HTTP 动词属性名 → 动词,否则 ""。
    static string AttrHttpVerb(string n) {
        if (n == "HttpGet") { return "GET"; }
        if (n == "HttpPost") { return "POST"; }
        if (n == "HttpPut") { return "PUT"; }
        if (n == "HttpDelete") { return "DELETE"; }
        if (n == "HttpPatch") { return "PATCH"; }
        if (n == "HttpHead") { return "HEAD"; }
        if (n == "HttpOptions") { return "OPTIONS"; }
        return "";
    }

    /// 结构性属性(按结构解释,不进入用户元数据)。
    static bool AttrIsStructural(string n) {
        if (GenRoute.AttrHttpVerb(n).Length > 0) { return true; }
        if (n == "Route" || n == "ApiController" || n == "NonAction" ||
            n == "Tx" || n == "Opt" || n == "ReadOnly" ||
            n == "Description" || n == "AttributeUsage" ||
            n == "DllImport" || n == "StructLayout" || n == "Obsolete") {
            return true;
        }
        return false;
    }

    /// 声明 d(类/方法)上是否出现名为 nm 的属性。
    static bool AttrNamed(JsonValue d, string nm) {
        JsonValue attrs = d.Get("attrs");
        if (attrs == null || !attrs.IsArray()) { return false; }
        for (int i = 0; i < attrs.Count(); i = i + 1) {
            if (attrs.At(i).Str("name", "") == nm) { return true; }
        }
        return false;
    }

    /// 属性类上 <name>(...) 的全部字符串字面量参数;无则空表。
    static List<string> AttrStringArgs(JsonValue d, string nm) {
        List<string> outp = new List<string>();
        JsonValue attrs = d.Get("attrs");
        if (attrs == null || !attrs.IsArray()) { return outp; }
        for (int i = 0; i < attrs.Count(); i = i + 1) {
            JsonValue a = attrs.At(i);
            if (a.Str("name", "") != nm) { continue; }
            JsonValue args = a.Get("args");
            if (args == null || !args.IsArray()) { return outp; }
            for (int j = 0; j < args.Count(); j = j + 1) {
                JsonValue a0 = args.At(j);
                if (a0.Str("k", "") == "lit" && a0.Str("t", "") == "str") {
                    outp.Add(a0.Str("v", ""));
                }
            }
            return outp;
        }
        return outp;
    }

    /// 属性类上第一个 <name>(...) 的字符串参数;无则 ""。
    static string AttrStringArg(JsonValue d, string nm) {
        JsonValue attrs = d.Get("attrs");
        if (attrs == null || !attrs.IsArray()) { return ""; }
        for (int i = 0; i < attrs.Count(); i = i + 1) {
            JsonValue a = attrs.At(i);
            if (a.Str("name", "") != nm) { continue; }
            JsonValue args = a.Get("args");
            if (args != null && args.Count() >= 1) {
                JsonValue a0 = args.At(0);
                if (a0.Str("k", "") == "lit" && a0.Str("t", "") == "str") {
                    return a0.Str("v", "");
                }
            }
            return "";
        }
        return "";
    }

    /// 属性类上名为 attrName 的属性中指定命名参数 propName 的字符串值;无则 ""。
    static string AttrNamedArg(JsonValue d, string attrName, string propName) {
        JsonValue attrs = d.Get("attrs");
        if (attrs == null || !attrs.IsArray()) { return ""; }
        for (int i = 0; i < attrs.Count(); i = i + 1) {
            JsonValue a = attrs.At(i);
            if (a.Str("name", "") != attrName) { continue; }
            JsonValue args = a.Get("args");
            if (args == null || !args.IsArray()) { continue; }
            for (int j = 0; j < args.Count(); j = j + 1) {
                JsonValue arg = args.At(j);
                if (arg.Str("k", "") == "assign") {
                    JsonValue l = arg.Get("l");
                    JsonValue r = arg.Get("r");
                    if (l != null && l.Str("n", "") == propName && r != null) {
                        if (GenRoute.EvalConst(r)) {
                            return GenRoute.ConstSval;
                        }
                    }
                }
            }
        }
        return "";
    }

    /* ---- 控制器/action 识别 ---- */

    /// 类的 bases 里是否直接列出 basename(不递归)。
    static bool DerivesFrom(JsonValue cls, string basename) {
        JsonValue bases = cls.Get("bases");
        if (bases == null || !bases.IsArray()) { return false; }
        for (int i = 0; i < bases.Count(); i = i + 1) {
            string b = bases.At(i).AsString("");
            if (b == basename || b.StartsWith(basename + "<")) { return true; }
        }
        return false;
    }

    /// 类是否呈控制器形状: 名以 Controller 结尾、继承
    /// Controller/ApiController/CrudController, 或带 [Route]/[ApiController]。
    /// 抽象类与泛型原型类不直接生成路由分发器。
    static bool IsController(JsonValue cls) {
        if (cls.Bool("abstract", false)) { return false; }
        if (cls.Bool("generic", false)) { return false; }
        string nm = cls.Str("name", "");
        if (nm == "Controller" || nm == "ApiController" ||
            nm == "CrudController" || nm == "CurdController" ||
            nm == "BaseAdminController") {
            return false;
        }
        if (GenRoute.DerivesFrom(cls, "Controller")) { return true; }
        if (GenRoute.DerivesFrom(cls, "ApiController")) { return true; }
        if (GenRoute.DerivesFrom(cls, "CrudController")) { return true; }
        if (GenRoute.DerivesFrom(cls, "CurdController")) { return true; }
        if (GenRoute.DerivesFrom(cls, "BaseAdminController")) { return true; }
        if (GenRoute.AttrNamed(cls, "Route")) { return true; }
        if (GenRoute.AttrNamed(cls, "ApiController")) { return true; }
        if (GenRoute.AttrNamed(cls, "AdminAction")) { return true; }
        if (nm.EndsWith("Controller")) {
            string ns = cls.Str("ns", "");
            if (ns.StartsWith("Gui.") || ns.StartsWith("Game.") || ns == "Gui" || ns == "Game") {
                return false;
            }
            JsonValue bases = cls.Get("bases");
            if (bases != null && bases.IsArray() && bases.Count() > 0) {
                return true;
            }
        }
        return false;
    }

    /* ---- 显示名/模块名/token ---- */

    /// 原始(未改名)简单类名:nsresolve 会给重名控制器改名,但
    /// orig_name 保留源码名,路由/视图键保持可读。
    static string ControllerDisplay(JsonValue cls) {
        string orig = cls.Str("orig", "");
        if (orig.Length > 0) { return orig; }
        return cls.Str("name", "");
    }

    /// 模块 = 应用根命名空间之下的部分:第一个 '.' 之后的段
    /// ("ZanWeb.Admin.System" → "Admin.System";根命名空间为空)。
    static string ControllerModule(JsonValue cls) {
        string ns = cls.Str("ns", "");
        int dot = ns.IndexOf(".");
        if (dot >= 0) { return ns.Substring(dot + 1); }
        return "";
    }

    /// action 名的控制器半段:模块 + 源码名,与视图键同一个拼法。
    static string ControllerActionName(JsonValue cls, string disp, string mod) {
        if (mod.Length > 0) { return mod + "." + disp; }
        return disp;
    }

    /// 控制器 token = 原始类名去掉 "Controller" 后缀并小写。
    static string ControllerToken(JsonValue cls) {
        string nm = GenRoute.ControllerDisplay(cls);
        if (nm.EndsWith("Controller")) {
            nm = nm.Substring(0, nm.Length - 10);
        }
        return GenRoute.Lower(nm);
    }

    /// 自动解析控制器所属的管理模块（支持类自身标记、单一模块声明类匹配、命名空间与类名前缀匹配）
    static void ResolveModule(JsonValue cls, out string modKey, out string modTitle, out string modIcon, out string modOrder) {
        modKey = GenRoute.AttrNamedArg(cls, "AdminModule", "Key");
        if (modKey.Length == 0) { modKey = GenRoute.AttrStringArg(cls, "AdminModule"); }
        modTitle = GenRoute.AttrNamedArg(cls, "AdminModule", "Title");
        modIcon = GenRoute.AttrNamedArg(cls, "AdminModule", "Icon");
        modOrder = GenRoute.AttrNamedArg(cls, "AdminModule", "Order");

        if (modKey.Length > 0) { return; }

        string ns = cls.Str("ns", "");
        string cname = cls.Str("name", "");

        for (int i = 0; i < GenRoute.ModKeys.Count; i = i + 1) {
            string k = GenRoute.ModKeys[i];
            string mns;
            GenRoute.ModNs.TryGetValue(k, out mns);

            // 1. 同命名空间或子命名空间匹配 (如 Zan.Mvc.Admin.Web 归属于 Zan.Mvc.Admin)
            if (mns.Length > 0 && (ns == mns || ns.StartsWith(mns + "."))) {
                modKey = k;
                GenRoute.ModTitle.TryGetValue(k, out modTitle);
                GenRoute.ModIcon.TryGetValue(k, out modIcon);
                GenRoute.ModOrder.TryGetValue(k, out modOrder);
                return;
            }

            // 2. 命名空间段包含模块名 (如 App.Controller.Sys)
            string lns = GenRoute.Lower(ns);
            string lk = GenRoute.Lower(k);
            if (lns.IndexOf("." + lk) >= 0 || lns.EndsWith("." + lk)) {
                modKey = k;
                GenRoute.ModTitle.TryGetValue(k, out modTitle);
                GenRoute.ModIcon.TryGetValue(k, out modIcon);
                GenRoute.ModOrder.TryGetValue(k, out modOrder);
                return;
            }

            // 3. 类名前缀匹配 (如 SysUserController 匹配 sys 模块)
            string lcname = GenRoute.Lower(cname);
            if (lcname.StartsWith(lk) && lcname.Length > lk.Length) {
                modKey = k;
                GenRoute.ModTitle.TryGetValue(k, out modTitle);
                GenRoute.ModIcon.TryGetValue(k, out modIcon);
                GenRoute.ModOrder.TryGetValue(k, out modOrder);
                return;
            }
        }
    }

    /// 计算控制器的约定路由前缀 (namespace + class 组合，零注解按约定生效)
    static string DefaultClassRoute(JsonValue cls) {
        string explicitRoute = GenRoute.AttrStringArg(cls, "Route");
        if (explicitRoute.Length > 0) { return explicitRoute; }

        string ns = cls.Str("ns", "");
        List<string> segs = new List<string>();
        int start = 0;
        int nslen = ns.Length;
        for (int i = 0; i <= nslen; i = i + 1) {
            if (i == nslen || (ns[i] & 255) == 46) {
                if (i > start) {
                    string seg = GenRoute.Lower(ns.Substring(start, i - start));
                    if (seg != "app" && seg != "application" &&
                        seg != "controller" && seg != "controllers" &&
                        seg != "src" && seg != "source" &&
                        seg != "packages" && seg != "package" &&
                        seg != "zan" && seg != "mvc" && seg != "web") {
                        segs.Add(seg);
                    }
                }
                start = i + 1;
            }
        }

        string modKey;
        string modTitle;
        string modIcon;
        string modOrder;
        GenRoute.ResolveModule(cls, out modKey, out modTitle, out modIcon, out modOrder);
        if (modKey.Length > 0) {
            segs.Clear();
            segs.Add("admin");
            segs.Add(GenRoute.Lower(modKey));
        } else if (GenRoute.AttrNamed(cls, "AdminModule") ||
            GenRoute.DerivesFrom(cls, "BaseAdminController")) {
            bool hasAdmin = false;
            for (int si = 0; si < segs.Count; si = si + 1) {
                if (segs[si] == "admin") { hasAdmin = true; break; }
            }
            if (!hasAdmin) {
                segs.Insert(0, "admin");
            }
        }

        string tok = GenRoute.ControllerToken(cls);
        if (segs.Count > 0) {
            string lastSeg = segs[segs.Count - 1];
            if (tok.StartsWith(lastSeg) && tok.Length > lastSeg.Length) {
                tok = tok.Substring(lastSeg.Length);
            }
        }
        if (tok == "department") { tok = "dept"; }
        else if (tok == "operationlog") { tok = "log"; }

        StringBuilder route = new StringBuilder();
        for (int si = 0; si < segs.Count; si = si + 1) {
            route.Append("/");
            route.Append(segs[si]);
        }
        route.Append("/");
        route.Append(tok);
        return route.ToString();
    }

    /// 约定动词推断：若未显式标注动词属性，按方法名语义推导
    static string InferMethodVerb(string mname) {
        string lower = GenRoute.Lower(mname);
        if (lower.StartsWith("post") || lower.StartsWith("save") ||
            lower.StartsWith("add") || lower.StartsWith("insert") ||
            lower.StartsWith("edit") || lower.StartsWith("update") ||
            lower.StartsWith("del") || lower.StartsWith("remove") ||
            lower.StartsWith("field") || lower.StartsWith("upload") ||
            lower.IndexOf("delete") >= 0 || lower.IndexOf("remove") >= 0 ||
            lower.IndexOf("save") >= 0 || lower.IndexOf("update") >= 0) {
            return "POST";
        }
        return "GET";
    }

    /* ---- 路径拼装 ---- */

    /// 合并类/方法路由模板, 替换 [controller]/[action] token, 归一化
    /// 斜杠; 方法模板不以 / 开头且无 [action] 时追加 [action] 段。
    static string BuildPath(string clsTpl, string mTpl, string ctrlTok,
                            string actionTok) {
        string tpl;
        if (mTpl.StartsWith("/")) {
            tpl = mTpl;
        } else if (mTpl.Length > 0) {
            if (clsTpl.Length > 0) { tpl = clsTpl + "/" + mTpl; }
            else { tpl = mTpl; }
        } else {
            if (clsTpl.IndexOf("[action]") >= 0) {
                tpl = clsTpl;
            } else if (actionTok == "index") {
                tpl = clsTpl.Length > 0 ? clsTpl : "/";
            } else {
                tpl = clsTpl.Length > 0 ? clsTpl + "/[action]" : "/[action]";
            }
        }
        if (tpl.IndexOf("[action]") < 0 && !mTpl.StartsWith("/") && actionTok != "index") {
            if (tpl.EndsWith("/")) { tpl = tpl + "[action]"; }
            else { tpl = tpl + "/[action]"; }
        }
        /* token 替换 + 斜杠归一化 */
        StringBuilder sub = new StringBuilder();
        int i = 0;
        int n = tpl.Length;
        int start = 0;
        while (i < n) {
            if (n - i >= 12 && tpl.Substring(i, 12) == "[controller]") {
                if (i > start) { sub.Append(tpl.Substring(start, i - start)); }
                sub.Append(ctrlTok);
                i = i + 12;
                start = i;
            } else if (n - i >= 8 && tpl.Substring(i, 8) == "[action]") {
                if (i > start) { sub.Append(tpl.Substring(start, i - start)); }
                sub.Append(actionTok);
                i = i + 8;
                start = i;
            } else {
                i = i + 1;
            }
        }
        if (n > start) { sub.Append(tpl.Substring(start, n - start)); }
        /* 前导 '/'、折叠重复 '/'、去尾 '/' */
        StringBuilder out0 = new StringBuilder();
        out0.Append("/");
        bool prevSlash = true;
        string s = sub.ToString();
        int slen = s.Length;
        for (int j = 0; j < slen; j = j + 1) {
            int c = s[j] & 255;
            if (c == 47) {
                if (prevSlash) { continue; }
                out0.Append("/");
                prevSlash = true;
            } else {
                int segStart = j;
                while (j < slen && (s[j] & 255) != 47) { j = j + 1; }
                out0.Append(s.Substring(segStart, j - segStart));
                prevSlash = false;
                j = j - 1;
            }
        }
        string r = out0.ToString();
        while (r.Length > 1 && r.EndsWith("/")) {
            r = r.Substring(0, r.Length - 1);
        }
        return r;
    }

    /* ---- 编译期常量求值(genmeta 表达式树 → kind/sval) ---- */

    /// 枚举成员求值(仅需要名字;数值无消费者)。
    static bool EvalConst(JsonValue e) {
        GenRoute.ConstSval = "";
        if (e == null) { return false; }
        string k = e.Str("k", "");
        if (k == "lit") {
            string t = e.Str("t", "");
            if (t == "int") {
                GenRoute.ConstKind = 0;
                GenRoute.ConstSval = Convert.ToString(e.Int("v", 0));
                return true;
            }
            if (t == "bool") {
                GenRoute.ConstKind = 1;
                if (e.Bool("v", false)) { GenRoute.ConstSval = "true"; }
                else { GenRoute.ConstSval = "false"; }
                return true;
            }
            if (t == "str") {
                GenRoute.ConstKind = 2;
                GenRoute.ConstSval = e.Str("v", "");
                return true;
            }
            return false;
        }
        if (k == "mem") {
            JsonValue o = e.Get("o");
            if (o != null && o.Str("k", "") == "id") {
                GenRoute.ConstKind = 3;
                GenRoute.ConstSval = e.Str("n", "");
                return true;
            }
            return false;
        }
        if (k == "id") {
            GenRoute.ConstKind = 3;
            GenRoute.ConstSval = e.Str("n", "");
            return true;
        }
        if (k == "bin" && e.Str("op", "") == "|") {
            /* 枚举位的并(PermBit.Create | PermBit.Update):按名字拼成
             * "Create|Update"。编译期不需要知道枚举的数值——消费者知道
             * 每个名字是哪一位,这里只把"声明了哪几位"原样带过去。 */
            if (!GenRoute.EvalConst(e.Get("l"))) { return false; }
            if (GenRoute.ConstKind != 3) { return false; }
            string left = GenRoute.ConstSval;
            if (!GenRoute.EvalConst(e.Get("r"))) { return false; }
            if (GenRoute.ConstKind != 3) { return false; }
            GenRoute.ConstSval = left + "|" + GenRoute.ConstSval;
            return true;
        }
        if (k == "uni" && e.Str("op", "") == "-") {
            if (GenRoute.EvalConst(e.Get("o")) && GenRoute.ConstKind == 0) {
                string sv = GenRoute.ConstSval;
                if (sv.StartsWith("-")) { GenRoute.ConstSval = sv.Substring(1); }
                else if (sv != "0") { GenRoute.ConstSval = "-" + sv; }
                return true;
            }
            return false;
        }
        return false;
    }

    /* ---- 属性元数据合并 ---- */

    /// 把 ConstKind/ConstSval 写入元数据键 key; onlyAbsent 时键已存在
    /// 则跳过。首次插入顺序记录在 MetaOrder。
    static void MetaSet(string key, bool onlyAbsent) {
        string dummy;
        if (onlyAbsent && GenRoute.MetaVal.TryGetValue(key, out dummy)) {
            return;
        }
        if (GenRoute.MetaVal.ContainsKey(key)) { GenRoute.MetaVal.Remove(key); }
        GenRoute.MetaVal.Add(key, GenRoute.ConstSval);
        if (GenRoute.MetaKind.ContainsKey(key)) { GenRoute.MetaKind.Remove(key); }
        GenRoute.MetaKind.Add(key, GenRoute.ConstKind);
        bool seen = false;
        for (int i = 0; i < GenRoute.MetaOrder.Count; i = i + 1) {
            if (GenRoute.MetaOrder[i] == key) { seen = true; }
        }
        if (!seen) { GenRoute.MetaOrder.Add(key); }
    }

    /// 直接写入已求值的元数据键值(kind: 0=int, 1=bool, 2=str, 3=id/enum)
    static void MetaSetDirect(string key, string val, int kind) {
        if (GenRoute.MetaVal.ContainsKey(key)) { GenRoute.MetaVal.Remove(key); }
        GenRoute.MetaVal.Add(key, val);
        if (GenRoute.MetaKind.ContainsKey(key)) { GenRoute.MetaKind.Remove(key); }
        GenRoute.MetaKind.Add(key, kind);
        bool seen = false;
        for (int i = 0; i < GenRoute.MetaOrder.Count; i = i + 1) {
            if (GenRoute.MetaOrder[i] == key) { seen = true; break; }
        }
        if (!seen) { GenRoute.MetaOrder.Add(key); }
    }

    /// 键的元数据类别, 没有返回 -1。
    static int MetaGetKind(string key) {
        int k;
        if (GenRoute.MetaKind.TryGetValue(key, out k)) { return k; }
        return -1;
    }

    /// 键的元数据值, 没有返回 ""。
    static string MetaGetVal(string key) {
        string v;
        if (GenRoute.MetaVal.TryGetValue(key, out v)) { return v; }
        return "";
    }

    /// ctor 参数名 → 属性名映射 (O(1) 哈希查询), 没有返回 ""。
    static string PmapProp(string param) {
        string prop;
        if (GenRoute.ParamToProp.TryGetValue(param, out prop)) { return prop; }
        return "";
    }

    /// 应用一次属性用法到元数据:属性类默认值(仅缺省时)先,
    /// 用法的位置/命名参数后(总是覆盖)。
    static void ApplyAttr(JsonValue attr) {
        string base0 = attr.Str("name", "");
        JsonValue cls = GenRoute.ClassGet(base0);
        if (cls == null) { cls = GenRoute.ClassGet(base0 + "Attribute"); }
        if (cls != null && cls.Str("kind", "") != "class") { cls = null; }

        GenRoute.ParamToProp = new Dict<string, string>();
        JsonValue ctor = null;
        if (cls != null) {
            JsonValue ctors = cls.Get("ctors");
            if (ctors != null && ctors.IsArray() && ctors.Count() > 0) {
                ctor = ctors.At(0);
                JsonValue assigns = ctor.Get("assigns");
                if (assigns != null && assigns.IsArray()) {
                    for (int i = 0; i < assigns.Count(); i = i + 1) {
                        JsonValue a = assigns.At(i);
                        string prm = a.Str("param", "");
                        string prp = a.Str("prop", "");
                        if (prm.Length > 0 && !GenRoute.ParamToProp.ContainsKey(prm)) {
                            GenRoute.ParamToProp.Add(prm, prp);
                        }
                    }
                }
            }
            /* 属性/字段初始化默认值(仅缺省时) */
            JsonValue props = cls.Get("props");
            if (props != null && props.IsArray()) {
                for (int i = 0; i < props.Count(); i = i + 1) {
                    JsonValue p = props.At(i);
                    if (GenRoute.EvalConst(p.Get("init"))) {
                        GenRoute.MetaSet(p.Str("name", ""), true);
                    }
                }
            }
            /* ctor 参数默认值经 Prop=param 映射(仅缺省时) */
            if (ctor != null) {
                JsonValue ps = ctor.Get("params");
                if (ps != null && ps.IsArray()) {
                    for (int i = 0; i < ps.Count(); i = i + 1) {
                        JsonValue p = ps.At(i);
                        if (!p.Has("def")) { continue; }
                        string prop = GenRoute.PmapProp(p.Str("name", ""));
                        if (prop.Length == 0) { continue; }
                        if (GenRoute.EvalConst(p.Get("def"))) {
                            GenRoute.MetaSet(prop, true);
                        }
                    }
                }
            }
        }

        /* 用法参数(覆盖) */
        int posi = 0;
        JsonValue args = attr.Get("args");
        if (args != null && args.IsArray()) {
            for (int i = 0; i < args.Count(); i = i + 1) {
                JsonValue a = args.At(i);
                if (a.Str("k", "") == "assign") {
                    JsonValue l = a.Get("l");
                    JsonValue r = a.Get("r");
                    if (l != null && l.Str("k", "") == "id" &&
                        GenRoute.EvalConst(r)) {
                        GenRoute.MetaSet(l.Str("n", ""), false);
                    }
                } else {
                    /* 位置参数 → ctor 参数 → 属性 */
                    string prop = "";
                    if (ctor != null) {
                        JsonValue ps = ctor.Get("params");
                        if (posi < ps.Count()) {
                            prop = GenRoute.PmapProp(
                                ps.At(posi).Str("name", ""));
                        }
                    }
                    if (GenRoute.EvalConst(a) && prop.Length > 0) {
                        GenRoute.MetaSet(prop, false);
                    }
                    posi = posi + 1;
                }
            }
        }
    }

    /* ---- 请求参数发现 ---- */

    /// reader 名 → (type, required, has_default, has_label, where)。
    /// 返回 false 表示不是 reader。
    static bool ReaderFor(string name) {
        GenRoute.RRequired = false;
        GenRoute.RHasDefault = false;
        GenRoute.RHasLabel = false;
        GenRoute.RWhere = "query";
        if (name == "In") { GenRoute.RType = "string"; return true; }
        if (name == "InText") { GenRoute.RType = "string"; return true; }
        if (name == "InRaw") { GenRoute.RType = "string"; return true; }
        if (name == "InInt") { GenRoute.RType = "int"; GenRoute.RHasDefault = true; return true; }
        if (name == "InLong") { GenRoute.RType = "long"; GenRoute.RHasDefault = true; return true; }
        if (name == "InDouble") { GenRoute.RType = "number"; GenRoute.RHasDefault = true; return true; }
        if (name == "InBool") { GenRoute.RType = "bool"; GenRoute.RHasDefault = true; return true; }
        if (name == "HasIn") { GenRoute.RType = "bool"; return true; }
        if (name == "Need") { GenRoute.RType = "string"; GenRoute.RRequired = true; GenRoute.RHasLabel = true; return true; }
        if (name == "NeedText") { GenRoute.RType = "string"; GenRoute.RRequired = true; GenRoute.RHasLabel = true; return true; }
        if (name == "NeedInt") { GenRoute.RType = "int"; GenRoute.RRequired = true; GenRoute.RHasLabel = true; return true; }
        if (name == "NeedLong") { GenRoute.RType = "long"; GenRoute.RRequired = true; GenRoute.RHasLabel = true; return true; }
        if (name == "Param") { GenRoute.RType = "string"; GenRoute.RRequired = true; GenRoute.RWhere = "path"; return true; }
        return false;
    }

    /// 字面量参数原样输出;非字面量(动态默认值是代码,不是文档)为 ""。
    static string Literal(JsonValue e) {
        if (e == null) { return ""; }
        JsonValue o = e.Get("o");
        if (e.Str("k", "") == "uni" && e.Str("op", "") == "-" && o != null) {
            /* 仅前导负号有意义 */
            string ot = o.Str("t", "");
            if (ot == "int") { return Convert.ToString(-(long)o.Int("v", 0)); }
            if (ot == "double") { return Convert.ToString(0.0 - o.Double("v", 0.0)); }
            return "";
        }
        if (e.Str("k", "") != "lit") { return ""; }
        string t = e.Str("t", "");
        if (t == "int") { return Convert.ToString(e.Int("v", 0)); }
        if (t == "double") { return Convert.ToString(e.Double("v", 0.0)); }
        if (t == "bool") {
            if (e.Bool("v", false)) { return "true"; }
            return "false";
        }
        if (t == "str") { return e.Str("v", ""); }
        return "";
    }

    /// 记录一次输入调用发现的参数: 同名重复读按更强声明合并
    /// (必填/具体类型/默认与描述取先到者), 超过 64 个静默丢弃。
    static void ParamsAdd(JsonValue call) {
        if (GenRoute.ParamDocs.Count >= 64) { return; }
        JsonValue args = call.Get("args");
        if (args == null || args.Count() < 1) { return; }
        JsonValue a0 = args.At(0);
        if (a0.Str("k", "") != "lit" || a0.Str("t", "") != "str") { return; }
        string nm = a0.Str("v", "");
        if (nm.Length == 0) { return; }

        /* 同名参数读两次(一次带默认,一次必填):保留更强的声明,不重复 */
        for (int i = 0; i < GenRoute.ParamDocs.Count; i = i + 1) {
            RouteParamDoc doc = GenRoute.ParamDocs[i];
            if (doc.name != nm) { continue; }
            if (GenRoute.RRequired) { doc.required = true; }
            if (GenRoute.RHasLabel && args.Count() >= 2 && doc.desc.Length == 0) {
                doc.desc = GenRoute.Literal(args.At(1));
            }
            if (GenRoute.RHasDefault && args.Count() >= 2 && doc.def.Length == 0) {
                doc.def = GenRoute.Literal(args.At(1));
            }
            if (doc.type == "string") {
                doc.type = GenRoute.RType;
            }
            return;
        }

        string defVal = "";
        string descVal = "";
        if (args.Count() >= 2) {
            if (GenRoute.RHasDefault) { defVal = GenRoute.Literal(args.At(1)); }
            if (GenRoute.RHasLabel) { descVal = GenRoute.Literal(args.At(1)); }
        }
        GenRoute.ParamDocs.Add(new RouteParamDoc(nm, GenRoute.RType, GenRoute.RRequired, defVal, descVal, GenRoute.RWhere));
    }

    /// 参数名是否已登记。
    static bool ParamDocSeen(string nm) {
        for (int i = 0; i < GenRoute.ParamDocs.Count; i = i + 1) {
            if (GenRoute.ParamDocs[i].name == nm) { return true; }
        }
        return false;
    }

    /// 登记一个可选参数(query 来源; 同名已存在则跳过)。
    static void ParamAddOne(string nm, string ty, string desc, string def) {
        if (GenRoute.ParamDocs.Count >= 64) { return; }
        if (GenRoute.ParamDocSeen(nm)) { return; }
        GenRoute.ParamDocs.Add(new RouteParamDoc(nm, ty, false, def, desc, "query"));
    }

    /// this.Paged(defOrder, defLimit) 读每个列表屏共享的五个参数
    /// (Controller.Paged → ListQuery.From)。读发生在框架内部,因此
    /// 在这里展开唯一调用点——否则 /api/docs 会把列表端点描述成
    /// 不取任何参数。
    static void ParamsAddPaged(JsonValue call) {
        string def_order = "";
        string def_limit = "";
        JsonValue args = call.Get("args");
        if (args != null && args.Count() >= 1) {
            def_order = GenRoute.Literal(args.At(0));
        }
        if (args != null && args.Count() >= 2) {
            def_limit = GenRoute.Literal(args.At(1));
        }
        /* 同名显式读优先:已存在则跳过展开 */
        GenRoute.ParamAddOne("page", "int", "页码，从 1 开始", "1");
        GenRoute.ParamAddOne("limit", "int", "每页条数", def_limit);
        GenRoute.ParamAddOne("order", "string", "排序字段", def_order);
        GenRoute.ParamAddOne("dir", "string", "排序方向：desc 或 asc", "desc");
        GenRoute.ParamAddOne("kw", "string", "搜索关键词", "");
    }

    /// 扫描一个 action 方法体里的输入调用点(经 genmeta 的 calls 数组,
    /// 按所属类/方法过滤)。
    static void ScanCalls(string cls, string fn) {
        JsonValue calls = GenRoute.Unit.Get("calls");
        if (calls == null || !calls.IsArray()) { return; }
        for (int i = 0; i < calls.Count(); i = i + 1) {
            JsonValue call = calls.At(i);
            if (call.Str("cls", "") != cls) { continue; }
            if (call.Str("fn", "") != fn) { continue; }
        /* 接收者必须是控制器自身或它的 HttpContext:任何对象都可能有个
         * 叫 In() 的方法,都写进文档就是噪音。this / ctx / c 直接命中;
         * 接收者是调用时(recv="call#<id>")查它的表达式树,只有
         * `this.Ctx()`(名字为 Ctx 的调用)算数。 */
        string recv = call.Str("recv", "");
        bool ok = recv == "this" || recv == "id:ctx" || recv == "id:c";
        if (!ok && recv.StartsWith("call#")) {
            JsonValue rx = call.Get("recvx");
            if (rx != null && rx.IsObject()) {
                JsonValue rf = rx.Get("f");
                if (rx.Str("k", "") == "call" && rf != null &&
                    rf.IsObject() && rf.Str("k", "") == "mem" &&
                    rf.Str("n", "") == "Ctx") {
                    ok = true;
                }
            }
        }
        if (!ok) { continue; }
            string name = call.Str("name", "");
            if (GenRoute.ReaderFor(name)) {
                GenRoute.ParamsAdd(call);
            } else if (name == "Paged") {
                GenRoute.ParamsAddPaged(call);
            }
        }
    }

    /// 路由路径段也是参数,即使 action 从未在读取中命名它
    /// ("{id:int}" → id/int/path)。
    static void ParamsFromPath(string path) {
        int n = path.Length;
        int i = 0;
        while (i < n) {
            if ((path[i] & 255) != 123) { i = i + 1; continue; }
            int e = path.IndexOf("}", i);
            if (e < 0) { return; }
            string nm = path.Substring(i + 1, e - i - 1);
            string ty = "string";
            int colon = nm.IndexOf(":");
            if (colon >= 0) {
                string rest = nm.Substring(colon + 1);
                nm = nm.Substring(0, colon);
                if (rest == "int") { ty = "int"; }
                else if (rest == "long") { ty = "long"; }
            }
            bool seen = false;
            for (int j = 0; j < GenRoute.ParamDocs.Count; j = j + 1) {
                RouteParamDoc doc = GenRoute.ParamDocs[j];
                if (doc.name == nm) {
                    doc.source = "path";
                    doc.required = true;
                    seen = true;
                }
            }
            if (!seen && GenRoute.ParamDocs.Count < 64) {
                GenRoute.ParamDocs.Add(new RouteParamDoc(nm, ty, true, "", "", "path"));
            }
            i = e;
        }
    }

    /// 把参数文档表输出为注册链上的 .Param(...) 序列。
    static void EmitParams(StringBuilder out0) {
        for (int i = 0; i < GenRoute.ParamDocs.Count; i = i + 1) {
            RouteParamDoc doc = GenRoute.ParamDocs[i];
            out0.Append("\n            .Param(\"");
            out0.Append(GenRoute.Esc(doc.name));
            out0.Append("\", \"");
            out0.Append(doc.type);
            out0.Append("\", ");
            if (doc.required) { out0.Append("true"); }
            else { out0.Append("false"); }
            out0.Append(", \"");
            out0.Append(GenRoute.Esc(doc.def));
            out0.Append("\", \"");
            out0.Append(GenRoute.Esc(doc.desc));
            out0.Append("\", \"");
            out0.Append(doc.source);
            out0.Append("\")");
        }
    }

    /* ---- fluent 元数据输出 ---- */

    /// 把路由元数据输出为注册链上的 fluent 调用(Title/Auth/Menu/Lock/Upload/Limit/Meta)。
    static void EmitFluent(StringBuilder out0, string title) {
        if (title.Length > 0) {
            out0.Append(".Title(\"");
            out0.Append(GenRoute.Esc(title));
            out0.Append("\")");
        }

        /* Authorization 枚举 → 分发器在该 action 运行前的要求。
         * None/Auth 无所求(会话本来就为每个请求解析);Login 要求会话;
         * Grant -- 给 token 客户端的 ApiAuth -- 要求会话 AND 该 action
         * 的授权,而角色授予的正是这一个动作。声明 Grant 即完整声明
         * 一个页面的安全。 */
        if (GenRoute.MetaGetKind("Authorization") == 3) {
            string av = GenRoute.MetaGetVal("Authorization");
            if (av == "Login") { out0.Append(".Login()"); }
            else if (av == "Grant") { out0.Append(".Auth()"); }
            else if (av == "ApiAuth") { out0.Append(".Auth()"); }
        }
        /* IsMenu → 在管理菜单中呈现(路由上的布尔旗标)。 */
        if (GenRoute.MetaGetKind("IsMenu") == 1 &&
            GenRoute.MetaGetVal("IsMenu") == "true") {
            out0.Append(".Menu()");
        }
        /* 仅路由约定的可选属性:Lock → 请求锁范围,Upload → 流式上传。 */
        if (GenRoute.MetaGetKind("Lock") == 2 &&
            GenRoute.MetaGetVal("Lock").Length > 0) {
            out0.Append(".Lock(\"");
            out0.Append(GenRoute.Esc(GenRoute.MetaGetVal("Lock")));
            out0.Append("\")");
        }
        if (GenRoute.MetaGetKind("Upload") == 1 &&
            GenRoute.MetaGetVal("Upload") == "true") {
            out0.Append(".Upload()");
        }
        if (GenRoute.MetaGetKind("ApiMax") == 0 &&
            GenRoute.Atoi(GenRoute.MetaGetVal("ApiMax")) < 1000) {
            if (GenRoute.MetaGetKind("RateBy") == 2) {
                string scope = GenRoute.MetaGetVal("RateBy");
                if (scope == "uid" || scope == "ip") {
                    out0.Append(".LimitBy(");
                    out0.Append(GenRoute.MetaGetVal("ApiMax"));
                    out0.Append(", \"");
                    out0.Append(GenRoute.Esc(scope));
                    out0.Append("\")");
                } else {
                    out0.Append(".Limit(");
                    out0.Append(GenRoute.MetaGetVal("ApiMax"));
                    out0.Append(")");
                }
            } else {
                out0.Append(".Limit(");
                out0.Append(GenRoute.MetaGetVal("ApiMax"));
                out0.Append(")");
            }
        }

        /* 求值过的元数据全部忠实带过 */
        for (int i = 0; i < GenRoute.MetaOrder.Count; i = i + 1) {
            string key = GenRoute.MetaOrder[i];
            out0.Append(".Meta(\"");
            out0.Append(GenRoute.Esc(key));
            out0.Append("\", \"");
            out0.Append(GenRoute.Esc(GenRoute.MetaGetVal(key)));
            out0.Append("\")");
        }
    }

    /* ---- 控制器生成 ---- */

    /// 生成一个控制器的全部路由;返回路由数。
    static int GenController(JsonValue cls, StringBuilder handlers,
                             StringBuilder reg) {
        string cname = cls.Str("name", "");
        string ctrltok = GenRoute.ControllerToken(cls);
        string cmod = GenRoute.ControllerModule(cls);
        string cdisp = GenRoute.ControllerDisplay(cls);
        string cact = GenRoute.ControllerActionName(cls, cdisp, cmod);
        string clsTpl = GenRoute.DefaultClassRoute(cls);
        string clsDesc = GenRoute.AttrStringArg(cls, "Description");
        string modKey;
        string modTitle;
        string modIcon;
        string modOrder;
        GenRoute.ResolveModule(cls, out modKey, out modTitle, out modIcon, out modOrder);

        string clsActionKey = GenRoute.AttrNamedArg(cls, "AdminAction", "Key");
        if (clsActionKey.Length == 0) {
            clsActionKey = GenRoute.AttrStringArg(cls, "AdminAction");
        }
        if (clsActionKey.Length == 0) {
            clsActionKey = GenRoute.AttrNamedArg(cls, "Menu", "Key");
        }
        if (clsActionKey.Length == 0 && modKey.Length > 0) {
            string lastTok = ctrltok;
            if (lastTok.StartsWith(modKey) && lastTok.Length > modKey.Length) {
                lastTok = lastTok.Substring(modKey.Length);
            }
            if (lastTok == "department") { lastTok = "dept"; }
            else if (lastTok == "operationlog") { lastTok = "log"; }
            clsActionKey = modKey + ":" + lastTok;
        }

        string clsActionTitle = GenRoute.AttrNamedArg(cls, "AdminAction", "Title");
        if (clsActionTitle.Length == 0) {
            clsActionTitle = GenRoute.AttrNamedArg(cls, "Menu", "Title");
        }
        if (clsActionTitle.Length == 0) {
            clsActionTitle = clsDesc;
        }
        string clsActionIcon = GenRoute.AttrNamedArg(cls, "AdminAction", "Icon");
        if (clsActionIcon.Length == 0) {
            clsActionIcon = GenRoute.AttrNamedArg(cls, "Menu", "Icon");
        }
        if (clsActionIcon.Length == 0) {
            clsActionIcon = GenRoute.AttrStringArg(cls, "Menu");
        }
        string clsActionOrder = GenRoute.AttrNamedArg(cls, "AdminAction", "Order");
        if (clsActionOrder.Length == 0) {
            clsActionOrder = GenRoute.AttrNamedArg(cls, "Menu", "Order");
        }
        if (clsActionOrder.Length == 0) {
            clsActionOrder = GenRoute.AttrNamedArg(cls, "Custom", "Rank");
        }
        string clsActionIsMenu = GenRoute.AttrNamedArg(cls, "AdminAction", "IsMenu");
        if (clsActionIsMenu.Length == 0) {
            clsActionIsMenu = GenRoute.AttrNamedArg(cls, "Menu", "IsMenu");
        }
        /* 菜单是显式选择（[Menu]/[AdminAction]，或任意 [Custom(IsMenu=true)]）：
         * 类级 [Description] 只做文档与标题回退，不能把整个控制器默认刷进
         * 侧边栏——登录页、健康检查这类有描述的前台端点不是菜单项。 */
        if (clsActionIsMenu.Length == 0 && (GenRoute.AttrNamed(cls, "Menu") || GenRoute.AttrNamed(cls, "AdminAction"))) {
            clsActionIsMenu = "true";
        }
        int nroutes = 0;

        JsonValue methods = cls.Get("methods");
        if (methods == null || !methods.IsArray()) { return 0; }
        for (int mi = 0; mi < methods.Count(); mi = mi + 1) {
            JsonValue m = methods.At(mi);
            if (m.Bool("ctor", false)) { continue; }
            if (GenRoute.AttrNamed(m, "NonAction")) { continue; }

            string mname = m.Str("name", "");
            if (mname.StartsWith("_")) { continue; }

            /* 只有公开 action 成为路由 */
            if (m.Bool("private", false) || m.Bool("protected", false)) {
                continue;
            }

            /* 支持的形状:0 参数、单个 HttpContext 参数,或实例 action 的
             * 全可绑定签名(string/int/long/double/bool,或可表单化的
             * 类)——后者由蹦床按签名从请求绑定:基元逐参数,类参数
             * new 出来后按字段名逐字段(action 体里不再手写 In() 拉取)。 */
            JsonValue ps = m.Get("params");
            int np = ps != null ? ps.Count() : 0;
            bool ctxParam = false;
            if (np == 1 && ps.At(0).Str("type", "") == "HttpContext") {
                ctxParam = true;
            }
            bool bindable = np > 0 && !ctxParam &&
                !m.Bool("static", false) && GenRoute.BindableParams(ps);
            if (np != 0 && !ctxParam && !bindable) { continue; }

            string actiontok = GenRoute.Lower(mname);

            string verb = GenRoute.MethodVerb(m);
            if (verb.Length == 0) {
                verb = GenRoute.InferMethodVerb(mname);
            }

            string mTpl = GenRoute.AttrStringArg(m, "Route");
            string path = GenRoute.BuildPath(clsTpl, mTpl, ctrltok,
                                             actiontok);

            /* 三层元数据合并:类 → 方法(方法覆盖) */
            GenRoute.MetaKind = new Dict<string, int>();
            GenRoute.MetaVal = new Dict<string, string>();
            GenRoute.MetaOrder = new List<string>();
            JsonValue attrs = cls.Get("attrs");
            if (attrs != null && attrs.IsArray()) {
                for (int a = 0; a < attrs.Count(); a = a + 1) {
                    JsonValue at = attrs.At(a);
                    if (!GenRoute.AttrIsStructural(at.Str("name", ""))) {
                        GenRoute.ApplyAttr(at);
                    }
                }
            }
            /* 方法层合并前的 IsMenu 快照：两层共用一份 meta，之后据此判断
             * IsMenu 是否被方法显式改写（[Custom(IsMenu=...)] 等）——方法层
             * 显式标注必须原样生效，类级默认只在方法未表态时落笔。 */
            int menuKind0 = GenRoute.MetaGetKind("IsMenu");
            string menuVal0 = GenRoute.MetaGetVal("IsMenu");
            attrs = m.Get("attrs");
            if (attrs != null && attrs.IsArray()) {
                for (int a = 0; a < attrs.Count(); a = a + 1) {
                    JsonValue at = attrs.At(a);
                    if (!GenRoute.AttrIsStructural(at.Str("name", ""))) {
                        GenRoute.ApplyAttr(at);
                    }
                }
            }
            bool methodTouchedMenu = GenRoute.MetaGetKind("IsMenu") != menuKind0 ||
                GenRoute.MetaGetVal("IsMenu") != menuVal0;

            // 模块元数据自动注入路由 StrMap meta
            if (modKey.Length > 0) {
                GenRoute.MetaSetDirect("ModuleKey", modKey, 2);
                if (modTitle.Length > 0) { GenRoute.MetaSetDirect("ModuleTitle", modTitle, 2); }
                if (modIcon.Length > 0) { GenRoute.MetaSetDirect("ModuleIcon", modIcon, 2); }
                if (modOrder.Length > 0) { GenRoute.MetaSetDirect("ModuleOrder", modOrder, 0); }
            }

            // 控制器根动作（Index 或与控制器同名动作）自动继承类级菜单配置
            if (actiontok == "index") {
                if (clsActionKey.Length > 0) { GenRoute.MetaSetDirect("Key", clsActionKey, 2); }
                if (clsActionTitle.Length > 0) { GenRoute.MetaSetDirect("Title", clsActionTitle, 2); }
                if (clsActionIcon.Length > 0) { GenRoute.MetaSetDirect("Icon", clsActionIcon, 2); }
                if (clsActionOrder.Length > 0) { GenRoute.MetaSetDirect("Order", clsActionOrder, 0); }
                if (clsActionIsMenu == "true" && !methodTouchedMenu) {
                    GenRoute.MetaSetDirect("IsMenu", "true", 1);
                }
            } else {
                // 非根动作：只有方法自身显式标注菜单（[Custom(IsMenu=true)]、
                // [Menu]、[AdminAction(IsMenu=true)]）才进菜单；类级菜单配置
                // 只作用于根动作，方法未标注时强制不进，防止整组动作被
                // 批量刷成菜单项。
                bool methodHasMenu = (methodTouchedMenu &&
                        GenRoute.MetaGetKind("IsMenu") == 1 &&
                        GenRoute.MetaGetVal("IsMenu") == "true") ||
                    GenRoute.AttrNamed(m, "Menu") ||
                    (GenRoute.AttrNamed(m, "AdminAction") && GenRoute.AttrNamedArg(m, "AdminAction", "IsMenu") == "true");
                if (!methodHasMenu) {
                    GenRoute.MetaSetDirect("IsMenu", "false", 1);
                }
            }

            string mDesc = GenRoute.AttrStringArg(m, "Description");
            string title = mDesc.Length > 0 ? mDesc : (actiontok == "index" && clsActionTitle.Length > 0 ? clsActionTitle : clsDesc);

            bool isStatic = m.Bool("static", false);
            bool isAsync = m.Bool("async", false);
            string hname = "__h_" + cname + "_" + mname;
            string aw = isAsync ? "await " : "";
            string arg = ctxParam ? "ctx" : "";
            bool tx = !isStatic && (GenRoute.AttrNamed(m, "Tx") ||
                                    GenRoute.AttrNamed(cls, "Tx"));
            /* ReadOnly is deliberately method-only: GET and controller-level
             * defaults cannot assert an action has no writes/read-after-write. */
            bool readOnly = !isStatic && GenRoute.AttrNamed(m, "ReadOnly");
            if (readOnly && tx) {
                GenCommon.Fail(GenRoute.Reply, "[ReadOnly] and [Tx] cannot share an action: " + cname + "." + mname);
                continue;
            }
            /* 签名参数绑定:类型化 action 的实参在蹦床里生成,缺失或
             * 非法都在进 action 前以统一的 ApiError(400) 应答;
             * [Opt("名=默认")] 点名的参数改为缺省读,类参数按字段
             * 逐个绑定(请求未携带的字段保留声明时的初始值)。 */
            List<string> bindLines = new List<string>();
            List<RouteParamDoc> boundDocs = new List<RouteParamDoc>();
            Dict<string, string> opts = GenRoute.OptArgs(m);
            if (bindable) {
                arg = "";
                for (int pi = 0; pi < np; pi = pi + 1) {
                    string pt = ps.At(pi).Str("type", "");
                    string pn = ps.At(pi).Str("name", "");
                    if (pi > 0) { arg = arg + ", "; }
                    arg = arg + pn;
                    JsonValue fcls = GenRoute.FormClassOf(pt);
                    if (fcls != null) {
                        bindLines.Add("                " + pt + " " + pn +
                                      " = new " + pt + "();\n");
                        JsonValue fields = fcls.Get("fields");
                        if (fields != null && fields.IsArray()) {
                            for (int fi = 0; fi < fields.Count();
                                 fi = fi + 1) {
                                string ft = fields.At(fi).Str("type", "");
                                string fn = fields.At(fi).Str("name", "");
                                /* 静态字段不属于请求形态，也不能经实例写入；
                                 * 绑定它们生成的是必炸源码（曾以"静态字段被
                                 * 实例访问"报成幽灵行列错误）。 */
                                if (fields.At(fi).Bool("static", false)) { continue; }
                                if (!GenRoute.BindableType(ft)) { continue; }
                                string flabel = GenRoute.Esc(fn);
                                bindLines.Add("                if (__c.HasIn(\""
                                    + flabel + "\")) { " + pn + "." + fn
                                    + " = " + GenRoute.InCall(ft, flabel, "")
                                    + "; }\n");
                                boundDocs.Add(new RouteParamDoc(fn, ft, false, "", "", "form"));
                            }
                        }
                        continue;
                    }
                    if (opts.ContainsKey(pn)) {
                        string def = "";
                        string have = "";
                        if (opts.TryGetValue(pn, out have)) { def = have; }
                        bindLines.Add("                " +
                            GenRoute.OptBindLine(pt, pn, def) + "\n");
                        boundDocs.Add(new RouteParamDoc(pn, pt, false, def, "", "query"));
                        continue;
                    }
                    boundDocs.Add(new RouteParamDoc(pn, pt, true, "", "", "query"));
                    bindLines.Add("                " +
                                  GenRoute.BindLine(pt, pn) + "\n");
                }
            }

            /* 蹦床:async 以满足 async HttpHandler 委托(WebApp.Dispatch
             * await 它),让 action 能 await I/O 而不阻塞连接协程。 */
            handlers.Append("    static async void " + hname +
                            "(HttpContext ctx) {\n");
            if (isStatic) {
                handlers.Append("        try {\n");
                handlers.Append("            " + aw + cname + "." + mname +
                                "(" + arg + ");\n");
                handlers.Append("        } catch (ApiError __e) {\n");
                handlers.Append("            ctx.Status(__e.Status(), ApiError.Reason(__e.Status()));\n");
                handlers.Append("            ctx.Api(__e.Code(), __e.Message, \"null\");\n");
                handlers.Append("        }\n");
            } else {
                handlers.Append("        " + cname + " __c = new " + cname +
                                "();\n");
                handlers.Append("        __c.__Bind(ctx);\n");
                if (readOnly) {
                    handlers.Append("        __c.__UseReadOnly();\n");
                }
                /* 视图键 = action 名:同一个控制器半段,视图与权限不会分叉 */
                handlers.Append("        __c.__SetView(\"" + cact + "." +
                                mname + "\");\n");
                /* 必填参数以抛 ApiError 中止;在这里捕获,`this.Need(...)`。
                 * 从 Before 起进入 finally；失败时回滚/收尾不得覆盖原始错误。 */
                handlers.Append("        bool __failed = false;\n");
                if (tx) {
                    handlers.Append("        bool __tx = false;\n");
                }
                handlers.Append("        try {\n");
                handlers.Append("            if (await __c.__BeforeAsync()) {\n");
                if (tx) {
                    handlers.Append("                __tx = await __c.__TxBegin();\n");
                    handlers.Append("                if (!__tx) { throw new ApiError(503, \"0503\", \"服务不可用\"); }\n");
                }
                for (int bi = 0; bi < bindLines.Count; bi = bi + 1) {
                    handlers.Append(bindLines[bi]);
                }
                handlers.Append("                " + aw + "__c." + mname +
                                "(" + arg + ");\n");
                if (tx) {
                    handlers.Append("                await __c.__TxCommit();\n");
                }
                handlers.Append("            }\n");
                handlers.Append("        } catch (ApiError __e) {\n");
                handlers.Append("            __failed = true;\n");
                if (tx) {
                    handlers.Append("            if (__tx) {\n");
                    handlers.Append("                try { await __c.__TxRollback(); } catch (Exception __rollback) { }\n");
                    handlers.Append("            }\n");
                }
                handlers.Append("            ctx.Status(__e.Status(), ApiError.Reason(__e.Status()));\n");
                handlers.Append("            ctx.Api(__e.Code(), __e.Message, \"null\");\n");
                handlers.Append("        } catch (Exception __x) {\n");
                handlers.Append("            __failed = true;\n");
                if (tx) {
                    handlers.Append("            if (__tx) {\n");
                    handlers.Append("                try { await __c.__TxRollback(); } catch (Exception __rollback) { }\n");
                    handlers.Append("            }\n");
                }
                handlers.Append("            throw;\n");
                handlers.Append("        } finally {\n");
                handlers.Append("            try { await __c.__AfterAsync(); }\n");
                handlers.Append("            catch (Exception __cleanup) { if (!__failed) { throw; } }\n");
                handlers.Append("        }\n");
            }
            handlers.Append("    }\n");

            /* 注册 */
            reg.Append("        app.Map(\"" + verb + "\", \"");
            reg.Append(GenRoute.Esc(path));
            reg.Append("\", __AttrRoutes." + hname + ")\n            .Named(\"");
            reg.Append(GenRoute.Esc(cact));
            reg.Append(".");
            reg.Append(GenRoute.Esc(mname));
            reg.Append("\")");
            GenRoute.EmitFluent(reg, title);
            GenRoute.ParamDocs = new List<RouteParamDoc>();
            /* 签名绑定的参数进文档表(必填基元为 query 来源,[Opt] 带
             * 默认值,类参数的基元字段为 form 来源且一律可选);随后
             * ScanCalls/ParamsFromPath 对同名项做"强声明合并"。 */
            for (int si = 0; si < boundDocs.Count; si = si + 1) {
                GenRoute.ParamDocs.Add(boundDocs[si]);
            }
            GenRoute.ScanCalls(cname, mname);
            GenRoute.ParamsFromPath(path);
            GenRoute.EmitParams(reg);
            reg.Append(";\n");
            if (actiontok == "index" && mTpl.Length == 0 && path != clsTpl + "/index") {
                reg.Append("        app.Map(\"" + verb + "\", \"");
                reg.Append(GenRoute.Esc(clsTpl + "/index"));
                reg.Append("\", __AttrRoutes." + hname + ")\n            .Named(\"");
                reg.Append(GenRoute.Esc(cact));
                reg.Append(".IndexAlias\")");
                if (modKey.Length > 0) {
                    reg.Append("\n            .Meta(\"ModuleKey\", \"" + GenRoute.Esc(modKey) + "\")");
                }
                reg.Append(";\n");
            }
            nroutes = nroutes + 1;
        }
        return nroutes;
    }

    /// 方法上第一个 HTTP 动词属性名,无则 ""。
    static string FirstVerbAttr(JsonValue m) {
        JsonValue attrs = m.Get("attrs");
        if (attrs == null || !attrs.IsArray()) { return ""; }
        for (int i = 0; i < attrs.Count(); i = i + 1) {
            string n = attrs.At(i).Str("name", "");
            if (GenRoute.AttrHttpVerb(n).Length > 0) { return n; }
        }
        return "";
    }

    /// 方法上的 HTTP 动词(取第一个动词属性), 没有动词属性时返回 ""。
    static string MethodVerb(JsonValue m) {
        return GenRoute.AttrHttpVerb(GenRoute.FirstVerbAttr(m));
    }

    /// 参数类型能否由蹦床从请求绑定(string/int/long/double/bool,
    /// 或本单元内可表单化的类)。
    static bool BindableParams(JsonValue ps) {
        for (int i = 0; i < ps.Count(); i = i + 1) {
            string t = ps.At(i).Str("type", "");
            if (!GenRoute.BindableType(t) && GenRoute.FormClassOf(t) == null) {
                return false;
            }
        }
        return true;
    }

    /// 单个参数类型是否可绑定。
    static bool BindableType(string t) {
        return t == "string" || t == "int" || t == "long" ||
               t == "double" || t == "bool";
    }

    /* ---- 签名绑定:可选参数与表单→对象 ---- */

    /// 参数类型指向的表单类:本单元已知、是 class、能以无参构造
    /// (显式声明了无参构造,或根本没声明构造)。返回类 JSON,否则 null。
    static JsonValue FormClassOf(string t) {
        JsonValue cls = GenRoute.ClassGet(t);
        if (cls == null) { return null; }
        if (cls.Str("kind", "") != "class") { return null; }
        JsonValue methods = cls.Get("methods");
        bool hasCtor = false;
        if (methods != null && methods.IsArray()) {
            for (int i = 0; i < methods.Count(); i = i + 1) {
                JsonValue m = methods.At(i);
                if (!m.Bool("ctor", false)) { continue; }
                hasCtor = true;
                JsonValue cps = m.Get("params");
                if (cps != null && cps.Count() == 0) { return cls; }
            }
        }
        if (!hasCtor) { return cls; }
        return null;
    }

    /// [Opt("page=1","kw=")]:可选签名参数 name → default。
    static Dict<string, string> OptArgs(JsonValue m) {
        Dict<string, string> opt = new Dict<string, string>();
        List<string> args = GenRoute.AttrStringArgs(m, "Opt");
        for (int i = 0; i < args.Count; i = i + 1) {
            string a = args[i];
            int eq = a.IndexOf("=");
            string nm = eq >= 0 ? a.Substring(0, eq) : a;
            string dv = eq >= 0 ? a.Substring(eq + 1) : "";
            bool dup = false;
            foreach (string have in opt.Keys) {
                if (have == nm) { dup = true; break; }
            }
            if (!dup) { opt.Add(nm, dv); }
        }
        return opt;
    }

    /// In* 读表达式:string 走 In,其余带类型化默认。
    static string InCall(string t, string label, string def) {
        if (t == "int") {
            return "__c.InInt(\"" + label + "\", " +
                   Convert.ToString(GenRoute.Atoi(def)) + ")";
        }
        if (t == "long") {
            return "__c.InLong(\"" + label + "\", " +
                   Convert.ToString(GenRoute.Atoi(def)) + ")";
        }
        if (t == "double") {
            return "__c.InDouble(\"" + label + "\", " +
                   Convert.ToString(GenRoute.AtoD(def)) + ")";
        }
        if (t == "bool") {
            return "__c.InBool(\"" + label + "\", " +
                   (def == "true" ? "true" : "false") + ")";
        }
        return "__c.In(\"" + label + "\")";
    }

    /// 可选参数的绑定语句:[Opt("page=1")] 下的 `int page` 生成
    /// `int page = __c.InInt("page", 1);`——缺失取默认值,不再 400。
    static string OptBindLine(string t, string n, string def) {
        string label = GenRoute.Esc(n);
        string line = t + " " + n + " = " + GenRoute.InCall(t, label, def) + ";";
        if (t == "string" && def.Length > 0) {
            line = line + " if (" + n + ".Length == 0) { " + n + " = \"" +
                   GenRoute.Esc(def) + "\"; }";
        }
        return line;
    }

    /// 十进制小数字面量解析(默认值只可能是源码里写得出的简单形状)。
    static double AtoD(string s) {
        if (s == null || s.Length == 0) { return 0.0; }
        double v = 0.0;
        int i = 0;
        bool neg = false;
        if ((s[0] & 255) == 45) { neg = true; i = 1; }
        while (i < s.Length) {
            int c = s[i] & 255;
            if (c < 48 || c > 57) { break; }
            v = v * 10 + (c - 48);
            i = i + 1;
        }
        if (i < s.Length && (s[i] & 255) == 46) {
            i = i + 1;
            double frac = 1.0;
            while (i < s.Length) {
                int c2 = s[i] & 255;
                if (c2 < 48 || c2 > 57) { break; }
                frac = frac / 10.0;
                v = v + (c2 - 48) * frac;
                i = i + 1;
            }
        }
        if (neg) { v = 0.0 - v; }
        return v;
    }

    /// 一条绑定语句:`long id = __c.NeedLong("id", "id");`。必填语义:
    /// 缺失与非法同罪,都抛 ApiError(400),由蹦床统一应答——签名即文档,
    /// 文档表在注册段以同一份名字先行播种。
    static string BindLine(string t, string n) {
        string label = GenRoute.Esc(n);
        if (t == "int") {
            return "int " + n + " = __c.NeedInt(\"" + label + "\", \"" +
                   label + "\");";
        }
        if (t == "long") {
            return "long " + n + " = __c.NeedLong(\"" + label + "\", \"" +
                   label + "\");";
        }
        if (t == "double") {
            return "double " + n + " = __c.NeedDouble(\"" + label + "\", \"" +
                   label + "\");";
        }
        if (t == "bool") {
            return "bool " + n + " = __c.NeedBool(\"" + label + "\", \"" +
                   label + "\");";
        }
        return "string " + n + " = __c.Need(\"" + label + "\", \"" +
               label + "\");";
    }
}
