// GenScene.zan -- 游戏场景设计文档（.html 设计稿）→ 合成 partial class 的代码生成器。
// 等价迁移自 src/compiler/scenegen.c。
// 输入(design 请求的 files[i]):
// 接口数据协议与执行契约。
// 输出:reply.sources 里追加一段名为 name 的 .zan 源码。
namespace System.Compiler;

// 游戏场景设计文档到合成 partial class 的代码生成器。
// 入口是 <see cref="Translate"/>，由 design 请求分派 .html 场景文档进来。
class GenScene {
    // 翻译 design 请求里所有场景文件（.html 场景设计稿）：
    // 逐个解析、合成为 .zan 源码，经 GenCommon.AddSource 追加进
    // reply 的 sources；失败时写 reply 的 error 后返回。
    static void Translate(JsonValue req, JsonValue reply) {
        JsonValue files = req.Get("files");
        if (files == null) { return; }
        for (int i = 0; i < files.Count(); i = i + 1) {
            JsonValue f = files.At(i);
            string fname = f.Str("name", "");
            string flower = fname.ToLower();
            bool isHtmlExt = flower.EndsWith(".html") || flower.EndsWith(".htm");
            if (!isHtmlExt) { continue; }
            string text = f.Str("text", "");
            /* 对 .html 检查是否为场景设计文档（含 data-zan-scene 标记） */
            if (text.IndexOf("data-zan-scene") < 0 && text.IndexOf("<body data-scene") < 0) {
                continue;
            }
            bool emitMain = f.Bool("emitMain", false);
            StringBuilder outText = GenScene.TranslateOne(reply, text, fname, emitMain);
            if (outText == null) {
                if (!GenCommon.HasError(reply)) {
                    GenCommon.Fail(reply,
                        "cannot translate scene document '" + fname + "'");
                }
                return;
            }
            GenCommon.AddSource(reply, fname, outText);
        }
    }

    // 转义为可嵌入 .zan 字符串字面量正文的文本。
    // 与旧 scenegen 的 sg_esc 一致:反斜杠/双引号前置反斜杠、
    // LF -> \n、CR -> \r、TAB -> \t,其余原样(注意 CR 是保留的,
    // 与 GenCommon.Esc 不同)。
    static string Esc(string s) {
        if (s == null) { return ""; }
        int n = s.Length;
        if (n == 0) { return ""; }
        bool needEsc = false;
        for (int i = 0; i < n; i = i + 1) {
            int c = s[i] & 255;
            if (c == 92 || c == 34 || c == 10 || c == 13 || c == 9) {
                needEsc = true;
                break;
            }
        }
        if (!needEsc) { return s; }

        StringBuilder b = new StringBuilder();
        int start = 0;
        for (int i = 0; i < n; i = i + 1) {
            int c = s[i] & 255;
            if (c == 92 || c == 34 || c == 10 || c == 13 || c == 9) {
                if (i > start) {
                    b.Append(s.Substring(start, i - start));
                }
                if (c == 92) { b.Append("\\\\"); }
                else if (c == 34) { b.Append("\\\""); }
                else if (c == 10) { b.Append("\\n"); }
                else if (c == 13) { b.Append("\\r"); }
                else if (c == 9) { b.Append("\\t"); }
                start = i + 1;
            }
        }
        if (n > start) {
            b.Append(s.Substring(start, n - start));
        }
        return b.ToString();
    }

    // 读对象的整数属性:存在且为数字时取其值,否则返回 def。
    static int ObjNum(JsonValue o, string key, int def) {
        JsonValue v = o.Get(key);
        if (v != null && v.IsNumber()) { return v.AsInt(def); }
        return def;
    }

    // 读对象的字符串属性:缺省或非字符串返回 ""。
    static string ObjStr(JsonValue o, string key) {
        JsonValue v = o.Get(key);
        if (v != null && v.IsString()) { return v.AsString(""); }
        return "";
    }

    // 读对象的布尔属性:缺省或非布尔返回 def(与 GenForm 的
    // ObjBool 不同,这里允许指定缺省,如 visible 缺省 true)。
    static bool ObjBool(JsonValue o, string key, bool def) {
        JsonValue v = o.Get(key);
        if (v != null && v.IsBool()) { return v.AsBool(def); }
        return def;
    }

    // 数值数组属性的第 i 个分量("color"/"clearColor")。
    static int ArrNum(JsonValue o, string key, int i, int def) {
        JsonValue a = o.Get(key);
        if (a == null || !a.IsArray() || i >= a.Count()) { return def; }
        JsonValue v = a.At(i);
        if (v != null && v.IsNumber()) { return v.AsInt(def); }
        return def;
    }

    // 元素名是否已被用作静态字段名(重名元素改用局部变量)。
    static bool UsedHas(List<string> used, string n) {
        return used.Contains(n);
    }

    // 从 HTML 标签中提取属性值。
    static string ExtractAttr(string tag, string name) {
        if (tag == null || name == null) { return ""; }
        string pattern = " " + name + "=";
        int idx = tag.IndexOf(pattern);
        if (idx < 0) {
            pattern = "\t" + name + "=";
            idx = tag.IndexOf(pattern);
        }
        if (idx < 0) {
            pattern = "\n" + name + "=";
            idx = tag.IndexOf(pattern);
        }
        if (idx < 0) { return ""; }
        int valStart = idx + pattern.Length;
        if (valStart >= tag.Length) { return ""; }
        char quote = tag[valStart];
        if (quote == '"' || quote == '\'') {
            valStart = valStart + 1;
            int endIdx = tag.IndexOf(Convert.ToString(quote), valStart);
            if (endIdx < 0) { return ""; }
            string raw = tag.Substring(valStart, endIdx - valStart);
            return raw.Replace("&quot;", "\"").Replace("&lt;", "<").Replace("&gt;", ">").Replace("&amp;", "&");
        }
        int spaceIdx = tag.IndexOf(" ", valStart);
        int closeIdx = tag.IndexOf(">", valStart);
        int end = spaceIdx;
        if (end < 0 || (closeIdx >= 0 && closeIdx < end)) { end = closeIdx; }
        if (end < 0) { end = tag.Length; }
        return tag.Substring(valStart, end - valStart);
    }

    // 十进制串转整数，缺省返回 defVal。
    static int ParseInt(string s, int defVal) {
        if (s == null || s.Length == 0) { return defVal; }
        string t = s.Trim();
        if (t.Length == 0) { return defVal; }
        bool neg = false;
        int idx = 0;
        if (t[0] == '-') {
            neg = true;
            idx = 1;
        } else if (t[0] == '+') {
            idx = 1;
        }
        if (idx >= t.Length) { return defVal; }
        int val = 0;
        while (idx < t.Length) {
            char c = t[idx];
            if (c < '0' || c > '9') { return defVal; }
            val = val * 10 + ((int)c - (int)'0');
            idx = idx + 1;
        }
        return neg ? (0 - val) : val;
    }

    // 将 HTML 场景设计文档解析为 JsonValue 场景模型。
    static JsonValue HtmlToSceneJson(string html) {
        if (html == null || html.Length == 0) { return null; }
        int bodyStart = html.IndexOf("<body");
        if (bodyStart < 0) { return null; }
        int bodyTagEnd = html.IndexOf(">", bodyStart);
        if (bodyTagEnd < 0) { return null; }
        string bodyTag = html.Substring(bodyStart, bodyTagEnd - bodyStart);

        JsonValue root = JsonValue.NewObject();
        string sname = GenScene.ExtractAttr(bodyTag, "data-zan-scene");
        if (sname.Length == 0) { sname = GenScene.ExtractAttr(bodyTag, "data-scene"); }
        if (sname.Length == 0) { sname = GenScene.ExtractAttr(bodyTag, "id"); }
        root.Put("name", JsonValue.NewStr(sname));

        int dw = GenScene.ParseInt(GenScene.ExtractAttr(bodyTag, "data-design-width"), 1280);
        int dh = GenScene.ParseInt(GenScene.ExtractAttr(bodyTag, "data-design-height"), 720);
        root.Put("designWidth", JsonValue.NewNum(Convert.ToString(dw)));
        root.Put("designHeight", JsonValue.NewNum(Convert.ToString(dh)));

        int scaleMode = GenScene.ParseInt(GenScene.ExtractAttr(bodyTag, "data-scale-mode"), 0);
        root.Put("scaleMode", JsonValue.NewNum(Convert.ToString(scaleMode)));

        string winTitle = GenScene.ExtractAttr(bodyTag, "data-win-title");
        if (winTitle.Length > 0) { root.Put("winTitle", JsonValue.NewStr(winTitle)); }

        string bg = GenScene.ExtractAttr(bodyTag, "data-background");
        if (bg.Length > 0) { root.Put("background", JsonValue.NewStr(bg)); }

        string clearStr = GenScene.ExtractAttr(bodyTag, "data-clear-color");
        if (clearStr.Length > 0) {
            List<string> parts = clearStr.Split(",");
            if (parts.Count >= 3) {
                JsonValue carr = JsonValue.NewArray();
                carr.Append(JsonValue.NewNum(Convert.ToString(GenScene.ParseInt(parts[0], 18))));
                carr.Append(JsonValue.NewNum(Convert.ToString(GenScene.ParseInt(parts[1], 20))));
                carr.Append(JsonValue.NewNum(Convert.ToString(GenScene.ParseInt(parts[2], 32))));
                root.Put("clearColor", carr);
            }
        }

        JsonValue elems = JsonValue.NewArray();
        int searchPos = bodyTagEnd;
        int elemIdx = 1;
        while (searchPos < html.Length) {
            int divStart = html.IndexOf("<div", searchPos);
            if (divStart < 0) { break; }
            int divTagEnd = html.IndexOf(">", divStart);
            if (divTagEnd < 0) { break; }
            string divTag = html.Substring(divStart, divTagEnd - divStart);

            string ename = GenScene.ExtractAttr(divTag, "id");
            string kind = GenScene.ExtractAttr(divTag, "data-kind");
            if (kind.Length == 0) { kind = "panel"; }
            if (ename.Length == 0) { ename = kind + Convert.ToString(elemIdx); }
            elemIdx = elemIdx + 1;

            JsonValue el = JsonValue.NewObject();
            el.Put("name", JsonValue.NewStr(ename));
            el.Put("kind", JsonValue.NewStr(kind));
            el.Put("x", JsonValue.NewNum(Convert.ToString(GenScene.ParseInt(GenScene.ExtractAttr(divTag, "data-x"), 0))));
            el.Put("y", JsonValue.NewNum(Convert.ToString(GenScene.ParseInt(GenScene.ExtractAttr(divTag, "data-y"), 0))));
            el.Put("w", JsonValue.NewNum(Convert.ToString(GenScene.ParseInt(GenScene.ExtractAttr(divTag, "data-w"), 0))));
            el.Put("h", JsonValue.NewNum(Convert.ToString(GenScene.ParseInt(GenScene.ExtractAttr(divTag, "data-h"), 0))));
            el.Put("anchorX", JsonValue.NewNum(Convert.ToString(GenScene.ParseInt(GenScene.ExtractAttr(divTag, "data-anchor-x"), 0))));
            el.Put("anchorY", JsonValue.NewNum(Convert.ToString(GenScene.ParseInt(GenScene.ExtractAttr(divTag, "data-anchor-y"), 0))));
            el.Put("z", JsonValue.NewNum(Convert.ToString(GenScene.ParseInt(GenScene.ExtractAttr(divTag, "data-z"), 0))));

            string img = GenScene.ExtractAttr(divTag, "data-image");
            if (img.Length > 0) { el.Put("image", JsonValue.NewStr(img)); }
            string txt = GenScene.ExtractAttr(divTag, "data-text");
            if (txt.Length > 0) { el.Put("text", JsonValue.NewStr(txt)); }

            string colorStr = GenScene.ExtractAttr(divTag, "data-color");
            if (colorStr.Length > 0) {
                List<string> cp = colorStr.Split(",");
                if (cp.Count >= 4) {
                    JsonValue colArr = JsonValue.NewArray();
                    colArr.Append(JsonValue.NewNum(Convert.ToString(GenScene.ParseInt(cp[0], 255))));
                    colArr.Append(JsonValue.NewNum(Convert.ToString(GenScene.ParseInt(cp[1], 255))));
                    colArr.Append(JsonValue.NewNum(Convert.ToString(GenScene.ParseInt(cp[2], 255))));
                    colArr.Append(JsonValue.NewNum(Convert.ToString(GenScene.ParseInt(cp[3], 255))));
                    el.Put("color", colArr);
                }
            }

            int rows = GenScene.ParseInt(GenScene.ExtractAttr(divTag, "data-rows"), 1);
            int cols = GenScene.ParseInt(GenScene.ExtractAttr(divTag, "data-cols"), 1);
            int gapx = GenScene.ParseInt(GenScene.ExtractAttr(divTag, "data-gap-x"), 0);
            int gapy = GenScene.ParseInt(GenScene.ExtractAttr(divTag, "data-gap-y"), 0);
            if (rows > 1 || cols > 1 || gapx != 0 || gapy != 0) {
                el.Put("rows", JsonValue.NewNum(Convert.ToString(rows)));
                el.Put("cols", JsonValue.NewNum(Convert.ToString(cols)));
                el.Put("gapX", JsonValue.NewNum(Convert.ToString(gapx)));
                el.Put("gapY", JsonValue.NewNum(Convert.ToString(gapy)));
            }

            int val = GenScene.ParseInt(GenScene.ExtractAttr(divTag, "data-value"), 0);
            if (val != 0) { el.Put("value", JsonValue.NewNum(Convert.ToString(val))); }

            string items = GenScene.ExtractAttr(divTag, "data-items");
            if (items.Length > 0) { el.Put("items", JsonValue.NewStr(items)); }

            if (GenScene.ExtractAttr(divTag, "data-locked") == "true") { el.Put("locked", JsonValue.NewBool(true)); }

            string layer = GenScene.ExtractAttr(divTag, "data-layer");
            if (layer.Length > 0) { el.Put("layer", JsonValue.NewStr(layer)); }

            string cls = GenScene.ExtractAttr(divTag, "class");
            if (cls.Length > 0) { el.Put("class", JsonValue.NewStr(cls)); }

            int pos = GenScene.ParseInt(GenScene.ExtractAttr(divTag, "data-position"), 1);
            el.Put("position", JsonValue.NewNum(Convert.ToString(pos)));

            int flexGrow = GenScene.ParseInt(GenScene.ExtractAttr(divTag, "data-flex-grow"), 0);
            if (flexGrow > 0) { el.Put("flexGrow", JsonValue.NewNum(Convert.ToString(flexGrow))); }

            if (GenScene.ExtractAttr(divTag, "data-visible") == "false") { el.Put("visible", JsonValue.NewBool(false)); }

            string onClick = GenScene.ExtractAttr(divTag, "data-on-click");
            if (onClick.Length > 0) { el.Put("onClick", JsonValue.NewStr(onClick)); }

            elems.Append(el);
            searchPos = divTagEnd + 1;
        }

        root.Put("elements", elems);
        return root;
    }

    // 翻译单个场景设计文档（.html 场景设计稿）。解析失败返回 null。
    static StringBuilder TranslateOne(JsonValue reply, string content,
                                      string file_name, bool emit_main) {
        JsonValue root = null;
        if (content != null && (content.IndexOf("<body") >= 0 || content.IndexOf("data-zan-scene") >= 0 || content.IndexOf("<!doctype") >= 0)) {
            root = GenScene.HtmlToSceneJson(content);
        }
        if (root == null) {
            try {
                root = JsonValue.Parse(content);
            } catch (Exception ex) {
                return null;
            }
        }

        string name = GenScene.ObjStr(root, "name");
        if (!GenCommon.IsIdent(name)) {
            string base0 = file_name;
            if (base0 == null) { base0 = ""; }
            int slash = base0.LastIndexOf("/");
            int bslash = base0.LastIndexOf("\\");
            int p = 0;
            if (slash >= 0 && (bslash < 0 || slash > bslash)) { p = slash + 1; }
            else if (bslash >= 0) { p = bslash + 1; }
            string nm = base0.Substring(p);
            if (nm.EndsWith(".html")) { nm = nm.Substring(0, nm.Length - 5); }
            else if (nm.EndsWith(".htm")) { nm = nm.Substring(0, nm.Length - 4); }
            if (nm.Length > 127) { nm = nm.Substring(0, 127); }
            if (!GenCommon.IsIdent(nm)) { nm = "Scene"; }
            name = nm;
        }

        int dw = GenScene.ObjNum(root, "designWidth", 1280);
        if (dw <= 0) { dw = 1280; }
        int dh = GenScene.ObjNum(root, "designHeight", 720);
        if (dh <= 0) { dh = 720; }

        StringBuilder decls = new StringBuilder();
        StringBuilder body = new StringBuilder();
        List<string> used = new List<string>();

        JsonValue elems = root.Get("elements");
        int ecount = (elems != null && elems.IsArray()) ? elems.Count() : 0;
        for (int i = 0; i < ecount; i = i + 1) {
            JsonValue e = elems.At(i);
            if (e == null || !e.IsObject()) { continue; }
            string ename = GenScene.ObjStr(e, "name");
            string vn;
            if (GenCommon.IsIdent(ename) && !GenScene.UsedHas(used, ename)) {
                vn = ename;
                used.Add(ename);
                decls.Append("    static SceneElement " + vn + ";\n");
            } else {
                vn = "e" + Convert.ToString(i);
                body.Append("        SceneElement " + vn + ";\n");
            }
            body.Append("        " + vn + " = new SceneElement(\"");
            body.Append(GenScene.Esc(GenScene.ObjStr(e, "kind")));
            body.Append("\", \"");
            body.Append(GenScene.Esc(ename));
            body.Append("\");\n");
            body.Append("        " + vn + ".At(" +
                        Convert.ToString(GenScene.ObjNum(e, "x", 0)) + ", " +
                        Convert.ToString(GenScene.ObjNum(e, "y", 0)) + ");\n");
            body.Append("        " + vn + ".Size(" +
                        Convert.ToString(GenScene.ObjNum(e, "w", 0)) + ", " +
                        Convert.ToString(GenScene.ObjNum(e, "h", 0)) + ");\n");
            body.Append("        " + vn + ".AnchorTo(" +
                        Convert.ToString(GenScene.ObjNum(e, "anchorX", 0)) + ", " +
                        Convert.ToString(GenScene.ObjNum(e, "anchorY", 0)) + ");\n");
            body.Append("        " + vn + ".Order(" +
                        Convert.ToString(GenScene.ObjNum(e, "z", 0)) + ");\n");
            body.Append("        " + vn + ".Tint(" +
                        Convert.ToString(GenScene.ArrNum(e, "color", 0, 255)) + ", " +
                        Convert.ToString(GenScene.ArrNum(e, "color", 1, 255)) + ", " +
                        Convert.ToString(GenScene.ArrNum(e, "color", 2, 255)) + ", " +
                        Convert.ToString(GenScene.ArrNum(e, "color", 3, 255)) + ");\n");
            string img = GenScene.ObjStr(e, "image");
            if (img.Length > 0) {
                body.Append("        " + vn + ".Image(\"");
                body.Append(GenScene.Esc(img));
                body.Append("\");\n");
            }
            string text = GenScene.ObjStr(e, "text");
            if (text.Length > 0) {
                body.Append("        " + vn + ".Caption(\"");
                body.Append(GenScene.Esc(text));
                body.Append("\");\n");
            }
            int rows = GenScene.ObjNum(e, "rows", 0);
            int cols = GenScene.ObjNum(e, "cols", 0);
            int gapx = GenScene.ObjNum(e, "gapX", 0);
            int gapy = GenScene.ObjNum(e, "gapY", 0);
            if (rows > 0 || cols > 0 || gapx != 0 || gapy != 0) {
                body.Append("        " + vn + ".Grid(" +
                            Convert.ToString(rows) + ", " +
                            Convert.ToString(cols) + ", " +
                            Convert.ToString(gapx) + ", " +
                            Convert.ToString(gapy) + ");\n");
            }
            int value = GenScene.ObjNum(e, "value", 0);
            if (value != 0) {
                body.Append("        " + vn + ".SetValue(" +
                            Convert.ToString(value) + ");\n");
            }
            string items = GenScene.ObjStr(e, "items");
            if (items.Length > 0) {
                body.Append("        " + vn + ".SetItems(\"");
                body.Append(GenScene.Esc(items));
                body.Append("\");\n");
            }
            if (GenScene.ObjBool(e, "locked", false)) {
                body.Append("        " + vn + ".SetLocked(true);\n");
            }
            string layer = GenScene.ObjStr(e, "layer");
            if (layer.Length > 0) {
                body.Append("        " + vn + ".SetLayer(\"");
                body.Append(GenScene.Esc(layer));
                body.Append("\");\n");
            }
            if (GenScene.ObjStr(e, "onClick").Length > 0) {
                body.Append("        " + vn + ".On(\"Click\", \"");
                body.Append(GenScene.Esc(GenScene.ObjStr(e, "onClick")));
                body.Append("\");\n");
            }
            string cssClass = GenScene.ObjStr(e, "class");
            if (cssClass.Length > 0) {
                body.Append("        " + vn + ".SetCssClass(\"");
                body.Append(GenScene.Esc(cssClass));
                body.Append("\");\n");
            }
            int pos = GenScene.ObjNum(e, "position", 1);
            if (pos == 0) {
                body.Append("        " + vn + ".SetPosition(0);\n");
            }
            if (!GenScene.ObjBool(e, "visible", true)) {
                body.Append("        " + vn + ".SetVisible(false);\n");
            }
            body.Append("        d.Add(" + vn + ");\n");
        }

        StringBuilder out0 = new StringBuilder();
        out0.Append("// <auto-generated> compile-time projection of ");
        if (file_name == null) { out0.Append("(scene)"); } else { out0.Append(file_name); }
        out0.Append("\n");
        out0.Append("// The scene design document is the source of truth; put\n");
        out0.Append("// your initialization and game logic in " + name + ".zan.\n");
        out0.Append("using System;\n");
        out0.Append("using Gui;\n");
        out0.Append("using Game.Scene;\n\n");
        out0.Append("partial class " + name + " {\n");
        if (decls.Length > 0) { out0.Append(decls.ToString()); }
        out0.Append("    static SceneDoc scene;\n\n");
        out0.Append("    /// Builds the designed scene document (design-resolution tree).\n");
        out0.Append("    static SceneDoc BuildScene() {\n");
        out0.Append("        SceneDoc d = new SceneDoc(\"");
        out0.Append(GenScene.Esc(name));
        out0.Append("\", " + Convert.ToString(dw) + ", " +
                    Convert.ToString(dh) + ");\n");
        out0.Append("        d.SetMode(" +
                    Convert.ToString(GenScene.ObjNum(root, "scaleMode", 0)) +
                    ");\n");
        out0.Append("        d.SetClearColor(" +
                    Convert.ToString(GenScene.ArrNum(root, "clearColor", 0, 0)) + ", " +
                    Convert.ToString(GenScene.ArrNum(root, "clearColor", 1, 0)) + ", " +
                    Convert.ToString(GenScene.ArrNum(root, "clearColor", 2, 0)) + ");\n");
        string bg = GenScene.ObjStr(root, "background");
        if (bg.Length > 0) {
            out0.Append("        d.SetBackground(\"");
            out0.Append(GenScene.Esc(bg));
            out0.Append("\");\n");
        }
        if (body.Length > 0) { out0.Append(body.ToString()); }
        out0.Append("        return d;\n");
        out0.Append("    }\n\n");
        out0.Append("    /// Opens this designed scene and renders it until the window\n");
        out0.Append("    /// closes, so one design opens another with `" + name + ".Run();`.\n");
        out0.Append("    static void Run() {\n");
        out0.Append("        scene = BuildScene();\n");
        string wtitle = GenScene.ObjStr(root, "winTitle");
        if (wtitle.Length == 0) { wtitle = name; }
        out0.Append("        App app = App.CreateDark(\"");
        out0.Append(GenScene.Esc(wtitle));
        out0.Append("\", " + Convert.ToString(dw) + ", " +
                    Convert.ToString(dh) + ");\n");
        if (GenScene.ObjNum(root, "winCenter", 0) != 0) {
            out0.Append("        app.CenterWindow();\n");
        } else {
            out0.Append("        app.SetWindowPos(" +
                        Convert.ToString(GenScene.ObjNum(root, "winPosX", 0)) + ", " +
                        Convert.ToString(GenScene.ObjNum(root, "winPosY", 0)) + ");\n");
        }
        if (GenScene.ObjNum(root, "winResizable", 1) == 0) {
            out0.Append("        app.SetResizable(false);\n");
        }
        if (GenScene.ObjNum(root, "winChrome", 1) == 0) {
            out0.Append("        app.SetChromeVisible(false);\n");
        }
        out0.Append("        app.Show();\n");
        out0.Append("        " + name + ".OnLoad(app);\n");
        out0.Append("        scene.SetLayersActive(true);\n");
        out0.Append("        while (app.isRunning) {\n");
        out0.Append("            if (!app.ProcessEvent()) { break; }\n");
        out0.Append("            if (!app.needsRedraw) { continue; }\n");
        out0.Append("            app.BeginFrame();\n");
        out0.Append("            SceneView.Render(app, scene);\n");
        out0.Append("            SceneView.HandleClicks(app, scene);\n");
        out0.Append("            app.RenderChrome(\"");
        out0.Append(GenScene.Esc(wtitle));
        out0.Append("\");\n");
        out0.Append("            app.PresentFrame();\n");
        out0.Append("            if (scene.PendingScene().Length > 0) {\n");
        out0.Append("                app.RequestClose();\n");
        out0.Append("            }\n");
        out0.Append("        }\n");
        out0.Append("    }\n");
        if (emit_main) {
            // 接口数据协议与执行契约。
            out0.Append("\n    static void __DesignMain() {\n");
            out0.Append("        " + name + ".Run();\n");
            out0.Append("    }\n");
        }
        /* ---- IGameScene adapter ----------------------------------
         * 让设计好的场景直接接进 Game.Foundation.SceneStack：
         *     stack.Push(new <Name>Scene());
         * Enter 在宿主窗口里重建 SceneDoc 并开层过滤，Update(int)
         * 由 SceneStack.Update 逐帧调用（宿主先 Host(app) 把窗口
         * 交给适配器，帧体 = Render + HandleClicks），Exit 清状态。
         * 设计动作里的 OpenScene 在栈语境下由宿主处理：读
         * adapter.PendingScene() 后 Replace/Pop，ClearPendingScene
         * 消费。业务钩子 OnScene* 在代码后置 partial 里实现
         * （IDE 生成的业务壳带空实现）。 */
        out0.Append("\n    /// Adapts this designed scene to Game.Foundation.IGameScene\n");
        out0.Append("    /// so it plugs into a SceneStack directly:\n");
        out0.Append("    ///     var s = new " + name + "Scene();\n");
        out0.Append("    ///     stack.Push(s);\n");
        out0.Append("    ///     s.Host(app);          // once, before the loop\n");
        out0.Append("    ///     stack.Update(deltaMs); // per frame\n");
        out0.Append("    /// PendingScene() names the scene queued by an OpenScene\n");
        out0.Append("    /// action (the host decides how to switch);\n");
        out0.Append("    /// ClearPendingScene() consumes it.\n");
        out0.Append("    partial class " + name + "Scene : Game.Foundation.IGameScene {\n");
        out0.Append("        SceneDoc d;\n");
        out0.Append("        App host;\n\n");
        out0.Append("        public string Name() { return \"" + GenScene.Esc(name) + "\"; }\n\n");
        out0.Append("        /// Gives the adapter the host window; call once after\n");
        out0.Append("        /// the App exists, before the first Update.\n");
        out0.Append("        public void Host(App app) { host = app; }\n\n");
        out0.Append("        /// Rebuilds the design document for this entry.\n");
        out0.Append("        public void Enter() {\n");
        out0.Append("            d = " + name + ".BuildScene();\n");
        out0.Append("            d.SetLayersActive(true);\n");
        out0.Append("            " + name + ".OnSceneEnter();\n");
        out0.Append("        }\n\n");
        out0.Append("        public void Exit() {\n");
        out0.Append("            " + name + ".OnSceneExit();\n");
        out0.Append("            d = null;\n");
        out0.Append("        }\n\n");
        out0.Append("        public void Pause() { " + name + ".OnScenePause(); }\n\n");
        out0.Append("        public void Resume() { " + name + ".OnSceneResume(); }\n\n");
        out0.Append("        public void FixedUpdate(int deltaMilliseconds) {\n");
        out0.Append("            " + name + ".OnSceneFixedUpdate(deltaMilliseconds);\n");
        out0.Append("        }\n\n");
        out0.Append("        /// One frame: render + click dispatch on the live design\n");
        out0.Append("        /// into the host window (no-op while paused/without host).\n");
        out0.Append("        public void Update(int deltaMilliseconds) {\n");
        out0.Append("            if (d == null || host == null) { return; }\n");
        out0.Append("            if (!host.needsRedraw) { return; }\n");
        out0.Append("            host.BeginFrame();\n");
        out0.Append("            SceneView.Render(host, d);\n");
        out0.Append("            SceneView.HandleClicks(host, d);\n");
        out0.Append("            host.PresentFrame();\n");
        out0.Append("        }\n\n");
        out0.Append("        /// The live design document (null before Enter /\n");
        out0.Append("        /// after Exit): register click handlers here, e.g.\n");
        out0.Append("        ///     Doc().SetHandler(\"OnNext\", () => { ... });\n");
        out0.Append("        public SceneDoc Doc() { return d; }\n\n");
        out0.Append("        /// OpenScene 目标排队名（宿主负责切换与\n");
        out0.Append("        /// ClearPendingScene）；空 = 无。\n");
        out0.Append("        public string PendingScene() {\n");
        out0.Append("            return d == null ? \"\" : d.PendingScene();\n");
        out0.Append("        }\n");
        out0.Append("    }\n");
        out0.Append("}\n");
        return out0;
    }
}
