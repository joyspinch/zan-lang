using System;
using System.Json;
using System.Web;

namespace System.Compiler;

// GenHtml.zan -- .html 声明文档 → 建树类的代码生成器
// （WEB_GUI_ROADMAP P5）。与运行时 App.LoadHtml 共用 System.Web 的
// 解析记录（HtmlParser.Parse 的 WDoc/WNode）：编译期把 .html 展开
// 成纯建树代码，发布不携带 HTML 文本与解析器；动态装载仍走
// App.LoadHtml（同一解析器，同一几何）。
// 输入(design 请求的 files[i])：
// { "name": "ui.html", "text": "<html 文本>", "emitMain": 忽略 }
// 输出：reply.sources 里追加一段名为 name 的 .zan 源码，形态
// （ui.html → 类 UiHtml；类名 = 文件基名帕斯卡化 + Html 后缀）：
// public static string Css = "...<style> 与 style 属性收集...";
// }
// 调用方：`Control root = UiHtml.Build(handlers);` 之后自行
// `app.UseAppCss(UiHtml.Css)`（或并进自己的样式表）再挂树。
// 样式 scoping（Vue <style scoped> 同语义）：多份文档的 Css 合装
// 进同一张 app 表时，裸标签/类选择器会跨文档互中。生成期给每个
// 元素混入文档作用域类 zs-<基名>，并把文档 CSS 每个复合块补上
// 该类——规则只命中本文档的元素（System.Web.HtmlScope）。运行期挂载件
// （列表行模板等 Build 之外长出来的控件）不携作用域类，其样式
// 放皮肤层（全局通道）——与 Vue 的组件样式不泄漏子组件同一取舍。
// 生成依据是 WDoc.nodes 声明记录（tag/父下标/属性/文档序内容）——
// 与运行时同一次解析的产物，天然同构。本文件只依赖 System.Web
// 纯层（不能 using Gui：生成器 exe 的活名闭包会滤掉 Gui 的
// 传递依赖，UiDriver 的 Json.Serialize 编译不进来）。
public class GenHtml {
    // 翻译 design 请求里所有 .html/.htm 文件；失败写 reply 的 error。
    public static void Translate(JsonValue req, JsonValue reply) {
        JsonValue files = req.Get("files");
        if (files == null || !files.IsArray()) { return; }
        for (int i = 0; i < files.Count(); i = i + 1) {
            JsonValue f = files.At(i);
            string name = f.Str("name", "");
            string lower = name.ToLower();
            if (!lower.EndsWith(".html") && !lower.EndsWith(".htm")) {
                continue;
            }
            string text = f.Str("text", "");
            /* 设计器文档（body 带 data-zan-design 标记）归 GenForm 的
             * 窗体投影通道；这里只翻译运行期 HTML UI 建树文档。 */
            if (DesignerHtml.IsDesignDoc(text)) { continue; }
            WDoc wd = HtmlParser.Parse(text, "");
            StringBuilder outp = new StringBuilder();
            if (!Emit(name, wd, text, outp)) {
                GenCommon.Fail(reply, "GenHtml: cannot emit '" + name + "'");
                return;
            }
            GenCommon.AddSource(reply, name, outp);
        }
    }

    public static bool Emit(string path, WDoc wd, string text, StringBuilder outp) {
        string cls = ClassName(path);
        if (cls == "") { return false; }
        // 行内 style 预扫：合成 .zgen-N 规则并进 Css 字面量（与运行时
        // Html.Build 同一编号顺序——按记录序），EmitNode 按 genCls 发射
        // AddClass。HTML 属性重复名取首个，一节点至多一条规则。
        string css = wd.css;
        List<string> genCls = new List<string>();
        for (int i = 0; i < wd.nodes.Count; i = i + 1) {
            WNode n = wd.nodes[i];
            string g = "";
            for (int k = 0; k < n.attrs.Count; k = k + 1) {
                if (n.attrs[k].name != "style") { continue; }
                g = "zgen-" + Convert.ToString(genCls.Count);
                css = css + "." + g + " { " + n.attrs[k].val + " }\n";
                break;
            }
            genCls.Add(g);
        }
        // 文档作用域类：元素与 CSS 同源混入（见类注释与 HtmlScope.Styles）。
        string zs = ScopeClassOf(path);
        css = HtmlScope.Styles(css, zs);
        StringBuilder b = new StringBuilder();        GenCommon.Line(b, 0, "// 由 GenHtml 从 " + BaseName(path)
                             + " 生成 -- 编译期产物,勿手改。");
        GenCommon.Line(b, 0, "using System;");
        GenCommon.Line(b, 0, "using Gui;");
        GenCommon.Line(b, 0, "using Gui.Widget;");
        GenCommon.Line(b, 0, "using Gui.Component;");
        GenCommon.Line(b, 0, "using Gui.Component.DataTable;");
        GenCommon.Line(b, 0, "");
        GenCommon.Line(b, 0, "public class " + cls + " {");
        GenCommon.Line(b, 1, "/// <style>、<link> 与 style 属性收集的 CSS，已按文档"
                           + "作用域类 " + zs + " 收窄（只命中本文档元素）："
                           + "装载时并进 appCss（UseAppCss）。");
        // 值超长（整套应用样式随文档走）时拆成多段字面量相加，绕开
        // 单字面量 4095 字符的词法上限——与 GenForm.EmitSetProp 同一
        // 配方（超限字面量会让整个字段声明解析失败而 Build 还在，
        // 表现为“类有 Build 没 Css”的怪象）。
        string cssLit = "";
        int cssAt = 0;
        while (cssAt < css.Length) {
            int take = css.Length - cssAt;
            if (take > 3000) { take = 3000; }
            if (cssAt > 0) { cssLit = cssLit + " + "; }
            cssLit = cssLit + "\"" + GenCommon.Esc(css.Substring(cssAt, take))
                + "\"";
            cssAt = cssAt + take;
        }
        // 无样式文档（不带 <style> 的片段）css 为空：必须落合法的
        // 空字面量，裸 `Css = ;` 整个生成类解析失败。
        if (cssLit == "") { cssLit = "\"\""; }
        GenCommon.Line(b, 1, "public static string Css = " + cssLit + ";");
        GenCommon.Line(b, 1, "");
        // 文档原文（运行期装载通道用）：同一份 .html 既能编译期建树，
        // 也能在运行期经 app.LoadHtmlWith(XxxHtml.Doc, null, dir) 重新
        // 装载——运行期那棵树的样式自动并进 appCss（不必再手工把各
        // 文档的 Css 拼进同一次 UseAppCss），且能挂模型宿主，绑定
        // 声明（data-bind / data-if / data-for）照常生效。
        // 成员名不叫 Html：生成代码里用 `Html.AddChild(...)` 调
        // Gui.Html 的静态方法，同名成员会把那个名字解析成字符串
        // 字段（"type 'string' has no method 'AddChild'"）。
        GenCommon.Line(b, 1, "/// 文档原文（运行期装载通道用）："
                           + "app.LoadHtmlWith(" + cls + ".Doc, null, baseDir)。");
        string docLit = "";
        List<string> chunks = GenHtml.Chunks(text, 3000);
        for (int i = 0; i < chunks.Count; i = i + 1) {
            if (i > 0) { docLit = docLit + " + "; }
            docLit = docLit + "\"" + GenCommon.Esc(chunks[i]) + "\"";
        }
        if (docLit == "") { docLit = "\"\""; }
        GenCommon.Line(b, 1, "public static string Doc = " + docLit + ";");
        GenCommon.Line(b, 1, "");
        GenCommon.Line(b, 1, "/// 构建树。handlers：data-on-* 注册表"
                           + "（可 null）。\n"
                           + "    public static Control Build("
                           + "HtmlHandlers handlers) {");
        for (int i = 0; i < wd.nodes.Count; i = i + 1) {
            EmitDecl(b, wd, wd.nodes[i], i, genCls[i], zs);
        }
        // 内容游走：逐父按 items 文档序发射 AddText / AddChild——
        // 与运行时 Html.Parse 的装配同一顺序，混排行盒靠它同构。
        for (int i = 0; i < wd.nodes.Count; i = i + 1) {
            EmitContent(b, wd, wd.nodes[i], i);
        }
        for (int i = 0; i < wd.nodes.Count; i = i + 1) {
            EmitWiring(b, wd.nodes[i], i);
        }
        GenCommon.Line(b, 2, "return v0;");
        GenCommon.Line(b, 1, "}");
        GenCommon.Line(b, 0, "}");
        outp.Append(b.ToString());
        return true;
    }

    // 按 UTF-8 字符边界把文本切成若干段（每段 <= limit 字节）。
    // 切点必须落在字符的起始字节上：Zan 的 string 是 UTF-8 字节序列，
    // 从续字节（10xxxxxx）切开会产出非法片段——中文被劈成两半，装载后
    // 整段解析失真（看起来像"文档莫名其妙少了几行"）。
    static List<string> Chunks(string s, int limit) {
        List<string> parts = new List<string>();
        if (s == null || s.Length == 0) { return parts; }
        int n = s.Length;
        int start = 0;
        while (start < n) {
            int end = start + limit;
            if (end >= n) {
                end = n;
            } else {
                while (end > start && GenHtml.IsContinuation(s[end])) { end = end - 1; }
            }
            parts.Add(s.Substring(start, end - start));
            start = end;
        }
        return parts;
    }

    // UTF-8 续字节（10xxxxxx）。
    static bool IsContinuation(int b) {
        int c = b & 255;
        return c >= 128 && c <= 191;
    }

    // 一条记录 = 一个变量的声明 + 属性协议（构造；文本与挂树在
    // EmitContent 按文档序发射）。
    static void EmitDecl(StringBuilder b, WDoc wd, WNode n, int idx, string genCls,
                         string zs) {
        string v = "v" + idx;
        string tag = n.tag;
        string id = GenCommon.Esc(HtmlText.NodeAttr(n.attrs, "id"));
        string type = HtmlText.NodeAttr(n.attrs, "type").ToLower();
        // 生成物里的控件类型一律发射命名空间限定名：生成类
        // 落在全局命名空间，裸 `new Button()` 会优先绑定到用户项目的
        // 同名全局类（全局声明压过 using import），限定名
        // 确保始终解析到 stdlib 真身。
        switch (tag) {
            case "button":
                GenCommon.Line(b, 2, "Gui.Widget.Button " + v
                               + " = new Gui.Widget.Button();");
                GenCommon.Line(b, 2, v + ".InitButton(\""
                               + GenCommon.Esc(n.text) + "\");");
                break;
            case "textarea":
                GenCommon.Line(b, 2, "Gui.Widget.TextArea " + v
                               + " = new Gui.Widget.TextArea();");
                GenCommon.Line(b, 2, v + ".InitTextArea(new SignalString(\""
                               + GenCommon.Esc(n.text) + "\"), \"\");");
                break;
            case "input":
                switch (type) {
                    case "checkbox":
                        GenCommon.Line(b, 2, "Gui.Widget.Checkbox " + v
                                       + " = new Gui.Widget.Checkbox();");
                        GenCommon.Line(b, 2, v + ".InitCheckbox(\"\", "
                                       + "new SignalBool(false));");
                        break;
                    case "radio":
                        GenCommon.Line(b, 2, "Gui.Widget.Radio " + v
                                       + " = new Gui.Widget.Radio();");
                        GenCommon.Line(b, 2, v + ".InitRadio(\"\", "
                                       + "new SignalBool(false));");
                        break;
                    case "range":
                        GenCommon.Line(b, 2, "Gui.Widget.Slider " + v
                                       + " = new Gui.Widget.Slider();");
                        break;
                    case "color":
                        GenCommon.Line(b, 2, "Gui.Widget.ColorPicker " + v
                                       + " = new Gui.Widget.ColorPicker();");
                        break;
                    case "date":
                    case "time":
                    case "month":
                        GenCommon.Line(b, 2, "Gui.Widget.DatePicker " + v
                                       + " = new Gui.Widget.DatePicker();");
                        break;
                    case "number":
                        GenCommon.Line(b, 2, "Gui.Widget.InputNumber " + v
                                       + " = new Gui.Widget.InputNumber();");
                        break;
                    case "file":
                        GenCommon.Line(b, 2, "Gui.Widget.Upload " + v
                                       + " = new Gui.Widget.Upload();");
                        break;
                    default:
                        string val = HtmlText.NodeAttr(n.attrs, "value");
                        string ph = HtmlText.NodeAttr(n.attrs, "placeholder");
                        GenCommon.Line(b, 2, "Gui.Widget.Input " + v
                                       + " = new Gui.Widget.Input();");
                        GenCommon.Line(b, 2, v + ".InitInput(new SignalString(\""
                                       + GenCommon.Esc(val) + "\"), \""
                                       + GenCommon.Esc(ph) + "\");");
                        if (type == "password") {
                            GenCommon.Line(b, 2, v + ".SetProp(\"password\", \"true\");");
                        }
                        break;
                }
                break;
            case "img":
                string src = HtmlText.NodeAttr(n.attrs, "src");
                string alt = HtmlText.NodeAttr(n.attrs, "alt");
                GenCommon.Line(b, 2, "Gui.Widget.Image " + v
                               + " = new Gui.Widget.Image();");
                GenCommon.Line(b, 2, v + ".InitImage(\""
                               + GenCommon.Esc(src) + "\", \""
                               + GenCommon.Esc(alt) + "\", \"cover\");");
                break;
            case "select":
            case "selectbox":
            case "zan-select-box":
                GenCommon.Line(b, 2, "Gui.Widget.SelectBox " + v
                               + " = new Gui.Widget.SelectBox();");
                string opts = HtmlText.NodeAttr(n.attrs, "options");
                int selIdx = -1;
                int oi = 0;
                bool hasCustomVal = false;
                for (int k = 0; k < n.items.Count; k = k + 1) {
                    WItem it = n.items[k];
                    if (it.kid < 0) { continue; }
                    WNode cn = wd.nodes[it.kid];
                    if (cn.tag != "option") { continue; }
                    string vAttr = HtmlText.NodeAttr(cn.attrs, "value");
                    if (vAttr != "") { hasCustomVal = true; break; }
                }
                if (hasCustomVal) {
                    JsonValue arr = JsonValue.NewArray();
                    for (int k = 0; k < n.items.Count; k = k + 1) {
                        WItem it = n.items[k];
                        if (it.kid < 0) { continue; }
                        WNode cn = wd.nodes[it.kid];
                        if (cn.tag != "option") { continue; }
                        string ot = cn.text.Trim();
                        string valAttr = HtmlText.NodeAttr(cn.attrs, "value");
                        if (valAttr == "") { valAttr = ot; }
                        for (int q = 0; q < cn.attrs.Count; q = q + 1) {
                            if (cn.attrs[q].name == "selected") { selIdx = oi; }
                        }
                        JsonValue optObj = JsonValue.NewObject();
                        optObj.Set("label", JsonValue.NewStr(ot));
                        optObj.Set("value", JsonValue.NewStr(valAttr));
                        arr.Append(optObj);
                        oi = oi + 1;
                    }
                    if (arr.Count() > 0) {
                        GenCommon.Line(b, 2, v + ".SetProp(\"options\", \"" + GenCommon.Esc(arr.ToJson()) + "\");");
                    }
                } else {
                    for (int k = 0; k < n.items.Count; k = k + 1) {
                        WItem it = n.items[k];
                        if (it.kid < 0) { continue; }
                        WNode cn = wd.nodes[it.kid];
                        if (cn.tag != "option") { continue; }
                        string ot = cn.text.Trim();
                        for (int q = 0; q < cn.attrs.Count; q = q + 1) {
                            if (cn.attrs[q].name == "selected") { selIdx = oi; }
                        }
                        if (ot != "") {
                            if (opts != "") { opts = opts + "|"; }
                            opts = opts + ot;
                        }
                        oi = oi + 1;
                    }
                    if (opts != "") {
                        GenCommon.Line(b, 2, v + ".SetProp(\"options\", \"" + GenCommon.Esc(opts) + "\");");
                    }
                }
                if (selIdx >= 0) {
                    GenCommon.Line(b, 2, v + ".Select(" + Convert.ToString(selIdx) + ");");
                }
                break;
            case "tabs":
            case "tab-control":
            case "zan-tabs":
                GenCommon.Line(b, 2, "Gui.Widget.Tabs " + v
                               + " = new Gui.Widget.Tabs();");
                string topts = HtmlText.NodeAttr(n.attrs, "options");
                if (topts == "") { topts = HtmlText.NodeAttr(n.attrs, "tabs"); }
                if (topts == "") {
                    for (int ti = 0; ti < n.items.Count; ti = ti + 1) {
                        WItem tit = n.items[ti];
                        if (tit.kid < 0) { continue; }
                        WNode cn = wd.nodes[tit.kid];
                        if (cn.tag != "tab" && cn.tag != "tab-pane" && cn.tag != "tabpane") { continue; }
                        string tTitle = HtmlText.NodeAttr(cn.attrs, "title");
                        if (tTitle == "") { tTitle = HtmlText.NodeAttr(cn.attrs, "label"); }
                        if (tTitle == "") { tTitle = HtmlText.NodeAttr(cn.attrs, "name"); }
                        if (tTitle == "") { tTitle = cn.text.Trim(); }
                        if (tTitle != "") {
                            if (topts != "") { topts = topts + "|"; }
                            topts = topts + tTitle;
                        }
                    }
                }
                if (topts != "") {
                    GenCommon.Line(b, 2, v + ".SetProp(\"options\", \"" + GenCommon.Esc(topts) + "\");");
                }
                break;
            case "pagination":
            case "pager":
            case "zan-pagination":
                GenCommon.Line(b, 2, "Gui.Widget.Pagination " + v
                               + " = new Gui.Widget.Pagination();");
                string total = HtmlText.NodeAttr(n.attrs, "total");
                if (total != "") {
                    GenCommon.Line(b, 2, v + ".SetProp(\"total\", \"" + GenCommon.Esc(total) + "\");");
                }
                string page = HtmlText.NodeAttr(n.attrs, "page");
                if (page == "") { page = HtmlText.NodeAttr(n.attrs, "current"); }
                if (page != "") {
                    GenCommon.Line(b, 2, v + ".SetProp(\"page\", \"" + GenCommon.Esc(page) + "\");");
                }
                string pageSize = HtmlText.NodeAttr(n.attrs, "page-size");
                if (pageSize == "") { pageSize = HtmlText.NodeAttr(n.attrs, "pagesize"); }
                if (pageSize != "") {
                    GenCommon.Line(b, 2, v + ".SetProp(\"pageSize\", \"" + GenCommon.Esc(pageSize) + "\");");
                }
                break;
            case "treeview":
            case "tree":
            case "zan-tree-view":
                GenCommon.Line(b, 2, "Gui.Widget.TreeView " + v
                               + " = new Gui.Widget.TreeView();");
                break;
            case "listview":
            case "list":
            case "zan-list-view":
                string lof = HtmlText.NodeAttr(n.attrs, "of");
                if (lof == "") { lof = HtmlText.NodeAttr(n.attrs, "data-of"); }
                if (lof == "") { lof = "string"; }
                GenCommon.Line(b, 2, "Gui.Widget.ListView<" + lof + "> " + v
                               + " = new Gui.Widget.ListView<" + lof + ">();");
                break;
            case "slider":
            case "zan-slider":
                GenCommon.Line(b, 2, "Gui.Widget.Slider " + v
                               + " = new Gui.Widget.Slider();");
                break;
            case "switch":
            case "zan-switch":
                GenCommon.Line(b, 2, "Gui.Widget.Switch " + v
                               + " = new Gui.Widget.Switch();");
                break;
            case "colorpicker":
            case "color-picker":
            case "zan-color-picker":
                GenCommon.Line(b, 2, "Gui.Widget.ColorPicker " + v
                               + " = new Gui.Widget.ColorPicker();");
                break;
            case "datepicker":
            case "date-picker":
            case "zan-date-picker":
                GenCommon.Line(b, 2, "Gui.Widget.DatePicker " + v
                               + " = new Gui.Widget.DatePicker();");
                break;
            case "progress":
            case "zan-progress":
                GenCommon.Line(b, 2, "Gui.Widget.ProgressBar " + v
                               + " = new Gui.Widget.ProgressBar();");
                break;
            case "upload":
            case "zan-upload":
                GenCommon.Line(b, 2, "Gui.Widget.Upload " + v
                               + " = new Gui.Widget.Upload();");
                break;
            case "radio":
            case "zan-radio":
                GenCommon.Line(b, 2, "Gui.Widget.Radio " + v
                               + " = new Gui.Widget.Radio();");
                GenCommon.Line(b, 2, v + ".InitRadio(\"\", new SignalBool(false));");
                break;
            case "datatable":
            case "grid":
            case "data-grid":
            case "zan-data-grid":
            case "zan-datatable":
                string of = HtmlText.NodeAttr(n.attrs, "of");
                if (of == "") { of = HtmlText.NodeAttr(n.attrs, "data-of"); }
                if (of == "") { of = "string"; }
                GenCommon.Line(b, 2, "Gui.Component.DataTable.DataGrid<" + of + "> " + v
                               + " = new Gui.Component.DataTable.DataGrid<" + of + ">();");
                string colsJson = HtmlText.NodeAttr(n.attrs, "columns");
                if (colsJson == "") { colsJson = HtmlText.NodeAttr(n.attrs, "data-x-columns"); }
                if (colsJson == "") { colsJson = HtmlText.NodeAttr(n.attrs, "data-columns"); }
                if (colsJson != "") {
                    JsonValue cols = null;
                    try { cols = JsonValue.Parse(colsJson); } catch (Exception ex) { cols = null; }
                    if (cols != null && cols.IsArray()) {
                        for (int ci = 0; ci < cols.Count(); ci = ci + 1) {
                            JsonValue c = cols.At(ci);
                            if (c != null && c.IsObject()) {
                                EmitDataGridColJson(b, v, c, of);
                            }
                        }
                    }
                }
                for (int k = 0; k < n.items.Count; k = k + 1) {
                    WItem it = n.items[k];
                    if (it.kid < 0) { continue; }
                    WNode cn = wd.nodes[it.kid];
                    if (cn.tag == "col" || cn.tag == "column") {
                        EmitDataGridColNode(b, v, cn, of);
                    }
                }
                break;
            case "card":
            case "zan-card":
                string cttl = HtmlText.NodeAttr(n.attrs, "title");
                GenCommon.Line(b, 2, "Gui.Widget.Card " + v
                               + " = new Gui.Widget.Card(\"" + GenCommon.Esc(cttl) + "\");");
                break;
            case "badge":
            case "zan-badge":
                GenCommon.Line(b, 2, "Gui.Widget.Badge " + v
                               + " = new Gui.Widget.Badge();");
                break;
            case "avatar":
            case "zan-avatar":
                GenCommon.Line(b, 2, "Gui.Widget.Avatar " + v
                               + " = new Gui.Widget.Avatar();");
                break;
            case "tag":
            case "zan-tag":
                GenCommon.Line(b, 2, "Gui.Widget.Tag " + v
                               + " = new Gui.Widget.Tag();");
                break;
            case "divider":
            case "zan-divider":
                GenCommon.Line(b, 2, "Gui.Widget.Divider " + v
                               + " = new Gui.Widget.Divider();");
                break;
            case "alert":
            case "alert-box":
            case "alertbox":
            case "zan-alert-box":
                GenCommon.Line(b, 2, "Gui.Widget.AlertBox " + v
                               + " = new Gui.Widget.AlertBox();");
                break;
            case "rate":
            case "zan-rate":
                GenCommon.Line(b, 2, "Gui.Widget.Rate " + v
                               + " = new Gui.Widget.Rate();");
                break;
            case "splitpanel":
            case "split-panel":
            case "splitter":
            case "zan-split-panel":
                GenCommon.Line(b, 2, "Gui.Widget.SplitPanel " + v
                               + " = new Gui.Widget.SplitPanel();");
                break;
            case "collapse":
            case "zan-collapse":
                GenCommon.Line(b, 2, "Gui.Widget.Collapse " + v
                               + " = new Gui.Widget.Collapse();");
                break;
            case "breadcrumb":
            case "zan-breadcrumb":
                GenCommon.Line(b, 2, "Gui.Widget.Breadcrumb " + v
                               + " = new Gui.Widget.Breadcrumb();");
                break;
            case "steps":
            case "zan-steps":
                GenCommon.Line(b, 2, "Gui.Widget.Steps " + v
                               + " = new Gui.Widget.Steps();");
                break;
            case "timeline":
            case "zan-timeline":
                GenCommon.Line(b, 2, "Gui.Widget.Timeline " + v
                               + " = new Gui.Widget.Timeline();");
                break;
            case "qrcode":
            case "qr-code":
            case "zan-qr-code":
                GenCommon.Line(b, 2, "Gui.Widget.QrCode " + v
                               + " = new Gui.Widget.QrCode();");
                break;
            case "watermark":
            case "zan-watermark":
                GenCommon.Line(b, 2, "Gui.Widget.Watermark " + v
                               + " = new Gui.Widget.Watermark();");
                break;
            case "marquee":
            case "zan-marquee":
                GenCommon.Line(b, 2, "Gui.Widget.Marquee " + v
                               + " = new Gui.Widget.Marquee();");
                break;
            case "spin":
            case "zan-spin":
                GenCommon.Line(b, 2, "Gui.Widget.Spin " + v
                               + " = new Gui.Widget.Spin();");
                break;
            case "empty":
            case "zan-empty":
                GenCommon.Line(b, 2, "Gui.Widget.Empty " + v
                               + " = new Gui.Widget.Empty();");
                break;
            case "result":
            case "zan-result":
                GenCommon.Line(b, 2, "Gui.Widget.Result " + v
                               + " = new Gui.Widget.Result();");
                break;
            case "skeleton":
            case "zan-skeleton":
                GenCommon.Line(b, 2, "Gui.Widget.Skeleton " + v
                               + " = new Gui.Widget.Skeleton();");
                break;
            case "row":
            case "zan-row":
                GenCommon.Line(b, 2, "Gui.Widget.Row " + v
                               + " = new Gui.Widget.Row();");
                break;
            case "spacer":
            case "zan-spacer":
                GenCommon.Line(b, 2, "Gui.Widget.Spacer " + v
                               + " = new Gui.Widget.Spacer();");
                break;
            case "form":
            case "form-group":
            case "formgroup":
            case "zan-form":
            case "zan-form-group":
                GenCommon.Line(b, 2, "Gui.Widget.FormGroup " + v
                               + " = new Gui.Widget.FormGroup();");
                break;
            case "form-item":
            case "formitem":
            case "form-row":
            case "formrow":
            case "zan-form-item":
                GenCommon.Line(b, 2, "Gui.Widget.FormItem " + v
                               + " = new Gui.Widget.FormItem();");
                break;
            case "modal":
            case "dialog":
            case "zan-modal":
                GenCommon.Line(b, 2, "Gui.Widget.Modal " + v
                               + " = new Gui.Widget.Modal();");
                break;
            case "drawer":
            case "zan-drawer":
                GenCommon.Line(b, 2, "Gui.Widget.Drawer " + v
                               + " = new Gui.Widget.Drawer();");
                break;
            default:
                GenCommon.Line(b, 2, "Gui.Element " + v
                               + " = new Gui.Element();");
                GenCommon.Line(b, 2, v + ".InitElement(\"" + tag + "\", \""
                               + id + "\");");
                break;
        }
        // 类与 id（非 Element 的 id 走 SetProp）
        if (genCls != "") {
            GenCommon.Line(b, 2, v + ".AddClass(\"" + genCls + "\");");
        }
        string clsAttr = HtmlText.NodeAttr(n.attrs, "class");
        if (clsAttr != "") {
            List<string> cs = HtmlText.SplitClass(clsAttr);
            for (int c = 0; c < cs.Count; c = c + 1) {
                GenCommon.Line(b, 2, v + ".AddClass(\""
                               + GenCommon.Esc(cs[c]) + "\");");
            }
        }
        // 文档作用域类：与 HtmlScope.Styles 改写的选择器配对——生成 CSS
        // 只命中带此类的元素（即本文档 Build 出的树）。
        GenCommon.Line(b, 2, v + ".AddClass(\"" + zs + "\");");
        bool isWidget = IsWidgetTag(tag, type);
        if (isWidget && id != "") {
            GenCommon.Line(b, 2, v + ".SetProp(\"name\", \"" + id
                           + "\");");
        }
        // 图标属性（button 及通用控件）
        string icon = HtmlText.NodeAttr(n.attrs, "icon");
        if (icon != "") {
            if (tag == "button") {
                GenCommon.Line(b, 2, v + ".Icon = \"" + GenCommon.Esc(icon) + "\";");
            }
            GenCommon.Line(b, 2, v + ".SetProp(\"icon\", \"" + GenCommon.Esc(icon) + "\");");
        }
        // 悬停提示
        string tip = HtmlText.NodeAttr(n.attrs, "tip");
        if (tip == "") { tip = HtmlText.NodeAttr(n.attrs, "title"); }
        if (tip != "") {
            if (tag == "button") {
                GenCommon.Line(b, 2, v + ".Tip = \"" + GenCommon.Esc(tip) + "\";");
            }
            if (!isWidget) {
                GenCommon.Line(b, 2, v + ".elTitle = \"" + GenCommon.Esc(tip) + "\";");
            }
            GenCommon.Line(b, 2, v + ".SetProp(\"tip\", \"" + GenCommon.Esc(tip) + "\");");
        }
        // 提示方位（top/bottom/left/right）
        string tipSide = HtmlText.NodeAttr(n.attrs, "tip-side");
        if (tipSide == "") { tipSide = HtmlText.NodeAttr(n.attrs, "tipside"); }
        if (tipSide == "") { tipSide = HtmlText.NodeAttr(n.attrs, "tip-pos"); }
        if (tipSide != "") {
            if (tag == "button") {
                GenCommon.Line(b, 2, v + ".TipSide = \"" + GenCommon.Esc(tipSide) + "\";");
            }
            GenCommon.Line(b, 2, v + ".SetProp(\"tip-side\", \"" + GenCommon.Esc(tipSide) + "\");");
        }
        // 布局免检与重叠免检声明
        for (int a = 0; a < n.attrs.Count; a = a + 1) {
            string ak = n.attrs[a].name.ToLower();
            if (ak == "free-layout" || ak == "data-free-layout") {
                GenCommon.Line(b, 2, v + ".FreeLayout();");
            } else if (ak == "disabled") {
                GenCommon.Line(b, 2, v + ".disabled = true;");
            }
        }
        // dock 停靠
        string dock = HtmlText.NodeAttr(n.attrs, "dock");
        if (dock == "") { dock = HtmlText.NodeAttr(n.attrs, "data-dock"); }
        if (dock != "") {
            string dlower = dock.ToLower();
            if (dlower == "fill") { GenCommon.Line(b, 2, v + ".DockFill();"); }
            else if (dlower == "left") { GenCommon.Line(b, 2, v + ".DockLeft();"); }
            else if (dlower == "right") { GenCommon.Line(b, 2, v + ".DockRight();"); }
            else if (dlower == "top") { GenCommon.Line(b, 2, v + ".DockTop();"); }
            else if (dlower == "bottom") { GenCommon.Line(b, 2, v + ".DockBottom();"); }
        }
        // 显隐
        string vis = HtmlText.NodeAttr(n.attrs, "visible");
        if (vis != "") {
            if (vis == "false" || vis == "0") {
                GenCommon.Line(b, 2, v + ".visible = false;");
            } else if (vis == "true" || vis == "1") {
                GenCommon.Line(b, 2, v + ".visible = true;");
            }
        }
        // slot 具名插槽路由
        string slot = HtmlText.NodeAttr(n.attrs, "slot");
        if (slot == "") { slot = HtmlText.NodeAttr(n.attrs, "data-slot"); }
        if (slot != "") {
            GenCommon.Line(b, 2, v + ".slotName = \"" + GenCommon.Esc(slot) + "\";");
        }
        // {{ expr }} 胡子模板文本插值
        if (n.text != "" && n.text.IndexOf("{{") >= 0) {
            GenCommon.Line(b, 2, v + ".bindTpl = \"" + GenCommon.Esc(n.text) + "\";");
        }
        /* Element 的原始 data-* 属性 parity 落属性表（运行时
         * Html.Build 全量进 elAttrs；编译通道至少让 data-for 一类
         * 动态原语与 CSS 属性选择器同语义生效）。协议消费掉的
         * data-bind、data-on 系列、data-if 不重复入表；真控件的
         * 非协议属性通过 SetProp 开放。<a> 另放行 href/target：缺省
         * 导航（Html.AutoLink，挂载窗口 WireNode 二次接线时绑上）
         * 读属性表路由。 */
        if (!isWidget) {
            for (int a = 0; a < n.attrs.Count; a = a + 1) {
                string ak = n.attrs[a].name;
                bool linkKey = tag == "a"
                    && (ak == "href" || ak == "target");
                if (!linkKey
                    && (ak.Length <= 5
                    || !HtmlText.StartsWith(ak, "data-")
                    || ak == "data-bind" || ak == "data-if"
                    || (ak.Length > 8
                    && HtmlText.StartsWith(ak, "data-on-")))) {
                    continue;
                }
                GenCommon.Line(b, 2, v + ".SetAttr(\""
                               + GenCommon.Esc(ak) + "\", \""
                               + GenCommon.Esc(n.attrs[a].val) + "\");");
            }
        } else {
            // 真控件通用属性传递
            for (int a = 0; a < n.attrs.Count; a = a + 1) {
                string ak = n.attrs[a].name;
                string val = n.attrs[a].val;
                string alow = ak.ToLower();
                if (alow == "id" || alow == "class" || alow == "style" || alow == "type"
                    || alow == "value" || alow == "placeholder" || alow == "src" || alow == "alt"
                    || alow == "icon" || alow == "tip" || alow == "title" || alow == "tip-side"
                    || alow == "tipside" || alow == "tip-pos" || alow == "free-layout"
                    || alow == "data-free-layout" || alow == "dock" || alow == "data-dock"
                    || alow == "disabled" || alow == "visible" || alow == "slot" || alow == "data-slot"
                    || alow == "z-model" || alow == "v-model" || alow == "data-bind"
                    || alow.StartsWith("z-model.") || alow.StartsWith("v-model.") || alow.StartsWith("data-bind.")
                    || alow == ":class" || alow == "data-bind-class" || alow == "z-class" || alow == "v-bind:class"
                    || alow == ":disabled" || alow == "data-bind-disabled" || alow == "z-disabled" || alow == "v-bind:disabled"
                    || alow == "z-show" || alow == "v-show" || alow == "z-hide" || alow == "v-hide"
                    || alow == "z-text" || alow == "v-text" || alow == "data-if" || alow == "data-arg"
                    || (ak.Length > 1 && ak[0] == 58)
                    || (ak.Length > 7 && HtmlText.StartsWith(ak, "v-bind:"))
                    || (ak.Length > 7 && HtmlText.StartsWith(ak, "z-bind:"))
                    || alow.StartsWith("data-on-") || alow.StartsWith("on") || alow.StartsWith("v-on:")
                    || alow.StartsWith("z-on:") || (ak.Length > 0 && ak[0] == 64)) {
                    continue;
                }
                GenCommon.Line(b, 2, v + ".SetProp(\""
                               + GenCommon.Esc(ak) + "\", \""
                               + GenCommon.Esc(val) + "\");");
            }
        }
        string bind = "";
        bool bLazy = false;
        bool bNum = false;
        bool bTrim = false;
        for (int a = 0; a < n.attrs.Count; a = a + 1) {
            string ak = n.attrs[a].name;
            string aval = n.attrs[a].val;
            if (ak == "data-bind" || ak == "z-model" || ak == "v-model"
                || HtmlText.StartsWith(ak, "v-model.") || HtmlText.StartsWith(ak, "z-model.")
                || HtmlText.StartsWith(ak, "data-bind.")) {
                bind = aval;
                if (ak.IndexOf(".lazy") >= 0) { bLazy = true; }
                if (ak.IndexOf(".number") >= 0) { bNum = true; }
                if (ak.IndexOf(".trim") >= 0) { bTrim = true; }
            } else if (ak == ":class" || ak == "data-bind-class" || ak == "z-class" || ak == "v-bind:class") {
                GenCommon.Line(b, 2, v + ".bindClass = \"" + GenCommon.Esc(aval) + "\";");
            } else if (ak == ":disabled" || ak == "data-bind-disabled" || ak == "z-disabled" || ak == "v-bind:disabled") {
                GenCommon.Line(b, 2, v + ".bindDisabled = \"" + GenCommon.Esc(aval) + "\";");
            } else if (ak.Length > 1 && ak[0] == 58) {
                GenCommon.Line(b, 2, v + ".AddBindProp(\"" + GenCommon.Esc(ak.Substring(1)) + "\", \"" + GenCommon.Esc(aval) + "\");");
            } else if (ak.Length > 7 && HtmlText.StartsWith(ak, "v-bind:")) {
                GenCommon.Line(b, 2, v + ".AddBindProp(\"" + GenCommon.Esc(ak.Substring(7)) + "\", \"" + GenCommon.Esc(aval) + "\");");
            } else if (ak.Length > 7 && HtmlText.StartsWith(ak, "z-bind:")) {
                GenCommon.Line(b, 2, v + ".AddBindProp(\"" + GenCommon.Esc(ak.Substring(7)) + "\", \"" + GenCommon.Esc(aval) + "\");");
            }
        }
        if (bind != "") {
            GenCommon.Line(b, 2, v + ".bindPath = \""
                           + GenCommon.Esc(bind) + "\";");
            if (bLazy) { GenCommon.Line(b, 2, v + ".bindLazy = true;"); }
            if (bNum) { GenCommon.Line(b, 2, v + ".bindNumber = true;"); }
            if (bTrim) { GenCommon.Line(b, 2, v + ".bindTrim = true;"); }
        }
        string dif = HtmlText.NodeAttr(n.attrs, "data-if");
        if (dif == "") { dif = HtmlText.NodeAttr(n.attrs, "z-show"); }
        if (dif == "") { dif = HtmlText.NodeAttr(n.attrs, "v-show"); }
        if (dif == "") {
            string dhide = HtmlText.NodeAttr(n.attrs, "z-hide");
            if (dhide == "") { dhide = HtmlText.NodeAttr(n.attrs, "v-hide"); }
            if (dhide != "") { dif = "!" + dhide; }
        }
        if (dif != "") {
            GenCommon.Line(b, 2, v + ".bindIf = \""
                           + GenCommon.Esc(dif) + "\";");
        }
        string dtext = HtmlText.NodeAttr(n.attrs, "z-text");
        if (dtext == "") { dtext = HtmlText.NodeAttr(n.attrs, "v-text"); }
        if (dtext != "") {
            GenCommon.Line(b, 2, v + ".bindPath = \""
                           + GenCommon.Esc(dtext) + "\";");
            GenCommon.Line(b, 2, v + ".bindProp = \"text\";");
        }
        // data-arg 落字段：无参接线照旧，带参处理器经 Html.WireArg
        // 闭包捕获实参（字段本身供 ChildWindow.WireNode 二次接线）。
        string darg = HtmlText.NodeAttr(n.attrs, "data-arg");
        if (darg != "") {
            GenCommon.Line(b, 2, v + ".handlerArg = \""
                           + GenCommon.Esc(darg) + "\";");
        }
    }

    public static bool IsWidgetTag(string tag, string type) {
        switch (tag) {
            case "button":
            case "textarea":
            case "img":
            case "input":
            case "select":
            case "selectbox":
            case "zan-select-box":
            case "progress":
            case "zan-progress":
            case "switch":
            case "zan-switch":
            case "radio":
            case "zan-radio":
            case "slider":
            case "zan-slider":
            case "colorpicker":
            case "color-picker":
            case "zan-color-picker":
            case "datepicker":
            case "date-picker":
            case "zan-date-picker":
            case "upload":
            case "zan-upload":
            case "tabs":
            case "tab-control":
            case "zan-tabs":
            case "pagination":
            case "pager":
            case "zan-pagination":
            case "treeview":
            case "tree":
            case "zan-tree-view":
            case "listview":
            case "list":
            case "zan-list-view":
            case "datatable":
            case "grid":
            case "data-grid":
            case "zan-data-grid":
            case "zan-datatable":
            case "inputnumber":
            case "input-number":
            case "zan-input-number":
            case "card":
            case "zan-card":
            case "badge":
            case "zan-badge":
            case "avatar":
            case "zan-avatar":
            case "tag":
            case "zan-tag":
            case "divider":
            case "zan-divider":
            case "alert":
            case "alert-box":
            case "alertbox":
            case "zan-alert-box":
            case "rate":
            case "zan-rate":
            case "splitpanel":
            case "split-panel":
            case "splitter":
            case "zan-split-panel":
            case "collapse":
            case "zan-collapse":
            case "breadcrumb":
            case "zan-breadcrumb":
            case "steps":
            case "zan-steps":
            case "timeline":
            case "zan-timeline":
            case "qrcode":
            case "qr-code":
            case "zan-qr-code":
            case "watermark":
            case "zan-watermark":
            case "marquee":
            case "zan-marquee":
            case "spin":
            case "zan-spin":
            case "empty":
            case "zan-empty":
            case "result":
            case "zan-result":
            case "skeleton":
            case "zan-skeleton":
            case "row":
            case "zan-row":
            case "spacer":
            case "zan-spacer":
            case "form":
            case "form-group":
            case "formgroup":
            case "zan-form":
            case "zan-form-group":
            case "form-item":
            case "formitem":
            case "form-row":
            case "formrow":
            case "zan-form-item":
            case "modal":
            case "dialog":
            case "zan-modal":
            case "drawer":
            case "zan-drawer":
                return true;
            default:
                return false;
        }
    }

    public static bool IsMetaChild(string ptag, string ctag) {
        switch (ptag) {
            case "select":
            case "selectbox":
            case "zan-select-box":
                return ctag == "option";
            case "tabs":
            case "tab-control":
            case "zan-tabs":
                return ctag == "tab" || ctag == "tab-pane" || ctag == "tabpane";
            case "datatable":
            case "grid":
            case "data-grid":
            case "zan-data-grid":
            case "zan-datatable":
                return ctag == "col" || ctag == "column";
            default:
                return false;
        }
    }

    public static void EmitDataGridCol(StringBuilder b, string vn, string field, string title, int width, string ctype, string align, string of) {
        if (field.Length == 0 && title.Length == 0) { return; }
        if (title.Length == 0) { title = field; }
        if (width <= 0) { width = 100; }
        string acc = (of == "" || of == "string") ? "__r => __r" : "__r => __r." + field;
        if (field.Length == 0) { acc = "__r => __r"; }
        string colCall = "Col";
        switch (ctype) {
            case "num":  colCall = "NumCol"; break;
            case "real": colCall = "RealCol"; break;
            case "bool": colCall = "BoolCol"; break;
            case "date": colCall = "DateCol"; break;
        }

        string s = vn + "." + colCall + "(\"" + GenCommon.Esc(title) + "\", " + Convert.ToString(width) + ", " + acc + ")";
        if (field.Length > 0) {
            s = s + ".Field(\"" + GenCommon.Esc(field) + "\")";
        }
        switch (align) {
            case "right":  s = s + ".Right()"; break;
            case "center": s = s + ".Center()"; break;
        }
        GenCommon.Line(b, 2, s + ";");
    }

    public static void EmitDataGridColNode(StringBuilder b, string vn, WNode cn, string of) {
        string field = HtmlText.NodeAttr(cn.attrs, "field");
        string title = HtmlText.NodeAttr(cn.attrs, "title");
        if (title == "") { title = cn.text.Trim(); }
        int width = 100;
        string wStr = HtmlText.NodeAttr(cn.attrs, "width");
        if (wStr != "") {
            try { width = Convert.ToInt32(wStr); } catch (Exception ex) { width = 100; }
        }
        string ctype = HtmlText.NodeAttr(cn.attrs, "type").ToLower();
        string align = HtmlText.NodeAttr(cn.attrs, "align").ToLower();
        EmitDataGridCol(b, vn, field, title, width, ctype, align, of);
    }

    public static void EmitDataGridColJson(StringBuilder b, string vn, JsonValue c, string of) {
        string field = c.Str("field", "");
        string title = c.Str("title", "");
        int width = c.Int("width", 100);
        string ctype = c.Str("type", "").ToLower();
        string align = c.Str("align", "").ToLower();
        EmitDataGridCol(b, vn, field, title, width, ctype, align, of);
    }

    // 父节点 idx 的内容游走：文本片 AddText、子节点 AddChild，
    // 严格 items 文档序（只有容器记录带文本项——捕获控件的文本
    // 走自己的构造协议，void 元素无内容）。
    public static void EmitContent(StringBuilder b, WDoc wd, WNode n, int idx) {
        if (n.tag == "tab" || n.tag == "tab-pane" || n.tag == "tabpane"
            || n.tag == "option" || n.tag == "col" || n.tag == "column") {
            return;
        }
        string v = "v" + idx;
        string type = HtmlText.NodeAttr(n.attrs, "type").ToLower();
        bool isWidget = IsWidgetTag(n.tag, type);
        string tpl = "";
        for (int k = 0; k < n.items.Count; k = k + 1) {
            WItem it = n.items[k];
            if (it.kid < 0) {
                if (it.text.IndexOf("{{") >= 0) {
                    tpl = tpl + it.text;
                }
                if (!isWidget) {
                    GenCommon.Line(b, 2, v + ".AddText(\""
                                   + GenCommon.Esc(it.text) + "\");");
                }
            } else {
                WNode kidNode = wd.nodes[it.kid];
                if (IsMetaChild(n.tag, kidNode.tag)) {
                    if ((n.tag == "tabs" || n.tag == "tab-control" || n.tag == "zan-tabs")
                        && (kidNode.tag == "tab" || kidNode.tag == "tab-pane" || kidNode.tag == "tabpane")) {
                        string tTitle = HtmlText.NodeAttr(kidNode.attrs, "title");
                        if (tTitle == "") { tTitle = HtmlText.NodeAttr(kidNode.attrs, "label"); }
                        if (tTitle == "") { tTitle = HtmlText.NodeAttr(kidNode.attrs, "name"); }
                        for (int ti = 0; ti < kidNode.items.Count; ti = ti + 1) {
                            WItem tit = kidNode.items[ti];
                            if (tit.kid >= 0) {
                                if (tTitle != "") {
                                    GenCommon.Line(b, 2, "if (v" + tit.kid + ".slotName == \"\") { v" + tit.kid + ".slotName = \"" + GenCommon.Esc(tTitle) + "\"; }");
                                }
                                GenCommon.Line(b, 2, "Html.AddChild(" + v + ", v" + tit.kid + ");");
                            }
                        }
                    }
                    continue;
                }
                GenCommon.Line(b, 2, "Html.AddChild(" + v + ", v"
                               + it.kid + ");");
            }
        }
        if (isWidget && n.tag != "button" && n.tag != "textarea" && n.text.Trim() != "") {
            GenCommon.Line(b, 2, v + ".SetProp(\"text\", \"" + GenCommon.Esc(n.text.Trim()) + "\");");
        }
        if (tpl != "") {
            GenCommon.Line(b, 2, v + ".bindTpl = \"" + GenCommon.Esc(tpl) + "\";");
        }
    }

    // 事件接线（树建完统一挂，html 文档序不敏感）。
    // 支持现代指令与原生事件语法糖：
    // - data-on-<evt>="fn"
    // - @<evt>="fn"
    // - on<evt>="fn" (如 onclick, onchange, ondblclick, onshow, onhide, onresize)
    // - v-on:<evt>="fn" / z-on:<evt>="fn"
    // 节点声明了 `data-arg` 时走带参 WireArg（实参闭包捕获）。
    public static void EmitWiring(StringBuilder b, WNode n, int idx) {
        string darg = HtmlText.NodeAttr(n.attrs, "data-arg");
        for (int i = 0; i < n.attrs.Count; i = i + 1) {
            string k = n.attrs[i].name;
            string val = n.attrs[i].val;
            string evt = "";
            if (k.Length > 8 && HtmlText.StartsWith(k, "data-on-")) {
                evt = HtmlText.EventKind(k.Substring(8, k.Length - 8));
            } else if (k.Length > 1 && k[0] == 64) { // '@'
                evt = HtmlText.EventKind(k.Substring(1));
            } else if (k.Length > 5 && (HtmlText.StartsWith(k, "v-on:") || HtmlText.StartsWith(k, "z-on:"))) {
                evt = HtmlText.EventKind(k.Substring(5));
            } else if (k.Length > 2 && HtmlText.StartsWith(k, "on")) {
                evt = HtmlText.EventKind(k.Substring(2));
            }
            if (evt == "") { continue; }
            if (darg != "") {
                GenCommon.Line(b, 2, "Html.WireArg(handlers, v" + idx
                               + ", \"" + evt + "\", \""
                               + GenCommon.Esc(val) + "\", \""
                               + GenCommon.Esc(darg) + "\");");
            } else {
                GenCommon.Line(b, 2, "Html.Wire(handlers, v" + idx
                               + ", \"" + evt + "\", \""
                               + GenCommon.Esc(val) + "\");");
            }
        }
    }

    // "src/ui.html" → "UiHtml"（基名帕斯卡化 + Html；非标识符字符
    // 当分节符丢弃，数字开头的段补 _）。
    public static string ClassName(string path) {
        string baseName = BaseName(path);
        int dot = baseName.LastIndexOf(".");
        if (dot > 0) { baseName = baseName.Substring(0, dot); }
        int blen = baseName.Length;
        byte[] buf = new byte[blen + 5];
        int outLen = 0;
        bool up = true;
        for (int i = 0; i < blen; i = i + 1) {
            int c = baseName[i] & 255;
            bool alnum = (c >= 48 && c <= 57) || (c >= 65 && c <= 90)
                || (c >= 97 && c <= 122);
            if (!alnum) { up = true; continue; }
            if (outLen == 0 && c >= 48 && c <= 57) {
                buf[outLen] = 95;
                outLen = outLen + 1;
            }
            if (up) {
                if (c >= 97 && c <= 122) { c = c - 32; }
                up = false;
            }
            buf[outLen] = (byte)c;
            outLen = outLen + 1;
        }
        if (outLen == 0) { return ""; }
        buf[outLen] = 72;
        buf[outLen + 1] = 116;
        buf[outLen + 2] = 109;
        buf[outLen + 3] = 108;
        return buf.ToStr(0, outLen + 4);
    }

    public static string BaseName(string path) {
        int slash = path.LastIndexOf("/");
        int back = path.LastIndexOf("\\");
        int at = slash > back ? slash : back;
        return at >= 0 ? path.Substring(at + 1) : path;
    }

    // 文档路径 → 作用域类：基名去扩展名后小写、非字母数字折 '-'。
    // 与生成类名同源（同目录同名文档本来就会撞生成类名），
    // 作用域类继承该唯一性。改写本身在 System.Web.HtmlScope 共用。
    public static string ScopeClassOf(string path) {
        string baseName = BaseName(path);
        int dot = baseName.LastIndexOf(".");
        if (dot > 0) { baseName = baseName.Substring(0, dot); }
        int blen = baseName.Length;
        byte[] buf = new byte[3 + blen * 2];
        buf[0] = 122;  // 'z'
        buf[1] = 115;  // 's'
        buf[2] = 45;  // '-'
        int outLen = 3;
        bool dash = true;
        for (int i = 0; i < blen; i = i + 1) {
            int c = baseName[i] & 255;
            bool al = (c >= 48 && c <= 57) || (c >= 65 && c <= 90)
                || (c >= 97 && c <= 122);
            if (al) {
                if (c >= 65 && c <= 90) { c = c + 32; }
                buf[outLen] = (byte)c;
                outLen = outLen + 1;
                dash = false;
            } else if (!dash) {
                buf[outLen] = 45;  // '-'
                outLen = outLen + 1;
                dash = true;
            }
        }
        return buf.ToStr(0, outLen);
    }
}
