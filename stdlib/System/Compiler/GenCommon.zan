// GenCommon.zan -- ZanGen 代码生成器公共工具:回复组装、字符串转义、诊断。
//
// 本模块只使用基础 stdlib(字符串/JSON/文件),绝不使用任何会触发
// 代码生成 pass 的特性(ORM 查询/Web Controller/Json 映射),因为编译器
// 编译本模块时以 --no-gen 运行——但保持自举安全仍是硬约束。
namespace System.Compiler;

class GenCommon {
    /// 新回复: { "sources": [], "rewrites": [], "errors": [], "warnings": [] }
    static JsonValue NewReply() {
        JsonValue r = JsonValue.NewObject();
        r.Put("sources", JsonValue.NewArray());
        r.Put("rewrites", JsonValue.NewArray());
        r.Put("errors", JsonValue.NewArray());
        r.Put("warnings", JsonValue.NewArray());
        return r;
    }

    /// 回复里名为 key 的数组;缺失时补一个,调用方永远拿到可追加的数组。
    static JsonValue ArrOf(JsonValue reply, string key) {
        JsonValue a = reply.Get(key);
        if (a == null) {
            a = JsonValue.NewArray();
            reply.Put(key, a);
        }
        return a;
    }

    /// 追加一段生成源码(name 用于诊断)。
    static void AddSource(JsonValue reply, string name, StringBuilder text) {
        JsonValue src = JsonValue.NewObject();
        src.Put("name", JsonValue.NewStr(name));
        src.Put("text", JsonValue.NewStr(text.ToString()));
        GenCommon.ArrOf(reply, "sources").Append(src);
    }

    /// 追加一条调用点重写指令(按 genmeta 的调用点 id 协议)。
    static void AddRewrite(JsonValue reply, JsonValue op) {
        GenCommon.ArrOf(reply, "rewrites").Append(op);
    }

    /// 标记失败:回复变成 { "error": msg },C 端读取并报错。
    static void Fail(JsonValue reply, string msg) {
        reply.Set("error", JsonValue.NewStr(msg));
    }

    static bool HasError(JsonValue reply) {
        return reply.Has("error");
    }

    /// 把 s 转义为可嵌入 .zan 字符串字面量正文的文本。
    /// 规则与旧 formgen 的 fg_esc 一致:反斜杠翻倍、双引号转义、
    /// LF -> \n、CR 丢弃、TAB -> \t,其余原样。
    static string Esc(string s) {
        StringBuilder b = new StringBuilder();
        int n = s.Length;
        for (int i = 0; i < n; i = i + 1) {
            /* 单字符子串,避免 char/int 混用(见 ToCharList)。 */
            string ch = s.Substring(i, 1);
            if (ch == "\\") { b.Append("\\\\"); }
            else if (ch == "\"") { b.Append("\\\""); }
            else if (ch == "\n") { b.Append("\\n"); }
            else if (ch == "\r") { /* drop CR */ }
            else if (ch == "\t") { b.Append("\\t"); }
            else { b.Append(ch); }
        }
        return b.ToString();
    }

    /// 标识符安全检查(与旧 formgen 的 fg_is_ident 一致)。
    static bool IsIdent(string s) {
        if (s == null || s.Length == 0) { return false; }
        int c0 = s[0] & 255;
        if (!(c0 >= 65 && c0 <= 90) && !(c0 >= 97 && c0 <= 122) && c0 != 95) {
            return false;
        }
        for (int i = 1; i < s.Length; i = i + 1) {
            int c = s[i] & 255;
            if (!(c >= 65 && c <= 90) && !(c >= 97 && c <= 122) &&
                !(c >= 48 && c <= 57) && c != 95) {
                return false;
            }
        }
        return true;
    }

    /// 追加一行到输出缓冲(indent 个 4 空格缩进)。
    static void Line(StringBuilder b, int indent, string text) {
        for (int i = 0; i < indent; i = i + 1) { b.Append("    "); }
        b.Append(text);
        b.Append("\n");
    }
}
