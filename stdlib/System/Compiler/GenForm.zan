// GenForm.zan -- .zform 设计文档 → 合成 partial class 的代码生成器。
// 等价迁移自 src/compiler/formgen.c(输出逐字节一致)。
//
// 输入(design 请求的 files[i]):
//   { "name": "App.zform", "text": "<.zform JSON>", "emitMain": bool }
// 输出:reply.sources 里追加一段名为 name 的 .zan 源码。
namespace System.Compiler;

class GenForm {
    static void Translate(JsonValue req, JsonValue reply) {
        JsonValue files = req.Get("files");
        if (files == null) { return; }
        for (int i = 0; i < files.Count(); i = i + 1) {
            JsonValue f = files.At(i);
            string fname = f.Str("name", "");
            /* 只处理 .zform;.zscene 归 GenScene(与旧 C 的按扩展名分派一致)。 */
            if (!fname.EndsWith(".zform")) { continue; }
            string text = f.Str("text", "");
            bool emitMain = f.Bool("emitMain", false);
            StringBuilder outText = GenForm.TranslateOne(reply, text, fname, emitMain);
            if (outText == null) {
                if (!GenCommon.HasError(reply)) {
                    GenCommon.Fail(reply,
                        "cannot translate design document '" + fname + "'");
                }
                return;
            }
            GenCommon.AddSource(reply, fname, outText);
        }
    }

    /// 翻译单个 .zform 文档。失败返回 null;具体诊断(非法 kind 等)
    /// 已写入 reply 的 error,纯解析失败则不设 error(C 端报通用错误)。
    static StringBuilder TranslateOne(JsonValue reply, string json,
                                      string file_name, bool emit_main) {
        JsonValue root;
        try {
            root = JsonValue.Parse(json);
        } catch (Exception ex) {
            return null;
        }

        string name = GenForm.ObjStr(root, "name");
        if (!GenCommon.IsIdent(name)) {
            /* fall back to the file's base name (strip dir and .zform) */
            string base0 = file_name;
            if (base0 == null) { base0 = ""; }
            int slash = base0.LastIndexOf("/");
            int bslash = base0.LastIndexOf("\\");
            int p = 0;
            if (slash >= 0 && (bslash < 0 || slash > bslash)) { p = slash + 1; }
            else if (bslash >= 0) { p = bslash + 1; }
            string nm = base0.Substring(p);
            if (nm.EndsWith(".zform")) { nm = nm.Substring(0, nm.Length - 6); }
            if (nm.Length > 127) { nm = nm.Substring(0, 127); }
            if (!GenCommon.IsIdent(nm)) { nm = "Form"; }
            name = nm;
        }

        JsonValue fields = root.Get("fields");
        GenForm.ValidateFields(reply, fields, file_name);
        if (GenCommon.HasError(reply)) { return null; }

        int win_w = 480;
        int win_h = 520;
        JsonValue w = root.Get("winW");
        if (w != null && w.IsNumber() && w.AsInt(0) > 0) { win_w = w.AsInt(0); }
        JsonValue h = root.Get("winH");
        if (h != null && h.IsNumber() && h.AsInt(0) > 0) { win_h = h.AsInt(0); }
        bool free_mode = GenForm.ObjNum(root, "layoutMode", 0) == 1;
        /* role: "control" 生成可嵌入的 `partial class X : Control`(面板、
         * 视图、卡片),缺省或 "window" 生成窗体。控件文档没有窗口,
         * 因此不能充当项目入口。 */
        bool ctl = GenForm.ObjStr(root, "role") == "control";
        string fn0 = file_name;
        if (fn0 == null) { fn0 = "<design>"; }
        if (ctl && emit_main) {
            GenCommon.Fail(reply, fn0 +
                ": a .zform with \"role\": \"control\" cannot be the project" +
                " entry; the entry document must be a window");
            return null;
        }
        string title = GenForm.ObjStr(root, "winTitle");
        if (title.Length == 0) { title = name; }
        bool center = GenForm.ObjBool(root, "winCenter");
        int pos_x = 0;
        int pos_y = 0;
        JsonValue px = root.Get("winPosX");
        if (px != null && px.IsNumber()) { pos_x = px.AsInt(0); }
        JsonValue py = root.Get("winPosY");
        if (py != null && py.IsNumber()) { pos_y = py.AsInt(0); }
        int win_shape = GenForm.ObjNum(root, "winShape", 0);
        int win_shape_radius = GenForm.ObjNum(root, "winShapeRadius", 0);
        int win_shadow = GenForm.ObjNum(root, "winShadow", 0);
        int win_opacity = GenForm.ObjNum(root, "winOpacity", 0);
        bool win_glass = GenForm.ObjBool(root, "winGlass");
        bool win_chrome = true;
        JsonValue wch = root.Get("winChrome");
        if (wch != null && wch.IsBool()) { win_chrome = wch.AsBool(true); }
        bool win_resizable = true;
        JsonValue wrz = root.Get("winResizable");
        if (wrz != null && wrz.IsBool()) { win_resizable = wrz.AsBool(true); }

        /* Compose the silhouette spec string: "t,x,y,w,h,r;..." in logical px. */
        string shape_spec = "";
        JsonValue wshape = root.Get("winShape");
        if (wshape != null && wshape.IsArray()) {
            int n = 0;
            for (int i = 0; i < wshape.Count(); i = i + 1) {
                JsonValue reg = wshape.At(i);
                int t = GenForm.ObjNum(reg, "t", 1);
                int rx = GenForm.ObjNum(reg, "x", 0);
                int ry = GenForm.ObjNum(reg, "y", 0);
                int rw = GenForm.ObjNum(reg, "w", 0);
                int rh = GenForm.ObjNum(reg, "h", 0);
                int rr = GenForm.ObjNum(reg, "r", 0);
                if (rw <= 0 || rh <= 0) { continue; }
                if (n > 0) { shape_spec = shape_spec + ";"; }
                shape_spec = shape_spec + Convert.ToString(t) + "," +
                    Convert.ToString(rx) + "," + Convert.ToString(ry) + "," +
                    Convert.ToString(rw) + "," + Convert.ToString(rh) + "," +
                    Convert.ToString(rr);
                n = n + 1;
            }
        } else if (win_shape == 1) {
            shape_spec = "1,0,0," + Convert.ToString(win_w) + "," +
                Convert.ToString(win_h) + "," + Convert.ToString(win_shape_radius);
        } else if (win_shape == 2 || GenForm.ObjBool(root, "winRound")) {
            /* An ellipse fills the window box; forcing it square cropped
             * every non-square design to a circle in a corner. winRound is
             * the designer's "round window" switch and means the same
             * silhouette. */
            shape_spec = "2,0,0," + Convert.ToString(win_w) + "," +
                Convert.ToString(win_h) + ",0";
        }

        /* winShadow: prepend a type-3 "shadow band" region. */
        if (win_shadow > 0 && shape_spec.Length > 0) {
            int max_r = win_shape_radius;
            if (wshape != null && wshape.IsArray()) {
                for (int i = 0; i < wshape.Count(); i = i + 1) {
                    int rr = GenForm.ObjNum(wshape.At(i), "r", 0);
                    if (rr > max_r) { max_r = rr; }
                }
            }
            int band_r = max_r + win_shadow;
            if (band_r < 8) { band_r = 8; }
            if (band_r > 64) { band_r = 64; }
            string band = "3,0,0," + Convert.ToString(win_w) + "," +
                Convert.ToString(win_h) + "," + Convert.ToString(band_r) + ";";
            shape_spec = band + shape_spec;
        }

        StringBuilder decls = new StringBuilder();
        StringBuilder body = new StringBuilder();
        StringBuilder wire = new StringBuilder();
        StringBuilder valid = new StringBuilder();
        List<string> used = new List<string>();

        /* 窗体把树装进局部 `root`,控件文档装进自己(`this`)。 */
        string self = "root";
        if (ctl) { self = "this"; }
        /* 设计里的 on<Event> 绑定的投递目标:窗体直接用宿主 Form,
         * 控件经自己的 __Dispatch 走(宿主可能还没接上 Form)。
         * 必须用 Call:Handle 只查表返回 Action,不会执行它。 */
        string dispatch = "__form.Call";
        if (ctl) { dispatch = "this.__Dispatch"; }

        if (fields != null && fields.IsArray()) {
            int id = 0;
            string rootParent = self;
            if (!free_mode) {
                body.Append("        FbFlow __flow = new FbFlow();\n");
                body.Append("        __flow.Dock(Dock.Top());\n");
                body.Append("        " + self + ".Add(__flow);\n");
                rootParent = "__flow";
            }
            for (int i = 0; i < fields.Count(); i = i + 1) {
                id = GenForm.EmitField(decls, body, wire, valid, fields.At(i),
                                       rootParent, id, used, free_mode,
                                       !free_mode, dispatch, ctl);
            }
        }

        /* ---- assemble the synthetic partial class ---- */
        StringBuilder out0 = new StringBuilder();
        out0.Append("using System;\n");
        out0.Append("using Gui;\n");
        out0.Append("using Gui.Widget;\n");
        out0.Append("using Gui.Hmi;\n");
        out0.Append("using Gui.Component;\n");
        out0.Append("using Gui.Component.DataTable;\n");
        out0.Append("using Gui.Component.WebView;\n");
        /* CefBrowserBox 和 WebViewBox 一样是设计器一等控件
         * （见 ControlFactory.Kinds），设计里放一个浏览器就必须
         * 在生成的布局代码里解析得到它的类型。 */
        out0.Append("using Gui.Component.CefBrowser;\n\n");
        if (ctl) {
            out0.Append("// <auto-generated> Control layout compiled from ");
        } else {
            out0.Append("// <auto-generated> Window layout compiled from ");
        }
        if (file_name == null) { out0.Append("<design>"); } else { out0.Append(file_name); }
        out0.Append(".\n");
        out0.Append("// Regenerated from the visual design on every build - do not edit.\n");
        out0.Append("// Write your initialization and event logic in " + name + ".zan.\n");
        if (ctl) {
            out0.Append("partial class " + name + " : Control {\n");
        } else {
            out0.Append("partial class " + name + " {\n");
        }
        if (ctl) {
            out0.Append("    /// The host form this instance delivers its designed\n");
            out0.Append("    /// events to. The framework hands it over when this\n");
            out0.Append("    /// control is attached to a window tree (OnHostForm),\n");
            out0.Append("    /// so a host never wires anything by hand; it is null\n");
            out0.Append("    /// while the control lives outside any window.\n");
            out0.Append("    Form __form;\n");
        } else {
            out0.Append("    /// The live form, kept for the non-capturing handler\n");
            out0.Append("    /// lambdas (delegates are plain function pointers).\n");
            out0.Append("    /// A window document is a singleton: these fields are\n");
            out0.Append("    /// assigned by __BuildForm() and are only valid once\n");
            out0.Append("    /// __CreateWindow() has returned; showing the window\n");
            out0.Append("    /// again rebuilds the tree and overwrites them.\n");
            out0.Append("    static Form __form;\n");
        }
        if (decls.Length > 0) {
            out0.Append(decls.ToString());
            out0.Append("\n");
        }
        if (ctl) {
            out0.Append("    /// Builds the designed control tree into this control\n");
            out0.Append("    /// (real, interactive widgets), then hands over to the\n");
            out0.Append("    /// code-behind's OnInit() for data binding and logic.\n");
            out0.Append("    " + name + "() {\n");
            out0.Append("        this.InitControl(\"");
            out0.Append(GenCommon.Esc(name));
            out0.Append("\", 5);\n");
            if (free_mode) {
                // 自由画布：内边距/间距不写死，交给样式表——写死会置上
                // padSet，样式表里的 `padding` 从此再也顶不进来。
                out0.Append("        int __dp = Canvas.GetDpiScale();\n");
            } else {
                // 自动布局：根节点的内边距/行距取自样式表的 `.designroot`
                // （见 base.css），这样统一间距只有一处定义。
                out0.Append("        this.AddClass(\"designroot\");\n");
            }
            if (body.Length > 0) { out0.Append(body.ToString()); }
            if (wire.Length > 0) { out0.Append("        this.__WireControl();\n"); }
            out0.Append("        this.OnInit();\n");
            out0.Append("    }\n\n");
            out0.Append("    /// The designed class name, so the designer and the\n");
            out0.Append("    /// stylesheet see this control as its own kind.\n");
            out0.Append("    override string Kind() { return \"");
            out0.Append(GenCommon.Esc(name));
            out0.Append("\"; }\n\n");
        } else {
            out0.Append("    /// Builds the designed control tree (real, interactive widgets).\n");
            out0.Append("    static Control __BuildForm() {\n");
            out0.Append("        Panel root = Panel.Root(\"root\");\n");
            out0.Append("        root.Dock(Dock.Fill());\n");
            if (free_mode) {
                out0.Append("        int __dp = Canvas.GetDpiScale();\n");
            } else {
                out0.Append("        root.AddClass(\"designroot\");\n");
            }
            if (body.Length > 0) { out0.Append(body.ToString()); }
            out0.Append("        return root;\n");
            out0.Append("    }\n\n");
        }
        out0.Append("    /// Validates the required fields: flags every empty required\n");
        out0.Append("    /// input (red border + message) and reports whether the form is\n");
        out0.Append("    /// OK to submit. Call it from the submit handler:\n");
        out0.Append("    ///     if (!__ValidateForm()) { return; }\n");
        if (ctl) {
            out0.Append("    bool __ValidateForm() {\n");
        } else {
            out0.Append("    static bool __ValidateForm() {\n");
        }
        out0.Append("        bool ok = true;\n");
        if (valid.Length > 0) { out0.Append(valid.ToString()); }
        out0.Append("        return ok;\n");
        out0.Append("    }\n\n");
        out0.Append("    /// Subscribes every designed `on<Event>` binding to the handler\n");
        out0.Append("    /// registry on the form (see Form.On / Form.Handle). Unregistered\n");
        out0.Append("    /// handler names simply never fire.\n");
        if (ctl) {
            out0.Append("    override void OnHostForm(Form form) {\n");
            out0.Append("        this.__form = form;\n");
            out0.Append("    }\n\n");
            out0.Append("    /// Routes a designed binding to the host form's handler\n");
            out0.Append("    /// registry; a control built before its host is attached\n");
            out0.Append("    /// (or hosted without one) simply drops the event.\n");
            out0.Append("    void __Dispatch(string handler) {\n");
            out0.Append("        if (this.__form != null) { this.__form.Call(handler); }\n");
            out0.Append("    }\n\n");
            if (wire.Length > 0) {
                out0.Append("    /// Binds the designed events to __Dispatch; called from\n");
                out0.Append("    /// the constructor, so a host only has to add this control\n");
                out0.Append("    /// to a window tree.\n");
                out0.Append("    void __WireControl() {\n");
                out0.Append(wire.ToString());
                out0.Append("    }\n\n");
            }
        } else {
            out0.Append("    static void __WireForm(Form form) {\n");
            out0.Append("        __form = form;\n");
            if (wire.Length > 0) { out0.Append(wire.ToString()); }
            out0.Append("    }\n\n");
        }
        if (!ctl) {
            out0.Append("    /// Builds this designed window: control tree, window\n");
            out0.Append("    /// attributes, OnLoad and the event wiring - everything except\n");
            out0.Append("    /// the event loop, so a caller may still adjust it before Run().\n");
            out0.Append("    static Form __CreateWindow() {\n");
            out0.Append("        Form form = Form.Create(\"");
            out0.Append(GenCommon.Esc(title));
            out0.Append("\", " + Convert.ToString(win_w) + ", " +
                        Convert.ToString(win_h) + ");\n");
            out0.Append("        form.Add(__BuildForm());\n");
            if (center) {
                out0.Append("        form.GetApp().CenterWindow();\n");
            } else {
                out0.Append("        form.GetApp().SetWindowPos(" +
                            Convert.ToString(pos_x) + ", " +
                            Convert.ToString(pos_y) + ");\n");
            }
            if (shape_spec.Length > 0) {
                out0.Append("        form.GetApp().SetWindowShape(\"");
                out0.Append(GenCommon.Esc(shape_spec));
                out0.Append("\");\n");
            }
            if (win_shadow > 0) {
                out0.Append("        form.GetApp().SetWindowShadow(" +
                            Convert.ToString(win_shadow) + ");\n");
            }
            if (!win_chrome) {
                out0.Append("        form.GetApp().SetChromeVisible(false);\n");
            }
            if (!win_resizable) {
                out0.Append("        form.GetApp().SetResizable(false);\n");
            }
            if (win_glass) {
                out0.Append("        form.GetApp().SetNativeGlass(true);\n");
            }
            if (win_opacity > 0 && win_opacity < 100) {
                out0.Append("        form.GetApp().SetWindowOpacity(" +
                            Convert.ToString(win_opacity) + ");\n");
            }
            out0.Append("        " + name + ".OnLoad(form);\n");
            out0.Append("        " + name + ".__WireForm(form);\n");
            out0.Append("        return form;\n");
            out0.Append("    }\n\n");
            out0.Append("    /// Opens this designed window and runs it until it closes,\n");
            out0.Append("    /// so the calling window waits like it would on a modal dialog.\n");
            out0.Append("    /// This is how one window calls another:\n");
            out0.Append("    ///     " + name + ".Show();\n");
            out0.Append("    static void Show() {\n");
            out0.Append("        Form form = " + name + ".__CreateWindow();\n");
            out0.Append("        form.Run();\n");
            out0.Append("    }\n");
            if (emit_main) {
                out0.Append("\n    static void Main() {\n");
                out0.Append("        " + name + ".Show();\n");
                out0.Append("    }\n");
            }
        }
        out0.Append("}\n");
        return out0;
    }

    /// 校验字段树:每个字段的 kind 必须是合法 Zan 标识符(递归 kids)。
    static void ValidateFields(JsonValue reply, JsonValue arr,
                               string file_name) {
        if (arr == null || !arr.IsArray()) { return; }
        string f0 = file_name;
        if (f0 == null) { f0 = "<design>"; }
        for (int i = 0; i < arr.Count(); i = i + 1) {
            JsonValue o = arr.At(i);
            if (o == null || !o.IsObject()) {
                GenCommon.Fail(reply, f0 + ": .zform field " +
                    Convert.ToString(i) + " must be an object");
                continue;
            }
            string kind = GenForm.KindOf(o);
            if (!GenCommon.IsIdent(kind)) {
                GenCommon.Fail(reply, f0 + ": .zform field " +
                    Convert.ToString(i) +
                    " requires a valid Zan Control kind; use the class name in \"kind\"");
            }
            string of = GenForm.ObjStr(o, "of");
            if (of.Length > 0 && !GenForm.ValidTypeArgs(of)) {
                GenCommon.Fail(reply, f0 + ": .zform field " +
                    Convert.ToString(i) +
                    " has an invalid \"of\": type arguments must be Zan type names");
            }
            if (kind == "DataGrid") {
                GenForm.ValidateColumns(reply, o, f0, i);
            }
            GenForm.ValidateFields(reply, o.Get("kids"), file_name);
        }
    }

    /// 校验 DataGrid 的声明式列:columns 必须是对象数组,每列的
    /// "field" 是行实体上的字段路径(点分标识符),"type" 只认
    /// text/num/real/bool/date。带列的网格还必须写 "of"——列访问器
    /// 读的是 "of" 类型的字段,缺省的 string 上没有它们。
    static void ValidateColumns(JsonValue reply, JsonValue o, string f0,
                                int idx) {
        JsonValue cols = o.Get("columns");
        if (cols == null) { return; }
        if (!cols.IsArray()) {
            GenCommon.Fail(reply, f0 + ": .zform field " +
                Convert.ToString(idx) +
                ": DataGrid \"columns\" must be an array of column objects");
            return;
        }
        if (cols.Count() > 0 && GenForm.ObjStr(o, "of").Length == 0) {
            GenCommon.Fail(reply, f0 + ": .zform field " +
                Convert.ToString(idx) +
                ": a DataGrid with \"columns\" requires \"of\" naming the row" +
                " entity type");
        }
        for (int j = 0; j < cols.Count(); j = j + 1) {
            JsonValue c = cols.At(j);
            if (c == null || !c.IsObject()) {
                GenCommon.Fail(reply, f0 + ": .zform field " +
                    Convert.ToString(idx) + " column " + Convert.ToString(j) +
                    " must be an object");
                continue;
            }
            string field = GenForm.ObjStr(c, "field");
            if (!GenForm.ValidFieldPath(field)) {
                GenCommon.Fail(reply, f0 + ": .zform field " +
                    Convert.ToString(idx) + " column " + Convert.ToString(j) +
                    " requires \"field\": a field name on the row entity");
            }
            string t = GenForm.ObjStr(c, "type");
            if (t.Length > 0 && t != "text" && t != "num" && t != "real" &&
                t != "bool" && t != "date") {
                GenCommon.Fail(reply, f0 + ": .zform field " +
                    Convert.ToString(idx) + " column " + Convert.ToString(j) +
                    " has unknown \"type\" '" + t +
                    "'; use text, num, real, bool or date");
            }
        }
    }

    /// 列的 "field" 是实体上的字段路径:点分的合法标识符
    /// ("name"、"addr.city")。
    static bool ValidFieldPath(string s) {
        if (s.Length == 0) { return false; }
        List<string> dots = s.Split(".");
        for (int i = 0; i < dots.Count; i = i + 1) {
            if (!GenCommon.IsIdent(dots[i])) { return false; }
        }
        return true;
    }

    static string KindOf(JsonValue o) {
        JsonValue k = o.Get("kind");
        if (k != null && k.IsString()) { return k.AsString(""); }
        return "";
    }

    /// 字段的 Zan 类型:泛型控件在 "of" 里写类型实参
    /// (`"kind": "ListView", "of": "string"` -> `ListView<string>`),
    /// 多个实参用逗号分隔。非泛型控件就是 kind 本身。
    static string TypeOf(JsonValue o) {
        string kind = GenForm.KindOf(o);
        string of = GenForm.ObjStr(o, "of");
        if (of.Length == 0) { of = GenForm.DefaultTypeArgs(kind); }
        if (of.Length == 0) { return kind; }
        return kind + "<" + of + ">";
    }

    /// 泛型控件缺省的类型实参:设计器放置的控件只有 kind,
    /// 没有 "of",而泛型控件不写实参无法声明。它们展示的
    /// 都是文本行,所以缺省即 string。
    static string DefaultTypeArgs(string kind) {
        if (kind == "ListView") { return "string"; }
        if (kind == "Dropdown") { return "string"; }
        if (kind == "DataGrid") { return "string"; }
        return "";
    }

    /// "of" 的每个类型实参必须是合法 Zan 类型名(允许点分限定)。
    static bool ValidTypeArgs(string of) {
        if (of.Length == 0) { return false; }
        List<string> parts = of.Split(",");
        for (int i = 0; i < parts.Count; i = i + 1) {
            string a = GenForm.TrimWs(parts[i]);
            if (a.Length == 0) { return false; }
            List<string> dots = a.Split(".");
            for (int j = 0; j < dots.Count; j = j + 1) {
                if (!GenCommon.IsIdent(dots[j])) { return false; }
            }
        }
        return true;
    }

    static string TrimWs(string s) {
        int b = 0;
        int e = s.Length;
        while (b < e && (s.Substring(b, 1) == " " || s.Substring(b, 1) == "\t")) {
            b = b + 1;
        }
        while (e > b && (s.Substring(e - 1, 1) == " " || s.Substring(e - 1, 1) == "\t")) {
            e = e - 1;
        }
        return s.Substring(b, e - b);
    }

    static bool IsContainer(JsonValue o) {
        JsonValue kids = o.Get("kids");
        return kids != null && kids.IsArray();
    }

    static int ObjNum(JsonValue o, string key, int def) {
        JsonValue v = o.Get(key);
        if (v != null && v.IsNumber()) { return v.AsInt(def); }
        return def;
    }

    static bool ObjBool(JsonValue o, string key) {
        JsonValue v = o.Get(key);
        return v != null && v.AsBool(false);
    }

    static string ObjStr(JsonValue o, string key) {
        JsonValue v = o.Get(key);
        if (v != null && v.IsString()) { return v.AsString(""); }
        return "";
    }

    static int PrefH(JsonValue o) {
        int h = GenForm.ObjNum(o, "fh", 32);
        if (h > 0) { return h; }
        return 32;
    }

    /// Join options with '|' (mirrors JoinOpts).
    static string JoinOpts(JsonValue o) {
        JsonValue opts = o.Get("options");
        if (opts == null || !opts.IsArray() || opts.Count() == 0) { return null; }
        string out0 = "";
        for (int i = 0; i < opts.Count(); i = i + 1) {
            JsonValue it = opts.At(i);
            if (i > 0) { out0 = out0 + "|"; }
            if (it.IsString()) { out0 = out0 + it.AsString(""); }
        }
        return out0;
    }

    /// 应用 schema 级属性(options/placeholder/required/defOn)。
    static void FieldSetup(StringBuilder b, JsonValue o, string vn) {
        string opts = GenForm.JoinOpts(o);
        if (opts != null && opts.Length > 0) {
            b.Append("        " + vn + ".SetProp(\"options\", \"");
            b.Append(GenCommon.Esc(opts));
            b.Append("\");\n");
        }
        string placeholder = GenForm.ObjStr(o, "placeholder");
        if (placeholder.Length > 0) {
            b.Append("        " + vn + ".SetProp(\"placeholder\", \"");
            b.Append(GenCommon.Esc(placeholder));
            b.Append("\");\n");
        }
        if (GenForm.ObjBool(o, "required")) {
            b.Append("        " + vn + ".SetProp(\"required\", \"true\");\n");
        }
        if (GenForm.ObjBool(o, "defOn")) {
            b.Append("        " + vn + ".SetProp(\"defOn\", \"true\");\n");
        }
    }

    /// DataGrid 的声明式列:columns 数组按现有 DataGrid<T> 泛型列 API
    /// 展开,访问器直接读取 "of" 实体的字段
    /// ({"field":"name"} -> `__r => __r.name`),不经过任何字符串行
    /// 中间层;字段名或列类型与实体不符时由编译器在生成代码上报错。
    /// 数据本身由 code-behind 用 `grid.Bind(list)` 传入 List<of>。
    static void EmitColumns(StringBuilder b, JsonValue o, string vn) {
        JsonValue cols = o.Get("columns");
        if (cols != null && cols.IsArray()) {
            for (int i = 0; i < cols.Count(); i = i + 1) {
                JsonValue c = cols.At(i);
                if (c == null || !c.IsObject()) { continue; }
                GenForm.EmitColumn(b, c, vn);
            }
        }
        /* "rowFactory": true 启用行插入/删除:泛型前端无法自己
         * `new T()`,生成的工厂用 "of" 的实体类型。 */
        if (GenForm.ObjBool(o, "rowFactory")) {
            string of = GenForm.ObjStr(o, "of");
            if (of.Length > 0) {
                b.Append("        " + vn + ".RowFactory(() => new " +
                         of + "());\n");
            }
        }
    }

    static void EmitColumn(StringBuilder b, JsonValue c, string vn) {
        string field = GenForm.ObjStr(c, "field");
        if (field.Length == 0) { return; }
        string title = GenForm.ObjStr(c, "title");
        if (title.Length == 0) { title = field; }
        int width = GenForm.ObjNum(c, "width", 100);
        string ctype = GenForm.ObjStr(c, "type");
        string acc = "__r => __r." + field;
        b.Append("        " + vn + ".");
        if (ctype == "num") {
            b.Append("NumCol(\"" + GenCommon.Esc(title) + "\", " +
                     Convert.ToString(width) + ", " + acc + ")");
        } else if (ctype == "real") {
            int dec = GenForm.ObjNum(c, "decimals", 2);
            b.Append("RealCol(\"" + GenCommon.Esc(title) + "\", " +
                     Convert.ToString(width) + ", " +
                     Convert.ToString(dec) + ", " + acc + ")");
        } else if (ctype == "bool") {
            b.Append("BoolCol(\"" + GenCommon.Esc(title) + "\", " +
                     Convert.ToString(width) + ", " + acc + ")");
        } else if (ctype == "date") {
            int order = GenForm.ObjNum(c, "dateOrder", 0);
            b.Append("DateCol(\"" + GenCommon.Esc(title) + "\", " +
                     Convert.ToString(width) + ", " +
                     Convert.ToString(order) + ", " + acc + ")");
        } else {
            b.Append("Col(\"" + GenCommon.Esc(title) + "\", " +
                     Convert.ToString(width) + ", " + acc + ")");
        }
        /* 引擎侧的字段名:运行期按名找列(DataTable.Col)靠它。 */
        b.Append(".Field(\"" + GenCommon.Esc(field) + "\")");
        string align = GenForm.ObjStr(c, "align");
        if (align == "right") { b.Append(".Right()"); }
        if (align == "center") { b.Append(".Center()"); }
        string money = GenForm.ObjStr(c, "money");
        if (money.Length > 0) {
            b.Append(".Money(\"" + GenCommon.Esc(money) + "\")");
        }
        if (GenForm.ObjBool(c, "percent")) { b.Append(".Percent()"); }
        string prefix = GenForm.ObjStr(c, "prefix");
        string suffix = GenForm.ObjStr(c, "suffix");
        if (prefix.Length > 0 || suffix.Length > 0) {
            b.Append(".Affix(\"" + GenCommon.Esc(prefix) + "\", \"" +
                     GenCommon.Esc(suffix) + "\")");
        }
        if (GenForm.ObjBool(c, "sum")) { b.Append(".Sum()"); }
        if (GenForm.ObjBool(c, "avg")) { b.Append(".Avg()"); }
        if (GenForm.ObjBool(c, "min")) { b.Append(".Min()"); }
        if (GenForm.ObjBool(c, "max")) { b.Append(".Max()"); }
        if (GenForm.ObjBool(c, "count")) { b.Append(".Count()"); }
        string pin = GenForm.ObjStr(c, "pin");
        if (pin == "left") { b.Append(".Pin()"); }
        if (pin == "right") { b.Append(".PinRight()"); }
        string band = GenForm.ObjStr(c, "band");
        if (band.Length > 0) {
            b.Append(".Band(\"" + GenCommon.Esc(band) + "\")");
        }
        JsonValue sortable = c.Get("sortable");
        if (sortable != null && sortable.IsBool() && !sortable.AsBool(true)) {
            b.Append(".NotSortable()");
        }
        JsonValue resizable = c.Get("resizable");
        if (resizable != null && resizable.IsBool() && !resizable.AsBool(true)) {
            b.Append(".NotResizable()");
        }
        if (GenForm.ObjBool(c, "grouped")) { b.Append(".Grouped()"); }
        if (GenForm.ObjBool(c, "editable")) {
            /* 编辑回写:按列类型把提交的文本解析回实体字段。 */
            if (ctype == "num") {
                b.Append(".Editable((__r, __v) => { __r." + field +
                         " = DataTable.ParseInt(__v); })");
            } else if (ctype == "real") {
                b.Append(".Editable((__r, __v) => { __r." + field +
                         " = DataTable.ParseReal(__v); })");
            } else if (ctype == "bool") {
                b.Append(".Editable((__r, __v) => { __r." + field +
                         " = DataTable.ParseBool(__v); })");
            } else {
                b.Append(".Editable((__r, __v) => { __r." + field +
                         " = __v; })");
            }
        }
        b.Append(";\n");
    }

    /// 发射 on<Event> 处理器绑定(事件名 = 去掉前导 "on" 的键)。
    static void EmitHandlers(StringBuilder wire, JsonValue o, string vn,
                             string dispatch) {
        if (o == null || !o.IsObject()) { return; }
        for (int i = 0; i < o.Count(); i = i + 1) {
            string key = o.KeyAt(i);
            if (key.Length < 2 || key[0] != 'o' || key[1] != 'n') { continue; }
            JsonValue v = o.ValAt(i);
            if (v == null || !v.IsString()) { continue; }
            string hv = v.AsString("");
            if (hv.Length == 0) { continue; }
            wire.Append("        " + vn + ".BindEvent(\"");
            wire.Append(GenCommon.Esc(key.Substring(2)));
            wire.Append("\", () => " + dispatch + "(\"");
            wire.Append(GenCommon.Esc(hv));
            wire.Append("\"));\n");
            /* 同时把处理器名记在控件上,这样非 Form 宿主
             * (ChildWindow.Wire 等)也能自己解析同一份设计。 */
            wire.Append("        " + vn + ".SetHandler(\"");
            wire.Append(GenCommon.Esc(key.Substring(2)));
            wire.Append("\", \"");
            wire.Append(GenCommon.Esc(hv));
            wire.Append("\");\n");
        }
    }

    /// 子控件归属的容器表达式：设计把它放在容器的某个“位”
    /// 上时（`childTab`：标签页的第几页、分栏的哪个窗格），真正
    /// 的父节点是那个内部容器（见 Control.SlotHost），而不是容器
    /// 自身——直接挂在容器上的子控件会全部重叠在一起或压根
    /// 就不参与布局。
    static string ParentExpr(JsonValue o, string parent) {
        JsonValue slot = o.Get("childTab");
        if (slot == null || !slot.IsNumber()) { return parent; }
        int idx = slot.AsInt(0);
        if (idx < 0) { idx = 0; }
        return parent + ".SlotHost(" + Convert.ToString(idx) + ")";
    }

    static int ChildrenCount(JsonValue o) {
        JsonValue kids = o.Get("kids");
        if (kids != null && kids.IsArray()) { return kids.Count(); }
        return 0;
    }

    /// 发射一个字段的声明/构造/事件接线/校验,递归容器 kids。
    /// 返回下一个局部 id。与旧 formgen 的 fg_emit_field 逐字节等价。
    static int EmitField(StringBuilder decls, StringBuilder body,
                         StringBuilder wire, StringBuilder valid,
                         JsonValue o, string parent, int id,
                         List<string> used, bool freeMode,
                         bool parentIsFlow, string dispatch,
                         bool instanceFields) {
        string kind = GenForm.TypeOf(o);
        string fname = GenForm.ObjStr(o, "name");
        string host = GenForm.ParentExpr(o, parent);
        int next = id + 1;
        bool req = GenForm.ObjBool(o, "required");

        bool flowCell = !freeMode && parentIsFlow;

        string vn;
        bool typed = GenCommon.IsIdent(fname) && fname.Length > 0 &&
                     !used.Contains(fname);
        if (typed) {
            used.Add(fname);
            /* 控件文档可以有多个实例,具名控件因此是实例字段:两个
             * DocsView 各有自己的控件树。窗体文档是单例,保持 static。 */
            if (instanceFields) {
                vn = "this." + fname;
                decls.Append("    " + kind + " " + fname + ";\n");
            } else {
                vn = fname;
                decls.Append("    static " + kind + " " + vn + ";\n");
            }
        } else {
            vn = "c" + Convert.ToString(id);
            body.Append("        " + kind + " " + vn + ";\n");
        }

        body.Append("        " + vn + " = new " + kind + "();\n");
        body.Append("        " + vn + ".name = \"");
        body.Append(GenCommon.Esc(fname));
        body.Append("\";\n");
        /* 设计器里的 label 就是控件标题:声明了 text 属性的控件
         * (Label/Button/Checkbox...)取它作为内容,容器忽略。 */
        string dlabel = GenForm.ObjStr(o, "label");
        if (dlabel.Length > 0) {
            body.Append("        " + vn + ".SetDesignText(\"");
            body.Append(GenCommon.Esc(dlabel));
            body.Append("\");\n");
        }
        /* 设计里的 class 就是控件的 CSS 类(皮肤/尺寸变体)。 */
        string dcls = GenForm.ObjStr(o, "class");
        if (dcls.Length > 0) {
            body.Append("        " + vn + ".Class = \"");
            body.Append(GenCommon.Esc(dcls));
            body.Append("\";\n");
        }
        /* 设计里的 props 是控件自有属性的直通表(滑块的 min/max、
         * 单选项的 option ...):键名就是控件 SetProp 认的名字。 */
        JsonValue dprops = o.Get("props");
        if (dprops != null && dprops.IsObject()) {
            for (int pi = 0; pi < dprops.Count(); pi = pi + 1) {
                JsonValue pv = dprops.ValAt(pi);
                if (pv == null) { continue; }
                body.Append("        " + vn + ".SetProp(\"");
                body.Append(GenCommon.Esc(dprops.KeyAt(pi)));
                body.Append("\", \"");
                body.Append(GenCommon.Esc(pv.AsString("")));
                body.Append("\");\n");
            }
        }
        /* 双向绑定:bind 是状态实体里的路径,bindProp 是被写入的
         * 属性(缺省是控件的 value)。宿主在每帧前后同步两边。 */
        string dbind = GenForm.ObjStr(o, "bind");
        if (dbind.Length > 0) {
            body.Append("        " + vn + ".bindPath = \"");
            body.Append(GenCommon.Esc(dbind));
            body.Append("\";\n");
            string dbindProp = GenForm.ObjStr(o, "bindProp");
            if (dbindProp.Length > 0) {
                body.Append("        " + vn + ".bindProp = \"");
                body.Append(GenCommon.Esc(dbindProp));
                body.Append("\";\n");
            }
        }
        GenForm.FieldSetup(body, o, vn);
        if (GenForm.KindOf(o) == "DataGrid") {
            GenForm.EmitColumns(body, o, vn);
        }
        if (req) {
            body.Append("        " + vn + ".SetProp(\"required\", \"true\");\n");
        }

        if (freeMode) {
            int fx = GenForm.ObjNum(o, "fx", 0);
            int fy = GenForm.ObjNum(o, "fy", 0);
            // 停靠的控件不给尺寸就按内容测量（控件自己的
            // OnMeasure、容器则是子节点之和），因此设计里
            // 省略 fw/fh 表示"你自己量"，而不是悄悄替它写上
            // 一个 200x32 —— 那种默认值一到别的字号或 DPI 就错位。
            // 自由摆放（dock=0）例外：绝对定位没有内容流可依，
            // 仍然需要一个盒子。
            int fw = GenForm.ObjNum(o, "fw", 0);
            int fh = GenForm.ObjNum(o, "fh", 0);
            int dk = GenForm.ObjNum(o, "dock", 0);
            if (dk == 1 || dk == 2) {
                body.Append("        " + vn + ".Dock(Dock.");
                if (dk == 1) { body.Append("Top"); } else { body.Append("Bottom"); }
                body.Append("());\n");
                if (fh > 0) {
                    body.Append("        " + vn + ".Prefer(0, " +
                                Convert.ToString(fh) + " * __dp / 100);\n");
                }
            } else if (dk == 3 || dk == 4) {
                body.Append("        " + vn + ".Dock(Dock.");
                if (dk == 3) { body.Append("Left"); } else { body.Append("Right"); }
                body.Append("());\n");
                if (fw > 0) {
                    body.Append("        " + vn + ".Prefer(" +
                                Convert.ToString(fw) + " * __dp / 100, 0);\n");
                }
            } else if (dk == 5) {
                body.Append("        " + vn + ".Dock(Dock.Fill());\n");
            } else {
                body.Append("        " + vn + ".Dock(Dock.Manual());\n");
                body.Append("        " + vn + ".Place(" +
                            Convert.ToString(fx) + " * __dp / 100, " +
                            Convert.ToString(fy) + " * __dp / 100);\n");
                body.Append("        " + vn + ".Prefer(" +
                            Convert.ToString(fw) + " * __dp / 100, " +
                            Convert.ToString(fh) + " * __dp / 100);\n");
            }
            if (GenForm.IsContainer(o)) {
                // 设计没写 pad 就别写死：容器的内边距默认由样式表
                // （base.css 的类型规则）给，写死会挡掉皮肤的统一间距。
                int fpad = GenForm.ObjNum(o, "pad", 0 - 1);
                if (fpad >= 0) {
                    body.Append("        " + vn + ".logPad = "
                                + Convert.ToString(fpad) + ";\n");
                }
                int fgap = GenForm.ObjNum(o, "gap", 0 - 1);
                if (fgap >= 0) {
                    // 逻辑像素：`gap` 是物理像素，写死后在 150% DPI 下
                    // 行高翻倍而行距不变，停靠成列的行会挤成一片。
                    body.Append("        " + vn + ".logGap = "
                                + Convert.ToString(fgap) + ";\n");
                }
            }
            body.Append("        " + host + ".Add(" + vn + ");\n");
        } else if (!flowCell) {
            body.Append("        " + vn + ".Dock(Dock.Top());\n");
            if (GenForm.IsContainer(o)) {
                body.Append("        " + vn + ".AddClass(\"designgroup\");\n");
                int ph = 44 + 44 * GenForm.ChildrenCount(o);
                body.Append("        " + vn + ".Prefer(0, " +
                            Convert.ToString(ph) + ");\n");
            } else {
                body.Append("        " + vn + ".Prefer(0, " +
                            Convert.ToString(GenForm.PrefH(o)) + ");\n");
            }
            body.Append("        " + host + ".Add(" + vn + ");\n");
        } else {
            int sp = GenForm.ObjNum(o, "span", 24);
            if (sp < 1) { sp = 1; }
            if (sp > 24) { sp = 24; }
            if (GenForm.IsContainer(o)) {
                body.Append("        " + vn + ".AddClass(\"designgroup\");\n");
                int ph = 44 + 44 * GenForm.ChildrenCount(o);
                body.Append("        " + vn + ".Prefer(0, " +
                            Convert.ToString(ph) + ");\n");
                body.Append("        " + parent + ".AddCell(" + vn + ", 24);\n");
            } else {
                body.Append("        " + vn + ".Prefer(0, " +
                            Convert.ToString(GenForm.PrefH(o)) + ");\n");
                body.Append("        " + parent + ".AddCell(" + vn + ", " +
                            Convert.ToString(sp) + ");\n");
            }
        }
        GenForm.EmitHandlers(wire, o, vn, dispatch);

        JsonValue kids = o.Get("kids");
        if (GenForm.IsContainer(o) && kids != null && kids.IsArray()) {
            for (int i = 0; i < kids.Count(); i = i + 1) {
                next = GenForm.EmitField(decls, body, wire, valid, kids.At(i),
                                         vn, next, used, freeMode, false,
                                         dispatch, instanceFields);
            }
        }
        return next;
    }
}
