using System;
using System.Web;

namespace System.Compiler;

// 用户组件文档实体（消除 compNames / compDocs 平行列表反模式）。
public class GenFormCompEntry {
    public string name;
    public JsonValue doc;

    public GenFormCompEntry(string name, JsonValue doc) {
        this.name = name;
        this.doc = doc;
    }
}
