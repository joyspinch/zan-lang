namespace System.Compiler;

// 单个 Where/Having lambda 的翻译状态: 文本段与表达式段交替累积
// 成片段树, Binds 记录按出现顺序的绑定值。
public class Wf {
    // lambda 形参名。
    public string Pname;
    // 实体字段表。
    public List<DbField> Fields;
    // 当前累积的 SQL 文本段。
    public StringBuilder Lit;
    // 已折叠的片段表达式树。
    public JsonValue FragExpr;
    // 每个元素是 { kind, expr }
    public List<JsonValue> Binds;
    // 翻译是否仍然成功。
    public bool Ok;
    // 发诊断用的调用点。
    public JsonValue Call;
}
