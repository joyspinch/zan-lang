namespace System.Compiler;

// 单个 Where/Having lambda 的翻译状态: 文本段与表达式段交替累积
    // 成片段树, Binds 记录按出现顺序的绑定值。
    class Wf {
        // lambda 形参名。
        string Pname;
        // 实体字段表。
        List<DbField> Fields;
        // 当前累积的 SQL 文本段。
        StringBuilder Lit;
        // 已折叠的片段表达式树。
        JsonValue FragExpr;
        // 每个元素是 { kind, expr }
        List<JsonValue> Binds;
        // 翻译是否仍然成功。
        bool Ok;
        // 发诊断用的调用点。
        JsonValue Call;
    }
