// ZanGen.zan -- 编译期代码生成器入口,由 zanc 以子进程方式驱动
// (见 src/compiler/genrun.c)。用法: ZanGen <in.json> <out.json>
//
// 输入(由 zanc 的 genmeta 导出器与调用点组装):
//   { "mode": "design",  "files": [ { "path": "...", "emitMain": true } ] }
//   { "mode": "codegen", "unit": { genmeta 导出的单元元数据 } }
//
// 输出:
//   成功: { "sources": [ { "name", "text" } ], "rewrites": [ ... ] }
//   失败: { "error": "带用户 file:line 的诊断文本" }
//
// Main 被 #if ZAN_GEN_MAIN 包裹:zanc 用 -DZAN_GEN_MAIN=1 编译本文件得到
// 生成器可执行文件;普通用户程序即使 using System.Compiler 也不会得到
// 第二个 Main()。
using System;
using System.IO;
using System.Json;
using System.Text;
using System.Compiler;

namespace System.Compiler;

/// 编译期代码生成器入口: 按 mode 把请求分派给各 Gen* 模块并回写 reply。
class ZanGen {
#if ZAN_GEN_MAIN
    /// 生成器进程入口：读入请求 JSON,按 mode 分派(design ->
    /// GenForm/GenScene,codegen -> GenJson/GenRoute/GenDb,设了
    /// ZAN_INDEX_DIR 再顺带 GenIndex.WriteTo),把 reply 写到 out.json。
    static void Main() {
        if (Environment.ArgCount() < 2) {
            Console.WriteLine("ZanGen: usage: ZanGen <in.json> <out.json>");
            return;
        }
        string inPath = Environment.ArgAt(0);
        string outPath = Environment.ArgAt(1);
        string text = File.ReadAllText(inPath);
        JsonValue req = JsonValue.Parse(text);
        JsonValue reply = GenCommon.NewReply();
        string mode = req.Str("mode", "");
        if (mode == "design") {
            GenForm.Translate(req, reply);
            GenScene.Translate(req, reply);
        } else if (mode == "codegen") {
            GenJson.Run(req, reply);
            GenRoute.Run(req, reply);
            GenDb.Run(req, reply);
            /* 编译即索引:设了 ZAN_INDEX_DIR 就顺带写出 .zanmap 语义索引
             * (路由/实体),让工具与 AI 拿到与本次生成同源的事实。默认不设,
             * 编译行为不变。 */
            string idx = Interop.EnvVar("ZAN_INDEX_DIR");
            if (idx.Length > 0 && !GenCommon.HasError(reply)) {
                JsonValue unit = req.Get("unit");
                if (unit != null) { GenIndex.WriteTo(unit, idx); }
            }
        } else {
            GenCommon.Fail(reply, "unknown mode '" + mode + "'");
        }
        File.WriteAllText(outPath, reply.PrettyToJson());
    }
#endif
}
