// GenDbEmit.zan -- 实体绑定类文本生成(迁移自 src/compiler/dbgen.c 的
// dg_gen_entity / dg_gen_cols / dg_gen_insert / dg_gen_update /
// dg_gen_delete / dg_gen_codefirst 与 __DbBind 组装)。
//
// 输出与 dbgen.c 逐字节一致:每个实体生成
//   <Entity>Cols    列名常量 + Has/Kind/Require
//   __DbQ_<E>       类型化 SELECT 链(WHERE 片段/绑定/排序/分页/映射)
//   __DbI_<E>       INSERT(行列表/DbValues/Only/Skip)
//   __DbU_<E>       UPDATE(Set/SetIncr/Where 链)
//   __DbD_<E>       DELETE(Where 链)
//   __DbCF_<E>      CodeFirst(建表/加列,Sync + SyncAsync)
// 以及汇总类 __DbBind(工厂方法/SyncAll/M/Has/Cat/LastId/Cols/Ty)。
namespace System.Compiler;

class GenDbEmit {
    /// 行的 Getter 名(按字段类型)。
    static string Getter(int kind) {
        if (kind == 0 || kind == 4) { return "GetInt"; }
        if (kind == 1) { return "GetDouble"; }
        if (kind == 2) { return "GetBool"; }
        return "GetString";
    }

    /// __DbBind.Ty 的列类型码:0 int/enum, 1 double, 2 bool, 3 string。
    static int TyCode(int kind) {
        if (kind == 1) { return 1; }
        if (kind == 2) { return 2; }
        if (kind == 3) { return 3; }
        return 0;
    }

    /// 输出 `ps.AddXxx(o.<field>);` 绑定语句(ind 为缩进)。
    static void BindField(StringBuilder b, string ind, DbField f,
                          string obj) {
        if (f.Kind == 0) {
            b.Append(ind + "ps.AddInt(" + obj + "." + f.Name + ");\n");
        } else if (f.Kind == 4) {
            /* enum -> int 隐式;临时变量把它移出表达式 */
            b.Append(ind + "int ev_" + f.Name + " = " + obj + "." + f.Name +
                     ";\n");
            b.Append(ind + "ps.AddInt(ev_" + f.Name + ");\n");
        } else if (f.Kind == 1) {
            b.Append(ind + "ps.AddDouble(" + obj + "." + f.Name + ");\n");
        } else if (f.Kind == 2) {
            b.Append(ind + "if (" + obj + "." + f.Name +
                     ") { ps.AddInt(1); } else { ps.AddInt(0); }\n");
        } else {
            b.Append(ind + "ps.Add(" + obj + "." + f.Name + ");\n");
        }
    }

    /// `<Entity>Cols`:列名常量 + Has/Kind/Require。
    static void GenCols(StringBuilder b, string cls, List<DbField> fs) {
        b.Append("class " + cls + "Cols {\n");
        for (int i = 0; i < fs.Count; i = i + 1) {
            DbField f = fs[i];
            if (f.Kind == 5) { continue; }
            b.Append("    static string " + f.Name + " = \"" + f.Col +
                     "\";\n");
        }
        b.Append("    static bool Has(string c) {\n        return false");
        for (int i = 0; i < fs.Count; i = i + 1) {
            DbField f = fs[i];
            if (f.Kind == 5) { continue; }
            b.Append("\n            || c == \"" + f.Col + "\"");
        }
        b.Append(";\n    }\n");
        /* 列的声明类型,动态值按它转换 */
        b.Append("    static int Kind(string c) {\n");
        for (int i = 0; i < fs.Count; i = i + 1) {
            DbField f = fs[i];
            if (f.Kind == 5) { continue; }
            string k = f.Kind == 1 ? "KindDouble"
                       : f.Kind == 3 ? "KindText" : "KindInt";
            b.Append("        if (c == \"" + f.Col +
                     "\") { return DbParams." + k + "; }\n");
        }
        b.Append("        return DbParams.KindNull;\n    }\n");
        b.Append("    static string Require(string c) {\n" +
                 "        if (!" + cls + "Cols.Has(c)) {\n" +
                 "            throw new Exception(\"" + cls +
                 " has no column: \" + c);\n" +
                 "        }\n" +
                 "        return c;\n" +
                 "    }\n" +
                 "}\n");
    }

    /// 查询类 __DbQ_<E>。
    static void GenEntity(StringBuilder b, string cls) {
        List<DbField> fs = GenDb.FieldsOf(cls, 0);
        int nbase = 0;
        for (int i = 0; i < fs.Count; i = i + 1) {
            if (fs[i].Kind != 5) { nbase = nbase + 1; }
        }
        b.Append("class __DbQ_" + cls + " {\n");
        b.Append("    IDbExecutor db;\n" +
                 "    string tbl;\n" +
                 "    string w;\n" +
                 "    DbParams ps;\n" +
                 "    string ob;\n" +
                 "    string gb;\n" +
                 "    string h;\n" +
                 "    bool distinct;\n" +
                 "    int limN;\n" +
                 "    int offN;\n" +
                 "    bool on;\n");
        for (int i = 0; i < fs.Count; i = i + 1) {
            if (fs[i].Kind == 5) {
                b.Append("    bool j_" + fs[i].Name + ";\n");
            }
        }
        b.Append("    static __DbQ_" + cls + " Create(IDbExecutor db) {\n" +
                 "        __DbQ_" + cls + " q = new __DbQ_" + cls + "();\n" +
                 "        q.db = db;\n" +
                 "        q.tbl = \"" + GenDb.TableOf(cls) + "\";\n" +
                 "        q.on = true;\n" +
                 "        q.w = \"\";\n" +
                 "        q.ps = new DbParams();\n" +
                 "        q.ob = \"\";\n" +
                 "        q.gb = \"\";\n" +
                 "        q.h = \"\";\n" +
                 "        q.distinct = false;\n" +
                 "        q.limN = -1;\n" +
                 "        q.offN = -1;\n" +
                 "        return q;\n" +
                 "    }\n");
        b.Append("    __DbQ_" + cls + " W(string f) {\n" +
                 "        if (!this.on) { return this; }\n" +
                 "        if (this.w.Length == 0) { this.w = f; }\n" +
                 "        else { this.w = this.w + \" AND \" + f; }\n" +
                 "        return this;\n" +
                 "    }\n");
        b.Append("    __DbQ_" + cls + " Where(Expr<" + cls + "> e) {\n" +
                 "        if (!this.on) { return this; }\n" +
                 "        if (e == null || e.Root == null) { return this; }\n" +
                 "        StringBuilder sb = new StringBuilder();\n" +
                 "        ExprSql.Build(e.Root, sb, this.ps);\n" +
                 "        return this.W(sb.ToString());\n" +
                 "    }\n");
        b.Append("    __DbQ_" + cls + " WhereDict(DbValues v) {\n" +
                 "        if (!this.on) { return this; }\n" +
                 "        int i = 0;\n" +
                 "        while (i < v.Count()) {\n" +
                 "            string c = " + cls + "Cols.Require(v.NameAt(i));\n" +
                 "            W(\"t.\" + c + \" = ?\");\n" +
                 "            v.BindAs(this.ps, i, " + cls +
                 "Cols.Kind(c));\n" +
                 "            i = i + 1;\n" +
                 "        }\n" +
                 "        return this;\n" +
                 "    }\n");
        b.Append("    __DbQ_" + cls + " CondBegin(bool c) { this.on = c; " +
                 "return this; }\n");
        b.Append("    __DbQ_" + cls + " CondEnd() { this.on = true; " +
                 "return this; }\n");
        b.Append("    __DbQ_" + cls + " AsTable(string t) { this.tbl = t; " +
                 "return this; }\n");
        b.Append("    __DbQ_" + cls + " P(string v) {\n" +
                 "        if (this.on) { this.ps.Add(v); }\n" +
                 "        return this;\n" +
                 "    }\n");
        b.Append("    __DbQ_" + cls + " Pi(int v) {\n" +
                 "        if (this.on) { this.ps.AddInt(v); }\n" +
                 "        return this;\n" +
                 "    }\n");
        b.Append("    __DbQ_" + cls + " Pd(double v) {\n" +
                 "        if (this.on) { this.ps.AddDouble(v); }\n" +
                 "        return this;\n" +
                 "    }\n");
        b.Append("    __DbQ_" + cls + " InI(List<int> vs) {\n" +
                 "        if (!this.on) { return this; }\n" +
                 "        int i = 0;\n" +
                 "        while (i < vs.Count) { this.ps.AddInt(vs[i]); " +
                 "i = i + 1; }\n" +
                 "        return this;\n" +
                 "    }\n");
        b.Append("    __DbQ_" + cls + " InS(List<string> vs) {\n" +
                 "        if (!this.on) { return this; }\n" +
                 "        int i = 0;\n" +
                 "        while (i < vs.Count) { this.ps.Add(vs[i]); " +
                 "i = i + 1; }\n" +
                 "        return this;\n" +
                 "    }\n");
        b.Append("    __DbQ_" + cls + " InD(List<double> vs) {\n" +
                 "        if (!this.on) { return this; }\n" +
                 "        int i = 0;\n" +
                 "        while (i < vs.Count) { this.ps.AddDouble(vs[i]); " +
                 "i = i + 1; }\n" +
                 "        return this;\n" +
                 "    }\n");
        b.Append("    __DbQ_" + cls + " OB(string col) {\n" +
                 "        if (this.ob.Length == 0) { this.ob = col; }\n" +
                 "        else { this.ob = this.ob + \", \" + col; }\n" +
                 "        return this;\n" +
                 "    }\n");
        b.Append("    __DbQ_" + cls + " OBD(string col) { return OB(col + " +
                 "\" DESC\"); }\n");
        b.Append("    __DbQ_" + cls + " GB(string col) { this.gb = col; " +
                 "return this; }\n");
        b.Append("    __DbQ_" + cls + " H(string f) {\n" +
                 "        if (this.h.Length == 0) { this.h = f; }\n" +
                 "        else { this.h = this.h + \" AND \" + f; }\n" +
                 "        return this;\n" +
                 "    }\n");
        b.Append("    __DbQ_" + cls + " DISTINCT() { this.distinct = true; " +
                 "return this; }\n");
        b.Append("    __DbQ_" + cls + " Take(int n) { this.limN = n; " +
                 "return this; }\n");
        b.Append("    __DbQ_" + cls + " Skip(int n) { this.offN = n; " +
                 "return this; }\n");
        b.Append("    __DbQ_" + cls + " Limit(int n) { this.limN = n; " +
                 "return this; }\n");
        b.Append("    __DbQ_" + cls + " Offset(int n) { this.offN = n; " +
                 "return this; }\n");
        b.Append("    __DbQ_" + cls + " Page(int index, int size) {\n" +
                 "        if (index < 1) { index = 1; }\n" +
                 "        this.limN = size;\n" +
                 "        this.offN = (index - 1) * size;\n" +
                 "        return this;\n" +
                 "    }\n");
        for (int i = 0; i < fs.Count; i = i + 1) {
            if (fs[i].Kind == 5) {
                b.Append("    __DbQ_" + cls + " Inc_" + fs[i].Name +
                         "() { this.j_" + fs[i].Name + " = true; " +
                         "return this; }\n");
            }
        }

        /* SELECT 构建 */
        b.Append("    string BuildSelect() {\n" +
                 "        StringBuilder sb = new StringBuilder();\n" +
                 "        sb.Append(\"SELECT \");\n" +
                 "        if (this.distinct) { sb.Append(\"DISTINCT \"); }\n");
        {
            StringBuilder cols = new StringBuilder();
            bool first = true;
            for (int i = 0; i < fs.Count; i = i + 1) {
                if (fs[i].Kind == 5) { continue; }
                if (!first) { cols.Append(", "); }
                cols.Append("t." + fs[i].Col);
                first = false;
            }
            b.Append("        sb.Append(\"" + cols.ToString() + "\");\n");
        }
        for (int i = 0; i < fs.Count; i = i + 1) {
            if (fs[i].Kind != 5) { continue; }
            DbField f = fs[i];
            List<DbField> nfs = GenDb.FieldsOf(f.TypeName, 0);
            StringBuilder cols = new StringBuilder();
            for (int k = 0; k < nfs.Count; k = k + 1) {
                if (nfs[k].Kind == 5) { continue; }
                cols.Append(", j_" + f.Name + "." + nfs[k].Col);
            }
            b.Append("        if (this.j_" + f.Name + ") { sb.Append(\"" +
                     cols.ToString() + "\"); }\n");
        }
        b.Append("        sb.Append(\" FROM \");\n" +
                 "        sb.Append(this.tbl);\n" +
                 "        sb.Append(\" t\");\n");
        for (int i = 0; i < fs.Count; i = i + 1) {
            if (fs[i].Kind != 5) { continue; }
            DbField f = fs[i];
            b.Append("        if (this.j_" + f.Name + ") { sb.Append(" +
                     "\" LEFT JOIN " + GenDb.TableOf(f.TypeName) + " j_" +
                     f.Name + " ON t." + f.Name + "Id = j_" + f.Name +
                     ".id\"); }\n");
        }
        b.Append("        if (this.w.Length > 0) { sb.Append(\" WHERE \"); " +
                 "sb.Append(this.w); }\n" +
                 "        if (this.gb.Length > 0) { sb.Append(\" GROUP BY \"); " +
                 "sb.Append(this.gb); }\n" +
                 "        if (this.h.Length > 0) { sb.Append(\" HAVING \"); " +
                 "sb.Append(this.h); }\n" +
                 "        if (this.ob.Length > 0) { sb.Append(\" ORDER BY \"); " +
                 "sb.Append(this.ob); }\n" +
                 "        int pv = this.db.GetProvider();\n" +
                 "        if (pv == DbProvider.SqlServer || pv == " +
                 "DbProvider.Oracle) {\n" +
                 "            int off = this.offN;\n" +
                 "            if (off < 0) { off = 0; }\n" +
                 "            if (this.ob.Length == 0) {\n" +
                 "                if (pv == DbProvider.SqlServer) { " +
                 "sb.Append(\" ORDER BY (SELECT 0)\"); }\n" +
                 "                else { sb.Append(\" ORDER BY (SELECT 0 " +
                 "FROM DUAL)\"); }\n" +
                 "            }\n" +
                 "            sb.Append(\" OFFSET \"); " +
                 "sb.Append(Convert.ToString(off)); sb.Append(\" ROWS\");\n" +
                 "            if (this.limN >= 0) { sb.Append(\" FETCH NEXT \"); " +
                 "sb.Append(Convert.ToString(this.limN)); sb.Append(\" ROWS " +
                 "ONLY\"); }\n" +
                 "        } else {\n" +
                 "            if (this.limN >= 0) { sb.Append(\" LIMIT \"); " +
                 "sb.Append(Convert.ToString(this.limN)); }\n" +
                 "            if (this.offN >= 0) { sb.Append(\" OFFSET \"); " +
                 "sb.Append(Convert.ToString(this.offN)); }\n" +
                 "        }\n" +
                 "        return sb.ToString();\n" +
                 "    }\n");

        /* 行映射 + 终端 */
        b.Append("    List<" + cls + "> MapRows(DbResult r) {\n" +
                 "        List<" + cls + "> outp = new List<" + cls +
                 ">();\n" +
                 "        int row = 0;\n" +
                 "        while (row < r.RowCount()) {\n" +
                 "            " + cls + " o = new " + cls + "();\n");
        {
            int ci = 0;
            for (int i = 0; i < fs.Count; i = i + 1) {
                if (fs[i].Kind == 5) { continue; }
                if (fs[i].Kind == 4) {
                    /* enum 强转不可解析;int -> enum 隐式 */
                    b.Append("            o." + fs[i].Name + " = r.GetInt(" +
                             "row, " + Convert.ToString(ci) + ");\n");
                } else {
                    b.Append("            o." + fs[i].Name + " = r." +
                             GenDbEmit.Getter(fs[i].Kind) + "(row, " +
                             Convert.ToString(ci) + ");\n");
                }
                ci = ci + 1;
            }
        }
        b.Append("            int ci = " + Convert.ToString(nbase) + ";\n");
        for (int i = 0; i < fs.Count; i = i + 1) {
            if (fs[i].Kind != 5) { continue; }
            DbField f = fs[i];
            List<DbField> nfs = GenDb.FieldsOf(f.TypeName, 0);
            int nn = 0;
            int pk = -1;
            for (int k = 0; k < nfs.Count; k = k + 1) {
                if (nfs[k].Kind == 5) { continue; }
                if (nfs[k].Name == "id") { pk = nn; }
                nn = nn + 1;
            }
            if (pk < 0) { pk = 0; }
            b.Append("            if (this.j_" + f.Name + ") {\n" +
                     "                if (!r.IsNull(row, ci + " +
                     Convert.ToString(pk) + ")) {\n" +
                     "                    " + f.TypeName + " nv = new " +
                     f.TypeName + "();\n");
            int nk = 0;
            for (int k = 0; k < nfs.Count; k = k + 1) {
                if (nfs[k].Kind == 5) { continue; }
                if (nfs[k].Kind == 4) {
                    b.Append("                    nv." + nfs[k].Name +
                             " = r.GetInt(row, ci + " +
                             Convert.ToString(nk) + ");\n");
                } else {
                    b.Append("                    nv." + nfs[k].Name +
                             " = r." + GenDbEmit.Getter(nfs[k].Kind) +
                             "(row, ci + " + Convert.ToString(nk) + ");\n");
                }
                nk = nk + 1;
            }
            b.Append("                    o." + f.Name + " = nv;\n" +
                     "                }\n" +
                     "                ci = ci + " + Convert.ToString(nn) +
                     ";\n" +
                     "            }\n");
        }
        b.Append("            outp.Add(o);\n" +
                 "            row = row + 1;\n" +
                 "        }\n" +
                 "        return outp;\n" +
                 "    }\n");
        /* 单行映射、两个终端:异步版给网络驱动,同步版给内嵌驱动 */
        b.Append("    List<" + cls + "> ToList() {\n" +
                 "        return MapRows(this.db.Query(BuildSelect(), " +
                 "this.ps));\n" +
                 "    }\n" +
                 "    async List<" + cls + "> ToListAsync() {\n" +
                 "        string sql = BuildSelect();\n" +
                 "        DbResult r = await this.db.QueryAsync(sql, " +
                 "this.ps);\n" +
                 "        return MapRows(r);\n" +
                 "    }\n");
        b.Append("    string BuildCol(string col) {\n" +
                 "        StringBuilder sb = new StringBuilder();\n" +
                 "        sb.Append(\"SELECT \" + col + \" FROM \" + this.tbl " +
                 "+ \" t\");\n" +
                 "        if (this.w.Length > 0) { sb.Append(\" WHERE \" + " +
                 "this.w); }\n" +
                 "        if (this.gb.Length > 0) { sb.Append(\" GROUP BY \" + " +
                 "this.gb); }\n" +
                 "        if (this.h.Length > 0) { sb.Append(\" HAVING \" + " +
                 "this.h); }\n" +
                 "        if (this.ob.Length > 0) { sb.Append(\" ORDER BY \" + " +
                 "this.ob); }\n" +
                 "        return sb.ToString();\n" +
                 "    }\n" +
                 "    List<string> MapCol(DbResult r) {\n" +
                 "        List<string> outp = new List<string>();\n" +
                 "        int row = 0;\n" +
                 "        while (row < r.RowCount()) { outp.Add(r.GetString(" +
                 "row, 0)); row = row + 1; }\n" +
                 "        return outp;\n" +
                 "    }\n" +
                 "    List<string> ToListCol(string col) {\n" +
                 "        return MapCol(this.db.Query(BuildCol(col), " +
                 "this.ps));\n" +
                 "    }\n" +
                 "    async List<string> ToListColAsync(string col) {\n" +
                 "        string sql = BuildCol(col);\n" +
                 "        DbResult r = await this.db.QueryAsync(sql, " +
                 "this.ps);\n" +
                 "        return MapCol(r);\n" +
                 "    }\n");
        b.Append("    string BuildDto(string cols) {\n" +
                 "        StringBuilder sb = new StringBuilder();\n" +
                 "        sb.Append(\"SELECT \" + cols + \" FROM \" + this.tbl " +
                 "+ \" t\");\n" +
                 "        if (this.w.Length > 0) { sb.Append(\" WHERE \" + " +
                 "this.w); }\n" +
                 "        if (this.gb.Length > 0) { sb.Append(\" GROUP BY \" + " +
                 "this.gb); }\n" +
                 "        if (this.h.Length > 0) { sb.Append(\" HAVING \" + " +
                 "this.h); }\n" +
                 "        if (this.ob.Length > 0) { sb.Append(\" ORDER BY \" + " +
                 "this.ob); }\n" +
                 "        return sb.ToString();\n" +
                 "    }\n" +
                 "    DbResult ToListDtoR(string cols) {\n" +
                 "        return this.db.Query(BuildDto(cols), this.ps);\n" +
                 "    }\n" +
                 "    async DbResult ToListDtoRAsync(string cols) {\n" +
                 "        string sql = BuildDto(cols);\n" +
                 "        return await this.db.QueryAsync(sql, this.ps);\n" +
                 "    }\n");
        b.Append("    " + cls + " First() {\n" +
                 "        this.limN = 1;\n" +
                 "        List<" + cls + "> l = ToList();\n" +
                 "        if (l.Count > 0) { return l[0]; }\n" +
                 "        return null;\n" +
                 "    }\n" +
                 "    " + cls + " FirstOrDefault() { return First(); }\n" +
                 "    " + cls + " ToOne() { return First(); }\n" +
                 "    async " + cls + " FirstAsync() {\n" +
                 "        this.limN = 1;\n" +
                 "        List<" + cls + "> l = await ToListAsync();\n" +
                 "        if (l.Count > 0) { return l[0]; }\n" +
                 "        return null;\n" +
                 "    }\n" +
                 "    async " + cls + " FirstOrDefaultAsync() { return await " +
                 "FirstAsync(); }\n" +
                 "    async " + cls + " ToOneAsync() { return await " +
                 "FirstAsync(); }\n" +
                 "    string BuildCount() {\n" +
                 "        StringBuilder sb = new StringBuilder();\n" +
                 "        sb.Append(\"SELECT COUNT(*) FROM (SELECT 1 FROM \" + " +
                 "this.tbl + \" t\");\n" +
                 "        if (this.w.Length > 0) { sb.Append(\" WHERE \" + " +
                 "this.w); }\n" +
                 "        sb.Append(\" GROUP BY \" + this.gb);\n" +
                 "        if (this.h.Length > 0) { sb.Append(\" HAVING \" + " +
                 "this.h); }\n" +
                 "        sb.Append(\")\");\n" +
                 "        return sb.ToString();\n" +
                 "    }\n" +
                 "    async int CountAsync() {\n" +
                 "        if (this.gb.Length > 0) {\n" +
                 "            string sql = BuildCount();\n" +
                 "            DbResult r = await this.db.QueryAsync(sql, " +
                 "this.ps);\n" +
                 "            if (r.RowCount() == 0) { return 0; }\n" +
                 "            return r.GetInt(0, 0);\n" +
                 "        }\n" +
                 "        return await AggIAsync(\"COUNT(*)\");\n" +
                 "    }\n" +
                 "    async bool AnyAsync() {\n" +
                 "        int n = await CountAsync();\n" +
                 "        return n > 0;\n" +
                 "    }\n");
        b.Append("    async DbResult AggRAsync(string expr) {\n" +
                 "        string sql = BuildAgg(expr);\n" +
                 "        return await this.db.QueryAsync(sql, this.ps);\n" +
                 "    }\n" +
                 "    async int AggIAsync(string expr) {\n" +
                 "        DbResult r = await AggRAsync(expr);\n" +
                 "        if (r.RowCount() == 0) { return 0; }\n" +
                 "        return r.GetInt(0, 0);\n" +
                 "    }\n" +
                 "    async double AggDAsync(string expr) {\n" +
                 "        DbResult r = await AggRAsync(expr);\n" +
                 "        if (r.RowCount() == 0) { return 0.0; }\n" +
                 "        return r.GetDouble(0, 0);\n" +
                 "    }\n" +
                 "    int Count() {\n" +
                 "        if (this.gb.Length > 0) {\n" +
                 "            DbResult r = this.db.Query(BuildCount(), " +
                 "this.ps);\n" +
                 "            if (r.RowCount() == 0) { return 0; }\n" +
                 "            return r.GetInt(0, 0);\n" +
                 "        }\n" +
                 "        return AggI(\"COUNT(*)\");\n" +
                 "    }\n" +
                 "    bool Any() { return Count() > 0; }\n" +
                 "    string BuildAgg(string expr) {\n" +
                 "        StringBuilder sb = new StringBuilder();\n" +
                 "        sb.Append(\"SELECT \" + expr + \" FROM \" + this.tbl " +
                 "+ \" t\");\n" +
                 "        if (this.w.Length > 0) { sb.Append(\" WHERE \"); " +
                 "sb.Append(this.w); }\n" +
                 "        if (this.gb.Length > 0) { sb.Append(\" GROUP BY \"); " +
                 "sb.Append(this.gb); }\n" +
                 "        if (this.h.Length > 0) { sb.Append(\" HAVING \"); " +
                 "sb.Append(this.h); }\n" +
                 "        return sb.ToString();\n" +
                 "    }\n" +
                 "    DbResult AggR(string expr) {\n" +
                 "        return this.db.Query(BuildAgg(expr), this.ps);\n" +
                 "    }\n" +
                 "    int AggI(string expr) {\n" +
                 "        DbResult r = AggR(expr);\n" +
                 "        if (r.RowCount() == 0) { return 0; }\n" +
                 "        return r.GetInt(0, 0);\n" +
                 "    }\n" +
                 "    double AggD(string expr) {\n" +
                 "        DbResult r = AggR(expr);\n" +
                 "        if (r.RowCount() == 0) { return 0.0; }\n" +
                 "        return r.GetDouble(0, 0);\n" +
                 "    }\n" +
                 "}\n");
    }

    /// __DbI_<E>:INSERT(行列表 / DbValues 字典 / Only/Skip)。
    static void GenInsert(StringBuilder b, string cls, List<DbField> fs,
                          string tbl) {
        b.Append("class __DbI_" + cls + " {\n" +
                 "    IDbExecutor db;\n" +
                 "    string tbl;\n" +
                 "    List<" + cls + "> rows;\n" +
                 "    List<DbValues> dicts;\n" +
                 "    List<string> only;\n" +
                 "    List<string> skip;\n" +
                 "    string sql;\n" +
                 "    DbParams bound;\n" +
                 "    static __DbI_" + cls + " Create(IDbExecutor db) {\n" +
                 "        __DbI_" + cls + " q = new __DbI_" + cls + "();\n" +
                 "        q.db = db;\n" +
                 "        q.tbl = \"" + tbl + "\";\n" +
                 "        q.rows = new List<" + cls + ">();\n" +
                 "        q.dicts = new List<DbValues>();\n" +
                 "        q.only = new List<string>();\n" +
                 "        q.skip = new List<string>();\n" +
                 "        q.sql = \"\";\n" +
                 "        q.bound = new DbParams();\n" +
                 "        return q;\n" +
                 "    }\n" +
                 "    static __DbI_" + cls + " Create(IDbExecutor db, " + cls +
                 " o) {\n" +
                 "        return __DbI_" + cls + ".Create(db).AppendData(o);\n" +
                 "    }\n" +
                 "    static __DbI_" + cls + " Create(IDbExecutor db, List<" +
                 cls + "> l) {\n" +
                 "        return __DbI_" + cls + ".Create(db).AppendData(l);\n" +
                 "    }\n" +
                 "    __DbI_" + cls + " AppendData(" + cls + " o) { " +
                 "this.rows.Add(o); return this; }\n" +
                 "    __DbI_" + cls + " AppendData(List<" + cls + "> l) {\n" +
                 "        int i = 0;\n" +
                 "        while (i < l.Count) { this.rows.Add(l[i]); " +
                 "i = i + 1; }\n" +
                 "        return this;\n" +
                 "    }\n" +
                 "    __DbI_" + cls + " AsTable(string t) { this.tbl = t; " +
                 "return this; }\n" +
                 "    __DbI_" + cls + " AppendDict(DbValues v) {\n" +
                 "        int i = 0;\n" +
                 "        while (i < v.Count()) { " + cls +
                 "Cols.Require(v.NameAt(i)); i = i + 1; }\n" +
                 "        this.dicts.Add(v);\n" +
                 "        return this;\n" +
                 "    }\n" +
                 "    __DbI_" + cls + " AppendDict(List<DbValues> l) {\n" +
                 "        int i = 0;\n" +
                 "        while (i < l.Count) { AppendDict(l[i]); " +
                 "i = i + 1; }\n" +
                 "        return this;\n" +
                 "    }\n" +
                 "    __DbI_" + cls + " Only(string c) { this.only.Add(c); " +
                 "return this; }\n" +
                 "    __DbI_" + cls + " Skip(string c) { this.skip.Add(c); " +
                 "return this; }\n" +
                 "    bool Use(string c, bool identity) {\n" +
                 "        if (this.only.Count > 0) { return " +
                 "__DbBind.Has(this.only, c); }\n" +
                 "        if (identity) { return false; }\n" +
                 "        return !__DbBind.Has(this.skip, c);\n" +
                 "    }\n");
        /* 语句构建到 this.sql / this.bound,由一对终端执行,同步与异步
         * 形式共享每一行 SQL 拼装 */
        b.Append("    int BuildDicts() {\n" +
                 "        DbParams ps = new DbParams();\n" +
                 "        DbValues head = this.dicts[0];\n" +
                 "        StringBuilder sb = new StringBuilder();\n" +
                 "        sb.Append(\"INSERT INTO \");\n" +
                 "        sb.Append(this.tbl);\n" +
                 "        sb.Append(\" (\");\n" +
                 "        int c = 0;\n" +
                 "        while (c < head.Count()) {\n" +
                 "            if (c > 0) { sb.Append(\", \"); }\n" +
                 "            sb.Append(head.NameAt(c));\n" +
                 "            c = c + 1;\n" +
                 "        }\n" +
                 "        sb.Append(\") VALUES \");\n" +
                 "        int i = 0;\n" +
                 "        while (i < this.dicts.Count) {\n" +
                 "            DbValues v = this.dicts[i];\n" +
                 "            if (i > 0) { sb.Append(\", \"); }\n" +
                 "            sb.Append(\"(\");\n" +
                 "            int k = 0;\n" +
                 "            while (k < head.Count()) {\n" +
                 "                if (k > 0) { sb.Append(\", \"); }\n" +
                 "                sb.Append(\"?\");\n" +
                 "                int at = v.IndexOf(head.NameAt(k));\n" +
                 "                if (at < 0) { ps.AddNull(); } else {\n" +
                 "                    v.BindAs(ps, at, " + cls +
                 "Cols.Kind(head.NameAt(k)));\n" +
                 "                }\n" +
                 "                k = k + 1;\n" +
                 "            }\n" +
                 "            sb.Append(\")\");\n" +
                 "            i = i + 1;\n" +
                 "        }\n" +
                 "        this.sql = sb.ToString();\n" +
                 "        this.bound = ps;\n" +
                 "        return 1;\n" +
                 "    }\n" +
                 "    int ExecuteDicts() {\n" +
                 "        if (BuildDicts() == 0) { return 0; }\n" +
                 "        return this.db.Execute(this.sql, this.bound);\n" +
                 "    }\n" +
                 "    async int ExecuteDictsAsync() {\n" +
                 "        if (BuildDicts() == 0) { return 0; }\n" +
                 "        return await this.db.ExecuteAsync(this.sql, " +
                 "this.bound);\n" +
                 "    }\n" +
                 "    int BuildRows() {\n" +
                 "        if (this.rows.Count == 0) { return 0; }\n" +
                 "        DbParams ps = new DbParams();\n" +
                 "        string cols = \"\";\n");
        for (int i = 0; i < fs.Count; i = i + 1) {
            DbField f = fs[i];
            if (f.Kind == 5) { continue; }
            b.Append("        if (this.Use(\"" + f.Col + "\", " +
                     (f.IsIdent ? "true" : "false") + ")) {\n" +
                     "            if (cols.Length > 0) { cols = cols + " +
                     "\", \"; }\n" +
                     "            cols = cols + \"" + f.Col + "\";\n" +
                     "        }\n");
        }
        b.Append("        if (cols.Length == 0) { return 0; }\n" +
                 "        StringBuilder sb = new StringBuilder();\n" +
                 "        sb.Append(\"INSERT INTO \");\n" +
                 "        sb.Append(this.tbl);\n" +
                 "        sb.Append(\" (\");\n" +
                 "        sb.Append(cols);\n" +
                 "        sb.Append(\") VALUES \");\n" +
                 "        int i = 0;\n" +
                 "        while (i < this.rows.Count) {\n" +
                 "            " + cls + " o = this.rows[i];\n" +
                 "            if (i > 0) { sb.Append(\", \"); }\n" +
                 "            string marks = \"\";\n");
        for (int i = 0; i < fs.Count; i = i + 1) {
            DbField f = fs[i];
            if (f.Kind == 5) { continue; }
            b.Append("            if (this.Use(\"" + f.Col + "\", " +
                     (f.IsIdent ? "true" : "false") + ")) {\n" +
                     "                if (marks.Length > 0) { marks = marks + " +
                     "\", \"; }\n" +
                     "                marks = marks + \"?\";\n");
            GenDbEmit.BindField(b, "                ", f, "o");
            b.Append("            }\n");
        }
        b.Append("            sb.Append(\"(\");\n" +
                 "            sb.Append(marks);\n" +
                 "            sb.Append(\")\");\n" +
                 "            i = i + 1;\n" +
                 "        }\n" +
                 "        this.sql = sb.ToString();\n" +
                 "        this.bound = ps;\n" +
                 "        return 1;\n" +
                 "    }\n" +
                 "    int ExecuteAffrows() {\n" +
                 "        if (this.dicts.Count > 0) { return " +
                 "ExecuteDicts(); }\n" +
                 "        if (BuildRows() == 0) { return 0; }\n" +
                 "        return this.db.Execute(this.sql, this.bound);\n" +
                 "    }\n" +
                 "    async int ExecuteAffrowsAsync() {\n" +
                 "        if (this.dicts.Count > 0) { return await " +
                 "ExecuteDictsAsync(); }\n" +
                 "        if (BuildRows() == 0) { return 0; }\n" +
                 "        return await this.db.ExecuteAsync(this.sql, " +
                 "this.bound);\n" +
                 "    }\n" +
                 "    int ExecuteIdentity() {\n" +
                 "        if (ExecuteAffrows() == 0) { return 0; }\n" +
                 "        return __DbBind.LastId(this.db);\n" +
                 "    }\n" +
                 "    async int ExecuteIdentityAsync() {\n" +
                 "        int n = await ExecuteAffrowsAsync();\n" +
                 "        if (n == 0) { return 0; }\n" +
                 "        return await __DbBind.LastIdAsync(this.db);\n" +
                 "    }\n" +
                 "}\n");
    }

    /// __DbU_<E>:UPDATE(Set/SetIncr/Where 链)。
    static void GenUpdate(StringBuilder b, string cls, List<DbField> fs,
                          string tbl) {
        DbField pk = null;
        for (int i = 0; i < fs.Count; i = i + 1) {
            if (fs[i].IsPk && fs[i].Kind != 5) { pk = fs[i]; }
        }
        b.Append("class __DbU_" + cls + " {\n" +
                 "    IDbExecutor db;\n" +
                 "    string tbl;\n" +
                 "    " + cls + " src;\n" +
                 "    List<string> only;\n" +
                 "    List<string> skip;\n" +
                 "    string sets;\n" +
                 "    DbParams sp;\n" +
                 "    string w;\n" +
                 "    DbParams wp;\n" +
                 "    bool on;\n" +
                 "    static __DbU_" + cls + " Create(IDbExecutor db) {\n" +
                 "        __DbU_" + cls + " q = new __DbU_" + cls + "();\n" +
                 "        q.db = db;\n" +
                 "        q.tbl = \"" + tbl + "\";\n" +
                 "        q.only = new List<string>();\n" +
                 "        q.skip = new List<string>();\n" +
                 "        q.sets = \"\";\n" +
                 "        q.sp = new DbParams();\n" +
                 "        q.w = \"\";\n" +
                 "        q.wp = new DbParams();\n" +
                 "        q.on = true;\n" +
                 "        return q;\n" +
                 "    }\n" +
                 "    __DbU_" + cls + " AsTable(string t) { this.tbl = t; " +
                 "return this; }\n" +
                 "    __DbU_" + cls + " Only(string c) { this.only.Add(c); " +
                 "return this; }\n" +
                 "    __DbU_" + cls + " Skip(string c) { this.skip.Add(c); " +
                 "return this; }\n" +
                 "    bool Use(string c) {\n" +
                 "        if (this.only.Count > 0) { return " +
                 "__DbBind.Has(this.only, c); }\n" +
                 "        return !__DbBind.Has(this.skip, c);\n" +
                 "    }\n" +
                 "    __DbU_" + cls + " SetDict(DbValues v) {\n" +
                 "        int i = 0;\n" +
                 "        while (i < v.Count()) {\n" +
                 "            string c = " + cls + "Cols.Require(v.NameAt(i));\n" +
                 "            if (Use(c)) {\n" +
                 "                v.BindAs(this.sp, i, " + cls +
                 "Cols.Kind(c));\n" +
                 "                Frag(c + \" = ?\");\n" +
                 "            }\n" +
                 "            i = i + 1;\n" +
                 "        }\n" +
                 "        return this;\n" +
                 "    }\n" +
                 "    __DbU_" + cls + " WhereDict(DbValues v) {\n" +
                 "        if (!this.on) { return this; }\n" +
                 "        int i = 0;\n" +
                 "        while (i < v.Count()) {\n" +
                 "            string c = " + cls + "Cols.Require(v.NameAt(i));\n" +
                 "            W(c + \" = ?\");\n" +
                 "            v.BindAs(this.wp, i, " + cls +
                 "Cols.Kind(c));\n" +
                 "            i = i + 1;\n" +
                 "        }\n" +
                 "        return this;\n" +
                 "    }\n" +
                 "    __DbU_" + cls + " CondBegin(bool c) { this.on = c; " +
                 "return this; }\n" +
                 "    __DbU_" + cls + " CondEnd() { this.on = true; " +
                 "return this; }\n" +
                 "    __DbU_" + cls + " W(string f) {\n" +
                 "        if (!this.on) { return this; }\n" +
                 "        string u = __DbBind.Unalias(f);\n" +
                 "        if (this.w.Length == 0) { this.w = u; }\n" +
                 "        else { this.w = this.w + \" AND \" + u; }\n" +
                 "        return this;\n" +
                 "    }\n" +
                 "    __DbU_" + cls + " P(string v) {\n" +
                 "        if (this.on) { this.wp.Add(v); }\n" +
                 "        return this;\n" +
                 "    }\n" +
                 "    __DbU_" + cls + " Pi(int v) {\n" +
                 "        if (this.on) { this.wp.AddInt(v); }\n" +
                 "        return this;\n" +
                 "    }\n" +
                 "    __DbU_" + cls + " Pd(double v) {\n" +
                 "        if (this.on) { this.wp.AddDouble(v); }\n" +
                 "        return this;\n" +
                 "    }\n" +
                 "    __DbU_" + cls + " InI(List<int> vs) {\n" +
                 "        if (!this.on) { return this; }\n" +
                 "        int i = 0;\n" +
                 "        while (i < vs.Count) { this.wp.AddInt(vs[i]); " +
                 "i = i + 1; }\n" +
                 "        return this;\n" +
                 "    }\n" +
                 "    __DbU_" + cls + " InS(List<string> vs) {\n" +
                 "        if (!this.on) { return this; }\n" +
                 "        int i = 0;\n" +
                 "        while (i < vs.Count) { this.wp.Add(vs[i]); " +
                 "i = i + 1; }\n" +
                 "        return this;\n" +
                 "    }\n" +
                 "    __DbU_" + cls + " InD(List<double> vs) {\n" +
                 "        if (!this.on) { return this; }\n" +
                 "        int i = 0;\n" +
                 "        while (i < vs.Count) { this.wp.AddDouble(vs[i]); " +
                 "i = i + 1; }\n" +
                 "        return this;\n" +
                 "    }\n" +
                 "    __DbU_" + cls + " Frag(string f) {\n" +
                 "        if (this.sets.Length > 0) { this.sets = this.sets + " +
                 "\", \"; }\n" +
                 "        this.sets = this.sets + f;\n" +
                 "        return this;\n" +
                 "    }\n" +
                 "    __DbU_" + cls + " SetI(string c, int v) {\n" +
                 "        this.sp.AddInt(v);\n" +
                 "        return Frag(c + \" = ?\");\n" +
                 "    }\n" +
                 "    __DbU_" + cls + " SetD(string c, double v) {\n" +
                 "        this.sp.AddDouble(v);\n" +
                 "        return Frag(c + \" = ?\");\n" +
                 "    }\n" +
                 "    __DbU_" + cls + " SetS(string c, string v) {\n" +
                 "        this.sp.Add(v);\n" +
                 "        return Frag(c + \" = ?\");\n" +
                 "    }\n" +
                 "    __DbU_" + cls + " SetB(string c, bool v) {\n" +
                 "        if (v) { this.sp.AddInt(1); } else { " +
                 "this.sp.AddInt(0); }\n" +
                 "        return Frag(c + \" = ?\");\n" +
                 "    }\n" +
                 "    __DbU_" + cls + " SetIncrI(string c, int v) {\n" +
                 "        this.sp.AddInt(v);\n" +
                 "        return Frag(c + \" = \" + c + \" + ?\");\n" +
                 "    }\n" +
                 "    __DbU_" + cls + " SetIncrD(string c, double v) {\n" +
                 "        this.sp.AddDouble(v);\n" +
                 "        return Frag(c + \" = \" + c + \" + ?\");\n" +
                 "    }\n");
        /* SetSource 记录实体;列在执行时展开,UpdateColumns/IgnoreColumns
         * 任意链顺序都成立 */
        b.Append("    __DbU_" + cls + " SetSource(" + cls + " o) { " +
                 "this.src = o; return this; }\n" +
                 "    void ApplySource() {\n" +
                 "        if (this.src == null) { return; }\n" +
                 "        " + cls + " o = this.src;\n" +
                 "        this.src = null;\n");
        if (pk == null) {
            /* 无主键:没有可定位行的键 */
            b.Append("    }\n");
        } else {
            for (int i = 0; i < fs.Count; i = i + 1) {
                DbField f = fs[i];
                if (f.Kind == 5 || f.IsPk) { continue; }
                b.Append("        if (Use(\"" + f.Col + "\")) {\n");
                if (f.Kind == 0) {
                    b.Append("            SetI(\"" + f.Col + "\", o." +
                             f.Name + ");\n");
                } else if (f.Kind == 4) {
                    b.Append("            int ev_" + f.Name + " = o." +
                             f.Name + ";\n" +
                             "            SetI(\"" + f.Col + "\", ev_" +
                             f.Name + ");\n");
                } else if (f.Kind == 1) {
                    b.Append("            SetD(\"" + f.Col + "\", o." +
                             f.Name + ");\n");
                } else if (f.Kind == 2) {
                    b.Append("            SetB(\"" + f.Col + "\", o." +
                             f.Name + ");\n");
                } else {
                    b.Append("            SetS(\"" + f.Col + "\", o." +
                             f.Name + ");\n");
                }
                b.Append("        }\n");
            }
            string pm = pk.Kind == 3 ? "P" : pk.Kind == 1 ? "Pd" : "Pi";
            b.Append("        W(\"" + pk.Col + " = ?\");\n" +
                     "        " + pm + "(o." + pk.Name + ");\n" +
                     "    }\n");
        }
        b.Append("    string BuildUpdate() {\n" +
                 "        ApplySource();\n" +
                 "        if (this.sets.Length == 0) { return \"\"; }\n" +
                 "        if (this.w.Length == 0) { return \"\"; }\n" +
                 "        return \"UPDATE \" + this.tbl + \" SET \" + " +
                 "this.sets\n" +
                 "            + \" WHERE \" + this.w;\n" +
                 "    }\n" +
                 "    int ExecuteAffrows() {\n" +
                 "        string sql = BuildUpdate();\n" +
                 "        if (sql.Length == 0) { return 0; }\n" +
                 "        return this.db.Execute(sql, " +
                 "__DbBind.Cat(this.sp, this.wp));\n" +
                 "    }\n" +
                 "    async int ExecuteAffrowsAsync() {\n" +
                 "        string sql = BuildUpdate();\n" +
                 "        if (sql.Length == 0) { return 0; }\n" +
                 "        DbParams ps = __DbBind.Cat(this.sp, this.wp);\n" +
                 "        return await this.db.ExecuteAsync(sql, ps);\n" +
                 "    }\n" +
                 "}\n");
    }

    /// __DbD_<E>:DELETE(Where 链)。
    static void GenDelete(StringBuilder b, string cls, string tbl) {
        b.Append("class __DbD_" + cls + " {\n" +
                 "    IDbExecutor db;\n" +
                 "    string tbl;\n" +
                 "    string w;\n" +
                 "    DbParams ps;\n" +
                 "    bool on;\n" +
                 "    static __DbD_" + cls + " Create(IDbExecutor db) {\n" +
                 "        __DbD_" + cls + " q = new __DbD_" + cls + "();\n" +
                 "        q.db = db;\n" +
                 "        q.tbl = \"" + tbl + "\";\n" +
                 "        q.w = \"\";\n" +
                 "        q.ps = new DbParams();\n" +
                 "        q.on = true;\n" +
                 "        return q;\n" +
                 "    }\n" +
                 "    __DbD_" + cls + " AsTable(string t) { this.tbl = t; " +
                 "return this; }\n" +
                 "    __DbD_" + cls + " CondBegin(bool c) { this.on = c; " +
                 "return this; }\n" +
                 "    __DbD_" + cls + " CondEnd() { this.on = true; " +
                 "return this; }\n" +
                 "    __DbD_" + cls + " W(string f) {\n" +
                 "        if (!this.on) { return this; }\n" +
                 "        string u = __DbBind.Unalias(f);\n" +
                 "        if (this.w.Length == 0) { this.w = u; }\n" +
                 "        else { this.w = this.w + \" AND \" + u; }\n" +
                 "        return this;\n" +
                 "    }\n" +
                 "    __DbD_" + cls + " WhereDict(DbValues v) {\n" +
                 "        if (!this.on) { return this; }\n" +
                 "        int i = 0;\n" +
                 "        while (i < v.Count()) {\n" +
                 "            string c = " + cls + "Cols.Require(v.NameAt(i));\n" +
                 "            W(c + \" = ?\");\n" +
                 "            v.BindAs(this.ps, i, " + cls +
                 "Cols.Kind(c));\n" +
                 "            i = i + 1;\n" +
                 "        }\n" +
                 "        return this;\n" +
                 "    }\n" +
                 "    __DbD_" + cls + " P(string v) {\n" +
                 "        if (this.on) { this.ps.Add(v); }\n" +
                 "        return this;\n" +
                 "    }\n" +
                 "    __DbD_" + cls + " Pi(int v) {\n" +
                 "        if (this.on) { this.ps.AddInt(v); }\n" +
                 "        return this;\n" +
                 "    }\n" +
                 "    __DbD_" + cls + " Pd(double v) {\n" +
                 "        if (this.on) { this.ps.AddDouble(v); }\n" +
                 "        return this;\n" +
                 "    }\n" +
                 "    __DbD_" + cls + " InI(List<int> vs) {\n" +
                 "        if (!this.on) { return this; }\n" +
                 "        int i = 0;\n" +
                 "        while (i < vs.Count) { this.ps.AddInt(vs[i]); " +
                 "i = i + 1; }\n" +
                 "        return this;\n" +
                 "    }\n" +
                 "    __DbD_" + cls + " InS(List<string> vs) {\n" +
                 "        if (!this.on) { return this; }\n" +
                 "        int i = 0;\n" +
                 "        while (i < vs.Count) { this.ps.Add(vs[i]); " +
                 "i = i + 1; }\n" +
                 "        return this;\n" +
                 "    }\n" +
                 "    __DbD_" + cls + " InD(List<double> vs) {\n" +
                 "        if (!this.on) { return this; }\n" +
                 "        int i = 0;\n" +
                 "        while (i < vs.Count) { this.ps.AddDouble(vs[i]); " +
                 "i = i + 1; }\n" +
                 "        return this;\n" +
                 "    }\n" +
                 "    int ExecuteAffrows() {\n" +
                 "        if (this.w.Length == 0) { return 0; }\n" +
                 "        string sql = \"DELETE FROM \" + this.tbl + " +
                 "\" WHERE \" + this.w;\n" +
                 "        return this.db.Execute(sql, this.ps);\n" +
                 "    }\n" +
                 "    async int ExecuteAffrowsAsync() {\n" +
                 "        if (this.w.Length == 0) { return 0; }\n" +
                 "        string sql = \"DELETE FROM \" + this.tbl + " +
                 "\" WHERE \" + this.w;\n" +
                 "        return await this.db.ExecuteAsync(sql, this.ps);\n" +
                 "    }\n" +
                 "}\n");
    }

    /// __DbCF_<E>:CodeFirst(缺表建表,缺列加列;同步 + 异步)。
    static void GenCodeFirst(StringBuilder b, string cls, List<DbField> fs,
                             string tbl) {
        b.Append("class __DbCF_" + cls + " {\n" +
                 "    static void Sync(IDbExecutor db) {\n" +
                 "        int p = db.GetProvider();\n" +
                 "        string t = \"" + tbl + "\";\n" +
                 "        if (!__DbBind.HasTable(db, t)) {\n" +
                 "            string ddl = \"CREATE TABLE \" + t + \" (\";\n");
        bool first = true;
        for (int i = 0; i < fs.Count; i = i + 1) {
            DbField f = fs[i];
            if (f.Kind == 5) { continue; }
            b.Append("            ddl = ddl + \"" +
                     (first ? "" : ", ") + f.Col + " \" + __DbBind.Ty(p, " +
                     Convert.ToString(GenDbEmit.TyCode(f.Kind)) + ", " +
                     (f.IsPk ? "true" : "false") + ", " +
                     (f.IsIdent ? "true" : "false") + ", " +
                     Convert.ToString(f.StrLen) + ");\n");
            first = false;
        }
        b.Append("            ddl = ddl + \")\";\n" +
                 "            db.Execute(ddl);\n" +
                 "            return;\n" +
                 "        }\n" +
                 "        List<string> have = __DbBind.Cols(db, t);\n");
        for (int i = 0; i < fs.Count; i = i + 1) {
            DbField f = fs[i];
            if (f.Kind == 5) { continue; }
            b.Append("        if (!__DbBind.Has(have, \"" + f.Col +
                     "\")) {\n" +
                     "            db.Execute(\"ALTER TABLE \" + t + " +
                     "\" ADD COLUMN " + f.Col + " \"\n" +
                     "                + __DbBind.Ty(p, " +
                     Convert.ToString(GenDbEmit.TyCode(f.Kind)) +
                     ", false, false, " + Convert.ToString(f.StrLen) +
                     "));\n" +
                     "        }\n");
        }
        b.Append("    }\n");
        /* 异步孪生:同样的 DDL,await,非阻塞驱动可用 */
        b.Append("    static async void SyncAsync(IDbExecutor db) {\n" +
                 "        int p = db.GetProvider();\n" +
                 "        string t = \"" + tbl + "\";\n" +
                 "        bool exists = await __DbBind.HasTableAsync(db, t);\n" +
                 "        if (!exists) {\n" +
                 "            string ddl = \"CREATE TABLE \" + t + \" (\";\n");
        first = true;
        for (int i = 0; i < fs.Count; i = i + 1) {
            DbField f = fs[i];
            if (f.Kind == 5) { continue; }
            b.Append("            ddl = ddl + \"" +
                     (first ? "" : ", ") + f.Col + " \" + __DbBind.Ty(p, " +
                     Convert.ToString(GenDbEmit.TyCode(f.Kind)) + ", " +
                     (f.IsPk ? "true" : "false") + ", " +
                     (f.IsIdent ? "true" : "false") + ", " +
                     Convert.ToString(f.StrLen) + ");\n");
            first = false;
        }
        b.Append("            ddl = ddl + \")\";\n" +
                 "            int _c = await db.ExecuteAsync(ddl);\n" +
                 "            return;\n" +
                 "        }\n" +
                 "        List<string> have = await " +
                 "__DbBind.ColsAsync(db, t);\n");
        for (int i = 0; i < fs.Count; i = i + 1) {
            DbField f = fs[i];
            if (f.Kind == 5) { continue; }
            b.Append("        if (!__DbBind.Has(have, \"" + f.Col +
                     "\")) {\n" +
                     "            string alter = \"ALTER TABLE \" + t + " +
                     "\" ADD COLUMN " + f.Col + " \"\n" +
                     "                + __DbBind.Ty(p, " +
                     Convert.ToString(GenDbEmit.TyCode(f.Kind)) +
                     ", false, false, " + Convert.ToString(f.StrLen) + ");\n" +
                     "            int _a = await db.ExecuteAsync(alter);\n" +
                     "        }\n");
        }
        b.Append("    }\n}\n");
    }

    /// 汇总 __DbBind + 各实体类,产出整段生成源码。
    static void Run() {
        StringBuilder outb = new StringBuilder();
        List<string> need = GenDb.NeedNames;
        /* 生成的查询类拼写 lambda 槽类型 `Expr<T>`,它在 System.Linq;
         * 程序本身无需导入 */
        outb.Append("using System.Linq;\nusing System.Data.Orm;\n");
        outb.Append("class __DbBind {\n");
        for (int i = 0; i < need.Count; i = i + 1) {
            string cls = need[i];
            outb.Append("    static __DbQ_" + cls + " Q_" + cls +
                        "(IDbExecutor db) { return __DbQ_" + cls +
                        ".Create(db); }\n" +
                        "    static __DbI_" + cls + " I_" + cls +
                        "(IDbExecutor db) { return __DbI_" + cls +
                        ".Create(db); }\n" +
                        "    static __DbI_" + cls + " I_" + cls +
                        "(IDbExecutor db, " + cls + " o) { return __DbI_" +
                        cls + ".Create(db, o); }\n" +
                        "    static __DbI_" + cls + " I_" + cls +
                        "(IDbExecutor db, List<" + cls + "> l) { return " +
                        "__DbI_" + cls + ".Create(db, l); }\n" +
                        "    static __DbU_" + cls + " U_" + cls +
                        "(IDbExecutor db) { return __DbU_" + cls +
                        ".Create(db); }\n" +
                        "    static __DbD_" + cls + " D_" + cls +
                        "(IDbExecutor db) { return __DbD_" + cls +
                        ".Create(db); }\n" +
                        "    static void CF_" + cls + "(IDbExecutor db) { " +
                        "__DbCF_" + cls + ".Sync(db); }\n" +
                        "    static async void CFA_" + cls +
                        "(IDbExecutor db) { await __DbCF_" + cls +
                        ".SyncAsync(db); }\n");
        }
        if (GenDb.SyncAll) {
            outb.Append("    static void SyncAll(IDbExecutor db) {\n");
            for (int i = 0; i < need.Count; i = i + 1) {
                outb.Append("        CF_" + need[i] + "(db);\n");
            }
            outb.Append("    }\n");
            outb.Append("    static async void SyncAllAsync(IDbExecutor db) {\n");
            for (int i = 0; i < need.Count; i = i + 1) {
                outb.Append("        await CFA_" + need[i] + "(db);\n");
            }
            outb.Append("    }\n");
        }
        outb.Append("    static string M(int n) {\n" +
                    "        StringBuilder sb = new StringBuilder();\n" +
                    "        int i = 0;\n" +
                    "        while (i < n) {\n" +
                    "            if (i > 0) { sb.Append(\", \"); }\n" +
                    "            sb.Append(\"?\");\n" +
                    "            i = i + 1;\n" +
                    "        }\n" +
                    "        if (sb.Length == 0) { sb.Append(\"NULL\"); }\n" +
                    "        return sb.ToString();\n" +
                    "    }\n" +
                    "    static bool Has(List<string> l, string v) {\n" +
                    "        int i = 0;\n" +
                    "        while (i < l.Count) {\n" +
                    "            if (l[i] == v) { return true; }\n" +
                    "            i = i + 1;\n" +
                    "        }\n" +
                    "        return false;\n" +
                    "    }\n");
        /* UPDATE/DELETE 在 SQLite 等没有表别名,WHERE 构建器发的
         * `t.` 前缀在这里去掉 */
        outb.Append("    static string Unalias(string f) { return " +
                    "f.Replace(\"t.\", \"\"); }\n" +
                    "    static DbParams Cat(DbParams a, DbParams b) {\n" +
                    "        DbParams r = new DbParams();\n" +
                    "        __DbBind.CopyInto(a, r);\n" +
                    "        __DbBind.CopyInto(b, r);\n" +
                    "        return r;\n" +
                    "    }\n" +
                    "    static void CopyInto(DbParams src, DbParams dst) {\n" +
                    "        int i = 0;\n" +
                    "        while (i < src.Count()) {\n" +
                    "            int k = src.KindAt(i);\n" +
                    "            if (k == DbParams.KindInt) { " +
                    "dst.AddInt(src.IntAt(i)); }\n" +
                    "            else if (k == DbParams.KindDouble) { " +
                    "dst.AddDouble(src.DoubleAt(i)); }\n" +
                    "            else if (k == DbParams.KindText) { " +
                    "dst.Add(src.TextAt(i)); }\n" +
                    "            else { dst.AddNull(); }\n" +
                    "            i = i + 1;\n" +
                    "        }\n" +
                    "    }\n" +
                    "    static string LastIdSql(IDbExecutor db) {\n" +
                    "        int p = db.GetProvider();\n" +
                    "        string sql = \"SELECT last_insert_rowid()\";\n" +
                    "        if (p == DbProvider.MySQL || p == " +
                    "DbProvider.MariaDB) {\n" +
                    "            sql = \"SELECT LAST_INSERT_ID()\";\n" +
                    "        } else if (p == DbProvider.PostgreSQL " +
                    "|| p == DbProvider.OpenGauss || p == " +
                    "DbProvider.Kingbase) {\n" +
                    "            sql = \"SELECT lastval()\";\n" +
                    "        } else if (p == DbProvider.SqlServer || p == " +
                    "DbProvider.DM) {\n" +
                    "            sql = \"SELECT SCOPE_IDENTITY()\";\n" +
                    "        }\n" +
                    "        return sql;\n" +
                    "    }\n" +
                    "    static int LastId(IDbExecutor db) {\n" +
                    "        DbResult r = db.Query(__DbBind.LastIdSql(db));\n" +
                    "        if (r.RowCount() == 0) { return 0; }\n" +
                    "        return r.GetInt(0, 0);\n" +
                    "    }\n" +
                    "    static async int LastIdAsync(IDbExecutor db) {\n" +
                    "        string sql = __DbBind.LastIdSql(db);\n" +
                    "        DbResult r = await db.QueryAsync(sql);\n" +
                    "        if (r.RowCount() == 0) { return 0; }\n" +
                    "        return r.GetInt(0, 0);\n" +
                    "    }\n" +
                    "    static async bool HasTableAsync(IDbExecutor db, " +
                    "string t) {\n" +
                    "        string sql = __DbBind.HasTableSql(db);\n" +
                    "        DbResult r = await db.QueryAsync(sql, " +
                    "new DbParams().Add(t));\n" +
                    "        if (r.RowCount() == 0) { return false; }\n" +
                    "        return r.GetInt(0, 0) > 0;\n" +
                    "    }\n" +
                    "    static async List<string> ColsAsync(IDbExecutor db, " +
                    "string t) {\n" +
                    "        List<string> cols = new List<string>();\n" +
                    "        int p = db.GetProvider();\n" +
                    "        DbResult r;\n" +
                    "        int nameCol = 0;\n" +
                    "        if (p == DbProvider.SQLite) {\n" +
                    "            string ps = \"PRAGMA table_info(\" + t + " +
                    "\")\";\n" +
                    "            r = await db.QueryAsync(ps);\n" +
                    "            nameCol = 1;\n" +
                    "        } else {\n" +
                    "            string cs = \"SELECT column_name FROM" +
                    " information_schema.columns WHERE table_name = ?\"\n" +
                    "                + __DbBind.OwnScope(p);\n" +
                    "            r = await db.QueryAsync(cs, " +
                    "new DbParams().Add(t));\n" +
                    "        }\n" +
                    "        int i = 0;\n" +
                    "        while (i < r.RowCount()) {\n" +
                    "            cols.Add(r.GetString(i, nameCol));\n" +
                    "            i = i + 1;\n" +
                    "        }\n" +
                    "        return cols;\n" +
                    "    }\n");
        /* information_schema 横跨 MySQL 服务器上每个数据库(PostgreSQL/
         * SQL Server 上每个 schema),不加作用域会找到别人库里同名表,
         * CodeFirst 于是"改"一张这里不存在的表。每个目录探测都限定在
         * 连接自己的库/schema */
        outb.Append("    static string OwnScope(int p) {\n" +
                    "        if (p == DbProvider.MySQL || p == " +
                    "DbProvider.MariaDB) {\n" +
                    "            return \" AND table_schema = DATABASE()\";\n" +
                    "        }\n" +
                    "        if (p == DbProvider.PostgreSQL || p == " +
                    "DbProvider.OpenGauss\n" +
                    "                || p == DbProvider.Kingbase) {\n" +
                    "            return \" AND table_schema = " +
                    "current_schema()\";\n" +
                    "        }\n" +
                    "        if (p == DbProvider.SqlServer || p == " +
                    "DbProvider.DM) {\n" +
                    "            return \" AND table_schema = SCHEMA_NAME()\";\n" +
                    "        }\n" +
                    "        return \"\";\n" +
                    "    }\n" +
                    "    static string HasTableSql(IDbExecutor db) {\n" +
                    "        int p = db.GetProvider();\n" +
                    "        string sql = \"SELECT COUNT(*) FROM " +
                    "information_schema.tables" +
                    " WHERE table_name = ?\" + __DbBind.OwnScope(p);\n" +
                    "        if (p == DbProvider.SQLite) {\n" +
                    "            sql = \"SELECT COUNT(*) FROM sqlite_master " +
                    "WHERE" +
                    " type = 'table' AND name = ?\";\n" +
                    "        }\n" +
                    "        return sql;\n" +
                    "    }\n" +
                    "    static bool HasTable(IDbExecutor db, string t) {\n" +
                    "        int p = db.GetProvider();\n" +
                    "        string sql = \"SELECT COUNT(*) FROM " +
                    "information_schema.tables" +
                    " WHERE table_name = ?\" + __DbBind.OwnScope(p);\n" +
                    "        if (p == DbProvider.SQLite) {\n" +
                    "            sql = \"SELECT COUNT(*) FROM sqlite_master " +
                    "WHERE" +
                    " type = 'table' AND name = ?\";\n" +
                    "        }\n" +
                    "        DbResult r = db.Query(sql, " +
                    "new DbParams().Add(t));\n" +
                    "        if (r.RowCount() == 0) { return false; }\n" +
                    "        return r.GetInt(0, 0) > 0;\n" +
                    "    }\n" +
                    "    static List<string> Cols(IDbExecutor db, " +
                    "string t) {\n" +
                    "        List<string> cols = new List<string>();\n" +
                    "        int p = db.GetProvider();\n" +
                    "        DbResult r;\n" +
                    "        int nameCol = 0;\n" +
                    "        if (p == DbProvider.SQLite) {\n" +
                    "            r = db.Query(\"PRAGMA table_info(\" + t + " +
                    "\")\");\n" +
                    "            nameCol = 1;\n" +
                    "        } else {\n" +
                    "            r = db.Query(\"SELECT column_name FROM" +
                    " information_schema.columns WHERE table_name = ?\"\n" +
                    "                + __DbBind.OwnScope(p),\n" +
                    "                new DbParams().Add(t));\n" +
                    "        }\n" +
                    "        int i = 0;\n" +
                    "        while (i < r.RowCount()) {\n" +
                    "            cols.Add(r.GetString(i, nameCol));\n" +
                    "            i = i + 1;\n" +
                    "        }\n" +
                    "        return cols;\n" +
                    "    }\n");
        /* kind: 0 int/enum, 1 double, 2 bool, 3 string */
        outb.Append("    static string Ty(int p, int kind, bool pk, " +
                    "bool ident, int len) {\n" +
                    "        bool my = p == DbProvider.MySQL || p == " +
                    "DbProvider.MariaDB;\n" +
                    "        bool pg = p == DbProvider.PostgreSQL" +
                    " || p == DbProvider.OpenGauss || p == DbProvider.Kingbase;\n" +
                    "        bool ms = p == DbProvider.SqlServer || p == " +
                    "DbProvider.DM;\n" +
                    "        if (len <= 0) { len = 255; }\n" +
                    "        if (ident) {\n" +
                    "            if (my) { return \"INT NOT NULL " +
                    "AUTO_INCREMENT PRIMARY KEY\"; }\n" +
                    "            if (pg) { return \"SERIAL PRIMARY KEY\"; }\n" +
                    "            if (ms) { return \"INT IDENTITY(1,1) " +
                    "PRIMARY KEY\"; }\n" +
                    "            return \"INTEGER PRIMARY KEY AUTOINCREMENT\";\n" +
                    "        }\n" +
                    "        string t = \"INTEGER\";\n" +
                    "        if (kind == 1) {\n" +
                    "            t = \"DOUBLE PRECISION\";\n" +
                    "            if (my) { t = \"DOUBLE\"; }\n" +
                    "            if (ms) { t = \"FLOAT\"; }\n" +
                    "            if (p == DbProvider.SQLite) { t = \"REAL\"; }\n" +
                    "        } else if (kind == 2) {\n" +
                    "            t = \"BOOLEAN\";\n" +
                    "            if (my) { t = \"TINYINT(1)\"; }\n" +
                    "            if (ms) { t = \"BIT\"; }\n" +
                    "            if (p == DbProvider.SQLite) { t = " +
                    "\"INTEGER\"; }\n" +
                    "        } else if (kind == 3) {\n" +
                    "            t = \"VARCHAR(\" + Convert.ToString(len) + " +
                    "\")\";\n" +
                    "            if (p == DbProvider.SQLite) { t = \"TEXT\"; }\n" +
                    "            if (ms) { t = \"NVARCHAR(\" + " +
                    "Convert.ToString(len) + \")\"; }\n" +
                    "        } else {\n" +
                    "            if (my || ms) { t = \"INT\"; }\n" +
                    "        }\n" +
                    "        if (pk) { t = t + \" PRIMARY KEY\"; }\n" +
                    "        return t;\n" +
                    "    }\n" +
                    "}\n");
        for (int i = 0; i < need.Count; i = i + 1) {
            string cls = need[i];
            List<DbField> fs = GenDb.FieldsOf(cls, 0);
            GenDbEmit.GenCols(outb, cls, fs);
            GenDbEmit.GenEntity(outb, cls);
            GenDbEmit.GenInsert(outb, cls, fs, GenDb.TableOf(cls));
            GenDbEmit.GenUpdate(outb, cls, fs, GenDb.TableOf(cls));
            GenDbEmit.GenDelete(outb, cls, GenDb.TableOf(cls));
            GenDbEmit.GenCodeFirst(outb, cls, fs, GenDb.TableOf(cls));
        }
        GenCommon.AddSource(GenDb.Reply, "dbgen", outb);
    }
}
