// GenDbEmit.zan -- 实体绑定类文本生成。
//
// 编译期只发射「实体列元数据 + 薄类型门面」：
//   <Entity>Cols    列名常量 + Has/Kind/Require + OrmMeta（表名/列/导航/索引）
//   __DbQ_<E>       类型化 SELECT 门面(转发 OrmSelect,用实体类型收口结果)
//   __DbI_<E>       类型化 INSERT 门面(转发 OrmInsert)
//   __DbU_<E>       类型化 UPDATE 门面(转发 OrmUpdate)
//   __DbD_<E>       类型化 DELETE 门面(转发 OrmDelete)
//   __DbCF_<E>      CodeFirst 门面(转发 OrmSync)
//   __DbM_<E>       实体字段取值/赋值口(按列元数据分发到直接字段访问)
//   __DbB_<E>       IOrmRows 实现:把实体行交给运行期按列取值
// 以及汇总类 __DbBind(工厂方法 + SyncAll)。
//
// SQL 文本、动态列集合、参数绑定、行映射、方言差异、SQL 缓存都在
// System.Data.Orm 的共享实现里(OrmMeta/IOrmRows/OrmDialect/OrmSelect/
// OrmInsert/OrmUpdate/OrmDelete/OrmSync)：改 SQL 规则只改那一处，
// 用户工程加实体/加字段只多几行元数据，不再复制成段的 SQL 代码。
namespace System.Compiler;

class GenDbEmit {
    /// 声明类型是否是 64 位整数(需要 BIGINT 列与 64 位绑定/读取)。
    static bool Is64(string type) {
        return type == "long" || type == "ulong" || type == "nint";
    }

    static string Bl(bool v) { return v ? "true" : "false"; }

    /// 行的 Getter 名(按字段类型)——投影仍按目标类型直接取值。
    static string Getter(int kind) {
        if (kind == 0 || kind == 4) { return "GetInt"; }
        if (kind == 1) { return "GetDouble"; }
        if (kind == 2) { return "GetBool"; }
        return "GetString";
    }

    /// `m.Col(...)` 的实参文本：列名、字段名、类型码、是否 64 位、
    /// 主键、自增、非空、字符串长度。
    static string ColArgs(DbField f) {
        return "\"" + f.Col + "\", \"" + f.Name + "\", "
            + Convert.ToString(f.Kind) + ", "
            + GenDbEmit.Bl(GenDbEmit.Is64(f.TypeName)) + ", "
            + GenDbEmit.Bl(f.IsPk) + ", " + GenDbEmit.Bl(f.IsIdent) + ", "
            + GenDbEmit.Bl(f.NotNull) + ", " + Convert.ToString(f.StrLen);
    }

    /// 聚合/列投影终端:GenDb.Projs 里属于本实体的每个形状生成
    /// `Pj<N>()` / `Pj<N>Async()` / `Pj<N>One()` / `Pj<N>OneAsync()`,
    /// 结果映射到业务侧声明的目标类型(类型安全,业务侧不出现 SQL)。
    static void Projections(StringBuilder b, string cls) {
        for (int i = 0; i < GenDb.Projs.Count; i = i + 1) {
            JsonValue p = GenDb.Projs[i];
            if (p.Str("entity", "") != cls) { continue; }
            string t = p.Str("target", "");
            string nm = p.Str("name", "");
            JsonValue items = p.Get("items");
            if (items == null) { continue; }
            /* 列清单是一段生成侧的 string 表达式:固定片段是字面量,
             * 分组键(a.Key)是运行时的分组键 SQL */
            StringBuilder cols = new StringBuilder();
            StringBuilder lit = new StringBuilder();
            bool open = false;
            for (int k = 0; k < items.Count(); k = k + 1) {
                if (k > 0) { lit.Append(", "); }
                if (items.At(k).Bool("key", false)) {
                    if (lit.ToString().Length > 0) {
                        cols.Append((open ? " + " : "") + "\"" +
                                    lit.ToString() + "\"");
                        open = true;
                        lit = new StringBuilder();
                    }
                    cols.Append((open ? " + " : "") + "this.q.GroupKey()");
                    open = true;
                } else {
                    lit.Append(items.At(k).Str("col", ""));
                }
            }
            if (lit.ToString().Length > 0) {
                cols.Append((open ? " + " : "") + "\"" + lit.ToString() +
                            "\"");
                open = true;
            }
            if (!open) { cols.Append("\"\""); }
            b.Append("    List<" + t + "> " + nm + "Map(DbResult r) {\n" +
                     "        List<" + t + "> outp = new List<" + t +
                     ">();\n" +
                     "        int row = 0;\n" +
                     "        while (row < r.RowCount()) {\n" +
                     "            " + t + " o = new " + t + "();\n");
            for (int k = 0; k < items.Count(); k = k + 1) {
                JsonValue it = items.At(k);
                int kind = it.Int("kind", 0);
                string gtr = kind == 0 && it.Bool("i64", false)
                                 ? "GetLong"
                                 : GenDbEmit.Getter(kind);
                b.Append("            o." + it.Str("field", "") + " = r." +
                         gtr + "(row, " + Convert.ToString(k) + ");\n");
            }
            b.Append("            outp.Add(o);\n" +
                     "            row = row + 1;\n" +
                     "        }\n" +
                     "        return outp;\n" +
                     "    }\n");
            b.Append("    List<" + t + "> " + nm + "() {\n" +
                     "        return " + nm + "Map(this.q.Dto(" +
                     cols.ToString() + "));\n" +
                     "    }\n" +
                     "    async List<" + t + "> " + nm + "Async() {\n" +
                     "        DbResult r = await this.q.DtoAsync(" +
                     cols.ToString() + ");\n" +
                     "        return " + nm + "Map(r);\n" +
                     "    }\n" +
                     "    " + t + " " + nm + "One() {\n" +
                     "        this.q.One();\n" +
                     "        List<" + t + "> l = " + nm + "();\n" +
                     "        if (l.Count > 0) { return l[0]; }\n" +
                     "        return null;\n" +
                     "    }\n" +
                     "    async " + t + " " + nm + "OneAsync() {\n" +
                     "        this.q.One();\n" +
                     "        List<" + t + "> l = await " + nm + "Async();\n" +
                     "        if (l.Count > 0) { return l[0]; }\n" +
                     "        return null;\n" +
                     "    }\n");
        }
    }

    /// 实体的取值/赋值口 `__DbM_<T>` 与行来源 `__DbB_<T>`。列集合和 SQL
    /// 仍由运行期决定；这里仅把列元数据分发到实体的直接字段访问，避免为每个
    /// 实体拉入通用反射读写表。
    static bool Has(List<string> l, string v) {
        for (int i = 0; i < l.Count; i = i + 1) {
            if (l[i] == v) { return true; }
        }
        return false;
    }

    static void GenAccess(StringBuilder b, string cls) {
        List<DbField> fs = GenDb.FieldsOf(cls, 0);
        b.Append("class __DbM_" + cls + " {\n" +
                 "    static " + cls + " Read(List<OrmCol> cols, DbResult r, " +
                 "int row, int at0) {\n" +
                 "        " + cls + " o = new " + cls + "();\n" +
                 "        for (int i = 0; i < cols.Count; i = i + 1) {\n" +
                 "            OrmCol c = cols[i];\n" +
                 "            int at = at0 + i;\n");
        for (int i = 0; i < fs.Count; i = i + 1) {
            DbField f = fs[i];
            if (f.Kind == 5) { continue; }
            string getter = f.Kind == 0 && GenDbEmit.Is64(f.TypeName)
                ? "GetLong" : GenDbEmit.Getter(f.Kind);
            b.Append("            if (c.Field == \"" + f.Name + "\") { " +
                     "o." + f.Name + " = r." + getter +
                     "(row, at); }\n");
        }
        b.Append(
                 "        }\n" +
                 "        return o;\n" +
                 "    }\n" +
                 "    static void Bind(" + cls + " o, OrmCol c, " +
                 "DbParams ps) {\n");
        for (int i = 0; i < fs.Count; i = i + 1) {
            DbField f = fs[i];
            if (f.Kind == 5) { continue; }
            b.Append("        if (c.Field == \"" + f.Name + "\") {\n");
            if (f.Kind == 0) {
                string add = GenDbEmit.Is64(f.TypeName) ? "AddLong" : "AddInt";
                b.Append("            ps." + add + "(o." + f.Name + ");\n");
            } else if (f.Kind == 4) {
                b.Append("            int ev = o." + f.Name + ";\n" +
                         "            ps.AddInt(ev);\n");
            } else if (f.Kind == 1) {
                b.Append("            ps.AddDouble(o." + f.Name + ");\n");
            } else if (f.Kind == 2) {
                b.Append("            if (o." + f.Name +
                         ") { ps.AddInt(1); } else { ps.AddInt(0); }\n");
            } else {
                b.Append("            ps.Add(o." + f.Name + ");\n");
            }
            b.Append("            return;\n" +
                     "        }\n");
        }
        b.Append("    }\n" +
                 "}\n");
        b.Append("class __DbB_" + cls + " : IOrmRows {\n" +
                 "    List<" + cls + "> items;\n" +
                 "    static __DbB_" + cls + " New() {\n" +
                 "        __DbB_" + cls + " b = new __DbB_" + cls + "();\n" +
                 "        b.items = new List<" + cls + ">();\n" +
                 "        return b;\n" +
                 "    }\n" +
                 "    void Add(" + cls + " o) { this.items.Add(o); }\n" +
                 "    int RowCount() { return this.items.Count; }\n" +
                 "    void BindCol(int row, OrmCol c, DbParams ps) {\n" +
                 "        __DbM_" + cls + ".Bind(this.items[row], c, ps);\n" +
                 "    }\n" +
                 "}\n");
    }

    /// 只有标识符字符的名字才写进 DDL:索引名来自实体上的字面量,
    /// 但生成侧仍然自己把关,不把任何别的东西拼进语句。
    static bool IsIdent(string s) {
        if (s.Length == 0) { return false; }
        for (int i = 0; i < s.Length; i = i + 1) {
            char c = s[i];
            bool ok = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
                      || (c >= '0' && c <= '9') || c == '_';
            if (!ok) { return false; }
        }
        return true;
    }

    /// 实体 `[Index(Name=, Fields=, IsUnique=)]` -> 每条索引一行
    /// `m.Index(name, cols, unique)` 的实参文本。`Fields` 写的是实体
    /// 字段名,进语句的是它们的物理列名;既有表也补建缺失的索引
    /// (存在性由 OrmDialect 按方言判断)。
    static List<string> IndexArgs(string cls, List<DbField> fs, string tbl) {
        List<string> outl = new List<string>();
        List<JsonValue> attrs = GenDb.IndexAttrs(cls);
        for (int i = 0; i < attrs.Count; i = i + 1) {
            JsonValue a = attrs[i];
            List<string> parts = GenDb.AttrStr(a, "Fields").Split(",");
            StringBuilder cols = new StringBuilder();
            int n = 0;
            for (int k = 0; k < parts.Count; k = k + 1) {
                string fn = parts[k].Trim();
                if (fn.Length == 0) { continue; }
                DbField f = GenDb.FieldFind(fs, fn);
                if (f == null) {
                    GenDb.Diag(a, "Index: " + cls + " has no field " + fn);
                    return new List<string>();
                }
                if (n > 0) { cols.Append(", "); }
                cols.Append(f.Col);
                n = n + 1;
            }
            if (n == 0) {
                GenDb.Diag(a, "Index needs Fields = \"field, field\"");
                return new List<string>();
            }
            string nm = GenDb.AttrStr(a, "Name");
            if (nm.Length == 0) {
                nm = "ix_" + tbl + "_" + Convert.ToString(i + 1);
            }
            if (!GenDbEmit.IsIdent(nm)) {
                GenDb.Diag(a, "Index Name must be an identifier: " + nm);
                return new List<string>();
            }
            outl.Add("\"" + nm + "\", \"" + cols.ToString() + "\", "
                     + GenDbEmit.Bl(GenDb.AttrBool(a, "IsUnique", false)));
        }
        return outl;
    }

    /// `<Entity>Cols`:表名 + 列名常量 + Has/Kind/Require + 运行期元数据。
    /// 元数据只建一次(静态缓存),SQL 片段的缓存挂在它上面。
    static void GenCols(StringBuilder b, string cls, List<DbField> fs,
                        string tbl) {
        b.Append("class " + cls + "Cols {\n");
        /* 表名常量:让内省/运维接口拿到物理表名,而不是业务侧再写一遍
         * 字面量。实体自己有 Table 字段时让位给它。 */
        if (GenDb.FieldFind(fs, "Table") == null) {
            b.Append("    static string Table = \"" + tbl + "\";\n");
        }
        for (int i = 0; i < fs.Count; i = i + 1) {
            DbField f = fs[i];
            if (f.Kind == 5) { continue; }
            b.Append("    static string " + f.Name + " = \"" + f.Col +
                     "\";\n");
        }
        /* 运行期元数据:列、导航连接、索引 */
        b.Append("    static OrmMeta __M;\n" +
                 "    static List<int> __MGuard = new List<int>();\n" +
                 "    static OrmMeta __Meta() {\n" +
                 "        if (" + cls + "Cols.__M != null) { return " + cls +
                 "Cols.__M; }\n" +
                 "        lock (" + cls + "Cols.__MGuard) {\n" +
                 "            if (" + cls + "Cols.__M != null) { return " +
                 cls + "Cols.__M; }\n" +
                 "        OrmMeta m = OrmMeta.Of(\"" + cls + "\", \"" + tbl +
                 "\");\n");
        for (int i = 0; i < fs.Count; i = i + 1) {
            DbField f = fs[i];
            if (f.Kind == 5) { continue; }
            b.Append("        m.Col(" + GenDbEmit.ColArgs(f) + ");\n");
        }
        int nv = 0;
        for (int i = 0; i < fs.Count; i = i + 1) {
            DbField f = fs[i];
            if (f.Kind != 5) { continue; }
            string v = "n" + Convert.ToString(nv);
            b.Append("        OrmNav " + v + " = m.Nav(\"" + f.Name +
                     "\", \"" + GenDb.TableOf(f.TypeName) + "\");\n");
            List<DbField> nfs = GenDb.FieldsOf(f.TypeName, 0);
            for (int k = 0; k < nfs.Count; k = k + 1) {
                DbField g = nfs[k];
                if (g.Kind == 5) { continue; }
                b.Append("        " + v + ".Col(\"" + g.Col + "\", \"" +
                         g.Name + "\", " + Convert.ToString(g.Kind) + ", " +
                         GenDbEmit.Bl(GenDbEmit.Is64(g.TypeName)) + ");\n");
            }
            nv = nv + 1;
        }
        List<string> ixs = GenDbEmit.IndexArgs(cls, fs, tbl);
        for (int i = 0; i < ixs.Count; i = i + 1) {
            b.Append("        m.Index(" + ixs[i] + ");\n");
        }
        b.Append("        m.SelectList();\n" +
                 "        " + cls + "Cols.__M = m;\n" +
                 "        return " + cls + "Cols.__M;\n" +
                 "        }\n" +
                 "    }\n");
        b.Append("    static bool Has(string c) { return " + cls +
                 "Cols.__Meta().Has(c); }\n" +
                 "    static int Kind(string c) { return " + cls +
                 "Cols.__Meta().KindOf(c); }\n" +
                 "    static string Require(string c) { return " + cls +
                 "Cols.__Meta().Require(c); }\n" +
                 "}\n");
    }

    /// 查询门面 __DbQ_<E>:链式方法转发给 OrmSelect,只有行映射与终端
    /// 需要实体类型。
    static void GenEntity(StringBuilder b, string cls) {
        List<DbField> fs = GenDb.FieldsOf(cls, 0);
        string q = "__DbQ_" + cls;
        b.Append("class " + q + " {\n" +
                 "    OrmSelect q;\n" +
                 "    static " + q + " Create(IDbExecutor db) {\n" +
                 "        " + q + " r = new " + q + "();\n" +
                 "        r.q = OrmSelect.Create(db, " + cls +
                 "Cols.__Meta());\n" +
                 "        return r;\n" +
                 "    }\n");
        b.Append("    " + q + " W(string f) { this.q.W(f); return this; }\n" +
                 "    " + q + " Where(Expr<" + cls + "> e) {\n" +
                 "        if (e == null) { return this; }\n" +
                 "        this.q.WExpr(e.Root);\n" +
                 "        return this;\n" +
                 "    }\n" +
                 "    " + q + " WhereDict(DbValues v) { this.q.WhereDict(v); " +
                 "return this; }\n" +
                 "    " + q + " CondBegin(bool c) { this.q.CondBegin(c); " +
                 "return this; }\n" +
                 "    " + q + " CondEnd() { this.q.CondEnd(); return this; }\n" +
                 "    " + q + " AsTable(string t) { this.q.AsTable(t); " +
                 "return this; }\n" +
                 "    " + q + " P(string v) { this.q.P(v); return this; }\n" +
                 "    " + q + " Pi(int v) { this.q.Pi(v); return this; }\n" +
                 "    " + q + " Pl(long v) { this.q.Pl(v); return this; }\n" +
                 "    " + q + " Pd(double v) { this.q.Pd(v); return this; }\n" +
                 "    " + q + " InI(List<int> vs) { this.q.InI(vs); " +
                 "return this; }\n" +
                 "    " + q + " InL(List<long> vs) { this.q.InL(vs); " +
                 "return this; }\n" +
                 "    " + q + " InS(List<string> vs) { this.q.InS(vs); " +
                 "return this; }\n" +
                 "    " + q + " InD(List<double> vs) { this.q.InD(vs); " +
                 "return this; }\n" +
                 "    " + q + " OB(string col) { this.q.OB(col); " +
                 "return this; }\n" +
                 "    " + q + " OBD(string col) { this.q.OBD(col); " +
                 "return this; }\n" +
                 "    " + q + " GB(string col) { this.q.GB(col); " +
                 "return this; }\n" +
                 "    " + q + " OBK() { this.q.OBK(); return this; }\n" +
                 "    " + q + " OBDK() { this.q.OBDK(); return this; }\n" +
                 "    " + q + " H(string f) { this.q.H(f); return this; }\n" +
                 "    " + q + " DISTINCT() { this.q.DISTINCT(); " +
                 "return this; }\n" +
                 "    " + q + " Take(int n) { this.q.Take(n); return this; }\n" +
                 "    " + q + " Skip(int n) { this.q.SkipN(n); " +
                 "return this; }\n" +
                 "    " + q + " Limit(int n) { this.q.Take(n); " +
                 "return this; }\n" +
                 "    " + q + " Offset(int n) { this.q.SkipN(n); " +
                 "return this; }\n" +
                 "    " + q + " Page(int index, int size) { " +
                 "this.q.Page(index, size); return this; }\n");
        /* 导航字段:包含哪个连接由运行期的开关记着 */
        int nv = 0;
        for (int i = 0; i < fs.Count; i = i + 1) {
            if (fs[i].Kind != 5) { continue; }
            b.Append("    " + q + " Inc_" + fs[i].Name + "() { this.q.Include(" +
                     Convert.ToString(nv) + "); return this; }\n");
            nv = nv + 1;
        }
        /* 行映射:实体自身列由共享实现按元数据填,连接出来的实体只需要
         * 一处 new(类型在编译期才有) */
        b.Append("    List<" + cls + "> MapRows(DbResult r) {\n" +
                 "        List<" + cls + "> outp = new List<" + cls +
                 ">();\n" +
                 "        OrmMeta m = " + cls + "Cols.__Meta();\n" +
                 "        int row = 0;\n" +
                 "        while (row < r.RowCount()) {\n" +
                 "            " + cls + " o = __DbM_" + cls +
                 ".Read(m.Cols, r, row, 0);\n");
        nv = 0;
        for (int i = 0; i < fs.Count; i = i + 1) {
            if (fs[i].Kind != 5) { continue; }
            DbField f = fs[i];
            string ix = Convert.ToString(nv);
            b.Append("            if (this.q.NavOn(" + ix + ")) {\n" +
                     "                OrmNav nav" + ix + " = m.Navs[" + ix +
                     "];\n" +
                     "                int at" + ix + " = this.q.NavAt(" + ix +
                     ");\n" +
                     "                if (!r.IsNull(row, at" + ix +
                     " + nav" + ix + ".PkAt)) {\n" +
                     "                    o." + f.Name + " = __DbM_" +
                     f.TypeName + ".Read(nav" + ix + ".Cols, r, row, at" +
                     ix + ");\n" +
                     "                }\n" +
                     "            }\n");
            nv = nv + 1;
        }
        b.Append("            outp.Add(o);\n" +
                 "            row = row + 1;\n" +
                 "        }\n" +
                 "        return outp;\n" +
                 "    }\n");
        /* 终端:两个孪生版本,异步版给网络驱动,同步版给内嵌驱动 */
        b.Append("    List<" + cls + "> ToList() { return " +
                 "MapRows(this.q.Rows()); }\n" +
                 "    async List<" + cls + "> ToListAsync() {\n" +
                 "        DbResult r = await this.q.RowsAsync();\n" +
                 "        return MapRows(r);\n" +
                 "    }\n" +
                 "    List<string> ToListCol(string col) { return " +
                 "this.q.ToListCol(col); }\n" +
                 "    async List<string> ToListColAsync(string col) {\n" +
                 "        return await this.q.ToListColAsync(col);\n" +
                 "    }\n");
        GenDbEmit.Projections(b, cls);
        b.Append("    " + cls + " First() {\n" +
                 "        this.q.One();\n" +
                 "        List<" + cls + "> l = ToList();\n" +
                 "        if (l.Count > 0) { return l[0]; }\n" +
                 "        return null;\n" +
                 "    }\n" +
                 "    " + cls + " FirstOrDefault() { return First(); }\n" +
                 "    " + cls + " ToOne() { return First(); }\n" +
                 "    async " + cls + " FirstAsync() {\n" +
                 "        this.q.One();\n" +
                 "        List<" + cls + "> l = await ToListAsync();\n" +
                 "        if (l.Count > 0) { return l[0]; }\n" +
                 "        return null;\n" +
                 "    }\n" +
                 "    async " + cls + " FirstOrDefaultAsync() { return await " +
                 "FirstAsync(); }\n" +
                 "    async " + cls + " ToOneAsync() { return await " +
                 "FirstAsync(); }\n");
        b.Append("    int Count() { return this.q.Count(); }\n" +
                 "    async int CountAsync() { return await " +
                 "this.q.CountAsync(); }\n" +
                 "    bool Any() { return this.q.Any(); }\n" +
                 "    async bool AnyAsync() { return await " +
                 "this.q.AnyAsync(); }\n" +
                 "    DbResult AggR(string expr) { return " +
                 "this.q.AggR(expr); }\n" +
                 "    int AggI(string expr) { return this.q.AggI(expr); }\n" +
                 "    long AggL(string expr) { return this.q.AggL(expr); }\n" +
                 "    double AggD(string expr) { return " +
                 "this.q.AggD(expr); }\n" +
                 "    async DbResult AggRAsync(string expr) { return await " +
                 "this.q.AggRAsync(expr); }\n" +
                 "    async int AggIAsync(string expr) { return await " +
                 "this.q.AggIAsync(expr); }\n" +
                 "    async long AggLAsync(string expr) { return await " +
                 "this.q.AggLAsync(expr); }\n" +
                 "    async double AggDAsync(string expr) { return await " +
                 "this.q.AggDAsync(expr); }\n" +
                 "}\n");
    }

    /// 插入门面 __DbI_<E>:行列表/动态列/Only/Skip/Upsert 都转发给
    /// OrmInsert,只有实体类型的重载需要在这里。
    static void GenInsert(StringBuilder b, string cls, List<DbField> fs,
                          string tbl) {
        string q = "__DbI_" + cls;
        b.Append("class " + q + " {\n" +
                 "    OrmInsert q;\n" +
                 "    __DbB_" + cls + " rows;\n" +
                 "    static " + q + " Create(IDbExecutor db) {\n" +
                 "        " + q + " r = new " + q + "();\n" +
                 "        r.q = OrmInsert.Create(db, " + cls +
                 "Cols.__Meta());\n" +
                 "        r.rows = __DbB_" + cls + ".New();\n" +
                 "        r.q.SetRows(r.rows);\n" +
                 "        return r;\n" +
                 "    }\n" +
                 "    static " + q + " Create(IDbExecutor db, " + cls +
                 " o) { return " + q + ".Create(db).AppendData(o); }\n" +
                 "    static " + q + " Create(IDbExecutor db, List<" + cls +
                 "> l) { return " + q + ".Create(db).AppendData(l); }\n" +
                 "    " + q + " AppendData(" + cls + " o) { " +
                 "this.rows.Add(o); return this; }\n" +
                 "    " + q + " AppendData(List<" + cls + "> l) {\n" +
                 "        int i = 0;\n" +
                 "        while (i < l.Count) { this.rows.Add(l[i]); " +
                 "i = i + 1; }\n" +
                 "        return this;\n" +
                 "    }\n" +
                 "    " + q + " AppendDict(DbValues v) { this.q.AddDict(v); " +
                 "return this; }\n" +
                 "    " + q + " AppendDict(List<DbValues> l) {\n" +
                 "        int i = 0;\n" +
                 "        while (i < l.Count) { this.q.AddDict(l[i]); " +
                 "i = i + 1; }\n" +
                 "        return this;\n" +
                 "    }\n" +
                 "    " + q + " AsTable(string t) { this.q.AsTable(t); " +
                 "return this; }\n" +
                 "    " + q + " Only(string c) { this.q.Only(c); " +
                 "return this; }\n" +
                 "    " + q + " Skip(string c) { this.q.Skip(c); " +
                 "return this; }\n" +
                 "    " + q + " OC(string c) { this.q.OC(c); " +
                 "return this; }\n" +
                 "    " + q + " ACC(string c) { this.q.ACC(c); " +
                 "return this; }\n" +
                 "    " + q + " GMX(string c) { this.q.GMX(c); " +
                 "return this; }\n" +
                 "    " + q + " GMN(string c) { this.q.GMN(c); " +
                 "return this; }\n" +
                 "    " + q + " NOP() { this.q.NOP(); return this; }\n" +
                 "    int ExecuteAffrows() { return " +
                 "this.q.ExecuteAffrows(); }\n" +
                 "    async int ExecuteAffrowsAsync() { return await " +
                 "this.q.ExecuteAffrowsAsync(); }\n" +
                 "    int ExecuteIdentity() { return " +
                 "this.q.ExecuteIdentity(); }\n" +
                 "    async int ExecuteIdentityAsync() { return await " +
                 "this.q.ExecuteIdentityAsync(); }\n" +
                 "}\n");
    }

    /// 更新门面 __DbU_<E>：Set/SetIncr/Where 链转发给 OrmUpdate；
    /// 实体整体更新在运行期按元数据展开。
    static void GenUpdate(StringBuilder b, string cls, List<DbField> fs,
                          string tbl) {
        string q = "__DbU_" + cls;
        b.Append("class " + q + " {\n" +
                 "    OrmUpdate q;\n" +
                 "    static " + q + " Create(IDbExecutor db) {\n" +
                 "        " + q + " r = new " + q + "();\n" +
                 "        r.q = OrmUpdate.Create(db, " + cls +
                 "Cols.__Meta());\n" +
                 "        return r;\n" +
                 "    }\n" +
                 "    " + q + " AsTable(string t) { this.q.AsTable(t); " +
                 "return this; }\n" +
                 "    " + q + " Only(string c) { this.q.Only(c); " +
                 "return this; }\n" +
                 "    " + q + " Skip(string c) { this.q.Skip(c); " +
                 "return this; }\n" +
                 "    " + q + " SetDict(DbValues v) { this.q.SetDict(v); " +
                 "return this; }\n" +
                 "    " + q + " WhereDict(DbValues v) { this.q.WhereDict(v); " +
                 "return this; }\n" +
                 "    " + q + " CondBegin(bool c) { this.q.CondBegin(c); " +
                 "return this; }\n" +
                 "    " + q + " CondEnd() { this.q.CondEnd(); return this; }\n" +
                 "    " + q + " W(string f) { this.q.W(f); return this; }\n" +
                 "    " + q + " P(string v) { this.q.P(v); return this; }\n" +
                 "    " + q + " Pi(int v) { this.q.Pi(v); return this; }\n" +
                 "    " + q + " Pl(long v) { this.q.Pl(v); return this; }\n" +
                 "    " + q + " Pd(double v) { this.q.Pd(v); return this; }\n" +
                 "    " + q + " InI(List<int> vs) { this.q.InI(vs); " +
                 "return this; }\n" +
                 "    " + q + " InL(List<long> vs) { this.q.InL(vs); " +
                 "return this; }\n" +
                 "    " + q + " InS(List<string> vs) { this.q.InS(vs); " +
                 "return this; }\n" +
                 "    " + q + " InD(List<double> vs) { this.q.InD(vs); " +
                 "return this; }\n" +
                 "    " + q + " Frag(string f) { this.q.Frag(f); " +
                 "return this; }\n" +
                 "    " + q + " SetI(string c, int v) { this.q.SetI(c, v); " +
                 "return this; }\n" +
                 "    " + q + " SetL(string c, long v) { this.q.SetL(c, v); " +
                 "return this; }\n" +
                 "    " + q + " SetD(string c, double v) { " +
                 "this.q.SetD(c, v); return this; }\n" +
                 "    " + q + " SetS(string c, string v) { " +
                 "this.q.SetS(c, v); return this; }\n" +
                 "    " + q + " SetB(string c, bool v) { this.q.SetB(c, v); " +
                 "return this; }\n" +
                 "    " + q + " SetIncrI(string c, int v) { " +
                 "this.q.SetIncrI(c, v); return this; }\n" +
                 "    " + q + " SetIncrL(string c, long v) { " +
                 "this.q.SetIncrL(c, v); return this; }\n" +
                 "    " + q + " SetIncrD(string c, double v) { " +
                 "this.q.SetIncrD(c, v); return this; }\n" +
                 "    " + q + " SetSource(" + cls + " o) {\n" +
                 "        __DbB_" + cls + " b = __DbB_" + cls + ".New();\n" +
                 "        b.Add(o);\n" +
                 "        this.q.SetSource(b);\n" +
                 "        return this;\n" +
                 "    }\n" +
                 "    int ExecuteAffrows() { return " +
                 "this.q.ExecuteAffrows(); }\n" +
                 "    async int ExecuteAffrowsAsync() { return await " +
                 "this.q.ExecuteAffrowsAsync(); }\n" +
                 "}\n");
    }

    /// 删除门面 __DbD_<E>：Where 链转发给 OrmDelete。
    static void GenDelete(StringBuilder b, string cls, List<DbField> fs,
                          string tbl) {
        string q = "__DbD_" + cls;
        b.Append("class " + q + " {\n" +
                 "    OrmDelete q;\n" +
                 "    static " + q + " Create(IDbExecutor db) {\n" +
                 "        " + q + " r = new " + q + "();\n" +
                 "        r.q = OrmDelete.Create(db, " + cls +
                 "Cols.__Meta());\n" +
                 "        return r;\n" +
                 "    }\n" +
                 "    " + q + " AsTable(string t) { this.q.AsTable(t); " +
                 "return this; }\n" +
                 "    " + q + " CondBegin(bool c) { this.q.CondBegin(c); " +
                 "return this; }\n" +
                 "    " + q + " CondEnd() { this.q.CondEnd(); return this; }\n" +
                 "    " + q + " W(string f) { this.q.W(f); return this; }\n" +
                 "    " + q + " WhereDict(DbValues v) { this.q.WhereDict(v); " +
                 "return this; }\n" +
                 "    " + q + " P(string v) { this.q.P(v); return this; }\n" +
                 "    " + q + " Pi(int v) { this.q.Pi(v); return this; }\n" +
                 "    " + q + " Pl(long v) { this.q.Pl(v); return this; }\n" +
                 "    " + q + " Pd(double v) { this.q.Pd(v); return this; }\n" +
                 "    " + q + " InI(List<int> vs) { this.q.InI(vs); " +
                 "return this; }\n" +
                 "    " + q + " InL(List<long> vs) { this.q.InL(vs); " +
                 "return this; }\n" +
                 "    " + q + " InS(List<string> vs) { this.q.InS(vs); " +
                 "return this; }\n" +
                 "    " + q + " InD(List<double> vs) { this.q.InD(vs); " +
                 "return this; }\n" +
                 "    int ExecuteAffrows() { return " +
                 "this.q.ExecuteAffrows(); }\n" +
                 "    async int ExecuteAffrowsAsync() { return await " +
                 "this.q.ExecuteAffrowsAsync(); }\n" +
                 "}\n");
    }

    /// CodeFirst 门面 __DbCF_<E>：建表/加列/补索引都由 OrmSync 按元数据做。
    static void GenCodeFirst(StringBuilder b, string cls, List<DbField> fs,
                             string tbl) {
        b.Append("class __DbCF_" + cls + " {\n" +
                 "    static void Sync(IDbExecutor db) { OrmSync.Sync(db, " +
                 cls + "Cols.__Meta()); }\n" +
                 "    static async void SyncAsync(IDbExecutor db) { await " +
                 "OrmSync.SyncAsync(db, " + cls + "Cols.__Meta()); }\n" +
                 "}\n");
    }

    /// 汇总 __DbBind + 各实体类,产出整段生成源码。
    static void Run() {
        StringBuilder outb = new StringBuilder();
        List<string> need = GenDb.NeedNames;
        /* 生成的查询类拼写 lambda 槽类型 `Expr<T>`,它在 System.Linq;
         * 程序本身无需导入 */
        outb.Append("using System.Linq;\nusing System.Data.Orm;\n");
        outb.Append("class __DbBind {\n" +
                    /* 重写后的 WHERE 片段用它拼 IN 列表的占位符 */
                    "    static string M(int n) { return OrmDialect.Marks(n); }\n");
        for (int i = 0; i < need.Count; i = i + 1) {
            string cls = need[i];
            outb.Append("    static __DbQ_" + cls + " Q_" + cls +
                        "(IDbExecutor db) { return __DbQ_" + cls +
                        ".Create(db); }\n" +
                        "    static __DbI_" + cls + " I_" + cls +
                        "(IDbExecutor db) { return __DbI_" + cls +
                        ".Create(db); }\n" +
                        "    static __DbI_" + cls + " I_" + cls +
                        "(IDbExecutor db, " + cls + " o) { return __DbI_" +
                        cls + ".Create(db, o); }\n" +
                        "    static __DbI_" + cls + " I_" + cls +
                        "(IDbExecutor db, List<" + cls + "> l) { return " +
                        "__DbI_" + cls + ".Create(db, l); }\n" +
                        "    static __DbU_" + cls + " U_" + cls +
                        "(IDbExecutor db) { return __DbU_" + cls +
                        ".Create(db); }\n" +
                        "    static __DbD_" + cls + " D_" + cls +
                        "(IDbExecutor db) { return __DbD_" + cls +
                        ".Create(db); }\n" +
                        "    static void CF_" + cls + "(IDbExecutor db) { " +
                        "__DbCF_" + cls + ".Sync(db); }\n" +
                        "    static async void CFA_" + cls +
                        "(IDbExecutor db) { await __DbCF_" + cls +
                        ".SyncAsync(db); }\n");
        }
        if (GenDb.SyncAll) {
            outb.Append("    static void SyncAll(IDbExecutor db) {\n");
            for (int i = 0; i < need.Count; i = i + 1) {
                outb.Append("        CF_" + need[i] + "(db);\n");
            }
            outb.Append("    }\n");
            outb.Append("    static async void SyncAllAsync(IDbExecutor db) {\n");
            for (int i = 0; i < need.Count; i = i + 1) {
                outb.Append("        await CFA_" + need[i] + "(db);\n");
            }
            outb.Append("    }\n");
        }
        outb.Append("}\n");
        /* 取值/赋值口:实体本身以及被 Include 的导航实体都要有一份 */
        List<string> acc = new List<string>();
        for (int i = 0; i < need.Count; i = i + 1) {
            if (!GenDbEmit.Has(acc, need[i])) { acc.Add(need[i]); }
            List<DbField> nfs = GenDb.FieldsOf(need[i], 0);
            for (int j = 0; j < nfs.Count; j = j + 1) {
                if (nfs[j].Kind != 5) { continue; }
                if (!GenDbEmit.Has(acc, nfs[j].TypeName)) {
                    acc.Add(nfs[j].TypeName);
                }
            }
        }
        for (int i = 0; i < acc.Count; i = i + 1) {
            GenDbEmit.GenAccess(outb, acc[i]);
        }
        for (int i = 0; i < need.Count; i = i + 1) {
            string cls = need[i];
            List<DbField> fs = GenDb.FieldsOf(cls, 0);
            string tbl = GenDb.TableOf(cls);
            GenDbEmit.GenCols(outb, cls, fs, tbl);
            GenDbEmit.GenEntity(outb, cls);
            GenDbEmit.GenInsert(outb, cls, fs, tbl);
            GenDbEmit.GenUpdate(outb, cls, fs, tbl);
            GenDbEmit.GenDelete(outb, cls, fs, tbl);
            GenDbEmit.GenCodeFirst(outb, cls, fs, tbl);
        }
        GenCommon.AddSource(GenDb.Reply, "dbgen", outb);
    }
}
