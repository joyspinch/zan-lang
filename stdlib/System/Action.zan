using System;

namespace System;

// 封装一个不返回值的委托（0 参形态由编译器内建合成）。
// C# 同名委托族：泛型 arity 1 的 Action/Func 与 Predicate 由本文件声明遮蔽
// 内建合成。多参请求（Action<T1,T2>、Func<T1,T2,TResult> 等）由编译器按
// 泛型 arity 独立合成同名委托，互赋不同 arity 正确报 E2024。
public delegate void Action<in T>(T arg);

// 封装一个带单一参数并返回 TResult 结果的委托。
public delegate TResult Func<in T, out TResult>(T arg);

// 封装一个定义一组条件并确定指定对象是否符合这些条件的方法。
public delegate bool Predicate<in T>(T obj);
