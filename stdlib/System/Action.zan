using System;

namespace System;

// 封装一个不带参数且不返回值的委托。
public delegate void Action();

// 封装一个带单一泛型参数且不返回值的委托。
public delegate void ActionT<T>(T arg);

// 封装一个带两个泛型参数且不返回值的委托。
public delegate void ActionT2<T1, T2>(T1 arg1, T2 arg2);

// 封装一个不带参数并返回 TResult 类型结果的委托。
public delegate TResult Func<TResult>();

// 封装一个带单一泛型参数并返回 TResult 类型结果的委托。
public delegate TResult FuncT<T, TResult>(T arg);

// 封装一个带两个泛型参数并返回 TResult 类型结果的委托。
public delegate TResult FuncT2<T1, T2, TResult>(T1 arg1, T2 arg2);

// 封装一个定义一组条件并确定指定对象是否符合这些条件的方法。
public delegate bool PredicateT<T>(T obj);
