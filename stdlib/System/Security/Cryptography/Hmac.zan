using System;

namespace System.Security.Cryptography;

/// <summary>基于本命名空间中 SHA/MD5/SM3 原语的 HMAC（RFC 2104）。
/// 所有支持的哈希均使用 64 字节分组。</summary>
class Hmac {
    static int SHA256 = 0;
    static int SHA1   = 1;
    static int SM3    = 2;
    static int MD5    = 3;

    static int digestLen(int algo) {
        if (algo == 1) { return 20; }
        if (algo == 3) { return 16; }
        return 32;
    }

    static byte[] hashOf(int algo, string buf, int len) {
        if (algo == 1) { return Sha1.Hash(buf, len); }
        if (algo == 2) { return Sm3.Hash(buf, len); }
        if (algo == 3) { return Md5.Hash(buf, len); }
        return Sha256.Hash(buf, len);
    }

    /// <summary>按所选算法计算 HMAC（0=SHA256、1=SHA1、
    /// 2=SM3、3=MD5）。摘要长度等于底层哈希的输出
    /// 长度。</summary>
    static byte[] Compute(int algo, string key, int keyLen, string msg, int msgLen) {
        int dlen = digestLen(algo);
        byte[] k0 = new byte[64];
        if (keyLen > 64) {
            byte[] hk = hashOf(algo, key, keyLen);
             for (int i = 0; i < dlen; i = i + 1) { k0[i] = hk[i] & 255; }
        } else {
             for (int i = 0; i < keyLen; i = i + 1) { k0[i] = key[i] & 255; }
        }
        byte[] inner = new byte[64 + msgLen];
        int j = 0;
        for (; j < 64; j = j + 1) { inner[j] = (k0[j] ^ 54) & 255; }   // ipad 0x36
        j = 0;
        while (j < msgLen) { inner[64 + j] = msg[j] & 255; j = j + 1; }
        byte[] ih = hashOf(algo, inner, 64 + msgLen);
        byte[] outer = new byte[64 + dlen];
        j = 0;
        while (j < 64) { outer[j] = (k0[j] ^ 92) & 255; j = j + 1; }    // opad 0x5c
        j = 0;
        while (j < dlen) { outer[64 + j] = ih[j] & 255; j = j + 1; }
        return hashOf(algo, outer, 64 + dlen);
    }

    static byte[] Sha256Mac(string key, int keyLen, string msg, int msgLen) {
        return Compute(0, key, keyLen, msg, msgLen);
    }
}
