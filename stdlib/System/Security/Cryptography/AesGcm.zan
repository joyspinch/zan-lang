using System;
using System.Security.Cryptography;

namespace System.Security.Cryptography;

/// <summary>100% 纯 Zan 自举实现的 AES-GCM（NIST SP 800-38D）认证加密。
/// 支持 96 位 IV（J0 = IV || 0^31 || 1），支持 128/192/256 位密钥。
/// 严格遵循常数时间认证校验，认证失败绝不产出明文。
/// 零 C 语言、零 OpenSSL 依赖。</summary>
class AesGcm {
    /// 从 buf[off..] 读取 8 个大端字节到一个 64 位字
    static long load64(string buf, int off) {
        long v = 0;
        for (int i = 0; i < 8; i = i + 1) { v = (v << 8) | (buf[off + i] & 255); }
        return v;
    }

    /// 64 位字按大端写入 buf 的 off 处。
    static void store64(byte[] buf, int off, long v) {
        for (int i = 0; i < 8; i = i + 1) { buf[off + i] = (byte)(Bits.Shr64(v, 8 * (7 - i)) & 255); }
    }

    /// GF(2^128) 乘法：X、Y 按 [hi,lo] 表示；返回 [hi,lo]
    static List<long> gfmul(List<long> X, List<long> Y) {
        long zhi = 0; long zlo = 0;
        long vhi = Y[0]; long vlo = Y[1];
        long poly = 225;
        for (int i = 0; i < 128; i = i + 1) {
            int bit = 0;
            if (i < 64) { bit = (int)(Bits.Shr64(X[0], 63 - i) & 1); }
            else { bit = (int)(Bits.Shr64(X[1], 63 - (i - 64)) & 1); }
            if (bit == 1) { zhi = zhi ^ vhi; zlo = zlo ^ vlo; }
            long lsb = vlo & 1;
            vlo = Bits.Shr64(vlo, 1) | ((vhi & 1) << 63);
            vhi = Bits.Shr64(vhi, 1);
            if (lsb == 1) { vhi = vhi ^ (poly << 56); }
        }
        List<long> r = new List<long>(); r.Add(zhi); r.Add(zlo);
        return r;
    }

    /// Y = (Y xor block) * H，其中 block 是 buf[off..] 处 16 字节，不足补零
    static List<long> ghashBlock(List<long> Y, string buf, int off, int avail, List<long> H) {
        byte[] blk = new byte[16];
        for (int i = 0; i < 16; i = i + 1) {
            if (i < avail) { blk[i] = (byte)(buf[off + i] & 255); } else { blk[i] = 0; }
        }
        string blkStr = blk;
        List<long> x = new List<long>{
            Y[0] ^ load64(blkStr, 0),
            Y[1] ^ load64(blkStr, 8) };
        return gfmul(x, H);
    }

    /// GHASH 硬件快路径（PCLMUL/PMULL 流式内核）：AAD 段、密文段
    /// 再接长度块在 C 端 SIMD 寄存器流水线一次性完成，避免逐块跨语言与内存拷贝。
    static List<long> hwGhash(List<long> H, string aad, int aadLen, string data, int dataLen) {
        byte[] hBlk = new byte[16];
        store64(hBlk, 0, H[0]);
        store64(hBlk, 8, H[1]);
        string hStr = hBlk;
        byte[] yb = new byte[16];
        string yStr = yb;

        if (aadLen > 0) {
            if (NativeMemory.GhashUpdate(hStr, aad, (long)aadLen, yStr) != 0) { return null; }
        }
        if (dataLen > 0) {
            if (NativeMemory.GhashUpdate(hStr, data, (long)dataLen, yStr) != 0) { return null; }
        }
        // 长度块：[aadBits(64) | dataBits(64)]
        byte[] xb = new byte[16];
        store64(xb, 0, (long)aadLen * 8);
        store64(xb, 8, (long)dataLen * 8);
        string xStr = xb;
        if (NativeMemory.GhashUpdate(hStr, xStr, 16, yStr) != 0) { return null; }
        List<long> r = new List<long>(); r.Add(load64(yStr, 0)); r.Add(load64(yStr, 8));
        return r;
    }

    /// GHASH：AAD 块、密文块再接长度块，在 GF(2^128) 上逐块累乘 H。
    static List<long> ghash(List<long> H, string aad, int aadLen, string data, int dataLen) {
        List<long> hw = hwGhash(H, aad, aadLen, data, dataLen);
        if (hw != null) { return hw; }

        List<long> Y = new List<long>(); Y.Add(0); Y.Add(0);
        int p = 0;
        while (p < aadLen) {
            int avail = aadLen - p; if (avail > 16) { avail = 16; }
            Y = ghashBlock(Y, aad, p, avail, H);
            p = p + 16;
        }
        p = 0;
        while (p < dataLen) {
            int avail = dataLen - p; if (avail > 16) { avail = 16; }
            Y = ghashBlock(Y, data, p, avail, H);
            p = p + 16;
        }
        // 长度块：[aadBits(64) | dataBits(64)]
        byte[] lb = new byte[16];
        store64(lb, 0, (long)aadLen * 8);
        store64(lb, 8, (long)dataLen * 8);
        string lbStr = lb;
        List<long> x = new List<long>{
            Y[0] ^ load64(lbStr, 0),
            Y[1] ^ load64(lbStr, 8) };
        return gfmul(x, H);
    }

    /// 计数器块的低 32 位（第 12..15 字节，大端）加一。
    static void inc32(byte[] ctr) {
        int i = 15;
        int carry = 1;
        while (i >= 12 && carry == 1) {
            int v = (ctr[i] & 255) + carry;
            ctr[i] = (byte)(v & 255);
            carry = (v >> 8) & 1;
            i = i - 1;
        }
    }

    /// GCTR：由 AES(counter) 生成密钥流，与数据异或（原地写入 out）
    static void gctr(string key, int keyLen, string ctr, string data, int dataLen, byte[] outb) {
        /* 硬件快路径：整段 keystream 异或一次完成，计数器在副本上原地
           前进。无硬件（-1）落回下方纯 Zan 逐块循环。 */
        if (dataLen > 0) {
            byte[] cnt = new byte[16];
            for (int i = 0; i < 16; i = i + 1) { cnt[i] = (byte)(ctr[i] & 255); }
            string cntStr = cnt;
            long got = NativeMemory.AesCtrCrypt(outb, data, (long)dataLen, key, keyLen * 8, cntStr);
            if (got >= 0) { return; }
        }

        byte[] cnt2 = new byte[16];
        for (int i = 0; i < 16; i = i + 1) { cnt2[i] = (byte)(ctr[i] & 255); }
        int p = 0;
        while (p < dataLen) {
            string cntStr = cnt2;
            byte[] ks = Aes.EncryptBlockEcb(key, keyLen, cntStr);
            int avail = dataLen - p; if (avail > 16) { avail = 16; }
            for (int j = 0; j < avail; j = j + 1) {
                outb[p + j] = (byte)((data[p + j] & 255) ^ (ks[j] & 255));
            }
            inc32(cnt2);
            p = p + 16;
        }
    }

    /// <summary>AES-GCM 加密，使用 96 位（12 字节）IV。密文（与明文等长）写入返回值，
    /// 16 字节 tag 写入 <paramref name="tagOut"/>。参数不合法时返回 null。</summary>
    static byte[] Encrypt(string key, int keyLen, string iv, string aad, int aadLen, string pt, int ptLen, string tagOut) {
        if (keyLen != 16 && keyLen != 24 && keyLen != 32) { return null; }
        if (aadLen < 0 || ptLen < 0) { return null; }
        if (iv == null || tagOut == null) { return null; }
        if (aadLen > 0 && aad == null) { return null; }
        if (ptLen > 0 && pt == null) { return null; }

        byte[] zero = new byte[16];
        string zeroStr = zero;
        byte[] Hb = Aes.EncryptBlockEcb(key, keyLen, zeroStr);
        string HbStr = Hb;
        List<long> H = new List<long>(); H.Add(load64(HbStr, 0)); H.Add(load64(HbStr, 8));

        // J0 = IV || 0^31 || 1
        byte[] j0 = new byte[16];
        int i = 0; for (; i < 12; i = i + 1) { j0[i] = (byte)(iv[i] & 255); }
        j0[15] = 1;

        byte[] ct = new byte[ptLen];
        byte[] ctr = new byte[16];
        i = 0; while (i < 16) { ctr[i] = j0[i]; i = i + 1; }
        inc32(ctr);
        string ctrStr = ctr;
        gctr(key, keyLen, ctrStr, pt, ptLen, ct);

        string ctStr = ct;
        List<long> S = ghash(H, aad, aadLen, ctStr, ptLen);
        byte[] sb = new byte[16];
        store64(sb, 0, S[0]); store64(sb, 8, S[1]);
        string j0Str = j0;
        byte[] ej0 = Aes.EncryptBlockEcb(key, keyLen, j0Str);
        i = 0; while (i < 16) { tagOut[i] = (char)((ej0[i] & 255) ^ (sb[i] & 255)); i = i + 1; }
        return ct;
    }

    /// <summary>AES-GCM 解密，使用 96 位 IV。校验通过时返回明文并将 <paramref name="ok"/>[0] 置 -1；
    /// tag/aad/密文被篡改时返回 null 并将 <paramref name="ok"/>[0] 置 0。
    /// 常数时间防时序攻击，认证失败绝不产出明文。</summary>
    static byte[] Decrypt(string key, int keyLen, string iv, string aad, int aadLen, string ct, int ctLen, string tag, List<int> ok) {
        if (keyLen != 16 && keyLen != 24 && keyLen != 32) { ok[0] = 0; return null; }
        if (aadLen < 0 || ctLen < 0) { ok[0] = 0; return null; }
        if (iv == null || tag == null || ok == null) { ok[0] = 0; return null; }
        if (aadLen > 0 && aad == null) { ok[0] = 0; return null; }
        if (ctLen > 0 && ct == null) { ok[0] = 0; return null; }

        byte[] zero = new byte[16];
        string zeroStr = zero;
        byte[] Hb = Aes.EncryptBlockEcb(key, keyLen, zeroStr);
        string HbStr = Hb;
        List<long> H = new List<long>(); H.Add(load64(HbStr, 0)); H.Add(load64(HbStr, 8));

        byte[] j0 = new byte[16];
        int i = 0; for (; i < 12; i = i + 1) { j0[i] = (byte)(iv[i] & 255); }
        j0[15] = 1;

        List<long> S = ghash(H, aad, aadLen, ct, ctLen);
        byte[] sb = new byte[16];
        store64(sb, 0, S[0]); store64(sb, 8, S[1]);
        string j0Str = j0;
        byte[] ej0 = Aes.EncryptBlockEcb(key, keyLen, j0Str);

        int diff = 0;
        i = 0;
        while (i < 16) {
            int t = (ej0[i] & 255) ^ (sb[i] & 255);
            diff = diff | (t ^ (tag[i] & 255));
            i = i + 1;
        }
        if (diff != 0) {
            ok[0] = 0;
            return null;
        }

        byte[] pt = new byte[ctLen];
        byte[] ctr = new byte[16];
        i = 0; while (i < 16) { ctr[i] = j0[i]; i = i + 1; }
        inc32(ctr);
        string ctrStr = ctr;
        gctr(key, keyLen, ctrStr, ct, ctLen, pt);

        ok[0] = -1;
        return pt;
    }
}
