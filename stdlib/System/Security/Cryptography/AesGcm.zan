using System;

namespace System.Security.Cryptography;

/// <summary>AES-GCM (NIST SP 800-38D) authenticated encryption in pure Zan.
/// Only the common 96-bit IV form is supported (J0 = IV || 0^31 || 1). A
/// 128-bit block is carried as two 64-bit halves (longs); GF(2^128)
/// multiplication uses the right-shift algorithm with reduction polynomial
/// R = 0xE1||0^120.</summary>
class AesGcm {
    // load 8 big-endian bytes from buf[off..] into a 64-bit word
    static long load64(string buf, int off) {
        long v = 0; int i = 0;
        while (i < 8) { v = (v << 8) | (buf[off + i] & 255); i = i + 1; }
        return v;
    }
    static void store64(byte[] buf, int off, long v) {
        int i = 0;
        while (i < 8) { buf[off + i] = Bits.Shr64(v, 8 * (7 - i)) & 255; i = i + 1; }
    }

    // GF(2^128) multiply: X,Y as [hi,lo]; returns [hi,lo]
    static List<long> gfmul(List<long> X, List<long> Y) {
        long zhi = 0; long zlo = 0;
        long vhi = Y[0]; long vlo = Y[1];
        long poly = 225;
        int i = 0;
        while (i < 128) {
            int bit = 0;
            if (i < 64) { bit = Bits.Shr64(X[0], 63 - i) & 1; }
            else { bit = Bits.Shr64(X[1], 63 - (i - 64)) & 1; }
            if (bit == 1) { zhi = zhi ^ vhi; zlo = zlo ^ vlo; }
            long lsb = vlo & 1;
            // V >>= 1 across the 128-bit pair (logical)
            vlo = Bits.Shr64(vlo, 1) | ((vhi & 1) << 63);
            vhi = Bits.Shr64(vhi, 1);
            if (lsb == 1) { vhi = vhi ^ (poly << 56); }
            i = i + 1;
        }
        List<long> r = new List<long>(); r.Add(zhi); r.Add(zlo);
        return r;
    }

    // Y = (Y xor block) * H, where block is 16 bytes at buf[off..], zero-padded
    static List<long> ghashBlock(List<long> Y, string buf, int off, int avail, List<long> H) {
        byte[] blk = new byte[16];
        int i = 0;
        while (i < 16) {
            if (i < avail) { blk[i] = buf[off + i] & 255; } else { blk[i] = 0; }
            i = i + 1;
        }
        List<long> x = new List<long>();
        x.Add(Y[0] ^ load64(blk, 0));
        x.Add(Y[1] ^ load64(blk, 8));
        return gfmul(x, H);
    }

    static List<long> ghash(List<long> H, string aad, int aadLen, string data, int dataLen) {
        List<long> Y = new List<long>(); Y.Add(0); Y.Add(0);
        int p = 0;
        while (p < aadLen) {
            int avail = aadLen - p; if (avail > 16) { avail = 16; }
            Y = ghashBlock(Y, aad, p, avail, H);
            p = p + 16;
        }
        p = 0;
        while (p < dataLen) {
            int avail = dataLen - p; if (avail > 16) { avail = 16; }
            Y = ghashBlock(Y, data, p, avail, H);
            p = p + 16;
        }
        // length block: [aadBits(64) | dataBits(64)]
        byte[] lb = new byte[16];
        store64(lb, 0, (long)aadLen * 8);
        store64(lb, 8, (long)dataLen * 8);
        List<long> x = new List<long>();
        x.Add(Y[0] ^ load64(lb, 0));
        x.Add(Y[1] ^ load64(lb, 8));
        return gfmul(x, H);
    }

    static void inc32(byte[] ctr) {
        int i = 15;
        int carry = 1;
        while (i >= 12 && carry == 1) {
            int v = (ctr[i] & 255) + carry;
            ctr[i] = v & 255;
            carry = (v >> 8) & 1;
            i = i - 1;
        }
    }

    // GCTR: keystream from AES(counter), xored into data (in place into out)
    static void gctr(string key, int keyLen, string ctr, string data, int dataLen, byte[] outb) {
        byte[] cnt = new byte[16];
        int i = 0; while (i < 16) { cnt[i] = ctr[i] & 255; i = i + 1; }
        int p = 0;
        while (p < dataLen) {
            byte[] ks = Aes.EncryptBlockEcb(key, keyLen, cnt);
            int avail = dataLen - p; if (avail > 16) { avail = 16; }
            int j = 0;
            while (j < avail) { outb[p + j] = (data[p + j] & 255) ^ (ks[j] & 255); j = j + 1; }
            inc32(cnt);
            p = p + 16;
        }
    }

    /// <summary>AES-GCM encrypt with a 96-bit (12-byte) IV. Writes the ciphertext
    /// (same length as plaintext) to the return value and the 16-byte tag into
    /// <paramref name="tagOut"/>.</summary>
    static byte[] Encrypt(string key, int keyLen, string iv, string aad, int aadLen, string pt, int ptLen, string tagOut) {
        byte[] zero = new byte[16];
        byte[] Hb = Aes.EncryptBlockEcb(key, keyLen, zero);
        List<long> H = new List<long>(); H.Add(load64(Hb, 0)); H.Add(load64(Hb, 8));

        // J0 = IV || 0^31 || 1
        byte[] j0 = new byte[16];
        int i = 0; while (i < 12) { j0[i] = iv[i] & 255; i = i + 1; }
        j0[15] = 1;

        byte[] ct = new byte[ptLen];
        byte[] ctr = new byte[16];
        i = 0; while (i < 16) { ctr[i] = j0[i] & 255; i = i + 1; }
        inc32(ctr);
        gctr(key, keyLen, ctr, pt, ptLen, ct);

        List<long> S = ghash(H, aad, aadLen, ct, ptLen);
        byte[] sb = new byte[16];
        store64(sb, 0, S[0]); store64(sb, 8, S[1]);
        byte[] ej0 = Aes.EncryptBlockEcb(key, keyLen, j0);
        i = 0; while (i < 16) { tagOut[i] = (ej0[i] & 255) ^ (sb[i] & 255); i = i + 1; }
        return ct;
    }

    /// <summary>AES-GCM decrypt with a 96-bit IV. Returns the plaintext and sets
    /// <paramref name="ok"/>[0] to -1 (true) if the tag verifies, else 0.</summary>
    static byte[] Decrypt(string key, int keyLen, string iv, string aad, int aadLen, string ct, int ctLen, string tag, List<int> ok) {
        byte[] zero = new byte[16];
        byte[] Hb = Aes.EncryptBlockEcb(key, keyLen, zero);
        List<long> H = new List<long>(); H.Add(load64(Hb, 0)); H.Add(load64(Hb, 8));

        byte[] j0 = new byte[16];
        int i = 0; while (i < 12) { j0[i] = iv[i] & 255; i = i + 1; }
        j0[15] = 1;

        List<long> S = ghash(H, aad, aadLen, ct, ctLen);
        byte[] sb = new byte[16];
        store64(sb, 0, S[0]); store64(sb, 8, S[1]);
        byte[] ej0 = Aes.EncryptBlockEcb(key, keyLen, j0);
        int diff = 0;
        i = 0;
        while (i < 16) {
            int t = (ej0[i] & 255) ^ (sb[i] & 255);
            diff = diff | (t ^ (tag[i] & 255));
            i = i + 1;
        }
        byte[] pt = new byte[ctLen];
        byte[] ctr = new byte[16];
        i = 0; while (i < 16) { ctr[i] = j0[i] & 255; i = i + 1; }
        inc32(ctr);
        gctr(key, keyLen, ctr, ct, ctLen, pt);

        if (diff == 0) { ok[0] = -1; } else { ok[0] = 0; }
        return pt;
    }
}
