using System;

namespace System.Security.Cryptography;

/// <summary>
/// CRC-32C（Castagnoli，多项式 0x82F63B78）。
/// 工业级现代标准（ZanDB、RocksDB、Kafka、iSCSI、SCTP）。
/// 当输入为连续内存或字节数组时，优先使用底层 NativeMemory.Crc32C 硬件加速。
/// </summary>
public static class Crc32C {
    static int[] table;

    // 0x82F63B78 反射多项式
    static int Poly = -2097792136;  // (int)0x82F63B78
    static int AllOnes = -1;

    static int[] Table() {
        if (Crc32C.table != null) { return Crc32C.table; }
        int[] t = new int[256];
        for (int i = 0; i < 256; i = i + 1) {
            int c = i;
            for (int k = 0; k < 8; k = k + 1) {
                if ((c & 1) != 0) {
                    c = (int)((uint)c >> 1) ^ Crc32C.Poly;
                } else {
                    c = (int)((uint)c >> 1);
                }
            }
            t[i] = c;
        }
        Crc32C.table = t;
        return t;
    }

    /// <summary>对 byte[] 计算 CRC-32C。</summary>
    public static int Compute(byte[] data, int offset, int len, int crc) {
        int[] t = Crc32C.Table();
        int c = crc ^ Crc32C.AllOnes;
        for (int i = 0; i < len; i = i + 1) {
            c = (int)((uint)c >> 8) ^ t[(c ^ data[offset + i]) & 255];
        }
        return c ^ Crc32C.AllOnes;
    }

    /// <summary>对整个 byte[] 计算 CRC-32C。</summary>
    public static int Compute(byte[] data) {
        if (data == null || data.Length == 0) return 0;
        return Crc32C.Compute(data, 0, data.Length, 0);
    }
}
