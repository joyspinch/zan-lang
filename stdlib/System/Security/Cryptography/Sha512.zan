using System;

namespace System.Security.Cryptography;

/// <summary>纯 Zan 实现的 SHA-512（FIPS 180-4）。操作以 Zan 有符号 64 位 long
/// 存放的 64 位数据；加法按 mod 2^64 回绕，所有右移都使用
/// 逻辑位移辅助函数 Bits.Shr64 / Bits.Rotr64。消息长度限制为
/// 64 位比特数（128 位长度字段的高 64 位始终为零）。</summary>
class Sha512 {

    static string KHEX = "";
    static string HHEX = "6a09e667f3bcc908bb67ae8584caa73b3c6ef372fe94f82ba54ff53a5f1d36f1510e527fade682d19b05688c2b3e6c1f1f83d9abfb41bd6b5be0cd19137e2179";

    static List<long> K;
    static List<long> H0;
    static bool ready = false;

    /// 把十六进制串中第 idx 个 64 位字（16 个 hex 字符）解析为 long。
    static long word64(string h, int idx) {
        // 将字节偏移 idx*16 处的 16 个十六进制字符解析为一个 64 位字
        long v = 0;  int bo = idx * 16;
        for (int i = 0; i < 16; i = i + 1) {
            int c = h[bo + i] & 255;
            int d = 0;
            if (c >= 48 && c <= 57) { d = c - 48; }
            else { d = c - 97 + 10; }
            v = (v << 4) | d;
        }
        return v;
    }

    /// 惰性装载 80 个轮常量 K 与初始哈希 H0（幂等）。
    static void init() {
        if (ready) { return; }
        K = new List<long>();
        int i = 0; for (; i < 80; i = i + 1) { K.Add(word64(KHEX, i)); }
        H0 = new List<long>();
        i = 0; while (i < 8) { H0.Add(word64(HHEX, i)); i = i + 1; }
        ready = true;
    }

    /// 消息调度 σ0(x) = ROTR1 ^ ROTR8 ^ SHR7。
    static long s0(long x) { return Bits.Rotr64(x,1) ^ Bits.Rotr64(x,8) ^ Bits.Shr64(x,7); }
    /// 消息调度 σ1(x) = ROTR19 ^ ROTR61 ^ SHR6。
    static long s1(long x) { return Bits.Rotr64(x,19) ^ Bits.Rotr64(x,61) ^ Bits.Shr64(x,6); }
    /// 压缩函数 Σ0(a) = ROTR28 ^ ROTR34 ^ ROTR39。
    static long bigS0(long x) { return Bits.Rotr64(x,28) ^ Bits.Rotr64(x,34) ^ Bits.Rotr64(x,39); }
    /// 压缩函数 Σ1(e) = ROTR14 ^ ROTR18 ^ ROTR41。
    static long bigS1(long x) { return Bits.Rotr64(x,14) ^ Bits.Rotr64(x,18) ^ Bits.Rotr64(x,41); }

    /// <summary>对 <paramref name="msg"/> 的前
    /// <paramref name="len"/> 字节计算 64 字节 SHA-512 摘要。</summary>
    static byte[] Hash(string msg, int len) {
        init();
        // 填充后的长度：128 的倍数，末尾带 16 字节长度字段
        int totalBlocks = ((len + 16) / 128) + 1;
        int padded = totalBlocks * 128;
        byte[] m = new byte[padded];
        int i = 0;
        for (; i < len; i = i + 1) { m[i] = msg[i] & 255; }
        m[len] = 0x80;
        // 128 位大端序比特长度；仅使用低 64 位
        long bitLen = (long)len * 8;
        for (int j = 0; j < 8; j = j + 1) {
            m[padded - 1 - j] = Bits.Shr64(bitLen, 8 * j) & 255;
        }

        List<long> h = new List<long>();
        i = 0; while (i < 8) { h.Add(H0[i]); i = i + 1; }

        List<long> w = new List<long>();
        i = 0; while (i < 80) { w.Add(0); i = i + 1; }

        for (int blk = 0; blk < totalBlocks; blk = blk + 1) {
            int t = 0;
            for (; t < 16; t = t + 1) {
                int off = blk * 128 + t * 8;
                long v = 0; 
                for (int b = 0; b < 8; b = b + 1) { v = (v << 8) | (m[off + b] & 255); }
                w[t] = v;
            }
            t = 16;
            while (t < 80) {
                w[t] = w[t-16] + s0(w[t-15]) + w[t-7] + s1(w[t-2]);
                t = t + 1;
            }
            long a = h[0]; long bb = h[1]; long c = h[2]; long d = h[3];
            long e = h[4]; long f = h[5]; long g = h[6]; long hh = h[7];
            t = 0;
            while (t < 80) {
                long ch = (e & f) ^ ((~e) & g);
                long temp1 = hh + bigS1(e) + ch + K[t] + w[t];
                long maj = (a & bb) ^ (a & c) ^ (bb & c);
                long temp2 = bigS0(a) + maj;
                hh = g; g = f; f = e; e = d + temp1;
                d = c; c = bb; bb = a; a = temp1 + temp2;
                t = t + 1;
            }
            h[0] = h[0] + a; h[1] = h[1] + bb; h[2] = h[2] + c; h[3] = h[3] + d;
            h[4] = h[4] + e; h[5] = h[5] + f; h[6] = h[6] + g; h[7] = h[7] + hh;
        }


        byte[] outb = new byte[64];
        i = 0;
        while (i < 8) {
            long wv = h[i];
            for (int b = 0; b < 8; b = b + 1) {
                outb[i * 8 + b] = Bits.Shr64(wv, 8 * (7 - b)) & 255;
            }
            i = i + 1;
        }
        return outb;
    }
}
