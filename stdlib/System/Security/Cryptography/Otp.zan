using System;

namespace System.Security.Cryptography;

/// <summary>HOTP（RFC 4226）和 TOTP（RFC 6238）一次性密码。</summary>
class Otp {
    /// 哈希算法常量：SHA-1（摘要 20 字节）。
    static int SHA1 = 1;
    /// 哈希算法常量：SHA-256（摘要 32 字节）。
    static int SHA256 = 2;
    /// 哈希算法常量：SHA-512（摘要 64 字节）。
    static int SHA512 = 3;
    /// 验证窗口上限，防止把校验接口变成穷举放大器。
    static int MAX_VERIFICATION_WINDOW = 1000;

    /// 算法对应的摘要长度（字节）。
    static int digestLen(int algorithm) {
        if (algorithm == SHA1) { return 20; }
        if (algorithm == SHA512) { return 64; }
        return 32;
    }

    /// HMAC 分组长度（字节；SHA-512 为 128，其余 64）。
    static int blockLen(int algorithm) {
        if (algorithm == SHA512) { return 128; }
        return 64;
    }

    /// 按算法常量分发到对应 Sha*.Hash。
    static byte[] hash(int algorithm, string buf, int length) {
        if (algorithm == SHA1) { return Sha1.Hash(buf, length); }
        if (algorithm == SHA512) { return Sha512.Hash(buf, length); }
        return Sha256.Hash(buf, length);
    }

    /// 通用 HMAC（RFC 2104）；超长密钥先哈希归一化到分组长度。
    /// 本文件内部的独立实现，不经 <see cref="Hmac"/>。
    static byte[] hmac(int algorithm, string key, int keyLen, string message, int messageLen) {
        int digestLength = digestLen(algorithm);
        int blockLength = blockLen(algorithm);
        byte[] normalizedKey = new byte[blockLength];
        int i = 0;
        if (keyLen > blockLength) {
            byte[] keyHash = hash(algorithm, key, keyLen);
            while (i < digestLength) {
                normalizedKey[i] = keyHash[i] & 255;
                i = i + 1;
            }
        } else {
            while (i < keyLen) {
                normalizedKey[i] = key[i] & 255;
                i = i + 1;
            }
        }

        byte[] inner = new byte[blockLength + messageLen];
        i = 0;
        while (i < blockLength) {
            inner[i] = (normalizedKey[i] ^ 0x36) & 255;
            i = i + 1;
        }
        i = 0;
        while (i < messageLen) {
            inner[blockLength + i] = message[i] & 255;
            i = i + 1;
        }
        byte[] innerHash = hash(algorithm, inner, blockLength + messageLen);

        byte[] outer = new byte[blockLength + digestLength];
        i = 0;
        while (i < blockLength) {
            outer[i] = (normalizedKey[i] ^ 0x5c) & 255;
            i = i + 1;
        }
        i = 0;
        while (i < digestLength) {
            outer[blockLength + i] = innerHash[i] & 255;
            i = i + 1;
        }
        return hash(algorithm, outer, blockLength + digestLength);
    }

    /// 10^digits（动态截断模）。
    static int modulus(int digits) {
        int power = 1;
        for (int i = 0; i < digits; i = i + 1) {
            power = power * 10;
        }
        return power;
    }

    /// 验证码左补零到 `digits` 位。
    static string decimalCode(int number, int digits) {
        string result = Convert.ToString(number);
        while (result.Length < digits) { result = "0" + result; }
        return result;
    }

    /// 校验位数（6-8）与算法常量，非法即抛 ArgumentException。
    static void validate(int digits, int algorithm) {
        if (digits < 6 || digits > 8) {
            throw new ArgumentException("OTP digits must be between 6 and 8");
        }
        if (algorithm != SHA1 && algorithm != SHA256 && algorithm != SHA512) {
            throw new ArgumentException("unsupported OTP hash algorithm");
        }
    }

    /// 校验密钥非空且 keyLen 在 [0, key.Length]，非法即抛 ArgumentException。
    static void validateKey(string key, int keyLen) {
        if (key == null) { throw new ArgumentException("OTP key must not be null"); }
        if (keyLen < 0 || keyLen > key.Length) {
            throw new ArgumentException("OTP key length must be between 0 and key.Length");
        }
    }

    /// 校验验证码非空、长度等于 digits 且全为十进制数字，非法即抛 ArgumentException。
    static void validateCode(string code, int digits) {
        if (code == null) { throw new ArgumentException("OTP code must not be null"); }
        if (code.Length != digits) {
            throw new ArgumentException("OTP code length must match digits");
        }
        for (int i = 0; i < code.Length; i = i + 1) {
            if (code[i] < 48 || code[i] > 57) {
                throw new ArgumentException("OTP code must contain only decimal digits");
            }
        }
    }

    /// 校验验证窗口在 [0, MAX_VERIFICATION_WINDOW]，非法即抛 ArgumentException。
    static void validateWindow(int window, string name) {
        if (window < 0 || window > MAX_VERIFICATION_WINDOW) {
            throw new ArgumentException(name + " must be between 0 and 1000");
        }
    }

    /// <summary>为显式的 64 位计数器生成 HOTP 验证码。
    /// <paramref name="digits"/> 必须在 6 到 8 之间。</summary>
    static string Hotp(string key, int keyLen, long counter, int digits, int algorithm) {
        validateKey(key, keyLen);
        validate(digits, algorithm);
        byte[] movingFactor = new byte[8];
        for (int i = 0; i < 8; i = i + 1) {
            movingFactor[7 - i] = Bits.Shr64(counter, i * 8) & 255;
        }
        byte[] digest = hmac(algorithm, key, keyLen, movingFactor, 8);
        int offset = digest[digestLen(algorithm) - 1] & 15;
        int binary = ((digest[offset] & 127) << 24)
            | ((digest[offset + 1] & 255) << 16)
            | ((digest[offset + 2] & 255) << 8)
            | (digest[offset + 3] & 255);
        return decimalCode(binary % modulus(digits), digits);
    }

    /// <summary>当前 Unix 时间与周期的关系即时生成 TOTP 验证码；
    /// 常用 30 秒周期。digits 6-8。</summary>
    static string Totp(string key, int keyLen, long unixTime, int period, int digits, int algorithm) {
        validateKey(key, keyLen);
        if (period <= 0) { throw new ArgumentException("TOTP period must be positive"); }
        return Hotp(key, keyLen, unixTime / period, digits, algorithm);
    }

    /// <summary>校验失败恒定时间比较（长度差参与累积，不提前返回），
    /// 防止按比较耗时逐位猜码。</summary>
    static bool fixedTimeEquals(string expected, string supplied) {
        int difference = expected.Length ^ supplied.Length;
        for (int i = 0; i < expected.Length; i = i + 1) {
            int actual = 0;
            if (i < supplied.Length) { actual = supplied[i] & 255; }
            difference = difference | ((expected[i] & 255) ^ actual);
        }
        return difference == 0;
    }

    /// <summary>以恒定时间校验当前计数器及其后
    /// <paramref name="lookAhead"/> 个计数器的 HOTP。</summary>
    static bool VerifyHotp(string key, int keyLen, long counter, int digits, int algorithm,
        string code, int lookAhead) {
        validateKey(key, keyLen);
        validate(digits, algorithm);
        validateCode(code, digits);
        validateWindow(lookAhead, "HOTP look-ahead");
        if (counter > 9223372036854775807 - lookAhead) {
            throw new ArgumentException("HOTP counter and look-ahead overflow");
        }
        bool matched = false;
        for (int drift = 0; drift <= lookAhead; drift = drift + 1) {
            bool equal = fixedTimeEquals(Hotp(key, keyLen, counter + drift, digits, algorithm), code);
            matched = matched | equal;
        }
        return matched;
    }

    /// <summary>以恒定时间在对称漂移窗口内校验 TOTP。
    /// 窗口为 1 时校验前、当前、后三个时间段。</summary>
    static bool VerifyTotp(string key, int keyLen, long unixTime, int period, int digits,
        int algorithm, string code, int window) {
        validateKey(key, keyLen);
        validate(digits, algorithm);
        validateCode(code, digits);
        if (period <= 0) { throw new ArgumentException("TOTP period must be positive"); }
        validateWindow(window, "TOTP window");
        bool matched = false;
        int drift = 0 - window;
        long counter = unixTime / period;
        if (counter < -9223372036854775807 - 1 + window
            || counter > 9223372036854775807 - window) {
            throw new ArgumentException("TOTP counter and window overflow");
        }
        while (drift <= window) {
            bool equal = fixedTimeEquals(Hotp(key, keyLen, counter + drift, digits, algorithm), code);
            matched = matched | equal;
            drift = drift + 1;
        }
        return matched;
    }
}
