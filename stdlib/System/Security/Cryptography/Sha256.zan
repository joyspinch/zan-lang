using System;

namespace System.Security.Cryptography;

/// <summary>FIPS 180-4 SHA-256. Pure Zan, operates on raw byte buffers.</summary>
class Sha256 {
    /// <summary>Computes SHA-256 over <paramref name="len"/> bytes; returns a
    /// freshly allocated 32-byte digest (caller frees).</summary>
    static byte[] Hash(string msg, int len) {
        List<int> k = new List<int>{
            1116352408, 1899447441, 3049323471, 3921009573,
            961987163, 1508970993, 2453635748, 2870763221,
            3624381080, 310598401, 607225278, 1426881987,
            1925078388, 2162078206, 2614888103, 3248222580,
            3835390401, 4022224774, 264347078, 604807628,
            770255983, 1249150122, 1555081692, 1996064986,
            2554220882, 2821834349, 2952996808, 3210313671,
            3336571891, 3584528711, 113926993, 338241895,
            666307205, 773529912, 1294757372, 1396182291,
            1695183700, 1986661051, 2177026350, 2456956037,
            2730485921, 2820302411, 3259730800, 3345764771,
            3516065817, 3600352804, 4094571909, 275423344,
            430227734, 506948616, 659060556, 883997877,
            958139571, 1322822218, 1537002063, 1747873779,
            1955562222, 2024104815, 2227730452, 2361852424,
            2428436474, 2756734187, 3204031479, 3329325298 };

        int h0=1779033703; int h1=3144134277; int h2=1013904242; int h3=2773480762;
        int h4=1359893119; int h5=2600822924; int h6=528734635; int h7=1541459225;

        int total = len + 1 + 8;
        int rem = total % 64; int pad = 0; if (rem != 0) { pad = 64 - rem; }
        int plen = total + pad;
        byte[] m = new byte[plen];
         for (int i = 0; i < len; i = i + 1) { m[i] = msg[i] & 255; }
        m[len] = 128;
        int bits = len * 8; int bi = plen - 8;
        m[bi+0]=(bits>>56)&255; m[bi+1]=(bits>>48)&255; m[bi+2]=(bits>>40)&255; m[bi+3]=(bits>>32)&255;
        m[bi+4]=(bits>>24)&255; m[bi+5]=(bits>>16)&255; m[bi+6]=(bits>>8)&255; m[bi+7]=bits&255;

        int blocks = plen / 64; 
        for (int b = 0; b < blocks; b = b + 1) {
            int off = b * 64;
            List<int> w = new List<int>();
            int t = 0;
            for (; t < 16; t = t + 1) {
                int j = off + t*4;
                w.Add((((m[j]&255)<<24)|((m[j+1]&255)<<16)|((m[j+2]&255)<<8)|(m[j+3]&255)) & 4294967295);
            }
            t = 16;
            while (t < 64) {
                int s0 = Bits.Rotr32(w[t-15],7) ^ Bits.Rotr32(w[t-15],18) ^ ((w[t-15]&4294967295)>>3);
                int s1 = Bits.Rotr32(w[t-2],17) ^ Bits.Rotr32(w[t-2],19) ^ ((w[t-2]&4294967295)>>10);
                w.Add((w[t-16]+s0+w[t-7]+s1) & 4294967295);
                t = t + 1;
            }
            int a=h0; int bb=h1; int c=h2; int d=h3; int e=h4; int f=h5; int g=h6; int hh=h7;
            t = 0;
            while (t < 64) {
                int S1 = Bits.Rotr32(e,6)^Bits.Rotr32(e,11)^Bits.Rotr32(e,25);
                int ch = (e & f) ^ (((e ^ 4294967295)&4294967295) & g);
                int temp1 = (hh + S1 + ch + k[t] + w[t]) & 4294967295;
                int S0 = Bits.Rotr32(a,2)^Bits.Rotr32(a,13)^Bits.Rotr32(a,22);
                int maj = (a & bb) ^ (a & c) ^ (bb & c);
                int temp2 = (S0 + maj) & 4294967295;
                hh=g; g=f; f=e; e=(d+temp1)&4294967295; d=c; c=bb; bb=a; a=(temp1+temp2)&4294967295;
                t = t + 1;
            }
            h0=(h0+a)&4294967295; h1=(h1+bb)&4294967295; h2=(h2+c)&4294967295; h3=(h3+d)&4294967295;
            h4=(h4+e)&4294967295; h5=(h5+f)&4294967295; h6=(h6+g)&4294967295; h7=(h7+hh)&4294967295;
        }
        byte[] outb = new byte[32];
        wBE(outb,0,h0); wBE(outb,4,h1); wBE(outb,8,h2); wBE(outb,12,h3);
        wBE(outb,16,h4); wBE(outb,20,h5); wBE(outb,24,h6); wBE(outb,28,h7);
        return outb;
    }

    static void wBE(byte[] buf, int off, int v) {
        buf[off+0]=(v>>24)&255; buf[off+1]=(v>>16)&255; buf[off+2]=(v>>8)&255; buf[off+3]=v&255;
    }
}
