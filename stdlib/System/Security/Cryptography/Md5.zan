using System;

namespace System.Security.Cryptography;

/// <summary>RFC 1321 MD5。仅供遗留/互操作场景使用；不具有抗碰撞性，
/// 不适合用于新的安全场景。</summary>
class Md5 {
    /// <summary>计算 MD5；返回新分配的 16 字节摘要。</summary>
    static byte[] Hash(string msg, int len) {
        List<int> K = new List<int>{
            3614090360, 3905402710, 606105819, 3250441966,
            4118548399, 1200080426, 2821735955, 4249261313,
            1770035416, 2336552879, 4294925233, 2304563134,
            1804603682, 4254626195, 2792965006, 1236535329,
            4129170786, 3225465664, 643717713, 3921069994,
            3593408605, 38016083, 3634488961, 3889429448,
            568446438, 3275163606, 4107603335, 1163531501,
            2850285829, 4243563512, 1735328473, 2368359562,
            4294588738, 2272392833, 1839030562, 4259657740,
            2763975236, 1272893353, 4139469664, 3200236656,
            681279174, 3936430074, 3572445317, 76029189,
            3654602809, 3873151461, 530742520, 3299628645,
            4096336452, 1126891415, 2878612391, 4237533241,
            1700485571, 2399980690, 4293915773, 2240044497,
            1873313359, 4264355552, 2734768916, 1309151649,
            4149444226, 3174756917, 718787259, 3951481745 };
        List<int> S = new List<int>{
            7, 12, 17, 22, 7, 12, 17, 22,
            7, 12, 17, 22, 7, 12, 17, 22,
            5, 9, 14, 20, 5, 9, 14, 20,
            5, 9, 14, 20, 5, 9, 14, 20,
            4, 11, 16, 23, 4, 11, 16, 23,
            4, 11, 16, 23, 4, 11, 16, 23,
            6, 10, 15, 21, 6, 10, 15, 21,
            6, 10, 15, 21, 6, 10, 15, 21 };
        int a0=1732584193; int b0=4023233417; int c0=2562383102; int d0=271733878;
        int total = len + 1 + 8;
        int rem = total % 64; int pad = 0; if (rem != 0) { pad = 64 - rem; }
        int plen = total + pad;
        byte[] m = new byte[plen];
         for (int i = 0; i < len; i = i + 1) { m[i] = msg[i] & 255; }
        m[len] = 128;
        long bits = (long)len * 8; int bi = plen - 8;
        m[bi+0]=bits&255; m[bi+1]=(bits>>8)&255; m[bi+2]=(bits>>16)&255; m[bi+3]=(bits>>24)&255;
        m[bi+4]=(bits>>32)&255; m[bi+5]=(bits>>40)&255; m[bi+6]=(bits>>48)&255; m[bi+7]=(bits>>56)&255;
        int blocks = plen / 64; 
        for (int bl = 0; bl < blocks; bl = bl + 1) {
            int off = bl * 64;
            List<int> M = new List<int>();
            int t = 0;
            for (; t < 16; t = t + 1) {
                int j = off + t*4;
                M.Add(((m[j]&255)|((m[j+1]&255)<<8)|((m[j+2]&255)<<16)|((m[j+3]&255)<<24)) & 4294967295);
            }
            int A=a0; int B=b0; int C=c0; int D=d0;
            t = 0;
            while (t < 64) {
                int F; int g;
                if (t < 16) { F = (B & C) | (((B ^ 4294967295)&4294967295) & D); g = t; }
                else if (t < 32) { F = (D & B) | (((D ^ 4294967295)&4294967295) & C); g = (5*t + 1) % 16; }
                else if (t < 48) { F = B ^ C ^ D; g = (3*t + 5) % 16; }
                else { F = C ^ (B | ((D ^ 4294967295)&4294967295)); g = (7*t) % 16; }
                F = (F + A + K[t] + M[g]) & 4294967295;
                A = D; D = C; C = B;
                B = (B + Bits.Rotl32(F, S[t])) & 4294967295;
                t = t + 1;
            }
            a0=(a0+A)&4294967295; b0=(b0+B)&4294967295; c0=(c0+C)&4294967295; d0=(d0+D)&4294967295;
        }
        byte[] o = new byte[16];
        wLE(o,0,a0); wLE(o,4,b0); wLE(o,8,c0); wLE(o,12,d0);
        return o;
    }
    static void wLE(byte[] b, int o, int v) { b[o]=v&255; b[o+1]=(v>>8)&255; b[o+2]=(v>>16)&255; b[o+3]=(v>>24)&255; }
}
