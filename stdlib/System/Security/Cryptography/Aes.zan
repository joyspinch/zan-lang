using System;

namespace System.Security.Cryptography;

/// <summary>AES（FIPS-197）分组密码，支持 CBC 与 CTR 模式。支持
/// 128/192/256 位密钥。纯 Zan 实现，面向字节（无 T 表）。S-box 以
/// 十六进制存储并解码一次；逆 S-box 由它派生。</summary>
class Aes {
    /// AES S-box（256 字节）的十六进制文本，init 时解码一次。
    static string SBOX_HEX() {
        return "637c777bf26b6fc53001672bfed7ab76"
             + "ca82c97dfa5947f0add4a2af9ca472c0"
             + "b7fd9326363ff7cc34a5e5f171d83115"
             + "04c723c31896059a071280e2eb27b275"
             + "09832c1a1b6e5aa0523bd6b329e32f84"
             + "53d100ed20fcb15b6acbbe394a4c58cf"
             + "d0efaafb434d338545f9027f503c9fa8"
             + "51a3408f929d38f5bcb6da2110fff3d2"
             + "cd0c13ec5f974417c4a77e3d645d1973"
             + "60814fdc222a908846eeb814de5e0bdb"
             + "e0323a0a4906245cc2d3ac629195e479"
             + "e7c8376d8dd54ea96c56f4ea657aae08"
             + "ba78252e1ca6b4c6e8dd741f4bbd8b8a"
             + "703eb5664803f60e613557b986c11d9e"
             + "e1f8981169d98e949b1e87e9ce5528df"
             + "8ca1890dbfe6426841992d0fb054bb16";
    }

    static byte[] sbox;
    static byte[] inv;
    static bool ready = false;

    /// 惰性解码 S-box 并由它派生逆 S-box（幂等）。
    static void init() {
        if (ready) { return; }
        sbox = Hex.Decode(SBOX_HEX());
        inv = new byte[256];
        for (int i = 0; i < 256; i = i + 1) { inv[sbox[i] & 255] = i; }
        ready = true;
    }

    /// GF(2^8) 上乘 2（约减多项式 x^8+x^4+x^3+x+1）。
    static int xtime(int x) {
        int r = (x << 1) & 255;
        if ((x & 128) != 0) { r = r ^ 27; }
        return r;
    }

    /// GF(2^8) 上的乘法（俄罗斯农民乘法）。
    static int gmul(int a, int b) {
        int p = 0; 
        for (int i = 0; i < 8; i = i + 1) {
            if ((b & 1) != 0) { p = p ^ a; }
            int hi = a & 128;
            a = (a << 1) & 255;
            if (hi != 0) { a = a ^ 27; }
            b = b >> 1;
        }
        return p & 255;
    }

    /// <summary>将密钥扩展为 (Nr+1)*16 字节轮密钥。返回缓冲区；
    /// <paramref name="nrOut"/>[0] 接收轮数。</summary>
    static byte[] expandKey(string key, int keyLen, List<int> nrOut) {
        init();
        int nk = keyLen / 4;
        int nr = nk + 6;
        nrOut[0] = nr;
        int total = 16 * (nr + 1);
        byte[] rk = new byte[total];
        int i = 0;
        for (; i < keyLen; i = i + 1) { rk[i] = key[i] & 255; }
        int rcon = 1;
        i = keyLen;
        while (i < total) {
            int t0 = rk[i-4]&255; int t1 = rk[i-3]&255; int t2 = rk[i-2]&255; int t3 = rk[i-1]&255;
            if ((i % keyLen) == 0) {
                int tmp = t0;
                t0 = (sbox[t1]&255) ^ rcon;
                t1 = sbox[t2]&255;
                t2 = sbox[t3]&255;
                t3 = sbox[tmp]&255;
                rcon = xtime(rcon);
            } else if (keyLen == 32 && (i % keyLen) == 16) {
                t0 = sbox[t0]&255; t1 = sbox[t1]&255; t2 = sbox[t2]&255; t3 = sbox[t3]&255;
            }
            rk[i]   = (rk[i-keyLen]&255)   ^ t0;
            rk[i+1] = (rk[i-keyLen+1]&255) ^ t1;
            rk[i+2] = (rk[i-keyLen+2]&255) ^ t2;
            rk[i+3] = (rk[i-keyLen+3]&255) ^ t3;
            i = i + 4;
        }
        return rk;
    }

    /// 第 `round` 轮密钥异或进 16 字节状态。
    static void addRoundKey(byte[] st, byte[] rk, int round) {
        for (int i = 0; i < 16; i = i + 1) { st[i] = (st[i]&255) ^ (rk[round*16+i]&255); }
    }

    /// 单块加密：SubBytes/ShiftRows/MixColumns 共 nr 轮加首尾轮密钥。
    static void encryptBlock(byte[] st, byte[] rk, int nr) {
        addRoundKey(st, rk, 0);
        int r = 1;
        while (r < nr) {
             for (int i = 0; i < 16; i = i + 1) { st[i] = sbox[st[i]&255]&255; }   // SubBytes
            shiftRows(st);
            mixColumns(st);
            addRoundKey(st, rk, r);
            r = r + 1;
        }
         for (int j = 0; j < 16; j = j + 1) { st[j] = sbox[st[j]&255]&255; }
        shiftRows(st);
        addRoundKey(st, rk, nr);
    }

    /// 单块解密（encryptBlock 的逆序）。
    static void decryptBlock(byte[] st, byte[] rk, int nr) {
        addRoundKey(st, rk, nr);
        int r = nr - 1;
        while (r >= 1) {
            invShiftRows(st);
             for (int i = 0; i < 16; i = i + 1) { st[i] = inv[st[i]&255]&255; }
            addRoundKey(st, rk, r);
            invMixColumns(st);
            r = r - 1;
        }
        invShiftRows(st);
         for (int j = 0; j < 16; j = j + 1) { st[j] = inv[st[j]&255]&255; }
        addRoundKey(st, rk, 0);
    }

    /// 行移位（状态按列主序存放）。
    static void shiftRows(byte[] st) {
        byte[] t = new byte[16];
        for (int c = 0; c < 4; c = c + 1) {
            for (int r = 0; r < 4; r = r + 1) { t[c*4+r] = st[(((c+r)%4)*4)+r]&255; }
        }
         for (int i = 0; i < 16; i = i + 1) { st[i] = t[i]&255; }
    }

    /// 逆行移位。
    static void invShiftRows(byte[] st) {
        byte[] t = new byte[16];
        for (int c = 0; c < 4; c = c + 1) {
            for (int r = 0; r < 4; r = r + 1) { t[c*4+r] = st[((((c-r)%4)+4)%4)*4+r]&255; }
        }
         for (int i = 0; i < 16; i = i + 1) { st[i] = t[i]&255; }
    }

    /// 列混合（系数 2/3，经 xtime 展开）。
    static void mixColumns(byte[] st) {
        for (int c = 0; c < 4; c = c + 1) {
            int a0=st[c*4]&255; int a1=st[c*4+1]&255; int a2=st[c*4+2]&255; int a3=st[c*4+3]&255;
            st[c*4]   = (xtime(a0) ^ (xtime(a1)^a1) ^ a2 ^ a3) & 255;
            st[c*4+1] = (a0 ^ xtime(a1) ^ (xtime(a2)^a2) ^ a3) & 255;
            st[c*4+2] = (a0 ^ a1 ^ xtime(a2) ^ (xtime(a3)^a3)) & 255;
            st[c*4+3] = ((xtime(a0)^a0) ^ a1 ^ a2 ^ xtime(a3)) & 255;
        }
    }

    /// 逆列混合（系数 9/11/13/14，经 gmul）。
    static void invMixColumns(byte[] st) {
        for (int c = 0; c < 4; c = c + 1) {
            int a0=st[c*4]&255; int a1=st[c*4+1]&255; int a2=st[c*4+2]&255; int a3=st[c*4+3]&255;
            st[c*4]   = (gmul(a0,14)^gmul(a1,11)^gmul(a2,13)^gmul(a3,9)) & 255;
            st[c*4+1] = (gmul(a0,9)^gmul(a1,14)^gmul(a2,11)^gmul(a3,13)) & 255;
            st[c*4+2] = (gmul(a0,13)^gmul(a1,9)^gmul(a2,14)^gmul(a3,11)) & 255;
            st[c*4+3] = (gmul(a0,11)^gmul(a1,13)^gmul(a2,9)^gmul(a3,14)) & 255;
        }
    }

    /// <summary>加密单个 16 字节分组（ECB）。用于测试/构建
    /// 其他模式。返回全新的 16 字节缓冲区；输入长度或密钥长度
    /// 不合法时返回 null。</summary>
    static byte[] EncryptBlockEcb(string key, int keyLen, string in16) {
        if ((keyLen != 16 && keyLen != 24 && keyLen != 32) || in16 == null) {
            return null;
        }
        List<int> nr = new List<int>(); nr.Add(0);
        byte[] rk = expandKey(key, keyLen, nr);
        byte[] st = new byte[16];
         for (int i = 0; i < 16; i = i + 1) { st[i] = in16[i]&255; }
        encryptBlock(st, rk, nr[0]);
        return st;
    }

    /// <summary>AES-ECB 单块解密（EncryptBlockEcb 的逆）。
    /// 同样只用于测试/构建其他模式；参数不合法返回 null。</summary>
    static byte[] DecryptBlockEcb(string key, int keyLen, string in16) {
        if ((keyLen != 16 && keyLen != 24 && keyLen != 32) || in16 == null) {
            return null;
        }
        List<int> nr = new List<int>(); nr.Add(0);
        byte[] rk = expandKey(key, keyLen, nr);
        byte[] st = new byte[16];
         for (int i = 0; i < 16; i = i + 1) { st[i] = in16[i]&255; }
        decryptBlock(st, rk, nr[0]);
        return st;
    }

    /// <summary>AES-CBC 加密，PKCS#7 填充。返回密文；
    /// <paramref name="outLen"/>[0] 接收其长度。keyLen 必须是
    /// 16/24/32（否则返回 null）。</summary>
    static byte[] EncryptCbc(string key, int keyLen, string iv, string data, int len, List<int> outLen) {
        if (keyLen != 16 && keyLen != 24 && keyLen != 32) { outLen[0] = -1; return null; }
        List<int> nr = new List<int>(); nr.Add(0);
        byte[] rk = expandKey(key, keyLen, nr);
        int padVal = 16 - (len % 16);
        int total = len + padVal;
        byte[] outb = new byte[total];
        byte[] prev = new byte[16];
         for (int i = 0; i < 16; i = i + 1) { prev[i] = iv[i]&255; }
        int off = 0;
        while (off < total) {
            byte[] st = new byte[16];
            int j = 0;
            for (; j < 16; j = j + 1) {
                int b;
                if (off + j < len) { b = data[off+j]&255; } else { b = padVal; }
                st[j] = (b ^ (prev[j]&255)) & 255;
            }
            encryptBlock(st, rk, nr[0]);
            j = 0; while (j < 16) { outb[off+j] = st[j]&255; prev[j] = st[j]&255; j = j + 1; }
            off = off + 16;
        }
        outLen[0] = total;
        return outb;
    }

    /// <summary>AES-CBC 解密，去除 PKCS#7 填充。返回明文；
    /// <paramref name="outLen"/>[0] 接收其长度（密文长度非 16 整数倍、
    /// 或 PKCS#7 填充不一致时为 -1，并返回 null）。填充校验要求
    /// 最后 padVal 字节全部等于 padVal，而非仅看最后一个字节。</summary>
    static byte[] DecryptCbc(string key, int keyLen, string iv, string data, int len, List<int> outLen) {
        if (keyLen != 16 && keyLen != 24 && keyLen != 32) { outLen[0] = -1; return null; }
        // CBC 密文必须是 16 字节的整数倍；空输入也不合法（至少要有一个
        // 完整的填充块）。
        if (len <= 0 || (len % 16) != 0) { outLen[0] = -1; return null; }
        List<int> nr = new List<int>(); nr.Add(0);
        byte[] rk = expandKey(key, keyLen, nr);
        byte[] outb = new byte[len];
        byte[] prev = new byte[16];
         for (int i = 0; i < 16; i = i + 1) { prev[i] = iv[i]&255; }
        int off = 0;
        while (off < len) {
            byte[] st = new byte[16];
            int j = 0; for (; j < 16; j = j + 1) { st[j] = data[off+j]&255; }
            byte[] cipher = new byte[16];
            j = 0; while (j < 16) { cipher[j] = st[j]&255; j = j + 1; }
            decryptBlock(st, rk, nr[0]);
            j = 0;
            while (j < 16) { outb[off+j] = (st[j]&255) ^ (prev[j]&255); j = j + 1; }
            j = 0; while (j < 16) { prev[j] = cipher[j]&255; j = j + 1; }
            off = off + 16;
        }
        // PKCS#7 校验：padVal 在 1..16，且最后 padVal 字节必须全部等于
        // padVal。常数时间遍历整个最后块：对落在填充范围内的位置比较
        // padVal，范围外的位置比较 0（不贡献失配），从而不泄露 padVal。
        int padVal = outb[len-1] & 255;
        int bad = 0;
        if (padVal < 1 || padVal > 16) { bad = 1; }
        int k = 0;
        while (k < 16) {
            int pos = len - 16 + k;
            int inPad = 0;
            if (k >= 16 - padVal) { inPad = 1; }
            // 仅填充字节参与比较：inPad==1 时 expect=padVal，否则 expect=实际值（恒等，不报错）。
            int expect = padVal;
            int actual = outb[pos] & 255;
            if (inPad == 0) { expect = actual; }
            bad = bad | (actual ^ expect);
            k = k + 1;
        }
        if (bad != 0) { outLen[0] = -1; return null; }
        outLen[0] = len - padVal;
        return outb;
    }

    /// <summary>AES-CTR（加密==解密）。<paramref name="iv"/> 是 16 字节的
    /// 初始计数器块。返回恰好 <paramref name="len"/> 字节
    /// 的缓冲区；密钥长度或长度参数不合法时返回 null。</summary>
    static byte[] Ctr(string key, int keyLen, string iv, string data, int len) {
        if (keyLen != 16 && keyLen != 24 && keyLen != 32) { return null; }
        if (len < 0) { return null; }
        List<int> nr = new List<int>(); nr.Add(0);
        byte[] rk = expandKey(key, keyLen, nr);
        byte[] outb = new byte[len];
        byte[] ctr = new byte[16];
         for (int i = 0; i < 16; i = i + 1) { ctr[i] = iv[i]&255; }
        int off = 0;
        while (off < len) {
            byte[] ks = new byte[16];
            int j = 0; for (; j < 16; j = j + 1) { ks[j] = ctr[j]&255; }
            encryptBlock(ks, rk, nr[0]);
            j = 0;
            while (j < 16 && off + j < len) { outb[off+j] = (data[off+j]&255) ^ (ks[j]&255); j = j + 1; }
            int c = 15;
            while (c >= 0) {
                int v = (ctr[c]&255) + 1;
                ctr[c] = v & 255;
                if (v < 256) { break; }
                c = c - 1;
            }
            off = off + 16;
        }
        return outb;
    }
}
