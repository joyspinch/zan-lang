using System;

namespace System.Security.Cryptography;

/// <summary>AES（FIPS-197）高级加密标准分组密码。
/// 100% 纯 Zan 自举实现，支持 CBC、ECB 与 CTR 模式，支持 128/192/256 位密钥。
/// 核心循环采用工业级 T-Table（4KB 复合查找表）与寄存器轮转优化，
/// 实现零 C 语言、零 OpenSSL 依赖、零热点循环堆分配的高性能纯原生加密。</summary>
class Aes {
    // -------------------------------------------------------------------------
    // S 盒与逆 S 盒（FIPS-197 标准）
    // -------------------------------------------------------------------------
    static int[] Sbox;
    static int[] InvSbox;

    // 4KB 查表：加密 T 表 (T0..T3) 与 解密 逆 T 表 (InvT0..InvT3)
    static int[] T0; static int[] T1; static int[] T2; static int[] T3;
    static int[] InvT0; static int[] InvT1; static int[] InvT2; static int[] InvT3;
    static bool inited = false;

    static int Xtime(int a) {
        int r = a << 1;
        if ((a & 0x80) != 0) {
            r = r ^ 0x11B;
        }
        return r & 0xFF;
    }

    static int MulGF(int a, int b) {
        int p = 0;
        int aa = a;
        int bb = b;
        for (int i = 0; i < 8; i = i + 1) {
            if ((bb & 1) != 0) { p = p ^ aa; }
            int hi = aa & 0x80;
            aa = (aa << 1) & 0xFF;
            if (hi != 0) { aa = aa ^ 0x1B; }
            bb = bb >> 1;
        }
        return p & 0xFF;
    }

    static int RotR32(int v, int bits) {
        return (int)(((uint)v >> bits) | ((uint)v << (32 - bits)));
    }

    static void InitTables() {
        if (inited) { return; }

        string hex = "637c777bf26b6fc53001672bfed7ab76"
                   + "ca82c97dfa5947f0add4a2af9ca472c0"
                   + "b7fd9326363ff7cc34a5e5f171d83115"
                   + "04c723c31896059a071280e2eb27b275"
                   + "09832c1a1b6e5aa0523bd6b329e32f84"
                   + "53d100ed20fcb15b6acbbe394a4c58cf"
                   + "d0efaafb434d338545f9027f503c9fa8"
                   + "51a3408f929d38f5bcb6da2110fff3d2"
                   + "cd0c13ec5f974417c4a77e3d645d1973"
                   + "60814fdc222a908846eeb814de5e0bdb"
                   + "e0323a0a4906245cc2d3ac629195e479"
                   + "e7c8376d8dd54ea96c56f4ea657aae08"
                   + "ba78252e1ca6b4c6e8dd741f4bbd8b8a"
                   + "703eb5664803f60e613557b986c11d9e"
                   + "e1f8981169d98e949b1e87e9ce5528df"
                   + "8ca1890dbfe6426841992d0fb054bb16";

        byte[] sbBytes = Hex.Decode(hex);
        Sbox = new int[256];
        InvSbox = new int[256];
        for (int i = 0; i < 256; i = i + 1) {
            int s = sbBytes[i] & 255;
            Sbox[i] = s;
            InvSbox[s] = i;
        }

        T0 = new int[256]; T1 = new int[256]; T2 = new int[256]; T3 = new int[256];
        InvT0 = new int[256]; InvT1 = new int[256]; InvT2 = new int[256]; InvT3 = new int[256];

        for (int i = 0; i < 256; i = i + 1) {
            int s = Sbox[i];
            int s2 = Xtime(s);
            int s3 = s2 ^ s;
            int v = (s2 << 24) | (s << 16) | (s << 8) | s3;
            T0[i] = v;
            T1[i] = RotR32(v, 8);
            T2[i] = RotR32(v, 16);
            T3[i] = RotR32(v, 24);

            int is_ = InvSbox[i];
            int v0e = MulGF(is_, 0x0E);
            int v09 = MulGF(is_, 0x09);
            int v0d = MulGF(is_, 0x0D);
            int v0b = MulGF(is_, 0x0B);
            int iv = (v0e << 24) | (v09 << 16) | (v0d << 8) | v0b;
            InvT0[i] = iv;
            InvT1[i] = RotR32(iv, 8);
            InvT2[i] = RotR32(iv, 16);
            InvT3[i] = RotR32(iv, 24);
        }

        inited = true;
    }

    // -------------------------------------------------------------------------
    // 密钥扩展（Key Expansion，返回 32 位字数组）
    // -------------------------------------------------------------------------
    static int[] ExpandKey(string key, int keyLen, List<int> nrOut) {
        InitTables();
        int nk = keyLen / 4;
        int nr = nk + 6;
        nrOut[0] = nr;
        int totalWords = 4 * (nr + 1);
        int[] w = new int[totalWords];

        for (int i = 0; i < nk; i = i + 1) {
            int o = i * 4;
            w[i] = ((key[o] & 255) << 24) | ((key[o + 1] & 255) << 16) | ((key[o + 2] & 255) << 8) | (key[o + 3] & 255);
        }

        int rcon = 1;
        for (int i = nk; i < totalWords; i = i + 1) {
            int temp = w[i - 1];
            if ((i % nk) == 0) {
                // RotWord + SubWord + Rcon
                int b0 = (temp >> 24) & 255;
                int b1 = (temp >> 16) & 255;
                int b2 = (temp >> 8) & 255;
                int b3 = temp & 255;
                temp = ((Sbox[b1] ^ rcon) << 24) | (Sbox[b2] << 16) | (Sbox[b3] << 8) | Sbox[b0];
                rcon = Xtime(rcon);
            } else if (nk > 6 && (i % nk) == 4) {
                // SubWord for 256-bit AES
                int b0 = (temp >> 24) & 255;
                int b1 = (temp >> 16) & 255;
                int b2 = (temp >> 8) & 255;
                int b3 = temp & 255;
                temp = (Sbox[b0] << 24) | (Sbox[b1] << 16) | (Sbox[b2] << 8) | Sbox[b3];
            }
            w[i] = w[i - nk] ^ temp;
        }

        return w;
    }

    // -------------------------------------------------------------------------
    // 单分组加密（纯 Zan T-Table 原位计算，0 堆分配）
    // -------------------------------------------------------------------------
    static void EncryptCore(int[] rk, int nr, string inb, int inOff, byte[] outb, int outOff) {
        int s0 = (((inb[inOff + 0] & 255) << 24) | ((inb[inOff + 1] & 255) << 16) | ((inb[inOff + 2] & 255) << 8) | (inb[inOff + 3] & 255)) ^ rk[0];
        int s1 = (((inb[inOff + 4] & 255) << 24) | ((inb[inOff + 5] & 255) << 16) | ((inb[inOff + 6] & 255) << 8) | (inb[inOff + 7] & 255)) ^ rk[1];
        int s2 = (((inb[inOff + 8] & 255) << 24) | ((inb[inOff + 9] & 255) << 16) | ((inb[inOff + 10] & 255) << 8) | (inb[inOff + 11] & 255)) ^ rk[2];
        int s3 = (((inb[inOff + 12] & 255) << 24) | ((inb[inOff + 13] & 255) << 16) | ((inb[inOff + 14] & 255) << 8) | (inb[inOff + 15] & 255)) ^ rk[3];

        int t0; int t1; int t2; int t3;

        for (int r = 1; r < nr; r = r + 1) {
            int kOff = r * 4;
            t0 = T0[(s0 >> 24) & 255] ^ T1[(s1 >> 16) & 255] ^ T2[(s2 >> 8) & 255] ^ T3[s3 & 255] ^ rk[kOff + 0];
            t1 = T0[(s1 >> 24) & 255] ^ T1[(s2 >> 16) & 255] ^ T2[(s3 >> 8) & 255] ^ T3[s0 & 255] ^ rk[kOff + 1];
            t2 = T0[(s2 >> 24) & 255] ^ T1[(s3 >> 16) & 255] ^ T2[(s0 >> 8) & 255] ^ T3[s1 & 255] ^ rk[kOff + 2];
            t3 = T0[(s3 >> 24) & 255] ^ T1[(s0 >> 16) & 255] ^ T2[(s1 >> 8) & 255] ^ T3[s2 & 255] ^ rk[kOff + 3];
            s0 = t0; s1 = t1; s2 = t2; s3 = t3;
        }

        int kLast = nr * 4;
        int r0 = ((Sbox[(s0 >> 24) & 255] << 24) | (Sbox[(s1 >> 16) & 255] << 16) | (Sbox[(s2 >> 8) & 255] << 8) | Sbox[s3 & 255]) ^ rk[kLast + 0];
        int r1 = ((Sbox[(s1 >> 24) & 255] << 24) | (Sbox[(s2 >> 16) & 255] << 16) | (Sbox[(s3 >> 8) & 255] << 8) | Sbox[s0 & 255]) ^ rk[kLast + 1];
        int r2 = ((Sbox[(s2 >> 24) & 255] << 24) | (Sbox[(s3 >> 16) & 255] << 16) | (Sbox[(s0 >> 8) & 255] << 8) | Sbox[s1 & 255]) ^ rk[kLast + 2];
        int r3 = ((Sbox[(s3 >> 24) & 255] << 24) | (Sbox[(s0 >> 16) & 255] << 16) | (Sbox[(s1 >> 8) & 255] << 8) | Sbox[s2 & 255]) ^ rk[kLast + 3];

        outb[outOff + 0] = (byte)((r0 >> 24) & 255); outb[outOff + 1] = (byte)((r0 >> 16) & 255); outb[outOff + 2] = (byte)((r0 >> 8) & 255); outb[outOff + 3] = (byte)(r0 & 255);
        outb[outOff + 4] = (byte)((r1 >> 24) & 255); outb[outOff + 5] = (byte)((r1 >> 16) & 255); outb[outOff + 6] = (byte)((r1 >> 8) & 255); outb[outOff + 7] = (byte)(r1 & 255);
        outb[outOff + 8] = (byte)((r2 >> 24) & 255); outb[outOff + 9] = (byte)((r2 >> 16) & 255); outb[outOff + 10] = (byte)((r2 >> 8) & 255); outb[outOff + 11] = (byte)(r2 & 255);
        outb[outOff + 12] = (byte)((r3 >> 24) & 255); outb[outOff + 13] = (byte)((r3 >> 16) & 255); outb[outOff + 14] = (byte)((r3 >> 8) & 255); outb[outOff + 15] = (byte)(r3 & 255);
    }

    // -------------------------------------------------------------------------
    // 单分组解密（纯 Zan 逆 T-Table 原位计算，0 堆分配）
    // -------------------------------------------------------------------------
    static void DecryptCore(int[] rk, int nr, string inb, int inOff, byte[] outb, int outOff) {
        int kLast = nr * 4;
        int s0 = (((inb[inOff + 0] & 255) << 24) | ((inb[inOff + 1] & 255) << 16) | ((inb[inOff + 2] & 255) << 8) | (inb[inOff + 3] & 255)) ^ rk[kLast + 0];
        int s1 = (((inb[inOff + 4] & 255) << 24) | ((inb[inOff + 5] & 255) << 16) | ((inb[inOff + 6] & 255) << 8) | (inb[inOff + 7] & 255)) ^ rk[kLast + 1];
        int s2 = (((inb[inOff + 8] & 255) << 24) | ((inb[inOff + 9] & 255) << 16) | ((inb[inOff + 10] & 255) << 8) | (inb[inOff + 11] & 255)) ^ rk[kLast + 2];
        int s3 = (((inb[inOff + 12] & 255) << 24) | ((inb[inOff + 13] & 255) << 16) | ((inb[inOff + 14] & 255) << 8) | (inb[inOff + 15] & 255)) ^ rk[kLast + 3];

        int t0; int t1; int t2; int t3;

        for (int r = nr - 1; r >= 1; r = r - 1) {
            int kOff = r * 4;
            // 逆列混淆变换后的轮密钥
            int rk0 = InvT0[Sbox[(rk[kOff + 0] >> 24) & 255]] ^ InvT1[Sbox[(rk[kOff + 0] >> 16) & 255]] ^ InvT2[Sbox[(rk[kOff + 0] >> 8) & 255]] ^ InvT3[Sbox[rk[kOff + 0] & 255]];
            int rk1 = InvT0[Sbox[(rk[kOff + 1] >> 24) & 255]] ^ InvT1[Sbox[(rk[kOff + 1] >> 16) & 255]] ^ InvT2[Sbox[(rk[kOff + 1] >> 8) & 255]] ^ InvT3[Sbox[rk[kOff + 1] & 255]];
            int rk2 = InvT0[Sbox[(rk[kOff + 2] >> 24) & 255]] ^ InvT1[Sbox[(rk[kOff + 2] >> 16) & 255]] ^ InvT2[Sbox[(rk[kOff + 2] >> 8) & 255]] ^ InvT3[Sbox[rk[kOff + 2] & 255]];
            int rk3 = InvT0[Sbox[(rk[kOff + 3] >> 24) & 255]] ^ InvT1[Sbox[(rk[kOff + 3] >> 16) & 255]] ^ InvT2[Sbox[(rk[kOff + 3] >> 8) & 255]] ^ InvT3[Sbox[rk[kOff + 3] & 255]];

            t0 = InvT0[(s0 >> 24) & 255] ^ InvT1[(s3 >> 16) & 255] ^ InvT2[(s2 >> 8) & 255] ^ InvT3[s1 & 255] ^ rk0;
            t1 = InvT0[(s1 >> 24) & 255] ^ InvT1[(s0 >> 16) & 255] ^ InvT2[(s3 >> 8) & 255] ^ InvT3[s2 & 255] ^ rk1;
            t2 = InvT0[(s2 >> 24) & 255] ^ InvT1[(s1 >> 16) & 255] ^ InvT2[(s0 >> 8) & 255] ^ InvT3[s3 & 255] ^ rk2;
            t3 = InvT0[(s3 >> 24) & 255] ^ InvT1[(s2 >> 16) & 255] ^ InvT2[(s1 >> 8) & 255] ^ InvT3[s0 & 255] ^ rk3;
            s0 = t0; s1 = t1; s2 = t2; s3 = t3;
        }

        int r0 = ((InvSbox[(s0 >> 24) & 255] << 24) | (InvSbox[(s3 >> 16) & 255] << 16) | (InvSbox[(s2 >> 8) & 255] << 8) | InvSbox[s1 & 255]) ^ rk[0];
        int r1 = ((InvSbox[(s1 >> 24) & 255] << 24) | (InvSbox[(s0 >> 16) & 255] << 16) | (InvSbox[(s3 >> 8) & 255] << 8) | InvSbox[s2 & 255]) ^ rk[1];
        int r2 = ((InvSbox[(s2 >> 24) & 255] << 24) | (InvSbox[(s1 >> 16) & 255] << 16) | (InvSbox[(s0 >> 8) & 255] << 8) | InvSbox[s3 & 255]) ^ rk[2];
        int r3 = ((InvSbox[(s3 >> 24) & 255] << 24) | (InvSbox[(s2 >> 16) & 255] << 16) | (InvSbox[(s1 >> 8) & 255] << 8) | InvSbox[s0 & 255]) ^ rk[3];

        outb[outOff + 0] = (byte)((r0 >> 24) & 255); outb[outOff + 1] = (byte)((r0 >> 16) & 255); outb[outOff + 2] = (byte)((r0 >> 8) & 255); outb[outOff + 3] = (byte)(r0 & 255);
        outb[outOff + 4] = (byte)((r1 >> 24) & 255); outb[outOff + 5] = (byte)((r1 >> 16) & 255); outb[outOff + 6] = (byte)((r1 >> 8) & 255); outb[outOff + 7] = (byte)(r1 & 255);
        outb[outOff + 8] = (byte)((r2 >> 24) & 255); outb[outOff + 9] = (byte)((r2 >> 16) & 255); outb[outOff + 10] = (byte)((r2 >> 8) & 255); outb[outOff + 11] = (byte)(r2 & 255);
        outb[outOff + 12] = (byte)((r3 >> 24) & 255); outb[outOff + 13] = (byte)((r3 >> 16) & 255); outb[outOff + 14] = (byte)((r3 >> 8) & 255); outb[outOff + 15] = (byte)(r3 & 255);
    }

    // -------------------------------------------------------------------------
    // 公开标准接口契约
    // -------------------------------------------------------------------------

    /// <summary>AES-ECB 单块加密（16 字节 → 16 字节）。</summary>
    static byte[] EncryptBlockEcb(string key, int keyLen, string in16) {
        if ((keyLen != 16 && keyLen != 24 && keyLen != 32) || in16 == null) {
            return null;
        }
        byte[] outb = new byte[16];
        long res = NativeMemory.AesEcbBlock(key, keyLen, in16, outb);
        if (res == 0) {
            return outb;
        }
        List<int> nr = new List<int>(); nr.Add(0);
        int[] rk = ExpandKey(key, keyLen, nr);
        EncryptCore(rk, nr[0], in16, 0, outb, 0);
        return outb;
    }

    /// <summary>AES-ECB 单块解密（16 字节 → 16 字节）。</summary>
    static byte[] DecryptBlockEcb(string key, int keyLen, string in16) {
        if ((keyLen != 16 && keyLen != 24 && keyLen != 32) || in16 == null) {
            return null;
        }
        List<int> nr = new List<int>(); nr.Add(0);
        int[] rk = ExpandKey(key, keyLen, nr);
        byte[] outb = new byte[16];
        DecryptCore(rk, nr[0], in16, 0, outb, 0);
        return outb;
    }

    /// <summary>AES-CBC 加密，PKCS#7 填充。返回恰好 outLen[0] 字节的密文。</summary>
    static byte[] EncryptCbc(string key, int keyLen, string iv, string data, int len, List<int> outLen) {
        if (keyLen != 16 && keyLen != 24 && keyLen != 32) { outLen[0] = -1; return null; }
        if (len < 0 || iv == null) { outLen[0] = -1; return null; }
        if (len > 0 && data == null) { outLen[0] = -1; return null; }

        {
            int pad = 16 - (len % 16);
            int tot = len + pad;
            byte[] outb = new byte[tot];
            long res = NativeMemory.AesCbcEncrypt(outb, data, (long)len, key, keyLen, iv);
            if (res >= 0) {
                outLen[0] = (int)res;
                return outb;
            }
            /* -1 = 本机无 AES 硬件路径：落到下方纯 Zan T-Table 实现 */
        }

        List<int> nr = new List<int>(); nr.Add(0);
        int[] rk = ExpandKey(key, keyLen, nr);

        int padVal = 16 - (len % 16);
        int total = len + padVal;
        byte[] outb = new byte[total];

        byte[] blk = new byte[16];
        for (int i = 0; i < 16; i = i + 1) { blk[i] = (byte)(iv[i] & 255); }

        int off = 0;
        while (off < total) {
            for (int j = 0; j < 16; j = j + 1) {
                int b;
                if (off + j < len) {
                    b = data[off + j] & 255;
                } else {
                    b = padVal;
                }
                blk[j] = (byte)((blk[j] & 255) ^ b);
            }
            string blkStr = blk;
            EncryptCore(rk, nr[0], blkStr, 0, outb, off);
            for (int j = 0; j < 16; j = j + 1) {
                blk[j] = outb[off + j];
            }
            off = off + 16;
        }

        outLen[0] = total;
        return outb;
    }

    /// <summary>AES-CBC 解密，去除 PKCS#7 填充。常数时间填充校验，防 Padding Oracle 攻击。</summary>
    static byte[] DecryptCbc(string key, int keyLen, string iv, string data, int len, List<int> outLen) {
        if (keyLen != 16 && keyLen != 24 && keyLen != 32) { outLen[0] = -1; return null; }
        if (len <= 0 || (len % 16) != 0 || iv == null || data == null) { outLen[0] = -1; return null; }

        {
            byte[] outb = new byte[len];
            long res = NativeMemory.AesCbcDecrypt(outb, data, (long)len, key, keyLen, iv);
            if (res >= 0) {
                int plainLen = (int)res;
                outLen[0] = plainLen;
                byte[] resBytes = new byte[plainLen];
                for (int i = 0; i < plainLen; i = i + 1) { resBytes[i] = outb[i]; }
                return resBytes;
            }
            /* -1 = 本机无 AES 硬件路径：落到下方纯 Zan T-Table 实现
               （内核已做 PKCS#7 校验，-1 只代表无硬件而非填充错误）。 */
        }

        List<int> nr = new List<int>(); nr.Add(0);
        int[] rk = ExpandKey(key, keyLen, nr);

        byte[] outb = new byte[len];
        byte[] prev = new byte[16];
        for (int i = 0; i < 16; i = i + 1) { prev[i] = (byte)(iv[i] & 255); }

        byte[] dec = new byte[16];
        int off = 0;
        while (off < len) {
            string decStr = dec;
            DecryptCore(rk, nr[0], data, off, dec, 0);
            for (int j = 0; j < 16; j = j + 1) {
                outb[off + j] = (byte)((dec[j] & 255) ^ (prev[j] & 255));
                prev[j] = (byte)(data[off + j] & 255);
            }
            off = off + 16;
        }

        // 常数时间 PKCS#7 校验
        int padVal = outb[len - 1] & 255;
        int bad = 0;
        if (padVal < 1 || padVal > 16) { bad = 1; }

        for (int i = 0; i < 16; i = i + 1) {
            int idx = len - 1 - i;
            int diff = (outb[idx] & 255) ^ padVal;
            int inPad = 0;
            if (i < padVal) { inPad = 1; }
            if (inPad == 1 && diff != 0) { bad = bad | 1; }
        }

        if (bad != 0) {
            outLen[0] = -1;
            return null;
        }

        int plainLen = len - padVal;
        outLen[0] = plainLen;
        byte[] res = new byte[plainLen];
        for (int i = 0; i < plainLen; i = i + 1) { res[i] = outb[i]; }
        return res;
    }

    /// <summary>AES-CTR 流加密/解密（对称）。计数器按 128 位大端自增。</summary>
    static byte[] CryptCtr(string key, int keyLen, string iv16, string data, int len) {
        if ((keyLen != 16 && keyLen != 24 && keyLen != 32) || iv16 == null) { return null; }
        if (len < 0) { return null; }
        if (len == 0) { return new byte[0]; }
        if (data == null) { return null; }

        List<int> nr = new List<int>(); nr.Add(0);
        int[] rk = ExpandKey(key, keyLen, nr);

        byte[] ctr = new byte[16];
        for (int i = 0; i < 16; i = i + 1) { ctr[i] = (byte)(iv16[i] & 255); }

        {
            byte[] hwout = new byte[len];
            long res = NativeMemory.AesCtrCrypt(hwout, data, (long)len, key, keyLen, ctr);
            if (res >= 0) {
                return hwout;
            }
            /* -1 = 本机无 AES 硬件路径：落到下方纯 Zan 实现 */
        }

        byte[] outb = new byte[len];
        byte[] mask = new byte[16];
        int off = 0;

        while (off < len) {
            string ctrStr = ctr;
            EncryptCore(rk, nr[0], ctrStr, 0, mask, 0);

            int avail = len - off;
            if (avail > 16) { avail = 16; }
            for (int j = 0; j < avail; j = j + 1) {
                outb[off + j] = (byte)((data[off + j] & 255) ^ (mask[j] & 255));
            }

            // 128 位计数器自增
            int carry = 1;
            for (int j = 15; j >= 0; j = j - 1) {
                int sum = (ctr[j] & 255) + carry;
                ctr[j] = (byte)(sum & 255);
                carry = (sum >> 8) & 1;
            }

            off = off + 16;
        }

        return outb;
    }
}
