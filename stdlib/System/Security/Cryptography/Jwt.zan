using System;
using System.Json;
using System.Text;

namespace System.Security.Cryptography;

/// <summary>已解码的 JWT 及其签名与声明校验结果。</summary>
class JwtToken {
    bool valid;
    string error;
    string headerJson;
    string payloadJson;
    JsonValue header;
    JsonValue payload;

    /// <summary>仅当结构、算法、签名、JSON 及所请求的声明全部有效时才为 true。</summary>
    bool IsValid() { return valid; }

    /// <summary>令牌有效时返回空字符串，否则返回固定的校验错误信息。</summary>
    string Error() { return error; }

    /// <summary>解码后的紧凑 header JSON，解码失败时为空字符串。</summary>
    string HeaderJson() { return headerJson; }

    /// <summary>解码后的紧凑 payload JSON，解码失败时为空字符串。</summary>
    string PayloadJson() { return payloadJson; }

    /// <summary>解析后的 header 对象，解码或 JSON 解析失败时为 null。</summary>
    JsonValue Header() { return header; }

    /// <summary>解析后的声明对象，解码或 JSON 解析失败时为 null。</summary>
    JsonValue Payload() { return payload; }
}

/// <summary>
/// 紧凑 JWS 令牌的 JSON Web Token 辅助函数。支持 HS256 和 RS256；
/// 不安全（`none`）令牌及一切未被请求的算法都会被拒绝。解析
/// 使用调用方提供的 Unix 时间戳，因此 exp/nbf 校验结果是确定性的。
/// 预期的 issuer/audience 为空字符串时，仅禁用各自的校验。
/// </summary>
class Jwt {
    /// 令牌总长上限（128 KiB）。
    static int maxTokenSize() { return 131072; }
    /// header 段解码后字节上限（8 KiB）。
    static int maxHeaderSize() { return 8192; }
    /// payload 段解码后字节上限（64 KiB）。
    static int maxPayloadSize() { return 65536; }

    /// Base64Url 字母表（RFC 4648 §5，`-_` 代替 `+/`，无填充）。
    static string urlAlphabet() {
        return "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_";
    }

    /// Base64Url 字符 -> 6 位值；非法字符返回 -1。
    static int urlDigit(int c) {
        if (c >= 65 && c <= 90) { return c - 65; }
        if (c >= 97 && c <= 122) { return c - 71; }
        if (c >= 48 && c <= 57) { return c + 4; }
        if (c == 45) { return 62; }
        if (c == 95) { return 63; }
        return -1;
    }

    /// <summary>将恰好 <paramref name="len"/> 字节编码为无填充的 RFC 4648 Base64Url。</summary>
    static string Base64UrlEncode(string bytes, int len) {
        if (len < 0 || len > bytes.Length) { return ""; }
        string a = Jwt.urlAlphabet();
        StringBuilder sb = new StringBuilder();
        int i = 0;
        while (i + 3 <= len) {
            int n = ((bytes[i] & 255) << 16) | ((bytes[i + 1] & 255) << 8) | (bytes[i + 2] & 255);
            sb.Append(a.Substring((n >> 18) & 63, 1));
            sb.Append(a.Substring((n >> 12) & 63, 1));
            sb.Append(a.Substring((n >> 6) & 63, 1));
            sb.Append(a.Substring(n & 63, 1));
            i = i + 3;
        }
        int rem = len - i;
        if (rem == 1) {
            int n = (bytes[i] & 255) << 16;
            sb.Append(a.Substring((n >> 18) & 63, 1));
            sb.Append(a.Substring((n >> 12) & 63, 1));
        } else if (rem == 2) {
            int n = ((bytes[i] & 255) << 16) | ((bytes[i + 1] & 255) << 8);
            sb.Append(a.Substring((n >> 18) & 63, 1));
            sb.Append(a.Substring((n >> 12) & 63, 1));
            sb.Append(a.Substring((n >> 6) & 63, 1));
        }
        return sb.ToString();
    }

    /// <summary>严格解码无填充的 Base64Url。outLen[0] 为字节数，输入格式错误时为 -1。</summary>
    static byte[] Base64UrlDecode(string text, List<int> outLen) {
        int len = text.Length;
        byte[] result = new byte[len];
        if ((len & 3) == 1) { outLen[0] = -1; return result; }
        int acc = 0;
        int bits = 0;
        int count = 0;
        for (int i = 0; i < len; i = i + 1) {
            int d = Jwt.urlDigit(text[i] & 255);
            if (d < 0) { outLen[0] = -1; return result; }
            acc = (acc << 6) | d;
            bits = bits + 6;
            if (bits >= 8) {
                bits = bits - 8;
                result[count] = (acc >> bits) & 255;
                count = count + 1;
            }
        }
        if (bits > 0 && (acc & ((1 << bits) - 1)) != 0) {
            outLen[0] = -1;
            return result;
        }
        outLen[0] = count;
        return result;
    }

    /// 从 `from` 起第一个 '.' 的下标；没有则 -1。
    static int dotAt(string token, int from) {
        int i = from;
        while (i < token.Length) {
            if ((token[i] & 255) == 46) { return i; }
            i = i + 1;
        }
        return -1;
    }

    /// 常量时间比较（长度差也并入累积差），防签名校验的时序侧信道。
    static bool fixedEquals(string actual, int actualLen, string expected, int expectedLen) {
        int diff = actualLen ^ expectedLen;
        for (int i = 0; i < expectedLen; i = i + 1) {
            int a = 0;
            if (i < actualLen) { a = actual[i] & 255; }
            diff = diff | (a ^ (expected[i] & 255));
        }
        return diff == 0;
    }

    /// JSON 树中对象层是否存在重复键（重复键会改变语义，按非法拒绝）。
    static bool hasDuplicateKeys(JsonValue node) {
        if (node.IsObject()) {
            for (int i = 0; i < node.Count(); i = i + 1) {
                string key = node.KeyAt(i);
                for (int j = 0; j < i; j = j + 1) {
                    if (node.KeyAt(j) == key) { return true; }
                }
                if (Jwt.hasDuplicateKeys(node.ValAt(i))) { return true; }
            }
        } else if (node.IsArray()) {
            for (int i = 0; i < node.Count(); i = i + 1) {
                if (Jwt.hasDuplicateKeys(node.At(i))) { return true; }
            }
        }
        return false;
    }

    /// 读 JWT NumericDate（纯数字串）到 result[0]；非数字或溢出 long 时
    /// 返回 false。
    static bool readNumericDate(JsonValue node, List<long> result) {
        if (node == null || !node.IsNumber()) { return false; }
        string raw = node.AsString("");
        if (raw.Length == 0) { return false; }
        long number = 0;
        for (int i = 0; i < raw.Length; i = i + 1) {
            int digit = (raw[i] & 255) - 48;
            if (digit < 0 || digit > 9) { return false; }
            if (number > 922337203685477580 ||
                (number == 922337203685477580 && digit > 7)) { return false; }
            number = number * 10 + (long)digit;
        }
        result[0] = number;
        return true;
    }

    /// 构造校验失败的 JwtToken：valid=false，error 为固定文案，无内容。
    static JwtToken fail(string error) {
        JwtToken result = new JwtToken();
        result.valid = false;
        result.error = error;
        result.headerJson = "";
        result.payloadJson = "";
        return result;
    }

    /// 拆分三段式令牌并解码：限长、Base64Url、JSON 对象、重复键与
    /// header.alg 必须恰为 `algorithm`；失败返回带错误文案的 token。
    static JwtToken parseParts(string token, string algorithm) {
        if (token.Length > Jwt.maxTokenSize()) { return Jwt.fail("token too large"); }
        int first = Jwt.dotAt(token, 0);
        int second = -1;
        if (first >= 0) { second = Jwt.dotAt(token, first + 1); }
        if (first <= 0 || second <= first + 1 || second >= token.Length - 1
            || Jwt.dotAt(token, second + 1) >= 0) {
            return Jwt.fail("malformed token");
        }
        if (first > 10923 || second - first - 1 > 87382) {
            return Jwt.fail("jwt part too large");
        }
        List<int> len = new List<int>(); len.Add(0);
        byte[] headerBytes = Jwt.Base64UrlDecode(token.Substring(0, first), len);
        if (len[0] < 0) { return Jwt.fail("malformed base64url"); }
        if (len[0] > Jwt.maxHeaderSize()) { return Jwt.fail("header too large"); }
        string headerJson = headerBytes.ToStr(0, len[0]);
        byte[] payloadBytes = Jwt.Base64UrlDecode(token.Substring(first + 1, second - first - 1), len);
        if (len[0] < 0) { return Jwt.fail("malformed base64url"); }
        if (len[0] > Jwt.maxPayloadSize()) { return Jwt.fail("payload too large"); }
        string payloadJson = payloadBytes.ToStr(0, len[0]);
        JwtToken result = new JwtToken();
        result.headerJson = headerJson;
        result.payloadJson = payloadJson;
        try {
            result.header = JsonValue.Parse(headerJson);
            result.payload = JsonValue.Parse(payloadJson);
        } catch (JsonException e) {
            return Jwt.fail("malformed json");
        }
        if (!result.header.IsObject() || !result.payload.IsObject()) {
            return Jwt.fail("jwt json must be objects");
        }
        if (Jwt.hasDuplicateKeys(result.header) || Jwt.hasDuplicateKeys(result.payload)) {
            return Jwt.fail("duplicate json key");
        }
        JsonValue alg = result.header.Get("alg");
        if (alg == null || !alg.IsString() || alg.AsString("") != algorithm) {
            return Jwt.fail("algorithm rejected");
        }
        result.error = "";
        return result;
    }

    /// 按调用方提供的 now 校验 exp/nbf（NumericDate）与 iss/aud
    /// （空串关闭对应校验）；通过返回 ""，否则返回错误文案。
    static string validateClaims(JwtToken token, long now, string issuer, string audience) {
        JsonValue payload = token.payload;
        List<long> numericDate = new List<long>(); numericDate.Add(0);
        if (payload.Has("exp")) {
            if (!Jwt.readNumericDate(payload.Get("exp"), numericDate)) { return "invalid exp"; }
            if (now >= numericDate[0]) { return "token expired"; }
        }
        if (payload.Has("nbf")) {
            if (!Jwt.readNumericDate(payload.Get("nbf"), numericDate)) { return "invalid nbf"; }
            if (now < numericDate[0]) { return "token not active"; }
        }
        if (issuer.Length > 0) {
            JsonValue iss = payload.Get("iss");
            if (iss == null || !iss.IsString() || iss.AsString("") != issuer) {
                return "issuer mismatch";
            }
        }
        if (audience.Length > 0) {
            JsonValue aud = payload.Get("aud");
            bool match = false;
            if (aud != null && aud.IsString()) {
                match = aud.AsString("") == audience;
            } else if (aud != null && aud.IsArray()) {
                for (int i = 0; i < aud.Count(); i = i + 1) {
                    JsonValue item = aud.At(i);
                    if (item.IsString() && item.AsString("") == audience) { match = true; }
                }
            }
            if (!match) { return "audience mismatch"; }
        }
        return "";
    }

    /// <summary>由对象形式的 payload JSON 和带字节数的密钥创建 HS256 紧凑 JWT。</summary>
    static string CreateHs256(string payloadJson, string secret, int secretLen) {
        if (secretLen < 0 || secretLen > secret.Length
            || payloadJson.Length > Jwt.maxPayloadSize()) { return ""; }
        JsonValue payload = JsonValue.Parse(payloadJson);
        if (!payload.IsObject() || Jwt.hasDuplicateKeys(payload)) { return ""; }
        string header = "{\"alg\":\"HS256\",\"typ\":\"JWT\"}";
        string signing = Jwt.Base64UrlEncode(header, header.Length) + "."
            + Jwt.Base64UrlEncode(payloadJson, payloadJson.Length);
        byte[] mac = Hmac.Sha256Mac(secret, secretLen, signing, signing.Length);
        return signing + "." + Jwt.Base64UrlEncode(mac, 32);
    }

    /// <summary>仅解析并校验 HS256，然后对照显式输入验证 exp、nbf、iss 和 aud。</summary>
    static JwtToken ParseHs256(string token, string secret, int secretLen,
        long now, string issuer, string audience) {
        if (secretLen < 0 || secretLen > secret.Length) {
            return Jwt.fail("invalid secret length");
        }
        JwtToken result = Jwt.parseParts(token, "HS256");
        if (result.error.Length > 0) { return result; }
        int second = Jwt.dotAt(token, Jwt.dotAt(token, 0) + 1);
        string signing = token.Substring(0, second);
        string sigText = token.Substring(second + 1, token.Length - second - 1);
        List<int> sigLen = new List<int>(); sigLen.Add(0);
        byte[] signature = Jwt.Base64UrlDecode(sigText, sigLen);
        byte[] expected = Hmac.Sha256Mac(secret, secretLen, signing, signing.Length);
        if (sigLen[0] < 0 || !Jwt.fixedEquals(signature, sigLen[0], expected, 32)) {
            return Jwt.fail("signature mismatch");
        }
        string claimError = Jwt.validateClaims(result, now, issuer, audience);
        if (claimError.Length > 0) { return Jwt.fail(claimError); }
        result.valid = true;
        return result;
    }

    /// <summary>用 RSA 私钥创建 RS256 紧凑 JWT；密钥无法签名时返回空。</summary>
    static string CreateRs256(string payloadJson, RsaKey privateKey) {
        if (payloadJson.Length > Jwt.maxPayloadSize()) { return ""; }
        JsonValue payload = JsonValue.Parse(payloadJson);
        if (!payload.IsObject() || Jwt.hasDuplicateKeys(payload) || privateKey == null) { return ""; }
        string header = "{\"alg\":\"RS256\",\"typ\":\"JWT\"}";
        string signing = Jwt.Base64UrlEncode(header, header.Length) + "."
            + Jwt.Base64UrlEncode(payloadJson, payloadJson.Length);
        string signatureBase64 = privateKey.SignSha256(signing);
        if (signatureBase64.Length == 0) { return ""; }
        List<int> sigLen = new List<int>(); sigLen.Add(0);
        byte[] signature = Base64.Decode(signatureBase64, sigLen);
        return signing + "." + Jwt.Base64UrlEncode(signature, sigLen[0]);
    }

    /// <summary>仅解析并校验 RS256，然后对照显式输入验证 exp、nbf、iss 和 aud。</summary>
    static JwtToken ParseRs256(string token, RsaKey publicKey,
        long now, string issuer, string audience) {
        JwtToken result = Jwt.parseParts(token, "RS256");
        if (result.error.Length > 0) { return result; }
        if (publicKey == null) { return Jwt.fail("signature mismatch"); }
        int second = Jwt.dotAt(token, Jwt.dotAt(token, 0) + 1);
        string signing = token.Substring(0, second);
        string sigText = token.Substring(second + 1, token.Length - second - 1);
        List<int> sigLen = new List<int>(); sigLen.Add(0);
        byte[] signature = Jwt.Base64UrlDecode(sigText, sigLen);
        if (sigLen[0] < 0 || !publicKey.VerifySha256(signing, Base64.Encode(signature, sigLen[0]))) {
            return Jwt.fail("signature mismatch");
        }
        string claimError = Jwt.validateClaims(result, now, issuer, audience);
        if (claimError.Length > 0) { return Jwt.fail(claimError); }
        result.valid = true;
        return result;
    }
}
