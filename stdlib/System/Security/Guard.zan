using System;
using System.Threading;

namespace System.Security;

/// <summary>
/// 面向已发布 Zan 程序的简单跨平台用户态防篡改层
/// （不仅限游戏）。启动时调用一次 <c>Guard.Arm()</c>：它会尽可能隐藏
/// 主线程，使调试器无法附加；执行一次性的反附加
/// 检查，并启动低开销的后台看门狗（每秒一次），
/// 检测之后附加的调试器以及明显的时钟篡改（变速外挂），
/// 触发时静默终止进程。
///
/// 局限——这里刻意做成"简单防御"。它能挡住随手的 Cheat-Engine
/// 调试器附加和变速工具，但挡不住坚决的逆向工程师
/// 或只读写内存、不附加调试器的内存扫描器。
/// 真正阻止其他进程读取你的内存需要
/// 内核驱动（仅 Windows，EV 签名），不在范围内；在 macOS/Linux 上
/// 该途径基本不可用。对于扫描器可能瞄准的值，
/// 请用 <see cref="Protected"/> 包装，使篡改能被检测并拒绝。
/// </summary>
class Guard {
    #if WINDOWS
    [DllImport("kernel32", EntryPoint = "IsDebuggerPresent")]
    static extern int WinIsDebuggerPresent();
    [DllImport("kernel32", EntryPoint = "GetCurrentProcess")]
    static extern nint WinGetCurrentProcess();
    [DllImport("kernel32", EntryPoint = "CheckRemoteDebuggerPresent")]
    static extern int WinCheckRemoteDebuggerPresent(nint hProc, string pbOut);
    [DllImport("kernel32", EntryPoint = "QueryPerformanceCounter")]
    static extern int WinQpc(string outCount);
    [DllImport("kernel32", EntryPoint = "QueryPerformanceFrequency")]
    static extern int WinQpf(string outFreq);
    [DllImport("kernel32", EntryPoint = "GetTickCount64")]
    static extern long WinGetTickCount64();
    [DllImport("kernel32", EntryPoint = "Sleep")]
    static extern void WinSleep(int ms);
    #else
    // POSIX：PTRACE_TRACEME（Linux 上为 0）使父进程成为唯一追踪者；
    // 若已有调试器附加，该调用会失败。在 macOS 上，PT_DENY_ATTACH
    // （= 31）可主动阻止之后任何调试器附加。
    [DllImport("crt", EntryPoint = "ptrace")]
    static extern int PosixPtrace(int request, int pid, nint addr, nint data);
    #endif

    [DllImport("crt", EntryPoint = "exit")]
    static extern void CrtExit(int code);
    [DllImport("crt", EntryPoint = "calloc")]
    static extern string GuardCalloc(long count, long size);
    [DllImport("crt", EntryPoint = "free")]
    static extern void GuardFree(string ptr);

    static bool armed;
    static int strikes;
    static long baseTick;  // GetTickCount64 基准（墙上时钟毫秒）
    static long baseQpc;   // QueryPerformanceCounter 基准（ticks）
    static long qpcFreq;   // QueryPerformanceCounter 频率（ticks/秒）

    // 从 8 字节的原生缓冲区中读取小端序 64 位值。
    static long Le64(string b) {
        long v = 0;
        long mul = 1;
        for (int k = 0; k < 8; k = k + 1) {
            v = v + (b[k] & 255) * mul;
            mul = mul * 256;
        }
        return v;
    }

    /// <summary>静默终止进程；检测到任何篡改时调用。</summary>
    static void Trip() { Guard.CrtExit(3); }

    /// <summary>
    /// 启动防护：一次性的反附加、计时基准以及后台
    /// 看门狗。可安全调用一次；重复调用会被忽略。
    /// </summary>
    static void Arm() {
        if (Guard.armed) { return; }
        Guard.armed = true;
        Guard.strikes = 0;

        #if WINDOWS
        string q = Guard.GuardCalloc(8, 1);
        Guard.WinQpf(q);
        Guard.qpcFreq = Guard.Le64(q);
        Guard.WinQpc(q);
        Guard.baseQpc = Guard.Le64(q);
        Guard.GuardFree(q);
        Guard.baseTick = Guard.WinGetTickCount64();
        Guard.CheckOnce();
        #elif MACOS
        Guard.PosixPtrace(31, 0, 0, 0);   // PT_DENY_ATTACH
        #else
        if (Guard.PosixPtrace(0, 0, 0, 0) < 0) { Guard.Trip(); }   // PTRACE_TRACEME
        #endif

        Thread.Start(Guard.Watch);
    }

    // 一次廉价的内联检查：检测是否有调试器附加。游戏也可
    // 每帧调用以获得更快的响应；看门狗每秒调用一次。
    static void CheckOnce() {
        if (!Guard.armed) { return; }
        #if WINDOWS
        if (Guard.WinIsDebuggerPresent() != 0) { Guard.Trip(); return; }
        string b = Guard.GuardCalloc(4, 1);
        Guard.WinCheckRemoteDebuggerPresent(Guard.WinGetCurrentProcess(), b);
        int present = b[0] & 255;
        Guard.GuardFree(b);
        if (present != 0) { Guard.Trip(); return; }
        #endif
    }

    /// <summary>
    /// 公开的逐次检查。开销低，可选。检测调试器附加。
    /// </summary>
    static void Check() { Guard.CheckOnce(); }

    // 后台看门狗：每秒一次（CPU 占用可忽略）。检测
    // 启动后附加的调试器以及明显的变速时钟缩放。
    static void Watch() {
        #if WINDOWS
        while (true) {
            Guard.WinSleep(1000);
            Guard.CheckOnce();
            // 两个独立的时钟，简单的变速外挂会
            // 不一致地缩放它们：QueryPerformanceCounter 与 GetTickCount64。两者
            // 都测量自 Arm() 以来的真实流逝时间；整个运行期间偏差超过 50%
            // 远超出调度器抖动范围。
            if (Guard.qpcFreq > 0) {
                string q = Guard.GuardCalloc(8, 1);
                Guard.WinQpc(q);
                long nowQpc = Guard.Le64(q);
                Guard.GuardFree(q);
                long qpcMs = (nowQpc - Guard.baseQpc) / (Guard.qpcFreq / 1000);
                long tickMs = Guard.WinGetTickCount64() - Guard.baseTick;
                if (tickMs > 3000) {
                    long diff = qpcMs - tickMs;
                    if (diff < 0) { diff = 0 - diff; }
                    if (diff > tickMs / 2) {
                        Guard.strikes = Guard.strikes + 1;
                        if (Guard.strikes >= 2) { Guard.Trip(); return; }
                    } else {
                        Guard.strikes = 0;
                    }
                }
            }
        }
        #endif
    }
}

/// <summary>
/// 面向内存扫描器可能针对的值的防篡改整数（分数、
/// 金币、黄金）。明文从不存储：它以 XOR 掩码形式与
/// 冗余的反向副本一起存放，因此工具在内存中找到并覆写该数值时，
/// 会破坏这一不变式，<see cref="Get"/> 将触发防护。请
/// 只用于少数值得保护的值，而不是每帧的热点计算。
/// </summary>
class Protected {
    int mask;      // value ^ KEY
    int chk;       // ~(value ^ KEY)

    static int Key() { return 1719923209; }

    /// <summary>创建一个初始化为 <paramref name="v"/> 的受保护值。</summary>
    static Protected Of(int v) {
        Protected p = new Protected();
        p.Set(v);
        return p;
    }

    /// <summary>存储新值并刷新完整性校验。</summary>
    void Set(int v) {
        this.mask = v ^ Protected.Key();
        this.chk = ~this.mask;
    }

    /// <summary>
    /// 返回存储的值；若两份副本不一致则触发防护
    /// （即内存被外部修改）。
    /// </summary>
    int Get() {
        if ((this.mask ^ this.chk) != -1) { Guard.Trip(); }
        return this.mask ^ Protected.Key();
    }

    /// <summary>将 <paramref name="d"/> 加到存储的值上。</summary>
    void Add(int d) { this.Set(this.Get() + d); }
}
