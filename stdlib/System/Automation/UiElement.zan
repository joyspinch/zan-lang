    /// <summary>角色码 -> 可读名称;未知角色返回 "role:N"。</summary>
    static string RoleName(int role) {
        if (role == 0x1) { return "titlebar"; }
        if (role == 0x2) { return "menubar"; }
        if (role == 0x3) { return "scrollbar"; }
        if (role == 0x4) { return "grip"; }
        if (role == 0x5) { return "sound"; }
        if (role == 0x6) { return "cursor"; }
        if (role == 0x7) { return "caret"; }
        if (role == 0x8) { return "alert"; }
        if (role == 0x9) { return "window"; }
        if (role == 0xA) { return "client"; }
        if (role == 0xB) { return "menupopup"; }
        if (role == 0xC) { return "menuitem"; }
        if (role == 0xD) { return "tooltip"; }
        if (role == 0xE) { return "application"; }
        if (role == 0xF) { return "document"; }
        if (role == 0x10) { return "pane"; }
        if (role == 0x11) { return "chart"; }
        if (role == 0x12) { return "dialog"; }
        if (role == 0x13) { return "border"; }
        if (role == 0x14) { return "grouping"; }
        if (role == 0x15) { return "separator"; }
        if (role == 0x16) { return "toolbar"; }
        if (role == 0x17) { return "statusbar"; }
        if (role == 0x18) { return "table"; }
        if (role == 0x19) { return "columnheader"; }
        if (role == 0x1A) { return "rowheader"; }
        if (role == 0x1B) { return "column"; }
        if (role == 0x1C) { return "row"; }
        if (role == 0x1D) { return "cell"; }
        if (role == 0x1E) { return "link"; }
        if (role == 0x1F) { return "helpballoon"; }
        if (role == 0x20) { return "character"; }
        if (role == 0x21) { return "list"; }
        if (role == 0x22) { return "listitem"; }
        if (role == 0x23) { return "outline"; }
        if (role == 0x24) { return "outlineitem"; }
        if (role == 0x25) { return "pagetab"; }
        if (role == 0x26) { return "propertypage"; }
        if (role == 0x27) { return "indicator"; }
        if (role == 0x28) { return "graphic"; }
        if (role == 0x29) { return "statictext"; }
        if (role == 0x2A) { return "text"; }
        if (role == 0x2B) { return "pushbutton"; }
        if (role == 0x2C) { return "checkbutton"; }
        if (role == 0x2D) { return "radiobutton"; }
        if (role == 0x2E) { return "combobox"; }
        if (role == 0x2F) { return "droplist"; }
        if (role == 0x30) { return "progressbar"; }
        if (role == 0x31) { return "dial"; }
        if (role == 0x32) { return "hotkeyfield"; }
        if (role == 0x33) { return "slider"; }
        if (role == 0x34) { return "spinbutton"; }
        if (role == 0x35) { return "diagram"; }
        if (role == 0x36) { return "animation"; }
        if (role == 0x37) { return "equation"; }
        if (role == 0x38) { return "buttondropdown"; }
        if (role == 0x39) { return "buttonmenu"; }
        if (role == 0x3A) { return "buttondropdowngrid"; }
        if (role == 0x3B) { return "whitespace"; }
        if (role == 0x3C) { return "pagetablist"; }
        if (role == 0x3D) { return "clock"; }
        if (role == 0x3E) { return "splitbutton"; }
        if (role == 0x3F) { return "ipaddress"; }
        if (role == 0x40) { return "outlinebutton"; }
        return "role:" + Convert.ToString(role);
    }

