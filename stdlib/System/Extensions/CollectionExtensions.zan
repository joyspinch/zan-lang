using System;
using System.Collections.Generic;
using System.Collections.ObjectModel;

namespace System;

// 集合只读抽象与防御性拷贝扩展方法。
public class CollectionExtensions {
    // 将 List<T> 包装为只读 ReadOnlyCollection<T> 视图返回。
    public static ReadOnlyCollection<T> AsReadOnly<T>(this List<T> list) {
        if (list == null) {
            throw new ArgumentNullException("list");
        }
        return new ReadOnlyCollection<T>(list);
    }

    // 将 Dictionary<TKey, TValue> 包装为只读 ReadOnlyDictionary<TKey, TValue> 视图返回。
    public static ReadOnlyDictionary<TKey, TValue> AsReadOnly<TKey, TValue>(this Dictionary<TKey, TValue> dict) {
        if (dict == null) {
            throw new ArgumentNullException("dict");
        }
        return new ReadOnlyDictionary<TKey, TValue>(dict);
    }
}
