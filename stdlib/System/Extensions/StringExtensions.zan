using System;
using System.Text;

namespace System;

public class StringExtensions {
    public static bool IsNullOrEmpty(this string s) {
        return s == null || s.Length == 0;
    }

    // 【生存期约束 / B-ID112】返回非 owning 视图，严禁脱离源字符串生存期或用于临时表达式结果。
    public static StringView AsView(this string s) {
        return StringView.FromString(s);
    }

    public static StringView AsView(this string s, int start, int count) {
        if (s == null) { return StringView.Empty(); }
        return StringView.FromString(s).Slice(start, count);
    }

    // 【生存期约束 / B-ID112】返回非 owning 视图，使用期间严禁追加/修改源 StringBuilder 以免扩容重分配致悬垂。
    public static StringView AsView(this StringBuilder sb) {
        if (sb == null || sb.Length <= 0) { return StringView.Empty(); }
        return new StringView(sb.BufferPtr(), sb.Length);
    }

    public static StringView AsView(this StringBuilder sb, int start, int count) {
        if (sb == null || count <= 0) { return StringView.Empty(); }
        if (start < 0 || count < 0 || start + count > sb.Length) {
            throw new ArgumentOutOfRangeException("StringBuilder.AsView range invalid");
        }
        return new StringView(sb.BufferPtr() + (nint)start, count);
    }

    public static bool IsWhitespaceByte(int b) {
        return b == 32 || b == 9 || b == 10 || b == 13 || b == 11 || b == 12;
    }

    public static bool IsWhitespaceCodePoint(int cp) {
        if (StringExtensions.IsWhitespaceByte(cp)) { return true; }
        return cp == 160 || cp == 5760 || cp == 6158 || cp == 8192 || cp == 8193 ||
            cp == 8194 || cp == 8195 || cp == 8196 || cp == 8197 || cp == 8198 ||
            cp == 8199 || cp == 8200 || cp == 8201 || cp == 8202 || cp == 8232 ||
            cp == 8233 || cp == 8239 || cp == 8287 || cp == 12288 || cp == 65279;
    }

    public static bool IsNullOrWhiteSpace(this string s) {
        if (s == null) { return true; }
        int len = s.Length;
        if (len == 0) { return true; }
        int i = 0;
        nint p = (nint)s;
        while (i + 16 <= len) {
            Vector128 v = Vector128.Load(p + (nint)i);
            Vector128 sp = Vector128.Equals(v, Vector128.Create((byte)32));
            if (Vector128.ExtractMostSignificantBits(sp) != 65535) { break; }
            i = i + 16;
        }
        while (i < len) {
            if (!StringExtensions.IsWhitespaceByte(s[i] & 255)) { return false; }
            i = i + 1;
        }
        return true;
    }

    private static string PadCore(string s, int width, string pad, bool padLeft) {
        int runes = s.RuneCount();
        int diff = width - runes;
        if (diff <= 0) { return s; }
        string firstRune = pad.Length == 1 ? pad : pad.RuneAt(0);
        if (firstRune.Length == 0) { firstRune = " "; }
        if (firstRune.Length == 1 && runes == s.Length) {
            byte p = (byte)(firstRune[0] & 255);
            byte[] buf = new byte[width];
            int padStart = padLeft ? 0 : s.Length;
            int strStart = padLeft ? diff : 0;
            for (int i = 0; i < diff; i = i + 1) { buf[padStart + i] = p; }
            for (int j = 0; j < s.Length; j = j + 1) { buf[strStart + j] = (byte)(s[j] & 255); }
            return buf.ToStr(0, width);
        }
        StringBuilder sb = new StringBuilder();
        if (!padLeft) { sb.Append(s); }
        for (int k = 0; k < diff; k = k + 1) { sb.Append(firstRune); }
        if (padLeft) { sb.Append(s); }
        return sb.ToString();
    }

    public static string PadLeft(this string s, int width) {
        if (s == null) { return null; }
        return StringExtensions.PadCore(s, width, " ", true);
    }

    public static string PadLeft(this string s, int width, string pad) {
        if (s == null || pad == null || pad.Length == 0) { return s; }
        return StringExtensions.PadCore(s, width, pad, true);
    }

    public static string PadRight(this string s, int width) {
        if (s == null) { return null; }
        return StringExtensions.PadCore(s, width, " ", false);
    }

    public static string PadRight(this string s, int width, string pad) {
        if (s == null || pad == null || pad.Length == 0) { return s; }
        return StringExtensions.PadCore(s, width, pad, false);
    }

    public static string TrimStart(this string s) {
        if (s == null) { return null; }
        int len = s.Length;
        int i = 0;
        while (i < len) {
            int b = s[i] & 255;
            if (b < 128) {
                if (StringExtensions.IsWhitespaceByte(b)) { i = i + 1; continue; }
                break;
            }
            long res = Encoding.DecodeCodePointFast(s, i);
            int used = (int)(res >> 32);
            if (used <= 0) { used = 1; }
            if (!StringExtensions.IsWhitespaceCodePoint((int)(res & 0xFFFFFFFFL))) { break; }
            i = i + used;
        }
        if (i == 0) { return s; }
        if (i >= len) { return ""; }
        return s.Substring(i, len - i);
    }

    public static string TrimEnd(this string s) {
        if (s == null) { return null; }
        int len = s.Length;
        if (len == 0) { return ""; }
        int i = 0;
        int lastNonWs = 0;
        while (i < len) {
            int b = s[i] & 255;
            if (b < 128) {
                if (!StringExtensions.IsWhitespaceByte(b)) { lastNonWs = i + 1; }
                i = i + 1;
                continue;
            }
            long res = Encoding.DecodeCodePointFast(s, i);
            int used = (int)(res >> 32);
            if (used <= 0) { used = 1; }
            if (!StringExtensions.IsWhitespaceCodePoint((int)(res & 0xFFFFFFFFL))) {
                lastNonWs = i + used;
            }
            i = i + used;
        }
        if (lastNonWs == len) { return s; }
        if (lastNonWs == 0) { return ""; }
        return s.Substring(0, lastNonWs);
    }

    public static string Insert(this string s, int index, string text) {
        int at = index;
        if (at < 0) { at = 0; }
        if (at > s.Length) { at = s.Length; }
        return s.Substring(0, at) + text + s.Substring(at, s.Length - at);
    }

    public static string Remove(this string s, int start) {
        if (start <= 0) { return ""; }
        if (start >= s.Length) { return s; }
        return s.Substring(0, start);
    }

    public static string Remove(this string s, int start, int count) {
        int at = start;
        if (at < 0) { at = 0; }
        if (at >= s.Length) { return s; }
        int n = count < 0 ? 0 : count;
        if (at + n > s.Length) { n = s.Length - at; }
        return s.Substring(0, at) + s.Substring(at + n, s.Length - at - n);
    }

    public static int CompareTo(this string s, string other) { return String.CompareOrdinal(s, other); }
    public static bool EqualsOrdinal(this string s, string other) { return String.CompareOrdinal(s, other) == 0; }

    public static List<string> ToCharList(this string s) {
        List<string> outp = new List<string>();
        if (s == null || s.Length == 0) { return outp; }
        int n = s.Length;
        int i = 0;
        while (i < n) {
            long res = Encoding.DecodeCodePointFast(s, i);
            int used = (int)(res >> 32);
            if (used <= 0) { used = 1; }
            outp.Add(s.Substring(i, used));
            i = i + used;
        }
        return outp;
    }

    public static List<string> ToByteCharList(this string s) {
        List<string> outp = new List<string>();
        if (s == null) { return outp; }
        for (int i = 0; i < s.Length; i = i + 1) { outp.Add(s.Substring(i, 1)); }
        return outp;
    }

    public static int CountOf(this string s, string needle) {
        if (s == null || needle == null || needle.Length == 0) { return 0; }
        int n = 0;
        int nlen = needle.Length;
        int i = s.IndexOf(needle, 0);
        while (i >= 0) {
            n = n + 1;
            i = s.IndexOf(needle, i + nlen);
        }
        return n;
    }

    public static int ToInt32(this string s, int fallback) {
        if (s == null) { return fallback; }
        int v;
        return int.TryParse(s, out v) ? v : fallback;
    }

    public static int ToInt32(this string s) { return s.ToInt32(0); }

    public static long ToInt64(this string s, long fallback) {
        if (s == null) { return fallback; }
        long v;
        return long.TryParse(s, out v) ? v : fallback;
    }

    public static long ToInt64(this string s) { return s.ToInt64(0L); }

    public static double ToDouble(this string s, double fallback) {
        if (s == null) { return fallback; }
        double v;
        return double.TryParse(s, out v) ? v : fallback;
    }

    public static double ToDouble(this string s) { return s.ToDouble(0.0); }

    // A67：s[i] 取字节，以下扩展显式区分字节访问与 Unicode 码点访问。
    public static int ByteAt(this string s, int index) {
        if (s == null || index < 0 || index >= s.Length) { return -1; }
        return s[index] & 255;
    }

    public static string RuneAt(this string s, int byteIndex) { return Encoding.RuneAt(s, byteIndex); }

    public static int RuneCount(this string s) {
        return s == null ? 0 : Encoding.CodePointCount(s);
    }

    public static string CharAt(this string s, int runeIndex) {
        return s == null ? "" : Encoding.RuneFromIndex(s, runeIndex);
    }

    public static byte[] FromHexString(this string s) {
        return s == null ? new byte[0] : System.Convert.FromHexString(s);
    }

    public static string ToUpperAscii(this string s) {
        if (s == null) { return null; }
        int len = s.Length;
        if (len == 0) { return ""; }
        byte[] b = s.ToBytes();
        MemoryExtensions.ToUpperAscii(b, 0, len);
        return b.ToStr(0, len);
    }

    public static string ToLowerAscii(this string s) {
        if (s == null) { return null; }
        int len = s.Length;
        if (len == 0) { return ""; }
        byte[] b = s.ToBytes();
        MemoryExtensions.ToLowerAscii(b, 0, len);
        return b.ToStr(0, len);
    }

    public static string Normalize(this string s, NormalizationForm form) { return UnicodeNormalization.Normalize(s, form); }
    public static string Normalize(this string s) { return UnicodeNormalization.Normalize(s, NormalizationForm.FormC); }
    public static bool IsNormalized(this string s, NormalizationForm form) { return UnicodeNormalization.IsNormalized(s, form); }
    public static bool IsNormalized(this string s) { return UnicodeNormalization.IsNormalized(s, NormalizationForm.FormC); }
    public static string CaseFold(this string s) { return UnicodeCase.CaseFold(s); }
    public static bool Equals(this string s, string other, StringComparison comparison) { return UnicodeCase.Equals(s, other, comparison); }
    public static bool EqualsNormalized(this string s, string other, bool ignoreCase) { return UnicodeCase.EqualsNormalized(s, other, ignoreCase); }
    public static bool EqualsNormalized(this string s, string other) { return UnicodeCase.EqualsNormalized(s, other, false); }
}
