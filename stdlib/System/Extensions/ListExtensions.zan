using System;

namespace System;

// 泛型比较器委托：x 小于 y 返回负数，等于返回 0，大于返回正数。
public delegate int Comparison<T>(T x, T y);

// 编译器不会原生降低的 List<T> 操作。
// 以扩展方法（`this List<T>` 接收方）的形式编写，以便
// 像成员一样调用：`items.Remove(x)`。此前这些调用会被编译成
// 常量 0 / 静默空操作，把普通的 Remove 或 Sort 变成
// 一个没有诊断信息的 bug。
public class ListExtensions {
    // 移除第一个等于 `item` 的元素；返回是否
    // 确实移除了某个元素。
    public static bool Remove<T>(this List<T> src, T item) {
        for (int i = 0; i < src.Count; i = i + 1) {
            if (src[i] == item) {
                src.RemoveAt(i);
                return true;
            }
        }
        return false;
    }

    // 从 `start` 开始的 `count` 个元素的副本。范围会
    // 被限制在列表范围内。
    public static List<T> GetRange<T>(this List<T> src, int start, int count) {
        List<T> outp = new List<T>();
        int at = start;
        if (at < 0) { at = 0; }
        int n = count;
        if (at + n > src.Count) { n = src.Count - at; }
        for (int i = 0; i < n; i = i + 1) { outp.Add(src[at + i]); }
        return outp;
    }

    // 原地升序排序整数（自适应快速排序，O(N log N)）。
    public static void Sort(this List<int> src) {
        if (src == null || src.Count <= 1) { return; }
        ListExtensions.QuickSortInt(src, 0, src.Count - 1);
    }

    // 内省排序（introsort）：三数取中 + Hoare 划分；只递归较小一侧、较大一侧
    // 循环处理（栈深 O(log n)）；递归深度超过 2·log2(n) 改走堆排序（最坏 O(n log n)）；
    // 16 个以内插入排序。曾是不带深度上限、两侧都递归的快速排序。
    public static void QuickSortInt(List<int> a, int lo, int hi) {
        if (hi <= lo) { return; }
        ListExtensions.IntroSortInt(a, lo, hi, 2 * ListExtensions.FloorLog2(hi - lo + 1));
    }

    static void IntroSortInt(List<int> a, int lo, int hi, int depth) {
        while (hi - lo >= 16) {
            if (depth == 0) {
                ListExtensions.HeapSortInt(a, lo, hi);
                return;
            }
            depth = depth - 1;
            int mid = lo + (hi - lo) / 2;
            if (a[mid] < a[lo]) { int t = a[lo]; a[lo] = a[mid]; a[mid] = t; }
            if (a[hi] < a[lo]) { int t = a[lo]; a[lo] = a[hi]; a[hi] = t; }
            if (a[hi] < a[mid]) { int t = a[mid]; a[mid] = a[hi]; a[hi] = t; }
            int pivot = a[mid];
            int i = lo;
            int j = hi;
            while (i <= j) {
                while (a[i] < pivot) { i = i + 1; }
                while (pivot < a[j]) { j = j - 1; }
                if (i <= j) {
                    int t = a[i]; a[i] = a[j]; a[j] = t;
                    i = i + 1;
                    j = j - 1;
                }
            }
            if (j - lo < hi - i) {
                if (lo < j) { ListExtensions.IntroSortInt(a, lo, j, depth); }
                lo = i;
            } else {
                if (i < hi) { ListExtensions.IntroSortInt(a, i, hi, depth); }
                hi = j;
            }
        }
        for (int k = lo + 1; k <= hi; k = k + 1) {
            int v = a[k];
            int m = k - 1;
            while (m >= lo && v < a[m]) {
                a[m + 1] = a[m];
                m = m - 1;
            }
            a[m + 1] = v;
        }
    }

    static void HeapSortInt(List<int> a, int lo, int hi) {
        int n = hi - lo + 1;
        int start = n / 2 - 1;
        while (start >= 0) {
            ListExtensions.SiftInt(a, lo, start, n);
            start = start - 1;
        }
        int end = n - 1;
        while (end > 0) {
            int t = a[lo]; a[lo] = a[lo + end]; a[lo + end] = t;
            ListExtensions.SiftInt(a, lo, 0, end);
            end = end - 1;
        }
    }

    static void SiftInt(List<int> a, int lo, int root, int n) {
        int r = root;
        while (2 * r + 1 < n) {
            int child = 2 * r + 1;
            if (child + 1 < n && a[lo + child] < a[lo + child + 1]) { child = child + 1; }
            if (!(a[lo + r] < a[lo + child])) { return; }
            int t = a[lo + r]; a[lo + r] = a[lo + child]; a[lo + child] = t;
            r = child;
        }
    }

    // 原地升序排序数值（自适应快速排序，O(N log N)）。
    public static void Sort(this List<double> src) {
        if (src == null || src.Count <= 1) { return; }
        ListExtensions.QuickSortDouble(src, 0, src.Count - 1);
    }

    // 内省排序（introsort）：三数取中 + Hoare 划分；只递归较小一侧、较大一侧
    // 循环处理（栈深 O(log n)）；递归深度超过 2·log2(n) 改走堆排序（最坏 O(n log n)）；
    // 16 个以内插入排序。曾是不带深度上限、两侧都递归的快速排序。
    public static void QuickSortDouble(List<double> a, int lo, int hi) {
        if (hi <= lo) { return; }
        ListExtensions.IntroSortDouble(a, lo, hi, 2 * ListExtensions.FloorLog2(hi - lo + 1));
    }

    static void IntroSortDouble(List<double> a, int lo, int hi, int depth) {
        while (hi - lo >= 16) {
            if (depth == 0) {
                ListExtensions.HeapSortDouble(a, lo, hi);
                return;
            }
            depth = depth - 1;
            int mid = lo + (hi - lo) / 2;
            if (a[mid] < a[lo]) { double t = a[lo]; a[lo] = a[mid]; a[mid] = t; }
            if (a[hi] < a[lo]) { double t = a[lo]; a[lo] = a[hi]; a[hi] = t; }
            if (a[hi] < a[mid]) { double t = a[mid]; a[mid] = a[hi]; a[hi] = t; }
            double pivot = a[mid];
            int i = lo;
            int j = hi;
            while (i <= j) {
                while (a[i] < pivot) { i = i + 1; }
                while (pivot < a[j]) { j = j - 1; }
                if (i <= j) {
                    double t = a[i]; a[i] = a[j]; a[j] = t;
                    i = i + 1;
                    j = j - 1;
                }
            }
            if (j - lo < hi - i) {
                if (lo < j) { ListExtensions.IntroSortDouble(a, lo, j, depth); }
                lo = i;
            } else {
                if (i < hi) { ListExtensions.IntroSortDouble(a, i, hi, depth); }
                hi = j;
            }
        }
        for (int k = lo + 1; k <= hi; k = k + 1) {
            double v = a[k];
            int m = k - 1;
            while (m >= lo && v < a[m]) {
                a[m + 1] = a[m];
                m = m - 1;
            }
            a[m + 1] = v;
        }
    }

    static void HeapSortDouble(List<double> a, int lo, int hi) {
        int n = hi - lo + 1;
        int start = n / 2 - 1;
        while (start >= 0) {
            ListExtensions.SiftDouble(a, lo, start, n);
            start = start - 1;
        }
        int end = n - 1;
        while (end > 0) {
            double t = a[lo]; a[lo] = a[lo + end]; a[lo + end] = t;
            ListExtensions.SiftDouble(a, lo, 0, end);
            end = end - 1;
        }
    }

    static void SiftDouble(List<double> a, int lo, int root, int n) {
        int r = root;
        while (2 * r + 1 < n) {
            int child = 2 * r + 1;
            if (child + 1 < n && a[lo + child] < a[lo + child + 1]) { child = child + 1; }
            if (!(a[lo + r] < a[lo + child])) { return; }
            double t = a[lo + r]; a[lo + r] = a[lo + child]; a[lo + child] = t;
            r = child;
        }
    }

    // 原地按序数升序排序字符串（自适应快速排序，O(N log N)）。
    public static void Sort(this List<string> src) {
        if (src == null || src.Count <= 1) { return; }
        ListExtensions.QuickSortString(src, 0, src.Count - 1);
    }

    // 内省排序（introsort）：三数取中 + Hoare 划分；只递归较小一侧、较大一侧
    // 循环处理（栈深 O(log n)）；递归深度超过 2·log2(n) 改走堆排序（最坏 O(n log n)）；
    // 16 个以内插入排序。曾是不带深度上限、两侧都递归的快速排序。
    public static void QuickSortString(List<string> a, int lo, int hi) {
        if (hi <= lo) { return; }
        ListExtensions.IntroSortString(a, lo, hi, 2 * ListExtensions.FloorLog2(hi - lo + 1));
    }

    static void IntroSortString(List<string> a, int lo, int hi, int depth) {
        while (hi - lo >= 16) {
            if (depth == 0) {
                ListExtensions.HeapSortString(a, lo, hi);
                return;
            }
            depth = depth - 1;
            int mid = lo + (hi - lo) / 2;
            if (String.CompareOrdinal(a[mid], a[lo]) < 0) { string t = a[lo]; a[lo] = a[mid]; a[mid] = t; }
            if (String.CompareOrdinal(a[hi], a[lo]) < 0) { string t = a[lo]; a[lo] = a[hi]; a[hi] = t; }
            if (String.CompareOrdinal(a[hi], a[mid]) < 0) { string t = a[mid]; a[mid] = a[hi]; a[hi] = t; }
            string pivot = a[mid];
            int i = lo;
            int j = hi;
            while (i <= j) {
                while (String.CompareOrdinal(a[i], pivot) < 0) { i = i + 1; }
                while (String.CompareOrdinal(pivot, a[j]) < 0) { j = j - 1; }
                if (i <= j) {
                    string t = a[i]; a[i] = a[j]; a[j] = t;
                    i = i + 1;
                    j = j - 1;
                }
            }
            if (j - lo < hi - i) {
                if (lo < j) { ListExtensions.IntroSortString(a, lo, j, depth); }
                lo = i;
            } else {
                if (i < hi) { ListExtensions.IntroSortString(a, i, hi, depth); }
                hi = j;
            }
        }
        for (int k = lo + 1; k <= hi; k = k + 1) {
            string v = a[k];
            int m = k - 1;
            while (m >= lo && String.CompareOrdinal(v, a[m]) < 0) {
                a[m + 1] = a[m];
                m = m - 1;
            }
            a[m + 1] = v;
        }
    }

    static void HeapSortString(List<string> a, int lo, int hi) {
        int n = hi - lo + 1;
        int start = n / 2 - 1;
        while (start >= 0) {
            ListExtensions.SiftString(a, lo, start, n);
            start = start - 1;
        }
        int end = n - 1;
        while (end > 0) {
            string t = a[lo]; a[lo] = a[lo + end]; a[lo + end] = t;
            ListExtensions.SiftString(a, lo, 0, end);
            end = end - 1;
        }
    }

    static void SiftString(List<string> a, int lo, int root, int n) {
        int r = root;
        while (2 * r + 1 < n) {
            int child = 2 * r + 1;
            if (child + 1 < n && String.CompareOrdinal(a[lo + child], a[lo + child + 1]) < 0) { child = child + 1; }
            if (!(String.CompareOrdinal(a[lo + r], a[lo + child]) < 0)) { return; }
            string t = a[lo + r]; a[lo + r] = a[lo + child]; a[lo + child] = t;
            r = child;
        }
    }

    // 使用自定义比较器原地排序任意对象列表（自适应快速排序，O(N log N)）。
    public static void Sort<T>(this List<T> src, Comparison<T> comparison) {
        if (src == null || src.Count <= 1 || comparison == null) { return; }
        ListExtensions.QuickSortCustom<T>(src, 0, src.Count - 1, comparison);
    }

    // 内省排序（introsort）：三数取中 + Hoare 划分；只递归较小一侧、较大一侧
    // 循环处理（栈深 O(log n)）；递归深度超过 2·log2(n) 改走堆排序（最坏 O(n log n)）；
    // 16 个以内插入排序。曾是不带深度上限、两侧都递归的快速排序。
    public static void QuickSortCustom<T>(List<T> a, int lo, int hi, Comparison<T> cmp) {
        if (hi <= lo) { return; }
        ListExtensions.IntroSortCustom<T>(a, lo, hi, 2 * ListExtensions.FloorLog2(hi - lo + 1), cmp);
    }

    static void IntroSortCustom<T>(List<T> a, int lo, int hi, int depth, Comparison<T> cmp) {
        while (hi - lo >= 16) {
            if (depth == 0) {
                ListExtensions.HeapSortCustom<T>(a, lo, hi, cmp);
                return;
            }
            depth = depth - 1;
            int mid = lo + (hi - lo) / 2;
            if (cmp(a[mid], a[lo]) < 0) { T t = a[lo]; a[lo] = a[mid]; a[mid] = t; }
            if (cmp(a[hi], a[lo]) < 0) { T t = a[lo]; a[lo] = a[hi]; a[hi] = t; }
            if (cmp(a[hi], a[mid]) < 0) { T t = a[mid]; a[mid] = a[hi]; a[hi] = t; }
            T pivot = a[mid];
            int i = lo;
            int j = hi;
            while (i <= j) {
                while (cmp(a[i], pivot) < 0) { i = i + 1; }
                while (cmp(pivot, a[j]) < 0) { j = j - 1; }
                if (i <= j) {
                    T t = a[i]; a[i] = a[j]; a[j] = t;
                    i = i + 1;
                    j = j - 1;
                }
            }
            if (j - lo < hi - i) {
                if (lo < j) { ListExtensions.IntroSortCustom<T>(a, lo, j, depth, cmp); }
                lo = i;
            } else {
                if (i < hi) { ListExtensions.IntroSortCustom<T>(a, i, hi, depth, cmp); }
                hi = j;
            }
        }
        for (int k = lo + 1; k <= hi; k = k + 1) {
            T v = a[k];
            int m = k - 1;
            while (m >= lo && cmp(v, a[m]) < 0) {
                a[m + 1] = a[m];
                m = m - 1;
            }
            a[m + 1] = v;
        }
    }

    static void HeapSortCustom<T>(List<T> a, int lo, int hi, Comparison<T> cmp) {
        int n = hi - lo + 1;
        int start = n / 2 - 1;
        while (start >= 0) {
            ListExtensions.SiftCustom<T>(a, lo, start, n, cmp);
            start = start - 1;
        }
        int end = n - 1;
        while (end > 0) {
            T t = a[lo]; a[lo] = a[lo + end]; a[lo + end] = t;
            ListExtensions.SiftCustom<T>(a, lo, 0, end, cmp);
            end = end - 1;
        }
    }

    static void SiftCustom<T>(List<T> a, int lo, int root, int n, Comparison<T> cmp) {
        int r = root;
        while (2 * r + 1 < n) {
            int child = 2 * r + 1;
            if (child + 1 < n && cmp(a[lo + child], a[lo + child + 1]) < 0) { child = child + 1; }
            if (!(cmp(a[lo + r], a[lo + child]) < 0)) { return; }
            T t = a[lo + r]; a[lo + r] = a[lo + child]; a[lo + child] = t;
            r = child;
        }
    }

    // floor(log2(n))，n >= 1
    public static int FloorLog2(int n) {
        int r = 0;
        int v = n;
        while (v > 1) { v = v >> 1; r = r + 1; }
        return r;
    }
}
