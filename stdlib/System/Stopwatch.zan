using System;

namespace System.Diagnostics;

/// <summary>
/// 高分辨率计时器。Windows 上使用 QueryPerformanceCounter，
/// POSIX 上使用 clock_gettime(CLOCK_MONOTONIC) —— 两者都不受墙钟时间
/// 变化（NTP 同步、手动改时）影响，计时结果保持准确。
///
///   Stopwatch sw = new Stopwatch();
///   sw.Start();
///   ... work ...
///   sw.Stop();
///   long ms = sw.ElapsedMilliseconds();
/// </summary>
class Stopwatch {
    #if WINDOWS
    [DllImport("kernel32", EntryPoint = "QueryPerformanceFrequency")]
    static extern int PlatQueryPerformanceFrequency(nint freq);

    [DllImport("kernel32", EntryPoint = "QueryPerformanceCounter")]
    static extern int PlatQueryPerformanceCounter(nint count);
    #else
    [DllImport("crt", EntryPoint = "zan_monotonic_ns")]
    static extern long ZanMonotonicNs();
    #endif

    long startTicks;
    long accumulated;   // Start 与 Stop 之间的 tick 数（频率单位）
    bool running;

    /// <summary>开始（或继续）计时，可安全重复调用。</summary>
    static Stopwatch StartNew() {
        Stopwatch sw = new Stopwatch();
        sw.Start();
        return sw;
    }

    /// <summary>开始（或继续）计时。</summary>
    void Start() {
        if (running) { return; }
        running = true;
        startTicks = Stopwatch.NowTicks();
    }

    /// <summary>停止计时；多次 Start/Stop 的耗时会累加。</summary>
    void Stop() {
        if (!running) { return; }
        accumulated = accumulated + Stopwatch.NowTicks() - startTicks;
        running = false;
    }

    /// <summary>重置累计时间（运行中则同时停止）。</summary>
    void Reset() {
        running = false;
        accumulated = 0;
    }

    /// <summary>重新开始：清零并启动。</summary>
    void Restart() {
        Reset();
        Start();
    }

    /// <summary>总耗时（毫秒，双精度）。
    /// 计时器可能仍在运行；读数包含当前累计值。</summary>
    double ElapsedMilliseconds() {
        return (double)ElapsedTicks() / (double)Stopwatch.Frequency() * 1000.0;
    }

    /// <summary>总耗时（秒，双精度）。</summary>
    double ElapsedSeconds() {
        return (double)ElapsedTicks() / (double)Stopwatch.Frequency();
    }

    /// <summary>以原始频率单位表示的耗时（参见 <see cref="Frequency"/>）。</summary>
    long ElapsedTicks() {
        long total = accumulated;
        if (running) {
            total = total + Stopwatch.NowTicks() - startTicks;
        }
        return total;
    }

    /// <summary>计时器运行中返回 true。</summary>
    bool IsRunning() {
        return running;
    }

    /// <summary>高分辨率时钟每秒的 tick 数。</summary>
    static long Frequency() {
        #if WINDOWS
        nint buf = NativeMemory.Alloc(8);
        PlatQueryPerformanceFrequency(buf);
        long f = new Span<long>(buf, 1)[0];
        NativeMemory.Free(buf);
        return f;
        #else
        return 1000000000;   // clock_gettime 以纳秒计
        #endif
    }

    /// <summary>当前单调时钟读数（频率单位）。</summary>
    static long NowTicks() {
        #if WINDOWS
        nint buf = NativeMemory.Alloc(8);
        PlatQueryPerformanceCounter(buf);
        long t = new Span<long>(buf, 1)[0];
        NativeMemory.Free(buf);
        return t;
        #else
        // C 端 zan_monotonic_ns 使用编译期的 CLOCK_MONOTONIC 宏和原生
        // struct timespec 布局——Linux 的时钟 id 是 1 而 macOS 是 6。
        return Stopwatch.ZanMonotonicNs();
        #endif
    }
}
