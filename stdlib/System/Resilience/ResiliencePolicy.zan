using System;
using System.Threading;

namespace System.Resilience;

// 指数退避重试策略。
public class RetryStrategy {
    int maxRetries;
    int initialDelayMs;
    int maxDelayMs;
    double backoffMultiplier;

    public RetryStrategy(int maxRetries, int initialDelayMs, int maxDelayMs, double backoffMultiplier) {
        this.maxRetries = maxRetries > 0 ? maxRetries : 3;
        this.initialDelayMs = initialDelayMs > 0 ? initialDelayMs : 50;
        this.maxDelayMs = maxDelayMs >= this.initialDelayMs ? maxDelayMs : 2000;
        this.backoffMultiplier = backoffMultiplier >= 1.0 ? backoffMultiplier : 2.0;
    }

    public static RetryStrategy CreateDefault() {
        return new RetryStrategy(3, 50, 2000, 2.0);
    }

    public int MaxRetries() { return this.maxRetries; }
    public int InitialDelayMs() { return this.initialDelayMs; }
    public int MaxDelayMs() { return this.maxDelayMs; }

    // 计算第 attempt 次重试（1-based）应等待的毫秒数。
    public int ComputeDelayMs(int attempt) {
        if (attempt <= 1) {
            return this.initialDelayMs;
        }
        double delay = (double)this.initialDelayMs;
        for (int i = 1; i < attempt; i = i + 1) {
            delay = delay * this.backoffMultiplier;
            if (delay >= (double)this.maxDelayMs) {
                return this.maxDelayMs;
            }
        }
        int result = (int)delay;
        if (result > this.maxDelayMs) {
            result = this.maxDelayMs;
        }
        return result;
    }
}

// 令牌桶限流器：平滑流量突发、杜绝下游被脉冲击穿。
public class TokenBucketRateLimiter {
    int capacity;
    int refillRatePerSec;
    double currentTokens;
    long lastRefillTicks;
    nint mtx;

    public TokenBucketRateLimiter(int capacity, int refillRatePerSec) {
        this.capacity = capacity > 0 ? capacity : 100;
        this.refillRatePerSec = refillRatePerSec > 0 ? refillRatePerSec : 50;
        this.currentTokens = (double)this.capacity;
        this.lastRefillTicks = Stopwatch.NowTicks();
        this.mtx = Mutex.Create();
    }

    public int Capacity() { return this.capacity; }
    public int RefillRatePerSec() { return this.refillRatePerSec; }

    // 尝试获取 1 个令牌（非阻塞）。成功返回 true，被限流返回 false。
    public bool TryAcquire() {
        return this.TryAcquire(1);
    }

    // 尝试获取指定数量的令牌。
    public bool TryAcquire(int count) {
        if (count <= 0) { return true; }
        Mutex.Lock(this.mtx);
        try {
            long nowTicks = Stopwatch.NowTicks();
            long freq = Stopwatch.Frequency();
            if (freq > 0) {
                double elapsedSec = (double)(nowTicks - this.lastRefillTicks) / (double)freq;
                if (elapsedSec > 0.0) {
                    this.currentTokens = this.currentTokens + elapsedSec * (double)this.refillRatePerSec;
                    if (this.currentTokens > (double)this.capacity) {
                        this.currentTokens = (double)this.capacity;
                    }
                    this.lastRefillTicks = nowTicks;
                }
            }
            if (this.currentTokens >= (double)count) {
                this.currentTokens = this.currentTokens - (double)count;
                return true;
            }
            return false;
        } finally {
            Mutex.Unlock(this.mtx);
        }
    }

    // 重置限流器至满桶状态。
    public void Reset() {
        Mutex.Lock(this.mtx);
        try {
            this.currentTokens = (double)this.capacity;
            this.lastRefillTicks = Stopwatch.NowTicks();
        } finally {
            Mutex.Unlock(this.mtx);
        }
    }
}
