using System;
using System.Threading;

namespace System.Resilience;

// 令牌桶限流器：平滑流量突发、杜绝下游被脉冲击穿。
public class TokenBucketRateLimiter : IDisposable {
    public int capacity;
    public int refillRatePerSec;
    public double currentTokens;
    public long lastRefillTicks;
    public nint mtx;

    public TokenBucketRateLimiter(int capacity, int refillRatePerSec) {
        this.capacity = capacity > 0 ? capacity : 100;
        this.refillRatePerSec = refillRatePerSec > 0 ? refillRatePerSec : 50;
        this.currentTokens = (double)this.capacity;
        this.lastRefillTicks = Stopwatch.NowTicks();
        this.mtx = Mutex.Create();
    }


    public void Dispose() {
        if (this.mtx != 0) {
            Mutex.Destroy(this.mtx);
            this.mtx = 0;
        }
    }

    public int Capacity() { return this.capacity; }
    public int RefillRatePerSec() { return this.refillRatePerSec; }

    // 尝试获取 1 个令牌（非阻塞）。成功返回 true，被限流返回 false。
    public bool TryAcquire() {
        return this.TryAcquire(1);
    }

    // 尝试获取指定数量的令牌。
    public bool TryAcquire(int count) {
        if (count <= 0) { return true; }
        if (this.mtx == 0) { return false; }
        Mutex.Lock(this.mtx);
        try {
            long nowTicks = Stopwatch.NowTicks();
            long freq = Stopwatch.Frequency();
            if (freq > 0) {
                double elapsedSec = (double)(nowTicks - this.lastRefillTicks) / (double)freq;
                if (elapsedSec > 0.0) {
                    this.currentTokens = this.currentTokens + elapsedSec * (double)this.refillRatePerSec;
                    if (this.currentTokens > (double)this.capacity) {
                        this.currentTokens = (double)this.capacity;
                    }
                    this.lastRefillTicks = nowTicks;
                }
            }
            if (this.currentTokens >= (double)count) {
                this.currentTokens = this.currentTokens - (double)count;
                return true;
            }
            return false;
        } finally {
            Mutex.Unlock(this.mtx);
        }
    }

    // 重置限流器至满桶状态。
    public void Reset() {
        if (this.mtx == 0) { return; }
        Mutex.Lock(this.mtx);
        try {
            this.currentTokens = (double)this.capacity;
            this.lastRefillTicks = Stopwatch.NowTicks();
        } finally {
            Mutex.Unlock(this.mtx);
        }
    }
}
