#if WINDOWS
using System;

namespace System.Platform;

// Windows 平台的动态链接库与系统错误码实现（基于 Win32 kernel32）。
public class WindowsLibraryLoader : IPlatformLibraryLoader {
    [DllImport("kernel32", EntryPoint = "LoadLibraryW")]
    private static extern nint WinLoadLibraryW(nint widePath);

    [DllImport("kernel32", EntryPoint = "GetProcAddress")]
    private static extern nint WinGetProcAddress(nint mod, string name);

    [DllImport("kernel32", EntryPoint = "FreeLibrary")]
    private static extern int WinFreeLibrary(nint mod);

    [DllImport("kernel32", EntryPoint = "GetLastError")]
    private static extern int WinGetLastError();

    [DllImport("kernel32", EntryPoint = "SetLastError")]
    private static extern void WinSetLastError(int dwErrCode);

    string lastError = "";

    public nint LoadLibrary(string name) {
        if (name == null || name.Length == 0) {
            this.lastError = "win32 error 87";
            return 0;
        }
        nint wname = Pal.Text.StringToWide(name);
        nint mod = 0;
        try {
            mod = WindowsLibraryLoader.WinLoadLibraryW(wname);
        } finally {
            Pal.Text.Free(wname);
        }
        if (mod == 0) {
            int err = WindowsLibraryLoader.WinGetLastError();
            this.lastError = "win32 error " + Convert.ToString(err);
        } else {
            this.lastError = "";
        }
        return mod;
    }

    public nint GetSymbol(nint handle, string name) {
        if (handle == 0 || name == null) { return 0; }
        nint sym = WindowsLibraryLoader.WinGetProcAddress(handle, name);
        if (sym == 0) {
            int err = WindowsLibraryLoader.WinGetLastError();
            this.lastError = "win32 error " + Convert.ToString(err);
        } else {
            this.lastError = "";
        }
        return sym;
    }

    public bool FreeLibrary(nint handle) {
        if (handle == 0) { return true; }
        int res = WindowsLibraryLoader.WinFreeLibrary(handle);
        return res != 0;
    }

    public string GetLastError() {
        return this.lastError;
    }

    public int GetLastSystemError() {
        return WindowsLibraryLoader.WinGetLastError();
    }

    public void SetLastSystemError(int error) {
        WindowsLibraryLoader.WinSetLastError(error);
    }

    public string MapLibraryName(string name) {
        if (name == null || name.Length == 0) { return ""; }
        if (name.EndsWith(".dll") || name.EndsWith(".DLL")) {
            return name;
        }
        return name + ".dll";
    }
}
#endif
