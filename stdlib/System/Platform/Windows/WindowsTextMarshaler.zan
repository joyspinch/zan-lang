using System;
using System.Interop;

namespace System.Platform;

#if WINDOWS
// Windows Win32 平台原生 UTF-16 文本封送实现。
public class WindowsTextMarshaler : IPlatformTextMarshaler {
    [DllImport("kernel32", EntryPoint = "MultiByteToWideChar")]
    static extern int WinMultiByteToWideChar(int page, int flags, nint mb, int mbLen,
                                             nint wide, int wideLen);

    [DllImport("kernel32", EntryPoint = "WideCharToMultiByte")]
    static extern int WinWideCharToMultiByte(int page, int flags, nint wide, int wideLen,
                                             nint mb, int mbLen, nint defChar, nint usedDef);

    public int CharSize() {
        return 2;
    }

    public nint StringToWide(string s) {
        if (s == null) { return 0; }
        int bytes = s.Length;
        nint src = NativeMemory.Alloc(bytes + 1);
        nint dst = 0;
        try {
            NativeMemory.PutString(src, 0, s, bytes);
            new Span<byte>(src + bytes, 1)[0] = 0;
            int units = WinMultiByteToWideChar(65001 /* CP_UTF8 */, 0, src, bytes + 1, 0, 0);
            if (units <= 0) { units = 1; }
            dst = NativeMemory.Alloc(units * 2 + 2);
            WinMultiByteToWideChar(65001 /* CP_UTF8 */, 0, src, bytes + 1, dst, units);
        } finally {
            NativeMemory.Free(src);
        }
        return dst;
    }

    public string WideToString(nint p) {
        if (p == 0) { return ""; }
        int bytes = WinWideCharToMultiByte(65001 /* CP_UTF8 */, 0, p, -1, 0, 0, 0, 0);
        if (bytes <= 1) { return ""; }
        nint buf = NativeMemory.Alloc(bytes + 1);
        string s = "";
        try {
            WinWideCharToMultiByte(65001 /* CP_UTF8 */, 0, p, -1, buf, bytes, 0, 0);
            s = NativeMemory.GetString(buf, 0, bytes - 1);
        } finally {
            NativeMemory.Free(buf);
        }
        return s;
    }

    public int WideLength(nint p) {
        if (p == 0) { return 0; }
        int n = 0;
        for (; new Span<ushort>(p + n * 2, 1)[0] != 0; n = n + 1) { }
        return n;
    }

    public void Free(nint p) {
        if (p != 0) {
            NativeMemory.Free(p);
        }
    }
}
#endif
