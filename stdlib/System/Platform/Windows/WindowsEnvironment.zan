using System;
using System.Interop;

namespace System.Platform;

#if WINDOWS
// Windows Win32 原生进程环境与系统实现。
public class WindowsEnvironment : IPlatformEnvironment {
    [DllImport("kernel32", EntryPoint = "GetModuleFileNameW")]
    static extern int WinGetModuleFileName(nint module, nint buf, int size);

    [DllImport("kernel32", EntryPoint = "GetCurrentProcessId")]
    static extern int WinGetCurrentProcessId();

    [DllImport("kernel32", EntryPoint = "SetEnvironmentVariableW")]
    static extern int WinSetEnvironmentVariable(nint name, nint val);

    [DllImport("kernel32", EntryPoint = "GetEnvironmentVariableW")]
    static extern int WinGetEnvironmentVariable(nint name, nint buf, int size);

    [DllImport("advapi32", EntryPoint = "SystemFunction036")]
    static extern int WinRtlGenRandom(byte[] buf, int len);

    [DllImport("crt", EntryPoint = "zan_cpu_count")]
    static extern int NativeCpuCount();

    public string NewLine() {
        return "\r\n";
    }

    public int ProcessId() {
        return WinGetCurrentProcessId();
    }

    public string ExecutablePath() {
        nint buf = NativeMemory.Alloc(8192);
        string exe = "";
        try {
            int n = WinGetModuleFileName(0, buf, 4096);
            if (n > 0 && n < 4096) {
                exe = Wide.Read(buf);
            }
        } finally {
            NativeMemory.Free(buf);
        }
        return exe;
    }

    public string GetEnvironmentVariable(string name) {
        if (name == null || name == "") { return ""; }
        nint wname = Wide.Of(name);
        nint buf = 0;
        string text = "";
        try {
            buf = NativeMemory.Alloc(2048);
            new Span<short>(buf, 1)[0] = 0;
            int size = 1023;
            int units = WinGetEnvironmentVariable(wname, buf, size);
            if (units >= size && units < 32768) {
                NativeMemory.Free(buf);
                buf = 0;
                size = units + 1;
                buf = NativeMemory.Alloc(size * 2);
                units = WinGetEnvironmentVariable(wname, buf, size);
            }
            if (units > 0 && units < size) { text = Wide.Read(buf); }
        } finally {
            if (buf != 0) { NativeMemory.Free(buf); }
            Wide.Free(wname);
        }
        return text;
    }

    public bool SetEnvironmentVariable(string name, string value) {
        if (name == null || name == "") { return false; }
        nint wname = Wide.Of(name);
        nint wval = (value != null) ? Wide.Of(value) : 0;
        int ok = 0;
        try {
            ok = WinSetEnvironmentVariable(wname, wval);
        } finally {
            Wide.Free(wname);
            if (wval != 0) { Wide.Free(wval); }
        }
        return ok != 0;
    }

    public int GetRandomBytes(byte[] buf, int count) {
        if (buf == null || count <= 0) { return 0; }
        int ok = WinRtlGenRandom(buf, count);
        if (ok == 0) { return 0; }
        return count;
    }

    public int ProcessorCount() {
        int n = NativeCpuCount();
        if (n > 0) { return n; }
        return 1;
    }
}
#endif
