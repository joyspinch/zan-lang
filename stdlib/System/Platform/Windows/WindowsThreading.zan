#if WINDOWS
using System;

namespace System.Platform;

// Windows 平台的线程休眠与底层同步原语实现（基于 Win32 Sleep、SRWLOCK 与匿名内核信号量）。
public class WindowsThreading : IPlatformThreading {
    [DllImport("kernel32", EntryPoint = "Sleep")]
    private static extern void WinSleep(int milliseconds);

    [DllImport("crt", EntryPoint = "calloc")]
    private static extern nint WinCalloc(long count, long size);

    [DllImport("crt", EntryPoint = "free")]
    private static extern void WinFree(nint ptr);

    [DllImport("kernel32", EntryPoint = "InitializeSRWLock")]
    private static extern void WinInitializeSRWLock(nint srwLock);

    [DllImport("kernel32", EntryPoint = "AcquireSRWLockExclusive")]
    private static extern void WinAcquireSRWLockExclusive(nint srwLock);

    [DllImport("kernel32", EntryPoint = "ReleaseSRWLockExclusive")]
    private static extern void WinReleaseSRWLockExclusive(nint srwLock);

    [DllImport("kernel32", EntryPoint = "CreateSemaphoreA")]
    private static extern nint WinCreateSemaphore(nint secAttrs, int initialCount, int maxCount, nint name);

    [DllImport("kernel32", EntryPoint = "WaitForSingleObject")]
    private static extern int WinWaitForSingleObject(nint handle, int milliseconds);

    [DllImport("kernel32", EntryPoint = "ReleaseSemaphore")]
    private static extern int WinReleaseSemaphore(nint handle, int releaseCount, nint prevCount);

    [DllImport("kernel32", EntryPoint = "CloseHandle")]
    private static extern int WinCloseHandle(nint handle);

    public static void SleepDirect(int milliseconds) {
        if (milliseconds > 0) {
            WindowsThreading.WinSleep(milliseconds);
        }
    }

    public void Sleep(int milliseconds) {
        WindowsThreading.SleepDirect(milliseconds);
    }

    public nint CreateMutex() {
        nint lockPtr = WindowsThreading.WinCalloc(1, 8);
        if (lockPtr != 0) {
            WindowsThreading.WinInitializeSRWLock(lockPtr);
        }
        return lockPtr;
    }

    public void LockMutex(nint handle) {
        if (handle != 0) {
            WindowsThreading.WinAcquireSRWLockExclusive(handle);
        }
    }

    public void UnlockMutex(nint handle) {
        if (handle != 0) {
            WindowsThreading.WinReleaseSRWLockExclusive(handle);
        }
    }

    public void DestroyMutex(nint handle) {
        if (handle != 0) {
            WindowsThreading.WinFree(handle);
        }
    }

    public nint CreateSemaphore(int initialCount, int maxCount) {
        return WindowsThreading.WinCreateSemaphore(0, initialCount, maxCount, 0);
    }

    public void WaitSemaphore(nint handle) {
        if (handle != 0) {
            WindowsThreading.WinWaitForSingleObject(handle, -1);
        }
    }

    public bool WaitForSemaphore(nint handle, int timeoutMs) {
        if (handle == 0) { return false; }
        return WindowsThreading.WinWaitForSingleObject(handle, timeoutMs) == 0;
    }

    public void ReleaseSemaphore(nint handle) {
        if (handle != 0) {
            WindowsThreading.WinReleaseSemaphore(handle, 1, 0);
        }
    }

    public void DestroySemaphore(nint handle) {
        if (handle != 0) {
            WindowsThreading.WinCloseHandle(handle);
        }
    }
}
#endif
