using System;

namespace System.Platform;

// 跨平台进程环境与系统信息核心契约接口（PAL Environment）。
// 规范：平台实现必须在底层封装 Win32 / POSIX 系统调用，
// 统一向外提供强类型、无平台条件编译的进程元数据、环境字典与随机数源。
public interface IPlatformEnvironment {
    // 当前平台换行字符串（Windows 为 "\r\n"，POSIX 为 "\n"）。
    string NewLine();

    // 当前进程唯一标识符（PID）。不支持平台返回 0。
    int ProcessId();

    // 正在运行的可执行文件绝对路径。无法确定时返回 ""。
    string ExecutablePath();

    // 从当前进程检索指定环境变量的值。未找到或空时返回 ""。
    string GetEnvironmentVariable(string name);

    // 创建、修改或删除当前进程中的环境变量。value 为 null 时删除。
    bool SetEnvironmentVariable(string name, string value);

    // 用加密安全随机数据填充缓冲区的指定字节数。返回实际写入的字节数。
    int GetRandomBytes(string buf, int count);

    // 当前系统可用的逻辑处理器核心数。
    int ProcessorCount();
}
