using System;

namespace System.Platform;

// 跨平台底层网络套接字与协议驱动核心契约接口（PAL Network）。
// 规范：平台实现必须在底层封装 WinSock2 / POSIX socket 系统调用与非阻塞选项，
// 统一向外提供强类型、无平台条件编译的套接字句柄生命周期与原生系统调用。
public interface IPlatformNetwork {
    // 初始化套接字子系统（Windows 下执行 WSAStartup，POSIX 下为无操作）。
    void Initialize();

    // 清理套接字子系统（Windows 下释放资源，POSIX 下为无操作）。
    void Cleanup();

    // 创建 TCP 套接字句柄（AF_INET / AF_INET6，SOCK_STREAM）。
    nint CreateTcpSocket(bool ipv6);

    // 创建 UDP 套接字句柄（AF_INET / AF_INET6，SOCK_DGRAM）。
    nint CreateUdpSocket(bool ipv6);

    // 创建原始原生套接字句柄。
    nint CreateSocket(int af, int type, int protocol);

    // 关闭套接字句柄（Windows closesocket，POSIX close）。
    int CloseSocket(nint s);

    // 优雅关闭套接字收发方向（how: 0=receive, 1=send, 2=both）。
    int Shutdown(nint s, int how);

    // 绑定本地地址。
    int Bind(nint s, string addr, int addrlen);

    // 启动监听。
    int Listen(nint s, int backlog);

    // 接受连接请求。
    nint Accept(nint s, string addr, string addrlen);

    // 连接对端服务器。
    int Connect(nint s, string addr, int addrlen);

    // 设置套接字为非阻塞模式（Windows ioctlsocket FIONBIO，POSIX fcntl O_NONBLOCK）。
    int SetNonBlocking(nint s);

    // 取消套接字上所有挂起的原生 IO 操作（Windows CancelIoEx，POSIX 为无操作）。
    void CancelPendingIo(nint s);

    // 设置套接字选项。
    int SetSocketOption(nint s, int level, int optname, string optval, int optlen);

    // 设置地址复用 (SO_REUSEADDR)。
    void SetReuseAddress(nint s, bool on);

    // 设置端口复用 (SO_REUSEPORT)。
    void SetReusePort(nint s, bool on);

    // 设置禁用 Nagle 算法 (TCP_NODELAY)。
    void SetNoDelay(nint s, bool on);

    // 启用广播 (SO_BROADCAST)。
    void SetBroadcast(nint s, bool on);

    // 发送数据报（UDP sendto）。
    int SendTo(nint s, string buf, int len, int flags, string to, int tolen);

    // 接收数据报（UDP recvfrom）。
    int RecvFrom(nint s, string buf, int len, int flags, string from, string fromlen);

    // 获取当前线程最近一次原生套接字错误码（Windows WSAGetLastError，POSIX errno）。
    int GetLastSocketError();

    // 判断地址族常量是否为 IPv6（Windows 为 23，macOS 为 30，Linux 为 10）。
    bool IsIpv6Family(int family);

    // 判断是否为 UDP 端口不可达导致的假死重置错误（Windows WSAECONNRESET=10054，POSIX 为 false）。
    bool IsUdpResetError(int error);

    // 平台是否支持重叠 IO 异步 Accept (AcceptEx/AcceptOv)（Windows 为 true，POSIX 为 false）。
    bool SupportsAsyncAcceptOv();

    // 判断 accept 错误是否为瞬态重试错误（Linux/macOS 特有错误码，Windows 为 false）。
    bool IsTransientAcceptError(int error);

    // 从已解析的 IPv4 整数地址构建 16 字节 sockaddr_in 结构。
    byte[] CreateSockAddrV4(int ipAddr, int port);
}
