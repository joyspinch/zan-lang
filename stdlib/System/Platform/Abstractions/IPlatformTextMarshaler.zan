using System;

namespace System.Platform;

// 跨平台宽字符与原生文本封送契约接口（PAL TextMarshaler）。
// 规范：平台实现负责在底层完成 UTF-8 字符串与操作系统原生宽字符缓冲区之间的转换。
// Windows 原生 wchar_t 为 2 字节（UTF-16 LE）；
// POSIX (Linux / macOS / WASI) 原生 wchar_t 为 4 字节（UTF-32）。
public interface IPlatformTextMarshaler {
    // 原生 wchar_t 字节大小：Windows 为 2，POSIX 为 4。
    int CharSize();

    // 将 UTF-8 字符串转换为以 NUL 结尾的平台原生宽字符缓冲区。用 Free() 释放。
    // null 字符串返回 0。
    nint StringToWide(string s);

    // 将以 NUL 结尾的平台原生宽字符缓冲区读取回 Zan UTF-8 字符串。
    // 指针为 0 时返回 ""。
    string WideToString(nint p);

    // 计算以 NUL 结尾的平台原生宽字符缓冲区中的字符数量（不含 NUL 终止符）。
    // 指针为 0 时返回 0。
    int WideLength(nint p);

    // 释放由 StringToWide 分配的原生宽字符缓冲区。
    void Free(nint p);
}
