using System;

namespace System.Platform;

// 跨平台文件与路径系统核心抽象契约（PAL FileSystem）。
// 规范：平台实现必须在底层封装 Win32 / POSIX 系统调用与原生数据结构，
// 对外提供统一的 UTF-8 编码路径与强类型参数接口。
public interface IPlatformFileSystem {
    // 平台特性
    bool IsCaseSensitive();

    // 目录生命周期与枚举
    bool DirectoryExists(string path);
    void CreateDirectory(string path);
    void DeleteDirectory(string path);
    string GetCurrentDirectory();
    void SetCurrentDirectory(string path);
    List<string> GetLogicalDrives();
    List<PlatformFileEntry> EnumerateEntries(string path, bool wantDirs, bool includeHidden);

    // 文件操作与元数据
    bool FileExists(string path);
    void DeleteFile(string path);
    void Move(string src, string dst, bool overwrite);
    long GetLength(string path);
    int GetAttributes(string path);
    bool SetAttributes(string path, int attrs);
    long GetTime(string path, int which); // 0=LastWrite, 1=Creation, 2=LastAccess
    bool SetTime(string path, int which, long unixSec);

    // 符号链接、硬链接、执行位与文件锁
    bool CreateHardLink(string link, string target);
    bool IsSymlink(string path);
    bool IsReparsePoint(string path);
    bool SetExecutable(string path, bool on);
    bool IsExecutable(string path);
    long TryLock(string path);
    bool Unlock(long lockHandle);
}
