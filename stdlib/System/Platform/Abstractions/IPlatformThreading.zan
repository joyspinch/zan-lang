using System;

namespace System.Platform;

// 跨平台线程与底层同步原语契约接口（PAL Threading）。
// 规范：平台实现必须在底层封装 Win32 SRWLOCK/Semaphore/Sleep 与
// POSIX pthread_mutex_t/GCD dispatch_semaphore/sem_t/usleep，
// 统一向外提供强类型、无平台条件编译的线程休眠与同步原语生命周期。
public interface IPlatformThreading {
    // 当前线程休眠指定的毫秒数（Windows Sleep，POSIX usleep）。
    void Sleep(int milliseconds);

    // 创建底层互斥锁（Windows SRWLOCK，POSIX pthread_mutex_t）。
    nint CreateMutex();

    // 独占加互斥锁。
    void LockMutex(nint handle);

    // 释放互斥锁。
    void UnlockMutex(nint handle);

    // 销毁互斥锁并释放原生内存。
    void DestroyMutex(nint handle);

    // 创建底层信号量（Windows CreateSemaphoreA，macOS dispatch_semaphore，Linux sem_t）。
    nint CreateSemaphore(int initialCount, int maxCount);

    // 无限阻塞等待获取一个信号量许可。
    void WaitSemaphore(nint handle);

    // 最多等待 timeoutMs 毫秒获取一个信号量许可。
    // 成功获取返回 true；超时返回 false（此时不消耗许可）；负数超时无限等待。
    bool WaitForSemaphore(nint handle, int timeoutMs);

    // 释放一个信号量许可。
    void ReleaseSemaphore(nint handle);

    // 销毁并释放信号量句柄及原生内存。
    void DestroySemaphore(nint handle);
}
