using System;

namespace System.Platform;

// 平台归一化文件系统条目（目录遍历项快照）。
public class PlatformFileEntry {
    public string name;
    public int attributes;
    public long length;
    public long lastWriteTimeSec;

    public PlatformFileEntry(string name, int attributes, long length, long lastWriteTimeSec) {
        this.name = name;
        this.attributes = attributes;
        this.length = length;
        this.lastWriteTimeSec = lastWriteTimeSec;
    }

    public bool IsDirectory() {
        return (this.attributes & 4) != 0;
    }

    public bool IsHidden() {
        return (this.attributes & 2) != 0;
    }

    public bool IsReadOnly() {
        return (this.attributes & 1) != 0;
    }
}
