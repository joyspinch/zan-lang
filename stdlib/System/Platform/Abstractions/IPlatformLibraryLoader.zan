using System;

namespace System.Platform;

// 跨平台动态链接库加载与错误码映射核心契约接口（PAL Library）。
// 规范：平台实现必须在底层封装 Win32 / POSIX 系统调用，
// 统一向外提供强类型、无平台条件编译的动态链接库加载、符号解析、库卸载与原生系统错误码存取。
public interface IPlatformLibraryLoader {
    // 按名称或绝对路径加载动态链接库；失败时返回 0。
    nint LoadLibrary(string name);

    // 从已加载的库句柄解析导出符号地址；不存在或失败时返回 0。
    nint GetSymbol(nint handle, string name);

    // 卸载已加载的动态链接库句柄；句柄为 0 时返回 true。
    bool FreeLibrary(nint handle);

    // 获取上一次加载或符号解析失败的描述文本（dlerror 或 "win32 error " + code）。
    string GetLastError();

    // 获取当前线程最近一次原生系统错误码（Win32 GetLastError 或 POSIX errno）。
    int GetLastSystemError();

    // 设置当前线程原生系统错误码（Win32 SetLastError 或 POSIX errno）。
    void SetLastSystemError(int error);

    // 将跨平台共享库名规范化为平台本地文件名（例如 "sqlite3" -> "sqlite3.dll" / "libsqlite3.so" / "libsqlite3.dylib"）。
    string MapLibraryName(string name);
}
