using System;
using System.Interop;

namespace System.Platform;

#if !WINDOWS
// POSIX (Linux / macOS / WASI) 平台原生 UTF-32 (4 字节 wchar_t) 文本封送实现。
public class PosixTextMarshaler : IPlatformTextMarshaler {
    public int CharSize() {
        return 4;
    }

    public nint StringToWide(string s) {
        if (s == null) { return 0; }
        int len = s.Length;
        int count = 0;
        int i = 0;
        while (i < len) {
            int b0 = s[i] & 255;
            if (b0 < 128) {
                count = count + 1;
                i = i + 1;
            } else if ((b0 & 224) == 192 && i + 1 < len && ((s[i + 1] & 192) == 128)) {
                count = count + 1;
                i = i + 2;
            } else if ((b0 & 240) == 224 && i + 2 < len && ((s[i + 1] & 192) == 128) && ((s[i + 2] & 192) == 128)) {
                count = count + 1;
                i = i + 3;
            } else if ((b0 & 248) == 240 && i + 3 < len && ((s[i + 1] & 192) == 128) && ((s[i + 2] & 192) == 128) && ((s[i + 3] & 192) == 128)) {
                count = count + 1;
                i = i + 4;
            } else {
                count = count + 1;
                i = i + 1;
            }
        }

        long bytesL = ((long)count + 1L) * 4L;
        if (bytesL <= 0L || bytesL > 2147483591L) { return 0; }
        nint dst = NativeMemory.Alloc((int)bytesL);
        if (dst == 0) { return 0; }
        Span<int> sp = new Span<int>(dst, count + 1);
        int idx = 0;
        i = 0;
        while (i < len) {
            int b0 = s[i] & 255;
            if (b0 < 128) {
                sp[idx] = b0;
                idx = idx + 1;
                i = i + 1;
            } else if ((b0 & 224) == 192 && i + 1 < len && ((s[i + 1] & 192) == 128)) {
                int cp = ((b0 & 31) * 64) | (s[i + 1] & 63);
                sp[idx] = cp >= 128 ? cp : 65533;
                idx = idx + 1;
                i = i + 2;
            } else if ((b0 & 240) == 224 && i + 2 < len && ((s[i + 1] & 192) == 128) && ((s[i + 2] & 192) == 128)) {
                int cp = ((b0 & 15) * 4096) | ((s[i + 1] & 63) * 64) | (s[i + 2] & 63);
                sp[idx] = (cp >= 2048 && !(cp >= 55296 && cp <= 57343)) ? cp : 65533;
                idx = idx + 1;
                i = i + 3;
            } else if ((b0 & 248) == 240 && i + 3 < len && ((s[i + 1] & 192) == 128) && ((s[i + 2] & 192) == 128) && ((s[i + 3] & 192) == 128)) {
                int cp = ((b0 & 7) * 262144) | ((s[i + 1] & 63) * 4096) | ((s[i + 2] & 63) * 64) | (s[i + 3] & 63);
                sp[idx] = (cp >= 65536 && cp <= 1114111) ? cp : 65533;
                idx = idx + 1;
                i = i + 4;
            } else {
                sp[idx] = 65533; // 0xFFFD replacement character
                idx = idx + 1;
                i = i + 1;
            }
        }
        sp[count] = 0;
        return dst;
    }

    public string WideToString(nint p) {
        if (p == 0) { return ""; }
        int count = this.WideLength(p);
        if (count <= 0) { return ""; }
        Span<int> sp = new Span<int>(p, count);

        long byteCountL = 0L;
        for (int k = 0; k < count; k = k + 1) {
            int cp = sp[k];
            if (cp < 0 || cp > 1114111 || (cp >= 55296 && cp <= 57343)) {
                cp = 65533;
            }
            if (cp <= 127) {
                byteCountL = byteCountL + 1L;
            } else if (cp <= 2047) {
                byteCountL = byteCountL + 2L;
            } else if (cp <= 65535) {
                byteCountL = byteCountL + 3L;
            } else {
                byteCountL = byteCountL + 4L;
            }
        }
        if (byteCountL <= 0L || byteCountL > 2147483591L) { return ""; }
        int byteCount = (int)byteCountL;

        byte[] buf = new byte[byteCount];
        int outIdx = 0;
        for (int k = 0; k < count; k = k + 1) {
            int cp = sp[k];
            if (cp < 0 || cp > 1114111 || (cp >= 55296 && cp <= 57343)) {
                cp = 65533;
            }
            if (cp <= 127) {
                buf[outIdx] = (byte)cp;
                outIdx = outIdx + 1;
            } else if (cp <= 2047) {
                buf[outIdx] = (byte)(192 | (cp / 64));
                buf[outIdx + 1] = (byte)(128 | (cp & 63));
                outIdx = outIdx + 2;
            } else if (cp <= 65535) {
                buf[outIdx] = (byte)(224 | (cp / 4096));
                buf[outIdx + 1] = (byte)(128 | ((cp / 64) & 63));
                buf[outIdx + 2] = (byte)(128 | (cp & 63));
                outIdx = outIdx + 3;
            } else {
                buf[outIdx] = (byte)(240 | (cp / 262144));
                buf[outIdx + 1] = (byte)(128 | ((cp / 4096) & 63));
                buf[outIdx + 2] = (byte)(128 | ((cp / 64) & 63));
                buf[outIdx + 3] = (byte)(128 | (cp & 63));
                outIdx = outIdx + 4;
            }
        }
        return buf.ToStr(0, byteCount);
    }

    public int WideLength(nint p) {
        if (p == 0) { return 0; }
        int n = 0;
        while (n < 536870911 && new Span<int>(p + (nint)((long)n * 4L), 1)[0] != 0) {
            n = n + 1;
        }
        return n;
    }

    public void Free(nint p) {
        if (p != 0) {
            NativeMemory.Free(p);
        }
    }
}
#endif
