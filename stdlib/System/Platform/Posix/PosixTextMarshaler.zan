using System;
using System.Interop;

namespace System.Platform;

#if !WINDOWS
// POSIX (Linux / macOS / WASI) 平台原生 UTF-32 (4 字节 wchar_t) 文本封送实现。
public class PosixTextMarshaler : IPlatformTextMarshaler {
    public int CharSize() {
        return 4;
    }

    public nint StringToWide(string s) {
        if (s == null) { return 0; }
        int len = s.Length;
        int count = 0;
        int i = 0;
        while (i < len) {
            int b0 = s[i] & 255;
            if (b0 < 128) {
                count = count + 1;
                i = i + 1;
            } else if ((b0 & 224) == 192) {
                count = count + 1;
                i = i + 2;
            } else if ((b0 & 240) == 224) {
                count = count + 1;
                i = i + 3;
            } else if ((b0 & 248) == 240) {
                count = count + 1;
                i = i + 4;
            } else {
                count = count + 1;
                i = i + 1;
            }
        }

        nint dst = NativeMemory.Alloc((count + 1) * 4);
        Span<int> sp = new Span<int>(dst, count + 1);
        int idx = 0;
        i = 0;
        while (i < len) {
            int b0 = s[i] & 255;
            if (b0 < 128) {
                sp[idx] = b0;
                idx = idx + 1;
                i = i + 1;
            } else if ((b0 & 224) == 192) {
                int b1 = (i + 1 < len) ? (s[i + 1] & 63) : 0;
                sp[idx] = ((b0 & 31) * 64) | b1;
                idx = idx + 1;
                i = i + 2;
            } else if ((b0 & 240) == 224) {
                int b1 = (i + 1 < len) ? (s[i + 1] & 63) : 0;
                int b2 = (i + 2 < len) ? (s[i + 2] & 63) : 0;
                sp[idx] = ((b0 & 15) * 4096) | (b1 * 64) | b2;
                idx = idx + 1;
                i = i + 3;
            } else if ((b0 & 248) == 240) {
                int b1 = (i + 1 < len) ? (s[i + 1] & 63) : 0;
                int b2 = (i + 2 < len) ? (s[i + 2] & 63) : 0;
                int b3 = (i + 3 < len) ? (s[i + 3] & 63) : 0;
                sp[idx] = ((b0 & 7) * 262144) | (b1 * 4096) | (b2 * 64) | b3;
                idx = idx + 1;
                i = i + 4;
            } else {
                sp[idx] = 65533; // 0xFFFD replacement character
                idx = idx + 1;
                i = i + 1;
            }
        }
        sp[count] = 0;
        return dst;
    }

    public string WideToString(nint p) {
        if (p == 0) { return ""; }
        int count = this.WideLength(p);
        if (count <= 0) { return ""; }
        Span<int> sp = new Span<int>(p, count);

        int byteCount = 0;
        for (int k = 0; k < count; k = k + 1) {
            int cp = sp[k];
            if (cp <= 127) {
                byteCount = byteCount + 1;
            } else if (cp <= 2047) {
                byteCount = byteCount + 2;
            } else if (cp <= 65535) {
                byteCount = byteCount + 3;
            } else {
                byteCount = byteCount + 4;
            }
        }

        byte[] buf = new byte[byteCount];
        int outIdx = 0;
        for (int k = 0; k < count; k = k + 1) {
            int cp = sp[k];
            if (cp <= 127) {
                buf[outIdx] = (byte)cp;
                outIdx = outIdx + 1;
            } else if (cp <= 2047) {
                buf[outIdx] = (byte)(192 | (cp / 64));
                buf[outIdx + 1] = (byte)(128 | (cp & 63));
                outIdx = outIdx + 2;
            } else if (cp <= 65535) {
                buf[outIdx] = (byte)(224 | (cp / 4096));
                buf[outIdx + 1] = (byte)(128 | ((cp / 64) & 63));
                buf[outIdx + 2] = (byte)(128 | (cp & 63));
                outIdx = outIdx + 3;
            } else {
                buf[outIdx] = (byte)(240 | (cp / 262144));
                buf[outIdx + 1] = (byte)(128 | ((cp / 4096) & 63));
                buf[outIdx + 2] = (byte)(128 | ((cp / 64) & 63));
                buf[outIdx + 3] = (byte)(128 | (cp & 63));
                outIdx = outIdx + 4;
            }
        }
        return buf.ToStr(0, byteCount);
    }

    public int WideLength(nint p) {
        if (p == 0) { return 0; }
        int n = 0;
        while (new Span<int>(p + n * 4, 1)[0] != 0) {
            n = n + 1;
        }
        return n;
    }

    public void Free(nint p) {
        if (p != 0) {
            NativeMemory.Free(p);
        }
    }
}
#endif
