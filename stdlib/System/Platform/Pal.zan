using System;

namespace System.Platform;

// 平台抽象层（PAL）单例工厂与装配入口。
// 全仓统一在此处按编译目标进行平台实现类装配，收敛 #if WINDOWS。
public class Pal {
    #if WINDOWS
    static IPlatformFileSystem fileSystem = new WindowsFileSystem();
    static IPlatformTextMarshaler textMarshaler = new WindowsTextMarshaler();
    static IPlatformEnvironment environment = new WindowsEnvironment();
    static IPlatformLibraryLoader libraryLoader = new WindowsLibraryLoader();
    static IPlatformNetwork network = new WindowsNetwork();
    static IPlatformThreading threading = new WindowsThreading();
    #else
    static IPlatformFileSystem fileSystem = new PosixFileSystem();
    static IPlatformTextMarshaler textMarshaler = new PosixTextMarshaler();
    static IPlatformEnvironment environment = new PosixEnvironment();
    static IPlatformLibraryLoader libraryLoader = new PosixLibraryLoader();
    static IPlatformNetwork network = new PosixNetwork();
    static IPlatformThreading threading = new PosixThreading();
    #endif

    // 平台文件与路径系统后端
    public static IPlatformFileSystem FileSystem {
        get {
            return Pal.fileSystem;
        }
    }

    // 平台原生宽字符与文本封送后端
    public static IPlatformTextMarshaler Text {
        get {
            return Pal.textMarshaler;
        }
    }

    // 平台进程环境与系统信息后端
    public static IPlatformEnvironment Environment {
        get {
            return Pal.environment;
        }
    }

    // 平台动态链接库加载与错误码映射后端
    public static IPlatformLibraryLoader Library {
        get {
            return Pal.libraryLoader;
        }
    }

    // 平台网络套接字系统调用与选项后端
    public static IPlatformNetwork Network {
        get {
            return Pal.network;
        }
    }

    // 平台线程休眠与底层同步原语后端
    public static IPlatformThreading Threading {
        get {
            return Pal.threading;
        }
    }

    // 跨平台线程休眠静态直通（零堆分配、零 ARC retain，保障后台分离线程随时退出零泄漏）
    public static void Sleep(int milliseconds) {
        #if WINDOWS
        WindowsThreading.SleepDirect(milliseconds);
        #else
        PosixThreading.SleepDirect(milliseconds);
        #endif
    }
}
