using System;

namespace System.Platform;

// 平台抽象层（PAL）单例工厂与装配入口。
// 全仓统一在此处按编译目标进行平台实现类装配，收敛 #if WINDOWS。
public class Pal {
    static IPlatformFileSystem fileSystem;
    static IPlatformTextMarshaler textMarshaler;
    static IPlatformEnvironment environment;
    static IPlatformLibraryLoader libraryLoader;
    static IPlatformNetwork network;

    // 平台文件与路径系统后端
    public static IPlatformFileSystem FileSystem {
        get {
            if (Pal.fileSystem == null) {
                Pal.Select();
            }
            return Pal.fileSystem;
        }
    }

    // 平台原生宽字符与文本封送后端
    public static IPlatformTextMarshaler Text {
        get {
            if (Pal.textMarshaler == null) {
                Pal.Select();
            }
            return Pal.textMarshaler;
        }
    }

    // 平台进程环境与系统信息后端
    public static IPlatformEnvironment Environment {
        get {
            if (Pal.environment == null) {
                Pal.Select();
            }
            return Pal.environment;
        }
    }

    // 平台动态链接库加载与错误码映射后端
    public static IPlatformLibraryLoader Library {
        get {
            if (Pal.libraryLoader == null) {
                Pal.Select();
            }
            return Pal.libraryLoader;
        }
    }

    // 平台网络套接字系统调用与选项后端
    public static IPlatformNetwork Network {
        get {
            if (Pal.network == null) {
                Pal.Select();
            }
            return Pal.network;
        }
    }

    static void Select() {
        #if WINDOWS
        Pal.fileSystem = new WindowsFileSystem();
        Pal.textMarshaler = new WindowsTextMarshaler();
        Pal.environment = new WindowsEnvironment();
        Pal.libraryLoader = new WindowsLibraryLoader();
        Pal.network = new WindowsNetwork();
        #else
        Pal.fileSystem = new PosixFileSystem();
        Pal.textMarshaler = new PosixTextMarshaler();
        Pal.environment = new PosixEnvironment();
        Pal.libraryLoader = new PosixLibraryLoader();
        Pal.network = new PosixNetwork();
        #endif
    }
}
