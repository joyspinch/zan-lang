using System;
using System.Buffers.Binary;
using System.Text;

namespace System;

// 基础数据类型与字节数组/Span 相互转换的标准实用工具类。
public class BitConverter {
    // 目标平台架构是否为小端序（x86-64 / ARM64 均为小端）。
    public static bool IsLittleEndian = true;

    // ---- 浮点/整数位型直接互转 ----

    public static long DoubleToInt64Bits(double value) {
        return NativeMemory.AsI64(value);
    }

    public static double Int64BitsToDouble(long value) {
        return NativeMemory.AsF64(value);
    }

    public static int SingleToInt32Bits(float value) {
        return NativeMemory.AsI32(value);
    }

    public static float Int32BitsToSingle(int value) {
        return NativeMemory.AsF32(value);
    }

    // ---- 标量转字节数组 (GetBytes) ----

    public static byte[] GetBytes(bool value) {
        byte[] r = new byte[1];
        r[0] = value ? (byte)1 : (byte)0;
        return r;
    }

    public static byte[] GetBytes(short value) {
        byte[] r = new byte[2];
        BinaryPrimitives.WriteInt16LittleEndian(r.AsSpan(), value);
        return r;
    }

    public static byte[] GetBytes(ushort value) {
        byte[] r = new byte[2];
        BinaryPrimitives.WriteUInt16LittleEndian(r.AsSpan(), value);
        return r;
    }

    public static byte[] GetBytes(int value) {
        byte[] r = new byte[4];
        BinaryPrimitives.WriteInt32LittleEndian(r.AsSpan(), value);
        return r;
    }

    public static byte[] GetBytes(uint value) {
        byte[] r = new byte[4];
        BinaryPrimitives.WriteUInt32LittleEndian(r.AsSpan(), value);
        return r;
    }

    public static byte[] GetBytes(long value) {
        byte[] r = new byte[8];
        BinaryPrimitives.WriteInt64LittleEndian(r.AsSpan(), value);
        return r;
    }

    public static byte[] GetBytes(ulong value) {
        byte[] r = new byte[8];
        BinaryPrimitives.WriteUInt64LittleEndian(r.AsSpan(), value);
        return r;
    }

    public static byte[] GetBytes(float value) {
        byte[] r = new byte[4];
        BinaryPrimitives.WriteSingleLittleEndian(r.AsSpan(), value);
        return r;
    }

    public static byte[] GetBytes(double value) {
        byte[] r = new byte[8];
        BinaryPrimitives.WriteDoubleLittleEndian(r.AsSpan(), value);
        return r;
    }

    // ---- Span 零分配写入 (TryWriteBytes) ----

    public static bool TryWriteBytes(Span<byte> destination, bool value) {
        if (destination.Length < 1) { return false; }
        destination[0] = value ? (byte)1 : (byte)0;
        return true;
    }

    public static bool TryWriteBytes(Span<byte> destination, short value) {
        return BinaryPrimitives.TryWriteInt16LittleEndian(destination, value);
    }

    public static bool TryWriteBytes(Span<byte> destination, int value) {
        return BinaryPrimitives.TryWriteInt32LittleEndian(destination, value);
    }

    public static bool TryWriteBytes(Span<byte> destination, long value) {
        return BinaryPrimitives.TryWriteInt64LittleEndian(destination, value);
    }

    public static bool TryWriteBytes(Span<byte> destination, float value) {
        if (destination.Length < 4) { return false; }
        BinaryPrimitives.WriteSingleLittleEndian(destination, value);
        return true;
    }

    public static bool TryWriteBytes(Span<byte> destination, double value) {
        if (destination.Length < 8) { return false; }
        BinaryPrimitives.WriteDoubleLittleEndian(destination, value);
        return true;
    }

    // ---- byte[] 转标量 (带 startIndex) ----

    public static bool ToBoolean(byte[] value, int startIndex) {
        if (value == null) { throw new ArgumentNullException("value"); }
        if (startIndex < 0 || startIndex >= value.Length) { throw new ArgumentOutOfRangeException("startIndex"); }
        return value[startIndex] != 0;
    }

    public static short ToInt16(byte[] value, int startIndex) {
        if (value == null) { throw new ArgumentNullException("value"); }
        return BinaryPrimitives.ReadInt16LittleEndian(value.AsSpan(startIndex, value.Length - startIndex));
    }

    public static ushort ToUInt16(byte[] value, int startIndex) {
        if (value == null) { throw new ArgumentNullException("value"); }
        return BinaryPrimitives.ReadUInt16LittleEndian(value.AsSpan(startIndex, value.Length - startIndex));
    }

    public static int ToInt32(byte[] value, int startIndex) {
        if (value == null) { throw new ArgumentNullException("value"); }
        return BinaryPrimitives.ReadInt32LittleEndian(value.AsSpan(startIndex, value.Length - startIndex));
    }

    public static uint ToUInt32(byte[] value, int startIndex) {
        if (value == null) { throw new ArgumentNullException("value"); }
        return BinaryPrimitives.ReadUInt32LittleEndian(value.AsSpan(startIndex, value.Length - startIndex));
    }

    public static long ToInt64(byte[] value, int startIndex) {
        if (value == null) { throw new ArgumentNullException("value"); }
        return BinaryPrimitives.ReadInt64LittleEndian(value.AsSpan(startIndex, value.Length - startIndex));
    }

    public static ulong ToUInt64(byte[] value, int startIndex) {
        if (value == null) { throw new ArgumentNullException("value"); }
        return BinaryPrimitives.ReadUInt64LittleEndian(value.AsSpan(startIndex, value.Length - startIndex));
    }

    public static float ToSingle(byte[] value, int startIndex) {
        if (value == null) { throw new ArgumentNullException("value"); }
        return BinaryPrimitives.ReadSingleLittleEndian(value.AsSpan(startIndex, value.Length - startIndex));
    }

    public static double ToDouble(byte[] value, int startIndex) {
        if (value == null) { throw new ArgumentNullException("value"); }
        return BinaryPrimitives.ReadDoubleLittleEndian(value.AsSpan(startIndex, value.Length - startIndex));
    }

    // ---- ReadOnlySpan<byte> 零分配转标量 ----

    public static bool ToBoolean(ReadOnlySpan<byte> value) {
        if (value.Length < 1) { throw new ArgumentOutOfRangeException("value"); }
        return value[0] != 0;
    }

    public static short ToInt16(ReadOnlySpan<byte> value) {
        return BinaryPrimitives.ReadInt16LittleEndian(value);
    }

    public static ushort ToUInt16(ReadOnlySpan<byte> value) {
        return BinaryPrimitives.ReadUInt16LittleEndian(value);
    }

    public static int ToInt32(ReadOnlySpan<byte> value) {
        return BinaryPrimitives.ReadInt32LittleEndian(value);
    }

    public static uint ToUInt32(ReadOnlySpan<byte> value) {
        return BinaryPrimitives.ReadUInt32LittleEndian(value);
    }

    public static long ToInt64(ReadOnlySpan<byte> value) {
        return BinaryPrimitives.ReadInt64LittleEndian(value);
    }

    public static ulong ToUInt64(ReadOnlySpan<byte> value) {
        return BinaryPrimitives.ReadUInt64LittleEndian(value);
    }

    public static float ToSingle(ReadOnlySpan<byte> value) {
        return BinaryPrimitives.ReadSingleLittleEndian(value);
    }

    public static double ToDouble(ReadOnlySpan<byte> value) {
        return BinaryPrimitives.ReadDoubleLittleEndian(value);
    }

    // ---- 字节数组格式化为十六进制文本 (ToString) ----

    public static string ToString(byte[] value) {
        if (value == null) { throw new ArgumentNullException("value"); }
        return ToString(value, 0, value.Length);
    }

    public static string ToString(byte[] value, int startIndex) {
        if (value == null) { throw new ArgumentNullException("value"); }
        return ToString(value, startIndex, value.Length - startIndex);
    }

    public static string ToString(byte[] value, int startIndex, int length) {
        if (value == null) { throw new ArgumentNullException("value"); }
        if (startIndex < 0 || length < 0 || startIndex + length > value.Length) {
            throw new ArgumentOutOfRangeException("length");
        }
        if (length == 0) { return ""; }

        StringBuilder sb = new StringBuilder(length * 3);
        string hexChars = "0123456789ABCDEF";
        for (int i = 0; i < length; i = i + 1) {
            if (i > 0) { sb.Append("-"); }
            int b = value[startIndex + i] & 255;
            sb.Append(hexChars.Substring((b >> 4) & 15, 1));
            sb.Append(hexChars.Substring(b & 15, 1));
        }
        return sb.ToString();
    }
}
