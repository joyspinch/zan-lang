using System;

namespace System.Threading;

/// <summary>
/// 操作系统线程之间的交接队列——相当于 C# 的
/// <c>BlockingCollection</c> / <c>Channel</c>。
///
/// <code>
/// BlockingQueue&lt;string&gt; q = new BlockingQueue&lt;string&gt;(null, 0);
/// Thread.Start(() =&gt; { q.Enqueue("row"); q.Complete(); });
/// string row = q.Dequeue();          // 阻塞直到有数据或队列结束
/// while (row != null) { ...; row = q.Dequeue(); }
/// </code>
///
/// <see cref="Channel"/> 是协程原语：用于在任务之间传递值，
/// 这些任务由单一线程的调度器驱动；跨真实线程时会自旋（或错过唤醒）
/// 。本队列是跨线程版本：条目列表
/// 受互斥锁保护，消费方无数据可取时挂起在操作系统
/// 信号量上，直到生产方投递。队列完成并取空后，`Dequeue` 返回 null，
/// 消费循环自行结束——`empty` 就是
/// 队列当时交回的哨兵值，在 Create 时提供，因为
/// 泛型值类型没有 null。
///
/// 失败的生产方可以用
/// <see cref="CompleteWithFault"/> 代替普通的 <see cref="Complete"/>：
/// 消费者先取走剩余数据，然后通过
/// <see cref="GetFault"/> 看到错误信息而不是干净的 EOF。<see cref="Cancel"/> 是
/// 中止路径：丢弃所有仍排队的条目，唤醒所有挂起的
/// 消费者和生产方，并标记队列，使 <see cref="IsCanceled"/>
/// 返回 true。
/// </summary>
class BlockingQueue<T> {
    List<T> items;
    /// 下一个待取出条目的索引；列表惰性压缩，避免
    /// 长生命周期队列每次取出都搬移所有元素。
    int head;
    /// 由 Complete 设置：不再会有条目到达，挂起的消费者
    /// 以 null 被唤醒，而不是永远等待。
    bool closed;
    int waiters;
    /// 队列在让生产方等待前可容纳的条目数；0 表示
    /// 无上限。
    int capacity;
    /// 因队列已满而挂起在 `slots` 上的生产方。
    int posters;
    /// 在无条目可取时由 take 交回给调用方。
    T empty;
    /// 来自 CompleteWithFault 的失败信息；"" 表示无故障。
    string fault;
    /// 由 Cancel 设置：队列被中止，待处理条目已丢弃。
    bool canceled;

    #if WINDOWS
    nint lockHandle;
    nint sem;
    nint slots;
    #else
    nint lockHandle;
    string sem;
    string slots;
    #endif

    /// <summary>无界队列，哨兵值为默认值（引用类型为 null）。
    /// 和双参构造器一样建立项列表与互斥锁/信号量：否则
    /// 任何 Enqueue/Dequeue 都会在空句柄上段错。</summary>
    BlockingQueue() {
        this.head = 0;
        this.closed = false;
        this.waiters = 0;
        this.capacity = 0;
        this.posters = 0;
        this.fault = "";
        this.canceled = false;
        this.items = new List<T>();
        this.lockHandle = Mutex.Create();
        this.sem = Semaphore.Create(0, 1048576);
        this.slots = Semaphore.Create(0, 1048576);
    }

    /// <summary>最多容纳 `capacity` 个条目的队列：一旦满，
    /// 生产方在 Enqueue 中挂起，直到消费者取走一个，因此快的
    /// 生产方不会超过消费方，队列不会无限增长。
    /// 容量 0 表示无上限。`empty` 是队列完成并取空后
    /// 由 Dequeue 交回的哨兵值。</summary>
    BlockingQueue(T empty, int capacity) {
        this.head = 0;
        this.closed = false;
        this.waiters = 0;
        this.capacity = 0;
        this.posters = 0;
        this.fault = "";
        this.canceled = false;
        this.items = new List<T>();
        this.empty = empty;
        if (capacity < 0) { capacity = 0; }
        this.capacity = capacity;
        this.lockHandle = Mutex.Create();
        this.sem = Semaphore.Create(0, 1048576);
        this.slots = Semaphore.Create(0, 1048576);
    }

    /// <summary>投递一个条目并唤醒挂起的消费者；有界队列满时
    /// 挂起调用方。队列结束后返回 false。</summary>
    bool Enqueue(T item) {
        while (true) {
            Mutex.Lock(this.lockHandle);
            if (this.closed) {
                Mutex.Unlock(this.lockHandle);
                return false;
            }
            if (this.capacity > 0
                && this.items.Count - this.head >= this.capacity) {
                this.posters = this.posters + 1;
                Mutex.Unlock(this.lockHandle);
                Semaphore.Wait(this.slots);
                // 被 take 或 Complete 唤醒：在锁内重新检查。
                continue;
            }
            this.items.Add(item);
            bool wake = this.waiters > 0;
            if (wake) { this.waiters = this.waiters - 1; }
            Mutex.Unlock(this.lockHandle);
            if (wake) { Semaphore.Release(this.sem); }
            return true;
        }
    }

    /// <summary>取出下一个条目；若队列当前
    /// 没有数据，则返回 `empty` 哨兵。</summary>
    T TryDequeue() {
        Mutex.Lock(this.lockHandle);
        T v = this.TakeLocked();
        bool room = this.posters > 0;
        if (room) { this.posters = this.posters - 1; }
        Mutex.Unlock(this.lockHandle);
        if (room) { Semaphore.Release(this.slots); }
        return v;
    }

    /// <summary>取出下一个条目，最多等待 `timeoutMs` 毫秒。
    /// 等待超时或队列
    /// 完成并取空时也返回 `empty` 哨兵；<see cref="IsCompleted"/> 可区分二者
    /// 。负超时表示无限等待。</summary>
    T DequeueFor(int timeoutMs) {
        while (true) {
            Mutex.Lock(this.lockHandle);
            if (this.head < this.items.Count) {
                T v = this.TakeLocked();
                bool room = this.posters > 0;
                if (room) { this.posters = this.posters - 1; }
                Mutex.Unlock(this.lockHandle);
                if (room) { Semaphore.Release(this.slots); }
                return v;
            }
            if (this.closed) {
                Mutex.Unlock(this.lockHandle);
                return this.empty;
            }
            this.waiters = this.waiters + 1;
            Mutex.Unlock(this.lockHandle);
            if (Semaphore.WaitFor(this.sem, timeoutMs)) { continue; }
            // 已超时：撤回注册，除非生产方
            // 已将其与一次投递配对；这种情况下再循环一次
            // 把条目取走。
            Mutex.Lock(this.lockHandle);
            bool parked = this.waiters > 0;
            if (parked) { this.waiters = this.waiters - 1; }
            Mutex.Unlock(this.lockHandle);
            if (parked) { return this.empty; }
            Semaphore.Wait(this.sem);
        }
    }

    /// <summary>取出下一个条目，挂起调用线程直到有数据
    /// 投递。队列完成并取空后返回 `empty` 哨兵
    /// 。</summary>
    T Dequeue() {
        while (true) {
            Mutex.Lock(this.lockHandle);
            if (this.head < this.items.Count) {
                T v = this.TakeLocked();
                bool room = this.posters > 0;
                if (room) { this.posters = this.posters - 1; }
                Mutex.Unlock(this.lockHandle);
                if (room) { Semaphore.Release(this.slots); }
                return v;
            }
            if (this.closed) {
                Mutex.Unlock(this.lockHandle);
                return this.empty;
            }
            this.waiters = this.waiters + 1;
            Mutex.Unlock(this.lockHandle);
            Semaphore.Wait(this.sem);
            // 为条目或完成而唤醒：在锁下循环重新读取，
            // 这也使得虚假唤醒无害。
        }
    }

    /// <summary>结束队列：不再接受新条目，所有
    /// 挂起的消费者都会被唤醒。</summary>
    void Complete() {
        this.CompleteWithFault("");
    }

    /// <summary>以失败结束队列。消费者先取走剩余条目，
    /// 然后通过 <see cref="GetFault"/> 获取错误信息，而非干净的
    /// EOF；此后 Enqueue 拒绝新条目。</summary>
    void CompleteWithFault(string message) {
        Mutex.Lock(this.lockHandle);
        this.closed = true;
        this.fault = message;
        int wake = this.waiters;
        this.waiters = 0;
        int free = this.posters;
        this.posters = 0;
        Mutex.Unlock(this.lockHandle);
        for (int i = 0; i < wake; i = i + 1) {
            Semaphore.Release(this.sem);
        }
        // 因队列满而挂起的生产方必须回来检查 `closed`，
        // 而不是等待永远不会被取走的空位。
        for (int j = 0; j < free; j = j + 1) {
            Semaphore.Release(this.slots);
        }
    }

    /// <summary>中止队列：丢弃所有仍在等待的条目，唤醒所有
    /// 挂起的消费者和生产方，并将队列标记为已取消，使
    /// <see cref="IsCanceled"/> 返回 true。消费者看到的是空哨兵
    /// （队列已关闭并取空）；Enqueue 返回 false。</summary>
    void Cancel() {
        Mutex.Lock(this.lockHandle);
        this.canceled = true;
        this.closed = true;
        this.fault = "";
        this.head = this.items.Count;   // 丢弃所有排队条目
        int wake = this.waiters;
        this.waiters = 0;
        int free = this.posters;
        this.posters = 0;
        Mutex.Unlock(this.lockHandle);
        for (int i = 0; i < wake; i = i + 1) {
            Semaphore.Release(this.sem);
        }
        for (int j = 0; j < free; j = j + 1) {
            Semaphore.Release(this.slots);
        }
    }

    /// <summary>在 <see cref="Cancel"/> 之后为 true：队列是被中止
    /// 而非正常完成。</summary>
    bool IsCanceled() {
        Mutex.Lock(this.lockHandle);
        bool v = this.canceled;
        Mutex.Unlock(this.lockHandle);
        return v;
    }

    /// <summary>来自 <see cref="CompleteWithFault"/> 的失败信息，或
    /// 队列正常结束或被取消时为 ""。</summary>
    string GetFault() {
        Mutex.Lock(this.lockHandle);
        string v = this.fault;
        Mutex.Unlock(this.lockHandle);
        return v;
    }

    /// <summary>队列已结束（Complete/Cancel）且条目已取空。</summary>
    bool IsCompleted() {
        Mutex.Lock(this.lockHandle);
        bool v = this.closed && this.head >= this.items.Count;
        Mutex.Unlock(this.lockHandle);
        return v;
    }

    /// <summary>等待被取出的条目数。</summary>
    int Count() {
        Mutex.Lock(this.lockHandle);
        int v = this.items.Count - this.head;
        Mutex.Unlock(this.lockHandle);
        return v;
    }

    /// <summary>销毁队列底层的信号量与锁，释放系统资源。</summary>
    void Dispose() {
        Semaphore.Destroy(this.sem);
        Semaphore.Destroy(this.slots);
        Mutex.Destroy(this.lockHandle);
    }

    /// 弹出一个条目；调用方持有锁。当已消费前缀
    /// 超过一半时压缩，保证两端均摊 O(1)。
    T TakeLocked() {
        if (this.head >= this.items.Count) { return this.empty; }
        T v = this.items[this.head];
        this.head = this.head + 1;
        if (this.head > 64 && this.head * 2 >= this.items.Count) {
            List<T> rest = new List<T>();
            int i = this.head;
            while (i < this.items.Count) {
                rest.Add(this.items[i]);
                i = i + 1;
            }
            this.items = rest;
            this.head = 0;
        }
        return v;
    }
}
