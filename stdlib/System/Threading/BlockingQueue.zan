using System;

namespace System.Threading;

// 跨 OS 线程有界/无界交接队列（capacity <= 0 为无界；empty 为空哨兵）。
public class BlockingQueue<T> : IDisposable {
    public List<T> items;
    public int head;
    public bool closed;
    public int waiters;
    public int capacity;
    public int posters;
    public T empty;
    public string fault;
    public bool canceled;

    public nint lockHandle;
    public nint sem;
    public nint slots;

    public BlockingQueue() {
        this.Init(0);
    }

    public BlockingQueue(T empty, int capacity) {
        this.empty = empty;
        this.Init(capacity);
    }

    private void Init(int capacity) {
        this.head = 0;
        this.closed = false;
        this.waiters = 0;
        this.posters = 0;
        this.fault = "";
        this.canceled = false;
        this.items = new List<T>();
        this.capacity = capacity > 0 ? capacity : 0;
        this.lockHandle = Mutex.Create();
        this.sem = Semaphore.Create(0, 1048576);
        this.slots = this.capacity > 0 ? Semaphore.Create(0, 1048576) : 0;
    }

    private static void ReleaseWaiters(nint semHandle, int count) {
        if (semHandle == 0) { return; }
        for (int i = 0; i < count; i = i + 1) {
            Semaphore.Release(semHandle);
        }
    }

    private T TakeAndCheckPosterLocked(out bool room) {
        T v = this.TakeLocked();
        room = this.posters > 0;
        if (room) { this.posters = this.posters - 1; }
        return v;
    }

    private void PushAndCheckWaiterLocked(T item, out bool wake) {
        this.items.Add(item);
        wake = this.waiters > 0;
        if (wake) { this.waiters = this.waiters - 1; }
    }

    public bool Enqueue(T item) {
        while (true) {
            nint lk = this.lockHandle;
            if (lk == 0) { return false; }
            Mutex.Lock(lk);
            if (this.closed) {
                Mutex.Unlock(lk);
                return false;
            }
            if (this.capacity > 0 && this.items.Count - this.head >= this.capacity) {
                this.posters = this.posters + 1;
                nint sl = this.slots;
                Mutex.Unlock(lk);
                if (sl == 0) { return false; }
                Semaphore.Wait(sl);
                continue;
            }
            bool wake = false;
            this.PushAndCheckWaiterLocked(item, out wake);
            nint sm = this.sem;
            Mutex.Unlock(lk);
            if (wake && sm != 0) { Semaphore.Release(sm); }
            return true;
        }
    }

    // 超时或队列已结束返回 false；负超时无限等待。
    public bool EnqueueFor(T item, int timeoutMs) {
        long deadline = timeoutMs >= 0 ? DateTime.GetCurrentUnixMilliseconds() + (long)timeoutMs : -1L;
        while (true) {
            nint lk = this.lockHandle;
            if (lk == 0) { return false; }
            Mutex.Lock(lk);
            if (this.closed) {
                Mutex.Unlock(lk);
                return false;
            }
            if (this.capacity <= 0 || this.items.Count - this.head < this.capacity) {
                bool wake = false;
                this.PushAndCheckWaiterLocked(item, out wake);
                nint sm = this.sem;
                Mutex.Unlock(lk);
                if (wake && sm != 0) { Semaphore.Release(sm); }
                return true;
            }
            int waitMs = timeoutMs;
            if (deadline >= 0L) {
                long rem = deadline - DateTime.GetCurrentUnixMilliseconds();
                if (rem <= 0L) {
                    Mutex.Unlock(lk);
                    return false;
                }
                waitMs = rem > 2147483647L ? 2147483647 : (int)rem;
            }
            this.posters = this.posters + 1;
            nint sl = this.slots;
            Mutex.Unlock(lk);
            if (sl == 0) { return false; }
            if (Semaphore.WaitFor(sl, waitMs)) { continue; }
            lk = this.lockHandle;
            if (lk == 0) { return false; }
            Mutex.Lock(lk);
            bool parked = this.posters > 0;
            if (parked) { this.posters = this.posters - 1; }
            Mutex.Unlock(lk);
            if (parked) { return false; }
            // 消费者已配对释放空位，吃掉令牌再重试
            Semaphore.Wait(sl);
        }
    }

    public T TryDequeue() {
        nint lk = this.lockHandle;
        if (lk == 0) { return this.empty; }
        Mutex.Lock(lk);
        bool room = false;
        T v = this.TakeAndCheckPosterLocked(out room);
        nint sl = this.slots;
        Mutex.Unlock(lk);
        if (room && sl != 0) { Semaphore.Release(sl); }
        return v;
    }

    public T DequeueFor(int timeoutMs) {
        long deadline = timeoutMs >= 0 ? DateTime.GetCurrentUnixMilliseconds() + (long)timeoutMs : -1L;
        while (true) {
            nint lk = this.lockHandle;
            if (lk == 0) { return this.empty; }
            Mutex.Lock(lk);
            if (this.head < this.items.Count) {
                bool room = false;
                T v = this.TakeAndCheckPosterLocked(out room);
                nint sl = this.slots;
                Mutex.Unlock(lk);
                if (room && sl != 0) { Semaphore.Release(sl); }
                return v;
            }
            if (this.closed) {
                Mutex.Unlock(lk);
                return this.empty;
            }
            int waitMs = timeoutMs;
            if (deadline >= 0L) {
                long rem = deadline - DateTime.GetCurrentUnixMilliseconds();
                if (rem <= 0L) {
                    Mutex.Unlock(lk);
                    return this.empty;
                }
                waitMs = rem > 2147483647L ? 2147483647 : (int)rem;
            }
            this.waiters = this.waiters + 1;
            nint sm = this.sem;
            Mutex.Unlock(lk);
            if (sm == 0) { return this.empty; }
            if (Semaphore.WaitFor(sm, waitMs)) { continue; }
            lk = this.lockHandle;
            if (lk == 0) { return this.empty; }
            Mutex.Lock(lk);
            bool parked = this.waiters > 0;
            if (parked) { this.waiters = this.waiters - 1; }
            Mutex.Unlock(lk);
            if (parked) { return this.empty; }
            Semaphore.Wait(sm);
        }
    }

    public T Dequeue() {
        while (true) {
            nint lk = this.lockHandle;
            if (lk == 0) { return this.empty; }
            Mutex.Lock(lk);
            if (this.head < this.items.Count) {
                bool room = false;
                T v = this.TakeAndCheckPosterLocked(out room);
                nint sl = this.slots;
                Mutex.Unlock(lk);
                if (room && sl != 0) { Semaphore.Release(sl); }
                return v;
            }
            if (this.closed) {
                Mutex.Unlock(lk);
                return this.empty;
            }
            this.waiters = this.waiters + 1;
            nint sm = this.sem;
            Mutex.Unlock(lk);
            if (sm == 0) { return this.empty; }
            Semaphore.Wait(sm);
        }
    }

    public void Complete() {
        this.CompleteWithFault("");
    }

    public void CompleteWithFault(string message) {
        nint lk = this.lockHandle;
        if (lk == 0) { return; }
        Mutex.Lock(lk);
        this.closed = true;
        this.fault = message;
        int wake = this.waiters;
        this.waiters = 0;
        int free = this.posters;
        this.posters = 0;
        nint sm = this.sem;
        nint sl = this.slots;
        Mutex.Unlock(lk);
        BlockingQueue<T>.ReleaseWaiters(sm, wake);
        BlockingQueue<T>.ReleaseWaiters(sl, free);
    }

    public void Cancel() {
        nint lk = this.lockHandle;
        if (lk == 0) { return; }
        Mutex.Lock(lk);
        this.canceled = true;
        this.closed = true;
        this.fault = "";
        this.items.Clear();
        this.head = 0;
        int wake = this.waiters;
        this.waiters = 0;
        int free = this.posters;
        this.posters = 0;
        nint sm = this.sem;
        nint sl = this.slots;
        Mutex.Unlock(lk);
        BlockingQueue<T>.ReleaseWaiters(sm, wake);
        BlockingQueue<T>.ReleaseWaiters(sl, free);
    }

    public bool IsCanceled() {
        nint lk = this.lockHandle;
        if (lk == 0) { return this.canceled; }
        Mutex.Lock(lk);
        bool v = this.canceled;
        Mutex.Unlock(lk);
        return v;
    }

    public string GetFault() {
        nint lk = this.lockHandle;
        if (lk == 0) { return this.fault; }
        Mutex.Lock(lk);
        string v = this.fault;
        Mutex.Unlock(lk);
        return v;
    }

    public bool IsCompleted() {
        nint lk = this.lockHandle;
        if (lk == 0) { return true; }
        Mutex.Lock(lk);
        bool v = this.closed && this.head >= this.items.Count;
        Mutex.Unlock(lk);
        return v;
    }

    public int Count() {
        nint lk = this.lockHandle;
        if (lk == 0) { return 0; }
        Mutex.Lock(lk);
        int v = this.items.Count - this.head;
        Mutex.Unlock(lk);
        return v;
    }

    public void Dispose() {
        if (this.lockHandle != 0) {
            this.Cancel();
        }
        if (this.sem != 0) {
            nint sm = this.sem;
            this.sem = 0;
            Semaphore.Destroy(sm);
        }
        if (this.slots != 0) {
            nint sl = this.slots;
            this.slots = 0;
            Semaphore.Destroy(sl);
        }
        if (this.lockHandle != 0) {
            nint lk = this.lockHandle;
            this.lockHandle = 0;
            Mutex.Destroy(lk);
        }
    }

    public T TakeLocked() {
        int n = this.items.Count;
        if (this.head >= n) { return this.empty; }
        T v = this.items[this.head];
        this.head = this.head + 1;
        if (this.head >= n) {
            this.items.Clear();
            this.head = 0;
        } else if (this.head >= 64 && this.head >= n - this.head) {
            List<T> rest = new List<T>();
            rest.Reserve(n - this.head);
            int i = this.head;
            while (i < n) {
                rest.Add(this.items[i]);
                i = i + 1;
            }
            this.items = rest;
            this.head = 0;
        }
        return v;
    }
}
