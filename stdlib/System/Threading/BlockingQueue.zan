using System;

namespace System.Threading;

// 跨 OS 线程有界/无界交接队列（capacity <= 0 为无界；empty 为空哨兵）。
public class BlockingQueue<T> : IDisposable {
    public List<T> items;
    public int head;
    public bool closed;
    public int waiters;
    public int capacity;
    public int posters;
    public T empty;
    public string fault;
    public bool canceled;

    public nint lockHandle;
    public nint sem;
    public nint slots;

    public BlockingQueue() {
        this.Init(0);
    }

    public BlockingQueue(T empty, int capacity) {
        this.empty = empty;
        this.Init(capacity);
    }

    private void Init(int capacity) {
        this.head = 0;
        this.closed = false;
        this.waiters = 0;
        this.posters = 0;
        this.fault = "";
        this.canceled = false;
        this.items = new List<T>();
        this.capacity = capacity > 0 ? capacity : 0;
        this.lockHandle = Mutex.Create();
        this.sem = Semaphore.Create(0, 1048576);
        this.slots = Semaphore.Create(0, 1048576);
    }

    private static void ReleaseWaiters(nint semHandle, int count) {
        for (int i = 0; i < count; i = i + 1) {
            Semaphore.Release(semHandle);
        }
    }

    private T TakeAndCheckPosterLocked(out bool room) {
        T v = this.TakeLocked();
        room = this.posters > 0;
        if (room) { this.posters = this.posters - 1; }
        return v;
    }

    private void PushAndCheckWaiterLocked(T item, out bool wake) {
        this.items.Add(item);
        wake = this.waiters > 0;
        if (wake) { this.waiters = this.waiters - 1; }
    }

    public bool Enqueue(T item) {
        while (true) {
            Mutex.Lock(this.lockHandle);
            if (this.closed) {
                Mutex.Unlock(this.lockHandle);
                return false;
            }
            if (this.capacity > 0 && this.items.Count - this.head >= this.capacity) {
                this.posters = this.posters + 1;
                Mutex.Unlock(this.lockHandle);
                Semaphore.Wait(this.slots);
                continue;
            }
            bool wake = false;
            this.PushAndCheckWaiterLocked(item, out wake);
            Mutex.Unlock(this.lockHandle);
            if (wake) { Semaphore.Release(this.sem); }
            return true;
        }
    }

    // 超时或队列已结束返回 false；负超时无限等待。
    public bool EnqueueFor(T item, int timeoutMs) {
        while (true) {
            Mutex.Lock(this.lockHandle);
            if (this.closed) {
                Mutex.Unlock(this.lockHandle);
                return false;
            }
            if (this.capacity <= 0 || this.items.Count - this.head < this.capacity) {
                bool wake = false;
                this.PushAndCheckWaiterLocked(item, out wake);
                Mutex.Unlock(this.lockHandle);
                if (wake) { Semaphore.Release(this.sem); }
                return true;
            }
            this.posters = this.posters + 1;
            Mutex.Unlock(this.lockHandle);
            if (Semaphore.WaitFor(this.slots, timeoutMs)) { continue; }
            Mutex.Lock(this.lockHandle);
            bool parked = this.posters > 0;
            if (parked) { this.posters = this.posters - 1; }
            Mutex.Unlock(this.lockHandle);
            if (parked) { return false; }
            // 消费者已配对释放空位，吃掉令牌再重试
            Semaphore.Wait(this.slots);
        }
    }

    public T TryDequeue() {
        Mutex.Lock(this.lockHandle);
        bool room = false;
        T v = this.TakeAndCheckPosterLocked(out room);
        Mutex.Unlock(this.lockHandle);
        if (room) { Semaphore.Release(this.slots); }
        return v;
    }

    public T DequeueFor(int timeoutMs) {
        while (true) {
            Mutex.Lock(this.lockHandle);
            if (this.head < this.items.Count) {
                bool room = false;
                T v = this.TakeAndCheckPosterLocked(out room);
                Mutex.Unlock(this.lockHandle);
                if (room) { Semaphore.Release(this.slots); }
                return v;
            }
            if (this.closed) {
                Mutex.Unlock(this.lockHandle);
                return this.empty;
            }
            this.waiters = this.waiters + 1;
            Mutex.Unlock(this.lockHandle);
            if (Semaphore.WaitFor(this.sem, timeoutMs)) { continue; }
            Mutex.Lock(this.lockHandle);
            bool parked = this.waiters > 0;
            if (parked) { this.waiters = this.waiters - 1; }
            Mutex.Unlock(this.lockHandle);
            if (parked) { return this.empty; }
            Semaphore.Wait(this.sem);
        }
    }

    public T Dequeue() {
        while (true) {
            Mutex.Lock(this.lockHandle);
            if (this.head < this.items.Count) {
                bool room = false;
                T v = this.TakeAndCheckPosterLocked(out room);
                Mutex.Unlock(this.lockHandle);
                if (room) { Semaphore.Release(this.slots); }
                return v;
            }
            if (this.closed) {
                Mutex.Unlock(this.lockHandle);
                return this.empty;
            }
            this.waiters = this.waiters + 1;
            Mutex.Unlock(this.lockHandle);
            Semaphore.Wait(this.sem);
        }
    }

    public void Complete() {
        this.CompleteWithFault("");
    }

    public void CompleteWithFault(string message) {
        Mutex.Lock(this.lockHandle);
        this.closed = true;
        this.fault = message;
        int wake = this.waiters;
        this.waiters = 0;
        int free = this.posters;
        this.posters = 0;
        Mutex.Unlock(this.lockHandle);
        BlockingQueue<T>.ReleaseWaiters(this.sem, wake);
        BlockingQueue<T>.ReleaseWaiters(this.slots, free);
    }

    public void Cancel() {
        Mutex.Lock(this.lockHandle);
        this.canceled = true;
        this.closed = true;
        this.fault = "";
        this.items.Clear();
        this.head = 0;
        int wake = this.waiters;
        this.waiters = 0;
        int free = this.posters;
        this.posters = 0;
        Mutex.Unlock(this.lockHandle);
        BlockingQueue<T>.ReleaseWaiters(this.sem, wake);
        BlockingQueue<T>.ReleaseWaiters(this.slots, free);
    }

    public bool IsCanceled() {
        Mutex.Lock(this.lockHandle);
        bool v = this.canceled;
        Mutex.Unlock(this.lockHandle);
        return v;
    }

    public string GetFault() {
        Mutex.Lock(this.lockHandle);
        string v = this.fault;
        Mutex.Unlock(this.lockHandle);
        return v;
    }

    public bool IsCompleted() {
        Mutex.Lock(this.lockHandle);
        bool v = this.closed && this.head >= this.items.Count;
        Mutex.Unlock(this.lockHandle);
        return v;
    }

    public int Count() {
        Mutex.Lock(this.lockHandle);
        int v = this.items.Count - this.head;
        Mutex.Unlock(this.lockHandle);
        return v;
    }

    public void Dispose() {
        if (this.sem != 0) {
            Semaphore.Destroy(this.sem);
            this.sem = 0;
        }
        if (this.slots != 0) {
            Semaphore.Destroy(this.slots);
            this.slots = 0;
        }
        if (this.lockHandle != 0) {
            Mutex.Destroy(this.lockHandle);
            this.lockHandle = 0;
        }
    }

    public T TakeLocked() {
        if (this.head >= this.items.Count) { return this.empty; }
        T v = this.items[this.head];
        this.head = this.head + 1;
        if (this.head > 64 && this.head * 2 >= this.items.Count) {
            List<T> rest = new List<T>();
            int i = this.head;
            while (i < this.items.Count) {
                rest.Add(this.items[i]);
                i = i + 1;
            }
            this.items = rest;
            this.head = 0;
        }
        return v;
    }
}
