using System;

// 线程阻塞型读写锁：读共享、写排他、写优先（有写者等待时新读者
// 排队，防写饿死）。与 AsyncRwLock（协程闸，配 await）分工：本锁
// 供同步代码在多线程/并行 worker 下互斥，获取在原生互斥上自旋 +
// Sleep 让片，适合微秒~毫秒级短临界区。非可重入——同线程嵌套获取
// 会自锁，嵌套调用走外层唯一持锁纪律（AsyncRwLock 同约定）。
public class RwLock {
    public nint mtx;
    public int readers;
    public bool writer;
    public int writersWaiting;

    public RwLock() {
        this.mtx = Mutex.Create();
        this.readers = 0;
        this.writer = false;
        this.writersWaiting = 0;
    }

    // 获取共享读访问；有写者持锁或等待时排队让行。
    public void EnterRead() {
        while (true) {
            Mutex.Lock(this.mtx);
            if (!this.writer && this.writersWaiting == 0) {
                this.readers = this.readers + 1;
                Mutex.Unlock(this.mtx);
                return;
            }
            Mutex.Unlock(this.mtx);
            Thread.Sleep(1);
        }
    }

    // 释放共享读访问。
    public void ExitRead() {
        Mutex.Lock(this.mtx);
        this.readers = this.readers - 1;
        Mutex.Unlock(this.mtx);
    }

    // 获取排他写访问；等待期间登记写者意愿（写优先）。
    public void EnterWrite() {
        Mutex.Lock(this.mtx);
        this.writersWaiting = this.writersWaiting + 1;
        Mutex.Unlock(this.mtx);
        while (true) {
            Mutex.Lock(this.mtx);
            if (!this.writer && this.readers == 0) {
                this.writersWaiting = this.writersWaiting - 1;
                this.writer = true;
                Mutex.Unlock(this.mtx);
                return;
            }
            Mutex.Unlock(this.mtx);
            Thread.Sleep(1);
        }
    }

    // 释放排他写访问。
    public void ExitWrite() {
        Mutex.Lock(this.mtx);
        this.writer = false;
        Mutex.Unlock(this.mtx);
    }

    // 释放底层互斥句柄（锁废弃时调用；加锁后调用未定义）。
    public void Close() {
        Mutex.Destroy(this.mtx);
        this.mtx = 0;
    }
}
