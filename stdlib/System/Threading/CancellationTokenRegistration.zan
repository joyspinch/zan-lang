using System;

namespace System.Threading;

// 取消回调注册句柄，提供显式注销取消回调与生命周期管理。
public class CancellationTokenRegistration : IDisposable {
    CancellationToken token;
    long registrationId;
    bool isDisposed;

    public CancellationTokenRegistration(CancellationToken token, long registrationId) {
        this.token = token;
        this.registrationId = registrationId;
        this.isDisposed = false;
    }

    // 注销回调，取消触发时不再被调用。
    public void Dispose() {
        if (this.isDisposed) { return; }
        this.isDisposed = true;
        if (this.token != null) {
            this.token.Unregister(this.registrationId);
        }
    }

}
