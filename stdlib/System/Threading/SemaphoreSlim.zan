using System;

namespace System.Threading;

// 可动态调整并发上限的计数节流器（类似 C# SemaphoreSlim + SetLimit）。
// 准入在 Mutex 下判定、等待者挂起在 OS Semaphore；降上限不打断已持有槽位者，Cancel 为一次性关闭并在 Dispose 前禁止并发 Release/SetLimit。
public class SemaphoreSlim : IDisposable {
    int limit;
    int active;
    int waiters;
    int canceled;

    nint lockHandle;
    nint sem;

    public SemaphoreSlim() {
        this.limit = 1;
        this.active = 0;
        this.waiters = 0;
        this.canceled = 0;
        this.lockHandle = Mutex.Create();
        this.sem = Semaphore.Create(0, 1048576);
    }

    public SemaphoreSlim(int limit) {
        if (limit < 0) { limit = 0; }
        this.limit = limit;
        this.active = 0;
        this.waiters = 0;
        this.canceled = 0;
        this.lockHandle = Mutex.Create();
        // OS 信号量仅用于阻塞等待；实际可用许可为 Mutex 下的 (limit - active)。
        this.sem = Semaphore.Create(0, 1048576);
    }

    // 获取槽位，无空位时阻塞；Cancel 后立即返回且不占槽位。
    public void Wait() {
        Mutex.Lock(this.lockHandle);
        if (this.canceled != 0 || this.active < this.limit) {
            if (this.canceled == 0) { this.active = this.active + 1; }
            Mutex.Unlock(this.lockHandle);
            return;
        }
        this.waiters = this.waiters + 1;
        Mutex.Unlock(this.lockHandle);
        // 释放方已移交槽位并计入 active，唤醒后无需重检；Cancel 唤醒时由 IsCanceled 区分。
        Semaphore.Wait(this.sem);
    }

    // 限时获取槽位（负超时无限等）；拿到返回 true，超时或已 Cancel 返回 false。
    public bool WaitFor(int timeoutMs) {
        Mutex.Lock(this.lockHandle);
        if (this.canceled != 0) {
            Mutex.Unlock(this.lockHandle);
            return false;
        }
        if (this.active < this.limit) {
            this.active = this.active + 1;
            Mutex.Unlock(this.lockHandle);
            return true;
        }
        this.waiters = this.waiters + 1;
        Mutex.Unlock(this.lockHandle);
        if (Semaphore.WaitFor(this.sem, timeoutMs)) {
            Mutex.Lock(this.lockHandle);
            bool ok = this.canceled == 0;
            Mutex.Unlock(this.lockHandle);
            return ok;
        }

        // 超时撤回等待；若 waiters 已被释放方消费移交，则补领该信号量许可避免泄漏槽位。
        Mutex.Lock(this.lockHandle);
        if (this.waiters > 0) {
            this.waiters = this.waiters - 1;
            Mutex.Unlock(this.lockHandle);
            return false;
        }
        Mutex.Unlock(this.lockHandle);
        Semaphore.Wait(this.sem);
        Mutex.Lock(this.lockHandle);
        bool took = this.canceled == 0;
        Mutex.Unlock(this.lockHandle);
        return took;
    }

    public bool TryWait() {
        Mutex.Lock(this.lockHandle);
        bool got = this.canceled == 0 && this.active < this.limit;
        if (got) { this.active = this.active + 1; }
        Mutex.Unlock(this.lockHandle);
        return got;
    }

    // 归还槽位并按上限唤醒等待者（Cancel 后仅递减 active 不再唤醒）。
    public void Release() {
        Mutex.Lock(this.lockHandle);
        if (this.active > 0) { this.active = this.active - 1; }
        bool wake = this.canceled == 0 && this.waiters > 0
            && this.active < this.limit;
        if (wake) {
            this.waiters = this.waiters - 1;
            this.active = this.active + 1;
        }
        Mutex.Unlock(this.lockHandle);
        if (wake) { Semaphore.Release(this.sem); }
    }

    // 动态调整上限，返回本次放行的等待者数量。
    public int SetLimit(int limit) {
        if (limit < 0) { limit = 0; }
        Mutex.Lock(this.lockHandle);
        this.limit = limit;
        int wake = 0;
        while (this.canceled == 0 && this.waiters > 0
               && this.active < this.limit) {
            this.waiters = this.waiters - 1;
            this.active = this.active + 1;
            wake = wake + 1;
        }
        Mutex.Unlock(this.lockHandle);
        for (int i = 0; i < wake; i = i + 1) {
            Semaphore.Release(this.sem);
        }
        return wake;
    }

    // 一次性关闭：唤醒所有挂起等待者并拒绝后续准入（之后应调用 Dispose）。
    public void Cancel() {
        Mutex.Lock(this.lockHandle);
        this.canceled = 1;
        int wake = this.waiters;
        this.waiters = 0;
        Mutex.Unlock(this.lockHandle);
        for (int i = 0; i < wake; i = i + 1) {
            Semaphore.Release(this.sem);
        }
    }

    public bool IsCanceled() {
        Mutex.Lock(this.lockHandle);
        int v = this.canceled;
        Mutex.Unlock(this.lockHandle);
        return v != 0;
    }

    public int Limit() {
        Mutex.Lock(this.lockHandle);
        int v = this.limit;
        Mutex.Unlock(this.lockHandle);
        return v;
    }

    public int Active() {
        Mutex.Lock(this.lockHandle);
        int v = this.active;
        Mutex.Unlock(this.lockHandle);
        return v;
    }

    public int Waiting() {
        Mutex.Lock(this.lockHandle);
        int v = this.waiters;
        Mutex.Unlock(this.lockHandle);
        return v;
    }

    public void Dispose() {
        if (this.sem != 0) {
            Semaphore.Destroy(this.sem);
            this.sem = 0;
        }
        if (this.lockHandle != 0) {
            Mutex.Destroy(this.lockHandle);
            this.lockHandle = 0;
        }
    }
}
