using System;

namespace System.Threading;

/// <summary>
/// A counting throttle whose limit can be changed while work is in flight --
/// the equivalent of C#'s <c>SemaphoreSlim</c> plus a live
/// <c>maxConcurrency</c> knob.
///
/// <code>
/// SemaphoreSlim gate = new SemaphoreSlim(4);   // 4 workers at a time
/// gate.Wait();
/// try { ... } finally { gate.Release(); }
/// gate.SetLimit(8);                               // ramp up, waiters wake
/// </code>
///
/// Admission is decided under a mutex; a caller that cannot be admitted parks
/// on an OS semaphore and is woken by whoever frees a slot -- no spinning and
/// no timer. Raising the limit admits exactly as many parked waiters as the
/// new headroom allows. Lowering it never interrupts work already running:
/// the extra permits simply stop being handed out as callers return them, so
/// concurrency drains down to the new limit.
///
/// <see cref="Cancel"/> is the shutdown path: it wakes every parked waiter and
/// makes every later admission attempt fail, so a worker pool being torn down
/// stops cleanly instead of hanging on a gate nobody will release. Treat it as
/// one-way -- after Cancel the gate must be disposed, and callers must not
/// hand slots out (Release / SetLimit) concurrently with it.
/// </summary>
class SemaphoreSlim {
    /// Slots that may be held at once. Changed at any time by SetLimit.
    int limit;
    /// Slots currently held by callers that returned from Wait.
    int active;
    /// Callers parked on `sem` waiting for a slot.
    int waiters;
    /// Set by Cancel: the gate is dead, no admission will succeed again.
    int canceled;

    #if WINDOWS
    nint lockHandle;
    nint sem;
    #else
    string lockHandle;
    string sem;
    #endif

    SemaphoreSlim() {
        this.limit = 1;
        this.active = 0;
        this.waiters = 0;
        this.canceled = 0;
    }

    /// <summary>A throttle that admits `limit` callers at a time.</summary>
    SemaphoreSlim(int limit) {
        if (limit < 0) { limit = 0; }
        this.limit = limit;
        this.active = 0;
        this.waiters = 0;
        this.canceled = 0;
        this.lockHandle = Mutex.Create();
        // The OS semaphore only parks waiters; the permit count that matters
        // is `limit - active`, kept under the mutex. Its own maximum is just
        // an upper bound on parked threads.
        this.sem = Semaphore.Create(0, 1048576);
    }

    /// <summary>Takes a slot, blocking the calling thread until one is
    /// free. Returns immediately without a slot after <see cref="Cancel"/>.</summary>
    void Wait() {
        Mutex.Lock(this.lockHandle);
        if (this.canceled != 0 || this.active < this.limit) {
            if (this.canceled == 0) { this.active = this.active + 1; }
            Mutex.Unlock(this.lockHandle);
            return;
        }
        this.waiters = this.waiters + 1;
        Mutex.Unlock(this.lockHandle);
        // The slot is handed over by the releaser (it already counted this
        // caller in `active`), so there is nothing to re-check on wake-up.
        // A Cancel wakes the same semaphore without handing a slot over; the
        // caller tells the two apart with IsCanceled.
        Semaphore.Wait(this.sem);
    }

    /// <summary>Takes a slot, waiting at most `timeoutMs` for one. True when
    /// a slot was taken (the caller must Release it), false when the wait ran
    /// out or the gate was cancelled. A negative timeout waits forever.</summary>
    bool WaitFor(int timeoutMs) {
        Mutex.Lock(this.lockHandle);
        if (this.canceled != 0) {
            Mutex.Unlock(this.lockHandle);
            return false;
        }
        if (this.active < this.limit) {
            this.active = this.active + 1;
            Mutex.Unlock(this.lockHandle);
            return true;
        }
        this.waiters = this.waiters + 1;
        Mutex.Unlock(this.lockHandle);
        if (Semaphore.WaitFor(this.sem, timeoutMs)) {
            Mutex.Lock(this.lockHandle);
            bool ok = this.canceled == 0;
            Mutex.Unlock(this.lockHandle);
            return ok;
        }

        // Timed out. Withdraw the registration -- unless every registration
        // has already been paired with a hand-off, in which case a releaser
        // counted this caller into `active` and posted (or is posting) the
        // permit: consume it rather than leaking the slot.
        Mutex.Lock(this.lockHandle);
        if (this.waiters > 0) {
            this.waiters = this.waiters - 1;
            Mutex.Unlock(this.lockHandle);
            return false;
        }
        Mutex.Unlock(this.lockHandle);
        Semaphore.Wait(this.sem);
        Mutex.Lock(this.lockHandle);
        bool took = this.canceled == 0;
        Mutex.Unlock(this.lockHandle);
        return took;
    }

    /// <summary>Takes a slot only if one is free right now. True when it
    /// was taken -- the caller must Release it. Always false after Cancel.</summary>
    bool TryWait() {
        Mutex.Lock(this.lockHandle);
        bool got = this.canceled == 0 && this.active < this.limit;
        if (got) { this.active = this.active + 1; }
        Mutex.Unlock(this.lockHandle);
        return got;
    }

    /// <summary>Returns a slot. Wakes one waiter when the limit allows.
    /// No-op for admission after <see cref="Cancel"/> (holders may still
    /// return their slots, but nobody is woken).</summary>
    void Release() {
        Mutex.Lock(this.lockHandle);
        if (this.active > 0) { this.active = this.active - 1; }
        bool wake = this.canceled == 0 && this.waiters > 0
            && this.active < this.limit;
        if (wake) {
            this.waiters = this.waiters - 1;
            this.active = this.active + 1;
        }
        Mutex.Unlock(this.lockHandle);
        if (wake) { Semaphore.Release(this.sem); }
    }

    /// <summary>Changes how many callers may hold a slot at once, at any
    /// time. Returns how many parked waiters the new limit let in.</summary>
    int SetLimit(int limit) {
        if (limit < 0) { limit = 0; }
        Mutex.Lock(this.lockHandle);
        this.limit = limit;
        int wake = 0;
        while (this.canceled == 0 && this.waiters > 0
               && this.active < this.limit) {
            this.waiters = this.waiters - 1;
            this.active = this.active + 1;
            wake = wake + 1;
        }
        Mutex.Unlock(this.lockHandle);
        for (int i = 0; i < wake; i = i + 1) {
            Semaphore.Release(this.sem);
        }
        return wake;
    }

    /// <summary>One-way shutdown: wakes every parked waiter and makes all
    /// later Wait / WaitFor / TryWait fail immediately. Work already holding
    /// a slot keeps it (its Release stays a no-op for admission). After this
    /// the gate must be <see cref="Dispose"/>d, and callers must not hand
    /// slots out concurrently with it.</summary>
    void Cancel() {
        Mutex.Lock(this.lockHandle);
        this.canceled = 1;
        int wake = this.waiters;
        this.waiters = 0;
        Mutex.Unlock(this.lockHandle);
        for (int i = 0; i < wake; i = i + 1) {
            Semaphore.Release(this.sem);
        }
    }

    /// <summary>True after <see cref="Cancel"/>: the gate admits nothing.</summary>
    bool IsCanceled() {
        Mutex.Lock(this.lockHandle);
        int v = this.canceled;
        Mutex.Unlock(this.lockHandle);
        return v != 0;
    }

    /// <summary>The current limit.</summary>
    int Limit() {
        Mutex.Lock(this.lockHandle);
        int v = this.limit;
        Mutex.Unlock(this.lockHandle);
        return v;
    }

    /// <summary>Slots held right now.</summary>
    int Active() {
        Mutex.Lock(this.lockHandle);
        int v = this.active;
        Mutex.Unlock(this.lockHandle);
        return v;
    }

    /// <summary>Callers parked waiting for a slot.</summary>
    int Waiting() {
        Mutex.Lock(this.lockHandle);
        int v = this.waiters;
        Mutex.Unlock(this.lockHandle);
        return v;
    }

    /// <summary>Frees the OS handles. No caller may be parked.</summary>
    void Dispose() {
        Semaphore.Destroy(this.sem);
        Mutex.Destroy(this.lockHandle);
    }
}
