using System;

namespace System.Threading;

// 可动态调整并发上限的计数节流器（类似 C# SemaphoreSlim + SetLimit）。
// 准入在 Mutex 下判定、等待者挂起在 OS Semaphore；降上限不打断已持有槽位者，Cancel 为一次性关闭并在 Dispose 前禁止并发 Release/SetLimit。
public class SemaphoreSlim : IDisposable {
    int limit;
    int active;
    int waiters;
    int signals;
    int inFlightWaits;
    int canceled;
    bool disposed;

    nint sem;

    public SemaphoreSlim() {
        this.limit = 1;
        this.active = 0;
        this.waiters = 0;
        this.signals = 0;
        this.inFlightWaits = 0;
        this.canceled = 0;
        this.disposed = false;
        this.sem = Semaphore.Create(0, 1048576);
    }

    public SemaphoreSlim(int limit) {
        if (limit < 0) { limit = 0; }
        this.limit = limit;
        this.active = 0;
        this.waiters = 0;
        this.signals = 0;
        this.inFlightWaits = 0;
        this.canceled = 0;
        this.disposed = false;
        // OS 信号量仅用于阻塞等待；实际可用许可为 lock (this) 下的 (limit - active)。
        this.sem = Semaphore.Create(0, 1048576);
    }

    private void FinishWait(bool gotSignal) {
        nint toDestroy = 0;
        lock (this) {
            if (gotSignal && this.signals > 0) {
                this.signals = this.signals - 1;
            }
            if (this.waiters > 0) {
                this.waiters = this.waiters - 1;
            }
            if (this.inFlightWaits > 0) {
                this.inFlightWaits = this.inFlightWaits - 1;
            }
            if (this.disposed && this.inFlightWaits == 0 && this.sem != 0) {
                toDestroy = this.sem;
                this.sem = 0;
            }
        }
        if (toDestroy != 0) {
            Semaphore.Destroy(toDestroy);
        }
    }

    // 获取槽位，无空位时阻塞；Cancel 后立即返回且不占槽位。
    public void Wait() {
        while (true) {
            nint sm = 0;
            lock (this) {
                if (this.canceled != 0 || this.disposed) {
                    return;
                }
                if (this.active < this.limit) {
                    this.active = this.active + 1;
                    return;
                }
                sm = this.sem;
                if (sm == 0) {
                    return;
                }
                this.waiters = this.waiters + 1;
                this.inFlightWaits = this.inFlightWaits + 1;
            }
            bool got = false;
            try {
                Semaphore.Wait(sm);
                got = true;
            } finally {
                this.FinishWait(got);
            }
        }
    }

    // 限时获取槽位（负超时无限等）；拿到返回 true，超时或已 Cancel 返回 false。
    public bool WaitFor(int timeoutMs) {
        if (timeoutMs == 0) {
            return this.TryWait();
        }
        long deadline = timeoutMs > 0 ? Stopwatch.GetMilliseconds() + (long)timeoutMs : 0L;
        while (true) {
            nint sm = 0;
            int waitMs = -1;
            lock (this) {
                if (this.canceled != 0 || this.disposed) {
                    return false;
                }
                if (this.active < this.limit) {
                    this.active = this.active + 1;
                    return true;
                }
                if (timeoutMs > 0) {
                    long rem = deadline - Stopwatch.GetMilliseconds();
                    if (rem <= 0L) {
                        return false;
                    }
                    waitMs = rem > 2147483647L ? 2147483647 : (int)rem;
                }
                sm = this.sem;
                if (sm == 0) {
                    return false;
                }
                this.waiters = this.waiters + 1;
                this.inFlightWaits = this.inFlightWaits + 1;
            }
            bool got = false;
            try {
                got = Semaphore.WaitFor(sm, waitMs);
            } finally {
                this.FinishWait(got);
            }
            if (!got) {
                // 超时后最后一次在锁下检查是否恰有空位可用
                lock (this) {
                    if (this.canceled == 0 && !this.disposed && this.active < this.limit) {
                        this.active = this.active + 1;
                        return true;
                    }
                }
                return false;
            }
        }
    }

    public bool TryWait() {
        lock (this) {
            bool got = this.canceled == 0 && !this.disposed && this.active < this.limit;
            if (got) { this.active = this.active + 1; }
            return got;
        }
    }

    // 归还槽位并按上限唤醒等待者（Cancel 后仅递减 active 不再唤醒）。
    public void Release() {
        nint sm = 0;
        bool wake = false;
        lock (this) {
            if (this.active > 0) { this.active = this.active - 1; }
            if (this.canceled == 0 && !this.disposed && this.active < this.limit
                && this.waiters > this.signals && this.sem != 0) {
                this.signals = this.signals + 1;
                sm = this.sem;
                wake = true;
            }
        }
        if (wake) { Semaphore.Release(sm); }
    }

    // 动态调整上限，返回本次放行的等待者数量。
    public int SetLimit(int limit) {
        if (limit < 0) { limit = 0; }
        int wake = 0;
        nint sm = 0;
        lock (this) {
            this.limit = limit;
            if (this.canceled == 0 && !this.disposed && this.sem != 0) {
                int avail = this.limit - this.active;
                int need = this.waiters - this.signals;
                if (avail > 0 && need > 0) {
                    wake = avail < need ? avail : need;
                    this.signals = this.signals + wake;
                    sm = this.sem;
                }
            }
        }
        for (int i = 0; i < wake; i = i + 1) {
            Semaphore.Release(sm);
        }
        return wake;
    }

    // 一次性关闭：唤醒所有挂起等待者并拒绝后续准入（之后应调用 Dispose）。
    public void Cancel() {
        int wake = 0;
        nint sm = 0;
        lock (this) {
            this.canceled = 1;
            if (this.sem != 0 && this.waiters > this.signals) {
                wake = this.waiters - this.signals;
                this.signals = this.signals + wake;
                sm = this.sem;
            }
        }
        for (int i = 0; i < wake; i = i + 1) {
            Semaphore.Release(sm);
        }
    }

    public bool IsCanceled() {
        lock (this) {
            return this.canceled != 0;
        }
    }

    public int Limit() {
        lock (this) {
            return this.limit;
        }
    }

    public int Active() {
        lock (this) {
            return this.active;
        }
    }

    public int Waiting() {
        lock (this) {
            return this.waiters;
        }
    }

    public void Dispose() {
        int wake = 0;
        nint smWake = 0;
        nint smDestroy = 0;
        lock (this) {
            if (this.disposed) {
                return;
            }
            this.disposed = true;
            this.canceled = 1;
            if (this.sem != 0) {
                if (this.inFlightWaits == 0) {
                    smDestroy = this.sem;
                    this.sem = 0;
                } else if (this.waiters > this.signals) {
                    wake = this.waiters - this.signals;
                    this.signals = this.signals + wake;
                    smWake = this.sem;
                }
            }
        }
        for (int i = 0; i < wake; i = i + 1) {
            Semaphore.Release(smWake);
        }
        if (smDestroy != 0) {
            Semaphore.Destroy(smDestroy);
        }
    }
}
