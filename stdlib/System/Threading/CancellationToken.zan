using System;

namespace System.Threading;

// 跨平台轻量级取消令牌，提供非阻塞、线程安全且事件驱动的取消通知与回调注册。
// 适用于高并发异步流水线、长时任务协作式中断与网络请求超时。
public class CancellationToken : IDisposable {
    bool isCancellationRequested;
    bool closed;
    nint syncLock;
    List<CancellationTokenEntry> callbacks;
    List<Gate> waiters;
    long nextCallbackId;

    static CancellationToken noneToken = new CancellationToken();

    public CancellationToken() {
        this.isCancellationRequested = false;
        this.closed = false;
        this.syncLock = Mutex.Create();
        this.callbacks = new List<CancellationTokenEntry>();
        this.waiters = new List<Gate>();
        this.nextCallbackId = 0;
    }

    // 获取未取消且永不取消的空令牌单例。
    public static CancellationToken None {
        get {
            return CancellationToken.noneToken;
        }
    }

    // 是否已收到取消请求。
    public bool IsCancellationRequested {
        get { return this.isCancellationRequested; }
    }

    // 如果已请求取消，抛出异常或中断执行。
    public void ThrowIfCancellationRequested() {
        if (this.isCancellationRequested) {
            throw new Exception("The operation was canceled.");
        }
    }

    // 挂起当前协程直到收到取消请求（完全非阻塞，不占用线程与渲染帧）。
    // 多等待者安全：每个等待者在锁下登记一把私有门，完成方持锁快照并清空
    // 登记列表、解锁后逐个唤醒——旧实现全部等待者共用单门且取消只 Signal
    // 一次，N 个挂起者只有一个被唤醒，其余永久挂死；登记与挂起之间的窗口
    // 由私有门的暂存信号语义兜住（唤醒后锁下重查标志）。已取消返回 true；
    // 令牌已 Close（未取消）返回 false 并唤醒挂起者，不再挂死。
    public async bool WaitHandle() {
        if (this.isCancellationRequested) { return true; }
        nint lk = this.syncLock;
        if (lk == 0) { return this.isCancellationRequested; }
        Gate mine = null;
        bool waiting = false;
        bool canceled = false;
        Mutex.Lock(lk);
        if (this.isCancellationRequested) {
            canceled = true;
        } else if (!this.closed) {
            mine = new Gate();
            this.waiters.Add(mine);
            waiting = true;
        }
        Mutex.Unlock(lk);
        if (mine != null) {
            try {
                while (waiting) {
                    await mine.Wait();
                    nint lk2 = this.syncLock;
                    if (lk2 == 0) {
                        waiting = false;
                        canceled = this.isCancellationRequested;
                        break;
                    }
                    Mutex.Lock(lk2);
                    if (this.isCancellationRequested) {
                        waiting = false;
                        canceled = true;
                    } else if (this.closed) {
                        waiting = false;
                    }
                    Mutex.Unlock(lk2);
                }
            } finally {
                mine.Close();
            }
        }
        return canceled;
    }

    // 注册当令牌被取消时执行的回调委托。若令牌已处于取消态，立即同步执行。
    public CancellationTokenRegistration Register(Action callback) {
        if (callback == null) {
            return new CancellationTokenRegistration(this, 0);
        }
        nint lk = this.syncLock;
        if (lk == 0) {
            if (this.isCancellationRequested) {
                callback();
            }
            return new CancellationTokenRegistration(this, 0);
        }
        bool alreadyCanceled = false;
        long regId = 0;
        Mutex.Lock(lk);
        if (this.isCancellationRequested) {
            alreadyCanceled = true;
        } else if (!this.closed) {
            this.nextCallbackId = this.nextCallbackId + 1;
            regId = this.nextCallbackId;
            if (this.callbacks == null) {
                this.callbacks = new List<CancellationTokenEntry>();
            }
            this.callbacks.Add(new CancellationTokenEntry(regId, callback));
        }
        Mutex.Unlock(lk);

        if (alreadyCanceled) {
            callback();
            return new CancellationTokenRegistration(this, 0);
        }
        return new CancellationTokenRegistration(this, regId);
    }

    // 内部注销回调。
    public void Unregister(long id) {
        nint lk = this.syncLock;
        if (id == 0 || lk == 0) { return; }
        Mutex.Lock(lk);
        if (this.callbacks != null) {
            for (int i = 0; i < this.callbacks.Count; i = i + 1) {
                if (this.callbacks[i].id == id) {
                    this.callbacks.RemoveAt(i);
                    break;
                }
            }
        }
        Mutex.Unlock(lk);
    }

    // 须持锁调用：取走全部登记的私有等待门并重置登记列表。
    List<Gate> TakeWaiters() {
        List<Gate> taken = this.waiters;
        this.waiters = new List<Gate>();
        return taken;
    }

    // 解锁后调用：逐个 Signal 私有门——每个等待者恰好收到一次信号，
    // 唤醒后锁下重查标志决定去留。
    static void WakeAll(List<Gate> toWake) {
        if (toWake == null) { return; }
        for (int i = 0; i < toWake.Count; i = i + 1) {
            toWake[i].Signal();
        }
    }

    // 触发取消（内部由 CancellationTokenSource 调用）。
    public void CancelInternal() {
        if (this == CancellationToken.noneToken) { return; }
        nint lk = this.syncLock;
        if (lk == 0) { return; }
        List<Action> toInvoke = null;
        List<Gate> toWake = null;
        Mutex.Lock(lk);
        if (this.isCancellationRequested) {
            Mutex.Unlock(lk);
            return;
        }
        this.isCancellationRequested = true;
        toWake = TakeWaiters();
        if (this.callbacks != null && this.callbacks.Count > 0) {
            toInvoke = new List<Action>();
            for (int i = 0; i < this.callbacks.Count; i = i + 1) {
                toInvoke.Add(this.callbacks[i].callback);
            }
            this.callbacks.Clear();
        }
        Mutex.Unlock(lk);

        WakeAll(toWake);

        if (toInvoke != null) {
            for (int i = 0; i < toInvoke.Count; i = i + 1) {
                try {
                    toInvoke[i]();
                } catch (Exception ex) {
                    // 回调异常安全隔离，避免单点失败打断后续取消通知
                }
            }
        }
    }

    // 关闭释放底层资源；挂起中的等待者被唤醒并从 WaitHandle 得到 false。
    public void Close() {
        if (this == CancellationToken.noneToken) { return; }
        nint lk = this.syncLock;
        if (lk == 0) { return; }
        List<Gate> toWake = null;
        Mutex.Lock(lk);
        if (!this.closed) {
            this.closed = true;
            toWake = TakeWaiters();
            if (this.callbacks != null) {
                this.callbacks.Clear();
            }
        }
        this.syncLock = 0;
        Mutex.Unlock(lk);
        WakeAll(toWake);
        Mutex.Destroy(lk);
    }

    public void Dispose() {
        this.Close();
    }
}
