using System;

namespace System.Threading;

// 跨平台轻量级取消令牌，提供非阻塞、线程安全且事件驱动的取消通知与回调注册。
// 适用于高并发异步流水线、长时任务协作式中断与网络请求超时。
public class CancellationToken : IDisposable {
    bool isCancellationRequested;
    Gate waitGate;
    nint syncLock;
    List<CancellationTokenEntry> callbacks;
    long nextCallbackId;

    static CancellationToken noneToken;

    public CancellationToken() {
        this.isCancellationRequested = false;
        this.waitGate = new Gate();
        this.syncLock = Mutex.Create();
        this.callbacks = new List<CancellationTokenEntry>();
        this.nextCallbackId = 0;
    }

    // 获取未取消且永不取消的空令牌单例。
    public static CancellationToken None {
        get {
            if (CancellationToken.noneToken == null) {
                CancellationToken.noneToken = new CancellationToken();
            }
            return CancellationToken.noneToken;
        }
    }

    // 是否已收到取消请求。
    public bool IsCancellationRequested {
        get { return this.isCancellationRequested; }
    }

    // 如果已请求取消，抛出异常或中断执行。
    public void ThrowIfCancellationRequested() {
        if (this.isCancellationRequested) {
            throw new Exception("The operation was canceled.");
        }
    }

    // 挂起当前协程直到收到取消请求（完全非阻塞，不占用线程与渲染帧）。
    public async bool WaitHandle() {
        if (this.isCancellationRequested) { return true; }
        while (!this.isCancellationRequested) {
            await this.waitGate.Wait();
        }
        return true;
    }

    // 注册当令牌被取消时执行的回调委托。若令牌已处于取消态，立即同步执行。
    public CancellationTokenRegistration Register(Action callback) {
        if (callback == null) {
            return new CancellationTokenRegistration(this, 0);
        }
        bool alreadyCanceled = false;
        long regId = 0;
        Mutex.Lock(this.syncLock);
        if (this.isCancellationRequested) {
            alreadyCanceled = true;
        } else {
            this.nextCallbackId = this.nextCallbackId + 1;
            regId = this.nextCallbackId;
            if (this.callbacks == null) {
                this.callbacks = new List<CancellationTokenEntry>();
            }
            this.callbacks.Add(new CancellationTokenEntry(regId, callback));
        }
        Mutex.Unlock(this.syncLock);

        if (alreadyCanceled) {
            callback();
            return new CancellationTokenRegistration(this, 0);
        }
        return new CancellationTokenRegistration(this, regId);
    }

    // 内部注销回调。
    public void Unregister(long id) {
        if (id == 0 || this.syncLock == 0) { return; }
        Mutex.Lock(this.syncLock);
        if (this.callbacks != null) {
            for (int i = 0; i < this.callbacks.Count; i = i + 1) {
                if (this.callbacks[i].id == id) {
                    this.callbacks.RemoveAt(i);
                    break;
                }
            }
        }
        Mutex.Unlock(this.syncLock);
    }

    // 触发取消（内部由 CancellationTokenSource 调用）。
    public void CancelInternal() {
        List<Action> toInvoke = null;
        Mutex.Lock(this.syncLock);
        if (this.isCancellationRequested) {
            Mutex.Unlock(this.syncLock);
            return;
        }
        this.isCancellationRequested = true;
        if (this.callbacks != null && this.callbacks.Count > 0) {
            toInvoke = new List<Action>();
            for (int i = 0; i < this.callbacks.Count; i = i + 1) {
                toInvoke.Add(this.callbacks[i].callback);
            }
            this.callbacks.Clear();
        }
        Mutex.Unlock(this.syncLock);

        this.waitGate.Signal();

        if (toInvoke != null) {
            for (int i = 0; i < toInvoke.Count; i = i + 1) {
                try {
                    toInvoke[i]();
                } catch (Exception ex) {
                    // 回调异常安全隔离，避免单点失败打断后续取消通知
                }
            }
        }
    }

    // 关闭释放底层资源。
    public void Close() {
        if (this.waitGate != null) {
            this.waitGate.Close();
        }
        if (this.syncLock != 0) {
            Mutex.Destroy(this.syncLock);
            this.syncLock = 0;
        }
    }

    public void Dispose() {
        this.Close();
    }
}
