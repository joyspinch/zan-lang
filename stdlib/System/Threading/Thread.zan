using System;
using System.Platform;

namespace System.Threading;

// 无参数线程入口点（支持 lambda、静态方法组或实例方法组）。
public delegate void ThreadStart();

// 跨平台线程与同步原语。
public class Thread {
    [DllImport("crt", EntryPoint = "zan_thread_start")]
    static extern int PlatThreadStart(ThreadStart body);

    [DllImport("crt", EntryPoint = "zan_thread_current_id")]
    static extern long PlatCurrentThreadId();

    // 在分离后台线程上运行 body 并立即返回（成功返回 true）；跨线程共享状态需原子或调度器同步。
    public static bool Start(ThreadStart body) {
        return Thread.PlatThreadStart(body) != 0;
    }

    // 让当前线程休眠指定毫秒数（直通 PAL）。
    public static void Sleep(int milliseconds) {
        Pal.Sleep(milliseconds);
    }

    // 获取当前线程 ID（同进程内各线程唯一）。
    public static long CurrentId() {
        return PlatCurrentThreadId();
    }

    // 非阻塞异步休眠（对齐现代 Task.Delay 协程挂起，不占用调度器线程）。
    public static async Task SleepAsync(int milliseconds) {
        await Task.Delay(milliseconds);
    }
}
