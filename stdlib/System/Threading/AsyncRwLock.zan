using System;

namespace System.Threading;

// 协程读写锁：多个并发读者或一个独占
// 写者。等待者真正挂起在调度器上（经由 AsyncGate）——
// 无轮询。写者优先：一旦写者排队，新读者
// 便需等待，持续的读流不会饿死写操作。
// 内部状态由 Mutex 进行轻量互斥保护，确保多 Worker 调度下的绝对线程安全。
public class AsyncRwLock : IDisposable {
    public int readers;
    public bool writer;
    public int writersWaiting;
    public int readersWaiting;
    public AsyncGate readGate;
    public AsyncGate writeGate;
    public nint mtx;

    public AsyncRwLock() {
        this.readers = 0;
        this.writer = false;
        this.writersWaiting = 0;
        this.readersWaiting = 0;
        this.readGate = new AsyncGate();
        this.writeGate = new AsyncGate();
        this.mtx = Mutex.Create();
    }

    // 获取共享（读）访问；当写者持有锁
    // 或正在等待锁时挂起。无竞争快路径零额外信号。
    public async void EnterRead() {
        while (true) {
            nint m = this.mtx;
            if (m == 0) { return; }
            Mutex.Lock(m);
            if (!this.writer && this.writersWaiting == 0) {
                this.readers = this.readers + 1;
                bool wakeNextReader = this.readersWaiting > 0;
                AsyncGate rgWake = wakeNextReader ? this.readGate : null;
                Mutex.Unlock(m);
                // 仅当仍有排队读者时接力补发信号，防止 SignalAll 前后并发入队丢失唤醒。
                if (rgWake != null) {
                    rgWake.Signal();
                }
                return;
            }
            this.readersWaiting = this.readersWaiting + 1;
            AsyncGate rg = this.readGate;
            Mutex.Unlock(m);
            bool ok = rg != null && await rg.Wait();
            m = this.mtx;
            if (m != 0) {
                Mutex.Lock(m);
                if (this.readersWaiting > 0) { this.readersWaiting = this.readersWaiting - 1; }
                Mutex.Unlock(m);
            }
            if (!ok) { return; }
        }
    }

    // 释放共享访问。
    public void ExitRead() {
        nint m = this.mtx;
        if (m == 0) {
            return;
        }
        Mutex.Lock(m);
        bool wakeWriter = false;
        if (this.readers > 0) {
            this.readers = this.readers - 1;
            wakeWriter = (this.readers == 0 && this.writersWaiting > 0);
        }
        AsyncGate wg = this.writeGate;
        Mutex.Unlock(m);
        if (wakeWriter && wg != null) {
            wg.Signal();
        }
    }

    // 获取排他（写）访问；挂起直到所有读线程
    // 以及当前写线程都释放。
    public async void EnterWrite() {
        nint m = this.mtx;
        if (m == 0) { return; }
        Mutex.Lock(m);
        this.writersWaiting = this.writersWaiting + 1;
        Mutex.Unlock(m);

        while (true) {
            m = this.mtx;
            if (m == 0) { return; }
            Mutex.Lock(m);
            if (!this.writer && this.readers == 0) {
                this.writersWaiting = this.writersWaiting - 1;
                this.writer = true;
                Mutex.Unlock(m);
                return;
            }
            AsyncGate wg = this.writeGate;
            Mutex.Unlock(m);
            bool ok = wg != null && await wg.Wait();
            if (!ok) {
                m = this.mtx;
                if (m != 0) {
                    Mutex.Lock(m);
                    if (this.writersWaiting > 0) { this.writersWaiting = this.writersWaiting - 1; }
                    Mutex.Unlock(m);
                }
                return;
            }
        }
    }

    // 释放排他访问：写者优先，有排队写者时仅唤醒写者；否则一次性 SignalAll 放行全部等待读者。
    public void ExitWrite() {
        nint m = this.mtx;
        if (m == 0) {
            return;
        }
        Mutex.Lock(m);
        this.writer = false;
        bool hasWriters = this.writersWaiting > 0;
        bool hasReaders = this.readersWaiting > 0;
        AsyncGate wg = hasWriters ? this.writeGate : null;
        AsyncGate rg = (!hasWriters && hasReaders) ? this.readGate : null;
        Mutex.Unlock(m);
        if (wg != null) {
            wg.Signal();
        } else if (rg != null) {
            rg.SignalAll();
        }
    }

    // 当前读线程数（诊断用）。
    public int ReaderCount() {
        nint m = this.mtx;
        if (m == 0) {
            return 0;
        }
        Mutex.Lock(m);
        int r = this.readers;
        Mutex.Unlock(m);
        return r;
    }

    // 当前是否有写线程持有锁（诊断用）。
    public bool IsWriteLocked() {
        nint m = this.mtx;
        if (m == 0) {
            return false;
        }
        Mutex.Lock(m);
        bool w = this.writer;
        Mutex.Unlock(m);
        return w;
    }

    // 释放读/写两个门的底层句柄及互斥锁（锁废弃时调用）。
    public void Close() {
        if (this.readGate != null) {
            this.readGate.Close();
            this.readGate = null;
        }
        if (this.writeGate != null) {
            this.writeGate.Close();
            this.writeGate = null;
        }
        if (this.mtx != 0) {
            nint m = this.mtx;
            this.mtx = 0;
            Mutex.Destroy(m);
        }
    }

    // 实现 IDisposable 接口，与 Close 语义对齐
    public void Dispose() {
        this.Close();
    }
}
