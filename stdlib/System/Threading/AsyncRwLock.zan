using System;

namespace System.Threading;

// 协程读写锁：多个并发读者或一个独占
// 写者。等待者真正挂起在调度器上（经由 AsyncGate）——
// 无轮询。写者优先：一旦写者排队，新读者
// 便需等待，持续的读流不会饿死写操作。
// 内部状态由 Mutex 进行轻量互斥保护，确保多 Worker 调度下的绝对线程安全。
public class AsyncRwLock : IDisposable {
    public int readers;
    public bool writer;
    public int writersWaiting;
    public int readersWaiting;
    public AsyncGate readGate;
    public AsyncGate writeGate;
    public nint mtx;
    private bool closed;

    public AsyncRwLock() {
        this.readers = 0;
        this.writer = false;
        this.writersWaiting = 0;
        this.readersWaiting = 0;
        this.readGate = new AsyncGate();
        this.writeGate = new AsyncGate();
        this.mtx = 0;
        this.closed = false;
    }

    // 获取共享（读）访问；当写者持有锁
    // 或正在等待锁时挂起。无竞争快路径零额外信号。
    public async void EnterRead() {
        while (true) {
            AsyncGate rg = null;
            AsyncGate rgWake = null;
            bool acquired = false;
            lock (this) {
                if (this.closed) {
                    throw new ObjectDisposedException("AsyncRwLock");
                }
                if (!this.writer && this.writersWaiting == 0) {
                    this.readers = this.readers + 1;
                    acquired = true;
                    if (this.readersWaiting > 0) {
                        rgWake = this.readGate;
                    }
                } else {
                    this.readersWaiting = this.readersWaiting + 1;
                    rg = this.readGate;
                }
            }
            if (acquired) {
                // 仅当仍有排队读者时接力补发信号，防止 SignalAll 前后并发入队丢失唤醒。
                if (rgWake != null) {
                    rgWake.Signal();
                }
                return;
            }
            bool ok = false;
            try {
                ok = rg != null && await rg.Wait();
            } finally {
                lock (this) {
                    if (this.readersWaiting > 0) {
                        this.readersWaiting = this.readersWaiting - 1;
                    }
                }
            }
            if (!ok) {
                throw new ObjectDisposedException("AsyncRwLock");
            }
        }
    }

    // 释放共享访问。
    public void ExitRead() {
        AsyncGate wg = null;
        lock (this) {
            if (this.closed) {
                return;
            }
            if (this.readers > 0) {
                this.readers = this.readers - 1;
                if (this.readers == 0 && this.writersWaiting > 0) {
                    wg = this.writeGate;
                }
            }
        }
        if (wg != null) {
            wg.Signal();
        }
    }

    // 获取排他（写）访问；挂起直到所有读线程
    // 以及当前写线程都释放。
    public async void EnterWrite() {
        lock (this) {
            if (this.closed) {
                throw new ObjectDisposedException("AsyncRwLock");
            }
            this.writersWaiting = this.writersWaiting + 1;
        }
        bool acquired = false;
        try {
            while (true) {
                AsyncGate wg = null;
                lock (this) {
                    if (this.closed) {
                        throw new ObjectDisposedException("AsyncRwLock");
                    }
                    if (!this.writer && this.readers == 0) {
                        this.writersWaiting = this.writersWaiting - 1;
                        this.writer = true;
                        acquired = true;
                        return;
                    }
                    wg = this.writeGate;
                }
                bool ok = wg != null && await wg.Wait();
                if (!ok) {
                    throw new ObjectDisposedException("AsyncRwLock");
                }
            }
        } finally {
            if (!acquired) {
                AsyncGate rg = null;
                lock (this) {
                    if (this.writersWaiting > 0) {
                        this.writersWaiting = this.writersWaiting - 1;
                    }
                    if (!this.closed && !this.writer && this.writersWaiting == 0 && this.readersWaiting > 0) {
                        rg = this.readGate;
                    }
                }
                if (rg != null) {
                    rg.SignalAll();
                }
            }
        }
    }

    // 释放排他访问：写者优先，有排队写者时仅唤醒写者；否则一次性 SignalAll 放行全部等待读者。
    public void ExitWrite() {
        AsyncGate wg = null;
        AsyncGate rg = null;
        lock (this) {
            if (this.closed) {
                return;
            }
            this.writer = false;
            if (this.writersWaiting > 0) {
                wg = this.writeGate;
            } else if (this.readersWaiting > 0) {
                rg = this.readGate;
            }
        }
        if (wg != null) {
            wg.Signal();
        } else if (rg != null) {
            rg.SignalAll();
        }
    }

    // 当前读线程数（诊断用）。
    public int ReaderCount() {
        lock (this) {
            if (this.closed) {
                return 0;
            }
            return this.readers;
        }
    }

    // 当前是否有写线程持有锁（诊断用）。
    public bool IsWriteLocked() {
        lock (this) {
            if (this.closed) {
                return false;
            }
            return this.writer;
        }
    }

    // 释放读/写两个门的底层句柄及互斥锁（锁废弃时调用）。
    public void Close() {
        AsyncGate rg = null;
        AsyncGate wg = null;
        lock (this) {
            if (this.closed) {
                return;
            }
            this.closed = true;
            rg = this.readGate;
            this.readGate = null;
            wg = this.writeGate;
            this.writeGate = null;
        }
        if (rg != null) {
            rg.Close();
        }
        if (wg != null) {
            wg.Close();
        }
    }

    // 实现 IDisposable 接口，与 Close 语义对齐
    public void Dispose() {
        this.Close();
    }
}
