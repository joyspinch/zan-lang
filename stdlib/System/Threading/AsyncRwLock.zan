using System;

namespace System.Threading;

/// <summary>
/// 协程读写锁：多个并发读者或一个独占
/// 写者。等待者真正挂起在调度器上（经由 AsyncGate）——
/// 无轮询。写者优先：一旦写者排队，新读者
/// 便需等待，持续的读流不会饿死写操作。
///
///   AsyncRwLock lock = new AsyncRwLock();
///   await lock.EnterRead();  ...  lock.ExitRead();
///   await lock.EnterWrite(); ...  lock.ExitWrite();
/// </summary>
class AsyncRwLock {
    int readers;
    bool writer;
    int writersWaiting;
    AsyncGate readGate;
    AsyncGate writeGate;

    AsyncRwLock() {
        this.readers = 0;
        this.writer = false;
        this.writersWaiting = 0;
        this.readGate = new AsyncGate();
        this.writeGate = new AsyncGate();
    }

    /// <summary>获取共享（读）访问；当写者持有锁
    /// 或正在等待锁时挂起。</summary>
    async void EnterRead() {
        while (this.writer || this.writersWaiting > 0) {
            await this.readGate.Wait();
        }
        this.readers = this.readers + 1;
        // 级联唤醒，让所有排队的读者都能进入。
        this.readGate.Signal();
    }

    /// <summary>释放共享访问。</summary>
    void ExitRead() {
        this.readers = this.readers - 1;
        if (this.readers == 0) {
            this.writeGate.Signal();
        }
    }

    /// <summary>获取排他（写）访问；挂起直到所有读线程
    /// 以及当前写线程都释放。</summary>
    async void EnterWrite() {
        this.writersWaiting = this.writersWaiting + 1;
        while (this.writer || this.readers > 0) {
            await this.writeGate.Wait();
        }
        this.writersWaiting = this.writersWaiting - 1;
        this.writer = true;
    }

    /// <summary>释放排他访问，先唤醒排队的写线程，
    /// 然后唤醒排队的读线程。</summary>
    void ExitWrite() {
        this.writer = false;
        this.writeGate.Signal();
        this.readGate.Signal();
    }

    /// <summary>当前读线程数（诊断用）。</summary>
    int ReaderCount() { return this.readers; }

    /// <summary>当前是否有写线程持有锁（诊断用）。</summary>
    bool IsWriteLocked() { return this.writer; }

    /// <summary>释放读/写两个门的底层句柄（锁废弃时调用）。</summary>
    void Close() {
        this.readGate.Close();
        this.writeGate.Close();
    }
}
