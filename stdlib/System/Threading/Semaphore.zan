using System;
using System.Platform;

namespace System.Threading;

// 跨平台信号量。
// 平台实现已完全下沉至 PAL (System.Platform)，按目标平台分别封装：
// Windows (CreateSemaphoreA / WaitForSingleObject)、macOS (GCD dispatch_semaphore)、Linux (sem_t / sem_timedwait)。
public class Semaphore {
    // 创建信号量：initialCount 初始许可，maxCount 上限（Windows 强制上限，POSIX/GCD 语义对齐）。
    public static nint Create(int initialCount, int maxCount) {
        return Pal.Threading.CreateSemaphore(initialCount, maxCount);
    }

    // 无限阻塞获取一个许可（配对 Release）。
    public static void Wait(nint handle) {
        Pal.Threading.WaitSemaphore(handle);
    }

    // 最多等待 `timeoutMs` 毫秒获取一个许可。
    // 获取到返回 true；超时返回 false（此时不消耗许可）。
    // 负超时无限等待，0 则轮询。
    public static bool WaitFor(nint handle, int timeoutMs) {
        return Pal.Threading.WaitForSemaphore(handle, timeoutMs);
    }

    // 归还一个许可。
    public static void Release(nint handle) {
        Pal.Threading.ReleaseSemaphore(handle);
    }

    // 销毁并释放原生句柄或内存。
    public static void Destroy(nint handle) {
        Pal.Threading.DestroySemaphore(handle);
    }
}
