using System;
using System.Platform;

namespace System.Threading;

// 跨平台信号量。
// 平台实现已完全下沉至 PAL (System.Platform)，按目标平台分别封装：
// Windows (CreateSemaphoreA / WaitForSingleObject)、macOS (GCD dispatch_semaphore)、Linux (sem_t / sem_timedwait)。
public class Semaphore : IDisposable {
    private nint handle;
    private bool disposed;
    private int activeOps;

    // 实例构造：创建具有指定初始许可和上限的信号量。
    public Semaphore(int initialCount, int maxCount) {
        if (initialCount < 0 || maxCount <= 0 || initialCount > maxCount) {
            throw new ArgumentOutOfRangeException("initialCount", "initialCount must be in [0, maxCount] and maxCount > 0");
        }
        this.handle = Pal.Threading.CreateSemaphore(initialCount, maxCount);
        if (this.handle == 0) {
            throw new InvalidOperationException("Failed to create Semaphore");
        }
        this.disposed = false;
        this.activeOps = 0;
    }

    private nint AcquireHandle() {
        lock (this) {
            if (this.disposed || this.handle == 0) {
                throw new ObjectDisposedException("Semaphore");
            }
            this.activeOps = this.activeOps + 1;
            return this.handle;
        }
    }

    private void ReleaseHandleRef() {
        nint toDestroy = 0;
        lock (this) {
            if (this.activeOps > 0) {
                this.activeOps = this.activeOps - 1;
            }
            if (this.disposed && this.activeOps == 0 && this.handle != 0) {
                toDestroy = this.handle;
                this.handle = 0;
            }
        }
        if (toDestroy != 0) {
            Pal.Threading.DestroySemaphore(toDestroy);
        }
    }

    // 无限阻塞获取一个许可。
    public void WaitOne() {
        nint h = this.AcquireHandle();
        try {
            Pal.Threading.WaitSemaphore(h);
        } finally {
            this.ReleaseHandleRef();
        }
    }

    // 最多等待 `timeoutMs` 毫秒获取一个许可。
    // 获取到返回 true；超时返回 false（此时不消耗许可）。
    // 负超时无限等待，0 则轮询。
    public bool WaitOne(int timeoutMs) {
        nint h = this.AcquireHandle();
        try {
            return Pal.Threading.WaitForSemaphore(h, timeoutMs);
        } finally {
            this.ReleaseHandleRef();
        }
    }

    // 归还一个许可。
    public void Release() {
        nint h = this.AcquireHandle();
        try {
            Pal.Threading.ReleaseSemaphore(h);
        } finally {
            this.ReleaseHandleRef();
        }
    }

    // 释放信号量底层原生句柄与资源。
    public void Dispose() {
        nint toDestroy = 0;
        lock (this) {
            if (!this.disposed) {
                this.disposed = true;
                if (this.activeOps == 0 && this.handle != 0) {
                    toDestroy = this.handle;
                    this.handle = 0;
                }
            }
        }
        if (toDestroy != 0) {
            Pal.Threading.DestroySemaphore(toDestroy);
        }
    }

    // 底层原生句柄（只读访问）
    public nint Handle {
        get {
            return this.handle;
        }
    }

    // ---- 兼容裸句柄过程式 API ----

    // 创建信号量：initialCount 初始许可，maxCount 上限（Windows 强制上限，POSIX/GCD 语义对齐）。
    public static nint Create(int initialCount, int maxCount) {
        return Pal.Threading.CreateSemaphore(initialCount, maxCount);
    }

    // 无限阻塞获取一个许可（配对 Release）。
    public static void Wait(nint handle) {
        Pal.Threading.WaitSemaphore(handle);
    }

    // 最多等待 `timeoutMs` 毫秒获取一个许可。
    // 获取到返回 true；超时返回 false（此时不消耗许可）。
    // 负超时无限等待，0 则轮询。
    public static bool WaitFor(nint handle, int timeoutMs) {
        return Pal.Threading.WaitForSemaphore(handle, timeoutMs);
    }

    // 归还一个许可。
    public static void Release(nint handle) {
        Pal.Threading.ReleaseSemaphore(handle);
    }

    // 销毁并释放原生句柄或内存。
    public static void Destroy(nint handle) {
        Pal.Threading.DestroySemaphore(handle);
    }
}
