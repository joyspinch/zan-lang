using System;

namespace System.Threading;

// 事件驱动的协程等待/通知原语（异步条件变量）。
// 复用 <see cref="Gate"/> 的运行时票据。等待方挂起在调度器上，
// 由 Signal、SignalAll 或 Close 唤醒。等待前发出的信号
// 会被记账（计数语义），因此
// <code>while (!ready) { await gate.Wait(); }</code> 式的重查惯用法不会丢失唤醒。
// （取代了早期的回环 self-pipe 实现，后者需要
// 阻塞式套接字配置，且会在空闲连接上产生虚假唤醒。）
public class AsyncGate : IDisposable {
    public long handle;

    public AsyncGate() {
        this.handle = Gate.zan_gate_new();
    }

    // 句柄是否仍可用（未 Close）；与"是否已 Signal"无关（Gate.IsValid 的旧名）。
    public bool IsOpen() {
        lock (this) {
            return this.handle != 0;
        }
    }

    // Close 之后的新等待返回 false，已经登记的等待仍会唤醒。
    public async bool Wait() {
        long h = 0;
        long ticket = 0;
        lock (this) {
            h = this.handle;
            if (h == 0) { return false; }
            ticket = Gate.zan_gate_prepare(h);
        }
        if (ticket == 0) { return false; }
        await Gate.Park(h, ticket);
        return true;
    }

    // 唤醒一个等待者；无等待者时暂存一次信号。
    public void Signal() {
        lock (this) {
            if (this.handle != 0) {
                Gate.zan_gate_signal(this.handle);
            }
        }
    }

    // 唤醒全部等待者（Monitor.PulseAll 口径）；无等待者时暂存一次信号。
    public void SignalAll() {
        lock (this) {
            if (this.handle != 0) {
                Gate.zan_gate_signal_all(this.handle);
            }
        }
    }

    // 释放运行时句柄；此后的 Wait 立即返回 false。
    public void Close() {
        long h = 0;
        lock (this) {
            if (this.handle == 0) { return; }
            h = this.handle;
            this.handle = 0;
        }
        Gate.zan_gate_free(h);
    }

    // 实现 IDisposable 接口，与 Close 语义对齐
    public void Dispose() {
        this.Close();
    }
}
