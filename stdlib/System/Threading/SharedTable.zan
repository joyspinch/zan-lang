using System;

namespace System.Threading;

// 由命名共享内存支持的固定容量、固定模式的哈希表。
// 每个操作在线程与进程间都是原子的。
public class SharedTable : IDisposable {
    nint handle;
    string tableName;
    int tableCapacity;
    int tableKeySize;
    string tableSchema;
    string tableLabel;

    // 当前进程映射的所有共享内存表清单（按句柄索引），供监控看板查询。
    static List<SharedTableEntry> openEntries = null;

    [DllImport("crt", EntryPoint = "zan_shared_table_create")]
    static extern nint NativeCreate(string name, int capacity, int keySize, string schema);

    [DllImport("crt", EntryPoint = "zan_shared_table_open")]
    static extern nint NativeOpen(string name);

    [DllImport("crt", EntryPoint = "zan_shared_table_create_anon")]
    static extern nint NativeCreateAnon(int capacity, int keySize, string schema);

    [DllImport("crt", EntryPoint = "zan_shared_table_handle")]
    static extern long NativeOsHandle(nint handle);

    [DllImport("crt", EntryPoint = "zan_shared_table_attach")]
    static extern nint NativeAttach(long osHandle);

    [DllImport("crt", EntryPoint = "zan_shared_table_close")]
    static extern void NativeClose(nint handle);

    [DllImport("crt", EntryPoint = "zan_shared_table_destroy")]
    static extern int NativeDestroy(nint handle);

    [DllImport("crt", EntryPoint = "zan_shared_table_set_int")]
    static extern int NativeSetInt(nint handle, string key, string column, long newValue);

    [DllImport("crt", EntryPoint = "zan_shared_table_get_int")]
    static extern long NativeGetInt(nint handle, string key, string column);

    [DllImport("crt", EntryPoint = "zan_shared_table_set_float")]
    static extern int NativeSetFloat(nint handle, string key, string column, double newValue);

    [DllImport("crt", EntryPoint = "zan_shared_table_get_float")]
    static extern double NativeGetFloat(nint handle, string key, string column);

    [DllImport("crt", EntryPoint = "zan_shared_table_set_string")]
    static extern int NativeSetString(nint handle, string key, string column, string newValue);

    [DllImport("crt", EntryPoint = "zan_shared_table_get_string")]
    static extern string NativeGetString(nint handle, string key, string column);

    [DllImport("crt", EntryPoint = "zan_shared_table_increment")]
    static extern long NativeIncrement(nint handle, string key, string column, long delta);

    [DllImport("crt", EntryPoint = "zan_shared_table_expire")]
    static extern int NativeExpire(nint handle, string key, long ttlMs);

    [DllImport("crt", EntryPoint = "zan_shared_table_expire_at")]
    static extern int NativeExpireAt(nint handle, string key, long unixMs);

    [DllImport("crt", EntryPoint = "zan_shared_table_expires_at")]
    static extern long NativeExpiresAt(nint handle, string key);

    [DllImport("crt", EntryPoint = "zan_shared_table_purge_expired")]
    static extern long NativePurgeExpired(nint handle, long nowMs);

    [DllImport("crt", EntryPoint = "zan_shared_table_rate_allow")]
    static extern int NativeRateAllow(
        nint handle, string key, long nowMs, long windowMs, long limit);

    [DllImport("crt", EntryPoint = "zan_shared_table_lock_acquire")]
    static extern int NativeLockAcquire(
        nint handle, string key, long owner, long nowMs, long leaseMs);

    [DllImport("crt", EntryPoint = "zan_shared_table_lock_release")]
    static extern int NativeLockRelease(nint handle, string key, long owner);

    [DllImport("crt", EntryPoint = "zan_shared_table_delete")]
    static extern int NativeDelete(nint handle, string key);

    [DllImport("crt", EntryPoint = "zan_shared_table_exists")]
    static extern int NativeExists(nint handle, string key);

    [DllImport("crt", EntryPoint = "zan_shared_table_count")]
    static extern long NativeCount(nint handle);

    [DllImport("crt", EntryPoint = "zan_shared_table_clear")]
    static extern void NativeClear(nint handle);

    [DllImport("crt", EntryPoint = "zan_shared_table_hash")]
    static extern long NativeHash(string text);

    [DllImport("crt", EntryPoint = "zan_shared_table_stat")]
    static extern long NativeStat(nint handle, int what);

    [DllImport("crt", EntryPoint = "zan_shared_table_set_int_at")]
    static extern int NativeSetIntAt(nint handle, long keyHash, string column, long newValue);

    [DllImport("crt", EntryPoint = "zan_shared_table_get_int_at")]
    static extern long NativeGetIntAt(nint handle, long keyHash, string column);

    [DllImport("crt", EntryPoint = "zan_shared_table_increment_at")]
    static extern long NativeIncrementAt(nint handle, long keyHash, string column, long delta);

    [DllImport("crt", EntryPoint = "zan_shared_table_extreme_at")]
    static extern long NativeExtremeAt(
        nint handle, long keyHash, string column, long newValue, long keepLarger);

    [DllImport("crt", EntryPoint = "zan_shared_table_set_string_at")]
    static extern int NativeSetStringAt(nint handle, long keyHash, string column, string newValue);

    [DllImport("crt", EntryPoint = "zan_shared_table_get_string_at")]
    static extern string NativeGetStringAt(nint handle, long keyHash, string column);

    [DllImport("crt", EntryPoint = "zan_shared_table_match_at")]
    static extern int NativeMatchAt(nint handle, long keyHash, string column, string text);

    [DllImport("crt", EntryPoint = "zan_shared_table_exists_at")]
    static extern int NativeExistsAt(nint handle, long keyHash);

    [DllImport("crt", EntryPoint = "zan_shared_table_delete_at")]
    static extern int NativeDeleteAt(nint handle, long keyHash);

    // 创建一张未打开的表对象；随后用 KeySize/Column* 声明结构，
    // 再 Create/Open。
    public SharedTable(string name, int capacity) {
        this.handle = 0;
        this.tableName = name;
        this.tableCapacity = capacity;
        this.tableKeySize = 64;
        this.tableSchema = "";
        this.tableLabel = name;
    }

    // 给这张表一个便于识别的名字，用于状态输出。匿名表没有
    // 名字，不设置就显示为 "(anonymous)"。
    public void Label(string text) {
        this.tableLabel = text;
        if (this.handle != 0) {
            Track(this);
        }
    }

    // 把已打开的表登记进本进程的打开表列表（Create/Open/Attach/Label
    // 都会走到；重复登记只更新标签）。
    private static void Track(SharedTable table) {
        if (table.handle == 0) { return; }
        if (SharedTable.openEntries == null) {
            SharedTable.openEntries = new List<SharedTableEntry>();
        }
        string label = table.tableLabel;
        if (label == "") { label = "(anonymous)"; }
        for (int i = 0; i < SharedTable.openEntries.Count; i = i + 1) {
            if (SharedTable.openEntries[i].handle == table.handle) {
                SharedTable.openEntries[i].label = label;
                return;
            }
        }
        SharedTable.openEntries.Add(new SharedTableEntry(table.handle, label));
    }

    // 把句柄从本进程的打开表列表移除。
    private static void Untrack(nint handle) {
        if (SharedTable.openEntries == null) { return; }
        for (int i = 0; i < SharedTable.openEntries.Count; i = i + 1) {
            if (SharedTable.openEntries[i].handle == handle) {
                SharedTable.openEntries.RemoveAt(i);
                return;
            }
        }
    }

    // 析构兜底：未显式 Close 时在此关闭映射；正常路径仍应显式 Close。
    ~SharedTable() {
        Close();
    }

    public void Dispose() {
        Close();
    }

    // 键的最大字节数（Create 前设置；默认 64）。
    public void KeySize(int size) {
        this.tableKeySize = size;
    }

    // 声明一个整型列（Create 前调用）。
    public void ColumnInt(string name) {
        this.tableSchema = this.tableSchema + "i:" + name + ";";
    }

    // 声明一个浮点列（Create 前调用）。
    public void ColumnFloat(string name) {
        this.tableSchema = this.tableSchema + "f:" + name + ";";
    }

    // 声明一个定长字符串列，`size` 为最大字节数（Create 前调用）。
    public void ColumnString(string name, int size) {
        this.tableSchema = this.tableSchema + "s:" +
            Convert.ToString(size) + ":" + name + ";";
    }

    // 按已声明的名字/容量/键宽/列结构创建共享表。
    public bool Create() {
        if (this.handle != 0) {
            return false;
        }
        this.handle = NativeCreate(
            this.tableName, this.tableCapacity, this.tableKeySize, this.tableSchema);
        Track(this);
        return this.handle != 0;
    }

    // 打开本机上一张按名字创建的共享表（先 Create 成功的另一
    // 进程/本进程再打开）。失败时返回未打开的表（IsOpen()=false）。
    public static SharedTable Open(string name) {
        SharedTable table = new SharedTable(name, 1);
        table.handle = NativeOpen(name);
        Track(table);
        return table;
    }

    // 建一张匿名表：不占用任何全局命名空间，机器上的其它程序
    // 既打不开也读不到，也不会在文件系统里留下东西——最后一个引用消失
    // （包括进程被强杀）内核就回收。子进程要用它，只能由建表的进程把
    // OsHandle() 传下去（子进程继承该句柄/描述符），再用 Attach() 映射
    // 同一块内存，就像 fork 出来的那样。
    // // 因此必须在派生子进程之前建好：之后才建的表，已有的子进程拿不到。
    public bool CreateAnonymous() {
        if (this.handle != 0) {
            return false;
        }
        this.handle = NativeCreateAnon(
            this.tableCapacity, this.tableKeySize, this.tableSchema);
        Track(this);
        return this.handle != 0;
    }

    // 匿名表要交给子进程的句柄（POSIX 是文件描述符，Windows 是
    // 可继承 HANDLE）。按名字建的表返回 0：它本来就按名字打开。
    public long OsHandle() {
        return NativeOsHandle(this.handle);
    }

    // 子进程侧：映射父进程建好并继承下来的匿名表。表的结构写在
    // 内存自身的头部，所以不用重复声明列；句柄不是一张本版本的表时返回
    // 未打开的表。
    public static SharedTable Attach(long osHandle) {
        SharedTable table = new SharedTable("", 1);
        table.handle = NativeAttach(osHandle);
        Track(table);
        return table;
    }

    // 表是否已成功创建/打开/附加。
    public bool IsOpen() {
        return this.handle != 0;
    }

    // 关闭本进程的映射；底层具名表仍然存在，其他进程不受影响。
    public void Close() {
        if (this.handle != 0) {
            nint current = this.handle;
            this.handle = 0;
            Untrack(current);
            NativeClose(current);
        }
    }

    // 关闭并销毁底层具名表（匿名表随引用消失，无需 Destroy）。
    public bool Destroy() {
        if (this.handle == 0) {
            return false;
        }
        nint current = this.handle;
        this.handle = 0;
        Untrack(current);
        return NativeDestroy(current) != 0;
    }

    // 写整型列；键或列不存在时返回 false。
    public bool SetInt(string key, string column, long newValue) {
        return NativeSetInt(this.handle, key, column, newValue) != 0;
    }

    // 读整型列；键不存在返回 0。
    public long GetInt(string key, string column) {
        return NativeGetInt(this.handle, key, column);
    }

    // 写浮点列。
    public bool SetFloat(string key, string column, double newValue) {
        return NativeSetFloat(this.handle, key, column, newValue) != 0;
    }

    // 读浮点列。
    public double GetFloat(string key, string column) {
        return NativeGetFloat(this.handle, key, column);
    }

    // 写字符串列。
    public bool SetString(string key, string column, string newValue) {
        return NativeSetString(this.handle, key, column, newValue) != 0;
    }

    // 读字符串列；键不存在返回 ""。
    public string GetString(string key, string column) {
        string text = NativeGetString(this.handle, key, column);
        return text.Substring(0, text.Length);
    }

    // 原子加 delta（跨线程/进程），返回加后的新值。
    public long Increment(string key, string column, long delta) {
        return NativeIncrement(this.handle, key, column, delta);
    }

    // 原子减 delta（Increment 的取负快捷方式）。
    public long Decrement(string key, string column, long delta) {
        return NativeIncrement(this.handle, key, column, -delta);
    }

    // 给键设置 TTL：ttlMs 毫秒后过期。
    public bool Expire(string key, long ttlMs) {
        return NativeExpire(this.handle, key, ttlMs) != 0;
    }

    // 给键设置绝对过期时间（Unix 毫秒）。
    public bool ExpireAt(string key, long unixMs) {
        return NativeExpireAt(this.handle, key, unixMs) != 0;
    }

    // 移除键的过期时间（永不过期）。
    public bool Persist(string key) {
        return NativeExpireAt(this.handle, key, 0) != 0;
    }

    // 键的绝对过期时间（Unix 毫秒；无 TTL = 0）。
    public long ExpiresAt(string key) {
        return NativeExpiresAt(this.handle, key);
    }

    // 清理此刻已过期的键，返回清理的行数。
    public long PurgeExpired(long nowMs) {
        return NativePurgeExpired(this.handle, nowMs);
    }

    // 固定窗口限流：`windowMs` 窗口内第 limit+1 次起拒绝。
    // 允许返回 true（并计数）。跨进程原子。
    public bool RateAllow(string key, long nowMs, long windowMs, long limit) {
        return NativeRateAllow(this.handle, key, nowMs, windowMs, limit) != 0;
    }

    // 尝试获取键上的租约锁：`leaseMs` 内不续租自动过期。
    // owner 用于归属校验（谁加的锁谁解）。
    public bool TryAcquireLease(string key, long owner, long nowMs, long leaseMs) {
        return NativeLockAcquire(this.handle, key, owner, nowMs, leaseMs) != 0;
    }

    // 释放 owner 持有的租约锁。
    public bool ReleaseLease(string key, long owner) {
        return NativeLockRelease(this.handle, key, owner) != 0;
    }

    // 删除键。
    public bool Delete(string key) {
        return NativeDelete(this.handle, key) != 0;
    }

    // 键是否存在。
    public bool Exists(string key) {
        return NativeExists(this.handle, key) != 0;
    }

    // 当前行数。
    public int Count() {
        return (int)NativeCount(this.handle);
    }

    // 清空所有行（保留结构与容量）。
    public void Clear() {
        NativeClear(this.handle);
    }

    // ---- 内存占用 ----
    // 表在创建时就按容量预留了整块映射，但一页只有在有行落在上面时
    // 才会真正进入物理内存。因此「预留」远大于「占用」是正常的：
    // 报告内存时必须用 Resident，而不是 Reserved。

    // Stat 项：整块映射的预留大小（字节）。
    static int STAT_RESERVED = 0;
    // Stat 项：本进程驻留物理内存的部分（字节），不支持时为 -1。
    static int STAT_RESIDENT = 1;
    // Stat 项：表的行容量（向上取整到 2 的幂）。
    static int STAT_CAPACITY = 2;
    // Stat 项：当前行数。
    static int STAT_COUNT = 3;
    // Stat 项：每行字节数（键 + 各列 + 行头）。
    static int STAT_ROW_STRIDE = 4;
    // Stat 项：键的最大字节数。
    static int STAT_KEY_SIZE = 5;
    // Stat 项：列数。
    static int STAT_COLUMNS = 6;

    // 整块映射的大小（预留的虚拟地址空间，不是内存占用）。
    public long ReservedBytes() {
        return NativeStat(this.handle, SharedTable.STAT_RESERVED);
    }

    // 本进程真正驻留在物理内存中的部分；平台不支持时为 -1。
    public long ResidentBytes() {
        return NativeStat(this.handle, SharedTable.STAT_RESIDENT);
    }

    // 表能容纳的行数（向上取整到 2 的幂）。
    public int Capacity() {
        return (int)NativeStat(this.handle, SharedTable.STAT_CAPACITY);
    }

    // 每行占用的字节数（键 + 各列 + 行头）。
    public int RowStride() {
        return (int)NativeStat(this.handle, SharedTable.STAT_ROW_STRIDE);
    }

    // 键的最大字节数。
    public int KeyBytes() {
        return (int)NativeStat(this.handle, SharedTable.STAT_KEY_SIZE);
    }

    // 列数。
    public int ColumnCount() {
        return (int)NativeStat(this.handle, SharedTable.STAT_COLUMNS);
    }

    // ---- 本进程映射的所有表 ----

    // 本进程当前映射着的共享表数量。
    public static int OpenCount() {
        if (SharedTable.openEntries == null) { return 0; }
        return SharedTable.openEntries.Count;
    }

    // 第 `index` 张表的标签（Label() 设置的名字）。
    public static string OpenLabel(int index) {
        if (SharedTable.openEntries == null) { return ""; }
        if (index < 0 || index >= SharedTable.openEntries.Count) { return ""; }
        return SharedTable.openEntries[index].label;
    }

    // 第 `index` 张表的某项统计，取值见 STAT_* 常量。
    public static long OpenStat(int index, int what) {
        if (SharedTable.openEntries == null) { return 0; }
        if (index < 0 || index >= SharedTable.openEntries.Count) { return 0; }
        return NativeStat(SharedTable.openEntries[index].handle, what);
    }

    // 左对齐补空格到 width 宽，再追加一个空格作列间隔。
    public static string StatPad(string s, int width) {
        string t = s;
        while (t.Length < width) { t = t + " "; }
        return t + " ";
    }

    // 字节数的人类可读形式（B/KB/MB，整除截断）；负数返回 "n/a"。
    public static string StatBytes(long bytes) {
        if (bytes < 0) { return "n/a"; }
        if (bytes < 1024) { return Convert.ToString(bytes) + "B"; }
        if (bytes < 1048576) {
            return Convert.ToString(bytes / 1024) + "KB";
        }
        return Convert.ToString(bytes / 1048576) + "MB";
    }

    // 本进程所有共享表的一张文本表格：行数、每行大小、预留的
    // 映射大小，以及真正驻留在内存中的部分。
    public static string StatusText() {
        StringBuilder sb = new StringBuilder();
        sb.Append(StatPad("shared table", 24) + StatPad("rows", 16)
            + StatPad("row size", 10) + StatPad("reserved", 12)
            + "in memory\n");
        int n = SharedTable.OpenCount();
        if (n == 0) {
            sb.Append("(none)\n");
            return sb.ToString();
        }
        long totalReserved = 0;
        long totalResident = 0;
        for (int i = 0; i < n; i = i + 1) {
            long reserved = SharedTable.OpenStat(i, SharedTable.STAT_RESERVED);
            long resident = SharedTable.OpenStat(i, SharedTable.STAT_RESIDENT);
            totalReserved = totalReserved + reserved;
            if (resident > 0) { totalResident = totalResident + resident; }
            string rows = Convert.ToString(
                    SharedTable.OpenStat(i, SharedTable.STAT_COUNT))
                + "/" + Convert.ToString(
                    SharedTable.OpenStat(i, SharedTable.STAT_CAPACITY));
            sb.Append(StatPad(SharedTable.OpenLabel(i), 24)
                + StatPad(rows, 16)
                + StatPad(Convert.ToString(
                    SharedTable.OpenStat(i, SharedTable.STAT_ROW_STRIDE)), 10)
                + StatPad(SharedTable.StatBytes(reserved), 12)
                + SharedTable.StatBytes(resident) + "\n");
        }
        sb.Append(StatPad("total", 24) + StatPad("", 16) + StatPad("", 10)
            + StatPad(SharedTable.StatBytes(totalReserved), 12)
            + SharedTable.StatBytes(totalResident) + "\n");
        return sb.ToString();
    }

    // ---- 按预计算哈希寻址的行 ----
    // 请求处理器只需哈希一次键（如 "GET_/user/list"），并将该值
    // 传给其接触的每个表，这样键永远不会被格式化成
    // 字符串，也不比较任何键字节。行随后仅由哈希标识：
    // 使用表时要么按键要么按哈希，不可混用；若冲突可能造成危险，
    // 就把原始文本保留在一个列中。

    // 用与表相同的方式哈希键（FNV-1a，64 位）。
    public static long Hash(string text) {
        return NativeHash(text);
    }

    // 按哈希写整型列。
    public bool SetIntAt(long keyHash, string column, long newValue) {
        return NativeSetIntAt(this.handle, keyHash, column, newValue) != 0;
    }

    // 按哈希读整型列。
    public long GetIntAt(long keyHash, string column) {
        return NativeGetIntAt(this.handle, keyHash, column);
    }

    // 按哈希原子加 delta。
    public long IncrementAt(long keyHash, string column, long delta) {
        return NativeIncrementAt(this.handle, keyHash, column, delta);
    }

    // 若 `newValue` 小于当前值则存入（0 视为未设置），
    // 一步原子完成。用于记录“目前最快响应”。
    public long MinAt(long keyHash, string column, long newValue) {
        return NativeExtremeAt(this.handle, keyHash, column, newValue, 0);
    }

    // 若 `newValue` 大于当前值则存入，
    // 一步原子完成。用于记录“目前最慢响应”。
    public long MaxAt(long keyHash, string column, long newValue) {
        return NativeExtremeAt(this.handle, keyHash, column, newValue, 1);
    }

    // 按哈希写字符串列。
    public bool SetStringAt(long keyHash, string column, string newValue) {
        return NativeSetStringAt(this.handle, keyHash, column, newValue) != 0;
    }

    // 按哈希读字符串列。
    public string GetStringAt(long keyHash, string column) {
        string text = NativeGetStringAt(this.handle, keyHash, column);
        return text.Substring(0, text.Length);
    }

    // 判断某字符串列是否等于 `text`，不把
    // 存储的字节复制出来。否则每次查找校验键的原始文本都会
    // 为每次调用分配一个字符串。
    public bool MatchAt(long keyHash, string column, string text) {
        return NativeMatchAt(this.handle, keyHash, column, text) != 0;
    }

    // 哈希寻址的键是否存在。
    public bool ExistsAt(long keyHash) {
        return NativeExistsAt(this.handle, keyHash) != 0;
    }

    // 删除哈希寻址的键。
    public bool DeleteAt(long keyHash) {
        return NativeDeleteAt(this.handle, keyHash) != 0;
    }
}
