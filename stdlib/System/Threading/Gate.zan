using System;

namespace System.Threading;

// 事件驱动的协程等待/通知原语，直接由
// 运行时调度器支撑（见 src/runtime/rt_io.c 的 zan_gate_*）。等待方
// 真正挂起——无定时器、无 <c>Task.Delay</c> 轮询——
// 并且仅当另一个协程调用
// <see cref="Signal"/> 时才经由就绪队列重新就绪。
// 计数 / 条件变量语义：无等待方挂起时发出的 <see cref="Signal"/>
// 会被暂存，因此下一次 <see cref="Wait"/>
// 无需阻塞即可返回。这使得标准的重新检查写法安全：
// 既不会丢失唤醒，也不会忙轮询。
public class Gate : IDisposable {
    public long handle;

    public Gate() {
        this.handle = Gate.zan_gate_new();
    }

    // 门是否还持有一个可用的运行时句柄（即尚未 <see cref="Close"/>）。
    public bool IsValid() {
        lock (this) {
            return this.handle != 0;
        }
    }

    // 挂起直到有人 Signal（暂存信号可立即消费）；门已 Close 时返回 false。
    public async bool Wait() {
        long h = 0;
        long ticket = 0;
        lock (this) {
            h = this.handle;
            if (h == 0) { return false; }
            ticket = Gate.zan_gate_prepare(h);
        }
        if (ticket == 0) { return false; }
        await Gate.Park(h, ticket);
        return true;
    }

    // 带超时的等待：至多 <paramref name="timeoutMs"/> 毫秒后必然恢复。
    // 超时看门狗仅捕获标量票据与句柄（零托管对象捕获、零 ARC 泄露）；
    // 到期后运行时核对等待队列票据精准唤醒，绝不向 surplus 写入幽灵盈余信号。
    // timeoutMs <= 0 时退化为无超时等待。
    public async bool Wait(int timeoutMs) {
        long h = 0;
        long ticket = 0;
        lock (this) {
            h = this.handle;
            if (h == 0) { return false; }
            if (timeoutMs > 0) {
                ticket = Gate.zan_gate_arm(h);
            } else {
                ticket = Gate.zan_gate_prepare(h);
            }
        }
        if (ticket == 0) { return false; }
        if (timeoutMs > 0) {
            Task.Spawn(Gate.Watchdog(h, ticket, timeoutMs));
        }
        await Gate.Park(h, ticket);
        return true;
    }

    // 超时看门狗：仅捕获纯标量（句柄、票据、毫秒），不持有任何托管对象引用，
    // 零 ARC 泄露；到期后由运行时核对票据精准唤醒对应等待者，无等待者时不注入盈余信号。
    private static async void Watchdog(long handle, long ticket, int timeoutMs) {
        await Task.Delay(timeoutMs);
        Gate.zan_gate_ticket_signal_and_release(handle, ticket);
    }

    // 唤醒一个等待者；无等待者时暂存一次信号（计数语义）。
    public void Signal() {
        lock (this) {
            if (this.handle != 0) {
                Gate.zan_gate_signal(this.handle);
            }
        }
    }

    // 唤醒当前挂在门上的全部等待者（Monitor.PulseAll 口径）。
    // 无等待者时与 <see cref="Signal"/> 同口径暂存一次信号。
    public void SignalAll() {
        lock (this) {
            if (this.handle != 0) {
                Gate.zan_gate_signal_all(this.handle);
            }
        }
    }

    // 释放运行时句柄；此后的 Wait 立即返回 false。
    public void Close() {
        long h = 0;
        lock (this) {
            if (this.handle == 0) { return; }
            h = this.handle;
            this.handle = 0;
        }
        Gate.zan_gate_free(h);
    }

    // 实现 IDisposable 接口，与 Close 语义对齐
    public void Dispose() {
        this.Close();
    }

    // 运行时门句柄（0 = 已 Close）。
    public long Handle() {
        lock (this) {
            return this.handle;
        }
    }

    // 运行时 ABI（从 socket 异步 reactor 对象解析）。`Park` 是
    // 编译器的 await 内建（见 irgen.c），故意没有函数体。
    [DllImport("crt", EntryPoint = "zan_gate_new")]
    public static extern long zan_gate_new();
    [DllImport("crt", EntryPoint = "zan_gate_arm")]
    public static extern long zan_gate_arm(long h);
    [DllImport("crt", EntryPoint = "zan_gate_prepare")]
    internal static extern long zan_gate_prepare(long h);
    [DllImport("crt", EntryPoint = "zan_gate_signal")]
    public static extern void zan_gate_signal(long h);
    [DllImport("crt", EntryPoint = "zan_gate_signal_all")]
    public static extern void zan_gate_signal_all(long h);
    [DllImport("crt", EntryPoint = "zan_gate_free")]
    public static extern void zan_gate_free(long h);
    [DllImport("crt", EntryPoint = "zan_gate_ticket_signal_and_release")]
    public static extern void zan_gate_ticket_signal_and_release(long h, long ticket);
}
