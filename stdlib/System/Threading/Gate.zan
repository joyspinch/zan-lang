using System;

namespace System.Threading;

/// <summary>
/// 事件驱动的协程等待/通知原语，直接由
/// 运行时调度器支撑（见 src/runtime/rt_io.c 的 zan_gate_*）。等待方
/// 真正挂起——无定时器、无 <c>Task.Delay</c> 轮询——
/// 并且仅当另一个协程调用
/// <see cref="Signal"/> 时才经由就绪队列重新就绪。
///
/// 计数 / 条件变量语义：无等待方挂起时发出的 <see cref="Signal"/>
/// 会被暂存，因此下一次 <see cref="Wait"/>
/// 无需阻塞即可返回。这使得标准的重新检查写法安全：
/// <code>while (!available) { await gate.Wait(); }</code>
/// 既不会丢失唤醒，也不会忙轮询。
/// </summary>
class Gate {
    long handle;

    Gate() {
        this.handle = Gate.zan_gate_new();
    }

    /// <summary>门是否还持有一个可用的运行时句柄（即尚未
    /// <see cref="Close"/>）。这与"是否已 Signal"无关：刚 new 出来的门
    /// 就是 true，暂存的信号数不可查询。</summary>
    bool IsValid() { return this.handle != 0; }

    /// <summary><see cref="IsValid"/> 的旧名字。保留是为了兼容，
    /// 它从来就不表示"已打开/已 Signal"。</summary>
    bool IsOpen() { return this.IsValid(); }

    async bool Wait() {
        if (this.handle == 0) { return false; }
        await Gate.Park(this.handle);
        return true;
    }

    void Signal() {
        if (this.handle == 0) { return; }
        Gate.zan_gate_signal(this.handle);
    }

    void Close() {
        if (this.handle == 0) { return; }
        Gate.zan_gate_free(this.handle);
        this.handle = 0;
    }

    long Handle() { return this.handle; }

    // 运行时 ABI（从 socket 异步 reactor 对象解析）。`Park` 是
    // 编译器的 await 内建（见 irgen.c），故意没有函数体。
    [DllImport("crt", EntryPoint = "zan_gate_new")]
    static extern long zan_gate_new();
    [DllImport("crt", EntryPoint = "zan_gate_signal")]
    static extern void zan_gate_signal(long h);
    [DllImport("crt", EntryPoint = "zan_gate_free")]
    static extern void zan_gate_free(long h);
}
