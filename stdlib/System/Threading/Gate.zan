using System;

namespace System.Threading;

/// <summary>
/// 事件驱动的协程等待/通知原语，直接由
/// 运行时调度器支撑（见 src/runtime/rt_io.c 的 zan_gate_*）。等待方
/// 真正挂起——无定时器、无 <c>Task.Delay</c> 轮询——
/// 并且仅当另一个协程调用
/// <see cref="Signal"/> 时才经由就绪队列重新就绪。
///
/// 计数 / 条件变量语义：无等待方挂起时发出的 <see cref="Signal"/>
/// 会被暂存，因此下一次 <see cref="Wait"/>
/// 无需阻塞即可返回。这使得标准的重新检查写法安全：
/// <code>while (!available) { await gate.Wait(); }</code>
/// 既不会丢失唤醒，也不会忙轮询。
/// </summary>
class Gate {
    long handle;

    // B-ID64：看门狗对已 Close 的门 zan_gate_signal 是 UAF（句柄已被
    // zan_gate_free）。静态注册表记录"还活着的句柄"：Wait(timeout)
    // 先注册再挂看门狗；看门狗醒后锁内核对，在册才发信号；Close 在
    // zan_gate_free 之前锁内摘除。signal/free 都不是 await，可以在
    // 临界区内完成，与协程调度不冲突。
    static Dict<long, byte> live = new Dict<long, byte>();
    static nint liveLock = Mutex.Create();

    Gate() {
        this.handle = Gate.zan_gate_new();
    }

    /// <summary>门是否还持有一个可用的运行时句柄（即尚未
    /// <see cref="Close"/>）。这与"是否已 Signal"无关：刚 new 出来的门
    /// 就是 true，暂存的信号数不可查询。</summary>
    bool IsValid() { return this.handle != 0; }

    /// <summary><see cref="IsValid"/> 的旧名字。保留是为了兼容，
    /// 它从来就不表示"已打开/已 Signal"。</summary>
    bool IsOpen() { return this.IsValid(); }

    /// 挂起直到有人 Signal（暂存信号可立即消费）；门已 Close 时返回 false。
    async bool Wait() {
        if (this.handle == 0) { return false; }
        await Gate.Park(this.handle);
        return true;
    }

    /// <summary>带超时的等待：至多 <paramref name="timeoutMs"/> 毫秒后
    /// 必然恢复。返回 true 只表示「已恢复」，不区分是 Signal 还是超时
    /// ——调用方一律复查自己的谓词（计数语义本就要求复查循环）。
    ///
    /// 超时由看门狗协程实现：到点向本门发一次信号。落在 FIFO 头部的
    /// 等待者被唤醒——可能是调用者自己，也可能是同一门上的别人；对
    /// 「任何等待都有出口」这个目的而言足够：没有谁会永久停在门上，
    /// 丢失的 Signal 最迟 timeoutMs 后也有进展。看门狗不取消：提前
    /// 醒来时它稍后的那次 Signal 存为盈余，由下一个等待者立即消费，
    /// 无副作用。盈余路径只对"仍在册"（未 Close）的门成立：看门狗
    /// 醒后锁内查静态注册表，门已 Close（句柄已 zan_gate_free）就不
    /// 再 signal——对已释放句柄发信号是 UAF（B-ID64），注册表让这条
    /// 路径不可达。timeoutMs &lt;= 0 时退化为无限等待。</summary>
    async bool Wait(int timeoutMs) {
        if (this.handle == 0) { return false; }
        if (timeoutMs > 0) {
            Gate.LiveAdd(this.handle);
            Task.Spawn(Gate.Watchdog(this.handle, timeoutMs));
        }
        await Gate.Park(this.handle);
        return true;
    }

    /* 看门狗协程体：延迟后向句柄发一次信号，然后自然结束。 */
    /// 看门狗协程体：延迟 timeoutMs 后向仍在册的句柄发一次信号。
    static async void Watchdog(long handle, int timeoutMs) {
        await Task.Delay(timeoutMs);
        // signal 不是 await，锁内完成：与 Close 的「摘除 + free」临界区
        // 互斥——要么门还在册（信号发出，成为盈余），要么已摘除（绝不
        // 碰已 free 的句柄）。
        Mutex.Lock(Gate.liveLock);
        if (Gate.live.ContainsKey(handle)) {
            Gate.zan_gate_signal(handle);
        }
        Mutex.Unlock(Gate.liveLock);
    }

    /// 把句柄登记进存活注册表（Wait(timeout) 挂看门狗前调用）。
    static void LiveAdd(long handle) {
        Mutex.Lock(Gate.liveLock);
        Gate.live[handle] = 1;
        Mutex.Unlock(Gate.liveLock);
    }

    /// 唤醒一个等待者；无等待者时暂存一次信号（计数语义）。
    void Signal() {
        if (this.handle == 0) { return; }
        Gate.zan_gate_signal(this.handle);
    }

    /// 释放运行时句柄；此后的 Wait 立即返回 false。摘除注册与
    /// zan_gate_free 在同一临界区内完成，看门狗永远追不上一个
    /// 「已摘册但尚未 free」的中间态。
    void Close() {
        if (this.handle == 0) { return; }
        Mutex.Lock(Gate.liveLock);
        Gate.live.Remove(this.handle);
        Gate.zan_gate_free(this.handle);
        this.handle = 0;
        Mutex.Unlock(Gate.liveLock);
    }

    /// 运行时门句柄（0 = 已 Close）。
    long Handle() { return this.handle; }

    // 运行时 ABI（从 socket 异步 reactor 对象解析）。`Park` 是
    // 编译器的 await 内建（见 irgen.c），故意没有函数体。
    [DllImport("crt", EntryPoint = "zan_gate_new")]
    static extern long zan_gate_new();
    [DllImport("crt", EntryPoint = "zan_gate_signal")]
    static extern void zan_gate_signal(long h);
    [DllImport("crt", EntryPoint = "zan_gate_free")]
    static extern void zan_gate_free(long h);
}
