using System;

namespace System.Threading;

// 未观察到的异步任务异常事件参数，提供异常对象检索与标为已观察（Suppress/Mark Observed）能力。
public class UnobservedTaskExceptionEventArgs {
    Exception exception;
    bool observed;

    public UnobservedTaskExceptionEventArgs(Exception exception) {
        this.exception = exception;
        this.observed = false;
    }

    // 导致任务失败的未捕获异常。
    public Exception Exception {
        get { return this.exception; }
    }

    // 该异常是否已被上层异常治理系统标记为已观察（标记后可抑制崩溃并进行监控记账）。
    public bool Observed {
        get { return this.observed; }
        set { this.observed = value; }
    }

    // 将未观察任务异常标记为已处理。
    public void SetObserved() {
        this.observed = true;
    }
}
