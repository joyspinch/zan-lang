using System;

namespace System.Threading;

/// <summary>
/// A parameterless thread entry point. Assign a lambda or a static method
/// group: <c>Thread.Start(() =&gt; { ... })</c> or <c>Thread.Start(Worker)</c>.
/// </summary>
delegate void ThreadStart();

/// <summary>
/// Cross-platform thread and synchronization primitives.
/// Uses Win32 API on Windows, pthreads (in libc) on POSIX (Linux/macOS).
/// </summary>
class Thread {
    #if WINDOWS
    [DllImport("kernel32", EntryPoint = "Sleep")]
    static extern void PlatSleep(int milliseconds);

    [DllImport("kernel32", EntryPoint = "GetCurrentThreadId")]
    static extern int PlatGetCurrentThreadId();
    #else
    [DllImport("crt", EntryPoint = "usleep")]
    static extern int PlatUsleep(int microseconds);

    [DllImport("crt", EntryPoint = "getpid")]
    static extern int PlatGetPid();
    #endif

    [DllImport("crt", EntryPoint = "zan_thread_start")]
    static extern int PlatThreadStart(ThreadStart body);

    /// <summary>
    /// Runs <paramref name="body"/> on a new detached background thread and
    /// returns immediately. The delegate must be non-capturing (operate on
    /// static/shared state); use atomics or App.Post to hand results back to
    /// another thread safely. Returns true if the thread was started.
    /// </summary>
    static bool Start(ThreadStart body) {
        return Thread.PlatThreadStart(body) != 0;
    }

    /// <summary>Sleeps the current thread for the specified milliseconds.</summary>
    static void Sleep(int milliseconds) {
        #if WINDOWS
        PlatSleep(milliseconds);
        #else
        PlatUsleep(milliseconds * 1000);
        #endif
    }

    /// <summary>Gets the current thread's ID.</summary>
    static int CurrentId() {
        #if WINDOWS
        return PlatGetCurrentThreadId();
        #else
        return PlatGetPid();
        #endif
    }

    /// <summary>Async sleep (wrapper for Sleep).</summary>
    static void SleepAsync(int milliseconds) {
        Sleep(milliseconds);
    }
}

/// <summary>
/// Cross-platform mutex for thread synchronization.
/// </summary>
class Mutex {
    #if WINDOWS
    [DllImport("kernel32", EntryPoint = "CreateMutexA")]
    static extern nint WinCreateMutex(nint secAttrs, int initialOwner, string name);

    [DllImport("kernel32", EntryPoint = "WaitForSingleObject")]
    static extern int WinWaitForSingleObject(nint handle, int milliseconds);

    [DllImport("kernel32", EntryPoint = "ReleaseMutex")]
    static extern int WinReleaseMutex(nint handle);

    [DllImport("kernel32", EntryPoint = "CloseHandle")]
    static extern int WinCloseHandle(nint handle);
    #else
    [DllImport("crt", EntryPoint = "calloc")]
    static extern string PthreadCalloc(long count, long size);

    [DllImport("crt", EntryPoint = "free")]
    static extern void PthreadFree(string ptr);

    [DllImport("crt", EntryPoint = "pthread_mutex_init")]
    static extern int PthreadMutexInit(string mutex, string attr);

    [DllImport("crt", EntryPoint = "pthread_mutex_lock")]
    static extern int PthreadMutexLock(string mutex);

    [DllImport("crt", EntryPoint = "pthread_mutex_unlock")]
    static extern int PthreadMutexUnlock(string mutex);

    [DllImport("crt", EntryPoint = "pthread_mutex_destroy")]
    static extern int PthreadMutexDestroy(string mutex);
    #endif

    #if WINDOWS
    static nint Create() {
        return WinCreateMutex(0, 0, "");
    }

    static void Lock(nint handle) {
        WinWaitForSingleObject(handle, -1);
    }

    static void Unlock(nint handle) {
        WinReleaseMutex(handle);
    }

    static void Destroy(nint handle) {
        WinCloseHandle(handle);
    }
    #else
    static string Create() {
        string mtx = PthreadCalloc(1, 64);
        PthreadMutexInit(mtx, "");
        return mtx;
    }

    static void Lock(string handle) {
        PthreadMutexLock(handle);
    }

    static void Unlock(string handle) {
        PthreadMutexUnlock(handle);
    }

    static void Destroy(string handle) {
        PthreadMutexDestroy(handle);
        PthreadFree(handle);
    }
    #endif
}

/// <summary>
/// Cross-platform semaphore.
/// </summary>
class Semaphore {
    #if WINDOWS
    [DllImport("kernel32", EntryPoint = "CreateSemaphoreA")]
    static extern nint WinCreateSemaphore(nint secAttrs, int initialCount, int maxCount, string name);

    [DllImport("kernel32", EntryPoint = "WaitForSingleObject")]
    static extern int WinWaitForSingleObject(nint handle, int milliseconds);

    [DllImport("kernel32", EntryPoint = "ReleaseSemaphore")]
    static extern int WinReleaseSemaphore(nint handle, int releaseCount, nint prevCount);

    [DllImport("kernel32", EntryPoint = "CloseHandle")]
    static extern int WinCloseHandle(nint handle);
    #elif MACOS
    // macOS has no unnamed POSIX semaphores (sem_init sets ENOSYS and returns
    // -1), so use a GCD dispatch semaphore. The opaque dispatch_semaphore_t
    // pointer is carried as a string handle, matching the Linux sem_t*
    // convention below. dispatch_* lives in libSystem, which -lc resolves.
    [DllImport("crt", EntryPoint = "dispatch_semaphore_create")]
    static extern string MacSemCreate(int initValue);

    [DllImport("crt", EntryPoint = "dispatch_semaphore_wait")]
    static extern int MacSemWait(string sem, int timeout);

    [DllImport("crt", EntryPoint = "dispatch_semaphore_signal")]
    static extern int MacSemSignal(string sem);

    [DllImport("crt", EntryPoint = "dispatch_release")]
    static extern void MacSemRelease(string sem);

    [DllImport("crt", EntryPoint = "dispatch_semaphore_wait")]
    static extern int MacSemWaitUntil(string sem, long when);

    [DllImport("crt", EntryPoint = "dispatch_time")]
    static extern long MacDispatchTime(long base, long deltaNs);
    #else
    [DllImport("crt", EntryPoint = "calloc")]
    static extern string SemCalloc(long count, long size);

    [DllImport("crt", EntryPoint = "free")]
    static extern void SemFree(string ptr);

    [DllImport("crt", EntryPoint = "sem_init")]
    static extern int SemInit(string sem, int pshared, int initValue);

    [DllImport("crt", EntryPoint = "sem_wait")]
    static extern int SemWait(string sem);

    [DllImport("crt", EntryPoint = "sem_post")]
    static extern int SemPost(string sem);

    [DllImport("crt", EntryPoint = "sem_destroy")]
    static extern int SemDestroy(string sem);

    [DllImport("crt", EntryPoint = "sem_timedwait")]
    static extern int SemTimedWait(string sem, nint absTime);

    [DllImport("crt", EntryPoint = "clock_gettime")]
    static extern int SemClockGettime(int clkId, nint tp);
    #endif

    #if WINDOWS
    static nint Create(int initialCount, int maxCount) {
        return WinCreateSemaphore(0, initialCount, maxCount, "");
    }

    static void Wait(nint handle) {
        WinWaitForSingleObject(handle, -1);
    }

    /// <summary>Waits at most `timeoutMs` for a permit. True when one was
    /// taken, false when the wait timed out (nothing is consumed then).
    /// A negative timeout waits forever, 0 polls.</summary>
    static bool WaitFor(nint handle, int timeoutMs) {
        return WinWaitForSingleObject(handle, timeoutMs) == 0;
    }

    static void Release(nint handle) {
        WinReleaseSemaphore(handle, 1, 0);
    }

    static void Destroy(nint handle) {
        WinCloseHandle(handle);
    }
    #elif MACOS
    static string Create(int initialCount, int maxCount) {
        return MacSemCreate(initialCount);
    }

    static void Wait(string handle) {
        MacSemWait(handle, -1);   // -1 == DISPATCH_TIME_FOREVER
    }

    static bool WaitFor(string handle, int timeoutMs) {
        if (timeoutMs < 0) {
            MacSemWait(handle, -1);
            return true;
        }
        // dispatch_time(DISPATCH_TIME_NOW, delta) takes nanoseconds.
        long deadline = MacDispatchTime(0, (long)timeoutMs * 1000000);
        return MacSemWaitUntil(handle, deadline) == 0;
    }

    static void Release(string handle) {
        MacSemSignal(handle);
    }

    static void Destroy(string handle) {
        MacSemRelease(handle);
    }
    #else
    static string Create(int initialCount, int maxCount) {
        string sem = SemCalloc(1, 64);
        SemInit(sem, 0, initialCount);
        return sem;
    }

    static void Wait(string handle) {
        SemWait(handle);
    }

    static bool WaitFor(string handle, int timeoutMs) {
        if (timeoutMs < 0) {
            SemWait(handle);
            return true;
        }
        // sem_timedwait takes an ABSOLUTE CLOCK_REALTIME deadline, so read the
        // clock and add the timeout rather than passing a duration.
        nint ts = NativeMemory.Alloc(16);
        SemClockGettime(0, ts);
        Span<long> f = new Span<long>(ts, 2);
        long ns = f[1] + (long)timeoutMs * 1000000;
        f[0] = f[0] + ns / 1000000000;
        f[1] = ns % 1000000000;
        int r = SemTimedWait(handle, ts);
        NativeMemory.Free(ts);
        return r == 0;
    }

    static void Release(string handle) {
        SemPost(handle);
    }

    static void Destroy(string handle) {
        SemDestroy(handle);
        SemFree(handle);
    }
    #endif
}

/// <summary>
/// Cross-platform high-resolution stopwatch.
/// </summary>
class Stopwatch {
    #if WINDOWS
    [DllImport("kernel32", EntryPoint = "GetTickCount64")]
    static extern long WinGetTickCount64();
    #else
    [DllImport("crt", EntryPoint = "clock_gettime")]
    static extern int ClockGettime(int clk_id, string tp);

    [DllImport("crt", EntryPoint = "calloc")]
    static extern string StopwatchCalloc(long count, long size);

    [DllImport("crt", EntryPoint = "free")]
    static extern void StopwatchFree(string ptr);

    // CLOCK_MONOTONIC has a different numeric value per platform: 1 on Linux,
    // 6 on macOS (where clk_id 1 is not a valid clock and would fail).
    #if MACOS
    static int MonotonicClockId() { return 6; }
    #else
    static int MonotonicClockId() { return 1; }
    #endif
    #endif

    [DllImport("crt", EntryPoint = "zan_monotonic_us")]
    static extern long NativeMonotonicUs();

    /// <summary>Monotonic microseconds. Unlike GetMilliseconds this resolves
    /// individual requests (GetTickCount64 steps by ~15ms on Windows) and does
    /// not allocate, so it is usable on the request path.</summary>
    static long GetMicroseconds() {
        return NativeMonotonicUs();
    }

    /// <summary>Returns current tick count in milliseconds.</summary>
    static long GetMilliseconds() {
        #if WINDOWS
        return WinGetTickCount64();
        #else
        string tp = StopwatchCalloc(1, 16);
        ClockGettime(MonotonicClockId(), tp);
        long sec = tp[0] | (tp[1] << 8) | (tp[2] << 16) | (tp[3] << 24);
        long nsec = tp[8] | (tp[9] << 8) | (tp[10] << 16) | (tp[11] << 24);
        StopwatchFree(tp);
        return sec * 1000 + nsec / 1000000;
        #endif
    }
}

/// <summary>
/// A sequentially-consistent 64-bit integer for sharing between worker threads.
/// </summary>
class AtomicInt {
    nint handle;

    [DllImport("crt", EntryPoint = "zan_atomic_int_create")]
    static extern nint NativeCreate(long initialValue);

    [DllImport("crt", EntryPoint = "zan_atomic_int_destroy")]
    static extern void NativeDestroy(nint handle);

    [DllImport("crt", EntryPoint = "zan_atomic_int_load")]
    static extern long NativeLoad(nint handle);

    [DllImport("crt", EntryPoint = "zan_atomic_int_store")]
    static extern void NativeStore(nint handle, long newValue);

    [DllImport("crt", EntryPoint = "zan_atomic_int_exchange")]
    static extern long NativeExchange(nint handle, long newValue);

    [DllImport("crt", EntryPoint = "zan_atomic_int_compare_exchange")]
    static extern long NativeCompareExchange(nint handle, long expected, long desired);

    [DllImport("crt", EntryPoint = "zan_atomic_int_add")]
    static extern long NativeAdd(nint handle, long delta);

    AtomicInt(long initialValue) {
        this.handle = NativeCreate(initialValue);
    }

    ~AtomicInt() {
        if (this.handle != 0) {
            NativeDestroy(this.handle);
            this.handle = 0;
        }
    }

    bool IsValid() {
        return this.handle != 0;
    }

    long Load() {
        return NativeLoad(this.handle);
    }

    void Store(long newValue) {
        NativeStore(this.handle, newValue);
    }

    long Exchange(long newValue) {
        return NativeExchange(this.handle, newValue);
    }

    long CompareExchange(long expected, long desired) {
        return NativeCompareExchange(this.handle, expected, desired);
    }

    long Add(long delta) {
        return NativeAdd(this.handle, delta);
    }

    long Increment() {
        return NativeAdd(this.handle, 1);
    }

    long Decrement() {
        return NativeAdd(this.handle, -1);
    }
}

/// <summary>
/// A fixed-capacity, fixed-schema hash table backed by named shared memory.
/// Every operation is atomic across threads and processes.
/// </summary>
class SharedTable {
    nint handle;
    string tableName;
    int tableCapacity;
    int tableKeySize;
    string tableSchema;

    [DllImport("crt", EntryPoint = "zan_shared_table_create")]
    static extern nint NativeCreate(string name, int capacity, int keySize, string schema);

    [DllImport("crt", EntryPoint = "zan_shared_table_open")]
    static extern nint NativeOpen(string name);

    [DllImport("crt", EntryPoint = "zan_shared_table_close")]
    static extern void NativeClose(nint handle);

    [DllImport("crt", EntryPoint = "zan_shared_table_destroy")]
    static extern int NativeDestroy(nint handle);

    [DllImport("crt", EntryPoint = "zan_shared_table_set_int")]
    static extern int NativeSetInt(nint handle, string key, string column, long newValue);

    [DllImport("crt", EntryPoint = "zan_shared_table_get_int")]
    static extern long NativeGetInt(nint handle, string key, string column);

    [DllImport("crt", EntryPoint = "zan_shared_table_set_float")]
    static extern int NativeSetFloat(nint handle, string key, string column, double newValue);

    [DllImport("crt", EntryPoint = "zan_shared_table_get_float")]
    static extern double NativeGetFloat(nint handle, string key, string column);

    [DllImport("crt", EntryPoint = "zan_shared_table_set_string")]
    static extern int NativeSetString(nint handle, string key, string column, string newValue);

    [DllImport("crt", EntryPoint = "zan_shared_table_get_string")]
    static extern string NativeGetString(nint handle, string key, string column);

    [DllImport("crt", EntryPoint = "zan_shared_table_increment")]
    static extern long NativeIncrement(nint handle, string key, string column, long delta);

    [DllImport("crt", EntryPoint = "zan_shared_table_expire")]
    static extern int NativeExpire(nint handle, string key, long ttlMs);

    [DllImport("crt", EntryPoint = "zan_shared_table_expire_at")]
    static extern int NativeExpireAt(nint handle, string key, long unixMs);

    [DllImport("crt", EntryPoint = "zan_shared_table_expires_at")]
    static extern long NativeExpiresAt(nint handle, string key);

    [DllImport("crt", EntryPoint = "zan_shared_table_purge_expired")]
    static extern long NativePurgeExpired(nint handle, long nowMs);

    [DllImport("crt", EntryPoint = "zan_shared_table_rate_allow")]
    static extern int NativeRateAllow(
        nint handle, string key, long nowMs, long windowMs, long limit);

    [DllImport("crt", EntryPoint = "zan_shared_table_lock_acquire")]
    static extern int NativeLockAcquire(
        nint handle, string key, long owner, long nowMs, long leaseMs);

    [DllImport("crt", EntryPoint = "zan_shared_table_lock_release")]
    static extern int NativeLockRelease(nint handle, string key, long owner);

    [DllImport("crt", EntryPoint = "zan_shared_table_delete")]
    static extern int NativeDelete(nint handle, string key);

    [DllImport("crt", EntryPoint = "zan_shared_table_exists")]
    static extern int NativeExists(nint handle, string key);

    [DllImport("crt", EntryPoint = "zan_shared_table_count")]
    static extern long NativeCount(nint handle);

    [DllImport("crt", EntryPoint = "zan_shared_table_clear")]
    static extern void NativeClear(nint handle);

    [DllImport("crt", EntryPoint = "zan_shared_table_hash")]
    static extern long NativeHash(string text);

    [DllImport("crt", EntryPoint = "zan_shared_table_set_int_at")]
    static extern int NativeSetIntAt(nint handle, long keyHash, string column, long newValue);

    [DllImport("crt", EntryPoint = "zan_shared_table_get_int_at")]
    static extern long NativeGetIntAt(nint handle, long keyHash, string column);

    [DllImport("crt", EntryPoint = "zan_shared_table_increment_at")]
    static extern long NativeIncrementAt(nint handle, long keyHash, string column, long delta);

    [DllImport("crt", EntryPoint = "zan_shared_table_extreme_at")]
    static extern long NativeExtremeAt(
        nint handle, long keyHash, string column, long newValue, long keepLarger);

    [DllImport("crt", EntryPoint = "zan_shared_table_set_string_at")]
    static extern int NativeSetStringAt(nint handle, long keyHash, string column, string newValue);

    [DllImport("crt", EntryPoint = "zan_shared_table_get_string_at")]
    static extern string NativeGetStringAt(nint handle, long keyHash, string column);

    [DllImport("crt", EntryPoint = "zan_shared_table_match_at")]
    static extern int NativeMatchAt(nint handle, long keyHash, string column, string text);

    [DllImport("crt", EntryPoint = "zan_shared_table_exists_at")]
    static extern int NativeExistsAt(nint handle, long keyHash);

    [DllImport("crt", EntryPoint = "zan_shared_table_delete_at")]
    static extern int NativeDeleteAt(nint handle, long keyHash);

    SharedTable(string name, int capacity) {
        this.handle = 0;
        this.tableName = name;
        this.tableCapacity = capacity;
        this.tableKeySize = 64;
        this.tableSchema = "";
    }

    ~SharedTable() {
        Close();
    }

    void KeySize(int size) {
        this.tableKeySize = size;
    }

    void ColumnInt(string name) {
        this.tableSchema = this.tableSchema + "i:" + name + ";";
    }

    void ColumnFloat(string name) {
        this.tableSchema = this.tableSchema + "f:" + name + ";";
    }

    void ColumnString(string name, int size) {
        this.tableSchema = this.tableSchema + "s:" +
            Convert.ToString(size) + ":" + name + ";";
    }

    bool Create() {
        if (this.handle != 0) {
            return false;
        }
        this.handle = NativeCreate(
            this.tableName, this.tableCapacity, this.tableKeySize, this.tableSchema);
        return this.handle != 0;
    }

    static SharedTable Open(string name) {
        SharedTable table = new SharedTable(name, 1);
        table.handle = NativeOpen(name);
        return table;
    }

    bool IsOpen() {
        return this.handle != 0;
    }

    void Close() {
        if (this.handle != 0) {
            NativeClose(this.handle);
            this.handle = 0;
        }
    }

    bool Destroy() {
        if (this.handle == 0) {
            return false;
        }
        nint current = this.handle;
        this.handle = 0;
        return NativeDestroy(current) != 0;
    }

    bool SetInt(string key, string column, long newValue) {
        return NativeSetInt(this.handle, key, column, newValue) != 0;
    }

    long GetInt(string key, string column) {
        return NativeGetInt(this.handle, key, column);
    }

    bool SetFloat(string key, string column, double newValue) {
        return NativeSetFloat(this.handle, key, column, newValue) != 0;
    }

    double GetFloat(string key, string column) {
        return NativeGetFloat(this.handle, key, column);
    }

    bool SetString(string key, string column, string newValue) {
        return NativeSetString(this.handle, key, column, newValue) != 0;
    }

    string GetString(string key, string column) {
        string text = NativeGetString(this.handle, key, column);
        return text.Substring(0, text.Length);
    }

    long Increment(string key, string column, long delta) {
        return NativeIncrement(this.handle, key, column, delta);
    }

    long Decrement(string key, string column, long delta) {
        return NativeIncrement(this.handle, key, column, -delta);
    }

    bool Expire(string key, long ttlMs) {
        return NativeExpire(this.handle, key, ttlMs) != 0;
    }

    bool ExpireAt(string key, long unixMs) {
        return NativeExpireAt(this.handle, key, unixMs) != 0;
    }

    bool Persist(string key) {
        return NativeExpireAt(this.handle, key, 0) != 0;
    }

    long ExpiresAt(string key) {
        return NativeExpiresAt(this.handle, key);
    }

    long PurgeExpired(long nowMs) {
        return NativePurgeExpired(this.handle, nowMs);
    }

    bool RateAllow(string key, long nowMs, long windowMs, long limit) {
        return NativeRateAllow(this.handle, key, nowMs, windowMs, limit) != 0;
    }

    bool TryAcquireLease(string key, long owner, long nowMs, long leaseMs) {
        return NativeLockAcquire(this.handle, key, owner, nowMs, leaseMs) != 0;
    }

    bool ReleaseLease(string key, long owner) {
        return NativeLockRelease(this.handle, key, owner) != 0;
    }

    bool Delete(string key) {
        return NativeDelete(this.handle, key) != 0;
    }

    bool Exists(string key) {
        return NativeExists(this.handle, key) != 0;
    }

    int Count() {
        return (int)NativeCount(this.handle);
    }

    void Clear() {
        NativeClear(this.handle);
    }

    // ---- rows addressed by a precomputed hash ----
    //
    // A request handler hashes its key once ("GET_/user/list") and passes that
    // value to every table it touches, so the key is never formatted into a
    // string and no key bytes are compared. Rows are then identified by the
    // hash alone: use a table either by key or by hash, not both, and keep the
    // original text in a column when a collision would be dangerous.

    /// <summary>Hashes a key the same way the table does (FNV-1a, 64-bit).</summary>
    static long Hash(string text) {
        return NativeHash(text);
    }

    bool SetIntAt(long keyHash, string column, long newValue) {
        return NativeSetIntAt(this.handle, keyHash, column, newValue) != 0;
    }

    long GetIntAt(long keyHash, string column) {
        return NativeGetIntAt(this.handle, keyHash, column);
    }

    long IncrementAt(long keyHash, string column, long delta) {
        return NativeIncrementAt(this.handle, keyHash, column, delta);
    }

    /// <summary>Stores `newValue` if it is smaller than what is there (zero
    /// counts as unset), in one atomic step. For "fastest response so far".</summary>
    long MinAt(long keyHash, string column, long newValue) {
        return NativeExtremeAt(this.handle, keyHash, column, newValue, 0);
    }

    /// <summary>Stores `newValue` if it is larger than what is there, in one
    /// atomic step. For "slowest response so far".</summary>
    long MaxAt(long keyHash, string column, long newValue) {
        return NativeExtremeAt(this.handle, keyHash, column, newValue, 1);
    }

    bool SetStringAt(long keyHash, string column, string newValue) {
        return NativeSetStringAt(this.handle, keyHash, column, newValue) != 0;
    }

    string GetStringAt(long keyHash, string column) {
        string text = NativeGetStringAt(this.handle, keyHash, column);
        return text.Substring(0, text.Length);
    }

    /// <summary>Whether a string column equals `text`, without copying the
    /// stored bytes out. Verifying a key's original text on every lookup would
    /// otherwise allocate a string per call.</summary>
    bool MatchAt(long keyHash, string column, string text) {
        return NativeMatchAt(this.handle, keyHash, column, text) != 0;
    }

    bool ExistsAt(long keyHash) {
        return NativeExistsAt(this.handle, keyHash) != 0;
    }

    bool DeleteAt(long keyHash) {
        return NativeDeleteAt(this.handle, keyHash) != 0;
    }
}

/// <summary>
/// Coroutine-aware channel for inter-coroutine communication.
/// Platform-independent (pure Zan).
/// </summary>
class Channel {
    List<string> buffer;
    int capacity;
    bool closed;

    Channel(int capacity) {
        this.buffer = new List<string>();
        this.capacity = capacity;
        this.closed = false;
    }

    /// <summary>Creates an unbuffered channel.</summary>
    static Channel CreateUnbuffered() {
        return new Channel(1);
    }

    /// <summary>Sends a value to the channel (blocks if full).</summary>
    void Send(string item) {
        if (!this.closed) {
            this.buffer.Add(item);
        }
    }

    /// <summary>Receives a value from the channel (blocks if empty).</summary>
    string Receive() {
        if (this.buffer.Count > 0) {
            string val = this.buffer[0];
            this.buffer.RemoveAt(0);
            return val;
        }
        return "";
    }

    /// <summary>Closes the channel.</summary>
    void Close() {
        this.closed = true;
    }

    /// <summary>Returns true if the channel is closed.</summary>
    bool IsClosed() {
        return this.closed;
    }

    /// <summary>Returns current buffer count.</summary>
    int Count() {
        return this.buffer.Count;
    }
}
