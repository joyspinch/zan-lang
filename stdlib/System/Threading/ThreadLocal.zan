using System;
using System.Collections.Generic;

namespace System.Threading;

// 线程局部存储（ThreadLocal<T>）。
// 为每个线程独立保存一份类型为 T 的值副本，
// 支持通过工厂委托（valueFactory）实现懒加载初始化，
// 提供零全局争用的线程级安全缓存与状态隔离。
public class ThreadLocal<T> : IDisposable {
    private Func<T> valueFactory;
    private Dict<long, T> values;
    private bool initialized;

    public ThreadLocal() {
        this.valueFactory = null;
        this.values = new Dict<long, T>();
        this.initialized = true;
    }

    public ThreadLocal(Func<T> valueFactory) {
        this.valueFactory = valueFactory;
        this.values = new Dict<long, T>();
        this.initialized = true;
    }

    public static long CurrentThreadId() {
        long tid = Thread.CurrentId();
        if (tid == 0) {
            return 1;
        }
        return tid;
    }

    // 获取或设置当前线程的值
    public T Value {
        get {
            long tid = CurrentThreadId();
            T val;
            if (this.values.TryGetValue(tid, out val)) {
                return val;
            }
            if (this.valueFactory != null) {
                val = this.valueFactory();
                this.values[tid] = val;
                return val;
            }
            T dummy = null;
            return dummy;
        }
        set {
            long tid = CurrentThreadId();
            this.values[tid] = value;
        }
    }

    // 当前线程是否已初始化值
    public bool IsValueCreated {
        get {
            long tid = CurrentThreadId();
            T val;
            return this.values.TryGetValue(tid, out val);
        }
    }

    // 获取所有线程当前已初始化的值副本（用于快照或统计）
    public List<T> Values {
        get {
            List<T> list = new List<T>();
            if (this.values == null) { return list; }
            List<T> vlist = this.values.Values;
            for (int i = 0; i < vlist.Count; i = i + 1) {
                list.Add(vlist[i]);
            }
            return list;
        }
    }

    public void Dispose() {
        if (this.values != null) {
            this.values.Clear();
            this.values = null;
        }
        this.valueFactory = null;
        this.initialized = false;
    }
}
