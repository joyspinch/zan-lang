using System;
using System.Collections.Generic;

namespace System.Threading;

// 线程局部存储（ThreadLocal<T>）。
// 为每个线程独立保存一份类型为 T 的值副本，
// 支持通过工厂委托（valueFactory）实现懒加载初始化，
// 提供零全局争用的线程级安全缓存与状态隔离。
public class ThreadLocal<T> : IDisposable {
    private Func<T> valueFactory;
    private Dict<long, T> values;
    private bool initialized;
    private bool disposed;

    public ThreadLocal() {
        this.valueFactory = null;
        this.values = new Dict<long, T>();
        this.initialized = true;
        this.disposed = false;
    }

    public ThreadLocal(Func<T> valueFactory) {
        this.valueFactory = valueFactory;
        this.values = new Dict<long, T>();
        this.initialized = true;
        this.disposed = false;
    }

    public static long CurrentThreadId() {
        long tid = Thread.CurrentId();
        if (tid == 0) {
            return 1;
        }
        return tid;
    }

    // 获取或设置当前线程的值。锁内读写：valueFactory 回调也在锁内发生。
    public T Value {
        get {
            long tid = CurrentThreadId();
            lock (this) {
                if (this.disposed || this.values == null) {
                    throw new ObjectDisposedException("ThreadLocal");
                }
                T val;
                if (this.values.TryGetValue(tid, out val)) {
                    return val;
                }
                if (this.valueFactory != null) {
                    val = this.valueFactory();
                    this.values[tid] = val;
                    return val;
                }
                T dummy = null;
                return dummy;
            }
        }
        set {
            long tid = CurrentThreadId();
            lock (this) {
                if (this.disposed || this.values == null) {
                    throw new ObjectDisposedException("ThreadLocal");
                }
                this.values[tid] = value;
            }
        }
    }

    // 当前线程是否已初始化值
    public bool IsValueCreated {
        get {
            long tid = CurrentThreadId();
            lock (this) {
                if (this.disposed || this.values == null) { return false; }
                T val;
                return this.values.TryGetValue(tid, out val);
            }
        }
    }

    // 获取所有线程当前已初始化的值副本（用于快照或统计）
    public List<T> Values {
        get {
            lock (this) {
                if (this.disposed || this.values == null) { return new List<T>(); }
                return this.values.Values;
            }
        }
    }

    public void Dispose() {
        lock (this) {
            if (this.disposed) { return; }
            this.disposed = true;
            if (this.values != null) {
                this.values.Clear();
                this.values = null;
            }
            this.valueFactory = null;
            this.initialized = false;
        }
    }
}
