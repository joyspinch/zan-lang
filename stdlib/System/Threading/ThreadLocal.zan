using System;
using System.Collections.Generic;

namespace System.Threading;

// 线程局部存储（ThreadLocal<T>）。
// 为每个线程独立保存一份类型为 T 的值副本，
// 支持通过工厂委托（valueFactory）实现懒加载初始化，
// 提供零全局争用的线程级安全缓存与状态隔离。
public class ThreadLocal<T> : IDisposable {
    private Func<T> valueFactory;
    private Dict<long, T> values;
    private bool initialized;
    // values 是跨线程共享的 Dict：并发首插会同时触发扩容/rehash，
    // 曾裸用导致结构损坏（挂账 P0）。所有读写都在此互斥锁内。
    private nint valuesLock = Mutex.Create();

    public ThreadLocal() {
        this.valueFactory = null;
        this.values = new Dict<long, T>();
        this.initialized = true;
        this.valuesLock = Mutex.Create();
    }

    public ThreadLocal(Func<T> valueFactory) {
        this.valueFactory = valueFactory;
        this.values = new Dict<long, T>();
        this.initialized = true;
        this.valuesLock = Mutex.Create();
    }

    public static long CurrentThreadId() {
        long tid = Thread.CurrentId();
        if (tid == 0) {
            return 1;
        }
        return tid;
    }

    // 获取或设置当前线程的值。锁内读写：valueFactory 回调也在锁内
    // 发生——工厂内部不得再回头取同一个 ThreadLocal 的 Value（会
    // 自锁），C# 的 ThreadLocal 同样如此约定。
    public T Value {
        get {
            long tid = CurrentThreadId();
            Mutex.Lock(this.valuesLock);
            T val;
            if (this.values.TryGetValue(tid, out val)) {
                Mutex.Unlock(this.valuesLock);
                return val;
            }
            if (this.valueFactory != null) {
                val = this.valueFactory();
                this.values[tid] = val;
                Mutex.Unlock(this.valuesLock);
                return val;
            }
            Mutex.Unlock(this.valuesLock);
            T dummy = null;
            return dummy;
        }
        set {
            long tid = CurrentThreadId();
            Mutex.Lock(this.valuesLock);
            this.values[tid] = value;
            Mutex.Unlock(this.valuesLock);
        }
    }

    // 当前线程是否已初始化值
    public bool IsValueCreated {
        get {
            long tid = CurrentThreadId();
            Mutex.Lock(this.valuesLock);
            T val;
            bool has = this.values.TryGetValue(tid, out val);
            Mutex.Unlock(this.valuesLock);
            return has;
        }
    }

    // 获取所有线程当前已初始化的值副本（用于快照或统计）
    public List<T> Values {
        get {
            List<T> list = new List<T>();
            if (this.values == null) { return list; }
            Mutex.Lock(this.valuesLock);
            List<T> vlist = this.values.Values;
            for (int i = 0; i < vlist.Count; i = i + 1) {
                list.Add(vlist[i]);
            }
            Mutex.Unlock(this.valuesLock);
            return list;
        }
    }

    public void Dispose() {
        if (this.values != null) {
            Mutex.Lock(this.valuesLock);
            this.values.Clear();
            this.values = null;
            Mutex.Unlock(this.valuesLock);
        }
        this.valueFactory = null;
        this.initialized = false;
        if (this.valuesLock != 0) {
            Mutex.Destroy(this.valuesLock);
            this.valuesLock = 0;
        }
    }
}
