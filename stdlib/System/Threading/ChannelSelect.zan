using System;
using System.Collections.Generic;
using System.Threading;

namespace System.Threading;

public enum Select2Result<T1, T2> {
    First(T1 value),
    Second(T2 value),
    Closed,
    Cancelled
}

public enum Select3Result<T1, T2, T3> {
    First(T1 value),
    Second(T2 value),
    Third(T3 value),
    Closed,
    Cancelled
}

// 工业生产级多通道事件驱动 Select（类 Go runtime.selectgo：零忙轮询、AsyncGate 唤醒、支持 CancellationToken）。
public static class ChannelSelect {
    public static async Task<Select2Result<T1, T2>> Select2<T1, T2>(
        Channel<T1> ch1, Channel<T2> ch2) {
        return await Select2<T1, T2>(ch1, ch2, null);
    }

    public static async Task<Select2Result<T1, T2>> Select2<T1, T2>(
        Channel<T1> ch1, Channel<T2> ch2, CancellationToken token) {
        T1 v1;
        T2 v2;

        if (ch1 != null) {
            if (ch1.TryRead(out v1)) {
                return Select2Result<T1, T2>.First(v1);
            }
        }
        if (ch2 != null) {
            if (ch2.TryRead(out v2)) {
                return Select2Result<T1, T2>.Second(v2);
            }
        }
        if (token != null && token.IsCancellationRequested) {
            return Select2Result<T1, T2>.Cancelled;
        }

        AsyncGate gate = new AsyncGate();
        CancellationTokenRegistration reg = null;
        if (token != null) {
            AsyncGate gCap = gate;
            reg = token.Register(() => {
                gCap.SignalAll();
            });
        }
        if (ch1 != null) { ch1.AddSelectWaiter(gate); }
        if (ch2 != null) { ch2.AddSelectWaiter(gate); }

        try {
            while (true) {
                if (ch1 != null) {
                    if (ch1.TryRead(out v1)) {
                        return Select2Result<T1, T2>.First(v1);
                    }
                }
                if (ch2 != null) {
                    if (ch2.TryRead(out v2)) {
                        return Select2Result<T1, T2>.Second(v2);
                    }
                }
                if (token != null && token.IsCancellationRequested) {
                    return Select2Result<T1, T2>.Cancelled;
                }
                bool c1Done = (ch1 == null || ch1.IsCompleted());
                bool c2Done = (ch2 == null || ch2.IsCompleted());
                if (c1Done && c2Done) {
                    return Select2Result<T1, T2>.Closed;
                }
                if (!await gate.Wait()) {
                    return Select2Result<T1, T2>.Cancelled;
                }
            }
        } finally {
            if (ch1 != null) { ch1.RemoveSelectWaiter(gate); }
            if (ch2 != null) { ch2.RemoveSelectWaiter(gate); }
            if (reg != null) { reg.Dispose(); }
            gate.Close();
        }
    }

    public static async Task<Select3Result<T1, T2, T3>> Select3<T1, T2, T3>(
        Channel<T1> ch1, Channel<T2> ch2, Channel<T3> ch3,
        CancellationToken token) {
        T1 v1;
        T2 v2;
        T3 v3;

        if (ch1 != null) {
            if (ch1.TryRead(out v1)) {
                return Select3Result<T1, T2, T3>.First(v1);
            }
        }
        if (ch2 != null) {
            if (ch2.TryRead(out v2)) {
                return Select3Result<T1, T2, T3>.Second(v2);
            }
        }
        if (ch3 != null) {
            if (ch3.TryRead(out v3)) {
                return Select3Result<T1, T2, T3>.Third(v3);
            }
        }
        if (token != null && token.IsCancellationRequested) {
            return Select3Result<T1, T2, T3>.Cancelled;
        }

        AsyncGate gate = new AsyncGate();
        CancellationTokenRegistration reg = null;
        if (token != null) {
            AsyncGate gCap = gate;
            reg = token.Register(() => {
                gCap.SignalAll();
            });
        }
        if (ch1 != null) { ch1.AddSelectWaiter(gate); }
        if (ch2 != null) { ch2.AddSelectWaiter(gate); }
        if (ch3 != null) { ch3.AddSelectWaiter(gate); }

        try {
            while (true) {
                if (ch1 != null) {
                    if (ch1.TryRead(out v1)) {
                        return Select3Result<T1, T2, T3>.First(v1);
                    }
                }
                if (ch2 != null) {
                    if (ch2.TryRead(out v2)) {
                        return Select3Result<T1, T2, T3>.Second(v2);
                    }
                }
                if (ch3 != null) {
                    if (ch3.TryRead(out v3)) {
                        return Select3Result<T1, T2, T3>.Third(v3);
                    }
                }
                if (token != null && token.IsCancellationRequested) {
                    return Select3Result<T1, T2, T3>.Cancelled;
                }
                bool c1Done = (ch1 == null || ch1.IsCompleted());
                bool c2Done = (ch2 == null || ch2.IsCompleted());
                bool c3Done = (ch3 == null || ch3.IsCompleted());
                if (c1Done && c2Done && c3Done) {
                    return Select3Result<T1, T2, T3>.Closed;
                }
                if (!await gate.Wait()) {
                    return Select3Result<T1, T2, T3>.Cancelled;
                }
            }
        } finally {
            if (ch1 != null) { ch1.RemoveSelectWaiter(gate); }
            if (ch2 != null) { ch2.RemoveSelectWaiter(gate); }
            if (ch3 != null) { ch3.RemoveSelectWaiter(gate); }
            if (reg != null) { reg.Dispose(); }
            gate.Close();
        }
    }
}
