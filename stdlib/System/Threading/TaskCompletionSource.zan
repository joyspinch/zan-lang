using System;

namespace System.Threading;

// 跨平台轻量级非阻塞任务结果源，解耦结果生产者与消费者。
// 生产者可在任意线程/Worker 触发 SetResult/SetException/SetCanceled，
// 消费者通过 Task 属性以 await 挂起等待，无忙轮询，不占用线程与渲染帧。
public class TaskCompletionSource<T> {
    T result;
    Exception error;
    bool isCompleted;
    bool closed;
    nint syncLock;
    List<Gate> waiters;

    public TaskCompletionSource() {
        this.isCompleted = false;
        this.closed = false;
        this.error = null;
        this.syncLock = Mutex.Create();
        this.waiters = new List<Gate>();
    }

    // 任务是否已经完成（成功、失败或取消）。
    public bool IsCompleted {
        get { return this.isCompleted; }
    }

    // 将底层操作转换为可 await 的 Task<T>。
    // 多等待者安全：每个等待者在锁下登记一把私有门，完成方持锁快照并清空
    // 登记列表、解锁后逐个唤醒——旧实现全部等待者共用单门且完成只 Signal
    // 一次，N 个挂起者只有一个被唤醒拿到结果，其余永久挂死；登记与挂起之间
    // 的窗口由私有门的暂存信号语义兜住（唤醒后锁下重查完成标志）。
    // TCS 已 Close 且未完成时抛异常（此前会永久挂死）。
    public async Task<T> Task {
        get {
            Gate mine = null;
            bool waiting = false;
            bool wasClosed = false;
            nint lk = this.syncLock;
            if (lk == 0) {
                if (!this.isCompleted) {
                    throw new Exception("TaskCompletionSource was closed before completion.");
                }
                if (this.error != null) { throw this.error; }
                return this.result;
            }
            Mutex.Lock(lk);
            if (!this.isCompleted) {
                if (!this.closed) {
                    mine = new Gate();
                    this.waiters.Add(mine);
                    waiting = true;
                } else {
                    wasClosed = true;
                }
            }
            Mutex.Unlock(lk);
            if (mine != null) {
                try {
                    while (waiting) {
                        await mine.Wait();
                        nint lk2 = this.syncLock;
                        if (lk2 == 0) {
                            waiting = false;
                            if (!this.isCompleted) { wasClosed = true; }
                            break;
                        }
                        Mutex.Lock(lk2);
                        if (this.isCompleted) {
                            waiting = false;
                        } else if (this.closed) {
                            waiting = false;
                            wasClosed = true;
                        }
                        Mutex.Unlock(lk2);
                    }
                } finally {
                    mine.Close();
                }
            }
            if (wasClosed) {
                throw new Exception("TaskCompletionSource was closed before completion.");
            }
            if (this.error != null) {
                throw this.error;
            }
            return this.result;
        }
    }

    // 须持锁调用：取走全部登记的私有等待门并重置登记列表。
    List<Gate> TakeWaiters() {
        List<Gate> taken = this.waiters;
        this.waiters = new List<Gate>();
        return taken;
    }

    // 解锁后调用：逐个 Signal 私有门——每个等待者恰好收到一次信号，
    // 唤醒后锁下重查完成标志决定去留。
    static void WakeAll(List<Gate> toWake) {
        if (toWake == null) { return; }
        for (int i = 0; i < toWake.Count; i = i + 1) {
            toWake[i].Signal();
        }
    }

    // 尝试将任务标记为已成功完成并设置结果。
    public bool TrySetResult(T value) {
        nint lk = this.syncLock;
        if (lk == 0) { return false; }
        List<Gate> toWake = null;
        Mutex.Lock(lk);
        if (this.isCompleted || this.closed) {
            Mutex.Unlock(lk);
            return false;
        }
        this.result = value;
        this.isCompleted = true;
        toWake = TakeWaiters();
        Mutex.Unlock(lk);
        WakeAll(toWake);
        return true;
    }

    // 将任务标记为已成功完成并设置结果。若已完成则抛出异常。
    public void SetResult(T value) {
        if (!this.TrySetResult(value)) {
            throw new Exception("TaskCompletionSource is already completed.");
        }
    }

    // 尝试将任务标记为发生错误并记录异常。
    public bool TrySetException(Exception exc) {
        nint lk = this.syncLock;
        if (lk == 0) { return false; }
        List<Gate> toWake = null;
        Mutex.Lock(lk);
        if (this.isCompleted || this.closed) {
            Mutex.Unlock(lk);
            return false;
        }
        this.error = exc;
        this.isCompleted = true;
        toWake = TakeWaiters();
        Mutex.Unlock(lk);
        WakeAll(toWake);
        return true;
    }

    // 将任务标记为发生错误并记录异常。若已完成则抛出异常。
    public void SetException(Exception exc) {
        if (!this.TrySetException(exc)) {
            throw new Exception("TaskCompletionSource is already completed.");
        }
    }

    // 尝试将任务标记为已取消。
    public bool TrySetCanceled() {
        return this.TrySetException(new Exception("The task was canceled."));
    }

    // 将任务标记为已取消。若已完成则抛出异常。
    public void SetCanceled() {
        if (!this.TrySetCanceled()) {
            throw new Exception("TaskCompletionSource is already completed.");
        }
    }

    // 关联取消令牌：当指定令牌被取消时，若当前任务尚未完成则自动标记为取消。
    // 返回注册句柄以便外部在任务正常完成后注销。
    public CancellationTokenRegistration AttachCancellationToken(CancellationToken token) {
        if (token == null) { return null; }
        CancellationTokenRegistration reg = token.Register(() => {
            this.TrySetCanceled();
        });
        return reg;
    }

    // 关闭并释放底层资源；挂起中的等待者被唤醒并以异常收场
    // （Task getter 抛 "closed before completion"），不再永久挂死。
    public void Close() {
        nint lk = this.syncLock;
        if (lk == 0) { return; }
        List<Gate> toWake = null;
        Mutex.Lock(lk);
        if (!this.closed) {
            this.closed = true;
            toWake = TakeWaiters();
        }
        this.syncLock = 0;
        Mutex.Unlock(lk);
        WakeAll(toWake);
        Mutex.Destroy(lk);
    }
}
