using System;

namespace System.Threading;

/// <summary>
/// 跨平台轻量级非阻塞任务结果源，解耦结果生产者与消费者。
/// 生产者可在任意线程/Worker 触发 SetResult/SetException，
/// 消费者通过 Task 属性以 await 挂起等待，无忙轮询，不占用线程与渲染帧。
/// </summary>
class TaskCompletionSource<T> {
    T result;
    Exception error;
    bool isCompleted;
    Gate gate;
    nint syncLock;

    TaskCompletionSource() {
        this.isCompleted = false;
        this.error = null;
        this.gate = new Gate();
        this.syncLock = Mutex.Create();
    }

    /// <summary>任务是否已经完成（成功、失败或取消）。</summary>
    bool IsCompleted {
        get { return this.isCompleted; }
    }

    /// <summary>
    /// 将底层操作转换为可 await 的 Task&lt;T&gt;。
    /// 当 TCS 尚未完成时，协程挂起在底层事件门上；完成后直接返回结果。
    /// </summary>
    async Task<T> Task {
        get {
            if (!this.isCompleted) {
                while (!this.isCompleted) {
                    await this.gate.Wait();
                }
            }
            if (this.error != null) {
                throw this.error;
            }
            return this.result;
        }
    }

    /// <summary>尝试将任务标记为已成功完成并设置结果。</summary>
    bool TrySetResult(T value) {
        Mutex.Lock(this.syncLock);
        if (this.isCompleted) {
            Mutex.Unlock(this.syncLock);
            return false;
        }
        this.result = value;
        this.isCompleted = true;
        Mutex.Unlock(this.syncLock);
        this.gate.Signal();
        return true;
    }

    /// <summary>将任务标记为已成功完成并设置结果。若已完成则抛出异常。</summary>
    void SetResult(T value) {
        if (!this.TrySetResult(value)) {
            throw new Exception("TaskCompletionSource is already completed.");
        }
    }

    /// <summary>尝试将任务标记为发生错误并记录异常。</summary>
    bool TrySetException(Exception exc) {
        Mutex.Lock(this.syncLock);
        if (this.isCompleted) {
            Mutex.Unlock(this.syncLock);
            return false;
        }
        this.error = exc;
        this.isCompleted = true;
        Mutex.Unlock(this.syncLock);
        this.gate.Signal();
        return true;
    }

    /// <summary>将任务标记为发生错误并记录异常。若已完成则抛出异常。</summary>
    void SetException(Exception exc) {
        if (!this.TrySetException(exc)) {
            throw new Exception("TaskCompletionSource is already completed.");
        }
    }

    /// <summary>尝试将任务标记为已取消。</summary>
    bool TrySetCanceled() {
        return this.TrySetException(new Exception("The task was canceled."));
    }

    /// <summary>将任务标记为已取消。若已完成则抛出异常。</summary>
    void SetCanceled() {
        if (!this.TrySetCanceled()) {
            throw new Exception("TaskCompletionSource is already completed.");
        }
    }

    /// <summary>关闭并释放底层资源。</summary>
    void Close() {
        if (this.gate != null) {
            this.gate.Close();
        }
        if (this.syncLock != 0) {
            Mutex.Destroy(this.syncLock);
            this.syncLock = 0;
        }
    }
}
