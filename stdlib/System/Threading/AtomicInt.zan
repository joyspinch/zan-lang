using System;

namespace System.Threading;

// 用于 worker 线程间共享的顺序一致 64 位整数。
public class AtomicInt {
    public nint handle;

    [DllImport("crt", EntryPoint = "zan_atomic_int_create")]
    public static extern nint NativeCreate(long initialValue);

    [DllImport("crt", EntryPoint = "zan_atomic_int_destroy")]
    public static extern void NativeDestroy(nint handle);

    [DllImport("crt", EntryPoint = "zan_atomic_int_load")]
    public static extern long NativeLoad(nint handle);

    [DllImport("crt", EntryPoint = "zan_atomic_int_store")]
    public static extern void NativeStore(nint handle, long newValue);

    [DllImport("crt", EntryPoint = "zan_atomic_int_exchange")]
    public static extern long NativeExchange(nint handle, long newValue);

    [DllImport("crt", EntryPoint = "zan_atomic_int_compare_exchange")]
    public static extern long NativeCompareExchange(nint handle, long expected, long desired);

    [DllImport("crt", EntryPoint = "zan_atomic_int_add")]
    public static extern long NativeAdd(nint handle, long delta);

    // 创建初始值为 initialValue 的原子整数。
    public AtomicInt(long initialValue) {
        this.handle = NativeCreate(initialValue);
    }

    // 析构时销毁底层原子变量。
    ~AtomicInt() {
        if (this.handle != 0) {
            NativeDestroy(this.handle);
            this.handle = 0;
        }
    }

    // 底层句柄是否创建成功（0 = 无效）。
    public bool IsValid() {
        return this.handle != 0;
    }

    // 顺序一致读取当前值。
    public long Load() {
        return NativeLoad(this.handle);
    }

    // 顺序一致写入新值。
    public void Store(long newValue) {
        NativeStore(this.handle, newValue);
    }

    // 原子换入新值，返回旧值。
    public long Exchange(long newValue) {
        return NativeExchange(this.handle, newValue);
    }

    // 当前值 == expected 时换入 desired；返回旧值（== expected
    // 表示成功）。
    public long CompareExchange(long expected, long desired) {
        return NativeCompareExchange(this.handle, expected, desired);
    }

    // 原子加 delta，返回加后的新值。
    public long Add(long delta) {
        return NativeAdd(this.handle, delta);
    }

    // 原子 +1，返回新值。
    public long Increment() {
        return NativeAdd(this.handle, 1);
    }

    // 原子 -1，返回新值。
    public long Decrement() {
        return NativeAdd(this.handle, -1);
    }
}
