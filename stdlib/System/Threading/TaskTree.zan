using System;

namespace System.Threading;

// 运行时任务树监控与诊断工具（B-ID79 结构化并发）。
// 提供全局与局部协程活跃度探针、层级拓扑感知与批量取消。
public class TaskTree {
    [DllImport("crt", EntryPoint = "zan_co_live_count")]
    public static extern int zan_co_live_count();

    // 获取当前运行时全局存活的协程帧数量。
    public static int GetLiveCount() {
        return TaskTree.zan_co_live_count();
    }

    // 级联取消以 rootHandle 为根的任务。
    public static void CancelTree(long rootHandle) {
        if (rootHandle != 0) {
            Task.Cancel(rootHandle);
        }
    }

    // 查询指定任务是否仍在执行中。
    public static bool IsActive(long handle) {
        return handle != 0 && Task.IsDone(handle) == 0;
    }

    // 查询一组任务中处于活跃状态的个数。
    public static int CountActive(List<long> handles) {
        if (handles == null) { return 0; }
        int c = 0;
        for (int i = 0; i < handles.Count; i = i + 1) {
            if (TaskTree.IsActive(handles[i])) {
                c = c + 1;
            }
        }
        return c;
    }
}
