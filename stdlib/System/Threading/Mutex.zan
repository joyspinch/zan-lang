using System;
using System.Platform;

namespace System.Threading;

// 用于线程同步的跨平台互斥锁。
public class Mutex : IDisposable {
    nint handle;
    bool isDisposed;

    // 创建一个新的互斥锁实例。
    public Mutex() {
        this.handle = Mutex.Create();
        this.isDisposed = false;
    }

    // 阻塞等待并获取互斥锁（对齐工业级标准 API）。
    public void WaitOne() {
        if (!this.isDisposed && this.handle != 0) {
            Mutex.Lock(this.handle);
        }
    }

    // 释放已持有的互斥锁（对齐工业级标准 API）。
    public void ReleaseMutex() {
        if (!this.isDisposed && this.handle != 0) {
            Mutex.Unlock(this.handle);
        }
    }

    // 关闭并销毁底层互斥锁资源。
    public void Close() {
        if (!this.isDisposed) {
            this.isDisposed = true;
            if (this.handle != 0) {
                Mutex.Destroy(this.handle);
                this.handle = 0;
            }
        }
    }

    // 显式释放资源。
    public void Dispose() {
        this.Close();
    }

    // 创建底层互斥锁（由平台抽象层 PAL 决定 SRWLOCK 或 pthread_mutex）。
    public static nint Create() {
        return Pal.Threading.CreateMutex();
    }

    // 独占加锁（配对 Unlock）。
    public static void Lock(nint handle) {
        Pal.Threading.LockMutex(handle);
    }

    // 释放锁。
    public static void Unlock(nint handle) {
        Pal.Threading.UnlockMutex(handle);
    }

    // 销毁并释放原生内存。
    public static void Destroy(nint handle) {
        Pal.Threading.DestroyMutex(handle);
    }
}
