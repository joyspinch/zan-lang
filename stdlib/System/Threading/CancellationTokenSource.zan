using System;

namespace System.Threading;

// 取消令牌源，用于发送取消请求、超时取消与级联联动取消。
public class CancellationTokenSource : IDisposable {
    CancellationToken token;
    bool isDisposed;
    List<CancellationTokenRegistration> linkedRegistrations;

    public CancellationTokenSource() {
        this.token = new CancellationToken();
        this.isDisposed = false;
        this.linkedRegistrations = new List<CancellationTokenRegistration>();
    }

    // 创建在指定毫秒后自动触发取消的 CancellationTokenSource。
    public static CancellationTokenSource CreateAfter(int delayMs) {
        CancellationTokenSource cts = new CancellationTokenSource();
        if (delayMs > 0) {
            Task.Run(CancellationTokenSource.CancelDelayed(cts, delayMs));
        }
        return cts;
    }

    // 创建联动取消源：当两个指定令牌中任一被取消时，联动源立即取消。
    public static CancellationTokenSource CreateLinkedTokenSource(CancellationToken token1, CancellationToken token2) {
        CancellationTokenSource cts = new CancellationTokenSource();
        if (token1 != null) {
            cts.linkedRegistrations.Add(token1.Register(() => { cts.Cancel(); }));
        }
        if (token2 != null) {
            cts.linkedRegistrations.Add(token2.Register(() => { cts.Cancel(); }));
        }
        return cts;
    }

    // 创建联动取消源：当指定令牌列表中的任一令牌被取消时，联动源立即取消。
    public static CancellationTokenSource CreateLinkedTokenSource(List<CancellationToken> tokens) {
        CancellationTokenSource cts = new CancellationTokenSource();
        if (tokens != null) {
            for (int i = 0; i < tokens.Count; i = i + 1) {
                CancellationToken t = tokens[i];
                if (t != null) {
                    cts.linkedRegistrations.Add(t.Register(() => { cts.Cancel(); }));
                }
            }
        }
        return cts;
    }

    private static async void CancelDelayed(CancellationTokenSource cts, int delayMs) {
        await Task.Delay(delayMs);
        cts.Cancel();
    }

    // 获取关联的 CancellationToken。
    public CancellationToken Token {
        get { return this.token; }
    }

    // 请求取消操作。
    public void Cancel() {
        if (this.isDisposed) { return; }
        this.token.CancelInternal();
        // 联动源触发取消后，立即注销向所有父级注册的回调句柄，解除环形依赖与闭包生命周期悬挂
        if (this.linkedRegistrations != null && this.linkedRegistrations.Count > 0) {
            for (int i = 0; i < this.linkedRegistrations.Count; i = i + 1) {
                this.linkedRegistrations[i].Dispose();
            }
            this.linkedRegistrations.Clear();
        }
    }

    // 在指定毫秒后触发取消。
    public void CancelAfter(int delayMs) {
        if (this.isDisposed) { return; }
        if (delayMs <= 0) {
            this.Cancel();
            return;
        }
        Task.Run(CancellationTokenSource.CancelDelayed(this, delayMs));
    }

    // 释放关联资源。
    public void Dispose() {
        if (this.isDisposed) { return; }
        this.isDisposed = true;
        if (this.linkedRegistrations != null) {
            for (int i = 0; i < this.linkedRegistrations.Count; i = i + 1) {
                this.linkedRegistrations[i].Dispose();
            }
            this.linkedRegistrations.Clear();
        }
        this.token.Close();
    }

    ~CancellationTokenSource() {
        this.Dispose();
    }
}
