using System;
using System.Threading;

namespace System.Input;

/// <summary>Invoked on the hotkey thread when the registered combo is
/// pressed.</summary>
delegate void HotkeyCallback();

/// <summary>
/// Global hotkeys via RegisterHotKey. A background thread registers the
/// combo (hwnd = 0, so the WM_HOTKEY message lands on that thread's queue)
/// and pumps GetMessage; the callback runs on that thread.
///
///   Hotkey.Register("Ctrl+Shift+A", Demo.OnHotkey);
///   ...
///   Hotkey.Unregister();
///
/// Combo syntax: modifiers joined by '+' then a key name from
/// <see cref="Keyboard.VK"/> (case-insensitive), e.g. "Ctrl+Alt+F2",
/// "Shift+Esc". Only ONE hotkey can be live at a time; Unregister before
/// registering another. The callback is a static method (no captures).
///
/// Non-Windows builds expose the same API and throw
/// PlatformNotSupportedException.
/// </summary>
class Hotkey {
    /// Modifier bits accepted by Register(int, int, ...).
    static int ModAlt() { return 0x0001; }
    static int ModCtrl() { return 0x0002; }
    static int ModShift() { return 0x0004; }
    static int ModWin() { return 0x0008; }

    #if WINDOWS
    [DllImport("user32", EntryPoint = "RegisterHotKey")]
    static extern int RegisterHotKey(nint hwnd, int id, int mods, int vk);

    [DllImport("user32", EntryPoint = "UnregisterHotKey")]
    static extern int UnregisterHotKey(nint hwnd, int id);

    [DllImport("user32", EntryPoint = "GetMessageW")]
    static extern int GetMessageW(nint msg, nint hwnd, int min, int max);

    [DllImport("user32", EntryPoint = "PostThreadMessageW")]
    static extern int PostThreadMessageW(int threadId, int msg, nint wp, nint lp);

    [DllImport("kernel32", EntryPoint = "GetCurrentThreadId")]
    static extern int GetCurrentThreadId();

    static int hotkeyId;
    static int hotkeyMods;
    static int hotkeyVk;
    static int hotkeyThreadId;
    static int registered;
    static int wantExit;
    static int threadFailed;
    static HotkeyCallback callback;
    #endif

    /// <summary>Registers a hotkey from a "Ctrl+Shift+A" style combo. True
    /// when the combo is live; false when one is already registered or the
    /// combo is malformed (or already taken by another app).</summary>
    static bool Register(string combo, HotkeyCallback cb) {
        #if WINDOWS
        int mods = 0;
        string rest = combo;
        int plus = Hotkey.IndexOf(rest, "+", 0);
        while (plus >= 0) {
            string seg = rest.Substring(0, plus);
            rest = rest.Substring(plus + 1, rest.Length - plus - 1);
            string up = seg.ToUpper();
            if (up == "CTRL" || up == "CONTROL") { mods = mods | 2; }
            else if (up == "SHIFT") { mods = mods | 4; }
            else if (up == "ALT") { mods = mods | 1; }
            else if (up == "WIN" || up == "META") { mods = mods | 8; }
            else { return false; }   // a modifier segment must be a modifier
            plus = Hotkey.IndexOf(rest, "+", 0);
        }
        int vk = Keyboard.VK(rest);
        if (vk == 0) { return false; }
        return Hotkey.Register(vk, mods, cb);
        #else
        throw new PlatformNotSupportedException(
            "Hotkey.Register is not implemented on this platform");
        #endif
    }

    /// <summary>Registers a hotkey from a VK code and modifier bits (see
    /// <see cref="ModCtrl"/> etc.). True when the combo is live.</summary>
    static bool Register(int vk, int mods, HotkeyCallback cb) {
        #if WINDOWS
        if (Hotkey.registered != 0) { return false; }
        Hotkey.callback = cb;
        Hotkey.hotkeyVk = vk;
        Hotkey.hotkeyMods = mods;
        Hotkey.wantExit = 0;
        Hotkey.threadFailed = 0;
        Thread.Start(Hotkey.HotkeyThreadEntry);
        int waited = 0;
        while (Hotkey.registered == 0 && Hotkey.threadFailed == 0
               && waited < 3000) {
            Thread.Sleep(1);
            waited = waited + 1;
        }
        if (Hotkey.registered == 0) {
            Hotkey.callback = null;
            return false;   // combo already taken by another app
        }
        return true;
        #else
        throw new PlatformNotSupportedException(
            "Hotkey.Register is not implemented on this platform");
        #endif
    }

    /// <summary>Unregisters the live hotkey and joins its thread. Safe to
    /// call when none is registered.</summary>
    static void Unregister() {
        #if WINDOWS
        if (Hotkey.registered == 0) { return; }
        Hotkey.wantExit = 1;
        Hotkey.PostThreadMessageW(Hotkey.hotkeyThreadId, 0x0012 /*WM_QUIT*/,
                                  0, 0);
        while (Hotkey.registered != 0) { Thread.Sleep(1); }
        Hotkey.wantExit = 0;
        Hotkey.callback = null;
        #else
        throw new PlatformNotSupportedException(
            "Hotkey.Unregister is not implemented on this platform");
        #endif
    }

    #if WINDOWS
    /// Runs on the hotkey thread: register, pump until WM_HOTKEY fires the
    /// callback, unregister on exit.
    static void HotkeyThreadEntry() {
        Hotkey.hotkeyThreadId = Hotkey.GetCurrentThreadId();
        int id = 0x5A4E;   // arbitrary app id for this hotkey slot
        Hotkey.hotkeyId = id;
        if (Hotkey.RegisterHotKey(0, id, Hotkey.hotkeyMods, Hotkey.hotkeyVk)
                == 0) {
            Hotkey.threadFailed = 1;
            return;
        }
        Hotkey.registered = 1;
        nint msg = NativeMemory.Alloc(64);
        while (Hotkey.wantExit == 0) {
            int r = Hotkey.GetMessageW(msg, 0, 0, 0);
            if (r <= 0) { break; }
            // MSG: hwnd(8) message(4) wParam(8) lParam(8) time(4) pt(8);
            // Span<int> index 2 is the message id.
            Span<int> m = new Span<int>(msg, 16);
            if (m[2] == 0x0312 /*WM_HOTKEY*/) {
                if (Hotkey.callback != null) { Hotkey.callback(); }
            }
        }
        NativeMemory.Free(msg);
        Hotkey.UnregisterHotKey(0, Hotkey.hotkeyId);
        Hotkey.registered = 0;
    }

    /// First index of `needle` in `hay` at or after `from`, or -1.
    static int IndexOf(string hay, string needle, int from) {
        int n = needle.Length;
        int h = hay.Length;
        int i = from;
        while (i + n <= h) {
            if (hay.Substring(i, n) == needle) { return i; }
            i = i + 1;
        }
        return -1;
    }
    #endif
}
