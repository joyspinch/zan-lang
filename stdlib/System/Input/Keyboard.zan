using System;
using System.Diagnostics;
using System.IO;
using System.Threading;

namespace System.Input;

/// <summary>
/// 键盘输入：按键宏、Unicode 文本、按下/释放/重复、锁定键
/// 状态和 VK 名称表。Windows 通过 SendInput 注入，因此这些
/// 事件在每一层看来都像物理键盘输入（游戏、远程
/// 会话、提权提示）。X11 下走 xdotool（XTEST），macOS 走 System
/// Events；后端缺失或某个能力无等价物时抛出
/// PlatformNotSupportedException，而不是默默不发按键。
///
///   Keyboard.Send("{Ctrl}{C}");        // 宏：修饰键按下、按键、释放
///   Keyboard.SendText("你好, Zan");      // literal Unicode 文本
///   Keyboard.Press(Keyboard.VK("Enter"));
///
/// 宏是花括号中的按键名序列（修饰键保持按下直到
/// 结束）以及括号外的字面文本。单个字母和数字按
/// 按键按下；其余可打印文本按 Unicode 输入。宏结束时
/// 修饰键按相反顺序释放。
/// </summary>
class Keyboard {
    /// 修饰键，可用于任何接受 VK 码的地方。
    static int Ctrl() { return 0x11; }
    /// 修饰键 Shift（VK 0x10）。
    static int Shift() { return 0x10; }
    /// 修饰键 Alt（VK 0x12）。
    static int Alt() { return 0x12; }
    /// 修饰键 Win（VK 0x5B）。
    static int Win() { return 0x5B; }

    #if WINDOWS
    [DllImport("user32", EntryPoint = "SendInput")]
    static extern int WinSendInput(int count, nint inputs, int cbSize);

    [DllImport("user32", EntryPoint = "GetAsyncKeyState")]
    static extern short WinGetAsyncKeyState(int vk);

    [DllImport("user32", EntryPoint = "GetKeyState")]
    static extern short WinGetKeyState(int vk);

    [DllImport("user32", EntryPoint = "GetKeyboardState")]
    static extern int WinGetKeyboardState(nint buf);

    [DllImport("user32", EntryPoint = "SetKeyboardState")]
    static extern int WinSetKeyboardState(nint buf);

    [DllImport("user32", EntryPoint = "MapVirtualKeyW")]
    static extern int WinMapVirtualKey(int code, int mapType);

    // KEYEVENTF_* 标志位。
    /// KEYEVENTF_EXTENDEDKEY(0x0001)：扩展键。
    static int FExtended() { return 0x0001; }
    /// KEYEVENTF_KEYUP(0x0002)：抬起。
    static int FKeyUp() { return 0x0002; }
    /// KEYEVENTF_UNICODE(0x0004)：wScan 承载 Unicode 码点。
    static int FUnicode() { return 0x0004; }
    #endif

    /// <summary>按住 `vk`。</summary>
    static void Down(int vk) {
        #if WINDOWS
        Keyboard.SendKey(vk, 0);
        #else
        Keyboard.PosixKey(vk, "keydown", "Keyboard.Down");
        #endif
    }

    /// <summary>释放 `vk`。</summary>
    static void Up(int vk) {
        #if WINDOWS
        Keyboard.SendKey(vk, Keyboard.FKeyUp());
        #else
        Keyboard.PosixKey(vk, "keyup", "Keyboard.Up");
        #endif
    }

    /// <summary>按下并释放 `vk` 一次。</summary>
    static void Press(int vk) {
        #if MACOS
        // System Events 没有单独的按下/释放，只有“敲一下”
        int code = InputTool.MacKeyCode(vk);
        if (code < 0) {
            throw new PlatformNotSupportedException(
                "Keyboard.Press: no macOS key code for VK 0x" + Keyboard.Hex(vk));
        }
        if (!InputTool.Osa("tell application \"System Events\" to key code "
                           + Convert.ToString(code))) {
            throw new IOException("Keyboard.Press: osascript failed");
        }
        #else
        Keyboard.Down(vk);
        Keyboard.Up(vk);
        #endif
    }

    /// <summary>连续按下并释放 `vk` `n` 次。</summary>
    static void Repeat(int vk, int n) {
        for (int i = 0; i < n; i = i + 1) {
            Keyboard.Press(vk);
        }
    }

    /// <summary>将 `text` 作为字面 Unicode 文本输入——与键盘布局无关，
    /// 对 CJK 和符号安全（使用 KEYEVENTF_UNICODE 而非 VK 码）。</summary>
    static void SendText(string text) {
        #if WINDOWS
        for (int i = 0; i < text.Length; i = i + 1) {
            Keyboard.SendUnicode(text.Substring(i, 1), 0);
            Keyboard.SendUnicode(text.Substring(i, 1), Keyboard.FKeyUp());
        }
        #elif MACOS
        // 文本只进临时 AppleScript 文件，不进命令行
        if (!InputTool.Osa("tell application \"System Events\" to keystroke \""
                           + Keyboard.OsaQuote(text) + "\"")) {
            throw new IOException("Keyboard.SendText: osascript failed");
        }
        #else
        if (InputTool.Kind() != InputTool.Xdotool()) {
            InputTool.Missing("Keyboard.SendText");
        }
        // 用 --file - 从 stdin 读文本（xdotool 支持），避开命令行拼接
        string tmp = Keyboard.WriteTemp(text);
        int rc = Process.Run("xdotool type --clearmodifiers --file '" + tmp
                             + "' >/dev/null 2>&1");
        File.Delete(tmp);
        if (rc != 0) { throw new IOException("Keyboard.SendText: xdotool failed"); }
        #endif
    }

    /// <summary>播放按键宏；格式见类文档。</summary>
    static void Send(string macro) {
        #if MACOS
        Keyboard.MacSend(macro);
        return;
        #endif
        List<int> held = new List<int>();
        int i = 0;
        while (i < macro.Length) {
            string ch = macro.Substring(i, 1);
            if (ch == "{") {
                int close = Keyboard.IndexOf(macro, "}", i + 1);
                if (close < 0) { break; }   // 花括号未闭合：停止
                string name = macro.Substring(i + 1, close - i - 1);
                int vk = Keyboard.VK(name);
                if (vk != 0) {
                    Keyboard.Down(vk);
                    held.Add(vk);
                }
                i = close + 1;
            } else if (ch == "}") {
                i = i + 1;   // 多余的右花括号：忽略
            } else {
                // 直到下一个花括号（或末尾）的字面文本段。
                int b = i;
                while (b < macro.Length && macro.Substring(b, 1) != "{") {
                    b = b + 1;
                }
                string text = macro.Substring(i, b - i);
                if (text.Length == 1 && Keyboard.IsKeyChar(text)) {
                    Keyboard.Press(Keyboard.CharVK(text));
                } else if (text != "") {
                    Keyboard.SendText(text);
                }
                i = b;
            }
        }
        // 按按下的相反顺序释放修饰键。
        int j = held.Count - 1;
        while (j >= 0) {
            Keyboard.Up(held[j]);
            j = j - 1;
        }
    }

    /// <summary>`vk` 被物理按住时为真。</summary>
    static bool IsDown(int vk) {
        #if WINDOWS
        return (Keyboard.WinGetAsyncKeyState(vk) & 0x8000) != 0;
        #else
        throw new PlatformNotSupportedException(
            "Keyboard.IsDown needs a live X11/Quartz keyboard query, which "
            + "the command-line injection backends do not provide");
        #endif
    }

    /// <summary>切换键（`CapsLock`/`NumLock`/`ScrollLock`）
    /// 当前处于开启状态时为真。</summary>
    static bool IsToggled(int vk) {
        #if WINDOWS
        return (Keyboard.WinGetKeyState(vk) & 0x0001) != 0;
        #elif MACOS
        throw new PlatformNotSupportedException(
            "Keyboard.IsToggled is not available through System Events");
        #else
        if (InputTool.Kind() != InputTool.Xdotool()) {
            InputTool.Missing("Keyboard.IsToggled");
        }
        // xset q 报 LED 掩码："  auto repeat:  on    key click percent..."
        //                        "  LED mask:  00000002"
        // bit0 = CapsLock, bit1 = NumLock, bit2 = ScrollLock
        int bit = 0;
        if (vk == 0x14) { bit = 1; }
        else if (vk == 0x90) { bit = 2; }
        else if (vk == 0x91) { bit = 4; }
        else {
            throw new ArgumentException("not a lock key");
        }
        ProcessResult r = Process.Capture("xset q 2>/dev/null");
        for (int i = 0; i < r.lines.Count; i = i + 1) {
            int at = r.lines[i].IndexOf("LED mask:");
            if (at < 0) { continue; }
            string hex = r.lines[i].Substring(at + 9, r.lines[i].Length - at - 9).Trim();
            return (Keyboard.ParseHex(hex) & bit) != 0;
        }
        throw new IOException("xset q reported no LED mask");
        #endif
    }

    /// <summary>CapsLock 开启时为真。</summary>
    static bool CapsLock() {
        return Keyboard.IsToggled(0x14);
    }

    /// <summary>NumLock 开启时为真。</summary>
    static bool NumLock() {
        return Keyboard.IsToggled(0x90);
    }

    /// <summary>ScrollLock 开启时为真。</summary>
    static bool ScrollLock() {
        return Keyboard.IsToggled(0x91);
    }

    /// <summary>设置 CapsLock 状态（0x14）。</summary>
    static void SetCapsLock(bool on) {
        Keyboard.SetToggle(0x14, on);
    }

    /// <summary>设置 NumLock 状态（0x90）。</summary>
    static void SetNumLock(bool on) {
        Keyboard.SetToggle(0x90, on);
    }

    /// <summary>设置 ScrollLock 状态（0x91）。</summary>
    static void SetScrollLock(bool on) {
        Keyboard.SetToggle(0x91, on);
    }

    /// <summary>阻塞直到 `vk` 被释放。以 1 ms 间隔轮询。</summary>
    static void WaitUp(int vk) {
        while (Keyboard.IsDown(vk)) { Thread.Sleep(1); }
    }

    /// <summary>阻塞直到 `vk` 被按下。以 1 ms 间隔轮询。</summary>
    static void Wait(int vk) {
        while (!Keyboard.IsDown(vk)) { Thread.Sleep(1); }
    }

    /// <summary>键名转 VK 码。名称不区分大小写。可识别
    /// 修饰键、功能键、导航键以及单个字母/数字；
    /// 未知名称返回 0。</summary>
    static int VK(string name) {
        string n = name.ToUpper();
        if (n == "CTRL" || n == "CONTROL") { return 0x11; }
        if (n == "SHIFT") { return 0x10; }
        if (n == "ALT") { return 0x12; }
        if (n == "WIN" || n == "META") { return 0x5B; }
        if (n == "ENTER" || n == "RETURN") { return 0x0D; }
        if (n == "ESC" || n == "ESCAPE") { return 0x1B; }
        if (n == "TAB") { return 0x09; }
        if (n == "BACKSPACE" || n == "BS") { return 0x08; }
        if (n == "SPACE") { return 0x20; }
        if (n == "DELETE" || n == "DEL") { return 0x2E; }
        if (n == "INSERT" || n == "INS") { return 0x2D; }
        if (n == "HOME") { return 0x24; }
        if (n == "END") { return 0x23; }
        if (n == "PAGEUP" || n == "PGUP") { return 0x21; }
        if (n == "PAGEDOWN" || n == "PGDN") { return 0x22; }
        if (n == "UP") { return 0x26; }
        if (n == "DOWN") { return 0x28; }
        if (n == "LEFT") { return 0x25; }
        if (n == "RIGHT") { return 0x27; }
        if (n == "CAPSLOCK") { return 0x14; }
        if (n == "NUMLOCK") { return 0x90; }
        if (n == "SCROLLLOCK") { return 0x91; }
        // F1..F24
        if (n.Length >= 2 && n.Substring(0, 1) == "F") {
            int num = Keyboard.ParseInt(n.Substring(1, n.Length - 1));
            if (num >= 1 && num <= 24) { return 0x6F + num; }
        }
        // 单个字母/数字
        if (n.Length == 1) {
            int c = Keyboard.CharVK(n);
            if (c != 0) { return c; }
        }
        return 0;
    }

    /// <summary>VK 码转显示名称（"Ctrl"、"F5"、"A" 等）。没有名称的码
    /// 返回 "VK-0xNN"。</summary>
    static string VKName(int vk) {
        if (vk == 0x11) { return "Ctrl"; }
        if (vk == 0x10) { return "Shift"; }
        if (vk == 0x12) { return "Alt"; }
        if (vk == 0x5B) { return "Win"; }
        if (vk == 0x0D) { return "Enter"; }
        if (vk == 0x1B) { return "Esc"; }
        if (vk == 0x09) { return "Tab"; }
        if (vk == 0x08) { return "Backspace"; }
        if (vk == 0x20) { return "Space"; }
        if (vk == 0x2E) { return "Delete"; }
        if (vk == 0x2D) { return "Insert"; }
        if (vk == 0x24) { return "Home"; }
        if (vk == 0x23) { return "End"; }
        if (vk == 0x21) { return "PageUp"; }
        if (vk == 0x22) { return "PageDown"; }
        if (vk == 0x26) { return "Up"; }
        if (vk == 0x28) { return "Down"; }
        if (vk == 0x25) { return "Left"; }
        if (vk == 0x27) { return "Right"; }
        if (vk >= 0x41 && vk <= 0x5A) {
            return Keyboard.Letter(vk - 0x41);
        }
        if (vk >= 0x30 && vk <= 0x39) {
            return Keyboard.Digit(vk - 0x30);
        }
        if (vk >= 0x70 && vk <= 0x87) {
            return "F" + Convert.ToString(vk - 0x6F);
        }
        return "VK-0x" + Keyboard.Hex(vk);
    }

    #if WINDOWS
    /// 发送一个键盘 INPUT 事件（x64 下 INPUT 布局：type + padding +
    /// KEYBDINPUT；wVk/wScan 共享偏移 8 处的 32 位字）。
    static void SendKey(int vk, int flags) {
        nint input = NativeMemory.Alloc(32);
        Span<int> w = new Span<int>(input, 8);
        w[0] = 1;            // INPUT 类型：键盘
        int scan = 0;
        if ((flags & Keyboard.FKeyUp()) == 0 && vk != 0) {
            scan = Keyboard.MapScan(vk);
        }
        w[2] = vk + scan * 65536;   // wVk（低字）+ wScan（高字）
        w[3] = flags;        // KEYBDINPUT.dwFlags
        w[4] = 0;            // KEYBDINPUT.time
        // KEYBDINPUT.dwExtraInfo 位于偏移 24 处；w[6..7] 以零填充。
        WinSendInput(1, input, 32);
        NativeMemory.Free(input);
    }

    /// 为 `ch` 发送一个 Unicode（KEYEVENTF_UNICODE）按键事件。
    static void SendUnicode(string ch, int flags) {
        nint input = NativeMemory.Alloc(32);
        Span<int> w = new Span<int>(input, 8);
        w[0] = 1;            // INPUT 类型：键盘
        int scan = Keyboard.CodeOf(ch);
        w[2] = scan * 65536; // wScan 承载码点（wVk = 0）
        w[3] = flags | Keyboard.FUnicode();
        w[4] = 0;
        WinSendInput(1, input, 32);
        NativeMemory.Free(input);
    }
    #endif

    #if WINDOWS
    /// MapVirtualKey(MAPVK_VK_TO_VSC, 0)：VK 码转硬件扫描码。
    static int MapScan(int vk) {
        return Keyboard.WinMapVirtualKey(vk, 0);
    }
    #endif

    #if !WINDOWS
    /// 通过 xdotool 发送一次 keydown/keyup。keysym 未知时明确报错，
    /// 而不是发一个碰巧能编出来的错键。
    static void PosixKey(int vk, string action, string what) {
        #if MACOS
        throw new PlatformNotSupportedException(
            what + ": System Events has no key-down/key-up primitive, only "
            + "whole keystrokes (use Keyboard.Press/Send/SendText)");
        #else
        if (InputTool.Kind() != InputTool.Xdotool()) { InputTool.Missing(what); }
        string sym = InputTool.Keysym(vk);
        if (sym.Length == 0) {
            throw new PlatformNotSupportedException(
                what + ": no X11 keysym for VK 0x" + Keyboard.Hex(vk));
        }
        if (!InputTool.Run("xdotool " + action + " --clearmodifiers " + sym)) {
            throw new IOException(what + ": xdotool failed");
        }
        #endif
    }

    /// 将文本写进临时文件（xdotool type --file 从这里读），返回路径。
    static string WriteTemp(string text) {
        string tmp = Path.GetTempPath() + "zan_type_"
            + Convert.ToString(ProcessHost.Pid()) + ".txt";
        File.WriteAllText(tmp, text);
        return tmp;
    }

    /// AppleScript 字符串字面量转义（反斜杠和双引号）。
    static string OsaQuote(string s) {
        string outp = "";
        for (int i = 0; i < s.Length; i = i + 1) {
            string ch = s.Substring(i, 1);
            if (ch == "\\" || ch == "\"") { outp = outp + "\\"; }
            outp = outp + ch;
        }
        return outp;
    }

    /// 解析十六进制串（xset 的 LED 掩码）；非法字符处停止。
    static int ParseHex(string s) {
        int v = 0;
        for (int i = 0; i < s.Length; i = i + 1) {
            int c = Keyboard.CodeOf(s.Substring(i, 1));
            int d = -1;
            if (c >= 0x30 && c <= 0x39) { d = c - 0x30; }
            else if (c >= 0x61 && c <= 0x66) { d = c - 0x61 + 10; }
            else if (c >= 0x41 && c <= 0x46) { d = c - 0x41 + 10; }
            if (d < 0) { break; }
            v = v * 16 + d;
        }
        return v;
    }
    #endif

    #if MACOS
    /// macOS 的宏播放：System Events 没有 keydown/keyup，因此修饰键
    /// 只能作为每次 keystroke/key code 的 `using` 子句一起发出。
    static void MacSend(string macro) {
        List<string> mods = new List<string>();
        int i = 0;
        while (i < macro.Length) {
            string ch = macro.Substring(i, 1);
            if (ch == "{") {
                int close = Keyboard.IndexOf(macro, "}", i + 1);
                if (close < 0) { break; }
                string name = macro.Substring(i + 1, close - i - 1);
                int vk = Keyboard.VK(name);
                string mod = InputTool.MacModifier(vk);
                if (mod.Length > 0) {
                    mods.Add(mod);
                } else if (vk != 0) {
                    Keyboard.MacKey(vk, mods);
                }
                i = close + 1;
            } else if (ch == "}") {
                i = i + 1;
            } else {
                int b = i;
                while (b < macro.Length && macro.Substring(b, 1) != "{") {
                    b = b + 1;
                }
                string text = macro.Substring(i, b - i);
                if (text != "") { Keyboard.MacText(text, mods); }
                i = b;
            }
        }
    }

    /// 拼 AppleScript 的 `using {..}` 修饰键子句；无修饰键返回 ""。
    static string MacUsing(List<string> mods) {
        if (mods.Count == 0) { return ""; }
        string s = " using {";
        for (int i = 0; i < mods.Count; i = i + 1) {
            if (i > 0) { s = s + ", "; }
            s = s + mods[i];
        }
        return s + "}";
    }

    /// 发一次 key code 敲击（带修饰键 using 子句）；VK 无 macOS 键码
    /// 或 osascript 失败时抛异常。
    static void MacKey(int vk, List<string> mods) {
        int code = InputTool.MacKeyCode(vk);
        if (code < 0) {
            throw new PlatformNotSupportedException(
                "Keyboard.Send: no macOS key code for VK 0x" + Keyboard.Hex(vk));
        }
        if (!InputTool.Osa("tell application \"System Events\" to key code "
                           + Convert.ToString(code) + Keyboard.MacUsing(mods))) {
            throw new IOException("Keyboard.Send: osascript failed");
        }
    }

    /// 发一次文本 keystroke（带修饰键 using 子句）；osascript 失败时抛异常。
    static void MacText(string text, List<string> mods) {
        if (!InputTool.Osa("tell application \"System Events\" to keystroke \""
                           + Keyboard.OsaQuote(text) + "\""
                           + Keyboard.MacUsing(mods))) {
            throw new IOException("Keyboard.Send: osascript failed");
        }
    }
    #endif

    /// `v` 的小写十六进制（无前导零），用于 VK-0x 显示名称。
    static string Hex(int v) {
        if (v == 0) { return "0"; }
        string digits = "0123456789abcdef";
        string s = "";
        int n = v;
        while (n > 0) {
            int d = n % 16;
            s = digits.Substring(d, 1) + s;
            n = n / 16;
        }
        return s;
    }

    /// 仅当锁定键处于错误状态时才按下它，将其切换为 `on`（
    /// 避免无条件按下导致状态反了）。
    static void SetToggle(int vk, bool on) {
        if (Keyboard.IsToggled(vk) != on) { Keyboard.Press(vk); }
    }

    /// 单个字母或数字时为真（在宏中作为 VK 按下输入）。
    static bool IsKeyChar(string ch) {
        if (ch.Length != 1) { return false; }
        int c = Keyboard.CodeOf(ch);
        return (c >= 0x41 && c <= 0x5A) || (c >= 0x61 && c <= 0x7A)
            || (c >= 0x30 && c <= 0x39);
    }

    /// 单个字母/数字对应的 VK 码，否则为 0。
    static int CharVK(string ch) {
        int c = Keyboard.CodeOf(ch);
        if (c >= 0x61 && c <= 0x7A) { return c - 0x20; }   // a-z -> A-Z VK
        if (c >= 0x41 && c <= 0x5A) { return c; }
        if (c >= 0x30 && c <= 0x39) { return c; }
        return 0;
    }

    /// 单字符字符串的码点（首个字节的 UTF-8 解码；
    /// ASCII 快速路径）。空字符串返回 0。
    static int CodeOf(string ch) {
        if (ch.Length == 0) { return 0; }
        nint buf = NativeMemory.Alloc(8);
        NativeMemory.PutString(buf, 0, ch, ch.Length);
        Span<byte> b = new Span<byte>(buf, 4);
        int c0 = b[0];
        int cp = 0;
        if ((c0 & 0x80) == 0) {
            cp = c0;
        } else if ((c0 & 0xE0) == 0xC0 && ch.Length >= 2) {
            cp = ((c0 & 0x1F) << 6) | (b[1] & 0x3F);
        } else if ((c0 & 0xF0) == 0xE0 && ch.Length >= 3) {
            cp = ((c0 & 0x0F) << 12) | ((b[1] & 0x3F) << 6) | (b[2] & 0x3F);
        } else if ((c0 & 0xF8) == 0xF0 && ch.Length >= 4) {
            cp = ((c0 & 0x07) << 18) | ((b[1] & 0x3F) << 12)
                | ((b[2] & 0x3F) << 6) | (b[3] & 0x3F);
        }
        NativeMemory.Free(buf);
        return cp;
    }

    /// `needle` 在 `hay` 中从 `from` 起的第一个索引，找不到返回 -1。
    static int IndexOf(string hay, string needle, int from) {
        int n = needle.Length;
        int h = hay.Length;
        int i = from;
        while (i + n <= h) {
            if (hay.Substring(i, n) == needle) { return i; }
            i = i + 1;
        }
        return -1;
    }

    /// 解析非负十进制整数；格式错误返回 -1。
    static int ParseInt(string s) {
        if (s.Length == 0) { return -1; }
        int v = 0;
        for (int i = 0; i < s.Length; i = i + 1) {
            string ch = s.Substring(i, 1);
            int c = Keyboard.CodeOf(ch);
            if (c < 0x30 || c > 0x39) { return -1; }
            v = v * 10 + (c - 0x30);
        }
        return v;
    }

    /// 0..25 对应 "A".."Z"。
    static string Letter(int index) {
        int c = 0x41 + index;
        return Keyboard.FromCode(c);
    }

    /// 0..9 对应 "0".."9"。
    static string Digit(int index) {
        return Keyboard.FromCode(0x30 + index);
    }

    /// ASCII 码点转单字符字符串。
    static string FromCode(int c) {
        nint buf = NativeMemory.Alloc(2);
        Span<byte> b = new Span<byte>(buf, 2);
        b[0] = (byte)c;
        string s = NativeMemory.GetString(buf, 0, 1);
        NativeMemory.Free(buf);
        return s;
    }
}
