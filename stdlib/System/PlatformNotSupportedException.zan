using System;

namespace System;

// 当跨平台 API 在当前平台
// 没有实现时抛出。接口在所有平台都存在，因此代码各处都能编译运行；
// 不支持的那一半会显式报错，而不是静默
// 不做事。
public class PlatformNotSupportedException : Exception {
    // 以描述平台不支持原因的消息构造。
    public PlatformNotSupportedException(string message) {
        Message = message;
    }
}

// 当传递给方法的参数为 null 且该方法不接受 null 时抛出。
