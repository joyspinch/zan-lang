using System;
using System.Platform;

namespace System;

// 动态链接库加载、符号解析与系统调用的跨平台互操作门面。
// 底层原生调用与系统错误码均下沉至平台抽象层（Pal.Library / Pal.Environment），
// 统一提供强类型、零 #if WINDOWS 条件编译的共享库生命周期管理与 SafeHandle 作用域释放。
public class Interop {
    // 兼容历史调用方（WebViewBackend 等）
    public static nint PosixLoad(string name, int flags) {
        return Pal.Library.LoadLibrary(name);
    }

    public static nint WinLoad(string name) {
        return Pal.Library.LoadLibrary(name);
    }

    public static int RtldNowLocal() {
        #if LINUX
        return 2;
        #else
        return 6;
        #endif
    }

    // 最近一次 Load/Symbol 失败的原因文本。
    public static string lastError = "";

    // 上次失败加载的原生加载器错误文本（dlerror / Win32 错误码）；
    // 没有失败时为空字符串。
    public static string LastError() {
        return Pal.Library.GetLastError();
    }

    // 按名称或路径加载共享库；不存在时返回 0。
    public static nint Load(string name) {
        nint m = Pal.Library.LoadLibrary(name);
        Interop.lastError = Pal.Library.GetLastError();
        return m;
    }

    // 安全加载共享库并返回受 SafeHandle 保护的句柄；可配合 using 语句在离开作用域时自动卸载。
    public static SafeLibraryHandle LoadLibrarySafe(string name) {
        nint mod = Interop.Load(name);
        return new SafeLibraryHandle(mod);
    }

    // 导出入口点的地址；库中没有时返回 0
    // （一种以 ABI 兼容方式探测新运行时特性的做法）。
    public static nint Symbol(nint mod, string name) {
        nint s = Pal.Library.GetSymbol(mod, name);
        Interop.lastError = Pal.Library.GetLastError();
        return s;
    }

    // 卸载共享库；句柄为 0 时忽略。
    public static void Unload(nint mod) {
        Pal.Library.FreeLibrary(mod);
    }

    // 一步加载 `name` 并解析 `entry`；任一失败返回 0。
    public static nint Entry(string name, string entry) {
        return Interop.Symbol(Interop.Load(name), entry);
    }

    // 将跨平台共享库名规范化为平台本地文件名（例如 "sqlite3" -> "sqlite3.dll" / "libsqlite3.so" / "libsqlite3.dylib"）。
    public static string MapLibraryName(string name) {
        return Pal.Library.MapLibraryName(name);
    }

    // 从活动进程块读取环境变量，未设置时返回空字符串。
    public static string EnvVar(string name) {
        return Pal.Environment.GetEnvironmentVariable(name);
    }
}
