using System;
using System.Platform;

namespace System;

// 跨平台宽字符（wchar_t）文本封送器。
// 底层平台系统调用下沉至平台抽象层（Pal.Text），
// Windows 上使用 Win32 UTF-16 封送，POSIX (Linux / macOS / WASI) 上使用 4 字节 UTF-32 封送。
public class Wide {
    #if WINDOWS
    [DllImport("kernel32", EntryPoint = "MultiByteToWideChar")]
    public static extern int ToWide(int page, int flags, nint mb, int mbLen,
                                    nint wide, int wideLen);

    [DllImport("kernel32", EntryPoint = "WideCharToMultiByte")]
    public static extern int ToMulti(int page, int flags, nint wide, int wideLen,
                                     nint mb, int mbLen, nint defChar, nint usedDef);
    #endif

    // 代码页 CP_UTF8（65001）。
    public static int Utf8() { return 65001; }

    // 平台原生 wchar_t 字节大小：Windows 为 2，POSIX 为 4。
    public static int CharSize() {
        return Pal.Text.CharSize();
    }

    // 分配 `s` 的以 NUL 结尾的原生宽字符副本。用 Free() 释放。
    // null 返回 0，不再空引用崩溃。
    public static nint Of(string s) {
        return Pal.Text.StringToWide(s);
    }

    // 将以 NUL 结尾的原生宽字符缓冲区复制回 Zan UTF-8 字符串。
    public static string Read(nint p) {
        return Pal.Text.WideToString(p);
    }

    // 宽字符缓冲区中 NUL 终止符前的字符数量。
    public static int Length(nint p) {
        return Pal.Text.WideLength(p);
    }

    // 释放 Of() 分配的缓冲区。
    public static void Free(nint p) {
        Pal.Text.Free(p);
    }
}

// vtable 方法的调用形式：每个 COM 方法都把接口
// 指针作为第一个参数并返回 HRESULT，宽于
// 寄存器的参数（RECT、结构体出参）以地址传递。
// ComCall0Fn 到 ComCall5Fn 依次带 0 到 5 个指针参数。
public delegate int ComCall0Fn(nint self);
// 1 个指针参数的 COM 方法形式。
public delegate int ComCall1Fn(nint self, nint a);
// 2 个指针参数的 COM 方法形式。
public delegate int ComCall2Fn(nint self, nint a, nint b);
// 3 个指针参数的 COM 方法形式。
