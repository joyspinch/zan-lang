using System;
using System.Numerics;
using System.Runtime.CompilerServices;
using System.Runtime.Intrinsics;

namespace System;

// 堆外原始内存与硬件加速原语（地址必须来自 Alloc 或固定缓冲，Free 后禁用，不做边界检查）。
[Intrinsic]
public class NativeMemory {
    [DllImport("crt")]
    public static extern nint Alloc(int size);

    [DllImport("crt")]
    public static extern void Free(nint p);

    // 允许重叠（memmove 语义）。
    [DllImport("crt")]
    public static extern void Copy(nint dst, nint src, int n);

    [DllImport("crt")]
    public static extern void Copy2D(nint dst, int dstStride, nint src, int srcStride, int rowBytes, int height);

    [DllImport("crt")]
    public static extern void Fill(nint p, int v, int n);

    [DllImport("crt")]
    public static extern int Compare(nint a, nint b, int n);

    [DllImport("crt")]
    public static extern int Find(nint p, int off, int b, int n);

    [DllImport("crt")]
    public static extern string GetString(nint p, int off, int len);

    // 不写 NUL 终止符。
    [DllImport("crt")]
    public static extern void PutString(nint p, int off, string s, int len);

    // IEEE-754 bitcast（NaN 归一为 quiet 位型；-0.0 符号位原位保留）。
    [DllImport("crt")]
    public static extern int AsI32(float value);

    [DllImport("crt")]
    public static extern float AsF32(int bits);

    [DllImport("crt")]
    public static extern long AsI64(double value);

    [DllImport("crt")]
    public static extern double AsF64(long bits);

    public static long Crc32(nint p, long len) { return NativeMemory.Crc32Update(0, p, len); }

    [DllImport("crt", EntryPoint = "zan_hw_ffi_crc32_update")]
    public static extern long Crc32Update(long crc, nint p, long len);

    [DllImport("crt", EntryPoint = "zan_hw_ffi_crc32c")]
    public static extern long Crc32C(nint p, long len);

    // 无硬件路径返回 -1（合法 CRC 恒为非负 32 位数）。
    [DllImport("crt", EntryPoint = "zan_hw_ffi_crc32c_update")]
    public static extern long Crc32CUpdate(long crc, nint p, long len);

    // 返回新的 ARC 托管摘要字符串，无硬件路径返回 null。
    public static string Sha256(nint p, int len) { return NativeMemory.Sha256(p, (long)len); }

    public static string Sha256(nint p, long len) {
        byte[] digest = new byte[32];
        if (Sha256Core(p, len, (nint)digest) < 0) { return null; }
        return digest.ToStr();
    }

    // 零中间字符串直接写入调用方 32 字节目标缓冲；无硬件路径返回 < 0。
    public static long Sha256Into(nint p, long len, nint dst) {
        return Sha256Core(p, len, dst);
    }

    public static byte[] Sha256Bytes(nint p, long len) {
        byte[] digest = new byte[32];
        if (Sha256Core(p, len, (nint)digest) < 0) { return null; }
        return digest;
    }

    [DllImport("crt", EntryPoint = "zan_hw_ffi_sha256")]
    private static extern long Sha256Core(nint p, long len, nint dst);

    public static string Sha1(nint p, int len) { return NativeMemory.Sha1(p, (long)len); }

    public static string Sha1(nint p, long len) {
        byte[] digest = new byte[20];
        if (Sha1Core(p, len, (nint)digest) < 0) { return null; }
        return digest.ToStr();
    }

    public static long Sha1Into(nint p, long len, nint dst) {
        return Sha1Core(p, len, dst);
    }

    public static byte[] Sha1Bytes(nint p, long len) {
        byte[] digest = new byte[20];
        if (Sha1Core(p, len, (nint)digest) < 0) { return null; }
        return digest;
    }

    [DllImport("crt", EntryPoint = "zan_hw_ffi_sha1")]
    private static extern long Sha1Core(nint p, long len, nint dst);

    public static string Sha512(nint p, int len) { return NativeMemory.Sha512(p, (long)len); }

    public static string Sha512(nint p, long len) {
        byte[] digest = new byte[64];
        if (Sha512Core(p, len, (nint)digest) < 0) { return null; }
        return digest.ToStr();
    }

    public static long Sha512Into(nint p, long len, nint dst) {
        return Sha512Core(p, len, dst);
    }

    public static byte[] Sha512Bytes(nint p, long len) {
        byte[] digest = new byte[64];
        if (Sha512Core(p, len, (nint)digest) < 0) { return null; }
        return digest;
    }

    [DllImport("crt", EntryPoint = "zan_hw_ffi_sha512")]
    private static extern long Sha512Core(nint p, long len, nint dst);

    public static long AesCbcEncrypt(nint dst, nint src, long size, nint key, int keybits, nint iv) {
        return AesCbcEncryptCore(dst, src, size, key, (long)keybits, iv);
    }

    [DllImport("crt", EntryPoint = "zan_hw_ffi_aes_cbc_encrypt")]
    private static extern long AesCbcEncryptCore(nint dst, nint src, long size, nint key, long keybits, nint iv);

    public static long AesCbcDecrypt(nint dst, nint src, long size, nint key, int keybits, nint iv) {
        return AesCbcDecryptCore(dst, src, size, key, (long)keybits, iv);
    }

    [DllImport("crt", EntryPoint = "zan_hw_ffi_aes_cbc_decrypt")]
    private static extern long AesCbcDecryptCore(nint dst, nint src, long size, nint key, long keybits, nint iv);

    public static long AesEcbBlock(nint key, int keybits, nint in16, nint out16) {
        return AesEcbBlockCore(key, (long)keybits, in16, out16);
    }

    [DllImport("crt", EntryPoint = "zan_hw_ffi_aes_ecb_block")]
    private static extern long AesEcbBlockCore(nint key, long keybits, nint in16, nint out16);

    public static long AesCtrCrypt(nint dst, nint src, long size, nint key, int keybits, nint counter) {
        return AesCtrCryptCore(dst, src, size, key, (long)keybits, counter);
    }

    [DllImport("crt", EntryPoint = "zan_hw_ffi_aes_ctr_crypt")]
    private static extern long AesCtrCryptCore(nint dst, nint src, long size, nint key, long keybits, nint counter);

    [DllImport("crt", EntryPoint = "zan_hw_ffi_ghash_block")]
    public static extern long GhashBlock(nint h, nint x, nint y);

    [DllImport("crt", EntryPoint = "zan_hw_ffi_ghash_update")]
    public static extern long GhashUpdate(nint h, nint data, long len, nint y);

    public static long AesGcmEncrypt(nint key, int keybits, nint iv, nint aad, long aadLen, nint inBuf, long inLen, nint outBuf, nint tag16) {
        return AesGcmEncryptCore(key, (long)keybits, iv, aad, aadLen, inBuf, inLen, outBuf, tag16);
    }

    [DllImport("crt", EntryPoint = "zan_hw_ffi_aes_gcm_encrypt")]
    private static extern long AesGcmEncryptCore(nint key, long keybits, nint iv, nint aad, long aadLen, nint inBuf, long inLen, nint outBuf, nint tag16);

    public static long AesGcmDecrypt(nint key, int keybits, nint iv, nint aad, long aadLen, nint inBuf, long inLen, nint tag16, nint outBuf) {
        return AesGcmDecryptCore(key, (long)keybits, iv, aad, aadLen, inBuf, inLen, tag16, outBuf);
    }

    [DllImport("crt", EntryPoint = "zan_hw_ffi_aes_gcm_decrypt")]
    private static extern long AesGcmDecryptCore(nint key, long keybits, nint iv, nint aad, long aadLen, nint inBuf, long inLen, nint tag16, nint outBuf);

    // ctxBuf 至少 384 字节；预展开轮密钥与 GHASH 常量表。
    public static long AesGcmInit(nint ctxBuf, long ctxLen, nint key, int keybits) {
        return AesGcmInitCore(ctxBuf, ctxLen, key, (long)keybits);
    }

    [DllImport("crt", EntryPoint = "zan_hw_ffi_aes_gcm_init")]
    private static extern long AesGcmInitCore(nint ctxBuf, long ctxLen, nint key, long keybits);

    [DllImport("crt", EntryPoint = "zan_hw_ffi_aes_gcm_encrypt_ctx")]
    public static extern long AesGcmEncryptCtx(nint ctxBuf, nint iv, nint aad, long aadLen, nint inBuf, long inLen, nint outBuf, nint tag16);

    [DllImport("crt", EntryPoint = "zan_hw_ffi_aes_gcm_decrypt_ctx")]
    public static extern long AesGcmDecryptCtx(nint ctxBuf, nint iv, nint aad, long aadLen, nint inBuf, long inLen, nint tag16, nint outBuf);

    [DllImport("crt", EntryPoint = "zan_hw_ffi_rsa_mod_pow")]
    public static extern long RsaModPow(nint baseVal, long bLen, nint exp, long eLen, nint mod, long mLen, nint outBuf);

    [DllImport("crt", EntryPoint = "zan_hw_ffi_rsa_crt")]
    public static extern long RsaCrtModPow(nint msg, long mLen, nint p, long pLen, nint q, long qLen, nint dp, long dpLen, nint dq, long dqLen, nint qinv, long qinvLen, nint outBuf, long outLen);

    [DllImport("crt", EntryPoint = "zan_hw_ffi_x25519")]
    public static extern long X25519(nint scalar, nint point, nint outBuf);

    public static string Sm3(nint p, int len) { return NativeMemory.Sm3(p, (long)len); }

    public static string Sm3(nint p, long len) {
        byte[] digest = new byte[32];
        if (Sm3Core(p, len, (nint)digest) < 0) { return null; }
        return digest.ToStr();
    }

    public static long Sm3Into(nint p, long len, nint dst) {
        return Sm3Core(p, len, dst);
    }

    public static byte[] Sm3Bytes(nint p, long len) {
        byte[] digest = new byte[32];
        if (Sm3Core(p, len, (nint)digest) < 0) { return null; }
        return digest;
    }

    [DllImport("crt", EntryPoint = "zan_hw_ffi_sm3")]
    private static extern long Sm3Core(nint p, long len, nint dst);

    [DllImport("crt", EntryPoint = "zan_hw_ffi_sm4_cbc_encrypt")]
    public static extern long Sm4CbcEncrypt(nint dst, nint src, long size, nint key, nint iv);

    [DllImport("crt", EntryPoint = "zan_hw_ffi_sm4_cbc_decrypt")]
    public static extern long Sm4CbcDecrypt(nint dst, nint src, long size, nint key, nint iv);

    public static string Base64Encode(nint ptr, long size) {
        if (ptr == 0 || size <= 0) { return ""; }
        long capacity = Base64Capacity(size);
        if (capacity < 0 || capacity > 2147483591L) { throw new OverflowException("Base64 output is too large"); }
        nint buf = NativeMemory.Alloc((int)capacity);
        if (buf != 0) {
            try {
                long written = Base64EncodeCore(ptr, size, buf);
                if (written < 0) { return null; }
                return NativeMemory.GetString(buf, 0, (int)written);
            } finally {
                NativeMemory.Free(buf);
            }
        }
        return null;
    }

    [DllImport("crt", EntryPoint = "zan_hw_ffi_base64_capacity")]
    private static extern long Base64Capacity(long size);

    [DllImport("crt", EntryPoint = "zan_hw_ffi_base64_encode")]
    private static extern long Base64EncodeCore(nint ptr, long size, nint dst);

    // 供 stdlib 内部零分配写入 Base64：调用方须确保 dst 至少可写 ((size+2)/3)*4 + 1 字节（C 侧写尾 NUL）。
    internal static long Base64EncodeTo(nint ptr, long size, nint dst) {
        return Base64EncodeCore(ptr, size, dst);
    }

    [DllImport("crt", EntryPoint = "zan_hw_ffi_base64_decode")]
    public static extern long Base64Decode(nint dst, nint src, long size);

    public static bool SequenceEqual(nint a, nint b, int len) {
        if (len <= 0) return true;
        if (a == b) return true;
        if (a == 0 || b == 0) return false;
        int i = 0;
        while (len - i >= 32) {
            Vector256 eq = Vector256.Equals(Vector256.Load(a + (nint)i), Vector256.Load(b + (nint)i));
            if (Vector256.ExtractMostSignificantBits(eq) != -1) return false;
            i = i + 32;
        }
        while (len - i >= 16) {
            Vector128 eq = Vector128.Equals(Vector128.Load(a + (nint)i), Vector128.Load(b + (nint)i));
            if (Vector128.ExtractMostSignificantBits(eq) != 65535) return false;
            i = i + 16;
        }
        Span<byte> sa = new Span<byte>(a, len);
        Span<byte> sb = new Span<byte>(b, len);
        while (i < len) {
            if (sa[i] != sb[i]) return false;
            i = i + 1;
        }
        return true;
    }

    public static int IndexOf(nint p, int len, byte target) {
        if (p == 0 || len <= 0) return -1;
        int i = 0;
        if (len >= 32) {
            Vector256 t256 = Vector256.Create(target);
            while (len - i >= 32) {
                int mask = Vector256.ExtractMostSignificantBits(Vector256.Equals(Vector256.Load(p + (nint)i), t256));
                if (mask != 0) { return i + BitOperations.TrailingZeroCount(mask); }
                i = i + 32;
            }
        }
        if (len - i >= 16) {
            Vector128 t128 = Vector128.Create(target);
            while (len - i >= 16) {
                int mask = Vector128.ExtractMostSignificantBits(Vector128.Equals(Vector128.Load(p + (nint)i), t128));
                if (mask != 0) { return i + BitOperations.TrailingZeroCount(mask); }
                i = i + 16;
            }
        }
        Span<byte> sp = new Span<byte>(p, len);
        while (i < len) {
            if (sp[i] == target) return i;
            i = i + 1;
        }
        return -1;
    }

    public static bool IsAscii(nint p, int len) {
        if (p == 0 || len <= 0) return true;
        int i = 0;
        while (len - i >= 32) {
            if (Vector256.ExtractMostSignificantBits(Vector256.Load(p + (nint)i)) != 0) return false;
            i = i + 32;
        }
        while (len - i >= 16) {
            if (Vector128.ExtractMostSignificantBits(Vector128.Load(p + (nint)i)) != 0) return false;
            i = i + 16;
        }
        Span<byte> sp = new Span<byte>(p, len);
        while (i < len) {
            if (sp[i] >= 128) return false;
            i = i + 1;
        }
        return true;
    }

    public static int IndexOfAny(nint p, int len, byte val1, byte val2) {
        if (p == 0 || len <= 0) return -1;
        int i = 0;
        if (len >= 32) {
            Vector256 t1_256 = Vector256.Create(val1);
            Vector256 t2_256 = Vector256.Create(val2);
            while (len - i >= 32) {
                Vector256 v = Vector256.Load(p + (nint)i);
                int mask = Vector256.ExtractMostSignificantBits(Vector256.Or(Vector256.Equals(v, t1_256), Vector256.Equals(v, t2_256)));
                if (mask != 0) { return i + BitOperations.TrailingZeroCount(mask); }
                i = i + 32;
            }
        }
        if (len - i >= 16) {
            Vector128 t1_128 = Vector128.Create(val1);
            Vector128 t2_128 = Vector128.Create(val2);
            while (len - i >= 16) {
                Vector128 v = Vector128.Load(p + (nint)i);
                int mask = Vector128.ExtractMostSignificantBits(Vector128.Or(Vector128.Equals(v, t1_128), Vector128.Equals(v, t2_128)));
                if (mask != 0) { return i + BitOperations.TrailingZeroCount(mask); }
                i = i + 16;
            }
        }
        Span<byte> sp = new Span<byte>(p, len);
        while (i < len) {
            byte b = sp[i];
            if (b == val1 || b == val2) return i;
            i = i + 1;
        }
        return -1;
    }

    // SwissTable 16 字节控制组探针：H2 标签匹配 / 空槽（最高位为 1）掩码。
    public static int MatchGroup16(nint groupPtr, byte targetH2) {
        if (groupPtr == 0) return 0;
        return Vector128.ExtractMostSignificantBits(Vector128.Equals(Vector128.Load(groupPtr), Vector128.Create(targetH2)));
    }

    public static int MatchEmpty16(nint groupPtr) {
        if (groupPtr == 0) return 0;
        return Vector128.ExtractMostSignificantBits(Vector128.Load(groupPtr));
    }
}
