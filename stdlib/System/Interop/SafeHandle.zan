using System;
using System.Platform;

namespace System;

// 包装原生操作系统句柄的抽象基类，实现 IDisposable。
// 在 using 作用域结束或显式 Close/Dispose 时自动调用 ReleaseHandle，防止原生资源泄漏。
public abstract class SafeHandle : IDisposable {
    protected nint handle;
    protected bool isClosed;

    public SafeHandle(nint invalidHandleValue) {
        this.handle = invalidHandleValue;
        this.isClosed = false;
    }

    // 获取内部原生句柄。
    public nint DangerousGetHandle() {
        return this.handle;
    }

    // 判断句柄是否已失效。
    public virtual bool IsInvalid() {
        return this.handle == 0 || this.handle == -1;
    }

    // 判断句柄是否已关闭。
    public bool IsClosed {
        get { return this.isClosed; }
    }

    public bool CheckClosed() {
        return this.isClosed;
    }

    // 由具体派生类实现的实际原生句柄释放逻辑。
    public abstract bool ReleaseHandle();

    // 释放资源，保证幂等。
    public void Dispose() {
        if (!this.isClosed) {
            if (!this.IsInvalid()) {
                this.ReleaseHandle();
            }
            this.isClosed = true;
        }
    }

    // 关闭并释放句柄，等价于 Dispose()。
    public void Close() {
        this.Dispose();
    }
}

// 安全动态链接库句柄，作用域结束时自动调用 Pal.Library.FreeLibrary 卸载。
public class SafeLibraryHandle : SafeHandle {
    public SafeLibraryHandle(nint h) : base((nint)0) {
        this.handle = h;
    }

    public override bool ReleaseHandle() {
        if (this.handle != 0) {
            bool ok = Pal.Library.FreeLibrary(this.handle);
            this.handle = 0;
            return ok;
        }
        return true;
    }
}
