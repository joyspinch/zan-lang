using System;
using System.Diagnostics;

namespace System.Management;

/// <summary>
/// 单个计划任务快照。`name` 为完整任务路径（如
/// "\Microsoft\Windows\Defrag\ScheduledDefrag"）。`status` 为操作系统状态
/// 文本（"Ready"、"Running"、"Disabled"...）。`command` 为任务运行的
/// 程序；仅由 Get() 填充（列表视图省略它）。
/// </summary>
class TaskInfo {
    public string name;
    public string nextRun;
    public string status;
    public string command;
}

/// <summary>
/// Windows 任务计划程序：枚举、查询、创建、删除、运行和停止
/// 计划任务。基于内置的 schtasks.exe 实现（其
/// /fo CSV 与 /fo LIST /v 的输出跨版本稳定）。Linux/macOS
/// 抛出 PlatformNotSupportedException（cron 集成是后续
/// 里程碑）。
///
/// 创建或删除任务需要管理员权限；Run/End 仅需
/// 访问该特定任务。失败返回 false（从不抛异常）。
///
/// 触发器字符串遵循 schtasks /sc 值："ONLOGON"（登录时）、"ONSTART"
/// （系统启动时）、"ONIDLE"、"DAILY"、"WEEKLY"、"ONCE"、"MONTHLY"。DAILY、
/// WEEKLY、ONCE 和 MONTHLY 还需要时间 "HH:MM"（以及可选的日期
/// "MM/DD/YYYY"）。
/// </summary>
class TaskScheduler {
    /// <summary>当前用户可见的所有计划任务。</summary>
    static List<TaskInfo> List() {
        List<TaskInfo> list = new List<TaskInfo>();
        #if WINDOWS
        List<string> lines = Process.RunCapture("schtasks /query /fo CSV");
        // 第一行是表头（"\"TaskName\",\"Next Run Time\",\"Status\""）。
        int i = 1;
        while (i < lines.Count) {
            List<string> f = TaskScheduler.ParseCsv(lines[i]);
            if (f.Count >= 3) {
                TaskInfo t = new TaskInfo();
                t.name = f[0];
                t.nextRun = f[1];
                t.status = f[2];
                t.command = "";
                list.Add(t);
            }
            i = i + 1;
        }
        return list;
        #else
        throw new PlatformNotSupportedException(
            "TaskScheduler is not implemented on this platform");
        #endif
    }

    /// <summary>按名称获取单个任务；不存在时返回 null。</summary>
    static TaskInfo Get(string name) {
        #if WINDOWS
        List<string> lines = Process.RunCapture(
            "schtasks /query /tn " + TaskScheduler.Quote(name) + " /fo LIST /v");
        TaskInfo t = new TaskInfo();
        t.name = name;
        t.status = "";
        t.command = "";
        t.nextRun = "";
        bool found = false;
        for (int i = 0; i < lines.Count; i = i + 1) {
            string line = TaskScheduler.Trim(lines[i]);
            // Failure marker (localized: "ERROR:" / "错误:"). Only trust it
            // 在尚未看到任何字段时——任务文件夹名称中可能包含
            // 这些词。
            if (!found && (TaskScheduler.StartsWith(line, "ERROR") ||
                           TaskScheduler.StartsWith(line, "Error") ||
                           TaskScheduler.StartsWith(line, "错误"))) {
                return null;
            }
            // 字段会被本地化；因此同时匹配英文和中文名称。
            if (TaskScheduler.StartsWith(line, "Task To Run:") ||
                TaskScheduler.StartsWith(line, "要运行的任务:")) {
                t.command = TaskScheduler.AfterColon(line);
                found = true;
            } else if (TaskScheduler.StartsWith(line, "Status:") ||
                       TaskScheduler.StartsWith(line, "状态:")) {
                t.status = TaskScheduler.AfterColon(line);
            } else if (TaskScheduler.StartsWith(line, "Next Run Time:") ||
                       TaskScheduler.StartsWith(line, "下次运行时间:")) {
                t.nextRun = TaskScheduler.AfterColon(line);
            } else if (TaskScheduler.StartsWith(line, "TaskName:") ||
                       TaskScheduler.StartsWith(line, "任务名:")) {
                t.name = TaskScheduler.AfterColon(line);
                found = true;
            }
        }
        if (!found) { return null; }
        return t;
        #else
        throw new PlatformNotSupportedException(
            "TaskScheduler is not implemented on this platform");
        #endif
    }

    /// <summary>存在同名任务时返回 True。</summary>
    static bool Exists(string name) {
        #if WINDOWS
        return TaskScheduler.Get(name) != null;
        #else
        throw new PlatformNotSupportedException(
            "TaskScheduler is not implemented on this platform");
        #endif
    }

    /// <summary>
    /// 创建任务。`command` 为要运行的程序（及参数）；
    /// 含空格的路径请自行加引号，例如
    /// "\"C:\\Program Files\\x\\y.exe\" --flag"。`trigger` 为 schtasks
    /// /sc 值；DAILY/WEEKLY/ONCE/MONTHLY 需要 `time`（"HH:MM"）
    /// ，其余情况忽略。成功返回 True。
    /// </summary>
    static bool Create(string name, string command, string trigger, string time) {
        #if WINDOWS
        string cmd = "schtasks /create /tn " + TaskScheduler.Quote(name) +
            " /tr " + TaskScheduler.Quote(command) +
            " /sc " + trigger;
        if (time != "") { cmd = cmd + " /st " + time; }
        cmd = cmd + " /f";
        return TaskScheduler.SchtasksOk(cmd);
        #else
        throw new PlatformNotSupportedException(
            "TaskScheduler is not implemented on this platform");
        #endif
    }

    /// <summary>删除任务（需管理员权限）。成功返回 True。</summary>
    static bool Delete(string name) {
        #if WINDOWS
        return TaskScheduler.SchtasksOk(
            "schtasks /delete /tn " + TaskScheduler.Quote(name) + " /f");
        #else
        throw new PlatformNotSupportedException(
            "TaskScheduler is not implemented on this platform");
        #endif
    }

    /// <summary>立即运行任务。运行被接受时返回 True。</summary>
    static bool Run(string name) {
        #if WINDOWS
        return TaskScheduler.SchtasksOk(
            "schtasks /run /tn " + TaskScheduler.Quote(name));
        #else
        throw new PlatformNotSupportedException(
            "TaskScheduler is not implemented on this platform");
        #endif
    }

    /// <summary>停止正在运行的任务。停止被接受时返回 True。</summary>
    static bool End(string name) {
        #if WINDOWS
        return TaskScheduler.SchtasksOk(
            "schtasks /end /tn " + TaskScheduler.Quote(name));
        #else
        throw new PlatformNotSupportedException(
            "TaskScheduler is not implemented on this platform");
        #endif
    }

    #if WINDOWS
    static bool SchtasksOk(string cmd) {
        List<string> lines = Process.RunCapture(cmd + " 2>&1");
        // schtasks 成功时输出 "SUCCESS: ..." / "INFO: ..."，
        // 失败时输出 "ERROR: ..."（本地化前缀可能不同；检查
        // 在所有语言中都保持 ASCII 的标记词）。
        for (int i = 0; i < lines.Count; i = i + 1) {
            string t = TaskScheduler.Trim(lines[i]);
            if (TaskScheduler.StartsWith(t, "ERROR") ||
                TaskScheduler.StartsWith(t, "Error")) {
                return false;
            }
        }
        return true;
    }

    static string Quote(string s) {
        return "\"" + s + "\"";
    }

    // 第一个冒号之后的所有内容，去掉两端空白。
    static string AfterColon(string line) {
        int idx = TaskScheduler.IndexOf(line, ":", 0);
        if (idx < 0) { return ""; }
        return TaskScheduler.Trim(line.Substring(idx + 1, line.Length - idx - 1));
    }

    // 解析一行 CSV："a","b","c" -> [a, b, c]。带引号的字段可能
    // 包含逗号；成对引号（""）表示字面引号。
    static List<string> ParseCsv(string line) {
        List<string> out2 = new List<string>();
        string cur = "";
        bool inQ = false;
        int i = 0;
        while (i < line.Length) {
            int ch = line[i] & 255;
            if (inQ) {
                if (ch == 34) {          // "
                    if (i + 1 < line.Length && (line[i + 1] & 255) == 34) {
                        cur = cur + "\"";
                        i = i + 2;
                        continue;
                    }
                    inQ = false;
                } else {
                    cur = cur + line.Substring(i, 1);
                }
            } else {
                if (ch == 34) { inQ = true; }
                else if (ch == 44) {     // ,
                    out2.Add(cur);
                    cur = "";
                } else {
                    cur = cur + line.Substring(i, 1);
                }
            }
            i = i + 1;
        }
        out2.Add(cur);
        return out2;
    }

    static string FirstNonEmpty(List<string> lines) {
        for (int i = 0; i < lines.Count; i = i + 1) {
            if (TaskScheduler.Trim(lines[i]).Length > 0) { return lines[i]; }
        }
        return null;
    }

    static bool StartsWith(string s, string prefix) {
        if (prefix.Length > s.Length) { return false; }
        return s.Substring(0, prefix.Length) == prefix;
    }

    static string Trim(string s) {
        int a = 0;
        int b = s.Length;
        for (; a < b; a = a + 1) {
            int ch = s[a] & 255;
            if (ch != 32 && ch != 9 && ch != 13 && ch != 10) { break; }
        }
        while (b > a) {
            int ch = s[b - 1] & 255;
            if (ch != 32 && ch != 9 && ch != 13 && ch != 10) { break; }
            b = b - 1;
        }
        return s.Substring(a, b - a);
    }

    static int IndexOf(string hay, string needle, int from) {
        int n = needle.Length;
        int h = hay.Length;
        int i = from;
        while (i + n <= h) {
            if (hay.Substring(i, n) == needle) { return i; }
            i = i + 1;
        }
        return -1;
    }
    #endif
}
