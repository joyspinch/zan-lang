using System;
using System.IO;

namespace System.Management;

/// <summary>单个设备的只读信息（Windows 即插即用设备或
/// Linux sysfs 设备节点）。</summary>
class DeviceInfo {
    public string instanceId;
    public string classGuid;
    public string className;
    public string friendlyName;
    public string description;
    public string manufacturer;
    public List<string> hardwareIds;
}

/// <summary>
/// 设备的只读枚举。Windows 上走 SetupAPI：Present() 返回当前
/// 存在的设备，All() 还包括不存在的设备节点，每次查询覆盖
/// 所有安装类。Linux 上走 sysfs（/sys/bus/&lt;bus&gt;/devices）：
/// className 是总线名，hardwareIds 是 MODALIAS，classGuid 总为 ""
/// （Linux 没有设备类 GUID）；sysfs 只暴露当前存在的设备，
/// 因此 All() 与 Present() 结果相同。macOS 没有对应实现（需要
/// IOKit/ioreg），仍抛出 PlatformNotSupportedException。
/// </summary>
class Device {
    /// <summary>枚举所有安装类中当前存在的设备。</summary>
    static List<DeviceInfo> Present() {
        return Device.List(true);
    }

    /// <summary>枚举所有安装类中存在和不存在的设备。</summary>
    static List<DeviceInfo> All() {
        return Device.List(false);
    }

    /// <summary>枚举所有安装类，可选择仅返回
    /// 当前存在的设备。</summary>
    static List<DeviceInfo> List(bool presentOnly) {
        #if WINDOWS
        return Device.WinList(presentOnly);
        #elif LINUX
        return Device.SysfsList();
        #else
        throw new PlatformNotSupportedException(
            "System.Management.Device is not implemented on this platform");
        #endif
    }

    #if LINUX
    // 枚举 /sys/bus/<bus>/devices/*。每个节点的 uevent 是内核向
    // udev 报告的 KEY=VALUE 列表（SUBSYSTEM/DRIVER/MODALIAS 等），
    // 另外 vendor/device/product/manufacturer 等属性是单行文本文件。
    static List<DeviceInfo> SysfsList() {
        List<DeviceInfo> list = new List<DeviceInfo>();
        string busRoot = "/sys/bus";
        if (!Directory.Exists(busRoot)) { return list; }
        List<string> buses = Directory.GetDirectories(busRoot);
        for (int b = 0; b < buses.Count; b = b + 1) {
            string bus = buses[b];
            string devRoot = busRoot + "/" + bus + "/devices";
            if (!Directory.Exists(devRoot)) { continue; }
            List<string> names = Directory.GetDirectories(devRoot);
            for (int i = 0; i < names.Count; i = i + 1) {
                string name = names[i];
                string full = devRoot + "/" + name;
                DeviceInfo d = new DeviceInfo();
                d.instanceId = bus + "/" + name;
                d.classGuid = "";
                d.className = bus;
                string modalias = Device.SysfsUevent(full, "MODALIAS");
                d.hardwareIds = new List<string>();
                if (modalias != "") { d.hardwareIds.Add(modalias); }
                d.friendlyName = Device.SysfsFirst(full,
                    "product,name,model,of_node/name");
                if (d.friendlyName == "") { d.friendlyName = name; }
                d.manufacturer = Device.SysfsFirst(full, "manufacturer,vendor");
                d.description = Device.SysfsUevent(full, "DRIVER");
                if (d.description == "") {
                    d.description = Device.SysfsUevent(full, "DEVTYPE");
                }
                if (d.description == "") { d.description = d.friendlyName; }
                list.Add(d);
            }
        }
        return list;
    }

    // 读 uevent 里 `key=` 的值；不存在时返回 ""。
    static string SysfsUevent(string dir, string key) {
        string path = dir + "/uevent";
        if (!File.Exists(path)) { return ""; }
        string text = "";
        try {
            text = File.ReadAllText(path);
        } catch (IOException e) {
            return "";
        }
        List<string> lines = text.Split("\n");
        for (int i = 0; i < lines.Count; i = i + 1) {
            string line = lines[i].Trim();
            if (line.StartsWith(key + "=")) {
                return line.Substring(key.Length + 1,
                                      line.Length - key.Length - 1);
            }
        }
        return "";
    }

    // 按逗号分隔的候选顺序读第一个存在的属性文件。
    static string SysfsFirst(string dir, string names) {
        List<string> candidates = names.Split(",");
        for (int i = 0; i < candidates.Count; i = i + 1) {
            string path = dir + "/" + candidates[i];
            if (!File.Exists(path)) { continue; }
            try {
                string text = File.ReadAllText(path).Trim();
                if (text != "") { return text; }
            } catch (IOException e) {
                continue;
            }
        }
        return "";
    }
    #endif

    // 解析 REG_MULTI_SZ 负载，不越界读取。格式错误的
    // 值（字节数为奇数、缺少字符串终止符或末尾列表
    // 终止符）会被拒绝，而不是返回部分结果。
    static List<string> ParseMultiString(nint payload, int bytes) {
        List<string> texts = new List<string>();
        if (payload == 0 || bytes < 2 || bytes % 2 != 0) { return texts; }

        int used = 0;
        bool hasString = false;
        while (used <= bytes - 2) {
            nint start = payload + used;
            int chars = 0;
            while (used <= bytes - 2 &&
                   new Span<ushort>(payload + used, 1)[0] != 0) {
                chars = chars + 1;
                used = used + 2;
            }
            if (used > bytes - 2) { return new List<string>(); }

            if (chars == 0) {
                // 非空列表会带着额外的末尾 NUL 到达此处。
                // 空列表的两个 NUL 都包含在报告的字节数内。
                if (!hasString) {
                    if (bytes < 4 || used > bytes - 4 ||
                        new Span<ushort>(payload + used + 2, 1)[0] != 0) {
                        return new List<string>();
                    }
                }
                return texts;
            }

            texts.Add(Wide.Read(start));
            hasString = true;
            used = used + 2;
        }
        return new List<string>();
    }

    #if WINDOWS
    [DllImport("setupapi", EntryPoint = "SetupDiGetClassDevsW")]
    static extern nint SetupDiGetClassDevsW(nint classGuid, nint enumerator,
                                            nint parent, int flags);

    [DllImport("setupapi", EntryPoint = "SetupDiEnumDeviceInfo")]
    static extern int SetupDiEnumDeviceInfo(nint devs, int index, nint data);

    [DllImport("setupapi", EntryPoint = "SetupDiGetDeviceInstanceIdW")]
    static extern int SetupDiGetDeviceInstanceIdW(nint devs, nint data,
                                                   nint buffer, int chars,
                                                   nint requiredChars);

    [DllImport("setupapi", EntryPoint = "SetupDiGetDeviceRegistryPropertyW")]
    static extern int SetupDiGetDeviceRegistryPropertyW(nint devs, nint data,
                                                         int property,
                                                         nint textType,
                                                         nint buffer, int bytes,
                                                         nint requiredBytes);

    [DllImport("setupapi", EntryPoint = "SetupDiDestroyDeviceInfoList")]
    static extern int SetupDiDestroyDeviceInfoList(nint devs);

    static List<DeviceInfo> WinList(bool presentOnly) {
        List<DeviceInfo> list = new List<DeviceInfo>();
        int flags = 4;   // DIGCF_ALLCLASSES
        if (presentOnly) { flags = flags | 2; }   // DIGCF_PRESENT
        nint devs = Device.SetupDiGetClassDevsW(0, 0, 0, flags);
        if (devs == (nint)(0 - 1)) { return list; }   // INVALID_HANDLE_VALUE

        // SP_DEVINFO_DATA 在 Win64 上为 32 字节：DWORD cbSize、GUID、DWORD
        // DevInst、4 字节对齐、ULONG_PTR Reserved。
        nint data = NativeMemory.Alloc(32);
        int index = 0;
        bool done = false;
        while (!done) {
            NativeMemory.Fill(data, 0, 32);
            new Span<int>(data, 1)[0] = 32;
            if (Device.SetupDiEnumDeviceInfo(devs, index, data) == 0) {
                done = true;
            } else {
                DeviceInfo d = new DeviceInfo();
                d.instanceId = Device.InstanceId(devs, data);
                d.classGuid = Device.StringProperty(devs, data, 8);   // SPDRP_CLASSGUID
                d.className = Device.StringProperty(devs, data, 7);   // SPDRP_CLASS
                d.friendlyName = Device.StringProperty(devs, data, 12); // SPDRP_FRIENDLYNAME
                d.description = Device.StringProperty(devs, data, 0); // SPDRP_DEVICEDESC
                d.manufacturer = Device.StringProperty(devs, data, 11); // SPDRP_MFG
                d.hardwareIds = Device.MultiStringProperty(devs, data, 1); // SPDRP_HARDWAREID
                list.Add(d);
                index = index + 1;
            }
        }
        NativeMemory.Free(data);
        Device.SetupDiDestroyDeviceInfoList(devs);
        return list;
    }

    static string InstanceId(nint devs, nint data) {
        nint required = NativeMemory.Alloc(4);
        new Span<int>(required, 1)[0] = 0;
        Device.SetupDiGetDeviceInstanceIdW(devs, data, 0, 0, required);
        int chars = new Span<int>(required, 1)[0];
        if (chars <= 0) {
            NativeMemory.Free(required);
            return "";
        }
        nint buffer = NativeMemory.Alloc(chars * 2 + 2);
        int ok = Device.SetupDiGetDeviceInstanceIdW(
            devs, data, buffer, chars, required);
        string text = "";
        if (ok != 0) { text = Wide.Read(buffer); }
        NativeMemory.Free(buffer);
        NativeMemory.Free(required);
        return text;
    }

    static string StringProperty(nint devs, nint data, int property) {
        nint buffer = Device.PropertyBuffer(devs, data, property);
        if (buffer == 0) { return ""; }
        int type = new Span<int>(buffer, 1)[0];
        string text = "";
        if (type == 1 || type == 2) { text = Wide.Read(buffer + 8); }
        NativeMemory.Free(buffer);
        return text;
    }

    static List<string> MultiStringProperty(nint devs, nint data, int property) {
        List<string> texts = new List<string>();
        nint buffer = Device.PropertyBuffer(devs, data, property);
        if (buffer == 0) { return texts; }
        int type = new Span<int>(buffer, 1)[0];
        int bytes = new Span<int>(buffer + 4, 1)[0];
        if (type == 7) {   // REG_MULTI_SZ
            texts = Device.ParseMultiString(buffer + 8, bytes);
        }
        NativeMemory.Free(buffer);
        return texts;
    }

    // 返回一个分配块，包含 [type:int, byteCount:int, payload...]，
    // 属性不存在时返回 0。SetupAPI 在首次零缓冲区调用时
    // 报告精确的负载大小，避免固定大小截断。
    static nint PropertyBuffer(nint devs, nint data, int property) {
        nint required = NativeMemory.Alloc(4);
        nint type = NativeMemory.Alloc(4);
        new Span<int>(required, 1)[0] = 0;
        new Span<int>(type, 1)[0] = 0;
        Device.SetupDiGetDeviceRegistryPropertyW(
            devs, data, property, type, 0, 0, required);
        int bytes = new Span<int>(required, 1)[0];
        if (bytes <= 0) {
            NativeMemory.Free(required);
            NativeMemory.Free(type);
            return 0;
        }
        nint result = NativeMemory.Alloc(bytes + 10);
        NativeMemory.Fill(result, 0, bytes + 10);
        int ok = Device.SetupDiGetDeviceRegistryPropertyW(
            devs, data, property, type, result + 8, bytes, required);
        if (ok == 0) {
            NativeMemory.Free(result);
            result = 0;
        } else {
            new Span<int>(result, 1)[0] = new Span<int>(type, 1)[0];
            new Span<int>(result + 4, 1)[0] = new Span<int>(required, 1)[0];
        }
        NativeMemory.Free(required);
        NativeMemory.Free(type);
        return result;
    }
    #endif
}
