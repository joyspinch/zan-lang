using System;

namespace System.Management;

/// <summary>
/// 单个显示器：索引（0 = 主屏）、名称、像素尺寸、刷新率和
/// 颜色深度。
/// </summary>
class DisplayInfo {
    public int index;
    public string name;
    public int width;
    public int height;
    /// 刷新率（Hz；未知时为 0）。
    public int refreshHz;
    /// 颜色深度（每像素位数；未知时为 0）。
    public int bitsPerPixel;
}

/// <summary>
/// 显示器拓扑。Windows 通过 GetSystemMetrics 查询主屏，
/// 并通过 EnumDisplayMonitors/EnumDisplaySettingsW 查询每台显示器；
/// 其他平台返回 0/空值而不抛异常。
/// </summary>
class Display {
    /// <summary>主屏宽度（像素）。</summary>
    static int ScreenWidth() {
        #if WINDOWS
        return Display.WinGetSystemMetrics(0);
        #else
        return 0;
        #endif
    }

    /// <summary>主屏高度（像素）。</summary>
    static int ScreenHeight() {
        #if WINDOWS
        return Display.WinGetSystemMetrics(1);
        #else
        return 0;
        #endif
    }

    /// <summary>主屏刷新率（Hz；未知时为 0）。</summary>
    static int RefreshRate() {
        #if WINDOWS
        return Display.WinMode(0xFFFFFFFF /*ENUM_CURRENT_SETTINGS*/, 184);
        #else
        return 0;
        #endif
    }

    /// <summary>主屏颜色深度（每像素位数）。</summary>
    static int ColorDepth() {
        #if WINDOWS
        return Display.WinMode(0xFFFFFFFF /*ENUM_CURRENT_SETTINGS*/, 168);
        #else
        return 0;
        #endif
    }

    /// <summary>所有显示器（索引 0 = 主屏）。枚举不可用时
    /// 返回空。</summary>
    static List<DisplayInfo> Monitors() {
        List<DisplayInfo> list = new List<DisplayInfo>();
        #if WINDOWS
        Display.monitorResults = list;
        Display.monitorProc = Display.WinMonitorProc;
        Display.WinEnumDisplayMonitors(0, 0, Display.monitorProc, 0);
        #endif
        return list;
    }

    #if WINDOWS
    [DllImport("user32", EntryPoint = "GetSystemMetrics")]
    static extern int WinGetSystemMetrics(int index);

    [DllImport("user32", EntryPoint = "EnumDisplaySettingsW")]
    static extern int WinEnumDisplaySettingsW(nint name, int mode, nint devMode);

    [DllImport("user32", EntryPoint = "EnumDisplayMonitors")]
    static extern int WinEnumDisplayMonitors(nint hdc, nint clip, MonitorEnumProc proc,
                                             nint data);

    [DllImport("user32", EntryPoint = "GetMonitorInfoW")]
    static extern int WinGetMonitorInfoW(nint monitor, nint info);

    [DllImport("user32", EntryPoint = "MonitorFromPoint")]
    static extern nint WinMonitorFromPoint(nint pt, int flags);

    // 原生显示器枚举回调（WINAPI）。
    static MonitorEnumProc monitorProc;

    static List<DisplayInfo> monitorResults;

    static int WinMonitorProc(nint monitor, nint hdc, nint rect, nint data) {
        // MONITORINFOEXW: cbSize(4) rcMonitor(16) rcWork(16) dwFlags(4)
        // szDevice[32] WCHAR (64) = 104 bytes total.
        nint info = NativeMemory.Alloc(112);
        new Span<int>(info, 2)[0] = 104;   // cbSize
        if (Display.WinGetMonitorInfoW(monitor, info) != 0) {
            DisplayInfo d = new DisplayInfo();
            d.index = Display.monitorResults.Count;
            d.name = Wide.Read(info + 40);
            // 该显示器当前的显示模式。
            nint dev = NativeMemory.Alloc(220);
            new Span<int>(dev, 55)[17] = 220;   // dmSize @ 68
            int ok = Display.WinEnumDisplaySettingsW(info + 40, 0xFFFFFFFF, dev);
            if (ok != 0) {
                Span<int> m = new Span<int>(dev, 48);
                d.bitsPerPixel = m[42];   // dmBitsPerPel @ 168
                d.width = m[43];          // dmPelsWidth @ 172
                d.height = m[44];         // dmPelsHeight @ 176
                d.refreshHz = m[46];      // dmDisplayFrequency @ 184
            }
            NativeMemory.Free(dev);
            Display.monitorResults.Add(d);
        }
        NativeMemory.Free(info);
        return 1;   // 继续枚举
    }

    /// 读取主屏当前 DEVMODEW 的 DWORD 字段。
    static int WinMode(int mode, int offset) {
        nint dev = NativeMemory.Alloc(220);
        new Span<int>(dev, 55)[17] = 220;   // dmSize @ 68
        int ok = Display.WinEnumDisplaySettingsW(0, mode, dev);
        int v = 0;
        if (ok != 0) {
            Span<int> m = new Span<int>(dev, 48);
            v = m[offset / 4];
        }
        NativeMemory.Free(dev);
        return v;
    }
    #endif
}

#if WINDOWS
/// 原生显示器枚举回调（WINAPI）。
delegate int MonitorEnumProc(nint monitor, nint hdc, nint rect, nint data);
#endif
