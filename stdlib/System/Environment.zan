using System;

namespace System;

// 提供有关当前环境和平台的信息以及操作它们的方法，符合现代 C# (System.Environment) 标准。
public class Environment {
    #if WINDOWS
    [DllImport("kernel32", EntryPoint = "SetEnvironmentVariableW")]
    static extern int SetEnvironmentVariableW(nint name, nint val);
    #else
    [DllImport("crt", EntryPoint = "setenv")]
    static extern int setenv(string name, string val, int overwrite);
    [DllImport("crt", EntryPoint = "unsetenv")]
    static extern int unsetenv(string name);
    #endif

    [DllImport("crt", EntryPoint = "exit")]
    static extern void crt_exit(int code);

    // 获取当前进程的唯一标识符 (PID)。
    public static int ProcessId {
        get {
            return AppPath.Pid();
        }
    }

    // 获取启动当前进程的可执行文件的完全限定路径。
    public static string ProcessPath {
        get {
            return AppPath.Exe();
        }
    }

    // 获取当前平台的换行字符串。
    public static string NewLine {
        get {
            #if WINDOWS
            return "\r\n";
            #else
            return "\n";
            #endif
        }
    }

    // 获取或设置当前工作目录。
    public static string CurrentDirectory {
        get {
            return System.IO.Directory.GetCurrentDirectory();
        }
    }

    public static void SetCurrentDirectory(string path) {
        System.IO.Directory.SetCurrentDirectory(path);
    }

    // 获取当前计算机的 NetBIOS 名称或主机名。
    public static string MachineName {
        get {
            string s = GetEnvironmentVariable("COMPUTERNAME");
            if (s == "") { s = GetEnvironmentVariable("HOSTNAME"); }
            return s;
        }
    }

    // 获取启动当前进程的用户的用户名。
    public static string UserName {
        get {
            string s = GetEnvironmentVariable("USERNAME");
            if (s == "") { s = GetEnvironmentVariable("USER"); }
            return s;
        }
    }

    // 确定当前进程是否为 64 位进程。
    public static bool Is64BitProcess {
        get {
            #if ARCH_X86 || ARCH_ARM || WASM32
            return false;
            #else
            return true;
            #endif
        }
    }

    // 确定当前操作系统是否为 64 位操作系统。
    public static bool Is64BitOperatingSystem {
        get {
            #if ARCH_X86 || ARCH_ARM || WASM32
            return false;
            #else
            return true;
            #endif
        }
    }

    // 获取当前计算机上的逻辑处理器数。
    public static int ProcessorCount {
        get {
            string s = GetEnvironmentVariable("NUMBER_OF_PROCESSORS");
            if (s != "") {
                int n = Convert.ToInt32(s);
                if (n > 0) { return n; }
            }
            return 1;
        }
    }

    // 从当前进程检索环境变量的值。
    public static string GetEnvironmentVariable(string variable) {
        if (variable == null || variable == "") { return ""; }
        return Interop.EnvVar(variable);
    }

    // 创建、修改或删除当前进程中存储的环境变量。
    public static void SetEnvironmentVariable(string variable, string value) {
        if (variable == null || variable == "") { return; }
        #if WINDOWS
        nint wname = Wide.Of(variable);
        nint wval = (value != null) ? Wide.Of(value) : 0;
        SetEnvironmentVariableW(wname, wval);
        Wide.Free(wname);
        if (wval != 0) { Wide.Free(wval); }
        #else
        if (value == null) {
            unsetenv(variable);
        } else {
            setenv(variable, value, 1);
        }
        #endif
    }

    // 终止此进程并向基础操作系统提供指定的退出代码。
    public static void Exit(int exitCode) {
        crt_exit(exitCode);
    }

    // 获取系统启动后经过的毫秒数。
    public static long TickCount64 {
        get {
            return Stopwatch.GetMilliseconds();
        }
    }
}
