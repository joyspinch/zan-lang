using System;

namespace System.IO;

/// <summary>
/// Cross-platform file operations using C runtime (msvcrt on Windows, libc on POSIX).
/// All methods support both Windows and Linux/macOS.
/// </summary>
class File {
    // C runtime functions (available on all platforms as libc/msvcrt)
    [DllImport("crt")]
    static extern nint fopen(string path, string mode);

    [DllImport("crt")]
    static extern int fputs(string str, nint fp);

    [DllImport("crt")]
    static extern int fclose(nint fp);

    [DllImport("crt")]
    static extern int fseek(nint fp, int offset, int origin);

    [DllImport("crt")]
    static extern int ftell(nint fp);

    [DllImport("crt")]
    static extern long fread(string buf, long size, long count, nint fp);

    [DllImport("crt")]
    static extern long fwrite(string buf, long size, long count, nint fp);

    [DllImport("crt")]
    static extern int remove(string path);

    [DllImport("crt")]
    static extern int rename(string oldname, string newname);

    [DllImport("crt")]
    static extern int fputc(int ch, nint fp);

    /// <summary>Reads the entire contents of a file as a string.
    /// Throws FileNotFoundException when the file cannot be opened.</summary>
    static string ReadAllText(string path) {
        nint fp = fopen(path, "rb");
        if (fp == 0) {
            throw new FileNotFoundException("Could not open file: " + path);
        }
        fseek(fp, 0, 2);
        int size = ftell(fp);
        fseek(fp, 0, 0);
        if (size > 0) {
            byte[] buf = new byte[size];
            int got = (int)fread(buf, 1, size, fp);
            fclose(fp);
            return buf.ToStr(0, got);
        }
        // A size of 0 does not mean empty: a generated file (/proc, /sys) has
        // content but no length to report, so the seek/ftell shortcut cannot be
        // the only path. Drain it instead of returning "" for a file that reads
        // perfectly well with `cat`.
        StringBuilder sb = new StringBuilder();
        byte[] chunk = new byte[8192];
        int n = (int)fread(chunk, 1, 8192, fp);
        while (n > 0) {
            sb.Append(chunk.ToStr(0, n));
            n = (int)fread(chunk, 1, 8192, fp);
        }
        fclose(fp);
        return sb.ToString();
    }

    /// <summary>Reads file contents (wrapper for ReadAllText).</summary>
    static string ReadAllTextAsync(string path) {
        string result = ReadAllText(path);
        return result;
    }

    /// <summary>Writes a string to a file, creating or overwriting it.
    /// Throws IOException when the file cannot be opened for writing.</summary>
    static void WriteAllText(string path, string content) {
        nint fp = fopen(path, "w");
        if (fp == 0) {
            throw new IOException("Could not open file for writing: " + path);
        }
        fputs(content, fp);
        fclose(fp);
    }

    /// <summary>Writes file contents (wrapper for WriteAllText).</summary>
    static void WriteAllTextAsync(string path, string content) {
        WriteAllText(path, content);
    }

    /// <summary>Appends a string to the end of a file.
    /// Throws IOException when the file cannot be opened for appending.</summary>
    static void AppendAllText(string path, string content) {
        nint fp = fopen(path, "a");
        if (fp == 0) {
            throw new IOException("Could not open file for appending: " + path);
        }
        fputs(content, fp);
        fclose(fp);
    }

    /// <summary>Appends text (wrapper for AppendAllText).</summary>
    static void AppendAllTextAsync(string path, string content) {
        AppendAllText(path, content);
    }

    /// <summary>Checks whether a file exists.</summary>
    static bool Exists(string path) {
        nint fp = fopen(path, "rb");
        if (fp != 0) {
            fclose(fp);
            return true;
        }
        return false;
    }

    /// <summary>Deletes the file at the specified path.</summary>
    static void Delete(string path) {
        remove(path);
    }

    /// <summary>Moves (renames) a file.</summary>
    static void Move(string source, string dest) {
        rename(source, dest);
    }

    /// <summary>Copies a file from source to destination.
    /// Throws FileNotFoundException when the source cannot be opened and
    /// IOException when the destination cannot be written.</summary>
    static void Copy(string source, string dest) {
        nint fpSrc = fopen(source, "rb");
        if (fpSrc == 0) {
            throw new FileNotFoundException("Could not open file: " + source);
        }
        fseek(fpSrc, 0, 2);
        int len = ftell(fpSrc);
        fseek(fpSrc, 0, 0);
        byte[] buf = new byte[len];
        (int)fread(buf, 1, len, fpSrc);
        fclose(fpSrc);

        nint fpDst = fopen(dest, "wb");
        if (fpDst == 0) {
            throw new IOException("Could not open file for writing: " + dest);
        }
        (int)fwrite(buf, 1, len, fpDst);
        fclose(fpDst);
    }

    /// <summary>Gets the size of a file in bytes.
    /// Throws FileNotFoundException when the file cannot be opened.</summary>
    static int GetSize(string path) {
        nint fp = fopen(path, "rb");
        if (fp == 0) {
            throw new FileNotFoundException("Could not open file: " + path);
        }
        fseek(fp, 0, 2);
        int size = ftell(fp);
        fclose(fp);
        return size;
    }

    /// <summary>Reads all lines of a file into a List.</summary>
    static List<string> ReadAllLines(string path) {
        string content = ReadAllText(path);
        List<string> lines = new List<string>();
        StringBuilder sb = new StringBuilder();
        int len = content.Length;
        for (int i = 0; i < len; i = i + 1) {
            string ch = content.Substring(i, 1);
            if (ch == "\n") {
                lines.Add(sb.ToString());
                sb = new StringBuilder();
            } else if (ch != "\r") {
                sb.Append(ch);
            }
        }
        string last = sb.ToString();
        if (last.Length > 0) {
            lines.Add(last);
        }
        return lines;
    }

    /// <summary>Writes a list of strings as lines to a file.
    /// Throws IOException when the file cannot be opened for writing.</summary>
    static void WriteAllLines(string path, List<string> lines) {
        nint fp = fopen(path, "w");
        if (fp == 0) {
            throw new IOException("Could not open file for writing: " + path);
        }
        for (int i = 0; i < lines.Count; i = i + 1) {
            fputs(lines[i], fp);
            fputc(10, fp);
        }
        fclose(fp);
    }

    /// <summary>Writes exactly <paramref name="count"/> bytes, preserving
    /// embedded NUL bytes. Creates or overwrites the destination file.</summary>
    static void WriteBytes(string path, string data, int count) {
        if (count < 0 || count > data.Length) {
            throw new ArgumentException("count is outside the data buffer");
        }
        nint fp = fopen(path, "wb");
        if (fp == 0) {
            throw new IOException("Could not open file for writing: " + path);
        }
        int written = (int)fwrite(data, 1, count, fp);
        fclose(fp);
        if (written != count) {
            throw new IOException("Could not write complete file: " + path);
        }
    }

    /// <summary>Reads a specified number of bytes from a file. The returned
    /// buffer is ARC-managed and carries its own length, so embedded NUL bytes
    /// survive and the caller does not release it.
    /// Throws FileNotFoundException when the file cannot be opened.</summary>
    static byte[] ReadBytes(string path, int offset, int count) {
        nint fp = fopen(path, "rb");
        if (fp == 0) {
            throw new FileNotFoundException("Could not open file: " + path);
        }
        fseek(fp, offset, 0);
        byte[] buf = new byte[count];
        (int)fread(buf, 1, count, fp);
        fclose(fp);
        return buf;
    }

    /// <summary>Writes raw bytes to a file (binary-safe, unlike
    /// WriteBytes which takes a string and cannot carry NUL bytes).</summary>
    static void WriteAllBytes(string path, byte[] data) {
        nint fp = fopen(path, "wb");
        if (fp == 0) {
            throw new IOException("Could not open file for writing: " + path);
        }
        long written = fwrite(data, 1, data.Length, fp);
        fclose(fp);
        if (written != (long)data.Length) {
            throw new IOException("Could not write complete file: " + path);
        }
    }
}
