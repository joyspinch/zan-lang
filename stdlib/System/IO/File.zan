using System;

namespace System.IO;

/// <summary>
/// 基于 C 运行时（Windows 为 msvcrt，POSIX 为 libc）的跨平台文件操作。
/// 所有方法均支持 Windows 与 Linux/macOS。
/// </summary>
class File {
    // C 运行时函数（所有平台均以 libc/msvcrt 形式提供）
    [DllImport("crt")]
    static extern nint fopen(string path, string mode);

    /// fopen() for READS that also looks inside a single-file program's
    /// unpacked payload (ZAN_PKG_DIR). A packaged program runs with the
    /// launcher's own directory as its working directory, so its bundled
    /// read-only resources are not reachable relative to it; writes stay on
    /// plain fopen so they land next to the program, never in the cache.
    [DllImport("crt")]
    static extern nint zan_pkg_fopen(string path, string mode);

    [DllImport("crt")]
    static extern int fputs(string str, nint fp);

    [DllImport("crt")]
    static extern int fclose(nint fp);

    [DllImport("crt")]
    static extern int fseek(nint fp, int offset, int origin);

    [DllImport("crt")]
    static extern int ftell(nint fp);

    [DllImport("crt")]
    static extern long fread(string buf, long size, long count, nint fp);

    [DllImport("crt")]
    static extern long fwrite(string buf, long size, long count, nint fp);

    [DllImport("crt")]
    static extern int remove(string path);

    [DllImport("crt")]
    static extern int rename(string oldname, string newname);

    [DllImport("crt")]
    static extern int fputc(int ch, nint fp);

    // 位 0 只读、位 1 隐藏、位 2 目录；路径不存在时为 -1。
    [DllImport("crt")]
    static extern long zan_file_attributes(string path);

    // 内嵌资源：发布时被编进可执行文件的只读文件，按项目相对路径寻址
    // （zanc --embed，IDE 里给文件/文件夹选「内嵌」）。磁盘上找不到时
    // 才回退到内嵌副本，本地同名文件仍然优先，开发时改一改就能生效。
    [DllImport("crt")]
    static extern int zan_embed_has(string name);

    [DllImport("crt")]
    static extern string zan_embed_read(string name);

    // 资源的原始字节：zan_embed_read 以 NUL 结尾，带 NUL 的二进制资源
    // （图片、dll）必须走这里。返回资源在镜像里的地址，字节数写进
    // outLen 指向的 int。
    [DllImport("crt")]
    static extern nint zan_embed_bytes(string name, byte[] outLen);

    // 以某个前缀开头的全部资源名，用 '\n' 连接（前缀为空则是全部）。
    [DllImport("crt")]
    static extern string zan_embed_list(string prefix);

    /// <summary>把路径规范成内嵌资源名：内嵌资源以项目相对路径命名，
    /// "./config/app.json" 与 "config\\app.json" 都指向
    /// "config/app.json"。</summary>
    static string EmbedName(string path) {
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < path.Length; i = i + 1) {
            string ch = path.Substring(i, 1);
            if (ch == "\\") { ch = "/"; }
            sb.Append(ch);
        }
        string s = sb.ToString();
        while (s.Length >= 2 && s.Substring(0, 2) == "./") {
            s = s.Substring(2, s.Length - 2);
        }
        if (s == ".") { return ""; }
        return s;
    }

    /// <summary>列出以 <paramref name="prefix"/> 开头的内嵌资源名（"" 为
    /// 全部）。返回的名字可直接交给 <see cref="ExtractEmbedded"/> 或
    /// <see cref="ReadAllText"/>。</summary>
    static List<string> EmbeddedNames(string prefix) {
        List<string> names = new List<string>();
        string joined = zan_embed_list(File.EmbedName(prefix));
        int start = 0;
        for (int i = 0; i <= joined.Length; i = i + 1) {
            bool end = i == joined.Length;
            if (!end && joined.Substring(i, 1) != "\n") { continue; }
            if (i > start) { names.Add(joined.Substring(start, i - start)); }
            start = i + 1;
        }
        return names;
    }

    /// <summary>该路径是否有内嵌副本。</summary>
    static bool EmbedExists(string path) {
        return zan_embed_has(File.EmbedName(path)) != 0;
    }

    /// <summary>以字符串形式读取整个文件内容。
    /// 文件无法打开时抛出 FileNotFoundException。</summary>
    static string ReadAllText(string path) {
        nint fp = zan_pkg_fopen(path, "rb");
        if (fp == 0) {
            string emb = File.EmbedName(path);
            if (zan_embed_has(emb) != 0) { return zan_embed_read(emb); }
            throw new FileNotFoundException("Could not open file: " + path);
        }
        fseek(fp, 0, 0);
        StringBuilder sb = new StringBuilder();
        byte[] chunk = new byte[8192];
        int n = (int)fread(chunk, 1, 8192, fp);
        while (n > 0) {
            sb.Append(chunk.ToStr(0, n));
            n = (int)fread(chunk, 1, 8192, fp);
        }
        fclose(fp);
        return sb.ToString();
    }

    /// <summary>读取文件内容（ReadAllText 的包装）。</summary>
    static string ReadAllTextAsync(string path) {
        string result = ReadAllText(path);
        return result;
    }

    /// <summary>将字符串写入文件，不存在则创建，已存在则覆盖。
    /// 文件无法以写入方式打开时抛出 IOException。
    ///
    /// 以二进制模式按显式长度写出：文本模式（"w"）会在 Windows 上
    /// 把 '\n' 翻成 "\r\n"，而 fputs 会在首个 NUL 处停止 —— 两者都会让
    /// 写回的内容与传入的字符串不一致（写文件再读回不等于原文）。</summary>
    static void WriteAllText(string path, string content) {
        nint fp = fopen(path, "wb");
        if (fp == 0) {
            throw new IOException("Could not open file for writing: " + path);
        }
        int len = content.Length;
        if (len > 0) {
            int written = (int)fwrite(content, 1, len, fp);
            if (written != len) {
                fclose(fp);
                throw new IOException("Could not write file: " + path);
            }
        }
        fclose(fp);
    }

    /// <summary>写入文件内容（WriteAllText 的包装）。</summary>
    static void WriteAllTextAsync(string path, string content) {
        WriteAllText(path, content);
    }

    /// <summary>将字符串追加到文件末尾。
    /// 文件无法以追加方式打开时抛出 IOException。
    /// 与 WriteAllText 同理，用二进制模式按长度写出。</summary>
    static void AppendAllText(string path, string content) {
        nint fp = fopen(path, "ab");
        if (fp == 0) {
            throw new IOException("Could not open file for appending: " + path);
        }
        int len = content.Length;
        if (len > 0) {
            int written = (int)fwrite(content, 1, len, fp);
            if (written != len) {
                fclose(fp);
                throw new IOException("Could not append to file: " + path);
            }
        }
        fclose(fp);
    }

    /// <summary>追加文本（AppendAllText 的包装）。</summary>
    static void AppendAllTextAsync(string path, string content) {
        AppendAllText(path, content);
    }

    /// <summary>检查路径是否存在且为文件。目录返回 false
    /// （用 Directory.Exists 判断目录）。
    ///
    /// 不能用 fopen 判存在：POSIX 上 <c>fopen(dir, "rb")</c> 会成功，
    /// 于是目录会被当成文件（调用方紧接着就会去 remove/读它），
    /// 而 Windows 上同一调用失败 —— 同一份代码在两个平台行为相反。</summary>
    static bool Exists(string path) {
        long a = zan_file_attributes(path);
        if (a < 0) { return File.EmbedExists(path); }
        return ((a / 4) % 2) == 0;
    }

    [DllImport("crt")]
    static extern long zan_file_try_lock(string path);

    [DllImport("crt")]
    static extern long zan_file_unlock(long handle);

    /// <summary>抢占 <paramref name="path"/> 的跨进程独占锁（文件不存在
    /// 就创建），拿到返回非 0 句柄，已被别的进程占用返回 0，不等待。
    ///
    /// 锁就是那个打开的系统句柄：进程退出（含被杀、崩溃）时由内核释放，
    /// 因此不像 pid 文件那样会留下需要清理的陈旧标记。用途是「同一个程序
    /// 的第几份副本占用哪个数据目录」这类判断。</summary>
    static long TryLock(string path) {
        return zan_file_try_lock(path);
    }

    /// <summary>释放 <see cref="TryLock"/> 拿到的锁；本来就没锁住返回
    /// false。进程退出时无需显式调用。</summary>
    static bool Unlock(long handle) {
        return zan_file_unlock(handle) != 0;
    }

    #if !WINDOWS
    [DllImport("crt")]
    static extern int chmod(string path, int mode);

    [DllImport("crt")]
    static extern int access(string path, int mode);
    #endif

    /// <summary>设置或清除文件的可执行位。POSIX 上按 owner/group/other
    /// 的当前可读位加上（或去掉）对应的 x 位；Windows 没有可执行位
    /// （可执行性由扩展名决定），返回 true 且不做修改。</summary>
    static bool SetExecutable(string path, bool on) {
        #if WINDOWS
        return File.Exists(path);
        #else
        if (!File.Exists(path)) { return false; }
        // 0755 / 0644：可执行时给所有能读的角色加 x。
        int mode = on ? 493 : 420;
        return chmod(path, mode) == 0;
        #endif
    }

    /// <summary>文件存在且当前用户可执行时返回 true。
    /// Windows 上退化为按扩展名判断（.exe/.bat/.cmd/.com）。</summary>
    static bool IsExecutable(string path) {
        #if WINDOWS
        string lower = path.ToLower();
        if (!File.Exists(path)) { return false; }
        return lower.EndsWith(".exe") || lower.EndsWith(".bat")
        || lower.EndsWith(".cmd") || lower.EndsWith(".com");
        #else
        if (!File.Exists(path)) { return false; }
        return access(path, 1 /*X_OK*/) == 0;
        #endif
    }

    /// <summary>删除指定路径的文件。</summary>
    static void Delete(string path) {
        remove(path);
    }

    /// <summary>移动（重命名）文件。</summary>
    static void Move(string source, string dest) {
        rename(source, dest);
    }

    /// <summary>将文件从源路径复制到目标路径。
    /// 源文件无法打开时抛出 FileNotFoundException，
    /// 目标无法写入时抛出 IOException。</summary>
    static void Copy(string source, string dest) {
        nint fpSrc = zan_pkg_fopen(source, "rb");
        if (fpSrc == 0) {
            throw new FileNotFoundException("Could not open file: " + source);
        }
        fseek(fpSrc, 0, 2);
        int len = ftell(fpSrc);
        fseek(fpSrc, 0, 0);
        byte[] buf = new byte[len];
        if (len > 0 && (int)fread(buf, 1, len, fpSrc) != len) {
            fclose(fpSrc);
            throw new IOException("Could not read file: " + source);
        }
        fclose(fpSrc);

        nint fpDst = fopen(dest, "wb");
        if (fpDst == 0) {
            throw new IOException("Could not open file for writing: " + dest);
        }
        if (len > 0 && (int)fwrite(buf, 1, len, fpDst) != len) {
            fclose(fpDst);
            throw new IOException("Could not write file: " + dest);
        }
        fclose(fpDst);
    }

    /// <summary>获取文件大小（字节）。
    /// 文件无法打开时抛出 FileNotFoundException。</summary>
    static int GetSize(string path) {
        nint fp = zan_pkg_fopen(path, "rb");
        if (fp == 0) {
            throw new FileNotFoundException("Could not open file: " + path);
        }
        fseek(fp, 0, 2);
        int size = ftell(fp);
        fclose(fp);
        return size;
    }

    /// <summary>将文件所有行读入 List。</summary>
    static List<string> ReadAllLines(string path) {
        string content = ReadAllText(path);
        List<string> lines = new List<string>();
        StringBuilder sb = new StringBuilder();
        int len = content.Length;
        for (int i = 0; i < len; i = i + 1) {
            string ch = content.Substring(i, 1);
            if (ch == "\n") {
                lines.Add(sb.ToString());
                sb = new StringBuilder();
            } else if (ch != "\r") {
                sb.Append(ch);
            }
        }
        string last = sb.ToString();
        if (last.Length > 0) {
            lines.Add(last);
        }
        return lines;
    }

    /// <summary>将字符串列表逐行写入文件。
    /// 文件无法以写入方式打开时抛出 IOException。</summary>
    static void WriteAllLines(string path, List<string> lines) {
        nint fp = fopen(path, "w");
        if (fp == 0) {
            throw new IOException("Could not open file for writing: " + path);
        }
        for (int i = 0; i < lines.Count; i = i + 1) {
            if (fputs(lines[i], fp) < 0 || fputc(10, fp) < 0) {
                fclose(fp);
                throw new IOException("Could not write file: " + path);
            }
        }
        fclose(fp);
    }

    /// <summary>精确写入 <paramref name="count"/> 个字节，保留
    /// 内嵌的 NUL 字节。创建或覆盖目标文件。</summary>
    static void WriteBytes(string path, string data, int count) {
        if (count < 0 || count > data.Length) {
            throw new ArgumentException("count is outside the data buffer");
        }
        nint fp = fopen(path, "wb");
        if (fp == 0) {
            throw new IOException("Could not open file for writing: " + path);
        }
        int written = (int)fwrite(data, 1, count, fp);
        fclose(fp);
        if (written != count) {
            throw new IOException("Could not write complete file: " + path);
        }
    }

    /// <summary>从文件读取最多 <paramref name="count"/> 个字节。
    /// 返回的缓冲区由 ARC 管理并自带长度，因此内嵌 NUL 字节
    /// 得以保留，调用者也无需手动释放。文件比 count 短小时
    /// 返回实际读取的字节数；文件无法打开时抛出
    /// FileNotFoundException。</summary>
    static byte[] ReadBytes(string path, int offset, int count) {
        nint fp = zan_pkg_fopen(path, "rb");
        if (fp == 0) {
            throw new FileNotFoundException("Could not open file: " + path);
        }
        fseek(fp, offset, 0);
        byte[] buf = new byte[count];
        int total = 0;
        byte[] chunk = new byte[4096];
        while (total < count) {
            int want = count - total;
            if (want > 4096) { want = 4096; }
            int got = (int)fread(chunk, 1, want, fp);
            if (got <= 0) { break; }
            int i = 0;
            while (i < got) { buf[total + i] = chunk[i]; i = i + 1; }
            total = total + got;
        }
        fclose(fp);
        if (total < count) {
            byte[] actual = new byte[total];
            int i = 0;
            while (i < total) { actual[i] = buf[i]; i = i + 1; }
            return actual;
        }
        return buf;
    }

    /// <summary>读取整个文件为字节数组（二进制安全：内嵌 NUL
    /// 会被保留，因此可用于图片、可执行文件等任意内容）。
    /// 文件无法打开时抛出 FileNotFoundException。</summary>
    static byte[] ReadAllBytes(string path) {
        int size = File.GetSize(path);
        if (size < 0) {
            throw new FileNotFoundException("Could not open file: " + path);
        }
        return File.ReadBytes(path, 0, size);
    }

    /// <summary>将原始字节写入文件（二进制安全，不同于
    /// 接收字符串、无法携带 NUL 字节的 WriteBytes）。</summary>
    static void WriteAllBytes(string path, byte[] data) {
        nint fp = fopen(path, "wb");
        if (fp == 0) {
            throw new IOException("Could not open file for writing: " + path);
        }
        long written = fwrite(data, 1, data.Length, fp);
        fclose(fp);
        if (written != (long)data.Length) {
            throw new IOException("Could not write complete file: " + path);
        }
    }

    /// <summary>把内嵌资源原样落盘（二进制安全），返回是否落盘成功。
    /// 没有这份内嵌资源返回 false。目标已存在且大小一致时直接成功，
    /// 不重复写——同一份资源每次进程启动都会走到这里。
    ///
    /// 用于必须以「真文件」形式存在才能用的资源：动态库要交给系统加载器
    /// （LoadLibrary/dlopen 只认路径），子进程可执行文件要交给 exec。
    /// </summary>
    static bool ExtractEmbedded(string path, string dest) {
        string name = File.EmbedName(path);
        if (zan_embed_has(name) == 0) { return false; }
        byte[] lenBuf = new byte[8];
        nint src = zan_embed_bytes(name, lenBuf);
        if (src == 0) { return false; }
        // 小端在目标平台上都成立（x86/ARM），这里按字节拼回长度而不是
        // 引入一个只为读 int 的指针 API。
        int len = (int)lenBuf[0] + (int)lenBuf[1] * 256
        + (int)lenBuf[2] * 65536 + (int)lenBuf[3] * 16777216;
        if (len <= 0) { return false; }
        if (File.Exists(dest) && File.GetSize(dest) == len) { return true; }
        // 先写临时文件再改名：另一个进程可能正好在加载这份资源，半个
        // 文件被 LoadLibrary/dlopen 看到就是一次莫名的加载失败。
        string part = dest + ".part";
        FileStream fs = FileStream.OpenWrite(part);
        int wrote = fs.WriteFrom(src, len);
        fs.Close();
        if (wrote != len) {
            File.Delete(part);
            return false;
        }
        File.Move(part, dest);
        if (File.Exists(dest) && File.GetSize(dest) == len) {
            File.Delete(part);
            return true;
        }
        File.Delete(part);
        return false;
    }

    /// <summary>将原始字节追加到文件末尾（二进制安全）。
    /// 文件不存在时创建。</summary>
    static void AppendAllBytes(string path, byte[] data) {
        nint fp = fopen(path, "ab");
        if (fp == 0) {
            throw new IOException("Could not open file for appending: " + path);
        }
        long written = fwrite(data, 1, data.Length, fp);
        fclose(fp);
        if (written != (long)data.Length) {
            throw new IOException("Could not append complete data to file: " + path);
        }
    }
}
