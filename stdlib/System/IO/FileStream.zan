using System;

namespace System.IO;

/// <summary>
/// 基于磁盘文件的 <see cref="Stream"/>。偏移量为 64 位，
/// 因此大于 2 GB 的文件也能在所有平台正确 seek。
///
///   FileStream fs = FileStream.Open("out.bin", "w+b");
///   fs.Write("header");
///   fs.Close();
///
/// 通过 <see cref="OpenRead"/>（只读）、<see cref="OpenWrite"/>（创建或
/// 截断，亦可读）、<see cref="Append"/>
/// 或 <see cref="Open"/>（显式 stdio 模式字符串）打开。打开失败
/// 会抛异常，因此返回的 FileStream 必定可用。
/// </summary>
class FileStream : Stream {
    [DllImport("crt")]
    static extern long zan_file_open(string path, string mode);
    [DllImport("crt")]
    static extern long zan_file_read(long handle, nint buf, long count);
    [DllImport("crt")]
    static extern long zan_file_write(long handle, nint buf, long count);
    [DllImport("crt")]
    static extern long zan_file_seek(long handle, long offset, int origin);
    [DllImport("crt")]
    static extern long zan_file_tell(long handle);
    [DllImport("crt")]
    static extern long zan_file_flush(long handle);
    [DllImport("crt")]
    static extern long zan_file_close(long handle);
    [DllImport("crt")]
    static extern long zan_file_eof(long handle);

    long handle;
    string path;
    bool readable;
    bool writable;

    FileStream() {
        this.handle = 0;
        this.path = "";
        this.readable = false;
        this.writable = false;
    }

    /// <summary>以 stdio 模式字符串（“rb”、“wb”、“r+b”、
    /// “ab”）打开 `path`。打开失败时抛出 FileNotFoundException/IOException。
    /// </summary>
    static FileStream Open(string path, string mode) {
        long h = zan_file_open(path, mode);
        if (h == 0) {
            if (mode.Substring(0, 1) == "r") {
                throw new FileNotFoundException("Could not open file: " + path);
            }
            throw new IOException("Could not open file for writing: " + path);
        }
        FileStream fs = new FileStream();
        fs.handle = h;
        fs.path = path;
        fs.readable = mode.Substring(0, 1) == "r" || mode.Contains("+");
        fs.writable = mode.Substring(0, 1) != "r" || mode.Contains("+");
        return fs;
    }

    /// <summary>以只读方式打开已有文件。</summary>
    static FileStream OpenRead(string path) {
        return FileStream.Open(path, "rb");
    }

    /// <summary>创建或截断文件用于写入（也可读）。使用
    /// 模式“w+b”的 <see cref="Open"/>——已存在的文件会被
    /// 清空，因此写短内容不会残留旧数据。</summary>
    static FileStream OpenWrite(string path) {
        return FileStream.Open(path, "w+b");
    }

    /// <summary>以追加方式打开文件，不存在时创建。</summary>
    static FileStream Append(string path) {
        return FileStream.Open(path, "ab");
    }

    /// <summary>该流打开时的路径。</summary>
    string Path() { return this.path; }

    /// <summary>调用过 <see cref="Close"/> 后为 true。</summary>
    bool IsClosed() { return this.handle == 0; }

    override bool CanRead() { return this.readable && this.handle != 0; }

    override bool CanWrite() { return this.writable && this.handle != 0; }

    override bool CanSeek() { return this.handle != 0; }

    override long Length() {
        if (this.handle == 0) { return -1; }
        long here = zan_file_tell(this.handle);
        long end = zan_file_seek(this.handle, 0, 2);
        zan_file_seek(this.handle, here, 0);
        return end;
    }

    override long Position() {
        if (this.handle == 0) { return -1; }
        return zan_file_tell(this.handle);
    }

    override long Seek(long offset, int origin) {
        if (this.handle == 0) { return -1; }
        return zan_file_seek(this.handle, offset, origin);
    }

    override int ReadInto(nint buf, int count) {
        if (this.handle == 0 || count <= 0) { return 0; }
        return (int)zan_file_read(this.handle, buf, count);
    }

    override int WriteFrom(nint buf, int count) {
        if (this.handle == 0 || count <= 0) { return 0; }
        return (int)zan_file_write(this.handle, buf, count);
    }

    /// <summary>读取到达文件末尾后为 true。</summary>
    bool EndOfFile() {
        if (this.handle == 0) { return true; }
        return zan_file_eof(this.handle) == 1;
    }

    override void Flush() {
        if (this.handle != 0) {
            zan_file_flush(this.handle);
        }
    }

    override void Close() {
        if (this.handle != 0) {
            zan_file_close(this.handle);
            this.handle = 0;
        }
    }
}
