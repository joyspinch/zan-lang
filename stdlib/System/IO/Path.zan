using System;

namespace System.IO;

/// <summary>
/// 路径操作工具。纯字符串处理：唯一剩下的平台调用
/// 是向操作系统询问临时目录位置的那一个。
/// </summary>
class Path {
    #if WINDOWS
    [DllImport("kernel32", EntryPoint = "GetTempPathA")]
    static extern int WinGetTempPath(int bufLen, string buf);
    #else
    [DllImport("crt")]
    static extern string getenv(string name);
    #endif

    /// <summary>最后一个分隔符之后的索引，没有分隔符时为 0。</summary>
    static int AfterLastSeparator(string path) {
        int slash = path.LastIndexOf("/");
        int bslash = path.LastIndexOf("\\");
        int sep = slash;
        if (bslash > sep) { sep = bslash; }
        if (sep < 0) { return 0; }
        return sep + 1;
    }

    /// <summary>从路径中返回文件名（含扩展名）。</summary>
    static string GetFileName(string path) {
        int start = Path.AfterLastSeparator(path);
        if (start == 0) { return path; }
        return path.Substring(start, path.Length - start);
    }

    /// <summary>返回扩展名（含点）。</summary>
    static string GetExtension(string path) {
        string fname = Path.GetFileName(path);
        int dot = fname.LastIndexOf(".");
        if (dot < 0) { return ""; }
        return fname.Substring(dot, fname.Length - dot);
    }

    /// <summary>平台目录分隔符。</summary>
    static string Separator() {
        #if WINDOWS
        return "\\";
        #else
        return "/";
        #endif
    }

    /// <summary>用平台分隔符拼接两个路径字符串。</summary>
    static string Combine(string path1, string path2) {
        return path1 + Path.Separator() + path2;
    }

    /// <summary>返回路径的目录部分。</summary>
    static string GetDirectoryName(string path) {
        int start = Path.AfterLastSeparator(path);
        if (start == 0) { return ""; }
        return path.Substring(0, start - 1);
    }

    /// <summary>返回不含扩展名的文件名。</summary>
    static string GetFileNameWithoutExtension(string path) {
        string fname = Path.GetFileName(path);
        int dot = fname.LastIndexOf(".");
        if (dot < 0) { return fname; }
        return fname.Substring(0, dot);
    }

    /// <summary>更改路径字符串的扩展名。</summary>
    static string ChangeExtension(string path, string extension) {
        int dot = path.LastIndexOf(".");
        int sepAt = Path.AfterLastSeparator(path);
        if (dot < sepAt) { dot = -1; }
        if (dot < 0) { return path + extension; }
        return path.Substring(0, dot) + extension;
    }

    /// <summary>检查路径是否带扩展名。</summary>
    static bool HasExtension(string path) {
        return Path.GetExtension(path) != "";
    }

    /// <summary>获取系统临时目录路径。</summary>
    static string GetTempPath() {
        #if WINDOWS
        byte[] buf = new byte[4096];
        int n = WinGetTempPath(4096, buf);
        return buf.ToStr(0, n);
        #else
        string t = getenv("TMPDIR");
        if (t != null && t != "") { return t; }
        return "/tmp/";
        #endif
    }

    /// <summary>将路径分隔符规范化为平台分隔符。</summary>
    static string Normalize(string path) {
        string sep = Path.Separator();
        StringBuilder sb = new StringBuilder();
        int len = path.Length;
        for (int i = 0; i < len; i = i + 1) {
            string ch = path.Substring(i, 1);
            if (ch == "/" || ch == "\\") { sb.Append(sep); }
            else { sb.Append(ch); }
        }
        return sb.ToString();
    }
}
