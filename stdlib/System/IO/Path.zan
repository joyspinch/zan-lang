using System;

namespace System.IO;

// 路径操作工具。完整路径按当前工作目录解析，不要求目标存在；
// Windows 的完整路径与临时目录查询使用 UTF-16 系统接口。
public class Path {
    #if WINDOWS
    [DllImport("kernel32", EntryPoint = "GetTempPathW")]
    private static extern int WinGetTempPath(int bufLen, nint buf);

    [DllImport("kernel32", EntryPoint = "GetFullPathNameW")]
    private static extern int WinGetFullPathName(nint path, int bufLen, nint buf, nint filePart);
    #endif

    // 最后一个分隔符之后的索引，没有分隔符时为 0。
    private static int AfterLastSeparator(string path) {
        for (int i = path.Length - 1; i >= 0; i = i - 1) {
            if (Path.IsDirectorySeparator(path[i] & 255)) { return i + 1; }
        }
        return 0;
    }

    // 从路径中返回文件名（含扩展名）。
    public static string GetFileName(string path) {
        int start = Path.AfterLastSeparator(path);
        if (start == 0) { return path; }
        return path.Substring(start, path.Length - start);
    }

    // 返回扩展名（含点）。
    public static string GetExtension(string path) {
        string fname = Path.GetFileName(path);
        int dot = fname.LastIndexOf(".");
        if (dot < 0) { return ""; }
        return fname.Substring(dot, fname.Length - dot);
    }

    // 平台目录分隔符。
    public static string Separator() {
        #if WINDOWS
        return "\\";
        #else
        return "/";
        #endif
    }

    // 拼接路径；第二个路径有根时直接返回它，空路径不添加分隔符。
    // 保留输入中的分隔符，仅在连接处缺少分隔符时添加一个。
    public static string Combine(string path1, string path2) {
        if (path1 == null || path2 == null) {
            throw new ArgumentException("path must not be null");
        }
        if (path2.Length == 0) { return path1; }
        if (path1.Length == 0 || Path.IsPathRooted(path2)) { return path2; }
        int last = path1[path1.Length - 1] & 255;
        if (Path.IsDirectorySeparator(last)) { return path1 + path2; }
        return path1 + Path.Separator() + path2;
    }

    // 检查路径是否有根。Windows 的盘符相对路径（C:foo）也有根，
    // 但仍需要当前目录解析；POSIX 只有 / 是分隔符。
    public static bool IsPathRooted(string path) {
        if (path == null || path.Length == 0) { return false; }
        if (Path.IsDirectorySeparator(path[0] & 255)) { return true; }
        #if WINDOWS
        if (path.Length >= 2 && (path[1] & 255) == 58) {
            int drive = path[0] & 255;
            return (drive >= 65 && drive <= 90) || (drive >= 97 && drive <= 122);
        }
        #endif
        return false;
    }

    private static bool IsDirectorySeparator(int c) {
        if (c == 47) { return true; }
        #if WINDOWS
        return c == 92;
        #else
        return false;
        #endif
    }

    // 按当前工作目录解析完整路径，不要求文件或目录存在。
    // 空路径或含 NUL 的路径抛 ArgumentException，系统查询失败抛 IOException。
    public static string GetFullPath(string path) {
        if (path == null || path.Length == 0) {
            throw new ArgumentException("path must not be empty");
        }
        for (int i = 0; i < path.Length; i = i + 1) {
            if ((path[i] & 255) == 0) {
                throw new ArgumentException("path must not contain NUL");
            }
        }
        #if WINDOWS
        nint input = Wide.Of(path);
        try {
            int size = 256;
            while (true) {
                nint buf = NativeMemory.Alloc(size * 2);
                try {
                    int n = Path.WinGetFullPathName(input, size, buf, 0);
                    if (n <= 0) { throw new IOException("Could not resolve full path: " + path); }
                    if (n < size) { return Wide.Read(buf); }
                    if (n >= 1073741823) { throw new IOException("Full path is too long"); }
                    size = n + 1;
                } finally {
                    NativeMemory.Free(buf);
                }
            }
        } finally {
            Wide.Free(input);
        }
        #else
        string full = path;
        if (!Path.IsPathRooted(full)) {
            string cwd = Directory.GetCurrentDirectory();
            if (cwd == null || !Path.IsPathRooted(cwd)) {
                throw new IOException("Could not get current directory");
            }
            full = Path.Combine(cwd, full);
        }
        // 不调用 realpath：新文件也可解析，反斜杠与符号链接不改变词法路径。
        List<string> parts = new List<string>();
        int start = 0;
        for (int i = 0; i <= full.Length; i = i + 1) {
            if (i < full.Length && (full[i] & 255) != 47) { continue; }
            string part = full.Substring(start, i - start);
            start = i + 1;
            if (part == "" || part == ".") { continue; }
            if (part == "..") {
                if (parts.Count > 0) { parts.RemoveAt(parts.Count - 1); }
            } else {
                parts.Add(part);
            }
        }
        StringBuilder sb = new StringBuilder();
        sb.Append("/");
        for (int i = 0; i < parts.Count; i = i + 1) {
            if (i > 0) { sb.Append("/"); }
            sb.Append(parts[i]);
        }
        if (parts.Count > 0 && full.EndsWith("/")) { sb.Append("/"); }
        return sb.ToString();
        #endif
    }

    // 返回路径的目录部分。
    public static string GetDirectoryName(string path) {
        int start = Path.AfterLastSeparator(path);
        if (start == 0) { return ""; }
        return path.Substring(0, start - 1);
    }

    // 返回不含扩展名的文件名。
    public static string GetFileNameWithoutExtension(string path) {
        string fname = Path.GetFileName(path);
        int dot = fname.LastIndexOf(".");
        if (dot < 0) { return fname; }
        return fname.Substring(0, dot);
    }

    // 更改路径字符串的扩展名。
    public static string ChangeExtension(string path, string extension) {
        int dot = path.LastIndexOf(".");
        int sepAt = Path.AfterLastSeparator(path);
        if (dot < sepAt) { dot = -1; }
        if (dot < 0) { return path + extension; }
        return path.Substring(0, dot) + extension;
    }

    // 检查路径是否带扩展名。
    public static bool HasExtension(string path) {
        return Path.GetExtension(path) != "";
    }

    // 获取带末尾目录分隔符的系统临时目录路径；Windows 查询失败返回空串。
    public static string GetTempPath() {
        #if WINDOWS
        int size = 256;
        while (true) {
            nint buf = NativeMemory.Alloc(size * 2);
            try {
                int n = Path.WinGetTempPath(size, buf);
                if (n <= 0) { return ""; }
                if (n < size) {
                    string t = Wide.Read(buf);
                    if (t.Length == 0 || t.EndsWith("\\") || t.EndsWith("/")) { return t; }
                    return t + "\\";
                }
                if (n >= 1073741823) { return ""; }
                size = n + 1;
            } finally {
                NativeMemory.Free(buf);
            }
        }
        #else
        string t = Interop.EnvVar("TMPDIR");
        if (t == "") { return "/tmp/"; }
        if (t.EndsWith("/")) { return t; }
        return t + "/";
        #endif
    }

    // 将路径分隔符规范化为平台分隔符。
    public static string Normalize(string path) {
        if (path == null) { return ""; }
        string sep = Path.Separator();
        if (sep == "\\") {
            if (path.IndexOf("/") < 0) { return path; }
            return path.Replace("/", "\\");
        } else {
            if (path.IndexOf("\\") < 0) { return path; }
            return path.Replace("\\", "/");
        }
    }

    // 读取下一个按 '/' 或 '\' 分隔的路径段（零堆分配），更新游标 pos 与完成标志 done。
    private static void NextSeg(string s, int len, ref int pos, ref bool done, out int segStart, out int segLen) {
        segStart = pos;
        int i = pos;
        while (i < len) {
            int c = s[i] & 255;
            if (c == 47 || c == 92) {
                segLen = i - segStart;
                pos = i + 1;
                return;
            }
            i = i + 1;
        }
        segLen = len - segStart;
        pos = len;
        done = true;
    }

    // 零分配切片比较；Windows 上不区分大小写。
    private static bool SameSlice(string a, int aOff, int aLen, string b, int bOff, int bLen) {
        if (aLen != bLen) { return false; }
        #if WINDOWS
        for (int i = 0; i < aLen; i = i + 1) {
            int ca = a[aOff + i] & 255;
            int cb = b[bOff + i] & 255;
            if (ca >= 128 || cb >= 128) {
                return a.Substring(aOff, aLen).ToLower() == b.Substring(bOff, bLen).ToLower();
            }
            if (!Path.CharEqual(ca, cb)) { return false; }
        }
        return true;
        #else
        return NativeMemory.SequenceEqual((nint)a + (nint)aOff, (nint)b + (nint)bOff, aLen);
        #endif
    }

    private static bool IsDoubleStar(string s, int off, int len) {
        return len == 2 && (s[off] & 255) == 42 && (s[off + 1] & 255) == 42;
    }

    // 零分配单段通配符匹配：'*' 匹配任意字符序列，'?' 匹配单个字符（O(N+M) 迭代双指针）。
    private static bool SegmentMatchSlice(string pattern, int pOff, int plen, string segment, int sOff, int slen) {
        int pi = 0;
        int si = 0;
        int starPi = -1;
        int markSi = 0;
        while (si < slen) {
            if (pi < plen && (pattern[pOff + pi] & 255) == 42) { // '*'
                while (pi < plen && (pattern[pOff + pi] & 255) == 42) { pi = pi + 1; }
                starPi = pi;
                markSi = si;
            } else if (pi < plen && ((pattern[pOff + pi] & 255) == 63
                    || Path.CharEqual(pattern[pOff + pi] & 255, segment[sOff + si] & 255))) {
                pi = pi + 1;
                si = si + 1;
            } else if (starPi >= 0) {
                markSi = markSi + 1;
                si = markSi;
                pi = starPi;
            } else {
                return false;
            }
        }
        while (pi < plen && (pattern[pOff + pi] & 255) == 42) { pi = pi + 1; }
        return pi == plen;
    }

    private static int[] GrowSegInts(int[] arr, int count) {
        int[] nb = new int[arr.Length * 2];
        NativeMemory.Copy((nint)nb, (nint)arr, count * 4);
        return nb;
    }

    // 返回从 relativeTo 目录到 path 的相对路径（等同于现代 C# 的 Path.GetRelativePath）。
    // 两者按段游标比对公共前缀，单次 byte[] 缓冲直拼结果（零 List<string> 与 Substring 分配）。
    public static string GetRelativePath(string relativeTo, string path) {
        bool hasBack = (relativeTo != null && NativeMemory.Find((nint)relativeTo, 0, 92, relativeTo.Length) >= 0)
            || (path != null && NativeMemory.Find((nint)path, 0, 92, path.Length) >= 0);
        byte sepByte = hasBack ? (byte)92 : (byte)47;

        int aLen = relativeTo == null ? 0 : relativeTo.Length;
        int bLen = path == null ? 0 : path.Length;
        int aPos = 0;
        int bPos = 0;
        bool aDone = relativeTo == null;
        bool bDone = path == null;

        // 跳过公共段前缀
        int bRemPos = 0;
        bool bRemDone = bDone;
        int aRemPos = 0;
        bool aRemDone = aDone;
        while (!aDone && !bDone) {
            int curAPos = aPos;
            bool curADone = aDone;
            int curBPos = bPos;
            bool curBDone = bDone;
            int aOff; int aSLen;
            int bOff; int bSLen;
            Path.NextSeg(relativeTo, aLen, ref aPos, ref aDone, out aOff, out aSLen);
            Path.NextSeg(path, bLen, ref bPos, ref bDone, out bOff, out bSLen);
            if (!Path.SameSlice(relativeTo, aOff, aSLen, path, bOff, bSLen)) {
                aRemPos = curAPos;
                aRemDone = curADone;
                bRemPos = curBPos;
                bRemDone = curBDone;
                break;
            }
            aRemPos = aPos;
            aRemDone = aDone;
            bRemPos = bPos;
            bRemDone = bDone;
        }

        // 统计 relativeTo 剩余段数（每个变为 ".."）
        int up = 0;
        int taPos = aRemPos;
        bool taDone = aRemDone;
        while (!taDone) {
            int o; int l;
            Path.NextSeg(relativeTo, aLen, ref taPos, ref taDone, out o, out l);
            up = up + 1;
        }

        // 统计 path 剩余段数与总字节数
        int bRemCount = 0;
        int bRemBytes = 0;
        int tbPos = bRemPos;
        bool tbDone = bRemDone;
        while (!tbDone) {
            int o; int l;
            Path.NextSeg(path, bLen, ref tbPos, ref tbDone, out o, out l);
            bRemCount = bRemCount + 1;
            bRemBytes = bRemBytes + l;
        }

        int totalParts = up + bRemCount;
        if (totalParts == 0) { return "."; }
        int totalBytes = up * 2 + bRemBytes + (totalParts - 1);
        byte[] buf = new byte[totalBytes];
        nint dstPtr = (nint)buf;
        int wp = 0;
        for (int k = 0; k < up; k = k + 1) {
            if (wp > 0) { buf[wp] = sepByte; wp = wp + 1; }
            buf[wp] = 46;
            buf[wp + 1] = 46;
            wp = wp + 2;
        }
        if (bRemCount > 0) {
            nint pPtr = (nint)path;
            int cbPos = bRemPos;
            bool cbDone = bRemDone;
            int emitted = up;
            while (!cbDone) {
                int o; int l;
                Path.NextSeg(path, bLen, ref cbPos, ref cbDone, out o, out l);
                if (emitted > 0) { buf[wp] = sepByte; wp = wp + 1; }
                if (l > 0) {
                    NativeMemory.Copy(dstPtr + (nint)wp, pPtr + (nint)o, l);
                    wp = wp + l;
                }
                emitted = emitted + 1;
            }
        }
        return buf.ToStr(0, wp);
    }

    // 规范化路径并解析 . 与 .. 段（"a/./b/../c" -> "a/c"）。
    // 无法解析的前导 .. 会保留。分隔符按输入原样保留（扁平偏移栈 + 单次 byte[] 直拼）。
    public static string Clean(string path) {
        if (path == null || path.Length == 0) { return ""; }
        int len = path.Length;
        byte sepByte = NativeMemory.Find((nint)path, 0, 92, len) >= 0 ? (byte)92 : (byte)47;
        int c0 = path[0] & 255;
        bool rooted = (c0 == 47 || c0 == 92 || (len > 1 && (path[1] & 255) == 58));

        int[] starts = new int[32];
        int[] lens = new int[32];
        int outCnt = 0;
        int pos = 0;
        bool done = false;
        while (!done) {
            int segStart;
            int segLen;
            Path.NextSeg(path, len, ref pos, ref done, out segStart, out segLen);
            if (segLen == 0 || (segLen == 1 && (path[segStart] & 255) == 46)) {
                // 跳过 "" 与 "."
            } else if (segLen == 2 && (path[segStart] & 255) == 46 && (path[segStart + 1] & 255) == 46) {
                if (outCnt > 0) {
                    int topStart = starts[outCnt - 1];
                    int topLen = lens[outCnt - 1];
                    bool topIsDotDot = topLen == 2 && (path[topStart] & 255) == 46 && (path[topStart + 1] & 255) == 46;
                    if (!topIsDotDot) {
                        outCnt = outCnt - 1;
                    } else if (!rooted) {
                        if (outCnt >= starts.Length) {
                            starts = Path.GrowSegInts(starts, outCnt);
                            lens = Path.GrowSegInts(lens, outCnt);
                        }
                        starts[outCnt] = segStart;
                        lens[outCnt] = 2;
                        outCnt = outCnt + 1;
                    }
                } else if (!rooted) {
                    if (outCnt >= starts.Length) {
                        starts = Path.GrowSegInts(starts, outCnt);
                        lens = Path.GrowSegInts(lens, outCnt);
                    }
                    starts[outCnt] = segStart;
                    lens[outCnt] = 2;
                    outCnt = outCnt + 1;
                }
            } else {
                if (outCnt >= starts.Length) {
                    starts = Path.GrowSegInts(starts, outCnt);
                    lens = Path.GrowSegInts(lens, outCnt);
                }
                starts[outCnt] = segStart;
                lens[outCnt] = segLen;
                outCnt = outCnt + 1;
            }
        }
        if (outCnt == 0) { return ""; }
        int totalBytes = outCnt - 1;
        for (int i = 0; i < outCnt; i = i + 1) { totalBytes = totalBytes + lens[i]; }
        byte[] buf = new byte[totalBytes];
        nint srcPtr = (nint)path;
        nint dstPtr = (nint)buf;
        int wp = 0;
        for (int i = 0; i < outCnt; i = i + 1) {
            if (i > 0) { buf[wp] = sepByte; wp = wp + 1; }
            int sl = lens[i];
            if (sl > 0) {
                NativeMemory.Copy(dstPtr + (nint)wp, srcPtr + (nint)starts[i], sl);
                wp = wp + sl;
            }
        }
        return buf.ToStr(0, wp);
    }

    // 当 path 匹配 glob 模式 pattern 时为真。两者都接受
    // / 或 \ 分隔符。* 匹配单个路径段内，? 匹配一个字符，** 匹配零个或多个路径段（零分配游标匹配）。
    public static bool IsMatch(string pattern, string path) {
        int pLen = pattern == null ? 0 : pattern.Length;
        int tLen = path == null ? 0 : path.Length;
        int pPos = 0;
        int tPos = 0;
        bool pDone = pattern == null;
        bool tDone = path == null;

        int starPPos = -1;
        bool starPDone = false;
        int markTPos = 0;
        bool markTDone = false;

        while (!tDone) {
            int curPPos = pPos;
            bool curPDone = pDone;
            int curTPos = tPos;
            bool curTDone = tDone;

            if (!pDone) {
                int pSegStart; int pSegLen;
                Path.NextSeg(pattern, pLen, ref pPos, ref pDone, out pSegStart, out pSegLen);
                if (Path.IsDoubleStar(pattern, pSegStart, pSegLen)) {
                    while (!pDone) {
                        int nextPPos = pPos;
                        bool nextPDone = pDone;
                        int ns; int nl;
                        Path.NextSeg(pattern, pLen, ref nextPPos, ref nextPDone, out ns, out nl);
                        if (!Path.IsDoubleStar(pattern, ns, nl)) { break; }
                        pPos = nextPPos;
                        pDone = nextPDone;
                    }
                    starPPos = pPos;
                    starPDone = pDone;
                    markTPos = tPos;
                    markTDone = tDone;
                    continue;
                }
                int tSegStart; int tSegLen;
                Path.NextSeg(path, tLen, ref tPos, ref tDone, out tSegStart, out tSegLen);
                if (Path.SegmentMatchSlice(pattern, pSegStart, pSegLen, path, tSegStart, tSegLen)) {
                    continue;
                }
                // 未匹配：恢复游标并尝试回退到最近的 **
                pPos = curPPos;
                pDone = curPDone;
                tPos = curTPos;
                tDone = curTDone;
            }

            if (starPPos >= 0) {
                int skipStart; int skipLen;
                Path.NextSeg(path, tLen, ref markTPos, ref markTDone, out skipStart, out skipLen);
                tPos = markTPos;
                tDone = markTDone;
                pPos = starPPos;
                pDone = starPDone;
            } else {
                return false;
            }
        }
        while (!pDone) {
            int pSegStart; int pSegLen;
            Path.NextSeg(pattern, pLen, ref pPos, ref pDone, out pSegStart, out pSegLen);
            if (!Path.IsDoubleStar(pattern, pSegStart, pSegLen)) { return false; }
        }
        return true;
    }

    // 当 path 是 dir 的目录前缀（或等于 dir）时为真，
    // 在 Windows 上按段不区分大小写比较（零分配游标扫描）。
    public static bool IsUnder(string dir, string path) {
        if (dir == null) { return true; }
        if (path == null) { return false; }
        int aLen = dir.Length;
        int bLen = path.Length;
        int aPos = 0;
        int bPos = 0;
        bool aDone = false;
        bool bDone = false;
        while (!aDone) {
            if (bDone) { return false; }
            int aOff; int aSLen;
            int bOff; int bSLen;
            Path.NextSeg(dir, aLen, ref aPos, ref aDone, out aOff, out aSLen);
            Path.NextSeg(path, bLen, ref bPos, ref bDone, out bOff, out bSLen);
            if (!Path.SameSlice(dir, aOff, aSLen, path, bOff, bSLen)) { return false; }
        }
        return true;
    }

    // 按段迭代双指针匹配；"**" 消耗零个或多个路径段（最坏 O(N*M)，杜绝指数级回溯 ReDoS）。
    private static bool MatchSegments(List<string> pat, int pi, List<string> pth, int ti) {
        int plen = pat.Count;
        int tlen = pth.Count;
        int starPi = -1;
        int markTi = 0;
        while (ti < tlen) {
            if (pi < plen && pat[pi] == "**") {
                while (pi < plen && pat[pi] == "**") { pi = pi + 1; }
                starPi = pi;
                markTi = ti;
            } else if (pi < plen && Path.SegmentMatch(pat[pi], pth[ti])) {
                pi = pi + 1;
                ti = ti + 1;
            } else if (starPi >= 0) {
                markTi = markTi + 1;
                ti = markTi;
                pi = starPi;
            } else {
                return false;
            }
        }
        while (pi < plen && pat[pi] == "**") { pi = pi + 1; }
        return pi == plen;
    }

    // 单段通配符匹配：'*' 匹配任意字符序列，'?' 匹配单个字符（O(N+M) 迭代双指针，无 ReDoS）。
    // Windows 上不区分大小写。
    private static bool SegmentMatch(string pattern, string segment) {
        int plen = pattern.Length;
        int slen = segment.Length;
        int pi = 0;
        int si = 0;
        int starPi = -1;
        int markSi = 0;
        while (si < slen) {
            if (pi < plen && (pattern[pi] & 255) == 42) { // '*'
                while (pi < plen && (pattern[pi] & 255) == 42) { pi = pi + 1; }
                starPi = pi;
                markSi = si;
            } else if (pi < plen && ((pattern[pi] & 255) == 63 || Path.CharEqual(pattern[pi] & 255, segment[si] & 255))) {
                pi = pi + 1;
                si = si + 1;
            } else if (starPi >= 0) {
                markSi = markSi + 1;
                si = markSi;
                pi = starPi;
            } else {
                return false;
            }
        }
        while (pi < plen && (pattern[pi] & 255) == 42) { pi = pi + 1; }
        return pi == plen;
    }

    // 按 '/' 或 '\' 拆分路径（根路径保留空段）。
    private static List<string> SplitSegments(string path) {
        List<string> segs = new List<string>();
        if (path == null) { return segs; }
        int len = path.Length;
        int last = 0;
        for (int i = 0; i < len; i = i + 1) {
            int c = path[i] & 255;
            if (c == 47 || c == 92) {
                segs.Add(path.Substring(last, i - last));
                last = i + 1;
            }
        }
        segs.Add(path.Substring(last, len - last));
        return segs;
    }

    // 段比较；Windows 上不区分大小写。
    private static bool Same(string a, string b) {
        #if WINDOWS
        if (a.Length != b.Length) { return false; }
        for (int i = 0; i < a.Length; i = i + 1) {
            int ca = a[i] & 255;
            int cb = b[i] & 255;
            if (ca >= 128 || cb >= 128) {
                return a.ToLower() == b.ToLower();
            }
            if (!Path.CharEqual(ca, cb)) { return false; }
        }
        return true;
        #else
        return a == b;
        #endif
    }

    // 单字符比较；Windows 上不区分大小写。
    private static bool CharEqual(int a, int b) {
        if (a == b) { return true; }
        #if WINDOWS
        if (a >= 65 && a <= 90) { a = a + 32; }
        if (b >= 65 && b <= 90) { b = b + 32; }
        return a == b;
        #else
        return false;
        #endif
    }

    // 从 from 起查找子串；没有时返回 -1。
    private static int IndexOf(string hay, string needle, int from) {
        if (hay == null || needle == null) { return -1; }
        if (from < 0) { from = 0; }
        if (from > hay.Length) { return -1; }
        return hay.IndexOf(needle, from);
    }
}
