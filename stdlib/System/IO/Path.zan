using System;

namespace System.IO;

/// <summary>
/// Path manipulation utilities. Pure string handling: the only platform call
/// left is the one that asks the OS where the temp directory is.
/// </summary>
class Path {
    #if WINDOWS
    [DllImport("kernel32", EntryPoint = "GetTempPathA")]
    static extern int WinGetTempPath(int bufLen, string buf);

    [DllImport("crt")]
    static extern string calloc(long count, long size);
    #else
    [DllImport("crt")]
    static extern string getenv(string name);
    #endif

    /// <summary>Index just past the last separator, or 0 when there is none.</summary>
    static int AfterLastSeparator(string path) {
        int slash = path.LastIndexOf("/");
        int bslash = path.LastIndexOf("\\");
        int sep = slash;
        if (bslash > sep) { sep = bslash; }
        if (sep < 0) { return 0; }
        return sep + 1;
    }

    /// <summary>Returns the file name and extension from a path.</summary>
    static string GetFileName(string path) {
        int start = Path.AfterLastSeparator(path);
        if (start == 0) { return path; }
        return path.Substring(start, path.Length - start);
    }

    /// <summary>Returns the extension (including dot).</summary>
    static string GetExtension(string path) {
        string fname = Path.GetFileName(path);
        int dot = fname.LastIndexOf(".");
        if (dot < 0) { return ""; }
        return fname.Substring(dot, fname.Length - dot);
    }

    /// <summary>The platform's directory separator.</summary>
    static string Separator() {
        #if WINDOWS
        return "\\";
        #else
        return "/";
        #endif
    }

    /// <summary>Combines two path strings with the platform separator.</summary>
    static string Combine(string path1, string path2) {
        return path1 + Path.Separator() + path2;
    }

    /// <summary>Returns the directory portion of a path.</summary>
    static string GetDirectoryName(string path) {
        int start = Path.AfterLastSeparator(path);
        if (start == 0) { return ""; }
        return path.Substring(0, start - 1);
    }

    /// <summary>Returns file name without extension.</summary>
    static string GetFileNameWithoutExtension(string path) {
        string fname = Path.GetFileName(path);
        int dot = fname.LastIndexOf(".");
        if (dot < 0) { return fname; }
        return fname.Substring(0, dot);
    }

    /// <summary>Changes the extension of a path string.</summary>
    static string ChangeExtension(string path, string extension) {
        int dot = path.LastIndexOf(".");
        int sepAt = Path.AfterLastSeparator(path);
        if (dot < sepAt) { dot = -1; }
        if (dot < 0) { return path + extension; }
        return path.Substring(0, dot) + extension;
    }

    /// <summary>Checks whether a path has an extension.</summary>
    static bool HasExtension(string path) {
        return Path.GetExtension(path) != "";
    }

    /// <summary>Gets the system temporary directory path.</summary>
    static string GetTempPath() {
        #if WINDOWS
        string buf = calloc(4096, 1);
        WinGetTempPath(4096, buf);
        return buf;
        #else
        string t = getenv("TMPDIR");
        if (t != null && t != "") { return t; }
        return "/tmp/";
        #endif
    }

    /// <summary>Normalizes path separators to the platform separator.</summary>
    static string Normalize(string path) {
        string sep = Path.Separator();
        StringBuilder sb = new StringBuilder();
        int i = 0;
        int len = path.Length;
        while (i < len) {
            string ch = path.Substring(i, 1);
            if (ch == "/" || ch == "\\") { sb.Append(sep); }
            else { sb.Append(ch); }
            i = i + 1;
        }
        return sb.ToString();
    }
}
