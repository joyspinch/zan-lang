using System;
using System.IO;
using System.Threading;

namespace System.IO.Watch;

/* 位置说明：本文件曾放在 `stdlib/System/IO/`，而它是那里唯一 `using
 * System.Threading` 的文件——`using X.Y` 按目录整体拉入，所以**每一个**读文件的
 * 程序（以及经 IO 传染的 `System.Diagnostics` 使用者）都跟着链上线程运行时：
 * 实测一个只调 Console 的程序加 `using System.IO;` 从 45 个文件 / 401KB 涨到
 * 79 个文件 / 564KB。轮询式目录监视本来就是要开后台线程的能力，独立成
 * `System.IO.Watch` 后，需要它的程序自己写 `using System.IO.Watch;`。 */

/// <summary><see cref="DirectoryWatcher"/> 上报的文件系统变化类型。</summary>
class FileChange {
    /// 条目新增。
    static int Added() { return 1; }
    /// 条目删除。
    static int Removed() { return 2; }
    /// 内容修改（写入时间或大小变化）。
    static int Modified() { return 3; }
}

/// <summary><see cref="DirectoryWatcher.Watch"/> 的变化回调：
/// 条目名加一个 <see cref="FileChange"/> 类型。</summary>
delegate void FileChangeFn(string name, int change);

/// <summary>快照里的一条目记录：名称 + 最后写入时间 + 大小。</summary>
class FileSnapshot {
    string name;
    long lastWriteTime;
    long size;

    /// 构造一条快照记录。
    FileSnapshot(string name, long lastWriteTime, long size) {
        this.name = name;
        this.lastWriteTime = lastWriteTime;
        this.size = size;
    }
}

/// <summary>
/// 监听目录并上报文件变化（新增/删除/修改）。
/// 后台线程约每 250 ms 轮询一次目录列表，并与
/// 上一份快照按名称 + 最后写入时间比较，因此
/// 所有平台行为一致（无需 ReadDirectoryChangesW / inotify 相关代码），
/// 代价是最多约 250 ms 的延迟。不递归子目录。
///
///   DirectoryWatcher.Watch("C:\\data", OnChange);
///   ...
///   DirectoryWatcher.Stop();
///
/// 回调收到条目名与一个 <see cref="FileChange"/> 类型，
/// 且必须是非捕获（non-capturing）的。
/// </summary>
class DirectoryWatcher {
    /// 上一份快照；轮询线程每轮与它合并比较后替换。
    static List<FileSnapshot> lastSnapshot = new List<FileSnapshot>();
    /// 监听运行标志；Stop 置 false，轮询线程据此退出。
    static bool watching = false;

    /// <summary>开始监听 `path`。以下情况返回 false：
    /// 目录不存在或已有监听器在运行。</summary>
    static bool Watch(string path, FileChangeFn callback) {
        if (watching) { return false; }
        if (!Directory.Exists(path)) { return false; }
        DirectoryWatcher.dir = path;
        DirectoryWatcher.cb = callback;
        DirectoryWatcher.lastSnapshot = DirectoryWatcher.Snapshot();
        watching = true;
        return Thread.Start(DirectoryWatcher.Poll);
    }

    /// <summary>停止监听。当前这轮轮询结束后不再
    /// 投递任何事件。</summary>
    static void Stop() {
        watching = false;
    }

    /// 轮询线程主体：每 250 ms 拍一次快照并与上一份合并比较，
    /// 直到 Stop 把 watching 置为 false。
    static void Poll() {
        while (DirectoryWatcher.watching) {
            Thread.Sleep(250);
            List<FileSnapshot> snapshot = DirectoryWatcher.Snapshot();
            DirectoryWatcher.Compare(snapshot);
            DirectoryWatcher.lastSnapshot = snapshot;
        }
    }

    /// 构建按名称排序的名称 + 最后写入时间 + 大小快照。当
    /// 文件的大小或（秒级精度）写入时间发生变化时即视为
    /// “已修改”；同一秒内大小不变的重写无法
    /// 通过轮询检测到——这是文档所述的延迟/精度权衡。
    static List<FileSnapshot> Snapshot() {
        List<FileSnapshot> snapshot = new List<FileSnapshot>();
        List<string> files = Directory.GetFiles(DirectoryWatcher.dir);
        for (int i = 0; i < files.Count; i = i + 1) {
            // GetFiles 返回不带路径的条目名；拼接上被监听的目录
            // 以便 stat 调用读取到正确的文件。
            string full = Path.Combine(DirectoryWatcher.dir, files[i]);
            snapshot.Add(new FileSnapshot(
                files[i], FileInfo.GetLastWriteTime(full), FileInfo.GetLength(full)));
        }
        // 按名称对快照记录排序，使比较成为线性合并。
        int k = 1;
        while (k < snapshot.Count) {
            FileSnapshot key = snapshot[k];
            int j = k - 1;
            while (j >= 0 && snapshot[j].name.CompareTo(key.name) > 0) {
                snapshot[j + 1] = snapshot[j];
                j = j - 1;
            }
            snapshot[j + 1] = key;
            k = k + 1;
        }
        return snapshot;
    }

    /// 合并上一份与当前快照，对差异触发回调。
    static void Compare(List<FileSnapshot> current) {
        int i = 0;   // 上一份快照的索引
        int j = 0;   // 当前快照的索引
        while (i < DirectoryWatcher.lastSnapshot.Count || j < current.Count) {
            if (i >= DirectoryWatcher.lastSnapshot.Count) {
                DirectoryWatcher.cb(current[j].name, FileChange.Added());
                j = j + 1;
            } else if (j >= current.Count) {
                DirectoryWatcher.cb(
                    DirectoryWatcher.lastSnapshot[i].name, FileChange.Removed());
                i = i + 1;
            } else {
                FileSnapshot previous = DirectoryWatcher.lastSnapshot[i];
                FileSnapshot next = current[j];
                int cmp = previous.name.CompareTo(next.name);
                if (cmp < 0) {
                    DirectoryWatcher.cb(previous.name, FileChange.Removed());
                    i = i + 1;
                } else if (cmp > 0) {
                    DirectoryWatcher.cb(next.name, FileChange.Added());
                    j = j + 1;
                } else {
                    if (previous.lastWriteTime != next.lastWriteTime
                        || previous.size != next.size) {
                        DirectoryWatcher.cb(next.name, FileChange.Modified());
                    }
                    i = i + 1;
                    j = j + 1;
                }
            }
        }
    }

    /// 被监听的目录。
    static string dir = "";
    /// 变化回调（在轮询线程上执行）。
    static FileChangeFn cb;
}

