using System;

namespace System.IO;

/// <summary>
/// 基于可增长的堆外缓冲区的 <see cref="Stream"/>——测试中
/// 用作 FileStream 的内存替身，也是用流式代码构造
/// 字节载荷、再交给 socket 或文件的方式：
///   MemoryStream ms = MemoryStream.Alloc(64);
///   ms.Write("hello");
///   string all = ms.ToStr();
///   ms.Close();
///
/// 读写共用同一个游标（与 System.IO.MemoryStream 相同）：写入
/// 越过末尾会扩展缓冲区，Length 记录最高水位。
/// <see cref="Close"/> 释放缓冲区。
/// </summary>
class MemoryStream : Stream {
    nint data;
    int capacity;
    int length;
    int pos;

    MemoryStream() {
        this.data = 0;
        this.capacity = 0;
        this.length = 0;
        this.pos = 0;
    }

    /// <summary>给定初始容量的空可写流。</summary>
    static MemoryStream Alloc(int initialCapacity) {
        int cap = initialCapacity;
        if (cap < 16) { cap = 16; }
        MemoryStream ms = new MemoryStream();
        ms.data = NativeMemory.Alloc(cap);
        ms.capacity = cap;
        return ms;
    }

    /// <summary>基于 `s` 字节副本的流，位置为 0
    /// （二进制安全：内嵌 NUL 字节会保留）。</summary>
    static MemoryStream FromStr(string s) {
        int n = s.Length;
        MemoryStream ms = MemoryStream.Alloc(n + 1);
        NativeMemory.PutString(ms.data, 0, s, n);
        ms.length = n;
        return ms;
    }

    /// <summary>基于原始地址处 `count` 字节副本的流。</summary>
    static MemoryStream FromRaw(nint src, int count) {
        MemoryStream ms = MemoryStream.Alloc(count + 1);
        NativeMemory.Copy(ms.data, src, count);
        ms.length = count;
        return ms;
    }

    /// <summary>目前已写入的字节，以二进制安全字符串返回。</summary>
    string ToStr() {
        if (this.length <= 0) { return ""; }
        return NativeMemory.GetString(this.data, 0, this.length);
    }

    /// <summary>底层缓冲区地址，用于零拷贝 FFI。写入导致缓冲区增长后
    /// 以及 Close 之后失效。</summary>
    nint Raw() { return this.data; }

    void Grow(int needed) {
        if (needed <= this.capacity) { return; }
        int cap = this.capacity;
        if (cap < 16) { cap = 16; }
        while (cap < needed) {
            cap = cap * 2;
        }
        nint bigger = NativeMemory.Alloc(cap);
        if (this.length > 0) {
            NativeMemory.Copy(bigger, this.data, this.length);
        }
        if (this.capacity > 0) {
            NativeMemory.Free(this.data);
        }
        this.data = bigger;
        this.capacity = cap;
    }

    override bool CanRead() { return this.capacity > 0; }

    override bool CanWrite() { return this.capacity > 0; }

    override bool CanSeek() { return this.capacity > 0; }

    override long Length() { return this.length; }

    override long Position() { return this.pos; }

    override long Seek(long offset, int origin) {
        long target = offset;
        if (origin == 1) { target = this.pos + offset; }
        else if (origin == 2) { target = this.length + offset; }
        if (target < 0) { target = 0; }
        this.pos = (int)target;
        return this.pos;
    }

    /// <summary>清空内容并回到开头；保留缓冲区。</summary>
    void Clear() {
        this.length = 0;
        this.pos = 0;
    }

    override int ReadInto(nint buf, int count) {
        if (this.capacity == 0 || count <= 0) { return 0; }
        int avail = this.length - this.pos;
        if (avail <= 0) { return 0; }
        int n = count;
        if (n > avail) { n = avail; }
        NativeMemory.Copy(buf, this.data + this.pos, n);
        this.pos = this.pos + n;
        return n;
    }

    override int WriteFrom(nint buf, int count) {
        if (count <= 0) { return 0; }
        this.Grow(this.pos + count);
        NativeMemory.Copy(this.data + this.pos, buf, count);
        this.pos = this.pos + count;
        if (this.pos > this.length) {
            this.length = this.pos;
        }
        return count;
    }

    override void Close() {
        if (this.capacity > 0) {
            NativeMemory.Free(this.data);
            this.data = 0;
            this.capacity = 0;
            this.length = 0;
            this.pos = 0;
        }
    }
}
