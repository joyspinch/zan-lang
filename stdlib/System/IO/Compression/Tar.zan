using System;
using System.IO;

namespace System.IO.Compression;

/// <summary>tar 归档中的一个条目。</summary>
class TarEntry {
    /// <summary>归档内的路径，使用正斜杠，目录以 "/" 结尾。</summary>
    public string name;
    /// <summary>文件内容（目录条目为 null）。</summary>
    public byte[] data;
    /// <summary>目录条目为 true。</summary>
    public bool isDirectory;
    /// <summary>POSIX 权限（文件默认 0644，目录默认 0755）。</summary>
    public int mode;

    TarEntry(string name) {
        this.name = name;
    }
}

/// <summary>
/// POSIX ustar tar 读写器（无压缩 —— tar 只是容器；
/// 与 GZip 组合即为 .tar.gz）。可与 bsdtar、GNU tar、
/// Windows 的 tar.exe、Python tarfile 和 7-Zip 互通。超过 100 字节的名称会使用
/// ustar 前缀字段，因此长路径也能保留。
/// </summary>
class Tar {
    [DllImport("crt", EntryPoint = "fopen")]
    static extern nint PlatFopen(string path, string mode);

    [DllImport("crt", EntryPoint = "fread")]
    static extern long PlatFread(byte[] buf, long size, long count, nint fp);

    [DllImport("crt", EntryPoint = "fwrite")]
    static extern long PlatFwrite(byte[] buf, long size, long count, nint fp);

    [DllImport("crt", EntryPoint = "fclose")]
    static extern int PlatFclose(nint fp);

    /// <summary>在内存中构建 tar 归档。目录条目应
    /// 标记 isDirectory（或名称以 "/" 结尾）。</summary>
    static byte[] Create(List<TarEntry> entries) {
        // 每个头部 512 字节；数据按 512 字节边界补齐。
        int total = 1024;   // 结尾的两个零块
        int i = 0;
        for (; i < entries.Count; i = i + 1) {
            TarEntry e = entries[i];
            total = total + 512 + ((e.data == null ? 0 : e.data.Length) + 511) / 512 * 512;
        }
        byte[] out2 = new byte[total];
        int pos = 0;
        i = 0;
        while (i < entries.Count) {
            TarEntry e = entries[i];
            int hdr = pos;
            Tar.WriteHeader(out2, hdr, e);
            pos = pos + 512;
            if (e.data != null && e.data.Length > 0) {
                for (int k = 0; k < e.data.Length; k = k + 1) {
                    out2[pos + k] = e.data[k];
                }
                pos = pos + ((e.data.Length + 511) / 512) * 512;
            }
            i = i + 1;
        }
        return out2;
    }

    /// <summary>读取 tar 归档中的所有条目（含数据）。</summary>
    static List<TarEntry> Read(byte[] tar) {
        List<TarEntry> entries = new List<TarEntry>();
        int pos = 0;
        while (pos + 512 <= tar.Length) {
            if (Tar.IsZeroBlock(tar, pos)) { break; }
            if (tar[pos] == 0) { pos = pos + 512; continue; }   // 跳过填充
            // 校验校验和（字段 148..155，空格填充的八进制）。
            int stored = Tar.ParseOctal(tar, pos + 148, 8);
            int computed = Tar.HeaderSum(tar, pos);
            if (stored != computed) { return null; }             // 损坏
            string name = Tar.ReadStr(tar, pos, 100);
            string prefix = Tar.ReadStr(tar, pos + 345, 155);
            if (prefix.Length > 0) {
                name = prefix + "/" + name;
            }
            long size = Tar.ParseSize(tar, pos + 124);
            int type = tar[pos + 156] & 255;
            // 防炸弹 + 防溢出：size 来自归档头部（12 位八进制），
            // 用 long 累计，数据区必须整体落在归档内——byte[] 无越界
            // 检查，(size + 511) 的 int 溢出会让游标倒退、从缓冲区
            // 前方读取。
            if (size < 0) { return null; }
            long dataLen = ((size + 511) / 512) * 512;
            if ((long)pos + 512 + dataLen > tar.Length) { return null; }
            TarEntry e = new TarEntry(name);
            e.mode = Tar.ParseOctal(tar, pos + 100, 8);
            if (type == 53) {                      // '5' = 目录
                e.isDirectory = true;
            } else if (type == 0 || type == 48) {  // 普通文件（'0' 或 NUL）
                int isz = (int)size;
                e.data = new byte[isz];
                for (int k = 0; k < isz; k = k + 1) {
                    e.data[k] = tar[pos + 512 + k];
                }
            } else {
                e.isDirectory = false;
                e.data = null;                     // 符号链接/设备/其他
            }
            entries.Add(e);
            pos = pos + 512 + (int)dataLen;
        }
        return entries;
    }

    static void WriteHeader(byte[] b, int off, TarEntry e) {
        // 名称（100）+ 前缀（155）拆分，用于长路径。
        string name = e.name;
        string prefix = "";
        if (name.Length > 100) {
            // ustar 拆分：取最靠前的 '/'，使名称部分 ≤ 100 且前缀 ≤ 155
            // （前缀不含末尾的 '/'，读取端按 prefix + "/" + name 复原）。
            int split = 0 - 1;
            for (int i = 0; i < name.Length && i <= 155; i = i + 1) {
                if ((name[i] & 255) == 47 && name.Length - i - 1 <= 100) {
                    split = i;
                    break;
                }
            }
            if (split > 0) {
                prefix = name.Substring(0, split);
                name = name.Substring(split + 1, name.Length - split - 1);
            } else {
                name = name.Substring(0, 100);   // 无法拆分：只能截断
            }
        }
        Tar.WriteStr(b, off, name, 100);
        Tar.WriteOctal(b, off + 100, e.mode == 0 ? (e.isDirectory ? 493 : 420) : e.mode, 8);
        Tar.WriteOctal(b, off + 108, 0, 8);                 // uid
        Tar.WriteOctal(b, off + 116, 0, 8);                 // gid
        int size = (e.isDirectory || e.data == null) ? 0 : e.data.Length;
        Tar.WriteOctal(b, off + 124, size, 12);
        Tar.WriteOctal(b, off + 136, 0, 12);                // mtime
        // 校验和字段：先用空格占位，稍后计算
        int k = 148;
        while (k < 156) { b[off + k] = 32; k = k + 1; }
        b[off + 156] = (byte)(e.isDirectory ? 53 : 48);     // typeflag '5'/'0'
        k = 157;
        while (k < 257) { b[off + k] = 0; k = k + 1; }      // linkname
        Tar.WriteStr(b, off + 257, "ustar", 6);             // magic
        b[off + 263] = 0;
        Tar.WriteStr(b, off + 265, "00", 2);                // version
        k = 267;
        while (k < 345) { b[off + k] = 0; k = k + 1; }      // uname/gname
        Tar.WriteOctal(b, off + 329, 0, 8);                 // devmajor
        Tar.WriteOctal(b, off + 337, 0, 8);                 // devminor
        Tar.WriteStr(b, off + 345, prefix, 155);            // prefix
        k = 500;
        while (k < 512) { b[off + k] = 0; k = k + 1; }
        int sum = Tar.HeaderSum(b, off);
        Tar.WriteOctal(b, off + 148, sum, 8);
    }

    static int HeaderSum(byte[] b, int off) {
        int sum = 0;
        for (int i = 0; i < 512; i = i + 1) {
            // 校验和字段本身按 8 个空格计。
            int v = (i >= 148 && i < 156) ? 32 : (b[off + i] & 255);
            sum = sum + v;
        }
        return sum;
    }

    static bool IsZeroBlock(byte[] b, int off) {
        for (int i = 0; i < 512; i = i + 1) {
            if (b[off + i] != 0) { return false; }
        }
        return true;
    }

    static void WriteStr(byte[] b, int off, string s, int maxLen) {
        int n = s.Length;
        if (n > maxLen) { n = maxLen; }
        int i = 0;
        for (; i < n; i = i + 1) {
            b[off + i] = (byte)s[i];
        }
        while (i < maxLen) {
            b[off + i] = 0;
            i = i + 1;
        }
    }

    static string ReadStr(byte[] b, int off, int maxLen) {
        int len = 0;
        for (; len < maxLen && b[off + len] != 0; len = len + 1) { }
        if (len == 0) { return ""; }
        nint buf = NativeMemory.Alloc(len + 1);
        for (int i = 0; i < len; i = i + 1) {
            new Span<byte>(buf + i, 1)[0] = b[off + i];
        }
        string s = NativeMemory.GetString(buf, 0, len);
        NativeMemory.Free(buf);
        return s;
    }

    static void WriteOctal(byte[] b, int off, int v, int fieldLen) {
        // 八进制数字右对齐，最后一个字节为终止符（NUL）。
        char[] digits = new char[fieldLen];
        int i = 0;
        for (; i < fieldLen; i = i + 1) {
            digits[i] = ' ';
        }
        int pos = fieldLen - 2;
        int val = v;
        while (val > 0 && pos >= 0) {
            digits[pos] = (char)('0' + (val & 7));
            val = val >> 3;
            pos = pos - 1;
        }
        digits[fieldLen - 1] = '\0';
        i = 0;
        while (i < fieldLen) {
            b[off + i] = (byte)digits[i];
            i = i + 1;
        }
    }

    static int ParseOctal(byte[] b, int off, int fieldLen) {
        int v = 0;
        for (int i = 0; i < fieldLen; i = i + 1) {
            int c = b[off + i] & 255;
            if (c >= 48 && c <= 55) {
                v = (v << 3) | (c - 48);
            }
        }
        return v;
    }

    /// size 字段（12 位八进制）可能超过 int 范围，必须用 long
    /// 累计，否则攻击者把 32 位截断值写进 size 就能绕过边界检查。
    static long ParseSize(byte[] b, int off) {
        long v = 0;
        for (int i = 0; i < 12; i = i + 1) {
            int c = b[off + i] & 255;
            if (c >= 48 && c <= 55) {
                v = (v << 3) | (long)(c - 48);
            }
        }
        return v;
    }

    /// <summary>把 tar 归档流式解包到目录（按 64 KiB 分块读写，不把归档
    /// 整体读入内存，适合数百 MB 的运行时包）。支持 ustar 前缀长名与
    /// GNU 长名（'L'）条目；符号链接/设备等条目被跳过。返回写出的文件与
    /// 目录数，归档损坏或路径越界时返回 -1。</summary>
    static int ExtractFile(string tarPath, string destDir) {
        nint fp = PlatFopen(tarPath, "rb");
        if (fp == 0) { return 0 - 1; }
        string root = destDir;
        if (!root.EndsWith("/") && !root.EndsWith("\\")) { root = root + "/"; }
        Directory.CreateDirectoryRecursive(root);

        byte[] hdr = new byte[512];
        byte[] buf = new byte[65536];
        string longName = "";
        int count = 0;
        int failed = 0;
        bool more = true;
        while (more) {
            long got = PlatFread(hdr, 1, 512, fp);
            if (got <= 0) {
                more = false;
            } else if (got < 512) {
                failed = 1; more = false;
            } else if (Tar.IsZeroBlock(hdr, 0)) {
                more = false;
            } else if (Tar.ParseOctal(hdr, 148, 8) != Tar.HeaderSum(hdr, 0)) {
                failed = 1; more = false;
            } else {
                string name = Tar.ReadStr(hdr, 0, 100);
                string prefix = Tar.ReadStr(hdr, 345, 155);
                if (prefix.Length > 0) { name = prefix + "/" + name; }
                if (longName.Length > 0) { name = longName; longName = ""; }
                long size = Tar.ParseSize(hdr, 124);
                int mode = Tar.ParseOctal(hdr, 100, 8);
                int type = hdr[156] & 255;
                long pad = ((size + 511) / 512) * 512 - size;

                if (size < 0) {
                    failed = 1; more = false;
                } else if (type == 76) {                       // GNU 长名条目
                    longName = Tar.ReadName(fp, buf, size);
                    if (longName == null) { failed = 1; more = false; }
                    else if (!Tar.SkipBytes(fp, buf, pad)) { failed = 1; more = false; }
                } else if (!Tar.SafeName(name)) {
                    failed = 1; more = false;
                } else if (type == 53 || name.EndsWith("/")) { // 目录
                    Directory.CreateDirectoryRecursive(root + name);
                    count = count + 1;
                    if (!Tar.SkipBytes(fp, buf, size + pad)) { failed = 1; more = false; }
                } else if (type == 0 || type == 48) {          // 普通文件
                    string outPath = root + name;
                    int slash = Tar.LastSlash(outPath);
                    if (slash > 0) {
                        Directory.CreateDirectoryRecursive(outPath.Substring(0, slash));
                    }
                    if (!Tar.WriteMember(fp, buf, outPath, size)) {
                        failed = 1; more = false;
                    } else {
                        count = count + 1;
                        if ((mode & 73) != 0) { File.SetExecutable(outPath, true); }
                        if (!Tar.SkipBytes(fp, buf, pad)) { failed = 1; more = false; }
                    }
                } else {                                       // 链接/设备/其他
                    if (!Tar.SkipBytes(fp, buf, size + pad)) { failed = 1; more = false; }
                }
            }
        }
        PlatFclose(fp);
        if (failed != 0) { return 0 - 1; }
        return count;
    }

    // 归档内路径必须是相对路径且不含 ".." 段，否则解包会写到目标目录之外。
    static bool SafeName(string name) {
        if (name.Length == 0) { return false; }
        int c0 = name[0] & 255;
        if (c0 == 47 || c0 == 92) { return false; }                  // 绝对路径
        if (name.Length >= 2 && (name[1] & 255) == 58) { return false; } // "C:"
        int n = name.Length;
        int seg = 0;
        for (int i = 0; i <= n; i = i + 1) {
            int c = i < n ? (name[i] & 255) : 47;
            if (c == 47 || c == 92) {
                if (i - seg == 2 && (name[seg] & 255) == 46 && (name[seg+1] & 255) == 46) {
                    return false;
                }
                seg = i + 1;
            }
        }
        return true;
    }

    static int LastSlash(string path) {
        int last = 0 - 1;
        for (int i = 0; i < path.Length; i = i + 1) {
            int c = path[i] & 255;
            if (c == 47 || c == 92) { last = i; }
        }
        return last;
    }

    // 把条目数据（size 字节）写到 outPath；失败返回 false。
    static bool WriteMember(nint fp, byte[] buf, string outPath, long size) {
        nint ofp = PlatFopen(outPath, "wb");
        if (ofp == 0) { return false; }
        long left = size;
        bool ok = true;
        while (ok && left > 0) {
            long want = left > 65536 ? 65536 : left;
            long got = PlatFread(buf, 1, want, fp);
            if (got <= 0) { ok = false; }
            else {
                long put = PlatFwrite(buf, 1, got, ofp);
                if (put != got) { ok = false; }
                left = left - got;
            }
        }
        PlatFclose(ofp);
        return ok;
    }

    // 读取 GNU 长名条目的数据（NUL 结尾的路径）。
    static string ReadName(nint fp, byte[] buf, long size) {
        if (size <= 0 || size > 65536) { return null; }
        long got = PlatFread(buf, 1, size, fp);
        if (got != size) { return null; }
        return Tar.ReadStr(buf, 0, (int)size);
    }

    static bool SkipBytes(nint fp, byte[] buf, long count) {
        long left = count;
        while (left > 0) {
            long want = left > 65536 ? 65536 : left;
            long got = PlatFread(buf, 1, want, fp);
            if (got <= 0) { return false; }
            left = left - got;
        }
        return true;
    }
}
