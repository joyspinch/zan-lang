using System;

namespace System.IO.Compression;

/// <summary>CRC-32（IEEE 802.3，zlib 多项式 0xEDB88320）。</summary>
class Crc32 {
    static int[] table;

    // 0xEDB88320 和 0xFFFFFFFF 以有符号整数表示（编译器在此处
    // 会误处理这种看似无符号的十六进制字面量，因此显式写出来）。
    static int Poly = -306674912;   // 0xEDB88320
    static int AllOnes = -1;        // 0xFFFFFFFF

    static int[] Table() {
        if (Crc32.table != null) { return Crc32.table; }
        int[] t = new int[256];
        for (int i = 0; i < 256; i = i + 1) {
            int c = i;
            for (int k = 0; k < 8; k = k + 1) {
                if ((c & 1) != 0) {
                    c = (int)((uint)c >> 1) ^ Crc32.Poly;
                } else {
                    c = (int)((uint)c >> 1);
                }
            }
            t[i] = c;
        }
        Crc32.table = t;
        return t;
    }

    /// <summary>从 `crc` 起始对 `data` 计算 CRC-32（首次计算传 0）。</summary>
    static int Compute(byte[] data, int offset, int len, int crc) {
        int[] t = Crc32.Table();
        int c = crc ^ Crc32.AllOnes;
        for (int i = 0; i < len; i = i + 1) {
            c = (int)((uint)c >> 8) ^ t[(c ^ data[offset + i]) & 255];
        }
        return c ^ Crc32.AllOnes;
    }

    static int Compute(byte[] data) {
        return Crc32.Compute(data, 0, data.Length, 0);
    }
}
