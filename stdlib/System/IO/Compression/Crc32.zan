using System;

namespace System.IO.Compression;

/// <summary>CRC-32 (IEEE 802.3, zlib polynomial 0xEDB88320).</summary>
class Crc32 {
    static int[] table;

    // 0xEDB88320 and 0xFFFFFFFF as signed ints (the compiler mishandles
    // unsigned-looking hex literals in this context, so keep them explicit).
    static int Poly = -306674912;   // 0xEDB88320
    static int AllOnes = -1;        // 0xFFFFFFFF

    static int[] Table() {
        if (Crc32.table != null) { return Crc32.table; }
        int[] t = new int[256];
        int i = 0;
        while (i < 256) {
            int c = i;
            int k = 0;
            while (k < 8) {
                if ((c & 1) != 0) {
                    c = (int)((uint)c >> 1) ^ Crc32.Poly;
                } else {
                    c = (int)((uint)c >> 1);
                }
                k = k + 1;
            }
            t[i] = c;
            i = i + 1;
        }
        Crc32.table = t;
        return t;
    }

    /// <summary>CRC-32 of `data` starting from `crc` (pass 0 for a fresh run).</summary>
    static int Compute(byte[] data, int offset, int len, int crc) {
        int[] t = Crc32.Table();
        int c = crc ^ Crc32.AllOnes;
        int i = 0;
        while (i < len) {
            c = (int)((uint)c >> 8) ^ t[(c ^ data[offset + i]) & 255];
            i = i + 1;
        }
        return c ^ Crc32.AllOnes;
    }

    static int Compute(byte[] data) {
        return Crc32.Compute(data, 0, data.Length, 0);
    }
}
