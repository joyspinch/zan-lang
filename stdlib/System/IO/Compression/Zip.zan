using System;
using System.IO;

namespace System.IO.Compression;

/// <summary>zip 归档中的一个条目。</summary>
class ZipEntry {
    /// <summary>归档内的路径，使用正斜杠，目录以 "/" 结尾。</summary>
    public string name;
    /// <summary>文件内容（目录条目为 null）。</summary>
    public byte[] data;
    /// <summary>目录条目为 true。</summary>
    public bool isDirectory;
    // 由 Zip.Read / Zip.Extract 填充：
    public int method;
    public int crc32;
    public int compressedSize;
    public int uncompressedSize;

    ZipEntry(string name) {
        this.name = name;
    }
}

/// <summary>
/// ZIP 归档读写器（PKZIP，无加密，支持 stored + deflate
/// 条目）。可与所有标准解压工具互通（Windows 资源管理器、
/// .NET ZipArchive、Python zipfile、7-Zip、Info-ZIP 等）。不依赖
/// zlib 或任何原生库。
/// </summary>
class Zip {
    // 本地文件头签名 PK\x03\x04
    static int SigLocal = 0x04034B50;
    // 中央目录文件头签名 PK\x01\x02
    static int SigCentral = 0x02014B50;
    // 中央目录结束签名 PK\x05\x06
    static int SigEnd = 0x06054B50;
    static int MethodStored = 0;
    static int MethodDeflate = 8;

    /// <summary>
    /// 根据 `entries` 在内存中构建 zip 归档。目录条目是
    /// 名称以 "/" 结尾或 isDirectory 为 true 的条目。
    /// 压缩级别 1-9（0 = 存储）。返回的字节为完整
    /// 归档：本地头 + 数据、中央目录、EOCD。
    /// </summary>
    static byte[] Create(List<ZipEntry> entries, int level) {
        // 第一步：压缩全部数据，以便得知大小。
        int i = 0;
        for (; i < entries.Count; i = i + 1) {
            ZipEntry e = entries[i];
            if (!e.isDirectory && e.data != null) {
                e.crc32 = Crc32.Compute(e.data, 0, e.data.Length, 0);
                e.uncompressedSize = e.data.Length;
                if (level > 0 && e.data.Length >= 64) {
                    e.method = Zip.MethodDeflate;
                    e.compressedSize = Deflate.Deflate(e.data, level).Length;
                } else {
                    e.method = Zip.MethodStored;
                    e.compressedSize = e.data.Length;
                }
            } else {
                e.method = Zip.MethodStored;
                e.compressedSize = 0;
                e.uncompressedSize = 0;
            }
        }
        // 第二步：计算总大小。
        int total = 0;
        i = 0;
        while (i < entries.Count) {
            ZipEntry e = entries[i];
            total = total + 30 + e.name.Length + e.compressedSize;
            i = i + 1;
        }
        int cdStart = total;
        i = 0;
        while (i < entries.Count) {
            ZipEntry e = entries[i];
            total = total + 46 + e.name.Length;
            i = i + 1;
        }
        total = total + 22;
        byte[] out2 = new byte[total];
        int pos = 0;
        int cdSize = 0;
        int[] cdOffsets = new int[entries.Count];
        i = 0;
        while (i < entries.Count) {
            ZipEntry e = entries[i];
            cdOffsets[i] = pos;
            int nameLen = e.name.Length;
            Zip.WriteU32(out2, ref pos, Zip.SigLocal);
            Zip.WriteU16(out2, ref pos, 20);            // 所需版本
            Zip.WriteU16(out2, ref pos, 0);             // 标志
            Zip.WriteU16(out2, ref pos, e.method);
            Zip.WriteU16(out2, ref pos, 0);             // 修改时间
            Zip.WriteU16(out2, ref pos, 0);             // 修改日期
            Zip.WriteU32(out2, ref pos, e.crc32);
            Zip.WriteU32(out2, ref pos, e.compressedSize);
            Zip.WriteU32(out2, ref pos, e.uncompressedSize);
            Zip.WriteU16(out2, ref pos, nameLen);
            Zip.WriteU16(out2, ref pos, 0);             // 额外字段长度
            int k = 0;
            for (; k < nameLen; k = k + 1) {
                out2[pos + k] = (byte)e.name[k];
            }
            pos = pos + nameLen;
            if (e.compressedSize > 0 && e.data != null) {
                if (e.method == Zip.MethodDeflate) {
                    byte[] comp = Deflate.Deflate(e.data, level);
                    k = 0;
                    while (k < comp.Length) {
                        out2[pos + k] = comp[k];
                        k = k + 1;
                    }
                } else {
                    k = 0;
                    while (k < e.data.Length) {
                        out2[pos + k] = e.data[k];
                        k = k + 1;
                    }
                }
                pos = pos + e.compressedSize;
            }
            i = i + 1;
        }
        // 中央目录。
        int cdPos = pos;
        i = 0;
        while (i < entries.Count) {
            ZipEntry e = entries[i];
            int nameLen = e.name.Length;
            Zip.WriteU32(out2, ref pos, Zip.SigCentral);
            Zip.WriteU16(out2, ref pos, 20);            // 制作版本
            Zip.WriteU16(out2, ref pos, 20);            // 所需版本
            Zip.WriteU16(out2, ref pos, 0);             // 标志
            Zip.WriteU16(out2, ref pos, e.method);
            Zip.WriteU16(out2, ref pos, 0);
            Zip.WriteU16(out2, ref pos, 0);
            Zip.WriteU32(out2, ref pos, e.crc32);
            Zip.WriteU32(out2, ref pos, e.compressedSize);
            Zip.WriteU32(out2, ref pos, e.uncompressedSize);
            Zip.WriteU16(out2, ref pos, nameLen);
            Zip.WriteU16(out2, ref pos, 0);             // 额外字段
            Zip.WriteU16(out2, ref pos, 0);             // 注释
            Zip.WriteU16(out2, ref pos, 0);             // 起始磁盘
            Zip.WriteU16(out2, ref pos, 0);             // 内部属性
            Zip.WriteU32(out2, ref pos, 0);             // 外部属性
            Zip.WriteU32(out2, ref pos, cdOffsets[i]);
            for (int k = 0; k < nameLen; k = k + 1) {
                out2[pos + k] = (byte)e.name[k];
            }
            pos = pos + nameLen;
            cdSize = cdSize + 46 + nameLen;
            i = i + 1;
        }
        // EOCD。
        Zip.WriteU32(out2, ref pos, Zip.SigEnd);
        Zip.WriteU16(out2, ref pos, 0);                 // 磁盘编号
        Zip.WriteU16(out2, ref pos, 0);                 // CD 所在磁盘
        Zip.WriteU16(out2, ref pos, entries.Count);
        Zip.WriteU16(out2, ref pos, entries.Count);
        Zip.WriteU32(out2, ref pos, cdSize);
        Zip.WriteU32(out2, ref pos, cdPos);
        Zip.WriteU16(out2, ref pos, 0);                 // 注释长度
        return out2;
    }

    /// <summary>读取中央目录并返回条目列表（数据未
    /// 加载）。</summary>
    static List<ZipEntry> Read(byte[] zip) {
        // 从末尾向前扫描 PK\x05\x06 定位 EOCD。
        int eocd = -1;
        int scan = zip.Length - 22;
        if (scan < 0) { scan = 0; }
        while (scan <= zip.Length - 22) {
            if (Zip.ReadU32(zip, scan) == Zip.SigEnd) { eocd = scan; break; }
            scan = scan + 1;
        }
        if (eocd < 0) { return null; }
        int entryCount = Zip.ReadU16(zip, eocd + 10);
        int cdSize = (int)Zip.ReadU32(zip, eocd + 12);
        int cdPos = (int)Zip.ReadU32(zip, eocd + 16);
        // long 运算：这两个值来自 EOCD，int 加法会溢出为负，
        // 使负偏移绕过检查后从缓冲区前方读取。
        if (cdPos < 0 || cdSize < 0) { return null; }
        if ((long)cdPos + (long)cdSize > zip.Length) { return null; }
        List<ZipEntry> entries = new List<ZipEntry>();
        int p = cdPos;
        for (int i = 0; i < entryCount; i = i + 1) {
            // 每个条目都要整体落在归档内（头部字段到 p+45，
            // 名称/额外/注释由长度字段决定）——byte[] 无越界
            // 检查，越过末尾会读到堆上垃圾。
            if (p + 46 > zip.Length) { return null; }
            if (Zip.ReadU32(zip, p) != Zip.SigCentral) { return null; }
            int method = Zip.ReadU16(zip, p + 10);
            int crc = (int)Zip.ReadU32(zip, p + 16);
            int csize = (int)Zip.ReadU32(zip, p + 20);
            int usize = (int)Zip.ReadU32(zip, p + 24);
            int nameLen = Zip.ReadU16(zip, p + 28);
            int extraLen = Zip.ReadU16(zip, p + 30);
            int commentLen = Zip.ReadU16(zip, p + 32);
            int lho = (int)Zip.ReadU32(zip, p + 42);
            if (p + 46 + nameLen + extraLen + commentLen > zip.Length) {
                return null;
            }
            string name = Zip.ReadName(zip, p + 46, nameLen);
            ZipEntry e = new ZipEntry(name);
            e.method = method;
            e.crc32 = crc;
            e.compressedSize = csize;
            e.uncompressedSize = usize;
            e.isDirectory = Zip.EndsWithSlash(name);
            entries.Add(e);
            p = p + 46 + nameLen + extraLen + commentLen;
        }
        return entries;
    }

    /// <summary>提取单个条目的内容（必要时解压）。
    /// 条目无法定位或已损坏时返回 null。</summary>
    static byte[] Extract(byte[] zip, ZipEntry e) {
        if (e.isDirectory) { return null; }
        // 在 e 的数据附近扫描 PK\x03\x04 定位 local header：
        // 中央目录偏移已知，但反向回溯不可靠，因此
        // 改为从头向前扫描，寻找名称匹配的签名。
        int lho = Zip.FindLocal(zip, e.name);
        if (lho < 0) { return null; }
        // 读取固定字段前，先保证 local header 的固定部分存在。
        if (lho + 30 > zip.Length) { return null; }
        int method = Zip.ReadU16(zip, lho + 8);
        int csize = (int)Zip.ReadU32(zip, lho + 18);
        int usize = (int)Zip.ReadU32(zip, lho + 22);
        int nameLen = Zip.ReadU16(zip, lho + 26);
        int extraLen = Zip.ReadU16(zip, lho + 28);
        // 验证完整 local header（固定 30 字节 + 名称 + 额外字段）
        // 不越界，并用 long 防止 int 加法回绕。
        if (lho < 0 || nameLen < 0 || extraLen < 0) { return null; }
        long headerEnd = (long)lho + 30L + (long)nameLen + (long)extraLen;
        if (headerEnd > zip.Length) { return null; }
        long dataPos = headerEnd;
        if (csize < 0 || dataPos + (long)csize > (long)zip.Length) { return null; }
        byte[] raw = new byte[csize];
        for (int k = 0; k < csize; k = k + 1) {
            raw[k] = zip[dataPos + k];
        }
        byte[] content = null;
        if (method == Zip.MethodDeflate) {
            // 防压缩炸弹：声明的解压大小不能超过硬上限，
            // 压缩比也不能过高（usize 来自归档头部，不可信）。
            if (usize < 0 || usize > 268435456) { return null; }
            if ((long)usize > (long)csize * 4096 + 1048576) { return null; }
            content = Deflate.Inflate(raw, 0, raw.Length, usize + 1);
        } else {
            content = raw;
        }
        if (content == null) { return null; }
        int got = Crc32.Compute(content, 0, content.Length, 0);
        if (got != e.crc32 || content.Length != usize) { return null; }
        return content;
    }

    /// <summary>把 zip 归档解包到目录：目录条目建目录，文件条目按归档内
    /// 的相对路径写出（缺的中间目录会补上）。返回写出的条目数；归档读不动、
    /// 中央目录损坏、某个条目解压失败或路径越出 <paramref name="destDir"/>
    /// 时返回 -1。
    ///
    /// 与 <see cref="Tar.ExtractFile"/> 对齐的一点：归档内路径必须是不含
    /// ".." 段的相对路径，否则整包按损坏处理——一个精心构造的归档否则能
    /// 写到目标目录之外。</summary>
    static int ExtractToDirectory(string zipPath, string destDir) {
        byte[] zip = File.ReadAllBytes(zipPath);
        if (zip == null || zip.Length == 0) { return 0 - 1; }
        List<ZipEntry> entries = Zip.Read(zip);
        if (entries == null) { return 0 - 1; }
        string root = destDir;
        if (!root.EndsWith("/") && !root.EndsWith("\\")) { root = root + "/"; }
        Directory.CreateDirectoryRecursive(root);
        int count = 0;
        for (int i = 0; i < entries.Count; i = i + 1) {
            ZipEntry e = entries[i];
            if (!Tar.SafeName(e.name)) { return 0 - 1; }
            string outPath = root + e.name;
            if (e.isDirectory) {
                Directory.CreateDirectoryRecursive(outPath);
                count = count + 1;
            } else {
                int slash = Tar.LastSlash(outPath);
                if (slash > 0) {
                    Directory.CreateDirectoryRecursive(outPath.Substring(0, slash));
                }
                byte[] content = Zip.Extract(zip, e);
                if (content == null) { return 0 - 1; }
                File.WriteAllBytes(outPath, content);
                count = count + 1;
            }
        }
        return count;
    }

    static int FindLocal(byte[] zip, string name) {
        for (int i = 0; i + 30 <= zip.Length; i = i + 1) {
            if (Zip.ReadU32(zip, i) == Zip.SigLocal) {
                int nameLen = Zip.ReadU16(zip, i + 26);
                // 本地头本身 30 字节 + 名称必须落在归档内，
                // 否则按损坏跳过，继续扫描下一个签名。
                if (i + 30 + nameLen > zip.Length) { continue; }
                if (nameLen == name.Length) {
                    bool same = true;
                    for (int k = 0; k < nameLen; k = k + 1) {
                        if ((byte)name[k] != zip[i + 30 + k]) { same = false; break; }
                    }
                    if (same) { return i; }
                }
            }
        }
        return -1;
    }

    static bool EndsWithSlash(string s) {
        return s.Length > 0 && s[s.Length - 1] == '/';
    }

    static string ReadName(byte[] zip, int off, int len) {
        nint buf = NativeMemory.Alloc(len + 1);
        for (int i = 0; i < len; i = i + 1) {
            new Span<byte>(buf + i, 1)[0] = zip[off + i];
        }
        string s = NativeMemory.GetString(buf, 0, len);
        NativeMemory.Free(buf);
        return s;
    }

    static int ReadU16(byte[] b, int off) {
        return (b[off] & 255) | ((b[off + 1] & 255) << 8);
    }

    static long ReadU32(byte[] b, int off) {
        return (long)(b[off] & 255) | ((long)(b[off + 1] & 255) << 8) |
            ((long)(b[off + 2] & 255) << 16) | ((long)(b[off + 3] & 255) << 24);
    }

    static void WriteU16(byte[] b, ref int off, int v) {
        b[off] = (byte)(v & 255);
        b[off + 1] = (byte)((v >> 8) & 255);
        off = off + 2;
    }

    static void WriteU32(byte[] b, ref int off, long v) {
        b[off] = (byte)(v & 255);
        b[off + 1] = (byte)((v >> 8) & 255);
        b[off + 2] = (byte)((v >> 16) & 255);
        b[off + 3] = (byte)((v >> 24) & 255);
        off = off + 4;
    }
}

/// <summary>
/// 流式 ZIP 写出器：条目边生成边压缩、边落盘，内存占用与条目
/// 大小无关（分块压缩走 <see cref="DeflateChunker"/>）。与
/// <see cref="Zip"/> 互通——这里写出的归档 Zip.Read/Extract/
/// ExtractToDirectory 以及标准解压工具都能读。单条目与整个
/// 归档都 ≤ 4GB（头部是 u32 字段，ZIP64 暂不支持）。用法：
///
///   ZipWriter zw = ZipWriter.Open("out.zip");
///   zw.AddEntry("a.txt", smallBytes, 6);   // 小条目一次写入
///   zw.BeginEntry("big.xml", 6);           // 大条目分块写入
///   zw.WriteData(chunk1, chunk1.Length);
///   zw.WriteData(chunk2, chunk2.Length);
///   zw.EndEntry();                          // 回填 CRC/尺寸
///   zw.Close();
///
/// 中途放弃时调 <see cref="Abort"/> 删掉半成品文件。
/// </summary>
class ZipWriter {
    [DllImport("crt", EntryPoint = "zan_file_fopen")]
    static extern nint fopen(string path, string mode);
    [DllImport("crt")]
    static extern int fclose(nint fp);
    [DllImport("crt")]
    static extern int fseek(nint fp, int offset, int origin);
    [DllImport("crt")]
    static extern int ftell(nint fp);
    [DllImport("crt")]
    static extern long fwrite(string buf, long size, long count, nint fp);
    [DllImport("crt", EntryPoint = "zan_file_remove")]
    static extern int remove(string path);

    nint fp;
    string path;
    // 中央目录累积：每结束一个条目记一笔，Close 时写出。
    List<long> offsets;
    List<string> names;
    List<int> methods;
    List<long> crcs;
    List<long> csizes;
    List<long> usizes;

    // 进行中的分块条目状态（Begin/End 之间有效）。
    string curName;
    int curMethod;
    int curLevel;
    int curCrc;
    long curCsize;
    long curUsize;
    long curHdrPos;
    DeflateChunker curChunker;

    ZipWriter() {
        this.fp = 0;
        this.offsets = new List<long>();
        this.names = new List<string>();
        this.methods = new List<int>();
        this.crcs = new List<long>();
        this.csizes = new List<long>();
        this.usizes = new List<long>();
        this.curChunker = null;
    }

    /// <summary>创建/截断归档文件。打不开时抛 IOException。</summary>
    static ZipWriter Open(string path) {
        nint h = ZipWriter.fopen(path, "w+b");
        if (h == 0) { throw new IOException("Could not open file for writing: " + path); }
        ZipWriter w = new ZipWriter();
        w.fp = h;
        w.path = path;
        return w;
    }

    /// <summary>一次性写入整个条目（内容已在内存）。级别 0 存储，
    /// 1-9 deflate；内容 < 64 字节时自动转为存储。</summary>
    void AddEntry(string name, byte[] data, int level) {
        int crc = Crc32.Compute(data, 0, data.Length, 0);
        int method = Zip.MethodStored;
        byte[] payload = data;
        if (level > 0 && data.Length >= 64) {
            method = Zip.MethodDeflate;
            payload = Deflate.Deflate(data, level);
        }
        long hpos = this.Tell();
        this.WriteHeader(name, method, crc, payload.Length, data.Length);
        this.WriteRaw(payload, payload.Length);
        this.offsets.Add(hpos);
        this.names.Add(name);
        this.methods.Add(method);
        this.crcs.Add(crc);
        this.csizes.Add(payload.Length);
        this.usizes.Add(data.Length);
    }

    /// <summary>开始一个分块条目：写出本地头（CRC/尺寸先占位，
    /// <see cref="EndEntry"/> 时回填）。之后用 <see cref="WriteData"/>
    /// 喂数据。级别 0 表示存储（原样写盘），1-9 分块 deflate。</summary>
    void BeginEntry(string name, int level) {
        this.curName = name;
        this.curMethod = level > 0 ? Zip.MethodDeflate : Zip.MethodStored;
        this.curLevel = level;
        this.curCrc = 0;
        this.curCsize = 0;
        this.curUsize = 0;
        if (level > 0) {
            this.curChunker = new DeflateChunker();
        } else {
            this.curChunker = null;
        }
        this.curHdrPos = this.Tell();
        this.WriteHeader(name, this.curMethod, 0, 0, 0);
    }

    /// <summary>向进行中的分块条目追加一块数据。</summary>
    void WriteData(byte[] chunk, int len) {
        if (len <= 0) { return; }
        this.curCrc = Crc32.Compute(chunk, 0, len, this.curCrc);
        this.curUsize = this.curUsize + len;
        if (this.curMethod == Zip.MethodDeflate) {
            byte[] packed = this.curChunker.Push(chunk, this.curLevel);
            this.WriteRaw(packed, packed.Length);
            this.curCsize = this.curCsize + packed.Length;
        } else {
            this.WriteRaw(chunk, len);
            this.curCsize = this.curCsize + len;
        }
    }

    /// <summary>结束进行中的分块条目：冲出压缩尾块、回填本地头的
    /// CRC/尺寸、登记中央目录。</summary>
    void EndEntry() {
        if (this.curMethod == Zip.MethodDeflate) {
            byte[] tail = this.curChunker.Finish();
            this.WriteRaw(tail, tail.Length);
            this.curCsize = this.curCsize + tail.Length;
            this.curChunker = null;
        }
        // 回填：重写本地头，CRC/尺寸落到固定字段。
        byte[] hdr = new byte[30];
        int off = 0;
        this.BuildHeader(hdr, ref off, this.curName, this.curMethod,
            this.curCrc, this.curCsize, this.curUsize);
        this.Seek((int)this.curHdrPos);
        this.WriteRaw(hdr, 30);
        this.offsets.Add(this.curHdrPos);
        this.names.Add(this.curName);
        this.methods.Add(this.curMethod);
        this.crcs.Add(this.curCrc);
        this.csizes.Add(this.curCsize);
        this.usizes.Add(this.curUsize);
        // 回到文件尾，后续条目继续追加。
        this.SeekEnd();
    }

    /// <summary>写中央目录与 EOCD，关闭文件。之后归档可读。</summary>
    void Close() {
        long cdPos = this.Tell();
        int cdSize = 0;
        for (int i = 0; i < this.names.Count; i = i + 1) {
            byte[] rec = new byte[46 + this.names[i].Length];
            int p = 0;
            string name = this.names[i];
            Zip.WriteU32(rec, ref p, Zip.SigCentral);
            Zip.WriteU16(rec, ref p, 20);               // 制作版本
            Zip.WriteU16(rec, ref p, 20);               // 所需版本
            Zip.WriteU16(rec, ref p, 0);                // 标志
            Zip.WriteU16(rec, ref p, this.methods[i]);
            Zip.WriteU16(rec, ref p, 0);                // 修改时间
            Zip.WriteU16(rec, ref p, 0);                // 修改日期
            Zip.WriteU32(rec, ref p, this.crcs[i]);
            Zip.WriteU32(rec, ref p, this.csizes[i]);
            Zip.WriteU32(rec, ref p, this.usizes[i]);
            Zip.WriteU16(rec, ref p, name.Length);
            Zip.WriteU16(rec, ref p, 0);                // 额外字段
            Zip.WriteU16(rec, ref p, 0);                // 注释
            Zip.WriteU16(rec, ref p, 0);                // 起始磁盘
            Zip.WriteU16(rec, ref p, 0);                // 内部属性
            Zip.WriteU32(rec, ref p, 0);                // 外部属性
            Zip.WriteU32(rec, ref p, this.offsets[i]);
            for (int k = 0; k < name.Length; k = k + 1) {
                rec[p + k] = (byte)name[k];
            }
            this.WriteRaw(rec, rec.Length);
            cdSize = cdSize + rec.Length;
        }
        byte[] eocd = new byte[22];
        int q = 0;
        Zip.WriteU32(eocd, ref q, Zip.SigEnd);
        Zip.WriteU16(eocd, ref q, 0);
        Zip.WriteU16(eocd, ref q, 0);
        Zip.WriteU16(eocd, ref q, this.names.Count);
        Zip.WriteU16(eocd, ref q, this.names.Count);
        Zip.WriteU32(eocd, ref q, cdSize);
        Zip.WriteU32(eocd, ref q, cdPos);
        Zip.WriteU16(eocd, ref q, 0);
        this.WriteRaw(eocd, 22);
        ZipWriter.fclose(this.fp);
        this.fp = 0;
    }

    /// <summary>关闭并删除半成品归档（导出被取消/出错时用）。</summary>
    void Abort() {
        if (this.fp != 0) {
            ZipWriter.fclose(this.fp);
            this.fp = 0;
        }
        ZipWriter.remove(this.path);
    }

    // 30 字节本地文件头（不含名称）。签名+版本+标志+方法+时间
    // 日期+CRC+两尺寸+两长度。
    void WriteHeader(string name, int method, int crc, long csize, long usize) {
        byte[] hdr = new byte[30];
        int off = 0;
        this.BuildHeader(hdr, ref off, name, method, crc, csize, usize);
        this.WriteRaw(hdr, 30);
        byte[] nb = new byte[name.Length];
        for (int k = 0; k < name.Length; k = k + 1) {
            nb[k] = (byte)name[k];
        }
        this.WriteRaw(nb, nb.Length);
    }

    void BuildHeader(byte[] hdr, ref int off, string name, int method, int crc,
                     long csize, long usize) {
        Zip.WriteU32(hdr, ref off, Zip.SigLocal);
        Zip.WriteU16(hdr, ref off, 20);                 // 所需版本
        Zip.WriteU16(hdr, ref off, 0);                  // 标志
        Zip.WriteU16(hdr, ref off, method);
        Zip.WriteU16(hdr, ref off, 0);                  // 修改时间
        Zip.WriteU16(hdr, ref off, 0);                  // 修改日期
        Zip.WriteU32(hdr, ref off, crc);
        Zip.WriteU32(hdr, ref off, csize);
        Zip.WriteU32(hdr, ref off, usize);
        Zip.WriteU16(hdr, ref off, name.Length);
        Zip.WriteU16(hdr, ref off, 0);                  // 额外字段
    }

    long Tell() { return ZipWriter.ftell(this.fp); }

    // 定位参数与 CRT 一致：0=文件头 1=当前位置 2=文件尾。
    void Seek(int pos) { ZipWriter.fseek(this.fp, pos, 0); }
    void SeekEnd() { ZipWriter.fseek(this.fp, 0, 2); }

    void WriteRaw(byte[] data, int len) {
        long put = ZipWriter.fwrite(data, 1, len, this.fp);
        if (put != len) {
            throw new IOException("ZipWriter: short write (" + Convert.ToString(put)
                + "/" + Convert.ToString(len) + ")");
        }
    }
}
