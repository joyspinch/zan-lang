using System;

namespace System.IO;

/// <summary>
/// 内存映射文件与具名共享内存区域。一个映射是一块具名
/// 字节区域（或对已有文件的视图），可映射到进程
/// 地址空间并通过 Span 读写，由操作系统负责
/// 内容的换入换出（file-backed 或共享内核对象），
/// （具名区域——打开同名区域的其他进程可见）。
///
///   // 写入进程：
///   MemoryMappedFile mmf = MemoryMappedFile.CreateNew("MyApp.Shared", 4096);
///   nint view = mmf.Map(4096);
///   new Span<int>(view, 1024)[0] = 42;
///   mmf.Unmap(view, 4096);
///   mmf.Close();
///
///   // 读取进程：
///   MemoryMappedFile mmf2 = MemoryMappedFile.OpenExisting("MyApp.Shared", 4096);
///   nint view2 = mmf2.Map(4096);
///   int value = new Span<int>(view2, 1024)[0];
///
/// 名称按机器区分；Windows 上以“Global\”前缀开头可使区域
/// 对其他会话可见。文件型映射为读写共享（MAP_SHARED），
/// 因此并发读取同一文件的读者能看到写入。
/// </summary>
class MemoryMappedFile {
    [DllImport("crt")]
    static extern long zan_mmap_create(string name, long size);
    [DllImport("crt")]
    static extern long zan_mmap_open(string name, long size);
    [DllImport("crt")]
    static extern long zan_mmap_from_file(string path, long size);
    [DllImport("crt")]
    static extern long zan_mmap_map(long handle, long size);
    [DllImport("crt")]
    static extern long zan_mmap_unmap(long ptr, long size);
    [DllImport("crt")]
    static extern long zan_mmap_flush(long ptr, long size);
    [DllImport("crt")]
    static extern long zan_mmap_close(long handle);

    long handle;
    string name;

    /// <summary>创建一块大小为 `size` 字节的全新具名共享内存区域。
    /// 同名区域已存在时抛出 IOException。
    /// 区域会一直保留，直到所有句柄关闭；
    /// POSIX 上创建者一关闭，名称便不再解析。</summary>
    static MemoryMappedFile CreateNew(string name, long size) {
        long h = MemoryMappedFile.zan_mmap_create(name, size);
        if (h == 0) {
            throw new IOException("Memory-mapped region already exists or could not be created: " + name);
        }
        MemoryMappedFile f = new MemoryMappedFile();
        f.handle = h;
        f.name = name;
        return f;
    }

    /// <summary>打开已存在的具名共享内存区域。
    /// 区域不存在时抛出 FileNotFoundException。</summary>
    static MemoryMappedFile OpenExisting(string name, long size) {
        long h = MemoryMappedFile.zan_mmap_open(name, size);
        if (h == 0) {
            throw new FileNotFoundException("Memory-mapped region not found: " + name);
        }
        MemoryMappedFile f = new MemoryMappedFile();
        f.handle = h;
        f.name = name;
        return f;
    }

    /// <summary>对已有文件创建映射。`size` &lt;= 0 时映射
    /// 整个文件；否则文件会被扩展/截断为 `size`
    /// 字节。映射为读写且共享。</summary>
    static MemoryMappedFile CreateFromFile(string path, long size) {
        long h = MemoryMappedFile.zan_mmap_from_file(path, size);
        if (h == 0) {
            throw new FileNotFoundException("Could not map file: " + path);
        }
        MemoryMappedFile f = new MemoryMappedFile();
        f.handle = h;
        f.name = path;
        return f;
    }

    /// <summary>将 `size` 字节映射进地址空间，返回视图
    /// 地址。用完需按同样大小 Unmap。失败时返回 0。</summary>
    nint Map(long size) {
        return (nint)MemoryMappedFile.zan_mmap_map(this.handle, size);
    }

    /// <summary>取消映射视图。`size` 必须与映射时一致。
    /// 视图无法取消映射时返回 false。</summary>
    bool Unmap(nint view, long size) {
        return MemoryMappedFile.zan_mmap_unmap((long)view, size) == 1;
    }

    /// <summary>将映射视图刷写回磁盘（文件型映射）。</summary>
    bool Flush(nint view, long size) {
        return MemoryMappedFile.zan_mmap_flush((long)view, size) == 1;
    }

    /// <summary>关闭映射句柄。由此映射出的视图必须先
    /// 取消映射。</summary>
    void Close() {
        if (this.handle != 0) {
            MemoryMappedFile.zan_mmap_close(this.handle);
            this.handle = 0;
        }
    }
}
