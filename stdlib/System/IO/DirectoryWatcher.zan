using System;
using System.IO;
using System.Threading;

namespace System.IO;

/// <summary>File system change kinds reported by <see cref="DirectoryWatcher"/>.</summary>
class FileChange {
    static int Added() { return 1; }
    static int Removed() { return 2; }
    static int Modified() { return 3; }
}

/// <summary>Change callback for <see cref="DirectoryWatcher.Watch"/>:
/// entry name plus a <see cref="FileChange"/> kind.</summary>
delegate void FileChangeFn(string name, int change);

class FileSnapshot {
    string name;
    long lastWriteTime;
    long size;

    static FileSnapshot Create(string name, long lastWriteTime, long size) {
        FileSnapshot snapshot = new FileSnapshot();
        snapshot.name = name;
        snapshot.lastWriteTime = lastWriteTime;
        snapshot.size = size;
        return snapshot;
    }
}

/// <summary>
/// Watches a directory and reports file changes (added / removed / modified).
/// A background thread polls the directory listing every ~250 ms and compares
/// it with the previous snapshot by name + last-write time, so it works the
/// same on every platform (no ReadDirectoryChangesW / inotify plumbing) at
/// the cost of up to ~250 ms latency. Subdirectories are not recursed.
///
///   DirectoryWatcher.Watch("C:\\data", OnChange);
///   ...
///   DirectoryWatcher.Stop();
///
/// The callback receives the entry name and a <see cref="FileChange"/> kind,
/// and must be non-capturing.
/// </summary>
class DirectoryWatcher {
    static List<FileSnapshot> lastSnapshot = new List<FileSnapshot>();
    static bool watching = false;

    /// <summary>Starts watching `path`. Returns false when the directory
    /// does not exist or a watcher is already running.</summary>
    static bool Watch(string path, FileChangeFn callback) {
        if (watching) { return false; }
        if (!Directory.Exists(path)) { return false; }
        DirectoryWatcher.dir = path;
        DirectoryWatcher.cb = callback;
        DirectoryWatcher.lastSnapshot = DirectoryWatcher.Snapshot();
        watching = true;
        return Thread.Start(DirectoryWatcher.Poll);
    }

    /// <summary>Stops watching. The current poll finishes; no further events
    /// are delivered.</summary>
    static void Stop() {
        watching = false;
    }

    static void Poll() {
        while (DirectoryWatcher.watching) {
            Thread.Sleep(250);
            List<FileSnapshot> snapshot = DirectoryWatcher.Snapshot();
            DirectoryWatcher.Compare(snapshot);
            DirectoryWatcher.lastSnapshot = snapshot;
        }
    }

    // Builds a sorted name + last-write-time + size snapshot. A file is
    // "modified" when either its size or its (second-resolution) write time
    // changes; a same-size rewrite within the same second is not detectable
    // by polling -- the documented latency/accuracy trade-off.
    static List<FileSnapshot> Snapshot() {
        List<FileSnapshot> snapshot = new List<FileSnapshot>();
        List<string> files = Directory.GetFiles(DirectoryWatcher.dir);
        int i = 0;
        while (i < files.Count) {
            // GetFiles returns bare entry names; join the watched directory
            // so the stat calls read the right file.
            string full = Path.Combine(DirectoryWatcher.dir, files[i]);
            snapshot.Add(FileSnapshot.Create(
                files[i], FileInfo.GetLastWriteTime(full), FileInfo.GetLength(full)));
            i = i + 1;
        }
        // Sort snapshot records by name so comparison is a linear merge.
        int k = 1;
        while (k < snapshot.Count) {
            FileSnapshot key = snapshot[k];
            int j = k - 1;
            while (j >= 0 && snapshot[j].name.CompareTo(key.name) > 0) {
                snapshot[j + 1] = snapshot[j];
                j = j - 1;
            }
            snapshot[j + 1] = key;
            k = k + 1;
        }
        return snapshot;
    }

    // Merge previous vs current snapshots, firing callbacks for deltas.
    static void Compare(List<FileSnapshot> current) {
        int i = 0;   // index into previous
        int j = 0;   // index into current
        while (i < DirectoryWatcher.lastSnapshot.Count || j < current.Count) {
            if (i >= DirectoryWatcher.lastSnapshot.Count) {
                DirectoryWatcher.cb(current[j].name, FileChange.Added());
                j = j + 1;
            } else if (j >= current.Count) {
                DirectoryWatcher.cb(
                    DirectoryWatcher.lastSnapshot[i].name, FileChange.Removed());
                i = i + 1;
            } else {
                FileSnapshot previous = DirectoryWatcher.lastSnapshot[i];
                FileSnapshot next = current[j];
                int cmp = previous.name.CompareTo(next.name);
                if (cmp < 0) {
                    DirectoryWatcher.cb(previous.name, FileChange.Removed());
                    i = i + 1;
                } else if (cmp > 0) {
                    DirectoryWatcher.cb(next.name, FileChange.Added());
                    j = j + 1;
                } else {
                    if (previous.lastWriteTime != next.lastWriteTime
                        || previous.size != next.size) {
                        DirectoryWatcher.cb(next.name, FileChange.Modified());
                    }
                    i = i + 1;
                    j = j + 1;
                }
            }
        }
    }

    static string dir = "";
    static FileChangeFn cb;
}

