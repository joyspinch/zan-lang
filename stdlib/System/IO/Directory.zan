using System;
using System.Platform;
using System.Text;

namespace System.IO;

public class Directory {
    public static void FlushToDisk(string path) {
        Pal.FileSystem.FlushDirectoryToDisk(path);
    }

    // 相对路径在工作目录不存在时依次回退 ZAN_PKG_DIR 与可执行目录，保证发布后仍可枚举随附资源。
    [DllImport("crt")]
    static extern string zan_file_read_path(string path);

    public static string ReadPath(string path) {
        if (path.Length == 0) { return path; }
        string r = zan_file_read_path(path);
        if (r == null || r.Length == 0) { return path; }
        return r;
    }

    public static List<string> EmbedChildren(string path, bool dirs) {
        List<string> outp = new List<string>();
        string pre = File.EmbedName(path);
        if (pre.Length > 0 && (pre[pre.Length - 1] & 255) != 47) {
            pre = pre + "/";
        }
        string raw = File.zan_embed_list(pre);
        if (raw == null || raw.Length == 0) { return outp; }
        int start = 0;
        int rawLen = raw.Length;
        for (int i = 0; i <= rawLen; i = i + 1) {
            if (i != rawLen && (raw[i] & 255) != 10) { continue; }
            string name = raw.Substring(start, i - start);
            start = i + 1;
            if (name.Length <= pre.Length) { continue; }
            string rest = name.Substring(pre.Length, name.Length - pre.Length);
            int slash = rest.IndexOf("/");
            string item = slash >= 0 ? rest.Substring(0, slash) : rest;
            if (dirs != (slash >= 0)) { continue; }
            bool seen = false;
            for (int k = 0; k < outp.Count; k = k + 1) {
                if (outp[k] == item) { seen = true; break; }
            }
            if (!seen) { outp.Add(item); }
        }
        return outp;
    }

    public static bool EmbedExists(string path) {
        if (Directory.EmbedChildren(path, false).Count > 0) { return true; }
        return Directory.EmbedChildren(path, true).Count > 0;
    }

    public static List<string> MergeEmbed(List<string> disk, string path, bool dirs) {
        List<string> emb = Directory.EmbedChildren(path, dirs);
        for (int i = 0; i < emb.Count; i = i + 1) {
            bool seen = false;
            for (int k = 0; k < disk.Count; k = k + 1) {
                if (disk[k] == emb[i]) { seen = true; break; }
            }
            if (!seen) { disk.Add(emb[i]); }
        }
        return disk;
    }

    public static bool ExistsUtf8(string path) { return Pal.FileSystem.DirectoryExists(path); }
    public static bool FileExistsUtf8(string path) { return Pal.FileSystem.FileExists(path); }
    public static void CreateDirectoryUtf8(string path) { Pal.FileSystem.CreateDirectory(path); }
    public static List<string> GetRootsUtf8() { return Pal.FileSystem.GetLogicalDrives(); }

    public static bool Exists(string path) {
        if (Directory.ExistsOnDisk(path)) { return true; }
        string p = Directory.ReadPath(path);
        if (p != path && Directory.ExistsOnDisk(p)) { return true; }
        return Directory.EmbedExists(path);
    }

    public static bool ExistsOnDisk(string path) {
        return Pal.FileSystem.DirectoryExists(path);
    }

    public static void CreateDirectory(string path) { Directory.CreateDirectoryRecursive(path); }
    static void CreateDirSingle(string path) { Pal.FileSystem.CreateDirectory(path); }
    public static void Delete(string path) { Pal.FileSystem.DeleteDirectory(path); }
    public static string GetCurrentDirectory() { return Pal.FileSystem.GetCurrentDirectory(); }
    public static void SetCurrentDirectory(string path) { Pal.FileSystem.SetCurrentDirectory(path); }
    public static bool IsSymlink(string path) { return Pal.FileSystem.IsSymlink(path); }

    static List<string> listSingle(string path, bool wantDirs, bool includeHidden) {
        List<PlatformFileEntry> entries = Pal.FileSystem.EnumerateEntries(path, wantDirs, includeHidden);
        List<string> result = new List<string>();
        for (int i = 0; i < entries.Count; i = i + 1) {
            result.Add(entries[i].name);
        }
        return result;
    }

    public static List<string> ToPaths(List<string> names, string baseDir) {
        List<string> outp = new List<string>();
        for (int i = 0; i < names.Count; i = i + 1) {
            outp.Add(baseDir + "/" + names[i]);
        }
        return outp;
    }

    static List<string> GetEntryPaths(string path, bool wantDirs) {
        string p = Directory.ReadPath(path);
        List<string> r = listSingle(p, wantDirs, true);
        int diskCount = r.Count;
        List<string> all = Directory.MergeEmbed(r, path, wantDirs);
        string baseDir = (p != null && p.Length > 0) ? p : path;
        List<string> outp = new List<string>();
        for (int i = 0; i < all.Count; i = i + 1) {
            if (i >= diskCount) { baseDir = path; }
            outp.Add(baseDir + "/" + all[i]);
        }
        return outp;
    }

    static List<string> FilterByPattern(List<string> paths, string searchPattern) {
        if (searchPattern == null || searchPattern.Length == 0) { return paths; }
        List<string> outp = new List<string>();
        for (int i = 0; i < paths.Count; i = i + 1) {
            string p = paths[i];
            int at = Directory.AfterLastSeparator(p);
            string name = p.Substring(at, p.Length - at);
            if (Directory.NameMatch(searchPattern, 0, name, 0)) {
                outp.Add(p);
            }
        }
        return outp;
    }

    static List<string> ListEntryNames(string path, bool wantDirs, bool includeHidden) {
        string p = Directory.ReadPath(path);
        List<string> r = listSingle(p, wantDirs, includeHidden);
        return Directory.MergeEmbed(r, path, wantDirs);
    }

    public static List<string> GetPaths(string path) { return Directory.GetEntryPaths(path, false); }
    public static List<string> GetDirectoryPaths(string path) { return Directory.GetEntryPaths(path, true); }
    public static List<string> GetFiles(string path) { return Directory.GetEntryPaths(path, false); }

    public static List<string> GetFiles(string path, string searchPattern) {
        return Directory.FilterByPattern(Directory.GetEntryPaths(path, false), searchPattern);
    }

    public static List<string> GetFiles(string path, string searchPattern, bool recursive) {
        if (!recursive) { return Directory.GetFiles(path, searchPattern); }
        List<string> result = new List<string>();
        Directory.CollectFilesRecursive(result, path, searchPattern);
        return result;
    }

    private static void CollectFilesRecursive(List<string> outp, string path, string searchPattern) {
        List<string> directFiles = Directory.GetFiles(path, searchPattern);
        for (int i = 0; i < directFiles.Count; i = i + 1) {
            outp.Add(directFiles[i]);
        }
        List<string> subDirs = Directory.GetDirectoryPaths(path);
        for (int j = 0; j < subDirs.Count; j = j + 1) {
            Directory.CollectFilesRecursive(outp, subDirs[j], searchPattern);
        }
    }

    public static List<string> GetDirectories(string path, string searchPattern, bool recursive) {
        if (!recursive) {
            return Directory.FilterByPattern(Directory.GetEntryPaths(path, true), searchPattern);
        }
        List<string> result = new List<string>();
        Directory.CollectDirectoriesRecursive(result, path, searchPattern);
        return result;
    }

    private static void CollectDirectoriesRecursive(List<string> outp, string path, string searchPattern) {
        List<string> subDirs = Directory.GetDirectoryPaths(path);
        for (int j = 0; j < subDirs.Count; j = j + 1) {
            string d = subDirs[j];
            int at = Directory.AfterLastSeparator(d);
            string name = d.Substring(at, d.Length - at);
            bool match = searchPattern == null || searchPattern.Length == 0 || Directory.NameMatch(searchPattern, 0, name, 0);
            if (match) { outp.Add(d); }
            Directory.CollectDirectoriesRecursive(outp, d, searchPattern);
        }
    }

    private static int AfterLastSeparator(string p) {
        for (int i = p.Length - 1; i >= 0; i = i - 1) {
            int c = p[i] & 255;
            if (c == 47 || c == 92) { return i + 1; }
        }
        return 0;
    }

    private static bool NameMatch(string pat, int pi, string name, int ni) {
        if (pi >= pat.Length) { return ni >= name.Length; }
        int pc = pat[pi] & 255;
        if (pc == 42) {
            while (pi < pat.Length && (pat[pi] & 255) == 42) { pi = pi + 1; }
            for (int k = 0; ni + k <= name.Length; k = k + 1) {
                if (Directory.NameMatch(pat, pi, name, ni + k)) { return true; }
            }
            return false;
        }
        if (ni >= name.Length) { return false; }
        if (pc == 63) { return Directory.NameMatch(pat, pi + 1, name, ni + 1); }
        if (!Directory.NameCharEq(pc, name[ni] & 255)) { return false; }
        return Directory.NameMatch(pat, pi + 1, name, ni + 1);
    }

    private static bool NameCharEq(int a, int b) {
        if (a == b) { return true; }
        if (!Pal.FileSystem.IsCaseSensitive()) {
            if (a >= 65 && a <= 90) { a = a + 32; }
            if (b >= 65 && b <= 90) { b = b + 32; }
            return a == b;
        }
        return false;
    }

    // 返回裸文件名/裸目录名（与 GetFiles/GetDirectoryPaths 的全路径口径区分）。
    public static List<string> GetFileNames(string path) { return Directory.ListEntryNames(path, false, true); }
    public static List<string> GetDirectories(string path) { return Directory.ListEntryNames(path, true, true); }
    static List<string> GetFilesFiltered(string path, bool includeHidden) { return Directory.ListEntryNames(path, false, includeHidden); }
    static List<string> GetDirectoriesFiltered(string path, bool includeHidden) { return Directory.ListEntryNames(path, true, includeHidden); }

    public static void CreateDirectoryRecursive(string path) {
        if (path == null || path.Length == 0) { return; }
        int len = path.Length;
        for (int i = 0; i < len; i = i + 1) {
            int c = path[i] & 255;
            if (c == 47 || c == 92) {
                string part = path.Substring(0, i + 1);
                if (!ExistsOnDisk(part)) { CreateDirSingle(part); }
            }
        }
        if (!ExistsOnDisk(path)) { CreateDirSingle(path); }
    }

    public static bool DeleteRecursive(string path) {
        // 顶层为符号链接/junction 时只删链接本身，绝不递归穿透。
        if (Pal.FileSystem.IsSymlink(path)) {
            File.Delete(path);
            return !File.Exists(path);
        }
        if (!ExistsOnDisk(path)) { return true; }
        string dir = path;
        if (dir.EndsWith("/") || dir.EndsWith("\\")) {
            dir = dir.Substring(0, dir.Length - 1);
        }
        bool ok = true;
        List<string> files = Directory.GetFileNames(dir);
        for (int i = 0; i < files.Count; i = i + 1) {
            string f = dir + "/" + files[i];
            File.Delete(f);
            if (File.Exists(f)) { ok = false; }
        }
        List<string> subs = Directory.GetDirectories(dir);
        for (int i = 0; i < subs.Count; i = i + 1) {
            if (!Directory.DeleteRecursive(dir + "/" + subs[i])) { ok = false; }
        }
        Directory.Delete(dir);
        if (ExistsOnDisk(dir)) { ok = false; }
        return ok;
    }

    public static async List<string> GetPathsAsync(string path) { await Task.Yield(); return Directory.GetPaths(path); }
    public static async List<string> GetDirectoryPathsAsync(string path) { await Task.Yield(); return Directory.GetDirectoryPaths(path); }
    public static async List<string> GetFilesAsync(string path) { await Task.Yield(); return Directory.GetFiles(path); }
    public static async List<string> GetFilesAsync(string path, string searchPattern) { await Task.Yield(); return Directory.GetFiles(path, searchPattern); }
    public static async List<string> GetDirectoriesAsync(string path) { await Task.Yield(); return Directory.GetDirectories(path); }
    public static async bool ExistsAsync(string path) { await Task.Yield(); return Directory.Exists(path); }
    public static async void CreateDirectoryAsync(string path) { await Task.Yield(); Directory.CreateDirectory(path); }
    public static async void DeleteAsync(string path) { await Task.Yield(); Directory.Delete(path); }
    public static async bool DeleteRecursiveAsync(string path) { await Task.Yield(); return Directory.DeleteRecursive(path); }
}
