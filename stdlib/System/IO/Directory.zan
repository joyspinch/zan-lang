using System;
using System.Text;

namespace System.IO;

// 目录操作。Windows 上使用 Win32 API，Linux 与 macOS 上使用 POSIX
// opendir/readdir/mkdir。readdir 读取的 struct dirent 字段偏移
// 在 glibc 与 Darwin 之间不同，因此按目标平台选择
// （见 direntTypeOffset/direntNameOffset）。
class Directory {
    // 只读资源的落地位置：相对路径在当前工作目录下不存在时，运行时会
    // 依次回退到单文件包的解包目录（ZAN_PKG_DIR）与可执行文件所在目录，
    // 返回第一个真实存在的路径，都不存在（或本来就存在）时返回 ""。
    // File 的读取走同一套回退，这里让目录枚举也走，发布后的程序才能
    // 找到自己的 views/、wwwroot/，而不受启动时的工作目录影响。
    [DllImport("crt")]
    static extern string zan_file_read_path(string path);

    // 把只读枚举用的相对路径解析到程序随附的那一份。
    static string ReadPath(string path) {
        if (path.Length == 0) { return path; }
        string r = zan_file_read_path(path);
        if (r == null || r.Length == 0) { return path; }
        return r;
    }

    // 内嵌进可执行文件的资源名清单（按 '\n' 分隔，见 File 的内嵌读取）。
    [DllImport("crt")]
    static extern string zan_embed_list(string prefix);

    // 内嵌资源里 `path` 下的直接子项：dirs 为真取子目录名，
    // 否则取文件名。磁盘上的同名目录仍然优先，这里只补上磁盘里没有的
    // 那部分，发布成单个可执行文件后 views/ 之类照样能枚举。
    static List<string> EmbedChildren(string path, bool dirs) {
        List<string> outp = new List<string>();
        string pre = File.EmbedName(path);
        if (pre.Length > 0 && (pre[pre.Length - 1] & 255) != 47) {  // '/'
            pre = pre + "/";
        }
        string raw = zan_embed_list(pre);
        if (raw == null || raw.Length == 0) { return outp; }
        int start = 0;
        int rawLen = raw.Length;
        for (int i = 0; i <= rawLen; i = i + 1) {
            if (i != rawLen && (raw[i] & 255) != 10) { continue; }  // '\n'
            string name = raw.Substring(start, i - start);
            start = i + 1;
            if (name.Length <= pre.Length) { continue; }
            string rest = name.Substring(pre.Length, name.Length - pre.Length);
            int slash = rest.IndexOf("/");
            string item = rest;
            if (slash >= 0) { item = rest.Substring(0, slash); }
            if (dirs != (slash >= 0)) { continue; }
            bool seen = false;
            for (int k = 0; k < outp.Count; k = k + 1) {
                if (outp[k] == item) { seen = true; break; }
            }
            if (!seen) { outp.Add(item); }
        }
        return outp;
    }

    // 内嵌资源里是否有这个目录（即有资源以它为前缀）。
    static bool EmbedExists(string path) {
        if (Directory.EmbedChildren(path, false).Count > 0) { return true; }
        return Directory.EmbedChildren(path, true).Count > 0;
    }

    // 把内嵌资源里的子项并进磁盘枚举结果（磁盘优先，不重复）。
    static List<string> MergeEmbed(List<string> disk, string path, bool dirs) {
        List<string> emb = Directory.EmbedChildren(path, dirs);
        for (int i = 0; i < emb.Count; i = i + 1) {
            bool seen = false;
            for (int k = 0; k < disk.Count; k = k + 1) {
                if (disk[k] == emb[i]) { seen = true; break; }
            }
            if (!seen) { disk.Add(emb[i]); }
        }
        return disk;
    }

    #if WINDOWS
    [DllImport("kernel32", EntryPoint = "GetFileAttributesW")]
    static extern int WinGetFileAttributes(nint path);

    [DllImport("kernel32", EntryPoint = "CreateDirectoryW")]
    static extern int WinCreateDirectory(nint path, nint secAttrs);

    [DllImport("kernel32", EntryPoint = "RemoveDirectoryW")]
    static extern int WinRemoveDirectory(nint path);

    [DllImport("kernel32", EntryPoint = "GetCurrentDirectoryW")]
    static extern int WinGetCurrentDirectory(int bufLen, nint buf);

    [DllImport("kernel32", EntryPoint = "SetCurrentDirectoryW")]
    static extern int WinSetCurrentDirectory(nint path);

    [DllImport("kernel32", EntryPoint = "FindFirstFileW")]
    static extern nint WinFindFirstFile(nint pattern, nint findData);

    [DllImport("kernel32", EntryPoint = "FindNextFileW")]
    static extern int WinFindNextFile(nint handle, nint findData);

    [DllImport("kernel32", EntryPoint = "FindClose")]
    static extern int WinFindClose(nint handle);
    [DllImport("kernel32", EntryPoint = "GetLogicalDrives")]
    static extern int WinGetLogicalDrives();

    [DllImport("kernel32", EntryPoint = "MultiByteToWideChar")]
    static extern int WinToWide(int codePage, int flags, nint source,
                                int sourceLength, nint output, int outputLength);

    [DllImport("kernel32", EntryPoint = "WideCharToMultiByte")]
    static extern int WinToUtf8(int codePage, int flags, nint source,
                                int sourceLength, nint output, int outputLength,
                                nint defaultChar, nint usedDefault);

    #else
    // POSIX 目录与文件系统原语（libc）。
    [DllImport("crt", EntryPoint = "opendir")]
    static extern nint opendir(string name);

    // readdir 返回 struct dirent* 指针：
    // dirent 结构体首字节并非字符串长度，d_name 字段位于结构体后部偏移处。
    [DllImport("crt", EntryPoint = "readdir")]
    static extern nint readdir(nint dirp);

    // readlink 成功返回写入的字节数（ssize_t），失败返回 -1：
    // 不引入 struct stat 布局依赖即可准确判定符号链接。
    [DllImport("crt", EntryPoint = "readlink")]
    static extern long ReadLink(string path, byte[] buf, int size);

    [DllImport("crt", EntryPoint = "closedir")]
    static extern int closedir(nint dirp);

    [DllImport("crt", EntryPoint = "mkdir")]
    static extern int mkdir(string path, int mode);

    [DllImport("crt", EntryPoint = "rmdir")]
    static extern int rmdir(string path);

    [DllImport("crt", EntryPoint = "chdir")]
    static extern int chdir(string path);

    [DllImport("crt", EntryPoint = "getcwd")]
    static extern string getcwd(string buf, int size);
    #endif

    #if WINDOWS
    // UTF-8 字符串转 UTF-16 缓冲区（供 W 系列 API）；text 为 null 时返回 0。
    static nint winWide(string text) {
        if (text == null) { return 0; }
        return Wide.Of(text);
    }

    // 读取以 NUL 结尾的 UTF-16 缓冲区为 UTF-8 字符串；wide 为 0 时返回 ""。
    static string winUtf8(nint wide) {
        if (wide == 0) { return ""; }
        return Wide.Read(wide);
    }

    // 按 UTF-8 路径取 Win32 文件属性；路径转换失败时返回 -1
    // （属性本身失败时是 GetFileAttributesW 的 0xFFFFFFFF）。
    static int winAttributesUtf8(string path) {
        nint wide = winWide(path);
        if (wide == 0) { return -1; }
        int attrs = WinGetFileAttributes(wide);
        NativeMemory.Free(wide);
        return attrs;
    }
    #endif

    // 检查 UTF-8 路径是否存在（不使用 ANSI Windows API）。
    static bool ExistsUtf8(string path) {
        #if WINDOWS
        int attrs = winAttributesUtf8(path);
        if (attrs == -1 || attrs == 4294967295) { return false; }
        return (attrs & 16) != 0;
        #else
        return Exists(path);
        #endif
    }

    // 检查 UTF-8 路径是否指向普通文件。
    static bool FileExistsUtf8(string path) {
        #if WINDOWS
        int attrs = winAttributesUtf8(path);
        if (attrs == -1 || attrs == 4294967295) { return false; }
        return (attrs & 16) == 0;
        #else
        return File.Exists(path);
        #endif
    }

    // 创建路径以 UTF-8 编码的目录。
    static void CreateDirectoryUtf8(string path) {
        #if WINDOWS
        nint wide = winWide(path);
        if (wide != 0) {
            WinCreateDirectory(wide, 0);
            NativeMemory.Free(wide);
        }
        #else
        CreateDirectory(path);
        #endif
    }

    // 文件系统根列表：Windows 为每个存在的盘符（"C:/" 形式），POSIX 为 "/"。
    static List<string> GetRootsUtf8() {
        List<string> roots = new List<string>();
        #if WINDOWS
        int mask = WinGetLogicalDrives();
        string letters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
        for (int i = 0; i < 26; i = i + 1) {
            if ((mask & 1) != 0) {
                roots.Add(letters.Substring(i, 1) + ":/");
            }
            mask = mask / 2;
        }
        #else
        roots.Add("/");
        #endif
        return roots;
    }

    // 检查目录是否存在。工作目录下找不到时，与 GetFiles/
    // GetDirectories 一样回退到程序随附的那一份（单文件包的解包目录、
    // 可执行文件所在目录），否则发布后的程序会在枚举之前就判定
    // views/、wwwroot/ 不存在。
    static bool Exists(string path) {
        if (Directory.ExistsOnDisk(path)) { return true; }
        string p = Directory.ReadPath(path);
        if (p != path && Directory.ExistsOnDisk(p)) { return true; }
        return Directory.EmbedExists(path);
    }

    // 目录是否真实存在于磁盘（不走随附资源与内嵌副本回退）。
    static bool ExistsOnDisk(string path) {
        #if WINDOWS
        int attrs = winAttributesUtf8(path);
        // GetFileAttributesW 失败时返回 32 位 DWORD 常量 INVALID_FILE_ATTRIBUTES
        // （0xFFFFFFFF）。扩展到 64 位 int 后读作
        // 4294967295 而非 -1，因此两种形式都要判断。
        if (attrs == -1 || attrs == 4294967295) { return false; }
        return (attrs & 16) != 0;
        #else
        nint d = opendir(path);
        if (d == 0) { return false; }
        closedir(d);
        return true;
        #endif
    }

    // 在指定路径创建目录。
    static void CreateDirectory(string path) {
        #if WINDOWS
        nint wide = winWide(path);
        if (wide != 0) {
            WinCreateDirectory(wide, 0);
            NativeMemory.Free(wide);
        }
        #else
        mkdir(path, 511);  // 0o777（受 umask 影响）
        #endif
    }

    // 删除空目录。
    static void Delete(string path) {
        #if WINDOWS
        nint wide = winWide(path);
        if (wide != 0) {
            WinRemoveDirectory(wide);
            NativeMemory.Free(wide);
        }
        #else
        rmdir(path);
        #endif
    }

    // 获取当前工作目录。
    static string GetCurrentDirectory() {
        #if WINDOWS
        nint wide = NativeMemory.Alloc(8192);
        string buf = "";
        try {
            WinGetCurrentDirectory(4096, wide);
            buf = winUtf8(wide);
        } finally {
            NativeMemory.Free(wide);
        }
        #else
        byte[] b = new byte[4096];
        getcwd(b, 4096);
        int n = 0;
        for (; n < 4096 && (b[n] & 255) != 0; n = n + 1) { }
        string buf = b.ToStr(0, n);
        #endif
        return buf;
    }

    // 设置当前工作目录。
    static void SetCurrentDirectory(string path) {
        #if WINDOWS
        nint wide = winWide(path);
        if (wide != 0) {
            WinSetCurrentDirectory(wide);
            NativeMemory.Free(wide);
        }
        #else
        chdir(path);
        #endif
    }

    #if WINDOWS
    // 从 WIN32_FIND_DATAW 缓冲区读取 cFileName（UTF-16，位于字节偏移 +44）。
    static string winName(nint findData) {
        return winUtf8(findData + 44);
    }

    // FindFirstFile/FindNextFile 枚举一层：wantDirs 决定收文件还是目录，
    // includeHidden=false 时跳过隐藏属性项。返回条目名（不含路径）。
    static List<string> winList(
        string path,
        bool wantDirs,
        bool includeHidden
    ) {
        List<string> result = new List<string>();
        string pattern = path + "\\*";
        nint widePattern = winWide(pattern);
        nint findData = NativeMemory.Alloc(592);
        try {
            nint handle = -1;
            if (widePattern != 0) {
                handle = WinFindFirstFile(widePattern, findData);
                NativeMemory.Free(widePattern);
                widePattern = 0;
            }
            if (handle != -1) {
                try {
                    bool more = true;
                    while (more) {
                        string fname = winName(findData);
                        Span<byte> attr = new Span<byte>(findData, 4);
                        int attrs = attr[0] + attr[1] * 256 + attr[2] * 65536 + attr[3] * 16777216;
                        // reparse point（junction/符号链接）：按文件收，删除方
                        // 删链接本身，绝不递归进指向的树（与 POSIX 的
                        // readlink 判定同语义）。
                        bool isDir = (attrs & 1024) == 0 && (attrs & 16) != 0;
                        bool hidden = (attrs & 2) != 0;
                        if (fname != "." && fname != ".."
                            && isDir == wantDirs
                            && (includeHidden || !hidden)) {
                            result.Add(fname);
                        }
                        if (WinFindNextFile(handle, findData) == 0) { more = false; }
                    }
                } finally {
                    WinFindClose(handle);
                }
            }
        } finally {
            if (widePattern != 0) { NativeMemory.Free(widePattern); }
            NativeMemory.Free(findData);
        }
        return result;
    }
    #else
    // struct dirent 布局因平台而异：
    // 核心契约与语义定义。
    // d_type@20 d_name@21
    // WASI (wasi-libc): d_ino(8) d_type@8 d_name@9 —— wasi-libc 把 fd_readdir
    // 的原始条目（d_next/d_ino/d_namlen/d_type/name）转换成
    // 自己的紧凑 dirent：d_type 直接沿用 WASI filetype 值
    // （3=目录、4=普通文件），不是 POSIX 的 DT_*。
    #if WASI
    // struct dirent 的 d_type 字节偏移（wasi-libc 布局）。
    static int direntTypeOffset() { return 8; }
    // struct dirent 的 d_name 字节偏移（wasi-libc 布局）。
    static int direntNameOffset() { return 9; }
    // wasi-libc 的 d_type 字节沿用 WASI filetype：DT_DIR 判据改为 3。
    static int direntDirType() { return 3; }
    #elif MACOS
    // struct dirent 的 d_type 字节偏移（Darwin 布局）。
    static int direntTypeOffset() { return 20; }
    // struct dirent 的 d_name 字节偏移（Darwin 布局）。
    static int direntNameOffset() { return 21; }
    // POSIX DT_DIR。
    static int direntDirType() { return 4; }
    #else
    // struct dirent 的 d_type 字节偏移（glibc/Linux 布局）。
    static int direntTypeOffset() { return 18; }
    // struct dirent 的 d_name 字节偏移（glibc/Linux 布局）。
    static int direntNameOffset() { return 19; }
    // POSIX DT_DIR。
    static int direntDirType() { return 4; }
    #endif

    // 从 struct dirent* 读取以 NUL 结尾的 d_name：dirent 是 extern
    // 裸内存，按平台偏移手工取字节（上限 255，遇 0 止），再经
    // Encoding.GetString 校验拷出。ent == 0（枚举结束）返回 ""。
    static string posixName(nint ent) {
        if (ent == 0) { return ""; }
        int nameOff = direntNameOffset();
        // POSIX/WASI 的 d_name 都声明为 char[256]（Darwin 更大），
        // nameOff + 256 不会越过条目边界。
        Span<byte> sp = new Span<byte>(ent, nameOff + 256);
        int n = 0;
        while (n < 255 && (sp[nameOff + n] & 255) != 0) { n = n + 1; }
        byte[] buf = new byte[n];
        for (int i = 0; i < n; i = i + 1) { buf[i] = sp[nameOff + i]; }
        return Encoding.GetString(buf, 0, n);
    }

    // 路径本身是符号链接时返回 true（readlink 成功即链接）。WASI 的
    // 预开沙箱里链接本就指不出树外，无需这层防护；wasm32 的 ssize_t
    // 是 32 位，也不适合按 long 读返回值。
    static bool IsSymlink(string path) {
        #if WASI
        return false;
        #else
        byte[] buf = new byte[8];
        return ReadLink(path, buf, 8) >= 0;
        #endif
    }

    // opendir/readdir 枚举一层：wantDirs 决定收文件还是目录，
    // includeHidden=false 时跳过 "." 开头的条目。符号链接一律按
    // 文件收（删除方 unlink 链接本身，不递归进目标）；
    // 只有 d_type 未知（DT_UNKNOWN）时才探测真身。返回条目名
    // （不含路径）。
    static List<string> posixList(
        string path,
        bool wantDirs,
        bool includeHidden
    ) {
        List<string> result = new List<string>();
        nint d = opendir(path);
        if (d == 0) { return result; }
        nint ent = readdir(d);
        while (ent != 0) {
            string name = posixName(ent);
            if (name != "" && name != "." && name != "..") {
                bool hidden = (name[0] & 255) == 46;  // '.'
                Span<byte> entBytes = new Span<byte>(ent, direntTypeOffset() + 1);
                int dtype = entBytes[direntTypeOffset()] & 255;  // d_type
                bool isDir = false;
                if (dtype == direntDirType()) {  // DT_DIR（WASI 下是 filetype 3）
                    isDir = true;
                } else if (dtype == 10 || dtype == 7) {
                    // 核心契约与语义定义。
                    // 链接按文件收——DeleteRecursive 会 unlink 链接本身，
                    // 绝不递归进指向的树（防止指向树外目录的链接被误删目标）。
                    isDir = false;
                } else if (dtype == 0) {
                    // DT_UNKNOWN（文件系统不填 d_type）：先 readlink 判
                    // 链接（同上按文件收），非链接才 opendir 探真身——
                    // 普通目录必须能被 GetDirectories 枚举到。
                    string full = path + "/" + name;
                    if (Directory.IsSymlink(full)) {
                        isDir = false;
                    } else {
                        nint sub = opendir(full);
                        if (sub != 0) { isDir = true; closedir(sub); }
                    }
                }
                if (isDir == wantDirs
                    && (includeHidden || !hidden)) {
                    result.Add(name);
                }
            }
            ent = readdir(d);
        }
        closedir(d);
        return result;
    }
    #endif

    // 把枚举出的裸名字拼成完整路径（与 C# GetFiles 的返回
    // 形态一致）。拼接基准用磁盘枚举时 ReadPath 解析到的目录：随附
    // 资源回退后路径才真实存在。
    static List<string> ToPaths(List<string> names, string baseDir) {
        List<string> outp = new List<string>();
        for (int i = 0; i < names.Count; i = i + 1) {
            outp.Add(baseDir + "/" + names[i]);
        }
        return outp;
    }

    // 列出目录中的文件（不递归、含隐藏），返回完整路径——
    // 与 C# Directory.GetFiles 的语义对齐（审计 ：本库 GetFiles
    // 返回裸文件名，是 C# 移植陷阱，但几十处既有调用都依赖裸名，
    // 不能直接改签名）。找不到磁盘目录时回退到随附资源并合并内嵌
    // 子项（内嵌项只有原始 path 可拼，基准取原始 path）。
    static List<string> GetPaths(string path) {
        string p = Directory.ReadPath(path);
        #if WINDOWS
        List<string> r = winList(p, false, true);
        #else
        List<string> r = posixList(p, false, true);
        #endif
        int diskCount = r.Count;
        List<string> all = Directory.MergeEmbed(r, path, false);
        // 磁盘项拼到解析后的真实目录，内嵌项拼到原始 path。
        string baseDir = (p != null && p.Length > 0) ? p : path;
        List<string> outp = new List<string>();
        for (int i = 0; i < all.Count; i = i + 1) {
            string name = all[i];
            if (i >= diskCount) { baseDir = path; }
            outp.Add(baseDir + "/" + name);
        }
        return outp;
    }

    // 列出目录中的子目录（不递归、含隐藏），返回完整路径。
    // 语义同 <see cref="GetPaths"/>：磁盘项拼 ReadPath 解析目录，
    // 内嵌项拼原始 path。
    static List<string> GetDirectoryPaths(string path) {
        string p = Directory.ReadPath(path);
        #if WINDOWS
        List<string> r = winList(p, true, true);
        #else
        List<string> r = posixList(p, true, true);
        #endif
        int diskCount = r.Count;
        List<string> all = Directory.MergeEmbed(r, path, true);
        string baseDir = (p != null && p.Length > 0) ? p : path;
        List<string> outp = new List<string>();
        for (int i = 0; i < all.Count; i = i + 1) {
            string name = all[i];
            if (i >= diskCount) { baseDir = path; }
            outp.Add(baseDir + "/" + name);
        }
        return outp;
    }

    // 列出目录中的文件（不递归、含隐藏）。找不到磁盘目录时
    // 回退到随附资源并合并内嵌子项。注意：返回裸文件名（不含路径），
    // C# 形态的完整路径用 <see cref="GetPaths"/>。
    static List<string> GetFiles(string path) {
        string p = Directory.ReadPath(path);
        #if WINDOWS
        List<string> r = winList(p, false, true);
        #else
        List<string> r = posixList(p, false, true);
        #endif
        return Directory.MergeEmbed(r, path, false);
    }

    // 列出目录中的子目录（不递归、含隐藏）。回退与合并
    // 语义同 <see cref="GetFiles"/>。注意：返回裸目录名（不含路径），
    // C# 形态的完整路径用 <see cref="GetDirectoryPaths"/>。
    static List<string> GetDirectories(string path) {
        string p = Directory.ReadPath(path);
        #if WINDOWS
        List<string> r = winList(p, true, true);
        #else
        List<string> r = posixList(p, true, true);
        #endif
        return Directory.MergeEmbed(r, path, true);
    }

    // GetFiles 的可控版本：includeHidden=false 时
    // （Windows 属性位 / POSIX 点前缀）跳过隐藏项。
    static List<string> GetFilesFiltered(
        string path,
        bool includeHidden
    ) {
        string p = Directory.ReadPath(path);
        #if WINDOWS
        List<string> r = winList(p, false, includeHidden);
        #else
        List<string> r = posixList(p, false, includeHidden);
        #endif
        return Directory.MergeEmbed(r, path, false);
    }

    // GetDirectories 的可控版本：includeHidden=false 时
    // （Windows 属性位 / POSIX 点前缀）跳过隐藏项。
    static List<string> GetDirectoriesFiltered(
        string path,
        bool includeHidden
    ) {
        string p = Directory.ReadPath(path);
        #if WINDOWS
        List<string> r = winList(p, true, includeHidden);
        #else
        List<string> r = posixList(p, true, includeHidden);
        #endif
        return Directory.MergeEmbed(r, path, true);
    }

    // 递归创建路径中的所有目录。
    static void CreateDirectoryRecursive(string path) {
        if (path == null || path.Length == 0) { return; }
        int len = path.Length;
        for (int i = 0; i < len; i = i + 1) {
            int c = path[i] & 255;
            if (c == 47 || c == 92) {  // '/' or '\\'
                string part = path.Substring(0, i + 1);
                // 创建走原始路径：随附资源里有同名目录不代表工作目录下
                // 也有，写入永远落在工作目录（见 rt_file.c 的说明）。
                if (!ExistsOnDisk(part)) {
                    CreateDirectory(part);
                }
            }
        }
        if (!ExistsOnDisk(path)) {
            CreateDirectory(path);
        }
    }

    // 递归删除目录及其全部内容。目录本来就不存在时返回 true；
    // 任何一项删不掉（占用/权限）时返回 false，其余项仍会尽力删除。
    static bool DeleteRecursive(string path) {
        // 顶层本身是链接（Windows junction/符号链接、POSIX 符号链接）
        // 时只删链接本身，绝不递归进指向的树。
        #if WINDOWS
        if (File.IsReparsePoint(path)) {
            File.Delete(path);
            return !File.Exists(path);
        }
        #else
        if (Directory.IsSymlink(path)) {
            File.Delete(path);
            return !File.Exists(path);
        }
        #endif
        if (!ExistsOnDisk(path)) { return true; }
        string dir = path;
        if (dir.EndsWith("/") || dir.EndsWith("\\")) {
            dir = dir.Substring(0, dir.Length - 1);
        }
        bool ok = true;
        List<string> files = Directory.GetFiles(dir);
        for (int i = 0; i < files.Count; i = i + 1) {
            string f = dir + "/" + files[i];
            File.Delete(f);
            if (File.Exists(f)) { ok = false; }
        }
        List<string> subs = Directory.GetDirectories(dir);
        for (int i = 0; i < subs.Count; i = i + 1) {
            if (!Directory.DeleteRecursive(dir + "/" + subs[i])) { ok = false; }
        }
        Directory.Delete(dir);
        if (ExistsOnDisk(dir)) { ok = false; }
        return ok;
    }
}
