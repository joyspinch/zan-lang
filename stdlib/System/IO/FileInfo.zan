using System;

namespace System.IO;

/// <summary>
/// 单个文件或目录的元数据：大小、时间戳以及
/// 只读/隐藏/目录属性。File 本身只整体读写内容，
/// 因此“上次何时修改？”这类问题在此回答——
/// 这也是增量构建、监听器与热重载所依赖的信息。
/// 时间戳为 Unix 秒（文件不存在时为 0）。
/// </summary>
class FileInfo {
    [DllImport("crt")]
    static extern long zan_file_time(string path, int which);
    [DllImport("crt")]
    static extern long zan_file_length(string path);
    [DllImport("crt")]
    static extern long zan_file_attributes(string path);
    [DllImport("crt")]
    static extern long zan_file_set_readonly(string path, int on);

    string path;

    FileInfo(string p) {
        this.path = p;
    }

    /// 该实例所描述的路径。
    string FullName() { return this.path; }

    bool Exists() { return zan_file_attributes(this.path) >= 0; }

    /// 文件大小（字节），路径不存在时为 -1。
    long Length() { return zan_file_length(this.path); }

    long LastWriteTime() { return zan_file_time(this.path, 0); }
    long CreationTime() { return zan_file_time(this.path, 1); }
    long LastAccessTime() { return zan_file_time(this.path, 2); }

    bool IsReadOnly() {
        long a = zan_file_attributes(this.path);
        if (a < 0) { return false; }
        return (a % 2) == 1;
    }

    bool IsHidden() {
        long a = zan_file_attributes(this.path);
        if (a < 0) { return false; }
        return ((a / 2) % 2) == 1;
    }

    bool IsDirectory() {
        long a = zan_file_attributes(this.path);
        if (a < 0) { return false; }
        return ((a / 4) % 2) == 1;
    }

    /// 将文件设为只读或可写。无法修改时返回 false
    /// （文件不存在、无权限）。
    bool SetReadOnly(bool on) {
        int flag = 0;
        if (on) { flag = 1; }
        return zan_file_set_readonly(this.path, flag) == 1;
    }

    /// 当 `this` 比 `other` 新时返回 true，即 `other` 需要重新构建。
    /// `other` 不存在时视为过期。
    bool NewerThan(string other) {
        long mine = zan_file_time(this.path, 0);
        long theirs = zan_file_time(other, 0);
        if (theirs == 0) { return true; }
        return mine > theirs;
    }

    static long GetLastWriteTime(string path) { return zan_file_time(path, 0); }
    static long GetCreationTime(string path) { return zan_file_time(path, 1); }
    static long GetLastAccessTime(string path) { return zan_file_time(path, 2); }
    static long GetLength(string path) { return zan_file_length(path); }
    static long GetAttributes(string path) { return zan_file_attributes(path); }
}
