using System;
using System.Buffers.Binary;

namespace System.IO;

// 可增长的二进制缓冲区，显式跟踪长度，小端序
// 编码基础类型。底层存储是原始堆外内存，以
// nint 地址持有（绝不是 ARC 字符串），因此内容可包含 NUL 字节，
// 并可通过 <see cref="Raw"/> 直接传给 FFI 调用。
// 写入在写位置处追加；读取则从独立的
// 读位置消费：
// ByteBuffer b = ByteBuffer.Alloc(64);
// b.SeekRead(0);
// long v = b.ReadU32();
// 用完后调用 <see cref="Free"/> 释放。
public class ByteBuffer {
    public nint data;
    public int capacity;
    public int length;  // 已写入字节数（高水位）
    public int rpos;  // 读游标

    // 构造零容量缓冲区；实例经 Alloc/FromRaw/FromStr 创建。
    public ByteBuffer() {
        this.data = 0;
        this.capacity = 0;
        this.length = 0;
        this.rpos = 0;
    }

    // 分配指定初始容量的缓冲区。
    public static ByteBuffer Alloc(int initialCapacity) {
        ByteBuffer b = new ByteBuffer();
        int cap = initialCapacity;
        if (cap < 16) { cap = 16; }
        b.data = NativeMemory.Alloc(cap);
        // 分配失败必须在这里说出来：不然 capacity 记着 cap 而 data 是 0，
        // 第一次写入就 memcpy 到地址 0 附近，故障地址只是写偏移，看不出原因。
        if (b.data == 0) {
            throw new IOException("ByteBuffer: out of memory allocating "
                + cap + " bytes");
        }
        b.capacity = cap;
        return b;
    }

    // 包装从现有原始块复制出的 count 字节。
    public static ByteBuffer FromRaw(nint src, int count) {
        ByteBuffer b = ByteBuffer.Alloc(count);
        NativeMemory.Copy(b.data, src, count);
        b.length = count;
        return b;
    }

    // 将字符串的原始字节复制到新缓冲区以供读取
    // （跟踪长度；二进制安全，可含 NUL）。用 ReadU8 /
    // ReadVarInt / ReadString 从位置 0 开始读取。
    public static ByteBuffer FromStr(string s) {
        int n = s.Length;
        ByteBuffer b = ByteBuffer.Alloc(n + 1);
        NativeMemory.PutString(b.data, 0, s, n);
        b.length = n;
        return b;
    }

    // 将已写入的字节以字符串形式返回（二进制安全：字符串
    // 携带显式长度，因此内嵌的 NUL 字节得以保留）。
    public string ToStr() {
        return NativeMemory.GetString(this.data, 0, this.length);
    }

    // 将已写入的字节以原生字节数组返回。末尾多带 1 个 NUL
    // 是既有契约（byte[] 可直接当 C 串用），被
    // tests/conformance/bytebuffer_bounds.zan "tobytes length" 钉死；
    // 改为恰好 Length 会破坏该金样与依赖 C 串语义的调用方。底层使用
    // memcpy 直接复制，消除字节级解释器循环与额外装箱。
    public byte[] ToBytes() {
        if (this.length <= 0) { return new byte[1]; }
        byte[] b = new byte[this.length + 1];
        NativeMemory.Copy((nint)b, this.data, this.length);
        return b;
    }

    // 释放底层内存分配。
    public void Free() {
        if (this.capacity > 0) {
            NativeMemory.Free(this.data);
            this.data = 0;
            this.capacity = 0;
            this.length = 0;
            this.rpos = 0;
        }
    }

    // 目前已写入的字节数。
    public int Length() { return this.length; }

    // 当前读位置。
    public int ReadPos() { return this.rpos; }

    // 剩余未读字节数。
    public int Remaining() { return this.length - this.rpos; }

    // 供 FFI 调用的原始底层地址（Free/扩容前有效）。
    public nint Raw() { return this.data; }

    // 移动读游标（越界时钳制到 [0, length]）。
    public ByteBuffer SeekRead(int pos) {
        if (pos < 0) { pos = 0; }
        if (pos > this.length) { pos = this.length; }
        this.rpos = pos;
        return this;
    }

    // 重置写读位置，保留内存分配。
    public ByteBuffer Clear() {
        this.length = 0;
        this.rpos = 0;
        return this;
    }

    // 扩容内存，确保至少能容纳 cap 字节。
    public ByteBuffer EnsureCapacity(int cap) {
        if (cap > 1073741824) {
            throw new IOException("ByteBuffer: requested capacity exceeds 1GB limit: " + cap);
        }
        if (cap > this.capacity) {
            // 起点不能是 0：默认构造的缓冲区容量为 0，而 0 * 2
            // 永远追不上 cap，循环不会退出。与 Alloc 一样从 16 起步。
            // 增长步长防 32 位有符号整型翻转：c 接近 1GB 时钳制到上限。
            int c = this.capacity * 2;
            if (c < 16) { c = 16; }
            while (c < cap) {
                if (c > 1073741824 / 2) {
                    c = 1073741824;
                    break;
                }
                c = c * 2;
            }
            nint grown = NativeMemory.Alloc(c);
            if (grown == 0) {
                throw new IOException("ByteBuffer: out of memory growing to "
                    + c + " bytes");
            }
            NativeMemory.Copy(grown, this.data, this.length);
            if (this.capacity > 0) { NativeMemory.Free(this.data); }
            this.data = grown;
            this.capacity = c;
        }
        return this;
    }

    // 外部代码（如 FFI 读取）直接填满底层存储后，
    // 设置逻辑长度。不得超过容量。
    public ByteBuffer SetLength(int n) {
        if (n >= 0 && n <= this.capacity) { this.length = n; }
        return this;
    }

    // 确保还能再写 extra 字节（必要时扩容）。
    public void EnsureRoom(int extra) {
        if (extra < 0 || this.length > 1073741824 - extra) {
            throw new IOException("ByteBuffer: write would exceed capacity limit or negative extra: " + extra);
        }
        this.EnsureCapacity(this.length + extra);
    }

    // ===== 写入方法（小端序） =====

    // 追加 1 个字节。
    public ByteBuffer WriteU8(int v) {
        EnsureRoom(1);
        Span<byte> sp = new Span<byte>(this.data, this.capacity);
        sp[this.length] = (byte)v;
        this.length = this.length + 1;
        return this;
    }

    // 追加小端 16 位。
    public ByteBuffer WriteU16(int v) {
        EnsureRoom(2);
        Span<byte> sp = new Span<byte>(this.data + this.length, 2);
        BinaryPrimitives.WriteUInt16LittleEndian(sp, (ushort)v);
        this.length = this.length + 2;
        return this;
    }

    // 追加小端 32 位。
    public ByteBuffer WriteU32(long v) {
        EnsureRoom(4);
        Span<byte> sp = new Span<byte>(this.data + this.length, 4);
        BinaryPrimitives.WriteUInt32LittleEndian(sp, (uint)v);
        this.length = this.length + 4;
        return this;
    }

    // 追加小端 64 位。
    public ByteBuffer WriteU64(long v) {
        EnsureRoom(8);
        Span<byte> sp = new Span<byte>(this.data + this.length, 8);
        BinaryPrimitives.WriteUInt64LittleEndian(sp, (ulong)v);
        this.length = this.length + 8;
        return this;
    }

    // 追加单精度浮点数 (float32)。
    public ByteBuffer WriteF32(float v) {
        EnsureRoom(4);
        Span<byte> sp = new Span<byte>(this.data + this.length, 4);
        BinaryPrimitives.WriteSingleLittleEndian(sp, v);
        this.length = this.length + 4;
        return this;
    }

    // 追加双精度浮点数 (float64)。
    public ByteBuffer WriteF64(double v) {
        EnsureRoom(8);
        Span<byte> sp = new Span<byte>(this.data + this.length, 8);
        BinaryPrimitives.WriteDoubleLittleEndian(sp, v);
        this.length = this.length + 8;
        return this;
    }

    // 无符号 LEB128 变长整数（0-127 占 1 字节）。
    public ByteBuffer WriteVarInt(long v) {
        long x = v;
        while ((x & -128) != 0) {
            WriteU8((int)((x & 127) | 128));
            x = (x >> 7) & 144115188075855871;  // 逻辑右移：清除符号位
        }
        WriteU8((int)(x & 127));
        return this;
    }

    // 从原始块或另一个缓冲区的 Raw() 复制 count 字节。
    public ByteBuffer WriteBytes(nint src, int count) {
        EnsureRoom(count);
        NativeMemory.Copy(this.data + this.length, src, count);
        this.length = this.length + count;
        return this;
    }

    // 追加 <paramref name="src"/> 开头的 count 个字节，不写
    // 长度前缀。长度由调用方给出，因此二进制安全：字符串本身
    // 以 NUL 结尾，<c>s.Length</c> 只数到第一个 NUL，而网络收到的
    // 字节（HTTP 二进制请求体、上传内容）本就可能含 NUL。
    public ByteBuffer WriteRaw(string src, int count) {
        if (count <= 0) { return this; }
        EnsureRoom(count);
        NativeMemory.PutString(this.data, this.length, src, count);
        this.length = this.length + count;
        return this;
    }

    // 追加字节数组切片，不写长度前缀。零额外中间拷贝，完全二进制安全。
    public ByteBuffer WriteBytes(byte[] src, int offset, int count) {
        if (src == null || count <= 0) { return this; }
        if (offset < 0 || offset + count > src.Length) { return this; }
        EnsureRoom(count);
        NativeMemory.Copy(this.data + (nint)this.length, (nint)src + (nint)offset, count);
        this.length = this.length + count;
        return this;
    }

    // 已写入字节中下标 i 处的字节（0-255）；越界返回 -1。
    // 供扫描分隔符（HTTP 头部空行、分块长度行）时逐字节查看，
    // 无需先把缓冲区复制成字符串。
    public int ByteAt(int i) {
        if (i < 0 || i >= this.length) { return -1; }
        Span<byte> sp = new Span<byte>(this.data, this.capacity);
        return sp[i] & 255;
    }

    // 从下标 from 起第一个等于 b 的字节的下标，没有则 -1。
    // 分隔符扫描（HTTP 头部空行、分块长度行）走 memchr：逐字节
    // <see cref="ByteAt"/> 每个字节都要付一次调用、一次视图构造和一次
    // 边界检查，而这本来是整块缓冲区上的向量化循环。
    public int IndexOfByte(int from, int b) {
        int i = from;
        if (i < 0) { i = 0; }
        int n = this.length;
        if (i >= n) { return -1; }
        return NativeMemory.Find(this.data, i, b & 255, n - i);
    }

    // 已写入字节中 [off, off+count) 的切片，以字符串返回
    // （二进制安全：长度显式给出，内嵌 NUL 得以保留）。
    // 越界的区间被钳制到已写入范围内。
    public string Str(int off, int count) {
        int start = off;
        if (start < 0) { start = 0; }
        if (start > this.length) { start = this.length; }
        int n = count;
        if (n < 0) { n = 0; }
        // 减法比较钳制：start+n 在两者都大时 i32 会回绕成
        // 负数导致钳制失效引发越界，因此改用减法比对。
        if (n > this.length - start) { n = this.length - start; }
        return NativeMemory.GetString(this.data, start, n);
    }

    // 零分配视图切片：将缓冲区内容包装为 16 字节只读 StringView 结构体，不触发堆分配与内存拷贝。
    public StringView AsView() {
        if (this.data == (nint)0 || this.length <= 0) { return StringView.Empty(); }
        return new StringView(this.data, this.length);
    }

    public StringView AsView(int off, int count) {
        int start = off;
        if (start < 0) { start = 0; }
        if (start > this.length) { start = this.length; }
        int n = count;
        if (n < 0) { n = 0; }
        if (n > this.length - start) { n = this.length - start; }
        if (this.data == (nint)0 || n == 0) { return StringView.Empty(); }
        return new StringView(this.data + (nint)start, n);
    }

    // 丢弃开头的 count 个字节，将其余字节左移。保留内存
    // 分配，供“消费完一个消息、把流水线剩余字节留到下轮”的
    // 拆包循环复用同一块缓冲区。
    public ByteBuffer Discard(int count) {
        int n = count;
        if (n <= 0) { return this; }
        if (n >= this.length) { return this.Clear(); }
        NativeMemory.Copy(this.data, this.data + n, this.length - n);
        this.length = this.length - n;
        this.rpos = 0;
        return this;
    }

    // 写入长度前缀（varint）UTF-8 字符串。
    public ByteBuffer WriteString(string s) {
        int n = s.Length;
        WriteVarInt(n);
        EnsureRoom(n);
        NativeMemory.PutString(this.data, this.length, s, n);
        this.length = this.length + n;
        return this;
    }

    // ===== 读取方法（小端序） =====

    // 从当前读位置起还能读取 n 字节时为真
    // （读取前先用它判断，防止越过缓冲区末尾）。
    public bool CanRead(int n) {
        if (n < 0) { return false; }
        return n <= this.length - this.rpos;
    }

    // 读取 1 个字节（0-255）；越界抛 InvalidOperationException。
    public int ReadU8() {
        if (!this.CanRead(1)) {
            throw new InvalidOperationException("ByteBuffer: read past end");
        }
        Span<byte> sp = new Span<byte>(this.data, this.capacity);
        int v = sp[this.rpos] & 255;
        this.rpos = this.rpos + 1;
        return v;
    }

    // 读取小端 16 位；越界抛 InvalidOperationException。
    public int ReadU16() {
        if (!this.CanRead(2)) {
            throw new InvalidOperationException("ByteBuffer: read past end");
        }
        ReadOnlySpan<byte> sp = new Span<byte>(this.data + this.rpos, 2);
        int v = (int)BinaryPrimitives.ReadUInt16LittleEndian(sp);
        this.rpos = this.rpos + 2;
        return v;
    }

    // 读取小端 32 位（以 long 返回，无符号）；越界抛 InvalidOperationException。
    public long ReadU32() {
        if (!this.CanRead(4)) {
            throw new InvalidOperationException("ByteBuffer: read past end");
        }
        ReadOnlySpan<byte> sp = new Span<byte>(this.data + this.rpos, 4);
        long v = (long)BinaryPrimitives.ReadUInt32LittleEndian(sp);
        this.rpos = this.rpos + 4;
        return v;
    }

    // 读取小端 64 位；越界抛 InvalidOperationException。
    public long ReadU64() {
        if (!this.CanRead(8)) {
            throw new InvalidOperationException("ByteBuffer: read past end");
        }
        ReadOnlySpan<byte> sp = new Span<byte>(this.data + this.rpos, 8);
        long v = (long)BinaryPrimitives.ReadUInt64LittleEndian(sp);
        this.rpos = this.rpos + 8;
        return v;
    }

    // 读取单精度浮点数 (float32)；越界抛 InvalidOperationException。
    public float ReadF32() {
        if (!this.CanRead(4)) {
            throw new InvalidOperationException("ByteBuffer: read past end");
        }
        ReadOnlySpan<byte> sp = new Span<byte>(this.data + this.rpos, 4);
        float v = BinaryPrimitives.ReadSingleLittleEndian(sp);
        this.rpos = this.rpos + 4;
        return v;
    }

    // 读取双精度浮点数 (float64)；越界抛 InvalidOperationException。
    public double ReadF64() {
        if (!this.CanRead(8)) {
            throw new InvalidOperationException("ByteBuffer: read past end");
        }
        ReadOnlySpan<byte> sp = new Span<byte>(this.data + this.rpos, 8);
        double v = BinaryPrimitives.ReadDoubleLittleEndian(sp);
        this.rpos = this.rpos + 8;
        return v;
    }

    // 读取 LEB128 变长整数；数据截断或超过 64 位时抛
    // InvalidOperationException。
    public long ReadVarInt() {
        long result = 0;
        int shift = 0;
        int b = 0;
        while (true) {
            if (!this.CanRead(1)) {
                throw new InvalidOperationException("ByteBuffer: truncated varint");
            }
            b = this.ReadU8();
            result = result + ((long)(b & 127) << shift);
            if ((b & 128) == 0) { break; }
            shift = shift + 7;
            if (shift > 63) {
                throw new InvalidOperationException("ByteBuffer: varint too long");
            }
        }
        return result;
    }

    // 显式位置读取一个字节（不移动读游标）；越界返回 -1。
    // 供裸解析循环按位置消费，免除 SeekRead 往返。
    public int PeekU8(int pos) {
        if (pos < 0 || pos >= this.length) { return -1; }
        Span<byte> sp = new Span<byte>(this.data, this.capacity);
        return sp[pos] & 255;
    }

    // 显式位置读取 LEB128 变长整数：解析自 pos 起，
    // 结束后的位置写入 np（返回值即数值）。越界/截断返回 -1。
    // 与 <see cref="ReadVarInt"/> 同格式，但完全不碰读游标。
    public long ReadVarIntAt(int pos, out int np) {
        np = pos;
        long result = 0;
        int shift = 0;
        while (true) {
            if (pos < 0 || pos >= this.length) { return -1; }
            Span<byte> sp = new Span<byte>(this.data, this.capacity);
            int b = sp[pos] & 255;
            pos = pos + 1;
            result = result + ((long)(b & 127) << shift);
            if ((b & 128) == 0) { break; }
            shift = shift + 7;
            if (shift > 63) { return -1; }
        }
        np = pos;
        return result;
    }

    // 缓冲内 [off, off+len) 与 other 的序数比较：memcmp
    // 前缀、长度定序（字节串语义，与 String.CompareOrdinal 同序）。
    // 零分配；越界区间被钳制。
    public int CmpRangeRaw(int off, int len, string other) {
        if (off < 0) { off = 0; }
        if (off > this.length) { off = this.length; }
        if (len < 0) { len = 0; }
        // 减法比较钳制：off+len 的 i32 回绕同理。
        if (len > this.length - off) { len = this.length - off; }
        int n = len < other.Length ? len : other.Length;
        if (n > 0) {
            int r = NativeMemory.Compare(this.data + off, other, n);
            if (r != 0) { return r < 0 ? -1 : 1; }
        }
        return len - other.Length;
    }

    // 将 count 字节读入新分配的原始块
    // （调用方用 NativeMemory.Free 释放，或包装进 ByteBuffer）。
    public nint ReadBytes(int count) {
        if (count < 0 || !this.CanRead(count)) {
            throw new InvalidOperationException("ByteBuffer: read past end");
        }
        nint buf = NativeMemory.Alloc(count + 1);
        if (buf == 0) {
            throw new IOException("ByteBuffer: out of memory reading "
                + count + " bytes");
        }
        NativeMemory.Copy(buf, this.data + this.rpos, count);
        this.rpos = this.rpos + count;
        return buf;
    }

    // 读取由 WriteString 写入的长度前缀字符串。
    public string ReadString() {
        // 长度前缀受其来源缓冲区大小限制，而该缓冲区是
        // 由 `int` 指定大小的内存块。
        int n = (int)this.ReadVarInt();
        if (n < 0 || !this.CanRead(n)) {
            throw new InvalidOperationException("ByteBuffer: read past end");
        }
        string s = NativeMemory.GetString(this.data, this.rpos, n);
        this.rpos = this.rpos + n;
        return s;
    }

    // ===== 校验和 =====

    // 对前 count 字节计算 CRC32（IEEE，反射）。
    public long Crc32(int count) {
        return NativeMemory.Crc32(this.data, count) & 4294967295;
    }

    // 对前 count 字节计算 CRC32C（Castagnoli，poly 0x82F63B78）。
    // 优先走 SSE4.2/ARMv8 CRC 指令内核，无硬件回退逐字节内建。
    public long Crc32C(int count) {
        long hw = NativeMemory.Crc32CUpdate(4294967295, this.data, (long)count);
        if (hw >= 0) {
            return hw ^ 4294967295;
        }
        return NativeMemory.Crc32C(this.data, count) & 4294967295;
    }
}
