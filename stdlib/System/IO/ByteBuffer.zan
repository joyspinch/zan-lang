using System;

namespace System.IO;

/// <summary>
/// 可增长的二进制缓冲区，显式跟踪长度，小端序
/// 编码基础类型。底层存储是原始堆外内存，以
/// nint 地址持有（绝不是 ARC 字符串），因此内容可包含 NUL 字节，
/// 并可通过 <see cref="Raw"/> 直接传给 FFI 调用。
///
/// 写入在写位置处追加；读取则从独立的
/// 读位置消费：
///   ByteBuffer b = ByteBuffer.Alloc(64);
///   b.WriteU32(1234).WriteVarInt(5).WriteString("hello");
///   b.SeekRead(0);
///   long v = b.ReadU32();
/// 用完后调用 <see cref="Free"/> 释放。
/// </summary>
class ByteBuffer {
    nint data;
    int capacity;
    int length;      // 已写入字节数（高水位）
    int rpos;        // 读游标

    ByteBuffer() {
        this.data = 0;
        this.capacity = 0;
        this.length = 0;
        this.rpos = 0;
    }

    /// <summary>分配指定初始容量的缓冲区。</summary>
    static ByteBuffer Alloc(int initialCapacity) {
        ByteBuffer b = new ByteBuffer();
        int cap = initialCapacity;
        if (cap < 16) { cap = 16; }
        b.data = NativeMemory.Alloc(cap);
        // 分配失败必须在这里说出来：不然 capacity 记着 cap 而 data 是 0，
        // 第一次写入就 memcpy 到地址 0 附近，故障地址只是写偏移，看不出原因。
        if (b.data == 0) {
            throw new IOException("ByteBuffer: out of memory allocating "
                + cap + " bytes");
        }
        b.capacity = cap;
        return b;
    }

    /// <summary>包装从现有原始块复制出的 count 字节。</summary>
    static ByteBuffer FromRaw(nint src, int count) {
        ByteBuffer b = ByteBuffer.Alloc(count);
        NativeMemory.Copy(b.data, src, count);
        b.length = count;
        return b;
    }

    /// <summary>将字符串的原始字节复制到新缓冲区以供读取
    /// （跟踪长度；二进制安全，可含 NUL）。用 ReadU8 /
    /// ReadVarInt / ReadString 从位置 0 开始读取。</summary>
    static ByteBuffer FromStr(string s) {
        int n = s.Length;
        ByteBuffer b = ByteBuffer.Alloc(n + 1);
        NativeMemory.PutString(b.data, 0, s, n);
        b.length = n;
        return b;
    }

    /// <summary>将已写入的字节以字符串形式返回（二进制安全：字符串
    /// 携带显式长度，因此内嵌的 NUL 字节得以保留）。</summary>
    string ToStr() {
        return NativeMemory.GetString(this.data, 0, this.length);
    }

    /// <summary>释放底层内存分配。</summary>
    void Free() {
        if (this.capacity > 0) {
            NativeMemory.Free(this.data);
            this.data = 0;
            this.capacity = 0;
            this.length = 0;
            this.rpos = 0;
        }
    }

    /// <summary>目前已写入的字节数。</summary>
    int Length() { return this.length; }

    /// <summary>当前读位置。</summary>
    int ReadPos() { return this.rpos; }

    /// <summary>剩余未读字节数。</summary>
    int Remaining() { return this.length - this.rpos; }

    /// <summary>供 FFI 调用的原始底层地址（Free/扩容前有效）。</summary>
    nint Raw() { return this.data; }

    /// <summary>移动读游标（越界时钳制到 [0, length]）。</summary>
    ByteBuffer SeekRead(int pos) {
        if (pos < 0) { pos = 0; }
        if (pos > this.length) { pos = this.length; }
        this.rpos = pos;
        return this;
    }

    /// <summary>重置写读位置，保留内存分配。</summary>
    ByteBuffer Clear() {
        this.length = 0;
        this.rpos = 0;
        return this;
    }

    /// <summary>扩容内存，确保至少能容纳 cap 字节。</summary>
    ByteBuffer EnsureCapacity(int cap) {
        if (cap > this.capacity) {
            // 起点不能是 0：默认构造的缓冲区容量为 0，而 0 * 2
            // 永远追不上 cap，循环不会退出。与 Alloc 一样从 16 起步。
            int c = this.capacity * 2;
            if (c < 16) { c = 16; }
            while (c < cap) { c = c * 2; }
            nint grown = NativeMemory.Alloc(c);
            if (grown == 0) {
                throw new IOException("ByteBuffer: out of memory growing to "
                    + c + " bytes");
            }
            NativeMemory.Copy(grown, this.data, this.length);
            if (this.capacity > 0) { NativeMemory.Free(this.data); }
            this.data = grown;
            this.capacity = c;
        }
        return this;
    }

    /// <summary>外部代码（如 FFI 读取）直接填满底层存储后，
    /// 设置逻辑长度。不得超过容量。</summary>
    ByteBuffer SetLength(int n) {
        if (n >= 0 && n <= this.capacity) { this.length = n; }
        return this;
    }

    void EnsureRoom(int extra) {
        this.EnsureCapacity(this.length + extra);
    }

    // ===== 写入方法（小端序） =====

    ByteBuffer WriteU8(int v) {
        EnsureRoom(1);
        Span<byte> sp = new Span<byte>(this.data, this.capacity);
        sp[this.length] = (byte)v;
        this.length = this.length + 1;
        return this;
    }

    ByteBuffer WriteU16(int v) {
        EnsureRoom(2);
        Span<byte> sp = new Span<byte>(this.data, this.capacity);
        sp[this.length] = (byte)v;
        sp[this.length + 1] = (byte)(v >> 8);
        this.length = this.length + 2;
        return this;
    }

    ByteBuffer WriteU32(long v) {
        EnsureRoom(4);
        Span<byte> sp = new Span<byte>(this.data, this.capacity);
        sp[this.length] = (byte)v;
        sp[this.length + 1] = (byte)(v >> 8);
        sp[this.length + 2] = (byte)(v >> 16);
        sp[this.length + 3] = (byte)(v >> 24);
        this.length = this.length + 4;
        return this;
    }

    ByteBuffer WriteU64(long v) {
        EnsureRoom(8);
        Span<byte> sp = new Span<byte>(this.data, this.capacity);
        sp[this.length] = (byte)v;
        sp[this.length + 1] = (byte)(v >> 8);
        sp[this.length + 2] = (byte)(v >> 16);
        sp[this.length + 3] = (byte)(v >> 24);
        sp[this.length + 4] = (byte)(v >> 32);
        sp[this.length + 5] = (byte)(v >> 40);
        sp[this.length + 6] = (byte)(v >> 48);
        sp[this.length + 7] = (byte)(v >> 56);
        this.length = this.length + 8;
        return this;
    }

    /// <summary>无符号 LEB128 变长整数（0-127 占 1 字节）。</summary>
    ByteBuffer WriteVarInt(long v) {
        long x = v;
        while ((x & -128) != 0) {
            WriteU8((int)((x & 127) | 128));
            x = (x >> 7) & 144115188075855871;   // 逻辑右移：清除符号位
        }
        WriteU8((int)(x & 127));
        return this;
    }

    /// <summary>从原始块或另一个缓冲区的 Raw() 复制 count 字节。</summary>
    ByteBuffer WriteBytes(nint src, int count) {
        EnsureRoom(count);
        NativeMemory.Copy(this.data + this.length, src, count);
        this.length = this.length + count;
        return this;
    }

    /// <summary>追加 <paramref name="src"/> 开头的 count 个字节，不写
    /// 长度前缀。长度由调用方给出，因此二进制安全：字符串本身
    /// 以 NUL 结尾，<c>s.Length</c> 只数到第一个 NUL，而网络收到的
    /// 字节（HTTP 二进制请求体、上传内容）本就可能含 NUL。</summary>
    ByteBuffer WriteRaw(string src, int count) {
        if (count <= 0) { return this; }
        EnsureRoom(count);
        NativeMemory.PutString(this.data, this.length, src, count);
        this.length = this.length + count;
        return this;
    }

    /// <summary>已写入字节中下标 i 处的字节（0-255）；越界返回 -1。
    /// 供扫描分隔符（HTTP 头部空行、分块长度行）时逐字节查看，
    /// 无需先把缓冲区复制成字符串。</summary>
    int ByteAt(int i) {
        if (i < 0 || i >= this.length) { return -1; }
        Span<byte> sp = new Span<byte>(this.data, this.capacity);
        return sp[i] & 255;
    }

    /// <summary>从下标 from 起第一个等于 b 的字节的下标，没有则 -1。
    /// 分隔符扫描（HTTP 头部空行、分块长度行）走 memchr：逐字节
    /// <see cref="ByteAt"/> 每个字节都要付一次调用、一次视图构造和一次
    /// 边界检查，而这本来是整块缓冲区上的向量化循环。</summary>
    int IndexOfByte(int from, int b) {
        int i = from;
        if (i < 0) { i = 0; }
        int n = this.length;
        if (i >= n) { return -1; }
        return NativeMemory.Find(this.data, i, b & 255, n - i);
    }

    /// <summary>已写入字节中 [off, off+count) 的切片，以字符串返回
    /// （二进制安全：长度显式给出，内嵌 NUL 得以保留）。
    /// 越界的区间被钳制到已写入范围内。</summary>
    string Str(int off, int count) {
        int start = off;
        if (start < 0) { start = 0; }
        if (start > this.length) { start = this.length; }
        int n = count;
        if (n < 0) { n = 0; }
        if (start + n > this.length) { n = this.length - start; }
        return NativeMemory.GetString(this.data, start, n);
    }

    /// <summary>丢弃开头的 count 个字节，将其余字节左移。保留内存
    /// 分配，供“消费完一个消息、把流水线剩余字节留到下轮”的
    /// 拆包循环复用同一块缓冲区。</summary>
    ByteBuffer Discard(int count) {
        int n = count;
        if (n <= 0) { return this; }
        if (n >= this.length) { return this.Clear(); }
        NativeMemory.Copy(this.data, this.data + n, this.length - n);
        this.length = this.length - n;
        this.rpos = 0;
        return this;
    }

    /// <summary>写入长度前缀（varint）UTF-8 字符串。</summary>
    ByteBuffer WriteString(string s) {
        int n = s.Length;
        WriteVarInt(n);
        EnsureRoom(n);
        NativeMemory.PutString(this.data, this.length, s, n);
        this.length = this.length + n;
        return this;
    }

    // ===== 读取方法（小端序） =====

    /// <summary>从当前读位置起还能读取 n 字节时为真
    /// （读取前先用它判断，防止越过缓冲区末尾）。</summary>
    bool CanRead(int n) {
        if (n < 0) { return false; }
        return n <= this.length - this.rpos;
    }

    int ReadU8() {
        if (!this.CanRead(1)) {
            throw new InvalidOperationException("ByteBuffer: read past end");
        }
        Span<byte> sp = new Span<byte>(this.data, this.capacity);
        int v = sp[this.rpos] & 255;
        this.rpos = this.rpos + 1;
        return v;
    }

    int ReadU16() {
        if (!this.CanRead(2)) {
            throw new InvalidOperationException("ByteBuffer: read past end");
        }
        Span<byte> sp = new Span<byte>(this.data, this.capacity);
        int v = (sp[this.rpos] & 255) | ((sp[this.rpos + 1] & 255) << 8);
        this.rpos = this.rpos + 2;
        return v;
    }

    long ReadU32() {
        if (!this.CanRead(4)) {
            throw new InvalidOperationException("ByteBuffer: read past end");
        }
        Span<byte> sp = new Span<byte>(this.data, this.capacity);
        long v = ((long)(sp[this.rpos] & 255)) | ((long)(sp[this.rpos + 1] & 255) << 8)
               | ((long)(sp[this.rpos + 2] & 255) << 16) | ((long)(sp[this.rpos + 3] & 255) << 24);
        this.rpos = this.rpos + 4;
        return v;
    }

    long ReadU64() {
        if (!this.CanRead(8)) {
            throw new InvalidOperationException("ByteBuffer: read past end");
        }
        Span<byte> sp = new Span<byte>(this.data, this.capacity);
        long v = ((long)(sp[this.rpos] & 255)) | ((long)(sp[this.rpos + 1] & 255) << 8)
               | ((long)(sp[this.rpos + 2] & 255) << 16) | ((long)(sp[this.rpos + 3] & 255) << 24)
               | ((long)(sp[this.rpos + 4] & 255) << 32) | ((long)(sp[this.rpos + 5] & 255) << 40)
               | ((long)(sp[this.rpos + 6] & 255) << 48) | ((long)(sp[this.rpos + 7] & 255) << 56);
        this.rpos = this.rpos + 8;
        return v;
    }

    long ReadVarInt() {
        long result = 0;
        int shift = 0;
        int b = 0;
        while (true) {
            if (!this.CanRead(1)) {
                throw new InvalidOperationException("ByteBuffer: truncated varint");
            }
            b = this.ReadU8();
            result = result + ((long)(b & 127) << shift);
            if ((b & 128) == 0) { break; }
            shift = shift + 7;
            if (shift > 63) {
                throw new InvalidOperationException("ByteBuffer: varint too long");
            }
        }
        return result;
    }

    /// <summary>将 count 字节读入新分配的原始块
    /// （调用方用 NativeMemory.Free 释放，或包装进 ByteBuffer）。</summary>
    nint ReadBytes(int count) {
        if (count < 0 || !this.CanRead(count)) {
            throw new InvalidOperationException("ByteBuffer: read past end");
        }
        nint buf = NativeMemory.Alloc(count + 1);
        if (buf == 0) {
            throw new IOException("ByteBuffer: out of memory reading "
                + count + " bytes");
        }
        NativeMemory.Copy(buf, this.data + this.rpos, count);
        this.rpos = this.rpos + count;
        return buf;
    }

    /// <summary>读取由 WriteString 写入的长度前缀字符串。</summary>
    string ReadString() {
        // 长度前缀受其来源缓冲区大小限制，而该缓冲区是
        // 由 `int` 指定大小的内存块。
        int n = (int)this.ReadVarInt();
        if (n < 0 || !this.CanRead(n)) {
            throw new InvalidOperationException("ByteBuffer: read past end");
        }
        string s = NativeMemory.GetString(this.data, this.rpos, n);
        this.rpos = this.rpos + n;
        return s;
    }

    // ===== 校验和 =====

    /// <summary>对前 count 字节计算 CRC32（IEEE，反射）。</summary>
    long Crc32(int count) {
        return NativeMemory.Crc32(this.data, count) & 4294967295;
    }
}
