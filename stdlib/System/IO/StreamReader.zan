using System;

namespace System.IO;

/// <summary>
/// 基于 <see cref="Stream"/> 的缓冲文本读取：逐行读取，
/// 避免像 File.ReadAllText 那样把整个文件读入内存，
/// （这正是 File.ReadAllText 目前的做法）。
///
///   StreamReader r = StreamReader.Open("log.txt");
///   string line = r.ReadLine();
///   while (line != null) {
///       Console.WriteLine(line);
///       line = r.ReadLine();
///   }
///   r.Close();
///
/// <see cref="ReadLine"/> 在输入结束时返回 null，并去掉行
/// 终止符（"\n" 和 "\r\n" 都适用）。字节按原样传递（UTF-8
/// 输入仍保持 UTF-8）。若此 reader 打开了底层流，Close 会将其关闭；
/// 若 reader 包装的是调用方传入的流，则不会动它。
/// </summary>
class StreamReader {
    Stream stream;
    bool owns;
    string buf;      // 已读取但尚未返回的字节
    int pos;         // buf 的消费游标
    bool eof;        // 流中已无更多字节
    int chunk;

    StreamReader() {
        this.stream = null;
        this.owns = false;
        this.buf = "";
        this.pos = 0;
        this.eof = false;
        this.chunk = 8192;
    }

    /// <summary>从现有流读取文本（不由本 reader
    /// 关闭）。</summary>
    static StreamReader Wrap(Stream s) {
        StreamReader r = new StreamReader();
        r.stream = s;
        return r;
    }

    /// <summary>打开文件用于读取。若文件
    /// 不存在则抛出 FileNotFoundException。</summary>
    static StreamReader Open(string path) {
        StreamReader r = new StreamReader();
        r.stream = FileStream.OpenRead(path);
        r.owns = true;
        return r;
    }

    /// <summary>从字符串读取文本，用于测试解析器。</summary>
    static StreamReader FromStr(string text) {
        StreamReader r = new StreamReader();
        r.stream = MemoryStream.FromStr(text);
        r.owns = true;
        return r;
    }

    /// <summary>正在读取的流。</summary>
    Stream BaseStream() { return this.stream; }

    /// <summary>缓冲区为空且流已耗尽时为真。</summary>
    bool EndOfStream() {
        if (this.pos < this.buf.Length) {
            return false;
        }
        this.Fill();
        return this.pos >= this.buf.Length;
    }

    /// <summary>缓冲区耗尽时再拉取一块数据。</summary>
    void Fill() {
        if (this.pos < this.buf.Length || this.eof) {
            return;
        }
        string more = this.stream.Read(this.chunk);
        if (more.Length == 0) {
            this.eof = true;
            return;
        }
        this.buf = more;
        this.pos = 0;
    }

    /// <summary>读取一个字节作为单字符字符串，结束时返回 ""。</summary>
    string ReadChar() {
        this.Fill();
        if (this.pos >= this.buf.Length) {
            return "";
        }
        string c = this.buf.Substring(this.pos, 1);
        this.pos = this.pos + 1;
        return c;
    }

    /// <summary>读取最多 `count` 字节；输入结束时返回 ""。</summary>
    string ReadBlock(int count) {
        StringBuilder sb = new StringBuilder();
        int need = count;
        while (need > 0) {
            this.Fill();
            int avail = this.buf.Length - this.pos;
            if (avail <= 0) {
                need = 0;
            } else {
                int take = need;
                if (take > avail) { take = avail; }
                sb.Append(this.buf.Substring(this.pos, take));
                this.pos = this.pos + take;
                need = need - take;
            }
        }
        return sb.ToString();
    }

    /// <summary>读取下一行（不含终止符），或返回 null（输入
    /// 结束）。</summary>
    string ReadLine() {
        this.Fill();
        if (this.pos >= this.buf.Length) {
            return null;
        }
        StringBuilder sb = new StringBuilder();
        bool done = false;
        while (!done) {
            this.Fill();
            if (this.pos >= this.buf.Length) {
                done = true;
            } else {
                string c = this.buf.Substring(this.pos, 1);
                this.pos = this.pos + 1;
                if (c == "\n") {
                    done = true;
                } else if (c != "\r") {
                    sb.Append(c);
                }
            }
        }
        return sb.ToString();
    }

    /// <summary>读取剩余的所有行。</summary>
    List<string> ReadAllLines() {
        List<string> lines = new List<string>();
        string line = this.ReadLine();
        while (line != null) {
            lines.Add(line);
            line = this.ReadLine();
        }
        return lines;
    }

    /// <summary>读取剩余全部内容（含缓冲区）。</summary>
    string ReadToEnd() {
        StringBuilder sb = new StringBuilder();
        if (this.pos < this.buf.Length) {
            sb.Append(this.buf.Substring(this.pos, this.buf.Length - this.pos));
            this.pos = this.buf.Length;
        }
        if (!this.eof) {
            sb.Append(this.stream.ReadToEnd());
            this.eof = true;
        }
        return sb.ToString();
    }

    /// <summary>关闭 reader；若该 reader 打开了底层流，也一并关闭
    /// 该流。</summary>
    void Close() {
        if (this.owns && this.stream != null) {
            this.stream.Close();
        }
        this.stream = null;
        this.buf = "";
        this.pos = 0;
        this.eof = true;
    }
}
