using System;

namespace System.IO;

// 基于 Stream 的缓冲文本读取器：按块拉取并逐行解码（兼容 "\n" 与 "\r\n"，字节按 UTF-8 原样传递）。
// 若由本 reader 打开底层流（如 Open/FromStr），Close 时一并关闭；Wrap 传入的外部流由调用方关闭。
public class StreamReader : IDisposable {
    Stream stream;
    bool owns;
    string buf;  // 已读取但尚未返回的字节
    int pos;  // buf 的消费游标
    bool eof;  // 流中已无更多字节
    int chunk;

    public StreamReader() {
        this.stream = null;
        this.owns = false;
        this.buf = "";
        this.pos = 0;
        this.eof = false;
        this.chunk = 8192;
    }

    // 打开文件用于读取。若文件不存在则抛出 FileNotFoundException。
    public StreamReader(string path) : this() {
        this.stream = FileStream.OpenRead(path);
        this.owns = true;
    }

    // 从现有流读取文本（不由本 reader 关闭）。
    public StreamReader(Stream s) : this() {
        this.stream = s;
        this.owns = false;
    }

    // 从现有流读取文本（不由本 reader 关闭）。
    public static StreamReader Wrap(Stream s) {
        return new StreamReader(s);
    }

    // 打开文件用于读取；文件不存在抛 FileNotFoundException。
    public static StreamReader Open(string path) {
        return new StreamReader(path);
    }

    // 从字符串读取文本，用于测试解析器。
    public static StreamReader FromStr(string text) {
        StreamReader r = new StreamReader();
        r.stream = MemoryStream.FromStr(text);
        r.owns = true;
        return r;
    }

    // 正在读取的流。
    public Stream BaseStream() { return this.stream; }

    // 缓冲区为空且流已耗尽时为真。
    public bool EndOfStream() {
        if (this.pos < this.buf.Length) {
            return false;
        }
        this.Fill();
        return this.pos >= this.buf.Length;
    }

    private void AcceptChunk(string more) {
        if (more.Length == 0) {
            this.eof = true;
            return;
        }
        this.buf = more;
        this.pos = 0;
    }

    // 缓冲区耗尽时再拉取一块数据。
    void Fill() {
        if (this.pos < this.buf.Length || this.eof) { return; }
        this.AcceptChunk(this.stream.Read(this.chunk));
    }

    // 异步拉取一块数据到缓冲区。
    async void FillAsync() {
        if (this.pos < this.buf.Length || this.eof) { return; }
        this.AcceptChunk(await this.stream.ReadAsync(this.chunk));
    }

    // 读取一个字节作为单字符字符串，结束时返回 ""。
    public string ReadChar() {
        this.Fill();
        if (this.pos >= this.buf.Length) {
            return "";
        }
        string c = this.buf.Substring(this.pos, 1);
        this.pos = this.pos + 1;
        return c;
    }

    // 读取最多 `count` 字节；输入结束时返回 ""。
    public string ReadBlock(int count) {
        if (count <= 0) { return ""; }
        this.Fill();
        int firstAvail = this.buf.Length - this.pos;
        if (firstAvail <= 0) { return ""; }
        if (firstAvail >= count) {
            string fast = this.buf.Substring(this.pos, count);
            this.pos = this.pos + count;
            return fast;
        }
        StringBuilder sb = new StringBuilder(count);
        sb.Append(new StringView((nint)this.buf + (nint)this.pos, firstAvail));
        this.pos = this.buf.Length;
        int need = count - firstAvail;
        while (need > 0) {
            this.Fill();
            int avail = this.buf.Length - this.pos;
            if (avail <= 0) {
                break;
            }
            int take = need < avail ? need : avail;
            sb.Append(new StringView((nint)this.buf + (nint)this.pos, take));
            this.pos = this.pos + take;
            need = need - take;
        }
        return sb.ToString();
    }

    private static void AppendTrimmedRange(StringBuilder sb, string s, int start, int end) {
        if (end > start && (s[end - 1] & 255) == 13) {
            end = end - 1;
        }
        if (end <= start) { return; }
        int cr = s.IndexOf("\r", start);
        if (cr < 0 || cr >= end) {
            sb.Append(new StringView((nint)s + (nint)start, end - start));
            return;
        }
        sb.Append(s.Substring(start, end - start).Replace("\r", ""));
    }

    // 尝试从当前缓冲直接切出完整一行（零 StringBuilder 分配）；未命中 '\n' 返回 null。
    private string TryTakeBufferedLine() {
        int nl = this.buf.IndexOf("\n", this.pos);
        if (nl < 0) { return null; }
        int start = this.pos;
        int lineEnd = nl;
        if (lineEnd > start && (this.buf[lineEnd - 1] & 255) == 13) {
            lineEnd = lineEnd - 1;
        }
        this.pos = nl + 1;
        if (lineEnd <= start) { return ""; }
        int cr = this.buf.IndexOf("\r", start);
        if (cr < 0 || cr >= lineEnd) {
            return this.buf.Substring(start, lineEnd - start);
        }
        return this.buf.Substring(start, lineEnd - start).Replace("\r", "");
    }

    // 从当前 buf 消费至 '\n'；命中返回 true（pos 跳过换行），未命中消费到 buf 尾返回 false。
    private bool ConsumeBufferedLine(StringBuilder sb) {
        int start = this.pos;
        int nl = this.buf.IndexOf("\n", start);
        if (nl >= 0) {
            StreamReader.AppendTrimmedRange(sb, this.buf, start, nl);
            this.pos = nl + 1;
            return true;
        }
        int bufLen = this.buf.Length;
        StreamReader.AppendTrimmedRange(sb, this.buf, start, bufLen);
        this.pos = bufLen;
        return false;
    }

    // 读取下一行（不含终止符），输入结束返回 null。
    public string ReadLine() {
        this.Fill();
        if (this.pos >= this.buf.Length) {
            return null;
        }
        string fast = this.TryTakeBufferedLine();
        if (fast != null) { return fast; }
        StringBuilder sb = new StringBuilder();
        while (true) {
            this.Fill();
            if (this.pos >= this.buf.Length || this.ConsumeBufferedLine(sb)) { break; }
        }
        return sb.ToString();
    }

    // 读取剩余的所有行。
    public List<string> ReadAllLines() {
        List<string> lines = new List<string>();
        string line = this.ReadLine();
        while (line != null) {
            lines.Add(line);
            line = this.ReadLine();
        }
        return lines;
    }

    // 异步读取下一行（不含终止符），输入结束返回 null。
    public async string ReadLineAsync() {
        await this.FillAsync();
        if (this.pos >= this.buf.Length) {
            return null;
        }
        string fast = this.TryTakeBufferedLine();
        if (fast != null) { return fast; }
        StringBuilder sb = new StringBuilder();
        while (true) {
            await this.FillAsync();
            if (this.pos >= this.buf.Length || this.ConsumeBufferedLine(sb)) { break; }
        }
        return sb.ToString();
    }

    // 异步读取剩余的所有行。
    public async List<string> ReadAllLinesAsync() {
        List<string> lines = new List<string>();
        string line = await this.ReadLineAsync();
        while (line != null) {
            lines.Add(line);
            line = await this.ReadLineAsync();
        }
        return lines;
    }

    // 读取剩余全部内容（含缓冲区）。
    public string ReadToEnd() {
        StringBuilder sb = new StringBuilder();
        if (this.pos < this.buf.Length) {
            sb.Append(this.buf.Substring(this.pos, this.buf.Length - this.pos));
            this.pos = this.buf.Length;
        }
        if (!this.eof) {
            sb.Append(this.stream.ReadToEnd());
            this.eof = true;
        }
        return sb.ToString();
    }

    // 异步读取剩余全部内容（含缓冲区）。
    public async string ReadToEndAsync() {
        StringBuilder sb = new StringBuilder();
        if (this.pos < this.buf.Length) {
            sb.Append(this.buf.Substring(this.pos, this.buf.Length - this.pos));
            this.pos = this.buf.Length;
        }
        if (!this.eof) {
            sb.Append(await this.stream.ReadToEndAsync());
            this.eof = true;
        }
        return sb.ToString();
    }

    // 异步关闭 reader。
    public async void CloseAsync() {
        this.Close();
    }

    // 关闭 reader；若由本 reader 打开底层流则一并关闭。
    public void Close() {
        if (this.owns && this.stream != null) {
            this.stream.Close();
        }
        this.stream = null;
        this.buf = "";
        this.pos = 0;
        this.eof = true;
    }

    // 释放 reader 占用的资源（实现 IDisposable，等同于 Close）。
    public void Dispose() {
        this.Close();
    }
}
