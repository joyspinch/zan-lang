using System;
using System.IO;

namespace System.IO;

/// <summary>由
/// <see cref="Shortcut.Read"/> 返回的结构化 .lnk 内容。</summary>
class ShortcutInfo {
    public string target;
    public string arguments;
    public string workingDir;
    public string description;
    public string iconPath;
    public int iconIndex;

    ShortcutInfo() {
        this.target = "";
        this.arguments = "";
        this.workingDir = "";
        this.description = "";
        this.iconPath = "";
        this.iconIndex = 0;
    }
}

/// <summary>
/// 创建和解析桌面快捷方式：目标路径、参数、工作目录、
/// 说明和图标。Windows 上是 IShellLink COM 接口写的 .lnk；
/// Linux 上是 freedesktop 的 `[Desktop Entry]` 文件（.desktop），
/// 字段一一对应：Exec=目标+参数、Path=工作目录、Icon=图标、
/// Comment=说明。macOS 没有等价的用户级快捷方式格式，会抛出
/// PlatformNotSupportedException 而不是静默写一个不能用的文件。
///
///   Shortcut.Create("C:\\Users\\me\\Desktop\\app.lnk",
///                   "C:\\app\\app.exe", "--fast", "C:\\app",
///                   "C:\\app\\app.exe", 0);
///   ShortcutInfo info = Shortcut.Read("app.lnk");
///   string t = info.target;
/// </summary>
class Shortcut {
    // CLSID_ShellLink / IID_IShellLinkW / IID_IPersistFile
    static string ClsidShellLink() { return "00021401-0000-0000-C000-000000000046"; }
    static string IidShellLinkW() { return "000214F9-0000-0000-C000-000000000046"; }
    static string IidPersistFile() { return "0000010b-0000-0000-C000-000000000046"; }

    // IShellLinkW 的 vtable 槽位（在 IUnknown 0..2 之后）。
    static int SlotGetPath() { return 3; }
    static int SlotGetDescription() { return 6; }
    static int SlotSetDescription() { return 7; }
    static int SlotGetWorkingDir() { return 8; }
    static int SlotSetWorkingDir() { return 9; }
    static int SlotGetArguments() { return 10; }
    static int SlotSetArguments() { return 11; }
    static int SlotGetIconLocation() { return 16; }
    static int SlotSetIconLocation() { return 17; }
    static int SlotSetPath() { return 20; }

    // IPersistFile 的 vtable 槽位。
    static int SlotLoad() { return 5; }
    static int SlotSave() { return 6; }

    static bool comReady = false;

    static void InitCom() {
        if (Shortcut.comReady) { return; }
        Com.Initialize();
        Shortcut.comReady = true;
    }

    /// <summary>在 `lnkPath` 处创建（或覆盖）一个指向
    /// `target` 的 .lnk。可选：参数、工作目录、图标路径+
    /// 图标索引、说明。成功返回 true。</summary>
    static bool Create(string lnkPath, string target, string arguments,
                       string workingDir, string iconPath, int iconIndex,
                       string description) {
        #if WINDOWS
        Shortcut.InitCom();
        nint shell = Com.Create(Shortcut.ClsidShellLink(), Shortcut.IidShellLinkW());
        if (shell == 0) { return false; }
        nint persist = Com.Query(shell, Shortcut.IidPersistFile());
        bool ok = false;
        if (persist != 0) {
            nint wt = Wide.Of(target);
            int hr1 = Com.Call1(shell, Shortcut.SlotSetPath(), wt);
            Wide.Free(wt);
            nint wa = Wide.Of(arguments);
            Com.Call1(shell, Shortcut.SlotSetArguments(), wa);
            Wide.Free(wa);
            nint wd = Wide.Of(workingDir);
            Com.Call1(shell, Shortcut.SlotSetWorkingDir(), wd);
            Wide.Free(wd);
            nint wdesc = Wide.Of(description);
            Com.Call1(shell, Shortcut.SlotSetDescription(), wdesc);
            Wide.Free(wdesc);
            if (iconPath.Length > 0) {
                nint wi = Wide.Of(iconPath);
                Com.Call2(shell, Shortcut.SlotSetIconLocation(), wi, iconIndex);
                Wide.Free(wi);
            }
            nint wpath = Wide.Of(lnkPath);
            int hr = Com.Call2(persist, Shortcut.SlotSave(), wpath, 1);
            Wide.Free(wpath);
            ok = Com.Ok(hr) && Com.Ok(hr1);
            Com.Release(persist);
        }
        Com.Release(shell);
        return ok;
        #elif LINUX
        return Shortcut.WriteDesktopEntry(lnkPath, target, arguments,
                                          workingDir, iconPath, description);
        #else
        throw new PlatformNotSupportedException(
            "Shortcut is not implemented on this platform");
        #endif
    }

    #if LINUX
    // freedesktop Desktop Entry Specification：一个带 [Desktop Entry] 头的
    // INI 文件，Type=Application 时 Exec 是要执行的命令行。
    static bool WriteDesktopEntry(string path, string target, string arguments,
                                  string workingDir, string iconPath,
                                  string description) {
        if (target == "") { return false; }
        string exec = Shortcut.QuoteArg(target);
        if (arguments != "") { exec = exec + " " + arguments; }
        StringBuilder sb = new StringBuilder();
        sb.Append("[Desktop Entry]\n");
        sb.Append("Version=1.0\n");
        sb.Append("Type=Application\n");
        sb.Append("Name=" + Shortcut.EntryName(path) + "\n");
        sb.Append("Exec=" + exec + "\n");
        if (workingDir != "") { sb.Append("Path=" + workingDir + "\n"); }
        if (iconPath != "") { sb.Append("Icon=" + iconPath + "\n"); }
        if (description != "") { sb.Append("Comment=" + description + "\n"); }
        sb.Append("Terminal=false\n");
        try {
            File.WriteAllText(path, sb.ToString());
        } catch (IOException e) {
            return false;
        }
        // 桌面环境只会启动可执行的 .desktop 文件。
        File.SetExecutable(path, true);
        return true;
    }

    // Desktop Entry 的 Name 默认用文件名（去掉 .desktop 后缀）。
    static string EntryName(string path) {
        string name = Path.GetFileName(path);
        if (name.EndsWith(".desktop")) {
            name = name.Substring(0, name.Length - 8);
        }
        if (name == "") { return "Shortcut"; }
        return name;
    }

    // Exec 行里带空白的可执行路径需要引号（规范 1.5 章）。
    static string QuoteArg(string s) {
        if (s.IndexOf(" ") < 0) { return s; }
        return "\"" + s.Replace("\"", "\\\"") + "\"";
    }

    // Exec 的第一个 token 是目标程序，其余是参数；首 token 允许带引号。
    static string ExecTarget(string exec) {
        if (exec == "") { return ""; }
        if (exec.StartsWith("\"")) {
            int close = exec.IndexOf("\"", 1);
            if (close > 0) { return exec.Substring(1, close - 1); }
            return exec.Substring(1, exec.Length - 1);
        }
        int space = exec.IndexOf(" ");
        if (space < 0) { return exec; }
        return exec.Substring(0, space);
    }

    static string ExecArguments(string exec) {
        string target = Shortcut.ExecTarget(exec);
        if (target == "") { return ""; }
        int used = target.Length;
        if (exec.StartsWith("\"")) { used = used + 2; }
        if (used >= exec.Length) { return ""; }
        return exec.Substring(used, exec.Length - used).Trim();
    }

    static string EntryValue(string text, string key) {
        List<string> lines = text.Split("\n");
        for (int i = 0; i < lines.Count; i = i + 1) {
            string line = lines[i].Trim();
            if (line.StartsWith(key + "=")) {
                return line.Substring(key.Length + 1, line.Length - key.Length - 1);
            }
        }
        return "";
    }
    #endif

    /// <summary>解析 .lnk 文件。快捷方式未定义的字段
    /// 返回空值（iconIndex 为 0）。</summary>
    static ShortcutInfo Read(string lnkPath) {
        ShortcutInfo info = new ShortcutInfo();
        #if WINDOWS
        Shortcut.InitCom();
        nint shell = Com.Create(Shortcut.ClsidShellLink(), Shortcut.IidShellLinkW());
        if (shell == 0) { return info; }
        nint persist = Com.Query(shell, Shortcut.IidPersistFile());
        if (persist == 0) { Com.Release(shell); return info; }
        nint wpath = Wide.Of(lnkPath);
        int hr = Com.Call2(persist, Shortcut.SlotLoad(), wpath, 0);   // STGM_READ
        Wide.Free(wpath);
        if (Com.Ok(hr)) {
            info.target = Shortcut.GetPath(shell);
            info.arguments = Shortcut.GetText(shell, Shortcut.SlotGetArguments());
            info.workingDir = Shortcut.GetText(shell, Shortcut.SlotGetWorkingDir());
            info.description = Shortcut.GetText(shell, Shortcut.SlotGetDescription());
            info.iconPath = Shortcut.GetIconPath(shell);
            info.iconIndex = Shortcut.GetIconIndex(shell);
        }
        Com.Release(persist);
        Com.Release(shell);
        #elif LINUX
        if (!File.Exists(lnkPath)) { return info; }
        string text = File.ReadAllText(lnkPath);
        string exec = Shortcut.EntryValue(text, "Exec");
        info.target = Shortcut.ExecTarget(exec);
        info.arguments = Shortcut.ExecArguments(exec);
        info.workingDir = Shortcut.EntryValue(text, "Path");
        info.description = Shortcut.EntryValue(text, "Comment");
        info.iconPath = Shortcut.EntryValue(text, "Icon");
        info.iconIndex = 0;
        #else
        throw new PlatformNotSupportedException(
            "Shortcut is not implemented on this platform");
        #endif
        return info;
    }

    #if WINDOWS
    // IShellLinkW::GetPath(LPWSTR, int cch, WIN32_FIND_DATAW*, DWORD flags).
    static string GetPath(nint shell) {
        nint buf = NativeMemory.Alloc(2048 * 2 + 2);
        int hr = Com.Call4(shell, Shortcut.SlotGetPath(), buf, 2048, 0, 0);
        string s = "";
        if (Com.Ok(hr)) { s = Wide.Read(buf); }
        NativeMemory.Free(buf);
        return s;
    }

    // 形状为 (LPWSTR, int cch) 的 getter。
    static string GetText(nint shell, int slot) {
        nint buf = NativeMemory.Alloc(2048 * 2 + 2);
        int hr = Com.Call2(shell, slot, buf, 2048);
        string s = "";
        if (Com.Ok(hr)) { s = Wide.Read(buf); }
        NativeMemory.Free(buf);
        return s;
    }

    static string GetIconPath(nint shell) {
        nint buf = NativeMemory.Alloc(2048 * 2 + 2);
        nint idx = NativeMemory.Alloc(4);
        int hr = Com.Call3(shell, Shortcut.SlotGetIconLocation(), buf, 2048, idx);
        string s = "";
        if (Com.Ok(hr)) { s = Wide.Read(buf); }
        NativeMemory.Free(idx);
        NativeMemory.Free(buf);
        return s;
    }

    static int GetIconIndex(nint shell) {
        nint buf = NativeMemory.Alloc(2048 * 2 + 2);
        nint idx = NativeMemory.Alloc(4);
        int hr = Com.Call3(shell, Shortcut.SlotGetIconLocation(), buf, 2048, idx);
        int v = 0;
        if (Com.Ok(hr)) { v = new Span<int>(idx, 1)[0]; }
        NativeMemory.Free(idx);
        NativeMemory.Free(buf);
        return v;
    }
    #endif
}
