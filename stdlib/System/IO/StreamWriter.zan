using System;

namespace System.IO;

// 基于 Stream 的缓冲文本写入：写入先在内存缓冲，满限额或调用 Flush / Close 时刷入底层流。
public class StreamWriter : IDisposable {
    Stream stream;
    bool owns;
    StringBuilder buf;
    int buffered;
    int limit;
    string newline;

    public StreamWriter() {
        this.stream = null;
        this.owns = false;
        this.buf = new StringBuilder(8192);
        this.buffered = 0;
        this.limit = 8192;
        this.newline = "\n";
    }

    // 写入现有流（不由本 writer 关闭）。
    public static StreamWriter Wrap(Stream s) {
        StreamWriter w = new StreamWriter();
        w.stream = s;
        return w;
    }

    // 创建或截断文件用于写入。
    public StreamWriter(string path) : this() {
        this.stream = FileStream.Open(path, "w+b");
        this.owns = true;
    }

    // 打开文件用于追加，不存在则创建。
    public static StreamWriter Append(string path) {
        StreamWriter w = new StreamWriter();
        w.stream = FileStream.Append(path);
        w.owns = true;
        return w;
    }

    // 正在写入的流。
    public Stream BaseStream() { return this.stream; }

    // 设置 WriteLine 追加的行终止符（默认
    // 为 "\n"）。
    public StreamWriter SetNewLine(string nl) {
        this.newline = nl;
        return this;
    }

    // 仅刷出内部缓冲到流，不强制触发底层设备 Flush；直接通过 BufferPtr 零拷贝写出并复用 StringBuilder 容量。
    private void DrainBuffer() {
        if (this.buffered > 0 && this.stream != null) {
            this.stream.WriteFromAll(this.buf.BufferPtr(), this.buf.Length);
            this.buf.Clear();
            this.buffered = 0;
        }
    }

    private async void DrainBufferAsync() {
        if (this.buffered > 0 && this.stream != null) {
            string data = this.buf.ToString();
            await this.stream.WriteAsync(data);
            this.buf.Clear();
            this.buffered = 0;
        }
    }

    // 追加文本。
    public StreamWriter Write(string text) {
        if (text != null && text.Length > 0) {
            this.buf.Append(text);
            this.buffered = this.buffered + text.Length;
            if (this.buffered >= this.limit) {
                this.DrainBuffer();
            }
        }
        return this;
    }

    // 追加文本，并附带行终止符（零临时拼接字符串分配）。
    public StreamWriter WriteLine(string text) {
        if (text != null && text.Length > 0) {
            this.buf.Append(text);
            this.buffered = this.buffered + text.Length;
        }
        if (this.newline.Length > 0) {
            this.buf.Append(this.newline);
            this.buffered = this.buffered + this.newline.Length;
        }
        if (this.buffered >= this.limit) {
            this.DrainBuffer();
        }
        return this;
    }

    // 仅追加一个行终止符。
    public StreamWriter WriteEmptyLine() {
        return this.Write(this.newline);
    }

    // 将所有缓冲内容交给流并刷新底层设备。
    public void Flush() {
        this.DrainBuffer();
        if (this.stream != null) {
            this.stream.Flush();
        }
    }

    // 异步将所有缓冲内容交给流并刷新底层设备。
    public async void FlushAsync() {
        await this.DrainBufferAsync();
        if (this.stream != null) {
            await this.stream.FlushAsync();
        }
    }

    // 异步追加文本。
    public async void WriteAsync(string text) {
        if (text != null && text.Length > 0) {
            this.buf.Append(text);
            this.buffered = this.buffered + text.Length;
            if (this.buffered >= this.limit) {
                await this.DrainBufferAsync();
            }
        }
    }

    // 异步追加文本并附带行终止符（零临时拼接字符串分配）。
    public async void WriteLineAsync(string text) {
        if (text != null && text.Length > 0) {
            this.buf.Append(text);
            this.buffered = this.buffered + text.Length;
        }
        if (this.newline.Length > 0) {
            this.buf.Append(this.newline);
            this.buffered = this.buffered + this.newline.Length;
        }
        if (this.buffered >= this.limit) {
            await this.DrainBufferAsync();
        }
    }

    // 刷新后，若本 writer 打开了底层
    // 流，则关闭该流。
    public void Close() {
        this.Flush();
        if (this.owns && this.stream != null) {
            this.stream.Close();
        }
        this.stream = null;
    }

    // 异步关闭并刷新。
    public async void CloseAsync() {
        await this.FlushAsync();
        if (this.owns && this.stream != null) {
            this.stream.Close();
        }
        this.stream = null;
    }

    // 释放 writer 占用的资源（实现 IDisposable，等同于 Close）。
    public void Dispose() {
        this.Close();
    }
}
