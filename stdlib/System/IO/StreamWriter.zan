using System;

namespace System.IO;

/// <summary>
/// Buffered text writing over a <see cref="Stream"/>: append lines to a file
/// without rewriting it whole, which is what File.AppendAllText costs today.
///
///   StreamWriter w = new StreamWriter("log.txt");
///   w.WriteLine("started");
///   w.Close();
///
/// Writes accumulate in memory and reach the stream when the buffer fills, on
/// <see cref="Flush"/>, or on <see cref="Close"/> -- so a writer must be
/// closed (or flushed) for its output to exist. Close closes the underlying
/// stream when this writer opened it.
/// </summary>
class StreamWriter {
    Stream stream;
    bool owns;
    StringBuilder buf;
    int buffered;
    int limit;
    string newline;

    StreamWriter() {
        this.stream = null;
        this.owns = false;
        this.buf = new StringBuilder();
        this.buffered = 0;
        this.limit = 8192;
        this.newline = "\n";
    }

    /// <summary>Writes to an existing stream (not closed by this writer).</summary>
    static StreamWriter Wrap(Stream s) {
        StreamWriter w = new StreamWriter();
        w.stream = s;
        return w;
    }

    /// <summary>Creates or truncates a file for writing.</summary>
    StreamWriter(string path) : this() {
        this.stream = FileStream.Open(path, "w+b");
        this.owns = true;
    }

    /// <summary>Opens a file for appending, creating it when missing.</summary>
    static StreamWriter Append(string path) {
        StreamWriter w = new StreamWriter();
        w.stream = FileStream.Append(path);
        w.owns = true;
        return w;
    }

    /// <summary>The stream being written.</summary>
    Stream BaseStream() { return this.stream; }

    /// <summary>Sets the line terminator WriteLine appends ("\n" by
    /// default).</summary>
    StreamWriter SetNewLine(string nl) {
        this.newline = nl;
        return this;
    }

    /// <summary>Appends text.</summary>
    StreamWriter Write(string text) {
        if (text.Length > 0) {
            this.buf.Append(text);
            this.buffered = this.buffered + text.Length;
            if (this.buffered >= this.limit) {
                this.Flush();
            }
        }
        return this;
    }

    /// <summary>Appends text followed by the line terminator.</summary>
    StreamWriter WriteLine(string text) {
        return this.Write(text + this.newline);
    }

    /// <summary>Appends just a line terminator.</summary>
    StreamWriter WriteEmptyLine() {
        return this.Write(this.newline);
    }

    /// <summary>Hands everything buffered to the stream.</summary>
    void Flush() {
        if (this.buffered > 0 && this.stream != null) {
            this.stream.Write(this.buf.ToString());
            this.buf = new StringBuilder();
            this.buffered = 0;
        }
        if (this.stream != null) {
            this.stream.Flush();
        }
    }

    /// <summary>Flushes, then closes the stream when this writer opened
    /// it.</summary>
    void Close() {
        this.Flush();
        if (this.owns && this.stream != null) {
            this.stream.Close();
        }
        this.stream = null;
    }
}
