using System;

namespace System.IO;

/// <summary>
/// 基于 <see cref="Stream"/> 的缓冲文本写入：可向文件追加行，
/// 而不必像 File.AppendAllText 那样重写整个文件（这正是它目前的代价）。
///
///   StreamWriter w = new StreamWriter("log.txt");
///   w.WriteLine("started");
///   w.Close();
///
/// 写入内容先在内存中累积，当缓冲区填满、
/// 调用 <see cref="Flush"/> 或 <see cref="Close"/> 时才真正写入流——因此必须
/// 关闭（或刷新）writer 后输出才会真正存在。若本 writer 打开了底层
/// 流，则 Close 会将其一并关闭。
/// </summary>
class StreamWriter {
    Stream stream;
    bool owns;
    StringBuilder buf;
    int buffered;
    int limit;
    string newline;

    StreamWriter() {
        this.stream = null;
        this.owns = false;
        this.buf = new StringBuilder();
        this.buffered = 0;
        this.limit = 8192;
        this.newline = "\n";
    }

    /// <summary>写入现有流（不由本 writer 关闭）。</summary>
    static StreamWriter Wrap(Stream s) {
        StreamWriter w = new StreamWriter();
        w.stream = s;
        return w;
    }

    /// <summary>创建或截断文件用于写入。</summary>
    StreamWriter(string path) : this() {
        this.stream = FileStream.Open(path, "w+b");
        this.owns = true;
    }

    /// <summary>打开文件用于追加，不存在则创建。</summary>
    static StreamWriter Append(string path) {
        StreamWriter w = new StreamWriter();
        w.stream = FileStream.Append(path);
        w.owns = true;
        return w;
    }

    /// <summary>正在写入的流。</summary>
    Stream BaseStream() { return this.stream; }

    /// <summary>设置 WriteLine 追加的行终止符（默认
    /// 为 "\n"）。</summary>
    StreamWriter SetNewLine(string nl) {
        this.newline = nl;
        return this;
    }

    /// <summary>追加文本。</summary>
    StreamWriter Write(string text) {
        if (text.Length > 0) {
            this.buf.Append(text);
            this.buffered = this.buffered + text.Length;
            if (this.buffered >= this.limit) {
                this.Flush();
            }
        }
        return this;
    }

    /// <summary>追加文本，并附带行终止符。</summary>
    StreamWriter WriteLine(string text) {
        return this.Write(text + this.newline);
    }

    /// <summary>仅追加一个行终止符。</summary>
    StreamWriter WriteEmptyLine() {
        return this.Write(this.newline);
    }

    /// <summary>将所有缓冲内容交给流。</summary>
    void Flush() {
        if (this.buffered > 0 && this.stream != null) {
            string data = this.buf.ToString();
            this.stream.Write(data);
            this.stream.Flush();
            this.buf = new StringBuilder();
            this.buffered = 0;
        } else if (this.stream != null) {
            this.stream.Flush();
        }
    }

    /// <summary>刷新后，若本 writer 打开了底层
    /// 流，则关闭该流。</summary>
    void Close() {
        this.Flush();
        if (this.owns && this.stream != null) {
            this.stream.Close();
        }
        this.stream = null;
    }
}
