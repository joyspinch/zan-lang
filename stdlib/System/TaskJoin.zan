using System;
using System.Threading;

namespace System;

// 扇出汇合：Task.WhenAll / Task.WhenAny 的标准库实现（parser 将接收者 Task 改写为 TaskJoin）。
// 快路径通过 Task.JoinNew/JoinBind/JoinWaitOwned 事件驱动唤醒；不可用时退回 Poll 轮询。
public class TaskJoin {
    // 轮询退避上限（毫秒）——仅 Poll 回退路径使用。
    public static int MAX_BACKOFF = 4;

    // Poll 回退路径先用 Task.Yield 轮询的圈数上限；耗尽后改用 Delay 指数退避。
    public static int YIELD_SPINS = 8;

    // 登记期间持有 entry。同步登记不会在循环回边让出后被取消。
    private static long BindJoin(List<long> handles, int n, int any) {
        long entry = Task.JoinNew(n, any);
        if (entry == 0) { return 0; }
        try {
            for (int i = 0; i < n; i = i + 1) {
                Task.JoinBind(entry, handles[i], i);
            }
        } catch {
            Task.JoinCancel(entry);
            throw;
        }
        return entry;
    }

    // 挂起直到 handles 全部完成并返回句柄数；空列表立即返回 0。
    public static async int WhenAll(List<long> handles) {
        if (handles == null) { return 0; }
        int n = handles.Count;
        if (n == 0) { return 0; }
        long entry = TaskJoin.BindJoin(handles, n, 0);
        if (entry == 0) { return await TaskJoin.WhenAllPoll(handles); }
        int r = await Task.JoinWaitOwned(entry);
        if (r == 2) { return await TaskJoin.WhenAllPoll(handles); }
        return n;
    }

    // 挂起直到 handles 中任一句柄完成并返回最小已完成下标；空列表返回 -1。
    public static async int WhenAny(List<long> handles) {
        if (handles == null) { return -1; }
        int n = handles.Count;
        if (n == 0) { return -1; }
        long entry = TaskJoin.BindJoin(handles, n, 1);
        if (entry == 0) { return await TaskJoin.WhenAnyPoll(handles); }
        int r = await Task.JoinWaitOwned(entry);
        if (r == 2) { return await TaskJoin.WhenAnyPoll(handles); }
        for (int i = 0; i < n; i = i + 1) {
            if (Task.IsDone(handles[i]) != 0) { return i; }
        }
        return -1;
    }

    // 轮询回退版 WhenAll：让渡/退避混合轮询。
    public static async int WhenAllPoll(List<long> handles) {
        if (handles == null) { return 0; }
        int n = handles.Count;
        if (n == 0) { return 0; }
        int spins = 0;
        int wait = 1;
        while (true) {
            bool pending = false;
            for (int i = 0; i < n; i = i + 1) {
                if (Task.IsDone(handles[i]) == 0) { pending = true; break; }
            }
            if (!pending) { return n; }
            if (spins < TaskJoin.YIELD_SPINS) {
                spins = spins + 1;
                await Task.Yield();
            } else {
                await Task.Delay(wait);
                int cap = TaskJoin.MAX_BACKOFF > 0 ? TaskJoin.MAX_BACKOFF : 1;
                if (wait < cap) { wait = wait > cap / 2 ? cap : wait * 2; }
            }
        }
        return n;
    }

    // 轮询回退版 WhenAny：让渡/退避混合轮询。
    public static async int WhenAnyPoll(List<long> handles) {
        if (handles == null) { return -1; }
        int n = handles.Count;
        if (n == 0) { return -1; }
        int spins = 0;
        int wait = 1;
        while (true) {
            for (int i = 0; i < n; i = i + 1) {
                if (Task.IsDone(handles[i]) != 0) { return i; }
            }
            if (spins < TaskJoin.YIELD_SPINS) {
                spins = spins + 1;
                await Task.Yield();
            } else {
                await Task.Delay(wait);
                int cap = TaskJoin.MAX_BACKOFF > 0 ? TaskJoin.MAX_BACKOFF : 1;
                if (wait < cap) { wait = wait > cap / 2 ? cap : wait * 2; }
            }
        }
        return -1;
    }

    // 协作式请求取消每个句柄（已完成句柄无副作用）。
    public static void CancelAll(List<long> handles) {
        if (handles == null) { return; }
        for (int i = 0; i < handles.Count; i = i + 1) {
            Task.Cancel(handles[i]);
        }
    }

    // `handles` 中已完成的句柄个数（不挂起）。
    public static int DoneCount(List<long> handles) {
        if (handles == null) { return 0; }
        int done = 0;
        for (int i = 0; i < handles.Count; i = i + 1) {
            if (Task.IsDone(handles[i]) != 0) { done = done + 1; }
        }
        return done;
    }

    private static async void DelayHelper(int ms) {
        await Task.Delay(ms);
    }

    // 为单个异步协程提供带超时的等待门面。
    // 至多等待 timeoutMs 毫秒：若任务在超时前完成，返回 true；
    // 若超时到期而任务未完成，自动调用 Task.Cancel(handle) 级联取消该任务并返回 false。
    // timeoutMs <= 0 时退化为永久等待。
    public static async bool WithTimeout(long handle, int timeoutMs) {
        if (handle == 0) { return true; }
        if (Task.IsDone(handle) != 0) { return true; }
        if (timeoutMs <= 0) {
            List<long> single = new List<long>();
            single.Add(handle);
            await TaskJoin.WhenAll(single);
            return true;
        }

        long timerH = Task.Spawn(TaskJoin.DelayHelper(timeoutMs));
        try {
            List<long> waitBoth = new List<long>();
            waitBoth.Add(handle);
            waitBoth.Add(timerH);
            int winner = await TaskJoin.WhenAny(waitBoth);
            if (winner == 0) {
                Task.Cancel(timerH);
                return true;
            } else {
                Task.Cancel(handle);
                return false;
            }
        } catch {
            Task.Cancel(timerH);
            throw;
        }
    }

    // 将托管取消令牌与底层协程句柄绑定。当 token 被取消时，自动触发 Task.Cancel(handle)。
    // 返回注册句柄以便外部注销。
    public static CancellationTokenRegistration AttachCancellation(long handle, CancellationToken token) {
        if (token == null || handle == 0) { return null; }
        return token.Register(() => {
            Task.Cancel(handle);
        });
    }
}
