using System;

namespace System;

/// <summary>
/// 扇出汇合（fan-out join）：<c>Task.WhenAll</c> / <c>Task.WhenAny</c> 的
/// 实现。两者不是编译器内建——解析器只把接收者 <c>Task</c> 改写为
/// <c>TaskJoin</c>（见 parser.c 的 desugar_task_join），因此汇合本身就是
/// 普通的 async 标准库代码，像其他被 await 的调用一样挂起与恢复。
///
///   List&lt;long&gt; hs = new List&lt;long&gt;();
///   hs.Add(Task.Spawn(Work(1)));
///   hs.Add(Task.Spawn(Work(2)));
///   int n = await Task.WhenAll(hs);      // 全部完成后返回句柄个数
///   int i = await Task.WhenAny(hs);      // 最先完成者的下标
///
/// 快路径是事件驱动：<c>Task.JoinNew/JoinBind/JoinWait</c> 把
/// 每个句柄登记进运行时的 join 表，汇合方挂起（Delay 形，不占线程也不
/// 轮询）；任一扇出协程被回收（untrack）时由完成路径精确唤醒——真正的
/// "完成即就绪"，唤醒延迟与批次规模无关。轮询实现保留为
/// <see cref="WhenAllPoll"/> / <see cref="WhenAnyPoll"/>：事件路径不可用
/// （宿主缺 ready 钩子或不在协程内）时的回退，行为与原逻辑一致。
/// </summary>
class TaskJoin {
    /// 轮询退避上限（毫秒）——仅 Poll 回退路径使用。
    static int MAX_BACKOFF = 4;

    /// Poll 回退路径：汇合前先用 Task.Yield 轮询的圈数上限。一次让渡 =
    /// 重排到就绪环尾，排到队首时本批任务恰好又跑过了一轮——轮询节奏与
    /// 排水节奏天然同步，快批次（亚毫秒扇出，服务端常态）在 1-2 圈内即
    /// 完成汇合，不再吃 Delay 的 1-4ms 睡眠窗口。预算耗尽说明批次是长
    /// 任务（IO/定时器），让渡会变成空转烧核，此时退回 Delay 指数退避。
    static int YIELD_SPINS = 8;

    /// <summary>挂起直到 `handles` 中每个句柄都已完成（或被取消），
    /// 返回汇合的句柄个数。空列表立即返回 0，已完成的批次
    /// 不会挂起。</summary>
    static async int WhenAll(List<long> handles) {
        int n = handles.Count;
        if (n == 0) { return 0; }
        long entry = Task.JoinNew(n, 0);
        for (int i = 0; i < n; i = i + 1) {
            Task.JoinBind(entry, handles[i], i);
        }
        int r = await Task.JoinWait(entry);
        Task.JoinCancel(entry);
        if (r == 2) { return await TaskJoin.WhenAllPoll(handles); }
        return n;
    }

    /// <summary>挂起直到 `handles` 中任一句柄完成，返回其下标；
    /// 同一轮里多个都已完成时返回最小下标。空列表返回 -1。
    /// 其余协程继续运行——需要一起收尾就先
    /// <see cref="CancelAll"/> 再 <see cref="WhenAll"/>。</summary>
    static async int WhenAny(List<long> handles) {
        int n = handles.Count;
        if (n == 0) { return -1; }
        long entry = Task.JoinNew(n, 1);
        for (int i = 0; i < n; i = i + 1) {
            Task.JoinBind(entry, handles[i], i);
        }
        int r = await Task.JoinWait(entry);
        Task.JoinCancel(entry);
        if (r == 2) { return await TaskJoin.WhenAnyPoll(handles); }
        for (int i = 0; i < n; i = i + 1) {
            if (Task.IsDone(handles[i]) != 0) { return i; }
        }
        return -1;
    }

    /// <summary>轮询回退版 <see cref="WhenAll"/>：让渡/退避混合轮询。
    /// 仅当事件路径不可用（无 ready 钩子/非协程上下文）时由
    /// <see cref="WhenAll"/> 自动退到此处。</summary>
    static async int WhenAllPoll(List<long> handles) {
        int n = handles.Count;
        if (n == 0) { return 0; }
        int spins = 0;
        int wait = 1;
        while (true) {
            bool pending = false;
            for (int i = 0; i < n; i = i + 1) {
                if (Task.IsDone(handles[i]) == 0) { pending = true; break; }
            }
            if (!pending) { return n; }
            if (spins < TaskJoin.YIELD_SPINS) {
                spins = spins + 1;
                await Task.Yield();
            } else {
                await Task.Delay(wait);
                if (wait < TaskJoin.MAX_BACKOFF) { wait = wait * 2; }
            }
        }
        return n;
    }

    /// <summary>轮询回退版 <see cref="WhenAny"/>。让渡/退避混合策略同
    /// <see cref="WhenAllPoll"/>。</summary>
    static async int WhenAnyPoll(List<long> handles) {
        int n = handles.Count;
        if (n == 0) { return -1; }
        int spins = 0;
        int wait = 1;
        while (true) {
            for (int i = 0; i < n; i = i + 1) {
                if (Task.IsDone(handles[i]) != 0) { return i; }
            }
            if (spins < TaskJoin.YIELD_SPINS) {
                spins = spins + 1;
                await Task.Yield();
            } else {
                await Task.Delay(wait);
                if (wait < TaskJoin.MAX_BACKOFF) { wait = wait * 2; }
            }
        }
        return -1;
    }

    /// <summary>请求取消每个句柄（已完成的句柄无副作用）。取消是
    /// 协作式的：协程在下一个挂起点观察到请求，因此取消后通常
    /// 紧跟一次 <c>WhenAll</c> 等它们真正收尾。</summary>
    static void CancelAll(List<long> handles) {
        for (int i = 0; i < handles.Count; i = i + 1) {
            Task.Cancel(handles[i]);
        }
    }

    /// <summary>`handles` 中已完成的句柄个数（不挂起）。</summary>
    static int DoneCount(List<long> handles) {
        int done = 0;
        for (int i = 0; i < handles.Count; i = i + 1) {
            if (Task.IsDone(handles[i]) != 0) { done = done + 1; }
        }
        return done;
    }
}
