using System;

namespace System;

// 当正则匹配用尽回溯步骤预算时抛出。病态模式
// （`(a+)+$` 之类）在某些输入上代价会爆炸，引擎宁可报错也不把
// 超时伪装成"无匹配"。
public class RegexBudgetException : Exception {
    // 以描述预算耗尽的消息构造。
    public RegexBudgetException(string message) {
        Message = message;
    }
}

// 当跨平台 API 在当前平台
// 没有实现时抛出。接口在所有平台都存在，因此代码各处都能编译运行；
// 不支持的那一半会显式报错，而不是静默
// 不做事。
