using System;

namespace System;

// 当 JSON 文本格式错误时抛出（JsonValue.Parse）。
public class JsonException : Exception {
    public JsonException() {
        Message = "JSON error";
    }

    // 以描述 JSON 格式错误的消息构造。
    public JsonException(string message) {
        Message = message;
    }
}

// 当正则匹配用尽回溯步骤预算时抛出。病态模式
// （`(a+)+$` 之类）在某些输入上代价会爆炸，引擎宁可报错也不把
// 超时伪装成"无匹配"。
