using System;

namespace System;

// 当实参格式不符合方法的参数约定（如 int.Parse 的字符串不是有效数字）时抛出的异常。
public class FormatException : Exception {
    public FormatException() {
        Message = "Input string was not in a correct format.";
    }

    public FormatException(string message) {
        Message = message;
    }
}
