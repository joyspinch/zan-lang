using System;

namespace System;

/// 128 位定点数（对齐 .NET System.Decimal 工业级高精度标准）
/// 尾数 96 位整数，支持 0..28 位小数精度，消除二进制浮点数的精度舍入误差，
/// 专用于金融核算、计量计费与严苛业务数值场景。
public class Decimal {
    public static readonly decimal Zero = 0m;
    public static readonly decimal One = 1m;
    public static readonly decimal MinusOne = -1m;
    public static readonly decimal MaxValue = 79228162514264337593543950335m;
    public static readonly decimal MinValue = -79228162514264337593543950335m;

    static extern bool __zan_decimal_parse(string str, long len, ref decimal outDec);
    static extern int __zan_decimal_to_string(ref decimal d, string buf, long bufSize);
    static extern long __zan_decimal_to_int64(ref decimal d);
    static extern double __zan_decimal_to_double(ref decimal d);
    static extern void __zan_decimal_from_int64(long val, ref decimal outDec);
    static extern void __zan_decimal_from_double(double val, ref decimal outDec);

    /// 将字符串解析为 decimal 数值。解析失败返回 0m。
    public static decimal Parse(string s) {
        if (s == null || s.Length == 0) {
            return 0m;
        }
        decimal result = 0m;
        if (!__zan_decimal_parse(s, (long)s.Length, ref result)) {
            return 0m;
        }
        return result;
    }

    /// 尝试将字符串解析为 decimal 数值。解析成功返回 true，否则返回 false。
    public static bool TryParse(string s, out decimal result) {
        result = 0m;
        if (s == null || s.Length == 0) {
            return false;
        }
        return __zan_decimal_parse(s, (long)s.Length, ref result);
    }

    /// 将 decimal 数值转换为格式化十进制字符串。
    public static string ToString(decimal d) {
        return "" + d;
    }

    /// 计算绝对值。
    public static decimal Abs(decimal d) {
        return d < 0m ? -d : d;
    }

    /// 返回两个 decimal 中较小的一个。
    public static decimal Min(decimal val1, decimal val2) {
        return val1 <= val2 ? val1 : val2;
    }

    /// 返回两个 decimal 中较大的一个。
    public static decimal Max(decimal val1, decimal val2) {
        return val1 >= val2 ? val1 : val2;
    }

    /// 截断为整数部分（向零取整）。
    public static decimal Truncate(decimal d) {
        // = (d - d%1m)/1m：余数带被除数符号，相减正好去掉小数部分；
        // 再除以 1m 借"精确商去尾零"把 scale 归一到 0（.NET 的 Truncate
        // 返回无尾零的整数，-15.75m → -15 而不是 -15.00）。
        // 曾借 __zan_decimal_to_int64 实现，to_int64 改成银行家舍入
        // （C# decimal→整数显式转换语义，A513）后被连带成舍入：
        // Truncate(15.75m)=16、Truncate(-15.75m)=-16，都是错的。
        return (d - d % 1m) / 1m;
    }

    /// 向上取整。
    public static decimal Ceiling(decimal d) {
        decimal tr = Truncate(d);
        if (d > tr) {
            return tr + 1m;
        }
        return tr;
    }

    /// 向下取整。
    public static decimal Floor(decimal d) {
        decimal tr = Truncate(d);
        if (d < tr) {
            return tr - 1m;
        }
        return tr;
    }

    /// 将 decimal 转换为 64 位有符号整数。
    public static long ToInt64(decimal d) {
        return __zan_decimal_to_int64(ref d);
    }

    /// 将 decimal 转换为 32 位有符号整数。
    public static int ToInt32(decimal d) {
        return (int)__zan_decimal_to_int64(ref d);
    }

    /// 将 decimal 转换为双精度浮点数。
    public static double ToDouble(decimal d) {
        return __zan_decimal_to_double(ref d);
    }

    /// 从 64 位有符号整数创建 decimal。
    public static decimal FromInt64(long val) {
        return (decimal)val;
    }

    /// 从双精度浮点数创建精确转换的 decimal。
    public static decimal FromDouble(double val) {
        decimal res = 0m;
        __zan_decimal_from_double(val, ref res);
        return res;
    }
}
