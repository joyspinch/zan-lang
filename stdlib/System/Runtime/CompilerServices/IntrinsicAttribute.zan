using System;

namespace System.Runtime.CompilerServices;

// 编译器内置原语/硬件指令特性标注。
// 标记于方法或类上，通知编译器检查器将该符号绑定为内置 Intrinsic，
// 防止被同名用户符号或重载意外冲突劫持。
public class IntrinsicAttribute {
    public string Name;

    public IntrinsicAttribute() {
        this.Name = "";
    }

    public IntrinsicAttribute(string name) {
        this.Name = name;
    }
}
