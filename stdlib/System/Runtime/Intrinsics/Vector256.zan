using System;

namespace System.Runtime.Intrinsics;

/// <summary>
/// 256 位硬件向量结构（对应 x86 YMM 寄存器 / AVX2 256 位寄存器）。
/// 包含 32 字节原始连续存储。
/// </summary>
public struct Vector256 {
    public long Low0;
    public long Low1;
    public long High0;
    public long High1;

    public static Vector256 Create(long l0, long l1, long h0, long h1) {
        Vector256 v = new Vector256();
        v.Low0 = l0;
        v.Low1 = l1;
        v.High0 = h0;
        v.High1 = h1;
        return v;
    }

    public static Vector256 Zero {
        get {
            Vector256 v = new Vector256();
            v.Low0 = 0;
            v.Low1 = 0;
            v.High0 = 0;
            v.High1 = 0;
            return v;
        }
    }
}
