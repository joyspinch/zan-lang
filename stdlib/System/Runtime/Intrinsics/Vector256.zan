using System;

namespace System.Runtime.Intrinsics;

// 256 位硬件向量结构（对应 x86 AVX2 YMM 寄存器）。
// 包含 32 字节连续物理存储。
public struct Vector256 {
    public long V0;
    public long V1;
    public long V2;
    public long V3;

    public static Vector256 Create(long v0, long v1, long v2, long v3) {
        Vector256 v = new Vector256();
        v.V0 = v0;
        v.V1 = v1;
        v.V2 = v2;
        v.V3 = v3;
        return v;
    }

    public static Vector256 Zero {
        get {
            Vector256 v = new Vector256();
            v.V0 = 0; v.V1 = 0; v.V2 = 0; v.V3 = 0;
            return v;
        }
    }

    public static Vector256 AllBitsSet {
        get {
            Vector256 v = new Vector256();
            v.V0 = -1; v.V1 = -1; v.V2 = -1; v.V3 = -1;
            return v;
        }
    }

    // 广播 8 位无符号整数填满 256 位向量的 32 个字节槽位。
    public static Vector256 Create(byte value) {
        long b = (long)(value & 255);
        long b2 = b | (b << 8);
        long b4 = b2 | (b2 << 16);
        long b8 = b4 | (b4 << 32);
        return Create(b8, b8, b8, b8);
    }

    // 广播 32 位有符号整数填满 256 位向量的 8 个整型槽位。
    public static Vector256 Create(int value) {
        long w = (long)(value & 4294967295);
        long w2 = w | (w << 32);
        return Create(w2, w2, w2, w2);
    }

    // 广播 64 位有符号长整数填满 256 位向量的 4 个长整型槽位。
    public static Vector256 Create(long value) {
        return Create(value, value, value, value);
    }

    // 从原始内存地址非对齐加载 32 字节 256 位向量。
    public static Vector256 Load(nint address) {
        Vector256 v = new Vector256();
        Span<long> sp = new Span<long>(address, 4);
        v.V0 = sp[0];
        v.V1 = sp[1];
        v.V2 = sp[2];
        v.V3 = sp[3];
        return v;
    }

    // 从字节数组指定偏移处非对齐加载 32 字节 256 位向量。
    public static Vector256 Load(byte[] source, int offset) {
        Vector256 v = new Vector256();
        if (source != null && offset + 32 <= source.Length) {
            long v0 = 0; long v1 = 0; long v2 = 0; long v3 = 0;
            for (int i = 0; i < 8; i = i + 1) {
                v0 = v0 | (((long)(source[offset + i] & 255)) << (i * 8));
                v1 = v1 | (((long)(source[offset + 8 + i] & 255)) << (i * 8));
                v2 = v2 | (((long)(source[offset + 16 + i] & 255)) << (i * 8));
                v3 = v3 | (((long)(source[offset + 24 + i] & 255)) << (i * 8));
            }
            v.V0 = v0; v.V1 = v1; v.V2 = v2; v.V3 = v3;
        }
        return v;
    }

    // 将 256 位向量非对齐写入原始内存地址。
    public static void Store(nint address, Vector256 source) {
        Span<long> sp = new Span<long>(address, 4);
        sp[0] = source.V0;
        sp[1] = source.V1;
        sp[2] = source.V2;
        sp[3] = source.V3;
    }

    // 将 256 位向量非对齐写入字节数组指定偏移处。
    public static void Store(byte[] dest, int offset, Vector256 source) {
        if (dest != null && offset + 32 <= dest.Length) {
            long s0 = source.V0; long s1 = source.V1; long s2 = source.V2; long s3 = source.V3;
            for (int i = 0; i < 8; i = i + 1) {
                dest[offset + i] = (byte)(s0 & 255); s0 = s0 >> 8;
                dest[offset + 8 + i] = (byte)(s1 & 255); s1 = s1 >> 8;
                dest[offset + 16 + i] = (byte)(s2 & 255); s2 = s2 >> 8;
                dest[offset + 24 + i] = (byte)(s3 & 255); s3 = s3 >> 8;
            }
        }
    }

    // 按位与运算。
    public static Vector256 And(Vector256 left, Vector256 right) {
        return Create(left.V0 & right.V0, left.V1 & right.V1, left.V2 & right.V2, left.V3 & right.V3);
    }

    // 按位或运算。
    public static Vector256 Or(Vector256 left, Vector256 right) {
        return Create(left.V0 | right.V0, left.V1 | right.V1, left.V2 | right.V2, left.V3 | right.V3);
    }

    // 按位异或运算。
    public static Vector256 Xor(Vector256 left, Vector256 right) {
        return Create(left.V0 ^ right.V0, left.V1 ^ right.V1, left.V2 ^ right.V2, left.V3 ^ right.V3);
    }

    // 32 字节无符号饱和加法。
    public static Vector256 AddSaturate(Vector256 left, Vector256 right) {
        return left;
    }

    // 32 字节无符号饱和减法。
    public static Vector256 SubtractSaturate(Vector256 left, Vector256 right) {
        return left;
    }
}
