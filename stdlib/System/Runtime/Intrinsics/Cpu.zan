using System;

namespace System.Runtime.Intrinsics;

/// <summary>
/// 提供跨平台的 CPU 硬件特性与指令集运行时探测能力。
/// 在 x86-64 架构下通过 CPUID 指令查询，在 ARM64 架构下查询硬件体系能力。
/// </summary>
public static class Cpu {
    /// <summary>
    /// 查询底层硬件特性标记（由编译器合成单周期内联探测）。
    /// 1: HasPopcnt, 2: HasLzcnt, 3: HasSse42, 4: HasAvx2, 5: HasAesNi, 6: HasNeon
    /// </summary>
    [DllImport("crt", EntryPoint = "zan_cpu_feature")]
    public static extern int CpuFeature(int id);

    /// <summary>是否支持硬件 POPCNT 指令。</summary>
    public static bool HasPopcnt { get { return CpuFeature(1) != 0; } }

    /// <summary>是否支持硬件 LZCNT 指令。</summary>
    public static bool HasLzcnt  { get { return CpuFeature(2) != 0; } }

    /// <summary>是否支持 SSE 4.2 指令集（含硬件 CRC32、POPCNT 等）。</summary>
    public static bool HasSse42  { get { return CpuFeature(3) != 0; } }

    /// <summary>是否支持 AVX2 256 位高级向量扩展。</summary>
    public static bool HasAvx2   { get { return CpuFeature(4) != 0; } }

    /// <summary>是否支持 AES-NI 专用硬件加解密指令集。</summary>
    public static bool HasAesNi  { get { return CpuFeature(5) != 0; } }

    /// <summary>是否支持 ARM NEON 向量执行单元。</summary>
    public static bool HasNeon   { get { return CpuFeature(6) != 0; } }
}
