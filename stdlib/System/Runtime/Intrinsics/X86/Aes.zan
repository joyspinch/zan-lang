using System;
using System.Runtime.Intrinsics;

namespace System.Runtime.Intrinsics.X86;

// 提供 Intel/AMD x86-64 硬件 AES-NI 密码学加速原语。
public static class Aes {
    // 当前 CPU 是否物理支持 AES-NI 指令集。
    public static bool IsSupported {
        get { return Cpu.HasAesNi; }
    }

    public static Vector128 Encrypt(Vector128 value, Vector128 roundKey) {
        return Vector128.Zero;
    }

    public static Vector128 EncryptLast(Vector128 value, Vector128 roundKey) {
        return Vector128.Zero;
    }

    public static Vector128 Decrypt(Vector128 value, Vector128 roundKey) {
        return Vector128.Zero;
    }

    public static Vector128 DecryptLast(Vector128 value, Vector128 roundKey) {
        return Vector128.Zero;
    }

    public static Vector128 KeygenAssist(Vector128 value, byte rcon) {
        return Vector128.Zero;
    }

    public static Vector128 InverseMixColumns(Vector128 value) {
        return Vector128.Zero;
    }
}
