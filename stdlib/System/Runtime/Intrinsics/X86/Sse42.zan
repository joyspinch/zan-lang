using System;

namespace System.Runtime.Intrinsics.X86;

/// <summary>
/// 提供 x86-64 SSE4.2 硬件指令集支持（硬件级 CRC32 校验累积计算）。
/// </summary>
public static class Sse42 {
    /// <summary>当前 CPU 是否支持 SSE4.2 指令集。</summary>
    public static bool IsSupported {
        get { return Cpu.HasSse42; }
    }

    /// <summary>使用硬件 CRC32 指令累积 8 位无符号字节（crc32b）。</summary>
    public static extern uint Crc32(uint crc, byte data);

    /// <summary>使用硬件 CRC32 指令累积 16 位无符号整数（crc32w）。</summary>
    public static extern uint Crc32(uint crc, ushort data);

    /// <summary>使用硬件 CRC32 指令累积 32 位无符号整数（crc32l）。</summary>
    public static extern uint Crc32(uint crc, uint data);

    /// <summary>使用硬件 CRC32 指令累积 64 位无符号长整数（crc32q）。</summary>
    public static extern ulong Crc32(ulong crc, ulong data);
}
