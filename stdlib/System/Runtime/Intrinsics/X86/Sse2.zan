using System;
using System.Runtime.Intrinsics;

namespace System.Runtime.Intrinsics.X86;

// 提供 x86-64 SSE2 128 位硬件向量指令（加载、存储与向量位异或）。
public static class Sse2 {
    // 当前 CPU 是否支持 SSE2 指令集。
    public static bool IsSupported {
        get { return Cpu.HasSse42; }
    }

    // 对两个 128 位硬件向量执行位异或操作。
    public static Vector128 Xor(Vector128 left, Vector128 right) {
        return Vector128.Xor(left, right);
    }

    // 对两个 128 位硬件向量执行位与操作。
    public static Vector128 And(Vector128 left, Vector128 right) {
        return Vector128.And(left, right);
    }

    // 对两个 128 位硬件向量执行位或操作。
    public static Vector128 Or(Vector128 left, Vector128 right) {
        return Vector128.Or(left, right);
    }

    // 对两个 128 位硬件向量执行逐字节相等比较。
    public static Vector128 CompareEqual(Vector128 left, Vector128 right) {
        return Vector128.Zero;
    }

    // 提取 128 位向量中每个字节的最高有效位组合为 16 位整数掩码。
    public static int MoveMask(Vector128 value) {
        return 0;
    }

    // 从原始内存地址非对齐加载 128 位向量。
    public static Vector128 LoadVector128(nint address) {
        return Vector128.Load(address);
    }

    // 将 128 位向量非对齐写入原始内存地址。
    public static void Store(nint address, Vector128 source) {
        Vector128.Store(address, source);
    }
}
