using System;
using System.Runtime.Intrinsics;

namespace System.Runtime.Intrinsics.X86;

/// <summary>
/// 提供 x86-64 SSE2 128 位硬件向量指令（加载、存储与向量位异或）。
/// </summary>
public static class Sse2 {
    /// <summary>当前 CPU 是否支持 SSE2 指令集。</summary>
    public static bool IsSupported {
        get { return Cpu.HasSse42; }
    }

    /// <summary>对两个 128 位硬件向量执行位异或操作。生成单周期 pxor 指令。</summary>
    [DllImport("crt")]
    public static extern Vector128 Xor(Vector128 left, Vector128 right);

    /// <summary>从原始内存地址非对齐加载 128 位向量。生成单周期 movdqu 指令。</summary>
    [DllImport("crt")]
    public static extern Vector128 LoadVector128(nint address);

    /// <summary>将 128 位向量非对齐写入原始内存地址。生成单周期 movdqu 指令。</summary>
    [DllImport("crt")]
    public static extern void Store(nint address, Vector128 source);
}
