using System;

namespace System.Runtime.Intrinsics;

/// <summary>
/// 128 位硬件向量结构（对应 x86 XMM 寄存器 / ARM NEON 128 位寄存器）。
/// 包含 16 字节原始连续存储，由编译器硬件内建指令直接操纵。
/// </summary>
public struct Vector128 {
    public long Low;
    public long High;

    public static Vector128 Create(long low, long high) {
        Vector128 v = new Vector128();
        v.Low = low;
        v.High = high;
        return v;
    }

    public static Vector128 Zero {
        get {
            Vector128 v = new Vector128();
            v.Low = 0;
            v.High = 0;
            return v;
        }
    }
}
