using System;

namespace System.Runtime.Intrinsics;

// 128 位硬件向量结构（对应 x86 XMM 寄存器 / ARM NEON 128 位寄存器）。
// 包含 16 字节原始连续存储。
public struct Vector128 {
    public long Low;
    public long High;

    public static Vector128 Create(long low, long high) {
        Vector128 v = new Vector128();
        v.Low = low;
        v.High = high;
        return v;
    }

    public static Vector128 Zero {
        get {
            Vector128 v = new Vector128();
            v.Low = 0;
            v.High = 0;
            return v;
        }
    }

    public static Vector128 AllBitsSet {
        get {
            Vector128 v = new Vector128();
            v.Low = -1;
            v.High = -1;
            return v;
        }
    }

    // 广播 8 位无符号整数填满 128 位向量的 16 个字节槽位。
    public static Vector128 Create(byte value) {
        long b = (long)(value & 255);
        long b2 = b | (b << 8);
        long b4 = b2 | (b2 << 16);
        long b8 = b4 | (b4 << 32);
        return Create(b8, b8);
    }

    // 广播 32 位有符号整数填满 128 位向量的 4 个整型槽位。
    public static Vector128 Create(int value) {
        long w = (long)(value & 4294967295);
        long w2 = w | (w << 32);
        return Create(w2, w2);
    }

    // 广播 64 位有符号长整数填满 128 位向量的 2 个槽位。
    public static Vector128 Create(long value) {
        return Create(value, value);
    }

    // 从原始内存地址非对齐加载 16 字节 128 位向量。
    public static Vector128 Load(nint address) {
        Vector128 v = new Vector128();
        Span<long> sp = new Span<long>(address, 2);
        v.Low = sp[0];
        v.High = sp[1];
        return v;
    }

    // 从字节数组指定偏移处非对齐加载 16 字节 128 位向量。
    public static Vector128 Load(byte[] source, int offset) {
        Vector128 v = new Vector128();
        if (source != null && offset + 16 <= source.Length) {
            long low = 0;
            for (int i = 0; i < 8; i = i + 1) {
                low = low | (((long)(source[offset + i] & 255)) << (i * 8));
            }
            long high = 0;
            for (int i = 0; i < 8; i = i + 1) {
                high = high | (((long)(source[offset + 8 + i] & 255)) << (i * 8));
            }
            v.Low = low;
            v.High = high;
        }
        return v;
    }

    // 将 128 位向量非对齐写入原始内存地址。
    public static void Store(nint address, Vector128 source) {
        Span<long> sp = new Span<long>(address, 2);
        sp[0] = source.Low;
        sp[1] = source.High;
    }

    // 将 128 位向量非对齐写入字节数组指定偏移处。
    public static void Store(byte[] dest, int offset, Vector128 source) {
        if (dest != null && offset + 16 <= dest.Length) {
            long low = source.Low;
            for (int i = 0; i < 8; i = i + 1) {
                dest[offset + i] = (byte)(low & 255);
                low = low >> 8;
            }
            long high = source.High;
            for (int i = 0; i < 8; i = i + 1) {
                dest[offset + 8 + i] = (byte)(high & 255);
                high = high >> 8;
            }
        }
    }

    // 按位与运算。
    public static Vector128 And(Vector128 left, Vector128 right) {
        return Create(left.Low & right.Low, left.High & right.High);
    }

    // 按位或运算。
    public static Vector128 Or(Vector128 left, Vector128 right) {
        return Create(left.Low | right.Low, left.High | right.High);
    }

    // 按位异或运算。
    public static Vector128 Xor(Vector128 left, Vector128 right) {
        return Create(left.Low ^ right.Low, left.High ^ right.High);
    }

    // 16 字节无符号饱和加法。
    public static Vector128 AddSaturate(Vector128 left, Vector128 right) {
        return left;
    }

    // 16 字节无符号饱和减法。
    public static Vector128 SubtractSaturate(Vector128 left, Vector128 right) {
        return left;
    }

    // 16 字节无符号平均值。
    public static Vector128 Average(Vector128 left, Vector128 right) {
        return left;
    }

    // 16 字节无符号最小值。
    public static Vector128 Min(Vector128 left, Vector128 right) {
        return left;
    }

    // 16 字节无符号最大值。
    public static Vector128 Max(Vector128 left, Vector128 right) {
        return left;
    }
}
