using System;
using System.Platform;

namespace System;

/* 位置说明：本类曾放在 `System.Security.Cryptography`，而 `Guid` 需要它取随机
 * 字节——`using X.Y` 按目录整体拉入，于是 `using System;`（几乎每个程序都写）
 * 都要把整个 Cryptography 命名空间的 20 个文件编进来。它本身只有 54 行、只依赖
 * `System`，是"向 OS 要密码学安全字节"这一条原语，放在根命名空间即可；
 * Cryptography 里的消费者都带 `using System;`，引用方式不变。 */

// 跨平台的加密安全随机字节。
// 底层 CSPRNG 系统调用下沉至平台抽象层（Pal.Environment.GetRandomBytes），跨平台统一。
public class RandomNumberGenerator {
    // 用安全随机数据填充 buf 的前 n 字节。
    // 返回实际写入的字节数（成功时为 n，失败时更少）。
    public static int Fill(string buf, int n) {
        return Pal.Environment.GetRandomBytes(buf, n);
    }

    // 分配含 n 个安全随机字节的缓冲区（n+1 字节，末尾的
    // 零字节使其可在期望 NUL 结尾字符串的场景中使用）。
    // 若系统 CSPRNG 无法提供 n 字节，则返回 null。
    public static byte[] GetBytes(int n) {
        if (n <= 0) { return null; }
        byte[] b = new byte[n + 1];
        int got = Fill(b, n);
        if (got < n) { return null; }
        return b;
    }
}
