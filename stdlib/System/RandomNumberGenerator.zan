using System;

namespace System;

/* 位置说明：本类曾放在 `System.Security.Cryptography`，而 `Guid` 需要它取随机
 * 字节——`using X.Y` 按目录整体拉入，于是 `using System;`（几乎每个程序都写）
 * 都要把整个 Cryptography 命名空间的 20 个文件编进来。它本身只有 54 行、只依赖
 * `System`，是"向 OS 要密码学安全字节"这一条原语，放在根命名空间即可；
 * Cryptography 里的消费者都带 `using System;`，引用方式不变。 */

// 跨平台的加密安全随机字节。
// Windows 使用系统 CSPRNG（RtlGenRandom / SystemFunction036）；POSIX 从
// /dev/urandom 读取（Linux、macOS、BSD）；wasm32 走 WASI preview1 的
// random_get（宿主——浏览器/Node——注入的 CSPRNG；wasm 沙箱里没有
// /dev/urandom，必须走宿主调用）。无弱回退：请求
// N 字节却得到更少字节的调用方会收到明确失败（null / 字节数不足），
// 绝不会返回可预测或未初始化的数据。
class RandomNumberGenerator {
    #if WINDOWS
    [DllImport("advapi32")]
    static extern int SystemFunction036(string buf, int len);
    #elif WASM32
    // 系统底层交互与数据流转契约
    // 本仓 build/wasm32/libc.a）不导出裸 random_get：预览一系统调用的
    // 导入桩按 __wasi_<name> 命名（getentropy.o 即经它取随机），
    // EntryPoint 写全名，wasm-ld 才在最终模块里生成这条宿主导入。
    [DllImport("crt", EntryPoint = "__wasi_random_get")]
    static extern int WasiRandomGet(string buf, int len);
    #else
    // 基于 FILE* 的 I/O 能完整保留 64 位返回值（指针 / size_t），
    // 避免 open()/read() 返回值被截断为 32 位 int 的风险。
    [DllImport("crt", EntryPoint = "fopen")]
    static extern nint urandOpen(string path, string mode);

    [DllImport("crt", EntryPoint = "fread")]
    static extern long urandRead(string buf, long size, long count, nint fp);

    [DllImport("crt", EntryPoint = "fclose")]
    static extern int urandClose(nint fp);
    #endif

    // 用安全随机数据填充 buf 的前 n 字节。
    // 返回实际写入的字节数（成功时为 n，失败时更少）。
    static int Fill(string buf, int n) {
        if (n <= 0) { return 0; }
        #if WINDOWS
        int ok = SystemFunction036(buf, n);
        if (ok == 0) { return 0; }
        return n;
        #elif WASM32
        // errno != 0 一律按失败处理：绝不能把未填充的缓冲区当随机数
        // 返回（无弱回退）。
        if (WasiRandomGet(buf, n) != 0) { return 0; }
        return n;
        #else
        nint fp = urandOpen("/dev/urandom", "rb");
        if (fp == 0) { return 0; }
        long got = urandRead(buf, 1, n, fp);
        urandClose(fp);
        return (int)got;
        #endif
    }

    // 分配含 n 个安全随机字节的缓冲区（n+1 字节，末尾的
    // 零字节使其可在期望 NUL 结尾字符串的场景中使用）。
    // 若系统 CSPRNG 无法提供 n 字节，则返回 null。
    static byte[] GetBytes(int n) {
        if (n <= 0) { return null; }
        byte[] b = new byte[n + 1];
        int got = Fill(b, n);
        if (got < n) { return null; }
        return b;
    }
}
