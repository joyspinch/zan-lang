using System;
using System.IO;
using System.Security.Cryptography;

namespace System.Resources;

/// <summary>一个已入队的 pack 条目：名称、原始字节负载与
/// 负载长度。用一个实体代替并行的 name/data/len 列表。</summary>
class ResourceEntry {
    string name;
    string data;
    int len;

    /// 构造条目。
    ResourceEntry(string name, string data, int len) {
        this.name = name;
        this.data = data;
        this.len = len;
    }
}

/// <summary>加密资源包（.zrp）写入器。
///
/// 布局（私有格式，没有主密钥则完全不可读）：
///   [0..3]   magic（4 个不透明字节，非 ASCII）
///   [4]      version（混淆后的版本号）
///   [5..20]  packId —— 16 个随机字节，每个 pack 唯一
///   [21..32] index 的 IV（12 字节）
///   [33..48] index 的 GCM tag（16 字节）
///   [49..52] index 密文长度（BE32）
///   [53..56] 签名长度（BE32，0 表示无签名）
///   [...]    index 密文，然后是 RSA 签名，最后是各条目负载
///
/// index（条目表）由主密钥与 packId 经 HKDF 派生的密钥做 AES-256-GCM 加密，
/// 再签名（RSASSA-PKCS1-v1_5 / SHA-256），
/// 因此即使攻击者拿到主密钥、却拿不到私钥，
/// 重打包或调换条目的文件也会被拒绝。
/// 条目名只存截断的 SHA-256 哈希；每个条目
/// 用各自 HKDF 派生的密钥加密，因此一个条目密钥泄露
/// 不会波及其他条目或主密钥。</summary>
class ResourcePackWriter {
    [DllImport("crt")] static extern nint fopen(string path, string mode);
    [DllImport("crt")] static extern long fwrite(string buf, long size, long count, nint fp);
    [DllImport("crt")] static extern int fclose(nint fp);

    List<ResourceEntry> entries;

    /// 构造写入器（空 pack，条目经 Add 入队）。
    ResourcePackWriter() {
        this.entries = new List<ResourceEntry>();
    }

    /// <summary>入队一个条目。<paramref name="data"/> 是原始字节，
    /// 长度显式传入（Zan 字符串就是字节缓冲区）。</summary>
    void Add(string name, string data, int len) {
        this.entries.Add(new ResourceEntry(name, data, len));
    }

    /// <summary>写入 pack。<paramref name="masterKey"/> 为 32 字节。
    /// <paramref name="nHex"/>/<paramref name="dHex"/> 是 RSA 模数与
    /// 私钥指数（十六进制），用于 index 签名；传 null 可跳过签名。
    /// 成功返回 true。</summary>
    bool Write(string path, string masterKey, string nHex, string dHex) {
        int count = this.entries.Count;
        int sigLen = 0;
        byte[] nBuf = null;
        byte[] dBuf = null;
        if (nHex != null && dHex != null) {
            nBuf = Hex.Decode(nHex);
            dBuf = Hex.Decode(dHex);
            sigLen = nHex.Length / 2;
        }

        byte[] packId = RandomNumberGenerator.GetBytes(16);
        byte[] idxIv = RandomNumberGenerator.GetBytes(12);
        if (packId == null || idxIv == null) { return false; }

        int idxLen = 4 + 61 * count;
        int dataStart = 57 + idxLen + sigLen;

        // 在规划负载偏移的同时构建明文 index。
        byte[] idx = new byte[idxLen + 1];
        ResourcePack.storeBE32(idx, 0, count);
        List<byte[]> ivs = new List<byte[]>();
        int off = dataStart;
        int i = 0;
        for (; i < count; i = i + 1) {
            byte[] nh = ResourcePack.nameHash(this.entries[i].name);
            byte[] iv = RandomNumberGenerator.GetBytes(12);
            if (iv == null) { return false; }
            ivs.Add(iv);
            int rec = 4 + 61 * i;
            int j = 0;
            for (; j < 16; j = j + 1) { idx[rec + j] = nh[j]; }
            ResourcePack.storeBE64(idx, rec + 16, off);
            ResourcePack.storeBE64(idx, rec + 24, this.entries[i].len);
            idx[rec + 32] = 0;  // 标志位（bit0 保留给压缩）
            j = 0;
            while (j < 12) { idx[rec + 33 + j] = iv[j]; j = j + 1; }
            // tag 在下方加密后写入
            off = off + this.entries[i].len;
        }

        // 用各自派生的密钥加密每个负载。
        List<byte[]> cts = new List<byte[]>();
        i = 0;
        while (i < count) {
            byte[] nh = ResourcePack.nameHash(this.entries[i].name);
            byte[] ek = ResourcePack.entryKey(masterKey, packId, nh);
            byte[] tag = new byte[17];
            byte[] ct = AesGcm.Encrypt(ek, 32, ivs[i], nh, 16, this.entries[i].data, this.entries[i].len, tag);
            cts.Add(ct);
            int rec = 4 + 61 * i;
            for (int j = 0; j < 16; j = j + 1) { idx[rec + 45 + j] = tag[j]; }
            i = i + 1;
        }

        // 先对明文 index 签名，再加密。
        byte[] sig = null;
        if (sigLen > 0) {
            sig = Rsa.SignPkcs1Sha256(idx, idxLen, nBuf, sigLen, dBuf, sigLen);
        }

        byte[] hdr = new byte[58];
        ResourcePack.writeMagic(hdr);
        i = 0;
        while (i < 16) { hdr[5 + i] = packId[i]; i = i + 1; }
        i = 0;
        while (i < 12) { hdr[21 + i] = idxIv[i]; i = i + 1; }
        ResourcePack.storeBE32(hdr, 49, idxLen);
        ResourcePack.storeBE32(hdr, 53, sigLen);

        byte[] ik = ResourcePack.indexKey(masterKey, packId);
        byte[] idxTag = new byte[17];
        byte[] idxCt = AesGcm.Encrypt(ik, 32, idxIv, hdr, 21, idx, idxLen, idxTag);
        i = 0;
        while (i < 16) { hdr[33 + i] = idxTag[i]; i = i + 1; }

        nint fp = fopen(path, "wb");
        if (fp == 0) { return false; }
        fwrite(hdr, 1, 57, fp);
        fwrite(idxCt, 1, idxLen, fp);
        if (sigLen > 0) { fwrite(sig, 1, sigLen, fp); }
        i = 0;
        while (i < count) { fwrite(cts[i], 1, this.entries[i].len, fp); i = i + 1; }
        fclose(fp);
        return true;
    }
}

/// <summary>一条已解析的 index 记录：条目名哈希、负载偏移
/// 与大小，以及每条目 IV 和 GCM tag。用一个实体代替五个
/// 按 index 对齐的并行列表。</summary>
class PackIndexEntry {
    byte[] hash;   // 名称的 16 字节截断 SHA-256
    int off;       // 文件内的负载偏移
    int size;      // 负载字节长度
    byte[] iv;     // 每条目 AES-GCM IV
    byte[] tag;    // 每条目 AES-GCM tag

    /// 构造 index 记录。
    PackIndexEntry(byte[] hash, int off, int size, byte[] iv, byte[] tag) {
        this.hash = hash;
        this.off = off;
        this.size = size;
        this.iv = iv;
        this.tag = tag;
    }
}

/// <summary>加密资源包读取器。格式见 ResourcePackWriter。
/// Open() 在提供条目前先校验 index 签名与真实性；
/// Read() 会重新派生每条目密钥，并通过 GCM tag 拒绝
/// 被篡改的负载。</summary>
class ResourcePack {
    string path;
    string masterKey;
    byte[] packId;
    int count;
    List<PackIndexEntry> index;

    // ---- 共享辅助（writer 同样使用）----

    /// 写入 4 字节不透明 magic 与混淆后的版本字节（`1 ^ 165`）。
    static void writeMagic(byte[] hdr) {
        // 不透明的非 ASCII magic + 混淆后的版本字节
        hdr[0] = 199; hdr[1] = 17; hdr[2] = 158; hdr[3] = 66;
        hdr[4] = (byte)(1 ^ 165);
    }

    /// 校验头部 magic 与版本字节。
    static bool checkMagic(string hdr) {
        if ((hdr[0] & 255) != 199) { return false; }
        if ((hdr[1] & 255) != 17) { return false; }
        if ((hdr[2] & 255) != 158) { return false; }
        if ((hdr[3] & 255) != 66) { return false; }
        return ((hdr[4] & 255) ^ 165) == 1;
    }

    /// 按大端序写入 32 位整数。
    static void storeBE32(byte[] buf, int off, int v) {
        buf[off] = (byte)((v >> 24) & 255);
        buf[off + 1] = (byte)((v >> 16) & 255);
        buf[off + 2] = (byte)((v >> 8) & 255);
        buf[off + 3] = (byte)(v & 255);
    }

    /// 按大端序读取 32 位整数。
    static int loadBE32(string buf, int off) {
        return ((buf[off] & 255) << 24) | ((buf[off + 1] & 255) << 16)
             | ((buf[off + 2] & 255) << 8) | (buf[off + 3] & 255);
    }

    /// 按大端序写入 64 位整数。
    static void storeBE64(byte[] buf, int off, int v) {
        for (int i = 0; i < 8; i = i + 1) { buf[off + i] = (byte)(Bits.Shr64(v, 8 * (7 - i)) & 255); }
    }

    /// 按大端序读取 8 字节为整数。
    static int loadBE64(string buf, int off) {
        int v = 0;
        for (int i = 0; i < 8; i = i + 1) { v = (v << 8) | (buf[off + i] & 255); }
        return v;
    }

    /// <summary>条目名的截断 SHA-256（16 字节）。pack 中只存
    /// 这个哈希，因此无法从文件列出条目名。</summary>
    static byte[] nameHash(string name) {
        byte[] h = Sha256.Hash(name, name.Length);
        byte[] t = new byte[17];
        for (int i = 0; i < 16; i = i + 1) { t[i] = h[i]; }
        return t;
    }

    /// index 加密密钥：HKDF(salt=packId, ikm=masterKey, info="ZRIX")，32 字节。
    static byte[] indexKey(string masterKey, byte[] packId) {
        return Hkdf.Derive(packId, 16, masterKey, 32, "ZRIX", 4, 32);
    }

    /// 条目密钥：HKDF(salt=packId, ikm=masterKey, info="ZREN"+名称哈希)，
    /// 32 字节；每条目独立，单个条目密钥泄露不波及其他条目。
    static byte[] entryKey(string masterKey, byte[] packId, byte[] nh) {
        byte[] info = new byte[21];
        info[0] = 90; info[1] = 82; info[2] = 69; info[3] = 78;  // "ZREN"
        for (int i = 0; i < 16; i = i + 1) { info[4 + i] = nh[i]; }
        return Hkdf.Derive(packId, 16, masterKey, 32, info, 20, 32);
    }

    /// <summary>由两份 XOR 分片重组密钥，使真实密钥永不
    /// 以单一字面量出现在二进制中。</summary>
    static byte[] MixKey(string a, string b, int len) {
        byte[] k = new byte[len + 1];
        for (int i = 0; i < len; i = i + 1) { k[i] = (byte)((a[i] & 255) ^ (b[i] & 255)); }
        return k;
    }

    /// <summary>打开 pack 并认证其 index。<paramref name="nHex"/>
    /// 与 <paramref name="eHex"/> 是 RSA 公钥模数/指数（十六进制），
    /// 用于校验 index 签名；传 null 则接受未签名的 pack。
    /// <paramref name="err"/>[0]：0 正常，1 IO/magic 错误，2 认证失败，3 签名错误。</summary>
    static ResourcePack Open(string path, string masterKey, string nHex, string eHex, List<int> err) {
        err[0] = 1;
        int fsz = File.GetSize(path);
        if (fsz < 57) { return null; }
        byte[] hdr = File.ReadBytes(path, 0, 57);
        if (!checkMagic(hdr)) { return null; }
        int idxLen = loadBE32(hdr, 49);
        int sigLen = loadBE32(hdr, 53);
        if (idxLen < 4 || 57 + idxLen + sigLen > fsz) { return null; }

        byte[] packId = new byte[17];
        byte[] idxIv = new byte[13];
        byte[] idxTag = new byte[17];
        int i = 0;
        for (; i < 16; i = i + 1) { packId[i] = hdr[5 + i]; }
        i = 0;
        while (i < 12) { idxIv[i] = hdr[21 + i]; i = i + 1; }
        i = 0;
        while (i < 16) { idxTag[i] = hdr[33 + i]; i = i + 1; }

        byte[] idxCt = File.ReadBytes(path, 57, idxLen);
        byte[] ik = indexKey(masterKey, packId);
        List<int> ok = new List<int>(); ok.Add(0);
        byte[] idx = AesGcm.Decrypt(ik, 32, idxIv, hdr, 21, idxCt, idxLen, idxTag, ok);
        if (ok[0] == 0) {
            err[0] = 2;
            return null;
        }

        if (nHex != null && eHex != null) {
            bool sigOk = false;
            if (sigLen > 0) {
                byte[] sig = File.ReadBytes(path, 57 + idxLen, sigLen);
                byte[] nBuf = Hex.Decode(nHex);
                byte[] eBuf = Hex.Decode(eHex);
                sigOk = Rsa.VerifyPkcs1Sha256(idx, idxLen, sig, nBuf, nHex.Length / 2, eBuf, eHex.Length / 2);
            }
            if (!sigOk) {
                err[0] = 3;
                return null;
            }
        }

        ResourcePack p = new ResourcePack();
        p.path = path;
        p.masterKey = masterKey;
        p.packId = packId;
        p.count = loadBE32(idx, 0);
        p.index = new List<PackIndexEntry>();
        i = 0;
        while (i < p.count) {
            int rec = 4 + 61 * i;
            byte[] nh = new byte[17];
            byte[] iv = new byte[13];
            byte[] tg = new byte[17];
            int j = 0;
            for (; j < 16; j = j + 1) { nh[j] = idx[rec + j]; }
            j = 0;
            while (j < 12) { iv[j] = idx[rec + 33 + j]; j = j + 1; }
            j = 0;
            while (j < 16) { tg[j] = idx[rec + 45 + j]; j = j + 1; }
            p.index.Add(new PackIndexEntry(nh, loadBE64(idx, rec + 16), loadBE64(idx, rec + 24), iv, tg));
            i = i + 1;
        }
        err[0] = 0;
        return p;
    }

    /// 返回 pack 内条目数。
    int Count() { return this.count; }

    /// 按名称哈希查找条目下标（逐字节累积比较），未找到返回 -1。
    int find(string name) {
        byte[] nh = nameHash(name);
        for (int i = 0; i < this.count; i = i + 1) {
            byte[] h = this.index[i].hash;
            int diff = 0;
            for (int j = 0; j < 16; j = j + 1) { diff = diff | ((h[j] & 255) ^ (nh[j] & 255)); }
            if (diff == 0) { return i; }
        }
        return -1;
    }

    /// 名称是否存在于 pack。
    bool Contains(string name) { return this.find(name) >= 0; }

    /// 返回条目负载的字节数；名称未知返回 -1。
    int SizeOf(string name) {
        int i = this.find(name);
        if (i < 0) { return -1; }
        return this.index[i].size;
    }

    /// <summary>按需解密一个条目（只从磁盘读取该条目）。
    /// 返回明文并设置 <paramref name="outLen"/>[0]；
    /// 若名称未知或数据认证失败，
    /// 则返回 null（outLen 为 -1）。</summary>
    byte[] Read(string name, List<int> outLen) {
        outLen[0] = -1;
        int i = this.find(name);
        if (i < 0) { return null; }
        PackIndexEntry e = this.index[i];
        int sz = e.size;
        byte[] ct = File.ReadBytes(this.path, e.off, sz);
        byte[] ek = entryKey(this.masterKey, this.packId, e.hash);
        List<int> ok = new List<int>(); ok.Add(0);
        byte[] pt = AesGcm.Decrypt(ek, 32, e.iv, e.hash, 16, ct, sz, e.tag, ok);
        if (ok[0] == 0) { return null; }
        outLen[0] = sz;
        return pt;
    }
}
