using System;
using System.Text;

namespace System.Text;

// Unicode 国际化大小写折叠与大小写转换（Unicode Standard Annex #44 / Chapter 3: Case Mappings & Case Folding）。
// 包含 1:1 简单大小写折叠、1:N 完整多字符折叠（Full Case Folding，如德语 'ß' -> "ss"、连字 'ﬁ' -> "fi" 等）、
// 以及基于 Unicode 规范化的等价比对（防范组合字符与大小写导致的鉴权仿冒越权安全风险）。
public class UnicodeCase {
    // 码点级 1:1 简单大小写折叠（二分查找）。
    public static int FoldCodePointSimple(int cp) {
        if (cp < 128) {
            if (cp >= 65 && cp <= 90) { return cp + 32; }
            return cp;
        }
        int lo = 0;
        int hi = 1425; // UnicodeTables.caseFold1to1.Length / 2 - 1
        while (lo <= hi) {
            int mid = (lo + hi) / 2;
            int mcp = UnicodeTables.caseFold1to1[mid * 2];
            if (mcp == cp) {
                return UnicodeTables.caseFold1to1[mid * 2 + 1];
            }
            if (mcp < cp) {
                lo = mid + 1;
            } else {
                hi = mid - 1;
            }
        }
        return cp;
    }

