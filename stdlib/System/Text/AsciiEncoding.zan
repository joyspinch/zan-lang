using System;

namespace System.Text;

// 真 ASCII（7 位）编码实例：<c>Encoding.ASCII</c> 返回本类。码点 >0x7F 编码为
// '?'（0x3F），解码字节 >0x7F 同样替为 '?'，与 .NET ASCIEncoding 的替换行为
// 一致。基类的静态 GetBytes/GetString 保持 UTF-8（Zan 字符串本身就是 UTF-8
// 字节串）；只有经由本类实例（<c>Encoding.ASCII.GetBytes(...)</c>）才走 7 位
// 替换语义。实例方法按 Zan 语义遮蔽继承的同签名静态成员（探针实证）。
public class AsciiEncoding : Encoding {
    public byte[] GetBytes(string text) {
        if (text == null) { text = ""; }
        // 按码点输出（C# 口径）：一个码点至多一个 '?'，不能按 UTF-8 字节
        // 迭代——é(U+00E9) 是 2 字节，按字节会替出两个 '?'。
        byte[] buf = new byte[Encoding.CodePointCount(text)];
        int w = 0;
        int i = 0;
        int n = text.Length;
        while (i < n) {
            long res = Encoding.DecodeCodePointFast(text, i);
            int cp = (int)(res & 0xFFFFFFFFL);
            buf[w] = (byte)(cp > 127 ? 63 : cp);
            w = w + 1;
            i = i + (int)(res >> 32);
        }
        return buf;
    }

    public string GetString(byte[] bytes, int offset, int count) {
        if (bytes == null) { return ""; }
        int alen = bytes.Length;
        if (offset < 0) { offset = 0; }
        if (offset > alen) { offset = alen; }
        int avail = alen - offset;
        if (count < 0) { count = 0; }
        if (count > avail) { count = avail; }
        if (count == 0) { return ""; }
        // 输出只含 7 位字节（本身即合法 UTF-8），有高位字节才需要拷贝替换。
        bool high = false;
        for (int i = offset; i < offset + count; i++) {
            if ((bytes[i] & 255) > 127) { high = true; break; }
        }
        if (!high) { return bytes.ToStr(offset, count); }
        byte[] copy = new byte[count];
        for (int i = 0; i < count; i++) {
            int b = bytes[offset + i] & 255;
            copy[i] = (byte)(b > 127 ? 63 : b);
        }
        return copy.ToStr(0, count);
    }

    // GetString(bytes, 0, bytes.Length) 的便捷形态。
    public string GetString(byte[] bytes) {
        if (bytes == null) { return ""; }
        return this.GetString(bytes, 0, bytes.Length);
    }

    // ASCII 编码一码点一字节（含被替换为 '?' 的高位码点），故字节数即码点数
    // （≠ Length 字节数）。
    public int GetByteCount(string text) {
        if (text == null) { return 0; }
        return Encoding.CodePointCount(text);
    }
}
