using System;
using System.Collections.Generic;
using System.Interop;
using System.Numerics;

namespace System.Text;

// Unicode 规范化实现（Unicode Standard Annex #15: Unicode Normalization Forms）。
// 支持 Canonical Decomposition（NFD）与 Canonical Composition（NFC），
// 涵盖完整韩文音节（Hangul Syllables U+AC00..U+D7A3）算法分解/合成、
// 权威 UnicodeData 规范等价分解、规范组合类（CCC）规范重排序、
// 以及规范合成与合成排除规则。
public class UnicodeNormalization {
    // 获取字符的规范组合类（Canonical Combining Class, CCC）。
    // 若字符非组合字符（非变音符号），返回 0。
    public static int GetCombiningClass(int cp) {
        if (cp < 0x300 || (cp >= 0x4E00 && cp <= 0x9FFF) || cp > 0x1E94A) { return 0; }
        int[] ccc = UnicodeTables.ccc;
        int lo = 0;
        int hi = 911; // UnicodeTables.ccc.Length / 2 - 1
        while (lo <= hi) {
            int mid = (lo + hi) >> 1;
            int mcp = ccc[mid * 2];
            if (mcp == cp) {
                return ccc[mid * 2 + 1];
            }
            if (mcp < cp) {
                lo = mid + 1;
            } else {
                hi = mid - 1;
            }
        }
        return 0;
    }

    private static int[] GrowIntBuf(int[] buf, int count, int need) {
        int cap = buf.Length * 2;
        while (cap < need) { cap = cap * 2; }
        int[] nb = new int[cap];
        if (count > 0) { NativeMemory.Copy((nint)nb, (nint)buf, count * 4); }
        return nb;
    }

    // 递归规范分解一个码点到 int[] 缓冲中（NFD 阶段 1）。
    private static void DecomposeRecursiveArr(int cp, ref int[] target, ref int count, ref bool hasCombining) {
        // 0. ASCII/Latin-1 前段（< U+00C0）与 CJK 统一表意文字（U+4E00..U+9FFF）无规范分解，O(1) 跳过二分
        if (cp < 0xC0 || (cp >= 0x4E00 && cp <= 0x9FFF)) {
            if (count >= target.Length) { target = GrowIntBuf(target, count, count + 1); }
            target[count] = cp;
            count = count + 1;
            return;
        }

        // 1. 韩文算法分解（零查表）
        if (cp >= 0xAC00 && cp <= 0xD7A3) {
            int sIndex = cp - 0xAC00;
            int lIndex = sIndex / 588;
            int vIndex = (sIndex % 588) / 28;
            int tIndex = sIndex % 28;
            int need = tIndex > 0 ? 3 : 2;
            if (count + need > target.Length) { target = GrowIntBuf(target, count, count + need); }
            target[count] = 0x1100 + lIndex;
            target[count + 1] = 0x1161 + vIndex;
            if (tIndex > 0) {
                target[count + 2] = 0x11A7 + tIndex;
            }
            count = count + need;
            return;
        }

        // 2. 查表分解（二分查找）
        int[] decomp = UnicodeTables.decomp;
        int lo = 0;
        int hi = 2060; // UnicodeTables.decomp.Length / 3 - 1
        int foundIdx = -1;
        while (lo <= hi) {
            int mid = (lo + hi) >> 1;
            int mcp = decomp[mid * 3];
            if (mcp == cp) {
                foundIdx = mid;
                break;
            }
            if (mcp < cp) {
                lo = mid + 1;
            } else {
                hi = mid - 1;
            }
        }

        if (foundIdx >= 0) {
            int p0 = decomp[foundIdx * 3 + 1];
            int p1 = decomp[foundIdx * 3 + 2];
            DecomposeRecursiveArr(p0, ref target, ref count, ref hasCombining);
            if (p1 != 0) {
                DecomposeRecursiveArr(p1, ref target, ref count, ref hasCombining);
            }
            return;
        }

        // 无分解：原样添加，并记录是否出现非零 CCC 组合字符
        if (cp >= 0x300 && !hasCombining && GetCombiningClass(cp) != 0) {
            hasCombining = true;
        }
        if (count >= target.Length) { target = GrowIntBuf(target, count, count + 1); }
        target[count] = cp;
        count = count + 1;
    }

    // 规范重排序（Canonical Ordering, NFD 阶段 2）：
    // 依据 UAX #15，仅对非零 CCC 的连续组合字符段按 CCC 升序稳定排序，
    // 缓存每段 CCC 避免内层插入循环反复二分查找 912 项 CCC 表。
    private static void CanonicalSortArr(int[] cps, int len) {
        int i = 0;
        int[] cccBuf = null;
        while (i < len) {
            int c0 = GetCombiningClass(cps[i]);
            if (c0 == 0) {
                i = i + 1;
                continue;
            }
            int start = i;
            i = i + 1;
            if (i >= len) { break; }
            int c1 = GetCombiningClass(cps[i]);
            if (c1 == 0) {
                i = i + 1;
                continue;
            }
            int nextI = i + 1;
            int c2 = nextI < len ? GetCombiningClass(cps[nextI]) : 0;
            if (c2 == 0) {
                if (c0 > c1) {
                    int tmp = cps[start];
                    cps[start] = cps[i];
                    cps[i] = tmp;
                }
                i = nextI + 1;
                continue;
            }
            if (cccBuf == null) { cccBuf = new int[32]; }
            cccBuf[0] = c0;
            cccBuf[1] = c1;
            cccBuf[2] = c2;
            int runLen = 3;
            i = nextI + 1;
            while (i < len) {
                int ci = GetCombiningClass(cps[i]);
                if (ci == 0) { break; }
                if (runLen >= cccBuf.Length) {
                    cccBuf = GrowIntBuf(cccBuf, runLen, runLen + 1);
                }
                cccBuf[runLen] = ci;
                runLen = runLen + 1;
                i = i + 1;
            }
            for (int k = 1; k < runLen; k = k + 1) {
                int keyCcc = cccBuf[k];
                int keyCp = cps[start + k];
                int j = k - 1;
                while (j >= 0 && cccBuf[j] > keyCcc) {
                    cccBuf[j + 1] = cccBuf[j];
                    cps[start + j + 1] = cps[start + j];
                    j = j - 1;
                }
                cccBuf[j + 1] = keyCcc;
                cps[start + j + 1] = keyCp;
            }
            i = i + 1;
        }
    }

    // 查找两字符组合的主合成码点（Canonical Composition）。
    // 若无法合成或属于 Composition Exclusion，返回 0。
    public static int GetComposite(int starter, int combiner) {
        if (combiner < 0x300 || (starter >= 0x4E00 && starter <= 0x9FFF)) { return 0; }
        // 1. 韩文算法合成
        // L + V -> LV
        if (starter >= 0x1100 && starter <= 0x1112 && combiner >= 0x1161 && combiner <= 0x1175) {
            int lIndex = starter - 0x1100;
            int vIndex = combiner - 0x1161;
            return 0xAC00 + (lIndex * 21 + vIndex) * 28;
        }
        // LV + T -> LVT
        if (starter >= 0xAC00 && starter <= 0xD7A3 && ((starter - 0xAC00) % 28 == 0) &&
            combiner >= 0x11A8 && combiner <= 0x11C2) {
            int tIndex = combiner - 0x11A7;
            return starter + tIndex;
        }

        // 2. 查表合成（二分查找）
        long key = ((long)starter << 32) | (long)combiner;
        long[] keys = UnicodeTables.compKeys;
        int lo = 0;
        int hi = 940; // UnicodeTables.compKeys.Length - 1
        while (lo <= hi) {
            int mid = (lo + hi) >> 1;
            long mk = keys[mid];
            if (mk == key) {
                return UnicodeTables.compValues[mid];
            }
            if (mk < key) {
                lo = mid + 1;
            } else {
                hi = mid - 1;
            }
        }
        return 0;
    }

    // 将码点数组直接编码为单个 UTF-8 字符串，避免逐码点分配临时 string。
    private static string EncodeCodePointsUtf8Arr(int[] cps, int count) {
        if (count == 0) { return ""; }
        int totalBytes = 0;
        for (int i = 0; i < count; i = i + 1) {
            int cp = cps[i];
            if (cp < 0x80) { totalBytes = totalBytes + 1; }
            else if (cp < 0x800) { totalBytes = totalBytes + 2; }
            else if (cp < 0x10000) { totalBytes = totalBytes + 3; }
            else { totalBytes = totalBytes + 4; }
        }
        byte[] buf = new byte[totalBytes];
        int pos = 0;
        for (int i = 0; i < count; i = i + 1) {
            int cp = cps[i];
            if (cp < 0x80) {
                buf[pos] = (byte)cp;
                pos = pos + 1;
            } else if (cp < 0x800) {
                buf[pos] = (byte)(0xC0 | (cp >> 6));
                buf[pos + 1] = (byte)(0x80 | (cp & 0x3F));
                pos = pos + 2;
            } else if (cp < 0x10000) {
                buf[pos] = (byte)(0xE0 | (cp >> 12));
                buf[pos + 1] = (byte)(0x80 | ((cp >> 6) & 0x3F));
                buf[pos + 2] = (byte)(0x80 | (cp & 0x3F));
                pos = pos + 3;
            } else {
                buf[pos] = (byte)(0xF0 | (cp >> 18));
                buf[pos + 1] = (byte)(0x80 | ((cp >> 12) & 0x3F));
                buf[pos + 2] = (byte)(0x80 | ((cp >> 6) & 0x3F));
                buf[pos + 3] = (byte)(0x80 | (cp & 0x3F));
                pos = pos + 4;
            }
        }
        return buf.ToStr(0, pos);
    }

    // UAX #15 QuickCheck 零分配快路径：
    // UnicodeTables 已验证：U+0000..U+02FF 与 U+4E00..U+9FFF 内无 CCC!=0、无合成排除、无非 NFC 码点；
    // U+0000..U+00BF 与 U+4E00..U+9FFF 内无任何规范分解。满足条件则原串已规范化，零分配直返。
    private static bool QuickCheckAlreadyNormalized(string s, int slen, NormalizationForm form) {
        nint ptr = (nint)s;
        Span<byte> b = new Span<byte>(ptr, slen);
        int i = 0;
        if (form == NormalizationForm.FormC) {
            while (i < slen) {
                while (i + 16 <= slen && Vector128.ExtractMostSignificantBits(Vector128.Load(ptr + (nint)i)) == 0) {
                    i = i + 16;
                }
                if (i >= slen) { break; }
                int c0 = b[i] & 255;
                if (c0 < 0x80) {
                    i = i + 1;
                    continue;
                }
                if ((c0 & 0xE0) == 0xC0 && i + 1 < slen) {
                    // 2 字节 UTF-8：0x0080..0x02FF 对应首字节 0xC2..0xCB
                    if (c0 >= 0xC2 && c0 <= 0xCB && ((b[i + 1] & 0xC0) == 0x80)) {
                        i = i + 2;
                        continue;
                    }
                    return false;
                }
                if ((c0 & 0xF0) == 0xE0 && i + 2 < slen) {
                    int c1 = b[i + 1] & 255;
                    int c2 = b[i + 2] & 255;
                    if (((c1 & 0xC0) == 0x80) && ((c2 & 0xC0) == 0x80)) {
                        int cp = ((c0 & 0x0F) << 12) | ((c1 & 0x3F) << 6) | (c2 & 0x3F);
                        if (cp >= 0x4E00 && cp <= 0x9FFF) {
                            i = i + 3;
                            continue;
                        }
                    }
                    return false;
                }
                return false;
            }
            return true;
        }
        // FormD QuickCheck：仅 ASCII/Latin-1 前段 (< 0xC0) 与 CJK 统一表意文字 (0x4E00..0x9FFF)
        while (i < slen) {
            while (i + 16 <= slen && Vector128.ExtractMostSignificantBits(Vector128.Load(ptr + (nint)i)) == 0) {
                i = i + 16;
            }
            if (i >= slen) { break; }
            int c0 = b[i] & 255;
            if (c0 < 0x80) {
                i = i + 1;
                continue;
            }
            if ((c0 & 0xE0) == 0xC0 && i + 1 < slen) {
                if (c0 == 0xC2 && ((b[i + 1] & 0xC0) == 0x80)) {
                    i = i + 2;
                    continue;
                }
                return false;
            }
            if ((c0 & 0xF0) == 0xE0 && i + 2 < slen) {
                int c1 = b[i + 1] & 255;
                int c2 = b[i + 2] & 255;
                if (((c1 & 0xC0) == 0x80) && ((c2 & 0xC0) == 0x80)) {
                    int cp = ((c0 & 0x0F) << 12) | ((c1 & 0x3F) << 6) | (c2 & 0x3F);
                    if (cp >= 0x4E00 && cp <= 0x9FFF) {
                        i = i + 3;
                        continue;
                    }
                }
                return false;
            }
            return false;
        }
        return true;
    }

    // 将字符串规范化为指定的 Unicode 规范化形式（UAX #15）。
    public static string Normalize(string s, NormalizationForm form) {
        if (s == null || s.Length == 0) { return s; }

        int slen = s.Length;
        // 快速检测纯 ASCII：纯 ASCII 字符串在 NFC/NFD 下恒为自身
        if (NativeMemory.IsAscii((nint)s, slen)) { return s; }
        // UAX #15 QuickCheck 零分配快路径（CJK + Latin-1/ASCII 已规范化文本直接返回原串）
        if (QuickCheckAlreadyNormalized(s, slen, form)) { return s; }

        // 步骤 1：规范分解（NFD），单 int[] 缓冲 + O(1) 跳过 ASCII/CJK
        int[] buf = new int[slen + 8];
        int dlen = 0;
        bool hasCombining = false;
        int idx = 0;
        while (idx < slen) {
            long res = Encoding.DecodeCodePointFast(s, idx);
            int cp = (int)(res & 0xFFFFFFFFL);
            idx = idx + (int)(res >> 32);
            if (cp < 0xC0 || (cp >= 0x4E00 && cp <= 0x9FFF)) {
                if (dlen >= buf.Length) { buf = GrowIntBuf(buf, dlen, dlen + 1); }
                buf[dlen] = cp;
                dlen = dlen + 1;
            } else {
                DecomposeRecursiveArr(cp, ref buf, ref dlen, ref hasCombining);
            }
        }

        // 步骤 2：规范重排序（仅当存在非零 CCC 组合字符时才执行）
        if (hasCombining) {
            CanonicalSortArr(buf, dlen);
        }

        // 若请求 NFD，直接编码返回
        if (form == NormalizationForm.FormD) {
            return EncodeCodePointsUtf8Arr(buf, dlen);
        }

        // 步骤 3：原地规范合成（NFC，零第二缓冲分配）
        if (dlen == 0) { return ""; }

        int outLen = 1;
        int starterPos = 0;
        int lastCcc = GetCombiningClass(buf[0]);
        if (lastCcc != 0) {
            starterPos = -1;
        }

        for (int i = 1; i < dlen; i = i + 1) {
            int ch = buf[i];
            if (ch < 0x300 || (ch >= 0x4E00 && ch <= 0x9FFF)) {
                // combiner < 0x300 或 CJK 既非组合字符也不能作第二合成元，直接作为新 starter
                starterPos = outLen;
                buf[outLen] = ch;
                outLen = outLen + 1;
                lastCcc = 0;
                continue;
            }
            int chCcc = GetCombiningClass(ch);
            bool combined = false;
            if (starterPos >= 0 && (lastCcc < chCcc || lastCcc == 0)) {
                int st = buf[starterPos];
                int composite = GetComposite(st, ch);
                if (composite != 0) {
                    buf[starterPos] = composite;
                    combined = true;
                }
            }
            if (!combined) {
                if (chCcc == 0) {
                    starterPos = outLen;
                    buf[outLen] = ch;
                    outLen = outLen + 1;
                    lastCcc = 0;
                } else {
                    buf[outLen] = ch;
                    outLen = outLen + 1;
                    lastCcc = chCcc;
                }
            }
        }

        return EncodeCodePointsUtf8Arr(buf, outLen);
    }

    // 判断字符串是否已符合指定的 Unicode 规范化形式。
    public static bool IsNormalized(string s, NormalizationForm form) {
        if (s == null || s.Length == 0) { return true; }
        int slen = s.Length;
        if (NativeMemory.IsAscii((nint)s, slen)) { return true; }
        if (QuickCheckAlreadyNormalized(s, slen, form)) { return true; }
        string norm = Normalize(s, form);
        return norm == s;
    }
}
