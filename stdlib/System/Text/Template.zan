using System;

namespace System.Text;

/// <summary>
/// 基于 Dictionary&lt;string,string&gt; 的简单字符串模板替换。
///
///   Dictionary<string,string> vars = new Dictionary<string,string>();
///   vars["name"] = "<b>zan</b>";
///   string out = Template.Render("Hi {{name}}!", vars);   // "Hi &lt;b&gt;zan&lt;/b&gt;!"
///   string raw = Template.RenderRaw("Hi {{name}}!", vars);// "Hi <b>zan</b>!"
///
/// 语法：<c>{{key}}</c> 对值做 HTML 转义，<c>{{{key}}}</c>
/// 原样插入；未知键展开为 ""。同一替换核心
/// 支撑 System.Web.View（后者在其上增加对行列表的 #if/#each）。
/// </summary>
class Template {
    /// <summary>渲染 `text`，对每个 <c>{{key}}</c> 的值做 HTML 转义；
    /// <c>{{{key}}}</c> 原样插入。</summary>
    static string Render(string text, Dictionary<string, string> vars) {
        return Template.Expand(text, vars, true);
    }

    /// <summary>渲染 `text` 且不做任何转义（<c>{{key}}</c> 和
    /// <c>{{{key}}}</c> 均原样插入值）。</summary>
    static string RenderRaw(string text, Dictionary<string, string> vars) {
        return Template.Expand(text, vars, false);
    }

    /// <summary>对字符串做 HTML 转义以便安全插值：
    /// <c>&amp; &lt; &gt; &quot; &#39;</c>。</summary>
    static string EscapeHtml(string s) {
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < s.Length; i = i + 1) {
            string ch = s.Substring(i, 1);
            if (ch == "&") { sb.Append("&amp;"); }
            else if (ch == "<") { sb.Append("&lt;"); }
            else if (ch == ">") { sb.Append("&gt;"); }
            else if (ch == "\"") { sb.Append("&quot;"); }
            else if (ch == "'") { sb.Append("&#39;"); }
            else { sb.Append(ch); }
        }
        return sb.ToString();
    }

    /// <summary>替换核心：扫描 <c>{{key}}</c> / <c>{{{key}}}</c> 占位符，
    /// 键两侧的空白会被剥掉。<c>{{{key}}}</c> 无论 escape 与否都原样插入；
    /// <c>{{key}}</c> 在 escape 为 true 时对值做 HTML 转义。
    /// 占位符未闭合（找不到对应的 <c>}}</c> / <c>}}}</c>）时渲染在
    /// 该处截断，剩余文本与占位符一并丢弃。</summary>
    static string Expand(string text, Dictionary<string, string> vars, bool escape) {
        StringBuilder sb = new StringBuilder();
        int i = 0;
        int n = text.Length;
        while (i < n) {
            int open = Template.Find(text, "{{", i);
            if (open < 0) {
                sb.Append(text.Substring(i, n - i));
                return sb.ToString();
            }
            sb.Append(text.Substring(i, open - i));
            if (open + 2 < n && text.Substring(open + 2, 1) == "{") {
                // {{{key}}} 原样形式
                int close = Template.Find(text, "}}}", open + 3);
                if (close < 0) { return sb.ToString(); }
                string key = Template.Trim(text.Substring(open + 3, close - open - 3));
                sb.Append(Template.Lookup(key, vars));
                i = close + 3;
            } else {
                int close = Template.Find(text, "}}", open + 2);
                if (close < 0) { return sb.ToString(); }
                string key = Template.Trim(text.Substring(open + 2, close - open - 2));
                string val = Template.Lookup(key, vars);
                if (escape) { val = Template.EscapeHtml(val); }
                sb.Append(val);
                i = close + 2;
            }
        }
        return sb.ToString();
    }

    /// 查占位符的值：vars 为 null 或键不存在时返回 ""（渲染不报错）。
    static string Lookup(string key, Dictionary<string, string> vars) {
        if (vars == null) { return ""; }
        List<string> keys = vars.Keys;
        for (int i = 0; i < keys.Count; i = i + 1) {
            if (keys[i] == key) { return vars[key]; }
        }
        return "";
    }

    /// 剥掉 s 首尾的空白（空格、制表符、换行、回车）。
    static string Trim(string s) {
        int start = 0;
        int end = s.Length;
        while (start < end) {
            string ch = s.Substring(start, 1);
            if (ch == " " || ch == "\t" || ch == "\n" || ch == "\r") { start = start + 1; }
            else { break; }
        }
        while (end > start) {
            string ch = s.Substring(end - 1, 1);
            if (ch == " " || ch == "\t" || ch == "\n" || ch == "\r") { end = end - 1; }
            else { break; }
        }
        return s.Substring(start, end - start);
    }

    /// 返回 needle 在 hay 中自 from（含）起首次出现的下标，找不到返回 -1。
    static int Find(string hay, string needle, int from) {
        int n = needle.Length;
        int h = hay.Length;
        int i = from;
        while (i + n <= h) {
            if (hay.Substring(i, n) == needle) { return i; }
            i = i + 1;
        }
        return -1;
    }
}
