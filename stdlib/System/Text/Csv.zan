using System;

namespace System.Text;

/// <summary>
/// Minimal CSV reader/writer. Fields may be quoted; a quote inside a quoted
/// field is doubled (<c>""</c>). Quotes are only special at the start of a
/// field (RFC 4180). A custom separator can be supplied (e.g. tab for TSV).
///
///   List<List<string>> rows = Csv.Parse(text);        // comma
///   List<List<string>> tsv = Csv.Parse(text, "\t");
///   string out = Csv.Serialize(rows);                 // comma, quotes added
/// </summary>
class Csv {
    /// <summary>Parses CSV text into rows of fields. A trailing empty line
    /// is ignored. Malformed quotes are treated literally.</summary>
    static List<List<string>> Parse(string text) {
        return Csv.ParseSep(text, ",");
    }

    /// <summary>Parses with a custom separator (single character).</summary>
    static List<List<string>> ParseSep(string text, string separator) {
        List<List<string>> rows = new List<List<string>>();
        List<string> row = new List<string>();
        StringBuilder field = new StringBuilder();
        bool inQuotes = false;
        int i = 0;
        while (i < text.Length) {
            string ch = text.Substring(i, 1);
            if (inQuotes) {
                if (ch == "\"") {
                    if (i + 1 < text.Length && text.Substring(i + 1, 1) == "\"") {
                        field.Append("\"");
                        i = i + 2;
                    } else {
                        inQuotes = false;
                        i = i + 1;
                    }
                } else {
                    field.Append(ch);
                    i = i + 1;
                }
            } else {
                if (ch == "\"") {
                    inQuotes = true;
                    i = i + 1;
                } else if (ch == separator) {
                    row.Add(field.ToString());
                    field = new StringBuilder();
                    i = i + 1;
                } else if (ch == "\r") {
                    i = i + 1;   // skip CR; \n ends the row
                } else if (ch == "\n") {
                    row.Add(field.ToString());
                    field = new StringBuilder();
                    rows.Add(row);
                    row = new List<string>();
                    i = i + 1;
                } else {
                    field.Append(ch);
                    i = i + 1;
                }
            }
        }
        // Trailing content without a newline.
        if (field.ToString().Length > 0 || row.Count > 0) {
            row.Add(field.ToString());
            rows.Add(row);
        }
        return rows;
    }

    /// <summary>Serializes rows to CSV text, quoting fields that contain a
    /// separator, a quote, or a newline. Ends with a trailing newline.</summary>
    static string Serialize(List<List<string>> rows) {
        return Csv.SerializeSep(rows, ",");
    }

    /// <summary>Serializes with a custom separator.</summary>
    static string SerializeSep(List<List<string>> rows, string separator) {
        StringBuilder sb = new StringBuilder();
        for (int r = 0; r < rows.Count; r = r + 1) {
            List<string> row = rows[r];
            for (int c = 0; c < row.Count; c = c + 1) {
                if (c > 0) { sb.Append(separator); }
                sb.Append(Csv.Escape(row[c], separator));
            }
            sb.Append("\n");
        }
        return sb.ToString();
    }

    static string Escape(string field, string separator) {
        bool needQuote = false;
        int i = 0;
        for (; i < field.Length; i = i + 1) {
            string ch = field.Substring(i, 1);
            if (ch == separator || ch == "\"" || ch == "\n" || ch == "\r") {
                needQuote = true;
            }
        }
        if (!needQuote) { return field; }
        StringBuilder sb = new StringBuilder();
        sb.Append("\"");
        i = 0;
        while (i < field.Length) {
            string ch = field.Substring(i, 1);
            if (ch == "\"") { sb.Append("\"\""); }
            else { sb.Append(ch); }
            i = i + 1;
        }
        sb.Append("\"");
        return sb.ToString();
    }
}
