using System;

namespace System.Text;

class Bm25Document {
    int id;
    Dictionary<string, int> terms;
    int length;

    static Bm25Document Create(
        int id,
        Dictionary<string, int> terms,
        int length
    ) {
        Bm25Document document = new Bm25Document();
        document.id = id;
        document.terms = terms;
        document.length = length;
        return document;
    }
}

class Bm25Hit {
    int id;
    double score;

    static Bm25Hit Create(int id, double score) {
        Bm25Hit hit = new Bm25Hit();
        hit.id = id;
        hit.score = score;
        return hit;
    }
}

/// <summary>
/// A small in-memory BM25 (Best Matching 25) text index. Documents are
/// tokenized (lower-cased, split on non-alphanumerics) and scored against a
/// query with the standard k1=1.2, b=0.75 parameters; results come back as
/// doc ids sorted by descending score.
///
///   Bm25Index idx = Bm25Index.Create();
///   idx.Add(1, "the quick brown fox jumps");
///   idx.Add(2, "lazy dog sleeps all day");
///   List<int> hits = idx.Search("quick fox");   // [1]
///
/// Pure algorithm, no platform dependencies; sized for IDE-scale corpora
/// (thousands of documents, small tokens) -- every query scans all docs.
/// </summary>
class Bm25Index {
    List<Bm25Document> documents = new List<Bm25Document>();
    Dictionary<string, int> df = new Dictionary<string, int>();
    int totalLen;
    double k1;
    double b;

    static Bm25Index Create() {
        Bm25Index idx = new Bm25Index();
        idx.k1 = 1.2;
        idx.b = 0.75;
        idx.totalLen = 0;
        return idx;
    }

    /// <summary>Adds a document. Re-adding an id replaces its content.</summary>
    void Add(int docId, string text) {
        Dictionary<string, int> terms = Bm25Index.Tokenize(text);
        int len = 0;
        List<string> keys = terms.Keys;
        int i = 0;
        while (i < keys.Count) {
            int f = terms[keys[i]];
            len = len + f;
            i = i + 1;
        }
        // Replace an existing id in place.
        int pos = -1;
        int j = 0;
        while (j < documents.Count) {
            if (documents[j].id == docId) { pos = j; }
            j = j + 1;
        }
        if (pos >= 0) {
            // Subtract the old document from df and totals.
            List<string> old = documents[pos].terms.Keys;
            int k = 0;
            while (k < old.Count) {
                DecDf(old[k]);
                k = k + 1;
            }
            totalLen = totalLen - documents[pos].length;
            documents[pos].terms = terms;
            documents[pos].length = len;
        } else {
            documents.Add(Bm25Document.Create(docId, terms, len));
        }
        totalLen = totalLen + len;
        // Count document frequency of each term.
        int k = 0;
        while (k < keys.Count) {
            IncDf(keys[k]);
            k = k + 1;
        }
    }

    /// <summary>Removes a document id; no-op when absent.</summary>
    void Remove(int docId) {
        int pos = -1;
        int j = 0;
        while (j < documents.Count) {
            if (documents[j].id == docId) { pos = j; }
            j = j + 1;
        }
        if (pos < 0) { return; }
        List<string> old = documents[pos].terms.Keys;
        int k = 0;
        while (k < old.Count) {
            DecDf(old[k]);
            k = k + 1;
        }
        totalLen = totalLen - documents[pos].length;
        documents.RemoveAt(pos);
    }

    /// <summary>Number of indexed documents.</summary>
    int Count() { return documents.Count; }

    /// <summary>Ranks all documents against `query`; ids with a non-zero
    /// score, highest first. An empty query returns nothing.</summary>
    List<int> Search(string query) {
        List<string> terms = Bm25Index.UniqueTerms(query);
        List<int> results = new List<int>();
        if (terms.Count == 0 || documents.Count == 0) { return results; }
        double avgdl = (double)totalLen / (double)documents.Count;
        int n = documents.Count;
        List<Bm25Hit> hits = new List<Bm25Hit>();
        int d = 0;
        while (d < documents.Count) {
            Bm25Document document = documents[d];
            double score = 0.0;
            int t = 0;
            while (t < terms.Count) {
                string term = terms[t];
                int tf = 0;
                Dictionary<string, int> dt = document.terms;
                List<string> dk = dt.Keys;
                int ki = 0;
                while (ki < dk.Count) {
                    if (dk[ki] == term) { tf = dt[term]; }
                    ki = ki + 1;
                }
                if (tf > 0) {
                    int docFreq = DfOf(term);
                    double idf = Math.Log(1.0 + ((double)(n - docFreq) + 0.5)
                                                 / ((double)docFreq + 0.5));
                    double denom = (double)tf
                        + k1 * (1.0 - b
                        + b * (double)document.length / avgdl);
                    score = score + idf * (double)tf * (k1 + 1.0) / denom;
                }
                t = t + 1;
            }
            if (score > 0.0) {
                // Insertion sort by descending score (stable for ties).
                Bm25Hit hit = Bm25Hit.Create(document.id, score);
                int ins = hits.Count;
                hits.Add(hit);
                while (ins > 0 && hits[ins - 1].score < score) {
                    hits[ins] = hits[ins - 1];
                    ins = ins - 1;
                }
                hits[ins] = hit;
            }
            d = d + 1;
        }
        int r = 0;
        while (r < hits.Count) {
            results.Add(hits[r].id);
            r = r + 1;
        }
        return results;
    }

    // ---- helpers ----

    static Dictionary<string, int> Tokenize(string text) {
        Dictionary<string, int> terms = new Dictionary<string, int>();
        StringBuilder tok = new StringBuilder();
        int i = 0;
        while (i < text.Length) {
            string ch = text.Substring(i, 1).ToLower();
            int c = ch[0] & 255;
            bool alnum = (c >= 97 && c <= 122) || (c >= 48 && c <= 57);
            if (alnum) {
                tok.Append(ch);
            } else if (tok.ToString().Length > 0) {
                Bm25Index.AddTerm(terms, tok.ToString());
                tok = new StringBuilder();
            }
            i = i + 1;
        }
        if (tok.ToString().Length > 0) { Bm25Index.AddTerm(terms, tok.ToString()); }
        return terms;
    }

    static List<string> UniqueTerms(string query) {
        List<string> terms = new List<string>();
        Dictionary<string, int> seen = new Dictionary<string, int>();
        Dictionary<string, int> all = Bm25Index.Tokenize(query);
        List<string> keys = all.Keys;
        int i = 0;
        while (i < keys.Count) {
            string k = keys[i];
            if (Bm25Index.GetSeen(seen, k) == 0) {
                terms.Add(k);
                seen[k] = 1;
            }
            i = i + 1;
        }
        return terms;
    }

    static int GetSeen(Dictionary<string, int> seen, string key) {
        List<string> keys = seen.Keys;
        int i = 0;
        while (i < keys.Count) {
            if (keys[i] == key) { return seen[key]; }
            i = i + 1;
        }
        return 0;
    }

    static void AddTerm(Dictionary<string, int> terms, string term) {
        List<string> keys = terms.Keys;
        int i = 0;
        while (i < keys.Count) {
            if (keys[i] == term) {
                terms[term] = terms[term] + 1;
                return;
            }
            i = i + 1;
        }
        terms[term] = 1;
    }

    int DfOf(string term) {
        List<string> keys = df.Keys;
        int i = 0;
        while (i < keys.Count) {
            if (keys[i] == term) { return df[term]; }
            i = i + 1;
        }
        return 0;
    }

    void IncDf(string term) {
        List<string> keys = df.Keys;
        int i = 0;
        while (i < keys.Count) {
            if (keys[i] == term) {
                df[term] = df[term] + 1;
                return;
            }
            i = i + 1;
        }
        df[term] = 1;
    }

    void DecDf(string term) {
        List<string> keys = df.Keys;
        int i = 0;
        while (i < keys.Count) {
            if (keys[i] == term) {
                int v = df[term] - 1;
                if (v <= 0) { df.Remove(term); }
                else { df[term] = v; }
                return;
            }
            i = i + 1;
        }
    }
}

