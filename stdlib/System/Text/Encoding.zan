using System;

namespace System.Text;

/// <summary>
/// 跨平台文本编码与转换工具。
/// 使用各平台均可用的 C 运行时函数。
/// </summary>
class Encoding {
    [DllImport("crt")]
    static extern long strlen(string str);

    /// <summary>将整数转换为字符串。逐位生成
    /// 而不用 sprintf：变参 C 函数在 Darwin arm64 上采用不同 ABI（参数在栈上，
    /// 而非寄存器中），因此 FFI 变参调用会在该平台
    /// 破坏参数。</summary>
    static string IntToString(int val) {
        byte[] buf = new byte[32];
        int v = val;
        int neg = 0;
        if (v < 0) { neg = 1; v = 0 - v; }
        int end = 31;
        int i = end;
        if (v == 0) { i = i - 1; buf[i] = 48; }
        while (v > 0) {
            i = i - 1;
            buf[i] = (byte)(48 + v % 10);
            v = v / 10;
        }
        if (neg == 1) { i = i - 1; buf[i] = 45; }
        return buf.ToStr(i, end - i);
    }

    /// <summary>将 double 转换为字符串。</summary>
    static string DoubleToString(double val) {
        return "" + val;
    }

    /// <summary>将字符串解析为整数，与 C 的 atoi 一致：跳过前导
    /// 空白、可选正负号，然后读取十进制数字直到遇到首个
    /// 非数字字符。无数字时返回 0。</summary>
    static int ParseInt(string text) {
        int len = text.Length;
        int i = 0;
        while (i < len) {
            int c = text[i] & 255;
            if (c == 32 || c == 9 || c == 10 || c == 13) { i = i + 1; } else { break; }
        }
        int sign = 1;
        if (i < len) {
            int c = text[i] & 255;
            if (c == 43) { i = i + 1; } else if (c == 45) { sign = -1; i = i + 1; }
        }
        int val = 0;
        while (i < len) {
            int c = text[i] & 255;
            if (c < 48 || c > 57) { break; }
            val = val * 10 + (c - 48);
            i = i + 1;
        }
        return sign * val;
    }

    /// <summary>将字符串解析为 double，与 C 的 atof 一致：可选符号、
    /// 整数和小数部分，以及可选十进制指数
    /// （e/E）。无数字时返回 0。</summary>
    static double ParseDouble(string text) {
        int len = text.Length;
        int i = 0;
        while (i < len) {
            int c = text[i] & 255;
            if (c == 32 || c == 9 || c == 10 || c == 13) { i = i + 1; } else { break; }
        }
        double sign = 1.0;
        if (i < len) {
            int c = text[i] & 255;
            if (c == 43) { i = i + 1; } else if (c == 45) { sign = -1.0; i = i + 1; }
        }
        double val = 0.0;
        while (i < len) {
            int c = text[i] & 255;
            if (c < 48 || c > 57) { break; }
            val = val * 10.0 + (double)(c - 48);
            i = i + 1;
        }
        if (i < len && (text[i] & 255) == 46) {
            i = i + 1;
            double frac = 0.1;
            while (i < len) {
                int c = text[i] & 255;
                if (c < 48 || c > 57) { break; }
                val = val + (double)(c - 48) * frac;
                frac = frac * 0.1;
                i = i + 1;
            }
        }
        if (i < len) {
            int c = text[i] & 255;
            if (c == 101 || c == 69) {
                i = i + 1;
                int esign = 1;
                if (i < len) {
                    int c2 = text[i] & 255;
                    if (c2 == 43) { i = i + 1; } else if (c2 == 45) { esign = -1; i = i + 1; }
                }
                int exp = 0;
                while (i < len) {
                    int c2 = text[i] & 255;
                    if (c2 < 48 || c2 > 57) { break; }
                    exp = exp * 10 + (c2 - 48);
                    i = i + 1;
                }
                double p = 1.0;
                for (int k = 0; k < exp; k = k + 1) { p = p * 10.0; }
                if (esign > 0) { val = val * p; } else { val = val / p; }
            }
        }
        return sign * val;
    }

    /// <summary>获取 UTF-8 字符串的字节数。</summary>
    static int GetByteCount(string text) {
        return (int)strlen(text);
    }

    /// <summary>将字节值转换为十六进制字符串（两个字符）。</summary>
    static string ByteToHex(int b) {
        string hex = "0123456789abcdef";
        return hex.Substring((b >> 4) & 15, 1) + hex.Substring(b & 15, 1);
    }

    /// <summary>单个十六进制数字的值（0-9、a-f、A-F），非法时返回 -1。</summary>
    static int HexDigit(int c) {
        if (c >= 48 && c <= 57) { return c - 48; }
        if (c >= 97 && c <= 102) { return c - 87; }
        if (c >= 65 && c <= 70) { return c - 55; }
        return -1;
    }

    /// <summary>构造包含给定字节值的单字符字符串。</summary>
    static string CharFromCode(int code) {
        byte[] s = new byte[2];
        s[0] = (byte)(code & 255);
        return s.ToStr(0, 1);
    }

    /// <summary>把一个 Unicode 码点编码为 UTF-8 字节序列（1-4 字节）。
    /// 码点越界或落在代理区时用替换字符 U+FFFD，因此结果
    /// 始终是合法 UTF-8。JSON 的 <c>\uXXXX</c> 解码走这里。</summary>
    static string Utf8FromCodePoint(int code) {
        int cp = code;
        if (cp < 0 || cp > 1114111 || (cp >= 55296 && cp <= 57343)) { cp = 65533; }
        byte[] b = new byte[5];
        int n = 0;
        if (cp < 128) {
            b[0] = (byte)cp;
            n = 1;
        } else if (cp < 2048) {
            b[0] = (byte)(192 | (cp >> 6));
            b[1] = (byte)(128 | (cp & 63));
            n = 2;
        } else if (cp < 65536) {
            b[0] = (byte)(224 | (cp >> 12));
            b[1] = (byte)(128 | ((cp >> 6) & 63));
            b[2] = (byte)(128 | (cp & 63));
            n = 3;
        } else {
            b[0] = (byte)(240 | (cp >> 18));
            b[1] = (byte)(128 | ((cp >> 12) & 63));
            b[2] = (byte)(128 | ((cp >> 6) & 63));
            b[3] = (byte)(128 | (cp & 63));
            n = 4;
        }
        return b.ToStr(0, n);
    }

    /// <summary>对字符串进行 URL 编码。</summary>
    static string UrlEncode(string text) {
        StringBuilder sb = new StringBuilder();
        int len = text.Length;
        for (int i = 0; i < len; i = i + 1) {
            string ch = text.Substring(i, 1);
            if ((ch >= "A" && ch <= "Z") || (ch >= "a" && ch <= "z") ||
                (ch >= "0" && ch <= "9") || ch == "-" || ch == "_" ||
                ch == "." || ch == "~") {
                sb.Append(ch);
            } else if (ch == " ") {
                sb.Append("+");
            } else {
                sb.Append("%");
                // 简化处理：追加字符的十六进制
                sb.Append(ByteToHex(ch[0]));
            }
        }
        return sb.ToString();
    }

    /// <summary>对 application/x-www-form-urlencoded 字符串进行 URL 解码：
    /// '+' 变为空格，每个 %XX 转义解码为其对应字节。
    /// 格式错误的转义原样保留。</summary>
    static string UrlDecode(string text) {
        StringBuilder sb = new StringBuilder();
        int i = 0;
        int len = text.Length;
        while (i < len) {
            int c = text[i] & 255;
            if (c == 43) {
                sb.Append(" ");
                i = i + 1;
            } else if (c == 37 && i + 2 < len) {
                int h = Encoding.HexDigit(text[i + 1] & 255);
                int l = Encoding.HexDigit(text[i + 2] & 255);
                if (h >= 0 && l >= 0) {
                    sb.Append(Encoding.CharFromCode(h * 16 + l));
                    i = i + 3;
                } else {
                    sb.Append("%");
                    i = i + 1;
                }
            } else {
                sb.Append(text.Substring(i, 1));
                i = i + 1;
            }
        }
        return sb.ToString();
    }

    /// <summary>对文本转义，以便安全嵌入 HTML 元素或属性
    /// 内容（&lt; &gt; &amp; &quot; &#39;）。</summary>
    static string HtmlEncode(string text) {
        StringBuilder sb = new StringBuilder();
        int len = text.Length;
        for (int i = 0; i < len; i = i + 1) {
            int c = text[i] & 255;
            if (c == 60) { sb.Append("&lt;"); }
            else if (c == 62) { sb.Append("&gt;"); }
            else if (c == 38) { sb.Append("&amp;"); }
            else if (c == 34) { sb.Append("&quot;"); }
            else if (c == 39) { sb.Append("&#39;"); }
            else { sb.Append(text.Substring(i, 1)); }
        }
        return sb.ToString();
    }

    /// <summary>转义文本以用于 JSON 字符串字面量内部（引号由调用方
    /// 提供）。0x20 以下的控制字符按 RFC 8259 转义：
    /// \n \r \t \b \f 用短形式，其余用 \u00xx，因此转义是无损的。</summary>
    static string JsonEscape(string text) {
        int len = text.Length;
        int i = 0;
        for (; i < len; i = i + 1) {
            int c = text[i] & 255;
            if (c == 34 || c == 92 || c < 32) { break; }
        }
        if (i == len) { return text; }   // 无需转义（常见情况）
        StringBuilder sb = new StringBuilder();
        if (i > 0) { sb.Append(text.Substring(0, i)); }
        while (i < len) {
            int c = text[i] & 255;
            if (c == 34) { sb.Append("\\\""); }
            else if (c == 92) { sb.Append("\\\\"); }
            else if (c == 10) { sb.Append("\\n"); }
            else if (c == 13) { sb.Append("\\r"); }
            else if (c == 9) { sb.Append("\\t"); }
            else if (c == 8) { sb.Append("\\b"); }
            else if (c == 12) { sb.Append("\\f"); }
            // 其余控制字节按 RFC 8259 转成 \u00xx，而不是替换成空格：
            // 空格会静默改写内容（读文件、日志、二进制片段都会被损坏），
            // 而 \u00xx 可以被任何 JSON 解析器还原成原字节。
            else if (c < 32) { sb.Append("\\u00" + Encoding.ByteToHex(c)); }
            else {
                int run = i;
                while (run < len) {
                    int c2 = text[run] & 255;
                    if (c2 == 34 || c2 == 92 || c2 < 32) { break; }
                    run = run + 1;
                }
                sb.Append(text.Substring(i, run - i));
                i = run;
                continue;
            }
            i = i + 1;
        }
        return sb.ToString();
    }

    /// <summary>对字符串进行 Base64 编码。</summary>
    static string Base64Encode(string text) {
        string chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
        StringBuilder sb = new StringBuilder();
        int i = 0;
        int len = (int)strlen(text);
        while (i < len) {
            int b0 = text[i] & 255;
            int b1 = 0;
            int b2 = 0;
            int pad = 0;
            if (i + 1 < len) {
                b1 = text[i + 1] & 255;
            } else {
                pad = pad + 1;
            }
            if (i + 2 < len) {
                b2 = text[i + 2] & 255;
            } else {
                pad = pad + 1;
            }
            int triple = (b0 << 16) + (b1 << 8) + b2;
            sb.Append(chars.Substring((triple >> 18) & 63, 1));
            sb.Append(chars.Substring((triple >> 12) & 63, 1));
            if (pad < 2) {
                sb.Append(chars.Substring((triple >> 6) & 63, 1));
            } else {
                sb.Append("=");
            }
            if (pad < 1) {
                sb.Append(chars.Substring(triple & 63, 1));
            } else {
                sb.Append("=");
            }
            i = i + 3;
        }
        return sb.ToString();
    }

    /// <summary>对 <paramref name="data"/> 中的前 <paramref name="len"/> 个原始字节做 Base64 编码。
    /// 二进制安全：长度显式给出，因此嵌入的
    /// NUL 字节（如 SHA-1 摘要）会被编码，而不会像
    /// 基于 strlen 的 <see cref="Base64Encode"/> 那样被截断。</summary>
    static string Base64EncodeBytes(string data, int len) {
        string chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
        StringBuilder sb = new StringBuilder();
        int i = 0;
        while (i < len) {
            int b0 = data[i] & 255;
            int b1 = 0;
            int b2 = 0;
            int pad = 0;
            if (i + 1 < len) {
                b1 = data[i + 1] & 255;
            } else {
                pad = pad + 1;
            }
            if (i + 2 < len) {
                b2 = data[i + 2] & 255;
            } else {
                pad = pad + 1;
            }
            int triple = (b0 << 16) + (b1 << 8) + b2;
            sb.Append(chars.Substring((triple >> 18) & 63, 1));
            sb.Append(chars.Substring((triple >> 12) & 63, 1));
            if (pad < 2) {
                sb.Append(chars.Substring((triple >> 6) & 63, 1));
            } else {
                sb.Append("=");
            }
            if (pad < 1) {
                sb.Append(chars.Substring(triple & 63, 1));
            } else {
                sb.Append("=");
            }
            i = i + 3;
        }
        return sb.ToString();
    }

    /// <summary>单个 base64 字符的 6 位值；'=' 为 -2，
    /// 其他非 base64 字符为 -1。</summary>
    static int Base64Digit(int c) {
        if (c >= 65 && c <= 90) { return c - 65; }        // A-Z
        if (c >= 97 && c <= 122) { return c - 71; }       // a-z -> 26..51
        if (c >= 48 && c <= 57) { return c + 4; }         // 0-9 -> 52..61
        if (c == 43 || c == 45) { return 62; }            // '+' 及 URL 变体 '-'
        if (c == 47 || c == 95) { return 63; }            // '/' 及 URL 变体 '_'
        if (c == 61) { return -2; }                       // '='
        return -1;
    }

    /// <summary>解码 base64 文本为原始字节。返回 <c>byte[]</c> 而非
    /// 字符串：Zan 字符串以 NUL 结尾，任何含 0x00 的负载装进字符串
    /// 都会被后续 strlen 截断。空白被忽略，标准与 URL 安全字母表都
    /// 接受；遇到非法字符或残缺尾部时抛出 ArgumentException，
    /// 避免静默截断成半个负载。</summary>
    static byte[] Base64Decode(string text) {
        int len = text.Length;
        // 先数出有效码位，据此一次性定长分配：'=' 之后的内容忽略。
        int digits = 0;
        for (int i = 0; i < len; i = i + 1) {
            int c = text[i] & 255;
            if (c == 32 || c == 9 || c == 10 || c == 13) { continue; }
            int d = Encoding.Base64Digit(c);
            if (d == -2) { break; }
            if (d < 0) {
                throw new ArgumentException("Invalid base64 character at "
                    + Convert.ToString(i));
            }
            digits = digits + 1;
        }
        if ((digits & 3) == 1) {
            throw new ArgumentException("Truncated base64 input");
        }
        // 4 个码位 -> 3 字节；尾部 2 -> 1 字节，3 -> 2 字节。
        int outLen = (digits / 4) * 3;
        int tail = digits & 3;
        if (tail == 2) { outLen = outLen + 1; }
        else if (tail == 3) { outLen = outLen + 2; }
        byte[] outBuf = new byte[outLen];
        int acc = 0;
        int have = 0;
        int w = 0;
        int seen = 0;
        for (int i = 0; i < len && seen < digits; i = i + 1) {
            int c = text[i] & 255;
            if (c == 32 || c == 9 || c == 10 || c == 13) { continue; }
            acc = (acc << 6) | Encoding.Base64Digit(c);
            seen = seen + 1;
            have = have + 1;
            if (have == 4) {
                outBuf[w] = (byte)((acc >> 16) & 255);
                outBuf[w + 1] = (byte)((acc >> 8) & 255);
                outBuf[w + 2] = (byte)(acc & 255);
                w = w + 3;
                acc = 0;
                have = 0;
            }
        }
        if (have == 2) {
            outBuf[w] = (byte)((acc >> 4) & 255);
        } else if (have == 3) {
            outBuf[w] = (byte)((acc >> 10) & 255);
            outBuf[w + 1] = (byte)((acc >> 2) & 255);
        }
        return outBuf;
    }

    /// <summary>32 位循环左移。值保存在 <c>long</c> 中，
    /// 掩码到 32 位，因此循环右移的部分以零补入，
    /// 而不是 <c>int</c> 会带入的符号位。</summary>
    static long Rotl32(long x, int n) {
        long m = x & 4294967295;
        return ((m << n) | (m >> (32 - n))) & 4294967295;
    }

    /// <summary>计算 <paramref name="data"/> 前 <paramref
    /// name="len"/> 个字节的 20 字节 SHA-1 摘要，写入
    /// 调用方持有的 20 字节缓冲区 <paramref name="digest"/>。消息长度
    /// 最高支持 2^29 字节（64 位长度字段由 32 位
    /// 位计数写出），足以覆盖此处的握手/哈希用途。</summary>
    static void Sha1(string data, int len, byte[] digest) {
        long h0 = 1732584193;   // 0x67452301
        long h1 = 4023233417;   // 0xEFCDAB89
        long h2 = 2562383102;   // 0x98BADCFE
        long h3 = 271733878;    // 0x10325476
        long h4 = 3285377520;   // 0xC3D2E1F0

        int bitLen = len * 8;
        int fullLen = len + 1;
        while ((fullLen % 64) != 56) {
            fullLen = fullLen + 1;
        }
        fullLen = fullLen + 8;

        byte[] msg = new byte[fullLen + 1];
        for (int i = 0; i < len; i = i + 1) {
            msg[i] = (byte)data[i];
        }
        msg[len] = 128;   // 0x80 终止符；后续字节已为零
        msg[fullLen - 4] = (byte)((bitLen >> 24) & 255);
        msg[fullLen - 3] = (byte)((bitLen >> 16) & 255);
        msg[fullLen - 2] = (byte)((bitLen >> 8) & 255);
        msg[fullLen - 1] = (byte)(bitLen & 255);

        long[] w = new long[80];
        int chunk = 0;
        while (chunk < fullLen) {
            int t = 0;
            for (; t < 16; t = t + 1) {
                int j = chunk + t * 4;
                w[t] = ((long)(msg[j] & 255) << 24) | ((long)(msg[j + 1] & 255) << 16) |
                       ((long)(msg[j + 2] & 255) << 8) | (long)(msg[j + 3] & 255);
            }
            t = 16;
            while (t < 80) {
                long x = w[t - 3] ^ w[t - 8] ^ w[t - 14] ^ w[t - 16];
                w[t] = Rotl32(x, 1);
                t = t + 1;
            }

            long a = h0;
            long b = h1;
            long c = h2;
            long d = h3;
            long e = h4;
            t = 0;
            while (t < 80) {
                long f = 0;
                long k = 0;
                if (t < 20) {
                    f = (b & c) | ((b ^ 4294967295) & d);
                    k = 1518500249;    // 0x5A827999
                } else if (t < 40) {
                    f = b ^ c ^ d;
                    k = 1859775393;    // 0x6ED9EBA1
                } else if (t < 60) {
                    f = (b & c) | (b & d) | (c & d);
                    k = 2400959708;    // 0x8F1BBCDC
                } else {
                    f = b ^ c ^ d;
                    k = 3395469782;    // 0xCA62C1D6
                }
                long tmp = (Rotl32(a, 5) + (f & 4294967295) + (e & 4294967295) +
                           (k & 4294967295) + (w[t] & 4294967295)) & 4294967295;
                e = d;
                d = c;
                c = Rotl32(b, 30);
                b = a;
                a = tmp;
                t = t + 1;
            }

            h0 = (h0 + a) & 4294967295;
            h1 = (h1 + b) & 4294967295;
            h2 = (h2 + c) & 4294967295;
            h3 = (h3 + d) & 4294967295;
            h4 = (h4 + e) & 4294967295;
            chunk = chunk + 64;
        }

        digest[0] = (byte)((h0 >> 24) & 255);
        digest[1] = (byte)((h0 >> 16) & 255);
        digest[2] = (byte)((h0 >> 8) & 255);
        digest[3] = (byte)(h0 & 255);
        digest[4] = (byte)((h1 >> 24) & 255);
        digest[5] = (byte)((h1 >> 16) & 255);
        digest[6] = (byte)((h1 >> 8) & 255);
        digest[7] = (byte)(h1 & 255);
        digest[8] = (byte)((h2 >> 24) & 255);
        digest[9] = (byte)((h2 >> 16) & 255);
        digest[10] = (byte)((h2 >> 8) & 255);
        digest[11] = (byte)(h2 & 255);
        digest[12] = (byte)((h3 >> 24) & 255);
        digest[13] = (byte)((h3 >> 16) & 255);
        digest[14] = (byte)((h3 >> 8) & 255);
        digest[15] = (byte)(h3 & 255);
        digest[16] = (byte)((h4 >> 24) & 255);
        digest[17] = (byte)((h4 >> 16) & 255);
        digest[18] = (byte)((h4 >> 8) & 255);
        digest[19] = (byte)(h4 & 255);
    }

    /// <summary>计算 RFC 6455 <c>Sec-WebSocket-Accept</c> 的值，用于客户端的
    /// <c>Sec-WebSocket-Key</c>：base64(SHA1(key + GUID))。这是
    /// WebSocket 服务器必须回应的握手响应，标准浏览器与
    /// 库客户端才会接受升级。</summary>
    static string WebSocketAccept(string key) {
        string combined = key + "258EAFA5-E914-47DA-95CA-C5AB0DC85B11";
        int len = (int)strlen(combined);
        byte[] digest = new byte[21];
        Sha1(combined, len, digest);
        return Base64EncodeBytes(digest, 20);
    }
}
