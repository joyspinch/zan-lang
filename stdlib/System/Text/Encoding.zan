using System;

namespace System.Text;

/// <summary>
/// Cross-platform text encoding and conversion utilities.
/// Uses C runtime functions available on all platforms.
/// </summary>
class Encoding {
    [DllImport("crt")]
    static extern long strlen(string str);

    /// <summary>Converts an integer to a string. Written digit by digit
    /// rather than with sprintf: variadic C functions follow a different ABI
    /// on Darwin arm64 (stack, not registers), so FFI varargs calls corrupt
    /// their arguments there.</summary>
    static string IntToString(int val) {
        byte[] buf = new byte[32];
        int v = val;
        int neg = 0;
        if (v < 0) { neg = 1; v = 0 - v; }
        int end = 31;
        int i = end;
        if (v == 0) { i = i - 1; buf[i] = 48; }
        while (v > 0) {
            i = i - 1;
            buf[i] = (byte)(48 + v % 10);
            v = v / 10;
        }
        if (neg == 1) { i = i - 1; buf[i] = 45; }
        return buf.ToStr(i, end - i);
    }

    /// <summary>Converts a double to a string.</summary>
    static string DoubleToString(double val) {
        return "" + val;
    }

    /// <summary>Parses a string to an integer, matching C atoi: skips leading
    /// whitespace, an optional sign, then decimal digits until the first
    /// non-digit. Returns 0 when no digits are present.</summary>
    static int ParseInt(string text) {
        int len = text.Length;
        int i = 0;
        while (i < len) {
            int c = text[i] & 255;
            if (c == 32 || c == 9 || c == 10 || c == 13) { i = i + 1; } else { break; }
        }
        int sign = 1;
        if (i < len) {
            int c = text[i] & 255;
            if (c == 43) { i = i + 1; } else if (c == 45) { sign = -1; i = i + 1; }
        }
        int val = 0;
        while (i < len) {
            int c = text[i] & 255;
            if (c < 48 || c > 57) { break; }
            val = val * 10 + (c - 48);
            i = i + 1;
        }
        return sign * val;
    }

    /// <summary>Parses a string to a double, matching C atof: optional sign,
    /// integer and fractional parts, and an optional decimal exponent
    /// (e/E). Returns 0 when no digits are present.</summary>
    static double ParseDouble(string text) {
        int len = text.Length;
        int i = 0;
        while (i < len) {
            int c = text[i] & 255;
            if (c == 32 || c == 9 || c == 10 || c == 13) { i = i + 1; } else { break; }
        }
        double sign = 1.0;
        if (i < len) {
            int c = text[i] & 255;
            if (c == 43) { i = i + 1; } else if (c == 45) { sign = -1.0; i = i + 1; }
        }
        double val = 0.0;
        while (i < len) {
            int c = text[i] & 255;
            if (c < 48 || c > 57) { break; }
            val = val * 10.0 + (double)(c - 48);
            i = i + 1;
        }
        if (i < len && (text[i] & 255) == 46) {
            i = i + 1;
            double frac = 0.1;
            while (i < len) {
                int c = text[i] & 255;
                if (c < 48 || c > 57) { break; }
                val = val + (double)(c - 48) * frac;
                frac = frac * 0.1;
                i = i + 1;
            }
        }
        if (i < len) {
            int c = text[i] & 255;
            if (c == 101 || c == 69) {
                i = i + 1;
                int esign = 1;
                if (i < len) {
                    int c2 = text[i] & 255;
                    if (c2 == 43) { i = i + 1; } else if (c2 == 45) { esign = -1; i = i + 1; }
                }
                int exp = 0;
                while (i < len) {
                    int c2 = text[i] & 255;
                    if (c2 < 48 || c2 > 57) { break; }
                    exp = exp * 10 + (c2 - 48);
                    i = i + 1;
                }
                double p = 1.0;
                int k = 0;
                while (k < exp) { p = p * 10.0; k = k + 1; }
                if (esign > 0) { val = val * p; } else { val = val / p; }
            }
        }
        return sign * val;
    }

    /// <summary>Gets the byte count of a UTF-8 string.</summary>
    static int GetByteCount(string text) {
        return (int)strlen(text);
    }

    /// <summary>Converts a byte value to a hex string (two characters).</summary>
    static string ByteToHex(int b) {
        string hex = "0123456789abcdef";
        return hex.Substring((b >> 4) & 15, 1) + hex.Substring(b & 15, 1);
    }

    /// <summary>Value of a single hex digit (0-9, a-f, A-F), or -1 if invalid.</summary>
    static int HexDigit(int c) {
        if (c >= 48 && c <= 57) { return c - 48; }
        if (c >= 97 && c <= 102) { return c - 87; }
        if (c >= 65 && c <= 70) { return c - 55; }
        return -1;
    }

    /// <summary>Builds a one-character string holding the given byte value.</summary>
    static string CharFromCode(int code) {
        byte[] s = new byte[2];
        s[0] = (byte)(code & 255);
        return s.ToStr(0, 1);
    }

    /// <summary>URL-encodes a string.</summary>
    static string UrlEncode(string text) {
        StringBuilder sb = new StringBuilder();
        int i = 0;
        int len = text.Length;
        while (i < len) {
            string ch = text.Substring(i, 1);
            if ((ch >= "A" && ch <= "Z") || (ch >= "a" && ch <= "z") ||
                (ch >= "0" && ch <= "9") || ch == "-" || ch == "_" ||
                ch == "." || ch == "~") {
                sb.Append(ch);
            } else if (ch == " ") {
                sb.Append("+");
            } else {
                sb.Append("%");
                // Simplified: append hex of the char
                sb.Append(ByteToHex(ch[0]));
            }
            i = i + 1;
        }
        return sb.ToString();
    }

    /// <summary>URL-decodes an application/x-www-form-urlencoded string:
    /// '+' becomes a space and each %XX escape is decoded to its byte.
    /// A malformed escape is left verbatim.</summary>
    static string UrlDecode(string text) {
        StringBuilder sb = new StringBuilder();
        int i = 0;
        int len = text.Length;
        while (i < len) {
            int c = text[i] & 255;
            if (c == 43) {
                sb.Append(" ");
                i = i + 1;
            } else if (c == 37 && i + 2 < len) {
                int h = Encoding.HexDigit(text[i + 1] & 255);
                int l = Encoding.HexDigit(text[i + 2] & 255);
                if (h >= 0 && l >= 0) {
                    sb.Append(Encoding.CharFromCode(h * 16 + l));
                    i = i + 3;
                } else {
                    sb.Append("%");
                    i = i + 1;
                }
            } else {
                sb.Append(text.Substring(i, 1));
                i = i + 1;
            }
        }
        return sb.ToString();
    }

    /// <summary>Escapes text for safe embedding in HTML element or attribute
    /// content (&lt; &gt; &amp; &quot; &#39;).</summary>
    static string HtmlEncode(string text) {
        StringBuilder sb = new StringBuilder();
        int i = 0;
        int len = text.Length;
        while (i < len) {
            int c = text[i] & 255;
            if (c == 60) { sb.Append("&lt;"); }
            else if (c == 62) { sb.Append("&gt;"); }
            else if (c == 38) { sb.Append("&amp;"); }
            else if (c == 34) { sb.Append("&quot;"); }
            else if (c == 39) { sb.Append("&#39;"); }
            else { sb.Append(text.Substring(i, 1)); }
            i = i + 1;
        }
        return sb.ToString();
    }

    /// <summary>Escapes text for use inside a JSON string literal (the caller
    /// supplies the surrounding quotes). Control chars below 0x20 that are not
    /// \n \r \t become a space.</summary>
    static string JsonEscape(string text) {
        int len = text.Length;
        int i = 0;
        while (i < len) {
            int c = text[i] & 255;
            if (c == 34 || c == 92 || c < 32) { break; }
            i = i + 1;
        }
        if (i == len) { return text; }   // nothing to escape (common case)
        StringBuilder sb = new StringBuilder();
        if (i > 0) { sb.Append(text.Substring(0, i)); }
        while (i < len) {
            int c = text[i] & 255;
            if (c == 34) { sb.Append("\\\""); }
            else if (c == 92) { sb.Append("\\\\"); }
            else if (c == 10) { sb.Append("\\n"); }
            else if (c == 13) { sb.Append("\\r"); }
            else if (c == 9) { sb.Append("\\t"); }
            else if (c < 32) { sb.Append(" "); }
            else {
                int run = i;
                while (run < len) {
                    int c2 = text[run] & 255;
                    if (c2 == 34 || c2 == 92 || c2 < 32) { break; }
                    run = run + 1;
                }
                sb.Append(text.Substring(i, run - i));
                i = run;
                continue;
            }
            i = i + 1;
        }
        return sb.ToString();
    }

    /// <summary>Base64 encodes a string.</summary>
    static string Base64Encode(string text) {
        string chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
        StringBuilder sb = new StringBuilder();
        int i = 0;
        int len = (int)strlen(text);
        while (i < len) {
            int b0 = text[i] & 255;
            int b1 = 0;
            int b2 = 0;
            int pad = 0;
            if (i + 1 < len) {
                b1 = text[i + 1] & 255;
            } else {
                pad = pad + 1;
            }
            if (i + 2 < len) {
                b2 = text[i + 2] & 255;
            } else {
                pad = pad + 1;
            }
            int triple = (b0 << 16) + (b1 << 8) + b2;
            sb.Append(chars.Substring((triple >> 18) & 63, 1));
            sb.Append(chars.Substring((triple >> 12) & 63, 1));
            if (pad < 2) {
                sb.Append(chars.Substring((triple >> 6) & 63, 1));
            } else {
                sb.Append("=");
            }
            if (pad < 1) {
                sb.Append(chars.Substring(triple & 63, 1));
            } else {
                sb.Append("=");
            }
            i = i + 3;
        }
        return sb.ToString();
    }

    /// <summary>Base64-encodes <paramref name="len"/> raw bytes from
    /// <paramref name="data"/>. Binary-safe: the length is explicit, so embedded
    /// NUL bytes (e.g. a SHA-1 digest) are encoded rather than truncated the way
    /// the strlen-based <see cref="Base64Encode"/> would.</summary>
    static string Base64EncodeBytes(string data, int len) {
        string chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
        StringBuilder sb = new StringBuilder();
        int i = 0;
        while (i < len) {
            int b0 = data[i] & 255;
            int b1 = 0;
            int b2 = 0;
            int pad = 0;
            if (i + 1 < len) {
                b1 = data[i + 1] & 255;
            } else {
                pad = pad + 1;
            }
            if (i + 2 < len) {
                b2 = data[i + 2] & 255;
            } else {
                pad = pad + 1;
            }
            int triple = (b0 << 16) + (b1 << 8) + b2;
            sb.Append(chars.Substring((triple >> 18) & 63, 1));
            sb.Append(chars.Substring((triple >> 12) & 63, 1));
            if (pad < 2) {
                sb.Append(chars.Substring((triple >> 6) & 63, 1));
            } else {
                sb.Append("=");
            }
            if (pad < 1) {
                sb.Append(chars.Substring(triple & 63, 1));
            } else {
                sb.Append("=");
            }
            i = i + 3;
        }
        return sb.ToString();
    }

    /// <summary>32-bit left rotate. The lane travels in a <c>long</c> and is
    /// masked to 32 bits, so the right half of the rotate shifts in zeroes
    /// instead of the sign bit an <c>int</c> lane would carry.</summary>
    static long Rotl32(long x, int n) {
        long m = x & 4294967295;
        return ((m << n) | (m >> (32 - n))) & 4294967295;
    }

    /// <summary>Computes the 20-byte SHA-1 digest of the first <paramref
    /// name="len"/> bytes of <paramref name="data"/> and writes it into the
    /// caller-owned 20-byte buffer <paramref name="digest"/>. Message lengths up
    /// to 2^29 bytes are supported (the 64-bit length field is written from a
    /// 32-bit bit count), which covers the handshake/hashing uses here.</summary>
    static void Sha1(string data, int len, byte[] digest) {
        long h0 = 1732584193;   // 0x67452301
        long h1 = 4023233417;   // 0xEFCDAB89
        long h2 = 2562383102;   // 0x98BADCFE
        long h3 = 271733878;    // 0x10325476
        long h4 = 3285377520;   // 0xC3D2E1F0

        int bitLen = len * 8;
        int fullLen = len + 1;
        while ((fullLen % 64) != 56) {
            fullLen = fullLen + 1;
        }
        fullLen = fullLen + 8;

        byte[] msg = new byte[fullLen + 1];
        int i = 0;
        while (i < len) {
            msg[i] = (byte)data[i];
            i = i + 1;
        }
        msg[len] = 128;   // 0x80 terminator; trailing bytes are already zero
        msg[fullLen - 4] = (byte)((bitLen >> 24) & 255);
        msg[fullLen - 3] = (byte)((bitLen >> 16) & 255);
        msg[fullLen - 2] = (byte)((bitLen >> 8) & 255);
        msg[fullLen - 1] = (byte)(bitLen & 255);

        long[] w = new long[80];
        int chunk = 0;
        while (chunk < fullLen) {
            int t = 0;
            while (t < 16) {
                int j = chunk + t * 4;
                w[t] = ((long)(msg[j] & 255) << 24) | ((long)(msg[j + 1] & 255) << 16) |
                       ((long)(msg[j + 2] & 255) << 8) | (long)(msg[j + 3] & 255);
                t = t + 1;
            }
            t = 16;
            while (t < 80) {
                long x = w[t - 3] ^ w[t - 8] ^ w[t - 14] ^ w[t - 16];
                w[t] = Rotl32(x, 1);
                t = t + 1;
            }

            long a = h0;
            long b = h1;
            long c = h2;
            long d = h3;
            long e = h4;
            t = 0;
            while (t < 80) {
                long f = 0;
                long k = 0;
                if (t < 20) {
                    f = (b & c) | ((b ^ 4294967295) & d);
                    k = 1518500249;    // 0x5A827999
                } else if (t < 40) {
                    f = b ^ c ^ d;
                    k = 1859775393;    // 0x6ED9EBA1
                } else if (t < 60) {
                    f = (b & c) | (b & d) | (c & d);
                    k = 2400959708;    // 0x8F1BBCDC
                } else {
                    f = b ^ c ^ d;
                    k = 3395469782;    // 0xCA62C1D6
                }
                long tmp = (Rotl32(a, 5) + (f & 4294967295) + (e & 4294967295) +
                           (k & 4294967295) + (w[t] & 4294967295)) & 4294967295;
                e = d;
                d = c;
                c = Rotl32(b, 30);
                b = a;
                a = tmp;
                t = t + 1;
            }

            h0 = (h0 + a) & 4294967295;
            h1 = (h1 + b) & 4294967295;
            h2 = (h2 + c) & 4294967295;
            h3 = (h3 + d) & 4294967295;
            h4 = (h4 + e) & 4294967295;
            chunk = chunk + 64;
        }

        digest[0] = (byte)((h0 >> 24) & 255);
        digest[1] = (byte)((h0 >> 16) & 255);
        digest[2] = (byte)((h0 >> 8) & 255);
        digest[3] = (byte)(h0 & 255);
        digest[4] = (byte)((h1 >> 24) & 255);
        digest[5] = (byte)((h1 >> 16) & 255);
        digest[6] = (byte)((h1 >> 8) & 255);
        digest[7] = (byte)(h1 & 255);
        digest[8] = (byte)((h2 >> 24) & 255);
        digest[9] = (byte)((h2 >> 16) & 255);
        digest[10] = (byte)((h2 >> 8) & 255);
        digest[11] = (byte)(h2 & 255);
        digest[12] = (byte)((h3 >> 24) & 255);
        digest[13] = (byte)((h3 >> 16) & 255);
        digest[14] = (byte)((h3 >> 8) & 255);
        digest[15] = (byte)(h3 & 255);
        digest[16] = (byte)((h4 >> 24) & 255);
        digest[17] = (byte)((h4 >> 16) & 255);
        digest[18] = (byte)((h4 >> 8) & 255);
        digest[19] = (byte)(h4 & 255);
    }

    /// <summary>Computes the RFC 6455 <c>Sec-WebSocket-Accept</c> value for a
    /// client's <c>Sec-WebSocket-Key</c>: base64(SHA1(key + GUID)). This is the
    /// handshake response a WebSocket server must echo for standard browser and
    /// library clients to accept the upgrade.</summary>
    static string WebSocketAccept(string key) {
        string combined = key + "258EAFA5-E914-47DA-95CA-C5AB0DC85B11";
        int len = (int)strlen(combined);
        byte[] digest = new byte[21];
        Sha1(combined, len, digest);
        return Base64EncodeBytes(digest, 20);
    }
}
