using System;

namespace System.Text;

// 空安全字符串小工具（收口各包重复的 Trim/StartsWith null 包装）。
//
// 契约：入参 s 为 null 时按 dflt 处理，不抛异常；非 null 时行为与
// string 实例方法一致（Trim 去两端空白、StartsWith 按序比较）。
public static class TextUtil {
    // 去除 s 首尾空白；s 为 null 时返回 dflt。
    public static string TrimOr(string s, string dflt) {
        if (s == null) { return dflt; }
        return s.Trim();
    }

    // s 是否以 prefix 开头；s 或 prefix 为 null 时返回 dflt。
    public static bool StartsWithOr(string s, string prefix, bool dflt) {
        if (s == null || prefix == null) { return dflt; }
        return s.StartsWith(prefix);
    }

    // 去除 s 首尾空白；s 为 null 时返回空串（TrimOr(s, "") 的简写）。
    public static string TrimOrEmpty(string s) {
        return TextUtil.TrimOr(s, "");
    }
}
