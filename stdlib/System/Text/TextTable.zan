using System;

namespace System.Text;

/// <summary>
/// Aligns rows into a text table for console/CLI output.
///
///   TextTable t = TextTable.Create(new string[] { "Name", "Count" });
///   t.AddRow(new string[] { "a", "1" });
///   t.AddRow(new string[] { "longer", "42" });
///   Console.WriteLine(t.Render());
///
/// Renders:
///   +--------+-------+
///   | Name   | Count |
///   +--------+-------+
///   | a      | 1     |
///   | longer | 42    |
///   +--------+-------+
/// </summary>
class TextTable {
    List<string> headers;
    List<List<string>> rows = new List<List<string>>();
    int[] widths;

    /// Creates a table with the given column headers.
    static TextTable Create(List<string> headers) {
        TextTable t = new TextTable();
        t.headers = headers;
        t.widths = new int[headers.Count];
        int i = 0;
        while (i < headers.Count) {
            t.widths[i] = headers[i].Length;
            i = i + 1;
        }
        return t;
    }

    /// <summary>Appends a row. A row shorter than the header list is padded
    /// with empty cells; a longer one is truncated.</summary>
    void AddRow(List<string> row) {
        int i = 0;
        while (i < row.Count && i < headers.Count) {
            if (row[i].Length > widths[i]) { widths[i] = row[i].Length; }
            i = i + 1;
        }
        rows.Add(row);
    }

    /// <summary>Renders the aligned table (ASCII border).</summary>
    string Render() {
        StringBuilder sb = new StringBuilder();
        sb.Append(TextTable.Border(widths));
        sb.Append("\n");
        sb.Append(TextTable.Line(headers, widths));
        sb.Append("\n");
        sb.Append(TextTable.Border(widths));
        sb.Append("\n");
        int r = 0;
        while (r < rows.Count) {
            sb.Append(TextTable.Line(rows[r], widths));
            sb.Append("\n");
            r = r + 1;
        }
        sb.Append(TextTable.Border(widths));
        return sb.ToString();
    }

    static string Border(int[] widths) {
        StringBuilder sb = new StringBuilder();
        sb.Append("+");
        int i = 0;
        while (i < widths.Length) {
            int w = widths[i] + 2;
            int k = 0;
            while (k < w) { sb.Append("-"); k = k + 1; }
            sb.Append("+");
            i = i + 1;
        }
        return sb.ToString();
    }

    static string Line(List<string> cells, int[] widths) {
        StringBuilder sb = new StringBuilder();
        sb.Append("|");
        int i = 0;
        while (i < widths.Length) {
            string cell = "";
            if (i < cells.Count) { cell = cells[i]; }
            sb.Append(" ");
            sb.Append(cell);
            int pad = widths[i] - cell.Length;
            int k = 0;
            while (k < pad) { sb.Append(" "); k = k + 1; }
            sb.Append(" |");
            i = i + 1;
        }
        return sb.ToString();
    }
}
