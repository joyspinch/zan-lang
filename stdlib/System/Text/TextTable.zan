using System;

namespace System.Text;

/// <summary>
/// Aligns rows into a text table for console/CLI output.
///
///   TextTable t = new TextTable(new string[] { "Name", "Count" });
///   t.AddRow(new string[] { "a", "1" });
///   t.AddRow(new string[] { "longer", "42" });
///   Console.WriteLine(t.Render());
///
/// Renders:
///   +--------+-------+
///   | Name   | Count |
///   +--------+-------+
///   | a      | 1     |
///   | longer | 42    |
///   +--------+-------+
/// </summary>
class TextTable {
    List<string> headers;
    List<List<string>> rows = new List<List<string>>();
    int[] widths;

    TextTable(List<string> headers) {
        this.headers = headers;
        this.widths = new int[headers.Count];
        for (int i = 0; i < headers.Count; i = i + 1) {
            this.widths[i] = headers[i].Length;
        }
    }

    /// <summary>Appends a row. A row shorter than the header list is padded
    /// with empty cells; a longer one is truncated.</summary>
    void AddRow(List<string> row) {
        for (int i = 0; i < row.Count && i < headers.Count; i = i + 1) {
            if (row[i].Length > widths[i]) { widths[i] = row[i].Length; }
        }
        rows.Add(row);
    }

    /// <summary>Renders the aligned table (ASCII border).</summary>
    string Render() {
        StringBuilder sb = new StringBuilder();
        sb.Append(TextTable.Border(widths));
        sb.Append("\n");
        sb.Append(TextTable.Line(headers, widths));
        sb.Append("\n");
        sb.Append(TextTable.Border(widths));
        sb.Append("\n");
        for (int r = 0; r < rows.Count; r = r + 1) {
            sb.Append(TextTable.Line(rows[r], widths));
            sb.Append("\n");
        }
        sb.Append(TextTable.Border(widths));
        return sb.ToString();
    }

    static string Border(int[] widths) {
        StringBuilder sb = new StringBuilder();
        sb.Append("+");
        for (int i = 0; i < widths.Length; i = i + 1) {
            int w = widths[i] + 2;
            for (int k = 0; k < w; k = k + 1) { sb.Append("-"); }
            sb.Append("+");
        }
        return sb.ToString();
    }

    static string Line(List<string> cells, int[] widths) {
        StringBuilder sb = new StringBuilder();
        sb.Append("|");
        for (int i = 0; i < widths.Length; i = i + 1) {
            string cell = "";
            if (i < cells.Count) { cell = cells[i]; }
            sb.Append(" ");
            sb.Append(cell);
            int pad = widths[i] - cell.Length;
            for (int k = 0; k < pad; k = k + 1) { sb.Append(" "); }
            sb.Append(" |");
        }
        return sb.ToString();
    }
}
