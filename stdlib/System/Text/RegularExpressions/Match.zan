using System;

namespace System.Text.RegularExpressions;

/// <summary>
/// The result of one regular-expression match: where it started, what it
/// covered, and the text each capturing group took.
///
///   Match m = re.Find("order 42");
///   if (m.Success()) {
///       Console.WriteLine(m.Value() + " at " + m.Index());
///       Console.WriteLine(m.Group(1));
///   }
///
/// Group 0 is the whole match. A group that did not take part reports
/// Index -1 and "" as its value.
/// </summary>
class Match {
    bool success;
    string input;
    List<int> caps;
    int groups;

    Match() {
        this.success = false;
        this.input = "";
        this.caps = new List<int>();
        this.groups = 0;
    }

    /// <summary>Builds a failed match (what Find returns for no match).</summary>
    static Match Failure() {
        return new Match();
    }

    /// <summary>Builds a match from raw capture offsets.</summary>
    static Match FromCaps(string input, List<int> caps, int groups) {
        Match m = new Match();
        m.success = true;
        m.input = input;
        m.groups = groups;
        for (int i = 0; i < caps.Count; i = i + 1) {
            m.caps.Add(caps[i]);
        }
        return m;
    }

    /// <summary>True when the pattern matched.</summary>
    bool Success() { return this.success; }

    /// <summary>Start offset of the whole match, or -1.</summary>
    int Index() { return this.GroupIndex(0); }

    /// <summary>Length of the whole match, or 0.</summary>
    int Length() { return this.GroupLength(0); }

    /// <summary>The matched text, or "".</summary>
    string Value() { return this.Group(0); }

    /// <summary>Number of groups including group 0.</summary>
    int GroupCount() { return this.groups; }

    /// <summary>Start offset of group `n`, or -1 when it did not
    /// participate.</summary>
    int GroupIndex(int n) {
        if (!this.success || n < 0 || n >= this.groups) { return -1; }
        return this.caps[n * 2];
    }

    /// <summary>Length of group `n`, or 0.</summary>
    int GroupLength(int n) {
        if (!this.success || n < 0 || n >= this.groups) { return 0; }
        int s = this.caps[n * 2];
        int e = this.caps[n * 2 + 1];
        if (s < 0 || e < s) { return 0; }
        return e - s;
    }

    /// <summary>Text of group `n`, or "".</summary>
    string Group(int n) {
        int s = this.GroupIndex(n);
        int len = this.GroupLength(n);
        if (s < 0) { return ""; }
        return this.input.Substring(s, len);
    }

    /// <summary>True when group `n` took part in the match.</summary>
    bool GroupSuccess(int n) {
        return this.GroupIndex(n) >= 0;
    }
}
