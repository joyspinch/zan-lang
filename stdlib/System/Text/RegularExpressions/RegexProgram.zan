using System;

namespace System.Text.RegularExpressions;

/// <summary>
/// 模式的编译形态及其执行引擎：模式被解析为小型指令程序
/// （Thompson 风格：Char / Any / Class / Split / Jmp / Save / 断言），
/// 由回溯解释器对输入执行。
///
/// 指令存放于四个并行的 int 列表（op / x / y / z），无需为模式的
/// 每个字符分配对象；解释器通过字节缓冲区而非 Substring 读取输入。
/// 匹配的单位是 **UTF-8 码点**：`.`、字符类和字面量都按整个码点
/// 前进，因此 `^.$` 能匹配 "中"、`[中文]` 是合法的类。
///
/// 这是 <see cref="Regex"/> 的实现细节，请直接使用 Regex。
///
/// 支持的语法：字面量、`.`、带范围/取反的字符类（类内可用
/// `\d \D \w \W \s \S` 与 POSIX `[:alpha:]` 等）、`\b \B \A \z \Z \G`、
/// 转义 `\n \r \t \f \v \a \e \0 \xHH \x{HH..} \uXXXX \cX`、
/// 分组 `( )` `(?: )` `(?<name> )`、原子组 `(?> )`、注释 `(?# )`、
/// 环视 `(?= ) (?! ) (?<= ) (?<! )`（回顾须定长）、交替 `|`、
/// 量词 `* + ? {n} {n,} {n,m}`（均有惰性 `?` 形式）、
/// 锚点 `^ $`、反向引用 `\1`-`\99` 与 `\k&lt;name&gt;`，
/// 以及只能出现在模式开头的内联标志 `(?i)(?m)(?s)`。
///
/// 不支持的语法一律在编译期报错，绝不"接受但永不匹配"。
/// </summary>
class RegexProgram {
    // 操作码
    static int OpChar() { return 1; }
    static int OpAny() { return 2; }
    static int OpClass() { return 3; }
    static int OpMatch() { return 4; }
    static int OpJmp() { return 5; }
    static int OpSplit() { return 6; }
    static int OpSave() { return 7; }
    static int OpBol() { return 8; }
    static int OpEol() { return 9; }
    static int OpWordB() { return 10; }
    static int OpBackref() { return 11; }
    static int OpBos() { return 12; }      // \A
    static int OpEos() { return 13; }      // \z（ax=1 时为 \Z）
    static int OpGpos() { return 14; }     // \G
    static int OpMark() { return 15; }     // 记录 sp，供空循环检查
    static int OpEmptyChk() { return 16; } // 本轮没前进就跳出循环
    static int OpLook() { return 17; }     // 环视 / 原子组
    static int OpLookEnd() { return 18; }  // 环视子程序的终点

    // 环视种类（OpLook.ax）
    static int LookAhead() { return 0; }
    static int LookAheadNeg() { return 1; }
    static int LookBehind() { return 2; }
    static int LookBehindNeg() { return 3; }
    static int LookAtomic() { return 4; }

    // 字符类成员种类（clsKind）
    static int MemRange() { return 0; }    // [lo, hi]
    static int MemNotSet() { return 1; }   // 不属于简写集合 lo（'d'/'w'/'s'）

    List<int> op;
    List<int> ax;
    List<int> ay;
    List<int> az;

    // 字符类：类 c 的成员位于 clsKind/clsLo/clsHi[clsStart[c] ..
    // clsStart[c] + clsCount[c])，当 clsNeg[c] == 1 时整类取反
    List<int> clsKind;
    List<int> clsLo;
    List<int> clsHi;
    List<int> clsStart;
    List<int> clsCount;
    List<int> clsNeg;

    // 命名组：groupNames[i] 对应 groupNums[i]
    List<string> groupNames;
    List<int> groupNums;

    int groups;         // 捕获组，组 0 为整个匹配
    int marks;          // 空循环检查用的槽位数
    bool ignoreCase;
    bool multiline;     // (?m)：^ $ 也匹配行边界
    bool dotAll;        // (?s)：. 也匹配 \n
    string pattern;
    string error;

    // 指向模式字节的解析游标
    nint pbuf;
    int plen;
    int ppos;

    RegexProgram() {
        this.op = new List<int>();
        this.ax = new List<int>();
        this.ay = new List<int>();
        this.az = new List<int>();
        this.clsKind = new List<int>();
        this.clsLo = new List<int>();
        this.clsHi = new List<int>();
        this.clsStart = new List<int>();
        this.clsCount = new List<int>();
        this.clsNeg = new List<int>();
        this.groupNames = new List<string>();
        this.groupNums = new List<int>();
        this.groups = 1;
        this.marks = 0;
        this.ignoreCase = false;
        this.multiline = false;
        this.dotAll = false;
        this.pattern = "";
        this.error = "";
        this.pbuf = 0;
        this.plen = 0;
        this.ppos = 0;
    }

    /// <summary>解析 `pattern`。之后检查 <see cref="Error"/>：
    /// 可用时为空字符串，否则为失败原因。</summary>
    static RegexProgram Compile(string pattern, bool ignoreCase) {
        RegexProgram p = new RegexProgram();
        p.pattern = pattern;
        p.ignoreCase = ignoreCase;
        p.plen = pattern.Length;
        p.pbuf = NativeMemory.Alloc(p.plen + 1);
        if (p.plen > 0) {
            NativeMemory.PutString(p.pbuf, 0, pattern, p.plen);
        }
        p.ParseInlineFlags();
        // 组 0 覆盖整个匹配
        p.Emit(RegexProgram.OpSave(), 0, 0, 0);
        p.ParseAlt();
        if (p.error.Length == 0 && p.ppos < p.plen) {
            p.error = "unexpected ')' at " + p.ppos;
        }
        p.Emit(RegexProgram.OpSave(), 1, 0, 0);
        p.Emit(RegexProgram.OpMatch(), 0, 0, 0);
        NativeMemory.Free(p.pbuf);
        p.pbuf = 0;
        return p;
    }

    /// <summary>模式解析成功时返回 ""，否则返回失败原因。</summary>
    string Error() { return this.error; }

    /// <summary>捕获组数量，含组 0。</summary>
    int GroupCount() { return this.groups; }

    /// <summary>此程序编译所用的模式。</summary>
    string Pattern() { return this.pattern; }

    /// <summary>命名组 `name` 的组号，没有该名字时返回 -1。</summary>
    int GroupNumber(string name) {
        for (int i = 0; i < this.groupNames.Count; i = i + 1) {
            if (this.groupNames[i] == name) { return this.groupNums[i]; }
        }
        return -1;
    }

    /// <summary>所有命名组的名字（顺序与出现顺序一致）。</summary>
    List<string> GroupNames() {
        List<string> names = new List<string>();
        for (int i = 0; i < this.groupNames.Count; i = i + 1) {
            names.Add(this.groupNames[i]);
        }
        return names;
    }

    // ---- UTF-8 ---------------------------------------------------------

    /// <summary>解码 `buf + sp` 处的码点，返回 `(码点 &lt;&lt; 3) | 字节数`；
    /// sp 到达末尾时返回 -1。非法字节按 U+FFFD、1 字节处理，这样
    /// 引擎在任意字节串上都能前进而不会卡住。</summary>
    static int DecodeAt(nint buf, int len, int sp) {
        if (sp < 0 || sp >= len) { return -1; }
        int b0 = new Span<byte>(buf + sp, 1)[0];
        if (b0 < 128) { return (b0 * 8) | 1; }
        int need = 0;
        int cp = 0;
        if (b0 >= 240) {
            need = 3;
            cp = b0 - 240;
        } else if (b0 >= 224) {
            need = 2;
            cp = b0 - 224;
        } else if (b0 >= 192) {
            need = 1;
            cp = b0 - 192;
        } else {
            return (65533 * 8) | 1;
        }
        for (int k = 1; k <= need; k = k + 1) {
            if (sp + k >= len) { return (65533 * 8) | 1; }
            int b = new Span<byte>(buf + sp + k, 1)[0];
            if (b < 128 || b >= 192) { return (65533 * 8) | 1; }
            cp = cp * 64 + (b - 128);
        }
        return (cp * 8) | (need + 1);
    }

    /// <summary>从 `sp` 向后推进一个码点所需的字节数（至少 1）。
    /// 扫描下一个起点时用它，避免停在多字节字符的中间。</summary>
    static int StepWidth(nint buf, int len, int sp) {
        int packed = RegexProgram.DecodeAt(buf, len, sp);
        if (packed < 0) { return 1; }
        return packed & 7;
    }

    /// <summary>码点的 UTF-8 字节数。</summary>
    static int Utf8Len(int cp) {
        if (cp < 128) { return 1; }
        if (cp < 2048) { return 2; }
        if (cp < 65536) { return 3; }
        return 4;
    }

    // ---- 发射辅助 ----------------------------------------------------

    int Emit(int o, int x, int y, int z) {
        this.op.Add(o);
        this.ax.Add(x);
        this.ay.Add(y);
        this.az.Add(z);
        return this.op.Count - 1;
    }

    int Here() { return this.op.Count; }

    /// <summary>指令 `o` 的 x 字段是否是指令地址。</summary>
    static bool XIsPc(int o) {
        return o == RegexProgram.OpJmp() || o == RegexProgram.OpSplit();
    }

    /// <summary>指令 `o` 的 y 字段是否是指令地址。</summary>
    static bool YIsPc(int o) {
        return o == RegexProgram.OpSplit() || o == RegexProgram.OpLook()
            || o == RegexProgram.OpEmptyChk();
    }

    /// <summary>复制 [from, to) 区间的指令并追加，重定位跳转目标。
    /// 用于把 `{n,m}` 展开为重复副本。</summary>
    int CopyRange(int from, int to) {
        int delta = this.op.Count - from;
        int i = from;
        while (i < to) {
            int o = this.op[i];
            int x = this.ax[i];
            int y = this.ay[i];
            if (RegexProgram.XIsPc(o)) { x = x + delta; }
            if (RegexProgram.YIsPc(o)) { y = y + delta; }
            this.Emit(o, x, y, this.az[i]);
            i = i + 1;
        }
        return delta;
    }

    // ---- 模式游标 --------------------------------------------------

    int PeekAt(int i) {
        if (i < 0 || i >= this.plen) { return -1; }
        return new Span<byte>(this.pbuf + i, 1)[0];
    }

    int Peek() { return this.PeekAt(this.ppos); }

    int Next() {
        int c = this.Peek();
        this.ppos = this.ppos + 1;
        return c;
    }

    /// <summary>读取一个码点（多字节字面量按整体处理）。</summary>
    int NextCp() {
        int packed = RegexProgram.DecodeAt(this.pbuf, this.plen, this.ppos);
        if (packed < 0) {
            this.ppos = this.ppos + 1;
            return -1;
        }
        this.ppos = this.ppos + (packed & 7);
        return packed / 8;
    }

    // ---- 解析器 ----------------------------------------------------------

    /// <summary>只识别位于模式最开头的 `(?imsx...)`。作用域内联标志
    /// （`(?i:...)`）没有实现，会在 ParseGroup 里明确报错，而不是
    /// 被当成普通组"接受但永不匹配"。</summary>
    void ParseInlineFlags() {
        while (this.Peek() == 40 && this.PeekAt(this.ppos + 1) == 63) {   // "(?"
            int scan = this.ppos + 2;
            bool onlyFlags = false;
            while (scan < this.plen) {
                int c = this.PeekAt(scan);
                if (c == 105 || c == 109 || c == 115) {   // i m s
                    scan = scan + 1;
                } else if (c == 41) {                     // ')'
                    onlyFlags = scan > this.ppos + 2;
                    break;
                } else {
                    break;
                }
            }
            if (!onlyFlags) { return; }
            for (int i = this.ppos + 2; i < scan; i = i + 1) {
                int c = this.PeekAt(i);
                if (c == 105) { this.ignoreCase = true; }
                if (c == 109) { this.multiline = true; }
                if (c == 115) { this.dotAll = true; }
            }
            this.ppos = scan + 1;
        }
    }

    /// <summary>alt := seq ('|' seq)*  ->  split left, right ; left ; jmp end ;
    /// right ; end。重复的备选分支向左嵌套。</summary>
    void ParseAlt() {
        int start = this.Here();
        this.ParseSeq();
        while (this.Peek() == 124 && this.error.Length == 0) {      // '|'
            this.ppos = this.ppos + 1;
            int len = this.Here() - start;
            this.Shift(start, len, 1);
            int jmpOut = this.Emit(RegexProgram.OpJmp(), 0, 0, 0);
            this.op[start] = RegexProgram.OpSplit();
            this.ax[start] = start + 1;
            this.ay[start] = this.Here();
            this.ParseSeq();
            this.ax[jmpOut] = this.Here();
        }
    }

    /// <summary>seq := term*</summary>
    void ParseSeq() {
        bool more = true;
        while (more) {
            int c = this.Peek();
            if (c < 0 || c == 124 || c == 41) {   // 结束，或 '|'、')'
                more = false;
            } else {
                this.ParseTerm();
                if (this.error.Length > 0) { more = false; }
            }
        }
    }

    /// <summary>term := atom quantifier?</summary>
    void ParseTerm() {
        int start = this.Here();
        this.ParseAtom();
        if (this.error.Length > 0) { return; }
        this.ParseQuantifier(start);
    }

    void ParseQuantifier(int start) {
        int c = this.Peek();
        int min = -1;
        int max = -1;
        if (c == 42) {                        // '*'
            this.ppos = this.ppos + 1;
            min = 0;
            max = -1;
        } else if (c == 43) {                 // '+'
            this.ppos = this.ppos + 1;
            min = 1;
            max = -1;
        } else if (c == 63) {                 // '?'
            this.ppos = this.ppos + 1;
            min = 0;
            max = 1;
        } else if (c == 123) {                // '{'
            int save = this.ppos;
            this.ppos = this.ppos + 1;
            int lo = this.ParseInt();
            if (lo < 0) {
                this.ppos = save;
                return;
            }
            int hi = lo;
            if (this.Peek() == 44) {          // ','
                this.ppos = this.ppos + 1;
                if (this.Peek() == 125) {     // '}' -> {n,}
                    hi = -1;
                } else {
                    hi = this.ParseInt();
                    if (hi < 0) {
                        this.ppos = save;
                        return;
                    }
                }
            }
            if (this.Peek() != 125) {
                this.ppos = save;
                return;
            }
            this.ppos = this.ppos + 1;
            if (hi >= 0 && hi < lo) {
                this.error = "quantifier {" + lo + "," + hi + "} is out of order at "
                    + this.ppos;
                return;
            }
            min = lo;
            max = hi;
        } else {
            return;
        }
        bool lazy = false;
        if (this.Peek() == 63) {              // '?' -> 惰性
            this.ppos = this.ppos + 1;
            lazy = true;
        } else if (this.Peek() == 43) {       // '+' -> 占有量词
            this.error = "possessive quantifiers are not supported at " + this.ppos
                + "; use an atomic group (?>...)";
            return;
        }
        this.ApplyQuantifier(start, min, max, lazy);
    }

    int ParseInt() {
        int v = -1;
        int c = this.Peek();
        while (c >= 48 && c <= 57) {
            if (v < 0) { v = 0; }
            v = v * 10 + (c - 48);
            this.ppos = this.ppos + 1;
            c = this.Peek();
        }
        return v;
    }

    /// <summary>把已发射到 [start, end) 的原子改写成其重复形式。</summary>
    void ApplyQuantifier(int start, int min, int max, bool lazy) {
        int end = this.Here();
        int len = end - start;
        if (len <= 0) {
            this.error = "quantifier with nothing to repeat at " + this.ppos;
            return;
        }
        if (min == 0 && max == -1) {
            this.StarAt(start, len, lazy);
            return;
        }
        if (min == 1 && max == -1) {
            this.PlusAt(start, len, lazy);
            return;
        }
        if (min == 0 && max == 1) {
            this.OptionalAt(start, len, lazy);
            return;
        }
        if (max == 0) {
            // {0} / {0,0}：整段不参与匹配
            this.Truncate(start);
            return;
        }
        // {n,m}：保留已发射的副本作为第一次重复
        if (min == 0) {
            // 丢弃已发射的主体，重新添加为可选副本
            List<int> bo = new List<int>();
            List<int> bx = new List<int>();
            List<int> by = new List<int>();
            List<int> bz = new List<int>();
            for (int i = 0; i < len; i = i + 1) {
                bo.Add(this.op[start + i]);
                bx.Add(this.ax[start + i]);
                by.Add(this.ay[start + i]);
                bz.Add(this.az[start + i]);
            }
            this.Truncate(start);
            int reps = max;
            if (reps < 0) { reps = 1; }
            for (int r = 0; r < reps; r = r + 1) {
                int s = this.Here();
                this.AppendBody(bo, bx, by, bz, s - start);
                this.OptionalAt(s, len, lazy);
            }
            return;
        }
        int copies = min - 1;
        for (int k = 0; k < copies; k = k + 1) {
            this.CopyRange(start, start + len);
        }
        if (max == -1) {
            int s = this.Here();
            this.CopyRange(start, start + len);
            this.StarAt(s, len, lazy);
        } else {
            int extra = max - min;
            for (int e = 0; e < extra; e = e + 1) {
                int s = this.Here();
                this.CopyRange(start, start + len);
                this.OptionalAt(s, len, lazy);
            }
        }
    }

    void AppendBody(List<int> bo, List<int> bx, List<int> by, List<int> bz,
                    int delta) {
        for (int i = 0; i < bo.Count; i = i + 1) {
            int o = bo[i];
            int x = bx[i];
            int y = by[i];
            if (RegexProgram.XIsPc(o)) { x = x + delta; }
            if (RegexProgram.YIsPc(o)) { y = y + delta; }
            this.Emit(o, x, y, bz[i]);
        }
    }

    void Truncate(int n) {
        while (this.op.Count > n) {
            this.op.RemoveAt(this.op.Count - 1);
            this.ax.RemoveAt(this.ax.Count - 1);
            this.ay.RemoveAt(this.ay.Count - 1);
            this.az.RemoveAt(this.az.Count - 1);
        }
    }

    /// <summary>将 [start, start+len) 处的主体转换为 `body*`：
    ///   split body,out ; mark ; body ; emptychk out ; jmp split
    /// mark/emptychk 这一对负责空循环检查：主体这一轮没有前进
    /// （`(a*)*`）就直接跳出循环，
    /// 否则会无限迭代下去。</summary>
    void StarAt(int start, int len, bool lazy) {
        int slot = this.marks;
        this.marks = this.marks + 1;
        this.Shift(start, len, 2);
        int chk = this.Emit(RegexProgram.OpEmptyChk(), slot, 0, 0);
        this.Emit(RegexProgram.OpJmp(), start, 0, 0);
        int outPc = this.Here();
        this.ay[chk] = outPc;
        this.op[start + 1] = RegexProgram.OpMark();
        this.ax[start + 1] = slot;
        this.ay[start + 1] = 0;
        this.op[start] = RegexProgram.OpSplit();
        if (lazy) {
            this.ax[start] = outPc;
            this.ay[start] = start + 1;
        } else {
            this.ax[start] = start + 1;
            this.ay[start] = outPc;
        }
    }

    /// <summary>将 [start, start+len) 处的主体转换为 `body+`：
    ///   mark ; body ; emptychk out ; split back,out</summary>
    void PlusAt(int start, int len, bool lazy) {
        int slot = this.marks;
        this.marks = this.marks + 1;
        this.Shift(start, len, 1);
        this.op[start] = RegexProgram.OpMark();
        this.ax[start] = slot;
        this.ay[start] = 0;
        int chk = this.Emit(RegexProgram.OpEmptyChk(), slot, 0, 0);
        int sp = this.Emit(RegexProgram.OpSplit(), 0, 0, 0);
        this.ay[chk] = sp + 1;
        if (lazy) {
            this.ax[sp] = sp + 1;
            this.ay[sp] = start;
        } else {
            this.ax[sp] = start;
            this.ay[sp] = sp + 1;
        }
    }

    /// <summary>将 [start, start+len) 处的主体转换为 `body?`。</summary>
    void OptionalAt(int start, int len, bool lazy) {
        this.Shift(start, len, 1);
        int outPc = this.Here();
        this.op[start] = RegexProgram.OpSplit();
        if (lazy) {
            this.ax[start] = outPc;
            this.ay[start] = start + 1;
        } else {
            this.ax[start] = start + 1;
            this.ay[start] = outPc;
        }
    }

    /// <summary>在 [start, start+len) 处的主体前为 `n` 条指令腾出空间，
    /// 并重定位 start 处及之后的跳转目标。</summary>
    void Shift(int start, int len, int n) {
        int i = 0;
        for (; i < n; i = i + 1) {
            this.Emit(RegexProgram.OpJmp(), 0, 0, 0);
        }
        // 从末尾开始把主体上移 n 位，避免覆盖
        i = len - 1;
        while (i >= 0) {
            int o = this.op[start + i];
            int x = this.ax[start + i];
            int y = this.ay[start + i];
            if (RegexProgram.XIsPc(o) && x >= start) { x = x + n; }
            if (RegexProgram.YIsPc(o) && y >= start) { y = y + n; }
            this.op[start + n + i] = o;
            this.ax[start + n + i] = x;
            this.ay[start + n + i] = y;
            this.az[start + n + i] = this.az[start + i];
            i = i - 1;
        }
    }

    void ParseAtom() {
        int c = this.Peek();
        if (c == 40) {                        // '('
            this.ppos = this.ppos + 1;
            this.ParseGroup();
            return;
        }
        if (c == 46) {                        // '.'
            this.ppos = this.ppos + 1;
            this.Emit(RegexProgram.OpAny(), 0, 0, 0);
            return;
        }
        if (c == 94) {                        // '^'
            this.ppos = this.ppos + 1;
            this.Emit(RegexProgram.OpBol(), 0, 0, 0);
            return;
        }
        if (c == 36) {                        // '$'
            this.ppos = this.ppos + 1;
            this.Emit(RegexProgram.OpEol(), 0, 0, 0);
            return;
        }
        if (c == 91) {                        // '['
            this.ppos = this.ppos + 1;
            this.ParseClass();
            return;
        }
        if (c == 92) {                        // '\'
            this.ppos = this.ppos + 1;
            this.ParseEscape();
            return;
        }
        if (c == 42 || c == 43 || c == 63) {  // '*' '+' '?'
            this.error = "quantifier with nothing to repeat at " + this.ppos;
            return;
        }
        if (c < 0) {
            this.error = "unexpected end of pattern";
            return;
        }
        int cp = this.NextCp();
        this.Emit(RegexProgram.OpChar(), cp, 0, 0);
    }

    /// <summary>'(' 已消耗。处理捕获组、`(?:`、`(?#`、`(?=` `(?!`
    /// `(?&lt;=` `(?&lt;!`、`(?&gt;` 和 `(?&lt;name&gt;`。</summary>
    void ParseGroup() {
        if (this.Peek() != 63) {              // 普通捕获组
            this.ParseCaptureBody(this.NewGroup(""));
            return;
        }
        int k = this.PeekAt(this.ppos + 1);
        if (k == 58) {                        // "(?:"
            this.ppos = this.ppos + 2;
            this.ParseGroupTail(-1);
            return;
        }
        if (k == 35) {                        // "(?#" 注释
            this.ppos = this.ppos + 2;
            while (this.Peek() >= 0 && this.Peek() != 41) {
                this.ppos = this.ppos + 1;
            }
            if (this.Peek() != 41) {
                this.error = "missing ')' closing comment at " + this.ppos;
                return;
            }
            this.ppos = this.ppos + 1;
            return;
        }
        if (k == 61) {                        // "(?="
            this.ppos = this.ppos + 2;
            this.ParseLook(RegexProgram.LookAhead());
            return;
        }
        if (k == 33) {                        // "(?!"
            this.ppos = this.ppos + 2;
            this.ParseLook(RegexProgram.LookAheadNeg());
            return;
        }
        if (k == 62) {                        // "(?>"
            this.ppos = this.ppos + 2;
            this.ParseLook(RegexProgram.LookAtomic());
            return;
        }
        if (k == 60) {                        // "(?<..."
            int k2 = this.PeekAt(this.ppos + 2);
            if (k2 == 61) {                   // "(?<="
                this.ppos = this.ppos + 3;
                this.ParseLook(RegexProgram.LookBehind());
                return;
            }
            if (k2 == 33) {                   // "(?<!"
                this.ppos = this.ppos + 3;
                this.ParseLook(RegexProgram.LookBehindNeg());
                return;
            }
            this.ppos = this.ppos + 2;
            string name = this.ParseGroupName(62);   // '>'
            if (this.error.Length > 0) { return; }
            this.ParseCaptureBody(this.NewGroup(name));
            return;
        }
        if (k == 39) {                        // "(?'name'"
            this.ppos = this.ppos + 2;
            string name = this.ParseGroupName(39);
            if (this.error.Length > 0) { return; }
            this.ParseCaptureBody(this.NewGroup(name));
            return;
        }
        if (k == 80 && this.PeekAt(this.ppos + 2) == 60) {   // "(?P<name>"
            this.ppos = this.ppos + 3;
            string name = this.ParseGroupName(62);
            if (this.error.Length > 0) { return; }
            this.ParseCaptureBody(this.NewGroup(name));
            return;
        }
        if (k == 105 || k == 109 || k == 115) {   // i m s
            this.error = "inline flags are only supported at the start of the "
                + "pattern (at " + this.ppos + ")";
            return;
        }
        this.error = "unsupported group syntax '(?" + this.CharText(k)
            + "' at " + this.ppos;
    }

    string CharText(int c) {
        if (c < 0) { return ""; }
        if (c < 128) { return Encoding.CharFromCode(c); }
        return "\\x" + RegexProgram.Hex2(c);
    }

    static string Hex2(int v) {
        string digits = "0123456789abcdef";
        int hi = (v / 16) % 16;
        int lo = v % 16;
        return digits.Substring(hi, 1) + digits.Substring(lo, 1);
    }

    /// <summary>登记一个捕获组，返回组号。</summary>
    int NewGroup(string name) {
        int gi = this.groups;
        this.groups = this.groups + 1;
        if (name.Length > 0) {
            if (this.GroupNumber(name) >= 0) {
                this.error = "duplicate group name '" + name + "' at " + this.ppos;
            }
            this.groupNames.Add(name);
            this.groupNums.Add(gi);
        }
        return gi;
    }

    string ParseGroupName(int closer) {
        StringBuilder sb = new StringBuilder();
        int c = this.Peek();
        while (c >= 0 && c != closer) {
            bool ok = (c >= 48 && c <= 57) || (c >= 65 && c <= 90)
                || (c >= 97 && c <= 122) || c == 95;
            if (!ok) {
                this.error = "invalid character in group name at " + this.ppos;
                return "";
            }
            sb.Append(this.CharText(c));
            this.ppos = this.ppos + 1;
            c = this.Peek();
        }
        if (c != closer) {
            this.error = "unterminated group name at " + this.ppos;
            return "";
        }
        this.ppos = this.ppos + 1;
        string name = sb.ToString();
        if (name.Length == 0) {
            this.error = "empty group name at " + this.ppos;
        }
        return name;
    }

    void ParseCaptureBody(int gi) {
        if (this.error.Length > 0) { return; }
        this.Emit(RegexProgram.OpSave(), gi * 2, 0, 0);
        this.ParseGroupTail(gi);
    }

    /// <summary>解析组体与 ')'；gi >= 0 时补上收尾的 Save。</summary>
    void ParseGroupTail(int gi) {
        this.ParseAlt();
        if (this.error.Length > 0) { return; }
        if (this.Peek() != 41) {
            this.error = "missing ')' at " + this.ppos;
            return;
        }
        this.ppos = this.ppos + 1;
        if (gi >= 0) {
            this.Emit(RegexProgram.OpSave(), gi * 2 + 1, 0, 0);
        }
    }

    /// <summary>环视 / 原子组：`look ; body ; lookend ; 继续`。</summary>
    void ParseLook(int kind) {
        int look = this.Emit(RegexProgram.OpLook(), kind, 0, 0);
        int bodyStart = this.Here();
        this.ParseAlt();
        if (this.error.Length > 0) { return; }
        if (this.Peek() != 41) {
            this.error = "missing ')' at " + this.ppos;
            return;
        }
        this.ppos = this.ppos + 1;
        int bodyEnd = this.Here();
        this.Emit(RegexProgram.OpLookEnd(), 0, 0, 0);
        this.ay[look] = this.Here();          // 断言之后继续执行的位置
        if (kind == RegexProgram.LookBehind() || kind == RegexProgram.LookBehindNeg()) {
            int width = this.FixedWidth(bodyStart, bodyEnd);
            if (width < 0) {
                this.error = "lookbehind must have a fixed width (literals and "
                    + "ASCII classes only) at " + this.ppos;
                return;
            }
            this.az[look] = width;
        }
    }

    /// <summary>[from, to) 匹配的固定字节数；宽度不定时返回 -1。
    /// 定长回顾靠它算出起点，做不到就编译期报错，而不是
    /// 悄悄给个错答案。</summary>
    int FixedWidth(int from, int to) {
        int w = 0;
        for (int i = from; i < to; i = i + 1) {
            int o = this.op[i];
            if (o == RegexProgram.OpChar()) {
                w = w + RegexProgram.Utf8Len(this.ax[i]);
            } else if (o == RegexProgram.OpClass()) {
                if (!this.ClassIsAscii(this.ax[i])) { return -1; }
                w = w + 1;
            } else if (o == RegexProgram.OpSave() || o == RegexProgram.OpBol()
                       || o == RegexProgram.OpEol() || o == RegexProgram.OpWordB()
                       || o == RegexProgram.OpBos() || o == RegexProgram.OpEos()
                       || o == RegexProgram.OpGpos()) {
                // 零宽
            } else {
                return -1;    // 量词、交替、反向引用、`.`、嵌套环视
            }
        }
        return w;
    }

    /// <summary>类 `ci` 是否只覆盖 ASCII（定长回顾用）。</summary>
    bool ClassIsAscii(int ci) {
        if (this.clsNeg[ci] == 1) { return false; }
        int from = this.clsStart[ci];
        int to = from + this.clsCount[ci];
        for (int i = from; i < to; i = i + 1) {
            if (this.clsKind[i] != RegexProgram.MemRange()) { return false; }
            if (this.clsHi[i] > 127) { return false; }
        }
        return true;
    }

    /// <summary>开始一个字符类并返回其索引。</summary>
    int BeginClass(bool negate) {
        int ci = this.clsStart.Count;
        this.clsStart.Add(this.clsLo.Count);
        this.clsCount.Add(0);
        int n = 0;
        if (negate) { n = 1; }
        this.clsNeg.Add(n);
        return ci;
    }

    void AddMember(int ci, int kind, int lo, int hi) {
        this.clsKind.Add(kind);
        this.clsLo.Add(lo);
        this.clsHi.Add(hi);
        this.clsCount[ci] = this.clsCount[ci] + 1;
    }

    void AddRange(int ci, int lo, int hi) {
        this.AddMember(ci, RegexProgram.MemRange(), lo, hi);
    }

    /// <summary>添加 `\d \w \s` 简写的范围。`kind` 用小写字母的
    /// 码值表示。</summary>
    void AddShorthand(int ci, int kind) {
        if (kind == 100) {                    // 'd'
            this.AddRange(ci, 48, 57);
        } else if (kind == 119) {              // 'w'
            this.AddRange(ci, 48, 57);
            this.AddRange(ci, 65, 90);
            this.AddRange(ci, 97, 122);
            this.AddRange(ci, 95, 95);
        } else if (kind == 115) {              // 's'
            this.AddRange(ci, 32, 32);
            this.AddRange(ci, 9, 13);
        }
    }

    /// <summary>POSIX 类 `[:name:]` 的范围。未知名字返回 false。</summary>
    bool AddPosixClass(int ci, string name, bool negate) {
        int sub = -1;
        if (name == "digit") { sub = 100; }
        if (name == "space") { sub = 115; }
        if (name == "word") { sub = 119; }
        if (sub > 0) {
            if (negate) {
                this.AddMember(ci, RegexProgram.MemNotSet(), sub, 0);
            } else {
                this.AddShorthand(ci, sub);
            }
            return true;
        }
        // 其余 POSIX 类展开成范围；取反形式只在整类取反时才可表达，
        // 因此这里用 MemNotSet 之外的办法：把取反的 POSIX 类拒掉。
        if (negate) { return false; }
        if (name == "alpha") {
            this.AddRange(ci, 65, 90);
            this.AddRange(ci, 97, 122);
            return true;
        }
        if (name == "alnum") {
            this.AddRange(ci, 48, 57);
            this.AddRange(ci, 65, 90);
            this.AddRange(ci, 97, 122);
            return true;
        }
        if (name == "upper") { this.AddRange(ci, 65, 90); return true; }
        if (name == "lower") { this.AddRange(ci, 97, 122); return true; }
        if (name == "xdigit") {
            this.AddRange(ci, 48, 57);
            this.AddRange(ci, 65, 70);
            this.AddRange(ci, 97, 102);
            return true;
        }
        if (name == "blank") {
            this.AddRange(ci, 32, 32);
            this.AddRange(ci, 9, 9);
            return true;
        }
        if (name == "cntrl") {
            this.AddRange(ci, 0, 31);
            this.AddRange(ci, 127, 127);
            return true;
        }
        if (name == "print") { this.AddRange(ci, 32, 126); return true; }
        if (name == "graph") { this.AddRange(ci, 33, 126); return true; }
        if (name == "punct") {
            this.AddRange(ci, 33, 47);
            this.AddRange(ci, 58, 64);
            this.AddRange(ci, 91, 96);
            this.AddRange(ci, 123, 126);
            return true;
        }
        return false;
    }

    /// <summary>`[` 已消耗。类成员按码点收集，因此 `[中文]` 合法。</summary>
    void ParseClass() {
        bool negate = false;
        if (this.Peek() == 94) {              // '^'
            this.ppos = this.ppos + 1;
            negate = true;
        }
        int ci = this.BeginClass(negate);
        bool first = true;
        bool done = false;
        while (!done) {
            int c = this.Peek();
            if (c < 0) {
                this.error = "missing ']' at " + this.ppos;
                return;
            }
            if (c == 93 && !first) {          // ']'
                this.ppos = this.ppos + 1;
                done = true;
                continue;
            }
            first = false;
            if (c == 91 && this.PeekAt(this.ppos + 1) == 58) {   // "[:name:]"
                if (!this.ParsePosixInClass(ci)) { return; }
                continue;
            }
            int lo = 0;
            if (c == 92) {                    // '\'
                this.ppos = this.ppos + 1;
                int e = this.Next();
                if (e < 0) {
                    this.error = "trailing backslash in character class";
                    return;
                }
                if (e == 100 || e == 119 || e == 115) {        // \d \w \s
                    this.AddShorthand(ci, e);
                    continue;
                }
                if (e == 68 || e == 87 || e == 83) {           // \D \W \S
                    // 类内的取反简写不能折成范围（那样会把整类含义
                    // 弄反），单独作为"不属于此集合"的成员保存。
                    this.AddMember(ci, RegexProgram.MemNotSet(), e + 32, 0);
                    continue;
                }
                if (e == 98) {                                 // 类内 \b = 退格
                    this.AddRange(ci, 8, 8);
                    continue;
                }
                lo = this.EscapeValue(e);
                if (this.error.Length > 0) { return; }
            } else {
                lo = this.NextCp();
            }
            // 范围 lo-hi（'-' 在末尾时是字面量）
            if (this.Peek() == 45 && this.PeekAt(this.ppos + 1) != 93
                && this.PeekAt(this.ppos + 1) >= 0) {
                this.ppos = this.ppos + 1;
                int hi = 0;
                if (this.Peek() == 92) {
                    this.ppos = this.ppos + 1;
                    int e2 = this.Next();
                    if (e2 == 100 || e2 == 119 || e2 == 115 || e2 == 68
                        || e2 == 87 || e2 == 83) {
                        this.error = "shorthand class cannot be a range endpoint at "
                            + this.ppos;
                        return;
                    }
                    hi = this.EscapeValue(e2);
                    if (this.error.Length > 0) { return; }
                } else {
                    hi = this.NextCp();
                }
                if (hi < lo) {
                    this.error = "character range is out of order at " + this.ppos;
                    return;
                }
                this.AddRange(ci, lo, hi);
            } else {
                this.AddRange(ci, lo, lo);
            }
        }
        if (this.clsCount[ci] == 0) {
            this.error = "empty character class at " + this.ppos;
            return;
        }
        this.Emit(RegexProgram.OpClass(), ci, 0, 0);
    }

    /// <summary>解析类内的 `[:name:]` / `[:^name:]`。</summary>
    bool ParsePosixInClass(int ci) {
        int save = this.ppos;
        this.ppos = this.ppos + 2;
        bool neg = false;
        if (this.Peek() == 94) {
            this.ppos = this.ppos + 1;
            neg = true;
        }
        StringBuilder sb = new StringBuilder();
        while (this.Peek() >= 97 && this.Peek() <= 122) {
            sb.Append(this.CharText(this.Peek()));
            this.ppos = this.ppos + 1;
        }
        if (this.Peek() != 58 || this.PeekAt(this.ppos + 1) != 93) {
            this.ppos = save;
            this.error = "malformed POSIX character class at " + save;
            return false;
        }
        this.ppos = this.ppos + 2;
        if (!this.AddPosixClass(ci, sb.ToString(), neg)) {
            this.error = "unsupported POSIX character class '[:" + sb.ToString()
                + ":]' at " + save;
            return false;
        }
        return true;
    }

    /// <summary>转义序列代表的码点（`\n` -> 10，`\x41` -> 65）。
    /// 反斜杠已消耗，`e` 是其后的那个字节。</summary>
    int EscapeValue(int e) {
        if (e == 110) { return 10; }          // \n
        if (e == 114) { return 13; }          // \r
        if (e == 116) { return 9; }           // \t
        if (e == 102) { return 12; }          // \f
        if (e == 118) { return 11; }          // \v
        if (e == 97) { return 7; }            // \a
        if (e == 101) { return 27; }          // \e
        if (e == 48) { return 0; }            // \0
        if (e == 120) { return this.ParseHexEscape(); }        // \xHH / \x{...}
        if (e == 117) { return this.ParseFixedHex(4); }        // \uXXXX
        if (e == 85) { return this.ParseFixedHex(8); }         // \UXXXXXXXX
        if (e == 99) { return this.ParseControlEscape(); }     // \cX
        if (e == 112 || e == 80) {                             // \p{..} \P{..}
            this.error = "Unicode property escapes (\\p) are not supported at "
                + this.ppos;
            return 0;
        }
        if (e >= 48 && e <= 57) {
            this.error = "octal escapes are not supported at " + this.ppos
                + "; use \\xHH";
            return 0;
        }
        if ((e >= 97 && e <= 122) || (e >= 65 && e <= 90)) {
            this.error = "unsupported escape '\\" + this.CharText(e) + "' at "
                + this.ppos;
            return 0;
        }
        if (e < 0) { return 92; }
        return e;
    }

    static int HexDigit(int c) {
        if (c >= 48 && c <= 57) { return c - 48; }
        if (c >= 97 && c <= 102) { return c - 87; }
        if (c >= 65 && c <= 70) { return c - 55; }
        return -1;
    }

    int ParseHexEscape() {
        if (this.Peek() == 123) {             // \x{1F600}
            this.ppos = this.ppos + 1;
            int v = 0;
            int n = 0;
            while (RegexProgram.HexDigit(this.Peek()) >= 0) {
                v = v * 16 + RegexProgram.HexDigit(this.Peek());
                this.ppos = this.ppos + 1;
                n = n + 1;
            }
            if (n == 0 || this.Peek() != 125) {
                this.error = "malformed \\x{...} escape at " + this.ppos;
                return 0;
            }
            this.ppos = this.ppos + 1;
            if (v > 1114111) {
                this.error = "code point out of range in \\x{...} at " + this.ppos;
                return 0;
            }
            return v;
        }
        return this.ParseFixedHex(2);
    }

    int ParseFixedHex(int digits) {
        int v = 0;
        for (int i = 0; i < digits; i = i + 1) {
            int d = RegexProgram.HexDigit(this.Peek());
            if (d < 0) {
                this.error = "expected " + digits + " hex digits at " + this.ppos;
                return 0;
            }
            v = v * 16 + d;
            this.ppos = this.ppos + 1;
        }
        if (v > 1114111) {
            this.error = "code point out of range at " + this.ppos;
            return 0;
        }
        return v;
    }

    int ParseControlEscape() {
        int c = this.Next();
        if (c < 0) {
            this.error = "\\c needs a letter at " + this.ppos;
            return 0;
        }
        int up = c;
        if (up >= 97 && up <= 122) { up = up - 32; }
        if (up < 64 || up > 95) {
            this.error = "\\c needs a letter at " + this.ppos;
            return 0;
        }
        return up - 64;
    }

    void ParseEscape() {
        int e = this.Next();
        if (e < 0) {
            this.error = "trailing backslash";
            return;
        }
        if (e == 100 || e == 119 || e == 115) {          // \d \w \s
            int ci = this.BeginClass(false);
            this.AddShorthand(ci, e);
            this.Emit(RegexProgram.OpClass(), ci, 0, 0);
            return;
        }
        if (e == 68 || e == 87 || e == 83) {             // \D \W \S
            int ci = this.BeginClass(true);
            this.AddShorthand(ci, e + 32);
            this.Emit(RegexProgram.OpClass(), ci, 0, 0);
            return;
        }
        if (e == 98) {                                   // \b
            this.Emit(RegexProgram.OpWordB(), 1, 0, 0);
            return;
        }
        if (e == 66) {                                   // \B
            this.Emit(RegexProgram.OpWordB(), 0, 0, 0);
            return;
        }
        if (e == 65) {                                   // \A
            this.Emit(RegexProgram.OpBos(), 0, 0, 0);
            return;
        }
        if (e == 122) {                                  // \z
            this.Emit(RegexProgram.OpEos(), 0, 0, 0);
            return;
        }
        if (e == 90) {                                   // \Z
            this.Emit(RegexProgram.OpEos(), 1, 0, 0);
            return;
        }
        if (e == 71) {                                   // \G
            this.Emit(RegexProgram.OpGpos(), 0, 0, 0);
            return;
        }
        if (e == 107) {                                  // \k<name>
            int closer = -1;
            if (this.Peek() == 60) { closer = 62; }
            if (this.Peek() == 39) { closer = 39; }
            if (closer < 0) {
                this.error = "\\k must be followed by <name> at " + this.ppos;
                return;
            }
            this.ppos = this.ppos + 1;
            string name = this.ParseGroupName(closer);
            if (this.error.Length > 0) { return; }
            int gi = this.GroupNumber(name);
            if (gi < 0) {
                this.error = "reference to undefined group name '" + name + "' at "
                    + this.ppos;
                return;
            }
            this.Emit(RegexProgram.OpBackref(), gi, 0, 0);
            return;
        }
        if (e >= 49 && e <= 57) {                        // \1 - \99
            int g = e - 48;
            while (this.Peek() >= 48 && this.Peek() <= 57
                   && g * 10 + (this.Peek() - 48) < this.groups) {
                g = g * 10 + (this.Next() - 48);
            }
            if (g >= this.groups) {
                if (e <= 55 && this.Peek() >= 48 && this.Peek() <= 55) {
                    // `\101` 在 Perl 里是八进制，这里不支持；单说
                    // "组不存在" 会让人以为是数错了组号
                    this.error = "octal escapes are not supported at "
                        + this.ppos + "; use \\xHH";
                    return;
                }
                this.error = "reference to undefined group \\" + g + " at "
                    + this.ppos;
                return;
            }
            this.Emit(RegexProgram.OpBackref(), g, 0, 0);
            return;
        }
        int v = this.EscapeValue(e);
        if (this.error.Length > 0) { return; }
        this.Emit(RegexProgram.OpChar(), v, 0, 0);
    }

    // ---- 解释器 -----------------------------------------------------

    /// <summary>ASCII 大小写折叠。非 ASCII 码点原样返回：Unicode
    /// 折叠需要码表，这里明确只做 ASCII（文档已说明）。</summary>
    static int Fold(int c) {
        if (c >= 65 && c <= 90) { return c + 32; }
        return c;
    }

    static bool IsWordCp(int c) {
        if (c >= 48 && c <= 57) { return true; }
        if (c >= 65 && c <= 90) { return true; }
        if (c >= 97 && c <= 122) { return true; }
        return c == 95;
    }

    static bool InShorthand(int kind, int c) {
        if (kind == 100) { return c >= 48 && c <= 57; }
        if (kind == 119) { return RegexProgram.IsWordCp(c); }
        if (kind == 115) { return c == 32 || (c >= 9 && c <= 13); }
        return false;
    }

    bool ClassHas(int ci, int c) {
        int from = this.clsStart[ci];
        int to = from + this.clsCount[ci];
        bool hit = false;
        int i = from;
        while (i < to && !hit) {
            if (this.clsKind[i] == RegexProgram.MemNotSet()) {
                if (!RegexProgram.InShorthand(this.clsLo[i], c)) { hit = true; }
            } else {
                int lo = this.clsLo[i];
                int hi = this.clsHi[i];
                if (c >= lo && c <= hi) { hit = true; }
                if (this.ignoreCase && !hit) {
                    int f = RegexProgram.Fold(c);
                    int u = f - 32;
                    if (f >= lo && f <= hi) { hit = true; }
                    if (c >= 97 && c <= 122 && u >= lo && u <= hi) { hit = true; }
                }
            }
            i = i + 1;
        }
        if (this.clsNeg[ci] == 1) { return !hit; }
        return hit;
    }

    /// <summary>从 `start` 运行程序。成功后 `caps` 保存
    /// 2 * GroupCount() 个偏移（组未参与时为 -1），返回值为匹配
    /// 结束位置；-1 表示此处无匹配，-2 表示回溯预算耗尽
    /// （调用方应把它与"无匹配"区分开）。</summary>
    int RunAt(nint input, int len, int start, int origin, List<int> caps) {
        int slots = this.groups * 2;
        caps.Clear();
        for (int i = 0; i < slots; i = i + 1) {
            caps.Add(-1);
        }
        RegexRun run = new RegexRun();
        run.input = input;
        run.len = len;
        run.caps = caps;
        run.budget = 2000000;
        run.origin = origin;
        run.overflow = false;
        for (int i = 0; i < this.marks; i = i + 1) {
            run.marks.Add(-1);
        }
        if (this.Step(run, 0, start)) {
            return run.end;
        }
        if (run.overflow) { return -2; }
        return -1;
    }

    /// <summary>回溯解释器：每走一个分支递归调用一次。`budget`
    /// 限制总步数；耗尽时置 `overflow` 并一路返回失败，让调用方
    /// 能报告"预算耗尽"而不是把超时伪装成"无匹配"。</summary>
    bool Step(RegexRun run, int pc, int sp) {
        bool running = true;
        while (running) {
            if (run.overflow) { return false; }
            run.budget = run.budget - 1;
            if (run.budget <= 0) {
                run.overflow = true;
                return false;
            }
            int o = this.op[pc];
            if (o == RegexProgram.OpChar()) {
                int packed = RegexProgram.DecodeAt(run.input, run.len, sp);
                if (packed < 0) { return false; }
                int c = packed / 8;
                int want = this.ax[pc];
                if (c != want) {
                    if (!this.ignoreCase) { return false; }
                    if (RegexProgram.Fold(c) != RegexProgram.Fold(want)) { return false; }
                }
                pc = pc + 1;
                sp = sp + (packed & 7);
            } else if (o == RegexProgram.OpAny()) {
                int packed = RegexProgram.DecodeAt(run.input, run.len, sp);
                if (packed < 0) { return false; }
                if (!this.dotAll && packed / 8 == 10) { return false; }
                pc = pc + 1;
                sp = sp + (packed & 7);
            } else if (o == RegexProgram.OpClass()) {
                int packed = RegexProgram.DecodeAt(run.input, run.len, sp);
                if (packed < 0) { return false; }
                if (!this.ClassHas(this.ax[pc], packed / 8)) { return false; }
                pc = pc + 1;
                sp = sp + (packed & 7);
            } else if (o == RegexProgram.OpJmp()) {
                pc = this.ax[pc];
            } else if (o == RegexProgram.OpSplit()) {
                if (this.Step(run, this.ax[pc], sp)) { return true; }
                if (run.overflow) { return false; }
                pc = this.ay[pc];
            } else if (o == RegexProgram.OpSave()) {
                int slot = this.ax[pc];
                int old = run.caps[slot];
                run.caps[slot] = sp;
                if (this.Step(run, pc + 1, sp)) { return true; }
                run.caps[slot] = old;
                return false;
            } else if (o == RegexProgram.OpMark()) {
                int slot = this.ax[pc];
                int old = run.marks[slot];
                run.marks[slot] = sp;
                if (this.Step(run, pc + 1, sp)) { return true; }
                run.marks[slot] = old;
                return false;
            } else if (o == RegexProgram.OpEmptyChk()) {
                // 本轮一个字节都没吃掉（`(a*)*`、`()+`）就离开循环：
                // 再转下去只会无限重复同一个空匹配
                if (run.marks[this.ax[pc]] == sp) {
                    pc = this.ay[pc];
                } else {
                    pc = pc + 1;
                }
            } else if (o == RegexProgram.OpLook()) {
                int kind = this.ax[pc];
                int cont = this.ay[pc];
                int at = sp;
                if (kind == RegexProgram.LookBehind()
                    || kind == RegexProgram.LookBehindNeg()) {
                    at = sp - this.az[pc];
                    if (at < 0) {
                        if (kind == RegexProgram.LookBehind()) { return false; }
                        pc = cont;
                        continue;
                    }
                }
                int savedEnd = run.subEnd;
                run.subEnd = -1;
                bool ok = this.Step(run, pc + 1, at);
                if (run.overflow) { return false; }
                int subEnd = run.subEnd;
                run.subEnd = savedEnd;
                if (kind == RegexProgram.LookAheadNeg()
                    || kind == RegexProgram.LookBehindNeg()) {
                    if (ok) { return false; }
                    pc = cont;
                } else {
                    if (!ok) { return false; }
                    if (kind == RegexProgram.LookAtomic()) { sp = subEnd; }
                    pc = cont;
                }
            } else if (o == RegexProgram.OpLookEnd()) {
                run.subEnd = sp;
                return true;
            } else if (o == RegexProgram.OpBol()) {
                if (sp != 0) {
                    if (!this.multiline) { return false; }
                    if (new Span<byte>(run.input + sp - 1, 1)[0] != 10) { return false; }
                }
                pc = pc + 1;
            } else if (o == RegexProgram.OpEol()) {
                if (sp != run.len) {
                    bool atLineEnd = new Span<byte>(run.input + sp, 1)[0] == 10;
                    if (!atLineEnd) { return false; }
                    // 非多行模式下 `$` 只允许出现在结尾的换行之前
                    if (!this.multiline && sp != run.len - 1) { return false; }
                }
                pc = pc + 1;
            } else if (o == RegexProgram.OpBos()) {
                if (sp != 0) { return false; }
                pc = pc + 1;
            } else if (o == RegexProgram.OpEos()) {
                if (sp != run.len) {
                    if (this.ax[pc] != 1) { return false; }
                    // \Z：结尾换行之前也算
                    if (sp != run.len - 1) { return false; }
                    if (new Span<byte>(run.input + sp, 1)[0] != 10) { return false; }
                }
                pc = pc + 1;
            } else if (o == RegexProgram.OpGpos()) {
                if (sp != run.origin) { return false; }
                pc = pc + 1;
            } else if (o == RegexProgram.OpWordB()) {
                bool before = false;
                bool after = false;
                if (sp > 0) {
                    before = RegexProgram.IsWordCp(
                        new Span<byte>(run.input + sp - 1, 1)[0]);
                }
                if (sp < run.len) {
                    int packed = RegexProgram.DecodeAt(run.input, run.len, sp);
                    after = RegexProgram.IsWordCp(packed / 8);
                }
                bool boundary = before != after;
                if (this.ax[pc] == 1) {
                    if (!boundary) { return false; }
                } else {
                    if (boundary) { return false; }
                }
                pc = pc + 1;
            } else if (o == RegexProgram.OpBackref()) {
                int g = this.ax[pc];
                int gs = run.caps[g * 2];
                int ge = run.caps[g * 2 + 1];
                if (gs < 0 || ge < gs) {
                    pc = pc + 1;
                } else {
                    int n = ge - gs;
                    if (sp + n > run.len) { return false; }
                    for (int k = 0; k < n; k = k + 1) {
                        int a = new Span<byte>(run.input + gs + k, 1)[0];
                        int b = new Span<byte>(run.input + sp + k, 1)[0];
                        if (a != b) {
                            if (!this.ignoreCase) { return false; }
                            if (RegexProgram.Fold(a) != RegexProgram.Fold(b)) { return false; }
                        }
                    }
                    pc = pc + 1;
                    sp = sp + n;
                }
            } else {
                // OpMatch
                run.end = sp;
                return true;
            }
        }
        return false;
    }
}

/// <summary>一次进行中的匹配：输入、正在填充的捕获槽、空循环
/// 检查用的槽位和剩余步骤预算。与 RegexProgram 分离，使编译后的
/// 模式保持不可变，可对多个输入进行匹配。</summary>
class RegexRun {
    nint input;
    int len;
    List<int> caps;
    List<int> marks;
    int budget;
    int end;
    int origin;      // 本次尝试的起点（\G）
    int subEnd;      // 环视 / 原子组子程序的结束位置
    bool overflow;   // 回溯预算耗尽

    RegexRun() {
        this.input = 0;
        this.len = 0;
        this.caps = null;
        this.marks = new List<int>();
        this.budget = 0;
        this.end = -1;
        this.origin = 0;
        this.subEnd = -1;
        this.overflow = false;
    }
}
