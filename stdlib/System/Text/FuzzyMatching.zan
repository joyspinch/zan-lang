using System;

namespace System.Text;

/// <summary>
/// Fuzzy string matching: subsequence scoring for symbol/file search plus a
/// BM25 index for ranking documents by query terms. Pure algorithm, no
/// platform dependencies.
///
///   double score = Fuzzy.Score("flst", "FileList");   // 0.75
///   bool hit = Fuzzy.Matches("zanc", "build/zanc.exe");  // true
///
///   Bm25Index idx = new Bm25Index();
///   idx.Add(1, "the quick brown fox");
///   List<string> hits = idx.Search("quick fox");     // ["1"]
/// </summary>
class Fuzzy {
    /// <summary>True when `query` appears as a subsequence of `candidate`
    /// (characters in order, case-insensitive).</summary>
    static bool Matches(string query, string candidate) {
        if (query.Length == 0) { return true; }
        int qi = 0;
        for (int ci = 0; ci < candidate.Length && qi < query.Length; ci = ci + 1) {
            if (Fuzzy.SameChar(query.Substring(qi, 1), candidate.Substring(ci, 1))) {
                qi = qi + 1;
            }
        }
        return qi == query.Length;
    }

    /// <summary>Similarity in [0,1]: 1.0 for an exact (case-insensitive)
    /// match, falling off for gaps. Bonus points for contiguous runs, word
    /// starts and camel-case boundaries (so "flst" beats "flts" for
    /// "FileList"). 0 when the query is not a subsequence.</summary>
    static double Score(string query, string candidate) {
        if (query.Length == 0) { return 1.0; }
        if (candidate.Length == 0) { return 0.0; }
        if (!Fuzzy.Matches(query, candidate)) { return 0.0; }
        if (Fuzzy.SameStr(query, candidate)) { return 1.0; }

        // Greedy leftmost match, counting run lengths and boundary hits.
        int score = 0;
        int qi = 0;
        int run = 0;
        for (int ci = 0; ci < candidate.Length && qi < query.Length; ci = ci + 1) {
            if (Fuzzy.SameChar(query.Substring(qi, 1), candidate.Substring(ci, 1))) {
                run = run + 1;
                // Contiguous runs gain more than isolated chars.
                int gain = 1;
                if (run >= 2) { gain = 2; }
                // Boundary bonus: word start or camel boundary.
                if (run == 1) {
                    if (ci == 0 || Fuzzy.IsBoundary(candidate, ci)) { gain = 3; }
                }
                score = score + gain;
                qi = qi + 1;
            } else {
                run = 0;
            }
        }
        double maxScore = (double)(query.Length * 3);
        double s = (double)score;
        return s / maxScore;
    }

    // A boundary is a letter right after a non-letter, or a lower-case letter
    // right before an upper-case one (camel case).
    static bool IsBoundary(string s, int i) {
        if (i == 0) { return true; }
        string prev = s.Substring(i - 1, 1);
        string cur = s.Substring(i, 1);
        bool prevAlpha = Fuzzy.IsLetter(prev);
        bool curAlpha = Fuzzy.IsLetter(cur);
        if (!prevAlpha && curAlpha) { return true; }
        bool prevLower = Fuzzy.IsLower(prev);
        bool curUpper = Fuzzy.IsUpper(cur);
        if (prevLower && curUpper) { return true; }
        return false;
    }

    static bool IsLetter(string ch) {
        int c = ch[0] & 255;
        return (c >= 65 && c <= 90) || (c >= 97 && c <= 122);
    }

    static bool IsUpper(string ch) {
        int c = ch[0] & 255;
        return c >= 65 && c <= 90;
    }

    static bool IsLower(string ch) {
        int c = ch[0] & 255;
        return c >= 97 && c <= 122;
    }

    static bool SameChar(string a, string b) {
        return Fuzzy.SameStr(a.ToLower(), b.ToLower());
    }

    static bool SameStr(string a, string b) {
        return a == b;
    }
}
