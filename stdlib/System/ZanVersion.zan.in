namespace System;

/// <summary>The toolchain version this standard library ships 带有, so a
/// program can print it (server 启动 banners, 关于对话框, `--version`
/// output) 不含 asking the build system.</summary>
class ZanVersion {
    /// <summary>Dotted release string, e.g. "0.2.0".</summary>
    static string Text() { return "@ZAN_VERSION@"; }
}
