namespace System;

/// <summary>本标准库随附的工具链版本，程序可直接打印
/// 它（服务启动横幅、关于对话框、`--version`
/// 输出）而无需查询构建系统。</summary>
class ZanVersion {
    /// <summary>点分格式的发布版本字符串，例如 "0.2.0"。</summary>
    static string Text() { return "0.2.3"; }
}
