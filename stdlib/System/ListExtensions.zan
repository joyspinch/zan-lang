using System;

namespace System;

/// <summary>
/// List&lt;T&gt; operations that the compiler does not lower natively.
///
/// Written as extension methods (`this List&lt;T&gt;` receiver) so they are
/// called like members: `items.Remove(x)`. Each of these used to compile to a
/// constant 0 / a silent no-op, which turned an ordinary Remove or Sort into a
/// bug with no diagnostic.
/// </summary>
class ListExtensions {
    /// <summary>Removes the first element equal to `item`; returns whether
    /// something was removed.</summary>
    static bool Remove<T>(this List<T> src, T item) {
        for (int i = 0; i < src.Count; i = i + 1) {
            if (src[i] == item) {
                src.RemoveAt(i);
                return true;
            }
        }
        return false;
    }

    /// <summary>A copy of `count` elements starting at `start`. The range is
    /// clamped to the list.</summary>
    static List<T> GetRange<T>(this List<T> src, int start, int count) {
        List<T> outp = new List<T>();
        int at = start;
        if (at < 0) { at = 0; }
        int n = count;
        if (at + n > src.Count) { n = src.Count - at; }
        for (int i = 0; i < n; i = i + 1) { outp.Add(src[at + i]); }
        return outp;
    }

    /// <summary>Sorts the integers in place, ascending.</summary>
    static void Sort(this List<int> src) {
        for (int i = 1; i < src.Count; i = i + 1) {
            int v = src[i];
            int j = i - 1;
            while (j >= 0 && src[j] > v) {
                src[j + 1] = src[j];
                j = j - 1;
            }
            src[j + 1] = v;
        }
    }

    /// <summary>Sorts the numbers in place, ascending.</summary>
    static void Sort(this List<double> src) {
        for (int i = 1; i < src.Count; i = i + 1) {
            double v = src[i];
            int j = i - 1;
            while (j >= 0 && src[j] > v) {
                src[j + 1] = src[j];
                j = j - 1;
            }
            src[j + 1] = v;
        }
    }

    /// <summary>Sorts the strings in place, ordinal ascending.</summary>
    static void Sort(this List<string> src) {
        for (int i = 1; i < src.Count; i = i + 1) {
            string v = src[i];
            int j = i - 1;
            while (j >= 0 && String.CompareOrdinal(src[j], v) > 0) {
                src[j + 1] = src[j];
                j = j - 1;
            }
            src[j + 1] = v;
        }
    }
}
