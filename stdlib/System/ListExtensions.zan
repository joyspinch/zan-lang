using System;

namespace System;

/// <summary>泛型比较器委托：x 小于 y 返回负数，等于返回 0，大于返回正数。</summary>
delegate int Comparison<T>(T x, T y);

/// <summary>
/// 编译器不会原生降低的 List&lt;T&gt; 操作。
/// 以扩展方法（`this List&lt;T&gt;` 接收方）的形式编写，以便
/// 像成员一样调用：`items.Remove(x)`。此前这些调用会被编译成
/// 常量 0 / 静默空操作，把普通的 Remove 或 Sort 变成
/// 一个没有诊断信息的 bug。
/// </summary>
class ListExtensions {
    /// <summary>移除第一个等于 `item` 的元素；返回是否
    /// 确实移除了某个元素。</summary>
    static bool Remove<T>(this List<T> src, T item) {
        for (int i = 0; i < src.Count; i = i + 1) {
            if (src[i] == item) {
                src.RemoveAt(i);
                return true;
            }
        }
        return false;
    }

    /// <summary>从 `start` 开始的 `count` 个元素的副本。范围会
    /// 被限制在列表范围内。</summary>
    static List<T> GetRange<T>(this List<T> src, int start, int count) {
        List<T> outp = new List<T>();
        int at = start;
        if (at < 0) { at = 0; }
        int n = count;
        if (at + n > src.Count) { n = src.Count - at; }
        for (int i = 0; i < n; i = i + 1) { outp.Add(src[at + i]); }
        return outp;
    }

    /// <summary>原地升序排序整数（自适应快速排序，O(N log N)）。</summary>
    static void Sort(this List<int> src) {
        if (src == null || src.Count <= 1) { return; }
        ListExtensions.QuickSortInt(src, 0, src.Count - 1);
    }

    static void QuickSortInt(List<int> a, int lo, int hi) {
        if (hi - lo < 16) {
            for (int i = lo + 1; i <= hi; i = i + 1) {
                int v = a[i];
                int j = i - 1;
                while (j >= lo && a[j] > v) {
                    a[j + 1] = a[j];
                    j = j - 1;
                }
                a[j + 1] = v;
            }
            return;
        }
        int mid = lo + (hi - lo) / 2;
        if (a[lo] > a[mid]) { int t = a[lo]; a[lo] = a[mid]; a[mid] = t; }
        if (a[lo] > a[hi]) { int t = a[lo]; a[lo] = a[hi]; a[hi] = t; }
        if (a[mid] > a[hi]) { int t = a[mid]; a[mid] = a[hi]; a[hi] = t; }
        int pivot = a[mid];
        int i = lo;
        int j = hi;
        while (i <= j) {
            while (a[i] < pivot) { i = i + 1; }
            while (a[j] > pivot) { j = j - 1; }
            if (i <= j) {
                int t = a[i]; a[i] = a[j]; a[j] = t;
                i = i + 1;
                j = j - 1;
            }
        }
        if (lo < j) { ListExtensions.QuickSortInt(a, lo, j); }
        if (i < hi) { ListExtensions.QuickSortInt(a, i, hi); }
    }

    /// <summary>原地升序排序数值（自适应快速排序，O(N log N)）。</summary>
    static void Sort(this List<double> src) {
        if (src == null || src.Count <= 1) { return; }
        ListExtensions.QuickSortDouble(src, 0, src.Count - 1);
    }

    static void QuickSortDouble(List<double> a, int lo, int hi) {
        if (hi - lo < 16) {
            for (int i = lo + 1; i <= hi; i = i + 1) {
                double v = a[i];
                int j = i - 1;
                while (j >= lo && a[j] > v) {
                    a[j + 1] = a[j];
                    j = j - 1;
                }
                a[j + 1] = v;
            }
            return;
        }
        int mid = lo + (hi - lo) / 2;
        if (a[lo] > a[mid]) { double t = a[lo]; a[lo] = a[mid]; a[mid] = t; }
        if (a[lo] > a[hi]) { double t = a[lo]; a[lo] = a[hi]; a[hi] = t; }
        if (a[mid] > a[hi]) { double t = a[mid]; a[mid] = a[hi]; a[hi] = t; }
        double pivot = a[mid];
        int i = lo;
        int j = hi;
        while (i <= j) {
            while (a[i] < pivot) { i = i + 1; }
            while (a[j] > pivot) { j = j - 1; }
            if (i <= j) {
                double t = a[i]; a[i] = a[j]; a[j] = t;
                i = i + 1;
                j = j - 1;
            }
        }
        if (lo < j) { ListExtensions.QuickSortDouble(a, lo, j); }
        if (i < hi) { ListExtensions.QuickSortDouble(a, i, hi); }
    }

    /// <summary>原地按序数升序排序字符串（自适应快速排序，O(N log N)）。</summary>
    static void Sort(this List<string> src) {
        if (src == null || src.Count <= 1) { return; }
        ListExtensions.QuickSortString(src, 0, src.Count - 1);
    }

    static void QuickSortString(List<string> a, int lo, int hi) {
        if (hi - lo < 16) {
            for (int i = lo + 1; i <= hi; i = i + 1) {
                string v = a[i];
                int j = i - 1;
                while (j >= lo && String.CompareOrdinal(a[j], v) > 0) {
                    a[j + 1] = a[j];
                    j = j - 1;
                }
                a[j + 1] = v;
            }
            return;
        }
        int mid = lo + (hi - lo) / 2;
        if (String.CompareOrdinal(a[lo], a[mid]) > 0) { string t = a[lo]; a[lo] = a[mid]; a[mid] = t; }
        if (String.CompareOrdinal(a[lo], a[hi]) > 0) { string t = a[lo]; a[lo] = a[hi]; a[hi] = t; }
        if (String.CompareOrdinal(a[mid], a[hi]) > 0) { string t = a[mid]; a[mid] = a[hi]; a[hi] = t; }
        string pivot = a[mid];
        int i = lo;
        int j = hi;
        while (i <= j) {
            while (String.CompareOrdinal(a[i], pivot) < 0) { i = i + 1; }
            while (String.CompareOrdinal(a[j], pivot) > 0) { j = j - 1; }
            if (i <= j) {
                string t = a[i]; a[i] = a[j]; a[j] = t;
                i = i + 1;
                j = j - 1;
            }
        }
        if (lo < j) { ListExtensions.QuickSortString(a, lo, j); }
        if (i < hi) { ListExtensions.QuickSortString(a, i, hi); }
    }

    /// <summary>使用自定义比较器原地排序任意对象列表（自适应快速排序，O(N log N)）。</summary>
    static void Sort<T>(this List<T> src, Comparison<T> comparison) {
        if (src == null || src.Count <= 1 || comparison == null) { return; }
        ListExtensions.QuickSortCustom<T>(src, 0, src.Count - 1, comparison);
    }

    static void QuickSortCustom<T>(List<T> a, int lo, int hi, Comparison<T> cmp) {
        if (hi - lo < 16) {
            for (int i = lo + 1; i <= hi; i = i + 1) {
                T v = a[i];
                int j = i - 1;
                while (j >= lo && cmp(a[j], v) > 0) {
                    a[j + 1] = a[j];
                    j = j - 1;
                }
                a[j + 1] = v;
            }
            return;
        }
        int mid = lo + (hi - lo) / 2;
        if (cmp(a[lo], a[mid]) > 0) { T t = a[lo]; a[lo] = a[mid]; a[mid] = t; }
        if (cmp(a[lo], a[hi]) > 0) { T t = a[lo]; a[lo] = a[hi]; a[hi] = t; }
        if (cmp(a[mid], a[hi]) > 0) { T t = a[mid]; a[mid] = a[hi]; a[hi] = t; }
        T pivot = a[mid];
        int i = lo;
        int j = hi;
        while (i <= j) {
            while (cmp(a[i], pivot) < 0) { i = i + 1; }
            while (cmp(a[j], pivot) > 0) { j = j - 1; }
            if (i <= j) {
                T t = a[i]; a[i] = a[j]; a[j] = t;
                i = i + 1;
                j = j - 1;
            }
        }
        if (lo < j) { ListExtensions.QuickSortCustom<T>(a, lo, j, cmp); }
        if (i < hi) { ListExtensions.QuickSortCustom<T>(a, i, hi, cmp); }
    }
}
