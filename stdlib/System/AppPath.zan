using System;
using System.Platform;

namespace System;

// 自进程两原语兼容垫片：建议优先使用 Environment.ProcessPath 与 Environment.ProcessId。
public class AppPath {
    // 正在运行的可执行文件的绝对路径；建议优先使用 Environment.ProcessPath。
    public static string Exe() {
        return Environment.ProcessPath;
    }

    // 当前进程的 PID；建议优先使用 Environment.ProcessId。
    public static int Pid() {
        return Environment.ProcessId;
    }
}
