using System;
using System.Platform;

namespace System;

// 自进程两原语：本进程可执行文件的绝对路径与当前 PID。
// 底层系统调用下沉至平台抽象层（Pal.Environment），跨平台统一。
public class AppPath {
    // 正在运行的可执行文件的绝对路径；无法确定时返回 ""。
    public static string Exe() {
        return Pal.Environment.ExecutablePath();
    }

    // 当前进程的 PID；不支持的平台返回 0。
    public static int Pid() {
        return Pal.Environment.ProcessId();
    }
}
