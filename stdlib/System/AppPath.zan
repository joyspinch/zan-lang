using System;

namespace System;

/// <summary>
/// 自进程两原语：本进程可执行文件的绝对路径与当前 PID。
/// 独立小文件——Gui 的图标/Skin/错误日志只要"自己 exe 在哪"一句话，
/// 避免引入完整进程管理组件；原语落这里，轻量依赖只拉这几十行。
/// 平台支持：Windows（kernel32）/ Linux（/proc）/ macOS（crt），
/// 其余平台返回 ""/0，调用方按无法确定处理。
/// </summary>
class AppPath {
    #if WINDOWS
    [DllImport("kernel32", EntryPoint = "GetModuleFileNameW")]
    static extern int GetModuleFileNameW(nint module, nint buf, int size);
    [DllImport("kernel32", EntryPoint = "GetCurrentProcessId")]
    static extern int GetCurrentProcessId();
    #endif
    #if !WINDOWS
    [DllImport("crt")]
    static extern int readlink(string path, byte[] buf, int size);
    [DllImport("crt", EntryPoint = "getpid")]
    static extern int GetPid();
    #endif
    #if MACOS
    [DllImport("crt", EntryPoint = "_NSGetExecutablePath")]
    static extern int NSGetExecutablePath(nint buf, nint size);
    #endif

    /// <summary>正在运行的可执行文件的绝对路径；无法确定时返回 ""。
    /// 单文件发布时是解包后的真实镜像路径（与 ProcessHost.SelfExe
    /// 语义一致）。</summary>
    static string Exe() {
        #if WINDOWS
        nint buf = NativeMemory.Alloc(8192);
        string exe = "";
        try {
            int n = GetModuleFileNameW(0, buf, 4096);
            if (n > 0 && n < 4096) { exe = Wide.Read(buf); }
        } finally {
            NativeMemory.Free(buf);
        }
        return exe;
        #elif LINUX
        byte[] buf = new byte[4097];
        int n = readlink("/proc/self/exe", buf, 4096);
        if (n <= 0 || n > 4096) { return ""; }
        return buf.ToStr(0, n);
        #elif MACOS
        nint sizeBuf = NativeMemory.Alloc(4);
        nint pathBuf = 0;
        string exe = "";
        try {
            new Span<int>(sizeBuf, 1)[0] = 4096;
            pathBuf = NativeMemory.Alloc(4096);
            NativeMemory.Fill(pathBuf, 0, 4096);
            int ok = NSGetExecutablePath(pathBuf, sizeBuf);
            if (ok == 0) {
                // 成功时 _NSGetExecutablePath 不更新 *bufsize，实际长度按 NUL 查找。
                int len = NativeMemory.Find(pathBuf, 0, 0, 4096);
                if (len >= 0 && len < 4096) { exe = NativeMemory.GetString(pathBuf, 0, len); }
            }
        } finally {
            if (pathBuf != 0) { NativeMemory.Free(pathBuf); }
            NativeMemory.Free(sizeBuf);
        }
        return exe;
        #else
        return "";
        #endif
    }

    /// <summary>当前进程的 PID；不支持的平台返回 0。</summary>
    static int Pid() {
        #if WINDOWS
        return GetCurrentProcessId();
        #elif !WASI
        return GetPid();
        #else
        // WASI 无进程 ID 概念：返回 0，调用方按无法确定处理。
        return 0;
        #endif
    }
}
