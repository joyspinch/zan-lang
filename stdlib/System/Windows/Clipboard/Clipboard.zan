using System;

namespace System.Windows.Clipboard;

/// <summary>
/// 剪贴板格式常量（winuser.h）。
/// </summary>
class ClipFormat {
    static int Text() { return 1; }        // CF_TEXT
    static int Bitmap() { return 2; }      // CF_BITMAP
    static int UnicodeText() { return 13; }   // CF_UNICODETEXT
    static int Hdrop() { return 15; }      // CF_HDROP（文件列表）
    static int Html() { return 0x0D01; }   // 已注册的 "HTML Format" 格式 id
    static int Rtf() { return 0x0D02; }    // 已注册的 "Rich Text Format" 格式 id
}

/// <summary>
/// 剪贴板访问：Unicode 文本、文件列表（CF_HDROP）、格式探测与
/// 枚举。仅 Windows 支持；其他平台会抛出
/// PlatformNotSupportedException。
///
///   if (Clipboard.HasText()) {
///       string t = Clipboard.GetText();
///   }
///   Clipboard.SetText("hello");
///   Clipboard.SetFiles(paths);          // Explorer 会将其视为真实文件拖放
///   List<string> files = Clipboard.GetFiles();
/// </summary>
class Clipboard {
    #if WINDOWS
    [DllImport("user32", EntryPoint = "OpenClipboard")]
    static extern int WinOpenClipboard(nint hwnd);

    [DllImport("user32", EntryPoint = "CloseClipboard")]
    static extern int WinCloseClipboard();

    [DllImport("user32", EntryPoint = "EmptyClipboard")]
    static extern int WinEmptyClipboard();

    [DllImport("user32", EntryPoint = "SetClipboardData")]
    static extern nint WinSetClipboardData(int format, nint mem);

    [DllImport("user32", EntryPoint = "GetClipboardData")]
    static extern nint WinGetClipboardData(int format);

    [DllImport("user32", EntryPoint = "IsClipboardFormatAvailable")]
    static extern int WinIsClipboardFormatAvailable(int format);

    [DllImport("user32", EntryPoint = "CountClipboardFormats")]
    static extern int WinCountClipboardFormats();

    [DllImport("user32", EntryPoint = "EnumClipboardFormats")]
    static extern int WinEnumClipboardFormats(int last);

    [DllImport("user32", EntryPoint = "RegisterClipboardFormatW")]
    static extern int WinRegisterClipboardFormat(nint name);

    [DllImport("user32", EntryPoint = "GetClipboardFormatNameW")]
    static extern int WinGetClipboardFormatName(int format, nint buf, int size);

    [DllImport("kernel32", EntryPoint = "GlobalAlloc")]
    static extern nint WinGlobalAlloc(int flags, int bytes);

    [DllImport("kernel32", EntryPoint = "GlobalLock")]
    static extern nint WinGlobalLock(nint mem);

    [DllImport("kernel32", EntryPoint = "GlobalUnlock")]
    static extern int WinGlobalUnlock(nint mem);

    [DllImport("kernel32", EntryPoint = "GlobalFree")]
    static extern nint WinGlobalFree(nint mem);

    [DllImport("shell32", EntryPoint = "DragQueryFileW")]
    static extern int WinDragQueryFileW(nint hdrop, int index, nint buf, int size);

    [DllImport("shell32", EntryPoint = "DragFinish")]
    static extern void WinDragFinish(nint hdrop);
    #endif

    /// 剪贴板上有 Unicode 文本时为 true。
    static bool HasText() {
        #if WINDOWS
        return Clipboard.WinIsClipboardFormatAvailable(13) != 0;
        #else
        throw new PlatformNotSupportedException(
            "Clipboard is not implemented on this platform");
        #endif
    }

    /// 剪贴板上有文件列表（CF_HDROP）时为 true。
    static bool HasFiles() {
        #if WINDOWS
        return Clipboard.WinIsClipboardFormatAvailable(15) != 0;
        #else
        throw new PlatformNotSupportedException(
            "Clipboard is not implemented on this platform");
        #endif
    }

    /// <summary>读取 Unicode 文本；不可用时返回 ""。</summary>
    static string GetText() {
        #if WINDOWS
        if (Clipboard.WinIsClipboardFormatAvailable(13) == 0) { return ""; }
        if (Clipboard.WinOpenClipboard(0) == 0) { return ""; }
        nint handle = Clipboard.WinGetClipboardData(13);
        string s = "";
        if (handle != 0) {
            nint text = Clipboard.WinGlobalLock(handle);
            if (text != 0) {
                s = Wide.Read(text);
                Clipboard.WinGlobalUnlock(handle);
            }
        }
        Clipboard.WinCloseClipboard();
        return s;
        #else
        throw new PlatformNotSupportedException(
            "Clipboard is not implemented on this platform");
        #endif
    }

    /// <summary>将 Unicode 文本放入剪贴板。成功返回 true。</summary>
    static bool SetText(string text) {
        #if WINDOWS
        nint wide = Wide.Of(text);
        int units = Wide.Length(wide);
        nint mem = Clipboard.WinGlobalAlloc(2 /*GMEM_MOVEABLE*/, (units + 1) * 2);
        if (mem == 0) { Wide.Free(wide); return false; }
        nint dst = Clipboard.WinGlobalLock(mem);
        if (dst == 0) {
            Clipboard.WinGlobalFree(mem);
            Wide.Free(wide);
            return false;
        }
        NativeMemory.Copy(dst, wide, (units + 1) * 2);
        Clipboard.WinGlobalUnlock(mem);
        Wide.Free(wide);
        if (Clipboard.WinOpenClipboard(0) == 0) {
            Clipboard.WinGlobalFree(mem);
            return false;
        }
        Clipboard.WinEmptyClipboard();
        nint ok = Clipboard.WinSetClipboardData(13, mem);   // CF_UNICODETEXT
        Clipboard.WinCloseClipboard();
        if (ok == 0) {
            Clipboard.WinGlobalFree(mem);
            return false;
        }
        return true;
        #else
        throw new PlatformNotSupportedException(
            "Clipboard is not implemented on this platform");
        #endif
    }

    /// <summary>清空剪贴板。</summary>
    static void Clear() {
        #if WINDOWS
        if (Clipboard.WinOpenClipboard(0) != 0) {
            Clipboard.WinEmptyClipboard();
            Clipboard.WinCloseClipboard();
        }
        #else
        throw new PlatformNotSupportedException(
            "Clipboard is not implemented on this platform");
        #endif
    }

    /// <summary>将文件列表（CF_HDROP）放入剪贴板。成功
    /// 返回 true。</summary>
    static bool SetFiles(List<string> paths) {
        #if WINDOWS
        // DROPFILES：pFiles(4) pt(8) fNC(4) fWide(4) 共 20 字节，其后是
        // UTF-16 文件列表，每项以 NUL 结尾，末尾双 NUL 结束。
        int total = 20;
        int i = 0;
        for (; i < paths.Count; i = i + 1) {
            nint w = Wide.Of(paths[i]);
            total = total + (Wide.Length(w) + 1) * 2;
            Wide.Free(w);
        }
        total = total + 2;   // 末尾的双 NUL
        nint mem = Clipboard.WinGlobalAlloc(2, total);
        if (mem == 0) { return false; }
        nint dst = Clipboard.WinGlobalLock(mem);
        if (dst == 0) {
            Clipboard.WinGlobalFree(mem);
            return false;
        }
        new Span<int>(dst, 1)[0] = 20;        // DROPFILES.pFiles
        new Span<int>(dst + 16, 1)[0] = 1;    // DROPFILES.fWide = TRUE
        int offset = 20;
        i = 0;
        while (i < paths.Count) {
            nint w = Wide.Of(paths[i]);
            int units = Wide.Length(w);
            NativeMemory.Copy(dst + offset, w, (units + 1) * 2);
            Wide.Free(w);
            offset = offset + (units + 1) * 2;
            i = i + 1;
        }
        new Span<ushort>(dst + offset, 1)[0] = 0;   // 末尾的双 NUL
        Clipboard.WinGlobalUnlock(mem);
        if (Clipboard.WinOpenClipboard(0) == 0) {
            Clipboard.WinGlobalFree(mem);
            return false;
        }
        Clipboard.WinEmptyClipboard();
        nint ok = Clipboard.WinSetClipboardData(15, mem);   // CF_HDROP
        Clipboard.WinCloseClipboard();
        if (ok == 0) {
            Clipboard.WinGlobalFree(mem);
            return false;
        }
        return true;
        #else
        throw new PlatformNotSupportedException(
            "Clipboard is not implemented on this platform");
        #endif
    }

    /// <summary>读取文件列表（CF_HDROP）；不可用时返回空。</summary>
    static List<string> GetFiles() {
        List<string> list = new List<string>();
        #if WINDOWS
        if (Clipboard.WinIsClipboardFormatAvailable(15) == 0) { return list; }
        if (Clipboard.WinOpenClipboard(0) == 0) { return list; }
        nint hdrop = Clipboard.WinGetClipboardData(15);
        if (hdrop != 0) {
            int count = Clipboard.WinDragQueryFileW(hdrop, 0xFFFFFFFF, 0, 0);
            for (int i = 0; i < count; i = i + 1) {
                int len = Clipboard.WinDragQueryFileW(hdrop, i, 0, 0);
                nint buf = NativeMemory.Alloc((len + 1) * 2 + 2);
                Clipboard.WinDragQueryFileW(hdrop, i, buf, len + 1);
                list.Add(Wide.Read(buf));
                NativeMemory.Free(buf);
            }
        }
        Clipboard.WinCloseClipboard();
        #else
        throw new PlatformNotSupportedException(
            "Clipboard is not implemented on this platform");
        #endif
        return list;
    }

    /// <summary>当前剪贴板上所有格式的数值 id
    /// （包括已注册的自定义格式），按枚举顺序排列。</summary>
    static List<int> Formats() {
        List<int> list = new List<int>();
        #if WINDOWS
        if (Clipboard.WinOpenClipboard(0) == 0) { return list; }
        int fmt = 0;
        bool done = false;
        while (!done) {
            fmt = Clipboard.WinEnumClipboardFormats(fmt);
            if (fmt == 0) { done = true; }
            else { list.Add(fmt); }
        }
        Clipboard.WinCloseClipboard();
        #else
        throw new PlatformNotSupportedException(
            "Clipboard is not implemented on this platform");
        #endif
        return list;
    }

    /// <summary>注册（或查找）自定义格式名。返回的
    /// id 在进程生命周期内保持稳定。</summary>
    static int RegisterFormat(string name) {
        #if WINDOWS
        nint w = Wide.Of(name);
        int id = Clipboard.WinRegisterClipboardFormat(w);
        Wide.Free(w);
        return id;
        #else
        throw new PlatformNotSupportedException(
            "Clipboard is not implemented on this platform");
        #endif
    }

    /// <summary>（已注册）格式 id 的名称，内置格式返回 ""。</summary>
    static string FormatName(int format) {
        #if WINDOWS
        nint buf = NativeMemory.Alloc(512 * 2 + 2);
        int n = Clipboard.WinGetClipboardFormatName(format, buf, 512);
        string s = "";
        if (n > 0) { s = Wide.Read(buf); }
        NativeMemory.Free(buf);
        return s;
        #else
        throw new PlatformNotSupportedException(
            "Clipboard is not implemented on this platform");
        #endif
    }
}
