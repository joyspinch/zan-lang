using System;
using System.Threading;

namespace System.Windows;

/// <summary>
/// 托盘图标回调动作码：1 = 左键单击，2 = 左键双击，
/// 3 = 右键单击，4 = 中键单击。回调必须是普通静态方法
/// （委托无法捕获状态）；请把每个图标的状态放在静态字段中，
/// 与 Thread.Start 工作线程和 Input.Hook 回调的做法一致。
/// </summary>
delegate void TrayIconCallback(int action);

/// <summary>隐藏宿主窗口的窗口过程 (window proc)（WINAPI 调用约定）。</summary>
delegate nint TrayWndProcFn(nint hwnd, int msg, nint wp, nint lp);

/// <summary>托盘菜单选中回调：参数是被选项的 `id`。与
/// TrayIconCallback 一样必须是普通静态方法。</summary>
delegate void TrayMenuCallback(int id);

/// <summary>
/// 托盘右键菜单的一项。`id` 是选中时传给回调的编号，
/// 必须大于 0（0 是“未选择”）；分隔线用 `TrayMenuItem.Separator()`。
///
///   List&lt;TrayMenuItem&gt; m = new List&lt;TrayMenuItem&gt;();
///   m.Add(new TrayMenuItem(1, "显示主窗口"));
///   m.Add(TrayMenuItem.Separator());
///   m.Add(new TrayMenuItem(2, "退出"));
///   TrayIcon.SetMenu(m, Demo.OnTrayMenu);
/// </summary>
class TrayMenuItem {
    int id;
    string text;
    /// 置灰（不可选），仍然显示。
    bool disabled;
    /// 左侧勾选标记，用于“开机启动”这类开关项。
    bool checkMark;
    /// 分隔线无文本也不可选中。
    bool separator;

    TrayMenuItem(int itemId, string label) {
        id = itemId;
        text = label;
        disabled = false;
        checkMark = false;
        separator = false;
    }

    /// <summary>一条分隔线。</summary>
    static TrayMenuItem Separator() {
        TrayMenuItem it = new TrayMenuItem(0, "");
        it.separator = true;
        return it;
    }

    /// <summary>置灰此项（链式）。</summary>
    TrayMenuItem Disabled() { disabled = true; return this; }

    /// <summary>勾选此项（链式）。</summary>
    TrayMenuItem Check(bool on) { checkMark = on; return this; }
}

/// <summary>
/// 系统托盘（通知区域）图标，支持气泡通知。
/// 完全自包含：自行创建隐藏消息窗口和消息
/// 循环并运行在专用线程上，因此控制台程序和 GUI
/// 程序都可使用，且不依赖 Gui 框架。
///
///   TrayIconCallback cb = Demo.OnTray;      // 静态方法
///   TrayIcon.Add("myicon.ico", "MyApp", cb);
///   TrayIcon.ShowBalloon("Done", "Task finished", 1, 3000);
///   TrayIcon.SetMenu(items, Demo.OnTrayMenu);   // 右键菜单
///   TrayIcon.Remove();
///
/// 每个进程仅一个图标（常见情形）。仅 Windows 支持；其他
/// 平台会抛出 PlatformNotSupportedException。
/// </summary>
class TrayIcon {
    #if WINDOWS
    [DllImport("user32", EntryPoint = "RegisterClassExW")]
    static extern ushort WinRegisterClassExW(nint wc);

    [DllImport("user32", EntryPoint = "CreateWindowExW")]
    static extern nint WinCreateWindowExW(int exStyle, nint cls, nint title,
                                          int style, int x, int y, int w, int h,
                                          nint parent, nint menu, nint inst, nint param);

    [DllImport("user32", EntryPoint = "DefWindowProcW")]
    static extern nint WinDefWindowProcW(nint hwnd, int msg, nint wp, nint lp);

    [DllImport("user32", EntryPoint = "GetMessageW")]
    static extern int WinGetMessageW(nint msg, nint hwnd, int min, int max);

    [DllImport("user32", EntryPoint = "TranslateMessage")]
    static extern int WinTranslateMessage(nint msg);

    [DllImport("user32", EntryPoint = "DispatchMessageW")]
    static extern nint WinDispatchMessageW(nint msg);

    [DllImport("user32", EntryPoint = "DestroyWindow")]
    static extern int WinDestroyWindow(nint hwnd);

    [DllImport("user32", EntryPoint = "PostThreadMessageW")]
    static extern int WinPostThreadMessageW(int threadId, int msg, nint wp, nint lp);

    [DllImport("user32", EntryPoint = "LoadImageW")]
    static extern nint WinLoadImageW(nint inst, nint name, int type, int w, int h,
                                    int flags);

    [DllImport("user32", EntryPoint = "LoadIconW")]
    static extern nint WinLoadIconW(nint inst, nint name);

    [DllImport("user32", EntryPoint = "CreatePopupMenu")]
    static extern nint WinCreatePopupMenu();

    [DllImport("user32", EntryPoint = "AppendMenuW")]
    static extern int WinAppendMenuW(nint menu, int flags, nint id, nint item);

    [DllImport("user32", EntryPoint = "DestroyMenu")]
    static extern int WinDestroyMenu(nint menu);

    [DllImport("user32", EntryPoint = "TrackPopupMenuEx")]
    static extern int WinTrackPopupMenuEx(nint menu, int flags, int x, int y,
                                          nint hwnd, nint parms);

    [DllImport("user32", EntryPoint = "SetForegroundWindow")]
    static extern int WinSetForegroundWindow(nint hwnd);

    [DllImport("user32", EntryPoint = "GetCursorPos")]
    static extern int WinGetCursorPos(nint pt);

    [DllImport("user32", EntryPoint = "PostMessageW")]
    static extern int WinPostMessageW(nint hwnd, int msg, nint wp, nint lp);

    [DllImport("user32", EntryPoint = "DestroyIcon")]
    static extern int WinDestroyIcon(nint icon);

    [DllImport("user32", EntryPoint = "RegisterWindowMessageW")]
    static extern int WinRegisterWindowMessageW(nint name);

    [DllImport("kernel32", EntryPoint = "GetCurrentThreadId")]
    static extern int WinGetCurrentThreadId();

    [DllImport("shell32", EntryPoint = "Shell_NotifyIconW")]
    static extern int WinShellNotifyIcon(int msg, nint data);

    static TrayIconCallback userCb;
    static nint trayHwnd;
    static int trayThreadId;
    static nint trayIcon;
    static int threadFailed;
    static int taskbarCreatedMsg;
    static string trayIconPath;
    static TrayWndProcFn wndProc;
    /// 右键菜单模型。菜单在每次弹出时从这份列表重建，
    /// 因此调用方可以随时改完后重新 SetMenu（例如切换勾选）。
    static List<TrayMenuItem> menuItems;
    static TrayMenuCallback menuCb;
    #endif

    /// <summary>
    /// 添加托盘图标。`iconPath` 是 .ico 文件（"" 使用默认
    /// 应用图标）。`tooltip` 是悬停文本。图标
    /// 成功显示后返回 true。若已添加过图标（需先移除）
    /// 或原生调用失败，则返回 false。
    /// </summary>
    static bool Add(string iconPath, string tooltip, TrayIconCallback cb) {
        #if WINDOWS
        if (TrayIcon.trayHwnd != 0) { return false; }
        TrayIcon.userCb = cb;
        TrayIcon.trayIconPath = iconPath;
        TrayIcon.threadFailed = 0;
        Thread.Start(TrayIcon.TrayThreadEntry);
        for (int waited = 0; TrayIcon.trayHwnd == 0 && TrayIcon.threadFailed == 0 && waited < 3000; waited = waited + 1) {
            Thread.Sleep(1);
        }
        if (TrayIcon.trayHwnd == 0) {
            TrayIcon.userCb = null;
            return false;
        }
        return true;
        #else
        throw new PlatformNotSupportedException(
            "TrayIcon is not implemented on this platform");
        #endif
    }

    /// <summary>移除托盘图标并停止消息循环线程。
    /// 未添加任何图标时调用也是安全的。</summary>
    static void Remove() {
        #if WINDOWS
        if (TrayIcon.trayHwnd == 0) { return; }
        TrayIcon.Notify(2 /*NIM_DELETE*/);
        TrayIcon.WinPostThreadMessageW(TrayIcon.trayThreadId, 0x0012 /*WM_QUIT*/, 0, 0);
        while (TrayIcon.trayHwnd != 0) { Thread.Sleep(1); }
        TrayIcon.userCb = null;
        TrayIcon.menuItems = null;
        TrayIcon.menuCb = null;
        #else
        throw new PlatformNotSupportedException(
            "TrayIcon is not implemented on this platform");
        #endif
    }

    /// <summary>修改当前图标的悬停提示文本。</summary>
    static bool SetTooltip(string tooltip) {
        #if WINDOWS
        if (TrayIcon.trayHwnd == 0) { return false; }
        nint data = TrayIcon.BuildData(tooltip, "", "", 0, 0);
        if (data == 0) { return false; }
        // 仅 NIF_TIP。
        new Span<int>(data + 20, 1)[0] = 0x0004;
        int ok = TrayIcon.WinShellNotifyIcon(1 /*NIM_MODIFY*/, data);
        NativeMemory.Free(data);
        return ok != 0;
        #else
        throw new PlatformNotSupportedException(
            "TrayIcon is not implemented on this platform");
        #endif
    }

    /// <summary>
    /// 在图标上方显示气泡通知。`iconKind`：0 = 无图标，
    /// 1 = 信息，2 = 警告，3 = 错误。`timeoutMs` 为显示时长
    /// （新版 Windows 会忽略超过 30 秒的值）。
    /// </summary>
    static bool ShowBalloon(string title, string text, int iconKind, int timeoutMs) {
        #if WINDOWS
        if (TrayIcon.trayHwnd == 0) { return false; }
        nint data = TrayIcon.BuildData("", title, text, iconKind, timeoutMs);
        if (data == 0) { return false; }
        // 仅 NIF_INFO。
        new Span<int>(data + 20, 1)[0] = 0x0010;
        int ok = TrayIcon.WinShellNotifyIcon(1 /*NIM_MODIFY*/, data);
        NativeMemory.Free(data);
        return ok != 0;
        #else
        throw new PlatformNotSupportedException(
            "TrayIcon is not implemented on this platform");
        #endif
    }

    /// <summary>
    /// 设置右键托盘菜单。右键（或菜单键）点击图标时在
    /// 托盘线程上弹出菜单，选中后以选项 `id` 调用 `cb`（回调
    /// 在托盘线程上执行，要动 UI 请投递到自己的窗口）。弹出时
    /// 每次重建菜单，因此只需改完列表再调一次就能切换勾选/置灰。
    /// 传 null 或空列表等于 ClearMenu()。
    /// </summary>
    static void SetMenu(List<TrayMenuItem> items, TrayMenuCallback cb) {
        #if WINDOWS
        TrayIcon.menuItems = items;
        TrayIcon.menuCb = cb;
        #else
        throw new PlatformNotSupportedException(
            "TrayIcon is not implemented on this platform");
        #endif
    }

    /// <summary>移除右键菜单，右键回到只通知 TrayIconCallback。</summary>
    static void ClearMenu() {
        #if WINDOWS
        TrayIcon.menuItems = null;
        TrayIcon.menuCb = null;
        #else
        throw new PlatformNotSupportedException(
            "TrayIcon is not implemented on this platform");
        #endif
    }

    #if WINDOWS
    /// 在鼠标处弹出右键菜单并同步等待选择。必须在托盘
    /// 线程（拥有隐藏窗口的那个）上调用。先 SetForegroundWindow
    /// 再 TrackPopupMenuEx，否则菜单不能失焦关闭（经典 Win32 坑）。
    static void ShowMenu() {
        List<TrayMenuItem> items = TrayIcon.menuItems;
        if (items == null || items.Count == 0) { return; }
        nint menu = TrayIcon.WinCreatePopupMenu();
        if (menu == 0) { return; }
        for (int i = 0; i < items.Count; i = i + 1) {
            TrayMenuItem it = items[i];
            if (it == null) { continue; }
            if (it.separator) {
                TrayIcon.WinAppendMenuW(menu, 0x0800 /*MF_SEPARATOR*/, 0, 0);
                continue;
            }
            int flags = 0;                            // MF_STRING
            if (it.disabled) { flags = flags | 0x0003; }   // MF_GRAYED|MF_DISABLED
            if (it.checkMark) { flags = flags | 0x0008; }  // MF_CHECKED
            nint label = Wide.Of(it.text);
            TrayIcon.WinAppendMenuW(menu, flags, (nint)it.id, label);
            Wide.Free(label);
        }
        nint pt = NativeMemory.Alloc(8);
        TrayIcon.ZeroMem(pt, 8);
        TrayIcon.WinGetCursorPos(pt);
        Span<int> xy = new Span<int>(pt, 2);
        int px = xy[0];
        int py = xy[1];
        NativeMemory.Free(pt);
        TrayIcon.WinSetForegroundWindow(TrayIcon.trayHwnd);
        // TPM_RETURNCMD|TPM_RIGHTBUTTON|TPM_NONOTIFY
        int cmd = TrayIcon.WinTrackPopupMenuEx(menu, 0x0100 | 0x0002 | 0x0080,
                                              px, py, TrayIcon.trayHwnd, 0);
        TrayIcon.WinDestroyMenu(menu);
        // 菜单关闭后需要一条空消息，否则下一次弹出可能不响应。
        TrayIcon.WinPostMessageW(TrayIcon.trayHwnd, 0 /*WM_NULL*/, 0, 0);
        if (cmd > 0 && TrayIcon.menuCb != null) { TrayIcon.menuCb(cmd); }
    }

    /// 在托盘线程上运行：注册窗口类，创建
    /// 隐藏窗口，添加图标，然后泵送消息直到 WM_QUIT。
    static void TrayThreadEntry() {
        int tid = TrayIcon.WinGetCurrentThreadId();
        TrayIcon.trayThreadId = tid;
        TrayIcon.taskbarCreatedMsg = TrayIcon.RegisterTaskbarCreated();

        nint wc = NativeMemory.Alloc(80);
        TrayIcon.ZeroMem(wc, 80);
        new Span<int>(wc, 1)[0] = 80;              // cbSize
        TrayIcon.wndProc = TrayIcon.TrayWndProcImpl;
        new Span<long>(wc + 8, 1)[0] = (nint)TrayIcon.wndProc;   // lpfnWndProc
        new Span<long>(wc + 24, 1)[0] = 0;         // hInstance
        nint cls = Wide.Of("ZanTrayHost");
        new Span<long>(wc + 64, 1)[0] = cls;       // lpszClassName
        ushort atom = TrayIcon.WinRegisterClassExW(wc);
        if (atom == 0) {
            TrayIcon.threadFailed = 1;
            Wide.Free(cls);
            NativeMemory.Free(wc);
            return;
        }
        nint hwnd = TrayIcon.WinCreateWindowExW(0, cls, cls, 0, 0, 0, 0, 0, 0, 0, 0, 0);
        Wide.Free(cls);
        NativeMemory.Free(wc);
        if (hwnd == 0) {
            TrayIcon.threadFailed = 1;
            return;
        }
        TrayIcon.trayHwnd = hwnd;
        TrayIcon.LoadIcon();
        if (!TrayIcon.Notify(0 /*NIM_ADD*/)) {
            TrayIcon.WinDestroyWindow(hwnd);
            TrayIcon.trayHwnd = 0;
            TrayIcon.threadFailed = 1;
            return;
        }
        // 请求 Vista 及以上的行为（气泡回调等）。
        TrayIcon.SetVersion();

        nint msg = NativeMemory.Alloc(64);
        while (true) {
            int r = TrayIcon.WinGetMessageW(msg, 0, 0, 0);
            if (r <= 0) { break; }
            TrayIcon.WinTranslateMessage(msg);
            TrayIcon.WinDispatchMessageW(msg);
        }
        NativeMemory.Free(msg);
        TrayIcon.Notify(2 /*NIM_DELETE*/);
        if (TrayIcon.trayIcon != 0) {
            TrayIcon.WinDestroyIcon(TrayIcon.trayIcon);
            TrayIcon.trayIcon = 0;
        }
        TrayIcon.WinDestroyWindow(hwnd);
        TrayIcon.trayHwnd = 0;
    }

    static int RegisterTaskbarCreated() {
        nint name = Wide.Of("TaskbarCreated");
        int msg = TrayIcon.WinRegisterWindowMessageW(name);
        Wide.Free(name);
        return msg;
    }

    /// 只加载一次图标：给定 `trayIconPath`（.ico 文件）时从文件加载，
    /// 否则加载默认应用图标。句柄缓存在
    /// trayIcon 中，并在线程清理时销毁。
    static void LoadIcon() {
        if (TrayIcon.trayIcon != 0) { return; }
        nint icon = 0;
        if (TrayIcon.trayIconPath != "") {
            nint wpath = Wide.Of(TrayIcon.trayIconPath);
            // IMAGE_ICON=1, LR_LOADFROMFILE=0x10 | LR_DEFAULTSIZE=0x40.
            icon = TrayIcon.WinLoadImageW(0, wpath, 1, 0, 0, 0x50);
            Wide.Free(wpath);
        }
        if (icon == 0) {
            icon = TrayIcon.WinLoadIconW(0, (nint)32512);   // IDI_APPLICATION
        }
        TrayIcon.trayIcon = icon;
    }

    static void SetVersion() {
        nint data = NativeMemory.Alloc(976);
        TrayIcon.ZeroMem(data, 976);
        new Span<int>(data, 1)[0] = 976;
        new Span<long>(data + 8, 1)[0] = TrayIcon.trayHwnd;
        new Span<int>(data + 16, 1)[0] = 1;       // uID
        new Span<int>(data + 816, 1)[0] = 3;      // NOTIFYICON_VERSION_4
        TrayIcon.WinShellNotifyIcon(4 /*NIM_SETVERSION*/, data);
        NativeMemory.Free(data);
    }

    /// 以当前图标状态发送 Shell_NotifyIconW 消息。
    static bool Notify(int msg) {
        nint data = TrayIcon.BuildData("", "", "", 0, 0);
        if (data == 0) { return false; }
        int ok = TrayIcon.WinShellNotifyIcon(msg, data);
        NativeMemory.Free(data);
        return ok != 0;
    }

    /// 分配一个清零的 NOTIFYICONDATAW（984 字节，x64 布局），
    /// 并填好固定字段：cbSize、hWnd、uID、uFlags（NIF_MESSAGE|NIF_ICON
    /// |NIF_TIP）、uCallbackMessage、hIcon 以及气泡字段。
    static nint BuildData(string tooltip, string title, string text,
                          int iconKind, int timeoutMs) {
        nint data = NativeMemory.Alloc(976);
        TrayIcon.ZeroMem(data, 976);
        new Span<int>(data, 1)[0] = 976;          // cbSize
        new Span<long>(data + 8, 1)[0] = TrayIcon.trayHwnd;
        new Span<int>(data + 16, 1)[0] = 1;       // uID
        new Span<int>(data + 20, 1)[0] = 0x0007;  // NIF_MESSAGE|NIF_ICON|NIF_TIP
        new Span<int>(data + 24, 1)[0] = 0x8000;  // uCallbackMessage (WM_APP)
        nint icon = TrayIcon.trayIcon;
        if (icon == 0) {
            icon = TrayIcon.WinLoadIconW(0, (nint)32512);   // IDI_APPLICATION
            TrayIcon.trayIcon = icon;
        }
        new Span<long>(data + 32, 1)[0] = icon;   // hIcon
        TrayIcon.PutWide(data + 40, tooltip, 128);
        if (title != "" || text != "") {
            TrayIcon.PutWide(data + 304, text, 256);    // szInfo
            TrayIcon.PutWide(data + 820, title, 64);    // szInfoTitle
            new Span<int>(data + 948, 1)[0] = TrayIcon.BalloonFlags(iconKind);
            new Span<int>(data + 816, 1)[0] = timeoutMs;  // uTimeout
        }
        return data;
    }

    static int BalloonFlags(int kind) {
        if (kind <= 0) { return 0; }          // NIIF_NONE
        if (kind == 1) { return 0x0001; }     // NIIF_INFO
        if (kind == 2) { return 0x0002; }     // NIIF_WARNING
        return 0x0003;                        // NIIF_ERROR
    }

    /// 将 Zan 字符串复制到固定大小的 WCHAR 字段（units 含结尾 NUL）。
    static void PutWide(nint dst, string s, int units) {
        if (s == "") { return; }
        nint w = Wide.Of(s);
        int len = Wide.Length(w);
        if (len >= units) { len = units - 1; }
        NativeMemory.Copy(dst, w, len * 2);
        new Span<ushort>(dst + len * 2, 1)[0] = 0;
        Wide.Free(w);
    }

    static void ZeroMem(nint p, int bytes) {
        for (int i = 0; i < bytes; i = i + 1) {
            new Span<byte>(p + i, 1)[0] = 0;
        }
    }

    /// 隐藏宿主窗口的窗口过程 (window proc)。只有托盘回调
    /// 消息和 TaskbarCreated 消息值得关注。
    static nint TrayWndProcImpl(nint hwnd, int msg, nint wp, nint lp) {
        if (msg == 0x8000 /*WM_APP*/) {
            int l = (int)lp;
            if (TrayIcon.userCb != null) {
                int action = 0;
                if (l == 0x0201) { action = 1; }      // WM_LBUTTONDOWN
                if (l == 0x0203) { action = 2; }      // WM_LBUTTONDBLCLK
                if (l == 0x0204) { action = 3; }      // WM_RBUTTONDOWN
                if (l == 0x0207) { action = 4; }      // WM_MBUTTONDOWN
                if (action != 0) { TrayIcon.userCb(action); }
            }
            // 右键抬起 / 菜单键：弹出托盘菜单。用抬起而不是按下，
            // 与系统托盘图标一致。
            if (l == 0x0205 /*WM_RBUTTONUP*/ || l == 0x007B /*WM_CONTEXTMENU*/) {
                TrayIcon.ShowMenu();
            }
        }
        if (msg == TrayIcon.taskbarCreatedMsg && TrayIcon.trayHwnd != 0) {
            // Explorer 已重启：重新添加图标，使图标得以保留。
            TrayIcon.Notify(0 /*NIM_ADD*/);
            TrayIcon.SetVersion();
        }
        return TrayIcon.WinDefWindowProcW(hwnd, msg, wp, lp);
    }
    #endif
}
