using System;

namespace System.Windows;

/// <summary>
/// 屏幕捕获、像素探测与显示器信息。Windows 通过
/// GDI（GetDC/BitBlt/GetDIBits）实现全部功能；其他平台提供
/// 相同 API 但会抛出 PlatformNotSupportedException（捕获后端
/// 需要 X11/AppKit，属于后续里程碑）。
///
/// 像素以 BGRA 字节数组返回（stride = 宽度 * 4，行序
/// 自上而下）。颜色为 0xAARRGGBB。
///
///   byte[] px = Screen.CapturePixels(0, 0, 100, 80);
///   Screen.CaptureAllToBmp("screen.bmp");
///   int c = Screen.GetPixel(10, 10);
/// </summary>
class Screen {
    #if WINDOWS
    [DllImport("user32", EntryPoint = "GetDC")]
    static extern nint WinGetDC(nint hwnd);

    [DllImport("user32", EntryPoint = "ReleaseDC")]
    static extern int WinReleaseDC(nint hwnd, nint dc);

    [DllImport("user32", EntryPoint = "GetSystemMetrics")]
    static extern int WinGetSystemMetrics(int index);

    [DllImport("gdi32", EntryPoint = "CreateCompatibleDC")]
    static extern nint WinCreateCompatibleDC(nint dc);

    [DllImport("gdi32", EntryPoint = "CreateCompatibleBitmap")]
    static extern nint WinCreateCompatibleBitmap(nint dc, int w, int h);

    [DllImport("gdi32", EntryPoint = "SelectObject")]
    static extern nint WinSelectObject(nint dc, nint obj);

    [DllImport("gdi32", EntryPoint = "DeleteObject")]
    static extern int WinDeleteObject(nint obj);

    [DllImport("gdi32", EntryPoint = "DeleteDC")]
    static extern int WinDeleteDC(nint dc);

    [DllImport("gdi32", EntryPoint = "BitBlt")]
    static extern int WinBitBlt(nint dst, int x, int y, int w, int h,
                                nint src, int sx, int sy, int rop);

    [DllImport("gdi32", EntryPoint = "GetDIBits")]
    static extern int WinGetDIBits(nint dc, nint bmp, int start, int lines,
                                   nint bits, nint bmi, int usage);

    [DllImport("gdi32", EntryPoint = "GetDeviceCaps")]
    static extern int WinGetDeviceCaps(nint dc, int index);

    [DllImport("crt", EntryPoint = "fopen")]
    static extern nint PlatFopen(string path, string mode);

    [DllImport("crt", EntryPoint = "fwrite")]
    static extern long PlatFwrite(byte[] buf, long size, long count, nint fp);

    [DllImport("crt", EntryPoint = "fclose")]
    static extern int PlatFclose(nint fp);
    #endif

    /// <summary>主屏幕宽度（像素）。</summary>
    static int ScreenWidth() {
        #if WINDOWS
        return Screen.WinGetSystemMetrics(0 /*SM_CXSCREEN*/);
        #else
        throw new PlatformNotSupportedException(
            "Screen is not implemented on this platform");
        #endif
    }

    /// <summary>主屏幕高度（像素）。</summary>
    static int ScreenHeight() {
        #if WINDOWS
        return Screen.WinGetSystemMetrics(1 /*SM_CYSCREEN*/);
        #else
        throw new PlatformNotSupportedException(
            "Screen is not implemented on this platform");
        #endif
    }

    /// <summary>主屏幕 DPI（96 = 100%）。</summary>
    static int Dpi() {
        #if WINDOWS
        nint dc = Screen.WinGetDC(0);
        int dpi = Screen.WinGetDeviceCaps(dc, 88 /*LOGPIXELSX*/);
        Screen.WinReleaseDC(0, dc);
        if (dpi <= 0) { dpi = 96; }
        return dpi;
        #else
        return 96;
        #endif
    }

    /// <summary>屏幕坐标 (x, y) 处像素的颜色，格式为
    /// 0xAARRGGBB；捕获失败返回 -1。通过 1x1 BitBlt 实现
    /// （GDI GetPixel 在 DWM 合成桌面上不可靠）。</summary>
    static int GetPixel(int x, int y) {
        #if WINDOWS
        byte[] px = Screen.CapturePixels(x, y, 1, 1);
        if (px == null || px.Length < 4) { return -1; }
        int b = px[0] & 255;
        int g = px[1] & 255;
        int r = px[2] & 255;
        return 0xFF000000 | (r << 16) | (g << 8) | b;
        #else
        throw new PlatformNotSupportedException(
            "Screen is not implemented on this platform");
        #endif
    }

    /// <summary>将屏幕矩形捕获为 BGRA 像素（自上而下，
    /// stride = 宽度 * 4）。捕获失败返回 null。</summary>
    static byte[] CapturePixels(int x, int y, int w, int h) {
        #if WINDOWS
        if (w <= 0 || h <= 0) { return null; }
        nint screenDc = Screen.WinGetDC(0);
        if (screenDc == 0) { return null; }
        nint memDc = Screen.WinCreateCompatibleDC(screenDc);
        if (memDc == 0) {
            Screen.WinReleaseDC(0, screenDc);
            return null;
        }
        nint bmp = Screen.WinCreateCompatibleBitmap(screenDc, w, h);
        if (bmp == 0) {
            Screen.WinDeleteDC(memDc);
            Screen.WinReleaseDC(0, screenDc);
            return null;
        }
        Screen.WinSelectObject(memDc, bmp);
        int ok = Screen.WinBitBlt(memDc, 0, 0, w, h, screenDc, x, y,
                                  0x00CC0020 /*SRCCOPY*/);
        byte[] px = null;
        if (ok != 0) { px = Screen.ReadBitmap(memDc, bmp, w, h); }
        Screen.WinDeleteObject(bmp);
        Screen.WinDeleteDC(memDc);
        Screen.WinReleaseDC(0, screenDc);
        return px;
        #else
        throw new PlatformNotSupportedException(
            "Screen is not implemented on this platform");
        #endif
    }

    /// <summary>捕获主屏幕并写入 32 位 BMP 文件。
    /// 成功返回 true。</summary>
    static bool CaptureAllToBmp(string path) {
        #if WINDOWS
        return Screen.CaptureToBmp(path, 0, 0, Screen.ScreenWidth(),
                                   Screen.ScreenHeight());
        #else
        throw new PlatformNotSupportedException(
            "Screen is not implemented on this platform");
        #endif
    }

    /// <summary>捕获屏幕矩形并写入 32 位 BMP 文件。
    /// 成功返回 true。</summary>
    static bool CaptureToBmp(string path, int x, int y, int w, int h) {
        #if WINDOWS
        byte[] px = Screen.CapturePixels(x, y, w, h);
        if (px == null) { return false; }
        return Screen.WriteBmp(path, px, w, h);
        #else
        throw new PlatformNotSupportedException(
            "Screen is not implemented on this platform");
        #endif
    }

    #if WINDOWS
    /// 用 GetDIBits 将选中的位图读入自上而下的 BGRA 字节数组。
    static byte[] ReadBitmap(nint dc, nint bmp, int w, int h) {
        nint bmi = NativeMemory.Alloc(40);
        new Span<int>(bmi, 10)[0] = 40;            // biSize
        new Span<int>(bmi + 4, 1)[0] = w;          // biWidth
        new Span<int>(bmi + 8, 1)[0] = 0 - h;      // biHeight（自上而下）
        new Span<ushort>(bmi + 12, 1)[0] = 1;      // biPlanes
        new Span<ushort>(bmi + 14, 1)[0] = 32;     // biBitCount
        new Span<int>(bmi + 16, 1)[0] = 0;         // biCompression = BI_RGB
        int stride = w * 4;
        int size = stride * h;
        nint bits = NativeMemory.Alloc(size);
        int got = Screen.WinGetDIBits(dc, bmp, 0, h, bits, bmi, 0 /*DIB_RGB_COLORS*/);
        byte[] px = null;
        if (got == h) {
            px = new byte[size];
            for (int i = 0; i < size; i = i + 1) {
                px[i] = new Span<byte>(bits + i, 1)[0];
            }
        }
        NativeMemory.Free(bits);
        NativeMemory.Free(bmi);
        return px;
    }

    /// 将 32 位 BGRA 像素缓冲写入自下而上 (bottom-up) 的 BMP 文件。
    static bool WriteBmp(string path, byte[] px, int w, int h) {
        int stride = w * 4;
        int pixelBytes = stride * h;
        int fileSize = 54 + pixelBytes;
        byte[] bmp = new byte[fileSize];
        // BITMAPFILEHEADER（14 字节）。
        bmp[0] = 66; bmp[1] = 77;                 // "BM"
        Screen.PutInt(bmp, 2, fileSize);
        Screen.PutInt(bmp, 10, 54);               // 数据偏移量
        // BITMAPINFOHEADER（40 字节）。
        Screen.PutInt(bmp, 14, 40);               // biSize
        Screen.PutInt(bmp, 18, w);
        Screen.PutInt(bmp, 22, h);                // 自下而上 (bottom-up)
        bmp[26] = 1;                              // 平面数
        bmp[28] = 32;                             // 位深 (bit count)
        // biCompression = 0（BI_RGB），其余字段为 0。
        // 像素：行序翻转（BMP 自下而上存储）。
        int dst = 54;
        int row = h - 1;
        while (row >= 0) {
            int src = row * stride;
            for (int k = 0; k < stride; k = k + 1) {
                bmp[dst + k] = px[src + k];
            }
            dst = dst + stride;
            row = row - 1;
        }
        nint fp = Screen.PlatFopen(path, "wb");
        if (fp == 0) { return false; }
        long n = Screen.PlatFwrite(bmp, 1, fileSize, fp);
        Screen.PlatFclose(fp);
        return n == fileSize;
    }

    static void PutInt(byte[] b, int off, int v) {
        b[off] = (byte)(v & 255);
        b[off + 1] = (byte)((v >> 8) & 255);
        b[off + 2] = (byte)((v >> 16) & 255);
        b[off + 3] = (byte)((v >> 24) & 255);
    }
    #endif
}
