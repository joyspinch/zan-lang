using System;
using System.Diagnostics;
using System.IO;

namespace System.Windows.Forms;

/// <summary>
/// 原生 Win32 控件的薄封装（HWND 级别）。这一组类刻意只包 Windows
/// 的窗口/按钮/编辑框，没有跨平台等价物——X11/Cocoa 上没有"CreateWindowExA
/// 加 BUTTON 类名"这种东西。跨平台的界面请用 `Gui`（Gui.App/Gui.Widget.*），
/// 它在三个平台上都有后端。
///
/// 非 Windows 上这些方法抛出 PlatformNotSupportedException 而不是链接失败，
/// 因此引用了它们的程序仍能在任何平台编译，只在真正调用时明确报错。
/// 唯一例外是 <see cref="MessageBox"/>：桌面提示框在每个平台都有等价物
/// （zenity/kdialog/osascript），因此它是真正跨平台的。
/// </summary>
class Window {
    #if WINDOWS
    [DllImport("user32")]
    static extern ushort RegisterClassExA(string lpwcx);

    [DllImport("user32")]
    static extern nint CreateWindowExA(int exStyle, string className, string title,
        int style, int x, int y, int width, int height,
        nint parent, nint menu, nint instance, nint param);

    [DllImport("user32")]
    static extern int ShowWindow(nint hwnd, int cmdShow);

    [DllImport("user32")]
    static extern int UpdateWindow(nint hwnd);

    [DllImport("user32")]
    static extern int GetMessageA(string msg, nint hwnd, int filterMin, int filterMax);

    [DllImport("user32")]
    static extern int TranslateMessage(string msg);

    [DllImport("user32")]
    static extern nint DispatchMessageA(string msg);

    [DllImport("user32")]
    static extern nint DefWindowProcA(nint hwnd, int msg, nint wparam, nint lparam);

    [DllImport("user32")]
    static extern void PostQuitMessage(int exitCode);

    [DllImport("user32")]
    static extern int DestroyWindow(nint hwnd);

    [DllImport("user32")]
    static extern int SetWindowTextA(nint hwnd, string text);

    [DllImport("user32")]
    static extern int GetWindowTextA(nint hwnd, string buf, int maxCount);

    [DllImport("user32")]
    static extern int MoveWindow(nint hwnd, int x, int y, int w, int h, int repaint);

    [DllImport("user32")]
    static extern int InvalidateRect(nint hwnd, nint rect, int erase);

    [DllImport("user32")]
    static extern nint SendMessageA(nint hwnd, int msg, nint wparam, nint lparam);

    [DllImport("kernel32")]
    static extern nint GetModuleHandleA(string name);
    #endif

    int handle;
    string title;
    int width;
    int height;

    Window(string title, int width, int height) {
        this.title = title;
        this.width = width;
        this.height = height;
        this.handle = 0;
    }

    /// 非 Windows 上统一的失败点：HWND 控件没有 X11/Cocoa 等价物。
    static void NoHwnd(string what) {
        throw new PlatformNotSupportedException(
            what + " wraps a Win32 HWND control and has no equivalent on this "
            + "platform; use the cross-platform Gui toolkit (Gui.App + "
            + "Gui.Widget.*) instead");
    }

    static nint Create(string title, int width, int height) {
        #if WINDOWS
        int WS_OVERLAPPEDWINDOW = 13565952;
        int CW_USEDEFAULT = 0 - 2147483647 - 1;
        nint hInstance = GetModuleHandleA("");

        nint hwnd = CreateWindowExA(0, "STATIC", title,
            WS_OVERLAPPEDWINDOW,
            CW_USEDEFAULT, CW_USEDEFAULT, width, height,
            0, 0, hInstance, 0);
        return hwnd;
        #else
        Window.NoHwnd("Forms.Window.Create");
        return 0;
        #endif
    }

    static void Show(int hwnd) {
        #if WINDOWS
        ShowWindow(hwnd, 1);
        UpdateWindow(hwnd);
        #else
        Window.NoHwnd("Forms.Window.Show");
        #endif
    }

    static void Hide(int hwnd) {
        #if WINDOWS
        ShowWindow(hwnd, 0);
        #else
        Window.NoHwnd("Forms.Window.Hide");
        #endif
    }

    static void SetTitle(int hwnd, string text) {
        #if WINDOWS
        SetWindowTextA(hwnd, text);
        #else
        Window.NoHwnd("Forms.Window.SetTitle");
        #endif
    }

    static string GetTitle(int hwnd) {
        #if WINDOWS
        byte[] buf = new byte[256];
        int n = GetWindowTextA(hwnd, buf, 255);
        if (n < 0) { n = 0; }
        return buf.ToStr(0, n);
        #else
        Window.NoHwnd("Forms.Window.GetTitle");
        return "";
        #endif
    }

    static void SetPosition(int hwnd, int x, int y, int w, int h) {
        #if WINDOWS
        MoveWindow(hwnd, x, y, w, h, 1);
        #else
        Window.NoHwnd("Forms.Window.SetPosition");
        #endif
    }

    static void Close(int hwnd) {
        #if WINDOWS
        DestroyWindow(hwnd);
        #else
        Window.NoHwnd("Forms.Window.Close");
        #endif
    }

    static void MessageLoop() {
        #if WINDOWS
        byte[] msg = new byte[48];
        while (GetMessageA(msg, 0, 0, 0) != 0) {
            TranslateMessage(msg);
            DispatchMessageA(msg);
        }
        #else
        Window.NoHwnd("Forms.Window.MessageLoop");
        #endif
    }
}

class Button {
    #if WINDOWS
    [DllImport("user32")]
    static extern nint CreateWindowExA(int exStyle, string className, string text,
        int style, int x, int y, int width, int height,
        nint parent, nint id, nint instance, nint param);

    [DllImport("user32")]
    static extern int ShowWindow(nint hwnd, int cmdShow);

    [DllImport("user32")]
    static extern int SetWindowTextA(nint hwnd, string text);

    [DllImport("user32")]
    static extern int EnableWindow(nint hwnd, int enable);

    [DllImport("kernel32")]
    static extern nint GetModuleHandleA(string name);
    #endif

    static nint Create(int parent, string text, int x, int y, int w, int h, int id) {
        #if WINDOWS
        int WS_CHILD = 1073741824;
        int WS_VISIBLE = 268435456;
        int BS_PUSHBUTTON = 0;
        int style = WS_CHILD + WS_VISIBLE + BS_PUSHBUTTON;
        nint hInstance = GetModuleHandleA("");
        nint hwnd = CreateWindowExA(0, "BUTTON", text, style, x, y, w, h, parent, id, hInstance, 0);
        return hwnd;
        #else
        Window.NoHwnd("Forms.Button.Create");
        return 0;
        #endif
    }

    static void SetText(int hwnd, string text) {
        #if WINDOWS
        SetWindowTextA(hwnd, text);
        #else
        Window.NoHwnd("Forms.Button.SetText");
        #endif
    }

    static void Enable(int hwnd) {
        #if WINDOWS
        EnableWindow(hwnd, 1);
        #else
        Window.NoHwnd("Forms.Button.Enable");
        #endif
    }

    static void Disable(int hwnd) {
        #if WINDOWS
        EnableWindow(hwnd, 0);
        #else
        Window.NoHwnd("Forms.Button.Disable");
        #endif
    }
}

class Label {
    #if WINDOWS
    [DllImport("user32")]
    static extern nint CreateWindowExA(int exStyle, string className, string text,
        int style, int x, int y, int width, int height,
        nint parent, nint id, nint instance, nint param);

    [DllImport("user32")]
    static extern int SetWindowTextA(nint hwnd, string text);

    [DllImport("kernel32")]
    static extern nint GetModuleHandleA(string name);
    #endif

    static nint Create(int parent, string text, int x, int y, int w, int h) {
        #if WINDOWS
        int WS_CHILD = 1073741824;
        int WS_VISIBLE = 268435456;
        int SS_LEFT = 0;
        int style = WS_CHILD + WS_VISIBLE + SS_LEFT;
        nint hInstance = GetModuleHandleA("");
        nint hwnd = CreateWindowExA(0, "STATIC", text, style, x, y, w, h, parent, 0, hInstance, 0);
        return hwnd;
        #else
        Window.NoHwnd("Forms.Label.Create");
        return 0;
        #endif
    }

    static void SetText(int hwnd, string text) {
        #if WINDOWS
        SetWindowTextA(hwnd, text);
        #else
        Window.NoHwnd("Forms.Label.SetText");
        #endif
    }
}

class TextBox {
    #if WINDOWS
    [DllImport("user32")]
    static extern nint CreateWindowExA(int exStyle, string className, string text,
        int style, int x, int y, int width, int height,
        nint parent, nint id, nint instance, nint param);

    [DllImport("user32")]
    static extern int SetWindowTextA(nint hwnd, string text);

    [DllImport("user32")]
    static extern int GetWindowTextA(nint hwnd, string buf, int maxCount);

    [DllImport("user32")]
    static extern int GetWindowTextLengthA(nint hwnd);

    [DllImport("kernel32")]
    static extern nint GetModuleHandleA(string name);
    #endif

    static nint Create(int parent, int x, int y, int w, int h, int id) {
        #if WINDOWS
        int WS_CHILD = 1073741824;
        int WS_VISIBLE = 268435456;
        int WS_BORDER = 8388608;
        int ES_AUTOHSCROLL = 128;
        int WS_EX_CLIENTEDGE = 512;
        int style = WS_CHILD + WS_VISIBLE + WS_BORDER + ES_AUTOHSCROLL;
        nint hInstance = GetModuleHandleA("");
        nint hwnd = CreateWindowExA(WS_EX_CLIENTEDGE, "EDIT", "", style, x, y, w, h, parent, id, hInstance, 0);
        return hwnd;
        #else
        Window.NoHwnd("Forms.TextBox.Create");
        return 0;
        #endif
    }

    static nint CreateMultiline(int parent, int x, int y, int w, int h, int id) {
        #if WINDOWS
        int WS_CHILD = 1073741824;
        int WS_VISIBLE = 268435456;
        int WS_BORDER = 8388608;
        int WS_VSCROLL = 2097152;
        int ES_MULTILINE = 4;
        int ES_AUTOVSCROLL = 64;
        int WS_EX_CLIENTEDGE = 512;
        int style = WS_CHILD + WS_VISIBLE + WS_BORDER + WS_VSCROLL + ES_MULTILINE + ES_AUTOVSCROLL;
        nint hInstance = GetModuleHandleA("");
        nint hwnd = CreateWindowExA(WS_EX_CLIENTEDGE, "EDIT", "", style, x, y, w, h, parent, id, hInstance, 0);
        return hwnd;
        #else
        Window.NoHwnd("Forms.TextBox.CreateMultiline");
        return 0;
        #endif
    }

    static void SetText(int hwnd, string text) {
        #if WINDOWS
        SetWindowTextA(hwnd, text);
        #else
        Window.NoHwnd("Forms.TextBox.SetText");
        #endif
    }

    static string GetText(int hwnd) {
        #if WINDOWS
        int len = GetWindowTextLengthA(hwnd);
        byte[] buf = new byte[len + 2];
        int n = GetWindowTextA(hwnd, buf, len + 1);
        if (n < 0) { n = 0; }
        return buf.ToStr(0, n);
        #else
        Window.NoHwnd("Forms.TextBox.GetText");
        return "";
        #endif
    }
}

/// <summary>
/// 桌面提示框。Windows 用 MessageBoxA；Linux 用 zenity 或 kdialog；
/// macOS 用 osascript 的 display dialog。返回值沿用 Win32 的
/// IDOK=1 / IDCANCEL=2 / IDYES=6 / IDNO=7，因此三个平台的判断代码一致。
///
/// 提示文本与标题都通过临时文件/参数文件传给后端，不拼进 shell 命令，
/// 因此内容里的引号和 `$(...)` 不会被解释。
/// </summary>
class MessageBox {
    #if WINDOWS
    [DllImport("user32")]
    static extern int MessageBoxA(nint hwnd, string text, string caption, int flags);
    #endif

    /// IDOK。
    static int Ok() { return 1; }
    /// IDCANCEL。
    static int Cancel() { return 2; }
    /// IDYES。
    static int Yes() { return 6; }
    /// IDNO。
    static int No() { return 7; }

    /// <summary>只有"确定"的提示框；始终返回 IDOK。</summary>
    static int Show(string text, string caption) {
        #if WINDOWS
        return MessageBoxA(0, text, caption, 0);
        #else
        MessageBox.Posix(text, caption, 0);
        return MessageBox.Ok();
        #endif
    }

    /// <summary>是/否提示框；返回 IDYES 或 IDNO。</summary>
    static int ShowYesNo(string text, string caption) {
        #if WINDOWS
        return MessageBoxA(0, text, caption, 4);
        #else
        return MessageBox.Posix(text, caption, 1)
            ? MessageBox.Yes() : MessageBox.No();
        #endif
    }

    /// <summary>确定/取消提示框；返回 IDOK 或 IDCANCEL。</summary>
    static int ShowOkCancel(string text, string caption) {
        #if WINDOWS
        return MessageBoxA(0, text, caption, 1);
        #else
        return MessageBox.Posix(text, caption, 2)
            ? MessageBox.Ok() : MessageBox.Cancel();
        #endif
    }

    #if !WINDOWS
    /// kind: 0 = 只有确定，1 = 是/否，2 = 确定/取消。
    /// 返回用户是否选择了肯定按钮。
    static bool Posix(string text, string caption, int kind) {
        #if MACOS
        string buttons = "buttons {\"OK\"} default button 1";
        if (kind == 1) {
            buttons = "buttons {\"No\", \"Yes\"} default button 2";
        } else if (kind == 2) {
            buttons = "buttons {\"Cancel\", \"OK\"} default button 2";
        }
        string script = "display dialog \"" + MessageBox.OsaQuote(text)
            + "\" with title \"" + MessageBox.OsaQuote(caption) + "\" "
            + buttons;
        // osascript 在用户选否/取消时以非零退出（user canceled）
        return MessageBox.RunOsa(script) && kind != 0;
        #else
        // 文本走参数文件（zenity --text-info / kdialog --textbox 都读文件），
        // 这样文本内容永远不进命令行
        string tmp = Path.GetTempPath() + "zan_msg_"
            + Convert.ToString(ProcessHost.Pid()) + ".txt";
        File.WriteAllText(tmp, text);
        string cmd = "";
        if (MessageBox.Have("zenity")) {
            string mode = "--info";
            if (kind == 1) { mode = "--question"; }
            else if (kind == 2) { mode = "--question --ok-label=OK --cancel-label=Cancel"; }
            // 正文经 "$(cat file)" 传入：双引号内的命令替换结果不再被
            // 重新解析，因此文本里的元字符不会被执行
            cmd = "zenity " + mode + " --title='" + MessageBox.Sanitize(caption)
                + "' --text=\"$(cat '" + tmp + "')\"";
        } else if (MessageBox.Have("kdialog")) {
            string mode = "--msgbox";
            if (kind == 1) { mode = "--yesno"; }
            else if (kind == 2) { mode = "--warningcontinuecancel"; }
            cmd = "kdialog --title '" + MessageBox.Sanitize(caption) + "' "
                + mode + " \"$(cat '" + tmp + "')\"";
        } else if (MessageBox.Have("xmessage")) {
            string btns = kind == 0 ? "OK:0" : "Yes:0,No:1";
            if (kind == 2) { btns = "OK:0,Cancel:1"; }
            cmd = "xmessage -center -buttons '" + btns + "' -file '" + tmp + "'";
        } else {
            File.Delete(tmp);
            throw new PlatformNotSupportedException(
                "MessageBox needs a desktop dialog tool: install zenity, "
                + "kdialog or xmessage");
        }
        int rc = Process.Run(cmd + " >/dev/null 2>&1");
        File.Delete(tmp);
        return rc == 0;
        #endif
    }

    static bool Have(string tool) {
        return Process.Capture("command -v " + tool + " >/dev/null 2>&1").Ok();
    }

    /// 标题要进单引号命令行，因此去掉单引号（标题是短标签，
    /// 丢掉引号比冒被解释的风险好）。
    static string Sanitize(string s) {
        string outp = "";
        for (int i = 0; i < s.Length; i = i + 1) {
            string ch = s.Substring(i, 1);
            if (ch != "'") { outp = outp + ch; }
        }
        return outp;
    }

    static string OsaQuote(string s) {
        string outp = "";
        for (int i = 0; i < s.Length; i = i + 1) {
            string ch = s.Substring(i, 1);
            if (ch == "\\" || ch == "\"") { outp = outp + "\\"; }
            outp = outp + ch;
        }
        return outp;
    }

    static bool RunOsa(string script) {
        string tmp = Path.GetTempPath() + "zan_msg_"
            + Convert.ToString(ProcessHost.Pid()) + ".applescript";
        File.WriteAllText(tmp, script);
        int rc = Process.Run("osascript '" + tmp + "' >/dev/null 2>&1");
        File.Delete(tmp);
        return rc == 0;
    }
    #endif
}
