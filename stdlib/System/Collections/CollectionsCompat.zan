using System;
using System.Collections.Generic;

namespace System.Collections;

// 向后兼容转发：指向 System.Collections.Generic.HashSet{T}。
class HashSet<T> {
    System.Collections.Generic.HashSet<T> _inner;
    HashSet() { _inner = new System.Collections.Generic.HashSet<T>(); }
    bool Add(T item) { return _inner.Add(item); }
    bool Remove(T item) { return _inner.Remove(item); }
    bool Contains(T item) { return _inner.Contains(item); }
    void Clear() { _inner.Clear(); }
    int Count() { return _inner.Count(); }
    List<T> Keys() { return _inner.Keys(); }
    T ElementAt(int i) { return _inner.ElementAt(i); }
}

// 向后兼容转发：指向 System.Collections.Generic.Queue{T}。
class Queue<T> {
    System.Collections.Generic.Queue<T> _inner;
    Queue() { _inner = new System.Collections.Generic.Queue<T>(); }
    void Enqueue(T v) { _inner.Enqueue(v); }
    T Dequeue() { return _inner.Dequeue(); }
    T Peek() { return _inner.Peek(); }
    int Count() { return _inner.Count(); }
    bool IsEmpty() { return _inner.IsEmpty(); }
    void Clear() { _inner.Clear(); }
}

// 向后兼容转发：指向 System.Collections.Generic.Stack{T}。
class Stack<T> {
    System.Collections.Generic.Stack<T> _inner;
    Stack() { _inner = new System.Collections.Generic.Stack<T>(); }
    void Push(T v) { _inner.Push(v); }
    T Pop() { return _inner.Pop(); }
    T Peek() { return _inner.Peek(); }
    int Count() { return _inner.Count(); }
    bool IsEmpty() { return _inner.IsEmpty(); }
    void Clear() { _inner.Clear(); }
}
