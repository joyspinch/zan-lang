using System;
using System.Collections.Generic;

namespace System.Collections.ObjectModel;

// 泛型只读集合包装类。
// 将可变 List<T> 封装为只读视图，向外暴露 IReadOnlyList<T> 契约，
// 内部对原集合的修改仍会动态反映在只读视图中。
public class ReadOnlyCollection<T> : IReadOnlyList<T> {
    private List<T> list;

    // 用指定的内部列表初始化只读集合的新实例。
    public ReadOnlyCollection(List<T> list) {
        if (list == null) {
            throw new ArgumentNullException("list");
        }
        this.list = list;
    }

    // 获取只读集合中包含的元素数。
    public int Count() {
        return this.list.Count;
    }

    // 获取只读集合中指定索引处的元素。
    public T Get(int index) {
        return this.list[index];
    }

    // 确定某元素是否在只读集合中。
    public bool Contains(T item) {
        return this.list.Contains(item);
    }

    // 搜索指定的对象，并返回整个只读集合中第一个匹配项的索引。
    public int IndexOf(T item) {
        return this.list.IndexOf(item);
    }

    // 返回循环访问只读集合的枚举器。
    public IEnumerator<T> GetEnumerator() {
        return new ReadOnlyCollectionEnumerator<T>(this.list);
    }
}

class ReadOnlyCollectionEnumerator<T> : IEnumerator<T> {
    private List<T> list;
    private int idx;

    public ReadOnlyCollectionEnumerator(List<T> l) {
        this.list = l;
        this.idx = -1;
    }

    public bool MoveNext() {
        this.idx = this.idx + 1;
        return this.idx < this.list.Count;
    }

    public T Current() {
        return this.list[this.idx];
    }
}
