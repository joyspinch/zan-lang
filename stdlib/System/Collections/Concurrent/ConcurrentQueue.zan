using System;
using System.Collections.Generic;
using System.Threading;

namespace System.Collections.Concurrent;

// 线程安全的先进先出（FIFO）并发队列。
// 适用于多线程、协程与工作池之间的高吞吐数据安全流转。
public class ConcurrentQueue<T> : IDisposable {
    public Queue<T> inner;
    public nint mtx;

    public ConcurrentQueue() {
        this.inner = new Queue<T>();
        this.mtx = Mutex.Create();
    }


    public void Dispose() {
        if (this.mtx != 0) {
            Mutex.Destroy(this.mtx);
            this.mtx = 0;
        }
        if (this.inner != null) {
            this.inner.Clear();
            this.inner = null;
        }
    }

    // 将项追加到队尾。
    public void Enqueue(T item) {
        if (this.mtx == 0) { return; }
        Mutex.Lock(this.mtx);
        try {
            this.inner.Enqueue(item);
        } finally {
            Mutex.Unlock(this.mtx);
        }
    }

    // 尝试从队首移除并获取项。若队列为空则返回 false。
    public bool TryDequeue(out T result) {
        if (this.mtx == 0) {
            result = null;
            return false;
        }
        Mutex.Lock(this.mtx);
        try {
            if (this.inner.IsEmpty()) {
                result = null;
                return false;
            }
            result = this.inner.Dequeue();
            return true;
        } finally {
            Mutex.Unlock(this.mtx);
        }
    }

    // 尝试查看队首项但不移除。若队列为空则返回 false。
    public bool TryPeek(out T result) {
        if (this.mtx == 0) {
            result = null;
            return false;
        }
        Mutex.Lock(this.mtx);
        try {
            if (this.inner.IsEmpty()) {
                result = null;
                return false;
            }
            result = this.inner.Peek();
            return true;
        } finally {
            Mutex.Unlock(this.mtx);
        }
    }

    // 队列中的当前元素数量。
    public int Count() {
        if (this.mtx == 0) { return 0; }
        Mutex.Lock(this.mtx);
        try {
            return this.inner.Count();
        } finally {
            Mutex.Unlock(this.mtx);
        }
    }

    // 队列是否为空。
    public bool IsEmpty() {
        if (this.mtx == 0) { return true; }
        Mutex.Lock(this.mtx);
        try {
            return this.inner.IsEmpty();
        } finally {
            Mutex.Unlock(this.mtx);
        }
    }

    // 清空队列中所有元素。
    public void Clear() {
        if (this.mtx == 0) { return; }
        Mutex.Lock(this.mtx);
        try {
            this.inner.Clear();
        } finally {
            Mutex.Unlock(this.mtx);
        }
    }

    // 将队列当前快照复制为数组。
    public T[] ToArray() {
        if (this.mtx == 0) { return new T[0]; }
        Mutex.Lock(this.mtx);
        try {
            return this.inner.ToArray();
        } finally {
            Mutex.Unlock(this.mtx);
        }
    }
}
