using System;
using System.Collections.Generic;
using System.Threading;

namespace System.Collections.Concurrent;

// 线程安全的先进先出（FIFO）并发队列。
// 适用于多线程、协程与工作池之间的高吞吐数据安全流转。
class ConcurrentQueue<T> {
    Queue<T> inner;
    nint mtx;

    ConcurrentQueue() {
        this.inner = new Queue<T>();
        this.mtx = Mutex.Create();
    }

    ~ConcurrentQueue() {
        if (this.mtx != 0) {
            Mutex.Destroy(this.mtx);
            this.mtx = 0;
        }
    }

    // 将项追加到队尾。
    void Enqueue(T item) {
        Mutex.Lock(this.mtx);
        try {
            this.inner.Enqueue(item);
        } finally {
            Mutex.Unlock(this.mtx);
        }
    }

    // 尝试从队首移除并获取项。若队列为空则返回 false。
    bool TryDequeue(out T result) {
        Mutex.Lock(this.mtx);
        try {
            if (this.inner.IsEmpty()) {
                result = null;
                return false;
            }
            result = this.inner.Dequeue();
            return true;
        } finally {
            Mutex.Unlock(this.mtx);
        }
    }

    // 尝试查看队首项但不移除。若队列为空则返回 false。
    bool TryPeek(out T result) {
        Mutex.Lock(this.mtx);
        try {
            if (this.inner.IsEmpty()) {
                result = null;
                return false;
            }
            result = this.inner.Peek();
            return true;
        } finally {
            Mutex.Unlock(this.mtx);
        }
    }

    // 队列中的当前元素数量。
    int Count() {
        Mutex.Lock(this.mtx);
        try {
            return this.inner.Count();
        } finally {
            Mutex.Unlock(this.mtx);
        }
    }

    // 队列是否为空。
    bool IsEmpty() {
        Mutex.Lock(this.mtx);
        try {
            return this.inner.IsEmpty();
        } finally {
            Mutex.Unlock(this.mtx);
        }
    }

    // 清空队列中所有元素。
    void Clear() {
        Mutex.Lock(this.mtx);
        try {
            this.inner.Clear();
        } finally {
            Mutex.Unlock(this.mtx);
        }
    }

    // 将队列当前快照复制为数组。
    T[] ToArray() {
        Mutex.Lock(this.mtx);
        try {
            int n = this.inner.Count();
            T[] arr = new T[n];
            // 复制元素
            Queue<T> copy = new Queue<T>();
            int idx = 0;
            while (!this.inner.IsEmpty()) {
                T item = this.inner.Dequeue();
                arr[idx] = item;
                idx = idx + 1;
                copy.Enqueue(item);
            }
            this.inner = copy;
            return arr;
        } finally {
            Mutex.Unlock(this.mtx);
        }
    }
}
