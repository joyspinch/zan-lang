using System;
using System.Collections.Generic;
using System.Threading;

namespace System.Collections.Concurrent;

// 线程安全的先进先出（FIFO）并发队列。
// 适用于多线程、协程与工作池之间的高吞吐数据安全流转。
// 可直接 foreach：枚举的是 GetEnumerator 时刻的快照（与 .NET 一致），
// 迭代期间其他线程的入队/出队不影响本次迭代，也不会抛异常。
public class ConcurrentQueue<T> : IDisposable, IEnumerable<T> {
    public Queue<T> inner;
    public nint mtx;
    private bool disposed;

    public ConcurrentQueue() {
        this.inner = new Queue<T>();
        this.mtx = 0;
        this.disposed = false;
    }


    public void Dispose() {
        lock (this) {
            if (this.disposed) { return; }
            this.disposed = true;
            if (this.inner != null) {
                this.inner.Clear();
                this.inner = null;
            }
        }
    }

    // 将项追加到队尾。
    public void Enqueue(T item) {
        lock (this) {
            if (this.disposed || this.inner == null) { return; }
            this.inner.Enqueue(item);
        }
    }

    // 尝试从队首移除并获取项。若队列为空则返回 false。
    public bool TryDequeue(out T result) {
        lock (this) {
            if (this.disposed || this.inner == null || this.inner.IsEmpty()) {
                result = null;
                return false;
            }
            result = this.inner.Dequeue();
            return true;
        }
    }

    // 尝试查看队首项但不移除。若队列为空则返回 false。
    public bool TryPeek(out T result) {
        lock (this) {
            if (this.disposed || this.inner == null || this.inner.IsEmpty()) {
                result = null;
                return false;
            }
            result = this.inner.Peek();
            return true;
        }
    }

    // 队列中的当前元素数量。
    public int Count() {
        lock (this) {
            if (this.disposed || this.inner == null) { return 0; }
            return this.inner.Count();
        }
    }

    // 队列是否为空。
    public bool IsEmpty() {
        lock (this) {
            if (this.disposed || this.inner == null) { return true; }
            return this.inner.IsEmpty();
        }
    }

    // 清空队列中所有元素。
    public void Clear() {
        lock (this) {
            if (this.disposed || this.inner == null) { return; }
            this.inner.Clear();
        }
    }

    // 将队列当前快照复制为数组。
    public T[] ToArray() {
        lock (this) {
            if (this.disposed || this.inner == null) { return new T[0]; }
            return this.inner.ToArray();
        }
    }

    // 创建一个遍历当前快照的枚举器（锁内复制一次，foreach 降级入口）。
    public IEnumerator<T> GetEnumerator() {
        return new ArrayEnumerator<T>(this.ToArray());
    }
}
