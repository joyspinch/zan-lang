using System;
using System.Collections.Generic;
using System.Threading;

namespace System.Collections.Concurrent;

// 分段锁条带节点，封装单个字典分片与其互斥锁。
public class ConcurrentStripe<TKey, TValue> : IDisposable {
    public nint mtx;
    public Dict<TKey, TValue> map;

    public ConcurrentStripe() {
        this.mtx = Mutex.Create();
        this.map = new Dict<TKey, TValue>();
    }


    public void Dispose() {
        if (this.mtx != 0) {
            Mutex.Destroy(this.mtx);
            this.mtx = 0;
        }
        if (this.map != null) {
            this.map.Clear();
            this.map = null;
        }
    }

    public void Lock() {
        if (this.mtx != 0) {
            Mutex.Lock(this.mtx);
        }
    }

    public void Unlock() {
        if (this.mtx != 0) {
            Mutex.Unlock(this.mtx);
        }
    }

    public Dict<TKey, TValue> Map {
        get { return this.map; }
    }
}
