using System;
using System.Collections.Generic;
using System.Threading;

namespace System.Collections.Concurrent;

// 分段锁条带节点，封装单个字典分片与其互斥锁。
public class ConcurrentStripe<TKey, TValue> : IDisposable {
    public nint mtx;
    public Dict<TKey, TValue> map;
    public bool disposed;

    public ConcurrentStripe() {
        this.mtx = Mutex.Create();
        this.map = new Dict<TKey, TValue>();
        this.disposed = false;
    }


    public void Dispose() {
        nint m = 0;
        lock (this) {
            if (this.disposed) { return; }
            this.disposed = true;
            m = this.mtx;
        }
        if (m != 0) {
            Mutex.Lock(m);
            if (this.map != null) {
                this.map.Clear();
                this.map = null;
            }
            this.mtx = 0;
            Mutex.Unlock(m);
            Mutex.Destroy(m);
        } else if (this.map != null) {
            this.map.Clear();
            this.map = null;
        }
    }

    public void Lock() {
        nint m = this.mtx;
        if (m == 0 || this.disposed) {
            throw new ObjectDisposedException("ConcurrentStripe");
        }
        Mutex.Lock(m);
        if (this.disposed || this.map == null) {
            Mutex.Unlock(m);
            throw new ObjectDisposedException("ConcurrentStripe");
        }
    }

    public void Unlock() {
        nint m = this.mtx;
        if (m != 0) {
            Mutex.Unlock(m);
        }
    }

    public Dict<TKey, TValue> Map {
        get { return this.map; }
    }
}
