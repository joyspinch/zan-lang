using System;
using System.Collections.Generic;
using System.Threading;

namespace System.Collections.Concurrent;

// 分段锁条带节点，封装单个字典分片与其互斥锁。
class ConcurrentStripe<TKey, TValue> {
    nint mtx;
    Dict<TKey, TValue> map;

    ConcurrentStripe() {
        this.mtx = Mutex.Create();
        this.map = new Dict<TKey, TValue>();
    }

    ~ConcurrentStripe() {
        if (this.mtx != 0) {
            Mutex.Destroy(this.mtx);
            this.mtx = 0;
        }
    }

    void Lock() { Mutex.Lock(this.mtx); }
    void Unlock() { Mutex.Unlock(this.mtx); }
    Dict<TKey, TValue> Map { get { return this.map; } }
}
