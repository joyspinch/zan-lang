using System;
using System.Collections.Generic;
using System.Threading;

namespace System.Collections.Concurrent;

// 工业级分段锁并发字典（Striped-Lock ConcurrentDictionary）。
// 通过多分片锁（Lock Striping）隔离并发热点，读写操作按键哈希仅锁对应条带，
// 极大降低多线程高并发下的锁竞争与上下文切换开销。
public class ConcurrentDictionary<TKey, TValue> : IDisposable {
    public ConcurrentStripe<TKey, TValue>[] stripes;
    public int stripeCount;
    private int stripeMask;
    private bool disposed;

    private static int NextPow2(int n) {
        if (n <= 1) { return 1; }
        if (n >= 256) { return 256; }
        int p = 1;
        while (p < n) { p = p << 1; }
        return p;
    }

    public ConcurrentDictionary() : this(16) {}

    public ConcurrentDictionary(int concurrencyLevel) {
        int n = ConcurrentDictionary<TKey, TValue>.NextPow2(concurrencyLevel);
        this.stripeCount = n;
        this.stripeMask = n - 1;
        this.disposed = false;
        this.stripes = new ConcurrentStripe<TKey, TValue>[n];
        for (int i = 0; i < n; i = i + 1) {
            this.stripes[i] = new ConcurrentStripe<TKey, TValue>();
        }
    }


    public void Dispose() {
        ConcurrentStripe<TKey, TValue>[] s = null;
        lock (this) {
            if (this.disposed || this.stripes == null) { return; }
            this.disposed = true;
            s = this.stripes;
            this.stripes = null;
        }
        for (int i = 0; i < s.Length; i = i + 1) {
            if (s[i] != null) {
                s[i].Dispose();
                s[i] = null;
            }
        }
    }

    // 根据键计算所属条带序号（零分配 GetHashCode + 高低位混排 + 2 的幂位掩码）
    public int GetStripeIndex(TKey key) {
        int h = key.GetHashCode();
        return (h ^ (h >> 16)) & this.stripeMask;
    }

    private ConcurrentStripe<TKey, TValue>[] SnapshotStripes() {
        ConcurrentStripe<TKey, TValue>[] s = this.stripes;
        if (this.disposed || s == null) {
            throw new ObjectDisposedException("ConcurrentDictionary");
        }
        return s;
    }

    private ConcurrentStripe<TKey, TValue> RequireStripe(TKey key) {
        ConcurrentStripe<TKey, TValue>[] s = this.SnapshotStripes();
        ConcurrentStripe<TKey, TValue> stripe = s[this.GetStripeIndex(key)];
        if (stripe == null) {
            throw new ObjectDisposedException("ConcurrentDictionary");
        }
        return stripe;
    }

    private void LockStripes(ConcurrentStripe<TKey, TValue>[] s) {
        int locked = 0;
        try {
            for (int i = 0; i < s.Length; i = i + 1) {
                ConcurrentStripe<TKey, TValue> st = s[i];
                if (st == null) {
                    throw new ObjectDisposedException("ConcurrentDictionary");
                }
                st.Lock();
                locked = i + 1;
            }
        } catch (Exception ex) {
            for (int j = locked - 1; j >= 0; j = j - 1) {
                s[j].Unlock();
            }
            throw ex;
        }
    }

    private void UnlockStripes(ConcurrentStripe<TKey, TValue>[] s) {
        for (int i = s.Length - 1; i >= 0; i = i - 1) {
            if (s[i] != null) {
                s[i].Unlock();
            }
        }
    }

    // 尝试添加键值对。若键已存在则返回 false，不覆盖旧值。
    public bool TryAdd(TKey key, TValue value) {
        ConcurrentStripe<TKey, TValue> stripe = this.RequireStripe(key);
        stripe.Lock();
        try {
            if (this.disposed || stripe.map == null) {
                throw new ObjectDisposedException("ConcurrentDictionary");
            }
            if (!stripe.map.ContainsKey(key)) {
                stripe.map[key] = value;
                return true;
            }
            return false;
        } finally {
            stripe.Unlock();
        }
    }

    // 尝试获取指定键对应的值。
    public bool TryGetValue(TKey key, out TValue value) {
        ConcurrentStripe<TKey, TValue> stripe = this.RequireStripe(key);
        stripe.Lock();
        try {
            if (this.disposed || stripe.map == null) {
                throw new ObjectDisposedException("ConcurrentDictionary");
            }
            return stripe.map.TryGetValue(key, out value);
        } finally {
            stripe.Unlock();
        }
    }

    // 尝试移除指定键并输出旧值。
    public bool TryRemove(TKey key, out TValue value) {
        ConcurrentStripe<TKey, TValue> stripe = this.RequireStripe(key);
        stripe.Lock();
        try {
            if (this.disposed || stripe.map == null) {
                throw new ObjectDisposedException("ConcurrentDictionary");
            }
            bool ok = stripe.map.TryGetValue(key, out value);
            if (ok) {
                stripe.map.Remove(key);
            }
            return ok;
        } finally {
            stripe.Unlock();
        }
    }

    // 判断是否包含指定键。
    public bool ContainsKey(TKey key) {
        ConcurrentStripe<TKey, TValue> stripe = this.RequireStripe(key);
        stripe.Lock();
        try {
            if (this.disposed || stripe.map == null) {
                throw new ObjectDisposedException("ConcurrentDictionary");
            }
            return stripe.map.ContainsKey(key);
        } finally {
            stripe.Unlock();
        }
    }

    // 若键不存在则插入，最终返回现有或新插入的值。
    public TValue GetOrAdd(TKey key, TValue value) {
        ConcurrentStripe<TKey, TValue> stripe = this.RequireStripe(key);
        stripe.Lock();
        try {
            if (this.disposed || stripe.map == null) {
                throw new ObjectDisposedException("ConcurrentDictionary");
            }
            TValue existing;
            if (stripe.map.TryGetValue(key, out existing)) {
                return existing;
            }
            stripe.map[key] = value;
            return value;
        } finally {
            stripe.Unlock();
        }
    }

    // 索引用法支持：读取或更新键值
    public TValue this[TKey key] {
        get {
            TValue v;
            if (this.TryGetValue(key, out v)) {
                return v;
            }
            throw new Exception("The given key was not present in the dictionary.");
        }
        set {
            ConcurrentStripe<TKey, TValue> stripe = this.RequireStripe(key);
            stripe.Lock();
            try {
                if (this.disposed || stripe.map == null) {
                    throw new ObjectDisposedException("ConcurrentDictionary");
                }
                stripe.map[key] = value;
            } finally {
                stripe.Unlock();
            }
        }
    }

    // 按顺序获取所有条带锁（防止死锁）
    public void LockAll() {
        ConcurrentStripe<TKey, TValue>[] s = this.SnapshotStripes();
        this.LockStripes(s);
    }

    // 逆序释放所有条带锁
    public void UnlockAll() {
        ConcurrentStripe<TKey, TValue>[] s = this.stripes;
        if (s == null) { return; }
        this.UnlockStripes(s);
    }

    // 清空字典中的所有项。
    public void Clear() {
        ConcurrentStripe<TKey, TValue>[] s = this.SnapshotStripes();
        this.LockStripes(s);
        try {
            for (int i = 0; i < s.Length; i = i + 1) {
                if (s[i].map != null) {
                    s[i].map.Clear();
                }
            }
        } finally {
            this.UnlockStripes(s);
        }
    }

    // 当前存储的总项数。
    public int Count() {
        ConcurrentStripe<TKey, TValue>[] s = this.SnapshotStripes();
        this.LockStripes(s);
        try {
            int total = 0;
            for (int i = 0; i < s.Length; i = i + 1) {
                if (s[i].map != null) {
                    total = total + s[i].map.Count;
                }
            }
            return total;
        } finally {
            this.UnlockStripes(s);
        }
    }

    // 字典是否为空（遇到非空条带立即提前返回）。
    public bool IsEmpty() {
        ConcurrentStripe<TKey, TValue>[] s = this.SnapshotStripes();
        this.LockStripes(s);
        try {
            for (int i = 0; i < s.Length; i = i + 1) {
                if (s[i].map != null && s[i].map.Count > 0) {
                    return false;
                }
            }
            return true;
        } finally {
            this.UnlockStripes(s);
        }
    }

    // 获取所有键的列表快照。
    public List<TKey> Keys() {
        ConcurrentStripe<TKey, TValue>[] s = this.SnapshotStripes();
        this.LockStripes(s);
        try {
            int total = 0;
            for (int i = 0; i < s.Length; i = i + 1) {
                if (s[i].map != null) {
                    total = total + s[i].map.Count;
                }
            }
            List<TKey> list = new List<TKey>();
            list.Reserve(total);
            for (int i = 0; i < s.Length; i = i + 1) {
                if (s[i].map == null || s[i].map.Count == 0) { continue; }
                List<TKey> klist = s[i].map.Keys;
                int count = klist.Count;
                for (int j = 0; j < count; j = j + 1) {
                    list.Add(klist[j]);
                }
            }
            return list;
        } finally {
            this.UnlockStripes(s);
        }
    }

    // 获取所有值的列表快照。
    public List<TValue> Values() {
        ConcurrentStripe<TKey, TValue>[] s = this.SnapshotStripes();
        this.LockStripes(s);
        try {
            int total = 0;
            for (int i = 0; i < s.Length; i = i + 1) {
                if (s[i].map != null) {
                    total = total + s[i].map.Count;
                }
            }
            List<TValue> list = new List<TValue>();
            list.Reserve(total);
            for (int i = 0; i < s.Length; i = i + 1) {
                if (s[i].map == null || s[i].map.Count == 0) { continue; }
                List<TValue> vlist = s[i].map.Values;
                int count = vlist.Count;
                for (int j = 0; j < count; j = j + 1) {
                    list.Add(vlist[j]);
                }
            }
            return list;
        } finally {
            this.UnlockStripes(s);
        }
    }
}
