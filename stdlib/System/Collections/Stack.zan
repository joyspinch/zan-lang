using System;

namespace System.Collections;

/// <summary>
/// 后进先出（LIFO）集合。由动态 <c>List</c> 实现，
/// <see cref="Push"/> 和 <see cref="Pop"/> 均摊 O(1)。适用于值
/// 类型（int、double、bool）及引用类型。
///
/// <see cref="Pop"/> 与 <see cref="Peek"/> 要求栈非空；请
/// 先用 <see cref="IsEmpty"/> 或 <see cref="Count"/> 判断。
/// </summary>
class Stack<T> {
    List<T> items;

    Stack() { items = new List<T>(); }

    /// <summary>将项压入栈顶。</summary>
    void Push(T v) { items.Add(v); }

    /// <summary>移除并返回栈顶项。</summary>
    T Pop() {
        int i = items.Count - 1;
        T v = items[i];
        items.RemoveAt(i);
        return v;
    }

    /// <summary>返回栈顶项但不移除。</summary>
    T Peek() { return items[items.Count - 1]; }

    /// <summary>栈中的项数。</summary>
    int Count() { return items.Count; }

    /// <summary>栈是否为空。</summary>
    bool IsEmpty() { return items.Count == 0; }

    /// <summary>清空所有项。</summary>
    void Clear() { items.Clear(); }

    /// <summary>
    /// 栈中是否包含 <paramref name="v"/>。值类型按值比较，
    /// 引用类型（含 string）按身份比较——参见
    /// <c>HashSet</c> 中的说明。
    /// </summary>
    bool Contains(T v) { return items.Contains(v); }
}
