using System;

namespace System.Collections;

/// <summary><see cref="LinkedList{T}"/> 中的节点，暴露其相邻节点。</summary>
class LinkedListNode<T> {
    T item;
    LinkedListNode<T> prev;
    LinkedListNode<T> next;

    LinkedListNode(T v) { item = v; prev = null; next = null; }

    /// <summary>此节点存储的值。</summary>
    T Value() { return item; }

    /// <summary>下一个节点，尾部为 null。</summary>
    LinkedListNode<T> Next() { return next; }

    /// <summary>上一个节点，头部为 null。</summary>
    LinkedListNode<T> Prev() { return prev; }
}

/// <summary>
/// 双向链表。两端插入和删除均为 O(1)。适用于
/// 值类型（int、double、bool）及引用类型。可用
/// <see cref="Head"/> 与 <see cref="LinkedListNode{T}.Next"/> 遍历。
///
/// 末端访问器（<see cref="First"/>、<see cref="Last"/>、
/// <see cref="RemoveFirst"/>、<see cref="RemoveLast"/>）要求列表非空，
/// 请先用 <see cref="IsEmpty"/> 或 <see cref="Count"/> 判断。
/// </summary>
class LinkedList<T> {
    LinkedListNode<T> head;
    LinkedListNode<T> tail;
    int count;

    LinkedList() { head = null; tail = null; count = 0; }

    /// <summary>在尾部追加项。O(1)。</summary>
    void AddLast(T v) {
        LinkedListNode<T> n = new LinkedListNode<T>(v);
        if (tail == null) { head = n; tail = n; }
        else { n.prev = tail; tail.next = n; tail = n; }
        count = count + 1;
    }

    /// <summary>在头部插入项。O(1)。</summary>
    void AddFirst(T v) {
        LinkedListNode<T> n = new LinkedListNode<T>(v);
        if (head == null) { head = n; tail = n; }
        else { n.next = head; head.prev = n; head = n; }
        count = count + 1;
    }

    /// <summary>移除并返回头部项。O(1)。</summary>
    T RemoveFirst() {
        T v = head.item;
        head = head.next;
        if (head == null) { tail = null; } else { head.prev = null; }
        count = count - 1;
        return v;
    }

    /// <summary>移除并返回尾部项。O(1)。</summary>
    T RemoveLast() {
        T v = tail.item;
        tail = tail.prev;
        if (tail == null) { head = null; } else { tail.next = null; }
        count = count - 1;
        return v;
    }

    /// <summary>返回头部项但不移除。</summary>
    T First() { return head.item; }

    /// <summary>返回尾部项但不移除。</summary>
    T Last() { return tail.item; }

    /// <summary>头部节点（为空时返回 null），用于遍历。</summary>
    LinkedListNode<T> Head() { return head; }

    /// <summary>尾部节点（为空时返回 null），用于遍历。</summary>
    LinkedListNode<T> Tail() { return tail; }

    /// <summary>项的数量。</summary>
    int Count() { return count; }

    /// <summary>列表是否为空。</summary>
    bool IsEmpty() { return count == 0; }

    /// <summary>清空所有项。</summary>
    void Clear() { head = null; tail = null; count = 0; }
}
