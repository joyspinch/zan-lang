using System;

namespace System.Collections.Generic;

// 键/值对（Key / Value 属性，KVP(K, V) 为简写），用于字典条目迭代与键值序列。
public class KeyValuePair<K, V> {
    public K Key;
    public V Value;

    public KeyValuePair() {}

    // 用一个键和一个值构造键值对。
    public KeyValuePair(K key, V value) {
        Key = key;
        Value = value;
    }

    public K GetKey() { return Key; }
    public V GetValue() { return Value; }
}
