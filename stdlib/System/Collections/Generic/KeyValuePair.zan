using System;

namespace System.Collections.Generic;

/// <summary>
/// 一个键/值对，C# 的 <c>KeyValuePair&lt;K, V&gt;</c> 等价物：结构体，只读
/// <c>Key</c> / <c>Value</c> 属性，构造函数一次性赋值。用于字典条目迭代
/// 与通用键值序列（<c>KVP(K, V)</c> 是其简写）。
///
///   KeyValuePair&lt;string, int&gt; kv = new KeyValuePair&lt;string, int&gt;("a", 1);
///   Console.WriteLine(kv.Key);   // a
///   Console.WriteLine(kv.Value); // 1
/// </summary>
struct KeyValuePair<K, V> {
    private K _key;
    private V _value;

    /// <summary>用一个键和一个值构造键值对。</summary>
    public KeyValuePair(K key, V value) {
        _key = key;
        _value = value;
    }

    /// <summary>键。</summary>
    public K Key { get { return _key; } }

    /// <summary>值。</summary>
    public V Value { get { return _value; } }
}

/// <summary>
/// <c>KeyValuePair</c> 的简写别名：<c>KVP(K, V)</c> 与
/// <c>KeyValuePair&lt;K, V&gt;</c> 是同一个结构体。
/// </summary>
struct KVP<K, V> {
    private K _key;
    private V _value;

    /// <summary>用一个键和一个值构造键值对。</summary>
    public KVP(K key, V value) {
        _key = key;
        _value = value;
    }

    /// <summary>键。</summary>
    public K Key { get { return _key; } }

    /// <summary>值。</summary>
    public V Value { get { return _value; } }
}
