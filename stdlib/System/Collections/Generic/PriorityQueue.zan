using System;

namespace System.Collections.Generic;

// 优先队列（最小堆实现）。
// 对应 modern .NET / Java / Go 中的标准优先级队列。
// 内部使用基于数组/动态列表的双向二叉堆维护元素与优先级，
// Enqueue 与 Dequeue 均为 O(log N)，Peek 为 O(1)。
public class PriorityQueue<TElement, TPriority> {
    public List<TElement> elements;
    public List<TPriority> priorities;

    public PriorityQueue() {
        this.elements = new List<TElement>();
        this.priorities = new List<TPriority>();
    }

    public PriorityQueue(int initialCapacity) {
        this.elements = new List<TElement>();
        this.priorities = new List<TPriority>();
        if (initialCapacity > 0) {
            this.elements.Reserve(initialCapacity);
            this.priorities.Reserve(initialCapacity);
        }
    }

    // 将具有指定优先级的项压入队列中。O(log N)。
    public void Enqueue(TElement element, TPriority priority) {
        this.elements.Add(element);
        this.priorities.Add(priority);
        this.SiftUp(this.elements.Count - 1);
    }

    // 移除并返回具有最低优先级值（最高优先权）的元素。O(log N)。
    public TElement Dequeue() {
        if (this.elements.Count == 0) {
            throw new InvalidOperationException("PriorityQueue is empty");
        }
        TElement res = this.elements[0];
        int last = this.elements.Count - 1;
        this.elements[0] = this.elements[last];
        this.priorities[0] = this.priorities[last];
        this.elements.RemoveAt(last);
        this.priorities.RemoveAt(last);
        if (this.elements.Count > 0) {
            this.SiftDown(0);
        }
        return res;
    }

    // 尝试移除并返回具有最低优先级值的元素与其优先级。若队列为空返回 false。
    public bool TryDequeue(out TElement element, out TPriority priority) {
        if (this.elements.Count == 0) {
            element = null;
            priority = null;
            return false;
        }
        element = this.elements[0];
        priority = this.priorities[0];
        int last = this.elements.Count - 1;
        this.elements[0] = this.elements[last];
        this.priorities[0] = this.priorities[last];
        this.elements.RemoveAt(last);
        this.priorities.RemoveAt(last);
        if (this.elements.Count > 0) {
            this.SiftDown(0);
        }
        return true;
    }

    // 返回具有最低优先级值的元素但不移除。O(1)。
    public TElement Peek() {
        if (this.elements.Count == 0) {
            throw new InvalidOperationException("PriorityQueue is empty");
        }
        return this.elements[0];
    }

    // 尝试返回具有最低优先级值的元素与其优先级但不移除。若队列为空返回 false。
    public bool TryPeek(out TElement element, out TPriority priority) {
        if (this.elements.Count == 0) {
            element = null;
            priority = null;
            return false;
        }
        element = this.elements[0];
        priority = this.priorities[0];
        return true;
    }

    // 队列中元素的数量。
    public int Count() {
        return this.elements.Count;
    }

    // 队列是否为空。
    public bool IsEmpty() {
        return this.elements.Count == 0;
    }

    // 清空队列中的所有元素与优先级。
    public void Clear() {
        this.elements.Clear();
        this.priorities.Clear();
    }

    private void SiftUp(int i) {
        while (i > 0) {
            int p = (i - 1) / 2;
            if (this.priorities[i] < this.priorities[p]) {
                this.Swap(i, p);
                i = p;
            } else {
                break;
            }
        }
    }

    private void SiftDown(int i) {
        int n = this.elements.Count;
        while (2 * i + 1 < n) {
            int left = 2 * i + 1;
            int right = 2 * i + 2;
            int smallest = left;
            if (right < n && this.priorities[right] < this.priorities[left]) {
                smallest = right;
            }
            if (this.priorities[smallest] < this.priorities[i]) {
                this.Swap(i, smallest);
                i = smallest;
            } else {
                break;
            }
        }
    }

    private void Swap(int i, int j) {
        TElement e = this.elements[i];
        this.elements[i] = this.elements[j];
        this.elements[j] = e;

        TPriority p = this.priorities[i];
        this.priorities[i] = this.priorities[j];
        this.priorities[j] = p;
    }
}
