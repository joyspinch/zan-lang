using System;

namespace System.Collections.Generic;

// 唯一项的集合：成员判定走 Dict<T, int> 的开地址哈希表
// （摊还 O(1)），插入顺序用并行表保留（Remove 打墓碑，墓碑过半时
// 一次性压缩，摊还仍 O(1)）。ElementAt 按插入次序
// 枚举有效项。
// 相等性沿用 Dict 的键规则：
// 1. 值类型（int、long、double、bool、enum）按值比较；
// 2. string 按内容比较（Dict 的内建哈希/比较即内容感知）；
// 3. 其他引用类型按身份（同一实例）比较。
public class HashSet<T> {
    public Dict<T, int> idx;
    public List<T> order;
    public List<bool> dead;
    public int live;

    public HashSet() {
        this.idx = new Dict<T, int>();
        this.order = new List<T>();
        this.dead = new List<bool>();
        this.live = 0;
    }

    // 若尚不存在则添加该项；已添加返回 true，
    // 若已有相等项则返回 false。
    public bool Add(T v) {
        if (this.idx.ContainsKey(v)) { return false; }
        this.order.Add(v);
        this.dead.Add(false);
        this.idx.Add(v, this.order.Count - 1);
        this.live = this.live + 1;
        return true;
    }

    // 是否存在相等的项。
    public bool Contains(T v) {
        return this.idx.ContainsKey(v);
    }

    // 移除相等的项（若存在），返回是否实际移除。
    // 只打墓碑；墓碑超过一半时整体压缩一次。
    public bool Remove(T v) {
        if (!this.idx.ContainsKey(v)) { return false; }
        int i = this.idx[v];
        this.idx.Remove(v);
        this.dead[i] = true;
        this.live = this.live - 1;
        if (this.live * 2 < this.order.Count) {
            this.Compact();
        }
        return true;
    }

    // 丢弃墓碑，重建 order 与 idx（均摊 O(1)/次操作）。
    public void Compact() {
        List<T> no = new List<T>();
        no.Reserve(this.live);
        List<bool> nd = new List<bool>();
        nd.Reserve(this.live);
        Dict<T, int> ni = new Dict<T, int>();
        for (int i = 0; i < this.order.Count; i = i + 1) {
            if (this.dead[i]) { continue; }
            no.Add(this.order[i]);
            nd.Add(false);
            ni.Add(this.order[i], no.Count - 1);
        }
        this.order = no;
        this.dead = nd;
        this.idx = ni;
    }

    // 不同项的数量。
    public int Count() {
        return this.live;
    }

    // 集合是否为空。
    public bool IsEmpty() {
        return this.live == 0;
    }

    // 清空所有项（原地复用底层连续分配容量，零堆垃圾开销）。
    public void Clear() {
        this.idx.Clear();
        this.order.Clear();
        this.dead.Clear();
        this.live = 0;
    }

    // 全部有效项的快照（按插入次序）。修改快照不影响集合本身。
    public List<T> Keys() {
        return this.ToList();
    }

    // 全部有效项的列表快照（按插入次序）。
    public List<T> ToList() {
        List<T> outList = new List<T>();
        if (this.live > 0) {
            outList.Reserve(this.live);
        }
        for (int i = 0; i < this.order.Count; i = i + 1) {
            if (!this.dead[i]) {
                outList.Add(this.order[i]);
            }
        }
        return outList;
    }

    // 全部有效项的数组快照（按插入次序）。
    public T[] ToArray() {
        T[] arr = new T[this.live];
        int idx = 0;
        for (int i = 0; i < this.order.Count; i = i + 1) {
            if (!this.dead[i] && idx < this.live) {
                arr[idx] = this.order[i];
                idx = idx + 1;
            }
        }
        return arr;
    }

    // 第 i 个有效项（从 0 开始，按插入次序，
    // 跳过已移除的墓碑）；越界抛 InvalidOperationException。
    public T ElementAt(int i) {
        if (i < 0 || i >= this.live) {
            throw new InvalidOperationException("HashSet.ElementAt index out of range");
        }
        int seen = 0;
        for (int k = 0; k < this.order.Count; k = k + 1) {
            if (this.dead[k]) { continue; }
            if (seen == i) { return this.order[k]; }
            seen = seen + 1;
        }
        throw new InvalidOperationException("HashSet.ElementAt index out of range");
    }
}
