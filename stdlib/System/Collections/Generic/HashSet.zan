using System;

namespace System.Collections.Generic;

// 唯一项的集合：成员判定走 Dict<T, int> 的开地址哈希表
// （摊还 O(1)），插入顺序用并行表保留（Remove 打墓碑，墓碑过半时
// 一次性压缩，摊还仍 O(1)）。ElementAt 按插入次序
// 枚举有效项。
// 相等性沿用 Dict 的键规则：
// 1. 值类型（int、long、double、bool、enum）按值比较；
// 2. string 按内容比较（Dict 的内建哈希/比较即内容感知）；
// 3. 其他引用类型按身份（同一实例）比较。
// 可直接 foreach（按插入次序，跳过已移除项）；迭代期间修改集合时，下一次 MoveNext 抛 InvalidOperationException。
public class HashSet<T> : IEnumerable<T> {
    public Dict<T, int> idx;
    public List<T> order;
    public List<bool> dead;
    public int live;
    public int version;

    public HashSet() {
        this.idx = new Dict<T, int>();
        this.order = new List<T>();
        this.dead = new List<bool>();
        this.live = 0;
        this.version = 0;
    }

    // 若尚不存在则添加该项；已添加返回 true，
    // 若已有相等项则返回 false。
    public bool Add(T v) {
        int i = 0;
        if (this.idx.TryGetValue(v, out i)) {
            if (i >= 0) { return false; }
            this.order.Add(v);
            this.dead.Add(false);
            this.idx[v] = this.order.Count - 1;
            this.live = this.live + 1;
            this.version = this.version + 1;
            return true;
        }
        this.order.Add(v);
        this.dead.Add(false);
        this.idx.Add(v, this.order.Count - 1);
        this.live = this.live + 1;
        this.version = this.version + 1;
        return true;
    }

    // 是否存在相等的项。
    public bool Contains(T v) {
        int i = 0;
        return this.idx.TryGetValue(v, out i) && i >= 0;
    }

    // 移除相等的项（若存在），返回是否实际移除。
    // 在 idx 置 -1 墓碑（O(1) 避免 Dict.Remove 的 O(N) 移位）；
    // 墓碑超过一半时整体压缩一次（均摊 O(1)）。
    public bool Remove(T v) {
        int i = 0;
        if (!this.idx.TryGetValue(v, out i) || i < 0) { return false; }
        this.idx[v] = -1;
        this.dead[i] = true;
        this.live = this.live - 1;
        this.version = this.version + 1;
        if (this.live * 2 < this.order.Count) {
            this.Compact();
        }
        return true;
    }

    // 丢弃墓碑，重建 order 与 idx（均摊 O(1)/次操作）。
    public void Compact() {
        List<T> oldOrder = this.order;
        List<bool> oldDead = this.dead;
        int n = oldOrder.Count;
        List<T> no = new List<T>();
        no.Reserve(this.live);
        List<bool> nd = new List<bool>();
        nd.Reserve(this.live);
        Dict<T, int> ni = new Dict<T, int>();
        for (int i = 0; i < n; i = i + 1) {
            if (oldDead[i]) { continue; }
            T item = oldOrder[i];
            int pos = no.Count;
            no.Add(item);
            nd.Add(false);
            ni.Add(item, pos);
        }
        this.order = no;
        this.dead = nd;
        this.idx = ni;
        this.version = this.version + 1;
    }

    // 不同项的数量。
    public int Count() {
        return this.live;
    }

    // 集合是否为空。
    public bool IsEmpty() {
        return this.live == 0;
    }

    // 清空所有项（原地复用底层连续分配容量，零堆垃圾开销）。
    public void Clear() {
        this.idx.Clear();
        this.order.Clear();
        this.dead.Clear();
        this.live = 0;
        this.version = this.version + 1;
    }

    // 全部有效项的快照（按插入次序）。修改快照不影响集合本身。
    public List<T> Keys() {
        return this.ToList();
    }

    // 全部有效项的列表快照（按插入次序）。
    public List<T> ToList() {
        List<T> outList = new List<T>();
        int liveCnt = this.live;
        if (liveCnt <= 0) { return outList; }
        outList.Reserve(liveCnt);
        List<T> ord = this.order;
        int n = ord.Count;
        if (liveCnt == n) {
            for (int i = 0; i < n; i = i + 1) { outList.Add(ord[i]); }
            return outList;
        }
        List<bool> d = this.dead;
        for (int i = 0; i < n; i = i + 1) {
            if (!d[i]) {
                outList.Add(ord[i]);
            }
        }
        return outList;
    }

    // 全部有效项的数组快照（按插入次序）。
    public T[] ToArray() {
        int liveCnt = this.live;
        T[] arr = new T[liveCnt];
        if (liveCnt == 0) { return arr; }
        List<T> ord = this.order;
        int n = ord.Count;
        if (liveCnt == n) {
            for (int i = 0; i < n; i = i + 1) { arr[i] = ord[i]; }
            return arr;
        }
        List<bool> d = this.dead;
        int outIdx = 0;
        for (int i = 0; i < n; i = i + 1) {
            if (!d[i] && outIdx < liveCnt) {
                arr[outIdx] = ord[i];
                outIdx = outIdx + 1;
            }
        }
        return arr;
    }

    // 第 i 个有效项（从 0 开始，按插入次序，
    // 无墓碑时 O(1) 直达，否则跳过已移除的墓碑）；越界抛 InvalidOperationException。
    public T ElementAt(int i) {
        if (i < 0 || i >= this.live) {
            throw new InvalidOperationException("HashSet.ElementAt index out of range");
        }
        List<T> ord = this.order;
        int n = ord.Count;
        if (this.live == n) {
            return ord[i];
        }
        List<bool> d = this.dead;
        int seen = 0;
        for (int k = 0; k < n; k = k + 1) {
            if (d[k]) { continue; }
            if (seen == i) { return ord[k]; }
            seen = seen + 1;
        }
        throw new InvalidOperationException("HashSet.ElementAt index out of range");
    }

    // 创建一个按插入次序遍历有效项的枚举器（foreach 降级入口）。
    public IEnumerator<T> GetEnumerator() {
        return new HashSetEnumerator<T>(this);
    }
}
