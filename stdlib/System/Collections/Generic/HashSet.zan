using System;

namespace System.Collections.Generic;

/// <summary>
/// 唯一项的集合：成员判定走 <c>Dict&lt;T, int&gt;</c> 的开地址哈希表
/// （<see cref="Add"/>、<see cref="Contains"/>、<see cref="Remove"/>
/// 摊还 O(1)），插入顺序用并行表保留（Remove 打墓碑，墓碑过半时
/// 一次性压缩，摊还仍 O(1)）。<see cref="ElementAt"/> 按插入次序
/// 枚举有效项。
/// 相等性沿用 Dict 的键规则：
/// <list type="bullet">
/// <item>值类型（int、long、double、bool、enum）按值比较；</item>
/// <item>string 按内容比较（Dict 的内建哈希/比较即内容感知）；</item>
/// <item>其他引用类型按身份（同一实例）比较。</item>
/// </list>
/// </summary>
class HashSet<T> {
    Dict<T, int> idx;
    List<T> order;
    List<bool> dead;
    int live;

    HashSet() {
        idx = new Dict<T, int>();
        order = new List<T>();
        dead = new List<bool>();
        live = 0;
    }

    /// <summary>
    /// 若尚不存在则添加该项；已添加返回 true，
    /// 若已有相等项则返回 false。
    /// </summary>
    bool Add(T v) {
        if (idx.ContainsKey(v)) { return false; }
        order.Add(v);
        dead.Add(false);
        idx.Add(v, order.Count - 1);
        live = live + 1;
        return true;
    }

    /// <summary>是否存在相等的项。</summary>
    bool Contains(T v) { return idx.ContainsKey(v); }

    /// <summary>移除相等的项（若存在），返回是否实际移除。
    /// 只打墓碑；墓碑超过一半时整体压缩一次。</summary>
    bool Remove(T v) {
        if (!idx.ContainsKey(v)) { return false; }
        int i = idx[v];
        idx.Remove(v);
        dead[i] = true;
        live = live - 1;
        if (live * 2 < order.Count) { this.Compact(); }
        return true;
    }

    /// <summary>丢弃墓碑，重建 order 与 idx（均摊 O(1)/次操作）。</summary>
    void Compact() {
        List<T> no = new List<T>();
        List<bool> nd = new List<bool>();
        Dict<T, int> ni = new Dict<T, int>();
        for (int i = 0; i < order.Count; i = i + 1) {
            if (dead[i]) { continue; }
            no.Add(order[i]);
            nd.Add(false);
            ni.Add(order[i], no.Count - 1);
        }
        order = no;
        dead = nd;
        idx = ni;
    }

    /// <summary>不同项的数量。</summary>
    int Count() { return live; }

    /// <summary>集合是否为空。</summary>
    bool IsEmpty() { return live == 0; }

    /// <summary>清空所有项。</summary>
    void Clear() {
        idx = new Dict<T, int>();
        order = new List<T>();
        dead = new List<bool>();
        live = 0;
    }

    /// <summary>
    /// 全部有效项的快照（按插入次序）。修改快照不影响集合本身。
    /// </summary>
    List<T> Keys() {
        List<T> outList = new List<T>();
        for (int i = 0; i < order.Count; i = i + 1) {
            if (!dead[i]) { outList.Add(order[i]); }
        }
        return outList;
    }

    /// <summary>
    /// 第 <paramref name="i"/> 个有效项（从 0 开始，按插入次序，
    /// 跳过已移除的墓碑）；越界抛 IndexOutOfRange。
    /// </summary>
    T ElementAt(int i) {
        if (i < 0 || i >= live) { throw new InvalidOperationException("HashSet.ElementAt index out of range"); }
        int seen = 0;
        for (int k = 0; k < order.Count; k = k + 1) {
            if (dead[k]) { continue; }
            if (seen == i) { return order[k]; }
            seen = seen + 1;
        }
        throw new InvalidOperationException("HashSet.ElementAt index out of range");
    }
}
