using System;

namespace System.Collections.Generic;

// <see cref="Queue{T}"/> 的枚举器：按先进先出顺序遍历环形缓冲区中的活动项。
// 只持有宿主引用与游标，Current 按需从宿主读取（不缓存元素）；
// 迭代期间宿主被修改时，下一次 MoveNext 抛 InvalidOperationException。
public class QueueEnumerator<T> : IEnumerator<T> {
    Queue<T> owner;
    int pos;
    int version;

    public QueueEnumerator(Queue<T> owner) {
        this.owner = owner;
        this.pos = -1;
        this.version = owner.version;
    }

    // 前进到下一项；越过队尾返回 false。
    public bool MoveNext() {
        if (this.version != this.owner.version) {
            throw new InvalidOperationException("Collection was modified; enumeration operation may not execute");
        }
        if (this.pos + 1 >= this.owner.count) { return false; }
        this.pos = this.pos + 1;
        return true;
    }

    // 当前项（MoveNext 返回 true 后才有效）。
    public T Current() {
        int idx = (this.owner.head + this.pos) % this.owner.capacity;
        return this.owner.elements[idx];
    }
}
