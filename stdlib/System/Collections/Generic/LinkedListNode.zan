using System;

namespace System.Collections.Generic;

// <see cref="LinkedList{T}"/> 中的节点，暴露其相邻节点。
public class LinkedListNode<T> {
    public T item;
    public LinkedListNode<T> prev;
    public LinkedListNode<T> next;

    public LinkedListNode(T v) {
        this.item = v;
        this.prev = null;
        this.next = null;
    }

    // 此节点存储的值。
    public T Value() {
        return this.item;
    }

    // 下一个节点，尾部为 null。
    public LinkedListNode<T> Next() {
        return this.next;
    }

    // 上一个节点，头部为 null。
    public LinkedListNode<T> Prev() {
        return this.prev;
    }
}
