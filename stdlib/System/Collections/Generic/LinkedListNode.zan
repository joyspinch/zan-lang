using System;

namespace System.Collections.Generic;

// <see cref="LinkedList{T}"/> 中的节点，暴露其相邻节点。
// 强引用链只沿 next 单向延伸（head → … → tail），prev 是弱引用：
// 否则 prev ↔ next 构成 ARC 引用环，未显式 Clear 的链表在释放时会整条泄漏。
public class LinkedListNode<T> {
    public T item;
    public weak LinkedListNode<T> prev;
    public LinkedListNode<T> next;

    public LinkedListNode(T v) {
        this.item = v;
        this.prev = null;
        this.next = null;
    }

    // 此节点存储的值。
    public T Value() {
        return this.item;
    }

    // 下一个节点，尾部为 null。
    public LinkedListNode<T> Next() {
        return this.next;
    }

    // 上一个节点，头部为 null。
    public LinkedListNode<T> Prev() {
        return this.prev;
    }
}
