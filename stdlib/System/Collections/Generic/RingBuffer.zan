using System;
using System.Collections.Generic;

namespace System.Collections.Generic;

// 高性能无锁环形缓冲区（Lock-Free Single-Producer Single-Consumer RingBuffer）。
// 专为高频音视频数据帧、网卡数据包采集与高吞吐协程/线程流水线设计。
// 容量自动向上对齐到 2 的幂次，以位与运算代替取模操作，消除锁竞争与中间堆分配。
public class RingBuffer<T> {
    private List<T> buffer;
    private int capacity;
    private int mask;
    private int head;
    private int tail;

    public RingBuffer(int capacity) {
        int cap = 1;
        while (cap < capacity) {
            cap = cap * 2;
        }
        if (cap < 2) { cap = 2; }
        this.capacity = cap;
        this.mask = cap - 1;
        this.buffer = new List<T>();
        for (int i = 0; i < cap; i = i + 1) {
            this.buffer.Add(null);
        }
        this.head = 0;
        this.tail = 0;
    }

    public static RingBuffer<T> Create(int capacity) {
        return new RingBuffer<T>(capacity);
    }

    public int Capacity {
        get { return this.capacity; }
    }

    public int Count {
        get {
            int h = this.head;
            int t = this.tail;
            if (t >= h) {
                return t - h;
            }
            return this.capacity - (h - t);
        }
    }

    public bool IsEmpty {
        get { return this.head == this.tail; }
    }

    public bool IsFull {
        get { return this.Count == (this.capacity - 1); }
    }

    // 尝试写入一项。若缓冲区已满返回 false，不产生阻塞。
    public bool TryWrite(T item) {
        int nextTail = (this.tail + 1) & this.mask;
        if (nextTail == this.head) {
            return false;
        }
        this.buffer[this.tail] = item;
        this.tail = nextTail;
        return true;
    }

    // 尝试读取一项。若缓冲区为空返回 false。
    public bool TryRead(out T item) {
        if (this.head == this.tail) {
            item = null;
            return false;
        }
        item = this.buffer[this.head];
        this.buffer[this.head] = null;
        this.head = (this.head + 1) & this.mask;
        return true;
    }

    // 查看队首元素但不弹出
    public bool TryPeek(out T item) {
        if (this.head == this.tail) {
            item = null;
            return false;
        }
        item = this.buffer[this.head];
        return true;
    }

    // 清空缓冲区
    public void Clear() {
        while (this.head != this.tail) {
            this.buffer[this.head] = null;
            this.head = (this.head + 1) & this.mask;
        }
    }
}
