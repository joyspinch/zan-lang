using System;
using System.Collections.Generic;
using System.Numerics;

namespace System.Collections.Generic;

// 高性能无锁环形缓冲区（Lock-Free Single-Producer Single-Consumer RingBuffer）。
// 专为高频音视频数据帧、网卡数据包采集与高吞吐协程/线程流水线设计。
// 容量自动向上对齐到 2 的幂次，以位与运算代替取模操作，消除锁竞争与中间堆分配。
public class RingBuffer<T> {
    public T[] buffer;
    public int capacity;
    public int mask;
    public int head;
    public int tail;

    public RingBuffer(int capacity) {
        int cap = 2;
        if (capacity > 2) {
            cap = BitOperations.RoundUpToPowerOf2(capacity);
        }
        this.capacity = cap;
        this.mask = cap - 1;
        this.buffer = new T[cap];
        this.head = 0;
        this.tail = 0;
    }

    public static RingBuffer<T> Create(int capacity) {
        return new RingBuffer<T>(capacity);
    }

    public int Capacity {
        get { return this.capacity; }
    }

    public int Count {
        get {
            int h = this.head;
            int t = this.tail;
            if (t >= h) {
                return t - h;
            }
            return this.capacity - (h - t);
        }
    }

    public bool IsEmpty {
        get { return this.head == this.tail; }
    }

    public bool IsFull {
        get { return this.Count == (this.capacity - 1); }
    }

    // 尝试写入一项。若缓冲区已满返回 false，不产生阻塞。
    public bool TryWrite(T item) {
        int nextTail = (this.tail + 1) & this.mask;
        if (nextTail == this.head) {
            return false;
        }
        this.buffer[this.tail] = item;
        this.tail = nextTail;
        return true;
    }

    // 尝试读取一项。若缓冲区为空返回 false。
    public bool TryRead(out T item) {
        if (this.head == this.tail) {
            item = null;
            return false;
        }
        item = this.buffer[this.head];
        this.buffer[this.head] = null;
        this.head = (this.head + 1) & this.mask;
        return true;
    }

    // 查看队首元素但不弹出
    public bool TryPeek(out T item) {
        if (this.head == this.tail) {
            item = null;
            return false;
        }
        item = this.buffer[this.head];
        return true;
    }

    // 批量写入：分至多两段连续高速内存块拷贝，返回实际写入项数
    public int WriteBatch(T[] source, int offset, int count) {
        if (source == null || count <= 0 || offset < 0 || offset + count > source.Length) {
            return 0;
        }
        int available = (this.capacity - 1) - this.Count;
        int toWrite = count < available ? count : available;
        if (toWrite <= 0) { return 0; }

        int t = this.tail;
        int firstChunk = this.capacity - t;
        if (toWrite <= firstChunk) {
            Array.Copy<T>(source, offset, this.buffer, t, toWrite);
        } else {
            Array.Copy<T>(source, offset, this.buffer, t, firstChunk);
            Array.Copy<T>(source, offset + firstChunk, this.buffer, 0, toWrite - firstChunk);
        }
        this.tail = (t + toWrite) & this.mask;
        return toWrite;
    }

    // 批量读取：分至多两段连续高速内存块拷贝，返回实际读取项数
    public int ReadBatch(T[] destination, int offset, int count) {
        if (destination == null || count <= 0 || offset < 0 || offset + count > destination.Length) {
            return 0;
        }
        int available = this.Count;
        int toRead = count < available ? count : available;
        if (toRead <= 0) { return 0; }

        int h = this.head;
        int firstChunk = this.capacity - h;
        if (toRead <= firstChunk) {
            Array.Copy<T>(this.buffer, h, destination, offset, toRead);
            for (int i = 0; i < toRead; i = i + 1) { this.buffer[h + i] = null; }
        } else {
            Array.Copy<T>(this.buffer, h, destination, offset, firstChunk);
            for (int i = 0; i < firstChunk; i = i + 1) { this.buffer[h + i] = null; }
            int secondChunk = toRead - firstChunk;
            Array.Copy<T>(this.buffer, 0, destination, offset + firstChunk, secondChunk);
            for (int i = 0; i < secondChunk; i = i + 1) { this.buffer[i] = null; }
        }
        this.head = (h + toRead) & this.mask;
        return toRead;
    }

    // 清空缓冲区
    public void Clear() {
        while (this.head != this.tail) {
            this.buffer[this.head] = null;
            this.head = (this.head + 1) & this.mask;
        }
    }
}
