using System;
using System.Collections.Generic;
using System.Numerics;

namespace System.Collections.Generic;

// 高性能无锁环形缓冲区（Lock-Free Single-Producer Single-Consumer RingBuffer）。
// 专为高频音视频数据帧、网卡数据包采集与高吞吐协程/线程流水线设计。
// 容量自动向上对齐到 2 的幂次，以位与运算代替取模操作，消除锁竞争与中间堆分配。
public class RingBuffer<T> {
    [DllImport("crt", EntryPoint = "zan_atomic_int_load")]
    private static extern long AtomicLoad(long[] cell);

    [DllImport("crt", EntryPoint = "zan_atomic_int_store")]
    private static extern void AtomicStore(long[] cell, long value);

    public T[] buffer;
    public int capacity;
    public int mask;
    public int head;
    public int tail;
    private long[] headCell;
    private long[] tailCell;

    public RingBuffer(int capacity) {
        int cap = 2;
        if (capacity >= 1073741824) {
            cap = 1073741824;
        } else if (capacity > 2) {
            cap = BitOperations.RoundUpToPowerOf2(capacity);
        }
        this.capacity = cap;
        this.mask = cap - 1;
        this.buffer = new T[cap];
        this.head = 0;
        this.tail = 0;
        this.headCell = new long[1];
        this.tailCell = new long[1];
        AtomicStore(this.headCell, 0L);
        AtomicStore(this.tailCell, 0L);
    }

    public static RingBuffer<T> Create(int capacity) {
        return new RingBuffer<T>(capacity);
    }

    public int Capacity {
        get { return this.capacity; }
    }

    public int Count {
        get {
            int h = (int)AtomicLoad(this.headCell);
            int t = (int)AtomicLoad(this.tailCell);
            if (t >= h) {
                return t - h;
            }
            return this.capacity - (h - t);
        }
    }

    public bool IsEmpty {
        get { return (int)AtomicLoad(this.headCell) == (int)AtomicLoad(this.tailCell); }
    }

    public bool IsFull {
        get { return this.Count == (this.capacity - 1); }
    }

    // 尝试写入一项。若缓冲区已满返回 false，不产生阻塞。
    public bool TryWrite(T item) {
        int t = (int)AtomicLoad(this.tailCell);
        int nextTail = (t + 1) & this.mask;
        if (nextTail == (int)AtomicLoad(this.headCell)) {
            return false;
        }
        this.buffer[t] = item;
        this.tail = nextTail;
        AtomicStore(this.tailCell, (long)nextTail);
        return true;
    }

    // 尝试读取一项。若缓冲区为空返回 false。
    public bool TryRead(out T item) {
        int h = (int)AtomicLoad(this.headCell);
        if (h == (int)AtomicLoad(this.tailCell)) {
            item = null;
            return false;
        }
        item = this.buffer[h];
        this.buffer[h] = null;
        int nextHead = (h + 1) & this.mask;
        this.head = nextHead;
        AtomicStore(this.headCell, (long)nextHead);
        return true;
    }

    // 查看队首元素但不弹出
    public bool TryPeek(out T item) {
        int h = (int)AtomicLoad(this.headCell);
        if (h == (int)AtomicLoad(this.tailCell)) {
            item = null;
            return false;
        }
        item = this.buffer[h];
        return true;
    }

    // 批量写入：分至多两段连续高速内存块拷贝，返回实际写入项数
    public int WriteBatch(T[] source, int offset, int count) {
        if (source == null || count <= 0 || offset < 0 || offset > source.Length || count > source.Length - offset) {
            return 0;
        }
        int h = (int)AtomicLoad(this.headCell);
        int t = (int)AtomicLoad(this.tailCell);
        int used = t >= h ? (t - h) : (this.capacity - (h - t));
        int available = (this.capacity - 1) - used;
        int toWrite = count < available ? count : available;
        if (toWrite <= 0) { return 0; }

        int firstChunk = this.capacity - t;
        if (toWrite <= firstChunk) {
            Array.Copy<T>(source, offset, this.buffer, t, toWrite);
        } else {
            Array.Copy<T>(source, offset, this.buffer, t, firstChunk);
            Array.Copy<T>(source, offset + firstChunk, this.buffer, 0, toWrite - firstChunk);
        }
        int nextTail = (t + toWrite) & this.mask;
        this.tail = nextTail;
        AtomicStore(this.tailCell, (long)nextTail);
        return toWrite;
    }

    // 批量读取：分至多两段连续高速内存块拷贝，返回实际读取项数
    public int ReadBatch(T[] destination, int offset, int count) {
        if (destination == null || count <= 0 || offset < 0 || offset > destination.Length || count > destination.Length - offset) {
            return 0;
        }
        int h = (int)AtomicLoad(this.headCell);
        int t = (int)AtomicLoad(this.tailCell);
        int available = t >= h ? (t - h) : (this.capacity - (h - t));
        int toRead = count < available ? count : available;
        if (toRead <= 0) { return 0; }

        int firstChunk = this.capacity - h;
        if (toRead <= firstChunk) {
            Array.Copy<T>(this.buffer, h, destination, offset, toRead);
            for (int i = 0; i < toRead; i = i + 1) { this.buffer[h + i] = null; }
        } else {
            Array.Copy<T>(this.buffer, h, destination, offset, firstChunk);
            for (int i = 0; i < firstChunk; i = i + 1) { this.buffer[h + i] = null; }
            int secondChunk = toRead - firstChunk;
            Array.Copy<T>(this.buffer, 0, destination, offset + firstChunk, secondChunk);
            for (int i = 0; i < secondChunk; i = i + 1) { this.buffer[i] = null; }
        }
        int nextHead = (h + toRead) & this.mask;
        this.head = nextHead;
        AtomicStore(this.headCell, (long)nextHead);
        return toRead;
    }

    // 清空缓冲区
    public void Clear() {
        int h = (int)AtomicLoad(this.headCell);
        int t = (int)AtomicLoad(this.tailCell);
        while (h != t) {
            this.buffer[h] = null;
            h = (h + 1) & this.mask;
            this.head = h;
            AtomicStore(this.headCell, (long)h);
            t = (int)AtomicLoad(this.tailCell);
        }
    }
}
