using System;

namespace System.Collections.Generic;

// 双向链表。两端插入和删除均为 O(1)。适用于
// 值类型（int、double、bool）及引用类型。可用
// Head 与 LinkedListNode.Next 遍历。
// 末端访问器（First、Last、
// RemoveFirst、RemoveLast）要求列表非空，
// 请先用 IsEmpty 或 Count 判断。
public class LinkedList<T> {
    public LinkedListNode<T> head;
    public LinkedListNode<T> tail;
    public int count;

    public LinkedList() {
        this.head = null;
        this.tail = null;
        this.count = 0;
    }


    // 在尾部追加项。O(1)。
    public void AddLast(T v) {
        LinkedListNode<T> n = new LinkedListNode<T>(v);
        if (this.tail == null) {
            this.head = n;
            this.tail = n;
        } else {
            n.prev = this.tail;
            this.tail.next = n;
            this.tail = n;
        }
        this.count = this.count + 1;
    }

    // 在头部插入项。O(1)。
    public void AddFirst(T v) {
        LinkedListNode<T> n = new LinkedListNode<T>(v);
        if (this.head == null) {
            this.head = n;
            this.tail = n;
        } else {
            n.next = this.head;
            this.head.prev = n;
            this.head = n;
        }
        this.count = this.count + 1;
    }

    // 移除并返回头部项。O(1)。
    public T RemoveFirst() {
        if (this.head == null) {
            throw new InvalidOperationException("LinkedList is empty");
        }
        LinkedListNode<T> oldHead = this.head;
        T v = oldHead.item;
        this.head = oldHead.next;
        if (this.head == null) {
            this.tail = null;
        } else {
            this.head.prev = null;
        }
        oldHead.prev = null;
        oldHead.next = null;
        this.count = this.count - 1;
        return v;
    }

    // 移除并返回尾部项。O(1)。
    public T RemoveLast() {
        if (this.tail == null) {
            throw new InvalidOperationException("LinkedList is empty");
        }
        LinkedListNode<T> oldTail = this.tail;
        T v = oldTail.item;
        this.tail = oldTail.prev;
        if (this.tail == null) {
            this.head = null;
        } else {
            this.tail.next = null;
        }
        oldTail.prev = null;
        oldTail.next = null;
        this.count = this.count - 1;
        return v;
    }

    // 移除指定项的第一个匹配节点。若找到并移除返回 true，否则返回 false。
    public bool Remove(T v) {
        LinkedListNode<T> cur = this.head;
        while (cur != null) {
            if (cur.item == v) {
                if (cur.prev != null) {
                    cur.prev.next = cur.next;
                } else {
                    this.head = cur.next;
                }
                if (cur.next != null) {
                    cur.next.prev = cur.prev;
                } else {
                    this.tail = cur.prev;
                }
                cur.prev = null;
                cur.next = null;
                this.count = this.count - 1;
                return true;
            }
            cur = cur.next;
        }
        return false;
    }

    // 返回头部项但不移除。
    public T First() {
        if (this.head == null) {
            throw new InvalidOperationException("LinkedList is empty");
        }
        return this.head.item;
    }

    // 返回尾部项但不移除。
    public T Last() {
        if (this.tail == null) {
            throw new InvalidOperationException("LinkedList is empty");
        }
        return this.tail.item;
    }

    // 头部节点（为空时返回 null），用于遍历。
    public LinkedListNode<T> Head() {
        return this.head;
    }

    // 尾部节点（为空时返回 null），用于遍历。
    public LinkedListNode<T> Tail() {
        return this.tail;
    }

    public LinkedListNode<T> FirstNode {
        get { return this.head; }
    }

    public LinkedListNode<T> LastNode {
        get { return this.tail; }
    }

    // 项的数量。
    public int Count() {
        return this.count;
    }

    // 列表是否为空。
    public bool IsEmpty() {
        return this.count == 0;
    }

    // 检查列表是否包含指定项。
    public bool Contains(T v) {
        LinkedListNode<T> cur = this.head;
        while (cur != null) {
            if (cur.item == v) { return true; }
            cur = cur.next;
        }
        return false;
    }

    // 清空所有项并断开所有节点间的双向循环引用。
    public void Clear() {
        LinkedListNode<T> cur = this.head;
        while (cur != null) {
            LinkedListNode<T> next = cur.next;
            cur.prev = null;
            cur.next = null;
            cur = next;
        }
        this.head = null;
        this.tail = null;
        this.count = 0;
    }

    // 将链表项复制到新数组中。
    public T[] ToArray() {
        T[] arr = new T[this.count];
        LinkedListNode<T> cur = this.head;
        int i = 0;
        while (cur != null && i < this.count) {
            arr[i] = cur.item;
            cur = cur.next;
            i = i + 1;
        }
        return arr;
    }
}
