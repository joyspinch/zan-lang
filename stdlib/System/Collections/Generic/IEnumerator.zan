using System;

namespace System.Collections.Generic;

/// <summary>
/// 枚举器协议（C# 的 <c>IEnumerator&lt;T&gt;</c> 等价物）：foreach 迭代协议
/// 的消费侧。MoveNext 前进到下一个元素，Current 读取当前元素；两者都以
/// 零参形式出现，与 foreach 降级器（GetEnumerator/MoveNext/Current 钩子）
/// 的具体类协议同形，所以一个实现本接口的类既可被 foreach 直接迭代，
/// 也可经接口引用多态分发。
/// </summary>
interface IEnumerator<T> {
    /// <summary>前进到下一个元素；越过序列末尾返回 false。</summary>
    bool MoveNext();

    /// <summary>读取当前元素（MoveNext 返回 true 后才有效）。</summary>
    T Current();
}
