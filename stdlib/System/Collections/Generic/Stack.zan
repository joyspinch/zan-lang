using System;

namespace System.Collections.Generic;

// 后进先出（LIFO）集合。由动态 List 实现，
// Push 和 Pop 均摊 O(1)。适用于值
// 类型（int、double、bool）及引用类型。
// Pop 与 Peek 要求栈非空；请
// 先用 IsEmpty 或 Count 判断，或使用 TryPop / TryPeek。
// 可直接 foreach（从栈顶到栈底，与 .NET 一致）；迭代期间修改栈时，下一次 MoveNext 抛 InvalidOperationException。
public class Stack<T> : IEnumerable<T> {
    public List<T> items;
    public int version;

    public Stack() {
        this.items = new List<T>();
        this.version = 0;
    }

    public Stack(int initialCapacity) {
        this.items = new List<T>();
        this.version = 0;
        if (initialCapacity > 0) {
            this.items.Reserve(initialCapacity);
        }
    }

    // 将项压入栈顶。
    public void Push(T v) {
        this.items.Add(v);
        this.version = this.version + 1;
    }

    // 移除并返回栈顶项。
    public T Pop() {
        int cnt = this.items.Count;
        if (cnt == 0) {
            throw new InvalidOperationException("Stack is empty");
        }
        int i = cnt - 1;
        T v = this.items[i];
        this.items.RemoveAt(i);
        this.version = this.version + 1;
        return v;
    }

    // 尝试移除并返回栈顶项。若栈为空返回 false。单次 Count 判定与内联弹出，消除二次检查与异常开销
    public bool TryPop(out T result) {
        int cnt = this.items.Count;
        if (cnt == 0) {
            result = null;
            return false;
        }
        int i = cnt - 1;
        result = this.items[i];
        this.items.RemoveAt(i);
        this.version = this.version + 1;
        return true;
    }

    // 返回栈顶项但不移除。
    public T Peek() {
        int cnt = this.items.Count;
        if (cnt == 0) {
            throw new InvalidOperationException("Stack is empty");
        }
        return this.items[cnt - 1];
    }

    // 尝试返回栈顶项但不移除。若栈为空返回 false。
    public bool TryPeek(out T result) {
        int cnt = this.items.Count;
        if (cnt == 0) {
            result = null;
            return false;
        }
        result = this.items[cnt - 1];
        return true;
    }

    // 栈中的项数。
    public int Count() {
        return this.items.Count;
    }

    // 栈是否为空。
    public bool IsEmpty() {
        return this.items.Count == 0;
    }

    // 清空所有项。
    public void Clear() {
        this.items.Clear();
        this.version = this.version + 1;
    }

    // 栈中是否包含 v。
    public bool Contains(T v) {
        return this.items.Contains(v);
    }

    // 将栈中的项复制到新数组中（按从顶到底顺序返回）。
    public T[] ToArray() {
        int n = this.items.Count;
        T[] arr = new T[n];
        for (int i = 0; i < n; i = i + 1) {
            arr[i] = this.items[n - 1 - i];
        }
        return arr;
    }

    // 创建一个从栈顶到栈底遍历的枚举器（foreach 降级入口）。
    public IEnumerator<T> GetEnumerator() {
        return new StackEnumerator<T>(this);
    }
}
