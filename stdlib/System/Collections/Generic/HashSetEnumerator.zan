using System;

namespace System.Collections.Generic;

// <see cref="HashSet{T}"/> 的枚举器：沿插入顺序表前进，跳过已移除的墓碑槽。
// 只持有宿主引用与游标，Current 按需从宿主读取；
// 迭代期间宿主被修改（含 Compact 换表）时，下一次 MoveNext 抛 InvalidOperationException。
public class HashSetEnumerator<T> : IEnumerator<T> {
    HashSet<T> owner;
    int pos;
    int version;

    public HashSetEnumerator(HashSet<T> owner) {
        this.owner = owner;
        this.pos = -1;
        this.version = owner.version;
    }

    // 前进到下一个有效项；没有更多有效项返回 false。
    public bool MoveNext() {
        if (this.version != this.owner.version) {
            throw new InvalidOperationException("Collection was modified; enumeration operation may not execute");
        }
        int i = this.pos + 1;
        while (i < this.owner.order.Count) {
            if (!this.owner.dead[i]) {
                this.pos = i;
                return true;
            }
            i = i + 1;
        }
        this.pos = this.owner.order.Count;
        return false;
    }

    // 当前项（MoveNext 返回 true 后才有效）。
    public T Current() {
        return this.owner.order[this.pos];
    }
}
