using System;

namespace System.Collections.Generic;

// 先进先出（FIFO）集合。由带头尾指针的
// 单向链表实现，Enqueue 与 Dequeue
// 均为 O(1)。适用于值类型（int、double、bool）和引用
// 类型。
// Dequeue 与 Peek 要求队列非空；
// 请先用 IsEmpty 或 Count 判断，或使用 TryDequeue / TryPeek。
public class Queue<T> {
    public QueueNode<T> head;
    public QueueNode<T> tail;
    public int count;

    public Queue() {
        this.head = null;
        this.tail = null;
        this.count = 0;
    }

    // 在队尾追加项。O(1)。
    public void Enqueue(T v) {
        QueueNode<T> n = new QueueNode<T>(v);
        if (this.tail == null) {
            this.head = n;
            this.tail = n;
        } else {
            this.tail.next = n;
            this.tail = n;
        }
        this.count = this.count + 1;
    }

    // 移除并返回队首项。O(1)。
    public T Dequeue() {
        if (this.head == null) {
            throw new InvalidOperationException("Queue is empty");
        }
        T v = this.head.item;
        this.head = this.head.next;
        if (this.head == null) {
            this.tail = null;
        }
        this.count = this.count - 1;
        return v;
    }

    // 尝试移除并返回队首项。若队列为空返回 false。
    public bool TryDequeue(out T result) {
        if (this.head == null) {
            result = null;
            return false;
        }
        result = this.Dequeue();
        return true;
    }

    // 返回队首项但不移除。
    public T Peek() {
        if (this.head == null) {
            throw new InvalidOperationException("Queue is empty");
        }
        return this.head.item;
    }

    // 尝试返回队首项但不移除。若队列为空返回 false。
    public bool TryPeek(out T result) {
        if (this.head == null) {
            result = null;
            return false;
        }
        result = this.head.item;
        return true;
    }

    // 队列中的项数。
    public int Count() {
        return this.count;
    }

    // 队列是否为空。
    public bool IsEmpty() {
        return this.count == 0;
    }

    // 检查队列是否包含指定项。
    public bool Contains(T v) {
        QueueNode<T> cur = this.head;
        while (cur != null) {
            if (cur.item == v) { return true; }
            cur = cur.next;
        }
        return false;
    }

    // 清空所有项。
    public void Clear() {
        this.head = null;
        this.tail = null;
        this.count = 0;
    }

    // 将队列项复制到新数组中（保持原有队列不变，不破坏结构与分配节点）。
    public T[] ToArray() {
        T[] arr = new T[this.count];
        QueueNode<T> cur = this.head;
        int i = 0;
        while (cur != null && i < this.count) {
            arr[i] = cur.item;
            cur = cur.next;
            i = i + 1;
        }
        return arr;
    }
}
