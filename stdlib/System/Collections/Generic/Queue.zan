using System;

namespace System.Collections.Generic;

// 先进先出（FIFO）集合。基于连续环形数组缓冲区（Circular Ring Buffer）
// 实现，入队与出队均摊为严格 O(1) 且零额外堆分配开销。适用于值类型（int、double、bool）和引用
// 类型。
// Dequeue 与 Peek 要求队列非空；
// 请先用 IsEmpty 或 Count 判断，或使用 TryDequeue / TryPeek。
public class Queue<T> {
    public List<T> elements;
    public int head;
    public int tail;
    public int count;
    public int capacity;

    public Queue() {
        this.capacity = 8;
        this.elements = new List<T>();
        this.elements.Reserve(this.capacity);
        for (int i = 0; i < this.capacity; i = i + 1) {
            this.elements.Add(null);
        }
        this.head = 0;
        this.tail = 0;
        this.count = 0;
    }

    public Queue(int initialCapacity) {
        if (initialCapacity < 4) { initialCapacity = 4; }
        this.capacity = initialCapacity;
        this.elements = new List<T>();
        this.elements.Reserve(this.capacity);
        for (int i = 0; i < this.capacity; i = i + 1) {
            this.elements.Add(null);
        }
        this.head = 0;
        this.tail = 0;
        this.count = 0;
    }

    // 在队尾追加项。O(1) 均摊。
    public void Enqueue(T v) {
        if (this.count == this.capacity) {
            this.Grow();
        }
        this.elements[this.tail] = v;
        this.tail = (this.tail + 1) % this.capacity;
        this.count = this.count + 1;
    }

    private void Grow() {
        int newCap = this.capacity * 2;
        List<T> newElems = new List<T>();
        newElems.Reserve(newCap);
        for (int i = 0; i < this.count; i = i + 1) {
            int idx = (this.head + i) % this.capacity;
            newElems.Add(this.elements[idx]);
        }
        for (int i = this.count; i < newCap; i = i + 1) {
            newElems.Add(null);
        }
        this.elements = newElems;
        this.head = 0;
        this.tail = this.count;
        this.capacity = newCap;
    }

    // 移除并返回队首项。O(1)。
    public T Dequeue() {
        if (this.count == 0) {
            throw new InvalidOperationException("Queue is empty");
        }
        T v = this.elements[this.head];
        this.elements[this.head] = null;
        this.head = (this.head + 1) % this.capacity;
        this.count = this.count - 1;
        return v;
    }

    // 尝试移除并返回队首项。若队列为空返回 false。
    public bool TryDequeue(out T result) {
        if (this.count == 0) {
            result = null;
            return false;
        }
        result = this.Dequeue();
        return true;
    }

    // 返回队首项但不移除。
    public T Peek() {
        if (this.count == 0) {
            throw new InvalidOperationException("Queue is empty");
        }
        return this.elements[this.head];
    }

    // 尝试返回队首项但不移除。若队列为空返回 false。
    public bool TryPeek(out T result) {
        if (this.count == 0) {
            result = null;
            return false;
        }
        result = this.elements[this.head];
        return true;
    }

    // 队列中的项数。
    public int Count() {
        return this.count;
    }

    // 队列是否为空。
    public bool IsEmpty() {
        return this.count == 0;
    }

    // 检查队列是否包含指定项。
    public bool Contains(T v) {
        for (int i = 0; i < this.count; i = i + 1) {
            int idx = (this.head + i) % this.capacity;
            if (this.elements[idx] == v) { return true; }
        }
        return false;
    }

    // 清空所有项。
    public void Clear() {
        for (int i = 0; i < this.capacity; i = i + 1) {
            this.elements[i] = null;
        }
        this.head = 0;
        this.tail = 0;
        this.count = 0;
    }

    // 将队列项复制到新数组中（保持原有队列不变）。
    public T[] ToArray() {
        T[] arr = new T[this.count];
        for (int i = 0; i < this.count; i = i + 1) {
            int idx = (this.head + i) % this.capacity;
            arr[i] = this.elements[idx];
        }
        return arr;
    }
}
