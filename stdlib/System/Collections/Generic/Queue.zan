using System;
using System.Numerics;

namespace System.Collections.Generic;

// 先进先出（FIFO）集合。基于扁平原生环形数组（Circular Ring Buffer）
// 实现，容量恒定对齐 2 的整数次幂以实现单周期位掩码快速寻址。
// 入队与出队均摊为严格 O(1)。
// Dequeue 与 Peek 要求队列非空；请先用 IsEmpty 或 Count 判断，或使用 TryDequeue / TryPeek。
// 可直接 foreach（先进先出顺序）；迭代期间修改队列时，下一次 MoveNext 抛 InvalidOperationException。
public class Queue<T> : IEnumerable<T> {
    public T[] elements;
    public int head;
    public int tail;
    public int count;
    public int capacity;
    public int version;
    private T defaultVal;

    public Queue() {
        this.capacity = 8;
        this.elements = new T[8];
        this.head = 0;
        this.tail = 0;
        this.count = 0;
        this.version = 0;
        this.defaultVal = new T[1][0];
    }

    public Queue(int initialCapacity) {
        int cap = 8;
        if (initialCapacity > 8) {
            cap = BitOperations.RoundUpToPowerOf2(initialCapacity);
        }
        this.capacity = cap;
        this.elements = new T[cap];
        this.head = 0;
        this.tail = 0;
        this.count = 0;
        this.version = 0;
        this.defaultVal = new T[1][0];
    }

    // 在队尾追加项。O(1) 均摊，单周期位掩码环形指针推进。
    public void Enqueue(T v) {
        if (this.count == this.capacity) {
            this.Grow();
        }
        this.elements[this.tail] = v;
        this.tail = (this.tail + 1) & (this.capacity - 1);
        this.count = this.count + 1;
        this.version = this.version + 1;
    }

    private void Grow() {
        int newCap = this.capacity * 2;
        T[] newArr = new T[newCap];
        if (this.count > 0) {
            if (this.head < this.tail) {
                Array.Copy<T>(this.elements, this.head, newArr, 0, this.count);
            } else {
                int firstLen = this.capacity - this.head;
                Array.Copy<T>(this.elements, this.head, newArr, 0, firstLen);
                Array.Copy<T>(this.elements, 0, newArr, firstLen, this.tail);
            }
        }
        this.elements = newArr;
        this.head = 0;
        this.tail = this.count;
        this.capacity = newCap;
    }

    // 移除并返回队首项。O(1)。
    public T Dequeue() {
        if (this.count == 0) {
            throw new InvalidOperationException("Queue is empty");
        }
        T v = this.elements[this.head];
        this.elements[this.head] = this.defaultVal;
        this.head = (this.head + 1) & (this.capacity - 1);
        this.count = this.count - 1;
        this.version = this.version + 1;
        return v;
    }

    // 尝试移除并返回队首项。若队列为空返回 false。
    public bool TryDequeue(out T result) {
        if (this.count == 0) {
            result = this.defaultVal;
            return false;
        }
        result = this.Dequeue();
        return true;
    }

    // 返回队首项但不移除。
    public T Peek() {
        if (this.count == 0) {
            throw new InvalidOperationException("Queue is empty");
        }
        return this.elements[this.head];
    }

    // 尝试返回队首项但不移除。若队列为空返回 false。
    public bool TryPeek(out T result) {
        if (this.count == 0) {
            result = this.defaultVal;
            return false;
        }
        result = this.elements[this.head];
        return true;
    }

    // 队列中的项数。
    public int Count() {
        return this.count;
    }

    // 队列是否为空。
    public bool IsEmpty() {
        return this.count == 0;
    }

    // 检查队列是否包含指定项。
    public bool Contains(T v) {
        int mask = this.capacity - 1;
        for (int i = 0; i < this.count; i = i + 1) {
            int idx = (this.head + i) & mask;
            if (this.elements[idx] == v) { return true; }
        }
        return false;
    }

    // 清空所有项。对值类型和引用类型均按类型零值重置，避免值类型结构体残留旧数据与引用类型泄漏。
    public void Clear() {
        if (this.count > 0) {
            for (int i = 0; i < this.capacity; i = i + 1) {
                this.elements[i] = this.defaultVal;
            }
        }
        this.head = 0;
        this.tail = 0;
        this.count = 0;
        this.version = this.version + 1;
    }

    // 将队列项复制到新数组中（保持原有队列不变）。
    public T[] ToArray() {
        T[] arr = new T[this.count];
        if (this.count > 0) {
            if (this.head < this.tail) {
                Array.Copy<T>(this.elements, this.head, arr, 0, this.count);
            } else {
                int firstLen = this.capacity - this.head;
                Array.Copy<T>(this.elements, this.head, arr, 0, firstLen);
                Array.Copy<T>(this.elements, 0, arr, firstLen, this.tail);
            }
        }
        return arr;
    }

    // 创建一个按先进先出顺序遍历队列的枚举器（foreach 降级入口）。
    public IEnumerator<T> GetEnumerator() {
        return new QueueEnumerator<T>(this);
    }
}
