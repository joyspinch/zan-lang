using System;

namespace System.Collections.Generic;

struct KVP<K, V> {
    private K _key;
    private V _value;

    // 用一个键和一个值构造键值对。
    public KVP(K key, V value) {
        _key = key;
        _value = value;
    }

    // 键。
    public K Key { get { return _key; } }

    // 值。
    public V Value { get { return _value; } }
}
