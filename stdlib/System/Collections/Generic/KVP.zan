using System;

namespace System.Collections.Generic;

public class KVP<K, V> {
    public K Key;
    public V Value;

    public KVP() {}

    // 用一个键和一个值构造键值对。
    public KVP(K key, V value) {
        Key = key;
        Value = value;
    }

    public K GetKey() { return Key; }
    public V GetValue() { return Value; }
}
