using System;

namespace System.Collections.Generic;

// 数组快照枚举器：按下标顺序遍历一个 T[]。供只能以快照语义枚举的集合
// （如 ConcurrentQueue 的 ToArray 快照）复用，也可直接包装任意数组。
// 数组是引用，枚举期间不复制元素。
public class ArrayEnumerator<T> : IEnumerator<T> {
    T[] items;
    int pos;

    public ArrayEnumerator(T[] items) {
        this.items = items;
        this.pos = -1;
    }

    // 前进到下一项；越过末尾（或数组为 null）返回 false。
    public bool MoveNext() {
        if (this.items == null) { return false; }
        if (this.pos + 1 >= this.items.Length) { return false; }
        this.pos = this.pos + 1;
        return true;
    }

    // 当前项（MoveNext 返回 true 后才有效）。
    public T Current() {
        return this.items[this.pos];
    }
}
