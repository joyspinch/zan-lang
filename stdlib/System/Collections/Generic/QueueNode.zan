using System;

namespace System.Collections.Generic;

// <see cref="Queue{T}"/> 单向链表中的一个节点。
public class QueueNode<T> {
    public T item;
    public QueueNode<T> next;

    public QueueNode(T v) {
        this.item = v;
        this.next = null;
    }

    public T Value { get { return this.item; } }
    public QueueNode<T> Next { get { return this.next; } }
}
