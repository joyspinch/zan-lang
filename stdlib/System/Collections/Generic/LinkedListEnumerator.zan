using System;

namespace System.Collections.Generic;

// <see cref="LinkedList{T}"/> 的枚举器：从头节点到尾节点依次遍历。
// 只持有宿主引用与当前节点，Current 读取节点存储的值；
// 迭代期间宿主被修改时，下一次 MoveNext 抛 InvalidOperationException。
public class LinkedListEnumerator<T> : IEnumerator<T> {
    LinkedList<T> owner;
    LinkedListNode<T> node;
    bool started;
    int version;

    public LinkedListEnumerator(LinkedList<T> owner) {
        this.owner = owner;
        this.node = null;
        this.started = false;
        this.version = owner.version;
    }

    // 前进到下一节点；越过尾部返回 false。
    public bool MoveNext() {
        if (this.version != this.owner.version) {
            throw new InvalidOperationException("Collection was modified; enumeration operation may not execute");
        }
        if (!this.started) {
            this.started = true;
            this.node = this.owner.head;
        } else if (this.node != null) {
            this.node = this.node.next;
        }
        return this.node != null;
    }

    // 当前节点的值（MoveNext 返回 true 后才有效）。
    public T Current() {
        return this.node.item;
    }
}
