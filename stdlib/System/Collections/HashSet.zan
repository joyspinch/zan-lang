using System;

namespace System.Collections;

/// <summary>
/// 唯一项的集合，底层是动态 <c>List</c>，线性
/// 扫描（<see cref="Add"/>、<see cref="Contains"/> 和
/// <see cref="Remove"/> 均为 O(n)；哈希存储有待通用的哈希设施）。
///
/// 相等性：因为泛型元素类型在运行时会擦除为引用，
/// 运行时按以下规则判断唯一性：
/// <list type="bullet">
///   <item>值类型（int、long、double、bool、enum）按值比较——必须精确相等；以及</item>
///   <item>引用类型（包括 string）按身份（同一实例）比较——</item>
///         两个内容相同但实例不同的字符串会被视为不同。</item>
/// </list>
/// 目前如需基于内容的字符串集合，可用 <c>Dictionary</c> 以
/// 字符串为键，其内建比较即为内容感知。（对引用元素做内容相等比较
/// 需要泛型单态化。）
/// </summary>
class HashSet<T> {
    List<T> items;

    HashSet() { items = new List<T>(); }

    /// <summary>
    /// 若尚不存在则添加该项；已添加返回 true，
    /// 若已有相等项则返回 false。
    /// </summary>
    bool Add(T v) {
        if (items.Contains(v)) { return false; }
        items.Add(v);
        return true;
    }

    /// <summary>是否存在相等的项。</summary>
    bool Contains(T v) { return items.Contains(v); }

    /// <summary>移除相等的项（若存在），返回是否实际移除。</summary>
    bool Remove(T v) {
        int i = items.IndexOf(v);
        if (i < 0) { return false; }
        items.RemoveAt(i);
        return true;
    }

    /// <summary>不同项的数量。</summary>
    int Count() { return items.Count; }

    /// <summary>集合是否为空。</summary>
    bool IsEmpty() { return items.Count == 0; }

    /// <summary>清空所有项。</summary>
    void Clear() { items.Clear(); }

    /// <summary>
    /// 按插入索引 <paramref name="i"/>（从 0 开始）取项，供
    /// 枚举使用。顺序反映插入次序，移除后会自动压缩。
    /// </summary>
    T ElementAt(int i) { return items[i]; }
}
