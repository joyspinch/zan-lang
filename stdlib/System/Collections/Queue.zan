using System;

namespace System.Collections;

/// <summary><see cref="Queue{T}"/> 单向链表中的一个节点。</summary>
class QueueNode<T> {
    T item;
    QueueNode<T> next;
    QueueNode(T v) { item = v; next = null; }
}

/// <summary>
/// 先进先出（FIFO）集合。由带头尾指针的
/// 单向链表实现，<see cref="Enqueue"/> 与 <see cref="Dequeue"/>
/// 均为 O(1)。适用于值类型（int、double、bool）和引用
/// 类型。
///
/// <see cref="Dequeue"/> 与 <see cref="Peek"/> 要求队列非空；
/// 请先用 <see cref="IsEmpty"/> 或 <see cref="Count"/> 判断。
/// </summary>
class Queue<T> {
    QueueNode<T> head;
    QueueNode<T> tail;
    int count;

    Queue() { head = null; tail = null; count = 0; }

    /// <summary>在队尾追加项。O(1)。</summary>
    void Enqueue(T v) {
        QueueNode<T> n = new QueueNode<T>(v);
        if (tail == null) { head = n; tail = n; }
        else { tail.next = n; tail = n; }
        count = count + 1;
    }

    /// <summary>移除并返回队首项。O(1)。</summary>
    T Dequeue() {
        T v = head.item;
        head = head.next;
        if (head == null) { tail = null; }
        count = count - 1;
        return v;
    }

    /// <summary>返回队首项但不移除。</summary>
    T Peek() { return head.item; }

    /// <summary>队列中的项数。</summary>
    int Count() { return count; }

    /// <summary>队列是否为空。</summary>
    bool IsEmpty() { return count == 0; }

    /// <summary>清空所有项。</summary>
    void Clear() { head = null; tail = null; count = 0; }
}
