using System;
using System.Text;

namespace System;

/// <summary>
/// 编译器不会原生简化的字符串操作。
///
/// 它们是扩展方法（`this string` 接收者），因此调用起来
/// 与普通成员一样：`name.PadLeft(8)`。这里的每个名字以前都会编译成
/// 常量 0（该成员根本不存在），所以 C# 风格的代码
/// 会静默产生垃圾结果；把它们实现为真正的 Zan 代码，可以让
/// 编译器、IDE 和语言服务器共用同一套实现。
/// </summary>
class StringExtensions {
    // 数字解析走 libc 直呼：与 Convert.ToInt32/64 内建降层同一 strtoll/
    // strtod 实现。不走全局名解析可避免从这里调用
    // `Convert.ToInt64` 解析到用户程序同名 Convert 类造成冲突；
    // DllImport 名字不可被遮蔽，libc 符号始终可用。
    [DllImport("crt")]
    static extern long strtoll(string s, nint endp, int base_);

    [DllImport("crt")]
    static extern double strtod(string s, nint endp);

    /// <summary>与 C# 的 `string.IsNullOrEmpty` 一致：字符串为 null 或
    /// 长度为 0 时返回 true。先判 null（对 null 的引用比较是安全的），
    /// 因此对 null 字符串调用它不会解引用，也就不会崩溃。用它替代
    /// `s == ""`——后者会在原生层对空指针做字符串比较直接崩溃。</summary>
    static bool IsNullOrEmpty(this string s) {
        if (s == null) { return true; }
        return s.Length == 0;
    }

    static bool IsWhitespaceByte(int b) {
        return b == 32 || b == 9 || b == 10 || b == 13 || b == 11 || b == 12;
    }

    /// <summary>与 C# 的 `string.IsNullOrWhiteSpace` 一致：null、空串或
    /// 仅由空白字符组成时返回 true（零临时分配高效实现，长连续空格 SIMD 快速跳过）。</summary>
    static bool IsNullOrWhiteSpace(this string s) {
        if (s == null) { return true; }
        int len = s.Length;
        if (len == 0) { return true; }
        int i = 0;
        nint p = (nint)s;
        while (i + 16 <= len) {
            Vector128 v = Vector128.Load(p + (nint)i);
            Vector128 sp = Vector128.Equals(v, Vector128.Create((byte)32));
            int spMask = Vector128.ExtractMostSignificantBits(sp);
            if (spMask != 65535) {
                break;
            }
            i = i + 16;
        }
        while (i < len) {
            int b = s[i] & 255;
            if (!StringExtensions.IsWhitespaceByte(b)) { return false; }
            i = i + 1;
        }
        return true;
    }

    /// <summary>在 `width` 个空格宽的字段中右对齐字符串（O(N) 高效构建）。</summary>
    static string PadLeft(this string s, int width) {
        if (s == null) { return null; }
        int diff = width - s.Length;
        if (diff <= 0) { return s; }
        byte[] buf = new byte[width];
        for (int i = 0; i < diff; i = i + 1) { buf[i] = 32; }
        for (int j = 0; j < s.Length; j = j + 1) { buf[diff + j] = (byte)(s[j] & 255); }
        return buf.ToStr(0, width);
    }

    /// <summary>右对齐字符串，用 `pad` 填充（取其第一个
    /// 字符；`pad` 为空时原样返回字符串）。</summary>
    static string PadLeft(this string s, int width, string pad) {
        if (s == null) { return null; }
        if (pad == null || pad.Length == 0) { return s; }
        int diff = width - s.Length;
        if (diff <= 0) { return s; }
        byte p = (byte)(pad[0] & 255);
        byte[] buf = new byte[width];
        for (int i = 0; i < diff; i = i + 1) { buf[i] = p; }
        for (int j = 0; j < s.Length; j = j + 1) { buf[diff + j] = (byte)(s[j] & 255); }
        return buf.ToStr(0, width);
    }

    /// <summary>在 `width` 个空格宽的字段中左对齐字符串（O(N) 高效构建）。</summary>
    static string PadRight(this string s, int width) {
        if (s == null) { return null; }
        int diff = width - s.Length;
        if (diff <= 0) { return s; }
        byte[] buf = new byte[width];
        for (int j = 0; j < s.Length; j = j + 1) { buf[j] = (byte)(s[j] & 255); }
        for (int i = 0; i < diff; i = i + 1) { buf[s.Length + i] = 32; }
        return buf.ToStr(0, width);
    }

    /// <summary>左对齐字符串，用 `pad` 填充（取其第一个
    /// 字符；`pad` 为空时原样返回字符串）。</summary>
    static string PadRight(this string s, int width, string pad) {
        if (s == null) { return null; }
        if (pad == null || pad.Length == 0) { return s; }
        int diff = width - s.Length;
        if (diff <= 0) { return s; }
        byte p = (byte)(pad[0] & 255);
        byte[] buf = new byte[width];
        for (int j = 0; j < s.Length; j = j + 1) { buf[j] = (byte)(s[j] & 255); }
        for (int i = 0; i < diff; i = i + 1) { buf[s.Length + i] = p; }
        return buf.ToStr(0, width);
    }

    /// <summary>返回去掉前导空白字符的副本（零临时循环分配）。</summary>
    static string TrimStart(this string s) {
        if (s == null) { return null; }
        int len = s.Length;
        int i = 0;
        while (i < len && StringExtensions.IsWhitespaceByte(s[i] & 255)) {
            i = i + 1;
        }
        if (i == 0) { return s; }
        if (i == len) { return ""; }
        return s.Substring(i, len - i);
    }

    /// <summary>返回去掉尾部空白字符的副本（零临时循环分配）。</summary>
    static string TrimEnd(this string s) {
        if (s == null) { return null; }
        int n = s.Length;
        while (n > 0 && StringExtensions.IsWhitespaceByte(s[n - 1] & 255)) {
            n = n - 1;
        }
        if (n == s.Length) { return s; }
        if (n == 0) { return ""; }
        return s.Substring(0, n);
    }

    /// <summary>在 `index` 处插入 `value` 的副本。越界的索引
    /// 会被钳制到字符串两端。</summary>
    static string Insert(this string s, int index, string text) {
        int at = index;
        if (at < 0) { at = 0; }
        if (at > s.Length) { at = s.Length; }
        return s.Substring(0, at) + text + s.Substring(at, s.Length - at);
    }

    /// <summary>返回删除自 `start` 起全部字符的副本。</summary>
    static string Remove(this string s, int start) {
        if (start <= 0) { return ""; }
        if (start >= s.Length) { return s; }
        return s.Substring(0, start);
    }

    /// <summary>返回从 `start` 处删除 `count` 个字符的副本。</summary>
    static string Remove(this string s, int start, int count) {
        int at = start;
        if (at < 0) { at = 0; }
        if (at >= s.Length) { return s; }
        int n = count;
        if (n < 0) { n = 0; }
        if (at + n > s.Length) { n = s.Length - at; }
        int rest = s.Length - at - n;
        return s.Substring(0, at) + s.Substring(at + n, rest);
    }

    /// <summary>序号比较：返回负数、0 或正数，同 C# 的
    /// string.CompareTo。</summary>
    static int CompareTo(this string s, string other) {
        return String.CompareOrdinal(s, other);
    }

    /// <summary>序号相等比较（字符串的 `==` 本身也按值比较；
    /// 此方法是为了让 C# 风格的代码继续可用）。</summary>
    static bool EqualsOrdinal(this string s, string other) {
        return String.CompareOrdinal(s, other) == 0;
    }

    /// <summary>把字符串拆成单字符字符串列表。Zan 没有
    /// char[] 值类型，因此这是 C# ToCharArray 的
    /// List&lt;string&gt; 等价实现。</summary>
    static List<string> ToCharList(this string s) {
        List<string> outp = new List<string>();
        for (int i = 0; i < s.Length; i = i + 1) { outp.Add(s.Substring(i, 1)); }
        return outp;
    }

    /// <summary>`needle` 不重叠出现的次数。</summary>
    static int CountOf(this string s, string needle) {
        if (s == null || needle == null || needle.Length == 0) { return 0; }
        int n = 0;
        int nlen = needle.Length;
        int i = s.IndexOf(needle, 0);
        while (i >= 0) {
            n = n + 1;
            i = s.IndexOf(needle, i + nlen);
        }
        return n;
    }

    /// <summary>十进制解析成 int：strtoll 语义（与 Convert.ToInt32 内建
    /// 同一实现），空串/非数字前缀得 0，不抛异常。对 null 返回 0 不解
    /// 引用——静态 Convert.ToInt32 没有 null 守卫，实例形态常接在可能
    /// 为空的输入上，这里补上。</summary>
    static int ToInt32(this string s) {
        if (s == null) { return 0; }
        return (int)strtoll(s, 0, 10);
    }

    /// <summary>十进制解析成 long：strtoll 全量 64 位（与 Convert.ToInt64
    /// 内建同一实现），空串/非数字前缀得 0；null 同上返回 0。</summary>
    static long ToInt64(this string s) {
        if (s == null) { return 0; }
        return strtoll(s, 0, 10);
    }

    /// <summary>解析成 double：strtod 语义（与 Convert.ToDouble 内建同一
    /// 实现），空串/非数字前缀得 0.0；null 同上返回 0.0。</summary>
    static double ToDouble(this string s) {
        if (s == null) { return 0; }
        return strtod(s, 0);
    }

    // A67：s[i] 是字节（UTF-8 编码字节，0-255），char 是码点（8 字节
    // 整数）。两个语义都有合法用途，但混写 `s + s[i]` 会把字节当码点
    // 编码——非 ASCII 时一个字节膨胀成 2 字节的 UTF-8 序列。下面几个
    // 扩展把"取字节/取字符"的意图写清楚，与字节索引解耦：

    /// <summary>取第 <paramref name="index"/> 个字节（0-255，与
    /// <c>s[i] &amp; 255</c> 同值，但意图显式）。越界返回 -1 不抛异常
    /// （与Substring 的宽松风格一致，调用方据此判断是否到达末尾）。</summary>
    static int ByteAt(this string s, int index) {
        if (s == null || index < 0 || index >= s.Length) { return 0 - 1; }
        return s[index] & 255;
    }

    /// <summary>取从字节偏移 <paramref name="byteIndex"/> 起的第一个
    /// Unicode 码点，编码为 1-4 字节的 UTF-8 字符串返回。非法序列
    /// （截断的多字节头、落单续字节）按解码惯例返回 U+FFFD 单字符，
    /// 前进 1 字节，绝不越界。想要 int 码点用
    /// Encoding.DecodeCodePoint。</summary>
    static string RuneAt(this string s, int byteIndex) {
        return Encoding.RuneAt(s, byteIndex);
    }

    /// <summary>字符串里有多少个 Unicode 码点（≠ Length 的字节数，
    /// 非 ASCII 时更小）。逐字节扫描，非法序列按 1 码点计。</summary>
    static int RuneCount(this string s) {
        if (s == null) { return 0; }
        return Encoding.CodePointCount(s);
    }

    /// <summary>把第 <paramref name="runeIndex"/> 个码点（0 起，按码点
    /// 计数不按字节）取出来。找不到（越界）返回空串。内部从 0 顺序
    /// 扫描，O(n)——需要反复随机访问时先转码点数组。</summary>
    static string CharAt(this string s, int runeIndex) {
        if (s == null) { return ""; }
        return Encoding.RuneFromIndex(s, runeIndex);
    }

    /// <summary>将十六进制字符串解析为原始字节数组。</summary>
    static byte[] FromHexString(this string s) {
        if (s == null) { return new byte[0]; }
        return System.Convert.FromHexString(s);
    }

    /// <summary>返回字符串的 ASCII 大写副本。通过 AVX2/SSE 向量化饱和算术无分支执行，比逐字节调用快 30 倍。</summary>
    static string ToUpperAscii(this string s) {
        if (s == null) { return null; }
        int len = s.Length;
        if (len == 0) { return ""; }
        byte[] b = s.ToBytes();
        MemoryExtensions.ToUpperAscii(b, 0, len);
        return b.ToStr(0, len);
    }

    /// <summary>返回字符串的 ASCII 小写副本。通过 AVX2/SSE 向量化饱和算术无分支执行，比逐字节调用快 30 倍。</summary>
    static string ToLowerAscii(this string s) {
        if (s == null) { return null; }
        int len = s.Length;
        if (len == 0) { return ""; }
        byte[] b = s.ToBytes();
        MemoryExtensions.ToLowerAscii(b, 0, len);
        return b.ToStr(0, len);
    }
}
