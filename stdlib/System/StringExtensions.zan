using System;

namespace System;

/// <summary>
/// String operations that the compiler does not lower natively.
///
/// They are extension methods (`this string` receiver), so they are called
/// like ordinary members: `name.PadLeft(8)`. Every name here used to compile
/// to a constant 0 (the member simply did not exist), so plain C#-shaped code
/// silently produced garbage; keeping them as real Zan code means one
/// implementation the compiler, the IDE and the language server all agree on.
/// </summary>
class StringExtensions {
    /// <summary>Right-aligns the string in a field of `width` spaces.</summary>
    static string PadLeft(this string s, int width) {
        string outp = s;
        while (outp.Length < width) { outp = " " + outp; }
        return outp;
    }

    /// <summary>Right-aligns the string, padding with `pad` (its first
    /// character; an empty `pad` returns the string unchanged).</summary>
    static string PadLeft(this string s, int width, string pad) {
        if (pad.Length == 0) { return s; }
        string fill = pad.Substring(0, 1);
        string outp = s;
        while (outp.Length < width) { outp = fill + outp; }
        return outp;
    }

    /// <summary>Left-aligns the string in a field of `width` spaces.</summary>
    static string PadRight(this string s, int width) {
        string outp = s;
        while (outp.Length < width) { outp = outp + " "; }
        return outp;
    }

    /// <summary>Left-aligns the string, padding with `pad` (its first
    /// character; an empty `pad` returns the string unchanged).</summary>
    static string PadRight(this string s, int width, string pad) {
        if (pad.Length == 0) { return s; }
        string fill = pad.Substring(0, 1);
        string outp = s;
        while (outp.Length < width) { outp = outp + fill; }
        return outp;
    }

    /// <summary>Copy without leading whitespace.</summary>
    static string TrimStart(this string s) {
        int i = 0;
        while (i < s.Length) {
            string ch = s.Substring(i, 1);
            if (ch != " " && ch != "\t" && ch != "\r" && ch != "\n") { break; }
            i = i + 1;
        }
        return s.Substring(i, s.Length - i);
    }

    /// <summary>Copy without trailing whitespace.</summary>
    static string TrimEnd(this string s) {
        int n = s.Length;
        while (n > 0) {
            string ch = s.Substring(n - 1, 1);
            if (ch != " " && ch != "\t" && ch != "\r" && ch != "\n") { break; }
            n = n - 1;
        }
        return s.Substring(0, n);
    }

    /// <summary>Copy with `value` inserted at `index`. An out-of-range index
    /// is clamped to the ends of the string.</summary>
    static string Insert(this string s, int index, string text) {
        int at = index;
        if (at < 0) { at = 0; }
        if (at > s.Length) { at = s.Length; }
        return s.Substring(0, at) + text + s.Substring(at, s.Length - at);
    }

    /// <summary>Copy with everything from `start` onwards removed.</summary>
    static string Remove(this string s, int start) {
        if (start <= 0) { return ""; }
        if (start >= s.Length) { return s; }
        return s.Substring(0, start);
    }

    /// <summary>Copy with `count` characters removed at `start`.</summary>
    static string Remove(this string s, int start, int count) {
        int at = start;
        if (at < 0) { at = 0; }
        if (at >= s.Length) { return s; }
        int n = count;
        if (n < 0) { n = 0; }
        if (at + n > s.Length) { n = s.Length - at; }
        int rest = s.Length - at - n;
        return s.Substring(0, at) + s.Substring(at + n, rest);
    }

    /// <summary>Ordinal comparison: negative, 0 or positive like C#'s
    /// string.CompareTo.</summary>
    static int CompareTo(this string s, string other) {
        return String.CompareOrdinal(s, other);
    }

    /// <summary>Ordinal equality (`==` on strings compares by value too;
    /// this exists so C#-shaped code keeps working).</summary>
    static bool EqualsOrdinal(this string s, string other) {
        return String.CompareOrdinal(s, other) == 0;
    }

    /// <summary>The string's characters as one-character strings. Zan has no
    /// char[] value type, so this is the List&lt;string&gt; equivalent of
    /// C#'s ToCharArray.</summary>
    static List<string> ToCharList(this string s) {
        List<string> outp = new List<string>();
        for (int i = 0; i < s.Length; i = i + 1) { outp.Add(s.Substring(i, 1)); }
        return outp;
    }

    /// <summary>Number of non-overlapping occurrences of `needle`.</summary>
    static int CountOf(this string s, string needle) {
        if (needle.Length == 0) { return 0; }
        int n = 0;
        int i = 0;
        while (i + needle.Length <= s.Length) {
            if (s.Substring(i, needle.Length) == needle) {
                n = n + 1;
                i = i + needle.Length;
            } else {
                i = i + 1;
            }
        }
        return n;
    }
}
