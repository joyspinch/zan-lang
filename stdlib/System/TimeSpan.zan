using System;

namespace System;

// 一秒精度的时间间隔，以带符号的
// 总秒数存储。由 <see cref="DateTime.Subtract"/> 或
// <c>From*</c> 工厂方法产生。
class TimeSpan {
    // 带符号的总毫秒数。
    long totalMs;
    // 带符号的总秒数。
    long total;

    // 从带符号的秒数构造一个时间间隔（保持秒级兼容）。
    TimeSpan(long seconds) {
        total = seconds;
        totalMs = seconds * 1000;
    }

    // ---- 构造 ----------------------------------------------------

    // 从毫秒数构造高精度时间间隔。
    static TimeSpan FromMilliseconds(long ms) {
        TimeSpan ts = new TimeSpan(ms / 1000);
        ts.totalMs = ms;
        return ts;
    }

    // 从秒数构造：`FromSeconds(90)` = 1 分 30 秒。
    static TimeSpan FromSeconds(long s) { return new TimeSpan(s); }
    // 从分钟数构造。
    static TimeSpan FromMinutes(long m) { return new TimeSpan(m * 60); }
    // 从小时数构造。
    static TimeSpan FromHours(long h) { return new TimeSpan(h * 3600); }
    // 从天数构造。
    static TimeSpan FromDays(long d) { return new TimeSpan(d * 86400); }

    // ---- 总计（整单位，向零截断） ---------------------

    // 整个间隔的毫秒数（带符号，精度无损）。
    long TotalMilliseconds() { return totalMs; }
    // 整个间隔的秒数（带符号，精度无损）。
    long TotalSeconds() { return totalMs / 1000; }
    // 整分钟数，向零截断：90 秒 = 1。
    long TotalMinutes() { return totalMs / 60000; }
    // 整小时数，向零截断。
    long TotalHours() { return totalMs / 3600000; }
    // 整天数，向零截断。
    long TotalDays() { return totalMs / 86400000; }

    // ---- 分量（按大小拆分；符号用 TotalSeconds） ----------

    // 天分量（日历式拆分，恒非负）。
    int Days() {
        long t = totalMs; if (t < 0) { t = -t; }
        return (int)(t / 86400000);
    }
    // 小时分量（0-23，恒非负）。
    int Hours() {
        long t = totalMs; if (t < 0) { t = -t; }
        return (int)((t / 3600000) - (t / 86400000) * 24);
    }
    // 分钟分量（0-59，恒非负）。
    int Minutes() {
        long t = totalMs; if (t < 0) { t = -t; }
        return (int)((t / 60000) - (t / 3600000) * 60);
    }
    // 秒分量（0-59，恒非负）。
    int Seconds() {
        long t = totalMs; if (t < 0) { t = -t; }
        return (int)((t / 1000) - (t / 60000) * 60);
    }
    // 毫秒分量（0-999，恒非负）。
    int Milliseconds() {
        long t = totalMs; if (t < 0) { t = -t; }
        return (int)(t % 1000);
    }

    // 时间间隔为负时返回 true。
    bool IsNegative() { return totalMs < 0; }

    // ---- 算术 ------------------------------------------------------

    // 两间隔相加。
    TimeSpan Add(TimeSpan other) {
        return TimeSpan.FromMilliseconds(totalMs + other.totalMs);
    }
    // 本间隔减 other。
    TimeSpan Subtract(TimeSpan other) {
        return TimeSpan.FromMilliseconds(totalMs - other.totalMs);
    }
    // 取反（正变负）。
    TimeSpan Negate() {
        return TimeSpan.FromMilliseconds(-totalMs);
    }

    // ---- 格式化 ------------------------------------------------------

    // 文本格式为 "[-][D.]HH:MM:SS[.fff]"。
    string ToString() {
        string sign = "";
        long t = totalMs;
        if (t < 0) { sign = "-"; t = -t; }
        long d = t / 86400000;
        long h = (t / 3600000) - d * 24;
        long m = (t / 60000) - (t / 3600000) * 60;
        long s = (t / 1000) - (t / 60000) * 60;
        long ms = t % 1000;
        string hms = DateTime.Pad2(h) + ":" + DateTime.Pad2(m) + ":" + DateTime.Pad2(s);
        if (ms > 0) {
            string msStr = Convert.ToString(ms);
            if (ms < 10) { msStr = "00" + msStr; }
            else if (ms < 100) { msStr = "0" + msStr; }
            hms = hms + "." + msStr;
        }
        if (d > 0) { return sign + d + "." + hms; }
        return sign + hms;
    }
}
