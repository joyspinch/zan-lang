using System;

namespace System;

/// <summary>
/// 一秒精度的时间间隔，以带符号的
/// 总秒数存储。由 <see cref="DateTime.Subtract"/> 或
/// <c>From*</c> 工厂方法产生。
/// </summary>
class TimeSpan {
    long total; // 带符号的秒数

    /// <summary>从带符号的秒数构造一个时间间隔。</summary>
    TimeSpan(long seconds) {
        total = seconds;
    }

    // ---- 构造 ----------------------------------------------------

    /// <summary>从秒数构造：`FromSeconds(90)` = 1 分 30 秒。</summary>
    static TimeSpan FromSeconds(long s) { return new TimeSpan(s); }
    /// <summary>从分钟数构造。</summary>
    static TimeSpan FromMinutes(long m) { return new TimeSpan(m * 60); }
    /// <summary>从小时数构造。</summary>
    static TimeSpan FromHours(long h) { return new TimeSpan(h * 3600); }
    /// <summary>从天数构造。</summary>
    static TimeSpan FromDays(long d) { return new TimeSpan(d * 86400); }

    // ---- 总计（整单位，向零截断） ---------------------

    /// <summary>整个间隔的秒数（带符号，精度无损）。</summary>
    long TotalSeconds() { return total; }
    /// <summary>整分钟数，向零截断：90 秒 = 1。</summary>
    long TotalMinutes() { return total / 60; }
    /// <summary>整小时数，向零截断。</summary>
    long TotalHours() { return total / 3600; }
    /// <summary>整天数，向零截断。</summary>
    long TotalDays() { return total / 86400; }

    // ---- 分量（按大小拆分；符号用 TotalSeconds） ----------

    /// <summary>天分量（日历式拆分，恒非负）：
    /// -1.5 天 = Days 1 + 负号（见 TotalSeconds）。</summary>
    int Days() {
        long t = total; if (t < 0) { t = -t; }
        return (int)(t / 86400);
    }
    int Hours() {
        long t = total; if (t < 0) { t = -t; }
        return (int)((t / 3600) - (t / 86400) * 24);
    }
    /// <summary>分钟分量（0-59，恒非负）。</summary>
    int Minutes() {
        long t = total; if (t < 0) { t = -t; }
        return (int)((t / 60) - (t / 3600) * 60);
    }
    int Seconds() {
        long t = total; if (t < 0) { t = -t; }
        return (int)(t - (t / 60) * 60);
    }

    /// <summary>时间间隔为负时返回 true。</summary>
    bool IsNegative() { return total < 0; }

    // ---- 算术 ------------------------------------------------------

    /// <summary>两间隔相加。</summary>
    TimeSpan Add(TimeSpan other) { return new TimeSpan(total + other.total); }
    /// <summary>本间隔减 other。</summary>
    TimeSpan Subtract(TimeSpan other) { return new TimeSpan(total - other.total); }
    /// <summary>取反（正变负）。</summary>
    TimeSpan Negate() { return new TimeSpan(-total); }

    // ---- 格式化 ------------------------------------------------------

    /// <summary>文本格式为 "[-][D.]HH:MM:SS"。</summary>
    string ToString() {
        string sign = "";
        long t = total;
        if (t < 0) { sign = "-"; t = -t; }
        long d = t / 86400;
        long h = (t / 3600) - d * 24;
        long m = (t / 60) - (t / 3600) * 60;
        long s = t - (t / 60) * 60;
        string hms = DateTime.Pad2(h) + ":" + DateTime.Pad2(m) + ":" + DateTime.Pad2(s);
        if (d > 0) { return sign + d + "." + hms; }
        return sign + hms;
    }
}
