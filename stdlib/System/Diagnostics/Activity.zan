using System;
using System.Collections.Generic;

namespace System.Diagnostics;

// W3C TraceContext 分布式链路追踪活动节点。
// 支持 128-bit TraceId、64-bit SpanId、嵌套父子 Span 传播与 traceparent 标准头解析/生成。
public class Activity {
    public string operationName;
    public string traceId;
    public string spanId;
    public string parentSpanId;
    public long startTimeTicks;
    public long durationMs;
    public Dictionary<string, string> tags;
    public Activity parent;

    public static Activity Current;

    public Activity(string operationName, string traceId, string parentSpanId) {
        this.operationName = operationName;
        this.traceId = traceId;
        this.parentSpanId = parentSpanId;
        this.spanId = Activity.GenerateHexId(8);
        this.startTimeTicks = Stopwatch.NowTicks();
        this.durationMs = 0;
        this.tags = new Dictionary<string, string>();
        this.parent = null;
    }

    // 启动新的链路追踪活动，自动继承当前上下文或创建新根链路。
    public static Activity Start(string operationName) {
        string tId = "";
        string pSpanId = "";
        Activity parentAct = Activity.Current;
        if (parentAct != null && parentAct.traceId.Length > 0) {
            tId = parentAct.traceId;
            pSpanId = parentAct.spanId;
        } else {
            tId = Activity.GenerateHexId(16);
            pSpanId = "";
        }
        Activity act = new Activity(operationName, tId, pSpanId);
        act.parent = parentAct;
        Activity.Current = act;
        return act;
    }

    // 从入站 W3C traceparent 头部字符串解析并启动子活动。
    // 标准格式：00-{32位十六进制traceId}-{16位十六进制parentSpanId}-{2位十六进制flags}
    public static Activity StartFromTraceParent(string operationName, string traceparent) {
        string tId = "";
        string pSpanId = "";
        if (traceparent != null && traceparent.Length >= 55) {
            // "00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01"
            List<string> parts = traceparent.Split("-");
            if (parts.Count >= 4 && parts[0] == "00" && parts[1].Length == 32 && parts[2].Length == 16) {
                tId = parts[1];
                pSpanId = parts[2];
            }
        }
        if (tId.Length == 0) {
            tId = Activity.GenerateHexId(16);
        }
        Activity act = new Activity(operationName, tId, pSpanId);
        act.parent = Activity.Current;
        Activity.Current = act;
        return act;
    }

    // 停止当前活动，计算总耗时并恢复父上下文。
    public void Stop() {
        long endTicks = Stopwatch.NowTicks();
        long freq = Stopwatch.Frequency();
        if (freq > 0) {
            this.durationMs = (long)((endTicks - this.startTimeTicks) * 1000.0 / (double)freq);
        }
        if (Activity.Current == this) {
            Activity.Current = this.parent;
        }
    }

    // 生成 W3C traceparent 出站请求头。
    public string ToTraceParent() {
        return "00-" + this.traceId + "-" + this.spanId + "-01";
    }

    public Activity SetTag(string key, string value) {
        if (key != null) {
            this.tags[key] = value != null ? value : "";
        }
        return this;
    }

    public string GetTag(string key) {
        if (key != null && this.tags.ContainsKey(key)) {
            return this.tags[key];
        }
        return "";
    }

    // 生成指定字节长度（byteCount）的十六进制随机字符串。
    public static string GenerateHexId(int byteCount) {
        byte[] b = RandomNumberGenerator.GetBytes(byteCount);
        if (b == null || b.Length < byteCount) {
            b = new byte[byteCount];
            Random r = new Random();
            for (int i = 0; i < byteCount; i = i + 1) {
                b[i] = (byte)(r.Next() & 255);
            }
        }
        StringBuilder sb = new StringBuilder();
        string hex = "0123456789abcdef";
        for (int i = 0; i < byteCount; i = i + 1) {
            int v = b[i] & 255;
            sb.Append(hex[v >> 4]);
            sb.Append(hex[v & 15]);
        }
        return sb.ToString();
    }
}
