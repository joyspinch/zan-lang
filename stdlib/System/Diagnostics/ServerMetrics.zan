using System;
using System.IO;
using System.Json;

namespace System.Diagnostics;

/// <summary>Sink for a caught server error: the application persists it (the
/// backend error screen reads what this wrote). The detail is already
/// redacted.</summary>
delegate void ErrorSink(long ts, string origin, string detail);

/// <summary>
/// Runtime observability for long-running servers, as a standard-library
/// capability. It combines two things:
///
///   1. Portable OS probes -- a monotonic millisecond clock, process CPU time
///      and process resident memory -- so callers do not need their own
///      platform #if blocks.
///   2. An in-process aggregator (a shared singleton via Global()) that records
///      request and database-query throughput/latency, keeps a ring buffer of
///      the most recent SLOW requests and SLOW queries, and emits the whole
///      thing as JSON for a /admin/stats-style endpoint.
///
/// EVERY DURATION HERE IS IN MICROSECONDS (fields named *Us, JSON keys named
/// *_us). A request served in 200us is not measurable in milliseconds -- the
/// Windows millisecond clock steps ~15.6ms -- so a millisecond average of a
/// fast endpoint reads as a flat zero. Thresholds stay configured in ms
/// (SlowRequestMs/SlowQueryMs), because that is the scale an operator thinks in.
///
/// PLATFORM SUPPORT for the OS probes:
///   - MonoMicros: all platforms (the runtime's monotonic microsecond clock).
///   - MonoMillis: all platforms (GetTickCount64 on Windows, gettimeofday
///     elsewhere), coarse -- kept for timers and uptime, not for a request.
///   - CpuMillis:  Windows (GetProcessTimes) and Linux (/proc/self/stat).
///     Returns -1 on platforms where it cannot be read (e.g. macOS here).
///   - MemoryRssBytes: Windows (GetProcessMemoryInfo) and Linux
///     (/proc/self/statm). Returns -1 elsewhere.
/// Counters/latency/slow-lists are exact on every platform (pure in-memory).
/// The JSON reports -1 for any probe unavailable on the current OS, so callers
/// can tell "not measured" apart from a real zero.
/// </summary>

/// <summary>One slow-operation sample: its description and elapsed
/// MICROSECONDS. One entity so the text and its duration cannot drift apart in
/// the ring buffer.</summary>
class SlowEntry {
    string text;
    long us;

    /// 构造一条慢操作记录；`text` 为展示文本，`us` 为耗时（微秒）。
    SlowEntry(string text, long us) {
        this.text = text;
        this.us = us;
    }
}

/// <summary>One recorded server-side error: when it happened (epoch seconds),
/// where ("METHOD path"), and the message. Kept so an operator can see recent
/// failures in the backend even when the console is off.</summary>
class ErrEntry {
    long ts;
    string origin;
    string detail;

    /// 构造一条错误记录；`ts` 直接采用调用方传入的 epoch 秒。
    ErrEntry(long ts, string origin, string detail) {
        this.ts = ts;
        this.origin = origin;
        this.detail = detail;
    }
}

/// <summary>RecentErrors() 返回的一条错误记录：ErrEntry 的对外投影。</summary>
class ServerErrorDoc {
    long ts;
    string origin;
    string detail;
}

/// <summary>One aggregate row of the slow-SQL leaderboard, keyed by the
/// NORMALIZED ("net") statement so that the same query with different literal
/// arguments -- `in (1,2,3)` and `in (1,2,3,4,5)` -- counts as one entry.</summary>
class SqlAgg {
    string sql;      // normalized statement
    long count;      // times executed
    long totalUs;    // summed elapsed microseconds across executions
    long maxUs;      // slowest single execution

    /// 构造一行以归一化语句为键的聚合，各计数从零开始。
    SqlAgg(string sql) {
        this.sql = sql;
        this.count = 0;
        this.totalUs = 0;
        this.maxUs = 0;
    }
}

/// <summary>One aggregate row of the request leaderboard, keyed by the endpoint
/// ("METHOD /path" with numeric path segments folded to :id) so that every hit
/// of the same interface -- /admin/users/1 and /admin/users/2 -- counts as one
/// entry with its own count / average / maximum, instead of a flat list of
/// individual samples dominated by long-lived connections.</summary>
class ReqAgg {
    // The two fields an interface is named by, kept apart on purpose: the
    // verb and the endpoint are separate columns everywhere they are shown or
    // stored, and re-splitting one joined string to get them back is how a
    // path containing a space becomes a wrong row.
    string method;   // "GET"
    string path;     // route pattern ("/user/{id}") or asset path
    string req;      // "METHOD path", the joined form the JSON has always used
    long count;      // times served
    long totalUs;    // summed elapsed microseconds
    long maxUs;      // slowest single hit
    long errors;     // 5xx responses
    long failed;     // 4xx and 5xx: everything the caller did not get served
    long rejected;   // 429: refused by a rate limit, not by the handler

    /// 构造一行以端点为键的聚合；`req` 字段在此拼成 "METHOD path" 联合形式。
    ReqAgg(string method, string path) {
        this.method = method;
        this.path = path;
        this.req = method + " " + path;
        this.count = 0;
        this.totalUs = 0;
        this.maxUs = 0;
        this.errors = 0;
        this.failed = 0;
        this.rejected = 0;
    }
}

// ---- metrics-snapshot JSON ------------------------------------------------
// SnapshotJson is built straight into JsonValue trees: ServerMetrics sits on
// the compiler's generator bootstrap path (pulled in through System.IO), so it
// must not call Json.Serialize<T> -- the keys still match the documented
// /admin/stats shape exactly.

// One instance is shared by every request in the process, and requests run on
// per-worker threads (--async-workers), so every counter, ring and aggregate
// list is touched under `lock (this)`: List.Add from two workers at once, or a
// reader walking `reqAgg` while a writer appends to it, corrupts the list. The
// expensive pure work (NormalizePath, NormalizeSql) and every IO (the error
// sink and the log file) stay OUTSIDE the lock, so the critical section is only
// counter arithmetic and list bookkeeping -- and it never contains an await.

class ServerMetrics {
    #if WINDOWS
    [DllImport("kernel32", EntryPoint = "GetTickCount64")]
    static extern long GetTickCount64();
    [DllImport("kernel32", EntryPoint = "GetCurrentProcess")]
    static extern nint GetCurrentProcess();
    [DllImport("kernel32", EntryPoint = "GetProcessTimes")]
    static extern int GetProcessTimes(nint h, string cre, string ex, string kern, string usr);
    [DllImport("psapi", EntryPoint = "GetProcessMemoryInfo")]
    static extern int GetProcessMemoryInfo(nint h, string counters, int cb);
    #else
    [DllImport("crt", EntryPoint = "gettimeofday")]
    static extern int gettimeofday(string tv, nint tz);
    #endif

    // Append-only error log sink. The C runtime's buffered file IO is enough:
    // errors are rare, so each is flushed on close for crash durability rather
    // than batched. Strings are byte-indexed, so fwrite(line, 1, Length) writes
    // multibyte (UTF-8) messages intact.
    [DllImport("crt")]
    static extern nint fopen(string path, string mode);
    [DllImport("crt")]
    static extern long fwrite(string buf, long size, long count, nint fp);
    [DllImport("crt")]
    static extern int fclose(nint fp);

    // Monotonic microseconds. Every duration this class stores is in
    // microseconds, because a request is faster than the millisecond clock can
    // see: GetTickCount64 steps ~15.6ms on Windows, which reports every
    // sub-15ms request as "0 ms" and makes an average meaningless. Declared
    // here rather than reached for through System.Threading.Stopwatch: this
    // class sits on the compiler's bootstrap path and must not grow module
    // dependencies (the runtime entry point is the same one Stopwatch uses).
    [DllImport("crt", EntryPoint = "zan_monotonic_us")]
    static extern long NativeMonotonicUs();

    // Aggregated request metrics.
    int reqCount;
    int reqErrors;
    int reqFailed;    // 4xx + 5xx
    int reqRejected;  // 429: a refusal is not a success, and hiding it makes a
                      // throttled server look idle
    int reqUnmatched; // requests no route and no asset claimed (404/405, path
                      // scans): counted, never keyed by the URL they asked for
    long reqTotalUs;
    long reqMaxUs;
    int slowReqMs;                 // slow-request threshold, configured in ms
    List<SlowEntry> slowReqs;      // "METHOD path -> status" + elapsed us

    // Aggregated query metrics.
    int queryCount;
    long queryTotalUs;
    long queryMaxUs;
    int slowQueryMs;               // slow-query threshold, configured in ms
    List<SlowEntry> slowQueries;   // truncated SQL + elapsed us
    List<SqlAgg> sqlAgg;           // per-normalized-statement leaderboard
    int sqlAggCap;                 // distinct statement shapes kept
    List<ReqAgg> reqAgg;           // per-endpoint request leaderboard
    int reqAggCap;                 // distinct endpoints kept
    // The same rows again, indexed by Route.idx, so a routed request finds its
    // aggregate with one array read instead of a scan-and-compare over every
    // endpoint. Sized by the route table (fixed at start-up), so traffic never
    // grows it; entries are the very same objects as in reqAgg.
    List<ReqAgg> routeSlots;
    // The rows once more, keyed by "METHOD path", for the callers that have no
    // route index (a mounted asset, a raw path): a hash probe instead of a scan
    // over up to reqAggCap rows with two string compares each. Holds the same
    // objects as reqAgg and, like it, only ever grows up to the cap.
    Dictionary<string, ReqAgg> reqIdx;
    Dictionary<string, SqlAgg> sqlIdx;

    // ---- error log ----
    List<ErrEntry> errors;         // most-recent-first ring for the backend view
    int errCap;                    // entries kept in memory
    long errTotal;                 // errors seen since start
    string errLogPath;             // append-only sink ("" disables the file)
    bool errDebug;                 // also echo to stdout (debug mode only)

    long startMillis;
    long lastWallMs;               // for CPU% delta sampling
    long lastCpuMs;
    long lastCpuPct;               // last percentage measured over a real window
    int ringCap;

    // ---- per-second series (for charts) ----
    // A fixed ring of one-second buckets addressed by (second % seriesCap): a
    // chart needs the recent shape of the load, and a ring gives that in
    // constant memory with no allocation on the request path. The bucket's own
    // second is stored alongside its counters, so a slot the ring has lapped
    // reads as "no data" instead of as a stale sample from 5 minutes ago.
    int seriesCap;
    long[] sSec;                   // the second this slot holds (-1 = empty)
    int[] sReq;
    int[] sErr;
    long[] sTotalUs;
    long[] sMaxUs;
    int[] sQuery;
    long[] sQueryUs;
    int[] sCpu;                    // process CPU% at that second (-1 unknown)
    long[] sRss;                   // resident bytes at that second (-1 unknown)
    int[] sHist;                   // seriesCap * HIST_BINS latency histogram
    long seriesLastWall;           // CPU%-per-bucket delta state, kept apart
    long seriesLastCpu;            // from the snapshot's own delta state

    // Concurrency, which a per-request average cannot show: how many requests
    // are in flight at once, the worst it has been, and how many long-lived
    // connections are being held (a stream occupies a coroutine for minutes,
    // so it is capacity even while it is idle).
    long concurrent;
    long concurrentPeak;
    long streams;
    long streamFrames;
    long streamBytes;

    // Where a caught error goes besides the ring and the log file: the
    // application sets this to persist it (see MetricsStore).
    ErrorSink errSink;

    /// 私有构造：唯一入口是 Global()。各计数、环形缓冲与每秒序列在此初始化。
    ServerMetrics() {
        this.reqCount = 0;
        this.reqErrors = 0;
        this.reqFailed = 0;
        this.reqRejected = 0;
        this.reqUnmatched = 0;
        this.reqTotalUs = 0;
        this.reqMaxUs = 0;
        this.slowReqMs = 500;
        this.slowReqs = new List<SlowEntry>();
        this.queryCount = 0;
        this.queryTotalUs = 0;
        this.queryMaxUs = 0;
        this.slowQueryMs = 200;
        this.slowQueries = new List<SlowEntry>();
        this.sqlAgg = new List<SqlAgg>();
        this.sqlAggCap = 200;
        this.reqAgg = new List<ReqAgg>();
        this.reqAggCap = 200;
        this.routeSlots = new List<ReqAgg>();
        this.reqIdx = new Dictionary<string, ReqAgg>();
        this.sqlIdx = new Dictionary<string, SqlAgg>();
        this.errors = new List<ErrEntry>();
        this.errCap = 100;
        this.errTotal = 0;
        this.errLogPath = "logs/error.log";
        this.errDebug = false;
        this.startMillis = ServerMetrics.MonoMillis();
        this.lastWallMs = this.startMillis;
        this.lastCpuMs = 0;
        this.lastCpuPct = 0 - 1;
        this.ringCap = 32;

        this.seriesCap = 300;      // five minutes of one-second buckets
        this.sSec = new long[this.seriesCap];
        this.sReq = new int[this.seriesCap];
        this.sErr = new int[this.seriesCap];
        this.sTotalUs = new long[this.seriesCap];
        this.sMaxUs = new long[this.seriesCap];
        this.sQuery = new int[this.seriesCap];
        this.sQueryUs = new long[this.seriesCap];
        this.sCpu = new int[this.seriesCap];
        this.sRss = new long[this.seriesCap];
        this.sHist = new int[this.seriesCap * ServerMetrics.HIST_BINS];
        for (int i = 0; i < this.seriesCap; i = i + 1) { this.sSec[i] = 0 - 1; }
        this.seriesLastWall = this.startMillis;
        this.seriesLastCpu = 0;
        this.concurrent = 0;
        this.concurrentPeak = 0;
        this.streams = 0;
        this.streamFrames = 0;
        this.streamBytes = 0;
        this.errSink = null;
    }

    /// <summary>A request started. Paired with Left() in the dispatcher, so the
    /// counter is exact rather than sampled.</summary>
    void Entered() {
        lock (this) {
            this.concurrent = this.concurrent + 1;
            if (this.concurrent > this.concurrentPeak) {
                this.concurrentPeak = this.concurrent;
            }
        }
    }

    /// 一次请求离开，与 Entered() 配对；计数不会减到零以下。
    void Left() {
        lock (this) {
            if (this.concurrent > 0) { this.concurrent = this.concurrent - 1; }
        }
    }

    /// <summary>A long-lived connection opened / closed, and what it pushed
    /// while it was open. Frames and bytes, never a duration.</summary>
    void StreamOpened() {
        lock (this) { this.streams = this.streams + 1; }
    }

    /// 一条长连接关闭，`frames`/`bytes` 为其存续期内的累计推送量，并入总量。
    void StreamClosed(long frames, long bytes) {
        lock (this) {
            if (this.streams > 0) { this.streams = this.streams - 1; }
            this.streamFrames = this.streamFrames + frames;
            this.streamBytes = this.streamBytes + bytes;
        }
    }

    // Latency histogram edges in MICROSECONDS. Fixed buckets are what make a
    // percentile affordable: one increment per request, no sorting and no
    // sample retention. The low edges are what a millisecond histogram could
    // not express: a server whose requests all land in "<= 1ms" has no p95.
    static const int HIST_BINS = 13;
    /// 桶 `bin` 的上沿（微秒）；最后一桶为 long 最大值，兜住其余一切。
    static long HistEdge(int bin) {
        if (bin == 0) { return 100; }
        if (bin == 1) { return 250; }
        if (bin == 2) { return 500; }
        if (bin == 3) { return 1000; }
        if (bin == 4) { return 2500; }
        if (bin == 5) { return 5000; }
        if (bin == 6) { return 10000; }
        if (bin == 7) { return 25000; }
        if (bin == 8) { return 50000; }
        if (bin == 9) { return 100000; }
        if (bin == 10) { return 500000; }
        if (bin == 11) { return 2000000; }
        return 9223372036854775807;
    }

    /// `us` 落入的直方图桶下标（0 起）；超过所有上沿落在最后一桶。
    static int HistBin(long us) {
        int b = 0;
        while (b < ServerMetrics.HIST_BINS - 1) {
            if (us <= ServerMetrics.HistEdge(b)) { return b; }
            b = b + 1;
        }
        return ServerMetrics.HIST_BINS - 1;
    }

    /// <summary>The bucket for `sec`, cleared and CPU/RSS-sampled if this is the
    /// first write to it. Locked like every other bucket access: two workers
    /// recording in the same second must not both clear the slot.
    /// Sampling here (rather than on a timer) keeps the
    /// series free of a background coroutine: a second with no traffic has
    /// nothing worth plotting anyway, and SeriesJson fills those gaps.</summary>
    int SeriesSlot(long sec) {
        lock (this) {
        int idx = (int)(sec % (long)this.seriesCap);
        if (this.sSec[idx] == sec) { return idx; }
        this.sSec[idx] = sec;
        this.sReq[idx] = 0;
        this.sErr[idx] = 0;
        this.sTotalUs[idx] = 0;
        this.sMaxUs[idx] = 0;
        this.sQuery[idx] = 0;
        this.sQueryUs[idx] = 0;
        int hbase = idx * ServerMetrics.HIST_BINS;
        for (int b = 0; b < ServerMetrics.HIST_BINS; b = b + 1) {
            this.sHist[hbase + b] = 0;
        }
        this.sCpu[idx] = 0 - 1;
        this.sRss[idx] = ServerMetrics.MemoryRssBytes();
        long cpuMs = ServerMetrics.CpuMillis();
        long nowWall = sec * 1000;
        if (cpuMs >= 0) {
            long dWall = nowWall - this.seriesLastWall;
            long dCpu = cpuMs - this.seriesLastCpu;
            if (dWall > 0 && dCpu >= 0) {
                this.sCpu[idx] = (int)((dCpu * 100) / dWall);
            }
            this.seriesLastWall = nowWall;
            this.seriesLastCpu = cpuMs;
        }
        return idx;
        }
    }

    // ---- shared singleton ----
    static ServerMetrics inst;
    // Reusable timeval buffer for MonoMillis: allocated once, never freed, so
    // the per-request hot path costs a single vDSO gettimeofday with zero heap
    // churn. Only the POSIX branch uses it, and POSIX still drives every
    // coroutine from one thread -- MonoMillis never awaits, so two calls on
    // that thread cannot interleave mid-read. The multi-worker path (Windows
    // --async-workers) takes the GetTickCount64 branch and touches no buffer;
    // giving POSIX real worker threads means this buffer has to go per-thread.
    static byte[] monoBuf;
    /// <summary>进程级共享单例；首次调用时构造，此后所有请求共用一份。</summary>
    static ServerMetrics Global() {
        if (inst == null) { inst = new ServerMetrics(); }
        return inst;
    }

    /// 设置慢请求阈值（毫秒）；返回自身以便链式配置。
    ServerMetrics SlowRequestMs(int ms) { this.slowReqMs = ms; return this; }
    /// 设置慢查询阈值（毫秒）；返回自身以便链式配置。
    ServerMetrics SlowQueryMs(int ms) { this.slowQueryMs = ms; return this; }

    // ---- error log ----

    /// <summary>Where errors are appended and whether they also echo to the
    /// console. The log always persists; the console is a debug convenience the
    /// operator can turn off. Empty path disables the file sink.
    ///
    /// The path is a pattern expanded per write by <see cref="Log.Expand"/>:
    /// {yyyy} {MM} {dd} {HH} {pid} {wid}, and it may contain directories --
    /// missing ones are created. `logs/{yyyy}{MM}/{dd}.log` is the file the
    /// master and every worker already log into, so an error and whatever
    /// happened to the process that raised it are read in one place; each record
    /// is open-append-close, so sharing the file needs no {wid} of its own. A
    /// path without tokens behaves as before: one file that grows
    /// forever.</summary>
    ServerMetrics ErrorLog(string path, bool debugConsole) {
        this.errLogPath = path;
        this.errDebug = debugConsole;
        // The directory of the EXPANDED name: a pattern whose directory part
        // carries a token (`logs/{yyyy}{MM}/{dd}.log`) would otherwise create a
        // directory literally called "{yyyy}{MM}" and never the one the write
        // needs. Recursive, so a nested pattern works on a fresh deployment.
        if (path.Length > 0) {
            Log.EnsureDirFor(Log.Expand(path, DateTime.Now()));
        }
        return this;
    }
    /// 打开/关闭错误同时回显到 stdout；返回自身以便链式配置。
    ServerMetrics DebugConsole(bool on) { this.errDebug = on; return this; }
    /// 当前是否把错误回显到 stdout。
    bool DebugConsoleOn() { return this.errDebug; }

    /// 向错误日志追加一行并在 close 时落盘，进程随即崩溃记录也能存活。
    /// 错误罕见，不在任何热路径上；请求路径不碰磁盘。
    void AppendErrLine(string line) {
        if (this.errLogPath.Length == 0) { return; }
        string path = Log.Expand(this.errLogPath, DateTime.Now());
        // Per write, because a dated pattern moves into a directory that does
        // not exist yet on the first of the month.
        Log.EnsureDirFor(path);
        nint fp = fopen(path, "ab");
        if (fp == 0) { return; }
        long _w = fwrite(line, 1, line.Length, fp);
        int _c = fclose(fp);
    }

    /// <summary>Records one server-side error: kept in a bounded in-memory ring
    /// for the backend view and appended to the log file. `ts` is epoch seconds
    /// from the caller so this class needs no clock of its own. The detail must
    /// already be redacted by the caller -- no keys/tokens/passwords.</summary>
    void RecordError(long ts, string origin, string detail) {
        lock (this) {
            this.errTotal = this.errTotal + 1;
            this.errors.Add(new ErrEntry(ts, origin, detail));
            while (this.errors.Count > this.errCap) { this.errors.RemoveAt(0); }
        }
        // The sink and the file are outside the lock: a database write or an
        // fopen must not hold the monitor that every request path takes.
        if (this.errSink != null) { this.errSink(ts, origin, detail); }
        this.AppendErrLine("[" + DateTime.FromUnixSeconds(ts).ToString() + "] "
            + origin + " | " + detail + "\n");
        if (this.errDebug) {
            Console.WriteLine("[error] " + origin + " | " + detail);
        }
    }

    /// <summary>Where errors are persisted, set once at startup. Kept as a
    /// delegate so this class stays free of a database.</summary>
    ServerMetrics OnError(ErrorSink fn) { this.errSink = fn; return this; }

    /// 启动以来记录的错误总数（含已滚出内存 ring 的条目）。
    long ErrorTotal() { return this.errTotal; }

    /// <summary>Recent errors, most-recent first, for a backend log screen.</summary>
    List<ServerErrorDoc> RecentErrors(int limit) {
        List<ServerErrorDoc> outp = new List<ServerErrorDoc>();
        lock (this) {
            int n = this.errors.Count;
            for (int i = n - 1; i >= 0 && outp.Count < limit; i = i - 1) {
                ErrEntry e = this.errors[i];
                ServerErrorDoc d = new ServerErrorDoc();
                d.ts = e.ts;
                d.origin = e.origin;
                d.detail = e.detail;
                outp.Add(d);
            }
        }
        return outp;
    }

    // ---- OS probes ----

    /// 从 `buf` 的 `off` 起按小端读 `n` 字节为无符号整数（探针缓冲区用）。
    static long LeInt(byte[] buf, int off, int n) {
        long v = 0;
        long mul = 1;
        for (int k = 0; k < n; k = k + 1) {
            v = v + (buf[off + k] & 255) * mul;
            mul = mul * 256;
        }
        return v;
    }

    /// <summary>Monotonic MICROSECONDS: the clock every duration recorded here
    /// is measured with, resolving a single request instead of rounding it to a
    /// 15ms tick. Use deltas, not the absolute value.</summary>
    static long MonoMicros() {
        return NativeMonotonicUs();
    }

    /// <summary>Monotonic wall-clock milliseconds (not affected by clock resets
    /// the way a seconds epoch is); use deltas, not the absolute value. Coarse
    /// on Windows (~15ms): for anything request-sized use MonoMicros.</summary>
    static long MonoMillis() {
        #if WINDOWS
        return GetTickCount64();
        #else
        if (monoBuf == null) { monoBuf = new byte[16]; }
        byte[] tv = monoBuf;
        int r = gettimeofday(tv, 0);
        long sec = ServerMetrics.LeInt(tv, 0, 8);
        long usec = ServerMetrics.LeInt(tv, 8, 8);
        return sec * 1000 + usec / 1000;
        #endif
    }

    /// <summary>Cumulative process CPU time in ms (user+kernel), or -1 if the
    /// current platform cannot report it.</summary>
    static long CpuMillis() {
        #if WINDOWS
        nint h = GetCurrentProcess();
        byte[] cre = new byte[8];
        byte[] ex = new byte[8];
        byte[] kern = new byte[8];
        byte[] usr = new byte[8];
        int ok = GetProcessTimes(h, cre, ex, kern, usr);
        long k = ServerMetrics.LeInt(kern, 0, 8);
        long u = ServerMetrics.LeInt(usr, 0, 8);
        if (ok == 0) { return 0 - 1; }
        return (k + u) / 10000;   // 100ns units -> ms
        #elif LINUX
        if (!File.Exists("/proc/self/stat")) { return 0 - 1; }
        string s = File.ReadAllText("/proc/self/stat");
        int rp = ServerMetrics.LastIndexOf(s, ")");
        if (rp < 0) { return 0 - 1; }
        string rest = s.Substring(rp + 2, s.Length - (rp + 2));
        List<string> f = ServerMetrics.SplitWs(rest);
        // rest[0] = field 3 (state); utime = field 14 -> index 11, stime -> 12.
        if (f.Count < 13) { return 0 - 1; }
        long utime = Convert.ToInt64(f[11]);
        long stime = Convert.ToInt64(f[12]);
        return (utime + stime) * 10;   // assumes 100 Hz USER_HZ -> *1000/100
        #else
        return 0 - 1;
        #endif
    }

    /// <summary>Resident memory of this process in bytes, or -1 if unavailable
    /// on the current platform.</summary>
    static long MemoryRssBytes() {
        #if WINDOWS
        nint h = GetCurrentProcess();
        byte[] c = new byte[72];
        int ok = GetProcessMemoryInfo(h, c, 72);
        long rss = ServerMetrics.LeInt(c, 16, 8);   // WorkingSetSize
        if (ok == 0) { return 0 - 1; }
        return rss;
        #elif LINUX
        if (!File.Exists("/proc/self/statm")) { return 0 - 1; }
        string s = File.ReadAllText("/proc/self/statm");
        List<string> f = ServerMetrics.SplitWs(s);
        if (f.Count < 2) { return 0 - 1; }
        long residentPages = Convert.ToInt64(f[1]);
        return residentPages * 4096;
        #else
        return 0 - 1;
        #endif
    }

    /// 字符 `ch` 在 `s` 中最后一次出现的下标，找不到返回 -1。
    static int LastIndexOf(string s, string ch) {
        int i = s.Length - 1;
        while (i >= 0) {
            if (s.Substring(i, 1) == ch) { return i; }
            i = i - 1;
        }
        return 0 - 1;
    }

    /// 按空白（空格/制表/换行）拆分 `s`，连续空白算一个分隔，不产生空段。
    static List<string> SplitWs(string s) {
        List<string> parts = new List<string>();
        StringBuilder sb = new StringBuilder();
        int n = s.Length;
        for (int i = 0; i < n; i = i + 1) {
            string c = s.Substring(i, 1);
            if (c == " " || c == "\t" || c == "\n" || c == "\r") {
                if (sb.Length > 0) { parts.Add(sb.ToString()); sb = new StringBuilder(); }
            } else {
                sb.Append(c);
            }
        }
        if (sb.Length > 0) { parts.Add(sb.ToString()); }
        return parts;
    }

    // ---- recording ----

    /// <summary>Records one completed request that the server actually served,
    /// keyed by what served it: `pattern` is a route's registration pattern
    /// ("/user/{id}") or a mounted asset's path ("/static/js/app.js") -- a
    /// fixed string the server chose, never the URL the caller typed, so the
    /// leaderboard has one row per interface and none per probe.
    ///
    /// `slot` is the route's index (Route.idx), which makes the per-endpoint
    /// aggregate an array read rather than a scan over every endpoint; -1 for
    /// anything that has no route index (an asset) and is looked up by name
    /// over the handful of such rows.
    ///
    /// `us` is the elapsed time in MICROSECONDS (see MonoMicros): milliseconds
    /// cannot express a request this server serves in 200us.</summary>
    void RecordRoute(int slot, string method, string pattern, int status, long us) {
        lock (this) {
        this.CountRequest(status, us);
        this.FoldEndpoint(slot, method, pattern, us, status);
        if (us >= (long)this.slowReqMs * 1000) {
            this.slowReqs.Add(new SlowEntry(method + " " + pattern + " -> "
                + Convert.ToString(status), us));
            if (this.slowReqs.Count > this.ringCap) {
                this.slowReqs.RemoveAt(0);
            }
        }
        }
    }

    /// <summary>A request nothing claimed: a 404, a 405, a vulnerability scan.
    /// It counts in the totals and the series -- a server being probed is not
    /// an idle server -- but it gets no row of its own, because the only name
    /// it has is the one the caller invented.</summary>
    void RecordUnmatched(int status, long us) {
        lock (this) {
        this.reqUnmatched = this.reqUnmatched + 1;
        this.CountRequest(status, us);
        }
    }

    /// <summary>Records one completed HTTP request by raw path, folding numeric
    /// segments to :id. For a caller outside the dispatcher (a proxy or a hand
    /// written server) that has no route to name: the served path is the only
    /// key available. The dispatcher itself uses RecordRoute, which needs no
    /// normalization at all.</summary>
    void RecordRequest(string method, string path, int status, long us) {
        // NormalizePath is pure and allocates; keep it out of the critical
        // section so the lock only spans the counter updates.
        string folded = ServerMetrics.FoldPath(path);
        lock (this) {
        this.CountRequest(status, us);
        this.FoldEndpoint(0 - 1, method, folded, us, status);
        if (us >= (long)this.slowReqMs * 1000) {
            this.slowReqs.Add(new SlowEntry(method + " " + path + " -> " + Convert.ToString(status), us));
            if (this.slowReqs.Count > this.ringCap) {
                this.slowReqs.RemoveAt(0);
            }
        }
        }
    }

    /// <summary>The counters and the chart series every request feeds,
    /// whatever served it -- no strings, no lookups. Callers hold the
    /// lock.</summary>
    void CountRequest(int status, long us) {
        this.reqCount = this.reqCount + 1;
        this.reqTotalUs = this.reqTotalUs + us;
        if (us > this.reqMaxUs) { this.reqMaxUs = us; }
        if (status >= 500) { this.reqErrors = this.reqErrors + 1; }
        if (status >= 400) { this.reqFailed = this.reqFailed + 1; }
        if (status == 429) { this.reqRejected = this.reqRejected + 1; }

        int idx = this.SeriesSlot(ServerMetrics.MonoMicros() / 1000000);
        this.sReq[idx] = this.sReq[idx] + 1;
        this.sTotalUs[idx] = this.sTotalUs[idx] + us;
        if (us > this.sMaxUs[idx]) { this.sMaxUs[idx] = us; }
        if (status >= 500) { this.sErr[idx] = this.sErr[idx] + 1; }
        int hb = idx * ServerMetrics.HIST_BINS + ServerMetrics.HistBin(us);
        this.sHist[hb] = this.sHist[hb] + 1;
    }

    /// <summary>Folds one hit into the aggregate row for its endpoint, created
    /// on the first hit. A route (`slot` >= 0) has a direct slot in a table
    /// sized by the route table itself, so a request costs one array read and
    /// no string comparison; anything without a route index (a mounted asset, a
    /// caller with only a raw path) is found by name and bounded to
    /// `reqAggCap` rows, past which a never-seen endpoint is left out of the
    /// leaderboard rather than growing the process -- it still counts in the
    /// totals. Callers hold the lock.</summary>
    void FoldEndpoint(int slot, string method, string path, long us, int status) {
        ReqAgg a = null;
        if (slot >= 0) {
            while (this.routeSlots.Count <= slot) { this.routeSlots.Add(null); }
            a = this.routeSlots[slot];
            if (a == null) {
                a = new ReqAgg(method, path);
                this.routeSlots[slot] = a;
                this.AddAgg(a);
            }
        } else {
            string key = method + " " + path;
            if (!this.reqIdx.TryGetValue(key, out a)) {
                if (this.reqAgg.Count >= this.reqAggCap) { return; }
                a = new ReqAgg(method, path);
                this.AddAgg(a);
            }
        }
        a.count = a.count + 1;
        a.totalUs = a.totalUs + us;
        if (us > a.maxUs) { a.maxUs = us; }
        if (status >= 500) { a.errors = a.errors + 1; }
        if (status >= 400) { a.failed = a.failed + 1; }
        if (status == 429) { a.rejected = a.rejected + 1; }
    }

    /// <summary>Appends a row to the leaderboard and to the by-name index. The
    /// index keeps the FIRST row registered under a name, which is what the
    /// scan it replaced found. Callers hold the lock.</summary>
    void AddAgg(ReqAgg a) {
        this.reqAgg.Add(a);
        string key = a.method + " " + a.path;
        if (!this.reqIdx.ContainsKey(key)) { this.reqIdx.Add(key, a); }
    }

    /// <summary>True when s is non-empty and every character is a digit; such a
    /// path segment is a record id and is folded to :id for grouping.</summary>
    static bool IsAllDigits(string s) {
        return ServerMetrics.RangeIsDigits(s, 0, s.Length);
    }

    /// <summary>IsAllDigits over a half-open range, so folding a path needs no
    /// substring per segment.</summary>
    static bool RangeIsDigits(string s, int start, int end) {
        if (end <= start) { return false; }
        for (int i = start; i < end; i = i + 1) {
            int c = s[i];
            if (c < 48 || c > 57) { return false; }
        }
        return true;
    }

    /// <summary>Endpoint key for aggregation: "METHOD " plus the folded path.
    /// Only for a caller that has nothing but a raw path -- a routed request is
    /// named by its pattern and never comes through here.</summary>
    static string NormalizePath(string method, string path) {
        return method + " " + ServerMetrics.FoldPath(path);
    }

    /// <summary>The path an aggregate is keyed by when the raw URL is all there
    /// is: the query string dropped and numeric segments folded to :id, so
    /// /admin/users/1 and /admin/users/2 map to the same /admin/users/:id.
    /// </summary>
    static string FoldPath(string path) {
        int n = path.Length;
        int q = 0;
        while (q < n && path[q] != '?') { q = q + 1; }
        StringBuilder outp = new StringBuilder();
        int i = 0;
        bool first = true;
        while (true) {
            int st = i;
            while (i < q && path[i] != '/') { i = i + 1; }
            if (!first) { outp.Append("/"); }
            first = false;
            if (ServerMetrics.RangeIsDigits(path, st, i)) { outp.Append(":id"); }
            else if (i > st) { outp.Append(path.Substring(st, i - st)); }
            if (i >= q) { break; }
            i = i + 1;
        }
        return outp.ToString();
    }

    /// <summary>Records one completed database query. `us` is microseconds.</summary>
    void RecordQuery(string sql, long us) {
        // Normalizing is the expensive part and needs no shared state.
        string norm = ServerMetrics.NormalizeSql(sql);
        if (norm.Length > 200) { norm = norm.Substring(0, 200); }
        lock (this) {
        this.queryCount = this.queryCount + 1;
        this.queryTotalUs = this.queryTotalUs + us;
        if (us > this.queryMaxUs) { this.queryMaxUs = us; }

        int idx = this.SeriesSlot(ServerMetrics.MonoMicros() / 1000000);
        this.sQuery[idx] = this.sQuery[idx] + 1;
        this.sQueryUs[idx] = this.sQueryUs[idx] + us;

        // Normalized once above: literal values and variable-length IN lists
        // collapse to placeholders, so every execution of the same query SHAPE
        // lands on the same leaderboard row regardless of its arguments.
        this.RecordSqlAgg(norm, us);

        if (us >= (long)this.slowQueryMs * 1000) {
            this.slowQueries.Add(new SlowEntry(norm, us));
            if (this.slowQueries.Count > this.ringCap) {
                this.slowQueries.RemoveAt(0);
            }
        }
        }
    }

    /// <summary>Folds one execution into the per-shape aggregate that backs the
    /// slow-SQL leaderboard. Bounded to `sqlAggCap` distinct shapes: once full,
    /// a never-before-seen shape is dropped rather than growing without limit --
    /// a monitor should not become a memory leak under a query it cannot fold.</summary>
    void RecordSqlAgg(string norm, long us) {
        lock (this) {
        SqlAgg a = null;
        if (!this.sqlIdx.TryGetValue(norm, out a)) {
            if (this.sqlAgg.Count >= this.sqlAggCap) { return; }
            a = new SqlAgg(norm);
            this.sqlAgg.Add(a);
            this.sqlIdx.Add(norm, a);
        }
        a.count = a.count + 1;
        a.totalUs = a.totalUs + us;
        if (us > a.maxUs) { a.maxUs = us; }
        }
    }

    /// <summary>Reduces a statement to its "net" form: single-quoted string
    /// literals and numeric literals become `?`, runs of whitespace collapse to
    /// one space, and a comma-separated run of two or more placeholders collapses
    /// to a single `?` -- so `WHERE id IN (1,2,3)` and `WHERE id IN (1,2,3,4,5)`
    /// normalize to the identical `WHERE id IN (?)`.</summary>
    static string NormalizeSql(string sql) {
        StringBuilder sb = new StringBuilder();
        int n = sql.Length;
        int i = 0;
        int holes = 0;
        bool lastSpace = false;
        while (i < n) {
            int c = sql[i];
            if (c == '\'') {
                i = i + 1;
                while (i < n) {
                    if (sql[i] == '\'') {
                        if (i + 1 < n && sql[i + 1] == '\'') {
                            i = i + 2; continue;
                        }
                        i = i + 1; break;
                    }
                    i = i + 1;
                }
                sb.Append("?"); holes = holes + 1; lastSpace = false; continue;
            }
            if (c >= 48 && c <= 57) {
                while (i < n) {
                    int d = sql[i];
                    if ((d >= 48 && d <= 57) || d == '.' || d == 'e'
                        || d == 'E' || d == 'x' || d == 'X') { i = i + 1; }
                    else { break; }
                }
                sb.Append("?"); holes = holes + 1; lastSpace = false; continue;
            }
            if (c == ' ' || c == '\t' || c == '\n' || c == '\r') {
                if (!lastSpace) { sb.Append(" "); lastSpace = true; }
                i = i + 1; continue;
            }
            // A placeholder the caller wrote itself counts as one too: it takes
            // part in the same runs that get collapsed below.
            if (c == '?') {
                sb.Append("?"); holes = holes + 1; lastSpace = false;
                i = i + 1; continue;
            }
            // Everything else is copied verbatim, in runs rather than one
            // character at a time: a statement is mostly plain text, and a
            // substring per character is what made normalizing the dominant
            // cost of recording a query.
            int st = i;
            while (i < n) {
                int d = sql[i];
                if (d == '\'' || d == '?' || (d >= 48 && d <= 57) || d == ' '
                    || d == '\t' || d == '\n' || d == '\r') { break; }
                i = i + 1;
            }
            sb.Append(sql.Substring(st, i - st)); lastSpace = false;
        }
        string flat = sb.ToString();
        // Collapsing can only change a statement that has a run of two
        // placeholders to merge, so a statement with fewer skips the pass.
        if (holes < 2) { return flat.Trim(); }
        return ServerMetrics.CollapsePlaceholders(flat).Trim();
    }

    /// <summary>Collapses a comma-separated run of two or more `?` into one `?`.
    /// A lone placeholder (e.g. `name = ?`) is left untouched so unrelated
    /// columns do not get merged; only genuine value lists shrink.</summary>
    static string CollapsePlaceholders(string s) {
        StringBuilder sb = new StringBuilder();
        int n = s.Length;
        int i = 0;
        while (i < n) {
            if (s[i] == '?') {
                int j = i;
                int cnt = 0;
                bool more = true;
                while (more) {
                    if (j < n && s[j] == '?') {
                        cnt = cnt + 1; j = j + 1;
                        while (j < n && s[j] == ' ') { j = j + 1; }
                        if (j < n && s[j] == ',') {
                            j = j + 1;
                            while (j < n && s[j] == ' ') { j = j + 1; }
                        } else {
                            more = false;
                        }
                    } else {
                        more = false;
                    }
                }
                sb.Append("?");
                if (cnt >= 2) { i = j; } else { i = i + 1; }
                continue;
            }
            int st = i;
            while (i < n && s[i] != '?') { i = i + 1; }
            sb.Append(s.Substring(st, i - st));
        }
        return sb.ToString();
    }

    /// <summary>The leaderboard: up to `limit` normalized statements ranked by
    /// total time spent, most expensive first. A selection scan rather than a
    /// sort -- the shape set is small and bounded, and `limit` is tiny.</summary>
    JsonValue TopSqlJson(int limit) {
        JsonValue outp = JsonValue.NewArray();
        List<SqlAgg> pool = new List<SqlAgg>();
        lock (this) {
            for (int k = 0; k < this.sqlAgg.Count; k = k + 1) { pool.Add(this.sqlAgg[k]); }
        }
        while (outp.Count() < limit && pool.Count > 0) {
            int best = 0;
            for (int k = 1; k < pool.Count; k = k + 1) {
                if (pool[k].totalUs > pool[best].totalUs) { best = k; }
            }
            SqlAgg a = pool[best];
            JsonValue d = JsonValue.NewObject();
            d.Put("sql", ServerMetrics.DocStr(a.sql));
            d.Put("count", ServerMetrics.DocNum(a.count));
            d.Put("total_us", ServerMetrics.DocNum(a.totalUs));
            d.Put("avg_us", ServerMetrics.DocNum(a.count > 0 ? a.totalUs / a.count : 0));
            d.Put("max_us", ServerMetrics.DocNum(a.maxUs));
            outp.Append(d);
            pool.RemoveAt(best);
        }
        return outp;
    }

    /// <summary>The request leaderboard: endpoints ranked by total time served,
    /// highest first, capped at `limit` rows. Selection-sort over a copied pool
    /// (the list is tiny and this avoids mutating the live aggregates).</summary>
    JsonValue TopReqJson(int limit) {
        JsonValue outp = JsonValue.NewArray();
        List<ReqAgg> pool = new List<ReqAgg>();
        lock (this) {
            for (int k = 0; k < this.reqAgg.Count; k = k + 1) {
                pool.Add(this.reqAgg[k]);
            }
        }
        while (outp.Count() < limit && pool.Count > 0) {
            int best = 0;
            for (int k = 1; k < pool.Count; k = k + 1) {
                if (pool[k].totalUs > pool[best].totalUs) { best = k; }
            }
            ReqAgg a = pool[best];
            JsonValue d = JsonValue.NewObject();
            // Verb and endpoint as their own fields (what a table shows and a
            // history row stores), plus the joined form the shape has always
            // carried so a reader written against it keeps working.
            d.Put("req", ServerMetrics.DocStr(a.req));
            d.Put("method", ServerMetrics.DocStr(a.method));
            d.Put("path", ServerMetrics.DocStr(a.path));
            d.Put("count", ServerMetrics.DocNum(a.count));
            d.Put("total_us", ServerMetrics.DocNum(a.totalUs));
            d.Put("avg_us", ServerMetrics.DocNum(a.count > 0 ? a.totalUs / a.count : 0));
            d.Put("max_us", ServerMetrics.DocNum(a.maxUs));
            d.Put("errors", ServerMetrics.DocNum(a.errors));
            d.Put("failed", ServerMetrics.DocNum(a.failed));
            d.Put("rejected", ServerMetrics.DocNum(a.rejected));
            outp.Append(d);
            pool.RemoveAt(best);
        }
        return outp;
    }

    /// 慢请求 ring 的 JSON 数组（{"req","us"}），按记录先后排列。
    JsonValue SlowReqJson() {
        JsonValue outp = JsonValue.NewArray();
        lock (this) {
            foreach (SlowEntry e in this.slowReqs) {
                JsonValue o = JsonValue.NewObject();
                o.Put("req", ServerMetrics.DocStr(e.text));
                o.Put("us", ServerMetrics.DocNum(e.us));
                outp.Append(o);
            }
        }
        return outp;
    }

    /// 慢查询 ring 的 JSON 数组（{"sql","us"}），按记录先后排列。
    JsonValue SlowQueryJson() {
        JsonValue outp = JsonValue.NewArray();
        lock (this) {
            foreach (SlowEntry e in this.slowQueries) {
                JsonValue o = JsonValue.NewObject();
                o.Put("sql", ServerMetrics.DocStr(e.text));
                o.Put("us", ServerMetrics.DocNum(e.us));
                outp.Append(o);
            }
        }
        return outp;
    }

    /// <summary>Estimated latency percentile (0-100) for one bucket, read off
    /// the fixed histogram: the upper edge of the bin the rank falls in, which
    /// is an upper bound on the true value rather than an interpolation that
    /// would read more precise than the data is.</summary>
    long SeriesPercentile(int idx, int pct) {
        int hbase = idx * ServerMetrics.HIST_BINS;
        long total = 0;
        for (int b = 0; b < ServerMetrics.HIST_BINS; b = b + 1) {
            total = total + this.sHist[hbase + b];
        }
        if (total == 0) { return 0; }
        // Rank rounded UP: the 95th percentile of three samples is the third
        // one, not the second, and rounding down would report the fast case as
        // the tail.
        long want = (total * (long)pct + 99) / 100;
        if (want < 1) { want = 1; }
        if (want > total) { want = total; }
        long seen = 0;
        for (int b = 0; b < ServerMetrics.HIST_BINS; b = b + 1) {
            seen = seen + this.sHist[hbase + b];
            if (seen >= want) {
                if (b == ServerMetrics.HIST_BINS - 1) { return this.sMaxUs[idx]; }
                long edge = ServerMetrics.HistEdge(b);
                // The bin's upper edge can exceed everything actually observed;
                // reporting a p95 above the maximum would be nonsense on a chart.
                if (edge > this.sMaxUs[idx]) { return this.sMaxUs[idx]; }
                return edge;
            }
        }
        return this.sMaxUs[idx];
    }

    /// <summary>The last `seconds` one-second buckets as JSON, oldest first, for
    /// plotting. Every second in the window is present: a second with no traffic
    /// is a real zero on the chart, not a missing point that would stretch the
    /// line across the gap. CPU/RSS carry the last known sample forward, since a
    /// process that served nothing still occupies memory.
    ///
    /// The series is per PROCESS, like every other counter here: with several
    /// workers each answers for the requests it served.</summary>
    string SeriesJson(int seconds) {
        lock (this) {
        int want = seconds;
        if (want <= 0) { want = 60; }
        if (want > this.seriesCap) { want = this.seriesCap; }

        long now = ServerMetrics.MonoMicros() / 1000000;
        long from = now - (long)want + 1;
        // The clock here is monotonic, so it starts at zero: in the first
        // `want` seconds of a process the window would reach before the first
        // sample, `sec % seriesCap` would go negative and index the ring out
        // of bounds. Clamp to the real start and shrink the count to match.
        if (from < 0) { from = 0; }
        if (now < 0) { now = 0; }
        want = (int)(now - from + 1);
        int lastCpu = 0 - 1;
        long lastRss = 0 - 1;

        StringBuilder sb = new StringBuilder();
        sb.Append("{\"step_ms\":1000,\"count\":");
        sb.Append(Convert.ToString(want));
        sb.Append(",\"points\":[");
        for (long sec = from; sec <= now; sec = sec + 1) {
            if (sec > from) { sb.Append(","); }
            int idx = (int)(sec % (long)this.seriesCap);
            bool live = this.sSec[idx] == sec;
            long req = 0;
            long err = 0;
            long avg = 0;
            long p95 = 0;
            long max = 0;
            long q = 0;
            long qavg = 0;
            if (live) {
                req = this.sReq[idx];
                err = this.sErr[idx];
                if (this.sReq[idx] > 0) { avg = this.sTotalUs[idx] / this.sReq[idx]; }
                p95 = this.SeriesPercentile(idx, 95);
                max = this.sMaxUs[idx];
                q = this.sQuery[idx];
                if (this.sQuery[idx] > 0) { qavg = this.sQueryUs[idx] / this.sQuery[idx]; }
                if (this.sCpu[idx] >= 0) { lastCpu = this.sCpu[idx]; }
                if (this.sRss[idx] >= 0) { lastRss = this.sRss[idx]; }
            }
            sb.Append("{\"t\":");
            sb.Append(Convert.ToString(sec - now));      // seconds ago, 0 = now
            sb.Append(",\"req\":");
            sb.Append(Convert.ToString(req));
            sb.Append(",\"err\":");
            sb.Append(Convert.ToString(err));
            sb.Append(",\"avg_us\":");
            sb.Append(Convert.ToString(avg));
            sb.Append(",\"p95_us\":");
            sb.Append(Convert.ToString(p95));
            sb.Append(",\"max_us\":");
            sb.Append(Convert.ToString(max));
            sb.Append(",\"queries\":");
            sb.Append(Convert.ToString(q));
            sb.Append(",\"query_avg_us\":");
            sb.Append(Convert.ToString(qavg));
            sb.Append(",\"cpu_percent\":");
            sb.Append(Convert.ToString(lastCpu));
            sb.Append(",\"mem_rss_bytes\":");
            sb.Append(Convert.ToString(lastRss));
            sb.Append("}");
        }
        sb.Append("]}");
        return sb.ToString();
        }
    }

    /// <summary>Full metrics snapshot as JSON. Recomputes CPU% from the delta
    /// since the previous snapshot, so poll it on a fixed interval for a
    /// meaningful "cpu_percent".</summary>
    /// JsonValue leaf builders for the snapshot (number text goes through
    /// Convert.ToString, exactly like the generated __JsonBind tree writers).
    /// The shortest interval a CPU percentage may be computed over.
    static int CpuWindowMs = 200;

    /// 以十进制文本构造 JSON 数值叶子。
    static JsonValue DocNum(long v) { return JsonValue.NewNum(Convert.ToString(v)); }
    /// 构造 JSON 字符串叶子；null 映射为 JSON null。
    static JsonValue DocStr(string s) {
        if (s == null) { return JsonValue.NewNull(); }
        return JsonValue.NewStr(s);
    }

    string SnapshotJson() {
        lock (this) {
        long nowWall = ServerMetrics.MonoMillis();
        long cpuMs = ServerMetrics.CpuMillis();
        long uptime = nowWall - this.startMillis;

        // CPU% is the delta between two samples, so it needs an interval to
        // divide by. Two snapshots taken back to back -- a worker publishing
        // its row and the read that immediately follows it -- are the same
        // millisecond apart, and dividing by that reported "n/a" (or a wild
        // percentage) for the caller that asked last. Under CpuWindowMs the
        // previous measurement is repeated and the baseline is left alone, so
        // the next call still has a window to measure over.
        long cpuPct = this.lastCpuPct;
        if (cpuMs >= 0) {
            long dWall = nowWall - this.lastWallMs;
            if (dWall >= (long)ServerMetrics.CpuWindowMs) {
                cpuPct = ((cpuMs - this.lastCpuMs) * 100) / dWall;
                this.lastWallMs = nowWall;
                this.lastCpuMs = cpuMs;
                this.lastCpuPct = cpuPct;
            }
        }

        long reqAvg = 0;
        if (this.reqCount > 0) { reqAvg = this.reqTotalUs / this.reqCount; }
        long qAvg = 0;
        if (this.queryCount > 0) { qAvg = this.queryTotalUs / this.queryCount; }

        JsonValue requests = JsonValue.NewObject();
        requests.Put("count", ServerMetrics.DocNum(this.reqCount));
        requests.Put("errors", ServerMetrics.DocNum(this.reqErrors));
        requests.Put("failed", ServerMetrics.DocNum(this.reqFailed));
        requests.Put("rejected", ServerMetrics.DocNum(this.reqRejected));
        requests.Put("unmatched", ServerMetrics.DocNum(this.reqUnmatched));
        requests.Put("total_us", ServerMetrics.DocNum(this.reqTotalUs));
        requests.Put("avg_us", ServerMetrics.DocNum(reqAvg));
        requests.Put("max_us", ServerMetrics.DocNum(this.reqMaxUs));
        requests.Put("slow_threshold_us",
            ServerMetrics.DocNum((long)this.slowReqMs * 1000));
        requests.Put("slow_count", ServerMetrics.DocNum(this.slowReqs.Count));

        JsonValue queries = JsonValue.NewObject();
        queries.Put("count", ServerMetrics.DocNum(this.queryCount));
        queries.Put("total_us", ServerMetrics.DocNum(this.queryTotalUs));
        queries.Put("avg_us", ServerMetrics.DocNum(qAvg));
        queries.Put("max_us", ServerMetrics.DocNum(this.queryMaxUs));
        queries.Put("slow_threshold_us",
            ServerMetrics.DocNum((long)this.slowQueryMs * 1000));
        queries.Put("slow_count", ServerMetrics.DocNum(this.slowQueries.Count));

        JsonValue load = JsonValue.NewObject();
        load.Put("concurrent", ServerMetrics.DocNum(this.concurrent));
        load.Put("peak", ServerMetrics.DocNum(this.concurrentPeak));
        load.Put("streams", ServerMetrics.DocNum(this.streams));
        load.Put("stream_frames", ServerMetrics.DocNum(this.streamFrames));
        load.Put("stream_bytes", ServerMetrics.DocNum(this.streamBytes));

        JsonValue o = JsonValue.NewObject();
        o.Put("uptime_ms", ServerMetrics.DocNum(uptime));
        o.Put("pid", ServerMetrics.DocNum(ProcessHost.Pid()));
        o.Put("worker_id", ServerMetrics.DocNum(ProcessHost.WorkerId()));
        o.Put("cpu_ms", ServerMetrics.DocNum(cpuMs));
        o.Put("cpu_percent", ServerMetrics.DocNum(cpuPct));
        o.Put("mem_rss_bytes", ServerMetrics.DocNum(ServerMetrics.MemoryRssBytes()));
        o.Put("requests", requests);
        o.Put("queries", queries);
        o.Put("load", load);
        o.Put("slow_requests", this.SlowReqJson());
        o.Put("slow_queries", this.SlowQueryJson());
        o.Put("top_sql", this.TopSqlJson(20));
        o.Put("top_requests", this.TopReqJson(20));
        return o.ToJson();
        }
    }
}
