    // 打开进程管道。
    private static nint PipeOpen(string cmd, string mode) {
        return plat_popen(cmd, mode);
    }

    // 关闭进程管道。
    private static int PipeClose(nint fp) {
        return plat_pclose(fp);
    }

    // 打开一个持久交互式 shell 会话，其 stdin 即此管道。
    // stdout/stderr 重定向请写在 `cmd` 里（管道只
    // 负责喂入输入），例如 Windows 上 `cmd /q /k >>"session.log" 2>&1`
    // 或 POSIX 上 `sh >>"session.log" 2>&1`，再流式读取日志文件
    // 以获取输出。返回供 ShellSend/ShellClose 使用的管道句柄，出错时为 0。
    // 安全提示：命令及发送的每一行都会经系统 shell 执行。
    public static nint ShellOpen(string cmd) {
        return plat_popen(cmd, "w");
    }

    // 向交互式 shell 会话发送一条命令行。
    public static void ShellSend(nint fp, string line) {
        if (fp == 0) { return; }
        fputs(line, fp);
        fputs("\n", fp);
        fflush(fp);
    }

    // 关闭交互式 shell 会话（发送 EOF 并等待）。
    public static int ShellClose(nint fp) {
        if (fp == 0) { return 0 - 1; }
        return plat_pclose(fp);
    }

    // 从 8 字节缓冲区读取小端句柄/指针（平台中立；Windows 读
    // PROCESS_INFORMATION，POSIX 读 CaptureSafe 的指针出参）。
    private static nint WinHandleAt(byte[] pi, int off) {
        nint h = 0;
        nint mul = 1;
        for (int k = 0; k < 8; k = k + 1) {
            h = h + (pi[off + k] & 255) * mul;
            mul = mul * 256;
        }
        return h;
    }

    #if WINDOWS

    // 把 8 字节小端 HANDLE 写入结构体缓冲区。
    private static void WinPutHandle(byte[] buf, int off, nint h) {
        nint v = h;
        for (int k = 0; k < 8; k = k + 1) {
            buf[off + k] = (byte)(v % 256);
            v = v / 256;
        }
    }

    // 把 32 位整数按小端写入缓冲区（STARTUPINFO/SECURITY_ATTRIBUTES 字段用）。
    private static void WinPutInt(byte[] buf, int off, int v) {
        buf[off] = (byte)(v & 255);
        buf[off + 1] = (byte)((v >> 8) & 255);
        buf[off + 2] = (byte)((v >> 16) & 255);
        buf[off + 3] = (byte)((v >> 24) & 255);
    }

    // 通过 cmd.exe 启动 `command`，不显示控制台窗口。当 `waitFor`
    // 为 true 时，等待完成并返回子进程退出码；否则
    // 启动成功返回 0（启动失败返回 -1）。
    private static int WinSpawn(string command, bool waitFor) {
        string cmdline = "cmd.exe /c " + command;
        byte[] si = new byte[128];
        si[0] = 104;                        // STARTUPINFOA.cb = sizeof(STARTUPINFOA)
        byte[] pi = new byte[32];
        int CREATE_NO_WINDOW = 134217728;   // 0x08000000
        nint wcmd = Wide.Of(cmdline);
        int ok = WinCreateProcess(0, wcmd, 0, 0, 0, CREATE_NO_WINDOW, 0, 0, si, pi);
        Wide.Free(wcmd);
        int code = 0 - 1;
        if (ok != 0) {
            nint hProc = WinHandleAt(pi, 0);
            nint hThread = WinHandleAt(pi, 8);
            code = 0;
            if (waitFor) {
                WinWaitForSingleObject(hProc, 0 - 1);   // INFINITE
                byte[] cb = new byte[8];
                WinGetExitCodeProcess(hProc, cb);
                code = cb[0] + cb[1] * 256 + cb[2] * 65536 + cb[3] * 16777216;
            }
            WinCloseHandle(hProc);
            WinCloseHandle(hThread);
        }
        return code;
    }

    // 读取捕获文件，将输出编码规范化为 UTF-8：
    // - UTF-16LE（BOM FF FE）直接转换；
    // - 其他情况从系统 ANSI 代码页转换
    // （中文系统上的 sc.exe / schtasks.exe 输出 GBK）。
    // 控制台工具按连接对象选择编码，因此
    // 单独采用任一假设都不安全；由 BOM 来消除歧义。
    private static string WinReadText(string path) {
        nint fp = plat_fopen(path, "rb");
        if (fp == 0) { return ""; }
        plat_fseek(fp, 0, 2);
        int size = (int)plat_ftell(fp);
        plat_fseek(fp, 0, 0);
        if (size <= 0) {
            plat_fclose(fp);
            return "";
        }
        byte[] raw = new byte[size];
        int got = (int)plat_fread(raw, 1, size, fp);
        plat_fclose(fp);
        if (got < 2) { return got > 0 ? raw.ToStr(0, got) : ""; }
        bool utf16 = raw[0] == 255 && raw[1] == 254;   // BOM FF FE
        int units = utf16 ? (got - 2) / 2 : got * 2 + 2;
        nint wide = NativeMemory.Alloc(units * 2 + 2);
        string s = "";
        try {
            if (utf16) {
                if (units > 0) {
                    NativeMemory.Copy(wide, (nint)raw + 2, units * 2);
                }
                new Span<ushort>(wide + (nint)units * 2, 1)[0] = 0;
            } else {
                // 直接传托管 byte[] 指针，零拷贝零额外 NativeMemory.Alloc
                int n = Process.WinMultiToWide(0 /*CP_ACP*/, 0, (nint)raw, got, wide, units);
                if (n > 0) { units = n; }
                new Span<ushort>(wide + (nint)units * 2, 1)[0] = 0;
            }
            int need = Process.WinWideToMulti(65001, 0, wide, units, 0, 0, 0, 0);
            if (need <= 0) { need = 1; }
            nint utf8 = NativeMemory.Alloc(need + 1);
            try {
                Process.WinWideToMulti(65001, 0, wide, units, utf8, need + 1, 0, 0);
                s = NativeMemory.GetString(utf8, 0, need);
            } finally {
                NativeMemory.Free(utf8);
            }
        } finally {
            NativeMemory.Free(wide);
        }
        return s;
    }
    #endif

    // 【已淘汰】运行命令并将 stdout+stderr 按行捕获。
    // 存在 Shell 注入与临时文件竞争隐患，请改用 Process.CaptureSafe(exe, args)。
    public static List<string> RunCapture(string cmd) {
        return Process.Capture(cmd).lines;
    }

    // 【已淘汰】运行命令，捕获 stdout+stderr 并保留退出码。
    // 存在 Shell 注入隐患且在 Windows 上依赖临时文件重定向，请改用 Process.CaptureSafe(exe, args)。
    public static ProcessResult Capture(string cmd) {
        ProcessResult r = new ProcessResult();
        #if WINDOWS
        string tmpDir = Path.GetTempPath();
        int tick = WinGetTickCount();
        int pid = WinGetCurrentProcessId();
        string tmp = tmpDir + "zan_cap_" + pid + "_" + tick + ".tmp";
        try {
            r.exitCode = WinSpawn("(" + cmd + ") > \"" + tmp + "\" 2>&1", true);
            if (File.Exists(tmp)) {
                r.lines = SplitLines(Process.WinReadText(tmp));
            }
        } finally {
            if (File.Exists(tmp)) {
                File.Delete(tmp);
            }
        }
        if (r.lines == null) { r.lines = new List<string>(); }
        return r;
        #else
        r.lines = new List<string>();
        string full = "(" + cmd + ") 2>&1";
        nint fp = PipeOpen(full, "r");
        if (fp == 0) {
            r.exitCode = 0 - 1;
            r.lines.Add("[error] failed to launch: " + cmd);
            return r;
        }
        StringBuilder sb = new StringBuilder();
        byte[] buf = new byte[4097];
        bool reading = true;
        while (reading) {
            int n = (int)fread(buf, 1, 4096, fp);
            if (n <= 0) {
                reading = false;
            } else {
                sb.Append(new StringView((nint)buf, n));
            }
        }
        int status = PipeClose(fp);
        // wait(2) 的状态字：高 8 位是退出码，低 7 位是终止信号。
        if (status < 0) { r.exitCode = 0 - 1; }
        else if ((status & 127) != 0) { r.exitCode = 128 + (status & 127); }
        else { r.exitCode = (status >> 8) & 255; }
        r.lines = SplitLines(sb.ToString());
        return r;
        #endif
    }

    // 异步运行命令并捕获输出（建议优先改用 CaptureSafeAsync 二进制参数安全启动）。
    public static async Task<List<string>> RunCaptureAsync(string cmd) {
        TaskCompletionSource<List<string>> tcs = new TaskCompletionSource<List<string>>();
        Task.Run(delegate () {
            try {
                tcs.SetResult(Process.RunCapture(cmd));
            } catch (Exception ex) {
                tcs.SetException(ex);
            }
        });
        return await tcs.Task;
    }

    // 【已淘汰】通过系统 shell 运行命令并返回退出码。
    // 阻塞调用线程且存在严重的 Shell 注入风险，请改用 Process.RunSafe(exe, args)。
    public static int Run(string cmd) {
        #if WINDOWS
        return WinSpawn(cmd, true);
        #else
        List<string> shArgs = new List<string>();
        shArgs.Add("-c");
        shArgs.Add(cmd);
        return Process.RunSafe("/bin/sh", shArgs);
        #endif
    }

    // 【已淘汰】通过系统 shell 启动命令但不等待其结束。
    // 存在 Shell 注入风险且会在 Windows 上堆积 cmd.exe/conhost.exe 进程，请改用 Process.StartDetachedSafe(exe, args)。
    public static int RunDetached(string cmd) {
        #if WINDOWS
        return WinSpawn(cmd, false);
        #else
        List<string> shArgs = new List<string>();
        shArgs.Add("-c");
        shArgs.Add(cmd);
        return Process.StartDetachedSafe("/bin/sh", shArgs);
        #endif
    }

    // 直接启动一个程序，不经过 shell，可选把
    // stdout/stderr 追加重定向到 `logPath`（为 "" 时丢弃输出）。
    // 启动成功返回 0，失败返回 -1。POSIX 等最终 exec 成功后才返回，
    // 日志重定向失败也返回 -1；目标退出码（包括 127）不影响启动结果。
    // // 与 <see cref="RunDetached"/> 的区别：不产生 cmd.exe /bin/sh 中间进程。
    // 长期运行的子进程（如 worker）必须用它：`cmd.exe /c app.exe` 会让
    // 每个 worker 多挂一个 cmd.exe 加一个 conhost.exe，在任务管理器里堆成
    // 一片“Windows 命令处理程序 / 控制台窗口主机”，崩溃重启时更甚。
    // 参数不经 shell 解释，因此路径中的空格由本方法自己加引号处理。
    public static int StartProgram(string exe, string logPath) {
        #if WINDOWS
        // STARTUPINFOA(64 位)：cb@0 dwFlags@60 wShowWindow@64
        // hStdInput@80 hStdOutput@88 hStdError@96，共 104 字节。
        byte[] si = new byte[128];
        si[0] = 104;
        byte[] pi = new byte[32];
        int DETACHED_PROCESS = 8;
        int CREATE_NO_WINDOW = 134217728;      // 0x08000000
        int flags = DETACHED_PROCESS;
        nint log = 0;
        // 句柄继承一律开启：调用方（如 Worker 的共享统计表）需要把可继承的
        // 内核对象交给子进程，而这只有在 CreateProcess 的 bInheritHandles 为
        // TRUE 时才发生。只有显式标成可继承的句柄会被传下去，其余不受影响。
        int inherit = 1;
        if (logPath != "") {
            // bInheritHandle=TRUE }：句柄必须可继承，
            // 子进程才能把它当作自己的 stdout。
            byte[] sa = new byte[24];
            WinPutInt(sa, 0, 24);
            WinPutInt(sa, 16, 1);
            // 追加而不是覆盖：只给 FILE_APPEND_DATA（不给 FILE_WRITE_DATA）时
            // 每次写都落到文件末尾，多个子进程（以及本进程的日志写入）可以共写
            // 同一个文件；若用 GENERIC_WRITE，文件指针从 0 开始，后启动的进程
            // 会把先前的内容盖掉。
            int FILE_APPEND_DATA = 4;          // 0x0004
            int SYNCHRONIZE = 1048576;         // 0x00100000
            int access = FILE_APPEND_DATA + SYNCHRONIZE;
            int FILE_SHARE_RW = 3;
            int OPEN_ALWAYS = 4;
            int FILE_ATTRIBUTE_NORMAL = 128;
            nint wlogPath = Wide.Of(logPath);
            log = WinCreateFile(wlogPath, access, FILE_SHARE_RW,
                                sa, OPEN_ALWAYS, FILE_ATTRIBUTE_NORMAL, 0);
            Wide.Free(wlogPath);
            if (log == 0 - 1) { log = 0; }
        }
        if (log != 0) {
            int STARTF_USESTDHANDLES = 256;    // 0x00000100
            WinPutInt(si, 60, STARTF_USESTDHANDLES);
            WinPutHandle(si, 88, log);
            WinPutHandle(si, 96, log);
            inherit = 1;
            // 有重定向就不必给子进程分配控制台，用 CREATE_NO_WINDOW 让
            // 它保持控制台程序语义但没有窗口，也没有多余的 conhost。
            flags = CREATE_NO_WINDOW;
        }
        nint wcmd = Wide.Of("\"" + exe + "\"");
        int ok = WinCreateProcess(0, wcmd, 0, 0, inherit, flags,
                                  0, 0, si, pi);
        Wide.Free(wcmd);
        if (log != 0) { WinCloseHandle(log); }
        if (ok == 0) { return 0 - 1; }
        WinCloseHandle(WinHandleAt(pi, 0));
        WinCloseHandle(WinHandleAt(pi, 8));
        return 0;
        #else
        return PlatProcStartProgramSafe(exe, logPath);
        #endif
    }

    // 安全转义单个命令行参数，防止参数被拆分或注入（符合 Windows 命令行解析规则）。
    public static string QuoteArg(string arg) {
        if (arg == null || arg.Length == 0) { return "\"\""; }
        bool needQuotes = false;
        int len = arg.Length;
        for (int i = 0; i < len; i = i + 1) {
            int c = arg[i] & 255;
            if (c == 32 || c == 9 || c == 34 || c == 10 || c == 13) { // space, tab, quote, newline
                needQuotes = true;
                break;
            }
        }
        if (!needQuotes) { return arg; }
        StringBuilder sb = new StringBuilder();
        sb.Append("\"");
        int backslashes = 0;
        int segStart = 0;
        for (int i = 0; i < len; i = i + 1) {
            int c = arg[i] & 255;
            if (c == 92) { // '\\'
                if (i > segStart) { sb.Append(arg.Substring(segStart, i - segStart)); }
                backslashes = backslashes + 1;
                segStart = i + 1;
            } else if (c == 34) { // '\"'
                if (i > segStart) { sb.Append(arg.Substring(segStart, i - segStart)); }
                for (int b = 0; b < backslashes * 2 + 1; b = b + 1) {
                    sb.Append("\\");
                }
                sb.Append("\"");
                backslashes = 0;
                segStart = i + 1;
            } else if (backslashes > 0) {
                for (int b = 0; b < backslashes; b = b + 1) {
                    sb.Append("\\");
                }
                backslashes = 0;
                segStart = i;
            }
        }
        if (len > segStart) { sb.Append(arg.Substring(segStart, len - segStart)); }
        for (int b = 0; b < backslashes * 2; b = b + 1) {
            sb.Append("\\");
        }
        sb.Append("\"");
        return sb.ToString();
    }

    // 将命令行程序路径与安全参数数组构造为规范的 Windows 命令行。
    public static string BuildCommandLine(string exe, List<string> args) {
        StringBuilder sb = new StringBuilder();
        sb.Append(QuoteArg(exe));
        if (args != null) {
            for (int i = 0; i < args.Count; i = i + 1) {
                sb.Append(" ");
                sb.Append(QuoteArg(args[i]));
            }
        }
        return sb.ToString();
    }

    // 直接执行指定的程序及参数数组，不经过 shell，安全无命令注入风险。
    public static int RunSafe(string exe, List<string> args) {
        return Process.RunSafe(exe, args, 0 - 1);
    }

    /// Execute an argument vector and preserve stdin, stdout and stderr independently.
    public static int RunWithStandardStreams(string exe, List<string> args) {
        #if WINDOWS
        return RunWindows(exe, args, 0 - 1, true);
        #else
        return RunSafe(exe, args);
        #endif
    }

    #if WINDOWS
    private static int StartWindows(string exe, List<string> args, byte[] pi, bool inheritStreams) {
        byte[] si = new byte[128];
        si[0] = 104;
        int flags = 134217728; // CREATE_NO_WINDOW
        int inherit = 0;
        try {
            if (inheritStreams) {
                WinPutInt(si, 60, 256); // STARTF_USESTDHANDLES
                inherit = 1;
                if (WinGetConsoleCP() != 0) { flags = 0; }
                byte[] duplicate = new byte[8];
                nint currentProcess = 0 - 1;
                for (int stream = 0; stream < 3; stream++) {
                    nint handle = WinGetStdHandle(0 - 10 - stream);
                    if (handle == 0 || handle == 0 - 1) { continue; }
                    if (WinDuplicateHandle(currentProcess, handle, currentProcess,
                                           duplicate, 0, 1, 2) == 0) { return 0; }
                    WinPutHandle(si, 80 + stream * 8, WinHandleAt(duplicate, 0));
                }
            }
            nint command = Wide.Of(BuildCommandLine(exe, args));
            int ok = WinCreateProcess(0, command, 0, 0, inherit, flags, 0, 0, si, pi);
            Wide.Free(command);
            return ok;
        } finally {
            if (inheritStreams) {
                for (int stream = 0; stream < 3; stream++) {
                    nint handle = WinHandleAt(si, 80 + stream * 8);
                    if (handle != 0) { WinCloseHandle(handle); }
                }
            }
        }
    }

    private static int RunWindows(string exe, List<string> args, int timeoutMs, bool inheritStreams) {
        byte[] pi = new byte[32];
        if (StartWindows(exe, args, pi, inheritStreams) == 0) { return 0 - 1; }
        nint hProc = WinHandleAt(pi, 0);
        nint hThread = WinHandleAt(pi, 8);
        try {
            int waitMs = timeoutMs > 0 ? timeoutMs : (0 - 1);
            int waitRes = WinWaitForSingleObject(hProc, waitMs);
            if (waitRes == 258) { // WAIT_TIMEOUT = 258 (0x102)
                WinTerminateProcess(hProc, 1);
                WinWaitForSingleObject(hProc, 5000);
                return 0 - 1;
            }
            byte[] cb = new byte[8];
            WinGetExitCodeProcess(hProc, cb);
            int code = cb[0] + cb[1] * 256 + cb[2] * 65536 + cb[3] * 16777216;
            return code;
        } finally {
            WinCloseHandle(hProc);
            WinCloseHandle(hThread);
        }
    }
    #endif

    // 支持超时限制的 RunSafe（timeoutMs <= 0 表示无限等待；超时主动终止子进程防止宿主挂死）。
    public static int RunSafe(string exe, List<string> args, int timeoutMs) {
        #if WINDOWS
        return RunWindows(exe, args, timeoutMs, false);
        #elif WASM32
        return 0 - 1;
        #else
        int argc = args != null ? args.Count : 0;
        nint argv = 0;
        int code = 0;
        try {
            if (argc > 0) {
                argv = NativeMemory.Alloc(argc * 8);
                Span<nint> av = new Span<nint>(argv, argc);
                for (int i = 0; i < argc; i = i + 1) {
                    string a = args[i];
                    int blen = a.Length;
                    nint abuf = NativeMemory.Alloc(blen + 1);
                    NativeMemory.PutString(abuf, 0, a, blen);
                    av[i] = abuf;
                }
            }
            code = PlatProcRunSafeTimeout(exe, argv, argc, timeoutMs);
        } finally {
            if (argv != 0) {
                Span<nint> av = new Span<nint>(argv, argc);
                for (int i = 0; i < argc; i = i + 1) {
                    if (av[i] != 0) { NativeMemory.Free(av[i]); }
                }
                NativeMemory.Free(argv);
            }
        }
        return code;
        #endif
    }

    // 独立启动外部进程（不等待其退出，不阻塞当前线程，不经过 shell，安全无注入）。
    public static int StartDetachedSafe(string exe, List<string> args) {
        #if WINDOWS
        string cmdline = BuildCommandLine(exe, args);
        byte[] si = new byte[128];
        si[0] = 104;
        byte[] pi = new byte[32];
        int CREATE_NO_WINDOW = 134217728;
        int DETACHED_PROCESS = 8;
        nint wcmd = Wide.Of(cmdline);
        int ok = WinCreateProcess(0, wcmd, 0, 0, 0, CREATE_NO_WINDOW | DETACHED_PROCESS, 0, 0, si, pi);
        Wide.Free(wcmd);
        if (ok == 0) { return 0 - 1; }
        nint hProc = WinHandleAt(pi, 0);
        nint hThread = WinHandleAt(pi, 8);
        WinCloseHandle(hProc);
        WinCloseHandle(hThread);
        return 0;
        #else
        int argc = args != null ? args.Count : 0;
        nint argv = 0;
        if (argc > 0) {
            argv = NativeMemory.Alloc(argc * 8);
            Span<nint> av = new Span<nint>(argv, argc);
            for (int i = 0; i < argc; i = i + 1) {
                string a = args[i];
                int blen = a.Length;
                nint abuf = NativeMemory.Alloc(blen + 1);
                NativeMemory.PutString(abuf, 0, a, blen);
                av[i] = abuf;
            }
        }
        int code = PlatProcStartDetachedSafe(exe, argv, argc);
        if (argv != 0) {
            Span<nint> av = new Span<nint>(argv, argc);
            for (int i = 0; i < argc; i = i + 1) {
                if (av[i] != 0) { NativeMemory.Free(av[i]); }
            }
            NativeMemory.Free(argv);
        }
        return code;
        #endif
    }

    // 通过直接进程管道启动程序并捕获 stdout/stderr 输出（不经过 shell，绝对安全）。
    public static ProcessResult CaptureSafe(string exe, List<string> args) {
        return Process.CaptureSafe(exe, args, 0 - 1);
    }

    // timeoutMs <= 0（默认 -1）无限等待；正值限制启动、读输出及等待退出的总时间。
    // 超时返回 exitCode=-1，终止并回收直接子进程，保留已读取和当时已缓冲的输出。
    // 不等待仍持有输出管道的后代进程；本方法不承诺终止整个进程树。
    public static ProcessResult CaptureSafe(string exe, List<string> args, int timeoutMs) {
        ProcessResult r = new ProcessResult();
        r.lines = new List<string>();
        #if WINDOWS
        long deadline = timeoutMs > 0 ? Stopwatch.GetMilliseconds() + timeoutMs : 0;
        byte[] sa = new byte[24];
        WinPutInt(sa, 0, 24);
        WinPutInt(sa, 16, 1); // bInheritHandle = TRUE
        byte[] hRead = new byte[8];
        byte[] hWrite = new byte[8];
        if (WinCreatePipe(hRead, hWrite, sa, 0) == 0) {
            r.exitCode = 0 - 1;
            return r;
        }
        nint hReadPipe = WinHandleAt(hRead, 0);
        nint hWritePipe = WinHandleAt(hWrite, 0);
        int HANDLE_FLAG_INHERIT = 1;
        if (WinSetHandleInformation(hReadPipe, HANDLE_FLAG_INHERIT, 0) == 0) {
            WinCloseHandle(hReadPipe);
            WinCloseHandle(hWritePipe);
            r.exitCode = 0 - 1;
            return r;
        }

        byte[] si = new byte[128];
        si[0] = 104;
        int STARTF_USESTDHANDLES = 256;
        WinPutInt(si, 60, STARTF_USESTDHANDLES);
        WinPutHandle(si, 88, hWritePipe); // hStdOutput
        WinPutHandle(si, 96, hWritePipe); // hStdError

        byte[] pi = new byte[32];
        int CREATE_NO_WINDOW = 134217728;
        string cmdline = BuildCommandLine(exe, args);
        nint wcmd = Wide.Of(cmdline);
        int ok = WinCreateProcess(0, wcmd, 0, 0, 1, CREATE_NO_WINDOW, 0, 0, si, pi);
        Wide.Free(wcmd);
        WinCloseHandle(hWritePipe);

        if (ok == 0) {
            WinCloseHandle(hReadPipe);
            r.exitCode = 0 - 1;
            return r;
        }

        nint hProc = WinHandleAt(pi, 0);
        nint hThread = WinHandleAt(pi, 8);
        try {
            StringBuilder sb = new StringBuilder();
            byte[] readBuf = new byte[4096];
            byte[] numRead = new byte[8];
            byte[] available = new byte[4];
            bool pipeOpen = true;
            bool failed = false;
            for (;;) {
                if (deadline > 0 && Stopwatch.GetMilliseconds() >= deadline) {
                    failed = true;
                    break;
                }
                int waitRes = WinWaitForSingleObject(hProc, 0);
                if (waitRes != 0 && waitRes != 258) { failed = true; break; }
                int ready = 0;
                if (pipeOpen) {
                    if (WinPeekNamedPipe(hReadPipe, 0, 0, 0, available, 0) == 0) {
                        if (WinGetLastError() == 109) { pipeOpen = false; } // ERROR_BROKEN_PIPE
                        else { failed = true; break; }
                    } else {
                        ready = available[0] + available[1] * 256 + available[2] * 65536 + available[3] * 16777216;
                    }
                }
                if (ready > 0) {
                    int count = ready < 4096 ? ready : 4096;
                    int readOk = WinReadFile(hReadPipe, readBuf, count, numRead, 0);
                    int got = numRead[0] + numRead[1] * 256 + numRead[2] * 65536 + numRead[3] * 16777216;
                    if (readOk == 0 || got <= 0) { failed = true; break; }
                    sb.Append(readBuf.ToStr(0, got));
                    // Check the clock after every chunk, including continuous output.
                    continue;
                }
                if (waitRes == 0 && !pipeOpen) { break; }
                int pauseMs = 10;
                if (deadline > 0) {
                    long left = deadline - Stopwatch.GetMilliseconds();
                    if (left <= 0) { continue; }
                    if (left < pauseMs) { pauseMs = (int)left; }
                }
                if (waitRes == 258) { WinWaitForSingleObject(hProc, pauseMs); }
                else { Thread.Sleep(pauseMs); } // A descendant still owns the writer.
            }
            r.exitCode = 0 - 1;
            if (failed) {
                if (WinWaitForSingleObject(hProc, 0) == 258) {
                    if (WinTerminateProcess(hProc, 1) != 0) {
                        WinWaitForSingleObject(hProc, 0 - 1);
                    }
                }
                // Drain a snapshot only; a descendant must not extend this deadline.
                if (pipeOpen && WinPeekNamedPipe(hReadPipe, 0, 0, 0, available, 0) != 0) {
                    int pending = available[0] + available[1] * 256 + available[2] * 65536 + available[3] * 16777216;
                    while (pending > 0) {
                        int count = pending < 4096 ? pending : 4096;
                        int readOk = WinReadFile(hReadPipe, readBuf, count, numRead, 0);
                        int got = numRead[0] + numRead[1] * 256 + numRead[2] * 65536 + numRead[3] * 16777216;
                        if (readOk == 0 || got <= 0) { break; }
                        sb.Append(readBuf.ToStr(0, got));
                        pending = pending - got;
                    }
                }
            } else {
                byte[] cb = new byte[8];
                if (WinGetExitCodeProcess(hProc, cb) != 0) {
                    r.exitCode = cb[0] + cb[1] * 256 + cb[2] * 65536 + cb[3] * 16777216;
                }
            }
            r.lines = SplitLines(sb.ToString());
            return r;
        } finally {
            // Also cover exceptions while building the captured text.
            if (WinWaitForSingleObject(hProc, 0) == 258) {
                if (WinTerminateProcess(hProc, 1) != 0) {
                    WinWaitForSingleObject(hProc, 0 - 1);
                }
            }
            WinCloseHandle(hReadPipe);
            WinCloseHandle(hProc);
            WinCloseHandle(hThread);
        }
        #else
        int argc = args != null ? args.Count : 0;
        nint argv = 0;
        byte[] outBuf = new byte[8];
        byte[] outLen = new byte[4];
        byte[] exitCode = new byte[4];
        int ret = 0;
        try {
            if (argc > 0) {
                argv = NativeMemory.Alloc(argc * 8);
                Span<nint> av = new Span<nint>(argv, argc);
                for (int i = 0; i < argc; i = i + 1) {
                    string a = args[i];
                    int blen = a.Length;
                    nint abuf = NativeMemory.Alloc(blen + 1);
                    NativeMemory.PutString(abuf, 0, a, blen);
                    av[i] = abuf;
                }
            }
            #if WASM32
            ret = PlatProcCaptureSafe(exe, argv, argc, outBuf, outLen, exitCode);
            #else
            ret = PlatProcCaptureSafeTimeout(exe, argv, argc, outBuf, outLen, exitCode, timeoutMs);
            #endif
        } finally {
            if (argv != 0) {
                Span<nint> av = new Span<nint>(argv, argc);
                for (int i = 0; i < argc; i = i + 1) {
                    if (av[i] != 0) { NativeMemory.Free(av[i]); }
                }
                NativeMemory.Free(argv);
            }
        }
        if (ret == 0) {
            nint pBuf = WinHandleAt(outBuf, 0);
            try {
                int len = outLen[0] + outLen[1] * 256 + outLen[2] * 65536 + outLen[3] * 16777216;
                int code = exitCode[0] + exitCode[1] * 256 + exitCode[2] * 65536 + exitCode[3] * 16777216;
                r.exitCode = code;
                if (pBuf != 0 && len > 0) {
                    string text = NativeMemory.GetString(pBuf, 0, len);
                    r.lines = SplitLines(text);
                }
            } finally {
                if (pBuf != 0) { PlatProcFreeBuf(pBuf); }
            }
        } else {
            r.exitCode = 0 - 1;
        }
        return r;
        #endif
    }

    // 异步安全执行并读取完整输出，纯事件驱动，不占用调用线程，不依赖渲染帧推进。
    public static async Task<ProcessResult> CaptureSafeAsync(string exe, List<string> args) {
        TaskCompletionSource<ProcessResult> tcs = new TaskCompletionSource<ProcessResult>();
        Task.Run(delegate () {
            ProcessResult res = CaptureSafe(exe, args);
            tcs.SetResult(res);
        });
        return await tcs.Task;
    }

    // 按换行符拆分文本。
    public static List<string> SplitLines(string text) {
        List<string> lines = new List<string>();
        if (text == null || text.Length == 0) { return lines; }
        int len = text.Length;
        int start = 0;
        for (int i = 0; i < len; i = i + 1) {
            int c = text[i] & 255;
            if (c == 10) { // '\n'
                int end = i;
                if (end > start && (text[end - 1] & 255) == 13) {
                    end = end - 1;
                }
                lines.Add(text.Substring(start, end - start));
                start = i + 1;
            }
        }
        if (start < len) {
            int end = len;
            if (end > start && (text[end - 1] & 255) == 13) {
                end = end - 1;
            }
            if (end > start) {
                lines.Add(text.Substring(start, end - start));
            }
        }
        return lines;
    }
}

/// 活进程管道句柄集：spawn 后子进程 stdin/stdout 保持接线，父进程可随时
/// 写命令、非阻塞读输出、终止或等待退出。与 CaptureSafe（等子进程死再收
/// 全部输出）互补，本类面向交互式子进程（REPL、长驻工具）及有界作业执行。
/// SpawnManaged 将作业绑定到 Windows Job Object 或 POSIX 进程组。
public class ProcessSpawn {
    nint hProcess;
    nint hThread;
    int pid;
    nint hJob;
    nint sandboxGroup;
    bool jobTerminating;
    bool managed;
    nint stdinWrite;   // 子进程 stdin 的父侧写端（子读端已关）
    nint stdoutRead;   // 子进程 stdout 的父侧读端（子写端已关）
    bool disposed;
    bool closeOk;
    bool exited;
    int exitCode;

    ProcessSpawn(nint process, nint thread, int processId,
            nint inWrite, nint outRead) {
        hProcess = process;
        hThread = thread;
        pid = processId;
        stdinWrite = inWrite;
        stdoutRead = outRead;
        disposed = false;
        exited = false;
        exitCode = 0 - 1;
    }

    #if WINDOWS
    // ---- kernel32：仅本类需要的窄面（部分与 Process 内声明同型） ----
    [DllImport("kernel32", EntryPoint = "CreatePipe")]
    private static extern int WinCreatePipe(byte[] hRead, byte[] hWrite, byte[] sa, int nSize);
    [DllImport("kernel32", EntryPoint = "SetHandleInformation")]
    private static extern int WinSetHandleInformation(nint handle, int mask, int flags);
    [DllImport("kernel32", EntryPoint = "ReadFile")]
    private static extern int WinReadFile(nint handle, byte[] buf, int nBytes, byte[] numRead,
                                  nint overlapped);
    [DllImport("kernel32", EntryPoint = "WriteFile")]
    private static extern int WinWriteFile(nint handle, byte[] buf, int nBytes, byte[] numWritten,
                                   nint overlapped);
    [DllImport("kernel32", EntryPoint = "PeekNamedPipe")]
    private static extern int WinPeekNamedPipe(nint handle, nint buf, int bufSize,
                                       nint numRead, byte[] totalAvail, nint left);
    [DllImport("kernel32", EntryPoint = "CreateProcessW")]
    private static extern int WinCreateProcess(nint appName, nint cmdLine, nint pa, nint ta,
                                       int inherit, int flags, nint env, nint cwd,
                                       byte[] si, byte[] pi);
    [DllImport("kernel32", EntryPoint = "WaitForSingleObject")]
    private static extern int WinWaitForSingleObject(nint handle, int ms);
    [DllImport("kernel32", EntryPoint = "GetExitCodeProcess")]
    private static extern int WinGetExitCodeProcess(nint handle, byte[] code);
    [DllImport("kernel32", EntryPoint = "TerminateProcess")]
    private static extern int WinTerminateProcess(nint handle, int code);
    [DllImport("kernel32", EntryPoint = "CloseHandle")]
    private static extern int WinCloseHandle(nint handle);
    [DllImport("kernel32", EntryPoint = "CreateJobObjectW")]
    private static extern nint WinCreateJobObject(nint attributes, nint name);
    [DllImport("kernel32", EntryPoint = "SetInformationJobObject")]
    private static extern int WinSetJobInformation(nint job, int infoClass, byte[] info, int size);
    [DllImport("kernel32", EntryPoint = "TerminateJobObject")]
    private static extern int WinTerminateJob(nint job, int code);
    [DllImport("kernel32", EntryPoint = "QueryInformationJobObject")]
    private static extern int WinQueryJobInformation(nint job, int infoClass,
        byte[] info, int size, nint returnedSize);
    #elif LINUX || MACOS
    [DllImport("crt", EntryPoint = "zan_proc_spawn_managed")]
    private static extern int PosixSpawnManaged(nint[] argv, string cwd, int[] fds);
    [DllImport("crt", EntryPoint = "zan_proc_spawn_managed_kill")]
    private static extern int PosixKillManaged(int pid);
    [DllImport("crt", EntryPoint = "zan_proc_spawn_managed_wait")]
    private static extern int PosixWaitManaged(int pid, int timeoutMs);
    [DllImport("crt", EntryPoint = "zan_proc_spawn_managed_dispose")]
    private static extern int PosixDisposeManaged(int pid, int stdinFd, int stdoutFd);
    [DllImport("crt", EntryPoint = "zan_proc_sandbox_available")]
    private static extern int PosixSandboxAvailable(string cgroupRoot);
    [DllImport("crt", EntryPoint = "zan_proc_spawn_sandboxed")]
    private static extern int PosixSpawnSandboxed(nint[] argv, string cwd,
        string readRoots, string writeRoot, string cgroupRoot, int[] fds, nint[] group);
    [DllImport("crt", EntryPoint = "zan_proc_sandbox_kill")]
    private static extern int PosixSandboxKill(nint group);
    [DllImport("crt", EntryPoint = "zan_proc_sandbox_wait")]
    private static extern int PosixSandboxWait(int pid, int timeoutMs, nint group);
    [DllImport("crt", EntryPoint = "zan_proc_sandbox_dispose")]
    private static extern int PosixSandboxDispose(nint group, int pid, int stdinFd, int stdoutFd);
    [DllImport("crt", EntryPoint = "zan_proc_spawn")]
    private static extern int PosixSpawn(nint[] argv, string cwd, int[] fds);
    [DllImport("crt", EntryPoint = "zan_proc_spawn_available")]
    private static extern int PosixAvailable(int fd);
    [DllImport("crt", EntryPoint = "zan_proc_spawn_read")]
    private static extern int PosixRead(int fd, byte[] buf, int count);
    [DllImport("crt", EntryPoint = "zan_proc_spawn_write")]
    private static extern int PosixWrite(int fd, byte[] buf, int count);
    [DllImport("crt", EntryPoint = "zan_proc_spawn_kill")]
    private static extern int PosixKill(int pid);
    [DllImport("crt", EntryPoint = "zan_proc_spawn_wait")]
    private static extern int PosixWait(int pid, int timeoutMs);
    [DllImport("crt", EntryPoint = "zan_proc_spawn_dispose")]
    private static extern void PosixDispose(int pid, int stdinFd, int stdoutFd);
    #endif

    private static nint WinHandleAt(byte[] pi, int off) {
        nint h = 0;
        nint mul = 1;
        for (int k = 0; k < 8; k = k + 1) {
            h = h + (pi[off + k] & 255) * mul;
            mul = mul * 256;
        }
        return h;
    }

    private static void WinPutHandle(byte[] buf, int off, nint h) {
        nint v = h;
        for (int k = 0; k < 8; k = k + 1) {
            buf[off + k] = (byte)(v % 256);
            v = v / 256;
        }
    }

    private static void WinPutInt(byte[] buf, int off, int v) {
        buf[off] = (byte)(v & 255);
        buf[off + 1] = (byte)((v >> 8) & 255);
        buf[off + 2] = (byte)((v >> 16) & 255);
        buf[off + 3] = (byte)((v >> 24) & 255);
    }

    private static int ReadIntLE(byte[] buf, int off) {
        return buf[off] + buf[off + 1] * 256 + buf[off + 2] * 65536
            + buf[off + 3] * 16777216;
    }

    /// 启动子进程并接好 stdin/stdout 管道；失败返回 null。
    public static ProcessSpawn Spawn(string exe, List<string> args) {
        return ProcessSpawn.Spawn(exe, args, "");
    }

    /// 在指定工作目录启动子进程。空 cwd 继承父进程目录；启动、chdir 或 exec
    /// 失败均返回 null，不把 POSIX 的 exec 失败伪装成退出码 127 的已成功作业。
    public static ProcessSpawn Spawn(string exe, List<string> args, string cwd) {
        return SpawnCore(exe, args, cwd, false);
    }

    /// 等待受管主进程退出或释放作业时，终止仍在作业或进程组中的后代。
    /// 受管进程使用父进程的文件和网络权限。
    public static ProcessSpawn SpawnManaged(string exe, List<string> args, string cwd) {
        return SpawnCore(exe, args, cwd, true);
    }

    /// Linux 隔离启动。readRoots 是换行分隔的绝对路径，writeRoot 是可写目录。
    /// cgroupRoot 须为部署方委派的 cgroup v2 目录。策略或启动失败返回 null。
    public static ProcessSpawn SpawnSandboxed(string exe, List<string> args, string cwd,
            string readRoots, string writeRoot, string cgroupRoot) {
        if (cgroupRoot == null || cgroupRoot == "") { return null; }
        return SpawnCore(exe, args, cwd, true, readRoots, writeRoot, cgroupRoot);
    }

    /// 探测内核与委派路径。每次启动仍须成功建立全部隔离策略。
    public static bool SandboxAvailable(string cgroupRoot) {
        #if LINUX
        return cgroupRoot != null && ProcessSpawn.PosixSandboxAvailable(cgroupRoot) != 0;
        #else
        return false;
        #endif
    }

    private static ProcessSpawn SpawnCore(string exe, List<string> args, string cwd, bool managed) {
        return SpawnCore(exe, args, cwd, managed, "", "", "");
    }

    private static ProcessSpawn SpawnCore(string exe, List<string> args, string cwd,
            bool managed, string readRoots, string writeRoot, string cgroupRoot) {
        if (exe == null || exe == "") { return null; }
        if (cwd == null) { cwd = ""; }
        #if WINDOWS
        if (cgroupRoot != "") { return null; }
        return ProcessSpawn.WinSpawn(Process.BuildCommandLine(exe, args), cwd, managed);
        #elif LINUX || MACOS
        int argc = args != null ? args.Count : 0;
        nint[] argv = new nint[argc + 2];
        int[] fds = new int[2];
        try {
            for (int i = 0; i <= argc; i = i + 1) {
                string arg = i == 0 ? exe : args[i - 1];
                argv[i] = Marshal.StringToHGlobalUtf8(arg == null ? "" : arg);
            }
            ProcessSpawn child = new ProcessSpawn((nint)0, (nint)0, 0, (nint)0, (nint)0);
            int processId;
            if (cgroupRoot != "") {
                nint[] group = new nint[1];
                processId = ProcessSpawn.PosixSpawnSandboxed(argv, cwd, readRoots,
                    writeRoot, cgroupRoot, fds, group);
                child.sandboxGroup = group[0];
            } else {
                processId = managed ? ProcessSpawn.PosixSpawnManaged(argv, cwd, fds)
                    : ProcessSpawn.PosixSpawn(argv, cwd, fds);
            }
            if (processId < 0) { return null; }
            child.pid = processId;
            child.managed = managed;
            child.stdinWrite = fds[0];
            child.stdoutRead = fds[1];
            return child;
        } finally {
            for (int i = 0; i <= argc; i = i + 1) {
                Marshal.FreeHGlobal(argv[i]);
            }
        }
        #else
        return null;
        #endif
    }

    #if WINDOWS
    [DllImport("kernel32", EntryPoint = "GetSystemDirectoryW")]
    private static extern int WinGetSystemDirectory(nint buffer, int capacity);
    [DllImport("kernel32", EntryPoint = "InitializeProcThreadAttributeList")]
    private static extern int WinInitAttributes(nint list, int count, int flags, nint[] size);
    [DllImport("kernel32", EntryPoint = "UpdateProcThreadAttribute")]
    private static extern int WinUpdateAttribute(nint list, int flags, nint attribute,
        nint[] handles, nint size, nint previous, nint returnedSize);
    [DllImport("kernel32", EntryPoint = "DeleteProcThreadAttributeList")]
    private static extern void WinDeleteAttributes(nint list);

    /// 以 cmd.exe /d /s /c 执行完整 shell 命令。调用方负责命令的可信性。
    public static ProcessSpawn SpawnCommandProcessor(string command, string cwd) {
        return SpawnCommandProcessor(command, cwd, false);
    }

    /// managed 为 true 时在进程创建时加入 Job Object。
    public static ProcessSpawn SpawnCommandProcessor(string command, string cwd, bool managed) {
        if (command == null || command == "") { return null; }
        int capacity = 32768;
        nint directory = NativeMemory.Alloc(capacity * 2);
        try {
            int n = ProcessSpawn.WinGetSystemDirectory(directory, capacity);
            if (n <= 0 || n >= capacity) { return null; }
            string exe = Wide.Read(directory) + "\\cmd.exe";
            // /s strips the outer quotes. Inner quotes belong to cmd syntax.
            return ProcessSpawn.WinSpawn(Process.QuoteArg(exe) + " /d /s /c \""
                + command + "\"", cwd == null ? "" : cwd, managed);
        } finally {
            NativeMemory.Free(directory);
        }
    }

    private static ProcessSpawn WinSpawn(string cmdline, string cwd, bool managed) {
        // 双匿名管道：子读端/子写端可继承，父侧两端私有（读端/写端各关
        // 掉继承位，避免句柄泄漏进孙进程）。
        byte[] sa = new byte[24];
        WinPutInt(sa, 0, 24);
        WinPutInt(sa, 16, 1); // bInheritHandle = TRUE
        byte[] inReadB = new byte[8];
        byte[] inWriteB = new byte[8];
        byte[] outReadB = new byte[8];
        byte[] outWriteB = new byte[8];
        byte[] pi = new byte[32];
        ProcessSpawn child = new ProcessSpawn((nint)0, (nint)0, 0, (nint)0, (nint)0);
        if (WinCreatePipe(inReadB, inWriteB, sa, 0) == 0) { return null; }
        if (WinCreatePipe(outReadB, outWriteB, sa, 0) == 0) {
            WinCloseHandle(WinHandleAt(inReadB, 0));
            WinCloseHandle(WinHandleAt(inWriteB, 0));
            return null;
        }
        nint inRead = WinHandleAt(inReadB, 0);
        nint inWrite = WinHandleAt(inWriteB, 0);
        nint outRead = WinHandleAt(outReadB, 0);
        nint outWrite = WinHandleAt(outWriteB, 0);
        int HANDLE_FLAG_INHERIT = 1;
        int ok = 0;
        nint job = 0;
        try {
            if (managed) {
                int JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE = 8192;
                int JobObjectExtendedLimitInformation = 9;
                byte[] limits = new byte[144]; // JOBOBJECT_EXTENDED_LIMIT_INFORMATION (64-bit)
                WinPutInt(limits, 16, JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE);
                job = WinCreateJobObject(0, 0);
                if (job == 0 || WinSetJobInformation(job, JobObjectExtendedLimitInformation,
                    limits, limits.Length) == 0) { return null; }
            }
            if (WinSetHandleInformation(inWrite, HANDLE_FLAG_INHERIT, 0) != 0
                && WinSetHandleInformation(outRead, HANDLE_FLAG_INHERIT, 0) != 0) {
                ok = ProcessSpawn.WinCreateRedirected(cmdline, cwd, inRead, outWrite, job, pi);
            }
        } finally {
            WinCloseHandle(inRead);
            WinCloseHandle(outWrite);
            if (ok == 0) {
                if (job != 0) { WinCloseHandle(job); }
                WinCloseHandle(inWrite);
                WinCloseHandle(outRead);
            }
        }

        if (ok == 0) { return null; }
        child.hProcess = WinHandleAt(pi, 0);
        child.hThread = WinHandleAt(pi, 8);
        child.pid = ReadIntLE(pi, 16);
        child.stdinWrite = inWrite;
        child.stdoutRead = outRead;
        child.hJob = job;
        return child;
    }

    private static int WinCreateRedirected(string cmdline, string cwd, nint inRead,
            nint outWrite, nint job, byte[] pi) {
        nint[] size = new nint[1];
        int count = job == 0 ? 1 : 2;
        WinInitAttributes(0, count, 0, size);
        if (size[0] <= 0) { return 0; }
        bool initialized = false;
        nint wcmd = 0;
        nint wcwd = 0;
        nint[] handles = new nint[2];
        nint[] jobs = new nint[1];
        jobs[0] = job;
        handles[0] = inRead;
        handles[1] = outWrite;
        nint attributes = NativeMemory.Alloc((int)size[0]);
        try {
            initialized = WinInitAttributes(attributes, count, 0, size) != 0;
            if (!initialized) { return 0; }
            int PROC_THREAD_ATTRIBUTE_HANDLE_LIST = 131074;
            if (WinUpdateAttribute(attributes, 0, PROC_THREAD_ATTRIBUTE_HANDLE_LIST,
                handles, 16, 0, 0) == 0) { return 0; }
            // The kernel assigns the process before it can create descendants.
            int PROC_THREAD_ATTRIBUTE_JOB_LIST = 131085;
            if (job != 0 && WinUpdateAttribute(attributes, 0, PROC_THREAD_ATTRIBUTE_JOB_LIST,
                jobs, 8, 0, 0) == 0) { return 0; }

            byte[] si = new byte[112]; // STARTUPINFOEXW (64-bit Windows)
            WinPutInt(si, 0, 112);
            WinPutInt(si, 60, 256);     // STARTF_USESTDHANDLES
            WinPutHandle(si, 80, inRead);
            WinPutHandle(si, 88, outWrite);
            WinPutHandle(si, 96, outWrite);
            WinPutHandle(si, 104, attributes);
            int CREATE_NO_WINDOW = 134217728;
            int EXTENDED_STARTUPINFO_PRESENT = 524288;
            wcmd = Wide.Of(cmdline);
            if (cwd != "") { wcwd = Wide.Of(cwd); }
            return WinCreateProcess(0, wcmd, 0, 0, 1,
                CREATE_NO_WINDOW | EXTENDED_STARTUPINFO_PRESENT, 0, wcwd, si, pi);
        } finally {
            if (wcmd != 0) { Wide.Free(wcmd); }
            if (wcwd != 0) { Wide.Free(wcwd); }
            if (initialized) { WinDeleteAttributes(attributes); }
            NativeMemory.Free(attributes);
        }
    }
    #endif

    /// 子进程 ID（Spawn 成功后有效）。
    public int Pid() {
        return pid;
    }

    /// 非阻塞读取子进程 stdout 当前已就绪的字节；无数据/管道断开返回 ""。
    public string ReadAvailable() {
        return this.ReadAvailable(int.MaxValue);
    }

    /// 非阻塞读取至多 maxBytes 字节。预算调用方可反复读取并丢弃超额输出，
    /// 既不让子进程阻塞在满管道，也不让宿主的捕获缓冲无限增长。
    public string ReadAvailable(int maxBytes) {
        if (disposed || stdoutRead == 0 || maxBytes <= 0) { return ""; }
        #if WINDOWS
        byte[] avail = new byte[4];
        if (WinPeekNamedPipe(stdoutRead, 0, 0, 0, avail, 0) == 0) { return ""; }
        int n = ReadIntLE(avail, 0);
        if (n > maxBytes) { n = maxBytes; }
        if (n <= 0) { return ""; }
        byte[] buf = new byte[n];
        byte[] numRead = new byte[4];
        if (WinReadFile(stdoutRead, buf, n, numRead, 0) == 0) { return ""; }
        int got = ReadIntLE(numRead, 0);
        if (got <= 0) { return ""; }
        return buf.ToStr(0, got);
        #elif LINUX || MACOS
        int n = ProcessSpawn.PosixAvailable((int)stdoutRead);
        if (n > maxBytes) { n = maxBytes; }
        if (n > 65536) { n = 65536; }
        if (n <= 0) { return ""; }
        byte[] buf = new byte[n];
        int got = ProcessSpawn.PosixRead((int)stdoutRead, buf, n);
        if (got <= 0) { return ""; }
        return buf.ToStr(0, got);
        #else
        return "";
        #endif
    }

    /// 向子进程 stdin 写一行（UTF-8 字节 + '\n'）；管道断开返回 false。
    public bool WriteLine(string line) {
        if (disposed || stdinWrite == 0 || line == null) { return false; }
        byte[] buf = System.Text.Encoding.UTF8.GetBytes(line + "\n");
        #if WINDOWS
        byte[] numWritten = new byte[4];
        return WinWriteFile(stdinWrite, buf, buf.Length, numWritten, 0) != 0
            && ReadIntLE(numWritten, 0) == buf.Length;
        #elif LINUX || MACOS
        return ProcessSpawn.PosixWrite((int)stdinWrite, buf, buf.Length) != 0;
        #else
        return false;
        #endif
    }

    #if WINDOWS
    private bool WinStopJob() {
        if (!jobTerminating) { jobTerminating = WinTerminateJob(hJob, 1) != 0; }
        return jobTerminating;
    }

    private int WinWaitJob(long deadline) {
        if (!WinStopJob()) { return 0 - 1; }
        int JobObjectBasicAccountingInformation = 1;
        byte[] accounting = new byte[48];
        while (true) {
            if (WinQueryJobInformation(hJob, JobObjectBasicAccountingInformation,
                accounting, accounting.Length, 0) == 0) { return 0 - 1; }
            if (ReadIntLE(accounting, 40) == 0) { return 0; } // ActiveProcesses
            if (deadline > 0 && Stopwatch.GetMilliseconds() >= deadline) { return 0 - 258; }
            Thread.Sleep(1);
        }
    }
    #endif

    /// 终止受管作业或进程组。普通启动仅终止直接子进程。
    public bool Kill() {
        if (disposed || exited) { return false; }
        #if WINDOWS
        if (hProcess == 0) { return false; }
        if (hJob != 0) { return WinStopJob(); }
        return WinTerminateProcess(hProcess, 1) != 0;
        #elif LINUX || MACOS
        if (sandboxGroup != 0) { return ProcessSpawn.PosixSandboxKill(sandboxGroup) != 0; }
        return managed ? ProcessSpawn.PosixKillManaged(pid) != 0 : ProcessSpawn.PosixKill(pid) != 0;
        #else
        return false;
        #endif
    }

    /// 上次等待是否获得了退出码。Windows 的真实退出码也可能为 -1 或 -258。
    public bool HasExitCode() {
        #if WINDOWS
        return exited;
        #else
        return exited && exitCode >= 0;
        #endif
    }

    /// 等待退出并返回退出码。timeoutMs <= 0 表示无限等。超时返回 -258，等待失败返回 -1。
    public int WaitExitCode(int timeoutMs) {
        if (disposed) { return 0 - 1; }
        if (exited) { return exitCode; }
        #if WINDOWS
        if (hProcess == 0) { return 0 - 1; }
        long deadline = timeoutMs > 0 && hJob != 0 ? Stopwatch.GetMilliseconds() + timeoutMs : 0;
        int waited = WinWaitForSingleObject(hProcess, timeoutMs > 0 ? timeoutMs : (0 - 1));
        if (waited == 258) { return 0 - 258; }
        if (waited != 0) { return 0 - 1; }
        byte[] cb = new byte[4];
        if (WinGetExitCodeProcess(hProcess, cb) == 0) { return 0 - 1; }
        if (hJob != 0) {
            int cleaned = WinWaitJob(deadline);
            if (cleaned != 0) { return cleaned; }
        }
        exited = true;
        exitCode = ReadIntLE(cb, 0);
        return exitCode;
        #elif LINUX || MACOS
        int code;
        if (sandboxGroup != 0) {
            code = ProcessSpawn.PosixSandboxWait(pid, timeoutMs, sandboxGroup);
        } else {
            code = managed ? ProcessSpawn.PosixWaitManaged(pid, timeoutMs)
                : ProcessSpawn.PosixWait(pid, timeoutMs);
        }
        // ZAN_PROC_WAIT_OWNED_ERROR: retain the PID for Close to finish cleaning up.
        if (managed && code == 0 - 259) { return 0 - 1; }
        if (code != 0 - 258) {
            exited = true;
            exitCode = code;
        }
        return code;
        #else
        return 0 - 1;
        #endif
    }

    /// 关闭全部句柄。POSIX 上会终止仍在运行的直接子进程并回收退出状态。
    /// 之后 Read/Write/Kill 一律失败。
    public void Dispose() {
        Close();
    }

    /// 释放句柄并报告受管作业的清理结果。调用方应先等待终止确认。
    public bool Close() {
        if (disposed) { return closeOk; }
        disposed = true;
        bool ok = true;
        #if WINDOWS
        if (hJob != 0) {
            // Closing the last Job handle requests termination even after a wait failure.
            ok = WinCloseHandle(hJob) != 0 && exited;
            hJob = 0;
        }
        if (stdinWrite != 0) { ok = WinCloseHandle(stdinWrite) != 0 && ok; stdinWrite = 0; }
        if (stdoutRead != 0) { ok = WinCloseHandle(stdoutRead) != 0 && ok; stdoutRead = 0; }
        if (hThread != 0) { ok = WinCloseHandle(hThread) != 0 && ok; hThread = 0; }
        if (hProcess != 0) { ok = WinCloseHandle(hProcess) != 0 && ok; hProcess = 0; }
        #elif LINUX || MACOS
        if (sandboxGroup != 0) {
            ok = ProcessSpawn.PosixSandboxDispose(sandboxGroup, exited ? 0 : pid,
                (int)stdinWrite, (int)stdoutRead) != 0 && (!exited || exitCode >= 0);
            sandboxGroup = 0;
        } else if (managed) {
            ok = ProcessSpawn.PosixDisposeManaged(exited ? 0 : pid, (int)stdinWrite, (int)stdoutRead) != 0
                && (!exited || exitCode >= 0);
        } else {
            ProcessSpawn.PosixDispose(exited ? 0 : pid, (int)stdinWrite, (int)stdoutRead);
        }
        stdinWrite = 0;
        stdoutRead = 0;
        #endif
        closeOk = ok;
        return ok;
    }
}
