using System;
using System.IO;

namespace System.Diagnostics;

/// <summary>
/// 跨平台进程启动器，支持捕获输出。
/// Windows 上使用 _popen/_pclose，POSIX（Linux/macOS）上使用 popen/pclose。
///
/// 安全提示：RunCapture / Run / PipeOpen 通过
/// 系统 shell（cmd.exe 或 /bin/sh -c）执行其参数，因此命令中的 shell 元字符
/// 会被解释。切勿用不可信或未经清理的
/// 输入构造这些命令——否则会招致命令注入。只传入可信、完全
/// 可控的命令字符串。（不经 shell、基于 argv 的启动器才是处理不可信参数的
/// 安全之选，也是计划中的新增功能。）
/// </summary>
class Process {
    #if WINDOWS
    [DllImport("crt", EntryPoint = "_popen")]
    static extern nint plat_popen(string cmd, string mode);

    [DllImport("crt", EntryPoint = "_pclose")]
    static extern int plat_pclose(nint fp);

    // 启动子进程而不闪烁控制台窗口的 Win32 原语。
    // _popen/system 会给 GUI 子系统程序附加控制台，因此
    // IDE 等带窗口的程序改走 CreateProcess + CREATE_NO_WINDOW。
    [DllImport("kernel32", EntryPoint = "CreateProcessA")]
    static extern int WinCreateProcess(nint appName, string cmdLine, nint pa, nint ta,
                                       int inherit, int flags, nint env, nint curDir,
                                       string si, string pi);
    [DllImport("kernel32", EntryPoint = "WaitForSingleObject")]
    static extern int WinWaitForSingleObject(nint handle, int ms);
    [DllImport("kernel32", EntryPoint = "GetExitCodeProcess")]
    static extern int WinGetExitCodeProcess(nint handle, string codeBuf);
    [DllImport("kernel32", EntryPoint = "CloseHandle")]
    static extern int WinCloseHandle(nint handle);
    [DllImport("kernel32", EntryPoint = "GetTickCount")]
    static extern int WinGetTickCount();
    [DllImport("kernel32", EntryPoint = "GetCurrentProcessId")]
    static extern int WinGetCurrentProcessId();
    [DllImport("kernel32", EntryPoint = "WideCharToMultiByte")]
    static extern int WinWideToMulti(int page, int flags, nint wide, int wideLen,
                                     nint mb, int mbLen, nint defChar, nint usedDef);
    [DllImport("kernel32", EntryPoint = "MultiByteToWideChar")]
    static extern int WinMultiToWide(int page, int flags, nint mb, int mbLen,
                                     nint wide, int wideLen);
    #else
    // Linux、macOS 等 POSIX 系统都在 libc 中提供 popen/pclose。
    [DllImport("crt", EntryPoint = "popen")]
    static extern nint plat_popen(string cmd, string mode);

    [DllImport("crt", EntryPoint = "pclose")]
    static extern int plat_pclose(nint fp);
    #endif

    [DllImport("crt")]
    static extern long fread(string buf, long size, long count, nint fp);

    [DllImport("crt", EntryPoint = "fopen")]
    static extern nint plat_fopen(string path, string mode);

    [DllImport("crt", EntryPoint = "fseek")]
    static extern int plat_fseek(nint fp, int offset, int origin);

    [DllImport("crt", EntryPoint = "ftell")]
    static extern long plat_ftell(nint fp);

    [DllImport("crt", EntryPoint = "fread")]
    static extern long plat_fread(byte[] buf, long size, long count, nint fp);

    [DllImport("crt", EntryPoint = "fclose")]
    static extern int plat_fclose(nint fp);

    [DllImport("crt")]
    static extern int system(string cmd);

    [DllImport("crt")]
    static extern int fputs(string s, nint fp);

    [DllImport("crt")]
    static extern int fflush(nint fp);

    /// <summary>打开进程管道。</summary>
    static nint PipeOpen(string cmd, string mode) {
        return plat_popen(cmd, mode);
    }

    /// <summary>关闭进程管道。</summary>
    static int PipeClose(nint fp) {
        return plat_pclose(fp);
    }

    /// <summary>
    /// 打开一个持久交互式 shell 会话，其 stdin 即此管道。
    /// stdout/stderr 重定向请写在 `cmd` 里（管道只
    /// 负责喂入输入），例如 Windows 上 `cmd /q /k >>"session.log" 2>&1`
    /// 或 POSIX 上 `sh >>"session.log" 2>&1`，再流式读取日志文件
    /// 以获取输出。返回供 ShellSend/ShellClose 使用的管道句柄，出错时为 0。
    /// 安全提示：命令及发送的每一行都会经系统 shell 执行。
    /// </summary>
    static nint ShellOpen(string cmd) {
        return plat_popen(cmd, "w");
    }

    /// <summary>向交互式 shell 会话发送一条命令行。</summary>
    static void ShellSend(nint fp, string line) {
        if (fp == 0) { return; }
        fputs(line, fp);
        fputs("\n", fp);
        fflush(fp);
    }

    /// <summary>关闭交互式 shell 会话（发送 EOF 并等待）。</summary>
    static int ShellClose(nint fp) {
        if (fp == 0) { return 0 - 1; }
        return plat_pclose(fp);
    }

    #if WINDOWS
    // 从 PROCESS_INFORMATION 缓冲区读取小端 HANDLE（8 字节）。
    static nint WinHandleAt(byte[] pi, int off) {
        nint h = 0;
        nint mul = 1;
        for (int k = 0; k < 8; k = k + 1) {
            h = h + (pi[off + k] & 255) * mul;
            mul = mul * 256;
        }
        return h;
    }

    // 通过 cmd.exe 启动 `command`，不显示控制台窗口。当 `waitFor`
    // 为 true 时，等待完成并返回子进程退出码；否则
    // 启动成功返回 0（启动失败返回 -1）。
    static int WinSpawn(string command, bool waitFor) {
        string cmdline = "cmd.exe /c " + command;
        byte[] si = new byte[128];
        si[0] = 104;                        // STARTUPINFOA.cb = sizeof(STARTUPINFOA)
        byte[] pi = new byte[32];
        int CREATE_NO_WINDOW = 134217728;   // 0x08000000
        int ok = WinCreateProcess(0, cmdline, 0, 0, 0, CREATE_NO_WINDOW, 0, 0, si, pi);
        int code = 0 - 1;
        if (ok != 0) {
            nint hProc = WinHandleAt(pi, 0);
            nint hThread = WinHandleAt(pi, 8);
            code = 0;
            if (waitFor) {
                WinWaitForSingleObject(hProc, 0 - 1);   // INFINITE
                byte[] cb = new byte[8];
                WinGetExitCodeProcess(hProc, cb);
                code = cb[0] + cb[1] * 256 + cb[2] * 65536 + cb[3] * 16777216;
            }
            WinCloseHandle(hProc);
            WinCloseHandle(hThread);
        }
        return code;
    }

    // 读取捕获文件，将输出编码规范化为 UTF-8：
    //   - UTF-16LE（BOM FF FE）直接转换；
    //   - 其他情况从系统 ANSI 代码页转换
    //     （中文系统上的 sc.exe / schtasks.exe 输出 GBK）。
    // 控制台工具按连接对象选择编码，因此
    // 单独采用任一假设都不安全；由 BOM 来消除歧义。
    static string WinReadText(string path) {
        nint fp = plat_fopen(path, "rb");
        if (fp == 0) { return ""; }
        plat_fseek(fp, 0, 2);
        int size = (int)plat_ftell(fp);
        plat_fseek(fp, 0, 0);
        byte[] raw = new byte[size];
        int got = (int)plat_fread(raw, 1, size, fp);
        plat_fclose(fp);
        if (got < 2) { return raw.ToStr(0, got); }
        bool utf16 = raw[0] == 255 && raw[1] == 254;   // BOM FF FE
        int units = 0;
        if (utf16) {
            units = (got - 2) / 2;
        } else {
            // ANSI（CP_ACP，中文系统上通常是 GBK）：每个字节
            // 最多对应一个 UTF-16 单元，因此 got*2+2 恒够用。
            units = got * 2 + 2;
        }
        nint wide = NativeMemory.Alloc(units * 2 + 2);
        if (utf16) {
            for (int k = 0; k < units; k = k + 1) {
                new Span<ushort>(wide + k * 2, 1)[0] = (ushort)(raw[2 + k * 2] |
                    (raw[3 + k * 2] << 8));
            }
            new Span<ushort>(wide + units * 2, 1)[0] = 0;
        } else {
            nint mb = NativeMemory.Alloc(got);
            for (int k = 0; k < got; k = k + 1) {
                new Span<byte>(mb + k, 1)[0] = raw[k];
            }
            // 原地转换：wide 存放 UTF-16 结果（units 已按其预留），
            // 再为 UTF-8 转换推算真实长度。
            int n = Process.WinMultiToWide(0 /*CP_ACP*/, 0, mb, got, wide, units);
            if (n > 0) { units = n; }
            new Span<ushort>(wide + units * 2, 1)[0] = 0;
            NativeMemory.Free(mb);
        }
        int need = Process.WinWideToMulti(65001, 0, wide, units, 0, 0, 0, 0);
        if (need <= 0) { need = 1; }
        nint utf8 = NativeMemory.Alloc(need + 1);
        Process.WinWideToMulti(65001, 0, wide, units, utf8, need + 1, 0, 0);
        string s = NativeMemory.GetString(utf8, 0, need);
        NativeMemory.Free(utf8);
        NativeMemory.Free(wide);
        return s;
    }
    #endif

    /// <summary>运行命令并将 stdout+stderr 按行捕获。</summary>
    static List<string> RunCapture(string cmd) {
        return Process.Capture(cmd).lines;
    }

    /// <summary>运行命令，捕获 stdout+stderr 并保留退出码。
    ///
    /// RunCapture 会丢掉退出码，调用方只能去猜命令是否成功
    ///（"输出里有没有 error 字样"），因此凡是需要判断成功/失败的
    /// 场景都应改用本方法。启动失败时 exitCode 为 -1。</summary>
    static ProcessResult Capture(string cmd) {
        ProcessResult r = new ProcessResult();
        #if WINDOWS
        string tmpDir = Path.GetTempPath();
        int tick = WinGetTickCount();
        int pid = WinGetCurrentProcessId();
        string tmp = tmpDir + "zan_cap_" + pid + "_" + tick + ".tmp";
        r.exitCode = WinSpawn("(" + cmd + ") > \"" + tmp + "\" 2>&1", true);
        if (File.Exists(tmp)) {
            r.lines = SplitLines(Process.WinReadText(tmp));
            File.Delete(tmp);
        }
        if (r.lines == null) { r.lines = new List<string>(); }
        return r;
        #else
        r.lines = new List<string>();
        string full = "(" + cmd + ") 2>&1";
        nint fp = PipeOpen(full, "r");
        if (fp == 0) {
            r.exitCode = 0 - 1;
            r.lines.Add("[error] failed to launch: " + cmd);
            return r;
        }
        StringBuilder sb = new StringBuilder();
        bool reading = true;
        while (reading) {
            byte[] buf = new byte[4097];
            int n = (int)fread(buf, 1, 4096, fp);
            if (n <= 0) {
                reading = false;
            } else {
                sb.Append(buf.ToStr(0, n));
            }
        }
        int status = PipeClose(fp);
        // wait(2) 的状态字：高 8 位是退出码，低 7 位是终止信号。
        if (status < 0) { r.exitCode = 0 - 1; }
        else if ((status & 127) != 0) { r.exitCode = 128 + (status & 127); }
        else { r.exitCode = (status >> 8) & 255; }
        r.lines = SplitLines(sb.ToString());
        return r;
        #endif
    }

    /// <summary>运行命令并捕获输出（包装）。</summary>
    static List<string> RunCaptureAsync(string cmd) {
        List<string> result = RunCapture(cmd);
        return result;
    }

    /// <summary>通过系统 shell 运行命令并返回退出码。
    ///
    /// 会阻塞调用线程直到子进程退出（Windows 上为 INFINITE 等待）。
    /// 因此 GUI 线程绝不能用它启动程序、文件
    /// 管理器或 shell 打开操作——它会停止处理消息，
    /// 在子进程存活期间窗口一直显示“未响应”。启动请使用
    /// RunDetached 用于启动；Run 只留给短命令——
    /// 那种需要先拿到退出码才能继续的场景。
    ///
    /// 安全提示：会调用 shell；切勿传入不可信输入（有注入风险）。</summary>
    static int Run(string cmd) {
        #if WINDOWS
        return WinSpawn(cmd, true);
        #else
        return system(cmd);
        #endif
    }

    /// <summary>启动命令但不等待其结束，返回
    /// 立即返回（启动成功时为 0）。适用于长时间运行或模态
    /// 子进程（如原生文件/文件夹选择器），以便调用方 UI 能
    /// 持续处理消息而不至于冻结到子进程退出。
    /// 安全提醒：会调用 shell；切勿传入不可信输入（存在注入风险）。</summary>
    static int RunDetached(string cmd) {
        #if WINDOWS
        return WinSpawn(cmd, false);
        #else
        return system("(" + cmd + ") >/dev/null 2>&1 &");
        #endif
    }

    /// <summary>按换行符拆分文本。</summary>
    static List<string> SplitLines(string text) {
        List<string> lines = new List<string>();
        StringBuilder sb = new StringBuilder();
        int len = text.Length;
        for (int i = 0; i < len; i = i + 1) {
            string ch = text.Substring(i, 1);
            if (ch == "\n") {
                lines.Add(sb.ToString());
                sb = new StringBuilder();
            } else if (ch != "\r") {
                sb.Append(ch);
            }
        }
        string last = sb.ToString();
        if (last.Length > 0) {
            lines.Add(last);
        }
        return lines;
    }
}

/// <summary>一次已完成的进程捕获：退出码加上按行拆分的
/// stdout+stderr。见 <see cref="Process.Capture"/>。</summary>
class ProcessResult {
    int exitCode;
    List<string> lines;

    ProcessResult() {
        this.exitCode = 0;
        this.lines = null;
    }

    /// <summary>命令是否以 0 退出。</summary>
    bool Ok() { return this.exitCode == 0; }

    /// <summary>把捕获的各行重新拼成一段文本（以 '\n' 分隔）。</summary>
    string Text() {
        StringBuilder sb = new StringBuilder();
        if (this.lines == null) { return ""; }
        for (int i = 0; i < this.lines.Count; i = i + 1) {
            if (i > 0) { sb.Append("\n"); }
            sb.Append(this.lines[i]);
        }
        return sb.ToString();
    }
}
