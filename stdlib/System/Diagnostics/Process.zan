using System;
using System.IO;
using System.Threading;

namespace System.Diagnostics;

// 跨平台进程启动器，支持捕获输出。
// Windows 上使用 _popen/_pclose，POSIX（Linux/macOS）上使用 popen/pclose。
// // 安全提示：RunCapture / Run / PipeOpen 通过
// 系统 shell（cmd.exe 或 /bin/sh -c）执行其参数，因此命令中的 shell 元字符
// 会被解释。切勿用不可信或未经清理的
// 输入构造这些命令——否则会招致命令注入。只传入可信、完全
// 可控的命令字符串。（不经 shell、基于 argv 的启动器才是处理不可信参数的
// 安全之选，使用 RunSafe / CaptureSafe / StartDetachedSafe。）
public class Process {
    // 将绝对 URI 交给系统关联程序；成功启动处理器返回 true。
    // 不等待处理器退出，不经 shell 解释 URI；无效输入或不支持的平台返回 false。
    public static bool OpenUrl(string url) {
        if (!Process.ValidUri(url)) { return false; }
        return Process.OpenTarget(url);
    }

    // 将现有文件或目录交给系统关联程序。相对路径按当前目录解析；
    // 成功启动处理器返回 true，不等待其退出；路径无效或不存在返回 false。
    public static bool OpenPath(string path) {
        if (path == null || path == "") { return false; }
        for (int i = 0; i < path.Length; i = i + 1) {
            if ((path[i] & 255) == 0) { return false; }
        }
        try {
            string absolute = Path.GetFullPath(path);
            if (!File.Exists(absolute) && !Directory.Exists(absolute)) { return false; }
            return Process.OpenTarget(absolute);
        } catch (ArgumentException ex) {
            // 无效路径属于 bool 启动契约的失败值。
            return false;
        } catch (IOException ex) {
            // 当前目录或完整路径查询失败也属于启动失败。
            return false;
        }
    }

    private static bool ValidUri(string url) {
        if (url == null || url == "") { return false; }
        int colon = url.IndexOf(":");
        if (colon <= 0) { return false; }
        int first = url[0] & 255;
        if (!((first >= 65 && first <= 90) || (first >= 97 && first <= 122))) { return false; }
        for (int i = 1; i < colon; i = i + 1) {
            int c = url[i] & 255;
            if (!((c >= 65 && c <= 90) || (c >= 97 && c <= 122)
                || (c >= 48 && c <= 57) || c == 43 || c == 45 || c == 46)) { return false; }
        }
        for (int i = colon + 1; i < url.Length; i = i + 1) {
            int c = url[i] & 255;
            if (c <= 32 || c == 127) { return false; }
        }
        return colon + 1 < url.Length;
    }

    private static bool OpenTarget(string target) {
        #if WINDOWS
        nint operation = Wide.Of("open");
        nint value = Wide.Of(target);
        try {
            return Process.WinShellExecute(0, operation, value, 0, 0, 1) > 32;
        } finally {
            Wide.Free(value);
            Wide.Free(operation);
        }
        #elif MACOS
        List<string> args = new List<string>();
        args.Add("--");
        args.Add(target);
        return Process.StartDetachedSafe("/usr/bin/open", args) == 0;
        #elif LINUX && !ANDROID && !OHOS
        List<string> args = new List<string>();
        args.Add(target);
        return Process.StartDetachedSafe("xdg-open", args) == 0;
        #else
        return false;
        #endif
    }

