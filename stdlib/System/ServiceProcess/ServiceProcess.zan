using System;
using System.Threading;
using System.Diagnostics;

namespace System.ServiceProcess;

/// <summary>
/// One service snapshot. `state` uses the SCM state codes: 1 = stopped,
/// 2 = start pending, 3 = stop pending, 4 = running, 5 = continue pending,
/// 6 = pause pending, 7 = paused. `processId` is the service's PID (0 when
/// not running). `name` is the service name used by Start/Stop/Get.
/// </summary>
class ServiceInfo {
    public string name;
    public string displayName;
    public int state;
    public int processId;
}

/// <summary>
/// Windows service control: enumerate, query, start, stop, restart and
/// delete services. Windows shells out to the built-in sc.exe (stable text
/// interface; the raw SCM enum layout is version-fragile), Linux wraps
/// systemctl(1); other platforms throw PlatformNotSupportedException.
///
/// Start/Stop/Restart/Delete need enough privileges: admin for Delete and
/// for starting/stopping system services, at least SERVICE_START/STOP on
/// the target service otherwise. Failures return false (never throw).
/// </summary>
/// <summary>
/// Win32 SERVICE_STATUS state codes: 1 = stopped, 2 = start pending,
/// 3 = stop pending, 4 = running, 5 = continue pending, 6 = pause
/// pending, 7 = paused. `ServiceInfo.state` carries these codes as ints
/// (historical API); the names live here so `ServiceProcess.StateName`
/// can go through the compiler-lowered enum ToString.
/// </summary>
enum ServiceState {
    Unknown = 0,
    Stopped = 1,
    StartPending = 2,
    StopPending = 3,
    Running = 4,
    ContinuePending = 5,
    PausePending = 6,
    Paused = 7,
}

class ServiceProcess {
    #if WINDOWS
    [DllImport("kernel32", EntryPoint = "GetLastError")]
    static extern int WinLastError();
    #endif

    /// <summary>Every service (name, display name, state, PID).</summary>
    static List<ServiceInfo> List() {
        List<ServiceInfo> list = new List<ServiceInfo>();
        #if WINDOWS
        List<string> lines = Process.RunCapture(
            "sc query type= service state= all");
        ServiceInfo cur = null;
        for (int i = 0; i < lines.Count; i = i + 1) {
            string line = lines[i];
            if (ServiceProcess.StartsWith(line, "SERVICE_NAME:")) {
                if (cur != null) { list.Add(cur); }
                cur = new ServiceInfo();
                cur.name = ServiceProcess.Trim(line.Substring(13, line.Length - 13));
                cur.state = 1;
            } else if (cur != null) {
                string t = ServiceProcess.Trim(line);
                if (ServiceProcess.StartsWith(t, "DISPLAY_NAME:")) {
                    cur.displayName = ServiceProcess.Trim(t.Substring(13, t.Length - 13));
                } else if (ServiceProcess.StartsWith(t, "STATE")) {
                    cur.state = ServiceProcess.ParseState(t);
                } else if (ServiceProcess.StartsWith(t, "PID")) {
                    cur.processId = ServiceProcess.ParseInt(ServiceProcess.AfterColon(t));
                }
            }
        }
        if (cur != null) { list.Add(cur); }
        return list;
        #elif LINUX
        return ServiceProcess.SystemctlList(list);
        #else
        throw new PlatformNotSupportedException(
            "ServiceProcess is not implemented on this platform");
        #endif
    }

    /// <summary>One service by name; null when it does not exist.</summary>
    static ServiceInfo Get(string name) {
        #if WINDOWS
        // sc queryex additionally reports the PID (when the service runs as
        // its own process; shared svchost services report 0). Single-query
        // output has no DISPLAY_NAME line, so displayName defaults to name;
        // use List() for display names.
        List<string> lines = Process.RunCapture("sc queryex " + name);
        // Successful output always starts with "SERVICE_NAME:" (after a
        // leading blank line); a failed query (service missing, access
        // denied, ...) does not. The error text itself is localized /
        // code-page dependent, so never parse it.
        string first = ServiceProcess.FirstNonEmpty(lines);
        if (first == null || !ServiceProcess.StartsWith(first, "SERVICE_NAME:")) {
            return null;
        }
        ServiceInfo e = new ServiceInfo();
        e.name = name;
        e.displayName = name;
        e.state = 1;
        int i = 0;
        for (; i < lines.Count; i = i + 1) {
            string t = ServiceProcess.Trim(lines[i]);
            if (ServiceProcess.StartsWith(t, "DISPLAY_NAME:")) {
                e.displayName = ServiceProcess.Trim(t.Substring(13, t.Length - 13));
            } else if (ServiceProcess.StartsWith(t, "STATE")) {
                e.state = ServiceProcess.ParseState(t);
            } else if (ServiceProcess.StartsWith(t, "PID")) {
                e.processId = ServiceProcess.ParseInt(ServiceProcess.AfterColon(t));
            }
        }
        return e;
        #else
        List<ServiceInfo> all = ServiceProcess.List();
        for (int i = 0; i < all.Count; i = i + 1) {
            if (all[i].name == name) { return all[i]; }
        }
        return null;
        #endif
    }

    /// <summary>Starts a service. True on success (or when already
    /// running).</summary>
    static bool Start(string name) {
        #if WINDOWS
        return ServiceProcess.ScOk("sc start " + name);
        #elif LINUX
        return ServiceProcess.Systemctl("start", name);
        #else
        throw new PlatformNotSupportedException(
            "ServiceProcess is not implemented on this platform");
        #endif
    }

    /// <summary>Stops a running service. True on success.</summary>
    static bool Stop(string name) {
        #if WINDOWS
        return ServiceProcess.ScOk("sc stop " + name);
        #elif LINUX
        return ServiceProcess.Systemctl("stop", name);
        #else
        throw new PlatformNotSupportedException(
            "ServiceProcess is not implemented on this platform");
        #endif
    }

    /// <summary>Stops then starts a service. True when the start
    /// succeeded.</summary>
    static bool Restart(string name) {
        #if WINDOWS
        ServiceProcess.Stop(name);
        int waited = 0;
        while (waited < 10000) {
            ServiceInfo s = ServiceProcess.Get(name);
            if (s == null || s.state == 1 /*STOPPED*/) { break; }
            Thread.Sleep(100);
            waited = waited + 100;
        }
        return ServiceProcess.Start(name);
        #elif LINUX
        return ServiceProcess.Systemctl("restart", name);
        #else
        throw new PlatformNotSupportedException(
            "ServiceProcess is not implemented on this platform");
        #endif
    }

    /// <summary>Deletes a service. Requires administrator rights. True on
    /// success.</summary>
    static bool Delete(string name) {
        #if WINDOWS
        return ServiceProcess.ScOk("sc delete " + name);
        #elif LINUX
        return ServiceProcess.Systemctl("disable --now", name) ||
               ServiceProcess.Systemctl("stop", name);
        #else
        throw new PlatformNotSupportedException(
            "ServiceProcess is not implemented on this platform");
        #endif
    }

    /// <summary>Human-readable name of a service state code.</summary>
    static string StateName(int state) {
        if (state < (int)ServiceState.Stopped ||
            state > (int)ServiceState.Paused) {
            return ServiceState.Unknown.ToString();
        }
        return ((ServiceState)state).ToString();
    }

    #if WINDOWS
    static bool ScOk(string cmd) {
        List<string> lines = Process.RunCapture(cmd + " 2>&1");
        if (lines.Count == 0) { return false; }
        string head = ServiceProcess.Trim(lines[0]);
        // Success lines: "SERVICE_NAME:", "STATE: 4 RUNNING", or "[SC]
        // StartService FAILED ..." for failures.
        if (ServiceProcess.IndexOf(head, "FAILED", 0) >= 0) { return false; }
        return true;
    }

    static int ParseState(string line) {
        // "STATE              : 4  RUNNING"
        int idx = ServiceProcess.IndexOf(line, ":", 0);
        if (idx < 0) { return 1; }
        string rest = line.Substring(idx + 1, line.Length - idx - 1);
        string num = "";
        for (int i = 0; i < rest.Length; i = i + 1) {
            int ch = rest[i] & 255;
            if (ch >= 48 && ch <= 57) {
                num = num + rest.Substring(i, 1);
            } else if (num != "") {
                break;
            }
        }
        return ServiceProcess.ParseInt(num);
    }

    static string AfterColon(string line) {
        int idx = ServiceProcess.IndexOf(line, ":", 0);
        if (idx < 0) { return ""; }
        return line.Substring(idx + 1, line.Length - idx - 1);
    }

    static string FirstNonEmpty(List<string> lines) {
        for (int i = 0; i < lines.Count; i = i + 1) {
            if (ServiceProcess.Trim(lines[i]).Length > 0) { return lines[i]; }
        }
        return null;
    }

    static bool StartsWith(string s, string prefix) {
        if (prefix.Length > s.Length) { return false; }
        return s.Substring(0, prefix.Length) == prefix;
    }

    static string Trim(string s) {
        int a = 0;
        int b = s.Length;
        for (; a < b; a = a + 1) {
            int ch = s[a] & 255;
            if (ch != 32 && ch != 9 && ch != 13 && ch != 10) { break; }
        }
        while (b > a) {
            int ch = s[b - 1] & 255;
            if (ch != 32 && ch != 9 && ch != 13 && ch != 10) { break; }
            b = b - 1;
        }
        return s.Substring(a, b - a);
    }

    static int ParseInt(string s) {
        if (s.Length == 0) { return 0; }
        int v = 0;
        for (int i = 0; i < s.Length; i = i + 1) {
            int ch = s[i] & 255;
            if (ch < 48 || ch > 57) { break; }
            v = v * 10 + (ch - 48);
        }
        return v;
    }
    #endif

    #if LINUX
    static List<ServiceInfo> SystemctlList(List<ServiceInfo> list) {
        List<string> lines = Process.RunCapture(
            "systemctl list-units --type=service --all --no-legend --no-pager");
        int i = 0;
        while (i < lines.Count) {
            string line = lines[i];
            int sp = ServiceProcess.IndexOf(line, " ", 0);
            if (sp <= 0) { i = i + 1; continue; }
            string unit = line.Substring(0, sp);
            if (!ServiceProcess.EndsWith(unit, ".service")) { i = i + 1; continue; }
            ServiceInfo e = new ServiceInfo();
            e.name = unit.Substring(0, unit.Length - 8);
            e.displayName = e.name;
            e.state = 1;
            if (ServiceProcess.IndexOf(line, "active", 0) >= 0) { e.state = 4; }
            e.processId = ServiceProcess.SystemctlPid(e.name);
            list.Add(e);
            i = i + 1;
        }
        return list;
    }

    static int SystemctlPid(string name) {
        List<string> lines = Process.RunCapture(
            "systemctl show -p MainPID --value " + name + ".service");
        if (lines.Count > 0) { return ServiceProcess.ParseInt(lines[0]); }
        return 0;
    }

    static bool Systemctl(string verb, string name) {
        List<string> lines = Process.RunCapture(
            "systemctl " + verb + " " + name + ".service 2>&1");
        return lines.Count == 0 ||
               ServiceProcess.IndexOf(lines[0], "error", 0) < 0;
    }

    static bool EndsWith(string s, string tail) {
        if (tail.Length > s.Length) { return false; }
        return s.Substring(s.Length - tail.Length, tail.Length) == tail;
    }
    #endif

    static int IndexOf(string hay, string needle, int from) {
        int n = needle.Length;
        int h = hay.Length;
        int i = from;
        while (i + n <= h) {
            if (hay.Substring(i, n) == needle) { return i; }
            i = i + 1;
        }
        return -1;
    }
}
