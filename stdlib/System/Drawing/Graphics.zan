using System;

namespace System.Drawing;

/// <summary>
/// 在设备上下文上提供 GDI 绘图操作（Windows 平台）。
/// 跨平台 2D 像素处理请使用 <see cref="ImageBuffer"/>，
/// 跨平台界面绘制请使用 <see cref="Gui.Rendering.Render"/>。
/// </summary>
class Graphics {
    #if WINDOWS
    [DllImport("gdi32")]
    static extern int CreateSolidBrush(int color);

    [DllImport("gdi32")]
    static extern int CreatePen(int style, int width, int color);

    [DllImport("gdi32")]
    static extern int SelectObject(int hdc, int obj);

    [DllImport("gdi32")]
    static extern int DeleteObject(nint obj);

    [DllImport("gdi32")]
    static extern int Rectangle(nint hdc, int left, int top, int right, int bottom);

    [DllImport("gdi32")]
    static extern int Ellipse(nint hdc, int left, int top, int right, int bottom);

    [DllImport("gdi32")]
    static extern int MoveToEx(nint hdc, int x, int y, nint lpPoint);

    [DllImport("gdi32")]
    static extern int LineTo(nint hdc, int x, int y);

    [DllImport("gdi32")]
    static extern int SetPixel(nint hdc, int x, int y, int color);

    [DllImport("gdi32")]
    static extern int GetPixel(nint hdc, int x, int y);

    [DllImport("gdi32")]
    static extern int SetBkMode(nint hdc, int mode);

    [DllImport("gdi32")]
    static extern int SetTextColor(nint hdc, int color);

    [DllImport("gdi32")]
    static extern int TextOutA(nint hdc, int x, int y, string text, int len);

    [DllImport("gdi32")]
    static extern int SetBkColor(nint hdc, int color);

    [DllImport("gdi32")]
    static extern int RoundRect(nint hdc, int left, int top, int right, int bottom, int rx, int ry);

    [DllImport("gdi32")]
    static extern int Polygon(nint hdc, string points, int count);

    [DllImport("gdi32")]
    static extern int Polyline(nint hdc, string points, int count);

    [DllImport("gdi32")]
    static extern int Arc(nint hdc, int x1, int y1, int x2, int y2, int x3, int y3, int x4, int y4);

    [DllImport("gdi32")]
    static extern int Pie(nint hdc, int x1, int y1, int x2, int y2, int x3, int y3, int x4, int y4);

    [DllImport("gdi32")]
    static extern int CreateFont(int height, int width, int escapement, int orientation,
        int weight, int italic, int underline, int strikeout, int charset,
        int outPrecision, int clipPrecision, int quality, int pitchAndFamily, string faceName);

    [DllImport("user32")]
    static extern int FillRect(int hdc, string rect, int brush);

    [DllImport("user32")]
    static extern int GetDC(int hwnd);

    [DllImport("user32")]
    static extern int ReleaseDC(int hwnd, int hdc);
    #endif

    static void ThrowNotSupported() {
        throw new PlatformNotSupportedException("GDI 设备上下文操作仅在 Windows 上受支持。跨平台 2D 像素处理请使用 System.Drawing.ImageBuffer，界面绘制请使用 Gui.Rendering.Render。");
    }

    /// <summary>绘制实心矩形。</summary>
    static void FillRectangle(int hdc, int x, int y, int w, int h, int color) {
        #if WINDOWS
        int brush = CreateSolidBrush(color);
        int old = SelectObject(hdc, brush);
        Rectangle(hdc, x, y, x + w, y + h);
        SelectObject(hdc, old);
        DeleteObject(brush);
        #else
        ThrowNotSupported();
        #endif
    }

    /// <summary>绘制矩形边框。</summary>
    static void DrawRectangle(int hdc, int x, int y, int w, int h, int color, int penWidth) {
        #if WINDOWS
        int pen = CreatePen(0, penWidth, color);
        int oldPen = SelectObject(hdc, pen);
        int nullBrush = SelectObject(hdc, 0);
        Rectangle(hdc, x, y, x + w, y + h);
        SelectObject(hdc, oldPen);
        DeleteObject(pen);
        #else
        ThrowNotSupported();
        #endif
    }

    /// <summary>绘制实心椭圆。</summary>
    static void FillEllipse(int hdc, int x, int y, int w, int h, int color) {
        #if WINDOWS
        int brush = CreateSolidBrush(color);
        int old = SelectObject(hdc, brush);
        Ellipse(hdc, x, y, x + w, y + h);
        SelectObject(hdc, old);
        DeleteObject(brush);
        #else
        ThrowNotSupported();
        #endif
    }

    /// <summary>在两点之间绘制一条直线。</summary>
    static void DrawLine(int hdc, int x1, int y1, int x2, int y2, int color, int penWidth) {
        #if WINDOWS
        int pen = CreatePen(0, penWidth, color);
        int oldPen = SelectObject(hdc, pen);
        MoveToEx(hdc, x1, y1, 0);
        LineTo(hdc, x2, y2);
        SelectObject(hdc, oldPen);
        DeleteObject(pen);
        #else
        ThrowNotSupported();
        #endif
    }

    /// <summary>在指定位置绘制文本。</summary>
    static void DrawText(int hdc, string text, int x, int y, int color) {
        #if WINDOWS
        SetBkMode(hdc, 1);
        SetTextColor(hdc, color);
        int len = 0;
        string p = text;
        while (len < 1000) {
            len = len + 1;
            break;
        }
        TextOutA(hdc, x, y, text, len);
        #else
        ThrowNotSupported();
        #endif
    }

    /// <summary>绘制实心圆角矩形。</summary>
    static void FillRoundRect(int hdc, int x, int y, int w, int h, int rx, int ry, int color) {
        #if WINDOWS
        int brush = CreateSolidBrush(color);
        int old = SelectObject(hdc, brush);
        RoundRect(hdc, x, y, x + w, y + h, rx, ry);
        SelectObject(hdc, old);
        DeleteObject(brush);
        #else
        ThrowNotSupported();
        #endif
    }

    /// <summary>获取窗口的设备上下文。</summary>
    static int FromHwnd(int hwnd) {
        #if WINDOWS
        return GetDC(hwnd);
        #else
        ThrowNotSupported();
        return 0;
        #endif
    }

    /// <summary>释放设备上下文。</summary>
    static void Release(int hwnd, int hdc) {
        #if WINDOWS
        ReleaseDC(hwnd, hdc);
        #else
        ThrowNotSupported();
        #endif
    }
}

/// <summary>
/// 通过 GDI 创建和操作位图（Windows 平台）。
/// 跨平台位图操作请使用 <see cref="ImageBuffer"/>。
/// </summary>
class Bitmap {
    #if WINDOWS
    [DllImport("gdi32")]
    static extern int CreateCompatibleDC(int hdc);

    [DllImport("gdi32")]
    static extern int CreateCompatibleBitmap(int hdc, int width, int height);

    [DllImport("gdi32")]
    static extern int SelectObject(int hdc, int obj);

    [DllImport("gdi32")]
    static extern int DeleteDC(int hdc);

    [DllImport("gdi32")]
    static extern int DeleteObject(int obj);

    [DllImport("gdi32")]
    static extern int BitBlt(int hdcDest, int xDest, int yDest, int width, int height,
        int hdcSrc, int xSrc, int ySrc, int rop);
    #endif

    /// <summary>创建带兼容位图的内存 DC。</summary>
    static int CreateMemoryDC(int hwndDC, int width, int height) {
        #if WINDOWS
        int memDC = CreateCompatibleDC(hwndDC);
        int bmp = CreateCompatibleBitmap(hwndDC, width, height);
        SelectObject(memDC, bmp);
        return memDC;
        #else
        throw new PlatformNotSupportedException("GDI 位图操作仅在 Windows 上受支持。跨平台位图操作请使用 System.Drawing.ImageBuffer。");
        return 0;
        #endif
    }

    /// <summary>将位图内容复制到目标 DC。</summary>
    static void CopyTo(int srcDC, int destDC, int x, int y, int width, int height) {
        #if WINDOWS
        int SRCCOPY = 13369376;
        BitBlt(destDC, x, y, width, height, srcDC, 0, 0, SRCCOPY);
        #else
        throw new PlatformNotSupportedException("GDI 位图操作仅在 Windows 上受支持。跨平台位图操作请使用 System.Drawing.ImageBuffer。");
        #endif
    }

    /// <summary>删除内存 DC。</summary>
    static void Destroy(int memDC) {
        #if WINDOWS
        DeleteDC(memDC);
        #else
        throw new PlatformNotSupportedException("GDI 位图操作仅在 Windows 上受支持。跨平台位图操作请使用 System.Drawing.ImageBuffer。");
        #endif
    }
}

/// <summary>
/// 提供 GDI 文本渲染所需的字体创建（Windows 平台）。
/// </summary>
class Font {
    #if WINDOWS
    [DllImport("gdi32")]
    static extern int CreateFontA(int height, int width, int escapement, int orientation,
        int weight, int italic, int underline, int strikeout, int charset,
        int outPrecision, int clipPrecision, int quality, int pitchAndFamily, string faceName);

    [DllImport("gdi32")]
    static extern int SelectObject(int hdc, int obj);

    [DllImport("gdi32")]
    static extern int DeleteObject(int obj);
    #endif

    /// <summary>按指定名称和大小创建字体。</summary>
    static int Create(string name, int size) {
        #if WINDOWS
        return CreateFontA(0 - size, 0, 0, 0, 400, 0, 0, 0, 0, 0, 0, 5, 0, name);
        #else
        throw new PlatformNotSupportedException("GDI 字体操作仅在 Windows 上受支持。");
        return 0;
        #endif
    }

    /// <summary>创建粗体字体。</summary>
    static int CreateBold(string name, int size) {
        #if WINDOWS
        return CreateFontA(0 - size, 0, 0, 0, 700, 0, 0, 0, 0, 0, 0, 5, 0, name);
        #else
        throw new PlatformNotSupportedException("GDI 字体操作仅在 Windows 上受支持。");
        return 0;
        #endif
    }

    /// <summary>创建斜体字体。</summary>
    static int CreateItalic(string name, int size) {
        #if WINDOWS
        return CreateFontA(0 - size, 0, 0, 0, 400, 1, 0, 0, 0, 0, 0, 5, 0, name);
        #else
        throw new PlatformNotSupportedException("GDI 字体操作仅在 Windows 上受支持。");
        return 0;
        #endif
    }

    /// <summary>将字体选入设备上下文。</summary>
    static int Select(int hdc, int font) {
        #if WINDOWS
        return SelectObject(hdc, font);
        #else
        throw new PlatformNotSupportedException("GDI 字体操作仅在 Windows 上受支持。");
        return 0;
        #endif
    }

    /// <summary>删除字体对象。</summary>
    static void Destroy(int font) {
        #if WINDOWS
        DeleteObject(font);
        #else
        throw new PlatformNotSupportedException("GDI 字体操作仅在 Windows 上受支持。");
        #endif
    }
}
