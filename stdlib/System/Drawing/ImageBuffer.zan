using System;
using System.Runtime.Intrinsics;

namespace System.Drawing;

/// <summary>
/// 纯 Zan 自举的托管 32 位 ARGB 图像缓冲区。
/// 封装内存管理、边界安全与高性能图像处理流水线（Crop、Resize、Blit、Fill）。
/// 所有热路径计算全部下沉至底层物理原语（NativeMemory.Copy2D 与 PixelOps），
/// 杜绝 C 业务胶水依赖，具备工业级运行效率。
/// </summary>
class ImageBuffer : IDisposable {
    public int Width;
    public int Height;
    public int Stride;
    public nint Pixels;

    public ImageBuffer(int width, int height) {
        if (width <= 0 || height <= 0) {
            this.Width = 0;
            this.Height = 0;
            this.Stride = 0;
            this.Pixels = 0;
            return;
        }
        this.Width = width;
        this.Height = height;
        this.Stride = width * 4;
        this.Pixels = NativeMemory.Alloc(this.Stride * height);
    }

    public void Dispose() {
        if (this.Pixels != 0) {
            NativeMemory.Free(this.Pixels);
            this.Pixels = 0;
        }
    }

    /// <summary>以指定 32 位 ARGB 颜色清空图像。</summary>
    public void Clear(int color) {
        if (this.Pixels == 0 || this.Width <= 0 || this.Height <= 0) return;
        PixelOps.FillRect(this.Pixels, this.Stride, 0, 0, this.Width, this.Height, color);
    }

    /// <summary>在指定矩形区域填充 32 位 ARGB 颜色（自动边界裁剪）。</summary>
    public void FillRect(int x, int y, int w, int h, int color) {
        if (this.Pixels == 0 || w <= 0 || h <= 0) return;
        if (x < 0) { w += x; x = 0; }
        if (y < 0) { h += y; y = 0; }
        if (x + w > this.Width) { w = this.Width - x; }
        if (y + h > this.Height) { h = this.Height - y; }
        if (w <= 0 || h <= 0) return;

        PixelOps.FillRect(this.Pixels, this.Stride, x, y, w, h, color);
    }

    /// <summary>
    /// 裁剪子区域并返回新的 ImageBuffer（由 Copy2D 物理加速，零冗余遍历）。
    /// </summary>
    public ImageBuffer Crop(int x, int y, int w, int h) {
        if (this.Pixels == 0 || w <= 0 || h <= 0) return new ImageBuffer(0, 0);
        if (x < 0) { w += x; x = 0; }
        if (y < 0) { h += y; y = 0; }
        if (x + w > this.Width) { w = this.Width - x; }
        if (y + h > this.Height) { h = this.Height - y; }
        if (w <= 0 || h <= 0) return new ImageBuffer(0, 0);

        ImageBuffer sub = new ImageBuffer(w, h);
        nint srcOff = this.Pixels + (nint)(y * this.Stride + x * 4);
        NativeMemory.Copy2D(sub.Pixels, sub.Stride, srcOff, this.Stride, w * 4, h);
        return sub;
    }

    /// <summary>
    /// 双线性重采样拉伸到目标尺寸（由 ResampleBilinearRow 向量化物理加速）。
    /// </summary>
    public ImageBuffer Resize(int newWidth, int newHeight) {
        if (this.Pixels == 0 || this.Width <= 0 || this.Height <= 0 || newWidth <= 0 || newHeight <= 0) {
            return new ImageBuffer(0, 0);
        }

        ImageBuffer dst = new ImageBuffer(newWidth, newHeight);
        if (this.Width == 1 && this.Height == 1) {
            Span<int> sp = new Span<int>(this.Pixels, 1);
            dst.Clear(sp[0]);
            return dst;
        }

        nint xIdxBuf = NativeMemory.Alloc(newWidth * 4);
        nint xWeightBuf = NativeMemory.Alloc(newWidth * 4);
        Span<int> xIndices = new Span<int>(xIdxBuf, newWidth);
        Span<int> xWeights = new Span<int>(xWeightBuf, newWidth);

        // 预计算 X 轴坐标与插值权重 (16.16 定点数)
        for (int dx = 0; dx < newWidth; dx++) {
            int fp = (int)(((long)dx * (long)(this.Width - 1) << 16) / (long)(newWidth > 1 ? newWidth - 1 : 1));
            int sx = fp >> 16;
            int wx = (fp & 0xFFFF) >> 8; // 0..256
            if (sx >= this.Width - 1) {
                sx = this.Width - 2;
                wx = 256;
            }
            if (sx < 0) {
                sx = 0;
                wx = 0;
            }
            xIndices[dx] = sx;
            xWeights[dx] = wx;
        }

        // 逐行调度物理插值微内核
        for (int dy = 0; dy < newHeight; dy++) {
            int fpY = (int)(((long)dy * (long)(this.Height - 1) << 16) / (long)(newHeight > 1 ? newHeight - 1 : 1));
            int sy = fpY >> 16;
            int wy = (fpY & 0xFFFF) >> 8; // 0..256
            if (sy >= this.Height - 1) {
                sy = this.Height - 2;
                wy = 256;
            }
            if (sy < 0) {
                sy = 0;
                wy = 0;
            }

            nint src0 = this.Pixels + (nint)(sy * this.Stride);
            nint src1 = this.Pixels + (nint)((sy + 1) * this.Stride);
            nint dstRow = dst.Pixels + (nint)(dy * dst.Stride);

            PixelOps.ResampleBilinearRow(dstRow, src0, src1, xIdxBuf, xWeightBuf, wy, newWidth);
        }

        NativeMemory.Free(xIdxBuf);
        NativeMemory.Free(xWeightBuf);
        return dst;
    }

    /// <summary>
    /// 将另一个 ImageBuffer 绘制到当前图像（支持直接覆盖与 Porter-Duff Over 混合）。
    /// </summary>
    public void Blit(ImageBuffer src, int dx, int dy, bool alphaBlend) {
        if (src == null || src.Pixels == 0 || src.Width <= 0 || src.Height <= 0) return;
        if (this.Pixels == 0 || this.Width <= 0 || this.Height <= 0) return;

        int sx = 0;
        int sy = 0;
        int w = src.Width;
        int h = src.Height;

        if (dx < 0) {
            sx -= dx;
            w += dx;
            dx = 0;
        }
        if (dy < 0) {
            sy -= dy;
            h += dy;
            dy = 0;
        }
        if (dx + w > this.Width) {
            w = this.Width - dx;
        }
        if (dy + h > this.Height) {
            h = this.Height - dy;
        }
        if (w <= 0 || h <= 0) return;

        if (!alphaBlend) {
            nint dOff = this.Pixels + (nint)(dy * this.Stride + dx * 4);
            nint sOff = src.Pixels + (nint)(sy * src.Stride + sx * 4);
            NativeMemory.Copy2D(dOff, this.Stride, sOff, src.Stride, w * 4, h);
        } else {
            for (int r = 0; r < h; r++) {
                nint dRow = this.Pixels + (nint)((dy + r) * this.Stride + dx * 4);
                nint sRow = src.Pixels + (nint)((sy + r) * src.Stride + sx * 4);
                PixelOps.BlendOver(dRow, sRow, w);
            }
        }
    }

    /// <summary>将当前图像的通道在 RGBA 与 BGRA 之间翻转。</summary>
    public void SwapRB() {
        if (this.Pixels == 0 || this.Width <= 0 || this.Height <= 0) return;
        PixelOps.SwapRB(this.Pixels, this.Pixels, this.Width * this.Height);
    }

    /// <summary>调整整幅图像的明暗度（delta 为 -255..255）。基于 AVX2 饱和加减硬件指令，杜绝溢出反转。</summary>
    public void AdjustBrightness(int delta) {
        if (this.Pixels == 0 || delta == 0) return;
        int totalBytes = this.Width * this.Height * 4;
        int i = 0;
        if (delta > 0) {
            byte d = (byte)(delta > 255 ? 255 : delta);
            Vector256 d256 = Vector256.Create(d);
            Vector128 d128 = Vector128.Create(d);
            while (i + 32 <= totalBytes) {
                Vector256 v = Vector256.Load(this.Pixels + (nint)i);
                Vector256 sat = Vector256.AddSaturate(v, d256);
                Vector256.Store(this.Pixels + (nint)i, sat);
                i = i + 32;
            }
            while (i + 16 <= totalBytes) {
                Vector128 v = Vector128.Load(this.Pixels + (nint)i);
                Vector128 sat = Vector128.AddSaturate(v, d128);
                Vector128.Store(this.Pixels + (nint)i, sat);
                i = i + 16;
            }
            Span<byte> sp = new Span<byte>(this.Pixels, totalBytes);
            while (i < totalBytes) {
                int val = (int)sp[i] + (int)d;
                sp[i] = (byte)(val > 255 ? 255 : val);
                i = i + 1;
            }
        } else {
            int pos = -delta;
            byte d = (byte)(pos > 255 ? 255 : pos);
            Vector256 d256 = Vector256.Create(d);
            Vector128 d128 = Vector128.Create(d);
            while (i + 32 <= totalBytes) {
                Vector256 v = Vector256.Load(this.Pixels + (nint)i);
                Vector256 sat = Vector256.SubtractSaturate(v, d256);
                Vector256.Store(this.Pixels + (nint)i, sat);
                i = i + 32;
            }
            while (i + 16 <= totalBytes) {
                Vector128 v = Vector128.Load(this.Pixels + (nint)i);
                Vector128 sat = Vector128.SubtractSaturate(v, d128);
                Vector128.Store(this.Pixels + (nint)i, sat);
                i = i + 16;
            }
            Span<byte> sp = new Span<byte>(this.Pixels, totalBytes);
            while (i < totalBytes) {
                int val = (int)sp[i] - (int)d;
                sp[i] = (byte)(val < 0 ? 0 : val);
                i = i + 1;
            }
        }
    }

    /// <summary>50% 均值混合（基于 AVX2 vpavgb 32 字节并行硬件指令）。</summary>
    public void Blend50(ImageBuffer other) {
        if (this.Pixels == 0 || other == null || other.Pixels == 0) return;
        int count = this.Width * this.Height;
        if (other.Width * other.Height < count) count = other.Width * other.Height;
        int totalBytes = count * 4;
        int i = 0;
        while (i + 32 <= totalBytes) {
            Vector256 v1 = Vector256.Load(this.Pixels + (nint)i);
            Vector256 v2 = Vector256.Load(other.Pixels + (nint)i);
            Vector256 avg = Vector256.Average(v1, v2);
            Vector256.Store(this.Pixels + (nint)i, avg);
            i = i + 32;
        }
        while (i + 16 <= totalBytes) {
            Vector128 v1 = Vector128.Load(this.Pixels + (nint)i);
            Vector128 v2 = Vector128.Load(other.Pixels + (nint)i);
            Vector128 avg = Vector128.Average(v1, v2);
            Vector128.Store(this.Pixels + (nint)i, avg);
            i = i + 16;
        }
        Span<byte> s1 = new Span<byte>(this.Pixels, totalBytes);
        Span<byte> s2 = new Span<byte>(other.Pixels, totalBytes);
        while (i < totalBytes) {
            s1[i] = (byte)(((int)s1[i] + (int)s2[i] + 1) / 2);
            i = i + 1;
        }
    }

    /// <summary>变暗混合（Min 滤镜，基于 AVX2 vpminub 32 字节并行硬件指令）。</summary>
    public void Darken(ImageBuffer other) {
        if (this.Pixels == 0 || other == null || other.Pixels == 0) return;
        int count = this.Width * this.Height;
        if (other.Width * other.Height < count) count = other.Width * other.Height;
        int totalBytes = count * 4;
        int i = 0;
        while (i + 32 <= totalBytes) {
            Vector256 v1 = Vector256.Load(this.Pixels + (nint)i);
            Vector256 v2 = Vector256.Load(other.Pixels + (nint)i);
            Vector256 r = Vector256.Min(v1, v2);
            Vector256.Store(this.Pixels + (nint)i, r);
            i = i + 32;
        }
        while (i + 16 <= totalBytes) {
            Vector128 v1 = Vector128.Load(this.Pixels + (nint)i);
            Vector128 v2 = Vector128.Load(other.Pixels + (nint)i);
            Vector128 r = Vector128.Min(v1, v2);
            Vector128.Store(this.Pixels + (nint)i, r);
            i = i + 16;
        }
        Span<byte> s1 = new Span<byte>(this.Pixels, totalBytes);
        Span<byte> s2 = new Span<byte>(other.Pixels, totalBytes);
        while (i < totalBytes) {
            s1[i] = s1[i] < s2[i] ? s1[i] : s2[i];
            i = i + 1;
        }
    }

    /// <summary>变亮混合（Max 滤镜，基于 AVX2 vpmaxub 32 字节并行硬件指令）。</summary>
    public void Lighten(ImageBuffer other) {
        if (this.Pixels == 0 || other == null || other.Pixels == 0) return;
        int count = this.Width * this.Height;
        if (other.Width * other.Height < count) count = other.Width * other.Height;
        int totalBytes = count * 4;
        int i = 0;
        while (i + 32 <= totalBytes) {
            Vector256 v1 = Vector256.Load(this.Pixels + (nint)i);
            Vector256 v2 = Vector256.Load(other.Pixels + (nint)i);
            Vector256 r = Vector256.Max(v1, v2);
            Vector256.Store(this.Pixels + (nint)i, r);
            i = i + 32;
        }
        while (i + 16 <= totalBytes) {
            Vector128 v1 = Vector128.Load(this.Pixels + (nint)i);
            Vector128 v2 = Vector128.Load(other.Pixels + (nint)i);
            Vector128 r = Vector128.Max(v1, v2);
            Vector128.Store(this.Pixels + (nint)i, r);
            i = i + 16;
        }
        Span<byte> s1 = new Span<byte>(this.Pixels, totalBytes);
        Span<byte> s2 = new Span<byte>(other.Pixels, totalBytes);
        while (i < totalBytes) {
            s1[i] = s1[i] > s2[i] ? s1[i] : s2[i];
            i = i + 1;
        }
    }

    /// <summary>颜色反相（基于 AVX2 32 字节并行 XOR 硬件流水线）。</summary>
    public void Invert() {
        if (this.Pixels == 0) return;
        int totalBytes = this.Width * this.Height * 4;
        int i = 0;
        Vector256 all256 = Vector256.AllBitsSet;
        Vector128 all128 = Vector128.AllBitsSet;
        while (i + 32 <= totalBytes) {
            Vector256 v = Vector256.Load(this.Pixels + (nint)i);
            Vector256 inv = Vector256.Xor(v, all256);
            Vector256.Store(this.Pixels + (nint)i, inv);
            i = i + 32;
        }
        while (i + 16 <= totalBytes) {
            Vector128 v = Vector128.Load(this.Pixels + (nint)i);
            Vector128 inv = Vector128.Xor(v, all128);
            Vector128.Store(this.Pixels + (nint)i, inv);
            i = i + 16;
        }
        Span<byte> sp = new Span<byte>(this.Pixels, totalBytes);
        while (i < totalBytes) {
            sp[i] = (byte)(sp[i] ^ 255);
            i = i + 1;
        }
    }

    /// <summary>高性能双向可分离均值盒式模糊（Box Blur，可用于毛玻璃特效与平滑）。
    /// radius: 模糊半径（像素），必须 >= 1。
    /// 采用定点数倒数乘法加速，彻底消除每像素除法开销。</summary>
    public void BoxBlur(int radius) {
        if (this.Pixels == 0 || this.Width <= 1 || this.Height <= 1 || radius <= 0) return;
        int w = this.Width;
        int h = this.Height;
        int r = radius;
        if (r > w - 1) r = w - 1;
        if (r > h - 1) r = h - 1;

        int totalBytes = w * h * 4;
        nint temp = NativeMemory.Alloc(totalBytes);
        if (temp == 0) return;

        Span<byte> srcSp = new Span<byte>(this.Pixels, totalBytes);
        Span<byte> tmpSp = new Span<byte>(temp, totalBytes);

        int winSize = 2 * r + 1;
        // 定点数乘法比例因子 (1 << 16) / winSize
        int invWin = (1 << 16) / winSize;

        // 水平滤波通行：this.Pixels -> temp
        for (int y = 0; y < h; y = y + 1) {
            int rowOff = y * w * 4;
            int sumA = 0; int sumR = 0; int sumG = 0; int sumB = 0;

            for (int k = -r; k <= r; k = k + 1) {
                int px = k;
                if (px < 0) px = 0;
                else if (px >= w) px = w - 1;
                int pOff = rowOff + px * 4;
                sumB = sumB + (int)srcSp[pOff + 0];
                sumG = sumG + (int)srcSp[pOff + 1];
                sumR = sumR + (int)srcSp[pOff + 2];
                sumA = sumA + (int)srcSp[pOff + 3];
            }

            for (int x = 0; x < w; x = x + 1) {
                int dstOff = rowOff + x * 4;
                tmpSp[dstOff + 0] = (byte)((sumB * invWin) >> 16);
                tmpSp[dstOff + 1] = (byte)((sumG * invWin) >> 16);
                tmpSp[dstOff + 2] = (byte)((sumR * invWin) >> 16);
                tmpSp[dstOff + 3] = (byte)((sumA * invWin) >> 16);

                int enteringX = x + r + 1;
                if (enteringX >= w) enteringX = w - 1;
                int leavingX = x - r;
                if (leavingX < 0) leavingX = 0;

                int enterOff = rowOff + enteringX * 4;
                int leaveOff = rowOff + leavingX * 4;

                sumB = sumB + (int)srcSp[enterOff + 0] - (int)srcSp[leaveOff + 0];
                sumG = sumG + (int)srcSp[enterOff + 1] - (int)srcSp[leaveOff + 1];
                sumR = sumR + (int)srcSp[enterOff + 2] - (int)srcSp[leaveOff + 2];
                sumA = sumA + (int)srcSp[enterOff + 3] - (int)srcSp[leaveOff + 3];
            }
        }

        // 垂直滤波通行：temp -> this.Pixels
        for (int x = 0; x < w; x = x + 1) {
            int sumA = 0; int sumR = 0; int sumG = 0; int sumB = 0;

            for (int k = -r; k <= r; k = k + 1) {
                int py = k;
                if (py < 0) py = 0;
                else if (py >= h) py = h - 1;
                int pOff = py * w * 4 + x * 4;
                sumB = sumB + (int)tmpSp[pOff + 0];
                sumG = sumG + (int)tmpSp[pOff + 1];
                sumR = sumR + (int)tmpSp[pOff + 2];
                sumA = sumA + (int)tmpSp[pOff + 3];
            }

            for (int y = 0; y < h; y = y + 1) {
                int dstOff = y * w * 4 + x * 4;
                srcSp[dstOff + 0] = (byte)((sumB * invWin) >> 16);
                srcSp[dstOff + 1] = (byte)((sumG * invWin) >> 16);
                srcSp[dstOff + 2] = (byte)((sumR * invWin) >> 16);
                srcSp[dstOff + 3] = (byte)((sumA * invWin) >> 16);

                int enteringY = y + r + 1;
                if (enteringY >= h) enteringY = h - 1;
                int leavingY = y - r;
                if (leavingY < 0) leavingY = 0;

                int enterOff = enteringY * w * 4 + x * 4;
                int leaveOff = leavingY * w * 4 + x * 4;

                sumB = sumB + (int)tmpSp[enterOff + 0] - (int)tmpSp[leaveOff + 0];
                sumG = sumG + (int)tmpSp[enterOff + 1] - (int)tmpSp[leaveOff + 1];
                sumR = sumR + (int)tmpSp[enterOff + 2] - (int)tmpSp[leaveOff + 2];
                sumA = sumA + (int)tmpSp[enterOff + 3] - (int)tmpSp[leaveOff + 3];
            }
        }

        NativeMemory.Free(temp);
    }
}
