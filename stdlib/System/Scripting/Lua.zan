using System;

namespace System.Scripting;

/// <summary>
/// Zan 的进程内 Lua 嵌入（Lua 5.3 / 5.4）。
///
/// 运行时定位 Lua 动态库，并通过 <see cref="Interop"/>
/// （LoadLibrary/GetProcAddress）在运行期解析所有入口点，因此
/// 从未用到 <c>System.Scripting</c> 的程序不会链接 Lua；
/// 没有 Lua 的机器只会得到 <see cref="Lua.IsAvailable"/> == false，
/// 而不是加载失败。这与 <see cref="Python"/>、SDL3 等其他可选
/// 原生依赖的处理方式一致。
///
///   using System.Scripting;
///
///   if (!Lua.IsAvailable()) { ... fall back ... }
///   Lua.Initialize();
///
///   // 直接调用，自动封送 double/long/string：
///   double v = Lua.CallD("math.floor", 22.3);
///   string s = Lua.CallS("string.upper", "zan");
///
///   // 脚本与表达式：
///   Lua.Exec("answer = 6 * 7");
///   LuaValue r = Lua.Eval("answer");           // 42
///
///   // 表既是数组也是字典：
///   LuaValue t = Lua.Eval("{1, 4, 9}");
///   long second = t[2].ToLong();
///   t[3] = Lua.FromLong(99L);
///   LuaValue p = Lua.Eval("{name = 'Zan'}");
///   p["lang"] = "Lua";
///
/// 回调反向运行，通过 <see cref="Lua.RegisterFunction"/>：
/// 静态、非捕获的 Zan 方法被包装为 lua_CFunction 并发布为全局
/// 名字，使 Lua 代码可以调用 Zan 代码。
///
/// 生命周期：Lua 是栈式 API，而 Zan 的值要活过单次调用，所以
/// <see cref="LuaValue"/> 把值存进 Lua 注册表（registry）的一个整数
/// 槽位里，并在 ARC 回收包装时把该槽位置 nil——于是 Lua 的 GC
/// 恰好在最后一个 Zan 引用消失后回收该值。所有 API 都在返回前
/// 把栈顶恢复到进入时的高度，因此 <see cref="Lua.Top"/> 在成对
/// 使用下始终回到 0。
/// </summary>
class Lua {
    // Lua 的伪索引：LUA_REGISTRYINDEX = -LUAI_MAXSTACK - 1000
    // （5.2 起 LUAI_MAXSTACK 为 1000000，5.3/5.4 相同）。
    static int REGISTRY = 0 - 1001000;

    // lua_type 的返回值。
    static int TNIL = 0;
    static int TBOOLEAN = 1;
    static int TNUMBER = 3;
    static int TSTRING = 4;
    static int TTABLE = 5;
    static int TFUNCTION = 6;

    // ---- 已解析的符号地址（TryResolve 前为 0）--------------------
    static nint mod;
    static nint state;
    static nint addr_newstate;
    static nint addr_openlibs;
    static nint addr_close;
    static nint addr_loadstring;
    static nint addr_loadbufferx;
    static nint addr_pcallk;
    static nint addr_gettop;
    static nint addr_settop;
    static nint addr_type;
    static nint addr_toboolean;
    static nint addr_tonumberx;
    static nint addr_tointegerx;
    static nint addr_tolstring;
    static nint addr_pushnumber;
    static nint addr_pushinteger;
    static nint addr_pushstring;
    static nint addr_pushboolean;
    static nint addr_pushnil;
    static nint addr_pushvalue;
    static nint addr_pushcclosure;
    static nint addr_getglobal;
    static nint addr_setglobal;
    static nint addr_getfield;
    static nint addr_setfield;
    static nint addr_geti;
    static nint addr_seti;
    static nint addr_rawgeti;
    static nint addr_rawseti;
    static nint addr_rawlen;
    static nint addr_next;
    static nint addr_createtable;

    static bool resolved;
    static bool initialized;
    // 注册表槽位分配器。1 和 2 被 Lua 自己占用
    // （LUA_RIDX_MAINTHREAD / LUA_RIDX_GLOBALS），所以从高处开始。
    static long nextSlot;

    /// <summary>能加载可用的 Lua 动态库时为 true。</summary>
    static bool IsAvailable() {
        return Lua.TryResolve();
    }

    /// <summary><see cref="Initialize"/> 运行过且状态仍存活时为 true。</summary>
    static bool IsInitialized() {
        return Lua.initialized && Lua.state != 0;
    }

    /// <summary>
    /// 加载可用的 Lua 动态库、创建状态并打开标准库。幂等。
    /// 没有 Lua 运行时则抛出异常。
    /// </summary>
    static void Initialize() {
        if (Lua.initialized) { return; }
        if (!Lua.TryResolve()) {
            throw new InvalidOperationException(
                "Lua 运行时不可用:未找到 lua54/lua53 动态库(可调用 Lua.LoadPath 指定路径)");
        }
        Lua.OpenState();
    }

    /// <summary>
    /// 加载指定的 Lua 动态库（如 "C:/lua/lua54.dll"）并初始化状态。
    /// Lua 不在 PATH 或库搜索路径中时，请调用它而不是
    /// <see cref="Initialize"/>。
    /// </summary>
    static void LoadPath(string libPath) {
        Lua.Finalize();
        Lua.mod = Interop.Load(libPath);
        if (Lua.mod == 0) {
            throw new InvalidOperationException("无法加载 Lua 动态库: " + libPath);
        }
        if (!Lua.ResolveSymbols()) {
            throw new InvalidOperationException("Lua 动态库缺少所需导出符号: " + libPath);
        }
        Lua.resolved = true;
        Lua.OpenState();
    }

    /// <summary>关闭 Lua 状态并释放运行时库。</summary>
    static void Finalize() {
        if (Lua.state != 0 && Lua.addr_close != 0) {
            LuaVoid1Fn close = (LuaVoid1Fn)Lua.addr_close;
            close(Lua.state);
        }
        Lua.state = 0;
        Lua.initialized = false;
        Lua.FreeModule();
    }

    /// <summary>底层 lua_State*（未初始化时为 0）。</summary>
    static nint State() {
        return Lua.state;
    }

    /// <summary>当前 Lua 栈高度；成对使用的 API 之后应为 0。</summary>
    static int Top() {
        if (Lua.state == 0) { return 0; }
        LuaIntFn f = (LuaIntFn)Lua.addr_gettop;
        return f(Lua.state);
    }

    /// <summary>执行一段 Lua 代码（编译或运行出错时抛出异常）。</summary>
    static void Exec(string code) {
        Lua.EnsureReady();
        int mark = Lua.Top();
        Lua.Load(code);
        Lua.Protected(0, 0, mark, code);
        Lua.SetTop(mark);
    }

    /// <summary>
    /// 执行一段字节缓冲里的 Lua chunk（源码或 <c>luac</c> 字节码，
    /// 见 <see cref="LoadBytes"/>）。编译失败或运行出错时抛出异常。
    /// </summary>
    static void ExecBytes(byte[] chunk, string chunkName) {
        Lua.EnsureReady();
        int mark = Lua.Top();
        Lua.LoadBytes(chunk, chunkName);
        Lua.Protected(0, 0, mark, chunkName);
        Lua.SetTop(mark);
    }

    /// <summary>
    /// 求值一个 Lua 表达式并返回结果，如
    /// <c>Lua.Eval("{1, 4, 9}")</c>；表达式可引用
    /// <see cref="Exec"/> 定义的全局名字。
    /// </summary>
    static LuaValue Eval(string code) {
        Lua.EnsureReady();
        int mark = Lua.Top();
        Lua.Load("return " + code);
        Lua.Protected(0, 1, mark, code);
        LuaValue v = LuaValue.CaptureTop();
        Lua.SetTop(mark);
        return v;
    }

    /// <summary>读取全局名字（不存在则为 nil 值）。</summary>
    static LuaValue GetGlobal(string name) {
        Lua.EnsureReady();
        int mark = Lua.Top();
        LuaGetGlobalFn g = (LuaGetGlobalFn)Lua.addr_getglobal;
        int _t = g(Lua.state, name);
        LuaValue v = LuaValue.CaptureTop();
        Lua.SetTop(mark);
        return v;
    }

    /// <summary>写入全局名字，使脚本可以读到它。</summary>
    static void SetGlobal(string name, LuaValue v) {
        Lua.EnsureReady();
        int mark = Lua.Top();
        v.Push();
        LuaVoidStrFn s = (LuaVoidStrFn)Lua.addr_setglobal;
        s(Lua.state, name);                     // 弹出值
        Lua.SetTop(mark);
    }

    /// <summary>
    /// 以任意数量的参数调用 Lua 函数。名字可以是点分路径
    /// （<c>"math.floor"</c>、<c>"string.upper"</c>）：第一段从全局表取，
    /// 其余逐层取字段。
    /// </summary>
    static LuaValue Call(string name, params LuaValue[] args) {
        Lua.EnsureReady();
        int mark = Lua.Top();
        Lua.PushPath(name, mark);
        for (int i = 0; i < args.Length; i = i + 1) {
            args[i].Push();
        }
        Lua.Protected(args.Length, 1, mark, name);
        LuaValue v = LuaValue.CaptureTop();
        Lua.SetTop(mark);
        return v;
    }

    /// <summary>Call + double 封送：<c>Lua.CallD("math.floor", 22.3)</c>。</summary>
    static double CallD(string name, params double[] args) {
        LuaValue[] vs = new LuaValue[args.Length];
        for (int i = 0; i < args.Length; i = i + 1) {
            vs[i] = Lua.FromDouble(args[i]);
        }
        return Lua.Call(name, vs).ToDouble();
    }

    /// <summary>Call + long 封送：<c>Lua.CallL("math.max", 3L, 7L)</c>。</summary>
    static long CallL(string name, params long[] args) {
        LuaValue[] vs = new LuaValue[args.Length];
        for (int i = 0; i < args.Length; i = i + 1) {
            vs[i] = Lua.FromLong(args[i]);
        }
        return Lua.Call(name, vs).ToLong();
    }

    /// <summary>Call + string 封送：<c>Lua.CallS("string.upper", "zan")</c>。</summary>
    static string CallS(string name, params string[] args) {
        LuaValue[] vs = new LuaValue[args.Length];
        for (int i = 0; i < args.Length; i = i + 1) {
            vs[i] = Lua.FromStr(args[i]);
        }
        return Lua.Call(name, vs).ToStr();
    }

    /// <summary>
    /// 把静态 Zan 方法发布为 Lua 全局函数。方法必须是
    /// lua_CFunction 形式：
    ///
    ///   static int MyFn(nint L) {
    ///       double a = Lua.ArgDouble(L, 1);
    ///       return Lua.ReturnDouble(L, a * 2);
    ///   }
    ///
    /// 且不能捕获状态（Zan 委托为非捕获型），与 Input.Hook、
    /// Thread.Start 的回调一致。Lua 未就绪时返回 false。
    /// </summary>
    static bool RegisterFunction(string name, LuaCFunction fn) {
        if (!Lua.TryResolve()) { return false; }
        Lua.EnsureReady();
        int mark = Lua.Top();
        LuaPushCClosureFn push = (LuaPushCClosureFn)Lua.addr_pushcclosure;
        push(Lua.state, (nint)fn, 0);
        LuaVoidStrFn s = (LuaVoidStrFn)Lua.addr_setglobal;
        s(Lua.state, name);
        Lua.SetTop(mark);
        return true;
    }

    // ---- 值封送：Zan -> Lua ------------------------------------

    /// <summary>nil 值。</summary>
    static LuaValue Nil() {
        return LuaValue.Wrap(0);
    }

    /// <summary>把 double 包装为 Lua number。</summary>
    static LuaValue FromDouble(double v) {
        Lua.EnsureReady();
        LuaPushNumFn f = (LuaPushNumFn)Lua.addr_pushnumber;
        f(Lua.state, v);
        return LuaValue.CaptureTop();
    }

    /// <summary>把 64 位整数包装为 Lua integer。</summary>
    static LuaValue FromLong(long v) {
        Lua.EnsureReady();
        LuaPushIntFn f = (LuaPushIntFn)Lua.addr_pushinteger;
        f(Lua.state, v);
        return LuaValue.CaptureTop();
    }

    /// <summary>把字符串包装为 Lua string（UTF-8 原样传递）。</summary>
    static LuaValue FromStr(string s) {
        Lua.EnsureReady();
        LuaPushStrFn f = (LuaPushStrFn)Lua.addr_pushstring;
        nint _p = f(Lua.state, s);
        return LuaValue.CaptureTop();
    }

    /// <summary>把 bool 包装为 Lua boolean。</summary>
    static LuaValue FromBool(bool b) {
        Lua.EnsureReady();
        LuaVoidIntFn f = (LuaVoidIntFn)Lua.addr_pushboolean;
        int v = 0;
        if (b) { v = 1; }
        f(Lua.state, v);
        return LuaValue.CaptureTop();
    }

    /// <summary>把 LuaValue 列表包装为 Lua 数组表（下标从 1 起）。</summary>
    static LuaValue FromList(List<LuaValue> items) {
        Lua.EnsureReady();
        int mark = Lua.Top();
        LuaCreateTableFn ct = (LuaCreateTableFn)Lua.addr_createtable;
        ct(Lua.state, items.Count, 0);
        LuaSetIFn si = (LuaSetIFn)Lua.addr_rawseti;
        for (int i = 0; i < items.Count; i = i + 1) {
            items[i].Push();
            si(Lua.state, 0 - 2, (long)(i + 1));    // 弹出值
        }
        LuaValue t = LuaValue.CaptureTop();
        Lua.SetTop(mark);
        return t;
    }

    /// <summary>把 double 列表包装为 Lua 数组表。</summary>
    static LuaValue FromListDouble(List<double> items) {
        List<LuaValue> vs = new List<LuaValue>();
        for (int i = 0; i < items.Count; i = i + 1) {
            vs.Add(Lua.FromDouble(items[i]));
        }
        return Lua.FromList(vs);
    }

    /// <summary>把 long 列表包装为 Lua 数组表。</summary>
    static LuaValue FromListLong(List<long> items) {
        List<LuaValue> vs = new List<LuaValue>();
        for (int i = 0; i < items.Count; i = i + 1) {
            vs.Add(Lua.FromLong(items[i]));
        }
        return Lua.FromList(vs);
    }

    /// <summary>把字符串列表包装为 Lua 数组表。</summary>
    static LuaValue FromListStr(List<string> items) {
        List<LuaValue> vs = new List<LuaValue>();
        for (int i = 0; i < items.Count; i = i + 1) {
            vs.Add(Lua.FromStr(items[i]));
        }
        return Lua.FromList(vs);
    }

    /// <summary>把字符串键映射包装为 Lua 表。</summary>
    static LuaValue FromDict(Dictionary<string, LuaValue> map) {
        Lua.EnsureReady();
        int mark = Lua.Top();
        LuaCreateTableFn ct = (LuaCreateTableFn)Lua.addr_createtable;
        List<string> keys = map.Keys;
        ct(Lua.state, 0, keys.Count);
        LuaSetFieldFn sf = (LuaSetFieldFn)Lua.addr_setfield;
        for (int i = 0; i < keys.Count; i = i + 1) {
            map[keys[i]].Push();
            sf(Lua.state, 0 - 2, keys[i]);          // 弹出值
        }
        LuaValue t = LuaValue.CaptureTop();
        Lua.SetTop(mark);
        return t;
    }

    /// <summary>把字符串到字符串的映射包装为 Lua 表。</summary>
    static LuaValue FromDictStr(Dictionary<string, string> map) {
        Dictionary<string, LuaValue> vs = new Dictionary<string, LuaValue>();
        List<string> keys = map.Keys;
        for (int i = 0; i < keys.Count; i = i + 1) {
            vs[keys[i]] = Lua.FromStr(map[keys[i]]);
        }
        return Lua.FromDict(vs);
    }

    // ---- lua_CFunction 回调辅助（Lua -> Zan）------------------

    /// <summary>把第 <paramref name="index"/> 个参数（从 1 起）读为 double。</summary>
    static double ArgDouble(nint L, int index) {
        LuaNumFn f = (LuaNumFn)Lua.addr_tonumberx;
        return f(L, index, 0);
    }

    /// <summary>把第 <paramref name="index"/> 个参数读为 64 位整数。</summary>
    static long ArgLong(nint L, int index) {
        LuaIntegerFn f = (LuaIntegerFn)Lua.addr_tointegerx;
        return f(L, index, 0);
    }

    /// <summary>把第 <paramref name="index"/> 个参数读为字符串。</summary>
    static string ArgStr(nint L, int index) {
        LuaIdxIntFn ty = (LuaIdxIntFn)Lua.addr_type;
        int t = ty(L, index);
        if (t != Lua.TSTRING && t != Lua.TNUMBER) { return ""; }
        LuaToStrFn f = (LuaToStrFn)Lua.addr_tolstring;
        return f(L, index, 0);
    }

    /// <summary>把第 <paramref name="index"/> 个参数读为真值。</summary>
    static bool ArgBool(nint L, int index) {
        LuaIdxIntFn f = (LuaIdxIntFn)Lua.addr_toboolean;
        return f(L, index) != 0;
    }

    /// <summary>回调参数个数。</summary>
    static int ArgCount(nint L) {
        LuaIntFn f = (LuaIntFn)Lua.addr_gettop;
        return f(L);
    }

    /// <summary>回调返回一个 number（返回值即压入的结果个数）。</summary>
    static int ReturnDouble(nint L, double v) {
        LuaPushNumFn f = (LuaPushNumFn)Lua.addr_pushnumber;
        f(L, v);
        return 1;
    }

    /// <summary>回调返回一个 integer。</summary>
    static int ReturnLong(nint L, long v) {
        LuaPushIntFn f = (LuaPushIntFn)Lua.addr_pushinteger;
        f(L, v);
        return 1;
    }

    /// <summary>回调返回一个 string。</summary>
    static int ReturnStr(nint L, string s) {
        LuaPushStrFn f = (LuaPushStrFn)Lua.addr_pushstring;
        nint _p = f(L, s);
        return 1;
    }

    /// <summary>回调返回一个 boolean。</summary>
    static int ReturnBool(nint L, bool b) {
        LuaVoidIntFn f = (LuaVoidIntFn)Lua.addr_pushboolean;
        int v = 0;
        if (b) { v = 1; }
        f(L, v);
        return 1;
    }

    /// <summary>回调返回 nil。</summary>
    static int ReturnNil(nint L) {
        LuaVoid1Fn f = (LuaVoid1Fn)Lua.addr_pushnil;
        f(L);
        return 1;
    }

    // ---- 内部实现 --------------------------------------------------------

    /// 未初始化时自动 Initialize。
    static void EnsureReady() {
        if (!Lua.initialized) { Lua.Initialize(); }
    }

    /// 创建 lua_State、打开标准库，并把注册表槽位分配器复位到 1000。
    static void OpenState() {
        LuaNewStateFn ns = (LuaNewStateFn)Lua.addr_newstate;
        Lua.state = ns();
        if (Lua.state == 0) {
            throw new InvalidOperationException("Lua 状态创建失败(内存不足)");
        }
        LuaVoid1Fn open = (LuaVoid1Fn)Lua.addr_openlibs;
        open(Lua.state);
        Lua.nextSlot = 1000;
        Lua.initialized = true;
    }

    /// lua_settop：把栈高设为 n。
    static void SetTop(int n) {
        LuaVoidIntFn f = (LuaVoidIntFn)Lua.addr_settop;
        f(Lua.state, n);
    }

    /// 编译一段代码并把生成的 chunk 压栈（编译失败时抛出异常）。
    static void Load(string code) {
        LuaLoadFn f = (LuaLoadFn)Lua.addr_loadstring;
        int rc = f(Lua.state, code);
        if (rc != 0) {
            Lua.Fail("Lua 代码编译失败");
        }
    }

    /// <summary>
    /// 编译一段字节缓冲（源码或 <c>luac</c> 字节码）并把生成的
    /// chunk 压栈（编译失败时抛出异常）。缓冲在加载后被立即清零，
    /// 供"密文随包、明文只在内存存活一瞬"的内嵌脚本方案使用。
    /// 字节码必须与运行时主次版本一致（5.4.x）。
    /// </summary>
    static void LoadBytes(byte[] chunk, string chunkName) {
        if (chunk == null || chunk.Length == 0) {
            throw new InvalidOperationException("Lua chunk 为空");
        }
        LuaLoadBufFn f = (LuaLoadBufFn)Lua.addr_loadbufferx;
        int rc = f(Lua.state, chunk, chunk.Length, chunkName, null);
        for (int i = 0; i < chunk.Length; i = i + 1) { chunk[i] = 0; }
        if (rc != 0) {
            Lua.Fail("Lua chunk 编译失败: " + chunkName);
        }
    }

    /// 保护调用栈顶的 chunk/函数：出错时把栈恢复到 mark 再抛异常，
    /// 因此调用方看不到半截的栈。
    static void Protected(int nargs, int nres, int mark, string what) {
        LuaPcallFn f = (LuaPcallFn)Lua.addr_pcallk;
        int rc = f(Lua.state, nargs, nres, 0, 0, 0);
        if (rc != 0) {
            Lua.Fail("Lua 执行失败: " + what);
        }
    }

    /// 读走栈顶的错误消息、清栈并抛出。消息在单独的帧里取出，
    /// 因为 `throw` 不会释放存活局部变量
    /// （见 docs/bugs/throw-leaks-live-locals.md）。
    static void Fail(string prefix) {
        string msg = Lua.TopString();
        Lua.SetTop(0);
        throw new InvalidOperationException(prefix + ": " + msg);
    }

    /// 栈顶值的错误消息；非 string/number 时返回占位文案。
    static string TopString() {
        LuaIdxIntFn ty = (LuaIdxIntFn)Lua.addr_type;
        int t = ty(Lua.state, 0 - 1);
        if (t != Lua.TSTRING && t != Lua.TNUMBER) { return "(no message)"; }
        LuaToStrFn f = (LuaToStrFn)Lua.addr_tolstring;
        return f(Lua.state, 0 - 1, 0);
    }

    /// 把点分路径解析出的值压栈（"string.upper" -> 全局 string 的 upper）。
    static void PushPath(string name, int mark) {
        List<string> parts = name.Split(".");
        LuaGetGlobalFn g = (LuaGetGlobalFn)Lua.addr_getglobal;
        int t = g(Lua.state, parts[0]);
        LuaGetFieldFn gf = (LuaGetFieldFn)Lua.addr_getfield;
        for (int i = 1; i < parts.Count; i = i + 1) {
            if (t != Lua.TTABLE) {
                Lua.SetTop(mark);
                throw new InvalidOperationException("Lua 找不到函数: " + name);
            }
            t = gf(Lua.state, 0 - 1, parts[i]);
        }
        if (t != Lua.TFUNCTION) {
            Lua.SetTop(mark);
            throw new InvalidOperationException("Lua 找不到函数: " + name);
        }
        // 只保留最终值：中间的表还压在下面。
        if (parts.Count > 1) {
            LuaValue fnv = LuaValue.CaptureTop();
            Lua.SetTop(mark);
            fnv.Push();
        }
    }

    /// 定位并加载可用的 Lua 动态库、解析全部入口点；成功后缓存结果。
    static bool TryResolve() {
        if (Lua.resolved) { return true; }
        if (Lua.mod == 0) {
            // 按新旧排序；Windows 用 lua5x.dll，类 Unix 用 liblua5.x.so /
            // .dylib，同时接受不带版本号的 soname。
            string[] cands = new string[] {
                "lua54.dll", "lua53.dll", "lua5.4.dll", "lua5.3.dll",
                "liblua5.4.so", "liblua5.3.so", "liblua54.so", "liblua53.so",
                "liblua.so.5.4", "liblua.so.5.3", "liblua.so",
                "liblua5.4.dylib", "liblua5.3.dylib", "liblua.dylib"
            };
            for (int i = 0; i < cands.Length; i = i + 1) {
                Lua.mod = Interop.Load(cands[i]);
                if (Lua.mod != 0) { break; }
            }
            if (Lua.mod == 0) { return false; }
        }
        if (!Lua.ResolveSymbols()) {
            Interop.Unload(Lua.mod);
            Lua.mod = 0;
            return false;
        }
        Lua.resolved = true;
        return true;
    }

    /// 解析全部入口点地址；关键符号缺失时返回 false。
    /// 5.3 之前没有 lua_geti/lua_seti：退回 raw 访问（无 __index）。
    static bool ResolveSymbols() {
        Lua.addr_newstate = Interop.Symbol(Lua.mod, "luaL_newstate");
        Lua.addr_openlibs = Interop.Symbol(Lua.mod, "luaL_openlibs");
        Lua.addr_close = Interop.Symbol(Lua.mod, "lua_close");
        Lua.addr_loadstring = Interop.Symbol(Lua.mod, "luaL_loadstring");
        // luaL_loadbuffer 是 luaL_loadbufferx 的宏（mode=NULL），DLL 只导出后者。
        Lua.addr_loadbufferx = Interop.Symbol(Lua.mod, "luaL_loadbufferx");
        // lua_pcall 自 5.2 起是 lua_pcallk 的宏包装，导出的只有后者。
        Lua.addr_pcallk = Interop.Symbol(Lua.mod, "lua_pcallk");
        Lua.addr_gettop = Interop.Symbol(Lua.mod, "lua_gettop");
        Lua.addr_settop = Interop.Symbol(Lua.mod, "lua_settop");
        Lua.addr_type = Interop.Symbol(Lua.mod, "lua_type");
        Lua.addr_toboolean = Interop.Symbol(Lua.mod, "lua_toboolean");
        Lua.addr_tonumberx = Interop.Symbol(Lua.mod, "lua_tonumberx");
        Lua.addr_tointegerx = Interop.Symbol(Lua.mod, "lua_tointegerx");
        Lua.addr_tolstring = Interop.Symbol(Lua.mod, "lua_tolstring");
        Lua.addr_pushnumber = Interop.Symbol(Lua.mod, "lua_pushnumber");
        Lua.addr_pushinteger = Interop.Symbol(Lua.mod, "lua_pushinteger");
        Lua.addr_pushstring = Interop.Symbol(Lua.mod, "lua_pushstring");
        Lua.addr_pushboolean = Interop.Symbol(Lua.mod, "lua_pushboolean");
        Lua.addr_pushnil = Interop.Symbol(Lua.mod, "lua_pushnil");
        Lua.addr_pushvalue = Interop.Symbol(Lua.mod, "lua_pushvalue");
        Lua.addr_pushcclosure = Interop.Symbol(Lua.mod, "lua_pushcclosure");
        Lua.addr_getglobal = Interop.Symbol(Lua.mod, "lua_getglobal");
        Lua.addr_setglobal = Interop.Symbol(Lua.mod, "lua_setglobal");
        Lua.addr_getfield = Interop.Symbol(Lua.mod, "lua_getfield");
        Lua.addr_setfield = Interop.Symbol(Lua.mod, "lua_setfield");
        Lua.addr_geti = Interop.Symbol(Lua.mod, "lua_geti");
        Lua.addr_seti = Interop.Symbol(Lua.mod, "lua_seti");
        Lua.addr_rawgeti = Interop.Symbol(Lua.mod, "lua_rawgeti");
        Lua.addr_rawseti = Interop.Symbol(Lua.mod, "lua_rawseti");
        Lua.addr_rawlen = Interop.Symbol(Lua.mod, "lua_rawlen");
        Lua.addr_next = Interop.Symbol(Lua.mod, "lua_next");
        Lua.addr_createtable = Interop.Symbol(Lua.mod, "lua_createtable");
        // 5.3 之前没有 lua_geti/lua_seti：退回 raw 访问（无 __index）。
        if (Lua.addr_geti == 0) { Lua.addr_geti = Lua.addr_rawgeti; }
        if (Lua.addr_seti == 0) { Lua.addr_seti = Lua.addr_rawseti; }
        return Lua.addr_newstate != 0 && Lua.addr_openlibs != 0
            && Lua.addr_loadstring != 0 && Lua.addr_pcallk != 0
            && Lua.addr_rawgeti != 0 && Lua.addr_rawseti != 0
            && Lua.addr_tolstring != 0 && Lua.addr_createtable != 0;
    }

    /// 卸载运行时并清空全部符号地址（状态须已先经 Finalize 关闭）。
    static void FreeModule() {
        if (Lua.mod != 0) {
            Interop.Unload(Lua.mod);
            Lua.mod = 0;
        }
        Lua.resolved = false;
        Lua.addr_newstate = 0;
        Lua.addr_openlibs = 0;
        Lua.addr_close = 0;
        Lua.addr_loadstring = 0;
        Lua.addr_loadbufferx = 0;
        Lua.addr_pcallk = 0;
        Lua.addr_gettop = 0;
        Lua.addr_settop = 0;
        Lua.addr_type = 0;
        Lua.addr_toboolean = 0;
        Lua.addr_tonumberx = 0;
        Lua.addr_tointegerx = 0;
        Lua.addr_tolstring = 0;
        Lua.addr_pushnumber = 0;
        Lua.addr_pushinteger = 0;
        Lua.addr_pushstring = 0;
        Lua.addr_pushboolean = 0;
        Lua.addr_pushnil = 0;
        Lua.addr_pushvalue = 0;
        Lua.addr_pushcclosure = 0;
        Lua.addr_getglobal = 0;
        Lua.addr_setglobal = 0;
        Lua.addr_getfield = 0;
        Lua.addr_setfield = 0;
        Lua.addr_geti = 0;
        Lua.addr_seti = 0;
        Lua.addr_rawgeti = 0;
        Lua.addr_rawseti = 0;
        Lua.addr_rawlen = 0;
        Lua.addr_next = 0;
        Lua.addr_createtable = 0;
    }

    // ---- 注册表槽位（LuaValue 的存储）---------------------------

    /// 把栈顶的值移入一个新的注册表槽位（弹出该值），返回槽位号。
    static long StoreTop() {
        long slot = Lua.nextSlot;
        Lua.nextSlot = Lua.nextSlot + 1;
        LuaSetIFn si = (LuaSetIFn)Lua.addr_rawseti;
        si(Lua.state, Lua.REGISTRY, slot);      // 弹出栈顶
        return slot;
    }

    /// 把槽位里的值压栈（槽位 0 表示 nil）。
    static void PushSlot(long slot) {
        if (slot == 0) {
            LuaVoid1Fn f = (LuaVoid1Fn)Lua.addr_pushnil;
            f(Lua.state);
            return;
        }
        LuaGetIFn g = (LuaGetIFn)Lua.addr_rawgeti;
        int _t = g(Lua.state, Lua.REGISTRY, slot);
    }

    /// 释放槽位（置 nil，让 Lua 的 GC 可以回收该值）。
    static void DropSlot(long slot) {
        if (slot == 0 || Lua.state == 0 || !Lua.resolved) { return; }
        LuaVoid1Fn nil = (LuaVoid1Fn)Lua.addr_pushnil;
        nil(Lua.state);
        LuaSetIFn si = (LuaSetIFn)Lua.addr_rawseti;
        si(Lua.state, Lua.REGISTRY, slot);
    }

    /// 槽位值的 lua_type；槽位 0 即 TNIL。
    static int TypeOfSlot(long slot) {
        if (slot == 0) { return Lua.TNIL; }
        int mark = Lua.Top();
        Lua.PushSlot(slot);
        LuaIdxIntFn ty = (LuaIdxIntFn)Lua.addr_type;
        int t = ty(Lua.state, 0 - 1);
        Lua.SetTop(mark);
        return t;
    }
}

/// <summary>
/// 一个 Lua 值。底层值存放在 Lua 注册表的一个槽位里，包装被 ARC
/// 回收时该槽位被置 nil，因此 Lua 的 GC 与 Zan 的生命周期对齐。
/// nil 值的槽位号为 0，不占用注册表。
/// </summary>
class LuaValue {
    long slot;

    /// <summary>包装一个已分配的槽位（0 表示 nil）。</summary>
    static LuaValue Wrap(long slot) {
        LuaValue v = new LuaValue();
        v.slot = slot;
        return v;
    }

    /// <summary>把栈顶的值移进注册表并包装（弹出栈顶）。</summary>
    static LuaValue CaptureTop() {
        return LuaValue.Wrap(Lua.StoreTop());
    }

    /// ARC 回收包装时释放注册表槽位，Lua 的 GC 随后回收该值。
    ~LuaValue() {
        if (this.slot != 0) {
            Lua.DropSlot(this.slot);
            this.slot = 0;
        }
    }

    /// <summary>注册表槽位号（nil 为 0）。</summary>
    long Slot() { return this.slot; }

    /// <summary>把该值压到 Lua 栈上。</summary>
    void Push() {
        Lua.PushSlot(this.slot);
    }

    /// <summary>lua_type 值。</summary>
    int Type() { return Lua.TypeOfSlot(this.slot); }

    /// <summary>该值为 nil 时为 true。</summary>
    bool IsNil() { return this.slot == 0 || this.Type() == 0; }

    /// <summary>该值为表时为 true。</summary>
    bool IsTable() { return this.Type() == 5; }

    /// <summary>该值为函数（Lua 函数或 C 函数）时为 true。</summary>
    bool IsFunction() { return this.Type() == 6; }

    /// <summary>读为 double。</summary>
    double ToDouble() {
        Lua.EnsureReady();
        int mark = Lua.Top();
        this.Push();
        LuaNumFn f = (LuaNumFn)Lua.addr_tonumberx;
        double v = f(Lua.state, 0 - 1, 0);
        Lua.SetTop(mark);
        return v;
    }

    /// <summary>读为 64 位整数。</summary>
    long ToLong() {
        Lua.EnsureReady();
        int mark = Lua.Top();
        this.Push();
        LuaIntegerFn f = (LuaIntegerFn)Lua.addr_tointegerx;
        long v = f(Lua.state, 0 - 1, 0);
        Lua.SetTop(mark);
        return v;
    }

    /// <summary>读为字符串（number 会按 Lua 规则转成字符串）。</summary>
    string ToStr() {
        Lua.EnsureReady();
        int mark = Lua.Top();
        this.Push();
        LuaIdxIntFn ty = (LuaIdxIntFn)Lua.addr_type;
        int t = ty(Lua.state, 0 - 1);
        string s = "";
        if (t == 4 || t == 3) {
            LuaToStrFn f = (LuaToStrFn)Lua.addr_tolstring;
            s = f(Lua.state, 0 - 1, 0);
        }
        Lua.SetTop(mark);
        return s;
    }

    /// <summary>读取真值（Lua 语义：只有 nil 和 false 为假）。</summary>
    bool ToBool() {
        Lua.EnsureReady();
        int mark = Lua.Top();
        this.Push();
        LuaIdxIntFn f = (LuaIdxIntFn)Lua.addr_toboolean;
        bool b = f(Lua.state, 0 - 1) != 0;
        Lua.SetTop(mark);
        return b;
    }

    /// <summary>表的数组长度（# 运算符的 raw 版本）。</summary>
    long Length() {
        Lua.EnsureReady();
        int mark = Lua.Top();
        this.Push();
        LuaRawLenFn f = (LuaRawLenFn)Lua.addr_rawlen;
        long n = f(Lua.state, 0 - 1);
        Lua.SetTop(mark);
        return n;
    }

    /// <summary>读表的整数下标（下标从 1 起）。</summary>
    LuaValue At(long index) {
        Lua.EnsureReady();
        int mark = Lua.Top();
        this.Push();
        LuaGetIFn g = (LuaGetIFn)Lua.addr_geti;
        int _t = g(Lua.state, 0 - 1, index);
        LuaValue v = LuaValue.CaptureTop();
        Lua.SetTop(mark);
        return v;
    }

    /// <summary>写表的整数下标。</summary>
    void SetAt(long index, LuaValue val) {
        Lua.EnsureReady();
        int mark = Lua.Top();
        this.Push();
        val.Push();
        LuaSetIFn s = (LuaSetIFn)Lua.addr_seti;
        s(Lua.state, 0 - 2, index);             // 弹出值
        Lua.SetTop(mark);
    }

    /// <summary>读表的字符串键。</summary>
    LuaValue Get(string key) {
        Lua.EnsureReady();
        int mark = Lua.Top();
        this.Push();
        LuaGetFieldFn g = (LuaGetFieldFn)Lua.addr_getfield;
        int _t = g(Lua.state, 0 - 1, key);
        LuaValue v = LuaValue.CaptureTop();
        Lua.SetTop(mark);
        return v;
    }

    /// <summary>写表的字符串键。</summary>
    void Set(string key, LuaValue val) {
        Lua.EnsureReady();
        int mark = Lua.Top();
        this.Push();
        val.Push();
        LuaSetFieldFn s = (LuaSetFieldFn)Lua.addr_setfield;
        s(Lua.state, 0 - 2, key);               // 弹出值
        Lua.SetTop(mark);
    }

    /// <summary>以任意数量的参数调用该值（必须是可调用的）。</summary>
    LuaValue Call(params LuaValue[] args) {
        Lua.EnsureReady();
        int mark = Lua.Top();
        this.Push();
        for (int i = 0; i < args.Length; i = i + 1) {
            args[i].Push();
        }
        Lua.Protected(args.Length, 1, mark, "call");
        LuaValue v = LuaValue.CaptureTop();
        Lua.SetTop(mark);
        return v;
    }

    /// <summary>把 Lua 数组表拆成 LuaValue 列表。</summary>
    List<LuaValue> ToList() {
        long n = this.Length();
        List<LuaValue> outList = new List<LuaValue>();
        for (long i = 1; i <= n; i = i + 1) {
            outList.Add(this.At(i));
        }
        return outList;
    }

    /// <summary>把 Lua 数组表拆成 double 列表。</summary>
    List<double> ToListDouble() {
        List<LuaValue> items = this.ToList();
        List<double> outList = new List<double>();
        for (int i = 0; i < items.Count; i = i + 1) {
            outList.Add(items[i].ToDouble());
        }
        return outList;
    }

    /// <summary>把 Lua 数组表拆成 long 列表。</summary>
    List<long> ToListLong() {
        List<LuaValue> items = this.ToList();
        List<long> outList = new List<long>();
        for (int i = 0; i < items.Count; i = i + 1) {
            outList.Add(items[i].ToLong());
        }
        return outList;
    }

    /// <summary>把 Lua 数组表拆成字符串列表。</summary>
    List<string> ToListStr() {
        List<LuaValue> items = this.ToList();
        List<string> outList = new List<string>();
        for (int i = 0; i < items.Count; i = i + 1) {
            outList.Add(items[i].ToStr());
        }
        return outList;
    }

    /// <summary>
    /// 把 Lua 表拆成以字符串为键的映射。键按 Lua 的转换规则读为
    /// 字符串，因此数字键也能取到（"1"、"2" ...）。
    /// </summary>
    Dictionary<string, LuaValue> ToDict() {
        Lua.EnsureReady();
        int mark = Lua.Top();
        this.Push();
        int t = Lua.Top();                      // 表的绝对索引
        Dictionary<string, LuaValue> outMap = new Dictionary<string, LuaValue>();
        LuaVoid1Fn nil = (LuaVoid1Fn)Lua.addr_pushnil;
        LuaNextFn next = (LuaNextFn)Lua.addr_next;
        LuaVoidIntFn pv = (LuaVoidIntFn)Lua.addr_pushvalue;
        LuaToStrFn ts = (LuaToStrFn)Lua.addr_tolstring;
        LuaIdxIntFn ty = (LuaIdxIntFn)Lua.addr_type;
        nil(Lua.state);
        while (next(Lua.state, t) != 0) {
            // 键在 -2，值在 -1。值先进注册表（CaptureTop 会弹出它，
            // 所以先复制一份，键必须留在栈上供下一轮 next 使用）。
            pv(Lua.state, 0 - 1);
            LuaValue v = LuaValue.CaptureTop();
            // 键转字符串同样用副本：tolstring 会就地改写 number 键，
            // 那会打乱 lua_next。
            pv(Lua.state, 0 - 2);
            string k = "";
            int kt = ty(Lua.state, 0 - 1);
            if (kt == 4 || kt == 3) { k = ts(Lua.state, 0 - 1, 0); }
            Lua.SetTop(t + 1);                  // 只留下键
            if (k.Length > 0) { outMap[k] = v; }
        }
        Lua.SetTop(mark);
        return outMap;
    }

    /// <summary>
    /// 运算符重载：<c>fn(a, b)</c> 调用 Lua 函数。由编译器的 op_call
    /// 降级启用；标量重载自动封送 string/double/long/bool 参数。
    /// </summary>
    static LuaValue op_call(LuaValue self, string a) {
        return self.Call(Lua.FromStr(a));
    }

    /// 运算符重载：fn(a)，a 封送为 double。
    static LuaValue op_call(LuaValue self, double a) {
        return self.Call(Lua.FromDouble(a));
    }

    /// 运算符重载：fn(a)，a 封送为 long。
    static LuaValue op_call(LuaValue self, long a) {
        return self.Call(Lua.FromLong(a));
    }

    /// 运算符重载：fn(a)，a 封送为 bool。
    static LuaValue op_call(LuaValue self, bool a) {
        return self.Call(Lua.FromBool(a));
    }

    /// 运算符重载：fn(a)，a 为另一个 LuaValue。
    static LuaValue op_call(LuaValue self, LuaValue a) {
        return self.Call(a);
    }

    /// 运算符重载：fn(a, b, ...)，参数逐一封送为 double。
    static LuaValue op_call(LuaValue self, params double[] args) {
        LuaValue[] vs = new LuaValue[args.Length];
        for (int i = 0; i < args.Length; i = i + 1) {
            vs[i] = Lua.FromDouble(args[i]);
        }
        return self.Call(vs);
    }

    /// 运算符重载：fn(a, b, ...)，参数逐一封送为 long。
    static LuaValue op_call(LuaValue self, params long[] args) {
        LuaValue[] vs = new LuaValue[args.Length];
        for (int i = 0; i < args.Length; i = i + 1) {
            vs[i] = Lua.FromLong(args[i]);
        }
        return self.Call(vs);
    }

    /// 运算符重载：fn(a, b, ...)，参数逐一封送为 string。
    static LuaValue op_call(LuaValue self, params string[] args) {
        LuaValue[] vs = new LuaValue[args.Length];
        for (int i = 0; i < args.Length; i = i + 1) {
            vs[i] = Lua.FromStr(args[i]);
        }
        return self.Call(vs);
    }

    /// 运算符重载：fn(a, b, ...)，参数逐一封送为 bool。
    static LuaValue op_call(LuaValue self, params bool[] args) {
        LuaValue[] vs = new LuaValue[args.Length];
        for (int i = 0; i < args.Length; i = i + 1) {
            vs[i] = Lua.FromBool(args[i]);
        }
        return self.Call(vs);
    }

    /// 运算符重载：fn(a, b, ...)，参数均为 LuaValue。
    static LuaValue op_call(LuaValue self, params LuaValue[] args) {
        return self.Call(args);
    }

    /// <summary>运算符重载：<c>t[2]</c>，同 <see cref="At"/>。</summary>
    static LuaValue op_index(LuaValue self, long index) {
        return self.At(index);
    }

    /// <summary>运算符重载：<c>t["k"]</c>，同 <see cref="Get"/>。</summary>
    static LuaValue op_index(LuaValue self, string key) {
        return self.Get(key);
    }

    /// <summary>运算符重载：<c>t[2] = v</c>，同 <see cref="SetAt"/>。</summary>
    static void op_index_set(LuaValue self, long index, LuaValue val) {
        self.SetAt(index, val);
    }

    /// <summary>运算符重载：<c>t[2] = "s"</c>，封送字符串值。</summary>
    static void op_index_set(LuaValue self, long index, string val) {
        self.SetAt(index, Lua.FromStr(val));
    }

    /// <summary>运算符重载：<c>t["k"] = v</c>，同 <see cref="Set"/>。</summary>
    static void op_index_set(LuaValue self, string key, LuaValue val) {
        self.Set(key, val);
    }

    /// <summary>运算符重载：<c>t["k"] = "s"</c>，封送字符串值。</summary>
    static void op_index_set(LuaValue self, string key, string val) {
        self.Set(key, Lua.FromStr(val));
    }
}

// ---- lua_CFunction 回调形式：int (*)(lua_State *) -------------------
/// lua_CFunction 回调形式：int (*)(lua_State*)。
delegate int LuaCFunction(nint L);

// ---- 已解析入口点的内部调用形式 -----------------------
delegate nint LuaNewStateFn();
delegate void LuaVoid1Fn(nint L);
delegate int LuaIntFn(nint L);
delegate void LuaVoidIntFn(nint L, int n);
delegate int LuaIdxIntFn(nint L, int idx);
delegate int LuaLoadFn(nint L, string code);
delegate int LuaLoadBufFn(nint L, string buf, long sz, string chunkName, string mode);
delegate int LuaPcallFn(nint L, int nargs, int nres, int errfunc, nint ctx, nint k);
delegate double LuaNumFn(nint L, int idx, nint isnum);
delegate long LuaIntegerFn(nint L, int idx, nint isnum);
delegate string LuaToStrFn(nint L, int idx, nint len);
delegate void LuaPushNumFn(nint L, double v);
delegate void LuaPushIntFn(nint L, long v);
delegate nint LuaPushStrFn(nint L, string s);
delegate void LuaPushCClosureFn(nint L, nint fn, int upvals);
delegate int LuaGetGlobalFn(nint L, string name);
delegate void LuaVoidStrFn(nint L, string name);
delegate int LuaGetFieldFn(nint L, int idx, string key);
delegate void LuaSetFieldFn(nint L, int idx, string key);
delegate int LuaGetIFn(nint L, int idx, long n);
delegate void LuaSetIFn(nint L, int idx, long n);
delegate long LuaRawLenFn(nint L, int idx);
delegate int LuaNextFn(nint L, int idx);
delegate void LuaCreateTableFn(nint L, int narr, int nrec);
