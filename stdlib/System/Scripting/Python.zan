using System;

namespace System.Scripting;

/// <summary>
/// Zan 的进程内 CPython 嵌入。
///
/// 运行时定位 runtime DLL，并通过 <see cref="Interop"/>
/// （LoadLibrary/GetProcAddress）在运行期解析所有入口点，因此
/// 从未用到 <c>System.Scripting</c> 的程序不会链接 Python；
/// 没有 Python 的机器只会得到 <see cref="Python.IsAvailable"/>
/// == false，而不是加载失败。这与 stdlib 对待
/// SDL3 等其他可选原生依赖的方式一致。
///
///   using System.Scripting;
///
///   if (!Python.IsAvailable()) { ... fall back ... }
///   Python.Initialize();
///
///   // 直接调用，自动封送 double/string：
///   double v = Python.CallD("math.floor", 22.3);
///   string s = Python.CallS("greet", "Zan");
///
///   // 表达式与模块级访问：
///   Python.Exec("answer = 6 * 7");
///   PyObject r = Python.Eval("[x * x for x in range(4)]");
///   List<double> squares = r.ToListDouble();        // [0, 1, 4, 9]
///
///   // 对象式调用，显式封送：
///   PyObject math = Python.Import("math");
///   double f = math.GetAttr("floor").Call1(Python.FromDouble(22.3)).ToDouble();
///
///   // 容器可双向跨边界：
///   PyObject pyList = Python.FromListStr(new List<string>{ "a", "b" });
///   Dictionary<string, PyObject> pyDict = Python.Eval("{'k': 1}").ToDict();
///
/// 回调反向运行，通过 <see cref="Python.RegisterFunction"/>：
/// 静态、非捕获的 Zan 方法被包装为 PyCFunction，
/// 并发布到 __main__ 模块，使 Python 代码可以调用 Zan 代码。
///
/// 引用计数：<see cref="PyObject"/> 持有其 PyObject* 的强引用
/// （Py_INCREF），并在 finalizer 中释放（Py_DECREF），
/// 因此 ARC 恰好在最后一个 Zan
/// 引用消失时回收 Python 对象。借用引用（如来自
/// <see cref="Python.GetArg"/> 的元组项）直接读取，从不包装。
///
/// 线程：每次经本模块的调用期间都持有 GIL。
/// 只要解释器已初始化过一次，从非初始化线程调用 Python 就是安全的。
/// 重度使用时，计划在长时间运行的 Zan 计算
/// 期间释放 GIL（规划中）。
/// </summary>
class Python {
    // ---- 已解析的符号地址（Initialize 前为 0）--------------------
    static nint mod;
    static nint addr_init;
    static nint addr_isInit;
    static nint addr_finalize;
    static nint addr_runSimple;
    static nint addr_importModule;
    static nint addr_getAttr;
    static nint addr_call;
    static nint addr_tupleNew;
    static nint addr_tupleSet;
    static nint addr_tupleGet;
    static nint addr_floatAsDouble;
    static nint addr_floatFromDouble;
    static nint addr_longAsLong;
    static nint addr_longFromLong;
    static nint addr_unicodeAsUtf8;
    static nint addr_unicodeFromString;
    static nint addr_objStr;
    static nint addr_objIsTrue;
    static nint addr_boolFromLong;
    static nint addr_decRef;
    static nint addr_errPrint;
    static nint addr_errOccurred;
    static nint addr_errClear;
    static nint addr_cfuncNew;
    static nint addr_setAttrString;
    static nint addr_incRef;
    static nint addr_runString;
    static nint addr_moduleGetDict;
    static nint addr_listSize;
    static nint addr_listGetItem;
    static nint addr_listNew;
    static nint addr_listSetItem;
    static nint addr_getItem;
    static nint addr_setItem;
    static nint addr_dictSize;
    static nint addr_dictNext;
    static nint addr_dictNew;
    static nint addr_dictSetItemString;

    static bool resolved;
    static bool initialized;

    // PyCFunction_New 存储的是 PyMethodDef *指针*（不会复制），
    // 所以每个 def 及其名称缓冲区必须比 callable 活得更久。把它们
    // 缓存在这里，并在 Finalize 中统一释放。
    static List<PyRegisteredDef> registeredDefs;

    /// <summary>可加载可用的 CPython DLL 时为 true。</summary>
    static bool IsAvailable() {
        return Python.TryResolve();
    }

    /// <summary><see cref="Initialize"/> 运行过后为 true。</summary>
    static bool IsInitialized() {
        if (!Python.resolved) { return false; }
        PyIntFn f = (PyIntFn)Python.addr_isInit;
        return f() != 0;
    }

    /// <summary>
    /// 加载可用的最新 CPython（python3xx.dll）并初始化
    /// 解释器。幂等。没有 Python 运行时则抛出异常。
    /// </summary>
    static void Initialize() {
        if (Python.initialized) { return; }
        if (!Python.TryResolve()) {
            throw new InvalidOperationException(
                "Python 运行时不可用:未找到 python3xx.dll(可调用 Python.LoadPath 指定路径)");
        }
        PyVoidFn f = (PyVoidFn)Python.addr_init;
        f();
        Python.initialized = true;
    }

    /// <summary>
    /// 加载指定的 CPython DLL（如 "C:/Python311/python311.dll"）并
    /// 初始化解释器。当 Python 不在 PATH 中时，请调用它而不是
    /// <see cref="Initialize"/>。
    /// </summary>
    static void LoadPath(string dllPath) {
        Python.FreeModule();
        Python.mod = Interop.Load(dllPath);
        if (Python.mod == 0) {
            throw new InvalidOperationException("无法加载 Python DLL: " + dllPath);
        }
        if (!Python.ResolveSymbols()) {
            throw new InvalidOperationException("Python DLL 缺少所需导出符号: " + dllPath);
        }
        PyVoidFn f = (PyVoidFn)Python.addr_init;
        f();
        Python.initialized = true;
    }

    /// <summary>关闭解释器（释放 runtime DLL）。</summary>
    static void Finalize() {
        if (Python.resolved && Python.addr_finalize != 0) {
            PyVoidFn f = (PyVoidFn)Python.addr_finalize;
            f();
        }
        if (Python.registeredDefs != null) {
            for (int i = 0; i < Python.registeredDefs.Count; i = i + 1) {
                NativeMemory.Free(Python.registeredDefs[i].def);
                NativeMemory.Free(Python.registeredDefs[i].name);
            }
            Python.registeredDefs.Clear();
        }
        Python.initialized = false;
        Python.FreeModule();
    }

    /// <summary>在 __main__ 模块的命名空间中执行 Python 代码。</summary>
    static void Exec(string code) {
        Python.EnsureReady();
        PyIntStrFn f = (PyIntStrFn)Python.addr_runSimple;
        int rc = f(code);
        if (rc != 0) {
            PyVoidFn printErr = (PyVoidFn)Python.addr_errPrint;
            printErr();
            throw new InvalidOperationException("Python 代码执行失败");
        }
    }

    /// <summary>
    /// 在 __main__ 命名空间中求值 Python 表达式并返回
    /// 结果（如 <c>Python.Eval("[x * x for x in range(4)]")</c>）。使用
    /// PyRun_String 与 Py_eval_input；表达式可引用
    /// <see cref="Exec"/> 定义的名称。
    /// </summary>
    static PyObject Eval(string code) {
        Python.EnsureReady();
        PyNintStrFn imp = (PyNintStrFn)Python.addr_importModule;
        nint mainMod = imp("__main__");
        if (mainMod == 0) {
            PyVoidFn printErr = (PyVoidFn)Python.addr_errPrint;
            printErr();
            throw new InvalidOperationException("Python Eval 失败:无法访问 __main__");
        }
        PyNint1Fn getDict = (PyNint1Fn)Python.addr_moduleGetDict;
        nint globals = getDict(mainMod);        // 借用引用
        PyRunStringFn run = (PyRunStringFn)Python.addr_runString;
        nint h = run(code, 258, globals, globals);   // Py_eval_input
        Python.DecRef(mainMod);
        if (h == 0) {
            PyVoidFn printErr = (PyVoidFn)Python.addr_errPrint;
            printErr();
            throw new InvalidOperationException("Python 表达式求值失败: " + code);
        }
        return PyObject.Wrap(h);
    }

    /// <summary>导入 Python 模块（如 "math"、"os.path"）。</summary>
    static PyObject Import(string name) {
        Python.EnsureReady();
        PyNintStrFn f = (PyNintStrFn)Python.addr_importModule;
        nint h = f(name);
        if (h == 0) {
            PyVoidFn printErr = (PyVoidFn)Python.addr_errPrint;
            printErr();
            throw new InvalidOperationException("Python 模块导入失败: " + name);
        }
        return PyObject.Wrap(h);
    }

    /// <summary>__main__ 模块（<see cref="Exec"/> 在其中定义名称）。</summary>
    static PyObject GetMain() {
        return Python.Import("__main__");
    }

    /// <summary>
    /// 以任意数量的参数调用函数。名称可以是点分形式
    /// （<c>"math.floor"</c>、<c>"os.path.join"</c>）。第一段会
    /// 尝试作为 import（因此 <c>"math.floor"</c> 无需显式
    /// <c>import math</c>）；否则在 __main__ 上查找：
    /// <c>Python.Call("math.floor", Python.FromDouble(2.5))</c>。
    /// </summary>
    static PyObject Call(string name, params PyObject[] args) {
        List<string> parts = name.Split(".");
        PyObject obj = Python.TryImport(parts[0]);
        if (obj.IsNull()) {
            obj = Python.GetMain().TryGetAttr(parts[0]);
        }
        if (obj.IsNull()) {
            obj = Python.Import("builtins").TryGetAttr(parts[0]);
        }
        if (obj.IsNull()) {
            throw new InvalidOperationException("Python 找不到函数: " + name);
        }
        for (int i = 1; i < parts.Count; i = i + 1) {
            obj = obj.GetAttr(parts[i]);
        }
        return obj.Call(args);
    }

    /// <summary>导入模块，不存在时返回 null PyObject。</summary>
    static PyObject TryImport(string name) {
        if (!Python.resolved) { return PyObject.Wrap(0); }
        PyNintStrFn f = (PyNintStrFn)Python.addr_importModule;
        nint h = f(name);
        if (h == 0) { Python.ErrClear(); return PyObject.Wrap(0); }
        return PyObject.Wrap(h);
    }

    /// <summary>Call + double 封送：<c>Python.CallD("math.floor", 2.5)</c>。</summary>
    static double CallD(string name, params double[] args) {
        PyObject[] py = new PyObject[args.Length];
        for (int i = 0; i < args.Length; i = i + 1) {
            py[i] = Python.FromDouble(args[i]);
        }
        return Python.Call(name, py).ToDouble();
    }

    /// <summary>Call + string 封送：<c>Python.CallS("greet", "Zan")</c>。</summary>
    static string CallS(string name, params string[] args) {
        PyObject[] py = new PyObject[args.Length];
        for (int i = 0; i < args.Length; i = i + 1) {
            py[i] = Python.FromStr(args[i]);
        }
        return Python.Call(name, py).ToStr();
    }

    /// <summary>Call + long 封送：<c>Python.CallL("int", "3.9")</c>。</summary>
    static long CallL(string name, params long[] args) {
        PyObject[] py = new PyObject[args.Length];
        for (int i = 0; i < args.Length; i = i + 1) {
            py[i] = Python.FromLong(args[i]);
        }
        return Python.Call(name, py).ToLong();
    }

    /// <summary>
    /// 在 __main__ 模块上发布静态 Zan 方法，让 Python 代码可以调用它。
    /// 该方法必须是 PyCFunction 形式：
    ///
    ///   static nint MyFn(nint self, nint args) {
    ///       double a = Python.GetArgDouble(args, 0);
    ///       return Python.ReturnDouble(a * 2);
    ///   }
    ///
    /// 且不能捕获状态（Zan 委托为非捕获型），
    /// 与 Input.Hook、Thread.Start 回调一致。
    /// Python 解释器未就绪时返回 false。
    /// </summary>
    static bool RegisterFunction(string name, PyCFunction fn) {
        if (!Python.resolved) { return false; }
        nint defs = NativeMemory.Alloc(64);
        nint nameBuf = NativeMemory.Alloc(name.Length + 1);
        NativeMemory.PutString(nameBuf, 0, name, name.Length);
        new Span<byte>(nameBuf + name.Length, 1)[0] = 0;

        Span<nint> d0 = new Span<nint>(defs, 4);
        d0[0] = nameBuf;                        // ml_name
        d0[1] = (nint)fn;                       // ml_meth（delegate -> fn ptr）
        new Span<int>(defs + 16, 1)[0] = 1;     // ml_flags = METH_VARARGS
        d0[3] = 0;                              // ml_doc = NULL
        Span<nint> d1 = new Span<nint>(defs + 32, 4);
        d1[0] = 0; d1[1] = 0;                   // NULL 哨兵条目
        new Span<int>(defs + 48, 1)[0] = 0;
        d1[3] = 0;

        PyCfuncNewFn make = (PyCfuncNewFn)Python.addr_cfuncNew;
        nint func = make(defs, 0);              // 持有指向 `defs` 的指针
        if (func == 0) {
            NativeMemory.Free(defs);
            NativeMemory.Free(nameBuf);
            return false;
        }
        // 保持 defs/nameBuf 存活：callable 在释放前一直引用它们。
        if (Python.registeredDefs == null) {
            Python.registeredDefs = new List<PyRegisteredDef>();
        }
        Python.registeredDefs.Add(new PyRegisteredDef(defs, nameBuf));

        PySetAttrFn setAttr = (PySetAttrFn)Python.addr_setAttrString;
        PyNintStrFn imp = (PyNintStrFn)Python.addr_importModule;
        nint mainMod = imp("__main__");
        if (mainMod == 0) {
            Python.DecRef(func);
            return false;
        }
        int rc = setAttr(mainMod, name, func);
        Python.DecRef(func);                    // set 持有自己的引用
        Python.DecRef(mainMod);
        return rc == 0;
    }

    // ---- 值封送：Zan -> Python ---------------------------------

    /// <summary>将 double 包装为 Python float。</summary>
    static PyObject FromDouble(double v) {
        Python.EnsureReady();
        PyDoubleRetFn f = (PyDoubleRetFn)Python.addr_floatFromDouble;
        return PyObject.Wrap(f(v));
    }

    /// <summary>将 64 位整数包装为 Python int。</summary>
    static PyObject FromLong(long v) {
        Python.EnsureReady();
        PyLongRetFn f = (PyLongRetFn)Python.addr_longFromLong;
        return PyObject.Wrap(f(v));
    }

    /// <summary>将字符串包装为 Python str（UTF-8）。</summary>
    static PyObject FromStr(string s) {
        Python.EnsureReady();
        PyNintStrFn f = (PyNintStrFn)Python.addr_unicodeFromString;
        return PyObject.Wrap(f(s));
    }

    /// <summary>将 bool 包装为 Python bool。</summary>
    static PyObject FromBool(bool b) {
        Python.EnsureReady();
        PyBoolRetFn f = (PyBoolRetFn)Python.addr_boolFromLong;
        int v = 0;
        if (b) { v = 1; }
        return PyObject.Wrap(f(v));
    }

    /// <summary>将 PyObject 列表包装为 Python list。</summary>
    static PyObject FromList(List<PyObject> items) {
        Python.EnsureReady();
        int n = items.Count;
        PyListNewFn nl = (PyListNewFn)Python.addr_listNew;
        nint lst = nl(n);
        if (lst == 0) { throw new InvalidOperationException("Python 列表创建失败"); }
        PyListSetFn sl = (PyListSetFn)Python.addr_listSetItem;
        PyVoid1Fn inc = (PyVoid1Fn)Python.addr_incRef;
        for (int i = 0; i < n; i = i + 1) {
            inc(items[i].handle);               // list 会夺走引用
            sl(lst, i, items[i].handle);
        }
        return PyObject.Wrap(lst);
    }

    /// <summary>将 double 列表包装为 Python float 列表。</summary>
    static PyObject FromListDouble(List<double> items) {
        List<PyObject> py = new List<PyObject>();
        for (int i = 0; i < items.Count; i = i + 1) {
            py.Add(Python.FromDouble(items[i]));
        }
        return Python.FromList(py);
    }

    /// <summary>将字符串列表包装为 Python str 列表。</summary>
    static PyObject FromListStr(List<string> items) {
        List<PyObject> py = new List<PyObject>();
        for (int i = 0; i < items.Count; i = i + 1) {
            py.Add(Python.FromStr(items[i]));
        }
        return Python.FromList(py);
    }

    /// <summary>将字符串键映射包装为 Python dict。</summary>
    static PyObject FromDict(Dictionary<string, PyObject> map) {
        Python.EnsureReady();
        PyDictNewFn nd = (PyDictNewFn)Python.addr_dictNew;
        nint d = nd();
        if (d == 0) { throw new InvalidOperationException("Python dict 创建失败"); }
        PyDictSetStrFn sd = (PyDictSetStrFn)Python.addr_dictSetItemString;
        List<string> keys = map.Keys;
        for (int i = 0; i < keys.Count; i = i + 1) {
            string k = keys[i];
            sd(d, k, map[k].handle);            // SetItemString 会自己持有
        }                                        //   引用；不会偷走引用
        return PyObject.Wrap(d);
    }

    /// <summary>将字符串到字符串的映射包装为 Python dict。</summary>
    static PyObject FromDictStr(Dictionary<string, string> map) {
        Dictionary<string, PyObject> py = new Dictionary<string, PyObject>();
        List<string> keys = map.Keys;
        for (int i = 0; i < keys.Count; i = i + 1) {
            py[keys[i]] = Python.FromStr(map[keys[i]]);
        }
        return Python.FromDict(py);
    }

    // ---- 值封送：Python -> Zan ---------------------------------

    /// <summary>将 Python 对象读为 double。</summary>
    static double ToDouble(PyObject o) {
        Python.EnsureReady();
        PyDoubleFn f = (PyDoubleFn)Python.addr_floatAsDouble;
        return f(o.handle);
    }

    /// <summary>将 Python 对象读为 64 位整数。</summary>
    static long ToLong(PyObject o) {
        Python.EnsureReady();
        PyLongFn f = (PyLongFn)Python.addr_longAsLong;
        return f(o.handle);
    }

    /// <summary>将 Python 对象读为字符串（UTF-8，经 str()）。</summary>
    static string ToStr(PyObject o) {
        Python.EnsureReady();
        PyNint1Fn s = (PyNint1Fn)Python.addr_objStr;
        nint str = s(o.handle);
        if (str == 0) { return ""; }
        PyStrRetFn u = (PyStrRetFn)Python.addr_unicodeAsUtf8;
        string text = u(str);
        Python.DecRef(str);
        return text;
    }

    /// <summary>读取 Python 对象的真值。</summary>
    static bool ToBool(PyObject o) {
        Python.EnsureReady();
        PyNint1Fn t = (PyNint1Fn)Python.addr_objIsTrue;
        return t(o.handle) != 0;
    }

    /// <summary>Python 错误指示器已设置时为 true。</summary>
    static bool ErrOccurred() {
        if (!Python.resolved) { return false; }
        PyIntFn f = (PyIntFn)Python.addr_errOccurred;
        return f() != 0;
    }

    /// <summary>清除 Python 错误指示器。</summary>
    static void ErrClear() {
        if (!Python.resolved) { return; }
        PyVoidFn f = (PyVoidFn)Python.addr_errClear;
        f();
    }

    // ---- PyCFunction 回调辅助（Python -> Zan）----------------

    /// <summary>将 args 元组的第 `index` 个参数读为 double。</summary>
    static double GetArgDouble(nint args, long index) {
        PyTupleGetFn g = (PyTupleGetFn)Python.addr_tupleGet;
        PyDoubleFn d = (PyDoubleFn)Python.addr_floatAsDouble;
        return d(g(args, index));               // 借用引用
    }

    /// <summary>将 args 元组的第 `index` 个参数读为 long。</summary>
    static long GetArgLong(nint args, long index) {
        PyTupleGetFn g = (PyTupleGetFn)Python.addr_tupleGet;
        PyLongFn l = (PyLongFn)Python.addr_longAsLong;
        return l(g(args, index));
    }

    /// <summary>将 args 元组的第 `index` 个参数读为字符串。</summary>
    static string GetArgStr(nint args, long index) {
        PyTupleGetFn g = (PyTupleGetFn)Python.addr_tupleGet;
        PyNint1Fn s = (PyNint1Fn)Python.addr_objStr;
        nint str = s(g(args, index));
        if (str == 0) { return ""; }
        PyStrRetFn u = (PyStrRetFn)Python.addr_unicodeAsUtf8;
        string text = u(str);
        Python.DecRef(str);
        return text;
    }

    /// <summary>构造回调的返回值：新的 float。</summary>
    static nint ReturnDouble(double v) {
        PyDoubleRetFn f = (PyDoubleRetFn)Python.addr_floatFromDouble;
        return f(v);
    }

    /// <summary>构造回调的返回值：新的 int。</summary>
    static nint ReturnLong(long v) {
        PyLongRetFn f = (PyLongRetFn)Python.addr_longFromLong;
        return f(v);
    }

    /// <summary>构造回调的返回值：新的字符串。</summary>
    static nint ReturnStr(string s) {
        PyNintStrFn f = (PyNintStrFn)Python.addr_unicodeFromString;
        return f(s);
    }

    /// <summary>构造回调的返回值：新的 bool。</summary>
    static nint ReturnBool(bool b) {
        PyBoolRetFn f = (PyBoolRetFn)Python.addr_boolFromLong;
        int v = 0;
        if (b) { v = 1; }
        return f(v);
    }

    /// <summary>构造回调的返回值：None。</summary>
    static nint ReturnNone() {
        // 未设置错误时返回 NULL 即得到 Python None。
        return 0;
    }

    // ---- 内部实现 --------------------------------------------------------

    static void EnsureReady() {
        if (!Python.resolved) { Python.Initialize(); }
    }

    static bool TryResolve() {
        if (Python.resolved) { return true; }
        if (Python.mod == 0) {
            // 按新旧排序；python3.dll 是稳定的 ABI 转发器，但其
            // 符号集有限，所以先尝试带版本号的 DLL。
            string[] cands = new string[] {
                "python313.dll", "python312.dll", "python311.dll",
                "python310.dll", "python39.dll", "python38.dll",
                "python3.dll"
            };
            for (int i = 0; i < cands.Length; i = i + 1) {
                Python.mod = Interop.Load(cands[i]);
                if (Python.mod != 0) { break; }
            }
            if (Python.mod == 0) { return false; }
        }
        if (!Python.ResolveSymbols()) {
            Interop.Unload(Python.mod);
            Python.mod = 0;
            return false;
        }
        Python.resolved = true;
        return true;
    }

    static bool ResolveSymbols() {
        Python.addr_init = Interop.Symbol(Python.mod, "Py_Initialize");
        Python.addr_isInit = Interop.Symbol(Python.mod, "Py_IsInitialized");
        Python.addr_finalize = Interop.Symbol(Python.mod, "Py_Finalize");
        Python.addr_runSimple = Interop.Symbol(Python.mod, "PyRun_SimpleString");
        Python.addr_importModule = Interop.Symbol(Python.mod, "PyImport_ImportModule");
        Python.addr_getAttr = Interop.Symbol(Python.mod, "PyObject_GetAttrString");
        Python.addr_call = Interop.Symbol(Python.mod, "PyObject_Call");
        Python.addr_tupleNew = Interop.Symbol(Python.mod, "PyTuple_New");
        Python.addr_tupleSet = Interop.Symbol(Python.mod, "PyTuple_SetItem");
        Python.addr_tupleGet = Interop.Symbol(Python.mod, "PyTuple_GetItem");
        Python.addr_floatAsDouble = Interop.Symbol(Python.mod, "PyFloat_AsDouble");
        Python.addr_floatFromDouble = Interop.Symbol(Python.mod, "PyFloat_FromDouble");
        // Windows 的 C long 是 32 位,必须用 LongLong 变体保证 64 位整型完整。
        Python.addr_longAsLong = Interop.Symbol(Python.mod, "PyLong_AsLongLong");
        Python.addr_longFromLong = Interop.Symbol(Python.mod, "PyLong_FromLongLong");
        Python.addr_unicodeAsUtf8 = Interop.Symbol(Python.mod, "PyUnicode_AsUTF8");
        Python.addr_unicodeFromString = Interop.Symbol(Python.mod, "PyUnicode_FromString");
        Python.addr_objStr = Interop.Symbol(Python.mod, "PyObject_Str");
        Python.addr_objIsTrue = Interop.Symbol(Python.mod, "PyObject_IsTrue");
        Python.addr_boolFromLong = Interop.Symbol(Python.mod, "PyBool_FromLong");
        Python.addr_decRef = Interop.Symbol(Python.mod, "Py_DecRef");
        Python.addr_errPrint = Interop.Symbol(Python.mod, "PyErr_Print");
        Python.addr_errOccurred = Interop.Symbol(Python.mod, "PyErr_Occurred");
        Python.addr_errClear = Interop.Symbol(Python.mod, "PyErr_Clear");
        Python.addr_cfuncNew = Interop.Symbol(Python.mod, "PyCFunction_New");
        Python.addr_setAttrString = Interop.Symbol(Python.mod, "PyObject_SetAttrString");
        Python.addr_incRef = Interop.Symbol(Python.mod, "Py_IncRef");
        Python.addr_runString = Interop.Symbol(Python.mod, "PyRun_String");
        Python.addr_moduleGetDict = Interop.Symbol(Python.mod, "PyModule_GetDict");
        Python.addr_listSize = Interop.Symbol(Python.mod, "PyList_Size");
        Python.addr_listGetItem = Interop.Symbol(Python.mod, "PyList_GetItem");
        Python.addr_listNew = Interop.Symbol(Python.mod, "PyList_New");
        Python.addr_listSetItem = Interop.Symbol(Python.mod, "PyList_SetItem");
        Python.addr_getItem = Interop.Symbol(Python.mod, "PyObject_GetItem");
        Python.addr_setItem = Interop.Symbol(Python.mod, "PyObject_SetItem");
        Python.addr_dictSize = Interop.Symbol(Python.mod, "PyDict_Size");
        Python.addr_dictNext = Interop.Symbol(Python.mod, "PyDict_Next");
        Python.addr_dictNew = Interop.Symbol(Python.mod, "PyDict_New");
        Python.addr_dictSetItemString = Interop.Symbol(Python.mod, "PyDict_SetItemString");
        return Python.addr_init != 0 && Python.addr_runSimple != 0;
    }

    static void FreeModule() {
        if (Python.mod != 0) {
            Interop.Unload(Python.mod);
            Python.mod = 0;
        }
        Python.resolved = false;
        Python.addr_init = 0;
        Python.addr_isInit = 0;
        Python.addr_finalize = 0;
        Python.addr_runSimple = 0;
        Python.addr_importModule = 0;
        Python.addr_getAttr = 0;
        Python.addr_call = 0;
        Python.addr_tupleNew = 0;
        Python.addr_tupleSet = 0;
        Python.addr_tupleGet = 0;
        Python.addr_floatAsDouble = 0;
        Python.addr_floatFromDouble = 0;
        Python.addr_longAsLong = 0;
        Python.addr_longFromLong = 0;
        Python.addr_unicodeAsUtf8 = 0;
        Python.addr_unicodeFromString = 0;
        Python.addr_objStr = 0;
        Python.addr_objIsTrue = 0;
        Python.addr_boolFromLong = 0;
        Python.addr_decRef = 0;
        Python.addr_errPrint = 0;
        Python.addr_errOccurred = 0;
        Python.addr_errClear = 0;
        Python.addr_cfuncNew = 0;
        Python.addr_setAttrString = 0;
        Python.addr_incRef = 0;
        Python.addr_runString = 0;
        Python.addr_moduleGetDict = 0;
        Python.addr_listSize = 0;
        Python.addr_listGetItem = 0;
        Python.addr_listNew = 0;
        Python.addr_listSetItem = 0;
        Python.addr_getItem = 0;
        Python.addr_setItem = 0;
        Python.addr_dictSize = 0;
        Python.addr_dictNext = 0;
        Python.addr_dictNew = 0;
        Python.addr_dictSetItemString = 0;
    }

    static void DecRef(nint obj) {
        if (obj != 0) {
            PyVoid1Fn f = (PyVoid1Fn)Python.addr_decRef;
            f(obj);
        }
    }

    static void IncRef(nint obj) {
        if (obj != 0) {
            PyVoid1Fn f = (PyVoid1Fn)Python.addr_incRef;
            f(obj);
        }
    }
}

class PyRegisteredDef {
    nint def;
    nint name;

    PyRegisteredDef(nint def, nint name) {
        this.def = def;
        this.name = name;
    }
}

/// <summary>
/// 对 Python 对象的强引用。底层 PyObject* 会在
/// 该包装被 ARC 回收时释放（Py_DECREF）。
/// </summary>
class PyObject {
    nint handle;

    /// <summary>包装一个自有引用（绝不会是借用引用）。</summary>
    static PyObject Wrap(nint h) {
        PyObject o = new PyObject();
        o.handle = h;
        return o;
    }

    /// <summary>原始 PyObject*；0 表示 null（Python None 不是 null）。</summary>
    nint Raw() { return this.handle; }

    /// <summary>该对象是 Python 空指针时为 true（罕见）。</summary>
    bool IsNull() { return this.handle == 0; }

    ~PyObject() {
        if (this.handle != 0) {
            Python.DecRef(this.handle);
            this.handle = 0;
        }
    }

    /// <summary>读取属性（如 math 模块上的 "floor"）。</summary>
    PyObject GetAttr(string name) {
        PyAttrFn f = (PyAttrFn)Python.addr_getAttr;
        nint h = f(this.handle, name);
        if (h == 0) {
            PyVoidFn printErr = (PyVoidFn)Python.addr_errPrint;
            printErr();
            throw new InvalidOperationException("Python 属性访问失败: " + name);
        }
        return PyObject.Wrap(h);
    }

    /// <summary>
    /// 不抛异常地读取属性；属性不存在时返回 null PyObject
    /// （Python 错误指示器会被清除）。
    /// </summary>
    PyObject TryGetAttr(string name) {
        PyAttrFn f = (PyAttrFn)Python.addr_getAttr;
        nint h = f(this.handle, name);
        if (h == 0) {
            Python.ErrClear();
            return PyObject.Wrap(0);
        }
        return PyObject.Wrap(h);
    }

    /// <summary>写入属性：<c>obj.SetAttr("name", value)</c>。</summary>
    void SetAttr(string name, PyObject val) {
        PySetAttrFn f = (PySetAttrFn)Python.addr_setAttrString;
        int rc = f(this.handle, name, val.handle);
        if (rc != 0) {
            PyVoidFn printErr = (PyVoidFn)Python.addr_errPrint;
            printErr();
            throw new InvalidOperationException("Python 属性写入失败: " + name);
        }
    }

    /// <summary>读取序列（list/tuple）的下标：<c>obj.At(2)</c>。</summary>
    PyObject At(long index) {
        PyListSizeFn sz = (PyListSizeFn)Python.addr_listSize;
        if (sz(this.handle) < 0) {
            PyVoidFn printErr = (PyVoidFn)Python.addr_errPrint;
            printErr();
            throw new InvalidOperationException("Python At():目标不是序列");
        }
        PyListGetFn g = (PyListGetFn)Python.addr_listGetItem;
        nint item = g(this.handle, index);      // 借用引用
        if (item == 0) {
            PyVoidFn printErr = (PyVoidFn)Python.addr_errPrint;
            printErr();
            throw new InvalidOperationException("Python At():索引越界");
        }
        Python.IncRef(item);                    // 由包装持有
        return PyObject.Wrap(item);
    }

    /// <summary>写入 list 的下标：<c>obj.SetIndex(2, v)</c>。</summary>
    void SetIndex(long index, PyObject val) {
        PyListSizeFn sz = (PyListSizeFn)Python.addr_listSize;
        if (sz(this.handle) < 0) {
            PyVoidFn printErr = (PyVoidFn)Python.addr_errPrint;
            printErr();
            throw new InvalidOperationException("Python SetIndex():目标不是列表");
        }
        PyListSetFn sl = (PyListSetFn)Python.addr_listSetItem;
        Python.IncRef(val.handle);              // PyList_SetItem 会夺走引用
        int rc = sl(this.handle, index, val.handle);
        if (rc != 0) {
            PyVoidFn printErr = (PyVoidFn)Python.addr_errPrint;
            printErr();
            throw new InvalidOperationException("Python SetIndex():索引写入失败");
        }
    }

    /// <summary>用 Python 键读取元素（dict、sequence）：<c>obj.GetItem("k")</c>。</summary>
    PyObject GetItem(string key) {
        PyObject k = Python.FromStr(key);
        PyNintPairFn f = (PyNintPairFn)Python.addr_getItem;
        nint h = f(this.handle, k.handle);       // 新引用
        if (h == 0) {
            PyVoidFn printErr = (PyVoidFn)Python.addr_errPrint;
            printErr();
            throw new InvalidOperationException("Python GetItem():键不存在");
        }
        return PyObject.Wrap(h);
    }

    /// <summary>用 Python 键写入元素（dict、sequence）：<c>obj.SetItem("k", v)</c>。</summary>
    void SetItem(string key, PyObject val) {
        PyObject k = Python.FromStr(key);
        PyNint3RetFn f = (PyNint3RetFn)Python.addr_setItem;
        int rc = f(this.handle, k.handle, val.handle);
        if (rc != 0) {
            PyVoidFn printErr = (PyVoidFn)Python.addr_errPrint;
            printErr();
            throw new InvalidOperationException("Python SetItem():键写入失败");
        }
    }

    /// <summary>
    /// 运算符重载：<c>fn(a, b)</c> 调用 Python callable。由编译器
    /// 的 op_call 降级启用；标量重载自动封送
    /// string/double/long/bool 参数，PyObject 重载接收
    /// 已包装的值，params 重载则
    /// 覆盖多个 PyObject 参数。
    /// </summary>
    static PyObject op_call(PyObject self, string a) {
        return self.Call1(Python.FromStr(a));
    }

    static PyObject op_call(PyObject self, double a) {
        return self.Call1(Python.FromDouble(a));
    }

    static PyObject op_call(PyObject self, long a) {
        return self.Call1(Python.FromLong(a));
    }

    static PyObject op_call(PyObject self, bool a) {
        return self.Call1(Python.FromBool(a));
    }

    static PyObject op_call(PyObject self, PyObject a) {
        return self.Call1(a);
    }

    static PyObject op_call(PyObject self, params double[] args) {
        PyObject[] py = new PyObject[args.Length];
        for (int i = 0; i < args.Length; i = i + 1) {
            py[i] = Python.FromDouble(args[i]);
        }
        return self.Call(py);
    }

    static PyObject op_call(PyObject self, params string[] args) {
        PyObject[] py = new PyObject[args.Length];
        for (int i = 0; i < args.Length; i = i + 1) {
            py[i] = Python.FromStr(args[i]);
        }
        return self.Call(py);
    }

    static PyObject op_call(PyObject self, params long[] args) {
        PyObject[] py = new PyObject[args.Length];
        for (int i = 0; i < args.Length; i = i + 1) {
            py[i] = Python.FromLong(args[i]);
        }
        return self.Call(py);
    }

    static PyObject op_call(PyObject self, params bool[] args) {
        PyObject[] py = new PyObject[args.Length];
        for (int i = 0; i < args.Length; i = i + 1) {
            py[i] = Python.FromBool(args[i]);
        }
        return self.Call(py);
    }

    static PyObject op_call(PyObject self, params PyObject[] args) {
        return self.Call(args);
    }

    /// <summary>运算符重载：<c>list[2]</c> 读取下标，同 <see cref="At"/>。</summary>
    static PyObject op_index(PyObject self, long index) {
        return self.At(index);
    }

    /// <summary>运算符重载：<c>dict["k"]</c> 读取元素，同 <see cref="GetItem"/>。</summary>
    static PyObject op_index(PyObject self, string key) {
        return self.GetItem(key);
    }

    /// <summary>运算符重载：<c>list[2] = v</c> 写入下标，同 <see cref="SetIndex"/>。</summary>
    static void op_index_set(PyObject self, long index, PyObject val) {
        self.SetIndex(index, val);
    }

    /// <summary>运算符重载：<c>list[2] = "s"</c> 封送字符串值。</summary>
    static void op_index_set(PyObject self, long index, string val) {
        self.SetIndex(index, Python.FromStr(val));
    }

    /// <summary>运算符重载：<c>dict["k"] = v</c> 写入元素，同 <see cref="SetItem"/>。</summary>
    static void op_index_set(PyObject self, string key, PyObject val) {
        self.SetItem(key, val);
    }

    /// <summary>运算符重载：<c>dict["k"] = "s"</c> 封送字符串值。</summary>
    static void op_index_set(PyObject self, string key, string val) {
        self.SetItem(key, Python.FromStr(val));
    }

    /// <summary>不带参数调用对象。</summary>
    PyObject Call0() {
        return this.CallTuple(0);
    }

    /// <summary>带一个参数调用对象。</summary>
    PyObject Call1(PyObject a) {
        PyTupleNewFn n = (PyTupleNewFn)Python.addr_tupleNew;
        PyTupleSetFn s = (PyTupleSetFn)Python.addr_tupleSet;
        nint t = n(1);
        Python.IncRef(a.handle);                // tuple 会夺走引用；包装保留自己的
        s(t, 0, a.handle);
        return this.CallTuple(t);
    }

    /// <summary>带两个参数调用对象。</summary>
    PyObject Call2(PyObject a, PyObject b) {
        PyTupleNewFn n = (PyTupleNewFn)Python.addr_tupleNew;
        PyTupleSetFn s = (PyTupleSetFn)Python.addr_tupleSet;
        nint t = n(2);
        Python.IncRef(a.handle);
        Python.IncRef(b.handle);
        s(t, 0, a.handle);
        s(t, 1, b.handle);
        return this.CallTuple(t);
    }

    /// <summary>带三个参数调用对象。</summary>
    PyObject Call3(PyObject a, PyObject b, PyObject c) {
        PyTupleNewFn n = (PyTupleNewFn)Python.addr_tupleNew;
        PyTupleSetFn s = (PyTupleSetFn)Python.addr_tupleSet;
        nint t = n(3);
        Python.IncRef(a.handle);
        Python.IncRef(b.handle);
        Python.IncRef(c.handle);
        s(t, 0, a.handle);
        s(t, 1, b.handle);
        s(t, 2, c.handle);
        return this.CallTuple(t);
    }

    /// <summary>
    /// 以任意数量的参数调用对象：
    /// <c>fn.Call(Python.FromDouble(1.0), Python.FromStr("x"))</c> 或传入
    /// 预构建的 <c>PyObject[]</c>。取代 Call0..3；它们为兼容性保留。
    /// </summary>
    PyObject Call(params PyObject[] args) {
        int n = args.Length;
        PyTupleNewFn nt = (PyTupleNewFn)Python.addr_tupleNew;
        PyTupleSetFn st = (PyTupleSetFn)Python.addr_tupleSet;
        nint t = nt(n);
        for (int i = 0; i < n; i = i + 1) {
            Python.IncRef(args[i].handle);      // tuple 会夺走引用；包装保留自己的
            st(t, i, args[i].handle);
        }
        return this.CallTuple(t);
    }

    PyObject CallTuple(nint tuple) {
        PyNint2Fn f = (PyNint2Fn)Python.addr_call;
        nint h = f(this.handle, tuple, 0);
        Python.DecRef(tuple);                    // tuple 由我们持有
        if (h == 0) {
            PyVoidFn printErr = (PyVoidFn)Python.addr_errPrint;
            printErr();
            throw new InvalidOperationException("Python 调用失败");
        }
        return PyObject.Wrap(h);
    }

    /// <summary>将对象读为 double。</summary>
    double ToDouble() { return Python.ToDouble(this); }

    /// <summary>将对象读为 64 位整数。</summary>
    long ToLong() { return Python.ToLong(this); }

    /// <summary>将对象读为字符串（str(obj)）。</summary>
    string ToStr() { return Python.ToStr(this); }

    /// <summary>读取对象的真值。</summary>
    bool ToBool() { return Python.ToBool(this); }

    /// <summary>将 Python list 拆为 PyObject 列表。</summary>
    List<PyObject> ToList() {
        PyListSizeFn sz = (PyListSizeFn)Python.addr_listSize;
        long n = sz(this.handle);
        if (n < 0) {
            PyVoidFn printErr = (PyVoidFn)Python.addr_errPrint;
            printErr();
            throw new InvalidOperationException("Python ToList():目标不是列表");
        }
        List<PyObject> outList = new List<PyObject>();
        PyListGetFn g = (PyListGetFn)Python.addr_listGetItem;
        for (long i = 0; i < n; i = i + 1) {
            nint item = g(this.handle, i);      // 借用引用
            Python.IncRef(item);
            outList.Add(PyObject.Wrap(item));
        }
        return outList;
    }

    /// <summary>将 Python list 拆为 double 列表。</summary>
    List<double> ToListDouble() {
        List<PyObject> items = this.ToList();
        List<double> outList = new List<double>();
        for (int i = 0; i < items.Count; i = i + 1) {
            outList.Add(items[i].ToDouble());
        }
        return outList;
    }

    /// <summary>将 Python list 拆为字符串列表（逐个 str()）。</summary>
    List<string> ToListStr() {
        List<PyObject> items = this.ToList();
        List<string> outList = new List<string>();
        for (int i = 0; i < items.Count; i = i + 1) {
            outList.Add(items[i].ToStr());
        }
        return outList;
    }

    /// <summary>
    /// 将 Python dict 拆为以字符串为键的 PyObject 映射。键
    /// 通过 str() 读取，因此非字符串键也能转换。
    /// </summary>
    Dictionary<string, PyObject> ToDict() {
        PyDictSizeFn sz = (PyDictSizeFn)Python.addr_dictSize;
        if (sz(this.handle) < 0) {
            PyVoidFn printErr = (PyVoidFn)Python.addr_errPrint;
            printErr();
            throw new InvalidOperationException("Python ToDict():目标不是 dict");
        }
        Dictionary<string, PyObject> outMap = new Dictionary<string, PyObject>();
        nint pos = NativeMemory.Alloc(8);
        nint keyOut = NativeMemory.Alloc(8);
        nint valOut = NativeMemory.Alloc(8);
        new Span<long>(pos, 1)[0] = 0;
        PyDictNextFn nx = (PyDictNextFn)Python.addr_dictNext;
        PyStrRetFn u = (PyStrRetFn)Python.addr_unicodeAsUtf8;
        while (nx(this.handle, pos, keyOut, valOut) != 0) {
            nint key = new Span<nint>(keyOut, 1)[0];   // 借用引用
            nint val = new Span<nint>(valOut, 1)[0];   // 借用引用
            string ks = u(key);
            Python.IncRef(val);
            outMap[ks] = PyObject.Wrap(val);
        }
        NativeMemory.Free(pos);
        NativeMemory.Free(keyOut);
        NativeMemory.Free(valOut);
        return outMap;
    }
}

// ---- PyCFunction 回调形式：PyObject* (*)(PyObject*, PyObject*) ------
delegate nint PyCFunction(nint self, nint args);

// ---- 已解析入口点的内部调用形式 -----------------------
delegate void PyVoidFn();
delegate int PyIntFn();
delegate int PyIntStrFn(string s);
delegate nint PyNintStrFn(string s);
delegate nint PyNint1Fn(nint a);
delegate nint PyNint2Fn(nint a, nint b, nint c);
delegate nint PyNintPairFn(nint a, nint b);
delegate int PyNint3RetFn(nint a, nint b, nint c);
delegate nint PyAttrFn(nint obj, string name);
delegate void PyVoid1Fn(nint a);
delegate double PyDoubleFn(nint obj);
delegate nint PyDoubleRetFn(double v);
delegate long PyLongFn(nint obj);
delegate nint PyLongRetFn(long v);
delegate string PyStrRetFn(nint obj);
delegate nint PyTupleNewFn(long size);
delegate int PyTupleSetFn(nint t, long i, nint v);
delegate nint PyTupleGetFn(nint t, long i);
delegate nint PyBoolRetFn(int v);
delegate nint PyCfuncNewFn(nint def, nint self);
delegate int PySetAttrFn(nint obj, string name, nint val);
delegate nint PyRunStringFn(string code, int start, nint globals, nint locals);
delegate long PyListSizeFn(nint list);
delegate nint PyListGetFn(nint list, long index);
delegate nint PyListNewFn(long size);
delegate int PyListSetFn(nint list, long index, nint v);
delegate long PyDictSizeFn(nint dict);
delegate int PyDictNextFn(nint dict, nint pos, nint keyOut, nint valOut);
delegate nint PyDictNewFn();
delegate int PyDictSetStrFn(nint dict, string key, nint val);
