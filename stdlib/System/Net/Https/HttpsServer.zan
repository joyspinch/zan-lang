using System;
using System.Net.Sockets;
using System.Net.Http;
using System.Net.Tls;

namespace System.Net.Https;

/// <summary>
/// 基于协程的 HTTPS（HTTP/1.1 over TLS）服务器。编程模型与
/// <see cref="HttpServer"/> 相同，每个连接通过
/// <see cref="TlsStream"/>（OpenSSL）进行 TLS 加密。
///
/// 用法：
///   HttpsServer server = HttpsServer.Create("0.0.0.0", 8443,
///                                           "cert.pem", "key.pem");
///   server.OnRequest(HandleRequest);
///   await server.Start();
/// </summary>
class HttpsServer {
    TcpListener listener;
    TlsContext tls;
    string host;
    int port;
    bool running;
    int activeConnections;
    int maxRequestBytes;
    HttpRequestHandler requestHandler;

    HttpsServer(string host, int port) {
        this.host = host;
        this.port = port;
        this.running = false;
        this.activeConnections = 0;
        this.maxRequestBytes = 1048576;
        this.requestHandler = null;
        this.tls = null;
    }

    /// <summary>从 PEM 证书链与 PEM 私钥创建 HTTPS 服务器；
    /// 证书/私钥无法加载时返回 null。
    /// </summary>
    static HttpsServer Create(string host, int port, string certFile, string keyFile) {
        HttpsServer server = new HttpsServer(host, port);
        server.tls = TlsContext.CreateServer(certFile, keyFile);
        if (server.tls == null) {
            return null;
        }
        return server;
    }

    /// <summary>设置单个请求的最大可接受大小（字节），
    /// （请求头 + 请求体）。</summary>
    HttpsServer SetMaxRequestBytes(int bytes) {
        this.maxRequestBytes = bytes;
        return this;
    }

    /// <summary>注册每个传入请求都会调用的处理器。</summary>
    HttpsServer OnRequest(HttpRequestHandler handler) {
        this.requestHandler = handler;
        return this;
    }

    /// <summary>启动 HTTPS 服务器事件循环。持续运行，在协程上
    /// 接受并处理连接。</summary>
    async void Start() {
        Socket.Initialize();
        this.listener = new TcpListener(this.host, this.port);
        this.listener.Start();
        this.running = true;

        while (this.running) {
            nint clientSock = await this.listener.AcceptAsync();
            if (clientSock >= 0) {
                this.activeConnections = this.activeConnections + 1;
                Task.Spawn(HandleConnection(clientSock));
            }
        }
    }

    /// <summary>停止接受新连接。</summary>
    void Stop() {
        this.running = false;
    }

    /// <summary>对一个客户端连接执行 TLS 握手，随后用与
    /// <see cref="HttpServer.HandleConnection"/> 相同的帧解析
    /// 服务其上的 HTTP/1.1 请求（支持 keep-alive 与流水线）。</summary>
    async void HandleConnection(nint clientSock) {
        Socket.SetNonBlocking(clientSock);
        TlsStream stream = await TlsStream.AcceptAsync(this.tls, clientSock);
        if (stream == null) {
            Socket.Close(clientSock);
            this.activeConnections = this.activeConnections - 1;
            return;
        }

        bool keepAlive = true;
        string buffer = "";
        int reject = 0;

        while (keepAlive) {
            int headerEnd = HttpServer.FindHeaderEnd(buffer);
            while (headerEnd < 0) {
                if (buffer.Length > this.maxRequestBytes) { reject = 413; break; }
                string chunk = await stream.RecvAsync(65536);
                if (chunk.Length == 0) { keepAlive = false; break; }
                buffer = buffer + chunk;
                headerEnd = HttpServer.FindHeaderEnd(buffer);
            }
            if (reject != 0) { break; }
            if (!keepAlive) { break; }

            HttpRequest request = HttpRequest.Parse(buffer);
            // 定界失败（Content-Length 溢出/重复不一致、非数字、
            // Transfer-Encoding 未实现等）→ 拒绝，不切分正文。
            if (request.parseStatus != 0) {
                reject = request.parseStatus;
                break;
            }
            int bodyLen = request.contentLength;
            if (bodyLen < 0) { bodyLen = 0; }
            int need = headerEnd + bodyLen;
            if (need > this.maxRequestBytes) { reject = 413; break; }
            while (buffer.Length < need) {
                string chunk = await stream.RecvAsync(65536);
                if (chunk.Length == 0) { keepAlive = false; break; }
                buffer = buffer + chunk;
            }
            if (!keepAlive && buffer.Length < need) { break; }

            if (bodyLen > 0) {
                request.body = buffer.Substring(headerEnd, bodyLen);
            } else {
                request.body = "";
            }
            if (buffer.Length > need) {
                buffer = buffer.Substring(need);
            } else {
                buffer = "";
            }
            keepAlive = request.keepAlive;

            HttpResponse response = ProcessRequest(request);
            response = response.SetKeepAlive(keepAlive);

            string responseData = response.Build();
            int _sent = await stream.SendAsync(responseData, responseData.Length);

            if (!keepAlive) {
                break;
            }
        }

        if (reject == 413) {
            HttpResponse tooLarge = HttpResponse.WithStatus(413, "Payload Too Large", "request exceeds limit");
            tooLarge = tooLarge.SetKeepAlive(false);
            string data = tooLarge.Build();
            int _s = await stream.SendAsync(data, data.Length);
        } else if (reject == 400) {
            // 定界冲突/畸形长度：请求走私拒绝，必须关闭连接。
            HttpResponse bad = HttpResponse.WithStatus(400, "Bad Request",
                "malformed request framing");
            bad = bad.SetKeepAlive(false);
            string data = bad.Build();
            int _b = await stream.SendAsync(data, data.Length);
        } else if (reject == 501) {
            HttpResponse nai = HttpResponse.WithStatus(501, "Not Implemented",
                "Transfer-Encoding is not supported");
            nai = nai.SetKeepAlive(false);
            string data = nai.Build();
            int _n = await stream.SendAsync(data, data.Length);
        }

        stream.Close();
        Socket.Close(clientSock);
        this.activeConnections = this.activeConnections - 1;
    }

    HttpResponse ProcessRequest(HttpRequest request) {
        HttpRequestHandler handler = this.requestHandler;
        if (handler != null) {
            return handler(request);
        }
        return HttpResponse.Ok("<h1>Zan HTTPS Server</h1><p>Override ProcessRequest to handle routes.</p>");
    }
}
