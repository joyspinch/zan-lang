using System;
using System.Net.Sockets;

namespace System.Net.Modbus;

/// <summary>
/// Modbus TCP client -- the dominant fieldbus protocol for PLCs, meters and
/// industrial sensors, default port 502.
///
/// Coroutine-friendly like MqttClient: every operation awaits the non-blocking
/// socket, and replies are reassembled from the MBAP length prefix so parsing
/// stays framed however the device segments its writes.
///
/// Register values are 16-bit (0..65535); addresses are zero-based protocol
/// addresses (the "40001" documentation convention maps to address 0).
///
/// Usage:
///   ModbusClient m = await ModbusClient.ConnectAsync("192.168.1.10", 502, 1);
///   List<int> regs = await m.ReadHoldingAsync(0, 4);   // 4 registers from 0
///   int ok = await m.WriteRegisterAsync(10, 1234);
///   List<int> bits = await m.ReadCoilsAsync(0, 8);
///   m.Close();
/// </summary>
class ModbusClient {
    TcpClient conn;
    int unitId;
    int nextTid;
    bool connected;
    // "" after a clean exchange; a short reason after a failure so callers can
    // tell an exception reply from a dead link.
    string lastError;

    ModbusClient() {
        this.unitId = 1;
        this.nextTid = 1;
        this.connected = false;
        this.lastError = "";
    }

    /// <summary>Connects to a Modbus TCP endpoint. <paramref name="unit"/> is
    /// the unit/slave id (1 for most TCP devices, meaningful behind
    /// gateways).</summary>
    static async ModbusClient ConnectAsync(string host, int port, int unit) {
        ModbusClient m = new ModbusClient();
        m.unitId = unit;
        m.conn = await TcpClient.ConnectAsync(host, port);
        if (m.conn != null) { m.connected = true; }
        return m;
    }

    bool IsConnected() { return this.connected; }

    /// <summary>Failure reason of the last exchange ("" when it succeeded).</summary>
    string LastError() { return this.lastError; }

    void Close() {
        if (this.conn != null) { this.conn.Close(); }
        this.connected = false;
    }

    // Reads exactly `need` bytes, awaiting the reactor across recvs.
    async byte[] ReadBytesAsync(int need) {
        byte[] buf = new byte[need + 1];
        byte[] tmp = new byte[need + 1];
        nint sock = this.conn.GetSocket();
        int got = 0;
        while (got < need) {
            await Socket.ReadReady(sock);
            int n = Socket.Recv(sock, tmp, need - got);
            if (n == 0) {
                this.connected = false;
                return buf;
            }
            if (n > 0) {
                for (int i = 0; i < n; i = i + 1) {
                    buf[got] = (byte)(tmp[i]);
                    got = got + 1;
                }
            }
        }
        return buf;
    }

    // One request/response round trip: MBAP header + PDU out, framed reply
    // PDU back (function byte + data). Returns an empty array on transport
    // failure or an exception reply, with lastError set.
    async byte[] TransactAsync(byte[] pdu, int pduLen) {
        this.lastError = "";
        if (!this.connected) {
            this.lastError = "not connected";
            return new byte[1];
        }
        int tid = this.nextTid & 65535;
        this.nextTid = this.nextTid + 1;

        byte[] req = new byte[7 + pduLen];
        req[0] = (byte)((tid >> 8) & 255);
        req[1] = (byte)(tid & 255);
        req[2] = 0;                              // protocol id
        req[3] = 0;
        req[4] = (byte)(((pduLen + 1) >> 8) & 255);
        req[5] = (byte)((pduLen + 1) & 255);
        req[6] = (byte)(this.unitId);
        for (int i = 0; i < pduLen; i = i + 1) {
            req[7 + i] = (byte)(pdu[i]);
        }
        int _s = await this.conn.SendBytesAsync(req, 7 + pduLen);

        byte[] mbap = await ReadBytesAsync(7);
        if (!this.connected) {
            this.lastError = "connection closed";
            return new byte[1];
        }
        int len = ((mbap[4] & 255) << 8) + (mbap[5] & 255);
        if (len < 2 || len > 260) {
            this.lastError = "bad frame length";
            this.connected = false;
            return new byte[1];
        }
        // MBAP length counts unit id + PDU; the unit id arrived as mbap[6].
        byte[] body = await ReadBytesAsync(len - 1);
        if (!this.connected) {
            this.lastError = "connection closed";
            return new byte[1];
        }
        // body[0] is the function code echo; 0x80 bit marks an exception.
        if ((body[0] & 128) != 0) {
            this.lastError = "exception code "
                + Convert.ToString(body[1] & 255);
            return new byte[1];
        }
        byte[] outb = new byte[len];
        for (int j = 0; j < len - 1; j = j + 1) {
            outb[j] = (byte)(body[j]);
        }
        return outb;
    }

    // Shared reader for coils (fc 1), discrete inputs (fc 2): one int per bit.
    async List<int> ReadBitsAsync(int fc, int addr, int count) {
        byte[] pdu = new byte[5];
        pdu[0] = (byte)(fc);
        pdu[1] = (byte)((addr >> 8) & 255);
        pdu[2] = (byte)(addr & 255);
        pdu[3] = (byte)((count >> 8) & 255);
        pdu[4] = (byte)(count & 255);
        byte[] r = await TransactAsync(pdu, 5);
        List<int> vals = new List<int>();
        if (this.lastError.Length > 0) { return vals; }
        int nBytes = r[1] & 255;
        for (int k = 0; k < count && (k / 8) < nBytes; k = k + 1) {
            int b = r[2 + k / 8] & 255;
            vals.Add((b >> (k % 8)) & 1);
        }
        return vals;
    }

    // Shared reader for holding (fc 3) / input (fc 4) registers.
    async List<int> ReadRegsAsync(int fc, int addr, int count) {
        byte[] pdu = new byte[5];
        pdu[0] = (byte)(fc);
        pdu[1] = (byte)((addr >> 8) & 255);
        pdu[2] = (byte)(addr & 255);
        pdu[3] = (byte)((count >> 8) & 255);
        pdu[4] = (byte)(count & 255);
        byte[] r = await TransactAsync(pdu, 5);
        List<int> vals = new List<int>();
        if (this.lastError.Length > 0) { return vals; }
        int nBytes = r[1] & 255;
        for (int k = 0; k < count && k * 2 + 1 < nBytes; k = k + 1) {
            vals.Add(((r[2 + k * 2] & 255) << 8) + (r[3 + k * 2] & 255));
        }
        return vals;
    }

    /// <summary>Reads coils (function 1): one 0/1 int per coil.</summary>
    async List<int> ReadCoilsAsync(int addr, int count) {
        List<int> r = await ReadBitsAsync(1, addr, count);
        return r;
    }

    /// <summary>Reads discrete inputs (function 2): one 0/1 int per input.</summary>
    async List<int> ReadDiscreteAsync(int addr, int count) {
        List<int> r = await ReadBitsAsync(2, addr, count);
        return r;
    }

    /// <summary>Reads holding registers (function 3).</summary>
    async List<int> ReadHoldingAsync(int addr, int count) {
        List<int> r = await ReadRegsAsync(3, addr, count);
        return r;
    }

    /// <summary>Reads input registers (function 4).</summary>
    async List<int> ReadInputAsync(int addr, int count) {
        List<int> r = await ReadRegsAsync(4, addr, count);
        return r;
    }

    /// <summary>Writes one coil (function 5). Returns 1 on success, 0 on
    /// failure (see LastError).</summary>
    async int WriteCoilAsync(int addr, bool on) {
        byte[] pdu = new byte[5];
        pdu[0] = 5;
        pdu[1] = (byte)((addr >> 8) & 255);
        pdu[2] = (byte)(addr & 255);
        if (on) { pdu[3] = 255; } else { pdu[3] = 0; }
        pdu[4] = 0;
        byte[] _r = await TransactAsync(pdu, 5);
        if (this.lastError.Length > 0) { return 0; }
        return 1;
    }

    /// <summary>Writes one holding register (function 6). Returns 1 on
    /// success, 0 on failure (see LastError).</summary>
    async int WriteRegisterAsync(int addr, int val) {
        byte[] pdu = new byte[5];
        pdu[0] = 6;
        pdu[1] = (byte)((addr >> 8) & 255);
        pdu[2] = (byte)(addr & 255);
        pdu[3] = (byte)((val >> 8) & 255);
        pdu[4] = (byte)(val & 255);
        byte[] _r = await TransactAsync(pdu, 5);
        if (this.lastError.Length > 0) { return 0; }
        return 1;
    }

    /// <summary>Writes several holding registers (function 16). Returns 1 on
    /// success, 0 on failure (see LastError).</summary>
    async int WriteRegistersAsync(int addr, List<int> values) {
        int n = values.Count;
        byte[] pdu = new byte[6 + n * 2];
        pdu[0] = 16;
        pdu[1] = (byte)((addr >> 8) & 255);
        pdu[2] = (byte)(addr & 255);
        pdu[3] = (byte)((n >> 8) & 255);
        pdu[4] = (byte)(n & 255);
        pdu[5] = (byte)(n * 2);
        for (int i = 0; i < n; i = i + 1) {
            pdu[6 + i * 2] = (byte)((values[i] >> 8) & 255);
            pdu[7 + i * 2] = (byte)(values[i] & 255);
        }
        byte[] _r = await TransactAsync(pdu, 6 + n * 2);
        if (this.lastError.Length > 0) { return 0; }
        return 1;
    }
}
