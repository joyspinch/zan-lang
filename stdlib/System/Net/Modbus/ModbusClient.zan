using System;
using System.Net.Sockets;

namespace System.Net.Modbus;

/// <summary>
/// Modbus TCP 客户端——用于 PLC、仪表与工业传感器的
/// 主流现场总线协议，默认端口 502。
///
/// 与 MqttClient 一样对协程友好：每个操作都 await 非阻塞套接字，
/// 响应依据 MBAP 长度前缀重新组装，
/// 无论设备如何分段写入，解析都能保持帧同步。
///
/// 寄存器值为 16 位（0..65535）；地址为基于零的协议地址
/// （文档中 "40001" 的约定对应地址 0）。
///
/// 用法：
///   ModbusClient m = await ModbusClient.ConnectAsync("192.168.1.10", 502, 1);
///   List<int> regs = await m.ReadHoldingAsync(0, 4);   // 4 registers from 0
///   int ok = await m.WriteRegisterAsync(10, 1234);
///   List<int> bits = await m.ReadCoilsAsync(0, 8);
///   m.Close();
/// </summary>
class ModbusClient {
    TcpClient conn;
    int unitId;
    int nextTid;
    bool connected;
    // 成功交换后为空 ""；失败后为简短原因，
    // 以便调用方区分异常应答与链路断开。
    string lastError;

    ModbusClient() {
        this.unitId = 1;
        this.nextTid = 1;
        this.connected = false;
        this.lastError = "";
    }

    /// <summary>连接 Modbus TCP 端点。<paramref name="unit"/> 是
    /// 单元/从站 id（大多数 TCP 设备为 1，
    /// 在网关之后才有意义）。</summary>
    static async ModbusClient ConnectAsync(string host, int port, int unit) {
        ModbusClient m = new ModbusClient();
        m.unitId = unit;
        m.conn = await TcpClient.ConnectAsync(host, port);
        if (m.conn != null) { m.connected = true; }
        return m;
    }

    bool IsConnected() { return this.connected; }

    /// <summary>上一次交换的失败原因（成功时为 ""）。</summary>
    string LastError() { return this.lastError; }

    void Close() {
        if (this.conn != null) { this.conn.Close(); }
        this.connected = false;
    }

    // 在 reactor 上挂起，跨多次 recv 精确读取 `need` 个字节。
    async byte[] ReadBytesAsync(int need) {
        byte[] buf = new byte[need + 1];
        byte[] tmp = new byte[need + 1];
        nint sock = this.conn.GetSocket();
        int got = 0;
        while (got < need) {
            await Socket.ReadReady(sock);
            int n = Socket.Recv(sock, tmp, need - got);
            if (n == 0) {
                this.connected = false;
                return buf;
            }
            if (n > 0) {
                for (int i = 0; i < n; i = i + 1) {
                    buf[got] = (byte)(tmp[i]);
                    got = got + 1;
                }
            }
        }
        return buf;
    }

    // 一次请求/响应往返：发送 MBAP 头 + PDU，接收帧化的
    // 应答 PDU（功能字节 + 数据）。传输失败或收到异常应答时
    // 返回空数组，并设置 lastError。
    async byte[] TransactAsync(byte[] pdu, int pduLen) {
        this.lastError = "";
        if (!this.connected) {
            this.lastError = "not connected";
            return new byte[1];
        }
        int tid = this.nextTid & 65535;
        this.nextTid = this.nextTid + 1;

        byte[] req = new byte[7 + pduLen];
        req[0] = (byte)((tid >> 8) & 255);
        req[1] = (byte)(tid & 255);
        req[2] = 0;                              // 协议标识
        req[3] = 0;
        req[4] = (byte)(((pduLen + 1) >> 8) & 255);
        req[5] = (byte)((pduLen + 1) & 255);
        req[6] = (byte)(this.unitId);
        for (int i = 0; i < pduLen; i = i + 1) {
            req[7 + i] = (byte)(pdu[i]);
        }
        int _s = await this.conn.SendBytesAsync(req, 7 + pduLen);

        byte[] mbap = await ReadBytesAsync(7);
        if (!this.connected) {
            this.lastError = "connection closed";
            return new byte[1];
        }
        int len = ((mbap[4] & 255) << 8) + (mbap[5] & 255);
        if (len < 2 || len > 260) {
            this.lastError = "bad frame length";
            this.connected = false;
            return new byte[1];
        }
        // MBAP 长度字段计入 unit id + PDU；unit id 位于 mbap[6]。
        byte[] body = await ReadBytesAsync(len - 1);
        if (!this.connected) {
            this.lastError = "connection closed";
            return new byte[1];
        }
        // body[0] 为功能码回显；0x80 位表示异常应答。
        if ((body[0] & 128) != 0) {
            this.lastError = "exception code "
                + Convert.ToString(body[1] & 255);
            return new byte[1];
        }
        byte[] outb = new byte[len];
        for (int j = 0; j < len - 1; j = j + 1) {
            outb[j] = (byte)(body[j]);
        }
        return outb;
    }

    // 线圈（fc 1）与离散输入（fc 2）共用的读取器：每个位对应一个 int。
    async List<int> ReadBitsAsync(int fc, int addr, int count) {
        byte[] pdu = new byte[5];
        pdu[0] = (byte)(fc);
        pdu[1] = (byte)((addr >> 8) & 255);
        pdu[2] = (byte)(addr & 255);
        pdu[3] = (byte)((count >> 8) & 255);
        pdu[4] = (byte)(count & 255);
        byte[] r = await TransactAsync(pdu, 5);
        List<int> vals = new List<int>();
        if (this.lastError.Length > 0) { return vals; }
        int nBytes = r[1] & 255;
        for (int k = 0; k < count && (k / 8) < nBytes; k = k + 1) {
            int b = r[2 + k / 8] & 255;
            vals.Add((b >> (k % 8)) & 1);
        }
        return vals;
    }

    // 保持（fc 3）与输入（fc 4）寄存器共用的读取器。
    async List<int> ReadRegsAsync(int fc, int addr, int count) {
        byte[] pdu = new byte[5];
        pdu[0] = (byte)(fc);
        pdu[1] = (byte)((addr >> 8) & 255);
        pdu[2] = (byte)(addr & 255);
        pdu[3] = (byte)((count >> 8) & 255);
        pdu[4] = (byte)(count & 255);
        byte[] r = await TransactAsync(pdu, 5);
        List<int> vals = new List<int>();
        if (this.lastError.Length > 0) { return vals; }
        int nBytes = r[1] & 255;
        for (int k = 0; k < count && k * 2 + 1 < nBytes; k = k + 1) {
            vals.Add(((r[2 + k * 2] & 255) << 8) + (r[3 + k * 2] & 255));
        }
        return vals;
    }

    /// <summary>读取线圈（功能码 1）：每个线圈对应一个 0/1 int。</summary>
    async List<int> ReadCoilsAsync(int addr, int count) {
        List<int> r = await ReadBitsAsync(1, addr, count);
        return r;
    }

    /// <summary>读取离散输入（功能码 2）：每个输入对应一个 0/1 int。</summary>
    async List<int> ReadDiscreteAsync(int addr, int count) {
        List<int> r = await ReadBitsAsync(2, addr, count);
        return r;
    }

    /// <summary>读取保持寄存器（功能码 3）。</summary>
    async List<int> ReadHoldingAsync(int addr, int count) {
        List<int> r = await ReadRegsAsync(3, addr, count);
        return r;
    }

    /// <summary>读取输入寄存器（功能码 4）。</summary>
    async List<int> ReadInputAsync(int addr, int count) {
        List<int> r = await ReadRegsAsync(4, addr, count);
        return r;
    }

    /// <summary>写入单个线圈（功能码 5）。成功返回 1，失败返回 0
    /// （详见 LastError）。</summary>
    async int WriteCoilAsync(int addr, bool on) {
        byte[] pdu = new byte[5];
        pdu[0] = 5;
        pdu[1] = (byte)((addr >> 8) & 255);
        pdu[2] = (byte)(addr & 255);
        if (on) { pdu[3] = 255; } else { pdu[3] = 0; }
        pdu[4] = 0;
        byte[] _r = await TransactAsync(pdu, 5);
        if (this.lastError.Length > 0) { return 0; }
        return 1;
    }

    /// <summary>写入单个保持寄存器（功能码 6）。成功返回 1，
    /// 失败返回 0（详见 LastError）。</summary>
    async int WriteRegisterAsync(int addr, int val) {
        byte[] pdu = new byte[5];
        pdu[0] = 6;
        pdu[1] = (byte)((addr >> 8) & 255);
        pdu[2] = (byte)(addr & 255);
        pdu[3] = (byte)((val >> 8) & 255);
        pdu[4] = (byte)(val & 255);
        byte[] _r = await TransactAsync(pdu, 5);
        if (this.lastError.Length > 0) { return 0; }
        return 1;
    }

    /// <summary>批量写入保持寄存器（功能码 16）。成功返回 1，
    /// 失败返回 0（详见 LastError）。</summary>
    async int WriteRegistersAsync(int addr, List<int> values) {
        int n = values.Count;
        byte[] pdu = new byte[6 + n * 2];
        pdu[0] = 16;
        pdu[1] = (byte)((addr >> 8) & 255);
        pdu[2] = (byte)(addr & 255);
        pdu[3] = (byte)((n >> 8) & 255);
        pdu[4] = (byte)(n & 255);
        pdu[5] = (byte)(n * 2);
        for (int i = 0; i < n; i = i + 1) {
            pdu[6 + i * 2] = (byte)((values[i] >> 8) & 255);
            pdu[7 + i * 2] = (byte)(values[i] & 255);
        }
        byte[] _r = await TransactAsync(pdu, 6 + n * 2);
        if (this.lastError.Length > 0) { return 0; }
        return 1;
    }
}
