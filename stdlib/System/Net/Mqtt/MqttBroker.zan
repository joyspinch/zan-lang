using System;
using System.Net.Sockets;
using System.Text;
using System.Json;

namespace System.Net.Mqtt;

/// <summary>
/// broker 持有的单个已连接 MQTT 客户端会话：其套接字、客户端 id
/// 与当前生效的主题过滤器。
/// </summary>
class MqttSession {
    int id;
    nint sock;
    string clientId;
    string addr;
    List<string> filters;
    List<int> qos;
    bool alive;
    bool connected;
    int connectedAt;
    int keepAlive;
    int msgsIn;
    int msgsOut;

    MqttSession(nint sock) {
        this.id = 0;
        this.sock = sock;
        this.clientId = "";
        this.addr = "";
        this.filters = new List<string>();
        this.qos = new List<int>();
        this.alive = true;
        this.connected = false;
        this.connectedAt = 0;
        this.keepAlive = 0;
        this.msgsIn = 0;
        this.msgsOut = 0;
    }
}

/// <summary>为管理 API 维护的按主题计数器。</summary>
class MqttTopicStat {
    string name;
    int messages;
    string lastPayload;

    MqttTopicStat(string name) {
        this.name = name;
        this.messages = 0;
        this.lastPayload = "";
    }
}

// ---- management-snapshot entities ----------------------------------------
// broker 的管理 JSON（clients / subscriptions / topics / metrics）
// 以类声明并通过 Json.Serialize<T> 序列化；字段名
// 与文档定义的结构保持一致。

class MqttClientDoc {
    int id;
    string client_id;
    string addr;
    int connected_at;
    int keepalive;
    int subs;
    int msgs_in;
    int msgs_out;
}

class MqttSubDoc {
    string filter;
    int qos;
}

class MqttClientDetailDoc {
    int id;
    string client_id;
    string addr;
    int connected_at;
    int msgs_in;
    int msgs_out;
    List<MqttSubDoc> subscriptions;
}

class MqttSubEntryDoc {
    string client_id;
    string filter;
    int qos;
}

class MqttTopicDoc {
    string topic;
    int messages;
    string last;
}

class MqttMetricsDoc {
    int uptime_sec;
    int clients_connected;
    int clients_total;
    int subscriptions;
    int topics;
    int messages_in;
    int messages_out;
    int bytes_in;
    int bytes_out;
}

/// <summary>
/// MQTT v3.1.1 broker（<see cref="MqttClient"/> 的服务端）。
///
/// 支持 CONNECT/CONNACK、QoS 0 与 1 的 PUBLISH（PUBACK）、SUBSCRIBE/SUBACK、
/// UNSUBSCRIBE/UNSUBACK、PINGREQ/PINGRESP 与 DISCONNECT，支持 `+` 和 `#`
/// 主题过滤器通配符。QoS 2 会降级为 1。未实现保留消息与
/// 持久会话。
///
/// 独立的监听循环已退役——唯一的宿主是 Worker：协议 "mqtt" 的
/// worker 由 Worker 接受连接并为每个客户端调用
/// <see cref="HandleConnection"/>。注意多进程模式下每个 worker 持有
/// 自己的会话表：发布者只能触达同一 worker 接受的订阅者，
/// 因此需要全局广播的 broker 应使用 count = 1。
/// </summary>
class MqttBroker {
    List<MqttSession> sessions;
    List<MqttTopicStat> topics;

    int nextId;
    int startedAt;
    int totalConnections;
    int msgsIn;
    int msgsOut;
    int bytesIn;
    int bytesOut;

    [DllImport("crt")]
    static extern long strlen(string str);
    [DllImport("crt")]
    static extern long time(nint ptr);

    MqttBroker(string host, int port) {
        this.sessions = new List<MqttSession>();
        this.topics = new List<MqttTopicStat>();
        this.nextId = 0;
        this.startedAt = MqttBroker.Now();
        this.totalConnections = 0;
        this.msgsIn = 0;
        this.msgsOut = 0;
        this.bytesIn = 0;
        this.bytesOut = 0;
    }

    /// <summary>墙上时钟秒；用于管理快照中的时间戳。</summary>
    static int Now() { return time(0); }

    // 供 Worker 集成使用的共享实例（"mqtt" 协议的 worker 会将
    // 每个接受的连接路由到这里）。
    static MqttBroker inst;
    static MqttBroker Global() {
        if (inst == null) { inst = new MqttBroker("", 0); }
        return inst;
    }

    /// <summary>将此 broker 发布为进程级实例，使 HTTP
    /// 控制器无需层层传递即可读取其注册表。</summary>
    static void Use(MqttBroker b) { inst = b; }
    static MqttBroker Instance() { return MqttBroker.Global(); }

    int Count() { return this.sessions.Count; }

    // ---- 帧解析（二进制安全的读取；理由见 MqttClient） ----

    async int ReadByteAsync(nint sock) {
        byte[] b = new byte[2];
        while (true) {
            await Socket.ReadReady(sock);
            int n = Socket.Recv(sock, b, 1);
            if (n <= 0) {
                // 0 = 对端关闭；<0 = 套接字已死（RST 等）。两者都
                // 结束本会话：死套接字永远"可读"，重试只会让
                // 协程原地空转，会话对象也永远不清账。
                return -1;
            }
            return b[0] & 255;
        }
    }

    async byte[] ReadBytesAsync(nint sock, int need) {
        byte[] buf = new byte[need + 1];
        byte[] tmp = new byte[need + 1];
        int got = 0;
        while (got < need) {
            await Socket.ReadReady(sock);
            int n = Socket.Recv(sock, tmp, need - got);
            if (n == 0) { return buf; }
            if (n > 0) {
                for (int i = 0; i < n; i = i + 1) {
                    buf[got] = tmp[i];
                    got = got + 1;
                }
            }
        }
        return buf;
    }

    async int ReadRemainingLenAsync(nint sock) {
        int multiplier = 1;
        int acc = 0;
        int encoded = 128;
        while ((encoded & 128) != 0) {
            // MQTT 变长编码最多 4 字节（上限 268435455）；不设上限时
            // 一串 0x80 让循环无限自旋——恶意客户端的每连接 CPU DoS。
            if (multiplier > 128 * 128 * 128) { return -2; }
            encoded = await ReadByteAsync(sock);
            if (encoded < 0) { return -1; }
            acc = acc + (encoded & 127) * multiplier;
            multiplier = multiplier * 128;
        }
        return acc;
    }

    // ---- 主题匹配：带 + / # 通配符的过滤器 vs 具体主题 ----

    static List<string> SplitTopic(string s) {
        List<string> parts = new List<string>();
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < s.Length; i = i + 1) {
            if ((s[i] & 255) == 47) {
                parts.Add(sb.ToString());
                sb = new StringBuilder();
            } else {
                sb.Append(s.Substring(i, 1));
            }
        }
        parts.Add(sb.ToString());
        return parts;
    }

    static bool TopicMatches(string filter, string topic) {
        List<string> f = SplitTopic(filter);
        List<string> t = SplitTopic(topic);
        for (int i = 0; i < f.Count; i = i + 1) {
            if (f[i] == "#") { return true; }
            if (i >= t.Count) { return false; }
            if (f[i] != "+" && f[i] != t[i]) { return false; }
        }
        return t.Count == f.Count;
    }

    // ---- 报文构建器 ----

    static byte[] BuildPublish(string topic, string payload, int payloadLen) {
        int topicLen = (int)strlen(topic);
        int remainLen = 2 + topicLen + payloadLen;
        // Varint 剩余长度（最多 2 字节即可覆盖 16383，对
        // 64 KB 的读取足够；为保险起见编码最多 3 字节）。
        byte[] packet = new byte[remainLen + 5];
        int offset = 0;
        packet[offset] = (byte)(MqttPacketType.PUBLISH << 4);
        offset = offset + 1;
        int rl = remainLen;
        while (true) {
            int digit = rl & 127;
            rl = rl >> 7;
            if (rl > 0) {
                packet[offset] = (byte)(digit | 128);
            } else {
                packet[offset] = (byte)digit;
            }
            offset = offset + 1;
            if (rl == 0) { break; }
        }
        packet[offset] = (byte)((topicLen >> 8) & 255);
        offset = offset + 1;
        packet[offset] = (byte)(topicLen & 255);
        offset = offset + 1;
        int i = 0;
        for (; i < topicLen; i = i + 1) {
            packet[offset] = (byte)topic[i];
            offset = offset + 1;
        }
        i = 0;
        while (i < payloadLen) {
            packet[offset] = (byte)payload[i];
            offset = offset + 1;
            i = i + 1;
        }
        return packet;
    }

    int PublishPacketLen(string topic, int payloadLen) {
        int topicLen = (int)strlen(topic);
        int remainLen = 2 + topicLen + payloadLen;
        int varint = 1;
        int rl = remainLen >> 7;
        while (rl > 0) { varint = varint + 1; rl = rl >> 7; }
        return 1 + varint + remainLen;
    }

    // ---- 扇出分发 ----

    /// <summary>将消息投递给所有过滤器匹配
    /// <paramref name="topic"/> 的存活会话。返回接收者数量。</summary>
    async int PublishToSubscribers(string topic, string payload, int payloadLen) {
        byte[] packet = BuildPublish(topic, payload, payloadLen);
        int packetLen = this.PublishPacketLen(topic, payloadLen);
        int receivers = 0;
        for (int i = 0; i < this.sessions.Count; i = i + 1) {
            MqttSession sess = this.sessions[i];
            if (sess.alive) {
                bool match = false;
                for (int j = 0; j < sess.filters.Count; j = j + 1) {
                    if (TopicMatches(sess.filters[j], topic)) { match = true; break; }
                }
                if (match) {
                    int n = await Socket.SendAsync(sess.sock, packet, packetLen);
                    if (n <= 0) {
                        sess.alive = false;
                    } else {
                        receivers = receivers + 1;
                        sess.msgsOut = sess.msgsOut + 1;
                        this.msgsOut = this.msgsOut + 1;
                        this.bytesOut = this.bytesOut + packetLen;
                    }
                }
            }
        }
        return receivers;
    }

    // ---- 管理 API ----

    /// <summary>将消息记录到其主题下（消息计数 + 最后一条
    /// 负载），首次使用时创建主题条目。</summary>
    void Touch(string topic, string payload) {
        for (int i = 0; i < this.topics.Count; i = i + 1) {
            if (this.topics[i].name == topic) {
                this.topics[i].messages = this.topics[i].messages + 1;
                this.topics[i].lastPayload = payload;
                return;
            }
        }
        MqttTopicStat t = new MqttTopicStat(topic);
        t.messages = 1;
        t.lastPayload = payload;
        this.topics.Add(t);
    }

    /// <summary>管理端注入：以 broker 自身身份发布消息，
    /// 并返回送达的订阅者数量。刻意保持同步——
    /// 它会向其他客户端写入，而这些协程正停靠在可读性上，
    /// 因此使用直接的非阻塞 send，而非可 await 的路径。</summary>
    int Publish(string topic, string payload) {
        int payloadLen = payload.Length;
        this.msgsIn = this.msgsIn + 1;
        this.bytesIn = this.bytesIn + payloadLen;
        this.Touch(topic, payload);
        byte[] packet = BuildPublish(topic, payload, payloadLen);
        int packetLen = this.PublishPacketLen(topic, payloadLen);
        int sent = 0;
        int i = 0;
        while (i < this.sessions.Count) {
            MqttSession sess = this.sessions[i];
            i = i + 1;
            if (!sess.alive) { continue; }
            if (!this.Matches(sess, topic)) { continue; }
            int n = Socket.Send(sess.sock, packet, packetLen);
            if (n > 0) {
                sent = sent + 1;
                sess.msgsOut = sess.msgsOut + 1;
                this.msgsOut = this.msgsOut + 1;
                this.bytesOut = this.bytesOut + packetLen;
            }
        }
        return sent;
    }

    bool Matches(MqttSession sess, string topic) {
        for (int j = 0; j < sess.filters.Count; j = j + 1) {
            if (TopicMatches(sess.filters[j], topic)) { return true; }
        }
        return false;
    }

    /// <summary>按 MQTT 客户端 id 强制断开客户端。</summary>
    bool Kick(string clientId) {
        for (int i = 0; i < this.sessions.Count; i = i + 1) {
            MqttSession sess = this.sessions[i];
            if (sess.clientId == clientId) {
                sess.alive = false;
                // shutdown 而非 close：直接关闭描述符会让停靠在该
                // 套接字上的属主协程永远无法恢复（见 Socket.ShutdownBoth
                // 的说明）。属主协程在 EOF 后自行把会话从表里摘除
                // 并关闭 fd。
                Socket.ShutdownBoth(sess.sock);
                this.sessions.RemoveAt(i);
                return true;
            }
        }
        return false;
    }

    int SubsTotal() {
        int n = 0;
        for (int i = 0; i < this.sessions.Count; i = i + 1) {
            n = n + this.sessions[i].filters.Count;
        }
        return n;
    }

    string ClientsJson() {
        List<MqttClientDoc> outp = new List<MqttClientDoc>();
        for (int i = 0; i < this.sessions.Count; i = i + 1) {
            MqttSession c = this.sessions[i];
            MqttClientDoc o = new MqttClientDoc();
            o.id = c.id;
            o.client_id = c.clientId;
            o.addr = c.addr;
            o.connected_at = c.connectedAt;
            o.keepalive = c.keepAlive;
            o.subs = c.filters.Count;
            o.msgs_in = c.msgsIn;
            o.msgs_out = c.msgsOut;
            outp.Add(o);
        }
        return Json.Serialize<List<MqttClientDoc>>(outp);
    }

    /// <summary>返回一个客户端及其订阅，未知时返回 ""。</summary>
    string ClientDetailJson(string clientId) {
        for (int i = 0; i < this.sessions.Count; i = i + 1) {
            MqttSession c = this.sessions[i];
            if (c.clientId == clientId) {
                MqttClientDetailDoc o = new MqttClientDetailDoc();
                o.id = c.id;
                o.client_id = c.clientId;
                o.addr = c.addr;
                o.connected_at = c.connectedAt;
                o.msgs_in = c.msgsIn;
                o.msgs_out = c.msgsOut;
                o.subscriptions = new List<MqttSubDoc>();
                for (int j = 0; j < c.filters.Count; j = j + 1) {
                    MqttSubDoc f = new MqttSubDoc();
                    f.filter = c.filters[j];
                    int q = 0;
                    if (j < c.qos.Count) { q = c.qos[j]; }
                    f.qos = q;
                    o.subscriptions.Add(f);
                }
                return Json.Serialize<MqttClientDetailDoc>(o);
            }
        }
        return "";
    }

    string SubscriptionsJson() {
        List<MqttSubEntryDoc> outp = new List<MqttSubEntryDoc>();
        for (int i = 0; i < this.sessions.Count; i = i + 1) {
            MqttSession c = this.sessions[i];
            for (int j = 0; j < c.filters.Count; j = j + 1) {
                MqttSubEntryDoc o = new MqttSubEntryDoc();
                o.client_id = c.clientId;
                o.filter = c.filters[j];
                int q = 0;
                if (j < c.qos.Count) { q = c.qos[j]; }
                o.qos = q;
                outp.Add(o);
            }
        }
        return Json.Serialize<List<MqttSubEntryDoc>>(outp);
    }

    string TopicsJson() {
        List<MqttTopicDoc> outp = new List<MqttTopicDoc>();
        for (int i = 0; i < this.topics.Count; i = i + 1) {
            MqttTopicStat t = this.topics[i];
            MqttTopicDoc o = new MqttTopicDoc();
            o.topic = t.name;
            o.messages = t.messages;
            o.last = t.lastPayload;
            outp.Add(o);
        }
        return Json.Serialize<List<MqttTopicDoc>>(outp);
    }

    /// <summary>broker 吞吐量快照。</summary>
    string MetricsJson() {
        int uptime = MqttBroker.Now() - this.startedAt;
        MqttMetricsDoc o = new MqttMetricsDoc();
        o.uptime_sec = uptime;
        o.clients_connected = this.sessions.Count;
        o.clients_total = this.totalConnections;
        o.subscriptions = this.SubsTotal();
        o.topics = this.topics.Count;
        o.messages_in = this.msgsIn;
        o.messages_out = this.msgsOut;
        o.bytes_in = this.bytesIn;
        o.bytes_out = this.bytesOut;
        return Json.Serialize<MqttMetricsDoc>(o);
    }

    /// <summary>在已接受的套接字上服务一个 MQTT 客户端，直到其
    /// 断开。"mqtt" 协议的 Worker 用它服务每个客户端连接。</summary>
    async void HandleConnection(nint sock) {
        MqttSession sess = new MqttSession(sock);
        this.nextId = this.nextId + 1;
        sess.id = this.nextId;
        sess.addr = "fd:" + Convert.ToString(sock);
        sess.connectedAt = MqttBroker.Now();

        bool active = true;
        while (active) {
            int b0 = await ReadByteAsync(sock);
            if (b0 < 0) { break; }
            int remainLen = await ReadRemainingLenAsync(sock);
            if (remainLen < 0) { break; }
            // 单包上限 16 MiB：协议允许到 256 MB，但公网 broker 不该
            // 为一个报文预分配这么大的一对缓冲。
            if (remainLen > 16777216) { break; }
            byte[] body = new byte[1];
            if (remainLen > 0) {
                body = await ReadBytesAsync(sock, remainLen);
            }
            int packetType = (b0 >> 4) & 15;

            if (packetType == MqttPacketType.CONNECT) {
                // MQTT 禁止同一条连接发第二条 CONNECT——按协议错误断连，
                // 否则同一会话对象会被重复加入会话表。
                if (sess.connected) { break; }
                sess.connected = true;
                // 可变头：协议名（2+4）+ 级别（1）+ 标志（1）+
                // 保活（2）= 10 字节；然后是客户端 id（2 + n）。
                if (remainLen >= 12) {
                    sess.keepAlive = ((body[8] & 255) << 8) + (body[9] & 255);
                    int idLen = ((body[10] & 255) << 8) + (body[11] & 255);
                    if (12 + idLen <= remainLen) {
                        sess.clientId = body.ToStr(12, idLen);
                    }
                }
                if (sess.clientId.Length == 0) {
                    sess.clientId = "anon-" + Convert.ToString(sess.id);
                }
                // 同一 clientId 的旧会话还在表里（客户端未发 DISCONNECT
                // 就重连）：shutdown 旧套接字让其属主协程走 EOF 清理路径，
                // 直接 close 会让那个协程永远无法恢复（见 Socket.ShutdownBoth）。
                for (int s = this.sessions.Count - 1; s >= 0; s = s - 1) {
                    MqttSession old = this.sessions[s];
                    if (old != sess && old.clientId == sess.clientId) {
                        old.alive = false;
                        Socket.ShutdownBoth(old.sock);
                        this.sessions.RemoveAt(s);
                    }
                }
                this.totalConnections = this.totalConnections + 1;
                this.sessions.Add(sess);
                byte[] connack = new byte[4];
                connack[0] = (byte)(MqttPacketType.CONNACK << 4);
                connack[1] = 2;
                connack[2] = 0;
                connack[3] = 0;   // 已接受
                int _c = await Socket.SendAsync(sock, connack, 4);
            } else if (packetType == MqttPacketType.PUBLISH) {
                // 变头最少 2 字节主题长度；畸形包按协议直接断连
                //（此前 remainLen==0 时 body 是 1 字节缓冲，
                // body[0] 直接越界崩溃——公网 broker 一个坏包打死进程）。
                if (remainLen < 2) { break; }
                int qos = (b0 >> 1) & 3;
                int topicLen = ((body[0] & 255) << 8) + (body[1] & 255);
                int offset = 2 + topicLen;
                // 主题必须落在报文内且非空；QoS>0 时其后还有
                // 2 字节包标识。越界即协议错误。
                if (topicLen <= 0 || offset > remainLen
                        || (qos > 0 && offset + 2 > remainLen)) { break; }
                string topic = body.ToStr(2, topicLen);
                int pid = 0;
                if (qos > 0) {
                    pid = ((body[offset] & 255) << 8) + (body[offset + 1] & 255);
                    offset = offset + 2;
                }
                int payloadLen = remainLen - offset;
                string payload = body.ToStr(offset, payloadLen);
                sess.msgsIn = sess.msgsIn + 1;
                this.msgsIn = this.msgsIn + 1;
                this.bytesIn = this.bytesIn + payloadLen;
                this.Touch(topic, payload);
                int _r = await this.PublishToSubscribers(topic, payload, payloadLen);
                if (qos > 0) {
                    byte[] puback = new byte[5];
                    puback[0] = (byte)(MqttPacketType.PUBACK << 4);
                    puback[1] = 2;
                    puback[2] = (byte)((pid >> 8) & 255);
                    puback[3] = (byte)(pid & 255);
                    int _a = await Socket.SendAsync(sock, puback, 4);
                }
            } else if (packetType == MqttPacketType.SUBSCRIBE) {
                if (remainLen < 2) { break; }   // 包标识 2 字节
                int pid = ((body[0] & 255) << 8) + (body[1] & 255);
                // 主题过滤器：（2 字节长度 + 过滤器 + 1 字节 qos）*
                int offset = 2;
                List<int> grantedQos = new List<int>();
                bool malformed = false;
                while (offset + 2 < remainLen) {
                    int fLen = ((body[offset] & 255) << 8) + (body[offset + 1] & 255);
                    offset = offset + 2;
                    // 过滤器与其后的 qos 字节都必须落在报文内：
                    // 此前 fLen 可由攻击者设为任意值，body[offset]
                    // 读到缓冲外直接崩溃。
                    if (offset + fLen + 1 > remainLen) { malformed = true; break; }
                    string filter = body.ToStr(offset, fLen);
                    offset = offset + fLen;
                    int reqQos = body[offset] & 255;
                    offset = offset + 1;
                    if (reqQos > 1) { reqQos = 1; }   // QoS 2 已降级
                    sess.filters.Add(filter);
                    sess.qos.Add(reqQos);
                    grantedQos.Add(reqQos);
                }
                if (malformed) { break; }
                int ackLen = 4 + grantedQos.Count;
                byte[] suback = new byte[ackLen + 1];
                suback[0] = (byte)(MqttPacketType.SUBACK << 4);
                suback[1] = (byte)(2 + grantedQos.Count);
                suback[2] = (byte)((pid >> 8) & 255);
                suback[3] = (byte)(pid & 255);
                for (int g = 0; g < grantedQos.Count; g = g + 1) {
                    suback[4 + g] = (byte)grantedQos[g];
                }
                int _s = await Socket.SendAsync(sock, suback, ackLen);
            } else if (packetType == MqttPacketType.UNSUBSCRIBE) {
                if (remainLen < 2) { break; }   // 包标识 2 字节
                int pid = ((body[0] & 255) << 8) + (body[1] & 255);
                int offset = 2;
                bool malformed = false;
                while (offset + 2 <= remainLen) {
                    int fLen = ((body[offset] & 255) << 8) + (body[offset + 1] & 255);
                    offset = offset + 2;
                    if (offset + fLen > remainLen) { malformed = true; break; }
                    string filter = body.ToStr(offset, fLen);
                    offset = offset + fLen;
                    int k = 0;
                    while (k < sess.filters.Count) {
                        if (sess.filters[k] == filter) {
                            sess.filters.RemoveAt(k);
                            if (k < sess.qos.Count) { sess.qos.RemoveAt(k); }
                        } else {
                            k = k + 1;
                        }
                    }
                }
                if (malformed) { break; }
                byte[] unsuback = new byte[5];
                unsuback[0] = (byte)(MqttPacketType.UNSUBACK << 4);
                unsuback[1] = 2;
                unsuback[2] = (byte)((pid >> 8) & 255);
                unsuback[3] = (byte)(pid & 255);
                int _u = await Socket.SendAsync(sock, unsuback, 4);
            } else if (packetType == MqttPacketType.PINGREQ) {
                byte[] pong = new byte[3];
                pong[0] = (byte)(MqttPacketType.PINGRESP << 4);
                pong[1] = 0;
                int _p = await Socket.SendAsync(sock, pong, 2);
            } else if (packetType == MqttPacketType.DISCONNECT) {
                active = false;
            }
        }

        sess.alive = false;
        for (int k2 = 0; k2 < this.sessions.Count; k2 = k2 + 1) {
            if (this.sessions[k2] == sess) {
                this.sessions.RemoveAt(k2);
                break;
            }
        }
        Socket.Close(sock);
    }
}
