using System;
using System.Net.Sockets;
using System.Threading;

namespace System.Net.Coap;

/// CoAP 方法/响应码（RFC 7252 第 12.1 节）。
class CoapCode {
    static const int GET = 1;   // 0.01
    static const int POST = 2;   // 0.02
    static const int PUT = 3;   // 0.03
    static const int DELETE = 4;   // 0.04
}

/// <summary>解析后的 CoAP 响应：<c>code</c> 为 class.detail 字节
/// （如 69 = 2.05 Content、132 = 4.04 Not Found），<c>payload</c> 为
/// 0xFF 标记之后的字节（无则为 ""），2.xx 类时 <c>ok</c> 为 true；
/// <c>CodeText</c> 以带点形式输出，供日志使用。</summary>
class CoapResponse {
    int code;
    string payload;
    bool ok;

    CoapResponse(int code, string payload) {
        this.code = code;
        this.payload = payload;
        this.ok = (code >> 5) == 2;
    }

    /// <summary>响应码的 "2.05" 式带点渲染。</summary>
    string CodeText() {
        return Convert.ToString(this.code >> 5) + "."
            + CoapResponse.Two(this.code & 31);
    }

    static string Two(int v) {
        if (v < 10) { return "0" + Convert.ToString(v); }
        return Convert.ToString(v);
    }
}

/// <summary>
/// 基于 UDP 的 CoAP 客户端（RFC 7252）——标准的请求/响应协议
/// 用于资源受限的 IoT 设备，默认端口 5683。
///
/// 请求为可确认（CON）类型，遵循规范的重传计划
/// （初始超时 2 秒，每次重试翻倍，共 4 次重传），因此丢失的数据报
/// 会被重试，失效的端点会干净地报错而不是挂死。响应
/// 通过 message id（ACK 捎带）或 token（独立应答）进行匹配。
///
/// 用法：
///   CoapClient c = new CoapClient("192.168.1.50", 5683);
///   CoapResponse r = await c.GetAsync("sensors/temp");
///   if (r.ok) { Console.WriteLine(r.payload); }
///   CoapResponse w = await c.PutAsync("actuators/led", "on");
/// </summary>
class CoapClient {
    string host;
    int port;
    int nextMsgId;
    // RFC 7252 默认值；SetTimeout 按比例调整初始 ACK 窗口。
    int ackTimeoutMs;
    int maxRetransmit;

    /// <summary>为一个 CoAP 端点创建客户端。</summary>
    CoapClient(string host, int port) {
        this.host = host;
        this.port = port;
        this.nextMsgId = 1;
        this.ackTimeoutMs = 2000;
        this.maxRetransmit = 4;
    }

    /// <summary>设置初始 ACK 超时（每次重传翻倍）以及
    /// 重传次数。最坏等待时间为 timeoutMs * (2^retries - 1)。</summary>
    CoapClient SetTimeout(int timeoutMs, int retries) {
        if (timeoutMs > 0) { this.ackTimeoutMs = timeoutMs; }
        if (retries >= 0) { this.maxRetransmit = retries; }
        return this;
    }

    /// <summary>GET 一个资源路径，如 "sensors/temp"。</summary>
    async CoapResponse GetAsync(string path) {
        CoapResponse r = await RequestAsync(CoapCode.GET, path, "");
        return r;
    }

    /// <summary>向资源路径 POST 一个负载。</summary>
    async CoapResponse PostAsync(string path, string payload) {
        CoapResponse r = await RequestAsync(CoapCode.POST, path, payload);
        return r;
    }

    /// <summary>向资源路径 PUT 一个负载。</summary>
    async CoapResponse PutAsync(string path, string payload) {
        CoapResponse r = await RequestAsync(CoapCode.PUT, path, payload);
        return r;
    }

    /// <summary>DELETE 一个资源路径。</summary>
    async CoapResponse DeleteAsync(string path) {
        CoapResponse r = await RequestAsync(CoapCode.DELETE, path, "");
        return r;
    }

    // 构建一个 CON 请求数据报：4 字节头部、2 字节 token、Uri-Path
    // 选项（按 '/' 分隔的每个段一个），然后是 0xFF + payload。
    byte[] BuildRequest(int code, string path, string payload, int msgId,
                        int tok, List<int> outLen) {
        byte[] p = new byte[4 + 2 + 4 + path.Length + 2 * 8 + 1 + payload.Length + 8];
        int o = 0;
        p[o] = (byte)((1 << 6) + (0 << 4) + 2);   // ver=1, type=CON, tkl=2
        o = o + 1;
        p[o] = (byte)(code);
        o = o + 1;
        p[o] = (byte)((msgId >> 8) & 255);
        o = o + 1;
        p[o] = (byte)(msgId & 255);
        o = o + 1;
        p[o] = (byte)((tok >> 8) & 255);
        o = o + 1;
        p[o] = (byte)(tok & 255);
        o = o + 1;

        // Uri-Path（选项 11），每个段重复一次；delta 依次为 11、0。
        int prevOpt = 0;
        int segStart = 0;
        for (int i = 0; i <= path.Length; i = i + 1) {
            bool atEnd = i == path.Length;
            bool atSep = false;
            if (!atEnd) { atSep = (path[i] & 255) == 47; }
            if (atEnd || atSep) {
                int segLen = i - segStart;
                if (segLen > 0) {
                    int delta = 11 - prevOpt;
                    prevOpt = 11;
                    if (segLen < 13) {
                        p[o] = (byte)((delta << 4) + segLen);
                        o = o + 1;
                    } else {
                        p[o] = (byte)((delta << 4) + 13);
                        o = o + 1;
                        p[o] = (byte)(segLen - 13);
                        o = o + 1;
                    }
                    int k = segStart;
                    while (k < i) {
                        p[o] = (byte)(path[k]);
                        o = o + 1;
                        k = k + 1;
                    }
                }
                segStart = i + 1;
            }
        }

        if (payload.Length > 0) {
            p[o] = 255;
            o = o + 1;
            for (int k2 = 0; k2 < payload.Length; k2 = k2 + 1) {
                p[o] = (byte)(payload[k2]);
                o = o + 1;
            }
        }
        outLen.Add(o);
        return p;
    }

    // 解析响应数据报（d 中有 n 个有效字节）；当数据报不是发给
    // 我们的（message id 和 token 都不匹配）或只是
    // 空 ACK 时返回 null。
    static CoapResponse ParseResponse(byte[] d, int n, int msgId, int tok) {
        if (n < 4) { return null; }
        int tkl = d[0] & 15;
        int code = d[1] & 255;
        int mid = ((d[2] & 255) << 8) + (d[3] & 255);
        int o = 4;
        int rtok = 0;
        for (int t = 0; t < tkl && o < n; t = t + 1) {
            rtok = (rtok << 8) + (d[o] & 255);
            o = o + 1;
        }
        bool ours = mid == msgId || (tkl == 2 && rtok == tok);
        if (!ours) { return null; }
        if (code == 0) { return null; }   // 空 ACK：真正的应答稍后到达

        // 跳过选项直到负载标记。
        while (o < n && (d[o] & 255) != 255) {
            int b = d[o] & 255;
            o = o + 1;
            int delta = (b >> 4) & 15;
            int len = b & 15;
            if (delta == 13) { o = o + 1; }
            else if (delta == 14) { o = o + 2; }
            if (len == 13) {
                if (o < n) { len = 13 + (d[o] & 255); }
                o = o + 1;
            } else if (len == 14) {
                if (o + 1 < n) {
                    len = 269 + ((d[o] & 255) << 8) + (d[o + 1] & 255);
                }
                o = o + 2;
            }
            o = o + len;
        }
        string payload = "";
        if (o < n && (d[o] & 255) == 255 && o + 1 < n) {
            payload = d.ToStr(o + 1, n - o - 1);
        }
        return new CoapResponse(code, payload);
    }

    /// <summary>发送一个可确认请求并等待匹配的
    /// 响应，按 RFC 7252 重传。当所有重试都超时，返回 code 为 0
    /// （ok=false）的响应。</summary>
    async CoapResponse RequestAsync(int code, string path, string payload) {
        UdpClient udp = new UdpClient();
        int msgId = this.nextMsgId & 65535;
        this.nextMsgId = this.nextMsgId + 1;
        int tok = (msgId * 31 + 7) & 65535;
        List<int> lenBox = new List<int>();
        byte[] pkt = BuildRequest(code, path, payload, msgId, tok, lenBox);
        int pktLen = lenBox[0];
        string wire = pkt.ToStr(0, pktLen);

        int attempt = 0;
        int window = this.ackTimeoutMs;
        CoapResponse result = null;
        while (result == null && attempt <= this.maxRetransmit) {
            int _s = await udp.SendBytesToAsync(wire, pktLen, this.host, this.port);
            long start = Stopwatch.GetMilliseconds();
            while (result == null
                   && Stopwatch.GetMilliseconds() - start < window) {
                if (Socket.IsReadable(udp.GetSocket())) {
                    byte[] rb = new byte[2048];
                    int rn = udp.RecvBytesFrom(rb, 2048);
                    result = CoapClient.ParseResponse(rb, rn, msgId, tok);
                } else {
                    await Task.Delay(20);
                }
            }
            attempt = attempt + 1;
            window = window * 2;
        }
        udp.Close();
        if (result == null) { result = new CoapResponse(0, ""); }
        return result;
    }
}
