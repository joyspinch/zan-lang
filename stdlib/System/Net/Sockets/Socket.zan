using System;

namespace System.Net.Sockets;

/// <summary>
/// Cross-platform low-level socket operations.
/// Uses Winsock2 on Windows, BSD sockets (libc) on Linux/macOS.
/// </summary>
class Socket {
    // A socket handle is `nint` throughout this API, as in C#
    // (SafeSocketHandle / IntPtr): Windows SOCKET is a UINT_PTR, a POSIX fd is
    // a 32-bit int. Only the Sys* wrappers below meet the real C signatures,
    // truncating to `int` where POSIX expects an fd.
    [DllImport("crt", EntryPoint = "zan_io_socket_send")]
    static extern long ReactorSend(nint sock, string buf, long len, int flags);

    [DllImport("crt", EntryPoint = "zan_io_socket_recv")]
    static extern long ReactorRecv(nint sock, string buf, long len, int flags);

    [DllImport("crt", EntryPoint = "zan_io_socket_ready")]
    static extern int ReactorReady(nint sock, int writeReady);

    /// <summary>Probes the outcome of a non-blocking connect: 0 connected,
    /// positive SO_ERROR code (or -1) when failed, -2 while in progress.</summary>
    [DllImport("crt", EntryPoint = "zan_io_connect_status")]
    static extern int ConnectStatus(nint sock);

    [DllImport("crt", EntryPoint = "zan_io_socket_alive")]
    static extern int SocketAlive(nint sock);

    // ---- Platform-specific DllImport ----
    #if WINDOWS
    [DllImport("ws2_32", EntryPoint = "WSAStartup")]
    static extern int WSAStartup(ushort version, string wsaData);

    [DllImport("crt", EntryPoint = "zan_io_socket_cleanup")]
    static extern void ReactorCleanup();

    [DllImport("ws2_32")]
    static extern nint socket(int af, int type, int protocol);

    [DllImport("ws2_32")]
    static extern int closesocket(nint s);

    [DllImport("ws2_32", EntryPoint = "send")]
    static extern int winsend(nint s, string buf, int len, int flags);

    [DllImport("ws2_32", EntryPoint = "recv")]
    static extern int winrecv(nint s, string buf, int len, int flags);

    [DllImport("ws2_32")]
    static extern int bind(nint s, string addr, int addrlen);

    [DllImport("ws2_32")]
    static extern int listen(nint s, int backlog);

    [DllImport("ws2_32")]
    static extern nint accept(nint s, string addr, string addrlen);

    [DllImport("ws2_32")]
    static extern int connect(nint s, string addr, int addrlen);

    [DllImport("ws2_32")]
    static extern int setsockopt(nint s, int level, int optname, string optval, int optlen);

    [DllImport("ws2_32")]
    static extern int ioctlsocket(nint s, int cmd, string argp);

    [DllImport("ws2_32")]
    static extern int shutdown(nint s, int how);

    [DllImport("kernel32", EntryPoint = "CancelIoEx")]
    static extern int CancelIoEx(nint handle, nint overlapped);

    [DllImport("ws2_32")]
    static extern int sendto(nint s, string buf, int len, int flags, string to, int tolen);

    [DllImport("ws2_32")]
    static extern int recvfrom(nint s, string buf, int len, int flags, string from, string fromlen);

    [DllImport("ws2_32")]
    static extern ushort htons(ushort hostshort);

    [DllImport("ws2_32")]
    static extern int htonl(int hostlong);

    [DllImport("ws2_32")]
    static extern ushort ntohs(ushort netshort);

    [DllImport("ws2_32")]
    static extern int inet_addr(string cp);

    [DllImport("ws2_32")]
    static extern nint gethostbyname(string name);

    // Winsock takes the whole SOCKET handle, so these just forward.
    static int SysClose(nint s) { return closesocket(s); }
    static int SysShutdown(nint s, int how) { return shutdown(s, how); }
    static int SysBind(nint s, string addr, int addrlen) { return bind(s, addr, addrlen); }
    static int SysListen(nint s, int backlog) { return listen(s, backlog); }
    static nint SysAccept(nint s, string addr, string addrlen) { return accept(s, addr, addrlen); }
    static int SysConnect(nint s, string addr, int addrlen) { return connect(s, addr, addrlen); }
    static int SysSetSockOpt(nint s, int level, int optname, string optval, int optlen) {
        return setsockopt(s, level, optname, optval, optlen);
    }
    static int SysSendTo(nint s, string buf, int len, int flags, string to, int tolen) {
        return sendto(s, buf, len, flags, to, tolen);
    }
    static int SysRecvFrom(nint s, string buf, int len, int flags, string from, string fromlen) {
        return recvfrom(s, buf, len, flags, from, fromlen);
    }
    #elif LINUX || MACOS
    [DllImport("crt")]
    static extern int socket(int af, int type, int protocol);

    [DllImport("crt", EntryPoint = "close")]
    static extern int closesocket(int fd);

    [DllImport("crt", EntryPoint = "send")]
    static extern int winsend(int fd, string buf, int len, int flags);

    [DllImport("crt", EntryPoint = "recv")]
    static extern int winrecv(int fd, string buf, int len, int flags);

    [DllImport("crt")]
    static extern int bind(int fd, string addr, int addrlen);

    [DllImport("crt")]
    static extern int listen(int fd, int backlog);

    [DllImport("crt")]
    static extern int accept(int fd, string addr, string addrlen);

    [DllImport("crt")]
    static extern int connect(int fd, string addr, int addrlen);

    [DllImport("crt")]
    static extern int setsockopt(int fd, int level, int optname, string optval, int optlen);

    [DllImport("crt")]
    static extern int shutdown(int fd, int how);

    [DllImport("crt")]
    static extern int sendto(int fd, string buf, int len, int flags, string to, int tolen);

    [DllImport("crt")]
    static extern int recvfrom(int fd, string buf, int len, int flags, string from, string fromlen);

    [DllImport("crt")]
    static extern ushort htons(ushort hostshort);

    [DllImport("crt")]
    static extern int htonl(int hostlong);

    [DllImport("crt")]
    static extern ushort ntohs(ushort netshort);

    [DllImport("crt")]
    static extern int inet_addr(string cp);

    [DllImport("crt")]
    static extern nint gethostbyname(string name);

    [DllImport("crt")]
    static extern int fcntl(int fd, int cmd, int arg);

    // A POSIX fd is a 32-bit int: truncate the handle here, once.
    static int SysClose(nint s) { return closesocket((int)s); }
    static int SysShutdown(nint s, int how) { return shutdown((int)s, how); }
    static int SysBind(nint s, string addr, int addrlen) { return bind((int)s, addr, addrlen); }
    static int SysListen(nint s, int backlog) { return listen((int)s, backlog); }
    static nint SysAccept(nint s, string addr, string addrlen) { return accept((int)s, addr, addrlen); }
    static int SysConnect(nint s, string addr, int addrlen) { return connect((int)s, addr, addrlen); }
    static int SysSetSockOpt(nint s, int level, int optname, string optval, int optlen) {
        return setsockopt((int)s, level, optname, optval, optlen);
    }
    static int SysSendTo(nint s, string buf, int len, int flags, string to, int tolen) {
        return sendto((int)s, buf, len, flags, to, tolen);
    }
    static int SysRecvFrom(nint s, string buf, int len, int flags, string from, string fromlen) {
        return recvfrom((int)s, buf, len, flags, from, fromlen);
    }
    #endif

    [DllImport("crt")]
    static extern long strlen(string str);


    // Monotonic clock for deadline-bounded operations (same source as
    // Stopwatch, declared here so the socket layer keeps no dependency on
    // System.Threading).
    [DllImport("crt", EntryPoint = "zan_monotonic_us")]
    static extern long NativeMonotonicUs();

    /// <summary>Initializes the socket subsystem (WSAStartup on Windows, no-op on Linux).</summary>
    static void Initialize() {
        #if WINDOWS
        byte[] wsaData = new byte[512];
        WSAStartup(514, wsaData);
        #endif
    }

    /// <summary>Cleans up the socket subsystem.</summary>
    static void Cleanup() {
        #if WINDOWS
        ReactorCleanup();
        #endif
    }

    /// <summary>Creates a TCP socket.</summary>
    static nint CreateTcp() {
        return socket(2, 1, 6);
    }

    /// <summary>Creates a UDP socket.</summary>
    static nint CreateUdp() {
        return socket(2, 2, 17);
    }

    /// <summary>Closes a socket.</summary>
    static void Close(nint sock) {
        SysClose(sock);
    }

    /// <summary>Shuts the connection down in both directions without releasing
    /// the descriptor. A coroutine suspended on this socket in the IO reactor
    /// is woken with a 0-byte read (peer-close semantics) and unwinds normally,
    /// which closing the descriptor outright would not do: the fd would leave
    /// the reactor set with no completion and the coroutine would never
    /// resume. Used to hang up on connections that outstay a limit.</summary>
    static void ShutdownBoth(nint sock) {
        SysShutdown(sock, 2);   // SD_BOTH / SHUT_RDWR
        #if WINDOWS
        // A local shutdown does not complete an already-posted WSARecv, so on
        // Windows the wake has to be asked for explicitly: CancelIoEx completes
        // every pending overlapped operation on the handle, which the reactor
        // reports as 0 bytes -- the same peer-close shape POSIX gives for free.
        int _cancelled = CancelIoEx(sock, 0);
        #endif
    }

    /// <summary>Sets the socket to non-blocking mode.</summary>
    static int SetNonBlocking(nint sock) {
        #if WINDOWS
        byte[] argp = new byte[4];
        argp[0] = 1;
        return ioctlsocket(sock, -2147195266, argp);
        #elif LINUX
        int flags = fcntl((int)sock, 3, 0);
        return fcntl((int)sock, 4, flags | 2048);
        #elif MACOS
        int flags = fcntl((int)sock, 3, 0);
        return fcntl((int)sock, 4, flags | 4);
        #endif
    }

    /// <summary>Sets SO_REUSEADDR on a socket.</summary>
    static void SetReuseAddr(nint sock) {
        byte[] optval = new byte[4];
        optval[0] = 1;
        #if WINDOWS
        SysSetSockOpt(sock, 65535, 4, optval, 4);
        #elif LINUX
        SysSetSockOpt(sock, 1, 2, optval, 4);
        #elif MACOS
        SysSetSockOpt(sock, 65535, 4, optval, 4);
        #endif
    }

    /// <summary>Enables SO_REUSEPORT so several processes can bind the very same
    /// address:port and have the kernel load-balance incoming connections across
    /// them -- the basis for multi-worker horizontal scaling (Linux/macOS). Must
    /// be set before bind(). Windows has no SO_REUSEPORT, so SO_REUSEADDR is set
    /// instead (a single process still owns the port there).</summary>
    static void SetReusePort(nint sock) {
        byte[] optval = new byte[4];
        optval[0] = 1;
        #if WINDOWS
        SysSetSockOpt(sock, 65535, 4, optval, 4);
        #elif LINUX
        SysSetSockOpt(sock, 1, 15, optval, 4);
        #elif MACOS
        SysSetSockOpt(sock, 65535, 512, optval, 4);
        #endif
    }

    /// <summary>Disables Nagle's algorithm (TCP_NODELAY) on an accepted socket.
    /// Without it a small reply waits for the peer's ACK of the previous one, so
    /// a client that pipelines requests hits the ~40 ms delayed-ACK stall: the
    /// websocket echo path measured 18k messages/sec purely because of it.
    /// IPPROTO_TCP is 6 and TCP_NODELAY is 1 on all supported platforms.</summary>
    static void SetNoDelay(nint sock) {
        byte[] optval = new byte[4];
        optval[0] = 1;
        SysSetSockOpt(sock, 6, 1, optval, 4);
    }

    /// <summary>Enables SO_BROADCAST on a socket (platform-correct constants).</summary>
    static void SetBroadcast(nint sock) {
        byte[] optval = new byte[4];
        optval[0] = 1;
        #if WINDOWS
        SysSetSockOpt(sock, 65535, 32, optval, 4);
        #elif LINUX
        SysSetSockOpt(sock, 1, 6, optval, 4);
        #elif MACOS
        SysSetSockOpt(sock, 65535, 32, optval, 4);
        #endif
    }

    /// <summary>Builds a sockaddr_in structure for IPv4.</summary>
    static byte[] BuildSockAddr(string ip, int port) {
        byte[] addr = new byte[16];
        #if MACOS
        addr[0] = 16;
        addr[1] = 2;
        #else
        addr[0] = 2;
        addr[1] = 0;
        #endif
        int nport = (int)htons((ushort)port);
        addr[2] = (byte)(nport & 255);
        addr[3] = (byte)((nport >> 8) & 255);
        int ipAddr = 0;
        if (ip == "0.0.0.0" || ip == "") {
            ipAddr = 0;
        } else {
            ipAddr = inet_addr(ip);
        }
        addr[4] = (byte)(ipAddr & 255);
        addr[5] = (byte)((ipAddr >> 8) & 255);
        addr[6] = (byte)((ipAddr >> 16) & 255);
        addr[7] = (byte)((ipAddr >> 24) & 255);
        return addr;
    }

    /// <summary>Binds a socket to an address and port.</summary>
    static int Bind(nint sock, string ip, int port) {
        byte[] addr = BuildSockAddr(ip, port);
        return SysBind(sock, addr, 16);
    }

    /// <summary>Starts listening for connections.</summary>
    static int Listen(nint sock, int backlog) {
        return SysListen(sock, backlog);
    }

    /// <summary>Accepts a connection synchronously.</summary>
    static nint Accept(nint sock) {
        byte[] clientAddr = new byte[16];
        byte[] addrLen = new byte[4];
        addrLen[0] = 16;
        return SysAccept(sock, clientAddr, addrLen);
    }

    /// <summary>Suspends on the IO reactor until an inbound connection is
    /// pending, then accepts it. Requires a non-blocking listener socket.</summary>
    static async nint AcceptAsync(nint sock) {
        #if WINDOWS
        return await Socket.AcceptOv(sock);
        #else
        while (true) {
            await Socket.ReadReady(sock);
            nint client = Accept(sock);
            if (client >= 0) {
                return client;
            }
            // The listener was closed while this accept was parked (Stop()):
            // it can never become ready again, so report the failure instead
            // of re-arming the watcher forever.
            if (!Socket.IsOpen(sock)) {
                return -1;
            }
        }
        return -1;
        #endif
    }

    /// <summary>Connects to a remote address synchronously.</summary>
    static int Connect(nint sock, string ip, int port) {
        byte[] addr = BuildSockAddr(ip, port);
        return SysConnect(sock, addr, 16);
    }

    /// <summary>Begins a non-blocking connect, then suspends on the IO reactor
    /// until the connection settles. Returns 0 on success or a non-zero error
    /// code (SO_ERROR, e.g. refused/unreachable; -1 when no code is available)
    /// when it failed. Requires a non-blocking socket.
    ///
    /// The reactor's write-readiness wake can arrive before a pending connect
    /// settles (notably on Windows, where the zero-byte send probe completes
    /// early and a failed connect is reported through the exception set), so
    /// after each wake the outcome is checked with ConnectStatus and re-polled
    /// with a short delay while still in progress.</summary>
    static async int ConnectAsync(nint sock, string ip, int port) {
        Connect(sock, ip, port);
        await Socket.WriteReady(sock);
        while (true) {
            int st = ConnectStatus(sock);
            if (st != -2) {
                return st;
            }
            await Task.Delay(1);
        }
        return 0;
    }

    /// <summary>ConnectAsync bounded by <paramref name="timeoutMs"/>: returns
    /// -3 when the connection has neither succeeded nor failed within the
    /// window (a black-holed address never wakes the reactor, so the plain
    /// overload would suspend forever). A non-positive timeout means "no
    /// deadline" and defers to the reactor-driven overload.
    ///
    /// While the connect is pending the outcome is polled with ConnectStatus
    /// and a growing delay instead of awaiting write-readiness: a reactor wake
    /// cannot be cancelled, so a deadline can only be observed from a timer
    /// this coroutine owns. The socket is left for the caller to close.</summary>
    static async int ConnectAsync(nint sock, string ip, int port, int timeoutMs) {
        if (timeoutMs <= 0) {
            int plain = await ConnectAsync(sock, ip, port);
            return plain;
        }
        Connect(sock, ip, port);
        long deadlineUs = NativeMonotonicUs() + timeoutMs * 1000;
        int stepMs = 1;
        while (true) {
            int st = ConnectStatus(sock);
            if (st != -2) {
                return st;
            }
            if (NativeMonotonicUs() >= deadlineUs) {
                return -3;
            }
            await Task.Delay(stepMs);
            if (stepMs < 16) {
                stepMs = stepMs * 2;
            }
        }
        return 0;
    }

    /// <summary>Sends data synchronously.</summary>
    static int Send(nint sock, string data, int len) {
        return (int)ReactorSend(sock, data, len, 0);
    }

    /// <summary>Suspends until writable, then sends; re-awaits on partial writes
    /// until all <paramref name="len"/> bytes are sent or the peer closes.
    /// Returns the number of bytes sent. Requires a non-blocking socket.
    ///
    /// Binary-safe: the unsent remainder is carried in a separate buffer rebuilt
    /// by index copy, never via <c>data + totalSent</c> pointer arithmetic. On a
    /// string that would compute as concatenation and truncate at the first NUL
    /// byte, corrupting any payload that contains NULs (e.g. MQTT packets).
    ///
    /// Sends eagerly: the non-blocking send is attempted first and the reactor
    /// is only awaited when the socket would block (partial write / full send
    /// buffer). On an uncongested socket the whole payload leaves in one syscall
    /// with no suspension, avoiding a reactor round-trip per message.</summary>
    static async int SendAsync(nint sock, string data, int len) {
        int totalSent = 0;
        string cur = data;
        int curLen = len;
        while (totalSent < len) {
            int sent = (int)ReactorSend(sock, cur, curLen, 0);
            if (sent > 0) {
                totalSent = totalSent + sent;
                if (totalSent < len) {
                    int remaining = len - totalSent;
                    byte[] tail = new byte[remaining + 1];
                    int j = 0;
                    while (j < remaining) {
                        tail[j] = (byte)data[totalSent + j];
                        j = j + 1;
                    }
                    cur = tail;
                    curLen = remaining;
                }
            } else if (sent == 0) {
                return totalSent;
            } else if (sent == -1) {
                // Would block: wait until the socket is writable, then retry.
                await Socket.WriteReady(sock);
            } else {
                // Fatal (peer reset/aborted, broken pipe, ...). The socket will
                // never become writable again, so stop instead of waiting
                // forever; report what was actually accepted.
                return totalSent;
            }
        }
        return totalSent;
    }

    /// <summary>Sends a string (calculates length automatically).</summary>
    static int SendString(nint sock, string data) {
        int len = (int)strlen(data);
        return Send(sock, data, len);
    }

    /// <summary>Sends a whole string asynchronously (length via strlen).</summary>
    static async int SendStringAsync(nint sock, string data) {
        int len = (int)strlen(data);
        int r = await SendAsync(sock, data, len);
        return r;
    }

    /// <summary>Receives data synchronously.</summary>
    static int Recv(nint sock, string buf, int bufSize) {
        return (int)ReactorRecv(sock, buf, bufSize, 0);
    }

    /// <summary>Suspends on the IO reactor until readable, then receives up to
    /// <paramref name="bufSize"/> bytes. Returns the data as a NUL-terminated
    /// string (empty on peer close / EOF). Requires a non-blocking socket.</summary>
    static async string RecvAsync(nint sock, int bufSize) {
        byte[] buf = new byte[bufSize + 1];
        // Use the real overlapped receive (RecvOv) rather than a readiness probe
        // plus synchronous recv. A zero-byte readiness WSARecv can complete
        // immediately with no data pending, so ReadReady + ReactorRecv would see
        // WSAEWOULDBLOCK and mistake it for a peer close, returning empty before
        // the peer's data ever arrives. RecvOv posts a genuine WSARecv into buf
        // that completes only when bytes are read (or the peer closes).
        int n = await Socket.RecvOv(sock, buf, bufSize);
        if (n < 0) { n = 0; }
        return buf.ToStr(0, n);
    }

    /// <summary>Suspends until readable, then receives up to <paramref
    /// name="bufSize"/> bytes into a caller-owned buffer, NUL-terminating at the
    /// byte count. Returns the number of bytes read (0 on peer close). Lets a
    /// keep-alive connection reuse one buffer across requests instead of
    /// allocating and zeroing a fresh (up to 64KB) buffer per request.</summary>
    static async int RecvIntoAsync(nint sock, string buf, int bufSize) {
        int n = await Socket.RecvOv(sock, buf, bufSize);
        if (n > 0) {
            buf[n] = 0;
            return n;
        }
        buf[0] = 0;
        return 0;
    }

    /// <summary>Receives into a buffer (returns string).</summary>
    static string Receive(nint sock, int bufSize) {
        byte[] buf = new byte[bufSize + 1];
        int n = Recv(sock, buf, bufSize);
        if (n < 0) { n = 0; }
        return buf.ToStr(0, n);
    }

    /// <summary>Sends a UDP datagram.</summary>
    static int SendTo(nint sock, string data, int len, string ip, int port) {
        byte[] addr = BuildSockAddr(ip, port);
        return SysSendTo(sock, data, len, 0, addr, 16);
    }

    /// <summary>Suspends until writable, then sends a UDP datagram. Requires a
    /// non-blocking socket.</summary>
    static async int SendToAsync(nint sock, string data, int len, string ip, int port) {
        await Socket.WriteReady(sock);
        int result = SendTo(sock, data, len, ip, port);
        return result;
    }

    /// <summary>Receives a UDP datagram.</summary>
    static string RecvFrom(nint sock, int bufSize) {
        byte[] buf = new byte[bufSize + 1];
        byte[] fromAddr = new byte[16];
        byte[] fromLen = new byte[4];
        fromLen[0] = 16;
        int n = SysRecvFrom(sock, buf, bufSize, 0, fromAddr, fromLen);
        // recvfrom is a raw ws2_32 import returning C `int`; a -1 error arrives
        // zero-extended as 0xFFFFFFFF. Sign-normalize the low 32 bits so the
        // error check below sees a genuine negative rather than ~4G (which would
        // make Substring copy far past the buffer -- heap corruption).
        if (n > 2147483647) { n = n - 4294967296; }
        if (n < 0) { n = 0; }
        return buf.ToStr(0, n);
    }

    /// <summary>Suspends on the IO reactor until a datagram is available, then
    /// receives it. Requires a non-blocking socket.</summary>
    static async string RecvFromAsync(nint sock, int bufSize) {
        await Socket.ReadReady(sock);
        string result = RecvFrom(sock, bufSize);
        return result;
    }

    // Sender address of the last RecvFromPeer/RecvFromPeerAsync datagram.
    // Single-threaded runtime: read via PeerIp/PeerPort right after the recv,
    // before the next await on this coroutine.
    static string lastPeerIp = "";
    static int lastPeerPort = 0;

    /// <summary>IPv4 address of the sender of the last datagram received via
    /// RecvFromPeer / RecvFromPeerAsync.</summary>
    static string PeerIp() {
        return lastPeerIp;
    }

    /// <summary>UDP port of the sender of the last datagram received via
    /// RecvFromPeer / RecvFromPeerAsync.</summary>
    static int PeerPort() {
        return lastPeerPort;
    }

    /// <summary>Receives a UDP datagram and records the sender's address, so a
    /// server can reply (see PeerIp/PeerPort). Returns the payload ("" on
    /// error/close).</summary>
    static string RecvFromPeer(nint sock, int bufSize) {
        byte[] buf = new byte[bufSize + 1];
        byte[] fromAddr = new byte[16];
        byte[] fromLen = new byte[4];
        fromLen[0] = 16;
        int n = SysRecvFrom(sock, buf, bufSize, 0, fromAddr, fromLen);
        // Sign-normalize the low 32 bits (see RecvFrom).
        if (n > 2147483647) { n = n - 4294967296; }
        if (n < 0) { n = 0; }
        if (n > 0) {
            lastPeerPort = ((fromAddr[2] & 255) << 8) + (fromAddr[3] & 255);
            lastPeerIp = Convert.ToString(fromAddr[4] & 255) + "."
                + Convert.ToString(fromAddr[5] & 255) + "."
                + Convert.ToString(fromAddr[6] & 255) + "."
                + Convert.ToString(fromAddr[7] & 255);
        } else {
            lastPeerPort = 0;
            lastPeerIp = "";
        }
        return buf.ToStr(0, n);
    }

    /// <summary>Suspends until a datagram arrives, receives it, and records the
    /// sender's address (see PeerIp/PeerPort). Requires a non-blocking socket.</summary>
    static async string RecvFromPeerAsync(nint sock, int bufSize) {
        await Socket.ReadReady(sock);
        string result = RecvFromPeer(sock, bufSize);
        return result;
    }

    /// <summary>Resolves a hostname to an IP address.</summary>
    static string Resolve(string hostname) {
        nint he = gethostbyname(hostname);
        if (he == 0) { return ""; }
        return hostname;
    }

    /// <summary>Whether the handle still refers to an open socket. False once it
    /// has been closed (e.g. a listener taken down by Stop()).</summary>
    static bool IsOpen(nint sock) {
        return SocketAlive(sock) != 0;
    }

    /// <summary>Checks if a socket is readable using select() with zero timeout.</summary>
    static bool IsReadable(nint sock) {
        return ReactorReady(sock, 0) > 0;
    }

    /// <summary>Checks if a socket is writable using select() with zero timeout.</summary>
    static bool IsWritable(nint sock) {
        return ReactorReady(sock, 1) > 0;
    }
}
