using System;

namespace System.Net.Sockets;

/// <summary>
/// 由 reactor 驱动的异步套接字操作。
///
/// 与旧版 <c>Socket.*Async</c> 辅助方法不同——它们在
/// <c>select()</c> 上忙等并阻塞调用线程——这些方法真正
/// 通过 <c>await Socket.ReadReady</c> /
/// <c>await Socket.WriteReady</c> 挂起到无栈 IO reactor，且只在 fd 就绪后才操作它，
/// 因此多个协程可在单线程上并行推进。
///
/// 套接字应为非阻塞（<c>Socket.SetNonBlocking</c>）。
/// 就绪唤醒后系统调用即可无阻塞完成；虚假唤醒或
/// 暂时性 would-block（&lt; 0）只会重新注册监视器并再次等待。
/// </summary>
class AsyncSocket {
    [DllImport("crt")]
    static extern long strlen(string str);

    /// <summary>挂起直到 <paramref name="sock"/> 可读，然后
    /// 接收最多 <paramref name="bufSize"/> 字节。数据以
    /// NUL 结尾字符串返回（对端关闭 / EOF 时为空字符串）。</summary>
    static async string Receive(nint sock, int bufSize) {
        byte[] buf = new byte[bufSize + 1];
        int n = await Socket.RecvOv(sock, buf, bufSize);
        if (n < 0) {
            n = 0;
        }
        return buf.ToStr(0, n);
    }

    /// <summary>挂起直到可读，然后接收最多
    /// <paramref name="bufSize"/> 字节到调用方拥有的缓冲区，返回
    /// 字节数（对端关闭时为 0）。无每次调用分配或拷贝——
    /// 长连接跨消息复用同一缓冲区，而非
    /// <see cref="Receive"/> 每次调用都做的缓冲区 + <c>ToStr</c>。
    /// </summary>
    static async int ReceiveInto(nint sock, string buf, int bufSize) {
        int n = await Socket.RecvIntoAsync(sock, buf, bufSize);
        return n;
    }

    /// <summary>挂起直到可写，然后发送；遇到部分写入
    /// 会循环（重新等待），直到 <paramref name="len"/> 字节全部发送完或
    /// 对端关闭。返回已发送字节数。二进制安全：未发送
    /// 的剩余部分通过下标拷贝携带，而非 <c>data + total</c> 指针
    /// 运算（后者会被编译为拼接并在第一个
    /// NUL 字节处截断）。</summary>
    static async int Send(nint sock, string data, int len) {
        int r = await Socket.SendAsync(sock, data, len);
        return r;
    }

    /// <summary>发送整个字符串（长度由 strlen 得出）。</summary>
    static async int SendString(nint sock, string data) {
        int len = (int)strlen(data);
        int r = await Send(sock, data, len);
        return r;
    }

    /// <summary>挂起直到有入站连接待处理，然后接受
    /// 连接。返回已接受的客户端 fd。</summary>
    static async nint Accept(nint sock) {
        #if WINDOWS
        return await Socket.AcceptOv(sock);
        #else
        while (true) {
            await Socket.ReadReady(sock);
            nint client = Socket.Accept(sock);
            if (client >= 0) {
                return client;
            }
            // accept 挂起期间监听器已关闭：停止重试（参见
            // Socket.AcceptAsync）。
            if (!Socket.IsOpen(sock)) {
                return -1;
            }
        }
        return -1;
        #endif
    }

    /// <summary>发起非阻塞连接，然后挂起直到连接确定。
    /// 成功返回 0，失败返回非零 SO_ERROR 错误码
    /// （连接被拒绝/不可达/超时）。连接进行中时套接字
    /// 同样会变为可写，仅凭 WriteReady 无法区分成败——
    /// 必须探测 SO_ERROR，否则连接失败会被误报为成功。</summary>
    static async int Connect(nint sock, string ip, int port) {
        return await Socket.ConnectAsync(sock, ip, port);
    }
}
