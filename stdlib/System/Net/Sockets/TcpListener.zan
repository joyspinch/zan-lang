using System;
using System.Net.Sockets;

namespace System.Net.Sockets;

/// <summary>
/// 跨平台的异步 TCP 服务器监听器。
/// 借鉴 Workerman 的思路：每个被接受的连接都可以
/// 在独立的协程中处理，从而支持海量并发。
///
/// 用法：
///   var listener = new TcpListener("0.0.0.0", 8080);
///   TcpListener.Start(listener);
///   while (true) {
///       nint client = await TcpListener.AcceptAsync(listener);
///       // 派生一个协程来处理该客户端
///   }
/// </summary>
class TcpListener {
    nint sock;
    string host;
    int port;
    bool running;
    int backlog;

    TcpListener(string host, int port) {
        Socket.Initialize();
        this.host = host;
        this.port = port;
        this.running = false;
        this.backlog = 128;
        this.sock = -1;
    }

    /// <summary>创建并启动一个带自定义 backlog 的监听器。</summary>
    static TcpListener CreateAndStart(string host, int port, int backlog) {
        TcpListener listener = new TcpListener(host, port);
        listener.backlog = backlog;
        listener.Start();
        return listener;
    }

    /// <summary>开始监听传入的连接。</summary>
    void Start() {
        this.sock = Socket.CreateTcp();
        Socket.SetReuseAddr(this.sock);
        Socket.Bind(this.sock, this.host, this.port);
        Socket.Listen(this.sock, this.backlog);
        Socket.SetNonBlocking(this.sock);
        this.running = true;
    }

    /// <summary>在 bind 前启用 SO_REUSEPORT 再开始监听，这样
    /// 多个 worker 进程可共享同一地址:端口，由内核
    /// 在它们之间负载均衡（Linux/macOS）。Windows 上行为同
    /// Start（无 SO_REUSEPORT）。</summary>
    void StartReusePort() {
        this.sock = Socket.CreateTcp();
        Socket.SetReuseAddr(this.sock);
        Socket.SetReusePort(this.sock);
        Socket.Bind(this.sock, this.host, this.port);
        Socket.Listen(this.sock, this.backlog);
        Socket.SetNonBlocking(this.sock);
        this.running = true;
    }

    /// <summary>在 IO reactor 上挂起直到客户端连接，然后接受
    /// 连接。接受的套接字被设为非阻塞，因此其上的异步 recv/send 也会
    /// 在 reactor 上挂起。</summary>
    async nint AcceptAsync() {
        nint client = await Socket.AcceptAsync(this.sock);
        if (client >= 0) {
            Socket.SetNonBlocking(client);
        }
        return client;
    }

    /// <summary>同步接受客户端连接。</summary>
    nint Accept() {
        return Socket.Accept(this.sock);
    }

    /// <summary>停止监听器。</summary>
    void Stop() {
        this.running = false;
        if (this.sock >= 0) {
            Socket.Close(this.sock);
            this.sock = -1;
        }
    }

    /// <summary>返回监听器是否正在运行。</summary>
    bool IsRunning() {
        return this.running;
    }

    /// <summary>返回底层套接字句柄。</summary>
    nint GetSocket() {
        return this.sock;
    }

    /// <summary>返回绑定的端口。</summary>
    int GetPort() {
        return this.port;
    }

    /// <summary>返回绑定的主机。</summary>
    string GetHost() {
        return this.host;
    }
}
