using System;
using System.Net.Sockets;

namespace System.Net.Sockets;

/// <summary>
/// 基于 Socket 层实现的 TCP 客户端，提供发送/接收操作。
/// </summary>
class TcpClient {
    nint sock;
    string host;
    int port;
    bool connected;
    int recvBufSize;
    string recvBuf;

    [DllImport("crt")]
    static extern long strlen(string str);

    TcpClient() {
        this.sock = -1;
        this.host = "";
        this.port = 0;
        this.connected = false;
        this.recvBufSize = 65536;
        this.recvBuf = null;
    }

    /// <summary>返回底层套接字句柄（例如用于在
    /// TlsStream 中包装连接）。</summary>
    nint Sock() {
        return this.sock;
    }

    /// <summary>从已连接的套接字创建 TcpClient。</summary>
    static TcpClient FromSocket(nint sock) {
        TcpClient client = new TcpClient();
        client.sock = sock;
        client.connected = true;
        return client;
    }

    /// <summary>连接远程主机，在 IO reactor 上挂起直到
    /// 连接建立（非阻塞 connect）。连接失败时返回 null
    /// （例如被拒绝或不可达）。</summary>
    static async TcpClient ConnectAsync(string host, int port) {
        Socket.Initialize();
        TcpClient client = new TcpClient();
        client.host = host;
        client.port = port;
        client.sock = Socket.CreateTcp();
        Socket.SetNonBlocking(client.sock);
        int err = await Socket.ConnectAsync(client.sock, host, port);
        if (err != 0) {
            Socket.Close(client.sock);
            client.sock = -1;
            return null;
        }
        client.connected = true;
        return client;
    }

    /// <summary>带 <paramref name="timeoutMs"/> 截止时间的 ConnectAsync：
    /// 连接失败，或在截止时间到来时仍处于等待状态，则返回
    /// null（用 LastConnectTimedOut 区分两种情况）。非正超时
    /// 表示"不设截止时间"。</summary>
    static async TcpClient ConnectAsync(string host, int port, int timeoutMs) {
        Socket.Initialize();
        TcpClient client = new TcpClient();
        client.host = host;
        client.port = port;
        client.sock = Socket.CreateTcp();
        Socket.SetNonBlocking(client.sock);
        TcpClient.MarkConnectTimeout(false);
        int err = await Socket.ConnectAsync(client.sock, host, port, timeoutMs);
        if (err != 0) {
            // 超时时套接字仍在连接过程中；关闭它会中止
            // 挂起的握手，避免遗留描述符（或 SYN 重试）。
            Socket.Close(client.sock);
            client.sock = -1;
            TcpClient.MarkConnectTimeout(err == -3);
            return null;
        }
        client.connected = true;
        return client;
    }

    /// <summary>本线程最近一次 ConnectAsync 是因超时放弃
    /// 而非被拒绝时为 true。通过同步辅助函数写入，
    /// 因为在 async 方法内给静态变量赋值会被按值捕获，
    /// 更新永远到不了调用方。</summary>
    static bool LastConnectTimedOut() {
        return TcpClient.connectTimedOut;
    }

    static bool connectTimedOut = false;

    static void MarkConnectTimeout(bool timedOut) {
        TcpClient.connectTimedOut = timedOut;
    }

    /// <summary>同步连接远程主机。</summary>
    static TcpClient Connect(string host, int port) {
        Socket.Initialize();
        TcpClient client = new TcpClient();
        client.host = host;
        client.port = port;
        client.sock = Socket.CreateTcp();
        Socket.Connect(client.sock, host, port);
        client.connected = true;
        return client;
    }

    /// <summary>发送数据，必要时在 IO reactor 上挂起。</summary>
    async int SendAsync(string data) {
        int len = (int)strlen(data);
        int r = await Socket.SendAsync(this.sock, data, len);
        return r;
    }

    /// <summary>发送原始字节，必要时在 IO reactor 上挂起。</summary>
    async int SendBytesAsync(string data, int len) {
        int r = await Socket.SendAsync(this.sock, data, len);
        return r;
    }

    /// <summary>接收数据，在 IO reactor 上挂起直到可读。</summary>
    async string RecvAsync(int bufSize) {
        string r = await Socket.RecvAsync(this.sock, bufSize);
        return r;
    }

    /// <summary>带 <paramref name="timeoutMs"/> 截止时间的接收：时限内
    /// 没有数据到达时返回空串（用 Socket.LastRecvTimedOut 与对端关闭
    /// 区分）。非正超时表示"不设截止时间"。</summary>
    async string RecvAsync(int bufSize, int timeoutMs) {
        string r = await Socket.RecvAsync(this.sock, bufSize, timeoutMs);
        return r;
    }

    /// <summary>使用默认缓冲区大小接收。</summary>
    async string RecvAsync() {
        string r = await Socket.RecvAsync(this.sock, this.recvBufSize);
        return r;
    }

    /// <summary>接收数据到本连接的复用缓冲区，在
    /// IO reactor 上挂起直到可读。缓冲区每条连接只分配一次，
    /// 在 keep-alive 请求间复用，因此没有每次请求的
    /// 分配/清零开销。返回以 NUL 结尾的接收字节
    /// 字符串（对端关闭时为空）。返回的字符串指向共享缓冲区，
    /// 仅在该客户端下一次接收前有效。</summary>
    async string RecvReuseAsync() {
        if (this.recvBuf == null) {
            this.recvBuf = TcpClient.RentRecvBuffer(this.recvBufSize);
        }
        int _n = await Socket.RecvIntoAsync(this.sock, this.recvBuf, this.recvBufSize);
        return this.recvBuf;
    }

    // 复用缓冲区的进程级空闲池。缓冲区本身是 ARC 托管字符串
    // （见 RentRecvBuffer），构建一个的代价是按字节填充 64KB
    // ——每条连接付一次的话，短连接（Connection: close）负载下
    // 它比处理请求本身还贵。连接关闭时把缓冲区还回池中，
    // 下一条连接直接借用：稳定状态下既没有构建开销，
    // 也没有 64KB 的分配/释放抖动。
    static List<string> recvPool = new List<string>();
    static int recvPoolSize = 65536;
    static int recvPoolMax = 256;

    /// <summary>借一个至少 <paramref name="size"/> 字节的接收缓冲区。
    /// 只有默认大小的缓冲区进池：池里的每一项都是本方法按
    /// recvPoolSize 构建的，所以借出的容量总是已知且足够。</summary>
    static string RentRecvBuffer(int size) {
        if (size == TcpClient.recvPoolSize) {
            int n = TcpClient.recvPool.Count;
            if (n > 0) {
                string buf = TcpClient.recvPool[n - 1];
                TcpClient.recvPool.RemoveAt(n - 1);
                return buf;
            }
        }
        // 把复用缓冲区分配为真正的 ARC 托管字符串。与原始 calloc
        // 块不同，它带有字符串引用计数头，因此 ARC 能正确释放；
        // 原始缓冲区会被手动释放，之后又可能被后续的
        // str_release 再次读取，一旦堆回收了那 64KB 页面就会出错。
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < size; i = i + 1) {
            sb.Append(" ");
        }
        return sb.ToString();
    }

    /// <summary>把缓冲区还回池中。调用方在归还后不得再读取它
    /// （RecvReuseAsync 的返回值本来就只在下一次接收前有效）。</summary>
    static void ReturnRecvBuffer(string buf, int size) {
        if (buf == null) { return; }
        if (size != TcpClient.recvPoolSize) { return; }
        if (TcpClient.recvPool.Count >= TcpClient.recvPoolMax) { return; }
        TcpClient.recvPool.Add(buf);
    }

    /// <summary>同步发送数据。</summary>
    int Send(string data) {
        return Socket.SendString(this.sock, data);
    }

    /// <summary>同步接收数据。</summary>
    string Recv(int bufSize) {
        return Socket.Receive(this.sock, bufSize);
    }

    /// <summary>关闭连接。</summary>
    void Close() {
        if (this.connected) {
            Socket.Close(this.sock);
            this.connected = false;
            this.sock = -1;
        }
        // 归还每条连接的接收缓冲区，供下一条连接复用；池满时
        // 直接丢弃，清空该字段即释放最后一个引用（ARC 托管字符串）。
        if (this.recvBuf != null) {
            TcpClient.ReturnRecvBuffer(this.recvBuf, this.recvBufSize);
            this.recvBuf = null;
        }
    }

    /// <summary>已连接时返回 true。</summary>
    bool IsConnected() {
        return this.connected;
    }

    /// <summary>获取底层套接字句柄。</summary>
    nint GetSocket() {
        return this.sock;
    }

    /// <summary>设置接收缓冲区大小。</summary>
    void SetRecvBufferSize(int size) {
        this.recvBufSize = size;
    }
}
