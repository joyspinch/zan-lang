using System;
using System.Net.Sockets;

namespace System.Net.Sockets;

/// <summary>
/// 跨平台的异步 UDP 客户端/服务器。
/// UDP 是无连接的：一个套接字可以向多个对端发送并从多个对端接收，
/// 并与协程调度器集成。
///
/// 用法（服务器）：
///   var udp = UdpClient.Bind("0.0.0.0", 9999);
///   while (true) {
///       string data = await udp.RecvFromAsync(4096);
///       // 处理数据
///   }
///
/// 用法（客户端）：
///   var udp = new UdpClient();
///   await udp.SendToAsync("Hello", "127.0.0.1", 9999);
/// </summary>
class UdpClient {
    nint sock;
    string host;
    int port;
    bool bound;

    [DllImport("crt")]
    static extern long strlen(string str);

    UdpClient() {
        Socket.Initialize();
        this.sock = Socket.CreateUdp();
        Socket.SetNonBlocking(this.sock);
        this.host = "";
        this.port = 0;
        this.bound = false;
    }

    /// <summary>创建绑定到本地地址和端口的 UDP 套接字。</summary>
    static UdpClient Bind(string host, int port) {
        UdpClient client = new UdpClient();
        client.host = host;
        client.port = port;
        Socket.SetReuseAddr(client.sock);
        Socket.Bind(client.sock, host, port);
        client.bound = true;
        return client;
    }

    /// <summary>向指定地址发送数据报。</summary>
    int SendTo(string data, string ip, int port) {
        int len = (int)strlen(data);
        return Socket.SendTo(this.sock, data, len, ip, port);
    }

    /// <summary>发送数据报，在 IO reactor 上挂起直到可写。</summary>
    async int SendToAsync(string data, string ip, int port) {
        int len = (int)strlen(data);
        int r = await Socket.SendToAsync(this.sock, data, len, ip, port);
        return r;
    }

    /// <summary>发送原始字节。</summary>
    int SendBytesTo(string data, int len, string ip, int port) {
        return Socket.SendTo(this.sock, data, len, ip, port);
    }

    /// <summary>以显式长度发送原始字节，在 IO
    /// reactor 上挂起直到可写。用于二进制数据报：字符串
    /// 重载用 strlen 计算长度，会在第一个 NUL 处停止。</summary>
    async int SendBytesToAsync(string data, int len, string ip, int port) {
        int r = await Socket.SendToAsync(this.sock, data, len, ip, port);
        return r;
    }

    /// <summary>同步接收数据报。</summary>
    string RecvFrom(int bufSize) {
        return Socket.RecvFrom(this.sock, bufSize);
    }

    /// <summary>接收数据报到调用方提供的缓冲区，返回
    /// 字节数（无数据时为 0）。用于二进制数据报：字符串
    /// 版本用 strlen 计算长度，会在第一个 NUL 处停止。</summary>
    int RecvBytesFrom(byte[] buf, int bufSize) {
        return Socket.RecvFromInto(this.sock, buf, bufSize);
    }

    /// <summary>接收数据报，在 IO reactor 上挂起直到有数据报
    /// 到达。</summary>
    async string RecvFromAsync(int bufSize) {
        string r = await Socket.RecvFromAsync(this.sock, bufSize);
        return r;
    }

    /// <summary>使用默认缓冲区大小接收。</summary>
    async string RecvFromAsync() {
        string r = await Socket.RecvFromAsync(this.sock, 65536);
        return r;
    }

    /// <summary>关闭 UDP 套接字。</summary>
    void Close() {
        if (this.sock >= 0) {
            Socket.Close(this.sock);
            this.sock = -1;
        }
    }

    /// <summary>返回底层套接字句柄。</summary>
    nint GetSocket() {
        return this.sock;
    }

    /// <summary>返回该套接字是否已绑定。</summary>
    bool IsBound() {
        return this.bound;
    }

    /// <summary>在套接字上启用广播。</summary>
    void EnableBroadcast() {
        Socket.SetBroadcast(this.sock);
    }
}
