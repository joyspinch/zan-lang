using System;
using System.Net.Sockets;
using System.Net.Http;
using System.Net.Tls;
using System.Text;
using System.Security.Cryptography;
using System.Collections.Generic;
using System.Runtime.Intrinsics;
using System.Threading;

namespace System.Net.WebSocket;

/// <summary>
/// WebSocket 帧操作码（opcode）。
/// </summary>
class WsOpcode {
    /// 分片消息的后续帧（RFC 6455 §5.4）。
    static const int Continuation = 0;
    /// UTF-8 文本消息。
    static const int Text = 1;
    /// 二进制消息。
    static const int Binary = 2;
    /// 连接关闭（含 2 字节状态码负载）。
    static const int Close = 8;
    /// 心跳探测（负载原样由 Pong 回）。
    static const int Ping = 9;
    /// 心跳应答。
    static const int Pong = 10;
}

/// <summary>Shared server-side RFC 6455 upgrade gate for plain and TLS ports.</summary>
class WsHandshake {
    static bool HasToken(string value, string token) {
        if (value == null) { return false; }
        int n = value.Length;
        int start = 0;
        while (start < n) {
            int stop = start;
            while (stop < n && (value[stop] & 255) != 44) { stop = stop + 1; }
            int a = start;
            while (a < stop && ((value[a] & 255) == 32 || (value[a] & 255) == 9)) { a = a + 1; }
            int b = stop;
            while (b > a && ((value[b - 1] & 255) == 32 || (value[b - 1] & 255) == 9)) { b = b - 1; }
            if (b - a == token.Length) {
                bool match = true;
                for (int i = 0; i < token.Length; i = i + 1) {
                    int c = value[a + i] & 255;
                    if (c >= 65 && c <= 90) { c = c + 32; }
                    if (c != (token[i] & 255)) { match = false; break; }
                }
                if (match) { return true; }
            }
            start = stop + 1;
        }
        return false;
    }

    static bool Valid(HttpRequest req) {
        if (req == null || req.parseStatus != 0 || req.method != "GET"
            || req.version != "HTTP/1.1" || !WsHandshake.SafeRequestPart(req.path, true)
            || !WsHandshake.SafeRequestPart(req.GetHeader("Host"), false)
            || !WsHandshake.HasToken(req.GetHeader("Upgrade"), "websocket")
            || !WsHandshake.HasToken(req.GetHeader("Connection"), "upgrade")
            || req.GetHeader("Sec-WebSocket-Version") != "13") { return false; }
        string key = req.GetHeader("Sec-WebSocket-Key");
        if (key == null || key.Length != 24) { return false; }
        List<int> decodedLen = new List<int>();
        decodedLen.Add(0);
        byte[] decoded = Base64.Decode(key, decodedLen);
        return decoded != null && decodedLen[0] == 16
            && Base64.Encode(decoded, 16) == key;
    }

    static bool SafeRequestPart(string value, bool allowEmpty) {
        if (value == null || value.Length == 0) { return false; }
        for (int i = 0; i < value.Length; i = i + 1) {
            int c = value[i] & 255;
            if (c <= 32 || c == 127 || c == 0) { return false; }
        }
        return true;
    }

    static bool ValidResponse(string head, string expectedAccept) {
        if (head == null || expectedAccept == null) { return false; }
        int firstEnd = head.IndexOf("\r\n", 0);
        if (firstEnd < 12 || head.Substring(0, 12) != "HTTP/1.1 101") { return false; }
        if (firstEnd > 12 && (head[12] & 255) != 32) { return false; }
        int upgradeCount = 0;
        int connectionCount = 0;
        int acceptCount = 0;
        string upgrade = "";
        string connection = "";
        string accept = "";
        int pos = firstEnd + 2;
        while (pos < head.Length) {
            int end = head.IndexOf("\r\n", pos);
            if (end < 0) { end = head.Length; }
            if (end == pos) { break; }
            int colon = head.IndexOf(":", pos);
            if (colon <= pos || colon >= end) { return false; }
            for (int i = pos; i < colon; i = i + 1) {
                int c = head[i] & 255;
                if (c <= 32 || c >= 127 || c == 58) { return false; }
            }
            int start = colon + 1;
            while (start < end && ((head[start] & 255) == 32 || (head[start] & 255) == 9)) { start = start + 1; }
            string name = head.Substring(pos, colon - pos);
            string value = head.Substring(start, end - start);
            if (WsHandshake.HasToken(name, "upgrade")) {
                upgradeCount = upgradeCount + 1; upgrade = value;
            } else if (WsHandshake.HasToken(name, "connection")) {
                connectionCount = connectionCount + 1; connection = value;
            } else if (WsHandshake.HasToken(name, "sec-websocket-accept")) {
                acceptCount = acceptCount + 1; accept = value;
            }
            for (int i = 0; i < value.Length; i = i + 1) {
                int c = value[i] & 255;
                if (c == 0 || c == 10 || c == 13 || c == 127) { return false; }
            }
            if (end >= head.Length) { break; }
            pos = end + 2;
        }
        return upgradeCount == 1 && connectionCount == 1 && acceptCount == 1
            && WsHandshake.HasToken(upgrade, "websocket")
            && WsHandshake.HasToken(connection, "upgrade")
            && accept == expectedAccept;
    }
}

/// <summary>
/// WebSocket 帧构建与解析器（RFC 6455）。
/// </summary>
class WsFrame {
    int opcode;
    string payload;
    int payloadLen;
    bool fin;
    bool masked;
    int rsv;

    /// 内部构造：Text 帧、fin、不掩码；字段由各工厂方法填。
    WsFrame() {
        this.opcode = WsOpcode.Text;
        this.payload = "";
        this.payloadLen = 0;
        this.fin = true;
        this.masked = false;
        this.rsv = 0;
    }

    /// 载荷为整串的 Text 帧。
    static WsFrame TextFrame(string data) {
        WsFrame f = new WsFrame();
        f.opcode = WsOpcode.Text;
        f.payload = data;
        f.payloadLen = data.Length;
        return f;
    }

    /// 二进制帧：data 可含 NUL，len 为精确字节数。
    static WsFrame BinaryFrame(string data, int len) {
        WsFrame f = new WsFrame();
        f.opcode = WsOpcode.Binary;
        f.payload = data;
        f.payloadLen = len;
        return f;
    }

    /// 不带状态码的空关闭帧。
    static WsFrame CloseFrame() {
        WsFrame f = new WsFrame();
        f.opcode = WsOpcode.Close;
        return f;
    }

    /// <summary>带状态码的关闭帧（RFC 6455 §7.1.5 的 2 字节
    /// 负载）。协议错误 1002、消息过大 1009 等场景下应告知
    /// 对端原因，而不是发空关闭帧。</summary>
    static WsFrame CloseFrameWithCode(int code) {
        WsFrame f = new WsFrame();
        f.opcode = WsOpcode.Close;
        byte[] p = new byte[3];
        p[0] = (byte)((code >> 8) & 255);
        p[1] = (byte)(code & 255);
        f.payload = p.ToStr(0, 2);
        f.payloadLen = 2;
        return f;
    }

    /// 空 Ping 帧。
    static WsFrame PingFrame() {
        WsFrame f = new WsFrame();
        f.opcode = WsOpcode.Ping;
        return f;
    }

    /// 空 Pong 帧。
    static WsFrame PongFrame() {
        WsFrame f = new WsFrame();
        f.opcode = WsOpcode.Pong;
        return f;
    }

    /// <summary>任意 opcode 的出站帧（客户端统一发送入口用）。</summary>
    static WsFrame RawFrame(int opcode, string payload, int payloadLen) {
        WsFrame f = new WsFrame();
        f.opcode = opcode;
        f.payload = payload;
        f.payloadLen = payloadLen;
        return f;
    }

    /// <summary>帧头字节数（RFC 6455 长度编码）。发送方据它
    /// 计算真实写出长度——此前发送方硬编码 2，载荷超过 125 字节时
    /// 帧头被截断、帧流从此错位。</summary>
    static int HeaderLen(int payloadLen) {
        if (payloadLen > 65535) { return 10; }
        if (payloadLen > 125) { return 4; }
        return 2;
    }

    /// 服务端方向编码：FIN + opcode + RFC 6455 长度编码 + 载荷
    /// （不掩码；客户端须用 EncodeMasked）。
    byte[] Encode() {
        int headerLen = WsFrame.HeaderLen(this.payloadLen);
        byte[] buf = new byte[headerLen + this.payloadLen + 1];
        int byte0 = 128 + this.opcode;
        buf[0] = (byte)byte0;

        if (this.payloadLen > 65535) {
            buf[1] = 127;
            buf[2] = 0;
            buf[3] = 0;
            buf[4] = 0;
            buf[5] = 0;
            buf[6] = (byte)((this.payloadLen >> 24) & 255);
            buf[7] = (byte)((this.payloadLen >> 16) & 255);
            buf[8] = (byte)((this.payloadLen >> 8) & 255);
            buf[9] = (byte)(this.payloadLen & 255);
        } else if (this.payloadLen > 125) {
            buf[1] = 126;
            buf[2] = (byte)((this.payloadLen >> 8) & 255);
            buf[3] = (byte)(this.payloadLen & 255);
        } else {
            buf[1] = (byte)this.payloadLen;
        }

        if (this.payloadLen > 0) {
            NativeMemory.PutString((nint)buf, headerLen, this.payload, this.payloadLen);
        }

        return buf;
    }

    /// <summary>客户端方向的帧：RFC 6455 §5.1 要求浏览器之外的客户端
    /// 也必须掩码，合规的服务器与代理会直接拒绝未掩码帧。每帧用
    /// CSPRNG 掩码键（与 WssClient 相同的方案）。</summary>
    byte[] EncodeMasked() {
        int headerLen = WsFrame.HeaderLen(this.payloadLen) + 4;
        byte[] buf = new byte[headerLen + this.payloadLen + 1];
        int byte0 = 128 + this.opcode;
        buf[0] = (byte)byte0;

        int pos = 2;
        if (this.payloadLen > 65535) {
            buf[1] = (byte)(128 + 127);
            buf[2] = 0;
            buf[3] = 0;
            buf[4] = 0;
            buf[5] = 0;
            buf[6] = (byte)((this.payloadLen >> 24) & 255);
            buf[7] = (byte)((this.payloadLen >> 16) & 255);
            buf[8] = (byte)((this.payloadLen >> 8) & 255);
            buf[9] = (byte)(this.payloadLen & 255);
            pos = 10;
        } else if (this.payloadLen > 125) {
            buf[1] = (byte)(128 + 126);
            buf[2] = (byte)((this.payloadLen >> 8) & 255);
            buf[3] = (byte)(this.payloadLen & 255);
            pos = 4;
        } else {
            buf[1] = (byte)(128 + this.payloadLen);
        }

        byte[] mask = RandomNumberGenerator.GetBytes(4);
        if (mask == null) { mask = new byte[] { 0, 0, 0, 0 }; }
        for (int m = 0; m < 4; m = m + 1) { buf[pos + m] = mask[m]; }
        pos = pos + 4;

        if (this.payloadLen > 0) {
            NativeMemory.PutString((nint)buf, pos, this.payload, this.payloadLen);

            long m0 = (long)(mask[0] & 255);
            long m1 = (long)(mask[1] & 255);
            long m2 = (long)(mask[2] & 255);
            long m3 = (long)(mask[3] & 255);
            long k32 = m0 | (m1 << 8) | (m2 << 16) | (m3 << 24);
            long k64 = k32 | (k32 << 32);

            Vector256 mask256 = Vector256.Create(k64, k64, k64, k64);
            Vector128 mask128 = Vector128.Create(k64, k64);

            int iEnc = 0;
            while (iEnc + 32 <= this.payloadLen) {
                Vector256 v = Vector256.Load(buf, pos + iEnc);
                v = Vector256.Xor(v, mask256);
                Vector256.Store(buf, pos + iEnc, v);
                iEnc = iEnc + 32;
            }
            while (iEnc + 16 <= this.payloadLen) {
                Vector128 v128 = Vector128.Load(buf, pos + iEnc);
                v128 = Vector128.Xor(v128, mask128);
                Vector128.Store(buf, pos + iEnc, v128);
                iEnc = iEnc + 16;
            }
            int limitEnc = this.payloadLen - 3;
            int sm0 = (int)m0; int sm1 = (int)m1; int sm2 = (int)m2; int sm3 = (int)m3;
            while (iEnc < limitEnc) {
                buf[pos + iEnc] = (byte)((buf[pos + iEnc] & 255) ^ sm0);
                buf[pos + iEnc + 1] = (byte)((buf[pos + iEnc + 1] & 255) ^ sm1);
                buf[pos + iEnc + 2] = (byte)((buf[pos + iEnc + 2] & 255) ^ sm2);
                buf[pos + iEnc + 3] = (byte)((buf[pos + iEnc + 3] & 255) ^ sm3);
                iEnc = iEnc + 4;
            }
            if (iEnc < this.payloadLen) {
                buf[pos + iEnc] = (byte)((buf[pos + iEnc] & 255) ^ sm0);
                iEnc = iEnc + 1;
                if (iEnc < this.payloadLen) {
                    buf[pos + iEnc] = (byte)((buf[pos + iEnc] & 255) ^ sm1);
                    iEnc = iEnc + 1;
                    if (iEnc < this.payloadLen) {
                        buf[pos + iEnc] = (byte)((buf[pos + iEnc] & 255) ^ sm2);
                    }
                }
            }
        }

        return buf;
    }

    /// <summary>解码从 `offset` 开始的帧；`frameLen` 为其
    /// 总字节长度。原地读取让读取方能在同一缓冲区中持有多个管道帧，
    /// 而不必在每帧之后搬移剩余数据。
    ///
    /// 所有扩展长度/掩码读取都先对照 `frameLen` 判界，64 位长度
    /// 的高 32 位必须为零（RFC 6455 要求 MSB=0 且连接失败）——
    /// 此前截断帧会读到越界字节、声明超长载荷会负向 Substring，
    /// 都是 rt_crash 边界陷阱级的进程死亡。违规时返回 opcode=Close
    /// 的空帧，调用方按关闭处理。
    ///
    /// 调用方必须保证底层缓冲覆盖 `offset0 + frameLen` 字节——
    /// WsReader.FrameSize 返回正数时恰好给出这一保证。这里的
    /// 缓冲实参是按 string 传入的 byte[]：其 `.Length` 退化为
    /// strlen，而帧字节里随时可能出现 NUL（continuation 帧的
    /// opcode 就是 0），因此绝不能拿 `data.Length` 当边界用——
    /// 旧的按 strlen 钳制会提前截断 dataEnd，让解码器把完整帧
    /// 误判为空帧并静默丢弃。</summary>
    static WsFrame DecodeAt(string data, int offset0, int frameLen) {
        WsFrame f = new WsFrame();
        if (frameLen < 2) { return f; }
        int dataEnd = offset0 + frameLen;
        if (offset0 + 2 > dataEnd) { return f; }

        int byte0 = data[offset0] & 255;
        int byte1 = data[offset0 + 1] & 255;

        f.fin = (byte0 & 128) != 0;
        f.rsv = byte0 & 112;
        f.opcode = byte0 & 15;
        f.masked = (byte1 & 128) != 0;

        int payloadLen = byte1 & 127;
        if (f.opcode >= 8) {
            // RFC 6455 §5.5: 所有控制帧（Close/Ping/Pong）载荷不得超过 125 字节，
            // 且绝对禁止分片（FIN 必须为 1）。
            if (!f.fin || payloadLen > 125) {
                f.opcode = WsOpcode.Close;
                return f;
            }
        }
        int offset = offset0 + 2;

        if (payloadLen == 126) {
            if (offset0 + 4 > dataEnd) { f.opcode = WsOpcode.Close; return f; }
            payloadLen = ((data[offset0 + 2] & 255) << 8) + (data[offset0 + 3] & 255);
            offset = offset0 + 4;
        } else if (payloadLen == 127) {
            if (offset0 + 10 > dataEnd) { f.opcode = WsOpcode.Close; return f; }
            if ((data[offset0 + 2] & 255) != 0 || (data[offset0 + 3] & 255) != 0
                || (data[offset0 + 4] & 255) != 0 || (data[offset0 + 5] & 255) != 0
                || (data[offset0 + 6] & 128) != 0) {
                // 64 位长度的高 32 位及最高位（MSB）必须为 0：按 RFC 6455 §5.2 视为协议错误。
                f.opcode = WsOpcode.Close;
                return f;
            }
            payloadLen = ((data[offset0 + 6] & 255) << 24) +
                         ((data[offset0 + 7] & 255) << 16) +
                         ((data[offset0 + 8] & 255) << 8) + (data[offset0 + 9] & 255);
            if (payloadLen < 0) {
                f.opcode = WsOpcode.Close;
                return f;
            }
            offset = offset0 + 10;
        }

        if (f.masked) {
            if (offset + 4 > dataEnd) { f.opcode = WsOpcode.Close; return f; }
        }

        f.payloadLen = payloadLen;

        // 声明的载荷超过缓冲里实际拥有的字节：只解出可用的部分，
        // 绝不越过缓冲边界（正常路径上 FrameSize 已保证完整帧）。
        int avail = dataEnd - offset;
        if (f.masked) { avail = avail - 4; }
        int copyLen = payloadLen < avail ? payloadLen : avail;
        if (copyLen < 0) { copyLen = 0; }

        if (f.masked) {
            long m0 = (long)(data[offset] & 255);
            long m1 = (long)(data[offset + 1] & 255);
            long m2 = (long)(data[offset + 2] & 255);
            long m3 = (long)(data[offset + 3] & 255);
            offset = offset + 4;

            byte[] payload = new byte[copyLen + 1];
            if (copyLen > 0) {
                NativeMemory.Copy((nint)payload, (nint)data + (nint)offset, copyLen);

                long k32 = m0 | (m1 << 8) | (m2 << 16) | (m3 << 24);
                long k64 = k32 | (k32 << 32);

                Vector256 mask256 = Vector256.Create(k64, k64, k64, k64);
                Vector128 mask128 = Vector128.Create(k64, k64);

                int iDec = 0;
                while (iDec + 32 <= copyLen) {
                    Vector256 v = Vector256.Load(payload, iDec);
                    v = Vector256.Xor(v, mask256);
                    Vector256.Store(payload, iDec, v);
                    iDec = iDec + 32;
                }
                while (iDec + 16 <= copyLen) {
                    Vector128 v128 = Vector128.Load(payload, iDec);
                    v128 = Vector128.Xor(v128, mask128);
                    Vector128.Store(payload, iDec, v128);
                    iDec = iDec + 16;
                }
                int limitDec = copyLen - 3;
                int sm0 = (int)m0; int sm1 = (int)m1; int sm2 = (int)m2; int sm3 = (int)m3;
                while (iDec < limitDec) {
                    payload[iDec] = (byte)((payload[iDec] & 255) ^ sm0);
                    payload[iDec + 1] = (byte)((payload[iDec + 1] & 255) ^ sm1);
                    payload[iDec + 2] = (byte)((payload[iDec + 2] & 255) ^ sm2);
                    payload[iDec + 3] = (byte)((payload[iDec + 3] & 255) ^ sm3);
                    iDec = iDec + 4;
                }
                if (iDec < copyLen) {
                    payload[iDec] = (byte)((payload[iDec] & 255) ^ sm0);
                    iDec = iDec + 1;
                    if (iDec < copyLen) {
                        payload[iDec] = (byte)((payload[iDec] & 255) ^ sm1);
                        iDec = iDec + 1;
                        if (iDec < copyLen) {
                            payload[iDec] = (byte)((payload[iDec] & 255) ^ sm2);
                        }
                    }
                }
            }
            f.payload = payload.ToStr(0, copyLen);
        } else {
            f.payload = data.Substring(offset, copyLen);
        }

        return f;
    }

    /// RFC 6455 入站帧门禁。服务端要求客户端帧带掩码；客户端要求
    /// 服务端帧不带掩码。未协商扩展时 RSV 必须为零，控制帧必须完整
    /// 且不超过 125 字节。
    static bool ValidInbound(WsFrame frame, bool requireMasked) {
        if (frame == null) { return false; }
        if (frame.rsv != 0 || frame.masked != requireMasked) { return false; }
        if ((frame.opcode >= 3 && frame.opcode <= 7)
            || (frame.opcode >= 11 && frame.opcode <= 15)) { return false; }
        if (frame.opcode >= 8
            && (!frame.fin || frame.payloadLen > 125 || !WsFrame.ValidControlPayload(frame))) {
            return false;
        }
        return true;
    }

    static bool ValidControlPayload(WsFrame frame) {
        if (frame.opcode != WsOpcode.Close) { return true; }
        if (frame.payloadLen == 1) { return false; }
        if (frame.payloadLen == 0) { return true; }
        if (frame.payload == null || frame.payloadLen < 2) { return false; }
        int code = ((frame.payload[0] & 255) << 8) | (frame.payload[1] & 255);
        if (!((code >= 1000 && code <= 1003)
            || (code >= 1007 && code <= 1011)
            || (code >= 3000 && code <= 4999))) { return false; }
        if (frame.payloadLen > 2) {
            return WsFrame.ValidUtf8(frame.payload.Substring(2), frame.payloadLen - 2);
        }
        return true;
    }

    /// 严格校验一段显式长度的 UTF-8。过短、过长、代理项和超范围码点
    /// 均拒绝；调用方只在完整消息/关闭原因上调用，避免拆分码点被误判。
    static bool ValidUtf8(string text, int len) {
        if (text == null || len < 0) { return false; }
        int i = 0;
        while (i < len) {
            int b0 = text[i] & 255;
            if (b0 <= 0x7f) { i = i + 1; continue; }
            if (b0 >= 0xc2 && b0 <= 0xdf) {
                if (i + 1 >= len) { return false; }
                int b1 = text[i + 1] & 255;
                if (b1 < 0x80 || b1 > 0xbf) { return false; }
                i = i + 2; continue;
            }
            if (b0 >= 0xe0 && b0 <= 0xef) {
                if (i + 2 >= len) { return false; }
                int b1 = text[i + 1] & 255; int b2 = text[i + 2] & 255;
                if (b2 < 0x80 || b2 > 0xbf
                    || (b0 == 0xe0 && b1 < 0xa0)
                    || (b0 == 0xed && b1 > 0x9f)
                    || b1 < 0x80 || b1 > 0xbf) { return false; }
                i = i + 3; continue;
            }
            if (b0 >= 0xf0 && b0 <= 0xf4) {
                if (i + 3 >= len) { return false; }
                int b1 = text[i + 1] & 255; int b2 = text[i + 2] & 255;
                int b3 = text[i + 3] & 255;
                if (b2 < 0x80 || b2 > 0xbf || b3 < 0x80 || b3 > 0xbf
                    || (b0 == 0xf0 && b1 < 0x90)
                    || (b0 == 0xf4 && b1 > 0x8f)
                    || b1 < 0x80 || b1 > 0xbf) { return false; }
                i = i + 4; continue;
            }
            return false;
        }
        return true;
    }
}

/// <summary>
/// 带缓冲、二进制安全的 WebSocket 帧读取器。
///
/// 修复了朴素的“一次 recv == 一整
/// 帧”模型中的两个正确性/吞吐量缺陷：
///   1. 大于单次 recv 的帧（或被 TCP 分段拆开的帧）会
///      通过不断累积字节、直到声明的帧长度
///      全部到达才完成重组。
///   2. 一次 recv 收到多帧（管道化/合并发送）时，
///      逐帧取出处理，而不是只解码第一帧。
///
/// 它还避免了基于字符串 recv 的 NUL 截断风险：字节由 <c>Socket.Recv</c>
/// 接收（它返回真实字节数），
/// 有效长度显式记录在 <c>len</c> 中，绝不用 <c>strlen</c>。
/// </summary>
class WsReader {
    nint sock;
    // 非空时字节源为 TLS 明文流（wss），否则直接从 sock 读取。
    TlsStream tlsSrc;
    byte[] buf;
    int len;
    int cap;
    byte[] tmp;
    // 下一个未读帧的游标。已消费的帧通过向前移动游标跳过；
    // 仅当需要读取更多字节时才压缩缓冲区，
    // 这样一批管道帧只需一次搬移，而不是每帧一次。
    int start;
    // 单条消息的缓冲上限：对端声明的帧总长超过它时按
    // 协议错误拒绝（FrameSize 返回 -3），而不是把内存
    // 无限翻倍——远端声明一个 2GB 的帧再慢慢滴字节，
    // 即可把无上限的 Ensure 撑到 OOM。
    int maxLen;

    /// 内部构造：64KiB 缓冲、消息上限 16 MiB；经 new / WrapTls 使用。
    WsReader(nint sock) {
        this.sock = sock;
        this.tlsSrc = null;
        this.cap = 65536;
        this.buf = new byte[this.cap + 1];
        this.len = 0;
        this.start = 0;
        this.tmp = new byte[65537];
        this.maxLen = 16777216;   // 16 MiB，与 MQTT broker 单包上限一致
    }

    /// <summary>以 TLS 明文流为字节源的读取器（wss 连接）。</summary>
    static WsReader WrapTls(TlsStream stream) {
        // 套接字句柄无用但字段必须一致：FillMore 走 tlsSrc 分支。
        WsReader r = new WsReader((nint)0);
        r.tlsSrc = stream;
        return r;
    }

    /// <summary>调整单条消息的缓冲上限（字节）。</summary>
    void SetMaxLen(int max) { this.maxLen = max; }

    /// <summary>单条消息的缓冲上限（字节）。</summary>
    int MaxLen() { return this.maxLen; }

    /// <summary>缓冲中未读字节数。</summary>
    int Buffered() { return this.len - this.start; }

    /// <summary>把未读字节移到开头，使游标归零。</summary>
    void Compact() {
        if (this.start == 0) { return; }
        int rem = this.len - this.start;
        if (rem > 0) {
            NativeMemory.Copy((nint)this.buf, (nint)this.buf + (nint)this.start, rem);
        }
        this.len = rem;
        this.start = 0;
    }

    /// <summary>用已从套接字读到的字节初始化缓冲区。
    /// 同时服务 HTTP 与 WebSocket 的端口会自行读取握手，可能连带读入
    /// 首批帧，这些字节不能丢失。</summary>
    void Prime(string data, int n) {
        if (n <= 0) { return; }
        this.Ensure(this.len + n);
        NativeMemory.PutString((nint)this.buf, this.len, data, n);
        this.len = this.len + n;
    }

    /// <summary>扩展累积缓冲区，使其至少容纳 `need` 个字节。</summary>
    void Ensure(int need) {
        if (need <= this.cap) { return; }
        int nc = this.cap * 2;
        while (nc < need) { nc = nc * 2; }
        byte[] nb = new byte[nc + 1];
        if (this.len > 0) {
            NativeMemory.Copy((nint)nb, (nint)this.buf, this.len);
        }
        this.buf = nb;
        this.cap = nc;
    }

    /// <summary>挂起在 reactor 上直到可读，然后把收到的字节
    /// 追加进缓冲区。返回读取的字节数；0 表示对端已关闭（EOF）。</summary>
    async int FillMore() {
        int got = 0;
        this.Compact();
        while (got == 0) {
            if (this.tlsSrc != null) {
                // TLS 字节源：解密后的明文落入 tmp 并按显式字节数
                // 追加（帧负载可能含 NUL，绝不依赖 strlen）。
                int tn = await this.tlsSrc.RecvIntoAsync(this.tmp, 65536);
                if (tn <= 0) { return 0; }
                this.Ensure(this.len + tn);
                NativeMemory.Copy((nint)this.buf + (nint)this.len, (nint)this.tmp, tn);
                this.len = this.len + tn;
                got = tn;
                continue;
            }
            await Socket.ReadReady(this.sock);
            int n = 0;
            if (this.len == 0) {
                // 快路径：缓冲区为空（常见的每 recv 一帧的情况）——
                // 直接接收进缓冲区，无需中间拷贝。
                n = Socket.Recv(this.sock, this.buf, this.cap);
                if (n > 0) {
                    this.len = n;
                    got = n;
                } else if (n == 0) {
                    return 0;
                }
            } else {
                // 缓冲区已有字节（部分帧/合并帧）：先收进
                // 临时缓冲区再追加。
                n = Socket.Recv(this.sock, this.tmp, 65536);
                if (n > 0) {
                    this.Ensure(this.len + n);
                    NativeMemory.Copy((nint)this.buf + (nint)this.len, (nint)this.tmp, n);
                    this.len = this.len + n;
                    got = n;
                } else if (n == 0) {
                    return 0;
                }
            }
            // n < 0：EWOULDBLOCK/虚假唤醒——再次等待可读。
        }
        return got;
    }

    /// <summary>带空闲窗口的 FillMore：时限内没有任何字节到达时返回
    /// -1（连接未断，帧缓冲里已收到的半截字节原样保留，下次接着
    /// 读）；数据/对端关闭的语义与 FillMore 相同（>0 = 字节数，
    /// 0 = EOF）。timeoutMs 非正表示不限时，等价于 FillMore()。
    ///
    /// 实现走 Socket.RecvToOv——把接收与截止时间一起交给 reactor
    /// 竞速（超时交付 -1，不 shutdown 套接字），而不是 HttpDeadline
    /// 的手法：后者靠 ShutdownBoth 挂断唤醒，用一次连接就废一次，
    /// 撑不起「每 15 秒空闲窗口到期就 Ping 一下再继续收」的长连接
    /// 心跳循环。TLS 源分支没有对等的带截止时间原语，退化为不限时
    /// （wss 心跳调用方应改用上层 Ping/Pong 探活）。</summary>
    async int FillMore(int timeoutMs) {
        if (timeoutMs <= 0 || this.tlsSrc != null) {
            return await this.FillMore();
        }
        this.Compact();
        int n = 0;
        if (this.len == 0) {
            // 快路径：缓冲区为空（常见的每 recv 一帧的情况）——
            // 直接接收进缓冲区，无需中间拷贝。
            n = await Socket.RecvToOv(this.sock, this.buf, this.cap, timeoutMs);
            if (n > 0) { this.len = n; }
            return n < 0 ? 0 - 1 : n;
        }
        // 缓冲区已有字节（部分帧/合并帧）：先收进临时缓冲区再追加。
        n = await Socket.RecvToOv(this.sock, this.tmp, 65536, timeoutMs);
        if (n > 0) {
            this.Ensure(this.len + n);
            NativeMemory.Copy((nint)this.buf + (nint)this.len, (nint)this.tmp, n);
            this.len = this.len + n;
        }
        return n < 0 ? 0 - 1 : n;
    }

    /// <summary>缓冲区头部帧的总字节长度；若完整帧尚未全部缓冲
    /// 则返回 -1。返回 -2 = 协议违规（64 位长度的高 32 位非零，
    /// RFC 要求连接失败）；-3 = 帧总长超过 maxLen（消息过大）。
    /// 调用方对 -2/-3 都必须关闭而非继续等待。</summary>
    int FrameSize() {
        int s = this.start;
        int avail = this.len - s;
        if (avail < 2) { return -1; }
        int b0 = this.buf[s] & 255;
        int opcode = b0 & 15;
        bool fin = (b0 & 128) != 0;
        int b1 = this.buf[s + 1] & 255;
        bool masked = (b1 & 128) != 0;
        int payloadLen = b1 & 127;
        if (opcode >= 8) {
            // RFC 6455 §5.5: 控制帧禁止分片且载荷 <= 125
            if (!fin || payloadLen > 125) { return -2; }
        }
        int offset = 2;
        if (payloadLen == 126) {
            if (avail < 4) { return -1; }
            payloadLen = ((this.buf[s + 2] & 255) << 8) + (this.buf[s + 3] & 255);
            offset = 4;
        } else if (payloadLen == 127) {
            if (avail < 10) { return -1; }
            if ((this.buf[s + 2] & 255) != 0 || (this.buf[s + 3] & 255) != 0
                || (this.buf[s + 4] & 255) != 0 || (this.buf[s + 5] & 255) != 0
                || (this.buf[s + 6] & 128) != 0) {
                return -2;
            }
            payloadLen = ((this.buf[s + 6] & 255) << 24) +
                         ((this.buf[s + 7] & 255) << 16) +
                         ((this.buf[s + 8] & 255) << 8) + (this.buf[s + 9] & 255);
            if (payloadLen < 0) { return -2; }
            offset = 10;
        }
        int maskLen = 0;
        if (masked) { maskLen = 4; }
        int total = offset + maskLen + payloadLen;
        if (total < 0) { return -2; }
        if (total > this.maxLen) { return -3; }
        if (avail < total) { return -1; }
        return total;
    }

    /// <summary>解码游标处的帧（长度由 FrameSize 给出），并
    /// 越过该帧。</summary>
    WsFrame TakeFrame(int total) {
        WsFrame frame = WsFrame.DecodeAt(this.buf, this.start, total);
        this.Consume(total);
        return frame;
    }

    /// <summary>在缓冲的未读字节里扫描 HTTP 头部结束标记
    /// （CRLFCRLF）。借助 AVX2 向量化 IndexOf 快速跳过普通字节。
    /// 返回相对游标的偏移；未找到返回 -1。
    /// 握手与首帧常在同一段到达，而帧字节可能含 NUL，
    /// 因此扫描必须按字节下标进行，不能走字符串长度。</summary>
    int FindHeaderEnd() {
        int last = this.len - 4;
        int i = this.start;
        while (i <= last) {
            int pos = MemoryExtensions.IndexOf(this.buf, (byte)13, i, last + 1 - i);
            if (pos < 0 || pos > last) {
                return 0 - 1;
            }
            if ((this.buf[pos + 1] & 255) == 10
                && (this.buf[pos + 2] & 255) == 13
                && (this.buf[pos + 3] & 255) == 10) {
                return pos - this.start;
            }
            i = pos + 1;
        }
        return 0 - 1;
    }

    /// <summary>取出游标处 n 个字节，作为显式长度的字符串
    /// （不推进游标）。零额外堆分配拷贝。</summary>
    string Slice(int n) {
        if (n <= 0) { return ""; }
        return this.buf.ToStr(this.start, n);
    }

    /// <summary>把外部收到的字节（例如 TLS 流解密出的明文）
    /// 追加到累积缓冲区，绕过套接字。</summary>
    void Append(string data, int n) {
        if (n <= 0) { return; }
        this.Compact();
        this.Ensure(this.len + n);
        NativeMemory.PutString((nint)this.buf, this.len, data, n);
        this.len = this.len + n;
    }

    /// <summary>跳过游标处的帧以丢弃它。</summary>
    void Consume(int total) {
        this.start = this.start + total;
        if (this.start >= this.len) {
            this.start = 0;
            this.len = 0;
        }
    }
}

/// <summary>
/// 供连续应答帧使用的二进制安全输出缓冲区。
///
/// 每帧一次 send() 比编码一帧更贵：每 recv 携带 64 个管道帧时，
/// echo 路径把时间全花在系统调用上（满载内核约 13 万消息/秒，
/// 而 tcp 路径一次写入回显整个 recv，达 680 万/秒）。
/// 在更多完整帧已缓冲时累积响应，
/// 待读取方无帧可读时再一次性刷出。
/// </summary>
class WsWriter {
    byte[] buf;
    int len;
    int cap;

    /// 内部构造：64KiB 输出缓冲。
    WsWriter() {
        this.cap = 65536;
        this.buf = new byte[this.cap + 1];
        this.len = 0;
    }

    /// 扩展输出缓冲到至少 need 字节。
    void Ensure(int need) {
        if (need <= this.cap) { return; }
        int nc = this.cap * 2;
        while (nc < need) { nc = nc * 2; }
        byte[] nb = new byte[nc + 1];
        if (this.len > 0) {
            NativeMemory.Copy((nint)nb, (nint)this.buf, this.len);
        }
        this.buf = nb;
        this.cap = nc;
    }

    /// 追加编码后帧的 `n` 个字节。
    void Append(string data, int n) {
        if (n <= 0) { return; }
        this.Ensure(this.len + n);
        NativeMemory.PutString((nint)this.buf, this.len, data, n);
        this.len = this.len + n;
    }

    /// 缓冲中是否有待发字节。
    bool Pending() {
        return this.len > 0;
    }

    /// <summary>把缓冲内容作为一次 send 全部写出并重置。
    /// 返回写出字节数；-1 表示连接已死。Socket.SendAsync 内部
    /// 已循环补发，返回值小于请求长度只会是对端重置/中止等
    /// 致命错误——旧实现无视这点直接清零缓冲，把没发出去的
    /// 帧当已发，帧流从此错位且无任何上报。</summary>
    async int Flush(TcpClient client) {
        if (this.len == 0) { return 0; }
        int want = this.len;
        int n = await client.SendBytesAsync(this.buf, want);
        this.len = 0;
        if (n < want) { return 0 - 1; }
        return n;
    }
}

/// <summary>
/// RFC 6455 §5.4 分片消息重组器：fin=0 的数据帧开始一条消息，
/// opcode 0 的 continuation 帧追加负载，fin=1 交付。此前三条
/// 服务器/客户端路径都把 continuation 帧静默丢弃——大消息被
/// 发送方分片后内容直接丢失且无任何报错。
///
/// 负载按显式长度累积（帧字节可能含 NUL），累计超过 maxLen
/// 时返回 -2，由调用方按 1009 关闭连接。
/// </summary>
class WsAssembler {
    int opcode;      // -1 = 无分片进行中
    int dataLen;
    int maxLen;
    // 双倍增量的累积缓冲（显式长度/容量），交付时才转换为 string。
    byte[] dataBuf;
    int bufCap;

    /// 内部构造：状态复位，消息上限由调用方给定；经 WebSocketClient
    /// / 服务器各路径使用。
    WsAssembler(int maxLen) {
        this.opcode = 0 - 1;
        this.dataLen = 0;
        this.maxLen = maxLen;
        this.dataBuf = null;
        this.bufCap = 0;
    }

    /// <summary>喂入一个已解码的完整数据帧（控制帧不进这里）。
    /// 返回：0 = 分片进行中；1 = 消息完整，用 Message/MessageLen/
    /// MessageOpcode 取出；-1 = 协议违规（无起始帧的 continuation
    /// 或分片中途插入新数据帧）；-2 = 累计超过 maxLen。</summary>
    int Feed(WsFrame frame) {
        if (frame.opcode == WsOpcode.Continuation) {
            if (this.opcode < 0) { return 0 - 1; }
        } else if (this.opcode >= 0) {
            // 分片中途插入新数据帧：RFC 6455 §5.4 的协议错误。
            return 0 - 1;
        } else {
            this.opcode = frame.opcode;
        }
        int newLen = this.dataLen + frame.payloadLen;
        if (newLen > this.maxLen) { return 0 - 2; }
        if (frame.payloadLen > 0) {
            // 翻倍扩容只搬移旧字节；不在每帧转换整条消息。
            int cap = this.bufCap > 0 ? this.bufCap : 1024;
            if (newLen > cap) {
                while (cap < newLen) { cap = cap * 2; }
            }
            if (cap != this.bufCap) {
                byte[] nb = new byte[cap + 1];
                if (this.dataLen > 0) {
                    NativeMemory.Copy((nint)nb, (nint)this.dataBuf, this.dataLen);
                }
                this.dataBuf = nb;
                this.bufCap = cap;
            }
            NativeMemory.PutString((nint)this.dataBuf, this.dataLen, frame.payload, frame.payloadLen);
        }
        this.dataLen = newLen;
        if (frame.fin) { return 1; }
        return 0;
    }

    /// <summary>完成消息前校验文本消息的 UTF-8；二进制消息不做编码约束。</summary>
    bool ValidComplete() {
        if (this.opcode != WsOpcode.Text) { return true; }
        string m = this.dataLen > 0 ? this.dataBuf.ToStr(0, this.dataLen) : "";
        return WsFrame.ValidUtf8(m, this.dataLen);
    }

    /// <summary>取出重组完成的消息并复位状态。按显式长度一次转换，
    /// 内嵌 NUL 仍是消息的一部分；保留缓冲容量供下一条消息复用。</summary>
    string Complete() {
        string m = this.dataLen > 0 ? this.dataBuf.ToStr(0, this.dataLen) : "";
        this.opcode = 0 - 1;
        this.dataLen = 0;
        return m;
    }

    /// <summary>取出重组完成的消息原始字节并复位状态。</summary>
    byte[] CompleteBytes() {
        int dl = this.dataLen;
        byte[] b = new byte[dl + 1];
        if (dl > 0) {
            NativeMemory.Copy((nint)b, (nint)this.dataBuf, dl);
        }
        this.opcode = 0 - 1;
        this.dataLen = 0;
        return b;
    }

    /// <summary>重组完成消息的 opcode（Text 或 Binary）。</summary>
    int MessageOpcode() { return this.opcode; }

    /// <summary>重组负载的字节数（Complete 复位后为 0）。</summary>
    int MessageLen() { return this.dataLen; }
}

/// <summary>
/// WebSocket 客户端。
/// </summary>
class WebSocketClient {
    TcpClient conn;
    bool connected;
    string host;
    int port;
    string path;
    // 握手与帧共用一个带显式长度的累积缓冲（WsReader）。
    // 此前用字符串拼接攒帧：Zan 字符串按 NUL 结尾计长，
    // 二进制帧负载里的 NUL 会让帧长判断、Substring 切片
    // 全部错位；且无缓冲上限，对端可慢慢撑爆内存。
    WsReader reader;
    WsAssembler asm;
    bool sendBusy;
    List<AsyncGate> sendWaiters;
    int lastOpcode;
    int lastLen;
    byte[] lastBinary;

    /// 内部构造：未连接；经 ConnectAsync 使用。
    WebSocketClient() {
        this.connected = false;
        this.host = "";
        this.port = 0;
        this.path = "/";
        this.reader = null;
        this.asm = new WsAssembler(16777216);
        this.sendBusy = false;
        this.sendWaiters = new List<AsyncGate>();
        this.lastOpcode = 0;
        this.lastLen = 0;
        this.lastBinary = null;
    }

    /// 发起 ws://host:port/path 握手（随机 Sec-WebSocket-Key，校验
    /// Sec-WebSocket-Accept）。绝不返回 null：连接/握手失败时返回
    /// 一个 connected=false 的对象，用 IsConnected() 判断成败（失败
    /// 路径已顺手关闭底层连接）。
    static async WebSocketClient ConnectAsync(string host, int port, string path) {
        return await WebSocketClient.ConnectAsyncHeaders(host, port, path, null);
    }

    /// <summary>带自定义握手头的连接。`headers` 里每一项是一个完整的
    /// 头行（如 "Authorization: Bearer xxx"），原样追加在标准握手头
    /// 之后——授权在升级前生效的 MVC 路由（needsAuth 检查先于
    /// WsUpgrade）没有它就永远 401。行内出现 CR/LF/NUL/DEL 一律
    /// 拒绝并按握手失败返回（头注入会伪造额外头/截断握手块），
    /// 其余字节不校验——值里写什么由调用方负责。</summary>
    static async WebSocketClient ConnectAsyncHeaders(string host, int port,
            string path, List<string> headers) {
        WebSocketClient ws = new WebSocketClient();
        ws.host = host;
        ws.port = port;
        ws.path = path;

        if (!WsHandshake.SafeRequestPart(host, false)
            || !WsHandshake.SafeRequestPart(path, false)) { return ws; }
        ws.conn = await TcpClient.ConnectAsync(host, port);
        // 连接失败/超时按文档返回 null：解引用是空对象虚调用，进程
        // SIGSEGV。保持 connected=false 由 IsConnected() 检查。
        if (ws.conn == null) { return ws; }

        // RFC 6455 要求客户端握手的 key 是随机的；此前硬编码 RFC 样例
        // nonce，可预测且部分服务器/代理会拒绝重复值。
        byte[] keyBytes = RandomNumberGenerator.GetBytes(16);
        if (keyBytes == null) { ws.conn.Close(); return ws; }
        string key = Base64.Encode(keyBytes, 16);

        StringBuilder sb = new StringBuilder();
        sb.Append("GET ");
        sb.Append(path);
        sb.Append(" HTTP/1.1\r\n");
        sb.Append("Host: ");
        sb.Append(host);
        sb.Append("\r\n");
        sb.Append("Upgrade: websocket\r\n");
        sb.Append("Connection: Upgrade\r\n");
        sb.Append("Sec-WebSocket-Key: ");
        sb.Append(key);
        sb.Append("\r\n");
        sb.Append("Sec-WebSocket-Version: 13\r\n");
        if (headers != null) {
            int hn = headers.Count;
            for (int i = 0; i < hn; i = i + 1) {
                string line = headers[i];
                bool safe = true;
                int ll = line.Length;
                for (int j = 0; j < ll; j = j + 1) {
                    int c = line[j] & 255;
                    if (c == 13 || c == 10 || c == 0 || c == 127) {
                        safe = false;
                        break;
                    }
                }
                if (!safe) { ws.conn.Close(); return ws; }
                sb.Append(line);
                sb.Append("\r\n");
            }
        }
        sb.Append("\r\n");
        await ws.conn.SendAsync(sb.ToString());

        // 响应头可能被 TCP 分段；头之后的字节已是帧（可能含 NUL）。
        // 全部落进 reader 的显式长度缓冲，按字节扫描头部结束标记。
        // 握手接收受 30 秒空闲窗口约束：接受了连接却一个字节不发
        // 的服务端不能再永久钉住本协程（数据阶段的空闲等待仍不设限）。
        ws.reader = new WsReader(ws.conn.GetSocket());
        HttpDeadlineToken watch = HttpDeadline.Arm(ws.conn.GetSocket(), 30000);
        int headerEnd = -1;
        while (headerEnd < 0) {
            if (ws.reader.Buffered() > 65536) {
                HttpDeadline.Disarm(watch);
                ws.conn.Close();
                return ws;
            }
            int n = await ws.reader.FillMore();
            if (n == 0) {
                HttpDeadline.Disarm(watch);
                ws.conn.Close();
                return ws;
            }
            if (HttpDeadline.Expired(watch)) {
                HttpDeadline.Disarm(watch);
                ws.conn.Close();
                return ws;
            }
            headerEnd = ws.reader.FindHeaderEnd();
        }
        HttpDeadline.Disarm(watch);
        string head = ws.reader.Slice(headerEnd);
        string acceptSource = key + "258EAFA5-E914-47DA-95CA-C5AB0DC85B11";
        string expectedAccept = Base64.Encode(
            Sha1.Hash(acceptSource, acceptSource.Length), 20);
        if (!WsHandshake.ValidResponse(head, expectedAccept)) {
            ws.conn.Close();
            return ws;
        }
        ws.reader.Consume(headerEnd + 4);
        ws.connected = true;

        return ws;
    }

    async void AcquireSend() {
        while (this.sendBusy) {
            AsyncGate g = new AsyncGate();
            this.sendWaiters.Add(g);
            await g.Wait();
            g.Close();
        }
        this.sendBusy = true;
    }

    void ReleaseSend() {
        this.sendBusy = false;
        if (this.sendWaiters.Count > 0) {
            AsyncGate g = this.sendWaiters[0];
            this.sendWaiters.RemoveAt(0);
            g.Signal();
        }
    }

    /// <summary>客户端方向统一发送入口：掩码 + 正确的帧长 + 协程互斥串行发送，
    /// 彻底消除心跳与并发业务数据帧交叉交错损坏。返回 false 表示连接已不可用。</summary>
    async bool SendFrame(int opcode, string payload, int payloadLen) {
        if (!this.connected || this.conn == null || payload == null || payloadLen < 0
            || payloadLen > 16777216
            || (opcode >= 8 && (payloadLen > 125 || opcode > WsOpcode.Pong))
            || (opcode < 0 || opcode > WsOpcode.Pong)) { return false; }
        await this.AcquireSend();
        try {
            WsFrame frame = WsFrame.RawFrame(opcode, payload, payloadLen);
            byte[] encoded = frame.EncodeMasked();
            int total = WsFrame.HeaderLen(payloadLen) + 4 + payloadLen;
            int n = await this.conn.SendBytesAsync(encoded, total);
            if (n <= 0) { this.connected = false; return false; }
            return true;
        } finally {
            this.ReleaseSend();
        }
    }

    /// 发送一条 Text 消息（fire-and-forget，失败仅置 disconnected）。
    async void SendText(string text) {
        await this.SendFrame(WsOpcode.Text, text, text.Length);
    }

    /// 发送一条二进制消息（data 可含 NUL，len 为精确字节数）。
    async void SendBinary(string data, int len) {
        await this.SendFrame(WsOpcode.Binary, data, len);
    }

    /// 发送空 Ping 帧（对端的 Pong 由 RecvText 静默消费）。
    async void Ping() {
        await this.SendFrame(WsOpcode.Ping, "", 0);
    }

    /// <summary>上一次成功接收并交付的消息操作码（WsOpcode.Text 或 WsOpcode.Binary）。</summary>
    int LastOpcode() { return this.lastOpcode; }

    /// <summary>上一次成功接收并交付的消息精确字节数。</summary>
    int LastLength() { return this.lastLen; }

    /// <summary>挂起直到下一个文本/二进制消息。Ping 以 Pong 应答后
    /// 继续循环；分片消息重组到 fin 后整条交付；Close 或断开
    /// 返回 ""。</summary>
    async string RecvText() {
        return await this.RecvText(0);
    }

    /// <summary>带空闲窗口的 RecvText：时限内没有任何帧到达时返回 ""
    /// ——连接未断，IsConnected() 仍为 true，已收到的半截帧留在
    /// 缓冲区里下次接着读；这正是心跳调用方的判据（超时 → Ping()
    /// → 继续 RecvText(timeout)）。真正的断开（对端关闭帧/EOF/协议
    /// 错误）会 CloseNow，IsConnected() 变 false。timeoutMs 非正表示
    /// 不限时。空数据消息与空闲超时都返回 ""，无法区分——协议上
    /// 不发空消息（发心跳用 Ping）就没有歧义。</summary>
    async string RecvText(int timeoutMs) {
        while (this.connected) {
            int total = this.reader.FrameSize();
            while (total < 0) {
                if (total == -2 || total == -3) { this.CloseNow(); return ""; }
                int n = await this.reader.FillMore(timeoutMs);
                if (n == 0) { this.CloseNow(); return ""; }
                if (n < 0) { return ""; }   // 空闲窗口到，连接保持
                total = this.reader.FrameSize();
            }
            WsFrame frame = this.reader.TakeFrame(total);
            if (!WsFrame.ValidInbound(frame, false)) {
                // RFC 6455：客户端收到的服务端帧不得掩码，且 RSV、控制帧
                // 和关闭负载必须满足协议约束。
                this.CloseNow();
                return "";
            }
            if (frame.opcode == WsOpcode.Close) {
                await this.SendFrame(WsOpcode.Close, "", 0);
                this.CloseNow();
                return "";
            }
            if (frame.opcode == WsOpcode.Ping) {
                await this.SendFrame(WsOpcode.Pong, frame.payload, frame.payloadLen);
                continue;
            }
            if (frame.opcode == WsOpcode.Pong) { continue; }
            // 数据帧：分片消息在 fin 时整条交付——此前 continuation
            // 帧被静默丢弃。
            int feed = this.asm.Feed(frame);
            if (feed < 0) { this.CloseNow(); return ""; }
            if (feed == 0) { continue; }
            if (!this.asm.ValidComplete()) {
                this.CloseNow();
                return "";
            }
            this.lastOpcode = this.asm.MessageOpcode();
            this.lastLen = this.asm.MessageLen();
            this.lastBinary = null;
            return this.asm.Complete();
        }
        return "";
    }

    /// <summary>挂起直到下一个文本/二进制消息。返回未截断的原生 byte[]，
    /// 彻底消除二进制消息中 NUL 字符被字符串截断的隐患；Close 或断开返回 null。</summary>
    async byte[] RecvBinary() {
        return await this.RecvBinary(0);
    }

    /// <summary>带空闲窗口的原生二进制消息接收。</summary>
    async byte[] RecvBinary(int timeoutMs) {
        while (this.connected) {
            int total = this.reader.FrameSize();
            while (total < 0) {
                if (total == -2 || total == -3) { this.CloseNow(); return null; }
                int n = await this.reader.FillMore(timeoutMs);
                if (n == 0) { this.CloseNow(); return null; }
                if (n < 0) { return null; }
                total = this.reader.FrameSize();
            }
            WsFrame frame = this.reader.TakeFrame(total);
            if (!WsFrame.ValidInbound(frame, false)) {
                this.CloseNow();
                return null;
            }
            if (frame.opcode == WsOpcode.Close) {
                await this.SendFrame(WsOpcode.Close, "", 0);
                this.CloseNow();
                return null;
            }
            if (frame.opcode == WsOpcode.Ping) {
                await this.SendFrame(WsOpcode.Pong, frame.payload, frame.payloadLen);
                continue;
            }
            if (frame.opcode == WsOpcode.Pong) { continue; }
            int feed = this.asm.Feed(frame);
            if (feed < 0) { this.CloseNow(); return null; }
            if (feed == 0) { continue; }
            if (!this.asm.ValidComplete()) {
                this.CloseNow();
                return null;
            }
            this.lastOpcode = this.asm.MessageOpcode();
            this.lastLen = this.asm.MessageLen();
            byte[] bytes = this.asm.CompleteBytes();
            this.lastBinary = bytes;
            return bytes;
        }
        return null;
    }

    /// 立即断开（不发关闭帧）；RecvText 之后返回 ""。
    void CloseNow() {
        this.connected = false;
        if (this.conn != null) { this.conn.Close(); }
    }

    /// 协礼关闭：先发空关闭帧再断开。
    async void Close() {
        if (this.connected) {
            await this.SendFrame(WsOpcode.Close, "", 0);
        }
        this.CloseNow();
    }

    /// 握手是否成功且连接未断。
    bool IsConnected() {
        return this.connected;
    }
}
