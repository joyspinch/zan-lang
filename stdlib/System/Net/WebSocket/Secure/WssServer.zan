using System;
using System.Net.Sockets;
using System.Net.Http;
using System.Net.Tls;

namespace System.Net.WebSocket.Secure;

/// <summary>处理一条已解码的文本/二进制消息；返回值会发回
/// 客户端（纯 echo 服务器只需原样返回参数）。异步设计使
/// 处理器可以 await I/O 而不会阻塞连接的协程。</summary>
async delegate string WssMessageHandler(string message);

/// <summary>
/// 基于 TLS 的 WebSocket（wss://）服务器。帧格式与
/// Worker.HandleWebSocket 的帧循环相同，所有字节都流经
/// 每条连接各自的 <see cref="TlsStream"/>。
///
/// 用法：
///   WssServer server = WssServer.Create("0.0.0.0", 8443,
///                                       "cert.pem", "key.pem");
///   server.OnMessage(Handle);
///   await server.Start();
/// </summary>
class WssServer {
    TcpListener listener;
    TlsContext tls;
    string host;
    int port;
    bool running;
    int activeConnections;
    int maxConnections;
    int requestTimeoutMs;
    WssMessageHandler messageHandler;

    /// 内部构造：无 TLS 上下文；经 Create 使用。
    WssServer(string host, int port) {
        this.host = host;
        this.port = port;
        this.running = false;
        this.activeConnections = 0;
        this.maxConnections = 10000;
        this.requestTimeoutMs = 30000;
        this.messageHandler = null;
        this.tls = null;
    }

    /// <summary>从 PEM 证书链和 PEM 私钥创建
    /// wss 服务器。证书/私钥无法加载时返回 null。
    /// </summary>
    static WssServer Create(string host, int port, string certFile, string keyFile) {
        WssServer server = new WssServer(host, port);
        server.tls = TlsContext.CreateServer(certFile, keyFile);
        if (server.tls == null) {
            return null;
        }
        return server;
    }

    /// <summary>注册每消息处理器；其返回值会发回
    /// 客户端。不注册时回退到 <see cref="OnMessage(string)"/>
    /// （子类重写路径，与 Worker 的 onMessage 同款）。</summary>
    WssServer OnMessage(WssMessageHandler handler) {
        this.messageHandler = handler;
        return this;
    }

    /// <summary>设置最大并发连接数；超限连接立即关闭（TLS 连接各持
    /// SSL/BIO 与缓冲，必须设闸）。</summary>
    WssServer SetMaxConnections(int max) {
        this.maxConnections = max;
        return this;
    }

    /// <summary>设置 TLS 握手及 Upgrade 头的超时（毫秒）。默认 30 秒；
    /// 非正值禁用超时，建立连接后的帧循环不受此限制。</summary>
    WssServer SetTimeout(int ms) {
        this.requestTimeoutMs = ms;
        return this;
    }

    /// 开始接受连接并逐条派发处理协程；running 置位后阻塞循环，
    /// 直到 Stop() 被调用（从其他协程）。
    async void Start() {
        Socket.Initialize();
        this.listener = new TcpListener(this.host, this.port);
        this.listener.Start();
        this.running = true;

        while (this.running) {
            nint clientSock = await this.listener.AcceptAsync();
            if (clientSock >= 0) {
                if (this.activeConnections >= this.maxConnections) {
                    // 与 HttpServer/HttpsServer 同闸：超限直接挂断。
                    Socket.Close(clientSock);
                    continue;
                }
                this.activeConnections = this.activeConnections + 1;
                Task.Spawn(HandleConnection(clientSock));
            }
        }
    }

    /// 请求停止接受连接；在途连接处理完当前消息后自然收尾。
    void Stop() {
        this.running = false;
        if (this.listener != null) {
            this.listener.Stop();
        }
    }

    /// 单条连接的生命周期：TLS 握手 → WebSocket Upgrade（缺 Upgrade
    /// 或 Sec-WebSocket-Key 时回 400）→ 帧循环（Ping→Pong、Close 应答
    /// 并断开、协议违规回 1002/1009 关闭帧）；每条消息交
    /// OnMessageInternal，返回值按原 opcode 发回。任何退出路径都
    /// 关闭流与 socket 并归还连接计数——清理在 finally 中执行：
    /// 处理器抛出的异常会跳过顺序清理，泄漏 fd/SSL 与计数
    /// （计数漂移会让服务器在 maxConnections 处永久拒绝新连接）。
    async void HandleConnection(nint clientSock) {
        try {
            await this.HandleConnectionInner(clientSock);
        } finally {
            this.activeConnections = this.activeConnections - 1;
        }
    }

    /// HandleConnection 的服务体；计数归还见 HandleConnection 的 finally。
    async void HandleConnectionInner(nint clientSock) {
        Socket.SetNonBlocking(clientSock);
        // TLS 协商也必须受配置的时限约束，不能只给 Upgrade 头设限。
        TlsStream stream = await TlsStream.AcceptAsync(this.tls, clientSock,
            this.requestTimeoutMs);
        if (stream == null) {
            Socket.Close(clientSock);
            return;
        }

        HttpDeadlineToken watch = HttpDeadline.Arm(clientSock, this.requestTimeoutMs);
        try {
            // 握手与后续帧共用一个 WsReader（TLS 字节源）：握手可能被
            // TLS 记录边界拆开，而与握手同批到达的首帧字节可能含 NUL
            // ——一律按显式字节数累积与扫描。
            WsReader reader = WsReader.WrapTls(stream);
            int headerEnd = -1;
            bool alive = true;
            while (alive) {
                headerEnd = reader.FindHeaderEnd();
                if (HttpDeadline.Expired(watch)) { alive = false; break; }
                if (headerEnd >= 0) { break; }
                if (reader.Buffered() > 65536) {
                    alive = false;
                    break;
                }
                int n = await reader.FillMore();
                if (n <= 0 || HttpDeadline.Expired(watch)) { alive = false; }
            }
            if (!alive) { return; }

            string head = reader.Slice(headerEnd + 4);
            if (HttpDeadline.Expired(watch)) { return; }
            HttpRequest req = HttpRequest.Parse(head);

            if (!WsHandshake.Valid(req)) {
                string badData = "HTTP/1.1 400 Bad Request\r\nContent-Length: 0\r\nConnection: close\r\n\r\n";
                int _e = await stream.SendAsync(badData, badData.Length);
                return;
            }
            string wsKey = req.GetHeader("Sec-WebSocket-Key");
            string acceptKey = Encoding.WebSocketAccept(wsKey);

            StringBuilder sb = new StringBuilder();
            sb.Append("HTTP/1.1 101 Switching Protocols\r\n");
            sb.Append("Upgrade: websocket\r\n");
            sb.Append("Connection: Upgrade\r\n");
            sb.Append("Sec-WebSocket-Accept: ");
            sb.Append(acceptKey);
            sb.Append("\r\n\r\n");
            string hs = sb.ToString();
            if (HttpDeadline.Expired(watch)) { return; }
            int _h = await stream.SendAsync(hs, hs.Length);
            bool timedOut = HttpDeadline.Expired(watch);
            HttpDeadline.Disarm(watch);
            watch = null;
            if (_h < 0 || timedOut) { return; }

            // 与升级请求同批到达的首批帧已留在 reader 里，跳过握手
            // 字节继续使用即可。
            reader.Consume(headerEnd + 4);
            WsAssembler asm = new WsAssembler(reader.MaxLen());
            bool connected = true;
            while (connected) {
                int total = reader.FrameSize();
                while (total < 0) {
                    if (total == -2 || total == -3) {
                        // -2 = 帧长编码违规（1002）；-3 = 消息过大（1009）。
                        byte[] enc = WsFrame.CloseFrameWithCode(total == -3 ? 1009 : 1002).Encode();
                        int _v = await stream.SendAsync(enc, 4);
                        connected = false;
                        break;
                    }
                    int n = await reader.FillMore();
                    if (n <= 0) {
                        connected = false;
                        break;
                    }
                    total = reader.FrameSize();
                }
                if (!connected) { break; }

                WsFrame frame = reader.TakeFrame(total);

                // RFC 6455 入站帧门禁（与 Worker 同一契约）：保留
                // opcode、控制帧载荷 >125、未掩码客户端帧 → 1002 断开。
                bool protoErr = frame.rsv != 0
                    || frame.opcode >= 3 && frame.opcode <= 7
                    || frame.opcode >= 11 && frame.opcode <= 15
                    || frame.opcode >= 8 && (!frame.fin || frame.payloadLen > 125)
                    || !frame.masked;
                if (protoErr) {
                    byte[] enc = WsFrame.CloseFrameWithCode(1002).Encode();
                    int _v = await stream.SendAsync(enc, 4);
                    connected = false;
                    break;
                }
                if (frame.opcode == WsOpcode.Ping) {
                    // §5.5.3：Pong 原样带回 Ping 的应用数据。
                    WsFrame pong = WsFrame.RawFrame(WsOpcode.Pong, frame.payload, frame.payloadLen);
                    byte[] encoded = pong.Encode();
                    int _p = await stream.SendAsync(encoded, WsFrame.HeaderLen(frame.payloadLen) + frame.payloadLen);
                    continue;
                }
                if (frame.opcode == WsOpcode.Pong) { continue; }
                if (frame.opcode == WsOpcode.Close) {
                    WsFrame closeResp = WsFrame.CloseFrame();
                    byte[] encoded = closeResp.Encode();
                    int _c = await stream.SendAsync(encoded, 2);
                    connected = false;
                    break;
                }
                // 数据帧：分片消息在 fin 时整条交付——此前 continuation
                // 帧被静默丢弃。
                int feed = asm.Feed(frame);
                if (feed < 0) {
                    byte[] enc = WsFrame.CloseFrameWithCode(feed == -2 ? 1009 : 1002).Encode();
                    int _v = await stream.SendAsync(enc, 4);
                    connected = false;
                    break;
                }
                if (feed == 0) { continue; }

                int msgOpcode = asm.MessageOpcode();
                string message = asm.Complete();
                string response = await OnMessageInternal(message);
                int respLen = response.Length;
                WsFrame respFrame = WsFrame.BinaryFrame(response, respLen);
                respFrame.opcode = msgOpcode;
                byte[] respEnc = respFrame.Encode();
                int sent = await stream.SendAsync(respEnc, WsFrame.HeaderLen(respLen) + respLen);
                if (sent < 0) { connected = false; }
            }

            stream.Close();
            Socket.Close(clientSock);
        } finally {
            HttpDeadline.Disarm(watch);
            // 异常路径兜底：上面的正常关闭是幂等关闭（Close 幂等），
            // 异常时由这里保证 fd/SSL 一定释放。
            stream.Close();
            Socket.Close(clientSock);
        }
    }

    /// 每消息分发：注册了委托走委托，否则走可重写的 OnMessage。
    async string OnMessageInternal(string message) {
        WssMessageHandler handler = this.messageHandler;
        if (handler != null) {
            return await handler(message);
        }
        return await OnMessage(message);
    }

    /// <summary>子类重写路径：未注册委托时每条消息走这里，
    /// 返回值发回客户端（默认原样 echo）。</summary>
    async string OnMessage(string message) {
        return message;
    }
}
