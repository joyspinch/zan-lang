using System;
using System.Text;
using System.Diagnostics;

namespace System.Net;

/// 横幅服务表中的一行：运行什么、监听哪里、
/// 几个进程在服务、是否已启动。
class BannerService {
    string name;
    string listen;
    string procs;
    string status;

    BannerService(string name, string listen, string procs, string status) {
        this.name = name;
        this.listen = listen;
        this.procs = procs;
        this.status = status;
    }
}

/// <summary>
/// 常驻服务器打印的启动画面：带标题的分隔线、
/// runtime/version/pid/mode 行、刚启动的服务表
/// 和它响应的命令——workerman 风格的报告，由
/// 标准库持有，让每个服务器（Worker、WebApp、用户自己的守护进程）
/// 显示同样的内容：
///
///     new ServerBanner("ZAN WEB", "SERVICES")
///         .Mode("single process")
///         .Info("routes", "12 registered")
///         .Service("http", "http://0.0.0.0:8080", "1", "[OK]")
///         .Commands("app.exe [start [-d] | stop | restart | reload | status]")
///         .Print();
/// </summary>
class ServerBanner {
    string title;
    string section;
    string mode;
    string commands;
    string footer;
    List<string> infos;
    List<BannerService> services;

    static int Width() { return 76; }

    /// <summary>带标题的服务器启动报告横幅。</summary>
    ServerBanner(string title, string section) {
        this.title = title;
        this.section = section;
        this.mode = "";
        this.commands = "";
        this.footer = "";
        this.infos = new List<string>();
        this.services = new List<BannerService>();
    }

    /// 进程的布局方式，如 "single process" 或 "master + 4
    /// workers"。
    ServerBanner Mode(string m) { this.mode = m; return this; }

    ServerBanner Service(string name, string listen, string procs,
                         string status) {
        this.services.Add(new BannerService(name, listen, procs, status));
        return this;
    }

    /// 一项配置设置而非服务（路由数、会话存储、
    /// 上传目录、限流）：随运行时头部打印，位于
    /// 监听表上方——SERVICES 仍只列实际监听的项。
    ServerBanner Info(string name, string detail) {
        this.infos.Add(name + ": " + detail);
        return this;
    }

    /// 服务器响应的命令行，打印在表格下方。
    ServerBanner Commands(string usage) { this.commands = usage; return this; }

    /// 结尾行，如 "Press Ctrl+C to stop."。
    ServerBanner Footer(string text) { this.footer = text; return this; }

    /// 右对齐填充到列宽，使表格对齐。
    static string Pad(string s, int width) {
        StringBuilder sb = new StringBuilder();
        sb.Append(s);
        int i = s.Length;
        while (i < width) {
            sb.Append(" ");
            i = i + 1;
        }
        return sb.ToString();
    }

    /// 整宽分隔线，给定 `title` 时以它为中心。
    static string Rule(string title) {
        StringBuilder sb = new StringBuilder();
        int total = ServerBanner.Width();
        if (title.Length == 0) {
            for (int k = 0; k < total; k = k + 1) { sb.Append("-"); }
            return sb.ToString();
        }
        int side = (total - title.Length - 2) / 2;
        int i = 0;
        for (; i < side; i = i + 1) { sb.Append("-"); }
        sb.Append(" ");
        sb.Append(title);
        sb.Append(" ");
        i = sb.Length;
        while (i < total) { sb.Append("-"); i = i + 1; }
        return sb.ToString();
    }

    void Print() {
        Console.WriteLine(ServerBanner.Rule(this.title));
        Console.WriteLine(ServerBanner.Pad("Zan version: " + ZanVersion.Text(), 30)
            + ServerBanner.Pad("pid: " + Convert.ToString(ProcessHost.Pid()), 22)
            + "mode: " + this.mode);
        int n = 0;
        while (n < this.infos.Count) {
            string line = this.infos[n];
            if (n + 1 < this.infos.Count) {
                line = ServerBanner.Pad(line, 38) + this.infos[n + 1];
            }
            Console.WriteLine(line);
            n = n + 2;
        }
        Console.WriteLine(ServerBanner.Rule(this.section));
        Console.WriteLine(ServerBanner.Pad("service", 22)
            + ServerBanner.Pad("listen", 32)
            + ServerBanner.Pad("processes", 12) + "status");
        for (int i = 0; i < this.services.Count; i = i + 1) {
            BannerService s = this.services[i];
            Console.WriteLine(ServerBanner.Pad(s.name, 22)
                + ServerBanner.Pad(s.listen, 32)
                + ServerBanner.Pad(s.procs, 12) + s.status);
        }
        Console.WriteLine(ServerBanner.Rule(""));
        if (this.commands != "") {
            Console.WriteLine("commands: " + this.commands);
        }
        if (this.footer != "") {
            Console.WriteLine(this.footer);
        }
    }
}
