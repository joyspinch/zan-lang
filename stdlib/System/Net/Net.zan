using System;
using System.Net.Sockets;

namespace System.Net;

/// <summary>
/// 保留在 System.Net 下的旧版纯套接字 HTTP 客户端。受维护的
/// 客户端位于 System.Net.Http.HttpClient；本类更名为
/// SocketHttpClient，以避免 System.Net 与 System.Net.Http
/// 模块一起编译时（例如通过
/// 同时引入两者的 Worker 模块）出现重复类型声明。
/// </summary>
class SocketHttpClient {
    /// <summary>执行简单的 GET 请求并返回响应体。</summary>
    static string Get(string host, int port, string path) {
        Socket.Initialize();
        nint sock = Socket.CreateTcp();
        Socket.Connect(sock, host, port);

        StringBuilder sb = new StringBuilder();
        sb.Append("GET ");
        sb.Append(path);
        sb.Append(" HTTP/1.1\r\n");
        sb.Append("Host: ");
        sb.Append(host);
        sb.Append("\r\n");
        sb.Append("Connection: close\r\n");
        sb.Append("\r\n");

        Socket.SendString(sock, sb.ToString());

        StringBuilder response = new StringBuilder();
        bool reading = true;
        while (reading) {
            string buf = Socket.Receive(sock, 4096);
            if (buf.Length == 0) {
                reading = false;
            } else {
                response.Append(buf);
            }
        }

        Socket.Close(sock);

        // 跳过 HTTP 响应头，返回响应体
        string raw = response.ToString();
        int bodyStart = 0;
        int len = raw.Length;
        for (int i = 0; i < len - 3; i = i + 1) {
            if (raw.Substring(i, 4) == "\r\n\r\n") {
                bodyStart = i + 4;
                break;
            }
        }
        if (bodyStart > 0) {
            return raw.Substring(bodyStart);
        }
        return raw;
    }

    /// <summary>执行简单的 POST 请求。</summary>
    static string Post(string host, int port, string path, string body) {
        Socket.Initialize();
        nint sock = Socket.CreateTcp();
        Socket.Connect(sock, host, port);

        StringBuilder sb = new StringBuilder();
        sb.Append("POST ");
        sb.Append(path);
        sb.Append(" HTTP/1.1\r\n");
        sb.Append("Host: ");
        sb.Append(host);
        sb.Append("\r\n");
        sb.Append("Content-Length: ");
        sb.Append(Convert.ToString(body.Length));
        sb.Append("\r\n");
        sb.Append("Content-Type: application/x-www-form-urlencoded\r\n");
        sb.Append("Connection: close\r\n");
        sb.Append("\r\n");
        sb.Append(body);

        Socket.SendString(sock, sb.ToString());

        StringBuilder response = new StringBuilder();
        bool reading = true;
        while (reading) {
            string buf = Socket.Receive(sock, 4096);
            if (buf.Length == 0) {
                reading = false;
            } else {
                response.Append(buf);
            }
        }

        Socket.Close(sock);

        string raw = response.ToString();
        int bodyStart = 0;
        int len = raw.Length;
        for (int idx = 0; idx < len - 3; idx = idx + 1) {
            if (raw.Substring(idx, 4) == "\r\n\r\n") {
                bodyStart = idx + 4;
                break;
            }
        }
        if (bodyStart > 0) {
            return raw.Substring(bodyStart);
        }
        return raw;
    }
}

/// <summary>
/// 跨平台 TCP 套接字封装。
/// 取代仅支持 Windows 的 Winsock2 TcpSocket。
/// </summary>
class TcpSocket {
    /// <summary>初始化套接字子系统。</summary>
    static void Initialize() {
        Socket.Initialize();
    }

    /// <summary>创建 TCP 套接字，返回套接字句柄。</summary>
    static nint Create() {
        return Socket.CreateTcp();
    }

    /// <summary>在已连接的套接字上发送数据。</summary>
    static int Send(nint sock, string data) {
        return Socket.SendString(sock, data);
    }

    /// <summary>从套接字接收数据到缓冲区。</summary>
    static string Receive(nint sock, int bufSize) {
        return Socket.Receive(sock, bufSize);
    }

    /// <summary>关闭套接字。</summary>
    static void Close(nint sock) {
        Socket.Close(sock);
    }

    /// <summary>清理套接字子系统。</summary>
    static void Cleanup() {
        Socket.Cleanup();
    }
}

/// <summary>
/// DNS 解析工具。
/// </summary>
class Dns {
    /// <summary>将主机名解析为 IP 地址。</summary>
    static string Resolve(string hostname) {
        return Socket.Resolve(hostname);
    }
}

/// <summary>
/// IP 地址工具。
/// </summary>
class IPAddress {
    static string Any       = "0.0.0.0";
    static string Loopback  = "127.0.0.1";
    static string Broadcast = "255.255.255.255";

    /// <summary>检查字符串是否为 IPv4 地址格式。</summary>
    static bool IsIPv4(string str) {
        int dotCount = 0;
        int len = str.Length;
        for (int i = 0; i < len; i = i + 1) {
            string ch = str.Substring(i, 1);
            if (ch == ".") {
                dotCount = dotCount + 1;
            } else if (ch < "0" || ch > "9") {
                return false;
            }
        }
        return dotCount == 3;
    }
}
