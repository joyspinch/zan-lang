using System;
using System.Net.Sockets;

namespace System.Net;

/// <summary>
/// IP 地址工具。
/// </summary>
class IPAddress {
    static const string Any       = "0.0.0.0";
    static const string Loopback  = "127.0.0.1";
    static const string Broadcast = "255.255.255.255";

    /// <summary>检查字符串是否为 IPv4 地址格式。</summary>
    static bool IsIPv4(string str) {
        int dotCount = 0;
        int len = str.Length;
        for (int i = 0; i < len; i = i + 1) {
            string ch = str.Substring(i, 1);
            if (ch == ".") {
                dotCount = dotCount + 1;
            } else if (ch < "0" || ch > "9") {
                return false;
            }
        }
        return dotCount == 3;
    }
}
