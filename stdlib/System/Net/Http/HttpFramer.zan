using System;
using System.IO;
using System.Net.Sockets;

namespace System.Net.Http;

/// TLS 分片注入的字节源：从 TLS 记录层精确收 (buf, cap) 内的字节，
/// 返回收到的字节数（0 = 对端关闭），形态跟随 Socket.RecvIntoAsync，
/// 使分片可以逐参转发。核心文件不拼 TlsStream 类型名——拼了会把
/// TLS 全家（连带 Base64/Sha256 与 ssl/crypto 驱动拷贝）拉进一切
/// HTTP 程序（A332 肥边④）。
async delegate int FramerRecvFn(string buf, int cap);

/// <summary>
/// 一条 HTTP/1.1 连接上的请求拆包器：把字节流切成请求，
/// 全程按显式字节数处理。
///
/// stdlib 里的每个 HTTP 连接循环（HttpServer/Worker 的 "http" 协议、
/// System.Web 的 WebApp、HttpsServer 的 TLS 连接）都用它拆包，因此
/// 定界的修复对所有入口同时生效，不会再出现多套实现各自漂移。
///
/// 为什么不能用字符串拼接来攒请求：Zan 字符串以 NUL 结尾，
/// <c>s.Length</c> 是 strlen，<c>a + b</c> 也按 strlen 定长。请求体
/// （文件上传、protobuf、gzip 内容）里的 NUL 会让长度提前截断，于是
/// 声明的 Content-Length 永远读不满，请求超时或被判 400。这里把未
/// 消费的字节放在带显式长度的 <see cref="ByteBuffer"/> 里，接收用
/// <see cref="Socket.RecvIntoAsync"/> 的精确返回值，切片用带长度的
/// <see cref="ByteBuffer.Str"/>，全程不依赖 NUL。
///
/// 用法（一次请求）：
///   HttpFramer f = HttpFramer.Create(sock);
///   int he = await f.ReadHead(maxHeaderBytes);        // 头部块到齐
///   HttpRequest req = HttpRequest.Parse(f.Head(he), he);
///   int st = await f.ReadBody(req, maxBodyBytes);     // 正文到齐
///   f.Consume(f.RequestBytes());                     // 只丢弃本请求
/// 剩余字节留在拆包器里，就是下一条流水线请求的开头。
/// </summary>
class HttpFramer {
    nint sock;
    // TLS 字节源槽（明文为空，直接从 sock 读）。核心不拼 TlsStream
    // 类型名——分片经 FramerRecvFn 注入实例方法组（HttpFramerTls.Create）。
    FramerRecvFn recv;
    // 接收暂存区：从连接池借来的 64KB 复用缓冲区（每条连接构建一块
    // 的代价在短连接负载下比处理请求本身还贵）。
    string buf;
    int bufCap;
    // 已收到但尚未消费的字节，带显式长度。
    ByteBuffer pend;
    // pend 中已扫描过、确认不含头部结束空行的前缀长度。跨包到达的
    // 头部不必每次接收后从头再扫一遍（慢客户端一个字节一个字节地
    // 发时，重扫是 O(n²)）。
    int scanned;
    // 对端关闭且缓冲区已空。
    bool closed;
    // 最近一次 ReadBody 定下的本请求线路字节数（头部 + 正文，
    // 分块编码则是整个分块序列）。
    int wireBytes;

    /// <summary>私有构造：用 <see cref="Create"/> 创建；TLS 变体见 HttpFramerTls.Create。</summary>
    HttpFramer() {
        this.sock = -1;
        this.recv = null;
        this.buf = null;
        this.bufCap = 65536;
        this.pend = null;
        this.scanned = 0;
        this.closed = false;
        this.wireBytes = 0;
    }

    /// <summary>为明文套接字创建拆包器（64KB 复用接收缓冲）。</summary>
    static HttpFramer Create(nint sock) {
        HttpFramer f = new HttpFramer();
        f.sock = sock;
        f.buf = TcpClient.RentRecvBuffer(65536);
        f.bufCap = 65536;
        f.pend = ByteBuffer.Alloc(4096);
        return f;
    }

    /// <summary>把已经从套接字读出的字节放回流头部。同一端口同时
    /// 服务 HTTP 与 WebSocket 时，要先看过请求头才能判断协议，
    /// 已消费的字节由此交还拆包器。</summary>
    void Prime(string bytes, int len) {
        if (len > 0) { this.pend.WriteRaw(bytes, len); }
    }

    /// <summary>尚未消费的字节数。</summary>
    int Pending() { return this.pend.Length(); }

    /// <summary>对端已关闭且缓冲区里没有剩余字节。</summary>
    bool Closed() { return this.closed; }

    /// <summary>接收一次，把收到的字节追加到待处理缓冲区。
    /// 返回收到的字节数，0 表示对端关闭。</summary>
    async int Fill() {
        int n = 0;
        if (this.recv != null) {
            n = await this.recv(this.buf, this.bufCap);
        } else {
            n = await Socket.RecvIntoAsync(this.sock, this.buf, this.bufCap);
        }
        if (n <= 0) {
            this.closed = true;
            return 0;
        }
        this.pend.WriteRaw(this.buf, n);
        return n;
    }

    /// <summary>分块元数据/正文的受限接收；不能用 Fill 的固定 64KB
    /// 读取无终止符的长度行，也不能让小块的线缆开销无限驻留。</summary>
    async int FillTo(int maxPending) {
        int room = maxPending - this.pend.Length();
        if (room <= 0) { return -1; }
        int want = this.bufCap;
        if (want > room) { want = room; }
        int n = this.recv != null
            ? await this.recv(this.buf, want)
            : await Socket.RecvIntoAsync(this.sock, this.buf, want);
        if (n <= 0) { this.closed = true; return 0; }
        if (n > room) { return -1; }
        this.pend.WriteRaw(this.buf, n);
        return n;
    }

    /// <summary>头部结束空行之后的下标（即正文首字节的位置），
    /// 空行尚未到达时返回 -1。同时识别 CRLF 与单独 LF 分隔。</summary>
    int HeaderEnd() {
        int len = this.pend.Length();
        int i = this.scanned;
        while (i < len) {
            // 空行只能紧跟在一个 LF 之后，所以按 LF 跳着找，而不是
            // 逐字节问一遍整块缓冲区。
            i = this.pend.IndexOfByte(i, 10);
            if (i < 0) { break; }
            if (i + 1 < len && this.pend.ByteAt(i + 1) == 10) { return i + 2; }
            if (i + 2 < len && this.pend.ByteAt(i + 1) == 13
                && this.pend.ByteAt(i + 2) == 10) {
                return i + 3;
            }
            i = i + 1;
        }
        // 结束空行可能被切在包边界上（"\r\n" | "\r\n"），因此回退
        // 两个字节重扫，其余前缀不再看。
        this.scanned = len - 2;
        if (this.scanned < 0) { this.scanned = 0; }
        return -1;
    }

    /// <summary>头部读取专用的受限接收（不能调用无上限的 Fill：一次
    /// 64KB 的 recv 可能把 maxHeaderBytes 直接冲过头，随后才检查已经
    /// 太迟）。只接收仍在 cap 内的字节，并在追加后再次核验，保证恶意
    /// 头不会先进入待处理缓冲。返回收到的字节数；超限返回 -431，
    /// 对端关闭返回 0。</summary>
    async int FillHead(int maxHeaderBytes) {
        int room = maxHeaderBytes - this.pend.Length();
        if (room <= 0) { return -431; }
        int want = this.bufCap;
        if (want > room) { want = room; }
        int n = 0;
        if (this.recv != null) {
            n = await this.recv(this.buf, want);
        } else {
            n = await Socket.RecvIntoAsync(this.sock, this.buf, want);
        }
        if (n <= 0) {
            this.closed = true;
            return 0;
        }
        if (n > room) { return -431; }
        this.pend.WriteRaw(this.buf, n);
        if (this.pend.Length() > maxHeaderBytes) { return -431; }
        return n;
    }

    /// <summary>一直接收，直到完整的头部块到齐。
    /// 返回头部块长度（含结束空行）；对端在请求中途关闭返回 0；
    /// 头部块超过 <paramref name="maxHeaderBytes"/> 返回 -431——
    /// 违规字节在被无限缓冲之前就被拒绝（slowloris 的一种形态是
    /// 只发头部却永不发空行）。</summary>
    async int ReadHead(int maxHeaderBytes) {
        if (maxHeaderBytes <= 0) { return -431; }
        int he = this.HeaderEnd();
        while (he < 0) {
            int n = await this.FillHead(maxHeaderBytes);
            if (n == -431) { return -431; }
            if (n == 0) { return 0; }
            he = this.HeaderEnd();
            if (this.pend.Length() > maxHeaderBytes) { return -431; }
        }
        if (he > maxHeaderBytes) { return -431; }
        return he;
    }

    /// <summary>头部块（前 <paramref name="headerLen"/> 个字节）的字符串
    /// 切片，交给 <see cref="HttpRequest.Parse"/>。</summary>
    string Head(int headerLen) {
        return this.pend.Str(0, headerLen);
    }

    /// <summary>待处理字节中 [off, off+count) 的切片（按长度复制，
    /// 内嵌 NUL 得以保留）。流式上传用它取出"与头部同包到达"的
    /// 那段正文，其余部分直接从套接字续读。</summary>
    string Slice(int off, int count) {
        return this.pend.Str(off, count);
    }

    /// <summary>一直接收，直到 <paramref name="req"/> 的正文到齐，并按
    /// 精确字节数写入 <c>req.body</c> / <c>req.bodyLength</c>。
    ///
    /// 返回 0 表示成功；返回 HTTP 状态码表示应当据此拒绝
    /// （413 超限、400 分块编码畸形）；返回 -1 表示对端在正文
    /// 中途关闭。分块编码在这里解码，解码后的正文与固定长度
    /// 正文一样，对处理器不可区分。</summary>
    async int ReadBody(HttpRequest req, int maxBodyBytes) {
        int he = req.bodyStart;
        if (req.chunked) {
            int st = await this.ReadChunkedBody(req, null, he, maxBodyBytes);
            return st;
        }
        int total = req.contentLength;
        if (total <= 0) {
            req.body = "";
            req.bodyLength = 0;
            this.wireBytes = he;
            return 0;
        }
        // 超限的正文在缓冲之前就拒绝：依据声明的长度判定，而不是
        // 先收完再看。
        if (total > maxBodyBytes) { return 413; }
        while (this.pend.Length() - he < total) {
            int n = await this.Fill();
            if (n == 0) { return -1; }
        }
        req.body = this.pend.Str(he, total);
        req.bodyLength = total;
        this.wireBytes = he + total;
        return 0;
    }

    /// <summary>响应体定界使用响应解析器，不能把状态行交给要求
    /// request-target 与 Host 的 HttpRequest.Parse。ReadChunked 只借用
    /// req 作为解码结果容器，不重新解析响应头。</summary>
    async int ReadResponseBody(HttpResponse response, int headerLen,
            int maxBodyBytes) {
        if (response.framingChunked) {
            return await this.ReadChunkedBody(null, response, headerLen,
                maxBodyBytes);
        }
        int total = response.framingLength;
        if (total > maxBodyBytes) { return 413; }
        while (this.pend.Length() - headerLen < total) {
            int n = await this.FillTo(headerLen + total);
            if (n <= 0) { return -1; }
        }
        response.body = this.pend.Str(headerLen, total);
        response.bodyBytesLen = total;
        this.wireBytes = headerLen + total;
        return 0;
    }

    /// <summary>流式将请求体分块直接落盘，避免超大正文（如 GB 级上传）引发 OOM。
    /// 内存仅占用当前分块缓冲区（<=64KB），落盘完成后保留后续流水线请求字节。</summary>
    async int SaveBodyToFile(HttpRequest req, string filePath, int maxBytes) {
        int he = req.bodyStart;
        int total = req.contentLength;
        if (total <= 0) { this.wireBytes = he; return 0; }
        if (total > maxBytes) { return 413; }

        FileStream fs = FileStream.OpenWrite(filePath);
        int written = 0;

        // 1. 若 pend 中已有已接收的正文前缀，直接从底层裸缓冲写盘（零拷贝、二进制安全）
        int availInPend = this.pend.Length() - he;
        if (availInPend > 0) {
            int toWrite = availInPend;
            if (toWrite > total) { toWrite = total; }
            int w = fs.WriteFromAll(this.pend.Raw() + (nint)he, toWrite);
            if (w < toWrite) {
                fs.Close();
                return -1;
            }
            written = written + toWrite;
        }

        // 丢弃已经写盘的前缀和头部，使 pend 内存即刻回落
        this.pend.Discard(he + written);
        this.scanned = 0;

        // 2. 循环分块拉取剩余数据，直接写盘，每块写完即时 Discard，内存恒定在 64KB 以内
        while (written < total) {
            int n = await this.Fill();
            if (n == 0) {
                fs.Close();
                this.closed = true;
                return -1; // 客户端异常中断
            }
            int available = this.pend.Length();
            int toWrite = available;
            if (written + toWrite > total) {
                toWrite = total - written;
            }
            int w = fs.WriteFromAll(this.pend.Raw(), toWrite);
            if (w < toWrite) {
                fs.Close();
                return -1;
            }
            written = written + toWrite;
            this.pend.Discard(toWrite);
            this.scanned = 0;
        }

        fs.Flush();
        fs.Close();
        this.wireBytes = 0;
        return 0;
    }

    /// <summary>本请求在线路上占用的字节数（头部 + 正文，分块编码则
    /// 是整个分块序列）。<see cref="Consume"/> 用它精确丢弃，
    /// 缓冲区里剩下的字节属于下一条流水线请求。</summary>
    int RequestBytes() { return this.wireBytes; }

    /// <summary>丢弃已处理请求的字节，保留其后的流水线字节。</summary>
    void Consume(int count) {
        this.pend.Discard(count);
        this.scanned = 0;
    }

    /// <summary>解码 Transfer-Encoding: chunked 的请求体。
    ///
    /// 逐块读取 "长度(十六进制)[;扩展]CRLF 数据 CRLF"，直到长度为 0 的
    /// 结束块，其后的尾部头部（trailer）一并跳过。解码结果按字节
    /// 累积，因此块里的 NUL 不会截断正文；累计长度超过
    /// <paramref name="maxBodyBytes"/> 立即拒绝，避免用无限多个小块
    /// 撑爆内存。畸形的长度行按 400 拒绝——不能猜，猜错就等于把
    /// 剩余字节当成下一条请求（走私）。等待 LF 的字节同样有上限
    /// （8KB）：一条不终止的"长度行"不计入正文限额，若无上限，
    /// 单条连接就能把待处理缓冲喂到任意大小。</summary>
    async int ReadChunkedBody(HttpRequest req, HttpResponse response, int he,
            int maxBodyBytes) {
        ByteBuffer acc = ByteBuffer.Alloc(4096);
        int pos = he;              // 线路上的读游标
        int decoded = 0;
        while (true) {
            // 长度行：至少要有一个 LF 才能确定它已完整到达。行内字节
            // （含扩展）超过 8KB 视为畸形——合法长度行远短于此。
            int scan = pos;
            int lf = this.IndexOfLf(scan);
            while (lf < 0) {
                if (this.pend.Length() - pos >= 8193) {
                    acc.Free(); return 400;
                }
                scan = this.pend.Length();
                int n = await this.FillTo(pos + 8194);
                if (n < 0) { acc.Free(); return 400; }
                if (n == 0) { acc.Free(); return -1; }
                lf = this.IndexOfLf(scan);
            }
            if (lf - pos > 8192 || lf == pos || this.pend.ByteAt(lf - 1) != 13) {
                acc.Free();
                return 400;
            }
            // 长度用 64 位累积。32 位下 "100000000"（2^32）会在最后一位
            // 回绕成 0，被误当成结束块，剩余字节随即按流水线解析成下一
            // 条请求（框架错位/请求走私）。上限判定在每位累积之后，size
            // 始终钳在 maxBodyBytes 内（至多约 2^35），64 位不会溢出。
            long size = 0;
            int i = pos;
            bool any = false;
            bool bad = false;
            while (i < lf) {
                int c = this.pend.ByteAt(i);
                if (c == 13) {
                    if (i == lf - 1) { break; }
                    bad = true; break;
                }
                if (c == 59) { break; }          // ';' 块扩展，忽略其内容
                int d = HttpFramer.HexVal(c);
                if (d < 0) { bad = true; break; }
                if (size > ((long)maxBodyBytes - (long)d) / 16) { acc.Free(); return 413; }
                size = size * 16 + (long)d;
                any = true;
                i = i + 1;
            }
            if (bad || !any) { acc.Free(); return 400; }
            for (int j = i; j < lf - 1; j = j + 1) {
                int extByte = this.pend.ByteAt(j);
                if (extByte == 13 || extByte == 10 || extByte == 0 || extByte == 127) {
                    acc.Free(); return 400;
                }
            }
            pos = lf + 1;
            if (size == 0) {
                // 结束块之后是可选的 trailer，以一个空行收尾。
                int end = await this.SkipTrailer(pos);
                if (end < 0) { acc.Free(); return end == -2 ? 400 : -1; }
                pos = end;
                break;
            }
            if (size > (long)maxBodyBytes - decoded) { acc.Free(); return 413; }
            // 仅保留当前块和紧随其后的分隔符；完整块消费后
            // Discard 已解码线路前缀，不能让大量微小块把 pend 撑大。
            while (this.pend.Length() - pos < size + 2) {
                int n = await this.FillTo(pos + (int)size + 2);
                if (n < 0) { acc.Free(); return 400; }
                if (n == 0) { acc.Free(); return -1; }
            }
            // size 已由上面的 maxBodyBytes 判定钳在 int 范围内。
            int chunk = (int)size;
            acc.WriteRaw(this.pend.Str(pos, chunk), chunk);
            decoded = decoded + chunk;
            pos = pos + chunk;
            // 块数据后必须紧跟 CRLF；缺失说明长度撒了谎。
            int c1 = this.pend.ByteAt(pos);
            int c2 = this.pend.ByteAt(pos + 1);
            if (c1 != 13 || c2 != 10) {
                // RFC 9112 chunk-data 必须以 CRLF 结束；裸 LF 会让
                // 前置代理与后端对请求边界产生不同解释。
                acc.Free();
                return 400;
            }
            pos = pos + 2;
            this.pend.Discard(pos);
            pos = 0;
            this.scanned = 0;
        }
        string decodedBody = acc.Str(0, decoded);
        if (req != null) {
            req.body = decodedBody;
            req.bodyLength = decoded;
            req.contentLength = decoded;
        } else {
            response.body = decodedBody;
            response.bodyBytesLen = decoded;
        }
        acc.Free();
        this.pend.Discard(pos);
        this.scanned = 0;
        this.wireBytes = 0;
        return 0;
    }

    /// <summary>跳过结束块之后的 trailer 头部，返回其后的线路下标；
    /// 对端中途关闭返回 -1，行或累计长度超过 8KB 返回 -2。</summary>
    async int SkipTrailer(int from) {
        int pos = from;
        while (true) {
            int scan = pos;
            int lf = this.IndexOfLf(scan);
            while (lf < 0) {
                if (this.pend.Length() - from >= 8193) { return -2; }
                scan = this.pend.Length();
                int n = await this.FillTo(from + 8194);
                if (n < 0) { return -2; }
                if (n == 0) { return -1; }
                lf = this.IndexOfLf(scan);
            }
            if (lf + 1 - from > 8192 || lf == pos || this.pend.ByteAt(lf - 1) != 13) { return -2; }
            bool blank = lf - 1 == pos;
            pos = lf + 1;
            if (blank) { return pos; }
        }
        return pos;
    }

    /// <summary>从 <paramref name="from"/> 起第一个 LF 的下标，没有则 -1。</summary>
    int IndexOfLf(int from) {
        int len = this.pend.Length();
        for (int i = from; i < len; i = i + 1) {
            if (this.pend.ByteAt(i) == 10) { return i; }
        }
        return -1;
    }

    /// <summary>十六进制字符的数值；非十六进制字符返回 -1。</summary>
    static int HexVal(int c) {
        if (c >= 48 && c <= 57) { return c - 48; }
        if (c >= 97 && c <= 102) { return c - 87; }
        if (c >= 65 && c <= 70) { return c - 55; }
        return -1;
    }

    /// <summary>归还接收缓冲区并释放待处理缓冲区。连接关闭时调用；
    /// 之后不得再使用本拆包器。</summary>
    void Dispose() {
        if (this.buf != null) {
            TcpClient.ReturnRecvBuffer(this.buf, this.bufCap);
            this.buf = null;
        }
        if (this.pend != null) {
            this.pend.Free();
            this.pend = null;
        }
    }
}
