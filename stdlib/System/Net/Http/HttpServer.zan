using System;
using System.Net;
using System.Net.Sockets;
using System.Net.Http;
using System.Threading;

namespace System.Net.Http;

/// <summary>Handles a parsed request and produces the response to send.
/// Async so the handler can await I/O (Db/Redis/etc.) without blocking the
/// connection's coroutine or the worker event loop.</summary>
async delegate HttpResponse HttpRequestHandler(HttpRequest request);

/// <summary>
/// Coroutine-based HTTP/1.1 server: the http facade over System.Net.Worker.
/// Each client connection is served by its own coroutine, and Workers(n) runs
/// the same server in n processes (SO_REUSEPORT on Linux/macOS, master accept
/// plus WSADuplicateSocket handoff on Windows) exactly like workerman's
/// $worker->count.
///
/// Usage:
///   class MyApp {
///       static void Main() {
///           HttpServer server = HttpServer.Create("0.0.0.0", 8080);
///           server.Workers(4);
///           server.OnRequest(MyApp.HandleRequest);
///           await server.Start();
///       }
///       static async HttpResponse HandleRequest(HttpRequest req) {
///           if (req.path == "/") {
///               return HttpResponse.Ok("<h1>Hello Zan!</h1>");
///           }
///           return HttpResponse.NotFound();
///       }
///   }
///
/// The connection loop (ServeConnection) is the single implementation of
/// HTTP/1.1 framing and limits in the stdlib; Worker's "http" protocol runs
/// the very same code, so the two never drift apart.
/// </summary>
class HttpServer {
    TcpListener listener;
    string host;
    int port;
    bool running;
    int maxConnections;
    int activeConnections;
    int requestTimeout;
    int maxRequestBytes;
    int maxHeaderBytes;
    int workerCount;
    HttpRequestHandler requestHandler;

    HttpServer(string host, int port) {
        this.host = host;
        this.port = port;
        this.running = false;
        this.maxConnections = 10000;
        this.activeConnections = 0;
        this.requestTimeout = 30000;
        this.maxRequestBytes = 1048576;
        this.maxHeaderBytes = 16384;
        this.workerCount = 1;
        this.requestHandler = null;
    }

    /// <summary>Creates an HTTP server on the given address.</summary>
    static HttpServer Create(string host, int port) {
        HttpServer server = new HttpServer(host, port);
        return server;
    }

    /// <summary>Sets the maximum number of concurrent connections.</summary>
    HttpServer SetMaxConnections(int max) {
        this.maxConnections = max;
        return this;
    }

    /// <summary>Sets the request timeout in milliseconds.</summary>
    HttpServer SetTimeout(int ms) {
        this.requestTimeout = ms;
        return this;
    }

    /// <summary>Sets the maximum accepted size, in bytes, of a single request
    /// (headers + body). A request that grows past this is answered with 413 and
    /// the connection is closed, so a client cannot exhaust memory with an
    /// unbounded request.</summary>
    HttpServer SetMaxRequestBytes(int bytes) {
        this.maxRequestBytes = bytes;
        return this;
    }

    /// <summary>Sets the maximum size, in bytes, of the request header block.
    /// A client that keeps sending headers without the terminating blank line
    /// is answered with 431 and disconnected before the buffer can grow to the
    /// whole-request limit.</summary>
    HttpServer SetMaxHeaderBytes(int bytes) {
        this.maxHeaderBytes = bytes;
        return this;
    }

    /// <summary>Number of processes serving this port (workerman's
    /// $worker->count). 1 (default) serves in this process.</summary>
    HttpServer Workers(int count) {
        this.workerCount = count;
        return this;
    }

    /// <summary>Returns the index just past the end of the header block (the
    /// first byte of the body) for the first request in <paramref name="buf"/>,
    /// or -1 if the blank line terminating the headers has not arrived yet.
    /// Recognises both CRLF (\r\n\r\n) and bare-LF (\n\n) separators.</summary>
    static int FindHeaderEnd(string buf) {
        int len = buf.Length;
        int i = 0;
        while (i < len) {
            if ((buf[i] & 255) == 10) {
                // "\n\n"
                if (i + 1 < len && (buf[i + 1] & 255) == 10) {
                    return i + 2;
                }
                // "\n\r\n"
                if (i + 2 < len && (buf[i + 1] & 255) == 13 && (buf[i + 2] & 255) == 10) {
                    return i + 3;
                }
            }
            i = i + 1;
        }
        return -1;
    }

    /// <summary>Registers the handler invoked for every incoming request.
    /// When set, it replaces the default placeholder response.</summary>
    HttpServer OnRequest(HttpRequestHandler handler) {
        this.requestHandler = handler;
        return this;
    }

    /// <summary>Starts the server. With Workers(n>1) this hands the listener to
    /// System.Net.Worker, which spawns and supervises n processes; otherwise it
    /// runs the accept loop here. Never returns while the server is running;
    /// each accept and every per-connection read suspends on the IO reactor
    /// instead of busy-waiting.</summary>
    async void Start() {
        if (this.workerCount > 1) {
            Worker w = Worker.Create("http", this.host, this.port);
            w.count = this.workerCount;
            w.onHttpRequest = this.requestHandler;
            w.SetMaxConnections(this.maxConnections);
            w.SetHttpLimits(this.maxHeaderBytes, this.maxRequestBytes, this.requestTimeout);
            await Worker.RunAll();
            return;
        }

        Socket.Initialize();
        this.listener = TcpListener.Create(this.host, this.port);
        this.listener.Start();
        this.running = true;

        while (this.running) {
            int clientSock = await this.listener.AcceptAsync();
            if (clientSock >= 0) {
                Socket.SetNoDelay(clientSock);
                if (this.activeConnections >= this.maxConnections) {
                    // Over the limit: answer 503 and hang up rather than piling
                    // up coroutines and buffers for connections we cannot serve.
                    Task.Spawn(HttpServer.RejectOverloaded(clientSock));
                } else {
                    this.activeConnections = this.activeConnections + 1;
                    // Handle each connection on its own coroutine so the accept
                    // loop keeps accepting instead of serving one client at a time.
                    Task.Spawn(HandleConnection(clientSock));
                }
            }
        }
    }

    static async void RejectOverloaded(int clientSock) {
        TcpClient client = TcpClient.FromSocket(clientSock);
        HttpResponse busy = HttpResponse.WithStatus(503, "Service Unavailable",
            "server busy");
        busy = busy.SetKeepAlive(false);
        int _s = await client.SendAsync(busy.Build());
        client.Close();
    }

    /// <summary>Handles a single client connection.</summary>
    async void HandleConnection(int clientSock) {
        await HttpServer.ServeConnection(clientSock, this.requestHandler,
            this.maxHeaderBytes, this.maxRequestBytes, this.requestTimeout);
        this.activeConnections = this.activeConnections - 1;
    }

    /// <summary>Serves one HTTP/1.1 connection to completion: framing (partial
    /// reads, exact Content-Length bodies, pipelining), keep-alive, the limits
    /// that keep a hostile client from consuming the process, and dispatch to
    /// <paramref name="handler"/>.
    ///
    /// This is the stdlib's only HTTP connection loop: HttpServer and Worker's
    /// "http" protocol both run it, so framing fixes and hardening apply to
    /// both. Limits, all enforced before the offending bytes are buffered:
    ///   431 -- header block larger than <paramref name="maxHeaderBytes"/>;
    ///   413 -- request larger than <paramref name="maxRequestBytes"/>, decided
    ///          from Content-Length instead of after buffering the body;
    ///   hang-up -- a request that is not complete within
    ///          <paramref name="timeoutMs"/> (slowloris: the deadline is set per
    ///          request and is NOT refreshed by trickled bytes).</summary>
    static async void ServeConnection(int clientSock, HttpRequestHandler handler,
                                      int maxHeaderBytes, int maxRequestBytes,
                                      int timeoutMs) {
        TcpClient client = TcpClient.FromSocket(clientSock);
        int watch = HttpDeadline.Arm(clientSock, timeoutMs);
        bool keepAlive = true;
        // Bytes received but not yet consumed as a complete request. Persisting
        // this across the keep-alive loop is what makes framing correct: a read
        // may deliver a partial request (finish it on the next read) or several
        // pipelined requests at once (the remainder stays buffered for the next
        // iteration instead of leaking into this request's body).
        string buffer = "";
        // When the whole request arrives in one receive (the common case),
        // `buffer` aliases the connection's shared receive buffer instead of
        // copying it. The alias is only valid until the next receive, so it is
        // detached (copied) before any further RecvReuseAsync.
        bool aliased = false;
        int reject = 0;

        while (keepAlive) {
            // A fresh deadline per request: a connection may idle between
            // keep-alive requests, but once bytes start arriving the whole
            // request has to land inside the window.
            HttpDeadline.Touch(watch, timeoutMs);

            // 1) Read until the full header block has arrived.
            int headerEnd = HttpServer.FindHeaderEnd(buffer);
            while (headerEnd < 0) {
                if (buffer.Length > maxHeaderBytes) { reject = 431; break; }
                if (aliased) { buffer = buffer.Substring(0, buffer.Length); aliased = false; }
                string chunk = await client.RecvReuseAsync();
                if (chunk.Length == 0) { keepAlive = false; break; }
                if (buffer.Length == 0) {
                    buffer = chunk;
                    aliased = true;
                } else {
                    buffer = buffer + chunk;
                }
                headerEnd = HttpServer.FindHeaderEnd(buffer);
            }
            if (reject != 0) { break; }
            if (!keepAlive) { break; }

            // 2) Parse once: the headers are complete here, so every header
            //    field is final; only the body may still be in flight. Then
            //    read until exactly the declared body bytes are present.
            HttpRequest request = HttpRequest.Parse(buffer);
            int bodyLen = request.contentLength;
            if (bodyLen < 0) { bodyLen = 0; }
            int need = headerEnd + bodyLen;
            if (need > maxRequestBytes) { reject = 413; break; }
            while (buffer.Length < need) {
                if (aliased) { buffer = buffer.Substring(0, buffer.Length); aliased = false; }
                string chunk = await client.RecvReuseAsync();
                if (chunk.Length == 0) { keepAlive = false; break; }
                buffer = buffer + chunk;
            }
            if (!keepAlive && buffer.Length < need) { break; }

            // 3) Slice out exactly this request's body; keep any trailing bytes
            //    as the start of the next pipelined request.
            if (bodyLen > 0) {
                request.body = buffer.Substring(headerEnd, bodyLen);
            } else {
                request.body = "";
            }
            if (buffer.Length > need) {
                buffer = buffer.Substring(need);
            } else {
                buffer = "";
            }
            aliased = false;
            keepAlive = request.keepAlive;
            Worker.BumpStat();

            HttpResponse response = null;
            if (handler != null) {
                response = await handler(request);
            } else {
                response = HttpResponse.Ok(
                    "<h1>Zan HTTP Server</h1><p>Register a handler with OnRequest.</p>");
            }
            response = response.SetKeepAlive(keepAlive);

            string responseData = response.Build();
            int _sent = await client.SendAsync(responseData);

            if (!keepAlive) {
                break;
            }
        }

        if (reject == 431) {
            HttpResponse big = HttpResponse.WithStatus(431,
                "Request Header Fields Too Large", "header block exceeds limit");
            big = big.SetKeepAlive(false);
            int _h = await client.SendAsync(big.Build());
        } else if (reject == 413) {
            HttpResponse tooLarge = HttpResponse.WithStatus(413, "Payload Too Large",
                "request exceeds limit");
            tooLarge = tooLarge.SetKeepAlive(false);
            int _s = await client.SendAsync(tooLarge.Build());
        }

        HttpDeadline.Disarm(watch);
        client.Close();
    }

    /// <summary>Stops the server.</summary>
    void Stop() {
        this.running = false;
        if (this.listener != null) {
            this.listener.Stop();
        }
    }

    /// <summary>Returns the number of active connections.</summary>
    int GetActiveConnections() {
        return this.activeConnections;
    }

    /// <summary>Returns whether the server is running.</summary>
    bool IsRunning() {
        return this.running;
    }
}

/// <summary>
/// Per-connection request deadlines, swept by one coroutine for the whole
/// process.
///
/// A timeout cannot be taken on the receive itself: the connection coroutine is
/// parked in the IO reactor with nothing else to run it. Instead each connection
/// registers a deadline slot, and a single sweeper wakes once a second and hangs
/// up on whoever is late. That is O(1) work per request (one integer store) and
/// one coroutine per process, rather than a timer coroutine per connection.
///
/// The sweeper shuts the socket down instead of closing it, so the waiting
/// coroutine is woken by a 0-byte read and unwinds through its normal
/// disconnect path (freeing the slot); closing the descriptor here would strand
/// that coroutine and leak the slot.
/// </summary>
class HttpDeadline {
    static List<int> socks = new List<int>();
    static List<int> deadlines = new List<int>();
    static List<int> freeSlots = new List<int>();
    static bool sweeping = false;
    // Coarse clock kept by the sweeper: reading the real clock costs a syscall
    // (and an allocation on POSIX), which is not worth paying per request when
    // the timeout is measured in seconds.
    static int nowMs = 0;

    /// <summary>Registers a connection and returns its slot, or -1 when
    /// deadlines are disabled (timeoutMs &lt;= 0).</summary>
    static int Arm(int sock, int timeoutMs) {
        if (timeoutMs <= 0) { return -1; }
        if (!sweeping) {
            sweeping = true;
            nowMs = Stopwatch.GetMilliseconds();
            Task.Spawn(HttpDeadline.Sweep());
        }
        int n = freeSlots.Count;
        if (n > 0) {
            int slot = freeSlots[n - 1];
            freeSlots.RemoveAt(n - 1);
            socks[slot] = sock;
            deadlines[slot] = nowMs + timeoutMs;
            return slot;
        }
        socks.Add(sock);
        deadlines.Add(nowMs + timeoutMs);
        return socks.Count - 1;
    }

    /// <summary>Restarts the window for a slot (called once per request).</summary>
    static void Touch(int slot, int timeoutMs) {
        if (slot < 0) { return; }
        deadlines[slot] = nowMs + timeoutMs;
    }

    /// <summary>Releases a slot when the connection is done.</summary>
    static void Disarm(int slot) {
        if (slot < 0) { return; }
        socks[slot] = -1;
        freeSlots.Add(slot);
    }

    // One pass: refresh the coarse clock and hang up on late connections.
    // Kept out of the coroutine because a static written from inside an async
    // method is captured by value there -- the clock update would be lost and
    // every connection would look overdue.
    static bool SweepOnce() {
        nowMs = Stopwatch.GetMilliseconds();
        int i = 0;
        int n = socks.Count;
        while (i < n) {
            int s = socks[i];
            if (s >= 0 && nowMs > deadlines[i]) {
                // Push the deadline out so a slot is only hung up once; the
                // owning coroutine frees it via Disarm as it unwinds.
                deadlines[i] = nowMs + 3600000;
                Socket.ShutdownBoth(s);
            }
            i = i + 1;
        }
        return socks.Count > freeSlots.Count;
    }

    static void StopSweeping() {
        sweeping = false;
    }

    // The sweeper only lives while connections are armed: a coroutine parked in
    // a permanent timer loop would keep the scheduler (and so the process)
    // alive after the last server task finished. Arm() restarts it.
    static async void Sweep() {
        bool live = true;
        while (live) {
            await Task.Delay(1000);
            live = HttpDeadline.SweepOnce();
        }
        HttpDeadline.StopSweeping();
    }
}

/// <summary>One registered route: method + path + static response body, kept as
/// a single entity instead of three index-aligned parallel lists.</summary>
class HttpRoute {
    string method;
    string path;
    string response;

    HttpRoute(string method, string path, string response) {
        this.method = method;
        this.path = path;
        this.response = response;
    }
}

/// <summary>
/// Simple HTTP router for mapping paths to handlers.
/// </summary>
class HttpRouter {
    List<HttpRoute> routes;

    HttpRouter() {
        this.routes = new List<HttpRoute>();
    }

    /// <summary>Creates a new router.</summary>
    static HttpRouter Create() {
        return new HttpRouter();
    }

    /// <summary>Registers a GET route.</summary>
    HttpRouter Get(string path, string responseBody) {
        this.routes.Add(new HttpRoute("GET", path, responseBody));
        return this;
    }

    /// <summary>Registers a POST route.</summary>
    HttpRouter Post(string path, string responseBody) {
        this.routes.Add(new HttpRoute("POST", path, responseBody));
        return this;
    }

    /// <summary>Registers a route for any method.</summary>
    HttpRouter Route(string method, string path, string responseBody) {
        this.routes.Add(new HttpRoute(method, path, responseBody));
        return this;
    }

    /// <summary>Matches a request to a registered route.</summary>
    HttpResponse Match(HttpRequest request) {
        foreach (HttpRoute r in this.routes) {
            if (r.path == request.path) {
                if (r.method == request.method || r.method == "*") {
                    return HttpResponse.Ok(r.response);
                }
            }
        }
        return HttpResponse.NotFound();
    }
}
