using System;
using System.Net;
using System.Net.Sockets;
using System.Net.Http;
using System.Threading;

namespace System.Net.Http;

/// <summary>处理解析后的请求并生成要发送的响应。
/// 异步声明，使处理器可以等待 I/O（Db/Redis 等）而不阻塞
/// 连接的协程或 worker 事件循环。</summary>
async delegate HttpResponse HttpRequestHandler(HttpRequest request);

/// <summary>
/// 基于协程的 HTTP/1.1 服务器：System.Net.Worker 之上的 http 门面。
/// 每个客户端连接由各自的协程服务，Workers(n) 在 n 个进程中
/// 运行同一服务器（Linux/macOS 用 SO_REUSEPORT，Windows 用 master accept
/// 加 WSADuplicateSocket 移交），与 workerman 的
/// $worker->count 一致。
///
/// 用法：
///   class MyApp {
///       static void Main() {
///           HttpServer server = new HttpServer("0.0.0.0", 8080);
///           server.Workers(4);
///           server.OnRequest(MyApp.HandleRequest);
///           await server.Start();
///       }
///       static async HttpResponse HandleRequest(HttpRequest req) {
///           if (req.path == "/") {
///               return HttpResponse.Ok("<h1>Hello Zan!</h1>");
///           }
///           return HttpResponse.NotFound();
///       }
///   }
///
/// 连接循环（ServeConnection）是
/// HTTP/1.1 帧解析与限制在 stdlib 中的唯一实现；Worker 的 "http" 协议
/// 运行同一份代码，两者不会产生偏差。
/// </summary>
class HttpServer {
    TcpListener listener;
    string host;
    int port;
    bool running;
    int maxConnections;
    int activeConnections;
    int requestTimeout;
    int maxRequestBytes;
    int maxHeaderBytes;
    int workerCount;
    HttpRequestHandler requestHandler;

    HttpServer(string host, int port) {
        this.host = host;
        this.port = port;
        this.running = false;
        this.maxConnections = 10000;
        this.activeConnections = 0;
        this.requestTimeout = 30000;
        this.maxRequestBytes = 1048576;
        this.maxHeaderBytes = 16384;
        this.workerCount = 1;
        this.requestHandler = null;
    }

    /// <summary>设置最大并发连接数。</summary>
    HttpServer SetMaxConnections(int max) {
        this.maxConnections = max;
        return this;
    }

    /// <summary>设置请求超时时间（毫秒）。</summary>
    HttpServer SetTimeout(int ms) {
        this.requestTimeout = ms;
        return this;
    }

    /// <summary>设置单个请求的最大可接受大小（字节，
    /// 请求头 + 请求体）。超过该大小的请求会返回 413，
    /// 并关闭连接，防止客户端用
    /// 无限制的请求耗尽内存。</summary>
    HttpServer SetMaxRequestBytes(int bytes) {
        this.maxRequestBytes = bytes;
        return this;
    }

    /// <summary>设置请求头块的最大大小（字节）。
    /// 客户端若持续发送请求头却不带结束空行，
    /// 会在缓冲区增长到整请求上限前
    /// 收到 431 并被断开连接。</summary>
    HttpServer SetMaxHeaderBytes(int bytes) {
        this.maxHeaderBytes = bytes;
        return this;
    }

    /// <summary>服务该端口的进程数（对应 workerman 的
    /// $worker->count）。1（默认）表示在本进程内服务。</summary>
    HttpServer Workers(int count) {
        this.workerCount = count;
        return this;
    }

    /// <summary>返回请求头块结束位置之后的索引（即
    /// <paramref name="buf"/> 中第一个请求的请求体首字节），
    /// 若请求头的结束空行尚未到达则返回 -1。
    /// 同时识别 CRLF（\r\n\r\n）与单独 LF（\n\n）分隔符。</summary>
    static int FindHeaderEnd(string buf) {
        int len = buf.Length;
        for (int i = 0; i < len; i = i + 1) {
            if ((buf[i] & 255) == 10) {
                // "\n\n"
                if (i + 1 < len && (buf[i + 1] & 255) == 10) {
                    return i + 2;
                }
                // "\n\r\n"
                if (i + 2 < len && (buf[i + 1] & 255) == 13 && (buf[i + 2] & 255) == 10) {
                    return i + 3;
                }
            }
        }
        return -1;
    }

    /// <summary>注册每个传入请求都会调用的处理器。
    /// 设置后取代默认的占位响应。</summary>
    HttpServer OnRequest(HttpRequestHandler handler) {
        this.requestHandler = handler;
        return this;
    }

    /// <summary>启动服务器。当 Workers(n>1) 时，将监听器交给
    /// System.Net.Worker，由其创建并监管 n 个进程；否则
    /// 在本进程运行 accept 循环。服务器运行期间不会返回；
    /// 每次 accept 以及每个连接上的读取都在 IO reactor 上挂起，
    /// 而非忙等。</summary>
    async void Start() {
        if (this.workerCount > 1) {
            Worker w = new Worker("http", this.host, this.port);
            w.count = this.workerCount;
            w.onHttpRequest = this.requestHandler;
            w.SetMaxConnections(this.maxConnections);
            w.SetHttpLimits(this.maxHeaderBytes, this.maxRequestBytes, this.requestTimeout);
            await Worker.RunAll();
            return;
        }

        Socket.Initialize();
        this.listener = new TcpListener(this.host, this.port);
        this.listener.Start();
        this.running = true;

        while (this.running) {
            nint clientSock = await this.listener.AcceptAsync();
            if (clientSock >= 0) {
                Socket.SetNoDelay(clientSock);
                if (this.activeConnections >= this.maxConnections) {
                    // 超过上限：返回 503 并挂断，而不是为无法服务的连接
                    // 堆积协程和缓冲区。
                    Task.Spawn(HttpServer.RejectOverloaded(clientSock));
                } else {
                    this.activeConnections = this.activeConnections + 1;
                    // 每个连接用独立协程处理，使 accept 循环
                    // 持续接受新连接，而不是一次只服务一个客户端。
                    Task.Spawn(HandleConnection(clientSock));
                }
            }
        }
    }

    static async void RejectOverloaded(nint clientSock) {
        TcpClient client = TcpClient.FromSocket(clientSock);
        HttpResponse busy = HttpResponse.WithStatus(503, "Service Unavailable",
            "server busy");
        busy = busy.SetKeepAlive(false);
        int _s = await client.SendAsync(busy.Build());
        client.Close();
    }

    /// <summary>处理单个客户端连接。</summary>
    async void HandleConnection(nint clientSock) {
        await HttpServer.ServeConnection(clientSock, this.requestHandler,
            this.maxHeaderBytes, this.maxRequestBytes, this.requestTimeout);
        this.activeConnections = this.activeConnections - 1;
    }

    /// <summary>将一个 HTTP/1.1 连接服务到底：帧解析（分段
    /// 读取、按 Content-Length 精确读取请求体、流水线）、keep-alive，以及
    /// 防止恶意客户端耗尽进程的各项限制，并分发到
    /// <paramref name="handler"/>。
    ///
    /// 这是 stdlib 中唯一的 HTTP 连接循环：HttpServer 与 Worker 的
    /// "http" 协议都运行它，因此帧解析的修复与加固
    /// 对两者同样生效。以下限制都在违规字节被缓冲前强制生效：
    ///   431——请求头块超过 <paramref name="maxHeaderBytes"/>；
    ///   413——请求超过 <paramref name="maxRequestBytes"/>，
    ///          依据 Content-Length 判定，而非在缓冲完请求体之后；
    ///   挂断——请求未在 <paramref name="timeoutMs"/> 内完成
    ///          （slowloris 防护：截止时间按请求单独设定，
    ///          不会因零散到达的字节而刷新）。</summary>
    static async void ServeConnection(nint clientSock, HttpRequestHandler handler,
                                      int maxHeaderBytes, int maxRequestBytes,
                                      int timeoutMs) {
        await HttpServer.ServePrimed(clientSock, handler, "",
            maxHeaderBytes, maxRequestBytes, timeoutMs);
    }

    /// <summary>用于首字节已被读取的套接字的 ServeConnection：
    /// 将 `pending` 放回流头部。同时服务 HTTP 与 WebSocket 的端口
    /// 需要先查看请求头部才能确定协议类型，
    /// 并把已消费的字节交给本函数。</summary>
    static async void ServePrimed(nint clientSock, HttpRequestHandler handler,
                                  string pending,
                                  int maxHeaderBytes, int maxRequestBytes,
                                  int timeoutMs) {
        TcpClient client = TcpClient.FromSocket(clientSock);
        int watch = HttpDeadline.Arm(clientSock, timeoutMs);
        bool keepAlive = true;
        // 已收到但尚未构成完整请求的字节。在 keep-alive 循环中
        // 保留该缓冲是帧解析正确的关键：一次读取可能
        // 只送来部分请求（下次读取时补全），也可能一次送来多个
        // 流水线请求（剩余部分留在缓冲区供下轮处理，
        // 而不会混入当前请求的请求体）。
        string buffer = pending;
        // 当整个请求在一次接收中到达（常见情况）时，
        // `buffer` 直接别名连接共享的接收缓冲区，而非
        // 复制。该别名只在下次接收前有效，因此
        // 在后续任何 RecvReuseAsync 之前都会先脱离（复制）。
        bool aliased = false;
        int reject = 0;

        while (keepAlive) {
            // 每个请求使用新的截止时间：连接可在 keep-alive 请求之间
            // 空闲，但一旦开始收到字节，整个请求必须
            // 落在窗口时间内。
            HttpDeadline.Touch(watch, timeoutMs);

            // 1) 一直读取，直到完整请求头块到达。
            int headerEnd = HttpServer.FindHeaderEnd(buffer);
            while (headerEnd < 0) {
                if (buffer.Length > maxHeaderBytes) { reject = 431; break; }
                if (aliased) { buffer = buffer.Substring(0, buffer.Length); aliased = false; }
                string chunk = await client.RecvReuseAsync();
                if (chunk.Length == 0) { keepAlive = false; break; }
                if (buffer.Length == 0) {
                    buffer = chunk;
                    aliased = true;
                } else {
                    buffer = buffer + chunk;
                }
                headerEnd = HttpServer.FindHeaderEnd(buffer);
            }
            if (reject != 0) { break; }
            if (!keepAlive) { break; }

            // 2) 只解析一次：此时请求头已完整，每个请求头字段
            //    都是最终值；只有请求体可能仍在传输中。然后
            //    继续读取，直到请求体声明的字节数全部到齐。
            HttpRequest request = HttpRequest.Parse(buffer);
            // 定界失败（Content-Length 溢出/重复不一致、非数字、
            // Transfer-Encoding 未实现等）→ 拒绝，不切分正文：
            // 剩余字节可能是走私的伪装请求，绝不能进入下轮。
            if (request.parseStatus != 0) {
                reject = request.parseStatus;
                break;
            }
            int bodyLen = request.contentLength;
            if (bodyLen < 0) { bodyLen = 0; }
            int need = headerEnd + bodyLen;
            if (need > maxRequestBytes) { reject = 413; break; }
            while (buffer.Length < need) {
                if (aliased) { buffer = buffer.Substring(0, buffer.Length); aliased = false; }
                string chunk = await client.RecvReuseAsync();
                if (chunk.Length == 0) { keepAlive = false; break; }
                buffer = buffer + chunk;
            }
            if (!keepAlive && buffer.Length < need) { break; }

            // 3) 精确切出本请求的请求体；剩余字节
            //    作为下一个流水线请求的开头。
            if (bodyLen > 0) {
                request.body = buffer.Substring(headerEnd, bodyLen);
            } else {
                request.body = "";
            }
            if (buffer.Length > need) {
                buffer = buffer.Substring(need);
            } else {
                buffer = "";
            }
            aliased = false;
            keepAlive = request.keepAlive;
            Worker.BumpStat();

            HttpResponse response = null;
            if (handler != null) {
                response = await handler(request);
            } else {
                response = HttpResponse.Ok(
                    "<h1>Zan HTTP Server</h1><p>Register a handler with OnRequest.</p>");
            }
            response = response.SetKeepAlive(keepAlive);

            string responseData = response.Build();
            response.Dispose();
            response = null;
            int _sent = await client.SendAsync(responseData);
            Worker.BumpSent();

            if (!keepAlive) {
                break;
            }
        }

        if (reject == 431) {
            HttpResponse big = HttpResponse.WithStatus(431,
                "Request Header Fields Too Large", "header block exceeds limit");
            big = big.SetKeepAlive(false);
            int _h = await client.SendAsync(big.Build());
        } else if (reject == 413) {
            HttpResponse tooLarge = HttpResponse.WithStatus(413, "Payload Too Large",
                "request exceeds limit");
            tooLarge = tooLarge.SetKeepAlive(false);
            int _s = await client.SendAsync(tooLarge.Build());
        } else if (reject == 400) {
            // 定界冲突/畸形长度：请求走私拒绝。必须关闭连接——
            // 缓冲区里可能还有伪装成下一条请求的剩余正文。
            HttpResponse bad = HttpResponse.WithStatus(400, "Bad Request",
                "malformed request framing");
            bad = bad.SetKeepAlive(false);
            int _b = await client.SendAsync(bad.Build());
        } else if (reject == 501) {
            HttpResponse nai = HttpResponse.WithStatus(501, "Not Implemented",
                "Transfer-Encoding is not supported");
            nai = nai.SetKeepAlive(false);
            int _n = await client.SendAsync(nai.Build());
        }

        HttpDeadline.Disarm(watch);
        client.Close();
    }

    /// <summary>停止服务器。</summary>
    void Stop() {
        this.running = false;
        if (this.listener != null) {
            this.listener.Stop();
        }
    }

    /// <summary>返回当前活动连接数。</summary>
    int GetActiveConnections() {
        return this.activeConnections;
    }

    /// <summary>返回服务器是否正在运行。</summary>
    bool IsRunning() {
        return this.running;
    }
}

class HttpDeadlineSlot {
    nint sock;
    int deadline;
    bool fired;

    HttpDeadlineSlot(nint sock, int deadline) {
        this.sock = sock;
        this.deadline = deadline;
        this.fired = false;
    }
}

/// <summary>
/// 按连接管理的请求截止时间，由整个进程中的一个协程统一
/// 扫描。
///
/// 无法直接在 receive 上设置超时：连接协程
/// 停靠在 IO reactor 中，没有其他机制驱动它。因此每个连接
/// 注册一个截止时间槽位，单个扫描器每秒唤醒一次，对超时者
/// 执行挂断。这使每个请求只需 O(1) 开销（一次整数写入），
/// 整个进程一个协程，而非每个连接一个定时器协程。
///
/// 扫描器对套接字执行 shutdown 而非 close，因此等待中的
/// 协程会因读取到 0 字节被唤醒，沿正常断连路径
/// 展开（释放槽位）；若在此处直接关闭描述符，会卡住
/// 该协程并泄漏槽位。
/// </summary>
class HttpDeadline {
    static List<HttpDeadlineSlot> slots = new List<HttpDeadlineSlot>();
    static List<int> freeSlots = new List<int>();
    static bool sweeping = false;
    // 由扫描器维护的粗粒度时钟：读取真实时钟需要一次系统调用
    // （POSIX 上还有一次内存分配），而超时精度以秒计，
    // 不必为每个请求付出该代价。
    static long nowMs = 0;

    /// <summary>注册一个连接并返回其槽位；
    /// 截止时间被禁用（timeoutMs &lt;= 0）时返回 -1。</summary>
    static int Arm(nint sock, int timeoutMs) {
        if (timeoutMs <= 0) { return -1; }
        if (!sweeping) {
            sweeping = true;
            nowMs = Stopwatch.GetMilliseconds();
            Task.Spawn(HttpDeadline.Sweep());
        }
        int n = freeSlots.Count;
        if (n > 0) {
            int slot = freeSlots[n - 1];
            freeSlots.RemoveAt(n - 1);
            slots[slot].sock = sock;
            slots[slot].deadline = nowMs + timeoutMs;
            slots[slot].fired = false;
            return slot;
        }
        slots.Add(new HttpDeadlineSlot(sock, nowMs + timeoutMs));
        return slots.Count - 1;
    }

    /// <summary>为某个槽位重启时间窗口（每个请求调用一次）。</summary>
    static void Touch(int slot, int timeoutMs) {
        if (slot < 0) { return; }
        slots[slot].deadline = nowMs + timeoutMs;
        slots[slot].fired = false;
    }

    /// <summary>当扫描器已对该槽位执行挂断时返回 true，即唤醒
    /// 归属者读取的是截止时间而非对端。需要报告
    /// 超时的调用方（HTTP 客户端）必须在 Disarm 之前查询。</summary>
    static bool Expired(int slot) {
        if (slot < 0) { return false; }
        return slots[slot].fired;
    }

    /// <summary>连接结束时释放槽位。</summary>
    static void Disarm(int slot) {
        if (slot < 0) { return; }
        slots[slot].sock = -1;
        freeSlots.Add(slot);
    }

    // 单次扫描：刷新粗粒度时钟并对超时的连接执行挂断。
    // 不放入协程，是因为在 async 方法内部写入静态变量会
    // 按值捕获——时钟更新会丢失，
    // 导致所有连接都看起来超时。
    static bool SweepOnce() {
        nowMs = Stopwatch.GetMilliseconds();
        int n = slots.Count;
        for (int i = 0; i < n; i = i + 1) {
            HttpDeadlineSlot slot = slots[i];
            nint s = slot.sock;
            if (s >= 0 && nowMs > slot.deadline) {
                // 将截止时间推远，确保每个槽位只被挂断一次；
                // 归属协程在展开时会通过 Disarm 释放它。
                slot.deadline = nowMs + 3600000;
                slot.fired = true;
                Socket.ShutdownBoth(s);
            }
        }
        return slots.Count > freeSlots.Count;
    }

    static void StopSweeping() {
        sweeping = false;
    }

    // 扫描器只在有连接被 Arm 时存活：让一个协程常驻于
    // 永久定时循环会让调度器（以及整个进程）在最后一个
    // 服务器任务结束后仍保持存活。Arm() 会重启它。
    static async void Sweep() {
        bool live = true;
        while (live) {
            await Task.Delay(1000);
            live = HttpDeadline.SweepOnce();
        }
        HttpDeadline.StopSweeping();
    }
}

/// <summary>一条已注册的路由：method + path + 静态响应体，作为一个
/// 整体保存，而非三个索引对齐的并行列表。</summary>
class HttpRoute {
    string method;
    string path;
    string response;

    HttpRoute(string method, string path, string response) {
        this.method = method;
        this.path = path;
        this.response = response;
    }
}

/// <summary>
/// 简单的 HTTP 路由器，用于将路径映射到处理器。
/// </summary>
class HttpRouter {
    List<HttpRoute> routes;

    HttpRouter() {
        this.routes = new List<HttpRoute>();
    }

    /// <summary>注册一条 GET 路由。</summary>
    HttpRouter Get(string path, string responseBody) {
        this.routes.Add(new HttpRoute("GET", path, responseBody));
        return this;
    }

    /// <summary>注册一条 POST 路由。</summary>
    HttpRouter Post(string path, string responseBody) {
        this.routes.Add(new HttpRoute("POST", path, responseBody));
        return this;
    }

    /// <summary>注册适用于任意方法的路由。</summary>
    HttpRouter Route(string method, string path, string responseBody) {
        this.routes.Add(new HttpRoute(method, path, responseBody));
        return this;
    }

    /// <summary>将请求匹配到已注册的路由。</summary>
    HttpResponse Match(HttpRequest request) {
        foreach (HttpRoute r in this.routes) {
            if (r.path == request.path) {
                if (r.method == request.method || r.method == "*") {
                    return HttpResponse.Ok(r.response);
                }
            }
        }
        return HttpResponse.NotFound();
    }
}
