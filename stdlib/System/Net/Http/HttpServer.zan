using System;
using System.Net;
using System.Net.Sockets;
using System.Net.Http;
using System.Threading;

namespace System.Net.Http;

/// <summary>处理解析后的请求并生成要发送的响应。
/// 异步声明，使处理器可以等待 I/O（Db/Redis 等）而不阻塞
/// 连接的协程或 worker 事件循环。</summary>
async delegate HttpResponse HttpRequestHandler(HttpRequest request);

/// <summary>
/// 基于协程的 HTTP/1.1 服务器：System.Net.Worker 之上的 http 门面。
/// 每个客户端连接由各自的协程服务，Workers(n) 在 n 个进程中
/// 运行同一服务器（Linux/macOS 用 SO_REUSEPORT，Windows 用 master accept
/// 加 WSADuplicateSocket 移交），与 workerman 的
/// $worker->count 一致。
///
/// 用法：
///   class MyApp {
///       static void Main() {
///           HttpServer server = new HttpServer("0.0.0.0", 8080);
///           server.Workers(4);
///           server.OnRequest(MyApp.HandleRequest);
///           await server.Start();
///       }
///       static async HttpResponse HandleRequest(HttpRequest req) {
///           if (req.path == "/") {
///               return HttpResponse.Ok("<h1>Hello Zan!</h1>");
///           }
///           return HttpResponse.NotFound();
///       }
///   }
///
/// 连接循环（ServeConnection）是
/// HTTP/1.1 帧解析与限制在 stdlib 中的唯一实现；Worker 的 "http" 协议
/// 运行同一份代码，两者不会产生偏差。
/// </summary>
class HttpServer {
    TcpListener listener;
    string host;
    int port;
    bool running;
    int maxConnections;
    int activeConnections;
    int requestTimeout;
    int maxRequestBytes;
    int maxHeaderBytes;
    int workerCount;
    HttpRequestHandler requestHandler;

    /// <summary>创建未启动的服务器；用 OnRequest / Workers 等配置后调用 Start。</summary>
    HttpServer(string host, int port) {
        this.host = host;
        this.port = port;
        this.running = false;
        this.maxConnections = 10000;
        this.activeConnections = 0;
        this.requestTimeout = 30000;
        this.maxRequestBytes = 1048576;
        this.maxHeaderBytes = 16384;
        this.workerCount = 1;
        this.requestHandler = null;
    }

    /// <summary>设置最大并发连接数。</summary>
    HttpServer SetMaxConnections(int max) {
        this.maxConnections = max;
        return this;
    }

    /// <summary>设置请求超时时间（毫秒）。</summary>
    HttpServer SetTimeout(int ms) {
        this.requestTimeout = ms;
        return this;
    }

    /// <summary>设置单个请求的最大可接受大小（字节，
    /// 请求头 + 请求体）。超过该大小的请求会返回 413，
    /// 并关闭连接，防止客户端用
    /// 无限制的请求耗尽内存。</summary>
    HttpServer SetMaxRequestBytes(int bytes) {
        this.maxRequestBytes = bytes;
        return this;
    }

    /// <summary>设置请求头块的最大大小（字节）。
    /// 客户端若持续发送请求头却不带结束空行，
    /// 会在缓冲区增长到整请求上限前
    /// 收到 431 并被断开连接。</summary>
    HttpServer SetMaxHeaderBytes(int bytes) {
        this.maxHeaderBytes = bytes;
        return this;
    }

    /// <summary>服务该端口的进程数（对应 workerman 的
    /// $worker->count）。1（默认）表示在本进程内服务。</summary>
    HttpServer Workers(int count) {
        this.workerCount = count;
        return this;
    }

    /// <summary>返回请求头块结束位置之后的索引（即
    /// <paramref name="buf"/> 中第一个请求的请求体首字节），
    /// 若请求头的结束空行尚未到达则返回 -1。
    /// 同时识别 CRLF（\r\n\r\n）与单独 LF（\n\n）分隔符。</summary>
    static int FindHeaderEnd(string buf) {
        int len = buf.Length;
        for (int i = 0; i < len; i = i + 1) {
            if ((buf[i] & 255) == 10) {
                // "\n\n"
                if (i + 1 < len && (buf[i + 1] & 255) == 10) {
                    return i + 2;
                }
                // "\n\r\n"
                if (i + 2 < len && (buf[i + 1] & 255) == 13 && (buf[i + 2] & 255) == 10) {
                    return i + 3;
                }
            }
        }
        return -1;
    }

    /// <summary>注册每个传入请求都会调用的处理器。
    /// 设置后取代默认的占位响应。</summary>
    HttpServer OnRequest(HttpRequestHandler handler) {
        this.requestHandler = handler;
        return this;
    }

    /// <summary>启动服务器。当 Workers(n>1) 时，将监听器交给
    /// System.Net.Worker，由其创建并监管 n 个进程；否则
    /// 在本进程运行 accept 循环。服务器运行期间不会返回；
    /// 每次 accept 以及每个连接上的读取都在 IO reactor 上挂起，
    /// 而非忙等。</summary>
    async void Start() {
        if (this.workerCount > 1) {
            Worker w = new Worker("http", this.host, this.port);
            w.count = this.workerCount;
            w.onHttpRequest = this.requestHandler;
            w.SetMaxConnections(this.maxConnections);
            w.SetHttpLimits(this.maxHeaderBytes, this.maxRequestBytes, this.requestTimeout);
            await Worker.RunAll();
            return;
        }

        Socket.Initialize();
        this.listener = new TcpListener(this.host, this.port);
        this.listener.Start();
        this.running = true;

        while (this.running) {
            nint clientSock = await this.listener.AcceptAsync();
            if (clientSock >= 0) {
                Socket.SetNoDelay(clientSock);
                if (this.activeConnections >= this.maxConnections) {
                    // 超过上限：返回 503 并挂断，而不是为无法服务的连接
                    // 堆积协程和缓冲区。
                    Task.Spawn(HttpServer.RejectOverloaded(clientSock));
                } else {
                    this.activeConnections = this.activeConnections + 1;
                    // 每个连接用独立协程处理，使 accept 循环
                    // 持续接受新连接，而不是一次只服务一个客户端。
                    Task.Spawn(HandleConnection(clientSock));
                }
            }
        }
    }

    /// <summary>超过 maxConnections 时对下游回 503（Connection: close）并关闭。</summary>
    static async void RejectOverloaded(nint clientSock) {
        TcpClient client = TcpClient.FromSocket(clientSock);
        HttpResponse busy = HttpResponse.WithStatus(503, "Service Unavailable",
            "server busy");
        busy = busy.SetKeepAlive(false);
        int _s = await client.SendAsync(busy.Build());
        client.Close();
    }

    /// <summary>处理单个客户端连接。连接计数必须在 finally 中归还：
    /// 处理器抛出的异常会跳过顺序清理，泄漏的计数会让服务器在
    /// maxConnections 处永久 503。</summary>
    async void HandleConnection(nint clientSock) {
        try {
            await HttpServer.ServeConnection(clientSock, this.requestHandler,
                this.maxHeaderBytes, this.maxRequestBytes, this.requestTimeout);
        } finally {
            this.activeConnections = this.activeConnections - 1;
        }
    }

    /// <summary>将一个 HTTP/1.1 连接服务到底：帧解析（分段
    /// 读取、按 Content-Length 精确读取请求体、流水线）、keep-alive，以及
    /// 防止恶意客户端耗尽进程的各项限制，并分发到
    /// <paramref name="handler"/>。
    ///
    /// 这是 stdlib 中唯一的 HTTP 连接循环：HttpServer 与 Worker 的
    /// "http" 协议都运行它，因此帧解析的修复与加固
    /// 对两者同样生效。以下限制都在违规字节被缓冲前强制生效：
    ///   431——请求头块超过 <paramref name="maxHeaderBytes"/>；
    ///   413——请求超过 <paramref name="maxRequestBytes"/>，
    ///          依据 Content-Length 判定，而非在缓冲完请求体之后；
    ///   挂断——请求未在 <paramref name="timeoutMs"/> 内完成
    ///          （slowloris 防护：截止时间按请求单独设定，
    ///          不会因零散到达的字节而刷新）。</summary>
    static async void ServeConnection(nint clientSock, HttpRequestHandler handler,
                                      int maxHeaderBytes, int maxRequestBytes,
                                      int timeoutMs) {
        await HttpServer.ServePrimed(clientSock, handler, "",
            maxHeaderBytes, maxRequestBytes, timeoutMs);
    }

    /// <summary>用于首字节已被读取的套接字的 ServeConnection：
    /// 将 `pending` 放回流头部。同时服务 HTTP 与 WebSocket 的端口
    /// 需要先查看请求头部才能确定协议类型，
    /// 并把已消费的字节交给本函数。</summary>
    static async void ServePrimed(nint clientSock, HttpRequestHandler handler,
                                  string pending,
                                  int maxHeaderBytes, int maxRequestBytes,
                                  int timeoutMs) {
        // 拆包交给 HttpFramer：它按显式字节数攒未消费的字节，因此
        // 跨包到达的头部、跨包到达的正文、一个包里的多条流水线请求、
        // 以及含 NUL 的二进制正文都能精确定界（字符串拼接按 strlen
        // 定长，二进制正文会在第一个 NUL 处截断，声明的
        // Content-Length 就永远读不满）。
        HttpFramer framer = HttpFramer.Create(clientSock);
        framer.Prime(pending, pending.Length);
        await HttpServer.ServeFramed(clientSock, handler, framer,
            maxHeaderBytes, maxRequestBytes, timeoutMs);
    }

    /// <summary>已经用 <see cref="HttpFramer"/> 读过若干字节的连接
    /// （如 WebSocket 端口先读握手头部）交回 HTTP 循环：拆包器连同
    /// 其中未消费的字节一并交接，无需把字节转成字符串再放回——
    /// 二进制正文在这一步转换里会被 NUL 截断。</summary>
    static async void ServeFramed(nint clientSock, HttpRequestHandler handler,
                                  HttpFramer framer,
                                  int maxHeaderBytes, int maxRequestBytes,
                                  int timeoutMs) {
        HttpDeadlineToken watch = HttpDeadline.Arm(clientSock, timeoutMs);
        try {
            await HttpServer.ServeFramedCore(clientSock, handler, framer,
                maxHeaderBytes, maxRequestBytes, timeoutMs, watch);
        } finally {
            // Core also disarms on normal completion; this is the exception path.
            HttpDeadline.Disarm(watch);
        }
    }

    /// <summary>HTTP 连接循环本体：读头块 → 解析 → 读正文 → 分发
    /// 处理器 → 按字节长度发响应，keep-alive 循环；431/413/400/501
    /// 拒绝响应在此统一发送并关闭连接。</summary>
    static async int ServeFramedCore(nint clientSock, HttpRequestHandler handler,
                                  HttpFramer framer,
                                  int maxHeaderBytes, int maxRequestBytes,
                                  int timeoutMs, HttpDeadlineToken watch) {
        TcpClient client = TcpClient.FromSocket(clientSock);
        // 处理器抛出的异常会跳过顺序清理语句（见
        // docs/bugs/throw-leaks-live-locals.md）：拆包器的 64KB 复用缓冲
        // 与待处理缓冲、连接 fd、deadline 槽位都会泄漏。cleanup 交给
        // finally，正常路径与异常路径共用同一份释放代码。
        try {
            return await HttpServer.ServeFramedInner(clientSock, handler, framer,
                maxHeaderBytes, maxRequestBytes, timeoutMs, watch, client);
        } finally {
            HttpDeadline.Disarm(watch);
            framer.Dispose();
            client.Close();
        }
    }

    /// <summary>ServeFramedCore 的循环体；释放见 ServeFramedCore 的 finally。</summary>
    static async int ServeFramedInner(nint clientSock, HttpRequestHandler handler,
                                  HttpFramer framer,
                                  int maxHeaderBytes, int maxRequestBytes,
                                  int timeoutMs, HttpDeadlineToken watch,
                                  TcpClient client) {
        bool keepAlive = true;
        int reject = 0;

        while (keepAlive) {
            // 每个请求使用新的截止时间：连接可在 keep-alive 请求之间
            // 空闲，但一旦开始收到字节，整个请求必须
            // 落在窗口时间内。
            HttpDeadline.Touch(watch, timeoutMs);

            // 1) 一直读取，直到完整请求头块到达。
            int headerEnd = await framer.ReadHead(maxHeaderBytes);
            if (headerEnd == -431) { reject = 431; break; }
            if (headerEnd <= 0) { keepAlive = false; break; }

            // 2) 只解析一次：此时请求头已完整，每个请求头字段
            //    都是最终值；只有请求体可能仍在传输中。然后
            //    继续读取，直到请求体声明的字节数全部到齐。
            HttpRequest request = HttpRequest.Parse(framer.Head(headerEnd),
                                                   headerEnd);
            // 定界失败（Content-Length 溢出/重复不一致、非数字、
            // 未实现的 Transfer-Encoding 等）→ 拒绝，不切分正文：
            // 剩余字节可能是走私的伪装请求，绝不能进入下轮。
            if (request.parseStatus != 0) {
                reject = request.parseStatus;
                break;
            }
            int bodyLen = request.contentLength;
            if (bodyLen < 0) { bodyLen = 0; }
            if (headerEnd + bodyLen > maxRequestBytes) { reject = 413; break; }
            // 3) 正文到齐（分块编码在此解码），随后精确丢弃本请求的
            //    字节，剩余字节即下一条流水线请求的开头。
            int bodyStatus = await framer.ReadBody(request,
                maxRequestBytes - headerEnd);
            if (bodyStatus > 0) { reject = bodyStatus; break; }
            if (bodyStatus < 0) { keepAlive = false; break; }
            framer.Consume(framer.RequestBytes());
            keepAlive = request.keepAlive;
            Worker.BumpStat();

            HttpResponse response = null;
            if (handler != null) {
                response = await handler(request);
            } else {
                response = HttpResponse.Ok(
                    "<h1>Zan HTTP Server</h1><p>Register a handler with OnRequest.</p>");
            }
            response = response.SetKeepAlive(keepAlive);

            // 按字节长度发送：SendAsync 用 strlen 定长，正文里的 NUL
            // 会把响应截断（下载二进制文件、返回带 NUL 的日志片段时
            // 客户端只收到半个报文）。Content-Length 与发送长度必须
            // 取自同一处（BodyLength）。二进制正文单独发一次，因为它
            // 无法拼进以 NUL 结尾的字符串里。
            if (response.IsBinary()) {
                string head = response.BuildHeaders();
                int _h2 = await client.SendBytesAsync(head, head.Length);
                int blen = response.BodyLength();
                if (blen > 0) {
                    int _b2 = await client.SendBytesAsync(response.bodyBytes, blen);
                }
            } else {
                string responseData = response.Build();
                int _sent = await client.SendBytesAsync(responseData, responseData.Length);
            }
            response.Dispose();
            response = null;
            Worker.BumpSent();

            if (!keepAlive) {
                break;
            }
        }

        if (reject == 431) {
            HttpResponse big = HttpResponse.WithStatus(431,
                "Request Header Fields Too Large", "header block exceeds limit");
            big = big.SetKeepAlive(false);
            int _h = await client.SendAsync(big.Build());
        } else if (reject == 413) {
            HttpResponse tooLarge = HttpResponse.WithStatus(413, "Payload Too Large",
                "request exceeds limit");
            tooLarge = tooLarge.SetKeepAlive(false);
            int _s = await client.SendAsync(tooLarge.Build());
        } else if (reject == 400) {
            // 定界冲突/畸形长度：请求走私拒绝。必须关闭连接——
            // 缓冲区里可能还有伪装成下一条请求的剩余正文。
            HttpResponse bad = HttpResponse.WithStatus(400, "Bad Request",
                "malformed request framing");
            bad = bad.SetKeepAlive(false);
            int _b = await client.SendAsync(bad.Build());
        } else if (reject == 501) {
            HttpResponse nai = HttpResponse.WithStatus(501, "Not Implemented",
                "Transfer-Encoding is not supported");
            nai = nai.SetKeepAlive(false);
            int _n = await client.SendAsync(nai.Build());
        }

        return 0;
    }

    /// <summary>停止服务器。</summary>
    void Stop() {
        this.running = false;
        if (this.listener != null) {
            this.listener.Stop();
        }
    }

    /// <summary>返回当前活动连接数。</summary>
    int GetActiveConnections() {
        return this.activeConnections;
    }

    /// <summary>返回服务器是否正在运行。</summary>
    bool IsRunning() {
        return this.running;
    }
}

/// <summary>Arm 返回的截止时间句柄：记录槽位下标与 generation，供 Disarm 使用。</summary>
class HttpDeadlineToken {
    int slot;
    int generation;
    bool disarmed;

    /// <summary>token 记录槽位下标与创建时的 generation，
    /// 用于槽位复用后旧 token 不再误操作新连接。</summary>
    HttpDeadlineToken(int slot, int generation) {
        this.slot = slot;
        this.generation = generation;
        this.disarmed = false;
    }

    /// <summary>传输异常可能在到达显式清理点之前就把请求展开掉。
    /// 析构只是兜底；正常路径仍然显式 Disarm。Disarm 幂等，
    /// 两条路径都安全。</summary>
    ~HttpDeadlineToken() {
        // Backstop for an exception that unwinds past an explicit cleanup point.
        HttpDeadline.Disarm(this);
    }
}

/// <summary>槽位表中的一条：连接套接字、阶段/总截止时间与 generation。</summary>
class HttpDeadlineSlot {
    nint sock;
    long deadline;
    int generation;
    bool active;
    bool fired;
    long totalDeadline;

    /// <summary>新槽位：generation 从 1 起，槽位复用时递增。</summary>
    HttpDeadlineSlot(nint sock, long deadline) {
        this.sock = sock;
        this.deadline = deadline;
        this.generation = 1;
        this.active = true;
        this.fired = false;
        this.totalDeadline = 0;
    }
}

/// <summary>
/// 按连接管理的请求截止时间，由整个进程中的一个协程统一
/// 扫描。
///
/// 无法直接在 receive 上设置超时：连接协程
/// 停靠在 IO reactor 中，没有其他机制驱动它。因此每个连接
/// 注册一个截止时间槽位，单个扫描器每秒唤醒一次，对超时者
/// 执行挂断。这使每个请求只需 O(1) 开销（一次整数写入），
/// 整个进程一个协程，而非每个连接一个定时器协程。
///
/// 扫描器对套接字执行 shutdown 而非 close，因此等待中的
/// 协程会因读取到 0 字节被唤醒，沿正常断连路径
/// 展开（释放槽位）；若在此处直接关闭描述符，会卡住
/// 该协程并泄漏槽位。
///
/// 槽位表是进程级的，而连接协程可能跑在不同 worker 线程上
/// （<c>--async-workers</c>），因此每一处表访问都在
/// <c>lock (slots)</c> 里：否则 <see cref="Arm"/> 的 <c>slots.Add</c>
/// 会与另一个线程的 <c>slots[slot]</c> 同时发生，或两个连接
/// 从自由列表拿到同一个槽位。临界区里只有列表操作和
/// shutdown 系统调用，不包含 await。
/// </summary>
class HttpDeadline {
    static List<HttpDeadlineSlot> slots = new List<HttpDeadlineSlot>();
    static List<int> freeSlots = new List<int>();
    static bool sweeping = false;
    static int activeCount = 0;
    // 仅作扫描器的缓存；Touch 会先刷新它，不能使用上一次 sweep 的旧值。
    static long nowMs = 0;

    /// <summary>注册一个连接并返回带 generation 的 token；
    /// 截止时间被禁用（timeoutMs &lt;= 0）时返回 null。</summary>
    static HttpDeadlineToken Arm(nint sock, int timeoutMs) {
        return HttpDeadline.Arm(sock, timeoutMs, 0);
    }

    /// <summary>注册阶段 deadline，并可附带从 Arm 时刻起的 total budget。
    /// totalMs &lt;= 0 表示不设总预算。</summary>
    static HttpDeadlineToken Arm(nint sock, int timeoutMs, int totalMs) {
        if (timeoutMs <= 0 && totalMs <= 0) { return null; }
        lock (slots) {
            nowMs = Stopwatch.GetMilliseconds();
            int phase = timeoutMs;
            if (phase <= 0) { phase = totalMs; }
            if (totalMs > 0 && phase > totalMs) { phase = totalMs; }
            int slot;
            int n = freeSlots.Count;
            if (n > 0) {
                slot = freeSlots[n - 1];
                freeSlots.RemoveAt(n - 1);
                HttpDeadlineSlot old = slots[slot];
                old.generation = old.generation + 1;
                if (old.generation <= 0) { old.generation = 1; }
                old.sock = sock;
                old.deadline = nowMs + phase;
                old.fired = false;
                old.active = true;
                old.totalDeadline = totalMs > 0 ? nowMs + totalMs : 0;
            } else {
                slots.Add(new HttpDeadlineSlot(sock, nowMs + phase));
                if (totalMs > 0) { slots[slots.Count - 1].totalDeadline = nowMs + totalMs; }
                slot = slots.Count - 1;
            }
            activeCount = activeCount + 1;
            HttpDeadlineToken token = new HttpDeadlineToken(slot,
                slots[slot].generation);
            if (!sweeping) {
                // sweeping 只在锁内读写；StopSweeping 在发现新连接时会
                // 重新启动扫描器，避免最后一次 sweep 与 Arm 之间丢唤醒。
                sweeping = true;
                Task.Spawn(HttpDeadline.Sweep());
            }
            return token;
        }
    }

    /// <summary>为 token 重启阶段窗口。阶段预算为非正值时仍保留
    /// total deadline；不能因为关闭某一阶段而把总截止时间一并关闭。</summary>
    static void Touch(HttpDeadlineToken token, int timeoutMs) {
        if (token == null || token.disarmed) { return; }
        lock (slots) {
            if (token.disarmed || token.slot < 0 || token.slot >= slots.Count) { return; }
            HttpDeadlineSlot slot = slots[token.slot];
            if (!slot.active || slot.generation != token.generation) { return; }
            // Sweep 已经触发时不能被阶段切换重新武装；否则发送阶段
            // 的超时可能在 await 返回后被 Touch 清掉。
            if (slot.fired) { return; }
            nowMs = Stopwatch.GetMilliseconds();
            // 在扫描器尚未轮到本槽位时也要观察到过期，避免一次迟到的
            // 收包把已经耗尽的窗口重新推到未来。
            if (nowMs >= slot.deadline) {
                slot.deadline = nowMs + 3600000;
                slot.fired = true;
                Socket.ShutdownBoth(slot.sock);
                return;
            }
            long next = 0;
            if (timeoutMs > 0) { next = nowMs + timeoutMs; }
            if (slot.totalDeadline > 0
                && (next <= 0 || next > slot.totalDeadline)) {
                next = slot.totalDeadline;
            }
            if (next <= 0) { return; }
            slot.deadline = next;
            slot.fired = false;
        }
    }

    /// <summary>当扫描器已对 token 执行挂断时返回 true。
    /// 必须在 Disarm 前查询。</summary>
    static bool Expired(HttpDeadlineToken token) {
        if (token == null || token.disarmed) { return false; }
        lock (slots) {
            if (token.disarmed || token.slot < 0 || token.slot >= slots.Count) { return false; }
            HttpDeadlineSlot slot = slots[token.slot];
            return slot.active && slot.generation == token.generation && slot.fired;
        }
    }

    /// <summary>连接结束时释放 token；重复释放安全，旧 token 不能释放新连接。</summary>
    static void Disarm(HttpDeadlineToken token) {
        if (token == null) { return; }
        lock (slots) {
            if (token.disarmed) { return; }
            token.disarmed = true;
            if (token.slot < 0 || token.slot >= slots.Count) { return; }
            HttpDeadlineSlot slot = slots[token.slot];
            if (!slot.active || slot.generation != token.generation) { return; }
            slot.active = false;
            slot.sock = -1;
            slot.fired = false;
            activeCount = activeCount - 1;
            freeSlots.Add(token.slot);
        }
    }

    /// <summary>单次扫描：刷新粗粒度时钟并对过期连接执行挂断
    /// （shutdown 而非 close，见类文档）。返回是否仍有活动 token。</summary>
    static bool SweepOnce() {
        lock (slots) {
            nowMs = Stopwatch.GetMilliseconds();
            int n = slots.Count;
            for (int i = 0; i < n; i = i + 1) {
                HttpDeadlineSlot slot = slots[i];
                nint s = slot.sock;
                if (slot.active && s >= 0 && nowMs >= slot.deadline && !slot.fired) {
                    // fired 保持到归属者查询/Disarm；generation 防止旧 token
                    // 在槽位复用后误触碰新连接。
                    slot.deadline = nowMs + 3600000;
                    slot.fired = true;
                    Socket.ShutdownBoth(s);
                }
            }
            return activeCount > 0;
        }
    }

    /// <summary>每秒扫描一次的常驻协程；只在有活动 token 时存活。
    /// SweepOnce 返回 false 后仍需在锁内再确认一次 activeCount，
    /// 避免 Arm 与扫描器退出之间丢失唤醒。</summary>
    static async void Sweep() {
        while (true) {
            await Task.Delay(1000);
            bool live = HttpDeadline.SweepOnce();
            if (live) { continue; }
            lock (slots) {
                if (activeCount > 0) { continue; }
                sweeping = false;
                return;
            }
        }
    }
}


/// <summary>一条已注册的路由：method + path + 静态响应体，作为一个
/// 整体保存，而非三个索引对齐的并行列表。</summary>
class HttpRoute {
    string method;
    string path;
    string response;

    /// <summary>私有构造：由 HttpRouter 的注册方法创建。</summary>
    HttpRoute(string method, string path, string response) {
        this.method = method;
        this.path = path;
        this.response = response;
    }
}

/// <summary>
/// 简单的 HTTP 路由器，用于将路径映射到处理器。
/// </summary>
class HttpRouter {
    List<HttpRoute> routes;

    /// <summary>创建空路由表。</summary>
    HttpRouter() {
        this.routes = new List<HttpRoute>();
    }

    /// <summary>注册一条 GET 路由。</summary>
    HttpRouter Get(string path, string responseBody) {
        this.routes.Add(new HttpRoute("GET", path, responseBody));
        return this;
    }

    /// <summary>注册一条 POST 路由。</summary>
    HttpRouter Post(string path, string responseBody) {
        this.routes.Add(new HttpRoute("POST", path, responseBody));
        return this;
    }

    /// <summary>注册适用于任意方法的路由。</summary>
    HttpRouter Route(string method, string path, string responseBody) {
        this.routes.Add(new HttpRoute(method, path, responseBody));
        return this;
    }

    /// <summary>将请求匹配到已注册的路由。</summary>
    HttpResponse Match(HttpRequest request) {
        foreach (HttpRoute r in this.routes) {
            if (r.path == request.path) {
                if (r.method == request.method || r.method == "*") {
                    return HttpResponse.Ok(r.response);
                }
            }
        }
        return HttpResponse.NotFound();
    }
}
