using System;
using System.IO;
using System.IO.Compression;
using System.Threading;
using System.Net.Sockets;
using System.Net.Http.Client;
using System.Security.Cryptography;

namespace System.Net.Http.Download;

/// <summary>条目自己的安装步骤（在工作线程上、Extract 阶段调用）：归档
/// 布局有讲究的调用方用它替掉按扩展名的默认解压。见
/// <see cref="DownloadItem.WithInstaller"/>。</summary>
delegate bool DownloadInstallFn(DownloadItem it);

/// <summary>任务开跑前在工作线程上补齐条目（可以联网：CEF 要先拉索引
/// 才知道该下哪个归档）。返回 false = 准备失败，任务以失败收工。见
/// <see cref="DownloadJob.SetPrepare"/>。</summary>
delegate bool DownloadPrepareFn(DownloadJob job);

/// <summary>下载任务的阶段码。
/// <see cref="Gui.Component.Downloader.DownloadDialog"/> 把它翻成一行
/// 提示文字，无界面的调用方用它判断结局。</summary>
class DownloadStage {
    static const int Idle = 0;
    static const int Download = 1;
    static const int Verify = 2;
    static const int Extract = 3;
    static const int Done = 4;
    static const int Failed = 5;
    static const int Cancelled = 6;

    /// <summary>阶段的中文提示；宿主自己管界面语言时不用它，直接按阶段码
    /// 出自己的文案。</summary>
    static string Text(int stage) {
        if (stage == DownloadStage.Download) { return "正在下载"; }
        if (stage == DownloadStage.Verify) { return "正在校验"; }
        if (stage == DownloadStage.Extract) { return "正在解压安装"; }
        if (stage == DownloadStage.Done) { return "已完成"; }
        if (stage == DownloadStage.Failed) { return "失败"; }
        if (stage == DownloadStage.Cancelled) { return "已取消"; }
        return "准备中";
    }
}

/// <summary>要下载的一个文件：源地址、落盘路径，以及可选的 SHA-1
/// 校验与解压目标。<see cref="DownloadJob"/> 按加入顺序逐个处理。</summary>
class DownloadItem {
    string host;
    int port;
    bool tls;
    /// 请求行里的路径（含查询串），如 "/app/plus2.exe"。
    string path;
    /// 界面上显示的名字，默认取 URL 的最后一段。
    string name;
    /// 落盘路径（断点续传就以这个文件已有的字节数为断点）。
    string localPath;
    /// 期望的 SHA-1（40 位十六进制），"" = 不校验。
    string sha1;
    /// 期望的字节数，0 = 未知（只影响总体百分比的估算）。
    long size;
    /// 解压/安装目标目录，"" = 下载完就算完。
    string extractTo;
    /// 自定义安装步骤，null = 按扩展名走默认解压。
    DownloadInstallFn installer;

    DownloadItem() {
        this.host = "";
        this.port = 443;
        this.tls = true;
        this.path = "/";
        this.name = "";
        this.localPath = "";
        this.sha1 = "";
        this.size = 0;
        this.extractTo = "";
        this.installer = null;
    }

    /// <summary>从 `http(s)://host[:port]/path` 建一个条目；URL 解析不出
    /// 主机时返回 null。</summary>
    static DownloadItem FromUrl(string url, string localPath) {
        DownloadItem it = new DownloadItem();
        if (!it.SetUrl(url)) { return null; }
        it.localPath = localPath;
        return it;
    }

    /// <summary>解析 URL 到 host/port/tls/path，成功返回 true。</summary>
    bool SetUrl(string url) {
        string u = url;
        if (u.Length >= 8 && u.Substring(0, 8) == "https://") {
            u = u.Substring(8, u.Length - 8);
            this.tls = true;
            this.port = 443;
        } else if (u.Length >= 7 && u.Substring(0, 7) == "http://") {
            u = u.Substring(7, u.Length - 7);
            this.tls = false;
            this.port = 80;
        } else {
            return false;
        }
        int slash = u.IndexOf("/");
        string hostport = u;
        string p = "/";
        if (slash >= 0) {
            hostport = u.Substring(0, slash);
            p = u.Substring(slash, u.Length - slash);
        }
        int colon = hostport.IndexOf(":");
        if (colon >= 0) {
            string ps = hostport.Substring(colon + 1, hostport.Length - colon - 1);
            this.port = Convert.ToInt32(ps);
            hostport = hostport.Substring(0, colon);
        }
        if (hostport.Length == 0) { return false; }
        this.host = hostport;
        this.path = p;
        if (this.name == "") { this.name = DownloadItem.LastSegment(p); }
        return true;
    }

    /// <summary>要校验的 SHA-1（40 位十六进制）；可链式调用。</summary>
    DownloadItem WithSha1(string hex) {
        this.sha1 = hex.ToLower();
        return this;
    }

    /// <summary>期望的字节数，用于在第一块正文到达前就给出总体进度。
    /// 可链式调用。</summary>
    DownloadItem WithSize(long bytes) {
        this.size = bytes;
        return this;
    }

    /// <summary>下载完成后解压/安装到 <paramref name="dir"/>：归档类型按
    /// 落盘文件的扩展名判定（.tar.bz2 / .tbz2 / .tar / .zip），其余扩展名
    /// 直接把文件复制过去。可链式调用。</summary>
    DownloadItem WithExtractTo(string dir) {
        this.extractTo = dir;
        return this;
    }

    /// <summary>下载完成后由 <paramref name="fn"/> 安装，而不是按扩展名
    /// 解压（归档里要剥顶层目录、要打就绪标记之类的，交给调用方自己做）。
    /// 可链式调用。</summary>
    DownloadItem WithInstaller(DownloadInstallFn fn) {
        this.installer = fn;
        return this;
    }

    /// <summary>界面上显示的名字；可链式调用。</summary>
    DownloadItem WithName(string n) {
        this.name = n;
        return this;
    }

    /// <summary>落盘路径（自定义安装步骤要用它找下好的文件）。</summary>
    string LocalPath() { return this.localPath; }

    /// <summary>界面上显示的名字。</summary>
    string Name() { return this.name; }

    /// <summary>解压/安装目标目录，"" = 没有。</summary>
    string ExtractTo() { return this.extractTo; }

    /// <summary>HttpClient 写进度用的伴生文件。</summary>
    string ProgressFile() {
        return this.localPath + ".progress";
    }

    static string LastSegment(string p) {
        int at = 0 - 1;
        for (int i = 0; i < p.Length; i = i + 1) {
            if ((p[i] & 255) == 47) { at = i; }
        }
        if (at < 0) { return p; }
        return p.Substring(at + 1, p.Length - at - 1);
    }
}

/// <summary>一批文件的下载 + 校验 + 解压安装，跑在自己的工作线程上。
///
/// 界面无关（所以它在 System 下、不在 Gui 下：无界面的调用方不必因此
/// 拖上 GUI 驱动）：<see cref="Gui.Component.Downloader.DownloadDialog"/>
/// 只是它的一个观察者，命令行更新器和后台自更新可以直接用它（<c>Start()</c> 之后轮询
/// <see cref="Running"/> / <see cref="Stage"/>）。传输本身复用
/// <see cref="HttpClient.DownloadBinaryToFileAsync"/>，因此断点续传、
/// Range、超时的语义与别处一致。
///
/// 线程分工与 AiNet 一致：<c>Thread.Start</c> 收的是非捕获委托，所以任务
/// 对象经一个受锁保护的队列交给 worker；worker 只写阶段/序号/当前文件名/
/// 错误（受同一把锁），GUI 线程每帧读一次。单个文件的字节进度不走锁：
/// HttpClient 把 "已收/总计" 写进伴生进度文件，读的那一侧（GUI 或
/// <see cref="Poll"/> 的调用方）自己去读，因此外部下载器也能驱动同一个
/// 窗口。取消走一个原子标志：装到 HttpClient 上的探针在每块正文之后读它，
/// 因此一个 160 MB 的下载也能立刻收工，已落盘的字节留着下次续传。</summary>
class DownloadJob {
    /// 正在跑的任务（同一时刻只驱动一个：更新器天然是串行的）。
    static DownloadJob sCur;
    /// 交给 worker 但还没被领走的任务，以及保护它和共享状态的锁。
    static List<DownloadJob> sPend;
    #if WINDOWS
    static nint sLock;
    #else
    static string sLock;
    #endif
    /// 取消标志。原子而非受锁，因为 HttpClient 的探针每 64 KB 问一次。
    static AtomicInt sCancel;

    List<DownloadItem> items;
    /// 开跑前补齐条目的回调，null = 条目已经齐了。
    DownloadPrepareFn prepare;
    // ---- 共享状态（worker 写，读者在锁下取快照）----
    int stage;
    int index;
    string current;
    string error;
    /// 最近一次传输失败的阶段诊断，由 FetchAsync 从 HttpClient 转存。
    string downloadError;
    /// SetFail 把 stage 改成 Failed 前保存的阶段，供调用方判断失败类型。
    int failedStage;
    bool running;
    // ---- 只有读者动的字段（由 Poll 从进度文件刷新）----
    long got;
    long total;

    DownloadJob() {
        this.items = new List<DownloadItem>();
        this.prepare = null;
        this.stage = DownloadStage.Idle;
        this.index = 0;
        this.current = "";
        this.error = "";
        this.downloadError = "";
        this.failedStage = DownloadStage.Idle;
        this.running = false;
        this.got = 0;
        this.total = 0;
    }

    static void EnsureShared() {
        if (DownloadJob.sPend == null) {
            DownloadJob.sPend = new List<DownloadJob>();
            DownloadJob.sLock = Mutex.Create();
            DownloadJob.sCancel = new AtomicInt(0);
        }
    }

    static void Lock() {
        DownloadJob.EnsureShared();
        Mutex.Lock(DownloadJob.sLock);
    }

    static void Unlock() {
        Mutex.Unlock(DownloadJob.sLock);
    }

    /// <summary>加入一个待下载条目（<c>Start()</c> 之前）。</summary>
    DownloadJob Add(DownloadItem it) {
        if (it != null) { this.items.Add(it); }
        return this;
    }

    /// <summary>把「有哪些文件要下」的决定推迟到工作线程上：<c>Start()</c>
    /// 之后、第一个条目开跑之前调用 <paramref name="fn"/>，它在里面
    /// <c>Add</c>（可以先联网问）。设了它，<c>Start()</c> 就允许条目为空。
    /// </summary>
    DownloadJob SetPrepare(DownloadPrepareFn fn) {
        this.prepare = fn;
        return this;
    }

    /// <summary>条目数。</summary>
    int Count() {
        return this.items.Count;
    }

    DownloadItem ItemAt(int i) {
        if (i < 0 || i >= this.items.Count) { return null; }
        return this.items[i];
    }

    /// <summary>在工作线程上开始处理。返回 false = 线程起不来（此时任务
    /// 状态为失败，原因见 <see cref="Error"/>）。</summary>
    bool Start() {
        DownloadJob.EnsureShared();
        DownloadJob.Lock();
        this.stage = DownloadStage.Idle;
        this.failedStage = DownloadStage.Idle;
        this.downloadError = "";
        DownloadJob.Unlock();
        if (this.items.Count == 0 && this.prepare == null) {
            this.SetFail("没有要下载的文件");
            return false;
        }
        // 单任务语义是被强制的、而不是靠调用方自觉：取消标志和 worker 队列
        // 是进程级的，两个任务同时跑会互相取消。
        if (DownloadJob.sCur != null && DownloadJob.sCur.Running()) {
            this.SetFail("已有下载任务在运行");
            return false;
        }
        DownloadJob.sCancel.Store(0);
        DownloadJob.Lock();
        this.stage = DownloadStage.Idle;
        this.index = 0;
        this.current = "";
        if (this.items.Count > 0) {
            this.stage = DownloadStage.Download;
            this.current = this.items[0].name;
        }
        this.error = "";
        this.running = true;
        DownloadJob.sCur = this;
        DownloadJob.sPend.Add(this);
        DownloadJob.Unlock();
        if (!Thread.Start(DownloadJob.Worker)) {
            DownloadJob _drop = DownloadJob.Take();
            this.SetFail("无法启动下载线程");
            return false;
        }
        return true;
    }

    /// <summary>请求取消：下载在下一块正文的边界退出，已下载的部分留着
    /// 续传。不强杀线程，因此调用后任务还会“运行”一小会儿。</summary>
    void Cancel() {
        DownloadJob.EnsureShared();
        DownloadJob.sCancel.Store(1);
    }

    /// <summary>HttpClient 的取消探针（装到客户端上的那个静态委托）。
    /// </summary>
    static bool CancelRequested() {
        if (DownloadJob.sCancel == null) { return false; }
        return DownloadJob.sCancel.Load() != 0;
    }

    /// <summary>worker 线程入口：领一个任务并驱动到底。</summary>
    static void Worker() {
        DownloadJob job = DownloadJob.Take();
        if (job == null) { return; }
        DownloadJob.Drive(job);
    }

    /// <summary>领走一个排队的任务（别的 worker 已经领走时返回 null）。
    /// </summary>
    static DownloadJob Take() {
        DownloadJob.Lock();
        DownloadJob job = null;
        if (DownloadJob.sPend.Count > 0) {
            job = DownloadJob.sPend[0];
            DownloadJob.sPend.RemoveAt(0);
        }
        DownloadJob.Unlock();
        return job;
    }

    /// <summary>整个任务在工作线程上的主体。每个条目：下载 → 校验 →
    /// 解压安装。任何一步失败就带着原因收工，后面的条目不再处理。
    /// </summary>
    static void Drive(DownloadJob job) {
        Socket.Initialize();
        if (job.prepare != null) {
            bool ready = false;
            try {
                ready = job.prepare(job);
            } catch (Exception ex) {
                job.SetFail("准备下载失败：" + ex.Message);
                job.Finish();
                return;
            }
            if (!ready) {
                if (job.Stage() != DownloadStage.Failed) {
                    job.SetFail("准备下载失败");
                }
                job.Finish();
                return;
            }
            if (job.items.Count == 0) {
                // 准备阶段发现无事可做（例如已经装好了）：算成功。
                job.SetStage(DownloadStage.Done);
                job.Finish();
                return;
            }
        }
        for (int i = 0; i < job.items.Count; i = i + 1) {
            if (DownloadJob.CancelRequested()) {
                job.SetStage(DownloadStage.Cancelled);
                job.SetError("下载已取消");
                job.Finish();
                return;
            }
            DownloadItem it = job.items[i];
            job.Begin(i, it);
            long n = 0 - 1;
            // 传输里任何一处抛出（DNS、TLS、断开的套接字）都必须变成一条
            // 可读的错误：不接住的话 worker 静静死掉，界面会一直等下去。
            try {
                n = await job.FetchAsync(it);
            } catch (Exception ex) {
                string detail = job.downloadError;
                if (detail == "") { detail = ex.Message; }
                job.SetFail("下载 " + it.name + " 失败：" + detail);
                job.Finish();
                return;
            }
            if (n == 0 - 2) {
                job.SetStage(DownloadStage.Cancelled);
                job.SetError("下载已取消");
                job.Finish();
                return;
            }
            if (n <= 0) {
                string detail2 = job.downloadError;
                if (detail2 == "") { detail2 = "未知下载阶段"; }
                job.SetFail("下载 " + it.name + " 失败（传输返回 "
                    + Convert.ToString(n) + "，下载阶段：" + detail2 + "）");
                job.Finish();
                return;
            }
            if (it.sha1 != "") {
                job.SetStage(DownloadStage.Verify);
                if (!Sha1.VerifyFile(it.localPath, it.sha1)) {
                    // 半截或损坏的文件留着只会让下一次续传接到坏字节上。
                    File.Delete(it.localPath);
                    job.SetFail(it.name + " 校验失败（SHA-1 不符）");
                    job.Finish();
                    return;
                }
            }
            if (it.extractTo != "" || it.installer != null) {
                job.SetStage(DownloadStage.Extract);
                if (!DownloadJob.Install(it)) {
                    job.SetFail("解压安装 " + it.name + " 失败");
                    job.Finish();
                    return;
                }
            }
            // 条目彻底做完了，伴生进度文件没用了：留着就是在用户的目标
            // 目录里堆垃圾（取消/失败时要留着，续传还得靠它报进度）。
            File.Delete(it.ProgressFile());
        }
        job.SetStage(DownloadStage.Done);
        job.Finish();
    }

    /// <summary>一个条目的传输，断点续传由 HttpClient 负责。</summary>
    async long FetchAsync(DownloadItem it) {
        Directory.CreateDirectoryRecursive(DownloadJob.ParentDir(it.localPath));
        HttpClient cli;
        if (it.tls) { cli = HttpClient.CreateHttps(it.host, it.port); }
        else { cli = new HttpClient(it.host, it.port); }
        cli.SetTimeout(120000);
        cli.SetCancelProbe(DownloadJob.CancelRequested);
        this.downloadError = "";
        try {
            long n = await cli.DownloadBinaryToFileAsync(it.path, it.localPath,
                it.ProgressFile());
            if (n <= 0) { this.downloadError = cli.LastDownloadError(); }
            return n;
        } catch (Exception ex) {
            this.downloadError = cli.LastDownloadError();
            if (this.downloadError == "") { this.downloadError = ex.Message; }
            throw ex;
        }
    }

    /// <summary>把下载好的文件安装到 <c>extractTo</c>：归档按扩展名解开，
    /// 其余扩展名直接复制过去。</summary>
    static bool Install(DownloadItem it) {
        if (it.installer != null) { return it.installer(it); }
        string dst = it.extractTo;
        Directory.CreateDirectoryRecursive(dst);
        string low = it.localPath.ToLower();
        if (low.EndsWith(".tar.bz2") || low.EndsWith(".tbz2")) {
            string tar = it.localPath + ".tar";
            if (!BZip2.DecompressFile(it.localPath, tar)) {
                File.Delete(tar);
                return false;
            }
            int n = Tar.ExtractFile(tar, dst);
            File.Delete(tar);
            return n > 0;
        }
        if (low.EndsWith(".tar")) {
            return Tar.ExtractFile(it.localPath, dst) > 0;
        }
        if (low.EndsWith(".zip")) {
            return Zip.ExtractToDirectory(it.localPath, dst) > 0;
        }
        File.Copy(it.localPath, dst + "/" + DownloadItem.LastSegment(it.localPath));
        return true;
    }

    // ---- 状态：worker 写 ------------------------------------------------

    void Begin(int i, DownloadItem it) {
        DownloadJob.Lock();
        this.index = i;
        this.current = it.name;
        this.stage = DownloadStage.Download;
        DownloadJob.Unlock();
    }

    void SetStage(int s) {
        DownloadJob.Lock();
        this.stage = s;
        DownloadJob.Unlock();
    }

    void SetFail(string msg) {
        DownloadJob.Lock();
        this.failedStage = this.stage;
        this.stage = DownloadStage.Failed;
        this.error = msg;
        DownloadJob.Unlock();
    }

    void SetError(string msg) {
        DownloadJob.Lock();
        this.error = msg;
        DownloadJob.Unlock();
    }

    void Finish() {
        DownloadJob.Lock();
        this.running = false;
        DownloadJob.Unlock();
    }

    // ---- 状态：读者读 --------------------------------------------------

    /// <summary>任务是否还在跑（worker 线程尚未收工）。</summary>
    bool Running() {
        DownloadJob.Lock();
        bool v = this.running;
        DownloadJob.Unlock();
        return v;
    }

    /// <summary>当前阶段（见 <see cref="DownloadStage"/>）。</summary>
    int Stage() {
        DownloadJob.Lock();
        int v = this.stage;
        DownloadJob.Unlock();
        return v;
    }

    /// <summary>失败前所处的阶段；非 Failed 状态时通常为 Idle。</summary>
    int FailedStage() {
        DownloadJob.Lock();
        int v = this.failedStage;
        DownloadJob.Unlock();
        return v;
    }

    /// <summary>失败原因，未失败时 ""。</summary>
    string Error() {
        DownloadJob.Lock();
        string v = this.error;
        DownloadJob.Unlock();
        return v;
    }

    /// <summary>正在处理的条目名（界面上的“下载文件”那一行）。</summary>
    string Current() {
        DownloadJob.Lock();
        string v = this.current;
        DownloadJob.Unlock();
        return v;
    }

    /// <summary>正在处理的条目序号（0 起）。</summary>
    int Index() {
        DownloadJob.Lock();
        int v = this.index;
        DownloadJob.Unlock();
        return v;
    }

    /// <summary>已完成的条目数：跑完时就是全部。</summary>
    int DoneCount() {
        int st = this.Stage();
        if (st == DownloadStage.Done) { return this.items.Count; }
        return this.Index();
    }

    /// <summary>成功收工。</summary>
    bool Succeeded() {
        return this.Stage() == DownloadStage.Done;
    }

    /// <summary>从当前条目的伴生进度文件刷新字节进度。读者（界面每帧、
    /// 或命令行的轮询循环）调用；worker 正阻塞在传输里，读文件的活只能
    /// 由读者做。</summary>
    void Poll() {
        DownloadItem it = this.ItemAt(this.Index());
        if (it == null) { return; }
        string p = it.ProgressFile();
        if (!File.Exists(p)) { return; }
        string text = File.ReadAllText(p).Trim();
        int slash = text.IndexOf("/");
        if (slash <= 0) { return; }
        this.got = Convert.ToInt64(text.Substring(0, slash));
        this.total = Convert.ToInt64(text.Substring(slash + 1,
            text.Length - slash - 1));
        if (this.total <= 0 && it.size > 0) { this.total = it.size; }
    }

    /// <summary>当前条目已收到的字节数（<see cref="Poll"/> 后有效）。
    /// </summary>
    long Got() { return this.got; }

    /// <summary>当前条目的总字节数，未知时 0。</summary>
    long Total() { return this.total; }

    /// <summary>当前条目的百分比（总量未知时按 0 报）。</summary>
    int ItemPercent() {
        int st = this.Stage();
        if (st == DownloadStage.Done) { return 100; }
        if (this.total <= 0) { return 0; }
        long pct = this.got * 100 / this.total;
        if (pct > 100) { pct = 100; }
        if (pct < 0) { pct = 0; }
        return (int)pct;
    }

    /// <summary>整个任务的百分比：已完成的条目算满，当前条目按其自身
    /// 百分比折算。条目大小差得多时这只是个估算，但和界面上
    /// “n/m 个文件”对得上，比按字节算更不容易让人误解。</summary>
    int TotalPercent() {
        int n = this.items.Count;
        if (n <= 0) { return 0; }
        if (this.Stage() == DownloadStage.Done) { return 100; }
        int done = this.Index();
        int pct = (done * 100 + this.ItemPercent()) / n;
        if (pct > 100) { pct = 100; }
        return pct;
    }

    /// <summary>把字节数写成人看的样子（"162.8 MB"）。</summary>
    static string Human(long bytes) {
        if (bytes < 0) { return "-"; }
        if (bytes < 1024) { return Convert.ToString(bytes) + " B"; }
        if (bytes < 1048576) { return DownloadJob.Tenths(bytes * 10 / 1024) + " KB"; }
        if (bytes < 1073741824) {
            return DownloadJob.Tenths(bytes * 10 / 1048576) + " MB";
        }
        return DownloadJob.Tenths(bytes * 10 / 1073741824) + " GB";
    }

    /// <summary>十倍定点数写成一位小数。</summary>
    static string Tenths(long tenths) {
        long whole = tenths / 10;
        long frac = tenths - whole * 10;
        return Convert.ToString(whole) + "." + Convert.ToString(frac);
    }

    static string ParentDir(string path) {
        int at = 0 - 1;
        for (int i = 0; i < path.Length; i = i + 1) {
            int c = path[i] & 255;
            if (c == 47 || c == 92) { at = i; }
        }
        if (at <= 0) { return "."; }
        return path.Substring(0, at);
    }
}
