using System;
using System.Text;

namespace System.Net.Http;

/// <summary>
/// HTTP 请求的表示与解析器。
/// 从 TCP 数据解析原始 HTTP/1.1 请求。
/// </summary>
class HttpRequest {
    string method;
    string path;
    string version;
    string body;
    string rawHeaders;
    string queryString;
    string host;
    string contentType;
    // 解析时顺带捕获的两个请求级头部。头部块的每次按名查找都要重扫
    // 一遍整块字节，而这两个头部是服务器每个请求都要问的（认证：
    // Authorization / 会话 cookie），所以和 host/contentType 一样在
    // 唯一的那次扫描里就取出来，GetHeader 直接命中。
    string authorization;
    string cookie;
    int contentLength;
    bool keepAlive;
    // 正文的真实字节数。字符串以 NUL 结尾，body.Length 只数到第一个
    // NUL，二进制请求体（上传、protobuf、压缩内容）会因此被截断，
    // 所以长度单独记录，凡按长度处理正文的地方都用它。
    int bodyLength;
    // 请求体采用分块传输编码（Transfer-Encoding: chunked）。头部解析
    // 只负责识别它：解码要读取头部之后的字节，是连接循环
    // （HttpFramer）的职责。
    bool chunked;
    // 头部块结束之后的字节下标，即正文首字节在 raw 中的位置。
    // 流水线连接上其后的字节是"本请求正文 + 下一条请求"，只有按
    // contentLength 精确切分才不会把下一条请求吞进正文。
    int bodyStart;
    // 请求定界/头部解析失败的原因（HTTP 状态码；0 = 正常）。
    // 服务器在信任 contentLength 切分正文之前必须检查它——
    // 回绕的 Content-Length、重复且不一致的 Content-Length、
    // 未实现的 Transfer-Encoding 都是请求走私的入口。
    int parseStatus;

    HttpRequest() {
        this.method = "";
        this.path = "";
        this.version = "HTTP/1.1";
        this.body = "";
        this.rawHeaders = "";
        this.queryString = "";
        this.host = "";
        this.contentType = "";
        this.authorization = "";
        this.cookie = "";
        this.contentLength = 0;
        this.keepAlive = true;
        this.bodyLength = 0;
        this.chunked = false;
        this.bodyStart = 0;
        this.parseStatus = 0;
    }

    static bool IsOws(int c) {
        return c == 32 || c == 9;
    }

    // [start, stop) 去掉 RFC 7230 OWS（SP / HTAB）。
    static int TrimOwsStart(string raw, int start, int stop) {
        while (start < stop && HttpRequest.IsOws(raw[start] & 255)) {
            start = start + 1;
        }
        return start;
    }

    static int TrimOwsStop(string raw, int start, int stop) {
        while (stop > start && HttpRequest.IsOws(raw[stop - 1] & 255)) {
            stop = stop - 1;
        }
        return stop;
    }

    // Transfer-Encoding 是逗号分隔的 token 列表；只有最后一个 token
    // 为 chunked 时才可由 HttpFramer 解码。token 之间的 OWS 合法，
    // 其它编码不被静默忽略，避免把未定界的字节当成下一条请求。
    static bool FinalTransferChunked(string raw, int start, int stop) {
        int p = start;
        bool any = false;
        bool finalChunked = false;
        while (p < stop) {
            p = HttpRequest.TrimOwsStart(raw, p, stop);
            if (p >= stop) { return false; }
            int e = p;
            while (e < stop && (raw[e] & 255) != 44) { e = e + 1; }
            int t = HttpRequest.TrimOwsStop(raw, p, e);
            if (t <= p) { return false; }
            int semi = p;
            while (semi < t && (raw[semi] & 255) != 59) { semi = semi + 1; }
            // transfer-coding parameters are allowed after ';'; the coding
            // token itself must still be a valid non-empty token.
            int codingStop = HttpRequest.TrimOwsStop(raw, p, semi);
            if (codingStop <= p) { return false; }
            bool isChunked = HttpRequest.RegionIs(raw, p, codingStop, "chunked");
            finalChunked = isChunked;
            any = true;
            p = e + 1;
        }
        return any && finalChunked;
    }

    /// <summary>把原始 HTTP 请求字符串解析为 HttpRequest。
    ///
    /// 按字节下标扫描（<c>raw[i] &amp; 255</c>），而不是
    /// <c>raw.Substring(i, 1)</c>。后者每检查一个字节都会在堆上分配一个
    /// 单字符字符串，因此旧解析器每个请求要做 O(请求大小) 次分配；
    /// 本实现原地遍历缓冲区，只分配
    /// 实际提取的那几个字段。</summary>
    static HttpRequest Parse(string raw) {
        return HttpRequest.Parse(raw, raw.Length);
    }

    /// <summary>把 <paramref name="raw"/> 开头的 <paramref name="rawLen"/>
    /// 个字节解析为请求。字节数由调用方给出：连接循环从套接字
    /// 得到的是精确计数，而 <c>raw.Length</c> 会在正文的第一个 NUL
    /// 处停下，据此切分正文会把二进制上传截断。</summary>
    static HttpRequest Parse(string raw, int rawLen) {
        HttpRequest req = new HttpRequest();
        int len = rawLen;
        if (len < 0) { len = 0; }
        if (len == 0) { return req; }

        // 请求行：扫描到 '\n'，再去掉末尾的 '\r'。
        int lineEnd = 0;
        for (; lineEnd < len && (raw[lineEnd] & 255) != 10; lineEnd = lineEnd + 1) {
        }
        int rlEnd = lineEnd;
        if (rlEnd > 0 && (raw[rlEnd - 1] & 255) == 13) { rlEnd = rlEnd - 1; }

        // 解析：METHOD 1*(SP/HTAB) request-target 1*(SP/HTAB) VERSION。
        int sp1 = 0;
        while (sp1 < rlEnd && !HttpRequest.IsOws(raw[sp1] & 255)) {
            sp1 = sp1 + 1;
        }
        req.method = raw.Substring(0, sp1);
        int pathStart = HttpRequest.TrimOwsStart(raw, sp1, rlEnd);
        int sp2 = pathStart;
        while (sp2 < rlEnd && !HttpRequest.IsOws(raw[sp2] & 255)) {
            sp2 = sp2 + 1;
        }
        int pathEnd = sp2;
        int versionStart = HttpRequest.TrimOwsStart(raw, sp2, rlEnd);
        if (versionStart < rlEnd) {
            req.version = raw.Substring(versionStart, rlEnd - versionStart);
        } else {
            req.parseStatus = 400;
        }
        if (req.method.Length == 0 || pathStart >= pathEnd) {
            req.parseStatus = 400;
        }

        // 拆分路径和查询字符串
        int qmark = pathStart;
        bool foundQ = false;
        while (qmark < pathEnd) {
            if ((raw[qmark] & 255) == 63) {
                foundQ = true;
                break;
            }
            qmark = qmark + 1;
        }
        if (foundQ) {
            req.path = raw.Substring(pathStart, qmark - pathStart);
            req.queryString = raw.Substring(qmark + 1, pathEnd - qmark - 1);
        } else {
            req.path = raw.Substring(pathStart, pathEnd - pathStart);
        }

        // 原地解析头部：常见字段按字节
        // （大小写不敏感）与缓冲区匹配，rawHeaders 是整个区块的
        // 一个切片——不按行或按名称/值分配内存。
        int pos = lineEnd + 1;
        int headersStart = pos;
        int headersStop = pos;
        // 定界状态：Content-Length 用 64 位累加并检查溢出，
        // 重复出现必须一致，Transfer-Encoding 绝不静默忽略
        //（见各分支）——这三者是请求走私（RFC 7230 §3.3.2/§3.3.3）
        // 的入口，一旦发现立即置 parseStatus，服务器据此拒绝。
        long clAcc = 0;
        bool clSeen = false;
        long firstCl = 0;
        bool teSeen = false;
        // Connection, as sent: HTTP/1.0 defaults to close and HTTP/1.1 to
        // keep-alive, so the header is only an override and the version has
        // to be read before the default is applied.
        bool connClose = false;
        bool connKeep = false;
        while (pos < len) {
            int hEnd = pos;
            while (hEnd < len && (raw[hEnd] & 255) != 10) {
                hEnd = hEnd + 1;
            }
            int lineStop = hEnd;
            if (lineStop > pos && (raw[lineStop - 1] & 255) == 13) { lineStop = lineStop - 1; }
            if (lineStop == pos) {
                // 空行 = 头部结束
                pos = hEnd + 1;
                break;
            }
            headersStop = lineStop;

            // 解析常见头部
            int colonPos = pos;
            while (colonPos < lineStop && (raw[colonPos] & 255) != 58) {
                colonPos = colonPos + 1;
            }
            if (colonPos < lineStop) {
                int vStart = HttpRequest.TrimOwsStart(raw, colonPos + 1,
                    lineStop);
                int vStop = HttpRequest.TrimOwsStop(raw, vStart, lineStop);
                // 头名先按长度分流：本方法关心的七个头名长度互不相同
                // （4/6/10/12/13/14/17），所以每行最多做一次 RegionIs。
                // 逐个 RegionIs 试下去的话，每个头名都要把余下的候选串
                // 全量 strlen 一遍——实测每请求 36 次比较、36 次 strlen。
                int nameLen = colonPos - pos;
                if (nameLen == 4 && RegionIs(raw, pos, colonPos, "host")) {
                    req.host = raw.Substring(vStart, vStop - vStart);
                } else if (nameLen == 12
                           && RegionIs(raw, pos, colonPos, "content-type")) {
                    req.contentType = raw.Substring(vStart, vStop - vStart);
                } else if (nameLen == 13
                           && RegionIs(raw, pos, colonPos, "authorization")) {
                    // 重复出现取第一条，与按名查找的结果一致。
                    if (req.authorization.Length == 0) {
                        req.authorization = raw.Substring(vStart, vStop - vStart);
                    }
                } else if (nameLen == 6
                           && RegionIs(raw, pos, colonPos, "cookie")) {
                    if (req.cookie.Length == 0) {
                        req.cookie = raw.Substring(vStart, vStop - vStart);
                    }
                } else if (nameLen == 14
                           && RegionIs(raw, pos, colonPos, "content-length")) {
                    // 用 64 位累加：32 位 int 下 `4294967297` 会回绕成 1，
                    // 剩下的正文就被当成下一条流水线请求（经典走私）。
                    // 任何非数字字符、或超出 int 上限的值都置 413/400，
                    // 绝不静默截断。
                    clAcc = 0;
                    bool bad = false;
                    int di = vStart;
                    while (di < vStop) {
                        int d = raw[di] & 255;
                        if (d < 48 || d > 57) { bad = true; break; }
                        clAcc = clAcc * 10 + (d - 48);
                        if (clAcc > 2147483647) { bad = true; break; }
                        di = di + 1;
                    }
                    if (bad) {
                        // 非数字 = 畸形头部；溢出 = 超限。区分以便给
                        // 更精确的状态码，但两者都禁止继续信任该值。
                        bool overflow = true;
                        int ci = vStart;
                        while (ci < vStop) {
                            int dd = raw[ci] & 255;
                            if (dd < 48 || dd > 57) { overflow = false; break; }
                            ci = ci + 1;
                        }
                        if (overflow) {
                            req.parseStatus = 413;
                        } else {
                            req.parseStatus = 400;
                        }
                    } else if (clSeen) {
                        // 第二个 Content-Length：与第一个不一致即走私
                        //（RFC 7230 §3.3.2）。相同值按合法处理。
                        if (firstCl != clAcc) { req.parseStatus = 400; }
                    } else {
                        clSeen = true;
                        firstCl = clAcc;
                        req.contentLength = (int)clAcc;
                    }
                } else if (nameLen == 17
                           && RegionIs(raw, pos, colonPos, "transfer-encoding")) {
                    // 只有值恰好是 chunked 时正文才自定界
                    // （RFC 7230 §3.3.3）。其它编码（gzip 等）或
                    // 叠加编码无法据此找到正文结尾，仍按未实现处理。
                    // 多个 Transfer-Encoding 字段合并为一个列表；后一个
                    // 字段不能把前一个非最终编码覆盖成 chunked，反之亦然。
                    req.chunked = HttpRequest.FinalTransferChunked(raw,
                        vStart, vStop);
                    // 服务器不实现 chunked 解码，绝不能忽略
                    // Transfer-Encoding——否则按 Content-Length（或无）
                    // 切分正文，而真实正文是分块编码，剩余 chunk 就被
                    // 当成下一条请求。RFC 7230 §3.3.3：TE 与 CL 同时
                    // 出现 → 400（冲突）；单独 TE（chunked）→ 501。
                    // 顺序无关，循环结束后统一裁决。
                    teSeen = true;
                } else if (nameLen == 10
                           && RegionIs(raw, pos, colonPos, "connection")) {
                    // A comma separated list ("keep-alive, Upgrade"), matched
                    // token by token: an exact compare against the whole value
                    // missed "close" in every list and kept a connection the
                    // client had asked to end.
                    int t = vStart;
                    while (t < lineStop) {
                        int tEnd = t;
                        while (tEnd < lineStop && (raw[tEnd] & 255) != 44) {
                            tEnd = tEnd + 1;
                        }
                        int tStop = HttpRequest.TrimOwsStop(raw, t, tEnd);
                        t = HttpRequest.TrimOwsStart(raw, t, tStop);
                        if (RegionIs(raw, t, tStop, "close")) { connClose = true; }
                        if (RegionIs(raw, t, tStop, "keep-alive")) { connKeep = true; }
                        t = tEnd + 1;
                        t = HttpRequest.TrimOwsStart(raw, t, lineStop);
                    }
                }
            }
            pos = hEnd + 1;
        }
        // Transfer-Encoding 与 Content-Length 的共存裁决
        //（RFC 7230 §3.3.3）：两者同时出现是走私特征 → 400；
        // 只有 TE（chunked，未实现）→ 501。
        // HTTP/1.0 has no persistent connection unless the client asks for
        // one; answering keep-alive to a 1.0 client that did not leaves it
        // waiting for a close that never comes.
        if (RegionIs(req.version, 0, req.version.Length, "http/1.0")) {
            req.keepAlive = connKeep;
        } else {
            req.keepAlive = !connClose;
        }
        if (teSeen && req.parseStatus == 0) {
            // TE 与 CL 同时出现是走私特征 → 400。单独的 chunked
            // 由连接循环解码；其它编码找不到正文边界 → 501。
            if (clSeen) {
                req.parseStatus = 400;
                req.chunked = false;
            } else if (!req.chunked) {
                req.parseStatus = 501;
            }
        }
        if (headersStop > headersStart) {
            req.rawHeaders = raw.Substring(headersStart, headersStop - headersStart);
        }

        // 正文。pos 此时指向头部块之后的第一个字节；缓冲区里的
        // 剩余字节在流水线连接上是"本请求正文 + 下一条请求"，因此
        // 最多取 contentLength 字节；剩下的由调用方（连接循环）
        // 按 bodyStart/bodyLength 切分并留到下轮。
        req.bodyStart = pos;
        if (pos < len && !req.chunked) {
            int avail = len - pos;
            int take = avail;
            if (clSeen && req.contentLength < avail) { take = req.contentLength; }
            req.body = raw.Substring(pos, take);
            req.bodyLength = take;
        }

        return req;
    }

    /// <summary>当 raw[pos..stop) 与 name 相等（ASCII 大小写不敏感）时为 true
    /// （name 必须为小写）。无内存分配的头部匹配。</summary>
    static bool RegionIs(string raw, int pos, int stop, string name) {
        if (stop - pos != name.Length) { return false; }
        for (int i = 0; pos + i < stop; i = i + 1) {
            int c = raw[pos + i] & 255;
            if (c >= 65 && c <= 90) { c = c + 32; }
            if (c != (name[i] & 255)) { return false; }
        }
        return true;
    }

    /// <summary>当 name 与 lower（须为小写字面量）相等（ASCII 大小写不敏感）
    /// 时为 true。不分配：用于按名查找头部前的常见头部判定。</summary>
    static bool NameIs(string name, string lower) {
        if (name.Length != lower.Length) { return false; }
        int n = lower.Length;
        for (int i = 0; i < n; i = i + 1) {
            int c = name[i] & 255;
            if (c >= 65 && c <= 90) { c = c + 32; }
            if (c != (lower[i] & 255)) { return false; }
        }
        return true;
    }

    /// <summary>与 <see cref="RegionIs"/> 相同，但 name 的大小写也不敏感——
    /// 调用方传进来的名字不保证是小写，而把它 ToLower 一份只为比较，
    /// 等于每次查找都在堆上分配一个副本。</summary>
    static bool RegionIsCi(string raw, int pos, int stop, string name) {
        if (stop - pos != name.Length) { return false; }
        for (int i = 0; pos + i < stop; i = i + 1) {
            int c = raw[pos + i] & 255;
            if (c >= 65 && c <= 90) { c = c + 32; }
            int d = name[i] & 255;
            if (d >= 65 && d <= 90) { d = d + 32; }
            if (c != d) { return false; }
        }
        return true;
    }

    /// <summary>按名称获取某个头部值（大小写不敏感）。</summary>
    string GetHeader(string name) {
        // 解析时已捕获的头部不必重扫头部块。
        if (HttpRequest.NameIs(name, "authorization")) { return this.authorization; }
        if (HttpRequest.NameIs(name, "cookie")) { return this.cookie; }
        // 在 rawHeaders 中搜索（按字节扫描；只分配返回值本身）
        int pos = 0;
        int len = this.rawHeaders.Length;
        while (pos < len) {
            int lineEnd = pos;
            while (lineEnd < len && (this.rawHeaders[lineEnd] & 255) != 10) {
                lineEnd = lineEnd + 1;
            }
            int lineStop = lineEnd;
            if (lineStop > pos && (this.rawHeaders[lineStop - 1] & 255) == 13) { lineStop = lineStop - 1; }
            int colonPos = pos;
            while (colonPos < lineStop && (this.rawHeaders[colonPos] & 255) != 58) {
                colonPos = colonPos + 1;
            }
            if (colonPos < lineStop) {
                if (RegionIsCi(this.rawHeaders, pos, colonPos, name)) {
                    int vStart = HttpRequest.TrimOwsStart(this.rawHeaders,
                        colonPos + 1, lineStop);
                    int vStop = HttpRequest.TrimOwsStop(this.rawHeaders,
                        vStart, lineStop);
                    return this.rawHeaders.Substring(vStart, vStop - vStart);
                }
            }
            pos = lineEnd + 1;
        }
        return "";
    }

    /// <summary>按名称获取查询参数值（值已 url 解码，与
    /// <see cref="GetFormField"/> 一致）。</summary>
    string GetQueryParam(string name) {
        if (this.queryString.Length == 0) { return ""; }
        int pos = 0;
        int len = this.queryString.Length;
        string qs = this.queryString;
        while (pos < len) {
            int eqPos = pos;
            while (eqPos < len) {
                int c = qs[eqPos] & 255;
                if (c == 61 || c == 38) { break; } // '=' or '&'
                eqPos = eqPos + 1;
            }
            string paramName = qs.Substring(pos, eqPos - pos);
            string paramValue = "";
            if (eqPos < len && (qs[eqPos] & 255) == 61) {
                int valEnd = eqPos + 1;
                while (valEnd < len && (qs[valEnd] & 255) != 38) { // '&'
                    valEnd = valEnd + 1;
                }
                paramValue = Encoding.UrlDecode(
                    qs.Substring(eqPos + 1, valEnd - eqPos - 1));
                pos = valEnd + 1;
            } else {
                pos = eqPos + 1;
            }
            if (paramName == name) {
                return paramValue;
            }
        }
        return "";
    }

    /// <summary>从 application/x-www-form-urlencoded 正文中读取字段，
    /// 对值做 url 解码。相当于 GetQueryParam 的 POST 正文版；
    /// 字段不存在时返回 ""。</summary>
    string GetFormField(string name) {
        string b = this.body;
        int pos = 0;
        int len = b.Length;
        while (pos < len) {
            int amp = pos;
            while (amp < len && (b[amp] & 255) != 38) { amp = amp + 1; }
            string pair = b.Substring(pos, amp - pos);
            int eq = pair.IndexOf("=");
            if (eq > 0) {
                if (pair.Substring(0, eq) == name) {
                    return Encoding.UrlDecode(pair.Substring(eq + 1));
                }
            }
            pos = amp + 1;
        }
        return "";
    }

    /// <summary>构建用于发送的 HTTP 请求字符串。</summary>
    static string Build(string method, string path, string host, string body) {
        StringBuilder sb = new StringBuilder();
        sb.Append(method);
        sb.Append(" ");
        sb.Append(path);
        sb.Append(" HTTP/1.1\r\n");
        sb.Append("Host: ");
        sb.Append(host);
        sb.Append("\r\n");
        if (body.Length > 0) {
            sb.Append("Content-Length: ");
            sb.Append(Convert.ToString(body.Length));
            sb.Append("\r\n");
            sb.Append("Content-Type: application/x-www-form-urlencoded\r\n");
        }
        sb.Append("Connection: keep-alive\r\n");
        sb.Append("\r\n");
        if (body.Length > 0) {
            sb.Append(body);
        }
        return sb.ToString();
    }

    /// <summary>构建 GET 请求。</summary>
    static string BuildGet(string path, string host) {
        return Build("GET", path, host, "");
    }

    /// <summary>构建 POST 请求。</summary>
    static string BuildPost(string path, string host, string body) {
        return Build("POST", path, host, body);
    }
}
