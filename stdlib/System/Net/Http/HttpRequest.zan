using System;
using System.Text;

namespace System.Net.Http;

/// <summary>
/// HTTP 请求的表示与解析器。
/// 从 TCP 数据解析原始 HTTP/1.1 请求。
/// </summary>
class HttpRequest {
    string method;
    string path;
    string version;
    string body;
    string rawHeaders;
    string queryString;
    string host;
    string contentType;
    int contentLength;
    bool keepAlive;
    // 请求定界/头部解析失败的原因（HTTP 状态码；0 = 正常）。
    // 服务器在信任 contentLength 切分正文之前必须检查它——
    // 回绕的 Content-Length、重复且不一致的 Content-Length、
    // 未实现的 Transfer-Encoding 都是请求走私的入口。
    int parseStatus;

    HttpRequest() {
        this.method = "";
        this.path = "";
        this.version = "HTTP/1.1";
        this.body = "";
        this.rawHeaders = "";
        this.queryString = "";
        this.host = "";
        this.contentType = "";
        this.contentLength = 0;
        this.keepAlive = true;
        this.parseStatus = 0;
    }

    /// <summary>把原始 HTTP 请求字符串解析为 HttpRequest。
    ///
    /// 按字节下标扫描（<c>raw[i] &amp; 255</c>），而不是
    /// <c>raw.Substring(i, 1)</c>。后者每检查一个字节都会在堆上分配一个
    /// 单字符字符串，因此旧解析器每个请求要做 O(请求大小) 次分配；
    /// 本实现原地遍历缓冲区，只分配
    /// 实际提取的那几个字段。</summary>
    static HttpRequest Parse(string raw) {
        HttpRequest req = new HttpRequest();
        int len = raw.Length;
        if (len == 0) { return req; }

        // 请求行：扫描到 '\n'，再去掉末尾的 '\r'。
        int lineEnd = 0;
        for (; lineEnd < len && (raw[lineEnd] & 255) != 10; lineEnd = lineEnd + 1) {
        }
        int rlEnd = lineEnd;
        if (rlEnd > 0 && (raw[rlEnd - 1] & 255) == 13) { rlEnd = rlEnd - 1; }

        // 解析：METHOD PATH VERSION
        int sp1 = 0;
        for (; sp1 < rlEnd && (raw[sp1] & 255) != 32; sp1 = sp1 + 1) {
        }
        req.method = raw.Substring(0, sp1);

        int sp2 = sp1 + 1;
        while (sp2 < rlEnd && (raw[sp2] & 255) != 32) {
            sp2 = sp2 + 1;
        }
        int pathStart = sp1 + 1;
        int pathEnd = sp2;
        if (sp2 < rlEnd) {
            req.version = raw.Substring(sp2 + 1, rlEnd - sp2 - 1);
        }

        // 拆分路径和查询字符串
        int qmark = pathStart;
        bool foundQ = false;
        while (qmark < pathEnd) {
            if ((raw[qmark] & 255) == 63) {
                foundQ = true;
                break;
            }
            qmark = qmark + 1;
        }
        if (foundQ) {
            req.path = raw.Substring(pathStart, qmark - pathStart);
            req.queryString = raw.Substring(qmark + 1, pathEnd - qmark - 1);
        } else {
            req.path = raw.Substring(pathStart, pathEnd - pathStart);
        }

        // 原地解析头部：常见字段按字节
        // （大小写不敏感）与缓冲区匹配，rawHeaders 是整个区块的
        // 一个切片——不按行或按名称/值分配内存。
        int pos = lineEnd + 1;
        int headersStart = pos;
        int headersStop = pos;
        // 定界状态：Content-Length 用 64 位累加并检查溢出，
        // 重复出现必须一致，Transfer-Encoding 绝不静默忽略
        //（见各分支）——这三者是请求走私（RFC 7230 §3.3.2/§3.3.3）
        // 的入口，一旦发现立即置 parseStatus，服务器据此拒绝。
        long clAcc = 0;
        bool clSeen = false;
        long firstCl = 0;
        bool teSeen = false;
        // Connection, as sent: HTTP/1.0 defaults to close and HTTP/1.1 to
        // keep-alive, so the header is only an override and the version has
        // to be read before the default is applied.
        bool connClose = false;
        bool connKeep = false;
        while (pos < len) {
            int hEnd = pos;
            while (hEnd < len && (raw[hEnd] & 255) != 10) {
                hEnd = hEnd + 1;
            }
            int lineStop = hEnd;
            if (lineStop > pos && (raw[lineStop - 1] & 255) == 13) { lineStop = lineStop - 1; }
            if (lineStop == pos) {
                // 空行 = 头部结束
                pos = hEnd + 1;
                break;
            }
            headersStop = lineStop;

            // 解析常见头部
            int colonPos = pos;
            while (colonPos < lineStop && (raw[colonPos] & 255) != 58) {
                colonPos = colonPos + 1;
            }
            if (colonPos < lineStop) {
                int vStart = colonPos + 1;
                // 去除前导空格
                if (vStart < lineStop && (raw[vStart] & 255) == 32) {
                    vStart = vStart + 1;
                }
                if (RegionIs(raw, pos, colonPos, "host")) {
                    req.host = raw.Substring(vStart, lineStop - vStart);
                } else if (RegionIs(raw, pos, colonPos, "content-type")) {
                    req.contentType = raw.Substring(vStart, lineStop - vStart);
                } else if (RegionIs(raw, pos, colonPos, "content-length")) {
                    // 用 64 位累加：32 位 int 下 `4294967297` 会回绕成 1，
                    // 剩下的正文就被当成下一条流水线请求（经典走私）。
                    // 任何非数字字符、或超出 int 上限的值都置 413/400，
                    // 绝不静默截断。
                    clAcc = 0;
                    bool bad = false;
                    int di = vStart;
                    while (di < lineStop) {
                        int d = raw[di] & 255;
                        if (d < 48 || d > 57) { bad = true; break; }
                        clAcc = clAcc * 10 + (d - 48);
                        if (clAcc > 2147483647) { bad = true; break; }
                        di = di + 1;
                    }
                    if (bad) {
                        // 非数字 = 畸形头部；溢出 = 超限。区分以便给
                        // 更精确的状态码，但两者都禁止继续信任该值。
                        bool overflow = true;
                        int ci = vStart;
                        while (ci < lineStop) {
                            int dd = raw[ci] & 255;
                            if (dd < 48 || dd > 57) { overflow = false; break; }
                            ci = ci + 1;
                        }
                        if (overflow) {
                            req.parseStatus = 413;
                        } else {
                            req.parseStatus = 400;
                        }
                    } else if (clSeen) {
                        // 第二个 Content-Length：与第一个不一致即走私
                        //（RFC 7230 §3.3.2）。相同值按合法处理。
                        if (firstCl != clAcc) { req.parseStatus = 400; }
                    } else {
                        clSeen = true;
                        firstCl = clAcc;
                        req.contentLength = (int)clAcc;
                    }
                } else if (RegionIs(raw, pos, colonPos, "transfer-encoding")) {
                    // 服务器不实现 chunked 解码，绝不能忽略
                    // Transfer-Encoding——否则按 Content-Length（或无）
                    // 切分正文，而真实正文是分块编码，剩余 chunk 就被
                    // 当成下一条请求。RFC 7230 §3.3.3：TE 与 CL 同时
                    // 出现 → 400（冲突）；单独 TE（chunked）→ 501。
                    // 顺序无关，循环结束后统一裁决。
                    teSeen = true;
                } else if (RegionIs(raw, pos, colonPos, "connection")) {
                    // A comma separated list ("keep-alive, Upgrade"), matched
                    // token by token: an exact compare against the whole value
                    // missed "close" in every list and kept a connection the
                    // client had asked to end.
                    int t = vStart;
                    while (t < lineStop) {
                        int tEnd = t;
                        while (tEnd < lineStop && (raw[tEnd] & 255) != 44) {
                            tEnd = tEnd + 1;
                        }
                        int tStop = tEnd;
                        while (tStop > t && (raw[tStop - 1] & 255) == 32) {
                            tStop = tStop - 1;
                        }
                        if (RegionIs(raw, t, tStop, "close")) { connClose = true; }
                        if (RegionIs(raw, t, tStop, "keep-alive")) { connKeep = true; }
                        t = tEnd + 1;
                        while (t < lineStop && (raw[t] & 255) == 32) { t = t + 1; }
                    }
                }
            }
            pos = hEnd + 1;
        }
        // Transfer-Encoding 与 Content-Length 的共存裁决
        //（RFC 7230 §3.3.3）：两者同时出现是走私特征 → 400；
        // 只有 TE（chunked，未实现）→ 501。
        // HTTP/1.0 has no persistent connection unless the client asks for
        // one; answering keep-alive to a 1.0 client that did not leaves it
        // waiting for a close that never comes.
        if (RegionIs(req.version, 0, req.version.Length, "http/1.0")) {
            req.keepAlive = connKeep;
        } else {
            req.keepAlive = !connClose;
        }
        if (teSeen && req.parseStatus == 0) {
            req.parseStatus = clSeen ? 400 : 501;
        }
        if (headersStop > headersStart) {
            req.rawHeaders = raw.Substring(headersStart, headersStop - headersStart);
        }

        // 正文
        if (pos < len) {
            req.body = raw.Substring(pos);
        }

        return req;
    }

    /// <summary>当 raw[pos..stop) 与 name 相等（ASCII 大小写不敏感）时为 true
    /// （name 必须为小写）。无内存分配的头部匹配。</summary>
    static bool RegionIs(string raw, int pos, int stop, string name) {
        if (stop - pos != name.Length) { return false; }
        for (int i = 0; pos + i < stop; i = i + 1) {
            int c = raw[pos + i] & 255;
            if (c >= 65 && c <= 90) { c = c + 32; }
            if (c != (name[i] & 255)) { return false; }
        }
        return true;
    }

    /// <summary>按名称获取某个头部值（大小写不敏感）。</summary>
    string GetHeader(string name) {
        // 在 rawHeaders 中搜索（按字节扫描；只分配返回值本身）
        string lname = name.ToLower();
        int pos = 0;
        int len = this.rawHeaders.Length;
        while (pos < len) {
            int lineEnd = pos;
            while (lineEnd < len && (this.rawHeaders[lineEnd] & 255) != 10) {
                lineEnd = lineEnd + 1;
            }
            int lineStop = lineEnd;
            if (lineStop > pos && (this.rawHeaders[lineStop - 1] & 255) == 13) { lineStop = lineStop - 1; }
            int colonPos = pos;
            while (colonPos < lineStop && (this.rawHeaders[colonPos] & 255) != 58) {
                colonPos = colonPos + 1;
            }
            if (colonPos < lineStop) {
                if (RegionIs(this.rawHeaders, pos, colonPos, lname)) {
                    int vStart = colonPos + 1;
                    if (vStart < lineStop && (this.rawHeaders[vStart] & 255) == 32) {
                        vStart = vStart + 1;
                    }
                    return this.rawHeaders.Substring(vStart, lineStop - vStart);
                }
            }
            pos = lineEnd + 1;
        }
        return "";
    }

    /// <summary>按名称获取查询参数值（值已 url 解码，与
    /// <see cref="GetFormField"/> 一致）。</summary>
    string GetQueryParam(string name) {
        if (this.queryString.Length == 0) { return ""; }
        int pos = 0;
        int len = this.queryString.Length;
        string qs = this.queryString;
        while (pos < len) {
            int eqPos = pos;
            while (eqPos < len) {
                int c = qs[eqPos] & 255;
                if (c == 61 || c == 38) { break; } // '=' or '&'
                eqPos = eqPos + 1;
            }
            string paramName = qs.Substring(pos, eqPos - pos);
            string paramValue = "";
            if (eqPos < len && (qs[eqPos] & 255) == 61) {
                int valEnd = eqPos + 1;
                while (valEnd < len && (qs[valEnd] & 255) != 38) { // '&'
                    valEnd = valEnd + 1;
                }
                paramValue = Encoding.UrlDecode(
                    qs.Substring(eqPos + 1, valEnd - eqPos - 1));
                pos = valEnd + 1;
            } else {
                pos = eqPos + 1;
            }
            if (paramName == name) {
                return paramValue;
            }
        }
        return "";
    }

    /// <summary>从 application/x-www-form-urlencoded 正文中读取字段，
    /// 对值做 url 解码。相当于 GetQueryParam 的 POST 正文版；
    /// 字段不存在时返回 ""。</summary>
    string GetFormField(string name) {
        string b = this.body;
        int pos = 0;
        int len = b.Length;
        while (pos < len) {
            int amp = pos;
            while (amp < len && (b[amp] & 255) != 38) { amp = amp + 1; }
            string pair = b.Substring(pos, amp - pos);
            int eq = pair.IndexOf("=");
            if (eq > 0) {
                if (pair.Substring(0, eq) == name) {
                    return Encoding.UrlDecode(pair.Substring(eq + 1));
                }
            }
            pos = amp + 1;
        }
        return "";
    }

    /// <summary>构建用于发送的 HTTP 请求字符串。</summary>
    static string Build(string method, string path, string host, string body) {
        StringBuilder sb = new StringBuilder();
        sb.Append(method);
        sb.Append(" ");
        sb.Append(path);
        sb.Append(" HTTP/1.1\r\n");
        sb.Append("Host: ");
        sb.Append(host);
        sb.Append("\r\n");
        if (body.Length > 0) {
            sb.Append("Content-Length: ");
            sb.Append(Convert.ToString(body.Length));
            sb.Append("\r\n");
            sb.Append("Content-Type: application/x-www-form-urlencoded\r\n");
        }
        sb.Append("Connection: keep-alive\r\n");
        sb.Append("\r\n");
        if (body.Length > 0) {
            sb.Append(body);
        }
        return sb.ToString();
    }

    /// <summary>构建 GET 请求。</summary>
    static string BuildGet(string path, string host) {
        return Build("GET", path, host, "");
    }

    /// <summary>构建 POST 请求。</summary>
    static string BuildPost(string path, string host, string body) {
        return Build("POST", path, host, body);
    }
}
