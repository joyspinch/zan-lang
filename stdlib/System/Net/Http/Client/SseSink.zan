using System;
using System.Threading;

/// <summary>流式响应体的目的地（text/event-stream，或
/// 任何边到达边消费的应答）。
///
/// 两种模式：
///   * file  —— chunk 追加到文件，结果写入标记文件。
///     由独立进程或轮询者持续读取。
///   * memory —— chunk 在互斥锁保护的缓冲区中累积，
///     请求可在工作线程上运行，另一线程（例如 GUI 循环）
///     每帧用 <c>Take</c> 取走数据。完全不碰磁盘。
///
/// 正是内存模式让流式请求可以存活在渲染它的进程内部：
/// 跨线程传递的只有缓冲区和结果字符串，
/// 两者都在锁的保护下交接。</summary>
class SseSink {
    /// 文件模式下的输出文件；内存模式下为 ""。
    string path;
    /// 文件模式下的标记文件；内存模式下为 ""。
    string donePath;
    /// 文件模式下整个流的打开句柄（0 表示无）。
    nint fp;
    /// 已写入但尚未取走的 chunk（内存模式）。用 StringBuilder 累积：
    /// `buf = buf + piece` 每个 chunk 都要复制一遍全文，一次几千个 chunk 的
    /// 长回答就是 O(n²) 的拷贝，模型输出越长工作线程越烫。
    StringBuilder buf;
    /// 刚结束的那次尝试的结果（有尝试在运行时为 ""）。
    string attempt;
    /// 所有者确定不再重试后发布的结果（此前为 ""）。
    string done;
    /// 已写入的总字节数，使轮询者无需排空缓冲区就能区分
    /// "仍在流式传输" 与 "尚无数据"。
    int total;
    #if WINDOWS
    nint lockHandle;
    #else
    string lockHandle;
    #endif

    [DllImport("crt", EntryPoint = "fopen")]
    static extern nint fopen(string path, string mode);

    [DllImport("crt", EntryPoint = "fclose")]
    static extern int fclose(nint fp);

    [DllImport("crt", EntryPoint = "fwrite")]
    static extern long fwrite(string buf, long size, long count, nint fp);

    /// <summary>一种 sink，把正文追加到 <paramref name="outFile"/>，
    /// 把结果写到 <paramref name="doneFile"/>。</summary>
    static SseSink ToFile(string outFile, string doneFile) {
        SseSink s = new SseSink();
        s.path = outFile;
        s.donePath = doneFile;
        s.fp = 0;
        s.buf = new StringBuilder();
        s.attempt = "";
        s.done = "";
        s.total = 0;
        s.lockHandle = Mutex.Create();
        return s;
    }

    /// <summary>一种 sink，把正文保存在内存中供另一线程
    /// 用 <c>All</c> 读取（或用 <c>Take</c> 取走）。</summary>
    static SseSink ToMemory() {
        SseSink s = new SseSink();
        s.path = "";
        s.donePath = "";
        s.fp = 0;
        s.buf = new StringBuilder();
        s.attempt = "";
        s.done = "";
        s.total = 0;
        s.lockHandle = Mutex.Create();
        return s;
    }

    /// <summary>为新流准备 sink（截断文件、丢弃
    /// 任何已缓冲的文本）。由传输层在第一个 chunk 前调用。
    /// </summary>
    void Begin() {
        Mutex.Lock(this.lockHandle);
        this.buf = new StringBuilder();
        this.attempt = "";
        this.total = 0;
        Mutex.Unlock(this.lockHandle);
        if (this.path != "") {
            nint t = SseSink.fopen(this.path, "wb");
            if (t != 0) { SseSink.fclose(t); }
            this.fp = SseSink.fopen(this.path, "ab");
        }
    }

    /// <summary>追加一个已解码的 chunk。</summary>
    void Write(string piece) {
        if (piece.Length == 0) { return; }
        if (this.path != "") {
            if (this.fp != 0) {
                long _w = SseSink.fwrite(piece, 1, piece.Length, this.fp);
            }
            Mutex.Lock(this.lockHandle);
            this.total = this.total + piece.Length;
            Mutex.Unlock(this.lockHandle);
            return;
        }
        Mutex.Lock(this.lockHandle);
        this.buf.Append(piece);
        this.total = this.total + piece.Length;
        Mutex.Unlock(this.lockHandle);
    }

    /// <summary>以结果标记（"ok" 或 "err: ..."）结束一次尝试。
    /// 会重试的所有者用 <c>Attempt</c> 读取它并自行发布
    /// 最终结果；而普通的单次调用者（文件模式）则
    /// 在此直接把它写入标记文件。</summary>
    void Finish(string marker) {
        if (this.fp != 0) { SseSink.fclose(this.fp); this.fp = 0; }
        if (this.donePath != "") {
            nint dp = SseSink.fopen(this.donePath, "ab");
            if (dp != 0) {
                long _w = SseSink.fwrite(marker, 1, marker.Length, dp);
                SseSink.fclose(dp);
            }
        }
        Mutex.Lock(this.lockHandle);
        this.attempt = marker;
        if (this.path != "") { this.done = marker; }
        Mutex.Unlock(this.lockHandle);
    }

    /// <summary>最近一次已结束尝试的结果（有尝试在运行时为 ""）。
    /// </summary>
    string Attempt() {
        Mutex.Lock(this.lockHandle);
        string s = this.attempt;
        Mutex.Unlock(this.lockHandle);
        return s;
    }

    /// <summary>向 <c>Done</c> 的读者发布最终结果。
    /// </summary>
    void Publish(string marker) {
        Mutex.Lock(this.lockHandle);
        this.done = marker;
        Mutex.Unlock(this.lockHandle);
    }

    /// <summary>自 <c>Begin</c> 以来收到的全部内容，且不消费它们
    /// （内存模式）。每帧重新解析整个正文的读者——比如
    /// 展示答案逐步生成的 UI——适合用这个而不是 <c>Take</c>。
    /// </summary>
    string All() {
        Mutex.Lock(this.lockHandle);
        string s = this.buf.ToString();
        Mutex.Unlock(this.lockHandle);
        return s;
    }

    /// <summary>移除并返回目前缓冲的全部内容（内存模式）。
    /// </summary>
    string Take() {
        Mutex.Lock(this.lockHandle);
        string s = this.buf.ToString();
        this.buf = new StringBuilder();
        Mutex.Unlock(this.lockHandle);
        return s;
    }

    /// <summary>结果标记，流仍在运行时为 ""。
    /// </summary>
    string Done() {
        Mutex.Lock(this.lockHandle);
        string s = this.done;
        Mutex.Unlock(this.lockHandle);
        return s;
    }

    /// <summary>目前收到的字节数（空闲看门狗可监视此值）。
    /// </summary>
    int Total() {
        Mutex.Lock(this.lockHandle);
        int n = this.total;
        Mutex.Unlock(this.lockHandle);
        return n;
    }

    /// <summary>释放锁句柄。此后再使用该 sink 即非法。
    /// </summary>
    void Dispose() {
        if (this.fp != 0) { SseSink.fclose(this.fp); this.fp = 0; }
        Mutex.Destroy(this.lockHandle);
    }
}
