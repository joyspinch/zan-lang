using System;
using System.IO;
using System.Net.Sockets;
using System.Net.Http;
using System.Net.Tls;

namespace System.Net.Http.Client;

/// <summary>
/// HTTP client supporting GET, POST, PUT, DELETE, over plain TCP or TLS
/// (https via CreateHttps / UseTls).
///
/// <c>SetTimeout</c> is enforced, not advisory: the connect phase is bounded by
/// a deadline-polled non-blocking connect, and the send/receive phase by the
/// shared <see cref="HttpDeadline"/> sweeper, which hangs up on a late socket so
/// the parked coroutine wakes and reports the timeout. The sweeper ticks once a
/// second, so the effective granularity is ~1s (a 30s timeout fires between 30
/// and 31s); <c>SetTimeout(0)</c> disables deadlines entirely.
///
/// The status line is available through <see cref="SendAsync"/>, which returns
/// the parsed <see cref="HttpResponse"/>; the verb helpers keep returning just
/// the body. Nothing about the last response is cached on the client, so one
/// client stays usable from several coroutines.
/// </summary>
class HttpClient {
    string host;
    int port;
    int timeout;
    bool useTls;
    bool verifyTls;
    string clientCertificateFile;
    string clientPrivateKeyFile;
    List<string> defaultHeaders;
    // Public-key pinning: accepted server SPKI SHA-256 pins (base64) and
    // whether they are enforced. Enforcement stays on in release builds; the
    // dev switch below is compiled out of a shipped binary.
    List<string> tlsPins;
    bool pinningEnabled;

    [DllImport("crt")]
    static extern nint fopen(string path, string mode);

    [DllImport("crt")]
    static extern int fputs(string str, nint fp);

    [DllImport("crt")]
    static extern int fclose(nint fp);

    // Binary-safe file IO for uploads/resumable downloads (strings are
    // length-tracked, so fwrite/fread move raw bytes, NULs included).
    [DllImport("crt")]
    static extern long fwrite(string buf, long size, long count, nint fp);

    [DllImport("crt")]
    static extern int fseek(nint fp, int offset, int origin);

    [DllImport("crt")]
    static extern int ftell(nint fp);

    HttpClient() {
        this.host = "";
        this.port = 80;
        this.timeout = 30000;
        this.useTls = false;
        this.verifyTls = true;
        this.clientCertificateFile = "";
        this.clientPrivateKeyFile = "";
        this.defaultHeaders = new List<string>();
        this.tlsPins = null;
        this.pinningEnabled = false;
    }

    /// <summary>Creates an HTTP client for a given host and port.</summary>
    static HttpClient Create(string host, int port) {
        HttpClient client = new HttpClient();
        client.host = host;
        client.port = port;
        return client;
    }

    /// <summary>Creates an HTTPS client for a given host and port.</summary>
    static HttpClient CreateHttps(string host, int port) {
        HttpClient client = HttpClient.Create(host, port);
        client.useTls = true;
        return client;
    }

    /// <summary>Enables TLS (https) for this client.</summary>
    HttpClient UseTls() {
        this.useTls = true;
        return this;
    }

    /// <summary>Disables server certificate verification (development /
    /// self-signed servers only).</summary>
    HttpClient DisableTlsVerify() {
        this.verifyTls = false;
        return this;
    }

    /// <summary>Pins an accepted server public key: the base64 SHA-256 of its
    /// DER SubjectPublicKeyInfo. Once any pin is set the handshake rejects a
    /// server whose key matches none of them, even if its certificate is
    /// otherwise system-trusted -- blocking a MITM proxy. Call twice to pin a
    /// backup key for rotation.</summary>
    HttpClient PinPublicKey(string spkiSha256Base64) {
        if (this.tlsPins == null) { this.tlsPins = new List<string>(); }
        this.tlsPins.Add(spkiSha256Base64);
        this.pinningEnabled = true;
        this.useTls = true;
        return this;
    }

    /// <summary>Development-only escape hatch that relaxes pinning so a local
    /// proxy or self-signed dev server works. Guarded by ZAN_DEV, so a release
    /// build compiles it out and always enforces configured pins.</summary>
    HttpClient DisablePinning() {
        #if ZAN_DEV
        this.pinningEnabled = false;
        #endif
        return this;
    }

    // Copies the configured pins onto a freshly created client context and
    // arms enforcement. No-op when pinning is disabled or unconfigured.
    void ApplyPinning(TlsContext ctx) {
        if (!this.pinningEnabled || this.tlsPins == null) { return; }
        int i = 0;
        while (i < this.tlsPins.Count) {
            ctx.AddPin(this.tlsPins[i]);
            i = i + 1;
        }
        ctx.RequirePinning(true);
    }

    /// <summary>Configures a PEM certificate chain and matching PEM private
    /// key for mutual TLS client authentication.</summary>
    HttpClient SetClientCertificate(string certFile, string keyFile) {
        this.clientCertificateFile = certFile;
        this.clientPrivateKeyFile = keyFile;
        this.useTls = true;
        return this;
    }

    /// <summary>Adds a default header to all requests.</summary>
    HttpClient SetHeader(string name, string headerValue) {
        this.defaultHeaders.Add(name + ": " + headerValue);
        return this;
    }

    /// <summary>Sets the request timeout in milliseconds: the connect phase and
    /// the request/response phase each get their own window. Zero or less
    /// disables timeouts (the coroutine then waits for the peer
    /// indefinitely).</summary>
    HttpClient SetTimeout(int ms) {
        this.timeout = ms;
        return this;
    }

    /// <summary>True when <see cref="SetHeader"/> already supplied a header whose
    /// name matches (ASCII case-insensitive). Used so BuildRequest can leave a
    /// caller-chosen Content-Type alone instead of always forcing form encoding.</summary>
    bool HasHeaderName(string name) {
        int nlen = name.Length;
        int i = 0;
        while (i < this.defaultHeaders.Count) {
            string h = this.defaultHeaders[i];
            // "Name: value" — require a colon right after the name.
            if (h.Length > nlen && (h[nlen] & 255) == 58
                && HttpClient.AsciiNameEquals(h, name, nlen)) {
                return true;
            }
            i = i + 1;
        }
        return false;
    }

    /// ASCII case-insensitive equality of the first <paramref name="n"/> bytes
    /// of <paramref name="hay"/> against <paramref name="name"/>.
    static bool AsciiNameEquals(string hay, string name, int n) {
        int i = 0;
        while (i < n) {
            int a = hay[i] & 255;
            int b = name[i] & 255;
            if (a >= 65 && a <= 90) { a = a + 32; }
            if (b >= 65 && b <= 90) { b = b + 32; }
            if (a != b) { return false; }
            i = i + 1;
        }
        return true;
    }

    // Builds the raw HTTP/1.1 request text (Connection: close framing).
    string BuildRequest(string method, string path, string body) {
        StringBuilder sb = new StringBuilder();
        sb.Append(method);
        sb.Append(" ");
        sb.Append(path);
        sb.Append(" HTTP/1.1\r\n");
        sb.Append("Host: ");
        sb.Append(this.host);
        sb.Append("\r\n");

        int i = 0;
        while (i < this.defaultHeaders.Count) {
            sb.Append(this.defaultHeaders[i]);
            sb.Append("\r\n");
            i = i + 1;
        }

        if (body.Length > 0) {
            sb.Append("Content-Length: ");
            sb.Append(Convert.ToString(body.Length));
            sb.Append("\r\n");
            // Default form encoding only when the caller has not already set
            // Content-Type (JSON APIs such as WeChat custom/send need application/json).
            if (!this.HasHeaderName("Content-Type")) {
                sb.Append("Content-Type: application/x-www-form-urlencoded\r\n");
            }
        }

        sb.Append("Connection: close\r\n");
        sb.Append("\r\n");
        if (body.Length > 0) {
            sb.Append(body);
        }
        return sb.ToString();
    }

    // Reports a connect failure, telling a refused connection apart from an
    // exhausted deadline. Kept out of RequestAsync so the message is built in a
    // frame that owns no other allocation (`throw` does not release live locals,
    // see docs/bugs/throw-leaks-live-locals.md).
    void FailConnect() {
        if (TcpClient.LastConnectTimedOut()) {
            throw new HttpRequestException("Connect to " + this.host + ":"
                + Convert.ToString(this.port) + " timed out after "
                + Convert.ToString(this.timeout) + "ms");
        }
        throw new HttpRequestException("Could not connect to " + this.host
            + ":" + Convert.ToString(this.port));
    }

    // Reports an exhausted request deadline (the sweeper already hung the
    // socket up, which is what ended the caller's read loop).
    void FailTimeout() {
        throw new HttpRequestException("Request to " + this.host + ":"
            + Convert.ToString(this.port) + " timed out after "
            + Convert.ToString(this.timeout) + "ms");
    }

    /// <summary>Sends an HTTP request and returns the raw response. Throws
    /// HttpRequestException when the connection (or TLS handshake) fails, or
    /// when the request does not complete within the timeout.
    /// The connection is established before the request text is built, so a
    /// connect failure throws with no allocations live in this frame.</summary>
    async string RequestAsync(string method, string path, string body) {
        if (this.useTls) {
            string raw = await RequestTlsAsync(method, path, body);
            return raw;
        }

        TcpClient conn = await TcpClient.ConnectAsync(this.host, this.port,
                                                     this.timeout);
        if (conn == null) {
            FailConnect();
        }
        // From here on the deadline is the sweeper's: a peer that accepts the
        // connection and then goes quiet would park this coroutine forever,
        // since a reactor wake cannot be cancelled.
        int watch = HttpDeadline.Arm(conn.Sock(), this.timeout);
        int _sent = await conn.SendAsync(BuildRequest(method, path, body));

        // Read response. The chunk is hoisted out of the loop and cleared
        // afterwards because a timeout unwinds through `throw`, which does not
        // release live locals -- including the loop-scoped ones
        // (docs/bugs/throw-leaks-live-locals.md).
        StringBuilder respSb = new StringBuilder();
        bool reading = true;
        string chunk = "";
        while (reading) {
            chunk = await conn.RecvAsync(65536);
            if (chunk.Length == 0) {
                reading = false;
            } else {
                respSb.Append(chunk);
            }
        }
        chunk = "";

        string result = respSb.ToString();
        respSb = null;
        bool late = HttpDeadline.Expired(watch);
        HttpDeadline.Disarm(watch);
        conn.Close();
        conn = null;
        if (late) {
            // Drop the partial response and the connection before unwinding:
            // locals still live at the throw are not released
            // (docs/bugs/throw-leaks-live-locals.md).
            result = "";
            method = "";
            path = "";
            body = "";
            FailTimeout();
        }
        return result;
    }

    // Establishes a fresh TLS connection (throwing HttpRequestException on
    // connect or handshake failure, before any request allocation), then sends
    // the request and reads the whole response (Connection: close framing).
    async string RequestTlsAsync(string method, string path, string body) {
        Socket.Initialize();
        TcpClient conn = await TcpClient.ConnectAsync(this.host, this.port,
                                                     this.timeout);
        if (conn == null) {
            FailConnect();
        }
        TlsContext ctx;
        if (this.clientCertificateFile.Length > 0
            && this.clientPrivateKeyFile.Length > 0) {
            ctx = TlsContext.CreateClientWithCertificate(
                this.clientCertificateFile, this.clientPrivateKeyFile);
        } else {
            ctx = TlsContext.CreateClient();
        }
        if (ctx == null) {
            conn.Close();
            throw new HttpRequestException("Could not create TLS context");
        }
        if (!this.verifyTls) {
            ctx.DisableVerify();
        }
        this.ApplyPinning(ctx);
        TlsStream stream = await TlsStream.ConnectAsync(ctx, conn.Sock(), this.host);
        if (stream == null) {
            conn.Close();
            ctx.Free();
            throw new HttpRequestException("TLS handshake with " + this.host
                + " failed");
        }

        // The handshake is done; bound the exchange itself the same way the
        // plain path does.
        int watch = HttpDeadline.Arm(conn.Sock(), this.timeout);
        string requestData = BuildRequest(method, path, body);
        int _sent = await stream.SendAsync(requestData, requestData.Length);

        StringBuilder respSb = new StringBuilder();
        bool reading = true;
        string chunk = "";
        while (reading) {
            chunk = await stream.RecvAsync(65536);
            if (chunk.Length == 0) {
                reading = false;
            } else {
                respSb.Append(chunk);
            }
        }
        chunk = "";

        string result = respSb.ToString();
        respSb = null;
        bool late = HttpDeadline.Expired(watch);
        HttpDeadline.Disarm(watch);
        stream.Close();
        conn.Close();
        ctx.Free();
        stream = null;
        conn = null;
        ctx = null;
        if (late) {
            result = "";
            requestData = "";
            method = "";
            path = "";
            body = "";
            FailTimeout();
        }
        return result;
    }

    /// <summary>Sends a request and returns the parsed response, so callers can
    /// see the status line and headers instead of only the body: a 502 from a
    /// gateway is otherwise indistinguishable from a 200 with an odd
    /// payload.</summary>
    async HttpResponse SendAsync(string method, string path, string body) {
        string raw = await RequestAsync(method, path, body);
        return HttpResponse.Parse(raw);
    }

    /// <summary>Sends a GET request and returns the response body.</summary>
    async string GetAsync(string path) {
        string raw = await RequestAsync("GET", path, "");
        HttpResponse resp = HttpResponse.Parse(raw);
        return resp.body;
    }

    /// <summary>Sends a POST request with form data.</summary>
    async string PostAsync(string path, string body) {
        string raw = await RequestAsync("POST", path, body);
        HttpResponse resp = HttpResponse.Parse(raw);
        return resp.body;
    }

    /// <summary>Sends a PUT request.</summary>
    async string PutAsync(string path, string body) {
        string raw = await RequestAsync("PUT", path, body);
        HttpResponse resp = HttpResponse.Parse(raw);
        return resp.body;
    }

    /// <summary>Sends a DELETE request.</summary>
    async string DeleteAsync(string path) {
        string raw = await RequestAsync("DELETE", path, "");
        HttpResponse resp = HttpResponse.Parse(raw);
        return resp.body;
    }

    /// <summary>Quick static https GET (one-shot); verification stays on, so
    /// the server certificate must chain to a trusted CA.</summary>
    static async string GetHttpsAsync(string host, int port, string path) {
        HttpClient client = HttpClient.CreateHttps(host, port);
        string r = await client.GetAsync(path);
        return r;
    }

    /// <summary>Quick static GET method (one-shot).</summary>
    static async string GetAsync(string host, int port, string path) {
        HttpClient client = HttpClient.Create(host, port);
        string r = await client.GetAsync(path);
        return r;
    }

    /// <summary>Quick static POST method (one-shot).</summary>
    static async string PostAsync(string host, int port, string path, string body) {
        HttpClient client = HttpClient.Create(host, port);
        string r = await client.PostAsync(path, body);
        return r;
    }

    /// <summary>Downloads content to a file.</summary>
    static async void DownloadFileAsync(string host, int port, string path, string localPath) {
        string body = await HttpClient.GetAsync(host, port, path);
        nint fp = fopen(localPath, "wb");
        if (fp != 0) {
            // fwrite, not fputs: a body with a NUL byte must not be truncated.
            long _w = fwrite(body, 1, body.Length, fp);
            fclose(fp);
        }
    }

    // Byte-wise substring search (no per-character Substring allocations).
    static int IndexOf(string s, string needle, int from) {
        int n = s.Length;
        int m = needle.Length;
        if (m == 0) { return from; }
        int i = from;
        while (i + m <= n) {
            int j = 0;
            while (j < m && (s[i + j] & 255) == (needle[j] & 255)) { j = j + 1; }
            if (j == m) { return i; }
            i = i + 1;
        }
        return -1;
    }

    // Parses a hexadecimal chunk-size prefix, stopping at the first non-hex
    // byte (e.g. ';' chunk extension or CR).
    static int ParseHex(string s) {
        int v = 0;
        int i = 0;
        while (i < s.Length) {
            int c = s[i] & 255;
            int d = 0 - 1;
            if (c >= 48 && c <= 57) { d = c - 48; }
            else if (c >= 97 && c <= 102) { d = c - 97 + 10; }
            else if (c >= 65 && c <= 70) { d = c - 65 + 10; }
            else { i = s.Length; }
            if (d >= 0) { v = v * 16 + d; }
            i = i + 1;
        }
        return v;
    }

    static void AppendText(string file, string s) {
        nint fp = fopen(file, "ab");
        if (fp != 0) {
            fputs(s, fp);
            fclose(fp);
        }
    }

    static void TruncateFile(string file) {
        nint fp = fopen(file, "wb");
        if (fp != 0) { fclose(fp); }
    }

    // True when the response head advertises chunked transfer-encoding.
    // Callers must pass the head only (bytes before "\r\n\r\n"), never the
    // whole buffer: a body whose text contains the word would misdetect.
    static bool HeadIsChunked(string head) {
        int i = 0;
        int n = head.Length;
        // Scan for "chunked" preceded by a transfer-encoding header; a plain
        // case-insensitive contains is enough here since response headers do
        // not carry the word elsewhere.
        while (i + 7 <= n) {
            int a = head[i] & 255;
            if (a == 99 || a == 67) {
                if (HttpClient.AsciiNameEquals(head.Substring(i, 7), "chunked", 7)) {
                    return true;
                }
            }
            i = i + 1;
        }
        return false;
    }

    // Parses the numeric status code out of "HTTP/1.1 200 OK".
    static int HeadStatus(string head) {
        int sp = HttpClient.IndexOf(head, " ", 0);
        if (sp < 0) { return 0; }
        int code = 0;
        int i = sp + 1;
        while (i < head.Length && (head[i] & 255) >= 48 && (head[i] & 255) <= 57) {
            code = code * 10 + ((head[i] & 255) - 48);
            i = i + 1;
        }
        return code;
    }

    /// <summary>Streams a response body to <paramref name="outFile"/> as it
    /// arrives (decoding chunked transfer-encoding), so a caller polling the
    /// file sees incremental output -- e.g. a text/event-stream (SSE) reply.
    /// The timeout is an IDLE window here, not a total budget: every received
    /// chunk re-arms it, so a long-lived stream survives as long as the peer
    /// keeps sending, while a silent peer still gets hung up on.
    /// Never throws: the outcome is written to <paramref name="doneFile"/> as
    /// "ok" on a clean end or "err: ..." otherwise (including a non-2xx status,
    /// whose error body is still streamed to outFile).</summary>
    async int PostSseToFileAsync(string path, string body, string outFile, string doneFile) {
        SseSink sink = SseSink.ToFile(outFile, doneFile);
        int r = await this.PostSseToSinkAsync(path, body, sink);
        sink.Dispose();
        return r;
    }

    /// <summary>Same stream, but delivered to an <see cref="SseSink"/>. A
    /// memory sink keeps the whole exchange inside the process: the request
    /// can run on a worker thread while the thread that renders the answer
    /// drains the sink, with no temporary files and no helper process.
    /// </summary>
    async int PostSseToSinkAsync(string path, string body, SseSink sink) {
        sink.Begin();
        Socket.Initialize();
        TcpClient conn = await TcpClient.ConnectAsync(this.host, this.port, this.timeout);
        if (conn == null) {
            sink.Finish("err: connect to " + this.host + " failed");
            return 0;
        }

        TlsStream stream = null;
        TlsContext ctx = null;
        if (this.useTls) {
            if (this.clientCertificateFile.Length > 0
                && this.clientPrivateKeyFile.Length > 0) {
                ctx = TlsContext.CreateClientWithCertificate(
                    this.clientCertificateFile, this.clientPrivateKeyFile);
            } else {
                ctx = TlsContext.CreateClient();
            }
            if (ctx == null) {
                conn.Close();
                sink.Finish("err: TLS context");
                return 0;
            }
            if (!this.verifyTls) { ctx.DisableVerify(); }
            this.ApplyPinning(ctx);
            stream = await TlsStream.ConnectAsync(ctx, conn.Sock(), this.host);
            if (stream == null) {
                conn.Close();
                ctx.Free();
                sink.Finish("err: TLS handshake with " + this.host + " failed");
                return 0;
            }
        }

        int watch = HttpDeadline.Arm(conn.Sock(), this.timeout);
        string requestData = BuildRequest("POST", path, body);
        if (this.useTls) {
            int _s = await stream.SendAsync(requestData, requestData.Length);
        } else {
            int _s2 = await conn.SendAsync(requestData);
        }

        // Read the response head so we can split status/headers from the body.
        // The scan restarts a few bytes back rather than from 0, and the head
        // is capped so a peer that never sends the blank line cannot grow the
        // buffer without bound.
        string head = "";
        int hb = 0 - 1;
        while (hb < 0 && head.Length < 262144) {
            string c;
            if (this.useTls) { c = await stream.RecvAsync(65536); }
            else { c = await conn.RecvAsync(65536); }
            if (c.Length == 0) { break; }
            int scanFrom = head.Length - 3;
            if (scanFrom < 0) { scanFrom = 0; }
            head = head + c;
            hb = HttpClient.IndexOf(head, "\r\n\r\n", scanFrom);
            HttpDeadline.Touch(watch, this.timeout);
        }

        // No header terminator: the peer closed early, timed out, or sent an
        // oversized head. Fail cleanly instead of parsing garbage as a body.
        if (hb < 0) {
            HttpDeadline.Disarm(watch);
            if (this.useTls) { stream.Close(); conn.Close(); ctx.Free(); }
            else { conn.Close(); }
            sink.Finish("err: no response head");
            return 0;
        }

        string headOnly = head.Substring(0, hb);
        int status = HttpClient.HeadStatus(headOnly);
        bool chunked = HttpClient.HeadIsChunked(headOnly);
        string pending = head.Substring(hb + 4, head.Length - hb - 4);
        head = "";
        headOnly = "";

        bool finished = false;
        // A stream only counts as done when the peer said so: the [DONE] sentinel
        // (or, for chunked replies, the terminating zero-size chunk). A 0-byte
        // read means the connection dropped mid-stream -- the model may have
        // been cut off before finishing -- so that is a retryable failure, not
        // a success, and the caller (AiNet.Worker) will retry it.
        bool cleanEnd = false;
        string doneScan = "";
        bool sawDone = false;
        while (!finished) {
            if (chunked) {
                bool progressed = true;
                while (progressed) {
                    progressed = false;
                    int crlf = HttpClient.IndexOf(pending, "\r\n", 0);
                    if (crlf < 0) { progressed = false; }
                    else {
                        string sizeLine = pending.Substring(0, crlf);
                        int size = HttpClient.ParseHex(sizeLine);
                        if (size == 0) {
                            finished = true;
                            cleanEnd = true;
                            progressed = false;
                        } else {
                            int need = crlf + 2 + size + 2;
                            if (pending.Length >= need) {
                                string piece = pending.Substring(crlf + 2, size);
                                sink.Write(piece);
                                doneScan = doneScan + piece;
                                if (doneScan.Length > 64) {
                                    doneScan = doneScan.Substring(doneScan.Length - 64, 64);
                                }
                                if (HttpClient.IndexOf(doneScan, "[DONE]", 0) >= 0) {
                                    sawDone = true;
                                }
                                pending = pending.Substring(need, pending.Length - need);
                                progressed = true;
                            }
                        }
                    }
                }
            } else {
                if (pending.Length > 0) {
                    sink.Write(pending);
                    doneScan = doneScan + pending;
                    if (doneScan.Length > 64) {
                        doneScan = doneScan.Substring(doneScan.Length - 64, 64);
                    }
                    if (HttpClient.IndexOf(doneScan, "[DONE]", 0) >= 0) {
                        sawDone = true;
                    }
                    pending = "";
                }
            }
            if (sawDone) { finished = true; cleanEnd = true; }
            if (finished) {
                // reached the terminal chunk
            } else {
                string c;
                if (this.useTls) { c = await stream.RecvAsync(65536); }
                else { c = await conn.RecvAsync(65536); }
                if (c.Length == 0) { finished = true; }
                else {
                    pending = pending + c;
                    // Data arrived: restart the idle window so a healthy
                    // long-lived stream is never cut off mid-flight.
                    if (!HttpDeadline.Expired(watch)) {
                        HttpDeadline.Touch(watch, this.timeout);
                    }
                }
            }
        }
        bool late = HttpDeadline.Expired(watch);
        HttpDeadline.Disarm(watch);
        if (this.useTls) {
            stream.Close();
            conn.Close();
            ctx.Free();
        } else {
            conn.Close();
        }

        if (late) {
            sink.Finish("err: timeout");
        } else if (!cleanEnd) {
            // The peer closed before the terminal chunk: the stream was cut
            // off, so surface it as a retryable failure instead of a success.
            sink.Finish("err: connection closed");
        } else if (status >= 200 && status < 300) {
            sink.Finish("ok");
        } else if (status == 0) {
            sink.Finish("err: no response");
        } else {
            sink.Finish("err: HTTP " + Convert.ToString(status));
        }
        return 0;
    }

    // True when the final bytes of `s` equal `suf` (ASCII case-insensitive).
    static bool EndsWithCi(string s, string suf) {
        int sl = s.Length;
        int fl = suf.Length;
        if (sl < fl) { return false; }
        return HttpClient.AsciiNameEquals(s.Substring(sl - fl, fl), suf, fl);
    }

    // Maps a filename suffix to a content type, defaulting to octet-stream.
    static string GuessMime(string name) {
        if (HttpClient.EndsWithCi(name, ".png")) { return "image/png"; }
        if (HttpClient.EndsWithCi(name, ".jpg")
            || HttpClient.EndsWithCi(name, ".jpeg")) { return "image/jpeg"; }
        if (HttpClient.EndsWithCi(name, ".gif")) { return "image/gif"; }
        if (HttpClient.EndsWithCi(name, ".txt")) { return "text/plain"; }
        if (HttpClient.EndsWithCi(name, ".json")) { return "application/json"; }
        if (HttpClient.EndsWithCi(name, ".pdf")) { return "application/pdf"; }
        return "application/octet-stream";
    }

    // Reads an integer-valued response header (case-insensitive, matched at a
    // line start), e.g. HeaderInt(head, "content-length"). 0 when absent.
    static int HeaderInt(string head, string lowerName) {
        int n = head.Length;
        int nl = lowerName.Length;
        int i = 0;
        while (i + nl <= n) {
            if ((i == 0 || (head[i - 1] & 255) == 10)
                && HttpClient.AsciiNameEquals(head.Substring(i, nl), lowerName, nl)) {
                int j = i + nl;
                while (j < n && ((head[j] & 255) == 32 || (head[j] & 255) == 58)) {
                    j = j + 1;
                }
                int v = 0;
                bool any = false;
                while (j < n && (head[j] & 255) >= 48 && (head[j] & 255) <= 57) {
                    v = v * 10 + ((head[j] & 255) - 48);
                    j = j + 1;
                    any = true;
                }
                if (any) { return v; }
            }
            i = i + 1;
        }
        return 0;
    }

    // Total resource size from a "Content-Range: bytes X-Y/Z" header (the Z),
    // or 0 when there is no such header.
    static int RangeTotal(string head) {
        int n = head.Length;
        string key = "content-range";
        int kl = key.Length;
        int idx = 0 - 1;
        int i = 0;
        while (i + kl <= n) {
            if ((i == 0 || (head[i - 1] & 255) == 10)
                && HttpClient.AsciiNameEquals(head.Substring(i, kl), key, kl)) {
                idx = i;
                i = n;
            } else {
                i = i + 1;
            }
        }
        if (idx < 0) { return 0; }
        int slash = HttpClient.IndexOf(head, "/", idx);
        if (slash < 0) { return 0; }
        int v = 0;
        bool any = false;
        int j = slash + 1;
        while (j < n && (head[j] & 255) >= 48 && (head[j] & 255) <= 57) {
            v = v * 10 + ((head[j] & 255) - 48);
            j = j + 1;
            any = true;
        }
        if (any) { return v; }
        return 0;
    }

    /// <summary>Uploads a local file to <paramref name="path"/> as one
    /// multipart/form-data field (<paramref name="field"/> is the form name,
    /// <paramref name="fileName"/> the name reported to the server). Reads the
    /// whole file into memory, so it suits modest files. Returns the parsed
    /// response.</summary>
    async HttpResponse UploadFileAsync(string path, string field,
            string localPath, string fileName) {
        string fileData = File.ReadAllText(localPath);
        string boundary = "----ZanFormBoundary"
            + Convert.ToString(fileData.Length) + "z" + Convert.ToString(field.Length);
        StringBuilder sb = new StringBuilder();
        sb.Append("--");
        sb.Append(boundary);
        sb.Append("\r\n");
        sb.Append("Content-Disposition: form-data; name=\"");
        sb.Append(field);
        sb.Append("\"; filename=\"");
        sb.Append(fileName);
        sb.Append("\"\r\n");
        sb.Append("Content-Type: ");
        sb.Append(HttpClient.GuessMime(fileName));
        sb.Append("\r\n\r\n");
        sb.Append(fileData);
        sb.Append("\r\n--");
        sb.Append(boundary);
        sb.Append("--\r\n");
        string bodyStr = sb.ToString();
        if (!this.HasHeaderName("Content-Type")) {
            this.SetHeader("Content-Type",
                "multipart/form-data; boundary=" + boundary);
        }
        string raw = await this.RequestAsync("POST", path, bodyStr);
        return HttpResponse.Parse(raw);
    }

    /// <summary>Downloads <paramref name="path"/> to
    /// <paramref name="localPath"/>, resuming an interrupted transfer. The
    /// timeout is an idle window (re-armed by every received chunk), so a big
    /// file on a slow link is not aborted mid-transfer. It sends
    /// `Range: bytes=&lt;existing&gt;-` so a server that supports ranges (HTTP
    /// 206) continues where the local file left off instead of restarting; a
    /// server that ignores it (200) restarts from scratch, and 416 means the
    /// file is already complete. Progress ("&lt;received&gt;/&lt;total&gt;") is
    /// written to <paramref name="progressFile"/> as bytes arrive. Returns the
    /// byte count now on disk, or -1 on a connection/handshake failure.</summary>
    async int DownloadRangeToFileAsync(string path, string localPath,
            string progressFile) {
        int have = 0;
        nint probe = fopen(localPath, "rb");
        if (probe != 0) {
            fseek(probe, 0, 2);
            have = ftell(probe);
            fclose(probe);
        }

        Socket.Initialize();
        TcpClient conn = await TcpClient.ConnectAsync(this.host, this.port, this.timeout);
        if (conn == null) { return 0 - 1; }
        TlsStream stream = null;
        TlsContext ctx = null;
        if (this.useTls) {
            if (this.clientCertificateFile.Length > 0
                && this.clientPrivateKeyFile.Length > 0) {
                ctx = TlsContext.CreateClientWithCertificate(
                    this.clientCertificateFile, this.clientPrivateKeyFile);
            } else {
                ctx = TlsContext.CreateClient();
            }
            if (ctx == null) { conn.Close(); return 0 - 1; }
            if (!this.verifyTls) { ctx.DisableVerify(); }
            this.ApplyPinning(ctx);
            stream = await TlsStream.ConnectAsync(ctx, conn.Sock(), this.host);
            if (stream == null) { conn.Close(); ctx.Free(); return 0 - 1; }
        }

        int watch = HttpDeadline.Arm(conn.Sock(), this.timeout);
        StringBuilder sb = new StringBuilder();
        sb.Append("GET ");
        sb.Append(path);
        sb.Append(" HTTP/1.1\r\n");
        sb.Append("Host: ");
        sb.Append(this.host);
        sb.Append("\r\n");
        int hi = 0;
        while (hi < this.defaultHeaders.Count) {
            sb.Append(this.defaultHeaders[hi]);
            sb.Append("\r\n");
            hi = hi + 1;
        }
        if (have > 0) {
            sb.Append("Range: bytes=");
            sb.Append(Convert.ToString(have));
            sb.Append("-\r\n");
        }
        sb.Append("Connection: close\r\n\r\n");
        string req = sb.ToString();
        if (this.useTls) { int _s = await stream.SendAsync(req, req.Length); }
        else { int _s2 = await conn.SendAsync(req); }

        string head = "";
        int hb = 0 - 1;
        while (hb < 0 && head.Length < 262144) {
            string c;
            if (this.useTls) { c = await stream.RecvAsync(65536); }
            else { c = await conn.RecvAsync(65536); }
            if (c.Length == 0) { break; }
            int scanFrom = head.Length - 3;
            if (scanFrom < 0) { scanFrom = 0; }
            head = head + c;
            hb = HttpClient.IndexOf(head, "\r\n\r\n", scanFrom);
            HttpDeadline.Touch(watch, this.timeout);
        }
        // No header terminator: peer closed early / timed out / oversized head.
        if (hb < 0) {
            HttpDeadline.Disarm(watch);
            if (this.useTls) { stream.Close(); conn.Close(); ctx.Free(); }
            else { conn.Close(); }
            return 0 - 1;
        }
        string headOnly = head.Substring(0, hb);
        int status = HttpClient.HeadStatus(headOnly);
        bool chunked = HttpClient.HeadIsChunked(headOnly);
        string pending = head.Substring(hb + 4, head.Length - hb - 4);
        // Range parsing below still needs the header text.
        head = headOnly;

        // 416 Range Not Satisfiable: the file is already fully downloaded.
        if (status == 416) {
            HttpDeadline.Disarm(watch);
            if (this.useTls) { stream.Close(); conn.Close(); ctx.Free(); }
            else { conn.Close(); }
            File.WriteAllText(progressFile,
                Convert.ToString(have) + "/" + Convert.ToString(have));
            return have;
        }

        bool resume = status == 206;
        int total = HttpClient.RangeTotal(head);
        int written = 0;
        if (resume) {
            written = have;
            if (total <= 0) {
                int cl = HttpClient.HeaderInt(head, "content-length");
                if (cl > 0) { total = have + cl; }
            }
        } else {
            have = 0;
            if (total <= 0) { total = HttpClient.HeaderInt(head, "content-length"); }
        }

        string mode = "wb";
        if (resume) { mode = "ab"; }
        nint outfp = fopen(localPath, mode);
        if (outfp == 0) {
            HttpDeadline.Disarm(watch);
            if (this.useTls) { stream.Close(); conn.Close(); ctx.Free(); }
            else { conn.Close(); }
            return 0 - 1;
        }

        bool finished = false;
        while (!finished) {
            if (chunked) {
                bool progressed = true;
                while (progressed) {
                    progressed = false;
                    int crlf = HttpClient.IndexOf(pending, "\r\n", 0);
                    if (crlf >= 0) {
                        int size = HttpClient.ParseHex(pending.Substring(0, crlf));
                        if (size == 0) {
                            finished = true;
                        } else {
                            int need = crlf + 2 + size + 2;
                            if (pending.Length >= need) {
                                string piece = pending.Substring(crlf + 2, size);
                                int _w = (int)fwrite(piece, 1, piece.Length, outfp);
                                written = written + piece.Length;
                                pending = pending.Substring(need, pending.Length - need);
                                progressed = true;
                            }
                        }
                    }
                }
            } else {
                if (pending.Length > 0) {
                    int _w2 = (int)fwrite(pending, 1, pending.Length, outfp);
                    written = written + pending.Length;
                    pending = "";
                }
                if (total > 0 && written >= total) { finished = true; }
            }
            File.WriteAllText(progressFile,
                Convert.ToString(written) + "/" + Convert.ToString(total));
            if (!finished) {
                string c;
                if (this.useTls) { c = await stream.RecvAsync(65536); }
                else { c = await conn.RecvAsync(65536); }
                if (c.Length == 0) { finished = true; }
                else {
                    pending = pending + c;
                    // A download larger than timeout*bandwidth must not be cut
                    // off while it is making progress: the deadline is an idle
                    // window, restarted by every received chunk.
                    if (!HttpDeadline.Expired(watch)) {
                        HttpDeadline.Touch(watch, this.timeout);
                    }
                }
            }
        }
        fclose(outfp);

        bool late = HttpDeadline.Expired(watch);
        HttpDeadline.Disarm(watch);
        if (this.useTls) { stream.Close(); conn.Close(); ctx.Free(); }
        else { conn.Close(); }
        File.WriteAllText(progressFile,
            Convert.ToString(written) + "/" + Convert.ToString(total));
        if (late) { return 0 - 1; }
        return written;
    }
}

