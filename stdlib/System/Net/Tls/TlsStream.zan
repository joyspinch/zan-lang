using System;
using System.Net.Sockets;
using System.Security.Cryptography;

namespace System.Net.Tls;

/// <summary>
/// TLS 上下文：封装 OpenSSL 的 SSL_CTX。每个服务器（带
/// 证书 + 私钥）或每个客户端创建一个，再据此为每个连接派生
/// <see cref="TlsStream"/>。
///
/// 服务器端：
///   TlsContext tls = TlsContext.CreateServer("cert.pem", "key.pem");
///   TlsStream s = await TlsStream.AcceptAsync(tls, clientSock);
///
/// 客户端：
///   TlsContext tls = TlsContext.CreateClient();
///   TlsStream s = await TlsStream.ConnectAsync(tls, sock, "example.com");
/// </summary>
class TlsContext {
    [DllImport("ssl")]
    static extern string TLS_server_method();
    [DllImport("ssl")]
    static extern string TLS_client_method();
    [DllImport("ssl")]
    static extern string SSL_CTX_new(string method);
    [DllImport("ssl")]
    static extern void SSL_CTX_free(string ctx);
    [DllImport("ssl")]
    static extern int SSL_CTX_use_certificate_chain_file(string ctx, string file);
    [DllImport("ssl")]
    static extern int SSL_CTX_use_PrivateKey_file(string ctx, string file, int type);
    [DllImport("ssl")]
    static extern int SSL_CTX_check_private_key(string ctx);
    [DllImport("ssl")]
    static extern void SSL_CTX_set_verify(string ctx, int mode, string callback);
    [DllImport("ssl")]
    static extern int SSL_CTX_set_default_verify_paths(string ctx);
    [DllImport("ssl")]
    static extern string SSL_CTX_get_cert_store(string ctx);
    [DllImport("crypto")]
    static extern long ERR_get_error();
    [DllImport("crypto")]
    static extern string d2i_X509(string px, byte[] pp, int len);
    [DllImport("crypto")]
    static extern int X509_STORE_add_cert(string store, string x);
    [DllImport("crypto")]
    static extern void X509_free(string x);
    [DllImport("crt", EntryPoint = "memcpy")]
    static extern nint PlatMemCopyIn(byte[] dst, nint src, long n);
    [DllImport("crt", EntryPoint = "memcpy")]
    static extern nint PlatMemCopyOut(nint dst, string src, long n);
    #if WINDOWS
    [DllImport("crypt32", EntryPoint = "CertOpenSystemStoreA")]
    static extern nint CertOpenSystemStore(nint prov, string name);
    [DllImport("crypt32")]
    static extern nint CertEnumCertificatesInStore(nint store, nint prev);
    [DllImport("crypt32")]
    static extern int CertCloseStore(nint store, int flags);
    [DllImport("crt", EntryPoint = "zan_crypto_cert_encoded")]
    static extern nint CertEncoded(nint cert, nint outLen);
    #endif

    string ctx;
    bool server;
    string error;
    // 对端证书校验是否启用（客户端：链 + 主机名）。默认开启，
    // DisableVerify() 关闭——关闭后握手只加密不校验，
    // 用于本地开发，绝不用于生产。
    bool verify;
    // 公钥（SPKI）固定（pinning）：服务器
    // SubjectPublicKeyInfo 的 base64 SHA-256。启用且非空时，若握手的对端公钥
    // 哈希不匹配任何 pin，客户端将拒绝握手——从而挫败
    // 持有系统信任的合法证书的中间人（MITM）攻击。
    List<string> pins;
    bool pinRequired;

    TlsContext() {
        this.ctx = null;
        this.server = false;
        this.error = "";
        this.verify = true;
        this.pins = null;
        this.pinRequired = false;
    }

    /// <summary>添加一个可接受的服务器公钥 pin：即
    /// DER SubjectPublicKeyInfo 的 base64 SHA-256（即由
    /// `openssl ... -pubkey | openssl pkey -pubin -outform der
    /// | openssl dgst -sha256 -binary | base64` 命令得到的值）。</summary>
    void AddPin(string spkiSha256Base64) {
        if (this.pins == null) { this.pins = new List<string>(); }
        this.pins.Add(spkiSha256Base64);
    }

    /// <summary>开关 pin 强制校验。发布构建始终开启，保证
    /// 发布的二进制始终校验配置的 pin；HTTP 客户端中的开发开关
    /// 是唯一可以放宽它的途径。</summary>
    void RequirePinning(bool on) {
        this.pinRequired = on;
    }

    /// <summary>当握手必须满足至少一个已配置的
    /// pin 时为 true。</summary>
    bool PinningActive() {
        return this.pinRequired && this.pins != null && this.pins.Count > 0;
    }

    /// <summary>`got`（base64 的 SPKI SHA-256）与任一 pin 匹配时为 true。</summary>
    bool PinMatches(string got) {
        if (this.pins == null) { return false; }
        for (int i = 0; i < this.pins.Count; i = i + 1) {
            if (this.pins[i] == got) { return true; }
        }
        return false;
    }

    /// <summary>从 PEM 证书链
    /// 和 PEM 私钥创建服务器端 TLS 上下文。失败（路径错误/私钥
    /// 不匹配）时返回 null；原因见 LastError()。</summary>
    static TlsContext CreateServer(string certFile, string keyFile) {
        TlsContext c = new TlsContext();
        c.server = true;
        TlsStream.SetLastError("");
        string method = TLS_server_method();
        if (method == null) {
            TlsStream.SetLastError("OpenSSL 未链接或不可用（ssl driver dylib 未参与链接；"
                + "常见于使用旧版编译器 publish）。请重新编译 zanc 后重新 publish");
            return null;
        }
        c.ctx = SSL_CTX_new(method);
        if (c.ctx == null) {
            TlsStream.SetLastError("SSL_CTX_new 失败（OpenSSL 错误码："
                + Convert.ToString(ERR_get_error()) + "）");
            return null;
        }
        // 1 = SSL_FILETYPE_PEM
        if (SSL_CTX_use_certificate_chain_file(c.ctx, certFile) != 1) {
            SSL_CTX_free(c.ctx);
            return null;
        }
        if (SSL_CTX_use_PrivateKey_file(c.ctx, keyFile, 1) != 1) {
            SSL_CTX_free(c.ctx);
            return null;
        }
        if (SSL_CTX_check_private_key(c.ctx) != 1) {
            SSL_CTX_free(c.ctx);
            return null;
        }
        return c;
    }

    /// <summary>创建客户端 TLS 上下文。证书校验
    /// 使用系统默认信任库；如需自签名开发服务器，可调用
    /// DisableVerify()。</summary>
    static TlsContext CreateClient() {
        TlsContext c = new TlsContext();
        c.server = false;
        TlsStream.SetLastError("");
        string method = TLS_client_method();
        if (method == null) {
            TlsStream.SetLastError("OpenSSL 未链接或不可用（ssl driver dylib 未参与链接；"
                + "常见于使用旧版编译器 publish）。请重新编译 zanc 后重新 publish");
            return null;
        }
        c.ctx = SSL_CTX_new(method);
        if (c.ctx == null) {
            TlsStream.SetLastError("SSL_CTX_new 失败（OpenSSL 错误码："
                + Convert.ToString(ERR_get_error()) + "）");
            return null;
        }
        int _v = SSL_CTX_set_default_verify_paths(c.ctx);
        #if WINDOWS
        // Windows 上没有 OpenSSL 编译时内置的默认信任路径，
        // 因此模仿基于 schannel 的工具（curl）免费获得的能力：把
        // 计算机/用户 ROOT 证书库导入该上下文的 X509_STORE。
        TlsContext.LoadSystemRootsWindows(c.ctx);
        #endif
        // 1 = SSL_VERIFY_PEER
        SSL_CTX_set_verify(c.ctx, 1, null);
        return c;
    }

    /// <summary>创建带 PEM 证书链和对应 PEM 私钥的
    /// 客户端 TLS 上下文，用于双向 TLS 认证。</summary>
    static TlsContext CreateClientWithCertificate(string certFile, string keyFile) {
        TlsContext c = TlsContext.CreateClient();
        if (c == null) { return null; }
        if (SSL_CTX_use_certificate_chain_file(c.ctx, certFile) != 1) {
            c.Free();
            return null;
        }
        if (SSL_CTX_use_PrivateKey_file(c.ctx, keyFile, 1) != 1) {
            c.Free();
            return null;
        }
        if (SSL_CTX_check_private_key(c.ctx) != 1) {
            c.Free();
            return null;
        }
        return c;
    }

    /// <summary>禁用对端证书校验（仅限开发）。
    /// 0 = SSL_VERIFY_NONE。</summary>
    void DisableVerify() {
        this.verify = false;
        SSL_CTX_set_verify(this.ctx, 0, null);
    }

    // 从结构体的 ptr + off 处读取一个原生指针宽度的字段。
    static nint PtrAt(nint ptr, int off) {
        byte[] x = new byte[8];
        PlatMemCopyIn(x, ptr + off, 8);
        nint r = 0;
        nint m = 1;
        for (int k = 0; k < 8; k = k + 1) {
            r = r + (x[k] & 255) * m;
            m = m * 256;
        }
        return r;
    }

    // 从结构体的 ptr + off 处读取一个小端序 32 位字段。
    static int IntAt(nint ptr, int off) {
        byte[] x = new byte[4];
        PlatMemCopyIn(x, ptr + off, 4);
        return (x[0] & 255) + ((x[1] & 255) << 8)
            + ((x[2] & 255) << 16) + ((x[3] & 255) << 24);
    }

    #if WINDOWS
    // 枚举 Windows "ROOT" 证书库，把所有受信任的
    // 根证书（包括本地安装的代理/MITM CA）加入支撑 sslctx 的
    // OpenSSL X509_STORE，使校验结果与系统信任一致。
    static void LoadSystemRootsWindows(string sslctx) {
        nint store = CertOpenSystemStore(0, "ROOT");
        if (store == 0) { return; }
        string x509store = SSL_CTX_get_cert_store(sslctx);
        if (x509store == null) {
            CertCloseStore(store, 0);
            return;
        }
        nint cert = CertEnumCertificatesInStore(store, 0);
        while (cert != 0) {
            nint lenCell = NativeMemory.Alloc(4);
            nint der = TlsContext.CertEncoded(cert, lenCell);
            int len = new Span<int>(lenCell, 1)[0];
            NativeMemory.Free(lenCell);
            if (der != 0 && len > 0) {
                nint derCell = NativeMemory.Alloc(8);
                new Span<long>(derCell, 1)[0] = der;
                byte[] pp = new byte[8];
                PlatMemCopyIn(pp, derCell, 8);
                NativeMemory.Free(derCell);
                string x = d2i_X509(null, pp, len);
                if (x != null) {
                    X509_STORE_add_cert(x509store, x);
                    X509_free(x);
                }
            }
            cert = CertEnumCertificatesInStore(store, cert);
        }
        CertCloseStore(store, 0);
    }
    #endif

    // 从 PEM 字符串中抽出 base64 正文（BEGIN/END 标记之间）并解码为 DER。
    static byte[] PemBodyToDer(string pem, int expectedLen) {
        int begin = pem.IndexOf("BEGIN");
        if (begin < 0) { return null; }
        int nl = pem.IndexOf("\n", begin);
        if (nl < 0) { return null; }
        int end = pem.IndexOf("-----END", nl);
        if (end < 0) { return null; }
        // PEM 正文按 64 列折行（RFC 7468 软换行）。严格 base64
        // 解码前只剥离换行，正文中的其他字符仍保持严格校验。
        StringBuilder clean = new StringBuilder();
        for (int i = nl + 1; i < end; i = i + 1) {
            int c = pem[i] & 255;
            if (c != 10 && c != 13) { clean.Append(pem.Substring(i, 1)); }
        }
        string b64 = clean.ToString();
        List<int> derLen = new List<int>(); derLen.Add(0);
        byte[] der = Base64.Decode(b64, derLen);
        if (der == null || derLen[0] == 0 || (expectedLen > 0 && derLen[0] != expectedLen)) {
            return null;
        }
        return der;
    }

    /// <summary>把 PEM 格式的 CA（或自签名）证书加入本上下文的信任库，
    /// 使其签发的对端证书在链校验中被接受。返回 true 表示成功。
    /// 用于私有 CA 与测试（自签名开发服务器）。</summary>
    bool AddTrustedCert(string pemFile) {
        string pem = File.ReadAllText(pemFile);
        if (pem == "") { return false; }
        byte[] der = TlsContext.PemBodyToDer(pem, 0);
        if (der == null) { return false; }
        int n = der.Length;
        // 把 DER 复制到原生内存，再把「指向该内存的指针」写进 8 字节
        // 指针单元，最后让 d2i_X509 从该指针单元解析 X509。
        nint derMem = NativeMemory.Alloc(n);
        if (derMem == 0) { return false; }
        string derStr = der.ToStr(0, n);
        PlatMemCopyOut(derMem, derStr, n);
        // 指针单元 = derMem 的地址（小端，8 字节）。
        byte[] pp = new byte[8];
        long v = derMem;
        int k = 0;
        while (k < 8) {
            pp[k] = Bits.Shr64(v, 8 * k) & 255;
            k = k + 1;
        }
        string x = d2i_X509(null, pp, n);
        NativeMemory.Free(derMem);
        if (x == null) { return false; }
        string store = SSL_CTX_get_cert_store(this.ctx);
        if (store == null) {
            X509_free(x);
            return false;
        }
        int added = X509_STORE_add_cert(store, x);
        X509_free(x);
        return added == 1;
    }

    string Handle() {
        return this.ctx;
    }

    bool IsServer() {
        return this.server;
    }

    /// <summary>释放底层的 SSL_CTX。</summary>
    void Free() {
        if (this.ctx != null) {
            SSL_CTX_free(this.ctx);
            this.ctx = null;
        }
    }
}

/// <summary>
/// 非阻塞套接字上的一条 TLS 连接，由 OpenSSL 内存
/// BIO 驱动，因此所有套接字 IO 都经过协程 reactor（await
/// Socket.ReadReady / Socket.SendAsync），TLS 不会阻塞线程。
///
/// 加密字节在 socket &lt;-&gt; rbio/wbio 间流动；SSL_read/SSL_write 使
/// 明文出入 SSL 引擎。WANT_READ 时向 rbio 灌入一次套接字读取；
/// wbio 中待发的字节则在每次引擎步骤后
/// 刷回套接字。
/// </summary>
class TlsStream {
    [DllImport("ssl")]
    static extern string SSL_new(string ctx);
    [DllImport("ssl")]
    static extern void SSL_free(string ssl);
    [DllImport("ssl")]
    static extern void SSL_set_bio(string ssl, string rbio, string wbio);
    [DllImport("ssl")]
    static extern void SSL_set_accept_state(string ssl);
    [DllImport("ssl")]
    static extern void SSL_set_connect_state(string ssl);
    [DllImport("ssl")]
    static extern int SSL_do_handshake(string ssl);
    [DllImport("ssl")]
    static extern int SSL_read(string ssl, string buf, int num);
    [DllImport("ssl")]
    static extern int SSL_write(string ssl, string buf, int num);
    [DllImport("ssl")]
    static extern int SSL_get_error(string ssl, int ret);
    [DllImport("ssl")]
    static extern int SSL_shutdown(string ssl);
    [DllImport("ssl")]
    static extern int SSL_ctrl(string ssl, int cmd, int larg, string parg);
    [DllImport("ssl")]
    static extern string SSL_get0_param(string ssl);
    [DllImport("ssl")]
    static extern long SSL_get_verify_result(string ssl);

    [DllImport("crypto")]
    static extern int X509_VERIFY_PARAM_set1_host(string param, string name, long len);
    [DllImport("crypto")]
    static extern int X509_VERIFY_PARAM_set1_ip_asc(string param, string ipasc);
    [DllImport("crypto")]
    static extern void X509_VERIFY_PARAM_set_hostflags(string param, long flags);
    [DllImport("crypto")]
    static extern string X509_VERIFY_PARAM_get0_name(string param);

    [DllImport("crypto")]
    static extern string BIO_new(string method);
    [DllImport("crypto")]
    static extern string BIO_s_mem();
    [DllImport("crypto")]
    static extern int BIO_write(string bio, string data, int dlen);
    [DllImport("crypto")]
    static extern int BIO_read(string bio, string data, int dlen);
    [DllImport("crypto")]
    static extern int BIO_ctrl_pending(string bio);

    // 公钥固定（pinning）：读取对端证书的 SubjectPublicKeyInfo。
    [DllImport("ssl")]
    static extern string SSL_get1_peer_certificate(string ssl);
    [DllImport("crypto")]
    static extern string X509_get_X509_PUBKEY(string x);
    [DllImport("crypto")]
    static extern int i2d_X509_PUBKEY(string pubkey, byte[] pp);
    [DllImport("crypto")]
    static extern void X509_free(string x);
    [DllImport("crypto", EntryPoint = "CRYPTO_free")]
    static extern void OpenSslFree(nint p, string file, int line);
    [DllImport("crt", EntryPoint = "memcpy")]
    static extern nint PlatMemCopyIn(byte[] dst, nint src, long n);

    string ssl;
    string rbio;   // socket -> SSL（加密数据进入）
    string wbio;   // SSL -> socket（加密数据输出）
    nint sock;
    bool open;
    // 一个可复用的 16KB+ 暂存缓冲区，用于 BIO/套接字搬运（一条 TLS 记录
    // 最大 16KB；每条流分配一次，而非每次操作）
    byte[] scratch;
    static int SCRATCH = 17408;
    static string lastError = "";

    // C 的 `int` 返回值是零扩展的（C 的 -1 读到为 4294967295）；
    // 将其折回有符号 32 位，错误检查才能正常工作。
    static int Norm(int v) {
        if (v > 2147483647) { return v - 4294967296; }
        return v;
    }

    static string LastError() {
        return TlsStream.lastError;
    }

    static void SetLastError(string error) {
        TlsStream.lastError = error;
    }

    TlsStream() {
        this.ssl = null;
        this.rbio = null;
        this.wbio = null;
        this.sock = -1;
        this.open = false;
        this.scratch = null;
    }

    static TlsStream Setup(TlsContext ctx, nint sock) {
        TlsStream s = new TlsStream();
        s.ssl = SSL_new(ctx.Handle());
        if (s.ssl == null) { return null; }
        s.rbio = BIO_new(BIO_s_mem());
        s.wbio = BIO_new(BIO_s_mem());
        // SSL_set_bio 会把 BIO 的所有权转移给 SSL 对象。
        SSL_set_bio(s.ssl, s.rbio, s.wbio);
        s.sock = sock;
        s.scratch = new byte[SCRATCH + 1];
        s.open = true;
        return s;
    }

    /// <summary>服务器端：包装已接受的套接字并执行 TLS
    /// 握手。握手失败时返回 null。</summary>
    static async TlsStream AcceptAsync(TlsContext ctx, nint sock) {
        TlsStream s = Setup(ctx, sock);
        if (s == null) { return null; }
        SSL_set_accept_state(s.ssl);
        int ok = await s.HandshakeAsync();
        if (ok != 1) {
            s.Close();
            return null;
        }
        return s;
    }

    /// <summary>客户端：包装已连接的套接字，发送
    /// <paramref name="host"/> 的 SNI 并执行 TLS 握手。握手失败时
    /// 返回 null。</summary>
    static async TlsStream ConnectAsync(TlsContext ctx, nint sock, string host) {
        TlsStream.SetLastError("");
        TlsStream s = Setup(ctx, sock);
        if (s == null) {
            TlsStream.SetLastError("SSL 对象初始化失败");
            return null;
        }
        SSL_set_connect_state(s.ssl);
        if (host != null && host.Length > 0) {
            // 55 = SSL_CTRL_SET_TLSEXT_HOSTNAME, 0 = TLSEXT_NAMETYPE_host_name
            int _sni = SSL_ctrl(s.ssl, 55, 0, host);
            // 主机名校验（RFC 6125）：只校验证书链还不够——必须同时确认
            // 证书上的域名与调用方期望的主机一致，否则任何受信 CA 给任意
            // 域名签发的证书都能通过。通过 X509_VERIFY_PARAM 设置期望
            // 主机名；OpenSSL 会在链校验时把它与证书的 SAN/CN 比对，
            // 不匹配则 verify_result != X509_V_OK。
            // verify 被 DisableVerify() 关闭时不设主机名：该校验
            // 与链校验同属「对端证书校验」，关闭后应整体跳过。
            if (ctx.verify) {
                string param = SSL_get0_param(s.ssl);
                if (param != null) {
                    // 0x4 = X509_CHECK_FLAG_NO_PARTIAL_WILDCARDS（拒绝 *.example.com
                    // 匹配 a.b.example.com 这类部分通配，避免跳过子域名的校验）。
                    X509_VERIFY_PARAM_set_hostflags(param, 4);
                    int _hv;
                    if (TlsStream.IsIpLiteral(host)) {
                        // IP 直连：host 是 IPv4/IPv6 字面量，必须走 set1_ip_asc，
                        // 与证书 SAN 的 iPAddress 项比对（不能用 set1_host）。
                        _hv = X509_VERIFY_PARAM_set1_ip_asc(param, host);
                    } else {
                        _hv = X509_VERIFY_PARAM_set1_host(param, host, 0);
                    }
                    if (_hv != 1) {
                        TlsStream.SetLastError("TLS 主机名校验参数初始化失败");
                        s.Close();
                        return null;
                    }
                }
            }
        }
        int ok = await s.HandshakeAsync();
        if (ok != 1) {
            TlsStream.SetLastError("TLS 握手失败");
            s.Close();
            return null;
        }
        // 握手完成后再查一次 verify_result：即使握手的返回值看起来成功，
        // 若对端证书未被信任或主机名不匹配，也必须拒绝。0 = X509_V_OK。
        if (ctx.verify) {
            long vr = SSL_get_verify_result(s.ssl);
            if (vr != 0) {
                TlsStream.SetLastError("TLS 证书链或主机名校验失败（verify_result="
                    + Convert.ToString(vr) + "）");
                s.Close();
                return null;
            }
        }
        if (ctx.PinningActive()) {
            string got = TlsStream.SpkiPinOf(s.ssl);
            if (got == "" || !ctx.PinMatches(got)) {
                TlsStream.SetLastError("TLS 公钥 pin 校验失败");
                s.Close();
                return null;
            }
        }
        return s;
    }

    // host 是否为 IP 字面量（IPv4 点分十进制或 IPv6 含冒号）：
    // 是则主机名校验走 set1_ip_asc，否则走 set1_host。
    static bool IsIpLiteral(string host) {
        if (host == null || host.Length == 0) { return false; }
        bool hasColon = false;
        bool onlyDigitDot = true;
        int i = 0;
        while (i < host.Length) {
            int c = host[i] & 255;
            if (c == 58) { hasColon = true; }
            if (!((c >= 48 && c <= 57) || c == 46 || c == 58)) { onlyDigitDot = false; }
            i = i + 1;
        }
        return hasColon || onlyDigitDot;
    }

    /// <summary>对端证书 DER
    /// SubjectPublicKeyInfo 的 base64 SHA-256（即通过 TlsContext.AddPin 固定的值），
    /// 没有对端证书/编码时返回 ""。</summary>
    static string SpkiPinOf(string ssl) {
        string cert = SSL_get1_peer_certificate(ssl);
        if (cert == null) { return ""; }
        string pubkey = X509_get_X509_PUBKEY(cert);
        if (pubkey == null) {
            X509_free(cert);
            return "";
        }
        // 指针单元清零表示 *out == NULL，因此 i2d 会自行分配 DER
        // 缓冲区，并把指针写回 `cell`。
        byte[] cell = new byte[8];
        int len = Norm(i2d_X509_PUBKEY(pubkey, cell));
        X509_free(cert);
        if (len <= 0) { return ""; }
        nint der = 0;
        nint mul = 1;
        for (int k = 0; k < 8; k = k + 1) {
            der = der + (cell[k] & 255) * mul;
            mul = mul * 256;
        }
        if (der == 0) { return ""; }
        byte[] spki = new byte[len];
        PlatMemCopyIn(spki, der, len);
        OpenSslFree(der, null, 0);
        string spkiStr = spki.ToStr(0, len);
        byte[] digest = Sha256.Hash(spkiStr, len);
        string dstr = digest.ToStr(0, 32);
        return Base64.Encode(dstr, 32);
    }

    // 把 wbio 中待发的加密输出字节刷到套接字。
    // 必须保证 BIO 中读出的每一块都完整发出；否则截断的 TLS
    // 记录会导致握手/数据损坏。Socket.SendAsync 在内部已经循环
    // 重发，因此其返回值应等于请求发送的字节数；若不相等则
    // 视为连接已不可用。
    async int FlushOutAsync() {
        int pending = BIO_ctrl_pending(this.wbio);
        while (pending > 0) {
            int chunk = pending;
            if (chunk > SCRATCH) { chunk = SCRATCH; }
            int n = Norm(BIO_read(this.wbio, this.scratch, chunk));
            if (n <= 0) { return -1; }
            int sent = Norm(await Socket.SendAsync(this.sock, this.scratch, n));
            if (sent != n) { return -1; }
            pending = BIO_ctrl_pending(this.wbio);
        }
        return 0;
    }

    // 从套接字读取一块加密字节到 rbio。
    // 返回字节数，对端关闭时为 0，出错时为 -1。
    async int PumpInAsync() {
        while (true) {
            await Socket.ReadReady(this.sock);
            int n = Norm(Socket.Recv(this.sock, this.scratch, SCRATCH));
            if (n == 0) { return 0; }
            if (n > 0) {
                int w = Norm(BIO_write(this.rbio, this.scratch, n));
                if (w != n) { return -1; }
                return n;
            }
        }
        return -1;
    }

    /// <summary>驱动 TLS 握手直至完成。成功返回 1。</summary>
    async int HandshakeAsync() {
        while (true) {
            int r = Norm(SSL_do_handshake(this.ssl));
            int flushed = await FlushOutAsync();
            if (flushed < 0) { return -1; }
            if (r == 1) { return 1; }
            int err = SSL_get_error(this.ssl, r);
            // 2 = SSL_ERROR_WANT_READ, 3 = SSL_ERROR_WANT_WRITE
            if (err == 2) {
                int n = await PumpInAsync();
                if (n <= 0) { return -1; }
            } else if (err != 3) {
                return -1;
            }
        }
        return -1;
    }

    /// <summary>接收解密后的应用字节（最多
    /// <paramref name="max"/>，最多一个暂存缓冲区）。正常关闭或出错时
    /// 返回 ""。</summary>
    async string RecvAsync(int max) {
        if (!this.open) { return ""; }
        int want = max;
        if (want > SCRATCH) { want = SCRATCH; }
        while (true) {
            int n = Norm(SSL_read(this.ssl, this.scratch, want));
            if (n > 0) {
                return this.scratch.ToStr(0, n);
            }
            int err = SSL_get_error(this.ssl, n);
            int flushed = await FlushOutAsync();
            if (flushed < 0) { return ""; }
            if (err == 2) {
                int got = await PumpInAsync();
                if (got <= 0) { return ""; }
            } else if (err != 3) {
                return "";
            }
        }
        return "";
    }

    /// <summary>接收解密后的字节到调用方提供的缓冲区
    /// （二进制安全：返回字节数，不做 NUL 截断）。
    /// 正常关闭返回 0，出错返回 -1。</summary>
    async int RecvIntoAsync(string buf, int max) {
        if (!this.open) { return -1; }
        while (true) {
            int n = Norm(SSL_read(this.ssl, buf, max));
            if (n > 0) { return n; }
            int err = SSL_get_error(this.ssl, n);
            int flushed = await FlushOutAsync();
            if (flushed < 0) { return -1; }
            if (err == 2) {
                int got = await PumpInAsync();
                if (got == 0) { return 0; }
                if (got < 0) { return -1; }
            } else if (err != 3) {
                return -1;
            }
        }
        return -1;
    }

    /// <summary>加密并发送 <paramref name="len"/> 字节。成功返回
    /// 明文字节数，失败返回 -1。</summary>
    async int SendAsync(string data, int len) {
        if (!this.open) { return -1; }
        int off = 0;
        while (off < len) {
            int chunk = len - off;
            if (chunk > 16384) { chunk = 16384; }
            string part = data;
            if (off > 0 || chunk < len) {
                part = data.Substring(off, chunk);
            }
            int n = Norm(SSL_write(this.ssl, part, chunk));
            if (n <= 0) {
                int err = SSL_get_error(this.ssl, n);
                int flushed = await FlushOutAsync();
                if (flushed < 0) { return -1; }
                if (err == 2) {
                    int got = await PumpInAsync();
                    if (got <= 0) { return -1; }
                } else if (err != 3) {
                    return -1;
                }
            } else {
                off = off + n;
                int flushed = await FlushOutAsync();
                if (flushed < 0) { return -1; }
            }
        }
        return len;
    }

    /// <summary>发送整个字符串（其 .Length 个字节）。</summary>
    async int SendStringAsync(string data) {
        return await SendAsync(data, data.Length);
    }

    /// <summary>发送 TLS close_notify 警告并释放 SSL 引擎。
    /// 底层套接字仍归调用方所有（且必须由其关闭）。</summary>
    void Close() {
        if (this.ssl != null) {
            if (this.open) {
                int _s = SSL_shutdown(this.ssl);
                // 尽力把 close_notify 全部发出；每次从 BIO 读出后
                // 循环发送直到这块字节写完或出错，避免截断 TLS 记录。
                int pending = BIO_ctrl_pending(this.wbio);
                while (pending > 0 && pending <= SCRATCH) {
                    int n = BIO_read(this.wbio, this.scratch, pending);
                    if (n <= 0) { break; }
                    int sent = Socket.Send(this.sock, this.scratch, n);
                    if (sent <= 0) { break; }
                    if (sent < n) {
                        // 同步 Send 发生了短写，继续尝试发送剩余字节
                        int offset = sent;
                        while (offset < n) {
                            string tail = this.scratch.Substring(offset, n - offset);
                            int r = Socket.Send(this.sock, tail, n - offset);
                            if (r <= 0) { break; }
                            offset = offset + r;
                        }
                        if (offset < n) { break; }
                    }
                    pending = BIO_ctrl_pending(this.wbio);
                }
            }
            SSL_free(this.ssl);
            this.ssl = null;
        }
        this.scratch = null;
        this.open = false;
    }
}
