using System;
using System.IO;
using System.Net.Sockets;
using System.Net.Http;
using System.Security.Cryptography;

namespace System.Net.Tls;

/// <summary>
/// 证书策略委托：客户端握手后若链/主机名校验不通过（verifyResult != 0），
/// 以 (verifyResult, 对端证书文本) 调用；返回 true 放行本次连接，false 拒绝。
/// 证书文本形如 "issuer=/CN=.../O=... subject=/CN=example.com"。
/// </summary>
delegate bool CertPolicyFn(long verifyResult, string certText);

/// <summary>
/// 纯 Zan 原生 TLS 上下文。
/// 记录与握手无 OpenSSL 依赖；Windows 客户端系统信任经 Crypt32 SSL 链策略验证。
/// </summary>
class TlsContext {
    bool server;
    string error;
    bool verify;
    bool disableTls13;
    string certFile;
    string keyFile;
    string trust;
    List<string> pins;
    bool pinRequired;
    CertPolicyFn certPolicy;
    List<X509Certificate> trustedCerts;
    List<X509Certificate> cachedChain;
    X509Certificate cachedCert;
    RsaKey cachedKey;
    EcKey cachedEcKey;
    static int MAX_TRUST_BUNDLE_BYTES = 4194304;
    static int MAX_TRUST_CERT_BYTES = 32768;
    static int MAX_TRUST_CERTS = 2048;
    static int MAX_CHAIN_DER_BYTES = 131072;
    static string PEM_BEGIN = "-----BEGIN CERTIFICATE-----";
    static string PEM_END = "-----END CERTIFICATE-----";

    TlsContext() {
        this.server = false;
        this.error = "";
        this.verify = true;
        this.disableTls13 = false;
        this.certFile = null;
        this.keyFile = null;
        this.trust = "";
        this.pins = null;
        this.pinRequired = false;
        this.certPolicy = null;
        this.trustedCerts = null;
        this.cachedChain = null;
        this.cachedCert = null;
        this.cachedKey = null;
        this.cachedEcKey = null;
    }

    // Parse the entire bundle before changing the trust list. An invalid or oversized
    // input must not leave a partly installed set of additional trust anchors.
    static List<X509Certificate> ParseTrustBundle(string pem, bool strict) {
        if (pem == null || pem.Length == 0 || pem.Length > MAX_TRUST_BUNDLE_BYTES) { return null; }
        List<X509Certificate> certs = new List<X509Certificate>();
        int pos = 0;
        int seen = 0;
        while (pos < pem.Length) {
            int begin = pem.IndexOf(PEM_BEGIN, pos);
            int anyBegin = pem.IndexOf("-----BEGIN ", pos);
            if (strict && anyBegin >= 0 && (begin < 0 || anyBegin < begin)) { return null; }
            if (begin < 0) { break; }
            seen = seen + 1;
            int body = begin + PEM_BEGIN.Length;
            int end = pem.IndexOf(PEM_END, body);
            int nested = pem.IndexOf("-----BEGIN ", body);
            if (end < 0 || end - body > MAX_TRUST_CERT_BYTES || seen > MAX_TRUST_CERTS
                || (nested >= 0 && nested < end)) { return null; }
            int next = end + PEM_END.Length;
            // The existing PEM parser accepts any BEGIN/END label. Exact markers above
            // ensure only certificates reach it; unsupported algorithms are not anchors.
            X509Certificate cert = X509Certificate.FromPem(pem.Substring(begin, next - begin));
            if (cert != null && cert.CanSignCertificates()) { certs.Add(cert); }
            else if (strict) { return null; }
            pos = next;
        }
        return certs.Count > 0 ? certs : null;
    }

    static List<X509Certificate> ReadTrustBundle(string path, bool strict) {
        if (path == null || !File.Exists(path)) { return null; }
        try {
            int size = File.GetSize(path);
            if (size < 1 || size > MAX_TRUST_BUNDLE_BYTES) { return null; }
            byte[] raw = File.ReadBytes(path, 0, size + 1);
            if (raw == null || raw.Length != size) { return null; }
            return TlsContext.ParseTrustBundle(raw.ToStr(0, raw.Length), strict);
        } catch (Exception e) {
            return null;
        }
    }

    /// <summary>解析服务端证书 PEM 链束：全部证书按出现顺序保留（叶子在
    /// 前），数量与 DER 总长受限；任何一张无法解析即整体拒绝。</summary>
    static List<X509Certificate> ParseCertChain(string pem) {
        if (pem == null || pem.Length == 0 || pem.Length > MAX_TRUST_BUNDLE_BYTES) { return null; }
        List<X509Certificate> chain = new List<X509Certificate>();
        int pos = 0;
        int totalDer = 0;
        while (pos < pem.Length) {
            int begin = pem.IndexOf(PEM_BEGIN, pos);
            if (begin < 0) { break; }
            int body = begin + PEM_BEGIN.Length;
            int end = pem.IndexOf(PEM_END, body);
            if (end < 0 || end - body > MAX_TRUST_CERT_BYTES
                || chain.Count >= MAX_TRUST_CERTS) { return null; }
            int next = end + PEM_END.Length;
            X509Certificate cert = X509Certificate.FromPem(pem.Substring(begin, next - begin));
            if (cert == null || cert.RawDer() == null) { return null; }
            totalDer = totalDer + cert.RawDerLen();
            if (totalDer > MAX_CHAIN_DER_BYTES) { return null; }
            chain.Add(cert);
            pos = next;
        }
        return chain.Count > 0 ? chain : null;
    }

    static List<X509Certificate> ReadCertChainFile(string path) {
        if (path == null || !File.Exists(path)) { return null; }
        try {
            int size = File.GetSize(path);
            if (size < 1 || size > MAX_TRUST_BUNDLE_BYTES) { return null; }
            byte[] raw = File.ReadBytes(path, 0, size + 1);
            if (raw == null || raw.Length != size) { return null; }
            return TlsContext.ParseCertChain(raw.ToStr(0, raw.Length));
        } catch (Exception e) {
            return null;
        }
    }

    /// <summary>按顺序尝试每个候选 bundle 路径：存在但损坏/不可解析的
    /// 候选只被跳过，不阻断后续候选；全部候选都不可用才返回 null
    /// （调用方随之 fail-closed）。</summary>
    static List<X509Certificate> TrustFromCandidates(string[] paths) {
        if (paths == null) { return null; }
        for (int i = 0; i < paths.Length; i = i + 1) {
            if (!File.Exists(paths[i])) { continue; }
            List<X509Certificate> roots = TlsContext.ReadTrustBundle(paths[i], false);
            if (roots != null && roots.Count > 0) { return roots; }
        }
        return null;
    }

    /// <summary>Add every supported CA certificate in a bounded PEM bundle, in addition to defaults.</summary>
    bool AddTrustedCert(string pemFile) {
        List<X509Certificate> certs = TlsContext.ReadTrustBundle(pemFile, true);
        if (certs == null) { return false; }
        if (this.trustedCerts == null) { this.trustedCerts = new List<X509Certificate>(); }
        for (int i = 0; i < certs.Count; i = i + 1) { this.trustedCerts.Add(certs[i]); }
        return true;
    }

    static List<X509Certificate> SystemTrustRoots() {
        #if LINUX
        // Linux distributions publish curated trust as a CA bundle; do not crawl
        // /etc/ssl/certs, which can also contain untrusted local certificates.
        // A damaged first candidate must not block later ones, and nothing
        // parsed means fail closed.
        string[] paths = new string[] {
            "/etc/ssl/certs/ca-certificates.crt",
            "/etc/pki/tls/certs/ca-bundle.crt",
            "/etc/ssl/ca-bundle.pem",
            "/etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem"
        };
        return TlsContext.TrustFromCandidates(paths);
        #endif
        // Windows ROOT enumeration does not apply disallowed-store, revocation,
        // or chain policy; macOS keychain enumeration likewise is not SecTrust.
        return null;
    }

    void SetCertPolicy(CertPolicyFn fn) {
        this.certPolicy = fn;
    }

    bool PolicyActive() { return this.certPolicy != null; }

    void AddPin(string spkiSha256Base64) {
        if (this.pins == null) { this.pins = new List<string>(); }
        this.pins.Add(spkiSha256Base64);
    }

    void RequirePinning(bool on) {
        this.pinRequired = on;
    }

    bool PinningActive() {
        return this.pinRequired && this.pins != null && this.pins.Count > 0;
    }

    bool PinMatches(string got) {
        if (this.pins == null) { return false; }
        for (int i = 0; i < this.pins.Count; i = i + 1) {
            if (this.pins[i] == got) { return true; }
        }
        return false;
    }

    /// <summary>创建服务器端 TLS 上下文。证书文件可以是 PEM 链束
    /// （叶子在前，其后为中间证书）；单证书文件行为不变。链束任何一环
    /// 无法解析即整体拒绝，不得静默降级为只发叶子。</summary>
    static TlsContext CreateServer(string certFile, string keyFile) {
        TlsContext c = new TlsContext();
        c.server = true;
        c.certFile = certFile;
        c.keyFile = keyFile;
        if (certFile != null && File.Exists(certFile)) {
            c.cachedChain = TlsContext.ReadCertChainFile(certFile);
            if (c.cachedChain != null && c.cachedChain.Count > 0) {
                c.cachedCert = c.cachedChain[0];
            } else {
                c.cachedCert = X509Certificate.FromPemFile(certFile);
            }
        }
        if (keyFile != null && File.Exists(keyFile)) {
            string privKeyPem = File.ReadAllText(keyFile);
            c.cachedKey = RsaKey.FromPrivatePem(privKeyPem);
            // RSA 加载失败再试 EC（PKCS#8/SEC1 P-256）；由密钥文件实际类型决定。
            if (c.cachedKey == null) {
                c.cachedEcKey = EcKey.FromPrivatePem(privKeyPem);
            }
        }
        return c;
    }

    /// <summary>创建客户端 TLS 上下文；Windows 使用系统 SSL 链策略，Linux 使用发行版 CA bundle。</summary>
    static TlsContext CreateClient() {
        TlsContext c = new TlsContext();
        c.trustedCerts = TlsContext.SystemTrustRoots();
        return c;
    }

    /// <summary>创建带客户端证书与私钥的 TLS 上下文（双向认证）。</summary>
    static TlsContext CreateClientWithCertificate(string certFile, string keyFile) {
        TlsContext c = TlsContext.CreateClient();
        c.certFile = certFile;
        c.keyFile = keyFile;
        return c;
    }

    /// <summary>禁用对端证书与主机名校验（仅用于本地自签名开发调试）。</summary>
    void DisableVerify() {
        this.verify = false;
    }

    /// <summary>禁用 TLS 1.3，将协商上限限制为 TLS 1.2。</summary>
    void DisableTls13() {
        this.disableTls13 = true;
    }

    string Handle() {
        return "native_tls_engine";
    }

    bool IsServer() {
        return this.server;
    }

    string TrustHint() {
        return "";
    }

    void Free() {
    }
}

/// <summary>
/// 非阻塞套接字上的纯 Zan 原生 TLS 1.2 / TLS 1.3 流。
/// 原生 AES-128-GCM、X25519、HKDF 与 X.509 握手；Windows 客户端另用 Crypt32 SSL 链策略。
/// </summary>
class TlsStream {
    [DllImport("crt", EntryPoint = "zan_monotonic_us")]
    static extern long MonotonicUs();

    TlsEngine engine;
    nint sock;
    bool open;
    HttpDeadlineToken watch;
    byte[] scratch;
    static int SCRATCH = 65536;

    byte[] pendingOut;
    int pendingLen;
    static string lastError = "";

    static int Norm(int v) {
        if (v > 2147483647) { return v - 4294967296; }
        return v;
    }

    static string LastError() {
        return TlsStream.lastError;
    }

    static void SetLastError(string error) {
        TlsStream.lastError = error;
    }

    static bool ValidReceiveRange(int bufferLength, int offset, int max) {
        return bufferLength >= 0 && offset >= 0 && max >= 0
            && offset <= bufferLength && max <= bufferLength - offset;
    }

    TlsStream() {
        this.engine = null;
        this.sock = -1;
        this.open = false;
        this.watch = null;
        this.scratch = null;
        this.pendingOut = null;
        this.pendingLen = 0;
    }

    static TlsStream Setup(TlsContext ctx, nint sock, string host) {
        if (ctx == null) { TlsStream.SetLastError("TLS 上下文缺失"); return null; }
        #if !WINDOWS
        if (!ctx.server && ctx.verify && ctx.certPolicy == null
            && (ctx.trustedCerts == null || ctx.trustedCerts.Count == 0)) {
            TlsStream.SetLastError("TLS 系统信任根不可用；需显式 AddTrustedCert 配置 CA");
            return null;
        }
        #endif
        TlsStream s = new TlsStream();
        s.engine = new TlsEngine(host, !ctx.verify, ctx.disableTls13, ctx.pins, ctx.pinRequired, ctx.certPolicy, ctx.trustedCerts, ctx.server, ctx.certFile, ctx.keyFile);
        s.engine.SetCredentials(ctx.cachedCert, ctx.cachedKey, ctx.cachedEcKey);
        s.engine.SetCertChain(ctx.cachedChain);
        s.sock = sock;
        s.scratch = new byte[SCRATCH + 1];
        s.open = true;
        return s;
    }

    /// <summary>服务器端：接受客户端连接并执行 TLS 握手。</summary>
    static async TlsStream AcceptAsync(TlsContext ctx, nint sock) {
        return await TlsStream.AcceptAsync(ctx, sock, 30000);
    }

    static async TlsStream AcceptAsync(TlsContext ctx, nint sock, int timeoutMs) {
        TlsStream s = Setup(ctx, sock, "");
        if (s == null) { return null; }
        int ok = await s.HandshakeAsync(timeoutMs);
        if (ok != 1) {
            s.Close();
            return null;
        }
        return s;
    }

    /// <summary>客户端：连接对端服务器并执行 TLS 握手。</summary>
    static async TlsStream ConnectAsync(TlsContext ctx, nint sock, string host) {
        return await TlsStream.ConnectAsync(ctx, sock, host, 30000);
    }

    static async TlsStream ConnectAsync(TlsContext ctx, nint sock, string host, int timeoutMs) {
        TlsStream.SetLastError("");
        TlsStream s = Setup(ctx, sock, host);
        if (s == null) {
            if (TlsStream.LastError() == "") { TlsStream.SetLastError("TLS 引擎初始化失败"); }
            return null;
        }

        s.engine.StartHandshake();
        int ok = await s.HandshakeAsync(timeoutMs);
        if (ok != 1) {
            if (TlsStream.LastError() == "") {
                TlsStream.SetLastError(s.engine.LastError());
            }
            s.Close();
            return null;
        }
        return s;
    }

    // ============================================================
    // 分步握手（传输封装协议，如 MS-TDS）
    // ============================================================

    static TlsStream ConnectStepped(TlsContext ctx, nint sock, string host) {
        TlsStream.SetLastError("");
        TlsStream s = TlsStream.SetupStepped(ctx, sock, host);
        if (s == null) {
            if (TlsStream.LastError() == "") { TlsStream.SetLastError("TLS 引擎初始化失败"); }
            return null;
        }
        s.engine.StartHandshake();
        return s;
    }

    static TlsStream AcceptStepped(TlsContext ctx, nint sock) {
        TlsStream.SetLastError("");
        TlsStream s = TlsStream.SetupStepped(ctx, sock, "");
        if (s == null) {
            if (TlsStream.LastError() == "") { TlsStream.SetLastError("TLS 引擎初始化失败"); }
            return null;
        }
        return s;
    }

    static TlsStream SetupStepped(TlsContext ctx, nint sock, string host) {
        TlsStream s = Setup(ctx, sock, host);
        if (s == null) { return null; }
        s.pendingOut = new byte[SCRATCH * 2 + 1];
        s.pendingLen = 0;
        return s;
    }

    int HandshakePump() {
        if (!this.open || this.engine == null) { return -1; }
        int r = this.engine.Step();
        byte[] pending = this.engine.DrainNetwork();
        if (pending != null && pending.Length > 0) {
            this.EnsurePending(pending.Length);
            NativeMemory.Copy((nint)this.pendingOut + (nint)this.pendingLen, pending, pending.Length);
            this.pendingLen = this.pendingLen + pending.Length;
        }
        if (r == 1) { return 1; }
        if (r < 0) { return -1; }
        return 0;
    }

    string HandshakeDrain() {
        if (this.pendingOut == null || this.pendingLen <= 0) { return ""; }
        string out1 = this.pendingOut.ToStr(0, this.pendingLen);
        this.pendingLen = 0;
        return out1;
    }

    void HandshakeFeed(string data) {
        if (data == null || data.Length == 0 || !this.open || this.engine == null) { return; }
        byte[] b = new byte[data.Length];
        NativeMemory.Copy(b, data, data.Length);
        this.engine.FeedNetwork(b, 0, b.Length);
    }

    void EnsurePending(int extra) {
        if (this.pendingOut == null) {
            this.pendingOut = new byte[extra + 256];
            this.pendingLen = 0;
            return;
        }
        if (this.pendingLen + extra <= this.pendingOut.Length) { return; }
        int size = this.pendingOut.Length * 2;
        while (this.pendingLen + extra > size) { size = size * 2; }
        byte[] nb = new byte[size + 1];
        if (this.pendingLen > 0) {
            NativeMemory.Copy(nb, this.pendingOut, this.pendingLen);
        }
        this.pendingOut = nb;
    }

    /// <summary>获取当前连接对端证书的描述文本（形如 issuer=... subject=...）。</summary>
    string PeerCertificateText() {
        if (this.engine == null) { return ""; }
        return this.engine.PeerCertificateText();
    }

    static string SpkiPinOf(TlsStream stream) {
        if (stream == null || stream.engine == null) { return ""; }
        X509Certificate cert = stream.engine.PeerCertificate();
        if (cert == null) { return ""; }
        return cert.SpkiSha256Pin();
    }

    async int FlushOutAsync() {
        if (!this.open || this.engine == null) { return -1; }
        while (this.engine.OutNetLength() > 0) {
            int toSend = this.engine.OutNetLength();
            int sent = Norm(await Socket.SendBytesAsync(
                this.sock,
                this.engine.OutNetBuffer(),
                this.engine.OutNetHead(),
                toSend
            ));
            if (!this.open) { return -1; }
            if (sent <= 0) { return -1; }
            this.engine.DropOutNet(sent);
        }
        return 0;
    }

    async int PumpInAsync() {
        if (!this.open || this.engine == null) { return -1; }
        int n = await Socket.RecvBytesAsync(this.sock, this.scratch, SCRATCH);
        if (n < 0) { return -1; }
        if (n == 0) { return 0; }
        this.engine.FeedNetwork(this.scratch, 0, n);
        return n;
    }

    async int HandshakeAsync(int timeoutMs) {
        if (timeoutMs > 0) {
            this.watch = HttpDeadline.Arm(this.sock, timeoutMs);
        }
        long deadlineUs = 0;
        if (timeoutMs > 0) { deadlineUs = MonotonicUs() + (long)timeoutMs * 1000; }

        while (true) {
            int flushed = await this.FlushOutAsync();
            if (flushed < 0) { return this.EndHandshakeWatch(-1); }

            int r = this.engine.Step();
            flushed = await this.FlushOutAsync();
            if (flushed < 0) { return this.EndHandshakeWatch(-1); }

            if (r == 1) { return this.EndHandshakeWatch(1); }
            if (r < 0) {
                TlsStream.SetLastError(this.engine.LastError());
                return this.EndHandshakeWatch(-1);
            }
            if (timeoutMs > 0 && MonotonicUs() >= deadlineUs) {
                TlsStream.SetLastError("TLS 握手超时");
                return this.EndHandshakeWatch(-2);
            }

            int n = await this.PumpInAsync();
            if (n <= 0) {
                if (n == 0) { TlsStream.SetLastError("对端在握手期间关闭了连接"); }
                return this.EndHandshakeWatch(-1);
            }
        }
        return -1;
    }

    int EndHandshakeWatch(int result) {
        HttpDeadline.Disarm(this.watch);
        this.watch = null;
        return result;
    }

    /// <summary>接收解密后的应用字节（最多 max）。正常关闭或出错时返回空串。</summary>
    async string RecvAsync(int max) {
        if (!this.open || this.engine == null || max <= 0) { return ""; }
        int want = max;
        if (want > SCRATCH) { want = SCRATCH; }

        while (true) {
            int step = this.engine.Step();
            if (step < 0) { return ""; }

            int avail = this.engine.AvailableAppData();
            if (avail > 0) {
                int toRead = avail > want ? want : avail;
                byte[] b = new byte[toRead];
                int read = this.engine.RecvAppData(b, 0, toRead);
                if (read > 0) {
                    return b.ToStr(0, read);
                }
            }

            if (this.engine.IsClosed()) { return ""; }

            int flushed = await this.FlushOutAsync();
            if (flushed < 0) { return ""; }

            int got = await this.PumpInAsync();
            if (got <= 0) { return ""; }
        }
        return "";
    }

    /// <summary>接收解密后的字节到调用方提供的缓冲区。正常关闭返回 0，出错返回 -1。</summary>
    async int RecvIntoAsync(string buf, int max) {
        if (!this.open || this.engine == null || buf == null || max < 0) { return -1; }
        if (max == 0) { return 0; }
        while (true) {
            int step = this.engine.Step();
            if (step < 0) { return -1; }

            int avail = this.engine.AvailableAppData();
            if (avail > 0) {
                int toRead = avail > max ? max : avail;
                int read = this.engine.RecvAppData(buf, 0, toRead);
                if (read > 0) {
                    return read;
                }
            }

            if (this.engine.IsClosed()) { return 0; }

            int flushed = await this.FlushOutAsync();
            if (flushed < 0) { return -1; }

            int got = await this.PumpInAsync();
            if (got == 0) { return 0; }
            if (got < 0) { return -1; }
        }
        return -1;
    }

    /// <summary>接收解密后的字节到调用方提供的字节数组。正常关闭返回 0，出错返回 -1。</summary>
    async int RecvBytesAsync(byte[] buf, int offset, int max) {
        if (!this.open || this.engine == null || buf == null) { return -1; }
        if (!TlsStream.ValidReceiveRange(buf.Length, offset, max)) { return -1; }
        if (max == 0) { return 0; }
        while (true) {
            int step = this.engine.Step();
            if (step < 0) { return -1; }

            int avail = this.engine.AvailableAppData();
            if (avail > 0) {
                int toRead = avail > max ? max : avail;
                int read = this.engine.RecvAppData(buf, offset, toRead);
                if (read > 0) {
                    return read;
                }
            }

            if (this.engine.IsClosed()) { return 0; }

            int flushed = await this.FlushOutAsync();
            if (flushed < 0) { return -1; }

            int got = await this.PumpInAsync();
            if (got == 0) { return 0; }
            if (got < 0) { return -1; }
        }
        return -1;
    }

    /// <summary>加密并发送 len 字节字符串数据。零中间分配直达底层网络缓冲。成功返回明文字节数，失败返回 -1。</summary>
    async int SendAsync(string data, int len) {
        if (!this.open || this.engine == null) { return -1; }
        int r = this.engine.SendAppData(data, 0, len);
        if (r < 0) { return -1; }
        int flushed = await this.FlushOutAsync();
        if (flushed < 0) { return -1; }
        return len;
    }

    /// <summary>加密并发送字节数组前 len 字节。零中间分配直达底层网络缓冲。成功返回明文字节数，失败返回 -1。</summary>
    async int SendAsync(byte[] data, int len) {
        return await this.SendBytesAsync(data, 0, len);
    }

    /// <summary>加密并发送字节数组前 len 字节。零中间分配直达底层网络缓冲。成功返回明文字节数，失败返回 -1。</summary>
    async int SendBytesAsync(byte[] data, int len) {
        return await this.SendBytesAsync(data, 0, len);
    }

    /// <summary>加密并发送字节数组切片。零中间分配直达底层网络缓冲。成功返回明文字节数，失败返回 -1。</summary>
    async int SendBytesAsync(byte[] data, int offset, int len) {
        if (!this.open || this.engine == null) { return -1; }
        int r = this.engine.SendAppData(data, offset, len);
        if (r < 0) { return -1; }
        int flushed = await this.FlushOutAsync();
        if (flushed < 0) { return -1; }
        return len;
    }

    /// <summary>加密并发送完整字节数组。</summary>
    async int SendBytesAsync(byte[] data) {
        if (data == null) { return -1; }
        return await this.SendBytesAsync(data, 0, data.Length);
    }

    /// <summary>发送整个字符串（其 .Length 个字节）。</summary>
    async int SendStringAsync(string data) {
        return await SendAsync(data, data.Length);
    }

    /// <summary>关闭 TLS 连接。</summary>
    void Close() {
        HttpDeadline.Disarm(this.watch);
        this.watch = null;
        this.open = false;
        this.engine = null;
    }
}
