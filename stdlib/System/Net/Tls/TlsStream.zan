using System;
using System.Net.Sockets;
using System.Net.Http;
using System.Security.Cryptography;

namespace System.Net.Tls;

/// <summary>
/// 证书策略委托：客户端握手后若链/主机名校验不通过（verifyResult != 0），
/// 以 (verifyResult, 对端证书文本) 调用；返回 true 放行本次连接，false 拒绝。
/// 证书文本形如 "issuer=/CN=.../O=... subject=/CN=example.com"。
/// </summary>
delegate bool CertPolicyFn(long verifyResult, string certText);

/// <summary>
/// 纯 Zan 原生 TLS 上下文。
/// 零 C 语言与零 OpenSSL 依赖，管理客户端与服务器配置、证书策略与公钥固定 (Pinning)。
/// </summary>
class TlsContext {
    bool server;
    string error;
    bool verify;
    bool disableTls13;
    string certFile;
    string keyFile;
    string trust;
    List<string> pins;
    bool pinRequired;
    CertPolicyFn certPolicy;
    List<X509Certificate> trustedCerts;

    TlsContext() {
        this.server = false;
        this.error = "";
        this.verify = true;
        this.disableTls13 = false;
        this.certFile = null;
        this.keyFile = null;
        this.trust = "";
        this.pins = null;
        this.pinRequired = false;
        this.certPolicy = null;
        this.trustedCerts = null;
    }

    /// <summary>添加信任的 CA 证书（PEM 格式文件）。</summary>
    bool AddTrustedCert(string pemFile) {
        X509Certificate cert = X509Certificate.FromPemFile(pemFile);
        if (cert == null) { return false; }
        if (this.trustedCerts == null) {
            this.trustedCerts = new List<X509Certificate>();
        }
        this.trustedCerts.Add(cert);
        return true;
    }

    void SetCertPolicy(CertPolicyFn fn) {
        this.certPolicy = fn;
    }

    bool PolicyActive() { return this.certPolicy != null; }

    void AddPin(string spkiSha256Base64) {
        if (this.pins == null) { this.pins = new List<string>(); }
        this.pins.Add(spkiSha256Base64);
    }

    void RequirePinning(bool on) {
        this.pinRequired = on;
    }

    bool PinningActive() {
        return this.pinRequired && this.pins != null && this.pins.Count > 0;
    }

    bool PinMatches(string got) {
        if (this.pins == null) { return false; }
        for (int i = 0; i < this.pins.Count; i = i + 1) {
            if (this.pins[i] == got) { return true; }
        }
        return false;
    }

    /// <summary>创建服务器端 TLS 上下文。</summary>
    static TlsContext CreateServer(string certFile, string keyFile) {
        TlsContext c = new TlsContext();
        c.server = true;
        c.certFile = certFile;
        c.keyFile = keyFile;
        return c;
    }

    /// <summary>创建客户端 TLS 上下文。默认启用证书与主机名校验。</summary>
    static TlsContext CreateClient() {
        TlsContext c = new TlsContext();
        c.server = false;
        return c;
    }

    /// <summary>创建带客户端证书与私钥的 TLS 上下文（双向认证）。</summary>
    static TlsContext CreateClientWithCertificate(string certFile, string keyFile) {
        TlsContext c = new TlsContext();
        c.server = false;
        c.certFile = certFile;
        c.keyFile = keyFile;
        return c;
    }

    /// <summary>禁用对端证书与主机名校验（仅用于本地自签名开发调试）。</summary>
    void DisableVerify() {
        this.verify = false;
    }

    /// <summary>禁用 TLS 1.3，将协商上限限制为 TLS 1.2。</summary>
    void DisableTls13() {
        this.disableTls13 = true;
    }

    string Handle() {
        return "native_tls_engine";
    }

    bool IsServer() {
        return this.server;
    }

    string TrustHint() {
        return "";
    }

    void Free() {
    }
}

/// <summary>
/// 非阻塞套接字上的纯 Zan 原生 TLS 1.2 / TLS 1.3 流。
/// 彻底去除 OpenSSL (libssl/libcrypto) 与 Windows crypt32.dll 外部依赖，
/// 由原生 AES-128-GCM、X25519、HKDF 与 X.509 解析器直接驱动。
/// </summary>
class TlsStream {
    [DllImport("crt", EntryPoint = "zan_monotonic_us")]
    static extern long MonotonicUs();

    TlsEngine engine;
    nint sock;
    bool open;
    HttpDeadlineToken watch;
    byte[] scratch;
    static int SCRATCH = 17408;

    byte[] pendingOut;
    int pendingLen;
    static string lastError = "";

    static int Norm(int v) {
        if (v > 2147483647) { return v - 4294967296; }
        return v;
    }

    static string LastError() {
        return TlsStream.lastError;
    }

    static void SetLastError(string error) {
        TlsStream.lastError = error;
    }

    TlsStream() {
        this.engine = null;
        this.sock = -1;
        this.open = false;
        this.watch = null;
        this.scratch = null;
        this.pendingOut = null;
        this.pendingLen = 0;
    }

    static TlsStream Setup(TlsContext ctx, nint sock, string host) {
        TlsStream s = new TlsStream();
        s.engine = new TlsEngine(host, !ctx.verify, ctx.disableTls13, ctx.pins, ctx.pinRequired, ctx.certPolicy, ctx.trustedCerts, ctx.server, ctx.certFile, ctx.keyFile);
        s.sock = sock;
        s.scratch = new byte[SCRATCH + 1];
        s.open = true;
        return s;
    }

    /// <summary>服务器端：接受客户端连接并执行 TLS 握手。</summary>
    static async TlsStream AcceptAsync(TlsContext ctx, nint sock) {
        return await TlsStream.AcceptAsync(ctx, sock, 30000);
    }

    static async TlsStream AcceptAsync(TlsContext ctx, nint sock, int timeoutMs) {
        TlsStream s = Setup(ctx, sock, "");
        if (s == null) { return null; }
        int ok = await s.HandshakeAsync(timeoutMs);
        if (ok != 1) {
            s.Close();
            return null;
        }
        return s;
    }

    /// <summary>客户端：连接对端服务器并执行 TLS 握手。</summary>
    static async TlsStream ConnectAsync(TlsContext ctx, nint sock, string host) {
        return await TlsStream.ConnectAsync(ctx, sock, host, 30000);
    }

    static async TlsStream ConnectAsync(TlsContext ctx, nint sock, string host, int timeoutMs) {
        TlsStream.SetLastError("");
        TlsStream s = Setup(ctx, sock, host);
        if (s == null) {
            TlsStream.SetLastError("TLS 引擎初始化失败");
            return null;
        }

        s.engine.StartHandshake();
        int ok = await s.HandshakeAsync(timeoutMs);
        if (ok != 1) {
            if (TlsStream.LastError() == "") {
                TlsStream.SetLastError(s.engine.LastError());
            }
            s.Close();
            return null;
        }
        return s;
    }

    // ============================================================
    // 分步握手（传输封装协议，如 MS-TDS）
    // ============================================================

    static TlsStream ConnectStepped(TlsContext ctx, nint sock, string host) {
        TlsStream.SetLastError("");
        TlsStream s = TlsStream.SetupStepped(ctx, sock, host);
        if (s == null) {
            TlsStream.SetLastError("TLS 引擎初始化失败");
            return null;
        }
        s.engine.StartHandshake();
        return s;
    }

    static TlsStream AcceptStepped(TlsContext ctx, nint sock) {
        TlsStream.SetLastError("");
        TlsStream s = TlsStream.SetupStepped(ctx, sock, "");
        if (s == null) {
            TlsStream.SetLastError("TLS 引擎初始化失败");
            return null;
        }
        return s;
    }

    static TlsStream SetupStepped(TlsContext ctx, nint sock, string host) {
        TlsStream s = Setup(ctx, sock, host);
        if (s == null) { return null; }
        s.pendingOut = new byte[SCRATCH * 2 + 1];
        s.pendingLen = 0;
        return s;
    }

    int HandshakePump() {
        if (!this.open || this.engine == null) { return -1; }
        int r = this.engine.Step();
        byte[] pending = this.engine.DrainNetwork();
        if (pending != null && pending.Length > 0) {
            this.EnsurePending(pending.Length);
            for (int i = 0; i < pending.Length; i = i + 1) {
                this.pendingOut[this.pendingLen + i] = pending[i];
            }
            this.pendingLen = this.pendingLen + pending.Length;
        }
        if (r == 1) { return 1; }
        if (r < 0) { return -1; }
        return 0;
    }

    string HandshakeDrain() {
        if (this.pendingOut == null || this.pendingLen <= 0) { return ""; }
        string out1 = this.pendingOut.ToStr(0, this.pendingLen);
        this.pendingLen = 0;
        return out1;
    }

    void HandshakeFeed(string data) {
        if (data == null || data.Length == 0 || !this.open || this.engine == null) { return; }
        byte[] b = new byte[data.Length];
        for (int i = 0; i < data.Length; i = i + 1) { b[i] = (byte)(data[i] & 255); }
        this.engine.FeedNetwork(b, 0, b.Length);
    }

    void EnsurePending(int extra) {
        if (this.pendingOut == null) {
            this.pendingOut = new byte[extra + 256];
            this.pendingLen = 0;
            return;
        }
        if (this.pendingLen + extra <= this.pendingOut.Length) { return; }
        int size = this.pendingOut.Length * 2;
        while (this.pendingLen + extra > size) { size = size * 2; }
        byte[] nb = new byte[size + 1];
        for (int i = 0; i < this.pendingLen; i = i + 1) { nb[i] = this.pendingOut[i]; }
        this.pendingOut = nb;
    }

    /// <summary>获取当前连接对端证书的描述文本（形如 issuer=... subject=...）。</summary>
    string PeerCertificateText() {
        if (this.engine == null) { return ""; }
        return this.engine.PeerCertificateText();
    }

    static string SpkiPinOf(TlsStream stream) {
        if (stream == null || stream.engine == null) { return ""; }
        X509Certificate cert = stream.engine.PeerCertificate();
        if (cert == null) { return ""; }
        return cert.SpkiSha256Pin();
    }

    async int FlushOutAsync() {
        if (!this.open || this.engine == null) { return -1; }
        byte[] pending = this.engine.DrainNetwork();
        while (pending != null && pending.Length > 0) {
            string s = pending.ToStr(0, pending.Length);
            int sent = Norm(await Socket.SendAsync(this.sock, s, pending.Length));
            if (!this.open) { return -1; }
            if (sent != pending.Length) { return -1; }
            pending = this.engine.DrainNetwork();
        }
        return 0;
    }

    async int PumpInAsync() {
        if (!this.open || this.engine == null) { return -1; }
        string chunk = await Socket.RecvAsync(this.sock, SCRATCH);
        if (chunk == null) { return -1; }
        int n = chunk.Length;
        if (n == 0) { return 0; }
        byte[] b = new byte[n];
        for (int i = 0; i < n; i = i + 1) { b[i] = (byte)(chunk[i] & 255); }
        this.engine.FeedNetwork(b, 0, n);
        return n;
    }

    async int HandshakeAsync(int timeoutMs) {
        if (timeoutMs > 0) {
            this.watch = HttpDeadline.Arm(this.sock, timeoutMs);
        }
        long deadlineUs = 0;
        if (timeoutMs > 0) { deadlineUs = MonotonicUs() + (long)timeoutMs * 1000; }

        while (true) {
            int flushed = await this.FlushOutAsync();
            if (flushed < 0) { return this.EndHandshakeWatch(-1); }

            int r = this.engine.Step();
            flushed = await this.FlushOutAsync();
            if (flushed < 0) { return this.EndHandshakeWatch(-1); }

            if (r == 1) { return this.EndHandshakeWatch(1); }
            if (r < 0) {
                TlsStream.SetLastError(this.engine.LastError());
                return this.EndHandshakeWatch(-1);
            }
            if (timeoutMs > 0 && MonotonicUs() >= deadlineUs) {
                TlsStream.SetLastError("TLS 握手超时");
                return this.EndHandshakeWatch(-2);
            }

            int n = await this.PumpInAsync();
            if (n <= 0) {
                if (n == 0) { TlsStream.SetLastError("对端在握手期间关闭了连接"); }
                return this.EndHandshakeWatch(-1);
            }
        }
        return -1;
    }

    int EndHandshakeWatch(int result) {
        HttpDeadline.Disarm(this.watch);
        this.watch = null;
        return result;
    }

    /// <summary>接收解密后的应用字节（最多 max）。正常关闭或出错时返回空串。</summary>
    async string RecvAsync(int max) {
        if (!this.open || this.engine == null) { return ""; }
        int want = max;
        if (want > SCRATCH) { want = SCRATCH; }

        while (true) {
            int step = this.engine.Step();
            if (step < 0) { return ""; }

            int avail = this.engine.AvailableAppData();
            if (avail > 0) {
                int toRead = avail > want ? want : avail;
                byte[] b = new byte[toRead];
                int read = this.engine.RecvAppData(b, 0, toRead);
                if (read > 0) {
                    return b.ToStr(0, read);
                }
            }

            if (this.engine.IsClosed()) { return ""; }

            int flushed = await this.FlushOutAsync();
            if (flushed < 0) { return ""; }

            int got = await this.PumpInAsync();
            if (got <= 0) { return ""; }
        }
        return "";
    }

    /// <summary>接收解密后的字节到调用方提供的缓冲区。正常关闭返回 0，出错返回 -1。</summary>
    async int RecvIntoAsync(string buf, int max) {
        if (!this.open || this.engine == null) { return -1; }
        while (true) {
            int step = this.engine.Step();
            if (step < 0) { return -1; }

            int avail = this.engine.AvailableAppData();
            if (avail > 0) {
                int toRead = avail > max ? max : avail;
                byte[] tmp = new byte[toRead];
                int read = this.engine.RecvAppData(tmp, 0, toRead);
                if (read > 0) {
                    for (int i = 0; i < read; i = i + 1) {
                        buf[i] = (char)(tmp[i] & 255);
                    }
                    return read;
                }
            }

            if (this.engine.IsClosed()) { return 0; }

            int flushed = await this.FlushOutAsync();
            if (flushed < 0) { return -1; }

            int got = await this.PumpInAsync();
            if (got == 0) { return 0; }
            if (got < 0) { return -1; }
        }
        return -1;
    }

    /// <summary>加密并发送 len 字节。成功返回明文字节数，失败返回 -1。</summary>
    async int SendAsync(string data, int len) {
        if (!this.open || this.engine == null) { return -1; }
        byte[] b = new byte[len];
        for (int i = 0; i < len; i = i + 1) { b[i] = (byte)(data[i] & 255); }
        int r = this.engine.SendAppData(b, 0, len);
        if (r < 0) { return -1; }
        int flushed = await this.FlushOutAsync();
        if (flushed < 0) { return -1; }
        return len;
    }

    /// <summary>发送整个字符串（其 .Length 个字节）。</summary>
    async int SendStringAsync(string data) {
        return await SendAsync(data, data.Length);
    }

    /// <summary>关闭 TLS 连接。</summary>
    void Close() {
        HttpDeadline.Disarm(this.watch);
        this.watch = null;
        this.open = false;
        this.engine = null;
    }
}
