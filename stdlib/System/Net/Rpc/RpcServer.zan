using System;
using System.Json;
using System.Net.Sockets;

namespace System.Net.Rpc;

/// <summary>处理一条已解码的请求并生成要发送的响应。
/// 异步以便处理函数可等待 I/O 而不阻塞对端协程。</summary>
async delegate RpcResponse RpcHandler(RpcRequest req);

/// 已注册的方法：名称与要调用的处理函数。建模为
/// 实体（而非平行的名称/处理函数列表），以保证注册表一致。
class RpcMethod {
    string name;
    RpcHandler fn;

    RpcMethod(string name, RpcHandler fn) {
        this.name = name;
        this.fn = fn;
    }
}

/// <summary>
/// 与协议无关的 RPC 服务器：接受连接，并用客户端相同的
/// <see cref="IRpcTransport"/> + <see cref="IRpcCodec"/> 层做帧化/解码
/// ，按方法名分发到已注册的 <see cref="RpcHandler"/>，
/// 并写回对应的响应（通知无响应）。每个对端
/// 在各自协程上运行（Task.Spawn），慢客户端不会阻塞 accept
/// 循环——与 HttpServer 相同的并发模型。更换 codec 即可
/// 在相同分发核心上提供 XML-RPC / DMTP 服务。
///
/// 用法：
///   RpcServer s = new RpcServer("0.0.0.0", 4000, new JsonRpcCodec());
///   s.On("add", AddHandler);
///   await s.Start();
/// </summary>
class RpcServer {
    TcpListener listener;
    IRpcCodec codec;
    List<RpcMethod> methods;
    string host;
    int port;
    bool running;

    RpcServer(string host, int port, IRpcCodec codec) {
        this.host = host;
        this.port = port;
        this.codec = codec;
        this.methods = new List<RpcMethod>();
        this.running = false;
        this.listener = null;
    }

    /// 为 `name` 注册处理函数（可链式调用）。
    RpcServer On(string name, RpcHandler fn) {
        this.methods.Add(new RpcMethod(name, fn));
        return this;
    }

    RpcHandler Lookup(string name) {
        foreach (RpcMethod m in this.methods) {
            if (m.name == name) { return m.fn; }
        }
        return null;
    }

    /// 持续接受连接；每个连接在各自协程上服务。
    async void Start() {
        Socket.Initialize();
        this.listener = new TcpListener(this.host, this.port);
        this.listener.Start();
        this.running = true;
        while (this.running) {
            nint client = await this.listener.AcceptAsync();
            if (client >= 0) {
                Task.Spawn(this.HandlePeerAsync(client));
            }
        }
    }

    /// 服务一个对端：读帧 -> 解码 -> 分发 -> 回复，直到关闭。
    async void HandlePeerAsync(nint client) {
        TcpClient conn = TcpClient.FromSocket(client);
        TcpRpcTransport tr = TcpRpcTransport.FromConn(conn);
        bool alive = true;
        while (alive) {
            string frame = await tr.RecvFrameAsync();
            if (frame.Length == 0) {
                alive = false;
            } else {
                RpcRequest req = this.codec.DecodeRequest(frame);
                RpcResponse resp = await this.Dispatch(req);
                if (!req.notify) {
                    resp.id = req.id;
                    await tr.SendFrameAsync(this.codec.EncodeResponse(resp));
                }
            }
        }
        conn.Close();
    }

    /// 把请求路由到处理函数，找不到时返回 MethodNotFound 错误。
    async RpcResponse Dispatch(RpcRequest req) {
        RpcHandler fn = this.Lookup(req.method);
        if (fn == null) {
            return RpcResponse.Fail(req.id,
                RpcError.MethodNotFound("method not found: " + req.method));
        }
        return await fn(req);
    }

    void Stop() {
        this.running = false;
        if (this.listener != null) { this.listener.Stop(); }
    }
}
