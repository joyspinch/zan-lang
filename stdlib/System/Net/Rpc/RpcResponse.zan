using System;
using System.Json;

namespace System.Net.Rpc;

/// <summary>
/// 与请求通过 `id` 关联、协议无关的 RPC 响应。成功时
/// `result` 携带返回负载，`error` 为 <see cref="RpcError.None"/>；
/// 失败时 `result` 为 null，`error` 描述错误。每个 codec
/// 都把线上回复解码为该形态，调用方只需判断一次 `IsError()`
/// 即可，与协议无关。
/// </summary>
class RpcResponse {
    int id;
    JsonValue result;
    RpcError error;

    RpcResponse() {
        this.id = 0;
        this.result = null;
        this.error = RpcError.None();
    }

    static RpcResponse Ok(int id, JsonValue result) {
        RpcResponse r = new RpcResponse();
        r.id = id;
        r.result = result;
        return r;
    }

    static RpcResponse Fail(int id, RpcError error) {
        RpcResponse r = new RpcResponse();
        r.id = id;
        r.error = error;
        return r;
    }

    bool IsError() { return error != null && error.IsError(); }
}
