using System;
using System.Json;

namespace System.Net.Rpc;

/// <summary>
/// 与协议无关的 RPC 请求：方法名、JSON 参数负载和
/// 关联 id。`notify == true` 表示即发即弃调用（无 id、无
/// 预期响应）。每个 codec（JSON-RPC / XML-RPC / DMTP）都从这一形态
/// 编码和解码，核心因此从不依赖具体线上格式。
/// 参数负载使用 <see cref="JsonValue"/>，因为它是标准库中通用
/// 的结构化值模型；XML codec 遍历的是同一棵
/// 树。
/// </summary>
class RpcRequest {
    string method;
    JsonValue args;     // 'params' 是保留字，因此字段命名为 `args`
    int id;
    bool notify;

    RpcRequest(string method, JsonValue args, int id, bool notify) {
        this.method = method;
        this.args = args;
        this.id = id;
        this.notify = notify;
    }

    /// 期望响应的请求（`notify == false`）。
    static RpcRequest Call(string method, JsonValue args, int id) {
        return new RpcRequest(method, args, id, false);
    }

    /// 即发即弃的通知（无 id、无响应）。
    static RpcRequest Notification(string method, JsonValue args) {
        return new RpcRequest(method, args, 0, true);
    }
}
