using System;
using System.Net.Sockets;
using System.Net.Http;
using System.Net.WebSocket;
using System.Net.Sse;
using System.Net.Mqtt;
using System.Diagnostics;
using System.Text;
using System.Threading;

namespace System.Net;

/// <summary>Invoked when a client connection is established. Async so the
/// handler can await I/O (Db/Redis/etc.) without blocking the event loop.</summary>
async delegate void ConnectionHandler(Connection conn);

/// <summary>Invoked for every complete inbound message on a TCP or WebSocket
/// connection. The returned string (when non-empty) is sent back to the peer
/// as the reply; return "" to send nothing. Async: may await I/O.</summary>
async delegate string MessageHandler(Connection conn, string data);

/// <summary>Invoked after a connection is closed (peer disconnect or
/// conn.Close()). Async: may await I/O.</summary>
async delegate void ConnectionCloseHandler(Connection conn);

/// <summary>Invoked per UDP datagram. The returned string (when non-empty) is
/// sent back to the datagram's sender; return "" to send nothing. Async.</summary>
async delegate string DatagramHandler(string data);

/// <summary>Invoked when an SSE subscriber completes its handshake. The
/// application keeps the SseConnection and pushes events through it. Async.</summary>
async delegate void SseSubscriberHandler(SseConnection conn);

/// <summary>Invoked with a freshly accepted (and, on Windows, handed-off)
/// client socket. When set it overrides the built-in per-protocol handling:
/// the callback owns the socket and drives the whole connection itself. Lets
/// an application server (e.g. an MVC framework) reuse the master/worker
/// accept + WSADuplicateSocket handoff + supervision while keeping its own
/// request pipeline. Async so it can await I/O.</summary>
async delegate void RawConnHandler(nint sock);

/// <summary>
/// Workerman-style multi-protocol server: one Worker per listen address,
/// per-event callbacks, and a master + N worker-processes runtime that
/// load-balances accepted connections across CPU cores.
///
///   Worker w = new Worker("http", "0.0.0.0", 8080);
///   w.count = 4;                        // 4 worker processes
///   w.onHttpRequest = App.Handle;       // HttpRequest -> HttpResponse
///   Worker.RunAll();                    // never returns
///
/// Protocols: "tcp", "udp", "http", "websocket" (or "ws"), "sse", "mqtt".
/// Callbacks (assign what the protocol needs); the second name is an alias
/// reading the way that protocol usually does:
///   onConnect / onOpen                  -- tcp, websocket: connection up
///   onMessage / onReceive               -- tcp, websocket: data in, reply out
///   onClose                             -- tcp, websocket: connection gone
///   onHttpRequest / onRequest           -- http
///   onUdpMessage / onPacket             -- udp
///   onSseSubscriber                     -- sse
///   (none)                              -- mqtt: connections are served by
///                                          the built-in MqttBroker.Global()
///
/// An "http" worker with onOpen/onMessage set also serves WebSocket on that
/// same port: a request asking to upgrade becomes a frame loop, everything else
/// is answered by onRequest.
///
/// MULTI-PROCESS MODEL (count > 1). The initially launched process becomes the
/// MASTER: it spawns `count` worker copies of this executable and supervises
/// them (a crashed worker is respawned). Accepted connections are spread
/// across workers, fully event-driven (no polling anywhere):
///   - Windows: the master binds and accepts every TCP listener on its own
///     IOCP, then hands each ACCEPTED socket to a worker round-robin via
///     WSADuplicateSocket over a dedicated per-listener channel connection.
///     (AcceptEx on a listener shared across processes loses completions --
///     a documented WSADuplicateSocket/IOCP limitation -- so workers never
///     accept themselves.) UDP has no accept; UDP Workers are served in the
///     master process on Windows.
///   - Linux/macOS: each worker binds its own listener with SO_REUSEPORT and
///     the kernel hashes new connections across the sockets.
/// Workers watch the control connection to the master and exit when it dies,
/// so no orphan processes outlive the master.
///
/// SINGLE-PROCESS MODEL (count == 1, default): RunAll runs every Worker's
/// event loop on this process's coroutine scheduler -- no child processes.
/// </summary>
class Worker {
    string protocol;
    string host;
    int port;
    string name;
    bool running;
    int connectionCount;
    int maxConnections;

    // ---- http limits (see HttpServer.ServeConnection) ----
    int maxHeaderBytes;
    int maxRequestBytes;
    int requestTimeout;

    /// <summary>Number of worker processes serving this Worker's port. The
    /// largest count of any registered Worker decides how many worker
    /// processes RunAll launches; 1 (default) = serve in-process.</summary>
    int count;

    // ---- event callbacks (assign before RunAll) ----
    ConnectionHandler onConnect;
    MessageHandler onMessage;
    ConnectionCloseHandler onClose;
    HttpRequestHandler onHttpRequest;
    DatagramHandler onUdpMessage;
    SseSubscriberHandler onSseSubscriber;
    RawConnHandler onRawConnection;

    // Protocol-flavoured names for the same events, so each protocol reads the
    // way it does elsewhere: a WebSocket server talks about open/message/close,
    // a TCP server about connect/receive/close. Whichever is set wins; setting
    // both is pointless, not harmful.
    ConnectionHandler onOpen;        // websocket: connection established
    MessageHandler onReceive;        // tcp: bytes arrived
    DatagramHandler onPacket;        // udp: datagram arrived
    HttpRequestHandler onRequest;    // http: request parsed

    static List<Worker> workers = new List<Worker>();
    static bool daemonize = false;
    // Set by RunCommand: the process was started through the CLI, so it also
    // answers stop/reload/status on the control port.
    static bool cliMode = false;
    // Set by a STOP command: workers that exit are not respawned.
    static bool stopping = false;
    // Live worker control connections, used to ask a worker to quit.
    static List<TcpClient> ctlConn = new List<TcpClient>();
    static List<int> ctlWid = new List<int>();
    #if WINDOWS
    // Worker side: the handoff channels this process reads accepted sockets
    // from, closed when it is asked to quit so no new work arrives.
    static List<TcpClient> wkChannels = new List<TcpClient>();
    #endif
    static int controlPort = 0;
    static int nextConnId = 1;
    static string logDir = "";

    // ---- status/statistics (workerman-style `status`) ----
    // Requests/messages served by this process, across all Workers.
    static int statRequests = 0;

    // Static-context increment. Do NOT inline `statRequests = statRequests+1`
    // into the instance async handlers: the async lowering captures statics
    // referenced from instance async methods by value, so increments there
    // write to a per-coroutine copy and are lost.
    static void BumpStat() {
        statRequests = statRequests + 1;
    }

    // Messages/frames/datagrams written back to peers by this process.
    static int statSent = 0;

    static void BumpSent() {
        statSent = statSent + 1;
    }

    // Live connections across every Worker in this process.
    static int LiveConnections() {
        int n = 0;
        for (int i = 0; i < workers.Count; i = i + 1) {
            n = n + workers[i].connectionCount;
        }
        return n;
    }
    // Status print interval in seconds for the foreground master (or the
    // single-process server). 0 disables. Workers report to the master over
    // the control connection every 2s regardless.
    static int statusInterval = 10;

    // Cross-process counters live in shared memory, the same mechanism the
    // router's per-route stats use: every process publishes its own row every
    // two seconds and `status` reads the rows, so no worker has to be asked
    // and a report cannot be lost with a control connection.
    // Columns: pid, recv (requests/messages in), sent (messages out), conns,
    // cpu (ms), rss (bytes). Key: "w<id>", or "self" in a single process.
    static SharedTable statTable = null;

    // Previous sample per worker id, for the periodic rate line.
    static List<long> stPrevReq = new List<long>();
    static List<long> stPrevCpuMs = new List<long>();

    [DllImport("crt")]
    static extern void exit(int code);
    static bool debugLog = false;
    static void Dbg(string msg) {
        if (!debugLog) { return; }
        Console.WriteLine("[dbg] " + msg);
        #if WINDOWS
        int _f = _flushall();
        #endif
    }
    #if WINDOWS
    [DllImport("crt")]
    static extern int _flushall();
    #endif
    /// <summary>Enables verbose master/worker handoff tracing.</summary>
    static void SetDebug(bool on) {
        debugLog = on;
    }

    #if WINDOWS
    [DllImport("ws2_32", EntryPoint = "WSADuplicateSocketA")]
    static extern int WSADuplicateSocketA(nint s, int pid, string info);
    [DllImport("ws2_32", EntryPoint = "WSASocketA")]
    static extern nint WSASocketA(int af, int type, int protocol, string info, int g, int flags);
    [DllImport("kernel32", EntryPoint = "SetEnvironmentVariableA")]
    static extern int SetEnvironmentVariableA(string name, string val);
    #endif

    Worker(string protocol, string host, int port) {
        this.protocol = protocol;
        this.host = host;
        this.port = port;
        this.name = protocol + "-worker";
        this.running = false;
        this.connectionCount = 0;
        this.maxConnections = 10000;
        this.maxHeaderBytes = 16384;
        this.maxRequestBytes = 1048576;
        this.requestTimeout = 30000;
        this.count = 1;
        this.onConnect = null;
        this.onMessage = null;
        this.onClose = null;
        this.onHttpRequest = null;
        this.onUdpMessage = null;
        this.onSseSubscriber = null;
        this.onRawConnection = null;
        this.onOpen = null;
        this.onReceive = null;
        this.onPacket = null;
        this.onRequest = null;
        workers.Add(this);
    }

    ConnectionHandler OpenHandler() {
        if (this.onOpen != null) { return this.onOpen; }
        return this.onConnect;
    }

    MessageHandler MessageHandlerOf() {
        if (this.onMessage != null) { return this.onMessage; }
        return this.onReceive;
    }

    DatagramHandler PacketHandler() {
        if (this.onPacket != null) { return this.onPacket; }
        return this.onUdpMessage;
    }

    HttpRequestHandler RequestHandler() {
        if (this.onRequest != null) { return this.onRequest; }
        return this.onHttpRequest;
    }

    // Whether this worker can serve WebSocket connections, i.e. whether an HTTP
    // port should honour an Upgrade request instead of answering it as HTTP.
    bool HasWsHandlers() {
        if (this.onOpen != null) { return true; }
        if (this.onMessage != null) { return true; }
        return false;
    }

    /// <summary>Creates a Worker from an address like "http://0.0.0.0:8080".</summary>
    static Worker Listen(string address) {
        string proto = "tcp";
        string rest = address;
        int n = address.Length;
        for (int i = 0; i + 2 < n; i = i + 1) {
            if ((address[i] & 255) == 58 && (address[i + 1] & 255) == 47 && (address[i + 2] & 255) == 47) {
                proto = address.Substring(0, i);
                rest = address.Substring(i + 3, n - i - 3);
                break;
            }
        }
        string host = rest;
        int port = 0;
        int colon = -1;
        int j = rest.Length - 1;
        while (j >= 0) {
            if ((rest[j] & 255) == 58) { colon = j; break; }
            j = j - 1;
        }
        if (colon >= 0) {
            host = rest.Substring(0, colon);
            port = Convert.ToInt32(rest.Substring(colon + 1, rest.Length - colon - 1));
        }
        return new Worker(proto, host, port);
    }

    /// <summary>Sets the worker name (used in log lines).</summary>
    Worker SetName(string name) {
        this.name = name;
        return this;
    }

    /// <summary>Sets max concurrent connections for this Worker (per process).
    /// Connections over the limit are accepted and immediately closed.</summary>
    Worker SetMaxConnections(int max) {
        this.maxConnections = max;
        return this;
    }

    /// <summary>Sets the HTTP limits enforced per connection: header block
    /// size (431 past it), whole-request size (413), and the time a single
    /// request may take before the connection is hung up (0 disables).</summary>
    Worker SetHttpLimits(int maxHeaderBytes, int maxRequestBytes, int timeoutMs) {
        this.maxHeaderBytes = maxHeaderBytes;
        this.maxRequestBytes = maxRequestBytes;
        this.requestTimeout = timeoutMs;
        return this;
    }

    /// <summary>Sets the number of worker processes (like Workerman's
    /// $worker->count). The process-wide worker count is the max over all
    /// registered Workers.</summary>
    Worker SetCount(int count) {
        this.count = count;
        return this;
    }

    /// <summary>Requests daemon mode: on Linux the master detaches from the
    /// terminal (setsid) before serving. No-op elsewhere.</summary>
    static void SetDaemonize(bool on) {
        daemonize = on;
    }

    /// <summary>Overrides the loopback control port used by the master/worker
    /// handshake (default: first Worker's port + 10000).</summary>
    static void SetControlPort(int port) {
        controlPort = port;
    }

    /// <summary>Seconds between status lines printed by the foreground
    /// master/single-process server (like watching workerman's status).
    /// 0 disables printing; stats are still collected.</summary>
    static void SetStatusInterval(int seconds) {
        statusInterval = seconds;
    }

    /// <summary>When set, each worker process redirects its stdout/stderr to
    /// <dir>/worker_<id>.log (like Workerman's stdout_file). Otherwise worker
    /// output is discarded (workers run detached without a console).</summary>
    static void SetLogDir(string dir) {
        logDir = dir;
    }

    static int MaxCount() {
        int m = 1;
        for (int i = 0; i < workers.Count; i = i + 1) {
            if (workers[i].count > m) { m = workers[i].count; }
        }
        return m;
    }

    static int ControlPort() {
        if (controlPort > 0) { return controlPort; }
        string env = ProcessHost.Env("ZAN_CTL_PORT");
        if (env != "") { return Convert.ToInt32(env); }
        if (workers.Count > 0) { return workers[0].port + 10000; }
        return 19999;
    }

    /// <summary>Runs the process-management command line, workerman-style:
    ///
    ///   app                 -- start in the foreground (debug)
    ///   app start           -- same
    ///   app start -d        -- start as a daemon
    ///   app stop            -- stop the running master and its workers
    ///   app restart [-d]    -- stop, then start
    ///   app reload          -- replace the workers one at a time, letting the
    ///                          old ones finish what they are serving
    ///   app status          -- print the running server's worker table
    ///
    /// The running instance is addressed through its control port, so no pid
    /// file has to be kept in sync, and the same commands work on Windows,
    /// where signals are not available.
    ///
    /// Start commands never return; the others exit when the master answers.
    /// </summary>
    static async void RunCommand() {
        cliMode = true;
        string cmd = "start";
        bool detach = false;
        for (int i = 0; i < Environment.ArgCount(); i = i + 1) {
            string a = Environment.ArgAt(i);
            if (a == "-d" || a == "--daemon") {
                detach = true;
            } else if (a == "--ctl-port" && i + 1 < Environment.ArgCount()) {
                // The control port is derived (first Worker's port + 10000),
                // so two servers on nearby ports collide with no way out but
                // an environment variable. Name it on the command line, and
                // stop/status/reload address the same instance.
                controlPort = Convert.ToInt32(Environment.ArgAt(i + 1));
            } else if (i == 0) {
                cmd = a;
            }
        }

        if (cmd == "stop") {
            await SendCommand("STOP");
            return;
        }
        if (cmd == "reload") {
            await SendCommand("RELOAD");
            return;
        }
        if (cmd == "status") {
            await SendCommand("STATUS");
            return;
        }
        if (cmd == "restart") {
            await SendCommand("STOP");
            // Give the old master time to drop the control port before the new
            // one claims it exclusively.
            await Task.Delay(1500);
            cmd = "start";
        }
        if (cmd != "start") {
            Console.WriteLine("usage: " + Worker.Usage());
            return;
        }
        if (detach) { daemonize = true; }
        await RunAll();
    }

    // Sends one command line to the running master and prints its answer.
    static async void SendCommand(string cmd) {
        Socket.Initialize();
        TcpClient c = await TcpClient.ConnectAsync("127.0.0.1", ControlPort());
        if (c == null || !c.IsConnected()) {
            Console.WriteLine("[Worker] no server on control port "
                + Convert.ToString(ControlPort()));
            return;
        }
        int _s = await c.SendAsync(cmd + "\n");
        string reply = "";
        while (true) {
            string chunk = await c.RecvAsync(4096);
            if (chunk.Length == 0) { break; }
            reply = reply + chunk;
        }
        c.Close();
        if (reply.Length > 0) { Console.Write(reply); }
    }

    /// <summary>Runs every registered Worker. Never returns. In the master
    /// process with count > 1 this spawns and supervises worker processes;
    /// in a worker process (or with count == 1) it serves connections.</summary>
    static async void RunAll() {
        Socket.Initialize();

        if (ProcessHost.IsWorker()) {
            await RunAsWorkerProcess();
            return;
        }

        if (daemonize) {
            if (ProcessHost.Daemonize()) {
                exit(0);
            }
        }

        int procs = MaxCount();
        if (procs <= 1) {
            StatsCreate(1);
            Task.Spawn(StatsPublishLoop());
            PrintBanner(1);
            // stop/status/reload have to reach a single-process server too, so
            // it listens on the control port just like a master does. Only
            // under RunCommand: a program that just calls RunAll gets exactly
            // the behaviour it had before, with no extra port bound.
            if (cliMode) { Task.Spawn(SingleProcessControlLoop()); }
            await RunAllLoopsInProcess(true);
            return;
        }

        PrintBanner(procs);
        await RunAsMaster(procs);
    }

    // Table formatting for the start-up and status screens (ServerBanner owns
    // the column/rule geometry so both screens line up the same way).
    static string Pad(string s, int width) {
        return ServerBanner.Pad(s, width);
    }

    static string Rule(string title) {
        return ServerBanner.Rule(title);
    }

    /// <summary>Prints the workerman-style start-up screen: version line, then
    /// one row per listener with protocol, address, process count and
    /// state.</summary>
    static void PrintBanner(int procs) {
        string mode = "single process";
        if (procs > 1) { mode = "master + " + Convert.ToString(procs) + " workers"; }
        ServerBanner b = new ServerBanner("ZAN", "WORKERS").Mode(mode);
        for (int i = 0; i < workers.Count; i = i + 1) {
            Worker w = workers[i];
            int c = w.count;
            if (c < 1) { c = 1; }
            b.Service(w.name,
                w.protocol + "://" + w.host + ":" + Convert.ToString(w.port),
                Convert.ToString(c), "[OK]");
        }
        if (cliMode) { b.Commands(Worker.Usage()); }
        b.Footer("Press Ctrl+C to stop. Start success.");
        b.Print();
    }

    // ---- shared stats table ----

    static string StatsName() {
        return "zanworker_" + Convert.ToString(ControlPort());
    }

    static string StatsKey(int wid) {
        if (wid <= 0) { return "self"; }
        return "w" + Convert.ToString(wid);
    }

    /// Master (or single process): create the shared stats table, one row per
    /// process. Workers open the same table by name.
    static void StatsCreate(int procs) {
        SharedTable t = new SharedTable(StatsName(), procs + 8);
        t.KeySize(16);
        t.ColumnInt("pid");
        t.ColumnInt("recv");
        t.ColumnInt("sent");
        t.ColumnInt("conns");
        t.ColumnInt("cpu");
        t.ColumnInt("rss");
        if (t.Create()) {
            // Seed the rows so a worker's first publish writes into an
            // existing row instead of racing to create one.
            for (int wid = 0; wid <= procs; wid = wid + 1) {
                t.SetInt(StatsKey(wid), "pid", 0);
            }
            statTable = t;
            return;
        }
        SharedTable existing = SharedTable.Open(StatsName());
        if (existing.IsOpen()) { statTable = existing; }
    }

    static void StatsOpen() {
        SharedTable t = SharedTable.Open(StatsName());
        if (t.IsOpen()) { statTable = t; }
    }

    /// Publishes this process's counters into its row.
    static void StatsPublish() {
        SharedTable t = statTable;
        if (t == null) { return; }
        if (!t.IsOpen()) { return; }
        string key = StatsKey(ProcessHost.WorkerId());
        t.SetInt(key, "pid", ProcessHost.Pid());
        t.SetInt(key, "recv", statRequests);
        t.SetInt(key, "sent", statSent);
        t.SetInt(key, "conns", LiveConnections());
        t.SetInt(key, "cpu", ServerMetrics.CpuMillis());
        t.SetInt(key, "rss", ServerMetrics.MemoryRssBytes());
    }

    static async void StatsPublishLoop() {
        while (true) {
            await Task.Delay(2000);
            StatsPublish();
        }
    }

    static long StatsRead(int wid, string column) {
        SharedTable t = statTable;
        if (t == null) { return 0; }
        if (!t.IsOpen()) { return 0; }
        return t.GetInt(StatsKey(wid), column);
    }

    /// <summary>The command line a CLI-driven server answers.</summary>
    static string Usage() {
        return "<app> [start [-d] | stop | restart [-d] | reload | status]"
            + " [--ctl-port N]";
    }

    /// <summary>Stops all workers in this process (single-process mode).</summary>
    static void StopAll() {
        for (int i = 0; i < workers.Count; i = i + 1) {
            workers[i].Stop();
        }
    }

    void Stop() {
        this.running = false;
    }

    int GetConnectionCount() {
        return this.connectionCount;
    }

    // ======================================================================
    // master: spawn + share listeners + supervise
    // ======================================================================

    // Total children ever spawned by this master. Hard safety cap: a bug that
    // respawns workers in a tight loop must never take the machine down again.
    static int totalSpawned = 0;
    static int maxTotalSpawns = 512;

    static void SpawnChild(int wid) {
        if (totalSpawned >= maxTotalSpawns) {
            Console.WriteLine("[Worker] spawn cap (" + Convert.ToString(maxTotalSpawns)
                + ") reached; refusing to spawn more workers");
            return;
        }
        totalSpawned = totalSpawned + 1;
        string exe = ProcessHost.SelfExe();
        int ctl = ControlPort();
        #if WINDOWS
        // Set the variables in our own environment so the child inherits them
        // via CreateProcess (cmd-level `set X=..&&` does not survive the
        // cmd.exe /c hop that Process.RunDetached uses), then clear them so
        // the master itself never looks like a worker.
        SetEnvironmentVariableA("ZAN_WORKER_ID", Convert.ToString(wid));
        SetEnvironmentVariableA("ZAN_CTL_PORT", Convert.ToString(ctl));
        string cmd = "\"" + exe + "\"";
        if (logDir != "") {
            // Extra outer quotes so cmd.exe /c does not strip the quote around
            // the exe path when the command also contains a quoted log path.
            cmd = "\"" + cmd + " > \"" + logDir + "\\worker_" + Convert.ToString(wid)
                + ".log\" 2>&1\"";
        }
        Process.RunDetached(cmd);
        SetEnvironmentVariableA("ZAN_WORKER_ID", "");
        SetEnvironmentVariableA("ZAN_CTL_PORT", "");
        #else
        string cmd = "ZAN_WORKER_ID=" + Convert.ToString(wid)
            + " ZAN_CTL_PORT=" + Convert.ToString(ctl)
            + " \"" + exe + "\"";
        if (logDir != "") {
            cmd = cmd + " > \"" + logDir + "/worker_" + Convert.ToString(wid)
                + ".log\" 2>&1";
        }
        Process.RunDetached(cmd);
        #endif
    }

    // ---- master-side handoff channel registry (Windows) ----
    // One entry per (worker process, TCP listener) channel connection, filled
    // in by HandleWorkerControl when a worker sends its CHAN handshake.
    static List<int> chIdx = new List<int>();      // listener index served
    static List<int> chPid = new List<int>();      // worker process pid
    static List<TcpClient> chConn = new List<TcpClient>();
    static int rrCounter = 0;

    /// True when something ACCEPTS a connection on the control port, i.e. a
    /// master really is running. A port that merely refuses the connection is
    /// a leftover socket (TIME_WAIT) and can be reclaimed.
    static async bool ControlPortHasMaster() {
        TcpClient probe = await TcpClient.ConnectAsync("127.0.0.1", ControlPort());
        if (probe == null) { return false; }
        bool live = probe.IsConnected();
        probe.Close();
        return live;
    }

    static async void RunAsMaster(int procs) {
        // Fork-bomb guard: claim the control port exclusively (no SO_REUSEADDR)
        // BEFORE spawning anything. If a child ever mistakes itself for a
        // master (e.g. env vars failed to propagate), its bind fails here and
        // it exits instead of spawning children of its own.
        nint ctlSock = Socket.CreateTcp();
        #if !WINDOWS
        // Lets a restart rebind while the previous master's control
        // connections are still in TIME_WAIT. On POSIX this does not allow a
        // second listener on the port, so the exclusivity check below still
        // catches a master that is actually running. (Not on Windows, where
        // SO_REUSEADDR would let one process steal another's port.)
        Socket.SetReuseAddr(ctlSock);
        #endif
        int ctlBind = Socket.Bind(ctlSock, "127.0.0.1", ControlPort());
        if (ctlBind != 0) {
            // A failed bind does not mean a master owns the port: on Windows
            // the previous master's control port sits in TIME_WAIT for about
            // two minutes after it exits, and SO_REUSEADDR is not set there
            // (it would let one process steal a live listener). So ask the
            // port itself -- only something that ACCEPTS a connection is a
            // running master; a lingering socket refuses it.
            bool live = await ControlPortHasMaster();
            if (live) {
                Console.WriteLine("[Worker] FATAL: control port "
                    + Convert.ToString(ControlPort())
                    + " is served by a running master; stop it first"
                    + " (<app> stop), or start this one with --ctl-port N");
                exit(1);
            }
            Socket.Close(ctlSock);
            ctlSock = Socket.CreateTcp();
            Socket.SetReuseAddr(ctlSock);
            ctlBind = Socket.Bind(ctlSock, "127.0.0.1", ControlPort());
            if (ctlBind != 0) {
                Console.WriteLine("[Worker] FATAL: cannot bind control port "
                    + Convert.ToString(ControlPort())
                    + "; start with --ctl-port N to pick another one");
                exit(1);
            }
            Console.WriteLine("[Worker] control port "
                + Convert.ToString(ControlPort())
                + " was left behind by a previous run; reclaimed it");
        }
        Socket.Listen(ctlSock, 64);
        Socket.SetNonBlocking(ctlSock);

        // On Windows the master owns every listen socket, accepts on its own
        // IOCP, and hands each accepted connection to a worker; on POSIX
        // workers bind their own SO_REUSEPORT sockets.
        #if WINDOWS
        for (int i = 0; i < workers.Count; i = i + 1) {
            Worker w = workers[i];
            nint s = w.BindSocket(false);
            if (s < 0) {
                Console.WriteLine("[Worker] FATAL: cannot bind " + w.protocol
                    + "://" + w.host + ":" + Convert.ToString(w.port));
                exit(1);
            }
            if (w.protocol == "udp") {
                // No accept to distribute: serve UDP in the master itself.
                Task.Spawn(w.RunOnSocket(s));
            } else {
                Task.Spawn(MasterAcceptLoop(i, s));
            }
        }
        #endif

        // The stats table must exist before the first worker starts, so a
        // worker's Open always finds it.
        StatsCreate(procs);

        int wid = 1;
        while (wid <= procs) {
            SpawnChild(wid);
            wid = wid + 1;
        }


        // Accept control connections forever: first HELLO from each worker gets
        // the listener handoff, then the connection doubles as a liveness watch
        // (worker died => respawn it).
        while (true) {
            nint sock = await Socket.AcceptAsync(ctlSock);
            if (sock < 0) { continue; }
            Socket.SetNonBlocking(sock);
            Task.Spawn(HandleWorkerControl(sock));
        }
    }

    #if WINDOWS
    // Master accept loop for listener `idx`: event-driven accept on the
    // master's IOCP, then hand the accepted socket to the next worker.
    static async void MasterAcceptLoop(int idx, nint sock) {
        Dbg("accept loop up idx=" + Convert.ToString(idx));
        while (true) {
            nint c = await Socket.AcceptAsync(sock);
            Dbg("accepted idx=" + Convert.ToString(idx) + " c=" + Convert.ToString(c));
            if (c < 0) { continue; }
            await HandoffClient(idx, c);
        }
    }

    // Round-robin pick of a live channel serving listener `idx`; -1 if none.
    static int PickChannel(int idx) {
        int n = chIdx.Count;
        if (n == 0) { return -1; }
        rrCounter = rrCounter + 1;
        int start = rrCounter;
        for (int k = 0; k < n; k = k + 1) {
            int slot = (start + k) % n;
            if (chIdx[slot] == idx) { return slot; }
        }
        return -1;
    }

    static void DropChannel(int slot) {
        chConn[slot].Close();
        chIdx.RemoveAt(slot);
        chPid.RemoveAt(slot);
        chConn.RemoveAt(slot);
    }

    // Duplicates accepted socket `c` into a worker process and closes the
    // master's copy once the worker ACKs that it rebuilt the socket.
    static async void HandoffClient(int idx, nint c) {
        while (true) {
            int slot = PickChannel(idx);
            if (slot < 0) {
                // No worker online (all crashed / still starting): drop.
                Socket.Close(c);
                return;
            }
            TcpClient ch = chConn[slot];
            byte[] info = new byte[373];
            int r = WSADuplicateSocketA(c, chPid[slot], info);
            Dbg("dup c=" + Convert.ToString(c) + " -> pid=" + Convert.ToString(chPid[slot]) + " r=" + Convert.ToString(r));
            if (r != 0) {
                Socket.Close(c);
                return;
            }
            int n = await Socket.SendAsync(ch.GetSocket(), info, 372);
            if (n <= 0) { DropChannel(slot); continue; }
            string ack = await ch.RecvAsync(1);
            Dbg("ack len=" + Convert.ToString(ack.Length));
            if (ack.Length == 0) { DropChannel(slot); continue; }
            Socket.Close(c);
            return;
        }
    }
    #endif

    static async void HandleWorkerControl(nint sock) {
        TcpClient conn = TcpClient.FromSocket(sock);

        // First line is the handshake:
        //   "HELLO <pid> <wid>\n"        -- control/liveness/STAT connection
        //   "CHAN <pid> <listenerIdx>\n" -- Windows per-listener handoff channel
        string line = "";
        bool ok = true;
        while (true) {
            int nl = IndexOfByte(line, 10);
            if (nl >= 0) { line = line.Substring(0, nl); break; }
            string chunk = await conn.RecvAsync(256);
            if (chunk.Length == 0) { ok = false; break; }
            line = line + chunk;
        }
        if (!ok) { conn.Close(); return; }

        List<string> f = SplitWords(line);
        if (f.Count == 0) { conn.Close(); return; }

        // Commands from the CLI (`app stop|reload|status`) share the control
        // port with the worker handshake: they are single words.
        if (f[0] == "STOP" || f[0] == "RELOAD" || f[0] == "STATUS") {
            await HandleCliCommand(conn, f[0]);
            return;
        }
        if (f.Count < 3) { conn.Close(); return; }

        #if WINDOWS
        if (f[0] == "CHAN") {
            // Register the handoff channel; it is written to by HandoffClient
            // from now on and dropped when a send/ACK fails (worker died).
            chPid.Add(Convert.ToInt32(f[1]));
            chIdx.Add(Convert.ToInt32(f[2]));
            chConn.Add(conn);
            Dbg("chan registered pid=" + f[1] + " idx=" + f[2] + " total=" + Convert.ToString(chConn.Count));
            return;
        }
        #endif
        if (f[0] != "HELLO") { conn.Close(); return; }
        int childPid = Convert.ToInt32(f[1]);
        int childWid = Convert.ToInt32(f[2]);

        #if !WINDOWS
        int _n = await Socket.SendStringAsync(sock, "GO\n");
        #endif

        Console.WriteLine("[Worker] worker " + Convert.ToString(childWid)
            + " (pid " + Convert.ToString(childPid) + ") online");
        ctlConn.Add(conn);
        ctlWid.Add(childWid);

        // Supervise: the control connection stays open for the worker's whole
        // life (counters travel through the shared stats table, not this
        // socket); it closing means the worker exited.
        while (true) {
            string beat = await conn.RecvAsync(256);
            if (beat.Length == 0) { break; }
        }
        conn.Close();
        DropCtl(conn);
        if (stopping) {
            Console.WriteLine("[Worker] worker " + Convert.ToString(childWid)
                + " (pid " + Convert.ToString(childPid) + ") stopped");
            return;
        }
        Console.WriteLine("[Worker] worker " + Convert.ToString(childWid)
            + " (pid " + Convert.ToString(childPid) + ") exited; respawning");
        // Pace respawns so a worker that dies instantly on startup cannot
        // drive a rapid spawn loop.
        await Task.Delay(1000);
        SpawnChild(childWid);
    }

    static void DropCtl(TcpClient conn) {
        for (int i = 0; i < ctlConn.Count; i = i + 1) {
            if (ctlConn[i] == conn) {
                ctlConn.RemoveAt(i);
                ctlWid.RemoveAt(i);
                return;
            }
        }
    }

    // Master side of `app stop|reload|status`.
    //
    // stop:   ask every worker to quit (each finishes what it is serving),
    //         wait for their control connections to close, then exit.
    // reload: ask them to quit one at a time; the supervisor respawns each one,
    //         so the port is served throughout.
    // status: send back the same table the foreground master prints.
    static async void HandleCliCommand(TcpClient conn, string cmd) {
        if (cmd == "STATUS") {
            int _s = await conn.SendAsync(StatusText());
            conn.Close();
            return;
        }
        if (cmd == "STOP") {
            stopping = true;
            int _r = await conn.SendAsync("stopping "
                + Convert.ToString(ctlConn.Count) + " worker(s)\n");
            conn.Close();
            await StopWorkersAndExit();
            return;
        }
        // RELOAD: answer right away and cycle the workers in the background,
        // so the caller is not held for the whole rolling restart.
        int _l = await conn.SendAsync("reloading "
            + Convert.ToString(ctlConn.Count) + " worker(s)\n");
        conn.Close();
        Task.Spawn(ReloadWorkers());
    }

    static async void StopWorkersAndExit() {
        for (int i = 0; i < ctlConn.Count; i = i + 1) {
            int _q = await ctlConn[i].SendAsync("QUIT\n");
        }
        int waited = 0;
        while (ctlConn.Count > 0 && waited < 30000) {
            await Task.Delay(200);
            waited = waited + 200;
        }
        Console.WriteLine("[Worker] master stopped");
        exit(0);
    }

    // Replaces the workers one at a time: each is asked to quit, finishes what
    // it is serving and exits, the supervisor respawns it, and only then is the
    // next one touched -- so the listener is served throughout.
    static async void ReloadWorkers() {
        int total = ctlConn.Count;
        int done = 0;
        while (done < total && ctlConn.Count > 0) {
            TcpClient victim = ctlConn[0];
            int wid = ctlWid[0];
            int before = ctlConn.Count;
            int _q = await victim.SendAsync("QUIT\n");
            int waited = 0;
            while (waited < 30000 && ctlConn.Count >= before) {
                await Task.Delay(100);
                waited = waited + 100;
            }
            Console.WriteLine("[Worker] reloaded worker " + Convert.ToString(wid));
            done = done + 1;
            // Let the replacement report in before cycling the next one.
            await Task.Delay(1500);
        }
        Console.WriteLine("[Worker] reload complete");
    }

    // The status table `app status` prints, built from the workers' last
    // reports (master) or this process's own counters (single process).
    static string StatusText() {
        StringBuilder sb = new StringBuilder();
        sb.Append(Rule("ZAN STATUS"));
        sb.Append("\n");
        sb.Append(Pad("master pid: " + Convert.ToString(ProcessHost.Pid()), 30));
        sb.Append("control port: " + Convert.ToString(ControlPort()));
        sb.Append("\n");
        sb.Append(Pad("service", 22) + Pad("listen", 32)
            + Pad("processes", 12) + "status\n");
        for (int i = 0; i < workers.Count; i = i + 1) {
            Worker w = workers[i];
            int wc = w.count;
            if (wc < 1) { wc = 1; }
            sb.Append(Pad(w.name, 22)
                + Pad(w.protocol + "://" + w.host + ":" + Convert.ToString(w.port), 32)
                + Pad(Convert.ToString(wc), 12) + "[OK]\n");
        }
        sb.Append(Rule(""));
        sb.Append("\n");
        sb.Append(Pad("worker", 8) + Pad("pid", 9) + Pad("received", 12)
            + Pad("sent", 12) + Pad("clients", 10) + Pad("cpu ms", 10)
            + "memory\n");
        int procs = MaxCount();
        if (procs <= 1) {
            // Single process: publish first so the row is this second's truth.
            StatsPublish();
            sb.Append(StatusRow("self", 0));
            return sb.ToString();
        }
        long totRecv = 0;
        long totSent = 0;
        long totConns = 0;
        int wid = 1;
        while (wid <= procs) {
            if (StatsRead(wid, "pid") != 0) {
                totRecv = totRecv + StatsRead(wid, "recv");
                totSent = totSent + StatsRead(wid, "sent");
                totConns = totConns + StatsRead(wid, "conns");
                sb.Append(StatusRow("w" + Convert.ToString(wid), wid));
            }
            wid = wid + 1;
        }
        sb.Append("total   received: " + Convert.ToString(totRecv)
            + "   sent: " + Convert.ToString(totSent)
            + "   clients: " + Convert.ToString(totConns) + "\n");
        return sb.ToString();
    }

    // One process row of the status table, read from the shared stats table.
    static string StatusRow(string label, int wid) {
        return Pad(label, 8)
            + Pad(Convert.ToString(StatsRead(wid, "pid")), 9)
            + Pad(Convert.ToString(StatsRead(wid, "recv")), 12)
            + Pad(Convert.ToString(StatsRead(wid, "sent")), 12)
            + Pad(Convert.ToString(StatsRead(wid, "conns")), 10)
            + Pad(Convert.ToString(StatsRead(wid, "cpu")), 10)
            + Convert.ToString(StatsRead(wid, "rss") / 1048576) + "MB\n";
    }

    // Control listener for a single-process server started through RunCommand:
    // the same stop/reload/status commands, answered without a master.
    static async void SingleProcessControlLoop() {
        nint ctlSock = Socket.CreateTcp();
        #if !WINDOWS
        Socket.SetReuseAddr(ctlSock);
        #endif
        if (Socket.Bind(ctlSock, "127.0.0.1", ControlPort()) != 0) {
            // Same as the master: a refused port is a leftover socket from the
            // previous run, so stop/status/reload still reach this server
            // instead of silently going unanswered for two minutes.
            Socket.Close(ctlSock);
            if (await ControlPortHasMaster()) { return; }
            ctlSock = Socket.CreateTcp();
            Socket.SetReuseAddr(ctlSock);
            if (Socket.Bind(ctlSock, "127.0.0.1", ControlPort()) != 0) {
                Socket.Close(ctlSock);
                return;
            }
        }
        Socket.Listen(ctlSock, 16);
        Socket.SetNonBlocking(ctlSock);
        while (true) {
            nint s = await Socket.AcceptAsync(ctlSock);
            if (s < 0) { continue; }
            Socket.SetNonBlocking(s);
            Task.Spawn(HandleSelfCommand(s));
        }
    }

    static async void HandleSelfCommand(nint sock) {
        TcpClient conn = TcpClient.FromSocket(sock);
        string line = "";
        while (true) {
            int nl = IndexOfByte(line, 10);
            if (nl >= 0) { line = line.Substring(0, nl); break; }
            string chunk = await conn.RecvAsync(64);
            if (chunk.Length == 0) { conn.Close(); return; }
            line = line + chunk;
        }
        List<string> f = SplitWords(line);
        if (f.Count == 0) { conn.Close(); return; }
        if (f[0] == "STATUS") {
            int _s = await conn.SendAsync(StatusText());
            conn.Close();
            return;
        }
        if (f[0] == "STOP") {
            StopAll();
            int _r = await conn.SendAsync("stopped\n");
            conn.Close();
            await DrainThenExit();
            return;
        }
        if (f[0] == "RELOAD") {
            // Nothing to replace without worker processes; a single-process
            // server is reloaded by restarting it.
            int _l = await conn.SendAsync("single-process server: use restart\n");
            conn.Close();
            return;
        }
        conn.Close();
    }

    // Stops accepting and leaves once the connections in flight are done (or
    // the grace period is over), so a stop/reload does not cut off a response
    // that is halfway out.
    static async void DrainThenExit() {
        StopAll();
        #if WINDOWS
        // Drop the handoff channels so the master stops giving this worker new
        // connections while it finishes the ones it already has.
        for (int c = 0; c < wkChannels.Count; c = c + 1) {
            wkChannels[c].Close();
        }
        #endif
        int waited = 0;
        while (waited < 30000) {
            int conns = 0;
            for (int i = 0; i < workers.Count; i = i + 1) {
                conns = conns + workers[i].connectionCount;
            }
            if (conns <= 0) { break; }
            await Task.Delay(100);
            waited = waited + 100;
        }
        exit(0);
    }

    // ======================================================================
    // worker process: obtain listeners, serve, exit with master
    // ======================================================================

    static async void RunAsWorkerProcess() {
        TcpClient ctl = await TcpClient.ConnectAsync("127.0.0.1", ControlPort());
        if (ctl == null || !ctl.IsConnected()) {
            Console.WriteLine("[Worker] worker cannot reach master; exiting");
            exit(1);
        }
        int _h = await ctl.SendAsync("HELLO " + Convert.ToString(ProcessHost.Pid())
            + " " + Convert.ToString(ProcessHost.WorkerId()) + "\n");

        #if WINDOWS
        // The master owns and accepts every TCP listener; open one handoff
        // channel per listener and serve the accepted sockets it delivers.
        // (UDP Workers run in the master on Windows.)
        int i = 0;
        for (; i < workers.Count; i = i + 1) {
            if (workers[i].protocol != "udp") {
                TcpClient ch = await TcpClient.ConnectAsync("127.0.0.1", ControlPort());
                if (ch == null || !ch.IsConnected()) {
                    Console.WriteLine("[Worker] channel connect failed; exiting");
                    exit(1);
                }
                int _c = await ch.SendAsync("CHAN " + Convert.ToString(ProcessHost.Pid())
                    + " " + Convert.ToString(i) + "\n");
                wkChannels.Add(ch);
                Task.Spawn(ChannelLoop(ch, workers[i]));
            }
        }
        #else
        // Wait for GO, then bind our own SO_REUSEPORT sockets.
        string go = await ctl.RecvAsync(16);
        if (go.Length == 0) { exit(1); }
        for (int i = 0; i < workers.Count; i = i + 1) {
            Worker w = workers[i];
            nint s = w.BindSocket(true);
            if (s < 0) {
                Console.WriteLine("[Worker] worker cannot bind "
                    + Convert.ToString(w.port) + "; exiting");
                exit(1);
            }
            Task.Spawn(w.RunOnSocket(s));
        }
        #endif

        // Publish this worker's counters into the shared stats table.
        StatsOpen();
        Task.Spawn(StatsPublishLoop());

        // Liveness watch: the master holds this connection open for our whole
        // life; when it closes (master exited), leave too. It also sends QUIT
        // for a stop or a reload, which means "stop accepting and leave once
        // the requests in flight are answered".
        while (true) {
            string beat = await ctl.RecvAsync(64);
            if (beat.Length == 0) { break; }
            if (IndexOfByte(beat, 81) >= 0) {   // 'Q'
                ctl.Close();
                await DrainThenExit();
                return;
            }
        }
        exit(0);
    }

    #if WINDOWS
    // Worker side of a handoff channel: each inbound 372-byte
    // WSAPROTOCOL_INFOA block is one accepted client connection. Rebuild the
    // socket, ACK so the master can close its copy, and serve it.
    static async void ChannelLoop(TcpClient ch, Worker w) {
        Dbg("worker chan loop up " + w.protocol);
        while (true) {
            byte[] info = new byte[373];
            bool ok = await RecvExact(ch, info, 372);
            if (!ok) {
                exit(0);   // master gone
            }
            nint s = WSASocketA(-1, -1, -1, info, 0, 1);
            Dbg("worker rebuilt s=" + Convert.ToString(s));
            int _a = await ch.SendAsync("K");
            if (_a <= 0) { exit(0); }
            if (s >= 0) {
                Socket.SetNonBlocking(s);
                w.Dispatch(s);
            }
        }
    }
    #endif

    static List<string> SplitWords(string s) {
        List<string> parts = new List<string>();
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < s.Length; i = i + 1) {
            int c = s[i] & 255;
            if (c == 32 || c == 9 || c == 13 || c == 10) {
                if (sb.Length > 0) { parts.Add(sb.ToString()); sb = new StringBuilder(); }
            } else {
                sb.Append(s.Substring(i, 1));
            }
        }
        if (sb.Length > 0) { parts.Add(sb.ToString()); }
        return parts;
    }

    // Foreground master: print one status block per interval, computing each
    // worker's qps and cpu%% from the deltas between its last two reports.
    static async void MasterStatusLoop() {
        long prevWall = ServerMetrics.MonoMillis();
        while (true) {
            await Task.Delay(statusInterval * 1000);
            long now = ServerMetrics.MonoMillis();
            long dWall = now - prevWall;
            prevWall = now;
            if (dWall <= 0) { continue; }
            StringBuilder sb = new StringBuilder();
            sb.Append("[status]");
            long totQps = 0;
            int procs = MaxCount();
            while (stPrevReq.Count <= procs) {
                stPrevReq.Add(0);
                stPrevCpuMs.Add(0);
            }
            int wid = 1;
            while (wid <= procs) {
                long pid = StatsRead(wid, "pid");
                if (pid == 0) { wid = wid + 1; continue; }
                long recv = StatsRead(wid, "recv");
                long cpu = StatsRead(wid, "cpu");
                long dReq = recv - stPrevReq[wid];
                long dCpu = cpu - stPrevCpuMs[wid];
                stPrevReq[wid] = recv;
                stPrevCpuMs[wid] = cpu;
                long qps = (dReq * 1000) / dWall;
                totQps = totQps + qps;
                long cpuPct = -1;
                if (cpu >= 0 && dCpu >= 0) { cpuPct = (dCpu * 100) / dWall; }
                sb.Append(" | w" + Convert.ToString(wid)
                    + " pid=" + Convert.ToString(pid)
                    + " reqs=" + Convert.ToString(recv)
                    + " qps=" + Convert.ToString(qps)
                    + " sent=" + Convert.ToString(StatsRead(wid, "sent"))
                    + " conns=" + Convert.ToString(StatsRead(wid, "conns"))
                    + " cpu=" + Convert.ToString(cpuPct) + "%"
                    + " mem=" + Convert.ToString(StatsRead(wid, "rss") / 1048576) + "MB");
                wid = wid + 1;
            }
            sb.Append(" | total qps=" + Convert.ToString(totQps));
            Console.WriteLine(sb.ToString());
        }
    }

    // Single-process server: same status line from in-process counters.
    static async void SelfStatusLoop() {
        long prevWall = ServerMetrics.MonoMillis();
        long prevReq = 0;
        long prevCpu = 0;
        while (true) {
            await Task.Delay(statusInterval * 1000);
            long now = ServerMetrics.MonoMillis();
            long dWall = now - prevWall;
            prevWall = now;
            if (dWall <= 0) { continue; }
            long cpu = ServerMetrics.CpuMillis();
            long rss = ServerMetrics.MemoryRssBytes();
            long qps = ((statRequests - prevReq) * 1000) / dWall;
            long cpuPct = -1;
            if (cpu >= 0) { cpuPct = ((cpu - prevCpu) * 100) / dWall; }
            prevReq = statRequests;
            prevCpu = cpu;
            Console.WriteLine("[status] pid=" + Convert.ToString(ProcessHost.Pid())
                + " reqs=" + Convert.ToString(statRequests)
                + " qps=" + Convert.ToString(qps)
                + " sent=" + Convert.ToString(statSent)
                + " conns=" + Convert.ToString(LiveConnections())
                + " cpu=" + Convert.ToString(cpuPct) + "%"
                + " mem=" + Convert.ToString(rss / 1048576) + "MB");
        }
    }

    /// <summary>Receives exactly `need` bytes into `dest` (binary-safe).</summary>
    static async bool RecvExact(TcpClient conn, byte[] dest, int need) {
        byte[] tmp = new byte[need + 1];
        int got = 0;
        while (got < need) {
            int n = await Socket.RecvIntoAsync(conn.GetSocket(), tmp, need - got);
            if (n <= 0) { return false; }
            for (int k = 0; k < n; k = k + 1) {
                dest[got + k] = tmp[k];
            }
            got = got + n;
        }
        return true;
    }

    static int IndexOfByte(string s, int b) {
        for (int i = 0; i < s.Length; i = i + 1) {
            if ((s[i] & 255) == b) { return i; }
        }
        return -1;
    }

    // ======================================================================
    // in-process serving
    // ======================================================================

    /// <summary>Runs all registered workers concurrently on this process's
    /// scheduler. Every worker but the last is spawned as its own coroutine;
    /// the last is awaited so this call drives the scheduler forever.</summary>
    static async void RunAllLoopsInProcess(bool bindOwn) {
        int n = workers.Count;
        for (int j = 0; j < n - 1; j = j + 1) {
            Task.Spawn(workers[j].RunOwnSocket());
        }
        if (n > 0) {
            await workers[n - 1].RunOwnSocket();
        }
    }

    /// <summary>Binds this worker's socket. For "udp" that is a bound datagram
    /// socket; otherwise a listening TCP socket. reusePort=true additionally
    /// sets SO_REUSEPORT before bind (POSIX multi-worker). Returns the socket
    /// or -1.</summary>
    nint BindSocket(bool reusePort) {
        if (this.protocol == "udp") {
            nint u = Socket.CreateUdp();
            Socket.SetReuseAddr(u);
            if (reusePort) { Socket.SetReusePort(u); }
            int r = Socket.Bind(u, this.host, this.port);
            if (r != 0) { Socket.Close(u); return -1; }
            Socket.SetNonBlocking(u);
            return u;
        }
        nint s = Socket.CreateTcp();
        Socket.SetReuseAddr(s);
        if (reusePort) { Socket.SetReusePort(s); }
        int r2 = Socket.Bind(s, this.host, this.port);
        if (r2 != 0) { Socket.Close(s); return -1; }
        Socket.Listen(s, 511);
        Socket.SetNonBlocking(s);
        return s;
    }

    async void RunOwnSocket() {
        nint s = this.BindSocket(false);
        if (s < 0) {
            Console.WriteLine("[Worker] FATAL: cannot bind " + this.protocol
                + "://" + this.host + ":" + Convert.ToString(this.port));
            return;
        }
        await this.RunOnSocket(s);
    }

    /// <summary>Serves this worker's protocol on an already-bound socket.</summary>
    async void RunOnSocket(nint sock) {
        this.running = true;

        if (this.protocol == "udp") {
            await RunUdp(sock);
            return;
        }

        while (this.running) {
            nint clientSock = await Socket.AcceptAsync(sock);
            if (clientSock >= 0) {
                Socket.SetNonBlocking(clientSock);
                this.Dispatch(clientSock);
            }
        }
    }

    // Starts serving one accepted client on its own coroutine, so the caller
    // (accept loop or handoff channel) immediately moves to the next one.
    void Dispatch(nint clientSock) {
        Socket.SetNoDelay(clientSock);
        // Application-owned socket: the raw handler drives the whole
        // connection (its own request loop and connection accounting), so it
        // bypasses the built-in per-protocol handlers and connectionCount gate.
        if (this.onRawConnection != null) {
            Task.Spawn(this.RunRaw(clientSock));
            return;
        }
        if (this.connectionCount >= this.maxConnections) {
            Socket.Close(clientSock);
            return;
        }
        this.connectionCount = this.connectionCount + 1;
        if (this.protocol == "http") {
            // An HTTP port with WebSocket callbacks answers both, the way
            // swoole's WebSocket\Server does: the request head decides.
            if (this.HasWsHandlers()) {
                Task.Spawn(HandleWebSocket(clientSock));
            } else {
                Task.Spawn(HandleHttp(clientSock));
            }
        } else if (this.protocol == "websocket" || this.protocol == "ws") {
            Task.Spawn(HandleWebSocket(clientSock));
        } else if (this.protocol == "sse") {
            Task.Spawn(HandleSse(clientSock));
        } else if (this.protocol == "mqtt") {
            Task.Spawn(HandleMqtt(clientSock));
        } else {
            Task.Spawn(HandleTcp(clientSock));
        }
    }

    // Spawnable async wrapper around the raw-connection delegate. Task.Spawn
    // needs a concrete async method frame; awaiting the delegate here uses the
    // proven indirect async-call path (spawning the delegate call directly does
    // not build a task frame).
    async void RunRaw(nint clientSock) {
        // The delegate owns the protocol, so it counts its own messages.
        await this.onRawConnection(clientSock);
    }

    Connection NewConnection(nint sock) {
        int id = nextConnId;
        nextConnId = nextConnId + 1;
        return new Connection(id, sock, this.protocol);
    }

    // ---- tcp ----

    async void HandleTcp(nint clientSock) {
        TcpClient client = TcpClient.FromSocket(clientSock);
        Connection conn = NewConnection(clientSock);
        ConnectionHandler onUp = this.OpenHandler();
        if (onUp != null) { await onUp(conn); }

        MessageHandler onData = this.MessageHandlerOf();
        bool active = true;
        while (active && !conn.closed) {
            string data = await client.RecvReuseAsync();
            if (data.Length == 0) {
                active = false;
            } else {
                BumpStat();
                string response = "";
                if (onData != null) {
                    response = await onData(conn, data);
                } else {
                    response = data;   // default: echo
                }
                if (response.Length > 0) {
                    int _n = await client.SendAsync(response);
                    BumpSent();
                }
            }
        }
        client.Close();
        conn.closed = true;
        this.connectionCount = this.connectionCount - 1;
        if (this.onClose != null) { await this.onClose(conn); }
    }

    // ---- http ----

    // HTTP framing, limits and dispatch live in exactly one place --
    // HttpServer.ServeConnection -- which this protocol runs as-is, so the
    // Worker path and a bare HttpServer cannot drift apart.
    async void HandleHttp(nint clientSock) {
        await HttpServer.ServeConnection(clientSock, this.RequestHandler(),
            this.maxHeaderBytes, this.maxRequestBytes, this.requestTimeout);
        this.connectionCount = this.connectionCount - 1;
    }

    // ---- websocket ----

    // A WebSocket port is an HTTP port until the client asks to upgrade, so the
    // request head is read and parsed first: an Upgrade request becomes a frame
    // loop, anything else is served as HTTP (swoole's WebSocket\Server does the
    // same). The bytes consumed here are handed to whichever path takes over.
    async void HandleWebSocket(nint clientSock) {
        TcpClient client = TcpClient.FromSocket(clientSock);

        string rawReq = "";
        int headerEnd = -1;
        while (headerEnd < 0) {
            if (rawReq.Length > this.maxHeaderBytes) {
                client.Close();
                this.connectionCount = this.connectionCount - 1;
                return;
            }
            string chunk = await client.RecvAsync(65536);
            if (chunk.Length == 0) {
                client.Close();
                this.connectionCount = this.connectionCount - 1;
                return;
            }
            rawReq = rawReq + chunk;
            headerEnd = HttpServer.FindHeaderEnd(rawReq);
        }
        HttpRequest req = HttpRequest.Parse(rawReq);
        string wsKey = req.GetHeader("Sec-WebSocket-Key");

        if (wsKey.Length == 0) {
            // Plain HTTP on the same port. The head is already consumed, so it
            // is replayed into the HTTP loop rather than re-read.
            await HttpServer.ServePrimed(clientSock, this.RequestHandler(), rawReq,
                this.maxHeaderBytes, this.maxRequestBytes, this.requestTimeout);
            this.connectionCount = this.connectionCount - 1;
            return;
        }

        StringBuilder sb = new StringBuilder();
        sb.Append("HTTP/1.1 101 Switching Protocols\r\n");
        sb.Append("Upgrade: websocket\r\n");
        sb.Append("Connection: Upgrade\r\n");
        sb.Append("Sec-WebSocket-Accept: ");
        sb.Append(Encoding.WebSocketAccept(wsKey));
        sb.Append("\r\n\r\n");
        int _hs = await client.SendAsync(sb.ToString());

        Connection conn = NewConnection(clientSock);
        ConnectionHandler onUp = this.OpenHandler();
        if (onUp != null) { await onUp(conn); }

        // Reassemble whole frames via WsReader (handles partial and coalesced
        // frames), rather than assuming one recv == one frame.
        WsReader reader = new WsReader(clientSock);
        if (rawReq.Length > headerEnd) {
            // The client pipelined frames behind the handshake.
            reader.Prime(rawReq.Substring(headerEnd), rawReq.Length - headerEnd);
        }
        WsWriter writer = new WsWriter();
        MessageHandler onFrameData = this.MessageHandlerOf();
        bool active = true;
        while (active && !conn.closed) {
            int total = reader.FrameSize();
            while (total < 0) {
                // Nothing more to answer from this batch: put the replies on the
                // wire before parking on the reactor.
                if (writer.Pending()) { int _f = await writer.Flush(client); }
                int got = await reader.FillMore();
                if (got == 0) {
                    active = false;
                    break;
                }
                total = reader.FrameSize();
            }
            if (!active) { break; }

            WsFrame frame = reader.TakeFrame(total);

            if (frame.opcode == WsOpcode.Text || frame.opcode == WsOpcode.Binary) {
                BumpStat();
                string response = "";
                if (onFrameData != null) {
                    response = await onFrameData(conn, frame.payload);
                } else {
                    response = frame.payload;   // default: echo
                }
                if (response.Length > 0) {
                    WsFrame respFrame = WsFrame.TextFrame(response);
                    respFrame.opcode = frame.opcode;
                    byte[] encoded = respFrame.Encode();
                    int hdrLen = 2;
                    if (response.Length > 65535) { hdrLen = 10; }
                    else if (response.Length > 125) { hdrLen = 4; }
                    writer.Append(encoded, hdrLen + response.Length);
                    BumpSent();
                }
            } else if (frame.opcode == WsOpcode.Ping) {
                WsFrame pong = WsFrame.PongFrame();
                byte[] encoded = pong.Encode();
                writer.Append(encoded, 2);
            } else if (frame.opcode == WsOpcode.Close) {
                WsFrame closeResp = WsFrame.CloseFrame();
                byte[] enc2 = closeResp.Encode();
                writer.Append(enc2, 2);
                int _c = await writer.Flush(client);
                active = false;
            }
        }

        client.Close();
        conn.closed = true;
        this.connectionCount = this.connectionCount - 1;
        if (this.onClose != null) { await this.onClose(conn); }
    }

    // ---- sse ----

    async void HandleSse(nint clientSock) {
        TcpClient client = TcpClient.FromSocket(clientSock);

        // Read the subscriber's GET request head.
        string req = "";
        while (HttpServer.FindHeaderEnd(req) < 0 && req.Length < 65536) {
            string chunk = await client.RecvAsync(4096);
            if (chunk.Length == 0) {
                client.Close();
                this.connectionCount = this.connectionCount - 1;
                return;
            }
            req = req + chunk;
        }
        string path = "/";
        HttpRequest head = HttpRequest.Parse(req);
        if (head.path.Length > 0) { path = head.path; }

        int _n = await client.SendAsync("HTTP/1.1 200 OK\r\n"
            + "Content-Type: text/event-stream\r\n"
            + "Cache-Control: no-cache\r\n"
            + "Connection: keep-alive\r\n"
            + "Access-Control-Allow-Origin: *\r\n"
            + "\r\n");

        BumpStat();
        SseConnection sse = SseConnection.Of(client, path);
        if (this.onSseSubscriber != null) {
            await this.onSseSubscriber(sse);
        } else {
            sse.Close();
        }
        // The application owns the SseConnection from here.
        this.connectionCount = this.connectionCount - 1;
    }

    // ---- mqtt ----

    async void HandleMqtt(nint clientSock) {
        BumpStat();
        await MqttBroker.Global().HandleConnection(clientSock);
        this.connectionCount = this.connectionCount - 1;
    }

    // ---- udp ----

    async void RunUdp(nint sock) {
        DatagramHandler onDatagram = this.PacketHandler();
        while (this.running) {
            string data = await Socket.RecvFromPeerAsync(sock, 65536);
            if (data.Length > 0) {
                BumpStat();
                string peerIp = Socket.PeerIp();
                int peerPort = Socket.PeerPort();
                string response = "";
                if (onDatagram != null) {
                    response = await onDatagram(data);
                } else {
                    response = data;   // default: echo
                }
                if (response.Length > 0 && peerPort > 0) {
                    int _n = await Socket.SendToAsync(sock, response, response.Length, peerIp, peerPort);
                    BumpSent();
                }
            }
        }
        Socket.Close(sock);
    }
}

/// <summary>
/// One accepted client connection, passed to Worker callbacks. Send pushes
/// data to the peer from any (including non-async) context; Close marks the
/// connection for shutdown after the current callback returns.
/// </summary>
class Connection {
    int id;
    nint sock;
    string protocol;
    string userData;
    bool closed;

    Connection(int id, nint sock, string protocol) {
        this.id = id;
        this.sock = sock;
        this.protocol = protocol;
        this.userData = "";
        this.closed = false;
    }

    /// <summary>Arbitrary per-connection state for the application.</summary>
    void SetData(string data) {
        this.userData = data;
    }

    string GetData() {
        return this.userData;
    }

    int GetId() {
        return this.id;
    }

    nint GetSocket() {
        return this.sock;
    }

    string GetProtocol() {
        return this.protocol;
    }

    /// <summary>Queues raw bytes to the peer (fire-and-forget; usable from
    /// synchronous callbacks). For "websocket" workers, prefer returning the
    /// reply from onMessage so it is framed; Send writes raw bytes.</summary>
    void Send(string data) {
        Task.Spawn(Socket.SendStringAsync(this.sock, data));
        Worker.BumpSent();
    }

    /// <summary>Sends data and suspends until it is written.</summary>
    async int SendAsync(string data) {
        int n = await Socket.SendStringAsync(this.sock, data);
        Worker.BumpSent();
        return n;
    }

    /// <summary>Marks the connection to be closed by its worker loop.</summary>
    void Close() {
        this.closed = true;
    }

    bool IsClosed() {
        return this.closed;
    }
}
