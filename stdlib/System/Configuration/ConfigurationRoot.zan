using System;
using System.Text;
using System.Threading;

namespace System.Configuration;

// 应用程序配置根管理器，负责级联聚合多个配置源并支持热重载。
public class ConfigurationRoot : IConfiguration, IDisposable {
    public List<IConfigurationProvider> providers;
    public List<Action> reloadCallbacks;
    public nint syncLock;

    public ConfigurationRoot(List<IConfigurationProvider> providers) {
        this.providers = new List<IConfigurationProvider>();
        if (providers != null) {
            for (int i = 0; i < providers.Count; i = i + 1) {
                this.providers.Add(providers[i]);
            }
        }
        this.reloadCallbacks = new List<Action>();
        this.syncLock = Mutex.Create();
    }

    // 占位符 ${VAR:-default} 解析
    public static string ResolvePlaceholders(string val) {
        if (val == null || val.IndexOf("${") < 0) {
            return val;
        }
        StringBuilder sb = new StringBuilder();
        int i = 0;
        int len = val.Length;
        while (i < len) {
            int start = val.IndexOf("${", i);
            if (start < 0) {
                sb.Append(val.Substring(i, len - i));
                break;
            }
            sb.Append(val.Substring(i, start - i));
            int end = val.IndexOf("}", start + 2);
            if (end < 0) {
                sb.Append(val.Substring(start, len - start));
                break;
            }
            string expr = val.Substring(start + 2, end - start - 2);
            string varName = expr;
            string defaultVal = "";
            int colonDash = expr.IndexOf(":-");
            if (colonDash >= 0) {
                varName = expr.Substring(0, colonDash);
                defaultVal = expr.Substring(colonDash + 2, expr.Length - colonDash - 2);
            }
            string envVal = Environment.GetEnvironmentVariable(varName);
            if (envVal != null && envVal.Length > 0) {
                sb.Append(envVal);
            } else {
                sb.Append(defaultVal);
            }
            i = end + 1;
        }
        return sb.ToString();
    }

    public string Get(string key) {
        if (key == null) { return null; }
        // 倒序遍历配置提供程序：后添加的源优先级更高
        for (int i = this.providers.Count - 1; i >= 0; i = i - 1) {
            string v;
            if (this.providers[i].TryGet(key, out v)) {
                return ConfigurationRoot.ResolvePlaceholders(v);
            }
        }
        return null;
    }

    public string GetString(string key, string defaultValue) {
        string v = this.Get(key);
        return v != null ? v : defaultValue;
    }

    public int GetInt(string key, int defaultValue) {
        string v = this.Get(key);
        if (v == null) { return defaultValue; }
        try {
            return Convert.ToInt32(v);
        } catch (Exception ex) {
            return defaultValue;
        }
    }

    public long GetLong(string key, long defaultValue) {
        string v = this.Get(key);
        if (v == null) { return defaultValue; }
        try {
            return Convert.ToInt64(v);
        } catch (Exception ex) {
            return defaultValue;
        }
    }

    public bool GetBool(string key, bool defaultValue) {
        string v = this.Get(key);
        if (v == null) { return defaultValue; }
        string lower = v.ToLower().Trim();
        if (lower == "true" || lower == "1" || lower == "yes" || lower == "on") {
            return true;
        }
        if (lower == "false" || lower == "0" || lower == "no" || lower == "off") {
            return false;
        }
        return defaultValue;
    }

    public IConfigurationSection GetSection(string key) {
        return new ConfigurationSection(this, key);
    }

    public List<string> GetKeys() {
        Dictionary<string, bool> keySet = new Dictionary<string, bool>();
        for (int i = 0; i < this.providers.Count; i = i + 1) {
            List<string> pKeys = this.providers[i].GetKeys();
            for (int j = 0; j < pKeys.Count; j = j + 1) {
                keySet[pKeys[j]] = true;
            }
        }
        return keySet.Keys;
    }

    public void Reload() {
        for (int i = 0; i < this.providers.Count; i = i + 1) {
            this.providers[i].Load();
        }
        List<Action> snapshot = new List<Action>();
        Mutex.Lock(this.syncLock);
        for (int i = 0; i < this.reloadCallbacks.Count; i = i + 1) {
            snapshot.Add(this.reloadCallbacks[i]);
        }
        Mutex.Unlock(this.syncLock);

        for (int i = 0; i < snapshot.Count; i = i + 1) {
            try {
                snapshot[i]();
            } catch (Exception ex) {
                // 异常安全隔离
            }
        }
    }

    public void OnReload(Action callback) {
        if (callback == null) { return; }
        Mutex.Lock(this.syncLock);
        this.reloadCallbacks.Add(callback);
        Mutex.Unlock(this.syncLock);
    }

    public void Dispose() {
        if (this.syncLock != 0) {
            Mutex.Destroy(this.syncLock);
            this.syncLock = 0;
        }
        if (this.providers != null) {
            this.providers.Clear();
        }
        if (this.reloadCallbacks != null) {
            this.reloadCallbacks.Clear();
        }
    }

    ~ConfigurationRoot() {
        this.Dispose();
    }
}
