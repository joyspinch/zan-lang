using System;
using System.Text;
using System.Threading;

namespace System.Configuration;

// 链式配置构建器。
public class ConfigurationBuilder {
    public List<IConfigurationProvider> providers;

    public ConfigurationBuilder() {
        this.providers = new List<IConfigurationProvider>();
    }

    public ConfigurationBuilder AddProvider(IConfigurationProvider provider) {
        if (provider != null) {
            this.providers.Add(provider);
        }
        return this;
    }

    public ConfigurationBuilder AddInMemory(Dictionary<string, string> initialData) {
        return this.AddProvider(new MemoryConfigurationProvider(initialData));
    }

    public ConfigurationBuilder AddInMemoryValue(string key, string value) {
        MemoryConfigurationProvider mem = new MemoryConfigurationProvider();
        mem.Set(key, value);
        return this.AddProvider(mem);
    }

    public ConfigurationBuilder AddEnvironmentVariables(string prefix) {
        return this.AddProvider(new EnvironmentConfigurationProvider(prefix));
    }

    // 加入一个 JSON 配置文件。文件不存在时抛 FileNotFoundException。
    public ConfigurationBuilder AddJsonFile(string path) {
        return this.AddProvider(new JsonFileConfigurationProvider(path));
    }

    // 加入一个 JSON 配置文件。optional 为真时文件不存在也照常构建。
    public ConfigurationBuilder AddJsonFile(string path, bool optional) {
        return this.AddProvider(new JsonFileConfigurationProvider(path, optional));
    }

    // 加入一个 JSON 配置文件，并把文件里的所有键挂在 rootSection 节下面。
    public ConfigurationBuilder AddJsonFile(string path, bool optional, string rootSection) {
        return this.AddProvider(new JsonFileConfigurationProvider(path, optional, rootSection));
    }

    // 加入一个 dotenv 风格配置文件（KEY=VALUE 一行一条）。
    public ConfigurationBuilder AddEnvFile(string path) {
        return this.AddProvider(new EnvFileConfigurationProvider(path));
    }

    // 加入一个 dotenv 风格配置文件。optional 为真时文件不存在也照常构建。
    public ConfigurationBuilder AddEnvFile(string path, bool optional) {
        return this.AddProvider(new EnvFileConfigurationProvider(path, optional));
    }

    public IConfiguration Build() {
        ConfigurationRoot root = new ConfigurationRoot(this.providers);
        root.Reload();
        return root;
    }
}
