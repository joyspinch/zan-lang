using System;
using System.Text;
using System.Threading;

namespace System.Configuration;

// 抽象基础配置提供程序，维护内存键值字典。
public class ConfigurationProvider : IConfigurationProvider {
    protected Dictionary<string, string> data;

    public ConfigurationProvider() {
        this.data = new Dictionary<string, string>();
    }

    // 取值：键先规范化，于是 "database:port"、"DATABASE__PORT" 与
    // "Database:Port" 命中同一条配置（各 provider 共用一套键空间）。
    public virtual bool TryGet(string key, out string value) {
        string canonical = ConfigurationKeys.Canonical(key);
        if (canonical.Length > 0 && this.data.ContainsKey(canonical)) {
            value = this.data[canonical];
            return true;
        }
        value = null;
        return false;
    }

    // 存值：键规范化后存放，与 TryGet 对齐。
    public virtual void Set(string key, string value) {
        string canonical = ConfigurationKeys.Canonical(key);
        if (canonical.Length == 0) { return; }
        this.data[canonical] = value;
    }

    public virtual void Load() {
    }

    public virtual List<string> GetKeys() {
        return this.data.Keys;
    }
}
