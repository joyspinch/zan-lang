using System;
using System.Text;
using System.Threading;

namespace System.Configuration;

// 抽象基础配置提供程序，维护内存键值字典。
public class ConfigurationProvider : IConfigurationProvider {
    protected Dictionary<string, string> data;

    public ConfigurationProvider() {
        this.data = new Dictionary<string, string>();
    }

    public virtual bool TryGet(string key, out string value) {
        if (this.data.ContainsKey(key)) {
            value = this.data[key];
            return true;
        }
        value = null;
        return false;
    }

    public virtual void Set(string key, string value) {
        this.data[key] = value;
    }

    public virtual void Load() {
    }

    public virtual List<string> GetKeys() {
        return this.data.Keys;
    }
}

// 内存键值配置提供程序。
public class MemoryConfigurationProvider : ConfigurationProvider {
    public MemoryConfigurationProvider() : base() {
    }

    public MemoryConfigurationProvider(Dictionary<string, string> initialData) : base() {
        if (initialData != null) {
            List<string> keys = initialData.Keys;
            for (int i = 0; i < keys.Count; i = i + 1) {
                string k = keys[i];
                this.data[k] = initialData[k];
            }
        }
    }
}

// 环境变量配置提供程序，支持前缀过滤与分隔符映射（如 APP__DATABASE__PORT 映射为 Database:Port）。
public class EnvironmentConfigurationProvider : ConfigurationProvider {
    string prefix;

    public EnvironmentConfigurationProvider(string prefix) : base() {
        this.prefix = prefix != null ? prefix : "";
    }

    public override void Load() {
        // 保持现有配置，若有外部注入按需生效
    }
}
