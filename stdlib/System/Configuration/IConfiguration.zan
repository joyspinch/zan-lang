using System;

namespace System.Configuration;

// 表示分层树状配置的一个配置小节。
public interface IConfigurationSection {
    // 获取指定键的配置值，不存在时返回 null。
    string Get(string key);

    // 获取字符串配置值，不存在时返回默认值。
    string GetString(string key, string defaultValue);

    // 获取 32 位整型配置值，不存在或解析失败时返回默认值。
    int GetInt(string key, int defaultValue);

    // 获取 64 位长整型配置值，不存在或解析失败时返回默认值。
    long GetLong(string key, long defaultValue);

    // 获取布尔型配置值（支持 true/false/1/0/yes/no），不存在或解析失败时返回默认值。
    bool GetBool(string key, bool defaultValue);

    // 获取当前节在其父级中的键名（如 "ConnectionStrings"）。
    string GetKey();

    // 获取当前节从根路径开始的完整层级路径（如 "Database:ConnectionStrings"）。
    string GetPath();

    // 获取当前节的原始标量值。
    string GetValue();

    // 设置当前节的原始标量值。
    void SetValue(string val);

    // 获取指定节名的子配置小节。
    IConfigurationSection GetSection(string sectionKey);

    // 获取当前作用域下的全部直接子键列表。
    List<string> GetKeys();
}

// 表示键值应用程序配置属性的分层集合根接口。
public interface IConfiguration {
    // 获取指定键的配置值，不存在时返回 null。
    string Get(string key);

    // 获取字符串配置值，不存在时返回默认值。
    string GetString(string key, string defaultValue);

    // 获取 32 位整型配置值，不存在或解析失败时返回默认值。
    int GetInt(string key, int defaultValue);

    // 获取 64 位长整型配置值，不存在或解析失败时返回默认值。
    long GetLong(string key, long defaultValue);

    // 获取布尔型配置值（支持 true/false/1/0/yes/no），不存在或解析失败时返回默认值。
    bool GetBool(string key, bool defaultValue);

    // 获取指定节名的子配置视图。
    IConfigurationSection GetSection(string key);

    // 获取当前作用域下的全部配置键列表。
    List<string> GetKeys();

    // 重新加载所有配置提供程序数据。
    void Reload();

    // 注册配置重载监听回调。
    void OnReload(Action callback);
}

// 配置提供程序接口，负责与特定数据源（内存、环境变量、外部配置中心）交互。
public interface IConfigurationProvider {
    // 尝试获取指定完整路径键的配置值。
    bool TryGet(string key, out string value);

    // 设置或更新配置项。
    void Set(string key, string value);

    // 从底层数据源拉取并加载配置。
    void Load();

    // 枚举全部键。
    List<string> GetKeys();
}
