namespace System;

class Console {
    public static ConsoleColor ForegroundColor {
        get { return (ConsoleColor)7; }
        set {
            int c = (int)value;
            int code = (c < 8) ? (30 + c) : (90 + (c - 8));
            string esc = "" + (char)27;
            Console.Write(esc + "[" + code + "m");
        }
    }

    public static ConsoleColor BackgroundColor {
        get { return (ConsoleColor)0; }
        set {
            int c = (int)value;
            int code = (c < 8) ? (40 + c) : (100 + (c - 8));
            string esc = "" + (char)27;
            Console.Write(esc + "[" + code + "m");
        }
    }

    public static string Title {
        set {
            string esc = "" + (char)27;
            string bel = "" + (char)7;
            Console.Write(esc + "]0;" + value + bel);
        }
    }

    public static void ResetColor() {
        string esc = "" + (char)27;
        Console.Write(esc + "[0m");
    }

    public static void Clear() {
        string esc = "" + (char)27;
        Console.Write(esc + "[2J" + esc + "[H");
    }

    [DllImport("crt", EntryPoint = "getchar")]
    static extern int getchar();

    public static string ReadLine() {
        return "";
    }

    public static int ReadKey(bool intercept) {
        return getchar();
    }

    public static int ReadKey() {
        return getchar();
    }

    public static int Read() {
        return getchar();
    }
}
