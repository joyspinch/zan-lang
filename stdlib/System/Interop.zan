using System;

namespace System;

/// <summary>
/// 动态原生链接：在运行时解析库及其入口点，
/// 并通过 delegate 调用，而不声明 `[DllImport]`
/// （加载时即需存在）。
///
///   nint user32 = Interop.Load("user32.dll");
///   nint addr   = Interop.Symbol(user32, "MessageBoxW");
///   MessageBoxW box = (MessageBoxW)addr;      // 地址 -> 可调用
///   box(0, Wide.Of("hi"), Wide.Of("zan"), 0);
///
/// `(Delegate)address` 转换及其逆操作 `(nint)handler` 是编译器的
/// 原语，因此可选依赖（一个可能未安装的运行时）
/// 无需 C shim：先探测，缺失时回退即可。
/// </summary>
class Interop {
#if WINDOWS
    [DllImport("kernel32", EntryPoint = "LoadLibraryA")]
    static extern nint WinLoad(string name);

    [DllImport("kernel32", EntryPoint = "GetProcAddress")]
    static extern nint WinSymbol(nint mod, string name);

    [DllImport("kernel32", EntryPoint = "FreeLibrary")]
    static extern int WinUnload(nint mod);

    [DllImport("kernel32", EntryPoint = "GetLastError")]
    static extern int WinLastError();
#else
    [DllImport("crt", EntryPoint = "dlopen")]
    static extern nint PosixLoad(string name, int flags);

    [DllImport("crt", EntryPoint = "dlsym")]
    static extern nint PosixSymbol(nint mod, string name);

    [DllImport("crt", EntryPoint = "dlclose")]
    static extern int PosixUnload(nint mod);

    [DllImport("crt", EntryPoint = "dlerror")]
    static extern string PosixError();

    /// RTLD_NOW | RTLD_LOCAL 的整数值：Linux/musl 上 RTLD_LOCAL 为 0
    /// （RTLD_NOW=2），Darwin 上 RTLD_LOCAL=4（RTLD_NOW=2），所以
    /// 不能只写一次硬编码常量。
    static int RtldNowLocal() {
        #if LINUX
        return 2;
        #else
        return 6;
        #endif
    }
#endif

    /// 最近一次 Load/Symbol 失败的原因文本。
    static string lastError = "";

    /// 上次失败加载的原生加载器错误文本（dlerror / Win32 错误码）；
    /// 没有失败时为空字符串。
    static string LastError() {
        return Interop.lastError;
    }

    /// 按名称或路径加载共享库；不存在时返回 0。
    static nint Load(string name) {
        #if WINDOWS
        nint m = Interop.WinLoad(name);
        Interop.lastError = "";
        if (m == 0) {
            Interop.lastError = "win32 error " +
                                Convert.ToString(Interop.WinLastError());
        }
        return m;
        #else
        // dlerror() 是线程局部的，且会被后续任何 dl* 调用清空，
        // 所以必须在失败的检查点立即读走。
        nint m = Interop.PosixLoad(name, Interop.RtldNowLocal());
        Interop.lastError = "";
        if (m == 0) { Interop.lastError = Interop.PosixError(); }
        return m;
        #endif
    }

    /// 导出入口点的地址；库中没有时返回 0
    /// （一种以 ABI 兼容方式探测新运行时特性的做法）。
    static nint Symbol(nint mod, string name) {
        if (mod == 0) { return 0; }
        #if WINDOWS
        return Interop.WinSymbol(mod, name);
        #else
        return Interop.PosixSymbol(mod, name);
        #endif
    }

    /// 卸载共享库；句柄为 0 时忽略。
    static void Unload(nint mod) {
        if (mod != 0) {
            #if WINDOWS
            Interop.WinUnload(mod);
            #else
            Interop.PosixUnload(mod);
            #endif
        }
    }

    /// 一步加载 `name` 并解析 `entry`；任一失败返回 0。
    static nint Entry(string name, string entry) {
        return Interop.Symbol(Interop.Load(name), entry);
    }

    static extern string getenv(string name);

    /// 从活动进程块读取环境变量，未设置时返回
    /// 空字符串。
    static string EnvVar(string name) {
        #if WINDOWS
        nint fn = Interop.Entry("kernel32.dll", "GetEnvironmentVariableW");
        if (fn == 0) { return ""; }
        GetEnvironmentVariableWFn call = (GetEnvironmentVariableWFn)fn;
        nint wname = Wide.Of(name);
        nint buf = NativeMemory.Alloc(2048);
        new Span<short>(buf, 1)[0] = 0;
        int units = call(wname, buf, 1023);
        string text = "";
        if (units > 0 && units < 1023) { text = Wide.Read(buf); }
        NativeMemory.Free(buf);
        Wide.Free(wname);
        return text;
        #else
        // 非 Windows 平台下 kernel32 导入在链接时被 stub，因此
        // 改为通过 libc 读取环境变量。
        string v = Interop.getenv(name);
        if (v == null) { return ""; }
        return v;
        #endif
    }
}

/// GetEnvironmentVariableW 的调用形式（name/buf 为宽字符指针，
/// size 为缓冲区的 UTF-16 码元容量，返回写入的码元数）。
delegate int GetEnvironmentVariableWFn(nint name, nint buf, int size);

/// <summary>
/// 针对 Win32/COM 宽字符（`W`）接口的 UTF-16 封送。
/// Zan 字符串是 UTF-8，因此宽字符参数是显式持有的缓冲区：
///
///   nint w = Wide.Of("https://example.com");
///   nav(webview, w);
///   Wide.Free(w);
/// </summary>
class Wide {
    [DllImport("kernel32", EntryPoint = "MultiByteToWideChar")]
    static extern int ToWide(int page, int flags, nint mb, int mbLen,
                             nint wide, int wideLen);

    [DllImport("kernel32", EntryPoint = "WideCharToMultiByte")]
    static extern int ToMulti(int page, int flags, nint wide, int wideLen,
                              nint mb, int mbLen, nint defChar, nint usedDef);

    /// 代码页 CP_UTF8（65001）。
    static int Utf8() { return 65001; }

    /// 分配 `s` 的 NUL 结尾 UTF-16 副本。用 Free() 释放。
    static nint Of(string s) {
        int bytes = s.Length;
        nint src = NativeMemory.Alloc(bytes + 1);
        NativeMemory.PutString(src, 0, s, bytes);
        new Span<byte>(src + bytes, 1)[0] = 0;
        int units = Wide.ToWide(Wide.Utf8(), 0, src, bytes + 1, 0, 0);
        if (units <= 0) { units = 1; }
        nint dst = NativeMemory.Alloc(units * 2 + 2);
        Wide.ToWide(Wide.Utf8(), 0, src, bytes + 1, dst, units);
        NativeMemory.Free(src);
        return dst;
    }

    /// 将 NUL 结尾的 UTF-16 缓冲区复制回 Zan 字符串。
    static string Read(nint p) {
        if (p == 0) { return ""; }
        int bytes = Wide.ToMulti(Wide.Utf8(), 0, p, -1, 0, 0, 0, 0);
        if (bytes <= 1) { return ""; }
        nint buf = NativeMemory.Alloc(bytes + 1);
        Wide.ToMulti(Wide.Utf8(), 0, p, -1, buf, bytes, 0, 0);
        string s = NativeMemory.GetString(buf, 0, bytes - 1);
        NativeMemory.Free(buf);
        return s;
    }

    /// 宽字符缓冲区中 NUL 终止符前的 UTF-16 码元数量。
    static int Length(nint p) {
        if (p == 0) { return 0; }
        int n = 0;
        for (; new Span<ushort>(p + n * 2, 1)[0] != 0; n = n + 1) { }
        return n;
    }

    /// 释放 Of() 分配的缓冲区（即 NativeMemory.Free）。
    static void Free(nint p) {
        NativeMemory.Free(p);
    }
}

/// PeekMessageW 的调用形式（remove 非 0 时从队列取走消息）。
delegate int PeekMessageFn(nint msg, nint hwnd, int min, int max, int remove);
/// TranslateMessage 的调用形式。
delegate int TranslateMessageFn(nint msg);
/// DispatchMessageW 的调用形式。
delegate nint DispatchMessageFn(nint msg);
/// Win32 Sleep 的调用形式（毫秒）。
delegate int SleepFn(int ms);

/// <summary>
/// 嵌套的 Win32 消息循环。异步 COM 完成以投递消息的形式
/// 到达调用（apartment）线程，因此等待完成就需要
/// 泵消息：同步包装器通过 `Pump.Until(flag, 5000)` 等待
/// 回调而不死锁 UI 线程。
/// </summary>
class Pump {
    /// 惰性解析出的 user32.dll 句柄与四个入口地址（0 为未加载/失败）。
    static nint user32;
    /// PeekMessageW 入口。
    static nint peek;
    /// TranslateMessage 入口。
    static nint translate;
    /// DispatchMessageW 入口。
    static nint dispatch;
    /// kernel32 Sleep 入口。
    static nint sleep;

    /// 惰性解析 user32/kernel32 的入口（只做一次）。
    static void Resolve() {
        if (Pump.user32 != 0) { return; }
        Pump.user32 = Interop.Load("user32.dll");
        Pump.peek = Interop.Symbol(Pump.user32, "PeekMessageW");
        Pump.translate = Interop.Symbol(Pump.user32, "TranslateMessage");
        Pump.dispatch = Interop.Symbol(Pump.user32, "DispatchMessageW");
        Pump.sleep = Interop.Entry("kernel32.dll", "Sleep");
    }

    /// 排空当前线程上所有已排队的消息。
    static void Drain() {
        Pump.Resolve();
        if (Pump.peek == 0) { return; }
        PeekMessageFn peekMsg = (PeekMessageFn)Pump.peek;
        TranslateMessageFn xlate = (TranslateMessageFn)Pump.translate;
        DispatchMessageFn dispatchMsg = (DispatchMessageFn)Pump.dispatch;
        nint msg = NativeMemory.Alloc(64);
        while (peekMsg(msg, 0, 0, 0, 1) != 0) {
            xlate(msg);
            dispatchMsg(msg);
        }
        NativeMemory.Free(msg);
    }

    /// 泵消息直到 `gate` 报告完成或超过 `timeoutMs`；
    /// 闸门打开时返回 true。
    static bool Until(PumpGate gate, int timeoutMs) {
        Pump.Resolve();
        SleepFn nap = (SleepFn)Pump.sleep;
        int waited = 0;
        while (waited < timeoutMs) {
            Pump.Drain();
            if (gate.IsDone()) { return true; }
            if (Pump.sleep != 0) { nap(5); }
            waited = waited + 5;
        }
        return gate.IsDone();
    }
}

/// 回调设置、Pump.Until() 等待的完成标志。
class PumpGate {
    bool done;

    PumpGate() {
        this.done = false;
    }

    /// 标记完成。
    void Signal() { done = true; }
    /// 是否已完成。
    bool IsDone() { return done; }
    /// 复位为未完成。
    void Reset() { done = false; }
}

/// vtable 方法的调用形式：每个 COM 方法都把接口
/// 指针作为第一个参数并返回 HRESULT，宽于
/// 寄存器的参数（RECT、结构体出参）以地址传递。
/// ComCall0Fn 到 ComCall5Fn 依次带 0 到 5 个指针参数。
delegate int ComCall0Fn(nint self);
/// 1 个指针参数的 COM 方法形式。
delegate int ComCall1Fn(nint self, nint a);
/// 2 个指针参数的 COM 方法形式。
delegate int ComCall2Fn(nint self, nint a, nint b);
/// 3 个指针参数的 COM 方法形式。
delegate int ComCall3Fn(nint self, nint a, nint b, nint c);
/// 4 个指针参数的 COM 方法形式。
delegate int ComCall4Fn(nint self, nint a, nint b, nint c, nint d);
/// 5 个指针参数的 COM 方法形式。
delegate int ComCall5Fn(nint self, nint a, nint b, nint c, nint d, nint e);

/// CoInitializeEx 的调用形式（返回 HRESULT）。
delegate int CoInitializeExFn(nint reserved, int flags);
/// CoUninitialize 的调用形式。
delegate void CoUninitializeFn();
/// TlsAlloc 的调用形式（返回 TLS 槽号）。
delegate int TlsAllocFn();
/// TlsGetValue 的调用形式。
delegate nint TlsGetValueFn(int index);
/// TlsSetValue 的调用形式（成功返回非 0）。
delegate int TlsSetValueFn(int index, nint data);
/// CoCreateInstance 的调用形式（返回 HRESULT）。
delegate int CoCreateInstanceFn(nint clsid, nint outer, int ctx, nint iid,
                                nint result);
/// CoTaskMemFree 的调用形式。
delegate void CoTaskMemFreeFn(nint p);

/// <summary>
/// 无需 C shim 的 COM：接口指针即地址，方法存在于
/// 对象的 vtable 中，槽位通过
/// delegate 转换变为可调用对象。
///
///   nint shell = Com.Create("00021401-0000-0000-C000-000000000046",
///                           "00000000-0000-0000-C000-000000000046");
///   Com.Call1(shell, 5, argument);   // vtable 槽位 5，`shell` 作为 `this`
///   Com.Release(shell);
///
/// 用 Zan 实现的 COM 对象（异步 COM API 的完成处理器都需要它）
/// 通过 ComVtbl 构建：将回调地址写入 vtable
/// （从 `(nint)handler` 获取），并把对象交还回去。
/// </summary>
class Com {
    /// ole32 在运行时解析而非链接时解析：
    /// 从不接触 COM 的程序既不会加载也不依赖它。
    static nint Ole() {
        if (Com.ole == 0) { Com.ole = Interop.Load("ole32.dll"); }
        return Com.ole;
    }

    /// 已解析的 ole32.dll 句柄（0 为未加载）。
    static nint ole;
    /// 保存"本线程 COM 已初始化"的 TLS 槽号；-1 表示分配失败。
    static int comTls = Com.AllocComTls();

    /// 分配记录 COM 初始化状态的 TLS 槽；失败返回 -1。
    static int AllocComTls() {
        nint fn = Interop.Entry("kernel32.dll", "TlsAlloc");
        if (fn == 0) { return 0 - 1; }
        TlsAllocFn alloc = (TlsAllocFn)fn;
        return alloc();
    }

    static int ComTls() { return Com.comTls; }

    /// 当前线程是否已通过本类初始化过 COM。
    static bool ComInitialized() {
        int tls = Com.ComTls();
        if (tls < 0) { return false; }
        nint fn = Interop.Entry("kernel32.dll", "TlsGetValue");
        if (fn == 0) { return false; }
        TlsGetValueFn call = (TlsGetValueFn)fn;
        return call(tls) != 0;
    }

    /// 设置本线程的 COM 初始化标志；TLS 不可用时返回 false。
    static bool SetComInitialized(bool initialized) {
        int tls = Com.ComTls();
        if (tls < 0) { return false; }
        nint fn = Interop.Entry("kernel32.dll", "TlsSetValue");
        if (fn == 0) { return false; }
        TlsSetValueFn call = (TlsSetValueFn)fn;
        return call(tls, initialized ? (nint)1 : (nint)0) != 0;
    }

    /// CoInitializeEx 包装；入口缺失返回 -1。
    static int CoInit(nint reserved, int flags) {
        nint fn = Interop.Symbol(Com.Ole(), "CoInitializeEx");
        if (fn == 0) { return 0 - 1; }
        CoInitializeExFn call = (CoInitializeExFn)fn;
        return call(reserved, flags);
    }

    /// CoUninitialize 包装；入口缺失时忽略。
    static void CoUninit() {
        nint fn = Interop.Symbol(Com.Ole(), "CoUninitialize");
        if (fn == 0) { return; }
        CoUninitializeFn call = (CoUninitializeFn)fn;
        call();
    }

    /// CoCreateInstance 包装；入口缺失返回 -1。
    static int CoCreate(nint clsid, nint outer, int ctx, nint iid,
                        nint result) {
        nint fn = Interop.Symbol(Com.Ole(), "CoCreateInstance");
        if (fn == 0) { return 0 - 1; }
        CoCreateInstanceFn call = (CoCreateInstanceFn)fn;
        return call(clsid, outer, ctx, iid, result);
    }

    /// CoTaskMemFree 包装；入口缺失时忽略。
    static void TaskFree(nint p) {
        nint fn = Interop.Symbol(Com.Ole(), "CoTaskMemFree");
        if (fn == 0) { return; }
        CoTaskMemFreeFn call = (CoTaskMemFreeFn)fn;
        call(p);
    }

    /// IUnknown vtable 布局，所有 COM 接口共用。
    static int SlotQueryInterface() { return 0; }
    static int SlotAddRef() { return 1; }
    static int SlotRelease() { return 2; }

    /// COINIT_APARTMENTTHREADED——UI/WebView2 对象所需的模式。
    static int Apartment() { return 2; }
    /// CLSCTX_INPROC_SERVER.
    static int InProc() { return 1; }

    /// HRESULT 是否成功（非负即成功，含 S_FALSE）。
    static bool Ok(int hr) { return hr >= 0; }

    /// 在调用线程上初始化 COM。S_FALSE 表示成功，且
    /// 与一次 Shutdown 配对；apartment 模式变更仍视为失败。
    static int Initialize() {
        if (Com.ComInitialized()) { return 0; }
        int hr = Com.CoInit(0, Com.Apartment());
        if (Com.Ok(hr) && !Com.SetComInitialized(true)) {
            Com.CoUninit();
            return Com.Fail();
        }
        return hr;
    }

    /// 在调用线程上平衡本类成功的 Initialize。
    static void Shutdown() {
        if (!Com.ComInitialized()) { return; }
        Com.SetComInitialized(false);
        Com.CoUninit();
    }

    /// 将 `xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx` 解析为新建的
    /// 16 字节 GUID（前三个字段为小端，符合 COM 预期）。
    static nint Guid(string text) {
        nint g = NativeMemory.Alloc(16);
        new Span<int>(g, 1)[0] = Com.Hex(text, 0, 8);
        new Span<short>(g + 4, 1)[0] = Com.Hex(text, 9, 4);
        new Span<short>(g + 6, 1)[0] = Com.Hex(text, 14, 4);
        new Span<byte>(g + 8, 1)[0] = Com.Hex(text, 19, 2);
        new Span<byte>(g + 9, 1)[0] = Com.Hex(text, 21, 2);
        for (int i = 0; i < 6; i = i + 1) {
            new Span<byte>(g + 10 + i, 1)[0] = Com.Hex(text, 24 + i * 2, 2);
        }
        return g;
    }

    /// 取 s 中 off 起 len 个十六进制字符的整数值（非法字符按 0）。
    static int Hex(string s, int off, int len) {
        int v = 0;
        for (int i = 0; i < len; i = i + 1) {
            int d = Com.Digit(s.Substring(off + i, 1));
            v = v * 16 + d;
        }
        return v;
    }

    /// 单个十六进制字符的数值；非法字符按 0。
    static int Digit(string ch) {
        if (ch == "0") { return 0; }
        if (ch == "1") { return 1; }
        if (ch == "2") { return 2; }
        if (ch == "3") { return 3; }
        if (ch == "4") { return 4; }
        if (ch == "5") { return 5; }
        if (ch == "6") { return 6; }
        if (ch == "7") { return 7; }
        if (ch == "8") { return 8; }
        if (ch == "9") { return 9; }
        if (ch == "a" || ch == "A") { return 10; }
        if (ch == "b" || ch == "B") { return 11; }
        if (ch == "c" || ch == "C") { return 12; }
        if (ch == "d" || ch == "D") { return 13; }
        if (ch == "e" || ch == "E") { return 14; }
        if (ch == "f" || ch == "F") { return 15; }
        return 0;
    }

    /// 释放 Guid() 分配的 16 字节。
    static void FreeGuid(nint g) {
        NativeMemory.Free(g);
    }

    /// 使用文本 GUID 调用 CoCreateInstance；类不可用时返回 0。
    static nint Create(string clsid, string iid) {
        nint c = Com.Guid(clsid);
        nint i = Com.Guid(iid);
        nint slot = NativeMemory.Alloc(8);
        new Span<long>(slot, 1)[0] = 0;
        int hr = Com.CoCreate(c, 0, Com.InProc(), i, slot);
        nint obj = new Span<long>(slot, 1)[0];
        NativeMemory.Free(slot);
        NativeMemory.Free(c);
        NativeMemory.Free(i);
        if (!Com.Ok(hr)) { return 0; }
        return obj;
    }

    /// 接口指针 vtable 槽位 `index` 处方法的地址。
    static nint Slot(nint iface, int index) {
        if (iface == 0) { return 0; }
        nint vtbl = new Span<long>(iface, 1)[0];
        if (vtbl == 0) { return 0; }
        return new Span<long>(vtbl + index * 8, 1)[0];
    }

    /// 调用 vtable 槽位 `index`，以接口指针作为 `this`。
    /// 槽位为空时返回 E_FAIL，缺失的方法会像调用失败一样
    /// 优雅降级，而不是跳到地址零。
    static int Call0(nint iface, int index) {
        nint f = Com.Slot(iface, index);
        if (f == 0) { return Com.Fail(); }
        ComCall0Fn call = (ComCall0Fn)f;
        return call(iface);
    }

    /// 同 Call0，多一个指针参数；槽位为空返回 E_FAIL。
    static int Call1(nint iface, int index, nint a) {
        nint f = Com.Slot(iface, index);
        if (f == 0) { return Com.Fail(); }
        ComCall1Fn call = (ComCall1Fn)f;
        return call(iface, a);
    }

    /// 同 Call0，多两个指针参数；槽位为空返回 E_FAIL。
    static int Call2(nint iface, int index, nint a, nint b) {
        nint f = Com.Slot(iface, index);
        if (f == 0) { return Com.Fail(); }
        ComCall2Fn call = (ComCall2Fn)f;
        return call(iface, a, b);
    }

    /// 同 Call0，多三个指针参数；槽位为空返回 E_FAIL。
    static int Call3(nint iface, int index, nint a, nint b, nint c) {
        nint f = Com.Slot(iface, index);
        if (f == 0) { return Com.Fail(); }
        ComCall3Fn call = (ComCall3Fn)f;
        return call(iface, a, b, c);
    }

    /// 同 Call0，多四个指针参数；槽位为空返回 E_FAIL。
    static int Call4(nint iface, int index, nint a, nint b, nint c, nint d) {
        nint f = Com.Slot(iface, index);
        if (f == 0) { return Com.Fail(); }
        ComCall4Fn call = (ComCall4Fn)f;
        return call(iface, a, b, c, d);
    }

    /// 同 Call0，多五个指针参数；槽位为空返回 E_FAIL。
    static int Call5(nint iface, int index, nint a, nint b, nint c, nint d,
                     nint e) {
        nint f = Com.Slot(iface, index);
        if (f == 0) { return Com.Fail(); }
        ComCall5Fn call = (ComCall5Fn)f;
        return call(iface, a, b, c, d, e);
    }

    /// E_FAIL.
    static int Fail() { return 0 - 2147467259; }

    /// 调用单个参数为 out 指针的槽位，返回
    /// 被调用者存入的值（失败时返回 0）——所有 COM getter 的通用形式。
    static nint Get(nint iface, int index) {
        nint cell = NativeMemory.Alloc(8);
        new Span<long>(cell, 1)[0] = 0;
        int hr = Com.Call1(iface, index, cell);
        nint v = new Span<long>(cell, 1)[0];
        NativeMemory.Free(cell);
        if (!Com.Ok(hr)) { return 0; }
        return v;
    }

    /// 返回 CoTaskMemAlloc 分配宽字符串的 getter，封送后释放。
    static string GetString(nint iface, int index) {
        return Com.TakeString(Com.Get(iface, index));
    }

    /// 通过 out 指针返回 32 位值（BOOL、枚举、计数）的 getter。
    static int GetInt(nint iface, int index) {
        nint cell = NativeMemory.Alloc(8);
        new Span<long>(cell, 1)[0] = 0;
        int hr = Com.Call1(iface, index, cell);
        int v = new Span<int>(cell, 1)[0];
        NativeMemory.Free(cell);
        if (!Com.Ok(hr)) { return 0; }
        return v;
    }

    /// 以文本 IID 调用 QueryInterface；不支持时返回 0。
    static nint Query(nint iface, string iid) {
        if (iface == 0) { return 0; }
        nint g = Com.Guid(iid);
        nint cell = NativeMemory.Alloc(8);
        new Span<long>(cell, 1)[0] = 0;
        int hr = Com.Call2(iface, Com.SlotQueryInterface(), g, cell);
        nint v = new Span<long>(cell, 1)[0];
        NativeMemory.Free(cell);
        NativeMemory.Free(g);
        if (!Com.Ok(hr)) { return 0; }
        return v;
    }

    /// 对借用的接口指针（即回调收到的）
    /// 持有引用，使其在调用结束后依然存活。
    static nint Keep(nint iface) {
        if (iface == 0) { return 0; }
        Com.Call0(iface, Com.SlotAddRef());
        return iface;
    }

    /// 平衡 Keep/Query/Create 得到的引用：调用 IUnknown.Release 槽位。
    static void Release(nint iface) {
        if (iface != 0) { Com.Call0(iface, Com.SlotRelease()); }
    }

    /// 释放被调用者用 CoTaskMemAlloc 分配的缓冲区（字符串
    /// 出参的常用约定）。
    static void Free(nint p) {
        if (p != 0) { Com.TaskFree(p); }
    }

    /// 读取 CoTaskMemAlloc 分配的宽字符串出参并释放。
    static string TakeString(nint p) {
        string s = Wide.Read(p);
        Com.Free(p);
        return s;
    }
}

/// <summary>
/// 用 Zan 实现的 COM 对象：`Add` 按 vtable 顺序追加方法地址
/// （从三个 IUnknown 槽位开始），`Build` 返回
/// 可供原生代码回调的接口指针。
///
///   ComVtbl v = ComVtbl.Create(4);
///   v.Add((nint)Handler.QueryInterface);
///   v.Add((nint)Handler.AddRef);
///   v.Add((nint)Handler.Release);
///   v.Add((nint)Handler.Invoke);
///   nint handler = v.Build();
///
/// 对象为 `{ vtable, state }`：`State()` 为调用者提供一个槽位，
/// 用于存放其关联 id，静态 handler 可从中
/// 通过传入的 `self` 指针读回。
/// </summary>
class ComVtbl {
    /// vtable 内存。
    nint vtbl;
    /// Build() 分配的对象指针（0 为未构建）。
    nint obj;
    /// vtable 容量（槽数）。
    int slots;
    /// 已填充的槽数。
    int count;

    /// 创建可容纳 slots 个条目的 vtable。
    static ComVtbl Create(int slots) {
        ComVtbl v = new ComVtbl();
        v.slots = slots;
        v.count = 0;
        v.vtbl = NativeMemory.Alloc(slots * 8);
        v.obj = 0;
        return v;
    }

    /// 追加下一个 vtable 条目；超过 `slots` 的多余条目会被忽略。
    ComVtbl Add(nint method) {
        if (count < slots) {
            new Span<long>(vtbl + count * 8, 1)[0] = method;
            count = count + 1;
        }
        return this;
    }

    /// 分配对象（vtable 指针 + 一个状态字）并返回
    /// 接口指针。
    nint Build() {
        if (obj == 0) {
            obj = NativeMemory.Alloc(16);
            new Span<long>(obj, 1)[0] = vtbl;
            new Span<long>(obj + 8, 1)[0] = 0;
        }
        return obj;
    }

    /// 由调用者持有、随对象携带的状态字。
    void SetState(int v) {
        if (obj != 0) { new Span<long>(obj + 8, 1)[0] = v; }
    }

    /// 静态 handler 侧：从回调收到的 self 指针读回 SetState 写入的
    /// 状态字。
    static int State(nint self) {
        if (self == 0) { return 0; }
        return new Span<long>(self + 8, 1)[0];
    }

    /// 释放对象与 vtable 内存（Build 之后调用才有效）。
    void Destroy() {
        if (obj != 0) { NativeMemory.Free(obj); obj = 0; }
        if (vtbl != 0) { NativeMemory.Free(vtbl); vtbl = 0; }
    }
}
