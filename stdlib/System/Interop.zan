using System;

namespace System;

// 并通过 delegate 调用，而不声明 `[DllImport]`
// （加载时即需存在）。
// MessageBoxW box = (MessageBoxW)addr;      // 地址 -> 可调用
// `(Delegate)address` 转换及其逆操作 `(nint)handler` 是编译器的
// 原语，因此可选依赖（一个可能未安装的运行时）
// 无需 C shim：先探测，缺失时回退即可。
public class Interop {
#if WINDOWS
    [DllImport("kernel32", EntryPoint = "LoadLibraryA")]
    public static extern nint WinLoad(string name);

    [DllImport("kernel32", EntryPoint = "GetProcAddress")]
    public static extern nint WinSymbol(nint mod, string name);

    [DllImport("kernel32", EntryPoint = "FreeLibrary")]
    public static extern int WinUnload(nint mod);

    [DllImport("kernel32", EntryPoint = "GetLastError")]
    public static extern int WinLastError();
#else
    [DllImport("crt", EntryPoint = "dlopen")]
    public static extern nint PosixLoad(string name, int flags);

    [DllImport("crt", EntryPoint = "dlsym")]
    public static extern nint PosixSymbol(nint mod, string name);

    [DllImport("crt", EntryPoint = "dlclose")]
    public static extern int PosixUnload(nint mod);

    [DllImport("crt", EntryPoint = "dlerror")]
    public static extern string PosixError();

    // RTLD_NOW | RTLD_LOCAL 的整数值：Linux/musl 上 RTLD_LOCAL 为 0
    // （RTLD_NOW=2），Darwin 上 RTLD_LOCAL=4（RTLD_NOW=2），所以
    // 不能只写一次硬编码常量。
    public static int RtldNowLocal() {
        #if LINUX
        return 2;
        #else
        return 6;
        #endif
    }
#endif

    // 最近一次 Load/Symbol 失败的原因文本。
    public static string lastError = "";

    // 上次失败加载的原生加载器错误文本（dlerror / Win32 错误码）；
    // 没有失败时为空字符串。
    public static string LastError() {
        return Interop.lastError;
    }

    // 按名称或路径加载共享库；不存在时返回 0。
    public static nint Load(string name) {
        #if WINDOWS
        nint m = Interop.WinLoad(name);
        Interop.lastError = "";
        if (m == 0) {
            Interop.lastError = "win32 error " +
                                Convert.ToString(Interop.WinLastError());
        }
        return m;
        #else
        // dlerror() 是线程局部的，且会被后续任何 dl* 调用清空，
        // 所以必须在失败的检查点立即读走。
        nint m = Interop.PosixLoad(name, Interop.RtldNowLocal());
        Interop.lastError = "";
        if (m == 0) { Interop.lastError = Interop.PosixError(); }
        return m;
        #endif
    }

    // 导出入口点的地址；库中没有时返回 0
    // （一种以 ABI 兼容方式探测新运行时特性的做法）。
    public static nint Symbol(nint mod, string name) {
        if (mod == 0) { return 0; }
        #if WINDOWS
        return Interop.WinSymbol(mod, name);
        #else
        return Interop.PosixSymbol(mod, name);
        #endif
    }

    // 卸载共享库；句柄为 0 时忽略。
    public static void Unload(nint mod) {
        if (mod != 0) {
            #if WINDOWS
            Interop.WinUnload(mod);
            #else
            Interop.PosixUnload(mod);
            #endif
        }
    }

    // 一步加载 `name` 并解析 `entry`；任一失败返回 0。
    public static nint Entry(string name, string entry) {
        return Interop.Symbol(Interop.Load(name), entry);
    }

    public static extern string getenv(string name);

    // 从活动进程块读取环境变量，未设置时返回
    // 空字符串。
    public static string EnvVar(string name) {
        #if WINDOWS
        nint fn = Interop.Entry("kernel32.dll", "GetEnvironmentVariableW");
        if (fn == 0) { return ""; }
        GetEnvironmentVariableWFn call = (GetEnvironmentVariableWFn)fn;
        nint wname = Wide.Of(name);
        nint buf = 0;
        string text = "";
        try {
            buf = NativeMemory.Alloc(2048);
            new Span<short>(buf, 1)[0] = 0;
            int size = 1023;
            int units = call(wname, buf, size);
            // 截断探测：值放不下时 Win32 返回所需码元数而非报错，
            // 避免长 PATH/TZ 环境变量静默截断。按所需尺寸重试一次，
            // 上限 32K 码元，满足 Windows 环境变量上限要求。
            if (units >= size && units < 32768) {
                NativeMemory.Free(buf);
                buf = 0;
                size = units + 1;
                buf = NativeMemory.Alloc(size * 2);
                units = call(wname, buf, size);
            }
            if (units > 0 && units < size) { text = Wide.Read(buf); }
        } finally {
            if (buf != 0) { NativeMemory.Free(buf); }
            Wide.Free(wname);
        }
        return text;
        #else
        // 非 Windows 平台下 kernel32 导入在链接时被 stub，因此
        // 改为通过 libc 读取环境变量。
        string v = Interop.getenv(name);
        if (v == null) { return ""; }
        return v;
        #endif
    }
}

// GetEnvironmentVariableW 的调用形式（name/buf 为宽字符指针，
// size 为缓冲区的 UTF-16 码元容量，返回写入的码元数）。
public delegate int GetEnvironmentVariableWFn(nint name, nint buf, int size);
