using System;
using System.Text;

namespace System.Json;

// JSON 键值对实体（消除散落各处的 keys 与 vals 平行列表反模式）。
public class JsonProperty {
    public string key;
    public JsonValue val;

    public JsonProperty() {
        this.key = "";
        this.val = null;
    }

    public JsonProperty(string key, JsonValue val) {
        this.key = key;
        this.val = val;
    }
}
