// 平面 tape JSON 解析器。热路径是单函数显式栈状态机（ParseCore）：
// 无递归、无每值调用、buf 尾部 pad 32 字节后 Load64 裸读。
// 错误 -(位置+1) 为首错位置、MaxDepth 容器封顶、空容器槽编码、escPool 物化保持稳定规范。
using System;
using System.Collections.Generic;
using System.Text;
using System.Threading;

namespace System.Json;

public delegate T JsonDocScopeFunc<T>(JsonDoc doc);
public delegate void JsonDocScopeAction(JsonDoc doc);

// 一个 JSON 槽位（tape 上的一个节点）。JsonDoc 的 slots 列表就是
// 解析出的整棵树，深度优先连续排布：标量内联在槽里，孩子紧随
// 容器槽之后。字段编码（16 字节，<see cref="JsonSlot.a"/> 低 8 位
// 是值类别，其余位按类别复用；b 是唯一的载荷字段）：
// - null/bool（kind 0/1/6）：a 即 kind，一位信息折进编码，b = 0；
// - 整数（kind 2，纯整数 token）：完整 64 位值放 <see cref="JsonSlot.b"/>；
// - 浮点（kind 7，带 . / e 的 token）：IEEE 754 位型经
// NativeMemory.AsI64 折进 <see cref="JsonSlot.b"/>（AsF64 取回）；
// - 字符串（kind 3）：无转义 token 零拷贝——a 高位记 src 起始偏移、
// b 记长度；含转义（无法零拷贝）a 高位记 -1，b 记 escPool 下标；
// - 数组（kind 4）/ 对象（kind 5）：b = 元素数 | (跳过偏移 &lt;&lt; 31)，
// 跳过偏移是"容器整体之后第一个槽位"的相对距离。
// <see cref="JsonDoc.KindAt"/> 把 6/7 归一化回 0..5 对外契约。
public class JsonDoc {
    // tape 槽位（外部走访问器）。
    public JsonSlot[] slots;
    public int slotCount;
    // 全部对象的键值对表（对象槽 a 高位记首对下标）。
    public JsonPair[] pairs;
    public int pairCount;
    // 含转义的字符串/键在此物化（无转义的走 src 零拷贝）。
    public List<string> escPool;
    // 源串。零拷贝 token 指向它，因此它随 doc 存活。
    public string src;
    // 源字节缓冲，下标 < len 与字符串下标一一对应；尾部多 32 字节
    // 零填充供 Load64 裸读兜越界。键比较走它——数组索引比 string
    // 索引快约 7 倍。
    public byte[] buf;
    // 根槽位。
    public int root;

    public JsonDoc() {
        this.slots = null;
        this.slotCount = 0;
        this.pairs = null;
        this.pairCount = 0;
        this.escPool = null;
        this.src = "";
        this.buf = null;
        this.root = 0;
    }

    private static ThreadLocal<JsonScratch> scratchPool = new ThreadLocal<JsonScratch>(() => new JsonScratch());

    public static JsonScratch GetScratch() {
        return JsonDoc.scratchPool.Value;
    }

    // 零分配瞬时解析：将 JSON 字符串解析进线程局部复用缓冲并执行回调，
    // 执行期间 0 堆内存分配；回调结束后工作区自动复位，适用于控制器只读提取字段。
    public static T ParseScoped<T>(string src, JsonDocScopeFunc<T> fn) {
        if (src == null) { throw new JsonException("JSON source cannot be null"); }
        if (fn == null) { throw new JsonException("Scoped function cannot be null"); }
        int len = src.Length;
        int slotCap = len / 4 + 32;
        int pairCap = len / 8 + 16;
        JsonScratch sc = JsonDoc.GetScratch();
        sc.EnsureCapacity(len, slotCap, pairCap);
        NativeMemory.PutString(sc.buf, 0, src, len);
        long ret = NativeMemory.JsonParseFast(sc.buf, (long)len, sc.slots, (long)sc.slots.Length, sc.pairs, (long)sc.pairs.Length, sc.counts);
        if (ret == 0) {
            int slotCount = (int)sc.counts[0];
            int pairCount = (int)sc.counts[1];
            int endPos = (int)sc.counts[2];
            endPos = (int)NativeMemory.JsonSkipWhitespace(sc.buf, (long)endPos, (long)len);
            if (endPos >= len && slotCount > 0) {
                JsonDoc d = new JsonDoc();
                d.src = src;
                d.buf = sc.buf;
                d.slots = sc.slots;
                d.slotCount = slotCount;
                d.pairs = sc.pairs;
                d.pairCount = pairCount;
                d.root = 0;
                T result = fn(d);
                d.slots = null;
                d.pairs = null;
                d.buf = null;
                return result;
            }
        } else if (ret < 0 && ret != -2L && ret != -3L) {
            int errPos = (int)(-1 - ret);
            throw new JsonException("Malformed JSON at position " + Convert.ToString(errPos));
        }
        JsonDoc full = JsonDoc.Parse(src);
        return fn(full);
    }

    // 零分配瞬时解析无返回值重载。
    public static void ParseScoped(string src, JsonDocScopeAction fn) {
        if (src == null) { throw new JsonException("JSON source cannot be null"); }
        if (fn == null) { throw new JsonException("Scoped action cannot be null"); }
        int len = src.Length;
        int slotCap = len / 4 + 32;
        int pairCap = len / 8 + 16;
        JsonScratch sc = JsonDoc.GetScratch();
        sc.EnsureCapacity(len, slotCap, pairCap);
        NativeMemory.PutString(sc.buf, 0, src, len);
        long ret = NativeMemory.JsonParseFast(sc.buf, (long)len, sc.slots, (long)sc.slots.Length, sc.pairs, (long)sc.pairs.Length, sc.counts);
        if (ret == 0) {
            int slotCount = (int)sc.counts[0];
            int pairCount = (int)sc.counts[1];
            int endPos = (int)sc.counts[2];
            endPos = (int)NativeMemory.JsonSkipWhitespace(sc.buf, (long)endPos, (long)len);
            if (endPos >= len && slotCount > 0) {
                JsonDoc d = new JsonDoc();
                d.src = src;
                d.buf = sc.buf;
                d.slots = sc.slots;
                d.slotCount = slotCount;
                d.pairs = sc.pairs;
                d.pairCount = pairCount;
                d.root = 0;
                fn(d);
                d.slots = null;
                d.pairs = null;
                d.buf = null;
                return;
            }
        } else if (ret < 0 && ret != -2L && ret != -3L) {
            int errPos = (int)(-1 - ret);
            throw new JsonException("Malformed JSON at position " + Convert.ToString(errPos));
        }
        JsonDoc full = JsonDoc.Parse(src);
        fn(full);
    }

    public static JsonDoc Parse(string src) {
        if (src == null) { throw new JsonException("JSON source cannot be null"); }
        int len = src.Length;
        // buf 必须是本 doc 独占的缓冲：slots 里的键偏移指向它，
        // doc 存活期间 Get() 都要在它上面比对。线程局部 scratch 池
        // 会被任何一次后续 Parse 覆写，绝不能交给长命 doc（否则同线程
        // 再解析一次就破坏老 doc 的键查找）。scratch 只复用 slots/pairs
        // 暂存（ParseInternal 会拷出）与 ParseScoped 瞬时场景。
        byte[] buf = new byte[len + 32];
        NativeMemory.PutString(buf, 0, src, len);
        return JsonDoc.ParseInternal(buf, 0, len, src);
    }

    // 原生字节零拷贝直通解析（适用于底层网络 Socket / 文件缓冲）
    public static JsonDoc ParseBytes(byte[] buf, int off, int len) {
        if (buf == null) { throw new JsonException("JSON buffer cannot be null"); }
        if (off < 0 || len < 0 || off + len > buf.Length) {
            throw new JsonException("JSON buffer range out of bounds");
        }
        byte[] pbuf = buf;
        int pstart = off;
        if (buf.Length < off + len + 32) {
            pbuf = new byte[len + 32];
            NativeMemory.Copy(pbuf, (nint)buf + (nint)off, len);
            pstart = 0;
        }
        string src = pbuf.ToStr(pstart, len);
        return JsonDoc.ParseInternal(pbuf, pstart, len, src);
    }

    private static JsonDoc ParseInternal(byte[] buf, int off, int len, string src) {
        JsonDoc d = new JsonDoc();
        d.src = src;
        d.buf = buf;
        d.escPool = new List<string>();

        int slotCap = len / 4 + 32;
        int pairCap = len / 8 + 16;
        JsonScratch sc = JsonDoc.GetScratch();
        sc.EnsureCapacity(len, slotCap, pairCap);

        long ret = NativeMemory.JsonParseFast(buf, (long)len, sc.slots, (long)sc.slots.Length, sc.pairs, (long)sc.pairs.Length, sc.counts);
        if (ret == 0) {
            int slotCount = (int)sc.counts[0];
            int pairCount = (int)sc.counts[1];
            int endPos = (int)sc.counts[2];
            endPos = (int)NativeMemory.JsonSkipWhitespace(buf, (long)endPos, (long)len);
            if (endPos >= len && slotCount > 0) {
                JsonSlot[] sl = new JsonSlot[slotCount];
                Array.Copy(sc.slots, sl, slotCount);
                JsonPair[] pr = new JsonPair[pairCount];
                Array.Copy(sc.pairs, pr, pairCount);
                d.slots = sl;
                d.slotCount = slotCount;
                d.pairs = pr;
                d.pairCount = pairCount;
                d.root = 0;
                return d;
            }
        } else if (ret < 0 && ret != -2L && ret != -3L) {
            // 语法格式错误 -(位置+1)
            int errPos = (int)(-1 - ret);
            throw new JsonException("Malformed JSON at position " + Convert.ToString(errPos));
        }

        // 回退至托管 ParseCore（支持带复杂反斜杠转义池物化、超深嵌套或超限扩容）
        List<JsonSlot> coreSlots = new List<JsonSlot>();
        List<JsonPair> corePairs = new List<JsonPair>();
        coreSlots.Reserve(slotCap);
        corePairs.Reserve(pairCap);
        int pos = JsonDoc.ParseCore(coreSlots, corePairs, d.escPool, src, buf, len);
        if (pos < 0) {
            throw new JsonException("Malformed JSON at position "
                + Convert.ToString(-1 - pos));
        }
        pos = (int)NativeMemory.JsonSkipWhitespace(buf, (long)pos, (long)len);
        if (pos < len) {
            throw new JsonException("Malformed JSON at position "
                + Convert.ToString(pos));
        }
        if (coreSlots.Count == 0) {
            throw new JsonException("Empty JSON document");
        }
        JsonSlot[] slArr = new JsonSlot[coreSlots.Count];
        for (int i = 0; i < coreSlots.Count; i = i + 1) { slArr[i] = coreSlots[i]; }
        d.slots = slArr;
        d.slotCount = coreSlots.Count;
        JsonPair[] prArr = new JsonPair[corePairs.Count];
        for (int i = 0; i < corePairs.Count; i = i + 1) { prArr[i] = corePairs[i]; }
        d.pairs = prArr;
        d.pairCount = corePairs.Count;
        d.root = 0;
        return d;
    }

    // 纯 Zan 实现的 GB/s 级极速 Tape 状态机（单函数展开、零中间集合调用、直写扁平数组）
    public static long ParsePureFast(byte[] buf, int len, JsonSlot[] sl, int slotCap, JsonPair[] pr, int pairCap, int[] fr, long[] counts) {
        int slotCount = 0;
        int pairCount = 0;
        int maxd = JsonDoc.MaxDepth;
        int depth = 0;
        int pbase = -4;
        bool wantKey = false;
        int pos = 0;

        while (true) {
            if (pos < len && (buf[pos] & 255) <= 32) {
                pos = (int)NativeMemory.JsonSkipWhitespace(buf, (long)pos, (long)len);
            }
            if (pos >= len) { break; }
            long x = NativeMemory.Load64(buf, pos);
            int c = (int)(x & 255);

            if (wantKey) {
                if (c != 34) { return (long)(-1 - pos); }
                int p2 = pos + 1;
                int start = p2;
                long res = NativeMemory.JsonScanString(buf, (long)p2, (long)len);
                if (res < 0) { return -2L; } // 遇到转义字符，回退至物化池
                if (res >= len) { return (long)(-1 - len); }
                int q = (int)res;

                if (pairCount >= pairCap) { return -3L; }
                int pi = pairCount;
                pairCount = pairCount + 1;
                pr[pi].keyStart = start;
                pr[pi].keyLen = q - start;
                pr[pi].nextPair = -1;

                if (fr[pbase + 3] >= 0) {
                    pr[fr[pbase + 3]].nextPair = pi;
                }
                fr[pbase + 3] = pi;
                fr[pbase + 2] = fr[pbase + 2] + 1;
                pos = q + 1;

                if (pos < len && (buf[pos] & 255) <= 32) {
                    pos = (int)NativeMemory.JsonSkipWhitespace(buf, (long)pos, (long)len);
                }
                if (pos >= len || (buf[pos] & 255) != 58) { return (long)(-1 - pos); }
                pos = pos + 1;
                if (pos < len && (buf[pos] & 255) == 32) { pos = pos + 1; }
                wantKey = false;
                continue;
            }

            if (depth > maxd && fr[pbase] == 4) { return (long)(-1 - pos); }

            int vslot = -1;
            if (c == 34) {
                int p2 = pos + 1;
                int start = p2;
                long res = NativeMemory.JsonScanString(buf, (long)p2, (long)len);
                if (res < 0) { return -2L; }
                if (res >= len) { return (long)(-1 - len); }
                int q = (int)res;

                if (slotCount >= slotCap) { return -3L; }
                vslot = slotCount;
                slotCount = slotCount + 1;
                sl[vslot].a = 3L | ((long)start << 8);
                sl[vslot].b = (long)(q - start);
                pos = q + 1;
            } else if (c == 123) {
                int pk = pos + 1;
                if (pk < len && (buf[pk] & 255) <= 32) {
                    pk = (int)NativeMemory.JsonSkipWhitespace(buf, (long)pk, (long)len);
                }
                if (pk < len && (buf[pk] & 255) == 125) {
                    if (slotCount >= slotCap) { return -3L; }
                    vslot = slotCount;
                    slotCount = slotCount + 1;
                    sl[vslot].a = -251L;
                    sl[vslot].b = 1L << 31;
                    pos = pk + 1;
                } else {
                    if (depth > maxd) { return (long)(-1 - pos); }
                    if (slotCount >= slotCap) { return -3L; }
                    vslot = slotCount;
                    slotCount = slotCount + 1;
                    sl[vslot].a = 5L | ((long)pairCount << 8);

                    int fo = depth * 4;
                    fr[fo] = 5;
                    fr[fo + 1] = vslot;
                    fr[fo + 2] = 0;
                    fr[fo + 3] = -1;
                    depth = depth + 1;
                    pbase = fo;
                    pos = pos + 1;
                    wantKey = true;
                    continue;
                }
            } else if (c == 91) {
                int pk = pos + 1;
                if (pk < len && (buf[pk] & 255) <= 32) {
                    pk = (int)NativeMemory.JsonSkipWhitespace(buf, (long)pk, (long)len);
                }
                if (pk < len && (buf[pk] & 255) == 93) {
                    if (slotCount >= slotCap) { return -3L; }
                    vslot = slotCount;
                    slotCount = slotCount + 1;
                    sl[vslot].a = 4L;
                    sl[vslot].b = 1L << 31;
                    pos = pk + 1;
                } else {
                    if (depth > maxd) { return (long)(-1 - pos); }
                    if (slotCount >= slotCap) { return -3L; }
                    vslot = slotCount;
                    slotCount = slotCount + 1;
                    sl[vslot].a = 4L;

                    int fa = depth * 4;
                    fr[fa] = 4;
                    fr[fa + 1] = vslot;
                    fr[fa + 2] = 0;
                    fr[fa + 3] = -1;
                    depth = depth + 1;
                    pbase = fa;
                    pos = pos + 1;
                    wantKey = false;
                    continue;
                }
            } else if (c == 116) {
                if ((int)x != 0x65757274) { return (long)(-1 - pos); }
                if (slotCount >= slotCap) { return -3L; }
                vslot = slotCount;
                slotCount = slotCount + 1;
                sl[vslot].a = 1L;
                sl[vslot].b = 0L;
                pos = pos + 4;
            } else if (c == 102) {
                if ((x & 0xFFFFFFFFFFL) != 0x65736C6166L) { return (long)(-1 - pos); }
                if (slotCount >= slotCap) { return -3L; }
                vslot = slotCount;
                slotCount = slotCount + 1;
                sl[vslot].a = 6L;
                sl[vslot].b = 0L;
                pos = pos + 5;
            } else if (c == 110) {
                if ((int)x != 0x6C6C756E) { return (long)(-1 - pos); }
                if (slotCount >= slotCap) { return -3L; }
                vslot = slotCount;
                slotCount = slotCount + 1;
                sl[vslot].a = 0L;
                sl[vslot].b = 0L;
                pos = pos + 4;
            } else {
                int ns = pos;
                int ni = pos;
                if (c == 45) { ni = ni + 1; }
                long nacc = 0;
                int ndig = 0;
                while (ni < len) {
                    int d = (buf[ni] & 255) - 48;
                    if (d < 0 || d > 9) { break; }
                    nacc = nacc * 10 + d;
                    ndig = ndig + 1;
                    ni = ni + 1;
                }
                bool nok = ndig >= 1;
                bool isInt = nok;
                if (nok && ni < len && (buf[ni] & 255) == 46) {
                    isInt = false;
                    ni = ni + 1;
                    int nfd = 0;
                    while (ni < len) {
                        int d = (buf[ni] & 255) - 48;
                        if (d < 0 || d > 9) { break; }
                        nfd = nfd + 1;
                        ni = ni + 1;
                    }
                    if (nfd == 0) { nok = false; }
                }
                if (nok && ni < len && ((buf[ni] & 255) == 101 || (buf[ni] & 255) == 69)) {
                    isInt = false;
                    ni = ni + 1;
                    if (ni < len && ((buf[ni] & 255) == 43 || (buf[ni] & 255) == 45)) { ni = ni + 1; }
                    int ned = 0;
                    while (ni < len) {
                        int d = (buf[ni] & 255) - 48;
                        if (d < 0 || d > 9) { break; }
                        ned = ned + 1;
                        ni = ni + 1;
                    }
                    if (ned == 0) { nok = false; }
                }
                if (!nok) { return (long)(-1 - ni); }
                if (slotCount >= slotCap) { return -3L; }
                vslot = slotCount;
                slotCount = slotCount + 1;
                if (isInt && ndig <= 18) {
                    if (c == 45) { nacc = 0 - nacc; }
                    sl[vslot].a = 2L;
                    sl[vslot].b = nacc;
                } else {
                    sl[vslot].a = 7L | ((long)ns << 8);
                    sl[vslot].b = (long)(ni - ns);
                }
                pos = ni;
            }

            if (depth == 0) {
                counts[0] = (long)slotCount;
                counts[1] = (long)pairCount;
                counts[2] = (long)pos;
                return 0L;
            }

            if (fr[pbase] == 4) {
                fr[pbase + 2] = fr[pbase + 2] + 1;
            } else {
                pr[fr[pbase + 3]].valueSlot = vslot;
            }

            while (true) {
                if (pos < len && (buf[pos] & 255) <= 32) {
                    pos = (int)NativeMemory.JsonSkipWhitespace(buf, (long)pos, (long)len);
                }
                if (pos >= len) { return (long)(-1 - pos); }
                c = buf[pos] & 255;
                if (c == 44) {
                    pos = pos + 1;
                    if (pos < len && (buf[pos] & 255) == 32) { pos = pos + 1; }
                    wantKey = fr[pbase] == 5;
                    break;
                }
                int close = fr[pbase] == 4 ? 93 : 125;
                if (c != close) { return (long)(-1 - pos); }
                pos = pos + 1;
                int ms2 = fr[pbase + 1];
                sl[ms2].b = (long)fr[pbase + 2] | ((long)(slotCount - ms2) << 31);
                depth = depth - 1;
                pbase = pbase - 4;
                if (depth == 0) {
                    counts[0] = (long)slotCount;
                    counts[1] = (long)pairCount;
                    counts[2] = (long)pos;
                    return 0L;
                }
                if (fr[pbase] == 4) {
                    fr[pbase + 2] = fr[pbase + 2] + 1;
                } else {
                    pr[fr[pbase + 3]].valueSlot = ms2;
                }
            }
        }
        return (long)(-1 - pos);
    }

    // 熔合解析核心：单函数显式状态机。
    // 深度语义：容器嵌套以 MaxDepth 封顶（推栈时检查）。
    // 值完成后就地记账并级联处理分隔符与逐层收口，仅对象"要键"时
    // 切 wantKey 布尔，空容器走免推栈快路径。
    // 错误 -(位置+1) 为首错位置。
    public static int ParseCore(List<JsonSlot> sl, List<JsonPair> pr,
        List<string> pool, string src, byte[] buf, int len) {
        // 容器栈：每层 4 个 int——kind(4/5)、容器槽下标、已收子元素
        // 数、最后一个键值对下标（对象用，数组恒 -1）。深度可瞬时
        // 到 MaxDepth+1（第 513 层容器可进、其内容必错，与旧递归
        // 实现的边界语义一致），栈容量多留一层。
        int[] fr = new int[(JsonDoc.MaxDepth + 2) * 4];
        int maxd = JsonDoc.MaxDepth;
        int depth = 0;
        int pbase = -4;  // 栈顶帧基下标 = (depth-1)*4
        bool wantKey = false;  // 对象帧期待键（其余情况恒 false）
        int pos = 0;
        while (true) {
            // 跳过空白：SIMD 向量化跳过，pad 保证 Load64 恒安全，EOF 时 c=0。
            pos = (int)NativeMemory.JsonSkipWhitespace(buf, (long)pos, (long)len);
            long x = NativeMemory.Load64(buf, pos);
            int c = (int)(x & 255);
            if (wantKey) {
                // ---- 对象键：'"' + SIMD 扫描 + ':' ----
                if (c != 34) { return -1 - pos; }
                pos = JsonDoc.ScanKey(sl, pr, pool, src, buf, len, pos,
                    pbase, fr);
                if (pos < 0) { return pos; }
                pos = (int)NativeMemory.JsonSkipWhitespace(buf, (long)pos, (long)len);
                x = NativeMemory.Load64(buf, pos);
                c = (int)(x & 255);
                if (c != 58) { return -1 - pos; }
                pos = pos + 1;
                wantKey = false;
                continue;
            }
            // ---- 值分派 ----
            // 标量深度对齐：数组元素在 depth > MaxDepth 时报错，对象成员走内联分派
            // （depth==0 短路不读）。
            if (depth > maxd && fr[pbase] == 4) { return -1 - pos; }
            int vslot;
            if (c == 34) {
                // ---- 字符串值：SIMD 向量查找闭引号与转义符 ----
                int p2 = pos + 1;
                int start = p2;
                long res = NativeMemory.JsonScanString(buf, (long)p2, (long)len);
                if (res >= 0 && res < len) {
                    int q = (int)res;
                    JsonSlot ts = new JsonSlot();
                    ts.a = (long)3 | ((long)start << 8);
                    ts.b = (long)(q - start);
                    sl.Add(ts);
                    pos = q + 1;
                    vslot = sl.Count - 1;
                } else if (res < 0) {
                    int esc = (int)(-1 - res);
                    int pe = JsonDoc.EscStringInto(pool, src, buf, len,
                        start, esc);
                    if (pe < 0) { return pe; }
                    JsonSlot ts2 = new JsonSlot();
                    ts2.a = (long)3 | (-256L);
                    ts2.b = (long)(pool.Count - 1);
                    sl.Add(ts2);
                    pos = pe;
                    vslot = sl.Count - 1;
                } else {
                    return -1 - len;
                }
            } else if (c == 123) {
                // ---- '{'：先窥探空对象（免推栈快路径）----
                int pk = (int)NativeMemory.JsonSkipWhitespace(buf, (long)(pos + 1), (long)len);
                long px = NativeMemory.Load64(buf, pk);
                int pc = (int)(px & 255);
                if (pc == 125) {
                    // 空对象：首对下标 -1（链立即终止，避免串进之后
                    // 别的对象的键），b = 1<<31。
                    JsonSlot te = new JsonSlot();
                    te.a = (long)5 | ((long)-1 << 8);
                    te.b = (long)1 << 31;
                    sl.Add(te);
                    pos = pk + 1;
                    vslot = sl.Count - 1;
                } else {
                    // 非空对象：推帧。深度语义：进入时 depth 可到
                    // maxd（第 513 层容器可进、其内容必错）。
                    if (depth > maxd) { return -1 - pos; }
                    JsonSlot to = new JsonSlot();
                    to.a = (long)5 | ((long)pr.Count << 8);
                    sl.Add(to);
                    int fo = depth * 4;
                    fr[fo] = 5;
                    fr[fo + 1] = sl.Count - 1;
                    fr[fo + 2] = 0;
                    fr[fo + 3] = -1;
                    depth = depth + 1;
                    pbase = fo;
                    pos = pos + 1;
                    wantKey = true;
                    continue;
                }
            } else if (c == 91) {
                // ---- '['：先窥探空数组（免推栈快路径）----
                int pk = (int)NativeMemory.JsonSkipWhitespace(buf, (long)(pos + 1), (long)len);
                long px = NativeMemory.Load64(buf, pk);
                int pc = (int)(px & 255);
                if (pc == 93) {
                    JsonSlot te2 = new JsonSlot();
                    te2.a = 4;
                    te2.b = (long)1 << 31;
                    sl.Add(te2);
                    pos = pk + 1;
                    vslot = sl.Count - 1;
                } else {
                    if (depth > maxd) { return -1 - pos; }
                    JsonSlot ta = new JsonSlot();
                    ta.a = 4;
                    sl.Add(ta);
                    int fa = depth * 4;
                    fr[fa] = 4;
                    fr[fa + 1] = sl.Count - 1;
                    fr[fa + 2] = 0;
                    fr[fa + 3] = -1;
                    depth = depth + 1;
                    pbase = fa;
                    pos = pos + 1;
                    wantKey = false;
                    continue;
                }
            } else if (c == 116) {
                // "true"：低 4 字节整字比较（pad 零保证 EOF 时不误配
                // ——不足 4 字节的 token 高位是 0）。
                if ((int)x != 0x65757274) { return -1 - pos; }
                JsonSlot tt = new JsonSlot();
                tt.a = 1;
                sl.Add(tt);
                pos = pos + 4;
                vslot = sl.Count - 1;
            } else if (c == 102) {
                // "false"：低 5 字节。
                if ((x & 0xFFFFFFFFFFL) != 0x65736C6166L) {
                    return -1 - pos;
                }
                JsonSlot tf = new JsonSlot();
                tf.a = 6;
                sl.Add(tf);
                pos = pos + 5;
                vslot = sl.Count - 1;
            } else if (c == 110) {
                // "null"：低 4 字节。
                if ((int)x != 0x6C6C756E) { return -1 - pos; }
                JsonSlot tn = new JsonSlot();
                tn.a = 0;
                sl.Add(tn);
                pos = pos + 4;
                vslot = sl.Count - 1;
            } else {
                // ---- 数字：内联裸读扫描（pad 兜越界，无逐字节检查
                // 无调用）。语义与 ReadNumber 逐点一致：整数 ≤18 位
                // 走 numI，其余 DoubleInRange。
                int ns = pos;
                int ni = pos;
                if (c == 45) { ni = ni + 1; }
                long nacc = 0;
                int ndig = 0;
                long x2 = NativeMemory.Load64(buf, ni);
                int k2 = 0;
                while (true) {
                    int d = (int)((x2 >> (8 * k2)) & 255) - 48;
                    if (d < 0 || d > 9) { break; }
                    nacc = nacc * 10 + d;
                    ndig = ndig + 1;
                    ni = ni + 1;
                    k2 = k2 + 1;
                    if (k2 == 8) { x2 = NativeMemory.Load64(buf, ni); k2 = 0; }
                }
                int nc = (int)((x2 >> (8 * k2)) & 255);
                bool nok = ndig >= 1;
                bool nisInt = nok;
                if (nok && nc == 46) {
                    nisInt = false;
                    ni = ni + 1;
                    k2 = k2 + 1;
                    if (k2 == 8) { x2 = NativeMemory.Load64(buf, ni); k2 = 0; }
                    int nfd = 0;
                    while (true) {
                        int d = (int)((x2 >> (8 * k2)) & 255) - 48;
                        if (d < 0 || d > 9) { break; }
                        nfd = nfd + 1;
                        ni = ni + 1;
                        k2 = k2 + 1;
                        if (k2 == 8) { x2 = NativeMemory.Load64(buf, ni); k2 = 0; }
                    }
                    nc = (int)((x2 >> (8 * k2)) & 255);
                    if (nfd == 0) { nok = false; }
                }
                if (nok && (nc == 101 || nc == 69)) {
                    nisInt = false;
                    ni = ni + 1;
                    k2 = k2 + 1;
                    if (k2 == 8) { x2 = NativeMemory.Load64(buf, ni); k2 = 0; }
                    nc = (int)((x2 >> (8 * k2)) & 255);
                    if (nc == 43 || nc == 45) {
                        ni = ni + 1;
                        k2 = k2 + 1;
                        if (k2 == 8) { x2 = NativeMemory.Load64(buf, ni); k2 = 0; }
                    }
                    int ned = 0;
                    while (true) {
                        int d = (int)((x2 >> (8 * k2)) & 255) - 48;
                        if (d < 0 || d > 9) { break; }
                        ned = ned + 1;
                        ni = ni + 1;
                        k2 = k2 + 1;
                        if (k2 == 8) { x2 = NativeMemory.Load64(buf, ni); k2 = 0; }
                    }
                    if (ned == 0) { nok = false; }
                }
                if (!nok) { return -1 - ni; }
                JsonSlot tn2 = new JsonSlot();
                if (nisInt && ndig <= 18) {
                    if (c == 45) { nacc = 0 - nacc; }
                    tn2.a = 2;
                    tn2.b = nacc;
                } else {
                    tn2.a = 7L | ((long)ns << 8);
                    tn2.b = (long)(ni - ns);
                }
                sl.Add(tn2);
                pos = ni;
                vslot = sl.Count - 1;
            }
            // ---- 值完成：父帧记账（顶层值即文档完）----
            if (depth == 0) { return pos; }
            if (fr[pbase] == 4) {
                fr[pbase + 2] = fr[pbase + 2] + 1;
            } else {
                pr[fr[pbase + 3]].valueSlot = vslot;
            }
            // ---- 分隔级联：逗号继续取值/键，收口逐层向上 ----
            while (true) {
                pos = (int)NativeMemory.JsonSkipWhitespace(buf, (long)pos, (long)len);
                x = NativeMemory.Load64(buf, pos);
                c = (int)(x & 255);
                if (c == 44) {
                    pos = pos + 1;
                    if (pos < len && (buf[pos] & 255) == 32) { pos = pos + 1; }
                    wantKey = fr[pbase] == 5;
                    break;
                }
                int close = fr[pbase] == 4 ? 93 : 125;
                if (c != close) { return -1 - pos; }
                pos = pos + 1;
                int ms2 = fr[pbase + 1];
                sl[ms2].b = (long)fr[pbase + 2]
                    | ((long)(sl.Count - ms2) << 31);
                depth = depth - 1;
                pbase = pbase - 4;
                if (depth == 0) { return pos; }
                // 收口的容器是父帧的值：
                if (fr[pbase] == 4) {
                    fr[pbase + 2] = fr[pbase + 2] + 1;
                } else {
                    pr[fr[pbase + 3]].valueSlot = ms2;
                }
            }
            continue;
        }
    }

    // 对象键 token 扫描（起始引号在 pos）：SIMD 向量查找闭引号与转义符。
    public static int ScanKey(List<JsonSlot> sl, List<JsonPair> pr,
        List<string> pool, string src, byte[] buf, int len, int pos,
        int pbase, int[] fr) {
        int p2 = pos + 1;
        int start = p2;
        long res = NativeMemory.JsonScanString(buf, (long)p2, (long)len);
        int q = -1;
        int esc = -1;
        if (res >= 0 && res < len) {
            q = (int)res;
        } else if (res < 0) {
            esc = (int)(-1 - res);
        } else {
            return -1 - len;
        }
        JsonPair pair = new JsonPair();
        pair.nextPair = -1;
        pair.valueSlot = -1;
        if (q >= 0) {
            pair.keyStart = start;
            pair.keyLen = q - start;
            pos = q + 1;
        } else {
            int pe = JsonDoc.EscStringInto(pool, src, buf, len, start, esc);
            if (pe < 0) { return pe; }
            pair.keyStart = -1;
            pair.keyLen = pool.Count - 1;
            pos = pe;
        }
        pr.Add(pair);
        int pi = pr.Count - 1;
        if (fr[pbase + 3] >= 0) { pr[fr[pbase + 3]].nextPair = pi; }
        fr[pbase + 3] = pi;
        fr[pbase + 2] = fr[pbase + 2] + 1;
        return pos;
    }

    // 转义 token 物化：前缀 (start..esc) 原文进池，再从 esc（首个
    // 反斜杠位置）扫到闭引号，解码全部转义（含 \uXXXX 与代理对）。
    // 返回闭引号后位置或 -(错误位置+1)；调用方以 pool.Count-1 取本
    // 串下标。值与键共用，冷路径。
    public static int EscStringInto(List<string> pool, string src, byte[] buf,
        int len, int start, int esc) {
        StringBuilder sb = new StringBuilder();
        if (esc > start) { sb.Append(src.Substring(start, esc - start)); }
        int pos = esc;
        while (pos < len) {
            int c = buf[pos] & 255;
            if (c == 34) {
                pos = pos + 1;
                pool.Add(sb.ToString());
                return pos;
            }
            if (c == 92 && pos + 1 < len) {
                int n2 = buf[pos + 1] & 255;
                if (n2 == 110) { sb.Append("\n"); }
                else if (n2 == 116) { sb.Append("\t"); }
                else if (n2 == 114) { sb.Append("\r"); }
                else if (n2 == 34) { sb.Append("\""); }
                else if (n2 == 92) { sb.Append("\\"); }
                else if (n2 == 47) { sb.Append("/"); }
                else if (n2 == 98) { sb.Append(Encoding.CharFromCode(8)); }
                else if (n2 == 102) { sb.Append(Encoding.CharFromCode(12)); }
                else if (n2 == 117) {
                    int escStart = pos;
                    pos = pos + 2;
                    int cp = JsonDoc.Hex4(src, pos, len);
                    if (cp < 0) { return -1 - escStart; }
                    pos = pos + 4;
                    if (cp >= 55296 && cp <= 56319 && pos + 5 < len
                        && (buf[pos] & 255) == 92 && (buf[pos + 1] & 255) == 117) {
                        int lo = JsonDoc.Hex4(src, pos + 2, len);
                        if (lo >= 56320 && lo <= 57343) {
                            cp = 65536 + ((cp - 55296) << 10) + (lo - 56320);
                            pos = pos + 6;
                        }
                    }
                    sb.Append(Encoding.Utf8FromCodePoint(cp));
                    continue;
                }
                else {
                    return -1 - pos;
                }
                pos = pos + 2;
            } else {
                int run2 = (int)NativeMemory.FindNotAnyOf(buf, pos, "\"\\",
                    len - pos);
                int stop2 = run2 < 0 ? len : pos + run2;
                // stop2==pos 说明当前字节是 '\' 但已到末尾（pos+1==len），直接报错收口。
                if (stop2 == pos) { return -1 - pos; }
                sb.Append(src.Substring(pos, stop2 - pos));
                pos = stop2;
            }
        }
        return -1 - pos;
    }

    // 就地解析 [from, to) 的浮点 token。运算顺序与
    // JsonValue.DoubleOf 完全一致（long 尾数 + 精确 10 的幂表一次
    // 缩放），结果位级相同。
    public static double DoubleInRange(byte[] buf, int from, int to) {
        int i = from;
        bool neg = false;
        if (i < to && (buf[i] & 255) == 45) { neg = true; i = i + 1; }
        else if (i < to && (buf[i] & 255) == 43) { i = i + 1; }
        long mant = 0;
        int exp10 = 0;
        bool roundUp = false;
        bool seenDigit = false;
        while (i < to) {
            int d = (buf[i] & 255) - 48;
            if (d < 0 || d > 9) { break; }
            seenDigit = true;
            if (mant < 100000000000000000) {
                mant = mant * 10 + d;
            } else {
                if (!roundUp && d >= 5) { roundUp = true; }
                exp10 = exp10 + 1;
            }
            i = i + 1;
        }
        if (i < to && (buf[i] & 255) == 46) {
            i = i + 1;
            while (i < to) {
                int d = (buf[i] & 255) - 48;
                if (d < 0 || d > 9) { break; }
                seenDigit = true;
                if (mant < 100000000000000000) {
                    mant = mant * 10 + d;
                    exp10 = exp10 - 1;
                } else {
                    if (!roundUp && d >= 5) { roundUp = true; }
                }
                i = i + 1;
            }
        }
        if (!seenDigit) { return 0.0; }
        if (i < to && ((buf[i] & 255) == 101 || (buf[i] & 255) == 69)) {
            i = i + 1;
            bool eneg = false;
            if (i < to && (buf[i] & 255) == 45) { eneg = true; i = i + 1; }
            else if (i < to && (buf[i] & 255) == 43) { i = i + 1; }
            int ex = 0;
            while (i < to) {
                int d = (buf[i] & 255) - 48;
                if (d < 0 || d > 9) { break; }
                if (ex < 100000000) { ex = ex * 10 + d; }
                i = i + 1;
            }
            if (eneg) { exp10 = exp10 - ex; } else { exp10 = exp10 + ex; }
        }
        if (roundUp) { mant = mant + 1; }
        double v = mant;
        int e = exp10;
        if (e > 350) { e = 350; }
        else if (e < -350) { e = -350; }
        while (e > 22) { v = v * 1e22; e = e - 22; }
        while (e < -22) { v = v / 1e22; e = e + 22; }
        if (e >= 0) {
            v = v * JsonValue.Pow10Tab[e];
        } else {
            v = v / JsonValue.Pow10Tab[0 - e];
        }
        if (neg) {
            if (v == 0.0) { return -0.0; }
            return 0.0 - v;
        }
        return v;
    }

    // 从 `at` 开始的 4 位十六进制值；不足 4 位或含非十六进制
    // 字符时返回 -1。
    public static int Hex4(string src, int at, int limit) {
        if (at + 4 > limit) { return -1; }
        int acc = 0;
        for (int i = 0; i < 4; i = i + 1) {
            int d = Encoding.HexDigit(src[at + i] & 255);
            if (d < 0) { return -1; }
            acc = acc * 16 + d;
        }
        return acc;
    }

    // 递归深度上限（与 JsonValue 一致）。
    public static int MaxDepth = 512;

    // ---------- 访问器 ----------

    public int SlotCount() { return this.slotCount; }

    public int NextSibling(int at) {
        if (at < 0 || at >= this.slotCount) { return -1; }
        long a = slots[at].a;
        int k = (int)(a & 255);
        if (k == 4 || k == 5) { return at + (int)(slots[at].b >> 31); }
        return at + 1;
    }

    public int FirstChild(int at) {
        if (at < 0 || at >= this.slotCount) { return -1; }
        int k = (int)(slots[at].a & 255);
        if (k == 4 || k == 5) { return at + 1; }
        return -1;
    }

    public int KindAt(int at) {
        if (at < 0 || at >= this.slotCount) { return 0; }
        int k = (int)(slots[at].a & 255);
        if (k == 6) { return 1; }
        if (k == 7) { return 2; }
        return k;
    }

    // 注意：At 是从首个孩子跳 i 次 NextSibling 的链式访问，取第 i 个
    // 孩子要 O(i) 次；把它当随机索引用在顺序循环里整体退化为 O(n²)
    // （215 倍实测差距）。顺序遍历请走 FirstChild/NextSibling 链或
    // <see cref="ForEachChild"/>，只有真正的随机访问才用 At。
    public int At(int at, int i) {
        if (at < 0 || at >= this.slotCount || i < 0) { return -1; }
        int count = this.Count(at);
        if (i >= count) { return -1; }
        int c = at + 1;
        for (int j = 0; j < i; j = j + 1) {
            c = this.NextSibling(c);
            if (c < 0 || c >= this.slotCount) { return -1; }
        }
        return c;
    }

    // 按 tape 链遍历 <paramref name="at"/> 的全部孩子，逐个
    // 调用 <paramref name="fn"/>（at 是孩子槽位；对象成员是值槽位，
    // 键用 <see cref="KeyAt"/> 取）。顺序与源文档一致。这是 O(孩子数)
    // 的正确遍历姿势：FirstChild/NextSibling 各走一步，不像
    // <see cref="At"/> 顺序循环那样累计 O(n²)。非容器（标量）与
    // 负槽位没有孩子，回调一次都不触发；fn 为 null 时静默返回。
    public void ForEachChild(int at, JsonChildVisitor fn) {
        if (fn == null) { return; }
        int c = this.FirstChild(at);
        if (c < 0) { return; }
        int count = this.Count(at);
        for (int j = 0; j < count; j = j + 1) {
            fn(c);
            c = this.NextSibling(c);
        }
    }

    public int Count(int at) {
        if (at < 0 || at >= this.slotCount) { return 0; }
        return (int)(slots[at].b & 2147483647L);
    }

    public int Get(int at, string key) {
        if (at < 0 || at >= this.slotCount) { return -1; }
        long oa = slots[at].a;
        if ((int)(oa & 255) != 5) { return -1; }
        int p = (int)(oa >> 8);
        byte[] buf = this.buf;
        int kl = key.Length;
        while (p >= 0) {
            JsonPair pair = pairs[p];
            if (pair.keyLen == kl) {
                int ks = pair.keyStart;
                if (ks >= 0) {
                    int m = 0;
                    int ok = 1;
                    while (m < kl) {
                        if ((buf[ks + m] & 255) != (key[m] & 255)) { ok = 0; break; }
                        m = m + 1;
                    }
                    if (ok != 0) { return pair.valueSlot; }
                } else if (escPool[pair.keyLen] == key) {
                    return pair.valueSlot;
                }
            }
            p = pair.nextPair;
        }
        return -1;
    }

    // 零分配子串键寻址：直接在外部路径字符串的 [keyOff, keyOff + keyLen) 范围内进行比对，
    // 完全免除 Substring 堆内存分配与垃圾回收开销。
    public int GetDirect(int at, string path, int keyOff, int keyLen) {
        if (at < 0 || at >= this.slotCount || path == null || keyLen <= 0 || keyOff < 0 || keyOff + keyLen > path.Length) {
            return -1;
        }
        long oa = slots[at].a;
        if ((int)(oa & 255) != 5) { return -1; }
        int p = (int)(oa >> 8);
        byte[] buf = this.buf;
        while (p >= 0) {
            JsonPair pair = pairs[p];
            if (pair.keyLen == keyLen) {
                int ks = pair.keyStart;
                if (ks >= 0) {
                    if (keyLen == 2) {
                        if ((buf[ks] & 255) == (path[keyOff] & 255) &&
                            (buf[ks + 1] & 255) == (path[keyOff + 1] & 255)) {
                            return pair.valueSlot;
                        }
                    } else if (keyLen == 4) {
                        if ((buf[ks] & 255) == (path[keyOff] & 255) &&
                            (buf[ks + 1] & 255) == (path[keyOff + 1] & 255) &&
                            (buf[ks + 2] & 255) == (path[keyOff + 2] & 255) &&
                            (buf[ks + 3] & 255) == (path[keyOff + 3] & 255)) {
                            return pair.valueSlot;
                        }
                    } else if (keyLen == 5) {
                        if ((buf[ks] & 255) == (path[keyOff] & 255) &&
                            (buf[ks + 1] & 255) == (path[keyOff + 1] & 255) &&
                            (buf[ks + 2] & 255) == (path[keyOff + 2] & 255) &&
                            (buf[ks + 3] & 255) == (path[keyOff + 3] & 255) &&
                            (buf[ks + 4] & 255) == (path[keyOff + 4] & 255)) {
                            return pair.valueSlot;
                        }
                    } else {
                        int m = 0;
                        int ok = 1;
                        while (m < keyLen) {
                            if ((buf[ks + m] & 255) != (path[keyOff + m] & 255)) { ok = 0; break; }
                            m = m + 1;
                        }
                        if (ok != 0) { return pair.valueSlot; }
                    }
                } else if (escPool[pair.keyLen] == path.Substring(keyOff, keyLen)) {
                    return pair.valueSlot;
                }
            }
            p = pair.nextPair;
        }
        return -1;
    }

    public int Get(string key) { return this.Get(this.root, key); }
    public bool Has(string key) { return this.Has(this.root, key); }
    public bool Has(int at, string key) { return this.Get(at, key) >= 0; }

    public string StrOfSlot(int at) {
        if (at < 0 || at >= this.slotCount) { return ""; }
        long a = slots[at].a;
        int start = (int)(a >> 8);
        if (start >= 0) { return src.Substring(start, (int)slots[at].b); }
        return escPool[(int)slots[at].b];
    }

    public int IntAt(int at, int dflt) {
        if (at < 0 || at >= this.slotCount) { return dflt; }
        int k = (int)(slots[at].a & 255);
        if (k == 2) { return (int)slots[at].b; }
        if (k == 7) {
            int ns = (int)(slots[at].a >> 8);
            int len = (int)slots[at].b;
            return (int)JsonDoc.DoubleInRange(this.buf, ns, ns + len);
        }
        if (k == 1) { return 1; }
        if (k == 6) { return 0; }
        if (k == 3) {
            string s = this.StrOfSlot(at);
            if (s != null && s.Length > 0) { return JsonValue.IntOf(s); }
        }
        return dflt;
    }

    public long LongAt(int at, long dflt) {
        if (at < 0 || at >= this.slotCount) { return dflt; }
        int k = (int)(slots[at].a & 255);
        if (k == 2) { return slots[at].b; }
        if (k == 7) {
            int ns = (int)(slots[at].a >> 8);
            int len = (int)slots[at].b;
            return (long)JsonDoc.DoubleInRange(this.buf, ns, ns + len);
        }
        if (k == 1) { return 1L; }
        if (k == 6) { return 0L; }
        if (k == 3) {
            string s = this.StrOfSlot(at);
            if (s != null && s.Length > 0) { return JsonValue.LongOf(s); }
        }
        return dflt;
    }

    public double DoubleAt(int at, double dflt) {
        if (at < 0 || at >= this.slotCount) { return dflt; }
        int k = (int)(slots[at].a & 255);
        if (k == 2) { return (double)slots[at].b; }
        if (k == 7) {
            int ns = (int)(slots[at].a >> 8);
            int len = (int)slots[at].b;
            return JsonDoc.DoubleInRange(this.buf, ns, ns + len);
        }
        if (k == 1) { return 1.0; }
        if (k == 6) { return 0.0; }
        if (k == 3) {
            string s = this.StrOfSlot(at);
            if (s != null && s.Length > 0) { return JsonValue.DoubleOf(s); }
        }
        return dflt;
    }

    public string StrAt(int at, string dflt) {
        if (at < 0 || at >= this.slotCount) { return dflt; }
        long a = slots[at].a;
        int k = (int)(a & 255);
        if (k == 3) {
            int start = (int)(a >> 8);
            if (start >= 0) { return src.Substring(start, (int)slots[at].b); }
            return escPool[(int)slots[at].b];
        }
        if (k == 2) { return Convert.ToString(slots[at].b); }
        if (k == 7) {
            int ns = (int)(a >> 8);
            int len = (int)slots[at].b;
            return this.src.Substring(ns, len);
        }
        if (k == 1) { return "true"; }
        if (k == 6) { return "false"; }
        return dflt;
    }

    // 零分配视图提取：直接返回指定槽位指向底层缓冲区的 16 字节 StringView，免去 Substring 堆内存分配与垃圾回收。
    public StringView ViewAt(int at) {
        if (at < 0 || at >= this.slotCount) { return StringView.Empty(); }
        long a = slots[at].a;
        int k = (int)(a & 255);
        if (k == 3) {
            int start = (int)(a >> 8);
            if (start >= 0) {
                int len = (int)slots[at].b;
                return new StringView((nint)this.buf + (nint)start, len);
            }
            string s = escPool[(int)slots[at].b];
            return StringView.FromString(s);
        }
        if (k == 7) {
            int ns = (int)(a >> 8);
            int len = (int)slots[at].b;
            return new StringView((nint)this.buf + (nint)ns, len);
        }
        return StringView.Empty();
    }

    // 零分配字符串比对：直接将底层缓冲中指定槽位的文本与目标字符串比对，不产生 Substring 堆分配。
    public bool StrEquals(int at, string expected) {
        if (at < 0 || at >= this.slotCount || expected == null) { return false; }
        long a = slots[at].a;
        int k = (int)(a & 255);
        if (k != 3) {
            if (k == 7) {
                int ns = (int)(a >> 8);
                int len = (int)slots[at].b;
                if (len != expected.Length) { return false; }
                byte[] buf = this.buf;
                for (int i = 0; i < len; i = i + 1) {
                    if ((buf[ns + i] & 255) != (expected[i] & 255)) { return false; }
                }
                return true;
            }
            return false;
        }
        int start = (int)(a >> 8);
        int elen = expected.Length;
        if (start >= 0) {
            if ((int)slots[at].b != elen) { return false; }
            byte[] buf = this.buf;
            for (int i = 0; i < elen; i = i + 1) {
                if ((buf[start + i] & 255) != (expected[i] & 255)) { return false; }
            }
            return true;
        }
        return escPool[(int)slots[at].b] == expected;
    }

    public bool StrEquals(string expected) {
        return this.StrEquals(this.root, expected);
    }

    public bool BoolAt(int at, bool dflt) {
        if (at < 0 || at >= this.slotCount) { return dflt; }
        int k = (int)(slots[at].a & 255);
        if (k == 1) { return true; }
        if (k == 6) { return false; }
        if (k == 2) { return slots[at].b != 0; }
        if (k == 7) {
            int ns = (int)(slots[at].a >> 8);
            int len = (int)slots[at].b;
            return (long)JsonDoc.DoubleInRange(this.buf, ns, ns + len) != 0L;
        }
        if (k == 3) { return this.StrOfSlot(at) == "true"; }
        return dflt;
    }

    public string KeyAt(int at, int i) {
        int p = (int)(slots[at].a >> 8);
        int n = 0;
        while (p >= 0 && n < i) { p = pairs[p].nextPair; n = n + 1; }
        if (p < 0) { return ""; }
        int ks = pairs[p].keyStart;
        if (ks < 0) { return escPool[pairs[p].keyLen]; }
        return src.Substring(ks, pairs[p].keyLen);
    }

    public int ValAt(int at, int i) {
        int p = (int)(slots[at].a >> 8);
        int n = 0;
        while (p >= 0 && n < i) { p = pairs[p].nextPair; n = n + 1; }
        if (p < 0) { return -1; }
        return pairs[p].valueSlot;
    }

    public string ToJson() {
        return this.ToJson(this.root);
    }

    public string ToJson(int at) {
        if (at < 0 || at >= this.slotCount) { return ""; }
        StringBuilder sb = new StringBuilder();
        this.WriteSlot(sb, at);
        return sb.ToString();
    }

    public void WriteSlot(StringBuilder sb, int at) {
        long a = slots[at].a;
        int k = (int)(a & 255);
        if (k == 0) { sb.Append("null"); return; }
        if (k == 1) { sb.Append("true"); return; }
        if (k == 6) { sb.Append("false"); return; }
        if (k == 2) { sb.Append(slots[at].b); return; }
        if (k == 7) {
            int ns = (int)(a >> 8);
            int len = (int)slots[at].b;
            sb.Append(this.src.Substring(ns, len));
            return;
        }
        if (k == 3) {
            sb.Append("\"");
            Encoding.JsonEscapeTo(sb, this.StrOfSlot(at));
            sb.Append("\"");
            return;
        }
        long wb = slots[at].b;
        int count = (int)(wb & 2147483647L);
        if (k == 4) {
            sb.Append("[");
            int c = at + 1;
            for (int j = 0; j < count; j = j + 1) {
                if (j > 0) { sb.Append(","); }
                this.WriteSlot(sb, c);
                c = this.NextSibling(c);
            }
            sb.Append("]");
            return;
        }
        sb.Append("{");
        int p = (int)(a >> 8);
        bool first = true;
        while (p >= 0) {
            if (!first) { sb.Append(","); }
            first = false;
            sb.Append("\"");
            int ks = pairs[p].keyStart;
            string key = ks >= 0 ? src.Substring(ks, pairs[p].keyLen)
                : escPool[pairs[p].keyLen];
            Encoding.JsonEscapeTo(sb, key);
            sb.Append("\":");
            this.WriteSlot(sb, pairs[p].valueSlot);
            p = pairs[p].nextPair;
        }
        sb.Append("}");
    }

    // 深度路径寻址：按点号与括号切分（如 "user.profile.age"、"choices[0].message.content" 或 "data.0.id"）。
    // 全程在 Tape 槽位上以索引切片推进，0 临时字符串分配。找不到返回 -1。
    public int Path(int at, string path) {
        if (at < 0 || path == null || path.Length == 0) { return at; }
        int cur = at;
        int i = 0;
        int n = path.Length;
        while (i < n && cur >= 0) {
            int dot = i;
            while (dot < n && (path[dot] & 255) != 46) { dot = dot + 1; }
            int segLen = dot - i;
            if (segLen > 0) {
                cur = this.ResolveSegDirect(cur, path, i, segLen);
            }
            i = dot + 1;
        }
        return cur;
    }

    private int ResolveSegDirect(int at, string path, int segOff, int segLen) {
        if (at < 0 || segLen <= 0) { return at; }
        int cur = at;
        int p = 0;
        while (p < segLen && cur >= 0) {
            int bopen = p;
            while (bopen < segLen && (path[segOff + bopen] & 255) != 91) { bopen = bopen + 1; }
            int keyLen = bopen - p;
            if (keyLen > 0) {
                int k = (int)(slots[cur].a & 255);
                if (k == 4) {
                    int idx = 0;
                    bool isNum = true;
                    for (int j = 0; j < keyLen; j = j + 1) {
                        int c = (path[segOff + p + j] & 255) - 48;
                        if (c < 0 || c > 9) { isNum = false; break; }
                        idx = idx * 10 + c;
                    }
                    cur = isNum ? this.At(cur, idx) : -1;
                } else {
                    cur = this.GetDirect(cur, path, segOff + p, keyLen);
                }
                if (cur < 0) { return -1; }
            }
            if (bopen < segLen && (path[segOff + bopen] & 255) == 91) {
                int bclose = bopen + 1;
                while (bclose < segLen && (path[segOff + bclose] & 255) != 93) { bclose = bclose + 1; }
                int blen = bclose - (bopen + 1);
                if (blen > 0) {
                    int idx = 0;
                    bool isNum = true;
                    for (int j = 0; j < blen; j = j + 1) {
                        int c = (path[segOff + bopen + 1 + j] & 255) - 48;
                        if (c < 0 || c > 9) { isNum = false; break; }
                        idx = idx * 10 + c;
                    }
                    cur = isNum ? this.At(cur, idx) : -1;
                    if (cur < 0) { return -1; }
                }
                p = bclose + 1;
            } else {
                break;
            }
        }
        return cur;
    }

    public int Path(string path) {
        return this.Path(this.root, path);
    }

    public int PathInt(string path, int dflt) {
        int s = this.Path(this.root, path);
        return s >= 0 ? this.IntAt(s, dflt) : dflt;
    }

    public long PathLong(string path, long dflt) {
        int s = this.Path(this.root, path);
        return s >= 0 ? this.LongAt(s, dflt) : dflt;
    }

    public string PathStr(string path, string dflt) {
        int s = this.Path(this.root, path);
        return s >= 0 ? this.StrAt(s, dflt) : dflt;
    }

    public bool PathBool(string path, bool dflt) {
        int s = this.Path(this.root, path);
        return s >= 0 ? this.BoolAt(s, dflt) : dflt;
    }

    // ================= 便捷字段读取族 (开箱即用，支持直接键名或点分多级路径) =================
    public string GetString(string path, string dflt) {
        if (path == null) { return dflt; }
        int dot = path.IndexOf(".");
        if (dot < 0 && path.IndexOf("[") < 0) {
            int slot = this.Get(this.root, path);
            return slot >= 0 ? this.StrAt(slot, dflt) : dflt;
        }
        return this.PathStr(path, dflt);
    }
    public string GetString(string path) { return this.GetString(path, ""); }

    public long GetLong(string path, long dflt) {
        if (path == null) { return dflt; }
        int dot = path.IndexOf(".");
        if (dot < 0 && path.IndexOf("[") < 0) {
            int slot = this.Get(this.root, path);
            return slot >= 0 ? this.LongAt(slot, dflt) : dflt;
        }
        return this.PathLong(path, dflt);
    }
    public long GetLong(string path) { return this.GetLong(path, 0L); }

    public int GetInt(string path, int dflt) {
        if (path == null) { return dflt; }
        int dot = path.IndexOf(".");
        if (dot < 0 && path.IndexOf("[") < 0) {
            int slot = this.Get(this.root, path);
            return slot >= 0 ? this.IntAt(slot, dflt) : dflt;
        }
        return this.PathInt(path, dflt);
    }
    public int GetInt(string path) { return this.GetInt(path, 0); }

    public bool GetBool(string path, bool dflt) {
        if (path == null) { return dflt; }
        int dot = path.IndexOf(".");
        if (dot < 0 && path.IndexOf("[") < 0) {
            int slot = this.Get(this.root, path);
            return slot >= 0 ? this.BoolAt(slot, dflt) : dflt;
        }
        return this.PathBool(path, dflt);
    }
    public bool GetBool(string path) { return this.GetBool(path, false); }
}
