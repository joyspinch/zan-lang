using System;
using System.Json;
using System.Threading;

namespace System.Json;

// 工作流与线程级 JSON 解析工作区缓冲（消灭单次高频解析的堆内存申请与释放）。
public class JsonScratch {
    public byte[] buf;
    public JsonSlot[] slots;
    public JsonPair[] pairs;
    public int[] fr;
    public long[] counts;

    public JsonScratch() {
        this.buf = new byte[65536 + 32];
        this.slots = new JsonSlot[16384];
        this.pairs = new JsonPair[8192];
        this.fr = new int[(JsonDoc.MaxDepth + 2) * 4];
        this.counts = new long[4];
    }

    public void EnsureCapacity(int len, int slotCap, int pairCap) {
        if (this.buf.Length < len + 32) {
            this.buf = new byte[len + 32];
        }
        if (this.slots.Length < slotCap) {
            this.slots = new JsonSlot[slotCap];
        }
        if (this.pairs.Length < pairCap) {
            this.pairs = new JsonPair[pairCap];
        }
    }
}
