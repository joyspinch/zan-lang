using System;
using System.Text;

namespace System.Json;

// 解析后的 JSON 值树（object / array / string / number / bool / null）。
// 递归模型，可以遍历嵌套文档（UI 布局树、状态实体）。用
// <see cref="Parse"/> 构建；用 As*/类型化字段助手读取标量；
// 用 Get/Has 遍历对象、At/Count 遍历数组。
// 性能设计（3MB 文档实测 ~280 MB/s，同文档历史实现 28 MB/s）：
// 逐字节扫描全部下沉到 NativeMemory.ScanNotByte / Find（strspn/memchr，
// 向量化）；数字在扫描循环里就地解析成 numI/numD，不再保留字面量
// 字符串（每 token 少一次分配、读取侧少一次重解析）；字符串无转义时
// 一次 Substring（比逐字节 Zan 循环快一个数量级）；对象键值对
// keys/vals 并置（同一次键查找碰一个 Cache 行，不用两趟）。
public class JsonValue {
    // 值类别：0 null，1 bool，2 number，3 string，4 array，5 object。
    public int kind;
    // kind 1 时的布尔值。
    public bool boolVal;
    // kind 2 时的整数值（无小数/指数部分的 token 直接存这里；
    // 浮点 token 存 numD，numI 置 0；读取时按 token 形态取，
    // 没有二次解析）。
    public long numI;
    // kind 2 时的浮点值（带 . / e 的 token）。
    public double numD;
    // kind 2 时该 token 是否为纯整数（决定 Int/Long 是否免转换）。
    public bool numIsInt;
    // kind 2 时数字的十进制文本（AsString/ToJson 用）。
    public string numRaw;
    // kind 3 时的字符串值。
    public string strVal;
    // kind 4 时的数组元素。
    public List<JsonValue> items;
    // kind 5 时的键列表。
    public List<string> keys;
    // kind 5 时与 keys 并置的值列表。
    public List<JsonValue> vals;
    // kind 5 时的键索引哈希表（键数 > 8 且被频繁查找时懒加载构建，加速宽对象属性访问）。
    public Dict<string, int> keyIndex;

    // 组树（WriteTo/WritePretty）与解析（ReadValueAt）共用的
    // 嵌套深度上限。序列化同样是递归的：无界深度的树会在
    // WriteTo 里耗尽调用栈直接段错误，所以与解析对称地限制。
    public static int MaxDepth = 512;

    public JsonValue() {
        this.kind = 0;
        this.boolVal = false;
        this.numI = 0L;
        this.numD = 0.0;
        this.numIsInt = false;
        this.numRaw = "";
        this.strVal = "";
        this.items = null;
        this.keys = null;
        this.vals = null;
        this.keyIndex = null;
    }

    // 构造 null 值（kind 0）。
    public static JsonValue NewNull() {
        JsonValue v = new JsonValue();
        v.kind = 0;
        return v;
    }

    // 构造布尔值（kind 1）。
    public static JsonValue NewBool(bool b) {
        JsonValue v = new JsonValue();
        v.kind = 1;
        v.boolVal = b;
        return v;
    }

    // 构造整数值（kind 2，numIsInt）。
    public static JsonValue NewInt(long n) {
        JsonValue v = new JsonValue();
        v.kind = 2;
        v.numI = n;
        v.numIsInt = true;
        v.numRaw = "";
        return v;
    }

    // 构造浮点值（kind 2）。
    public static JsonValue NewDouble(double d) {
        JsonValue v = new JsonValue();
        v.kind = 2;
        v.numD = d;
        v.numIsInt = false;
        v.numRaw = "";
        return v;
    }

    // 构造数字值（kind 2），保留原始字面量避免浮点往返损失。
    public static JsonValue NewNum(string raw) {
        JsonValue v = new JsonValue();
        v.kind = 2;
        v.numRaw = raw;
        return v;
    }

    // 构造字符串值（kind 3）。
    public static JsonValue NewStr(string s) {
        JsonValue v = new JsonValue();
        v.kind = 3;
        v.strVal = s;
        return v;
    }

    // 构造空数组（kind 4）。
    public static JsonValue NewArray() {
        JsonValue v = new JsonValue();
        v.kind = 4;
        v.items = new List<JsonValue>();
        return v;
    }

    // 构造空对象（kind 5）。
    public static JsonValue NewObject() {
        JsonValue v = new JsonValue();
        v.kind = 5;
        v.keys = new List<string>();
        v.vals = new List<JsonValue>();
        return v;
    }

    // 深拷贝当前 JsonValue 及其所有子节点（对象和数组递归克隆）。
    public JsonValue Clone() {
        if (this.kind == 0) { return JsonValue.NewNull(); }
        if (this.kind == 1) { return JsonValue.NewBool(this.boolVal); }
        if (this.kind == 2) {
            JsonValue v = new JsonValue();
            v.kind = 2;
            v.numI = this.numI;
            v.numD = this.numD;
            v.numIsInt = this.numIsInt;
            v.numRaw = this.numRaw;
            return v;
        }
        if (this.kind == 3) { return JsonValue.NewStr(this.strVal); }
        if (this.kind == 4) {
            JsonValue arr = JsonValue.NewArray();
            int n = this.items.Count;
            for (int i = 0; i < n; i = i + 1) {
                arr.items.Add(this.items[i].Clone());
            }
            return arr;
        }
        if (this.kind == 5) {
            JsonValue obj = JsonValue.NewObject();
            int n = this.keys.Count;
            for (int i = 0; i < n; i = i + 1) {
                obj.keys.Add(this.keys[i]);
                obj.vals.Add(this.vals[i].Clone());
            }
            return obj;
        }
        return JsonValue.NewNull();
    }

    // 是否为 null 值（kind 0）。
    public bool IsNull() { return kind == 0; }
    // 是否为布尔值（kind 1）。
    public bool IsBool() { return kind == 1; }
    // 是否为数字值（kind 2）。
    public bool IsNumber() { return kind == 2; }
    // 是否为整型形态的数字：NewInt、整数字面量解析产物，
    // 或无小数点/指数记号的 NewNum 手工字面量；NewDouble 永远不是
    // （数值恰为整数也保持浮点形态）。二进制序列化据此选择整数/
    // 浮点线格式。
    public bool IsInt() {
        if (kind != 2) { return false; }
        if (numIsInt) { return numRaw == null || numRaw.Length == 0; }
        if (numRaw == null || numRaw.Length == 0) { return false; }
        int i = 0;
        int n = numRaw.Length;
        while (i < n) {
            int c = numRaw[i] & 255;
            if (c == 46 || c == 101 || c == 69) { return false; }  // . e E
            i = i + 1;
        }
        return true;
    }
    // 是否为字符串值（kind 3）。
    public bool IsString() { return kind == 3; }
    // 是否为数组（kind 4）。
    public bool IsArray() { return kind == 4; }
    // 是否为对象（kind 5）。
    public bool IsObject() { return kind == 5; }

    // ---- 对象访问 -----------------------------------------------------

    // 追加键值对（对象）。不去重；重复键读取时首键胜（见 Get）。
    public void Put(string key, JsonValue v) {
        // 索引已在册的键不覆盖：首键胜，保持与线性扫描一致。
        if (this.keyIndex != null && !this.keyIndex.ContainsKey(key)) {
            this.keyIndex[key] = keys.Count;
        }
        keys.Add(key);
        vals.Add(v);
    }

    // 对象是否含该 key；不是对象时返回 false。
    public bool Has(string key) {
        if (kind != 5) { return false; }
        int n = keys.Count;
        if (n <= 8) {
            for (int i = 0; i < n; i = i + 1) {
                if (keys[i] == key) { return true; }
            }
            return false;
        }
        if (this.keyIndex == null) {
            Get(key);
        }
        if (this.keyIndex != null) {
            return this.keyIndex.ContainsKey(key);
        }
        return false;
    }

    // `key` 对应的值；不存在或不是对象时返回 null。
    // 键数量 <= 8 时走连续内存线性扫描（零额外内存、缓存行友好）；
    // 键数量 > 8 时自动激活懒加载哈希索引，O(1) 访问。
    // 重复键统一首键胜（与线性扫描同语义）。
    public JsonValue Get(string key) {
        if (kind != 5) { return null; }
        int n = keys.Count;
        if (n <= 8) {
            for (int i = 0; i < n; i = i + 1) {
                if (keys[i] == key) { return vals[i]; }
            }
            return null;
        }
        if (this.keyIndex == null) {
            Dict<string, int> ki = new Dict<string, int>();
            for (int i = 0; i < n; i = i + 1) {
                // 首键胜：在册的不覆盖。
                if (!ki.ContainsKey(keys[i])) { ki[keys[i]] = i; }
            }
            this.keyIndex = ki;
        }
        if (this.keyIndex.ContainsKey(key)) {
            int idx = this.keyIndex[key];
            return vals[idx];
        }
        return null;
    }

    // 若 `key` 已存在则替换其值，否则追加（对象）。
    public void Set(string key, JsonValue v) {
        if (this.keyIndex != null && this.keyIndex.ContainsKey(key)) {
            int idx = this.keyIndex[key];
            vals[idx] = v;
            return;
        }
        // 大对象先补建索引（与 Get 同口径，首键胜），否则下面的线性扫描
        // 让"循环 Set 建 N 键"退化成 O(n²)：TomlParser 逐表 Set 曾因此把
        // 100k 表的配置解析挂到分钟级（P2-27）。
        if (keys.Count > 8) {
            this.EnsureKeyIndex();
            if (this.keyIndex.ContainsKey(key)) {
                vals[this.keyIndex[key]] = v;
            } else {
                this.keyIndex[key] = keys.Count;
                keys.Add(key);
                vals.Add(v);
            }
            return;
        }
        for (int i = 0; i < keys.Count; i = i + 1) {
            if (keys[i] == key) {
                vals[i] = v;
                if (this.keyIndex != null) { this.keyIndex[key] = i; }
                return;
            }
        }
        if (this.keyIndex != null) {
            this.keyIndex[key] = keys.Count;
        }
        keys.Add(key);
        vals.Add(v);
    }

    // 惰性构建键哈希索引（键数量 > 8 时才值得建）。首键胜，与
    // Get 的线性扫描同语义；RemoveAt 会整体失效重建（见该处注释）。
    void EnsureKeyIndex() {
        if (this.keyIndex != null) { return; }
        Dict<string, int> ki = new Dict<string, int>();
        int n = keys.Count;
        for (int i = 0; i < n; i = i + 1) {
            if (!ki.ContainsKey(keys[i])) { ki[keys[i]] = i; }
        }
        this.keyIndex = ki;
    }

    // 从对象中移除指定键（存在则删除并返回 true；不存在或非对象返回 false）。
    public bool Remove(string key) {
        if (kind != 5 || keys == null) { return false; }
        for (int i = 0; i < keys.Count; i = i + 1) {
            if (keys[i] == key) {
                this.RemoveAt(i);
                return true;
            }
        }
        return false;
    }

    // 从对象或数组中按索引移除指定元素。
    public void RemoveAt(int index) {
        if (kind == 5) {
            if (keys != null && index >= 0 && index < keys.Count) {
                keys.RemoveAt(index);
                if (vals != null && index < vals.Count) {
                    vals.RemoveAt(index);
                }
                this.keyIndex = null;
            }
            return;
        }
        if (kind == 4) {
            // 数组的元素在 items 里（vals 是对象的值列表）——删错列表
            // 会让 RemoveAt 变成静默的空操作。
            if (items != null && index >= 0 && index < items.Count) {
                items.RemoveAt(index);
            }
        }
    }

    // 原位改名第 `index` 个键（键序与值不变）。Designer 这类编辑器用它
    // 做"保持键序的改名"，替代裸写 keys[i]——裸写会绕过 keyIndex，
    // 大对象（>8 键）改名后按名 Get 命中旧下标。非对象或越界抛
    // JsonException（与 KeyAt/ValAt 同族：改名传错下标是编程错误）。
    // 撞已有键时旧键仍在册、按名 Get 首键胜——调用方负责先查重
    // （Designer 属性改名就这么做）。
    public void RenameKey(int index, string newKey) {
        if (kind != 5 || keys == null) {
            throw new JsonException("RenameKey(" + Convert.ToString(index) + ") on non-object value (kind=" + Convert.ToString(kind) + ")");
        }
        if (index < 0 || index >= keys.Count) {
            throw new JsonException("RenameKey(" + Convert.ToString(index) + ") out of range (count=" + Convert.ToString(keys.Count) + ")");
        }
        keys[index] = newKey;
        this.keyIndex = null;
    }

    // 从该对象解析点分路径（"user.name"）；任一段
    // 缺失或不是对象时返回 null。用于双向 `bind` 查找。
    public JsonValue PathGet(string path) {
        if (path == null) { return null; }
        JsonValue cur = this;
        int start = 0;
        int len = path.Length;
        for (int i = 0; i <= len; i = i + 1) {
            bool end = i == len;
            bool dot = false;
            if (!end) { dot = (path[i] & 255) == 46; }
            if (end || dot) {
                string seg = path.Substring(start, i - start);
                if (cur == null) { return null; }
                cur = cur.Get(seg);
                start = i + 1;
            }
        }
        return cur;
    }

    // 沿点分路径写入标量字符串，按需创建中间对象
    // 和叶子节点，使绑定的控件能把编辑内容回写到状态。
    public void PathSet(string path, string val) {
        PathSetValue(path, JsonValue.NewStr(val));
    }

    // 与 PathSet 类似，但写入任意 JsonValue 叶子，使绑定的控件
    // 能在回写时保持值的 JSON 类型（bool / number / string），
    // 而不是全部转成字符串。根不是对象（数组/标量）时抛出 JsonException。
    public void PathSetValue(string path, JsonValue leaf) {
        if (path == null) { return; }
        if (!this.IsObject()) {
            throw new JsonException(
            "PathSetValue: root is not an object, path: " + path);
        }
        JsonValue cur = this;
        int start = 0;
        int len = path.Length;
        for (int i = 0; i <= len; i = i + 1) {
            bool end = i == len;
            bool dot = false;
            if (!end) { dot = (path[i] & 255) == 46; }
            if (end || dot) {
                string seg = path.Substring(start, i - start);
                if (end) {
                    cur.Set(seg, leaf);
                } else {
                    JsonValue next = cur.Get(seg);
                    if (next == null || !next.IsObject()) {
                        next = JsonValue.NewObject();
                        cur.Set(seg, next);
                    }
                    cur = next;
                }
                start = i + 1;
            }
        }
    }

    // ---- 便利写入口 ----------------------------------------------------
    // 手拼 JSON 字符串（"{\"k\":\"" + v + "\"}"）是注入与非法 JSON 的
    // 根源：引号、反斜杠、换行一旦混进变量就毁掉整个报文。这组入口让
    // 每个字段一行写完、转义交给 ToJson，从根上替代字符串拼接。

    // 追加字符串成员（null 值写成 JSON null，与字符串 "null" 区分）。
    public void PutStr(string key, string v) {
        if (v == null) { this.Put(key, JsonValue.NewNull()); return; }
        this.Put(key, JsonValue.NewStr(v));
    }

    // 追加整数成员。
    public void PutInt(string key, long v) {
        this.Put(key, JsonValue.NewInt(v));
    }

    // 追加浮点成员。
    public void PutDouble(string key, double v) {
        this.Put(key, JsonValue.NewDouble(v));
    }

    // 追加布尔成员。
    public void PutBool(string key, bool v) {
        this.Put(key, JsonValue.NewBool(v));
    }

    // 追加 null 成员。
    public void PutNull(string key) {
        this.Put(key, JsonValue.NewNull());
    }

    // 把一段已序列化的 JSON 文本作为成员值嵌入：能解析就挂
    // 解析出的子树（对象/数组/数字原样保型），解析失败则整段按字符串
    // 存——任何输入都不可能产出非法 JSON。用于收编「片段拼接」：把
    // 上游序列化好的 items/errors 等挂进外层报文，不再 Substring(1)
    // 之类按文本外科手术拼。
    public void PutJson(string key, string jsonText) {
        this.Put(key, JsonValue.ParseOrStr(jsonText));
    }

    // 数组末尾追加字符串元素（null 按空串存，数组元素无 null 语义）。
    public void AppendStr(string v) {
        this.Append(JsonValue.NewStr(v == null ? "" : v));
    }

    // 数组末尾追加整数元素。
    public void AppendInt(long v) {
        this.Append(JsonValue.NewInt(v));
    }

    // 数组末尾追加浮点元素。
    public void AppendDouble(double v) {
        this.Append(JsonValue.NewDouble(v));
    }

    // 数组末尾追加布尔元素。
    public void AppendBool(bool v) {
        this.Append(JsonValue.NewBool(v));
    }

    // 数组末尾嵌入一段已序列化 JSON 文本（语义同 PutJson）。
    public void AppendJson(string jsonText) {
        this.Append(JsonValue.ParseOrStr(jsonText));
    }

    // ParseLenient 的无异常形态：能解析返回子树；解析失败或
    // 结果是 null 字面量时返回字符串形态——用于 PutJson/AppendJson 的
    // 「片段嵌入」语义，保证任何输入都得到一个合法 JSON 值。
    public static JsonValue ParseOrStr(string jsonText) {
        if (jsonText == null) { return JsonValue.NewStr(""); }
        JsonValue v = null;
        try { v = JsonValue.ParseLenient(jsonText); } catch (Exception) { v = null; }
        if (v == null || v.IsNull()) { return JsonValue.NewStr(jsonText); }
        return v;
    }

    // ---- 数组访问 -----------------------------------------------------

    // 数组末尾追加元素（数组）。
    public void Append(JsonValue v) { items.Add(v); }

    // 元素数量（数组元素或对象条目数；其他情况为 0）。
    public int Count() {
        if (kind == 4) { return items.Count; }
        if (kind == 5) { return keys.Count; }
        return 0;
    }

    // 第 i 个数组元素。非数组或越界抛 JsonException——历史版本此处是
    // 裸 items[i]：把 At 用在对象（items=null）上直接段崩 0xC0000005
    // 且无任何诊断（P2-17）。
    public JsonValue At(int i) {
        if (kind != 4 || items == null) {
            throw new JsonException("At(" + Convert.ToString(i) + ") on non-array value (kind=" + Convert.ToString(kind) + ")");
        }
        if (i < 0 || i >= items.Count) {
            throw new JsonException("At(" + Convert.ToString(i) + ") out of range (count=" + Convert.ToString(items.Count) + ")");
        }
        return items[i];
    }

    // 替换第 i 个数组元素（kind 4）。非数组或越界为**静默空操作**——
    // 与 At/KeyAt 的抛错风格不同：所有现役调用方都先用下标计算/Count
    // 自行校验过，把这里改成抛错等于给它们加一遍重复检查。新代码拿
    // 不准下标时请先校验，别依赖静默语义。
    public void SetAt(int i, JsonValue val) {
        if (kind == 4 && items != null && i >= 0 && i < items.Count) {
            items[i] = val;
        }
    }

    // 第 i 个对象的 key（用于遍历对象）。非对象或越界抛 JsonException
    // （与 At 同族：历史版本裸 keys[i]，对象外调用段崩）。
    public string KeyAt(int i) {
        if (kind != 5 || keys == null) {
            throw new JsonException("KeyAt(" + Convert.ToString(i) + ") on non-object value (kind=" + Convert.ToString(kind) + ")");
        }
        if (i < 0 || i >= keys.Count) {
            throw new JsonException("KeyAt(" + Convert.ToString(i) + ") out of range (count=" + Convert.ToString(keys.Count) + ")");
        }
        return keys[i];
    }
    // 第 i 个对象的值（与 KeyAt 配对遍历）。非对象或越界抛 JsonException。
    public JsonValue ValAt(int i) {
        if (kind != 5 || vals == null) {
            throw new JsonException("ValAt(" + Convert.ToString(i) + ") on non-object value (kind=" + Convert.ToString(kind) + ")");
        }
        if (i < 0 || i >= vals.Count) {
            throw new JsonException("ValAt(" + Convert.ToString(i) + ") out of range (count=" + Convert.ToString(vals.Count) + ")");
        }
        return vals[i];
    }

    // ---- 带默认值的标量读取器 -----------------------------------------

    // 将该值序列化为紧凑 JSON 字符串。字符串和
    // 对象 key 经 Encoding.JsonEscape 转义；数字按 token 形态
    // 输出（整数走整型格式化，浮点走最短 double 格式化）。
    // 是 Parse 对值模型的逆操作。嵌套超过 JsonValue.MaxDepth
    // 层时抛出 JsonException——WriteTo 是递归的，无界深度的树
    // 会耗尽调用栈直接段错误（与 Parse 的 MaxDepth 对称）。
    public string ToJson() {
        StringBuilder sb = new StringBuilder();
        this.WriteTo(sb);
        return sb.ToString();
    }

    // WriteToAt 的入口（depth 从 0 起）。
    public void WriteTo(StringBuilder sb) {
        this.WriteToAt(sb, 0);
    }

    // WriteTo 的递归实现：`depth` 用于 MaxDepth 保护。
    public void WriteToAt(StringBuilder sb, int depth) {
        if (depth > JsonValue.MaxDepth) {
            throw new JsonException("JSON nesting too deep to serialize");
        }
        if (kind == 0) { sb.Append("null"); return; }
        if (kind == 1) {
            if (boolVal) { sb.Append("true"); } else { sb.Append("false"); }
            return;
        }
        if (kind == 2) {
            if (this.numRaw != null && this.numRaw.Length > 0) {
                sb.Append(this.numRaw);
            } else if (this.numIsInt) {
                sb.Append(this.numI);
            } else {
                double d = this.numD;
                if (d != d || d - d != 0) { sb.Append("null"); }
                else { sb.Append(this.numD); }
            }
            return;
        }
        if (kind == 3) {
            sb.Append("\"");
            Encoding.JsonEscapeTo(sb, strVal);
            sb.Append("\"");
            return;
        }
        if (kind == 4) {
            sb.Append("[");
            for (int i = 0; i < items.Count; i = i + 1) {
                if (i > 0) { sb.Append(","); }
                items[i].WriteToAt(sb, depth + 1);
            }
            sb.Append("]");
            return;
        }
        if (kind == 5) {
            sb.Append("{");
            for (int i = 0; i < keys.Count; i = i + 1) {
                if (i > 0) { sb.Append(","); }
                sb.Append("\"");
                Encoding.JsonEscapeTo(sb, keys[i]);
                sb.Append("\":");
                vals[i].WriteToAt(sb, depth + 1);
            }
            sb.Append("}");
            return;
        }
    }

    // 数字的输出文本：解析时就地解析的整数/浮点走格式化，
    // NewNum 手工构造的值保留原始字面量。NaN/±Infinity 不是合法
    // JSON 数字，统一输出 null。
    public static string NumText(JsonValue v) {
        if (v.numRaw != null && v.numRaw.Length > 0) { return v.numRaw; }
        if (v.numIsInt) { return Convert.ToString(v.numI); }
        double d = v.numD;
        if (d != d || d - d != 0) { return "null"; }
        return Convert.ToString(v.numD);
    }

    // 序列化为便于阅读的多行 JSON 字符串（两空格
    // 缩进，每个 key 一行），用于手工编辑的交换文件或配置。
    // 与 ToJson 一样可通过 Parse 往返。
    // 嵌套超限时与 ToJson 一样抛 JsonException。
    public string PrettyToJson() {
        StringBuilder sb = new StringBuilder();
        this.WritePretty(sb, 0);
        return sb.ToString();
    }

    // PrettyToJson 的递归实现；嵌套超限时抛 JsonException。
    public void WritePretty(StringBuilder sb, int depth) {
        if (depth > JsonValue.MaxDepth) {
            throw new JsonException("JSON nesting too deep to serialize");
        }
        if (kind == 5) {
            if (keys.Count == 0) { sb.Append("{}"); return; }
            sb.Append("{\n");
            for (int i = 0; i < keys.Count; i = i + 1) {
                sb.Append(JsonValue.PrettyIndent(depth + 1));
                sb.Append("\"");
                Encoding.JsonEscapeTo(sb, keys[i]);
                sb.Append("\": ");
                vals[i].WritePretty(sb, depth + 1);
                if (i < keys.Count - 1) { sb.Append(","); }
                sb.Append("\n");
            }
            sb.Append(JsonValue.PrettyIndent(depth));
            sb.Append("}");
            return;
        }
        if (kind == 4) {
            if (items.Count == 0) { sb.Append("[]"); return; }
            sb.Append("[\n");
            for (int i = 0; i < items.Count; i = i + 1) {
                sb.Append(JsonValue.PrettyIndent(depth + 1));
                items[i].WritePretty(sb, depth + 1);
                if (i < items.Count - 1) { sb.Append(","); }
                sb.Append("\n");
            }
            sb.Append(JsonValue.PrettyIndent(depth));
            sb.Append("]");
            return;
        }
        this.WriteTo(sb);
    }

    // 生成 depth 层两空格缩进串。
    public static string PrettyIndent(int depth) {
        string s = "";
        for (int i = 0; i < depth; i = i + 1) { s = s + "  "; }
        return s;
    }

    // 十进制数字字符的值，非数字返回 -1。
    public static int Digit(string ch) {
        if (ch == "0") { return 0; }
        if (ch == "1") { return 1; }
        if (ch == "2") { return 2; }
        if (ch == "3") { return 3; }
        if (ch == "4") { return 4; }
        if (ch == "5") { return 5; }
        if (ch == "6") { return 6; }
        if (ch == "7") { return 7; }
        if (ch == "8") { return 8; }
        if (ch == "9") { return 9; }
        return -1;
    }

    // 解析数字 token 的前导（可选符号）整数部分，
    // 在 '.'/'e' 处停止。避免 "60.0"/"1e3" 触发 Convert 异常。
    public static int IntOf(string t) {
        int n = t.Length;
        int i = 0;
        bool neg = false;
        if (n > 0 && (t[0] & 255) == 45) { neg = true; i = 1; }
        int acc = 0;
        while (i < n) {
            int d = (t[i] & 255) - 48;
            if (d < 0 || d > 9) { break; }
            acc = acc * 10 + d;
            i = i + 1;
        }
        if (neg) { return 0 - acc; }
        return acc;
    }

    // 与 IntOf 类似，但按 64 位累加，使 `long`/`ulong` 字段能保存
    // 超出 32 位范围的值。
    public static long LongOf(string t) {
        int n = t.Length;
        int i = 0;
        bool neg = false;
        if (n > 0 && (t[0] & 255) == 45) { neg = true; i = 1; }
        long acc = 0;
        while (i < n) {
            int d = (t[i] & 255) - 48;
            if (d < 0 || d > 9) { break; }
            acc = acc * 10 + (long)d;
            i = i + 1;
        }
        if (neg) { return 0 - acc; }
        return acc;
    }

    // 无需 Convert 解析数字 token（符号、小数、指数），
    // 避免异常；非数字前缀时返回 0.0。
    // 10 的幂表：10^0..10^22 全部可被 double 精确表示（5^22 < 2^53），
    // 一次乘/除只引入一次舍入。更大的指数按 22 一档链式应用。
    public static double[] Pow10Tab = new double[] {
        1e0, 1e1, 1e2, 1e3, 1e4, 1e5, 1e6, 1e7, 1e8, 1e9, 1e10, 1e11,
        1e12, 1e13, 1e14, 1e15, 1e16, 1e17, 1e18, 1e19, 1e20, 1e21, 1e22
    };

    // 把十进制文本转成 double：有效数字吸进 long（上限 2^53 内保持
    // 精确，超出部分按首个被丢数字四舍五入），再以精确的 10 的幂表
    // 一次性缩放，保证 ≤16 位有效数字与适中指数下的精确舍入。
    public static double DoubleOf(string t) {
        int n = t.Length;
        int i = 0;
        bool neg = false;
        if (n > 0 && (t[0] & 255) == 45) { neg = true; i = 1; }
        else if (n > 0 && (t[0] & 255) == 43) { i = 1; }
        long mant = 0;
        int exp10 = 0;
        bool roundUp = false;
        bool seenDigit = false;
        while (i < n) {
            int d = (t[i] & 255) - 48;
            if (d < 0 || d > 9) { break; }
            seenDigit = true;
            if (mant < 100000000000000000) {
                mant = mant * 10 + d;
            } else {
                if (!roundUp && d >= 5) { roundUp = true; }
                exp10 = exp10 + 1;
            }
            i = i + 1;
        }
        if (i < n && (t[i] & 255) == 46) {
            i = i + 1;
            while (i < n) {
                int d = (t[i] & 255) - 48;
                if (d < 0 || d > 9) { break; }
                seenDigit = true;
                if (mant < 100000000000000000) {
                    mant = mant * 10 + d;
                    exp10 = exp10 - 1;
                } else {
                    if (!roundUp && d >= 5) { roundUp = true; }
                }
                i = i + 1;
            }
        }
        if (!seenDigit) { return 0.0; }
        if (i < n && ((t[i] & 255) == 101 || (t[i] & 255) == 69)) {
            i = i + 1;
            bool eneg = false;
            if (i < n && (t[i] & 255) == 45) { eneg = true; i = i + 1; }
            else if (i < n && (t[i] & 255) == 43) { i = i + 1; }
            int ex = 0;
            while (i < n) {
                int d = (t[i] & 255) - 48;
                if (d < 0 || d > 9) { break; }
                if (ex < 100000000) { ex = ex * 10 + d; }
                i = i + 1;
            }
            if (eneg) { exp10 = exp10 - ex; } else { exp10 = exp10 + ex; }
        }
        if (roundUp) { mant = mant + 1; }
        double v = mant;
        int e = exp10;
        if (e > 350) { e = 350; }
        else if (e < -350) { e = -350; }
        while (e > 22) { v = v * 1e22; e = e - 22; }
        while (e < -22) { v = v / 1e22; e = e + 22; }
        if (e >= 0) {
            v = v * JsonValue.Pow10Tab[e];
        } else {
            v = v / JsonValue.Pow10Tab[0 - e];
        }
        if (neg) {
            if (v == 0.0) { return -0.0; }
            return 0.0 - v;
        }
        return v;
    }

    // AsString：字符串原样返回；数字输出 NumText 同源文本；布尔返回
    // "true"/"false"；其他类型退回 `dflt`。
    public string AsString(string dflt) {
        if (kind == 3) { return strVal; }
        if (kind == 2) { return JsonValue.NumText(this); }
        if (kind == 1) { if (boolVal) { return "true"; } return "false"; }
        return dflt;
    }

    // AsInt：数字按 token 形态取（纯整数免解析）；布尔 1/0；
    // 字符串解析整数前缀；其余退回 `dflt`。
    public int AsInt(int dflt) {
        if (kind == 2) {
            if (numRaw != null && numRaw.Length > 0) { return JsonValue.IntOf(numRaw); }
            if (numIsInt) { return (int)numI; }
            return (int)numD;
        }
        if (kind == 1) { if (boolVal) { return 1; } return 0; }
        if (kind == 3) { return JsonValue.IntOf(strVal); }
        return dflt;
    }

    // AsLong：同 AsInt 但按 64 位。
    public long AsLong(long dflt) {
        if (kind == 2) {
            if (numRaw != null && numRaw.Length > 0) { return JsonValue.LongOf(numRaw); }
            if (numIsInt) { return numI; }
            return (long)numD;
        }
        if (kind == 1) { if (boolVal) { return 1; } return 0; }
        if (kind == 3) { return JsonValue.LongOf(strVal); }
        return dflt;
    }

    // AsDouble：数字按 token 形态取；布尔 1/0；字符串解析；
    // 其余退回 `dflt`。
    public double AsDouble(double dflt) {
        if (kind == 2) {
            if (numRaw != null && numRaw.Length > 0) { return JsonValue.DoubleOf(numRaw); }
            if (numIsInt) { return (double)numI; }
            return numD;
        }
        if (kind == 1) { if (boolVal) { return 1.0; } return 0.0; }
        if (kind == 3) { return JsonValue.DoubleOf(strVal); }
        return dflt;
    }

    // AsBool：布尔原样；数字按非 0 为真；字符串仅 "true" 为真；
    // 其余退回 `dflt`。
    public bool AsBool(bool dflt) {
        if (kind == 1) { return boolVal; }
        if (kind == 2) { return this.AsLong(0) != 0; }
        if (kind == 3) { return strVal == "true"; }
        return dflt;
    }

    // ---- 类型化字段助手（对象 + key） -----------------------------------

    // `key` 的字符串值，缺失或类型不符时退回 `dflt`。
    public string Str(string key, string dflt) {
        JsonValue v = Get(key);
        if (v == null) { return dflt; }
        return v.AsString(dflt);
    }

    // `key` 的整数值，缺失或类型不符时退回 `dflt`。
    public int Int(string key, int dflt) {
        JsonValue v = Get(key);
        if (v == null) { return dflt; }
        return v.AsInt(dflt);
    }

    // 点分路径的类型化读取：路径上任何一段缺失（PathGet 返回 null）都
    // 退回 `dflt`，而不是让调用方对 null 调 AsString/AsInt 而崩溃。
    public string PathStr(string path, string dflt) {
        JsonValue v = PathGet(path);
        if (v == null) { return dflt; }
        return v.AsString(dflt);
    }

    // 同 PathStr，整数版。
    public int PathInt(string path, int dflt) {
        JsonValue v = PathGet(path);
        if (v == null) { return dflt; }
        return v.AsInt(dflt);
    }

    // `key` 的 64 位整数值，缺失或类型不符时退回 `dflt`。
    public long Long(string key, long dflt) {
        JsonValue v = Get(key);
        if (v == null) { return dflt; }
        return v.AsLong(dflt);
    }

    // `key` 的布尔值，缺失或类型不符时退回 `dflt`。
    public bool Bool(string key, bool dflt) {
        JsonValue v = Get(key);
        if (v == null) { return dflt; }
        return v.AsBool(dflt);
    }

    // `key` 的浮点值，缺失或解析不出时退回 `dflt`。
    public double Double(string key, double dflt) {
        JsonValue v = Get(key);
        if (v == null) { return dflt; }
        return v.AsDouble(dflt);
    }

    // 就地解析 [from, to) 的 JSON 数字 token：无 . e 且能安全装进
    // long 的走整数快路径，否则走浮点。
    public static JsonValue ParseNumberToken(string t, int from, int to) {
        int i = from;
        bool neg = false;
        // 负号后要从**符号之后**继续（i = i + 1），写死成 1 会在
        // from > 0 时（数字不在文档开头）从错误的位置读数字位：
        // {"x":-7} 会读成 0、[1,-2] 会读成 -1。
        if (i < to && (t[i] & 255) == 45) { neg = true; i = i + 1; }
        bool hasDotExp = false;
        for (int k = i; k < to; k = k + 1) {
            int c = (t[k] & 255);
            if (c == 46 || c == 101 || c == 69) { hasDotExp = true; break; }
        }
        if (!hasDotExp && to - i <= 18) {
            long acc = 0;
            for (int k = i; k < to; k = k + 1) {
                int d = (t[k] & 255) - 48;
                if (d < 0 || d > 9) { break; }
                acc = acc * 10 + d;
            }
            if (neg) { acc = 0 - acc; }
            return JsonValue.NewInt(acc);
        }
        // 走 double 的只有 . / e 形态与 >18 位整数：这两类用格式化文本
        // 还原会丢精度（1e2 → "100"、20 位整数 → "1.23E19"），把已经切出来
        // 的 token 文本留下当 numRaw，AsString/ToJson 才是无损的。
        string raw = t.Substring(from, to - from);
        double d2 = JsonValue.DoubleOf(raw);
        JsonValue v = JsonValue.NewDouble(d2);
        v.numRaw = raw;
        return v;
    }

    // ---- 解析 -----------------------------------------------------------

    // 将 JsonDoc Tape 节点快速物化为可变的 JsonValue DOM 子树。
    public static JsonValue FromDoc(JsonDoc doc) {
        if (doc == null) { return JsonValue.NewNull(); }
        return JsonValue.FromDoc(doc, doc.root);
    }

    // 从 JsonDoc 指定槽位快速物化为 JsonValue DOM 节点（预知容量、零重复语法校验）。
    public static JsonValue FromDoc(JsonDoc doc, int at) {
        if (doc == null || at < 0 || at >= doc.slotCount) { return JsonValue.NewNull(); }
        int k = doc.KindAt(at);
        if (k == 0) { return JsonValue.NewNull(); }
        if (k == 1) { return JsonValue.NewBool(doc.BoolAt(at, false)); }
        if (k == 2) {
            long a = doc.slots[at].a;
            int rawK = (int)(a & 255);
            if (rawK == 7) {
                JsonValue v = JsonValue.NewDouble(doc.DoubleAt(at, 0.0));
                v.numRaw = doc.StrAt(at, "");
                return v;
            }
            return JsonValue.NewInt(doc.LongAt(at, 0L));
        }
        if (k == 3) { return JsonValue.NewStr(doc.StrAt(at, "")); }
        if (k == 4) {
            int n = doc.Count(at);
            JsonValue arr = JsonValue.NewArray();
            if (n == 0) { return arr; }
            arr.items.Reserve(n);
            int c = doc.FirstChild(at);
            for (int i = 0; i < n; i = i + 1) {
                arr.items.Add(JsonValue.FromDoc(doc, c));
                c = doc.NextSibling(c);
            }
            return arr;
        }
        if (k == 5) {
            int n = doc.Count(at);
            JsonValue obj = JsonValue.NewObject();
            if (n == 0) { return obj; }
            obj.keys.Reserve(n);
            obj.vals.Reserve(n);
            int p = (int)(doc.slots[at].a >> 8);
            int seen = 0;
            while (p >= 0 && seen < n) {
                JsonPair pair = doc.pairs[p];
                string key = pair.keyStart < 0 ? doc.escPool[pair.keyLen] : doc.src.Substring(pair.keyStart, pair.keyLen);
                obj.keys.Add(key);
                obj.vals.Add(JsonValue.FromDoc(doc, pair.valueSlot));
                p = pair.nextPair;
                seen = seen + 1;
            }
            return obj;
        }
        return JsonValue.NewNull();
    }

    // 将 JSON 文档解析为值树。基于 JsonDoc Tape 高速扫描索引一次性物化 DOM 树，
    // 预知子容器容量且免除二次语法校验。格式错误时抛出 JsonException。
    public static JsonValue Parse(string src) {
        if (src == null) { throw new JsonException("JSON source cannot be null"); }
        JsonDoc doc = JsonDoc.Parse(src);
        return JsonValue.FromDoc(doc, doc.root);
    }

    // 尽力而为的解析：输入格式错误时返回已解析的部分
    // 而不抛异常（用于手工编写/工具生成的 UI 文档，部分
    // 结果树比异常更合适）。
    public static JsonValue ParseLenient(string src) {
        JsonReader r = JsonReader.Of(src);
        return r.ReadValue();
    }
}
