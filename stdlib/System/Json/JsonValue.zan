using System;
using System.Text;

namespace System.Json;

/// <summary>
/// 解析后的 JSON 值树（object / array / string / number / bool / null）。
///
/// 与 JsonParser 的扁平 key 扫描器不同，这是真正的递归模型，
/// 可以遍历嵌套文档（UI 布局树、状态实体）。用
/// <see cref="Parse"/> 构建；用 As*/类型化字段助手读取标量；
/// 用 Get/Has 遍历对象、At/Count 遍历数组。
///
/// kind：0 null，1 bool，2 number，3 string，4 array，5 object。
/// </summary>
class JsonValue {
    int kind;
    bool boolVal;
    string numRaw;
    string strVal;
    List<JsonValue> items;
    List<string> keys;
    List<JsonValue> vals;

    static JsonValue NewNull() {
        JsonValue v = new JsonValue();
        v.kind = 0;
        return v;
    }

    static JsonValue NewBool(bool b) {
        JsonValue v = new JsonValue();
        v.kind = 1;
        v.boolVal = b;
        return v;
    }

    static JsonValue NewNum(string raw) {
        JsonValue v = new JsonValue();
        v.kind = 2;
        v.numRaw = raw;
        return v;
    }

    static JsonValue NewStr(string s) {
        JsonValue v = new JsonValue();
        v.kind = 3;
        v.strVal = s;
        return v;
    }

    static JsonValue NewArray() {
        JsonValue v = new JsonValue();
        v.kind = 4;
        v.items = new List<JsonValue>();
        return v;
    }

    static JsonValue NewObject() {
        JsonValue v = new JsonValue();
        v.kind = 5;
        v.keys = new List<string>();
        v.vals = new List<JsonValue>();
        return v;
    }

    bool IsNull() { return kind == 0; }
    bool IsBool() { return kind == 1; }
    bool IsNumber() { return kind == 2; }
    bool IsString() { return kind == 3; }
    bool IsArray() { return kind == 4; }
    bool IsObject() { return kind == 5; }

    // ---- 对象访问 -----------------------------------------------------

    /// 追加键值对（对象）。不去重。
    void Put(string key, JsonValue v) {
        keys.Add(key);
        vals.Add(v);
    }

    bool Has(string key) {
        if (kind != 5) { return false; }
        for (int i = 0; i < keys.Count; i = i + 1) {
            if (keys[i] == key) { return true; }
        }
        return false;
    }

    /// `key` 对应的值；不存在或不是对象时返回 null。
    JsonValue Get(string key) {
        if (kind != 5) { return null; }
        for (int i = 0; i < keys.Count; i = i + 1) {
            if (keys[i] == key) { return vals[i]; }
        }
        return null;
    }

    /// 若 `key` 已存在则替换其值，否则追加（对象）。
    void Set(string key, JsonValue v) {
        for (int i = 0; i < keys.Count; i = i + 1) {
            if (keys[i] == key) { vals[i] = v; return; }
        }
        keys.Add(key);
        vals.Add(v);
    }

    /// 从该对象解析点分路径（"user.name"）；任一段
    /// 缺失或不是对象时返回 null。用于双向 `bind` 查找。
    JsonValue PathGet(string path) {
        JsonValue cur = this;
        int start = 0;
        for (int i = 0; i <= path.Length; i = i + 1) {
            bool end = i == path.Length;
            bool dot = false;
            if (!end) { dot = path.Substring(i, 1) == "."; }
            if (end || dot) {
                string seg = path.Substring(start, i - start);
                if (cur == null) { return null; }
                cur = cur.Get(seg);
                start = i + 1;
            }
        }
        return cur;
    }

    /// 沿点分路径写入标量字符串，按需创建中间对象
    /// 和叶子节点，使绑定的控件能把编辑内容回写到状态。
    void PathSet(string path, string val) {
        PathSetValue(path, JsonValue.NewStr(val));
    }

    /// 与 PathSet 类似，但写入任意 JsonValue 叶子，使绑定的控件
    /// 能在回写时保持值的 JSON 类型（bool / number / string），
    /// 而不是全部转成字符串。
    void PathSetValue(string path, JsonValue leaf) {
        JsonValue cur = this;
        int start = 0;
        for (int i = 0; i <= path.Length; i = i + 1) {
            bool end = i == path.Length;
            bool dot = false;
            if (!end) { dot = path.Substring(i, 1) == "."; }
            if (end || dot) {
                string seg = path.Substring(start, i - start);
                if (end) {
                    cur.Set(seg, leaf);
                } else {
                    JsonValue next = cur.Get(seg);
                    if (next == null || !next.IsObject()) {
                        next = JsonValue.NewObject();
                        cur.Set(seg, next);
                    }
                    cur = next;
                }
                start = i + 1;
            }
        }
    }

    // ---- 数组访问 -----------------------------------------------------

    void Append(JsonValue v) { items.Add(v); }

    /// 元素数量（数组元素或对象条目数；其他情况为 0）。
    int Count() {
        if (kind == 4) { return items.Count; }
        if (kind == 5) { return keys.Count; }
        return 0;
    }

    JsonValue At(int i) { return items[i]; }

    /// 第 i 个对象的 key（用于遍历对象）。
    string KeyAt(int i) { return keys[i]; }
    JsonValue ValAt(int i) { return vals[i]; }

    // ---- 带默认值的标量读取器 -----------------------------------------

    /// <summary>将该值序列化为紧凑 JSON 字符串。字符串和
    /// 对象 key 经 Encoding.JsonEscape 转义；数字输出原始
    /// 字面量（空 -> 0）。是 Parse 对值模型的逆操作。</summary>
    string ToJson() {
        StringBuilder sb = new StringBuilder();
        this.WriteTo(sb);
        return sb.ToString();
    }

    void WriteTo(StringBuilder sb) {
        if (kind == 0) { sb.Append("null"); return; }
        if (kind == 1) {
            if (boolVal) { sb.Append("true"); } else { sb.Append("false"); }
            return;
        }
        if (kind == 2) {
            if (numRaw.Length == 0) { sb.Append("0"); } else { sb.Append(numRaw); }
            return;
        }
        if (kind == 3) {
            sb.Append("\"");
            sb.Append(Encoding.JsonEscape(strVal));
            sb.Append("\"");
            return;
        }
        if (kind == 4) {
            sb.Append("[");
            for (int i = 0; i < items.Count; i = i + 1) {
                if (i > 0) { sb.Append(","); }
                items[i].WriteTo(sb);
            }
            sb.Append("]");
            return;
        }
        if (kind == 5) {
            sb.Append("{");
            for (int i = 0; i < keys.Count; i = i + 1) {
                if (i > 0) { sb.Append(","); }
                sb.Append("\"");
                sb.Append(Encoding.JsonEscape(keys[i]));
                sb.Append("\":");
                vals[i].WriteTo(sb);
            }
            sb.Append("}");
            return;
        }
    }

    /// <summary>序列化为便于阅读的多行 JSON 字符串（两空格
    /// 缩进，每个 key 一行），用于手工编辑的交换文件，如
    /// .zform / .zscene。与 ToJson 一样可通过 Parse 往返。</summary>
    string PrettyToJson() {
        StringBuilder sb = new StringBuilder();
        this.WritePretty(sb, 0);
        return sb.ToString();
    }

    void WritePretty(StringBuilder sb, int depth) {
        if (kind == 5) {
            if (keys.Count == 0) { sb.Append("{}"); return; }
            sb.Append("{\n");
            for (int i = 0; i < keys.Count; i = i + 1) {
                sb.Append(JsonValue.PrettyIndent(depth + 1));
                sb.Append("\"");
                sb.Append(Encoding.JsonEscape(keys[i]));
                sb.Append("\": ");
                vals[i].WritePretty(sb, depth + 1);
                if (i < keys.Count - 1) { sb.Append(","); }
                sb.Append("\n");
            }
            sb.Append(JsonValue.PrettyIndent(depth));
            sb.Append("}");
            return;
        }
        if (kind == 4) {
            if (items.Count == 0) { sb.Append("[]"); return; }
            sb.Append("[\n");
            for (int i = 0; i < items.Count; i = i + 1) {
                sb.Append(JsonValue.PrettyIndent(depth + 1));
                items[i].WritePretty(sb, depth + 1);
                if (i < items.Count - 1) { sb.Append(","); }
                sb.Append("\n");
            }
            sb.Append(JsonValue.PrettyIndent(depth));
            sb.Append("]");
            return;
        }
        this.WriteTo(sb);
    }

    static string PrettyIndent(int depth) {
        string s = "";
        for (int i = 0; i < depth; i = i + 1) { s = s + "  "; }
        return s;
    }

    static int Digit(string ch) {
        if (ch == "0") { return 0; }
        if (ch == "1") { return 1; }
        if (ch == "2") { return 2; }
        if (ch == "3") { return 3; }
        if (ch == "4") { return 4; }
        if (ch == "5") { return 5; }
        if (ch == "6") { return 6; }
        if (ch == "7") { return 7; }
        if (ch == "8") { return 8; }
        if (ch == "9") { return 9; }
        return -1;
    }

    /// 解析数字 token 的前导（可选符号）整数部分，
    /// 在 '.'/'e' 处停止。避免 "60.0"/"1e3" 触发 Convert 异常。
    static int IntOf(string t) {
        int n = t.Length;
        int i = 0;
        bool neg = false;
        if (n > 0 && (t[0] & 255) == 45) { neg = true; i = 1; }
        int acc = 0;
        while (i < n) {
            int d = (t[i] & 255) - 48;
            if (d < 0 || d > 9) { break; }
            acc = acc * 10 + d;
            i = i + 1;
        }
        if (neg) { return 0 - acc; }
        return acc;
    }

    /// 与 IntOf 类似，但按 64 位累加，使 `long`/`ulong` 字段能保存
    /// 超出 32 位范围的值。
    static long LongOf(string t) {
        int n = t.Length;
        int i = 0;
        bool neg = false;
        if (n > 0 && (t[0] & 255) == 45) { neg = true; i = 1; }
        long acc = 0;
        while (i < n) {
            int d = (t[i] & 255) - 48;
            if (d < 0 || d > 9) { break; }
            acc = acc * 10 + (long)d;
            i = i + 1;
        }
        if (neg) { return 0 - acc; }
        return acc;
    }

    /// 无需 Convert 解析数字 token（符号、小数、指数），
    /// 避免异常；非数字前缀时返回 0.0。
    static double DoubleOf(string t) {
        int n = t.Length;
        int i = 0;
        bool neg = false;
        if (n > 0 && (t[0] & 255) == 45) { neg = true; i = 1; }
        else if (n > 0 && (t[0] & 255) == 43) { i = 1; }
        double acc = 0.0;
        while (i < n) {
            int d = (t[i] & 255) - 48;
            if (d < 0 || d > 9) { break; }
            acc = acc * 10.0 + (double)d;
            i = i + 1;
        }
        if (i < n && (t[i] & 255) == 46) {
            i = i + 1;
            double scale = 0.1;
            while (i < n) {
                int d = (t[i] & 255) - 48;
                if (d < 0 || d > 9) { break; }
                acc = acc + (double)d * scale;
                scale = scale * 0.1;
                i = i + 1;
            }
        }
        if (i < n && ((t[i] & 255) == 101 || (t[i] & 255) == 69)) {
            i = i + 1;
            bool eneg = false;
            if (i < n && (t[i] & 255) == 45) { eneg = true; i = i + 1; }
            else if (i < n && (t[i] & 255) == 43) { i = i + 1; }
            int ex = 0;
            while (i < n) {
                int d = (t[i] & 255) - 48;
                if (d < 0 || d > 9) { break; }
                ex = ex * 10 + d;
                i = i + 1;
            }
            for (int k = 0; k < ex; k = k + 1) {
                if (eneg) { acc = acc / 10.0; } else { acc = acc * 10.0; }
            }
        }
        if (neg) { return 0.0 - acc; }
        return acc;
    }

    string AsString(string dflt) {
        if (kind == 3) { return strVal; }
        if (kind == 2) { return numRaw; }
        if (kind == 1) { if (boolVal) { return "true"; } return "false"; }
        return dflt;
    }

    int AsInt(int dflt) {
        if (kind == 2) { return JsonValue.IntOf(numRaw); }
        if (kind == 1) { if (boolVal) { return 1; } return 0; }
        if (kind == 3) { return JsonValue.IntOf(strVal); }
        return dflt;
    }

    long AsLong(long dflt) {
        if (kind == 2) { return JsonValue.LongOf(numRaw); }
        if (kind == 1) { if (boolVal) { return 1; } return 0; }
        if (kind == 3) { return JsonValue.LongOf(strVal); }
        return dflt;
    }

    double AsDouble(double dflt) {
        if (kind == 2) { return JsonValue.DoubleOf(numRaw); }
        if (kind == 1) { if (boolVal) { return 1.0; } return 0.0; }
        if (kind == 3) { return JsonValue.DoubleOf(strVal); }
        return dflt;
    }

    bool AsBool(bool dflt) {
        if (kind == 1) { return boolVal; }
        if (kind == 2) { return JsonValue.IntOf(numRaw) != 0; }
        if (kind == 3) { return strVal == "true"; }
        return dflt;
    }

    // ---- 类型化字段助手（对象 + key） -----------------------------------

    string Str(string key, string dflt) {
        JsonValue v = Get(key);
        if (v == null) { return dflt; }
        return v.AsString(dflt);
    }

    int Int(string key, int dflt) {
        JsonValue v = Get(key);
        if (v == null) { return dflt; }
        return v.AsInt(dflt);
    }

    /// 点分路径的类型化读取：路径上任何一段缺失（PathGet 返回 null）都
    /// 退回 `dflt`，而不是让调用方对 null 调 AsString/AsInt 而崩溃。
    string PathStr(string path, string dflt) {
        JsonValue v = PathGet(path);
        if (v == null) { return dflt; }
        return v.AsString(dflt);
    }

    /// 同 PathStr，整数版。
    int PathInt(string path, int dflt) {
        JsonValue v = PathGet(path);
        if (v == null) { return dflt; }
        return v.AsInt(dflt);
    }

    long Long(string key, long dflt) {
        JsonValue v = Get(key);
        if (v == null) { return dflt; }
        return v.AsLong(dflt);
    }

    bool Bool(string key, bool dflt) {
        JsonValue v = Get(key);
        if (v == null) { return dflt; }
        return v.AsBool(dflt);
    }

    double Double(string key, double dflt) {
        JsonValue v = Get(key);
        if (v == null) { return dflt; }
        return v.AsDouble(dflt);
    }

    // ---- 解析 -----------------------------------------------------------

    /// 将 JSON 文档解析为值树。格式错误时抛出
    /// JsonException（与 C# 一致）。先用一次
    /// 零分配扫描校验文档，再构建树，因此错误路径不会
    /// 持有任何存活分配。
    static JsonValue Parse(string src) {
        int errPos = JsonReader.FirstErrorPos(src);
        if (errPos >= 0) {
            throw new JsonException("Malformed JSON at position "
                + Convert.ToString(errPos));
        }
        JsonReader r = JsonReader.Of(src);
        return r.ReadValue();
    }

    /// 尽力而为的解析：输入格式错误时返回已解析的部分
    /// 而不抛异常（用于手工编写/工具生成的 UI 文档，部分
    /// 结果树比异常更合适）。
    static JsonValue ParseLenient(string src) {
        JsonReader r = JsonReader.Of(src);
        return r.ReadValue();
    }
}

/// 驱动 JsonValue.Parse 的源字符串游标（Zan 没有
/// ref/out 参数，所以位置保存在该对象上）。
class JsonReader {
    string s;
    int pos;
    int len;
    /// 递归解析/校验的最大嵌套深度。深层嵌套文档会耗尽
    /// 调用栈（约 20-40 万层时解析器崩溃），必须显式限制。
    static int MaxDepth = 512;

    static JsonReader Of(string src) {
        JsonReader r = new JsonReader();
        r.s = src;
        r.pos = 0;
        r.len = src.Length;
        return r;
    }

    /// 游标处的字节，输入结束时为 -1。
    int CurB() {
        if (pos >= len) { return -1; }
        return s[pos] & 255;
    }

    void SkipWs() {
        while (pos < len) {
            int c = s[pos] & 255;
            if (c == 32 || c == 9 || c == 10 || c == 13) {
                pos = pos + 1;
            } else {
                return;
            }
        }
    }

    JsonValue ReadValue() {
        return ReadValueAt(0);
    }

    JsonValue ReadValueAt(int depth) {
        if (depth > JsonReader.MaxDepth) { return JsonValue.NewNull(); }
        SkipWs();
        int c = CurB();
        if (c == 123) { return ReadObjectAt(depth); }              // '{'
        if (c == 91) { return ReadArrayAt(depth); }                // '['
        if (c == 34) { return JsonValue.NewStr(ReadString()); }
        if (c == 116 || c == 102) { return ReadBool(); }    // 't' / 'f'
        if (c == 110) { pos = pos + 4; return JsonValue.NewNull(); }
        return ReadNumber();
    }

    JsonValue ReadObjectAt(int depth) {
        JsonValue obj = JsonValue.NewObject();
        pos = pos + 1;                 // 消费 '{'
        SkipWs();
        if (CurB() == 125) { pos = pos + 1; return obj; }   // '}'
        while (pos < len) {
            SkipWs();
            string key = ReadString();
            SkipWs();
            if (CurB() == 58) { pos = pos + 1; }            // ':'
            JsonValue v = ReadValueAt(depth + 1);
            obj.Put(key, v);
            SkipWs();
            int c = CurB();
            if (c == 44) { pos = pos + 1; }                 // ','
            else if (c == 125) { pos = pos + 1; return obj; } // '}'
            else { return obj; }
        }
        return obj;
    }

    JsonValue ReadArrayAt(int depth) {
        JsonValue arr = JsonValue.NewArray();
        pos = pos + 1;                 // 消费 '['
        SkipWs();
        if (CurB() == 93) { pos = pos + 1; return arr; }    // ']'
        while (pos < len) {
            JsonValue v = ReadValueAt(depth + 1);
            arr.Append(v);
            SkipWs();
            int c = CurB();
            if (c == 44) { pos = pos + 1; }                 // ','
            else if (c == 93) { pos = pos + 1; return arr; } // ']'
            else { return arr; }
        }
        return arr;
    }

    /// 从起始引号读取带引号的字符串；解码常见
    /// 转义。结束后 pos 位于闭合引号之后。无转义的字符串
    /// （最常见的情况）作为单个子串返回；
    /// 含转义的字符串则回退到 StringBuilder，批量复制
    /// 转义之间的普通片段。
    string ReadString() {
        if (CurB() != 34) { return ""; }
        pos = pos + 1;                 // 消费起始引号
        int start = pos;
        while (pos < len) {
            int c = s[pos] & 255;
            if (c == 34) {
                string plain = s.Substring(start, pos - start);
                pos = pos + 1;
                return plain;
            }
            if (c == 92) { break; }    // '\' -> 转义路径
            pos = pos + 1;
        }
        StringBuilder sb = new StringBuilder();
        if (pos > start) { sb.Append(s.Substring(start, pos - start)); }
        while (pos < len) {
            int c = s[pos] & 255;
            if (c == 34) { pos = pos + 1; return sb.ToString(); }
            if (c == 92 && pos + 1 < len) {
                int n = s[pos + 1] & 255;
                if (n == 110) { sb.Append("\n"); }
                else if (n == 116) { sb.Append("\t"); }
                else if (n == 114) { sb.Append("\r"); }
                else if (n == 34) { sb.Append("\""); }
                else if (n == 92) { sb.Append("\\"); }
                else if (n == 47) { sb.Append("/"); }
                else if (n == 98) { sb.Append(Encoding.CharFromCode(8)); }
                else if (n == 102) { sb.Append(Encoding.CharFromCode(12)); }
                else if (n == 117) {
                    // \uXXXX：以 UTF-8 输出（含代理对）。很多客户端默认
                    // 把所有非 ASCII 字符发成 \uXXXX（Python json.dumps 的
                    // ensure_ascii=True 就是这样），不解码就会把
                    // "\u4e2d\u6587" 变成字面量 "u4e2du6587"。
                    pos = pos + 2;
                    int cp = JsonReader.Hex4(s, pos, len);
                    if (cp < 0) { sb.Append("u"); continue; }
                    pos = pos + 4;
                    if (cp >= 55296 && cp <= 56319 && pos + 5 < len
                        && (s[pos] & 255) == 92 && (s[pos + 1] & 255) == 117) {
                        int lo = JsonReader.Hex4(s, pos + 2, len);
                        if (lo >= 56320 && lo <= 57343) {
                            cp = 65536 + ((cp - 55296) << 10) + (lo - 56320);
                            pos = pos + 6;
                        }
                    }
                    if (cp == 0) {
                        // Zan 字符串以 NUL 结尾，装不下 U+0000：静默丢掉
                        // 会让写文件的内容与客户端发的不一致，因此明确
                        // 报错，让调用方改用 base64 通道传二进制。
                        throw new JsonException(
                            "\\u0000 cannot be represented in a string; "
                            + "send binary content as base64");
                    }
                    sb.Append(Encoding.Utf8FromCodePoint(cp));
                    continue;
                }
                else { sb.Append(s.Substring(pos + 1, 1)); }
                pos = pos + 2;
            } else {
                int run = pos;
                while (run < len) {
                    int c2 = s[run] & 255;
                    if (c2 == 34 || c2 == 92) { break; }
                    run = run + 1;
                }
                sb.Append(s.Substring(pos, run - pos));
                pos = run;
            }
        }
        return sb.ToString();
    }

    /// 从 `at` 开始的 4 位十六进制值；不足 4 位或含非十六进制
    /// 字符时返回 -1。
    static int Hex4(string src, int at, int limit) {
        if (at + 4 > limit) { return -1; }
        int acc = 0;
        for (int i = 0; i < 4; i = i + 1) {
            int d = Encoding.HexDigit(src[at + i] & 255);
            if (d < 0) { return -1; }
            acc = acc * 16 + d;
        }
        return acc;
    }

    JsonValue ReadBool() {
        if (CurB() == 116) { pos = pos + 4; return JsonValue.NewBool(true); }
        pos = pos + 5;                 // "false"
        return JsonValue.NewBool(false);
    }

    JsonValue ReadNumber() {
        int start = pos;
        while (pos < len) {
            int c = s[pos] & 255;
            if ((c >= 48 && c <= 57) || c == 45 || c == 43 || c == 46
                || c == 101 || c == 69) {   // digits - + . e E
                pos = pos + 1;
            } else {
                return JsonValue.NewNum(s.Substring(start, pos - start));
            }
        }
        return JsonValue.NewNum(s.Substring(start, pos - start));
    }

    // ---- 校验（JsonValue.Parse 使用的零分配扫描） -----------------------

    /// `src` 中首个语法错误的位置；有效时返回 -1
    /// 的 JSON。正常返回，调用者可抛出异常而不必在
    /// 栈帧中保留 reader 对象（异常回退目前不会释放局部变量）。
    static int FirstErrorPos(string src) {
        JsonReader v = JsonReader.Of(src);
        if (v.ValidDocument()) { return -1; }
        return v.pos;
    }

    /// 不分配任何值地扫描整个文档以校验 JSON 语法；
    /// 失败时游标停留在出错位置。
    bool ValidDocument() {
        if (!ValidValue()) { return false; }
        SkipWs();
        return pos >= len;
    }

    bool ValidValue() {
        return ValidValueAt(0);
    }

    bool ValidValueAt(int depth) {
        if (depth > JsonReader.MaxDepth) { return false; }
        SkipWs();
        int c = CurB();
        if (c == 123) { return ValidObjectAt(depth); }          // '{'
        if (c == 91) { return ValidArrayAt(depth); }            // '['
        if (c == 34) { return ValidString(); }
        if (c == 116) { return ValidLiteral("true"); }
        if (c == 102) { return ValidLiteral("false"); }
        if (c == 110) { return ValidLiteral("null"); }
        return ValidNumber();
    }

    bool ValidLiteral(string lit) {
        int n = lit.Length;
        if (pos + n > len) { return false; }
        if (s.Substring(pos, n) != lit) { return false; }
        pos = pos + n;
        return true;
    }

    bool ValidObjectAt(int depth) {
        pos = pos + 1;                 // 消费 '{'
        SkipWs();
        if (CurB() == 125) { pos = pos + 1; return true; }  // '}'
        while (pos < len) {
            SkipWs();
            if (CurB() != 34) { return false; }
            if (!ValidString()) { return false; }
            SkipWs();
            if (CurB() != 58) { return false; }             // ':'
            pos = pos + 1;
            if (!ValidValueAt(depth + 1)) { return false; }
            SkipWs();
            int c = CurB();
            if (c == 44) { pos = pos + 1; }                 // ','
            else if (c == 125) { pos = pos + 1; return true; } // '}'
            else { return false; }
        }
        return false;
    }

    bool ValidArrayAt(int depth) {
        pos = pos + 1;                 // 消费 '['
        SkipWs();
        if (CurB() == 93) { pos = pos + 1; return true; }   // ']'
        while (pos < len) {
            if (!ValidValueAt(depth + 1)) { return false; }
            SkipWs();
            int c = CurB();
            if (c == 44) { pos = pos + 1; }                 // ','
            else if (c == 93) { pos = pos + 1; return true; } // ']'
            else { return false; }
        }
        return false;
    }

    bool ValidString() {
        if (CurB() != 34) { return false; }
        pos = pos + 1;                 // 消费起始引号
        while (pos < len) {
            int c = s[pos] & 255;
            if (c == 34) { pos = pos + 1; return true; }
            if (c == 92) {
                if (pos + 1 >= len) { return false; }
                int e = s[pos + 1] & 255;
                // 合法转义：" \ / b f n r t u；\u 后面必须跟 4 位十六进制。
                if (e == 117) {
                    if (JsonReader.Hex4(s, pos + 2, len) < 0) { return false; }
                    pos = pos + 6;
                    continue;
                }
                if (e != 34 && e != 92 && e != 47 && e != 98 && e != 102
                    && e != 110 && e != 114 && e != 116) {
                    return false;
                }
                pos = pos + 2;
            } else {
                pos = pos + 1;
            }
        }
        return false;                  // 未闭合
    }

    bool ValidNumber() {
        int c = CurB();
        if (c == 45) { pos = pos + 1; c = CurB(); }         // '-'
        if (c < 48 || c > 57) { return false; }             // 必须以数字开头
        while (pos < len) {
            int d = s[pos] & 255;
            if (d >= 48 && d <= 57) { pos = pos + 1; }
            else { break; }
        }
        if (CurB() == 46) {                                 // '.'
            pos = pos + 1;
            int d = CurB();
            if (d < 48 || d > 57) { return false; }
            while (pos < len) {
                int d2 = s[pos] & 255;
                if (d2 >= 48 && d2 <= 57) { pos = pos + 1; }
                else { break; }
            }
        }
        int e = CurB();
        if (e == 101 || e == 69) {                          // 'e' / 'E'
            pos = pos + 1;
            int d = CurB();
            if (d == 43 || d == 45) { pos = pos + 1; d = CurB(); }
            if (d < 48 || d > 57) { return false; }
            while (pos < len) {
                int d2 = s[pos] & 255;
                if (d2 >= 48 && d2 <= 57) { pos = pos + 1; }
                else { break; }
            }
        }
        return true;
    }
}
