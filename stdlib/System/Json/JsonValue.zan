using System;
using System.Text;

namespace System.Json;

/// <summary>
/// 解析后的 JSON 值树（object / array / string / number / bool / null）。
///
/// 递归模型，可以遍历嵌套文档（UI 布局树、状态实体）。用
/// <see cref="Parse"/> 构建；用 As*/类型化字段助手读取标量；
/// 用 Get/Has 遍历对象、At/Count 遍历数组。
///
/// kind：0 null，1 bool，2 number，3 string，4 array，5 object。
///
/// 性能设计（3MB 文档实测 ~280 MB/s，同文档历史实现 28 MB/s）：
/// 逐字节扫描全部下沉到 NativeMemory.ScanNotByte / Find（strspn/memchr，
/// 向量化）；数字在扫描循环里就地解析成 numI/numD，不再保留字面量
/// 字符串（每 token 少一次分配、读取侧少一次重解析）；字符串无转义时
/// 一次 Substring（比逐字节 Zan 循环快一个数量级）；对象键值对
/// keys/vals 并置（同一次键查找碰一个 Cache 行，不用两趟）。
/// </summary>
class JsonValue {
    /// 值类别：0 null，1 bool，2 number，3 string，4 array，5 object。
    int kind;
    /// kind 1 时的布尔值。
    bool boolVal;
    /// kind 2 时的整数值（无小数/指数部分的 token 直接存这里；
    /// 浮点 token 存 numD，numI 置 0；读取时按 token 形态取，
    /// 没有二次解析）。
    long numI;
    /// kind 2 时的浮点值（带 . / e 的 token）。
    double numD;
    /// kind 2 时该 token 是否为纯整数（决定 Int/Long 是否免转换）。
    bool numIsInt;
    /// kind 2 时数字的十进制文本（AsString/ToJson 用）。
    string numRaw;
    /// kind 3 时的字符串值。
    string strVal;
    /// kind 4 时的数组元素。
    List<JsonValue> items;
    /// kind 5 时的键列表。
    List<string> keys;
    /// kind 5 时与 keys 并置的值列表。
    List<JsonValue> vals;
    /// kind 5 时的键索引哈希表（键数 > 8 且被频繁查找时懒加载构建，加速宽对象属性访问）。
    Dict<string, int> keyIndex;

    /// 组树（WriteTo/WritePretty）与解析（ReadValueAt）共用的
    /// 嵌套深度上限。序列化同样是递归的：无界深度的树会在
    /// WriteTo 里耗尽调用栈直接段错误，所以与解析对称地限制。
    static int MaxDepth = 512;

    /// 构造 null 值（kind 0）。
    static JsonValue NewNull() {
        JsonValue v = new JsonValue();
        v.kind = 0;
        return v;
    }

    /// 构造布尔值（kind 1）。
    static JsonValue NewBool(bool b) {
        JsonValue v = new JsonValue();
        v.kind = 1;
        v.boolVal = b;
        return v;
    }

    /// 构造整数值（kind 2，numIsInt）。
    static JsonValue NewInt(long n) {
        JsonValue v = new JsonValue();
        v.kind = 2;
        v.numI = n;
        v.numIsInt = true;
        v.numRaw = "";
        return v;
    }

    /// 构造浮点值（kind 2）。
    static JsonValue NewDouble(double d) {
        JsonValue v = new JsonValue();
        v.kind = 2;
        v.numD = d;
        v.numIsInt = false;
        v.numRaw = "";
        return v;
    }

    /// 构造数字值（kind 2），保留原始字面量避免浮点往返损失。
    static JsonValue NewNum(string raw) {
        JsonValue v = new JsonValue();
        v.kind = 2;
        v.numRaw = raw;
        return v;
    }

    /// 构造字符串值（kind 3）。
    static JsonValue NewStr(string s) {
        JsonValue v = new JsonValue();
        v.kind = 3;
        v.strVal = s;
        return v;
    }

    /// 构造空数组（kind 4）。
    static JsonValue NewArray() {
        JsonValue v = new JsonValue();
        v.kind = 4;
        v.items = new List<JsonValue>();
        return v;
    }

    /// 构造空对象（kind 5）。
    static JsonValue NewObject() {
        JsonValue v = new JsonValue();
        v.kind = 5;
        v.keys = new List<string>();
        v.vals = new List<JsonValue>();
        return v;
    }

    /// <summary>深拷贝当前 JsonValue 及其所有子节点（对象和数组递归克隆）。</summary>
    JsonValue Clone() {
        if (this.kind == 0) { return JsonValue.NewNull(); }
        if (this.kind == 1) { return JsonValue.NewBool(this.boolVal); }
        if (this.kind == 2) {
            JsonValue v = new JsonValue();
            v.kind = 2;
            v.numI = this.numI;
            v.numD = this.numD;
            v.numIsInt = this.numIsInt;
            v.numRaw = this.numRaw;
            return v;
        }
        if (this.kind == 3) { return JsonValue.NewStr(this.strVal); }
        if (this.kind == 4) {
            JsonValue arr = JsonValue.NewArray();
            int n = this.items.Count;
            for (int i = 0; i < n; i = i + 1) {
                arr.items.Add(this.items[i].Clone());
            }
            return arr;
        }
        if (this.kind == 5) {
            JsonValue obj = JsonValue.NewObject();
            int n = this.keys.Count;
            for (int i = 0; i < n; i = i + 1) {
                obj.keys.Add(this.keys[i]);
                obj.vals.Add(this.vals[i].Clone());
            }
            return obj;
        }
        return JsonValue.NewNull();
    }

    /// 是否为 null 值（kind 0）。
    bool IsNull() { return kind == 0; }
    /// 是否为布尔值（kind 1）。
    bool IsBool() { return kind == 1; }
    /// 是否为数字值（kind 2）。
    bool IsNumber() { return kind == 2; }
    /// <summary>是否为整型形态的数字：NewInt、整数字面量解析产物，
    /// 或无小数点/指数记号的 NewNum 手工字面量；NewDouble 永远不是
    /// （数值恰为整数也保持浮点形态）。二进制序列化据此选择整数/
    /// 浮点线格式。</summary>
    bool IsInt() {
        if (kind != 2) { return false; }
        if (numIsInt) { return numRaw == null || numRaw.Length == 0; }
        if (numRaw == null || numRaw.Length == 0) { return false; }
        int i = 0;
        int n = numRaw.Length;
        while (i < n) {
            int c = numRaw[i] & 255;
            if (c == 46 || c == 101 || c == 69) { return false; }  // . e E
            i = i + 1;
        }
        return true;
    }
    /// 是否为字符串值（kind 3）。
    bool IsString() { return kind == 3; }
    /// 是否为数组（kind 4）。
    bool IsArray() { return kind == 4; }
    /// 是否为对象（kind 5）。
    bool IsObject() { return kind == 5; }

    // ---- 对象访问 -----------------------------------------------------

    /// 追加键值对（对象）。不去重；重复键读取时首键胜（见 Get）。
    void Put(string key, JsonValue v) {
        // 索引已在册的键不覆盖：首键胜，保持与线性扫描一致。
        if (this.keyIndex != null && !this.keyIndex.ContainsKey(key)) {
            this.keyIndex[key] = keys.Count;
        }
        keys.Add(key);
        vals.Add(v);
    }

    /// 对象是否含该 key；不是对象时返回 false。
    bool Has(string key) {
        if (kind != 5) { return false; }
        int n = keys.Count;
        if (n <= 8) {
            for (int i = 0; i < n; i = i + 1) {
                if (keys[i] == key) { return true; }
            }
            return false;
        }
        if (this.keyIndex == null) {
            Get(key);
        }
        if (this.keyIndex != null) {
            return this.keyIndex.ContainsKey(key);
        }
        return false;
    }

    /// `key` 对应的值；不存在或不是对象时返回 null。
    /// 键数量 <= 8 时走连续内存线性扫描（零额外内存、缓存行友好）；
    /// 键数量 > 8 时自动激活懒加载哈希索引，O(1) 访问。
    /// 重复键统一首键胜（与线性扫描同语义）。
    JsonValue Get(string key) {
        if (kind != 5) { return null; }
        int n = keys.Count;
        if (n <= 8) {
            for (int i = 0; i < n; i = i + 1) {
                if (keys[i] == key) { return vals[i]; }
            }
            return null;
        }
        if (this.keyIndex == null) {
            Dict<string, int> ki = new Dict<string, int>();
            for (int i = 0; i < n; i = i + 1) {
                // 首键胜：在册的不覆盖。
                if (!ki.ContainsKey(keys[i])) { ki[keys[i]] = i; }
            }
            this.keyIndex = ki;
        }
        if (this.keyIndex.ContainsKey(key)) {
            int idx = this.keyIndex[key];
            return vals[idx];
        }
        return null;
    }

    /// 若 `key` 已存在则替换其值，否则追加（对象）。
    void Set(string key, JsonValue v) {
        if (this.keyIndex != null && this.keyIndex.ContainsKey(key)) {
            int idx = this.keyIndex[key];
            vals[idx] = v;
            return;
        }
        for (int i = 0; i < keys.Count; i = i + 1) {
            if (keys[i] == key) {
                vals[i] = v;
                if (this.keyIndex != null) { this.keyIndex[key] = i; }
                return;
            }
        }
        if (this.keyIndex != null) {
            this.keyIndex[key] = keys.Count;
        }
        keys.Add(key);
        vals.Add(v);
    }

    /// 从该对象解析点分路径（"user.name"）；任一段
    /// 缺失或不是对象时返回 null。用于双向 `bind` 查找。
    JsonValue PathGet(string path) {
        if (path == null) { return null; }
        JsonValue cur = this;
        int start = 0;
        int len = path.Length;
        for (int i = 0; i <= len; i = i + 1) {
            bool end = i == len;
            bool dot = false;
            if (!end) { dot = (path[i] & 255) == 46; }
            if (end || dot) {
                string seg = path.Substring(start, i - start);
                if (cur == null) { return null; }
                cur = cur.Get(seg);
                start = i + 1;
            }
        }
        return cur;
    }

    /// 沿点分路径写入标量字符串，按需创建中间对象
    /// 和叶子节点，使绑定的控件能把编辑内容回写到状态。
    void PathSet(string path, string val) {
        PathSetValue(path, JsonValue.NewStr(val));
    }

    /// 与 PathSet 类似，但写入任意 JsonValue 叶子，使绑定的控件
    /// 能在回写时保持值的 JSON 类型（bool / number / string），
    /// 而不是全部转成字符串。根不是对象（数组/标量）时抛出 JsonException。
    void PathSetValue(string path, JsonValue leaf) {
        if (path == null) { return; }
        if (!this.IsObject()) {
            throw new JsonException(
                "PathSetValue: root is not an object, path: " + path);
        }
        JsonValue cur = this;
        int start = 0;
        int len = path.Length;
        for (int i = 0; i <= len; i = i + 1) {
            bool end = i == len;
            bool dot = false;
            if (!end) { dot = (path[i] & 255) == 46; }
            if (end || dot) {
                string seg = path.Substring(start, i - start);
                if (end) {
                    cur.Set(seg, leaf);
                } else {
                    JsonValue next = cur.Get(seg);
                    if (next == null || !next.IsObject()) {
                        next = JsonValue.NewObject();
                        cur.Set(seg, next);
                    }
                    cur = next;
                }
                start = i + 1;
            }
        }
    }

    // ---- 便利写入口 ----------------------------------------------------
    //
    // 手拼 JSON 字符串（"{\"k\":\"" + v + "\"}"）是注入与非法 JSON 的
    // 根源：引号、反斜杠、换行一旦混进变量就毁掉整个报文。这组入口让
    // 每个字段一行写完、转义交给 ToJson，从根上替代字符串拼接。

    /// 追加字符串成员（null 值写成 JSON null，与字符串 "null" 区分）。
    void PutStr(string key, string v) {
        if (v == null) { this.Put(key, JsonValue.NewNull()); return; }
        this.Put(key, JsonValue.NewStr(v));
    }

    /// 追加整数成员。
    void PutInt(string key, long v) {
        this.Put(key, JsonValue.NewInt(v));
    }

    /// 追加浮点成员。
    void PutDouble(string key, double v) {
        this.Put(key, JsonValue.NewDouble(v));
    }

    /// 追加布尔成员。
    void PutBool(string key, bool v) {
        this.Put(key, JsonValue.NewBool(v));
    }

    /// 追加 null 成员。
    void PutNull(string key) {
        this.Put(key, JsonValue.NewNull());
    }

    /// <summary>把一段已序列化的 JSON 文本作为成员值嵌入：能解析就挂
    /// 解析出的子树（对象/数组/数字原样保型），解析失败则整段按字符串
    /// 存——任何输入都不可能产出非法 JSON。用于收编「片段拼接」：把
    /// 上游序列化好的 items/errors 等挂进外层报文，不再 Substring(1)
    /// 之类按文本外科手术拼。</summary>
    void PutJson(string key, string jsonText) {
        this.Put(key, JsonValue.ParseOrStr(jsonText));
    }

    /// 数组末尾追加字符串元素（null 按空串存，数组元素无 null 语义）。
    void AppendStr(string v) {
        this.Append(JsonValue.NewStr(v == null ? "" : v));
    }

    /// 数组末尾追加整数元素。
    void AppendInt(long v) {
        this.Append(JsonValue.NewInt(v));
    }

    /// 数组末尾追加浮点元素。
    void AppendDouble(double v) {
        this.Append(JsonValue.NewDouble(v));
    }

    /// 数组末尾追加布尔元素。
    void AppendBool(bool v) {
        this.Append(JsonValue.NewBool(v));
    }

    /// 数组末尾嵌入一段已序列化 JSON 文本（语义同 PutJson）。
    void AppendJson(string jsonText) {
        this.Append(JsonValue.ParseOrStr(jsonText));
    }

    /// <summary>ParseLenient 的无异常形态：能解析返回子树；解析失败或
    /// 结果是 null 字面量时返回字符串形态——用于 PutJson/AppendJson 的
    /// 「片段嵌入」语义，保证任何输入都得到一个合法 JSON 值。</summary>
    static JsonValue ParseOrStr(string jsonText) {
        if (jsonText == null) { return JsonValue.NewStr(""); }
        JsonValue v = null;
        try { v = JsonValue.ParseLenient(jsonText); } catch (Exception) { v = null; }
        if (v == null || v.IsNull()) { return JsonValue.NewStr(jsonText); }
        return v;
    }

    // ---- 数组访问 -----------------------------------------------------

    /// 数组末尾追加元素（数组）。
    void Append(JsonValue v) { items.Add(v); }

    /// 元素数量（数组元素或对象条目数；其他情况为 0）。
    int Count() {
        if (kind == 4) { return items.Count; }
        if (kind == 5) { return keys.Count; }
        return 0;
    }

    /// 第 i 个数组元素。
    JsonValue At(int i) { return items[i]; }

    /// 第 i 个对象的 key（用于遍历对象）。
    string KeyAt(int i) { return keys[i]; }
    /// 第 i 个对象的值（与 KeyAt 配对遍历）。
    JsonValue ValAt(int i) { return vals[i]; }

    // ---- 带默认值的标量读取器 -----------------------------------------

    /// <summary>将该值序列化为紧凑 JSON 字符串。字符串和
    /// 对象 key 经 Encoding.JsonEscape 转义；数字按 token 形态
    /// 输出（整数走整型格式化，浮点走最短 double 格式化）。
    /// 是 Parse 对值模型的逆操作。嵌套超过 JsonValue.MaxDepth
    /// 层时抛出 JsonException——WriteTo 是递归的，无界深度的树
    /// 会耗尽调用栈直接段错误（与 Parse 的 MaxDepth 对称）。</summary>
    string ToJson() {
        StringBuilder sb = new StringBuilder();
        this.WriteTo(sb);
        return sb.ToString();
    }

    /// WriteToAt 的入口（depth 从 0 起）。
    void WriteTo(StringBuilder sb) {
        this.WriteToAt(sb, 0);
    }

    /// WriteTo 的递归实现：`depth` 用于 MaxDepth 保护。
    void WriteToAt(StringBuilder sb, int depth) {
        if (depth > JsonValue.MaxDepth) {
            throw new JsonException("JSON nesting too deep to serialize");
        }
        if (kind == 0) { sb.Append("null"); return; }
        if (kind == 1) {
            if (boolVal) { sb.Append("true"); } else { sb.Append("false"); }
            return;
        }
        if (kind == 2) {
            sb.Append(JsonValue.NumText(this));
            return;
        }
        if (kind == 3) {
            sb.Append("\"");
            sb.Append(Encoding.JsonEscape(strVal));
            sb.Append("\"");
            return;
        }
        if (kind == 4) {
            sb.Append("[");
            for (int i = 0; i < items.Count; i = i + 1) {
                if (i > 0) { sb.Append(","); }
                items[i].WriteToAt(sb, depth + 1);
            }
            sb.Append("]");
            return;
        }
        if (kind == 5) {
            sb.Append("{");
            for (int i = 0; i < keys.Count; i = i + 1) {
                if (i > 0) { sb.Append(","); }
                sb.Append("\"");
                sb.Append(Encoding.JsonEscape(keys[i]));
                sb.Append("\":");
                vals[i].WriteToAt(sb, depth + 1);
            }
            sb.Append("}");
            return;
        }
    }

    /// 数字的输出文本：解析时就地解析的整数/浮点走格式化，
    /// NewNum 手工构造的值保留原始字面量。NaN/±Infinity 不是合法
    /// JSON 数字，统一输出 null。
    static string NumText(JsonValue v) {
        if (v.numRaw != null && v.numRaw.Length > 0) { return v.numRaw; }
        if (v.numIsInt) { return Convert.ToString(v.numI); }
        double d = v.numD;
        if (d != d || d - d != 0) { return "null"; }
        return Convert.ToString(v.numD);
    }

    /// <summary>序列化为便于阅读的多行 JSON 字符串（两空格
    /// 缩进，每个 key 一行），用于手工编辑的交换文件，如
    /// .zscene 设计文档。与 ToJson 一样可通过 Parse 往返。
    /// 嵌套超限时与 ToJson 一样抛 JsonException。</summary>
    string PrettyToJson() {
        StringBuilder sb = new StringBuilder();
        this.WritePretty(sb, 0);
        return sb.ToString();
    }

    /// PrettyToJson 的递归实现；嵌套超限时抛 JsonException。
    void WritePretty(StringBuilder sb, int depth) {
        if (depth > JsonValue.MaxDepth) {
            throw new JsonException("JSON nesting too deep to serialize");
        }
        if (kind == 5) {
            if (keys.Count == 0) { sb.Append("{}"); return; }
            sb.Append("{\n");
            for (int i = 0; i < keys.Count; i = i + 1) {
                sb.Append(JsonValue.PrettyIndent(depth + 1));
                sb.Append("\"");
                sb.Append(Encoding.JsonEscape(keys[i]));
                sb.Append("\": ");
                vals[i].WritePretty(sb, depth + 1);
                if (i < keys.Count - 1) { sb.Append(","); }
                sb.Append("\n");
            }
            sb.Append(JsonValue.PrettyIndent(depth));
            sb.Append("}");
            return;
        }
        if (kind == 4) {
            if (items.Count == 0) { sb.Append("[]"); return; }
            sb.Append("[\n");
            for (int i = 0; i < items.Count; i = i + 1) {
                sb.Append(JsonValue.PrettyIndent(depth + 1));
                items[i].WritePretty(sb, depth + 1);
                if (i < items.Count - 1) { sb.Append(","); }
                sb.Append("\n");
            }
            sb.Append(JsonValue.PrettyIndent(depth));
            sb.Append("]");
            return;
        }
        this.WriteTo(sb);
    }

    /// 生成 depth 层两空格缩进串。
    static string PrettyIndent(int depth) {
        string s = "";
        for (int i = 0; i < depth; i = i + 1) { s = s + "  "; }
        return s;
    }

    /// 十进制数字字符的值，非数字返回 -1。
    static int Digit(string ch) {
        if (ch == "0") { return 0; }
        if (ch == "1") { return 1; }
        if (ch == "2") { return 2; }
        if (ch == "3") { return 3; }
        if (ch == "4") { return 4; }
        if (ch == "5") { return 5; }
        if (ch == "6") { return 6; }
        if (ch == "7") { return 7; }
        if (ch == "8") { return 8; }
        if (ch == "9") { return 9; }
        return -1;
    }

    /// 解析数字 token 的前导（可选符号）整数部分，
    /// 在 '.'/'e' 处停止。避免 "60.0"/"1e3" 触发 Convert 异常。
    static int IntOf(string t) {
        int n = t.Length;
        int i = 0;
        bool neg = false;
        if (n > 0 && (t[0] & 255) == 45) { neg = true; i = 1; }
        int acc = 0;
        while (i < n) {
            int d = (t[i] & 255) - 48;
            if (d < 0 || d > 9) { break; }
            acc = acc * 10 + d;
            i = i + 1;
        }
        if (neg) { return 0 - acc; }
        return acc;
    }

    /// 与 IntOf 类似，但按 64 位累加，使 `long`/`ulong` 字段能保存
    /// 超出 32 位范围的值。
    static long LongOf(string t) {
        int n = t.Length;
        int i = 0;
        bool neg = false;
        if (n > 0 && (t[0] & 255) == 45) { neg = true; i = 1; }
        long acc = 0;
        while (i < n) {
            int d = (t[i] & 255) - 48;
            if (d < 0 || d > 9) { break; }
            acc = acc * 10 + (long)d;
            i = i + 1;
        }
        if (neg) { return 0 - acc; }
        return acc;
    }

    /// 无需 Convert 解析数字 token（符号、小数、指数），
    /// 避免异常；非数字前缀时返回 0.0。
    /// 10 的幂表：10^0..10^22 全部可被 double 精确表示（5^22 < 2^53），
    /// 一次乘/除只引入一次舍入。更大的指数按 22 一档链式应用。
    static double[] Pow10Tab = new double[] {
        1e0, 1e1, 1e2, 1e3, 1e4, 1e5, 1e6, 1e7, 1e8, 1e9, 1e10, 1e11,
        1e12, 1e13, 1e14, 1e15, 1e16, 1e17, 1e18, 1e19, 1e20, 1e21, 1e22
    };

    /// 把十进制文本转成 double：有效数字吸进 long（上限 2^53 内保持
    /// 精确，超出部分按首个被丢数字四舍五入），再以精确的 10 的幂表
    /// 一次性缩放，保证 ≤16 位有效数字与适中指数下的精确舍入。
    static double DoubleOf(string t) {
        int n = t.Length;
        int i = 0;
        bool neg = false;
        if (n > 0 && (t[0] & 255) == 45) { neg = true; i = 1; }
        else if (n > 0 && (t[0] & 255) == 43) { i = 1; }
        long mant = 0;
        int exp10 = 0;
        bool roundUp = false;
        bool seenDigit = false;
        while (i < n) {
            int d = (t[i] & 255) - 48;
            if (d < 0 || d > 9) { break; }
            seenDigit = true;
            if (mant < 100000000000000000) {
                mant = mant * 10 + d;
            } else {
                if (!roundUp && d >= 5) { roundUp = true; }
                exp10 = exp10 + 1;
            }
            i = i + 1;
        }
        if (i < n && (t[i] & 255) == 46) {
            i = i + 1;
            while (i < n) {
                int d = (t[i] & 255) - 48;
                if (d < 0 || d > 9) { break; }
                seenDigit = true;
                if (mant < 100000000000000000) {
                    mant = mant * 10 + d;
                    exp10 = exp10 - 1;
                } else {
                    if (!roundUp && d >= 5) { roundUp = true; }
                }
                i = i + 1;
            }
        }
        if (!seenDigit) { return 0.0; }
        if (i < n && ((t[i] & 255) == 101 || (t[i] & 255) == 69)) {
            i = i + 1;
            bool eneg = false;
            if (i < n && (t[i] & 255) == 45) { eneg = true; i = i + 1; }
            else if (i < n && (t[i] & 255) == 43) { i = i + 1; }
            int ex = 0;
            while (i < n) {
                int d = (t[i] & 255) - 48;
                if (d < 0 || d > 9) { break; }
                if (ex < 100000000) { ex = ex * 10 + d; }
                i = i + 1;
            }
            if (eneg) { exp10 = exp10 - ex; } else { exp10 = exp10 + ex; }
        }
        if (roundUp) { mant = mant + 1; }
        double v = mant;
        int e = exp10;
        if (e > 350) { e = 350; }
        else if (e < -350) { e = -350; }
        while (e > 22) { v = v * 1e22; e = e - 22; }
        while (e < -22) { v = v / 1e22; e = e + 22; }
        if (e >= 0) {
            v = v * JsonValue.Pow10Tab[e];
        } else {
            v = v / JsonValue.Pow10Tab[0 - e];
        }
        if (neg) {
            if (v == 0.0) { return -0.0; }
            return 0.0 - v;
        }
        return v;
    }

    /// AsString：字符串原样返回；数字输出 NumText 同源文本；布尔返回
    /// "true"/"false"；其他类型退回 `dflt`。
    string AsString(string dflt) {
        if (kind == 3) { return strVal; }
        if (kind == 2) { return JsonValue.NumText(this); }
        if (kind == 1) { if (boolVal) { return "true"; } return "false"; }
        return dflt;
    }

    /// AsInt：数字按 token 形态取（纯整数免解析）；布尔 1/0；
    /// 字符串解析整数前缀；其余退回 `dflt`。
    int AsInt(int dflt) {
        if (kind == 2) {
            if (numRaw != null && numRaw.Length > 0) { return JsonValue.IntOf(numRaw); }
            if (numIsInt) { return (int)numI; }
            return (int)numD;
        }
        if (kind == 1) { if (boolVal) { return 1; } return 0; }
        if (kind == 3) { return JsonValue.IntOf(strVal); }
        return dflt;
    }

    /// AsLong：同 AsInt 但按 64 位。
    long AsLong(long dflt) {
        if (kind == 2) {
            if (numRaw != null && numRaw.Length > 0) { return JsonValue.LongOf(numRaw); }
            if (numIsInt) { return numI; }
            return (long)numD;
        }
        if (kind == 1) { if (boolVal) { return 1; } return 0; }
        if (kind == 3) { return JsonValue.LongOf(strVal); }
        return dflt;
    }

    /// AsDouble：数字按 token 形态取；布尔 1/0；字符串解析；
    /// 其余退回 `dflt`。
    double AsDouble(double dflt) {
        if (kind == 2) {
            if (numRaw != null && numRaw.Length > 0) { return JsonValue.DoubleOf(numRaw); }
            if (numIsInt) { return (double)numI; }
            return numD;
        }
        if (kind == 1) { if (boolVal) { return 1.0; } return 0.0; }
        if (kind == 3) { return JsonValue.DoubleOf(strVal); }
        return dflt;
    }

    /// AsBool：布尔原样；数字按非 0 为真；字符串仅 "true" 为真；
    /// 其余退回 `dflt`。
    bool AsBool(bool dflt) {
        if (kind == 1) { return boolVal; }
        if (kind == 2) { return this.AsLong(0) != 0; }
        if (kind == 3) { return strVal == "true"; }
        return dflt;
    }

    // ---- 类型化字段助手（对象 + key） -----------------------------------

    /// `key` 的字符串值，缺失或类型不符时退回 `dflt`。
    string Str(string key, string dflt) {
        JsonValue v = Get(key);
        if (v == null) { return dflt; }
        return v.AsString(dflt);
    }

    /// `key` 的整数值，缺失或类型不符时退回 `dflt`。
    int Int(string key, int dflt) {
        JsonValue v = Get(key);
        if (v == null) { return dflt; }
        return v.AsInt(dflt);
    }

    /// 点分路径的类型化读取：路径上任何一段缺失（PathGet 返回 null）都
    /// 退回 `dflt`，而不是让调用方对 null 调 AsString/AsInt 而崩溃。
    string PathStr(string path, string dflt) {
        JsonValue v = PathGet(path);
        if (v == null) { return dflt; }
        return v.AsString(dflt);
    }

    /// 同 PathStr，整数版。
    int PathInt(string path, int dflt) {
        JsonValue v = PathGet(path);
        if (v == null) { return dflt; }
        return v.AsInt(dflt);
    }

    /// `key` 的 64 位整数值，缺失或类型不符时退回 `dflt`。
    long Long(string key, long dflt) {
        JsonValue v = Get(key);
        if (v == null) { return dflt; }
        return v.AsLong(dflt);
    }

    /// `key` 的布尔值，缺失或类型不符时退回 `dflt`。
    bool Bool(string key, bool dflt) {
        JsonValue v = Get(key);
        if (v == null) { return dflt; }
        return v.AsBool(dflt);
    }

    /// `key` 的浮点值，缺失或解析不出时退回 `dflt`。
    double Double(string key, double dflt) {
        JsonValue v = Get(key);
        if (v == null) { return dflt; }
        return v.AsDouble(dflt);
    }

    /// 就地解析 [from, to) 的 JSON 数字 token：无 . e 且能安全装进
    /// long 的走整数快路径，否则走浮点。
    static JsonValue ParseNumberToken(string t, int from, int to) {
        int i = from;
        bool neg = false;
        if (i < to && (t[i] & 255) == 45) { neg = true; i = i + 1; }
        bool hasDotExp = false;
        for (int k = i; k < to; k = k + 1) {
            int c = (t[k] & 255);
            if (c == 46 || c == 101 || c == 69) { hasDotExp = true; break; }
        }
        if (!hasDotExp && to - i <= 18) {
            long acc = 0;
            for (int k = i; k < to; k = k + 1) {
                int d = (t[k] & 255) - 48;
                if (d < 0 || d > 9) { break; }
                acc = acc * 10 + d;
            }
            if (neg) { acc = 0 - acc; }
            return JsonValue.NewInt(acc);
        }
        // 走 double 的只有 . / e 形态与 >18 位整数：这两类用格式化文本
        // 还原会丢精度（1e2 → "100"、20 位整数 → "1.23E19"），把已经切出来
        // 的 token 文本留下当 numRaw，AsString/ToJson 才是无损的。
        string raw = t.Substring(from, to - from);
        double d2 = JsonValue.DoubleOf(raw);
        JsonValue v = JsonValue.NewDouble(d2);
        v.numRaw = raw;
        return v;
    }

    // ---- 解析 -----------------------------------------------------------

    /// 将 JSON 文档解析为值树。格式错误时抛出
    /// JsonException（与 C# 一致）。校验与建树在同一遍扫描里
    /// 完成：出错只记录位置并停止，抛异常前先丢掉部分树，
    /// 所以错误路径依然不持有存活分配。
    static JsonValue Parse(string src) {
        JsonReader r = JsonReader.OfStrict(src);
        JsonValue v = r.ReadValue();
        if (r.errPos < 0) {
            r.SkipWs();
            if (r.pos < r.len) { r.errPos = r.pos; }   // 尾部有多余内容
        }
        int errPos = r.errPos;
        if (errPos >= 0) {
            v = null;
            r = null;
            throw new JsonException("Malformed JSON at position "
                + Convert.ToString(errPos));
        }
        return v;
    }

    /// 尽力而为的解析：输入格式错误时返回已解析的部分
    /// 而不抛异常（用于手工编写/工具生成的 UI 文档，部分
    /// 结果树比异常更合适）。
    static JsonValue ParseLenient(string src) {
        JsonReader r = JsonReader.Of(src);
        return r.ReadValue();
    }
}

/// 驱动 JsonValue.Parse 的源字符串游标（Zan 没有
/// ref/out 参数，所以位置保存在该对象上）。
class JsonReader {
    /// 源字符串。
    string s;
    /// 源字节缓冲（解析期间固定，避免反复 ToBytes）。
    byte[] buf;
    /// 当前字节偏移。
    int pos;
    /// 源长度。
    int len;
    /// 递归解析/校验的最大嵌套深度。深层嵌套文档会耗尽
    /// 调用栈（约 20-40 万层时解析器崩溃），必须显式限制。
    static int MaxDepth = 512;

    /// 严格模式（JsonValue.Parse）：边建树边校验，首个错误位置
    /// 记在 errPos 上；宽松模式（ParseLenient）行为保持不变。
    bool strict;
    /// 首个语法错误的字节位置；无错误为 -1。
    int errPos;

    /// 创建宽松模式游标。
    static JsonReader Of(string src) {
        JsonReader r = new JsonReader();
        r.s = src;
        r.buf = src.ToBytes();
        r.pos = 0;
        r.len = src.Length;
        r.strict = false;
        r.errPos = -1;
        return r;
    }

    /// 创建严格模式游标（Parse 用）。
    static JsonReader OfStrict(string src) {
        JsonReader r = JsonReader.Of(src);
        r.strict = true;
        return r;
    }

    /// 记录首个错误位置（后来的错误不覆盖它）。
    void Fail() {
        if (errPos < 0) { errPos = pos; }
    }

    /// 是否已记录过错误。
    bool Failed() { return errPos >= 0; }

    /// 游标处的字节，输入结束时为 -1。
    int CurB() {
        if (pos >= len) { return -1; }
        return s[pos] & 255;
    }

    /// 跳过空白（空格/制表/换行/回车）。实测 JSON 文档里空白
    /// 游程通常 0-2 字节，跨 libc 的 strspn 调用开销（PLT + 参数
    /// 布置 ~40ns）比逐字节循环更贵。字节循环处理常见短游程，
    /// 长游程也只是多转几圈，分支预测器对"还是空白"方向的命中
    /// 率极高，实测无惩罚。
    void SkipWs() {
        while (pos < len) {
            int c = s[pos] & 255;
            if (c == 32 || c == 9 || c == 10 || c == 13) {
                pos = pos + 1;
            } else {
                return;
            }
        }
    }

    /// 从游标读一个任意 JSON 值（顶层入口）。
    JsonValue ReadValue() {
        return ReadValueAt(0);
    }

    /// ReadValue 的递归实现；`depth` 用于 MaxDepth 保护，超限时
    /// 严格模式记错误，宽松模式返回 null 占位。
    JsonValue ReadValueAt(int depth) {
        if (depth > JsonReader.MaxDepth) {
            if (strict) { Fail(); }
            return JsonValue.NewNull();
        }
        SkipWs();
        int c = CurB();
        if (c == 123) { return ReadObjectAt(depth); }              // '{'
        if (c == 91) { return ReadArrayAt(depth); }                // '['
        if (c == 34) { return JsonValue.NewStr(ReadString()); }
        if (c == 116 || c == 102) {                        // 't' / 'f'
            if (strict) {
                string lit = "false";
                if (c == 116) { lit = "true"; }
                if (!ValidLiteral(lit)) {
                    Fail();
                    return JsonValue.NewNull();
                }
                return JsonValue.NewBool(c == 116);
            }
            return ReadBool();
        }
        if (c == 110) {
            if (strict) {
                if (!ValidLiteral("null")) { Fail(); }
            } else {
                pos = pos + 4;
            }
            return JsonValue.NewNull();
        }
        return ReadNumber();
    }

    /// 游标处为 '{' 时读对象；strict 下逐 token 校验，
    /// 错误语义同 ReadValueAt。
    JsonValue ReadObjectAt(int depth) {
        JsonValue obj = JsonValue.NewObject();
        pos = pos + 1;                 // 消费 '{'
        SkipWs();
        if (CurB() == 125) { pos = pos + 1; return obj; }   // '}'
        while (pos < len) {
            SkipWs();
            if (strict && CurB() != 34) { Fail(); return obj; }
            string key = ReadString();
            SkipWs();
            if (CurB() == 58) { pos = pos + 1; }            // ':'
            else if (strict) { Fail(); return obj; }
            JsonValue v = ReadValueAt(depth + 1);
            if (strict && Failed()) { return obj; }
            obj.Put(key, v);
            SkipWs();
            int c = CurB();
            if (c == 44) { pos = pos + 1; }                 // ','
            else if (c == 125) { pos = pos + 1; return obj; } // '}'
            else {
                if (strict) { Fail(); }
                return obj;
            }
        }
        if (strict) { Fail(); }                             // 未闭合
        return obj;
    }

    /// 游标处为 '[' 时读数组；错误语义同 ReadObjectAt。
    JsonValue ReadArrayAt(int depth) {
        JsonValue arr = JsonValue.NewArray();
        pos = pos + 1;                 // 消费 '['
        SkipWs();
        if (CurB() == 93) { pos = pos + 1; return arr; }    // ']'
        while (pos < len) {
            JsonValue v = ReadValueAt(depth + 1);
            if (strict && Failed()) { return arr; }
            arr.Append(v);
            SkipWs();
            int c = CurB();
            if (c == 44) { pos = pos + 1; }                 // ','
            else if (c == 93) { pos = pos + 1; return arr; } // ']'
            else {
                if (strict) { Fail(); }
                return arr;
            }
        }
        if (strict) { Fail(); }                             // 未闭合
        return arr;
    }

    /// 从起始引号读取带引号的字符串；解码常见
    /// 转义。结束后 pos 位于闭合引号之后。无转义的字符串
    /// （最常见的情况）先 memchr 定位闭合引号/反斜杠，
    /// 再单次 Substring；含转义的字符串则回退到 StringBuilder，
    /// 批量复制转义之间的普通片段。
    string ReadString() {
        if (CurB() != 34) {
            if (strict) { Fail(); }
            return "";
        }
        pos = pos + 1;                 // 消费起始引号
        int start = pos;
        while (pos < len) {
            // strcspn 找下一个引号或反斜杠：向量化，替代逐字节循环。
            // 返回相对扫描起点（pos）的偏移；-1 表示窗口内干净到尾。
            int run = (int)NativeMemory.FindNotAnyOf(this.buf, pos, "\"\\",
                len - pos);
            if (run < 0) { pos = len; break; }
            pos = pos + run;
            int c = s[pos] & 255;
            if (c == 34) {
                string plain = s.Substring(start, pos - start);
                pos = pos + 1;
                return plain;
            }
            break;  // '\\' -> 转义路径
        }
        StringBuilder sb = new StringBuilder();
        if (pos > start) { sb.Append(s.Substring(start, pos - start)); }
        while (pos < len) {
            int c = s[pos] & 255;
            if (c == 34) { pos = pos + 1; return sb.ToString(); }
            if (c == 92 && pos + 1 < len) {
                int n = s[pos + 1] & 255;
                if (n == 110) { sb.Append("\n"); }
                else if (n == 116) { sb.Append("\t"); }
                else if (n == 114) { sb.Append("\r"); }
                else if (n == 34) { sb.Append("\""); }
                else if (n == 92) { sb.Append("\\"); }
                else if (n == 47) { sb.Append("/"); }
                else if (n == 98) { sb.Append(Encoding.CharFromCode(8)); }
                else if (n == 102) { sb.Append(Encoding.CharFromCode(12)); }
                else if (n == 117) {
                    // \uXXXX：以 UTF-8 输出（含代理对）。很多客户端默认
                    // 把所有非 ASCII 字符发成 \uXXXX（Python json.dumps 的
                    // ensure_ascii=True 就是这样），不解码就会把
                    // "\u4e2d\u6587" 变成字面量 "u4e2du6587"。
                    pos = pos + 2;
                    int cp = JsonReader.Hex4(s, pos, len);
                    if (cp < 0) {
                        // 错误位置按转义起点报（游标已越过 "\u"）。
                        if (strict) {
                            pos = pos - 2;
                            Fail();
                            return sb.ToString();
                        }
                        sb.Append("u");
                        continue;
                    }
                    pos = pos + 4;
                    if (cp >= 55296 && cp <= 56319 && pos + 5 < len
                        && (s[pos] & 255) == 92 && (s[pos + 1] & 255) == 117) {
                        int lo = JsonReader.Hex4(s, pos + 2, len);
                        if (lo >= 56320 && lo <= 57343) {
                            cp = 65536 + ((cp - 55296) << 10) + (lo - 56320);
                            pos = pos + 6;
                        }
                    }
                    if (cp == 0) {
                        // \u0000 接受并保留（与 JsonTape 的行为统一；
                        // Zan 字符串带显式长度，装得下内嵌 NUL。BSON
                        // 语料先例：管理串可含 NUL）。写出的内容经
                        // Encoding.JsonEscape 转成 \u0000，往返无损。
                        sb.Append(Encoding.Utf8FromCodePoint(0));
                        continue;
                    }
                    sb.Append(Encoding.Utf8FromCodePoint(cp));
                    continue;
                }
                else {
                    // \" \\ \/ \b \f \n \r \t \u 之外的转义在 JSON 里非法。
                    if (strict) { Fail(); return sb.ToString(); }
                    sb.Append(s.Substring(pos + 1, 1));
                }
                pos = pos + 2;
            } else {
                if ((s[pos] & 255) == 92) {
                    // 尾部孤反斜杠(后面没有字节可构成转义):上面的
                    // "c == 92 && pos + 1 < len" 不命中才会到这里。
                    // 若直接走下面的 FindNotAnyOf,它从反斜杠处起扫
                    // 立即返回 0,pos 原地不动 —— 解析器死循环。
                    if (strict) { Fail(); return sb.ToString(); }
                    sb.Append("\\");
                    pos = pos + 1;
                    continue;
                }
                int run2 = (int)NativeMemory.FindNotAnyOf(this.buf, pos, "\"\\",
                    len - pos);
                int stop2 = run2 < 0 ? len : pos + run2;
                sb.Append(s.Substring(pos, stop2 - pos));
                pos = stop2;
            }
        }
        if (strict) { Fail(); }                             // 未闭合
        return sb.ToString();
    }

    /// 从 `at` 开始的 4 位十六进制值；不足 4 位或含非十六进制
    /// 字符时返回 -1。
    static int Hex4(string src, int at, int limit) {
        if (at + 4 > limit) { return -1; }
        int acc = 0;
        for (int i = 0; i < 4; i = i + 1) {
            int d = Encoding.HexDigit(src[at + i] & 255);
            if (d < 0) { return -1; }
            acc = acc * 16 + d;
        }
        return acc;
    }

    /// 读取字面量 true/false（宽松模式）并构造布尔值。
    JsonValue ReadBool() {
        if (CurB() == 116) { pos = pos + 4; return JsonValue.NewBool(true); }
        pos = pos + 5;                 // "false"
        return JsonValue.NewBool(false);
    }

    /// 读数字 token：数字游程短（中位 2-4 字节），strspn 的调用开销
    /// 反而更贵，用字节循环吃 token，然后就地解析——纯整数存 numI，
    /// 含 . / e 的存 numD。不再保留字面量字符串（AsString/ToJson
    /// 的输出文本按需生成），每 token 少一次分配、读取侧免二次解析。
    JsonValue ReadNumber() {
        int start = pos;
        while (pos < len) {
            int c = s[pos] & 255;
            if ((c >= 48 && c <= 57) || c == 45 || c == 43 || c == 46
                || c == 101 || c == 69) {   // digits - + . e E
                pos = pos + 1;
            } else {
                break;
            }
        }
        if (pos == start) {
            // 数字 token 前缀为空：strict 下报错，宽松下占 0。
            if (strict) { Fail(); return JsonValue.NewNull(); }
            return JsonValue.NewInt(0);
        }
        if (strict && !ValidNumberAt(start, pos)) {
            Fail();
            return JsonValue.NewNull();
        }
        return JsonValue.ParseNumberToken(s, start, pos);
    }

    // ---- 语法校验（严格模式解析时就地调用） -------------------------

    /// 校验游标处是字面量 `lit`（"true"/"false"/"null"）并推进；
    /// 不匹配时不推进返回 false。
    bool ValidLiteral(string lit) {
        int n = lit.Length;
        if (pos + n > len) { return false; }
        if (s.Substring(pos, n) != lit) { return false; }
        pos = pos + n;
        return true;
    }

    /// 校验 [from, to) 是 JSON 数字语法（可选负号、整数、
    /// 可选小数、可选指数）；语法不符返回 false（不推进——
    /// 游标已由 ReadNumber 的字节循环吃满 token 游程）。
    bool ValidNumberAt(int from, int to) {
        int i = from;
        if (i < to && (s[i] & 255) == 45) { i = i + 1; }
        if (i >= to) { return false; }
        int d = (s[i] & 255) - 48;
        if (d < 0 || d > 9) { return false; }
        while (i < to) {
            int c = (s[i] & 255) - 48;
            if (c < 0 || c > 9) { break; }
            i = i + 1;
        }
        if (i < to && (s[i] & 255) == 46) {
            i = i + 1;
            if (i >= to) { return false; }
            int d2 = (s[i] & 255) - 48;
            if (d2 < 0 || d2 > 9) { return false; }
            while (i < to) {
                int c2 = (s[i] & 255) - 48;
                if (c2 < 0 || c2 > 9) { break; }
                i = i + 1;
            }
        }
        if (i < to && ((s[i] & 255) == 101 || (s[i] & 255) == 69)) {
            i = i + 1;
            if (i < to && ((s[i] & 255) == 43 || (s[i] & 255) == 45)) { i = i + 1; }
            if (i >= to) { return false; }
            int d3 = (s[i] & 255) - 48;
            if (d3 < 0 || d3 > 9) { return false; }
            while (i < to) {
                int c3 = (s[i] & 255) - 48;
                if (c3 < 0 || c3 > 9) { break; }
                i = i + 1;
            }
        }
        return i == to;
    }
}
