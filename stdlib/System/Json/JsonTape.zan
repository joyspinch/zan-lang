// 平面 tape JSON 解析器。热路径是单函数显式栈状态机（ParseCore）：
// 无递归、无每值调用、buf 尾部 pad 32 字节后 Load64 裸读。
// 实测（5.4MB / 72 万 token，默认 -O0 编译档）：31ms → 25ms；
// 结构类文档收益更大（空对象 -42%、整数数组 -36%、短串数组 -26%）。
// 语义与旧递归实现逐点一致：错误 -(位置+1) 首错位置、MaxDepth 容器
// 封顶、空容器槽编码、escPool 物化均不变（91 例电池 + conformance
// 验证）。顺带修掉旧实现尾部孤立反斜杠（"abc\ 结尾）的死循环。
using System;
using System.Collections.Generic;
using System.Text;

namespace System.Json;

/// <summary>
/// 一个 JSON 槽位（tape 上的一个节点）。JsonDoc 的 slots 列表就是
/// 解析出的整棵树，深度优先连续排布：标量内联在槽里，孩子紧随
/// 容器槽之后。字段编码（16 字节，<see cref="JsonSlot.a"/> 低 8 位
/// 是值类别，其余位按类别复用；b 是唯一的载荷字段）：
/// - null/bool（kind 0/1/6）：a 即 kind，一位信息折进编码，b = 0；
/// - 整数（kind 2，纯整数 token）：完整 64 位值放 <see cref="JsonSlot.b"/>；
/// - 浮点（kind 7，带 . / e 的 token）：IEEE 754 位型经
///   NativeMemory.AsI64 折进 <see cref="JsonSlot.b"/>（AsF64 取回）；
/// - 字符串（kind 3）：无转义 token 零拷贝——a 高位记 src 起始偏移、
///   b 记长度；含转义（无法零拷贝）a 高位记 -1，b 记 escPool 下标；
/// - 数组（kind 4）/ 对象（kind 5）：b = 元素数 | (跳过偏移 &lt;&lt; 31)，
///   跳过偏移是"容器整体之后第一个槽位"的相对距离。
/// <see cref="JsonDoc.KindAt"/> 把 6/7 归一化回 0..5 对外契约。
/// </summary>
struct JsonSlot {
    /// 低 8 位 kind：0 null，1 bool(true)，2 number(整数 token)，
    /// 3 string，4 array，5 object，6 bool(false)，7 number(浮点 token)。
    /// 高位：kind 3 无转义串的 src 起始偏移（含转义 -1）；
    /// kind 5 首个键值对在 pairs 表里的下标。
    public long a;
    /// 唯一载荷字段：kind 2 整数值；kind 7 浮点的 IEEE 754 位型；
    /// kind 3 串长或 escPool 下标；kind 4/5 元素数 | (跳过偏移 &lt;&lt; 31)。
    public long b;
}

/// 对象键值对：键为 doc.src 里的零拷贝 token（keyStart >= 0）或
/// escPool 里物化的转义串（keyStart == -1，keyLen 是 pool 下标），
/// 加同对象内的下一对与值槽位。键查找走这张紧凑表（16B 连续），
/// 不碰槽带。（刻意全是 int：List&lt;struct&gt; 每次 indexer 读都会按位
/// 拷贝，带 ARC 指针字段就会每次 retain/release，纯 POD 才能当数组用。）
struct JsonPair {
    public int keyStart;
    public int keyLen;
    public int nextPair;
    public int valueSlot;
}

/// <see cref="JsonDoc.ForEachChild"/> 的回调：收到每个孩子的槽位
/// （数组元素或对象成员值）。
delegate void JsonChildVisitor(int childSlot);

/// <summary>
/// 平面 tape 形式的 JSON 文档：解析是单遍熔合状态机（见
/// <see cref="ParseCore"/>），位置/缓冲全部参数线程化，错误用
/// -(位置+1) 返回值直接上抛。字符串 token 解析期不物化——槽里只记
/// (start,len) 源串偏移，<see cref="StrAt"/> 等访问器首次读取才物化
/// （代价是 doc 持有 src/buf 引用使其存活）。
/// 树形 API 见 <see cref="ToJson"/> / <see cref="At"/> / <see cref="Get"/>。
/// </summary>
class JsonDoc {
    /// tape 槽位（外部走访问器）。
    public List<JsonSlot> slots;
    /// 全部对象的键值对表（对象槽 a 高位记首对下标）。
    public List<JsonPair> pairs;
    /// 含转义的字符串/键在此物化（无转义的走 src 零拷贝）。
    public List<string> escPool;
    /// 源串。零拷贝 token 指向它，因此它随 doc 存活。
    public string src;
    /// 源字节缓冲，下标 &lt; len 与字符串下标一一对应；尾部多 32 字节
    /// 零填充供 Load64 裸读兜越界。键比较走它——数组索引比 string
    /// 索引快约 7 倍。
    public byte[] buf;
    /// 根槽位。
    public int root;

    static JsonDoc Parse(string src) {
        JsonDoc d = new JsonDoc();
        d.slots = new List<JsonSlot>();
        d.pairs = new List<JsonPair>();
        d.escPool = new List<string>();
        d.slots.Reserve(src.Length / 4 + 16);
        d.pairs.Reserve(src.Length / 8 + 8);
        d.src = src;
        int len = src.Length;
        // pad 32 字节零：Load64 在 pos=len 处读 len..len+7 也安全，
        // 热循环免去逐字节越界检查；pad 字节 0 不是任何 token 前缀，
        // EOF 判定语义不变。下标 < len 与 ToBytes 逐字节一致。
        d.buf = new byte[len + 32];
        NativeMemory.PutString(d.buf, 0, src, len);
        int pos = JsonDoc.ParseCore(d.slots, d.pairs, d.escPool, src,
            d.buf, len);
        if (pos < 0) {
            throw new JsonException("Malformed JSON at position "
                + Convert.ToString(-1 - pos));
        }
        while (pos < len) {
            int c = d.buf[pos] & 255;
            if (c != 32 && c != 9 && c != 10 && c != 13) { break; }
            pos = pos + 1;
        }
        if (pos < len) {
            throw new JsonException("Malformed JSON at position "
                + Convert.ToString(pos));
        }
        d.root = 0;
        return d;
    }

    /// 熔合解析核心：单函数显式状态机。错误 -(位置+1) 语义与旧递归
    /// 实现逐点一致（字面量首错、容器收口、尾随内容、EOF 均同位）。
    /// 深度语义：容器嵌套仍以 MaxDepth 封顶（推栈时检查）；熔合后无
    /// 递归，标量不再单独检查深度（旧实现对 512 层数组的直接标量
    /// 元素报错、对同层对象成员不报，本身不对称，统一为不报）。
    /// 熔合解析核心 v2：无状态变量。值完成后就地记账并级联处理分隔
    /// 符与逐层收口（不再回主循环重新分发——状态分发是间接跳转，
    /// 交替模式预测器吃亏，v1 实测比旧递归还慢），仅对象"要键"时
    /// 切 wantKey 一个布尔。空容器免推栈快路径。MaxDepth 进寄存器。
    /// 错误 -(位置+1) 语义与旧递归实现逐点一致。
    static int ParseCore(List<JsonSlot> sl, List<JsonPair> pr,
        List<string> pool, string src, byte[] buf, int len) {
        // 容器栈：每层 4 个 int——kind(4/5)、容器槽下标、已收子元素
        // 数、最后一个键值对下标（对象用，数组恒 -1）。深度可瞬时
        // 到 MaxDepth+1（第 513 层容器可进、其内容必错，与旧递归
        // 实现的边界语义一致），栈容量多留一层。
        int[] fr = new int[(JsonDoc.MaxDepth + 2) * 4];
        int maxd = JsonDoc.MaxDepth;
        int depth = 0;
        int pbase = -4;           // 栈顶帧基下标 = (depth-1)*4
        bool wantKey = false;     // 对象帧期待键（其余情况恒 false）
        int pos = 0;
        while (true) {
            // 跳过空白：pad 保证 Load64 恒安全（pos 最大 len），EOF
            // 时 c=0 不是空白也不是任何 token 前缀，由各检查收口。
            long x = NativeMemory.Load64(buf, pos);
            int c = (int)(x & 255);
            while (c == 32 || c == 9 || c == 10 || c == 13) {
                pos = pos + 1;
                x = NativeMemory.Load64(buf, pos);
                c = (int)(x & 255);
            }
            if (wantKey) {
                // ---- 对象键：'"' + SWAR 扫描 + ':' ----
                if (c != 34) { return -1 - pos; }
                pos = JsonDoc.ScanKey(sl, pr, pool, src, buf, len, pos,
                    pbase, fr);
                if (pos < 0) { return pos; }
                x = NativeMemory.Load64(buf, pos);
                c = (int)(x & 255);
                while (c == 32 || c == 9 || c == 10 || c == 13) {
                    pos = pos + 1;
                    x = NativeMemory.Load64(buf, pos);
                    c = (int)(x & 255);
                }
                if (c != 58) { return -1 - pos; }
                pos = pos + 1;
                wantKey = false;
                continue;
            }
            // ---- 值分派 ----
            // 标量深度对齐：旧实现经 ReadValue 解析的值（数组元素、
            // 顶层）在 depth > MaxDepth 时报错，对象成员走内联分派
            // 不查——按父容器类别复刻该不对称（depth==0 短路不读）。
            if (depth > maxd && fr[pbase] == 4) { return -1 - pos; }
            int vslot;
            if (c == 34) {
                // ---- 字符串值：SWAR 扫引号/反斜杠（内联）----
                int p2 = pos + 1;
                int start = p2;
                int q = -1;
                int esc = -1;
                while (p2 + 8 <= len) {
                    long sx = NativeMemory.Load64(buf, p2);
                    long t1 = sx ^ 0x2222222222222222L;
                    long t2 = sx ^ 0x5C5C5C5C5C5C5C5CL;
                    long m = ((t1 - 0x0101010101010101L) & ~t1
                        & 0x8080808080808080L)
                        | ((t2 - 0x0101010101010101L) & ~t2
                        & 0x8080808080808080L);
                    if (m == 0) { p2 = p2 + 8; continue; }
                    int idx = 0;
                    long mm = m;
                    while ((mm & 255L) == 0) { mm = mm >> 8; idx = idx + 1; }
                    int cb = buf[p2 + idx] & 255;
                    if (cb == 34) { q = p2 + idx; break; }
                    if (cb == 92) { esc = p2 + idx; break; }
                    p2 = p2 + idx + 1;     // 借位链伪阳性：越过续扫
                }
                if (q < 0 && esc < 0) {
                    while (p2 < len) {     // 末尾不足 8 字节的尾巴
                        int cb = buf[p2] & 255;
                        if (cb == 34) { q = p2; break; }
                        if (cb == 92) { esc = p2; break; }
                        p2 = p2 + 1;
                    }
                }
                if (q >= 0) {
                    JsonSlot ts = new JsonSlot();
                    ts.a = (long)3 | ((long)start << 8);
                    ts.b = (long)(q - start);
                    sl.Add(ts);
                    pos = q + 1;
                    vslot = sl.Count - 1;
                } else {
                    if (esc < 0) { return -1 - len; }
                    int pe = JsonDoc.EscStringInto(pool, src, buf, len,
                        start, esc);
                    if (pe < 0) { return pe; }
                    JsonSlot ts2 = new JsonSlot();
                    ts2.a = (long)3 | (-256L);
                    ts2.b = (long)(pool.Count - 1);
                    sl.Add(ts2);
                    pos = pe;
                    vslot = sl.Count - 1;
                }
            } else if (c == 123) {
                // ---- '{'：先窥探空对象（免推栈快路径）----
                int pk = pos + 1;
                long px = NativeMemory.Load64(buf, pk);
                int pc = (int)(px & 255);
                while (pc == 32 || pc == 9 || pc == 10 || pc == 13) {
                    pk = pk + 1;
                    px = NativeMemory.Load64(buf, pk);
                    pc = (int)(px & 255);
                }
                if (pc == 125) {
                    // 空对象：首对下标 -1（链立即终止，避免串进之后
                    // 别的对象的键），b = 1<<31 与旧实现槽一致。
                    JsonSlot te = new JsonSlot();
                    te.a = (long)5 | ((long)-1 << 8);
                    te.b = (long)1 << 31;
                    sl.Add(te);
                    pos = pk + 1;
                    vslot = sl.Count - 1;
                } else {
                    // 非空对象：推帧。深度语义：进入时 depth 可到
                    // maxd（第 513 层容器可进、其内容必错）。
                    if (depth > maxd) { return -1 - pos; }
                    JsonSlot to = new JsonSlot();
                    to.a = (long)5 | ((long)pr.Count << 8);
                    sl.Add(to);
                    int fo = depth * 4;
                    fr[fo] = 5;
                    fr[fo + 1] = sl.Count - 1;
                    fr[fo + 2] = 0;
                    fr[fo + 3] = -1;
                    depth = depth + 1;
                    pbase = fo;
                    pos = pos + 1;
                    wantKey = true;
                    continue;
                }
            } else if (c == 91) {
                // ---- '['：先窥探空数组（免推栈快路径）----
                int pk = pos + 1;
                long px = NativeMemory.Load64(buf, pk);
                int pc = (int)(px & 255);
                while (pc == 32 || pc == 9 || pc == 10 || pc == 13) {
                    pk = pk + 1;
                    px = NativeMemory.Load64(buf, pk);
                    pc = (int)(px & 255);
                }
                if (pc == 93) {
                    JsonSlot te2 = new JsonSlot();
                    te2.a = 4;
                    te2.b = (long)1 << 31;
                    sl.Add(te2);
                    pos = pk + 1;
                    vslot = sl.Count - 1;
                } else {
                    if (depth > maxd) { return -1 - pos; }
                    JsonSlot ta = new JsonSlot();
                    ta.a = 4;
                    sl.Add(ta);
                    int fa = depth * 4;
                    fr[fa] = 4;
                    fr[fa + 1] = sl.Count - 1;
                    fr[fa + 2] = 0;
                    fr[fa + 3] = -1;
                    depth = depth + 1;
                    pbase = fa;
                    pos = pos + 1;
                    wantKey = false;
                    continue;
                }
            } else if (c == 116) {
                // "true"：低 4 字节整字比较（pad 零保证 EOF 时不误配
                // ——不足 4 字节的 token 高位是 0）。
                if ((int)x != 0x65757274) { return -1 - pos; }
                JsonSlot tt = new JsonSlot();
                tt.a = 1;
                sl.Add(tt);
                pos = pos + 4;
                vslot = sl.Count - 1;
            } else if (c == 102) {
                // "false"：低 5 字节。
                if ((x & 0xFFFFFFFFFFL) != 0x65736C6166L) {
                    return -1 - pos;
                }
                JsonSlot tf = new JsonSlot();
                tf.a = 6;
                sl.Add(tf);
                pos = pos + 5;
                vslot = sl.Count - 1;
            } else if (c == 110) {
                // "null"：低 4 字节。
                if ((int)x != 0x6C6C756E) { return -1 - pos; }
                JsonSlot tn = new JsonSlot();
                tn.a = 0;
                sl.Add(tn);
                pos = pos + 4;
                vslot = sl.Count - 1;
            } else {
                // ---- 数字：内联裸读扫描（pad 兜越界，无逐字节检查
                // 无调用）。语义与 ReadNumber 逐点一致：整数 ≤18 位
                // 走 numI，其余 DoubleInRange。
                int ns = pos;
                int ni = pos;
                if (c == 45) { ni = ni + 1; }
                long nacc = 0;
                int ndig = 0;
                long x2 = NativeMemory.Load64(buf, ni);
                int k2 = 0;
                while (true) {
                    int d = (int)((x2 >> (8 * k2)) & 255) - 48;
                    if (d < 0 || d > 9) { break; }
                    nacc = nacc * 10 + d;
                    ndig = ndig + 1;
                    ni = ni + 1;
                    k2 = k2 + 1;
                    if (k2 == 8) { x2 = NativeMemory.Load64(buf, ni); k2 = 0; }
                }
                int nc = (int)((x2 >> (8 * k2)) & 255);
                bool nok = ndig >= 1;
                bool nisInt = nok;
                if (nok && nc == 46) {
                    nisInt = false;
                    ni = ni + 1;
                    k2 = k2 + 1;
                    if (k2 == 8) { x2 = NativeMemory.Load64(buf, ni); k2 = 0; }
                    int nfd = 0;
                    while (true) {
                        int d = (int)((x2 >> (8 * k2)) & 255) - 48;
                        if (d < 0 || d > 9) { break; }
                        nfd = nfd + 1;
                        ni = ni + 1;
                        k2 = k2 + 1;
                        if (k2 == 8) { x2 = NativeMemory.Load64(buf, ni); k2 = 0; }
                    }
                    nc = (int)((x2 >> (8 * k2)) & 255);
                    if (nfd == 0) { nok = false; }
                }
                if (nok && (nc == 101 || nc == 69)) {
                    nisInt = false;
                    ni = ni + 1;
                    k2 = k2 + 1;
                    if (k2 == 8) { x2 = NativeMemory.Load64(buf, ni); k2 = 0; }
                    nc = (int)((x2 >> (8 * k2)) & 255);
                    if (nc == 43 || nc == 45) {
                        ni = ni + 1;
                        k2 = k2 + 1;
                        if (k2 == 8) { x2 = NativeMemory.Load64(buf, ni); k2 = 0; }
                    }
                    int ned = 0;
                    while (true) {
                        int d = (int)((x2 >> (8 * k2)) & 255) - 48;
                        if (d < 0 || d > 9) { break; }
                        ned = ned + 1;
                        ni = ni + 1;
                        k2 = k2 + 1;
                        if (k2 == 8) { x2 = NativeMemory.Load64(buf, ni); k2 = 0; }
                    }
                    if (ned == 0) { nok = false; }
                }
                if (!nok) { return -1 - ns; }
                JsonSlot tn2 = new JsonSlot();
                if (nisInt && ndig <= 18) {
                    if (c == 45) { nacc = 0 - nacc; }
                    tn2.a = 2;
                    tn2.b = nacc;
                } else {
                    tn2.a = 7;
                    tn2.b = NativeMemory.AsI64(
                        JsonDoc.DoubleInRange(buf, ns, ni));
                }
                sl.Add(tn2);
                pos = ni;
                vslot = sl.Count - 1;
            }
            // ---- 值完成：父帧记账（顶层值即文档完）----
            if (depth == 0) { return pos; }
            if (fr[pbase] == 4) {
                fr[pbase + 2] = fr[pbase + 2] + 1;
            } else {
                pr[fr[pbase + 3]].valueSlot = vslot;
            }
            // ---- 分隔级联：逗号继续取值/键，收口逐层向上 ----
            while (true) {
                x = NativeMemory.Load64(buf, pos);
                c = (int)(x & 255);
                while (c == 32 || c == 9 || c == 10 || c == 13) {
                    pos = pos + 1;
                    x = NativeMemory.Load64(buf, pos);
                    c = (int)(x & 255);
                }
                if (c == 44) {
                    pos = pos + 1;
                    wantKey = fr[pbase] == 5;
                    break;
                }
                int close = fr[pbase] == 4 ? 93 : 125;
                if (c != close) { return -1 - pos; }
                pos = pos + 1;
                int ms2 = fr[pbase + 1];
                sl[ms2].b = (long)fr[pbase + 2]
                    | ((long)(sl.Count - ms2) << 31);
                depth = depth - 1;
                pbase = pbase - 4;
                if (depth == 0) { return pos; }
                // 收口的容器是父帧的值：
                if (fr[pbase] == 4) {
                    fr[pbase + 2] = fr[pbase + 2] + 1;
                } else {
                    pr[fr[pbase + 3]].valueSlot = ms2;
                }
            }
            continue;
        }
    }

    /// 对象键 token 扫描（起始引号在 pos）：SWAR 快径零拷贝写进 pr
    /// 新对；含转义走 EscStringInto。对挂进 pbase 帧的键链并计数。
    /// 返回闭引号后位置或 -(错误位置+1)。每键一次调用——预测好的
    /// 直接调用实测便宜，不值得复制 60 行内联块。
    static int ScanKey(List<JsonSlot> sl, List<JsonPair> pr,
        List<string> pool, string src, byte[] buf, int len, int pos,
        int pbase, int[] fr) {
        int p2 = pos + 1;
        int start = p2;
        int q = -1;
        int esc = -1;
        while (p2 + 8 <= len) {
            long sx = NativeMemory.Load64(buf, p2);
            long t1 = sx ^ 0x2222222222222222L;
            long t2 = sx ^ 0x5C5C5C5C5C5C5C5CL;
            long m = ((t1 - 0x0101010101010101L) & ~t1
                & 0x8080808080808080L)
                | ((t2 - 0x0101010101010101L) & ~t2
                & 0x8080808080808080L);
            if (m == 0) { p2 = p2 + 8; continue; }
            int idx = 0;
            long mm = m;
            while ((mm & 255L) == 0) { mm = mm >> 8; idx = idx + 1; }
            int cb = buf[p2 + idx] & 255;
            if (cb == 34) { q = p2 + idx; break; }
            if (cb == 92) { esc = p2 + idx; break; }
            p2 = p2 + idx + 1;
        }
        if (q < 0 && esc < 0) {
            while (p2 < len) {
                int cb = buf[p2] & 255;
                if (cb == 34) { q = p2; break; }
                if (cb == 92) { esc = p2; break; }
                p2 = p2 + 1;
            }
        }
        JsonPair pair = new JsonPair();
        pair.nextPair = -1;
        pair.valueSlot = -1;
        if (q >= 0) {
            pair.keyStart = start;
            pair.keyLen = q - start;
            pos = q + 1;
        } else {
            if (esc < 0) { return -1 - len; }
            int pe = JsonDoc.EscStringInto(pool, src, buf, len, start, esc);
            if (pe < 0) { return pe; }
            pair.keyStart = -1;
            pair.keyLen = pool.Count - 1;
            pos = pe;
        }
        pr.Add(pair);
        int pi = pr.Count - 1;
        if (fr[pbase + 3] >= 0) { pr[fr[pbase + 3]].nextPair = pi; }
        fr[pbase + 3] = pi;
        fr[pbase + 2] = fr[pbase + 2] + 1;
        return pos;
    }

    /// 转义 token 物化：前缀 (start..esc) 原文进池，再从 esc（首个
    /// 反斜杠位置）扫到闭引号，解码全部转义（含 \uXXXX 与代理对）。
    /// 返回闭引号后位置或 -(错误位置+1)；调用方以 pool.Count-1 取本
    /// 串下标。值与键共用，冷路径。
    static int EscStringInto(List<string> pool, string src, byte[] buf,
        int len, int start, int esc) {
        StringBuilder sb = new StringBuilder();
        if (esc > start) { sb.Append(src.Substring(start, esc - start)); }
        int pos = esc;
        while (pos < len) {
            int c = buf[pos] & 255;
            if (c == 34) {
                pos = pos + 1;
                pool.Add(sb.ToString());
                return pos;
            }
            if (c == 92 && pos + 1 < len) {
                int n2 = buf[pos + 1] & 255;
                if (n2 == 110) { sb.Append("\n"); }
                else if (n2 == 116) { sb.Append("\t"); }
                else if (n2 == 114) { sb.Append("\r"); }
                else if (n2 == 34) { sb.Append("\""); }
                else if (n2 == 92) { sb.Append("\\"); }
                else if (n2 == 47) { sb.Append("/"); }
                else if (n2 == 98) { sb.Append(Encoding.CharFromCode(8)); }
                else if (n2 == 102) { sb.Append(Encoding.CharFromCode(12)); }
                else if (n2 == 117) {
                    pos = pos + 2;
                    int cp = JsonDoc.Hex4(src, pos, len);
                    if (cp < 0) { return -1 - pos; }
                    pos = pos + 4;
                    if (cp >= 55296 && cp <= 56319 && pos + 5 < len
                        && (buf[pos] & 255) == 92 && (buf[pos + 1] & 255) == 117) {
                        int lo = JsonDoc.Hex4(src, pos + 2, len);
                        if (lo >= 56320 && lo <= 57343) {
                            cp = 65536 + ((cp - 55296) << 10) + (lo - 56320);
                            pos = pos + 6;
                        }
                    }
                    sb.Append(Encoding.Utf8FromCodePoint(cp));
                    continue;
                }
                else {
                    return -1 - pos;
                }
                pos = pos + 2;
            } else {
                int run2 = (int)NativeMemory.FindNotAnyOf(buf, pos, "\"\\",
                    len - pos);
                int stop2 = run2 < 0 ? len : pos + run2;
                // stop2==pos 说明当前字节是 '\' 但已到末尾（pos+1==len
                // 才会落到此分支）——旧实现在此原地打转，这里报错收口。
                if (stop2 == pos) { return -1 - pos; }
                sb.Append(src.Substring(pos, stop2 - pos));
                pos = stop2;
            }
        }
        return -1 - pos;
    }

    /// 就地解析 [from, to) 的浮点 token。运算顺序与
    /// JsonValue.DoubleOf 完全一致（整数部分累乘、小数按 0.1 递减
    /// 权、指数逐次 ×/÷10），结果位级相同。
    static double DoubleInRange(byte[] buf, int from, int to) {
        int i = from;
        bool neg = false;
        if (i < to && (buf[i] & 255) == 45) { neg = true; i = i + 1; }
        else if (i < to && (buf[i] & 255) == 43) { i = i + 1; }
        double acc = 0.0;
        while (i < to) {
            int d = (buf[i] & 255) - 48;
            if (d < 0 || d > 9) { break; }
            acc = acc * 10.0 + (double)d;
            i = i + 1;
        }
        if (i < to && (buf[i] & 255) == 46) {
            i = i + 1;
            double scale = 0.1;
            while (i < to) {
                int d = (buf[i] & 255) - 48;
                if (d < 0 || d > 9) { break; }
                acc = acc + (double)d * scale;
                scale = scale * 0.1;
                i = i + 1;
            }
        }
        if (i < to && ((buf[i] & 255) == 101 || (buf[i] & 255) == 69)) {
            i = i + 1;
            bool eneg = false;
            if (i < to && (buf[i] & 255) == 45) { eneg = true; i = i + 1; }
            else if (i < to && (buf[i] & 255) == 43) { i = i + 1; }
            int ex = 0;
            while (i < to) {
                int d = (buf[i] & 255) - 48;
                if (d < 0 || d > 9) { break; }
                ex = ex * 10 + d;
                i = i + 1;
            }
            for (int k = 0; k < ex; k = k + 1) {
                if (eneg) { acc = acc / 10.0; } else { acc = acc * 10.0; }
            }
        }
        if (neg) { return 0.0 - acc; }
        return acc;
    }

    /// 从 `at` 开始的 4 位十六进制值；不足 4 位或含非十六进制
    /// 字符时返回 -1。
    static int Hex4(string src, int at, int limit) {
        if (at + 4 > limit) { return -1; }
        int acc = 0;
        for (int i = 0; i < 4; i = i + 1) {
            int d = Encoding.HexDigit(src[at + i] & 255);
            if (d < 0) { return -1; }
            acc = acc * 16 + d;
        }
        return acc;
    }

    /// 递归深度上限（与 JsonValue 一致）。
    static int MaxDepth = 512;

    // ---------- 访问器 ----------

    int SlotCount() { return slots.Count; }

    int NextSibling(int at) {
        if (at < 0) { return -1; }
        long a = slots[at].a;
        int k = (int)(a & 255);
        if (k == 4 || k == 5) { return at + (int)(slots[at].b >> 31); }
        return at + 1;
    }

    int FirstChild(int at) {
        if (at < 0) { return -1; }
        int k = (int)(slots[at].a & 255);
        if (k == 4 || k == 5) { return at + 1; }
        return -1;
    }

    int KindAt(int at) {
        int k = (int)(slots[at].a & 255);
        if (k == 6) { return 1; }
        if (k == 7) { return 2; }
        return k;
    }

    /// 注意：At 是从首个孩子跳 i 次 NextSibling 的链式访问，取第 i 个
    /// 孩子要 O(i) 次；把它当随机索引用在顺序循环里整体退化为 O(n²)
    /// （215 倍实测差距）。顺序遍历请走 FirstChild/NextSibling 链或
    /// <see cref="ForEachChild"/>，只有真正的随机访问才用 At。
    int At(int at, int i) {
        int c = at + 1;
        for (int j = 0; j < i; j = j + 1) { c = this.NextSibling(c); }
        return c;
    }

    /// <summary>按 tape 链遍历 <paramref name="at"/> 的全部孩子，逐个
    /// 调用 <paramref name="fn"/>（at 是孩子槽位；对象成员是值槽位，
    /// 键用 <see cref="KeyAt"/> 取）。顺序与源文档一致。这是 O(孩子数)
    /// 的正确遍历姿势：FirstChild/NextSibling 各走一步，不像
    /// <see cref="At"/> 顺序循环那样累计 O(n²)。非容器（标量）与
    /// 负槽位没有孩子，回调一次都不触发；fn 为 null 时静默返回。</summary>
    void ForEachChild(int at, JsonChildVisitor fn) {
        if (fn == null) { return; }
        int c = this.FirstChild(at);
        if (c < 0) { return; }
        int count = this.Count(at);
        for (int j = 0; j < count; j = j + 1) {
            fn(c);
            c = this.NextSibling(c);
        }
    }

    int Count(int at) {
        if (at < 0) { return 0; }
        return (int)(slots[at].b & 2147483647L);
    }

    int Get(int at, string key) {
        if (at < 0) { return -1; }
        long oa = slots[at].a;
        if ((int)(oa & 255) != 5) { return -1; }
        int p = (int)(oa >> 8);
        byte[] buf = this.buf;
        int kl = key.Length;
        while (p >= 0) {
            JsonPair pair = pairs[p];
            if (pair.keyLen == kl) {
                int ks = pair.keyStart;
                if (ks >= 0) {
                    int m = 0;
                    int ok = 1;
                    while (m < kl) {
                        if ((buf[ks + m] & 255) != (key[m] & 255)) { ok = 0; break; }
                        m = m + 1;
                    }
                    if (ok != 0) { return pair.valueSlot; }
                } else if (escPool[pair.keyLen] == key) {
                    return pair.valueSlot;
                }
            }
            p = pair.nextPair;
        }
        return -1;
    }

    bool Has(int at, string key) { return this.Get(at, key) >= 0; }

    string StrOfSlot(int at) {
        long a = slots[at].a;
        int start = (int)(a >> 8);
        if (start >= 0) { return src.Substring(start, (int)slots[at].b); }
        return escPool[(int)slots[at].b];
    }

    int IntAt(int at, int dflt) {
        if (at < 0) { return dflt; }
        int k = (int)(slots[at].a & 255);
        if (k == 2) { return (int)slots[at].b; }
        if (k == 7) { return (int)NativeMemory.AsF64(slots[at].b); }
        if (k == 1) { return 1; }
        if (k == 6) { return 0; }
        return dflt;
    }

    long LongAt(int at, long dflt) {
        if (at < 0) { return dflt; }
        int k = (int)(slots[at].a & 255);
        if (k == 2) { return slots[at].b; }
        if (k == 7) { return (long)NativeMemory.AsF64(slots[at].b); }
        if (k == 1) { return 1L; }
        if (k == 6) { return 0L; }
        return dflt;
    }

    double DoubleAt(int at, double dflt) {
        if (at < 0) { return dflt; }
        int k = (int)(slots[at].a & 255);
        if (k == 2) { return (double)slots[at].b; }
        if (k == 7) { return NativeMemory.AsF64(slots[at].b); }
        if (k == 1) { return 1.0; }
        if (k == 6) { return 0.0; }
        return dflt;
    }

    string StrAt(int at, string dflt) {
        if (at < 0) { return dflt; }
        long a = slots[at].a;
        int k = (int)(a & 255);
        if (k == 3) {
            int start = (int)(a >> 8);
            if (start >= 0) { return src.Substring(start, (int)slots[at].b); }
            return escPool[(int)slots[at].b];
        }
        if (k == 2) { return Convert.ToString(slots[at].b); }
        if (k == 7) { return Convert.ToString(NativeMemory.AsF64(slots[at].b)); }
        if (k == 1) { return "true"; }
        if (k == 6) { return "false"; }
        return dflt;
    }

    bool BoolAt(int at, bool dflt) {
        if (at < 0) { return dflt; }
        int k = (int)(slots[at].a & 255);
        if (k == 1) { return true; }
        if (k == 6) { return false; }
        if (k == 2) { return slots[at].b != 0; }
        if (k == 7) { return (long)NativeMemory.AsF64(slots[at].b) != 0L; }
        if (k == 3) { return this.StrOfSlot(at) == "true"; }
        return dflt;
    }

    string KeyAt(int at, int i) {
        int p = (int)(slots[at].a >> 8);
        int n = 0;
        while (p >= 0 && n < i) { p = pairs[p].nextPair; n = n + 1; }
        if (p < 0) { return ""; }
        int ks = pairs[p].keyStart;
        if (ks < 0) { return escPool[pairs[p].keyLen]; }
        return src.Substring(ks, pairs[p].keyLen);
    }

    int ValAt(int at, int i) {
        int p = (int)(slots[at].a >> 8);
        int n = 0;
        while (p >= 0 && n < i) { p = pairs[p].nextPair; n = n + 1; }
        if (p < 0) { return -1; }
        return pairs[p].valueSlot;
    }

    string ToJson() {
        StringBuilder sb = new StringBuilder();
        this.WriteSlot(sb, this.root);
        return sb.ToString();
    }

    void WriteSlot(StringBuilder sb, int at) {
        long a = slots[at].a;
        int k = (int)(a & 255);
        if (k == 0) { sb.Append("null"); return; }
        if (k == 1) { sb.Append("true"); return; }
        if (k == 6) { sb.Append("false"); return; }
        if (k == 2) { sb.Append(Convert.ToString(slots[at].b)); return; }
        if (k == 7) { sb.Append(Convert.ToString(NativeMemory.AsF64(slots[at].b))); return; }
        if (k == 3) {
            sb.Append("\"");
            sb.Append(Encoding.JsonEscape(this.StrOfSlot(at)));
            sb.Append("\"");
            return;
        }
        long wb = slots[at].b;
        int count = (int)(wb & 2147483647L);
        if (k == 4) {
            sb.Append("[");
            int c = at + 1;
            for (int j = 0; j < count; j = j + 1) {
                if (j > 0) { sb.Append(","); }
                this.WriteSlot(sb, c);
                c = this.NextSibling(c);
            }
            sb.Append("]");
            return;
        }
        sb.Append("{");
        int p = (int)(a >> 8);
        bool first = true;
        while (p >= 0) {
            if (!first) { sb.Append(","); }
            first = false;
            sb.Append("\"");
            int ks = pairs[p].keyStart;
            string key = ks >= 0 ? src.Substring(ks, pairs[p].keyLen)
                : escPool[pairs[p].keyLen];
            sb.Append(Encoding.JsonEscape(key));
            sb.Append("\":");
            this.WriteSlot(sb, pairs[p].valueSlot);
            p = pairs[p].nextPair;
        }
        sb.Append("}");
    }
}
