using System;

namespace System;

/// <summary>
/// 二进制 IO 用的堆外原始内存（ByteBuffer、数据库页、网络
/// 组帧）。地址是普通 nint，不进入 ARC 对象
/// 机制，因此热路径的字节级循环开销与等效的 C 代码相同。
///
/// 这里每个方法都是编译器内建函数：这些声明是为了
/// 让检查器能对调用做类型检查（ARC 也能跟踪 GetString 返回的字符串），
/// 但 irgen 将每个调用降低为单个 libc 调用——所命名的
/// 库实际上从未被调用或链接。
///
/// 标量访问是 <c>Span&lt;T&gt;</c> 的职责：<c>new Span&lt;int&gt;(p, n)</c>
/// 将原始地址视图化，并以小端、无对齐要求的
/// 类型化读写进行索引。
///
/// 安全约定：地址必须来自 <see cref="Alloc"/>（或
/// ByteBuffer.Raw() 之类的固定缓冲区），并且不能在
/// <see cref="Free"/> 之后继续使用。偏移/长度不做边界检查——由调用方
/// 负责边界，与任何 FFI 缓冲区一样。
/// </summary>
class NativeMemory {
    /// 分配 `size` 字节并清零；返回其地址。
    /// crt ABI：由 Zan 运行时（crt-transition/runtime_core.zan）提供
    /// `zan_alloc`；过渡期 C 实现见 zanstubs.c。
    [DllImport("crt", EntryPoint = "zan_alloc")]
    static extern nint Alloc(int size);

    /// 释放从 Alloc 获得的地址。释放 0 为无操作。
    [DllImport("crt", EntryPoint = "zan_free")]
    static extern void Free(nint p);

    /// 将 n 字节从 src 复制到 dst（允许重叠，memmove 语义）。
    /// crt ABI：第十三批起 `zan_copy`（Zan 运行时/C 别名二选一）。
    [DllImport("crt", EntryPoint = "zan_copy")]
    static extern void Copy(nint dst, nint src, int n);

    /// 用 v 的低 8 位填充 p 处的 n 字节。
    [DllImport("crt", EntryPoint = "zan_fill")]
    static extern void Fill(nint p, int v, int n);

    /// memcmp：a 与 b 前 n 字节的比较序 <0 / 0 / >0。
    [DllImport("crt", EntryPoint = "zan_compare")]
    static extern int Compare(nint a, nint b, int n);

    /// memchr：在 p+off 起的 n 字节内查找字节 b（取低 8 位），
    /// 命中返回相对 p 的偏移，未命中返回 -1。
    [DllImport("crt", EntryPoint = "zan_find")]
    static extern int Find(nint p, int off, int b, int n);

    /// 将 p+off 处的 len 字节复制为新的 ARC 托管字符串。
    [DllImport("crt", EntryPoint = "zan_get_string")]
    static extern string GetString(nint p, int off, int len);

    /// 将 s 的前 len 字节复制到 p+off（不写 NUL 终止符）。
    [DllImport("crt", EntryPoint = "zan_put_string")]
    static extern void PutString(nint p, int off, string s, int len);

    /// p 处 len 字节的 CRC-32（IEEE，poly 0xEDB88320）。
    /// crt ABI：`zan_crc32`（同上，Zan 运行时/C 过渡实现二选一）。
    [DllImport("crt", EntryPoint = "zan_crc32")]
    static extern int Crc32(nint p, int len);

    /// 对 p 处 len 字节计算 FIPS 180-4 SHA-256，无硬件加速时返回 null 回退纯 Zan。
    public static string Sha256(nint p, int len) {
        return null;
    }

    /// 对 p 处 len 字节计算 FIPS 180-4 SHA-1，无硬件加速时返回 null 回退纯 Zan。
    public static string Sha1(nint p, int len) {
        return null;
    }

    public static string Base64Encode(byte[] inArray, long len) {
        return null;
    }

    public static long Base64Decode(byte[] dst, string s, long len) {
        return -1L;
    }

    public static long AesEcbBlock(string key, int keyLen, string in16, byte[] outb) {
        return -1L;
    }

    public static long AesCbcEncrypt(byte[] dst, string src, long size, string key, int keybits, string iv) { return -1L; }
    public static long AesCbcDecrypt(byte[] dst, string src, long size, string key, int keybits, string iv) { return -1L; }
    public static long AesCtrCrypt(byte[] dst, string src, long size, string key, int keybits, string counter) { return -1L; }
    public static long AesGcmEncrypt(string key, int keybits, string iv, string aad, long aadLen, string inBuf, long inLen, byte[] outBuf, byte[] tag16) { return -1L; }
    public static long AesGcmDecrypt(string key, int keybits, string iv, string aad, long aadLen, string inBuf, long inLen, string tag16, byte[] outBuf) { return -1L; }
    public static long AesGcmInit(nint ctxBuf, long ctxLen, string key, int keybits) { return -1L; }
    public static long AesGcmEncryptCtx(nint ctxBuf, string iv, nint aad, long aadLen, nint inBuf, long inLen, nint outBuf, nint tag16) { return -1L; }
    public static long AesGcmDecryptCtx(nint ctxBuf, string iv, nint aad, long aadLen, nint inBuf, long inLen, nint tag16, byte[] outBuf) { return -1L; }
    public static long GhashBlock(string h, string x, string y) { return -1L; }
    public static long GhashUpdate(string h, string data, long len, string y) { return -1L; }
    public static long RsaModPow(string baseVal, long bLen, string exp, long eLen, string mod, long mLen, byte[] outBuf) { return -1L; }
    public static long RsaCrtModPow(byte[] msg, long mLen, string p, long pLen, string q, long qLen, string dp, long dpLen, string dq, long dqLen, string qinv, long qinvLen, byte[] outBuf, long outLen) { return -1L; }
    public static string Sm3(string ptr, long size) { return null; }
    public static long X25519(string scalar, string point, byte[] outBuf) { return -1L; }
}
