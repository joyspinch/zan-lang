using System;

namespace System;

// 提供有关 Zan 运行时安装和运行所在环境的信息，与现代跨平台标准一致。
public class RuntimeInformation {
    // 获取当前正在运行的运行时实现的名称和版本。
    public static string FrameworkDescription {
        get {
            return "Zan 0.2";
        }
    }

    // 获取描述应用程序正在其上运行的操作系统的字符串。
    public static string OSDescription {
        get {
            #if WINDOWS
            return "Windows";
            #elif LINUX
            return "Linux";
            #elif MACOS
            return "macOS";
            #elif IOS
            return "iOS";
            #elif ANDROID
            return "Android";
            #elif WASI
            return "WASI";
            #else
            return "Unknown";
            #endif
        }
    }

    // 获取当前正在运行的进程的进程体系结构。
    public static string ProcessArchitecture {
        get {
            #if ARCH_ARM64
            return "Arm64";
            #elif ARCH_X86_64
            return "X64";
            #elif ARCH_ARM
            return "Arm";
            #elif ARCH_X86
            return "X86";
            #elif ARCH_WASM32
            return "Wasm32";
            #else
            return "X64";
            #endif
        }
    }

    // 获取当前应用程序正在其上运行的基础操作系统的体系结构。
    public static string OSArchitecture {
        get {
            return ProcessArchitecture;
        }
    }

    // 获取表示当前平台的运行时标识符 (RID)。
    public static string RuntimeIdentifier {
        get {
            #if WINDOWS
            #if ARCH_ARM64
            return "win-arm64";
            #else
            return "win-x64";
            #endif
            #elif LINUX
            #if ARCH_ARM64
            return "linux-arm64";
            #else
            return "linux-x64";
            #endif
            #elif MACOS
            #if ARCH_ARM64
            return "osx-arm64";
            #else
            return "osx-x64";
            #endif
            #elif IOS
            return "ios-arm64";
            #elif ANDROID
            return "android-arm64";
            #elif WASI
            return "wasi-wasm32";
            #else
            return "generic";
            #endif
        }
    }

    // 指示当前应用程序是否正在指定操作系统平台上运行。
    public static bool IsOSPlatform(string osPlatform) {
        if (osPlatform == null || osPlatform == "") { return false; }
        string cur = OSDescription;
        return cur == osPlatform;
    }
}
