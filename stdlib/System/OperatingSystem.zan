using System;

namespace System;

/// <summary>
/// 提供有关当前操作系统平台的信息，符合现代 C# (System.OperatingSystem) 标准。
/// 交叉编译时静态解析为目标系统平台。
/// </summary>
class OperatingSystem {
    /// <summary>指示当前应用程序是否在 Windows 上运行。</summary>
    public static bool IsWindows() {
        #if WINDOWS
        return true;
        #else
        return false;
        #endif
    }

    /// <summary>指示当前应用程序是否在 Linux 上运行。</summary>
    public static bool IsLinux() {
        #if LINUX
        return true;
        #else
        return false;
        #endif
    }

    /// <summary>指示当前应用程序是否在 macOS 上运行。</summary>
    public static bool IsMacOS() {
        #if MACOS
        return true;
        #else
        return false;
        #endif
    }

    /// <summary>指示当前应用程序是否在 WebAssembly / WASI 运行。</summary>
    public static bool IsWasi() {
        #if WASI
        return true;
        #else
        return false;
        #endif
    }

    /// <summary>指示当前应用程序是否在 WebAssembly 32 位环境运行。</summary>
    public static bool IsWasm32() {
        #if WASM32
        return true;
        #else
        return false;
        #endif
    }

    /// <summary>指示当前系统是否使用 musl libc。</summary>
    public static bool IsMusl() {
        #if MUSL
        return true;
        #else
        return false;
        #endif
    }

    /// <summary>指示当前系统架构是否为 RISC-V 64。</summary>
    public static bool IsRiscv64() {
        #if RISCV64
        return true;
        #else
        return false;
        #endif
    }

    /// <summary>返回当前操作系统标识（"windows" | "linux" | "macos" | "wasi"）。</summary>
    public static string Platform {
        get {
            #if WINDOWS
            return "windows";
            #elif MACOS
            return "macos";
            #elif WASI
            return "wasi";
            #else
            return "linux";
            #endif
        }
    }

    /// <summary>根据平台名称判断是否匹配当前平台（不区分大小写，如 "windows", "linux", "osx", "macos", "wasi"）。</summary>
    public static bool IsOSPlatform(string platform) {
        if (platform == null) { return false; }
        string p = platform.ToLower();
        if (p == "windows" || p == "win") { return IsWindows(); }
        if (p == "linux") { return IsLinux(); }
        if (p == "macos" || p == "osx") { return IsMacOS(); }
        if (p == "wasi" || p == "wasm") { return IsWasi(); }
        return false;
    }
}
