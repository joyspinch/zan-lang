using System;

namespace System;

// 提供有关当前操作系统平台的信息，符合现代 C# (System.OperatingSystem) 标准。
// 交叉编译时静态解析为目标系统平台。
class OperatingSystem {
    // 指示当前应用程序是否在 Windows 上运行。
    public static bool IsWindows() {
        #if WINDOWS
        return true;
        #else
        return false;
        #endif
    }

    // 指示当前应用程序是否在 Linux 上运行。
    public static bool IsLinux() {
        #if LINUX
        return true;
        #else
        return false;
        #endif
    }

    // 指示当前应用程序是否在 macOS 上运行。
    public static bool IsMacOS() {
        #if MACOS
        return true;
        #else
        return false;
        #endif
    }

    // 指示当前应用程序是否在 WebAssembly / WASI 运行。
    public static bool IsWasi() {
        #if WASI
        return true;
        #else
        return false;
        #endif
    }

    // 指示当前应用程序是否在 WebAssembly 32 位环境运行。
    public static bool IsWasm32() {
        #if WASM32
        return true;
        #else
        return false;
        #endif
    }

    // 指示当前系统是否使用 musl libc。
    public static bool IsMusl() {
        #if MUSL
        return true;
        #else
        return false;
        #endif
    }

    // 指示当前系统架构是否为 RISC-V 64。
    public static bool IsRiscv64() {
        #if RISCV64
        return true;
        #else
        return false;
        #endif
    }

    // 指示当前应用程序是否在 iOS 上运行。
    public static bool IsIos() {
        #if IOS
        return true;
        #else
        return false;
        #endif
    }

    // 指示当前应用程序是否在 Android 上运行
    // （Linux 内核 + bionic；ANDROID 目标同时定义 LINUX，
    // 面向 LINUX 写的程序保持可编译）。
    public static bool IsAndroid() {
        #if ANDROID
        return true;
        #else
        return false;
        #endif
    }

    // 指示当前应用程序是否在 OpenHarmony 上运行
    // （musl libc；OHOS 目标同时定义 LINUX 与 MUSL）。
    public static bool IsOhos() {
        #if OHOS
        return true;
        #else
        return false;
        #endif
    }

    // 返回当前操作系统标识（"windows" | "linux" | "macos" | "ios" | "android" | "ohos" | "wasi"）。
    public static string Platform {
        get {
            #if WINDOWS
            return "windows";
            #elif MACOS
            return "macos";
            #elif IOS
            return "ios";
            #elif ANDROID
            return "android";
            #elif OHOS
            return "ohos";
            #elif WASI
            return "wasi";
            #else
            return "linux";
            #endif
        }
    }

    // 根据平台名称判断是否匹配当前平台（不区分大小写，如 "windows", "linux", "osx", "macos", "ios", "android", "ohos", "wasi"）。
    public static bool IsOSPlatform(string platform) {
        if (platform == null) { return false; }
        string p = platform.ToLower();
        if (p == "windows" || p == "win") { return IsWindows(); }
        if (p == "linux") { return IsLinux(); }
        if (p == "macos" || p == "osx") { return IsMacOS(); }
        if (p == "ios") { return IsIos(); }
        if (p == "android") { return IsAndroid(); }
        if (p == "ohos") { return IsOhos(); }
        if (p == "wasi" || p == "wasm") { return IsWasi(); }
        return false;
    }
}
