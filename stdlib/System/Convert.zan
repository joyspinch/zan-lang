using System;
using System.Text;
using System.Runtime.CompilerServices;

namespace System;

// 基础数据类型与常用编码格式转换工具（纯 Zan 实现，零外部依赖）。
// 对齐 .NET System.Convert 标准，用于 Base64、Hex 等纯数据编码，
// 避免非加密用途被误导引入底层 C 密码学库。
[Intrinsic]
public class Convert {

    // RFC 4648 标准 Base64 字母表
    public static string BASE64_ALPHA() {
        return "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
    }

    // 将字节数组编码为 Base64 字符串。
    public static string ToBase64String(byte[] inArray) {
        if (inArray == null || inArray.Length == 0) { return ""; }
        string hw = NativeMemory.Base64Encode(inArray, (long)inArray.Length);
        if (hw != null) { return hw; }

        int len = inArray.Length;
        int outLen = ((len + 2) / 3) * 4;
        byte[] outBuf = new byte[outLen];
        Convert.ToBase64Chars(inArray, 0, len, outBuf, 0);
        return outBuf.ToStr(0, outLen);
    }

    static int[] hexDecLut = null;
    static ushort[] hexEncLut = null;

    private static ushort[] GetHexEncLut() {
        ushort[] t = Convert.hexEncLut;
        if (t != null) { return t; }
        ushort[] lut = new ushort[256];
        for (int v = 0; v < 256; v = v + 1) {
            int hi = v >> 4;
            int lo = v & 15;
            int hc = hi < 10 ? 48 + hi : 87 + hi;
            int lc = lo < 10 ? 48 + lo : 87 + lo;
            lut[v] = (ushort)(hc | (lc << 8));
        }
        Convert.hexEncLut = lut;
        return lut;
    }

    private static int[] GetHexDecLut() {
        int[] t = Convert.hexDecLut;
        if (t != null) { return t; }
        int[] lut = new int[256];
        for (int i = 0; i < 256; i = i + 1) { lut[i] = -1; }
        for (int i = 0; i < 10; i = i + 1) { lut[48 + i] = i; }
        for (int i = 0; i < 6; i = i + 1) {
            lut[65 + i] = 10 + i;
            lut[97 + i] = 10 + i;
        }
        Convert.hexDecLut = lut;
        return lut;
    }

    // 高吞吐零分配 Base64 编码：将 inArray[inOff..inOff+inLen] 编码直接写入 outBuf[outOff..]。
    // 返回实际写入 outBuf 的字节数。若缓冲区不足返回 -1。
    public static int ToBase64Chars(byte[] inArray, int inOff, int inLen, byte[] outBuf, int outOff) {
        if (inArray == null || inLen <= 0) { return 0; }
        if (outBuf == null) { return -1; }
        int req = ((inLen + 2) / 3) * 4;
        if (outOff < 0 || outOff + req > outBuf.Length) { return -1; }

        int di = outOff;
        int i = inOff;
        int end = inOff + inLen;

        // 硬件 AVX2/LUT 快路径：保留最后 1..3 字节在 Zan 侧写出，
        // 使 C 侧尾 NUL 写入安全落在 outBuf[outOff + prefixOut] 内并随即被尾块覆盖。
        if (inLen >= 6 && inOff >= 0 && end <= inArray.Length) {
            int prefixIn = ((inLen - 1) / 3) * 3;
            int prefixOut = (prefixIn / 3) * 4;
            long written = NativeMemory.Base64EncodeTo(
                (nint)inArray + (nint)inOff, (long)prefixIn, (nint)outBuf + (nint)outOff);
            if (written == (long)prefixOut) {
                i = inOff + prefixIn;
                di = outOff + prefixOut;
            }
        }

        string a = BASE64_ALPHA();
        while (i + 3 <= end) {
            int n = ((inArray[i] & 255) << 16) | ((inArray[i + 1] & 255) << 8) | (inArray[i + 2] & 255);
            outBuf[di]     = (byte)(a[(n >> 18) & 63] & 255);
            outBuf[di + 1] = (byte)(a[(n >> 12) & 63] & 255);
            outBuf[di + 2] = (byte)(a[(n >> 6) & 63] & 255);
            outBuf[di + 3] = (byte)(a[n & 63] & 255);
            di = di + 4;
            i = i + 3;
        }
        int rem = end - i;
        if (rem == 1) {
            int n = (inArray[i] & 255) << 16;
            outBuf[di]     = (byte)(a[(n >> 18) & 63] & 255);
            outBuf[di + 1] = (byte)(a[(n >> 12) & 63] & 255);
            outBuf[di + 2] = (byte)61; // '='
            outBuf[di + 3] = (byte)61;
            di = di + 4;
        } else if (rem == 2) {
            int n = ((inArray[i] & 255) << 16) | ((inArray[i + 1] & 255) << 8);
            outBuf[di]     = (byte)(a[(n >> 18) & 63] & 255);
            outBuf[di + 1] = (byte)(a[(n >> 12) & 63] & 255);
            outBuf[di + 2] = (byte)(a[(n >> 6) & 63] & 255);
            outBuf[di + 3] = (byte)61; // '='
            di = di + 4;
        }
        return di - outOff;
    }

    // 单个 Base64 字符解码为数值 (0-63)，非法字符返回 -1
    public static int DecB64(int c) {
        if (c >= 65 && c <= 90) { return c - 65; }
        if (c >= 97 && c <= 122) { return c - 71; }
        if (c >= 48 && c <= 57) { return c + 4; }
        if (c == 43) { return 62; }
        if (c == 47) { return 63; }
        return -1;
    }

    // 将 Base64 字符串解码为字节数组。
    public static byte[] FromBase64String(string s) {
        if (s == null || s.Length == 0) { return new byte[0]; }
        int len = s.Length;
        int pad = 0;
        if (len > 0 && s[len - 1] == 61) { pad = pad + 1; }
        if (len > 1 && s[len - 2] == 61) { pad = pad + 1; }

        // (len*3)/4 按 64 位算：int 乘法在 len > 715827882
        // 时会回绕成负值，分配出错误长度的缓冲。输出上限 1GB，超长拒入
        // ——返回 null，与本函数"非法输入返回 null"的既有约定一致。
        long outLenL = ((long)len * 3) / 4 - pad;
        if (outLenL < 0) { outLenL = 0; }
        if (outLenL > 1073741824) { return null; }
        int outLen = (int)outLenL;
        byte[] outb = new byte[outLen];

        long written = NativeMemory.Base64Decode(outb, s, (long)len);
        if (written >= 0) {
            return outb;
        }
        if (written < 0 && (len % 4 == 0)) {
            return null;
        }

        int si = 0;
        int di = 0;
        while (si + 4 <= len && di < outLen) {
            int c0 = DecB64(s[si] & 255);
            int c1 = DecB64(s[si+1] & 255);
            int c2 = (s[si+2] == 61) ? 0 : DecB64(s[si+2] & 255);
            int c3 = (s[si+3] == 61) ? 0 : DecB64(s[si+3] & 255);

            if (c0 < 0 || c1 < 0 || c2 < 0 || c3 < 0) { return null; }

            int n = (c0 << 18) | (c1 << 12) | (c2 << 6) | c3;
            if (di < outLen) { outb[di] = (byte)((n >> 16) & 255); di = di + 1; }
            if (di < outLen) { outb[di] = (byte)((n >> 8) & 255); di = di + 1; }
            if (di < outLen) { outb[di] = (byte)(n & 255); di = di + 1; }
            si = si + 4;
        }
        return outb;
    }

    // 高吞吐零分配 Base64 解码：将 inBuf[inOff..inOff+inLen] 中的 ASCII 字符解码直接写入 outBuf[outOff..]。
    // 返回实际写入 outBuf 的字节数。若格式非法或缓冲区不足返回 -1。
    public static int FromBase64Chars(byte[] inBuf, int inOff, int inLen, byte[] outBuf, int outOff) {
        if (inBuf == null || inLen <= 0) { return 0; }
        if (outBuf == null) { return -1; }

        int pad = 0;
        int end = inOff + inLen;
        if (inLen > 0 && inBuf[end - 1] == 61) { pad = pad + 1; }
        if (inLen > 1 && inBuf[end - 2] == 61) { pad = pad + 1; }

        long outLenL = ((long)inLen * 3) / 4 - pad;
        if (outLenL < 0) { outLenL = 0; }
        int req = (int)outLenL;
        if (outOff < 0 || outOff + req > outBuf.Length) { return -1; }

        // 硬件 AVX2/256-LUT 快路径（标准 4 字节对齐 Base64，含 0/1/2 位 '=' 填充）。
        if ((inLen & 3) == 0 && inOff >= 0 && end <= inBuf.Length) {
            long written = NativeMemory.Base64Decode(
                (nint)outBuf + (nint)outOff, (nint)inBuf + (nint)inOff, (long)inLen);
            if (written == (long)req) { return req; }
            return -1;
        }

        int si = inOff;
        int di = outOff;
        int validEnd = end - pad;

        while (si + 4 <= validEnd) {
            int c0 = DecB64(inBuf[si] & 255);
            int c1 = DecB64(inBuf[si + 1] & 255);
            int c2 = DecB64(inBuf[si + 2] & 255);
            int c3 = DecB64(inBuf[si + 3] & 255);
            if (c0 < 0 || c1 < 0 || c2 < 0 || c3 < 0) { return -1; }

            int n = (c0 << 18) | (c1 << 12) | (c2 << 6) | c3;
            outBuf[di]     = (byte)((n >> 16) & 255);
            outBuf[di + 1] = (byte)((n >> 8) & 255);
            outBuf[di + 2] = (byte)(n & 255);
            di = di + 3;
            si = si + 4;
        }

        if (pad > 0 && si + 4 == end) {
            int c0 = DecB64(inBuf[si] & 255);
            int c1 = DecB64(inBuf[si + 1] & 255);
            if (c0 < 0 || c1 < 0) { return -1; }

            if (pad == 2) {
                int n = (c0 << 18) | (c1 << 12);
                outBuf[di] = (byte)((n >> 16) & 255);
                di = di + 1;
            } else if (pad == 1) {
                int c2 = DecB64(inBuf[si + 2] & 255);
                if (c2 < 0) { return -1; }
                int n = (c0 << 18) | (c1 << 12) | (c2 << 6);
                outBuf[di]     = (byte)((n >> 16) & 255);
                outBuf[di + 1] = (byte)((n >> 8) & 255);
                di = di + 2;
            }
        }

        return di - outOff;
    }

    // 将字节数组编码为小写十六进制文本（零中间字符串分配）。
    public static string ToHexString(byte[] inArray) {
        if (inArray == null || inArray.Length == 0) { return ""; }
        return Convert.ToHexString(inArray, 0, inArray.Length);
    }

    // ---- A443：Convert.ToString 公开面进 stdlib ----
    // 这组重载此前只存在于编译器内建特判（irgen_call.c 的成员表里没有
    // ToString），IDE 符号索引补全补不出它。现在真方法住在 stdlib：
    // 检查器走常规重载解析，内建特判经 !zan_type_defines /
    // !UserDefinesClsMember 守卫自动让路。体内委托实例 x.ToString()——
    // 两侧 lowering 现成，渲染与原内建逐字节一致（bool 小写、浮点最短
    // 往返、整型 itoa、无符号原宽）。object/枚举/数组/可空形状不在此
    // 声明，继续走内建（object 指针拷贝、可空 emit_to_cstr_u 同现状）。
    public static string ToString(object o) { return o == null ? "" : o.ToString(); }
    public static string ToString(string s) { return s; }
    public static string ToString(char c) { return c.ToString(); }
    public static string ToString(bool b) { return b.ToString(); }
    public static string ToString(int v) { return v.ToString(); }
    public static string ToString(long v) { return v.ToString(); }
    public static string ToString(nint v) { return ((long)v).ToString(); }
    public static string ToString(short v) { return v.ToString(); }
    public static string ToString(byte v) { return v.ToString(); }
    public static string ToString(sbyte v) { return v.ToString(); }
    public static string ToString(ushort v) { return v.ToString(); }
    public static string ToString(uint v) { return v.ToString(); }
    public static string ToString(ulong v) { return v.ToString(); }
    public static string ToString(double v) { return v.ToString(); }
    public static string ToString(float v) { return v.ToString(); }

    // 将字节数组切片编码为小写十六进制文本（256 项双字符 ushort LUT + 8 路定长 Span 批量写，零位运算分支）。
    public static string ToHexString(byte[] inArray, int offset, int length) {
        if (inArray == null || length <= 0) { return ""; }
        if (offset < 0) { offset = 0; }
        int end = offset + length;
        if (end > inArray.Length) { end = inArray.Length; }
        int realLen = end - offset;
        if (realLen <= 0) { return ""; }
        byte[] buf = new byte[realLen * 2];
        ushort[] lut = Convert.GetHexEncLut();
        nint srcPtr = (nint)inArray + (nint)offset;
        nint dstPtr = (nint)buf;
        nint lutPtr = (nint)lut;
        Span<ushort> lt = new Span<ushort>(lutPtr, 256);
        int i = 0;
        while (i + 8 <= realLen) {
            Span<byte> s = new Span<byte>(srcPtr + (nint)i, 8);
            Span<ushort> d = new Span<ushort>(dstPtr + (nint)(i * 2), 8);
            d[0] = lt[s[0] & 255];
            d[1] = lt[s[1] & 255];
            d[2] = lt[s[2] & 255];
            d[3] = lt[s[3] & 255];
            d[4] = lt[s[4] & 255];
            d[5] = lt[s[5] & 255];
            d[6] = lt[s[6] & 255];
            d[7] = lt[s[7] & 255];
            i = i + 8;
        }
        int di = i * 2;
        while (i < realLen) {
            int v = inArray[offset + i] & 255;
            int hi = v >> 4;
            int lo = v & 15;
            buf[di]     = (byte)(hi < 10 ? 48 + hi : 87 + hi);
            buf[di + 1] = (byte)(lo < 10 ? 48 + lo : 87 + lo);
            i = i + 1;
            di = di + 2;
        }
        return buf.ToStr(0, realLen * 2);
    }

    // 单个十六进制字符转数值
    public static int Nibble(int c) {
        if (c >= 48 && c <= 57) { return c - 48; }
        if (c >= 97 && c <= 102) { return c - 87; }
        if (c >= 65 && c <= 70) { return c - 55; }
        return 0;
    }

    // 倒十六进制字符串解码为字节数组（256 项查找表 + 4 路定长 Span 消边界检查，单趟校验与解码）。
    public static byte[] FromHexString(string hex) {
        if (hex == null || hex.Length == 0) { return new byte[0]; }
        int len = hex.Length;
        if ((len & 1) != 0) {
            throw new ArgumentException(
                "FromHexString: odd length " + hex.Length);
        }
        int n = len >> 1;
        byte[] outb = new byte[n];
        int[] lut = Convert.GetHexDecLut();
        nint srcPtr = (nint)hex;
        nint dstPtr = (nint)outb;
        nint lutPtr = (nint)lut;
        int i = 0;
        int si = 0;
        while (i + 4 <= n) {
            Span<byte> s = new Span<byte>(srcPtr + (nint)si, 8);
            Span<byte> d = new Span<byte>(dstPtr + (nint)i, 4);
            Span<int> t = new Span<int>(lutPtr, 256);
            int h0 = t[s[0] & 255]; int l0 = t[s[1] & 255];
            int h1 = t[s[2] & 255]; int l1 = t[s[3] & 255];
            int h2 = t[s[4] & 255]; int l2 = t[s[5] & 255];
            int h3 = t[s[6] & 255]; int l3 = t[s[7] & 255];
            if ((h0 | l0 | h1 | l1 | h2 | l2 | h3 | l3) < 0) {
                break;
            }
            d[0] = (byte)((h0 << 4) | l0);
            d[1] = (byte)((h1 << 4) | l1);
            d[2] = (byte)((h2 << 4) | l2);
            d[3] = (byte)((h3 << 4) | l3);
            i = i + 4;
            si = si + 8;
        }
        while (i < n) {
            int hi = lut[hex[si] & 255];
            if (hi < 0) {
                throw new ArgumentException("FromHexString: invalid hex character at " + si);
            }
            int lo = lut[hex[si + 1] & 255];
            if (lo < 0) {
                throw new ArgumentException("FromHexString: invalid hex character at " + (si + 1));
            }
            outb[i] = (byte)((hi << 4) | lo);
            i = i + 1;
            si = si + 2;
        }
        return outb;
    }
}
