using System;
using System.Interop;

namespace System;

// 提供创建、操作、搜索和排序数组的方法，对齐 C# System.Array 常用 API。
public class Array {
    // 返回指定类型的空数组。
    public static T[] Empty<T>() {
        return new T[0];
    }

    // byte[] 高速内存复制（硬件向量化 memmove）
    public static void Copy(byte[] src, int srcIdx, byte[] dst, int dstIdx, int length) {
        if (src == null) { throw new ArgumentNullException("src"); }
        if (dst == null) { throw new ArgumentNullException("dst"); }
        if (srcIdx < 0 || dstIdx < 0 || length < 0) { throw new ArgumentOutOfRangeException("length"); }
        if (srcIdx + length > src.Length || dstIdx + length > dst.Length) {
            throw new ArgumentException("offset and length out of bounds");
        }
        if (length == 0) { return; }
        NativeMemory.Copy((nint)dst + dstIdx, (nint)src + srcIdx, length);
    }

    // int[] 高速内存复制（硬件向量化 memmove）
    public static void Copy(int[] src, int srcIdx, int[] dst, int dstIdx, int length) {
        if (src == null) { throw new ArgumentNullException("src"); }
        if (dst == null) { throw new ArgumentNullException("dst"); }
        if (srcIdx < 0 || dstIdx < 0 || length < 0) { throw new ArgumentOutOfRangeException("length"); }
        if (srcIdx + length > src.Length || dstIdx + length > dst.Length) {
            throw new ArgumentException("offset and length out of bounds");
        }
        if (length == 0) { return; }
        NativeMemory.Copy((nint)dst + (nint)dstIdx * 4, (nint)src + (nint)srcIdx * 4, (nint)length * 4);
    }

    // long[] 高速内存复制（硬件向量化 memmove）
    public static void Copy(long[] src, int srcIdx, long[] dst, int dstIdx, int length) {
        if (src == null) { throw new ArgumentNullException("src"); }
        if (dst == null) { throw new ArgumentNullException("dst"); }
        if (srcIdx < 0 || dstIdx < 0 || length < 0) { throw new ArgumentOutOfRangeException("length"); }
        if (srcIdx + length > src.Length || dstIdx + length > dst.Length) {
            throw new ArgumentException("offset and length out of bounds");
        }
        if (length == 0) { return; }
        NativeMemory.Copy((nint)dst + (nint)dstIdx * 8, (nint)src + (nint)srcIdx * 8, (nint)length * 8);
    }

    // double[] 高速内存复制（硬件向量化 memmove）
    public static void Copy(double[] src, int srcIdx, double[] dst, int dstIdx, int length) {
        if (src == null) { throw new ArgumentNullException("src"); }
        if (dst == null) { throw new ArgumentNullException("dst"); }
        if (srcIdx < 0 || dstIdx < 0 || length < 0) { throw new ArgumentOutOfRangeException("length"); }
        if (srcIdx + length > src.Length || dstIdx + length > dst.Length) {
            throw new ArgumentException("offset and length out of bounds");
        }
        if (length == 0) { return; }
        NativeMemory.Copy((nint)dst + (nint)dstIdx * 8, (nint)src + (nint)srcIdx * 8, (nint)length * 8);
    }

    // bool[] 高速内存复制（硬件向量化 memmove）
    public static void Copy(bool[] src, int srcIdx, bool[] dst, int dstIdx, int length) {
        if (src == null) { throw new ArgumentNullException("src"); }
        if (dst == null) { throw new ArgumentNullException("dst"); }
        if (srcIdx < 0 || dstIdx < 0 || length < 0) { throw new ArgumentOutOfRangeException("length"); }
        if (srcIdx + length > src.Length || dstIdx + length > dst.Length) {
            throw new ArgumentException("offset and length out of bounds");
        }
        if (length == 0) { return; }
        NativeMemory.Copy((nint)dst + dstIdx, (nint)src + srcIdx, length);
    }

    public static void Copy(byte[] src, byte[] dst, int length) {
        Copy(src, 0, dst, 0, length);
    }

    public static void Copy(int[] src, int[] dst, int length) {
        Copy(src, 0, dst, 0, length);
    }

    public static void Copy(long[] src, long[] dst, int length) {
        Copy(src, 0, dst, 0, length);
    }

    public static void Copy(double[] src, double[] dst, int length) {
        Copy(src, 0, dst, 0, length);
    }

    public static void Copy(bool[] src, bool[] dst, int length) {
        Copy(src, 0, dst, 0, length);
    }

    // 从指定源索引开始，将源数组的一系列元素复制到目标数组（从指定目标索引开始，重叠安全）。
    public static void Copy<T>(T[] src, int srcIdx, T[] dst, int dstIdx, int length) {
        if (src == null) { throw new ArgumentNullException("src"); }
        if (dst == null) { throw new ArgumentNullException("dst"); }
        if (srcIdx < 0 || dstIdx < 0 || length < 0) { throw new ArgumentOutOfRangeException("length"); }
        if (srcIdx + length > src.Length || dstIdx + length > dst.Length) {
            throw new ArgumentException("offset and length out of bounds");
        }
        if (length == 0) { return; }
        if (src == dst && dstIdx > srcIdx && dstIdx < srcIdx + length) {
            int i = length - 1;
            while (i >= 0) {
                dst[dstIdx + i] = src[srcIdx + i];
                i = i - 1;
            }
            return;
        }
        int j = 0;
        while (j < length) {
            dst[dstIdx + j] = src[srcIdx + j];
            j = j + 1;
        }
    }

    // 将源数组的一系列元素复制到目标数组（从开头复制）。
    public static void Copy<T>(T[] src, T[] dst, int length) {
        Copy<T>(src, 0, dst, 0, length);
    }

    // 反转一维数组中元素的顺序。
    public static void Reverse<T>(T[] array) {
        if (array == null) { throw new ArgumentNullException("array"); }
        int i = 0;
        int j = array.Length - 1;
        while (i < j) {
            T tmp = array[i];
            array[i] = array[j];
            array[j] = tmp;
            i = i + 1;
            j = j - 1;
        }
    }

    // 原生零分配数组清零重载（memset 加速）
    public static void Clear(byte[] array, int index, int length) {
        if (array == null) { throw new ArgumentNullException("array"); }
        if (index < 0 || length < 0 || index + length > array.Length) {
            throw new ArgumentOutOfRangeException("index or length out of bounds");
        }
        if (length > 0) { NativeMemory.Fill((nint)array + (nint)index, 0, length); }
    }

    public static void Clear(int[] array, int index, int length) {
        if (array == null) { throw new ArgumentNullException("array"); }
        if (index < 0 || length < 0 || index + length > array.Length) {
            throw new ArgumentOutOfRangeException("index or length out of bounds");
        }
        if (length > 0) { NativeMemory.Fill((nint)array + (nint)index * 4, 0, (nint)length * 4); }
    }

    public static void Clear(long[] array, int index, int length) {
        if (array == null) { throw new ArgumentNullException("array"); }
        if (index < 0 || length < 0 || index + length > array.Length) {
            throw new ArgumentOutOfRangeException("index or length out of bounds");
        }
        if (length > 0) { NativeMemory.Fill((nint)array + (nint)index * 8, 0, (nint)length * 8); }
    }

    public static void Clear(double[] array, int index, int length) {
        if (array == null) { throw new ArgumentNullException("array"); }
        if (index < 0 || length < 0 || index + length > array.Length) {
            throw new ArgumentOutOfRangeException("index or length out of bounds");
        }
        if (length > 0) { NativeMemory.Fill((nint)array + (nint)index * 8, 0, (nint)length * 8); }
    }

    // 将数组中的一系列元素设为默认值。
    public static void Clear<T>(T[] array, int index, int length) {
        if (array == null) { throw new ArgumentNullException("array"); }
        if (index < 0 || length < 0 || index + length > array.Length) {
            throw new ArgumentOutOfRangeException("index or length out of bounds");
        }
        if (length == 0) { return; }
        T def = new T[1][0];
        int i = 0;
        while (i < length) {
            array[index + i] = def;
            i = i + 1;
        }
    }

    // 在一维数组中搜索指定对象，并返回第一个匹配项的从零开始的索引。未找到返回 -1。
    public static int IndexOf<T>(T[] array, T value) {
        if (array == null) { throw new ArgumentNullException("array"); }
        int i = 0;
        while (i < array.Length) {
            if (array[i] == value) {
                return i;
            }
            i = i + 1;
        }
        return -1;
    }

    // 对一维数组中的整数元素进行升序排序（内省排序，最坏 O(n log n)，不稳定）。
    public static void Sort(int[] array) {
        if (array == null) { return; }
        QuickSortInt(array, 0, array.Length - 1);
    }

    private static void QuickSortInt(int[] a, int lo, int hi) {
        if (hi <= lo) { return; }
        IntroSortIntArr(a, lo, hi, 2 * ListExtensions.FloorLog2(hi - lo + 1), true);
    }

    // 内省排序 + 分块无分支划分（BlockQuickSort / libc++ 位图划分思路）：每块 64 个
    // 元素先只做比较、把"放错边"的位置无分支地记进一个 64 位位图，再按位图成对
    // 交换。随机数据上划分的比较结果不可预测，经典 Hoare 划分每元素一次分支误预测；
    // 分块后比较不再驱动分支（5M 随机 int 0.29 s → 0.09 s 关检查 / 0.14 s 开检查，
    // libc++ std::sort 0.09 s）。
    // 重复元素：子区间左邻 a[lo-1] 是上一层枢轴、≤ 区间内一切元素；若它不小于
    // 本层枢轴（即相等），改用"等于归左"划分并整体跳过等值段——全等/少值输入 O(n)。
    // 只递归较小一侧（栈深 O(log n)）；深度超 2·log2(n) 改堆排序（最坏 O(n log n)）；
    // 24 个以内插入排序。
    static void IntroSortIntArr(int[] a, int lo, int hi, int depth, bool leftmost) {
        while (hi - lo >= 24) {
            if (depth == 0) {
                HeapSortIntArr(a, lo, hi);
                return;
            }
            depth = depth - 1;
            int mid = lo + (hi - lo) / 2;
            if (a[mid] < a[lo]) { int t = a[lo]; a[lo] = a[mid]; a[mid] = t; }
            if (a[hi] < a[mid]) { int t = a[mid]; a[mid] = a[hi]; a[hi] = t; }
            if (a[mid] < a[lo]) { int t = a[lo]; a[lo] = a[mid]; a[mid] = t; }
            int pv = a[mid]; a[mid] = a[lo]; a[lo] = pv;
            if (!leftmost && !(a[lo - 1] < pv)) {
                lo = PartitionIntArr(a, lo, hi, true) + 1;
                continue;
            }
            int pos = PartitionIntArr(a, lo, hi, false);
            if (pos - lo < hi - pos) {
                IntroSortIntArr(a, lo, pos - 1, depth, leftmost);
                lo = pos + 1;
                leftmost = false;
            } else {
                IntroSortIntArr(a, pos + 1, hi, depth, false);
                hi = pos - 1;
            }
        }
        for (int k = lo + 1; k <= hi; k = k + 1) {
            int v = a[k];
            int m = k - 1;
            while (m >= lo && v < a[m]) {
                a[m + 1] = a[m];
                m = m - 1;
            }
            a[m + 1] = v;
        }
    }

    // 以 a[lo] 为枢轴划分 [lo, hi]，返回枢轴最终下标。eqLeft=false：< p 归左、
    // 其余归右；eqLeft=true：p 不小于者（≤ p）归左、> p 归右。[first, last] 为
    // 未定区；lm 的第 k 位 = a[first + k] 放错了边，rm 的第 k 位 = a[last - k]
    // 放错了边。位图清零即该块已处理完，区间收缩一整块。
    static int PartitionIntArr(int[] a, int lo, int hi, bool eqLeft) {
        int p = a[lo];
        int first = lo + 1;
        int last = hi;
        ulong lm = 0;
        ulong rm = 0;
        ulong one = 1;
        while (true) {
            int rem = last - first + 1;
            int lsz = 64;
            int rsz = 64;
            bool fin = rem < 128;
            if (fin) {
                if (lm == 0 && rm == 0) { lsz = rem / 2; rsz = rem - lsz; }
                else if (lm == 0) { lsz = rem - 64; }
                else { rsz = rem - 64; }
            }
            if (lm == 0) {
                if (eqLeft) {
                    for (int k = 0; k < lsz; k = k + 1) { lm = lm | ((p < a[first + k] ? one : 0) << k); }
                } else {
                    for (int k = 0; k < lsz; k = k + 1) { lm = lm | ((a[first + k] < p ? 0 : one) << k); }
                }
            }
            if (rm == 0) {
                if (eqLeft) {
                    for (int k = 0; k < rsz; k = k + 1) { rm = rm | ((p < a[last - k] ? 0 : one) << k); }
                } else {
                    for (int k = 0; k < rsz; k = k + 1) { rm = rm | ((a[last - k] < p ? one : 0) << k); }
                }
            }
            while (lm != 0 && rm != 0) {
                int li = first + BitOperations.TrailingZeroCount(lm);
                int ri = last - BitOperations.TrailingZeroCount(rm);
                int t = a[li]; a[li] = a[ri]; a[ri] = t;
                lm = lm & (lm - 1);
                rm = rm & (rm - 1);
            }
            if (lm == 0) { first = first + lsz; }
            if (rm == 0) { last = last - rsz; }
            if (fin) { break; }
        }
        // 收尾：最后一块里剩下的放错边元素从远端（最高位）起依次换到边界上。
        if (lm != 0) {
            while (lm != 0) {
                int b = 63 - BitOperations.LeadingZeroCount(lm);
                lm = lm & ~(one << b);
                int li = first + b;
                int t = a[li]; a[li] = a[last]; a[last] = t;
                last = last - 1;
            }
            first = last + 1;
        }
        while (rm != 0) {
            int b = 63 - BitOperations.LeadingZeroCount(rm);
            rm = rm & ~(one << b);
            int ri = last - b;
            int t = a[ri]; a[ri] = a[first]; a[first] = t;
            first = first + 1;
        }
        int pos = first - 1;
        a[lo] = a[pos];
        a[pos] = p;
        return pos;
    }

    static void HeapSortIntArr(int[] a, int lo, int hi) {
        int n = hi - lo + 1;
        int start = n / 2 - 1;
        while (start >= 0) {
            SiftIntArr(a, lo, start, n);
            start = start - 1;
        }
        int end = n - 1;
        while (end > 0) {
            int t = a[lo]; a[lo] = a[lo + end]; a[lo + end] = t;
            SiftIntArr(a, lo, 0, end);
            end = end - 1;
        }
    }

    static void SiftIntArr(int[] a, int lo, int root, int n) {
        int r = root;
        while (2 * r + 1 < n) {
            int child = 2 * r + 1;
            if (child + 1 < n && a[lo + child] < a[lo + child + 1]) { child = child + 1; }
            if (!(a[lo + r] < a[lo + child])) { return; }
            int t = a[lo + r]; a[lo + r] = a[lo + child]; a[lo + child] = t;
            r = child;
        }
    }
}
