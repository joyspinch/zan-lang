using System;
using System.Interop;

namespace System;

// 提供创建、操作、搜索和排序数组的方法，对齐 C# System.Array 常用 API。
public class Array {
    // 返回指定类型的空数组。
    public static T[] Empty<T>() {
        return new T[0];
    }

    // byte[] 高速内存复制（硬件向量化 memmove）
    public static void Copy(byte[] src, int srcIdx, byte[] dst, int dstIdx, int length) {
        if (src == null) { throw new ArgumentNullException("src"); }
        if (dst == null) { throw new ArgumentNullException("dst"); }
        if (srcIdx < 0 || dstIdx < 0 || length < 0) { throw new ArgumentOutOfRangeException("length"); }
        if (srcIdx + length > src.Length || dstIdx + length > dst.Length) {
            throw new ArgumentException("offset and length out of bounds");
        }
        if (length == 0) { return; }
        NativeMemory.Copy((nint)dst + dstIdx, (nint)src + srcIdx, length);
    }

    // int[] 高速内存复制（硬件向量化 memmove）
    public static void Copy(int[] src, int srcIdx, int[] dst, int dstIdx, int length) {
        if (src == null) { throw new ArgumentNullException("src"); }
        if (dst == null) { throw new ArgumentNullException("dst"); }
        if (srcIdx < 0 || dstIdx < 0 || length < 0) { throw new ArgumentOutOfRangeException("length"); }
        if (srcIdx + length > src.Length || dstIdx + length > dst.Length) {
            throw new ArgumentException("offset and length out of bounds");
        }
        if (length == 0) { return; }
        NativeMemory.Copy((nint)dst + dstIdx * 4, (nint)src + srcIdx * 4, length * 4);
    }

    // long[] 高速内存复制（硬件向量化 memmove）
    public static void Copy(long[] src, int srcIdx, long[] dst, int dstIdx, int length) {
        if (src == null) { throw new ArgumentNullException("src"); }
        if (dst == null) { throw new ArgumentNullException("dst"); }
        if (srcIdx < 0 || dstIdx < 0 || length < 0) { throw new ArgumentOutOfRangeException("length"); }
        if (srcIdx + length > src.Length || dstIdx + length > dst.Length) {
            throw new ArgumentException("offset and length out of bounds");
        }
        if (length == 0) { return; }
        NativeMemory.Copy((nint)dst + dstIdx * 8, (nint)src + srcIdx * 8, length * 8);
    }

    // double[] 高速内存复制（硬件向量化 memmove）
    public static void Copy(double[] src, int srcIdx, double[] dst, int dstIdx, int length) {
        if (src == null) { throw new ArgumentNullException("src"); }
        if (dst == null) { throw new ArgumentNullException("dst"); }
        if (srcIdx < 0 || dstIdx < 0 || length < 0) { throw new ArgumentOutOfRangeException("length"); }
        if (srcIdx + length > src.Length || dstIdx + length > dst.Length) {
            throw new ArgumentException("offset and length out of bounds");
        }
        if (length == 0) { return; }
        NativeMemory.Copy((nint)dst + dstIdx * 8, (nint)src + srcIdx * 8, length * 8);
    }

    // bool[] 高速内存复制（硬件向量化 memmove）
    public static void Copy(bool[] src, int srcIdx, bool[] dst, int dstIdx, int length) {
        if (src == null) { throw new ArgumentNullException("src"); }
        if (dst == null) { throw new ArgumentNullException("dst"); }
        if (srcIdx < 0 || dstIdx < 0 || length < 0) { throw new ArgumentOutOfRangeException("length"); }
        if (srcIdx + length > src.Length || dstIdx + length > dst.Length) {
            throw new ArgumentException("offset and length out of bounds");
        }
        if (length == 0) { return; }
        NativeMemory.Copy((nint)dst + dstIdx, (nint)src + srcIdx, length);
    }

    public static void Copy(byte[] src, byte[] dst, int length) {
        Copy(src, 0, dst, 0, length);
    }

    public static void Copy(int[] src, int[] dst, int length) {
        Copy(src, 0, dst, 0, length);
    }

    public static void Copy(long[] src, long[] dst, int length) {
        Copy(src, 0, dst, 0, length);
    }

    public static void Copy(double[] src, double[] dst, int length) {
        Copy(src, 0, dst, 0, length);
    }

    public static void Copy(bool[] src, bool[] dst, int length) {
        Copy(src, 0, dst, 0, length);
    }

    // 从指定源索引开始，将源数组的一系列元素复制到目标数组（从指定目标索引开始）。
    public static void Copy<T>(T[] src, int srcIdx, T[] dst, int dstIdx, int length) {
        if (src == null) { throw new ArgumentNullException("src"); }
        if (dst == null) { throw new ArgumentNullException("dst"); }
        if (srcIdx < 0 || dstIdx < 0 || length < 0) { throw new ArgumentOutOfRangeException("length"); }
        if (srcIdx + length > src.Length || dstIdx + length > dst.Length) {
            throw new ArgumentException("offset and length out of bounds");
        }
        int i = 0;
        while (i < length) {
            dst[dstIdx + i] = src[srcIdx + i];
            i = i + 1;
        }
    }

    // 将源数组的一系列元素复制到目标数组（从开头复制）。
    public static void Copy<T>(T[] src, T[] dst, int length) {
        Copy<T>(src, 0, dst, 0, length);
    }

    // 反转一维数组中元素的顺序。
    public static void Reverse<T>(T[] array) {
        if (array == null) { throw new ArgumentNullException("array"); }
        int i = 0;
        int j = array.Length - 1;
        while (i < j) {
            T tmp = array[i];
            array[i] = array[j];
            array[j] = tmp;
            i = i + 1;
            j = j - 1;
        }
    }

    // 将数组中的一系列元素设为默认值。
    public static void Clear<T>(T[] array, int index, int length) {
        if (array == null) { throw new ArgumentNullException("array"); }
        if (index < 0 || length < 0 || index + length > array.Length) {
            throw new ArgumentOutOfRangeException("index or length out of bounds");
        }
        int i = 0;
        while (i < length) {
            array[index + i] = null;
            i = i + 1;
        }
    }

    // 在一维数组中搜索指定对象，并返回第一个匹配项的从零开始的索引。未找到返回 -1。
    public static int IndexOf<T>(T[] array, T value) {
        if (array == null) { throw new ArgumentNullException("array"); }
        int i = 0;
        while (i < array.Length) {
            if (array[i] == value) {
                return i;
            }
            i = i + 1;
        }
        return -1;
    }

    // 对一维数组中的整数元素进行升序排序。
    public static void Sort(int[] array) {
        if (array == null) { return; }
        QuickSortInt(array, 0, array.Length - 1);
    }

    private static void QuickSortInt(int[] a, int lo, int hi) {
        if (lo >= hi) { return; }
        int pivot = a[hi];
        int i = lo - 1;
        int j = lo;
        while (j < hi) {
            if (a[j] <= pivot) {
                i = i + 1;
                int tmp = a[i];
                a[i] = a[j];
                a[j] = tmp;
            }
            j = j + 1;
        }
        int t = a[i + 1];
        a[i + 1] = a[hi];
        a[hi] = t;
        int p = i + 1;
        QuickSortInt(a, lo, p - 1);
        QuickSortInt(a, p + 1, hi);
    }
}
