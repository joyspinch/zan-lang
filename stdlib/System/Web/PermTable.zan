using System;
using System.Threading;

namespace System.Web;

/// <summary>
/// Which role may call which route, in cross-process shared memory.
///
/// This is the largest of the web tables: one row per (role, route) pair, so
/// 100 roles over 500 routes is 50k rows. Its key is therefore built from two
/// integers instead of text -- the route hash the request already computed and
/// the numeric role id, mixed into one 64-bit slot address. That keeps the
/// permission check allocation-free: no key string, no second hash of the path.
///
/// The mixed key cannot be verified by comparing text, so each row stores the
/// route hash and role id it was written for and a lookup compares both. A
/// collision then reads as "no grant" (deny) rather than as another role's
/// rights.
///
/// The value is a bit mask, so one row can carry finer rights than yes/no
/// (read/write/delete/export...); <see cref="Allow"/> is "any bit set".
///
/// <code>
/// PermTable perms = PermTable.Create("app.perms", 131072);   // 2^n >= 2x rows
/// perms.Grant(7, "GET", "/user/list");                       // role 7
/// ...
/// if (info.perm == 1 &amp;&amp; !perms.Allow(session.roleId, hash)) {
///     return HttpResponse.WithStatus(403, "Forbidden", "no permission");
/// }
/// </code>
/// </summary>
class PermTable {
    SharedTable table;

    PermTable() {
        this.table = null;
    }

    /// <summary>Slot address for a (role, route) pair: the route hash is spread
    /// with a 64-bit odd constant so that neighbouring role ids of the same
    /// route do not land in one probe run.</summary>
    static long Key(int roleId, long routeHash) {
        long mixed = routeHash * -7046029254386353131;   // 0x9E3779B97F4A7C15
        mixed = mixed + roleId * 1099511628211;
        mixed = mixed ^ (mixed >> 29);
        if (mixed == 0) { return 1; }
        return mixed;
    }

    /// <summary>Creates the table (master process, before workers fork).
    /// `capacity` is roles x routes; leave it at least twice the expected row
    /// count so open addressing keeps its probe runs short.</summary>
    PermTable(string name, int capacity) {
        SharedTable t = new SharedTable(name, capacity);
        t.KeySize(16);
        t.ColumnInt("mask");
        t.ColumnInt("route");
        t.ColumnInt("role");
        if (t.Create()) { this.table = t; }
    }

    /// <summary>Opens the table created by another process.</summary>
    static PermTable Open(string name) {
        PermTable p = new PermTable();
        SharedTable t = SharedTable.Open(name);
        if (!t.IsOpen()) { return null; }
        p.table = t;
        return p;
    }

    /// <summary>Grants the given rights, replacing whatever the pair had. Bits
    /// are the application's own; 1 is enough for plain allow/deny. Returns
    /// false when the table is full.</summary>
    bool SetMask(int roleId, long routeHash, int mask) {
        long k = PermTable.Key(roleId, routeHash);
        if (!this.table.SetIntAt(k, "mask", mask)) { return false; }
        this.table.SetIntAt(k, "route", routeHash);
        this.table.SetIntAt(k, "role", roleId);
        return true;
    }

    /// <summary>Grants full access to a route the caller already hashed.</summary>
    bool GrantHash(int roleId, long routeHash) {
        return this.SetMask(roleId, routeHash, 1);
    }

    /// <summary>Grants full access to METHOD_path (startup/administration path:
    /// this one does hash the text).</summary>
    bool Grant(int roleId, string method, string path) {
        return this.SetMask(roleId, RouteTable.Key(method, path), 1);
    }

    /// <summary>Withdraws every right of this role on this route. Writing an
    /// empty mask rather than deleting the row keeps the deny visible to readers
    /// without taking the table's structural lock.</summary>
    bool Revoke(int roleId, long routeHash) {
        long k = PermTable.Key(roleId, routeHash);
        return this.table.SetIntAt(k, "mask", 0);
    }

    /// <summary>The role's rights on the route, 0 when there is no grant. The
    /// stored route hash and role id are compared, so a key collision denies
    /// instead of leaking another pair's rights.</summary>
    int Mask(int roleId, long routeHash) {
        long k = PermTable.Key(roleId, routeHash);
        if (this.table.GetIntAt(k, "route") != routeHash) { return 0; }
        if (this.table.GetIntAt(k, "role") != roleId) { return 0; }
        return (int)this.table.GetIntAt(k, "mask");
    }

    /// <summary>Whether the role may call the route at all.</summary>
    bool Allow(int roleId, long routeHash) {
        return this.Mask(roleId, routeHash) != 0;
    }

    /// <summary>Whether the role holds one specific right (a single bit).</summary>
    bool Can(int roleId, long routeHash, int bit) {
        return (this.Mask(roleId, routeHash) & bit) != 0;
    }

    int Count() {
        return this.table.Count();
    }

    bool Destroy() {
        return this.table.Destroy();
    }
}
