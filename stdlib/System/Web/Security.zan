using System;
using System.Threading;

namespace System.Web;

/// <summary>The two things the dispatcher asks the application: who a token
/// belongs to (AuthFn) and whether that principal may run a route action
/// (PermissionFn).
///
/// Both are asynchronous: they run on the request coroutine, so a user store
/// that is a database or Redis can be awaited instead of blocking the worker.
/// A resolver that needs no I/O simply never awaits.</summary>
async delegate string AuthFn(string token);
async delegate bool PermissionFn(string uid, string action);

/// <summary>
/// Request-lock registry: the typed replacement for the PHP "接口请求锁" pattern.
/// A route annotated with [Lock("user")] / [Lock("global")] may only run one
/// request at a time for the given key; overlapping requests get 429 instead of
/// racing (double-submit / duplicate-write protection). The HTTP server is a
/// single-threaded event loop per worker, so a plain in-flight key set is race
/// free -- no OS mutex needed.
/// </summary>
class LockLease {
    string key;
    long owner;

    LockLease(string key, long owner) {
        this.key = key;
        this.owner = owner;
    }
}

class LockManager {
    SharedTable table;
    long ownerSequence;
    long leaseMs;

    LockManager(string name) {
        this.ownerSequence = 0;
        this.leaseMs = 30000;
        SharedTable table = new SharedTable(name, 65536);
        table.KeySize(192);
        table.ColumnInt("owner");
        if (!table.Create()) { table = SharedTable.Open(name); }
        if (table.IsOpen()) { this.table = table; }
    }

    static string KeyFor(Route route, string principal) {
        if (route.lockScope == "user") {
            string who = principal;
            if (who.Length == 0) { who = "_anon_"; }
            return "u:" + who + ":" + route.Key();
        }
        if (route.lockScope == "global") {
            return "g:" + route.Key();
        }
        return "";
    }

    LockLease TryAcquire(string key) {
        if (key.Length == 0) { return null; }
        if (this.table == null) { return null; }
        this.ownerSequence = this.ownerSequence + 1;
        long owner = this.ownerSequence;
        if (!this.table.TryAcquireLease(key, owner, -1, this.leaseMs)) {
            return null;
        }
        return new LockLease(key, owner);
    }

    void Release(LockLease lease) {
        if (lease == null || this.table == null) { return; }
        this.table.ReleaseLease(lease.key, lease.owner);
    }
}

