using System;
using System.Threading;

namespace System.Web;

/// <summary>The two things the dispatcher asks the application: who a token
/// belongs to (AuthFn) and whether that principal may run a route action
/// (PermissionFn).
///
/// Both are asynchronous: they run on the request coroutine, so a user store
/// that is a database or Redis can be awaited instead of blocking the worker.
/// A resolver that needs no I/O simply never awaits.</summary>
async delegate string AuthFn(string token);
async delegate bool PermissionFn(string uid, string action);

/// <summary>
/// Request-lock registry: the typed replacement for the PHP "接口请求锁" pattern.
/// A route annotated with [Lock("user")] / [Lock("global")] may only run one
/// request at a time for the given key; overlapping requests get 429 instead of
/// racing (double-submit / duplicate-write protection). The HTTP server is a
/// single-threaded event loop per worker, so a plain in-flight key set is race
/// free -- no OS mutex needed.
/// </summary>
class LockLease {
    string key;
    long owner;

    LockLease(string key, long owner) {
        this.key = key;
        this.owner = owner;
    }
}

class LockManager {
    SharedTable table;
    long ownerSequence;
    long leaseMs;

    LockManager() {
        this.ownerSequence = 0;
        this.leaseMs = 30000;
    }

    static SharedTable NewTable(string name) {
        SharedTable t = new SharedTable(name, 65536);
        t.KeySize(192);
        t.ColumnInt("owner");
        return t;
    }

    /// <summary>Locks in a NAMED shared table: created by whichever process gets
    /// there first and opened by the rest, and reachable by name from outside
    /// the server.</summary>
    static LockManager Named(string name) {
        LockManager m = new LockManager();
        SharedTable t = LockManager.NewTable(name);
        if (!t.Create()) { t = SharedTable.Open(name); }
        if (t.IsOpen()) {
            t.Label("web request lock");
            m.table = t;
        }
        return m;
    }

    /// <summary>Locks in anonymous shared memory this process owns: no name for
    /// another server on the machine to collide with, and workers reach the same
    /// leases through <see cref="OsHandle"/> / <see cref="Attach"/>.</summary>
    static LockManager Owned() {
        LockManager m = new LockManager();
        SharedTable t = LockManager.NewTable("");
        if (t.CreateAnonymous()) {
            t.Label("web request lock");
            m.table = t;
        }
        return m;
    }

    /// <summary>Locks in the anonymous table another process created and handed
    /// down. Handle 0 (nothing was handed down) leaves the manager closed, and a
    /// closed manager grants no lease -- a locked route is refused rather than
    /// let through unprotected.</summary>
    static LockManager Attach(long osHandle) {
        LockManager m = new LockManager();
        if (osHandle == 0) { return m; }
        SharedTable t = SharedTable.Attach(osHandle);
        if (t.IsOpen()) {
            t.Label("web request lock");
            m.table = t;
        }
        return m;
    }

    /// <summary>The handle a worker needs to map this manager's table, or 0 when
    /// the table is named (found by name instead) or was never created.</summary>
    long OsHandle() {
        if (this.table == null) { return 0; }
        return this.table.OsHandle();
    }

    static string KeyFor(Route route, string principal) {
        if (route.lockScope == "user") {
            string who = principal;
            if (who.Length == 0) { who = "_anon_"; }
            return "u:" + who + ":" + route.Key();
        }
        if (route.lockScope == "global") {
            return "g:" + route.Key();
        }
        return "";
    }

    LockLease TryAcquire(string key) {
        if (key.Length == 0) { return null; }
        if (this.table == null) { return null; }
        this.ownerSequence = this.ownerSequence + 1;
        long owner = this.ownerSequence;
        if (!this.table.TryAcquireLease(key, owner, -1, this.leaseMs)) {
            return null;
        }
        return new LockLease(key, owner);
    }

    void Release(LockLease lease) {
        if (lease == null || this.table == null) { return; }
        this.table.ReleaseLease(lease.key, lease.owner);
    }
}

