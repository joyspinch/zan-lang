using System;
using System.Threading;
using System.Json;

namespace System.Web;

/// One routed endpoint's shared-memory counters in Router.StatsJson. Keys
/// (route/count/avg_us) match the documented JSON array shape; the average is
/// in microseconds, the unit every duration the server records is kept in.
class RouteHitDoc {
    string route;
    long count;
    long avg_us;
}

/// <summary>Request handler signature: fill the response on ctx. Async so an
/// action can await I/O (Cache/Redis/async services) without blocking the
/// connection coroutine; WebApp.Dispatch awaits it.</summary>
async delegate void HttpHandler(HttpContext ctx);

/// <summary>
/// One registered route. The pattern is pre-split into segments at
/// registration time, so matching a request never re-parses the pattern:
/// "/user/{id}" -> ["user", "{id}"].
/// </summary>
class Route {
    string method;
    string pattern;
    List<string> segs;
    HttpHandler handler;
    string key;         // precomputed "METHOD pattern" (per-request stats/lock key)
    string action;      // "Controller.Method" -- for docs / menu / diagnostics

    // ---- metadata mirrored from controller attributes ([Title]/[Auth]/...) ----
    string title;       // [Title] human label (menu text / docs)
    int rateLimit;      // [Custom(ApiMax=n)] max requests per second; 0 (the
                        // default) serves as fast as the machine can -- a limit
                        // is a deliberate declaration, not a surprise ceiling
    string rateScope;   // default route; explicit uid or ip adds the principal
    bool needsLogin;    // Authorization = Login: a resolved user is required
    bool needsAuth;     // Authorization = Grant/ApiAuth: a resolved user AND the
                        // right to `action` are required (401/403 otherwise)
    string lockScope;   // [Lock]  request lock: "" none | "user" | "global"
    bool streamUpload;  // [Upload] request body is streamed to disk, not memory
    bool inMenu;        // [Menu]  surface this route in the admin menu (boolean);
                        // its section and text come from the URL and [Description]
    // Request parameters, filled by the compiler from the In*/Need*/Param calls
    // in the action body: the read IS the declaration, so /api/docs describes
    // exactly what the handler consumes and cannot fall out of date.
    List<ApiParam> docParams;
    StrMap meta;         // free-form attribute metadata (Rank/ApiMax/Component/Icon/ContentType/...)

    // Dense index into Router.flat and the per-route stats block. Stats live on
    // the Router in ONE flat int list (4 ints/route), NOT on this object, so a
    // served request is recorded touching a single heap object -- avoiding the
    // per-request ARC retain/release of the matched Route that cost ~12% CPU.
    int idx;

    Route(string method, string pattern, HttpHandler handler) {
        this.method = method;
        this.pattern = pattern;
        this.segs = Router.SplitPath(pattern);
        this.handler = handler;
        this.key = method + " " + pattern;
        this.action = "";
        this.title = "";
        this.rateLimit = 0;
        this.rateScope = "route";
        this.needsLogin = false;
        this.needsAuth = false;
        this.lockScope = "";
        this.streamUpload = false;
        this.inMenu = false;
        this.docParams = new List<ApiParam>();
        this.meta = new StrMap();
        this.idx = -1;
    }

    // ---- fluent metadata setters (mirror the controller attributes) ----
    Route Named(string action) { this.action = action; return this; }
    Route Title(string title) { this.title = title; return this; }
    Route Limit(int maxPerWindow) { this.rateLimit = maxPerWindow; return this; }
    Route LimitBy(int maxPerWindow, string scope) {
        this.rateLimit = maxPerWindow;
        this.rateScope = scope;
        return this;
    }
    Route RateBy(string scope) { this.rateScope = scope; return this; }
    Route Login() { this.needsLogin = true; return this; }
    Route Auth() { this.needsAuth = true; this.needsLogin = true; return this; }
    Route Lock(string scope) { this.lockScope = scope; return this; }
    Route Upload() { this.streamUpload = true; return this; }
    Route Menu() { this.inMenu = true; return this; }
    Route Meta(string key, string val) { this.meta.Set(key, val); return this; }
    /// <summary>Declares one request parameter (emitted by the compiler from the
    /// action body). `source` is "path" for a {segment} and "query" otherwise.</summary>
    Route Param(string name, string type, bool required, string def, string desc,
                string source) {
        for (int i = 0; i < this.docParams.Count; i = i + 1) {
            if (this.docParams[i].Name() == name) { return this; }
        }
        this.docParams.Add(new ApiParam(name, type, required, def, desc, source));
        return this;
    }
    string MetaGet(string key) { return this.meta.Get(key); }

    string Key() { return this.key; }
}

/// <summary>
/// HTTP router with static-first matching and {param} segments. Routes are
/// bucketed by method and static routes are checked with a direct string
/// compare before parameterized ones, so the hot path ("/", "/api/x") is a
/// handful of string compares with zero allocation.
/// </summary>
class Router {
    List<Route> statics;   // no {param} segments: matched by full-path compare
    List<Route> dynamics;  // contain {param} segments: matched per-segment
    // O(1) static-route lookup, keyed by "METHOD pattern" (e.g.
    // "GET /api/index/index"). Built once as routes register at startup and
    // never touched per request, so the hot path is a single hash lookup
    // instead of a linear scan over every static route.
    Dictionary<string, Route> staticIndex;
    // Open-addressed index over the static routes: slot -> index into
    // `statics`, -1 when empty. Rebuilt whenever a route is added, so the
    // request path only probes it.
    List<int> hashSlots;
    int hashMask;
    // Every route by Route.idx (registration order).
    List<Route> flat;
    // Precomputed key string for each route in flat order.
    // Stored separately so RecordHit never touches a Route object (no ARC).
    List<string> flatKeys;
    // The same keys hashed once, at InitStats. Rows in the shared table are
    // addressed by this hash, so recording a hit neither re-hashes the key
    // string nor copies it into shared memory.
    List<long> flatHashes;
    // Cross-process shared stats table (SharedTable backed by named shared
    // memory). Columns: "hits" (int), "total_us" (int). Keyed by route.key.
    // Null until InitStats is called. All workers share the same table so
    // /admin/stats reflects the aggregate across every worker process.
    SharedTable routeStats;

    Router() {
        this.statics = new List<Route>();
        this.dynamics = new List<Route>();
        this.staticIndex = new Dictionary<string, Route>();
        this.hashSlots = null;
        this.hashMask = 0;
        this.flat = new List<Route>();
        this.flatKeys = new List<string>();
        this.flatHashes = new List<long>();
        this.routeStats = null;
    }

    /// <summary>Registered routes, in registration order.</summary>
    int Count() { return this.flat.Count; }

    Route Add(string method, string pattern, HttpHandler handler) {
        Route r = new Route(method, pattern, handler);
        if (Router.IsStatic(pattern)) {
            this.statics.Add(r);
            Dictionary<string, Route> idx = this.staticIndex;
            idx[method + " " + pattern] = r;
            this.hashSlots = null;
        } else {
            this.dynamics.Add(r);
        }
        r.idx = this.flat.Count;
        this.flat.Add(r);
        this.flatKeys.Add(r.key);
        return r;
    }

    /// <summary>Create (master/single-process) or open (worker) the shared
    /// route stats table. Call after all routes are registered and before the
    /// first request. name should be unique per server instance -- WebApp
    /// builds it as "zan.web.&lt;scope&gt;.route". In multi-worker mode every
    /// worker calls this too;
    /// Create falls back to Open when the master has already made the
    /// table.</summary>
    void InitStats(string name) {
        int cap = this.flat.Count;
        if (cap == 0) { return; }
        this.flatHashes = new List<long>();
        for (int h = 0; h < this.flatKeys.Count; h = h + 1) {
            this.flatHashes.Add(SharedTable.Hash(this.flatKeys[h]));
        }
        SharedTable t = new SharedTable(name, cap + 4);
        t.KeySize(128);
        t.ColumnInt("hits");
        t.ColumnInt("total_us");
        if (t.Create()) {
            // Master (or single process): seed every route row so workers
            // can Increment on a pre-existing row without triggering a
            // capacity-limited auto-create under concurrent first requests.
            for (int i = 0; i < this.flatHashes.Count; i = i + 1) {
                t.SetIntAt(this.flatHashes[i], "hits", 0);
                t.SetIntAt(this.flatHashes[i], "total_us", 0);
            }
            this.routeStats = t;
        } else {
            // Worker (or shared-memory already exists): open the table the
            // master created; all workers map the same backing store.
            SharedTable existing = SharedTable.Open(name);
            if (existing.IsOpen()) { this.routeStats = existing; }
        }
    }

    /// <summary>Record one served request. Two atomic increments into the
    /// shared stats table -- no Route object touched, no per-process
    /// computation.</summary>
    void RecordHit(int idx, long us) {
        if (this.routeStats == null) { return; }
        if (idx < 0 || idx >= this.flatHashes.Count) { return; }
        long key = this.flatHashes[idx];
        this.routeStats.IncrementAt(key, "hits", 1);
        this.routeStats.IncrementAt(key, "total_us", us);
    }

    /// <summary>Every registered route (statics then dynamics) -- used by the
    /// admin menu builder and route diagnostics.</summary>
    List<Route> All() {
        List<Route> outp = new List<Route>();
        int i = 0;
        for (; i < this.statics.Count; i = i + 1) { outp.Add(this.statics[i]); }
        i = 0;
        while (i < this.dynamics.Count) { outp.Add(this.dynamics[i]); i = i + 1; }
        return outp;
    }

    /// <summary>Per-route request stats (only routes with at least one hit),
    /// read from the cross-process shared table. Empty when InitStats has not
    /// been called yet. Callers that embed this in a larger document take the
    /// list rather than StatsJson, so the numbers are written out once instead
    /// of being serialised, parsed back and serialised again.</summary>
    List<RouteHitDoc> Stats() {
        List<RouteHitDoc> outp = new List<RouteHitDoc>();
        if (this.routeStats == null) { return outp; }
        for (int i = 0; i < this.flatHashes.Count; i = i + 1) {
            long key = this.flatHashes[i];
            long hits = this.routeStats.GetIntAt(key, "hits");
            if (hits > 0) {
                long totalUs = this.routeStats.GetIntAt(key, "total_us");
                long avgUs = totalUs / hits;
                RouteHitDoc o = new RouteHitDoc();
                o.route = this.flatKeys[i];
                o.count = hits;
                o.avg_us = avgUs;
                outp.Add(o);
            }
        }
        return outp;
    }

    /// <summary>Stats() as a JSON array.</summary>
    string StatsJson() {
        return Json.Serialize<List<RouteHitDoc>>(this.Stats());
    }

    Route Get(string pattern, HttpHandler handler) { return this.Add("GET", pattern, handler); }
    Route Post(string pattern, HttpHandler handler) { return this.Add("POST", pattern, handler); }
    Route Put(string pattern, HttpHandler handler) { return this.Add("PUT", pattern, handler); }
    Route Delete(string pattern, HttpHandler handler) { return this.Add("DELETE", pattern, handler); }

    /// <summary>FNV-1a over "method path" without building the key string.
    /// Folded to 30 bits so the multiply never overflows.</summary>
    static int HashKey(string method, string path) {
        int h = 2166136261;
        int i = 0;
        int n = method.Length;
        for (; i < n; i = i + 1) {
            h = ((h ^ (method[i] & 255)) * 16777619) & 1073741823;
        }
        h = ((h ^ 32) * 16777619) & 1073741823;
        i = 0;
        n = path.Length;
        while (i < n) {
            h = ((h ^ (path[i] & 255)) * 16777619) & 1073741823;
            i = i + 1;
        }
        return h;
    }

    /// <summary>Rebuilds the open-addressed static-route index. Runs once
    /// after registration (and again if a route is added later), never per
    /// request. Slots hold indices into `statics`; -1 is empty.</summary>
    void RebuildIndex() {
        int cap = 16;
        while (cap < this.statics.Count * 4) { cap = cap * 2; }
        List<int> slots = new List<int>();
        int i = 0;
        for (; i < cap; i = i + 1) { slots.Add(-1); }
        int mask = cap - 1;
        i = 0;
        while (i < this.statics.Count) {
            Route r = this.statics[i];
            int h = Router.HashKey(r.method, r.pattern) & mask;
            bool placed = false;
            while (!placed) {
                int si = slots[h];
                if (si < 0) {
                    slots[h] = i;
                    placed = true;
                } else {
                    Route other = this.statics[si];
                    if (other.method == r.method && other.pattern == r.pattern) {
                        slots[h] = i;          // re-registration: last wins
                        placed = true;
                    } else {
                        h = (h + 1) & mask;
                    }
                }
            }
            i = i + 1;
        }
        this.hashSlots = slots;
        this.hashMask = mask;
    }

    /// <summary>Exact (method, path) static-route lookup: one hash and one
    /// string compare in the common case, zero allocations.</summary>
    Route FindStatic(string method, string path) {
        if (this.hashSlots == null) { this.RebuildIndex(); }
        int mask = this.hashMask;
        int h = Router.HashKey(method, path) & mask;
        for (int guard = 0; guard <= mask; guard = guard + 1) {
            int si = this.hashSlots[h];
            if (si < 0) { return null; }
            Route r = this.statics[si];
            if (r.method == method && r.pattern == path) { return r; }
            h = (h + 1) & mask;
        }
        return null;
    }

    /// <summary>Finds the route for method+path, filling ctx.routeParams.
    /// Returns null when nothing matches. `pathMatched` is set when some route
    /// has the path but not the method (405 vs 404).</summary>
    Route Match(HttpContext ctx) {
        string method = ctx.method;
        string path = ctx.path;
        // Static routes: allocation-free probe into an open-addressed index
        // over (method, path), then the "*" (any-method) fallback. Nothing
        // per request builds a "METHOD path" key or scans the static table.
        Route hit = this.FindStatic(method, path);
        if (hit != null) { return hit; }
        hit = this.FindStatic("*", path);
        if (hit != null) { return hit; }
        List<string> segs = Router.SplitPath(path);
        for (int i = 0; i < this.dynamics.Count; i = i + 1) {
            Route r = this.dynamics[i];
            if (r.method == method || r.method == "*") {
                if (Router.MatchSegs(r.segs, segs, ctx.routeParams)) {
                    return r;
                }
            }
        }
        return null;
    }

    /// <summary>True when some route matches the path with a different method
    /// (drives a 405 Method Not Allowed instead of 404).</summary>
    bool PathExists(string path) {
        int i = 0;
        for (; i < this.statics.Count; i = i + 1) {
            if (this.statics[i].pattern == path) { return true; }
        }
        List<string> segs = Router.SplitPath(path);
        StrMap scratch = new StrMap();
        i = 0;
        while (i < this.dynamics.Count) {
            if (Router.MatchSegs(this.dynamics[i].segs, segs, scratch)) { return true; }
            i = i + 1;
        }
        return false;
    }

    static bool IsStatic(string pattern) {
        for (int i = 0; i < pattern.Length; i = i + 1) {
            if ((pattern[i] & 255) == 123) { return false; }  // '{'
        }
        return true;
    }

    static bool MatchSegs(List<string> pat, List<string> segs, StrMap into) {
        if (pat.Count != segs.Count) { return false; }
        for (int i = 0; i < pat.Count; i = i + 1) {
            string p = pat[i];
            if (p.Length > 2 && (p[0] & 255) == 123
                && (p[p.Length - 1] & 255) == 125) {  // '{' '}'
                into.Set(p.Substring(1, p.Length - 2), segs[i]);
            } else if (p != segs[i]) {
                return false;
            }
        }
        return true;
    }

    static List<string> SplitPath(string path) {
        List<string> outp = new List<string>();
        int i = 0;
        int n = path.Length;
        while (i < n) {
            while (i < n && (path[i] & 255) == 47) { i = i + 1; }  // '/'
            int e = i;
            while (e < n && (path[e] & 255) != 47) { e = e + 1; }  // '/'
            if (e > i) { outp.Add(path.Substring(i, e - i)); }
            i = e;
        }
        return outp;
    }
}
