using System;
using System.IO;
using System.Json;
using System.Text;

namespace System.Web;

// 建栈帧。mode：0 普通容器，1 捕获文本（button/textarea），
// 2 原文收集（style），3 原文跳过（script/title）。
public class WFrame {
    public int rec;
    public string tag;
    public int mode;
    public string pending;  // 已塌缩、前后空白待裁决的文本
    public bool prevInline;  // pending 之前最近一个兄弟是否行内级
    public string label;  // mode 1/2 的累计文本
}
