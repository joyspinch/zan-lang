using System;
using System.IO;
using System.Json;
using System.Text;

namespace System.Web;

// data-on-* 解析出的逻辑事件名映射（"click" → "Click"）独立于
// Gui 的事件类型，供生成器与运行时共用。
public class HtmlText {
    // data-on-* 后缀 → AddByName 事件名。未映射的后缀返回空
    // （静默忽略：HTML 引用宿主没接的事件不该炸）。支持修饰符剥离（如 click.stop -> click）。
    public static string EventKind(string suffix) {
        string s = suffix.ToLower();
        int dot = s.IndexOf(".");
        if (dot >= 0) {
            s = s.Substring(0, dot);
        }
        switch (s) {
            case "click":
                return "Click";
            case "dblclick":
            case "doubleclick":
                return "DoubleClick";
            case "rightclick":
            case "right-click":
            case "contextmenu":
                return "RightClick";
            case "rightdblclick":
            case "right-dblclick":
            case "rightdoubleclick":
                return "RightDoubleClick";
            case "mousedown":
                return "MouseDown";
            case "mouseup":
                return "MouseUp";
            case "mouseenter":
            case "mouseover":
                return "Enter";
            case "mouseleave":
            case "mouseout":
                return "Leave";
            case "wheel":
                return "Wheel";
            case "focus":
                return "Focus";
            case "blur":
                return "Blur";
            case "keydown":
                return "KeyDown";
            case "keyup":
                return "KeyUp";
            case "keypress":
                return "KeyPress";
            case "change":
                return "Change";
            case "show":
                return "Show";
            case "hide":
                return "Hide";
            case "resize":
            case "sizechange":
            case "size-change":
                return "Resize";

            // 表格 / 数据网格专属事件
            case "rowclick":
            case "row-click":
                return "RowClick";
            case "rowdblclick":
            case "row-dblclick":
            case "rowdoubleclick":
            case "row-doubleclick":
                return "RowDoubleClick";
            case "rowcontext":
            case "row-context":
            case "rowrightclick":
            case "row-right-click":
                return "RowContext";
            case "cellclick":
            case "cell-click":
                return "CellClick";
            case "celldblclick":
            case "cell-dblclick":
            case "celldoubleclick":
            case "cell-doubleclick":
                return "CellDoubleClick";
            case "celledit":
            case "cell-edit":
                return "CellEdit";
            case "cellvalidating":
            case "cell-validating":
                return "CellValidating";
            case "sort":
                return "Sort";
            case "headerclick":
            case "header-click":
            case "colclick":
            case "col-click":
            case "columnclick":
            case "column-click":
                return "HeaderClick";
            case "coldblclick":
            case "col-dblclick":
            case "columndblclick":
            case "column-dblclick":
                return "ColumnDoubleClick";
            case "filterchange":
            case "filterchanged":
            case "filter-change":
            case "filter-changed":
                return "FilterChanged";
            case "columnresize":
            case "column-resize":
            case "colresize":
            case "col-resize":
                return "ColumnResize";
            case "columnresizeend":
            case "column-resize-end":
            case "colresizeend":
            case "col-resize-end":
                return "ColumnResizeEnd";
            case "columnreorder":
            case "column-reorder":
            case "colreorder":
            case "col-reorder":
                return "ColumnReorder";
            case "selectionchange":
            case "selectionchanged":
            case "selection-change":
            case "selection-changed":
                return "SelectionChanged";
            case "groupchange":
            case "groupchanged":
            case "group-change":
            case "group-changed":
                return "GroupChanged";
            case "bandtoggle":
            case "bandtoggled":
            case "band-toggle":
            case "band-toggled":
                return "BandToggled";
            case "rowinserted":
            case "row-inserted":
                return "RowInserted";
            case "rowdeleted":
            case "row-deleted":
                return "RowDeleted";
            case "scrollchanged":
            case "scroll-changed":
            case "scroll":
                return "ScrollChanged";

            // 列表 / 树视图 / 标签 / 分页专属事件
            case "itemclick":
            case "item-click":
                return "ItemClick";
            case "itemdblclick":
            case "item-dblclick":
                return "ItemDoubleClick";
            case "itemrightclick":
            case "item-right-click":
                return "Context";
            case "nodeclick":
            case "node-click":
                return "NodeClick";
            case "nodedblclick":
            case "node-dblclick":
                return "NodeDoubleClick";
            case "nodecontext":
            case "node-context":
            case "noderightclick":
            case "node-right-click":
                return "NodeContext";
            case "expand":
            case "nodeexpand":
            case "node-expand":
                return "Expand";
            case "collapse":
            case "nodecollapse":
            case "node-collapse":
                return "Collapse";
            case "check":
            case "nodecheck":
            case "node-check":
                return "Check";
            case "tabchange":
            case "tab-change":
            case "tabchanged":
            case "tab-changed":
                return "TabChanged";
            case "tabclose":
            case "tab-close":
            case "tabclosed":
            case "tab-closed":
                return "TabClosed";
            case "tabadd":
            case "tab-add":
            case "tabadded":
            case "tab-added":
                return "TabAdded";
            case "pagechange":
            case "page-change":
            case "pagechanged":
            case "page-changed":
                return "PageChanged";
            case "pagesizechange":
            case "page-size-change":
            case "pagesizechanged":
            case "page-size-changed":
                return "PageSizeChanged";

            // 滑块 / 上传 / 评分 / 选择器专属事件
            case "dragend":
            case "drag-end":
                return "DragEnd";
            case "hoverchange":
            case "hover-change":
                return "HoverChange";
            case "upload":
            case "uploadstart":
            case "upload-start":
                return "Upload";
            case "finish":
            case "uploadfinish":
            case "upload-finish":
                return "Finish";
            case "error":
            case "uploaderror":
            case "upload-error":
                return "Error";
            case "remove":
            case "uploadremove":
            case "upload-remove":
                return "Remove";
            case "exceed":
            case "uploadexceed":
            case "upload-exceed":
                return "Exceed";

            default:
                return "";
        }
    }

    public static string Attr(List<string> an, List<string> av, string name) {
        for (int i = 0; i < an.Count; i = i + 1) {
            if (an[i] == name) { return av[i]; }
        }
        return "";
    }

    // 从 WAttr 实体列表根据属性名查找属性值（强类型实体单表访问）。
    public static string NodeAttr(List<WAttr> attrs, string name) {
        if (attrs == null) { return ""; }
        for (int i = 0; i < attrs.Count; i = i + 1) {
            if (attrs[i].name == name) { return attrs[i].val; }
        }
        return "";
    }

    public static List<string> SplitClass(string v) {
        List<string> outp = new List<string>();
        int i = 0;
        int n = v.Length;
        while (i < n) {
            while (i < n && IsSpaceChar(v[i])) { i = i + 1; }
            int s = i;
            while (i < n && !IsSpaceChar(v[i])) { i = i + 1; }
            if (i > s) { outp.Add(v.Substring(s, i - s)); }
        }
        return outp;
    }

    public static bool StartsWith(string s, string p) {
        if (s.Length < p.Length) { return false; }
        for (int i = 0; i < p.Length; i = i + 1) {
            if (s[i] != p[i]) { return false; }
        }
        return true;
    }

    // 连续空白塌缩成单空格（HTML 文本语义），不 trim 首尾。
    public static string CollapseSpace(string s) {
        if (s == null || s.Length == 0) { return ""; }
        StringBuilder outp = new StringBuilder();
        bool inSpace = false;
        int start = 0;
        int n = s.Length;
        for (int i = 0; i < n; i = i + 1) {
            int c = s[i] & 255;
            if (c == 32 || c == 10 || c == 13 || c == 9) {
                if (!inSpace) {
                    if (i > start) {
                        outp.Append(s.Substring(start, i - start));
                    }
                    inSpace = true;
                }
                start = i + 1;
                continue;
            }
            if (inSpace) {
                outp.Append(" ");
                inSpace = false;
                start = i;
            }
        }
        if (start < n) {
            outp.Append(s.Substring(start, n - start));
        }
        if (inSpace) { outp.Append(" "); }
        return outp.ToString();
    }

    public static string TrimLead(string s) {
        int i = 0;
        while (i < s.Length && s[i] == 32) { i = i + 1; }
        return i == 0 ? s : s.Substring(i, s.Length - i);
    }

    public static string TrimTrail(string s) {
        int e = s.Length;
        while (e > 0 && s[e - 1] == 32) { e = e - 1; }
        return e == s.Length ? s : s.Substring(0, e);
    }

    // 命名实体（amp/lt/gt/quot/apos/nbsp）+ 数字实体（&#39; &#x27;）。
    public static string DecodeEntities(string s) {
        if (s == null) { return ""; }
        if (s.IndexOf("&") < 0) { return s; }
        StringBuilder outp = new StringBuilder();
        int i = 0;
        int start = 0;
        int n = s.Length;
        while (i < n) {
            if ((s[i] & 255) != 38) {
                i = i + 1;
                continue;
            }
            int semi = FindFrom(s, ";", i + 1);
            if (semi < 0 || semi - i > 10) {
                i = i + 1;
                continue;
            }
            string ent = s.Substring(i + 1, semi - i - 1);
            string dec = "";
            if (ent == "amp") { dec = "&"; }
            else if (ent == "lt") { dec = "<"; }
            else if (ent == "gt") { dec = ">"; }
            else if (ent == "quot") { dec = "\""; }
            else if (ent == "apos") { dec = "'"; }
            else if (ent == "nbsp") { dec = " "; }
            else if (ent.Length > 1 && (ent[0] & 255) == 35) {
                // #NNN 或 #xHH
                int code = 0 - 1;
                if (ent.Length > 2 && ((ent[1] & 255) == 120 || (ent[1] & 255) == 88)) {
                    code = ParseHex(ent.Substring(2, ent.Length - 2));
                } else {
                    code = ParseIntOr(ent.Substring(1, ent.Length - 1),
                                      0 - 1);
                }
                if (code > 0 && code < 65536) {
                    dec = Encoding.Utf8FromCodePoint(code);
                }
            }
            if (dec == "") {
                i = i + 1;
                continue;
            }
            if (i > start) {
                outp.Append(s.Substring(start, i - start));
            }
            outp.Append(dec);
            i = semi + 1;
            start = i;
        }
        if (start < n) {
            outp.Append(s.Substring(start, n - start));
        }
        return outp.ToString();
    }

    // 十进制整数（容 '-'）；非数字串返回 dflt。
    public static int ParseIntOr(string s, int dflt) {
        int i = 0;
        int sign = 1;
        if (i < s.Length && (s[i] == 45)) { sign = 0 - 1; i = i + 1; }
        if (i >= s.Length) { return dflt; }
        int v = 0;
        while (i < s.Length) {
            int c = s[i];
            if (c < 48 || c > 57) { return dflt; }
            v = v * 10 + (c - 48);
            if (v > 214748364) { return dflt; }
            i = i + 1;
        }
        return sign * v;
    }

    public static int ParseHex(string s) {
        int v = 0;
        for (int i = 0; i < s.Length; i = i + 1) {
            int c = s[i] | 32;
            int d = 0 - 1;
            if (c >= 48 && c <= 57) { d = c - 48; }
            else if (c >= 97 && c <= 102) { d = c - 87; }
            if (d < 0) { return 0 - 1; }
            v = v * 16 + d;
            if (v > 65535) { return 0 - 1; }
        }
        return s.Length == 0 ? 0 - 1 : v;
    }

    public static bool IsAlpha(int c) {
        return (c >= 97 && c <= 122) || (c >= 65 && c <= 90);
    }

    public static bool IsNameChar(int c) {
        return IsAlpha(c) || (c >= 48 && c <= 57) || c == 45 || c == 95
            || c == 58 || c == 46;
    }

    public static bool IsSpaceChar(int c) {
        return c == 32 || c == 10 || c == 13 || c == 9;
    }

    public static int FindFrom(string s, string sub, int from) {
        if (sub.Length == 0 || from >= s.Length) { return 0 - 1; }
        int first = sub[0];
        int limit = s.Length - sub.Length;
        for (int i = from; i <= limit; i = i + 1) {
            if (s[i] != first) { continue; }
            bool ok = true;
            for (int k = 1; k < sub.Length; k = k + 1) {
                if (s[i + k] != sub[k]) { ok = false; break; }
            }
            if (ok) { return i; }
        }
        return 0 - 1;
    }

    // 大小写不敏感地找 `</tag`（原文模式收尾）。
    public static int FindCloseTag(string s, string tag, int from) {
        int limit = s.Length - tag.Length - 2;
        for (int i = from; i <= limit; i = i + 1) {
            if (s[i] != 60 || s[i + 1] != 47) { continue; }
            bool ok = true;
            for (int k = 0; k < tag.Length; k = k + 1) {
                int a = s[i + 2 + k] | 32;
                int b = tag[k];
                if (a != b) { ok = false; break; }
            }
            if (ok) { return i; }
        }
        return 0 - 1;
    }

    // 行内级 tag 表：块表用白名单（UA 样式表 display:block 的集合
    // + 原文/元数据 tag），其余一律按 Chrome 缺省 inline 处理。
    public static bool IsInlineTag(string t) {
        return !IsBlockTag(t);
    }

    public static bool IsBlockTag(string t) {
        if (t == "div" || t == "p" || t == "section" || t == "article"
            || t == "header" || t == "footer" || t == "nav" || t == "aside"
            || t == "main" || t == "ul" || t == "ol" || t == "li"
            || t == "dl" || t == "dt" || t == "dd" || t == "blockquote"
            || t == "figure" || t == "figcaption" || t == "pre"
            || t == "address" || t == "body" || t == "html" || t == "head"
            || t == "hr" || t == "form" || t == "table" || t == "tr"
            || t == "td" || t == "th" || t == "thead" || t == "tbody"
            || t == "tfoot" || t == "h1" || t == "h2" || t == "h3"
            || t == "h4" || t == "h5" || t == "h6" || t == "style"
            || t == "script" || t == "title" || t == "meta" || t == "link"
            || t == "template") {
            return true;
        }
        return false;
    }

    public static bool IsVoidTag(string t) {
        return t == "br" || t == "hr" || t == "img" || t == "input"
            || t == "meta" || t == "link" || t == "base" || t == "area"
            || t == "col" || t == "embed" || t == "source" || t == "track"
            || t == "wbr" || t == "param";
    }
}
