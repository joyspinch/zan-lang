using System;
using System.IO;
using System.Json;
using System.Text;

namespace System.Web;

// HTML 元素属性键值实体（消除 attrNames / attrVals 平行列表反模式）。
public class WAttr {
    public string name;
    public string val;

    public WAttr(string name, string val) {
        this.name = name;
        this.val = val;
    }
}
