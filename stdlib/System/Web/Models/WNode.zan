using System;
using System.IO;
using System.Json;
using System.Text;

namespace System.Web;

// 一条节点声明记录。parent 是记录表下标（-1 = body 根）；items 是
// 文档序内容（文本片 / 子节点下标），容器的混排顺序靠它保真；
// text 是捕获控件（button/textarea）的累计文本。
public class WNode {
    public string tag;
    public int parent;
    public List<WAttr> attrs;
    public List<WItem> items;
    public string text;
}
