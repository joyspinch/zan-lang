using System;

namespace System.Web;

// HtmlScope.zan -- HTML 文档 CSS 的编译/装载期作用域收窄（Vue
// <style scoped> 同语义），Gui.Designer 设计器通道与 App.LoadHtml 运行期
// 装载通道共用这一份实现。给定作用域类 zs，把样式表里每条规则的
// 每个复合块补上该类——同名类跨文档互不串、裸 body 只作用自己的
// 根。@media/@supports 内层递归；@keyframes/@font-face 等块原样；
// 注释与字符串不参与结构判定；已含 zs 的块跳过（幂等）。
// 作用域类由调用方造：编译通道取文档基名（zs-<基名>，与生成类名
// 同源），运行期装载取序号（zs-load-<n>）。运行期挂载件（列表行
// 模板等 Build 之外长出的控件）不携作用域类，其样式放皮肤层。
public class HtmlScope {
    // 样式表 scoping 主入口：逐顶层段（注释 / at 规则 / 普通规则）
    // 走一遍，规则 prelude 改写、块体原样。
    public static string Styles(string css, string zs) {
        int n = css.Length;
        StringBuilder outp = new StringBuilder();
        int i = 0;
        while (i < n) {
            if (i + 1 < n && css.Substring(i, 2) == "/*") {
                int e = FindFrom(css, "*/", i + 2);
                int stop = e < 0 ? n : e + 2;
                outp.Append(css.Substring(i, stop - i));
                i = stop;
                continue;
            }
            if (css[i] == 64) {
                i = ScopeAt(css, i, zs, outp);
                continue;
            }
            int b = i;
            bool real = false;
            bool atStart = false;
            while (b < n) {
                b = SkipNoise(css, b);
                if (b >= n) { break; }
                int cb = css[b] & 255;
                if (cb == 123 || cb == 59 || cb == 125) { break; }
                if (cb == 64 && !real) { atStart = true; break; }
                if (cb != 32 && cb != 9 && cb != 13 && cb != 10) { real = true; }
                b = b + 1;
            }
            if (b >= n) { outp.Append(css.Substring(i)); break; }
            if (atStart) {
                // 段首 @（前面只有空白/注释）：吐前缀，交回 at 分支
                outp.Append(css.Substring(i, b - i));
                i = b;
                continue;
            }
            if ((css[b] & 255) != 123) {
                // 杂尘（裸 ';' / '}'）：原样吐出，不碰后面
                outp.Append(css.Substring(i, b + 1 - i));
                i = b + 1;
                continue;
            }
            outp.Append(ScopePrelude(css.Substring(i, b - i), zs));
            int close = MatchBrace(css, b);
            if (close < 0) { outp.Append(css.Substring(b)); break; }
            outp.Append(css.Substring(b, close + 1 - b));
            i = close + 1;
        }
        return outp.ToString();
    }

    // at 规则：返回处理后的下一个下标。@media/@supports 递归内层；
    // 其余（@keyframes 的百分比段、@font-face、未知块）整块原样。
    public static int ScopeAt(string css, int i, string zs, StringBuilder outp) {
        int n = css.Length;
        int k = i + 1;
        while (k < n && NameByte(css[k] & 255)) { k = k + 1; }
        string atName = css.Substring(i + 1, k - i - 1).ToLower();
        int j = k;
        int depth = 0;
        while (j < n) {
            j = SkipNoise(css, j);
            if (j >= n) { break; }
            int cj = css[j] & 255;
            if (cj == 40) { depth = depth + 1; }
            else if (cj == 41) {
                if (depth > 0) { depth = depth - 1; }
            } else if (depth == 0 && (cj == 123 || cj == 59)) {
                break;
            }
            j = j + 1;
        }
        if (j >= n) { outp.Append(css.Substring(i)); return n; }
        if ((css[j] & 255) == 59) {
            outp.Append(css.Substring(i, j + 1 - i));
            return j + 1;
        }
        int close = MatchBrace(css, j);
        if (close < 0) { outp.Append(css.Substring(i)); return n; }
        if (atName == "media" || atName == "supports") {
            outp.Append(css.Substring(i, j + 1 - i));
            outp.Append(Styles(css.Substring(j + 1, close - j - 1), zs));
            outp.Append("}");
        } else {
            outp.Append(css.Substring(i, close + 1 - i));
        }
        return close + 1;
    }

    // 规则 prelude（选择器列表）：顶层逗号切分，逐片 scoping 后拼回。
    public static string ScopePrelude(string sel, string zs) {
        List<string> parts = new List<string>();
        int n = sel.Length;
        int start = 0;
        int i = 0;
        while (i < n) {
            i = SkipNoise(sel, i);
            if (i >= n) { break; }
            int c = sel[i] & 255;
            if (c == 40 || c == 91) {
                int close = MatchChunk(sel, i);
                i = close < 0 ? n : close;
                continue;
            }
            if (c == 44) {
                parts.Add(sel.Substring(start, i - start));
                start = i + 1;
            }
            i = i + 1;
        }
        parts.Add(sel.Substring(start));
        string outp = "";
        for (int p = 0; p < parts.Count; p = p + 1) {
            if (p > 0) { outp = outp + ","; }
            outp = outp + ScopeOne(parts[p].Trim(), zs);
        }
        return outp;
    }

    // 一片选择器（可能带组合器链）：逐复合块补 zs。注释剥离、空白
    // 归一；显式组合器（>/+/~）覆盖待定后代空格。
    public static string ScopeOne(string piece, string zs) {
        List<string> outp = new List<string>();
        string cur = "";
        string pend = "";
        int n = piece.Length;
        int i = 0;
        while (i < n) {
            int j = SkipNoise(piece, i);
            if (j > i) { i = j; continue; }
            int c = piece[i] & 255;
            if (c == 32 || c == 9 || c == 13 || c == 10) {
                if (cur != "" && pend == "") { pend = " "; }
                i = i + 1;
                continue;
            }
            if (c == 62) {
                pend = ">";
                i = i + 1;
                continue;
            }
            if (c == 43) {
                pend = "+";
                i = i + 1;
                continue;
            }
            if (c == 126) {
                pend = "~";
                i = i + 1;
                continue;
            }
            if (c == 123 || c == 125 || c == 59) {
                break;  // 防御：块边界终止 piece（正常到不了这里）
            }
            if (cur != "" && pend != "") {
                outp.Add(ScopeCompound(cur, zs));
                outp.Add(pend);
                cur = "";
                pend = "";
            }
            if (c == 40 || c == 91 || c == 34 || c == 39) {
                int close = MatchChunk(piece, i);
                int stop = close < 0 ? n : close + 1;
                cur = cur + piece.Substring(i, stop - i);
                i = stop;
                continue;
            }
            cur = cur + piece.Substring(i, 1);
            i = i + 1;
        }
        if (cur != "" || outp.Count == 0) {
            outp.Add(ScopeCompound(cur, zs));
        }
        string s = "";
        for (int k = 0; k < outp.Count; k = k + 1) { s = s + outp[k]; }
        return s;
    }

    // 单复合块补 zs：插到主体名/类列之后、首个伪类/属性之前——
    // 类列顺序无关语义，且保证类在 `::before`/`[attr]` 前的语法序。
    // 已含该类则原样（幂等）；无主体（裸 `:hover`）补 `*` 主体，
    // 否则规则会泄成全局。
    public static string ScopeCompound(string chunk, string zs) {
        if (chunk == "") { return ""; }
        // :root 是全局令牌声明入口；加作用域类会让 CSS 变量收集器漏掉整块。
        if (chunk == ":root") { return chunk; }
        if (HasClsToken(chunk, zs)) { return chunk; }
        int at = 0 - 1;
        int n = chunk.Length;
        int i = 0;
        while (i < n) {
            int j = SkipNoise(chunk, i);
            if (j > i) { i = j; continue; }
            int c = chunk[i] & 255;
            if (c == 58 || c == 91) { at = i; break; }
            if (c == 40) {
                int close = MatchChunk(chunk, i);
                if (close < 0) { i = n; break; }
                i = close + 1;
                continue;
            }
            i = i + 1;
        }
        if (at < 0) { at = n; }
        string ins = at == 0 ? "*." + zs : "." + zs;
        return chunk.Substring(0, at) + ins + chunk.Substring(at);
    }

    // 越过 i 处的注释/字符串（可连续），返回首个"实"字符下标。
    public static int SkipNoise(string s, int i) {
        int n = s.Length;
        while (i < n) {
            if (i + 1 < n && s.Substring(i, 2) == "/*") {
                int e = FindFrom(s, "*/", i + 2);
                i = e < 0 ? n : e + 2;
                continue;
            }
            int c = s[i] & 255;
            if (c == 34 || c == 39) {
                int q = MatchChunk(s, i);
                i = q < 0 ? n : q + 1;
                continue;
            }
            break;
        }
        return i;
    }

    // 括号/引号块的配对下标（引号支持 \\ 转义，括号计嵌套，
    // 注释/内层字符串不参与配对）；找不到返回 -1。
    public static int MatchChunk(string s, int open) {
        int o = s[open] & 255;
        if (o == 34 || o == 39) {
            int n2 = s.Length;
            int i2 = open + 1;
            while (i2 < n2) {
                int c2 = s[i2] & 255;
                if (c2 == 92) { i2 = i2 + 2; continue; }
                if (c2 == o) { return i2; }
                i2 = i2 + 1;
            }
            return 0 - 1;
        }
        int cl = o == 40 ? 41 : 93;
        int depth = 0;
        int n = s.Length;
        int i = open + 1;
        while (i < n) {
            i = SkipNoise(s, i);
            if (i >= n) { return 0 - 1; }
            int c = s[i] & 255;
            if (c == 34 || c == 39) {
                int q = MatchChunk(s, i);
                i = q < 0 ? n : q;
                continue;
            }
            if (c == o) { depth = depth + 1; }
            else if (c == cl) {
                if (depth == 0) { return i; }
                depth = depth - 1;
            }
            i = i + 1;
        }
        return 0 - 1;
    }

    // '{' 的配对 '}'（注释/字符串感知）。
    public static int MatchBrace(string s, int open) {
        int depth = 0;
        int n = s.Length;
        int i = open;
        while (i < n) {
            i = SkipNoise(s, i);
            if (i >= n) { return 0 - 1; }
            int c = s[i] & 255;
            if (c == 123) { depth = depth + 1; }
            else if (c == 125) {
                depth = depth - 1;
                if (depth == 0) { return i; }
            }
            i = i + 1;
        }
        return 0 - 1;
    }

    // 复合块里是否已有 zs 这个类词（".zs-x" 后跟非名字字符）。
    public static bool HasClsToken(string chunk, string zs) {
        string needle = "." + zs;
        int n = chunk.Length;
        int m = needle.Length;
        for (int k = 0; k + m <= n; k = k + 1) {
            if (!StartsWithAt(chunk, k, needle)) { continue; }
            if (k + m >= n) { return true; }
            int c = chunk[k + m] & 255;
            if (!NameByte(c)) { return true; }
        }
        return false;
    }

    public static int FindFrom(string s, string needle, int start) {
        return s.IndexOf(needle, start);
    }

    public static bool StartsWithAt(string s, int at, string needle) {
        int m = needle.Length;
        if (at + m > s.Length) { return false; }
        return s.IndexOf(needle, at) == at;
    }

    public static bool NameByte(int v) {
        return (v >= 48 && v <= 57) || (v >= 65 && v <= 90)
            || (v >= 97 && v <= 122) || v == 45 || v == 95;
    }

    public static bool NameChar(string c) {
        if (c.Length != 1) { return false; }
        return NameByte(c[0] & 255);
    }

    public static bool Alnum(string c) {
        if (c.Length != 1) { return false; }
        int v = c[0] & 255;
        return (v >= 48 && v <= 57) || (v >= 65 && v <= 90)
            || (v >= 97 && v <= 122);
    }
}
