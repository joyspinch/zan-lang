using System;
using System.Threading;

namespace System.Web;

/// <summary>
/// Route attributes in cross-process shared memory: what a route is and what it
/// requires, written once at startup and only read while serving.
///
/// A request is keyed by method and path joined as <c>GET_/user/list</c>, hashed
/// once (<see cref="Key"/>) and that value reused for every table touched on the
/// request, so nothing allocates a key string per request. Rows are identified
/// by the hash, and the original text lives in the <c>path</c> column: a lookup
/// that finds a row still compares the text, so a 64-bit collision cannot make
/// one route inherit another's authentication flags. Registration refuses a
/// colliding route outright, which turns the accident into a startup failure
/// rather than a silent authorisation hole.
///
/// <code>
/// RouteTable routes = RouteTable.Create("app.routes", 4096);
/// routes.Add("GET", "/user/list", 1, 1, 0, "User.List");   // auth, perm
/// ...
/// RouteInfo info = routes.Lookup(hash, "GET_/user/list");
/// if (!info.found) { return HttpResponse.NotFound(); }
/// if (info.auth == 1 && !session.LoggedIn()) { return HttpResponse.Text("401"); }
/// </code>
/// </summary>
class RouteInfo {
    bool found;
    int auth;      // 1: requires a logged-in session
    int perm;      // 1: requires an authorisation check
    int menu;      // 1: shows up in the navigation menu
    string handler;

    RouteInfo() {
        this.found = false;
        this.auth = 0;
        this.perm = 0;
        this.menu = 0;
        this.handler = "";
    }
}

class RouteTable {
    SharedTable table;

    RouteTable() {
        this.table = null;
    }

    /// <summary>Joins a method and path into the table key.</summary>
    static string KeyOf(string method, string path) {
        return method + "_" + path;
    }

    /// <summary>Hashes a key once per request; pass the result to Lookup and to
    /// the statistics table.</summary>
    static long Key(string method, string path) {
        return SharedTable.Hash(RouteTable.KeyOf(method, path));
    }

    RouteTable(string name, int capacity) {
        SharedTable t = new SharedTable(name, capacity);
        t.KeySize(16);
        t.ColumnInt("auth");
        t.ColumnInt("perm");
        t.ColumnInt("menu");
        t.ColumnString("path", 192);
        t.ColumnString("handler", 64);
        if (t.Create()) { this.table = t; }
    }

    /// <summary>Opens the table created by another process.</summary>
    static RouteTable Open(string name) {
        RouteTable r = new RouteTable();
        SharedTable t = SharedTable.Open(name);
        if (!t.IsOpen()) { return null; }
        r.table = t;
        return r;
    }

    /// <summary>Registers one route. Returns false if the table is full or if a
    /// different route already hashes to the same slot -- a collision must fail
    /// the boot, never be resolved by guessing.</summary>
    bool Add(string method, string path, int auth, int perm, int menu, string handler) {
        string key = RouteTable.KeyOf(method, path);
        long h = SharedTable.Hash(key);
        if (this.table.ExistsAt(h)) {
            string existing = this.table.GetStringAt(h, "path");
            if (existing != key) { return false; }
        }
        if (!this.table.SetStringAt(h, "path", key)) { return false; }
        this.table.SetStringAt(h, "handler", handler);
        this.table.SetIntAt(h, "auth", auth);
        this.table.SetIntAt(h, "perm", perm);
        this.table.SetIntAt(h, "menu", menu);
        return true;
    }

    /// <summary>Reads a route's attributes. `key` is the original
    /// <c>METHOD_path</c> text and is compared against the stored one, so a hash
    /// collision reads as "not found" instead of as another route.</summary>
    RouteInfo Lookup(long keyHash, string key) {
        RouteInfo info = new RouteInfo();
        if (!this.table.MatchAt(keyHash, "path", key)) { return info; }
        info.found = true;
        info.auth = (int)this.table.GetIntAt(keyHash, "auth");
        info.perm = (int)this.table.GetIntAt(keyHash, "perm");
        info.menu = (int)this.table.GetIntAt(keyHash, "menu");
        info.handler = this.table.GetStringAt(keyHash, "handler");
        return info;
    }

    /// <summary>Existence only: the cheapest possible 404 check, one hash lookup
    /// plus one string compare.</summary>
    bool Has(long keyHash, string key) {
        return this.table.MatchAt(keyHash, "path", key);
    }

    /// <summary>Whether the route needs a logged-in session. Returns false for
    /// unknown routes; check Has first if that distinction matters.</summary>
    bool NeedsAuth(long keyHash) {
        return this.table.GetIntAt(keyHash, "auth") != 0;
    }

    int Count() {
        return this.table.Count();
    }

    bool Destroy() {
        return this.table.Destroy();
    }
}
