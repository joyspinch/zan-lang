using System;
using System.Json;
using System.Text;

namespace System.Web;

// 设计器文档的 HTML 存取编解码器（WEB_GUI_ROADMAP P7）：把设计器
// 的 JSON 文档模型与 HTML 文本互相转换——HTML 从此是设计器
// 的存取格式。纯字符串层，不依赖 Gui：设计器
// (Gui.Designer)、编译期生成器 (GenForm/GenHtml) 两端共用。
// 编码规则（全键保真往返）：
// - 文档级键（name/winW/role/...）→ <body> 的 data-<kebab> 属性；
// name 另发 id 便于阅读；body 带 data-zan-design 标记（IsDesignDoc
// 据此区分设计稿与普通 HTML UI 文档）。docCss 单独发 <style>，
// bodyClass/bodyStyle 发原生壳属性，不占文档 class/style 的键。
// - 字段对象 → 元素：kind 决定 tag，能原生就原生（Panel→div、
// 核心契约与语义定义。
// DatePicker→input+type=…，其余 div），kind 本身存 data-kind
// （自定义组件/共享控件的权威标记，读端优先于 tag 兜底）；
// name → id；class → class；style → style；kids → 子元素。Element
// 用 tag；未显式标组件的原生容器用 htmlTag 保留标签，旧带定位键的
// 裸 div 仍是 Panel。纯文本沿用 text；htmlContent/bodyContent 是
// string 文本片或 int 子树下标（kids/fields），保留混排文档次序。
// - 原生属性/内容直进原生通道：<img src/alt>、<input/textarea
// placeholder/value>、表单族 min/max/step、<progress value/max>、
// checkbox/radio 的 value(=label)/checked(=defOn)、<select> 的
// <option> 子元素（含 selected）、button/label/textarea/p 的
// 文本内容——与 data-* 通道等价，读端不分来源。
// - 其余标量键 → data-<kebab>="值"（camelCase 键名 kebab 化——
// 解析器把属性名整体小写，kebab 保大小写信息；false/""/0 跳过，
// 与 HTML 布尔属性同趣，读端有缺省）。
// - 事件键 on<Event> → data-on-<kebab 事件名>：与 P5 运行时事件
// 协议 data-on-<evt>="名" 完全同形（LoadHtml 与设计稿一致）。
// - 复合值（props 直通表、DataGrid columns、winShape 区域数组…）
// → data-x-<kebab>='<紧凑 JSON>'，读端原样解析回对象/数组——
// 字符串值不作数字/布尔嗅探，props 的 "min":"0" 不会漂成数字。
// - options（字符串数组）→ data-options="a|b|c"（与 JoinOpts 同
// 分隔，| 内嵌限制相同）。
// - 属性值统一实体转义（& < > " '）；原生语义发原生形态——img 的
// src/alt、input/textarea 的 placeholder/value 发真属性，
// button/label/textarea 的 text 发元素文本（读端与 data-* 通道
// 等价），其余键全在属性里，规避 HTML 空白塌缩。
class DesignerHtml {
    // 是否设计器文档：body 带 data-zan-design 标记。标记是裸属性
    // （值为空串），不能用 Attr(...) != "" 判——那样存在与缺失
    // 不可区分，永远返回 false。
    static bool IsDesignDoc(string html) {
        WDoc wd = HtmlParser.Parse(html, "");
        if (wd.nodes.Count == 0) { return false; }
        WNode body = wd.nodes[0];
        for (int i = 0; i < wd.nodes.Count; i = i + 1) {
            if (wd.nodes[i].tag == "body") { body = wd.nodes[i]; break; }
        }
        for (int i = 0; i < body.attrs.Count; i = i + 1) {
            if (body.attrs[i].name == "data-zan-design") { return true; }
        }
        return false;
    }

    // 设计器 JSON 文档 → HTML 文本。
    static string FromJsonDoc(string json) {
        JsonValue doc = JsonValue.ParseLenient(json);
        if (doc == null || !doc.IsObject()) { return ""; }
        StringBuilder b = new StringBuilder();
        b.Append("<!doctype html>\n<html>\n<head>\n");
        b.Append("<meta charset=\"utf-8\">\n");
        string nm = doc.Str("name", "");
        if (nm != "") {
            b.Append("<title>" + EscapeAttr(nm) + "</title>\n");
        }
        JsonValue css = doc.Get("docCss");
        if (css != null && css.IsString()) {
            b.Append("<style>" + css.AsString("") + "</style>\n");
        }
        b.Append("</head>\n<body data-zan-design");
        if (nm != "") { b.Append(" id=\"" + EscapeAttr(nm) + "\""); }
        JsonValue bc = doc.Get("bodyClass");
        if (bc != null && bc.IsString()) {
            b.Append(" class=\"" + EscapeAttr(bc.AsString("")) + "\"");
        }
        JsonValue bs = doc.Get("bodyStyle");
        if (bs != null && bs.IsString()) {
            b.Append(" style=\"" + EscapeAttr(bs.AsString("")) + "\"");
        }
        for (int i = 0; i < doc.Count(); i = i + 1) {
            string key = doc.KeyAt(i);
            if (key == "fields" || key == "name" || key == "docCss"
                || key == "bodyClass" || key == "bodyStyle"
                || key == "bodyContent") { continue; }
            AppendKey(b, doc.ValAt(i), key, 0);
        }
        JsonValue fields = doc.Get("fields");
        JsonValue content = doc.Get("bodyContent");
        if (content != null && content.IsArray()) {
            b.Append(">");
            AppendContent(b, content, fields, 1);
        } else {
            bool tight = HasInlineKids(fields);
            b.Append(tight ? ">" : ">\n");
            if (fields != null && fields.IsArray()) {
                for (int i = 0; i < fields.Count(); i = i + 1) {
                    FieldHtml(b, fields.At(i), 1, tight);
                }
            }
        }
        b.Append("</body>\n</html>\n");
        return b.ToString();
    }

    // HTML 文本 → 设计器 JSON 文档（PrettyToJson 字符串）。
    static string ToJsonDoc(string html) {
        WDoc wd = HtmlParser.Parse(html, "");
        WNode body = wd.nodes.Count > 0 ? wd.nodes[0] : null;
        for (int i = 0; i < wd.nodes.Count; i = i + 1) {
            if (wd.nodes[i].tag == "body") { body = wd.nodes[i]; break; }
        }
        if (body == null) { return ""; }
        JsonValue doc = JsonValue.NewObject();
        for (int i = 0; i < body.attrs.Count; i = i + 1) {
            string a = body.attrs[i].name;
            string v = body.attrs[i].val;
            if (a == "data-zan-design") { continue; }
            if (a == "id") { doc.Put("name", JsonValue.NewStr(v)); continue; }
            if (a.Length > 5 && HtmlText.StartsWith(a, "data-")) {
                PutAttr(doc, a.Substring(5), v);
            }
        }
        // 原生壳属性独立于文档级 data-class/data-style，不能抢它们的键。
        for (int i = 0; i < body.attrs.Count; i = i + 1) {
            WAttr a = body.attrs[i];
            if (a.name == "class") { doc.Set("bodyClass", JsonValue.NewStr(a.val)); }
            if (a.name == "style") { doc.Set("bodyStyle", JsonValue.NewStr(a.val)); }
        }
        if (wd.css != "") {
            // CloseTop 给每个 style 补一行分隔；最后一行不是源内容。
            // 只剥这一行，源样式自己的首尾空白与块间分隔保持不变。
            doc.Set("docCss", JsonValue.NewStr(wd.css.Substring(0, wd.css.Length - 1)));
        }
        JsonValue fields = JsonValue.NewArray();
        JsonValue content = JsonValue.NewArray();
        for (int i = 0; i < body.items.Count; i = i + 1) {
            WItem it = body.items[i];
            if (it.kid < 0) {
                if (it.text != "") {
                    content.Append(JsonValue.NewStr(it.text));
                }
            } else {
                content.Append(JsonValue.NewNum(Convert.ToString(fields.Count())));
                fields.Append(FieldJson(wd, wd.nodes[it.kid]));
            }
        }
        // 即使只有控件或空 body，也要保留 HTML 根身份与文档序；
        // 缺少这层声明会让建树端误按旧 JSON 的流式 Panel 根处理。
        doc.Set("bodyContent", content);
        doc.Put("fields", fields);
        return doc.PrettyToJson() + "\n";
    }

    // ---- 元素 ↔ 字段 -----------------------------------------------------

    static bool IsPlacementKey(string key) {
        return key == "fx" || key == "fy" || key == "fw" || key == "fh"
            || key == "dock" || key == "span" || key == "position"
            || key == "anchor" || key == "flexGrow";
    }

    static bool HasNodeAttr(WNode n, string name) {
        for (int i = 0; i < n.attrs.Count; i = i + 1) {
            if (n.attrs[i].name == name) { return true; }
        }
        return false;
    }

    static bool HasPlacementAttrs(WNode n) {
        for (int i = 0; i < n.attrs.Count; i = i + 1) {
            string a = n.attrs[i].name;
            if (HtmlText.StartsWith(a, "data-")
                && IsPlacementKey(Unkebab(a.Substring(5)))) { return true; }
        }
        return false;
    }

    static bool HasPlacementKeys(JsonValue o) {
        for (int i = 0; i < o.Count(); i = i + 1) {
            string key = o.KeyAt(i);
            if (!IsPlacementKey(key)) { continue; }
            JsonValue v = o.ValAt(i);
            if (v == null) { continue; }
            if (v.IsNumber()) {
                if (v.ToJson() != "0" || key == "fx" || key == "fy"
                    || key == "fw" || key == "fh") { return true; }
            } else if (v.IsString()) {
                if (v.AsString("") != "") { return true; }
            } else if (v.IsBool() && v.AsBool(false)) { return true; }
        }
        return false;
    }

    static void AppendContent(StringBuilder b, JsonValue content,
                              JsonValue kids, int depth) {
        int count = kids != null && kids.IsArray() ? kids.Count() : 0;
        int[] emitted = new int[count];
        for (int i = 0; i < content.Count(); i = i + 1) {
            JsonValue item = content.At(i);
            if (item.IsString()) { b.Append(EscapeAttr(item.AsString(""))); }
            else if (item.IsNumber()) {
                int index = item.AsInt(0 - 1);
                if (index >= 0 && index < count && emitted[index] == 0
                    && item.ToJson() == Convert.ToString(index)) {
                    FieldHtml(b, kids.At(index), depth, true);
                    emitted[index] = 1;
                }
            }
        }
        // 新增的子节点尚未进有序表时仍要写回，不能因为旧索引丢控件。
        for (int i = 0; i < count; i = i + 1) {
            if (emitted[i] == 0) { FieldHtml(b, kids.At(i), depth, true); }
        }
    }

    static string FieldTag(JsonValue o) {
        string kind = o.Str("kind", "");
        string tag = kind == "Element" ? o.Str("tag", "")
            : (kind == "Panel" ? o.Str("htmlTag", "") : "");
        if (kind == "Element" || tag != "") {
            return IsTagName(tag) ? tag : "div";
        }
        return KindTag(kind);
    }

    static bool HasInlineKids(JsonValue kids) {
        if (kids == null || !kids.IsArray()) { return false; }
        for (int i = 0; i < kids.Count(); i = i + 1) {
            if (HtmlText.IsInlineTag(FieldTag(kids.At(i)))) { return true; }
        }
        return false;
    }

    static void FieldHtml(StringBuilder b, JsonValue o, int depth) {
        FieldHtml(b, o, depth, false);
    }

    static void FieldHtml(StringBuilder b, JsonValue o, int depth, bool compact) {
        string kind = o.Str("kind", "");
        string tag = FieldTag(o);
        string nativeTag = kind == "Panel" ? o.Str("htmlTag", "") : "";
        bool nativeElement = kind == "Element" || nativeTag != "";
        string pad = "";
        if (!compact) {
            for (int i = 0; i < depth; i = i + 1) { pad = pad + "  "; }
        }
        string end = compact ? "" : "\n";
        JsonValue content = o.Get("htmlContent");
        bool hasContent = content != null && content.IsArray();
        b.Append(pad + "<" + tag);
        string nm = o.Str("name", "");
        if (nm != "") { b.Append(" id=\"" + EscapeAttr(nm) + "\""); }
        // zan-* 或带旧定位键的 div 能恢复组件 kind；其余 Panel 必须
        // 显式打标，才能和无定位信息的原生 div 区分。htmlTag 保持原生。
        bool kindFromTag = (HtmlText.StartsWith(tag, "zan-") && TagKind(tag) == kind)
            || (tag == "div" && kind == "Panel" && HasPlacementKeys(o));
        if (nativeTag == "" && !kindFromTag) {
            b.Append(" data-kind=\"" + EscapeAttr(kind) + "\"");
        }
        if (nativeTag == "div" && HasPlacementKeys(o)) {
            // 原生 div 加了设计几何后仍是 Element；只记来源，正文/样式
            // 仍沿原生通道，不让旧裸 div 的 Panel 判定改变实例类型。
            b.Append(" data-html-tag=\"div\"");
        }
        // input 变体组件发 type：<input type="checkbox"> 一族读起来
        // 就是原生表单控件。
        string ity = DesignerHtml.KindInputType(kind);
        if (ity != "") { b.Append(" type=\"" + ity + "\""); }
        // 带参事件声明（data-arg）：与运行时 HTML 协议同键同名。
        // 发原生 data-arg 属性——.html 设计稿读起来就是真 HTML。
        string argv = o.Str("arg", "");
        if (argv != "") {
            b.Append(" data-arg=\"" + EscapeAttr(argv) + "\"");
        }
        // ---- 固定序属性区 ------------------------------------------------
        // class/style/各 kind 的原生语义属性一律按下面这个固定顺序发射，
        // 不随模型键序走。模型键序是读端按文件序回填的：发射序若随模型
        // 序，异序文档（手写/旧版生成，如 coreforge 的 value/max/style）
        // 每读存一代就换一次属性位置，永不确定型。固定序让 FromJsonDoc
        // 成为 (kind, 键集) 的纯函数——异序文档读存一代即收敛。
        JsonValue cv = o.Get("class");
        if (cv != null && cv.IsString() && cv.AsString("") != "") {
            b.Append(" class=\"" + EscapeAttr(cv.AsString("")) + "\"");
        }
        JsonValue sv = o.Get("style");
        if (sv != null && sv.IsString() && sv.AsString("") != "") {
            // 内联声明走真 style 属性：.html 设计稿因此就是合法的
            // 运行时 HTML（App.LoadHtml 直接吃同一语义）。
            b.Append(" style=\"" + EscapeAttr(sv.AsString("")) + "\"");
        }
        // <a> 的 href/target 是链接语义（GenHtml 同款放行），通用
        // title 是悬停提示：三者发原生属性，文档读起来就是真 HTML。
        // href/target 只在 a 标签上原生发射——其余标签的这些模型键
        // 来自 data- 通道，回落通用 data- 发射保持原形态。
        if (tag == "a") {
            JsonValue hv = o.Get("href");
            if (hv != null && hv.IsString() && hv.AsString("") != "") {
                b.Append(" href=\"" + EscapeAttr(hv.AsString("")) + "\"");
            }
            JsonValue tgv = o.Get("target");
            if (tgv != null && tgv.IsString() && tgv.AsString("") != "") {
                b.Append(" target=\"" + EscapeAttr(tgv.AsString("")) + "\"");
            }
        }
        JsonValue tlv = o.Get("title");
        if (tlv != null && tlv.IsString() && tlv.AsString("") != "") {
            b.Append(" title=\"" + EscapeAttr(tlv.AsString("")) + "\"");
        }
        // 原生语义键发原生属性：img 的 src/alt、input/textarea 的
        // placeholder/value——文档读起来就是真 HTML。
        if (kind == "Image") {
            JsonValue nv = o.Get("src");
            if (nv != null && nv.IsString() && nv.AsString("") != "") {
                b.Append(" src=\"" + EscapeAttr(nv.AsString("")) + "\"");
            }
            JsonValue nv2 = o.Get("alt");
            if (nv2 != null && nv2.IsString() && nv2.AsString("") != "") {
                b.Append(" alt=\"" + EscapeAttr(nv2.AsString("")) + "\"");
            }
        }
        if (kind == "Input" || kind == "TextArea") {
            JsonValue pv = o.Get("placeholder");
            if (pv != null && pv.IsString() && pv.AsString("") != "") {
                b.Append(" placeholder=\"" + EscapeAttr(pv.AsString("")) + "\"");
            }
            JsonValue vv = o.Get("value");
            if (vv != null && vv.IsString() && vv.AsString("") != "") {
                b.Append(" value=\"" + EscapeAttr(vv.AsString("")) + "\"");
            }
        }
        // 系统底层交互与数据流转契约
        if (kind == "Slider" || kind == "InputNumber") {
            JsonValue mn = o.Get("min");
            if (mn != null) {
                string ms = mn.IsString() ? mn.AsString("")
                    : (mn.IsNumber() ? Convert.ToString(mn.AsInt(0)) : "");
                if (ms != "") { b.Append(" min=\"" + EscapeAttr(ms) + "\""); }
            }
            JsonValue mx = o.Get("max");
            if (mx != null) {
                string xs = mx.IsString() ? mx.AsString("")
                    : (mx.IsNumber() ? Convert.ToString(mx.AsInt(0)) : "");
                if (xs != "") { b.Append(" max=\"" + EscapeAttr(xs) + "\""); }
            }
            JsonValue sp = o.Get("step");
            if (sp != null) {
                string ss = sp.IsString() ? sp.AsString("")
                    : (sp.IsNumber() ? Convert.ToString(sp.AsInt(0)) : "");
                if (ss != "") { b.Append(" step=\"" + EscapeAttr(ss) + "\""); }
            }
            JsonValue vv2 = o.Get("value");
            if (vv2 != null) {
                string vs = vv2.IsString() ? vv2.AsString("")
                    : (vv2.IsNumber() ? Convert.ToString(vv2.AsInt(0)) : "");
                if (vs != "") { b.Append(" value=\"" + EscapeAttr(vs) + "\""); }
            }
        }
        if (kind == "ColorPicker" || kind == "DatePicker") {
            JsonValue cvv = o.Get("value");
            if (cvv != null && cvv.IsString() && cvv.AsString("") != "") {
                b.Append(" value=\"" + EscapeAttr(cvv.AsString("")) + "\"");
            }
        }
        // checkbox/radio 的原生 value 是可视文案；checked 是初始勾选。
        if (kind == "Checkbox" || kind == "Radio") {
            JsonValue lv = o.Get("label");
            if (lv != null && lv.IsString() && lv.AsString("") != "") {
                b.Append(" value=\"" + EscapeAttr(lv.AsString("")) + "\"");
            }
            JsonValue don = o.Get("defOn");
            if (don != null && don.IsBool() && don.AsBool(false)) {
                b.Append(" checked=\"true\"");
            }
        }
        // <progress value="72" max="100">：percent 折回原生双属性。
        if (kind == "Progress") {
            JsonValue pc = o.Get("percent");
            if (pc != null) {
                int pci = pc.IsNumber() ? pc.AsInt(0)
                    : Convert.ToInt32(pc.AsString("0"));
                if (pci < 0) { pci = 0; }
                if (pci > 100) { pci = 100; }
                b.Append(" value=\"" + Convert.ToString(pci) + "\" max=\"100\"");
            }
        }
        // 文本键通道判定：<hr> 无正文，Divider 的标题一律走 data-text；
        // button/label 一族安全文本走元素正文（收尾），含易折叠空白
        // （首尾空白/换行/制表）的改走 data-text——EscapeAttr 实体转义
        // 后逐字节往返，元素正文通道会被解析器 Trim/折叠，丢内容。
        bool textIsBody = !HtmlText.IsVoidTag(tag) && kind != "SelectBox";
        if (kind == "Divider") {
            JsonValue dv = o.Get("text");
            if (dv != null && dv.IsString() && dv.AsString("") != "") {
                b.Append(" data-text=\"" + EscapeAttr(dv.AsString("")) + "\"");
            }
        } else if (textIsBody) {
            JsonValue tv = o.Get("text");
            if (tv != null && tv.IsString()) {
                string ts = tv.AsString("");
                bool exact = !TextIsHtmlSafe(ts);
                if (nativeElement) {
                    // 原生 span 的规范化尾空格能直接往返；旧多行/首空格
                    // 则同时保留精确声明和正文。旧 Element 的显式空文本
                    // 也须留标记，正文空串无法区分清空声明与缺省文本。
                    exact = ts == "" ? kind == "Element"
                        : (HtmlText.CollapseSpace(ts) != ts || ts[0] == 32
                            || (!HtmlText.IsInlineTag(tag)
                                && ts[ts.Length - 1] == 32));
                }
                if (exact || hasContent) {
                    b.Append(" data-text=\"" + EscapeAttr(ts) + "\"");
                }
            }
        }
        // 其余键按模型序走通用通道（读端同序回填，模型序即文件序，稳定）。
        for (int i = 0; i < o.Count(); i = i + 1) {
            string key = o.KeyAt(i);
            JsonValue v = o.ValAt(i);
            if (v == null) { continue; }
            if (key == "kind" || key == "name" || key == "class"
                || key == "style" || key == "arg" || key == "kids"
                || key == "htmlTag" || key == "htmlContent") {
                continue;  // 原生标签、文本/子节点次序都走真正的 HTML 内容
            }
            if (kind == "Element" && key == "tag") { continue; }
            if (kind == "Image" && (key == "src" || key == "alt")) { continue; }
            if ((kind == "Input" || kind == "TextArea")
                && (key == "placeholder" || key == "value")) { continue; }
            if ((textIsBody || kind == "Divider") && key == "text") { continue; }
            if (kind == "Progress" && key == "percent") { continue; }
            if (kind == "SelectBox"
                && (key == "options" || key == "value")) { continue; }
            if ((kind == "Checkbox" || kind == "Radio")
                && (key == "label" || key == "defOn")) { continue; }
            if ((kind == "Slider" || kind == "InputNumber")
                && (key == "min" || key == "max" || key == "step"
                    || key == "value")) { continue; }
            if ((kind == "ColorPicker" || kind == "DatePicker")
                && key == "value") { continue; }
            // href/target/title 已在固定序区发过原生属性，通用通道
            // 不再重复——否则读端两通道各 Put 一次出重复键。
            if (key == "title") { continue; }
            if (tag == "a" && (key == "href" || key == "target")) { continue; }
            AppendKey(b, v, key, 1);
        }
        // <select>：候选发 <option> 子元素，value 下标标 selected。
        if (kind == "SelectBox") {
            string opts = o.Str("options", "");
            int selIdx = o.Has("value") ? o.Int("value", -1) : 0 - 1;
            b.Append(">" + end);
            int oi = 0;
            int p = 0;
            while (p < opts.Length) {
                int q = opts.IndexOf("|", p);
                string one = q < 0 ? opts.Substring(p) : opts.Substring(p, q - p);
                b.Append((compact ? "" : pad + "  ") + "<option");
                if (oi == selIdx) { b.Append(" selected"); }
                b.Append(">" + EscapeAttr(one) + "</option>" + end);
                oi = oi + 1;
                if (q < 0) { break; }
                p = q + 1;
            }
            b.Append(pad + "</select>" + end);
            return;
        }
        if (HtmlText.IsVoidTag(tag)) {
            b.Append(" />" + end);
            return;
        }
        JsonValue kids = o.Get("kids");
        if (hasContent) {
            b.Append(">");
            AppendContent(b, content, kids, depth + 1);
            b.Append("</" + tag + ">" + end);
            return;
        }
        JsonValue tv = o.Get("text");
        string ts = tv != null && tv.IsString() ? tv.AsString("") : "";
        bool bodyText = ts != "" && (nativeElement || TextIsHtmlSafe(ts));
        if (kids != null && kids.IsArray() && kids.Count() > 0) {
            // 行内父子之间的格式化空白会变成真实文本，即使原稿没有文本。
            bool tight = compact || bodyText || HtmlText.IsInlineTag(tag)
                || HasInlineKids(kids);
            b.Append(">" + (tight ? "" : "\n"));
            if (bodyText) { b.Append(EscapeAttr(ts)); }
            for (int i = 0; i < kids.Count(); i = i + 1) {
                FieldHtml(b, kids.At(i), depth + 1, tight);
            }
            b.Append((tight ? "" : pad) + "</" + tag + ">" + end);
            return;
        }
        b.Append(">" + (bodyText ? EscapeAttr(ts) : "") + "</" + tag + ">" + end);
    }

    static JsonValue FieldJson(WDoc doc, WNode n) {
        JsonValue o = JsonValue.NewObject();
        string kind = HtmlText.NodeAttr(n.attrs, "data-kind");
        if (kind == "" && n.tag == "template") { kind = "Element"; }
        if (kind == "") { kind = TagKind(n.tag); }
        if (kind == "") { kind = "Panel"; }
        // 系统底层交互与数据流转契约
        // （data-kind 缺失才兜底，见 InputTypeKind）。
        if (kind == "Input" && n.tag == "input" && !HasNodeAttr(n, "data-kind")) {
            kind = DesignerHtml.InputTypeKind(
                HtmlText.NodeAttr(n.attrs, "type"));
        }
        o.Put("kind", JsonValue.NewStr(kind));
        string id = HtmlText.NodeAttr(n.attrs, "id");
        if (id != "") { o.Put("name", JsonValue.NewStr(id)); }
        // 保留旧 tag→kind 映射，同时让新导入的原生容器保有真实标签。
        // 旧设计器把带定位键的裸 div 当 Panel，不能改它的实例类型。
        if (kind == "Element") { o.Put("tag", JsonValue.NewStr(n.tag)); }
        else if (!HasNodeAttr(n, "data-kind")
            && TagKind(n.tag) == "Panel" && !HtmlText.StartsWith(n.tag, "zan-")
            && (n.tag != "div" || !HasPlacementAttrs(n)
                || HtmlText.NodeAttr(n.attrs, "data-html-tag") == "div")) {
            o.Put("htmlTag", JsonValue.NewStr(n.tag));
        }
        string pgV = "";
        string pgM = "";
        for (int i = 0; i < n.attrs.Count; i = i + 1) {
            string a = n.attrs[i].name;
            string v = n.attrs[i].val;
            if (a == "id" || a == "data-kind" || a == "data-html-tag"
                || a == "data-x-html-tag") { continue; }
            if (a == "class") {
                if (v != "") { o.Put("class", JsonValue.NewStr(v)); }
                continue;
            }
            if (a == "style") {
                // 元素 style 属性 ↔ 字段 "style" 键（内联声明）。
                if (v != "") { o.Put("style", JsonValue.NewStr(v)); }
                continue;
            }
            // checkbox/radio 的原生 value 是可视文案（label）而非取值；
            // checked 是初始勾选（= defOn）。写 value="记住我" checked。
            // （必须先于下面的通用 value 分支。）
            if ((kind == "Checkbox" || kind == "Radio") && a == "value") {
                if (v != "") { o.Put("label", JsonValue.NewStr(v)); }
                continue;
            }
            if (kind == "Checkbox" && a == "checked") {
                if (v == "" || v == "checked" || v == "true") {
                    o.Put("defOn", JsonValue.NewBool(true));
                }
                continue;
            }
            // <progress value max>：两属性先截下（不入模型），
            // 循环后折算成 percent——模型里只留 percent 一个键。
            if (kind == "Progress" && (a == "value" || a == "max")) {
                if (a == "value") { pgV = v; }
                else { pgM = v; }
                continue;
            }
            // 系统底层交互与数据流转契约
            // 的 placeholder/value、表单族的 min/max/step、<a> 的
            // href/target（GenHtml 生成通道同款放行，设计器往返
            // 不得丢链接）与通用悬停 title。与 data-* 通道写进同
            // 一个键空间（src="x" ≡ data-src="x"），读端不分来源。
            // Has 守卫：手写文档两通道同键并发时只取先到的，
            // 否则 Put 追加出重复键。
            if (a == "src" || a == "alt" || a == "placeholder"
                || a == "value" || a == "min" || a == "max"
                || a == "step" || a == "href" || a == "target"
                || a == "title") {
                if (v != "" && !o.Has(a)) { o.Put(a, JsonValue.NewStr(v)); }
                continue;
            }
            if (a == "data-text") {
                // 文案是精确字符串，"0"/"true" 与空串都不是数值或布尔。
                o.Set("text", JsonValue.NewStr(v));
                continue;
            }
            if (a.Length > 5 && HtmlText.StartsWith(a, "data-")) {
                if (a == "data-arg") { continue; }  // 循环后统一折 "arg"
                PutAttr(o, a.Substring(5), v);
            }
        }
        // data-arg 是事件通道的键：折成模型 "arg"（FieldHtml 对称发
        // data-arg 属性）。单点折键，避免通用通道与这里重复 Put。
        string darg = HtmlText.NodeAttr(n.attrs, "data-arg");
        if (darg != "") { o.Put("arg", JsonValue.NewStr(darg)); }
        // <progress value max> → percent（原生两属性表达的是同一信息）。
        if (kind == "Progress" && pgV != "") {
            int pv = Convert.ToInt32(pgV);
            int pm = Convert.ToInt32(pgM != "" ? pgM : "100");
            if (pm <= 0) { pm = 100; }
            int pct = pv * 100 / pm;
            if (pct < 0) { pct = 0; }
            if (pct > 100) { pct = 100; }
            o.Put("percent", JsonValue.NewNum(Convert.ToString(pct)));
        }
        // <select><option>…</option></select>：option 文本即候选
        // （"a|b|c" 建模键），selected 属性 → 选中下标（value 键）。
        if (kind == "SelectBox") {
            string opts = "";
            int selIdx = 0 - 1;
            int oi = 0;
            for (int i = 0; i < n.items.Count; i = i + 1) {
                WItem it = n.items[i];
                if (it.kid < 0) { continue; }
                WNode cn = doc.nodes[it.kid];
                if (cn.tag != "option") { continue; }
                string ot = cn.text;
                if (ot == "") {
                    for (int k = 0; k < cn.items.Count; k = k + 1) {
                        WItem cit = cn.items[k];
                        if (cit.kid >= 0 || cit.text == "") { continue; }
                        ot = ot + cit.text;
                    }
                }
                ot = ot.Trim();
                for (int q = 0; q < cn.attrs.Count; q = q + 1) {
                    if (cn.attrs[q].name == "selected") { selIdx = oi; }
                }
                if (ot != "") {
                    if (oi > 0) { opts = opts + "|"; }
                    opts = opts + ot;
                }
                oi = oi + 1;
            }
            if (opts != "") { o.Put("options", JsonValue.NewStr(opts)); }
            // 浏览器语义：没有任何 option 带 selected 时显示首项，
            // 所以选中也落到 0 而不是"未选"。
            if (selIdx < 0 && opts != "") { selIdx = 0; }
            if (selIdx >= 0) {
                o.Put("value", JsonValue.NewNum(Convert.ToString(selIdx)));
            }
        }
        // select 的子元素已在上面折成 options，不再当容器 kids 递归。
        if (kind == "SelectBox") { return o; }
        JsonValue kids = JsonValue.NewArray();
        JsonValue content = JsonValue.NewArray();
        string txt = n.text;
        bool hasText = false;
        for (int i = 0; i < n.items.Count; i = i + 1) {
            WItem it = n.items[i];
            if (it.kid < 0) {
                if (it.text != "") {
                    content.Append(JsonValue.NewStr(it.text));
                    txt = txt + it.text;
                    hasText = true;
                }
            } else {
                content.Append(JsonValue.NewNum(Convert.ToString(kids.Count())));
                kids.Append(FieldJson(doc, doc.nodes[it.kid]));
            }
        }
        if (hasText && kids.Count() > 0) {
            // kids 是唯一子树；有序表只存文本或 kids 下标，编辑子树不会
            // 同时留下一份过期副本。不能格式化这个表的元素间空白。
            o.Set("htmlContent", content);
        } else {
            if (kind != "Element" && !o.Has("htmlTag")) { txt = txt.Trim(); }
            // 旧 data-text 是精确控件文案，不能被规范化的正文覆盖。
            if (txt != "" && !o.Has("text")) { o.Put("text", JsonValue.NewStr(txt)); }
        }
        if (kids.Count() > 0) { o.Put("kids", kids); }
        return o;
    }

    // 一个 data- 后缀属性折进对象：on-<kebab> → "on"+Pascal 事件键；
    // x-<kebab> → 复合 JSON 或字符串的未建模键；其余 → Unkebab 键 +
    // 标量嗅探（true/false → 布尔，整数/小数字面 → 数字，其余字符串）。
    static void PutAttr(JsonValue o, string suffix, string v) {
        if (HtmlText.StartsWith(suffix, "on-")) {
            // 事件键恢复 Pascal（"on-click" → "onClick"；多段
            // "on-row-click" → "onRowClick"）。
            string ev = suffix.Substring(3);
            if (ev.Length > 0 && ev[0] >= 97 && ev[0] <= 122) {
                ev = (char)(ev[0] - 32) + ev.Substring(1);
            }
            o.Put("on" + Unkebab(ev), JsonValue.NewStr(v));
            return;
        }
        if (HtmlText.StartsWith(suffix, "x-")) {
            string key = Unkebab(suffix.Substring(2));
            if (v != "" && (v[0] == 123 || v[0] == 91)) {
                JsonValue parsed = null;
                try { parsed = JsonValue.Parse(v); } catch (Exception ex) {
                    parsed = null;
                }
                if (parsed != null) { o.Put(key, parsed); return; }
            }
            o.Put(key, JsonValue.NewStr(v));
            return;
        }
        string key2 = Unkebab(suffix);
        if (v == "true" || v == "false") {
            o.Put(key2, JsonValue.NewBool(v == "true"));
            return;
        }
        if (IsNumeric(v)) { o.Put(key2, JsonValue.NewNum(v)); return; }
        o.Put(key2, JsonValue.NewStr(v));
    }

    // 键值 → 属性写出发射（标量 false/""/0 跳过；复合值走 x- JSON）。
    // 零值/空串有义的键豁免跳过：几何四键 fx/fy/fw/fh（矩形边界，
    // FieldJson 无条件写出，丢了会在解码端回落到 32 的缺省高）、
    // winZoom（0 = 适应视口，模型缺省 1000）、layoutMode（0 = 吸附/
    // 流式布局，丢了读端回落 1 变自由布局）、pad/gap（0 = 显式无
    // 内边距/间距，压过样式表缺省）、label/placeholder（"" = 显式
    // 清空，缺了会回落 kind 缺省文案）。其余键 0/"" == 读端缺省，
    // 跳过保持文档干净；
    // 新键是否入名单由模型级往返等价校验兜底。
    static void AppendKey(StringBuilder b, JsonValue v, string key,
                          int mode) {
        if (v.IsBool()) {
            if (v.AsBool(false)) {
                b.Append(" data-" + KebabKey(key) + "=\"true\"");
            }
            return;
        }
        if (v.IsNumber()) {
            string t = v.ToJson();
            if (t != "0" || key == "fx" || key == "fy" || key == "fw"
                || key == "fh" || key == "winZoom" || key == "layoutMode"
                || key == "pad" || key == "gap") {
                b.Append(" data-" + KebabKey(key) + "=\"" + t + "\"");
            }
            return;
        }
        if (v.IsString()) {
            string s = v.AsString("");
            if (s != "" || key == "label" || key == "placeholder") {
                b.Append(" data-" + KebabKey(key) + "=\""
                         + EscapeAttr(s) + "\"");
            }
            return;
        }
        // 复合值（数组/对象）：紧凑 JSON 进 x- 属性
        b.Append(" data-x-" + KebabKey(key) + "=\""
                 + EscapeAttr(v.ToJson()) + "\"");
    }

    // ---- 键名 kebab ↔ camel ----------------------------------------------

    // "winW" → "win-w"；"onClick" → "on-click" 由调用方拆 on 前缀后
    // 调用（这里只处理纯 Pascal/camel 段）。
    // 键名会拼进属性名位置（data-<kebab>），不可信设计稿的键不得
    // 携带引号/等号/空白等注入字符：非字母数字的字节一律
    // 丢弃（kebab 连字符除外，由本函数的大写转换自己产生）。常规
    // camelCase 键不受影响；含 _ . : 等的历史键往返会归并——读端
    // Unkebab 只为文档可读性，不承担安全语义。
    static string KebabKey(string s) {
        string outp = "";
        for (int i = 0; i < s.Length; i = i + 1) {
            int c = s[i];
            if (c >= 65 && c <= 90) {
                if (i > 0) { outp = outp + "-"; }
                outp = outp + (char)(c + 32);
            } else if ((c >= 97 && c <= 122) || (c >= 48 && c <= 57)
                       || c == 45) {
                outp = outp + s.Substring(i, 1);
            }
            // 其余字节丢弃：属性名位置的注入面在此收口。
        }
        return outp;
    }

    // "win-w" → "winW"；"row-click" → "RowClick"（事件端用）。
    static string Unkebab(string s) {
        List<string> parts = s.Split("-");
        string outp = parts.Count > 0 ? parts[0] : "";
        for (int i = 1; i < parts.Count; i = i + 1) {
            string p = parts[i];
            if (p.Length == 0) { continue; }
            int c0 = p[0];
            // 首字母大写用 char+string 拼接——char 上直接调 ToString()
            // 会得到码点数字（'M'.ToString() == "77"）。
            string head = p;
            if (c0 >= 97 && c0 <= 122) { head = (char)(c0 - 32) + p.Substring(1); }
            outp = outp + head;
        }
        return outp;
    }

    static bool IsNumeric(string s) {
        if (s == "") { return false; }
        int i = s[0] == 45 ? 1 : 0;
        int digits = 0;
        int dots = 0;
        while (i < s.Length) {
            int c = s[i];
            if (c >= 48 && c <= 57) { digits = digits + 1; }
            else if (c == 46) { dots = dots + 1; }
            else { return false; }
            i = i + 1;
        }
        return digits > 0 && dots <= 1;
    }

    // 属性值实体转义。' 也转（&#39;）：属性虽统一双引号包裹，
    // 单引号转义是纵深防御——防止未来某个调用点改用单引号包裹。
    static string EscapeAttr(string s) {
        string outp = "";
        for (int i = 0; i < s.Length; i = i + 1) {
            string ch = s.Substring(i, 1);
            if (ch == "&") { outp = outp + "&amp;"; }
            else if (ch == "<") { outp = outp + "&lt;"; }
            else if (ch == ">") { outp = outp + "&gt;"; }
            else if (ch == "\"") { outp = outp + "&quot;"; }
            else if (ch == "'") { outp = outp + "&#39;"; }
            else if (ch == "\n") { outp = outp + "&#10;"; }
            else if (ch == "\r") { outp = outp + "&#13;"; }
            else if (ch == "\t") { outp = outp + "&#9;"; }
            else { outp = outp + ch; }
        }
        return outp;
    }

    // 元素正文通道安全判定：不含换行/回车/制表且首尾无空白。HTML
    // 解析器会 Trim 元素文本首尾、把正文里的空白规范化——不安全的
    // 文本必须走 data-text 属性通道（EscapeAttr 实体转义）才能
    // 逐字节往返，否则多行文案一次读存就塌成单行。
    static bool TextIsHtmlSafe(string s) {
        if (s.Length == 0) { return false; }
        for (int i = 0; i < s.Length; i = i + 1) {
            int c = s[i];
            if (c == 10 || c == 13 || c == 9) { return false; }
        }
        int c0 = s[0];
        int cl = s[s.Length - 1];
        if (c0 == 32 || cl == 32) { return false; }
        return true;
    }

    // tag 值合法性：设计稿 JSON 可以来自不可信的 .html，
    // tag 会原样拼进 "<" + tag，必须钳在 HTML 标签名字符集内
    // （首字母字母 + HtmlText.IsNameChar 同款字符集），否则回落
    // "div"——防止注入字符进入标签名。
    static bool IsTagName(string s) {
        if (s.Length == 0) { return false; }
        if (!HtmlText.IsAlpha(s[0])) { return false; }
        for (int i = 1; i < s.Length; i = i + 1) {
            if (!HtmlText.IsNameChar(s[i])) { return false; }
        }
        return true;
    }

    // kind → 存储 tag。有 HTML 原生等价物的走原生标签；Panel 走裸
    // div（布局兜底形态，kind 由 TagKind("div") 恢复）；其余组件走
    // `zan-<kebab>` 自定义元素（HTML5 合法标签名，tokenizer 的
    // IsNameChar 收连字符）——组件化写法，不再骑在 div 上打标记。
    static string KindTag(string kind) {
        if (kind == "Label") { return "label"; }
        if (kind == "Button") { return "button"; }
        if (kind == "Input") { return "input"; }
        if (kind == "TextArea") { return "textarea"; }
        if (kind == "Image") { return "img"; }
        if (kind == "Divider") { return "hr"; }
        if (kind == "Progress") { return "progress"; }
        if (kind == "SelectBox") { return "select"; }
        if (kind == "Typography") { return "p"; }
        // input 的 type 变体：HTML 原生表单控件一族。
        if (kind == "Checkbox") { return "input"; }
        if (kind == "Radio") { return "input"; }
        if (kind == "Slider") { return "input"; }
        if (kind == "ColorPicker") { return "input"; }
        if (kind == "InputNumber") { return "input"; }
        if (kind == "DatePicker") { return "input"; }
        if (kind == "Upload") { return "input"; }
        if (kind == "Panel") { return "div"; }
        return "zan-" + KebabKey(kind);
    }

    // tag → kind（读端兜底；data-kind 缺失时）。zan-<kebab> 自定义
    // 元素反解回 Pascal kind，与 KindTag 的默认分支互逆。
    static string TagKind(string tag) {
        if (HtmlText.StartsWith(tag, "zan-")) {
            // 标签名经 tokenizer 全小写，逐段首字母大写复原 Pascal
            // kind（Unkebab 不动首段，这里不能用）："zan-qr-code" →
            // "QrCode"，与 KebabKey 互逆。
            string pascal = "";
            List<string> ks = tag.Substring(4).Split("-");
            for (int ki = 0; ki < ks.Count; ki = ki + 1) {
                string kp = ks[ki];
                if (kp.Length == 0) { continue; }
                int c0 = kp[0];
                if (c0 >= 97 && c0 <= 122) {
                    pascal = pascal + (char)(c0 - 32) + kp.Substring(1);
                } else {
                    pascal = pascal + kp;
                }
            }
            return pascal;
        }
        if (tag == "label") { return "Label"; }
        if (tag == "button") { return "Button"; }
        if (tag == "input") { return "Input"; }
        if (tag == "textarea") { return "TextArea"; }
        if (tag == "img") { return "Image"; }
        if (tag == "hr") { return "Divider"; }
        if (tag == "progress") { return "Progress"; }
        if (tag == "select") { return "SelectBox"; }
        if (tag == "p") { return "Typography"; }
        return "Panel";
    }

    // input 的 type 属性 → 组件 kind（<input type=checkbox> 是 Checkbox
    // 而不是 Input）。只在 data-kind 缺失、kind 从标签兜底而来时细化：
    // data-kind 是权威标记，写了就不改写。
    static string InputTypeKind(string ty) {
        if (ty == "checkbox") { return "Checkbox"; }
        if (ty == "radio") { return "Radio"; }
        if (ty == "range") { return "Slider"; }
        if (ty == "color") { return "ColorPicker"; }
        if (ty == "number") { return "InputNumber"; }
        if (ty == "date" || ty == "month" || ty == "week"
            || ty == "time") { return "DatePicker"; }
        if (ty == "file") { return "Upload"; }
        return "Input";
    }

    // input 变体组件导出时发哪个 type 属性。
    static string KindInputType(string kind) {
        if (kind == "Checkbox") { return "checkbox"; }
        if (kind == "Radio") { return "radio"; }
        if (kind == "Slider") { return "range"; }
        if (kind == "ColorPicker") { return "color"; }
        if (kind == "InputNumber") { return "number"; }
        if (kind == "DatePicker") { return "date"; }
        if (kind == "Upload") { return "file"; }
        return "";
    }
}
