using System;
using System.Json;

namespace System.Web;

/// One [Menu] route entry. Keys (title/path/method/group/rank/auth/login)
/// match the JSON documented on MenuBuilder.Json.
class MenuRouteDoc {
    string title;
    string path;
    string method;
    string group;
    int rank;
    bool auth;
    bool login;
}

/// <summary>
/// Builds the admin navigation menu from the route table: every route marked
/// [Menu] contributes an entry, grouped by its menu group (the first path
/// segment). This is the typed replacement for the PHP "是否管理菜单" flag --
/// the menu is derived from the same attributes that secure the routes, so it
/// can never drift out of sync with what actually exists.
/// </summary>
class MenuBuilder {
    /// <summary>JSON array of menu entries:
    /// [{"title","path","method","group","rank","auth","login"}].</summary>
    static string Json(WebApp app) {
        List<Route> routes = app.router.All();
        List<MenuRouteDoc> outp = new List<MenuRouteDoc>();
        int i = 0;
        while (i < routes.Count) {
            Route r = routes[i];
            i = i + 1;
            if (!r.inMenu) { continue; }
            MenuRouteDoc o = new MenuRouteDoc();
            o.title = r.title;
            o.path = r.pattern;
            o.method = r.method;
            o.group = r.menuGroup;
            o.rank = r.rank;
            o.auth = r.needsAuth;
            o.login = r.needsLogin;
            outp.Add(o);
        }
        return Json.Serialize<List<MenuRouteDoc>>(outp);
    }
}
