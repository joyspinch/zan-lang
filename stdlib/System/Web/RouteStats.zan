using System;
using System.IO;
using System.Threading;
using System.Json;

namespace System.Web;

/// One registered route's counters in the JSON dump. Keys (route/calls/
/// total_us/avg_us/min_us/max_us/errors/slow) match RouteStats.ToJson.
class RouteStatDoc {
    string route;
    long calls;
    long total_us;
    long avg_us;
    long min_us;
    long max_us;
    long errors;
    long slow;
}

/// <summary>
/// Per-route service statistics in cross-process shared memory: call count,
/// total/min/max latency, errors and slow calls, aggregated across every worker
/// process without a coordinator.
///
/// Counters are updated with the same hash the route lookup already computed, so
/// recording a request costs a handful of row-locked adds. A supervisor dumps
/// the table on an interval and zeroes it, which turns the counters into an
/// hourly or daily profile of the service -- enough to see which endpoints are
/// slow or unstable without any per-request logging.
///
/// <code>
/// RouteStats stats = RouteStats.Create("app.stats", 4096);
/// long h = stats.Register("GET", "/user/list");    // once, at startup
/// ...
/// long t0 = Stopwatch.GetMicroseconds();
/// HttpResponse res = await Handle(req);
/// stats.Record(h, Stopwatch.GetMicroseconds() - t0, res.statusCode &lt; 500, 200000);
/// ...
/// stats.DumpJson("logs/api-2026-07-25-14.json");   // hourly, then zeroed
/// </code>
/// </summary>
class RouteStats {
    SharedTable table;
    List<string> keys;
    List<long> hashes;

    RouteStats() {
        this.table = null;
        this.keys = new List<string>();
        this.hashes = new List<long>();
    }

    /// <summary>Creates the table. `capacity` is the number of routes.</summary>
    RouteStats(string name, int capacity) {
        this.keys = new List<string>();
        this.hashes = new List<long>();
        SharedTable t = new SharedTable(name, capacity);
        t.KeySize(16);
        t.ColumnInt("calls");
        t.ColumnInt("total_us");
        t.ColumnInt("min_us");
        t.ColumnInt("max_us");
        t.ColumnInt("errors");
        t.ColumnInt("slow");
        if (t.Create()) { this.table = t; }
    }

    /// <summary>Opens the table created by another process. The caller still
    /// registers the routes it wants to dump.</summary>
    static RouteStats Open(string name) {
        RouteStats s = new RouteStats();
        SharedTable t = SharedTable.Open(name);
        if (!t.IsOpen()) { return null; }
        s.table = t;
        return s;
    }

    /// <summary>Declares a route and returns its hash; keep that value and pass
    /// it to Record. Registration is what lets Dump name the rows.</summary>
    long Register(string method, string path) {
        string key = RouteTable.KeyOf(method, path);
        long h = SharedTable.Hash(key);
        this.keys.Add(key);
        this.hashes.Add(h);
        return h;
    }

    /// <summary>Records one served request: `elapsedUs` microseconds, `ok` false
    /// counts an error, and anything at or above `slowUs` counts as slow.</summary>
    void Record(long keyHash, long elapsedUs, bool ok, long slowUs) {
        this.table.IncrementAt(keyHash, "calls", 1);
        this.table.IncrementAt(keyHash, "total_us", elapsedUs);
        this.table.MinAt(keyHash, "min_us", elapsedUs);
        this.table.MaxAt(keyHash, "max_us", elapsedUs);
        if (!ok) { this.table.IncrementAt(keyHash, "errors", 1); }
        if (elapsedUs >= slowUs) { this.table.IncrementAt(keyHash, "slow", 1); }
    }

    long Calls(long keyHash) { return this.table.GetIntAt(keyHash, "calls"); }
    long TotalUs(long keyHash) { return this.table.GetIntAt(keyHash, "total_us"); }
    long MinUs(long keyHash) { return this.table.GetIntAt(keyHash, "min_us"); }
    long MaxUs(long keyHash) { return this.table.GetIntAt(keyHash, "max_us"); }
    long Errors(long keyHash) { return this.table.GetIntAt(keyHash, "errors"); }
    long Slow(long keyHash) { return this.table.GetIntAt(keyHash, "slow"); }

    /// <summary>Average microseconds per call, 0 when never called.</summary>
    long AvgUs(long keyHash) {
        long calls = this.table.GetIntAt(keyHash, "calls");
        if (calls == 0) { return 0; }
        return this.table.GetIntAt(keyHash, "total_us") / calls;
    }

    /// <summary>Zeroes one route's counters.</summary>
    void ResetAt(long keyHash) {
        this.table.SetIntAt(keyHash, "calls", 0);
        this.table.SetIntAt(keyHash, "total_us", 0);
        this.table.SetIntAt(keyHash, "min_us", 0);
        this.table.SetIntAt(keyHash, "max_us", 0);
        this.table.SetIntAt(keyHash, "errors", 0);
        this.table.SetIntAt(keyHash, "slow", 0);
    }

    /// <summary>Zeroes every registered route.</summary>
    void Reset() {
        for (int i = 0; i < this.hashes.Count; i = i + 1) {
            this.ResetAt(this.hashes[i]);
        }
    }

    /// <summary>Renders the registered routes as a JSON array. Routes that were
    /// never called are skipped.</summary>
    string ToJson() {
        List<RouteStatDoc> outp = new List<RouteStatDoc>();
        for (int i = 0; i < this.hashes.Count; i = i + 1) {
            long h = this.hashes[i];
            long calls = this.table.GetIntAt(h, "calls");
            if (calls > 0) {
                RouteStatDoc o = new RouteStatDoc();
                o.route = this.keys[i];
                o.calls = calls;
                o.total_us = this.table.GetIntAt(h, "total_us");
                o.avg_us = this.AvgUs(h);
                o.min_us = this.table.GetIntAt(h, "min_us");
                o.max_us = this.table.GetIntAt(h, "max_us");
                o.errors = this.table.GetIntAt(h, "errors");
                o.slow = this.table.GetIntAt(h, "slow");
                outp.Add(o);
            }
        }
        return Json.Serialize<List<RouteStatDoc>>(outp);
    }

    /// <summary>Writes the current counters to `path` and zeroes them, so each
    /// dump covers exactly the interval since the previous one.</summary>
    void DumpJson(string path) {
        string json = this.ToJson();
        File.WriteAllText(path, json);
        this.Reset();
    }

    int Count() {
        return this.table.Count();
    }

    bool Destroy() {
        return this.table.Destroy();
    }
}
