using System.Json;
using System.Net.Http;
using System.Net.Sockets;
using System.Text;
using System.Diagnostics;
using System;

namespace System.Web;

/// The uniform API envelope body. `data` is a JsonValue passthrough: the
/// caller supplies a JSON literal (object/array/string) that is parsed back
/// into the tree before serialization.
class ApiEnvelope {
    string code;
    string msg;
    JsonValue data;
}

/// <summary>
/// Per-request context: parsed request data (query / form / route params /
/// cookies) plus the response the handler builds (status / headers / body).
/// One HttpContext is created per request and dropped when it is answered,
/// so ARC reclaims everything without a request-scoped pool.
/// </summary>
class HttpContext {
    HttpRequest request;
    string method;
    string path;
    string remoteIp;
    StrMap routeParams;
    StrMap query;
    StrMap form;
    // What dispatch worked out about this request, as fields rather than a
    // scratch map: a typo in a map key is a silent empty string, a typo in a
    // field name does not compile.
    string uid;          // signed-in principal ("" when anonymous)
    string routeAction;  // the matched route's action ("Users.Save")
    string routePattern; // what served this request, as the server names it:
                         // the route's registration pattern ("/user/{id}") or
                         // a mounted asset's own path ("/static/js/app.js").
                         // "" means nothing claimed it (404/405/a scan), which
                         // is what keeps invented URLs out of the metrics.
    int routeSlot;       // the matched route's index, for O(1) per-route
                         // accounting; -1 for anything not a route (an asset)
    string uploadPath;   // spooled multipart body ("" when none)
    long uploadSize;
    // JSON 正文的惰性缓存：JsonBody() 第一次调用时解析一次，之后
    // 直接返回缓存（同一个请求体往往被多个读取方消费）。
    JsonValue jsonBody;
    bool jsonParsed;

    int status;
    string statusText;
    string contentType;
    string body;
    // A body that is bytes rather than text. Zan string length is
    // strlen-based, so an image, a font or any other payload containing a NUL
    // byte cannot travel as `body`: it is carried here with an explicit length
    // and written to the socket by byte count.
    byte[] bodyBytes;
    int bodyBytesLen;
    List<string> headers;
    bool ended;        // a hook or handler already produced the response

    // ---- streaming (Server-Sent Events) ----
    // The connection itself, handed over by the server before the handler runs.
    // A handler that calls SseOpen() takes it over: it writes the response
    // itself, for as long as the subscriber stays, and the server stops
    // treating the socket as a request/response exchange.
    TcpClient conn;
    bool hijacked;
    // Sticky: set once the connection is taken over (SSE/upgrade) and never
    // cleared, unlike `hijacked` which the stream loop resets on disconnect.
    // The metrics guards read THIS so a closed stream stays excluded from
    // request / route latency even after `hijacked` has gone back to false.
    bool wasHijacked;
    // What a stream is measured by instead of a duration: how much was pushed
    // over it. Frames and bytes, counted as they go out.
    long frames;
    long framesBytes;

    HttpContext(HttpRequest req, string remoteIp) {
        this.request = req;
        this.method = req.method;
        this.path = req.path;
        this.remoteIp = remoteIp;
        this.routeParams = new StrMap();
        this.query = new StrMap();
        this.form = new StrMap();
        this.uid = "";
        this.routeAction = "";
        this.routePattern = "";
        this.routeSlot = 0 - 1;
        this.uploadPath = "";
        this.uploadSize = 0;
        this.jsonBody = null;
        this.jsonParsed = false;
        this.status = 200;
        this.statusText = "OK";
        this.contentType = "text/html; charset=utf-8";
        this.body = "";
        this.bodyBytes = null;
        this.bodyBytesLen = 0;
        this.headers = null;
        this.ended = false;
        this.conn = null;
        this.hijacked = false;
        this.wasHijacked = false;
        this.frames = 0;
        this.framesBytes = 0;
        this.deadlineSlot = null;
        HttpContext.ParsePairs(req.queryString, this.query);
        // 表单在这里解析一次，服务的是直接构造 HttpContext 的调用方
        // （此时 request.body 已是完整正文）。WebApp 的连接循环里正文
        // 是在构造之后才由 HttpFramer 缓冲齐的，那里经 ParseFormBody
        // 再解析一次——空正文时 ParsePairs 立即返回，同一条请求的
        // 表单仍然只被真正解析一次。
        if (req.method == "POST" || req.method == "PUT" || req.method == "PATCH") {
            if (HttpContext.StartsWith(req.contentType, "application/x-www-form-urlencoded")) {
                HttpContext.ParsePairs(req.body, this.form);
            } else if (HttpContext.StartsWith(req.contentType, "multipart/form-data")) {
                HttpContext.ParseMultipartFields(req, this);
            }
        }
    }

    string RemoteIp() { return this.remoteIp; }
    long RemoteIpLong() { return Socket.Ipv4ToLong(this.remoteIp); }

    /// buffering (the initial parse only saw the first packet).</summary>
    static void ParseFormBody(HttpRequest req, HttpContext ctx) {
        if (HttpContext.StartsWith(req.contentType, "application/x-www-form-urlencoded")) {
            ctx.form.Clear();
            HttpContext.ParsePairs(req.body, ctx.form);
        }
    }

    /// <summary>multipart/form-data 的文本字段进 form 表。浏览器在同一张
    /// 表单里混排文本输入与文件输入，此前只有 urlencoded 的字段被解析，
    /// multipart 请求里的文本字段在服务端不可见。文件部件不在这里展开：
    /// 流式上传路径的正文已整体落盘（WebApp.StreamBodyToFile），内存路径
    /// 的文件部件由处理器按需取用——只有带 filename= 的部件被跳过，
    /// 其余部件的值原样进入 form（multipart 值不做百分号解码）。</summary>
    static void ParseMultipartFields(HttpRequest req, HttpContext ctx) {
        string ctype = req.contentType;
        int bIdx = HttpContext.FindNoCaseFrom(ctype, "boundary=", 0);
        if (bIdx < 0) { return; }
        int bs = bIdx + 9;
        int be = bs;
        while (be < ctype.Length && (ctype[be] & 255) != 59) { be = be + 1; }
        string raw = ctype.Substring(bs, be - bs);
        // boundary 参数可带引号。
        if (raw.Length >= 2 && (raw[0] & 255) == 34
            && (raw[raw.Length - 1] & 255) == 34) {
            raw = raw.Substring(1, raw.Length - 2);
        }
        if (raw.Length == 0) { return; }
        string delim = "--" + raw;
        string body = req.body;
        int n = body.Length;
        int dlen = delim.Length;
        int pos = HttpContext.FindFrom(body, delim, 0);
        while (pos >= 0) {
            int after = pos + dlen;
            if (after + 1 < n && (body[after] & 255) == 45
                && (body[after + 1] & 255) == 45) {
                break;   // "--boundary--"：结束分隔
            }
            if (after + 1 < n && (body[after] & 255) == 13
                && (body[after + 1] & 255) == 10) {
                after = after + 2;
            } else if (after < n && (body[after] & 255) == 10) {
                after = after + 1;
            }
            int hb = HttpContext.FindFrom(body, "\r\n\r\n", after);
            if (hb < 0 || hb + 4 > n) { break; }
            string head = body.Substring(after, hb + 4 - after);
            int vStart = hb + 4;
            string name = HttpContext.DispositionName(head);
            int next = HttpContext.FindFrom(body, delim, vStart);
            if (name.Length > 0 && next > vStart) {
                int vEnd = next;
                // 值尾的 CRLF 属于分隔符前缀，不属于值。
                if (vEnd > vStart && (body[vEnd - 1] & 255) == 10) { vEnd = vEnd - 1; }
                if (vEnd > vStart && (body[vEnd - 1] & 255) == 13) { vEnd = vEnd - 1; }
                ctx.form.Set(name, body.Substring(vStart, vEnd - vStart));
            }
            if (next < 0) { break; }
            pos = next;
        }
    }

    /// <summary>部件 Content-Disposition 里的 name 值；带 filename= 的
    /// 部件是文件，返回空串让调用方跳过（文件字节不能混进 form 表）。</summary>
    static string DispositionName(string head) {
        if (HttpContext.FindNoCaseFrom(head, "filename=", 0) >= 0) { return ""; }
        int k = HttpContext.FindNoCaseFrom(head, "name=", 0);
        if (k < 0) { return ""; }
        int qs = k + 5;
        if (qs < head.Length && (head[qs] & 255) == 34) {
            int qe = HttpContext.FindFrom(head, "\"", qs + 1);
            if (qe < 0) { return ""; }
            return head.Substring(qs + 1, qe - qs - 1);
        }
        int e = qs;
        while (e < head.Length) {
            int c = head[e] & 255;
            if (c == 59 || c == 13 || c == 10) { break; }  // ';' CR LF
            e = e + 1;
        }
        return head.Substring(qs, e - qs);
    }

    static int FindFrom(string hay, string needle, int from) {
        int n = hay.Length;
        int m = needle.Length;
        for (int i = from; i + m <= n; i = i + 1) {
            int k = 0;
            while (k < m && (hay[i + k] & 255) == (needle[k] & 255)) {
                k = k + 1;
            }
            if (k == m) { return i; }
        }
        return -1;
    }

    static int FindNoCaseFrom(string hay, string needle, int from) {
        int n = hay.Length;
        int m = needle.Length;
        for (int i = from; i + m <= n; i = i + 1) {
            int k = 0;
            while (k < m) {
                int a = hay[i + k] & 255;
                int b = needle[k] & 255;
                if (a >= 65 && a <= 90) { a = a + 32; }
                if (b >= 65 && b <= 90) { b = b + 32; }
                if (a != b) { break; }
                k = k + 1;
            }
            if (k == m) { return i; }
        }
        return -1;
    }

    // ---- request accessors ----

    string Param(string name) { return this.routeParams.Get(name); }
    string Query(string name) { return this.query.Get(name); }
    string Form(string name) { return this.form.Get(name); }
    string Body() { return this.request.body; }

    /// <summary>Request body as JSON, parsed once and cached. Returns null
    /// for an empty body. Lenient parse: a malformed body yields whatever
    /// partial tree the reader recovered rather than an exception — callers
    /// validating user input should still check the fields they read.</summary>
    JsonValue JsonBody() {
        if (!this.jsonParsed) {
            this.jsonParsed = true;
            this.jsonBody = null;
            string b = this.request.body;
            if (b.Length > 0) {
                this.jsonBody = JsonValue.ParseLenient(b);
            }
        }
        return this.jsonBody;
    }

    // ================= 类型化取参族 =================
    //
    // Input* 是 In* 家族的类型化别名（历史上是两套并行实现，合并顺序
    // 一度相反——route→query→form 对 form→query→route——同一个名字
    // 在两族里会解析到不同来源）。现在统一走 InRaw/InInt/InLong/InBool：
    // 一份合并顺序、一份解析规则，生成的蹦床与手写控制器读到的值一致。

    /// <summary>按 route → query → form 顺序取原始字符串（未过滤）；
    /// 三处都缺时返回空串。</summary>
    string InputString(string name) {
        return this.InRaw(name);
    }

    /// <summary>按合并顺序取整型；缺失、非整数或溢出时返回
    /// `dflt`。"42"、"-7"、"+7" 合法；"12abc"、"2.5"、"" 不合法。</summary>
    int InputInt(string name, int dflt) {
        return this.InInt(name, dflt);
    }

    /// <summary>按合并顺序取 64 位整型；规则同 InputInt。</summary>
    long InputLong(string name, long dflt) {
        return this.InLong(name, dflt);
    }

    /// <summary>按合并顺序取布尔："1"/"true"/"on"/"yes"
    /// （大小写不敏感）为真，"0"/"false"/"off"/"no" 为假，
    /// 其余返回 `dflt`。</summary>
    bool InputBool(string name, bool dflt) {
        return this.InBool(name, dflt);
    }

    /// <summary>严格十进制解析：可选 +/- 前缀、其余必须全为数字、
    /// 整串消费、int 范围校验；任何一条不满足返回 `dflt`。</summary>
    static int ParseIntStrict(string v, int dflt) {
        if (v == null || v.Length == 0) { return dflt; }
        long r = HttpContext.ParseLongStrict(v, dflt);
        if (r > 2147483647 || r < 0 - 2147483648) { return dflt; }
        return (int)r;
    }

    /// <summary>ASCII 大小写不敏感等值（布尔词表用）。</summary>
    static bool AsciiEq(string a, string b) {
        if (a.Length != b.Length) { return false; }
        for (int i = 0; i < a.Length; i = i + 1) {
            int x = a[i] & 255;
            int y = b[i] & 255;
            if (x >= 65 && x <= 90) { x = x + 32; }
            if (y >= 65 && y <= 90) { y = y + 32; }
            if (x != y) { return false; }
        }
        return true;
    }

    static long ParseLongStrict(string v, long dflt) {
        if (v == null || v.Length == 0) { return dflt; }
        int i = 0;
        bool neg = false;
        int c0 = v[0] & 255;
        if (c0 == 45) { neg = true; i = 1; }
        else if (c0 == 43) { i = 1; }
        if (i >= v.Length) { return dflt; }
        long acc = 0;
        while (i < v.Length) {
            int c = v[i] & 255;
            if (c < 48 || c > 57) { return dflt; }
            acc = acc * 10 + (c - 48);
            // 只有全是数字时 acc 才可能为负：变负即说明 64 位已回绕，
            // 当作解析失败而不是把回绕值当结果返回。
            if (acc < 0) { return dflt; }
            i = i + 1;
        }
        return neg ? 0 - acc : acc;
    }
    string Header(string name) { return this.request.GetHeader(name); }

    /// <summary>Reads one cookie from the Cookie header, or "".</summary>
    string Cookie(string name) {
        string all = this.request.GetHeader("Cookie");
        int allLen = all.Length;
        if (allLen == 0) { return ""; }
        // 就地比较，不切片：每个 cookie 段先 Substring 出来、再拼一个
        // "name=" 前缀去比，一次查找就要分配三四个临时串（外加每个
        // .Length 一次 strlen）。命中时才分配返回值。
        int nameLen = name.Length;
        int i = 0;
        while (i < allLen) {
            // skip leading spaces / separators
            while (i < allLen) {
                int c = all[i] & 255;
                if (c != 32 && c != 59) { break; }  // ' ' or ';'
                i = i + 1;
            }
            int e = i;
            while (e < allLen && (all[e] & 255) != 59) { e = e + 1; }  // ';'
            // 名字后必须紧跟 '='，且值至少一个字符——空值视为未命中，
            // 与旧的 part.Length > prefix.Length 判定一致。
            if (e - i > nameLen + 1 && (all[i + nameLen] & 255) == 61) {
                bool same = true;
                for (int k = 0; k < nameLen; k = k + 1) {
                    if ((all[i + k] & 255) != (name[k] & 255)) { same = false; break; }
                }
                if (same) {
                    int vStart = i + nameLen + 1;
                    return all.Substring(vStart, e - vStart);
                }
            }
            i = e + 1;
        }
        return "";
    }

    bool IsAjax() {
        string x = this.request.GetHeader("X-Requested-With");
        return x == "XMLHttpRequest" || x == "xmlhttprequest";
    }

    // ---- unified, filtered input --------------------------------------------
    // Prefer these over Form/Query/Param: every frontend parameter is resolved
    // from the same place (route param -> query -> form, most specific first)
    // and passed through the central Filter, so sanitising is uniform across
    // all controllers. An empty value counts as missing (an emptied form field
    // falls through to the next source instead of shadowing it), matching the
    // contract http_params pins for the whole family. The generator's route
    // trampolines emit these same accessors, so attribute-routed actions and
    // hand-written controllers read parameters identically.

    /// <summary>Raw, UNFILTERED value (route param -> query -> form). Only use
    /// when you deliberately need the untouched bytes.</summary>
    string InRaw(string name) {
        string v = this.routeParams.Get(name);
        if (v.Length > 0) { return v; }
        v = this.query.Get(name);
        if (v.Length > 0) { return v; }
        return this.form.Get(name);
    }

    /// <summary>Filtered value: trimmed, control chars stripped. The default
    /// safe way to read a parameter.</summary>
    string In(string name) { return Filter.Clean(this.InRaw(name)); }

    /// <summary>Filtered + HTML-escaped value, safe to render into a page.</summary>
    string InText(string name) { return Filter.Html(this.InRaw(name)); }

    /// <summary>Filtered integer with a fallback for missing/invalid input.
    /// Full-consumption strict parse with range check: "12abc", "2.5" and
    /// out-of-range values all fall to `def` (an atoi-style prefix parse
    /// would accept "12abc" as 12, and an unchecked accumulator would wrap).</summary>
    int InInt(string name, int def) {
        return HttpContext.ParseIntStrict(Filter.Clean(this.InRaw(name)), def);
    }

    /// <summary>Filtered long with a fallback for missing/invalid input.
    /// Same strict rules as InInt, widened to 64 bits.</summary>
    long InLong(string name, long def) {
        return HttpContext.ParseLongStrict(Filter.Clean(this.InRaw(name)), def);
    }

    /// <summary>Filtered number with a fallback for missing/invalid input.</summary>
    double InDouble(string name, double def) {
        return Filter.ToDouble(this.InRaw(name), def);
    }

    /// <summary>Flag parameter: "1"/"true"/"on"/"yes" against
    /// "0"/"false"/"off"/"no", so a checkbox and an API client read alike.</summary>
    bool InBool(string name, bool def) { return Filter.ToBool(this.InRaw(name), def); }

    /// <summary>True when the parameter is present in form, query or route.</summary>
    bool HasIn(string name) {
        return this.form.Has(name) || this.query.Has(name)
            || this.routeParams.Has(name);
    }

    // ---- response builders ----

    HttpContext Status(int code, string text) {
        this.status = code;
        this.statusText = text;
        return this;
    }

    /// <summary>A header name or value with CR, LF and NUL removed. Applied at
    /// the sink rather than left to the caller: a value that reaches a header
    /// is often a redirect target, a filename or a token read straight from the
    /// request, and one CRLF in it ends the header block and lets the client
    /// write the rest of the response (header injection / response
    /// splitting).</summary>
    static string HeaderSafe(string s) {
        int n = s.Length;
        int i = 0;
        while (i < n) {
            int c = s[i] & 255;
            if (c == 13 || c == 10 || c == 0) { break; }
            i = i + 1;
        }
        if (i == n) { return s; }
        StringBuilder sb = new StringBuilder();
        int flush = 0;
        int k = 0;
        while (k < n) {
            int c = s[k] & 255;
            if (c == 13 || c == 10 || c == 0) {
                if (k > flush) { sb.Append(s.Substring(flush, k - flush)); }
                flush = k + 1;
            }
            k = k + 1;
        }
        if (n > flush) { sb.Append(s.Substring(flush, n - flush)); }
        return sb.ToString();
    }

    HttpContext SetHeader(string name, string val) {
        if (this.headers == null) { this.headers = new List<string>(); }
        this.headers.Add(HttpContext.HeaderSafe(name) + ": "
            + HttpContext.HeaderSafe(val));
        return this;
    }

    HttpContext SetCookie(string name, string val, int maxAgeSeconds) {
        if (this.headers == null) { this.headers = new List<string>(); }
        this.headers.Add("Set-Cookie: " + HttpContext.HeaderSafe(name) + "="
            + HttpContext.HeaderSafe(val)
            + "; Max-Age=" + Convert.ToString(maxAgeSeconds)
            + "; Path=/; HttpOnly; SameSite=Lax");
        return this;
    }

    /// <summary>Sets a JS-readable cookie (no HttpOnly). The only
    /// legitimate use is the CSRF double-submit token: the browser script
    /// must read the cookie to echo it in X-CSRF-Token, so it cannot be
    /// HttpOnly. SameSite=Lax stays, which is itself the first line of
    /// defense. Everything else should use <see cref="SetCookie"/>.</summary>
    HttpContext SetCookieJs(string name, string val, int maxAgeSeconds) {
        if (this.headers == null) { this.headers = new List<string>(); }
        this.headers.Add("Set-Cookie: " + HttpContext.HeaderSafe(name) + "="
            + HttpContext.HeaderSafe(val)
            + "; Max-Age=" + Convert.ToString(maxAgeSeconds)
            + "; Path=/; SameSite=Lax");
        return this;
    }

    void Html(string html) {
        this.contentType = "text/html; charset=utf-8";
        this.body = html;
        this.ended = true;
    }

    void Text(string text) {
        this.contentType = "text/plain; charset=utf-8";
        this.body = text;
        this.ended = true;
    }

    /// <summary>Answers with `len` raw bytes of `data`. The only way to serve
    /// binary content correctly: a byte array plus its length, never a string
    /// whose length stops at the first NUL.</summary>
    void Binary(string mime, byte[] data, int len) {
        this.contentType = mime;
        this.bodyBytes = data;
        this.bodyBytesLen = len;
        this.body = "";
        this.ended = true;
    }

    /// <summary>True when the response body is bytes: the server sends the
    /// header block and then <c>bodyBytes</c> by count.</summary>
    bool IsBinary() { return this.bodyBytes != null; }

    /// <summary>Response body size in bytes, whichever form it takes.</summary>
    int BodyLength() {
        if (this.bodyBytes != null) { return this.bodyBytesLen; }
        return this.body.Length;
    }

    void Json(string json) {
        this.contentType = "application/json";
        this.body = json;
        this.ended = true;
    }

    /// <summary>Answers with a file the browser saves rather than renders. The
    /// name is sanitised here (quotes, newlines and path separators dropped) so
    /// a caller cannot inject a header line through it.</summary>
    void Download(string fileName, string mime, string body) {
        StringBuilder safe = new StringBuilder();
        for (int i = 0; i < fileName.Length; i = i + 1) {
            int c = fileName[i] & 255;
            if (c < 32 || c == 34 || c == 47 || c == 92 || c == 59) { continue; }
            safe.Append(fileName.Substring(i, 1));
        }
        string name = safe.ToString();
        if (name.Length == 0) { name = "export.txt"; }
        this.SetHeader("Content-Disposition",
            "attachment; filename=\"" + name + "\"");
        this.contentType = mime;
        this.body = body;
        this.ended = true;
    }

    /// <summary>Uniform API envelope: {"code":...,"msg":...,"data":...}.
    /// data must already be a JSON value (object/array/string literal); it is
    /// parsed back into the tree so the envelope is built by the JSON writer,
    /// never by string concatenation.</summary>
    void Api(string code, string msg, string data) {
        ApiEnvelope o = new ApiEnvelope();
        o.code = code;
        o.msg = msg;
        JsonValue dv = JsonValue.ParseLenient(data);
        if (dv == null) { dv = JsonValue.NewStr(data); }
        o.data = dv;
        this.Json(Json.Serialize<ApiEnvelope>(o));
    }

    void Redirect(string url) {
        this.status = 302;
        this.statusText = "Found";
        if (this.headers == null) { this.headers = new List<string>(); }
        this.headers.Add("Location: " + HttpContext.HeaderSafe(url));
        this.body = "";
        this.ended = true;
    }

    /// <summary>Serializes the response into a raw HTTP/1.1 message.</summary>
    // ---- server-sent events -------------------------------------------------
    // A metrics dashboard that polls asks the same question a few times a
    // minute and gets "nothing changed" almost every time; an event stream
    // costs one connection and speaks only when there is something to say.
    // These four calls are the whole server side of it -- no framework, no
    // second port, and the handler stays an ordinary route.

    /// <summary>Attaches the live connection. Called by the server; a handler
    /// never needs it.</summary>
    void __Attach(TcpClient client) { this.conn = client; }

    /// <summary>The live connection's socket, for handlers that must manage
    /// their own deadlines (an SSE stream that legitimately stays silent for
    /// minutes while the upstream model thinks). Returns 0 before __Attach.
    /// </summary>
    nint ClientSock() {
        if (this.conn == null) { return 0; }
        return this.conn.Sock();
    }

    /// <summary>The per-request deadline slot this connection rides on. A
    /// long-lived stream handler must Touch it periodically (see
    /// ClientStreamWatch): the connection sweeper shuts sockets down at the
    /// deadline even mid-stream, which used to cut every SSE response that
    /// ran past the server's request timeout (default 30s) — the exact
    /// "upstream never finished but the client got dropped" signature.
    /// null when the connection predates deadline tracking.</summary>
    HttpDeadlineToken deadlineSlot;

    HttpDeadlineToken DeadlineSlot() { return this.deadlineSlot; }

    void __SetDeadlineSlot(HttpDeadlineToken slot) { this.deadlineSlot = slot; }

    /// <summary>Re-arms this connection's request deadline for another full
    /// window. A streaming handler calls this every time it has evidence the
    /// stream is alive — data relayed, or a keep-alive ping accepted. Without
    /// it the connection sweeper shuts the socket down at requestTimeoutMs
    /// (default 30s) regardless of stream health, which is why long SSE
    /// relays used to die mid-answer with "client disconnected".
    /// No-op when the connection carries no deadline.</summary>
    void TouchDeadline(int timeoutMs) {
        if (this.deadlineSlot != null) {
            HttpDeadline.Touch(this.deadlineSlot, timeoutMs);
        }
    }

    /// <summary>Whether this request took the connection over.</summary>
    bool Hijacked() { return this.hijacked; }

    /// <summary>Whether this connection was EVER hijacked (SSE/upgrade). Stays
    /// true after the stream ends, so latency metrics stay excluded.</summary>
    bool MetricsExcluded() { return this.wasHijacked; }

    /// <summary>Frames pushed over this connection (SSE events, keep-alives),
    /// and their total size: the traffic measure that replaces latency for a
    /// connection that is meant to stay open.</summary>
    long Frames() { return this.frames; }
    long FrameBytes() { return this.framesBytes; }

    /// <summary>Answers the `text/event-stream` handshake and takes the
    /// connection over. Everything after this is written by the handler with
    /// SseSend / SsePing; the loop it runs ends when the subscriber goes away
    /// (a send fails). false = no connection to stream on.</summary>
    async bool SseOpen() {
        if (this.conn == null) { return false; }
        string head = "HTTP/1.1 200 OK\r\n"
            + "Content-Type: text/event-stream; charset=utf-8\r\n"
            + "Cache-Control: no-cache, no-transform\r\n"
            + "Connection: keep-alive\r\n"
            + "X-Accel-Buffering: no\r\n\r\n";
        int n = await this.conn.SendAsync(head);
        if (n <= 0) { return false; }
        this.hijacked = true;
        this.wasHijacked = true;
        this.ended = true;
        // The open-stream gauge: this connection now occupies a coroutine until
        // the subscriber leaves. The dispatcher closes it out with the frame
        // totals when the handler returns.
        ServerMetrics.Global().StreamOpened();
        return true;
    }

    /// <summary>循环直到整段写出。TcpClient.SendAsync 是单次非阻塞
    /// send：TCP 背压下（慢订阅者 + 快上游——繁忙转发的常态）它经常
    /// 短写，此前按 frame.Length 记账等于把没发出去的事件当已送达，
    /// 下一事件从半帧中间开始——浏览器收到的补全是坏 JSON。
    /// false = 对端已断开。</summary>
    async bool SendAllTcp(string data) {
        int total = data.Length;
        if (total == 0) { return true; }
        int sent = 0;
        while (sent < total) {
            string rest = data.Substring(sent, total - sent);
            int n = await this.conn.SendAsync(rest);
            if (n <= 0) { return false; }
            sent = sent + n;
        }
        return true;
    }

    /// <summary>Pushes one event. `name` "" sends the default "message" event.
    /// Each newline in `data` becomes its own data: line, as the wire format
    /// requires. false = the subscriber is gone; stop the loop.</summary>
    async bool SseSend(string name, string data) {
        if (!this.hijacked || this.conn == null) { return false; }
        StringBuilder sb = new StringBuilder();
        if (name.Length > 0) { sb.Append("event: "); sb.Append(name); sb.Append("\n"); }
        int start = 0;
        for (int i = 0; i <= data.Length; i = i + 1) {
            if (i == data.Length || (data[i] & 255) == 10) {
                sb.Append("data: ");
                sb.Append(data.Substring(start, i - start));
                sb.Append("\n");
                start = i + 1;
            }
        }
        sb.Append("\n");
        string frame = sb.ToString();
        bool ok = await this.SendAllTcp(frame);
        if (!ok) { this.hijacked = false; return false; }
        this.frames = this.frames + 1;
        this.framesBytes = this.framesBytes + frame.Length;
        return true;
    }

    /// <summary>Comment line, used as a keep-alive so idle proxies do not drop
    /// the stream.</summary>
    async bool SsePing() {
        if (!this.hijacked || this.conn == null) { return false; }
        bool ok = await this.SendAllTcp(": ping\n\n");
        if (!ok) { this.hijacked = false; return false; }
        this.frames = this.frames + 1;
        this.framesBytes = this.framesBytes + 8;
        return true;
    }

    string BuildResponse(bool keepAlive) {
        StringBuilder sb = new StringBuilder();
        sb.Append("HTTP/1.1 ");
        sb.Append(HttpContext.Itoa(this.status));
        sb.Append(" ");
        sb.Append(this.statusText);
        sb.Append("\r\nContent-Type: ");
        sb.Append(this.contentType);
        sb.Append("\r\nContent-Length: ");
        sb.Append(HttpContext.Itoa(this.BodyLength()));
        if (keepAlive) { sb.Append("\r\nConnection: keep-alive"); }
        else { sb.Append("\r\nConnection: close"); }
        sb.Append("\r\nServer: ZanWeb/0.1");
        int hn = 0;
        if (this.headers != null) { hn = this.headers.Count; }
        for (int i = 0; i < hn; i = i + 1) {
            sb.Append("\r\n");
            sb.Append(this.headers[i]);
        }
        sb.Append("\r\n\r\n");
        // A byte body is NOT appended: it would be cut at its first NUL. The
        // caller sends this header block and then the bytes by count.
        if (this.bodyBytes == null) { sb.Append(this.body); }
        return sb.ToString();
    }

    /// <summary>Decimal formatting for the response line without going
    /// through Convert.ToString (which formats via printf). Digits are
    /// string literals, so the whole conversion is allocation-free apart
    /// from the builder append.</summary>
    static string Itoa(int v) {
        if (v == 0) { return "0"; }
        int x = v;
        bool neg = false;
        if (x < 0) { neg = true; x = 0 - x; }
        int div = 1;
        int t = x;
        while (t >= 10) { div = div * 10; t = t / 10; }
        StringBuilder sb = new StringBuilder();
        if (neg) { sb.Append("-"); }
        while (div > 0) {
            sb.Append(HttpContext.Digit((x / div) % 10));
            div = div / 10;
        }
        return sb.ToString();
    }

    static string Digit(int d) {
        if (d == 0) { return "0"; }
        if (d == 1) { return "1"; }
        if (d == 2) { return "2"; }
        if (d == 3) { return "3"; }
        if (d == 4) { return "4"; }
        if (d == 5) { return "5"; }
        if (d == 6) { return "6"; }
        if (d == 7) { return "7"; }
        if (d == 8) { return "8"; }
        return "9";
    }

    // ---- helpers ----

    static bool StartsWith(string s, string prefix) {
        if (s.Length < prefix.Length) { return false; }
        return s.Substring(0, prefix.Length) == prefix;
    }

    /// <summary>Parses "a=1&b=2" pairs (URL-decoded) into a StrMap.</summary>
    static void ParsePairs(string s, StrMap into) {
        int i = 0;
        int n = s.Length;
        while (i < n) {
            int eq = -1;
            int e = i;
            while (e < n) {
                int c = s[e] & 255;
                if (c == 38) { break; }           // '&'
                if (eq < 0 && c == 61) { eq = e; } // '='
                e = e + 1;
            }
            if (eq > i) {
                string k = Encoding.UrlDecode(s.Substring(i, eq - i));
                string v = Encoding.UrlDecode(s.Substring(eq + 1, e - eq - 1));
                // A browser posts a checkbox group as the same field repeated
                // under the "name[]" convention. That is one value to the
                // action that reads it -- a comma separated list, the shape the
                // readers already take -- so the ticked boxes arrive as
                // In("permIds") rather than as a name nothing asks for.
                if (k.Length > 2 && k.Substring(k.Length - 2, 2) == "[]") {
                    k = k.Substring(0, k.Length - 2);
                    string prev = into.GetOr(k, "");
                    if (prev.Length > 0) { v = prev + "," + v; }
                }
                into.Set(k, v);
            }
            i = e + 1;
        }
    }
}

/// <summary>
/// Ordered string-to-string map on parallel lists. Small and predictable:
/// route params / query / form / headers per request stay tiny, so linear
/// lookup beats a hash table while keeping zero extra allocations.
///
/// The backing lists are created on the first Set: most requests never touch
/// their route params, query, form or state map, and an empty map that costs
/// nothing keeps the per-request allocation count down.
/// </summary>
class StrMap {
    List<string> keys;
    List<string> vals;

    StrMap() {
        this.keys = null;
        this.vals = null;
    }

    int Count() {
        if (this.keys == null) { return 0; }
        return this.keys.Count;
    }

    string KeyAt(int i) { return this.keys[i]; }

    string ValAt(int i) { return this.vals[i]; }

    /// <summary>Position of `key`, or -1. Callers that would otherwise do
    /// Has() followed by Get() use this to scan the map once (template
    /// rendering resolves every variable through here).</summary>
    int IndexOfKey(string key) {
        if (this.keys == null) { return -1; }
        for (int i = 0; i < this.keys.Count; i = i + 1) {
            if (this.keys[i] == key) { return i; }
        }
        return -1;
    }

    void Set(string key, string val) {
        if (this.keys == null) {
            this.keys = new List<string>();
            this.vals = new List<string>();
        }
        int at = this.IndexOfKey(key);
        if (at >= 0) {
            this.vals[at] = val;
            return;
        }
        this.keys.Add(key);
        this.vals.Add(val);
    }

    bool Has(string key) { return this.IndexOfKey(key) >= 0; }

    string Get(string key) { return this.GetOr(key, ""); }

    string GetOr(string key, string def) {
        int at = this.IndexOfKey(key);
        if (at < 0) { return def; }
        return this.vals[at];
    }

    void Clear() {
        this.keys = null;
        this.vals = null;
    }
}
