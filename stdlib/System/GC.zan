using System;

namespace System;

// 垃圾回收与堆分配统计 (A464)
//
// Zan 基于 ARC（自动引用计数），不存在非确定性的垃圾回收器停顿，
// 对象随引用归零确定性释放。本类提供与 .NET GC 兼容的观测入口：
// - `GetAllocatedBytesForCurrentThread()`: 获取当前线程累计分配的托管字节数（用于基准测试精确测量）
// - `GetTotalAllocatedBytes()`: 获取进程生命周期累计分配的托管字节数
// - `Collect()`: ARC 下为确定性无操作（兼容迁移调用）
// - `GetTotalAllocatedBytes()` / `GetTotalMemory()`: 内存占用观测
public static class GC {
    [DllImport("crt", EntryPoint = "zan_rt_alloc_bytes_thread")]
    static extern long ZanRtAllocBytesThread();

    [DllImport("crt", EntryPoint = "zan_rt_alloc_bytes_total")]
    static extern long ZanRtAllocBytesTotal();

    [DllImport("crt", EntryPoint = "zan_mem_slabs")]
    static extern long ZanMemSlabs();

    [DllImport("crt", EntryPoint = "zan_mem_trim")]
    static extern long ZanMemTrim();

    // 获取当前线程自启动以来累计分配的托管字节数（包含对象头开销）。
    public static long GetAllocatedBytesForCurrentThread() {
        return ZanRtAllocBytesThread();
    }

    // 获取当前进程生命周期累计分配的托管字节数。
    public static long GetTotalAllocatedBytes() {
        return ZanRtAllocBytesTotal();
    }

    // 获取当前托管堆总内存估算（字节）。
    // 若开启 --fast-alloc，返回 Slab 占用的字节数；否则返回累计分配字节。
    public static long GetTotalMemory(bool forceFullCollection) {
        long slabs = ZanMemSlabs();
        if (slabs > 0) {
            return slabs * 1048576;
        }
        return ZanRtAllocBytesTotal();
    }

    // 回收未使用的托管堆物理内存并归还操作系统（收缩常驻内存 Working Set / RSS）。
    public static void Collect() {
        ZanMemTrim();
    }

    // 显式修剪堆内存，返回本次向操作系统归还的物理内存字节数。
    public static long TrimMemory() {
        return ZanMemTrim();
    }
}
