using System;
using System.Threading;

namespace System.Buffers;

// 字节数组桶，管理特定容量梯度的数组缓存。
public class ByteArrayBucket : IDisposable {
    public int bufferLength;
    public int maxCount;
    public List<byte[]> buffers;
    public nint syncLock;

    public ByteArrayBucket(int bufferLength, int maxCount) {
        this.bufferLength = bufferLength;
        this.maxCount = maxCount;
        this.buffers = new List<byte[]>();
        this.syncLock = Mutex.Create();
    }


    public void Dispose() {
        if (this.syncLock != 0) {
            Mutex.Destroy(this.syncLock);
            this.syncLock = 0;
        }
        if (this.buffers != null) {
            this.buffers.Clear();
        }
    }

    public byte[] Rent() {
        if (this.syncLock == 0) {
            return new byte[this.bufferLength];
        }
        Mutex.Lock(this.syncLock);
        try {
            if (this.buffers.Count > 0) {
                int lastIdx = this.buffers.Count - 1;
                byte[] arr = this.buffers[lastIdx];
                this.buffers.RemoveAt(lastIdx);
                return arr;
            }
            return new byte[this.bufferLength];
        } finally {
            Mutex.Unlock(this.syncLock);
        }
    }

    public void Return(byte[] array, bool clearArray) {
        if (array == null || array.Length != this.bufferLength) {
            return;
        }
        if (clearArray) {
            for (int i = 0; i < array.Length; i = i + 1) {
                array[i] = (byte)0;
            }
        }
        if (this.syncLock == 0) {
            return;
        }
        Mutex.Lock(this.syncLock);
        try {
            if (this.buffers.Count < this.maxCount) {
                this.buffers.Add(array);
            }
        } finally {
            Mutex.Unlock(this.syncLock);
        }
    }
}
