using System;
using System.Threading;

namespace System.Buffers;

// 工业级高性能分桶字节缓冲池，消除高频网络 IO、组帧与序列化过程中的频繁堆分配与内存碎片。
public class ArrayPool : IDisposable {
    static ArrayPool shared;
    static nint globalLock;

    public List<ByteArrayBucket> buckets;

    public ArrayPool() {
        this.buckets = new List<ByteArrayBucket>();
        // 阶梯容量梯度：16B 到 1MB 共 17 个 bucket
        int sz = 16;
        for (int i = 0; i < 17; i = i + 1) {
            // 每桶最多缓存 32 个复用块
            this.buckets.Add(new ByteArrayBucket(sz, 32));
            sz = sz * 2;
        }
    }

    public ArrayPool(int maxArrayLength, int maxArraysPerBucket) {
        this.buckets = new List<ByteArrayBucket>();
        int sz = 16;
        while (sz <= maxArrayLength) {
            this.buckets.Add(new ByteArrayBucket(sz, maxArraysPerBucket));
            if (sz > 0x3fffffff) { break; }
            sz = sz * 2;
        }
    }


    public void Dispose() {
        if (this.buckets != null) {
            for (int i = 0; i < this.buckets.Count; i = i + 1) {
                ByteArrayBucket b = this.buckets[i];
                if (b != null) {
                    b.Dispose();
                }
            }
            this.buckets.Clear();
        }
    }

    // 全局共享缓冲池单例。
    public static ArrayPool Shared {
        get {
            if (ArrayPool.shared == null) {
                if (ArrayPool.globalLock == 0) {
                    ArrayPool.globalLock = Mutex.Create();
                }
                Mutex.Lock(ArrayPool.globalLock);
                try {
                    if (ArrayPool.shared == null) {
                        ArrayPool.shared = new ArrayPool();
                    }
                } finally {
                    Mutex.Unlock(ArrayPool.globalLock);
                }
            }
            return ArrayPool.shared;
        }
    }

    // 创建新的隔离缓冲池实例。
    public static ArrayPool Create() {
        return new ArrayPool();
    }

    // 创建具有指定上限配置的新缓冲池实例。
    public static ArrayPool Create(int maxArrayLength, int maxArraysPerBucket) {
        return new ArrayPool(maxArrayLength, maxArraysPerBucket);
    }

    // 租借长度不小于 minimumLength 字节的缓冲区。
    public byte[] Rent(int minimumLength) {
        if (minimumLength <= 0) {
            minimumLength = 16;
        }
        for (int i = 0; i < this.buckets.Count; i = i + 1) {
            ByteArrayBucket b = this.buckets[i];
            if (b.bufferLength >= minimumLength) {
                return b.Rent();
            }
        }
        // 超过梯度上限直接分配
        return new byte[minimumLength];
    }

    // 归还缓冲区至池中。
    public void Return(byte[] array, bool clearArray) {
        if (array == null) { return; }
        int len = array.Length;
        for (int i = 0; i < this.buckets.Count; i = i + 1) {
            ByteArrayBucket b = this.buckets[i];
            if (b.bufferLength == len) {
                b.Return(array, clearArray);
                return;
            }
        }
    }

    // 归还缓冲区（默认不清空内容）。
    public void Return(byte[] array) {
        this.Return(array, false);
    }
}
