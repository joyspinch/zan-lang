using System;
using System.Interop;

namespace System.Buffers.Binary;

// 高性能二进制流式缓冲读取器。
// 支持大端/小端快速读取、Zigzag/LEB128 变长整数解码与边界安全检测。
public class BinaryBufferReader {
    private byte[] buffer;
    private int startOffset;
    private int offset;
    private int limit;
    private int bitMask;
    private int bitPos;

    public BinaryBufferReader(byte[] buffer) {
        this.buffer = buffer;
        this.startOffset = 0;
        this.offset = 0;
        this.limit = buffer != null ? buffer.Length : 0;
        this.bitMask = 0;
        this.bitPos = 8;
    }

    public BinaryBufferReader(byte[] buffer, int offset, int length) {
        this.buffer = buffer;
        if (buffer == null) {
            this.startOffset = 0;
            this.offset = 0;
            this.limit = 0;
        } else {
            int off = offset < 0 ? 0 : (offset > buffer.Length ? buffer.Length : offset);
            int len = length < 0 ? 0 : length;
            long limL = (long)off + (long)len;
            this.startOffset = off;
            this.offset = off;
            this.limit = limL > (long)buffer.Length ? buffer.Length : (int)limL;
        }
        this.bitMask = 0;
        this.bitPos = 8;
    }

    public int Position() { return this.offset; }
    public int Limit() { return this.limit; }
    public int Remaining() { return this.limit - this.offset; }
    public bool HasRemaining() { return this.offset < this.limit; }

    public void Seek(int newPosition) {
        if (newPosition >= this.startOffset && newPosition <= this.limit) {
            this.offset = newPosition;
            this.bitPos = 8;
        }
    }

    public bool ReadBit() {
        if (this.bitPos > 7) {
            if (this.offset >= this.limit) { return false; }
            this.bitMask = (int)this.buffer[this.offset] & 255;
            this.offset = this.offset + 1;
            this.bitPos = 0;
        }
        bool isSet = (this.bitMask & (1 << (7 - this.bitPos))) != 0;
        this.bitPos = this.bitPos + 1;
        return isSet;
    }

    public bool ReadBitLSB() {
        if (this.bitPos > 7) {
            if (this.offset >= this.limit) { return false; }
            this.bitMask = (int)this.buffer[this.offset] & 255;
            this.offset = this.offset + 1;
            this.bitPos = 0;
        }
        bool isSet = (this.bitMask & (1 << this.bitPos)) != 0;
        this.bitPos = this.bitPos + 1;
        return isSet;
    }

    public int ReadInt8() {
        this.bitPos = 8;
        if (this.Remaining() < 1) { return 0; }
        byte b = this.buffer[this.offset];
        this.offset = this.offset + 1;
        if (b >= 128) { return (int)b - 256; }
        return (int)b;
    }

    public int ReadUInt8() {
        this.bitPos = 8;
        if (this.Remaining() < 1) { return 0; }
        int v = (int)this.buffer[this.offset] & 255;
        this.offset = this.offset + 1;
        return v;
    }

    // ---- 大端读取 (Big-Endian) ----

    public int ReadInt16BE() {
        this.bitPos = 8;
        if (this.Remaining() < 2) { return 0; }
        int b0 = (int)this.buffer[this.offset] & 255;
        int b1 = (int)this.buffer[this.offset + 1] & 255;
        this.offset = this.offset + 2;
        int v = (b0 << 8) | b1;
        if (v >= 32768) { return v - 65536; }
        return v;
    }

    public int ReadUInt16BE() {
        this.bitPos = 8;
        if (this.Remaining() < 2) { return 0; }
        int b0 = (int)this.buffer[this.offset] & 255;
        int b1 = (int)this.buffer[this.offset + 1] & 255;
        this.offset = this.offset + 2;
        return (b0 << 8) | b1;
    }

    public int ReadInt32BE() {
        this.bitPos = 8;
        if (this.Remaining() < 4) { return 0; }
        int b0 = (int)this.buffer[this.offset] & 255;
        int b1 = (int)this.buffer[this.offset + 1] & 255;
        int b2 = (int)this.buffer[this.offset + 2] & 255;
        int b3 = (int)this.buffer[this.offset + 3] & 255;
        this.offset = this.offset + 4;
        return (b0 << 24) | (b1 << 16) | (b2 << 8) | b3;
    }

    public long ReadUInt32BE() {
        this.bitPos = 8;
        if (this.Remaining() < 4) { return 0L; }
        long b0 = (long)((int)this.buffer[this.offset] & 255);
        long b1 = (long)((int)this.buffer[this.offset + 1] & 255);
        long b2 = (long)((int)this.buffer[this.offset + 2] & 255);
        long b3 = (long)((int)this.buffer[this.offset + 3] & 255);
        this.offset = this.offset + 4;
        return (b0 << 24) | (b1 << 16) | (b2 << 8) | b3;
    }

    public long ReadInt64BE() {
        this.bitPos = 8;
        if (this.Remaining() < 8) { return 0L; }
        long b0 = (long)((int)this.buffer[this.offset] & 255);
        long b1 = (long)((int)this.buffer[this.offset + 1] & 255);
        long b2 = (long)((int)this.buffer[this.offset + 2] & 255);
        long b3 = (long)((int)this.buffer[this.offset + 3] & 255);
        long b4 = (long)((int)this.buffer[this.offset + 4] & 255);
        long b5 = (long)((int)this.buffer[this.offset + 5] & 255);
        long b6 = (long)((int)this.buffer[this.offset + 6] & 255);
        long b7 = (long)((int)this.buffer[this.offset + 7] & 255);
        this.offset = this.offset + 8;
        return (b0 << 56) | (b1 << 48) | (b2 << 40) | (b3 << 32) |
               (b4 << 24) | (b5 << 16) | (b6 << 8) | b7;
    }

    // ---- 小端读取 (Little-Endian) ----

    public int ReadInt16LE() {
        this.bitPos = 8;
        if (this.Remaining() < 2) { return 0; }
        int b0 = (int)this.buffer[this.offset] & 255;
        int b1 = (int)this.buffer[this.offset + 1] & 255;
        this.offset = this.offset + 2;
        int v = (b1 << 8) | b0;
        if (v >= 32768) { return v - 65536; }
        return v;
    }

    public int ReadUInt16LE() {
        this.bitPos = 8;
        if (this.Remaining() < 2) { return 0; }
        int b0 = (int)this.buffer[this.offset] & 255;
        int b1 = (int)this.buffer[this.offset + 1] & 255;
        this.offset = this.offset + 2;
        return (b1 << 8) | b0;
    }

    public int ReadInt32LE() {
        this.bitPos = 8;
        int p = this.offset;
        if (this.limit - p < 4) { return 0; }
        Span<byte> b = new Span<byte>((nint)this.buffer, this.limit);
        int v = ((int)b[p] & 255)
            | (((int)b[p + 1] & 255) << 8)
            | (((int)b[p + 2] & 255) << 16)
            | (((int)b[p + 3] & 255) << 24);
        this.offset = p + 4;
        return v;
    }

    public long ReadUInt32LE() {
        this.bitPos = 8;
        int p = this.offset;
        if (this.limit - p < 4) { return 0L; }
        Span<byte> b = new Span<byte>((nint)this.buffer, this.limit);
        long v = (long)((int)b[p] & 255)
            | ((long)((int)b[p + 1] & 255) << 8)
            | ((long)((int)b[p + 2] & 255) << 16)
            | ((long)((int)b[p + 3] & 255) << 24);
        this.offset = p + 4;
        return v;
    }

    public long ReadInt64LE() {
        this.bitPos = 8;
        int p = this.offset;
        if (this.limit - p < 8) { return 0L; }
        Span<byte> b = new Span<byte>((nint)this.buffer, this.limit);
        long v = (long)((int)b[p] & 255)
            | ((long)((int)b[p + 1] & 255) << 8)
            | ((long)((int)b[p + 2] & 255) << 16)
            | ((long)((int)b[p + 3] & 255) << 24)
            | ((long)((int)b[p + 4] & 255) << 32)
            | ((long)((int)b[p + 5] & 255) << 40)
            | ((long)((int)b[p + 6] & 255) << 48)
            | ((long)((int)b[p + 7] & 255) << 56);
        this.offset = p + 8;
        return v;
    }

    // ---- 变长整数解码 (Varint / LEB128 / Zigzag) ----

    public int ReadVarint32(bool zigzag) {
        this.bitPos = 8;
        int p = this.offset;
        int lim = this.limit;
        Span<byte> buf = new Span<byte>((nint)this.buffer, lim);
        int value = 0;
        int shift = 0;
        while (p < lim && shift < 32) {
            int b = (int)buf[p] & 255;
            p = p + 1;
            value = value | ((b & 127) << shift);
            if ((b & 128) == 0) {
                break;
            }
            shift = shift + 7;
        }
        this.offset = p;
        if (zigzag) {
            return (int)((uint)value >> 1) ^ (-(value & 1));
        }
        return value;
    }

    public long ReadVarint64(bool zigzag) {
        this.bitPos = 8;
        int p = this.offset;
        int lim = this.limit;
        Span<byte> buf = new Span<byte>((nint)this.buffer, lim);
        long value = 0L;
        int shift = 0;
        while (p < lim && shift < 64) {
            long b = (long)((int)buf[p] & 255);
            p = p + 1;
            value = value | ((b & 127L) << shift);
            if ((b & 128L) == 0L) {
                break;
            }
            shift = shift + 7;
        }
        this.offset = p;
        if (zigzag) {
            return (long)((ulong)value >> 1) ^ (-(value & 1L));
        }
        return value;
    }

    // ---- 字节与字符串读取 ----

    public byte[] ReadBytes(int count) {
        this.bitPos = 8;
        int p = this.offset;
        if (count <= 0 || this.limit - p < count) {
            return new byte[0];
        }
        byte[] result = new byte[count];
        NativeMemory.Copy((nint)result, (nint)this.buffer + (nint)p, count);
        this.offset = p + count;
        return result;
    }

    public string ReadStringUtf8(int length) {
        this.bitPos = 8;
        int p = this.offset;
        if (length <= 0 || this.limit - p < length) {
            return "";
        }
        string s = NativeMemory.GetString((nint)this.buffer, p, length);
        this.offset = p + length;
        return s;
    }

    public byte[] Buffer() {
        return this.buffer;
    }
}
