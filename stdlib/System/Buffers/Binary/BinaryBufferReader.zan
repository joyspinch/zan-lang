using System;
using System.Interop;

namespace System.Buffers.Binary;

// 高性能二进制流式缓冲读取器。
// 支持大端/小端快速读取、Zigzag/LEB128 变长整数解码与边界安全检测。
public class BinaryBufferReader {
    private byte[] buffer;
    private int offset;
    private int limit;
    private int bitMask;
    private int bitPos;

    public BinaryBufferReader(byte[] buffer) {
        this.buffer = buffer;
        this.offset = 0;
        this.limit = buffer != null ? buffer.Length : 0;
        this.bitMask = 0;
        this.bitPos = 8;
    }

    public BinaryBufferReader(byte[] buffer, int offset, int length) {
        this.buffer = buffer;
        this.offset = offset;
        this.limit = offset + length;
        if (this.buffer != null && this.limit > this.buffer.Length) {
            this.limit = this.buffer.Length;
        }
        this.bitMask = 0;
        this.bitPos = 8;
    }

    public int Position() { return this.offset; }
    public int Limit() { return this.limit; }
    public int Remaining() { return this.limit - this.offset; }
    public bool HasRemaining() { return this.offset < this.limit; }

    public void Seek(int newPosition) {
        if (newPosition >= 0 && newPosition <= this.limit) {
            this.offset = newPosition;
            this.bitPos = 8;
        }
    }

    public bool ReadBit() {
        if (this.bitPos > 7) {
            if (this.offset >= this.limit) { return false; }
            this.bitMask = (int)this.buffer[this.offset] & 255;
            this.offset = this.offset + 1;
            this.bitPos = 0;
        }
        bool isSet = (this.bitMask & (1 << (7 - this.bitPos))) != 0;
        this.bitPos = this.bitPos + 1;
        return isSet;
    }

    public int ReadInt8() {
        this.bitPos = 8;
        if (this.Remaining() < 1) { return 0; }
        byte b = this.buffer[this.offset];
        this.offset = this.offset + 1;
        if (b >= 128) { return (int)b - 256; }
        return (int)b;
    }

    public int ReadUInt8() {
        this.bitPos = 8;
        if (this.Remaining() < 1) { return 0; }
        int v = (int)this.buffer[this.offset] & 255;
        this.offset = this.offset + 1;
        return v;
    }

    // ---- 大端读取 (Big-Endian) ----

    public int ReadInt16BE() {
        this.bitPos = 8;
        if (this.Remaining() < 2) { return 0; }
        int b0 = (int)this.buffer[this.offset] & 255;
        int b1 = (int)this.buffer[this.offset + 1] & 255;
        this.offset = this.offset + 2;
        int v = (b0 << 8) | b1;
        if (v >= 32768) { return v - 65536; }
        return v;
    }

    public int ReadUInt16BE() {
        this.bitPos = 8;
        if (this.Remaining() < 2) { return 0; }
        int b0 = (int)this.buffer[this.offset] & 255;
        int b1 = (int)this.buffer[this.offset + 1] & 255;
        this.offset = this.offset + 2;
        return (b0 << 8) | b1;
    }

    public int ReadInt32BE() {
        this.bitPos = 8;
        if (this.Remaining() < 4) { return 0; }
        int b0 = (int)this.buffer[this.offset] & 255;
        int b1 = (int)this.buffer[this.offset + 1] & 255;
        int b2 = (int)this.buffer[this.offset + 2] & 255;
        int b3 = (int)this.buffer[this.offset + 3] & 255;
        this.offset = this.offset + 4;
        return (b0 << 24) | (b1 << 16) | (b2 << 8) | b3;
    }

    public long ReadInt64BE() {
        this.bitPos = 8;
        if (this.Remaining() < 8) { return 0L; }
        long b0 = (long)((int)this.buffer[this.offset] & 255);
        long b1 = (long)((int)this.buffer[this.offset + 1] & 255);
        long b2 = (long)((int)this.buffer[this.offset + 2] & 255);
        long b3 = (long)((int)this.buffer[this.offset + 3] & 255);
        long b4 = (long)((int)this.buffer[this.offset + 4] & 255);
        long b5 = (long)((int)this.buffer[this.offset + 5] & 255);
        long b6 = (long)((int)this.buffer[this.offset + 6] & 255);
        long b7 = (long)((int)this.buffer[this.offset + 7] & 255);
        this.offset = this.offset + 8;
        return (b0 << 56) | (b1 << 48) | (b2 << 40) | (b3 << 32) |
               (b4 << 24) | (b5 << 16) | (b6 << 8) | b7;
    }

    // ---- 小端读取 (Little-Endian) ----

    public int ReadInt16LE() {
        this.bitPos = 8;
        if (this.Remaining() < 2) { return 0; }
        int b0 = (int)this.buffer[this.offset] & 255;
        int b1 = (int)this.buffer[this.offset + 1] & 255;
        this.offset = this.offset + 2;
        int v = (b1 << 8) | b0;
        if (v >= 32768) { return v - 65536; }
        return v;
    }

    public int ReadUInt16LE() {
        this.bitPos = 8;
        if (this.Remaining() < 2) { return 0; }
        int b0 = (int)this.buffer[this.offset] & 255;
        int b1 = (int)this.buffer[this.offset + 1] & 255;
        this.offset = this.offset + 2;
        return (b1 << 8) | b0;
    }

    public int ReadInt32LE() {
        this.bitPos = 8;
        if (this.Remaining() < 4) { return 0; }
        int b0 = (int)this.buffer[this.offset] & 255;
        int b1 = (int)this.buffer[this.offset + 1] & 255;
        int b2 = (int)this.buffer[this.offset + 2] & 255;
        int b3 = (int)this.buffer[this.offset + 3] & 255;
        this.offset = this.offset + 4;
        return (b3 << 24) | (b2 << 16) | (b1 << 8) | b0;
    }

    public long ReadInt64LE() {
        this.bitPos = 8;
        if (this.Remaining() < 8) { return 0L; }
        long b0 = (long)((int)this.buffer[this.offset] & 255);
        long b1 = (long)((int)this.buffer[this.offset + 1] & 255);
        long b2 = (long)((int)this.buffer[this.offset + 2] & 255);
        long b3 = (long)((int)this.buffer[this.offset + 3] & 255);
        long b4 = (long)((int)this.buffer[this.offset + 4] & 255);
        long b5 = (long)((int)this.buffer[this.offset + 5] & 255);
        long b6 = (long)((int)this.buffer[this.offset + 6] & 255);
        long b7 = (long)((int)this.buffer[this.offset + 7] & 255);
        this.offset = this.offset + 8;
        return (b7 << 56) | (b6 << 48) | (b5 << 40) | (b4 << 32) |
               (b3 << 24) | (b2 << 16) | (b1 << 8) | b0;
    }

    // ---- 变长整数解码 (Varint / LEB128 / Zigzag) ----

    public int ReadVarint32(bool zigzag) {
        this.bitPos = 8;
        int value = 0;
        int shift = 0;
        while (this.Remaining() > 0 && shift < 32) {
            int b = (int)this.buffer[this.offset] & 255;
            this.offset = this.offset + 1;
            value = value | ((b & 127) << shift);
            if ((b & 128) == 0) {
                break;
            }
            shift = shift + 7;
        }
        if (zigzag) {
            return (int)((uint)value >> 1) ^ (-(value & 1));
        }
        return value;
    }

    public long ReadVarint64(bool zigzag) {
        this.bitPos = 8;
        long value = 0L;
        int shift = 0;
        while (this.Remaining() > 0 && shift < 64) {
            long b = (long)((int)this.buffer[this.offset] & 255);
            this.offset = this.offset + 1;
            value = value | ((b & 127L) << shift);
            if ((b & 128L) == 0L) {
                break;
            }
            shift = shift + 7;
        }
        if (zigzag) {
            return (long)((ulong)value >> 1) ^ (-(value & 1L));
        }
        return value;
    }

    // ---- 字节与字符串读取 ----

    public byte[] ReadBytes(int count) {
        this.bitPos = 8;
        if (count <= 0 || this.Remaining() < count) {
            return new byte[0];
        }
        byte[] result = new byte[count];
        NativeMemory.Copy((nint)result, (nint)this.buffer + (nint)this.offset, count);
        this.offset = this.offset + count;
        return result;
    }

    public string ReadStringUtf8(int length) {
        this.bitPos = 8;
        if (length <= 0 || this.Remaining() < length) {
            return "";
        }
        string s = NativeMemory.GetString((nint)this.buffer, this.offset, length);
        this.offset = this.offset + length;
        return s;
    }

    public byte[] Buffer() {
        return this.buffer;
    }
}
