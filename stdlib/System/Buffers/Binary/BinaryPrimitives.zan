using System;

namespace System.Buffers.Binary;

// 二进制基元：端序敏感的无分配标量读写与端序翻转。
// 适配 ReadOnlySpan<byte> 与 Span<byte>，完全消除临时 byte[] 堆分配与装箱开销。
public class BinaryPrimitives {
    // ---- 端序翻转 (ReverseEndianness) ----

    public static short ReverseEndianness(short value) {
        int v = (int)value;
        return (short)(((v & 255) << 8) | ((v >> 8) & 255));
    }

    public static ushort ReverseEndianness(ushort value) {
        int v = (int)value;
        return (ushort)(((v & 255) << 8) | ((v >> 8) & 255));
    }

    public static int ReverseEndianness(int value) {
        return ((value & 255) << 24) |
               (((value >> 8) & 255) << 16) |
               (((value >> 16) & 255) << 8) |
               ((value >> 24) & 255);
    }

    public static uint ReverseEndianness(uint value) {
        return (uint)ReverseEndianness((int)value);
    }

    public static long ReverseEndianness(long value) {
        return (((long)(value & 255)) << 56) |
               (((long)((value >> 8) & 255)) << 48) |
               (((long)((value >> 16) & 255)) << 40) |
               (((long)((value >> 24) & 255)) << 32) |
               (((long)((value >> 32) & 255)) << 24) |
               (((long)((value >> 40) & 255)) << 16) |
               (((long)((value >> 48) & 255)) << 8) |
               ((long)((value >> 56) & 255));
    }

    public static ulong ReverseEndianness(ulong value) {
        return (ulong)ReverseEndianness((long)value);
    }

    // ---- 小端读取 (Read LittleEndian) ----

    public static short ReadInt16LittleEndian(ReadOnlySpan<byte> source) {
        if (source.Length < 2) { throw new ArgumentOutOfRangeException("source"); }
        int v = (source[0] & 255) | ((source[1] & 255) << 8);
        if (v > 32767) { v = v - 65536; }
        return (short)v;
    }

    public static ushort ReadUInt16LittleEndian(ReadOnlySpan<byte> source) {
        if (source.Length < 2) { throw new ArgumentOutOfRangeException("source"); }
        return (ushort)((source[0] & 255) | ((source[1] & 255) << 8));
    }

    public static int ReadInt32LittleEndian(ReadOnlySpan<byte> source) {
        if (source.Length < 4) { throw new ArgumentOutOfRangeException("source"); }
        return (source[0] & 255) |
               ((source[1] & 255) << 8) |
               ((source[2] & 255) << 16) |
               ((source[3] & 255) << 24);
    }

    public static uint ReadUInt32LittleEndian(ReadOnlySpan<byte> source) {
        return (uint)ReadInt32LittleEndian(source);
    }

    public static long ReadInt64LittleEndian(ReadOnlySpan<byte> source) {
        if (source.Length < 8) { throw new ArgumentOutOfRangeException("source"); }
        return ((long)(source[0] & 255)) |
               (((long)(source[1] & 255)) << 8) |
               (((long)(source[2] & 255)) << 16) |
               (((long)(source[3] & 255)) << 24) |
               (((long)(source[4] & 255)) << 32) |
               (((long)(source[5] & 255)) << 40) |
               (((long)(source[6] & 255)) << 48) |
               (((long)(source[7] & 255)) << 56);
    }

    public static ulong ReadUInt64LittleEndian(ReadOnlySpan<byte> source) {
        return (ulong)ReadInt64LittleEndian(source);
    }

    public static float ReadSingleLittleEndian(ReadOnlySpan<byte> source) {
        int bits = ReadInt32LittleEndian(source);
        return NativeMemory.AsF32(bits);
    }

    public static double ReadDoubleLittleEndian(ReadOnlySpan<byte> source) {
        long bits = ReadInt64LittleEndian(source);
        return NativeMemory.AsF64(bits);
    }

    // ---- 大端读取 (Read BigEndian) ----

    public static short ReadInt16BigEndian(ReadOnlySpan<byte> source) {
        if (source.Length < 2) { throw new ArgumentOutOfRangeException("source"); }
        int v = ((source[0] & 255) << 8) | (source[1] & 255);
        if (v > 32767) { v = v - 65536; }
        return (short)v;
    }

    public static ushort ReadUInt16BigEndian(ReadOnlySpan<byte> source) {
        if (source.Length < 2) { throw new ArgumentOutOfRangeException("source"); }
        return (ushort)(((source[0] & 255) << 8) | (source[1] & 255));
    }

    public static int ReadInt32BigEndian(ReadOnlySpan<byte> source) {
        if (source.Length < 4) { throw new ArgumentOutOfRangeException("source"); }
        return ((source[0] & 255) << 24) |
               ((source[1] & 255) << 16) |
               ((source[2] & 255) << 8) |
               (source[3] & 255);
    }

    public static uint ReadUInt32BigEndian(ReadOnlySpan<byte> source) {
        return (uint)ReadInt32BigEndian(source);
    }

    public static long ReadInt64BigEndian(ReadOnlySpan<byte> source) {
        if (source.Length < 8) { throw new ArgumentOutOfRangeException("source"); }
        return (((long)(source[0] & 255)) << 56) |
               (((long)(source[1] & 255)) << 48) |
               (((long)(source[2] & 255)) << 40) |
               (((long)(source[3] & 255)) << 32) |
               (((long)(source[4] & 255)) << 24) |
               (((long)(source[5] & 255)) << 16) |
               (((long)(source[6] & 255)) << 8) |
               ((long)(source[7] & 255));
    }

    public static ulong ReadUInt64BigEndian(ReadOnlySpan<byte> source) {
        return (ulong)ReadInt64BigEndian(source);
    }

    public static float ReadSingleBigEndian(ReadOnlySpan<byte> source) {
        int bits = ReadInt32BigEndian(source);
        return NativeMemory.AsF32(bits);
    }

    public static double ReadDoubleBigEndian(ReadOnlySpan<byte> source) {
        long bits = ReadInt64BigEndian(source);
        return NativeMemory.AsF64(bits);
    }

    // ---- 小端写入 (Write LittleEndian) ----

    public static void WriteInt16LittleEndian(Span<byte> destination, short value) {
        if (destination.Length < 2) { throw new ArgumentOutOfRangeException("destination"); }
        int v = (int)value;
        destination[0] = (byte)v;
        destination[1] = (byte)(v >> 8);
    }

    public static void WriteUInt16LittleEndian(Span<byte> destination, ushort value) {
        if (destination.Length < 2) { throw new ArgumentOutOfRangeException("destination"); }
        int v = (int)value;
        destination[0] = (byte)v;
        destination[1] = (byte)(v >> 8);
    }

    public static void WriteInt32LittleEndian(Span<byte> destination, int value) {
        if (destination.Length < 4) { throw new ArgumentOutOfRangeException("destination"); }
        destination[0] = (byte)value;
        destination[1] = (byte)(value >> 8);
        destination[2] = (byte)(value >> 16);
        destination[3] = (byte)(value >> 24);
    }

    public static void WriteUInt32LittleEndian(Span<byte> destination, uint value) {
        WriteInt32LittleEndian(destination, (int)value);
    }

    public static void WriteInt64LittleEndian(Span<byte> destination, long value) {
        if (destination.Length < 8) { throw new ArgumentOutOfRangeException("destination"); }
        destination[0] = (byte)value;
        destination[1] = (byte)(value >> 8);
        destination[2] = (byte)(value >> 16);
        destination[3] = (byte)(value >> 24);
        destination[4] = (byte)(value >> 32);
        destination[5] = (byte)(value >> 40);
        destination[6] = (byte)(value >> 48);
        destination[7] = (byte)(value >> 56);
    }

    public static void WriteUInt64LittleEndian(Span<byte> destination, ulong value) {
        WriteInt64LittleEndian(destination, (long)value);
    }

    public static void WriteSingleLittleEndian(Span<byte> destination, float value) {
        int bits = NativeMemory.AsI32(value);
        WriteInt32LittleEndian(destination, bits);
    }

    public static void WriteDoubleLittleEndian(Span<byte> destination, double value) {
        long bits = NativeMemory.AsI64(value);
        WriteInt64LittleEndian(destination, bits);
    }

    // ---- 大端写入 (Write BigEndian) ----

    public static void WriteInt16BigEndian(Span<byte> destination, short value) {
        if (destination.Length < 2) { throw new ArgumentOutOfRangeException("destination"); }
        int v = (int)value;
        destination[0] = (byte)(v >> 8);
        destination[1] = (byte)v;
    }

    public static void WriteUInt16BigEndian(Span<byte> destination, ushort value) {
        if (destination.Length < 2) { throw new ArgumentOutOfRangeException("destination"); }
        int v = (int)value;
        destination[0] = (byte)(v >> 8);
        destination[1] = (byte)v;
    }

    public static void WriteInt32BigEndian(Span<byte> destination, int value) {
        if (destination.Length < 4) { throw new ArgumentOutOfRangeException("destination"); }
        destination[0] = (byte)(value >> 24);
        destination[1] = (byte)(value >> 16);
        destination[2] = (byte)(value >> 8);
        destination[3] = (byte)value;
    }

    public static void WriteUInt32BigEndian(Span<byte> destination, uint value) {
        WriteInt32BigEndian(destination, (int)value);
    }

    public static void WriteInt64BigEndian(Span<byte> destination, long value) {
        if (destination.Length < 8) { throw new ArgumentOutOfRangeException("destination"); }
        destination[0] = (byte)(value >> 56);
        destination[1] = (byte)(value >> 48);
        destination[2] = (byte)(value >> 40);
        destination[3] = (byte)(value >> 32);
        destination[4] = (byte)(value >> 24);
        destination[5] = (byte)(value >> 16);
        destination[6] = (byte)(value >> 8);
        destination[7] = (byte)value;
    }

    public static void WriteUInt64BigEndian(Span<byte> destination, ulong value) {
        WriteInt64BigEndian(destination, (long)value);
    }

    public static void WriteSingleBigEndian(Span<byte> destination, float value) {
        int bits = NativeMemory.AsI32(value);
        WriteInt32BigEndian(destination, bits);
    }

    public static void WriteDoubleBigEndian(Span<byte> destination, double value) {
        long bits = NativeMemory.AsI64(value);
        WriteInt64BigEndian(destination, bits);
    }

    // ---- TryRead / TryWrite 非异常快速探针 ----

    public static bool TryReadInt16LittleEndian(ReadOnlySpan<byte> source, out short value) {
        if (source.Length < 2) { value = 0; return false; }
        value = ReadInt16LittleEndian(source);
        return true;
    }

    public static bool TryReadInt32LittleEndian(ReadOnlySpan<byte> source, out int value) {
        if (source.Length < 4) { value = 0; return false; }
        value = ReadInt32LittleEndian(source);
        return true;
    }

    public static bool TryReadInt64LittleEndian(ReadOnlySpan<byte> source, out long value) {
        if (source.Length < 8) { value = 0; return false; }
        value = ReadInt64LittleEndian(source);
        return true;
    }

    public static bool TryReadSingleLittleEndian(ReadOnlySpan<byte> source, out float value) {
        if (source.Length < 4) { value = 0.0f; return false; }
        value = ReadSingleLittleEndian(source);
        return true;
    }

    public static bool TryReadDoubleLittleEndian(ReadOnlySpan<byte> source, out double value) {
        if (source.Length < 8) { value = 0.0; return false; }
        value = ReadDoubleLittleEndian(source);
        return true;
    }

    public static bool TryWriteInt16LittleEndian(Span<byte> destination, short value) {
        if (destination.Length < 2) { return false; }
        WriteInt16LittleEndian(destination, value);
        return true;
    }

    public static bool TryWriteInt32LittleEndian(Span<byte> destination, int value) {
        if (destination.Length < 4) { return false; }
        WriteInt32LittleEndian(destination, value);
        return true;
    }

    public static bool TryWriteInt64LittleEndian(Span<byte> destination, long value) {
        if (destination.Length < 8) { return false; }
        WriteInt64LittleEndian(destination, value);
        return true;
    }
}
