using System;
using System.Interop;

namespace System.Buffers.Binary;

// 高性能二进制流式缓冲写入器。
// 支持大端/小端快速写入、Zigzag/LEB128 变长整数编码、位压缩 (Bit Packing) 与报文头回填。
public class BinaryBufferWriter {
    private byte[] buffer;
    private int capacity;
    private int position;
    private int bitMask;
    private int bitPos;
    private int lsbBitMask;
    private int lsbBitPos;

    public BinaryBufferWriter() {
        this.Init(256);
    }

    public BinaryBufferWriter(int initialCapacity) {
        this.Init(initialCapacity > 16 ? initialCapacity : 16);
    }

    private void Init(int cap) {
        this.capacity = cap;
        this.buffer = new byte[cap];
        this.position = 0;
        this.bitMask = 0;
        this.bitPos = 8;
        this.lsbBitMask = 0;
        this.lsbBitPos = 0;
    }

    public int Position() { return this.position; }
    public int Length() { return this.position; }
    public int Capacity() { return this.capacity; }

    public void EnsureCapacity(int required) {
        if (required <= 0) {
            return;
        }
        long neededL = (long)this.position + (long)required;
        if (neededL > 2147483591L) {
            throw new ArgumentOutOfRangeException("BinaryBufferWriter capacity overflow.");
        }
        if (neededL <= (long)this.capacity) {
            return;
        }
        long nextCapL = (long)this.capacity * 2L;
        long minCapL = neededL + 64L;
        if (minCapL > 2147483591L) {
            minCapL = 2147483591L;
        }
        if (nextCapL < minCapL) {
            nextCapL = minCapL;
        }
        if (nextCapL > 2147483591L) {
            nextCapL = 2147483591L;
        }
        int nextCap = (int)nextCapL;
        byte[] newBuf = new byte[nextCap];
        if (this.position > 0) {
            NativeMemory.Copy((nint)newBuf, (nint)this.buffer, this.position);
        }
        this.buffer = newBuf;
        this.capacity = nextCap;
    }

    public void FlushBits() {
        if (this.bitPos < 8) {
            this.EnsureCapacity(1);
            this.buffer[this.position] = (byte)this.bitMask;
            this.position = this.position + 1;
            this.bitMask = 0;
            this.bitPos = 8;
        }
        if (this.lsbBitPos > 0) {
            this.EnsureCapacity(1);
            this.buffer[this.position] = (byte)this.lsbBitMask;
            this.position = this.position + 1;
            this.lsbBitMask = 0;
            this.lsbBitPos = 0;
        }
    }

    public void FlushBitsLSB() {
        this.FlushBits();
    }

    public void WriteBit(bool bit) {
        if (this.lsbBitPos > 0) {
            this.FlushBits();
        }
        if (this.bitPos == 0) {
            this.FlushBits();
        }
        if (this.bitPos == 8) {
            this.bitMask = 0;
        }
        this.bitPos = this.bitPos - 1;
        if (bit) {
            this.bitMask = this.bitMask | (1 << this.bitPos);
        }
    }

    public void WriteBitLSB(bool bit) {
        if (this.bitPos < 8) {
            this.FlushBits();
        }
        if (this.lsbBitPos >= 8) {
            this.FlushBits();
        }
        if (bit) {
            this.lsbBitMask = this.lsbBitMask | (1 << this.lsbBitPos);
        }
        this.lsbBitPos = this.lsbBitPos + 1;
        if (this.lsbBitPos >= 8) {
            this.FlushBits();
        }
    }

    public void WriteInt8(int v) {
        this.FlushBits();
        this.EnsureCapacity(1);
        this.buffer[this.position] = (byte)(v & 255);
        this.position = this.position + 1;
    }

    public void WriteUInt8(int v) {
        this.WriteInt8(v);
    }

    // ---- 大端写入 (Big-Endian) ----

    public void WriteInt16BE(int v) {
        this.FlushBits();
        this.EnsureCapacity(2);
        this.buffer[this.position] = (byte)((v >> 8) & 255);
        this.buffer[this.position + 1] = (byte)(v & 255);
        this.position = this.position + 2;
    }

    public void WriteUInt16BE(int v) {
        this.WriteInt16BE(v);
    }

    public void WriteInt32BE(int v) {
        this.FlushBits();
        this.EnsureCapacity(4);
        this.buffer[this.position] = (byte)((v >> 24) & 255);
        this.buffer[this.position + 1] = (byte)((v >> 16) & 255);
        this.buffer[this.position + 2] = (byte)((v >> 8) & 255);
        this.buffer[this.position + 3] = (byte)(v & 255);
        this.position = this.position + 4;
    }

    public void WriteUInt32BE(long v) {
        this.FlushBits();
        this.EnsureCapacity(4);
        this.buffer[this.position] = (byte)((v >> 24) & 255L);
        this.buffer[this.position + 1] = (byte)((v >> 16) & 255L);
        this.buffer[this.position + 2] = (byte)((v >> 8) & 255L);
        this.buffer[this.position + 3] = (byte)(v & 255L);
        this.position = this.position + 4;
    }

    public void WriteInt64BE(long v) {
        this.FlushBits();
        this.EnsureCapacity(8);
        this.buffer[this.position] = (byte)((v >> 56) & 255);
        this.buffer[this.position + 1] = (byte)((v >> 48) & 255);
        this.buffer[this.position + 2] = (byte)((v >> 40) & 255);
        this.buffer[this.position + 3] = (byte)((v >> 32) & 255);
        this.buffer[this.position + 4] = (byte)((v >> 24) & 255);
        this.buffer[this.position + 5] = (byte)((v >> 16) & 255);
        this.buffer[this.position + 6] = (byte)((v >> 8) & 255);
        this.buffer[this.position + 7] = (byte)(v & 255);
        this.position = this.position + 8;
    }

    // ---- 小端写入 (Little-Endian) ----

    public void WriteInt16LE(int v) {
        this.FlushBits();
        this.EnsureCapacity(2);
        this.buffer[this.position] = (byte)(v & 255);
        this.buffer[this.position + 1] = (byte)((v >> 8) & 255);
        this.position = this.position + 2;
    }

    public void WriteUInt16LE(int v) {
        this.WriteInt16LE(v);
    }

    public void WriteInt32LE(int v) {
        if (this.bitPos < 8 || this.lsbBitPos > 0) { this.FlushBits(); }
        int p = this.position;
        if (this.capacity - p < 4) { this.EnsureCapacity(4); }
        Span<byte> b = new Span<byte>((nint)this.buffer, this.capacity);
        b[p] = (byte)(v & 255);
        b[p + 1] = (byte)((v >> 8) & 255);
        b[p + 2] = (byte)((v >> 16) & 255);
        b[p + 3] = (byte)((v >> 24) & 255);
        this.position = p + 4;
    }

    public void WriteUInt32LE(long v) {
        if (this.bitPos < 8 || this.lsbBitPos > 0) { this.FlushBits(); }
        int p = this.position;
        if (this.capacity - p < 4) { this.EnsureCapacity(4); }
        Span<byte> b = new Span<byte>((nint)this.buffer, this.capacity);
        b[p] = (byte)(v & 255L);
        b[p + 1] = (byte)((v >> 8) & 255L);
        b[p + 2] = (byte)((v >> 16) & 255L);
        b[p + 3] = (byte)((v >> 24) & 255L);
        this.position = p + 4;
    }

    public void WriteInt64LE(long v) {
        if (this.bitPos < 8 || this.lsbBitPos > 0) { this.FlushBits(); }
        int p = this.position;
        if (this.capacity - p < 8) { this.EnsureCapacity(8); }
        Span<byte> b = new Span<byte>((nint)this.buffer, this.capacity);
        b[p] = (byte)(v & 255);
        b[p + 1] = (byte)((v >> 8) & 255);
        b[p + 2] = (byte)((v >> 16) & 255);
        b[p + 3] = (byte)((v >> 24) & 255);
        b[p + 4] = (byte)((v >> 32) & 255);
        b[p + 5] = (byte)((v >> 40) & 255);
        b[p + 6] = (byte)((v >> 48) & 255);
        b[p + 7] = (byte)((v >> 56) & 255);
        this.position = p + 8;
    }

    // ---- 变长整数编码 (Varint / LEB128 / Zigzag) ----

    public void WriteVarint32(int v, bool zigzag) {
        if (this.bitPos < 8 || this.lsbBitPos > 0) { this.FlushBits(); }
        int p = this.position;
        if (this.capacity - p < 5) { this.EnsureCapacity(5); }
        Span<byte> b = new Span<byte>((nint)this.buffer, this.capacity);
        int u = zigzag ? ((v << 1) ^ (v >> 31)) : v;
        while ((u & ~127) != 0) {
            b[p] = (byte)((u & 127) | 128);
            p = p + 1;
            u = (int)((uint)u >> 7);
        }
        b[p] = (byte)(u & 127);
        this.position = p + 1;
    }

    public void WriteVarint64(long v, bool zigzag) {
        if (this.bitPos < 8 || this.lsbBitPos > 0) { this.FlushBits(); }
        int p = this.position;
        if (this.capacity - p < 10) { this.EnsureCapacity(10); }
        Span<byte> b = new Span<byte>((nint)this.buffer, this.capacity);
        long u = zigzag ? ((v << 1) ^ (v >> 63)) : v;
        while ((u & ~127L) != 0L) {
            b[p] = (byte)((int)(u & 127L) | 128);
            p = p + 1;
            u = (long)((ulong)u >> 7);
        }
        b[p] = (byte)(int)(u & 127L);
        this.position = p + 1;
    }

    // ---- 字节与字符串写入 ----

    public void WriteBytes(byte[] data, int offset, int length) {
        if (data == null || length <= 0) { return; }
        if (offset < 0 || offset > data.Length || length > data.Length - offset) {
            throw new ArgumentOutOfRangeException("WriteBytes slice out of bounds.");
        }
        if (this.bitPos < 8 || this.lsbBitPos > 0) { this.FlushBits(); }
        int p = this.position;
        if ((long)p + (long)length > (long)this.capacity) { this.EnsureCapacity(length); }
        NativeMemory.Copy((nint)this.buffer + (nint)p, (nint)data + (nint)offset, length);
        this.position = p + length;
    }

    public void WriteBytes(byte[] data) {
        if (data != null) {
            this.WriteBytes(data, 0, data.Length);
        }
    }

    public void WriteStringUtf8(string s) {
        if (s == null || s.Length == 0) { return; }
        if (this.bitPos < 8 || this.lsbBitPos > 0) { this.FlushBits(); }
        int len = s.Length;
        int p = this.position;
        if ((long)p + (long)len > (long)this.capacity) { this.EnsureCapacity(len); }
        NativeMemory.PutString((nint)this.buffer, p, s, len);
        this.position = p + len;
    }

    // ---- 回填 (Patch) ----

    public void PatchInt32BE(int offset, int v) {
        if (offset >= 0 && offset <= this.position && this.position - offset >= 4) {
            this.buffer[offset] = (byte)((v >> 24) & 255);
            this.buffer[offset + 1] = (byte)((v >> 16) & 255);
            this.buffer[offset + 2] = (byte)((v >> 8) & 255);
            this.buffer[offset + 3] = (byte)(v & 255);
        }
    }

    public void Reset() {
        this.position = 0;
        this.bitMask = 0;
        this.bitPos = 8;
        this.lsbBitMask = 0;
        this.lsbBitPos = 0;
    }

    public byte[] Buffer() {
        return this.buffer;
    }

    public byte[] ToArray() {
        this.FlushBits();
        byte[] result = new byte[this.position];
        if (this.position > 0) {
            NativeMemory.Copy((nint)result, (nint)this.buffer, this.position);
        }
        return result;
    }
}
