using System;

namespace System.Buffers;

// ArrayPool 缓冲区的 RAII 作用域守护持有者。
// 实现了 IDisposable，支持 using (RentedArray rent = pool.RentScoped(sz)) 语法，
// 在退出作用域或发生异常时自动将借出的缓冲区归还给所属缓冲池，彻底杜绝内存泄漏。
public class RentedArray : IDisposable {
    private ArrayPool pool;
    private byte[] array;
    private bool clearOnDispose;
    private bool disposed;

    public RentedArray(ArrayPool pool, byte[] array, bool clearOnDispose) {
        this.pool = pool;
        this.array = array;
        this.clearOnDispose = clearOnDispose;
        this.disposed = false;
    }

    public byte[] Array {
        get { return this.array; }
    }

    public int Length {
        get { return this.array != null ? this.array.Length : 0; }
    }

    public byte ByteAt(int index) {
        if (this.array == null || index < 0 || index >= this.array.Length) {
            throw new IndexOutOfRangeException("RentedArray index out of range");
        }
        return this.array[index];
    }

    public void Dispose() {
        if (!this.disposed) {
            this.disposed = true;
            if (this.pool != null && this.array != null) {
                this.pool.Return(this.array, this.clearOnDispose);
                this.array = null;
                this.pool = null;
            }
        }
    }
}
