using System;

namespace System;

// UTC 时刻，精度为 1 秒，存储为
// Unix 纪元（1970-01-01 00:00:00 UTC）以来的秒数。
// 日历字段由 civil-from-days 算法推导，因此
// 该类完全跨平台，仅需 libc <c>time()</c> 来获取
// 当前时刻。<see cref="UtcNow"/> 返回 UTC；<see cref="Now"/> 返回本机
// 时区的墙钟时间（与 C# System.DateTime.Now 一致）；两者是同一时刻的
// 两种表示，切换用 <see cref="ToLocalTime"/> 或 <see cref="LocalNow"/>。
// 偏移取自 libc 的时区库（<see cref="LocalOffsetMinutesAt"/>），按目标
// 时刻计算，因此跨夏令时边界仍然正确。
public class DateTime {
    [DllImport("crt")]
    public static extern long time(nint ptr);

    #if WINDOWS
    [DllImport("kernel32", EntryPoint = "GetSystemTimeAsFileTime")]
    public static extern void GetSystemTimeAsFileTime(nint lpFileTime);
    #else
    [DllImport("crt", EntryPoint = "clock_gettime")]
    public static extern int clock_gettime(int clkId, nint tp);
    #endif

    // 本机时区换算：localtime_r（POSIX）/ _localtime64_s（Windows）
    // 将纪元秒展开进线程局部 struct tm 缓冲，避免并发冲突。
    // 再用 timegm / _mkgmtime 将其当作 UTC 折回纪元秒，两者的差值
    // 即为该时刻的实际本地偏移（包含夏令时）。
    #if WINDOWS
    [DllImport("crt", EntryPoint = "_localtime64_s")]
    public static extern int plat_localtime(nint tmOut, nint tptr);
    [DllImport("crt", EntryPoint = "_mkgmtime")]
    public static extern long plat_timegm(nint tm);
    #else
    [DllImport("crt", EntryPoint = "localtime_r")]
    public static extern nint plat_localtime(nint tptr, nint tmOut);
    [DllImport("crt", EntryPoint = "timegm")]
    public static extern long plat_timegm(nint tm);
    #endif

    // 自 1970-01-01T00:00:00Z 以来的毫秒数。
    public long epochMs;
    // 自 1970-01-01T00:00:00Z 以来的秒数。
    public long epoch;
    // 年。
    public int year;
    // 月，1..12。
    public int month;
    // 日，1..31。
    public int day;
    // 时，0..23。
    public int hour;
    // 分，0..59。
    public int minute;
    // 秒，0..59。
    public int second;
    // 毫秒，0..999。
    public int millisecond;
    // 星期几，0=星期日 .. 6=星期六。
    public int dayOfWeek;

    // 内部精确获取当前系统 Unix 纪元毫秒。
    public static long GetCurrentUnixMilliseconds() {
        #if WINDOWS
        nint p = NativeMemory.Alloc(8);
        long ft = 0;
        try {
            GetSystemTimeAsFileTime(p);
            ft = new Span<long>(p, 1)[0];
        } finally {
            NativeMemory.Free(p);
        }
        // 100ns 刻度折算为毫秒，减去 1601 到 1970 偏移 (11644473600000 ms)
        return (ft / 10000) - 11644473600000;
        #else
        nint ts = NativeMemory.Alloc(16);
        long ms = 0;
        try {
            // CLOCK_REALTIME = 0 on POSIX
            int r = clock_gettime(0, ts);
            if (r == 0) {
                long sec = new Span<long>(ts, 1)[0];
                long nsec = new Span<long>(ts + 8, 1)[0];
                ms = sec * 1000 + (nsec / 1000000);
            } else {
                ms = time(0) * 1000;
            }
        } finally {
            NativeMemory.Free(ts);
        }
        return ms;
        #endif
    }

    // 根据 Unix 时间戳（秒，UTC）构造时刻（毫秒置 0）。
    public DateTime(long unixSeconds) : this(unixSeconds * 1000, 0) {}

    // 根据 Unix 时间戳（毫秒，UTC）构造时刻。
    public DateTime(long unixMs, int dummy) {
        epochMs = unixMs;
        epoch = unixMs / 1000;

        long totalSeconds = FloorDivL(unixMs, 1000);
        int remMs = (int)(unixMs - totalSeconds * 1000);
        if (remMs < 0) { remMs = remMs + 1000; }
        millisecond = remMs;

        int days = (int)FloorDivL(totalSeconds, 86400);
        int sod = (int)(totalSeconds - (long)days * 86400);  // 0..86399
        hour = sod / 3600;
        minute = (sod / 60) - hour * 60;
        second = sod - hour * 3600 - minute * 60;
        dayOfWeek = FloorMod(days + 4, 7);  // 1970-01-01 是星期四

        // 从天数推算公历日期（Howard Hinnant 算法）。era 必须向下
        // 取整：z 为负（纪元前约 1970 年以前，如 proleptic 0000 年）
        // 时截断除法会让 doe 变负、整个日历崩溃。
        int z = days + 719468;
        int era = FloorDiv(z, 146097);
        int doe = z - era * 146097;  // 0..146096
        int yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
        int y = yoe + era * 400;
        int doy = doe - (365 * yoe + yoe / 4 - yoe / 100);  // 0..365
        int mp = (5 * doy + 2) / 153;  // 0..11
        int d = doy - (153 * mp + 2) / 5 + 1;  // 1..31
        int m = mp + 3;
        if (mp >= 10) { m = mp - 9; }
        if (m <= 2) { y = y + 1; }

        year = y;
        month = m;
        day = d;
    }

    // ---- 构造 -------------------------------------------------------

    // 当前时刻（UTC，毫秒精度）。
    public static DateTime UtcNow() {
        return DateTime.FromUnixMilliseconds(GetCurrentUnixMilliseconds());
    }

    // 当前本地墙钟时间：与 <see cref="UtcNow"/> 是同一时刻，但年月日时分秒
    // 按本机时区读数（等价于 <c>UtcNow().ToLocalTime()</c>，与 C# 的
    // <c>DateTime.Now</c> 语义一致）。偏移按当前时刻计算，夏令时生效期间
    // 自动采用夏令时偏移。注意它的 <see cref="ToUnixSeconds"/> 已被偏移，
    // 不再是纪元秒；需要 UTC 时间戳请用 <see cref="UtcNow"/>。
    public static DateTime Now() {
        return DateTime.LocalNow();
    }

    // ---- 本机时区 ---------------------------------------------------

    // 本机时区在 <paramref name="unixSeconds"/> 这一时刻相对 UTC 的偏移
    // （分钟，东为正，如东八区 480），含该时刻是否处于夏令时。
    // 时区信息不可用时返回 0（等同 UTC）。
    // 平台能力集中在 <c>plat_localtime</c>/<c>plat_timegm</c> 两处
    // DllImport（Windows 的 _localtime64_s/_mkgmtime、POSIX 的
    // localtime_r/timegm），时区数据由操作系统提供（Windows 注册表 /
    // POSIX 的 TZ 与 /usr/share/zoneinfo）；本类不内置 IANA 时区库。
    public static int LocalOffsetMinutesAt(long unixSeconds) {
        nint tbuf = NativeMemory.Alloc(8);
        nint tm = 0;
        bool ok = false;
        try {
            new Span<long>(tbuf, 1)[0] = unixSeconds;
            // struct tm 布局平台各异（glibc/Darwin 56 字节、MSVC 36 字节），
            // 给 128 字节清零缓冲；读端只经 plat_timegm（libc 自己解释布局）。
            tm = NativeMemory.Alloc(128);
            NativeMemory.Fill(tm, 0, 128);
            #if WINDOWS
            ok = plat_localtime(tm, tbuf) == 0;
            #else
            ok = plat_localtime(tbuf, tm) != 0;
            #endif
        } finally {
            NativeMemory.Free(tbuf);
        }

        if (!ok || tm == 0) {
            if (tm != 0) { NativeMemory.Free(tm); }
            return 0;
        }

        long wall = 0;
        try {
            wall = plat_timegm(tm);
        } finally {
            NativeMemory.Free(tm);
        }

        if (wall == 0 - 1) { return 0; }
        return (int)((wall - unixSeconds) / 60);
    }

    // 本机时区当前相对 UTC 的偏移（分钟，东为正）。
    public static int LocalOffsetMinutes() {
        return LocalOffsetMinutesAt(time(0));
    }

    // 同一时刻的本地墙钟表示：年月日时分秒都是本机时区读数。
    // 注意它的 <see cref="ToUnixSeconds"/> 已被偏移，不再是纪元秒；
    // 需要纪元秒请用原来的 UTC 时刻。
    public DateTime ToLocalTime() {
        return new DateTime(epoch
            + (long)DateTime.LocalOffsetMinutesAt(epoch) * 60);
    }

    // 将本机墙钟时间（例如 <see cref="Now"/>）转回 UTC 时刻。
    public DateTime ToUniversalTime() {
        return new DateTime(epoch
            - (long)DateTime.LocalOffsetMinutesAt(epoch) * 60);
    }

    // 本机时区的当前墙钟时间（见 <see cref="ToLocalTime"/>）；
    // 与 <see cref="Now"/> 等价，保留给按“本地”语义书写的调用方。
    public static DateTime LocalNow() {
        return DateTime.UtcNow().ToLocalTime();
    }

    // 根据 Unix 时间戳（自纪元起的秒数）构造时刻。
    public static DateTime FromUnixSeconds(long seconds) {
        return new DateTime(seconds);
    }

    // 根据 Unix 时间戳（自纪元起的毫秒数）构造时刻。
    public static DateTime FromUnixMilliseconds(long milliseconds) {
        return new DateTime(milliseconds, 0);
    }

    // 给定日历日期当天的 UTC 午夜零点。
    public static DateTime FromDate(int year, int month, int day) {
        return new DateTime((long)DaysFromCivil(year, month, day) * 86400);
    }

    // 给定的日历日期和墙上时钟时间，按 UTC 处理。
    public static DateTime FromParts(int year, int month, int day,
                              int hour, int minute, int second) {
        return new DateTime((long)DaysFromCivil(year, month, day) * 86400
                            + (long)hour * 3600 + (long)minute * 60 + second);
    }

    // 公历日期到 Unix 纪元的天数——与构造器所用的
    // civil-from-days 算法互为逆运算。
    // 1970 年之前的日期为负。
    public static int DaysFromCivil(int year, int month, int day) {
        int y = year;
        if (month <= 2) { y = y - 1; }
        int era = FloorDiv(y, 400);
        int yoe = y - era * 400;  // 0..399
        int mp = month - 3;  // 以 3 月为基准的月份
        if (month <= 2) { mp = month + 9; }
        int doy = (153 * mp + 2) / 5 + day - 1;  // 0..365
        int doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;  // 0..146096
        return era * 146097 + doe - 719468;
    }

    // <see cref="DaysFromCivil"/> 的逆运算：把 Unix 纪元天序换算回公历年月日。
    // 结果按 <paramref name="year"/>/<paramref name="month"/>/<paramref name="day"/>
    // 三个 out 参数返回（1970 年之前的天序为负，同样成立）。
    public static void CivilFromDays(int days, out int year, out int month, out int day) {
        int z = days + 719468;
        int era = FloorDiv(z, 146097);  // floor：z 可为负
        int doe = z - era * 146097;  // 0..146096
        int yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
        int y = yoe + era * 400;
        int doy = doe - (365 * yoe + yoe / 4 - yoe / 100);  // 0..365
        int mp = (5 * doy + 2) / 153;  // 0..11
        int d = doy - (153 * mp + 2) / 5 + 1;  // 1..31
        int m = mp + 3;
        if (mp >= 10) { m = mp - 9; }
        if (m <= 2) { y = y + 1; }
        year = y;
        month = m;
        day = d;
    }

    // <paramref name="year"/> 年 <paramref name="month"/> 月的天数。
    public static int DaysInMonth(int year, int month) {
        if (month < 1 || month > 12) { return 0; }
        if (month == 2) {
            if (IsLeapYear(year)) { return 29; }
            return 28;
        }
        if (month == 4 || month == 6 || month == 9 || month == 11) { return 30; }
        return 31;
    }

    // <paramref name="year"/> 是否为公历闰年。
    public static bool IsLeapYear(int year) {
        if (FloorMod(year, 4) != 0) { return false; }
        if (FloorMod(year, 100) != 0) { return true; }
        return FloorMod(year, 400) == 0;
    }

    // ---- 访问器 -------------------------------------------------------

    // 年。
    public int Year() { return year; }
    // 月（1..12）。
    public int Month() { return month; }
    // 日（1..31）。
    public int Day() { return day; }
    // 时（0..23）。
    public int Hour() { return hour; }
    // 分（0..59）。
    public int Minute() { return minute; }
    // 秒（0..59）。
    public int Second() { return second; }

    // 星期几，0=星期日 .. 6=星期六。
    public int DayOfWeek() { return dayOfWeek; }

    // 毫秒（0..999）。
    public int Millisecond() { return millisecond; }

    // Unix 纪元以来的秒数（UTC）。
    public long ToUnixSeconds() { return epoch; }

    // Unix 纪元以来的毫秒数（UTC）。
    public long ToUnixMilliseconds() { return epochMs; }

    // ---- 算术 -------------------------------------------------------

    // 加 n 毫秒。
    public DateTime AddMilliseconds(long ms) { return DateTime.FromUnixMilliseconds(epochMs + ms); }
    // 加 n 秒。
    public DateTime AddSeconds(long n) { return DateTime.FromUnixMilliseconds(epochMs + n * 1000); }
    // 加 n 分钟。
    public DateTime AddMinutes(long n) { return DateTime.FromUnixMilliseconds(epochMs + n * 60000); }
    // 加 n 小时。
    public DateTime AddHours(long n) { return DateTime.FromUnixMilliseconds(epochMs + n * 3600000); }
    // 加 n 天。
    public DateTime AddDays(long n) { return DateTime.FromUnixMilliseconds(epochMs + n * 86400000); }

    // 此时刻与 <paramref name="other"/> 之间的间隔（毫秒精度）。
    public TimeSpan Subtract(DateTime other) {
        return TimeSpan.FromMilliseconds(epochMs - other.epochMs);
    }

    // ---- 比较 -------------------------------------------------------

    // 同一时刻（纪元毫秒相等）。
    public bool Equals(DateTime other) { return epochMs == other.epochMs; }
    // 早于 other。
    public bool IsBefore(DateTime other) { return epochMs < other.epochMs; }
    // 晚于 other。
    public bool IsAfter(DateTime other) { return epochMs > other.epochMs; }

    // ---- 格式化 -------------------------------------------------------

    // 类 ISO 文本："YYYY-MM-DD HH:MM:SS"。
    public string ToString() {
        return "" + year + "-" + Pad2(month) + "-" + Pad2(day) + " " +
               Pad2(hour) + ":" + Pad2(minute) + ":" + Pad2(second);
    }

    // 带毫秒的类 ISO 文本："YYYY-MM-DD HH:MM:SS.fff"。
    public string ToStringWithMillis() {
        string msStr = Convert.ToString(millisecond);
        if (millisecond < 10) { msStr = "00" + msStr; }
        else if (millisecond < 100) { msStr = "0" + msStr; }
        return this.ToString() + "." + msStr;
    }

    // 仅日期："YYYY-MM-DD"。
    public string ToDateString() {
        return "" + year + "-" + Pad2(month) + "-" + Pad2(day);
    }

    // 仅时间："HH:MM:SS"。
    public string ToTimeString() {
        return Pad2(hour) + ":" + Pad2(minute) + ":" + Pad2(second);
    }

    // 解析严格的 "YYYY-MM-DD" 为当天 00:00:00；长度、分隔符或
    // 取值非法（月 1..12、日不超过当月天数）返回 null。年份须
    // 四位数字，供文本输入与属性面板回传使用。
    public static DateTime ParseDate(string value) {
        if (value == null) { return null; }
        if (value.Length != 10) { return null; }
        if ((value[4] & 255) != 45 || (value[7] & 255) != 45) {  // '-'
            return null;
        }
        int y = DateTime.ParseDigits(value, 0, 4);
        int m = DateTime.ParseDigits(value, 5, 2);
        int d = DateTime.ParseDigits(value, 8, 2);
        if (y < 1 || m < 1 || m > 12 || d < 1 ||
            d > DateTime.DaysInMonth(y, m)) { return null; }
        return DateTime.FromDate(y, m, d);
    }

    // 解析 ISO-8601 日时刻为 UTC 时刻。接受 "YYYY-MM-DD"（当天零点）、
    // "YYYY-MM-DDTHH:MM[:SS][.f{1,3}]"（T 亦可为小写 t 或空格）、
    // 尾缀 "Z"/"z" 或 "+HH:MM"/"-HH:MM"/"+HHMM" 偏移。无时区后缀按
    // UTC（C# Unspecified 的取值语义，本库无 Kind 概念，统一 UTC 最
    // 可测）；偏移按含义换算进时刻（+08:00 表示本地比 UTC 快 8 小时，
    // 从时刻里减掉）。毫秒超 3 位截断到毫秒。成功写 result 并返回
    // true；任何形态/取值非法（月日、闰年、时 0..23、分秒 0..59、
    // 偏移 0..23:59、尾随字符）返回 false 且 result=null。
    public static bool TryParse(string s, out DateTime result) {
        result = null;
        if (s == null || s.Length < 10) { return false; }
        if ((s[4] & 255) != 45 || (s[7] & 255) != 45) { return false; }  // '-'
        int y = DateTime.ParseDigits(s, 0, 4);
        int mo = DateTime.ParseDigits(s, 5, 2);
        int d = DateTime.ParseDigits(s, 8, 2);
        if (y < 1 || mo < 1 || mo > 12 || d < 1 ||
            d > DateTime.DaysInMonth(y, mo)) { return false; }
        long secs = (long)DateTime.DaysFromCivil(y, mo, d) * 86400;
        int i = 10;
        if (i >= s.Length) {
            result = DateTime.FromUnixMilliseconds(secs * 1000);
            return true;
        }
        int sep = s[i] & 255;
        if (sep != 84 && sep != 116 && sep != 32) { return false; }  // 'T'/'t'/' '
        i = i + 1;
        int h = DateTime.ParseDigits(s, i, 2);
        if (h < 0 || h > 23) { return false; }
        if ((s[i + 2] & 255) != 58) { return false; }  // ':'
        int mi = DateTime.ParseDigits(s, i + 3, 2);
        if (mi < 0 || mi > 59) { return false; }
        i = i + 5;
        int sec = 0;
        int ms = 0;
        if (i < s.Length && (s[i] & 255) == 58) {  // ':SS'
            sec = DateTime.ParseDigits(s, i + 1, 2);
            if (sec < 0 || sec > 59) { return false; }
            i = i + 3;
            if (i < s.Length && (s[i] & 255) == 46) {  // '.' + 小数毫秒
                i = i + 1;
                int fd = 0;
                long fval = 0;
                while (i < s.Length) {
                    int c = s[i] & 255;
                    if (c < 48 || c > 57) { break; }
                    if (fd < 3) { fval = fval * 10 + (c - 48); }
                    fd = fd + 1;
                    i = i + 1;
                }
                if (fd == 0) { return false; }
                if (fd == 1) { ms = (int)(fval * 100); }
                else if (fd == 2) { ms = (int)(fval * 10); }
                else { ms = (int)fval; }
            }
        }
        secs = secs + h * 3600 + mi * 60 + sec;
        if (i < s.Length) {  // 时区后缀
            int c = s[i] & 255;
            i = i + 1;
            if (c == 90 || c == 122) {  // 'Z'/'z'：UTC，无偏移
            } else if (c == 43 || c == 45) {  // '+'/'-'
                int sign = c == 43 ? 1 : -1;
                int oh = DateTime.ParseDigits(s, i, 2);
                if (oh < 0 || oh > 23) { return false; }
                i = i + 2;
                int om = 0;
                if (i < s.Length && (s[i] & 255) == 58) {  // ':mm'
                    om = DateTime.ParseDigits(s, i + 1, 2);
                    if (om < 0 || om > 59) { return false; }
                    i = i + 3;
                } else if (i < s.Length) {  // 紧凑 mm
                    om = DateTime.ParseDigits(s, i, 2);
                    if (om < 0 || om > 59) { return false; }
                    i = i + 2;
                }
                secs = secs - sign * (oh * 3600 + om * 60);
            } else {
                return false;
            }
        }
        if (i != s.Length) { return false; }
        result = DateTime.FromUnixMilliseconds(secs * 1000 + ms);
        return true;
    }

    // 解析 ISO-8601 日时刻（口径同 <see cref="TryParse"/>）；非法
    // 抛 FormatException（C# DateTime.Parse 同约定，容错入口用
    // TryParse）。
    public static DateTime Parse(string s) {
        DateTime r;
        if (!DateTime.TryParse(s, out r)) {
            throw new FormatException("The string was not recognized as a valid DateTime.");
        }
        return r;
    }

    // 解析 `at` 起 `count` 位十进制数字；含非数字返回 -1。
    public static int ParseDigits(string s, int at, int count) {
        if (s == null || at < 0 || at + count > s.Length) { return -1; }
        int outp = 0;
        for (int i = 0; i < count; i = i + 1) {
            int c = s[at + i] & 255;
            if (c < 48 || c > 57) { return -1; }
            outp = outp * 10 + (c - 48);
        }
        return outp;
    }

    // 十进制数字字符的值，非数字返回 -1。
    public static int Digit(string c) {
        if (c == "0") { return 0; }
        if (c == "1") { return 1; }
        if (c == "2") { return 2; }
        if (c == "3") { return 3; }
        if (c == "4") { return 4; }
        if (c == "5") { return 5; }
        if (c == "6") { return 6; }
        if (c == "7") { return 7; }
        if (c == "8") { return 8; }
        if (c == "9") { return 9; }
        return -1;
    }

    // ---- 共享整数辅助函数 -------------------------------------------

    // 将 0..99 的值补零到两位。
    public static string Pad2(long n) {
        if (n < 10 && n >= 0) { return "0" + n; }
        return "" + n;
    }

    // 对 64 位秒数做向下取整的整数除法。
    public static long FloorDivL(long a, long b) {
        long q = a / b;
        long r = a - q * b;
        if (r != 0 && ((r < 0) != (b < 0))) { q = q - 1; }
        return q;
    }

    // 向下取整的整数除法（向负无穷取整）。
    public static int FloorDiv(int a, int b) {
        int q = a / b;
        int r = a - q * b;
        if (r != 0 && ((r < 0) != (b < 0))) { q = q - 1; }
        return q;
    }

    // 向下取整的模运算；结果符号与除数一致。
    public static int FloorMod(int a, int b) {
        return a - FloorDiv(a, b) * b;
    }
}
