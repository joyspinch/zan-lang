using System;

namespace System;

/// <summary>
/// UTC 时刻，精度为 1 秒，存储为
/// Unix 纪元（1970-01-01 00:00:00 UTC）以来的秒数。
///
/// 日历字段由 civil-from-days 算法推导，因此
/// 该类完全跨平台，仅需 libc <c>time()</c> 来获取
/// 当前时刻。不进行本地时区转换：<see cref="Now"/>
/// 与 <see cref="UtcNow"/> 都返回 UTC。
/// </summary>
class DateTime {
    [DllImport("crt")]
    static extern long time(nint ptr);

    long epoch;     // 自 1970-01-01T00:00:00Z 以来的秒数
    int year;
    int month;      // 1..12
    int day;        // 1..31
    int hour;       // 0..23
    int minute;     // 0..59
    int second;     // 0..59
    int dayOfWeek;  // 0=星期日 .. 6=星期六

    /// <summary>根据 Unix 时间戳（秒，UTC）构造时刻。</summary>
    DateTime(long unixSeconds) {
        epoch = unixSeconds;

        int days = (int)FloorDivL(unixSeconds, 86400);
        int sod = (int)(unixSeconds - (long)days * 86400);   // 0..86399
        hour = sod / 3600;
        minute = (sod / 60) - hour * 60;
        second = sod - hour * 3600 - minute * 60;
        dayOfWeek = FloorMod(days + 4, 7);       // 1970-01-01 是星期四

        // 从天数推算公历日期（Howard Hinnant 算法）。
        int z = days + 719468;
        int era = z / 146097;
        int doe = z - era * 146097;                          // 0..146096
        int yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
        int y = yoe + era * 400;
        int doy = doe - (365 * yoe + yoe / 4 - yoe / 100);   // 0..365
        int mp = (5 * doy + 2) / 153;                        // 0..11
        int d = doy - (153 * mp + 2) / 5 + 1;                // 1..31
        int m = mp + 3;
        if (mp >= 10) { m = mp - 9; }
        if (m <= 2) { y = y + 1; }

        year = y;
        month = m;
        day = d;
    }

    // ---- 构造 -------------------------------------------------------

    /// <summary>当前时刻（UTC）。</summary>
    static DateTime UtcNow() {
        return new DateTime(time(0));
    }

    /// <summary><see cref="UtcNow"/> 的别名；不应用本地时区偏移。</summary>
    static DateTime Now() {
        return new DateTime(time(0));
    }

    /// <summary>根据 Unix 时间戳（自纪元起的秒数）构造时刻。</summary>
    static DateTime FromUnixSeconds(long seconds) {
        return new DateTime(seconds);
    }

    /// <summary>给定日历日期当天的 UTC 午夜零点。</summary>
    static DateTime FromDate(int year, int month, int day) {
        return new DateTime(DaysFromCivil(year, month, day) * 86400);
    }

    /// <summary>给定的日历日期和墙上时钟时间，按 UTC 处理。</summary>
    static DateTime FromParts(int year, int month, int day,
                              int hour, int minute, int second) {
        return new DateTime(DaysFromCivil(year, month, day) * 86400
                            + hour * 3600 + minute * 60 + second);
    }

    /// <summary>
    /// 公历日期到 Unix 纪元的天数——与构造器所用的
    /// civil-from-days 算法互为逆运算。
    /// 1970 年之前的日期为负。
    /// </summary>
    static int DaysFromCivil(int year, int month, int day) {
        int y = year;
        if (month <= 2) { y = y - 1; }
        int era = FloorDiv(y, 400);
        int yoe = y - era * 400;                             // 0..399
        int mp = month - 3;                                  // 以 3 月为基准的月份
        if (month <= 2) { mp = month + 9; }
        int doy = (153 * mp + 2) / 5 + day - 1;              // 0..365
        int doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;     // 0..146096
        return era * 146097 + doe - 719468;
    }

    /// <summary><paramref name="year"/> 年 <paramref name="month"/> 月的天数。</summary>
    static int DaysInMonth(int year, int month) {
        if (month < 1 || month > 12) { return 0; }
        if (month == 2) {
            if (IsLeapYear(year)) { return 29; }
            return 28;
        }
        if (month == 4 || month == 6 || month == 9 || month == 11) { return 30; }
        return 31;
    }

    /// <summary><paramref name="year"/> 是否为公历闰年。</summary>
    static bool IsLeapYear(int year) {
        if (FloorMod(year, 4) != 0) { return false; }
        if (FloorMod(year, 100) != 0) { return true; }
        return FloorMod(year, 400) == 0;
    }

    // ---- 访问器 -------------------------------------------------------

    int Year() { return year; }
    int Month() { return month; }
    int Day() { return day; }
    int Hour() { return hour; }
    int Minute() { return minute; }
    int Second() { return second; }

    /// <summary>星期几，0=星期日 .. 6=星期六。</summary>
    int DayOfWeek() { return dayOfWeek; }

    /// <summary>Unix 纪元以来的秒数（UTC）。</summary>
    long ToUnixSeconds() { return epoch; }

    // ---- 算术 -------------------------------------------------------

    DateTime AddSeconds(long n) { return new DateTime(epoch + n); }
    DateTime AddMinutes(long n) { return new DateTime(epoch + n * 60); }
    DateTime AddHours(long n) { return new DateTime(epoch + n * 3600); }
    DateTime AddDays(long n) { return new DateTime(epoch + n * 86400); }

    /// <summary>此时刻与 <paramref name="other"/> 之间的间隔。</summary>
    TimeSpan Subtract(DateTime other) {
        return new TimeSpan(epoch - other.epoch);
    }

    // ---- 比较 -------------------------------------------------------

    bool Equals(DateTime other) { return epoch == other.epoch; }
    bool IsBefore(DateTime other) { return epoch < other.epoch; }
    bool IsAfter(DateTime other) { return epoch > other.epoch; }

    // ---- 格式化 -------------------------------------------------------

    /// <summary>类 ISO 文本："YYYY-MM-DD HH:MM:SS"。</summary>
    string ToString() {
        return "" + year + "-" + Pad2(month) + "-" + Pad2(day) + " " +
               Pad2(hour) + ":" + Pad2(minute) + ":" + Pad2(second);
    }

    /// <summary>仅日期："YYYY-MM-DD"。</summary>
    string ToDateString() {
        return "" + year + "-" + Pad2(month) + "-" + Pad2(day);
    }

    /// <summary>仅时间："HH:MM:SS"。</summary>
    string ToTimeString() {
        return Pad2(hour) + ":" + Pad2(minute) + ":" + Pad2(second);
    }

    // ---- 共享整数辅助函数 -------------------------------------------

    /// <summary>将 0..99 的值补零到两位。</summary>
    static string Pad2(long n) {
        if (n < 10 && n >= 0) { return "0" + n; }
        return "" + n;
    }

    /// <summary>对 64 位秒数做向下取整的整数除法。</summary>
    static long FloorDivL(long a, long b) {
        long q = a / b;
        long r = a - q * b;
        if (r != 0 && ((r < 0) != (b < 0))) { q = q - 1; }
        return q;
    }

    /// <summary>向下取整的整数除法（向负无穷取整）。</summary>
    static int FloorDiv(int a, int b) {
        int q = a / b;
        int r = a - q * b;
        if (r != 0 && ((r < 0) != (b < 0))) { q = q - 1; }
        return q;
    }

    /// <summary>向下取整的模运算；结果符号与除数一致。</summary>
    static int FloorMod(int a, int b) {
        return a - FloorDiv(a, b) * b;
    }
}
