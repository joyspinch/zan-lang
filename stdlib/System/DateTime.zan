using System;

namespace System;

/// <summary>
/// A UTC instant with a one-second resolution, stored as the number of
/// seconds since the Unix epoch (1970-01-01 00:00:00 UTC).
///
/// Calendar fields are derived with the civil-from-days algorithm, so the
/// class is fully cross-platform and needs only libc <c>time()</c> for the
/// current instant. Local-timezone conversion is not applied: <see cref="Now"/>
/// and <see cref="UtcNow"/> both return UTC.
/// </summary>
class DateTime {
    [DllImport("crt")]
    static extern long time(nint ptr);

    long epoch;     // seconds since 1970-01-01T00:00:00Z
    int year;
    int month;      // 1..12
    int day;        // 1..31
    int hour;       // 0..23
    int minute;     // 0..59
    int second;     // 0..59
    int dayOfWeek;  // 0=Sunday .. 6=Saturday

    /// <summary>Constructs an instant from a Unix timestamp (seconds, UTC).</summary>
    DateTime(long unixSeconds) {
        epoch = unixSeconds;

        int days = (int)FloorDivL(unixSeconds, 86400);
        int sod = (int)(unixSeconds - (long)days * 86400);   // 0..86399
        hour = sod / 3600;
        minute = (sod / 60) - hour * 60;
        second = sod - hour * 3600 - minute * 60;
        dayOfWeek = FloorMod(days + 4, 7);       // 1970-01-01 was a Thursday

        // Civil calendar from day number (Howard Hinnant's algorithm).
        int z = days + 719468;
        int era = z / 146097;
        int doe = z - era * 146097;                          // 0..146096
        int yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
        int y = yoe + era * 400;
        int doy = doe - (365 * yoe + yoe / 4 - yoe / 100);   // 0..365
        int mp = (5 * doy + 2) / 153;                        // 0..11
        int d = doy - (153 * mp + 2) / 5 + 1;                // 1..31
        int m = mp + 3;
        if (mp >= 10) { m = mp - 9; }
        if (m <= 2) { y = y + 1; }

        year = y;
        month = m;
        day = d;
    }

    // ---- construction ----------------------------------------------------

    /// <summary>The current instant (UTC).</summary>
    static DateTime UtcNow() {
        return new DateTime(time(0));
    }

    /// <summary>Alias of <see cref="UtcNow"/>; no local-timezone offset is applied.</summary>
    static DateTime Now() {
        return new DateTime(time(0));
    }

    /// <summary>Builds an instant from a Unix timestamp (seconds since epoch).</summary>
    static DateTime FromUnixSeconds(long seconds) {
        return new DateTime(seconds);
    }

    /// <summary>Midnight UTC on the given calendar date.</summary>
    static DateTime FromDate(int year, int month, int day) {
        return new DateTime(DaysFromCivil(year, month, day) * 86400);
    }

    /// <summary>The given calendar date and wall-clock time, as UTC.</summary>
    static DateTime FromParts(int year, int month, int day,
                              int hour, int minute, int second) {
        return new DateTime(DaysFromCivil(year, month, day) * 86400
                            + hour * 3600 + minute * 60 + second);
    }

    /// <summary>
    /// Days since the Unix epoch for a proleptic-Gregorian date — the inverse
    /// of the civil-from-days algorithm the constructor uses. Negative for
    /// dates before 1970.
    /// </summary>
    static int DaysFromCivil(int year, int month, int day) {
        int y = year;
        if (month <= 2) { y = y - 1; }
        int era = FloorDiv(y, 400);
        int yoe = y - era * 400;                             // 0..399
        int mp = month - 3;                                  // March-based month
        if (month <= 2) { mp = month + 9; }
        int doy = (153 * mp + 2) / 5 + day - 1;              // 0..365
        int doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;     // 0..146096
        return era * 146097 + doe - 719468;
    }

    /// <summary>Days in <paramref name="month"/> of <paramref name="year"/>.</summary>
    static int DaysInMonth(int year, int month) {
        if (month < 1 || month > 12) { return 0; }
        if (month == 2) {
            if (IsLeapYear(year)) { return 29; }
            return 28;
        }
        if (month == 4 || month == 6 || month == 9 || month == 11) { return 30; }
        return 31;
    }

    /// <summary>Whether <paramref name="year"/> is a Gregorian leap year.</summary>
    static bool IsLeapYear(int year) {
        if (FloorMod(year, 4) != 0) { return false; }
        if (FloorMod(year, 100) != 0) { return true; }
        return FloorMod(year, 400) == 0;
    }

    // ---- accessors -------------------------------------------------------

    int Year() { return year; }
    int Month() { return month; }
    int Day() { return day; }
    int Hour() { return hour; }
    int Minute() { return minute; }
    int Second() { return second; }

    /// <summary>Day of week, 0=Sunday .. 6=Saturday.</summary>
    int DayOfWeek() { return dayOfWeek; }

    /// <summary>Seconds since the Unix epoch (UTC).</summary>
    long ToUnixSeconds() { return epoch; }

    // ---- arithmetic ------------------------------------------------------

    DateTime AddSeconds(long n) { return new DateTime(epoch + n); }
    DateTime AddMinutes(long n) { return new DateTime(epoch + n * 60); }
    DateTime AddHours(long n) { return new DateTime(epoch + n * 3600); }
    DateTime AddDays(long n) { return new DateTime(epoch + n * 86400); }

    /// <summary>The interval between this instant and <paramref name="other"/>.</summary>
    TimeSpan Subtract(DateTime other) {
        return new TimeSpan(epoch - other.epoch);
    }

    // ---- comparison ------------------------------------------------------

    bool Equals(DateTime other) { return epoch == other.epoch; }
    bool IsBefore(DateTime other) { return epoch < other.epoch; }
    bool IsAfter(DateTime other) { return epoch > other.epoch; }

    // ---- formatting ------------------------------------------------------

    /// <summary>ISO-like text: "YYYY-MM-DD HH:MM:SS".</summary>
    string ToString() {
        return "" + year + "-" + Pad2(month) + "-" + Pad2(day) + " " +
               Pad2(hour) + ":" + Pad2(minute) + ":" + Pad2(second);
    }

    /// <summary>Date only: "YYYY-MM-DD".</summary>
    string ToDateString() {
        return "" + year + "-" + Pad2(month) + "-" + Pad2(day);
    }

    /// <summary>Time only: "HH:MM:SS".</summary>
    string ToTimeString() {
        return Pad2(hour) + ":" + Pad2(minute) + ":" + Pad2(second);
    }

    // ---- shared integer helpers -----------------------------------------

    /// <summary>Zero-pads a value in 0..99 to two digits.</summary>
    static string Pad2(long n) {
        if (n < 10 && n >= 0) { return "0" + n; }
        return "" + n;
    }

    /// <summary>Floored integer division over 64-bit seconds.</summary>
    static long FloorDivL(long a, long b) {
        long q = a / b;
        long r = a - q * b;
        if (r != 0 && ((r < 0) != (b < 0))) { q = q - 1; }
        return q;
    }

    /// <summary>Floored integer division (rounds toward negative infinity).</summary>
    static int FloorDiv(int a, int b) {
        int q = a / b;
        int r = a - q * b;
        if (r != 0 && ((r < 0) != (b < 0))) { q = q - 1; }
        return q;
    }

    /// <summary>Floored modulo; result has the sign of the divisor.</summary>
    static int FloorMod(int a, int b) {
        return a - FloorDiv(a, b) * b;
    }
}
