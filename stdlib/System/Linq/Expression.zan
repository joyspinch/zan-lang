using System;

namespace System.Linq;

/// <summary>
/// A node of an inspectable expression tree. When a lambda is passed to a
/// method whose parameter is declared <c>Expr&lt;T&gt;</c>, the compiler
/// (dbgen pass) lowers it into <c>ExprNode</c> construction code instead of a
/// delegate, so pure-Zan code can walk the tree at runtime — the foundation
/// for ORM query building, LINQ-to-objects evaluation, validation rules and
/// permission expressions.
///
/// Node kinds:
///   0 = member access (Name = field name)
///   1 = constant     (IVal / DVal / SVal / BVal, whichever matches)
///   2 = binary op    (Name = "==","!=","&lt;","&gt;","&lt;=","&gt;=","+","-","*","/","%","&amp;&amp;","||"; A,B operands)
///   3 = call         (Name = method name; A = receiver tree, null when the
///                    lambda parameter itself is the receiver; B = argument)
///   4 = lambda       (Name = parameter name; A = body)
///   5 = not          (A = operand)
/// </summary>
class ExprNode {
    public int Kind;
    public string Name;
    public ExprNode A;
    public ExprNode B;
    /// <summary>Constant payload type: 0 = int, 1 = double, 2 = string, 3 = bool.</summary>
    public int TVal;
    public int IVal;
    public double DVal;
    public string SVal;
    public bool BVal;

    public ExprNode() {
        Kind = 0;
        Name = "";
        A = null;
        B = null;
        TVal = 0;
        IVal = 0;
        DVal = 0.0;
        SVal = null;
        BVal = false;
    }

    static ExprNode Member(string n) {
        ExprNode e = new ExprNode();
        e.Kind = 0;
        e.Name = n;
        return e;
    }

    static ExprNode Const(int v) {
        ExprNode e = new ExprNode();
        e.Kind = 1;
        e.TVal = 0;
        e.IVal = v;
        return e;
    }

    static ExprNode Const(double v) {
        ExprNode e = new ExprNode();
        e.Kind = 1;
        e.TVal = 1;
        e.DVal = v;
        return e;
    }

    static ExprNode Const(string s) {
        ExprNode e = new ExprNode();
        e.Kind = 1;
        e.TVal = 2;
        e.SVal = s;
        return e;
    }

    static ExprNode Const(bool v) {
        ExprNode e = new ExprNode();
        e.Kind = 1;
        e.TVal = 3;
        e.BVal = v;
        return e;
    }

    static ExprNode Binary(string op, ExprNode l, ExprNode r) {
        ExprNode e = new ExprNode();
        e.Kind = 2;
        e.Name = op;
        e.A = l;
        e.B = r;
        return e;
    }

    /// <summary>3 = call (Name = method name; A = receiver tree, null when the
    /// lambda parameter itself is the receiver; B = single argument tree).</summary>
    static ExprNode Call(string fn, ExprNode recv, ExprNode arg) {
        ExprNode e = new ExprNode();
        e.Kind = 3;
        e.Name = fn;
        e.A = recv;
        e.B = arg;
        return e;
    }

    static ExprNode Lambda(string p, ExprNode body) {
        ExprNode e = new ExprNode();
        e.Kind = 4;
        e.Name = p;
        e.A = body;
        return e;
    }

    static ExprNode Not(ExprNode x) {
        ExprNode e = new ExprNode();
        e.Kind = 5;
        e.A = x;
        return e;
    }
}

/// <summary>
/// Target-typed expression wrapper. The type parameter T is the entity or
/// element type the lambda ranges over; methods declaring an
/// <c>Expr&lt;T&gt;</c> parameter receive lambdas as expression trees.
/// </summary>
class Expr<T> {
    public ExprNode Root;

    public Expr() {
        Root = null;
    }

    static Expr<T> From(ExprNode root) {
        Expr<T> e = new Expr<T>();
        e.Root = root;
        return e;
    }
}
