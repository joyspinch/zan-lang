using System;

namespace System.Linq;

/// <summary>
/// 可检查表达式树的节点。当 lambda 传给参数声明为
/// <c>Expr&lt;T&gt;</c> 的方法时，编译器
/// （dbgen 阶段）会将其降级为 <c>ExprNode</c> 构造代码，而非
/// delegate，因此纯 Zan 代码可在运行时遍历该树——这是
/// ORM 查询构建、LINQ-to-objects 求值、校验规则和
/// 权限表达式的基础。
///
/// 节点类型：
///   0 = 成员访问（Name = 字段名）
///   1 = 常量（IVal / DVal / SVal / BVal，匹配的那个）
///   2 = 二元运算（Name = "==","!=","&lt;","&gt;","&lt;=","&gt;=","+","-","*","/","%","&amp;&amp;","||"；A、B 为操作数）
///   3 = 调用（Name = 方法名；A = 接收方树，当
///                    lambda 参数本身作为接收方时为 null；B = 参数）
///   4 = lambda（Name = 参数名；A = 函数体）
///   5 = 非（A = 操作数）
/// </summary>
class ExprNode {
    /// 节点类型（见类注释的 0-5 编号）。
    public int Kind;
    /// 成员/运算符/方法/参数名（按 Kind 取义）。
    public string Name;
    /// 第一个操作数（接收方/函数体等）。
    public ExprNode A;
    /// 第二个操作数（右操作数/调用参数）。
    public ExprNode B;
    /// <summary>常量负载类型：0 = int，1 = double，2 = string，3 = bool。</summary>
    public int TVal;
    /// TVal=0 时的整数值。
    public int IVal;
    /// TVal=1 时的浮点值。
    public double DVal;
    /// TVal=2 时的字符串值。
    public string SVal;
    /// TVal=3 时的布尔值。
    public bool BVal;

    public ExprNode() {
        Kind = 0;
        Name = "";
        A = null;
        B = null;
        TVal = 0;
        IVal = 0;
        DVal = 0.0;
        SVal = null;
        BVal = false;
    }

    /// 构造成员访问节点（Kind 0）。
    static ExprNode Member(string n) {
        ExprNode e = new ExprNode();
        e.Kind = 0;
        e.Name = n;
        return e;
    }

    /// 构造 int 常量节点（Kind 1，TVal 0）。
    static ExprNode Const(int v) {
        ExprNode e = new ExprNode();
        e.Kind = 1;
        e.TVal = 0;
        e.IVal = v;
        return e;
    }

    /// 构造 double 常量节点（Kind 1，TVal 1）。
    static ExprNode Const(double v) {
        ExprNode e = new ExprNode();
        e.Kind = 1;
        e.TVal = 1;
        e.DVal = v;
        return e;
    }

    /// 构造 string 常量节点（Kind 1，TVal 2）。
    static ExprNode Const(string s) {
        ExprNode e = new ExprNode();
        e.Kind = 1;
        e.TVal = 2;
        e.SVal = s;
        return e;
    }

    /// 构造 bool 常量节点（Kind 1，TVal 3）。
    static ExprNode Const(bool v) {
        ExprNode e = new ExprNode();
        e.Kind = 1;
        e.TVal = 3;
        e.BVal = v;
        return e;
    }

    /// 构造二元运算节点（Kind 2；op 见类注释的运算符表）。
    static ExprNode Binary(string op, ExprNode l, ExprNode r) {
        ExprNode e = new ExprNode();
        e.Kind = 2;
        e.Name = op;
        e.A = l;
        e.B = r;
        return e;
    }

    /// <summary>3 = 调用（Name = 方法名；A = 接收方树，当
    /// lambda 参数本身作为接收方时为 null；B = 单个参数树）。</summary>
    static ExprNode Call(string fn, ExprNode recv, ExprNode arg) {
        ExprNode e = new ExprNode();
        e.Kind = 3;
        e.Name = fn;
        e.A = recv;
        e.B = arg;
        return e;
    }

    /// 构造 lambda 节点（Kind 4；p 为参数名）。
    static ExprNode Lambda(string p, ExprNode body) {
        ExprNode e = new ExprNode();
        e.Kind = 4;
        e.Name = p;
        e.A = body;
        return e;
    }

    /// 构造逻辑非节点（Kind 5）。
    static ExprNode Not(ExprNode x) {
        ExprNode e = new ExprNode();
        e.Kind = 5;
        e.A = x;
        return e;
    }
}

/// <summary>
/// 目标类型表达式包装器。类型参数 T 为 lambda 遍历的实体或
/// 元素类型；声明了
/// <c>Expr&lt;T&gt;</c> 参数的方法会以表达式树形式接收 lambda。
/// </summary>
class Expr<T> {
    /// 表达式树的根节点；未构造时为 null。
    public ExprNode Root;

    public Expr() {
        Root = null;
    }

    /// 以给定的根节点包装成一个 Expr<T>。
    static Expr<T> From(ExprNode root) {
        Expr<T> e = new Expr<T>();
        e.Root = root;
        return e;
    }
}
