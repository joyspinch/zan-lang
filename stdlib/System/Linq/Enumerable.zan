    /// <summary>从 seed 开始把序列折叠进累加器。</summary>
    static A Aggregate<T, A>(this List<T> src, A seed, Accumulator<T, A> folder) {
        A acc = seed;
        for (int i = 0; i < src.Count; i = i + 1) {
            acc = folder(acc, src[i]);
        }
        return acc;
    }

    /// <summary>整数序列的和。</summary>
    static int Sum(this List<int> src) {
        int total = 0;
        for (int i = 0; i < src.Count; i = i + 1) {
            total = total + src[i];
        }
        return total;
    }

    /// <summary>double 序列的和（SumNum 的 C# 风格重载；
    /// 由接收者的元素类型选择该重载）。</summary>
    static double Sum(this List<double> src) {
        return Enumerable.SumNum(src);
    }

