    /// <summary>按预先计算的字符串键列表稳定排序（降序）。</summary>
    static List<T> OrderByKeysStrDescending<T>(this List<T> src, List<string> keys) {
        return Enumerable.MergeSortKeysStr<T>(src, keys, true);
    }

    /* 基于预计算 int 键的自底向上稳定归并排序（键列表与 src 并行；
     * sign 翻转排序方向）。
     *
     * 键列表按值拷贝一份再排：两个缓冲区每轮互换，第二轮之后 `kb` 指向的就是
     * 传进来的那个 list，直接拿它当 scratch 会把**调用方的键列表原地改成排序后
     * 的样子**——同一个键列表连排两次，第二次拿到的已是被改过的数据，结果就是错的。 */
    static List<T> MergeSortKeysInt<T>(List<T> src, List<int> keys, int sign) {
        List<T> a = Enumerable.ToList<T>(src);
        int n = a.Count;
        if (n < 2) { return a; }
        List<T> b = Enumerable.ToList<T>(src);
        List<int> ka = new List<int>();
        List<int> kb = new List<int>();
        for (int i = 0; i < n; i = i + 1) { ka.Add(keys[i]); kb.Add(0); }
        int width = 1;
        while (width < n) {
            int lo = 0;
            while (lo < n) {
                int mid = lo + width;
                if (mid > n) { mid = n; }
                int hi = lo + width + width;
                if (hi > n) { hi = n; }
                int l = lo;
                int r = mid;
                int o = lo;
                while (l < mid && r < hi) {
                    if (sign * ka[l] <= sign * ka[r]) { b[o] = a[l]; kb[o] = ka[l]; l = l + 1; }
                    else { b[o] = a[r]; kb[o] = ka[r]; r = r + 1; }
                    o = o + 1;
                }
                while (l < mid) { b[o] = a[l]; kb[o] = ka[l]; l = l + 1; o = o + 1; }
                while (r < hi) { b[o] = a[r]; kb[o] = ka[r]; r = r + 1; o = o + 1; }
                lo = hi;
            }
            List<T> tl = a; a = b; b = tl;
            List<int> tk = ka; ka = kb; kb = tk;
            width = width + width;
        }
        return a;
    }

    /* 基于预计算 long 键的自底向上稳定归并排序。 */
    /* 键列表按值拷贝，理由见 MergeSortKeysInt。 */
    static List<T> MergeSortKeysLong<T>(List<T> src, List<long> keys, int sign) {
        List<T> a = Enumerable.ToList<T>(src);
        int n = a.Count;
        if (n < 2) { return a; }
        List<T> b = Enumerable.ToList<T>(src);
        List<long> ka = new List<long>();
        List<long> kb = new List<long>();
        for (int i = 0; i < n; i = i + 1) { ka.Add(keys[i]); kb.Add(0); }
        int width = 1;
        while (width < n) {
            int lo = 0;
            while (lo < n) {
                int mid = lo + width;
                if (mid > n) { mid = n; }
                int hi = lo + width + width;
                if (hi > n) { hi = n; }
                int l = lo;
                int r = mid;
                int o = lo;
                while (l < mid && r < hi) {
                    if (sign * ka[l] <= sign * ka[r]) { b[o] = a[l]; kb[o] = ka[l]; l = l + 1; }
                    else { b[o] = a[r]; kb[o] = ka[r]; r = r + 1; }
                    o = o + 1;
                }
                while (l < mid) { b[o] = a[l]; kb[o] = ka[l]; l = l + 1; o = o + 1; }
                while (r < hi) { b[o] = a[r]; kb[o] = ka[r]; r = r + 1; o = o + 1; }
                lo = hi;
            }
            List<T> tl = a; a = b; b = tl;
            List<long> tk = ka; ka = kb; kb = tk;
            width = width + width;
        }
        return a;
    }

    /* 基于预计算 string 键的自底向上稳定归并排序。 */
    /* 键列表按值拷贝，理由见 MergeSortKeysInt。 */
    static List<T> MergeSortKeysStr<T>(List<T> src, List<string> keys, bool desc) {
        List<T> a = Enumerable.ToList<T>(src);
        int n = a.Count;
        if (n < 2) { return a; }
        List<T> b = Enumerable.ToList<T>(src);
        List<string> ka = new List<string>();
        List<string> kb = new List<string>();
        for (int i = 0; i < n; i = i + 1) { ka.Add(keys[i]); kb.Add(""); }
        int width = 1;
        while (width < n) {
            int lo = 0;
            while (lo < n) {
                int mid = lo + width;
                if (mid > n) { mid = n; }
                int hi = lo + width + width;
                if (hi > n) { hi = n; }
                int l = lo;
                int r = mid;
                int o = lo;
                while (l < mid && r < hi) {
                    string kl = ka[l];
                    string kr = ka[r];
                    bool takeLeft = kl <= kr;
                    if (desc) { takeLeft = kl >= kr; }
                    if (takeLeft) { b[o] = a[l]; kb[o] = ka[l]; l = l + 1; }
                    else { b[o] = a[r]; kb[o] = ka[r]; r = r + 1; }
                    o = o + 1;
                }
                while (l < mid) { b[o] = a[l]; kb[o] = ka[l]; l = l + 1; o = o + 1; }
                while (r < hi) { b[o] = a[r]; kb[o] = ka[r]; r = r + 1; o = o + 1; }
                lo = hi;
            }
            List<T> tl = a; a = b; b = tl;
            List<string> tk = ka; ka = kb; kb = tk;
            width = width + width;
        }
        return a;
    }

    /* 基于预计算 double 键的自底向上稳定归并排序。 */
    /* 键列表按值拷贝，理由见 MergeSortKeysInt。 */
    static List<T> MergeSortKeysNum<T>(List<T> src, List<double> keys, bool desc) {
        List<T> a = Enumerable.ToList<T>(src);
        int n = a.Count;
        if (n < 2) { return a; }
        List<T> b = Enumerable.ToList<T>(src);
        List<double> ka = new List<double>();
        List<double> kb = new List<double>();
        for (int i = 0; i < n; i = i + 1) { ka.Add(keys[i]); kb.Add(0.0); }
        int width = 1;
        while (width < n) {
            int lo = 0;
            while (lo < n) {
                int mid = lo + width;
                if (mid > n) { mid = n; }
                int hi = lo + width + width;
                if (hi > n) { hi = n; }
                int l = lo;
                int r = mid;
                int o = lo;
                while (l < mid && r < hi) {
                    double kl = ka[l];
                    double kr = ka[r];
                    bool takeLeft = kl <= kr;
                    if (desc) { takeLeft = kl >= kr; }
                    if (takeLeft) { b[o] = a[l]; kb[o] = ka[l]; l = l + 1; }
                    else { b[o] = a[r]; kb[o] = ka[r]; r = r + 1; }
                    o = o + 1;
                }
                while (l < mid) { b[o] = a[l]; kb[o] = ka[l]; l = l + 1; o = o + 1; }
                while (r < hi) { b[o] = a[r]; kb[o] = ka[r]; r = r + 1; o = o + 1; }
                lo = hi;
            }
            List<T> tl = a; a = b; b = tl;
            List<double> tk = ka; ka = kb; kb = tk;
            width = width + width;
        }
        return a;
    }

    /// <summary>按整数键对元素分组。Grouping.IntKey 保存
    /// 键；Grouping.Key 保存其字符串形式。分组顺序按首次
    /// 出现排序。</summary>
    static List<Grouping<T>> GroupBy<T>(this List<T> src, KeySelector<T> key) {
        List<Grouping<T>> groups = new List<Grouping<T>>();
        for (int i = 0; i < src.Count; i = i + 1) {
            int k = key(src[i]);
            Grouping<T> g = null;
            for (int j = 0; j < groups.Count; j = j + 1) {
                if (groups[j].IntKey == k) { g = groups[j]; }
            }
            if (g == null) {
                g = new Grouping<T>();
                g.IntKey = k;
                g.Key = Convert.ToString(k);
                groups.Add(g);
            }
            g.Items.Add(src[i]);
        }
        return groups;
    }

    /// <summary>按字符串键分组（GroupByStr 的 C# 风格重载；
    /// 由 lambda 的键类型选择该重载）。</summary>
    static List<Grouping<T>> GroupBy<T>(this List<T> src, StrKeySelector<T> key) {
        return Enumerable.GroupByStr<T>(src, key);
    }

    /// <summary>按字符串键（按值比较）分组。分组
    /// 顺序按首次出现排列。</summary>
    static List<Grouping<T>> GroupByStr<T>(this List<T> src, StrKeySelector<T> key) {
        List<Grouping<T>> groups = new List<Grouping<T>>();
        for (int i = 0; i < src.Count; i = i + 1) {
            string k = key(src[i]);
            Grouping<T> g = null;
            for (int j = 0; j < groups.Count; j = j + 1) {
                string gk = groups[j].Key;
                if (gk == k) { g = groups[j]; }
            }
            if (g == null) {
                g = new Grouping<T>();
                g.Key = k;
                groups.Add(g);
            }
            g.Items.Add(src[i]);
        }
        return groups;
    }

    /// <summary>按预先计算的整数键分组（键与元素列表并行；
    /// Grouping.Items 为投影后的元素）。</summary>
    static List<Grouping<R>> GroupByKeysInt<T, R>(this List<T> src, List<int> keys, List<R> items) {
        List<Grouping<R>> groups = new List<Grouping<R>>();
        for (int i = 0; i < src.Count; i = i + 1) {
            int k = keys[i];
            Grouping<R> g = null;
            for (int j = 0; j < groups.Count; j = j + 1) {
                if (groups[j].IntKey == k) { g = groups[j]; }
            }
            if (g == null) {
                g = new Grouping<R>();
                g.IntKey = k;
                g.Key = Convert.ToString(k);
                groups.Add(g);
            }
            g.Items.Add(items[i]);
        }
        return groups;
    }

    /// <summary>按预先计算的字符串键分组（键与元素列表并行；
    /// Grouping.Items 为投影后的元素）。</summary>
    static List<Grouping<R>> GroupByKeysStr<T, R>(this List<T> src, List<string> keys, List<R> items) {
