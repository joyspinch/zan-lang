    /// <summary>整数序列的平均值；为空时抛出。</summary>
    static double Average(this List<int> src) {
        if (src.Count == 0) {
            throw new InvalidOperationException("Sequence contains no elements");
        }
        double total = 0.0;
        for (int i = 0; i < src.Count; i = i + 1) {
            total = total + (double)src[i];
        }
        return total / (double)src.Count;
    }

    /// <summary>double 序列的平均值（AverageNum 的 C# 风格重载；
    /// AverageNum）。</summary>
    static double Average(this List<double> src) {
        return Enumerable.AverageNum(src);
    }

    /// <summary>double 序列的平均值；为空时抛出。</summary>
