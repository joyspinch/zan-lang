    /// <summary>整数序列的最小值（为空时为 0）。</summary>
    static int Min(this List<int> src) {
        if (src.Count == 0) { return 0; }
        int m = src[0];
        for (int i = 1; i < src.Count; i = i + 1) {
            if (src[i] < m) { m = src[i]; }
        }
        return m;
    }

    /// <summary>double 序列的最小值（MinNum 的 C# 风格重载；
    /// 由接收者的元素类型选择该重载）。</summary>
    static double Min(this List<double> src) {
        return Enumerable.MinNum(src);
    }

    /// <summary>double 序列的最小值（为空时为 0）。</summary>
    static double MinNum(this List<double> src) {
        if (src.Count == 0) { return 0.0; }
        double m = src[0];
        for (int i = 1; i < src.Count; i = i + 1) {
            if (src[i] < m) { m = src[i]; }
        }
        return m;
    }

    /// <summary>序列上最小整数键（为空时为 0）。</summary>
    static int Min<T>(this List<T> src, KeySelector<T> key) {
        if (src.Count == 0) { return 0; }
        int m = key(src[0]);
        for (int i = 1; i < src.Count; i = i + 1) {
            int k = key(src[i]);
            if (k < m) { m = k; }
        }
        return m;
    }

    /// <summary>整数序列的最大值（为空时为 0）。</summary>
    static int Max(this List<int> src) {
        if (src.Count == 0) { return 0; }
        int m = src[0];
        for (int i = 1; i < src.Count; i = i + 1) {
            if (src[i] > m) { m = src[i]; }
        }
        return m;
    }

