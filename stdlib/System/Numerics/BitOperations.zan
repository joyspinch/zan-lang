using System;
using System.Runtime.CompilerServices;

namespace System.Numerics;

// 提供对现代 CPU 硬件位运算原语的直接访问。
// 由编译器 irgen 直接降低为 LLVM Intrinsics 及单周期机器指令
[Intrinsic]
public static class BitOperations {
    // 统计 32 位整数二进制中 1 的个数（POPCNT）。
    [DllImport("crt")]
    public static extern int PopCount(int value);

    // 统计 64 位整数二进制中 1 的个数（POPCNT）。
    [DllImport("crt")]
    public static extern int PopCount(long value);

    // 计算 32 位整数二进制前导零的个数（LZCNT / CLZ）。为 0 时返回 32。
    [DllImport("crt")]
    public static extern int LeadingZeroCount(int value);

    // 计算 64 位整数二进制前导零的个数（LZCNT / CLZ）。为 0 时返回 64。
    [DllImport("crt")]
    public static extern int LeadingZeroCount(long value);

    // 计算 32 位整数二进制尾随零的个数（TZCNT / CTZ）。为 0 时返回 32。
    [DllImport("crt")]
    public static extern int TrailingZeroCount(int value);

    // 计算 64 位整数二进制尾随零的个数（TZCNT / CTZ）。为 0 时返回 64。
    [DllImport("crt")]
    public static extern int TrailingZeroCount(long value);

    // 32 位整数循环左移（ROL）。
    [DllImport("crt")]
    public static extern int RotateLeft(int value, int offset);

    // 64 位整数循环左移（ROL）。
    [DllImport("crt")]
    public static extern long RotateLeft(long value, int offset);

    // 32 位整数循环右移（ROR）。
    [DllImport("crt")]
    public static extern int RotateRight(int value, int offset);

    // 64 位整数循环右移（ROR）。
    [DllImport("crt")]
    public static extern long RotateRight(long value, int offset);

    // 颠倒 16/32/64 位整数的字节顺序（大小端转换，BSWAP）。
    [DllImport("crt")]
    public static extern short ReverseEndianness(short value);

    [DllImport("crt")]
    public static extern ushort ReverseEndianness(ushort value);

    [DllImport("crt")]
    public static extern int ReverseEndianness(int value);

    [DllImport("crt")]
    public static extern uint ReverseEndianness(uint value);

    // 颠倒 64 位整数的字节顺序（大小端转换，BSWAP）。
    [DllImport("crt")]
    public static extern long ReverseEndianness(long value);

    [DllImport("crt")]
    public static extern ulong ReverseEndianness(ulong value);

    // 双字漏斗移位（llvm.fshl / llvm.fshr -> x86-64 shld/shrd）。
    [DllImport("crt")]
    public static extern uint FunnelShiftLeft(uint high, uint low, int shift);

    [DllImport("crt")]
    public static extern ulong FunnelShiftLeft(ulong high, ulong low, int shift);

    [DllImport("crt")]
    public static extern uint FunnelShiftRight(uint high, uint low, int shift);

    [DllImport("crt")]
    public static extern ulong FunnelShiftRight(ulong high, ulong low, int shift);

    // 无 UB 硬件位域提取/插入（startBit/bitCount 为常量时折叠为单周期掩码/BEXTR/UBFX/BFI）。
    [DllImport("crt")]
    public static extern uint ExtractBits(uint value, int startBit, int bitCount);

    [DllImport("crt")]
    public static extern ulong ExtractBits(ulong value, int startBit, int bitCount);

    [DllImport("crt")]
    public static extern uint InsertBits(uint target, uint fieldValue, int startBit, int bitCount);

    [DllImport("crt")]
    public static extern ulong InsertBits(ulong target, ulong fieldValue, int startBit, int bitCount);

    // 颠倒 32/64 位整数的位顺序（llvm.bitreverse）。
    [DllImport("crt")]
    public static extern int BitReverse(int value);

    [DllImport("crt")]
    public static extern uint BitReverse(uint value);

    [DllImport("crt")]
    public static extern long BitReverse(long value);

    [DllImport("crt")]
    public static extern ulong BitReverse(ulong value);

    // 饱和加法（溢出钳制到 Min/Max，llvm.sadd/uadd.sat）。
    [DllImport("crt")]
    public static extern int SaturatingAdd(int left, int right);

    [DllImport("crt")]
    public static extern uint SaturatingAdd(uint left, uint right);

    [DllImport("crt")]
    public static extern long SaturatingAdd(long left, long right);

    [DllImport("crt")]
    public static extern ulong SaturatingAdd(ulong left, ulong right);

    // 饱和减法（下溢/上溢钳制到 Min/Max，llvm.ssub/usub.sat）。
    [DllImport("crt")]
    public static extern int SaturatingSub(int left, int right);

    [DllImport("crt")]
    public static extern uint SaturatingSub(uint left, uint right);

    [DllImport("crt")]
    public static extern long SaturatingSub(long left, long right);

    [DllImport("crt")]
    public static extern ulong SaturatingSub(ulong left, ulong right);

    // 溢出检测加法（返回回绕结果，overflow 置为是否溢出，llvm.{s,u}add.with.overflow）。
    [DllImport("crt")]
    public static extern int OverflowAdd(int left, int right, ref bool overflow);

    [DllImport("crt")]
    public static extern uint OverflowAdd(uint left, uint right, ref bool overflow);

    [DllImport("crt")]
    public static extern long OverflowAdd(long left, long right, ref bool overflow);

    [DllImport("crt")]
    public static extern ulong OverflowAdd(ulong left, ulong right, ref bool overflow);

    // 溢出检测减法（llvm.{s,u}sub.with.overflow）。
    [DllImport("crt")]
    public static extern int OverflowSub(int left, int right, ref bool overflow);

    [DllImport("crt")]
    public static extern uint OverflowSub(uint left, uint right, ref bool overflow);

    [DllImport("crt")]
    public static extern long OverflowSub(long left, long right, ref bool overflow);

    [DllImport("crt")]
    public static extern ulong OverflowSub(ulong left, ulong right, ref bool overflow);

    // 溢出检测乘法（llvm.{s,u}mul.with.overflow）。
    [DllImport("crt")]
    public static extern int OverflowMul(int left, int right, ref bool overflow);

    [DllImport("crt")]
    public static extern uint OverflowMul(uint left, uint right, ref bool overflow);

    [DllImport("crt")]
    public static extern long OverflowMul(long left, long right, ref bool overflow);

    [DllImport("crt")]
    public static extern ulong OverflowMul(ulong left, ulong right, ref bool overflow);

    // 64x64 -> 128 位硬件宽乘（返回高 64 位，low 接收低 64 位，单条 mul/imul 指令）。
    [DllImport("crt")]
    public static extern long BigMul(long left, long right, ref long low);

    [DllImport("crt")]
    public static extern ulong BigMul(ulong left, ulong right, ref ulong low);

    // 128÷64 硬件除法（返回商，remainder 接收余数，x86-64 单条 divq/idivq 指令）。
    [DllImport("crt")]
    public static extern ulong DivRem128(ulong high, ulong low, ulong divisor, ref ulong remainder);

    [DllImport("crt")]
    public static extern long DivRem128(long high, long low, long divisor, ref long remainder);

    // 硬件多精度带进位加法 / 带借位减法（x86-64 adc/sbb, ARM64 adcs/sbcs）。
    [DllImport("crt")]
    public static extern uint AddWithCarry(uint left, uint right, bool carryIn, ref bool carryOut);

    [DllImport("crt")]
    public static extern ulong AddWithCarry(ulong left, ulong right, bool carryIn, ref bool carryOut);

    [DllImport("crt")]
    public static extern uint SubWithBorrow(uint left, uint right, bool borrowIn, ref bool borrowOut);

    [DllImport("crt")]
    public static extern ulong SubWithBorrow(ulong left, ulong right, bool borrowIn, ref bool borrowOut);

    // 计算以 2 为底的整数对数（向下取整）。小于等于 0 时返回 0。
    [DllImport("crt")]
    public static extern int Log2(int value);

    // 计算以 2 为底的 64 位整数对数（向下取整）。小于等于 0 时返回 0。
    [DllImport("crt")]
    public static extern int Log2(long value);

    // 判断整数是否为 2 的整数次幂。
    [DllImport("crt")]
    public static extern bool IsPow2(int value);

    // 判断 64 位整数是否为 2 的整数次幂。
    [DllImport("crt")]
    public static extern bool IsPow2(long value);

    // 将整数向上舍入到最接近的 2 的整数次幂。
    [DllImport("crt")]
    public static extern int RoundUpToPowerOf2(int value);

    // 将 64 位整数向上舍入到最接近的 2 的整数次幂。
    [DllImport("crt")]
    public static extern long RoundUpToPowerOf2(long value);

    // 清零最低置位位（BLSR 单周期硬件位操作，value & (value - 1)）。
    public static int ResetLowestSetBit(int value) {
        return value & (value - 1);
    }

    // 清零 64 位整数最低置位位（BLSR 单周期硬件位操作，value & (value - 1)）。
    public static long ResetLowestSetBit(long value) {
        return value & (value - 1);
    }

    // 提取最低置位位（BLSI 单周期硬件位操作，value & (-value)）。
    public static int ExtractLowestSetBit(int value) {
        return value & (-value);
    }

    // 提取 64 位整数最低置位位（BLSI 单周期硬件位操作，value & (-value)）。
    public static long ExtractLowestSetBit(long value) {
        return value & (-value);
    }
}
