using System;

namespace System.Numerics;

// 提供对现代 CPU 硬件位运算原语的直接访问与纯标量实现。
public static class BitOperations {
    // 统计 32 位整数二进制中 1 的个数（POPCNT）。
    public static int PopCount(int value) {
        int count = 0;
        int v = value;
        while (v != 0) {
            v = v & (v - 1);
            count = count + 1;
        }
        return count;
    }

    // 统计 64 位整数二进制中 1 的个数（POPCNT）。
    public static int PopCount(long value) {
        int count = 0;
        long v = value;
        while (v != 0) {
            v = v & (v - 1);
            count = count + 1;
        }
        return count;
    }

    // 计算 32 位整数二进制前导零的个数（LZCNT / CLZ）。为 0 时返回 32。
    public static int LeadingZeroCount(int value) {
        if (value == 0) { return 32; }
        int count = 0;
        int v = value;
        if ((v & 0xFFFF0000) == 0) { count = count + 16; v = v << 16; }
        if ((v & 0xFF000000) == 0) { count = count + 8; v = v << 8; }
        if ((v & 0xF0000000) == 0) { count = count + 4; v = v << 4; }
        if ((v & 0xC0000000) == 0) { count = count + 2; v = v << 2; }
        if ((v & 0x80000000) == 0) { count = count + 1; }
        return count;
    }

    // 计算 64 位整数二进制前导零的个数（LZCNT / CLZ）。为 0 时返回 64。
    public static int LeadingZeroCount(long value) {
        if (value == 0) { return 64; }
        int hi = (int)((value >> 32) & 0xFFFFFFFF);
        if (hi != 0) { return LeadingZeroCount(hi); }
        int lo = (int)(value & 0xFFFFFFFF);
        return 32 + LeadingZeroCount(lo);
    }

    // 计算 32 位整数二进制尾随零的个数（TZCNT / CTZ）。为 0 时返回 32。
    public static int TrailingZeroCount(int value) {
        if (value == 0) { return 32; }
        int count = 0;
        int v = value;
        if ((v & 0x0000FFFF) == 0) { count = count + 16; v = v >> 16; }
        if ((v & 0x000000FF) == 0) { count = count + 8; v = v >> 8; }
        if ((v & 0x0000000F) == 0) { count = count + 4; v = v >> 4; }
        if ((v & 0x00000003) == 0) { count = count + 2; v = v >> 2; }
        if ((v & 0x00000001) == 0) { count = count + 1; }
        return count;
    }

    // 计算 64 位整数二进制尾随零的个数（TZCNT / CTZ）。为 0 时返回 64。
    public static int TrailingZeroCount(long value) {
        if (value == 0) { return 64; }
        int lo = (int)(value & 0xFFFFFFFF);
        if (lo != 0) { return TrailingZeroCount(lo); }
        int hi = (int)((value >> 32) & 0xFFFFFFFF);
        return 32 + TrailingZeroCount(hi);
    }

    // 32 位整数循环左移（ROL）。
    public static int RotateLeft(int value, int offset) {
        int n = offset & 31;
        if (n == 0) { return value; }
        int r = 32 - n;
        int hi = value << n;
        int mask = (1 << r) - 1;
        int lo = (value >> r) & mask;
        return hi | lo;
    }

    // 64 位整数循环左移（ROL）。
    public static long RotateLeft(long value, int offset) {
        int n = offset & 63;
        if (n == 0) { return value; }
        int r = 64 - n;
        long hi = value << n;
        long one = 1;
        long mask = (one << r) - 1;
        long lo = (value >> r) & mask;
        return hi | lo;
    }

    // 32 位整数循环右移（ROR）。
    public static int RotateRight(int value, int offset) {
        int n = offset & 31;
        if (n == 0) { return value; }
        int l = 32 - n;
        int mask = (1 << l) - 1;
        int lo = (value >> n) & mask;
        int hi = value << l;
        return hi | lo;
    }

    // 64 位整数循环右移（ROR）。
    public static long RotateRight(long value, int offset) {
        int n = offset & 63;
        if (n == 0) { return value; }
        int l = 64 - n;
        long one = 1;
        long mask = (one << l) - 1;
        long lo = (value >> n) & mask;
        long hi = value << l;
        return hi | lo;
    }

    // 颠倒 32 位整数的字节顺序（大小端转换，BSWAP）。
    public static int ReverseEndianness(int value) {
        int b0 = (value >> 24) & 0xFF;
        int b1 = (value >> 16) & 0xFF;
        int b2 = (value >> 8) & 0xFF;
        int b3 = value & 0xFF;
        return (b3 << 24) | (b2 << 16) | (b1 << 8) | b0;
    }

    // 颠倒 64 位整数的字节顺序（大小端转换，BSWAP）。
    public static long ReverseEndianness(long value) {
        long b0 = (value >> 56) & 0xFF;
        long b1 = (value >> 48) & 0xFF;
        long b2 = (value >> 40) & 0xFF;
        long b3 = (value >> 32) & 0xFF;
        long b4 = (value >> 24) & 0xFF;
        long b5 = (value >> 16) & 0xFF;
        long b6 = (value >> 8) & 0xFF;
        long b7 = value & 0xFF;
        return (b7 << 56) | (b6 << 48) | (b5 << 40) | (b4 << 32) | (b3 << 24) | (b2 << 16) | (b1 << 8) | b0;
    }

    // 计算以 2 为底的整数对数（向下取整）。小于等于 0 时返回 0。
    public static int Log2(int value) {
        if (value <= 0) { return 0; }
        return 31 - LeadingZeroCount(value);
    }

    // 计算以 2 为底的 64 位整数对数（向下取整）。小于等于 0 时返回 0。
    public static int Log2(long value) {
        if (value <= 0) { return 0; }
        return 63 - LeadingZeroCount(value);
    }

    // 判断整数是否为 2 的整数次幂。
    public static bool IsPow2(int value) {
        return value > 0 && (value & (value - 1)) == 0;
    }

    // 判断 64 位整数是否为 2 的整数次幂。
    public static bool IsPow2(long value) {
        return value > 0 && (value & (value - 1)) == 0;
    }

    // 将整数向上舍入到最接近的 2 的整数次幂。
    public static int RoundUpToPowerOf2(int value) {
        if (value <= 1) { return 1; }
        int v = value - 1;
        v = v | (v >> 1);
        v = v | (v >> 2);
        v = v | (v >> 4);
        v = v | (v >> 8);
        v = v | (v >> 16);
        return v + 1;
    }

    // 将 64 位整数向上舍入到最接近的 2 的整数次幂。
    public static long RoundUpToPowerOf2(long value) {
        if (value <= 1) { return 1; }
        long v = value - 1;
        v = v | (v >> 1);
        v = v | (v >> 2);
        v = v | (v >> 4);
        v = v | (v >> 8);
        v = v | (v >> 16);
        v = v | (v >> 32);
        return v + 1;
    }

    // 清零最低置位位（BLSR 单周期硬件位操作，value & (value - 1)）。
    public static int ResetLowestSetBit(int value) {
        return value & (value - 1);
    }

    // 清零 64 位整数最低置位位（BLSR 单周期硬件位操作，value & (value - 1)）。
    public static long ResetLowestSetBit(long value) {
        return value & (value - 1);
    }

    // 提取最低置位位（BLSI 单周期硬件位操作，value & (-value)）。
    public static int ExtractLowestSetBit(int value) {
        return value & (-value);
    }

    // 提取 64 位整数最低置位位（BLSI 单周期硬件位操作，value & (-value)）。
    public static long ExtractLowestSetBit(long value) {
        return value & (-value);
    }
}
