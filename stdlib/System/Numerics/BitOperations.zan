using System;

namespace System.Numerics;

/// <summary>
/// 提供对现代 CPU 硬件位运算原语的直接访问。
/// 由编译器 irgen 直接降低为 LLVM Intrinsics 及单周期机器指令
/// （POPCNT, LZCNT, TZCNT, ROL, ROR, BSWAP）。
/// </summary>
public static class BitOperations {
    /// <summary>统计 32 位整数二进制中 1 的个数（POPCNT）。</summary>
    [DllImport("crt")]
    public static extern int PopCount(int value);

    /// <summary>统计 64 位整数二进制中 1 的个数（POPCNT）。</summary>
    [DllImport("crt")]
    public static extern int PopCount(long value);

    /// <summary>计算 32 位整数二进制前导零的个数（LZCNT / CLZ）。为 0 时返回 32。</summary>
    [DllImport("crt")]
    public static extern int LeadingZeroCount(int value);

    /// <summary>计算 64 位整数二进制前导零的个数（LZCNT / CLZ）。为 0 时返回 64。</summary>
    [DllImport("crt")]
    public static extern int LeadingZeroCount(long value);

    /// <summary>计算 32 位整数二进制尾随零的个数（TZCNT / CTZ）。为 0 时返回 32。</summary>
    [DllImport("crt")]
    public static extern int TrailingZeroCount(int value);

    /// <summary>计算 64 位整数二进制尾随零的个数（TZCNT / CTZ）。为 0 时返回 64。</summary>
    [DllImport("crt")]
    public static extern int TrailingZeroCount(long value);

    /// <summary>32 位整数循环左移（ROL）。</summary>
    [DllImport("crt")]
    public static extern int RotateLeft(int value, int offset);

    /// <summary>64 位整数循环左移（ROL）。</summary>
    [DllImport("crt")]
    public static extern long RotateLeft(long value, int offset);

    /// <summary>32 位整数循环右移（ROR）。</summary>
    [DllImport("crt")]
    public static extern int RotateRight(int value, int offset);

    /// <summary>64 位整数循环右移（ROR）。</summary>
    [DllImport("crt")]
    public static extern long RotateRight(long value, int offset);

    /// <summary>颠倒 32 位整数的字节顺序（大小端转换，BSWAP）。</summary>
    [DllImport("crt")]
    public static extern int ReverseEndianness(int value);

    /// <summary>颠倒 64 位整数的字节顺序（大小端转换，BSWAP）。</summary>
    [DllImport("crt")]
    public static extern long ReverseEndianness(long value);

    /// <summary>计算以 2 为底的整数对数（向下取整）。小于等于 0 时返回 0。</summary>
    [DllImport("crt")]
    public static extern int Log2(int value);

    /// <summary>计算以 2 为底的 64 位整数对数（向下取整）。小于等于 0 时返回 0。</summary>
    [DllImport("crt")]
    public static extern int Log2(long value);

    /// <summary>判断整数是否为 2 的整数次幂。</summary>
    [DllImport("crt")]
    public static extern bool IsPow2(int value);

    /// <summary>判断 64 位整数是否为 2 的整数次幂。</summary>
    [DllImport("crt")]
    public static extern bool IsPow2(long value);

    /// <summary>将整数向上舍入到最接近的 2 的整数次幂。</summary>
    [DllImport("crt")]
    public static extern int RoundUpToPowerOf2(int value);

    /// <summary>将 64 位整数向上舍入到最接近的 2 的整数次幂。</summary>
    [DllImport("crt")]
    public static extern long RoundUpToPowerOf2(long value);

    /// <summary>清零最低置位位（BLSR 单周期硬件位操作，value &amp; (value - 1)）。</summary>
    public static int ResetLowestSetBit(int value) {
        return value & (value - 1);
    }

    /// <summary>清零 64 位整数最低置位位（BLSR 单周期硬件位操作，value &amp; (value - 1)）。</summary>
    public static long ResetLowestSetBit(long value) {
        return value & (value - 1);
    }

    /// <summary>提取最低置位位（BLSI 单周期硬件位操作，value &amp; (-value)）。</summary>
    public static int ExtractLowestSetBit(int value) {
        return value & (-value);
    }

    /// <summary>提取 64 位整数最低置位位（BLSI 单周期硬件位操作，value &amp; (-value)）。</summary>
    public static long ExtractLowestSetBit(long value) {
        return value & (-value);
    }
}
