using System;

namespace System.Numerics;

public struct Vector2 {
    public float X;
    public float Y;

    public Vector2(float x, float y) {
        this.X = x;
        this.Y = y;
    }

    public static Vector2 Zero {
        get { return new Vector2(0.0f, 0.0f); }
    }

    public static Vector2 One {
        get { return new Vector2(1.0f, 1.0f); }
    }

    public static Vector2 UnitX {
        get { return new Vector2(1.0f, 0.0f); }
    }

    public static Vector2 UnitY {
        get { return new Vector2(0.0f, 1.0f); }
    }

    public static Vector2 Add(Vector2 left, Vector2 right) {
        return new Vector2(left.X + right.X, left.Y + right.Y);
    }

    public static Vector2 Subtract(Vector2 left, Vector2 right) {
        return new Vector2(left.X - right.X, left.Y - right.Y);
    }

    public static Vector2 Multiply(Vector2 left, Vector2 right) {
        return new Vector2(left.X * right.X, left.Y * right.Y);
    }

    public static Vector2 Multiply(Vector2 left, float scalar) {
        return new Vector2(left.X * scalar, left.Y * scalar);
    }

    public static Vector2 Divide(Vector2 left, Vector2 right) {
        return new Vector2(left.X / right.X, left.Y / right.Y);
    }

    public static Vector2 Divide(Vector2 left, float scalar) {
        return new Vector2(left.X / scalar, left.Y / scalar);
    }

    public static Vector2 Negate(Vector2 value) {
        return new Vector2(-value.X, -value.Y);
    }

    public static float Dot(Vector2 value1, Vector2 value2) {
        return value1.X * value2.X + value1.Y * value2.Y;
    }

    public static float Distance(Vector2 value1, Vector2 value2) {
        float dx = value1.X - value2.X;
        float dy = value1.Y - value2.Y;
        return (float)Math.Sqrt((double)(dx * dx + dy * dy));
    }

    public static float DistanceSquared(Vector2 value1, Vector2 value2) {
        float dx = value1.X - value2.X;
        float dy = value1.Y - value2.Y;
        return dx * dx + dy * dy;
    }

    public float Length() {
        return (float)Math.Sqrt((double)(this.X * this.X + this.Y * this.Y));
    }

    public float LengthSquared() {
        return this.X * this.X + this.Y * this.Y;
    }

    public static Vector2 Normalize(Vector2 value) {
        float len = value.Length();
        if (len > 0.00001f) {
            return new Vector2(value.X / len, value.Y / len);
        }
        return Vector2.Zero;
    }

    public static Vector2 Min(Vector2 value1, Vector2 value2) {
        float rx = value1.X < value2.X ? value1.X : value2.X;
        float ry = value1.Y < value2.Y ? value1.Y : value2.Y;
        return new Vector2(rx, ry);
    }

    public static Vector2 Max(Vector2 value1, Vector2 value2) {
        float rx = value1.X > value2.X ? value1.X : value2.X;
        float ry = value1.Y > value2.Y ? value1.Y : value2.Y;
        return new Vector2(rx, ry);
    }

    public static Vector2 Clamp(Vector2 value1, Vector2 min, Vector2 max) {
        return Vector2.Min(Vector2.Max(value1, min), max);
    }

    public static Vector2 Lerp(Vector2 value1, Vector2 value2, float amount) {
        return new Vector2(
            value1.X + (value2.X - value1.X) * amount,
            value1.Y + (value2.Y - value1.Y) * amount
        );
    }

    public bool Equals(Vector2 other) {
        return this.X == other.X && this.Y == other.Y;
    }

    public override string ToString() {
        return "<" + this.X.ToString() + ", " + this.Y.ToString() + ">";
    }
}
