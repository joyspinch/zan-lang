using System;

namespace System.Numerics;

// 标量数学工具箱（门面层）。
//
// 位置说明：并入既有的 <c>System.Numerics</c>（与 Vector2/3/4、Matrix4x4 同目录同命名空间），
// 不另建平行包——见 docs/ECOSYSTEM_ROADMAP.md 的「数学层落地形态」一节。
//
// 类型约定：标量一律用 <c>double</c>。理由是本仓库的游戏层数学实际以 double 为主导
// （packages/Zan.Game 中 double 的使用量远高于 float），而几何量（Vector/Quaternion/Matrix）
// 沿用既有的 float，二者不混用。
//
// 语言限制：编译器内建的 <c>Math</c> 成员固定且不可扩展，缺 <c>PI</c>/<c>Log</c>/<c>Exp</c>；
// 本类以纯实现补齐这些能力，不引入任何外部依赖。
public static class MathUtil {
    // 圆周率。
    public static double Pi {
        get { return 3.14159265358979323846; }
    }

    // 圆周率的 2 倍（整圆一周的弧度）。
    public static double Tau {
        get { return 6.28318530717958647692; }
    }

    // 自然对数的底。
    public static double E {
        get { return 2.71828182845904523536; }
    }

    // 角度转弧度的乘数。
    public static double DegToRad {
        get { return MathUtil.Pi / 180.0; }
    }

    // 弧度转角度的乘数。
    public static double RadToDeg {
        get { return 180.0 / MathUtil.Pi; }
    }

    // 近似相等判定用的默认相对容差。
    public static double Epsilon {
        get { return 1e-9; }
    }

    // 把 value 限制在 [min, max] 区间内。min > max 时以 min 为准。
    public static double Clamp(double value, double min, double max) {
        if (value < min) { return min; }
        if (value > max) { return max; }
        return value;
    }

    // 把整数值限制在 [min, max] 区间内。
    public static int Clamp(int value, int min, int max) {
        if (value < min) { return min; }
        if (value > max) { return max; }
        return value;
    }

    // 把整数值限制在 [min, max] 区间内（兼容别名）。
    public static int ClampInt(int value, int min, int max) {
        if (value < min) { return min; }
        if (value > max) { return max; }
        return value;
    }

    // 把 value 限制在 [0, 1] 区间内。
    public static double Clamp01(double value) {
        if (value < 0.0) { return 0.0; }
        if (value > 1.0) { return 1.0; }
        return value;
    }

    // 线性插值，t 会被限制在 [0, 1]。
    public static double Lerp(double from, double to, double t) {
        return from + (to - from) * MathUtil.Clamp01(t);
    }

    // 线性插值，t 不做限制（允许外插）。
    public static double LerpUnclamped(double from, double to, double t) {
        return from + (to - from) * t;
    }

    // 反向插值：求 value 在 [from, to] 中的归一化位置。from == to 时返回 0。
    public static double InverseLerp(double from, double to, double value) {
        if (from == to) { return 0.0; }
        return (value - from) / (to - from);
    }

    // 把 value 从 [inMin, inMax] 重映射到 [outMin, outMax]。
    public static double Remap(double value, double inMin, double inMax, double outMin, double outMax) {
        return MathUtil.LerpUnclamped(outMin, outMax, MathUtil.InverseLerp(inMin, inMax, value));
    }

    // 平滑阶跃（三次 Hermite）：区间内为 3t²-2t³，两端一阶导为 0。
    public static double SmoothStep(double from, double to, double t) {
        double x = MathUtil.Clamp01(MathUtil.InverseLerp(from, to, t));
        return x * x * (3.0 - 2.0 * x);
    }

    // 更平滑的阶跃（五次）：区间内为 6t⁵-15t⁴+10t³，两端一阶、二阶导均为 0。
    public static double SmootherStep(double from, double to, double t) {
        double x = MathUtil.Clamp01(MathUtil.InverseLerp(from, to, t));
        return x * x * x * (x * (x * 6.0 - 15.0) + 10.0);
    }

    // 符号：正数返回 1，负数返回 -1，0 返回 0。
    public static double Sign(double value) {
        if (value > 0.0) { return 1.0; }
        if (value < 0.0) { return -1.0; }
        return 0.0;
    }

    // 近似相等（相对容差判定）。
    public static bool Approximately(double a, double b) {
        return MathUtil.ApproximatelyTo(a, b, 1e-9);
    }

    // 近似相等（显式容差）。同时使用绝对与相对容差，避免大数值下的精度塌陷。
    public static bool ApproximatelyTo(double a, double b, double tolerance) {
        double diff = Math.Abs(a - b);
        if (diff <= tolerance) { return true; }
        double scale = Math.Max(Math.Abs(a), Math.Abs(b));
        return diff <= tolerance * scale;
    }

    // 循环取值：把 value 折回 [min, max) 区间（区间长度为 max - min）。
    public static double Wrap(double value, double min, double max) {
        double range = max - min;
        if (range <= 0.0) { return min; }
        double shifted = value - min;
        shifted = shifted - range * Math.Floor(shifted / range);
        return min + shifted;
    }

    // 乒乓取值：value 在 [0, length] 之间来回反弹。
    public static double PingPong(double value, double length) {
        if (length <= 0.0) { return 0.0; }
        double t = MathUtil.Wrap(value, 0.0, length * 2.0);
        if (t > length) { t = length * 2.0 - t; }
        return t;
    }

    // 以不超过 maxDelta 的步长把 current 拉向 target。
    public static double MoveTowards(double current, double target, double maxDelta) {
        double delta = target - current;
        if (Math.Abs(delta) <= maxDelta) { return target; }
        return current + MathUtil.Sign(delta) * maxDelta;
    }

    // 两个角度（单位：度）之间的最短差值，结果落在 [-180, 180)。
    public static double DeltaAngle(double current, double target) {
        return MathUtil.Wrap(target - current, -180.0, 180.0);
    }

    // 角度（单位：度）插值，沿最短弧推进。
    public static double LerpAngle(double from, double to, double t) {
        return from + MathUtil.DeltaAngle(from, to) * MathUtil.Clamp01(t);
    }

    // 角度（度）转弧度。
    public static double DegreesToRadians(double degrees) {
        return degrees * MathUtil.DegToRad;
    }

    // 弧度转角度（度）。
    public static double RadiansToDegrees(double radians) {
        return radians * MathUtil.RadToDeg;
    }

    // 阶跃函数：x >= edge 时为 1，否则为 0。
    public static double Step(double edge, double x) {
        if (x >= edge) { return 1.0; }
        return 0.0;
    }

    // Hermite 插值。m0 / m1 为两端点切线（每单位 t 的变化量）。
    public static double Hermite(double t, double p0, double m0, double p1, double m1) {
        double t2 = t * t;
        double t3 = t2 * t;
        double h00 = 2.0 * t3 - 3.0 * t2 + 1.0;
        double h10 = t3 - 2.0 * t2 + t;
        double h01 = -2.0 * t3 + 3.0 * t2;
        double h11 = t3 - t2;
        return h00 * p0 + h10 * m0 + h01 * p1 + h11 * m1;
    }

    // 把 value 吸附到 step 的整数倍。step 为 0 时原样返回。
    public static double RoundTo(double value, double step) {
        if (step == 0.0) { return value; }
        return Math.Round(value / step) * step;
    }

    // 自然对数 ln(value)。
    //
    // 编译器内建 Math 没有 Log，这里用「二进制缩放 + atanh 级数」纯实现：
    // 把 value 拆成 m·2^k（m ∈ [1,2)），再由 ln(m) = 2·atanh((m-1)/(m+1)) 展开，
    // 其中 |z| < 1/3，级数收敛极快，25 项即可达到双精度极限。
    // value <= 0 时返回 -Infinity。
    public static double Log(double value) {
        if (value <= 0.0) { return double.NegativeInfinity; }
        if (value == 1.0) { return 0.0; }
        int exponent = 0;
        double m = value;
        while (m >= 2.0) {
            m = m * 0.5;
            exponent = exponent + 1;
        }
        while (m < 1.0) {
            m = m * 2.0;
            exponent = exponent - 1;
        }
        double z = (m - 1.0) / (m + 1.0);
        double z2 = z * z;
        double sum = 0.0;
        double term = z;
        for (int i = 0; i < 25; i++) {
            sum = sum + term / (2.0 * (double)i + 1.0);
            term = term * z2;
        }
        return 2.0 * sum + (double)exponent * 0.6931471805599453;
    }

    // 指数函数 e^value。
    //
    // 与 Log 同理，编译器内建 Math 没有 Exp：把 value 拆成 k·ln2 + r（|r| ≤ ln2/2），
    // 用 e^k·ln2 = 2^k 精确表示（2 的整数次幂在双精度下无误差），
    // 余下的 e^r 用泰勒级数展开，20 项即可收敛到机器精度。
    public static double Exp(double value) {
        if (value > 709.782712893384) { return double.PositiveInfinity; }
        if (value < -745.1332191019411) { return 0.0; }
        double k = Math.Floor(value / 0.6931471805599453 + 0.5);
        double r = value - k * 0.6931471805599453;
        double sum = 1.0;
        double term = 1.0;
        for (int i = 1; i <= 20; i++) {
            term = term * r / (double)i;
            sum = sum + term;
        }
        return Math.Pow(2.0, k) * sum;
    }
}
