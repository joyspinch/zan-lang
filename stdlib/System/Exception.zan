using System;

namespace System;

/// <summary>
/// 所有异常的基础类型，携带人类可读的消息，通过
/// <c>throw new Exception("...")</c> 抛出，并由 <c>catch (Exception e)</c> 捕获。
/// </summary>
class Exception {
    public string Message;

    public Exception(string message) {
        Message = message;
    }

    public string ToString() {
        return Message;
    }
}

/// <summary>当操作对对象当前
/// 状态无效时抛出（例如对空序列调用 First()）。</summary>
class InvalidOperationException : Exception {
    public InvalidOperationException(string message) {
        Message = message;
    }
}

/// <summary>当传给方法的参数无效时抛出。</summary>
class ArgumentException : Exception {
    public ArgumentException(string message) {
        Message = message;
    }
}

/// <summary>当 I/O 操作（打开、读取、写入、复制）失败时抛出。</summary>
class IOException : Exception {
    public IOException(string message) {
        Message = message;
    }
}

/// <summary>当必须存在的文件无法打开时抛出。</summary>
class FileNotFoundException : IOException {
    public FileNotFoundException(string message) {
        Message = message;
    }
}

/// <summary>当套接字操作失败时抛出（创建、绑定、监听、
/// 连接失败），消息携带平台错误码（Windows 的
/// WSAGetLastError / POSIX 的 errno）。<paramref name="code"/> 以
/// 数值形式携带同一错误码，供程序检查而非解析消息文本。</summary>
class SocketException : Exception {
    public int code;
    public SocketException(int code, string message) {
        this.code = code;
        Message = message;
    }
}

/// <summary>当 HTTP 请求无法发送或完成时抛出
/// （连接失败、TLS 握手失败）。</summary>
class HttpRequestException : Exception {
    public HttpRequestException(string message) {
        Message = message;
    }
}

/// <summary>当 JSON 文本格式错误时抛出（JsonValue.Parse）。</summary>
class JsonException : Exception {
    public JsonException(string message) {
        Message = message;
    }
}

/// <summary>当正则匹配用尽回溯步骤预算时抛出。病态模式
/// （`(a+)+$` 之类）在某些输入上代价会爆炸，引擎宁可报错也不把
/// 超时伪装成"无匹配"。</summary>
class RegexBudgetException : Exception {
    public RegexBudgetException(string message) {
        Message = message;
    }
}

/// <summary>当跨平台 API 在当前平台
/// 没有实现时抛出。接口在所有平台都存在，因此代码各处都能编译运行；
/// 不支持的那一半会显式报错，而不是静默
/// 不做事。</summary>
class PlatformNotSupportedException : Exception {
    public PlatformNotSupportedException(string message) {
        Message = message;
    }
}

