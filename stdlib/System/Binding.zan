using System;

namespace System;

// 双向数据绑定背后的存取器对：读取/写入 target 的实例字段或属性。
// 可写字段或同时具有 get/set 的属性赋给 Binding<T> 槽时，
// 编译器合成匹配的访问器（如 input.data = user.name;）。
public delegate T BindGet<T>(object target);
public delegate void BindSet<T>(object target, T v);

// 到类型 T 值的双向数据绑定。
// 组件作者将可绑定属性声明为 `Binding<T>` 字段。
// 可写实例字段或 get/set 属性生成实时绑定；自定义属性经访问器调用。
// getter-only、init-only 属性、readonly 字段及其他值表达式生成创建时快照。
// 快照的 Set 只修改绑定内的存储值，不回写源。
// input.data = user.name;   // 实时：model <-> UI
// input.data = "hello";     // 常量：固定值，仍可设置
// 每次 Set 都会使 `version` 递增，控件可低成本检测写入。
public class Binding<T> {
    // 非持有借用，不会自动置 null；owner 必须活过所有 Get/Set。
    // 显式赋值不能使用 owned 临时对象；失效后只可清空或替换借用。
    public object target;
    public BindGet<T> getter;
    public BindSet<T> setter;
    public bool live;
    public T constVal;
    public int version;

    // 读取源字段/属性的当前值（live）或快照存储值（const）。
    public T Get() {
        if (live) { return getter(target); }
        return constVal;
    }

    // 通过绑定写回（live 绑定时为 UI -> model）。
    public void Set(T v) {
        version = version + 1;
        if (live) { setter(target, v); return; }
        constVal = v;
    }

    // 通过此绑定执行的写入次数。
    public int Version() { return version; }

    // 绑定到模型字段时为 true（区别于常量值）。
    public bool IsLive() { return live; }
}
