using System;

namespace Game.Arpg;

/// 节点实例创建回调：节点运行时实例化完成后触发一次。
delegate void ArpgNodeCreated(string nodeId);
/// 节点每帧更新回调；deltaMilliseconds 为距上一帧的毫秒数。
delegate void ArpgNodeUpdated(string nodeId, int deltaMilliseconds);
/// 节点指针事件回调；button 取 ArpgPointerButton 值，modifiers 为
/// 修饰键掩码，x/y 为相对所属控件原点的节点局部坐标。返回 true
/// 表示事件已消费，不再向控件/窗口层分发。
delegate bool ArpgNodePointerChanged(
    string nodeId,
    int button,
    int modifiers,
    double x,
    double y);
/// 节点焦点变化回调；focused 为是否获得焦点。
delegate void ArpgNodeFocusChanged(string nodeId, bool focused);
/// 节点自定义事件回调（由 FireCustom 触发，payload 原样透传）。
delegate void ArpgNodeCustomEvent(
    string nodeId,
    string name,
    string payload);

/// 控件实例创建回调：控件运行时实例化（含 Prefab 节点展开）后触发一次。
delegate void ArpgControlCreated(string controlId);
/// 控件每帧更新回调；deltaMilliseconds 为距上一帧的毫秒数。
delegate void ArpgControlUpdated(string controlId, int deltaMilliseconds);
/// 控件指针事件回调；nodeId 为命中的子节点 Id（未命中节点时为空
/// 串），x/y 为相对窗口原点的控件局部坐标。返回 true 表示事件已
/// 消费，不再向窗口层分发。
delegate bool ArpgControlPointerChanged(
    string controlId,
    string nodeId,
    int button,
    int modifiers,
    double x,
    double y);
/// 控件焦点变化回调；focused 为是否获得焦点。
delegate void ArpgControlFocusChanged(string controlId, bool focused);
/// 可拖拽控件的拖动回调；deltaX/deltaY 为相对上次的位移（像素，
/// 累加进控件位置后再触发）。
delegate void ArpgControlDragged(
    string controlId,
    double deltaX,
    double deltaY);
/// 富文本链接激活回调；link 为链接原文（点击链接 run 时触发）。
delegate void ArpgControlLinkActivated(
    string controlId,
    string link);
/// 按钮激活回调：左键在按钮命中区域内按下、随后在其区域内抬起时触发。
delegate void ArpgControlActivated(string controlId);
/// 数值型控件（进度条等）当前值变化回调；newValue 为钳制到
/// [最小值, 最大值] 后的新值。
delegate void ArpgControlValueChanged(
    string controlId,
    double newValue);
/// 控件自定义事件回调（由 FireCustom 触发，payload 原样透传）。
delegate void ArpgControlCustomEvent(
    string controlId,
    string name,
    string payload);

/// 窗口实例创建回调：窗口及其全部控件实例化完成后触发一次。
delegate void ArpgWindowCreated(string windowId);
/// 窗口可见性变化回调：Open/Close 各触发一次（初始即可见的窗口
/// 在创建时也会触发一次"打开"）。
delegate void ArpgWindowVisibilityChanged(string windowId);
/// 窗口每帧更新回调；deltaMilliseconds 为距上一帧的毫秒数。
delegate void ArpgWindowUpdated(string windowId, int deltaMilliseconds);
/// 窗口指针事件回调；controlId 为命中的控件 Id（未命中时为空
/// 串），x/y 为相对窗口左上角的局部坐标。返回 true 表示事件已
/// 消费。
delegate bool ArpgWindowPointerChanged(
    string windowId,
    string controlId,
    int button,
    int modifiers,
    double x,
    double y);
/// 窗口自定义事件回调（由 FireCustom 触发，payload 原样透传）。
delegate void ArpgWindowCustomEvent(
    string windowId,
    string name,
    string payload);

/// <summary>
/// 节点事件单播槽位集合：每个槽位只保存一个 handler，后注册者覆盖
/// 前者。经 ArpgNodeDefinition.Events() 获取；业务代码调用 On* 注册
/// 回调，框架在节点生命周期内触发 Raise*，不要手动调用 Raise*。
/// </summary>
class ArpgNodeEventHandlers {
    ArpgNodeCreated created;
    ArpgNodeUpdated updated;
    ArpgNodePointerChanged pointerDown;
    ArpgNodePointerChanged pointerUp;
    ArpgNodePointerChanged pointerMove;
    ArpgNodeFocusChanged focusChanged;
    ArpgNodeCustomEvent customEvent;


    /// 注册节点实例化完成回调（节点运行时创建后触发一次）。
    void OnCreated(ArpgNodeCreated handler) { this.created = handler; }
    /// 注册节点每帧更新回调（deltaMilliseconds 为帧间隔毫秒）。
    void OnUpdated(ArpgNodeUpdated handler) { this.updated = handler; }
    /// 注册节点按下回调；返回 true 可消费事件并阻断后续分发。
    void OnPointerDown(ArpgNodePointerChanged handler) {
        this.pointerDown = handler;
    }
    /// 注册节点抬起回调；返回 true 可消费事件并阻断后续分发。
    void OnPointerUp(ArpgNodePointerChanged handler) {
        this.pointerUp = handler;
    }
    /// 注册节点移动回调；返回 true 可消费事件并阻断后续分发。
    void OnPointerMove(ArpgNodePointerChanged handler) {
        this.pointerMove = handler;
    }
    /// 注册节点焦点变化回调（focused 为是否获得焦点）。
    void OnFocusChanged(ArpgNodeFocusChanged handler) {
        this.focusChanged = handler;
    }
    /// 注册节点自定义事件回调（由 FireCustom 触发）。
    void OnCustomEvent(ArpgNodeCustomEvent handler) {
        this.customEvent = handler;
    }

    /// 触发实例化回调；未注册 handler 时为空操作。
    void RaiseCreated(string nodeId) {
        ArpgNodeCreated handler = this.created;
        if (handler != null) { handler(nodeId); }
    }

    /// 触发每帧更新回调；未注册 handler 时为空操作。
    void RaiseUpdated(string nodeId, int deltaMilliseconds) {
        ArpgNodeUpdated handler = this.updated;
        if (handler != null) { handler(nodeId, deltaMilliseconds); }
    }

    /// 触发按下回调；未注册时返回 false（事件未消费）。
    bool RaisePointerDown(
        string nodeId,
        int button,
        int modifiers,
        double x,
        double y
    ) {
        ArpgNodePointerChanged handler = this.pointerDown;
        if (handler == null) { return false; }
        return handler(nodeId, button, modifiers, x, y);
    }

    /// 触发抬起回调；未注册时返回 false（事件未消费）。
    bool RaisePointerUp(
        string nodeId,
        int button,
        int modifiers,
        double x,
        double y
    ) {
        ArpgNodePointerChanged handler = this.pointerUp;
        if (handler == null) { return false; }
        return handler(nodeId, button, modifiers, x, y);
    }

    /// 触发移动回调；未注册时返回 false（事件未消费）。
    bool RaisePointerMove(
        string nodeId,
        int button,
        int modifiers,
        double x,
        double y
    ) {
        ArpgNodePointerChanged handler = this.pointerMove;
        if (handler == null) { return false; }
        return handler(nodeId, button, modifiers, x, y);
    }

    /// 触发焦点变化回调；未注册 handler 时为空操作。
    void RaiseFocusChanged(string nodeId, bool focused) {
        ArpgNodeFocusChanged handler = this.focusChanged;
        if (handler != null) { handler(nodeId, focused); }
    }

    /// 触发自定义事件回调；未注册 handler 时为空操作。
    void RaiseCustom(string nodeId, string name, string payload) {
        ArpgNodeCustomEvent handler = this.customEvent;
        if (handler != null) { handler(nodeId, name, payload); }
    }
}
/// <summary>
/// 控件事件单播槽位集合：每个槽位只保存一个 handler，后注册者覆盖
/// 前者。经 ArpgControlDefinition.Events() 获取；业务代码调用 On*
/// 注册回调，框架在控件生命周期与指针交互时触发 Raise*，不要手动
/// 调用 Raise*。Prefab 控件还会叠加触发 Prefab 自身的 handler。
/// </summary>
class ArpgControlEventHandlers {
    ArpgControlCreated created;
    ArpgControlUpdated updated;
    ArpgControlPointerChanged pointerDown;
    ArpgControlPointerChanged pointerUp;
    ArpgControlPointerChanged pointerMove;
    ArpgControlFocusChanged focusChanged;
    ArpgControlDragged dragged;
    ArpgControlLinkActivated linkActivated;
    ArpgControlActivated activated;
    ArpgControlValueChanged valueChanged;
    ArpgControlCustomEvent customEvent;


    /// 注册控件实例化完成回调（含 Prefab 节点展开后触发一次）。
    void OnCreated(ArpgControlCreated handler) { this.created = handler; }
    /// 注册控件每帧更新回调（deltaMilliseconds 为帧间隔毫秒）。
    void OnUpdated(ArpgControlUpdated handler) { this.updated = handler; }
    /// 注册控件按下回调；返回 true 可消费事件并阻断窗口层分发。
    void OnPointerDown(ArpgControlPointerChanged handler) {
        this.pointerDown = handler;
    }
    /// 注册控件抬起回调；返回 true 可消费事件并阻断窗口层分发。
    void OnPointerUp(ArpgControlPointerChanged handler) {
        this.pointerUp = handler;
    }
    /// 注册控件移动回调；返回 true 可消费事件并阻断窗口层分发。
    void OnPointerMove(ArpgControlPointerChanged handler) {
        this.pointerMove = handler;
    }
    /// 注册控件焦点变化回调（focused 为是否获得焦点）。
    void OnFocusChanged(ArpgControlFocusChanged handler) {
        this.focusChanged = handler;
    }
    /// 注册拖动回调（deltaX/deltaY 为本次位移像素）。
    void OnDragged(ArpgControlDragged handler) { this.dragged = handler; }
    /// 注册富文本链接激活回调（link 为链接原文）。
    void OnLinkActivated(ArpgControlLinkActivated handler) {
        this.linkActivated = handler;
    }
    /// 注册按钮激活回调（左键按下后在按钮区域内抬起）。
    void OnActivated(ArpgControlActivated handler) {
        this.activated = handler;
    }
    /// 注册数值变化回调（newValue 已钳制到 [最小值, 最大值]）。
    void OnValueChanged(ArpgControlValueChanged handler) {
        this.valueChanged = handler;
    }
    /// 注册控件自定义事件回调（由 FireCustom 触发）。
    void OnCustomEvent(ArpgControlCustomEvent handler) {
        this.customEvent = handler;
    }

    /// 触发控件实例化回调；未注册 handler 时为空操作。
    void RaiseCreated(string controlId) {
        ArpgControlCreated handler = this.created;
        if (handler != null) { handler(controlId); }
    }

    /// 触发控件每帧更新回调；未注册 handler 时为空操作。
    void RaiseUpdated(string controlId, int deltaMilliseconds) {
        ArpgControlUpdated handler = this.updated;
        if (handler != null) { handler(controlId, deltaMilliseconds); }
    }

    /// 触发控件按下回调；未注册时返回 false（事件未消费）。
    bool RaisePointerDown(
        string controlId,
        string nodeId,
        int button,
        int modifiers,
        double x,
        double y
    ) {
        ArpgControlPointerChanged handler = this.pointerDown;
        if (handler == null) { return false; }
        return handler(controlId, nodeId, button, modifiers, x, y);
    }

    /// 触发控件抬起回调；未注册时返回 false（事件未消费）。
    bool RaisePointerUp(
        string controlId,
        string nodeId,
        int button,
        int modifiers,
        double x,
        double y
    ) {
        ArpgControlPointerChanged handler = this.pointerUp;
        if (handler == null) { return false; }
        return handler(controlId, nodeId, button, modifiers, x, y);
    }

    /// 触发控件移动回调；未注册时返回 false（事件未消费）。
    bool RaisePointerMove(
        string controlId,
        string nodeId,
        int button,
        int modifiers,
        double x,
        double y
    ) {
        ArpgControlPointerChanged handler = this.pointerMove;
        if (handler == null) { return false; }
        return handler(controlId, nodeId, button, modifiers, x, y);
    }

    /// 触发焦点变化回调；未注册 handler 时为空操作。
    void RaiseFocusChanged(string controlId, bool focused) {
        ArpgControlFocusChanged handler = this.focusChanged;
        if (handler != null) { handler(controlId, focused); }
    }

    /// 触发拖动回调；未注册 handler 时为空操作。
    void RaiseDragged(string controlId, double deltaX, double deltaY) {
        ArpgControlDragged handler = this.dragged;
        if (handler != null) { handler(controlId, deltaX, deltaY); }
    }

    /// 触发链接激活回调；未注册 handler 时为空操作。
    void RaiseLink(string controlId, string link) {
        ArpgControlLinkActivated handler = this.linkActivated;
        if (handler != null) { handler(controlId, link); }
    }

    /// 触发按钮激活回调；未注册 handler 时为空操作。
    void RaiseActivated(string controlId) {
        ArpgControlActivated handler = this.activated;
        if (handler != null) { handler(controlId); }
    }

    /// 触发数值变化回调；未注册 handler 时为空操作。
    void RaiseValueChanged(string controlId, double newValue) {
        ArpgControlValueChanged handler = this.valueChanged;
        if (handler != null) { handler(controlId, newValue); }
    }

    /// 触发控件自定义事件回调；未注册 handler 时为空操作。
    void RaiseCustom(
        string controlId,
        string name,
        string payload
    ) {
        ArpgControlCustomEvent handler = this.customEvent;
        if (handler != null) { handler(controlId, name, payload); }
    }
}

/// <summary>
/// 窗口事件单播槽位集合：每个槽位只保存一个 handler，后注册者覆盖
/// 前者。经 ArpgWindowDefinition.Events() 获取；业务代码调用 On*
/// 注册回调，框架在窗口生命周期与指针交互时触发 Raise*，不要手动
/// 调用 Raise*。
/// </summary>
class ArpgWindowEventHandlers {
    ArpgWindowCreated created;
    ArpgWindowVisibilityChanged opened;
    ArpgWindowVisibilityChanged closed;
    ArpgWindowUpdated updated;
    ArpgWindowPointerChanged pointerDown;
    ArpgWindowPointerChanged pointerUp;
    ArpgWindowPointerChanged pointerMove;
    ArpgWindowCustomEvent customEvent;


    /// 注册窗口实例化完成回调（全部控件实例化后触发一次）。
    void OnCreated(ArpgWindowCreated handler) { this.created = handler; }
    /// 注册窗口打开回调（Open 或初始可见时触发）。
    void OnOpened(ArpgWindowVisibilityChanged handler) {
        this.opened = handler;
    }
    /// 注册窗口关闭回调（Close 时触发一次）。
    void OnClosed(ArpgWindowVisibilityChanged handler) {
        this.closed = handler;
    }
    /// 注册窗口每帧更新回调（deltaMilliseconds 为帧间隔毫秒）。
    void OnUpdated(ArpgWindowUpdated handler) { this.updated = handler; }
    /// 注册窗口按下回调；返回 true 可消费事件。
    void OnPointerDown(ArpgWindowPointerChanged handler) {
        this.pointerDown = handler;
    }
    /// 注册窗口抬起回调；返回 true 可消费事件。
    void OnPointerUp(ArpgWindowPointerChanged handler) {
        this.pointerUp = handler;
    }
    /// 注册窗口移动回调；返回 true 可消费事件。
    void OnPointerMove(ArpgWindowPointerChanged handler) {
        this.pointerMove = handler;
    }
    /// 注册窗口自定义事件回调（由 FireCustom 触发）。
    void OnCustomEvent(ArpgWindowCustomEvent handler) {
        this.customEvent = handler;
    }

    /// 触发窗口实例化回调；未注册 handler 时为空操作。
    void RaiseCreated(string windowId) {
        ArpgWindowCreated handler = this.created;
        if (handler != null) { handler(windowId); }
    }

    /// 触发窗口打开回调；未注册 handler 时为空操作。
    void RaiseOpened(string windowId) {
        ArpgWindowVisibilityChanged handler = this.opened;
        if (handler != null) { handler(windowId); }
    }

    /// 触发窗口关闭回调；未注册 handler 时为空操作。
    void RaiseClosed(string windowId) {
        ArpgWindowVisibilityChanged handler = this.closed;
        if (handler != null) { handler(windowId); }
    }

    /// 触发窗口每帧更新回调；未注册 handler 时为空操作。
    void RaiseUpdated(string windowId, int deltaMilliseconds) {
        ArpgWindowUpdated handler = this.updated;
        if (handler != null) { handler(windowId, deltaMilliseconds); }
    }

    /// 触发窗口按下回调；未注册时返回 false（事件未消费）。
    bool RaisePointerDown(
        string windowId,
        string controlId,
        int button,
        int modifiers,
        double x,
        double y
    ) {
        ArpgWindowPointerChanged handler = this.pointerDown;
        if (handler == null) { return false; }
        return handler(windowId, controlId, button, modifiers, x, y);
    }

    /// 触发窗口抬起回调；未注册时返回 false（事件未消费）。
    bool RaisePointerUp(
        string windowId,
        string controlId,
        int button,
        int modifiers,
        double x,
        double y
    ) {
        ArpgWindowPointerChanged handler = this.pointerUp;
        if (handler == null) { return false; }
        return handler(windowId, controlId, button, modifiers, x, y);
    }

    /// 触发窗口移动回调；未注册时返回 false（事件未消费）。
    bool RaisePointerMove(
        string windowId,
        string controlId,
        int button,
        int modifiers,
        double x,
        double y
    ) {
        ArpgWindowPointerChanged handler = this.pointerMove;
        if (handler == null) { return false; }
        return handler(windowId, controlId, button, modifiers, x, y);
    }

    /// 触发窗口自定义事件回调；未注册 handler 时为空操作。
    void RaiseCustom(string windowId, string name, string payload) {
        ArpgWindowCustomEvent handler = this.customEvent;
        if (handler != null) { handler(windowId, name, payload); }
    }
}

/// <summary>
/// 节点类型常量：返回节点 kind 字符串（ArpgNodeDefinition 的 kind
/// 取值）。IsValid 判断任意字符串是否为受支持的节点类型。
/// </summary>
class ArpgNodeKind {
    /// 文本节点类型。
    static string Text() { return "text"; }
    /// 艺术字节点类型（支持描边渲染）。
    static string ArtText() { return "artText"; }
    /// 静态图片节点类型。
    static string Sprite() { return "sprite"; }
    /// 矩形色块节点类型。
    static string Rectangle() { return "rectangle"; }
    /// 圆形节点类型（按 Radius 渲染，缺省取宽高的一半）。
    static string Circle() { return "circle"; }
    /// 帧动画节点类型（按 AddAnimationFrame 的帧序列播放）。
    static string Animation() { return "animation"; }

    /// 判断 kind 是否为受支持的节点类型字符串。
    static bool IsValid(string kind) {
        return kind == Text()
            || kind == ArtText()
            || kind == Sprite()
            || kind == Rectangle()
            || kind == Circle()
            || kind == Animation();
    }
}

/// <summary>
/// 控件类型常量：返回控件 kind 字符串（ArpgControlDefinition 的
/// kind 取值）。Image/Progress 为旧别名。IsValid 判断任意字符串
/// 是否为受支持的控件类型。
/// </summary>
class ArpgControlKind {
    /// 标签控件类型（纯文本显示）。
    static string Label() { return "label"; }
    /// 按钮控件类型（可点击激活）。
    static string Button() { return "button"; }
    /// 图片框控件类型（背景贴图）。
    static string ImageBox() { return "imageBox"; }
    /// 文本框控件类型。
    static string TextBox() { return "textBox"; }
    /// 进度条控件类型（按 Value/Range 渲染填充条）。
    static string ProgressBar() { return "progressBar"; }
    /// 富文本控件类型（按富文本文档渲染）。
    static string RichTextBox() { return "richTextBox"; }
    /// ImageBox 的旧别名，语义相同。
    static string Image() { return ImageBox(); }
    /// ProgressBar 的旧别名，语义相同。
    static string Progress() { return ProgressBar(); }
    /// Prefab 控件类型（实例化时展开 Prefab 内的节点）。
    static string Prefab() { return "prefab"; }
    /// 自定义控件类型（渲染仅为背景/贴图，内容由业务自绘）。
    static string Custom() { return "custom"; }

    /// 判断 kind 是否为受支持的控件类型字符串。
    static bool IsValid(string kind) {
        return kind == Label()
            || kind == Button()
            || kind == ImageBox()
            || kind == TextBox()
            || kind == ProgressBar()
            || kind == RichTextBox()
            || kind == Prefab()
            || kind == Custom();
    }
}

/// <summary>
/// 文本对齐常量：Start=起始对齐（水平=左/垂直=顶），Center=居中，
/// End=末尾对齐（水平=右/垂直=底）。用于 HorizontalAlign/
/// VerticalAlign 风格属性与富文本排版。
/// </summary>
class ArpgTextAlign {
    /// 起始对齐（水平=左，垂直=顶）。
    static int Start() { return 0; }
    /// 居中对齐。
    static int Center() { return 1; }
    /// 末尾对齐（水平=右，垂直=底）。
    static int End() { return 2; }
}

/// <summary>
/// 九宫格贴图描述：四角/四边/中心各用一张资源 Id 拉伸或平铺填充，
/// SetInsets 决定四条边的留边宽度（像素）。构造时留边默认为 0，
/// 即全部区域用 Center 资源填充。
/// </summary>
class ArpgNineSlice {
    string topLeft;
    string top;
    string topRight;
    string left;
    string center;
    string right;
    string bottomLeft;
    string bottom;
    string bottomRight;
    int leftWidth;
    int topHeight;
    int rightWidth;
    int bottomHeight;

    /// 构造九宫格：依次传入左上/上/右上/左/中/右/左下/下/右下九块资源 Id；留边默认 0。
    ArpgNineSlice(
        string topLeft,
        string top,
        string topRight,
        string left,
        string center,
        string right,
        string bottomLeft,
        string bottom,
        string bottomRight
    ) {
        this.topLeft = topLeft;
        this.top = top;
        this.topRight = topRight;
        this.left = left;
        this.center = center;
        this.right = right;
        this.bottomLeft = bottomLeft;
        this.bottom = bottom;
        this.bottomRight = bottomRight;
        this.leftWidth = 0;
        this.topHeight = 0;
        this.rightWidth = 0;
        this.bottomHeight = 0;
    }

    /// 返回左上角资源 Id。
    string TopLeft() { return this.topLeft; }
    /// 返回上边资源 Id。
    string Top() { return this.top; }
    /// 返回右上角资源 Id。
    string TopRight() { return this.topRight; }
    /// 返回左边资源 Id。
    string Left() { return this.left; }
    /// 返回中心资源 Id。
    string Center() { return this.center; }
    /// 返回右边资源 Id。
    string Right() { return this.right; }
    /// 返回左下角资源 Id。
    string BottomLeft() { return this.bottomLeft; }
    /// 返回下边资源 Id。
    string Bottom() { return this.bottom; }
    /// 返回右下角资源 Id。
    string BottomRight() { return this.bottomRight; }
    /// 返回左边留边宽度（像素）。
    int LeftWidth() { return this.leftWidth; }
    /// 返回上边留边高度（像素）。
    int TopHeight() { return this.topHeight; }
    /// 返回右边留边宽度（像素）。
    int RightWidth() { return this.rightWidth; }
    /// 返回下边留边高度（像素）。
    int BottomHeight() { return this.bottomHeight; }

    /// 设置四边留边（像素）；负值一律按 0 处理。
    void SetInsets(int left, int top, int right, int bottom) {
        this.leftWidth = ArpgMath.Max(0, left);
        this.topHeight = ArpgMath.Max(0, top);
        this.rightWidth = ArpgMath.Max(0, right);
        this.bottomHeight = ArpgMath.Max(0, bottom);
    }
}

/// <summary>
/// 鼠标按键常量：Left=0，Right=1，Middle=2。指针事件回调的 button
/// 参数取这些值。FromSdl 将 SDL 原生按键编号转换为上述值（未知按
/// 键视为左键）。
/// </summary>
class ArpgPointerButton {
    /// 鼠标左键。
    static int Left() { return 0; }
    /// 鼠标右键。
    static int Right() { return 1; }
    /// 鼠标中键。
    static int Middle() { return 2; }

    /// 将 SDL 按键编号映射为 Left/Right/Middle；其他值视为左键。
    static int FromSdl(int button) {
        if (button == SdlMouseButton.Right()) { return Right(); }
        if (button == SdlMouseButton.Middle()) { return Middle(); }
        return Left();
    }
}

/// <summary>
/// UI 节点定义：静态描述一个节点（文本/精灵/矩形/圆/动画等）的
/// 位置、尺寸、变换、样式、内容与事件。所有数值属性 x/y/width/
/// height 均为像素，坐标相对所属控件原点。构造时各属性取默认值
/// （可见、不透明、缩放 1、字号 16、帧率 12、循环自动播放等），
/// 通过 Set* 方法修改；Validate 校验定义合法性并向 diagnostics
/// 写入错误。
/// </summary>
class ArpgNodeDefinition {
    string id;
    string kind;
    int x;
    int y;
    int width;
    int height;
    int order;
    bool visible;
    bool mouseEvents;
    double anchorX;
    double anchorY;
    double scaleX;
    double scaleY;
    int angle;
    double opacity;
    bool clip;
    bool richText;
    string content;
    string resource;
    ArpgColor color;
    ArpgColor backgroundColor;
    ArpgColor borderColor;
    ArpgColor outlineColor;
    int borderWidth;
    int radius;
    int fontSize;
    int horizontalAlign;
    int verticalAlign;
    bool wrap;
    int lineSpacing;
    int frameRate;
    bool loopAnimation;
    bool autoPlay;
    List<string> animationFrames;
    ArpgNineSlice nineSlice;
    ArpgDataSource dataSource;
    ArpgNodeEventHandlers events;

    /// 构造节点定义：id 为节点唯一标识，kind 取 ArpgNodeKind 常量，x/y/width/height 为像素。
    ArpgNodeDefinition(
        string id,
        string kind,
        int x,
        int y,
        int width,
        int height
    ) {
        this.id = id;
        this.kind = kind;
        this.x = x;
        this.y = y;
        this.width = width;
        this.height = height;
        this.order = 0;
        this.visible = true;
        this.mouseEvents = false;
        this.anchorX = 0.0;
        this.anchorY = 0.0;
        this.scaleX = 1.0;
        this.scaleY = 1.0;
        this.angle = 0;
        this.opacity = 1.0;
        this.clip = false;
        this.richText = false;
        this.content = "";
        this.resource = "";
        this.color = ArpgColor.White();
        this.backgroundColor = ArpgColor.Transparent();
        this.borderColor = ArpgColor.Transparent();
        this.outlineColor = ArpgColor.Transparent();
        this.borderWidth = 0;
        this.radius = 0;
        this.fontSize = 16;
        this.horizontalAlign = ArpgTextAlign.Start();
        this.verticalAlign = ArpgTextAlign.Start();
        this.wrap = false;
        this.lineSpacing = 0;
        this.frameRate = 12;
        this.loopAnimation = true;
        this.autoPlay = true;
        this.animationFrames = new List<string>();
        this.nineSlice = null;
        this.dataSource = null;
        this.events = new ArpgNodeEventHandlers();
    }

    /// 返回节点唯一 Id。
    string Id() { return this.id; }
    /// 返回节点类型（ArpgNodeKind 字符串）。
    string Kind() { return this.kind; }
    /// 返回节点 X 坐标（像素，相对控件原点）。
    int X() { return this.x; }
    /// 返回节点 Y 坐标（像素，相对控件原点）。
    int Y() { return this.y; }
    /// 返回节点宽度（像素）。
    int Width() { return this.width; }
    /// 返回节点高度（像素）。
    int Height() { return this.height; }
    /// 返回绘制顺序；同区域按值从小到大后绘制（数值大者在上层）。
    int Order() { return this.order; }
    /// 返回节点是否可见（默认 true）。
    bool Visible() { return this.visible; }
    /// 返回节点是否接收鼠标事件（默认 false）。
    bool MouseEvents() { return this.mouseEvents; }
    /// 返回水平锚点（0=左缘，1=右缘）。
    double AnchorX() { return this.anchorX; }
    /// 返回垂直锚点（0=上缘，1=下缘）。
    double AnchorY() { return this.anchorY; }
    /// 返回水平缩放系数。
    double ScaleX() { return this.scaleX; }
    /// 返回垂直缩放系数。
    double ScaleY() { return this.scaleY; }
    /// 返回旋转角度（度，顺时针）。
    int Angle() { return this.angle; }
    /// 返回不透明度（0.0~1.0）。
    double Opacity() { return this.opacity; }
    /// 返回是否把子内容裁剪到节点边界内。
    bool Clip() { return this.clip; }
    /// 返回内容是否按富文本解析（由 SetContent 指定）。
    bool RichText() { return this.richText; }
    /// 返回文本内容（模板占位符原文，运行时才求值）。
    string Content() { return this.content; }
    /// 返回贴图资源 Id（动画节点返回空，帧序列用 AddAnimationFrame）。
    string Resource() { return this.resource; }
    /// 返回前景/文字颜色。
    ArpgColor Color() { return this.color; }
    /// 返回背景色。
    ArpgColor BackgroundColor() { return this.backgroundColor; }
    /// 返回边框颜色。
    ArpgColor BorderColor() { return this.borderColor; }
    /// 返回描边颜色（仅 ArtText 使用）。
    ArpgColor OutlineColor() { return this.outlineColor; }
    /// 返回边框宽度（像素）。
    int BorderWidth() { return this.borderWidth; }
    /// 返回圆角半径（像素，仅矩形节点使用；圆节点另用 SetRadius）。
    int Radius() { return this.radius; }
    /// 返回字体大小（像素，默认 16）。
    int FontSize() { return this.fontSize; }
    /// 返回水平对齐（ArpgTextAlign 常量）。
    int HorizontalAlign() { return this.horizontalAlign; }
    /// 返回垂直对齐（ArpgTextAlign 常量）。
    int VerticalAlign() { return this.verticalAlign; }
    /// 返回文本是否自动换行。
    bool Wrap() { return this.wrap; }
    /// 返回行间距（像素）。
    int LineSpacing() { return this.lineSpacing; }
    /// 返回动画帧率（帧/秒，默认 12）。
    int FrameRate() { return this.frameRate; }
    /// 返回动画是否循环播放（默认 true）。
    bool LoopAnimation() { return this.loopAnimation; }
    /// 返回动画是否创建即播放（默认 true）。
    bool AutoPlay() { return this.autoPlay; }
    /// 返回动画帧数量（未添加帧时为 0）。
    int AnimationFrameCount() { return this.animationFrames.Count; }
    /// 返回第 index 帧的资源 Id；index 越界行为未定义（调用方需保证 0 <= index < AnimationFrameCount）。
    string AnimationFrameAt(int index) { return this.animationFrames[index]; }
    /// 返回九宫格描述；未设置时为 null。
    ArpgNineSlice NineSlice() { return this.nineSlice; }
    /// 返回数据源；未设置时为 null（运行时继承控件/窗口数据源）。
    ArpgDataSource DataSource() { return this.dataSource; }
    /// 返回节点事件槽位集合（单播）。
    ArpgNodeEventHandlers Events() { return this.events; }

    /// 设置绘制顺序（数值大者后绘制、显示在上层）。
    void SetOrder(int newValue) { this.order = newValue; }
    /// 设置节点可见性。
    void SetVisible(bool newValue) { this.visible = newValue; }
    /// 设置节点是否接收鼠标事件。
    void SetMouseEvents(bool newValue) { this.mouseEvents = newValue; }
    /// 设置锚点（0=左/上缘，1=右/下缘；缩放与旋转围绕锚点）。
    void SetAnchor(double x, double y) {
        this.anchorX = x;
        this.anchorY = y;
    }
    /// 设置缩放系数（1.0 为原始尺寸）。
    void SetScale(double x, double y) {
        this.scaleX = x;
        this.scaleY = y;
    }
    /// 设置旋转角度（度，顺时针）。
    void SetAngle(int newValue) { this.angle = newValue; }
    /// 设置不透明度；超出 [0.0, 1.0] 的值被钳制。
    void SetOpacity(double newValue) {
        this.opacity = ArpgMath.ClampDouble(newValue, 0.0, 1.0);
    }
    /// 设置是否把内容裁剪到节点边界内。
    void SetClip(bool newValue) { this.clip = newValue; }
    /// 设置文本内容；richText=true 时按富文本标记解析。
    void SetContent(string newValue, bool richText) {
        this.content = newValue;
        this.richText = richText;
    }
    /// 设置贴图资源 Id。
    void SetResource(string newValue) { this.resource = newValue; }
    /// 设置前景/文字颜色。
    void SetColor(ArpgColor newValue) { this.color = newValue; }
    /// 设置背景色。
    void SetBackgroundColor(ArpgColor newValue) {
        this.backgroundColor = newValue;
    }
    /// 设置边框；宽度为负时按 0 处理。
    void SetBorder(int width, ArpgColor color) {
        this.borderWidth = ArpgMath.Max(0, width);
        this.borderColor = color;
    }
    /// 设置描边颜色（仅 ArtText 节点生效）。
    void SetOutlineColor(ArpgColor newValue) {
        this.outlineColor = newValue;
    }
    /// 设置圆角半径；负值按 0 处理。
    void SetRadius(int newValue) {
        this.radius = ArpgMath.Max(0, newValue);
    }
    /// 设置文本样式；fontSize 小于 1 按 1 处理，lineSpacing 负值按 0 处理。
    void SetTextStyle(
        int fontSize,
        int horizontalAlign,
        int verticalAlign,
        bool wrap,
        int lineSpacing
    ) {
        this.fontSize = ArpgMath.Max(1, fontSize);
        this.horizontalAlign = horizontalAlign;
        this.verticalAlign = verticalAlign;
        this.wrap = wrap;
        this.lineSpacing = ArpgMath.Max(0, lineSpacing);
    }
    /// 设置动画参数；frameRate 小于 1 按 1 处理，loop 为是否循环，play 为是否自动播放。
    void SetAnimation(int frameRate, bool loop, bool play) {
        this.frameRate = ArpgMath.Max(1, frameRate);
        this.loopAnimation = loop;
        this.autoPlay = play;
    }
    /// 追加一帧动画资源 Id（按添加顺序播放）。
    void AddAnimationFrame(string resource) {
        this.animationFrames.Add(resource);
    }
    /// 设置九宫格描述；传 null 取消九宫格渲染。
    void SetNineSlice(ArpgNineSlice newValue) { this.nineSlice = newValue; }
    /// 设置节点私有数据源；设为 null 时恢复继承控件/窗口数据源。
    void SetDataSource(ArpgDataSource newValue) { this.dataSource = newValue; }

    /// 校验定义合法性：Id 非空、kind 受支持、尺寸非负、缩放大于 0、样式与帧率合法；错误写入 diagnostics。
    void Validate(ArpgDiagnostics diagnostics, string parentPath) {
        string path = parentPath + ".nodes." + this.id;
        ArpgValidation.Required(
            diagnostics, this.id, parentPath + ".nodes", "L2NOD001");
        if (!ArpgNodeKind.IsValid(this.kind)) {
            diagnostics.AddError(
                "L2NOD002", path + ".kind", "Unsupported node kind.");
        }
        if (this.width < 0 || this.height < 0) {
            diagnostics.AddError(
                "L2NOD003", path + ".size", "Node size cannot be negative.");
        }
        if (this.scaleX <= 0.0 || this.scaleY <= 0.0) {
            diagnostics.AddError(
                "L2NOD004", path + ".scale", "Node scale must be greater than zero.");
        }
        if (this.borderWidth < 0 || this.radius < 0 || this.fontSize <= 0) {
            diagnostics.AddError(
                "L2NOD005", path + ".style", "Node style dimensions are invalid.");
        }
        if (this.frameRate <= 0) {
            diagnostics.AddError(
                "L2NOD006", path + ".frameRate", "Frame rate must be positive.");
        }
    }
}

/// <summary>
/// UI 控件定义：静态描述一个控件（标签/按钮/图片框/进度条等），
/// 含位置尺寸、状态（可见/可用/选中）、文本样式、数值范围、
/// Prefab 引用与子节点列表。坐标相对所属窗口原点。构造时取默认
/// 值（可用、不透明、数值范围 [0, 100] 等），通过 Set* 修改；
/// Validate 递归校验控件与子节点并向 diagnostics 写入错误。
/// </summary>
class ArpgControlDefinition {
    string id;
    string kind;
    int x;
    int y;
    int width;
    int height;
    int order;
    bool visible;
    bool enabled;
    bool mouseEvents;
    bool draggable;
    bool selected;
    double anchorX;
    double anchorY;
    double scaleX;
    double scaleY;
    int angle;
    double opacity;
    bool clip;
    bool richText;
    string title;
    string content;
    string resource;
    string prefabId;
    ArpgColor backgroundColor;
    ArpgColor borderColor;
    ArpgColor textColor;
    ArpgColor hoverColor;
    ArpgColor pressedColor;
    ArpgColor disabledColor;
    int borderWidth;
    int fontSize;
    int horizontalAlign;
    int verticalAlign;
    bool wrap;
    int lineSpacing;
    double minimum;
    double maximum;
    double currentValue;
    ArpgNineSlice nineSlice;
    ArpgDataSource dataSource;
    List<ArpgNodeDefinition> nodes;
    ArpgControlEventHandlers events;

    /// 构造控件定义：id 为控件唯一标识，kind 取 ArpgControlKind 常量，x/y/width/height 为像素。
    ArpgControlDefinition(
        string id,
        string kind,
        int x,
        int y,
        int width,
        int height
    ) {
        this.id = id;
        this.kind = kind;
        this.x = x;
        this.y = y;
        this.width = width;
        this.height = height;
        this.order = 0;
        this.visible = true;
        this.enabled = true;
        this.mouseEvents = false;
        this.draggable = false;
        this.selected = false;
        this.anchorX = 0.0;
        this.anchorY = 0.0;
        this.scaleX = 1.0;
        this.scaleY = 1.0;
        this.angle = 0;
        this.opacity = 1.0;
        this.clip = false;
        this.richText = false;
        this.title = "";
        this.content = "";
        this.resource = "";
        this.prefabId = "";
        this.backgroundColor = ArpgColor.Transparent();
        this.borderColor = ArpgColor.Transparent();
        this.textColor = ArpgColor.White();
        this.hoverColor = new ArpgColor(255, 255, 255, 32);
        this.pressedColor = new ArpgColor(255, 255, 255, 64);
        this.disabledColor = new ArpgColor(128, 128, 128, 128);
        this.borderWidth = 0;
        this.fontSize = 16;
        this.horizontalAlign = ArpgTextAlign.Start();
        this.verticalAlign = ArpgTextAlign.Start();
        this.wrap = false;
        this.lineSpacing = 0;
        this.minimum = 0.0;
        this.maximum = 100.0;
        this.currentValue = 0.0;
        this.nineSlice = null;
        this.dataSource = null;
        this.nodes = new List<ArpgNodeDefinition>();
        this.events = new ArpgControlEventHandlers();
    }

    /// 返回控件唯一 Id。
    string Id() { return this.id; }
    /// 返回控件类型（ArpgControlKind 字符串）。
    string Kind() { return this.kind; }
    /// 返回控件 X 坐标（像素，相对窗口原点）。
    int X() { return this.x; }
    /// 返回控件 Y 坐标（像素，相对窗口原点）。
    int Y() { return this.y; }
    /// 返回控件宽度（像素）。
    int Width() { return this.width; }
    /// 返回控件高度（像素）。
    int Height() { return this.height; }
    /// 返回绘制顺序；数值大者在上层。
    int Order() { return this.order; }
    /// 返回控件是否可见（默认 true）。
    bool Visible() { return this.visible; }
    /// 返回控件是否可用（默认 true；不可用时灰显且不响应指针）。
    bool Enabled() { return this.enabled; }
    /// 返回控件是否接收鼠标事件（默认 false）。
    bool MouseEvents() { return this.mouseEvents; }
    /// 返回控件是否可拖拽。
    bool Draggable() { return this.draggable; }
    /// 返回控件初始选中状态。
    bool Selected() { return this.selected; }
    /// 返回水平锚点（0=左缘，1=右缘）。
    double AnchorX() { return this.anchorX; }
    /// 返回垂直锚点（0=上缘，1=下缘）。
    double AnchorY() { return this.anchorY; }
    /// 返回水平缩放系数。
    double ScaleX() { return this.scaleX; }
    /// 返回垂直缩放系数。
    double ScaleY() { return this.scaleY; }
    /// 返回旋转角度（度，顺时针）。
    int Angle() { return this.angle; }
    /// 返回不透明度（0.0~1.0）。
    double Opacity() { return this.opacity; }
    /// 返回是否把子节点裁剪到控件边界内。
    bool Clip() { return this.clip; }
    /// 返回内容是否按富文本解析。
    bool RichText() { return this.richText; }
    /// 返回标题（按钮渲染其标题，其他控件多用于窗口栏文本）。
    string Title() { return this.title; }
    /// 返回文本内容（模板占位符原文，运行时才求值）。
    string Content() { return this.content; }
    /// 返回贴图资源 Id。
    string Resource() { return this.resource; }
    /// 返回 Prefab Id；为空串表示不是 Prefab 控件。
    string PrefabId() { return this.prefabId; }
    /// 返回背景色。
    ArpgColor BackgroundColor() { return this.backgroundColor; }
    /// 返回边框颜色。
    ArpgColor BorderColor() { return this.borderColor; }
    /// 返回文字颜色（进度条也用它渲染填充条）。
    ArpgColor TextColor() { return this.textColor; }
    /// 返回悬停叠加色。
    ArpgColor HoverColor() { return this.hoverColor; }
    /// 返回按下叠加色。
    ArpgColor PressedColor() { return this.pressedColor; }
    /// 返回禁用叠加色。
    ArpgColor DisabledColor() { return this.disabledColor; }
    /// 返回边框宽度（像素）。
    int BorderWidth() { return this.borderWidth; }
    /// 返回字体大小（像素，默认 16）。
    int FontSize() { return this.fontSize; }
    /// 返回水平对齐（ArpgTextAlign 常量）。
    int HorizontalAlign() { return this.horizontalAlign; }
    /// 返回垂直对齐（ArpgTextAlign 常量）。
    int VerticalAlign() { return this.verticalAlign; }
    /// 返回文本是否自动换行。
    bool Wrap() { return this.wrap; }
    /// 返回行间距（像素）。
    int LineSpacing() { return this.lineSpacing; }
    /// 返回数值范围下限（默认 0）。
    double Minimum() { return this.minimum; }
    /// 返回数值范围上限（默认 100）。
    double Maximum() { return this.maximum; }
    /// 返回初始数值（已按范围钳制，默认 0）。
    double Value() { return this.currentValue; }
    /// 返回九宫格描述；未设置时为 null。
    ArpgNineSlice NineSlice() { return this.nineSlice; }
    /// 返回数据源；未设置时为 null（运行时继承窗口默认数据源）。
    ArpgDataSource DataSource() { return this.dataSource; }
    /// 返回子节点定义数量。
    int NodeCount() { return this.nodes.Count; }
    /// 返回第 index 个子节点定义；index 须在 [0, NodeCount) 内。
    ArpgNodeDefinition NodeAt(int index) { return this.nodes[index]; }
    /// 返回控件事件槽位集合（单播）。
    ArpgControlEventHandlers Events() { return this.events; }

    /// 设置绘制顺序（数值大者显示在上层）。
    void SetOrder(int newValue) { this.order = newValue; }
    /// 设置控件可见性。
    void SetVisible(bool newValue) { this.visible = newValue; }
    /// 设置控件可用性。
    void SetEnabled(bool newValue) { this.enabled = newValue; }
    /// 设置控件是否接收鼠标事件。
    void SetMouseEvents(bool newValue) { this.mouseEvents = newValue; }
    /// 设置控件是否可拖拽。
    void SetDraggable(bool newValue) { this.draggable = newValue; }
    /// 设置控件选中状态。
    void SetSelected(bool newValue) { this.selected = newValue; }
    /// 设置锚点（0=左/上缘，1=右/下缘）。
    void SetAnchor(double x, double y) {
        this.anchorX = x;
        this.anchorY = y;
    }
    /// 设置缩放系数（1.0 为原始尺寸）。
    void SetScale(double x, double y) {
        this.scaleX = x;
        this.scaleY = y;
    }
    /// 设置旋转角度（度，顺时针）。
    void SetAngle(int newValue) { this.angle = newValue; }
    /// 设置不透明度；超出 [0.0, 1.0] 的值被钳制。
    void SetOpacity(double newValue) {
        this.opacity = ArpgMath.ClampDouble(newValue, 0.0, 1.0);
    }
    /// 设置是否把子节点裁剪到控件边界内。
    void SetClip(bool newValue) { this.clip = newValue; }
    /// 设置标题（按钮渲染其标题）。
    void SetTitle(string newValue) { this.title = newValue; }
    /// 设置文本内容；richText=true 时按富文本标记解析。
    void SetContent(string newValue, bool richText) {
        this.content = newValue;
        this.richText = richText;
    }
    /// 设置贴图资源 Id。
    void SetResource(string newValue) { this.resource = newValue; }
    /// 设置 Prefab Id；空串表示不是 Prefab 控件。
    void SetPrefabId(string newValue) { this.prefabId = newValue; }
    /// 设置背景色。
    void SetBackgroundColor(ArpgColor newValue) {
        this.backgroundColor = newValue;
    }
    /// 设置边框（此定义层不钳制负值，Validate 会报错）。
    void SetBorder(int width, ArpgColor color) {
        this.borderWidth = width;
        this.borderColor = color;
    }
    /// 设置文字颜色。
    void SetTextColor(ArpgColor newValue) { this.textColor = newValue; }
    /// 一次性设置悬停/按下/禁用三种状态叠加色。
    void SetStateColors(
        ArpgColor hover,
        ArpgColor pressed,
        ArpgColor disabled
    ) {
        this.hoverColor = hover;
        this.pressedColor = pressed;
        this.disabledColor = disabled;
    }
    /// 设置文本样式；fontSize 小于 1 按 1 处理，lineSpacing 负值按 0 处理。
    void SetTextStyle(
        int fontSize,
        int horizontalAlign,
        int verticalAlign,
        bool wrap,
        int lineSpacing
    ) {
        this.fontSize = ArpgMath.Max(1, fontSize);
        this.horizontalAlign = horizontalAlign;
        this.verticalAlign = verticalAlign;
        this.wrap = wrap;
        this.lineSpacing = ArpgMath.Max(0, lineSpacing);
    }
    /// 设置数值范围与初始值；initialValue 钳制到 [minimum, maximum]。
    void SetRange(double minimum, double maximum, double newValue) {
        this.minimum = minimum;
        this.maximum = maximum;
        this.currentValue = ArpgMath.ClampDouble(
            newValue, minimum, maximum);
    }
    /// 设置当前数值；钳制到 [Minimum, Maximum]（默认 [0, 100]）。
    void SetValue(double newValue) {
        this.currentValue = ArpgMath.ClampDouble(
            newValue, this.minimum, this.maximum);
    }
    /// 设置九宫格描述；传 null 取消九宫格渲染。
    void SetNineSlice(ArpgNineSlice newValue) { this.nineSlice = newValue; }
    /// 设置控件私有数据源；设为 null 时恢复继承窗口默认数据源。
    void SetDataSource(ArpgDataSource newValue) { this.dataSource = newValue; }
    /// 追加一个子节点定义（按添加顺序保存，渲染时按 Order 排序）。
    void AddNode(ArpgNodeDefinition node) { this.nodes.Add(node); }

    /// 校验定义合法性：Id/kind 非空、kind 受支持、尺寸与边框非负、缩放大于 0、字号为正、范围上限大于下限、子节点 Id 不重复；错误写入 diagnostics。
    void Validate(ArpgDiagnostics diagnostics, string parentPath) {
        string path = parentPath + ".controls." + this.id;
        ArpgValidation.Required(
            diagnostics, this.id, parentPath + ".controls", "L2CTL001");
        ArpgValidation.Required(
            diagnostics, this.kind, path + ".kind", "L2CTL002");
        if (!ArpgControlKind.IsValid(this.kind)) {
            diagnostics.AddError(
                "L2CTL006", path + ".kind", "Unsupported control kind.");
        }
        if (this.width < 0 || this.height < 0) {
            diagnostics.AddError(
                "L2CTL003", path + ".size", "Control size cannot be negative.");
        }
        if (this.borderWidth < 0) {
            diagnostics.AddError(
                "L2CTL004", path + ".borderWidth", "Border width cannot be negative.");
        }
        if (this.scaleX <= 0.0 || this.scaleY <= 0.0) {
            diagnostics.AddError(
                "L2CTL007", path + ".scale", "Control scale must be greater than zero.");
        }
        if (this.fontSize <= 0) {
            diagnostics.AddError(
                "L2CTL008", path + ".fontSize", "Font size must be positive.");
        }
        if (this.maximum <= this.minimum) {
            diagnostics.AddError(
                "L2CTL009", path + ".range", "Maximum must be greater than minimum.");
        }
        for (int i = 0; i < this.nodes.Count; i = i + 1) {
            this.nodes[i].Validate(diagnostics, path);
            int j = i + 1;
            while (j < this.nodes.Count) {
                if (this.nodes[i].Id() == this.nodes[j].Id()) {
                    diagnostics.AddError(
                        "L2CTL005", path + ".nodes", "Duplicate node id.");
                }
                j = j + 1;
            }
        }
    }
}

/// <summary>
/// UI 节点运行时实例：由 ArpgNodeDefinition 构造，包装定义并提供
/// 求值后的内容/富文本文档、动画播放状态与指针命中测试。大部分
/// 属性读取透传定义；Content() 返回模板求值后的文本，Resource()
/// 在动画节点上返回当前帧资源。构造时即触发 Created 事件。
/// </summary>
class ArpgNode {
    ArpgNodeDefinition definition;
    ArpgDataSource dataSource;
    string evaluatedContent;
    ArpgRichTextDocument document;
    bool focused;
    bool inheritedDataSource;
    bool playing;
    int frameIndex;
    int frameElapsed;

    /// 构造节点实例；defaultSource 为定义未绑定数据源时的继承来源，构造即触发 Created 事件。
    ArpgNode(
        ArpgNodeDefinition definition,
        ArpgDataSource defaultSource
    ) {
        this.definition = definition;
        this.dataSource = definition.DataSource();
        this.inheritedDataSource = this.dataSource == null;
        if (this.inheritedDataSource) { this.dataSource = defaultSource; }
        this.evaluatedContent = "";
        this.document = new ArpgRichTextDocument("");
        this.focused = false;
        this.playing = definition.AutoPlay();
        this.frameIndex = 0;
        this.frameElapsed = 0;
        this.Evaluate();
        definition.Events().RaiseCreated(this.Id());
    }

    /// 返回节点唯一 Id（同定义 Id）。
    string Id() { return this.definition.Id(); }
    /// 返回节点类型字符串。
    string Kind() { return this.definition.Kind(); }
    /// 返回节点 X 坐标（像素，相对控件原点）。
    int X() { return this.definition.X(); }
    /// 返回节点 Y 坐标（像素，相对控件原点）。
    int Y() { return this.definition.Y(); }
    /// 返回节点宽度（像素）。
    int Width() { return this.definition.Width(); }
    /// 返回节点高度（像素）。
    int Height() { return this.definition.Height(); }
    /// 返回绘制顺序；数值大者在上层。
    int Order() { return this.definition.Order(); }
    /// 返回节点是否可见。
    bool Visible() { return this.definition.Visible(); }
    /// 返回节点是否接收鼠标事件。
    bool MouseEvents() { return this.definition.MouseEvents(); }
    /// 返回水平锚点（0=左缘，1=右缘）。
    double AnchorX() { return this.definition.AnchorX(); }
    /// 返回垂直锚点（0=上缘，1=下缘）。
    double AnchorY() { return this.definition.AnchorY(); }
    /// 返回水平缩放系数。
    double ScaleX() { return this.definition.ScaleX(); }
    /// 返回垂直缩放系数。
    double ScaleY() { return this.definition.ScaleY(); }
    /// 返回旋转角度（度，顺时针）。
    int Angle() { return this.definition.Angle(); }
    /// 返回不透明度（0.0~1.0）。
    double Opacity() { return this.definition.Opacity(); }
    /// 返回是否把内容裁剪到节点边界内。
    bool Clip() { return this.definition.Clip(); }
    /// 返回模板求值后的文本内容（含 AppendContent 追加部分在控件层才生效，节点层仅定义内容求值）。
    string Content() { return this.evaluatedContent; }
    /// 返回当前生效的资源 Id：动画节点返回当前帧资源，其他节点返回定义资源。
    string Resource() {
        if (this.definition.AnimationFrameCount() > 0) {
            return this.definition.AnimationFrameAt(this.frameIndex);
        }
        return this.definition.Resource();
    }
    /// 返回前景/文字颜色。
    ArpgColor Color() { return this.definition.Color(); }
    /// 返回背景色。
    ArpgColor BackgroundColor() {
        return this.definition.BackgroundColor();
    }
    /// 返回边框颜色。
    ArpgColor BorderColor() { return this.definition.BorderColor(); }
    /// 返回描边颜色（仅 ArtText 使用）。
    ArpgColor OutlineColor() { return this.definition.OutlineColor(); }
    /// 返回边框宽度（像素）。
    int BorderWidth() { return this.definition.BorderWidth(); }
    /// 返回圆角半径（像素）。
    int Radius() { return this.definition.Radius(); }
    /// 返回字体大小（像素）。
    int FontSize() { return this.definition.FontSize(); }
    /// 返回水平对齐（ArpgTextAlign 常量）。
    int HorizontalAlign() { return this.definition.HorizontalAlign(); }
    /// 返回垂直对齐（ArpgTextAlign 常量）。
    int VerticalAlign() { return this.definition.VerticalAlign(); }
    /// 返回文本是否自动换行。
    bool Wrap() { return this.definition.Wrap(); }
    /// 返回行间距（像素）。
    int LineSpacing() { return this.definition.LineSpacing(); }
    /// 返回九宫格描述；未设置时为 null。
    ArpgNineSlice NineSlice() { return this.definition.NineSlice(); }
    /// 返回动画是否正在播放。
    bool Playing() { return this.playing; }
    /// 返回当前动画帧索引（从 0 开始）。
    int FrameIndex() { return this.frameIndex; }
    /// 返回求值后的富文本文档（非富文本节点为单 run 文档）。
    ArpgRichTextDocument Document() { return this.document; }
    /// 返回节点事件槽位集合（单播）。
    ArpgNodeEventHandlers Events() { return this.definition.Events(); }
    /// 返回节点当前生效的数据源（私有的或继承的）。
    ArpgDataSource DataSource() { return this.dataSource; }
    /// 返回节点是否正在使用继承来的数据源（定义未绑定私有数据源时为 true）。
    bool UsesInheritedDataSource() { return this.inheritedDataSource; }

    /// 设置节点私有数据源并立即重新求值内容；之后不再继承。
    void SetDataSource(ArpgDataSource newValue) {
        this.dataSource = newValue;
        this.inheritedDataSource = false;
        this.Evaluate();
    }

    /// 设置继承数据源并立即重新求值内容（继承标记保持为 true）。
    void SetInheritedDataSource(ArpgDataSource newValue) {
        this.dataSource = newValue;
        this.inheritedDataSource = true;
        this.Evaluate();
    }

    /// 重新求值内容：模板占位符按当前数据源替换，富文本节点重新解析文档；框架每帧调用，业务一般无需手动调用。
    void Evaluate() {
        this.evaluatedContent = ArpgTemplate.Evaluate(
            this.definition.Content(), this.dataSource);
        if (this.definition.RichText()) {
            this.document = ArpgRichText.Parse(
                this.definition.Content(), this.dataSource);
        } else {
            this.document = new ArpgRichTextDocument(
                this.evaluatedContent);
            if (this.evaluatedContent != "") {
                ArpgRichTextRun run =
                    ArpgRichTextRun.CreateText(this.evaluatedContent);
                this.document.Add(run);
            }
        }
    }

    /// 每帧推进：重新求值内容，并按帧率推进动画帧（到末尾时按 LoopAnimation 循环或停在最后一帧）；随后触发 Updated 事件。
    void Update(int deltaMilliseconds) {
        this.Evaluate();
        if (this.Kind() == ArpgNodeKind.Animation()
            && this.playing
            && this.definition.AnimationFrameCount() > 1) {
            this.frameElapsed = this.frameElapsed + deltaMilliseconds;
            int frameTime = 1000 / this.definition.FrameRate();
            while (this.frameElapsed >= frameTime) {
                this.frameElapsed = this.frameElapsed - frameTime;
                this.frameIndex = this.frameIndex + 1;
                if (this.frameIndex >= this.definition.AnimationFrameCount()) {
                    if (this.definition.LoopAnimation()) {
                        this.frameIndex = 0;
                    } else {
                        this.frameIndex =
                            this.definition.AnimationFrameCount() - 1;
                        this.playing = false;
                    }
                }
            }
        }
        this.definition.Events().RaiseUpdated(this.Id(), deltaMilliseconds);
    }

    /// 恢复动画播放。
    void Play() { this.playing = true; }
    /// 暂停动画（停在当前帧）。
    void Pause() { this.playing = false; }
    /// 把动画重置回第 0 帧（不改变播放状态）。
    void ResetAnimation() {
        this.frameIndex = 0;
        this.frameElapsed = 0;
    }

    /// 命中测试：localX/localY 为节点局部坐标（相对节点原点），可见节点按缩放与锚点计算的实际矩形判断，命中返回 true。
    bool HitTest(double localX, double localY) {
        double width = (double)this.Width() * this.ScaleX();
        double height = (double)this.Height() * this.ScaleY();
        double x = (double)this.X() - width * this.AnchorX();
        double y = (double)this.Y() - height * this.AnchorY();
        return this.Visible()
            && localX >= x
            && localY >= y
            && localX < x + width
            && localY < y + height;
    }

    /// 设置焦点状态；变化时触发 FocusChanged 事件，不变时为空操作。
    void SetFocused(bool newValue) {
        if (this.focused == newValue) { return; }
        this.focused = newValue;
        this.definition.Events().RaiseFocusChanged(this.Id(), newValue);
    }

    /// 触发节点自定义事件（payload 原样透传给 OnCustomEvent 注册的 handler）。
    void FireCustom(string name, string payload) {
        this.definition.Events().RaiseCustom(this.Id(), name, payload);
    }
}

/// <summary>
/// UI 控件运行时实例：由 ArpgControlDefinition 构造，持有展开后的
/// 子节点（含 Prefab 节点）、求值后的标题/内容/富文本文档与指针
/// 交互状态（悬停/按下/拖拽/焦点）。数值属性经 SetValue 修改并钳
/// 制到范围，变化时触发 ValueChanged；按钮在区域内按下-抬起时触发
/// Activated。构造时即触发 Created 事件。
/// </summary>
class ArpgControl {
    ArpgControlDefinition definition;
    string windowId;
    ArpgEvents systemEvents;
    ArpgDataSource dataSource;
    List<ArpgNode> nodes;
    string evaluatedTitle;
    string evaluatedContent;
    ArpgRichTextDocument document;
    ArpgControlEventHandlers prefabEvents;
    int x;
    int y;
    bool visible;
    bool enabled;
    bool focused;
    bool hovered;
    bool pressed;
    bool dragging;
    bool selected;
    double currentValue;
    string appendedContent;

    /// 构造控件实例：展开定义与 Prefab 的子节点；PrefabId 找不到对应 Prefab 时静默忽略；构造即触发 Created 事件。
    ArpgControl(
        ArpgControlDefinition definition,
        string windowId,
        ArpgDataSource defaultSource,
        ArpgProject project,
        ArpgEvents systemEvents
    ) {
        this.definition = definition;
        this.windowId = windowId;
        this.systemEvents = systemEvents;
        this.dataSource = definition.DataSource();
        if (this.dataSource == null) {
            this.dataSource = defaultSource;
        }
        this.nodes = new List<ArpgNode>();
        this.evaluatedTitle = "";
        this.evaluatedContent = "";
        this.document = new ArpgRichTextDocument("");
        this.prefabEvents = null;
        this.x = definition.X();
        this.y = definition.Y();
        this.visible = definition.Visible();
        this.enabled = definition.Enabled();
        this.focused = false;
        this.hovered = false;
        this.pressed = false;
        this.dragging = false;
        this.selected = definition.Selected();
        this.currentValue = definition.Value();
        this.appendedContent = "";

        int i = 0;
        for (; i < definition.NodeCount(); i = i + 1) {
            this.nodes.Add(new ArpgNode(
                definition.NodeAt(i), this.dataSource));
        }
        if (definition.PrefabId() != "") {
            ArpgPrefabDefinition prefab = project.FindPrefab(
                definition.PrefabId());
            if (prefab != null) {
                this.prefabEvents = prefab.Events();
                i = 0;
                while (i < prefab.NodeCount()) {
                    this.nodes.Add(new ArpgNode(
                        prefab.NodeAt(i), this.dataSource));
                    i = i + 1;
                }
            }
        }
        this.Evaluate();
        if (this.prefabEvents != null) {
            this.prefabEvents.RaiseCreated(this.Id());
        }
        definition.Events().RaiseCreated(this.Id());
    }

    /// 返回控件唯一 Id（同定义 Id）。
    string Id() { return this.definition.Id(); }
    /// 返回控件类型字符串。
    string Kind() { return this.definition.Kind(); }
    /// 返回控件当前 X 坐标（像素，相对窗口原点；拖拽会改变运行时值）。
    int X() { return this.x; }
    /// 返回控件当前 Y 坐标（像素，相对窗口原点；拖拽会改变运行时值）。
    int Y() { return this.y; }
    /// 返回控件宽度（像素）。
    int Width() { return this.definition.Width(); }
    /// 返回控件高度（像素）。
    int Height() { return this.definition.Height(); }
    /// 返回绘制顺序；数值大者在上层。
    int Order() { return this.definition.Order(); }
    /// 返回控件当前可见性。
    bool Visible() { return this.visible; }
    /// 返回控件当前可用性；不可用时不响应指针且叠加禁用色。
    bool Enabled() { return this.enabled; }
    /// 返回控件是否接收鼠标事件。
    bool MouseEvents() { return this.definition.MouseEvents(); }
    /// 返回控件是否可拖拽。
    bool Draggable() { return this.definition.Draggable(); }
    /// 返回控件是否持有焦点。
    bool Focused() { return this.focused; }
    /// 返回指针是否悬停在控件上。
    bool Hovered() { return this.hovered; }
    /// 返回左键是否正按在控件上（未抬起）。
    bool Pressed() { return this.pressed; }
    /// 返回控件选中状态。
    bool Selected() { return this.selected; }
    /// 返回水平锚点（0=左缘，1=右缘）。
    double AnchorX() { return this.definition.AnchorX(); }
    /// 返回垂直锚点（0=上缘，1=下缘）。
    double AnchorY() { return this.definition.AnchorY(); }
    /// 返回水平缩放系数。
    double ScaleX() { return this.definition.ScaleX(); }
    /// 返回垂直缩放系数。
    double ScaleY() { return this.definition.ScaleY(); }
    /// 返回旋转角度（度，顺时针）。
    int Angle() { return this.definition.Angle(); }
    /// 返回不透明度（0.0~1.0）。
    double Opacity() { return this.definition.Opacity(); }
    /// 返回是否把子节点裁剪到控件边界内。
    bool Clip() { return this.definition.Clip(); }
    /// 返回模板求值后的标题。
    string Title() { return this.evaluatedTitle; }
    /// 返回模板求值后的内容（含 AppendContent 追加的部分）。
    string Content() { return this.evaluatedContent; }
    /// 返回贴图资源 Id。
    string Resource() { return this.definition.Resource(); }
    /// 返回背景色。
    ArpgColor BackgroundColor() {
        return this.definition.BackgroundColor();
    }
    /// 返回边框颜色。
    ArpgColor BorderColor() { return this.definition.BorderColor(); }
    /// 返回文字颜色（进度条也用它渲染填充条）。
    ArpgColor TextColor() { return this.definition.TextColor(); }
    /// 返回悬停叠加色。
    ArpgColor HoverColor() { return this.definition.HoverColor(); }
    /// 返回按下叠加色。
    ArpgColor PressedColor() { return this.definition.PressedColor(); }
    /// 返回禁用叠加色。
    ArpgColor DisabledColor() { return this.definition.DisabledColor(); }
    /// 返回边框宽度（像素）。
    int BorderWidth() { return this.definition.BorderWidth(); }
    /// 返回字体大小（像素）。
    int FontSize() { return this.definition.FontSize(); }
    /// 返回水平对齐（ArpgTextAlign 常量）。
    int HorizontalAlign() { return this.definition.HorizontalAlign(); }
    /// 返回垂直对齐（ArpgTextAlign 常量）。
    int VerticalAlign() { return this.definition.VerticalAlign(); }
    /// 返回文本是否自动换行。
    bool Wrap() { return this.definition.Wrap(); }
    /// 返回行间距（像素）。
    int LineSpacing() { return this.definition.LineSpacing(); }
    /// 返回数值范围下限。
    double Minimum() { return this.definition.Minimum(); }
    /// 返回数值范围上限。
    double Maximum() { return this.definition.Maximum(); }
    /// 返回当前数值（已钳制到范围）。
    double Value() { return this.currentValue; }
    /// 返回进度比例（当前值相对范围的归一化，0.0~1.0；范围无效时为 0.0）。
    double Progress() {
        double span = this.Maximum() - this.Minimum();
        if (span <= 0.0) { return 0.0; }
        return ArpgMath.ClampDouble(
            (this.currentValue - this.Minimum()) / span, 0.0, 1.0);
    }
    /// 返回九宫格描述；未设置时为 null。
    ArpgNineSlice NineSlice() { return this.definition.NineSlice(); }
    /// 返回求值后的富文本文档（非富文本控件为单 run 文档）。
    ArpgRichTextDocument Document() { return this.document; }
    /// 返回控件当前生效的数据源（私有的或继承的）。
    ArpgDataSource DataSource() { return this.dataSource; }
    /// 返回控件事件槽位集合（单播；不包含 Prefab 事件）。
    ArpgControlEventHandlers Events() { return this.definition.Events(); }
    /// 返回展开后子节点数量（含 Prefab 节点）。
    int NodeCount() { return this.nodes.Count; }
    /// 返回第 index 个子节点实例；index 须在 [0, NodeCount) 内。
    ArpgNode NodeAt(int index) { return this.nodes[index]; }

    /// 按 Id 查找子节点（含 Prefab 展开节点）；未找到返回 null。
    ArpgNode FindNode(string id) {
        for (int i = 0; i < this.nodes.Count; i = i + 1) {
            if (this.nodes[i].Id() == id) { return this.nodes[i]; }
        }
        return null;
    }

    /// 设置控件位置（像素，相对窗口原点；拖拽也直接改此位置）。
    void SetPosition(int x, int y) {
        this.x = x;
        this.y = y;
    }
    /// 设置控件可见性。
    void SetVisible(bool newValue) { this.visible = newValue; }
    /// 设置可用性；置为不可用时同时清除悬停/按下/拖拽状态。
    void SetEnabled(bool newValue) {
        this.enabled = newValue;
        if (!newValue) {
            this.hovered = false;
            this.pressed = false;
            this.dragging = false;
        }
    }
    /// 设置控件选中状态。
    void SetSelected(bool newValue) { this.selected = newValue; }

    /// 设置数值：钳制到 [Minimum, Maximum]，值无变化时为空操作；变化时先触发 Prefab 事件再触发控件事件。
    void SetValue(double newValue) {
        double clamped = ArpgMath.ClampDouble(
            newValue, this.Minimum(), this.Maximum());
        if (clamped == this.currentValue) { return; }
        this.currentValue = clamped;
        if (this.prefabEvents != null) {
            this.prefabEvents.RaiseValueChanged(this.Id(), clamped);
        }
        this.definition.Events().RaiseValueChanged(this.Id(), clamped);
    }

    /// 把数值重置为范围下限（等价 SetValue(Minimum)）。
    void ResetValue() { this.SetValue(this.Minimum()); }

    /// 在内容末尾追加文本并立即重新求值（富文本控件追加的也是富文本标记）；与 ClearAppendedContent 配对使用。
    void AppendContent(string content) {
        this.appendedContent = this.appendedContent + content;
        this.Evaluate();
    }

    /// 清空 AppendContent 追加的全部文本并重新求值。
    void ClearAppendedContent() {
        this.appendedContent = "";
        this.Evaluate();
    }

    /// 设置控件私有数据源：继承中的子节点同步换成新源并重新求值。
    void SetDataSource(ArpgDataSource newValue) {
        this.dataSource = newValue;
        for (int i = 0; i < this.nodes.Count; i = i + 1) {
            if (this.nodes[i].UsesInheritedDataSource()) {
                this.nodes[i].SetInheritedDataSource(newValue);
            }
        }
        this.Evaluate();
    }

    /// 重新求值标题/内容并重建富文本文档（含 AppendContent 追加部分）；框架每帧调用，业务一般无需手动调用。
    void Evaluate() {
        this.evaluatedTitle = ArpgTemplate.Evaluate(
            this.definition.Title(), this.dataSource);
        this.evaluatedContent = ArpgTemplate.Evaluate(
            this.definition.Content(), this.dataSource)
            + this.appendedContent;
        if (this.definition.RichText()) {
            this.document = ArpgRichText.Parse(
                this.definition.Content() + this.appendedContent,
                this.dataSource);
        } else {
            this.document = new ArpgRichTextDocument(
                this.evaluatedContent);
            if (this.evaluatedContent != "") {
                ArpgRichTextRun run =
                    ArpgRichTextRun.CreateText(this.evaluatedContent);
                this.document.Add(run);
            }
        }
    }

    /// 每帧推进：重新求值内容、更新全部子节点，最后触发 Updated 事件（Prefab 事件先于控件自身事件）。
    void Update(int deltaMilliseconds) {
        this.Evaluate();
        for (int i = 0; i < this.nodes.Count; i = i + 1) {
            this.nodes[i].Update(deltaMilliseconds);
        }
        if (this.prefabEvents != null) {
            this.prefabEvents.RaiseUpdated(this.Id(), deltaMilliseconds);
        }
        this.definition.Events().RaiseUpdated(this.Id(), deltaMilliseconds);
    }

    /// 命中测试：localX/localY 为控件局部坐标；仅可见且可用的控件参与，按缩放与锚点计算的实际矩形判断。
    bool HitTest(double localX, double localY) {
        double width = (double)this.Width() * this.ScaleX();
        double height = (double)this.Height() * this.ScaleY();
        double x = (double)this.x - width * this.AnchorX();
        double y = (double)this.y - height * this.AnchorY();
        return this.visible
            && this.enabled
            && localX >= x
            && localY >= y
            && localX < x + width
            && localY < y + height;
    }

    /// 命中测试子节点：localX/localY 为控件局部坐标；仅 MouseEvents 开启且命中的节点参与，同点多个命中取 Order 最大者；未命中返回 null。
    ArpgNode HitNode(double localX, double localY) {
        double x = localX - (double)this.x;
        double y = localY - (double)this.y;
        ArpgNode best = null;
        for (int i = 0; i < this.nodes.Count; i = i + 1) {
            ArpgNode node = this.nodes[i];
            if (node.MouseEvents() && node.HitTest(x, y)
                && (best == null || node.Order() >= best.Order())) {
                best = node;
            }
        }
        return best;
    }

    /// 设置控件焦点：变化时触发 FocusChanged，并把 node（可为 null）设为唯一获得焦点的子节点。
    void SetFocused(bool newValue, ArpgNode node) {
        if (this.focused != newValue) {
            this.focused = newValue;
            if (this.prefabEvents != null) {
                this.prefabEvents.RaiseFocusChanged(this.Id(), newValue);
            }
            this.definition.Events().RaiseFocusChanged(this.Id(), newValue);
        }
        for (int i = 0; i < this.nodes.Count; i = i + 1) {
            this.nodes[i].SetFocused(newValue && this.nodes[i] == node);
        }
    }

    /// 框架指针按下入口：依次分发给命中的子节点、Prefab 事件、控件事件（先到先消费），随后进入按下状态并获取焦点；返回是否被 handler 消费。
    bool PointerDown(
        int button,
        int modifiers,
        double localX,
        double localY
    ) {
        ArpgNode node = this.HitNode(localX, localY);
        bool consumed = false;
        if (node != null) {
            consumed = node.Events().RaisePointerDown(
                node.Id(), button, modifiers,
                localX - (double)this.x - (double)node.X(),
                localY - (double)this.y - (double)node.Y());
        }
        string nodeId = "";
        if (node != null) { nodeId = node.Id(); }
        if (!consumed && this.prefabEvents != null) {
            consumed = this.prefabEvents.RaisePointerDown(
                this.Id(), nodeId, button, modifiers,
                localX - (double)this.x, localY - (double)this.y);
        }
        if (!consumed) {
            consumed = this.definition.Events().RaisePointerDown(
                this.Id(), nodeId, button, modifiers,
                localX - (double)this.x, localY - (double)this.y);
        }
        this.pressed = true;
        this.dragging = this.Draggable() && button == ArpgPointerButton.Left();
        this.SetFocused(true, node);
        return consumed;
    }

    /// 框架指针抬起入口：分发逻辑同 PointerDown；左键在按钮区域内按下并抬起时额外触发 Activated；返回是否被 handler 消费。
    bool PointerUp(
        int button,
        int modifiers,
        double localX,
        double localY
    ) {
        ArpgNode node = this.HitNode(localX, localY);
        bool consumed = false;
        if (node != null) {
            consumed = node.Events().RaisePointerUp(
                node.Id(), button, modifiers,
                localX - (double)this.x - (double)node.X(),
                localY - (double)this.y - (double)node.Y());
        }
        string nodeId = "";
        if (node != null) { nodeId = node.Id(); }
        if (!consumed && this.prefabEvents != null) {
            consumed = this.prefabEvents.RaisePointerUp(
                this.Id(), nodeId, button, modifiers,
                localX - (double)this.x, localY - (double)this.y);
        }
        if (!consumed) {
            consumed = this.definition.Events().RaisePointerUp(
                this.Id(), nodeId, button, modifiers,
                localX - (double)this.x, localY - (double)this.y);
        }
        bool activate = this.pressed
            && button == ArpgPointerButton.Left()
            && this.HitTest(localX, localY);
        this.pressed = false;
        this.dragging = false;
        if (activate && this.Kind() == ArpgControlKind.Button()) {
            if (this.prefabEvents != null) {
                this.prefabEvents.RaiseActivated(this.Id());
            }
            this.definition.Events().RaiseActivated(this.Id());
        }
        return consumed;
    }

    /// 框架指针移动入口：更新悬停状态，可拖拽控件按位移移动位置并触发 Dragged，再按按下/抬起顺序分发；返回是否被 handler 消费。
    bool PointerMove(
        int button,
        int modifiers,
        double localX,
        double localY,
        double deltaX,
        double deltaY
    ) {
        this.hovered = this.HitTest(localX, localY);
        if (this.dragging) {
            this.x = this.x + (int)deltaX;
            this.y = this.y + (int)deltaY;
            if (this.prefabEvents != null) {
                this.prefabEvents.RaiseDragged(this.Id(), deltaX, deltaY);
            }
            this.definition.Events().RaiseDragged(this.Id(), deltaX, deltaY);
        }
        ArpgNode node = this.HitNode(localX, localY);
        bool consumed = false;
        if (node != null) {
            consumed = node.Events().RaisePointerMove(
                node.Id(), button, modifiers,
                localX - (double)this.x - (double)node.X(),
                localY - (double)this.y - (double)node.Y());
        }
        string nodeId = "";
        if (node != null) { nodeId = node.Id(); }
        if (!consumed && this.prefabEvents != null) {
            consumed = this.prefabEvents.RaisePointerMove(
                this.Id(), nodeId, button, modifiers,
                localX - (double)this.x, localY - (double)this.y);
        }
        if (!consumed) {
            consumed = this.definition.Events().RaisePointerMove(
                this.Id(), nodeId, button, modifiers,
                localX - (double)this.x, localY - (double)this.y);
        }
        return consumed;
    }

    /// 激活富文本文档中第 runIndex 个 run 的链接：触发控件 OnLinkActivated 并同时上报系统级富文本链接事件；索引越界或该 run 不是链接时返回 false。
    bool ActivateLink(int runIndex) {
        if (runIndex < 0 || runIndex >= this.document.RunCount()) {
            return false;
        }
        ArpgRichTextRun run = this.document.RunAt(runIndex);
        if (!run.IsLink()) { return false; }
        if (this.prefabEvents != null) {
            this.prefabEvents.RaiseLink(this.Id(), run.Link().Raw());
        }
        this.definition.Events().RaiseLink(this.Id(), run.Link().Raw());
        this.systemEvents.RaiseRichTextLink(
            this.windowId, this.Id(), run.Link().Raw());
        return true;
    }

    /// 触发控件自定义事件（Prefab 与控件自身 handler 都会收到；payload 原样透传）。
    void FireCustom(string name, string payload) {
        if (this.prefabEvents != null) {
            this.prefabEvents.RaiseCustom(this.Id(), name, payload);
        }
        this.definition.Events().RaiseCustom(this.Id(), name, payload);
    }
}

/// <summary>
/// UI 窗口运行时实例：由 ArpgWindowDefinition 构造，持有全部控件、
/// 求值后的标题、运行时位置与可见性。Open/Close 切换可见性并各触发
/// 一次 Opened/Closed；指针事件先分发给命中的控件，未消费再交给
/// 窗口 handler；可拖动窗口按 Movable 在空白处拖拽。
/// </summary>
class ArpgWindow {
    ArpgWindowDefinition definition;
    ArpgDataSource defaultDataSource;
    List<ArpgControl> controls;
    string evaluatedTitle;
    int x;
    int y;
    bool visible;
    bool dragging;

    /// 构造窗口实例：按定义实例化全部控件；初始可见时构造即触发 Created 与 Opened。
    ArpgWindow(
        ArpgWindowDefinition definition,
        ArpgProject project,
        ArpgDataSource defaultDataSource,
        ArpgEvents systemEvents
    ) {
        this.definition = definition;
        this.defaultDataSource = defaultDataSource;
        this.controls = new List<ArpgControl>();
        this.evaluatedTitle = "";
        this.x = definition.X();
        this.y = definition.Y();
        this.visible = definition.VisibleByDefault();
        this.dragging = false;
        for (int i = 0; i < definition.ControlCount(); i = i + 1) {
            this.controls.Add(new ArpgControl(
                definition.ControlAt(i),
                this.Id(),
                defaultDataSource,
                project,
                systemEvents));
        }
        this.Evaluate();
        definition.Events().RaiseCreated(this.Id());
        if (this.visible) { definition.Events().RaiseOpened(this.Id()); }
    }

    /// 返回窗口唯一 Id。
    string Id() { return this.definition.Id(); }
    /// 返回模板求值后的标题。
    string Title() { return this.evaluatedTitle; }
    /// 返回窗口当前 X 坐标（像素，相对游戏画面左上角；拖动会改变运行时值）。
    int X() { return this.x; }
    /// 返回窗口当前 Y 坐标（像素，相对游戏画面左上角）。
    int Y() { return this.y; }
    /// 返回窗口宽度（像素）。
    int Width() { return this.definition.Width(); }
    /// 返回窗口高度（像素）。
    int Height() { return this.definition.Height(); }
    /// 返回边框宽度（像素）。
    int BorderWidth() { return this.definition.BorderWidth(); }
    /// 返回边框颜色。
    ArpgColor BorderColor() { return this.definition.BorderColor(); }
    /// 返回背景色。
    ArpgColor BackgroundColor() {
        return this.definition.BackgroundColor();
    }
    /// 返回背景贴图资源 Id；空串表示无背景贴图。
    string BackgroundResource() {
        return this.definition.BackgroundResource();
    }
    /// 返回窗口是否始终置顶。
    bool AlwaysOnTop() { return this.definition.AlwaysOnTop(); }
    /// 返回窗口是否可在空白处拖动。
    bool Movable() { return this.definition.Movable(); }
    /// 返回窗口是否鼠标穿透（不参与命中测试）。
    bool ClickThrough() { return this.definition.ClickThrough(); }
    /// 返回窗口当前可见性。
    bool Visible() { return this.visible; }
    /// 返回窗口事件槽位集合（单播）。
    ArpgWindowEventHandlers Events() { return this.definition.Events(); }
    /// 返回控件实例数量。
    int ControlCount() { return this.controls.Count; }
    /// 返回第 index 个控件实例；index 须在 [0, ControlCount) 内。
    ArpgControl ControlAt(int index) { return this.controls[index]; }

    /// 按 Id 查找控件；未找到返回 null。
    ArpgControl FindControl(string id) {
        for (int i = 0; i < this.controls.Count; i = i + 1) {
            if (this.controls[i].Id() == id) { return this.controls[i]; }
        }
        return null;
    }

    /// 设置窗口位置（像素，相对游戏画面左上角）。
    void SetPosition(int x, int y) {
        this.x = x;
        this.y = y;
    }

    /// 打开窗口（置为可见并触发 Opened）；已可见时为空操作。
    void Open() {
        if (this.visible) { return; }
        this.visible = true;
        this.definition.Events().RaiseOpened(this.Id());
    }

    /// 关闭窗口（置为不可见并触发 Closed）；已不可见时为空操作。
    void Close() {
        if (!this.visible) { return; }
        this.visible = false;
        this.definition.Events().RaiseClosed(this.Id());
    }

    /// 重新求值标题（按窗口默认数据源替换模板占位符）；框架每帧调用。
    void Evaluate() {
        this.evaluatedTitle = ArpgTemplate.Evaluate(
            this.definition.Title(), this.defaultDataSource);
    }

    /// 每帧推进：重新求值标题并更新全部控件，最后触发 Updated 事件。
    void Update(int deltaMilliseconds) {
        this.Evaluate();
        for (int i = 0; i < this.controls.Count; i = i + 1) {
            this.controls[i].Update(deltaMilliseconds);
        }
        this.definition.Events().RaiseUpdated(this.Id(), deltaMilliseconds);
    }

    /// 命中测试：x/y 为游戏画面坐标；仅可见窗口参与，按当前位置与尺寸判断。
    bool HitTest(double x, double y) {
        return this.visible
            && x >= (double)this.x
            && y >= (double)this.y
            && x < (double)(this.x + this.Width())
            && y < (double)(this.y + this.Height());
    }

    /// 命中测试控件：x/y 为游戏画面坐标；仅 MouseEvents 开启且命中的控件参与，同点多个命中取 Order 最大者；未命中返回 null。
    ArpgControl HitControl(double x, double y) {
        double localX = x - (double)this.x;
        double localY = y - (double)this.y;
        ArpgControl best = null;
        for (int i = 0; i < this.controls.Count; i = i + 1) {
            ArpgControl control = this.controls[i];
            if (control.MouseEvents() && control.HitTest(localX, localY)
                && (best == null || control.Order() >= best.Order())) {
                best = control;
            }
        }
        return best;
    }

    /// 框架指针按下入口：先分发给命中的控件，未消费再交给窗口 handler；空白处左键按下且 Movable 时进入窗口拖动；返回是否被消费。
    bool PointerDown(
        int button,
        int modifiers,
        double x,
        double y
    ) {
        ArpgControl control = this.HitControl(x, y);
        bool consumed = false;
        if (control != null) {
            consumed = control.PointerDown(
                button, modifiers,
                x - (double)this.x, y - (double)this.y);
        }
        if (!consumed) {
            string controlId = "";
            if (control != null) { controlId = control.Id(); }
            consumed = this.definition.Events().RaisePointerDown(
                this.Id(), controlId, button, modifiers,
                x - (double)this.x, y - (double)this.y);
        }
        this.dragging = control == null
            && this.Movable()
            && button == ArpgPointerButton.Left();
        return consumed;
    }

    /// 框架指针抬起入口：capturedControl 为按下时捕获的控件（可传 null 改为按当前位置命中）；结束窗口拖动状态；返回是否被消费。
    bool PointerUp(
        ArpgControl capturedControl,
        int button,
        int modifiers,
        double x,
        double y
    ) {
        ArpgControl control = capturedControl;
        if (control == null) { control = this.HitControl(x, y); }
        bool consumed = false;
        if (control != null) {
            consumed = control.PointerUp(
                button, modifiers,
                x - (double)this.x, y - (double)this.y);
        }
        if (!consumed) {
            string controlId = "";
            if (control != null) { controlId = control.Id(); }
            consumed = this.definition.Events().RaisePointerUp(
                this.Id(), controlId, button, modifiers,
                x - (double)this.x, y - (double)this.y);
        }
        this.dragging = false;
        return consumed;
    }

    /// 框架指针移动入口：拖动中先按位移移动窗口，再分发给捕获或命中的控件，未消费交给窗口 handler；返回是否被消费。
    bool PointerMove(
        ArpgControl capturedControl,
        int button,
        int modifiers,
        double x,
        double y,
        double deltaX,
        double deltaY
    ) {
        if (this.dragging) {
            this.x = this.x + (int)deltaX;
            this.y = this.y + (int)deltaY;
        }
        ArpgControl control = capturedControl;
        if (control == null) { control = this.HitControl(x, y); }
        bool consumed = false;
        if (control != null) {
            consumed = control.PointerMove(
                button, modifiers,
                x - (double)this.x, y - (double)this.y,
                deltaX, deltaY);
        }
        if (!consumed) {
            string controlId = "";
            if (control != null) { controlId = control.Id(); }
            consumed = this.definition.Events().RaisePointerMove(
                this.Id(), controlId, button, modifiers,
                x - (double)this.x, y - (double)this.y);
        }
        return consumed;
    }

    /// 触发窗口自定义事件（payload 原样透传给 OnCustomEvent 注册的 handler）。
    void FireCustom(string name, string payload) {
        this.definition.Events().RaiseCustom(this.Id(), name, payload);
    }
}

/// <summary>
/// UI 运行时总入口：按 ArpgProject 实例化全部窗口，负责每帧同步
/// 默认数据源（玩家属性模板变量）、驱动窗口更新、指针事件的捕获
/// 与分发（窗口 -> 控件 -> 节点，先到先消费）与焦点管理。业务代码
/// 通过 Runtime 的入口获取实例，每帧调用 Update 与（渲染层的）
/// Render，把 SDL 指针事件转投给 PointerDown/Up/Move。
/// </summary>
class ArpgUiRuntime {
    ArpgProject project;
    ArpgWorld world;
    ArpgEvents systemEvents;
    ArpgDataSource defaultDataSource;
    List<ArpgWindow> windows;
    ArpgControl focusedControl;
    ArpgControl capturedControl;
    ArpgWindow capturedWindow;
    int capturedButton;

    ArpgUiRuntime(
        ArpgProject project,
        ArpgWorld world,
        ArpgEvents systemEvents
    ) {
        this.project = project;
        this.world = world;
        this.systemEvents = systemEvents;
        this.defaultDataSource = new ArpgDataSource();
        this.windows = new List<ArpgWindow>();
        this.focusedControl = null;
        this.capturedControl = null;
        this.capturedWindow = null;
        this.capturedButton = -1;
        this.SyncDefaultDataSource();
        for (int i = 0; i < project.WindowCount(); i = i + 1) {
            this.windows.Add(new ArpgWindow(
                project.WindowAt(i),
                project,
                this.defaultDataSource,
                systemEvents));
        }
    }

    /// 返回所属项目定义（只读视图）。
    ArpgProject Project() { return this.project; }
    /// 返回所属游戏世界（用于同步玩家属性到默认数据源）。
    ArpgWorld World() { return this.world; }
    /// 返回系统级事件总线（如富文本链接全局回调）。
    ArpgEvents SystemEvents() { return this.systemEvents; }
    /// 返回默认数据源（每帧同步玩家属性的模板变量集合）。
    ArpgDataSource DefaultDataSource() {
        return this.defaultDataSource;
    }
    /// 返回窗口实例数量（同项目定义的窗口数）。
    int WindowCount() { return this.windows.Count; }
    /// 返回第 index 个窗口实例；index 须在 [0, WindowCount) 内。
    ArpgWindow WindowAt(int index) { return this.windows[index]; }
    /// 返回当前持有焦点的控件；无焦点时为 null。
    ArpgControl FocusedControl() { return this.focusedControl; }
    /// 返回被指针按下捕获的控件（仅按下到抬起之间非 null）。
    ArpgControl CapturedControl() { return this.capturedControl; }
    /// 返回捕获的指针按键（ArpgPointerButton 值；未捕获时为 -1）。
    int CapturedButton() { return this.capturedButton; }

    /// 按 Id 查找窗口；未找到返回 null。
    ArpgWindow FindWindow(string id) {
        for (int i = 0; i < this.windows.Count; i = i + 1) {
            if (this.windows[i].Id() == id) { return this.windows[i]; }
        }
        return null;
    }

    /// 按 窗口 Id + 控件 Id 查找控件；任一级未找到返回 null。
    ArpgControl FindControl(string windowId, string controlId) {
        ArpgWindow window = this.FindWindow(windowId);
        if (window == null) { return null; }
        return window.FindControl(controlId);
    }

    /// 把玩家属性同步进默认数据源（id/name/level/hp 等英文与中文键、自定义属性与"属性.*"键）；无玩家时为空操作，框架每帧自动调用。
    void SyncDefaultDataSource() {
        ArpgActor player = this.world.Player();
        if (player == null) { return; }
        ArpgAttributes attributes = player.Attributes();
        this.defaultDataSource.SetText("id", player.Id());
        this.defaultDataSource.SetText("name", player.DisplayName());
        this.defaultDataSource.SetText("名称", player.DisplayName());
        this.defaultDataSource.SetInteger("level", player.Level());
        this.defaultDataSource.SetInteger("等级", player.Level());
        this.defaultDataSource.SetInteger("gridX", player.GridX());
        this.defaultDataSource.SetInteger("gridY", player.GridY());
        this.defaultDataSource.SetNumber("hp", attributes.Hp());
        this.defaultDataSource.SetNumber("maxhp", attributes.MaxHp());
        this.defaultDataSource.SetNumber("mp", attributes.Mp());
        this.defaultDataSource.SetNumber("maxmp", attributes.MaxMp());
        this.defaultDataSource.SetNumber("属性.生命", attributes.Hp());
        this.defaultDataSource.SetNumber("属性.最大生命", attributes.MaxHp());
        this.defaultDataSource.SetNumber("属性.法力", attributes.Mp());
        this.defaultDataSource.SetNumber("属性.最大法力", attributes.MaxMp());
        this.defaultDataSource.SetNumber("属性.命中", attributes.Accuracy());
        this.defaultDataSource.SetNumber("属性.闪避", attributes.Evasion());
        this.defaultDataSource.SetNumber(
            "属性.暴击率", attributes.CriticalChance());
        this.defaultDataSource.SetNumber(
            "属性.暴击伤害", attributes.CriticalDamage());
        for (int i = 0; i < attributes.CustomCount(); i = i + 1) {
            ArpgCustomAttribute attribute = attributes.CustomAt(i);
            this.defaultDataSource.SetNumber(
                attribute.Name(), attribute.Amount());
            this.defaultDataSource.SetNumber(
                "属性." + attribute.Name(), attribute.Amount());
        }
    }

    /// 每帧推进：先同步默认数据源，再更新全部窗口；由框架主循环调用。
    void Update(int deltaMilliseconds) {
        this.SyncDefaultDataSource();
        for (int i = 0; i < this.windows.Count; i = i + 1) {
            this.windows[i].Update(deltaMilliseconds);
        }
    }

    /// 命中测试窗口：x/y 为游戏画面坐标；穿透窗口（ClickThrough）不参与，置顶窗口优先于普通窗口；未命中返回 null。
    ArpgWindow HitWindow(double x, double y) {
        ArpgWindow best = null;
        for (int i = 0; i < this.windows.Count; i = i + 1) {
            ArpgWindow window = this.windows[i];
            if (!window.ClickThrough() && window.HitTest(x, y)) {
                if (best == null
                    || window.AlwaysOnTop()
                    || !best.AlwaysOnTop()) {
                    best = window;
                }
            }
        }
        return best;
    }

    /// 焦点管理：把焦点移交给 next（可为 null），原焦点控件在变化时失焦；由指针按下流程内部调用。
    void ClearFocus(ArpgControl next) {
        if (this.focusedControl != null && this.focusedControl != next) {
            this.focusedControl.SetFocused(false, null);
        }
        this.focusedControl = next;
    }

    /// 框架指针按下入口：先分发给命中的控件，未消费再交给窗口 handler；空白处左键按下且 Movable 时进入窗口拖动；返回是否被消费。
    /// 指针按下总入口：命中窗口则捕获窗口/控件并向下分发，未命中任何窗口时清除焦点与捕获状态并返回 false；返回是否被 handler 消费。
    bool PointerDown(
        int button,
        int modifiers,
        double x,
        double y
    ) {
        ArpgWindow window = this.HitWindow(x, y);
        if (window == null) {
            this.ClearFocus(null);
            this.capturedWindow = null;
            this.capturedControl = null;
            this.capturedButton = -1;
            return false;
        }
        ArpgControl control = window.HitControl(x, y);
        this.ClearFocus(control);
        this.capturedWindow = window;
        this.capturedControl = control;
        this.capturedButton = button;
        return window.PointerDown(button, modifiers, x, y);
    }

    /// 指针抬起总入口：把事件投给被捕获窗口（无捕获时按坐标命中），随后清除捕获状态；返回是否被消费。
    bool PointerUp(
        int button,
        int modifiers,
        double x,
        double y
    ) {
        ArpgWindow window = this.capturedWindow;
        if (window == null) { window = this.HitWindow(x, y); }
        if (window == null) { return false; }
        bool consumed = window.PointerUp(
            this.capturedControl, button, modifiers, x, y);
        this.capturedWindow = null;
        this.capturedControl = null;
        this.capturedButton = -1;
        return consumed;
    }

    /// 指针移动总入口：投给被捕获窗口（无捕获时按坐标命中）；拖拽窗口/控件的位移也在其中处理；返回是否被消费。
    bool PointerMove(
        int button,
        int modifiers,
        double x,
        double y,
        double deltaX,
        double deltaY
    ) {
        ArpgWindow window = this.capturedWindow;
        if (window == null) { window = this.HitWindow(x, y); }
        if (window == null) { return false; }
        return window.PointerMove(
            this.capturedControl,
            button, modifiers, x, y, deltaX, deltaY);
    }
}
