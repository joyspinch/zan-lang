using System;
using SDL3;

namespace Game.Arpg;

/// <summary>类型化 Arpg 组件引擎的 SDL3 应用宿主。</summary>
class ArpgEngine {
    ArpgConfig config;
    ArpgProject project;
    ArpgRegistry registry;
    ArpgEvents events;
    ArpgGameplayEvents gameplayEvents;
    ArpgScheduler scheduler;
    ArpgWorld world;
    ArpgUiRuntime ui;
    ArpgUiRenderer uiRenderer;
    ArpgDiagnostics diagnostics;
    SdlWindow window;
    SdlRenderer renderer;
    bool running;
    int lastTick;

    ArpgEngine(ArpgConfig config) {
        this.config = config;
        this.project = new ArpgProject();
        this.registry = this.project.Registry();
        this.events = new ArpgEvents();
        this.gameplayEvents = new ArpgGameplayEvents();
        this.scheduler = new ArpgScheduler();
        this.world = ArpgWorld.CreateWithEvents(
            this.project, this.events, this.gameplayEvents);
        this.ui = new ArpgUiRuntime(
            this.project, this.world, this.events);
        this.uiRenderer = new ArpgUiRenderer(this.registry);
        this.diagnostics = new ArpgDiagnostics();
        this.running = false;
        this.lastTick = 0;
    }

    /// 各子系统的只读访问（Start 后 Renderer 才有效）。
    ArpgConfig Config() { return this.config; }
    /// 当前项目（未 LoadProject 时为空项目）。
    ArpgProject Project() { return this.project; }
    /// 项目资源注册表（随 LoadProject 更新）。
    ArpgRegistry Registry() { return this.registry; }
    /// 系统事件总线（On*/Raise* 见 ArpgEvents）。
    ArpgEvents Events() { return this.events; }
    /// 玩法事件总线（物品/技能/buff/伤害/切图）。
    ArpgGameplayEvents GameplayEvents() { return this.gameplayEvents; }
    /// 定时事件调度器（主循环自动 Tick）。
    ArpgScheduler Scheduler() { return this.scheduler; }
    /// 游戏世界（随 LoadProject 重建）。
    ArpgWorld World() { return this.world; }
    /// UI 运行时（控件树与指针事件）。
    ArpgUiRuntime Ui() { return this.ui; }
    /// UI 渲染器（随 LoadProject 更新）。
    ArpgUiRenderer UiRenderer() { return this.uiRenderer; }
    /// 最近一次 Validate/LoadProject 的诊断结果。
    ArpgDiagnostics Diagnostics() { return this.diagnostics; }
    /// SDL 渲染器；Start 成功前为 null。
    SdlRenderer Renderer() { return this.renderer; }
    /// 主循环是否运行中。
    bool IsRunning() { return this.running; }

    /// <summary>
    /// 装载新项目：先全量校验，有错误则只更新 Diagnostics 并返回
    /// false；成功则替换项目/注册表/世界/UI 运行时与渲染器。
    /// </summary>
    bool LoadProject(ArpgProject project) {
        if (project == null) { return false; }
        ArpgDiagnostics result = project.Validate();
        this.diagnostics = result;
        if (result.HasErrors()) { return false; }
        this.project = project;
        this.registry = project.Registry();
        this.world = ArpgWorld.CreateWithEvents(
            project, this.events, this.gameplayEvents);
        if (this.uiRenderer != null) { this.uiRenderer.Close(); }
        this.ui = new ArpgUiRuntime(
            project, this.world, this.events);
        this.uiRenderer = new ArpgUiRenderer(this.registry);
        return true;
    }

    /// <summary>
    /// 校验配置与项目，并额外检查默认字体资源存在；结果同时
    /// 存入 Diagnostics() 并返回。HasErrors 表示不可 Start。
    /// </summary>
    ArpgDiagnostics Validate() {
        ArpgDiagnostics result = this.config.Validate();
        result.Append(this.project.Validate());
        if (this.config.DefaultFont() != ""
            && !this.registry.HasResource(this.config.DefaultFont())) {
            result.AddError(
                "L2APP007",
                "app.defaultFont",
                "Default font resource id was not found.");
        }
        this.diagnostics = result;
        return result;
    }

    /// <summary>
    /// 初始化 SDL（仅视频+事件）并创建窗口/渲染器：依次经过
    /// 校验与 Starting（返回 false 中止） veto，ScreenMode 决定
    /// 窗口标志，最后触发 Started。已运行时幂等返回 true；
    /// 任一步失败返回 false（SDL 已清理）。
    /// </summary>
    bool Start(string arguments) {
        if (this.running) { return true; }
        if (this.Validate().HasErrors()) { return false; }
        if (!this.events.RaiseStarting(arguments)) { return false; }
        // ARPG 目前持有视频/事件循环。音频与手柄
        // 后端为可选项，不得隐式初始化。
        if (!Sdl.Init(SdlInit.Video() + SdlInit.Events())) { return false; }

        int flags = SdlWindowFlags.HighPixelDensity();
        if (this.config.ScreenMode() == ArpgScreenMode.Scale()
            || this.config.ScreenMode() == ArpgScreenMode.ResizeWorld()) {
            flags = flags + SdlWindowFlags.Resizable();
        }
        if (this.config.ScreenMode() == ArpgScreenMode.TransparentBorderless()) {
            flags = flags + SdlWindowFlags.Borderless();
        }
        this.window = SdlWindow.Create(
            this.config.Title(), this.config.Width(), this.config.Height(), flags);
        if (!this.window.IsValid()) {
            Sdl.Quit();
            return false;
        }

        this.renderer = SdlRenderer.Create(this.window);
        if (!this.renderer.IsValid()) {
            this.window.Close();
            Sdl.Quit();
            return false;
        }

        this.renderer.SetVSync(this.config.VerticalSync());
        if (this.config.ScreenMode() == ArpgScreenMode.Scale()) {
            this.renderer.SetLogicalSize(
                this.config.Width(),
                this.config.Height(),
                SdlLogicalPresentation.Stretch());
        }
        this.running = true;
        this.lastTick = Sdl.Ticks();
        this.events.RaiseStarted();
        return true;
    }

    /// <summary>
    /// 轮询并分发全部 SDL 事件：关闭请求经 Closing 否决机制、
    /// 焦点/最小化/最大化/恢复/尺寸变化转发到系统事件、键盘
    /// 按键（RepeatKeys 控制连发）、鼠标按下/抬起/移动转发给
    /// UI 运行时。主循环每帧自动调用。
    /// </summary>
    void PumpEvents() {
        while (SdlEvent.Poll()) {
            int type = SdlEvent.Type();
            if (SdlEvent.IsQuit()) {
                if (this.events.RaiseClosing()) {
                    this.running = false;
                }
            } else if (type == SdlEventType.WindowFocusGained()) {
                this.events.RaiseFocusChanged(true);
            } else if (type == SdlEventType.WindowFocusLost()) {
                this.events.RaiseFocusChanged(false);
            } else if (type == SdlEventType.WindowMinimized()) {
                this.events.RaiseWindowStateChanged(1);
            } else if (type == SdlEventType.WindowMaximized()) {
                this.events.RaiseWindowStateChanged(2);
            } else if (type == SdlEventType.WindowRestored()) {
                this.events.RaiseWindowStateChanged(3);
            } else if (type == SdlEventType.WindowResized()) {
                this.events.RaiseSizeChanged(SdlEvent.Data1(), SdlEvent.Data2());
            } else if (type == SdlEventType.KeyDown()) {
                if (this.config.RepeatKeys() || !SdlEvent.IsRepeat()) {
                    int modifiers = SdlEvent.Keymod();
                    this.events.RaiseKeyDown(
                        SdlEvent.Keycode(),
                        SdlKeymod.HasAlt(modifiers),
                        SdlKeymod.HasShift(modifiers),
                        SdlKeymod.HasControl(modifiers));
                }
            } else if (type == SdlEventType.KeyUp()) {
                int modifiers = SdlEvent.Keymod();
                this.events.RaiseKeyUp(
                    SdlEvent.Keycode(),
                    SdlKeymod.HasAlt(modifiers),
                    SdlKeymod.HasShift(modifiers),
                    SdlKeymod.HasControl(modifiers));
            } else if (type == SdlEventType.MouseButtonDown()) {
                this.ui.PointerDown(
                    ArpgPointerButton.FromSdl(SdlEvent.MouseButton()),
                    0,
                    SdlEvent.MouseX(),
                    SdlEvent.MouseY());
            } else if (type == SdlEventType.MouseButtonUp()) {
                this.ui.PointerUp(
                    ArpgPointerButton.FromSdl(SdlEvent.MouseButton()),
                    0,
                    SdlEvent.MouseX(),
                    SdlEvent.MouseY());
            } else if (type == SdlEventType.MouseMotion()) {
                this.ui.PointerMove(
                    this.ui.CapturedButton(),
                    0,
                    SdlEvent.MouseX(),
                    SdlEvent.MouseY(),
                    SdlEvent.MouseDeltaX(),
                    SdlEvent.MouseDeltaY());
            }
        }
    }

    /// <summary>
    /// 推进一帧：按 SDL 时钟计算帧间隔毫秒（负值钳为 0），依次
    /// Tick 调度器、世界与 UI，返回本次帧间隔毫秒。
    /// </summary>
    int Update() {
        int now = Sdl.Ticks();
        int delta = now - this.lastTick;
        if (delta < 0) { delta = 0; }
        this.lastTick = now;
        this.scheduler.Tick(delta);
        this.world.Update(delta);
        this.ui.Update(delta);
        return delta;
    }

    /// 渲染一帧：按配置背景色清屏、绘制 UI 后 Present；
    /// 渲染器未就绪时为空操作。
    void Render() {
        if (this.renderer == null) { return; }
        this.renderer.SetColor(
            this.config.BackgroundRed(),
            this.config.BackgroundGreen(),
            this.config.BackgroundBlue(),
            this.config.BackgroundAlpha());
        this.renderer.Clear();
        this.uiRenderer.Render(this.renderer, this.ui);
        this.renderer.Present();
    }

    /// <summary>
    /// 启动并阻塞运行主循环直至退出：垂直同步开启时依赖
    /// VSync 节流，否则按 FrameRate 计算帧时长并 Delay 补齐。
    /// Start 失败返回 false；正常退出（Stop 后）返回 true。
    /// </summary>
    bool Run(string arguments) {
        if (!this.Start(arguments)) { return false; }
        int frameDuration = 1000 / ArpgMath.Max(1, this.config.FrameRate());
        while (this.running) {
            int frameStart = Sdl.Ticks();
            this.PumpEvents();
            this.Update();
            this.Render();
            if (!this.config.VerticalSync()) {
                int spent = Sdl.Ticks() - frameStart;
                if (spent < frameDuration) {
                    Sdl.Delay(frameDuration - spent);
                }
            }
        }
        this.Stop();
        return true;
    }

    /// 停止主循环并释放 UI 渲染器/渲染器/窗口，随后 Sdl.Quit；
    /// 可安全重复调用。
    void Stop() {
        this.running = false;
        if (this.uiRenderer != null) { this.uiRenderer.Close(); }
        if (this.renderer != null) { this.renderer.Close(); }
        if (this.window != null) { this.window.Close(); }
        Sdl.Quit();
    }
}
