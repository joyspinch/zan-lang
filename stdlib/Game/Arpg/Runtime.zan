using System;

namespace Game.Arpg;

/// <summary>背包内单个格子的实例：物品定义 + 当前堆叠数量。</summary>
class ArpgItemInstance {
    ArpgItemDefinition definition;
    int quantity;

    /// 构造一个格子实例。
    ArpgItemInstance(
        ArpgItemDefinition definition,
        int quantity
    ) {
        this.definition = definition;
        this.quantity = quantity;
    }

    /// 物品定义。
    ArpgItemDefinition Definition() { return this.definition; }
    /// 当前堆叠数量。
    int Quantity() { return this.quantity; }
    /// 数量是否已耗尽（≤0）。
    bool IsEmpty() { return this.quantity <= 0; }

    /// <summary>
    /// 增加数量，受 MaxStack 上限约束，返回实际增加数
    /// （count ≤ 0 返回 0，可部分加入）。
    /// </summary>
    int Add(int count) {
        if (count <= 0) { return 0; }
        int room = this.definition.MaxStack() - this.quantity;
        int added = count;
        if (added > room) { added = room; }
        this.quantity = this.quantity + added;
        return added;
    }

    /// <summary>
    /// 移除数量，最多移除到 0，返回实际移除数
    /// （count ≤ 0 返回 0，可部分移除）。
    /// </summary>
    int Remove(int count) {
        if (count <= 0) { return 0; }
        int removed = count;
        if (removed > this.quantity) { removed = this.quantity; }
        this.quantity = this.quantity - removed;
        return removed;
    }
}

/// <summary>角色与背包控件使用的可堆叠格子背包。</summary>
class ArpgInventory {
    int capacity;
    List<ArpgItemInstance> slots;

    /// 构造背包；容量钳制到 ≥1。
    ArpgInventory(int capacity) {
        this.capacity = ArpgMath.Max(1, capacity);
        this.slots = new List<ArpgItemInstance>();
    }

    /// 总格数上限（≥1）。
    int Capacity() { return this.capacity; }
    /// 当前已用格数（未堆满的同 id 物品共享一格）。
    int SlotCount() { return this.slots.Count; }
    /// 第 index 个格子实例（不查越界）。
    ArpgItemInstance SlotAt(int index) { return this.slots[index]; }
    /// 已用格数是否达到容量上限。
    bool IsFull() { return this.slots.Count >= this.capacity; }

    /// 指定物品 id 的总数量（跨全部格子求和）。
    int QuantityOf(string itemId) {
        int total = 0;
        for (int i = 0; i < this.slots.Count; i = i + 1) {
            if (this.slots[i].Definition().Id() == itemId) {
                total = total + this.slots[i].Quantity();
            }
        }
        return total;
    }

    /// 返回第一个包含指定物品的格子；没有返回 null。
    ArpgItemInstance Find(string itemId) {
        for (int i = 0; i < this.slots.Count; i = i + 1) {
            if (this.slots[i].Definition().Id() == itemId) {
                return this.slots[i];
            }
        }
        return null;
    }

    /// <summary>
    /// 加入物品：先填已有同 id 堆（至 MaxStack），再开新格。
    /// 返回实际加入数；容量/堆叠不足时可少于 count
    /// （definition 为 null 或 count ≤ 0 返回 0）。
    /// </summary>
    int Add(ArpgItemDefinition definition, int count) {
        if (definition == null || count <= 0) { return 0; }
        int remaining = count;
        for (int i = 0; i < this.slots.Count && remaining > 0; i = i + 1) {
            ArpgItemInstance item = this.slots[i];
            if (item.Definition().Id() == definition.Id()) {
                remaining = remaining - item.Add(remaining);
            }
        }
        while (remaining > 0 && this.slots.Count < this.capacity) {
            int stack = remaining;
            if (stack > definition.MaxStack()) { stack = definition.MaxStack(); }
            this.slots.Add(new ArpgItemInstance(definition, stack));
            remaining = remaining - stack;
        }
        return count - remaining;
    }

    /// <summary>
    /// 移除指定数量的物品（库存不足时整体失败返回 false，
    /// 不做部分移除）。空格子自动回收。count ≤ 0 返回 false。
    /// </summary>
    bool Remove(string itemId, int count) {
        if (count <= 0 || this.QuantityOf(itemId) < count) { return false; }
        int remaining = count;
        int i = this.slots.Count - 1;
        while (i >= 0 && remaining > 0) {
            ArpgItemInstance item = this.slots[i];
            if (item.Definition().Id() == itemId) {
                remaining = remaining - item.Remove(remaining);
                if (item.IsEmpty()) { this.slots.RemoveAt(i); }
            }
            i = i - 1;
        }
        return true;
    }
}

// 一件装备与其槽位绑定。用单个实体代替平行的
// 槽位/物品列表。
/// <summary>一件装备与其槽位名的绑定。</summary>
class ArpgEquipSlot {
    /// 槽位名（如 "weapon"、"armor"）。
    string slot;
    /// 该槽位当前装备的物品定义。
    ArpgItemDefinition item;

    /// 构造一个槽位绑定。
    ArpgEquipSlot(string slot, ArpgItemDefinition item) {
        this.slot = slot;
        this.item = item;
    }
}

/// <summary>
/// 角色的装备栏：槽位名到物品的映射。Equip 会先从背包扣件、
/// 换装时旧件退回背包（退不下则整体失败）；Attributes 汇总
/// 全部已装备物品的属性修正。
/// </summary>
class ArpgEquipment {
    List<ArpgEquipSlot> slots;

    /// 构造空装备栏。
    ArpgEquipment() {
        this.slots = new List<ArpgEquipSlot>();
    }

    /// 槽位名对应下标；不存在返回 -1。
    int IndexOf(string slot) {
        for (int i = 0; i < this.slots.Count; i = i + 1) {
            if (this.slots[i].slot == slot) { return i; }
        }
        return -1;
    }

    /// 返回槽位上当前装备的物品；未装备返回 null。
    ArpgItemDefinition Get(string slot) {
        int index = this.IndexOf(slot);
        if (index < 0) { return null; }
        return this.slots[index].item;
    }

    /// <summary>
    /// 装备一件物品：要求槽位名非空、物品为 Equipment 类别、背包
    /// 能扣出 1 件。替换时旧件退回背包，退不下则整体回滚返回
    /// false。成功返回 true。
    /// </summary>
    bool Equip(
        string slot,
        ArpgItemDefinition definition,
        ArpgInventory inventory
    ) {
        if (slot == null || slot == "" || definition == null || inventory == null) {
            return false;
        }
        if (definition.Category() != ArpgItemCategory.Equipment()) {
            return false;
        }
        if (!inventory.Remove(definition.Id(), 1)) { return false; }

        int index = this.IndexOf(slot);
        if (index >= 0) {
            ArpgItemDefinition old = this.slots[index].item;
            int restored = inventory.Add(old, 1);
            if (restored != 1) {
                inventory.Add(definition, 1);
                return false;
            }
            this.slots[index].item = definition;
        } else {
            this.slots.Add(new ArpgEquipSlot(slot, definition));
        }
        return true;
    }

    /// 卸下槽位装备退回背包（放不下返回 false）。槽位为空或
    /// inventory 为 null 返回 false。
    bool Unequip(string slot, ArpgInventory inventory) {
        int index = this.IndexOf(slot);
        if (index < 0 || inventory == null) { return false; }
        ArpgItemDefinition old = this.slots[index].item;
        if (inventory.Add(old, 1) != 1) { return false; }
        this.slots.RemoveAt(index);
        return true;
    }

    /// 已装备的槽位数。
    int Count() { return this.slots.Count; }
    /// 第 index 个槽位的名称（不查越界）。
    string SlotNameAt(int index) { return this.slots[index].slot; }
    /// 第 index 个槽位的物品（不查越界）。
    ArpgItemDefinition ItemAt(int index) { return this.slots[index].item; }

    /// 汇总全部已装备物品的属性修正（无装备时为零值属性）。
    ArpgAttributes Attributes() {
        ArpgAttributes attributes = new ArpgAttributes();
        for (int i = 0; i < this.slots.Count; i = i + 1) {
            attributes.AddModifiersFrom(this.slots[i].item.Attributes());
        }
        return attributes;
    }
}

// 单个生效中的冷却：名称、剩余时间与原始时长（用于
// 进度显示）。用单个实体代替三个平行列表。
/// <summary>单个生效中的冷却：名称、剩余毫秒与总时长毫秒。</summary>
class ArpgCooldownEntry {
    /// 冷却名（如 "skill:fire"）。
    string name;
    /// 剩余毫秒。
    int remaining;
    /// 启动时的总时长毫秒（供进度计算）。
    int duration;

    /// 构造一条冷却记录。
    ArpgCooldownEntry(string name, int remaining, int duration) {
        this.name = name;
        this.remaining = remaining;
        this.duration = duration;
    }
}

/// <summary>
/// 按名称管理的冷却集合。同名 Start 覆盖重置；Tick 递减剩余
/// 时间，到 0 的条目自动移除。冷却时间单位均为毫秒。
/// </summary>
class ArpgCooldowns {
    List<ArpgCooldownEntry> entries;

    /// 构造空冷却集合。
    ArpgCooldowns() {
        this.entries = new List<ArpgCooldownEntry>();
    }

    /// 冷却名对应下标；不存在返回 -1。
    int IndexOf(string name) {
        for (int i = 0; i < this.entries.Count; i = i + 1) {
            if (this.entries[i].name == name) { return i; }
        }
        return -1;
    }

    /// <summary>
    /// 启动/重置指定冷却。name 为 null/空或 milliseconds ≤ 0 时
    /// 忽略；同名冷却被覆盖。
    /// </summary>
    void Start(string name, int milliseconds) {
        if (name == null || name == "" || milliseconds <= 0) { return; }
        int index = this.IndexOf(name);
        if (index < 0) {
            this.entries.Add(new ArpgCooldownEntry(name, milliseconds, milliseconds));
        } else {
            this.entries[index].remaining = milliseconds;
            this.entries[index].duration = milliseconds;
        }
    }

    /// 冷却是否就绪（未启动或剩余 ≤0 均视为就绪）。
    bool IsReady(string name) {
        int index = this.IndexOf(name);
        return index < 0 || this.entries[index].remaining <= 0;
    }

    /// 剩余毫秒；未启动该冷却返回 0。
    int Remaining(string name) {
        int index = this.IndexOf(name);
        if (index < 0) { return 0; }
        return this.entries[index].remaining;
    }

    /// 冷却进度百分比 0–100（已就绪/未启动为 100）。
    int Progress(string name) {
        int index = this.IndexOf(name);
        if (index < 0 || this.entries[index].remaining <= 0) { return 100; }
        int duration = this.entries[index].duration;
        if (duration <= 0) { return 100; }
        return (duration - this.entries[index].remaining) * 100 / duration;
    }

    /// 推进全部冷却并移除到期的条目；deltaMilliseconds ≤ 0 无效。
    void Tick(int deltaMilliseconds) {
        if (deltaMilliseconds <= 0) { return; }
        int i = this.entries.Count - 1;
        while (i >= 0) {
            this.entries[i].remaining = this.entries[i].remaining - deltaMilliseconds;
            if (this.entries[i].remaining <= 0) {
                this.entries.RemoveAt(i);
            }
            i = i - 1;
        }
    }
}

/// <summary>适合回放与测试的小型确定性随机数生成器。</summary>
class ArpgRandom {
    int state;

    /// 构造生成器；种子与 0x7FFFFFFF 按位与，0 时强制为 1。
    ArpgRandom(int seed) {
        this.state = seed & 2147483647;
        if (this.state == 0) { this.state = 1; }
    }

    /// 返回 [0, 2147483647] 内的下一个伪随机整数（LCG）。
    int Next() {
        this.state = (this.state * 1103515245 + 12345) & 2147483647;
        return this.state;
    }

    /// 返回 [1, 100] 内的百分比掷点（命中/暴击判定用）。
    int NextPercent() { return this.Next() % 100 + 1; }
}

/// <summary>
/// 网格战斗计算：切比雪夫距离、目标合法性（阵营判定）、命中
/// 率（命中率 = accuracy / (accuracy + evasion) × 100）与伤害
/// （attack × DamageFactor − defense，下限 1，暴击乘
/// CriticalDamage%）。
/// </summary>
class ArpgCombat {
    /// 两角色所在格子的切比雪夫距离（棋盘王步距离）。
    static int GridDistance(ArpgActor left, ArpgActor right) {
        int dx = left.GridX() - right.GridX();
        int dy = left.GridY() - right.GridY();
        if (dx < 0) { dx = -dx; }
        if (dy < 0) { dy = -dy; }
        return ArpgMath.Max(dx, dy);
    }

    /// <summary>
    /// 目标是否合法：要求 caster/target 非空且 target 存活；
    /// 按 targetFaction 判定阵营（Any 全通过，Friendly 同阵营，
    /// Hostile 异阵营，其余精确匹配阵营名）。
    /// </summary>
    static bool IsValidTarget(
        ArpgActor caster,
        ArpgActor target,
        string targetFaction
    ) {
        if (caster == null || target == null || !target.IsAlive()) { return false; }
        if (targetFaction == ArpgFaction.Any()) { return true; }
        if (targetFaction == ArpgFaction.Friendly()) {
            return caster.Faction() == target.Faction();
        }
        if (targetFaction == ArpgFaction.Hostile()) {
            return caster.Faction() != target.Faction();
        }
        return target.Faction() == targetFaction;
    }

    /// 命中率百分比 0–100：accuracy/(accuracy+evasion)×100，
    /// 分母 ≤0 时直接判满 100。
    static int HitChance(ArpgActor caster, ArpgActor target) {
        ArpgAttributes source = caster.EffectiveAttributes();
        ArpgAttributes destination = target.EffectiveAttributes();
        double denominator = source.Accuracy() + destination.Evasion();
        if (denominator <= 0.0) { return 100; }
        int chance = (int)(source.Accuracy() / denominator * 100.0);
        return ArpgMath.Clamp(chance, 0, 100);
    }

    /// 期望伤害：attack × 技能 DamageFactor − defense，下限 1.0；
    /// 暴击再乘攻击方 CriticalDamage/100。
    static double Damage(
        ArpgActor caster,
        ArpgActor target,
        ArpgSkillDefinition skill,
        bool critical
    ) {
        ArpgAttributes source = caster.EffectiveAttributes();
        ArpgAttributes destination = target.EffectiveAttributes();
        double attack = source.GetCustom("attack");
        double defense = destination.GetCustom("defense");
        double damage = attack * skill.DamageFactor() - defense;
        if (damage < 1.0) { damage = 1.0; }
        if (critical) {
            damage = damage * source.CriticalDamage() / 100.0;
        }
        return damage;
    }
}
