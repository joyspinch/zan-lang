using System;

namespace Game.Arpg;

/// <summary>
/// Arpg 定义使用的 RGBA 颜色。构造时各通道钳制到 0–255。
/// </summary>
class ArpgColor {
    int red;
    int green;
    int blue;
    int alpha;

    /// 构造颜色；各分量在构造时钳制到 [0,255]。
    ArpgColor(int red, int green, int blue, int alpha) {
        this.red = ArpgMath.Clamp(red, 0, 255);
        this.green = ArpgMath.Clamp(green, 0, 255);
        this.blue = ArpgMath.Clamp(blue, 0, 255);
        this.alpha = ArpgMath.Clamp(alpha, 0, 255);
    }

    /// 完全透明（0,0,0,0）。
    static ArpgColor Transparent() { return new ArpgColor(0, 0, 0, 0); }
    /// 不透明黑。
    static ArpgColor Black() { return new ArpgColor(0, 0, 0, 255); }
    /// 不透明白。
    static ArpgColor White() { return new ArpgColor(255, 255, 255, 255); }

    /// 红色分量（0–255）。
    int Red() { return this.red; }
    /// 绿色分量（0–255）。
    int Green() { return this.green; }
    /// 蓝色分量（0–255）。
    int Blue() { return this.blue; }
    /// alpha 分量：0 全透明，255 不透明。
    int Alpha() { return this.alpha; }
}

/// <summary>逻辑坐标下的二维点。</summary>
class ArpgPoint {
    double x;
    double y;

    /// 构造点。
    ArpgPoint(double x, double y) {
        this.x = x;
        this.y = y;
    }

    /// X 坐标。
    double X() { return this.x; }
    /// Y 坐标。
    double Y() { return this.y; }
    /// 同时重设两个坐标。
    void Set(double x, double y) {
        this.x = x;
        this.y = y;
    }
}

/// <summary>逻辑坐标下的轴对齐矩形（x,y 为左上角）。</summary>
class ArpgRect {
    double x;
    double y;
    double width;
    double height;

    /// 构造矩形。
    ArpgRect(double x, double y, double width, double height) {
        this.x = x;
        this.y = y;
        this.width = width;
        this.height = height;
    }

    /// 左上角 X。
    double X() { return this.x; }
    /// 左上角 Y。
    double Y() { return this.y; }
    /// 宽度。
    double Width() { return this.width; }
    /// 高度。
    double Height() { return this.height; }
}

/// <summary>Arpg 校验/构造时使用的整型与浮点小工具。</summary>
class ArpgMath {
    /// 返回 newValue 钳制到 [minimum, maximum] 后的结果。
    static int Clamp(int newValue, int minimum, int maximum) {
        if (newValue < minimum) { return minimum; }
        if (newValue > maximum) { return maximum; }
        return newValue;
    }

    /// 返回 newValue 钳制到 [minimum, maximum] 后的结果（浮点版）。
    static double ClampDouble(double newValue, double minimum, double maximum) {
        if (newValue < minimum) { return minimum; }
        if (newValue > maximum) { return maximum; }
        return newValue;
    }

    /// 返回两者中较大的整数；相等时返回 right。
    static int Max(int left, int right) {
        if (left > right) { return left; }
        return right;
    }
}

/// <summary>
/// 屏幕适配模式：0=Fixed 固定窗口 1=Scale 等比缩放（窗口可拉伸，
/// 逻辑分辨率不变）2=ResizeWorld 拉伸并扩展可视世界
/// 3=TransparentBorderless 无边框透明。IsValid 判断 0–3。
/// </summary>
class ArpgScreenMode {
    /// 固定尺寸窗口模式（0）。
    static int Fixed() { return 0; }
    /// 等比缩放模式（1），窗口可调整、渲染按逻辑分辨率拉伸。
    static int Scale() { return 1; }
    /// 扩展世界模式（2），可视范围随窗口变化。
    static int ResizeWorld() { return 2; }
    /// 无边框透明窗口模式（3）。
    static int TransparentBorderless() { return 3; }

    /// mode 是否为合法的屏幕模式（0–3）。
    static bool IsValid(int mode) {
        return mode >= Fixed() && mode <= TransparentBorderless();
    }
}

/// <summary>
/// 组件种类字符串常量。ArpgProject 按 kind 归类资源，
/// IsValid 判断是否为这八种之一。
/// </summary>
class ArpgComponentKind {
    /// 地图组件（"map"）。
    static string Map() { return "map"; }
    /// 角色组件（"actor"）。
    static string Actor() { return "actor"; }
    /// 物品组件（"item"）。
    static string Item() { return "item"; }
    /// 技能组件（"skill"）。
    static string Skill() { return "skill"; }
    /// 增益组件（"buff"）。
    static string Buff() { return "buff"; }
    /// 窗口组件（"window"）。
    static string Window() { return "window"; }
    /// 成长曲线组件（"growth"）。
    static string Growth() { return "growth"; }
    /// 预制体组件（"prefab"）。
    static string Prefab() { return "prefab"; }

    /// kind 是否为合法组件种类。
    static bool IsValid(string kind) {
        return kind == Map()
            || kind == Actor()
            || kind == Item()
            || kind == Skill()
            || kind == Buff()
            || kind == Window()
            || kind == Growth()
            || kind == Prefab();
    }
}

/// <summary>
/// 阵营字符串常量。战斗目标判定按 caster 与 target 的阵营比较；
/// Any 通配任意阵营。
/// </summary>
class ArpgFaction {
    /// 友方（与施法者同阵营）。
    static string Friendly() { return "friendly"; }
    /// 中立（独立阵营，与 friendly/hostile 均不同）。
    static string Neutral() { return "neutral"; }
    /// 敌方（与施法者不同阵营）。
    static string Hostile() { return "hostile"; }
    /// 任意阵营。
    static string Any() { return "any"; }
}

/// <summary>诊断级别：0=信息 1=警告 2=错误。</summary>
class ArpgDiagnosticSeverity {
    /// 信息级（0）。
    static int Info() { return 0; }
    /// 警告级（1）。
    static int Warning() { return 1; }
    /// 错误级（2），存在时 Validate 判定为不通过。
    static int Error() { return 2; }
}

/// <summary>单条诊断信息：级别、错误码、出错路径与英文说明。</summary>
class ArpgDiagnostic {
    int severity;
    string code;
    string path;
    string message;

    /// 构造一条诊断。
    ArpgDiagnostic(
        int severity,
        string code,
        string path,
        string message
    ) {
        this.severity = severity;
        this.code = code;
        this.path = path;
        this.message = message;
    }

    /// 级别（ArpgDiagnosticSeverity 常量之一）。
    int Severity() { return this.severity; }
    /// 机器可读错误码（如 "L2PRJ001"）。
    string Code() { return this.code; }
    /// 出错位置（点分路径，如 "actors.player.skills"）。
    string Path() { return this.path; }
    /// 英文说明文本。
    string Message() { return this.message; }
}

/// <summary>收集校验错误，而不是在首个问题处抛异常。</summary>
class ArpgDiagnostics {
    List<ArpgDiagnostic> items;
    int errorCount;
    int warningCount;

    /// 构造空诊断集合。
    ArpgDiagnostics() {
        this.items = new List<ArpgDiagnostic>();
        this.errorCount = 0;
        this.warningCount = 0;
    }

    /// 追加一条错误诊断并使 ErrorCount() 自增。
    void AddError(string code, string path, string message) {
        this.items.Add(new ArpgDiagnostic(
            ArpgDiagnosticSeverity.Error(), code, path, message));
        this.errorCount = this.errorCount + 1;
    }

    /// 追加一条警告诊断并使 WarningCount() 自增。
    void AddWarning(string code, string path, string message) {
        this.items.Add(new ArpgDiagnostic(
            ArpgDiagnosticSeverity.Warning(), code, path, message));
        this.warningCount = this.warningCount + 1;
    }

    /// 是否存在任何错误（ErrorCount() > 0）。
    bool HasErrors() { return this.errorCount > 0; }
    /// 错误条数。
    int ErrorCount() { return this.errorCount; }
    /// 警告条数。
    int WarningCount() { return this.warningCount; }
    /// 诊断总数（错误+警告+信息）。
    int Count() { return this.items.Count; }
    /// 第 index 条诊断（不查越界）。
    ArpgDiagnostic At(int index) { return this.items[index]; }

    /// 把 other 的全部条目并入自身并累计各级计数。
    void Append(ArpgDiagnostics other) {
        for (int i = 0; i < other.Count(); i = i + 1) {
            ArpgDiagnostic diagnostic = other.At(i);
            this.items.Add(diagnostic);
            if (diagnostic.Severity() == ArpgDiagnosticSeverity.Error()) {
                this.errorCount = this.errorCount + 1;
            } else if (diagnostic.Severity() == ArpgDiagnosticSeverity.Warning()) {
                this.warningCount = this.warningCount + 1;
            }
        }
    }
}

/// <summary>常用字段断言助手：失败时向 diagnostics 记错误。</summary>
class ArpgValidation {
    /// <summary>
    /// 必填字符串校验：为 null 或空串时记录错误并返回 false，
    /// 否则返回 true。
    /// </summary>
    static bool Required(
        ArpgDiagnostics diagnostics,
        string newValue,
        string path,
        string code
    ) {
        if (newValue == null || newValue == "") {
            diagnostics.AddError(code, path, "Value is required.");
            return false;
        }
        return true;
    }

    /// 正数校验：newValue ≤ 0 时记录错误并返回 false。
    static bool Positive(
        ArpgDiagnostics diagnostics,
        int newValue,
        string path,
        string code
    ) {
        if (newValue <= 0) {
            diagnostics.AddError(code, path, "Value must be greater than zero.");
            return false;
        }
        return true;
    }
}
