using System;

namespace Game.Arpg;

/// <summary>
/// 内存组件数据库。与文件格式无关，因此工具
/// 可从 JSON、Zan 源码、编辑器或其他管线生成它。
/// </summary>
class ArpgProject {
    ArpgRegistry registry;
    List<ArpgMapDefinition> maps;
    List<ArpgActorDefinition> actors;
    List<ArpgItemDefinition> items;
    List<ArpgSkillDefinition> skills;
    List<ArpgBuffDefinition> buffs;
    List<ArpgWindowDefinition> windows;
    List<ArpgGrowthDefinition> growth;
    List<ArpgPrefabDefinition> prefabs;
    List<SqliteComponentConfig> databases;

    ArpgProject() {
        this.registry = new ArpgRegistry();
        this.maps = new List<ArpgMapDefinition>();
        this.actors = new List<ArpgActorDefinition>();
        this.items = new List<ArpgItemDefinition>();
        this.skills = new List<ArpgSkillDefinition>();
        this.buffs = new List<ArpgBuffDefinition>();
        this.windows = new List<ArpgWindowDefinition>();
        this.growth = new List<ArpgGrowthDefinition>();
        this.prefabs = new List<ArpgPrefabDefinition>();
        this.databases = new List<SqliteComponentConfig>();
    }

    /// 组件注册表（资源定义），随 LoadProject 替换。
    ArpgRegistry Registry() { return this.registry; }

    /// 追加一个地图定义（不做去重，重复 id 由 Validate 报告）。
    void AddMap(ArpgMapDefinition newValue) { this.maps.Add(newValue); }
    /// 追加一个角色定义。
    void AddActor(ArpgActorDefinition newValue) { this.actors.Add(newValue); }
    /// 追加一个物品定义。
    void AddItem(ArpgItemDefinition newValue) { this.items.Add(newValue); }
    /// 追加一个技能定义。
    void AddSkill(ArpgSkillDefinition newValue) { this.skills.Add(newValue); }
    /// 追加一个增益定义。
    void AddBuff(ArpgBuffDefinition newValue) { this.buffs.Add(newValue); }
    /// 追加一个窗口定义。
    void AddWindow(ArpgWindowDefinition newValue) { this.windows.Add(newValue); }
    /// 追加一个成长曲线定义。
    void AddGrowth(ArpgGrowthDefinition newValue) { this.growth.Add(newValue); }
    /// 追加一个预制体定义。
    void AddPrefab(ArpgPrefabDefinition newValue) { this.prefabs.Add(newValue); }
    /// 追加一个 SQLite 组件数据库配置。
    void AddDatabase(SqliteComponentConfig newValue) { this.databases.Add(newValue); }

    /// 地图定义数量。
    int MapCount() { return this.maps.Count; }
    /// 角色定义数量。
    int ActorCount() { return this.actors.Count; }
    /// 物品定义数量。
    int ItemCount() { return this.items.Count; }
    /// 技能定义数量。
    int SkillCount() { return this.skills.Count; }
    /// 增益定义数量。
    int BuffCount() { return this.buffs.Count; }
    /// 窗口定义数量。
    int WindowCount() { return this.windows.Count; }
    /// 成长曲线定义数量。
    int GrowthCount() { return this.growth.Count; }
    /// 预制体定义数量。
    int PrefabCount() { return this.prefabs.Count; }

    /// 第 index 个地图定义（不查越界）。
    ArpgMapDefinition MapAt(int index) { return this.maps[index]; }
    /// 第 index 个角色定义（不查越界）。
    ArpgActorDefinition ActorAt(int index) { return this.actors[index]; }
    /// 第 index 个物品定义（不查越界）。
    ArpgItemDefinition ItemAt(int index) { return this.items[index]; }
    /// 第 index 个技能定义（不查越界）。
    ArpgSkillDefinition SkillAt(int index) { return this.skills[index]; }
    /// 第 index 个增益定义（不查越界）。
    ArpgBuffDefinition BuffAt(int index) { return this.buffs[index]; }
    /// 第 index 个窗口定义（不查越界）。
    ArpgWindowDefinition WindowAt(int index) { return this.windows[index]; }
    /// 第 index 个成长曲线定义（不查越界）。
    ArpgGrowthDefinition GrowthAt(int index) { return this.growth[index]; }
    /// 第 index 个预制体定义（不查越界）。
    ArpgPrefabDefinition PrefabAt(int index) { return this.prefabs[index]; }
    /// 数据库配置数量。
    int DatabaseCount() { return this.databases.Count; }
    /// 第 index 个数据库配置（不查越界）。
    SqliteComponentConfig DatabaseAt(int index) { return this.databases[index]; }

    /// 按 id 查找地图定义；找不到返回 null。
    ArpgMapDefinition FindMap(string id) {
        for (int i = 0; i < this.maps.Count; i = i + 1) {
            if (this.maps[i].Id() == id) { return this.maps[i]; }
        }
        return null;
    }

    /// 按 id 查找角色定义；找不到返回 null。
    ArpgActorDefinition FindActor(string id) {
        for (int i = 0; i < this.actors.Count; i = i + 1) {
            if (this.actors[i].Id() == id) { return this.actors[i]; }
        }
        return null;
    }

    /// 按 id 查找物品定义；找不到返回 null。
    ArpgItemDefinition FindItem(string id) {
        for (int i = 0; i < this.items.Count; i = i + 1) {
            if (this.items[i].Id() == id) { return this.items[i]; }
        }
        return null;
    }

    /// 按 id 查找技能定义；找不到返回 null。
    ArpgSkillDefinition FindSkill(string id) {
        for (int i = 0; i < this.skills.Count; i = i + 1) {
            if (this.skills[i].Id() == id) { return this.skills[i]; }
        }
        return null;
    }

    /// 按 id 查找增益定义；找不到返回 null。
    ArpgBuffDefinition FindBuff(string id) {
        for (int i = 0; i < this.buffs.Count; i = i + 1) {
            if (this.buffs[i].Id() == id) { return this.buffs[i]; }
        }
        return null;
    }

    /// 按 id 查找窗口定义；找不到返回 null。
    ArpgWindowDefinition FindWindow(string id) {
        for (int i = 0; i < this.windows.Count; i = i + 1) {
            if (this.windows[i].Id() == id) { return this.windows[i]; }
        }
        return null;
    }

    /// 按 id 查找成长曲线定义；找不到返回 null。
    ArpgGrowthDefinition FindGrowth(string id) {
        for (int i = 0; i < this.growth.Count; i = i + 1) {
            if (this.growth[i].Id() == id) { return this.growth[i]; }
        }
        return null;
    }

    /// 按 id 查找预制体定义；找不到返回 null。
    ArpgPrefabDefinition FindPrefab(string id) {
        for (int i = 0; i < this.prefabs.Count; i = i + 1) {
            if (this.prefabs[i].Id() == id) { return this.prefabs[i]; }
        }
        return null;
    }

    /// 按名称查找数据库配置；找不到返回 null。
    SqliteComponentConfig FindDatabase(string name) {
        for (int i = 0; i < this.databases.Count; i = i + 1) {
            if (this.databases[i].Name() == name) { return this.databases[i]; }
        }
        return null;
    }

    /// 返回标记为默认地图的定义；没有或多个默认时返回第一个
    /// 命中项，全无默认返回 null。
    ArpgMapDefinition DefaultMap() {
        for (int i = 0; i < this.maps.Count; i = i + 1) {
            if (this.maps[i].DefaultMap()) { return this.maps[i]; }
        }
        return null;
    }

    /// 返回标记为默认玩家的角色定义；无默认玩家返回 null。
    ArpgActorDefinition DefaultPlayer() {
        for (int i = 0; i < this.actors.Count; i = i + 1) {
            if (this.actors[i].DefaultPlayer()) { return this.actors[i]; }
        }
        return null;
    }

    /// 校验资源 id 引用：非空且注册表中不存在时记录
    /// L2PRJ017 错误。空串视为未引用，跳过。
    void ValidateResource(
        ArpgDiagnostics diagnostics,
        string resourceId,
        string path
    ) {
        if (resourceId != "" && !this.registry.HasResource(resourceId)) {
            diagnostics.AddError(
                "L2PRJ017", path, "Referenced resource id was not found.");
        }
    }

    /// <summary>
    /// 全量校验项目：汇总注册表校验与各类定义的逐项校验、
    /// 传送门/出生点与默认地图/默认玩家规则。返回诊断集合；
    /// HasErrors() 为 true 表示项目不可启动。
    /// </summary>
    ArpgDiagnostics Validate() {
        ArpgDiagnostics diagnostics = this.registry.Validate();
        this.ValidateMaps(diagnostics);
        this.ValidateActors(diagnostics);
        this.ValidateItems(diagnostics);
        this.ValidateSkills(diagnostics);
        this.ValidateBuffs(diagnostics);
        this.ValidateWindows(diagnostics);
        this.ValidateGrowth(diagnostics);
        this.ValidatePrefabs(diagnostics);
        this.ValidateMapPortals(diagnostics);
        this.ValidateDefaultPlayer(diagnostics);
        return diagnostics;
    }

    /// 地图定义：逐图校验、资源、重复 id。
    void ValidateMaps(ArpgDiagnostics diagnostics) {
        for (int i = 0; i < this.maps.Count; i = i + 1) {
            this.maps[i].Validate(diagnostics);
            this.ValidateResource(
                diagnostics,
                this.maps[i].TemplateResource(),
                "maps." + this.maps[i].Id() + ".templateResource");
            this.ValidateResource(
                diagnostics,
                this.maps[i].MiniMapResource(),
                "maps." + this.maps[i].Id() + ".miniMapResource");
            int j = i + 1;
            while (j < this.maps.Count) {
                if (this.maps[i].Id() == this.maps[j].Id()) {
                    diagnostics.AddError(
                        "L2PRJ001", "maps." + this.maps[i].Id(), "Duplicate map id.");
                }
                j = j + 1;
            }
        }
    }

    /// 角色定义：校验、重复 id、成长/技能/增益引用。
    void ValidateActors(ArpgDiagnostics diagnostics) {
        for (int i = 0; i < this.actors.Count; i = i + 1) {
            ArpgActorDefinition actor = this.actors[i];
            actor.Validate(diagnostics);
            int j = i + 1;
            while (j < this.actors.Count) {
                if (actor.Id() == this.actors[j].Id()) {
                    diagnostics.AddError(
                        "L2PRJ002", "actors." + actor.Id(), "Duplicate actor id.");
                }
                j = j + 1;
            }
            if (actor.GrowthId() != "" && this.FindGrowth(actor.GrowthId()) == null) {
                diagnostics.AddError(
                    "L2PRJ003",
                    "actors." + actor.Id() + ".growth",
                    "Referenced growth definition was not found.");
            }
            for (int s = 0; s < actor.SkillCount(); s = s + 1) {
                if (this.FindSkill(actor.SkillAt(s)) == null) {
                    diagnostics.AddError(
                        "L2PRJ004",
                        "actors." + actor.Id() + ".skills",
                        "Referenced skill definition was not found.");
                }
            }
            for (int b = 0; b < actor.StartingBuffCount(); b = b + 1) {
                if (this.FindBuff(actor.StartingBuffAt(b)) == null) {
                    diagnostics.AddError(
                        "L2PRJ005",
                        "actors." + actor.Id() + ".buffs",
                        "Referenced buff definition was not found.");
                }
            }
        }
    }

    /// 物品定义：校验、图标资源、重复 id。
    void ValidateItems(ArpgDiagnostics diagnostics) {
        for (int i = 0; i < this.items.Count; i = i + 1) {
            this.items[i].Validate(diagnostics);
            this.ValidateResource(
                diagnostics,
                this.items[i].IconResource(),
                "items." + this.items[i].Id() + ".iconResource");
            int j = i + 1;
            while (j < this.items.Count) {
                if (this.items[i].Id() == this.items[j].Id()) {
                    diagnostics.AddError(
                        "L2PRJ006", "items." + this.items[i].Id(), "Duplicate item id.");
                }
                j = j + 1;
            }
        }
    }

    /// 技能定义：校验、图标、增益效果引用、重复 id。
    void ValidateSkills(ArpgDiagnostics diagnostics) {
        for (int i = 0; i < this.skills.Count; i = i + 1) {
            ArpgSkillDefinition skill = this.skills[i];
            skill.Validate(diagnostics);
            this.ValidateResource(
                diagnostics,
                skill.IconResource(),
                "skills." + skill.Id() + ".iconResource");
            for (int b = 0; b < skill.BuffEffectCount(); b = b + 1) {
                if (this.FindBuff(skill.BuffEffectAt(b)) == null) {
                    diagnostics.AddError(
                        "L2PRJ019",
                        "skills." + skill.Id() + ".buffEffects",
                        "Referenced buff definition was not found.");
                }
            }
            int j = i + 1;
            while (j < this.skills.Count) {
                if (skill.Id() == this.skills[j].Id()) {
                    diagnostics.AddError(
                        "L2PRJ007", "skills." + skill.Id(), "Duplicate skill id.");
                }
                j = j + 1;
            }
        }
    }

    /// 增益定义：校验、图标、重复 id。
    void ValidateBuffs(ArpgDiagnostics diagnostics) {
        for (int i = 0; i < this.buffs.Count; i = i + 1) {
            this.buffs[i].Validate(diagnostics);
            this.ValidateResource(
                diagnostics,
                this.buffs[i].IconResource(),
                "buffs." + this.buffs[i].Id() + ".iconResource");
            int j = i + 1;
            while (j < this.buffs.Count) {
                if (this.buffs[i].Id() == this.buffs[j].Id()) {
                    diagnostics.AddError(
                        "L2PRJ008", "buffs." + this.buffs[i].Id(), "Duplicate buff id.");
                }
                j = j + 1;
            }
        }
    }

    /// 窗口定义：校验、背景、重复 id。
    void ValidateWindows(ArpgDiagnostics diagnostics) {
        for (int i = 0; i < this.windows.Count; i = i + 1) {
            this.windows[i].Validate(diagnostics);
            this.ValidateResource(
                diagnostics,
                this.windows[i].BackgroundResource(),
                "windows." + this.windows[i].Id() + ".backgroundResource");
            int j = i + 1;
            while (j < this.windows.Count) {
                if (this.windows[i].Id() == this.windows[j].Id()) {
                    diagnostics.AddError(
                        "L2PRJ009",
                        "windows." + this.windows[i].Id(),
                        "Duplicate window id.");
                }
                j = j + 1;
            }
        }
    }

    /// 成长定义：校验、重复 id。
    void ValidateGrowth(ArpgDiagnostics diagnostics) {
        for (int i = 0; i < this.growth.Count; i = i + 1) {
            this.growth[i].Validate(diagnostics);
            int j = i + 1;
            while (j < this.growth.Count) {
                if (this.growth[i].Id() == this.growth[j].Id()) {
                    diagnostics.AddError(
                        "L2PRJ010",
                        "growth." + this.growth[i].Id(),
                        "Duplicate growth id.");
                }
                j = j + 1;
            }
        }
    }

    /// 预制体定义：校验、背景、重复 id。
    void ValidatePrefabs(ArpgDiagnostics diagnostics) {
        for (int i = 0; i < this.prefabs.Count; i = i + 1) {
            this.prefabs[i].Validate(diagnostics);
            this.ValidateResource(
                diagnostics,
                this.prefabs[i].BackgroundResource(),
                "prefabs." + this.prefabs[i].Id() + ".backgroundResource");
            int j = i + 1;
            while (j < this.prefabs.Count) {
                if (this.prefabs[i].Id() == this.prefabs[j].Id()) {
                    diagnostics.AddError(
                        "L2PRJ011",
                        "prefabs." + this.prefabs[i].Id(),
                        "Duplicate prefab id.");
                }
                j = j + 1;
            }
        }
    }

    /// 地图传送门/出生点及单一默认地图规则。
    void ValidateMapPortals(ArpgDiagnostics diagnostics) {
        int defaultMapCount = 0;
        for (int i = 0; i < this.maps.Count; i = i + 1) {
            ArpgMapDefinition map = this.maps[i];
            if (map.DefaultMap()) { defaultMapCount = defaultMapCount + 1; }
            for (int p = 0; p < map.PortalCount(); p = p + 1) {
                ArpgMapPortal portal = map.PortalAt(p);
                ArpgMapDefinition targetMap =
                    this.FindMap(portal.TargetMapId());
                if (targetMap == null) {
                    diagnostics.AddError(
                        "L2PRJ012",
                        "maps." + map.Id() + ".portals",
                        "Portal target map was not found.");
                } else if (!targetMap.IsInside(
                    portal.TargetGridX(), portal.TargetGridY())) {
                    diagnostics.AddError(
                        "L2PRJ018",
                        "maps." + map.Id() + ".portals",
                        "Portal destination is outside the target map grid.");
                }
            }
            for (int s = 0; s < map.SpawnCount(); s = s + 1) {
                if (this.FindActor(map.SpawnAt(s).ActorId()) == null) {
                    diagnostics.AddError(
                        "L2PRJ013",
                        "maps." + map.Id() + ".spawns",
                        "Spawn actor definition was not found.");
                }
            }
        }
        if (this.maps.Count > 0 && defaultMapCount == 0) {
            diagnostics.AddWarning(
                "L2PRJ014", "maps", "Project has maps but no default map.");
        }
        if (defaultMapCount > 1) {
            diagnostics.AddError(
                "L2PRJ015", "maps", "Only one map can be the default map.");
        }
    }

    /// 单一默认玩家规则。
    void ValidateDefaultPlayer(ArpgDiagnostics diagnostics) {
        int playerCount = 0;
        for (int i = 0; i < this.actors.Count; i = i + 1) {
            if (this.actors[i].DefaultPlayer()) { playerCount = playerCount + 1; }
        }
        if (playerCount > 1) {
            diagnostics.AddError(
                "L2PRJ016", "actors", "Only one actor can be the default player.");
        }
    }
}

/// <summary>
/// 独立于不可变组件定义的实时地图状态。经
/// CreateWithEvents 构造（固定种子随机数），承载当前地图、
/// 全部角色实例与玩家引用；所有玩法操作（移动/物品/装备/
/// buff/技能/传送门/时间推进）都从这里进入。
/// </summary>
class ArpgWorld {
    ArpgProject project;
    ArpgMapDefinition currentMap;
    List<ArpgActor> actors;
    ArpgActor player;
    int nextInstanceId;
    ArpgEvents systemEvents;
    ArpgGameplayEvents gameplayEvents;
    ArpgRandom random;

    /// <summary>
    /// 构造一个未进图的空世界，绑定事件总线；随机数使用固定
    /// 种子 19790327（回放/测试确定性）。
    /// </summary>
    static ArpgWorld CreateWithEvents(
        ArpgProject project,
        ArpgEvents systemEvents,
        ArpgGameplayEvents gameplayEvents
    ) {
        ArpgWorld world = new ArpgWorld();
        world.project = project;
        world.currentMap = null;
        world.actors = new List<ArpgActor>();
        world.player = null;
        world.nextInstanceId = 1;
        world.systemEvents = systemEvents;
        world.gameplayEvents = gameplayEvents;
        world.random = new ArpgRandom(19790327);
        return world;
    }

    /// 所属项目。
    ArpgProject Project() { return this.project; }
    /// 当前所在地图定义；未进图为 null。
    ArpgMapDefinition CurrentMap() { return this.currentMap; }
    /// 玩家实例；未进图或项目没有默认玩家为 null。
    ArpgActor Player() { return this.player; }
    /// 玩法事件总线（与传入的一致）。
    ArpgGameplayEvents GameplayEvents() { return this.gameplayEvents; }
    /// 场上角色数（含玩家）。
    int ActorCount() { return this.actors.Count; }
    /// 第 index 个角色（不查越界）。
    ArpgActor ActorAt(int index) { return this.actors[index]; }

    /// 追加新的玩家角色实例（等级钳制到 ≥1，空 faction 不覆盖）。
    /// 定义不存在、未进入地图或坐标越界时返回 null。
    ArpgActor CreateActor(
        string actorId,
        string faction,
        int gridX,
        int gridY,
        int level
    ) {
        ArpgActorDefinition definition = this.project.FindActor(actorId);
        if (definition == null || this.currentMap == null
            || !this.currentMap.IsInside(gridX, gridY)) {
            return null;
        }
        ArpgActor actor = ArpgActor.FromDefinition(
            definition.Id() + "#"
                + Convert.ToString(this.nextInstanceId),
            definition);
        this.nextInstanceId = this.nextInstanceId + 1;
        actor.SetGridPosition(gridX, gridY);
        actor.SetLevel(ArpgMath.Max(1, level));
        if (faction != "") { actor.SetFaction(faction); }
        this.ApplyStartingBuffs(actor, definition);
        this.actors.Add(actor);
        return actor;
    }

    /// 进入项目默认地图；没有默认地图时返回 false。
    bool EnterDefaultMap() {
        ArpgMapDefinition map = this.project.DefaultMap();
        if (map == null) { return false; }
        return this.EnterMap(map.Id());
    }

    /// 按地图 id 进入地图（不保留玩家实例，portalId 传 -1）；
    /// 地图不存在返回 false。
    bool EnterMap(string mapId) {
        return this.LoadMap(mapId, null, -1);
    }

    /// <summary>
    /// 加载地图并重建场上角色：preservedPlayer 非空时保留原玩家
    /// 实例，否则用默认玩家重建并置于地图出生点；随后按地图
    /// spawn 表刷出角色。成功后触发 MapChanged 事件；地图不存在
    /// 返回 false。
    /// </summary>
    bool LoadMap(string mapId, ArpgActor preservedPlayer, int portalId) {
        ArpgMapDefinition map = this.project.FindMap(mapId);
        if (map == null) { return false; }
        string previousMapId = "";
        if (this.currentMap != null) { previousMapId = this.currentMap.Id(); }
        this.currentMap = map;
        this.actors = new List<ArpgActor>();
        this.player = preservedPlayer;

        if (this.player == null) {
            ArpgActorDefinition playerDefinition = this.project.DefaultPlayer();
            if (playerDefinition != null) {
                this.player = ArpgActor.FromDefinition("player", playerDefinition);
                this.ApplyStartingBuffs(this.player, playerDefinition);
            }
        }
        if (this.player != null) {
            this.player.SetGridPosition(map.InitialGridX(), map.InitialGridY());
            this.actors.Add(this.player);
        }

        for (int i = 0; i < map.SpawnCount(); i = i + 1) {
            ArpgMapSpawn spawn = map.SpawnAt(i);
            ArpgActorDefinition definition = this.project.FindActor(spawn.ActorId());
            if (definition != null) {
                for (int n = 0; n < spawn.Count(); n = n + 1) {
                    string instanceId =
                        definition.Id() + "#" + Convert.ToString(this.nextInstanceId);
                    this.nextInstanceId = this.nextInstanceId + 1;
                    ArpgActor actor =
                        ArpgActor.FromDefinition(instanceId, definition);
                    actor.SetGridPosition(spawn.GridX(), spawn.GridY());
                    actor.SetDirection(spawn.Direction());
                    actor.SetLevel(spawn.Level());
                    if (spawn.Faction() != "") {
                        actor.SetFaction(spawn.Faction());
                    }
                    this.ApplyStartingBuffs(actor, definition);
                    this.actors.Add(actor);
                }
            }
        }
        this.gameplayEvents.RaiseMapChanged(
            previousMapId, this.currentMap.Id(), portalId);
        return true;
    }

    /// 按角色定义的初始增益列表依次施加（unique=true）。
    void ApplyStartingBuffs(
        ArpgActor actor,
        ArpgActorDefinition definition
    ) {
        for (int i = 0; i < definition.StartingBuffCount(); i = i + 1) {
            this.ApplyBuff(actor, definition.StartingBuffAt(i), actor, true);
        }
    }

    /// <summary>
    /// 把角色移动到目标格子：要求已进图、角色存活、无移动限制
    /// buff、目标在图内且非阻挡格。成功后触发 RemoveOnMove 类
    /// buff 移除；任一条件不满足返回 false。
    /// </summary>
    bool MoveActor(ArpgActor actor, int x, int y) {
        if (this.currentMap == null || actor == null) { return false; }
        if (!actor.IsAlive() || this.HasMovementRestriction(actor)) {
            return false;
        }
        if (!this.currentMap.IsInside(x, y) || this.currentMap.IsBlocked(x, y)) {
            return false;
        }
        actor.SetGridPosition(x, y);
        this.RemoveConditionalBuffs(actor, 1);
        return true;
    }

    /// 角色是否被禁止移动（身上存在 MovementDisabled 的 buff）。
    bool HasMovementRestriction(ArpgActor actor) {
        for (int i = 0; i < actor.BuffCount(); i = i + 1) {
            if (actor.BuffInstanceAt(i).Definition().MovementDisabled()) {
                return true;
            }
        }
        return false;
    }

    /// 角色是否被禁止攻击（身上存在 AttackDisabled 的 buff）。
    bool HasAttackRestriction(ArpgActor actor) {
        for (int i = 0; i < actor.BuffCount(); i = i + 1) {
            if (actor.BuffInstanceAt(i).Definition().AttackDisabled()) {
                return true;
            }
        }
        return false;
    }

    /// <summary>
    /// 给角色添加物品：受 MaxStack 与背包容量限制，返回实际加入
    /// 数量（0 表示全失败）。部分成功时触发 ItemChanged，未加满
    /// 时触发系统提示 4（背包已满）。count ≤ 0 或物品不存在返回 0。
    /// </summary>
    int AddItem(ArpgActor actor, string itemId, int count) {
        if (actor == null || count <= 0) { return 0; }
        ArpgItemDefinition item = this.project.FindItem(itemId);
        if (item == null) { return 0; }
        int added = actor.Inventory().Add(item, count);
        if (added > 0) {
            this.gameplayEvents.RaiseItemChanged(
                actor, item, actor.Inventory().QuantityOf(itemId));
        }
        if (added < count) {
            this.systemEvents.RaiseSystemPrompt(4, "Inventory is full.");
        }
        return added;
    }

    /// <summary>
    /// 使用一件消耗品：要求角色存活、物品存在且非装备类、库存
    /// 足够、等级达标（不足触发提示 3）、冷却就绪（未就绪触发
    /// 提示 2，冷却组为空时用 "item:<id>"）。成功时扣 1 个、按
    /// 固定值+最大值百分比恢复 HP/MP、启动冷却并触发
    /// ItemChanged/ItemUsed。失败返回 false（不消耗）。
    /// </summary>
    bool UseItem(ArpgActor actor, string itemId) {
        if (actor == null || !actor.IsAlive()) { return false; }
        ArpgItemDefinition item = this.project.FindItem(itemId);
        if (item == null
            || item.Category() == ArpgItemCategory.Equipment()
            || actor.Inventory().QuantityOf(itemId) <= 0) {
            return false;
        }
        if (actor.Level() < item.RequiredLevel()) {
            this.systemEvents.RaiseSystemPrompt(
                3, "Actor level is too low for this item.");
            return false;
        }
        string cooldownName = item.CooldownGroup();
        if (cooldownName == "") { cooldownName = "item:" + item.Id(); }
        if (!actor.Cooldowns().IsReady(cooldownName)) {
            this.systemEvents.RaiseSystemPrompt(2, "Item is cooling down.");
            return false;
        }

        ArpgAttributes effective = actor.EffectiveAttributes();
        double hp = (double)item.RestoreHp()
            + effective.MaxHp() * item.RestoreHpPercent() / 100.0;
        double mp = (double)item.RestoreMp()
            + effective.MaxMp() * item.RestoreMpPercent() / 100.0;
        if (!actor.Inventory().Remove(itemId, 1)) { return false; }
        actor.Heal(hp, mp);
        actor.Cooldowns().Start(
            cooldownName, item.CooldownMilliseconds());
        this.gameplayEvents.RaiseItemChanged(
            actor, item, actor.Inventory().QuantityOf(itemId));
        this.gameplayEvents.RaiseItemUsed(actor, item);
        return true;
    }

    /// <summary>
    /// 从背包装备一件物品到槽位：从背包扣除 1 件，同槽位旧装备
    /// 退回背包（放不下则整体失败）。成功后钳制生命值并触发
    /// ItemChanged。物品不存在/等级不足（触发提示 3）/非装备类
    /// 返回 false。
    /// </summary>
    bool EquipItem(ArpgActor actor, string itemId, string slot) {
        if (actor == null || actor.Level() < 1) { return false; }
        ArpgItemDefinition item = this.project.FindItem(itemId);
        if (item == null || actor.Level() < item.RequiredLevel()) {
            if (item != null) {
                this.systemEvents.RaiseSystemPrompt(
                    3, "Actor level is too low for this item.");
            }
            return false;
        }
        bool equipped = actor.Equipment().Equip(
            slot, item, actor.Inventory());
        if (equipped) {
            actor.ClampVitals();
            this.gameplayEvents.RaiseItemChanged(
                actor, item, actor.Inventory().QuantityOf(itemId));
        }
        return equipped;
    }

    /// 卸下槽位装备并放回背包（放不下返回 false）。成功后钳制
    /// 生命值并触发 ItemChanged。槽位为空返回 false。
    bool UnequipItem(ArpgActor actor, string slot) {
        if (actor == null) { return false; }
        ArpgItemDefinition item = actor.Equipment().Get(slot);
        if (item == null) { return false; }
        bool unequipped = actor.Equipment().Unequip(
            slot, actor.Inventory());
        if (unequipped) {
            actor.ClampVitals();
            this.gameplayEvents.RaiseItemChanged(
                actor, item, actor.Inventory().QuantityOf(item.Id()));
        }
        return unequipped;
    }

    /// <summary>
    /// 给存活角色施加增益：unique=true 时先移除同 id 旧实例。
    /// 成功后钳制生命值并触发 BuffChanged(added=true)；角色死亡
    /// 或增益定义不存在返回 null。
    /// </summary>
    ArpgBuffInstance ApplyBuff(
        ArpgActor actor,
        string buffId,
        ArpgActor source,
        bool unique
    ) {
        if (actor == null || !actor.IsAlive()) { return null; }
        ArpgBuffDefinition definition = this.project.FindBuff(buffId);
        if (definition == null) { return null; }
        ArpgBuffInstance instance =
            actor.ApplyBuff(definition, source, unique);
        if (instance != null) {
            actor.ClampVitals();
            this.gameplayEvents.RaiseBuffChanged(actor, instance, true);
        }
        return instance;
    }

    /// 移除角色身上全部指定 id 的增益，逐个触发
    /// BuffChanged(added=false)，移除后钳制生命值。删到了返回 true。
    bool RemoveBuff(ArpgActor actor, string buffId) {
        if (actor == null) { return false; }
        bool removed = false;
        int i = actor.BuffCount() - 1;
        while (i >= 0) {
            ArpgBuffInstance instance = actor.BuffInstanceAt(i);
            if (instance.Definition().Id() == buffId) {
                actor.RemoveBuffAt(i);
                this.gameplayEvents.RaiseBuffChanged(actor, instance, false);
                removed = true;
            }
            i = i - 1;
        }
        if (removed) { actor.ClampVitals(); }
        return removed;
    }

    /// <summary>
    /// 施放技能的完整结算入口：依次校验技能存在（UnknownSkill）、
    /// 已学会（NotLearned）、施法者存活且无攻击限制
    /// （CasterDead）、目标合法（InvalidTarget）、射程（OutOfRange）、
    /// 冷却（Cooldown，触发提示 1）、消耗（InsufficientResources）。
    /// 通过后掷命中/暴击、结算伤害、施加技能携带的 buff，返回
    /// 带结算结果的 ArpgSkillCastResult（含失败状态）并触发
    /// SkillResolved。
    /// </summary>
    ArpgSkillCastResult CastSkill(
        ArpgActor caster,
        string skillId,
        ArpgActor target
    ) {
        ArpgSkillDefinition skill = this.project.FindSkill(skillId);
        if (skill == null) {
            return this.ResolveCast(new ArpgSkillCastResult(
                ArpgSkillCastStatus.UnknownSkill(), caster, target, null));
        }
        if (caster == null || !caster.HasSkill(skillId)) {
            return this.ResolveCast(new ArpgSkillCastResult(
                ArpgSkillCastStatus.NotLearned(), caster, target, skill));
        }
        if (!caster.IsAlive() || this.HasAttackRestriction(caster)) {
            return this.ResolveCast(new ArpgSkillCastResult(
                ArpgSkillCastStatus.CasterDead(), caster, target, skill));
        }
        if (skill.TargetMode() == ArpgSkillTarget.Player()) {
            target = caster;
        }
        if (!ArpgCombat.IsValidTarget(
            caster, target, skill.TargetFaction())) {
            return this.ResolveCast(new ArpgSkillCastResult(
                ArpgSkillCastStatus.InvalidTarget(), caster, target, skill));
        }
        int distance = ArpgCombat.GridDistance(caster, target);
        if (distance < skill.MinimumRange()
            || distance > skill.AttackRange()) {
            return this.ResolveCast(new ArpgSkillCastResult(
                ArpgSkillCastStatus.OutOfRange(), caster, target, skill));
        }
        string cooldownName = "skill:" + skill.Id();
        if (!caster.Cooldowns().IsReady(cooldownName)) {
            this.systemEvents.RaiseSystemPrompt(1, "Skill is cooling down.");
            return this.ResolveCast(new ArpgSkillCastResult(
                ArpgSkillCastStatus.Cooldown(), caster, target, skill));
        }
        if (!caster.Spend(
            (double)skill.HpCost(), (double)skill.MpCost())) {
            return this.ResolveCast(new ArpgSkillCastResult(
                ArpgSkillCastStatus.InsufficientResources(),
                caster, target, skill));
        }

        caster.Cooldowns().Start(
            cooldownName, skill.CooldownMilliseconds());
        this.RemoveConditionalBuffs(caster, 2);
        bool hit = skill.AlwaysHit();
        if (!hit) {
            hit = this.random.NextPercent()
                <= ArpgCombat.HitChance(caster, target);
        }
        bool critical = false;
        double damage = 0.0;
        if (hit) {
            ArpgAttributes sourceAttributes = caster.EffectiveAttributes();
            critical = skill.AlwaysCritical();
            if (!critical) {
                int criticalChance = ArpgMath.Clamp(
                    (int)sourceAttributes.CriticalChance(), 0, 100);
                critical = this.random.NextPercent() <= criticalChance;
            }
            damage = ArpgCombat.Damage(
                caster, target, skill, critical);
            this.DamageActor(caster, target, damage, critical);
            for (int i = 0; i < skill.BuffEffectCount() && target.IsAlive(); i = i + 1) {
                this.ApplyBuff(
                    target, skill.BuffEffectAt(i), caster, false);
            }
        }
        ArpgSkillCastResult result = new ArpgSkillCastResult(
            ArpgSkillCastStatus.Success(), caster, target, skill);
        result.SetResolved(hit, critical, damage);
        return this.ResolveCast(result);
    }

    /// 触发 SkillResolved 事件并原样返回 result。
    ArpgSkillCastResult ResolveCast(ArpgSkillCastResult result) {
        this.gameplayEvents.RaiseSkillResolved(result);
        return result;
    }

    /// <summary>
    /// 对目标造成实际伤害（受目标自身减伤逻辑约束），返回实际
    /// 生效值。生效时触发 ActorDamaged 并移除 RemoveOnDamage 类
    /// buff；由存活转为死亡时移除 RemoveOnDeath 类 buff 并触发
    /// ActorDied。target 为 null 返回 0。
    /// </summary>
    double DamageActor(
        ArpgActor source,
        ArpgActor target,
        double amount,
        bool critical
    ) {
        if (target == null) { return 0.0; }
        bool wasAlive = target.IsAlive();
        double applied = target.TakeDamage(amount);
        if (applied > 0.0) {
            this.gameplayEvents.RaiseActorDamaged(
                source, target, applied, critical);
            this.RemoveConditionalBuffs(target, 3);
        }
        if (wasAlive && !target.IsAlive()) {
            this.RemoveConditionalBuffs(target, 4);
            this.gameplayEvents.RaiseActorDied(target, source);
        }
        return applied;
    }

    /// 按条件码移除条件类 buff：1=移动后 2=攻击后 3=受伤后
    /// 4=死亡后，逐个触发 BuffChanged，最后钳制生命值。
    void RemoveConditionalBuffs(ArpgActor actor, int condition) {
        int i = actor.BuffCount() - 1;
        while (i >= 0) {
            ArpgBuffInstance instance = actor.BuffInstanceAt(i);
            ArpgBuffDefinition definition = instance.Definition();
            bool remove = condition == 1 && definition.RemoveOnMove();
            if (condition == 2 && definition.RemoveOnAttack()) { remove = true; }
            if (condition == 3 && definition.RemoveOnDamage()) { remove = true; }
            if (condition == 4 && definition.RemoveOnDeath()) { remove = true; }
            if (remove) {
                actor.RemoveBuffAt(i);
                this.gameplayEvents.RaiseBuffChanged(actor, instance, false);
            }
            i = i - 1;
        }
        actor.ClampVitals();
    }

    /// <summary>
    /// 推进世界时间：递减全部角色冷却、推进 buff 计时并结算其
    /// 周期效果（负 HP 属性为持续伤害，正值为持续回复），过期
    /// buff 自动移除并触发 BuffChanged。deltaMilliseconds ≤ 0 时
    /// 不做任何事。
    /// </summary>
    void Update(int deltaMilliseconds) {
        if (deltaMilliseconds <= 0) { return; }
        for (int actorIndex = 0; actorIndex < this.actors.Count; actorIndex = actorIndex + 1) {
            ArpgActor actor = this.actors[actorIndex];
            actor.Cooldowns().Tick(deltaMilliseconds);
            int buffIndex = actor.BuffCount() - 1;
            while (buffIndex >= 0) {
                ArpgBuffInstance instance =
                    actor.BuffInstanceAt(buffIndex);
                int triggerCount = instance.Tick(deltaMilliseconds);
                while (triggerCount > 0 && actor.IsAlive()) {
                    ArpgAttributes attributes =
                        instance.Definition().Attributes();
                    if (attributes.Hp() < 0.0) {
                        this.DamageActor(
                            instance.Source(),
                            actor,
                            -attributes.Hp(),
                            false);
                    } else {
                        actor.Heal(attributes.Hp(), attributes.Mp());
                    }
                    triggerCount = triggerCount - 1;
                }
                if (buffIndex < actor.BuffCount()
                    && actor.BuffInstanceAt(buffIndex) == instance
                    && instance.IsExpired()) {
                    actor.RemoveBuffAt(buffIndex);
                    actor.ClampVitals();
                    this.gameplayEvents.RaiseBuffChanged(
                        actor, instance, false);
                }
                buffIndex = buffIndex - 1;
            }
        }
    }

    /// <summary>
    /// 若玩家站在当前地图的传送门格子上，切换到目标地图：保留
    /// 玩家实例、按传送门重设出生坐标与朝向。仅对玩家本人生效，
    /// 不在传送门上或目标地图加载失败返回 false。
    /// </summary>
    bool TryUsePortal(ArpgActor actor) {
        if (actor == null || actor != this.player || this.currentMap == null) {
            return false;
        }
        for (int i = 0; i < this.currentMap.PortalCount(); i = i + 1) {
            ArpgMapPortal portal = this.currentMap.PortalAt(i);
            if (portal.GridX() == actor.GridX()
                && portal.GridY() == actor.GridY()) {
                ArpgActor preservedPlayer = this.player;
                if (!this.LoadMap(
                    portal.TargetMapId(), preservedPlayer, portal.Id())) {
                    return false;
                }
                preservedPlayer.SetGridPosition(
                    portal.TargetGridX(), portal.TargetGridY());
                preservedPlayer.SetDirection(portal.TargetDirection());
                return true;
            }
        }
        return false;
    }
}
