using System;
using System.Collections.Generic;

namespace Game.Arpg;

/// <summary>
/// 应用菜单中的单个菜单项：名称（唯一键）、标题、自定义载荷与
/// 可见/启用/选中三个状态位。构造时默认可见且启用、未选中；
/// Set* 修饰器均返回 this，可链式配置。项被激活时 Payload 随
/// ArpgEvents 的 MenuChanged 回调上抛。
/// </summary>
class ArpgMenuItem {
    string name;
    string title;
    string payload;
    bool visible;
    bool enabled;
    bool marked;

    /// 构造菜单项；visible/enabled 默认 true，marked 默认 false。
    ArpgMenuItem(string name, string title, string payload) {
        this.name = name;
        this.title = title;
        this.payload = payload;
        this.visible = true;
        this.enabled = true;
        this.marked = false;
    }

    /// 菜单项名（同一菜单内的唯一键）。
    string Name() { return this.name; }
    /// 显示标题。
    string Title() { return this.title; }
    /// 激活时随菜单事件上抛的自定义载荷。
    string Payload() { return this.payload; }
    /// 是否可见（不可见项不会被分派激活）。
    bool Visible() { return this.visible; }
    /// 是否启用（禁用项不会被分派激活）。
    bool Enabled() { return this.enabled; }
    /// 是否带选中标记。
    bool Marked() { return this.marked; }
    /// 设置标题并返回 this（链式）。
    ArpgMenuItem SetTitle(string title) {
        this.title = title;
        return this;
    }
    /// 设置载荷并返回 this（链式）。
    ArpgMenuItem SetPayload(string payload) {
        this.payload = payload;
        return this;
    }
    /// 设置可见性并返回 this（链式）。
    ArpgMenuItem SetVisible(bool visible) {
        this.visible = visible;
        return this;
    }
    /// 设置启用状态并返回 this（链式）。
    ArpgMenuItem SetEnabled(bool enabled) {
        this.enabled = enabled;
        return this;
    }
    /// 设置选中标记并返回 this（链式）。
    ArpgMenuItem SetMarked(bool marked) {
        this.marked = marked;
        return this;
    }
}

/// <summary>
/// 类型化菜单：菜单名 + 按序排列的菜单项集合。AddItem 按项名
/// upsert（同名覆盖），渲染适配器可消费同一菜单状态。
/// </summary>
class ArpgMenu {
    string name;
    List<ArpgMenuItem> items;

    /// 构造空菜单。
    ArpgMenu(string name) {
        this.name = name;
        this.items = new List<ArpgMenuItem>();
    }

    /// 菜单名（同一运行时内的唯一键）。
    string Name() { return this.name; }
    /// 追加或按名称覆盖菜单项（item 为 null 忽略），返回 this。
    ArpgMenu AddItem(ArpgMenuItem item) {
        if (item == null) { return this; }
        int index = this.IndexOf(item.Name());
        if (index < 0) { this.items.Add(item); }
        else { this.items[index] = item; }
        return this;
    }
    /// 按项名查找索引；未找到返回 -1。
    int IndexOf(string itemName) {
        for (int i = 0; i < this.items.Count; i = i + 1) {
            if (this.items[i].Name() == itemName) { return i; }
        }
        return -1;
    }
    /// 按项名查找菜单项；未找到返回 null。
    ArpgMenuItem FindItem(string itemName) {
        int index = this.IndexOf(itemName);
        if (index < 0) { return null; }
        return this.items[index];
    }
    /// 菜单项数量。
    int ItemCount() { return this.items.Count; }
    /// 第 index 个菜单项（不查越界）。
    ArpgMenuItem ItemAt(int index) { return this.items[index]; }

    /// 释放菜单项集合（之后不应再使用本菜单）。
    void Dispose() {
        this.items.Clear();
        this.items = null;
        this.name = null;
    }
}

// 菜单运行时只分派有效、可见且启用的项。渲染
// 适配器可消费同一菜单状态并订阅 ArpgEvents。
/// <summary>
/// 菜单运行时：管理命名菜单集合并分派激活。只分派可见且启用
/// 的项，激活成功经 ArpgEvents.RaiseMenuChanged 上抛（菜单名/
/// 项名/载荷）。渲染适配器可消费同一菜单状态并订阅 ArpgEvents。
/// </summary>
class ArpgMenuRuntime {
    List<ArpgMenu> menus;
    ArpgEvents events;

    /// 构造运行时；events 可为 null（激活时不上抛事件）。
    ArpgMenuRuntime(ArpgEvents events) {
        this.menus = new List<ArpgMenu>();
        this.events = events;
    }

    /// 按菜单名查找索引；未找到返回 -1。
    int IndexOf(string name) {
        for (int i = 0; i < this.menus.Count; i = i + 1) {
            if (this.menus[i].Name() == name) { return i; }
        }
        return -1;
    }
    /// 追加或按名称覆盖菜单（menu 为 null 忽略），返回 this。
    ArpgMenuRuntime AddMenu(ArpgMenu menu) {
        if (menu == null) { return this; }
        int index = this.IndexOf(menu.Name());
        if (index < 0) { this.menus.Add(menu); }
        else { this.menus[index] = menu; }
        return this;
    }
    /// 按菜单名查找菜单；未找到返回 null。
    ArpgMenu FindMenu(string name) {
        int index = this.IndexOf(name);
        if (index < 0) { return null; }
        return this.menus[index];
    }
    /// 菜单数量。
    int MenuCount() { return this.menus.Count; }
    /// 第 index 个菜单（不查越界）。
    ArpgMenu MenuAt(int index) { return this.menus[index]; }

    /// <summary>
    /// 激活指定菜单的指定项：菜单或项不存在、项不可见或禁用时
    /// 返回 false（不上抛事件）；成功时经 RaiseMenuChanged 上抛
    /// （菜单名/项名/载荷）并返回 true。
    /// </summary>
    bool Activate(string menuName, string itemName) {
        ArpgMenu menu = this.FindMenu(menuName);
        if (menu == null) { return false; }
        ArpgMenuItem item = menu.FindItem(itemName);
        if (item == null || !item.Visible() || !item.Enabled()) {
            return false;
        }
        if (this.events != null) {
            this.events.RaiseMenuChanged(
                menuName, itemName, item.Payload());
        }
        return true;
    }

    /// 释放全部菜单并断开事件引用（之后不应再使用本运行时）。
    void Dispose() {
        for (int i = 0; i < this.menus.Count; i = i + 1) {
            this.menus[i].Dispose();
        }
        this.menus.Clear();
        this.menus = null;
        this.events = null;
    }
}
