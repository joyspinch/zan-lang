using System;

namespace Game.Arpg.Data;

// 渲染器无关的存档快照。应用可用自己偏好的 JSON、数据库
// 或二进制层序列化此对象。
class ArpgSaveState {
    string mapName;
    int heroX;
    int heroY;
    int heroDirection;
    int heroLevel;
    int heroHp;
    int heroMp;
    int heroExperience;
    int heroRage;
    List<ArpgSaveItem> items;
    List<ArpgSaveEquipment> equipment;
    List<ArpgSaveSkill> skills;
    List<ArpgSaveBuff> buffs;

    ArpgSaveState(
        string mapName,
        int heroX,
        int heroY,
        int heroDirection,
        int heroLevel,
        int heroHp,
        int heroMp
    ) {
        this.mapName = mapName;
        this.heroX = heroX;
        this.heroY = heroY;
        this.heroDirection = heroDirection;
        this.heroLevel = heroLevel;
        this.heroHp = heroHp;
        this.heroMp = heroMp;
        this.heroExperience = 0;
        this.heroRage = 0;
        this.items = new List<ArpgSaveItem>();
        this.equipment = new List<ArpgSaveEquipment>();
        this.skills = new List<ArpgSaveSkill>();
        this.buffs = new List<ArpgSaveBuff>();
    }

    // 以下修改器均返回 this，便于链式构建一个快照：
    //   new ArpgSaveState(...).SetProgress(...).AddItem(...).AddSkill(...)
    ArpgSaveState SetProgress(int experience, int rage) {
        this.heroExperience = experience;
        this.heroRage = rage;
        return this;
    }
    ArpgSaveState AddItem(string name, int quantity) {
        if (name != "" && quantity > 0) {
            this.items.Add(new ArpgSaveItem(name, quantity));
        }
        return this;
    }
    ArpgSaveState AddEquipment(string slot, string itemName) {
        if (slot != "" && itemName != "") {
            this.equipment.Add(new ArpgSaveEquipment(slot, itemName));
        }
        return this;
    }
    ArpgSaveState AddSkill(string name) {
        if (name != "") { this.skills.Add(new ArpgSaveSkill(name)); }
        return this;
    }
    ArpgSaveState AddBuff(string name, int remaining) {
        if (name != "") { this.buffs.Add(new ArpgSaveBuff(name, remaining)); }
        return this;
    }

    string MapName() { return this.mapName; }
    int HeroX() { return this.heroX; }
    int HeroY() { return this.heroY; }
    int HeroDirection() { return this.heroDirection; }
    int HeroLevel() { return this.heroLevel; }
    int HeroHp() { return this.heroHp; }
    int HeroMp() { return this.heroMp; }
    int HeroExperience() { return this.heroExperience; }
    int HeroRage() { return this.heroRage; }
    int ItemCount() { return this.items.Count; }
    ArpgSaveItem ItemAt(int index) { return this.items[index]; }
    int EquipmentCount() { return this.equipment.Count; }
    ArpgSaveEquipment EquipmentAt(int index) { return this.equipment[index]; }
    int SkillCount() { return this.skills.Count; }
    ArpgSaveSkill SkillAt(int index) { return this.skills[index]; }
    int BuffCount() { return this.buffs.Count; }
    ArpgSaveBuff BuffAt(int index) { return this.buffs[index]; }

    void Dispose() {
        this.items = null;
        this.equipment = null;
        this.skills = null;
        this.buffs = null;
    }
}

class ArpgSaveItem {
    string name;
    int quantity;

    ArpgSaveItem(string name, int quantity) {
        this.name = name;
        this.quantity = quantity;
    }
    string Name() { return this.name; }
    int Quantity() { return this.quantity; }
}

class ArpgSaveEquipment {
    string slot;
    string itemName;

    ArpgSaveEquipment(string slot, string itemName) {
        this.slot = slot;
        this.itemName = itemName;
    }
    string Slot() { return this.slot; }
    string ItemName() { return this.itemName; }
}

class ArpgSaveSkill {
    string name;

    ArpgSaveSkill(string name) {
        this.name = name;
    }
    string Name() { return this.name; }
}

class ArpgSaveBuff {
    string name;
    int remaining;

    ArpgSaveBuff(string name, int remaining) {
        this.name = name;
        this.remaining = remaining;
    }
    string Name() { return this.name; }
    int Remaining() { return this.remaining; }
}
