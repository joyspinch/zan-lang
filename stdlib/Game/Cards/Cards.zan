using System;
using Game.Foundation;

namespace Game.Cards;

/// <summary>
/// 卡牌效果类型常量：以静态方法返回整数标识，供效果构建与
/// 战斗结算时比较。取值互不相同。
/// </summary>
class CardEffectKind {
    /// 伤害效果标识。
    static int Damage() { return 1; }
    /// 格挡效果标识。
    static int Block() { return 2; }
    /// 治疗效果标识。
    static int Heal() { return 3; }
    /// 抽牌效果标识。
    static int Draw() { return 4; }
    /// 能量增减效果标识。
    static int Energy() { return 5; }
    /// 力量增减效果标识。
    static int Strength() { return 6; }
    /// 易伤效果标识。
    static int Vulnerable() { return 7; }
}

/// <summary>
/// 卡牌效果目标常量：Self 作用于出牌者自身，Enemy 作用于对手。
/// </summary>
class CardTarget {
    /// 目标为自身。
    static int Self() { return 1; }
    /// 目标为敌人。
    static int Enemy() { return 2; }
}

/// <summary>
/// 单条卡牌效果：由类型（kind）、数值（amount）与目标
/// （target）组成的最小效果单元，一张卡可含多条。
/// </summary>
class CardEffect {
    int kind;
    int amount;
    int target;

    /// 构造效果：kind 取 CardEffectKind 常量，target 取 CardTarget 常量，amount 为该效果的数值量（伤害/治疗/格挡/抽牌数/能量/回合数）。
    static CardEffect Of(int kind, int amount, int target) {
        CardEffect effect = new CardEffect();
        effect.kind = kind;
        effect.amount = amount;
        effect.target = target;
        return effect;
    }

    /// 效果类型标识（CardEffectKind 常量之一）。
    int Kind() { return this.kind; }
    /// 效果数值量。
    int Amount() { return this.amount; }
    /// 效果目标（CardTarget 常量之一）。
    int Target() { return this.target; }
}

/// <summary>
/// 卡牌定义（模板）：不可变的基础属性 id/名称/费用/分类，
/// 外加可链式追加的效果列表与可选美术资源。同一定义可实例化
/// 出多张卡。
/// </summary>
class CardDefinition {
    string id;
    string name;
    int cost;
    string category;
    string art;
    List<CardEffect> effects;

    /// 构造卡牌定义：id 为唯一标识，name 为显示名，cost 为打出费用（能量），category 为分类标签；效果列表初始为空，art 为空字符串。
    CardDefinition(
        string id,
        string name,
        int cost,
        string category
    ) {
        this.id = id;
        this.name = name;
        this.cost = cost;
        this.category = category;
        this.art = "";
        this.effects = new List<CardEffect>();
    }

    /// 追加一条效果并返回自身，支持链式调用；kind/target 取常量类值。
    CardDefinition AddEffect(int kind, int amount, int target) {
        this.effects.Add(CardEffect.Of(kind, amount, target));
        return this;
    }

    /// 设置美术资源标识并返回自身，支持链式调用；传空字符串表示无美术。
    CardDefinition SetArt(string resource) {
        this.art = resource;
        return this;
    }

    /// 唯一标识符（构造时传入，不变）。
    string Id() { return this.id; }
    /// 显示名称。
    string Name() { return this.name; }
    /// 打出费用（能量单位）。
    int Cost() { return this.cost; }
    /// 分类标签字符串。
    string Category() { return this.category; }
    /// 美术资源标识，未设置时为空字符串。
    string Art() { return this.art; }
    /// 效果条数。
    int EffectCount() { return this.effects.Count; }
    /// 取第 index 条效果；索引越界行为由 List 决定（调用方应保证 0 <= index < EffectCount）。
    CardEffect EffectAt(int index) { return this.effects[index]; }
}

/// <summary>
/// 卡牌目录：按 id 唯一收纳 CardDefinition 的注册表。重复
/// Add 同 id 的定义会覆盖旧定义。
/// </summary>
class CardCatalog {
    List<CardDefinition> cards;

    /// 构造空目录。
    CardCatalog() {
        this.cards = new List<CardDefinition>();
    }

    /// 添加或覆盖卡牌定义：id 已存在时替换旧定义，否则追加；返回自身支持链式调用。
    CardCatalog Add(CardDefinition card) {
        int index = this.IndexOf(card.Id());
        if (index >= 0) {
            this.cards[index] = card;
        } else {
            this.cards.Add(card);
        }
        return this;
    }

    /// 按 id 查找定义的索引：找到返回其下标，未找到返回 -1。
    int IndexOf(string id) {
        for (int i = 0; i < this.cards.Count; i = i + 1) {
            if (this.cards[i].Id() == id) { return i; }
        }
        return -1;
    }

    /// 按 id 查找定义：未找到返回 null。
    CardDefinition Find(string id) {
        int index = this.IndexOf(id);
        if (index < 0) { return null; }
        return this.cards[index];
    }

    /// 目录中的定义总数。
    int Count() { return this.cards.Count; }
    /// 取第 index 个定义；索引越界行为由 List 决定（调用方应保证 0 <= index < Count）。
    CardDefinition At(int index) { return this.cards[index]; }
}

/// <summary>
/// 卡牌实例：一次具体掉落/获得的卡，引用共享的 CardDefinition
/// 并携带独立状态（实例 id、升级等级、保留标记）。instanceId
/// 全局递增且不复用。
/// </summary>
class CardInstance {
    int instanceId;
    CardDefinition definition;
    int upgrade;
    bool retained;

    /// 构造实例：instanceId 由牌堆分配（从 1 递增），definition 为共享模板；升级等级 0、保留标记 false。
    CardInstance(int instanceId, CardDefinition definition) {
        this.instanceId = instanceId;
        this.definition = definition;
        this.upgrade = 0;
        this.retained = false;
    }

    /// 实例唯一 id（牌堆内递增分配，不复用）。
    int InstanceId() { return this.instanceId; }
    /// 共享的卡牌定义模板。
    CardDefinition Definition() { return this.definition; }
    /// 升级等级，0 表示未升级。
    int Upgrade() { return this.upgrade; }
    /// 保留标记：为 true 时回合结束弃牌阶段不弃此牌。
    bool Retained() { return this.retained; }
    /// 设置升级等级（无钳制）。
    void SetUpgrade(int upgrade) { this.upgrade = upgrade; }
    /// 设置保留标记。
    void SetRetained(bool retained) { this.retained = retained; }
}

/// <summary>
/// 卡牌区域（牌堆槽位）：有名字的有序卡牌集合，可作抽牌堆、
/// 手牌、弃牌堆或消耗堆使用。null 卡不会被加入。
/// </summary>
class CardZone {
    string name;
    List<CardInstance> cards;

    /// 构造区域：name 为区域显示名（如 "draw"/"hand"），初始为空。
    CardZone(string name) {
        this.name = name;
        this.cards = new List<CardInstance>();
    }

    /// 将卡追加到区域末尾：null 卡被忽略。
    void Add(CardInstance card) {
        if (card != null) { this.cards.Add(card); }
    }

    /// 移除并返回指定索引的卡：索引越界返回 null 且不改动区域。
    CardInstance TakeAt(int index) {
        if (index < 0 || index >= this.cards.Count) { return null; }
        CardInstance card = this.cards[index];
        this.cards.RemoveAt(index);
        return card;
    }

    /// 移除并返回最后一张卡：区域为空时返回 null。
    CardInstance TakeLast() {
        return this.TakeAt(this.cards.Count - 1);
    }

    /// 按实例 id 查找卡在区域中的索引：找到返回下标，未找到返回 -1。
    int IndexOfInstance(int instanceId) {
        for (int i = 0; i < this.cards.Count; i = i + 1) {
            if (this.cards[i].InstanceId() == instanceId) { return i; }
        }
        return -1;
    }

    /// 原地洗牌（Fisher-Yates）：使用确定性随机源保证同种子同序列；random 为 null 时不洗牌。
    void Shuffle(DeterministicRandom random) {
        if (random == null) { return; }
        int i = this.cards.Count - 1;
        while (i > 0) {
            int j = random.NextBelow(i + 1);
            CardInstance swap = this.cards[i];
            this.cards[i] = this.cards[j];
            this.cards[j] = swap;
            i = i - 1;
        }
    }

    /// 区域名称（构造时传入，不变）。
    string Name() { return this.name; }
    /// 区域内卡牌数。
    int Count() { return this.cards.Count; }
    /// 查看第 index 张卡（不移除）；索引越界行为由 List 决定（调用方应保证 0 <= index < Count）。
    CardInstance At(int index) { return this.cards[index]; }
    /// 清空区域内全部卡牌。
    void Clear() { this.cards.Clear(); }
}

/// <summary>
/// 三区牌堆运行时：管理抽牌堆、手牌、弃牌堆与消耗堆，抽空
/// 自动回收弃牌堆洗入抽牌堆。实例 id 从 1 递增分配；随机源
/// 由种子确定，可复现。
/// </summary>
class CardDeck {
    CardZone draw;
    CardZone hand;
    CardZone discard;
    CardZone exhaust;
    DeterministicRandom random;
    int nextInstanceId;

    /// 构造牌堆：seed 为随机源种子（同种子产生相同抽牌序列）；四个区域初始为空，下一个实例 id 为 1。
    CardDeck(int seed) {
        this.draw = new CardZone("draw");
        this.hand = new CardZone("hand");
        this.discard = new CardZone("discard");
        this.exhaust = new CardZone("exhaust");
        this.random = new DeterministicRandom(seed);
        this.nextInstanceId = 1;
    }

    /// 向抽牌堆添加一张卡并返回其实例：definition 为 null 返回 null 不产生实例；实例 id 自动递增分配。
    CardInstance Add(CardDefinition definition) {
        if (definition == null) { return null; }
        CardInstance card =
            new CardInstance(this.nextInstanceId, definition);
        this.nextInstanceId = this.nextInstanceId + 1;
        this.draw.Add(card);
        return card;
    }

    /// 洗牌抽牌堆：使用牌堆自带的确定性随机源；在抽牌前调用一次以保证可复现。
    void ShuffleDraw() { this.draw.Shuffle(this.random); }

    /// 回收弃牌堆：把弃牌堆全部卡移回抽牌堆并重新洗牌。
    void RecycleDiscard() {
        while (this.discard.Count() > 0) {
            this.draw.Add(this.discard.TakeLast());
        }
        this.ShuffleDraw();
    }

    /// 抽一张牌到手牌：抽牌堆为空时先回收弃牌堆；仍无牌可抽返回 null（不消耗堆中其他状态）。
    CardInstance DrawOne() {
        if (this.draw.Count() == 0) { this.RecycleDiscard(); }
        if (this.draw.Count() == 0) { return null; }
        CardInstance card = this.draw.TakeLast();
        this.hand.Add(card);
        return card;
    }

    /// 连续抽牌：在牌源耗尽时提前停止；返回实际抽到的张数（可小于 amount，包括 0；负数按 0 张处理）。
    int Draw(int amount) {
        int drawn = 0;
        for (int i = 0; i < amount; i = i + 1) {
            if (this.DrawOne() == null) { return drawn; }
            drawn = drawn + 1;
        }
        return drawn;
    }

    /// 弃掉手牌指定索引的牌：成功返回该卡并移入弃牌堆；索引越界返回 null。
    CardInstance DiscardFromHand(int index) {
        CardInstance card = this.hand.TakeAt(index);
        if (card != null) { this.discard.Add(card); }
        return card;
    }

    /// 消耗掉手牌指定索引的牌：成功返回该卡并移入消耗堆（本局不再循环）；索引越界返回 null。
    CardInstance ExhaustFromHand(int index) {
        CardInstance card = this.hand.TakeAt(index);
        if (card != null) { this.exhaust.Add(card); }
        return card;
    }

    /// 弃掉整手牌：Retained 为 true 的保留卡留在手中，其余按顺序移入弃牌堆。
    void DiscardHand() {
        int i = this.hand.Count() - 1;
        while (i >= 0) {
            CardInstance card = this.hand.At(i);
            if (!card.Retained()) {
                this.discard.Add(this.hand.TakeAt(i));
            }
            i = i - 1;
        }
    }

    /// 抽牌堆（直接访问可查看/清点，勿绕过 Draw 增删以免破坏流程）。
    CardZone DrawPile() { return this.draw; }
    /// 手牌区域。
    CardZone Hand() { return this.hand; }
    /// 弃牌堆。
    CardZone DiscardPile() { return this.discard; }
    /// 消耗堆（被消耗的卡本局不再进入循环）。
    CardZone ExhaustPile() { return this.exhaust; }
    /// 随机源当前状态，可用于存档/恢复随机序列。
    int RandomState() { return this.random.State(); }
}
