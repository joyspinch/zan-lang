using System;
using SDL3;

namespace Game.Core;

/// <summary>
/// Game.* 引擎的类型无关应用宿主：持有 SDL3 窗口和
/// 一个 <see cref="SdlGpu"/> 渲染器，泵送事件队列并驱动简单的
/// 帧循环。更上层的框架（Game.Arpg、Game.Zgm）构建于其上。
/// </summary>
class App {
    SdlWindow window;
    SdlGpu gpu;
    int width;
    int height;
    bool running;

    /// <summary>初始化 SDL，打开可调整大小的窗口和 GPU 上下文。</summary>
    App(string title, int width, int height) {
        this.width = width;
        this.height = height;
        this.running = false;
        if (!Sdl.Init(SdlInit.Video() + SdlInit.Events())) { return; }
        int flags = SdlWindowFlags.Resizable() + SdlWindowFlags.HighPixelDensity();
        this.window = SdlWindow.Create(title, width, height, flags);
        if (!this.window.IsValid()) { Sdl.Quit(); return; }
        this.gpu = SdlGpu.Create(this.window);
        if (!this.gpu.IsValid()) { this.window.Close(); Sdl.Quit(); return; }
        this.running = true;
    }

    /// 是否初始化成功（GPU 上下文有效）；失败时不应进入主循环。
    bool IsValid() {
        if (this.gpu == null) { return false; }
        return this.gpu.IsValid();
    }

    /// 渲染器实例；初始化失败时为 null。
    SdlGpu Gpu() { return this.gpu; }
    /// 应用窗口；初始化失败时为 null。
    SdlWindow Window() { return this.window; }
    /// 创建时请求的窗口宽度（实际窗口可被用户调整大小）。
    int Width() { return this.width; }
    /// 创建时请求的窗口高度。
    int Height() { return this.height; }
    /// 主循环是否应继续；收到退出事件或调用 Stop 后为 false。
    bool IsRunning() { return this.running; }
    /// 请求退出主循环（不销毁资源；彻底清理请再调用 Shutdown）。
    void Stop() { this.running = false; }

    /// <summary>排空待处理事件；收到退出事件时请求关闭。</summary>
    void Pump() {
        while (SdlEvent.Poll()) {
            if (SdlEvent.IsQuit()) { this.running = false; }
        }
    }

    /// 自 SDL 计数器起的毫秒数（用于帧计时）。
    int Ticks() { return Sdl.Ticks(); }
    /// 休眠指定毫秒（用于限帧）。
    void Delay(int milliseconds) { Sdl.Delay(milliseconds); }

    /// 停止主循环并销毁 GPU、窗口，退出 SDL；
    /// 在循环正常退出后调用一次即可，不可重复使用本实例。
    void Shutdown() {
        this.running = false;
        if (this.gpu != null) { this.gpu.Destroy(); }
        if (this.window != null) { this.window.Close(); }
        Sdl.Quit();
    }
}
