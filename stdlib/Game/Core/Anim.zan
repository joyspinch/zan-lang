using System;
using System.IO;
using System.Json;

namespace Game.Core;

/// <summary>基于方向优先帧表的单个动画片段（
/// Mir 式布局：先是方向 0 的全部帧，再是方向 1，……）。
/// 由 IDE 资源管理器写入的 `.anim` 旁置 JSON 加载。</summary>
class AnimClip {
    string image;      // 帧表图片条目/路径
    int frameW;        // 帧单元尺寸（0 = 未知，从帧表推导）
    int frameH;
    int baseFrame;          // 多动作帧表中该动作的首帧
    int dirs;          // 方向数量（经典 Mir 移动为 8）
    int framesPerDir;  // 每个方向所属的帧数
    int fps;
    int loopMode;      // 0 播放一次，1 循环，2 循环片段
    int loopStart;     // 循环片段（模式 2）的首帧

    AnimClip(int dirs, int framesPerDir, int fps, int loopMode, int loopStart) {
        this.image = "";
        this.frameW = 0;
        this.frameH = 0;
        this.baseFrame = 0;
        this.dirs = dirs;
        this.framesPerDir = framesPerDir;
        this.fps = fps;
        this.loopMode = loopMode;
        this.loopStart = loopStart;
        if (this.dirs < 1) { this.dirs = 1; }
        if (this.framesPerDir < 1) { this.framesPerDir = 1; }
        if (this.fps < 1) { this.fps = 1; }
        if (this.loopStart < 0) { this.loopStart = 0; }
        if (this.loopStart >= this.framesPerDir) { this.loopStart = this.framesPerDir - 1; }
    }

    /// <summary>解析 `.anim` JSON 文档；不是该格式则返回 null。</summary>
    static AnimClip ParseJson(string json) {
        JsonValue v = JsonValue.ParseLenient(json);
        if (v == null || !v.IsObject()) { return null; }
        int lm = 1;
        string loop = v.Str("loop", "loop");
        if (loop == "once") { lm = 0; }
        if (loop == "section") { lm = 2; }
        AnimClip c = new AnimClip(
            v.Int("dirs", 8), v.Int("framesPerDir", 1),
            v.Int("fps", 12), lm, v.Int("loopStart", 0));
        c.image = v.Str("image", "");
        c.frameW = v.Int("frameW", 0);
        c.frameH = v.Int("frameH", 0);
        c.baseFrame = v.Int("base", 0);
        return c;
    }

    /// <summary>从磁盘上的 `.anim` 文件加载片段（失败返回 null）。</summary>
    static AnimClip Load(string path) {
        if (!File.Exists(path)) { return null; }
        return AnimClip.ParseJson(File.ReadAllText(path));
    }

    /// 帧表图片条目/路径（`.anim` 的 image 字段，默认空串）。
    string Image() { return this.image; }
    /// 多动作帧表中该动作的首帧（`.anim` 的 base 字段）。
    int Base() { return this.baseFrame; }
    /// 帧单元宽（0 = 未知，从帧表推导）。
    int FrameW() { return this.frameW; }
    /// 帧单元高（0 = 未知，从帧表推导）。
    int FrameH() { return this.frameH; }
    /// 方向数量（构造时小于 1 钳制为 1；经典 Mir 移动为 8）。
    int Dirs() { return this.dirs; }
    /// 每个方向的帧数（构造时小于 1 钳制为 1）。
    int FramesPerDir() { return this.framesPerDir; }
    /// 播放帧率（FPS，构造时小于 1 钳制为 1）。
    int Fps() { return this.fps; }
    /// 循环模式：0 播放一次，1 循环，2 循环片段。
    int LoopMode() { return this.loopMode; }
    /// 循环片段（模式 2）的首帧（钳制在 [0, framesPerDir-1]）。
    int LoopStart() { return this.loopStart; }
}

/// <summary>播放 AnimClip：按流逝毫秒推进，可随时切换
/// 朝向（帧位置保持不变，与经典 Mir 渲染器一致），
/// 并读回帧表中要绘制的绝对帧。
/// 循环模式：once（停在最后一帧，Done() 变为 true）、loop（回到
/// 0）、section（先播放 0..loopStart-1 的前奏一次，再循环
/// loopStart..末尾——例如施法前摇后接持续施法）。</summary>
class AnimPlayer {
    AnimClip clip;
    int dir;        // 当前朝向（0..dirs-1）
    int frame;      // 当前方向内的帧（0..framesPerDir-1）
    int accMs;      // 累计到下一帧步进的时间
    bool done;      // once 片段已到达并停在最后一帧

    AnimPlayer() {
        this.clip = null;
        this.dir = 0;
        this.frame = 0;
        this.accMs = 0;
        this.done = false;
    }

    /// <summary>从第 0 帧开始（或重新开始）播放片段，保持当前朝向。</summary>
    void Play(AnimClip c) {
        this.clip = c;
        this.frame = 0;
        this.accMs = 0;
        this.done = false;
    }

    /// <summary>切换朝向；片段内帧位置保持不变，
    /// 转身的角色不会重新开始步伐。</summary>
    void SetDir(int d) {
        if (this.clip == null) { this.dir = d; return; }
        int n = this.clip.Dirs();
        int v = d % n;
        if (v < 0) { v = v + n; }
        this.dir = v;
    }

    /// 当前朝向（0..dirs-1，SetDir 已归一化）。
    int Dir() { return this.dir; }
    /// once 模式片段是否已停在最后一帧；循环片段恒为 false。
    bool Done() { return this.done; }
    /// 当前方向内的帧索引（0..framesPerDir-1）。
    int Frame() { return this.frame; }

    /// <summary>按流逝毫秒推进。</summary>
    void Update(int dtMs) {
        if (this.clip == null || this.done) { return; }
        if (dtMs < 0) { return; }
        this.accMs = this.accMs + dtMs;
        int stepMs = 1000 / this.clip.Fps();
        if (stepMs < 1) { stepMs = 1; }
        while (this.accMs >= stepMs) {
            this.accMs = this.accMs - stepMs;
            this.frame = this.frame + 1;
            if (this.frame >= this.clip.FramesPerDir()) {
                int lm = this.clip.LoopMode();
                if (lm == 0) {
                    this.frame = this.clip.FramesPerDir() - 1;
                    this.done = true;
                    return;
                }
                if (lm == 2) { this.frame = this.clip.LoopStart(); }
                else { this.frame = 0; }
            }
        }
    }

    /// <summary>当前朝向与位置在帧表中的绝对帧索引
    /// ：base + dir * framesPerDir + frame。</summary>
    int SheetFrame() {
        if (this.clip == null) { return 0; }
        return this.clip.Base() + this.dir * this.clip.FramesPerDir() + this.frame;
    }
}
