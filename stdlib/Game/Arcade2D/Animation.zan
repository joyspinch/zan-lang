using System;

namespace Game.Arcade2D;

class AnimationFrame {
    int x;
    int y;
    int width;
    int height;
    int duration;

    AnimationFrame(int x, int y, int width, int height, int duration) {
        this.x = x;
        this.y = y;
        this.width = width;
        this.height = height;
        this.duration = duration;
        if (this.duration <= 0) { this.duration = 1; }
    }

    int X() { return this.x; }
    int Y() { return this.y; }
    int Width() { return this.width; }
    int Height() { return this.height; }
    int Duration() { return this.duration; }
}

class AnimationClip {
    string name;
    bool loop;
    List<AnimationFrame> frames;

    AnimationClip(string name, bool loop) {
        this.name = name;
        this.loop = loop;
        this.frames = new List<AnimationFrame>();
    }

    AnimationClip Add(
        int x,
        int y,
        int width,
        int height,
        int duration
    ) {
        this.frames.Add(
            new AnimationFrame(x, y, width, height, duration));
        return this;
    }

    string Name() { return this.name; }
    bool Loop() { return this.loop; }
    int FrameCount() { return this.frames.Count; }
    AnimationFrame FrameAt(int index) { return this.frames[index]; }
}

class AnimationPlayer {
    AnimationClip clip;
    int frameIndex;
    int elapsed;
    bool playing;
    bool finished;

    AnimationPlayer(AnimationClip clip) {
        this.Play(clip);
    }

    void Play(AnimationClip clip) {
        this.clip = clip;
        this.frameIndex = 0;
        this.elapsed = 0;
        this.playing = clip != null && clip.FrameCount() > 0;
        this.finished = false;
    }

    void Update(int deltaMilliseconds) {
        if (!this.playing || this.clip == null || deltaMilliseconds <= 0) {
            return;
        }
        this.elapsed = this.elapsed + deltaMilliseconds;
        AnimationFrame frame = this.Current();
        while (this.playing && frame != null
            && this.elapsed >= frame.Duration()) {
            this.elapsed = this.elapsed - frame.Duration();
            this.frameIndex = this.frameIndex + 1;
            if (this.frameIndex >= this.clip.FrameCount()) {
                if (this.clip.Loop()) {
                    this.frameIndex = 0;
                } else {
                    this.frameIndex = this.clip.FrameCount() - 1;
                    this.playing = false;
                    this.finished = true;
                }
            }
            frame = this.Current();
        }
    }

    AnimationFrame Current() {
        if (this.clip == null || this.clip.FrameCount() == 0) { return null; }
        return this.clip.FrameAt(this.frameIndex);
    }

    int FrameIndex() { return this.frameIndex; }
    bool Playing() { return this.playing; }
    bool Finished() { return this.finished; }
}
