using System;

namespace Game.Arcade2D;

/// <summary>
/// 二维浮点向量（世界坐标，单位约定由调用方决定，通常为像素）。
/// 可变值类型语义：Set/Add 直接修改自身。
/// </summary>
class Vector2 {
    double x;
    double y;

    /// 创建分量 (x, y) 的向量。
    Vector2(double x, double y) {
        this.x = x;
        this.y = y;
    }

    /// X 分量。
    double X() { return this.x; }
    /// Y 分量。
    double Y() { return this.y; }
    /// 将两个分量替换为给定值。
    void Set(double x, double y) { this.x = x; this.y = y; }
    /// 就地累加偏移量（x、y 分别加到对应分量）。
    void Add(double x, double y) { this.x = this.x + x; this.y = this.y + y; }
}

/// <summary>
/// 轴对齐矩形，(x, y) 为左上角，宽高向右/向下延伸。
/// 坐标单位与 <see cref="Vector2"/> 一致（通常为像素）。
/// </summary>
class Rect2 {
    double x;
    double y;
    double width;
    double height;

    /// 创建左上角 (x, y)、尺寸 width x height 的矩形；不做合法性检查（负宽高原样保留）。
    Rect2(double x, double y, double width, double height) {
        this.x = x;
        this.y = y;
        this.width = width;
        this.height = height;
    }

    /// 左上角 X。
    double X() { return this.x; }
    /// 左上角 Y。
    double Y() { return this.y; }
    /// 宽度。
    double Width() { return this.width; }
    /// 高度。
    double Height() { return this.height; }
    /// 右边界 X（= X + Width；负宽时小于 X）。
    double Right() { return this.x + this.width; }
    /// 下边界 Y（= Y + Height；负高时小于 Y）。
    double Bottom() { return this.y + this.height; }
}

/// <summary>以圆心 (x, y) 与半径 radius 定义的圆形碰撞体。</summary>
class Circle2 {
    double x;
    double y;
    double radius;

    Circle2(double x, double y, double radius) {
        this.x = x;
        this.y = y;
        this.radius = radius;
    }

    /// 圆心 X。
    double X() { return this.x; }
    /// 圆心 Y。
    double Y() { return this.y; }
    /// 半径（不校验非负）。
    double Radius() { return this.radius; }
}

/// <summary>二维碰撞判定工具集；任一形状参数为 null 时判定为不相交。</summary>
class Collision2D {
    /// 点 (x, y) 是否位于矩形内（含边界）。
    static bool PointInRect(double x, double y, Rect2 rect) {
        return rect != null
            && x >= rect.X()
            && y >= rect.Y()
            && x <= rect.Right()
            && y <= rect.Bottom();
    }

    /// 两轴对齐矩形是否相交（仅边缘相触不算）。
    static bool Rects(Rect2 a, Rect2 b) {
        if (a == null || b == null) { return false; }
        return a.X() < b.Right()
            && a.Right() > b.X()
            && a.Y() < b.Bottom()
            && a.Bottom() > b.Y();
    }

    /// 两圆是否相交（圆心距 ≤ 半径之和，含恰好相切）。
    static bool Circles(Circle2 a, Circle2 b) {
        if (a == null || b == null) { return false; }
        double dx = a.X() - b.X();
        double dy = a.Y() - b.Y();
        double radius = a.Radius() + b.Radius();
        return dx * dx + dy * dy <= radius * radius;
    }

    /// 两点间距离的平方（避免开方）；比较距离时用它配对同侧平方阈值。
    static double DistanceSquared(
        double ax,
        double ay,
        double bx,
        double by
    ) {
        double dx = ax - bx;
        double dy = ay - by;
        return dx * dx + dy * dy;
    }
}

/// <summary>
/// 简单 2D 摄像机：维护世界坐标视口左上角与缩放，提供
/// 世界坐标 <-> 屏幕坐标的整数换算。屏幕坐标原点在左上角，
/// 向右向下为正；缩放 <= 1 时视野扩大，> 1 时放大画面。
/// </summary>
class Camera2D {
    double x;
    double y;
    double zoom;
    int viewportWidth;
    int viewportHeight;

    /// 创建视口尺寸 viewportWidth x viewportHeight（像素）的摄像机；
    /// 初始位于世界原点、缩放 1.0。
    Camera2D(int viewportWidth, int viewportHeight) {
        this.x = 0.0;
        this.y = 0.0;
        this.zoom = 1.0;
        this.viewportWidth = viewportWidth;
        this.viewportHeight = viewportHeight;
    }

    /// <summary>
    /// 平移视口，使世界点 (x, y) 位于视口中心（等价于
    /// SetPosition(x - 视口宽/zoom/2, y - 视口高/zoom/2)）。
    /// </summary>
    void CenterOn(double x, double y) {
        this.x = x - (double)this.viewportWidth / this.zoom / 2.0;
        this.y = y - (double)this.viewportHeight / this.zoom / 2.0;
    }

    /// 直接设置视口左上角的世界坐标。
    void SetPosition(double x, double y) { this.x = x; this.y = y; }
    /// 设置缩放倍率；小于 0.1 钳制为 0.1，大于 8.0 钳制为 8.0。
    void SetZoom(double zoom) {
        if (zoom < 0.1) { zoom = 0.1; }
        if (zoom > 8.0) { zoom = 8.0; }
        this.zoom = zoom;
    }

    /// 世界坐标 -> 屏幕坐标 X（截断取整，可能为负）。
    int ScreenX(double worldX) {
        return (int)((worldX - this.x) * this.zoom);
    }

    /// 世界坐标 -> 屏幕坐标 Y（截断取整，可能为负）。
    int ScreenY(double worldY) {
        return (int)((worldY - this.y) * this.zoom);
    }

    /// 屏幕坐标 -> 世界坐标 X（ScreenX 的逆变换，保留小数）。
    double WorldX(double screenX) { return screenX / this.zoom + this.x; }
    /// 屏幕坐标 -> 世界坐标 Y（ScreenY 的逆变换，保留小数）。
    double WorldY(double screenY) { return screenY / this.zoom + this.y; }
    /// 视口左上角的世界坐标 X。
    double X() { return this.x; }
    /// 视口左上角的世界坐标 Y。
    double Y() { return this.y; }
    /// 当前缩放倍率（0.1..8.0）。
    double Zoom() { return this.zoom; }
}
