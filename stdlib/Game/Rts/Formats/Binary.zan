using System;
using System.IO;

namespace Game.Rts.Formats;

// 内存字节缓冲区上的小端读取器。RTS 资源格式
// （MIX、PAL、SHP、TMP、VXL 等）均为小端且常含
// 内嵌 NUL 字节，因此显式跟踪长度，而非依赖
// 字符串终止符。越界读取返回 -1 而非抛错，以便
// 调用方在信任文件其余内容前先校验头部。
class BinaryReader {
    string data;
    int length;
    int pos;

    static BinaryReader FromBuffer(string data, int length) {
        BinaryReader r = new BinaryReader();
        r.data = data;
        r.length = length;
        r.pos = 0;
        return r;
    }

    static BinaryReader FromFile(string path, int length) {
        byte[] buf = File.ReadBytes(path, 0, length);
        return BinaryReader.FromBuffer(buf, length);
    }

    int Length() { return this.length; }
    int Position() { return this.pos; }
    bool Eof() { return this.pos >= this.length; }
    void Seek(int offset) { this.pos = offset; }
    void Skip(int count) { this.pos = this.pos + count; }

    // 读取绝对索引处的无符号字节，不移动游标。
    int ByteAt(int index) {
        if (index < 0 || index >= this.length) { return -1; }
        int b = this.data[index];
        return b & 0xFF;
    }

    int ReadU8() {
        int b = this.ByteAt(this.pos);
        if (b >= 0) { this.pos = this.pos + 1; }
        return b;
    }

    int ReadU16() {
        int b0 = this.ReadU8();
        int b1 = this.ReadU8();
        return (b1 << 8) | b0;
    }

    // 32 位小端值以 long 返回，使完整的无符号范围
    // 得以保留（普通 int 在设置第 31 位后会变负）。
    long ReadU32() {
        long b0 = this.ReadU8();
        long b1 = this.ReadU8();
        long b2 = this.ReadU8();
        long b3 = this.ReadU8();
        return (b3 << 24) | (b2 << 16) | (b1 << 8) | b0;
    }

    // 32 位小端有符号值（用于可放入 int 的偏移量）。
    int ReadI32() {
        int b0 = this.ReadU8();
        int b1 = this.ReadU8();
        int b2 = this.ReadU8();
        int b3 = this.ReadU8();
        return (b3 << 24) | (b2 << 16) | (b1 << 8) | b0;
    }
}
