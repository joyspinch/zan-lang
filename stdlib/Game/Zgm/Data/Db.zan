using System;
using System.Data;
using System.Data.Sqlite;
using Game.Zgm;

// 隔离在独立的命名空间/模块中，使 sqlite3 原生驱动只被
// 显式 `using Game.Zgm.Data;` 的程序链接——引入
// Game.Zgm 其余部分不得强加 -lsqlite3 依赖给所有使用者。
namespace Game.Zgm.Data;

// ZGM Sqlite 组件的实时 SQLite 数据库运行时。绑定
// SqliteComponentConfig (类型="Sqlite", 名称) to a real System.Data.Sqlite
// 连接，暴露 DM 引擎在构建/运行期使用的查询/执行/事务接口
// 打开/执行/查询 methods act on. Requires the sqlite3 native driver at
// （见 stdlib/System/Data/Sqlite/drivers）。
class ZgmDatabase {
    string name;
    SqliteConnection conn;
    bool open;

    // 打开组件的数据库文件（或 ":memory:"）并绑定实时
    // 连接 to the config's 名称.
    static ZgmDatabase Open(SqliteComponentConfig config, string path) {
        ZgmDatabase d = new ZgmDatabase();
        d.name = config.Name();
        d.conn = SqliteConnection.Open(path);
        d.open = d.conn.IsConnected();
        return d;
    }

    // 便捷方法：为指定组件打开私有内存数据库。
    static ZgmDatabase OpenMemory(string name) {
        SqliteComponentConfig cfg = new SqliteComponentConfig(name);
        return ZgmDatabase.Open(cfg, ":memory:");
    }

    static ZgmDatabase OpenProject(
        ZgmProject project,
        string componentName,
        string path
    ) {
        if (project == null) { return null; }
        SqliteComponentConfig config =
            project.FindDatabase(componentName);
        if (config == null) { return null; }
        return ZgmDatabase.Open(config, path);
    }

    string Name() { return this.name; }
    bool IsOpen() { return this.open; }

    // 执行: runs a non-query statement, 返回 affected row 数量 (-1 on 错误).
    int Execute(string sql) { return this.conn.Execute(sql); }

    // 查询: runs a query and 返回 the materialized result 设置.
    DbResult Query(string sql) { return this.conn.Query(sql); }

    // 第一行第一列（没有则为空字符串）。
    string Scalar(string sql) { return this.conn.ExecuteScalar(sql); }

    int LastInsertId() { return this.conn.LastInsertId(); }
    string GetError() { return this.conn.GetError(); }

    void Begin() { this.conn.BeginTransaction(); }
    void Commit() { this.conn.Commit(); }
    void Rollback() { this.conn.Rollback(); }

    void Close() {
        if (this.open) {
            this.conn.Close();
            this.open = false;
        }
    }
}
