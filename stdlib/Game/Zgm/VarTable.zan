using System;
using System.Collections.Generic;

namespace Game.Zgm;

// 单个模板绑定：变量名及其渲染后的字符串值。
class TemplateVar {
    string key;
    string text;

    static TemplateVar Of(string key, string text) {
        TemplateVar v = new TemplateVar();
        v.key = key;
        v.text = text;
        return v;
    }
    string Key() { return this.key; }
    string Text() { return this.text; }
}

// 模板变量 (template variables): the &名称& binding syntax 由其使用 labels,
// progress bars and 文本 nodes. A 数据源 (数据 source) maps names to 值;
// 渲染将每个 &name& 出现处替换为其绑定值。未绑定的名称
// 原样保留。（条件分支 {if}/{elseif}/{else}/{end} 由运行时
// 求值，不在这个静态解析器的范围内。）
class TemplateVars {
    List<TemplateVar> vars;

    TemplateVars() {
        this.vars = new List<TemplateVar>();
    }

    TemplateVars Set(string key, string text) {
        for (int i = 0; i < this.vars.Count; i = i + 1) {
            if (this.vars[i].Key() == key) {
                this.vars[i] = TemplateVar.Of(key, text);
                return this;
            }
        }
        this.vars.Add(TemplateVar.Of(key, text));
        return this;
    }
    TemplateVars SetInt(string key, int amount) {
        return this.Set(key, Convert.ToString(amount));
    }

    int Count() { return this.vars.Count; }
    bool Contains(string key) { return this.Lookup(key) != null; }

    bool Remove(string key) {
        for (int i = 0; i < this.vars.Count; i = i + 1) {
            if (this.vars[i].Key() == key) {
                this.vars.RemoveAt(i);
                return true;
            }
        }
        return false;
    }

    void Clear() { this.vars.Clear(); }

    // 查找绑定值；键未绑定时返回 null。
    string Lookup(string key) {
        for (int i = 0; i < this.vars.Count; i = i + 1) {
            TemplateVar v = this.vars[i];
            if (v.Key() == key) { return v.Text(); }
        }
        return null;
    }

    // 将每个 &name& 出现处替换为其绑定值。成对的 && 在这里
    // 不被视为绑定分隔符；只有当 &...& 的内部文本
    // 是已绑定键时才替换，否则保留字面文本。
    string Render(string template) {
        string outp = "";
        int n = template.Length;
        int i = 0;
        while (i < n) {
            string ch = template.Substring(i, 1);
            if (ch == "&") {
                int j = i + 1;
                int close = -1;
                while (j < n) {
                    if (template.Substring(j, 1) == "&") { close = j; break; }
                    j = j + 1;
                }
                if (close >= 0) {
                    string key = template.Substring(i + 1, close - i - 1);
                    string val = this.Lookup(key);
                    if (val != null) {
                        outp = outp + val;
                        i = close + 1;
                    } else {
                        outp = outp + ch;
                        i = i + 1;
                    }
                } else {
                    outp = outp + ch;
                    i = i + 1;
                }
            } else {
                outp = outp + ch;
                i = i + 1;
            }
        }
        return outp;
    }
}
