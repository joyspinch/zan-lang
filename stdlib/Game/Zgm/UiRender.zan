// 生产级 UI 渲染：真实 Zgm Widget/UiRuntime 状态 -> IUiRenderer，
// 具体后端在编译期选择（-DUI_GPU / -DUI_SOFTWARE /
// 默认无头）。只有 UI_GPU 构建引用 SDL3。
//
// 控件绘制流程（WidgetPainter）只针对 IUiRenderer 编写一次，
// 遍历 UiRuntime 产生的真实 ZgmWindowState / ZgmWidgetState。它只读取
// 基础 Widget + ZgmWidgetState 的 getter（rect / visible / alpha / text /
// range position），并按 Kind() 分派；无需向下转型。

// SDL3/GPU 后端（类 SdlUiRenderer）位于独立文件
// （optional/UiRenderSdl.zan）中，仅在 -DUI_GPU 构建时
// 传入编译器命令行。这是刻意的：--auto-stdlib 通过原始预处理
// 文本扫描 `using ...;` 来发现模块，因此这里的 `using SDL3;`——即使在
// #if UI_GPU 之下——仍会把 stdlib/SDL3 拉进非 GPU 构建。把
// SDL 排除在所有常编译文件之外，正是非 GPU 二进制
// 不含任何 SDL3 依赖的原因。
using System;
using System.Collections.Generic;

namespace Game.Zgm;

// ---- 与后端无关的契约 -------------------------------------------
interface IUiRenderer {
    string BackendName();
    bool GpuAccelerated();
    void BeginFrame(int r, int g, int b);
    void PushClip(int x, int y, int w, int h);
    void PopClip();
    void FillRect(int x, int y, int w, int h, int r, int g, int b, int a);
    void DrawBorder(int x, int y, int w, int h, int t, int r, int g, int b, int a);
    // 文本用共享 PixelFont 字形集栅格化；DrawSprite 接收
    // 控件的图片资源 id，使带解码器的后端（GPU）可快速拷贝
    // 缓存的纹理，而无解码器的后端退化为着色块。
    void DrawText(string text, int x, int y, int r, int g, int b, int a);
    void DrawSprite(string image, int x, int y, int w, int h, int angle, int alpha);
    void EndFrame();
    long Metric();
}

// ==========================================================================
#if UI_SOFTWARE
class SoftwareUiRenderer : IUiRenderer {
    int width; int height;
    int[] buffer;
    int clipX; int clipY; int clipW; int clipH;

    SoftwareUiRenderer(int width, int height) {
        this.width = width; this.height = height;
        this.buffer = new int[width * height];
        this.clipX = 0; this.clipY = 0; this.clipW = width; this.clipH = height;
    }
    string BackendName() { return "software-cpu"; }
    bool GpuAccelerated() { return false; }
    void Blend(int px, int py, int r, int g, int b, int a) {
        if (px < this.clipX || py < this.clipY) { return; }
        if (px >= this.clipX + this.clipW || py >= this.clipY + this.clipH) { return; }
        if (px < 0 || py < 0 || px >= this.width || py >= this.height) { return; }
        int idx = py * this.width + px;
        int old = this.buffer[idx];
        int or = (old >> 16) & 255; int og = (old >> 8) & 255; int ob = old & 255;
        int nr = (r * a + or * (255 - a)) / 255;
        int ng = (g * a + og * (255 - a)) / 255;
        int nb = (b * a + ob * (255 - a)) / 255;
        this.buffer[idx] = ((nr & 255) << 16) | ((ng & 255) << 8) | (nb & 255);
    }
    void BeginFrame(int r, int g, int b) {
        int packed = ((r & 255) << 16) | ((g & 255) << 8) | (b & 255);
         int total = this.width * this.height;
        for (int i = 0; i < total; i = i + 1) { this.buffer[i] = packed; }
    }
    void PushClip(int x, int y, int w, int h) {
        this.clipX = x; this.clipY = y; this.clipW = w; this.clipH = h;
    }
    void PopClip() {
        this.clipX = 0; this.clipY = 0; this.clipW = this.width; this.clipH = this.height;
    }
    void FillRect(int x, int y, int w, int h, int r, int g, int b, int a) {
        for (int yy = 0; yy < h; yy = yy + 1) {
            for (int xx = 0; xx < w; xx = xx + 1) { this.Blend(x + xx, y + yy, r, g, b, a); }
        }
    }
    void DrawBorder(int x, int y, int w, int h, int t, int r, int g, int b, int a) {
        this.FillRect(x, y, w, t, r, g, b, a);
        this.FillRect(x, y + h - t, w, t, r, g, b, a);
        this.FillRect(x, y, t, h, r, g, b, a);
        this.FillRect(x + w - t, y, t, h, r, g, b, a);
    }
    void DrawText(string text, int x, int y, int r, int g, int b, int a) {
        if (text == null) { return; }
        int cx = x;
        for (int i = 0; i < text.Length; i = i + 1) {
            int cp = text[i] & 255;
            for (int ry = 0; ry < 8; ry = ry + 1) {
                int mask = PixelFont.Row(cp, ry);
                for (int rx = 0; rx < 8; rx = rx + 1) {
                    if ((mask & (1 << (7 - rx))) != 0) {
                        this.Blend(cx + rx, y + ry, r, g, b, a);
                    }
                }
            }
            cx = cx + PixelFont.Advance();
        }
    }
    // CPU 路径没有图片解码器：渲染一个确定性着色块，其
    // 色调由资源 id 推导，使不同精灵在视觉上
    // 可区分。GPU 后端则快速拷贝真实缓存的纹理。
    void DrawSprite(string image, int x, int y, int w, int h, int angle, int alpha) {
        int seed = 0;
        if (image != null) {
            for (int i = 0; i < image.Length; i = i + 1) { seed = seed + (image[i] & 255); }
        }
        int r = 120 + (seed * 37) % 120;
        int g = 90 + (seed * 53) % 120;
        int b = 80 + (seed * 29) % 120;
        this.FillRect(x, y, w, h, r, g, b, alpha);
        this.DrawBorder(x, y, w, h, 1, 20, 24, 32, alpha);
    }
    void EndFrame() { }
    long Metric() {
        long sum = 0;  int total = this.width * this.height;
        for (int i = 0; i < total; i = i + 1) { sum = sum + (long)this.buffer[i]; }
        return sum;
    }
}
#endif

// ==========================================================================
#if UI_GPU
#elif UI_SOFTWARE
#else
class HeadlessUiRenderer : IUiRenderer {
    long metric;
    HeadlessUiRenderer(int width, int height) {
        this.metric = (long)(width + height);
    }
    string BackendName() { return "headless"; }
    bool GpuAccelerated() { return false; }
    void BeginFrame(int r, int g, int b) { this.metric = this.metric + (long)(r + g + b); }
    void PushClip(int x, int y, int w, int h) { this.metric = this.metric + (long)(x + y + w + h); }
    void PopClip() { }
    void FillRect(int x, int y, int w, int h, int r, int g, int b, int a) {
        this.metric = this.metric + (long)(x + y + w + h + r + g + b + a);
    }
    void DrawBorder(int x, int y, int w, int h, int t, int r, int g, int b, int a) {
        this.metric = this.metric + (long)(x + y + w + h + t + r + g + b + a);
    }
    void DrawText(string text, int x, int y, int r, int g, int b, int a) {
        this.metric = this.metric + (long)(text.Length + x + y + r + g + b + a);
    }
    void DrawSprite(string image, int x, int y, int w, int h, int angle, int alpha) {
        int imgLen = 0;
        if (image != null) { imgLen = image.Length; }
        this.metric = this.metric + (long)(imgLen + x + y + w + h + angle + alpha);
    }
    void EndFrame() { }
    long Metric() { return this.metric; }
}
#endif

// ---- 编译期后端工厂 ----------------------------------------
class UiBackendFactory {
    static IUiRenderer Create(int width, int height) {
#if UI_GPU
        return new SdlUiRenderer(width, height);
#elif UI_SOFTWARE
        return new SoftwareUiRenderer(width, height);
#else
        return new HeadlessUiRenderer(width, height);
#endif
    }
    static string BackendId() {
#if UI_GPU
        return "sdl-gpu";
#elif UI_SOFTWARE
        return "software-cpu";
#else
        return "headless";
#endif
    }
}

// ---- 与后端无关的控件绘制流程（真实 Zgm 状态） -----------------
class WidgetPainter {
    static int AlphaOf(double a) {
        int v = (int)(a * 255.0);
        if (v < 0) { v = 0; }
        if (v > 255) { v = 255; }
        return v;
    }

    static void PaintWidget(IUiRenderer ui, int ox, int oy, ZgmWidgetState s) {
        if (!s.Visible()) { return; }
        int a = WidgetPainter.AlphaOf(s.Alpha());
        int x = ox + s.X();
        int y = oy + s.Y();
        int w = s.Width();
        int h = s.Height();
        string kind = s.Kind();
        if (kind == "按钮") {                       // 按钮
            int face = 70;
            if (s.Selected()) { face = 110; }
            if (!s.Enabled()) { face = 40; }
            ui.FillRect(x, y, w, h, face, face + 8, face + 24, a);
            ui.DrawBorder(x, y, w, h, 1, 20, 24, 36, a);
            ui.DrawText(s.Text(), x + 6, y + h / 2 - 4, 235, 235, 245, a);
        } else if (kind == "标签") {                // 标签
            ui.DrawText(s.Text(), x, y, 230, 230, 240, a);
        } else if (kind == "文本框"
                || kind == "输入框") {          // 富文本 / 编辑框
            ui.FillRect(x, y, w, h, 24, 26, 34, a);
            ui.DrawBorder(x, y, w, h, 1, 60, 66, 84, a);
            ui.PushClip(x, y, w, h);
            ui.DrawText(s.Text(), x + 4, y + 4, 210, 214, 226, a);
            ui.PopClip();
        } else if (kind == "进度条") {          // 进度条
            ui.FillRect(x, y, w, h, 30, 32, 40, a);
            int lo = s.Config().ControlMin();
            int hi = s.Config().ControlMax();
            int span = hi - lo;
            int fill = 0;
            if (span > 0) {
                int p = s.Position() - lo;
                if (p < 0) { p = 0; }
                if (p > span) { p = span; }
                fill = w * p / span;
            }
            ui.FillRect(x, y, fill, h, 90, 180, 120, a);
            ui.DrawBorder(x, y, w, h, 1, 60, 66, 84, a);
        } else if (kind == "图片框"             // 图片框
                || kind == "动画框") {          // 动画框
            ui.DrawSprite(s.Image(), x, y, w, h, s.Angle(), a);
        } else if (kind == "容器") {                // 容器
            ui.FillRect(x, y, w, h, 18, 20, 28, a);
            ui.DrawBorder(x, y, w, h, 1, 54, 60, 78, a);
        } else {
            ui.DrawBorder(x, y, w, h, 1, 90, 96, 116, a);
        }
    }

    static void PaintWidgets(
        IUiRenderer ui, List<ZgmWidgetState> widgets, int ox, int oy) {
        for (int i = 0; i < widgets.Count; i = i + 1) {
            WidgetPainter.PaintWidget(ui, ox, oy, widgets[i]);
        }
    }

    static void PaintWindow(IUiRenderer ui, ZgmWindowState window) {
        if (!window.Visible()) { return; }
        int a = WidgetPainter.AlphaOf(window.Alpha());
        ui.FillRect(window.X(), window.Y(), window.Width(), window.Height(),
            12, 14, 20, a);
        for (int i = 0; i < window.WidgetCount(); i = i + 1) {
            WidgetPainter.PaintWidget(ui, window.X(), window.Y(),
                window.WidgetAt(i));
        }
    }
}
