using System;

namespace Game.Zgm;

enum MusicState {
    Stopped,
    Playing,
    Paused
}

// 与渲染器/音频后端无关的音乐对象。音频适配器可观察
// 该状态，并将 Play/Pause/Stop 映射到其原生混音器。
class ZgmMusic {
    string resource;
    double volume;
    double pitch;
    int channel;
    int length;
    bool loop;
    MusicState state;

    ZgmMusic(string resource) {
        this.resource = resource;
        this.volume = 1.0;
        this.pitch = 1.0;
        this.channel = -1;
        this.length = 0;
        this.loop = false;
        this.state = MusicState.Stopped;
    }
    ZgmMusic SetVolume(double volume) {
        this.volume = volume;
        return this;
    }
    ZgmMusic SetPitch(double pitch) {
        this.pitch = pitch;
        return this;
    }
    ZgmMusic SetChannel(int channel) {
        this.channel = channel;
        return this;
    }
    ZgmMusic SetLoop(bool loop) {
        this.loop = loop;
        return this;
    }
    void Play() { this.state = MusicState.Playing; }
    void Pause() {
        if (this.state == MusicState.Playing) {
            this.state = MusicState.Paused;
        }
    }
    void Stop() { this.state = MusicState.Stopped; }
    string Resource() { return this.resource; }
    double Volume() { return this.volume; }
    double Pitch() { return this.pitch; }
    int Channel() { return this.channel; }
    int Length() { return this.length; }
    bool Loop() { return this.loop; }
    MusicState State() { return this.state; }

    void Dispose() {
        this.resource = null;
    }
}
