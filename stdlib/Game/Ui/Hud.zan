using System;
using SDL3;
using Gui;
using Gui.Backend;
using System.IO;
using Game.Foundation.Sdl;

namespace Game.Ui;

/// <summary>
/// 游戏体验层的 HUD 桥：把 <see cref="GameHost"/> 自建的 SDL 窗口
/// 交给 <see cref="Gui.App"/> 的 SDL 后端接管，然后每一帧
/// <list type="bullet">
/// <item>1. 游戏照常把场景画进自己的 <see cref="SdlRenderer"/>（不 Present）；</item>
/// <item>2. <see cref="ReadScene"/> 把场景帧读回 CPU；</item>
/// <item>3. <see cref="Frame"/> 里 Gui 控件树在 HUD surface 上重绘，
/// <c>ScenePresent</c> 把"场景在下、HUD 在上"一次合成呈现。</item>
/// </list>
/// 游戏代码从此直接用 stdlib Gui 的控件 + CSS 皮肤写界面（面板、
/// 聊天、背包、进度条……），配色风格全部落在皮肤文件里；不再
/// 手算坐标、不再散落颜色魔法数字。
///
/// 最小用法：
/// <code>
///     GameHost host = new GameHost("传奇", 1280, 720, 16);
///     host.Open();
///     GameHud hud = GameHud.Create(host);
///     hud.Root(() => {
///         Panel p = new Panel();
///         p.Class = "hud-panel";
///         ...
///     });
///     while (host.Running()) {
///         host.PumpEvents(loop);           // 游戏自己的输入处理
///         host.Render(scene);              // 场景照常画，不 Present
///         hud.Frame();                     // HUD 合成 + 呈现
///     }
/// </code>
/// SDL 场景读回需要 renderer 后备缓冲可读（D3D/GL 均可）；
/// 场景尺寸变化由 <see cref="Frame"/> 自动跟随。
/// </summary>
class GameHud {
    App app;
    Form root;
    int sceneW;
    int sceneH;
    bool adopted;
    string lastError;
    // Reused scene-frame buffer. ReadPixels needs a writable byte block the
    // size of the backbuffer (w*h*4 — over 8 MB at 1080p); allocating one per
    // frame in Frame() made ARC churn hundreds of MB per second. The buffer
    // is reallocated only when the window size actually changes. byte[]
    // marshals by reference into the native calls (string would need the
    // ByteBuffer.ToStr dance because `new string(char,int)` returns null on
    // the current compiler — see TASKS.md compiler-defect record).
    byte[] scene;
    int pixW;
    int pixH;

    GameHud() {
        this.app = null;
        this.root = null;
        this.sceneW = 0;
        this.sceneH = 0;
        this.adopted = false;
        this.lastError = "";
    }

    /// 接管宿主窗口并创建 HUD 应用（设计尺寸=宿主窗口客户区）。
    /// `sdlWindowHandle` 是宿主自建的 SDL 窗口句柄——接受任意宿主
    /// （Game.Kit Host、GameHost、游戏自管窗口）。`sdlRendererHandle`
    /// 是宿主渲染器句柄（复用它做合成；同窗口建第二个渲染器在
    /// D3D11 上会失败）。失败时返回的实例 Ready() 为 false，
    /// <see cref="LastError"/> 带原因。
    static GameHud CreateFor(nint sdlWindowHandle, nint sdlRendererHandle) {
        GameHud hud = new GameHud();
        if (sdlWindowHandle == 0) {
            hud.lastError = "window handle is 0";
            return hud;
        }
        // 先交渲染器（adopt 时若已有渲染器则复用它，不再新建）。
        if (sdlRendererHandle != 0) {
            Window.SceneSetRenderer(sdlWindowHandle, sdlRendererHandle);
        }
        int rc = Window.AdoptSdlWindow(sdlWindowHandle);
        if (rc != 0) {
            hud.lastError = "adopt failed rc=" + Convert.ToString(rc)
                + " (SDL-backend zan_gui required)";
            return hud;
        }
        hud.adopted = true;
        // HUD 画布逻辑尺寸优先取宿主渲染器后备缓冲的像素尺寸：adopt
        // 接管路径不产生 RESIZED 事件，Gui 后端的窗口尺寸缓存仍是 0，
        // 只有后备缓冲尺寸才是 ReadPixels/合成真正需要的。
        int initPacked = RendererOutputSize(sdlRendererHandle);
        hud.sceneW = initPacked & 0xFFFF;
        hud.sceneH = (initPacked >> 16) & 0xFFFF;
        if (hud.sceneW <= 0 || hud.sceneH <= 0) {
            hud.sceneW = NativeWindowSizeW(sdlWindowHandle);
            hud.sceneH = NativeWindowSizeH(sdlWindowHandle);
        }
        hud.app = new App("hud", hud.sceneW > 0 ? hud.sceneW : 320,
                          hud.sceneH > 0 ? hud.sceneH : 240);
        hud.app.SetDark(true);
        hud.app.EnableSkins(0);
        hud.app.ApplySkinName("gamehud");
        return hud;
    }

    [DllImport("zan_gui")]
    static extern int zan_gui_window_width();
    [DllImport("zan_gui")]
    static extern int zan_gui_window_height();

    [DllImport("zan_sdl3")]
    static extern int zan_sdl_render_output_size(nint rendererHandle);

    // 宿主渲染器后备缓冲的像素尺寸，打包 (h<<16)|w；失败返回 0。
    static int RendererOutputSize(nint rendererHandle) {
        if (rendererHandle == 0) { return 0; }
        return zan_sdl_render_output_size(rendererHandle);
    }

    // SDL 后端维护主窗口尺寸缓存（创建/resize 时更新），足够做画布初值。
    static int NativeWindowSizeW(nint hwnd) {
        return zan_gui_window_width();
    }
    static int NativeWindowSizeH(nint hwnd) {
        return zan_gui_window_height();
    }

    /// 当前主窗口客户区像素宽（逐帧从后端取，窗口缩放自动跟随）。
    static int WindowPixelW() { return zan_gui_window_width(); }
    /// 当前主窗口客户区像素高。
    static int WindowPixelH() { return zan_gui_window_height(); }

    /// 接管宿主窗口并创建 HUD 应用（Game.Foundation.Sdl.GameHost 重载）。
    static GameHud Create(GameHost gameHost) {
        if (gameHost == null) { return CreateFor(0, 0); }
        return CreateFor(gameHost.Window().Handle(),
                         gameHost.Renderer().Handle());
    }

    /// 接管 Game.Kit.Host 自建的 SDL 窗口（原 GameKit 游戏的便捷重载）：
    /// 窗口/渲染器句柄都取自宿主。失败时 Ready() 为 false。
    static GameHud Create(Kit.Host host) {
        if (host == null) { return CreateFor(0, 0); }
        return CreateFor(host.WindowHandle(), host.r.Handle());
    }

    /// 接管失败原因（成功时为空串）。
    string LastError() { return this.lastError; }

    /// HUD 是否就绪（接管成功且 App 有效）。
    bool Ready() {
        return this.adopted && this.app != null;
    }

    /// 底层 Gui.App（皮肤、主题、时钟等高级定制入口）。
    App GetApp() { return this.app; }

    /// 注册 HUD 控件树根：Form 是 Gui 的保留模式窗口根，
    /// 游戏往它上面挂面板/列表/按钮即可（Class 用 hud-* 系列
    /// 即落到 gamehud 皮肤）。
    void Root(Form hudRoot) {
        this.root = hudRoot;
    }

    /// 读取场景帧到 rgbaOut（w*h*4 字节）。游戏 Render 之后调用。
    /// `renderer` 由宿主传入自己的 SdlRenderer（读后备缓冲）。
    bool ReadScene(SdlRenderer renderer, string rgbaOut, int w, int h) {
        if (renderer == null) { return false; }
        return renderer.ReadPixels(rgbaOut, w, h);
    }

    /// 一帧 HUD：上传场景帧、重绘控件树、合成呈现。
    /// `renderer` 是宿主渲染器（场景画完后、Present 前调用本方法；
    /// 宿主置 hudMode 让自己的 Present 跳过）。
    bool Frame(SdlRenderer renderer, nint sdlWindowHandle) {
        if (!this.Ready() || renderer == null) { return false; }
        // 场景帧尺寸必须等于渲染器后备缓冲的像素尺寸——ReadPixels 按
        // 后备缓冲原样读回，尺寸不符即失败。Gui 后端的窗口尺寸缓存在
        // adopt 接管路径下不初始化（恒 0），不能作为尺寸来源。
        int packed = renderer.OutputSize();
        int w = packed & 0xFFFF;
        int h = (packed >> 16) & 0xFFFF;
        if (w <= 0 || h <= 0) {
            w = WindowPixelW();
            h = WindowPixelH();
        }
        if (w <= 0 || h <= 0) { return false; }
        if (this.app.canvas.Width() != w || this.app.canvas.Height() != h) {
            // 画布与渲染器后备缓冲不同步时先试着追平再失败。接管路径
            // 下 App 构造时仍建了一个哑 Win32 外壳窗口（WINDOWS 宏编译
            // 出的 Win32Shell.CreateWindow），其首帧 WM_SIZE/客户区查询
            // 会把画布 resize 到外壳窗口自己的尺寸（与 DPI 缩放后的
            // 1440x1080 请求叠加，得到 2182x1646 这类值）——那不是
            // 渲染器后备缓冲的尺寸。此处以渲染器输出为准重建画布
            // （SwapCanvas 同时清掉跨表面快照/损伤状态），下一帧即
            // 正常合成；只有追平后仍不等（真分辨率漂移）才降级。
            if (this.app.canvas.Width() != this.sceneW
                    || this.app.canvas.Height() != this.sceneH
                    || this.sceneW != w || this.sceneH != h) {
                this.app.SwapCanvas(w, h);
            }
        }
        if (this.app.canvas.Width() != w || this.app.canvas.Height() != h) {
            // 追平后仍不一致：合成结果必然错位，交回宿主降级直呈，
            // 避免两种呈现交替闪变。
            this.lastError = "canvas " + this.app.canvas.Width() + "x" +
                this.app.canvas.Height() + " != renderer " + w + "x" + h;
            return false;
        }
        // Scene-frame buffer: reuse the previous frame's allocation (member
        // fields) instead of allocating a fresh w*h*4 block every frame.
        // `new string(char,int)` returns null on the current compiler (see
        // TASKS.md compiler-defect record), so the buffer starts as a
        // ByteBuffer allocation converted once via ToStr; the string carries
        // an explicit length and ReadPixels overwrites all of it.
        if (this.scene == null || this.pixW != w || this.pixH != h) {
            this.scene = new byte[w * h * 4];
            this.pixW = w;
            this.pixH = h;
        }
        if (this.scene == null) { return false; }
        if (!this.ReadScene(renderer, this.scene, w, h)) {
            this.lastError = "read scene failed";
            return false;
        }
        int rc = Window.SceneUpload(sdlWindowHandle, this.scene, w, h);
        if (rc != 0) {
            this.lastError = "scene upload rc=" + Convert.ToString(rc);
            return false;
        }
        App app = this.app;
        app.ProcessEvent();
        app.BeginFrame();
        Form root = this.root;
        if (root != null) {
            // 借 Form 的整树测量/布局/绘制（含皮肤主题背景）。
            root.RenderFrame(app);
        }
        app.PresentFrame();
        // 合成呈现失败（如 gui 运行时与宿主不在同一 SDL3 实例）返回
        // false，宿主可据此降级回自己的直呈路径。
        if (Window.ScenePresent(sdlWindowHandle, app.canvas.SurfaceId()) != 0) {
            this.lastError = "scene present failed";
            return false;
        }
        return true;
    }
}
