using System;
using System.Text;

namespace Sdk.Wechat;

/// <summary>
/// 微信服务器推送的一条请求消息（明文 XML 解析结果）。
///
/// 字段覆盖最常用的文本 / 图片 / 事件；其余类型仍可通过
/// <see cref="Raw"/> + <see cref="XmlUtil.GetTag"/> 自行取。
/// 不照搬 Senparc 那套巨大的 RequestMessage* 继承树。
/// </summary>
class WechatRequestMessage {
    public string ToUserName;
    public string FromUserName;
    public string CreateTime;
    public string MsgType;
    public string Content;
    public string MsgId;
    public string PicUrl;
    public string MediaId;
    public string Event;
    public string EventKey;
    public string Ticket;
    public string Latitude;
    public string Longitude;
    public string Precision;
    public string Raw;

    public WechatRequestMessage() {
        this.ToUserName = "";
        this.FromUserName = "";
        this.CreateTime = "";
        this.MsgType = "";
        this.Content = "";
        this.MsgId = "";
        this.PicUrl = "";
        this.MediaId = "";
        this.Event = "";
        this.EventKey = "";
        this.Ticket = "";
        this.Latitude = "";
        this.Longitude = "";
        this.Precision = "";
        this.Raw = "";
    }

    /// <summary>从明文 XML 解析。</summary>
    static WechatRequestMessage Parse(string xml) {
        WechatRequestMessage m = new WechatRequestMessage();
        m.Raw = xml;
        m.ToUserName = XmlUtil.GetTag(xml, "ToUserName");
        m.FromUserName = XmlUtil.GetTag(xml, "FromUserName");
        m.CreateTime = XmlUtil.GetTag(xml, "CreateTime");
        m.MsgType = XmlUtil.GetTag(xml, "MsgType");
        m.Content = XmlUtil.GetTag(xml, "Content");
        m.MsgId = XmlUtil.GetTag(xml, "MsgId");
        m.PicUrl = XmlUtil.GetTag(xml, "PicUrl");
        m.MediaId = XmlUtil.GetTag(xml, "MediaId");
        m.Event = XmlUtil.GetTag(xml, "Event");
        m.EventKey = XmlUtil.GetTag(xml, "EventKey");
        m.Ticket = XmlUtil.GetTag(xml, "Ticket");
        m.Latitude = XmlUtil.GetTag(xml, "Latitude");
        m.Longitude = XmlUtil.GetTag(xml, "Longitude");
        m.Precision = XmlUtil.GetTag(xml, "Precision");
        return m;
    }

    bool IsText() { return this.MsgType == "text"; }
    bool IsImage() { return this.MsgType == "image"; }
    bool IsEvent() { return this.MsgType == "event"; }
    bool IsSubscribe() { return this.Event == "subscribe"; }
    bool IsUnsubscribe() { return this.Event == "unsubscribe"; }
    bool IsClick() { return this.Event == "CLICK"; }
    bool IsScan() { return this.Event == "SCAN" || this.Event == "scan"; }
}

/// <summary>
/// 被动回复消息构造器。角色对调：ToUserName = 请求的 FromUserName。
/// </summary>
class WechatReply {
    /// <summary>构造文本回复 XML。</summary>
    static string Text(string toUser, string fromUser, string content) {
        return WechatReply.Build(toUser, fromUser, "text",
            XmlUtil.CdataTag("Content", content));
    }

    /// <summary>构造图片回复 XML。</summary>
    static string Image(string toUser, string fromUser, string mediaId) {
        string inner = "<Image>" + XmlUtil.CdataTag("MediaId", mediaId) + "</Image>";
        return WechatReply.Build(toUser, fromUser, "image", inner);
    }

    /// <summary>
    /// 一条图文。多条时自行拼 items 后调用
    /// <c>News(to, from, count, itemsXml)</c>。
    /// </summary>
    static string NewsItem(string title, string description, string picUrl, string url) {
        StringBuilder sb = new StringBuilder();
        sb.Append("<item>");
        sb.Append(XmlUtil.CdataTag("Title", title));
        sb.Append(XmlUtil.CdataTag("Description", description));
        sb.Append(XmlUtil.CdataTag("PicUrl", picUrl));
        sb.Append(XmlUtil.CdataTag("Url", url));
        sb.Append("</item>");
        return sb.ToString();
    }

    static string News(string toUser, string fromUser, int count, string itemsXml) {
        StringBuilder inner = new StringBuilder();
        inner.Append(XmlUtil.TextTag("ArticleCount", Convert.ToString(count)));
        inner.Append("<Articles>");
        inner.Append(itemsXml);
        inner.Append("</Articles>");
        return WechatReply.Build(toUser, fromUser, "news", inner.ToString());
    }

    static string Build(string toUser, string fromUser, string msgType, string body) {
        long now = DateTime.UtcNow().ToUnixSeconds();
        StringBuilder sb = new StringBuilder();
        sb.Append("<xml>");
        sb.Append(XmlUtil.CdataTag("ToUserName", toUser));
        sb.Append(XmlUtil.CdataTag("FromUserName", fromUser));
        sb.Append(XmlUtil.TextTag("CreateTime", Convert.ToString(now)));
        sb.Append(XmlUtil.CdataTag("MsgType", msgType));
        sb.Append(body);
        sb.Append("</xml>");
        return sb.ToString();
    }
}
