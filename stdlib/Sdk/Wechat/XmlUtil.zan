using System;
using System.Text;

namespace Sdk.Wechat;

/// <summary>
/// 微信推送/回复 XML 的极简读写。
///
/// 不引入完整 XML 解析器：微信报文结构固定、字段值几乎都包在
/// <c>&lt;![CDATA[...]]&gt;</c> 里，用标签扫描足够。
/// 需要完整 DOM 时再换 System 层解析器，这里不做第二套 XML 库。
/// </summary>
class XmlUtil {
    /// <summary>
    /// 取 <paramref name="xml"/> 中第一个 <c>&lt;tag&gt;...&lt;/tag&gt;</c> 的文本内容；
    /// 支持 CDATA。找不到返回空串。
    /// </summary>
    static string GetTag(string xml, string tag) {
        string open = "<" + tag + ">";
        string close = "</" + tag + ">";
        int start = XmlUtil.IndexOf(xml, open, 0);
        if (start < 0) {
            // 允许属性：<tag xxx>
            open = "<" + tag + " ";
            start = XmlUtil.IndexOf(xml, open, 0);
            if (start < 0) { return ""; }
            int gt = XmlUtil.IndexOf(xml, ">", start);
            if (gt < 0) { return ""; }
            start = gt + 1;
        } else {
            start = start + open.Length;
        }
        int end = XmlUtil.IndexOf(xml, close, start);
        if (end < 0) { return ""; }
        string inner = xml.Substring(start, end - start);
        return XmlUtil.StripCdata(inner);
    }

    /// <summary>去掉一层 CDATA 包装；没有则 Trim 空白后返回。</summary>
    static string StripCdata(string s) {
        string t = XmlUtil.Trim(s);
        if (t.Length >= 12 && t.Substring(0, 9) == "<![CDATA[") {
            // <![CDATA[ ... ]]>
            int close = XmlUtil.IndexOf(t, "]]>", 9);
            if (close >= 0) {
                return t.Substring(9, close - 9);
            }
        }
        return t;
    }

    /// <summary>拼一个带 CDATA 的元素。</summary>
    static string CdataTag(string tag, string text) {
        return "<" + tag + "><![CDATA[" + text + "]]></" + tag + ">";
    }

    /// <summary>拼一个纯文本元素（CreateTime 等数字字段）。</summary>
    static string TextTag(string tag, string text) {
        return "<" + tag + ">" + text + "</" + tag + ">";
    }

    static string Trim(string s) {
        int n = s.Length;
        int a = 0;
        while (a < n) {
            int c = s[a] & 255;
            if (c != 32 && c != 9 && c != 10 && c != 13) { break; }
            a = a + 1;
        }
        int b = n;
        while (b > a) {
            int c = s[b - 1] & 255;
            if (c != 32 && c != 9 && c != 10 && c != 13) { break; }
            b = b - 1;
        }
        if (a == 0 && b == n) { return s; }
        return s.Substring(a, b - a);
    }

    /// <summary>子串查找，返回起始下标，找不到 -1。不用依赖可能缺失的 IndexOf 重载。</summary>
    static int IndexOf(string hay, string needle, int from) {
        int n = hay.Length;
        int m = needle.Length;
        if (m == 0) { return from; }
        if (from < 0) { from = 0; }
        int last = n - m;
        int i = from;
        while (i <= last) {
            int j = 0;
            while (j < m) {
                if ((hay[i + j] & 255) != (needle[j] & 255)) { break; }
                j = j + 1;
            }
            if (j == m) { return i; }
            i = i + 1;
        }
        return -1;
    }
}
