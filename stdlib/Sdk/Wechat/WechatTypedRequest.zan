using System;
using System.Json;
using System.Text;

namespace Sdk.Wechat;

/// <summary>Internal JSON/query accumulator used by generated typed requests.</summary>
class WechatTypedRequest {
    JsonValue body;
    JsonValue query;
    JsonValue path;

    public WechatTypedRequest() {
        this.body = JsonValue.NewObject();
        this.query = JsonValue.NewObject();
        this.path = JsonValue.NewObject();
    }

    WechatTypedRequest BodyString(string key, string fieldValue) {
        this.body.Set(key, JsonValue.NewStr(fieldValue)); return this;
    }
    WechatTypedRequest BodyInt(string key, int fieldValue) {
        this.body.Set(key, JsonValue.NewNum(Convert.ToString(fieldValue))); return this;
    }
    WechatTypedRequest BodyLong(string key, long fieldValue) {
        this.body.Set(key, JsonValue.NewNum(Convert.ToString(fieldValue))); return this;
    }
    WechatTypedRequest BodyDouble(string key, double fieldValue) {
        this.body.Set(key, JsonValue.NewNum(Convert.ToString(fieldValue))); return this;
    }
    WechatTypedRequest BodyBool(string key, bool fieldValue) {
        this.body.Set(key, JsonValue.NewBool(fieldValue)); return this;
    }
    WechatTypedRequest BodyStrings(string key, List<string> items) {
        JsonValue array = JsonValue.NewArray();
        int i = 0;
        while (i < items.Count) { array.Append(JsonValue.NewStr(items[i])); i = i + 1; }
        this.body.Set(key, array); return this;
    }
    WechatTypedRequest BodyInts(string key, List<int> items) {
        JsonValue array = JsonValue.NewArray();
        int i = 0;
        while (i < items.Count) { array.Append(JsonValue.NewNum(Convert.ToString(items[i]))); i = i + 1; }
        this.body.Set(key, array); return this;
    }
    WechatTypedRequest BodyLongs(string key, List<long> items) {
        JsonValue array = JsonValue.NewArray();
        int i = 0;
        while (i < items.Count) { array.Append(JsonValue.NewNum(Convert.ToString(items[i]))); i = i + 1; }
        this.body.Set(key, array); return this;
    }
    WechatTypedRequest BodyDoubles(string key, List<double> items) {
        JsonValue array = JsonValue.NewArray();
        int i = 0;
        while (i < items.Count) { array.Append(JsonValue.NewNum(Convert.ToString(items[i]))); i = i + 1; }
        this.body.Set(key, array); return this;
    }
    WechatTypedRequest BodyBools(string key, List<bool> items) {
        JsonValue array = JsonValue.NewArray();
        int i = 0;
        while (i < items.Count) { array.Append(JsonValue.NewBool(items[i])); i = i + 1; }
        this.body.Set(key, array); return this;
    }
    WechatTypedRequest BodyValue(string key, JsonValue fieldValue) {
        if (fieldValue != null) { this.body.Set(key, fieldValue); }
        return this;
    }
    WechatTypedRequest BodyJson(string key, string json) {
        if (json.Length > 0) { this.body.Set(key, JsonValue.Parse(json)); }
        return this;
    }

    WechatTypedRequest PathString(string key, string fieldValue) {
        this.path.Set(key, JsonValue.NewStr(fieldValue)); return this;
    }
    WechatTypedRequest PathInt(string key, int fieldValue) {
        this.path.Set(key, JsonValue.NewNum(Convert.ToString(fieldValue))); return this;
    }
    WechatTypedRequest PathLong(string key, long fieldValue) {
        this.path.Set(key, JsonValue.NewNum(Convert.ToString(fieldValue))); return this;
    }
    WechatTypedRequest PathDouble(string key, double fieldValue) {
        this.path.Set(key, JsonValue.NewNum(Convert.ToString(fieldValue))); return this;
    }
    WechatTypedRequest PathBool(string key, bool fieldValue) {
        this.path.Set(key, JsonValue.NewBool(fieldValue)); return this;
    }
    WechatTypedRequest PathValue(string key, JsonValue fieldValue) {
        if (fieldValue != null) { this.path.Set(key, fieldValue); }
        return this;
    }
    bool HasPath(string key) { return this.path.Has(key); }
    bool HasValue(string key) {
        return this.path.Has(key) || this.query.Has(key) || this.body.Has(key);
    }
    string PathText(string key) {
        JsonValue fieldValue = this.path.Get(key);
        if (fieldValue == null) { return ""; }
        return fieldValue.AsString("");
    }
    string ValueText(string key) {
        JsonValue fieldValue = this.path.Get(key);
        if (fieldValue == null) { fieldValue = this.query.Get(key); }
        if (fieldValue == null) { fieldValue = this.body.Get(key); }
        if (fieldValue == null) { return ""; }
        return fieldValue.AsString("");
    }

    WechatTypedRequest QueryString(string key, string fieldValue) {
        this.query.Set(key, JsonValue.NewStr(fieldValue)); return this;
    }
    WechatTypedRequest QueryInt(string key, int fieldValue) {
        this.query.Set(key, JsonValue.NewNum(Convert.ToString(fieldValue))); return this;
    }
    WechatTypedRequest QueryLong(string key, long fieldValue) {
        this.query.Set(key, JsonValue.NewNum(Convert.ToString(fieldValue))); return this;
    }
    WechatTypedRequest QueryDouble(string key, double fieldValue) {
        this.query.Set(key, JsonValue.NewNum(Convert.ToString(fieldValue))); return this;
    }
    WechatTypedRequest QueryBool(string key, bool fieldValue) {
        this.query.Set(key, JsonValue.NewBool(fieldValue)); return this;
    }
    WechatTypedRequest QueryStrings(string key, List<string> items) {
        JsonValue array = JsonValue.NewArray();
        int i = 0;
        while (i < items.Count) { array.Append(JsonValue.NewStr(items[i])); i = i + 1; }
        this.query.Set(key, array); return this;
    }
    WechatTypedRequest QueryInts(string key, List<int> items) {
        JsonValue array = JsonValue.NewArray();
        int i = 0;
        while (i < items.Count) { array.Append(JsonValue.NewNum(Convert.ToString(items[i]))); i = i + 1; }
        this.query.Set(key, array); return this;
    }
    WechatTypedRequest QueryLongs(string key, List<long> items) {
        JsonValue array = JsonValue.NewArray();
        int i = 0;
        while (i < items.Count) { array.Append(JsonValue.NewNum(Convert.ToString(items[i]))); i = i + 1; }
        this.query.Set(key, array); return this;
    }
    WechatTypedRequest QueryDoubles(string key, List<double> items) {
        JsonValue array = JsonValue.NewArray();
        int i = 0;
        while (i < items.Count) { array.Append(JsonValue.NewNum(Convert.ToString(items[i]))); i = i + 1; }
        this.query.Set(key, array); return this;
    }
    WechatTypedRequest QueryBools(string key, List<bool> items) {
        JsonValue array = JsonValue.NewArray();
        int i = 0;
        while (i < items.Count) { array.Append(JsonValue.NewBool(items[i])); i = i + 1; }
        this.query.Set(key, array); return this;
    }
    WechatTypedRequest QueryValue(string key, JsonValue fieldValue) {
        if (fieldValue != null) { this.query.Set(key, fieldValue); }
        return this;
    }
    WechatTypedRequest QueryJson(string key, string json) {
        if (json.Length > 0) { this.query.Set(key, JsonValue.Parse(json)); }
        return this;
    }

    string JsonBody() { return this.body.ToJson(); }

    string QueryText() {
        string result = "";
        int i = 0;
        while (i < this.query.Count()) {
            if (i > 0) { result = result + "&"; }
            JsonValue queryValue = this.query.ValAt(i);
            string raw = queryValue.AsString("");
            if (queryValue.IsArray() || queryValue.IsObject()) { raw = queryValue.ToJson(); }
            result = result + Encoding.UrlEncode(this.query.KeyAt(i))
                + "=" + Encoding.UrlEncode(raw);
            i = i + 1;
        }
        return result;
    }
}
