using System;
using System.Text;
using System.Net.Http;
using System.Net.Http.Client;
using System.Net.External;

namespace Sdk.Wechat;

/// <summary>
/// 微信各产品线共用的 HTTPS 传输层。支持 JSON、XML、multipart、二进制响应、
/// 任意请求头以及需要 PEM 客户端证书的双向 TLS。
/// </summary>
class WechatApiTransport {
    string host;
    int port;
    int timeoutMs;
    string clientCertificateFile;
    string clientPrivateKeyFile;
    ExternalCallPolicy callPolicy;

    public WechatApiTransport(string host) {
        this.host = host;
        this.port = 443;
        this.timeoutMs = 30000;
        this.clientCertificateFile = "";
        this.clientPrivateKeyFile = "";
        this.callPolicy = ExternalCallPolicy.Default();
    }

    WechatApiTransport Server(string host, int port) {
        this.host = host;
        this.port = port;
        return this;
    }

    WechatApiTransport Timeout(int ms) {
        this.timeoutMs = ms;
        return this;
    }

    WechatApiTransport SetClientCertificate(string certFile, string keyFile) {
        this.clientCertificateFile = certFile;
        this.clientPrivateKeyFile = keyFile;
        return this;
    }

    WechatApiTransport SetCallPolicy(ExternalCallPolicy policy) {
        this.callPolicy = policy == null ? ExternalCallPolicy.Default() : policy;
        return this;
    }

    ExternalCallPolicy CallPolicy() {
        return this.callPolicy;
    }

    static string BuildPath(string path, string query) {
        if (query.Length == 0) { return path; }
        if (query.StartsWith("?")) { return path + query; }
        return path + "?" + query;
    }

    static string AppendQuery(string path, string name, string tokenValue) {
        if (name.Length == 0 || tokenValue.Length == 0) { return path; }
        string sep = "?";
        for (int i = 0; i < path.Length; i = i + 1) {
            if ((path[i] & 255) == 63) { sep = "&"; break; }
        }
        return path + sep + name + "=" + Encoding.UrlEncode(tokenValue);
    }

    async WechatRawResponse RequestRawAsync(string method, string path,
                                             string body, string contentType,
                                             List<string> headers) {
        try {
            HttpClient http = HttpClient.CreateHttps(this.host, this.port);
            http.SetTimeout(this.timeoutMs);
            http.SetCallPolicy(this.callPolicy);
            if (this.clientCertificateFile.Length > 0
                && this.clientPrivateKeyFile.Length > 0) {
                http.SetClientCertificate(this.clientCertificateFile,
                                          this.clientPrivateKeyFile);
            }
            if (contentType.Length > 0) { http.SetHeader("Content-Type", contentType); }
            for (int i = 0; i < headers.Count; i = i + 1) {
                string line = headers[i];
                int colon = WechatRawResponse.IndexOf(line, ":", 0);
                if (colon > 0) {
                    string name = line.Substring(0, colon);
                    int start = colon + 1;
                    while (start < line.Length && (line[start] & 255) == 32) {
                        start = start + 1;
                    }
                    http.SetHeader(name, line.Substring(start));
                }
            }
            HttpResponse response = await http.SendAsync(method, path, body);
            return WechatRawResponse.FromHttp(response);
        } catch (Exception e) {
            throw new WechatException("client.networkError", e.Message, "");
        }
    }

    async WechatRawResponse RequestSimpleRawAsync(string method, string path,
                                                   string body, string contentType) {
        return await this.RequestRawAsync(method, path, body, contentType,
                                          new List<string>());
    }

    async WechatResponse RequestJsonAsync(string method, string path, string body) {
        string payload = body;
        if (method != "GET" && method != "DELETE" && payload.Length == 0) {
            payload = "{}";
        }
        WechatRawResponse raw = await this.RequestSimpleRawAsync(method, path, payload,
                                                                  "application/json");
        return WechatResponse.Parse(raw.Body);
    }

    async WechatRawResponse RequestMultipartAsync(string method, string path,
                                                   WechatMultipart multipart) {
        return await this.RequestSimpleRawAsync(method, path, multipart.Body(),
                                                multipart.ContentType());
    }
}
