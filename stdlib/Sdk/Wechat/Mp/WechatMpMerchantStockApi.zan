/// Generated from Senparc.Weixin.MP.AdvancedAPIs; do not hand-copy HTTP logic here.
/// </summary>
class WechatMpMerchantStockApi {
    WechatClient client;

    public WechatMpMerchantStockApi(WechatClient client) {
        this.client = client;
    }

    /// <summary>POST /merchant/stock/add</summary>
