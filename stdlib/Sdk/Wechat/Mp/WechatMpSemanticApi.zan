using System;
using Sdk.Wechat;

namespace Sdk.Wechat.Mp;

/// <summary>
/// Semantic/SemanticApi.cs 的 Zan JSON 接口。
/// 参数保持为 query / JSON，避免复制 C# SDK 的 ASP.NET、DI 和序列化实体层。
/// Generated from Senparc.Weixin.MP.AdvancedAPIs; do not hand-copy HTTP logic here.
/// </summary>
class WechatMpSemanticApi {
    WechatClient client;

    public WechatMpSemanticApi(WechatClient client) {
        this.client = client;
    }

    /// <summary>POST /semantic/semproxy/search</summary>
    async WechatResponse SemanticSendAsync(string query, string jsonBody) {
        return await WechatMpRequest.PostAsync(this.client, "/semantic/semproxy/search", query, jsonBody);
    }

}
