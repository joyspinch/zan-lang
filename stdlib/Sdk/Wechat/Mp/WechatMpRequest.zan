using System;
using Sdk.Wechat;

namespace Sdk.Wechat.Mp;

/// <summary>
/// 公众号 Advanced API 的公共 JSON 请求层。
///
/// 所有生成的模块只保存“方法名 -> HTTP verb/path”的映射；Token 缓存、HTTPS、
/// JSON 响应和微信错误码仍统一由 WechatClient / WechatResponse 处理。
/// query 不含开头的 '?'；没有 query 时传空串。
/// </summary>
class WechatMpRequest {
    static string BuildPath(string path, string query) {
        if (query.Length == 0) { return path; }
        if (query.StartsWith("?")) { return path + query; }
        return path + "?" + query;
    }

    static async WechatResponse GetAsync(WechatClient client, string path, string query) {
        return await client.GetWithTokenAsync(WechatMpRequest.BuildPath(path, query));
    }

    static async WechatResponse PostAsync(WechatClient client, string path,
                                          string query, string jsonBody) {
        string body = jsonBody;
        if (body.Length == 0) { body = "{}"; }
        return await client.PostJsonWithTokenAsync(
            WechatMpRequest.BuildPath(path, query), body);
    }
}
