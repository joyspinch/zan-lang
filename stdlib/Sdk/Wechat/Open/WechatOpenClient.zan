using System;
using Sdk.Wechat;

namespace Sdk.Wechat.Open;

/// <summary>
/// 微信开放平台 JSON API 客户端。开放平台 token 的取得依赖 verify_ticket、
/// authorizer refresh token 等业务状态，因此由调用方注入，不在传输层伪造。
/// </summary>
class WechatOpenClient {
    WechatApiTransport transport;
    string componentAccessToken;
    string authorizerAccessToken;

    public WechatOpenClient() {
        this.transport = new WechatApiTransport("api.weixin.qq.com");
        this.componentAccessToken = "";
        this.authorizerAccessToken = "";
    }

    WechatOpenClient Server(string host, int port) {
        this.transport.Server(host, port);
        return this;
    }

    WechatOpenClient Timeout(int ms) {
        this.transport.Timeout(ms);
        return this;
    }

    WechatOpenClient SetComponentAccessToken(string token) {
        this.componentAccessToken = token;
        return this;
    }

    WechatOpenClient SetAuthorizerAccessToken(string token) {
        this.authorizerAccessToken = token;
        return this;
    }

    /// <summary>SetAuthorizerAccessToken 的通用别名，也可注入 OAuth access_token。</summary>
    WechatOpenClient SetAccessToken(string token) {
        this.authorizerAccessToken = token;
        return this;
    }

    string Credential(WechatCredentialKind kind) {
        if (kind == WechatCredentialKind.None) { return ""; }
        if (kind == WechatCredentialKind.ComponentAccessToken) {
            if (this.componentAccessToken.Length == 0) {
                throw new WechatException("open.tokenMissing", "请先设置 component_access_token", "");
            }
            return this.componentAccessToken;
        }
        if (kind == WechatCredentialKind.AuthorizerAccessToken
            || kind == WechatCredentialKind.AccessToken) {
            if (this.authorizerAccessToken.Length == 0) {
                throw new WechatException("open.tokenMissing", "请先设置 authorizer access_token", "");
            }
            return this.authorizerAccessToken;
        }
        throw new WechatException("open.tokenUnsupported", "当前客户端不支持此凭证类型", "");
    }

    async WechatResponse RequestAsync(string method, string path, string query,
                                      string jsonBody, WechatCredentialKind credential) {
        string target = WechatApiTransport.BuildPath(path, query);
        string token = this.Credential(credential);
        target = WechatApiTransport.AppendQuery(target, WechatCredential.QueryName(credential), token);
        return await this.transport.RequestJsonAsync(method, target, jsonBody);
    }

    async WechatRawResponse RequestRawAsync(string method, string path,
                                             string query, string body,
                                             string contentType,
                                             WechatCredentialKind credential) {
        string target = WechatApiTransport.BuildPath(path, query);
        string token = this.Credential(credential);
        target = WechatApiTransport.AppendQuery(target, WechatCredential.QueryName(credential), token);
        return await this.transport.RequestSimpleRawAsync(method, target, body, contentType);
    }

    async WechatRawResponse RequestMultipartAsync(string method, string path,
                                                   string query,
                                                   WechatMultipart multipart,
                                                   WechatCredentialKind credential) {
        string target = WechatApiTransport.BuildPath(path, query);
        string token = this.Credential(credential);
        target = WechatApiTransport.AppendQuery(target, WechatCredential.QueryName(credential), token);
        return await this.transport.RequestMultipartAsync(method, target, multipart);
    }
}
