using System;
using Sdk.Wechat;

namespace Sdk.Wechat.Open;

/// <summary>
/// WxaAPIs/Sec/SecApi.cs 的 Zan JSON 接口。
/// query / JSON 参数由调用方提供；token 和网络传输由产品客户端统一处理。
/// Generated from Senparc WeChat product APIs; regenerate with scripts/generate_wechat_product_apis.py.
/// </summary>
class WechatOpenSecApi {
    WechatOpenClient client;

    public WechatOpenSecApi(WechatOpenClient client) {
        this.client = client;
    }

    /// <summary>POST /wxa/sec/wxaauth</summary>
    async WechatResponse WxaAuthAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/wxa/sec/wxaauth", query, jsonBody, "access_token");
    }

    /// <summary>POST /wxa/sec/queryauth</summary>
    async WechatResponse QueryAuthAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/wxa/sec/queryauth", query, jsonBody, "access_token");
    }

    /// <summary>POST /wxa/sec/reauth</summary>
    async WechatResponse ReauthAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/wxa/sec/reauth", query, jsonBody, "access_token");
    }

    /// <summary>POST /wxa/sec/authidentitytree</summary>
    async WechatResponse AuthIdentityTreeAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/wxa/sec/authidentitytree", query, jsonBody, "access_token");
    }

}
