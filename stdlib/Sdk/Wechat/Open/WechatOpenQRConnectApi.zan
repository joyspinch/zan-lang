using System;
using Sdk.Wechat;

namespace Sdk.Wechat.Open;

/// <summary>
/// QRConnect/QRConnectAPI.cs 的 Zan JSON 接口。
/// query / JSON 参数由调用方提供；token 和网络传输由产品客户端统一处理。
/// Generated from Senparc WeChat product APIs; regenerate with scripts/generate_wechat_product_apis.py.
/// </summary>
class WechatOpenQRConnectApi {
    WechatOpenClient client;

    public WechatOpenQRConnectApi(WechatOpenClient client) {
        this.client = client;
    }

    /// <summary>GET /sns/oauth2/access_token</summary>
    async WechatResponse GetAccessTokenAsync(string query) {
        return await this.client.RequestAsync("GET", "/sns/oauth2/access_token", query, "", "");
    }

    /// <summary>GET /sns/oauth2/refresh_token</summary>
    async WechatResponse RefreshTokenAsync(string query) {
        return await this.client.RequestAsync("GET", "/sns/oauth2/refresh_token", query, "", "");
    }

    /// <summary>GET /sns/userinfo</summary>
    async WechatResponse GetUserInfoAsync(string query) {
        return await this.client.RequestAsync("GET", "/sns/userinfo", query, "", "access_token");
    }

    /// <summary>GET /sns/auth</summary>
    async WechatResponse AuthAsync(string query) {
        return await this.client.RequestAsync("GET", "/sns/auth", query, "", "access_token");
    }

}
