using System;
using Sdk.Wechat;

namespace Sdk.Wechat.Open;

/// <summary>
/// OAuthAPIs/OAuthAPI.cs 的 Zan JSON 接口。
/// query / JSON 参数由调用方提供；token 和网络传输由产品客户端统一处理。
/// Generated from Senparc WeChat product APIs; regenerate with scripts/generate_wechat_product_apis.py.
/// </summary>
class WechatOpenOAuthApi {
    WechatOpenClient client;

    public WechatOpenOAuthApi(WechatOpenClient client) {
        this.client = client;
    }

    /// <summary>GET /sns/oauth2/component/access_token</summary>
    async WechatResponse GetAccessTokenAsync(string query) {
        return await this.client.RequestAsync("GET", "/sns/oauth2/component/access_token", query, "", "component_access_token");
    }

    /// <summary>GET /sns/oauth2/component/refresh_token</summary>
    async WechatResponse RefreshTokenAsync(string query) {
        return await this.client.RequestAsync("GET", "/sns/oauth2/component/refresh_token", query, "", "component_access_token");
    }

    /// <summary>GET /sns/userinfo</summary>
    async WechatResponse GetUserInfoAsync(string query) {
        return await this.client.RequestAsync("GET", "/sns/userinfo", query, "", "access_token");
    }

}
