using System;
using System.Text;
using System.Json;
using Sdk.Wechat;

namespace Sdk.Wechat.Open;

class WechatOpenSpecialQrCodeRequest {
    WechatTypedRequest request;
    public WechatOpenSpecialQrCodeRequest() { this.request = new WechatTypedRequest(); }
    WechatOpenSpecialQrCodeRequest Path(string fieldValue) {
        this.request.QueryString("path", fieldValue); return this;
    }
    string QueryText() { return this.request.QueryText(); }
}

class WechatOpenSpecialLibraryListRequest {
    WechatTypedRequest request;
    public WechatOpenSpecialLibraryListRequest() { this.request = new WechatTypedRequest(); }
    WechatOpenSpecialLibraryListRequest Offset(int fieldValue) { this.request.BodyInt("offset", fieldValue); return this; }
    WechatOpenSpecialLibraryListRequest Count(int fieldValue) { this.request.BodyInt("count", fieldValue); return this; }
    string JsonBody() { return this.request.JsonBody(); }
}
class WechatOpenSpecialLibraryListResponse {
    public string Raw;
    public int total_count;
    public JsonValue list;
}

class WechatOpenSpecialLibraryGetRequest {
    WechatTypedRequest request;
    public WechatOpenSpecialLibraryGetRequest() { this.request = new WechatTypedRequest(); }
    WechatOpenSpecialLibraryGetRequest Id(string fieldValue) { this.request.BodyString("id", fieldValue); return this; }
    string JsonBody() { return this.request.JsonBody(); }
}
class WechatOpenSpecialLibraryGetResponse {
    public string Raw;
    public string id;
    public string title;
    public JsonValue keyword_list;
}

class WechatOpenSpecialTemplateAddRequest {
    WechatTypedRequest request;
    public WechatOpenSpecialTemplateAddRequest() { this.request = new WechatTypedRequest(); }
    WechatOpenSpecialTemplateAddRequest Id(string fieldValue) { this.request.BodyString("id", fieldValue); return this; }
    WechatOpenSpecialTemplateAddRequest KeywordIdList(List<int> fieldValue) { this.request.BodyInts("keyword_id_list", fieldValue); return this; }
    string JsonBody() { return this.request.JsonBody(); }
}
class WechatOpenSpecialTemplateAddResponse { public string Raw; public string template_id; }

class WechatOpenSpecialTemplateListRequest {
    WechatTypedRequest request;
    public WechatOpenSpecialTemplateListRequest() { this.request = new WechatTypedRequest(); }
    WechatOpenSpecialTemplateListRequest Offset(int fieldValue) { this.request.BodyInt("offset", fieldValue); return this; }
    WechatOpenSpecialTemplateListRequest Count(int fieldValue) { this.request.BodyInt("count", fieldValue); return this; }
    string JsonBody() { return this.request.JsonBody(); }
}
class WechatOpenSpecialTemplateListResponse {
    public string Raw;
    public int total_count;
    public JsonValue list;
}

class WechatOpenSpecialTemplateDeleteRequest {
    WechatTypedRequest request;
    public WechatOpenSpecialTemplateDeleteRequest() { this.request = new WechatTypedRequest(); }
    WechatOpenSpecialTemplateDeleteRequest TemplateId(string fieldValue) { this.request.BodyString("template_id", fieldValue); return this; }
    string JsonBody() { return this.request.JsonBody(); }
}
class WechatOpenSpecialOperationResponse { public string Raw; }

/// <summary>开放平台文件上传、媒体下载和兼容模板接口。</summary>
class WechatOpenSpecialApi {
    WechatOpenClient client;
    public WechatOpenSpecialApi(WechatOpenClient client) { this.client = client; }

    async WechatResponse UploadPrivacyExtFileAsync(string fileName,
                                                   string contentType,
                                                   string fileBytes) {
        return await this.UploadAsync("/cgi-bin/component/uploadprivacyextfile",
            "file", fileName, contentType, fileBytes, WechatCredentialKind.ComponentAccessToken);
    }

    async WechatRawResponse GetQRCodeAsync(WechatOpenSpecialQrCodeRequest request) {
        return await this.client.RequestRawAsync("GET", "/wxa/get_qrcode", request.QueryText(),
            "", "", WechatCredentialKind.AuthorizerAccessToken);
    }

    async WechatRawResponse GetQRCodeRawAsync(string query) {
        return await this.client.RequestRawAsync("GET", "/wxa/get_qrcode", query,
            "", "", WechatCredentialKind.AuthorizerAccessToken);
    }

    async WechatResponse UploadMediaAsync(string fileName, string contentType,
                                          string fileBytes) {
        return await this.UploadAsync("/wxa/uploadmedia", "media", fileName,
            contentType, fileBytes, WechatCredentialKind.AuthorizerAccessToken);
    }

    async WechatResponse UploadIcpMediaAsync(string type, string icpOrderField,
                                             int certificateType,
                                             string fileName,
                                             string contentType,
                                             string fileBytes) {
        WechatMultipart form = new WechatMultipart();
        form.AddField("type", type);
        form.AddField("icp_order_field", icpOrderField);
        if (certificateType >= 0) {
            form.AddField("certificate_type", Convert.ToString(certificateType));
        }
        form.AddFile("media", fileName, contentType, fileBytes);
        WechatRawResponse raw = await this.client.RequestMultipartAsync("POST",
            "/wxa/icp/upload_icp_media", "", form, WechatCredentialKind.AuthorizerAccessToken);
        return raw.Json();
    }

    async WechatRawResponse GetIcpMediaAsync(string mediaId) {
        return await this.client.RequestRawAsync("GET", "/wxa/icp/get_icp_media",
            "media_id=" + Encoding.UrlEncode(mediaId), "", "", WechatCredentialKind.AuthorizerAccessToken);
    }

    async WechatResponse UploadAuthMaterialAsync(string fileName,
                                                 string contentType,
                                                 string fileBytes) {
        return await this.UploadAsync("/wxa/sec/uploadauthmaterial", "media",
            fileName, contentType, fileBytes, WechatCredentialKind.AuthorizerAccessToken);
    }

    async WechatResponse UploadWxaMediaAsync(string fileName, string contentType,
                                             string fileBytes) {
        return await this.UploadMediaAsync(fileName, contentType, fileBytes);
    }

    async WechatResponse UploadAsync(string path, string fieldName,
                                     string fileName, string contentType,
                                     string fileBytes, WechatCredentialKind credential) {
        WechatMultipart form = new WechatMultipart();
        form.AddFile(fieldName, fileName, contentType, fileBytes);
        WechatRawResponse raw = await this.client.RequestMultipartAsync("POST",
            path, "", form, credential);
        return raw.Json();
    }

    // Senparc Open 中的这五个入口在原命名空间已 obsolete；这里直接调用真实端点。
    async WechatOpenSpecialLibraryListResponse LibraryListAsync(WechatOpenSpecialLibraryListRequest request) {
        WechatResponse raw = await this.client.RequestAsync("POST",
            "/cgi-bin/wxopen/template/library/list", "", request.JsonBody(), WechatCredentialKind.AuthorizerAccessToken);
        WechatOpenSpecialLibraryListResponse result = Json.Deserialize<WechatOpenSpecialLibraryListResponse>(raw.Raw);
        result.Raw = raw.Raw; return result;
    }
    async WechatOpenSpecialLibraryGetResponse LibraryGetAsync(WechatOpenSpecialLibraryGetRequest request) {
        WechatResponse raw = await this.client.RequestAsync("POST",
            "/cgi-bin/wxopen/template/library/get", "", request.JsonBody(), WechatCredentialKind.AuthorizerAccessToken);
        WechatOpenSpecialLibraryGetResponse result = Json.Deserialize<WechatOpenSpecialLibraryGetResponse>(raw.Raw);
        result.Raw = raw.Raw; return result;
    }
    async WechatOpenSpecialTemplateAddResponse AddAsync(WechatOpenSpecialTemplateAddRequest request) {
        WechatResponse raw = await this.client.RequestAsync("POST",
            "/cgi-bin/wxopen/template/add", "", request.JsonBody(), WechatCredentialKind.AuthorizerAccessToken);
        WechatOpenSpecialTemplateAddResponse result = Json.Deserialize<WechatOpenSpecialTemplateAddResponse>(raw.Raw);
        result.Raw = raw.Raw; return result;
    }
    async WechatOpenSpecialTemplateListResponse ListAsync(WechatOpenSpecialTemplateListRequest request) {
        WechatResponse raw = await this.client.RequestAsync("POST",
            "/cgi-bin/wxopen/template/list", "", request.JsonBody(), WechatCredentialKind.AuthorizerAccessToken);
        WechatOpenSpecialTemplateListResponse result = Json.Deserialize<WechatOpenSpecialTemplateListResponse>(raw.Raw);
        result.Raw = raw.Raw; return result;
    }
    async WechatOpenSpecialOperationResponse DelAsync(WechatOpenSpecialTemplateDeleteRequest request) {
        WechatResponse raw = await this.client.RequestAsync("POST",
            "/cgi-bin/wxopen/template/del", "", request.JsonBody(), WechatCredentialKind.AuthorizerAccessToken);
        WechatOpenSpecialOperationResponse result = new WechatOpenSpecialOperationResponse();
        result.Raw = raw.Raw; return result;
    }

    async WechatResponse LibraryListRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/cgi-bin/wxopen/template/library/list", query, jsonBody, WechatCredentialKind.AuthorizerAccessToken);
    }
    async WechatResponse LibraryGetRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/cgi-bin/wxopen/template/library/get", query, jsonBody, WechatCredentialKind.AuthorizerAccessToken);
    }
    async WechatResponse AddRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/cgi-bin/wxopen/template/add", query, jsonBody, WechatCredentialKind.AuthorizerAccessToken);
    }
    async WechatResponse ListRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/cgi-bin/wxopen/template/list", query, jsonBody, WechatCredentialKind.AuthorizerAccessToken);
    }
    async WechatResponse DelRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/cgi-bin/wxopen/template/del", query, jsonBody, WechatCredentialKind.AuthorizerAccessToken);
    }

}
