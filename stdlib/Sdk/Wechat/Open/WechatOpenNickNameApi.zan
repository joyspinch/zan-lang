using System;
using Sdk.Wechat;

namespace Sdk.Wechat.Open;

/// <summary>
/// WxaAPIs/NickName/NickNameApi.cs 的 Zan JSON 接口。
/// query / JSON 参数由调用方提供；token 和网络传输由产品客户端统一处理。
/// Generated from Senparc WeChat product APIs; regenerate with scripts/generate_wechat_product_apis.py.
/// </summary>
class WechatOpenNickNameApi {
    WechatOpenClient client;

    public WechatOpenNickNameApi(WechatOpenClient client) {
        this.client = client;
    }

    /// <summary>POST /wxa/setnickname</summary>
    async WechatResponse SetNickNameAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/wxa/setnickname", query, jsonBody, "access_token");
    }

    /// <summary>POST /wxa/api_wxa_querynickname</summary>
    async WechatResponse QueryNickNameAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/wxa/api_wxa_querynickname", query, jsonBody, "access_token");
    }

    /// <summary>POST /cgi-bin/wxverify/checkwxverifynickname</summary>
    async WechatResponse CheckWxVerifyNickNameAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/cgi-bin/wxverify/checkwxverifynickname", query, jsonBody, "access_token");
    }

}
