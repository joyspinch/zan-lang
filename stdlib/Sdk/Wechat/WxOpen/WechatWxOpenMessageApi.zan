using System;
using Sdk.Wechat;

namespace Sdk.Wechat.WxOpen;

/// <summary>
/// Message/MessageApi.cs 的 Zan JSON 接口。
/// query / JSON 参数由调用方提供；token 和网络传输由产品客户端统一处理。
/// Generated from Senparc WeChat product APIs; regenerate with scripts/generate_wechat_product_apis.py.
/// </summary>
class WechatWxOpenMessageApi {
    WechatWxOpenClient client;

    public WechatWxOpenMessageApi(WechatWxOpenClient client) {
        this.client = client;
    }

    /// <summary>POST /cgi-bin/message/subscribe/send</summary>
    async WechatResponse SendSubscribeAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/cgi-bin/message/subscribe/send", query, jsonBody, "access_token");
    }

    /// <summary>POST /cgi-bin/message/wxopen/employeerelationmsg/send</summary>
    async WechatResponse SendEmployeeRelationMessageAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/cgi-bin/message/wxopen/employeerelationmsg/send", query, jsonBody, "access_token");
    }

}
