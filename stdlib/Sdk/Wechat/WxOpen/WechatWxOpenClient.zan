using System;
using System.Text;
using Sdk.Wechat;

namespace Sdk.Wechat.WxOpen;

/// <summary>微信小程序 JSON API 客户端，自动缓存小程序 access_token。</summary>
class WechatWxOpenClient {
    WechatApiTransport transport;
    string appId;
    string appSecret;
    string accessToken;
    long accessTokenExpireUnix;

    public WechatWxOpenClient(string appId, string appSecret) {
        this.transport = new WechatApiTransport("api.weixin.qq.com");
        this.appId = appId;
        this.appSecret = appSecret;
        this.accessToken = "";
        this.accessTokenExpireUnix = 0;
    }

    WechatWxOpenClient Server(string host, int port) {
        this.transport.Server(host, port);
        return this;
    }

    WechatWxOpenClient Timeout(int ms) {
        this.transport.Timeout(ms);
        return this;
    }

    WechatWxOpenClient SetAccessToken(string token, int expiresIn) {
        this.accessToken = token;
        int life = expiresIn - 300;
        if (life < 0) { life = 0; }
        this.accessTokenExpireUnix = DateTime.UtcNow().ToUnixSeconds() + life;
        return this;
    }

    async string GetAccessTokenAsync() {
        if (this.accessToken.Length > 0
            && DateTime.UtcNow().ToUnixSeconds() < this.accessTokenExpireUnix) {
            return this.accessToken;
        }
        if (this.appId.Length == 0 || this.appSecret.Length == 0) {
            throw new WechatException("wxopen.paramError", "appId / appSecret 不能为空", "");
        }
        string path = "/cgi-bin/token?grant_type=client_credential"
            + "&appid=" + Encoding.UrlEncode(this.appId)
            + "&secret=" + Encoding.UrlEncode(this.appSecret);
        WechatResponse response = await this.transport.RequestJsonAsync("GET", path, "");
        string token = response.Str("access_token", "");
        if (token.Length == 0) {
            throw new WechatException("wxopen.badResponse", "响应缺少 access_token", response.Data);
        }
        this.SetAccessToken(token, response.Int("expires_in", 7200));
        return this.accessToken;
    }

    async WechatResponse RequestAsync(string method, string path, string query,
                                      string jsonBody, string credentialName) {
        string target = WechatApiTransport.BuildPath(path, query);
        if (credentialName.Length > 0) {
            if (credentialName != "access_token") {
                throw new WechatException("wxopen.tokenUnsupported",
                    "不支持的凭证参数：" + credentialName, "");
            }
            string token = await this.GetAccessTokenAsync();
            target = WechatApiTransport.AppendQuery(target, credentialName, token);
        }
        return await this.transport.RequestJsonAsync(method, target, jsonBody);
    }

    async WechatRawResponse RequestRawAsync(string method, string path,
                                             string query, string body,
                                             string contentType,
                                             string credentialName) {
        string target = WechatApiTransport.BuildPath(path, query);
        if (credentialName.Length > 0) {
            string token = await this.GetAccessTokenAsync();
            target = WechatApiTransport.AppendQuery(target, credentialName, token);
        }
        return await this.transport.RequestSimpleRawAsync(method, target, body, contentType);
    }

    async WechatRawResponse RequestMultipartAsync(string method, string path,
                                                   string query,
                                                   WechatMultipart multipart,
                                                   string credentialName) {
        string target = WechatApiTransport.BuildPath(path, query);
        if (credentialName.Length > 0) {
            string token = await this.GetAccessTokenAsync();
            target = WechatApiTransport.AppendQuery(target, credentialName, token);
        }
        return await this.transport.RequestMultipartAsync(method, target, multipart);
    }
}
