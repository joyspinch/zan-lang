/// Generated from Senparc WeChat product APIs; regenerate with scripts/generate_wechat_product_apis.py.
/// </summary>
class WechatWxOpenCustomApi {
    WechatWxOpenClient client;

    public WechatWxOpenCustomApi(WechatWxOpenClient client) {
        this.client = client;
    }

    /// <summary>POST /cgi-bin/message/custom/send</summary>
    async WechatResponse SendImageAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/cgi-bin/message/custom/send", query, jsonBody, "access_token");
    }

    /// <summary>POST /cgi-bin/message/custom/send</summary>
    async WechatResponse SendLinkAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/cgi-bin/message/custom/send", query, jsonBody, "access_token");
    }

    /// <summary>POST /cgi-bin/message/custom/send</summary>
    async WechatResponse SendMiniProgramPageAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/cgi-bin/message/custom/send", query, jsonBody, "access_token");
    }

}
