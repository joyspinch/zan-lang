/// Generated from Senparc WeChat product APIs; regenerate with scripts/generate_wechat_product_apis.py.
/// </summary>
class WechatWxOpenStudentApi {
    WechatWxOpenClient client;

    public WechatWxOpenStudentApi(WechatWxOpenClient client) {
        this.client = client;
    }

    /// <summary>POST /intp/quickcheckstudentidentity</summary>
