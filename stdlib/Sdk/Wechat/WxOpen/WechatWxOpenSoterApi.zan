using System;
using Sdk.Wechat;

namespace Sdk.Wechat.WxOpen;

/// <summary>
/// Soter/SoterApi.cs 的 Zan JSON 接口。
/// query / JSON 参数由调用方提供；token 和网络传输由产品客户端统一处理。
/// Generated from Senparc WeChat product APIs; regenerate with scripts/generate_wechat_product_apis.py.
/// </summary>
class WechatWxOpenSoterApi {
    WechatWxOpenClient client;

    public WechatWxOpenSoterApi(WechatWxOpenClient client) {
        this.client = client;
    }

    /// <summary>POST /cgi-bin/soter/verify_signature</summary>
    async WechatResponse VerifySignatureAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/cgi-bin/soter/verify_signature", query, jsonBody, "access_token");
    }

}
