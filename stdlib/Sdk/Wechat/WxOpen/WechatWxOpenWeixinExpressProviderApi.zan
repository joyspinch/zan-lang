using System;
using Sdk.Wechat;

namespace Sdk.Wechat.WxOpen;

/// <summary>
/// WeixinExpress/WeixinExpressProviderApi.cs 的 Zan JSON 接口。
/// query / JSON 参数由调用方提供；token 和网络传输由产品客户端统一处理。
/// Generated from Senparc WeChat product APIs; regenerate with scripts/generate_wechat_product_apis.py.
/// </summary>
class WechatWxOpenWeixinExpressProviderApi {
    WechatWxOpenClient client;

    public WechatWxOpenWeixinExpressProviderApi(WechatWxOpenClient client) {
        this.client = client;
    }

    /// <summary>POST /cgi-bin/express/delivery/userquery</summary>
    async WechatResponse QueryUserBindingAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/cgi-bin/express/delivery/userquery", query, jsonBody, "access_token");
    }

    /// <summary>POST /cgi-bin/express/delivery/pathnotify</summary>
    async WechatResponse NotifyPathAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/cgi-bin/express/delivery/pathnotify", query, jsonBody, "access_token");
    }

}
