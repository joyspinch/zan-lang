using System;
using System.Text;
using Sdk.Wechat;

namespace Sdk.Wechat.WxOpen;

/// <summary>小程序客服动态路径、文件上传、媒体下载和二维码二进制接口。</summary>
class WechatWxOpenSpecialApi {
    WechatWxOpenClient client;
    public WechatWxOpenSpecialApi(WechatWxOpenClient client) { this.client = client; }

    async WechatResponse SendTextAsync(string businessId, string jsonBody) {
        string path = "/cgi-bin/message/custom/send";
        if (businessId.Length > 0) { path = "/cgi-bin/message/custom/business/send"; }
        return await this.client.RequestAsync("POST", path, "", jsonBody, "access_token");
    }

    async WechatResponse GetTypingStatusAsync(string businessId, string jsonBody) {
        string path = "/cgi-bin/message/custom/typing";
        if (businessId.Length > 0) { path = "/cgi-bin/message/custom/business/typing"; }
        return await this.client.RequestAsync("POST", path, "", jsonBody, "access_token");
    }

    async WechatResponse AiCropAsync(string imgUrl, string ratios) {
        string query = "img_url=" + Encoding.UrlEncode(imgUrl);
        if (ratios.Length == 0) {
            return await this.client.RequestAsync("POST", "/cv/img/aicrop", query,
                                                  "{}", "access_token");
        }
        WechatMultipart form = new WechatMultipart();
        form.AddField("ratios", ratios);
        WechatRawResponse raw = await this.client.RequestMultipartAsync("POST",
            "/cv/img/aicrop", query, form, "access_token");
        return raw.Json();
    }

    async WechatResponse AiCropByFileAsync(string ratios, string fileName,
                                            string contentType, string fileBytes) {
        WechatMultipart form = new WechatMultipart();
        if (ratios.Length > 0) { form.AddField("ratios", ratios); }
        form.AddFile("img", fileName, contentType, fileBytes);
        WechatRawResponse raw = await this.client.RequestMultipartAsync("POST",
            "/cv/img/aicrop", "", form, "access_token");
        return raw.Json();
    }

    async WechatResponse QrCodeAsync(string imgUrl) {
        return await this.client.RequestAsync("POST", "/cv/img/qrcode",
            "img_url=" + Encoding.UrlEncode(imgUrl), "{}", "access_token");
    }

    async WechatResponse QrCodeByFileAsync(string fileName, string contentType,
                                            string fileBytes) {
        return await this.SendCvFileAsync("/cv/img/qrcode", fileName,
                                          contentType, fileBytes);
    }

    async WechatResponse SuperResolutionAsync(string imgUrl) {
        return await this.client.RequestAsync("POST", "/cv/img/superresolution",
            "img_url=" + Encoding.UrlEncode(imgUrl), "{}", "access_token");
    }

    async WechatResponse SuperResolutionByFileAsync(string fileName,
                                                     string contentType,
                                                     string fileBytes) {
        return await this.SendCvFileAsync("/cv/img/superresolution", fileName,
                                          contentType, fileBytes);
    }

    async WechatResponse DrivingLicenseAsync(string imgUrl) {
        return await this.client.RequestAsync("POST", "/cv/ocr/drivinglicense",
            "img_url=" + Encoding.UrlEncode(imgUrl), "{}", "access_token");
    }

    async WechatResponse DrivingLicenseByFileAsync(string fileName,
                                                    string contentType,
                                                    string fileBytes) {
        return await this.SendCvFileAsync("/cv/ocr/drivinglicense", fileName,
                                          contentType, fileBytes);
    }

    async WechatResponse SendCvFileAsync(string path, string fileName,
                                         string contentType, string fileBytes) {
        WechatMultipart form = new WechatMultipart();
        form.AddFile("img", fileName, contentType, fileBytes);
        WechatRawResponse raw = await this.client.RequestMultipartAsync("POST",
            path, "", form, "access_token");
        return raw.Json();
    }

    async WechatRawResponse GetBillAsync(string jsonBody) {
        return await this.client.RequestRawAsync("POST",
            "/cgi-bin/express/delivery/single_waybill/get_bill", "", jsonBody,
            "application/json; charset=utf-8", "access_token");
    }

    async WechatResponse SingleFileUploadAsync(string mediaName,
                                                string mediaType,
                                                string mediaFileName,
                                                string mediaContentType,
                                                string mediaBytes,
                                                string coverType,
                                                string coverFileName,
                                                string coverContentType,
                                                string coverBytes,
                                                string sourceContext) {
        WechatMultipart form = new WechatMultipart();
        form.AddField("media_name", mediaName);
        form.AddField("media_type", mediaType);
        if (coverType.Length > 0) { form.AddField("cover_type", coverType); }
        if (sourceContext.Length > 0) { form.AddField("source_context", sourceContext); }
        form.AddFile("media_data", mediaFileName, mediaContentType, mediaBytes);
        if (coverFileName.Length > 0) {
            form.AddFile("cover_data", coverFileName, coverContentType, coverBytes);
        }
        WechatRawResponse raw = await this.client.RequestMultipartAsync("POST",
            "/wxa/sec/vod/singlefileupload", "", form, "access_token");
        return raw.Json();
    }

    async WechatResponse UploadPartAsync(string uploadId, int partNumber,
                                         int resourceType, string fileName,
                                         string contentType, string fileBytes) {
        WechatMultipart form = new WechatMultipart();
        form.AddField("upload_id", uploadId);
        form.AddField("part_number", Convert.ToString(partNumber));
        form.AddField("resource_type", Convert.ToString(resourceType));
        form.AddFile("data", fileName, contentType, fileBytes);
        WechatRawResponse raw = await this.client.RequestMultipartAsync("POST",
            "/wxa/sec/vod/uploadpart", "", form, "access_token");
        return raw.Json();
    }

    async WechatRawResponse GetFeedbackMediaAsync(long recordId, string mediaId) {
        string query = "record_id=" + Convert.ToString(recordId)
            + "&media_id=" + Encoding.UrlEncode(mediaId);
        return await this.client.RequestRawAsync("GET",
            "/cgi-bin/media/getfeedbackmedia", query, "", "", "access_token");
    }

    async WechatRawResponse GetWxaCodeAsync(string jsonBody) {
        return await this.client.RequestRawAsync("POST", "/wxa/getwxacode", "",
            jsonBody, "application/json", "access_token");
    }

    async WechatRawResponse GetWxaCodeUnlimitAsync(string jsonBody) {
        return await this.client.RequestRawAsync("POST", "/wxa/getwxacodeunlimit",
            "", jsonBody, "application/json", "access_token");
    }

    async WechatRawResponse CreateWxQrCodeAsync(string jsonBody) {
        return await this.client.RequestRawAsync("POST",
            "/cgi-bin/wxaapp/createwxaqrcode", "", jsonBody,
            "application/json", "access_token");
    }

    async WechatResponse ImgSecCheckAsync(string fileName, string contentType,
                                          string fileBytes) {
        WechatMultipart form = new WechatMultipart();
        form.AddFile("media", fileName, contentType, fileBytes);
        WechatRawResponse raw = await this.client.RequestMultipartAsync("POST",
            "/wxa/img_sec_check", "", form, "access_token");
        return raw.Json();
    }
}
