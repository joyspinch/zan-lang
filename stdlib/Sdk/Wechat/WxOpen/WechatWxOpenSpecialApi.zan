    WechatWxOpenSpecialWxaCodeRequest Width(int fieldValue) { this.request.BodyInt("width", fieldValue); return this; }
    WechatWxOpenSpecialWxaCodeRequest AutoColor(bool fieldValue) { this.request.BodyBool("auto_color", fieldValue); return this; }
    WechatWxOpenSpecialWxaCodeRequest LineColor(JsonValue fieldValue) { this.request.BodyValue("line_color", fieldValue); return this; }
    WechatWxOpenSpecialWxaCodeRequest IsHyaline(bool fieldValue) { this.request.BodyBool("is_hyaline", fieldValue); return this; }
    string JsonBody() { return this.request.JsonBody(); }
}

