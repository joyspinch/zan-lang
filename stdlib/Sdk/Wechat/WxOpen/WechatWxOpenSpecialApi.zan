    public WechatWxOpenSpecialTypingRequest() {
        this.request = new WechatTypedRequest(); this.businessId = "";
    }
    WechatWxOpenSpecialTypingRequest OpenId(string fieldValue) {
        this.request.BodyString("touser", fieldValue); return this;
    }
    WechatWxOpenSpecialTypingRequest Command(string fieldValue) {
        this.request.BodyString("command", fieldValue); return this;
    }
    WechatWxOpenSpecialTypingRequest BusinessId(string fieldValue) {
        this.businessId = fieldValue;
        if (fieldValue.Length > 0) { this.request.BodyString("businessid", fieldValue); }
        return this;
    }
    string Path() {
        if (this.businessId.Length > 0) { return "/cgi-bin/message/custom/business/typing"; }
        return "/cgi-bin/message/custom/typing";
    }
    string JsonBody() { return this.request.JsonBody(); }
}

