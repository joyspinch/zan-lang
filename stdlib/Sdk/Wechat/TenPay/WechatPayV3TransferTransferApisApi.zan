using System;
using Sdk.Wechat;

namespace Sdk.Wechat.TenPay;

/// <summary>
/// Transfer/TransferApis.cs 的 Zan 微信支付接口。
/// 商户号、私钥、证书和 API 密钥由产品客户端配置统一提供。
/// Generated from Senparc WeChat Pay APIs; regenerate with scripts/generate_wechat_tenpay_apis.py.
/// </summary>
class WechatPayV3TransferTransferApisApi {
    WechatPayV3Client client;

    public WechatPayV3TransferTransferApisApi(WechatPayV3Client client) { this.client = client; }

    /// <summary>POST /transfer/batches; C# 参数：BatchesRequestData data, int timeOut = Config.TIME_OUT</summary>
    async WechatRawResponse BatchesAsync(string query, string jsonBody) {
        return await this.client.RequestJsonAsync("POST", "/transfer/batches", query, jsonBody);
    }

}
