using System;
using Sdk.Wechat;

namespace Sdk.Wechat.TenPay;

/// <summary>
/// TenPay.cs 的 Zan 微信支付接口。
/// 商户号、私钥、证书和 API 密钥由产品客户端配置统一提供。
/// Generated from Senparc WeChat Pay APIs; regenerate with scripts/generate_wechat_tenpay_apis.py.
/// </summary>
class WechatPayLegacyTenPayApi {
    WechatPayLegacyMpClient client;

    public WechatPayLegacyTenPayApi(WechatPayLegacyMpClient client) { this.client = client; }

    /// <summary>POST /pay/delivernotify; C# 参数：string appId, string accessToken,string openId, string transId, string out_Trade_No, string deliver_TimesTamp, string deliver_Status, string deliver_Msg, string app_Signature, string sign_Method = "sha1"</summary>
    async WechatRawResponse DelivernotifyAsync(string query, string jsonBody) {
        return await this.client.RequestJsonAsync("POST", "/pay/delivernotify", query, jsonBody);
    }

    /// <summary>POST /pay/orderquery; C# 参数：string appId, string accessToken, string package, string timesTamp, string app_Signature, string sign_Method</summary>
    async WechatRawResponse OrderqueryAsync(string query, string jsonBody) {
        return await this.client.RequestJsonAsync("POST", "/pay/orderquery", query, jsonBody);
    }

}
