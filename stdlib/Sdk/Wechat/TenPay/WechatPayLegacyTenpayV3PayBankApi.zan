        return await this.client.RequestAsync("/mmpaysptrans/pay_bank", request, true);
    }

    /// <summary>POST /mmpaysptrans/query_bank; C# 参数：IServiceProvider serviceProvider, TenPayV3QueryBankRequestData dataInfo, #if NET462 string cert, string certPassword, #endif int timeOut = Config.TIME_OUT</summary>
