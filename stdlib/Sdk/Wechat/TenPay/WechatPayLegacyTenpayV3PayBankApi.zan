    /// <summary>POST /mmpaysptrans/pay_bank; C# 参数：IServiceProvider serviceProvider, TenPayV3PayBankRequestData dataInfo, #if NET462 string cert, string certPassword, #endif int timeOut = Config.TIME_OUT</summary>
