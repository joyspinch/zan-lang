        return await this.client.RequestJsonAsync("POST", "/capital/capitallhh/banks/personal-banking", query, jsonBody);
    }

    /// <summary>GET /capital/capitallhh/banks/personal-banking/banks; C# 参数：QueryBankListRequestData data, int timeOut = Config.TIME_OUT</summary>
