using System;
using Sdk.Wechat;

namespace Sdk.Wechat.TenPay;

/// <summary>早期公众号支付 /pay 与 /payfeedback 接口配置。</summary>
class WechatPayLegacyMpConfig {
    string AppId;
    string AppSecret;
    string AccessToken;

    public WechatPayLegacyMpConfig(string appId, string appSecret) {
        this.AppId = appId;
        this.AppSecret = appSecret;
        this.AccessToken = "";
    }

    WechatPayLegacyMpConfig SetAccessToken(string accessToken) {
        this.AccessToken = accessToken; return this;
    }
}

/// <summary>
/// 早期公众号微信支付客户端。AppId/AppSecret 是配置，短期 access_token 可在刷新后设置。
/// </summary>
class WechatPayLegacyMpClient {
    WechatPayLegacyMpConfig config;
    WechatApiTransport transport;

    public WechatPayLegacyMpClient(WechatPayLegacyMpConfig config) {
        this.config = config;
        this.transport = new WechatApiTransport("api.weixin.qq.com");
    }

    WechatPayLegacyMpClient Server(string host, int port) {
        this.transport.Server(host, port); return this;
    }
    WechatPayLegacyMpClient Timeout(int ms) {
        this.transport.Timeout(ms); return this;
    }
    WechatPayLegacyMpClient SetAccessToken(string accessToken) {
        this.config.AccessToken = accessToken; return this;
    }

    async WechatRawResponse RequestJsonAsync(string method, string path,
                                              string query, string jsonBody) {
        string target = WechatApiTransport.BuildPath(path, query);
        if (this.config.AccessToken.Length == 0) {
            throw new InvalidOperationException("早期公众号支付接口需要 access_token");
        }
        target = WechatApiTransport.AppendQuery(target, "access_token",
                                                this.config.AccessToken);
        string body = jsonBody;
        if (method != "GET" && body.Length == 0) { body = "{}"; }
        return await this.transport.RequestSimpleRawAsync(method, target, body,
                                                           "application/json");
    }

    async WechatRawResponse RequestMultipartAsync(string method, string path,
                                                   string query,
                                                   WechatMultipart multipart) {
        string target = WechatApiTransport.BuildPath(path, query);
        target = WechatApiTransport.AppendQuery(target, "access_token",
                                                this.config.AccessToken);
        return await this.transport.RequestMultipartAsync(method, target,
                                                           multipart);
    }
}
