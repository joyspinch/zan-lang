using System;
using System.IO;
using System.Net.Http;

namespace Sdk.Wechat;

/// <summary>Binary-safe HTTP response used by media, bill, multipart and pay APIs.</summary>
class WechatRawResponse {
    int StatusCode;
    string StatusText;
    string ContentType;
    string Body;
    List<string> Headers;

    WechatRawResponse(int statusCode, string statusText, string contentType,
                      string body, List<string> headers) {
        this.StatusCode = statusCode;
        this.StatusText = statusText;
        this.ContentType = contentType;
        this.Body = body;
        this.Headers = headers;
    }

    static WechatRawResponse FromHttp(HttpResponse response) {
        return new WechatRawResponse(response.statusCode, response.statusText,
            response.contentType, response.body, response.headers);
    }

    bool IsSuccess() { return this.StatusCode >= 200 && this.StatusCode < 300; }

    string Header(string name) {
        for (int i = 0; i < this.Headers.Count; i = i + 1) {
            string line = this.Headers[i];
            int colon = WechatRawResponse.IndexOf(line, ":", 0);
            if (colon > 0) {
                string current = line.Substring(0, colon);
                if (WechatRawResponse.AsciiEquals(current, name)) {
                    int start = colon + 1;
                    while (start < line.Length && (line[start] & 255) == 32) {
                        start = start + 1;
                    }
                    return line.Substring(start);
                }
            }
        }
        return "";
    }

    void SaveBody(string path) {
        File.WriteBytes(path, this.Body, this.Body.Length);
    }

    WechatResponse Json() { return WechatResponse.Parse(this.Body); }

    static bool AsciiEquals(string a, string b) {
        if (a.Length != b.Length) { return false; }
        for (int i = 0; i < a.Length; i = i + 1) {
            int x = a[i] & 255;
            int y = b[i] & 255;
            if (x >= 65 && x <= 90) { x = x + 32; }
            if (y >= 65 && y <= 90) { y = y + 32; }
            if (x != y) { return false; }
        }
        return true;
    }

    static int IndexOf(string hay, string needle, int from) {
        int last = hay.Length - needle.Length;
        int i = from;
        while (i <= last) {
            int j = 0;
            for (; j < needle.Length
                && (hay[i + j] & 255) == (needle[j] & 255); j = j + 1) { }
            if (j == needle.Length) { return i; }
            i = i + 1;
        }
        return -1;
    }
}
