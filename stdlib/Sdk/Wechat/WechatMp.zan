// WechatMp provides basic WeChat Public Account functionality
// using Zan's native standard library only.

public class WechatMp {
    private string appId;
    private string appSecret;
    private string accessToken;
    private DateTime accessTokenExpiry;

    public WechatMp(string appId, string appSecret) {
        this.appId = appId;
        this.appSecret = appSecret;
        this.accessToken = "";
        this.accessTokenExpiry = DateTime.MinValue;
    }

