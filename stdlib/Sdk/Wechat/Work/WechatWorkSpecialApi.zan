using System;
using System.Text;
using Sdk.Wechat;

namespace Sdk.Wechat.Work;

/// <summary>企业微信媒体上传、下载和永久素材特殊传输接口。</summary>
class WechatWorkMediaSpecialApi {
    WechatWorkClient client;
    public WechatWorkMediaSpecialApi(WechatWorkClient client) { this.client = client; }

    async WechatResponse UploadAsync(string mediaType, string fileName,
                                     string contentType, string fileBytes) {
        WechatMultipart form = new WechatMultipart();
        form.AddFile("media", fileName, contentType, fileBytes);
        WechatRawResponse raw = await this.client.RequestMultipartAsync("POST",
            "/cgi-bin/media/upload", "type=" + Encoding.UrlEncode(mediaType),
            form, WechatCredentialKind.AccessToken);
        return raw.Json();
    }

    async WechatRawResponse GetAsync(string mediaId) {
        return await this.client.RequestRawAsync("GET", "/cgi-bin/media/get",
            "media_id=" + Encoding.UrlEncode(mediaId), "", "", WechatCredentialKind.AccessToken);
    }

    async WechatResponse AddMaterialAsync(string mediaType, int agentId,
                                          string fileName, string contentType,
                                          string fileBytes) {
        WechatMultipart form = new WechatMultipart();
        form.AddFile("media", fileName, contentType, fileBytes);
        string query = "agentid=" + Convert.ToString(agentId)
            + "&type=" + Encoding.UrlEncode(mediaType);
        WechatRawResponse raw = await this.client.RequestMultipartAsync("POST",
            "/cgi-bin/material/add_material", query, form, WechatCredentialKind.AccessToken);
        return raw.Json();
    }

    async WechatRawResponse GetForeverMaterialAsync(int agentId, string mediaId) {
        string query = "media_id=" + Encoding.UrlEncode(mediaId)
            + "&agentid=" + Convert.ToString(agentId);
        return await this.client.RequestRawAsync("GET", "/cgi-bin/material/get",
            query, "", "", WechatCredentialKind.AccessToken);
    }

    async WechatResponse UploadimgMediaAsync(string fileName, string contentType,
                                             string fileBytes) {
        WechatMultipart form = new WechatMultipart();
        form.AddFile("media", fileName, contentType, fileBytes);
        WechatRawResponse raw = await this.client.RequestMultipartAsync("POST",
            "/cgi-bin/media/uploadimg", "", form, WechatCredentialKind.AccessToken);
        return raw.Json();
    }

    async WechatResponse UploadAttachmentAsync(string mediaType,
                                                string attachmentType,
                                                string fileName,
                                                string contentType,
                                                string fileBytes) {
        WechatMultipart form = new WechatMultipart();
        form.AddFile("media", fileName, contentType, fileBytes);
        string query = "media_type=" + Encoding.UrlEncode(mediaType)
            + "&attachment_type=" + Encoding.UrlEncode(attachmentType);
        WechatRawResponse raw = await this.client.RequestMultipartAsync("POST",
            "/cgi-bin/media/upload_attachment", query, form, WechatCredentialKind.AccessToken);
        return raw.Json();
    }
}

/// <summary>企业微信群机器人文件上传接口，使用 webhook key 而非 access_token。</summary>
class WechatWorkWebhookSpecialApi {
    WechatWorkClient client;
    public WechatWorkWebhookSpecialApi(WechatWorkClient client) { this.client = client; }

    async WechatResponse UploadMediaAsync(string key, string fileName,
                                          string contentType, string fileBytes) {
        WechatMultipart form = new WechatMultipart();
        form.AddFile("media", fileName, contentType, fileBytes);
        string query = "key=" + Encoding.UrlEncode(key) + "&type=file";
        WechatRawResponse raw = await this.client.RequestMultipartAsync("POST",
            "/cgi-bin/webhook/upload_media", query, form, WechatCredentialKind.None);
        return raw.Json();
    }
}
