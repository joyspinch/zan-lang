using System;
using Sdk.Wechat;

namespace Sdk.Wechat.Work;

/// <summary>
/// KF/KFApi.cs 的 Zan JSON 接口。
/// query / JSON 参数由调用方提供；token 和网络传输由产品客户端统一处理。
/// Generated from Senparc WeChat product APIs; regenerate with scripts/generate_wechat_product_apis.py.
/// </summary>
class WechatWorkKFApi {
    WechatWorkClient client;

    public WechatWorkKFApi(WechatWorkClient client) {
        this.client = client;
    }

    /// <summary>POST /cgi-bin/kf/send</summary>
    async WechatResponse SendTextAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/cgi-bin/kf/send", query, jsonBody, "access_token");
    }

    /// <summary>POST /cgi-bin/kf/send</summary>
    async WechatResponse SendImageAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/cgi-bin/kf/send", query, jsonBody, "access_token");
    }

    /// <summary>POST /cgi-bin/kf/send</summary>
    async WechatResponse SendFileAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/cgi-bin/kf/send", query, jsonBody, "access_token");
    }

    /// <summary>POST /cgi-bin/kf/send</summary>
    async WechatResponse SendVoiceAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/cgi-bin/kf/send", query, jsonBody, "access_token");
    }

    /// <summary>GET /cgi-bin/kf/list</summary>
    async WechatResponse GetKFListAsync(string query) {
        return await this.client.RequestAsync("GET", "/cgi-bin/kf/list", query, "", "access_token");
    }

