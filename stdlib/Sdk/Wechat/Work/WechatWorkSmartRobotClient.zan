using System;
using System.Text;
using System.Net.WebSocket.Secure;
using System.Security.Cryptography;
using System.Json;

namespace Sdk.Wechat.Work;

// ---- WSS command envelope entities ---------------------------------------
// The aibot wire protocol: {cmd, headers:{req_id}, body}. `body` is a
// JsonValue passthrough because callers supply arbitrary reply JSON; an empty
// body serializes to JSON null exactly like the old raw "null" literal.

class WwCommandHeaders {
    string req_id;
}

class WwCommandEnvelope {
    string cmd;
    WwCommandHeaders headers;
    JsonValue body;
}

class WwRobotAuthBody {
    string bot_id;
    string secret;
}

/// <summary>企业微信智能机器人 WSS 长连接客户端。</summary>
class WechatWorkSmartRobotClient {
    WssClient socket;
    string host;
    int port;
    string path;

    public WechatWorkSmartRobotClient() {
        this.host = "openws.work.weixin.qq.com";
        this.port = 443;
        this.path = "/";
        this.socket = null;
    }

    WechatWorkSmartRobotClient Endpoint(string host, int port, string path) {
        this.host = host; this.port = port; this.path = path;
        return this;
    }

    async void ConnectAndSubscribeAsync(string botId, string secret) {
        this.socket = await WssClient.ConnectAsync(this.host, this.port, this.path);
        if (this.socket == null || !this.socket.IsConnected()) {
            throw new InvalidOperationException("企业微信智能机器人 WSS 连接失败");
        }
        WwRobotAuthBody auth = new WwRobotAuthBody();
        auth.bot_id = botId;
        auth.secret = secret;
        await this.SendCommandAsync("aibot_subscribe", CreateRequestId(),
            Json.Serialize<WwRobotAuthBody>(auth));
    }

    async string ReceiveAsync() {
        if (this.socket == null) { return ""; }
        return await this.socket.RecvText();
    }

    async void RespondWelcomeAsync(string requestId, string replyJson) {
        await this.SendCommandAsync("aibot_respond_welcome_msg", requestId, replyJson);
    }

    async void RespondAsync(string requestId, string replyJson) {
        await this.SendCommandAsync("aibot_respond_msg", requestId, replyJson);
    }

    async void UpdateResponseAsync(string requestId, string replyJson) {
        await this.SendCommandAsync("aibot_respond_update_msg", requestId, replyJson);
    }

    async void SendMessageAsync(string requestId, string messageJson) {
        await this.SendCommandAsync("aibot_send_msg", requestId, messageJson);
    }

    async void SendPingAsync(string requestId) {
        string id = requestId;
        if (id.Length == 0) { id = CreateRequestId(); }
        await this.SendCommandAsync("ping", id, "");
    }

    async void SendCommandAsync(string command, string requestId, string bodyJson) {
        if (this.socket == null || !this.socket.IsConnected()) {
            throw new InvalidOperationException("企业微信智能机器人长连接尚未建立");
        }
        WwCommandEnvelope envelope = new WwCommandEnvelope();
        envelope.cmd = command;
        envelope.headers = new WwCommandHeaders();
        envelope.headers.req_id = requestId;
        if (bodyJson.Length > 0) {
            envelope.body = JsonValue.ParseLenient(bodyJson);
        }
        await this.socket.SendText(Json.Serialize<WwCommandEnvelope>(envelope));
    }

    async void CloseAsync() {
        if (this.socket != null) { await this.socket.Close(); this.socket = null; }
    }

    static string CreateRequestId() {
        byte[] bytes = RandomNumberGenerator.GetBytes(16);
        return Hex.Encode(bytes, 16);
    }
}
