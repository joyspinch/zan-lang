using System;
using Sdk.Wechat;

namespace Sdk.Wechat.Work;

/// <summary>
/// Concern/ConcernApi.cs 的 Zan JSON 接口。
/// query / JSON 参数由调用方提供；token 和网络传输由产品客户端统一处理。
/// Generated from Senparc WeChat product APIs; regenerate with scripts/generate_wechat_product_apis.py.
/// </summary>
class WechatWorkConcernApi {
    WechatWorkClient client;

    public WechatWorkConcernApi(WechatWorkClient client) {
        this.client = client;
    }

    /// <summary>GET /cgi-bin/user/authsucc</summary>
    async WechatResponse TwoVerificationAsync(string query) {
        return await this.client.RequestAsync("GET", "/cgi-bin/user/authsucc", query, "", "access_token");
    }

}
