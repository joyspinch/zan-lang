using System;
using Sdk.Wechat;

namespace Sdk.Wechat.Work;

/// <summary>
/// OAuth2/OAuth2Api.cs 的 Zan JSON 接口。
/// query / JSON 参数由调用方提供；token 和网络传输由产品客户端统一处理。
/// Generated from Senparc WeChat product APIs; regenerate with scripts/generate_wechat_product_apis.py.
/// </summary>
class WechatWorkOAuth2Api {
    WechatWorkClient client;

    public WechatWorkOAuth2Api(WechatWorkClient client) {
        this.client = client;
    }

    /// <summary>GET /cgi-bin/auth/getuserinfo</summary>
    async WechatResponse GetUserIdAsync(string query) {
        return await this.client.RequestAsync("GET", "/cgi-bin/auth/getuserinfo", query, "", "access_token");
    }

    /// <summary>POST /cgi-bin/auth/getuserdetail</summary>
    async WechatResponse GetUserDetailAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/cgi-bin/auth/getuserdetail", query, jsonBody, "access_token");
    }

}
