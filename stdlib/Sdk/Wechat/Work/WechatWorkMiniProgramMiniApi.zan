using System;
using Sdk.Wechat;

namespace Sdk.Wechat.Work;

/// <summary>
/// MiniProgram/MiniApi.cs 的 Zan JSON 接口。
/// query / JSON 参数由调用方提供；token 和网络传输由产品客户端统一处理。
/// Generated from Senparc WeChat product APIs; regenerate with scripts/generate_wechat_product_apis.py.
/// </summary>
class WechatWorkMiniProgramMiniApi {
    WechatWorkClient client;

    public WechatWorkMiniProgramMiniApi(WechatWorkClient client) {
        this.client = client;
    }

    /// <summary>GET /cgi-bin/miniprogram/jscode2session</summary>
    async WechatResponse LoginCheckAsync(string query) {
        return await this.client.RequestAsync("GET", "/cgi-bin/miniprogram/jscode2session", query, "", "access_token");
    }

    /// <summary>GET /cgi-bin/service/miniprogram/jscode2session</summary>
    async WechatResponse ThirdLoginCheckAsync(string query) {
        return await this.client.RequestAsync("GET", "/cgi-bin/service/miniprogram/jscode2session", query, "", "suite_access_token");
    }

    /// <summary>POST /cgi-bin/miniprogram/transfer_session</summary>
    async WechatResponse TransferSessionAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/cgi-bin/miniprogram/transfer_session", query, jsonBody, "access_token");
    }

}
