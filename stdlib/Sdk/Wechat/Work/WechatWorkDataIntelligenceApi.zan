/// Generated from Senparc WeChat product APIs; regenerate with scripts/generate_wechat_product_apis.py.
/// </summary>
class WechatWorkDataIntelligenceApi {
    WechatWorkClient client;

    public WechatWorkDataIntelligenceApi(WechatWorkClient client) {
        this.client = client;
    }

    /// <summary>POST /cgi-bin/data/get_conversation_records</summary>
    async WechatResponse GetConversationRecordsAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/cgi-bin/data/get_conversation_records", query, jsonBody, "access_token");
    }

    /// <summary>POST /cgi-bin/data/get_message_statistics</summary>
    async WechatResponse GetMessageStatisticsAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/cgi-bin/data/get_message_statistics", query, jsonBody, "access_token");
    }

}
