using System;
using Sdk.Wechat;

namespace Sdk.Wechat.Work;

/// <summary>
/// Mobile/MobileApi.cs 的 Zan JSON 接口。
/// query / JSON 参数由调用方提供；token 和网络传输由产品客户端统一处理。
/// Generated from Senparc WeChat product APIs; regenerate with scripts/generate_wechat_product_apis.py.
/// </summary>
class WechatWorkMobileApi {
    WechatWorkClient client;

    public WechatWorkMobileApi(WechatWorkClient client) {
        this.client = client;
    }

    /// <summary>GET /cgi-bin/ticket/get</summary>
    async WechatResponse GetTicketAsync(string query) {
        return await this.client.RequestAsync("GET", "/cgi-bin/ticket/get", query, "", "access_token");
    }

    /// <summary>GET /cgi-bin/ticket/get</summary>
    async WechatResponse GetJsApiTicketAsync(string query) {
        return await this.client.RequestAsync("GET", "/cgi-bin/ticket/get", query, "", "access_token");
    }

}
