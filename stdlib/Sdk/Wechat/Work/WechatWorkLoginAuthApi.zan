using System;
using System.Json;
using Sdk.Wechat;
using Sdk.Wechat.Models.Work;

namespace Sdk.Wechat.Work;

/// <summary>方法请求/响应契约；可复用的 DTO 实体见 Sdk.Wechat.Models.Work。</summary>
class WechatWorkLoginAuthApiGetLoginUrlRequest {
    WechatTypedRequest request;

    public WechatWorkLoginAuthApiGetLoginUrlRequest() { this.request = new WechatTypedRequest(); }

    WechatWorkLoginAuthApiGetLoginUrlRequest LoginTicket(string fieldValue) {
        this.request.BodyString("login_ticket", fieldValue);
        return this;
    }

    WechatWorkLoginAuthApiGetLoginUrlRequest Target(string fieldValue) {
        this.request.BodyString("target", fieldValue);
        return this;
    }

    WechatWorkLoginAuthApiGetLoginUrlRequest Agentid(int fieldValue) {
        this.request.BodyInt("agentid", fieldValue);
        return this;
    }

    string QueryText() { return this.request.QueryText(); }
    string JsonBody() { return this.request.JsonBody(); }
}

class WechatWorkLoginAuthApiGetLoginUrlResponse : WechatWorkGetLoginUrlResult {
    public string Raw;
}

/// <summary>
/// LoginAuth/LoginAuthApi.cs 的 Zan 强类型接口。
/// 业务参数由请求对象自动序列化，凭证由客户端配置和缓存自动补充。
/// 由 scripts/generate_wechat_product_apis.py 从 Senparc 微信产品 API 生成。
/// </summary>
class WechatWorkLoginAuthApi {
    WechatWorkClient client;

    public WechatWorkLoginAuthApi(WechatWorkClient client) {
        this.client = client;
    }

    /// <summary>POST /cgi-bin/service/get_login_url</summary>
    async WechatWorkLoginAuthApiGetLoginUrlResponse GetLoginUrlAsync(WechatWorkLoginAuthApiGetLoginUrlRequest request) {
        if (request == null) { request = new WechatWorkLoginAuthApiGetLoginUrlRequest(); }
        WechatResponse raw = await this.client.RequestAsync("POST", "/cgi-bin/service/get_login_url", request.QueryText(), request.JsonBody(), WechatCredentialKind.ProviderAccessToken);
        WechatWorkLoginAuthApiGetLoginUrlResponse result = Json.Deserialize<WechatWorkLoginAuthApiGetLoginUrlResponse>(raw.Data);
        result.Raw = raw.Raw;
        return result;
    }

    async WechatResponse GetLoginUrlRawAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/cgi-bin/service/get_login_url", query, jsonBody, WechatCredentialKind.ProviderAccessToken);
    }

}
