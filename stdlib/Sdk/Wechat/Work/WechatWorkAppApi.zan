using System;
using Sdk.Wechat;

namespace Sdk.Wechat.Work;

/// <summary>
/// App/AppApi.cs 的 Zan JSON 接口。
/// query / JSON 参数由调用方提供；token 和网络传输由产品客户端统一处理。
/// Generated from Senparc WeChat product APIs; regenerate with scripts/generate_wechat_product_apis.py.
/// </summary>
class WechatWorkAppApi {
    WechatWorkClient client;

    public WechatWorkAppApi(WechatWorkClient client) {
        this.client = client;
    }

    /// <summary>GET /cgi-bin/agent/get</summary>
    async WechatResponse GetAppInfoAsync(string query) {
        return await this.client.RequestAsync("GET", "/cgi-bin/agent/get", query, "", "access_token");
    }

    /// <summary>POST /cgi-bin/agent/set</summary>
    async WechatResponse SetAppAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/cgi-bin/agent/set", query, jsonBody, "access_token");
    }

    /// <summary>GET /cgi-bin/agent/list</summary>
    async WechatResponse GetAppListAsync(string query) {
        return await this.client.RequestAsync("GET", "/cgi-bin/agent/list", query, "", "access_token");
    }

}
