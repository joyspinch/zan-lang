using System;
using Sdk.Wechat;

namespace Sdk.Wechat.Work;

/// <summary>
/// SSO/SsoApi.cs 的 Zan JSON 接口。
/// query / JSON 参数由调用方提供；token 和网络传输由产品客户端统一处理。
/// Generated from Senparc WeChat product APIs; regenerate with scripts/generate_wechat_product_apis.py.
/// </summary>
class WechatWorkSsoApi {
    WechatWorkClient client;

    public WechatWorkSsoApi(WechatWorkClient client) {
        this.client = client;
    }

    /// <summary>POST /cgi-bin/service/get_login_info</summary>
    async WechatResponse GetLoginInfoAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/cgi-bin/service/get_login_info", query, jsonBody, "provider_access_token");
    }

    /// <summary>POST /cgi-bin/service/get_provider_token</summary>
    async WechatResponse GetProviderTokenAsync(string query, string jsonBody) {
        return await this.client.RequestAsync("POST", "/cgi-bin/service/get_provider_token", query, jsonBody, "");
    }

}
