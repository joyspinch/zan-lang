using System;
using System.Json;

namespace Sdk.Jd;

/// <summary>
/// 一次京东开放平台调用的请求描述：API 名 + 业务参数。
///
/// 与 C# 原版每个接口一个 Request 类（211 个纯样板）不同，这里只有一个类：
/// API 名用字符串给出，参数用链式 Set 累积。业务参数一律走 JsonValue 构建，
/// 不做字符串拼接——值里带引号、换行、中文都不会拼出非法 JSON。
///
/// <code>
/// JdRequest req = new JdRequest("jingdong.area.province.get");
/// req.Set("parentId", 0).Set("keyword", "北京");
/// </code>
///
/// 空值语义与官方一致：Set 传入空串会被忽略（京东网关不接受空参数）。
/// </summary>
class JdRequest {
    /// <summary>API 方法名，如 "jingdong.area.province.get"。</summary>
    public string ApiName;

    /// <summary>API 版本号，默认 "2.0"。JOS 接口不区分版本，开普勒接口需要。</summary>
    public string ApiVersion;

    JsonValue param;

    public JdRequest(string apiName) {
        this.ApiName = apiName;
        this.ApiVersion = "2.0";
        this.param = JsonValue.NewObject();
    }

    /// <summary>设置一个字符串业务参数；空串被忽略。返回自身以便链式调用。</summary>
    JdRequest Set(string key, string paramValue) {
        if (key.Length == 0 || paramValue.Length == 0) { return this; }
        this.param.Set(key, JsonValue.NewStr(paramValue));
        return this;
    }

    /// <summary>设置一个整数业务参数。</summary>
    JdRequest SetInt(string key, int paramValue) {
        if (key.Length == 0) { return this; }
        this.param.Set(key, JsonValue.NewNum(Convert.ToString(paramValue)));
        return this;
    }

    /// <summary>
    /// 设置一个 64 位整数业务参数（京东的 wareId / skuId / orderId 都是大数，
    /// 不能走 int 通道被截断）。
    /// </summary>
    JdRequest SetLong(string key, long paramValue) {
        if (key.Length == 0) { return this; }
        this.param.Set(key, JsonValue.NewNum(Convert.ToString(paramValue)));
        return this;
    }

    /// <summary>设置一个布尔业务参数。</summary>
    JdRequest SetBool(string key, bool paramValue) {
        if (key.Length == 0) { return this; }
        this.param.Set(key, JsonValue.NewBool(paramValue));
        return this;
    }

    /// <summary>
    /// 设置一个任意结构的业务参数（嵌套对象 / 数组）。
    /// 复杂入参用 <c>Json.Serialize&lt;T&gt;</c> 得到文本后 JsonValue.Parse 传入，
    /// 或直接构造 JsonValue 树。
    /// </summary>
    JdRequest SetValue(string key, JsonValue paramValue) {
        if (key.Length == 0 || paramValue == null) { return this; }
        this.param.Set(key, paramValue);
        return this;
    }

    /// <summary>业务参数序列化成 360buy_param_json 的取值。</summary>
    string ParamJson() {
        return this.param.ToJson();
    }
}
