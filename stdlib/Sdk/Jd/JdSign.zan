using System;
using System.Text;
using System.Security.Cryptography;

namespace Sdk.Jd;

/// <summary>
/// 京东开放平台的协议参数容器：签名前的系统级参数 + 业务参数 JSON。
///
/// 与 C# 原版的 JdDictionary 不同，这里不自造字典类型——直接用标准
/// Dictionary&lt;string,string&gt;，只把"京东特有的排序拼接签名规则"作为
/// 静态方法留在本类里。
/// </summary>
class JdSign {
    /// <summary>
    /// 按京东规则计算 MD5 签名：参数按 key 升序拼成 "秘钥+k1v1k2v2...+秘钥"，
    /// 取 MD5 的大写十六进制。空 key / 空值不参与签名。
    /// </summary>
    static string Compute(Dictionary<string, string> parameters, string secret) {
        List<string> ks = JdSign.SortedKeys(parameters);
        StringBuilder sb = new StringBuilder();
        sb.Append(secret);
        int n = ks.Count;
        for (int i = 0; i < n; i = i + 1) {
            string k = ks[i];
            string v = parameters[k];
            if (k.Length > 0 && v.Length > 0) {
                sb.Append(k);
                sb.Append(v);
            }
        }
        sb.Append(secret);

        string payload = sb.ToString();
        byte[] digest = Md5.Hash(payload, payload.Length);
        return Hex.Encode(digest, 16).ToUpper();
    }

    /// <summary>
    /// 字典的 key 升序列表。Dictionary 保持插入序，签名必须自己排序。
    /// 数量恒定在十几个，用插入排序即可（规范禁止冒泡）。
    /// </summary>
    static List<string> SortedKeys(Dictionary<string, string> parameters) {
        List<string> ks = parameters.Keys;
        List<string> outv = new List<string>();
        int n = ks.Count;
        for (int i = 0; i < n; i = i + 1) {
            string cur = ks[i];
            int j = outv.Count;
            outv.Add(cur);
            while (j > 0) {
                if (String.CompareOrdinal(outv[j - 1], cur) <= 0) { break; }
                outv[j] = outv[j - 1];
                j = j - 1;
            }
            outv[j] = cur;
        }
        return outv;
    }
}
