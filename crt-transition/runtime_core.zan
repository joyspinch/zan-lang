    // UI thread API
    static nint g_ui_thread_id;

    public static void ui_thread_set() {
        g_ui_thread_id = cpthread_self();
    }

    public static int ui_thread_check() {
        if (g_ui_thread_id == 0) { return 1; }
        return cpthread_equal(g_ui_thread_id, cpthread_self()) != 0 ? 1 : 0;
    }

    public static void ui_thread_assert(nint msg) {
        if (ui_thread_check() == 0) {
            cabort();
        }
    }

    // Process execution API
    public static void proc_free_buf(nint buf) {
        if (buf != 0) { cfree(buf); }
    }

    public static int proc_run_safe(nint exe, nint args, int argc) {
        if (exe == 0) { return -1; }
        nint argv = malloc((long)(argc + 2) * 8);
        if (argv == 0) { return -1; }
        Span<nint> av = new Span<nint>(argv, argc + 2);
        av[0] = exe;
        if (args != 0 && argc > 0) {
            Span<nint> src = new Span<nint>(args, argc);
            for (int i = 0; i < argc; i = i + 1) {
                av[i + 1] = src[i];
            }
        }
        av[argc + 1] = 0;

        int pid = cfork();
        if (pid < 0) {
            cfree(argv);
            return -1;
        }
        if (pid == 0) {
            cexecvp(exe, argv);
            c_exit(127);
        }
        cfree(argv);
        nint stat_loc = malloc(4);
        Span<int> stv = new Span<int>(stat_loc, 1);
        while (cwaitpid(pid, stat_loc, 0) < 0) {
        }
        int status = stv[0];
        cfree(stat_loc);
        if ((status & 127) == 0) {
            return (status >> 8) & 255;
        }
        if ((status & 127) != 0 && (status & 127) != 127) {
            return 128 + (status & 127);
        }
        return -1;
    }

    public static int proc_start_detached_safe(nint exe, nint args, int argc) {
        if (exe == 0) { return -1; }
        nint argv = malloc((long)(argc + 2) * 8);
        if (argv == 0) { return -1; }
        Span<nint> av = new Span<nint>(argv, argc + 2);
        av[0] = exe;
        if (args != 0 && argc > 0) {
            Span<nint> src = new Span<nint>(args, argc);
            for (int i = 0; i < argc; i = i + 1) {
                av[i + 1] = src[i];
            }
        }
        av[argc + 1] = 0;

        int pid = cfork();
        if (pid < 0) {
            cfree(argv);
            return -1;
        }
        if (pid == 0) {
            if (csetsid() < 0) { c_exit(127); }
            int gc = cfork();
            if (gc < 0) { c_exit(127); }
            if (gc == 0) {
                nint devnull_str = malloc(10);
                Span<byte> dv = new Span<byte>(devnull_str, 10);
                dv[0] = 47; dv[1] = 100; dv[2] = 101; dv[3] = 118; dv[4] = 47;
                dv[5] = 110; dv[6] = 117; dv[7] = 108; dv[8] = 108; dv[9] = 0;
                int devnull = copen2(devnull_str, 2);
                cfree(devnull_str);
                if (devnull >= 0) {
                    cdup2(devnull, 0);
                    cdup2(devnull, 1);
                    cdup2(devnull, 2);
                    if (devnull > 2) { cclose(devnull); }
                }
                cexecvp(exe, argv);
                c_exit(127);
            }
            c_exit(0);
        }
        cfree(argv);
        nint stat_loc = malloc(4);
        while (cwaitpid(pid, stat_loc, 0) < 0) {}
        cfree(stat_loc);
        return 0;
    }

    public static int proc_start_program_safe(nint exe, nint log_path) {
        if (exe == 0) { return -1; }
        int pid = cfork();
        if (pid < 0) { return -1; }
        if (pid == 0) {
            if (csetsid() < 0) { c_exit(127); }
            int gc = cfork();
            if (gc < 0) { c_exit(127); }
            if (gc == 0) {
                nint devnull_str = malloc(10);
                Span<byte> dv = new Span<byte>(devnull_str, 10);
                dv[0] = 47; dv[1] = 100; dv[2] = 101; dv[3] = 118; dv[4] = 47;
                dv[5] = 110; dv[6] = 117; dv[7] = 108; dv[8] = 108; dv[9] = 0;
                int devnull = copen2(devnull_str, 0);
                if (devnull >= 0) {
                    cdup2(devnull, 0);
                    if (devnull > 0) { cclose(devnull); }
                }
                if (log_path != 0 && new Span<byte>(log_path, 1)[0] != 0) {
                    int fl = 521;
#if !MACOS
                    fl = 1089;
#endif
                    int outfd = copen3(log_path, fl, 420);
                    if (outfd >= 0) {
                        cdup2(outfd, 1);
                        cdup2(outfd, 2);
                        if (outfd > 2) { cclose(outfd); }
                    }
                } else {
                    int outnull = copen2(devnull_str, 1);
                    if (outnull >= 0) {
                        cdup2(outnull, 1);
                        cdup2(outnull, 2);
                        if (outnull > 2) { cclose(outnull); }
                    }
                }
                cfree(devnull_str);
                nint argv = malloc(16);
                Span<nint> av = new Span<nint>(argv, 2);
                av[0] = exe;
                av[1] = 0;
                cexecvp(exe, argv);
                c_exit(127);
            }
            c_exit(0);
        }
        nint stat_loc = malloc(4);
        while (cwaitpid(pid, stat_loc, 0) < 0) {}
        cfree(stat_loc);
        return 0;
    }

    public static int proc_capture_safe(nint exe, nint args, int argc, nint out_buf, nint out_len, nint exit_code) {
        if (exe == 0 || out_buf == 0 || out_len == 0 || exit_code == 0) { return -1; }
        Span<nint> bp = new Span<nint>(out_buf, 1);
        Span<int> lp = new Span<int>(out_len, 1);
        Span<int> ep = new Span<int>(exit_code, 1);
        bp[0] = 0;
        lp[0] = 0;
        ep[0] = -1;

        nint pipefd = malloc(8);
        if (cpipe(pipefd) < 0) { cfree(pipefd); return -1; }
        Span<int> pfds = new Span<int>(pipefd, 2);
        int rfd = pfds[0];
        int wfd = pfds[1];
        cfree(pipefd);

        nint argv = malloc((long)(argc + 2) * 8);
        if (argv == 0) {
            cclose(rfd);
            cclose(wfd);
            return -1;
        }
        Span<nint> av = new Span<nint>(argv, argc + 2);
        av[0] = exe;
        if (args != 0 && argc > 0) {
            Span<nint> src = new Span<nint>(args, argc);
            for (int i = 0; i < argc; i = i + 1) {
                av[i + 1] = src[i];
            }
        }
        av[argc + 1] = 0;

        int pid = cfork();
        if (pid < 0) {
            cfree(argv);
            cclose(rfd);
            cclose(wfd);
            return -1;
        }
        if (pid == 0) {
            cclose(rfd);
            cdup2(wfd, 1);
            cdup2(wfd, 2);
            cclose(wfd);
            cexecvp(exe, argv);
            c_exit(127);
        }
        cfree(argv);
        cclose(wfd);

        long cap = 4096;
        long len = 0;
        nint buf = malloc(cap);
        if (buf == 0) {
            cclose(rfd);
            return -1;
        }

        long r = 1;
        while (r > 0) {
            r = cread(rfd, buf + len, cap - len - 1);
            if (r > 0) {
                len = len + r;
                if (len + 1024 >= cap) {
                    long ncap = cap * 2;
                    nint nbuf = malloc(ncap);
                    if (nbuf == 0) { r = 0; }
                    else {
                        memcpy(nbuf, buf, len);
                        cfree(buf);
                        buf = nbuf;
                        cap = ncap;
                    }
                }
            }
        }
        cclose(rfd);
        new Span<byte>(buf + len, 1)[0] = 0;

        nint stat_loc = malloc(4);
        Span<int> stv = new Span<int>(stat_loc, 1);
        while (cwaitpid(pid, stat_loc, 0) < 0) {}
        int status = stv[0];
        cfree(stat_loc);

        int code = -1;
        if ((status & 127) == 0) {
            code = (status >> 8) & 255;
        } else if ((status & 127) != 0 && (status & 127) != 127) {
            code = 128 + (status & 127);
        }

        bp[0] = buf;
        lp[0] = (int)len;
        ep[0] = code;
        return 0;
    }
}

class _zan {
    public static void decimal_add(nint a, nint b, nint outPtr) {
        if (a == (nint)0 || b == (nint)0 || outPtr == (nint)0) { return; }
        double da = _zan.decimal_to_double(a);
        double db = _zan.decimal_to_double(b);
        _zan.decimal_from_double(da + db, outPtr);
    }

    public static void decimal_sub(nint a, nint b, nint outPtr) {
        if (a == (nint)0 || b == (nint)0 || outPtr == (nint)0) { return; }
        double da = _zan.decimal_to_double(a);
        double db = _zan.decimal_to_double(b);
        _zan.decimal_from_double(da - db, outPtr);
    }

    public static void decimal_mul(nint a, nint b, nint outPtr) {
        if (a == (nint)0 || b == (nint)0 || outPtr == (nint)0) { return; }
        double da = _zan.decimal_to_double(a);
        double db = _zan.decimal_to_double(b);
        _zan.decimal_from_double(da * db, outPtr);
    }

    public static void decimal_div(nint a, nint b, nint outPtr) {
        if (a == (nint)0 || b == (nint)0 || outPtr == (nint)0) { return; }
        double da = _zan.decimal_to_double(a);
        double db = _zan.decimal_to_double(b);
        if (db == 0.0) {
            new Span<int>(outPtr, 1)[0] = 0;
            new Span<int>(outPtr + (nint)4, 1)[0] = 0;
            new Span<long>(outPtr + (nint)8, 1)[0] = 0L;
            return;
        }
        _zan.decimal_from_double(da / db, outPtr);
    }

    public static void decimal_rem(nint a, nint b, nint outPtr) {
        if (a == (nint)0 || b == (nint)0 || outPtr == (nint)0) { return; }
        long la = _zan.decimal_to_int64(a);
        long lb = _zan.decimal_to_int64(b);
        if (lb == 0L) {
            _zan.decimal_from_int64(0L, outPtr);
            return;
        }
        _zan.decimal_from_int64(la % lb, outPtr);
    }

    public static void decimal_neg(nint a, nint outPtr) {
        if (a == (nint)0 || outPtr == (nint)0) { return; }
        Span<int> sa = new Span<int>(a, 2);
        int flags = sa[0] ^ -2147483648;
        int hi = sa[1];
        long lo = new Span<long>(a + (nint)8, 1)[0];
        Span<int> so = new Span<int>(outPtr, 2);
        so[0] = flags;
        so[1] = hi;
        new Span<long>(outPtr + (nint)8, 1)[0] = lo;
    }

    public static int decimal_cmp(nint a, nint b) {
        if (a == (nint)0 && b == (nint)0) { return 0; }
        if (a == (nint)0) { return -1; }
        if (b == (nint)0) { return 1; }
        double da = _zan.decimal_to_double(a);
        double db = _zan.decimal_to_double(b);
        if (da < db) { return -1; }
        if (da > db) { return 1; }
        return 0;
    }

    public static void decimal_from_int64(long val, nint outPtr) {
        if (outPtr == (nint)0) { return; }
        int flags = 0;
        long u = val;
        if (val < 0L) {
            flags = -2147483648;
            u = -val;
        }
        Span<int> so = new Span<int>(outPtr, 2);
        so[0] = flags;
        so[1] = 0;
        new Span<long>(outPtr + (nint)8, 1)[0] = u;
    }

    public static void decimal_from_uint64(long val, nint outPtr) {
        if (outPtr == (nint)0) { return; }
        Span<int> so = new Span<int>(outPtr, 2);
        so[0] = 0;
        so[1] = 0;
        new Span<long>(outPtr + (nint)8, 1)[0] = val;
    }

    public static void decimal_from_double(double val, nint outPtr) {
        if (outPtr == (nint)0) { return; }
        int flags = 0;
        double v = val;
        if (v < 0.0) {
            flags = -2147483648;
            v = -v;
        }
        int scale = 0;
        while (v != Math.Floor(v) && scale < 28 && v < 1844674407370955161.0) {
            v = v * 10.0;
            scale = scale + 1;
        }
        flags = flags | ((scale & 255) << 16);
        long lo = (long)v;
        Span<int> so = new Span<int>(outPtr, 2);
        so[0] = flags;
        so[1] = 0;
        new Span<long>(outPtr + (nint)8, 1)[0] = lo;
    }

    public static long decimal_to_int64(nint a) {
        if (a == (nint)0) { return 0L; }
        Span<int> sa = new Span<int>(a, 1);
        int flags = sa[0];
        int scale = (flags >>> 16) & 255;
        long lo = new Span<long>(a + (nint)8, 1)[0];
        while (scale > 0) {
            lo = lo / 10L;
            scale = scale - 1;
        }
        if ((flags & -2147483648) != 0) {
            return -lo;
        }
        return lo;
    }

    public static double decimal_to_double(nint a) {
        if (a == (nint)0) { return 0.0; }
        Span<int> sa = new Span<int>(a, 2);
        int flags = sa[0];
        int hi = sa[1];
        long lo = new Span<long>(a + (nint)8, 1)[0];
        double v = (double)hi * 18446744073709551616.0 + (double)lo;
        int scale = (flags >>> 16) & 255;
        while (scale > 0) {
            v = v / 10.0;
            scale = scale - 1;
        }
        if ((flags & -2147483648) != 0) {
            return -v;
        }
        return v;
    }

    public static int decimal_to_string(nint a, nint buf, long buf_size) {
        if (a == (nint)0 || buf == (nint)0 || buf_size <= 0L) { return 0; }
        double v = _zan.decimal_to_double(a);
        string s = v.ToString();
        Span<byte> b = new Span<byte>(buf, (int)buf_size);
        int len = s.Length;
        if (len >= (int)buf_size) { len = (int)buf_size - 1; }
        for (int i = 0; i < len; i = i + 1) {
            b[i] = (byte)s.Substring(i, 1)[0];
        }
        b[len] = 0;
        return len;
    }

    public static int decimal_parse(nint str, long len, nint outPtr) {
        if (str == (nint)0 || len <= 0L || outPtr == (nint)0) { return 0; }
        Span<byte> sb = new Span<byte>(str, (int)len);
        string s = "";
        for (int i = 0; i < (int)len; i = i + 1) {
            s = s + (char)sb[i];
        }
        double d = double.Parse(s);
        _zan.decimal_from_double(d, outPtr);
        return 1;
    }
}

