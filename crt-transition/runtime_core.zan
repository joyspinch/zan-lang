    public static long swoole_timer_after(long delay, long cb) { return timer_after(delay, cb); }
    public static long swoole_timer_tick(long interval, long cb) { return timer_tick(interval, cb); }
    public static int swoole_timer_clear(long id) { return timer_clear(id); }
    public static long swoole_timer_clear_all() { return timer_clear_all(); }
    public static int swoole_timer_info(long id, nint a, nint b, nint c, nint d, nint e) {
        return timer_info(id, a, b, c, d, e);
    }
    public static long swoole_timer_list_count() { return timer_list_count(); }
    public static long swoole_timer_list_at(long index) { return timer_list_at(index); }
    public static void swoole_timer_stats(nint a, nint b, nint c) { timer_stats(a, b, c); }

    // ---- 运行时致命与参数面 ----
    static long rt_fatal_handler;
    public static void rt_set_fatal_handler(nint fn) { rt_fatal_handler = (long)fn; }
    public static void rt_fatal(nint cat, nint msg) {
        if (rt_fatal_handler != 0) {
            Action<nint, nint> h = (Action<nint, nint>)(nint)rt_fatal_handler;
            h(cat, msg);
        }
        cabort();
    }
    public static int utf8_argv(nint argc, nint argv) { return 0; }

    // rt_io.c:903:本车道内联执行;0 已建立,正 SO_ERROR,-3 超时,-1 失败。
    public static long io_connect_sa(long fd, nint sa, int salen, int timeoutMs) {
        io_ignore_sigpipe();
        int r = io_connect_sa_start(fd, sa, salen);
        if (r == 0 || r != -2) { return r; }
        if (fd < 0 || fd >= 1024) { return -1L; }
        nint wfds = malloc(128);
        nint efds = malloc(128);
        memset(wfds, 0, 128);
        memset(efds, 0, 128);
        long bit = 1L << (fd % 64);
        int slot = (int)(fd / 64);
        Span<long> wv = new Span<long>(wfds, 16);
        wv[slot] = wv[slot] | bit;
        Span<long> evv = new Span<long>(efds, 16);
        evv[slot] = evv[slot] | bit;
        nint ptv = 0;
        nint tv = 0;
        if (timeoutMs > 0) {
            tv = malloc(16);
            Span<long> tvv = new Span<long>(tv, 2);
            tvv[0] = timeoutMs / 1000;
            tvv[1] = (timeoutMs % 1000) * 1000;
            ptv = tv;
        }
        int sr = 0;
        long state = 0;
        while (state == 0) {
            sr = cselect((int)fd + 1, 0, wfds, efds, ptv);
            if (!(sr < 0 && err_now() == 4)) { state = 1; }   // EINTR 重试
        }
        long result = -1L;
        if (sr <= 0) {
            result = sr == 0 ? -3L : -1L;
        }
        else {
            nint errp = malloc(8);
            nint elenp = malloc(8);
            Span<long> elv = new Span<long>(elenp, 1);
            elv[0] = 4;
            if (cgetsockopt((int)fd, SolSocket(), SoError(), errp, elenp) != 0) {
                result = -1L;
            }
            else {
                Span<long> erv = new Span<long>(errp, 1);
                long ev = erv[0] & 0xFFFFFFFFL;
                result = ev == 0 ? 0L : ev;
            }
            cfree(errp);
            cfree(elenp);
        }
        cfree(tv);
        cfree(wfds);
        cfree(efds);
        return result;
    }

    // rt_io.c:853:0 已建立,正 SO_ERROR(或 -1),-2 进行中。
    public static int io_connect_status(long fd) {
        if (fd < 0 || fd >= 1024) { return -1; }
        nint wfds = malloc(128);
        nint efds = malloc(128);
        memset(wfds, 0, 128);
        memset(efds, 0, 128);
        long bit = 1L << (fd % 64);
        int slot = (int)(fd / 64);
        Span<long> wv = new Span<long>(wfds, 16);
        wv[slot] = wv[slot] | bit;
        Span<long> evv = new Span<long>(efds, 16);
        evv[slot] = evv[slot] | bit;
        nint tv = malloc(16);
        Span<long> tvv = new Span<long>(tv, 2);
        tvv[0] = 0;
        tvv[1] = 0;
        int r = -1;
        if (cselect((int)fd + 1, 0, wfds, efds, tv) >= 0) {
            Span<long> wv2 = new Span<long>(wfds, 16);
            Span<long> evv2 = new Span<long>(efds, 16);
            long eset = evv2[slot] & bit;
            long wset = wv2[slot] & bit;
            nint errp = malloc(8);
            nint elenp = malloc(8);
            Span<long> elv = new Span<long>(elenp, 1);
            elv[0] = 4;
            if (cgetsockopt((int)fd, SolSocket(), SoError(), errp, elenp) != 0) {
                r = -1;
            }
            else {
                Span<long> erv = new Span<long>(errp, 1);
                long ev = erv[0] & 0xFFFFFFFFL;
                if (eset != 0) { r = ev != 0 ? (int)ev : -1; }
                else if (wset != 0) { r = (int)ev; }
                else { r = -2; }
            }
            cfree(errp);
            cfree(elenp);
        }
        cfree(tv);
        cfree(wfds);
        cfree(efds);
        return r;
    }

    // rt_io.c:833:select 即时就绪探测。
    public static int io_socket_ready(long fd, int writeReady) {
        if (fd < 0 || fd >= 1024) { return -1; }
        nint fds = malloc(128);
        memset(fds, 0, 128);
        long bit = 1L << (fd % 64);
        int slot = (int)(fd / 64);
        Span<long> fv = new Span<long>(fds, 16);
        fv[slot] = fv[slot] | bit;
        nint tv = malloc(16);
        Span<long> tvv = new Span<long>(tv, 2);
        tvv[0] = 0;
        tvv[1] = 0;
        int r = cselect((int)fd + 1, writeReady != 0 ? 0 : fds, writeReady != 0 ? fds : 0, 0, tv);
        cfree(tv);
        cfree(fds);
        return r;
    }

    // rt_io.c:869:F_GETFD 探活。
    public static int io_socket_alive(long fd) {
        if (fd < 0) { return 0; }
        return cfcntl((int)fd, 1, 0) != -1 ? 1 : 0;
    }

    // rt_io.c:444:>=0 已收字节;-1 会阻塞;-2 致命;SIGPIPE 惰性忽略。
    public static long io_socket_send(long fd, nint buf, long len, int flags) {
        io_ignore_sigpipe();
        if (len <= 0) { return len == 0 ? 0L : -2L; }
        if (len > 2147483647L) { len = 2147483647L; }
        long result = -2L;
        long state = 0;
        while (state == 0) {
            long r = csend((int)fd, buf, len, flags);
            if (r >= 0) { result = r; state = 1; }
            else {
                int e = err_now();
                if (e == Ewould()) { result = -1L; state = 1; }        // EAGAIN
                else if (e != 4) { result = -2L; state = 1; }    // EINTR 重试
            }
        }
        return result;
    }

    // rt_io.c:459:负返回值透传(0=对端关闭,-1=错误)。
    public static long io_socket_recv(long fd, nint buf, long len, int flags) {
        if (len < 0) { return -2L; }
        if (len > 2147483647L) { len = 2147483647L; }
        return crecv((int)fd, buf, len, flags);
    }

    public static void io_socket_cleanup() {
    }

    // ---- 第十一批:运行时初始化/同步 nexus ------------------------------
    // rt_init_lk 是全运行时惰性静态的唯一串行化点:九处"calloc 静态 +
    // 惰性建立"原是单线程假设(第七/八/十批追加约束),缺口五起真线程
    // 在跑,两线程同时首用会各建一块、后存者胜,先者的状态分裂(split
    // brain)。双检锁形态:外侧平铺读快路径;rt_lock 用 OSAtomic CAS
    // 自旋(Barrier 变体,acquire),rt_unlock 用 OSAtomicAdd64Barrier(-1)
    // (release)——平铺 store 解锁没有 happens-before 边,后到的线程
    // 拿到锁也可能看到锁内写入的旧值,这是第十一批修掉的第二个 bug。
    // 规则:持 rt_init_lk 期间只做 calloc/pthread 等快系统调用,不得
    // 进入任何可能再取 rt_init_lk 或阻塞的路径(叶锁)。
    static long rt_init_lk;

    [StaticAddr("rt_init_lk")]
    public static nint rt_init_lk_addr() {
        return 0;      // 占位体:发射即实现(adrp+add 取数据全局地址)
    }

    static void rt_lock() {
        rt_cas_lock(rt_init_lk_addr());
    }

    static void rt_unlock() {
        rt_cas_unlock(rt_init_lk_addr());
    }

    // 双检锁 ensure 的统一形态(十一批):`if (X == 0) { rt_lock();
    // if (X == 0) { X = build(); } rt_unlock(); }`——calloc 失败保持 0,
    // 下次调用自然重试,不需要 built 旗标。

    // ---- 原子内建([AtomicCas]/[AtomicLoad]/[AtomicStore],十一批)----
    // 占位体即文档:发射被 ngen 换成单条指令。casal/ldar/stlr 与
    // clang 对 C11 __atomic SEQ_CST 的 arm64 降码同款(LSE 原子);
    // casal 返回比较时刻看到的旧值,oracle 的 seen 语义逐位对齐,
    // 第六批的 load-after-fail 文档化偏差就此退役。
    [AtomicCas]
    public static long atomic_cas_raw(nint p, long expected, long desired) {
        return 0;
    }

    [AtomicLoad]
    public static long atomic_ldar_raw(nint p) {
        return 0;
    }

    [AtomicStore]
    public static void atomic_stlr_raw(nint p, long v) {
    }

    // ---- 第六批:zan_atomic_int_*(spec: oracle rt_sync.c,C11 __atomic)----
    // 第十四批起 OSAtomic 退役:add 改 casal 环 fetch-add(线性化与
    // 全屏障 fetch-add 等价),exchange 保持 casal 环(每次迭代拿见证
    // 值,精确);load/store 走 ldar/stlr(SEQ_CST)。
    // 自旋锁帮助体:acquire = casal CAS 环(0→1),release = stlr 平铺
    // store 0(十一批结论:平铺无屏障 store 缺 happens-before 边)。
    // rt_init_lk / sigpipe / dispatch 环 / shared_table 六处共用。
    static void rt_cas_lock(nint lk) {
        long state = 0;
        while (state == 0) {
            long w = atomic_cas_raw(lk, 0, 1);
            if (w == 0) { state = 1; }
        }
    }

    static void rt_cas_unlock(nint lk) {
        atomic_stlr_raw(lk, 0);
    }

    // 返回句柄(指针);0 = 分配失败。创建与 C 版同为普通写(线程内约定)。
    public static long atomic_int_create(long initial_value) {
        nint p = calloc(1, 8);
        if (p == 0) { return 0; }
        Span<long> v = new Span<long>(p, 1);
        v[0] = initial_value;
        return (long)p;
    }

    public static void atomic_int_destroy(long handle) {
        cfree((nint)handle);
    }

    public static long atomic_int_load(long handle) {
        nint p = (nint)handle;
        if (p == 0) { return 0; }
        return atomic_ldar_raw(p);
    }

    public static void atomic_int_store(long handle, long new_value) {
        nint p = (nint)handle;
        if (p == 0) { return; }
        atomic_stlr_raw(p, new_value);
    }

    // 返回新值(add_fetch 语义;casal 环,与全屏障 fetch-add 线性化
    // 等价);空句柄 0。
    public static long atomic_int_add(long handle, long delta) {
        nint p = (nint)handle;
        if (p == 0) { return 0; }
        long seen = atomic_ldar_raw(p);
        while (true) {
            long w = atomic_cas_raw(p, seen, seen + delta);
            if (w == seen) { return seen + delta; }
            seen = w;
        }
    }

    // 返回旧值(exchange 语义);casal 环,每次失败的见证值直接当下一轮
    // expected——比旧 CAS+load 循环少一次非原子读。
    public static long atomic_int_exchange(long handle, long new_value) {
        nint p = (nint)handle;
        if (p == 0) { return 0; }
        long seen = atomic_int_load(handle);
        long done = 0;
        while (done == 0) {
            long w = atomic_cas_raw(p, seen, new_value);
            if (w == seen) { done = 1; }
            else { seen = w; }
        }
        return seen;
    }

    // oracle 语义:无论成败都返回比较时看到的旧值;空句柄 0。
    public static long atomic_int_compare_exchange(
            long handle, long expected, long desired) {
        nint p = (nint)handle;
        if (p == 0) { return 0; }
        return atomic_cas_raw(p, expected, desired);
    }

