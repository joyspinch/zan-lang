// crt-transition/runtime_core.zan — Zan 实现的过渡期运行时(第一~十四批)。
//
// 取代 zanstubs.c / zanhost.c 中的(用 -DZAN_RT_CORE_ZAN 从 C 侧编出):
//   第一批:zan_monotonic_ns / zan_monotonic_us / zan_sha256 / zan_sha512
//   第二批:zan_alloc / zan_free / zan_crc32(stdlib NativeMemory.Alloc/
//           Free/Crc32 经 EntryPoint 改名指向这组符号——DllImport 的
//           EntryPoint 就是改名机制,无需动编译器)
//   第三批:zan_pkg_fopen / zan_file_fopen / remove / rename / read_path、
//           FileStream 八件套(open/read/write/seek/tell/flush/close/eof)、
//           FileInfo 五件套(length/attributes/time/set_readonly/set_time)、
//           try_lock/unlock、zan_embed_*(诚实空集)、zan_mmap_*(诚实桩)
//   第四批:zan_plat_net_interfaces(getifaddrs 全走查、地址折叠、
//           if_nametoindex、MAC 大写十六进制)、zan_plat_icmp_ping
//           (SOCK_DGRAM→SOCK_RAW 回退、poll 状态机、EINTR 重试、
//           原始模式 IP 头偏移)——至此 zanhost.c 在 -D 下整体清零
//   第五批:zan_io_* 纯函数族 17 符号——socket send/recv/alive/ready/
//           cleanup、socket_peer_ip(+into)、sockaddr_ip_str(+into)、
//           sockaddr_family/is_safe、resolve_sa/ipv4/all(+async)、
//           connect_sa/connect_status。native io reactor(watch 表、
//           close_notify、poll、DNS worker)仍留 zanstubs.c,五个
//           await 形态等后续批次。
//   第六批:zan_atomic_int_* 七符号(create/destroy/load/store/add/
//           exchange/compare_exchange;RMW 走 OSAtomic,见追加约束)。
//   第七批:zan_audio_* 21 桩(driver/error 返回 lit_buf[32] 的
//           "stub")、zan_monitor_enter/exit、zan_dispatch_*(CAS 自旋
//           锁环)、zan_eh_tls_state(pthread key)——线程族
//           (zan_thread_*)当时因 naked asm + 函数指针仍留 zanstubs.c,
//           第十批收回。
//   第九批:native io reactor 8 符号——io_wait_co/io_recv_co/
//           io_recv_to_co/io_accept_co/io_poll/io_close_notify/
//           resolve_sa_co/resolve_ipv4_co(watch 表、零超时探测、
//           DNS 自管道 + 脱离 worker、互斥交棒)。当时 C 侧还留 4 个
//           内部 thunk(见第十批)。
//   第十批(缺口五):语言级函数指针落地后的 C thunk 清算——
//           zan_set_ready_hook(编译器发射的 _zan_co_ready 自注册)、
//           zan_thread_start / zan_thread_current_id(原 C zan_thread_*)、
//           [ThreadEntry] zan_thread_trampoline(x19-x28 序言/收尾,替
//           代 zanstubs.c 的 naked asm 屏障;pthread_create 的 start
//           routine 与 Zan 方法体之间的被调者保存寄存器边界)、DNS
//           worker 体(dns_worker_job,经 trampoline 的 fn(env) 裸调
//           进入)+ 自管道(dns_pipe_ensure,F_SETFL 非阻塞)+ 互斥摘链
//           (dns_mu/dns_done)全部改本文件实现。zt_io_resume/
//           zt_dns_worker_fn/zt_dns_drain/zt_dns_pipe_rd 四个 C thunk
//           与 naked trampoline 一并退役;C 基线车道(zanstubs_full)
//           保留原样供 A/B,zan 车道的 zanstubs_rest.o 里这一族清零。
//   第十一批:多线程正确性清算——monitor 换真 64 条纹递归 pthread 锁
//           (第七批的条纹计数器退役),原子族换 [AtomicCas]/
//           [AtomicLoad]/[AtomicStore] 内建(casal/ldar/stlr,与 clang
//           对 SEQ_CST __atomic 的降码同款),全部惰性静态过 rt_init_lk
//           双检锁,st/d 三处自旋解锁补 release 屏障,sockaddr 文本/
//           网卡快照缓冲每线程一块(rt_tls)。
//   第十二批:内存管理清算——Span 视图的每次堆分配退役(编译器侧,
//           本文件零改动即受益):视图构造(new Span<T>/AsSpan/Slice)
//           落每构造点私有 16B 帧槽,赋值进 Span 局部按 {base,len} 对
//           拷贝(值语义),形参进序归一化为槽内对(by-value 下传)。
//           逃逸面按 C# ref-struct 规则响亮拒绝:返回/字段/静态/
//           捕获/List/Dict 元素、ref 形参(见 ngen 六处诊断)。
//   第十三批:最后一个 C 族清算——裸名 mem 六件(Copy/Fill/Compare/
//           Find/GetString/PutString)与 Win32 文本两件
//           (MultiByteToWideChar/WideCharToMultiByte,原 C 侧是
//           return-0 空桩、Wide.Of 只能产空串)全部改本文件真实现:
//           mem 系走别名 libc(zmemmove/zmemcmp/zmemchr),GetString
//           按 ARC 布局手搓([rc:8][0x5A414E53|len:8][data][NUL]),
//           文本转换按 Win32 CP_UTF8 65001 语义(flags=0、
//           非法序列替 U+FFFD、-1 计 NUL、零缓冲查尺寸、缓冲不足
//           返 0、其他代码页返 0)。stdlib 四处 EntryPoint 同批改名
//           (NativeMemory 六件 + Interop/Process/Directory/Pinyin 的
//           Wide 面),从此 darwin 车道链接只需 runtime_core.o——
//           自举定点 run.B34Of5 即零项目 C 链接,zanstubs_rest.o
//           清零(裸名遗留面只存于 C 基线 zanstubs_full 供 A/B)。
//   第十四批:目标无关面落地,linux 车道同样零项目 C——发射器
//           (ngen_host 的 digests/hmac/nm_sha/guid/exedir/threadid、
//           ngen_string 的跨页 header 快照、ngen_guard 的日志锁)与
//           stdlib AppPath 改调本文件的 md5/sha1/hmac_sha256/
//           sha256/urandom/vm_read/lock_enter/lock_exit/exe_path/
//           thread_current_id,CommonCrypto/mach/os_unfair_lock/
//           _NSGetExecutablePath/pthread_threadid_np 从发射面退役;
//           exe_path 按"预设容量、单发调用"契约双平台统一(darwin
//           _NSGetExecutablePath 直通,Linux /proc/self/exe readlink
//           补 NUL);stat/errno/mutexattr/自旋族按 MACOS/LINUX 条件
//           化(OSAtomic CAS 退役,atomic_cas_raw 自旋 + stlr 释放);
//           zanlinuxshims.c(558 行 Darwin 面模拟)就此退役,
//           linux_vehicle 链接只剩 runtime_core.elf.o + musl。
// 由原生自举编译器(ngen)编译为 arm64 可重定位对象,再经
// localize_syms.py 把 API 面之外的符号本地化——ngen 会把整套运行时
// 帮助函数以全局符号发射进每个对象,不本地化则与程序对象撞符号。
//
// 语义与 zanstubs.c 逐符号一致(CLOCK_MONOTONIC、FIPS 180-4、
// len<0 钳 0、大端摘要输出、calloc 清零分配、CRC-32 IEEE 反射)。
// SHA 输入经 memcpy 整块搬入暂存缓冲再调度,与 C 版的逐块指针遍历等价。
//
// 已知代价(第十二批清算后仅存其一):本文件自管的块(malloc/calloc
// 暂存)仍按"用点即弃"分配;Span 视图自第十二批起是编译器帧槽,零堆
// 分配、零泄漏——同对象旧版每次视图求值泄漏 16B 的账面随之清零。
//
// 约束:不 using stdlib(Span 是 binder 内建,libc 直调);数值一律
// long + >>>(恒逻辑右移)+ 掩码,不依赖 uint/ulong 的移位语义;
// 消息长度限 int 正范围(<2^31),与 ngen 调用方的钳制一致。
//
// 第三批追加约束:stdlib 声明的 string/byte[] 形参在此一律收 nint——
// 同一整数槽位,ABI 与 C 实现逐位一致(隐式 string→nint、(long)/(nint)
// 强转、静态字段惰性初始化均经探针验证)。struct stat 按 macOS arm64
// 布局硬编码(144 字节:mode@4 atime@32 mtime@48 ctime@64 size@96,
// 经 offsetof 验证)。embed 族为弱符号(localize_syms.py --weaken,
// N_WEAK_DEF):ngen 会把 embed 家族连同样子数据烘焙进带内嵌资源的
// 程序对象(tryget_pinyin/file_embed_*),弱符号让程序自己的强定义
// 赢;不带资源、只经 DllImport 调 API 的程序(如 native_rt_core 的
// 诚实空集用例)仍解析到这里。
// try_lock 代际表为进程内三块 calloc 静态,表变动(rt_lock 临界区)与
// C 版 zan_fh_lock 同款;锁本体是 BSD flock(flock 本身留在临界区外)。
// read_path/embed_list 返回 malloc 的 C 串(每次
// 全新,调用方拥有),与 C 版 strdup 契约一致;该 string 返回 ABI 在
// 托管侧目前是休眠路径(编译器本体只走 pkg_fopen+fread)。
//
// 第四批追加约束:sa_family_t 是 u8(Darwin),offset 1——不能并读
// offset 2(sockaddr_in 是端口、sockaddr_dl 是 sdl_index,均非零)。
// freeifaddrs 收链表头(*listp)而非持有者指针,否则持有者被二次
// 释放。getifaddrs 节点 ifaddrs 为 56 字节:ifa_next@0 ifa_name@8
// ifa_flags@16 ifa_addr@24。net 行拼装为手工 memcpy(格式字面量、
// 十进制、'0'/'1'、'\t'、',' 均在 lit_buf 静态区按字节备好),不使
// 用 snprintf。
//
// 第五批追加约束:公开方法名即导出名(mangling 是 _{Class}_{Method}),
// stdlib 的 EntryPoint="zan_io_*" 要求方法名本身带 io_ 前缀(io_socket_
// send…);曾按 socket_send 命名导致导出 _zan_socket_send 被 localize,
// 37 kept 未涨——导出名与 allowlist 对不上的第一症状就是 kept 计数
// 不变。addrinfo 节点 48 字节,Span<long>(p,6) 读:family=ph[0]>>>32、
// socktype=ph[1]&0xFFFFFFFF、addrlen=ph[2]&0xFFFFFFFF、addr=(nint)ph[4]、
// next=(nint)ph[5];hints 只填 hv[0]=family<<32、hv[1]=SOCK_STREAM。
// getaddrinfo 的 service 形参收十进制字节串(uderc_into 写数字、调用
// 方补 NUL——不写 NUL 是它区别于 ip 文本化拷出的契约点)。fd_set 是
// 128 字节/16 个 long:bit=1L<<(fd%64)、slot=fd/64,select 之后一律
// 取新 Span 视图重读(跨 DllImport 持有的视图不可靠,同缺口 2 纪律)。
// v6 逐字节规则里字节取反用 255-x(^ 未验证)。SIGPIPE 惰性忽略:
// csignal(13,1) 取旧 handler,非 0 则装回;第十一批起探测+条件装回
// 在 sigpipe_lk 自旋锁内串行,并发首用 socket 不互覆。
//
// 第六批追加约束(第十一批重写):add 走 OSAtomicAdd64Barrier(恰为
// add_fetch 全屏障);exchange/compare_exchange/load/store 走
// [AtomicCas]/[AtomicLoad]/[AtomicStore] 内建(casal/ldar/stlr,与
// clang 对 C11 __atomic SEQ_CST 的 arm64 降码同款,LSE 全系支持)——
// compare_exchange 无论成败都返回比较时刻看到的旧值,第六批的
// load-after-fail 文档化偏差就此退役。add 改 casal 环 fetch-add、
// 各处自旋锁统一 rt_cas_lock/rt_cas_unlock(casal CAS 0→1 acquire +
// stlr store 0 release)——OSAtomic 两符号第十四批退役。
//
// 第七批追加约束:lit_buf[32..36] 存 "stub"(lit_init 追加,不影响
// 既有偏移)。monitor 第十一批换真 64 条纹递归 pthread 锁(条纹折叠
// 与 oracle 逐字同款,第七批的乘法散列退役);dispatch 保持 OSAtomic
// CAS 自旋锁(0 闲 1 忙)替代 pthread mutex:互斥等价,争用下自旋;
// dispatch 保持 CAS 自旋锁(0 闲 1 忙;原 OSAtomic,第十四批起
// rt_cas_lock 内建环)替代 pthread mutex:互斥等价,争用下自旋;
// 环状态在 calloc 控制块(自旋/容量/头/尾/环
// 指针),静态只存块指针、用点取新局部(缺口 2 纪律),grow 的头尾
// 迁移与 C 版逐字对齐(head=0、tail=存活数)。eh_tls_state 的
// __thread 槽位换成 pthread specific key(key_create 无析构 +
// get/setspecific;key_t 是 unsigned long)。double 形参/返回可用:
// 0.0 走 (double)0L 显式转换,不写字面量。
//
// 第八批追加约束:shared_table 的块布局自定(不必对齐 C zt_table,
// A/B 只对符号级行为负责)——表块 3152B 十槽([0]名串 [1]容量 [2]键长
// [3]列数 [4]行距 [5]行链头 [6]行数 [7]在册 [8]自旋锁,字节 64 即锁),
// 列区从 80 起每列 96B(type/size/offset 三 long + 名 64B NUL 垫),
// 行块 48B 六槽(next/hash/键副本/alive/expires_at/data)。三个 C 怪癖
// 按 oracle 逐字保留:墓碑复用不更新键副本(zt_row_for 只刷
// hash/expires/data/alive,复用行对 find-by-key 不可见);lock_acquire
// 先 purge(调用方 now)——到期租约(<=now)即清、absent 重建返回 1;
// lock_release 用墙钟 purge——未到期租约也被清、后续 release 找不到
// 行返回 0。schema 解析:C 的 *p++ != ':' 无论成败都消耗冒号(i/f 型
// 漏消耗会让列名带前导冒号、int/float 列永不匹配、string 型却正常,
// 本次翻车根因);判重是 strlen 等长 && memcmp(纯前缀 memcmp 会把
// "a" 误判为 "ab" 的重名);ncol>=32 的拒绝在条目顶部(C 循环顶)。
// FNV-1a 的 XOR 以 (a|b)-(a&b) 恒等式实现(^ 未验证);_at 族的占位
// 键 = 哈希十进制串(udec_into 不写 NUL,调用方补)。哈希值不钉进
// 金标——FNV 质数乘法恒定但探针观测过值随实现细节漂移的先例,金标
// 只断言 != 0。指针算术一律经 st_ptr(long) 两步:((nint)(表达式))
// 括号强转被解析器当方法调用(见缺口 3 旁注),(nint)标识符才合法。
//
// 第十批追加约束:本批新增静态一律零值哨兵(见 dns_pipe_r 注释)——
// 静态字段初始化器经启动垫片写运行期存量,只对持有 Main 的对象生效,
// 库对象数据段恒零(缺口三 strpool init 的同族教训)。fcntl(3 参)
// 必须声明 Variadic=true(2 定参 + 调用点补尾参):纯声明把第三参放
// 寄存器、被调方 va_arg 读栈拿到垃圾——F_SETFL"成功"设错标志,自
// 管道排干 blocking read 冻死(io_socket_ready 的同款旧声明一并修正;
// C 车道一直是真 fcntl,此项修复使 A/B 首次逐位一致)。委托对
// {fn@0, env@8} 传给 thread_trampoline 的 fn 是裸代码地址(方法组
// cast 或委托 thunk),trampoline 显式 |1 强制裸形态——interned 委托
// 的 thunk 字段是裸地址,按 even 读会把代码当指针。dns_pipe_ensure
// 的 O_NONBLOCK=0x4 与 F_GETFL=3/F_SETFL=4 是 Darwin 常数,本对象只
// 入 macOS 车道;ELF 车道的对应实现走 linux 车道对象。
//
// 第十一批追加约束:rt_init_lk 是全部惰性静态的唯一串行化点,双检锁
// 形态 `if (X == 0) { rt_lock(); if (X == 0) { X = build(); }
// rt_unlock(); }`——calloc 失败保持 0,下次调用自然重试,无需 built
// 旗标。rt_lock 是 OSAtomic CAS 自旋(Barrier 变体,acquire),
// rt_unlock 是 OSAtomicAdd64Barrier(-1)(release):平铺 store 解锁
// 没有 happens-before 边,后到的持锁方可能看不到锁内写入——这同时
// 修掉 st_unlock/st_unspin/d_unlock 三处既有自旋的同一缺口。持
// rt_init_lk 只准做快系统调用(叶锁),不得进入任何可能再取
// rt_init_lk 或阻塞的路径;依赖先 ensure(lit 之于 app_dir)、永不
// 嵌套。[StaticAddr("fld")] 方法由 ngen 发 adrp+add 取静态数据全局
// 地址——普通表达式取不到静态地址,自旋锁落在静态单元全靠它。原子
// 内建的占位体即文档,发射即实现。Darwin 实测常数:PTHREAD_MUTEX_
// RECURSIVE=2、pthread_mutexattr_t=16B、pthread_mutex_t=64B。rt_tls
// 每线程刮擦块([0..128) sockaddr 文本、[128..67808) 网卡快照),契约
// "活到本线程下次调用"。io reactor watch 表(io_ws/io_n/io_cap)仍
// 只被主线程触碰——那是 reactor 的属主模型(与 oracle 相同),不是
// 本批未清的假设。
//
// 第九批追加约束:watch 表为私有布局 80B/项(fd/kind/active/buf/len/
// deadline/frame/step/outn/垫),静态只存 io_ws/io_n/io_cap 三个
// 指针计数(缺口 2 纪律),grow 用 calloc+memcpy+free(不用 realloc)。
// co 助手在系统调用前一律先零超时 poll 探测(zt_fd_ready 语义):
// accept 出的套接字常被调用方留在阻塞态,直接阻塞会冻死单线程引擎。
// DNS 作业块布局(80B:next@0 name@8 port@16 buf@24 cap@32 outn@40
// frame@48 step@56 result@64 v4@68)是第九批与 C worker 的共享契约,
// 第十批 worker 移入本文件后成为纯内部布局。worker 线程体、完工链
// 互斥、自管道读端原经 zt_dns_worker_fn/zt_dns_drain/zt_dns_pipe_rd
// 三个 C thunk(缺口 5),第十批改 dns_worker_job + dns_mu/dns_done +
// dns_pipe_ensure(读端 F_SETFL 非阻塞——排干到 would-block 而不是
// 冻死;O_NONBLOCK=0x4 是 Darwin 常数,本对象只入 macOS 车道),
// ready 队列仍只被主线程触碰。恢复原经 zt_io_resume thunk(hook
// 指针的间接调用,缺口 5),第十批改 io_resume:(委托)nint 裸调;
// hook==0 的非 async 程序里它是空操作,语义只经 outn 槽与 poll 返回
// 值观察。byte 事件位拼装按 int 收拾,revents 在 +6 处用两 byte 拼回
// (短整型 ABI 只保证低字节可靠)。
//
// 已发现编译器缺口(ngen;本文件全部绕行;缺口 1/2/3/4 已分别在缺口一/
// 二/三/四批次修复,其余仍开放):
//   1) 变参调用降级【缺口一,已修】——原状:[DllImport(Variadic=true)]
//      机器全在(ast 属性/parser MOD/ngen PushCallArgs 与 CallStaticNg)
//      且 Apple 车道实测可用,但零文档零覆盖,ELF 车道更错:ngen 的
//      尾参一律按 Apple arm64 落栈变参区,而 aarch64-linux(实测定案,
//      clang -target aarch64-none-linux-gnu 反汇编 oracle)变参按自然
//      类型继续常规分配(int 尾参续 w 序、double 直接入 d 序、float 按
//      C 默认提升为 double),Apple 式落栈在 ELF 上被被调方按寄存器读
//      →垃圾。第二受害面:三参 open——C 里 open 本就是变参函数,mode
//      由 va_arg 读出;纯声明调用点把 mode 放寄存器、被调方读栈,拿到
//      040/100/200/740 等链接布局垃圾(file_lock 翻车根源)。修复
//      (ngen CallStaticNg 三处):(a) ELF 车道(dllVar 且
//      ZAN_TARGET=aarch64-linux)尾参进尾参分配循环:fp 类(IsDblExpr
//      或 float 型)续 cf<8→d 序否则溢出槽,其余续 ci<8→x 序否则溢出
//      槽,sres 计入尾参溢出;求值仍写 8*sres+8*vk 暂存槽,新增 ELF
//      读回段把暂存搬进寄存器/溢出槽(fmov dN,x10 / str 双字,无单精
//      窄化——提升已保证 double 位型)。(b) Apple 车道尾参基址由
//      8*sres 改 8*cs(未填充溢出数):va_list 从具名栈参之后开始,
//      奇数个定长溢出参时 16 对齐垫会把尾参整体推后 8 字节(companion
//      C 探针 probe9=9 定长 int+尾参实测 1058≠2160,修复后 2160)。
//      (c) 永久金标:tests/selfhost/native_varargs.zan(open 尾参
//      mode→stat 回读 33188=S_IFREG|0644、snprintf 5/8 尾参、fcntl
//      F_GETFL)入默认电池;tests/selfhost/native_varargs_elf.zan
//      (snprintf/printf:混合类 5 尾参、8 int 尾参寄存器耗尽+溢出、
//      double/float 提升尾参、类交错、定长-only)入电池与 crossboot
//      默认清单(qemu 执行,与 macOS 车道输出字节一致);对抗探针
//      probe9(定长溢出+尾参混排)/probef(d0..d7 耗尽+double 尾参溢出
//      +int 尾参 x0)双车道 2160/1020.0 一致。变参 libc 函数现已可从
//      本文件 DllImport;缺口一绕行件 zan_open_creat 随之退役(本文件
//      copen2 改直接 [DllImport(Variadic=true)] open 三参调用,
//      zanstubs.c 包装定义删除,零 C 程序链接的锁定 C 符号账面
//      21→20)。
//   2) 静态字段上的 Span 视图【缺口二,已修】——残面是 Span<T> 类型
//      的静态字段(裸名与类限定)读写全部落"unsupported (assignment|
//      index) target"编译错:SpanContainerTy 只认局部与实例字段,
//      读/写/Length/IsDblExpr/Slice 六个消费点一并漏静态。修复:对齐
//      ArrContainerTy 补静态两分支。注意当年 probe_va2 的"静默错写"
//      与"跨 DllImport 持视图"症状已被既往批次顺带治好(探针实测
//      DirectStatic=421422、跨导入 99098 全对),本批只剩响亮编译错
//      面。本文件"静态只存块指针、用点取新局部"的写法保留(大面积
//      改写零收益,风格保守),但 Span 类型静态字段现已可用;async 方
//      法内的 Span 存储是独立既有局限(await 穿越臂从未支持任何
//      Span 存储,连局部视图也不支持),未在本批打开。`this.静态` 全
//      车道不支持(普通静态同报错),非 Span 特有。
//   3) 字符串字面量经数据槽间接寻址【缺口三,已修】——原状:LoadStr
//      读 l_.g.strp.N 槽,槽由 _zan_rt_strpool_init 在启动垫片里盖章
//      (分配堆串+memcpy+盖 SNAZ|len 头),而该 init 只在持有 Main 的
//      对象被调用→第二个 ngen 对象的槽恒 0,litlib 探针实测 Greet 返
//      null、Length/索引踩 null reference。修复(ngen 四处):字面量
//      改为直接寻址的初始化数据块——DGlob 增加 bytes 载荷,每字面量
//      发 8 对齐的 l_.g.strd.N 块(rc=-1 不朽哨兵(64 位域,同反射
//      blob 先例;本车道无任何 rc 递减路径)+ SNAZ<<32|len 头 + 字节
//      +NUL +对齐垫),LoadStr 变 adrp+add 后 add #16 取载荷指针,三
//      个目标写手(macho/elf/coff)的 __data 载荷改经 EmitDataPayload
//      发已初始化字节;_zan_rt_strpool_init 保留为空函数(启动垫片仍
//      调用,过渡符号)。原始 l_.str.N cstring 及其 ~12 处直用点(守
//      卫/数值/async/反射/obj/host 的 C 串实参)不变。本文件"运行时
//      内不写字面量、libc 名字/格式串 lit_buf 拼字节"的纪律保留(无
//      害且省得逐处重验),但就不再有编译器层面的强制理由。
//   4) double 边界【缺口四,已修,全矩阵验证绿】——原状三层:字面量
//      惰性 dbl.N 槽 + 运行时 strtod(字面串槽),非首对象
//      fastParse64(NULL) 段错误;导出方法体直收 C ABI 调用(double
//      形参在 d 寄存器被按 x 寄存器读、返回位型放 x0 被按 d0 读);
//      Span<double> 元读被静态当 long,赋给 double 局部再 scvtf 一次
//      (第八批 get_float 值路径即此潜伏 bug,fixture 当时只验行管理
//      语义;第七批 audio 的 == 0.0 断言只是 scvtf 的 0.0 恰好留在
//      d0 才通过)。修复(ngen 三处):(a) 字面量改编译期 strtod 位型
//      + LoadImm 直发 movz/movk(DblBitsOf,任意对象序成立);(b)
//      方法体改名 `_Cls_meth__body` 且全部内部引用(BLInternal/
//      vtable/委托/方法组/反射 thunk/async ramp/$resume)自动指向
//      body,导出名上发 C-ABI 垫片:整形槽降序搬移 + fmov x_q, d_vi
//      (float 形参经 fcvt d16)重排入参,fmov d0, x0 / fcvt s0, d16
//      收返回,>8 槽或聚合签名回退纯分支(与旧布局字节同形);垫片
//      自存 x29/x30(bl body 会打 lr),ldp 后索引必须与 stp 的 #16
//      一致;(c) IsDblExpr 的 Index 分支补 SpanContainerTy 情形。
//      本文件的 (double)0L 写法保留(无害)。第八批 fixture 的
//      float 段已升级为逐位值往返(1.5/0.1/-0.75/π,双配置字节
//      一致);第七批 audio 断言经垫片后成为真 ABI 返回验证。
//   5) 无间接调用/函数指针【缺口五,已修】——原状:LoadSymRef 可取
//      全局地址,但不能经寄存器 blr,委托机器(_zan_dlg_intern intern
//      对)之外无法调用运行期解析的地址。受害形态:协程恢复 hook
//      (zan_co_ready_hook)、pthread_create 的线程体、DNS 完工链互斥
//      摘链与自管道读端——全部绕行 C thunk(zt_io_resume/
//      zt_dns_worker_fn/zt_dns_drain/zt_dns_pipe_rd + naked asm
//      zan_thread_trampoline,与已退役的 zan_open_creat 同形态)。
//      修复(oracle 双形态考古定案:委托值 bit0 为形态标记):
//      (a) 编译器 (委托类型)nint 转换把值打上 |1 裸标记(orr x0,x0,#1;
//      方法组 (nint)Static 本就发裸代码地址,even);(b) 调用点
//      emit_delegate_invoke 分岔:tbnz x0,#0 走裸——and x9,x0,#~1 取
//      址进 x9(必须先于移参:移参 mov x0,x1… 会先毁掉 x0 里的值,
//      首版即栽在这),args x1..x7 下移 x0..x6,blr x9 无 env;even
//      走 interned——[x9]=[x0+0] thunk、x0=[x0+8] env,blr。两形态
//      共用同一调用点。(c) [ThreadEntry] 方法属性(parser/ast MOD
//      524288):序言扩展帧 +96 并成对保存 x19-x28(POSIX 线程入口
//      是 C→Zan 边界,libpthread 在被调者保存寄存器里放线程自指针;
//      局部全部 x29 相对,帧扩展对方法体透明),收尾 mov sp,x29 后
//      逐对恢复;与 Async 同用报错。(d) 泛型 cast 解析:parser 新增
//      IsGenericCast((Ident<…>)仅当配平 > 后是 ")"+操作数头才认作
//      cast,(Func<long,long,long>)(nint)Add 可链式)。永久金标
//      native_fnptr(裸往返 + interned lambda 同点交错 + 越方法边界
//      + Action<nint> 形状)入电池。runtime 收编:set_ready_hook/
//      io_resume(裸调 hook,签名字面等价 _zan_co_ready)、
//      thread_trampoline(+ThreadEntry)/thread_start/
//      thread_current_id、dns_worker_job/dns_pipe_ensure/dns_mu_ensure
//      全部 Zan 实现;四个 zt_* C thunk 与 naked trampoline 退役,
//      C 基线车道原样保留供 A/B。
//
// 命名纪律:libc 导入一律别名(cfree/malloc/…),公开 ABI 方法名
// (free/alloc/crc32/…必须与 libc 导入名错开——同类两个方法名会
// 触发重载 mangling(_zan_free__…),破坏符号契约。

class zan {
    [DllImport("crt", EntryPoint = "malloc")]
    public static extern nint malloc(long size);
    [DllImport("crt", EntryPoint = "calloc")]
    public static extern nint calloc(long nmemb, long size);
    [DllImport("crt", EntryPoint = "free")]
    public static extern void cfree(nint p);
    [DllImport("crt", EntryPoint = "memset")]
    public static extern nint memset(nint p, int v, long n);
    [DllImport("crt", EntryPoint = "memmove")]
    public static extern nint zmemmove(nint dst, nint src, long n);
    [DllImport("crt", EntryPoint = "memcmp")]
    public static extern int zmemcmp(nint a, nint b, long n);
    [DllImport("crt", EntryPoint = "memchr")]
    public static extern nint zmemchr(nint p, int v, long n);
    [DllImport("crt", EntryPoint = "memcpy")]
    public static extern nint memcpy(nint dst, nint src, long n);
    [DllImport("crt", EntryPoint = "clock_gettime")]
    public static extern int clock_gettime(int clk, nint ts);

    // void *zan_alloc(int size):清零分配,size<=0 退化 1 字节
    public static nint alloc(int size) {
        return calloc(1, size > 0 ? size : 1);
    }

    // void zan_free(void *p):free(0) 为无操作(libc 语义)
    public static void free(nint p) {
        cfree(p);
    }

    // long long zan_monotonic_ns(void):macOS CLOCK_MONOTONIC=6
    // (_time.h:159);struct timespec = {long tv_sec; long tv_nsec}。
    public static long monotonic_ns() {
        nint ts = malloc(16);
#if MACOS
        clock_gettime(6, ts);      // darwin CLOCK_MONOTONIC
#else
        clock_gettime(1, ts);      // linux CLOCK_MONOTONIC(6 在 linux 是 BOOTTIME)
#endif
        Span<long> v = new Span<long>(ts, 2);
        long ns = v[0] * 1000000000L + v[1];
        free(ts);
        return ns;
    }

    // int64_t zan_monotonic_us(void)
    public static long monotonic_us() {
        return monotonic_ns() / 1000;
    }

    static long rot32(long x, int n) {
        return ((x >>> n) | (x << (32 - n))) & 0xFFFFFFFFL;
    }

    static long rot64(long x, int n) {
        return (x >>> n) | (x << (64 - n));
    }

    // SHA-256 压缩函数:w 为已展开的 64 字消息调度
    static void rounds256(long[] h, long[] K, long[] w) {
        int i = 16;
        while (i < 64) {
            long wm15 = w[i - 15];
            long s0 = (rot32(wm15, 7)) ^ (rot32(wm15, 18)) ^ (wm15 >>> 3);
            long wm2 = w[i - 2];
            long s1 = (rot32(wm2, 17)) ^ (rot32(wm2, 19)) ^ (wm2 >>> 10);
            w[i] = (w[i - 16] + s0 + w[i - 7] + s1) & 0xFFFFFFFFL;
            i = i + 1;
        }
        long a = h[0]; long b = h[1]; long c = h[2]; long d = h[3];
        long e = h[4]; long f = h[5]; long g = h[6]; long hh = h[7];
        i = 0;
        while (i < 64) {
            long S1 = (rot32(e, 6)) ^ (rot32(e, 11)) ^ (rot32(e, 25));
            long ch = (e & f) ^ (~e & g);
            long t1 = (hh + S1 + ch + K[i] + w[i]) & 0xFFFFFFFFL;
            long S0 = (rot32(a, 2)) ^ (rot32(a, 13)) ^ (rot32(a, 22));
            long maj = (a & b) ^ (a & c) ^ (b & c);
            long t2 = (S0 + maj) & 0xFFFFFFFFL;
            hh = g; g = f; f = e;
            e = (d + t1) & 0xFFFFFFFFL;
            d = c; c = b; b = a;
            a = (t1 + t2) & 0xFFFFFFFFL;
            i = i + 1;
        }
        h[0] = (h[0] + a) & 0xFFFFFFFFL;
        h[1] = (h[1] + b) & 0xFFFFFFFFL;
        h[2] = (h[2] + c) & 0xFFFFFFFFL;
        h[3] = (h[3] + d) & 0xFFFFFFFFL;
        h[4] = (h[4] + e) & 0xFFFFFFFFL;
        h[5] = (h[5] + f) & 0xFFFFFFFFL;
        h[6] = (h[6] + g) & 0xFFFFFFFFL;
        h[7] = (h[7] + hh) & 0xFFFFFFFFL;
    }

    // 从暂存块视图展开前 16 个字(写进 w);与 rounds256 分离是因为
    // 早期 Span 视图不能作形参——第十二批起视图形参按帧箱值语义健全
    // (进序把调用方箱的 {base,len} 对拷入形参槽),函数形状保留。
    static void sched256(long[] w, Span<byte> b) {
        int j = 0;
        while (j < 16) {
            w[j] = ((b[j * 4] << 24) | (b[j * 4 + 1] << 16) | (b[j * 4 + 2] << 8) | b[j * 4 + 3]) & 0xFFFFFFFFL;
            j = j + 1;
        }
    }

    // void zan_sha256(const void *data, long long len, unsigned char *md)
    public static void sha256(nint data, long len, nint md) {
        long[] K = new long[] { 0x428a2f98, 0x71374491, 0xb5c0fbcfL, 0xe9b5dba5L, 0x3956c25b, 0x59f111f1, 0x923f82a4L, 0xab1c5ed5L, 0xd807aa98L, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1feL, 0x9bdc06a7L, 0xc19bf174L, 0xe49b69c1L, 0xefbe4786L, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da, 0x983e5152L, 0xa831c66dL, 0xb00327c8L, 0xbf597fc7L, 0xc6e00bf3L, 0xd5a79147L, 0x06ca6351, 0x14292967, 0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92eL, 0x92722c85L, 0xa2bfe8a1L, 0xa81a664bL, 0xc24b8b70L, 0xc76c51a3L, 0xd192e819L, 0xd6990624L, 0xf40e3585L, 0x106aa070, 0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3, 0x748f82ee, 0x78a5636f, 0x84c87814L, 0x8cc70208L, 0x90befffaL, 0xa4506cebL, 0xbef9a3f7L, 0xc67178f2L };
        long[] h = new long[] { 0x6a09e667, 0xbb67ae85L, 0x3c6ef372, 0xa54ff53aL, 0x510e527f, 0x9b05688cL, 0x1f83d9ab, 0x5be0cd19 };
        long total = len > 0 ? len : 0;
        long off = 0;
        nint blk = malloc(64);
        Span<byte> b = new Span<byte>(blk, 64);
        while (off + 64 <= total) {
            memcpy(blk, data + off, 64);
            long[] w = new long[64];
            sched256(w, b);
            rounds256(h, K, w);
            off = off + 64;
        }
        memset(blk, 0, 64);
        int t = (int)(total - off);
        memcpy(blk, data + off, t);
        b[t] = 0x80;
        if (t + 1 > 56) {
            long[] w = new long[64];
            sched256(w, b);
            rounds256(h, K, w);
            memset(blk, 0, 64);
        }
        long bits = total * 8;
        int i8 = 0;
        while (i8 < 8) {
            b[56 + i8] = (byte)((bits >>> (56 - 8 * i8)) & 255);
            i8 = i8 + 1;
        }
        long[] wf = new long[64];
        sched256(wf, b);
        rounds256(h, K, wf);
        Span<byte> outv = new Span<byte>(md, 32);
        int i = 0;
        while (i < 8) {
            outv[i * 4] = (byte)(h[i] >>> 24);
            outv[i * 4 + 1] = (byte)((h[i] >>> 16) & 255);
            outv[i * 4 + 2] = (byte)((h[i] >>> 8) & 255);
            outv[i * 4 + 3] = (byte)(h[i] & 255);
            i = i + 1;
        }
        free(blk);
    }

    // SHA-512 压缩函数
    static void rounds512(long[] h, long[] K, long[] w) {
        int i = 16;
        while (i < 80) {
            long wm15 = w[i - 15];
            long s0 = (rot64(wm15, 1)) ^ (rot64(wm15, 8)) ^ (wm15 >>> 7);
            long wm2 = w[i - 2];
            long s1 = (rot64(wm2, 19)) ^ (rot64(wm2, 61)) ^ (wm2 >>> 6);
            w[i] = w[i - 16] + s0 + w[i - 7] + s1;
            i = i + 1;
        }
        long a = h[0]; long b = h[1]; long c = h[2]; long d = h[3];
        long e = h[4]; long f = h[5]; long g = h[6]; long hh = h[7];
        i = 0;
        while (i < 80) {
            long S1 = (rot64(e, 14)) ^ (rot64(e, 18)) ^ (rot64(e, 41));
            long ch = (e & f) ^ (~e & g);
            long t1 = hh + S1 + ch + K[i] + w[i];
            long S0 = (rot64(a, 28)) ^ (rot64(a, 34)) ^ (rot64(a, 39));
            long maj = (a & b) ^ (a & c) ^ (b & c);
            long t2 = S0 + maj;
            hh = g; g = f; f = e;
            e = d + t1;
            d = c; c = b; b = a;
            a = t1 + t2;
            i = i + 1;
        }
        h[0] = h[0] + a;
        h[1] = h[1] + b;
        h[2] = h[2] + c;
        h[3] = h[3] + d;
        h[4] = h[4] + e;
        h[5] = h[5] + f;
        h[6] = h[6] + g;
        h[7] = h[7] + hh;
    }

    static void sched512(long[] w, Span<byte> b) {
        int j = 0;
        while (j < 16) {
            long word = 0;
            int k = 0;
            while (k < 8) {
                word = (word << 8) | b[j * 8 + k];
                k = k + 1;
            }
            w[j] = word;
            j = j + 1;
        }
    }

    // void zan_sha512(const void *data, long long len, unsigned char *md)
    public static void sha512(nint data, long len, nint md) {
        long[] K = new long[] { 0x428a2f98d728ae22L, 0x7137449123ef65cdL, 0xb5c0fbcfec4d3b2fL, 0xe9b5dba58189dbbcL, 0x3956c25bf348b538L, 0x59f111f1b605d019L, 0x923f82a4af194f9bL, 0xab1c5ed5da6d8118L, 0xd807aa98a3030242L, 0x12835b0145706fbeL, 0x243185be4ee4b28cL, 0x550c7dc3d5ffb4e2L, 0x72be5d74f27b896fL, 0x80deb1fe3b1696b1L, 0x9bdc06a725c71235L, 0xc19bf174cf692694L, 0xe49b69c19ef14ad2L, 0xefbe4786384f25e3L, 0x0fc19dc68b8cd5b5L, 0x240ca1cc77ac9c65L, 0x2de92c6f592b0275L, 0x4a7484aa6ea6e483L, 0x5cb0a9dcbd41fbd4L, 0x76f988da831153b5L, 0x983e5152ee66dfabL, 0xa831c66d2db43210L, 0xb00327c898fb213fL, 0xbf597fc7beef0ee4L, 0xc6e00bf33da88fc2L, 0xd5a79147930aa725L, 0x06ca6351e003826fL, 0x142929670a0e6e70L, 0x27b70a8546d22ffcL, 0x2e1b21385c26c926L, 0x4d2c6dfc5ac42aedL, 0x53380d139d95b3dfL, 0x650a73548baf63deL, 0x766a0abb3c77b2a8L, 0x81c2c92e47edaee6L, 0x92722c851482353bL, 0xa2bfe8a14cf10364L, 0xa81a664bbc423001L, 0xc24b8b70d0f89791L, 0xc76c51a30654be30L, 0xd192e819d6ef5218L, 0xd69906245565a910L, 0xf40e35855771202aL, 0x106aa07032bbd1b8L, 0x19a4c116b8d2d0c8L, 0x1e376c085141ab53L, 0x2748774cdf8eeb99L, 0x34b0bcb5e19b48a8L, 0x391c0cb3c5c95a63L, 0x4ed8aa4ae3418acbL, 0x5b9cca4f7763e373L, 0x682e6ff3d6b2b8a3L, 0x748f82ee5defb2fcL, 0x78a5636f43172f60L, 0x84c87814a1f0ab72L, 0x8cc702081a6439ecL, 0x90befffa23631e28L, 0xa4506cebde82bde9L, 0xbef9a3f7b2c67915L, 0xc67178f2e372532bL, 0xca273eceea26619cL, 0xd186b8c721c0c207L, 0xeada7dd6cde0eb1eL, 0xf57d4f7fee6ed178L, 0x06f067aa72176fbaL, 0x0a637dc5a2c898a6L, 0x113f9804bef90daeL, 0x1b710b35131c471bL, 0x28db77f523047d84L, 0x32caab7b40c72493L, 0x3c9ebe0a15c9bebcL, 0x431d67c49c100d4cL, 0x4cc5d4becb3e42b6L, 0x597f299cfc657e2aL, 0x5fcb6fab3ad6faecL, 0x6c44198c4a475817L };
        long[] h = new long[] { 0x6a09e667f3bcc908L, 0xbb67ae8584caa73bL, 0x3c6ef372fe94f82bL, 0xa54ff53a5f1d36f1L, 0x510e527fade682d1L, 0x9b05688c2b3e6c1fL, 0x1f83d9abfb41bd6bL, 0x5be0cd19137e2179L };
        long total = len > 0 ? len : 0;
        long off = 0;
        nint blk = malloc(128);
        Span<byte> b = new Span<byte>(blk, 128);
        while (off + 128 <= total) {
            memcpy(blk, data + off, 128);
            long[] w = new long[80];
            sched512(w, b);
            rounds512(h, K, w);
            off = off + 128;
        }
        memset(blk, 0, 128);
        int t = (int)(total - off);
        memcpy(blk, data + off, t);
        b[t] = 0x80;
        if (t + 1 > 112) {
            long[] w = new long[80];
            sched512(w, b);
            rounds512(h, K, w);
            memset(blk, 0, 128);
        }
        long bits = total * 8;
        int i8 = 0;
        while (i8 < 8) {
            b[120 + i8] = (byte)((bits >>> (56 - 8 * i8)) & 255);
            i8 = i8 + 1;
        }
        long[] wf = new long[80];
        sched512(wf, b);
        rounds512(h, K, wf);
        Span<byte> outv = new Span<byte>(md, 64);
        int i = 0;
        while (i < 8) {
            int j = 0;
            while (j < 8) {
                outv[i * 8 + j] = (byte)((h[i] >>> (56 - 8 * j)) & 255);
                j = j + 1;
            }
            i = i + 1;
        }
        free(blk);
    }

    // long long zan_crc32(const void *p, long long len):IEEE 802.3 反射
    // CRC32(poly 0xEDB88320),表驱动,返回零扩展的 32 位模式(消费方
    // 按 int 读即得符号域值,与 C 版逐位一致)。
    public static long crc32(nint p, long len) {
        long[] table = new long[256];
        int i = 0;
        while (i < 256) {
            long c = i;
            int k = 0;
            while (k < 8) {
                c = ((c & 1) != 0 ? (0xEDB88320L ^ (c >>> 1)) : (c >>> 1)) & 0xFFFFFFFFL;
                k = k + 1;
            }
            table[i] = c;
            i = i + 1;
        }
        long crc = 0xFFFFFFFFL;
        Span<byte> b = new Span<byte>(p, (int)len);
        long j = 0;
        while (p != 0 && j < len) {
            crc = table[(int)((crc ^ b[(int)j]) & 255)] ^ (crc >>> 8);
            j = j + 1;
        }
        return crc ^ 0xFFFFFFFFL;
    }

    // ------------------------------------------------------------------
    // 第三批:文件/包/embed/mmap 族(语义对照 zanhost.c 与 oracle
    // rt_file.c)。libc 导入全部 nint 形参;flock/fcntl 常量内联。
    // ------------------------------------------------------------------

