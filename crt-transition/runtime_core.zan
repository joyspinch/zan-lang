    static nint mon_tbl;
    static nint d_ctl_s;
    static long eh_key;
    static long eh_ready;


    // lock (obj) 监视器(十一批换真锁):C oracle 是 64 条纹递归
    // pthread 锁,本车道曾是条纹计数器(单线程假设)——缺口五起 DNS
    // worker 真在跑,计数器不提供互斥,lock 语句的契约被打破。现按
    // oracle 同构:64×64B pthread_mutex_t 块,递归型(attr type 2,
    // 重入合法),条纹折叠与 C 版逐字同款(^ 已验证,第七批的乘法散列
    // 退役);建立走 rt_lock 双检锁。条纹共享只会过度串行,不丢互斥。

    [DllImport("crt", EntryPoint = "pthread_mutexattr_init")]
    public static extern int cpthread_mutexattr_init(nint a);
    [DllImport("crt", EntryPoint = "pthread_mutexattr_settype")]
    public static extern int cpthread_mutexattr_settype(nint a, int t);
    [DllImport("crt", EntryPoint = "pthread_mutexattr_destroy")]
    public static extern int cpthread_mutexattr_destroy(nint a);

    static int mon_stripe(nint obj) {
        long bits = (long)obj;
        bits = bits ^ (bits >>> 20);
        bits = bits ^ (bits >>> 8);
        return (int)((bits >>> 4) & 63L);
    }

    static void mon_ensure() {
        nint t = mon_tbl;
        if (t != 0) { return; }
        rt_lock();
        t = mon_tbl;
        if (t == 0) {
            t = calloc(64, 64);
            nint ap = calloc(1, 16);
            if (t != 0 && ap != 0) {
                cpthread_mutexattr_init(ap);
#if MACOS
                cpthread_mutexattr_settype(ap, 2);   // Darwin PTHREAD_MUTEX_RECURSIVE
#else
                cpthread_mutexattr_settype(ap, 1);   // musl 的 RECURSIVE 是 1(2 是 ERRORCHECK)
#endif
                int i = 0;
                while (i < 64) {
                    cpthread_mutex_init(st_ptr((long)t + i * 64), ap);
                    i = i + 1;
                }
                cpthread_mutexattr_destroy(ap);
                mon_tbl = t;
            }
            if (ap != 0) { cfree(ap); }
            // t 分配失败保持 0:下次调用自然重试(与其它 ensure 同款)
        }
        rt_unlock();
    }

    public static void monitor_enter(nint obj) {
        mon_ensure();
        int s = mon_stripe(obj);
        cpthread_mutex_lock(st_ptr((long)mon_tbl + s * 64));
    }

    public static void monitor_exit(nint obj) {
        nint t = mon_tbl;
        if (t == 0) { return; }
        int s = mon_stripe(obj);
        cpthread_mutex_unlock(st_ptr((long)t + s * 64));
    }

    // UI 线程派发环:C 版 pthread mutex → OSAtomic CAS 自旋锁(0 闲 1
    // 忙,互斥等价,争用下自旋)。环状态在 calloc 控制块([0] 自旋
    // [1] 容量 [2] 头 [3] 尾 [4] 环指针),静态只存块指针、用点取新
    // 局部(缺口 2 纪律)。控制块惰性建立是单线程假设(与 try_lock
    // 代际表同款):两线程同时首用各建一块、后存者胜,先者的插入丢失
    // ——派发面程序启动即初始化,实际不发生。delegate 值是进程期
    // intern 块(_zan_dlg_intern),条目按裸指针搬移,C 版注释原样。
    static nint d_ctl() {
        nint t = d_ctl_s;
        if (t != 0) { return t; }
        rt_lock();
        t = d_ctl_s;
        if (t == 0) {
            t = calloc(1, 40);
            if (t != 0) {
                Span<long> v = new Span<long>(t, 5);
                v[0] = 0;
                v[1] = 64;
                v[2] = 0;
                v[3] = 0;
                nint r = calloc(64, 8);
                v[4] = (long)r;
                d_ctl_s = t;
            }
        }
        rt_unlock();
        return d_ctl_s;
    }

    static void d_lock(nint t) {
        rt_cas_lock(t);
    }

    static void d_unlock(nint t) {
        // release 屏障解锁(十一批):平铺 store 0 没有 happens-before
        // 边,持锁方的环写入可能对后到的持锁方不可见
        rt_cas_unlock(t);
    }

    // 环满翻倍并把存活条目搬到新环(head=0、tail=存活数,与 C 版一致);
    // 容量到 2^20 或分配失败拒绝,返回 0。调用方持锁。
    static int d_grow(nint t) {
        Span<long> v = new Span<long>(t, 5);
        long cap = v[1];
        if (cap >= 1048576L) { return 0; }
        long ncap = cap * 2;
        nint nring = malloc(ncap * 8);
        if (nring == 0) { return 0; }
        long head = v[2];
        long tail = v[3];
        nint oring = (nint)v[4];
        Span<long> ov = new Span<long>(oring, (int)cap);
        Span<long> nv = new Span<long>(nring, (int)ncap);
        long count = 0;
        long i = head;
        while (i != tail) {
            nv[(int)count] = ov[(int)i];
            count = count + 1;
            i = (i + 1) % cap;
        }
        cfree(oring);
        Span<long> v2 = new Span<long>(t, 5);
        v2[1] = ncap;
        v2[2] = 0;
        v2[3] = count;
        v2[4] = (long)nring;
        return 1;
    }

    public static void dispatch_init() {
        nint t = d_ctl();
        d_lock(t);
        Span<long> v = new Span<long>(t, 5);
        v[2] = 0;
        v[3] = 0;
        d_unlock(t);
    }

    // 成功 1,调用方按返回值分支(C 版注释原样);null 拒;满环先翻倍。
    public static int dispatch_post(nint fn) {
        if (fn == 0) { return 0; }
        nint t = d_ctl();
        d_lock(t);
        int ok = 0;
        Span<long> v = new Span<long>(t, 5);
        long cap = v[1];
        long head = v[2];
        long tail = v[3];
        long next = (tail + 1) % cap;
        if (next == head && d_grow(t) == 1) {
            Span<long> vg = new Span<long>(t, 5);
            cap = vg[1];
            head = vg[2];
            tail = vg[3];
            next = (tail + 1) % cap;
        }
        if (next != head) {
            Span<long> vw = new Span<long>(t, 5);
            nint ring = (nint)vw[4];
            Span<long> rv = new Span<long>(ring, (int)cap);
            rv[(int)tail] = (long)fn;
            vw[3] = next;
            ok = 1;
        }
        d_unlock(t);
        return ok;
    }

    public static nint dispatch_take() {
        nint t = d_ctl();
        d_lock(t);
        nint fn = 0;
        Span<long> v = new Span<long>(t, 5);
        if (v[2] != v[3]) {
            long cap = v[1];
            nint ring = (nint)v[4];
            Span<long> rv = new Span<long>(ring, (int)cap);
            fn = (nint)rv[(int)v[2]];
            v[2] = (v[2] + 1) % cap;
        }
        d_unlock(t);
        return fn;
    }

    public static void dispatch_clear() {
        nint t = d_ctl();
        d_lock(t);
        Span<long> v = new Span<long>(t, 5);
        v[2] = 0;
        v[3] = 0;
        d_unlock(t);
    }

    // 每线程 EH 状态块(编译器拥有布局:{i32 top, ptr exc,
    // 256 x 1024 setjmp 槽},共 16+262144 字节)。__thread 槽位用
    // pthread specific key 承载(无析构,进程期存活)。
    public static nint eh_tls_state() {
        if (eh_ready == 0) {
            // key 只建一次:两线程并发首入 EH 会各建一把 key,后建者
            // 覆写 eh_key,先建者槽位里的块从此失联(十一批串行化)
            rt_lock();
            if (eh_ready == 0) {
                nint kp = malloc(8);
                cpthread_key_create(kp, 0);
                Span<long> kv = new Span<long>(kp, 1);
                eh_key = kv[0];
                cfree(kp);
                eh_ready = 1;
            }
            rt_unlock();
        }
        nint p = cpthread_getspecific(eh_key);
        if (p == 0) {
            p = calloc(1, 262160);
            if (p == 0) { cabort(); }
            cpthread_setspecific(eh_key, p);
        }
        return p;
    }

    // ---- 第八批:zan_shared_table_*(单进程诚实移植,spec: oracle
    // rt_sync.c;C 版的进程内注册表 + 堆行存储形态原样,块布局自定)----
    // 表块(3152B):[0]名串 [1]容量 [2]键长 [3]列数 [4]行距 [5]行链头
    // [6]行数 [7]在册 [8]自旋锁,列区从字节 80 起每列 96B(type@0
    // size@8 offset@16 名@24 共 64B NUL 垫)。行块(48B):[0]next
    // [1]hash [2]键副本 [3]alive [4]expires_at [5]data。注册表/匿名表
    // 各 64/256 槽堆数组 + 自旋锁;锁单元与控制块惰性建立均为单线程
    // 假设(与 try_lock/dispatch 同款)。跨线程互斥本身是诚实的
    // (OSAtomic CAS 自旋)。
    // FNV-1a 的 XOR 以 (a|b)-(a&b) 恒等式实现(^ 未验证,数学等价);
    // s:<n>: 的数字段是 strtoul 的收窄近似(跳空格、可带 +、'-' 一律
    // 拒——C 无符号回绕后必 >65536,等价)。
    static nint st_reg_arr;
    static long st_reg_n;
    static nint st_reg_lk;
    static nint st_anon_arr;
    static long st_anon_n;
    static nint st_anon_lk;
    static nint st_empty;

    static long st_rget(long r, int idx) {
        Span<long> rv = new Span<long>((nint)r, 6);
        return rv[idx];
    }

    static void st_rset(long r, int idx, long v) {
        Span<long> rv = new Span<long>((nint)r, 6);
        rv[idx] = v;
    }

    static long st_tget(nint t, int idx) {
        Span<long> tv = new Span<long>(t, 10);
        return tv[idx];
    }

    static void st_tset(nint t, int idx, long v) {
        Span<long> tv = new Span<long>(t, 10);
        tv[idx] = v;
    }

    // 表自旋锁在表块字节 64(槽 [8]);解锁用 barrier 变体取反(十一批
    // release 修复:平铺 store 0 没有 happens-before 边)。
    static void st_lock(nint t) {
        rt_cas_lock(st_ptr((long)t + 64));
    }

    static void st_unlock(nint t) {
        rt_cas_unlock(st_ptr((long)t + 64));
    }

    static void st_spin(nint lk) {
        rt_cas_lock(lk);
    }

    static void st_unspin(nint lk) {
        rt_cas_unlock(lk);
    }

    // (nint)(表达式) 括号强转不被解析器接受(nint 被当方法名,
    // (int)(…) 却可以)——指针算术一律经本助手两步:(nint)ident 合法。
    static nint st_ptr(long addr) {
        return (nint)addr;
    }

    static nint st_reg_lock() {
        nint lk = st_reg_lk;
        if (lk != 0) { return lk; }
        rt_lock();
        if (st_reg_lk == 0) {
            st_reg_lk = calloc(1, 8);
        }
        rt_unlock();
        return st_reg_lk;
    }

    static nint st_anon_lock() {
        nint lk = st_anon_lk;
        if (lk != 0) { return lk; }
        rt_lock();
        if (st_anon_lk == 0) {
            st_anon_lk = calloc(1, 8);
        }
        rt_unlock();
        return st_anon_lk;
    }

    static long st_coff(long c) {
        Span<long> cv = new Span<long>((nint)c, 3);
        return cv[2];
    }

    static long st_csize(long c) {
        Span<long> cv = new Span<long>((nint)c, 3);
        return cv[1];
    }

    static long st_arr_get(nint arr, long idx) {
        Span<long> av = new Span<long>(st_ptr((long)arr + idx * 8), 1);
        return av[0];
    }

    // "count"/"window_start"/"owner" 常量列名(lit_buf 字节备好)。
    static nint lit_count_name() {
        lit_init();
        return lit_buf + 38;
    }

    static nint lit_wstart_name() {
        lit_init();
        return lit_buf + 64;
    }

    static nint lit_owner_name() {
        lit_init();
        return lit_buf + 80;
    }

    // CLOCK_REALTIME 毫秒(过期语义同 C 版 wall clock)。
    static long st_wall() {
        nint ts = malloc(16);
        clock_gettime(0, ts);
        Span<long> v = new Span<long>(ts, 2);
        long ms = v[0] * 1000 + v[1] / 1000000;
        cfree(ts);
        return ms;
    }

    // FNV-1a 64,强制非零;null 键按空串(空串单例双检锁,十一批)。
    static long st_hash(nint v) {
        nint p = v;
        if (p == 0) {
            nint e = st_empty;
            if (e == 0) {
                rt_lock();
                if (st_empty == 0) { st_empty = calloc(1, 1); }
                rt_unlock();
                e = st_empty;
            }
            p = e;
        }
        long len = cstrlen(p);
        long h = 1469598103934665603L;
        if (len > 0) {
            Span<byte> sv = new Span<byte>(p, (int)len);
            long i = 0;
            while (i < len) {
                long b = sv[(int)i] & 255L;
                h = ((h | b) - (h & b)) * 1099511628211L;
                i = i + 1;
            }
        }
        return h != 0 ? h : 1L;
    }

    static int st_eq(nint a, nint b) {
        long la = cstrlen(a);
        long lb = cstrlen(b);
        if (la != lb) { return 0; }
        if (la == 0) { return 1; }
        return cmemcmp(a, b, la) == 0 ? 1 : 0;
    }

    static nint st_strdup(nint p) {
        long len = cstrlen(p);
        nint cp = malloc(len + 1);
        if (cp == 0) { return 0; }
        if (len > 0) { memcpy(cp, p, len); }
        Span<byte> z = new Span<byte>(st_ptr((long)cp + len), 1);
        z[0] = 0;
        return cp;
    }

    // schema 解析:C 版逐字符走查的等价实现。合法条目 i:name;/
    // f:name;/s:<n>:name;(名非空且 <64 字节、无重名、n∈1..65536),
    // 成功回填列数与行距。
    static int st_parse_schema(nint schema, nint t) {
        if (schema == 0) { return 0; }
        long len = cstrlen(schema);
        if (len == 0) { return 0; }
        Span<byte> sv = new Span<byte>(schema, (int)(len + 1));
        long ncol = st_tget(t, 3);
        long offset = 0;
        long i = 0;
        long fail = 0;
        long done = 0;
        while (done == 0) {
            if (sv[(int)i] == 0) {
                done = 1;
            }
            else {
                long type = -1;
                long size = 0;
                int ch = sv[(int)i];
                if (ncol >= 32) { fail = 1; done = 1; }
                else if (ch == 105) {
                    type = 0;
                    size = 8;
                    i = i + 1;
                    // C 的 *p++ != ':' 无论成败都消耗冒号。
                    if (sv[(int)i] != 58) { fail = 1; }
                    else { i = i + 1; }
                }
                else if (ch == 102) {
                    type = 1;
                    size = 8;
                    i = i + 1;
                    if (sv[(int)i] != 58) { fail = 1; }
                    else { i = i + 1; }
                }
                else if (ch == 115) {
                    type = 2;
                    i = i + 1;
                    if (sv[(int)i] != 58) {
                        fail = 1;
                    }
                    else {
                        i = i + 1;
                        while (sv[(int)i] == 32) { i = i + 1; }
                        if (sv[(int)i] == 43) { i = i + 1; }
                        if (sv[(int)i] < 48 || sv[(int)i] > 57) {
                            fail = 1;
                        }
                        else {
                            long n = 0;
                            long dig = 1;
                            while (dig == 1) {
                                int d = sv[(int)i];
                                if (d < 48 || d > 57) {
                                    dig = 0;
                                }
                                else {
                                    n = n * 10 + (d - 48);
                                    if (n > 65536) { fail = 1; dig = 0; }
                                    else { i = i + 1; }
                                }
                            }
                            if (fail == 0) {
                                if (n == 0 || sv[(int)i] != 58) { fail = 1; }
                                else { size = n + 1; i = i + 1; }
                            }
                        }
                    }
                }
                else {
                    fail = 1;
                }
                if (fail == 0) {
                    long start = i;
                    while (sv[(int)i] != 0 && sv[(int)i] != 59) { i = i + 1; }
                    long nlen = i - start;
                    if (sv[(int)i] != 59 || nlen == 0 || nlen >= 64) {
                        fail = 1;
                    }
                    else {
                        long j = 0;
                        while (fail == 0 && j < ncol) {
                            nint pn = st_ptr((long)t + 80 + j * 96 + 24);
                            // 等长才可判重(C 是 strlen==nlen 且 memcmp)。
                            if (cstrlen(pn) == nlen
                                    && cmemcmp(pn, st_ptr((long)schema + start),
                                        nlen) == 0) {
                                fail = 1;
                            }
                            else {
                                j = j + 1;
                            }
                        }
                        if (fail == 0) {
                            if (type == 0 || type == 1) {
                                offset = (offset + 7) & -8L;
                            }
                            nint cap = st_ptr((long)t + 80 + ncol * 96);
                            Span<long> cv = new Span<long>(cap, 3);
                            cv[0] = type;
                            cv[1] = size;
                            cv[2] = offset;
                            nint nmp = st_ptr((long)cap + 24);
                            Span<byte> nv = new Span<byte>(nmp, (int)nlen);
                            long q = 0;
                            while (q < nlen) {
                                nv[(int)q] = sv[(int)(start + q)];
                                q = q + 1;
                            }
                            offset = offset + size;
                            ncol = ncol + 1;
                            i = i + 1;
                        }
                    }
                }
                if (fail != 0) { done = 1; }
            }
        }
        if (fail != 0) { return 0; }
        st_tset(t, 3, ncol);
        st_tset(t, 4, offset);
        return 1;
    }

    static long st_find_col(nint t, nint name, int type) {
        long ncol = st_tget(t, 3);
        long j = 0;
        long found = 0;
        while (found == 0 && j < ncol) {
            nint cap = st_ptr((long)t + 80 + j * 96);
            Span<long> cv = new Span<long>(cap, 3);
            if (cv[0] == (long)type && st_eq(st_ptr((long)cap + 24), name) == 1) {
                found = (long)cap;
            }
            else {
                j = j + 1;
            }
        }
        return found;
    }

    // 批量上限对应 oracle ZAN_PURGE_MAX_BATCH(64);maxb <= 0 不限量
    // (purge_expired API 与 lock_acquire 走全量扫)。
    static void st_purge(nint t, long now) {
        st_purge_b(t, now, 0);
    }

    static void st_purge_b(nint t, long now, long maxb) {
        Span<long> tv = new Span<long>(t, 7);
        long r = tv[5];
        long batch = 0;
        while (r != 0) {
            Span<long> rv = new Span<long>((nint)r, 6);
            long next = rv[0];
            if (rv[3] != 0 && rv[4] != 0 && rv[4] <= now) {
                rv[3] = 0;
                tv[6] = tv[6] - 1;
                batch = batch + 1;
                if (maxb > 0 && batch >= maxb) { return; }
            }
            r = next;
        }
    }

    // oracle zan_purge_expired 的进程级 16ms 节流:表内无带 TTL 的活行
    // 时不触钟、不刷新 last_attempt;一旦过门即刷新(哪怕随后无可清行,
    // 与 C 版 top-peek 空跑同效)。
    static long st_last_attempt;
    static int st_has_expiry(nint t) {
        long r = st_tget(t, 5);
        while (r != 0) {
            if (st_rget(r, 3) != 0 && st_rget(r, 4) != 0) { return 1; }
            r = st_rget(r, 0);
        }
        return 0;
    }

    static void st_purge_thr(nint t) {
        if (st_has_expiry(t) == 0) { return; }
        long now = st_wall();
        long last = st_last_attempt;
        if (last > now - 16 && last <= now) { return; }
        st_last_attempt = now;
        st_lock(t);
        st_purge_b(t, now, 64);
        st_unlock(t);
    }

    static long st_find_row(nint t, nint key) {
        long r = st_tget(t, 5);
        long found = 0;
        while (found == 0 && r != 0) {
            if (st_rget(r, 3) != 0 && st_eq((nint)st_rget(r, 2), key) == 1) {
                found = r;
            }
            else {
                r = st_rget(r, 0);
            }
        }
        return found;
    }

    static long st_find_row_hash(nint t, long hash) {
        long r = st_tget(t, 5);
        long found = 0;
        while (found == 0 && r != 0) {
            if (st_rget(r, 3) != 0 && st_rget(r, 1) == hash) {
                found = r;
            }
            else {
                r = st_rget(r, 0);
            }
        }
        return found;
    }

    // oracle 载荷因子:count >= cap - cap/8 满拒(与 C 版同式,容量
    // 非 8 倍数时 count*8>=cap*7 会差一);tombstone 槽优先复用。
    // 复用必须重写键拷贝:C 版两个复用点都 memcpy 新键(b33 修复:
    // 沿用死键会让键路径查找永久 miss 而哈希路径命中)。
    static long st_row_for(nint t, nint key) {
        long klen = cstrlen(key);
        if (klen == 0 || klen > st_tget(t, 2)) { return 0; }
        long r = st_find_row(t, key);
        if (r != 0) { return r; }
        long count = st_tget(t, 6);
        long cap = st_tget(t, 1);
        long stride = st_tget(t, 4);
        long head = st_tget(t, 5);
        if (count >= cap - cap / 8) { return 0; }
        long cur = head;
        long reuse = 0;
        while (reuse == 0 && cur != 0) {
            if (st_rget(cur, 3) == 0) { reuse = cur; }
            else { cur = st_rget(cur, 0); }
        }
        long hash = st_hash(key);
        long row = reuse;
        if (row != 0) {
            nint kcopy = st_strdup(key);
            if (kcopy == 0) { return 0; }
            nint data = (nint)st_rget(row, 5);
            memset(data, 0, stride > 0 ? stride : 1);
            nint ok = (nint)st_rget(row, 2);
            if (ok != 0) { cfree(ok); }
            st_rset(row, 2, (long)kcopy);
            st_rset(row, 1, hash);
            st_rset(row, 4, 0);
            st_rset(row, 3, 1);
            st_tset(t, 6, count + 1);
            return row;
        }
        nint nr = calloc(1, 48);
        if (nr == 0) { return 0; }
        nint kcopy = st_strdup(key);
        nint data = calloc(1, stride > 0 ? stride : 1);
        if (kcopy == 0 || data == 0) {
            cfree(kcopy);
            cfree(data);
            cfree(nr);
            return 0;
        }
        Span<long> nv = new Span<long>(nr, 6);
        nv[0] = head;
        nv[1] = hash;
        nv[2] = (long)kcopy;
        nv[3] = 1;
        nv[4] = 0;
        nv[5] = (long)data;
        st_tset(t, 5, (long)nr);
        st_tset(t, 6, count + 1);
        return (long)nr;
    }

    // _at 建行的占位键 = 哈希的十进制形式(C 版 keybuf 语义)。
    static nint st_key_from_hash(long h) {
        nint kb = malloc(32);
        long n = udec_into(h, kb);
        Span<byte> z = new Span<byte>(st_ptr((long)kb + n), 1);
        z[0] = 0;
        return kb;
    }

    static int st_anon_has(long handle) {
        nint t = (nint)handle;
        if (t == 0) { return 0; }
        nint lk = st_anon_lock();
        st_spin(lk);
        nint arr = st_anon_arr;
        if (arr == 0) {
            arr = calloc(256, 8);
            st_anon_arr = arr;
        }
        long n = st_anon_n;
        long j = 0;
        long found = 0;
        while (found == 0 && j < n) {
            Span<long> av = new Span<long>(st_ptr((long)arr + j * 8), 1);
            if (av[0] == handle) { found = 1; }
            else { j = j + 1; }
        }
        st_unspin(lk);
        return found;
    }

    public static long shared_table_create(
            nint name, int capacity, int key_size, nint schema) {
        if (name == 0 || cstrlen(name) == 0 || capacity <= 0
                || capacity > 1048576 || key_size <= 0 || key_size > 4096) {
            return 0;
        }
        nint t = calloc(1, 3152);
        if (t == 0) { return 0; }
        nint namecopy = st_strdup(name);
        if (namecopy == 0) {
            cfree(t);
            return 0;
        }
        st_tset(t, 0, (long)namecopy);
        st_tset(t, 1, capacity);
        st_tset(t, 2, key_size);
        if (st_parse_schema(schema, t) == 0) {
            cfree(namecopy);
            cfree(t);
            return 0;
        }
        nint lk = st_reg_lock();
        st_spin(lk);
        nint arr = st_reg_arr;
        if (arr == 0) {
            arr = calloc(64, 8);
            st_reg_arr = arr;
        }
        long n = st_reg_n;
        int ok = 1;
        long j = 0;
        while (ok == 1 && j < n) {
            long other = st_arr_get(arr, j);
            if (st_tget((nint)other, 7) != 0
                    && st_eq((nint)st_tget((nint)other, 0), name) == 1) {
                ok = 0;
            }
            else {
                j = j + 1;
            }
        }
        if (ok == 1 && n < 64) {
            st_tset(t, 7, 1);
            Span<long> sv = new Span<long>(st_ptr((long)arr + n * 8), 1);
            sv[0] = (long)t;
            st_reg_n = n + 1;
        }
        else {
            ok = 0;
        }
        st_unspin(lk);
        if (ok == 0) {
            cfree(namecopy);
            cfree(t);
            return 0;
        }
        return (long)t;
    }

    public static long shared_table_create_anon(
            int capacity, int key_size, nint schema) {
        if (capacity <= 0 || capacity > 1048576
                || key_size <= 0 || key_size > 4096) {
            return 0;
        }
        nint t = calloc(1, 3152);
        if (t == 0) { return 0; }
        st_tset(t, 1, capacity);
        st_tset(t, 2, key_size);
        if (st_parse_schema(schema, t) == 0) {
            cfree(t);
            return 0;
        }
        nint lk = st_anon_lock();
        st_spin(lk);
        nint arr = st_anon_arr;
        if (arr == 0) {
            arr = calloc(256, 8);
            st_anon_arr = arr;
        }
        long n = st_anon_n;
        if (n < 256) {
            Span<long> sv = new Span<long>(st_ptr((long)arr + n * 8), 1);
            sv[0] = (long)t;
            st_anon_n = n + 1;
        }
        st_unspin(lk);
        return (long)t;
    }

    public static long shared_table_open(nint name) {
        if (name == 0) { return 0; }
        nint lk = st_reg_lock();
        st_spin(lk);
        long n = st_reg_n;
        long j = 0;
        long found = 0;
        while (found == 0 && j < n) {
            long other = st_arr_get(st_reg_arr, j);
            if (st_tget((nint)other, 7) != 0
                    && st_eq((nint)st_tget((nint)other, 0), name) == 1) {
                found = other;
            }
            else {
                j = j + 1;
            }
        }
        st_unspin(lk);
        return found;
    }

    // 具名表按文档返回 0;匿名表返回可交给 Attach 的句柄本身。
    public static long shared_table_handle(long handle) {
        if (st_anon_has(handle) == 0) { return 0; }
        return handle;
    }

    public static long shared_table_attach(long os_handle) {
        if (st_anon_has(os_handle) == 0) { return 0; }
        return os_handle;
    }

    public static void shared_table_close(long handle) {
    }

    public static int shared_table_destroy(long handle) {
        nint t = (nint)handle;
        if (t == 0) { return 0; }
        int was = 0;
        nint lk = st_reg_lock();
        st_spin(lk);
        if (st_tget(t, 7) != 0) {
            st_tset(t, 7, 0);
            was = 1;
        }
        st_unspin(lk);
        return was;
    }

    public static int shared_table_set_int(
            long handle, nint key, nint column, long value) {
        nint t = (nint)handle;
        if (t == 0 || key == 0) { return 0; }
        st_purge_thr(t);
        st_lock(t);
        long c = st_find_col(t, column, 0);
        long r = c != 0 ? st_row_for(t, key) : 0;
        if (r != 0) {
            nint slot = st_ptr(st_rget(r, 5) + st_coff(c));
            Span<long> sv = new Span<long>(slot, 1);
            sv[0] = value;
        }
        st_unlock(t);
        return r != 0 ? 1 : 0;
    }

    public static long shared_table_get_int(
            long handle, nint key, nint column) {
        nint t = (nint)handle;
        if (t == 0 || key == 0) { return 0; }
        st_purge_thr(t);
        st_lock(t);
        long c = st_find_col(t, column, 0);
        long r = c != 0 ? st_find_row(t, key) : 0;
        long v = 0;
        if (r != 0) {
            nint slot = st_ptr(st_rget(r, 5) + st_coff(c));
            Span<long> sv = new Span<long>(slot, 1);
            v = sv[0];
        }
        st_unlock(t);
        return v;
    }

    public static int shared_table_set_float(
            long handle, nint key, nint column, double value) {
        nint t = (nint)handle;
        if (t == 0 || key == 0) { return 0; }
        st_purge_thr(t);
        st_lock(t);
        long c = st_find_col(t, column, 1);
        long r = c != 0 ? st_row_for(t, key) : 0;
        if (r != 0) {
            nint slot = st_ptr(st_rget(r, 5) + st_coff(c));
            Span<double> sv = new Span<double>(slot, 1);
            sv[0] = value;
        }
        st_unlock(t);
        return r != 0 ? 1 : 0;
    }

    public static double shared_table_get_float(
            long handle, nint key, nint column) {
        nint t = (nint)handle;
        if (t == 0 || key == 0) { return (double)0L; }
        st_purge_thr(t);
        st_lock(t);
        long c = st_find_col(t, column, 1);
        long r = c != 0 ? st_find_row(t, key) : 0;
        double v = (double)0L;
        if (r != 0) {
            nint slot = st_ptr(st_rget(r, 5) + st_coff(c));
            Span<double> sv = new Span<double>(slot, 1);
            v = sv[0];
        }
        st_unlock(t);
        return v;
    }

    public static int shared_table_set_string(
            long handle, nint key, nint column, nint value) {
        nint t = (nint)handle;
        if (t == 0 || key == 0 || value == 0) { return 0; }
        st_purge_thr(t);
        st_lock(t);
        long c = st_find_col(t, column, 2);
        long r = 0;
        if (c != 0 && cstrlen(value) < st_csize(c)) {
            r = st_row_for(t, key);
        }
        if (r != 0) {
            long len = cstrlen(value);
            nint dst = st_ptr(st_rget(r, 5) + st_coff(c));
            memcpy(dst, value, len);
            Span<byte> z = new Span<byte>(st_ptr((long)dst + len), 1);
            z[0] = 0;
        }
        st_unlock(t);
        return r != 0 ? 1 : 0;
    }

    // 缺失 → 空 malloc 串;命中 → 内容的新拷贝,调用方拥有(C strdup 契约)。
    public static nint shared_table_get_string(
            long handle, nint key, nint column) {
        nint result = malloc(1);
        Span<byte> e0 = new Span<byte>(result, 1);
        e0[0] = 0;
        nint t = (nint)handle;
        if (result == 0 || t == 0 || key == 0) { return result; }
        st_purge_thr(t);
        st_lock(t);
        long c = st_find_col(t, column, 2);
        long r = c != 0 ? st_find_row(t, key) : 0;
        if (r != 0) {
            long size = st_csize(c);
            nint src = st_ptr(st_rget(r, 5) + st_coff(c));
            long len = 0;
            long bound = size - 1;
            long sl = cstrlen(src);
            if (sl < bound) { len = sl; }
            else { len = bound; }
            nint copy = malloc(len + 1);
            if (copy != 0) {
                if (len > 0) { memcpy(copy, src, len); }
                Span<byte> z = new Span<byte>(st_ptr((long)copy + len), 1);
                z[0] = 0;
                cfree(result);
                result = copy;
            }
        }
        st_unlock(t);
        return result;
    }

    public static long shared_table_increment(
            long handle, nint key, nint column, long delta) {
        nint t = (nint)handle;
        if (t == 0 || key == 0) { return 0; }
        st_purge_thr(t);
        st_lock(t);
        long c = st_find_col(t, column, 0);
        long r = c != 0 ? st_row_for(t, key) : 0;
        long v = 0;
        if (r != 0) {
            nint slot = st_ptr(st_rget(r, 5) + st_coff(c));
            Span<long> sv = new Span<long>(slot, 1);
            v = sv[0] + delta;
            sv[0] = v;
        }
        st_unlock(t);
        return v;
    }

    public static int shared_table_expire(
            long handle, nint key, long ttl_ms) {
        if (ttl_ms < 0) { return 0; }
        long now = st_wall();
        if (ttl_ms > 9223372036854775807L - now) { return 0; }
        return shared_table_expire_at(handle, key, now + ttl_ms);
    }

    public static int shared_table_expire_at(
            long handle, nint key, long expires_at_ms) {
        nint t = (nint)handle;
        if (t == 0 || key == 0 || expires_at_ms < 0) { return 0; }
        st_lock(t);
        st_purge_b(t, st_wall(), 64);
        long r = st_find_row(t, key);
        if (r != 0) { st_rset(r, 4, expires_at_ms); }
        st_unlock(t);
        return r != 0 ? 1 : 0;
    }

    public static long shared_table_expires_at(long handle, nint key) {
        nint t = (nint)handle;
        if (t == 0 || key == 0) { return -1; }
        st_purge_thr(t);
        st_lock(t);
        long r = st_find_row(t, key);
        long at = r != 0 ? st_rget(r, 4) : -1;
        st_unlock(t);
        return at;
    }

    public static long shared_table_purge_expired(long handle, long now_ms) {
        nint t = (nint)handle;
        if (t == 0) { return 0; }
        if (now_ms < 0) { now_ms = st_wall(); }
        st_lock(t);
        long before = st_tget(t, 6);
        st_purge(t, now_ms);
        long removed = before - st_tget(t, 6);
        st_unlock(t);
        return removed;
    }

    public static int shared_table_rate_allow(
            long handle, nint key, long now_ms,
            long window_ms, long limit) {
        if (limit <= 0) { return 1; }
        nint t = (nint)handle;
        if (t == 0 || key == 0 || window_ms <= 0) { return 0; }
        if (now_ms < 0) { now_ms = st_wall(); }
        if (window_ms > 9223372036854775807L - now_ms) { return 0; }
        st_lock(t);
        long countc = st_find_col(t, lit_count_name(), 0);
        long startc = st_find_col(t, lit_wstart_name(), 0);
        int allowed = 0;
        if (countc != 0 && startc != 0) {
            st_purge_b(t, now_ms, 64);
            long r = st_find_row(t, key);
            if (r == 0) { r = st_row_for(t, key); }
            if (r != 0) {
                nint d = (nint)st_rget(r, 5);
                nint cslot = st_ptr(d + st_coff(countc));
                nint sslot = st_ptr(d + st_coff(startc));
                Span<long> cv = new Span<long>(cslot, 1);
                Span<long> sv = new Span<long>(sslot, 1);
                if (sv[0] <= 0 || now_ms - sv[0] >= window_ms) {
                    cv[0] = 1;
                    sv[0] = now_ms;
                    st_rset(r, 4, now_ms + window_ms);
                    allowed = 1;
                }
                else if (cv[0] < limit) {
                    cv[0] = cv[0] + 1;
                    allowed = 1;
                }
            }
        }
        st_unlock(t);
        return allowed;
    }

    public static int shared_table_lock_acquire(
            long handle, nint key, long owner,
            long now_ms, long lease_ms) {
        nint t = (nint)handle;
        if (t == 0 || key == 0 || owner == 0 || lease_ms <= 0) { return 0; }
        if (now_ms < 0) { now_ms = st_wall(); }
        if (lease_ms > 9223372036854775807L - now_ms) { return 0; }
        st_lock(t);
        long ownec = st_find_col(t, lit_owner_name(), 0);
        int acquired = 0;
        if (ownec != 0) {
            st_purge(t, now_ms);
            long r = st_find_row(t, key);
            if (r == 0) {
                r = st_row_for(t, key);
                if (r != 0) {
                    nint slot = st_ptr(st_rget(r, 5) + st_coff(ownec));
                    Span<long> sv = new Span<long>(slot, 1);
                    sv[0] = owner;
                    st_rset(r, 4, now_ms + lease_ms);
                    acquired = 1;
                }
            }
        }
        st_unlock(t);
        return acquired;
    }

    public static int shared_table_lock_release(
            long handle, nint key, long owner) {
        nint t = (nint)handle;
        if (t == 0 || key == 0 || owner == 0) { return 0; }
        st_lock(t);
        long ownec = st_find_col(t, lit_owner_name(), 0);
        int released = 0;
        if (ownec != 0) {
            st_purge_b(t, st_wall(), 64);
            long r = st_find_row(t, key);
            if (r != 0) {
                nint slot = st_ptr(st_rget(r, 5) + st_coff(ownec));
                Span<long> sv = new Span<long>(slot, 1);
                if (sv[0] == owner) {
                    st_rset(r, 3, 0);
                    st_tset(t, 6, st_tget(t, 6) - 1);
                    released = 1;
                }
            }
        }
        st_unlock(t);
        return released;
    }

    public static int shared_table_delete(long handle, nint key) {
        nint t = (nint)handle;
        if (t == 0 || key == 0) { return 0; }
        st_lock(t);
        st_purge_b(t, st_wall(), 64);
        long r = st_find_row(t, key);
        if (r != 0) {
            st_rset(r, 3, 0);
            st_tset(t, 6, st_tget(t, 6) - 1);
        }
        st_unlock(t);
        return r != 0 ? 1 : 0;
    }

    public static int shared_table_exists(long handle, nint key) {
        nint t = (nint)handle;
        if (t == 0 || key == 0) { return 0; }
        st_purge_thr(t);
        st_lock(t);
        long r = st_find_row(t, key);
        st_unlock(t);
        return r != 0 ? 1 : 0;
    }

    public static long shared_table_count(long handle) {
        nint t = (nint)handle;
        if (t == 0) { return 0; }
        st_purge_thr(t);
        st_lock(t);
        long n = st_tget(t, 6);
        st_unlock(t);
        return n;
    }

    public static void shared_table_clear(long handle) {
        nint t = (nint)handle;
        if (t == 0) { return; }
        st_lock(t);
        long r = st_tget(t, 5);
        while (r != 0) {
            st_rset(r, 3, 0);
            r = st_rget(r, 0);
        }
        st_tset(t, 6, 0);
        st_unlock(t);
    }

    public static long shared_table_hash(nint value) {
        return st_hash(value);
    }

    // what:1 RESIDENT 2 CAPACITY 3 COUNT 4 ROW_STRIDE 5 KEY_SIZE
    // 6 COLUMNS(0 与 1 同值,oracle RESERVED 映射字节数诚实降级)。
    public static long shared_table_stat(long handle, int what) {
        nint t = (nint)handle;
        if (t == 0) { return 0; }
        if (what == 0 || what == 1) {
            return st_tget(t, 4) * st_tget(t, 1);
        }
        if (what == 2) { return st_tget(t, 1); }
        if (what == 3) { return st_tget(t, 6); }
        if (what == 4) { return st_tget(t, 4); }
        if (what == 5) { return st_tget(t, 2); }
        if (what == 6) { return st_tget(t, 3); }
        return 0;
    }

    public static int shared_table_set_int_at(
            long handle, long key_hash, nint column, long value) {
        nint t = (nint)handle;
        if (t == 0) { return 0; }
        st_purge_thr(t);
        st_lock(t);
        long c = st_find_col(t, column, 0);
        long r = 0;
        if (c != 0) {
            r = st_find_row_hash(t, key_hash);
            if (r == 0) {
                nint kb = st_key_from_hash(key_hash);
                r = st_row_for(t, kb);
                cfree(kb);
                if (r != 0) { st_rset(r, 1, key_hash); }
            }
            if (r != 0) {
                nint slot = st_ptr(st_rget(r, 5) + st_coff(c));
                Span<long> sv = new Span<long>(slot, 1);
                sv[0] = value;
            }
        }
        st_unlock(t);
        return r != 0 ? 1 : 0;
    }

    public static long shared_table_get_int_at(
            long handle, long key_hash, nint column) {
        nint t = (nint)handle;
        if (t == 0) { return 0; }
        st_purge_thr(t);
        st_lock(t);
        long c = st_find_col(t, column, 0);
        long r = c != 0 ? st_find_row_hash(t, key_hash) : 0;
        long v = 0;
        if (r != 0) {
            nint slot = st_ptr(st_rget(r, 5) + st_coff(c));
            Span<long> sv = new Span<long>(slot, 1);
            v = sv[0];
        }
        st_unlock(t);
        return v;
    }

    public static long shared_table_increment_at(
            long handle, long key_hash, nint column, long delta) {
        nint t = (nint)handle;
        if (t == 0) { return 0; }
        st_purge_thr(t);
        st_lock(t);
        long c = st_find_col(t, column, 0);
        long r = 0;
        long v = 0;
        if (c != 0) {
            r = st_find_row_hash(t, key_hash);
            if (r == 0) {
                nint kb = st_key_from_hash(key_hash);
                r = st_row_for(t, kb);
                cfree(kb);
                if (r != 0) { st_rset(r, 1, key_hash); }
            }
            if (r != 0) {
                nint slot = st_ptr(st_rget(r, 5) + st_coff(c));
                Span<long> sv = new Span<long>(slot, 1);
                v = sv[0] + delta;
                sv[0] = v;
            }
        }
        st_unlock(t);
        return v;
    }

    public static long shared_table_extreme_at(
            long handle, long key_hash, nint column, long value,
            long keep_larger) {
        nint t = (nint)handle;
        if (t == 0) { return 0; }
        st_purge_thr(t);
        st_lock(t);
        long c = st_find_col(t, column, 0);
        long r = 0;
        long stored = 0;
        if (c != 0) {
            r = st_find_row_hash(t, key_hash);
            if (r == 0) {
                nint kb = st_key_from_hash(key_hash);
                r = st_row_for(t, kb);
                cfree(kb);
                if (r != 0) { st_rset(r, 1, key_hash); }
            }
            if (r != 0) {
                nint slot = st_ptr(st_rget(r, 5) + st_coff(c));
                Span<long> sv = new Span<long>(slot, 1);
                stored = sv[0];
                int replace = 0;
                if (keep_larger != 0) {
                    if (value > stored) { replace = 1; }
                }
                else {
                    if (stored == 0 || value < stored) { replace = 1; }
                }
                if (replace == 1) {
                    sv[0] = value;
                    stored = value;
                }
            }
        }
        st_unlock(t);
        return stored;
    }

    public static int shared_table_set_string_at(
            long handle, long key_hash, nint column, nint value) {
        nint t = (nint)handle;
        if (t == 0 || value == 0) { return 0; }
        st_purge_thr(t);
        st_lock(t);
        long c = st_find_col(t, column, 2);
        long r = 0;
        if (c != 0 && cstrlen(value) < st_csize(c)) {
            r = st_find_row_hash(t, key_hash);
            if (r == 0) {
                nint kb = st_key_from_hash(key_hash);
                r = st_row_for(t, kb);
                cfree(kb);
                if (r != 0) { st_rset(r, 1, key_hash); }
            }
            if (r != 0) {
                long len = cstrlen(value);
                nint dst = st_ptr(st_rget(r, 5) + st_coff(c));
                memcpy(dst, value, len);
                Span<byte> z = new Span<byte>(st_ptr((long)dst + len), 1);
                z[0] = 0;
            }
        }
        st_unlock(t);
        return r != 0 ? 1 : 0;
    }

    public static nint shared_table_get_string_at(
            long handle, long key_hash, nint column) {
        nint result = malloc(1);
        Span<byte> e0 = new Span<byte>(result, 1);
        e0[0] = 0;
        nint t = (nint)handle;
        if (result == 0 || t == 0) { return result; }
        st_purge_thr(t);
        st_lock(t);
        long c = st_find_col(t, column, 2);
        long r = c != 0 ? st_find_row_hash(t, key_hash) : 0;
        if (r != 0) {
            long size = st_csize(c);
            nint src = st_ptr(st_rget(r, 5) + st_coff(c));
            long bound = size - 1;
            long sl = cstrlen(src);
            long len = sl < bound ? sl : bound;
            nint copy = malloc(len + 1);
            if (copy != 0) {
                if (len > 0) { memcpy(copy, src, len); }
                Span<byte> z = new Span<byte>(st_ptr((long)copy + len), 1);
                z[0] = 0;
                cfree(result);
                result = copy;
            }
        }
        st_unlock(t);
        return result;
    }

    public static int shared_table_match_at(
            long handle, long key_hash, nint column, nint text) {
        nint t = (nint)handle;
        if (t == 0 || text == 0) { return 0; }
        st_lock(t);
        long c = st_find_col(t, column, 2);
        long r = c != 0 ? st_find_row_hash(t, key_hash) : 0;
        int equal = 0;
        if (r != 0) {
            nint src = st_ptr(st_rget(r, 5) + st_coff(c));
            long size = st_csize(c);
            equal = cstrncmp(src, text, size) == 0 ? 1 : 0;
        }
        st_unlock(t);
        return equal;
    }

    public static int shared_table_exists_at(long handle, long key_hash) {
        nint t = (nint)handle;
        if (t == 0) { return 0; }
        st_purge_thr(t);
        st_lock(t);
        long r = st_find_row_hash(t, key_hash);
        st_unlock(t);
        return r != 0 ? 1 : 0;
    }

    public static int shared_table_delete_at(long handle, long key_hash) {
        nint t = (nint)handle;
        if (t == 0) { return 0; }
        st_lock(t);
        st_purge_b(t, st_wall(), 64);
        long r = st_find_row_hash(t, key_hash);
        if (r != 0) {
            st_rset(r, 3, 0);
            st_tset(t, 6, st_tget(t, 6) - 1);
        }
        st_unlock(t);
        return r != 0 ? 1 : 0;
    }

    // ---- 第九批:native io reactor(oracle rt_co.c/rt_io.c reactor
    // loop;语义逐字对齐 zanstubs.c)----
    // 观察表是本文件私有布局,80B/项(10 longs):
    // [0]fd [1]kind [2]active [3]buf [4]len [5]deadline_ns [6]frame
    // [7]step [8]outn [9]垫。kind:1/2 = ReadReady/WriteReady 的
    // interest,3-5 = 带结果形态,6 = 常驻 DNS 自管道。静态只存数组
    // 指针/计数/容量,用点取新局部(缺口 2 纪律)。四个 C thunk 之外
    // 全部 Zan;DNS 作业块布局是与 C worker 的私有契约(72B:
    // next@0 name@8 port@16 buf@24 cap@32 outn@40 frame@48 step@56
    // result@64 v4@68),worker 只经互斥 + 自管道交棒,ready 队列仍只
    // 被主线程触碰。
    static nint io_ws;
    static long io_n;
    static long io_cap;

    static void io_ws_push(int fd, int kind, nint buf, long len,
            long deadline_ns, long frame, long step, nint outn) {
        if (io_n == io_cap) {
            long ncap = io_cap != 0 ? io_cap * 2 : 8;
            nint nu = calloc(1, ncap * 80);
            if (nu == 0) { cabort(); }
            if (io_n != 0) {
                nint old = io_ws;
                memcpy(nu, old, io_n * 80);
                cfree(old);
            }
            io_ws = nu;
            io_cap = ncap;
        }
        nint w = st_ptr((long)io_ws + io_n * 80);
        io_n = io_n + 1;
        Span<long> wv = new Span<long>(w, 9);
        wv[0] = (long)fd;
        wv[1] = (long)kind;
        wv[2] = 1;
        wv[3] = (long)buf;
        wv[4] = len;
        wv[5] = deadline_ns;
        wv[6] = frame;
        wv[7] = step;
        wv[8] = (long)outn;
    }

    // 退休观察项并把结果落进恢复 k 重读的槽(入参 outn;异步调用方交
    // frame+32,直连 extern 的非 async 程序交自己的槽);恢复经
    // zt_io_resume —— hook 未注册的非 async 程序里是空操作。
    static void io_deliver(nint w, long result) {
        Span<long> wv = new Span<long>(w, 9);
        wv[2] = 0;
        // 结果槽 = 入参 outn(C 契约同形:wait/DNS 泵传 NULL,不落值)。
        // 之前按 frame 重算 frame+32:frame=0 的直连调用(批46 native_rt_
        // core)就成了近 NULL 写 SEGV。第 7 参 x86 SysV 走栈由调用方
        // XCallSeq 押栈(批46 xStackArgs),不再是 arity-blind 垃圾。
        if (wv[8] != 0) {
            Span<long> ov = new Span<long>((nint)wv[8], 1);
            ov[0] = result;
        }
        io_resume(wv[6], wv[7]);
    }

    // 一次非阻塞 recv:>=0 数据/EOF,-2 would-block(再停),-1 其余
    // (交付后由调用方映成关闭形态)。
    static long io_recv_try(int fd, nint buf, long len) {
        if (len <= 0) { return 0; }
        long n = -1;
        int done = 0;
        while (done == 0) {
            n = crecv(fd, buf, len, 0);
            if (n >= 0) { done = 1; }
            else {
                int e = err_now();
                if (e == 4) {
                    // EINTR:重试
                }
                else if (e == Ewould()) { n = -2; done = 1; }   // EAGAIN/EWOULDBLOCK
                else { n = -1; done = 1; }
            }
        }
        return n;
    }

    // 零超时就绪探测。每个 co 助手在系统调用前都先探一次:accept 出的
    // 套接字常被调用方留在阻塞态,队列空时直接阻塞会冻死整个单线程
    // 引擎,而不是只停这一根协程。
    static int io_fd_ready(int fd, int want) {
        nint p = calloc(1, 8);
        Span<int> pv = new Span<int>(p, 1);
        pv[0] = fd;
        Span<byte> ev = new Span<byte>(st_ptr((long)p + 4), 2);
        ev[0] = (byte)(want & 255);
        ev[1] = 0;
        int rc = cpoll(p, 1, 0);
        cfree(p);
        return rc > 0 ? 1 : 0;
    }

    public static void io_wait_co(long fd, long interest, long frame,
            long step) {
        // 死 fd 快败(oracle io_reject_dead_fd):poll 无视负描述符、
        // 关了的 fd 永不就绪,停进去就是永远搁浅;就绪探测路径交付 0
        // 立即恢复。
        if (io_socket_alive(fd) == 0) {
            io_resume(frame, step);
            return;
        }
        io_ws_push((int)fd, interest == 2 ? 2 : 1, 0, 0, 0, frame, step, 0);
    }

    public static void io_recv_co(long fd, nint buf, long len, long frame,
            long step, nint outn) {
        long n = -2;
        if (io_socket_alive(fd) == 0) {
            n = 0;                                // 死 fd:EOF 形交付
        }
        else if (io_fd_ready((int)fd, 1) != 0) {
            n = io_recv_try((int)fd, buf, len);
        }
        if (n == -2) {
            io_ws_push((int)fd, 3, buf, len, 0, frame, step, outn);
            return;
        }
        Span<long> ov = new Span<long>(outn, 1);
        ov[0] = n;
        io_resume(frame, step);
    }

    public static void io_recv_to_co(long fd, nint buf, long len, long tmo,
            long frame, long step, nint outn) {
        long n = -2;
        if (io_socket_alive(fd) == 0) {
            n = 0;                                // 死 fd:0 而非超时 -1
        }
        else if (io_fd_ready((int)fd, 1) != 0) {
            n = io_recv_try((int)fd, buf, len);
        }
        if (n == -2) {
            long dl = tmo > 0 ? monotonic_ns() + tmo * 1000000L : 0;
            io_ws_push((int)fd, 4, buf, len, dl, frame, step, outn);
            return;
        }
        Span<long> ov = new Span<long>(outn, 1);
        ov[0] = n;
        io_resume(frame, step);
    }

    public static void io_accept_co(long fd, long frame, long step,
            nint outfd) {
        long c = -2;
        if (io_socket_alive(fd) == 0) {
            c = -1;                               // 死 fd:accept 失败形
        }
        else if (io_fd_ready((int)fd, 1) != 0) {
            int go = 1;
            while (go == 1) {
                c = caccept((int)fd, 0, 0);
                if (c >= 0 || err_now() != 4) { go = 0; }
            }
            if (c < 0 && err_now() == Ewould()) { c = -2; }
        }
        if (c == -2) {
            io_ws_push((int)fd, 5, 0, 0, 0, frame, step, outfd);
            return;
        }
        Span<long> ov = new Span<long>(outfd, 1);
        ov[0] = c;
        io_resume(frame, step);
    }

    // 主机名解析:resolve 本身同步(getaddrinfo),挂在脱离 worker 上
    // 跑完经互斥 + 自管道交棒;管道读端在主线程被排干,ready 队列仍只
    // 被主线程触碰。worker 经 zt_dns_worker_fn() 取地址传给
    // pthread_create(Zan 侧只传地址,不做函数指针调用)。
    public static void resolve_sa_co(nint name, long port, nint buf,
            long cap, long frame, long step, nint outn) {
        Span<long> ov = new Span<long>(outn, 1);
        if (name == 0) {
            ov[0] = 0;                            // 空 name:不劳 worker
            io_resume(frame, step);
            return;
        }
        Span<byte> n0 = new Span<byte>(name, 1);
        if (n0[0] == 0) {
            ov[0] = 0;
            io_resume(frame, step);
            return;
        }
        // 字面量(AF_INET/AF_INET6):无 DNS、无 worker。pton 的
        // domain 按目标原生值(darwin 30,Linux 10)。
        nint a4 = calloc(1, 16);
        nint a6 = calloc(1, 28);
        int lit = 0;
        if (cinet_pton(2, name, a4) == 1) { lit = 1; }
#if MACOS
        else if (cinet_pton(30, name, a6) == 1) { lit = 1; }
#else
        else if (cinet_pton(10, name, a6) == 1) { lit = 1; }
#endif
        cfree(a4);
        cfree(a6);
        if (lit == 1) {
            ov[0] = io_resolve_sa(name, (int)port, buf, (int)cap);
            io_resume(frame, step);
            return;
        }
        int rdfd = dns_pipe_ensure();
        if (rdfd == 0) {
            ov[0] = 0;
            io_resume(frame, step);
            return;
        }
        nint j = calloc(1, 80);
        if (j != 0) {
            nint cp = st_strdup(name);
            Span<long> jw = new Span<long>(j, 10);
            jw[1] = (long)cp;
            if (cp == 0) { cfree(j); j = 0; }
        }
        if (j == 0) {
            ov[0] = 0;
            io_resume(frame, step);
            return;
        }
        Span<long> jv = new Span<long>(j, 10);
        Span<int> pv = new Span<int>(st_ptr((long)j + 16), 1);
        pv[0] = (int)port;
        jv[3] = (long)buf;
        Span<int> cv = new Span<int>(st_ptr((long)j + 32), 1);
        cv[0] = (int)cap;
        jv[5] = (long)outn;
        jv[6] = frame;
        jv[7] = step;
        long havepipe = 0;
        long i = 0;
        while (havepipe == 0 && i < io_n) {
            Span<long> wv = new Span<long>(st_ptr((long)io_ws + i * 80), 9);
            if (wv[2] != 0 && wv[1] == 6) { havepipe = 1; }
            else { i = i + 1; }
        }
        if (havepipe == 0) {
            io_ws_push(rdfd, 6, 0, 0, 0, 0, 0, 0);
        }
        nint box = calloc(1, 16);
        if (box == 0) {
            // 无内存:降级为内联(阻塞)查询
            ov[0] = io_resolve_sa((nint)jv[1], (int)port, buf, (int)cap);
            cfree((nint)jv[1]);
            cfree(j);
            io_resume(frame, step);
            return;
        }
        Span<long> bv = new Span<long>(box, 2);
        bv[0] = (long)(nint)dns_worker_job;
        bv[1] = (long)j;
        nint tid = calloc(1, 8);
        int rc = cpthread_create(tid, 0, (nint)thread_trampoline, box);
        if (rc != 0) {
            // 无线程:降级为内联(阻塞)查询
            ov[0] = io_resolve_sa((nint)jv[1], (int)port, buf, (int)cap);
            cfree((nint)jv[1]);
            cfree(j);
            cfree(box);
            cfree(tid);
            io_resume(frame, step);
            return;
        }
        Span<long> tv = new Span<long>(tid, 1);
        cpthread_detach(tv[0]);
        cfree(tid);
    }

    // 纯 v4 查找(Socket.ResolveAsync):与 sockaddr 变体同形,但
    // worker 交付 io_resolve_ipv4 的 int;getaddrinfo 自己解析点分
    // 字面量,无需字面量快路。
    public static void resolve_ipv4_co(nint name, long frame, long step,
            nint outn) {
        Span<long> ov = new Span<long>(outn, 1);
        if (name == 0) {
            ov[0] = 0;
            io_resume(frame, step);
            return;
        }
        Span<byte> n0 = new Span<byte>(name, 1);
        if (n0[0] == 0) {
            ov[0] = 0;
            io_resume(frame, step);
            return;
        }
        int rdfd = dns_pipe_ensure();
        if (rdfd == 0) {
            ov[0] = 0;
            io_resume(frame, step);
            return;
        }
        nint j = calloc(1, 80);
        if (j != 0) {
            nint cp = st_strdup(name);
            Span<long> jw = new Span<long>(j, 10);
            jw[1] = (long)cp;
            if (cp == 0) { cfree(j); j = 0; }
        }
        if (j == 0) {
            ov[0] = 0;
            io_resume(frame, step);
            return;
        }
        Span<long> jv = new Span<long>(j, 10);
        jv[5] = (long)outn;
        jv[6] = frame;
        jv[7] = step;
        Span<int> v4v = new Span<int>(st_ptr((long)j + 68), 1);
        v4v[0] = 1;
        long havepipe = 0;
        long i = 0;
        while (havepipe == 0 && i < io_n) {
            Span<long> wv = new Span<long>(st_ptr((long)io_ws + i * 80), 9);
            if (wv[2] != 0 && wv[1] == 6) { havepipe = 1; }
            else { i = i + 1; }
        }
        if (havepipe == 0) {
            io_ws_push(rdfd, 6, 0, 0, 0, 0, 0, 0);
        }
        nint box = calloc(1, 16);
        if (box == 0) {
            ov[0] = io_resolve_ipv4((nint)jv[1]);
            cfree((nint)jv[1]);
            cfree(j);
            io_resume(frame, step);
            return;
        }
        Span<long> bv = new Span<long>(box, 2);
        bv[0] = (long)(nint)dns_worker_job;
        bv[1] = (long)j;
        nint tid = calloc(1, 8);
        int rc = cpthread_create(tid, 0, (nint)thread_trampoline, box);
        if (rc != 0) {
            ov[0] = io_resolve_ipv4((nint)jv[1]);
            cfree((nint)jv[1]);
            cfree(j);
            cfree(box);
            cfree(tid);
            io_resume(frame, step);
            return;
        }
        Span<long> tv = new Span<long>(tid, 1);
        cpthread_detach(tv[0]);
        cfree(tid);
    }

    // 发射端调度器的泵在 ready 队列见底时调它:poll 停泊的观察项(以
    // 最早定时器为界),唤醒 fd 就绪者,过期 recv_to 截止。有观察项返回
    // 1(循环继续),无则 0(调用方回落定时器睡眠)。

    public static long io_poll(long timer_wait_ns) {        // 原地压实 active 观察项(等价 C 的结构体拷贝)
        long k = 0;
        long i = 0;
        while (i < io_n) {
            nint w = st_ptr((long)io_ws + i * 80);
            Span<long> wv = new Span<long>(w, 9);
            if (wv[2] != 0) {
                if (k != i) {
                    memcpy(st_ptr((long)io_ws + k * 80), w, 80);
                }
                k = k + 1;
            }
            i = i + 1;
        }
        io_n = k;
        if (k == 0) { return 0; }
        nint fds = calloc(k, 8);
        if (fds == 0) { cabort(); }
        int timeout = -1;                         // 无定时器的观察项:阻塞
        if (timer_wait_ns >= 0) {
            long ms = (timer_wait_ns + 999999) / 1000000;
            if (ms > 2147483647L) { ms = 2147483647L; }
            timeout = (int)ms;
        }
        long fi = 0;
        while (fi < k) {
            nint pe = st_ptr((long)fds + fi * 8);
            Span<long> wvq = new Span<long>(st_ptr((long)io_ws + fi * 80), 9);
            Span<long> wv = new Span<long>(st_ptr((long)io_ws + fi * 80), 9);
            Span<int> pi = new Span<int>(pe, 1);
            pi[0] = (int)wv[0];
            Span<byte> pb = new Span<byte>(st_ptr((long)pe + 4), 2);
            int ev = wv[1] == 2 ? 4 : 1;          // POLLOUT : POLLIN
            pb[0] = (byte)(ev & 255);
            pb[1] = 0;
            fi = fi + 1;
        }
        int rc = -1;
        int pr = 1;
        while (pr == 1) {
            rc = cpoll(fds, (int)k, timeout);
            if (rc >= 0 || err_now() != 4) { pr = 0; }
        }
        long now = monotonic_ns();
        long di = 0;
        while (di < k) {
            nint wd = st_ptr((long)io_ws + di * 80);
            Span<long> wvd = new Span<long>(wd, 9);
            if (wvd[2] != 0) {
                nint ped = st_ptr((long)fds + di * 8);
                Span<byte> rb = new Span<byte>(st_ptr((long)ped + 6), 2);
                int rev = rb[0] | (rb[1] << 8);
                if ((rev & 32) != 0) {
                    // POLLNVAL:fd 没走 close_notify 就死了
                    io_deliver(wd, wvd[1] == 5 ? -1L : 0L);
                }
                else if ((rev & 29) != 0) {       // IN|OUT|ERR|HUP
                    long n = 0;
                    long c = -2;
                    if (wvd[1] == 1 || wvd[1] == 2) {
                        io_deliver(wd, 0);
                    }
                    else if (wvd[1] == 3) {
                        n = io_recv_try((int)wvd[0], (nint)wvd[3], wvd[4]);
                        if (n != -2) { io_deliver(wd, n); }  // 假唤醒:继续观察
                    }
                    else if (wvd[1] == 4) {
                        n = io_recv_try((int)wvd[0], (nint)wvd[3], wvd[4]);
                        if (n == -2) {
                            if (wvd[5] != 0 && now >= wvd[5]) {
                                io_deliver(wd, -1L);
                            }
                        }
                        else {
                            io_deliver(wd, n);    // 数据赢过将过的截止
                        }
                    }
                    else if (wvd[1] == 5) {
                        int go = 1;
                        while (go == 1) {
                            c = caccept((int)wvd[0], 0, 0);
                            if (c >= 0 || err_now() != 4) { go = 0; }
                        }
                        if (c >= 0 || err_now() != 35) { io_deliver(wd, c); }
                    }
                    else {
                        // kind 6:DNS 自管道,排干到 would-block,再在
                        // 互斥下摘走完工作业链(zt_dns_drain),逐个交付
                        nint drain = calloc(1, 64);
                        int dr = 1;
                        while (dr == 1) {
                            if (cread((int)wvd[0], drain, 64) <= 0) { dr = 0; }
                        }
                        cfree(drain);
                        dns_mu_ensure();
                        cpthread_mutex_lock(dns_mu);
                        nint list = (nint)dns_done;
                        dns_done = 0;
                        cpthread_mutex_unlock(dns_mu);
                        while (list != 0) {
                            Span<long> lv = new Span<long>(list, 9);
                            nint nx = (nint)lv[0];
                            nint op = (nint)lv[5];
                            Span<int> rvv = new Span<int>(st_ptr((long)list + 64), 1);
                            Span<long> ov = new Span<long>(op, 1);
                            ov[0] = (long)rvv[0];
                            io_resume(lv[6], lv[7]);
                            cfree((nint)lv[1]);
                            cfree(list);
                            list = nx;
                        }
                    }
                }
                else if (wvd[1] == 4 && wvd[5] != 0 && now >= wvd[5]) {
                    io_deliver(wd, -1L);
                }
            }
            di = di + 1;
        }
        cfree(fds);
        return 1;
    }

    public static void io_close_notify(long fd) {
        // 在真正 close 之前调(stdlib 的 Socket.Close):唤醒该 fd 上
        // 全部观察项,让停泊的 accept/recv 失败而非悬挂。recv/recv_to
        // 以关闭形(0 字节)醒,accept 以 -1 醒。
        long i = 0;
        while (i < io_n) {
            nint w = st_ptr((long)io_ws + i * 80);
            Span<long> wv = new Span<long>(w, 9);
            if (wv[2] != 0 && wv[0] == fd) {
                io_deliver(w, wv[1] == 5 ? -1L : 0L);
            }
            i = i + 1;
        }
    }

// —— 第十四批:发射器依赖面收编(linux 车道垫片清算)——
// 编译器无条件发射的帮助体此前直呼 Darwin 专属符号(CommonCrypto、
// arc4random_buf、os_unfair_lock、mach_vm_read_overwrite、
// _NSGetExecutablePath、pthread_threadid_np),ELF 车道靠
// zanlinuxshims.c 558 行垫片供面。本批把这一面收进运行时:
// 发射器改呼下列 zan_* 符号,两车道同一拼法;
// zanlinuxshims.c 退役。

// void zan_md5(const void *data, long long len, unsigned char *md)
// RFC 1321,小端状态输出。数值纪律同 sha256:long + >>> + 掩码。
static void md5_rounds(long[] h, long[] x) {
    long[] r = new long[] { 7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21 };
    long[] k = new long[] { 0xd76aa478L, 0xe8c7b756L, 0x242070db, 0xc1bdceeeL, 0xf57c0fafL, 0x4787c62a, 0xa8304613L, 0xfd469501L, 0x698098d8, 0x8b44f7afL, 0xffff5bb1L, 0x895cd7beL, 0x6b901122, 0xfd987193L, 0xa679438eL, 0x49b40821, 0xf61e2562L, 0xc040b340L, 0x265e5a51, 0xe9b6c7aaL, 0xd62f105dL, 0x02441453, 0xd8a1e681L, 0xe7d3fbc8L, 0x21e1cde6, 0xc33707d6L, 0xf4d50d87L, 0x455a14ed, 0xa9e3e905L, 0xfcefa3f8L, 0x676f02d9, 0x8d2a4c8aL, 0xfffa3942L, 0x8771f681L, 0x6d9d6122, 0xfde5380cL, 0xa4beea44L, 0x4bdecfa9, 0xf6bb4b60L, 0xbebfbc70L, 0x289b7ec6, 0xeaa127faL, 0xd4ef3085L, 0x04881d05, 0xd9d4d039L, 0xe6db99e5L, 0x1fa27cf8, 0xc4ac5665L, 0xf4292244L, 0x432aff97, 0xab9423a7L, 0xfc93a039L, 0x655b59c3, 0x8f0ccc92L, 0xffeff47dL, 0x85845dd1L, 0x6fa87e4f, 0xfe2ce6e0L, 0xa3014314L, 0x4e0811a1, 0xf7537e82L, 0xbd3af235L, 0x2ad7d2bb, 0xeb86d391L };
    long a = h[0]; long b = h[1]; long c = h[2]; long d = h[3];
    int i = 0;
    while (i < 64) {
        long f; int g;
        if (i < 16) { f = (b & c) | (~b & d); g = i; }
        else if (i < 32) { f = (d & b) | (~d & c); g = (5 * i + 1) & 15; }
        else if (i < 48) { f = b ^ c ^ d; g = (3 * i + 5) & 15; }
        else { f = c ^ (b | ~d); g = (7 * i) & 15; }
        long v = (a + (f & 0xFFFFFFFFL) + k[i] + x[g]) & 0xFFFFFFFFL;
        long rot = ((v << r[i]) | (v >>> (32 - r[i]))) & 0xFFFFFFFFL;
        long t = d;
        d = c;
        c = b;
        b = (b + rot) & 0xFFFFFFFFL;
        a = t;
        i = i + 1;
    }
    h[0] = (h[0] + a) & 0xFFFFFFFFL;
    h[1] = (h[1] + b) & 0xFFFFFFFFL;
    h[2] = (h[2] + c) & 0xFFFFFFFFL;
    h[3] = (h[3] + d) & 0xFFFFFFFFL;
}

public static void md5(nint data, long len, nint md) {
    long[] h = new long[] { 0x67452301, 0xefcdab89L, 0x98badcfeL, 0x10325476 };
    long total = len > 0 ? len : 0;
    nint blk = malloc(64);
    Span<byte> b = new Span<byte>(blk, 64);
    long off = 0;
    while (off + 64 <= total) {
        memcpy(blk, data + off, 64);
        long[] x = new long[16];
        int j = 0;
        while (j < 16) {
            x[j] = (b[j * 4] | (b[j * 4 + 1] << 8) | (b[j * 4 + 2] << 16) | (b[j * 4 + 3] << 24)) & 0xFFFFFFFFL;
            j = j + 1;
        }
        md5_rounds(h, x);
        off = off + 64;
    }
    memset(blk, 0, 64);                      // 块前清零(同 sha256;尾块残留字节会致块对齐输入摘要错)
    int t = (int)(total - off);
    memcpy(blk, data + off, t);
    b[t] = 0x80;
    if (t + 1 > 56) {
        long[] x = new long[16];
        int j = 0;
        while (j < 16) {
            x[j] = (b[j * 4] | (b[j * 4 + 1] << 8) | (b[j * 4 + 2] << 16) | (b[j * 4 + 3] << 24)) & 0xFFFFFFFFL;
            j = j + 1;
        }
        md5_rounds(h, x);
        memset(blk, 0, 64);
    }
    long bits = total * 8;
    int i8 = 0;
    while (i8 < 8) {
        b[56 + i8] = (byte)((bits >>> (8 * i8)) & 255);
        i8 = i8 + 1;
    }
    long[] xf = new long[16];
    int jf = 0;
    while (jf < 16) {
        xf[jf] = (b[jf * 4] | (b[jf * 4 + 1] << 8) | (b[jf * 4 + 2] << 16) | (b[jf * 4 + 3] << 24)) & 0xFFFFFFFFL;
        jf = jf + 1;
    }
    md5_rounds(h, xf);
    Span<byte> outv = new Span<byte>(md, 16);
    int i = 0;
    while (i < 4) {
        outv[i * 4] = (byte)(h[i] & 255);
        outv[i * 4 + 1] = (byte)((h[i] >>> 8) & 255);
        outv[i * 4 + 2] = (byte)((h[i] >>> 16) & 255);
        outv[i * 4 + 3] = (byte)((h[i] >>> 24) & 255);
        i = i + 1;
    }
    free(blk);
}

// void zan_sha1(const void *data, long long len, unsigned char *md)
// FIPS 180-4 SHA-1(80 轮,大端输出)。
static void sha1_rounds(long[] h, long[] w) {
    int i = 16;
    while (i < 80) {
        long x = w[i - 3] ^ w[i - 8] ^ w[i - 14] ^ w[i - 16];
        w[i] = ((x << 1) | (x >>> 31)) & 0xFFFFFFFFL;
        i = i + 1;
    }
    long a = h[0]; long b = h[1]; long c = h[2]; long d = h[3]; long e = h[4];
    i = 0;
    while (i < 80) {
        long f; long k;
        if (i < 20) { f = (b & c) | (~b & d); k = 0x5a827999L; }
        else if (i < 40) { f = b ^ c ^ d; k = 0x6ed9eba1L; }
        else if (i < 60) { f = (b & c) | (b & d) | (c & d); k = 0x8f1bbcdcL; }
        else { f = b ^ c ^ d; k = 0xca62c1d6L; }
        long v = ((((a << 5) | (a >>> 27)) & 0xFFFFFFFFL) + (f & 0xFFFFFFFFL) + k + w[i] + e) & 0xFFFFFFFFL;
        long t = d;
        d = c;
        long crot = ((b << 30) | (b >>> 2)) & 0xFFFFFFFFL;
        c = crot;
        b = a;
        a = v;
        e = t;
        i = i + 1;
    }
    h[0] = (h[0] + a) & 0xFFFFFFFFL;
    h[1] = (h[1] + b) & 0xFFFFFFFFL;
    h[2] = (h[2] + c) & 0xFFFFFFFFL;
    h[3] = (h[3] + d) & 0xFFFFFFFFL;
    h[4] = (h[4] + e) & 0xFFFFFFFFL;
}

public static void sha1(nint data, long len, nint md) {
    long[] h = new long[] { 0x67452301L, 0xefcdab89L, 0x98badcfeL, 0x10325476L, 0xc3d2e1f0L };
    long total = len > 0 ? len : 0;
    nint blk = malloc(64);
    Span<byte> b = new Span<byte>(blk, 64);
    long off = 0;
    while (off + 64 <= total) {
        memcpy(blk, data + off, 64);
        long[] w = new long[80];
        int j = 0;
        while (j < 16) {
            w[j] = ((b[j * 4] << 24) | (b[j * 4 + 1] << 16) | (b[j * 4 + 2] << 8) | b[j * 4 + 3]) & 0xFFFFFFFFL;
            j = j + 1;
        }
        sha1_rounds(h, w);
        off = off + 64;
    }
    memset(blk, 0, 64);
    int t = (int)(total - off);
    memcpy(blk, data + off, t);
    b[t] = 0x80;
    if (t + 1 > 56) {
        long[] w = new long[80];
        int j = 0;
        while (j < 16) {
            w[j] = ((b[j * 4] << 24) | (b[j * 4 + 1] << 16) | (b[j * 4 + 2] << 8) | b[j * 4 + 3]) & 0xFFFFFFFFL;
            j = j + 1;
        }
        sha1_rounds(h, w);
        memset(blk, 0, 64);
    }
    long bits = total * 8;
    int i8 = 0;
    while (i8 < 8) {
        b[56 + i8] = (byte)((bits >>> (56 - 8 * i8)) & 255);
        i8 = i8 + 1;
    }
    long[] wf = new long[80];
    int jf = 0;
    while (jf < 16) {
        wf[jf] = ((b[jf * 4] << 24) | (b[jf * 4 + 1] << 16) | (b[jf * 4 + 2] << 8) | b[jf * 4 + 3]) & 0xFFFFFFFFL;
        jf = jf + 1;
    }
    sha1_rounds(h, wf);
    Span<byte> outv = new Span<byte>(md, 20);
    int i = 0;
    while (i < 5) {
        outv[i * 4] = (byte)(h[i] >>> 24);
        outv[i * 4 + 1] = (byte)((h[i] >>> 16) & 255);
        outv[i * 4 + 2] = (byte)((h[i] >>> 8) & 255);
        outv[i * 4 + 3] = (byte)(h[i] & 255);
        i = i + 1;
    }
    free(blk);
}

// void zan_hmac_sha256(const void *key, long long klen, const void *data,
//                      long long dlen, unsigned char *mac)
// RFC 2104 HMAC over zan_sha256:块 64,密钥长于块先哈希,ipad/opad
// 0x36/0x5c。一次性拼接 ipad||data 与 opad||inner(sha256 单发无增量面)。
public static void hmac_sha256(nint key, long klen, nint data, long dlen, nint mac) {
    long kl = klen > 0 ? klen : 0;
    long dl = dlen > 0 ? dlen : 0;
    nint k0 = malloc(64);
    memset(k0, 0, 64);
    if (kl > 64) {
        sha256(key, kl, k0);
    } else if (kl > 0) {
        memcpy(k0, key, (int)kl);
    }
    nint ip = malloc(64 + dl);
    nint op = malloc(96);
    Span<byte> kb = new Span<byte>(k0, 64);
    Span<byte> iv = new Span<byte>(ip, 64);
    Span<byte> ov = new Span<byte>(op, 64);
    int i = 0;
    while (i < 64) {
        iv[i] = (byte)(kb[i] ^ 0x36);
        ov[i] = (byte)(kb[i] ^ 0x5c);
        i = i + 1;
    }
    if (dl > 0) { memcpy(ip + 64, data, (int)dl); }
    nint inner = malloc(32);
    sha256(ip, 64 + dl, inner);
    memcpy(op + 64, inner, 32);
    sha256(op, 96, mac);
    free(inner);
    free(op);
    free(ip);
    free(k0);
}

// void zan_urandom(void *buf, long long len):内核熵源两平台同名
// getentropy(3)(darwin 10.12+ libsystem_kernel / musl 都有;注意
// darwin 不导出 getrandom),256 字节分片(POSIX 上限),EINTR 重试;
// /dev/urandom 读兜底;全部失败零填(与 arc4random 永不失败契约对齐
// 的最后手段)。发射器 _zan_ext_guid_new 的唯一用户。
[DllImport("crt", EntryPoint = "getentropy")]
public static extern int cgetentropy(nint buf, long n);
public static void urandom(nint buf, long len) {
    if (buf == 0 || len <= 0) { return; }
    long done = 0;
    while (done < len) {
        long want = len - done;
        if (want > 256) { want = 256; }
        int r = cgetentropy(buf + done, want);
        if (r == 0) { done = done + want; continue; }
        nint f = cfopen("/dev/urandom", "rb");
        if (f != 0) {
            long g = cfread(buf + done, 1, want, f);
            cfclose(f);
            if (g > 0) { done = done + g; continue; }
        }
        memset(buf + done, 0, (int)want);
        done = done + want;
    }
}

// int zan_vm_read(void *dst, void *addr, long long len):跨页安全读探针
// ——地址无效返回非 0 而非 SIGSEGV。darwin:mach_vm_read_overwrite(
// task port 经 task_self_trap(), mach_task_self_ 数据符号 Zan 侧无法
// 直取);LINUX:process_vm_readv(getpid(),...)。发射器
// _zan_string_header 的慢路径(跨 4K 页界的 16 字节头部快照)唯一用户。
#if MACOS
[DllImport("crt", EntryPoint = "task_self_trap")]
public static extern int ctask_self_trap();
[DllImport("crt", EntryPoint = "mach_vm_read_overwrite")]
public static extern int cmach_vm_read(nint target, long addr, long size, nint outbuf, nint outsize);
public static int vm_read(nint dst, nint addr, long len) {
    if (dst == 0 || addr == 0 || len <= 0) { return 1; }
    nint osz = malloc(8);
    int r = cmach_vm_read((nint)ctask_self_trap(), addr, len, dst, osz);
    cfree(osz);
    return r;
}
#else
[DllImport("crt", EntryPoint = "process_vm_readv")]
public static extern long cproc_vm_readv(long pid, nint liov, long liocnt, nint riov, long riocnt, long flags);
public static int vm_read(nint dst, nint addr, long len) {
    if (dst == 0 || addr == 0 || len <= 0) { return 1; }
    nint io = malloc(32);
    Span<long> iv = new Span<long>(io, 4);
    iv[0] = (long)dst; iv[1] = len;
    iv[2] = (long)addr; iv[3] = len;
    long r = cproc_vm_readv(cgetpid(), io, 1, io + 16, 1, 0);
    cfree(io);
    return r == len ? 0 : 1;
}
#endif

// int zan_lock_enter(void *p) / zan_lock_exit(void *p):发射器 guard
// 运行时(ngen_guard 的 log/cache 串行化,8 字节零初始化槽)的锁面。
// 语义与 os_unfair_lock 对齐:非递归、地址即锁;casal CAS 0→1 自旋
// (首批 64 次纯自旋,其后 sched_yield 让步),stlr store 0 释放。
// 两平台同一 Zan 实现,无需 OS 符号。
[DllImport("crt", EntryPoint = "sched_yield")]
public static extern int csched_yield();
public static int lock_enter(nint p) {
    if (p == 0) { return 22; }
    long state = 0;
    int spins = 0;
    while (state == 0) {
        long w = atomic_cas_raw(p, 0, 1);
        if (w == 0) { state = 1; break; }
        if (spins >= 64) { csched_yield(); } else { spins = spins + 1; }
    }
    return 0;
}
public static int lock_exit(nint p) {
    if (p == 0) { return 22; }
    atomic_stlr_raw(p, 0);
    return 0;
}

// —— 第十三批:NativeMemory mem 族 + Win32 宽文本对(最后一族 C)——
// stdlib 的 EntryPoint 改名指向这里(zan_copy/…);C 基线同语义别名在
// zanstubs.c 的 -D 编出段。语义与 C 基线逐符号一致。

// void zan_copy(void *dst, const void *src, int n):memmove 语义(允许重叠)
public static void copy(nint dst, nint src, int n) {
    if (n <= 0 || dst == src) { return; }
    zmemmove(dst, src, n);
}

// void zan_fill(void *p, int v, int n):memset(v 取低 8 位)
public static void fill(nint p, int v, int n) {
    if (n <= 0) { return; }
    memset(p, v, n);
}

// int zan_compare(const void *a, const void *b, int n):memcmp 序 <0/0/>0
public static int compare(nint a, nint b, int n) {
    if (n <= 0) { return 0; }
    return zmemcmp(a, b, n);
}

// int zan_find(const void *p, int off, int b, int n):memchr;命中返回相对
// p 的偏移,未命中 -1(b 取低 8 位)
public static int find(nint p, int off, int b, int n) {
    if (n <= 0 || p == 0) { return -1; }
    nint hit = zmemchr(p + off, b, n);
    if (hit == 0) { return -1; }
    return (int)(hit - p);
}

// string zan_get_string(const void *p, int off, int len):ARC 串手塑——
// raw = [rc:8][header:8][data][NUL],header = 0x5A414E53_00000000|len,
// 用户指针 = raw+16;rc=1 与 C 基线逐字一致(本车道无 rc 递减路径)。
// 声明返 nint:ABI 上串就是数据指针,import 侧的 string 形态才是类型。
public static nint get_string(nint p, int off, int len) {
    if (len < 0 || p == 0) { len = 0; }
    nint raw = malloc(len + 17);
    if (raw == 0) { return 0; }
    Span<long> h = new Span<long>(raw, 2);
    h[0] = 1;
    h[1] = 0x5A414E5300000000L | ((long)len & 0xFFFFFFFFL);
    if (len > 0) { memcpy(raw + 16, p + off, len); }
    new Span<byte>(raw + 16 + len, 1)[0] = 0;
    return raw + 16;
}

// void zan_put_string(void *p, int off, string s, int len):串按数据指针
// 传入,前 len 字节拷到 p+off(不写 NUL)
public static void put_string(nint p, int off, nint s, int len) {
    if (s != 0 && len > 0) { memcpy(p + off, s, len); }
}

// —— Win32 宽文本对(CP_UTF8=65001 真实实现,替换 zanstubs.c 的
// return-0 阉割 stub;两车道同语义)——
// flags=0:非法序列按 U+FFFD 替换(Win32 现行 CP_UTF8 行为);
// sl/wl<0 表 NUL 终止(计数含 NUL);缓冲 0(或容量 0)表量尺;
// 缓冲不足返 0(ERROR_INSUFFICIENT_BUFFER);他代码页返 0(不支持)。

// 解一个 UTF-8 码点:s 基址、n 字节、i 为字节游标;非法(截断/续字节
// 错/过长/超界)返 -1(调用方替换 U+FFFD 且只消耗 1 字节);合法的
// U+FFFD 序列原样返回 0xFFFD
static int zutf8_dec(nint s, int n, int i) {
    int b0 = new Span<byte>(s + i, 1)[0];
    int cpw; int adv;
    if (b0 < 0x80) { return b0; }
    if ((b0 & 0xE0) == 0xC0) { cpw = b0 & 0x1F; adv = 2; }
    else if ((b0 & 0xF0) == 0xE0) { cpw = b0 & 0x0F; adv = 3; }
    else if ((b0 & 0xF8) == 0xF0) { cpw = b0 & 0x07; adv = 4; }
    else { return -1; }
    if (i + adv > n) { return -1; }
    int k = 1;
    while (k < adv) {
        int bx = new Span<byte>(s + i + k, 1)[0];
        if ((bx & 0xC0) != 0x80) { return -1; }
        cpw = (cpw << 6) | (bx & 0x3F);
        k = k + 1;
    }
    if ((adv == 2 && cpw < 0x80) || (adv == 3 && cpw < 0x800)
            || (adv == 4 && cpw < 0x10000) || cpw > 0x10FFFF) { return -1; }
    return cpw;
}

// int zan_multi_byte_to_wide_char(cp, fl, s, sl, w, wl)
public static int multi_byte_to_wide_char(int cp, int fl, nint s, int sl, nint w, int wl) {
    if (cp != 65001 || s == 0) { return 0; }
    int n = sl;
    if (n < 0) {
        n = 0;
        while (new Span<byte>(s + n, 1)[0] != 0) { n = n + 1; }
    }
    if (n == 0) { return 0; }
    bool q = w == 0 || wl == 0;
    int units = 0;
    int i = 0;
    while (i < n) {
        int d = zutf8_dec(s, n, i);
        int cpw;
        int adv;
        if (d < 0) { cpw = 0xFFFD; adv = 1; }
        else { cpw = d; adv = zutf8_adv(s, i); }
        int cu = cpw > 0xFFFF ? 2 : 1;
        if (q) {
            units = units + cu;
        } else {
            if (units + cu > wl) { return 0; }
            if (cu == 2) {
                int v = cpw - 0x10000;
                Span<ushort> wo = new Span<ushort>(w + units * 2, 2);
                wo[0] = (ushort)(0xD800 + (v >>> 10));
                wo[1] = (ushort)(0xDC00 + (v & 0x3FF));
            } else {
                new Span<ushort>(w + units * 2, 1)[0] = (ushort)cpw;
            }
            units = units + cu;
        }
        i = i + adv;
    }
    if (sl < 0) {
        units = units + 1;
        if (!q) {
            if (units > wl) { return 0; }
            new Span<ushort>(w + (units - 1) * 2, 1)[0] = 0;
        }
    }
    return units;
}

// zutf8_dec 消耗的字节数(与 dec 配对;FFFD 恒 1)
static int zutf8_adv(nint s, int i) {
    int b0 = new Span<byte>(s + i, 1)[0];
    if (b0 < 0x80) { return 1; }
    if ((b0 & 0xE0) == 0xC0) { return 2; }
    if ((b0 & 0xF0) == 0xE0) { return 3; }
    if ((b0 & 0xF8) == 0xF0) { return 4; }
    return 1;
}

// int zan_wide_char_to_multi_byte(cp, fl, w, wl, mb, mbl, dc, du)
public static int wide_char_to_multi_byte(int cp, int fl, nint w, int wl, nint mb, int mbl, nint dc, nint du) {
    if (cp != 65001 || w == 0) { return 0; }
    int n = wl;
    if (n < 0) {
        n = 0;
        while (new Span<ushort>(w + n * 2, 1)[0] != 0) { n = n + 1; }
    }
    if (n == 0) { return 0; }
    bool q = mb == 0;
    int bytes = 0;
    int i = 0;
    while (i < n) {
        int u = new Span<ushort>(w + i * 2, 1)[0];
        int cpw;
        int adv;
        if (u >= 0xD800 && u <= 0xDBFF && i + 1 < n) {
            int u2 = new Span<ushort>(w + (i + 1) * 2, 1)[0];
            if (u2 >= 0xDC00 && u2 <= 0xDFFF) {
                cpw = 0x10000 + ((u - 0xD800) << 10) + (u2 - 0xDC00);
                adv = 2;
            } else { cpw = 0xFFFD; adv = 1; }
        } else if (u >= 0xD800 && u <= 0xDFFF) { cpw = 0xFFFD; adv = 1; }
        else { cpw = u; adv = 1; }
        int len;
        if (cpw < 0x80) { len = 1; }
        else if (cpw < 0x800) { len = 2; }
        else if (cpw < 0x10000) { len = 3; }
        else { len = 4; }
        if (q) {
            bytes = bytes + len;
        } else {
            if (bytes + len > mbl) { return 0; }
            if (len == 1) {
                new Span<byte>(mb + bytes, 1)[0] = (byte)cpw;
            } else if (len == 2) {
                Span<byte> o = new Span<byte>(mb + bytes, 2);
                o[0] = (byte)(0xC0 | (cpw >>> 6));
                o[1] = (byte)(0x80 | (cpw & 0x3F));
            } else if (len == 3) {
                Span<byte> o = new Span<byte>(mb + bytes, 3);
                o[0] = (byte)(0xE0 | (cpw >>> 12));
                o[1] = (byte)(0x80 | ((cpw >>> 6) & 0x3F));
                o[2] = (byte)(0x80 | (cpw & 0x3F));
            } else {
                Span<byte> o = new Span<byte>(mb + bytes, 4);
                o[0] = (byte)(0xF0 | (cpw >>> 18));
                o[1] = (byte)(0x80 | ((cpw >>> 12) & 0x3F));
                o[2] = (byte)(0x80 | ((cpw >>> 6) & 0x3F));
                o[3] = (byte)(0x80 | (cpw & 0x3F));
            }
            bytes = bytes + len;
        }
        i = i + adv;
    }
    if (wl < 0) {
        if (q) {
            bytes = bytes + 1;
        } else {
            if (bytes + 1 > mbl) { return 0; }
            new Span<byte>(mb + bytes, 1)[0] = 0;
            bytes = bytes + 1;
        }
    }
    if (du != 0) { new Span<int>(du, 1)[0] = 0; }
    return bytes;
}

