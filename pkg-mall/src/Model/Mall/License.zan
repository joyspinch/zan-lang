using System.Data.Orm;

namespace ZanWeb.Model.Mall;

/* 许可证：token 只存 SHA-256 摘要；mode ∈ online / device_offline / account_offline。 */
[Table(Name = "licenses")]
class License {
    [Column(IsIdentity = true)]
    int id;

    [Column(IsNullable = false)]
    int entitlementId;

    [Column(StringLength = 64, IsNullable = false)]
    string tokenDigest;

    /* online / device_offline / account_offline */
    [Column(StringLength = 24, IsNullable = false)]
    string mode;

    [Column(StringLength = 128)]
    string deviceId;

    [Column(IsNullable = false)]
    long expiresAt;

    [Column(IsNullable = false)]
    int revoked;

    long createdAt;
}
