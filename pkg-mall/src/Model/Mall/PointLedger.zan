using System.Data.Orm;

namespace ZanWeb.Model.Mall;

/* 积分流水：delta 正负记账（recharge 充值 / purchase 消费 / commission 佣金 / withdrawal 提现）。 */
[Table(Name = "point_ledger")]
class PointLedger {
    [Column(IsIdentity = true)]
    int id;

    [Column(IsNullable = false)]
    int userId;

    [Column(IsNullable = false)]
    long delta;

    [Column(StringLength = 64, IsNullable = false)]
    string reason;

    [Column(StringLength = 64)]
    string referenceId;

    long createdAt;
}
