using System.Data.Orm;

namespace ZanWeb.Model.Mall;

/* 商品版本：artifactUrl 相对商城包根；sha256 与 signature
 * （Base64 RSA-SHA256，内容 = packageName + "\n" + version + "\n" + sha256）
 * 在管理员批准版本时强制校验，杜绝"已批准但不可验证"的包。 */
[Table(Name = "product_versions")]
class ProductVersion {
    [Column(IsIdentity = true)]
    int id;

    [Column(IsNullable = false)]
    int productId;

    [Column(StringLength = 64, IsNullable = false)]
    string version;

    [Column(IsNullable = false)]
    int majorVersion;

    [Column(StringLength = 512, IsNullable = false)]
    string artifactUrl;

    /* 64 位十六进制摘要。 */
    [Column(StringLength = 64)]
    string artifactSha256;

    /* Base64 RSA-SHA256 签名。 */
    [Column(StringLength = 1024)]
    string artifactSignature;

    [Column(StringLength = 4096)]
    string releaseNotes;

    /* pending / approved / rejected */
    [Column(StringLength = 24, IsNullable = false)]
    string status;

    [Column(StringLength = 2048)]
    string reviewNote;

    long createdAt;
}
