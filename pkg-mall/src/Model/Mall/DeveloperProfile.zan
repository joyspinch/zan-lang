using System.Data.Orm;

namespace ZanWeb.Model.Mall;

/* 开发者档案：一人一条（user_id 唯一），审核通过后 users.role 升 developer。 */
[Table(Name = "developer_profiles")]
class DeveloperProfile {
    [Column(IsIdentity = true)]
    int id;

    [Column(IsNullable = false)]
    int userId;

    [Column(StringLength = 128, IsNullable = false)]
    string displayName;

    [Column(StringLength = 2048)]
    string bio;

    /* pending / approved / rejected */
    [Column(StringLength = 24, IsNullable = false)]
    string status;

    [Column(StringLength = 2048)]
    string reviewNote;

    long createdAt;
}
