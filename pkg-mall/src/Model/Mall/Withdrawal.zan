using System.Data.Orm;

namespace ZanWeb.Model.Mall;

[Table(Name = "withdrawals")]
class Withdrawal {
    [Column(IsIdentity = true)]
    int id;

    [Column(IsNullable = false)]
    int developerId;

    [Column(IsNullable = false)]
    long amountPoints;

    [Column(StringLength = 256, IsNullable = false)]
    string account;

    /* pending / approved / rejected */
    [Column(StringLength = 24, IsNullable = false)]
    string status;

    [Column(StringLength = 2048)]
    string reviewNote;

    long createdAt;
}
