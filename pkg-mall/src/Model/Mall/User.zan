using System.Data.Orm;

namespace ZanWeb.Model.Mall;

/* 账号：程序员/开发者/管理员共用一张表，role 区分受众；
 * points 是商城通用积分，point_ledger 记流水。所有状态为字符串枚举
 * （与旧 schema 和审核文案一致：pending/approved/rejected/active）。 */
[Table(Name = "users")]
class User {
    [Column(IsIdentity = true)]
    int id;

    [Column(StringLength = 64, IsNullable = false)]
    string username;

    [Column(StringLength = 64, IsNullable = false)]
    string passwordSalt;

    [Column(StringLength = 128, IsNullable = false)]
    string passwordHash;

    /* user / developer / admin */
    [Column(StringLength = 24, IsNullable = false)]
    string role;

    [Column(IsNullable = false)]
    long points;

    /* active / disabled */
    [Column(StringLength = 24, IsNullable = false)]
    string status;

    long createdAt;
}
