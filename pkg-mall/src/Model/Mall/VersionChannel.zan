using System.Data.Orm;

namespace ZanWeb.Model.Mall;

/* 版本频道（toolchain 更新机制的单一事实源）：
 * 每个 channel 是一条可独立演进的发布线（ide / stdlib / compiler / sdk），
 * latestVersion 为该线当前推荐版本，requiredVersion 为安全下限——
 * 低于它的客户端得到 update_required=true（管理员可强制升级）。
 * rolloutPercent 支持灰度：0-100，客户端按自身 GUID 落桶比对。
 * 包体（installerUrl/sha256/signature）走与商品版本同一套
 * RSA-SHA256 签名校验流程，由 /api/admin/channel 批准后生效。 */
[Table(Name = "version_channels")]
class VersionChannel {
    [Column(IsIdentity = true)]
    int id;

    /* ide / stdlib / compiler / sdk */
    [Column(StringLength = 32, IsNullable = false)]
    string channel;

    /* 目标平台限定，空 = 全平台（win-x64 / linux-x64 / osx-arm64 ...）。 */
    [Column(StringLength = 32, IsNullable = false)]
    string platform;

    [Column(StringLength = 32, IsNullable = false)]
    string latestVersion;

    /* 低于此版本必须升级（安全修复线）。空 = 无强制。 */
    [Column(StringLength = 32)]
    string requiredVersion;

    /* 灰度发布百分比 0-100；100 = 全量。 */
    [Column(IsNullable = false)]
    int rolloutPercent;

    /* 下载地址（相对商城根或绝对 URL）。 */
    [Column(StringLength = 512)]
    string installerUrl;

    [Column(StringLength = 64)]
    string sha256;

    [Column(StringLength = 1024)]
    string signature;

    [Column(StringLength = 4096)]
    string releaseNotes;

    /* draft / published */
    [Column(StringLength = 24, IsNullable = false)]
    string status;

    long createdAt;
    long updatedAt;
}
