using System.Data.Orm;

namespace ZanWeb.Model.Mall;

/* 授权：once 授权绑定主版本（major 内免费升级），periodic 授权带到期时间。 */
[Table(Name = "entitlements")]
class Entitlement {
    [Column(IsIdentity = true)]
    int id;

    [Column(IsNullable = false)]
    int userId;

    [Column(IsNullable = false)]
    int productId;

    [Column(IsNullable = false)]
    int planId;

    /* once / periodic */
    [Column(StringLength = 24, IsNullable = false)]
    string licenseMode;

    [Column(IsNullable = false)]
    int majorVersion;

    /* epoch 秒；0 = 不限（once）。 */
    [Column(IsNullable = false)]
    long expiresAt;

    /* 1 = 管理员停用。 */
    [Column(IsNullable = false)]
    int disabled;

    long createdAt;
}
