using System.Data.Orm;

namespace ZanWeb.Model.Mall;

/* 开发者分成/提现流水。余额 = Σdelta − Σ(pending 提现)。 */
[Table(Name = "developer_ledger")]
class DeveloperLedger {
    [Column(IsIdentity = true)]
    int id;

    [Column(IsNullable = false)]
    int developerId;

    [Column(IsNullable = false)]
    long delta;

    [Column(StringLength = 64, IsNullable = false)]
    string reason;

    [Column(StringLength = 64)]
    string referenceId;

    long createdAt;
}
