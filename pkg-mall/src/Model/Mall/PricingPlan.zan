using System.Data.Orm;

namespace ZanWeb.Model.Mall;

/* 价格方案：once（买断，按主版本）与 periodic（订阅，duration_days 起算）。 */
[Table(Name = "pricing_plans")]
class PricingPlan {
    [Column(IsIdentity = true)]
    int id;

    [Column(IsNullable = false)]
    int productId;

    [Column(StringLength = 128, IsNullable = false)]
    string name;

    /* once / periodic */
    [Column(StringLength = 24, IsNullable = false)]
    string licenseMode;

    [Column(IsNullable = false)]
    long pricePoints;

    [Column(IsNullable = false)]
    int durationDays;

    [Column(IsNullable = false)]
    int commissionPercent;

    [Column(IsNullable = false)]
    int enabled;
}
