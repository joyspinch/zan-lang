using System.Data.Orm;

namespace ZanWeb.Model.Mall;

/* 评价：一人一商品一条（唯一索引），1-5 星。 */
[Table(Name = "reviews")]
class Review {
    [Column(IsIdentity = true)]
    int id;

    [Column(IsNullable = false)]
    int userId;

    [Column(IsNullable = false)]
    int productId;

    [Column(IsNullable = false)]
    int rating;

    [Column(StringLength = 2048)]
    string content;

    long createdAt;
}
