using System.Data.Orm;

namespace ZanWeb.Model.Mall;

/* 卡密：只存 SHA-256 摘要，明文生成时返回一次即丢弃。 */
[Table(Name = "recharge_codes")]
class RechargeCode {
    [Column(IsIdentity = true)]
    int id;

    [Column(StringLength = 64, IsNullable = false)]
    string codeDigest;

    [Column(IsNullable = false)]
    long points;

    [Column(IsNullable = false)]
    int redeemedBy;

    [Column(IsNullable = false)]
    long redeemedAt;

    long createdAt;
}
