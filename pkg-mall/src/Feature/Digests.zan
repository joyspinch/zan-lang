using System;
using System.Data;

namespace ZanWeb;

/* 摘要/十六进制小工具：MallFlow 与 IdentityFlow 共用。 */
class Digests {
    static bool IsHex64(string text) {
        if (text.Length != 64) { return false; }
        for (int i = 0; i < text.Length; i = i + 1) {
            char c = text[i];
            bool digit = c >= 48 && c <= 57;
            bool lower = c >= 97 && c <= 102;
            bool upper = c >= 65 && c <= 70;
            if (!digit && !lower && !upper) { return false; }
        }
        return true;
    }

    static string Sha256Hex(string text) {
        return Hex.Encode(Sha256.Hash(text, text.Length), 32);
    }
}
