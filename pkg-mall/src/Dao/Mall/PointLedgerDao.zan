using System;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Mall;

namespace ZanWeb.Dao.Mall;

/* 积分流水：充值/消费/佣金/提现的只追加账本。 */
class PointLedgerDao {
    IDbConnection db;

    PointLedgerDao(IDbConnection db) {
        this.db = db;
    }

    async int Insert(int userId, long delta, string reason, string referenceId) {
        PointLedger row = new PointLedger();
        row.userId = userId;
        row.delta = delta;
        row.reason = reason;
        row.referenceId = referenceId;
        row.createdAt = WebApp.NowSeconds();
        return await this.db.Insert<PointLedger>(row).ExecuteIdentityAsync();
    }
}
