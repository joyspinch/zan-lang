using System;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Mall;

namespace ZanWeb.Dao.Mall;

/* 版本频道网关：频道行与发布行的读写。 */
class VersionChannelDao {
    IDbConnection db;

    VersionChannelDao(IDbConnection db) {
        this.db = db;
    }

    async List<VersionChannel> All() {
        return await this.db.Select<VersionChannel>()
            .OrderBy(a => a.channel).ToListAsync();
    }

    async VersionChannel ByKey(string channel, string platform) {
        return await this.db.Select<VersionChannel>()
            .Where(a => a.channel == channel && a.platform == platform)
            .FirstAsync();
    }

    async int Insert(VersionChannel row) {
        return await this.db.Insert<VersionChannel>(row).ExecuteIdentityAsync();
    }

    async int UpdateChannel(VersionChannel row) {
        row.updatedAt = WebApp.NowSeconds();
        return await this.db.Update<VersionChannel>()
            .Set(a => a.latestVersion, row.latestVersion)
            .Set(a => a.requiredVersion, row.requiredVersion)
            .Set(a => a.rolloutPercent, row.rolloutPercent)
            .Set(a => a.installerUrl, row.installerUrl)
            .Set(a => a.sha256, row.sha256)
            .Set(a => a.signature, row.signature)
            .Set(a => a.releaseNotes, row.releaseNotes)
            .Set(a => a.status, row.status)
            .Set(a => a.updatedAt, row.updatedAt)
            .Where(a => a.id == row.id)
            .ExecuteAffrowsAsync();
    }

    async int InsertRelease(VersionRelease release) {
        return await this.db.Insert<VersionRelease>(release).ExecuteIdentityAsync();
    }

    async List<VersionRelease> ReleasesOf(int channelId) {
        return await this.db.Select<VersionRelease>()
            .Where(a => a.channelId == channelId)
            .OrderByDescending(a => a.id)
            .ToListAsync();
    }
}
