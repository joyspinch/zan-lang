using System;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Mall;

namespace ZanWeb.Dao.Mall;

/* users（商城账号）表唯一网关：登录、注册、角色升级、积分原子扣增都经此。命名区别于模板 RBAC 的 sys UserDao。 */
class MallUserDao {
    IDbConnection db;

    MallUserDao(IDbConnection db) {
        this.db = db;
    }

    async User ByUsername(string username) {
        return await this.db.Select<User>()
            .Where(a => a.username == username)
            .FirstAsync();
    }

    async User ById(int id) {
        return await this.db.Select<User>().Where(a => a.id == id).FirstAsync();
    }

    async int Insert(User user) {
        return await this.db.Insert<User>(user).ExecuteIdentityAsync();
    }

    async int SetRole(int id, string role) {
        return await this.db.Update<User>()
            .Set(a => a.role, role)
            .Where(a => a.id == id)
            .ExecuteAffrowsAsync();
    }

    async int SetStatus(int id, string status) {
        return await this.db.Update<User>()
            .Set(a => a.status, status)
            .Where(a => a.id == id)
            .ExecuteAffrowsAsync();
    }

    /* 积分原子增减：delta 可为负；SetIncr 生成 points = points + ?。 */
    async int AdjustPoints(int id, long delta) {
        return await this.db.Update<User>()
            .SetIncr(a => a.points, delta)
            .Where(a => a.id == id)
            .ExecuteAffrowsAsync();
    }

    async int Count() {
        return await this.db.Select<User>().CountAsync();
    }
}
