using System;
using System.Data;
using System.Data.Orm;
using ZanWeb.Model.Mall;

namespace ZanWeb.Dao.Mall;

/* 商品与版本的创建/审核/目录查询网关。 */
class CatalogDao {
    IDbConnection db;

    CatalogDao(IDbConnection db) {
        this.db = db;
    }

    async List<Product> ApprovedProducts() {
        return await this.db.Select<Product>()
            .Where(a => a.status == "approved")
            .OrderBy(a => a.id)
            .ToListAsync();
    }

    async Product ProductById(int id) {
        return await this.db.Select<Product>().Where(a => a.id == id).FirstAsync();
    }

    async Product ProductBySlug(string slug) {
        return await this.db.Select<Product>().Where(a => a.slug == slug).FirstAsync();
    }

    async int InsertProduct(Product p) {
        return await this.db.Insert<Product>(p).ExecuteIdentityAsync();
    }

    async List<ProductVersion> ApprovedVersions(int productId) {
        return await this.db.Select<ProductVersion>()
            .Where(a => a.productId == productId && a.status == "approved")
            .OrderByDescending(a => a.id)
            .ToListAsync();
    }

    async ProductVersion VersionById(int id) {
        return await this.db.Select<ProductVersion>()
            .Where(a => a.id == id).FirstAsync();
    }

    async int InsertVersion(ProductVersion v) {
        return await this.db.Insert<ProductVersion>(v).ExecuteIdentityAsync();
    }

    async int SetProductStatus(int id, string status, string note) {
        return await this.db.Update<Product>()
            .Set(a => a.status, status)
            .Where(a => a.id == id)
            .ExecuteAffrowsAsync();
    }

    async int SetVersionStatus(int id, string status, string note) {
        return await this.db.Update<ProductVersion>()
            .Set(a => a.status, status)
            .Set(a => a.reviewNote, note)
            .Where(a => a.id == id)
            .ExecuteAffrowsAsync();
    }

    async List<Category> Categories() {
        return await this.db.Select<Category>()
            .OrderBy(a => a.sortOrder).ToListAsync();
    }

    async Category CategoryById(int id) {
        return await this.db.Select<Category>().Where(a => a.id == id).FirstAsync();
    }

    async List<PricingPlan> PlansOf(int productId) {
        return await this.db.Select<PricingPlan>()
            .Where(a => a.productId == productId && a.enabled == 1)
            .ToListAsync();
    }

    async PricingPlan PlanById(int id) {
        return await this.db.Select<PricingPlan>().Where(a => a.id == id).FirstAsync();
    }

    async int InsertPlan(PricingPlan plan) {
        return await this.db.Insert<PricingPlan>(plan).ExecuteIdentityAsync();
    }
}
