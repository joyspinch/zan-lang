using System;
using ZanWeb;
using System.Web;
using System.Json;

namespace ZanWeb.Api;

[Route("api/[controller]/[action]")]
[Custom(Authorization = CustomAuthorization.None)]
[Description("商城")]
class Mall : ApiController {
    [HttpGet]
    [Description("商品目录")]
    void Catalog(){this.Ok(MallStore.Catalog());}

    [HttpGet]
    [Description("商品详情")]
    void Product(){string data=MallStore.Product(this.In("id"));if(data.Length==0){this.Fail(404,"2004","product not found");return;}this.Ok(data);}

    [HttpPost]
    [Custom(Authorization = CustomAuthorization.Login)]
    [Description("兑换卡密")]
    void Redeem(){if(!MallStore.Redeem(this.uid,this.In("code"))){this.Fail(422,"2002","invalid or used code");return;}JsonValue o=JsonValue.NewObject();o.Put("redeemed",JsonValue.NewBool(true));this.Ok(o.ToJson());}

    [HttpPost]
    [Custom(Authorization = CustomAuthorization.Login)]
    [Description("购买")]
    void Buy(){string no=MallStore.Buy(this.uid,this.In("plan_id"));if(no.Length==0){this.Fail(422,"2003","purchase rejected");return;}JsonValue o=JsonValue.NewObject();o.Put("order_no",JsonValue.NewStr(no));this.Ok(o.ToJson());}

    [HttpGet]
    [Custom(Authorization = CustomAuthorization.Login)]
    [Description("我的授权")]
    void Entitlements(){this.Ok(MallStore.Entitlements(this.uid));}

    [HttpGet]
    [Custom(Authorization = CustomAuthorization.Login)]
    [Description("下载")]
    void Download(){string url=MallStore.Download(this.uid,this.In("version_id"));if(url.Length==0){this.Fail(403,"2005","download not authorized");return;}JsonValue o=JsonValue.NewObject();o.Put("url",JsonValue.NewStr(url));this.Ok(o.ToJson());}

    [HttpPost]
    [Custom(Authorization = CustomAuthorization.Login)]
    [Description("签发许可证")]
    void LicenseIssue(){string token=MallStore.IssueLicense(this.uid,this.In("entitlement_id"),this.In("mode"),this.In("device_id"));if(token.Length==0){this.Fail(422,"2006","license rejected");return;}JsonValue o=JsonValue.NewObject();o.Put("token",JsonValue.NewStr(token));this.Ok(o.ToJson());}

    [HttpPost]
    [Description("检查许可证")]
    void LicenseCheck(){bool valid=MallStore.CheckLicense(this.In("token"),this.In("device_id"));JsonValue o=JsonValue.NewObject();o.Put("valid",JsonValue.NewBool(valid));this.Ok(o.ToJson());}

    [HttpPost]
    [Custom(Authorization = CustomAuthorization.Login)]
    [Description("评价")]
    void Review(){if(!Workflow.Review(this.uid,this.In("product_id"),this.InInt("rating",0),this.InText("content"))){this.Fail(422,"2007","review rejected");return;}JsonValue o=JsonValue.NewObject();o.Put("created",JsonValue.NewBool(true));this.Ok(o.ToJson());}
}
