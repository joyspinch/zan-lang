using System;
using ZanWeb;
using System.Web;
using System.Json;

namespace ZanWeb.Api;

[Route("api/[controller]/[action]")]
[Custom(Authorization = CustomAuthorization.ApiAuth)]
[Description("商城管理")]
class MallAdmin : ApiController {
    bool BoolIn(string name){string v=this.In(name);return v=="1" || v=="true";}

    [HttpPost]
    [Description("生成卡密")]
    void Codes(){string codes=MallStore.GenerateCodes(this.InInt("count",0),this.InInt("points",0));if(codes.Length==0){this.Fail(422,"4001","generation rejected");return;}JsonValue o=JsonValue.NewObject();JsonValue c=JsonValue.ParseLenient(codes);if(c!=null){o.Put("codes",c);}this.Ok(o.ToJson());}

    [HttpPost]
    [Description("审核开发者")]
    void Developer(){if(!Workflow.ReviewDeveloper(this.In("id"),this.BoolIn("approve"),this.InText("note"))){this.Fail(422,"4002","review rejected");return;}JsonValue o=JsonValue.NewObject();o.Put("reviewed",JsonValue.NewBool(true));this.Ok(o.ToJson());}

    [HttpPost]
    [Description("审核商品")]
    void Product(){if(!Workflow.ReviewProduct(this.In("id"),this.BoolIn("approve"),this.InText("note"))){this.Fail(422,"4003","review rejected");return;}JsonValue o=JsonValue.NewObject();o.Put("reviewed",JsonValue.NewBool(true));this.Ok(o.ToJson());}

    [HttpPost]
    [Description("审核版本")]
    void Version(){if(!Workflow.ReviewVersion(this.In("id"),this.BoolIn("approve"),this.InText("note"))){this.Fail(422,"4004","review rejected");return;}JsonValue o=JsonValue.NewObject();o.Put("reviewed",JsonValue.NewBool(true));this.Ok(o.ToJson());}

    [HttpPost]
    [Description("审核提现")]
    void Withdrawal(){if(!Workflow.ReviewWithdrawal(this.In("id"),this.BoolIn("approve"),this.InText("note"))){this.Fail(422,"4005","review rejected");return;}JsonValue o=JsonValue.NewObject();o.Put("reviewed",JsonValue.NewBool(true));this.Ok(o.ToJson());}

    [HttpPost]
    [Description("停用授权")]
    void Entitlement(){if(!Workflow.SetEntitlementDisabled(this.In("id"),this.BoolIn("disabled"))){this.Fail(422,"4006","update rejected");return;}JsonValue o=JsonValue.NewObject();o.Put("updated",JsonValue.NewBool(true));this.Ok(o.ToJson());}
}
