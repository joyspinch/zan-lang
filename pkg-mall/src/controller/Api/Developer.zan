using System;
using ZanWeb;
using System.Web;
using System.Json;

namespace ZanWeb.Api;

[Route("api/[controller]/[action]")]
[Custom(Authorization = CustomAuthorization.None)]
[Description("开发者")]
class Developer : ApiController {
    [HttpPost]
    [Custom(Authorization = CustomAuthorization.Login)]
    [Description("申请开发者")]
    void Apply(){if(!Workflow.ApplyDeveloper(this.uid,this.In("display_name"),this.InText("bio"))){this.Fail(422,"3001","application rejected");return;}JsonValue o=JsonValue.NewObject();o.Put("submitted",JsonValue.NewBool(true));this.Ok(o.ToJson());}

    [HttpPost]
    [Custom(Authorization = CustomAuthorization.ApiAuth)]
    [Description("提交商品")]
    void Product(){string id=Workflow.SubmitProduct(this.uid,this.In("category_id"),this.In("slug"),this.In("name"),this.InText("description"));if(id.Length==0){this.Fail(422,"3002","product rejected");return;}JsonValue o=JsonValue.NewObject();o.Put("id",JsonValue.NewStr(id));this.Ok(o.ToJson());}

    [HttpPost]
    [Custom(Authorization = CustomAuthorization.ApiAuth)]
    [Description("提交版本")]
    void Version(){string id=Workflow.SubmitVersion(this.uid,this.In("product_id"),this.In("version"),this.InInt("major",0),this.In("artifact_url"),this.InText("release_notes"));if(id.Length==0){this.Fail(422,"3003","version rejected");return;}JsonValue o=JsonValue.NewObject();o.Put("id",JsonValue.NewStr(id));this.Ok(o.ToJson());}

    [HttpPost]
    [Custom(Authorization = CustomAuthorization.ApiAuth)]
    [Description("添加价格方案")]
    void Plan(){if(!Workflow.AddPlan(this.uid,this.In("product_id"),this.In("name"),this.In("license_mode"),this.InInt("price_points",0),this.InInt("duration_days",0))){this.Fail(422,"3004","plan rejected");return;}JsonValue o=JsonValue.NewObject();o.Put("created",JsonValue.NewBool(true));this.Ok(o.ToJson());}

    [HttpPost]
    [Custom(Authorization = CustomAuthorization.ApiAuth)]
    [Description("申请提现")]
    void Withdraw(){if(!Workflow.Withdraw(this.uid,this.InInt("amount_points",0),this.In("account"))){this.Fail(422,"3005","withdrawal rejected");return;}JsonValue o=JsonValue.NewObject();o.Put("submitted",JsonValue.NewBool(true));this.Ok(o.ToJson());}
}
