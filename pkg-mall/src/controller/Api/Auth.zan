using System;
using ZanWeb;
using System.Web;
using System.Json;

namespace ZanWeb.Api;

[Route("api/[controller]/[action]")]
[Custom(Authorization = CustomAuthorization.None)]
[Description("认证")]
class Auth : ApiController {
    [HttpPost]
    [Description("注册")]
    void Register() {
        string id=Identity.Register(this.In("username"),this.In("password"));
        if(id.Length==0){this.Fail(422,"1003","invalid or duplicate account");return;}
        JsonValue o=JsonValue.NewObject();o.Put("id",JsonValue.NewStr(id));this.Ok(o.ToJson());
    }

    [HttpPost]
    [Description("登录")]
    void Login() {
        string token=Identity.Login(this.In("username"),this.In("password"));
        if(token.Length==0){this.Fail(401,"1001","bad credentials");return;}
        this.ctx.SetCookie("zsession",token,2592000);
        JsonValue o=JsonValue.NewObject();o.Put("token",JsonValue.NewStr(token));this.Ok(o.ToJson());
    }

    [HttpGet]
    [Custom(Authorization = CustomAuthorization.Login)]
    [Description("当前用户")]
    void Me() {
        this.Ok(Identity.Json(this.uid));
    }
}
