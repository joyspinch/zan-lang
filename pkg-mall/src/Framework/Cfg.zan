using System;
using System.IO;
using System.Json;

namespace ZanWeb;

/* [server] 配置。*/
class Cfg {
    static ServerCfg Server = ServerCfg.Defaults();
    static DatabaseCfg Db = DatabaseCfg.Defaults();
    static WorkerCfg Worker = WorkerCfg.Defaults();
    static LogCfg Log = LogCfg.Defaults();
    static CacheCfg Cache = CacheCfg.Defaults();
    static AuthCfg Auth = AuthCfg.Defaults();
    static MetricsCfg Metrics = MetricsCfg.Defaults();
    static bool loaded = false;

    /* 依次查找约定的配置文件，找到后叠加到内置默认值之上。*/
    static void Load(string relPath) {
        loaded = true;
        List<string> cands = new List<string>();
        if (relPath.Length > 0) { cands.Add(relPath); }
        cands.Add("config/app.json");
        cands.Add("app.json");
        cands.Add("../config/app.json");
        JsonValue root = null;
        int i = 0;
        while (i < cands.Count) {
            if (File.Exists(cands[i])) {
                string txt = File.ReadAllText(cands[i]);
                if (txt.Length > 0) {
                    root = JsonValue.ParseLenient(txt);
                    Console.WriteLine("[config] loaded " + cands[i]);
                    break;
                }
            }
            i = i + 1;
        }
        if (root == null) {
            Console.WriteLine("[config] no config file found; using built-in defaults");
            Cfg.ApplyEnv();
            return;
        }
        Cfg.Apply(root);
        Cfg.ApplyEnv();
    }

    /* 环境变量覆盖，最后应用：部署时不改文件即可指向其他数据库。密码等敏感值应放在此处。*/
    static void ApplyEnv() {
        Cfg.Db.driver = Cfg.EnvStr("ZAN_DB_DRIVER", Cfg.Db.driver);
        Cfg.Db.host = Cfg.EnvStr("ZAN_DB_HOST", Cfg.Db.host);
        Cfg.Db.port = Cfg.EnvInt("ZAN_DB_PORT", Cfg.Db.port);
        Cfg.Db.name = Cfg.EnvStr("ZAN_DB_NAME", Cfg.Db.name);
        Cfg.Db.user = Cfg.EnvStr("ZAN_DB_USER", Cfg.Db.user);
        Cfg.Db.password = Cfg.EnvStr("ZAN_DB_PASSWORD", Cfg.Db.password);
        Cfg.Db.sqlitePath = Cfg.EnvStr("ZAN_DB_SQLITE_PATH", Cfg.Db.sqlitePath);
        Cfg.Db.poolSize = Cfg.EnvInt("ZAN_DB_POOL_SIZE", Cfg.Db.poolSize);
        Cfg.Cache.redisHost = Cfg.EnvStr("ZAN_REDIS_HOST", Cfg.Cache.redisHost);
        Cfg.Cache.redisPort = Cfg.EnvInt("ZAN_REDIS_PORT", Cfg.Cache.redisPort);
        Cfg.Worker.count = Cfg.EnvInt("ZAN_WORKERS", Cfg.Worker.count);
        Cfg.Auth.secret = Cfg.EnvStr("ZAN_AUTH_SECRET", Cfg.Auth.secret);
    }

    static string EnvStr(string name, string fallback) {
        string v = ProcessHost.Env(name);
        if (v.Length == 0) { return fallback; }
        return v;
    }

    static int EnvInt(string name, int fallback) {
        string v = ProcessHost.Env(name);
        if (v.Length == 0) { return fallback; }
        int n = Convert.ToInt32(v);
        if (n <= 0) { return fallback; }
        return n;
    }

    static JsonValue Sec(JsonValue root, string name) {
        JsonValue v = root.Get(name);
        if (v == null) { return JsonValue.NewObject(); }
        if (!v.IsObject()) { return JsonValue.NewObject(); }
        return v;
    }

    static void Apply(JsonValue root) {
        JsonValue s = Cfg.Sec(root, "server");
        Cfg.Server.name = s.Str("name", Cfg.Server.name);
        Cfg.Server.host = s.Str("host", Cfg.Server.host);
        Cfg.Server.port = s.Int("port", Cfg.Server.port);
        Cfg.Server.maxBodyMB = s.Int("maxBodyMB", Cfg.Server.maxBodyMB);
        Cfg.Server.globalLimitPerSec = s.Int("globalLimitPerSec", Cfg.Server.globalLimitPerSec);

        JsonValue d = Cfg.Sec(root, "database");
        Cfg.Db.driver = d.Str("driver", Cfg.Db.driver);
        Cfg.Db.sqlitePath = d.Str("sqlitePath", Cfg.Db.sqlitePath);
        Cfg.Db.host = d.Str("host", Cfg.Db.host);
        Cfg.Db.port = d.Int("port", Cfg.Db.port);
        Cfg.Db.name = d.Str("name", Cfg.Db.name);
        Cfg.Db.user = d.Str("user", Cfg.Db.user);
        Cfg.Db.password = d.Str("password", Cfg.Db.password);
        Cfg.Db.poolSize = d.Int("poolSize", Cfg.Db.poolSize);

        JsonValue w = Cfg.Sec(root, "worker");
        Cfg.Worker.count = w.Int("count", Cfg.Worker.count);
        Cfg.Worker.daemon = w.Bool("daemon", Cfg.Worker.daemon);

        JsonValue l = Cfg.Sec(root, "log");
        Cfg.Log.access = l.Bool("access", Cfg.Log.access);
        Cfg.Log.slowMs = l.Int("slowMs", Cfg.Log.slowMs);
        Cfg.Log.slowSqlMs = l.Int("slowSqlMs", Cfg.Log.slowSqlMs);
        Cfg.Log.dir = l.Str("dir", Cfg.Log.dir);
        Cfg.Log.pattern = l.Str("pattern", Cfg.Log.pattern);
        Cfg.Log.errorLog = l.Str("errorLog", Cfg.Log.errorLog);
        Cfg.Log.debug = l.Bool("debug", Cfg.Log.debug);

        JsonValue mt = Cfg.Sec(root, "metrics");
        Cfg.Metrics.enabled = mt.Bool("enabled", Cfg.Metrics.enabled);
        Cfg.Metrics.path = mt.Str("path", Cfg.Metrics.path);
        Cfg.Metrics.flushSeconds = mt.Int("flushSeconds", Cfg.Metrics.flushSeconds);
        Cfg.Metrics.flushRows = mt.Int("flushRows", Cfg.Metrics.flushRows);
        Cfg.Metrics.keepDays = mt.Int("keepDays", Cfg.Metrics.keepDays);

        JsonValue c = Cfg.Sec(root, "cache");
        Cfg.Cache.driver = c.Str("driver", Cfg.Cache.driver);
        Cfg.Cache.redisHost = c.Str("redisHost", Cfg.Cache.redisHost);
        Cfg.Cache.redisPort = c.Int("redisPort", Cfg.Cache.redisPort);
        Cfg.Cache.poolSize = c.Int("poolSize", Cfg.Cache.poolSize);
        Cfg.Cache.connectTimeoutMs = c.Int(
            "connectTimeoutMs", Cfg.Cache.connectTimeoutMs);

        JsonValue a = Cfg.Sec(root, "auth");
        Cfg.Auth.secret = a.Str("secret", Cfg.Auth.secret);
    }
}
