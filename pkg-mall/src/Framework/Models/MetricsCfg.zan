using System;

namespace Mall.Framework;

class MetricsCfg {
    bool enabled;
    /* 独立的 SQLite 文件。*/
    string path;
    /* 定时刷写间隔（秒）；60 = 一分钟。*/
    int flushSeconds;
    /* 达到此行数也触发刷写。*/
    int flushRows;
    /* 保留天数，每小时清理。*/
    int keepDays;

    static MetricsCfg Defaults() {
        MetricsCfg c = new MetricsCfg();
        c.enabled = true;
        c.path = "metrics.db";
        c.flushSeconds = 60;
        c.flushRows = 2000;
        c.keepDays = 30;
        return c;
    }
}

