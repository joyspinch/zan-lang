using System;

namespace Mall.Framework;

class LogCfg {
    bool access;
    int slowMs;
    /* 慢 SQL 阈值，达此值即记入日志并计数。*/
    int slowSqlMs;
    /* 按日日志目录，"" 禁用文件输出。*/
    string dir;
    /* 日志文件名模式，每次写入展开。*/
    string pattern;
    /* 错误日志文件，"" 禁用。*/
    string errorLog;
    /* 同时向控制台输出错误，生产环境关闭。*/
    bool debug;

    static LogCfg Defaults() {
        LogCfg c = new LogCfg();
        c.access = false;
        c.slowMs = 1000;
        /* 故意低于请求阈值：单个 SQL 超过 200ms 已属异常。*/
        c.slowSqlMs = 200;
        c.dir = "logs";
        c.pattern = "{yyyy}{MM}/{dd}.log";
        c.errorLog = "logs/{yyyy}{MM}/{dd}.log";
        c.debug = false;
        return c;
    }
}

/* [metrics] 配置：指标历史存储位置和刷写频率。请求仅累加分钟桶，不直接写入。*/
