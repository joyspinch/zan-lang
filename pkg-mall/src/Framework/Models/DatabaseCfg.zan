using System;

namespace Mall.Framework;

class DatabaseCfg {
    string driver;
    string sqlitePath;
    string host;
    int port;
    string name;
    string user;
    string password;
    /* 每个 worker 进程独立池的最大连接数；全服务最多 poolSize * worker.count。*/
    int poolSize;

    static DatabaseCfg Defaults() {
        DatabaseCfg c = new DatabaseCfg();
        c.driver = "sqlite";
        c.sqlitePath = "app.db";
        c.host = "127.0.0.1";
        c.port = 3306;
        c.name = "app";
        c.user = "root";
        c.password = "";
        c.poolSize = 8;
        return c;
    }
}

/* [worker] 配置。*/
