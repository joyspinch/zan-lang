using System;

namespace Mall.Framework;

class CacheCfg {
    string driver;
    string redisHost;
    int redisPort;
    int poolSize;
    int connectTimeoutMs;

    static CacheCfg Defaults() {
        CacheCfg c = new CacheCfg();
        c.driver = "memory";
        c.redisHost = "127.0.0.1";
        c.redisPort = 6379;
        c.poolSize = 8;
        c.connectTimeoutMs = 3000;
        return c;
    }
}

/* 运行时配置：启动时从 config/app.json 加载一次为全局强类型实体，通过 Cfg.Server.port 等直接访问。无编译期固化，改配置后重启生效。*/
