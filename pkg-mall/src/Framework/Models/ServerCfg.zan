using System;

namespace Mall.Framework;

class ServerCfg {
    string name;
    string host;
    int port;
    int maxBodyMB;
    int globalLimitPerSec;

    static ServerCfg Defaults() {
        ServerCfg c = new ServerCfg();
        c.name = "{{NAME}}";
        c.host = "127.0.0.1";
        c.port = 8080;
        c.maxBodyMB = 2;
        c.globalLimitPerSec = 0;
        return c;
    }
}

