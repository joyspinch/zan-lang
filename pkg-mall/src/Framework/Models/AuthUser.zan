using System;
using System.Collections.Generic;

namespace Mall.Framework;

class AuthUser {
    static string Active = "active";

    static async IDbConnection Lease() {
        AppServices s = AppServices.Current();
        if (s == null) { return null; }
        return await s.Db().Acquire();
    }

    static void Give(IDbConnection db) {
        AppServices s = AppServices.Current();
        if (s == null) { return; }
        s.Db().Release(db);
    }

    static string PasswordHash(string password, string salt) {
        string material = salt + ":" + password;
        int i = 0;
        while (i < 12000) {
            material = Hex.Encode(Sha256.Hash(material + ":" + salt,
                material.Length + salt.Length + 1), 32);
            i = i + 1;
        }
        return material;
    }

    static async User ById(string uid) {
        int id = AuthUser.ToInt(uid);
        if (id <= 0) { return null; }
        IDbConnection db = await AuthUser.Lease();
        if (db == null) { return null; }
        try {
            return await new MallUserDao(db).ById(id);
        } finally {
            AuthUser.Give(db);
        }
    }

    /* 调度器权限解析：登录即可访问 Login/ApiAuth 级别页面；
       角色字符串由 AuthToken.Resolve 注入 ctx.state，这里只挡未登录。 */
    static async bool Allow(string uid, string action) {
        if (uid.Length == 0) { return false; }
        User me = await AuthUser.ById(uid);
        return me != null && me.status == AuthUser.Active;
    }

    static int ToInt(string s) {
        return Filter.ToInt(s, 0);
    }
}

/* 角色常量与校验：ApiAuth 控制器动作内的二次闸（管理/开发者），
 * 避免为两个角色拉起整套 RBAC。角色随 cookie 携带、Resolve 时与
 * 库中 role 比对后放行（this.Role 由控制器在动作内先取）。 */
