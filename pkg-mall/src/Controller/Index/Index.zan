using System;
using System.Data;
using System.Data.Orm;
using System.Web;
using ZanWeb;
using ZanWeb.Model.Mall;

namespace ZanWeb.Index;

/* 商城首页 /：横幅 + 扩展与程序双目录（公开）。两类商品受众不同，
 * 卡片上的动作也不同——扩展"在 IDE 中安装"，程序"购买后下载运行"。
 * 目录数据与 /api/mall/catalog 同源（CatalogDao），只是渲染成页面。 */
[Route("[controller]/[action]")]
[Custom(Authorization = CustomAuthorization.None)]
[Description("商城首页")]
class Index : AppController {
    [HttpGet]
    [Route("/")]
    [Description("商城首页")]
    async void Index() {
        if (!this.DbReady()) { this.Fail(503, "2001", "服务暂时不可用，请稍后再试"); }
        CatalogDao dao = new CatalogDao(this.Held());
        List<Category> cats = await dao.Categories();
        List<Product> rows = await dao.ApprovedProducts();

        ViewData d = new ViewData();
        await Settings.Apply(d);
        d.Set("title", "Zan 扩展与程序商城");
        d.Set("logged", this.IsLogin() ? "1" : "");
        d.Set("anonymous", this.IsLogin() ? "" : "1");
        d.Set("username", await Index.NameOf(this));

        List<StrMap> extensions = d.AddList("extensions");
        List<StrMap> apps = d.AddList("apps");
        for (int i = 0; i < rows.Count; i = i + 1) {
            Product p = rows[i];
            StrMap m = new StrMap();
            m.Set("id", Convert.ToString(p.id));
            m.Set("name", p.name);
            m.Set("slug", p.slug);
            m.Set("description", p.description);
            m.Set("category", Index.CategorySlug(cats, p.categoryId));
            long price = await MallFlow.MinPrice(this.Held(), p.id);
            m.Set("price", price == 0 ? "免费" : Convert.ToString(price) + " 积分");
            if (p.productType == "app") { apps.Add(m); }
            else { extensions.Add(m); }
        }
        d.Set("noExtensions", extensions.Count == 0 ? "1" : "");
        d.Set("noApps", apps.Count == 0 ? "1" : "");
        this.View(d);
    }

    static async string NameOf(Index self) {
        if (!self.IsLogin()) { return ""; }
        IdentityFlow flow = new IdentityFlow(self.Held());
        User me = await flow.ById(Filter.ToInt(self.uid, 0));
        return me != null ? me.username : "";
    }

    static string CategorySlug(List<Category> cats, int id) {
        for (int i = 0; i < cats.Count; i = i + 1) {
            if (cats[i].id == id) { return cats[i].slug; }
        }
        return "";
    }
}
