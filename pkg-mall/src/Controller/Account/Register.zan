using System;
using System.Data;
using System.Web;
using ZanWeb;

namespace ZanWeb.Account;

/* 注册：创建账号后直接登录（同一 cookie 机制），跳转 next 或首页。 */
[Route("[controller]/[action]")]
[Custom(Authorization = CustomAuthorization.None)]
[Description("注册")]
class Register : AppController {
    static string Tpl = "Account.Register.Index";

    [HttpGet]
    [Route("/register")]
    void Index() {
        if (this.IsLogin()) { this.Ctx().Redirect("/account"); }
        this.ViewOf(Register.Tpl, Register.Form("", this.In("user"),
            Login.SafeNext(this.In("next"))));
    }

    [HttpPost]
    [Route("/register")]
    async void Submit() {
        string user = this.In("user");
        string pass = this.In("password");
        string confirm = this.In("confirm");
        string next = Login.SafeNext(this.In("next"));
        if (user.Length < 3 || user.Length > 64) {
            this.ViewOf(Register.Tpl, Register.Form("账号需要 3-64 个字符", user, next));
            return;
        }
        if (pass.Length < 8 || pass.Length > 128) {
            this.ViewOf(Register.Tpl, Register.Form("密码需要 8-128 个字符", user, next));
            return;
        }
        if (pass != confirm) {
            this.ViewOf(Register.Tpl, Register.Form("两次输入的密码不一致", user, next));
            return;
        }
        if (!this.DbReady()) {
            this.ViewOf(Register.Tpl, Register.Form("服务暂时不可用，请稍后再试", user, next));
            return;
        }
        IdentityFlow flow = new IdentityFlow(this.Held());
        string id = await flow.Register(user, pass);
        if (id.Length == 0) {
            this.ViewOf(Register.Tpl, Register.Form("账号无效或已被占用", user, next));
            return;
        }
        string token = await flow.Login(user, pass);
        if (token.Length > 0) {
            this.Ctx().SetCookie("zsession", token, 2592000);
        }
        this.Ctx().Redirect(next.Length > 0 ? next : "/account");
    }

    static ViewData Form(string error, string user, string next) {
        ViewData d = new ViewData();
        d.Set("title", "注册 · Zan 商城");
        d.Set("error", error);
        d.Set("user", user);
        d.Set("next", next);
        return d;
    }
}
