using System;
using ZanWeb;
using System.Web;
using System.Json;
using ZanWeb.Model.Mall;

namespace ZanWeb.Api;

/* 管理端 API：卡密、四类审核、授权停用。角色闸在 Controller 属性
 * （ApiAuth + Allow 解析 admin 角色），动作内再验证 pending 状态机。 */
[Route("api/[controller]/[action]")]
[Custom(Authorization = CustomAuthorization.ApiAuth)]
[Description("商城管理")]
class MallAdmin : ApiController {
    bool BoolIn(string name) {
        string v = this.In(name);
        return v == "1" || v == "true";
    }

    [HttpPost]
    [Tx]
    async void Codes() {
        if (!this.DbReady()) { this.Fail(503, "2001", "database unavailable"); }
        List<string> codes = await new IdentityFlow(this.Held()).GenerateCodes(
            this.InInt("count", 0), Filter.ToLong(this.In("points"), 0));
        if (codes.Count == 0) { this.Fail(422, "4001", "generation rejected"); }
        JsonValue o = JsonValue.NewObject();
        JsonValue arr = JsonValue.NewArray();
        for (int i = 0; i < codes.Count; i = i + 1) {
            arr.Append(JsonValue.NewStr(codes[i]));
        }
        o.Put("codes", arr);
        this.Ok(o.ToJson());
    }

    [HttpPost]
    [Tx]
    async void Developer() {
        if (!this.DbReady()) { this.Fail(503, "2001", "database unavailable"); }
        bool ok = await new IdentityFlow(this.Held()).ReviewDeveloper(
            this.InInt("id", 0), this.BoolIn("approve"), this.InText("note"));
        if (!ok) { this.Fail(422, "4002", "review rejected"); }
        JsonValue o = JsonValue.NewObject();
        o.Put("reviewed", JsonValue.NewBool(true));
        this.Ok(o.ToJson());
    }

    [HttpPost]
    [Tx]
    async void Product() {
        if (!this.DbReady()) { this.Fail(503, "2001", "database unavailable"); }
        bool ok = await new IdentityFlow(this.Held()).ReviewProduct(
            this.InInt("id", 0), this.BoolIn("approve"), this.InText("note"));
        if (!ok) { this.Fail(422, "4003", "review rejected"); }
        JsonValue o = JsonValue.NewObject();
        o.Put("reviewed", JsonValue.NewBool(true));
        this.Ok(o.ToJson());
    }

    [HttpPost]
    [Tx]
    async void Version() {
        if (!this.DbReady()) { this.Fail(503, "2001", "database unavailable"); }
        bool ok = await new IdentityFlow(this.Held()).ReviewVersion(
            this.InInt("id", 0), this.BoolIn("approve"), this.InText("note"));
        if (!ok) { this.Fail(422, "4004", "review rejected"); }
        JsonValue o = JsonValue.NewObject();
        o.Put("reviewed", JsonValue.NewBool(true));
        this.Ok(o.ToJson());
    }

    [HttpPost]
    [Tx]
    async void Withdrawal() {
        if (!this.DbReady()) { this.Fail(503, "2001", "database unavailable"); }
        bool ok = await new IdentityFlow(this.Held()).ReviewWithdrawal(
            this.InInt("id", 0), this.BoolIn("approve"), this.InText("note"));
        if (!ok) { this.Fail(422, "4005", "review rejected"); }
        JsonValue o = JsonValue.NewObject();
        o.Put("reviewed", JsonValue.NewBool(true));
        this.Ok(o.ToJson());
    }

    [HttpPost]
    [Tx]
    async void Entitlement() {
        if (!this.DbReady()) { this.Fail(503, "2001", "database unavailable"); }
        bool ok = await new IdentityFlow(this.Held()).SetEntitlementDisabled(
            this.InInt("id", 0), this.BoolIn("disabled"));
        if (!ok) { this.Fail(422, "4006", "update rejected"); }
        JsonValue o = JsonValue.NewObject();
        o.Put("updated", JsonValue.NewBool(true));
        this.Ok(o.ToJson());
    }
}
