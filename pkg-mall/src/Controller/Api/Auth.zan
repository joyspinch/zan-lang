using System;
using ZanWeb;
using System.Web;
using System.Json;

namespace ZanWeb.Api;

/* 认证端点：注册 / 登录 / 当前用户。登录成功签发 zsession cookie（30 天）。 */
[Route("api/[controller]/[action]")]
[Custom(Authorization = CustomAuthorization.None)]
[Description("认证")]
class Auth : ApiController {
    [HttpPost]
    async void Register() {
        string username = this.Need("username", "username");
        string password = this.Need("password", "password");
        if (!this.DbReady()) { this.Fail(503, "2001", "database unavailable"); }
        string id = await new IdentityFlow(this.Held()).Register(username, password);
        if (id.Length == 0) {
            this.Fail(422, "1003", "invalid or duplicate account");
        }
        JsonValue o = JsonValue.NewObject();
        o.Put("id", JsonValue.NewStr(id));
        this.Ok(o.ToJson());
    }

    [HttpPost]
    async void Login() {
        string username = this.Need("username", "username");
        string password = this.Need("password", "password");
        if (!this.DbReady()) { this.Fail(503, "2001", "database unavailable"); }
        string token = await new IdentityFlow(this.Held()).Login(username, password);
        if (token.Length == 0) { this.Fail(401, "1001", "bad credentials"); }
        this.ctx.SetCookie("zsession", token, 2592000);
        JsonValue o = JsonValue.NewObject();
        o.Put("token", JsonValue.NewStr(token));
        this.Ok(o.ToJson());
    }

    [HttpGet]
    [Custom(Authorization = CustomAuthorization.Login)]
    async void Me() {
        if (!this.DbReady()) { this.Fail(503, "2001", "database unavailable"); }
        this.Ok(await new IdentityFlow(this.Held())
            .MeJson(Filter.ToInt(this.uid, 0)));
    }
}
