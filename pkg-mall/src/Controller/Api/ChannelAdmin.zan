using System;
using ZanWeb;
using System.Web;
using System.Json;
using ZanWeb.Model.Mall;

namespace ZanWeb.Api;

/* 管理端版本频道：发布新版本（含灰度与安全下限）、回滚到历史发布。
 * 包体校验三元组（url/sha256/signature）在这里登记后，
 * 客户端 check 响应才会带上下载信息。 */
[Route("api/[controller]/[action]")]
[Custom(Authorization = CustomAuthorization.ApiAuth)]
[Description("频道管理")]
class ChannelAdmin : ApiController {
    [HttpPost]
    [Tx]
    async void Publish() {
        if (!this.DbReady()) { this.Fail(503, "2001", "database unavailable"); }
        bool ok = await new ChannelFlow(this.Held()).Publish(
            this.Need("channel", "channel"),
            this.In("platform"),
            this.Need("version", "version"),
            this.In("installer_url"),
            this.In("sha256"),
            this.In("signature"),
            this.InText("release_notes"),
            this.InInt("rollout_percent", 100),
            this.In("required_version"));
        if (!ok) { this.Fail(422, "4101", "publish rejected"); }
        JsonValue o = JsonValue.NewObject();
        o.Put("published", JsonValue.NewBool(true));
        this.Ok(o.ToJson());
    }

    [HttpPost]
    [Tx]
    async void Rollback() {
        if (!this.DbReady()) { this.Fail(503, "2001", "database unavailable"); }
        bool ok = await new ChannelFlow(this.Held()).Rollback(
            this.Need("channel", "channel"),
            this.In("platform"),
            this.Need("version", "version"));
        if (!ok) { this.Fail(422, "4102", "rollback rejected"); }
        JsonValue o = JsonValue.NewObject();
        o.Put("rolled_back", JsonValue.NewBool(true));
        this.Ok(o.ToJson());
    }
}
