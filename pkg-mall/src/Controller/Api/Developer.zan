using System;
using ZanWeb;
using System.Web;
using System.Json;
using ZanWeb.Model.Mall;

namespace ZanWeb.Api;

/* 开发者端点：申请、提交商品/版本/方案、提现。商品与版本类动作
 * 要求已审核通过的开发者（ApiAuth），由 IdentityFlow 内部再闸一次。 */
[Route("api/[controller]/[action]")]
[Custom(Authorization = CustomAuthorization.None)]
[Description("开发者")]
class Developer : ApiController {
    [HttpPost]
    [Custom(Authorization = CustomAuthorization.Login)]
    [Tx]
    async void Apply() {
        if (!this.DbReady()) { this.Fail(503, "2001", "database unavailable"); }
        bool ok = await new IdentityFlow(this.Held()).ApplyDeveloper(
            Filter.ToInt(this.uid, 0), this.In("display_name"), this.InText("bio"));
        if (!ok) { this.Fail(422, "3001", "application rejected"); }
        JsonValue o = JsonValue.NewObject();
        o.Put("submitted", JsonValue.NewBool(true));
        this.Ok(o.ToJson());
    }

    [HttpPost]
    [Custom(Authorization = CustomAuthorization.ApiAuth)]
    [Tx]
    async void Product() {
        if (!this.DbReady()) { this.Fail(503, "2001", "database unavailable"); }
        string id = await new IdentityFlow(this.Held()).SubmitProduct(
            Filter.ToInt(this.uid, 0), this.InInt("category_id", 0),
            this.In("slug"), this.In("name"), this.InText("description"),
            this.In("product_type"));
        if (id.Length == 0) { this.Fail(422, "3002", "product rejected"); }
        JsonValue o = JsonValue.NewObject();
        o.Put("id", JsonValue.NewStr(id));
        this.Ok(o.ToJson());
    }

    [HttpPost]
    [Custom(Authorization = CustomAuthorization.ApiAuth)]
    [Tx]
    async void Version() {
        if (!this.DbReady()) { this.Fail(503, "2001", "database unavailable"); }
        string id = await new IdentityFlow(this.Held()).SubmitVersion(
            Filter.ToInt(this.uid, 0), this.InInt("product_id", 0),
            this.In("version"), this.InInt("major", 0),
            this.In("artifact_url"), this.InText("release_notes"),
            this.In("artifact_sha256"), this.In("artifact_signature"));
        if (id.Length == 0) { this.Fail(422, "3003", "version rejected"); }
        JsonValue o = JsonValue.NewObject();
        o.Put("id", JsonValue.NewStr(id));
        this.Ok(o.ToJson());
    }

    [HttpPost]
    [Custom(Authorization = CustomAuthorization.ApiAuth)]
    [Tx]
    async void Plan() {
        if (!this.DbReady()) { this.Fail(503, "2001", "database unavailable"); }
        bool ok = await new IdentityFlow(this.Held()).AddPlan(
            Filter.ToInt(this.uid, 0), this.InInt("product_id", 0),
            this.In("name"), this.In("license_mode"),
            Filter.ToLong(this.In("price_points"), 0),
            this.InInt("duration_days", 0));
        if (!ok) { this.Fail(422, "3004", "plan rejected"); }
        JsonValue o = JsonValue.NewObject();
        o.Put("created", JsonValue.NewBool(true));
        this.Ok(o.ToJson());
    }

    [HttpPost]
    [Custom(Authorization = CustomAuthorization.ApiAuth)]
    [Tx]
    async void Withdraw() {
        if (!this.DbReady()) { this.Fail(503, "2001", "database unavailable"); }
        bool ok = await new IdentityFlow(this.Held()).Withdraw(
            Filter.ToInt(this.uid, 0), Filter.ToLong(this.In("amount_points"), 0),
            this.In("account"));
        if (!ok) { this.Fail(422, "3005", "withdrawal rejected"); }
        JsonValue o = JsonValue.NewObject();
        o.Put("submitted", JsonValue.NewBool(true));
        this.Ok(o.ToJson());
    }
}
