using System;
using System.Data;
using System.Data.Orm;
using System.Json;
using System.Web;
using ZanWeb;
using ZanWeb.Model.Mall;

namespace ZanWeb.Mall;

/* 商品详情页 /mall/product?id=N：公开浏览；交易动作（购买/兑换）走
 * 同页表单 POST，登录闸在动作内（未登录 302 到 /login?next=…）。
 * 详情数据与 /api/mall/product 同源（MallFlow.ProductJson 再拆页），
 * 页面只做渲染，不做第二套业务规则。 */
[Route("mall/[controller]/[action]")]
[Custom(Authorization = CustomAuthorization.None)]
[Description("商品详情")]
class Product : AppController {
    [HttpGet]
    [Route("/mall/product")]
    [Description("商品详情")]
    async void Index() {
        if (!this.DbReady()) { this.Fail(503, "2001", "服务暂时不可用，请稍后再试"); }
        int id = this.InInt("id", 0);
        MallFlow flow = new MallFlow(this.Held());
        JsonValue data = await flow.ProductDetail(id);
        if (data == null) { this.Fail(404, "2004", "商品不存在或未上架"); }

        ViewData d = new ViewData();
        await Settings.Apply(d);
        d.Set("title", data.Str("name", "商品") + " · Zan 商城");
        d.Set("logged", this.IsLogin() ? "1" : "");
        d.Set("anonymous", this.IsLogin() ? "" : "1");
        d.Set("username", await Product.NameOf(this));
        d.Set("pid", Convert.ToString(id));
        d.Set("name", data.Str("name", ""));
        d.Set("description", data.Str("description", ""));
        string type = data.Str("product_type", "extension");
        d.Set("isApp", type == "app" ? "1" : "");
        d.Set("typeLabel", type == "app" ? "程序" : "扩展");
        d.Set("slug", data.Str("slug", ""));

        /* 最便宜的启用方案作为主价格。 */
        JsonValue plans = data.Get("plans");
        long minPrice = 0;
        bool anyPlan = false;
        List<StrMap> planRows = d.AddList("plans");
        if (plans != null && plans.IsArray()) {
            for (int i = 0; i < plans.Count(); i = i + 1) {
                JsonValue po = plans.At(i);
                StrMap m = new StrMap();
                m.Set("id", po.Str("id", ""));
                m.Set("name", po.Str("name", ""));
                long price = Filter.ToLong(po.Str("price_points", "0"), 0);
                m.Set("price", price == 0 ? "免费" : Convert.ToString(price) + " 积分");
                m.Set("mode", po.Str("license_mode", "") == "periodic"
                    ? Convert.ToString(Filter.ToInt(po.Str("duration_days", "0"), 0)) + " 天订阅"
                    : "买断");
                planRows.Add(m);
                if (!anyPlan || price < minPrice) { minPrice = price; anyPlan = true; }
            }
        }
        d.Set("price", minPrice == 0 ? "免费" : Convert.ToString(minPrice) + " 积分");
        d.Set("noPlans", planRows.Count == 0 ? "1" : "");

        List<StrMap> versions = d.AddList("versions");
        JsonValue vs = data.Get("versions");
        if (vs != null && vs.IsArray()) {
            for (int i = 0; i < vs.Count(); i = i + 1) {
                JsonValue vo = vs.At(i);
                StrMap m = new StrMap();
                m.Set("version", vo.Str("version", ""));
                m.Set("notes", vo.Str("release_notes", ""));
                string sha = vo.Str("artifact_sha256", "");
                m.Set("verified", sha.Length == 64 ? "已签名" : "未签名");
                versions.Add(m);
            }
        }
        d.Set("noVersions", versions.Count == 0 ? "1" : "");

        /* 已购提示：登录用户对同产品持有效授权时把购买表单换成下载入口。 */
        d.Set("owned", "");
        d.Set("downloadUrl", "");
        if (this.IsLogin()) {
            int uid = Filter.ToInt(this.uid, 0);
            CatalogDao dao = new CatalogDao(this.Held());
            List<ProductVersion> approved = await dao.ApprovedVersions(id);
            if (approved.Count > 0) {
                string url = await flow.DownloadUrl(uid, approved[0].id);
                if (url.Length > 0) { d.Set("owned", "1"); }
            }
        }
        this.View(d);
    }

    static async string NameOf(Product self) {
        if (!self.IsLogin()) { return ""; }
        IdentityFlow flow = new IdentityFlow(self.Held());
        User me = await flow.ById(Filter.ToInt(self.uid, 0));
        return me != null ? me.username : "";
    }
}
