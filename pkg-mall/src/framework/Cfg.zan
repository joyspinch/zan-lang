using System;
using System.IO;
using System.Json;

namespace ZanWeb;

class ServerCfg {
    string host;
    int port;
    int maxBodyMB;
    int globalLimitPerSec;

    static ServerCfg Defaults() {
        ServerCfg c = new ServerCfg();
        c.host = "127.0.0.1";
        c.port = 8080;
        c.maxBodyMB = 2;
        c.globalLimitPerSec = 0;
        return c;
    }
}

class DatabaseCfg {
    string driver;
    string sqlitePath;
    string host;
    int port;
    string name;
    string user;
    string password;

    static DatabaseCfg Defaults() {
        DatabaseCfg c = new DatabaseCfg();
        c.driver = "mysql";
        c.sqlitePath = "app.db";
        c.host = "127.0.0.1";
        c.port = 3306;
        c.name = "zan_pkg_mall";
        c.user = "root";
        c.password = "";
        return c;
    }
}

class WorkerCfg {
    int count;
    bool daemon;

    static WorkerCfg Defaults() {
        WorkerCfg c = new WorkerCfg();
        c.count = 1;
        c.daemon = false;
        return c;
    }
}

class LogCfg {
    bool access;
    int slowMs;

    static LogCfg Defaults() {
        LogCfg c = new LogCfg();
        c.access = false;
        c.slowMs = 1000;
        return c;
    }
}

class CacheCfg {
    string driver;
    string redisHost;
    int redisPort;

    static CacheCfg Defaults() {
        CacheCfg c = new CacheCfg();
        c.driver = "memory";
        c.redisHost = "127.0.0.1";
        c.redisPort = 6379;
        return c;
    }
}

class Cfg {
    static ServerCfg Server = ServerCfg.Defaults();
    static DatabaseCfg Db = DatabaseCfg.Defaults();
    static WorkerCfg Worker = WorkerCfg.Defaults();
    static LogCfg Log = LogCfg.Defaults();
    static CacheCfg Cache = CacheCfg.Defaults();
    static bool loaded = false;

    static void Load(string relPath) {
        loaded = true;
        List<string> cands = new List<string>();
        if (relPath.Length > 0) { cands.Add(relPath); }
        cands.Add("config/app.json");
        cands.Add("app.json");
        cands.Add("../config/app.json");
        JsonValue root = null;
        int i = 0;
        while (i < cands.Count) {
            if (File.Exists(cands[i])) {
                string txt = File.ReadAllText(cands[i]);
                if (txt.Length > 0) {
                    root = JsonValue.ParseLenient(txt);
                    Console.WriteLine("[config] loaded " + cands[i]);
                    break;
                }
            }
            i = i + 1;
        }
        if (root == null) {
            Console.WriteLine("[config] no config file found; using built-in defaults");
            Cfg.ApplyEnvironment();
            return;
        }
        Cfg.Apply(root);
        Cfg.ApplyEnvironment();
    }

    static JsonValue Sec(JsonValue root, string name) {
        JsonValue v = root.Get(name);
        if (v == null) { return JsonValue.NewObject(); }
        if (!v.IsObject()) { return JsonValue.NewObject(); }
        return v;
    }

    static void Apply(JsonValue root) {
        JsonValue s = Cfg.Sec(root, "server");
        Cfg.Server.host = s.Str("host", Cfg.Server.host);
        Cfg.Server.port = s.Int("port", Cfg.Server.port);
        Cfg.Server.maxBodyMB = s.Int("maxBodyMB", Cfg.Server.maxBodyMB);
        Cfg.Server.globalLimitPerSec = s.Int("globalLimitPerSec", Cfg.Server.globalLimitPerSec);

        JsonValue d = Cfg.Sec(root, "database");
        Cfg.Db.driver = d.Str("driver", Cfg.Db.driver);
        Cfg.Db.sqlitePath = d.Str("sqlitePath", Cfg.Db.sqlitePath);
        Cfg.Db.host = d.Str("host", Cfg.Db.host);
        Cfg.Db.port = d.Int("port", Cfg.Db.port);
        Cfg.Db.name = d.Str("name", Cfg.Db.name);
        Cfg.Db.user = d.Str("user", Cfg.Db.user);
        Cfg.Db.password = d.Str("password", Cfg.Db.password);

        JsonValue w = Cfg.Sec(root, "worker");
        Cfg.Worker.count = w.Int("count", Cfg.Worker.count);
        Cfg.Worker.daemon = w.Bool("daemon", Cfg.Worker.daemon);

        JsonValue l = Cfg.Sec(root, "log");
        Cfg.Log.access = l.Bool("access", Cfg.Log.access);
        Cfg.Log.slowMs = l.Int("slowMs", Cfg.Log.slowMs);

        JsonValue c = Cfg.Sec(root, "cache");
        Cfg.Cache.driver = c.Str("driver", Cfg.Cache.driver);
        Cfg.Cache.redisHost = c.Str("redisHost", Cfg.Cache.redisHost);
        Cfg.Cache.redisPort = c.Int("redisPort", Cfg.Cache.redisPort);
    }

    static void ApplyEnvironment() {
        string password = Interop.EnvVar("ZAN_MALL_DB_PASSWORD");
        if (password != "") { Cfg.Db.password = password; }
    }
}
