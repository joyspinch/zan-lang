{
  "server": {
    "name": "pkg-mall",
    "host": "127.0.0.1",
    "port": 8090,
    "maxBodyMB": 64,
    "globalLimitPerSec": 0
  },
  "database": {
    "driver": "sqlite",
    "sqlitePath": "data/mall.db",
    "host": "127.0.0.1",
    "port": 3306,
    "name": "zan_pkg_mall",
    "user": "root",
    "password": "",
    "poolSize": 8
  },
  "auth": {
    "secret": "ZanPkgMall-ChangeMe-0123456789abcdef"
  },
  "worker": {
    "count": 1,
    "daemon": false
  },
  "log": {
    "access": false,
    "slowMs": 1000,
    "slowSqlMs": 200,
    "dir": "logs",
    "pattern": "{yyyy}{MM}/{dd}.log"
  },
  "metrics": {
    "enabled": true,
    "path": "data/metrics.db",
    "flushSeconds": 60,
    "flushRows": 2000,
    "keepDays": 30
  },
  "cache": {
    "driver": "memory",
    "redisHost": "127.0.0.1",
    "redisPort": 6379,
    "poolSize": 8,
    "connectTimeoutMs": 3000
  }
}
