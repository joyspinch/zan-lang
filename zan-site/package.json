{
  "name": "zan-language-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A new, dependency-free showcase for the Zan language.",
  "scripts": {
    "dev": "node scripts/build.mjs && node scripts/serve.mjs",
    "start": "node scripts/build.mjs && node scripts/serve.mjs",
    "preview": "node scripts/serve.mjs --preview",
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs && node scripts/build.mjs && node --test ../tests/site/docs.test.mjs"
  },
  "engines": { "node": ">=20" }
}
