--- !tapi-tbd
tbd-version:     4
targets:         [ arm64-ios ]
install-name:    '/System/Library/Frameworks/CoreGraphics.framework/CoreGraphics'
current-version: 1.0
compatibility-version: 1.0
exports:
  - targets:         [ arm64-ios ]
    symbols:         [ _CGColorSpaceCreateDeviceRGB, _CGColorSpaceCreateDeviceGray,
                       _CGColorSpaceRelease, _CGDataProviderCreateWithData,
                       _CGDataProviderRelease, _CGImageCreate, _CGImageRelease,
                       _CGBitmapContextCreate, _CGContextSetGrayFillColor,
                       _CGContextSetTextPosition, _CGContextTranslateCTM,
                       _CGContextScaleCTM, _CGContextFlush, _CGContextRelease,
                       _CGColorCreate, _CGColorRelease ]
...
