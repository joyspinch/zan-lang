<?xml version="1.0" encoding="utf-8"?>
<!--
  Canonical text source for AndroidManifest.xml.bin (the precompiled AXML
  template apk.c packs into every emitted APK).

  NOTE: XML comments may not contain double hyphens, so the regeneration
  command is spelled out below with [dd] standing in for the two dashes of
  each long option. Run from toolchain/apk-shell/ with an SDK build-tools
  aapt2 on PATH:

    aapt2 link [dd]manifest AndroidManifest.xml
      -I SDK/platforms/android-34/android.jar -o manifest.apk
      [dd]min-sdk-version 28 [dd]target-sdk-version 34
      [dd]version-code 1 [dd]version-name 1.0 [dd]auto-add-overlay
  then extract AndroidManifest.xml from manifest.apk into
  AndroidManifest.xml.bin (both toolchain/apk-shell/ and build/apk-shell/).

  Constraints (src/compiler/apk.c axml_patch): the string pool must hold
  exactly one "dev.zan.app" (package placeholder) and one "Zan App"
  (application label placeholder) - both are rewritten per build.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.zan.app"
    android:versionCode="1" android:versionName="1.0">
    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="34"/>
    <!-- Socket API needs it (socket() returns EPERM without the grant);
         targetSdk 30+ also requires it for cleartext-notice. HTTPS-only
         traffic stays the runtime default. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <application android:label="Zan App"
        android:hasCode="true" android:theme="@android:style/Theme.NoTitleBar.Fullscreen">
        <activity android:name="org.libsdl.app.SDLActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|uiMode"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <meta-data android:name="android.app.lib_name" android:value="main"/>
    </application>
</manifest>
