        KT[0] = 0xD76AA478L; KT[1] = 0xE8C7B756L; KT[2] = 0x242070DBL; KT[3] = 0xC1BDCEEEL;
        KT[4] = 0xF57C0FAFL; KT[5] = 0x4787C62AL; KT[6] = 0xA8304613L; KT[7] = 0xFD469501L;
        KT[8] = 0x698098D8L; KT[9] = 0x8B44F7AFL; KT[10] = 0xFFFF5BB1L; KT[11] = 0x895CD7BEL;
        KT[12] = 0x6B901122L; KT[13] = 0xFD987193L; KT[14] = 0xA679438EL; KT[15] = 0x49B40821L;
        KT[16] = 0xF61E2562L; KT[17] = 0xC040B340L; KT[18] = 0x265E5A51L; KT[19] = 0xE9B6C7AAL;
        KT[20] = 0xD62F105DL; KT[21] = 0x02441453L; KT[22] = 0xD8A1E681L; KT[23] = 0xE7D3FBC8L;
        KT[24] = 0x21E1CDE6L; KT[25] = 0xC33707D6L; KT[26] = 0xF4D50D87L; KT[27] = 0x455A14EDL;
        KT[28] = 0xA9E3E905L; KT[29] = 0xFCEFA3F8L; KT[30] = 0x676F02D9L; KT[31] = 0x8D2A4C8AL;
        KT[32] = 0xFFFA3942L; KT[33] = 0x8771F681L; KT[34] = 0x6D9D6122L; KT[35] = 0xFDE5380CL;
        KT[36] = 0xA4BEEA44L; KT[37] = 0x4BDECFA9L; KT[38] = 0xF6BB4B60L; KT[39] = 0xBEBFBC70L;
        KT[40] = 0x289B7EC6L; KT[41] = 0xEAA127FAL; KT[42] = 0xD4EF3085L; KT[43] = 0x04881D05L;
        KT[44] = 0xD9D4D039L; KT[45] = 0xE6DB99E5L; KT[46] = 0x1FA27CF8L; KT[47] = 0xC4AC5665L;
        KT[48] = 0xF4292244L; KT[49] = 0x432AFF97L; KT[50] = 0xAB9423A7L; KT[51] = 0xFC93A039L;
        KT[52] = 0x655B59C3L; KT[53] = 0x8F0CCC92L; KT[54] = 0xFFEFF47DL; KT[55] = 0x85845DD1L;
        KT[56] = 0x6FA87E4FL; KT[57] = 0xFE2CE6E0L; KT[58] = 0xA3014314L; KT[59] = 0x4E0811A1L;
        KT[60] = 0xF7537E82L; KT[61] = 0xBD3AF235L; KT[62] = 0x2AD7D2BBL; KT[63] = 0xEB86D391L;
        int[] ST = new int[64];
        ST[0] = 7; ST[1] = 12; ST[2] = 17; ST[3] = 22; ST[4] = 7; ST[5] = 12; ST[6] = 17; ST[7] = 22;
        ST[8] = 7; ST[9] = 12; ST[10] = 17; ST[11] = 22; ST[12] = 7; ST[13] = 12; ST[14] = 17; ST[15] = 22;
        ST[16] = 5; ST[17] = 9; ST[18] = 14; ST[19] = 20; ST[20] = 5; ST[21] = 9; ST[22] = 14; ST[23] = 20;
        ST[24] = 5; ST[25] = 9; ST[26] = 14; ST[27] = 20; ST[28] = 5; ST[29] = 9; ST[30] = 14; ST[31] = 20;
        ST[32] = 4; ST[33] = 11; ST[34] = 16; ST[35] = 23; ST[36] = 4; ST[37] = 11; ST[38] = 16; ST[39] = 23;
        ST[40] = 4; ST[41] = 11; ST[42] = 16; ST[43] = 23; ST[44] = 4; ST[45] = 11; ST[46] = 16; ST[47] = 23;
        ST[48] = 6; ST[49] = 10; ST[50] = 15; ST[51] = 21; ST[52] = 6; ST[53] = 10; ST[54] = 15; ST[55] = 21;
        ST[56] = 6; ST[57] = 10; ST[58] = 15; ST[59] = 21; ST[60] = 6; ST[61] = 10; ST[62] = 15; ST[63] = 21;
        LoadImm(9, 384);
        AddRR(9, 31, 9);
        int iK = 0;
        while (iK < 64) {
            LoadImm(11, KT[iK]);
            StrU(11, 9, 8 * iK);
            iK = iK + 1;
        }
        LoadImm(9, 896);
        AddRR(9, 31, 9);
        int iS = 0;
        while (iS < 64) {
            LoadImm(11, ST[iS]);
            StrU(11, 9, 8 * iS);
            iS = iS + 1;
        }
        HostLoad(9, 1);
        LsrImm(10, 9, 6);
        HostSave(10, 13);
        LslImm(11, 10, 6);
        StringSub(11, 9, 11);
        HostSave(11, 14);
        LoadImm(12, 56);
        HostLoad(11, 14);
        StringCmp(11, 12);
        int sTwo = NL(); int sTwoDone = NL();
        EmitBcond(10, sTwo);
        LoadImm(12, 1);
        EmitB(sTwoDone);
        Mark(sTwo);
        LoadImm(12, 2);
        Mark(sTwoDone);
        HostSave(12, 15);
        HostLoad(10, 13);
        HostLoad(11, 15);
        AddRR(10, 10, 11);
        HostSave(10, 12);
        HostLoad(10, 0);
        HostSave(10, 11);
        LoadImm(10, 0);
        HostSave(10, 15);
        int bLoop = NL(); int bDone = NL(); int bNext = NL();
        int bTail = NL(); int bTail2 = NL();
        Mark(bLoop);
        HostLoad(10, 15);                       // b
        HostLoad(11, 12);                       // total
        StringCmp(10, 11);
        EmitBcond(10, bDone);                   // b >= total -> finish
        HostLoad(10, 15);
        HostLoad(11, 13);                       // nb_full
        StringCmp(10, 11);
        EmitBcond(10, bTail);                   // b >= nb_full -> tail
        // full block: memcpy(块=sp+256, data + b*64, 64)——dst 在前
        // (批 35:首版 src/dst 颠倒且块压在面槽 0..127 上,尾合成把
        // data/len/md/状态槽一起清零——垃圾摘要 + 堆损坏的根源)
        AddImm(0, 31, 256);                     // v0 = dst = 块缓冲
        LslImm(9, 10, 6);                       // b*64
        HostLoad(10, 11);                       // data
        AddRR(1, 10, 9);                        // v1 = src
        LoadImm(2, 64);
        BLExtern("_memcpy");
        EmitB(bNext);
        Mark(bTail);
        // 尾块合成(批 35:结构对齐已验证的 sha256;md5 长度小端,
        // 移位恒 8i——首版 AddRR 把 bitlen 加进移位量)
        HostLoad(11, 14);                       // rem
        LoadImm(12, 56);
        StringCmp(11, 12);
        EmitBcond(10, bTail2);                  // rem >= 56 -> 两块尾(cond 10=GE;首版 12=GT 把 rem==56 漏进单尾,bitlen 覆写 0x80 —— 批 35)
        // 单尾块:零化 128B @sp+256,拷 rem,0x80,bitlen 小端在 +56
        AddImm(0, 31, 256);                     // v0 = 块缓冲基址
        LoadImm(9, 0);
        int mz = NL(); int mzEnd = NL();
        Mark(mz);
        LoadImm(10, 128);
        StringCmp(9, 10);
        EmitBcond(10, mzEnd);
        AddRR(10, 9, 0);                        // addr = 块 + off
        LoadImm(11, 0);
        StrU(11, 10, 0);
        AddImm(9, 9, 8);
        EmitB(mz);
        Mark(mzEnd);
        HostLoad(10, 15);                       // b (== nb_full)
        AddImm(1, 31, 256);                     // v1 = src(dst 已在 v0)
        LslImm(9, 10, 6);
        HostLoad(10, 11);
        AddRR(1, 10, 9);                        // v1 = src = data + b*64
        HostLoad(2, 14);                        // rem
        BLExtern("_memcpy");
        AddImm(0, 31, 256);                     // v0 = 块(拷贝后重取)
        HostLoad(1, 14);
        MovRR(2, 1);
        AddRR(0, 0, 2);                         // 块 + rem
        LoadImm(1, 0x80);
        StoreB(1, 0, 0);                        // block[rem] = 0x80
        // bitlen 小端 8 字节:block[56+i] = (bitlen >> 8i) & 0xFF
        HostLoad(9, 1);
        LslImm(9, 9, 3);                        // v9 = bitlen
        AddImm(0, 31, 256);
        LoadImm(10, 0);                         // i
        int bw = NL(); int bwEnd = NL();
        Mark(bw);
        LoadImm(11, 8);
        StringCmp(10, 11);
        EmitBcond(10, bwEnd);                   // i >= 8
        LslImm(11, 10, 3);                      // 8i(小端:低位在前)
        LsrvVV(12, 9, 11);                      // bitlen >> 8i
        Uxtw32(12, 12);
        LoadImm(11, 56);
        AddRR(11, 11, 10);                      // 56 + i
        AddRR(11, 11, 0);                       // + 块
        StoreB(12, 11, 0);
        AddImm(10, 10, 1);
        EmitB(bw);
        Mark(bwEnd);
        EmitB(bNext);
        Mark(bTail2);
        // 两块尾的第 1 块:数据 + 0x80;bitlen 骑第 2 块 +120(第 2 趟
        // bTail2 重拷 rem/0x80 落在第 1 块旧区,已被消费,无害)
        AddImm(0, 31, 256);                     // v0 = 块缓冲基址
        LoadImm(9, 0);
        int mz2 = NL(); int mz2End = NL();
        Mark(mz2);
        LoadImm(10, 128);
        StringCmp(9, 10);
        EmitBcond(10, mz2End);
        AddRR(10, 9, 0);
        LoadImm(11, 0);
        StrU(11, 10, 0);
        AddImm(9, 9, 8);
        EmitB(mz2);
        Mark(mz2End);
        HostLoad(10, 15);
        AddImm(1, 31, 256);                     // v1 = src(dst 已在 v0)
        LslImm(9, 10, 6);
        HostLoad(10, 11);
        AddRR(1, 10, 9);                        // v1 = src
        HostLoad(2, 14);
        BLExtern("_memcpy");
        AddImm(0, 31, 256);
        HostLoad(1, 14);
        MovRR(2, 1);
        AddRR(0, 0, 2);
        LoadImm(1, 0x80);
        StoreB(1, 0, 0);
        // bitlen 小端 8 字节:block[120+i] = (bitlen >> 8i) & 0xFF
        HostLoad(9, 1);
        LslImm(9, 9, 3);
        AddImm(0, 31, 256);
        LoadImm(10, 0);
        int bw2 = NL(); int bw2End = NL();
        Mark(bw2);
        LoadImm(11, 8);
        StringCmp(10, 11);
        EmitBcond(10, bw2End);
        LslImm(11, 10, 3);
        LsrvVV(12, 9, 11);
        Uxtw32(12, 12);
        LoadImm(11, 120);
        AddRR(11, 11, 10);
        AddRR(11, 11, 0);
        StoreB(12, 11, 0);
        AddImm(10, 10, 1);
        EmitB(bw2);
        Mark(bw2End);
        Mark(bNext);
        // M[0..15] = 块的 LE32 字(第二尾块 +64)
        HostLoad(10, 15);
        HostLoad(11, 13);
        StringCmp(10, 11);
        int wOff = NL(); int wOffDone = NL();
        EmitBcond(12, wOff);                    // b > nb_full -> 第二尾块
        LoadImm(12, 0);
        EmitB(wOffDone);
        Mark(wOff);
        LoadImm(12, 64);
        Mark(wOffDone);
        AddImm(9, 31, 256);      // 批 35:块基 sp+256(首版 0 读进面槽区)
        AddRR(9, 9, 12);
        LoadImm(10, 0);
        int wLoop = NL(); int wDone = NL();
        Mark(wLoop);
        LoadImm(11, 16);
        StringCmp(10, 11);
        EmitBcond(10, wDone);
        LoadB(11, 9, 0);
        LoadB(12, 9, 1);
        LslImm(12, 12, 8);
        OrrRR(11, 11, 12);
        LoadB(12, 9, 2);
        LslImm(12, 12, 16);
        OrrRR(11, 11, 12);
        LoadB(12, 9, 3);
        LslImm(12, 12, 24);
        OrrRR(11, 11, 12);
        Uxtw32(11, 11);
        LslImm(13, 10, 3);
        AddImm(13, 13, 128);
        AddRR(13, 31, 13);
        StrU(11, 13, 0);
        AddImm(9, 9, 4);
        AddImm(10, 10, 1);
        EmitB(wLoop);
        Mark(wDone);
        // A..D <- 状态(v19..v22)
        HostLoad(19, 3); HostLoad(20, 4); HostLoad(21, 5); HostLoad(22, 6);
        // 64 轮
        LoadImm(15, 0);
        int rLoop = NL(); int rDone = NL();
        int r16 = NL(); int r32 = NL(); int r48 = NL(); int fDone = NL();
        Mark(rLoop);
        LoadImm(10, 64);
        StringCmp(15, 10);
        EmitBcond(10, rDone);
        ExtCmpImm(15, 16);
        EmitBcond(11, r16);
        ExtCmpImm(15, 32);
        EmitBcond(11, r32);
        ExtCmpImm(15, 48);
        EmitBcond(11, r48);
        // 48..63: g = (7t)&15; F = C ^ (B | ~D)
        LoadImm(6, 7);
        MaddRR(25, 15, 6, 31);
        LoadImm(7, 15);
        AndRR(25, 25, 7);
        NotL32(6, 22);
        OrrRR(6, 20, 6);
        XorRR(28, 21, 6);
        EmitB(fDone);
        Mark(r48);
        // 32..47: g = (3t+5)&15; F = B^C^D
        LoadImm(6, 3);
        LoadImm(7, 5);
        MaddRR(25, 15, 6, 7);
        LoadImm(7, 15);
        AndRR(25, 25, 7);
        XorRR(28, 20, 21);
        XorRR(28, 28, 22);
        EmitB(fDone);
        Mark(r32);
        // 16..31: g = (5t+1)&15; F = (D&B)|(~D&C)
        LoadImm(6, 5);
        LoadImm(7, 1);
        MaddRR(25, 15, 6, 7);
        LoadImm(7, 15);
        AndRR(25, 25, 7);
        AndRR(28, 22, 20);
        NotL32(6, 22);
        AndRR(6, 6, 21);
        OrrRR(28, 28, 6);
        EmitB(fDone);
        Mark(r16);
        // 0..15: g = t; F = (B&C)|(~B&D)
        MovRR(25, 15);
        AndRR(28, 20, 21);
        NotL32(6, 20);
        AndRR(6, 6, 22);
        OrrRR(28, 28, 6);
        Mark(fDone);
        // v27 = A + F + K[t] + M[g]
        AddRR(27, 19, 28);
        LslImm(6, 15, 3);
        AddImm(6, 6, 384);
        AddRR(6, 31, 6);
        LdrU(6, 6, 0);
        AddRR(27, 27, 6);
        LslImm(24, 25, 3);
        AddImm(24, 24, 128);
        AddRR(24, 31, 24);
        LdrU(24, 24, 0);
        AddRR(27, 27, 24);
        Uxtw32(27, 27);
        // rol32(v27, SH[t])
        LslImm(6, 15, 3);
        AddImm(6, 6, 896);
        AddRR(6, 31, 6);
        LdrU(6, 6, 0);
        RorL32Var(27, 27, 6);
        AddRR(27, 27, 20);
        Uxtw32(27, 27);
        // 角色轮转:A'=D B'=v27 C'=B D'=C
        MovRR(24, 22);
        MovRR(22, 21);
        MovRR(21, 20);
        MovRR(19, 24);
        MovRR(20, 27);
        AddImm(15, 15, 1);
        EmitB(rLoop);
        Mark(rDone);
        // 折叠
        HostLoad(6, 3); AddRR(6, 6, 19); Uxtw32(6, 6); HostSave(6, 3);
        HostLoad(6, 4); AddRR(6, 6, 20); Uxtw32(6, 6); HostSave(6, 4);
        HostLoad(6, 5); AddRR(6, 6, 21); Uxtw32(6, 6); HostSave(6, 5);
        HostLoad(6, 6); AddRR(6, 6, 22); Uxtw32(6, 6); HostSave(6, 6);
        HostLoad(10, 15);                       // b
        AddImm(10, 10, 1);
        HostSave(10, 15);
        EmitB(bLoop);
        Mark(bDone);
        // out:16 字节小端
        HostLoad(0, 2);
        int w9 = 0;
        while (w9 < 4) {
            HostLoad(9, 3 + w9);
            int j9 = 0;
            while (j9 < 4) {
                LsrImm(10, 9, 8 * j9);
                Uxtw32(10, 10);
                MovRR(11, 0);
                AddImm(11, 11, 4 * w9 + j9);
                StoreB(10, 11, 0);
                j9 = j9 + 1;
            }
            w9 = w9 + 1;
        }
        HostEnd();
    }

}
