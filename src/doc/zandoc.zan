using System;

namespace Doc;

/// One documented declaration: a type, or a method inside the type that
/// precedes it.
class DocMember {
    string name;
    string signature;
    string summary;
    string returns;
    /// "class", "struct", "enum", "interface" or "method".
    string kind;

    static DocMember Create(string kind, string name) {
        DocMember m = new DocMember();
        m.kind = kind;
        m.name = name;
        m.signature = "";
        m.summary = "";
        m.returns = "";
        return m;
    }

    bool IsType() { return this.kind != "method"; }
}

/// The Zan documentation generator: extracts `/// <summary>` and
/// `/// <returns>` comments plus the declarations they precede, and renders
/// them as Markdown or HTML.
///
///   zandoc <file.zan>                    Markdown to stdout
///   zandoc <file.zan> --html [-o out]    HTML
///   zandoc <file.zan> --md [-o out]      Markdown
///
/// The parse is deliberately line-based rather than a real parse: a
/// declaration is a line with a `(` in it (a method) or one starting with
/// class/struct/enum/interface, so the tool never has to track the language.
class Program {
    static bool IsAlnum(string ch) {
        return (ch >= "0" && ch <= "9") || (ch >= "a" && ch <= "z")
            || (ch >= "A" && ch <= "Z");
    }

    static string TrimLeft(string s) {
        int i = 0;
        while (i < s.Length) {
            string ch = s.Substring(i, 1);
            if (ch != " " && ch != "\t") { break; }
            i = i + 1;
        }
        return s.Substring(i, s.Length - i);
    }

    static string TrimRight(string s) {
        int n = s.Length;
        while (n > 0) {
            string ch = s.Substring(n - 1, 1);
            if (ch != " " && ch != "\t" && ch != "\r") { break; }
            n = n - 1;
        }
        return s.Substring(0, n);
    }

    /// The text between `<tag>` and `</tag>`, or "" when the line has no
    /// opening tag. A missing closing tag takes the rest of the line.
    static string ExtractTag(string line, string tag) {
        string open = $"<{tag}>";
        string close = $"</{tag}>";
        int start = line.IndexOf(open);
        if (start < 0) { return ""; }
        start = start + open.Length;
        string rest = line.Substring(start, line.Length - start);
        int end = rest.IndexOf(close);
        if (end < 0) { return rest; }
        return rest.Substring(0, end);
    }

    /// Strips one leading access modifier, then a leading `static`.
    static string StripModifiers(string decl) {
        List<string> mods = new List<string>();
        mods.Add("public ");
        mods.Add("private ");
        mods.Add("protected ");
        mods.Add("internal ");
        int i = 0;
        while (i < mods.Count) {
            string mod = mods[i];
            i = i + 1;
            if (decl.StartsWith(mod)) {
                decl = decl.Substring(mod.Length, decl.Length - mod.Length);
                break;
            }
        }
        if (decl.StartsWith("static ")) {
            decl = decl.Substring(7, decl.Length - 7);
        }
        return decl;
    }

    /// The declared name: everything up to the first space, `{`, `:` or `<`.
    static string TypeName(string decl) {
        int i = 0;
        while (i < decl.Length) {
            string ch = decl.Substring(i, 1);
            if (ch == " " || ch == "{" || ch == ":" || ch == "<") { break; }
            i = i + 1;
        }
        return decl.Substring(0, i);
    }

    /// The identifier immediately before the first `(`.
    static string MethodName(string decl) {
        int paren = decl.IndexOf("(");
        if (paren <= 0) { return ""; }
        int last = paren - 1;
        while (last > 0 && decl.Substring(last, 1) == " ") { last = last - 1; }
        int first = last;
        while (first > 0 && Program.IsAlnum(decl.Substring(first - 1, 1))) {
            first = first - 1;
        }
        return decl.Substring(first, last + 1 - first);
    }

    static string TypeKeyword(string decl) {
        if (decl.StartsWith("class ")) { return "class"; }
        if (decl.StartsWith("struct ")) { return "struct"; }
        if (decl.StartsWith("enum ")) { return "enum"; }
        if (decl.StartsWith("interface ")) { return "interface"; }
        return "";
    }

    static string Namespace(string src) {
        List<string> lines = src.Split("\n");
        int i = 0;
        while (i < lines.Count) {
            string line = Program.TrimLeft(lines[i]);
            i = i + 1;
            if (!line.StartsWith("namespace ")) { continue; }
            string ns = Program.TrimLeft(line.Substring(10, line.Length - 10));
            int end = ns.IndexOf(";");
            if (end >= 0) { ns = ns.Substring(0, end); }
            return Program.TrimRight(ns);
        }
        return "";
    }

    static List<DocMember> Parse(string src) {
        List<DocMember> members = new List<DocMember>();
        List<string> lines = src.Split("\n");
        string summary = "";
        string returns = "";
        int i = 0;
        while (i < lines.Count) {
            string line = Program.TrimLeft(Program.TrimRight(lines[i]));
            i = i + 1;
            if (line.StartsWith("namespace ")) { continue; }

            if (line.StartsWith("///")) {
                string comment = Program.TrimLeft(line.Substring(3, line.Length - 3));
                string s = Program.ExtractTag(comment, "summary");
                if (s != "") { summary = s; }
                string r = Program.ExtractTag(comment, "returns");
                if (r != "") { returns = r; }
                continue;
            }

            string decl = Program.StripModifiers(line);
            string keyword = Program.TypeKeyword(decl);
            if (keyword != "") {
                string body = decl.Substring(keyword.Length + 1,
                                             decl.Length - keyword.Length - 1);
                DocMember m = DocMember.Create(keyword, Program.TypeName(body));
                m.summary = summary;
                members.Add(m);
                summary = "";
                returns = "";
                continue;
            }

            if (decl.IndexOf("(") < 0) { continue; }
            DocMember mm = DocMember.Create("method", Program.MethodName(decl));
            mm.signature = Program.TrimRight(Program.TrimTrailingBrace(decl));
            mm.summary = summary;
            mm.returns = returns;
            members.Add(mm);
            summary = "";
            returns = "";
        }
        return members;
    }

    static string TrimTrailingBrace(string decl) {
        int n = decl.Length;
        while (n > 0) {
            string ch = decl.Substring(n - 1, 1);
            if (ch != "{" && ch != " ") { break; }
            n = n - 1;
        }
        return decl.Substring(0, n);
    }

    static string Markdown(string ns, List<DocMember> members) {
        StringBuilder res = new StringBuilder();
        if (ns != "") { res.Append($"# Namespace: {ns}\n\n"); }
        int i = 0;
        while (i < members.Count) {
            DocMember m = members[i];
            i = i + 1;
            if (!m.IsType()) { continue; }
            res.Append($"## {m.kind} {m.name}\n\n");
            if (m.summary != "") { res.Append($"{m.summary}\n\n"); }
            res.Append("### Methods\n\n");
            int j = i;
            while (j < members.Count) {
                DocMember mm = members[j];
                j = j + 1;
                if (mm.IsType()) { break; }
                res.Append($"#### `{mm.signature}`\n\n");
                if (mm.summary != "") { res.Append($"{mm.summary}\n\n"); }
                if (mm.returns != "") { res.Append($"**Returns:** {mm.returns}\n\n"); }
            }
            res.Append("---\n\n");
        }
        return res.ToString();
    }

    static string Html(string ns, List<DocMember> members) {
        StringBuilder res = new StringBuilder();
        string title = ns;
        if (title == "") { title = "Zan"; }
        res.Append("<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"utf-8\">\n");
        res.Append($"<title>{title} - Zan API Documentation</title>\n");
        res.Append("<style>\n");
        res.Append("body { font-family: 'Segoe UI', sans-serif; max-width: 900px; margin: 0 auto; padding: 20px; background: #1e1e2e; color: #cdd6f4; }\n");
        res.Append("h1 { color: #89b4fa; border-bottom: 2px solid #313244; padding-bottom: 10px; }\n");
        res.Append("h2 { color: #a6e3a1; margin-top: 30px; }\n");
        res.Append("h3 { color: #f9e2af; }\n");
        res.Append("code { background: #313244; padding: 2px 6px; border-radius: 4px; font-size: 0.9em; }\n");
        res.Append("pre { background: #313244; padding: 12px; border-radius: 8px; overflow-x: auto; }\n");
        res.Append(".method { margin: 15px 0; padding: 10px; background: #181825; border-left: 3px solid #89b4fa; border-radius: 4px; }\n");
        res.Append(".summary { color: #a6adc8; margin: 5px 0; }\n");
        res.Append("</style>\n</head>\n<body>\n");
        if (ns != "") { res.Append($"<h1>{ns}</h1>\n"); }

        int i = 0;
        while (i < members.Count) {
            DocMember m = members[i];
            i = i + 1;
            if (!m.IsType()) { continue; }
            res.Append($"<h2>{m.kind} {m.name}</h2>\n");
            if (m.summary != "") { res.Append($"<p class=\"summary\">{m.summary}</p>\n"); }
            res.Append("<h3>Methods</h3>\n");
            int j = i;
            while (j < members.Count) {
                DocMember mm = members[j];
                j = j + 1;
                if (mm.IsType()) { break; }
                res.Append("<div class=\"method\">\n");
                res.Append($"  <code>{mm.signature}</code>\n");
                if (mm.summary != "") { res.Append($"  <p class=\"summary\">{mm.summary}</p>\n"); }
                if (mm.returns != "") { res.Append($"  <p><strong>Returns:</strong> {mm.returns}</p>\n"); }
                res.Append("</div>\n");
            }
            res.Append("<hr>\n");
        }
        res.Append("</body>\n</html>\n");
        return res.ToString();
    }

    static void PrintUsage() {
        Console.WriteLine("Zan Documentation Generator (zandoc)");
        Console.WriteLine("");
        Console.WriteLine("Usage:");
        Console.WriteLine("  zandoc <file.zan>                       Generate markdown docs");
        Console.WriteLine("  zandoc <file.zan> --html [-o out.html]  Generate HTML docs");
        Console.WriteLine("  zandoc <file.zan> --md [-o out.md]      Generate markdown docs");
        Console.WriteLine("  zandoc --help                           Show this help");
    }

    static int Main() {
        if (Environment.ArgCount() == 0) {
            Program.PrintUsage();
            return 0;
        }

        bool html = false;
        string path = "";
        string outPath = "";
        int i = 0;
        while (i < Environment.ArgCount()) {
            string arg = Environment.ArgAt(i);
            i = i + 1;
            if (arg == "--html") { html = true; }
            else if (arg == "--md") { html = false; }
            else if (arg == "-o" && i < Environment.ArgCount()) {
                outPath = Environment.ArgAt(i);
                i = i + 1;
            }
            else if (arg == "--help" || arg == "-h") {
                Program.PrintUsage();
                return 0;
            }
            else { path = arg; }
        }

        if (path == "") {
            Console.WriteLine("error: no file specified");
            return 1;
        }
        if (!File.Exists(path)) {
            Console.WriteLine($"error: cannot read '{path}'");
            return 1;
        }

        string src = File.ReadAllText(path);
        string ns = Program.Namespace(src);
        List<DocMember> members = Program.Parse(src);
        string text = "";
        if (html) { text = Program.Html(ns, members); }
        else { text = Program.Markdown(ns, members); }

        if (outPath == "") {
            Console.Write(text);
            return 0;
        }
        File.WriteAllText(outPath, text);
        Console.WriteLine($"Generated: {outPath}");
        return 0;
    }
}
