using System;

namespace Doc;

// precedes it.
public class ZanDoc {
    static bool IsAlnumByte(int c) {
        return (c >= 48 && c <= 57) || (c >= 97 && c <= 122)
            || (c >= 65 && c <= 90);
    }

    static string TrimLeft(string s) {
        int i = 0;
        while (i < s.Length) {
            int ch = s[i] & 255;
            if (ch != 32 && ch != 9) { break; }
            i = i + 1;
        }
        if (i == 0) { return s; }
        return s.Substring(i, s.Length - i);
    }

    static string TrimRight(string s) {
        int n = s.Length;
        while (n > 0) {
            int ch = s[n - 1] & 255;
            if (ch != 32 && ch != 9 && ch != 13) { break; }
            n = n - 1;
        }
        if (n == s.Length) { return s; }
        return s.Substring(0, n);
    }

    // 从一行文档注释里取 `<tag>值</tag>`。单行内含闭合标签时直接返回；
    // 只有开标签（`<summary>` 换行，值在后续行）时返回空串，由 Parse 的
    // 块累积逻辑接管。
    static string ExtractTag(string line, string tag) {
        string open = $"<{tag}>";
        string close = $"</{tag}>";
        int start = line.IndexOf(open);
        if (start < 0) { return ""; }
        start = start + open.Length;
        string rest = line.Substring(start, line.Length - start);
        int end = rest.IndexOf(close);
        if (end < 0) { return rest; }
        return rest.Substring(0, end);
    }

    static string StripModifiers(string decl) {
        List<string> mods = new List<string>();
        mods.Add("public ");
        mods.Add("private ");
        mods.Add("protected ");
        mods.Add("internal ");
        int i = 0;
        while (i < mods.Count) {
            string mod = mods[i];
            i = i + 1;
            if (decl.StartsWith(mod)) {
                decl = decl.Substring(mod.Length, decl.Length - mod.Length);
                break;
            }
        }
        if (decl.StartsWith("static ")) {
            decl = decl.Substring(7, decl.Length - 7);
        }
        return decl;
    }

    static string TypeName(string decl) {
        int i = 0;
        while (i < decl.Length) {
            int ch = decl[i] & 255;
            if (ch == 32 || ch == 123 || ch == 58 || ch == 60) { break; }
            i = i + 1;
        }
        return decl.Substring(0, i);
    }

    static string MethodName(string decl) {
        int paren = decl.IndexOf("(");
        if (paren <= 0) { return ""; }
        int last = paren - 1;
        while (last > 0 && (decl[last] & 255) == 32) { last = last - 1; }
        int first = last;
        while (first > 0 && ZanDoc.IsAlnumByte(decl[first - 1] & 255)) {
            first = first - 1;
        }
        return decl.Substring(first, last + 1 - first);
    }

    // 去掉行尾 `//` 注释与块注释，保留字符串/字符字面量原样。
    // 成员判定必须看**声明本身**：`public int week; // 1-5 (5 = 最后一周)`
    // 里的括号属于注释，不该让这一行变成方法签名。
    static string StripComments(string line) {
        if (line == null || line.Length == 0) { return ""; }
        int n = line.Length;
        StringBuilder sb = null;
        int segStart = 0;
        int i = 0;
        while (i < n) {
            int ch = line[i] & 255;
            if (ch == 34 || ch == 39) {
                i = i + 1;
                while (i < n) {
                    int c = line[i] & 255;
                    if (c == 92) { i = i + 2; continue; }
                    if (c == ch) { i = i + 1; break; }
                    i = i + 1;
                }
                continue;
            }
            if (ch == 47 && i + 1 < n) {
                int next = line[i + 1] & 255;
                if (next == 47) {
                    if (sb == null) { return line.Substring(0, i); }
                    if (i > segStart) { sb.Append(line.Substring(segStart, i - segStart)); }
                    return sb.ToString();
                }
                if (next == 42) {
                    if (sb == null) { sb = new StringBuilder(); }
                    if (i > segStart) { sb.Append(line.Substring(segStart, i - segStart)); }
                    int close = line.IndexOf("*/", i + 2);
                    if (close < 0) {
                        return sb.ToString();
                    }
                    sb.Append(" ");
                    i = close + 2;
                    segStart = i;
                    continue;
                }
            }
            i = i + 1;
        }
        if (sb == null) { return line; }
        if (segStart < n) { sb.Append(line.Substring(segStart, n - segStart)); }
        return sb.ToString();
    }

    // 统计一行（已剥注释）中小括号净增量（跳过字符串/字符字面量）。
    static int ParenDelta(string line) {
        if (line == null) { return 0; }
        int delta = 0;
        int i = 0;
        int n = line.Length;
        while (i < n) {
            int ch = line[i] & 255;
            if (ch == 34 || ch == 39) {
                i = i + 1;
                while (i < n) {
                    int c = line[i] & 255;
                    if (c == 92) { i = i + 2; continue; }
                    if (c == ch) { i = i + 1; break; }
                    i = i + 1;
                }
                continue;
            }
            if (ch == 40) { delta = delta + 1; }
            else if (ch == 41) { delta = delta - 1; }
            i = i + 1;
        }
        return delta;
    }

    // `(` 多于 `)`：声明跨行（`static List<string> listSingle(` 后跟参数行）。
    // 只数声明面的括号——调用点已先剥注释。
    static bool UnbalancedParens(string line) {
        return ZanDoc.ParenDelta(line) > 0;
    }

    // 花括号净增量。字符串与字符字面量里的花括号不算结构（`"{ }"`），
    // 行注释与块注释里的也不算——否则一个字面量就能把深度推歪，
    // 后面所有成员判定跟着错位。
    static int BraceDelta(string line) {
        int delta = 0;
        int i = 0;
        while (i < line.Length) {
            int ch = line[i] & 255;
            if (ch == 47 && i + 1 < line.Length) {
                int next = line[i + 1] & 255;
                if (next == 47) { break; }
                if (next == 42) {
                    int close = line.IndexOf("*/", i + 2);
                    if (close < 0) { break; }
                    i = close + 2;
                    continue;
                }
            }
            if (ch == 34 || ch == 39) {
                i = i + 1;
                while (i < line.Length) {
                    int c = line[i] & 255;
                    if (c == 92) { i = i + 2; continue; }
                    if (c == ch) { break; }
                    i = i + 1;
                }
                i = i + 1;
                continue;
            }
            if (ch == 123) { delta = delta + 1; }
            else if (ch == 125) { delta = delta - 1; }
            i = i + 1;
        }
        return delta;
    }

    // 签名头判定：`(` 之前是标识符、无 `=`、非特性。跨行累积只对这种行做。
    static bool SignatureHead(string line) {
        if (line.StartsWith("[")) { return false; }
        int open = line.IndexOf("(");
        if (open <= 0) { return false; }
        int eq = line.IndexOf("=");
        if (eq >= 0 && eq < open) { return false; }
        return true;
    }

    // 声明形态守卫：`(参数)` 后面必须紧跟可选的 `{` / `:` / `;` / `where` /
    // 行尾，才可能是签名。`;` 结尾是接口/抽象方法声明（`void Draw();`）。
    // 三类排除：`[` 开头是特性行（`[DllImport(...)]`，不是成员）；`=` 出现在
    // `(` 之前是带初始化的字段（`= new AtomicInt(...)`、`= Mutex.Create()`），
    // 默认参数值的 `=` 在 `(` 之后不受影响；其余形态一律不收。
    static bool LooksLikeSignature(string decl) {
        if (decl.StartsWith("[")) { return false; }
        int open = decl.IndexOf("(");
        if (open <= 0) { return false; }
        int eq = decl.IndexOf("=");
        if (eq >= 0 && eq < open) { return false; }
        int close = decl.LastIndexOf(")");
        if (close < open) { return false; }
        string tail = ZanDoc.TrimLeft(decl.Substring(close + 1, decl.Length - close - 1));
        if (tail == "") { return true; }
        if (tail.StartsWith("{")) { return true; }
        if (tail.StartsWith(":")) { return true; }
        if (tail.StartsWith(";")) { return true; }
        if (tail.StartsWith("where ")) { return true; }
        return false;
    }

    static string TypeKeyword(string decl) {
        if (decl.StartsWith("class ")) { return "class"; }
        if (decl.StartsWith("struct ")) { return "struct"; }
        if (decl.StartsWith("enum ")) { return "enum"; }
        if (decl.StartsWith("interface ")) { return "interface"; }
        return "";
    }

    static string Namespace(string src) {
        List<string> lines = src.Split("\n");
        int i = 0;
        while (i < lines.Count) {
            string line = ZanDoc.TrimLeft(lines[i]);
            i = i + 1;
            if (!line.StartsWith("namespace ")) { continue; }
            string ns = ZanDoc.TrimLeft(line.Substring(10, line.Length - 10));
            int end = ns.IndexOf(";");
            if (end >= 0) { ns = ns.Substring(0, end); }
            return ZanDoc.TrimRight(ns);
        }
        return "";
    }

    // HTML 文本转义，防止类型/签名/文档注释中的 < > & " ' 注入 XSS。
    static string HtmlEscape(string s) {
        if (s == null || s.Length == 0) { return ""; }
        int n = s.Length;
        bool needs = false;
        for (int i = 0; i < n; i = i + 1) {
            int c = s[i] & 255;
            if (c == 38 || c == 60 || c == 62 || c == 34 || c == 39) {
                needs = true;
                break;
            }
        }
        if (!needs) { return s; }
        StringBuilder sb = new StringBuilder();
        int segStart = 0;
        for (int i = 0; i < n; i = i + 1) {
            int c = s[i] & 255;
            string esc = null;
            if (c == 38) { esc = "&amp;"; }
            else if (c == 60) { esc = "&lt;"; }
            else if (c == 62) { esc = "&gt;"; }
            else if (c == 34) { esc = "&quot;"; }
            else if (c == 39) { esc = "&#39;"; }
            if (esc != null) {
                if (i > segStart) { sb.Append(s.Substring(segStart, i - segStart)); }
                sb.Append(esc);
                segStart = i + 1;
            }
        }
        if (segStart < n) { sb.Append(s.Substring(segStart, n - segStart)); }
        return sb.ToString();
    }

    // Markdown 行内代码围栏：若签名内含反引号，改用双反引号并加空格包裹。
    static string MdCodeSpan(string s) {
        if (s == null || s.Length == 0) { return "``"; }
        if (s.IndexOf("`") < 0) { return "`" + s + "`"; }
        return "`` " + s.Replace("`", "'") + " ``";
    }

    // 解析出类型与方法成员。
    //
    // 只把**类型体的第 1 层**当作成员声明面：`depth` 在进入类型体后为 1，
    // 方法体内部是 2 及更深。早先的实现是纯行扫描——任何含 `(` 的行都算方法，
    // 且不看深度——于是真实输入上大面积误报：字段行内注释里的括号
    // （`int week; // 1-5 (5 = 最后一周)`）、带初始化的字段
    // （`= new AtomicInt(...)`）、方法体里的语句（`if (s == null) { ... }`）
    // 全被当成方法。抽查 60 个 stdlib 文件，2520 条方法条目里 828 条是误报。
    static List<DocMember> Parse(string src) {
        List<DocMember> members = new List<DocMember>();
        if (src == null || src.Length == 0) { return members; }
        List<string> lines = src.Split("\n");
        StringBuilder summarySb = new StringBuilder();
        StringBuilder returnsSb = new StringBuilder();
        int inSummary = 0;
        int inReturns = 0;
        bool inBlockComment = false;
        int depth = 0;
        int i = 0;
        while (i < lines.Count) {
            string raw = ZanDoc.TrimLeft(ZanDoc.TrimRight(lines[i]));
            i = i + 1;
            if (inBlockComment) {
                int endBlk = raw.IndexOf("*/");
                if (endBlk < 0) { continue; }
                inBlockComment = false;
                raw = ZanDoc.TrimLeft(raw.Substring(endBlk + 2, raw.Length - endBlk - 2));
                if (raw.Length == 0) { continue; }
            }
            if (raw.StartsWith("namespace ")) { continue; }

            if (raw.StartsWith("///")) {
                string comment = ZanDoc.TrimLeft(raw.Substring(3, raw.Length - 3));
                // 多行块：`/// <summary>` 开、`/// </summary>` 收，中间每行追加。
                // stdlib 里的真实文档注释就是这个形态（如 TimeZoneInfo.zan）。
                if (inSummary == 1) {
                    int endIdx = comment.IndexOf("</summary>");
                    string piece = comment;
                    if (endIdx >= 0) { piece = comment.Substring(0, endIdx); }
                    piece = ZanDoc.TrimRight(piece);
                    if (piece != "") {
                        if (summarySb.Length > 0) { summarySb.Append(" "); }
                        summarySb.Append(piece);
                    }
                    if (endIdx >= 0) { inSummary = 0; }
                    continue;
                }
                if (inReturns == 1) {
                    int endIdx = comment.IndexOf("</returns>");
                    string piece = comment;
                    if (endIdx >= 0) { piece = comment.Substring(0, endIdx); }
                    piece = ZanDoc.TrimRight(piece);
                    if (piece != "") {
                        if (returnsSb.Length > 0) { returnsSb.Append(" "); }
                        returnsSb.Append(piece);
                    }
                    if (endIdx >= 0) { inReturns = 0; }
                    continue;
                }
                string s = ZanDoc.ExtractTag(comment, "summary");
                string r = ZanDoc.ExtractTag(comment, "returns");
                bool sumOpen = comment.IndexOf("<summary>") >= 0
                            && comment.IndexOf("</summary>") < 0;
                bool retOpen = comment.IndexOf("<returns>") >= 0
                            && comment.IndexOf("</returns>") < 0;
                if (sumOpen) {
                    inSummary = 1;
                    summarySb.Clear();
                    if (s != "") { summarySb.Append(s); }
                } else if (s != "") {
                    summarySb.Clear();
                    summarySb.Append(s);
                }
                if (retOpen) {
                    inReturns = 1;
                    returnsSb.Clear();
                    if (r != "") { returnsSb.Append(r); }
                } else if (r != "") {
                    returnsSb.Clear();
                    returnsSb.Append(r);
                }
                continue;
            }

            // 检测本行是否开启跨行块注释（在字符串与 // 注释之外出现未闭合的 /*）。
            if (ZanDoc.OpensBlockComment(raw)) {
                inBlockComment = true;
            }

            // 花括号深度只看声明面：先剥注释再数，避免注释里的括号/花括号参与。
            string line = ZanDoc.TrimRight(ZanDoc.StripComments(raw));

            bool atTypeBody = depth == 1;

            // 括号跨行的声明累积到配平再整体判定（Directory.listSingle、
            // SharedTable 的 extern 声明、Process 的 WinCreateProcess）。
            // 使用 StringBuilder + 增量括号计数 + 续行上限，避免 O(N^2) 拼接与重扫。
            if (atTypeBody && ZanDoc.SignatureHead(line)) {
                int parenBal = ZanDoc.ParenDelta(line);
                if (parenBal > 0) {
                    StringBuilder sigSb = new StringBuilder();
                    sigSb.Append(line);
                    int cont = 0;
                    while (parenBal > 0 && i < lines.Count && cont < 64) {
                        string nxtRaw = ZanDoc.TrimLeft(ZanDoc.TrimRight(lines[i]));
                        i = i + 1;
                        cont = cont + 1;
                        if (inBlockComment) {
                            int eb = nxtRaw.IndexOf("*/");
                            if (eb < 0) { continue; }
                            inBlockComment = false;
                            nxtRaw = ZanDoc.TrimLeft(nxtRaw.Substring(eb + 2, nxtRaw.Length - eb - 2));
                        }
                        if (ZanDoc.OpensBlockComment(nxtRaw)) { inBlockComment = true; }
                        string nxt = ZanDoc.TrimRight(ZanDoc.StripComments(nxtRaw));
                        if (nxt.Length > 0) {
                            sigSb.Append(" ");
                            sigSb.Append(nxt);
                            parenBal = parenBal + ZanDoc.ParenDelta(nxt);
                        }
                    }
                    line = sigSb.ToString();
                }
            }

            string decl = ZanDoc.StripModifiers(line);
            string keyword = ZanDoc.TypeKeyword(decl);
            if (keyword != "") {
                // 只有顶层类型头算成员。判定要在推进深度**之前**做：`{` 写在
                // 下一行的声明（Allman 风格）这一行净增量为 0，按深度判会把
                // 类型头整个漏掉。
                bool typeHeader = depth == 0;
                depth = depth + ZanDoc.BraceDelta(line);
                if (depth < 0) { depth = 0; }
                if (typeHeader) {
                    string body = decl.Substring(keyword.Length + 1,
                                                 decl.Length - keyword.Length - 1);
                    DocMember m = DocMember.Create(keyword, ZanDoc.TypeName(body));
                    m.summary = summarySb.ToString();
                    members.Add(m);
                    summarySb.Clear();
                    returnsSb.Clear();
                    inSummary = 0;
                    inReturns = 0;
                }
                continue;
            }

            depth = depth + ZanDoc.BraceDelta(line);
            if (depth < 0) { depth = 0; }

            if (!atTypeBody) { continue; }
            if (!ZanDoc.LooksLikeSignature(decl)) { continue; }
            DocMember mm = DocMember.Create("method", ZanDoc.MethodName(decl));
            mm.signature = ZanDoc.TrimRight(ZanDoc.TrimTrailingBrace(decl));
            mm.summary = summarySb.ToString();
            mm.returns = returnsSb.ToString();
            members.Add(mm);
            summarySb.Clear();
            returnsSb.Clear();
            inSummary = 0;
            inReturns = 0;
        }
        return members;
    }

    static bool OpensBlockComment(string line) {
        if (line == null || line.Length < 2) { return false; }
        int n = line.Length;
        int i = 0;
        while (i < n) {
            int ch = line[i] & 255;
            if (ch == 34 || ch == 39) {
                i = i + 1;
                while (i < n) {
                    int c = line[i] & 255;
                    if (c == 92) { i = i + 2; continue; }
                    if (c == ch) { i = i + 1; break; }
                    i = i + 1;
                }
                continue;
            }
            if (ch == 47 && i + 1 < n) {
                int next = line[i + 1] & 255;
                if (next == 47) { return false; }
                if (next == 42) {
                    int close = line.IndexOf("*/", i + 2);
                    if (close < 0) { return true; }
                    i = close + 2;
                    continue;
                }
            }
            i = i + 1;
        }
        return false;
    }

    static string TrimTrailingBrace(string decl) {
        int n = decl.Length;
        while (n > 0) {
            int ch = decl[n - 1] & 255;
            if (ch != 123 && ch != 32) { break; }
            n = n - 1;
        }
        if (n == decl.Length) { return decl; }
        return decl.Substring(0, n);
    }

    static string Markdown(string ns, List<DocMember> members) {
        StringBuilder res = new StringBuilder();
        string safeNs = ns != null ? ns : "";
        if (safeNs != "") { res.Append($"# Namespace: {safeNs}\n\n"); }
        if (members == null) { return res.ToString(); }
        int i = 0;
        while (i < members.Count) {
            DocMember m = members[i];
            i = i + 1;
            if (m == null || !m.IsType()) { continue; }
            res.Append($"## {m.kind} {m.name}\n\n");
            if (m.summary != null && m.summary != "") { res.Append($"{m.summary}\n\n"); }
            res.Append("### Methods\n\n");
            int j = i;
            while (j < members.Count) {
                DocMember mm = members[j];
                j = j + 1;
                if (mm == null) { continue; }
                if (mm.IsType()) { break; }
                res.Append("#### ");
                res.Append(ZanDoc.MdCodeSpan(mm.signature));
                res.Append("\n\n");
                if (mm.summary != null && mm.summary != "") { res.Append($"{mm.summary}\n\n"); }
                if (mm.returns != null && mm.returns != "") { res.Append($"**Returns:** {mm.returns}\n\n"); }
            }
            res.Append("---\n\n");
        }
        return res.ToString();
    }

    static string Html(string ns, List<DocMember> members) {
        StringBuilder res = new StringBuilder();
        string safeNs = ns != null ? ns : "";
        string title = safeNs != "" ? safeNs : "Zan";
        string escTitle = ZanDoc.HtmlEscape(title);
        string escNs = ZanDoc.HtmlEscape(safeNs);
        res.Append("<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"utf-8\">\n");
        res.Append($"<title>{escTitle} - Zan API Documentation</title>\n");
        res.Append("<style>\n");
        res.Append("body { font-family: 'Segoe UI', sans-serif; max-width: 900px; margin: 0 auto; padding: 20px; background: #1e1e2e; color: #cdd6f4; }\n");
        res.Append("h1 { color: #89b4fa; border-bottom: 2px solid #313244; padding-bottom: 10px; }\n");
        res.Append("h2 { color: #a6e3a1; margin-top: 30px; }\n");
        res.Append("h3 { color: #f9e2af; }\n");
        res.Append("code { background: #313244; padding: 2px 6px; border-radius: 4px; font-size: 0.9em; }\n");
        res.Append("pre { background: #313244; padding: 12px; border-radius: 8px; overflow-x: auto; }\n");
        res.Append(".method { margin: 15px 0; padding: 10px; background: #181825; border-left: 3px solid #89b4fa; border-radius: 4px; }\n");
        res.Append(".summary { color: #a6adc8; margin: 5px 0; }\n");
        res.Append("</style>\n</head>\n<body>\n");
        if (safeNs != "") { res.Append($"<h1>{escNs}</h1>\n"); }

        if (members != null) {
            int i = 0;
            while (i < members.Count) {
                DocMember m = members[i];
                i = i + 1;
                if (m == null || !m.IsType()) { continue; }
                string mKind = ZanDoc.HtmlEscape(m.kind);
                string mName = ZanDoc.HtmlEscape(m.name);
                res.Append($"<h2>{mKind} {mName}</h2>\n");
                if (m.summary != null && m.summary != "") {
                    string mSum = ZanDoc.HtmlEscape(m.summary);
                    res.Append($"<p class=\"summary\">{mSum}</p>\n");
                }
                res.Append("<h3>Methods</h3>\n");
                int j = i;
                while (j < members.Count) {
                    DocMember mm = members[j];
                    j = j + 1;
                    if (mm == null) { continue; }
                    if (mm.IsType()) { break; }
                    string sig = ZanDoc.HtmlEscape(mm.signature);
                    res.Append("<div class=\"method\">\n");
                    res.Append($"  <code>{sig}</code>\n");
                    if (mm.summary != null && mm.summary != "") {
                        string mmSum = ZanDoc.HtmlEscape(mm.summary);
                        res.Append($"  <p class=\"summary\">{mmSum}</p>\n");
                    }
                    if (mm.returns != null && mm.returns != "") {
                        string mmRet = ZanDoc.HtmlEscape(mm.returns);
                        res.Append($"  <p><strong>Returns:</strong> {mmRet}</p>\n");
                    }
                    res.Append("</div>\n");
                }
                res.Append("<hr>\n");
            }
        }
        res.Append("</body>\n</html>\n");
        return res.ToString();
    }

    static void PrintUsage() {
        Console.WriteLine("Zan Documentation Generator (zandoc)");
        Console.WriteLine("");
        Console.WriteLine("Usage:");
        Console.WriteLine("  zandoc <file.zan>                       Generate markdown docs");
        Console.WriteLine("  zandoc <file.zan> --html [-o out.html]  Generate HTML docs");
        Console.WriteLine("  zandoc <file.zan> --md [-o out.md]      Generate markdown docs");
        Console.WriteLine("  zandoc --help                           Show this help");
    }

    static int Main() {
        if (Environment.ArgCount() == 0) {
            ZanDoc.PrintUsage();
            return 0;
        }

        bool html = false;
        string path = "";
        string outPath = "";
        int i = 0;
        while (i < Environment.ArgCount()) {
            string arg = Environment.ArgAt(i);
            i = i + 1;
            if (arg == "--html") { html = true; }
            else if (arg == "--md") { html = false; }
            else if (arg == "-o") {
                if (i >= Environment.ArgCount()) {
                    Console.WriteLine("error: -o requires an output path");
                    return 1;
                }
                outPath = Environment.ArgAt(i);
                i = i + 1;
            }
            else if (arg == "--help" || arg == "-h") {
                ZanDoc.PrintUsage();
                return 0;
            }
            else { path = arg; }
        }

        if (path == "") {
            Console.WriteLine("error: no file specified");
            return 1;
        }
        if (!File.Exists(path)) {
            Console.WriteLine($"error: cannot read '{path}'");
            return 1;
        }

        string src = File.ReadAllText(path);
        string ns = ZanDoc.Namespace(src);
        List<DocMember> members = ZanDoc.Parse(src);
        string text = "";
        if (html) { text = ZanDoc.Html(ns, members); }
        else { text = ZanDoc.Markdown(ns, members); }

        if (outPath == "") {
            Console.Write(text);
            return 0;
        }
        File.WriteAllText(outPath, text);
        Console.WriteLine($"Generated: {outPath}");
        return 0;
    }
}
