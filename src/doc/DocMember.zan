using System;
using System.Collections.Generic;

namespace Doc;

public class DocMember {
    string name;
    string signature;
    string summary;
    string returns;
    string kind;

    static DocMember Create(string kind, string name) {
        DocMember m = new DocMember();
        m.kind = kind;
        m.name = name;
        m.signature = "";
        m.summary = "";
        m.returns = "";
        return m;
    }

    bool IsType() { return this.kind != "method"; }
}

