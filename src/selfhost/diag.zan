using System;
using System.Collections;
namespace Zan;

// 接口数据协议与执行契约。
class Diag {
    public string msg;
    public int line;
    public int col;
    public bool warn;
    public Diag(string m, int ln, int c, bool w) { msg = m; line = ln; col = c; warn = w; }
}

// 接口数据协议与执行契约。
class DiagFileEntry {
    public string path;
    public int startLine;

    public DiagFileEntry(string path, int startLine) {
        this.path = path != null ? path : "";
        this.startLine = startLine;
    }
}

// 核心契约与语义定义。
class Diags {
    public List<Diag> items;
    List<DiagFileEntry> fileEntries;
    public Diags() { items = new List<Diag>(); fileEntries = null; }
    public void Error(string m, int line, int col) { items.Add(new Diag(m, line, col, false)); }
    public void Warning(string m, int line, int col) { items.Add(new Diag(m, line, col, true)); }
    public int Count() { return items.Count; }
    public bool HasErrors() {
        int i = 0;
        while (i < items.Count) {
            if (!items[i].warn) { return true; }
            i = i + 1;
        }
        return false;
    }

    // 接口数据协议与执行契约。
    public void SetFiles(List<string> names, List<int> starts) {
        if (names == null || starts == null) {
            fileEntries = null;
            return;
        }
        fileEntries = new List<DiagFileEntry>();
        int i = 0;
        while (i < names.Count && i < starts.Count) {
            fileEntries.Add(new DiagFileEntry(names[i], starts[i]));
            i = i + 1;
        }
    }

    public void SetFileEntries(List<DiagFileEntry> entries) {
        fileEntries = entries;
    }

    string Esc() {
        string e = "" + " ";
        e[0] = 27;
        return e;
    }

    string PadLeft(string s, int w) {
        string r = s;
        while (r.Length < w) { r = " " + r; }
        return r;
    }

    // 接口数据协议与执行契约。
    public void Report(string src, int start) {
        string red = Esc() + "[31m";
        string yel = Esc() + "[33m";
        string rst = Esc() + "[0m";
        int j = start;
        while (j < items.Count) {
            Diag e = items[j];
            int shown = e.line;
            string loc = "";
            if (fileEntries != null && fileEntries.Count > 0) {
                int fi = 0;
                int k = 1;
                while (k < fileEntries.Count) {
                    if (fileEntries[k].startLine <= e.line) { fi = k; }
                    k = k + 1;
                }
                shown = e.line - fileEntries[fi].startLine + 1;
                loc = fileEntries[fi].path + ":";
            }
            if (e.warn) {
                Console.WriteLine(loc + shown + ":" + e.col + ": " + yel + "warning" + rst + ": " + e.msg);
            } else {
                Console.WriteLine(loc + shown + ":" + e.col + ": " + red + "error" + rst + ": " + e.msg);
            }
            string ln = LineOf(src, e.line);
            if (ln.Length > 0) {
                Console.WriteLine(PadLeft("" + shown, 5) + " | " + ln);
                string car = "";
                int k2 = 1;
                while (k2 < e.col) { car = car + " "; k2 = k2 + 1; }
                Console.WriteLine("      | " + car + (e.warn ? yel : red) + "^" + rst);
            }
            j = j + 1;
        }
    }

    // 接口数据协议与执行契约。
    public void Summary() {
        int errs = 0;
        int warns = 0;
        int i = 0;
        while (i < items.Count) {
            if (items[i].warn) { warns = warns + 1; } else { errs = errs + 1; }
            i = i + 1;
        }
        Console.WriteLine("");
        Console.WriteLine("" + errs + " error(s), " + warns + " warning(s)");
    }

    // 接口数据协议与执行契约。
    string LineOf(string src, int line) {
        int cur = 1;
        int i = 0;
        int start = 0;
        while (i < src.Length && cur < line) {
            if ((int)src[i] == 10) { cur = cur + 1; start = i + 1; }
            i = i + 1;
        }
        int end = start;
        while (end < src.Length && (int)src[end] != 10) { end = end + 1; }
        if (end > start && (int)src[end - 1] == 13) { end = end - 1; }
        return src.Substring(start, end - start);
    }
}
