using System;
using System.Collections.Generic;
namespace Zan;

// Mach-O 64-bit object file writer for Ngen (arm64). Layout:
//
//   header (32) + LC_SEGMENT_64 (312, 3 sections) + LC_SYMTAB (24)
//   __TEXT,__text    at 368
//   __TEXT,__cstring after text
//   __DATA,__data    after cstring, 8-aligned (module globals)
//   text relocations (8 bytes each, sorted by r_address)
//   symbol table (16 bytes per nlist_64), then string table
//
// Symbols: one defined symbol per method/runtime function (n_sect 1), one
// local symbol per string literal "l_.str.N" (n_sect 2) and per data global
// "l_.g.NAME" (n_sect 3), then the undefined externs. ADRP/ADD references
// stay imm=0 in the object; the linker fills them via the relocations
// (embedded addends in ADD are rejected by ld64).
//
// Relocations emitted:
//   BL extern   -> ARM64_RELOC_BRANCH26 (pcrel, extern)
//   adrp ref    -> ARM64_RELOC_PAGE21    (pcrel, extern, target symbol)
//   add  ref    -> ARM64_RELOC_PAGEOFF12 (absolute, extern, target symbol)
partial class Ngen {
    // 32 header + 312 LC_SEGMENT_64 (3 sections) + 24 LC_SYMTAB; the
    // homemade __nl_symbol_ptr section adds 80 when present (BuildMachOImage
    // recomputes this before laying out the payload)
    int TextFileOff = 368;

    string StrSym(int i) { return "l_.str." + i; }
    string DGlobalSym(string n) { return "l_.g." + n; }

    // slot data globals carry the "nl." prefix (see LoadSymRefGOT)
    int IsNlSlot(string n) {
        return (n.Length > 3 && (int)n[0] == 0x6E && (int)n[1] == 0x6C && (int)n[2] == 0x2E) ? 1 : 0;
    }

    int StrOffset(int si) {
        int off = 0;
        int i = 0;
        while (i < si) {
            off = off + strs[i].Length + 1;
            i = i + 1;
        }
        return off;
    }

    // prefix-sum byte offsets of the string-literal pool: StrOffset is O(n)
    // per call and the symbol loops call it for every string
    List<int> StrOffsets() {
        List<int> offs = new List<int>();
        offs.Add(0);
        int i = 0;
        while (i < strs.Count) { offs.Add(offs[i] + strs[i].Length + 1); i = i + 1; }
        return offs;
    }

    // membership index over [syms | strs | dglbs] names: ExternSyms asks
    // DefinedSym once per string reference and the per-reference linear
    // scans (with an l_.str.N format per literal) dominated profiles on
    // large stdlib pull-ins
    MethIndex BuildDefSymIdx() {
        MethIndex ix = new MethIndex();
        int i = 0;
        while (i < syms.Count) { ix.Add(syms[i].name, 1); i = i + 1; }
        i = 0;
        while (i < strs.Count) { ix.Add(StrSym(i), 1); i = i + 1; }
        i = 0;
        while (i < dglbs.Count) { ix.Add(DGlobalSym(dglbs[i].name), 1); i = i + 1; }
        return ix;
    }

    int DefinedSymIdx(MethIndex ix, string name) {
        return ix.Get(name) != null ? 1 : 0;
    }

    // undefined extern names in first-reference order
    List<string> ExternSyms() {
        List<string> es = new List<string>();
        MethIndex defIx = BuildDefSymIdx();
        MethIndex esIx = new MethIndex();
        int i = 0;
        while (i < fixups.Count) {
            Fixup f = fixups[i];
            if (f.kind == 4) {
                if (esIx.Get(f.sym) == null) { es.Add(f.sym); esIx.Add(f.sym, es.Count - 1); }
            }
            i = i + 1;
        }
        // GOT-slot references (dylib data symbols) are undefined too;
        // so are plain adrp+add data references that the linker resolves
        // against a linked-in object (the C reactor's co_ready hook)
        i = 0;
        while (i < strRefs.Count) {
            StrRef r = strRefs[i];
            if (DefinedSymIdx(defIx, r.sym) == 0 && esIx.Get(r.sym) == null) {
                es.Add(r.sym);
                esIx.Add(r.sym, es.Count - 1);
            }
            i = i + 1;
        }
        // the underlying externs behind the homemade __nl_symbol_ptr slots
        // are undefined even though the slot globals themselves are defined
        i = 0;
        while (i < nlExts.Count) {
            if (esIx.Get(nlExts[i]) == null) { es.Add(nlExts[i]); esIx.Add(nlExts[i], es.Count - 1); }
            i = i + 1;
        }
        return es;
    }

    // 1 when the symbol is defined in this object (method, string, global)
    int DefinedSym(string name) {
        int i = 0;
        while (i < syms.Count) { if (syms[i].name == name) { return 1; } i = i + 1; }
        i = 0;
        while (i < strs.Count) { if (StrSym(i) == name) { return 1; } i = i + 1; }
        i = 0;
        while (i < dglbs.Count) { if (DGlobalSym(dglbs[i].name) == name) { return 1; } i = i + 1; }
        return 0;
    }

    int IndexOf(List<string> xs, string s) {
        int i = 0;
        while (i < xs.Count) { if (xs[i] == s) { return i; } i = i + 1; }
        return -1;
    }

    // O(1) name -> symbol-number map over [syms | strs | dglbs | exts],
    // built once per object write; first occurrence wins, like the old
    // per-reference linear scans
    MethIndex BuildRefSymIdx(List<string> exts, int extBase, int numOff) {
        MethIndex ix = new MethIndex();
        int i = 0;
        while (i < syms.Count) { ix.Add(syms[i].name, numOff + i); i = i + 1; }
        i = 0;
        while (i < strs.Count) { ix.Add(StrSym(i), numOff + syms.Count + i); i = i + 1; }
        i = 0;
        while (i < dglbs.Count) { ix.Add(DGlobalSym(dglbs[i].name), numOff + syms.Count + strs.Count + i); i = i + 1; }
        i = 0;
        while (i < exts.Count) { ix.Add(exts[i], numOff + extBase + i); i = i + 1; }
        return ix;
    }

    int RefSymNum(string name, MethIndex ix, int extBase) {
        List<int> hit = ix.Get(name);
        if (hit != null) { return hit[0]; }
        return extBase - 1;         // mirrors the old IndexOf miss fallthrough
    }

    // symbol-table index of a referenced symbol: defined syms first, then
    // string literals, then data globals, then undefined externs
    int RefSymNumScan(string name, List<string> exts, int extBase) {
        int i = 0;
        while (i < syms.Count) { if (syms[i].name == name) { return i; } i = i + 1; }
        i = 0;
        while (i < strs.Count) { if (StrSym(i) == name) { return syms.Count + i; } i = i + 1; }
        i = 0;
        while (i < dglbs.Count) { if (DGlobalSym(dglbs[i].name) == name) { return syms.Count + strs.Count + i; } i = i + 1; }
        return extBase + IndexOf(exts, name);
    }

    // Object container dispatch. The default stays the Mach-O arm64 writer;
    // ZAN_TARGET=aarch64-linux in the compiler's environment routes to the
    // ELF64 writer in ngen_elf.zan. Both consume the same fixups/symbols.
    List<int> BuildMachO() {
        if (wasmTarget != 0) { return BuildWasm(); }
        if (EnvTargetElf() == 1) { return BuildElf(); }
        if (EnvTargetX86Elf() == 1) { return BuildElfX86(); }   // 批 36
        if (coffTarget != 0) { return BuildCoff(); }
        return BuildMachOImage();
    }

    // build the whole Mach-O object image; returns bytes
    List<int> BuildMachOImage() {
        int textLen = txt.Count;
        TextFileOff = 368 + ((nlExts.Count != 0) ? 80 : 0); // one extra section header
        int cstrOff = TextFileOff + textLen;
        int cstrLen = 0;
        int i = 0;
        while (i < strs.Count) { cstrLen = cstrLen + strs[i].Length + 1; i = i + 1; }
        if (cstrLen == 0) { cstrLen = 1; } // keep the section non-empty
        int dataOff = cstrOff + cstrLen;
        int pad = dataOff - (dataOff / 8) * 8;
        if (pad != 0) { pad = 8 - pad; dataOff = dataOff + pad; }

        // relocation symbol numbers: defined methods, then string literals,
        // then data globals, then undefined externs
        List<string> exts = ExternSyms();
        int extBase = syms.Count + strs.Count + dglbs.Count;
        MethIndex refIdx = BuildRefSymIdx(exts, extBase, 0);

        List<int> rAddr = new List<int>();
        List<int> rWord = new List<int>();
        i = 0;
        while (i < fixups.Count) {
            Fixup f = fixups[i];
            if (f.kind == 4) {
                int symnum = RefSymNum(f.sym, refIdx, extBase);
                if (tgt86 == 1) {
                    // call rel32: the disp32 sits at f.pos+1 (E8 at f.pos);
                    // pcrel is taken against the END of the disp32, which is
                    // exactly the rel32 base the instruction itself uses.
                    // X86_64_RELOC_BRANCH = 2 (4 would be GOT, which makes ld
                    // resolve the call to the __got slot address itself)
                    InsertReloc(rAddr, rWord, f.pos + 1,
                        symnum + (1 << 24) + (2 << 25) + (1 << 27) + (2 << 28));
                } else {
                    // word: symbolnum:24 | pcrel:1 | length:2 | extern:1 | type:4
                    int rw = symnum + (1 << 24) + (2 << 25) + (1 << 27) + (2 << 28);
                    InsertReloc(rAddr, rWord, f.pos, rw);
                }
            }
            i = i + 1;
        }
        i = 0;
        while (i < strRefs.Count) {
            StrRef r = strRefs[i];
            int symnum = RefSymNum(r.sym, refIdx, extBase);
            if (tgt86 == 1) {
                // one rip-relative disp32 per reference (lea for a direct
                // symbol, mov through a homemade __nl_symbol_ptr slot for a
                // dylib data one); REX+opcode+modrm puts the disp32 at
                // adrpPos+3, and pcrel runs against the end of the disp32
                InsertReloc(rAddr, rWord, r.adrpPos + 3,
                    symnum + (1 << 24) + (2 << 25) + (1 << 27) + (1 << 28));
            } else if (r.got != 0) {
                // adrp + ldr through the homemade __nl_symbol_ptr slot:
                // plain PAGE21 + PAGEOFF12; PAGEOFF12 always carries
                // r_length=2 (the linker only patches imm12, matching
                // clang's emission for 64-bit ldr too)
                InsertReloc(rAddr, rWord, r.adrpPos, symnum + (1 << 24) + (2 << 25) + (1 << 27) + (3 << 28));
                InsertReloc(rAddr, rWord, r.addPos, symnum + (2 << 25) + (1 << 27) + (4 << 28)); // PAGEOFF12: pcrel=0
            } else {
                InsertReloc(rAddr, rWord, r.adrpPos, symnum + (1 << 24) + (2 << 25) + (1 << 27) + (3 << 28));
                InsertReloc(rAddr, rWord, r.addPos, symnum + (2 << 25) + (1 << 27) + (4 << 28)); // PAGEOFF12: pcrel=0
            }
            i = i + 1;
        }
        SortReloc2(rAddr, rWord);
        // homemade __nl_symbol_ptr: one 8-byte slot per distinct GOT extern;
        // with no slots every layout value below collapses to the classic
        // three-section image byte for byte
        int nlCount = nlExts.Count;
        List<int> nlRAddr = new List<int>();
        List<int> nlRWord = new List<int>();
        int nli = 0;
        i = 0;
        while (i < dglbs.Count) {
            if (IsNlSlot(dglbs[i].name) != 0) {
                // slot content: UNSIGNED (type 0), extern, 64-bit; the
                // linker writes the bound symbol address into the quad
                int ssym = RefSymNum(nlExts[nli], refIdx, extBase);
                InsertReloc(nlRAddr, nlRWord, dglbs[i].off, ssym + (3 << 25) + (1 << 27));
                nli = nli + 1;
            }
            i = i + 1;
        }
        int nlOff = dataOff + dataLen;              // slot payload
        int relocOff = nlOff + nlLen;               // __text reloc table
        int nrel = rAddr.Count;
        int nlRelocOff = relocOff + nrel * 8;       // slot reloc table
        int nsyms = extBase + exts.Count;
        int symOff = nlRelocOff + nlRAddr.Count * 8;
        int strOff = symOff + nsyms * 16;
        int fileEnd = strOff + strTotal(exts);

        List<int> img = new List<int>();
        // ---- header ----
        Put32(img, 0xFEEDFACF);          // MH_MAGIC_64
        if (tgt86 == 1) {
            Put32(img, 0x01000007);      // CPU_TYPE_X86_64
            Put32(img, 3);               // cpusubtype = CPU_SUBTYPE_I386_ALL
        } else {
            Put32(img, 0x0100000C);      // CPU_TYPE_ARM64
            Put32(img, 0);               // cpusubtype
        }
        Put32(img, 1);                   // MH_OBJECT
        Put32(img, 2);                   // ncmds (segment + symtab; the nl
                                         // section rides inside the segment)
        Put32(img, ((nlCount != 0) ? 392 : 312) + 24); // sizeofcmds
        Put32(img, 0);                   // flags
        Put32(img, 0);                   // reserved
        // ---- LC_SEGMENT_64 ----
        Put32(img, 0x19);
        Put32(img, (nlCount != 0) ? 392 : 312); // 72 + nsects*80
        PutName(img, "", 16);            // segname
        Put64(img, 0);                   // vmaddr
        Put64(img, 0);                   // vmsize
        Put64(img, 0);                   // fileoff
        Put64(img, fileEnd);             // filesize
        Put32(img, 7);                   // maxprot
        Put32(img, 7);                   // initprot
        Put32(img, (nlCount != 0) ? 4 : 3); // nsects
        Put32(img, 0);                   // flags
        // section __TEXT,__text
        PutName(img, "__text", 16);
        PutName(img, "__TEXT", 16);
        Put64(img, TextFileOff);         // addr
        Put64(img, textLen);             // size
        Put32(img, TextFileOff);         // offset
        Put32(img, 4);                   // align = 2^4
        Put32(img, relocOff);            // reloff
        Put32(img, nrel);                // nreloc
        Put32(img, 0);                   // flags
        Put32(img, 0);                   // reserved1
        Put32(img, 0);                   // reserved2
        Put32(img, 0);                   // reserved3
        // section __TEXT,__cstring
        PutName(img, "__cstring", 16);
        PutName(img, "__TEXT", 16);
        Put64(img, cstrOff);
        Put64(img, cstrLen);
        Put32(img, cstrOff);
        Put32(img, 0);                   // align = 2^0
        Put32(img, 0);                   // reloff
        Put32(img, 0);                   // nreloc
        Put32(img, 2);                   // S_CSTRING_LITERALS
        Put32(img, 0);                   // reserved1
        Put32(img, 0);                   // reserved2
        Put32(img, 0);                   // reserved3
        // section __DATA,__data
        PutName(img, "__data", 16);
        PutName(img, "__DATA", 16);
        Put64(img, dataOff);
        Put64(img, dataLen);
        Put32(img, dataOff);
        Put32(img, 3);                   // align = 2^3
        Put32(img, 0);                   // reloff
        Put32(img, 0);                   // nreloc
        Put32(img, 0);                   // flags
        Put32(img, 0);                   // reserved1
        Put32(img, 0);                   // reserved2
        Put32(img, 0);                   // reserved3
        if (nlCount != 0) {
            // section __DATA,__nl_symbol_ptr (S_NON_LAZY_SYMBOL_POINTERS):
            // each slot quad carries an UNSIGNED extern reloc that the
            // linker binds at link time; reserved1 = 0 (no indirect symbol
            // table in relocatable objects)
            PutName(img, "__nl_symbol_ptr", 16);
            PutName(img, "__DATA", 16);
            Put64(img, nlOff);
            Put64(img, nlLen);
            Put32(img, nlOff);
            Put32(img, 3);               // align = 2^3
            Put32(img, nlRelocOff);
            Put32(img, nlRAddr.Count);
            Put32(img, 6);               // S_NON_LAZY_SYMBOL_POINTERS
            Put32(img, 0);               // reserved1
            Put32(img, 0);               // reserved2
            Put32(img, 0);               // reserved3
        }
        // ---- LC_SYMTAB ----
        Put32(img, 0x2);
        Put32(img, 24);
        Put32(img, symOff);
        Put32(img, nsyms);
        Put32(img, strOff);
        Put32(img, strTotal(exts));
        // ---- payload ----
        Append(img, txt, 0, textLen);
        i = 0;
        while (i < strs.Count) {
            PutName(img, strs[i], strs[i].Length + 1);
            i = i + 1;
        }
        if (strs.Count == 0) { Put8(img, 0); }
        i = 0;
        while (i < pad) { Put8(img, 0); i = i + 1; }
        EmitDataPayload(img);
        i = 0;
        while (i < nlLen) { Put8(img, 0); i = i + 1; }
        i = 0;
        while (i < nrel) {
            Put32(img, rAddr[i]);
            Put32(img, rWord[i]);
            i = i + 1;
        }
        // __nl_symbol_ptr slot relocs
        i = 0;
        while (i < nlRAddr.Count) {
            Put32(img, nlRAddr[i]);
            Put32(img, nlRWord[i]);
            i = i + 1;
        }
        // ---- symbol table ----
        int stro = 1; // strtab[0] is the NUL byte
        // defined method/runtime symbols (n_sect = __text)
        i = 0;
        while (i < syms.Count) {
            Put32(img, stro);
            Put8(img, 0x0F);             // N_SECT | N_EXT
            Put8(img, 1);
            Put16(img, 0);               // n_desc
            Put64(img, TextFileOff + syms[i].pos);
            stro = stro + syms[i].name.Length + 1;
            i = i + 1;
        }
        // string literal symbols (n_sect = __cstring, local)
        List<int> soffs = StrOffsets();
        i = 0;
        while (i < strs.Count) {
            Put32(img, stro);
            Put8(img, 0x0E);             // N_SECT (local)
            Put8(img, 2);
            Put16(img, 0);
            Put64(img, cstrOff + soffs[i]);
            stro = stro + StrSym(i).Length + 1;
            i = i + 1;
        }
        // data global symbols (n_sect = __data, local; slot globals live
        // in the trailing __nl_symbol_ptr section when present)
        i = 0;
        while (i < dglbs.Count) {
            Put32(img, stro);
            Put8(img, 0x0E);             // N_SECT (local)
            Put8(img, (IsNlSlot(dglbs[i].name) != 0) ? 4 : 3);
            Put16(img, 0);
            Put64(img, (IsNlSlot(dglbs[i].name) != 0) ? nlOff + dglbs[i].off : dataOff + dglbs[i].off);
            stro = stro + DGlobalSym(dglbs[i].name).Length + 1;
            i = i + 1;
        }
        // undefined externs
        i = 0;
        while (i < exts.Count) {
            Put32(img, stro);
            Put8(img, 0x01);             // N_UNDF | N_EXT
            Put8(img, 0);
            Put16(img, 0);
            Put64(img, 0);
            stro = stro + exts[i].Length + 1;
            i = i + 1;
        }
        // ---- string table ----
        Put8(img, 0);
        i = 0;
        while (i < syms.Count) { PutName(img, syms[i].name, syms[i].name.Length + 1); i = i + 1; }
        i = 0;
        while (i < strs.Count) { PutName(img, StrSym(i), StrSym(i).Length + 1); i = i + 1; }
        i = 0;
        while (i < dglbs.Count) { PutName(img, DGlobalSym(dglbs[i].name), DGlobalSym(dglbs[i].name).Length + 1); i = i + 1; }
        i = 0;
        while (i < exts.Count) { PutName(img, exts[i], exts[i].Length + 1); i = i + 1; }
        return img;
    }

    int strTotal(List<string> exts) {
        int n = 1;
        int i = 0;
        while (i < syms.Count) { n = n + syms[i].name.Length + 1; i = i + 1; }
        i = 0;
        while (i < strs.Count) { n = n + StrSym(i).Length + 1; i = i + 1; }
        i = 0;
        while (i < dglbs.Count) { n = n + DGlobalSym(dglbs[i].name).Length + 1; i = i + 1; }
        i = 0;
        while (i < exts.Count) { n = n + exts[i].Length + 1; i = i + 1; }
        return n;
    }

    // relocation entries must reach the writer sorted by offset; sorting
    // once after collection replaced the per-item insertion sort, which was
    // O(R^2) and ~60% of compile time on big inputs (Chart family)
    void InsertReloc(List<int> addrs, List<int> words, int addr, int w) {
        addrs.Add(addr);
        words.Add(w);
    }

    void SortReloc2(List<int> a, List<int> w) {
        int n = a.Count;
        if (n < 2) { return; }
        int i = n / 2;
        while (i > 0) { i = i - 1; SiftReloc2(a, w, i, n); }
        i = n - 1;
        while (i > 0) {
            int t = a[0]; a[0] = a[i]; a[i] = t;
            t = w[0]; w[0] = w[i]; w[i] = t;
            SiftReloc2(a, w, 0, i);
            i = i - 1;
        }
    }

    void SiftReloc2(List<int> a, List<int> w, int root, int n) {
        while (true) {
            int l = root * 2 + 1;
            if (l >= n) { break; }
            int m = l;
            if (l + 1 < n && a[l + 1] > a[m]) { m = l + 1; }
            if (a[root] >= a[m]) { break; }
            int t = a[root]; a[root] = a[m]; a[m] = t;
            t = w[root]; w[root] = w[m]; w[m] = t;
            root = m;
        }
    }

    void Put32(List<int> img, int v) {
        img.Add(ByteAt(v, 0)); img.Add(ByteAt(v, 1));
        img.Add(ByteAt(v, 2)); img.Add(ByteAt(v, 3));
    }
    void Put64(List<int> img, long v) {
        int n = 0;
        while (n < 8) {
            long b = v >> (n * 8);
            b = b - (b / 256) * 256;
            if (b < 0) { b = b + 256; }
            img.Add((int)b);
            n = n + 1;
        }
    }
    void Put16(List<int> img, int v) {
        img.Add(ByteAt(v, 0)); img.Add(ByteAt(v, 1));
    }
    void Put8(List<int> img, int v) { img.Add(v); }
    void PutName(List<int> img, string s, int n) {
        int i = 0;
        while (i < s.Length) { img.Add(ByteAt(s[i], 0)); i = i + 1; }
        while (i < n) { img.Add(0); i = i + 1; }
    }
    void Append(List<int> img, List<int> src, int at, int n) {
        int i = 0;
        while (i < n) { img.Add(src[at + i]); i = i + 1; }
    }
}
