using System;
using System.Collections.Generic;
using System.IO;
namespace Zan;

// Self-hosted compiler driver. Mirrors src/compiler/main.c for the bootstrap
// subset. Usage:
//
//   zanc <output.ll> <input1.zan> [input2.zan ...]
//
// All inputs are concatenated into a single translation unit (they share one
// namespace), lexed, parsed, bound, checked and lowered to LLVM IR text which
// is written to <output.ll>. clang then compiles that to a native executable.
//
// Like the C host, stdlib modules are auto-included by PATH: every
// `using X.Y.Z;` directive maps to <stdlib_root>/X/Y/Z, resolved to a
// fixpoint (a pulled-in module may itself `using` another namespace).
// stdlib_root is discovered relative to the compiler executable
// (exe_dir/../stdlib, else exe_dir/stdlib).
//
// Pull-in is demand-driven (the C host's pi_* filter): user sources seed a
// live-name set, globbed stdlib files carry only lexed metadata, and a file
// joins the parse when a live name can reach it -- see the Pi* classes and
// PiSeedSource/PiCloseOnce below.

// ---- demand-driven stdlib pull-in (port of the C host's pi_* filter) ----
//
// The glob-everything scan compiles every *.zan under each `using`-ed
// namespace even when the program names a handful of types (`using System;`
// parses 100+ files for one Console call). With the filter, globbed files
// join the parse only when something live can name them:
//
//   - every identifier in the already-included user sources seeds a live
//     name set (a deliberate over-approximation: namespace segments, member
//     names and keywords only ever add candidates, never remove them);
//   - a reached directory is scanned once per file with the real lexer for
//     metadata only -- top-level declared type names, `using` directives, an
//     extension-method marker and its own identifier set. No parse, no AST,
//     so the scan is an order of magnitude cheaper than a parse;
//   - a file joins the parse when one of its top-level names is live, or
//     when it hosts extension methods (an extension call names the receiver
//     and the method, never the host class, so the host file needs its own
//     trigger);
//   - including a file makes its identifiers live and reaches its `using`
//     directories; the closure runs to a fixpoint before any file parses.
//
// Observable semantics are preserved: every name user code spells pulls the
// declaring file exactly as the full glob did, so simple-name collision
// mangling sees the same declaration pairs, and prune keeps everything
// transitively referenced. What disappears is the parse of files whose names
// appear nowhere reachable -- and with it the failure mode where a syntax
// error in an unreachable stdlib file failed unrelated programs.
public class PiName {
    public string str;
    public int flagged;   // live: some parsed source spells this name
    public int userDecl;  // declared as a top-level type by an input file:
                          // unqualified mentions in user code resolve to the
                          // user's own declaration, so they must not pull a
                          // same-named stdlib file (qualified `Ns.Name`
                          // mentions still do -- see PiSeedSource)
    public int nsRoot;    // segment of a known namespace path
    public PiName next;   // intern chain within the hash bucket
    public PiName(string s) {
        str = s; flagged = 0; userDecl = 0; nsRoot = 0; next = null;
    }
}

public class PiFile {
    public string path;
    public List<PiName> top;     // declared type names
    public List<PiName> idents;  // every identifier
    public List<string> usings;  // dotted subdirs
    public string ns;            // declared namespace (probe for subdir pull)
    public int hasExt;           // hosts an extension method
    public int hasController;    // hosts a controller / route entity
    public int included;         // joins the parse
    public int parsed;           // already appended to the input list
    public PiFile(string p) {
        path = p;
        top = new List<PiName>();
        idents = new List<PiName>();
        usings = new List<string>();
        ns = null;
        hasExt = 0; hasController = 0; included = 0; parsed = 0;
    }
}

public class PiDir {
    public string subdir;        // 'A/B/C' form, as written after `using`
    public List<PiFile> files;
    public int reached;          // globbed + metadata-scanned
    public PiDir next;
    public PiDir(string s) {
        subdir = s; files = new List<PiFile>(); reached = 0; next = null;
    }
}

public class Program {
    [DllImport("crt")] static extern long fopen(string path, string mode);
    [DllImport("crt")] static extern long fread(byte[] buf, long size, long count, long f);
    [DllImport("crt")] static extern long fclose(long f);

    static string stdlibRoot;
    static List<string> inclPaths;
    static List<string> inclSrcs;

    static string NormPath(string p) {
        string r = "";
        int i = 0;
        while (i < p.Length) {
            string c = p.Substring(i, 1);
            if (c == "\\") { c = "/"; }
            r = r + c;
            i = i + 1;
        }
        return r;
    }

    static bool Included(string norm) {
        int i = 0;
        while (i < inclPaths.Count) {
            if (inclPaths[i] == norm) { return true; }
            i = i + 1;
        }
        return false;
    }

    static void AddInput(string path) {
        string norm = NormPath(path);
        if (Included(norm)) { return; }
        inclPaths.Add(norm);
        inclSrcs.Add(File.ReadAllText(path));
    }

    // ---- 输入参数展开：@响应文件 + 目录递归（对齐 C 宿主 main.c，A450） ----
    // 宿主 808851f49 起 zanc 接受目录输入（递归 *.zan、跳过点开头/符号链接/
    // 工程杂质目录、序数排序）与 @file（空白分词、# 注释、引号短语、可嵌套、
    // 深度 ≤ 8）。自举驱动此前只认显式文件列表——编大项目同样会撞 Windows
    // 命令行长度上限。排序用 List<string>.Sort()（CompareOrdinal），与宿主
    // qsort(strcmp) 同序；路径拼接统一 '/'，排序序仅在分隔符字节边界上可能
    // 与宿主不同（两侧各自确定即可，差分门比对的是程序 stdout）。
    static void AddArgToken(string token, int depth) {
        if (token.Length > 1 && (int)token[0] == 64) {  // '@'
            ExpandArgFile(token.Substring(1), depth + 1);
            return;
        }
        if (Directory.ExistsOnDisk(token)) {
            List<string> files = new List<string>();
            CollectDirSources(token, files);
            if (files.Count == 0) {
                Console.WriteLine("error: no .zan source files under '" + token + "'");
                throw "zanc: no .zan source files under directory";
            }
            files.Sort();
            int fi = 0;
            while (fi < files.Count) {
                AddInput(files[fi]);
                fi = fi + 1;
            }
            return;
        }
        AddInput(token);
    }

    static void ExpandArgFile(string path, int depth) {
        if (depth > 8) {
            Console.WriteLine("error: argument file '" + path + "' nested too deeply");
            throw "zanc: argument file nested too deeply";
        }
        string text = File.ReadAllText(path);
        List<string> toks = new List<string>();
        int i = 0;
        if (text.Length >= 3 && (int)text[0] == 0xEF && (int)text[1] == 0xBB
            && (int)text[2] == 0xBF) {
            i = 3;  // UTF-8 BOM
        }
        while (i < text.Length) {
            while (i < text.Length && (int)text[i] <= 32) { i = i + 1; }
            if (i >= text.Length) { break; }
            if ((int)text[i] == 35) {  // '#' comment runs to end of line
                while (i < text.Length && (int)text[i] != 10) { i = i + 1; }
                continue;
            }
            string tok = "";
            bool quoted = false;
            while (i < text.Length) {
                int c = (int)text[i];
                if (c == 34) { quoted = !quoted; i = i + 1; continue; }
                if (!quoted && c <= 32) { break; }
                tok = tok + text.Substring(i, 1);
                i = i + 1;
            }
            toks.Add(tok);
        }
        int ti = 0;
        while (ti < toks.Count) {
            AddArgToken(toks[ti], depth);
            ti = ti + 1;
        }
    }

    // 与 C 宿主 skip_project_dir 同一名单（main.c:830）。
    static bool SkipProjectDir(string name) {
        if (name == ".zan-packages" || name == ".git" || name == ".svn"
            || name == ".hg" || name == "build" || name == "publish"
            || name == "bin" || name == "obj" || name == "node_modules"
            || name == "_scratch" || name == "dist" || name == "out"
            || name == "vendor") { return true; }
        return false;
    }

    static void CollectDirSources(string dir, List<string> files) {
        // GetFiles/GetDirectories 不递归、含隐藏；文件只按 .zan 后缀过滤
        // （隐藏文件照收，与宿主一致），目录跳过点开头/杂质/符号链接。
        List<string> names = Directory.GetFiles(dir);
        int ni = 0;
        while (ni < names.Count) {
            string n = names[ni];
            if (n.Length >= 5 && n.Substring(n.Length - 4) == ".zan") {
                files.Add(dir + "/" + n);
            }
            ni = ni + 1;
        }
        List<string> dirs = Directory.GetDirectories(dir);
        int di = 0;
        while (di < dirs.Count) {
            string d = dirs[di];
            if ((int)d[0] == 46 || SkipProjectDir(d)) { di = di + 1; continue; }
            // 符号链接/junction 目录无需在这里排除：stdlib 的枚举在两个
            // 平台都把 reparse 目录按文件收（winList 的 0x400 位、posixList
            // 的"符号链接一律按文件收"），不会出现在 GetDirectories 里。
            CollectDirSources(dir + "/" + d, files);
            di = di + 1;
        }
    }

    static string FindStdlibRoot() {
        string exe = Environment.ExeDir();
        string up = exe + "/../stdlib";
        if (Directory.ListNames(up + "/*") != "") { return up; }
        string up2 = exe + "/../../stdlib";
        if (Directory.ListNames(up2 + "/*") != "") { return up2; }
        string up3 = exe + "/../../../stdlib";
        if (Directory.ListNames(up3 + "/*") != "") { return up3; }
        string sib = exe + "/stdlib";
        if (Directory.ListNames(sib + "/*") != "") { return sib; }
        return "stdlib";
    }

    // ---- package stores (the C host's package.c + auto_include_namespace):
    // a using namespace with no stdlib directory also reaches installed
    // packages' source trees, scanned in the C host's store order ----
    static string pkgProjectRoot;   // nearest zan.proj owner of the input
    static string pkgExeStore;      // toolchain sibling packages/
    static string pkgGlobalStore;   // ~/.local/share/zan/packages (or XDG)

    static string PkgParentDir(string path) {
        int last = -1;
        int i = 0;
        while (i < path.Length) {
            if (path.Substring(i, 1) == "/") { last = i; }
            i = i + 1;
        }
        if (last <= 0) { return "."; }
        return path.Substring(0, last);
    }

    // walk up from the input file to the nearest zan.proj manifest,
    // defaulting to the working directory (resolve_package_project_root)
    static string ResolvePkgProjectRoot(string input) {
        string dir = PkgParentDir(input);
        for (;;) {
            if (File.Exists(dir + "/zan.proj")) { return dir; }
            string parent = PkgParentDir(dir);
            if (parent == dir) { break; }
            dir = parent;
        }
        return ".";
    }

    static void PiInitPkg(string firstInput) {
        pkgProjectRoot = ResolvePkgProjectRoot(firstInput);
        string exe = Environment.ExeDir();
        pkgExeStore = exe + "/../packages";
        string base0 = Environment.GetEnvironmentVariable("XDG_DATA_HOME");
        if (base0 == null || base0.Length == 0) {
            base0 = Environment.GetEnvironmentVariable("HOME");
        }
        if (base0 == null || base0.Length == 0) {
            pkgGlobalStore = "";
        } else {
            pkgGlobalStore = base0 + "/.local/share/zan/packages";
        }
    }

    // one store: every installed package providing the namespace directory
    // (<pkg>/src/<ns>, then <pkg>/stdlib/<ns>, then flat <pkg>/<ns>)
    static void PiGlobStore(PiDir d, string store) {
        if (store == null || store.Length == 0) { return; }
        string seg0 = d.subdir;
        int slash = seg0.IndexOf("/");
        if (slash > 0) { seg0 = seg0.Substring(0, slash); }

        string ents = Directory.ListNames(store + "/*");
        int en = ents.Length;
        int ei = 0;
        string ecur = "";
        while (ei <= en) {
            string c = "";
            if (ei < en) { c = ents.Substring(ei, 1); }
            if (c == "\n" || ei == en) {
                if (ecur.Length > 0 && ecur.Substring(0, 1) != ".") {
                    string root = store + "/" + ecur;
                    if (Directory.ListNames(root + "/src/" + seg0 + "/*") != ""
                        || Directory.Exists(root + "/src")) {
                        int f0 = d.files.Count;
                        PiGlobDir(d, root + "/src/" + d.subdir);
                        PiGlobDir(d, root + "/stdlib/" + d.subdir);
                        PiGlobDir(d, root + "/" + d.subdir);
                        bool isZanWeb = seg0 == "ZanWeb" || (seg0 == "Zan" && (d.subdir == "Zan/Web" || d.subdir.IndexOf("Zan/Web/") == 0));
                        if (d.files.Count == f0 && isZanWeb) {
                            string sdir = d.subdir;
                            if (sdir.IndexOf("Zan/Web") == 0) {
                                sdir = "ZanWeb" + sdir.Substring(7);
                            }
                            if (sdir == "ZanWeb" || sdir == "ZanWeb/Web") {
                                PiGlobFiles(d, root + "/src/ZanWeb/Framework");
                            } else if (sdir == "ZanWeb/Core") {
                                PiGlobFiles(d, root + "/src/ZanWeb/Framework/Core");
                                PiGlobFiles(d, root + "/src/ZanWeb/Modules/Crud/Engine");
                            } else if (sdir == "ZanWeb/Security") {
                                PiGlobFiles(d, root + "/src/ZanWeb/Framework/Security");
                            } else if (sdir == "ZanWeb/Services") {
                                PiGlobFiles(d, root + "/src/ZanWeb/Framework/Services");
                            } else if (sdir == "ZanWeb/Ai") {
                                PiGlobFiles(d, root + "/src/ZanWeb/Framework/Ai");
                            } else if (sdir == "ZanWeb/Model" || sdir.IndexOf("ZanWeb/Model/") == 0) {
                                string sub = sdir == "ZanWeb/Model" ? "" : sdir.Substring(12);
                                PiGlobFiles(d, root + "/src/ZanWeb/Modules/Sys/Model" + sub);
                                PiGlobFiles(d, root + "/src/ZanWeb/Modules/Crud/Model" + sub);
                            } else if (sdir == "ZanWeb/Dao" || sdir.IndexOf("ZanWeb/Dao/") == 0) {
                                string sub = sdir == "ZanWeb/Dao" ? "" : sdir.Substring(10);
                                PiGlobFiles(d, root + "/src/ZanWeb/Modules/Sys/Dao" + sub);
                                PiGlobFiles(d, root + "/src/ZanWeb/Modules/Crud/Dao" + sub);
                            } else if (sdir == "ZanWeb/Admin" || sdir.IndexOf("ZanWeb/Admin/") == 0) {
                                if (sdir == "ZanWeb/Admin") {
                                    PiGlobFiles(d, root + "/src/ZanWeb/Modules/Sys/Controller/Admin");
                                    PiGlobFiles(d, root + "/src/ZanWeb/Modules/Sys/Controller/Admin/System");
                                    PiGlobFiles(d, root + "/src/ZanWeb/Modules/Sys/Controller/Admin/Content");
                                    PiGlobFiles(d, root + "/src/ZanWeb/Modules/Sys/Controller/Admin/Monitor");
                                    PiGlobFiles(d, root + "/src/ZanWeb/Modules/Sys/Controller/Admin/Dev");
                                    PiGlobFiles(d, root + "/src/ZanWeb/Modules/Sys/Controller/Admin/Media");
                                    PiGlobFiles(d, root + "/src/ZanWeb/Modules/Sys/Controller/Admin/Wiki");
                                    PiGlobFiles(d, root + "/src/ZanWeb/Modules/Crud/Controller/Admin");
                                    PiGlobFiles(d, root + "/src/ZanWeb/Modules/Crud/Controller/Admin/Dev");
                                } else {
                                    string sub = sdir.Substring(12);
                                    PiGlobFiles(d, root + "/src/ZanWeb/Modules/Sys/Controller/Admin" + sub);
                                    PiGlobFiles(d, root + "/src/ZanWeb/Modules/Crud/Controller/Admin" + sub);
                                }
                            } else if (sdir == "ZanWeb/Api" || sdir.IndexOf("ZanWeb/Api/") == 0) {
                                string sub = sdir == "ZanWeb/Api" ? "" : sdir.Substring(10);
                                PiGlobFiles(d, root + "/src/ZanWeb/Modules/Sys/Controller/Api" + sub);
                                PiGlobFiles(d, root + "/src/ZanWeb/Modules/Crud/Controller/Api" + sub);
                            } else if (sdir == "ZanWeb/Account" || sdir.IndexOf("ZanWeb/Account/") == 0) {
                                string sub = sdir == "ZanWeb/Account" ? "" : sdir.Substring(14);
                                PiGlobFiles(d, root + "/src/ZanWeb/Modules/Sys/Controller/Account" + sub);
                            } else if (sdir == "ZanWeb/Blog") {
                                PiGlobFiles(d, root + "/src/ZanWeb/Modules/Sys/Controller/Blog");
                            } else if (sdir == "ZanWeb/Users") {
                                PiGlobFiles(d, root + "/src/ZanWeb/Modules/Sys/Controller/Users");
                            } else if (sdir == "ZanWeb/Live") {
                                PiGlobFiles(d, root + "/src/ZanWeb/Modules/Sys/Controller/Live");
                            } else if (sdir == "ZanWeb/Index") {
                                PiGlobFiles(d, root + "/src/ZanWeb/Modules/Sys/Controller/Index");
                            } else if (sdir == "ZanWeb/Health") {
                                PiGlobFiles(d, root + "/src/ZanWeb/Modules/Sys/Controller/Health");
                            }
                        }
                    }
                }
                ecur = "";
            } else {
                ecur = ecur + c;
            }
            ei = ei + 1;
        }
    }

    // reach the namespace through every package store
    static void PiGlobPkgs(PiDir d) {
        PiGlobStore(d, pkgProjectRoot + "/packages");
        PiGlobStore(d, pkgProjectRoot + "/.zan-packages");
        PiGlobStore(d, pkgExeStore);
        PiGlobStore(d, pkgGlobalStore);
        PiGlobPkgNs(d, d.subdir);
    }

    // ---- package sources keyed by their DECLARED namespace ----
    //
    // The C host indexes the package sources by the namespace each file
    // declares and ignores the physical layout (zan_pkg_source_index): a
    // namespace reaches the files that declare it and -- when the namespace
    // does not exist in the standard library -- the files that declare one
    // of its descendants. The self-hosted pull-in walked the package
    // directories instead, so a type declared in a nested directory
    // (`Gui/Styling/Models/ThemeMetricsSnapshot.zan`, namespace
    // `Gui.Styling.Models`) was never reached from `using Gui;` and the
    // type came out undefined.
    static List<PiFile> pkgNsIdx;   // the package sources, keyed by their declared namespace
    static bool pkgNsIdxBuilt;

    // The namespace a package file declares, in the 'A/B/C' subdir form.
    // (PiProbeNs below does the probing.)

    // collect every package source under `dir`, with its declared namespace
    static void PiPkgIdxAdd(string dir) {
        if (dir == null || dir.Length == 0) { return; }
        string names = Directory.ListNames(dir + "/*");
        if (names == null || names.Length == 0) { return; }
        List<string> parts = names.Split("\n");
        int i = 0;
        while (i < parts.Count) {
            string nm = parts[i];
            nm = nm.Trim();
            if (nm != "" && nm.Substring(0, 1) != ".") {
                string full = dir + "/" + nm;
                if (nm.EndsWith(".zan")) {
                    PiFile pf = new PiFile(full);
                    pf.ns = PiProbeNs(full);
                    pkgNsIdx.Add(pf);
                } else {
                    PiPkgIdxAdd(full);
                }
            }
            i = i + 1;
        }
    }

    // the package sources that declare `want` (and, when the namespace is
    // not a standard library one, its descendants)
    static void PiGlobPkgNs(PiDir d, string want) {
        PiPkgIdxEnsure();
        bool hierarchical = !Directory.Exists(stdlibRoot + "/" + want);
        int i = 0;
        while (i < pkgNsIdx.Count) {
            PiFile f = pkgNsIdx[i];
            string ns = f.ns;
            if (ns != null && ns != "") {
                bool hit = ns == want;
                if (!hit && hierarchical && ns.Length > want.Length && ns.StartsWith(want)
                    && ns[want.Length] == '/') {
                    hit = true;
                }
                if (hit && !PiDirHasFile(d, f.path)) {
                    d.files.Add(new PiFile(f.path));
                }
            }
            i = i + 1;
        }
    }

    static List<string> pkgSeenNames;
    // index every package source once (the C host builds the same index
    // once and answers every namespace query from it)
    static void PiPkgIdxEnsure() {
        if (pkgNsIdxBuilt) { return; }
        pkgNsIdxBuilt = true;
        pkgNsIdx = new List<PiFile>();
        pkgSeenNames = new List<string>();
        PiPkgIdxStore(pkgProjectRoot + "/packages");
        PiPkgIdxStore(pkgProjectRoot + "/.zan-packages");
        PiPkgIdxStore(pkgExeStore);
        PiPkgIdxStore(pkgGlobalStore);
    }

    static void PiPkgIdxStore(string store) {
        if (store == null || store.Length == 0) { return; }
        string ents = Directory.ListNames(store + "/*");
        if (ents == null || ents.Length == 0) { return; }
        List<string> parts = ents.Split("\n");
        int i = 0;
        while (i < parts.Count) {
            string nm = parts[i];
            nm = nm.Trim();
            if (nm != "" && nm.Substring(0, 1) != ".") {
                bool seen = false;
                int j = 0;
                while (j < pkgSeenNames.Count) {
                    if (pkgSeenNames[j] == nm) { seen = true; break; }
                    j = j + 1;
                }
                if (!seen) {
                    pkgSeenNames.Add(nm);
                    string root = store + "/" + nm;
                    PiPkgIdxAdd(root + "/src");
                    PiPkgIdxAdd(root + "/stdlib");
                }
            }
            i = i + 1;
        }
    }

    // ---- demand-driven pull-in state ----
    static List<PiName> piTable;   // hash buckets, null-filled
    static PiDir piDirs;
    static PiDir piDirsTail;
    static bool piDb;              // pull-in trace: marker file /tmp/zan_pullin_debug

    // Dotted-name reader results (shared by seed + metadata scan).
    static string piDotName;       // 'A/B/C' form
    static int piDotStop;          // kind of the token that ended the run
    static int piDotIdx;           // index of that token

    static int PiHash(string s) {
        long h = 2166136261;
        int i = 0;
        while (i < s.Length) {
            h = h ^ (int)s[i];
            h = h * 16777619;
            h = h & 4294967295;
            i = i + 1;
        }
        return (int)(h & 16383);
    }

    static PiName PiIntern(string s) {
        int b = PiHash(s);
        PiName p = piTable[b];
        while (p != null) {
            if (p.str == s) { return p; }
            p = p.next;
        }
        PiName q = new PiName(s);
        q.next = piTable[b];
        piTable[b] = q;
        return q;
    }

    static void PiInit() {
        piTable = new List<PiName>();
        int i = 0;
        while (i < 16384) { piTable.Add(null); i = i + 1; }
        piDirs = null;
        piDirsTail = null;
    }

    static void PiReach(string subdir) {
        if (subdir == "") { return; }
        PiDir d = piDirs;
        while (d != null) {
            if (d.subdir == subdir) { return; }
            d = d.next;
        }
        PiDir nd = new PiDir(subdir);
        if (piDirsTail != null) { piDirsTail.next = nd; } else { piDirs = nd; }
        piDirsTail = nd;
    }

    // Record a dotted `using A.B.C;` target (already in 'A/B/C' form) as a
    // reached directory.
    static void PiNoteUsing(PiFile f, string subdir) {
        if (subdir == "") { return; }
        f.usings.Add(subdir);
        PiReach(subdir);
    }

    // Read `A.B.C` after a USING/NAMESPACE token (index i = first candidate).
    // piDotName gets the 'A/B/C' path, piDotStop/piDotIdx the stop token.
    static void PiReadDotted(List<Token> toks, int i) {
        piDotName = "";
        piDotStop = TK.Eof();
        piDotIdx = toks.Count;
        int n = toks.Count;
        if (i >= n || toks[i].kind != TK.Ident()) {
            // Mirror the C host's malformed-using quirk (prev = TK_IDENT).
            piDotStop = TK.Ident();
            piDotIdx = i;
            return;
        }
        for (;;) {
            if (piDotName != "") { piDotName = piDotName + "/"; }
            piDotName = piDotName + toks[i].text;
            i = i + 1;
            if (i >= n || toks[i].kind != TK.Dot()) { break; }
            i = i + 1;
            if (i >= n || toks[i].kind != TK.Ident()) { break; }
        }
        if (i < n) {
            piDotStop = toks[i].kind;
            piDotIdx = i;
        }
    }

    static void PiMarkSegments(string dotted) {
        // Every segment of a known namespace path is a namespace root.
        int start = 0;
        int i = 0;
        while (i <= dotted.Length) {
            if (i == dotted.Length || dotted.Substring(i, 1) == "/") {
                PiName s = PiIntern(dotted.Substring(start, i - start));
                s.nsRoot = 1;
                start = i + 1;
            }
            i = i + 1;
        }
    }

    // Token kinds a declaration's return type can start with (the
    // method/property-declaration shape check in PiSeedSource).
    static bool PiTypeishTok(int k) {
        return k == TK.Ident() || k == TK.String() || k == TK.Bool()
            || k == TK.Char() || k == TK.Int() || k == TK.Long()
            || k == TK.Short() || k == TK.Byte() || k == TK.Double()
            || k == TK.Float() || k == TK.Uint() || k == TK.Ulong()
            || k == TK.Object() || k == TK.Void();
    }

    // an extension-form LINQ call (`xs.Where(...)`) carries no type name
    // from Enumerable.zan -- the member names never match a top-level
    // declaration -- so the demand engine cannot see it. Recognize the
    // DISTINCTIVE Enumerable members by shape (`.Name(`) and reach
    // System/Linq. Ultra-generic names (Count/All/Skip/Contains/First...)
    // are deliberately absent: user classes declare methods with those
    // names constantly (router.All(), q.Skip()), and the pull would add
    // same-name Enumerable overloads that shift resolution (kernel11's
    // List<string>.Contains rendered 0/1 until Enumerable's exact-fit
    // non-generic Contains re-typed it bool).
    static bool PiLinqExtMethod(string s) {
        return s == "Where" || s == "Select" || s == "SelectMany"
            || s == "OrderBy" || s == "OrderByDescending"
            || s == "OrderByStr" || s == "OrderByStrDescending"
            || s == "OrderByNum" || s == "OrderByNumDescending"
            || s == "Aggregate" || s == "TakeWhile" || s == "SkipWhile"
            || s == "Distinct" || s == "DistinctStr"
            || s == "FirstOrDefault" || s == "LastOrDefault"
            || s == "SingleOrDefault"
            || s == "GroupBy" || s == "GroupByStr" || s == "ToList"
            || s == "SumNum" || s == "MinNum" || s == "MaxNum"
            || s == "AverageNum"
            || s == "With" || s == "JoinPairs" || s == "JoinInto"
            || s == "GroupBySel" || s == "GroupBySelStr";
    }

    // Lex one globbed file for pull-in metadata: top-level declared type
    // names (brace depth <= 1 covers the block `namespace X { ... }` spelling
    // too), `using` directives, extension-method marker and the full
    // identifier set. A token-level pass cannot be a perfect declaration
    // parser -- it does not need to be: missed names only ever under-include,
    // and the prev!=Colon/Comma guard keeps the generic-constraint spelling
    // (`where T : class`) from minting bogus candidates.
    static void PiScanFile(PiFile f) {
        if (!File.Exists(f.path)) {
            // Unreadable: include it so the real parse reports the error the
            // full-glob path produced ("cannot read '<path>'").
            f.included = 1;
            return;
        }
        string src = File.ReadAllText(f.path);
        Lexer lx = new Lexer(src);
        List<Token> toks = lx.Run();
        int depth = 0;
        int prev = TK.Eof();
        string lastId = null;   // previous chain segment (Task.WhenAll mirror)
        int n = toks.Count;
        int i = 0;
        while (i < n) {
            Token t = toks[i];
            int k = t.kind;
            if (k == TK.LBrace()) { depth = depth + 1; prev = k; i = i + 1; continue; }
            if (k == TK.RBrace()) { if (depth > 0) { depth = depth - 1; } prev = k; i = i + 1; continue; }
            if (k == TK.Using()) {
                PiReadDotted(toks, i + 1);
                if (piDotStop == TK.Semicolon()) { PiNoteUsing(f, piDotName); }
                prev = piDotStop;
                i = piDotIdx + 1;
                continue;
            }
            if (k == TK.Namespace() && depth == 0 && f.ns == null) {
                // declared namespace (subdir form, directly comparable to
                // PiDir.subdir), for the same-ns subdir pull probe
                PiReadDotted(toks, i + 1);
                f.ns = piDotName;
                prev = piDotStop;
                i = piDotIdx + 1;
                continue;
            }
            if ((k == TK.Class() || k == TK.Struct() || k == TK.Enum() || k == TK.Interface())
                    && depth <= 1 && prev != TK.Colon() && prev != TK.Comma()) {
                if (i + 1 < n && toks[i + 1].kind == TK.Ident()) {
                    f.top.Add(PiIntern(toks[i + 1].text));
                    prev = TK.Ident();
                    i = i + 2;
                    continue;
                }
                prev = k;
                i = i + 1;
                continue;
            }
            if (k == TK.Ident() && t.text == "delegate"
                    && depth <= 1 && prev != TK.Colon() && prev != TK.Comma()) {
                // `delegate ReturnType Name<T>(...)` -- the declared name is
                // the last identifier outside angle brackets before the
                // parameter list's '('; identifiers inside <...> are the
                // delegate's own type parameters and must not mint names (a
                // bare `T` top name would match every generic mention in
                // every later file).
                int j = i + 1;
                int angle = 0;
                PiName dname = null;
                int stop = TK.Eof();
                while (j < n) {
                    int kk = toks[j].kind;
                    if (kk == TK.Eof() || kk == TK.Semicolon()) { stop = kk; break; }
                    if (kk == TK.LParen() && angle == 0) { stop = kk; break; }
                    if (kk == TK.Less()) { angle = angle + 1; }
                    else if (kk == TK.Greater()) { if (angle > 0) { angle = angle - 1; } }
                    else if (kk == TK.Ident() && angle == 0) { dname = PiIntern(toks[j].text); }
                    j = j + 1;
                }
                if (dname != null && stop == TK.LParen()) { f.top.Add(dname); }
                prev = stop;
                i = j + 1;
                continue;
            }
            if (k == TK.LBracket() && i + 1 < n && toks[i + 1].kind == TK.Ident()) {
                string aname = toks[i + 1].text;
                if (aname == "Route" || aname == "HttpGet" || aname == "HttpPost"
                        || aname == "HttpPut" || aname == "HttpDelete" || aname == "HttpPatch") {
                    f.hasController = 1;
                }
            }
            if (k == TK.This()) {
                // Extension-declaration shape: `( this Type name` -- `this`
                // right after '(' AND followed by a type token. The receiver
                // is frequently a builtin (`this string s`), where the type
                // is a KEYWORD token. Expression mentions (`M(this.x)`,
                // `M(this)`) have '.' / ')' after, and `this` inside an
                // argument list has a non-'(' before, so they never trigger.
                if (prev == TK.LParen() && i + 1 < n
                        && toks[i + 1].kind != TK.Void()
                        && PiTypeishTok(toks[i + 1].kind)) {
                    f.hasExt = 1;
                }
                prev = k;
                i = i + 1;
                continue;
            }
            if (k == TK.Ident()) {
                if (prev == TK.Colon()) {
                    if (t.text == "Controller" || t.text == "ApiController"
                            || t.text == "AppController" || t.text == "AdminController") {
                        f.hasController = 1;
                    }
                }
                // `record Name(...)` lowers to a class; the name is the next
                // identifier, and 'record' itself is a contextual keyword.
                if (t.text == "record" && depth <= 1 && i + 1 < n
                        && toks[i + 1].kind == TK.Ident()) {
                    f.top.Add(PiIntern(toks[i + 1].text));
                    prev = TK.Ident();
                    i = i + 2;
                    continue;
                }
                if (prev != TK.Dot()) { lastId = t.text; }
                f.idents.Add(PiIntern(t.text));
                // Mirror the parser's Task.WhenAll/WhenAny -> TaskJoin rewrite
                // (desugar_task_join): the call survives in this file's own
                // references as TaskJoin, so the closure must pull its file.
                if (prev == TK.Dot() && lastId != null && lastId == "Task"
                        && (t.text == "WhenAll" || t.text == "WhenAny")) {
                    f.idents.Add(PiIntern("TaskJoin"));
                }
            }
            prev = k;
            i = i + 1;
        }
    }

    // Seed the live-name worklist and the reached-directory set from one
    // already-included source. Identifiers become live, with one carve-out: a
    // top-level type declared by an input file shadows its own name for every
    // unqualified use in user code, so those mentions do not pull a same-named
    // stdlib file -- otherwise the customary `class App` template drags in the
    // whole Gui framework via stdlib Gui.App. Qualified (dotted) mentions still
    // seed, preserving the rare `Gui.App`-style escapes to the shadowed type.
    //
    // Pass 1 collects namespace roots -- segments of `using` targets and of
    // the file's own `namespace` declaration. Pass 2 needs them to tell a
    // namespace-qualified type (`Gui.App`, `System.String`) apart from a
    // member access on a variable (`b.Label()`): only chains rooted at a
    // namespace segment can name a pull-in candidate. Usings conventionally
    // sit at the top of the file, but a second lex keeps the order irrelevant.
    static void PiSeedSource(string src) {
        Lexer lx = new Lexer(src);
        List<Token> toks = lx.Run();
        int n = toks.Count;
        int pass = 0;
        while (pass < 2) {
            int depth = 0;
            int prev = TK.Eof();
            string chain = null;   // first segment of the dotted chain
            int i = 0;
            while (i < n) {
                Token t = toks[i];
                int k = t.kind;
                if (k == TK.LBrace()) { depth = depth + 1; }
                else if (k == TK.RBrace()) { if (depth > 0) { depth = depth - 1; } }
                else if (k == TK.Using()) {
                    PiReadDotted(toks, i + 1);
                    if (piDotStop == TK.Semicolon() && piDotName != "") {
                        PiReach(piDotName);
                        // every segment is a namespace root for pass 2
                        PiMarkSegments(piDotName);
                    }
                    prev = piDotStop;
                    chain = null;
                    i = piDotIdx + 1;
                    continue;
                }
                else if (k == TK.Namespace()) {
                    // the file's own namespace: its segments are roots too
                    PiReadDotted(toks, i + 1);
                    if ((piDotStop == TK.Semicolon() || piDotStop == TK.LBrace())
                            && piDotName != "") {
                        PiReach(piDotName);
                        if (piDotName.IndexOf("ZanWeb/Admin") == 0) {
                            PiReach("ZanWeb/Admin");
                        }
                        PiMarkSegments(piDotName);
                    }
                    prev = piDotStop;
                    chain = null;
                    i = piDotIdx + 1;
                    continue;
                }
                else if ((k == TK.Class() || k == TK.Struct() || k == TK.Enum() || k == TK.Interface())
                        && depth <= 1 && prev != TK.Colon() && prev != TK.Comma() && pass == 1) {
                    if (i + 1 < n && toks[i + 1].kind == TK.Ident()) {
                        PiName dnm = PiIntern(toks[i + 1].text);
                        dnm.userDecl = 1;
                        prev = TK.Ident();
                        chain = null;
                        i = i + 2;
                        continue;
                    }
                    // peek failed: the C host breaks out of the switch with
                    // prev = the keyword itself
                }
                else if (k == TK.Ident() && t.text == "delegate") {
                    if (depth <= 1 && prev != TK.Colon() && prev != TK.Comma() && pass == 1) {
                        int j = i + 1;
                        int angle = 0;
                        string dname = null;
                        int stop = TK.Eof();
                        while (j < n) {
                            int kk = toks[j].kind;
                            if (kk == TK.Eof() || kk == TK.Semicolon()) { stop = kk; break; }
                            if (kk == TK.LParen() && angle == 0) { stop = kk; break; }
                            if (kk == TK.Less()) { angle = angle + 1; }
                            else if (kk == TK.Greater()) { if (angle > 0) { angle = angle - 1; } }
                            else if (kk == TK.Ident() && angle == 0) { dname = toks[j].text; }
                            j = j + 1;
                        }
                        if (dname != null && stop == TK.LParen()) {
                            PiName dnm = PiIntern(dname);
                            dnm.userDecl = 1;
                        }
                        prev = stop;
                        chain = null;
                        i = j + 1;
                        continue;
                    }
                    // fall-through in the C host ends the chain (a non-IDENT
                    // token kind always does)
                    chain = null;
                }
                else if (k == TK.Ident()) {
                    // `record Name(...)` lowers to a class.
                    if (t.text == "record" && depth <= 1 && i + 1 < n
                            && toks[i + 1].kind == TK.Ident() && pass == 1) {
                        PiName rnm = PiIntern(toks[i + 1].text);
                        rnm.userDecl = 1;
                        prev = TK.Ident();
                        chain = null;
                        i = i + 2;
                        continue;
                    }
                    if (pass == 1) {
                        PiName name = PiIntern(t.text);
                        if (prev != TK.Dot()) {
                            chain = name.str;
                            // Mirror the parser's Task.WhenAll/WhenAny ->
                            // TaskJoin rewrite (desugar_task_join): flag
                            // TaskJoin when this bare `Task` is followed by
                            // `.WhenAll`/`.WhenAny`. Kept as a shape-only
                            // check, independent of whether `Task` sits
                            // under a namespace root.
                            if (t.text == "Task" && i + 1 < n && toks[i + 1].kind == TK.Dot()
                                    && i + 2 < n && toks[i + 2].kind == TK.Ident()
                                    && (toks[i + 2].text == "WhenAll" || toks[i + 2].text == "WhenAny")) {
                                PiName tj = PiIntern("TaskJoin");
                                tj.flagged = 1;
                            }
                            // `from X in` query syntax lowers at parse time
                            // to the Enumerable chain, so none of those
                            // member names appear in the source text; mirror
                            // the desugar (reach System/Linq and flag the
                            // host class) or Enumerable.zan is never pulled.
                            if (t.text == "from" && i + 2 < n
                                    && toks[i + 1].kind == TK.Ident()
                                    && toks[i + 2].kind == TK.In()) {
                                PiReach("System/Linq");
                                PiName qen = PiIntern("Enumerable");
                                qen.flagged = 1;
                            }
                            Token nx = null;
                            if (i + 1 < n) { nx = toks[i + 1]; }
                            if (depth >= 1 && PiTypeishTok(prev) && nx != null
                                    && (nx.kind == TK.LParen() || nx.kind == TK.LBrace())) {
                                // `string Label(` / `string Label {` inside a
                                // type body: a method or property DECLARATION.
                                // Method names collide with stdlib type names
                                // constantly (a widget named Label, a method
                                // named Label) and a declaration never
                                // references a stdlib type. `new Label(...)`
                                // keeps prev==New, so real constructor calls
                                // still pull.
                            } else if (name.userDecl == 0) {
                                name.flagged = 1;
                            }
                        } else if (chain != null && PiIntern(chain).nsRoot == 1) {
                            // `Ns.Segment` under a known namespace root.
                            name.flagged = 1;
                        } else if (chain != null && chain == "Task"
                                && (t.text == "WhenAll" || t.text == "WhenAny")) {
                            // parser desugars Task.WhenAll/WhenAny to class
                            // TaskJoin; the seed sees the pre-desugar
                            // spelling, so mirror the rewrite or TaskJoin.zan
                            // is never pulled.
                            PiName tj = PiIntern("TaskJoin");
                            tj.flagged = 1;
                        } else if (i + 1 < n && toks[i + 1].kind == TK.LParen()
                                && PiLinqExtMethod(t.text)) {
                            // Extension-form LINQ (`nums.Select(n => ...)`
                            // with no query and no `using System.Linq`):
                            // the member names never match a top-level
                            // declaration, so flag by call shape
                            // (see PiLinqExtMethod) or Enumerable.zan is
                            // never pulled.
                            PiReach("System/Linq");
                            PiName len = PiIntern("Enumerable");
                            len.flagged = 1;
                        }
                    }
                }
                // An IDENT may have just started a chain and must survive to
                // the dot that follows it; every other token ends the chain.
                if (k != TK.Dot() && k != TK.Ident()) { chain = null; }
                prev = k;
                i = i + 1;
            }
            pass = pass + 1;
        }
    }

    static void PiGlobDir(PiDir d, string dir) {
        PiGlobFiles(d, dir);
        string ents = Directory.ListNames(dir + "/*");
        int en = ents.Length;
        int ei = 0;
        string ecur = "";
        while (ei <= en) {
            string c = "";
            if (ei < en) { c = ents.Substring(ei, 1); }
            if (c == "\n" || ei == en) {
                bool isZan = ecur.Length >= 4
                    && ecur.Substring(ecur.Length - 4, 4) == ".zan";
                if (ecur != "" && !isZan && ecur.Substring(0, 1) != ".") {
                    PiGlobSameNs(d, dir + "/" + ecur, d.subdir);
                }
                ecur = "";
            } else {
                ecur = ecur + c;
            }
            ei = ei + 1;
        }
    }

    static void PiGlobInto(PiDir d) {
        string dir = stdlibRoot + "/" + d.subdir;
        // Same-namespace subdirectory descent (the C host's pi_glob_into):
        // an immediate subdirectory whose .zan files declare the target
        // directory's own namespace joins the pull (`using Gui;` gathers
        // Gui/Rendering/*.zan and Gui/Text/*.zan alongside Gui/*.zan, since
        // those files declare `namespace Gui;`). Namespaced subdirs like
        // Gui/Widget (ns Gui.Widget) stay out until a `using Gui.Widget;`
        // reaches them.
        PiGlobDir(d, dir);
        PiGlobPkgs(d);
    }

    static bool PiDirHasFile(PiDir d, string path) {
        int i = 0;
        while (i < d.files.Count) {
            if (d.files[i].path == path) { return true; }
            i = i + 1;
        }
        return false;
    }

    static void PiGlobFiles(PiDir d, string dir) {
        string names = Directory.ListNames(dir + "/*.zan");
        int n = names.Length;
        int i = 0;
        string cur = "";
        while (i <= n) {
            string c = "";
            if (i < n) { c = names.Substring(i, 1); }
            if (c == "\n" || i == n) {
                if (cur != "") {
                    string path = dir + "/" + cur;
                    if (!PiDirHasFile(d, path)) { d.files.Add(new PiFile(path)); }
                }
                cur = "";
            } else {
                cur = cur + c;
            }
            i = i + 1;
        }
    }

    // Add a subdirectory's .zan files whose declared namespace matches the
    // pulling directory's own (both are PiReadDotted's subdir form, so the
    // strings compare directly).
    static void PiGlobSameNs(PiDir d, string sub, string tns) {
        string names = Directory.ListNames(sub + "/*.zan");
        int n = names.Length;
        int i = 0;
        string cur = "";
        while (i <= n) {
            string c = "";
            if (i < n) { c = names.Substring(i, 1); }
            if (c == "\n" || i == n) {
                if (cur != "") {
                    string path = sub + "/" + cur;
                    if (tns != null && PiProbeNs(path) == tns) {
                        d.files.Add(new PiFile(path));
                    }
                }
                cur = "";
            } else {
                cur = cur + c;
            }
            i = i + 1;
        }
    }

    // Minimal namespace probe: fast header scan, return first depth-0
    // `namespace X.Y` declaration in subdir form (null when none).
    static string PiProbeNs(string path) {
        long fp = fopen(path, "rb");
        if (fp == 0) { return null; }
        byte[] buf = new byte[1024];
        long nr = fread(buf, 1, 1024, fp);
        fclose(fp);
        if (nr <= 0) { return null; }
        int n = (int)nr;
        int p = 0;
        while (p < n) {
            if (p + 1 < n && buf[p] == 47 && buf[p + 1] == 47) {
                p = p + 2;
                while (p < n && buf[p] != 10 && buf[p] != 13) { p = p + 1; }
                continue;
            }
            if (p + 1 < n && buf[p] == 47 && buf[p + 1] == 42) {
                p = p + 2;
                while (p + 1 < n && !(buf[p] == 42 && buf[p + 1] == 47)) { p = p + 1; }
                if (p + 1 < n) { p = p + 2; }
                continue;
            }
            if (buf[p] == 34) {
                p = p + 1;
                while (p < n && buf[p] != 34) {
                    if (buf[p] == 92 && p + 1 < n) { p = p + 2; }
                    else { p = p + 1; }
                }
                if (p < n) { p = p + 1; }
                continue;
            }
            if (p + 9 <= n
                && buf[p] == 110 && buf[p + 1] == 97 && buf[p + 2] == 109 && buf[p + 3] == 101
                && buf[p + 4] == 115 && buf[p + 5] == 112 && buf[p + 6] == 97 && buf[p + 7] == 99
                && buf[p + 8] == 101) {
                bool preOk = (p == 0 || buf[p - 1] <= 32 || buf[p - 1] == 59);
                bool postOk = (p + 9 < n && buf[p + 9] <= 32);
                if (preOk && postOk) {
                    p = p + 9;
                    while (p < n && buf[p] <= 32) { p = p + 1; }
                    string res = "";
                    while (p < n && buf[p] > 32 && buf[p] != 59 && buf[p] != 123) {
                        if (buf[p] == 46) { res = res + "/"; }
                        else { res = res + (char)buf[p]; }
                        p = p + 1;
                    }
                    if (res != "") { return res; }
                }
            }
            p = p + 1;
        }
        return null;
    }

    // Glob a reached directory and metadata-scan every file once.
    static void PiProcessDir(PiDir d) {
        if (d.reached == 1) { return; }
        d.reached = 1;
        PiGlobInto(d);
        int i = 0;
        while (i < d.files.Count) {
            PiScanFile(d.files[i]);
            i = i + 1;
        }
    }

    // One closure round over every reached directory. Newly reached dirs are
    // appended to the chain as we walk, so the walk covers them in-round.
    static int PiCloseOnce() {
        int changed = 0;
        PiDir d = piDirs;
        while (d != null) {
            if (d.reached == 0) { PiProcessDir(d); }
            int i = 0;
            while (i < d.files.Count) {
                PiFile f = d.files[i];
                if (f.included == 0) {
                    int hit = f.hasExt == 1 || f.hasController == 1 ? 1 : 0;
                    string why = f.hasExt == 1 ? "ext" : (f.hasController == 1 ? "controller" : "");
                    int kk = 0;
                    while (kk < f.top.Count) {
                        if (f.top[kk].flagged == 1) { hit = 1; why = f.top[kk].str; break; }
                        kk = kk + 1;
                    }
                    if (hit == 1) {
                        f.included = 1;
                        changed = 1;
                        if (piDb) { Console.WriteLine("[pullin] incl " + f.path + " because " + why); }
                        int q = 0;
                        while (q < f.idents.Count) {
                            f.idents[q].flagged = 1;
                            q = q + 1;
                        }
                        int u = 0;
                        while (u < f.usings.Count) {
                            PiReach(f.usings[u]);
                            u = u + 1;
                        }
                    }
                }
                i = i + 1;
            }
            d = d.next;
        }
        return changed;
    }

    static void PiAppendIncluded() {
        PiDir d = piDirs;
        while (d != null) {
            int i = 0;
            while (i < d.files.Count) {
                PiFile f = d.files[i];
                if (f.included == 1 && f.parsed == 0) {
                    f.parsed = 1;
                    AddInput(f.path);
                }
                i = i + 1;
            }
            d = d.next;
        }
    }

    // Top-level type dedup. User sources sit before the stdlib pull-ins in
    // inclSrcs, so when user code declares a type the stdlib also has (the
    // customary `class StringExtensions` extension host), the FIRST
    // declaration wins and same-named later declarations are dropped. The C
    // host reaches the same shape by pruning the unreferenced stdlib decl
    // before the binder's duplicate-type check; without this ngen collects
    // both decls' synthesized ctors under one symbol name and the link
    // fails (ld: atomShouldReplaceExisting).
    static void DedupTopTypes(Node unit) {
        List<string> seen = new List<string>();
        int i = 0;
        while (i < unit.kids.Count) {
            Node d = unit.kids[i];
            int k = d.kind;
            bool isType = k == AK.ClassDecl() || k == AK.StructDecl()
                || k == AK.EnumDecl() || k == AK.DelegateDecl();
            bool dup = false;
            if (isType) {
                int j = 0;
                while (j < seen.Count) {
                    if (seen[j] == d.sval) { dup = true; break; }
                    j = j + 1;
                }
            }
            if (dup) {
                unit.kids.RemoveAt(i);
                continue;
            }
            if (isType) { seen.Add(d.sval); }
            i = i + 1;
        }
    }

    static void Main() {
        int argc = Environment.ArgCount();
        if (argc >= 1 && Environment.ArgAt(0) == "--lsp") {
            LspServer.Run();
            return;
        }
        if (argc < 2) {
            Console.WriteLine("usage: zanc <output.ll> <input.zan|dir|@file> [more ...]");
            throw "zanc: no input files";
        } else {
            string outPath = Environment.ArgAt(0);
            inclPaths = new List<string>();
            inclSrcs = new List<string>();
            int i = 1;
            while (i < argc) {
                AddArgToken(Environment.ArgAt(i), 0);
                i = i + 1;
            }

            // stdlib auto-include: demand-driven pull-in (mirrors the C
            // host). User sources seed the live-name set and the reached
            // directories; globbed stdlib files join the parse only when a
            // live name or an extension-method host requires them, to a
            // fixpoint, before anything parses.
            stdlibRoot = FindStdlibRoot();
            PiInitPkg(Environment.ArgAt(1));
            piDb = File.Exists("/tmp/zan_pullin_debug");
            PiInit();
            int pi = 0;
            while (pi < inclSrcs.Count) {
                PiSeedSource(inclSrcs[pi]);
                pi = pi + 1;
            }
            while (PiCloseOnce() == 1) { }
            PiAppendIncluded();
            if (piDb) { Console.WriteLine("[pullin] total " + inclPaths.Count + " files"); }

            string src = "";
            List<int> fileStarts = new List<int>();
            int nextLine = 1;
            int si = 0;
            while (si < inclSrcs.Count) {
                fileStarts.Add(nextLine);
                string body = inclSrcs[si];
                int nlc = 0;
                int ci = 0;
                while (ci < body.Length) {
                    if ((int)body[ci] == 10) { nlc = nlc + 1; }
                    ci = ci + 1;
                }
                nextLine = nextLine + nlc + 1;
                src = src + body + "\n";
                si = si + 1;
            }

            Lexer lx = new Lexer(src);
            List<Token> toks = lx.Run();

            Diags d = new Diags();
            d.SetFiles(inclPaths, fileStarts);
            Parser ps = new Parser(toks, d);
            ps.SetFileBounds(fileStarts);
            Node unit = ps.ParseUnit();

            DedupTopTypes(unit);

            Binder b = new Binder();
            b.Bind(unit);

            // native backend: `zanc out.o input.zan` emits arm64 object code
            // directly (kernel subset, see ngen.zan); `zanc out.obj ...`
            // selects the PE-COFF arm64 writer (ngen_coff.zan, Windows target);
            // `zanc out.wasm ...` selects the WebAssembly binary writer (ngen_wasm.zan)
            bool wasmOut = outPath.Length >= 5 && outPath.Substring(outPath.Length - 5, 5) == ".wasm";
            bool coffOut = outPath.Length >= 4 && outPath.Substring(outPath.Length - 4, 4) == ".obj";
            if (wasmOut || coffOut || (outPath.Length >= 2 && outPath.Substring(outPath.Length - 2, 2) == ".o")) {
                // The same order the C host uses: type-check first, then hand
                // the program to a backend. Without the check the native
                // backend would lower a program with an undefined type into
                // a broken object (the host rejects it at compile time).
                Checker chkNg = new Checker(b, d);
                chkNg.Check(unit);
                d.Report(src, 0);
                if (d.HasErrors()) {
                    d.Summary();
                    throw "zanc: compilation failed";
                }
                Ngen.StdlibRoot = stdlibRoot;
                Ngen ng = new Ngen(b, d, inclPaths[0]);
                if (wasmOut) { ng.SetTargetWasm(); }
                else if (coffOut) { ng.SetTargetCoff(); }
                List<int> obj = ng.Gen(unit);
                d.Report(src, 0);
                if (d.HasErrors()) {
                    d.Summary();
                    throw "zanc: compilation failed";
                }
                Nio.WriteBytes(outPath, obj);
                return;
            }

            Checker chk = new Checker(b, d);
            chk.Check(unit);
            d.Report(src, 0);
            if (d.HasErrors()) {
                d.Summary();
                throw "zanc: compilation failed";
            }

            Irgen ig = new Irgen(b, d);
            string ir = ig.Gen(unit);
            d.Report(src, 0);
            if (d.HasErrors()) {
                d.Summary();
                throw "zanc: compilation failed";
            }
            File.WriteAllText(outPath, ir);
        }
    }
}
