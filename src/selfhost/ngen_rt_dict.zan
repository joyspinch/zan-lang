using System;
using System.Collections.Generic;
namespace Zan;

partial class Ngen {

    // ---- Dictionary<K, V>: parallel 8-byte slots, payload size 40 --
    // { i64 count, i64 cap, ptr keys, ptr vals, i64 kinds }.
    // kinds bit 0: signed int keys (narrowed to i32 at the set boundary);
    // bit 1: signed int values; bit 2: full-width integer keys (long/nint,
    // stored raw and compared as 64-bit, matching the oracle's is_str=0
    // key equality). All other supported slots retain their full 64-bit
    // value/pointer. Never treat an unsupported key type or a boxed struct
    // as an integer slot.
    string DictSlotTy(Node recv, bool key) {
        string ty = StaticTyOf(recv);
        if (recv != null && recv.kind == AK.NewExpr()) { ty = TypeFullName(recv.type); }
        if (ty == null) { return null; }
        int lt = ty.IndexOf("<");
        if (lt < 0 || ty.Substring(ty.Length - 1, 1) != ">") { return null; }
        List<string> args = SplitTyArgs(ty.Substring(lt + 1, ty.Length - lt - 2));
        if (args.Count != 2) { return null; }
        return key ? args[0] : args[1];
    }

    bool DictCheckType(Node recv) {
        string kt = DictSlotTy(recv, true);
        string vt = DictSlotTy(recv, false);
        // an open generic body ("Dict<T, int>" inside HashSet<T>) emits
        // under erasure: keys/values travel as words, the int-kind bits
        // stay clear; concrete instantiations go through the spec pipeline
        bool intKey = (kt == "int" || kt == "uint" || kt == "short" || kt == "ushort"
            || kt == "byte" || kt == "sbyte" || kt == "char" || kt == "bool");
        bool wordKey = (kt == "long" || kt == "ulong" || kt == "nint" || kt == "object"
            || kt == "ptr" || (kt != null && (ClassTyOf(kt) != null || kt.EndsWith("[]"))));
        if (kt != "string" && !intKey && !wordKey && !IsTypeParamErasedNg(kt)) {
            diags.Error("ngen: unsupported Dictionary key type '" + kt
                + "'; supported keys are string, integer and reference types", curLine, curCol);
            return false;
        }
        string valueClass = ClassTyOf(vt);
        Cls vc = null;
        if (valueClass != null) { vc = FindClass(valueClass); }
        // struct values ride the 8-byte slot as a fresh heap box per store
        // (ngen boxes structs; copy-on-store/copy-on-read keeps gen0's value
        // semantics), so the slot kind stays a reference word
        bool structValue = vc != null && vc.isStruct == 1;
        bool refValue = vt != null && (vt == "string" || vt == "object"
            || vt == "ptr" || (vt.Length > 2 && vt.Substring(vt.Length - 2, 2) == "[]") || vt.IndexOf("List<") == 0
            || vt.IndexOf("Dictionary<") == 0 || (vc != null && vc.isStruct == 0)
            || IsDelegateTyNg(vt));
        if (vt != "int" && vt != "long" && vt != "ulong" && vt != "nint"
                && vt != "bool" && vt != "double" && !refValue && !structValue && !IsTypeParamErasedNg(vt)) {
            diags.Error("ngen: unsupported Dictionary value type '" + vt
                + "'; expected int, long, ulong, nint, bool, double, struct or reference", curLine, curCol);
            return false;
        }
        return true;
    }

    // Optional call-site hook: reject reference/struct-to-int conversions
    // before generation instead of silently narrowing an object address.
    void DictCheckOperand(Node recv, Node arg, bool key) {
        if (!DictCheckType(recv) || arg == null) { return; }
        string target = DictSlotTy(recv, key);
        string source = StaticTyOf(arg);
        if (arg.kind == AK.StringLit()) { source = "string"; }
        if (arg.kind == AK.NewExpr()) { source = TypeFullName(arg.type); }
        if (target == "int" && (arg.kind == AK.NullLit() || IsStrExpr(arg)
                || (source != null && source != "int" && source != "long"
                && source != "ulong" && source != "nint" && source != "uint"
                && source != "short" && source != "ushort" && source != "byte"
                && source != "sbyte" && source != "char" && source != "bool"))) {
            diags.Error("ngen: cannot convert Dictionary " + (key ? "key" : "value")
                + " from '" + source + "' to int", arg.line, arg.col);
        }
        if (target == "string" && !IsStrExpr(arg) && arg.kind != AK.NullLit()) {
            diags.Error("ngen: Dictionary string " + (key ? "key" : "value")
                + " requires a string operand", arg.line, arg.col);
        }
        if (target == "long" && (arg.kind == AK.NullLit() || IsStrExpr(arg)
                || (source != null && source != "int" && source != "long"
                && source != "ulong" && source != "nint" && source != "uint"
                && source != "short" && source != "ushort" && source != "byte"
                && source != "sbyte" && source != "char"))) {
            diags.Error("ngen: cannot convert Dictionary " + (key ? "key" : "value")
                + " from '" + source + "' to long", arg.line, arg.col);
        }
    }

    // new Dictionary<K, V>(): alloc 40+16, keys/vals calloc'd at cap 4
    void GenDictNew(Node e) {
        if (!DictCheckType(e)) { LoadImm(0, 0); return; }
        // batch 12: a view as a dict key or value would outlive the method
        // frame that owns its box (ref-struct shape)
        if (SpanTyNg(DictSlotTy(e, true)) || SpanTyNg(DictSlotTy(e, false))) {
            diags.Error("ngen: a Span view cannot be a Dictionary key or value (ref-struct shape)", e.line, e.col);
            LoadImm(0, 0);
            return;
        }
        int kinds = 0;
        string kty = DictSlotTy(e, true);
        if (kty == "int" || kty == "uint" || kty == "short" || kty == "ushort"
                || kty == "byte" || kty == "sbyte" || kty == "char" || kty == "bool") {
            kinds = kinds | 1;
        } else if (kty == "long" || kty == "ulong" || kty == "nint" || kty == "object"
                || kty == "ptr" || (kty != null && (ClassTyOf(kty) != null || kty.EndsWith("[]")))) {
            kinds = kinds | 4;
        }
        string vty = DictSlotTy(e, false);
        if (vty == "int" || vty == "uint" || vty == "short" || vty == "ushort"
                || vty == "byte" || vty == "sbyte" || vty == "char" || vty == "bool") {
            kinds = kinds | 2;
        }
        // calloc both arrays first, then the object; the arrays survive on
        // the stack while the object allocates
        LoadImm(0, 4);
        LoadImm(1, 8);
        BLExtern("_calloc");                         // keys = calloc(4, 8)
        XPushV0();                                   // push keys
        LoadImm(0, 4);
        LoadImm(1, 8);
        BLExtern("_calloc");                         // vals = calloc(4, 8)
        XPushV0();                                   // push vals
        LoadImm(0, 40 + 16);
        LoadImm(1, 0);
        BLInternal("_zan_rt_alloc");                 // obj = alloc (zeroed)
        XPopV(1);                                    // pop vals -> x1
        StrU(1, 0, 24);                              // obj->vals
        XPopV(1);                                    // pop keys -> x1
        StrU(1, 0, 16);                              // obj->keys
        LoadImm(1, 4);
        StrU(1, 0, 8);                               // obj->cap = 4
        LoadImm(1, kinds);
        StrU(1, 0, 32);                              // immutable key/value kinds
        // collection initializer appends through the set path
        if (e != null && e.ival == 2 && e.kids.Count > 0) {
            XPushV0();                               // push dict
            int j = 0;
            while (j < e.kids.Count) {
                Node kv = e.kids[j];
                if (kv != null && kv.kids.Count >= 2) {
                    DictCheckOperand(e, kv.kids[0], true);
                    DictCheckOperand(e, kv.kids[1], false);
                    LdrU(0, 31, 0);                  // x0 = dict (peek)
                    GenExpr(kv.kids[0]);             // key -> x0
                    XPushV0();                       // push key
                    GenExpr(kv.kids[1]);             // value -> x0
                    GenCloneIfStruct(kv.kids[1]);    // struct values: fresh box
                    MovRR(2, 0);                     // x2 = value
                    XPopV(1);                        // pop key -> x1
                    XPopV(0);                        // pop dict -> x0
                    BLInternal("_zan_rt_dict_set");
                    XPushV0();                       // re-push dict
                }
                j = j + 1;
            }
            XPopV(0);                                // pop dict -> x0
        }
    }

    // per-instantiation statics: every generic-class instantiation a body
    // touched gets its own copy of the class's static fields (globals plus
    // initializer entries), so Stat<int>.s and Stat<double>.s differ like
    // gen0's per-instantiation storage
    void MaterializeInstStatics() {
        int ci = 0;
        while (ci < instCls.Count) {
            string inst = instCls[ci];
            int lt = inst.IndexOf("<");
            if (lt > 0) {
                string open = inst.Substring(0, lt);
                List<string> args = SplitTyArgs(inst.Substring(lt + 1, inst.Length - lt - 2));
                Cls c = FindClass(open);
                if (c != null) {
                    int n0 = sfNames.Count;
                    int i0 = sfInitCls.Count;
                    int si = 0;
                    while (si < n0) {
                        if (sfCls[si] == open) {
                            string dn = "fld." + inst + "." + sfNames[si];
                            dglbs.Add(new DGlob(dn, 8, dataLen));
                            dataLen = dataLen + 8;
                            AddSf(sfNames[si], inst, DGlobalSym(dn), SubstTy(sfTy[si], c.tps, args));
                            // clone this field's initializer, if any
                            int j = 0;
                            while (j < i0) {
                                if (sfInitCls[j] == open && sfInitSym[j] == sfSyms[si]) {
                                    Node ex = CloneNode(sfInitExpr[j]);
                                    if (ex != null) { SubstTypeNode(ex, c.tps, args); }
                                    sfInitCls.Add(inst);
                                    sfInitSym.Add(DGlobalSym(dn));
                                    sfInitExpr.Add(ex);
                                    sfInitTy.Add(sfInitTy[j]);
                                }
                                j = j + 1;
                            }
                        }
                        si = si + 1;
                    }
                }
            }
            ci = ci + 1;
        }
    }

    // list.Add(v) inlined: grow when count == cap (cap*2, realloc data),
    // then data[count++] = v -- mirrors gen0's inline Add sequence
    // dict.Add / d[key] = v call tail: the stack holds dict (top), then
    // key, then value; the str-only pushes leave each slot's upper half
    // stale, so pop straight into the ABI registers: x0 = d, x1 = key,
    // x2 = value for _zan_rt_dict_set.
    void RtDictSet3() {
        XPopV(0);                                    // pop dict -> x0
        XPopV(1);                                    // pop key -> x1
        XPopV(2);                                    // pop value -> x2
        BLInternal("_zan_rt_dict_set");
    }

    void RtDictReturn() {
        RtLdur(19, 29, -8);
        RtListReturn();
    }

    // Compare x0=stored key with x1=query, with d saved at fp-16.
    // Return EQ flags; integer comparisons use their i32 values, never
    // addresses. Full-width integer keys (kinds bit 2) compare as raw
    // 64-bit words; string pointer equality also handles two null keys.
    void RtDictCompareKey() {
        RtLdur(9, 29, -16);
        LdrU(9, 9, 32);
        // batch 28: x86 的位测试走 r10(裸立即数 test),不经 LoadImm(10)
        // ——v10 的泼溅家在 [rbp-24],恰好是调用方 RtStur(1,29,-24) 的
        // key 槽;经 LoadImm(10) 落盘会把 key 踩成掩码,第二圈循环起全错
        if (tgt86 == 1) { XLoadImm(16, 1); Xop(0x85, 0, 10); }   // mov r10,#1; test rax,r10
        else { LoadImm(10, 1); E4(0xEA0A013F); }                 // tst x9, x10
        int strings = NL(); int done = NL(); int different = NL(); int notint = NL();
        EmitBcond(1, notint);                  // bit 0 set: int keys
        if (tgt86 == 1) { XLoadImm(16, 4); Xop(0x85, 0, 10); }   // mov r10,#4; test rax,r10
        else { LoadImm(10, 4); E4(0xEA0A013F); }                 // tst x9, x10
        EmitBcond(0, strings);                 // bit 2 clear: string keys
        if (tgt86 == 1) { Xop(0x39, 7, 6); } else { E4(0xEB01001F); }   // cmp x0, x1 (64-bit key)
        EmitB(done);
        Mark(notint);
        if (tgt86 == 1) { X2(0x39, 0xFE); } else { E4(0x6B01001F); }   // cmp edi, esi (w0/w1)
        EmitB(done);
        Mark(strings);
        if (tgt86 == 1) { Xop(0x39, 7, 6); } else { E4(0xEB01001F); }   // cmp x0, x1
        EmitBcond(0, done);
        CbzReg(0, different);
        CbzReg(1, different);
        // Fast-path filter: if *x0 != *x1, strings cannot be equal; avoids _strcmp for ~95% of misses
        if (tgt86 == 1) {
            X4(0x17B60F44);                                              // movzx r10d, byte ptr [rdi]
            X4(0x1EB60F44);                                              // movzx r11d, byte ptr [rsi]
            X3(0x45, 0x39, 0xDA);                                        // cmp r10d, r11d
            EmitBcond(1, different);                                     // jne different
        } else {
            E4(0x39400002);                                              // ldrb w2, [x0]
            E4(0x39400023);                                              // ldrb w3, [x1]
            E4(0x6B03005F);                                              // cmp w2, w3
            EmitBcond(1, different);                                     // b.ne different
        }
        BLExtern("_strcmp");
        if (tgt86 == 1) { X2(0x85, 0xC0); } else { E4(0x7100001F); }   // test eax,eax (cmp w0,#0)
        EmitB(done);
        Mark(different);
        if (tgt86 == 1) { Xop(0x39, 7, 6); } else { E4(0xEB01001F); }   // unequal pointers, one null
        Mark(done);
    }

    // Canonicalize typed slots at the shared set boundary (x0=d).
    // Applies to Add, index assignment, and collection initializers alike.
    void RtDictNarrowSlots() {
        LdrU(9, 0, 32);
        if (tgt86 == 1) { XLoadImm(16, 1); Xop(0x85, 0, 10); }   // test rax, 1
        else { LoadImm(10, 1); E4(0xEA0A013F); }                 // tst x9, x10
        int keyDone = NL(); int valDone = NL(); int key64 = NL();
        EmitBcond(0, key64);                   // bit 0 clear: not int keys
        if (tgt86 == 1) { X3(0x48, 0x63, 0xF6); } else { E4(0x93407C21); }   // movsxd rsi,esi / sxtw x1, w1
        EmitB(keyDone);
        Mark(key64);
        if (tgt86 == 1) { XLoadImm(16, 4); Xop(0x85, 0, 10); }   // test rax, 4
        else { LoadImm(10, 4); E4(0xEA0A013F); }
        EmitBcond(0, keyDone);                 // bit 2 clear: string keys stay raw
        Mark(keyDone);
        if (tgt86 == 1) { XLoadImm(16, 2); Xop(0x85, 0, 10); }   // test rax, 2
        else { LoadImm(10, 2); E4(0xEA0A013F); }
        EmitBcond(0, valDone);
        if (tgt86 == 1) { X3(0x48, 0x63, 0xD2); } else { E4(0x93407C42); }   // movsxd rdx,edx / sxtw x2, w2
        Mark(valDone);
    }

    // i64 _zan_rt_dict_index(ptr d, slot key): linear walk, -1 on miss
    void RtEmitDictIndex() {
        RtListFrame("_zan_rt_dict_index");
        RtStur(0, 29, -16);                    // d
        RtStur(1, 29, -24);                    // key
        RtStur(19, 29, -8);
        LoadImm(19, 0);
        RtLdur(0, 29, -16);
        LdrU(2, 0, 0);                         // count (hoisted initial load)
        int head = NL();
        Mark(head);
        // batch 28:x86 的 i 常驻 v19 槽位([rbp-72],槽位互不冲突),比
        // 较前经 r10 暂存;三处循环同款(Index/Set/Get)
        if (tgt86 == 1) { XGetV(19, 10); Xop(0x39, 2, 10); } else { E4(0xEB00005F | (19 << 16)); }   // cmp count, i
        int notfound = NL();
        EmitBcond(9, notfound);                // b.ls -> miss (i >= count)
        RtLdur(4, 29, -16);
        LdrU(4, 4, 16);                        // keys (x4 is caller-saved: strcmp clobbers it)
        EmitArrElemLoad(8, "long", 4, 19, 0);  // ldr x0, [x4, x19, lsl #3]
        RtLdur(1, 29, -24);                    // key
        RtDictCompareKey();
        int found = NL();
        EmitBcond(0, found);                   // b.eq -> found
        RtLdur(0, 29, -16);
        LdrU(2, 0, 0);                         // reload count (strcmp may clobber x2)
        AddImm(19, 19, 1);                     // i++
        EmitB(head);
        Mark(found);
        MovRR(0, 19);                          // x0 = i (the index)
        RtDictReturn();
        Mark(notfound);
        LoadImm(0, -1);
        RtDictReturn();
    }

    // grow keys/vals in tandem when count == cap: cap *= 2 (0 -> 4 first)
    // x0 = d on entry; RtStur list must be live at [x29, -16]
    void DictGrow() {
        LdrU(2, 0, 0);                         // count
        LdrU(3, 0, 8);                         // cap
        int have = NL(); int allocate = NL(); int done = NL();
        CbnzReg(3, have);
        LoadImm(3, 4);                        // zero-cap dict needs initial allocation
        EmitB(allocate);
        Mark(have);
        if (tgt86 == 1) { Xop(0x39, 2, 1); } else { E4(0xEB03005F); }   // cmp count(x2), cap(x3)
        EmitBcond(3, done);                    // b.lo -> space remains
        AddRR(3, 3, 3);                        // ncap = cap * 2
        Mark(allocate);
        StrU(3, 0, 8);                         // d->cap = ncap
        LdrU(4, 0, 16);                        // old keys
        MovRR(9, 3);
        AddRR(9, 9, 9);
        AddRR(9, 9, 9);
        AddRR(9, 9, 9);                        // x9 = ncap * 8
        MovRR(0, 4);
        MovRR(1, 9);
        BLExtern("_realloc");
        RtLdur(5, 29, -16);                    // d (realloc clobbers x0)
        StrU(0, 5, 16);                        // d->keys
        RtLdur(5, 29, -16);
        LdrU(4, 5, 24);                        // old vals
        LdrU(9, 5, 8);                         // realloc does not preserve x9
        AddRR(9, 9, 9);
        AddRR(9, 9, 9);
        AddRR(9, 9, 9);
        MovRR(0, 4);
        MovRR(1, 9);
        BLExtern("_realloc");
        RtLdur(5, 29, -16);
        StrU(0, 5, 24);                        // d->vals
        Mark(done);
    }

    // void _zan_rt_dict_set(ptr d, ptr key, i64 val): insert or update
    void RtEmitDictSet() {
        RtListFrame("_zan_rt_dict_set");
        RtDictNarrowSlots();
        RtStur(0, 29, -16);                    // d
        RtStur(1, 29, -24);                    // key
        RtStur(2, 29, -32);                    // val
        RtStur(19, 29, -8);
        LoadImm(19, 0);
        int head = NL();
        Mark(head);
        RtLdur(0, 29, -16);
        LdrU(2, 0, 0);
        if (tgt86 == 1) { XGetV(19, 10); Xop(0x39, 2, 10); } else { E4(0xEB00005F | (19 << 16)); }   // cmp count, i
        int insert = NL();
        EmitBcond(9, insert);                  // b.ls -> append (i >= count)
        RtLdur(4, 29, -16);
        LdrU(4, 4, 16);                        // keys (x4 is caller-saved: strcmp clobbers it)
        EmitArrElemLoad(8, "long", 4, 19, 0);  // keys[i]
        RtLdur(1, 29, -24);
        RtDictCompareKey();
        int upd = NL();
        EmitBcond(0, upd);                     // b.eq -> update
        RtLdur(0, 29, -16);
        AddImm(19, 19, 1);
        EmitB(head);
        Mark(upd);
        RtLdur(0, 29, -16);
        LdrU(4, 0, 24);                        // vals
        RtLdur(2, 29, -32);
        // str x2, [x4, x19, lsl #3]:x86 = mov [r8+r10*8], rdx(SIB 11_010_000,
        // REX W|X|B = 4B——批 27 的 REX.X 课文这里逐位落实)
        if (tgt86 == 1) { XGetV(19, 10); X4(0xD014894B); } else { E4(0xF8207880 | (19 << 16) | (4 << 5) | 2); }
        RtDictReturn();
        Mark(insert);
        RtLdur(0, 29, -16);
        DictGrow();
        RtLdur(0, 29, -16);
        LdrU(2, 0, 0);                         // count
        LdrU(3, 0, 16);                        // keys
        RtLdur(1, 29, -24);
        // keys[count] = key:x86 = mov [rcx+rdx*8], rsi(三个都是真寄存器,零暂存)
        if (tgt86 == 1) { X4(0xD1348948); } else { E4(0xF8207800 | (2 << 16) | (3 << 5) | 1); }
        RtLdur(0, 29, -16);
        LdrU(3, 0, 24);                        // vals
        RtLdur(4, 29, -32);                    // value
        // vals[count] = value:x86 = mov [rcx+rdx*8], r8(src=r8 需 REX.R = 4C)
        if (tgt86 == 1) { X4(0xD104894C); } else { E4(0xF8207800 | (2 << 16) | (3 << 5) | 4); }
        AddImm(2, 2, 1);
        RtLdur(0, 29, -16);
        StrU(2, 0, 0);                         // d->count = count + 1
        RtDictReturn();
    }

    // i64 _zan_rt_dict_get(ptr d, ptr key): 0 on miss (zero-value semantics)
    void RtEmitDictGet() {
        RtListFrame("_zan_rt_dict_get");
        RtStur(0, 29, -16);
        RtStur(1, 29, -24);
        RtStur(19, 29, -8);
        LoadImm(19, 0);
        int head = NL();
        Mark(head);
        RtLdur(0, 29, -16);
        LdrU(2, 0, 0);
        if (tgt86 == 1) { XGetV(19, 10); Xop(0x39, 2, 10); } else { E4(0xEB00005F | (19 << 16)); }   // cmp count, i
        int miss = NL();
        EmitBcond(9, miss);
        RtLdur(4, 29, -16);
        LdrU(4, 4, 16);                        // keys (x4 is caller-saved: strcmp clobbers it)
        EmitArrElemLoad(8, "long", 4, 19, 0);  // keys[i]
        RtLdur(1, 29, -24);
        RtDictCompareKey();
        int hit = NL();
        EmitBcond(0, hit);                     // b.eq -> found
        RtLdur(0, 29, -16);
        AddImm(19, 19, 1);                     // i++
        EmitB(head);
        Mark(hit);
        RtLdur(0, 29, -16);
        LdrU(4, 0, 24);                        // vals
        EmitArrElemLoad(8, "long", 4, 19, 0);  // vals[i]
        RtDictReturn();
        Mark(miss);
        LoadImm(0, 0);
        RtDictReturn();
    }

    // i64 _zan_rt_dict_contains / _dict_remove / _dict_clear, plus
    // _dict_tryget and the Keys/Values snapshot builders
    void RtEmitDictQuery() {
        // i64 _zan_rt_dict_contains(ptr d, ptr key): 1 when index >= 0
        RtListFrame("_zan_rt_dict_contains");
        RtStur(0, 29, -16);
        RtStur(1, 29, -24);
        RtLdur(0, 29, -16);
        RtLdur(1, 29, -24);
        BLInternal("_zan_rt_dict_index");
        // cmp x0,#0 + cset x0,ge:x86 = cmp rdi,0; setge al; movzx rdi,al
        if (tgt86 == 1) { X3(0x48, 0x83, 0xF8); X1(0); XSetV0cc(0x9D); }
        else { E4(0xF100001F); E4(0x9A9FB7E0); }
        RtListReturn();

        // i64 _zan_rt_dict_remove(ptr d, ptr key): 1 when removed, 0 on miss;
        // both columns shift LEFT from idx (list_removeat shape), count -= 1
        RtListFrame("_zan_rt_dict_remove");
        RtStur(0, 29, -16);                    // d
        RtStur(1, 29, -24);                    // key
        RtLdur(0, 29, -16);
        RtLdur(1, 29, -24);
        BLInternal("_zan_rt_dict_index");
        if (tgt86 == 1) { X3(0x48, 0x83, 0xF8); X1(0); } else { E4(0xF100001F); }   // cmp x0(idx), #0 / cmp rdi,0
        int miss = NL();
        EmitBcond(11, miss);                   // b.lt -> not found
        RtStur(0, 29, -32);                    // idx
        // keys: dst = keys + idx*8, src = dst + 8, n = (count - idx - 1)*8
        RtLdur(0, 29, -16);
        LdrU(3, 0, 16);                        // keys
        RtLdur(1, 29, -32);
        if (tgt86 == 1) { X4(0xF13C8D48); } else { E4(0x8B000000 | (1 << 16) | (3 << 10) | (3 << 5) | 0); } // add x0,x3,x1,lsl#3 / lea rdi,[rcx+rsi*8]
        AddImm(1, 0, 8);                       // src = dst + 8
        RtLdur(2, 29, -16);
        LdrU(2, 2, 0);                         // count
        RtLdur(9, 29, -32);
        if (tgt86 == 1) { Xop(0x29, 2, 0); } else { E4(0xCB000000 | (9 << 16) | (2 << 5) | 2); } // sub x2, x2, x9(idx) / sub rdx,rax
        SubImm(2, 2, 1);
        if (tgt86 == 1) { X4(0x03E2C148); } else { E4(0xD37DF042); }   // lsl x2,x2,#3 / shl rdx,3
        BLExtern("_memmove");
        // vals: same shift on the parallel column
        RtLdur(0, 29, -16);
        LdrU(3, 0, 24);                        // vals
        RtLdur(1, 29, -32);
        if (tgt86 == 1) { X4(0xF13C8D48); } else { E4(0x8B000000 | (1 << 16) | (3 << 10) | (3 << 5) | 0); } // add x0,x3,x1,lsl#3 / lea rdi,[rcx+rsi*8]
        AddImm(1, 0, 8);
        RtLdur(2, 29, -16);
        LdrU(2, 2, 0);
        RtLdur(9, 29, -32);
        if (tgt86 == 1) { Xop(0x29, 2, 0); } else { E4(0xCB000000 | (9 << 16) | (2 << 5) | 2); } // sub x2, x2, x9 / sub rdx,rax
        SubImm(2, 2, 1);
        if (tgt86 == 1) { X4(0x03E2C148); } else { E4(0xD37DF042); }   // lsl x2,x2,#3 / shl rdx,3
        BLExtern("_memmove");
        RtLdur(0, 29, -16);
        LdrU(2, 0, 0);
        SubImm(2, 2, 1);
        StrU(2, 0, 0);                         // count - 1
        LoadImm(0, 1);
        RtListReturn();
        Mark(miss);
        LoadImm(0, 0);
        RtListReturn();

        // void _zan_rt_dict_clear(ptr d): Count folds to 0; the arrays stay
        // allocated (a later Add overwrites slots from 0)
        RtListFrame("_zan_rt_dict_clear");
        StrU(31, 0, 0);                        // d->count = 0 (xzr)
        RtListReturn();
    }

    // i64 _zan_rt_dict_tryget(ptr d, ptr key, ptr out): *out = value and 1
    // when found; a miss leaves the out slot unchanged, matching gen0
    void RtEmitDictTryGet() {
        RtListFrame("_zan_rt_dict_tryget");
        RtStur(0, 29, -16);                    // d
        RtStur(1, 29, -24);                    // key
        RtStur(2, 29, -32);                    // out
        RtLdur(0, 29, -16);
        RtLdur(1, 29, -24);
        BLInternal("_zan_rt_dict_index");
        if (tgt86 == 1) { X3(0x48, 0x83, 0xF8); X1(0); } else { E4(0xF100001F); }   // cmp x0(idx), #0 / cmp rdi,0
        int miss = NL();
        EmitBcond(11, miss);
        RtLdur(1, 29, -16);
        LdrU(1, 1, 24);                        // vals
        EmitArrElemLoad(8, "long", 1, 0, 0);   // ldr x0, [x1, x0, lsl #3]
        RtLdur(1, 29, -32);                    // out
        StrU(0, 1, 0);                         // *out = value
        LoadImm(0, 1);
        RtListReturn();
        Mark(miss);
        LoadImm(0, 0);
        RtListReturn();
    }

    // ptr _zan_rt_dict_keys / _dict_values: a fresh List whose slots are a
    // copy of the dict's key (offset 16) or value (offset 24) column
    void RtEmitDictKeysValues(int colOff) {
        RtListFrame(colOff == 16 ? "_zan_rt_dict_keys" : "_zan_rt_dict_values");
        RtStur(0, 29, -16);                    // d
        LoadImm(0, 24 + 16);
        LoadImm(1, 0);
        BLInternal("_zan_rt_alloc");           // x0 = obj (zeroed)
        XPushV0();                             // push obj
        RtLdur(2, 29, -16);
        LdrU(2, 2, 0);                         // count (reload; alloc clobbers)
        RtStur(2, 29, -24);                    // count
        int nz = NL();
        CbnzReg(2, nz);
        LoadImm(2, 1);                         // cap = count > 0 ? count : 1
        Mark(nz);
        MovRR(0, 2);
        LoadImm(1, 8);
        BLExtern("_calloc");                   // x0 = data
        XPushV0();                             // push data
        LdrU(9, 31, 16);                       // x9 = obj (data on top)
        RtLdur(2, 29, -24);                    // count (reload; calloc clobbers x2)
        StrU(2, 9, 0);                         // obj->count
        StrU(2, 9, 8);                         // obj->cap = count
        LdrU(3, 31, 0);                        // data
        StrU(3, 9, 16);                        // obj->data
        // memcpy(data, column, count * 8) — size 0 when the dict is empty
        MovRR(0, 3);
        RtLdur(1, 29, -16);
        LdrU(1, 1, colOff);
        RtLdur(2, 29, -24);
        LoadImm(3, 8);
        if (tgt86 == 1) { X3(0x48, 0x0F, 0xAF); X1(0xD1); } else { E4(0x9B037C42); }   // mul x2,x2,x3 / imul rdx,rcx
        BLExtern("_memcpy");
        XPopV(0);                              // pop data (discard)
        XPopV(0);                              // pop obj -> x0
        RtListReturn();
    }
}
