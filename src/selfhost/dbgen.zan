using System;
using System.Collections.Generic;
using System.IO;
namespace Zan;

// Compile-time typed ORM queries for System.Data. Mirrors the C host pass
// in src/compiler/dbgen.c.
//
// `db.Query<T>()` starts a typed query over table T (class name == table
// name). The fluent chain is lowered at parse time: for every entity class a
// query class `__DbQ_T` is generated (Zan source, parsed and merged into the
// unit, like jsongen). Lambda Where conditions are translated into
// parameterized SQL fragments (values are bound, never inlined);
// `Include(p => p.nav)` LEFT JOINs the navigation entity by convention
// (`t.<nav>Id = j.id`) and maps the joined columns into `o.nav`. Chains must
// be fluent (rooted at `db.Query<T>()` in the same expression); `In`/`NotIn`
// list arguments are evaluated twice (count + values), so they must be
// side-effect-free expressions such as locals.
public class Dbgen {
    Node unit;
    Diags diags;
    List<string> needNames;
    List<string> needDaos;
    bool any;
    // generated ORM source text, handed back to main for the post-codegen
    // pull-in round (the generated file's usings reach stdlib namespaces
    // the user never imported); null when nothing was generated
    public string dbSrc;
    bool syncAll;   // saw SyncStructureAll[Async]: bind every [Table] entity

    // Group-aggregate projection shapes (ToList<T>(a => new T { ... })):
    // item fields are "|"-joined strings, one entry per projection
    // member, in projection order.
    List<string> pjEntity;   // chain entity class per projection
    List<string> pjTarget;   // business-declared target type
    List<string> pjName;     // facade method name ("Pj<N>")
    List<string> pjCols;     // SQL fragment per member ("" = group key)
    List<string> pjFields;   // target field name per member
    List<string> pjKinds;    // GenDb kind per member ("0".."4")
    List<string> pjI64;      // "true" when the target field is 64-bit
    List<string> pjKeys;     // "true" when the member is a.Key.<f>

    // GenDb-style per-entity column model (loaded in lockstep with
    // fNames/fTypes/fKinds by LoadFields; same order, same skip filter).
    List<string> dbfCol;      // physical column name
    List<bool> dbfPk;         // primary key
    List<bool> dbfIdent;      // identity (autoincrement)
    List<bool> dbfNotNull;
    List<int> dbfStrLen;

    // field-kind classification (mirrors dg_fk_t)
    static int DfSkip() { return 0; }
    static int DfInt() { return 1; }
    static int DfDouble() { return 2; }
    static int DfBool() { return 3; }
    static int DfString() { return 4; }
    static int DfEnum() { return 5; }
    static int DfNav() { return 6; }

    public Dbgen() {
        unit = null;
        diags = null;
        needNames = new List<string>();
        needDaos = new List<string>();
        any = false;
        syncAll = false;
        dbSrc = null;
        pjEntity = new List<string>();
        pjTarget = new List<string>();
        pjName = new List<string>();
        pjCols = new List<string>();
        pjFields = new List<string>();
        pjKinds = new List<string>();
        pjI64 = new List<string>();
        pjKeys = new List<string>();
    }

    Node FindDecl(string name, int kind) {
        int i = 0;
        while (i < unit.kids.Count) {
            Node d = unit.kids[i];
            if (d.kind == kind && d.sval == name) { return d; }
            i = i + 1;
        }
        return null;
    }

    bool IsIntName(string n) {
        return n == "int" || n == "long" || n == "short" || n == "byte"
            || n == "sbyte" || n == "uint" || n == "ushort" || n == "ulong"
            || n == "char";
    }

    bool IsFloatName(string n) {
        return n == "double" || n == "float" || n == "decimal";
    }

    int Classify(Node tref) {
        if (tref == null || tref.kind != AK.TypeRef()) { return Dbgen.DfSkip(); }
        if (tref.ival == 1 || tref.kids.Count > 0) { return Dbgen.DfSkip(); }
        string n = tref.sval;
        if (IsIntName(n)) { return Dbgen.DfInt(); }
        if (IsFloatName(n)) { return Dbgen.DfDouble(); }
        if (n == "bool") { return Dbgen.DfBool(); }
        if (n == "string") { return Dbgen.DfString(); }
        if (FindDecl(n, AK.EnumDecl()) != null) { return Dbgen.DfEnum(); }
        if (FindDecl(n, AK.ClassDecl()) != null) { return Dbgen.DfNav(); }
        return Dbgen.DfSkip();
    }

    // ---- entity field model ----
    // Parallel lists (bootstrap subset: no small struct types).
    List<string> fNames;
    List<string> fTypes;
    List<int> fKinds;

    void CollectFields(Node cls, int depth) {
        if (cls == null || depth > 8) { return; }
        if (cls.sval2 != "") {
            CollectFields(FindDecl(cls.sval2, AK.ClassDecl()), depth + 1);
        }
        int i = 0;
        while (i < cls.kids.Count) {
            Node m = cls.kids[i];
            i = i + 1;
            if (m.kind != AK.FieldDecl()) { continue; }
            if (HasMod(m.mods, MOD.Static())) { continue; }
            int k = Classify(m.type);
            if (k == Dbgen.DfSkip()) { continue; }
            string tn = "?";
            if (m.type != null && m.type.kind == AK.TypeRef()) { tn = m.type.sval; }
            int fi = fKinds.Count;
            fNames.Add(m.sval);
            fTypes.Add(tn);
            fKinds.Add(k);
            DecodeCol(m.attrCol, fi, m.sval);
        }
    }

    void LoadFields(string cls) {
        fNames = new List<string>();
        fTypes = new List<string>();
        fKinds = new List<int>();
        dbfCol = new List<string>();
        dbfPk = new List<bool>();
        dbfIdent = new List<bool>();
        dbfNotNull = new List<bool>();
        dbfStrLen = new List<int>();
        CollectFields(FindDecl(cls, AK.ClassDecl()), 0);
        // composite primary keys carry no identity column: only a single
        // integer pk infers identity (explicit IsIdentity always wins)
        int pks = 0;
        int i = 0;
        while (i < dbfPk.Count) {
            if (dbfPk[i]) { pks = pks + 1; }
            i = i + 1;
        }
        if (pks > 1) {
            i = 0;
            while (i < dbfIdent.Count) { dbfIdent[i] = false; i = i + 1; }
        }
    }

    // Decode a field's captured [Column(...)] string
    // "colName|primary|identity|nullable|strLen" (-1 = unset bool).
    void DecodeCol(string enc, int fi, string fname) {
        string cn = "";
        int pri = -1;
        int ide = -1;
        int nul = -1;
        int slen = 0;
        if (enc != null && enc.Length > 0) {
            int p = 0;
            int k = 0;
            string cur = "";
            while (k <= enc.Length) {
                string ch = k < enc.Length ? enc.Substring(k, 1) : "|";
                if (ch == "|") {
                    if (p == 0) { cn = cur; }
                    else if (p == 1) { pri = Atoi(cur); }
                    else if (p == 2) { ide = Atoi(cur); }
                    else if (p == 3) { nul = Atoi(cur); }
                    else if (p == 4) { slen = Atoi(cur); }
                    p = p + 1;
                    cur = "";
                } else { cur = cur + ch; }
                k = k + 1;
            }
        }
        dbfCol.Add(cn.Length > 0 ? cn : fname);
        bool pk = pri >= 0 ? pri == 1 : fname == "id";
        dbfPk.Add(pk);
        dbfIdent.Add(ide >= 0 ? ide == 1 : (pk && fKinds[fi] == Dbgen.DfInt()));
        bool nullable = nul >= 0 ? nul == 1 : !pk;
        dbfNotNull.Add(!nullable);
        dbfStrLen.Add(slen);
    }

    int Atoi(string s) {
        int v = 0;
        bool neg = false;
        int i = 0;
        if (s.Length > 0 && s.Substring(0, 1) == "-") { neg = true; i = 1; }
        while (i < s.Length) {
            string c = s.Substring(i, 1);
            if (c.Length == 1 && c[0] >= '0' && c[0] <= '9') { v = v * 10 + (c[0] - 48); }
            else { return 0; }
            i = i + 1;
        }
        return neg ? 0 - v : v;
    }

    // physical column name of the i-th loaded field (ColName override wins)
    string DbColName(int fi) {
        if (dbfCol != null && fi >= 0 && fi < dbfCol.Count) { return dbfCol[fi]; }
        return fNames[fi];
    }

    // 64-bit integer family: BIGINT column, 64-bit bind/read
    static bool Is64Ty(string t) {
        return t == "long" || t == "ulong" || t == "nint";
    }

    static string DbBl(bool v) { return v ? "true" : "false"; }

    // table name: explicit [Table(Name=)/[Table("x")] else class name
    string TableOf(string cls) {
        Node decl = FindDecl(cls, AK.ClassDecl());
        if (decl != null && decl.attrHasTable && decl.attrTable != null
                && decl.attrTable.Length > 0) { return decl.attrTable; }
        return cls;
    }

    bool IsTableEntity(string cls) {
        Node decl = FindDecl(cls, AK.ClassDecl());
        return decl != null && decl.attrHasTable;
    }

    int FieldFind(string name) {
        int i = 0;
        while (i < fNames.Count) {
            if (fNames[i] == name) { return i; }
            i = i + 1;
        }
        return 0 - 1;
    }

    bool HasMod(int mods, int bit) { return (mods / bit) - ((mods / bit) / 2) * 2 == 1; }

    int NeedAdd(string name) {
        int i = 0;
        while (i < needNames.Count) {
            if (needNames[i] == name) { return i; }
            i = i + 1;
        }
        needNames.Add(name);
        return needNames.Count - 1;
    }

    int NeedDao(string name) {
        int i = 0;
        while (i < needDaos.Count) {
            if (needDaos[i] == name) { return i; }
            i = i + 1;
        }
        needDaos.Add(name);
        return needDaos.Count - 1;
    }

    // ---- AST node builders ----

    Node NbStr(string s, int line, int col) {
        Node e = new Node(AK.StringLit());
        e.sval = s; e.line = line; e.col = col;
        return e;
    }

    Node NbIdent(string s, int line, int col) {
        Node e = new Node(AK.Ident());
        e.sval = s; e.line = line; e.col = col;
        return e;
    }

    Node NbMember(Node obj, string name, int line, int col) {
        Node e = new Node(AK.MemberAccess());
        e.a = obj; e.sval = name; e.line = line; e.col = col;
        return e;
    }

    Node NbCall1(Node callee, Node arg, int line, int col) {
        Node e = new Node(AK.Call());
        e.a = callee; e.line = line; e.col = col;
        if (arg != null) { e.Add(arg); }
        return e;
    }

    Node NbCall0(Node callee, int line, int col) {
        Node e = new Node(AK.Call());
        e.a = callee; e.line = line; e.col = col;
        return e;
    }

    Node NbConcat(Node l, Node r) {
        Node e = new Node(AK.Binary());
        e.op = TK.Plus(); e.a = l; e.b = r; e.line = l.line; e.col = l.col;
        return e;
    }

    Node NbCastInt(Node expr) {
        Node t = new Node(AK.TypeRef());
        t.sval = "int";
        Node e = new Node(AK.CastExpr());
        e.type = t; e.b = expr; e.line = expr.line; e.col = expr.col;
        return e;
    }

    Node NbCastDouble(Node expr) {
        Node t = new Node(AK.TypeRef());
        t.sval = "double";
        Node e = new Node(AK.CastExpr());
        e.type = t; e.b = expr; e.line = expr.line; e.col = expr.col;
        return e;
    }

    // ---- WHERE fragment builder ----
    // The fragment is accumulated as literal text plus runtime expression
    // segments (for dynamic IN mark counts), folded into a string-concat
    // expression. Bind calls are recorded in fragment order and chained
    // after `.W(frag)` so parameters line up with their `?` marks.

    string wLit;          // pending literal run
    string wCls;
    Node wExpr;           // folded expression so far (null = none)
    int wLine;
    int wCol;
    string wParam;        // lambda parameter name
    List<int> bindKinds;  // 1=P 2=Pi 3=Pd 4=InI 5=InS 6=InD
    List<Node> bindExprs;
    bool wOk;

    void WfText(string s) { wLit = wLit + s; }

    void WfFlush() {
        if (wLit.Length == 0) { return; }
        Node lit = NbStr(wLit, wLine, wCol);
        if (wExpr == null) { wExpr = lit; } else { wExpr = NbConcat(wExpr, lit); }
        wLit = "";
    }

    void WfExpr(Node e) {
        WfFlush();
        if (wExpr == null) { wExpr = e; } else { wExpr = NbConcat(wExpr, e); }
    }

    void WfBind(int kind, Node expr) {
        bindKinds.Add(kind);
        bindExprs.Add(expr);
    }

    void WfErr(string msg, int line, int col) {
        diags.Error("db.Query<T>().Where: " + msg, line, col);
        wOk = false;
    }

    bool MentionsParam(Node e) {
        if (e == null) { return false; }
        if (e.kind == AK.Ident()) { return e.sval == wParam; }
        if (MentionsParam(e.a)) { return true; }
        if (MentionsParam(e.b)) { return true; }
        if (MentionsParam(e.c)) { return true; }
        if (MentionsParam(e.d)) { return true; }
        int i = 0;
        while (i < e.kids.Count) {
            if (MentionsParam(e.kids[i])) { return true; }
            i = i + 1;
        }
        return false;
    }

    // `p.field` -> field index, else -1.
    int AsColumn(Node e) {
        if (e == null || e.kind != AK.MemberAccess()) { return 0 - 1; }
        Node obj = e.a;
        if (obj == null || obj.kind != AK.Ident() || obj.sval != wParam) { return 0 - 1; }
        return FieldFind(e.sval);
    }

    void WfCol(int fi) { WfText("t." + DbColName(fi)); }

    // Compile-time literal/field type matching: catches the common
    // `p.name == 123` / `p.num == "abc"` mistakes with a clear diagnostic.
    // Returns "" when the literal shape matches the column, else a message.
    // Non-literals (identifiers, calls) are trusted to the generated code.
    string LiteralMismatch(int fi, Node e) {
        Node lit = e;
        if (e.kind == AK.Unary() && (e.op == TK.Minus() || e.op == TK.Plus())) {
            lit = e.a;
        }
        int k = fKinds[fi];
        if (lit.kind == AK.IntLit() || lit.kind == AK.CharLit()) {
            if (k == Dbgen.DfInt() || k == Dbgen.DfEnum() || k == Dbgen.DfDouble()) { return ""; }
            if (k == Dbgen.DfString()) { return "type mismatch: string column compared to an int value"; }
            return "type mismatch: numeric value for a non-numeric column";
        }
        if (lit.kind == AK.FloatLit()) {
            if (k == Dbgen.DfDouble()) { return ""; }
            return "type mismatch: double value compared to a non-double column";
        }
        if (lit.kind == AK.StringLit()) {
            if (k == Dbgen.DfString()) { return ""; }
            return "type mismatch: string value compared to a numeric column";
        }
        if (lit.kind == AK.BoolLit()) {
            if (k == Dbgen.DfBool()) { return ""; }
            return "type mismatch: bool value compared to a non-bool column";
        }
        return "";
    }

    // Emits `?` and records the bind for a scalar comparison value.
    void WfValue(int fi, Node e) {
        string msg = LiteralMismatch(fi, e);
        if (msg != "") { WfErr(msg, e.line, e.col); return; }
        WfText("?");
        int k = fKinds[fi];
        if (k == Dbgen.DfInt()) { WfBind(2, e); }
        else if (k == Dbgen.DfEnum()) { WfBind(2, NbCastInt(e)); }
        else if (k == Dbgen.DfDouble()) {
            // int expressions are promoted to double: a bare Pd(intExpr) would
            // fail LLVM verification, so cast except for a plain double literal.
            if (e.kind == AK.FloatLit()) { WfBind(3, e); }
            else { WfBind(3, NbCastDouble(e)); }
        }
        else if (k == Dbgen.DfString()) { WfBind(1, e); }
        else { WfErr("unsupported column type in comparison", e.line, e.col); }
    }

    string SqlOp(int op, bool flip) {
        if (op == TK.EqEq()) { return " = "; }
        if (op == TK.BangEq()) { return " <> "; }
        if (op == TK.Less()) { if (flip) { return " > "; } return " < "; }
        if (op == TK.Greater()) { if (flip) { return " < "; } return " > "; }
        if (op == TK.LessEq()) { if (flip) { return " >= "; } return " <= "; }
        if (op == TK.GreaterEq()) { if (flip) { return " <= "; } return " >= "; }
        return "";
    }

    // Binds `?` for a scalar value of the given column-kind (used by aggregate
    // comparisons where the value side has no real column).
    void WfValueKind(int k, Node e) {
        WfText("?");
        if (k == Dbgen.DfInt()) { WfBind(2, e); }
        else if (k == Dbgen.DfEnum()) { WfBind(2, NbCastInt(e)); }
        else if (k == Dbgen.DfDouble()) {
            if (e.kind == AK.FloatLit()) { WfBind(3, e); }
            else { WfBind(3, NbCastDouble(e)); }
        }
        else if (k == Dbgen.DfString()) { WfBind(1, e); }
        else { WfErr("unsupported aggregate comparison value", e.line, e.col); }
    }

    // FreeSQL-style aggregate in a condition: `p.Count()`, `p.Sum(x => x.col)`,
    // `p.Avg/Max/Min(x => x.col)`. Emits the SQL text and reports the
    // comparison value kind. Returns the aggregate name, or "" when `e` is not
    // an aggregate call on the lambda parameter.
    string AggCall(Node e, ref int outKind) {
        if (e == null || e.kind != AK.Call()) { return ""; }
        Node callee = e.a;
        if (callee == null || callee.kind != AK.MemberAccess()) { return ""; }
        Node recv = callee.a;
        if (recv == null || recv.kind != AK.Ident() || recv.sval != wParam) { return ""; }
        string mn = callee.sval;
        string fn = "";
        if (mn == "Count") { fn = "COUNT"; }
        else if (mn == "Sum") { fn = "SUM"; }
        else if (mn == "Avg") { fn = "AVG"; }
        else if (mn == "Max") { fn = "MAX"; }
        else if (mn == "Min") { fn = "MIN"; }
        else { return ""; }
        if (fn == "COUNT") {
            if (e.kids.Count != 0) {
                WfErr("Count() takes no arguments", e.line, e.col);
                return fn;
            }
            WfText("COUNT(*)");
            outKind = Dbgen.DfInt();
            return fn;
        }
        if (e.kids.Count != 1) {
            WfErr(fn + " requires x => x.<column>", e.line, e.col);
            return fn;
        }
        Node lam = e.kids[0];
        if (lam == null || lam.kind != AK.Lambda() || lam.kids.Count < 1) {
            WfErr(fn + " expects x => x.<column>", e.line, e.col);
            return fn;
        }
        Node body = lam.a;
        if (body == null || body.kind != AK.MemberAccess() || body.a == null ||
            body.a.kind != AK.Ident() || body.a.sval != LambdaParamName(lam, 0)) {
            WfErr(fn + " expects x => x.<column>", e.line, e.col);
            return fn;
        }
        int ci = FieldFind(body.sval);
        if (ci < 0 || fKinds[ci] == Dbgen.DfNav()) {
            WfErr(fn + " expects a scalar column", e.line, e.col);
            return fn;
        }
        WfText(fn + "(t." + DbColName(ci) + ")");
        if (mn == "Avg") { outKind = Dbgen.DfDouble(); }
        else { outKind = fKinds[ci]; }
        return fn;
    }

    // p.f.Method(arg) conditions: null tests, Between/NotBetween, comparison
    // methods (Eq/Ne/Gt/Ge/Lt/Le), and the string matching Like/NotLike/
    // Contains/StartsWith/EndsWith/In/NotIn. Returns true when `e` was
    // recognized as a column method.
    bool WhereMethod(Node e) {
        if (e.kind != AK.Call()) { return false; }
        Node callee = e.a;
        if (callee == null || callee.kind != AK.MemberAccess()) { return false; }
        int col = AsColumn(callee.a);
        string mn = callee.sval;

        // FreeSQL-style `list.Contains(p.col)` -> `p.col IN (?, ...)`. The
        // receiver is a List (not a column) and the sole argument is a column;
        // `!list.Contains(p.col)` is handled by the NOT wrapper in
        // WhereCond. Mirrors `new[]{1,2,3}.Contains(a.Id)` from the docs.
        if (col < 0 && mn == "Contains" && e.kids.Count == 1) {
            int inner = AsColumn(e.kids[0]);
            if (inner >= 0 && fKinds[inner] != Dbgen.DfBool()) {
                Node list = callee.a;
                if (MentionsParam(list)) {
                    WfErr("the list receiver must not reference the lambda parameter", list.line, list.col);
                    return true;
                }
                WfCol(inner);
                WfText(" IN (");
                Node cnt = NbMember(list, "Count", list.line, list.col);
                Node m = NbCall1(NbMember(NbIdent("__DbBind", list.line, list.col), "M", list.line, list.col), cnt, list.line, list.col);
                WfExpr(m);
                WfText(")");
                int k = fKinds[inner];
                if (k == Dbgen.DfInt() || k == Dbgen.DfEnum()) { WfBind(4, list); }
                else if (k == Dbgen.DfString()) { WfBind(5, list); }
                else if (k == Dbgen.DfDouble()) { WfBind(6, list); }
                else { WfErr("Contains requires an int/string/double column", e.line, e.col); }
                return true;
            }
            return false;
        }

        if (col < 0) { return false; }

        if (mn == "IsNull" || mn == "IsNotNull") {
            if (e.kids.Count != 0) {
                WfErr("IsNull/IsNotNull take no arguments", e.line, e.col);
                return true;
            }
            WfCol(col);
            if (mn == "IsNull") { WfText(" IS NULL"); } else { WfText(" IS NOT NULL"); }
            return true;
        }
        if (mn == "Between" || mn == "NotBetween") {
            if (e.kids.Count != 2) {
                WfErr("Between/NotBetween take exactly two arguments", e.line, e.col);
                return true;
            }
            if (fKinds[col] != Dbgen.DfInt() && fKinds[col] != Dbgen.DfEnum()
                && fKinds[col] != Dbgen.DfDouble()) {
                WfErr("Between requires an int/double/enum column", e.line, e.col);
                return true;
            }
            int bi = 0;
            while (bi < 2) {
                if (MentionsParam(e.kids[bi])) {
                    WfErr("argument must not reference the lambda parameter", e.kids[bi].line, e.kids[bi].col);
                    return true;
                }
                bi = bi + 1;
            }
            WfCol(col);
            if (mn == "Between") { WfText(" BETWEEN "); } else { WfText(" NOT BETWEEN "); }
            WfValue(col, e.kids[0]);
            WfText(" AND ");
            WfValue(col, e.kids[1]);
            return true;
        }
        string cmp = "";
        if (mn == "Eq") { cmp = " = "; }
        else if (mn == "Ne") { cmp = " <> "; }
        else if (mn == "Gt") { cmp = " > "; }
        else if (mn == "Ge") { cmp = " >= "; }
        else if (mn == "Lt") { cmp = " < "; }
        else if (mn == "Le") { cmp = " <= "; }
        if (cmp != "") {
            if (e.kids.Count != 1) {
                WfErr("comparison method takes exactly one argument", e.line, e.col);
                return true;
            }
            if (fKinds[col] == Dbgen.DfBool()) {
                WfErr("bool columns compare with == / !=", e.line, e.col);
                return true;
            }
            if (MentionsParam(e.kids[0])) {
                WfErr("argument must not reference the lambda parameter", e.kids[0].line, e.kids[0].col);
                return true;
            }
            WfCol(col);
            WfText(cmp);
            WfValue(col, e.kids[0]);
            return true;
        }

        if (e.kids.Count != 1) {
            WfErr("column method takes exactly one argument", e.line, e.col);
            return true;
        }
        Node arg = e.kids[0];
        if (MentionsParam(arg)) {
            WfErr("argument must not reference the lambda parameter", arg.line, arg.col);
            return true;
        }
        if (mn == "Like" || mn == "NotLike") {
            if (fKinds[col] != Dbgen.DfString()) {
                WfErr("Like requires a string column", e.line, e.col);
                return true;
            }
            WfCol(col);
            if (mn == "Like") { WfText(" LIKE ?"); } else { WfText(" NOT LIKE ?"); }
            WfBind(1, arg);
            return true;
        }
        if (mn == "Contains" || mn == "StartsWith" || mn == "EndsWith") {
            if (fKinds[col] != Dbgen.DfString()) {
                WfErr("string matching requires a string column", e.line, e.col);
                return true;
            }
            WfCol(col);
            WfText(" LIKE ?");
            Node pat = arg;
            if (mn != "StartsWith") { pat = NbConcat(NbStr("%", arg.line, arg.col), pat); }
            if (mn != "EndsWith") { pat = NbConcat(pat, NbStr("%", arg.line, arg.col)); }
            WfBind(1, pat);
            return true;
        }
        if (mn == "In" || mn == "NotIn") {
            WfCol(col);
            if (mn == "In") { WfText(" IN ("); } else { WfText(" NOT IN ("); }
            // __DbBind.M(arg.Count) expands to the right number of marks.
            // NOTE: `arg` is referenced twice (count + values); it must be
            // side-effect free.
            Node cnt = NbMember(arg, "Count", arg.line, arg.col);
            Node m = NbCall1(NbMember(NbIdent("__DbBind", arg.line, arg.col), "M", arg.line, arg.col), cnt, arg.line, arg.col);
            WfExpr(m);
            WfText(")");
            int k = fKinds[col];
            if (k == Dbgen.DfInt() || k == Dbgen.DfEnum()) { WfBind(4, arg); }
            else if (k == Dbgen.DfString()) { WfBind(5, arg); }
            else if (k == Dbgen.DfDouble()) { WfBind(6, arg); }
            else { WfErr("In requires an int/string/double column", e.line, e.col); }
            return true;
        }
        WfErr("unsupported column method (expected Eq/Ne/Gt/Ge/Lt/Le/Between/NotBetween/IsNull/IsNotNull/Like/NotLike/Contains/StartsWith/EndsWith/In/NotIn)", e.line, e.col);
        return true;
    }

    void WhereCond(Node e) {
        if (!wOk || e == null) { return; }
        if (e.kind == AK.Binary() && (e.op == TK.AmpAmp() || e.op == TK.PipePipe())) {
            WfText("(");
            WhereCond(e.a);
            if (e.op == TK.AmpAmp()) { WfText(" AND "); } else { WfText(" OR "); }
            WhereCond(e.b);
            WfText(")");
            return;
        }
        if (e.kind == AK.Unary() && e.op == TK.Bang()) {
            int col = AsColumn(e.a);
            if (col >= 0 && fKinds[col] == Dbgen.DfBool()) {
                WfCol(col);
                WfText(" = 0");
                return;
            }
            WfText("NOT (");
            WhereCond(e.a);
            WfText(")");
            return;
        }
        if (e.kind == AK.MemberAccess()) {
            int col = AsColumn(e);
            if (col >= 0 && fKinds[col] == Dbgen.DfBool()) {
                WfCol(col);
                WfText(" = 1");
                return;
            }
            WfErr("expected a boolean condition", e.line, e.col);
            return;
        }
        if (WhereMethod(e)) { return; }
        if (e.kind == AK.Binary()) {
            string op = SqlOp(e.op, false);
            if (op == "") {
                WfErr("unsupported operator", e.line, e.col);
                return;
            }
            Node l = e.a;
            Node r = e.b;
            int lc = AsColumn(l);
            int rc = AsColumn(r);
            if (lc >= 0 && rc >= 0) {
                WfCol(lc);
                WfText(op);
                WfCol(rc);
                return;
            }
            int col = lc;
            Node val = r;
            if (col < 0 && rc >= 0) {
                col = rc;
                val = l;
                op = SqlOp(e.op, true);
            }
            if (col < 0 && rc < 0) {
                // FreeSQL-style aggregate comparison: `p.Count() > n`,
                // `p.Sum(x => x.amount) >= n`, ... The aggregate emits its
                // own SQL text; the scalar side binds like a column value.
                int ak = 0;
                string af = AggCall(l, ref ak);
                if (af != "") {
                    if (!wOk) { return; }
                    if (MentionsParam(r)) {
                        WfErr("value side must not reference the lambda parameter", r.line, r.col);
                        return;
                    }
                    WfText(op);
                    WfValueKind(ak, r);
                    return;
                }
                af = AggCall(r, ref ak);
                if (af != "") {
                    if (!wOk) { return; }
                    if (MentionsParam(l)) {
                        WfErr("value side must not reference the lambda parameter", l.line, l.col);
                        return;
                    }
                    WfValueKind(ak, l);
                    WfText(op);
                    return;
                }
            }
            if (col < 0) {
                WfErr("one side of a comparison must be a lambda-parameter field (e.g. p.age > x) in " + wCls + " param=" + wParam, e.line, e.col);
                return;
            }
            if (MentionsParam(val)) {
                WfErr("value side must not reference the lambda parameter", val.line, val.col);
                return;
            }
            // x == null / x != null
            if (val.kind == AK.NullLit()) {
                if (e.op == TK.EqEq()) {
                    WfCol(col);
                    WfText(" IS NULL");
                } else if (e.op == TK.BangEq()) {
                    WfCol(col);
                    WfText(" IS NOT NULL");
                } else {
                    WfErr("null only supports == / !=", e.line, e.col);
                }
                return;
            }
            if (fKinds[col] == Dbgen.DfBool()) {
                if (val.kind != AK.BoolLit() || (e.op != TK.EqEq() && e.op != TK.BangEq())) {
                    WfErr("bool columns only compare to true/false literals", e.line, e.col);
                    return;
                }
                bool tv = val.ival == 1;
                bool truth = tv == (e.op == TK.EqEq());
                WfCol(col);
                if (truth) { WfText(" = 1"); } else { WfText(" = 0"); }
                return;
            }
            WfCol(col);
            WfText(op);
            WfValue(col, val);
            return;
        }
        WfErr("unsupported condition", e.line, e.col);
    }

    // ---- chain recognition & rewriting ----

    // Kind of the chain root found by the last ChainEntity call: "Q" select,
    // "I" insert, "U" update, "D" delete ("" when not a db chain).
    string chainKind;

    // Walks a fluent chain receiver down to a rewritten
    // `__DbBind.<K>_<T>(db)` root; returns the entity name ("" when not a db
    // chain) and sets chainKind to the root's letter.
    string ChainEntity(Node recv) {
        chainKind = "";
        while (recv != null && recv.kind == AK.Call()) {
            Node callee = recv.a;
            if (callee == null || callee.kind != AK.MemberAccess()) { return ""; }
            Node obj = callee.a;
            if (obj != null && obj.kind == AK.Ident() && obj.sval == "__DbBind"
                    && callee.sval.Length > 2 && callee.sval.Substring(1, 1) == "_") {
                string k = callee.sval.Substring(0, 1);
                if (k == "Q" || k == "I" || k == "U" || k == "D") {
                    chainKind = k;
                    return callee.sval.Substring(2, callee.sval.Length - 2);
                }
            }
            recv = obj;
        }
        return "";
    }

    // True when `call` is `<recv>.<Root><T>()` with a known entity class T:
    // Query/Select -> Q, Insert -> I (<=1 arg), Update -> U, Delete -> D,
    // SyncStructure[Async] -> CF. The captured type args live on the callee's
    // `b` slot ("__typeargs").
    bool IsDbRoot(Node call) {
        if (call.kind != AK.Call()) { return false; }
        Node callee = call.a;
        if (callee == null || callee.kind != AK.MemberAccess()) { return false; }
        string mn = callee.sval;
        int maxargs = 0;
        if (mn == "Query" || mn == "Select") { chainKind = "Q"; }
        else if (mn == "Insert") { chainKind = "I"; maxargs = 1; }
        else if (mn == "Update") { chainKind = "U"; }
        else if (mn == "Delete") { chainKind = "D"; }
        else if (mn == "SyncStructure" || mn == "SyncStructureAsync") { chainKind = "CF"; }
        else { return false; }
        Node targs = callee.b;
        if (targs == null || targs.kind != AK.TypeRef() || targs.sval != "__typeargs") { return false; }
        if (targs.kids.Count != 1 || call.kids.Count > maxargs) { return false; }
        Node targ = targs.kids[0];
        if (targ == null || targ.kind != AK.TypeRef() || targ.ival == 1 || targ.kids.Count > 0) { return false; }
        string tn = targ.sval;
        if (tn.IndexOf("[") >= 0 || tn.IndexOf("<") >= 0 || tn.IndexOf("?") >= 0) { return false; }
        return FindDecl(tn, AK.ClassDecl()) != null;
    }

    // `db.SyncStructureAll[Async]()` -> `__DbBind.SyncAll[Async](db)`; binds
    // every [Table] entity, in declaration order.
    bool IsSyncAllRoot(Node call) {
        if (call.kind != AK.Call()) { return false; }
        Node callee = call.a;
        if (callee == null || callee.kind != AK.MemberAccess()) { return false; }
        if (callee.sval != "SyncStructureAll" && callee.sval != "SyncStructureAllAsync") { return false; }
        Node targs = callee.b;
        if (targs != null && targs.kids.Count > 0) { return false; }
        return call.kids.Count == 0;
    }

    void RewriteSyncAllRoot(Node call) {
        Node callee = call.a;
        bool isAsync = callee.sval == "SyncStructureAllAsync";
        syncAll = true;
        any = true;
        int i = 0;
        while (i < unit.kids.Count) {
            Node d = unit.kids[i];
            i = i + 1;
            if (d.kind == AK.ClassDecl() && d.attrHasTable) { NeedAdd(d.sval); }
        }
        Node recv = callee.a;
        callee.a = NbIdent("__DbBind", call.line, call.col);
        callee.sval = isAsync ? "SyncAllAsync" : "SyncAll";
        callee.b = null;
        // `db.SyncStructureAll()` -> `__DbBind.SyncAll(db)`: the receiver
        // joins the rewritten call's arguments
        List<Node> saved = call.kids;
        call.kids = new List<Node>();
        call.Add(recv);
        int si = 0;
        while (si < saved.Count) { call.Add(saved[si]); si = si + 1; }
    }

    void RewriteDbRoot(Node call) {
        Node callee = call.a;
        string cls = callee.b.kids[0].sval;
        string kind = chainKind;
        string fact = kind == "CF" ? (callee.sval == "SyncStructureAsync" ? "CFA_" + cls : "CF_" + cls)
                                   : kind + "_" + cls;
        NeedAdd(cls);
        any = true;
        Node recv = callee.a;
        callee.a = NbIdent("__DbBind", call.line, call.col);
        callee.sval = fact;
        callee.b = null;
        // `db.I_T(args)` -> `__DbBind.I_T(db, args)`: the receiver joins the
        // rewritten call's arguments ahead of any original ones
        List<Node> saved = call.kids;
        call.kids = new List<Node>();
        call.Add(recv);
        int si = 0;
        while (si < saved.Count) { call.Add(saved[si]); si = si + 1; }
    }

    string BindMethod(int k) {
        if (k == 2) { return "Pi"; }
        if (k == 3) { return "Pd"; }
        if (k == 4) { return "InI"; }
        if (k == 5) { return "InS"; }
        if (k == 6) { return "InD"; }
        return "P";
    }

    void CopyInto(Node dst, Node src) {
        dst.kind = src.kind;
        dst.op = src.op;
        dst.ival = src.ival;
        dst.sval = src.sval;
        dst.sval2 = src.sval2;
        dst.a = src.a;
        dst.b = src.b;
        dst.c = src.c;
        dst.d = src.d;
        dst.type = src.type;
        dst.kids = src.kids;
        dst.mods = src.mods;
    }

    void RewriteWhere(Node call, string cls) {
        Node lambda = call.kids[0];
        if (lambda.kind != AK.Lambda() || LambdaParamCount(lambda) != 1) {
            diags.Error("db.Query<T>().Where expects a one-parameter lambda", call.line, call.col);
            return;
        }
        Node body = lambda.a;
        if (body == null) {
            diags.Error("Where lambda must be an expression (no block body)", call.line, call.col);
            return;
        }
        LoadFields(cls);
        wCls = cls;
        wLit = "";
        wExpr = null;
        wLine = call.line;
        wCol = call.col;
        wParam = LambdaParamName(lambda, 0);
        bindKinds = new List<int>();
        bindExprs = new List<Node>();
        wOk = true;
        WhereCond(body);
        if (!wOk) { return; }
        WfFlush();
        Node frag = wExpr;
        if (frag == null) { frag = NbStr("1 = 1", call.line, call.col); }

        Node recv = call.a.a;
        Node node = NbCall1(NbMember(recv, "W", call.line, call.col), frag, call.line, call.col);
        int i = 0;
        while (i < bindKinds.Count) {
            node = NbCall1(NbMember(node, BindMethod(bindKinds[i]), call.line, call.col), bindExprs[i], call.line, call.col);
            i = i + 1;
        }
        CopyInto(call, node);
    }

    // Field name named by an UpdateColumns lambda item: `a.title` (member on
    // the lambda parameter) or a bare field identifier inside `new { ... }`.
    string UpdColName(Node e) {
        if (e == null) { return ""; }
        if (e.kind == AK.Assignment() && e.a != null) { return UpdColName(e.a); }
        if (e.kind == AK.MemberAccess()) { return e.sval; }
        if (e.kind == AK.Ident()) { return e.sval; }
        return "";
    }

    // `UpdateColumns(a => a.title)` / `UpdateColumns(a => new { a.title,
    // a.clicks })` -> chained `Only("<col>")` calls naming the physical
    // columns; everything else on the entity stays untouched.
    void RewriteUpdateColumns(Node call, string cls) {
        if (call.kids.Count != 1 || call.kids[0].kind != AK.Lambda()) { return; }
        Node lambda = call.kids[0];
        LoadFields(cls);
        List<string> cols = new List<string>();
        Node body = lambda.a;
        if (body != null && body.kind == AK.NewExpr() && body.ival == 2) {
            int bi = 0;
            while (bi < body.kids.Count) {
                string nm = UpdColName(body.kids[bi]);
                if (nm == "") { return; }
                cols.Add(nm);
                bi = bi + 1;
            }
        } else {
            string nm = UpdColName(body);
            if (nm == "") { return; }
            cols.Add(nm);
        }
        if (cols.Count == 0) { return; }
        Node recv = call.a.a;
        Node node = NbMember(recv, "Only", call.line, call.col);
        int ci = 0;
        while (ci < cols.Count) {
            int fi = FieldFind(cols[ci]);
            string col = fi >= 0 ? DbColName(fi) : cols[ci];
            node = NbCall1(node, NbStr(col, call.line, call.col), call.line, call.col);
            if (ci + 1 < cols.Count) { node = NbMember(node, "Only", call.line, call.col); }
            ci = ci + 1;
        }
        CopyInto(call, node);
    }

    int LambdaParamCount(Node lam) {
        int n = 0;
        int i = 0;
        while (i < lam.kids.Count) {
            if (lam.kids[i].kind == AK.Param()) { n = n + 1; }
            i = i + 1;
        }
        return n;
    }

    string LambdaParamName(Node lam, int idx) {
        int n = 0;
        int i = 0;
        while (i < lam.kids.Count) {
            if (lam.kids[i].kind == AK.Param()) {
                if (n == idx) { return lam.kids[i].sval; }
                n = n + 1;
            }
            i = i + 1;
        }
        return "";
    }

    // The lambda body must be `p => p.<field>`; returns the field index.
    int LambdaFieldFind(Node call, string cls) {
        Node lambda = call.kids[0];
        if (lambda.kind != AK.Lambda() || LambdaParamCount(lambda) != 1) { return 0 - 1; }
        Node body = lambda.a;
        LoadFields(cls);
        if (body == null || body.kind != AK.MemberAccess()) { return 0 - 1; }
        if (body.a == null || body.a.kind != AK.Ident()) { return 0 - 1; }
        if (body.a.sval != LambdaParamName(lambda, 0)) { return 0 - 1; }
        return FieldFind(body.sval);
    }

    void RewriteOrderBy(Node call, string cls, bool desc) {
        if (call.kids.Count != 1 || call.kids[0].kind != AK.Lambda()) { return; }
        Node lambda = call.kids[0];
        LoadFields(cls);
        string pname = LambdaParamName(lambda, 0);
        Node body = lambda.a;
        // a.Key: the key SQL only the GroupBy rewrite knows, the runtime
        // replays it via OBK/OBDK
        if (body != null && body.kind == AK.MemberAccess() && body.sval == "Key"
                && body.a != null && body.a.kind == AK.Ident()
                && body.a.sval == pname) {
            call.a.sval = desc ? "OBDK" : "OBK";
            call.kids = new List<Node>();
            return;
        }
        // OrderByDescending(a => a.Sum(x => x.calls)): an aggregate of the
        // parameter sorts on the aggregate's SQL text (no binds, so the
        // fragment is a plain string)
        if (body != null && body.kind == AK.Call()) {
            string keep = wLit;
            int ak = 0;
            wParam = pname;
            wOk = true;
            string fn = AggCall(body, ref ak);
            string frag = wLit;
            wLit = keep;
            if (fn == "" || !wOk) {
                diags.Error("OrderBy expects p => p.<scalar field> or an aggregate of it", call.line, call.col);
                return;
            }
            Node arg = NbStr(frag, call.line, call.col);
            if (desc) { call.a.sval = "OBD"; } else { call.a.sval = "OB"; }
            call.kids = new List<Node>();
            call.Add(arg);
            return;
        }
        int col = LambdaFieldFind(call, cls);
        if (col < 0 || fKinds[col] == Dbgen.DfNav()) {
            diags.Error("OrderBy expects p => p.<scalar field>", call.line, call.col);
            return;
        }
        Node arg2 = NbStr("t." + DbColName(col), call.line, call.col);
        if (desc) { call.a.sval = "OBD"; } else { call.a.sval = "OB"; }
        call.kids = new List<Node>();
        call.Add(arg2);
    }

    void RewriteInclude(Node call, string cls) {
        int col = LambdaFieldFind(call, cls);
        if (col < 0 || fKinds[col] != Dbgen.DfNav()) {
            diags.Error("Include expects p => p.<navigation field>", call.line, call.col);
            return;
        }
        NeedAdd(fTypes[col]);
        call.a.sval = "Inc_" + fNames[col];
        call.kids = new List<Node>();
    }

    void RewriteHaving(Node call, string cls) {
        Node lambda = call.kids[0];
        if (lambda.kind != AK.Lambda() || LambdaParamCount(lambda) != 1) {
            diags.Error("db.Query<T>().Having expects a one-parameter lambda", call.line, call.col);
            return;
        }
        Node body = lambda.a;
        if (body == null) {
            diags.Error("Having lambda must be an expression (no block body)", call.line, call.col);
            return;
        }
        LoadFields(cls);
        wLit = "";
        wExpr = null;
        wLine = call.line;
        wCol = call.col;
        wParam = LambdaParamName(lambda, 0);
        bindKinds = new List<int>();
        bindExprs = new List<Node>();
        wOk = true;
        WhereCond(body);
        if (!wOk) { return; }
        WfFlush();
        Node frag = wExpr;
        if (frag == null) { return; }
        Node recv = call.a.a;
        Node node = NbCall1(NbMember(recv, "H", call.line, call.col), frag, call.line, call.col);
        int i = 0;
        while (i < bindKinds.Count) {
            node = NbCall1(NbMember(node, BindMethod(bindKinds[i]), call.line, call.col), bindExprs[i], call.line, call.col);
            i = i + 1;
        }
        CopyInto(call, node);
    }

    void RewriteGroupBy(Node call, string cls) {
        Node lambda = call.kids[0];
        string pname = "";
        if (lambda.kind == AK.Lambda() && LambdaParamCount(lambda) == 1) { pname = LambdaParamName(lambda, 0); }
        LoadFields(cls);
        Node body = lambda.a;
        string gb = "";
        if (body != null && body.kind == AK.NewExpr()) {
            // p => new { p.col1, p.col2, ... } -- multi-column grouping.
            int i = 0;
            while (i < body.kids.Count) {
                Node arg = body.kids[i];
                int ci = -1;
                if (arg.kind == AK.MemberAccess() && arg.a.kind == AK.Ident() && arg.a.sval == pname) {
                    ci = FieldFind(arg.sval);
                }
                if (ci < 0 || fKinds[ci] == Dbgen.DfNav()) {
                    diags.Error("GroupBy member must be p => p.<scalar field>", arg.line, arg.col);
                    return;
                }
                if (gb.Length > 0) { gb = gb + ", "; }
                gb = gb + "t." + DbColName(ci);
                i = i + 1;
            }
            if (gb.Length == 0) {
                diags.Error("GroupBy new { } must name at least one field", body.line, body.col);
                return;
            }
        } else {
            int col = FieldFind(body.sval);
            if (body == null || body.kind != AK.MemberAccess() || body.a == null
                || body.a.kind != AK.Ident() || body.a.sval != pname
                || col < 0 || fKinds[col] == Dbgen.DfNav()) {
                diags.Error("GroupBy expects p => p.<scalar field>", call.line, call.col);
                return;
            }
            gb = "t." + DbColName(col);
        }
        Node arg = NbStr(gb, call.line, call.col);
        call.a.sval = "GB";
        call.kids = new List<Node>();
        call.Add(arg);
    }

    void RewriteDistinct(Node call) {
        call.a.sval = "DISTINCT";
        call.kids = new List<Node>();
    }

    // `p => p.<field>` selector column; emits the diagnosis and -1 when the
    // lambda is not that shape.
    int SelColumn(Node call, Node lambda, string what) {
        if (LambdaParamCount(lambda) != 1) {
            diags.Error(what + " expects p => p.<scalar field>", call.line, call.col);
            return 0 - 1;
        }
        Node body = lambda.a;
        if (body == null || body.kind != AK.MemberAccess() || body.a == null
                || body.a.kind != AK.Ident()
                || body.a.sval != LambdaParamName(lambda, 0)) {
            diags.Error(what + " expects p => p.<scalar field>", call.line, call.col);
            return 0 - 1;
        }
        int col = FieldFind(body.sval);
        if (col < 0 || fKinds[col] == Dbgen.DfNav()) {
            diags.Error(what + " expects p => p.<scalar field>", call.line, call.col);
            return 0 - 1;
        }
        return col;
    }

    // `Sum/Avg/Max/Min(a => a.col)` terminal on a select chain: the column's
    // own type picks the reader (AVG is always double).
    void RewriteAgg(Node call, string cls, string fn) {
        if (call.kids.Count != 1 || call.kids[0].kind != AK.Lambda()) { return; }
        Node lambda = call.kids[0];
        LoadFields(cls);
        int col = SelColumn(call, lambda, fn);
        if (col < 0) { return; }
        if (fKinds[col] != Dbgen.DfInt() && fKinds[col] != Dbgen.DfDouble()) {
            diags.Error(fn + " requires an int or double column", call.line, call.col);
            return;
        }
        bool asInt = fKinds[col] == Dbgen.DfInt() && fn != "AVG";
        string m = asInt ? "AggI" : "AggD";
        if (asInt && Is64Ty(fTypes[col])) { m = "AggL"; }
        call.a.sval = m;
        call.kids = new List<Node>();
        call.Add(NbStr(fn + "(t." + DbColName(col) + ")", call.line, call.col));
    }

    // `Set(a => a.col, v)` / `SetIncr(a => a.col, v)` on an update chain:
    // the column kind picks the typed setter (enums cast to int, non-double
    // literals widen to double).
    void RewriteSet(Node call, string cls, bool incr) {
        if (call.kids.Count != 2 || call.kids[0].kind != AK.Lambda()) { return; }
        Node lambda = call.kids[0];
        LoadFields(cls);
        int col = SelColumn(call, lambda, incr ? "SetIncr" : "Set");
        if (col < 0) { return; }
        Node val = call.kids[1];
        int k = fKinds[col];
        string m = "";
        Node arg = val;
        if (k == Dbgen.DfInt()) {
            if (Is64Ty(fTypes[col])) { m = incr ? "SetIncrL" : "SetL"; }
            else { m = incr ? "SetIncrI" : "SetI"; }
        } else if (k == Dbgen.DfEnum()) {
            m = incr ? "SetIncrI" : "SetI";
            arg = NbCastInt(val);
        } else if (k == Dbgen.DfDouble()) {
            m = incr ? "SetIncrD" : "SetD";
            if (val.kind != AK.FloatLit()) { arg = NbCastDouble(val); }
        } else if (k == Dbgen.DfString()) {
            m = "SetS";
        } else if (k == Dbgen.DfBool()) {
            m = "SetB";
        }
        if (m == "" || (incr && (k == Dbgen.DfString() || k == Dbgen.DfBool()))) {
            diags.Error("unsupported column type for Set/SetIncr", call.line, call.col);
            return;
        }
        Node recv = call.a.a;
        Node node = NbCall1(NbMember(recv, m, call.line, call.col), NbStr(DbColName(col), call.line, call.col), call.line, call.col);
        node.Add(arg);
        CopyInto(call, node);
    }

    // Insert-chain conflict actions: SetIncr/SetMax/SetMin(a => a.col) ->
    // ACC/GMX/GMN (accumulate / keep the larger / keep the smaller on
    // conflict; the other columns take the new values).
    void RewriteUpsertSet(Node call, string cls, string what) {
        if (call.kids.Count != 1 || call.kids[0].kind != AK.Lambda()) { return; }
        Node lambda = call.kids[0];
        LoadFields(cls);
        int col = SelColumn(call, lambda, what);
        if (col < 0) { return; }
        if (fKinds[col] != Dbgen.DfInt() && fKinds[col] != Dbgen.DfDouble()) {
            diags.Error(what + " requires an int or double column", call.line, call.col);
            return;
        }
        string m = what == "SetIncr" ? "ACC" : what == "SetMax" ? "GMX" : "GMN";
        call.a.sval = m;
        call.kids = new List<Node>();
        call.Add(NbStr(DbColName(col), call.line, call.col));
    }

    // Insert-chain `OnConflict(a => a.col)` / `OnConflict(a => new { a.c1,
    // a.c2 })` -> one `.OC("col")` per key column. Without OnConflict the
    // conflict key defaults to the entity primary key (facade Keys()).
    void RewriteConflict(Node call, string cls) {
        if (call.kids.Count != 1 || call.kids[0].kind != AK.Lambda()) { return; }
        Node lambda = call.kids[0];
        if (LambdaParamCount(lambda) != 1) {
            diags.Error("OnConflict expects a => a.<key> or a => new { ... }", call.line, call.col);
            return;
        }
        string pname = LambdaParamName(lambda, 0);
        LoadFields(cls);
        Node body = lambda.a;
        List<Node> members = new List<Node>();
        if (body != null && body.kind == AK.NewExpr()) {
            int bi = 0;
            while (bi < body.kids.Count) { members.Add(body.kids[bi]); bi = bi + 1; }
        } else if (body != null) {
            members.Add(body);
        }
        if (members.Count == 0) {
            diags.Error("OnConflict must name at least one key column", body != null ? body.line : call.line, body != null ? body.col : call.col);
            return;
        }
        Node recv = call.a.a;
        Node node = null;
        int mi = 0;
        while (mi < members.Count) {
            Node m = members[mi];
            mi = mi + 1;
            int col = 0 - 1;
            if (m.kind == AK.MemberAccess() && m.a != null && m.a.kind == AK.Ident() && m.a.sval == pname) {
                col = FieldFind(m.sval);
            }
            if (col < 0 || fKinds[col] == Dbgen.DfNav()) {
                diags.Error("OnConflict key must be a => a.<scalar field>", m.line, m.col);
                return;
            }
            if (node == null) {
                node = NbMember(recv, "OC", call.line, call.col);
            } else {
                node = NbMember(node, "OC", call.line, call.col);
            }
            node = NbCall1(node, NbStr(DbColName(col), call.line, call.col), call.line, call.col);
        }
        CopyInto(call, node);
    }

    // IfExistsDoNothing() -> .NOP()
    void RewriteDoNothing(Node call) {
        call.a.sval = "NOP";
        call.kids = new List<Node>();
    }

    // `ToList(a => a.field)` -> .ToListCol("t.field") (async -> ToListColAsync).
    void RewriteToListCol(Node call, string cls, bool isAsync) {
        if (call.kids.Count != 1 || call.kids[0].kind != AK.Lambda()) { return; }
        Node lambda = call.kids[0];
        LoadFields(cls);
        int col = SelColumn(call, lambda, "ToList");
        if (col < 0) { return; }
        call.a.sval = isAsync ? "ToListColAsync" : "ToListCol";
        call.kids = new List<Node>();
        call.Add(NbStr("t." + DbColName(col), call.line, call.col));
    }

    // WhereIf(cond, p => ...): the fragment (and its parameters) only apply
    // when `cond` holds -- wrapped in CondBegin/CondEnd.
    void RewriteWhereIf(Node call, string cls) {
        if (call.kids.Count != 2) { return; }
        Node cond = call.kids[0];
        Node lambda = call.kids[1];
        if (lambda.kind != AK.Lambda() || LambdaParamCount(lambda) != 1) { return; }
        Node body = lambda.a;
        if (body == null) { return; }
        LoadFields(cls);
        wLit = "";
        wExpr = null;
        wLine = call.line;
        wCol = call.col;
        wParam = LambdaParamName(lambda, 0);
        bindKinds = new List<int>();
        bindExprs = new List<Node>();
        wOk = true;
        WhereCond(body);
        if (!wOk) { return; }
        WfFlush();
        Node frag = wExpr;
        if (frag == null) { frag = NbStr("1 = 1", call.line, call.col); }
        Node recv = call.a.a;
        Node node = NbCall1(NbMember(recv, "CondBegin", call.line, call.col), cond, call.line, call.col);
        node = NbCall1(NbMember(node, "W", call.line, call.col), frag, call.line, call.col);
        int i = 0;
        while (i < bindKinds.Count) {
            node = NbCall1(NbMember(node, BindMethod(bindKinds[i]), call.line, call.col), bindExprs[i], call.line, call.col);
            i = i + 1;
        }
        node = NbCall0(NbMember(node, "CondEnd", call.line, call.col), call.line, call.col);
        CopyInto(call, node);
    }

    // `ToList<T>(a => new T { f = a.col, g = a.Sum(x => x.col), ... })`:
    // group-aggregate projection. Columns and aggregates derive from the
    // entity's fields (no SQL in user code); the shape registers as Pj<N>
    // and the terminal call renames to the facade method of that name.
    // Terminals: ToList/ToListAsync/ToOne/ToOneAsync.
    void RewriteProj(Node call, string cls, string term) {
        Node targs = call.a.b;
        if (targs == null || targs.kind != AK.TypeRef() || targs.sval != "__typeargs"
                || targs.kids.Count != 1) { return; }
        string target = targs.kids[0].sval;
        if (call.kids.Count != 1 || call.kids[0].kind != AK.Lambda()) {
            diags.Error(term + "<T> expects a one-parameter lambda", call.line, call.col);
            return;
        }
        Node lambda = call.kids[0];
        Node body = lambda.a;
        if (body == null || body.kind != AK.NewExpr()) {
            diags.Error(term + "<T> expects a => new T { f = a.col, g = a.Sum(x => x.col), ... }", call.line, call.col);
            return;
        }
        if (LambdaParamCount(lambda) != 1) {
            diags.Error(term + "<T> expects a one-parameter lambda", call.line, call.col);
            return;
        }
        string pname = LambdaParamName(lambda, 0);
        if (FindDecl(target, AK.ClassDecl()) == null) {
            diags.Error(term + "<T>: unknown target type " + target, call.line, call.col);
            return;
        }
        LoadFields(target);
        List<string> tns = fNames;
        List<int> tks = fKinds;
        List<string> tts = fTypes;
        LoadFields(cls);
        string cols = "";
        string fields = "";
        string kinds = "";
        string i64s = "";
        string keyStrs = "";
        int n = 0;
        int bi = 0;
        while (bi < body.kids.Count) {
            Node mem = body.kids[bi];
            bi = bi + 1;
            Node src = mem;
            string tname = "";
            if (mem.kind == AK.Assignment()) {
                src = mem.b;
                if (mem.a != null && mem.a.kind == AK.Ident()) { tname = mem.a.sval; }
            } else if (mem.kind == AK.MemberAccess()) {
                tname = mem.sval;
            }
            if (tname == "") {
                diags.Error(term + "<T> member must be f = <column or aggregate>", mem.line, mem.col);
                return;
            }
            int tf = NameIn(tns, tname);
            if (tf < 0 || tks[tf] == Dbgen.DfNav()) {
                diags.Error(term + "<T>: " + target + " has no scalar field " + tname, mem.line, mem.col);
                return;
            }
            // a.Key.f: the group key itself; the facade splices the GroupBy
            // SQL at runtime via GroupKey()
            bool isKey = src != null && src.kind == AK.MemberAccess()
                && src.sval == "Key" && src.a != null
                && src.a.kind == AK.Ident() && src.a.sval == pname;
            string colsql = "";
            if (!isKey && src != null && src.kind == AK.Call()) {
                string keep = wLit;
                int ak = 0;
                wParam = pname;
                wOk = true;
                string fn = AggCall(src, ref ak);
                colsql = wLit;
                wLit = keep;
                if (fn == "" || !wOk) { return; }
                // SUM/MAX/MIN/AVG read NULL on empty windows and the target
                // field is numeric: empty groups must read 0, COUNT is
                // already 0
                if (!(colsql.Length >= 6 && colsql.Substring(0, 6) == "COUNT(")) { colsql = "COALESCE(" + colsql + ", 0)"; }
            }
            if (!isKey && colsql == "") {
                if (src == null || src.kind != AK.MemberAccess() || src.a == null
                        || src.a.kind != AK.Ident() || src.a.sval != pname) {
                    diags.Error(term + "<T> member must read a.<column> or an aggregate of it", mem.line, mem.col);
                    return;
                }
                int ci = FieldFind(src.sval);
                if (ci < 0 || fKinds[ci] == Dbgen.DfNav()) {
                    diags.Error(term + "<T> member must read a.<column> or an aggregate of it", mem.line, mem.col);
                    return;
                }
                colsql = "t." + DbColName(ci);
            }
            if (n > 0) {
                cols = cols + "|";
                fields = fields + "|";
                kinds = kinds + "|";
                i64s = i64s + "|";
                keyStrs = keyStrs + "|";
            }
            cols = cols + colsql;
            fields = fields + tname;
            kinds = kinds + Convert.ToString(GdKind(tks[tf]));
            i64s = i64s + DbBl(Is64Ty(tts[tf]));
            keyStrs = keyStrs + DbBl(isKey);
            n = n + 1;
        }
        if (n == 0) {
            diags.Error(term + "<T> must project at least one member", body.line, body.col);
            return;
        }
        string nm = "Pj" + Convert.ToString(pjEntity.Count);
        pjEntity.Add(cls);
        pjTarget.Add(target);
        pjName.Add(nm);
        pjCols.Add(cols);
        pjFields.Add(fields);
        pjKinds.Add(kinds);
        pjI64.Add(i64s);
        pjKeys.Add(keyStrs);
        bool one = term == "ToOne" || term == "ToOneAsync";
        bool isAsync = term == "ToListAsync" || term == "ToOneAsync";
        call.a.sval = nm + (one ? "One" : "") + (isAsync ? "Async" : "");
        call.a.b = null;
        call.kids = new List<Node>();
    }

    int NameIn(List<string> l, string name) {
        int i = 0;
        while (i < l.Count) {
            if (l[i] == name) { return i; }
            i = i + 1;
        }
        return 0 - 1;
    }

    List<string> Split1(string enc) {
        List<string> outp = new List<string>();
        if (enc == null) { return outp; }
        string cur = "";
        int i = 0;
        while (i < enc.Length) {
            if (enc.Substring(i, 1) == "|") {
                outp.Add(cur);
                cur = "";
            } else {
                cur = cur + enc.Substring(i, 1);
            }
            i = i + 1;
        }
        outp.Add(cur);
        return outp;
    }

    // __DbBind.<fact>(conn, args...) call for an accessor or db root.
    void RewriteBindRoot(Node call, string fact, Node conn) {
        call.a = NbMember(NbIdent("__DbBind", call.line, call.col), fact, call.line, call.col);
        List<Node> saved = call.kids;
        call.kids = new List<Node>();
        call.Add(conn);
        int i = 0;
        while (i < saved.Count) { call.Add(saved[i]); i = i + 1; }
        any = true;
    }

    // `<recv>.<Entity>.Method(...)` on a [Table] entity: accessor roots.
    // Insert -> I_<E>(conn, ...), Update/Delete -> U_/D_<E>(conn),
    // Read/ById -> Q_<E>(conn).W("t.<pk> = ?").P_x(arg).FirstAsync(),
    // chain heads -> Q_<E>(conn) and the normal chain dispatch takes over.
    // Returns true when the call was consumed.
    bool RewriteAccRoot(Node call, Node accMem) {
        string cls = accMem.sval;
        string name = call.a.sval;
        int nargs = call.kids.Count;
        Node conn = null;
        if (accMem.a != null && accMem.a.kind == AK.Ident()
                && (accMem.a.sval == "db" || accMem.a.sval == "conn" || accMem.a.sval == "connection"
                    || accMem.a.sval == "tx" || accMem.a.sval == "zsql" || accMem.a.sval == "zanSql"
                    || accMem.a.sval == "fsql" || accMem.a.sval == "freeSql"
                    || accMem.a.sval == "executor")) {
            conn = accMem.a;
        } else {
            conn = NbCall0(NbMember(accMem.a, "__Conn", call.line, call.col), call.line, call.col);
        }
        if (name == "Insert" && nargs <= 1) {
            RewriteBindRoot(call, "I_" + cls, conn);
            NeedAdd(cls);
            return true;
        }
        if ((name == "Update" || name == "Delete") && nargs == 0) {
            RewriteBindRoot(call, (name == "Update" ? "U_" : "D_") + cls, conn);
            NeedAdd(cls);
            return true;
        }
        if ((name == "Read" || name == "ReadAsync" || name == "ById" || name == "ByIdAsync") && nargs == 1) {
            LoadFields(cls);
            int pk = 0 - 1;
            int i = 0;
            while (i < dbfIdent.Count) {
                if (dbfIdent[i]) { pk = i; }
                i = i + 1;
            }
            if (pk < 0) {
                diags.Error("ById() needs an identity column on the entity", call.line, call.col);
                return true;
            }
            int k = fKinds[pk];
            string bm = k == Dbgen.DfInt() ? (Is64Ty(fTypes[pk]) ? "Pl" : "Pi")
                      : k == Dbgen.DfDouble() ? "Pd" : "P";
            Node q = NbCall1(NbMember(NbIdent("__DbBind", call.line, call.col), "Q_" + cls, call.line, call.col), conn, call.line, call.col);
            Node node = NbCall1(NbMember(q, "W", call.line, call.col), NbStr("t." + DbColName(pk) + " = ?", call.line, call.col), call.line, call.col);
            node = NbCall1(NbMember(node, bm, call.line, call.col), call.kids[0], call.line, call.col);
            node = NbCall0(NbMember(node, "FirstAsync", call.line, call.col), call.line, call.col);
            CopyInto(call, node);
            NeedAdd(cls);
            any = true;
            return true;
        }
        // chain head: swap `<recv>.<Entity>` for a Q_<E>(conn) root and let
        // the chain dispatch below handle the method
        if (name == "Where" || name == "WhereIf" || name == "OrderBy"
                || name == "OrderByDescending" || name == "Include"
                || name == "GroupBy" || name == "Distinct" || name == "Skip"
                || name == "Take" || name == "Limit" || name == "Page"
                || name == "Count" || name == "CountAsync" || name == "Any"
                || name == "AnyAsync" || name == "First" || name == "FirstAsync"
                || name == "FirstOrDefault" || name == "FirstOrDefaultAsync"
                || name == "ToOne" || name == "ToOneAsync" || name == "ToList"
                || name == "ToListAsync" || name == "Sum" || name == "Avg"
                || name == "Max" || name == "Min") {
            Node qroot = NbCall1(NbMember(NbIdent("__DbBind", call.line, call.col), "Q_" + cls, call.line, call.col), conn, call.line, call.col);
            CopyInto(accMem, qroot);
            NeedAdd(cls);
            any = true;
            return false;
        }
        string daoName = cls + "Dao";
        Node daoDecl = FindDecl(daoName, AK.ClassDecl());
        string targetCls = daoName;
        if (daoDecl != null && daoDecl.nsName != null && daoDecl.nsName.Length > 0) {
            targetCls = daoDecl.nsName + "." + daoName;
        }
        Node n = new Node(AK.NewExpr());
        n.line = call.line; n.col = call.col;
        n.type = new Node(AK.TypeRef());
        n.type.sval = targetCls;
        n.type.line = call.line; n.type.col = call.col;
        n.Add(conn);
        CopyInto(accMem, n);
        NeedDao(daoName);
        any = true;
        return false;
    }

    // ---- AST walk ----

    void VisitCall(Node e) {
        // children first: the Query<T>() root is rewritten before the chain
        // methods above it look for it
        Visit(e.a);
        int ai = 0;
        while (ai < e.kids.Count) { Visit(e.kids[ai]); ai = ai + 1; }

        if (IsDbRoot(e)) {
            RewriteDbRoot(e);
            return;
        }
        if (IsSyncAllRoot(e)) {
            RewriteSyncAllRoot(e);
            return;
        }
        Node callee = e.a;
        if (callee == null || callee.kind != AK.MemberAccess()) { return; }
        // accessor roots run before chain recognition: `<recv>.<Entity>`
        // names a [Table] class, the connection comes from recv.__Conn()
        if (callee.a != null && callee.a.kind == AK.MemberAccess()
                && callee.a.a != null && IsTableEntity(callee.a.sval)) {
            if (RewriteAccRoot(e, callee.a)) { return; }
        }
        string mn = callee.sval;
        bool isWhere = mn == "Where";
        bool isOb = mn == "OrderBy";
        bool isObd = mn == "OrderByDescending";
        bool isInc = mn == "Include";
        bool isGroupBy = mn == "GroupBy";
        bool isHaving = mn == "Having";
        bool isDistinct = mn == "Distinct";
        bool isUpdCols = mn == "UpdateColumns" || mn == "InsertColumns";
        bool isWhereIf = mn == "WhereIf";
        bool isSet = mn == "Set";
        bool isIncr = mn == "SetIncr";
        bool isIfNop = mn == "IfExistsDoNothing";
        bool isConflict = mn == "OnConflict";
        // ToList<T>(...) with a type argument: group-aggregate projection
        bool isTerm = (mn == "ToList" || mn == "ToListAsync" || mn == "ToOne"
            || mn == "ToOneAsync") && callee.b != null
            && callee.b.kind == AK.TypeRef() && callee.b.sval == "__typeargs"
            && callee.b.kids.Count == 1;
        // ToList(a => a.field) with no type argument: single-column projection
        bool isListCol = (mn == "ToList" || mn == "ToListAsync") && !isTerm
            && e.kids.Count == 1;
        string agg = mn == "Sum" ? "SUM" : mn == "Avg" ? "AVG"
            : mn == "Max" ? "MAX" : mn == "Min" ? "MIN" : "";
        if (!isWhere && !isOb && !isObd && !isInc && !isGroupBy
            && !isHaving && !isDistinct && !isUpdCols && !isWhereIf
            && !isSet && !isIncr && !isIfNop && !isTerm && !isListCol
            && !isConflict
            && agg == "" && mn != "SetMax" && mn != "SetMin") { return; }
        string entity = ChainEntity(callee.a);
        if (entity == "") { return; }
        // chain surface per root kind: where-fragments on Q/U/D (the insert
        // facade has no WHERE), nav/order/group shapes only on Q
        if (isUpdCols) {
            if (chainKind != "U" && chainKind != "I") { return; }
            RewriteUpdateColumns(e, entity);
            return;
        }
        if (isIfNop) {
            if (chainKind != "I" || e.kids.Count != 0) { return; }
            RewriteDoNothing(e);
            return;
        }
        if ((isSet || isIncr) && chainKind == "U") {
            if (e.kids.Count != 2) { return; }
            RewriteSet(e, entity, isIncr);
            return;
        }
        // insert-chain conflict actions (SetIncr here reached only on I;
        // the U-chain case returned above)
        if (mn == "SetIncr" || mn == "SetMax" || mn == "SetMin") {
            if (chainKind != "I" || e.kids.Count != 1) { return; }
            RewriteUpsertSet(e, entity, mn);
            return;
        }
        if (isConflict) {
            if (chainKind != "I" || e.kids.Count != 1) { return; }
            RewriteConflict(e, entity);
            return;
        }
        if (chainKind == "Q") {
            if (isDistinct) {
                if (e.kids.Count == 0) { RewriteDistinct(e); }
                return;
            }
            if (isWhereIf) {
                if (e.kids.Count == 2) { RewriteWhereIf(e, entity); }
                return;
            }
            if (agg != "") {
                if (e.kids.Count == 1 && e.kids[0].kind == AK.Lambda()) { RewriteAgg(e, entity, agg); }
                return;
            }
            if (isTerm) {
                RewriteProj(e, entity, mn);
                return;
            }
            if (isListCol) {
                RewriteToListCol(e, entity, mn == "ToListAsync");
                return;
            }
            if (e.kids.Count != 1 || e.kids[0].kind != AK.Lambda()) { return; }
            if (isWhere) { RewriteWhere(e, entity); }
            else if (isInc) { RewriteInclude(e, entity); }
            else if (isGroupBy) { RewriteGroupBy(e, entity); }
            else if (isHaving) { RewriteHaving(e, entity); }
            else { RewriteOrderBy(e, entity, isObd); }
            return;
        }
        if ((chainKind == "U" || chainKind == "D") && isWhere) {
            if (e.kids.Count != 1 || e.kids[0].kind != AK.Lambda()) { return; }
            RewriteWhere(e, entity);
        }
    }

    void Visit(Node n) {
        if (n == null) { return; }
        if (n.kind == AK.Call()) { VisitCall(n); return; }
        Visit(n.a);
        Visit(n.b);
        Visit(n.c);
        Visit(n.d);
        int i = 0;
        while (i < n.kids.Count) { Visit(n.kids[i]); i = i + 1; }
    }

    // ---- per-entity code generation ----

    string Getter(int k) {
        if (k == Dbgen.DfInt() || k == Dbgen.DfEnum()) { return "GetInt"; }
        if (k == Dbgen.DfDouble()) { return "GetDouble"; }
        if (k == Dbgen.DfBool()) { return "GetBool"; }
        return "GetString";
    }

    // GenDb column kind (0 int, 1 double, 2 bool, 3 string, 4 enum, 5 nav)
    // from the internal Df* classification.
    int GdKind(int dfk) {
        if (dfk == Dbgen.DfInt()) { return 0; }
        if (dfk == Dbgen.DfDouble()) { return 1; }
        if (dfk == Dbgen.DfBool()) { return 2; }
        if (dfk == Dbgen.DfString()) { return 3; }
        if (dfk == Dbgen.DfEnum()) { return 4; }
        return 5;
    }

    // Row getter for a loaded field: 64-bit integers read via GetLong.
    string DbGetter(int fi) {
        int k = fKinds[fi];
        if (k == Dbgen.DfInt() && Is64Ty(fTypes[fi])) { return "GetLong"; }
        if (k == Dbgen.DfInt() || k == Dbgen.DfEnum()) { return "GetInt"; }
        if (k == Dbgen.DfDouble()) { return "GetDouble"; }
        if (k == Dbgen.DfBool()) { return "GetBool"; }
        return "GetString";
    }

    // `m.Col(...)` argument text for the i-th loaded field.
    string ColArgs(int fi) {
        return "\"" + dbfCol[fi] + "\", \"" + fNames[fi] + "\", "
            + Convert.ToString(GdKind(fKinds[fi])) + ", "
            + DbBl(Is64Ty(fTypes[fi])) + ", " + DbBl(dbfPk[fi]) + ", "
            + DbBl(dbfIdent[fi]) + ", " + DbBl(dbfNotNull[fi]) + ", "
            + Convert.ToString(dbfStrLen[fi]);
    }

    // __DbM_<E> (per-column Read/Bind dispatch) + __DbB_<E> (IOrmRows row
    // source). Nav fields never participate in column binding.
    string GenAccess(string cls) {
        Node decl = FindDecl(cls, AK.ClassDecl());
        if (decl == null) { return ""; }
        LoadFields(cls);
        List<string> ns = fNames;
        List<int> ks = fKinds;
        List<string> ts = fTypes;
        List<string> cs = dbfCol;
        string s = "class __DbM_" + cls + " {\n";
        s = s + "    static " + cls + " Read(List<OrmCol> cols, DbResult r, int row, int at0) {\n";
        s = s + "        " + cls + " o = new " + cls + "();\n";
        s = s + "        for (int i = 0; i < cols.Count; i = i + 1) {\n";
        s = s + "            OrmCol c = cols[i];\n";
        s = s + "            int at = at0 + i;\n";
        int i = 0;
        while (i < ks.Count) {
            if (ks[i] != Dbgen.DfNav()) {
                s = s + "            if (c.Field == \"" + ns[i] + "\") { o." + ns[i]
                    + " = r." + DbGetter(i) + "(row, at); continue; }\n";
            }
            i = i + 1;
        }
        s = s + "        }\n        return o;\n    }\n";
        s = s + "    static void Bind(" + cls + " o, OrmCol c, DbParams ps) {\n";
        i = 0;
        while (i < ks.Count) {
            if (ks[i] != Dbgen.DfNav()) {
                s = s + "        if (c.Field == \"" + ns[i] + "\") {\n";
                if (ks[i] == Dbgen.DfInt()) {
                    s = s + "            ps." + (Is64Ty(ts[i]) ? "AddLong" : "AddInt") + "(o." + ns[i] + ");\n";
                } else if (ks[i] == Dbgen.DfEnum()) {
                    s = s + "            int ev = o." + ns[i] + ";\n            ps.AddInt(ev);\n";
                } else if (ks[i] == Dbgen.DfDouble()) {
                    s = s + "            ps.AddDouble(o." + ns[i] + ");\n";
                } else if (ks[i] == Dbgen.DfBool()) {
                    s = s + "            if (o." + ns[i] + ") { ps.AddInt(1); } else { ps.AddInt(0); }\n";
                } else {
                    s = s + "            ps.Add(o." + ns[i] + ");\n";
                }
                s = s + "            return;\n        }\n";
            }
            i = i + 1;
        }
        s = s + "    }\n}\n";
        s = s + "class __DbB_" + cls + " : IOrmRows {\n";
        s = s + "    List<" + cls + "> items;\n";
        s = s + "    static __DbB_" + cls + " New() {\n";
        s = s + "        __DbB_" + cls + " b = new __DbB_" + cls + "();\n";
        s = s + "        b.items = new List<" + cls + ">();\n        return b;\n    }\n";
        s = s + "    void Add(" + cls + " o) { this.items.Add(o); }\n";
        s = s + "    int RowCount() { return this.items.Count; }\n";
        s = s + "    void BindCol(int row, OrmCol c, DbParams ps) {\n";
        s = s + "        __DbM_" + cls + ".Bind(this.items[row], c, ps);\n";
        s = s + "    }\n}\n";
        return s;
    }

    // `m.Index(name, cols, unique)` argument lines from [Index] attributes
    // ("name|fields|unique"); field names resolve to physical columns.
    List<string> IndexArgs(string cls, string tbl) {
        List<string> outl = new List<string>();
        Node decl = FindDecl(cls, AK.ClassDecl());
        if (decl == null || decl.attrIndexes == null) { return outl; }
        int i = 0;
        while (i < decl.attrIndexes.Count) {
            string enc = decl.attrIndexes[i];
            // decode "name|fields|unique"
            int p1 = enc.IndexOf("|");
            int p2 = p1 >= 0 ? enc.IndexOf("|", p1 + 1) : 0 - 1;
            string nm = p1 > 0 ? enc.Substring(0, p1) : "";
            string fields = (p1 >= 0 && p2 > p1) ? enc.Substring(p1 + 1, p2 - p1 - 1) : "";
            string uniq = (p2 >= 0 && enc.Length > p2 + 1) ? enc.Substring(p2 + 1, enc.Length - p2 - 1) : "false";
            string cols = "";
            int n = 0;
            int k = 0;
            string seg = "";
            while (k <= fields.Length) {
                string ch = k < fields.Length ? fields.Substring(k, 1) : ",";
                if (ch == ",") {
                    if (seg.Length > 0) {
                        int fi = FieldFind(seg);
                        if (fi < 0) { return new List<string>(); }
                        if (n > 0) { cols = cols + ", "; }
                        cols = cols + DbColName(fi);
                        n = n + 1;
                        seg = "";
                    }
                } else {
                    seg = seg + ch;
                }
                k = k + 1;
            }
            if (n == 0) { return new List<string>(); }
            if (nm.Length == 0) { nm = "ix_" + tbl + "_" + Convert.ToString(i + 1); }
            outl.Add("\"" + nm + "\", \"" + cols + "\", " + uniq);
            i = i + 1;
        }
        return outl;
    }

    // <E>Cols: table + column constants + OrmMeta builder.
    string GenCols(string cls) {
        Node decl = FindDecl(cls, AK.ClassDecl());
        if (decl == null) { return ""; }
        LoadFields(cls);
        List<string> ns = fNames;
        List<string> ts = fTypes;
        List<int> ks = fKinds;
        List<string> cs = dbfCol;
        string tbl = TableOf(cls);
        bool hasTableField = FieldFind("Table") >= 0;
        string s = "class " + cls + "Cols {\n";
        if (!hasTableField) {
            s = s + "    static string Table = \"" + tbl + "\";\n";
        }
        int i = 0;
        while (i < ks.Count) {
            if (ks[i] != Dbgen.DfNav()) {
                s = s + "    static string " + ns[i] + " = \"" + cs[i] + "\";\n";
            }
            i = i + 1;
        }
        s = s + "    static OrmMeta __M;\n";
        s = s + "    static List<int> __MGuard = new List<int>();\n";
        s = s + "    static OrmMeta __Meta() {\n";
        s = s + "        if (" + cls + "Cols.__M != null) { return " + cls + "Cols.__M; }\n";
        s = s + "        lock (" + cls + "Cols.__MGuard) {\n";
        s = s + "            if (" + cls + "Cols.__M != null) { return " + cls + "Cols.__M; }\n";
        s = s + "        OrmMeta m = OrmMeta.Of(\"" + cls + "\", \"" + tbl + "\");\n";
        i = 0;
        while (i < ks.Count) {
            if (ks[i] != Dbgen.DfNav()) {
                s = s + "        m.Col(" + ColArgs(i) + ");\n";
            }
            i = i + 1;
        }
        // index lines computed while the entity's own fields are still the
        // loaded set (FieldFind runs against them)
        List<string> ixs = IndexArgs(cls, tbl);
        int nv = 0;
        i = 0;
        while (i < ks.Count) {
            if (ks[i] == Dbgen.DfNav()) {
                string v = "n" + Convert.ToString(nv);
                s = s + "        OrmNav " + v + " = m.Nav(\"" + ns[i] + "\", \"" + TableOf(ts[i]) + "\");\n";
                LoadFields(ts[i]);
                int k = 0;
                while (k < fKinds.Count) {
                    if (fKinds[k] != Dbgen.DfNav()) {
                        s = s + "        " + v + ".Col(\"" + dbfCol[k] + "\", \"" + fNames[k] + "\", "
                            + Convert.ToString(GdKind(fKinds[k])) + ", " + DbBl(Is64Ty(fTypes[k])) + ");\n";
                    }
                    k = k + 1;
                }
                nv = nv + 1;
            }
            i = i + 1;
        }
        i = 0;
        while (i < ixs.Count) {
            s = s + "        m.Index(" + ixs[i] + ");\n";
            i = i + 1;
        }
        s = s + "        m.Seal();\n";
        s = s + "        m.SelectList();\n";
        s = s + "        " + cls + "Cols.__M = m;\n";
        s = s + "        return " + cls + "Cols.__M;\n";
        s = s + "        }\n    }\n";
        s = s + "    static bool Has(string c) { return " + cls + "Cols.__Meta().Has(c); }\n";
        s = s + "    static int Kind(string c) { return " + cls + "Cols.__Meta().KindOf(c); }\n";
        s = s + "    static string Require(string c) { return " + cls + "Cols.__Meta().Require(c); }\n";
        s = s + "}\n";
        return s;
    }

    // Reverse relations (parent -> child): fetch the children of a parent
    // row. The relation is *derived* from the child's navigation
    // declaration (foreign key column = <nav field>Id -- the same
    // convention as OrmNav.Join's ON clause), so callers never spell the
    // foreign key column by hand. Entities without a navigation have no
    // reverse relation, so they get none of these methods.
    //
    // Mirrors GenDbEmit.GenChildren in the host compiler.
    static string GenChildren(string cls, string q) {
        string s = "";
        s = s + "    List<" + cls + "> Children(long parentId) {\n";
        s = s + "        OrmRel rel = OrmRel.Derive(this.q.Meta(), \"\");\n";
        s = s + "        if (rel == null) { return new List<" + cls + ">(); }\n";
        s = s + "        rel.Apply(this.q, parentId);\n";
        s = s + "        return this.ToList();\n";
        s = s + "    }\n";
        s = s + "    List<" + cls + "> Children(string parentId) {\n";
        s = s + "        OrmRel rel = OrmRel.Derive(this.q.Meta(), \"\");\n";
        s = s + "        if (rel == null) { return new List<" + cls + ">(); }\n";
        s = s + "        rel.Apply(this.q, parentId);\n";
        s = s + "        return this.ToList();\n";
        s = s + "    }\n";
        s = s + "    List<" + cls + "> ChildrenOf(string parentTable, long parentId) {\n";
        s = s + "        OrmRel rel = OrmRel.Derive(this.q.Meta(), parentTable);\n";
        s = s + "        if (rel == null) { return new List<" + cls + ">(); }\n";
        s = s + "        rel.Apply(this.q, parentId);\n";
        s = s + "        return this.ToList();\n";
        s = s + "    }\n";
        s = s + "    List<" + cls + "> ChildrenOf(string parentTable, string parentId) {\n";
        s = s + "        OrmRel rel = OrmRel.Derive(this.q.Meta(), parentTable);\n";
        s = s + "        if (rel == null) { return new List<" + cls + ">(); }\n";
        s = s + "        rel.Apply(this.q, parentId);\n";
        s = s + "        return this.ToList();\n";
        s = s + "    }\n";
        s = s + "    async List<" + cls + "> ChildrenAsync(long parentId) {\n";
        s = s + "        OrmRel rel = OrmRel.Derive(this.q.Meta(), \"\");\n";
        s = s + "        if (rel == null) { return new List<" + cls + ">(); }\n";
        s = s + "        rel.Apply(this.q, parentId);\n";
        s = s + "        return await this.ToListAsync();\n";
        s = s + "    }\n";
        s = s + "    async List<" + cls + "> ChildrenAsync(string parentId) {\n";
        s = s + "        OrmRel rel = OrmRel.Derive(this.q.Meta(), \"\");\n";
        s = s + "        if (rel == null) { return new List<" + cls + ">(); }\n";
        s = s + "        rel.Apply(this.q, parentId);\n";
        s = s + "        return await this.ToListAsync();\n";
        s = s + "    }\n";
        s = s + "    async List<" + cls + "> ChildrenOfAsync(string parentTable, long parentId) {\n";
        s = s + "        OrmRel rel = OrmRel.Derive(this.q.Meta(), parentTable);\n";
        s = s + "        if (rel == null) { return new List<" + cls + ">(); }\n";
        s = s + "        rel.Apply(this.q, parentId);\n";
        s = s + "        return await this.ToListAsync();\n";
        s = s + "    }\n";
        s = s + "    async List<" + cls + "> ChildrenOfAsync(string parentTable, string parentId) {\n";
        s = s + "        OrmRel rel = OrmRel.Derive(this.q.Meta(), parentTable);\n";
        s = s + "        if (rel == null) { return new List<" + cls + ">(); }\n";
        s = s + "        rel.Apply(this.q, parentId);\n";
        s = s + "        return await this.ToListAsync();\n";
        s = s + "    }\n";
        return s;
    }

    // Query facade __DbQ_<E>: chained methods forward to OrmSelect; only the
    // row mapping and terminals know the entity type.
    string GenQ(string cls) {
        Node decl = FindDecl(cls, AK.ClassDecl());
        if (decl == null) { return ""; }
        LoadFields(cls);
        List<string> ns = fNames;
        List<int> ks = fKinds;
        List<string> ts = fTypes;
        string q = "__DbQ_" + cls;
        string s = "class " + q + " {\n";
        s = s + "    OrmSelect q;\n";
        s = s + "    static " + q + " Create(IDbExecutor db) {\n";
        s = s + "        " + q + " r = new " + q + "();\n";
        s = s + "        r.q = OrmSelect.Create(db, " + cls + "Cols.__Meta());\n";
        s = s + "        return r;\n    }\n";
        s = s + "    " + q + " W(string f) { this.q.W(f); return this; }\n";
        s = s + "    " + q + " Where(Expr<" + cls + "> e) {\n";
        s = s + "        if (e == null) { return this; }\n";
        s = s + "        this.q.WExpr(e.Root);\n";
        s = s + "        return this;\n    }\n";
        s = s + "    " + q + " WhereDict(DbValues v) { this.q.WhereDict(v); return this; }\n";
        s = s + "    " + q + " WhereConds(List<OrmCond> cs) { this.q.WhereConds(cs); return this; }\n";
        s = s + "    " + q + " CondBegin(bool c) { this.q.CondBegin(c); return this; }\n";
        s = s + "    " + q + " CondEnd() { this.q.CondEnd(); return this; }\n";
        s = s + "    " + q + " AsTable(string t) { this.q.AsTable(t); return this; }\n";
        s = s + "    " + q + " P(string v) { this.q.P(v); return this; }\n";
        s = s + "    " + q + " Pi(int v) { this.q.Pi(v); return this; }\n";
        s = s + "    " + q + " Pl(long v) { this.q.Pl(v); return this; }\n";
        s = s + "    " + q + " Pd(double v) { this.q.Pd(v); return this; }\n";
        s = s + "    " + q + " InI(List<int> vs) { this.q.InI(vs); return this; }\n";
        s = s + "    " + q + " InL(List<long> vs) { this.q.InL(vs); return this; }\n";
        s = s + "    " + q + " InS(List<string> vs) { this.q.InS(vs); return this; }\n";
        s = s + "    " + q + " InD(List<double> vs) { this.q.InD(vs); return this; }\n";
        s = s + "    " + q + " OB(string col) { this.q.OB(col); return this; }\n";
        s = s + "    " + q + " OBD(string col) { this.q.OBD(col); return this; }\n";
        s = s + "    " + q + " GB(string col) { this.q.GB(col); return this; }\n";
        s = s + "    " + q + " OBK() { this.q.OBK(); return this; }\n";
        s = s + "    " + q + " OBDK() { this.q.OBDK(); return this; }\n";
        s = s + "    " + q + " H(string f) { this.q.H(f); return this; }\n";
        s = s + "    " + q + " DISTINCT() { this.q.DISTINCT(); return this; }\n";
        s = s + "    " + q + " Take(int n) { this.q.Take(n); return this; }\n";
        s = s + "    " + q + " Skip(int n) { this.q.SkipN(n); return this; }\n";
        s = s + "    " + q + " Limit(int n) { this.q.Take(n); return this; }\n";
        s = s + "    " + q + " Offset(int n) { this.q.SkipN(n); return this; }\n";
        s = s + "    " + q + " Page(int index, int size) { this.q.Page(index, size); return this; }\n";
        int nv = 0;
        int i = 0;
        while (i < ks.Count) {
            if (ks[i] == Dbgen.DfNav()) {
                s = s + "    " + q + " Inc_" + ns[i] + "() { this.q.Include(" + Convert.ToString(nv) + "); return this; }\n";
                nv = nv + 1;
            }
            i = i + 1;
        }
        /* 反向关系(父 -> 子):按父行 id 取子集合。关系由子实体的导航声明
         * **反推**(外键列 = <导航字段名>Id,与 OrmNav.Join 的 ON 子句同一
         * 约定),所以调用方不用手写外键列名。没有导航的实体没有反向
         * 关系,也就没有这些方法。 */
        if (nv > 0) {
            s = s + Dbgen.GenChildren(cls, q);
        }
        s = s + "    List<" + cls + "> MapRows(DbResult r) {\n";
        s = s + "        List<" + cls + "> outp = new List<" + cls + ">();\n";
        s = s + "        OrmMeta m = " + cls + "Cols.__Meta();\n";
        s = s + "        int row = 0;\n";
        s = s + "        while (row < r.RowCount()) {\n";
        s = s + "            " + cls + " o = __DbM_" + cls + ".Read(m.Cols, r, row, 0);\n";
        nv = 0;
        i = 0;
        while (i < ks.Count) {
            if (ks[i] == Dbgen.DfNav()) {
                string ix = Convert.ToString(nv);
                s = s + "            if (this.q.NavOn(" + ix + ")) {\n";
                s = s + "                OrmNav nav" + ix + " = m.Navs[" + ix + "];\n";
                s = s + "                int at" + ix + " = this.q.NavAt(" + ix + ");\n";
                s = s + "                if (!r.IsNull(row, at" + ix + " + nav" + ix + ".PkAt)) {\n";
                s = s + "                    o." + ns[i] + " = __DbM_" + ts[i] + ".Read(nav" + ix + ".Cols, r, row, at" + ix + ");\n";
                s = s + "                }\n            }\n";
                nv = nv + 1;
            }
            i = i + 1;
        }
        s = s + "            outp.Add(o);\n";
        s = s + "            row = row + 1;\n";
        s = s + "        }\n";
        s = s + "        return outp;\n    }\n";
        s = s + "    List<" + cls + "> ToList() { return MapRows(this.q.Rows()); }\n";
        s = s + "    async List<" + cls + "> ToListAsync() {\n";
        s = s + "        DbResult r = await this.q.RowsAsync();\n";
        s = s + "        return MapRows(r);\n    }\n";
        s = s + "    List<string> ToListCol(string col) { return this.q.ToListCol(col); }\n";
        s = s + "    async List<string> ToListColAsync(string col) {\n";
        s = s + "        return await this.q.ToListColAsync(col);\n    }\n";
        s = s + EmitProjs(cls);
        s = s + "    " + cls + " First() {\n";
        s = s + "        this.q.One();\n";
        s = s + "        List<" + cls + "> l = ToList();\n";
        s = s + "        if (l.Count > 0) { return l[0]; }\n";
        s = s + "        return null;\n    }\n";
        s = s + "    " + cls + " FirstOrDefault() { return First(); }\n";
        s = s + "    " + cls + " ToOne() { return First(); }\n";
        s = s + "    async " + cls + " FirstAsync() {\n";
        s = s + "        this.q.One();\n";
        s = s + "        List<" + cls + "> l = await ToListAsync();\n";
        s = s + "        if (l.Count > 0) { return l[0]; }\n";
        s = s + "        return null;\n    }\n";
        s = s + "    async " + cls + " FirstOrDefaultAsync() { return await FirstAsync(); }\n";
        s = s + "    async " + cls + " ToOneAsync() { return await FirstAsync(); }\n";
        s = s + "    int Count() { return this.q.Count(); }\n";
        s = s + "    async int CountAsync() { return await this.q.CountAsync(); }\n";
        s = s + "    bool Any() { return this.q.Any(); }\n";
        s = s + "    async bool AnyAsync() { return await this.q.AnyAsync(); }\n";
        s = s + "    DbResult AggR(string expr) { return this.q.AggR(expr); }\n";
        s = s + "    int AggI(string expr) { return this.q.AggI(expr); }\n";
        s = s + "    long AggL(string expr) { return this.q.AggL(expr); }\n";
        s = s + "    double AggD(string expr) { return this.q.AggD(expr); }\n";
        s = s + "    async DbResult AggRAsync(string expr) { return await this.q.AggRAsync(expr); }\n";
        s = s + "    async int AggIAsync(string expr) { return await this.q.AggIAsync(expr); }\n";
        s = s + "    async long AggLAsync(string expr) { return await this.q.AggLAsync(expr); }\n";
        s = s + "    async double AggDAsync(string expr) { return await this.q.AggDAsync(expr); }\n";
        s = s + "}\n";
        return s;
    }

    // Reader for a projection target field: 64-bit integers read GetLong,
    // the rest by GenDb kind (0 int, 1 double, 2 bool, 3 string, 4 enum).
    string PjGetter(string kind, string i64) {
        if (kind == "0" && i64 == "true") { return "GetLong"; }
        if (kind == "0" || kind == "4") { return "GetInt"; }
        if (kind == "1") { return "GetDouble"; }
        if (kind == "2") { return "GetBool"; }
        return "GetString";
    }

    // Registered projections of one entity: Pj<N>Map / Pj<N> / Pj<N>Async /
    // Pj<N>One / Pj<N>OneAsync. The column list is a generated string
    // expression: fixed fragments are literals, a.Key members splice the
    // runtime group key via this.q.GroupKey().
    string EmitProjs(string cls) {
        string s = "";
        int i = 0;
        while (i < pjEntity.Count) {
            if (pjEntity[i] == cls) {
                string t = pjTarget[i];
                string nm = pjName[i];
                List<string> cols = Split1(pjCols[i]);
                List<string> fields = Split1(pjFields[i]);
                List<string> kinds = Split1(pjKinds[i]);
                List<string> i64s = Split1(pjI64[i]);
                List<string> keys = Split1(pjKeys[i]);
                string cexpr = "";
                string lit = "";
                bool open = false;
                int k = 0;
                while (k < cols.Count) {
                    if (k > 0) { lit = lit + ", "; }
                    if (keys[k] == "true") {
                        if (lit.Length > 0) {
                            cexpr = cexpr + (open ? " + " : "") + "\"" + lit + "\"";
                            open = true;
                            lit = "";
                        }
                        cexpr = cexpr + (open ? " + " : "") + "this.q.GroupKey()";
                        open = true;
                    } else {
                        lit = lit + cols[k];
                    }
                    k = k + 1;
                }
                if (lit.Length > 0) {
                    cexpr = cexpr + (open ? " + " : "") + "\"" + lit + "\"";
                    open = true;
                }
                if (!open) { cexpr = "\"\""; }
                s = s + "    List<" + t + "> " + nm + "Map(DbResult r) {\n";
                s = s + "        List<" + t + "> outp = new List<" + t + ">();\n";
                s = s + "        int row = 0;\n";
                s = s + "        while (row < r.RowCount()) {\n";
                s = s + "            " + t + " o = new " + t + "();\n";
                k = 0;
                while (k < fields.Count) {
                    s = s + "            o." + fields[k] + " = r." + PjGetter(kinds[k], i64s[k]) + "(row, " + Convert.ToString(k) + ");\n";
                    k = k + 1;
                }
                s = s + "            outp.Add(o);\n";
                s = s + "            row = row + 1;\n";
                s = s + "        }\n";
                s = s + "        return outp;\n";
                s = s + "    }\n";
                s = s + "    List<" + t + "> " + nm + "() {\n";
                s = s + "        return " + nm + "Map(this.q.Dto(" + cexpr + "));\n";
                s = s + "    }\n";
                s = s + "    async List<" + t + "> " + nm + "Async() {\n";
                s = s + "        DbResult r = await this.q.DtoAsync(" + cexpr + ");\n";
                s = s + "        return " + nm + "Map(r);\n";
                s = s + "    }\n";
                s = s + "    " + t + " " + nm + "One() {\n";
                s = s + "        this.q.One();\n";
                s = s + "        List<" + t + "> l = " + nm + "();\n";
                s = s + "        if (l.Count > 0) { return l[0]; }\n";
                s = s + "        return null;\n";
                s = s + "    }\n";
                s = s + "    async " + t + " " + nm + "OneAsync() {\n";
                s = s + "        this.q.One();\n";
                s = s + "        List<" + t + "> l = await " + nm + "Async();\n";
                s = s + "        if (l.Count > 0) { return l[0]; }\n";
                s = s + "        return null;\n";
                s = s + "    }\n";
            }
            i = i + 1;
        }
        return s;
    }

    // Insert facade __DbI_<E>.
    string GenI(string cls) {
        Node decl = FindDecl(cls, AK.ClassDecl());
        if (decl == null) { return ""; }
        string q = "__DbI_" + cls;
        string s = "class " + q + " {\n";
        s = s + "    OrmInsert q;\n";
        s = s + "    __DbB_" + cls + " rows;\n";
        s = s + "    static " + q + " Create(IDbExecutor db) {\n";
        s = s + "        " + q + " r = new " + q + "();\n";
        s = s + "        r.q = OrmInsert.Create(db, " + cls + "Cols.__Meta());\n";
        s = s + "        r.rows = __DbB_" + cls + ".New();\n";
        s = s + "        r.q.SetRows(r.rows);\n";
        s = s + "        return r;\n    }\n";
        s = s + "    static " + q + " Create(IDbExecutor db, " + cls + " o) { return " + q + ".Create(db).AppendData(o); }\n";
        s = s + "    static " + q + " Create(IDbExecutor db, List<" + cls + "> l) { return " + q + ".Create(db).AppendData(l); }\n";
        s = s + "    " + q + " AppendData(" + cls + " o) { this.rows.Add(o); return this; }\n";
        s = s + "    " + q + " AppendData(List<" + cls + "> l) {\n";
        s = s + "        int i = 0;\n";
        s = s + "        while (i < l.Count) { this.rows.Add(l[i]); i = i + 1; }\n";
        s = s + "        return this;\n    }\n";
        s = s + "    " + q + " AppendDict(DbValues v) { this.q.AddDict(v); return this; }\n";
        s = s + "    " + q + " AppendDict(List<DbValues> l) {\n";
        s = s + "        int i = 0;\n";
        s = s + "        while (i < l.Count) { this.q.AddDict(l[i]); i = i + 1; }\n";
        s = s + "        return this;\n    }\n";
        s = s + "    " + q + " AsTable(string t) { this.q.AsTable(t); return this; }\n";
        s = s + "    " + q + " Only(string c) { this.q.Only(c); return this; }\n";
        s = s + "    " + q + " Skip(string c) { this.q.Skip(c); return this; }\n";
        s = s + "    " + q + " OC(string c) { this.q.OC(c); return this; }\n";
        s = s + "    " + q + " ACC(string c) { this.q.ACC(c); return this; }\n";
        s = s + "    " + q + " GMX(string c) { this.q.GMX(c); return this; }\n";
        s = s + "    " + q + " GMN(string c) { this.q.GMN(c); return this; }\n";
        s = s + "    " + q + " NOP() { this.q.NOP(); return this; }\n";
        s = s + "    int ExecuteAffrows() { return this.q.ExecuteAffrows(); }\n";
        s = s + "    async int ExecuteAffrowsAsync() { return await this.q.ExecuteAffrowsAsync(); }\n";
        s = s + "    int ExecuteIdentity() { return this.q.ExecuteIdentity(); }\n";
        s = s + "    async int ExecuteIdentityAsync() { return await this.q.ExecuteIdentityAsync(); }\n";
        s = s + "}\n";
        return s;
    }

    // Update facade __DbU_<E>.
    string GenU(string cls) {
        Node decl = FindDecl(cls, AK.ClassDecl());
        if (decl == null) { return ""; }
        string q = "__DbU_" + cls;
        string s = "class " + q + " {\n";
        s = s + "    OrmUpdate q;\n";
        s = s + "    static " + q + " Create(IDbExecutor db) {\n";
        s = s + "        " + q + " r = new " + q + "();\n";
        s = s + "        r.q = OrmUpdate.Create(db, " + cls + "Cols.__Meta());\n";
        s = s + "        return r;\n    }\n";
        s = s + "    " + q + " AsTable(string t) { this.q.AsTable(t); return this; }\n";
        s = s + "    " + q + " Only(string c) { this.q.Only(c); return this; }\n";
        s = s + "    " + q + " Skip(string c) { this.q.Skip(c); return this; }\n";
        s = s + "    " + q + " SetDict(DbValues v) { this.q.SetDict(v); return this; }\n";
        s = s + "    " + q + " WhereDict(DbValues v) { this.q.WhereDict(v); return this; }\n";
        s = s + "    " + q + " CondBegin(bool c) { this.q.CondBegin(c); return this; }\n";
        s = s + "    " + q + " CondEnd() { this.q.CondEnd(); return this; }\n";
        s = s + "    " + q + " W(string f) { this.q.W(f); return this; }\n";
        s = s + "    " + q + " P(string v) { this.q.P(v); return this; }\n";
        s = s + "    " + q + " Pi(int v) { this.q.Pi(v); return this; }\n";
        s = s + "    " + q + " Pl(long v) { this.q.Pl(v); return this; }\n";
        s = s + "    " + q + " Pd(double v) { this.q.Pd(v); return this; }\n";
        s = s + "    " + q + " InI(List<int> vs) { this.q.InI(vs); return this; }\n";
        s = s + "    " + q + " InL(List<long> vs) { this.q.InL(vs); return this; }\n";
        s = s + "    " + q + " InS(List<string> vs) { this.q.InS(vs); return this; }\n";
        s = s + "    " + q + " InD(List<double> vs) { this.q.InD(vs); return this; }\n";
        s = s + "    " + q + " Frag(string f) { this.q.Frag(f); return this; }\n";
        s = s + "    " + q + " SetI(string c, int v) { this.q.SetI(c, v); return this; }\n";
        s = s + "    " + q + " SetL(string c, long v) { this.q.SetL(c, v); return this; }\n";
        s = s + "    " + q + " SetD(string c, double v) { this.q.SetD(c, v); return this; }\n";
        s = s + "    " + q + " SetS(string c, string v) { this.q.SetS(c, v); return this; }\n";
        s = s + "    " + q + " SetB(string c, bool v) { this.q.SetB(c, v); return this; }\n";
        s = s + "    " + q + " SetIncrI(string c, int v) { this.q.SetIncrI(c, v); return this; }\n";
        s = s + "    " + q + " SetIncrL(string c, long v) { this.q.SetIncrL(c, v); return this; }\n";
        s = s + "    " + q + " SetIncrD(string c, double v) { this.q.SetIncrD(c, v); return this; }\n";
        s = s + "    " + q + " SetSource(" + cls + " o) {\n";
        s = s + "        __DbB_" + cls + " b = __DbB_" + cls + ".New();\n";
        s = s + "        b.Add(o);\n";
        s = s + "        this.q.SetSource(b);\n";
        s = s + "        return this;\n    }\n";
        s = s + "    int ExecuteAffrows() { return this.q.ExecuteAffrows(); }\n";
        s = s + "    async int ExecuteAffrowsAsync() { return await this.q.ExecuteAffrowsAsync(); }\n";
        s = s + "}\n";
        return s;
    }

    // Delete facade __DbD_<E>.
    string GenD(string cls) {
        Node decl = FindDecl(cls, AK.ClassDecl());
        if (decl == null) { return ""; }
        string q = "__DbD_" + cls;
        string s = "class " + q + " {\n";
        s = s + "    OrmDelete q;\n";
        s = s + "    static " + q + " Create(IDbExecutor db) {\n";
        s = s + "        " + q + " r = new " + q + "();\n";
        s = s + "        r.q = OrmDelete.Create(db, " + cls + "Cols.__Meta());\n";
        s = s + "        return r;\n    }\n";
        s = s + "    " + q + " AsTable(string t) { this.q.AsTable(t); return this; }\n";
        s = s + "    " + q + " CondBegin(bool c) { this.q.CondBegin(c); return this; }\n";
        s = s + "    " + q + " CondEnd() { this.q.CondEnd(); return this; }\n";
        s = s + "    " + q + " W(string f) { this.q.W(f); return this; }\n";
        s = s + "    " + q + " WhereDict(DbValues v) { this.q.WhereDict(v); return this; }\n";
        s = s + "    " + q + " P(string v) { this.q.P(v); return this; }\n";
        s = s + "    " + q + " Pi(int v) { this.q.Pi(v); return this; }\n";
        s = s + "    " + q + " Pl(long v) { this.q.Pl(v); return this; }\n";
        s = s + "    " + q + " Pd(double v) { this.q.Pd(v); return this; }\n";
        s = s + "    " + q + " InI(List<int> vs) { this.q.InI(vs); return this; }\n";
        s = s + "    " + q + " InL(List<long> vs) { this.q.InL(vs); return this; }\n";
        s = s + "    " + q + " InS(List<string> vs) { this.q.InS(vs); return this; }\n";
        s = s + "    " + q + " InD(List<double> vs) { this.q.InD(vs); return this; }\n";
        s = s + "    int ExecuteAffrows() { return this.q.ExecuteAffrows(); }\n";
        s = s + "    async int ExecuteAffrowsAsync() { return await this.q.ExecuteAffrowsAsync(); }\n";
        s = s + "}\n";
        return s;
    }

    // CodeFirst facade __DbCF_<E>.
    string GenCF(string cls) {
        Node decl = FindDecl(cls, AK.ClassDecl());
        if (decl == null) { return ""; }
        string s = "class __DbCF_" + cls + " {\n";
        s = s + "    static void Sync(IDbExecutor db) { OrmSync.Sync(db, " + cls + "Cols.__Meta()); }\n";
        s = s + "    static async void SyncAsync(IDbExecutor db) { await OrmSync.SyncAsync(db, " + cls + "Cols.__Meta()); }\n";
        s = s + "}\n";
        return s;
    }

    // ---- entry point ----

    public void Run(Node u, Diags d) {
        unit = u;
        diags = d;

        int i = 0;
        while (i < unit.kids.Count) {
            Node dc = unit.kids[i];
            i = i + 1;
            if (dc.kind != AK.ClassDecl() && dc.kind != AK.StructDecl()) { continue; }
            int mi = 0;
            while (mi < dc.kids.Count) {
                Node m = dc.kids[mi];
                mi = mi + 1;
                if (m.kind == AK.MethodDecl() || m.kind == AK.CtorDecl()) { Visit(m.d); }
                else if (m.kind == AK.FieldDecl()) { Visit(m.b); }
            }
        }
        if (File.Exists("/tmp/zan_dbsrc_debug")) {
            Console.WriteLine("[dbgen] any=" + (any ? "1" : "0") + " errs=" + (diags.HasErrors() ? "1" : "0") + " needs=" + Convert.ToString(needNames.Count));
        }
        if (!any || diags.HasErrors()) { return; }

        string src = "using System.Linq;\nusing System.Data.Orm;\n";
        if (needDaos.Count > 0) {
            src = src + "using ZanWeb.Dao;\n";
        }
        src = src + "class __DbBind {\n";
        src = src + "    static string M(int n) { return OrmDialect.Marks(n); }\n";
        int di = 0;
        while (di < needDaos.Count) {
            src = src + "    static " + needDaos[di] + " __DaoPull_" + Convert.ToString(di) + "() { return null; }\n";
            di = di + 1;
        }
        int gi = 0;
        while (gi < needNames.Count) {
            string cls = needNames[gi];
            src = src + "    static __DbQ_" + cls + " Q_" + cls + "(IDbExecutor db) { return __DbQ_" + cls + ".Create(db); }\n";
            src = src + "    static __DbI_" + cls + " I_" + cls + "(IDbExecutor db) { return __DbI_" + cls + ".Create(db); }\n";
            src = src + "    static __DbI_" + cls + " I_" + cls + "(IDbExecutor db, " + cls + " o) { return __DbI_" + cls + ".Create(db, o); }\n";
            src = src + "    static __DbI_" + cls + " I_" + cls + "(IDbExecutor db, List<" + cls + "> l) { return __DbI_" + cls + ".Create(db, l); }\n";
            src = src + "    static __DbU_" + cls + " U_" + cls + "(IDbExecutor db) { return __DbU_" + cls + ".Create(db); }\n";
            src = src + "    static __DbD_" + cls + " D_" + cls + "(IDbExecutor db) { return __DbD_" + cls + ".Create(db); }\n";
            src = src + "    static void CF_" + cls + "(IDbExecutor db) { __DbCF_" + cls + ".Sync(db); }\n";
            src = src + "    static async void CFA_" + cls + "(IDbExecutor db) { await __DbCF_" + cls + ".SyncAsync(db); }\n";
            gi = gi + 1;
        }
        if (syncAll) {
            src = src + "    static void SyncAll(IDbExecutor db) {\n";
            gi = 0;
            while (gi < needNames.Count) {
                src = src + "        CF_" + needNames[gi] + "(db);\n";
                gi = gi + 1;
            }
            src = src + "    }\n";
            src = src + "    static async void SyncAllAsync(IDbExecutor db) {\n";
            gi = 0;
            while (gi < needNames.Count) {
                src = src + "        await CFA_" + needNames[gi] + "(db);\n";
                gi = gi + 1;
            }
            src = src + "    }\n";
        }
        src = src + "}\n";
        // __DbM_/__DbB_ for the entities plus every Include-nav target
        List<string> acc = new List<string>();
        gi = 0;
        while (gi < needNames.Count) {
            string cls = needNames[gi];
            if (FindDecl(cls, AK.ClassDecl()) == null) { gi = gi + 1; continue; }
            if (!HasName(acc, cls)) { acc.Add(cls); }
            LoadFields(cls);
            int k = 0;
            while (k < fKinds.Count) {
                if (fKinds[k] == Dbgen.DfNav() && !HasName(acc, fTypes[k])) { acc.Add(fTypes[k]); }
                k = k + 1;
            }
            gi = gi + 1;
        }
        gi = 0;
        while (gi < acc.Count) {
            src = src + GenAccess(acc[gi]);
            gi = gi + 1;
        }
        gi = 0;
        while (gi < needNames.Count) {
            string cls = needNames[gi];
            if (FindDecl(cls, AK.ClassDecl()) == null) { gi = gi + 1; continue; }
            src = src + GenCols(cls);
            src = src + GenQ(cls);
            src = src + GenI(cls);
            src = src + GenU(cls);
            src = src + GenD(cls);
            src = src + GenCF(cls);
            gi = gi + 1;
        }

        // hand the full text back for the post-codegen pull-in round
        dbSrc = src;
        if (File.Exists("/tmp/zan_dbsrc_debug")) { File.WriteAllText("/tmp/zan_dbsrc.txt", src); }
        Lexer lx = new Lexer(src);
        List<Token> gt = lx.Run();
        Parser gp = new Parser(gt, diags);
        Node gu = gp.ParseUnit();
        int j = 0;
        while (j < gu.kids.Count) {
            if (gu.kids[j].kind == AK.ClassDecl()) { unit.Add(gu.kids[j]); }
            j = j + 1;
        }
    }

    bool HasName(List<string> l, string v) {
        int i = 0;
        while (i < l.Count) {
            if (l[i] == v) { return true; }
            i = i + 1;
        }
        return false;
    }
}
