using System;
using System.Collections.Generic;
namespace Zan;

// Irgen part: expression codegen -- assignment, member access, indexing,
// object construction, casts, lambdas/delegates and calls.
partial class Irgen {
    // ---- expressions ----
    ExprVal GenExpr(Node e) {
        if (e == null) { return new ExprVal("0", MkType("int")); }
        int k = e.kind;
        if (k == AK.IntLit()) { return new ExprVal("" + e.IntLitValue(), MkType(e.IntLitTypeName())); }
        if (k == AK.FloatLit()) {
            // an f/F literal is a float: the host emits it as an LLVM float,
            // so its value is the text rounded to single precision
            if (e.suffix == 1) { return new ExprVal(F32Const(e.sval), MkType("float")); }
            return new ExprVal(FloatConst(e.sval), MkType("double"));
        }
        if (k == AK.BoolLit()) { return new ExprVal("" + e.ival, MkType("bool")); }
        if (k == AK.CharLit()) { return new ExprVal("" + e.ival, MkType("char")); }
        if (k == AK.StringLit()) {
            if (e.b != null) { return GenTypeof(e); }
            return GenStr(e.sval);
        }
        if (k == AK.NullLit()) { return new ExprVal("null", MkType("object")); }
        if (k == AK.ThisExpr()) { return new ExprVal("%this", CurThisTy()); }
        if (k == AK.Ident()) { return GenIdent(e); }
        if (k == AK.Unary()) { return GenUnary(e); }
        if (k == AK.PostfixUnary()) { return GenPostfix(e); }
        if (k == AK.Binary()) { return GenBinary(e); }
        if (k == AK.Assignment()) { return GenAssign(e); }
        if (k == AK.Call()) {
            if (e.a != null && e.a.kind == AK.MemberAccess() && e.a.ival == 1) {
                return GenNullCond(e, e.a);
            }
            return GenCall(e);
        }
        if (k == AK.Lambda()) { return GenLambda(e); }
        if (k == AK.SwitchExpr()) { return GenSwitchExpr(e); }
        if (k == AK.Conditional()) { return GenConditional(e); }
        if (k == AK.TupleExpr()) { return GenTuple(e); }
        if (k == AK.IsExpr()) { return GenIs(e); }
        if (k == AK.MemberAccess()) {
            if (e.ival == 1) { return GenNullCond(e, e); }
            return GenMember(e);
        }
        if (k == AK.QueryExpr()) { return GenQuery(e); }
        if (k == AK.Index()) { return GenIndex(e); }
        if (k == AK.NewExpr()) { return GenNew(e); }
        if (k == AK.CastExpr()) { return GenCast(e); }
        if (k == AK.AsExpr()) { return GenAs(e); }
        if (k == AK.AwaitExpr()) {
            diags.Error("async/await is parsed but not yet lowered by the self-host compiler", e.line, e.col);
            return GenExpr(e.a);
        }
        return new ExprVal("0", MkType("int"));
    }

    // The receiver's static type in the method being emitted: the concrete
    // instantiation for a specialized clone of a generic class
    // (`Pool<string>`), the class itself otherwise.
    Node CurThisTy() {
        if (curThisTy != null) { return curThisTy; }
        return MkType(curClass);
    }

    ExprVal GenIdent(Node e) {
        int li = LocalIdx(e.sval);
        if (li >= 0) {
            Node ty = locType[li];
            string reg = locReg[li];
            string lt = MapType(ty);
            if (curAsync && locBox[li]) {
                // the local lives in a heap cell: the spill slot holds the cell
                // pointer, the cell holds the value
                string c = NT();
                L("  " + c + " = load i8*, i8** " + reg);
                string p = NT();
                L("  " + p + " = bitcast i8* " + c + " to " + lt + "*");
                string t = NT();
                L("  " + t + " = load " + lt + ", " + lt + "* " + p);
                return new ExprVal(t, ty);
            }
            string t = NT();
            L("  " + t + " = load " + lt + ", " + lt + "* " + reg);
            return new ExprVal(t, ty);
        }
        // implicit this.field
        if (curHasThis) {
            Node cls = binder.FindType(curClass);
            if (cls != null && FieldIndex(cls, e.sval) >= 0) {
                return LoadField("%this", CurThisTy(), e.sval);
            }
            if (cls != null) {
                Node g = FindMethodUp(cls, "get_" + e.sval);
                if (g != null) {
                    // a static property is read through a static call (no
                    // receiver): a bare `ReadOnly` inside the class means
                    // `ReadOnly.get_ReadOnly()`
                    if (HasMod(g, MOD.Static())) {
                        Node sc = new Node(AK.Call());
                        sc.line = e.line; sc.col = e.col;
                        return EmitStaticCall(curClass, "get_" + e.sval, sc);
                    }
                    ExprVal recv = new ExprVal("%this", CurThisTy());
                    return EmitInstanceCall(recv, curClass, "get_" + e.sval, new Node(AK.Call()));
                }
            }
            // bare instance method group used as a delegate value: `this.Method`
            if (cls != null) {
                Node mg = FindMethodUp(cls, e.sval);
                if (mg != null && !HasMod(mg, MOD.Static()) && !HasMod(mg, MOD.Extern())) {
                    ExprVal recv = new ExprVal("%this", CurThisTy());
                    return EmitInstanceMethodGroup(recv, cls, mg);
                }
            }
        }
        if (curClass != "") {
            Node scls = binder.FindType(curClass);
            if (scls != null && FindStaticField(scls, e.sval) != null) {
                string sown = StaticFieldOwner(scls, e.sval);
                return LoadStaticField(scls, e.sval, CurInstFor(sown));
            }
            // a static property read from a static method
            if (scls != null) {
                Node sg = FindMethodUp(scls, "get_" + e.sval);
                if (sg != null && HasMod(sg, MOD.Static())) {
                    Node sc = new Node(AK.Call());
                    sc.line = e.line; sc.col = e.col;
                    return EmitStaticCall(curClass, "get_" + e.sval, sc);
                }
            }
            // bare static method group used as a delegate value
            if (scls != null) {
                Node mg = FindMethodUp(scls, e.sval);
                if (mg != null && HasMod(mg, MOD.Static()) && !HasMod(mg, MOD.Extern())) {
                    return EmitMethodGroup(curClass, scls, mg);
                }
            }
        }
        // The name resolves to nothing the backend can read. The checker
        // rejects the common case (an undeclared identifier) before the
        // backend runs, so getting here means the two disagree -- say so
        // instead of answering 0.
        if (IsBuiltinClassName(e.sval)) {
            diags.Error("'" + e.sval + "' is a built-in type and cannot be used as a value", e.line, e.col);
            return new ExprVal("0", MkType("int"));
        }
        diags.Error("unresolved identifier '" + e.sval
            + "' in the self-hosted compiler", e.line, e.col);
        return new ExprVal("0", MkType("int"));
    }

    ExprVal LoadField(string objOp, Node recvTy, string field) {
        string clsName = recvTy.sval;
        Node cls = binder.FindType(clsName);
        int idx = FieldIndex(cls, field);
        Node fty = FieldType(cls, field);
        // the concrete type of the field, when the receiver's static type
        // carries the class's type arguments (`Box<double>.values` is a
        // `List<double>`): the storage keeps the erased shape, the VALUE
        // gets its real type back
        Node vty = SubstRecvTy(fty, recvTy);
        string ft = MapType(fty);
        string p = NT();
        L("  " + p + " = getelementptr %" + clsName + ", %" + clsName + "* " + objOp + ", i32 0, i32 " + idx);
        string t = NT();
        L("  " + t + " = load " + ft + ", " + ft + "* " + p);
        // erased field: storage is i64; unpack to the concrete type when known
        if (IsErasedType(fty)) { return FromSlot(t, vty); }
        return new ExprVal(t, vty);
    }

    // User-defined operator ++/-- (A525 一件自举半边)：the parser names the
    // declaration op_inc/op_dec; the dispatch looks it up on the operand's
    // class chain and calls the static method. Returns null when the operand
    // is not a class or declares no such operator (numeric paths proceed).
    // The 1-parameter overload of `mn` among `cls`'s own members. Unary and
    // binary forms share the name (op_add/op_sub); the unary dispatch must
    // not land on the binary one (A451, host resolve_op_overload distinguishes
    // by param count).
    int OpParamCount(Node m) {
        int n = 0; int i = 0;
        while (i < m.kids.Count) {
            if (m.kids[i].kind == AK.Param()) { n = n + 1; }
            i = i + 1;
        }
        return n;
    }

    Node OpMethod1(Node cls, string mn) {
        int i = 0;
        while (i < cls.kids.Count) {
            Node m = cls.kids[i];
            if (m.kind == AK.MethodDecl() && m.sval == mn && OpParamCount(m) == 1) {
                return m;
            }
            i = i + 1;
        }
        return null;
    }

    ExprVal TryUnaryOpOverload(Node e, ExprVal v) {
        if (v.ty == null || v.ty.ival != 0) { return null; }
        Node ucls = ClassOf(v.ty);
        if (ucls == null) { return null; }
        string unm = null;
        string usign = null;
        if (e.op == TK.PlusPlus()) { unm = "op_inc"; usign = "++"; }
        else if (e.op == TK.MinusMinus()) { unm = "op_dec"; usign = "--"; }
        else if (e.op == TK.Plus()) { unm = "op_add"; usign = "+"; }
        else if (e.op == TK.Minus()) { unm = "op_sub"; usign = "-"; }
        if (unm == null) { return null; }
        Node declCls = OpDeclClass(ucls, unm);
        if (declCls == null) { return null; }
        Node um = OpMethod1(declCls, unm);
        if (um == null || !HasMod(um, MOD.Static())) { return null; }
        Node p0 = ParamTypeNode(um, 0);
        if (p0 == null) { return null; }
        string rt = MapType(um.type);
        if (rt == "void") {
            diags.Error("operator " + usign + " must return a value",
                e.line, e.col);
            return null;
        }
        string args = MapType(p0) + " " + CallArg(v, p0, false);
        string sym = MethodSym(declCls.sval, um);
        string t = NT();
        L("  " + t + " = call " + rt + " @" + sym + "(" + args + ")");
        return new ExprVal(t, um.type);
    }

    // class/struct operand: nominal type whose declaration is a class or
    // struct (numerics, string, enums, arrays fall through to builtins)
    bool UnaryOperandIsNamedComposite(ExprVal v) {
        if (v.ty == null || v.ty.ival != 0) { return false; }
        return ClassOf(v.ty) != null;
    }

    ExprVal GenUnary(Node e) {
        ExprVal v = GenExpr(e.a);
        if (e.op == TK.PlusPlus() || e.op == TK.MinusMinus()) {
            // user-defined operator ++/-- (parser names it op_inc/op_dec):
            // a static method of the operand's class taking and returning
            // the operand's type. C#: prefix and postfix BOTH call it.
            ExprVal uov = TryUnaryOpOverload(e, v);
            if (uov != null) {
                StoreTo(e.a, uov);
                return uov;
            }
            // prefix ++/--: store the new value and yield it
            if (IsDbl(v.ty)) {
                string t = NT();
                string fop = e.op == TK.PlusPlus() ? "fadd" : "fsub";
                L("  " + t + " = " + fop + " double " + v.op + ", 1.0");
                StoreTo(e.a, new ExprVal(t, MkType("double")));
                return new ExprVal(t, MkType("double"));
            }
            string ti = NT();
            string iop = e.op == TK.PlusPlus() ? "add" : "sub";
            L("  " + ti + " = " + iop + " i64 " + v.op + ", 1");
            // the host increments in the PLACE's width: an int counter wraps
            // at 32 bits, a long one does not
            int pw = ValWidth(v);
            if (pw > 0 && pw < 64) { ti = WrapArith(ti, pw, false); }
            StoreTo(e.a, new ExprVal(ti, MkType("int")));
            ExprVal pr = new ExprVal(ti, MkType("int"));
            pr.wbits = pw;
            return pr;
        }
        if (e.op == TK.Bang()) {
            string c = NT();
            L("  " + c + " = icmp eq i64 " + v.op + ", 0");
            string z = NT();
            L("  " + z + " = zext i1 " + c + " to i64");
            return new ExprVal(z, MkType("bool"));
        }
        if (e.op == TK.Tilde()) {
            string c = NT();
            L("  " + c + " = xor i64 " + v.op + ", -1");
            ExprVal r = new ExprVal(c, v.ty);
            r.wbits = ValWidth(v);
            return r;
        }
        if (e.op == TK.Plus()) {
            // unary plus on a class/struct dispatches the 1-param op_add;
            // a missing overload is a compile error, never a silent identity
            // (A451, host emit_unary_op_overload)
            if (UnaryOperandIsNamedComposite(v)) {
                ExprVal uov = TryUnaryOpOverload(e, v);
                if (uov != null) { return uov; }
                diags.Error("type '" + v.ty.sval
                    + "' does not define a unary '+' operator overload",
                    e.line, e.col);
            }
            return v;
        }
        if (e.op == TK.Minus()) {
            if (UnaryOperandIsNamedComposite(v)) {
                // the builtin path would emit `sub i64 0, <ptr>` -- invalid
                // IR on a struct/class operand; dispatch or diagnose (A451)
                ExprVal uov = TryUnaryOpOverload(e, v);
                if (uov != null) { return uov; }
                diags.Error("type '" + v.ty.sval
                    + "' does not define a unary '-' operator overload",
                    e.line, e.col);
                return v;
            }
            if (IsDbl(v.ty)) {
                string t = NT();
                L("  " + t + " = fneg double " + v.op);
                return new ExprVal(t, MkType("double"));
            }
            string t = NT();
            L("  " + t + " = sub i64 0, " + v.op);
            // the host negates in the OPERAND's width: negating the most
            // negative int wraps back to it
            int nw = ValWidth(v);
            if (nw > 0 && nw < 64) { t = WrapArith(t, nw, false); }
            ExprVal r = new ExprVal(t, MkType("int"));
            r.wbits = nw;
            return r;
        }
        return v;
    }

    ExprVal GenPostfix(Node e) {
        if (e.op == TK.Bang()) {
            return GenExpr(e.a);
        }
        // x++ / x-- : return old value, update slot
        ExprVal cur = GenExpr(e.a);
        // user-defined operator ++/--: same call as prefix, postfix yields
        // the OLD value (cur is already the pre-call value)
        ExprVal uovp = TryUnaryOpOverload(e, cur);
        if (uovp != null) {
            StoreTo(e.a, uovp);
            return cur;
        }
        if (IsDbl(cur.ty)) {
            string t = NT();
            string opn = "fadd";
            if (e.op == TK.MinusMinus()) { opn = "fsub"; }
            L("  " + t + " = " + opn + " double " + cur.op + ", 1.0");
            StoreTo(e.a, new ExprVal(t, MkType("double")));
            return cur;
        }
        string t = NT();
        string opn = "add";
        if (e.op == TK.MinusMinus()) { opn = "sub"; }
        L("  " + t + " = " + opn + " i64 " + cur.op + ", 1");
        StoreTo(e.a, new ExprVal(t, MkType("int")));
        return cur;
    }

    string ArithOp(int op) {
        if (op == TK.Plus()) { return "add"; }
        if (op == TK.Minus()) { return "sub"; }
        if (op == TK.Star()) { return "mul"; }
        if (op == TK.Slash()) { return "sdiv"; }
        if (op == TK.Percent()) { return "srem"; }
        if (op == TK.Amp()) { return "and"; }
        if (op == TK.Caret()) { return "xor"; }
        if (op == TK.Pipe()) { return "or"; }
        if (op == TK.LessLess()) { return "shl"; }
        if (op == TK.GreaterGreater()) { return "ashr"; }
        if (op == TK.GreaterGreaterGreater()) { return "lshr"; }
        return "";
    }
    string CmpOp(int op) {
        if (op == TK.EqEq()) { return "eq"; }
        if (op == TK.BangEq()) { return "ne"; }
        if (op == TK.Less()) { return "slt"; }
        if (op == TK.Greater()) { return "sgt"; }
        if (op == TK.LessEq()) { return "sle"; }
        if (op == TK.GreaterEq()) { return "sge"; }
        return "";
    }
    // Unsigned integer comparison predicates (for ulong operands).
    string UCmpOp(int op) {
        if (op == TK.EqEq()) { return "eq"; }
        if (op == TK.BangEq()) { return "ne"; }
        if (op == TK.Less()) { return "ult"; }
        if (op == TK.Greater()) { return "ugt"; }
        if (op == TK.LessEq()) { return "ule"; }
        if (op == TK.GreaterEq()) { return "uge"; }
        return "";
    }

    // A valid LLVM floating constant: ensure a decimal point / exponent so
    // integer-looking literals (e.g. the `3` from `3m`) are emitted as doubles.
    string FloatConst(string s) {
        if (s == "") { return "0.0"; }
        int i = 0;
        int dot = -1;
        int exp = -1;
        while (i < s.Length) {
            int c = (int)s[i];
            if (c == 46) { dot = i; }
            else if ((c == 101 || c == 69) && exp < 0) { exp = i; }
            i = i + 1;
        }
        if (dot >= 0) { return s; }
        if (exp >= 0) {
            return s.Substring(0, exp) + ".0" + s.Substring(exp);
        }
        return s + ".0";
    }

    bool IsStr(Node ty) { if (ty == null) { return false; } return ty.sval == "string" && ty.ival == 0; }
    // The type name Convert.ToString must refuse: a class instance, an array,
    // a delegate or a struct. "" means the value is acceptable.
    //
    // The C host's whitelist (irgen_call.c type_is_textual_or_numeric) covers
    // the textual and the numeric types, the enums, `object` and the type
    // parameters; everything else is refused. An array names its ELEMENT with
    // the rank in `ival`, so the element's name is what gets printed.
    string ConvertToStringBadType(Node ty) {
        if (ty == null) { return ""; }
        if (ty.ival >= 1) { return ty.sval + "[]"; }
        string n = ty.sval;
        if (n == "" || n == "var" || n == "string" || n == "bool" || n == "char" ||
            n == "object" || n == "void") { return ""; }
        if (n == "int" || n == "long" || n == "short" || n == "byte" ||
            n == "sbyte" || n == "uint" || n == "ushort" || n == "ulong" ||
            n == "float" || n == "double" || n == "decimal" || n == "nint") {
            return "";
        }
        if (binder.IsTypeParam(n)) { return ""; }
        // A delegate is refused too, and the binder keeps it OUT of `types`
        // (it lives in `delegates`), so FindType would not see it.
        if (binder.IsDelegateName(n)) { return n; }
        Node d = binder.FindType(n);
        if (d == null) { return ""; }          // unknown: stay permissive
        if (d.kind == AK.EnumDecl()) { return ""; }
        return n;                              // class / struct
    }
    // True for an enum: it rides an i64 slot, so it converts like an integer
    // (the C host lowers an enum to an integer too).
    bool IsEnumTy(Node ty) {
        if (ty == null) { return false; }
        if (ty.ival >= 1) { return false; }
        Node d = binder.FindType(ty.sval);
        return d != null && d.kind == AK.EnumDecl();
    }
    // The type name a Convert.ToInt32 / ToInt64 / ToInt / ToDouble argument
    // must NOT have, or "" when the value may be converted.
    //
    // The C host (irgen_call.c type_is_textual_or_numeric) accepts the
    // textual and the numeric types, the enums, `object` and the type
    // parameters; a class instance, a struct, an array and a delegate are
    // refused. The self-host used to hand the pointer to strtoll/strtod,
    // which reads the OBJECT's bytes as text -- a silent out-of-bounds read
    // that answers 0, while the very same program is refused by the host.
    //
    // `object` stays on the whitelist for the same reason as on the host: the
    // compiler cannot see what it holds (TASKS.md A444). The host reads the
    // object pointer as a C string too -- both sides are wrong in the same
    // way until the object gets a general ToString.
    //
    // A nullable keeps the ELEMENT's name in `sval` (the C host recurses into
    // element_type for TYPE_NULLABLE) and an array names its element with
    // the rank in `ival` -- so the name printed here is the element's, the
    // same name the C host prints (at->name).
    string ConvertNumberBadType(Node ty) {
        if (ty == null) { return ""; }
        if (ty.ival >= 1) { return ty.sval; }   // an array names its element
        return ConvertNumberBadName(ty.sval);
    }
    // The same judgement by NAME ("" means the value may be converted).
    string ConvertNumberBadName(string n) {
        if (n == "" || n == "var" || n == "string" || n == "bool" || n == "char" ||
            n == "object") { return ""; }
        if (n == "int" || n == "long" || n == "short" || n == "byte" ||
            n == "sbyte" || n == "uint" || n == "ushort" || n == "ulong" ||
            n == "float" || n == "double" || n == "decimal" || n == "nint") {
            return "";
        }
        if (binder.IsTypeParam(n)) { return ""; }
        // A delegate is refused too, and the binder keeps it OUT of `types`
        // (it lives in `delegates`), so FindType would not see it.
        if (binder.IsDelegateName(n)) { return n; }
        Node d = binder.FindType(n);
        if (d == null) { return ""; }          // unknown: stay permissive
        if (d.kind == AK.EnumDecl()) { return ""; }
        return n;                              // class / struct
    }
    // True for a value the Convert.* paths read as an integer: every integer
    // type, `bool` and an enum -- they all ride an i64 slot.
    bool ConvertIsIntegral(ExprVal a) {
        if (a.ty == null) { return false; }
        if (IsIntLike(a.ty)) { return true; }
        if (a.ty.sval == "bool") { return true; }
        return IsEnumTy(a.ty);
    }
    // Convert.ToInt32 / ToInt / ToInt64: a string is parsed with strtoll and a
    // float is rounded to even (rint) before the truncating conversion -- the
    // C host does both (irgen_call.c; TASKS.md A513 turned the float path from
    // truncate into banker's rounding, 3.9 converts to 4). An integer is kept.
    // Every other value answers 0 (the host's fallback branch). A nullable
    // lowers to a struct on the host, so the value never reaches the parser
    // there either.
    string ConvertIntOperand(Node at, ExprVal a, bool int64) {
        if (IsNullable(a.ty)) { return "0"; }
        if (IsStr(a.ty)) {
            // A512: the C host parses with strtoll + the end-pointer
            // predicate (irgen_call.c ~2078) and reports failure, trailing
            // garbage and (ToInt32/ToInt only) the int-range overflow
            // through the soft channel, then hands back 0. ToInt64 keeps
            // the full strtoll range (irgen_call.c:2096 keys on the '4').
            if (!ExternSeen("strtoll")) { externDecls.Add("strtoll"); H("declare i64 @strtoll(i8*, i8**, i32)"); }
            string s = ParseStrGuard(at, a.op);
            string endp = NT();
            EA(endp, "i8*");
            L("  store i8* null, i8** " + endp);
            // A512（审计 P1-12 余项，宿主 irgen_call.c:2160 同款）：strtoll 对
            // 超 long 范围的输入饱和返回 INT64_MAX/MIN 并置 errno=ERANGE——
            // 只看返回值分不清「输入恰好是极值」与「饱和」。先清零 errno，
            // 调用后读回比对 34。
            if (!ExternSeen("_errno")) { externDecls.Add("_errno"); H("declare i32* @_errno()"); }
            string errp = NT();
            L("  " + errp + " = call i32* @_errno()");
            L("  store i32 0, i32* " + errp);
            string r = NT();
            L("  " + r + " = call i64 @strtoll(i8* " + s + ", i8** " + endp + ", i32 10)");
            string ep = NT();
            L("  " + ep + " = load i8*, i8** " + endp);
            string bad = ParseBadPred(s, ep);
            string erl = NT();
            L("  " + erl + " = load i32, i32* " + errp);
            string erb = NT();
            L("  " + erb + " = icmp eq i32 " + erl + ", 34");
            string ber = NT();
            L("  " + ber + " = or i1 " + bad + ", " + erb);
            bad = ber;
            if (!int64) {
                string lo = NT();
                L("  " + lo + " = icmp slt i64 " + r + ", -2147483648");
                string hi = NT();
                L("  " + hi + " = icmp sgt i64 " + r + ", 2147483647");
                string ov = NT();
                L("  " + ov + " = or i1 " + lo + ", " + hi);
                string b2 = NT();
                L("  " + b2 + " = or i1 " + bad + ", " + ov);
                bad = b2;
            }
            EmitRuntimeCheckIf(at, bad,
                "Convert.ToInt*: input is not a valid integer (or out of range)");
            string safe = NT();
            L("  " + safe + " = select i1 " + bad + ", i64 0, i64 " + r);
            return safe;
        }
        if (IsDbl(a.ty)) {
            if (!ExternSeen("rint")) { externDecls.Add("rint"); H("declare double @rint(double)"); }
            string rn = NT();
            L("  " + rn + " = call double @rint(double " + a.op + ")");
            // B-ID180：double 实参路径此前裸 fptosi（越界 poison、NaN 平台
            // 各异、try 内无异常分发——字符串/整型路径 B-ID169 已收）。
            // 守卫 + clamp 镜像 C 宿主 irgen_call_builtins.c Convert 族。
            return EmitFptosiGuarded(at, rn);
        }
        if (ConvertIsIntegral(a)) {
            // A512（审计 P1-12，宿主 irgen_call.c:2232 同款）：i64 实参超 int
            // 范围曾静默截断回绕（ToInt32(2147483648L) = -2147483648）——
            // C# 语义是 OverflowException。软诊断 + 0；ToInt64 全宽不查。
            // 位宽按 ValWidth（算术子式类型名恒 int、真宽度在 wbits，见
            // ArithWidth 注释）——窄整型 sext 后必在范围内，不用查。
            if (!int64 && ValWidth(a) >= 64) {
                string ilo = NT();
                L("  " + ilo + " = icmp slt i64 " + a.op + ", -2147483648");
                string ihi = NT();
                L("  " + ihi + " = icmp sgt i64 " + a.op + ", 2147483647");
                string iov = NT();
                L("  " + iov + " = or i1 " + ilo + ", " + ihi);
                EmitRuntimeCheckIf(at, iov,
                    "Convert.ToInt*: value is outside the range of int");
                string isafe = NT();
                L("  " + isafe + " = select i1 " + iov + ", i64 0, i64 " + a.op);
                return isafe;
            }
            return a.op;
        }
        return "0";
    }
    // Convert.ToDouble: a string is parsed as text, an integer is converted
    // and a float is kept -- the C host does the same (irgen_call.c:1679).
    string ConvertDoubleOperand(Node at, ExprVal a) {
        if (IsNullable(a.ty)) { return "0.0"; }
        if (IsStr(a.ty)) {
            // A512: strtod with the same end-pointer predicate; strtod
            // saturates to +-inf on overflow and C# double.Parse-style
            // overflow is an error, so +-inf joins the bad predicate (the
            // C host folds it through fabs == DBL_MAX*2, irgen_call.c).
            if (!ExternSeen("strtod")) { externDecls.Add("strtod"); H("declare double @strtod(i8*, i8**)"); }
            string s = ParseStrGuard(at, a.op);
            string endp = NT();
            EA(endp, "i8*");
            L("  store i8* null, i8** " + endp);
            string r = NT();
            L("  " + r + " = call double @strtod(i8* " + s + ", i8** " + endp + ")");
            string ep = NT();
            L("  " + ep + " = load i8*, i8** " + endp);
            string bad = ParseBadPred(s, ep);
            string pinf = NT();
            L("  " + pinf + " = fcmp oeq double " + r + ", 0x7FF0000000000000");
            string ninf = NT();
            L("  " + ninf + " = fcmp oeq double " + r + ", 0xFFF0000000000000");
            string inf = NT();
            L("  " + inf + " = or i1 " + pinf + ", " + ninf);
            string b2 = NT();
            L("  " + b2 + " = or i1 " + bad + ", " + inf);
            EmitRuntimeCheckIf(at, b2,
                "Convert.ToDouble: input is not a valid number");
            string safe = NT();
            L("  " + safe + " = select i1 " + b2 + ", double 0.0, double " + r);
            return safe;
        }
        if (IsDbl(a.ty)) { return a.op; }
        if (ConvertIsIntegral(a)) {
            string r = NT();
            L("  " + r + " = sitofp i64 " + a.op + " to double");
            return r;
        }
        return "0.0";
    }
    // ulong is the one integer type whose value can set the high bit of the i64
    // slot, so it selects unsigned division/remainder/shift/compare and %llu.
    bool IsUlong(Node ty) { if (ty == null) { return false; } return ty.sval == "ulong" && ty.ival == 0; }
    // True for a value lowered to LLVM `double` (double, float, and A487's
    // decimal -- the payload is a double, only the type name differs).
    bool IsDbl(Node ty) { if (ty == null) { return false; } return (ty.sval == "double" || ty.sval == "float" || ty.sval == "decimal") && ty.ival == 0; }
    // True for a value that rides an integer slot (every integer lives in an
    // i64 here).
    bool IsIntLike(Node ty) {
        if (ty == null) { return false; }
        if (ty.ival >= 1) { return false; }
        string n = ty.sval;
        return n == "int" || n == "long" || n == "short" || n == "byte" ||
               n == "sbyte" || n == "uint" || n == "ushort" || n == "ulong" ||
               n == "nint" || n == "char" || n == "Int32" || n == "Int64";
    }

    // Floating-point counterparts of ArithOp/CmpOp for `double` operands.
    string FArithOp(int op) {
        if (op == TK.Plus()) { return "fadd"; }
        if (op == TK.Minus()) { return "fsub"; }
        if (op == TK.Star()) { return "fmul"; }
        if (op == TK.Slash()) { return "fdiv"; }
        if (op == TK.Percent()) { return "frem"; }
        return "";
    }
    string FCmpOp(int op) {
        if (op == TK.EqEq()) { return "oeq"; }
        // `!=` is the unordered not-equal: a NaN operand makes it true, the
        // same way the C host's LLVMRealUNE behaves (irgen_expr.c:4118). An
        // ordered `one` would report NaN != NaN as false and silently drop
        // the finiteness check of the vector index.
        if (op == TK.BangEq()) { return "une"; }
        if (op == TK.Less()) { return "olt"; }
        if (op == TK.Greater()) { return "ogt"; }
        if (op == TK.LessEq()) { return "ole"; }
        if (op == TK.GreaterEq()) { return "oge"; }
        return "";
    }
    // Materialise `v` as an LLVM `double`, widening an integer operand via sitofp.
    string AsDouble(ExprVal v) {
        if (IsDbl(v.ty)) { return v.op; }
        string t = NT();
        L("  " + t + " = sitofp i64 " + v.op + " to double");
        return t;
    }

    // Is the type the host's `float` (an IEEE single)? The self-host keeps
    // every float in a double slot, so the single precision shows up as an
    // explicit round trip (the native backend's NarrowF32).
    bool IsFloatTy(Node ty) {
        if (ty == null) { return false; }
        return ty.sval == "float" && ty.ival == 0;
    }

    // The single-precision rounding of a double value: double -> float ->
    // double. A float-typed value carries only 24 bits of mantissa, exactly
    // like the host's f32; rounding an already-narrowed value is idempotent.
    string F32Round(string v) {
        string t = NT();
        L("  " + t + " = fptrunc double " + v + " to float");
        string u = NT();
        L("  " + u + " = fpext float " + t + " to double");
        return u;
    }

    // An f/F literal is a float in the host: the text is rounded to single
    // precision. LLVM's IR only accepts an exactly-representable `float`
    // constant, so the rounding goes through the runtime's fptrunc.
    string F32Const(string text) {
        return F32Round(FloatConst(text));
    }

    // The result type of a floating-point operation, the C host's rule: two
    // floats (or a float and an integer) stay in single precision; a double
    // operand promotes the whole expression to double.
    Node FloatResultTy(Node at, Node bt) {
        bool ad = at != null && at.sval == "double" && at.ival == 0;
        bool bd = bt != null && bt.sval == "double" && bt.ival == 0;
        if (ad || bd) { return MkType("double"); }
        if (IsFloatTy(at) || IsFloatTy(bt)) { return MkType("float"); }
        return MkType("double");
    }

    bool IsFoldOp(int op) {
        return op == TK.Plus() || op == TK.Minus() || op == TK.Star() || op == TK.Slash() || op == TK.Percent();
    }

    // Is `e` a compile-time integer constant (literals and pure integer arithmetic
    // over them, with no division/modulo by zero)?
    bool IsConstInt(Node e) {
        if (e == null) { return false; }
        if (e.kind == AK.IntLit()) { return true; }
        if (e.kind == AK.Unary() && e.op == TK.Minus()) { return IsConstInt(e.a); }
        if (e.kind == AK.Binary() && IsFoldOp(e.op)) {
            if (!IsConstInt(e.a) || !IsConstInt(e.b)) { return false; }
            if (e.op == TK.Slash() || e.op == TK.Percent()) {
                if (EvalConstInt(e.b) == 0) { return false; }
            }
            return true;
        }
        return false;
    }

    long EvalConstInt(Node e) {
        if (e.kind == AK.IntLit()) { return e.IntLitValue(); }
        if (e.kind == AK.Unary()) { return 0 - EvalConstInt(e.a); }
        long a = EvalConstInt(e.a);
        long b = EvalConstInt(e.b);
        int op = e.op;
        if (op == TK.Plus()) { return a + b; }
        if (op == TK.Minus()) { return a - b; }
        if (op == TK.Star()) { return a * b; }
        if (op == TK.Slash()) { return a / b; }
        if (op == TK.Percent()) { return a % b; }
        return 0;
    }

    // The width in bits of a value's carrier -- the C host's LLVM storage
    // width. The type-level type does not record it: an arithmetic RESULT
    // keeps the width of the operation that produced it (the host's
    // coerce_int_pair widens the narrower operand and the result keeps that
    // width), so `int a; a * 3` has the type `int` but the host computes it
    // in 64 bits. `wbits` carries that width; 0 means "take it from the
    // type".
    int ValWidth(ExprVal v) {
        if (v == null) { return 0; }
        if (v.wbits > 0) { return v.wbits; }
        return HostIntWidth(v.ty);
    }

    // The C host's operand width: an int VARIABLE (a local, a field, a cast
    // result) keeps its storage width in the host, while an int LITERAL --
    // and every constant expression the host folds -- is an i64. The
    // operation takes the common width, so `a * 3` does not wrap at 32 bits
    // while `a * b` does.
    bool IsWidthedInt(Node en, ExprVal v) {
        if (v == null || v.ty == null) { return false; }
        if (v.ty.ival != 0) { return false; }
        if (ValWidth(v) == 0) { return false; }
        if (en == null) { return false; }
        if (en.kind == AK.IntLit()) { return false; }
        if (IsConstInt(en)) { return false; }
        return true;
    }

    // The storage width of an integer type in the C host (the host keeps the
    // narrow types narrow -- there is no integer promotion).
    int HostIntWidth(Node t) {
        if (t == null) { return 0; }
        string n = t.sval;
        if (n == "byte" || n == "sbyte") { return 8; }
        if (n == "short" || n == "ushort") { return 16; }
        if (n == "int" || n == "uint") { return 32; }
        if (n == "long" || n == "ulong" || n == "nint" || n == "char") { return 64; }
        return 0;
    }

    // The width of the arithmetic operation: the wider of the two storage
    // widths. A literal or folded-constant arm no longer forces 64 -- the
    // host's A510 narrowing computes int arithmetic in 32 bits even with a
    // literal arm (`a + 1` wraps at 32); the literal itself rides the other
    // arm's width, and a typed arm still decides (a `L` literal is a long).
    int ArithWidth(Node an, ExprVal av, Node bn, ExprVal bv) {
        int wa = ValWidth(av);
        int wb = ValWidth(bv);
        if (wa == 0 && wb == 0) { return 64; }
        if (wa == 0) { return wb; }
        if (wb == 0) { return wa; }
        if (wa > wb) { return wa; }
        return wb;
    }

    // The signedness of the operation's result: the wider operand decides,
    // and an unsigned one wins a tie (the host's common type).
    bool ArithUnsigned(Node an, ExprVal av, Node bn, ExprVal bv) {
        int wa = ValWidth(av);
        int wb = ValWidth(bv);
        bool ua = IntUnsigned(av == null ? null : av.ty);
        bool ub = IntUnsigned(bv == null ? null : bv.ty);
        if (wa > wb) { return ua; }
        if (wb > wa) { return ub; }
        return ua || ub;
    }

    // Bring an arithmetic result back into the operation's width: the host
    // computes the narrow types in their own width, so the result wraps
    // there (an int add wraps at 32 bits).
    string WrapArith(string v, int w, bool uns) {
        if (w <= 0 || w >= 64) { return v; }
        if (uns) {
            string m = "" + ((1L << w) - 1);
            string t = NT();
            L("  " + t + " = and i64 " + v + ", " + m);
            return t;
        }
        string s1 = NT();
        L("  " + s1 + " = shl i64 " + v + ", " + (64 - w));
        string s2 = NT();
        L("  " + s2 + " = ashr i64 " + s1 + ", " + (64 - w));
        return s2;
    }

    // The result of an integer arithmetic operation: the type-level type is
    // `int` (the host's checker types it that way), but the VALUE keeps the
    // width of the operation -- the parent operation sees that width, not
    // the 32-bit type.
    ExprVal ArithResult(string v, int aw, bool uns) {
        ExprVal r = new ExprVal(v, MkType(uns ? "ulong" : "int"));
        r.wbits = aw;
        return r;
    }

    // The C host's integer division guard (irgen_expr_ops.c TK_SLASH/TK_PERCENT):
    // a zero divisor and the MIN / -1 combination both divide by 1 instead of
    // trapping. The zero divisor goes through EmitRuntimeCheckIf -- the same
    // dual-track dispatch as the C host's emit_runtime_check: inside a user
    // try it throws a catchable DivideByZeroException, outside it soft-reports
    // and the program continues with the quotient of 1.
    string GuardDivisor(ExprVal a, ExprVal b, int op, Node e, int width, bool uns) {
        string isz = NT();
        L("  " + isz + " = icmp eq i64 " + b.op + ", 0");
        string msg = "division by zero";
        if (op == TK.Percent()) { msg = "division by zero (modulo)"; }
        EmitRuntimeCheckIf(e, isz, msg);
        string unsf = isz;
        if (!uns && width > 0) {
            string minv = "";
            if (width >= 64) { minv = "-9223372036854775808"; }
            else { minv = "" + (0 - (1L << (width - 1))); }
            string ismin = NT();
            L("  " + ismin + " = icmp eq i64 " + a.op + ", " + minv);
            string ism1 = NT();
            L("  " + ism1 + " = icmp eq i64 " + b.op + ", -1");
            string ovf = NT();
            L("  " + ovf + " = and i1 " + ismin + ", " + ism1);
            string u2 = NT();
            L("  " + u2 + " = or i1 " + isz + ", " + ovf);
            unsf = u2;
        }
        string d = NT();
        L("  " + d + " = select i1 " + unsf + ", i64 1, i64 " + b.op);
        divUnsafe = unsf;
        return d;
    }

}
