using System;
using System.Collections.Generic;
using System.Diagnostics;
using System.IO;
using System.Interop;
namespace Zan;


// Self-hosted compiler driver. Mirrors src/compiler/main.c for the bootstrap
// subset. Usage:
//
//   zanc <output.ll> <input1.zan> [input2.zan ...]
//
// All inputs are concatenated into a single translation unit (they share one
// namespace), lexed, parsed, bound, checked and lowered to LLVM IR text which
// is written to <output.ll> or passed to the bundled LLVM tools for native output.
//
// Like the C host, stdlib modules are auto-included by PATH: every
// `using X.Y.Z;` directive maps to <stdlib_root>/X/Y/Z, resolved to a
// fixpoint (a pulled-in module may itself `using` another namespace).
// stdlib_root is discovered relative to the compiler executable
// (exe_dir/../stdlib, else exe_dir/stdlib).
//
// Pull-in is demand-driven (the C host's pi_* filter): user sources seed a
// live-name set, globbed stdlib files carry only lexed metadata, and a file
// joins the parse when a live name can reach it -- see the Pi* classes and
// PiSeedSource/PiCloseOnce below.

// ---- demand-driven stdlib pull-in (port of the C host's pi_* filter) ----
//
// The glob-everything scan compiles every *.zan under each `using`-ed
// namespace even when the program names a handful of types (`using System;`
// parses 100+ files for one Console call). With the filter, globbed files
// join the parse only when something live can name them:
//
//   - every identifier in the already-included user sources seeds a live
//     name set (a deliberate over-approximation: namespace segments, member
//     names and keywords only ever add candidates, never remove them);
//   - a reached directory is scanned once per file with the real lexer for
//     metadata only -- top-level declared type names, `using` directives, an
//     extension-method marker and its own identifier set. No parse, no AST,
//     so the scan is an order of magnitude cheaper than a parse;
//   - a file joins the parse when one of its top-level names is live, or
//     when it hosts extension methods (an extension call names the receiver
//     and the method, never the host class, so the host file needs its own
//     trigger);
//   - including a file makes its identifiers live and reaches its `using`
//     directories; the closure runs to a fixpoint before any file parses.
//
// Observable semantics are preserved: every name user code spells pulls the
// declaring file exactly as the full glob did, so simple-name collision
// mangling sees the same declaration pairs, and prune keeps everything
// transitively referenced. What disappears is the parse of files whose names
// appear nowhere reachable -- and with it the failure mode where a syntax
// error in an unreachable stdlib file failed unrelated programs.
public partial class Program {
    [DllImport("crt")] static extern long fopen(string path, string mode);
    [DllImport("crt")] static extern long fread(byte[] buf, long size, long count, long f);
    [DllImport("crt")] static extern long fclose(long f);

    static string stdlibRoot;
    static string packageProject;
    static bool publishing;
    static List<string> inclPaths;
    static List<string> inclSrcs;

    static string NormPath(string p) {
        if (p == null || p == "") { return ""; }
        string s = NormalizePath(p);
        if (!s.StartsWith("/") && (s.Length < 2 || s[1] != ':')) {
            string cwd = NormalizePath(Directory.GetCurrentDirectory());
            if (cwd != "") { s = NormalizePath(cwd + "/" + s); }
        }
        // 文件身份键：只有 Windows 文件系统大小写不敏感。POSIX 上一律转小写
        // 会把 /Users/... 变成 /users/...，下游拿它当文件路径用，stdlib 归属
        // 判定随之失配（fixed_point 门在 Mac 上 882 个"未定义类型"）。
        return OperatingSystem.IsWindows() ? s.ToLower() : s;
    }

    static bool Included(string norm) {
        int i = 0;
        while (i < inclPaths.Count) {
            if (inclPaths[i] == norm) { return true; }
            i = i + 1;
        }
        return false;
    }

    static void AddInput(string path) {
        string norm = Path.GetFullPath(path);
        #if WINDOWS
        norm = norm.Replace("\\", "/").ToLower();
        #endif
        if (Included(norm)) { return; }
        inclPaths.Add(norm);
        inclSrcs.Add(File.ReadAllText(path));
    }

    // ---- 输入参数展开：@响应文件 + 目录递归（对齐 C 宿主 main.c，A450） ----
    // 宿主 808851f49 起 zanc 接受目录输入（递归 *.zan、跳过点开头/符号链接/
    // 工程杂质目录、序数排序）与 @file（空白分词、# 注释、引号短语、可嵌套、
    // 深度 ≤ 8）。自举驱动此前只认显式文件列表——编大项目同样会撞 Windows
    // 命令行长度上限。排序用 List<string>.Sort()（CompareOrdinal），与宿主
    // qsort(strcmp) 同序；路径拼接统一 '/'，排序序仅在分隔符字节边界上可能
    // 与宿主不同（两侧各自确定即可，差分门比对的是程序 stdout）。
    static void AddSourceArgument(string token) {
        if (Directory.ExistsOnDisk(token)) {
            List<string> files = new List<string>();
            CollectDirSources(token, files);
            if (files.Count == 0) {
                Console.WriteLine("error: no .zan source files under '" + token + "'");
                throw "zanc: no .zan source files under directory";
            }
            files.Sort();
            int fi = 0;
            while (fi < files.Count) {
                AddInput(files[fi]);
                fi = fi + 1;
            }
            return;
        }
        AddInput(token);
    }

    static bool IsResponseArgument(string arg) {
        return arg.Length > 1 && arg[0] == '@';
    }

    static void ExpandArgument(string arg, List<string> args, int depth) {
        if (!IsResponseArgument(arg)) { args.Add(arg); return; }
        string path = arg.Substring(1);
        if (depth >= 8) {
            throw "zanc: argument file '" + path + "' nested too deeply";
        }
        string text = File.ReadAllText(path);
        int i = 0;
        if (text.Length >= 3 && (text[0] & 255) == 0xEF && (text[1] & 255) == 0xBB
            && (text[2] & 255) == 0xBF) {
            i = 3;
        }
        while (i < text.Length) {
            while (i < text.Length && (text[i] & 255) <= 32) { i++; }
            if (i == text.Length) { break; }
            if (text[i] == '#') {
                while (i < text.Length && text[i] != '\n') { i++; }
                continue;
            }
            StringBuilder token = new StringBuilder();
            bool quoted = false;
            int start = i;
            while (i < text.Length) {
                int c = text[i] & 255;
                if (c == 34) {
                    token.Append(text.Substring(start, i - start));
                    quoted = !quoted;
                    start = i + 1;
                } else if (!quoted && c <= 32) {
                    break;
                }
                i++;
            }
            token.Append(text.Substring(start, i - start));
            string value = token.ToString();
            if (value.Length != 0) { ExpandArgument(value, args, depth + 1); }
        }
    }

    // 与 C 宿主 skip_project_dir 同一名单（main.c:830）。
    static bool SkipProjectDir(string name) {
        if (name == ".zan-packages" || name == ".git" || name == ".svn"
            || name == ".hg" || name == "build" || name == "publish"
            || name == "bin" || name == "obj" || name == "node_modules"
            || name == "_scratch" || name == "dist" || name == "out"
            || name == "vendor") { return true; }
        return false;
    }

    static void CollectDirSources(string dir, List<string> files) {
        // GetFiles/GetDirectories 不递归、含隐藏；文件只按 .zan 后缀过滤
        // （隐藏文件照收，与宿主一致），目录跳过点开头/杂质/符号链接。
        List<string> names = Directory.GetFileNames(dir);
        int ni = 0;
        while (ni < names.Count) {
            string n = names[ni];
            if (n.Length >= 5 && n.Substring(n.Length - 4) == ".zan") {
                files.Add(dir + "/" + n);
            }
            ni = ni + 1;
        }
        List<string> dirs = Directory.GetDirectories(dir);
        int di = 0;
        while (di < dirs.Count) {
            string d = dirs[di];
            if ((int)d[0] == 46 || SkipProjectDir(d)) { di = di + 1; continue; }
            // 符号链接/junction 目录无需在这里排除：stdlib 的枚举在两个
            // 平台都把 reparse 目录按文件收（winList 的 0x400 位、posixList
            // 的"符号链接一律按文件收"），不会出现在 GetDirectories 里。
            CollectDirSources(dir + "/" + d, files);
            di = di + 1;
        }
    }

    static string FindStdlibRoot(string explicitPath) {
        if (explicitPath != "") { return explicitPath; }
        string envStdlib = Environment.GetEnvironmentVariable("ZAN_STDLIB_PATH");
        if (envStdlib != null && envStdlib.Length > 0 && Directory.ListNames(envStdlib + "/*") != "") {
            return envStdlib;
        }
        string envHome = Environment.GetEnvironmentVariable("ZAN_HOME");
        if (envHome != null && envHome.Length > 0 && Directory.ListNames(envHome + "/stdlib/*") != "") {
            return envHome + "/stdlib";
        }
        string exe = Environment.ExeDir();
        string up = exe + "/../stdlib";
        if (Directory.ListNames(up + "/*") != "") { return up; }
        string up2 = exe + "/../../stdlib";
        if (Directory.ListNames(up2 + "/*") != "") { return up2; }
        string up3 = exe + "/../../../stdlib";
        if (Directory.ListNames(up3 + "/*") != "") { return up3; }
        string sib = exe + "/stdlib";
        if (Directory.ListNames(sib + "/*") != "") { return sib; }
        return "stdlib";
    }

    // ---- package stores (the C host's package.c + auto_include_namespace):
    // a using namespace with no stdlib directory also reaches installed
    // packages' source trees, scanned in the C host's store order ----
    static string pkgProjectRoot;   // nearest zan.proj owner of the input
    static string pkgExeStore;      // toolchain sibling packages/
    static string pkgRepoStore;     // repository root packages/
    static string pkgGlobalStore;   // ~/.local/share/zan/packages (or XDG)

    static string PkgParentDir(string path) {
        if (path == null || path.Length == 0) { return "."; }
        string p = path.Replace("\\", "/");
        while (p.Length > 1 && p.EndsWith("/")) {
            p = p.Substring(0, p.Length - 1);
        }
        int last = p.LastIndexOf("/");
        if (last <= 0) { return "."; }
        return p.Substring(0, last);
    }

    // An installed project store owns its sources even inside a repository checkout.
    static string ResolvePkgProjectRoot(string input) {
        if (packageProject != null && packageProject != "") { return packageProject; }
        string dir = PkgParentDir(input);
        for (;;) {
            if (File.Exists(dir + "/zan.proj") || Directory.Exists(dir + "/.zan-packages")
                || Directory.Exists(dir + "/packages")) {
                return dir;
            }
            string parent = PkgParentDir(dir);
            if (parent == dir || parent == "") { break; }
            dir = parent;
        }
        return ".";
    }

    static string NormalizePath(string p) {
        if (p == null) { return ""; }
        string s = p.Replace("\\", "/");
        for (;;) {
            int dotdot = s.IndexOf("/../");
            if (dotdot <= 0) { break; }
            string prefix = s.Substring(0, dotdot);
            int prevSlash = prefix.LastIndexOf("/");
            if (prevSlash >= 0) {
                s = prefix.Substring(0, prevSlash) + s.Substring(dotdot + 3);
            } else {
                s = s.Substring(dotdot + 4);
            }
        }
        while (s.Length >= 2 && s.Substring(0, 2) == "./") {
            s = s.Substring(2);
        }
        return s;
    }

    static string FindClang() {
        string envClang = Environment.GetEnvironmentVariable("ZAN_CLANG");
        if (envClang != null && envClang.Length > 0 && File.Exists(envClang)) {
            return envClang;
        }
        string exe = Environment.ExeDir();
        if (File.Exists(exe + "/clang.exe")) { return exe + "/clang.exe"; }
        if (File.Exists(exe + "/clang")) { return exe + "/clang"; }
        if (File.Exists(exe + "/../bin/clang.exe")) { return exe + "/../bin/clang.exe"; }
        if (File.Exists(exe + "/../llvm/bin/clang.exe")) { return exe + "/../llvm/bin/clang.exe"; }

        string envLlvm = Environment.GetEnvironmentVariable("ZAN_LLVM_ROOT");
        if (envLlvm == null || envLlvm.Length == 0) {
            envLlvm = Environment.GetEnvironmentVariable("LLVM_ROOT");
        }
        if (envLlvm == null || envLlvm.Length == 0) {
            envLlvm = Environment.GetEnvironmentVariable("LLVM_HOME");
        }
        if (envLlvm != null && envLlvm.Length > 0) {
            if (File.Exists(envLlvm + "/bin/clang.exe")) { return envLlvm + "/bin/clang.exe"; }
            if (File.Exists(envLlvm + "/clang.exe")) { return envLlvm + "/clang.exe"; }
            if (File.Exists(envLlvm + "/bin/clang")) { return envLlvm + "/bin/clang"; }
        }

        string user = Environment.GetEnvironmentVariable("USERPROFILE");
        if (user != null && user.Length > 0) {
            string moz = user + "/.mozbuild/clang/bin/clang.exe";
            if (File.Exists(moz)) { return moz; }
        }

        string pf = Environment.GetEnvironmentVariable("ProgramFiles");
        if (pf != null && pf.Length > 0) {
            string pfLlvm = pf + "/LLVM/bin/clang.exe";
            if (File.Exists(pfLlvm)) { return pfLlvm; }
            string vsComm = pf + "/Microsoft Visual Studio/2022/Community/VC/Tools/Llvm/x64/bin/clang.exe";
            if (File.Exists(vsComm)) { return vsComm; }
            string vsPro = pf + "/Microsoft Visual Studio/2022/Professional/VC/Tools/Llvm/x64/bin/clang.exe";
            if (File.Exists(vsPro)) { return vsPro; }
            string vsEnt = pf + "/Microsoft Visual Studio/2022/Enterprise/VC/Tools/Llvm/x64/bin/clang.exe";
            if (File.Exists(vsEnt)) { return vsEnt; }
        }
        string pfW64 = Environment.GetEnvironmentVariable("ProgramW6432");
        if (pfW64 != null && pfW64.Length > 0) {
            string pfLlvm = pfW64 + "/LLVM/bin/clang.exe";
            if (File.Exists(pfLlvm)) { return pfLlvm; }
            string vsComm = pfW64 + "/Microsoft Visual Studio/2022/Community/VC/Tools/Llvm/x64/bin/clang.exe";
            if (File.Exists(vsComm)) { return vsComm; }
        }

        return "clang";
    }

    static void WriteMetadata(string path, string contents) {
        string destination = Path.GetFullPath(path);
        string suffix = Guid.New();
        string directory = Path.GetDirectoryName(destination) + "/.zanc-" + suffix;
        if (suffix == "" || !Nio.CreateDirectoryExclusive(directory)) {
            throw "zanc: cannot create a staging directory for " + path;
        }
        string staged = directory + "/declarations.json";
        try {
            File.WriteAllText(staged, contents);
            if (Nio.ReplaceFile(staged, destination) != 0) {
                throw "zanc: cannot publish metadata " + path;
            }
        } finally {
            File.Delete(staged);
            Directory.Delete(directory);
        }
    }

    static void StageNativeFiles(List<string> files, string workDir, string outputDir, string outputName) {
        Dictionary<string, string> staged = new Dictionary<string, string>();
        for (int i = 0; i < files.Count; i = i + 1) {
            string name = Path.GetFileName(files[i]);
            string key = name.ToLower();
            string dest = outputDir + "/" + name;
            if (key == outputName.ToLower()) { throw "zanc: driver bundle file conflicts with executable '" + dest + "'"; }
            string other = staged.ContainsKey(key) ? staged[key] : dest;
            if (File.Exists(other)) {
                byte[] a = File.ReadAllBytes(files[i]);
                byte[] b = File.ReadAllBytes(other);
                if (a.Length != b.Length || !NativeMemory.SequenceEqual((nint)a, (nint)b, a.Length)) {
                    throw "zanc: conflicting native bundle file '" + dest + "'";
                }
                continue;
            }
            string copy = workDir + "/native-" + i;
            staged[key] = copy;
            File.Copy(files[i], copy);
        }
        for (int i = 0; i < files.Count; i = i + 1) {
            string name = Path.GetFileName(files[i]);
            string key = name.ToLower();
            if (!staged.ContainsKey(key)) { continue; }
            File.Move(staged[key], outputDir + "/" + name);
            staged.Remove(key);
        }
    }

    static string BundledToolchain() {
        #if WINDOWS
        string dir = Environment.ExeDir();
        if (RuntimeInformation.RuntimeIdentifier == "win-x64"
            && File.Exists(dir + "/mingw/lib/crt2.o")) {
            if (!File.Exists(dir + "/opt.exe") || !File.Exists(dir + "/llc.exe")
                || !File.Exists(dir + "/ld.lld.exe")) {
                throw "zanc: incomplete bundled LLVM toolchain at '" + dir + "' (requires opt.exe, llc.exe and ld.lld.exe)";
            }
            return dir;
        }
        #endif
        return "";
    }

    static void CompileBundledObject(string dir, string llPath, string bitcodePath,
                                     string objPath, string optLevel, string archiveExports) {
        string target = "-mtriple=x86_64-w64-windows-gnu";
        List<string> optimize = new List<string>() { target, "-relocation-model=pic" };
        string passSuffix = (optLevel == "-Os" || optLevel == "-Oz") ? ",mergefunc,globaldce" : "";
        if (archiveExports == "") {
            if (optLevel == "-O0") {
                optimize.Add("-passes=verify");
            } else if (passSuffix != "") {
                optimize.Add("-passes=default<" + optLevel.Substring(1) + ">" + passSuffix);
            } else {
                optimize.Add(optLevel);
            }
        } else {
            optimize.Add("--internalize-public-api-file=" + archiveExports);
            optimize.Add(optLevel == "-O0" ? "-passes=internalize,globaldce,verify"
                : "-passes=internalize,default<" + optLevel.Substring(1) + ">" + passSuffix);
        }
        optimize.Add(llPath); optimize.Add("-o"); optimize.Add(bitcodePath);
        int rc = Process.RunWithStandardStreams(dir + "/opt.exe", optimize);
        if (rc != 0) { throw "zanc: LLVM optimization failed with exit code " + rc; }

        string codegen = optLevel == "-Os" || optLevel == "-Oz" ? "-O2" : optLevel;
        List<string> emit = new List<string>() {
            target, "-relocation-model=pic", "-filetype=obj",
            "-function-sections", "-data-sections", codegen, bitcodePath, "-o", objPath
        };
        rc = Process.RunWithStandardStreams(dir + "/llc.exe", emit);
        if (rc != 0) { throw "zanc: LLVM object emission failed with exit code " + rc; }
    }

    static void LinkBundledImage(string dir, string outPath, string objPath, string subsystem,
                                 List<string> linkInputs, bool stripSymbols,
                                 string importPath, string exportsPath) {
        string lib = dir + "/mingw/lib";
        bool dll = importPath != "";
        List<string> args = new List<string>();
        args.Add("-m"); args.Add("i386pep");
        args.Add("-Bdynamic");
        if (dll) {
            args.Add("-shared");
            args.Add("-e"); args.Add("DllMainCRTStartup");
            args.Add("--out-implib"); args.Add(importPath);
            args.Add("--exclude-all-symbols");
            args.Add(exportsPath);
        } else {
            args.Add("--stack"); args.Add("268435456");
            if (subsystem != "") { args.Add("--subsystem"); args.Add(subsystem); }
        }
        args.Add("--gc-sections");
        if (stripSymbols) {
            args.Add("-s");
            args.Add("--icf=safe");
            args.Add("-O2");
        }
        args.Add("-o"); args.Add(outPath);
        args.Add("-L" + lib);
        args.Add(lib + (dll ? "/dllcrt2.o" : "/crt2.o"));
        args.Add(lib + "/crtbegin.o");
        args.Add(objPath);
        args.Add(dir + "/zanrt_file.obj");
        args.Add(dir + "/zanrt_io.obj");
        args.Add(dir + "/zanrt_timer.obj");
        args.Add(dir + "/zanrt_sync.obj");
        args.Add(dir + "/zanrt_decimal.obj");
        args.Add(dir + "/zan_embed_api.obj");
        args.Add(dir + "/zanrt_crash.obj");
        args.Add(dir + "/zan_inflate.obj");
        args.Add(dir + "/libzancrypto.a");
        args.Add("--start-group");
        for (int i = 0; i < linkInputs.Count; i = i + 1) { args.Add(linkInputs[i]); }
        args.Add("-lmingw32"); args.Add("-lgcc"); args.Add("-lgcc_eh");
        args.Add("-lsupc++"); args.Add("-lmoldname"); args.Add("-lmingwex");
        args.Add("-lmsvcrt"); args.Add("-lkernel32"); args.Add("-lshell32");
        args.Add("-luser32"); args.Add("-ladvapi32"); args.Add("-lversion");
        args.Add("-lws2_32"); args.Add("-lbcrypt"); args.Add("-l:libwinpthread.a");
        args.Add("--end-group");
        args.Add(lib + "/crtend.o");
        int rc = Process.RunWithStandardStreams(dir + "/ld.lld.exe", args);
        if (rc != 0) { throw "zanc: linking failed with exit code " + rc; }
    }

    static void PublishDll(string source, string destination, string importSource, string importDestination,
                           string workDir) {
        #if WINDOWS
        nint outputLock = Nio.LockOutput(importDestination + ".lock");
        if (outputLock == -1) { throw "zanc: cannot lock DLL output '" + destination + "'"; }
        string backup = workDir + "/previous-import.a";
        bool keepBackup = false;
        try {
            bool hadImport = File.Exists(importDestination);
            if (hadImport) { File.Copy(importDestination, backup); }
            if (Nio.ReplaceFile(importSource, importDestination) != 0) {
                throw "zanc: cannot publish import library '" + importDestination + "'";
            }
            if (Nio.ReplaceFile(source, destination) != 0) {
                if (hadImport) {
                    if (Nio.ReplaceFile(backup, importDestination) != 0) {
                        keepBackup = true;
                        throw "zanc: cannot restore the previous import library '" + importDestination
                            + "'; backup at '" + backup + "'";
                    }
                } else {
                    File.Delete(importDestination);
                }
                throw "zanc: cannot publish DLL '" + destination + "'";
            }
        } finally {
            if (!keepBackup) { File.Delete(backup); }
            Nio.CloseFileHandle(outputLock);
        }
        #endif
    }

    static void LinkExe(string clang, string outPath, string llPath, string optLevel, string subsystem,
                        List<string> linkInputs, bool stripSymbols, bool debug) {
        string exe = Environment.ExeDir();
        string rtDir = exe;
        if (!File.Exists(rtDir + "/zanrt_sh_rt_file.obj")) {
            if (File.Exists(exe + "/../zanrt_sh_rt_file.obj")) {
                rtDir = exe + "/..";
            } else if (File.Exists(exe + "/../build/zanrt_sh_rt_file.obj")) {
                rtDir = exe + "/../build";
            }
        }
        List<string> args = new List<string>();
        args.Add(optLevel != null && optLevel.Length > 0 ? optLevel : "-O2");
        args.Add("-Wno-override-module");
        ProcessResult target = Process.CaptureSafe(clang, new List<string>() { "-print-target-triple" }, 10000);
        if (!target.Ok()) { throw "zanc: cannot determine Clang's Windows target"; }
        List<string> lines = target.Lines();
        if (lines.Count == 0) { throw "zanc: Clang returned no Windows target"; }
        if (lines[0].Contains("-msvc")) {
            if (stripSymbols) {
                args.Add("-Wl,/OPT:REF");
                args.Add("-Wl,/OPT:ICF");
            }
            if (debug) { args.Add("-Wl,/debug:dwarf"); }
            if (subsystem != "") { args.Add("-Wl,/subsystem:" + subsystem); }
            if (subsystem == "windows") { args.Add("-Wl,/entry:mainCRTStartup"); }
        } else if (lines[0].Contains("apple") || lines[0].Contains("darwin")) {
            args.Add("-Wl,-dead_strip");
            if (stripSymbols) { args.Add("-Wl,-S"); }
            if (debug) { args.Add("-g"); }
        } else {
            args.Add("-ffunction-sections");
            args.Add("-fdata-sections");
            args.Add("-Wl,--gc-sections");
            if (stripSymbols) { args.Add("-s"); }
            if (debug) { args.Add("-g"); }
            if (subsystem != "") { args.Add(subsystem == "windows" ? "-mwindows" : "-mconsole"); }
        }
        args.Add(llPath);
        if (File.Exists(rtDir + "/zanrt_sh_rt_file.obj")) {
            args.Add(rtDir + "/zanrt_sh_rt_file.obj");
            args.Add(rtDir + "/zanrt_sh_rt_io.obj");
            args.Add(rtDir + "/zanrt_sh_rt_timer.obj");
            args.Add(rtDir + "/zanrt_sh_rt_decimal.obj");
            args.Add(rtDir + "/zanrt_sh_rt_sync.obj");
            args.Add(rtDir + "/zanrt_sh_zan_embed_api.obj");
            if (File.Exists(rtDir + "/zanrt_sh_rt_crash.obj")) {
                args.Add(rtDir + "/zanrt_sh_rt_crash.obj");
            } else if (File.Exists(rtDir + "/zanrt_sh_rt_crash.o")) {
                args.Add(rtDir + "/zanrt_sh_rt_crash.o");
            }
            args.Add(rtDir + "/libzancrypto_sh.a");
        } else if (File.Exists(rtDir + "/zanrt_file.obj")) {
            args.Add(rtDir + "/zanrt_file.obj");
            args.Add(rtDir + "/zanrt_io.obj");
            args.Add(rtDir + "/zanrt_timer.obj");
            args.Add(rtDir + "/zanrt_sync.obj");
            args.Add(rtDir + "/zanrt_decimal.obj");
            if (File.Exists(rtDir + "/zan_embed_api.obj")) {
                args.Add(rtDir + "/zan_embed_api.obj");
            }
            if (File.Exists(rtDir + "/zanrt_crash.obj")) {
                args.Add(rtDir + "/zanrt_crash.obj");
            } else if (File.Exists(rtDir + "/zanrt_crash.o")) {
                args.Add(rtDir + "/zanrt_crash.o");
            }
            if (File.Exists(rtDir + "/libzancrypto.a")) {
                args.Add(rtDir + "/libzancrypto.a");
            }
        }
        int i = 0;
        while (i < linkInputs.Count) {
            args.Add(linkInputs[i]);
            i = i + 1;
        }
        args.Add("-lkernel32");
        args.Add("-lshell32");
        args.Add("-luser32");
        args.Add("-ladvapi32");
        args.Add("-lversion");
        args.Add("-lws2_32");
        args.Add("-lbcrypt");
        args.Add("-o");
        args.Add(outPath);
        int rc = Process.RunWithStandardStreams(clang, args);
        if (rc != 0) {
            throw "zanc: linking failed with exit code " + rc;
        }
    }

    // Bootstrap identity (B-ID189): the differential report stamps both
    // compilers' --version output, so the self-hosted driver must name its
    // generation and stay version-locked with the C host. bump_version.ps1
    // keeps this literal in sync with the VERSION file; the diff gate fails
    // when the two drift apart.
    static string SelfhostVersion() { return "0.2.22"; }

    internal static long ReportPhase(bool enabled, string phase, long start) {
        if (!enabled) { return 0; }
        long now = Stopwatch.GetMicroseconds();
        Console.ErrorWriteLine("[time] " + phase + ": " + (now - start) / 1000 + " ms");
        return now;
    }

    static string Usage() { return "usage: zanc <input.zan|dir|@file> [more ...] [-o output]"; }

    static void PrintHelp() {
        Console.ErrorWriteLine(Usage());
        Console.ErrorWriteLine("    --help, -h                 Show this help and exit");
        Console.ErrorWriteLine("    --diagnostics-format=jsonl  Emit tagged compiler diagnostics as JSON Lines on stderr");
        Console.ErrorWriteLine("    --diagnostics-format=text   Use human-readable compiler diagnostics (default)");
        Console.ErrorWriteLine("    --package-install <dir> --package-name <name> [--package-scope project|global]");
        Console.ErrorWriteLine("    --package-list-missing     Report unresolved imported namespaces without compiling");
        Console.ErrorWriteLine("    --no-packages               Disable package discovery");
        Console.ErrorWriteLine("    --emit-symbols <file>       Write the declaration symbol index");
    }

    static void InstallLocalPackage(string source, string name, string scope) {
        string project = packageProject == "" ? "." : packageProject;
        PackageInstallResult result = PackageStore.Install(source, name, project, scope);
        string status = "ZANPKG_STATUS action=install status=" + result.Status;
        if (result.Status != "invalid_scope" && result.Status != "missing_name" && result.Status != "invalid_source") {
            status = status + " package=" + name;
        }
        if (result.Success) { status = status + " scope=" + scope; }
        Console.ErrorWriteLine(status);
        if (result.Success && result.PluginId != "") {
            Console.ErrorWriteLine("ZANPKG_USAGE plugin_id=" + result.PluginId + " package=" + name + " scope=" + scope);
        }
        if (result.CleanupPath != "") {
            Console.ErrorWriteLine("zanc: could not remove package staging directory: " + result.CleanupPath);
        }
        if (!result.Success) { Environment.Exit(1); }
    }

    static void Main() {
        List<string> args = new List<string>();
        List<int> directArguments = new List<int>();
        for (int ai = 0; ai < Environment.ArgCount(); ai++) {
            string arg = Environment.ArgAt(ai);
            if (!IsResponseArgument(arg)) { directArguments.Add(args.Count); }
            ExpandArgument(arg, args, 0);
        }
        int argc = args.Count;
        if (argc >= 1 && args[0] == "--version") {
            Console.WriteLine("zanc " + SelfhostVersion() + " (gen1)");
            return;
        }
        if (argc >= 1 && args[0] == "--lsp") {
            LspServer.Run();
            return;
        }
        string outPath = "";
        bool hasDashO = false;
        bool emitLib = false;
        bool denyWarnings = false;
        bool diagnosticsJsonl = false;
        bool reportTime = false;
        string metadataPath = "";
        string symbolsPath = "";
        bool listMissingPackages = false;
        string explicitStdlib = "";
        string subsystem = "";
        string driverDir = "";
        string iconPath = "";
        bool noIcon = false;
        bool metadataBodies = false;
        bool allSources = false;
        packageProject = "";
        packagesDisabled = false;
        string installSource = "";
        string installName = "";
        string installScope = "project";
        string optLevel = "";
        bool stripSymbols = false;
        bool debug = false;
        bool runtimeChecks = true;
        bool staticDrivers = false;
        bool strictRuntime = false;
        int arcGuard = -1;
        int checkLeaks = -1;
        publishing = false;
        List<string> embedSpecs = new List<string>();
        List<string> rawInputs = new List<string>();
        List<string> linkInputs = new List<string>();
        List<string> libraryOptions = new List<string>();
        int firstInputIndex = -1;
        int i = 0;
        while (i < argc) {
            string a = args[i];
            if (a == "--help" || a == "-h") {
                PrintHelp();
                return;
            }
            if (a.StartsWith("--diagnostics-format=")) {
                if (a != "--diagnostics-format=jsonl" && a != "--diagnostics-format=text") {
                    Console.ErrorWriteLine("error: --diagnostics-format must be 'text' or 'jsonl'");
                    Environment.Exit(1);
                    return;
                }
                diagnosticsJsonl = a == "--diagnostics-format=jsonl";
                i = i + 1;
                continue;
            }
            if (a == "-o" || a == "--target" || a == "--package-project" || a == "--link-input"
                || a == "--gen-meta" || a == "--stdlib-path" || a == "--subsystem" || a == "--driver-dir"
                || a == "--icon" || a == "--embed" || a == "--link-mode" || a == "--link-lib"
                || a == "-L" || a == "--libpath" || a == "--package-install"
                || a == "--package-name" || a == "--package-scope" || a == "--emit-symbols") {
                if (i + 1 >= argc || args[i + 1] == ""
                    || args[i + 1].StartsWith("-")) {
                    throw "zanc: option '" + a + "' requires a value";
                }
            }
            if (a == "-o") {
                outPath = args[i + 1];
                hasDashO = true;
                i = i + 2;
                continue;
            }
            if (a == "-O0" || a == "-O1" || a == "-O2" || a == "-O3" || a == "-Os" || a == "-Oz") {
                optLevel = a;
                i = i + 1;
                continue;
            }
            if (a == "--publish") { publishing = true; i++; continue; }
            if (a == "--strip-symbols") { stripSymbols = true; i++; continue; }
            if (a == "--runtime-checks") { runtimeChecks = true; i++; continue; }
            if (a == "--no-runtime-checks") { runtimeChecks = false; i++; continue; }
            if (a == "--strict-runtime") { strictRuntime = true; i++; continue; }
            if (a == "--arc-guard" || a == "--no-arc-guard") { arcGuard = a == "--arc-guard" ? 1 : 0; i++; continue; }
            if (a == "--check-leaks" || a == "--no-check-leaks") { checkLeaks = a == "--check-leaks" ? 1 : 0; i++; continue; }
            if (a == "-g" || a == "--debug") { debug = true; i++; continue; }
            if (a == "-c" || a == "-S") {
                throw "zanc: option '" + a + "' is not supported by the self-hosted driver";
            }
            if (a == "--link-input") {
                // An absolute path cannot be interpreted as a clang flag or @response file.
                string input = Path.GetFullPath(args[i + 1]);
                if (!File.Exists(input)) {
                    throw "zanc: link input file does not exist: '" + input + "'";
                }
                linkInputs.Add(input);
                i = i + 2;
                continue;
            }
            if (a == "--link-lib") {
                string library = args[i + 1];
                if (!NativeManifestEntry.SafeName(library)) { throw "zanc: invalid link library name '" + library + "'"; }
                libraryOptions.Add("-l" + library);
                i = i + 2;
                continue;
            }
            if (a == "--libpath" || a.StartsWith("-L")) {
                bool separate = a == "--libpath" || a == "-L";
                string libraryDir = Path.GetFullPath(separate ? args[i + 1] : a.Substring(2));
                libraryOptions.Add("-L" + libraryDir);
                i = i + (separate ? 2 : 1);
                continue;
            }
            if (a == "--stdlib-path") {
                explicitStdlib = Path.GetFullPath(args[i + 1]);
                if (!Directory.ExistsOnDisk(explicitStdlib)) {
                    throw "zanc: standard library directory does not exist: '" + explicitStdlib + "'";
                }
                i = i + 2;
                continue;
            }
            if (a == "--subsystem") {
                subsystem = args[i + 1];
                if (subsystem != "windows" && subsystem != "console") {
                    throw "zanc: invalid PE subsystem '" + subsystem + "'; expected windows or console";
                }
                i = i + 2;
                continue;
            }
            if (a == "--link-mode") {
                string mode = args[i + 1];
                if (mode != "shared" && mode != "static") {
                    throw "zanc: --link-mode must be 'static' or 'shared'";
                }
                staticDrivers = mode == "static";
                i = i + 2;
                continue;
            }
            if (a == "--driver-dir") {
                driverDir = Path.GetFullPath(args[i + 1]);
                if (!Directory.ExistsOnDisk(driverDir)) {
                    throw "zanc: driver directory does not exist: '" + driverDir + "'";
                }
                i = i + 2;
                continue;
            }
            if (a == "--embed") {
                embedSpecs.Add(args[i + 1]);
                i = i + 2;
                continue;
            }
            if (a == "--icon") {
                iconPath = Path.GetFullPath(args[i + 1]);
                i = i + 2;
                continue;
            }
            if (a == "--no-icon") { noIcon = true; i = i + 1; continue; }
            if (a == "--package-project") { packageProject = args[i + 1]; i += 2; continue; }
            if (a == "--package-install") { installSource = args[i + 1]; i += 2; continue; }
            if (a == "--package-name") { installName = args[i + 1]; i += 2; continue; }
            if (a == "--package-scope") { installScope = args[i + 1]; i += 2; continue; }
            if (a == "--no-packages") { packagesDisabled = true; i++; continue; }
            if (a == "--package-list-missing") { listMissingPackages = true; i++; continue; }
            if (a == "--target") {
                string target = args[i + 1];
                if (target != "host") {
                    throw "zanc: target '" + target + "' is not supported by the self-hosted driver; only 'host' is supported";
                }
                i = i + 2;
                continue;
            }
            if (a == "--gen-meta") {
                metadataPath = args[i + 1];
                i = i + 2;
                continue;
            }
            if (a == "--emit-symbols") { symbolsPath = args[i + 1]; i += 2; continue; }
            if (a == "--time") { reportTime = true; i = i + 1; continue; }
            if (a == "--gen-meta-bodies") { metadataBodies = true; i = i + 1; continue; }
            if (a == "--no-pullin-filter") { allSources = true; i = i + 1; continue; }
            if (a == "--emit-lib") {
                emitLib = true;
                i = i + 1;
                continue;
            }
            if (a == "--deny-warnings") {
                denyWarnings = true;
                i = i + 1;
                continue;
            }
            if (a == "--auto-stdlib") {
                i = i + 1;
                continue;
            }
            if (a.StartsWith("-")) {
                throw "zanc: unknown option '" + a + "'";
            }
            if (firstInputIndex == -1) { firstInputIndex = i; }
            rawInputs.Add(a);
            i = i + 1;
        }
        if (installSource != "") {
            InstallLocalPackage(installSource, installName, installScope);
            return;
        }
        if (packageProject != "" && !Directory.ExistsOnDisk(packageProject)) {
            throw "zanc: package project directory does not exist: '" + packageProject + "'";
        }
        if (rawInputs.Count == 0) {
            Console.WriteLine(Usage());
            throw "zanc: no input files";
        }
        if (debug) { optLevel = "-O0"; }
        if (optLevel == "") { optLevel = publishing ? "-Os" : "-O2"; }
        stripSymbols = stripSymbols || publishing;
        bool exportMetadata = metadataPath != "";
        bool exportSymbols = symbolsPath != "" && !exportMetadata;
        bool declarationOutput = exportMetadata || exportSymbols;
        if (metadataBodies && !exportMetadata) { throw "zanc: --gen-meta-bodies requires --gen-meta"; }
        string first = rawInputs[0];
        bool firstFromResponse = !directArguments.Contains(firstInputIndex);
        bool legacyOutput = !declarationOutput && !listMissingPackages && !hasDashO && rawInputs.Count > 1 && !first.EndsWith(".zan")
            && !firstFromResponse && !first.StartsWith("@") && !Directory.ExistsOnDisk(first);
        if (legacyOutput) {
            outPath = first;
            rawInputs.RemoveAt(0);
        }
        long phaseStart = reportTime ? Stopwatch.GetMicroseconds() : 0;
        inclPaths = new List<string>();
        inclSrcs = new List<string>();
        int ri = 0;
        while (ri < rawInputs.Count) {
            AddSourceArgument(rawInputs[ri]);
            ri = ri + 1;
        }

        if (inclPaths.Count == 0) { throw "zanc: no input files"; }
        bool defaultOutput = !declarationOutput && !hasDashO && !legacyOutput;
        if (defaultOutput) {
            if (emitLib) { throw "zanc: --emit-lib requires an output path"; }
            #if WINDOWS
            string input = firstFromResponse ? inclPaths[0] : Path.GetFullPath(first);
            outPath = input.EndsWith(".zan") ? input.Substring(0, input.Length - 4) + ".exe" : input + ".exe";
            #else
            throw "zanc: native output inference is only supported on Windows; specify an IR output with -o";
            #endif
        }
        string outputExtension = Path.GetExtension(outPath).ToLower();
        bool isExe = outputExtension == ".exe" && !emitLib;
        bool isDll = outputExtension == ".dll" && !exportMetadata;
        bool isArchive = (outputExtension == ".lib" || outputExtension == ".a") && !exportMetadata;
        bool linkImage = isExe || isDll;
        bool nativeLibrary = isDll || isArchive;
        if ((linkInputs.Count > 0 || libraryOptions.Count > 0) && !linkImage && !exportMetadata) {
            throw "zanc: --link-input requires executable output or a Windows DLL";
        }
        if (subsystem != "" || driverDir != "") {
            #if WINDOWS
            if (!exportMetadata && (subsystem != "" && !isExe || driverDir != "" && !linkImage)) {
                throw "zanc: --subsystem and --driver-dir require executable output (a DLL also supports --driver-dir)";
            }
            #else
            throw "zanc: --subsystem and --driver-dir require a Windows host";
            #endif
        }
        if (nativeLibrary && BundledToolchain() == "") {
            throw "zanc: native library output requires the bundled Windows x64 toolchain";
        }

        if (!noIcon && iconPath != "" && !exportMetadata) {
            #if WINDOWS
            if (!isExe) { throw "zanc: --icon requires Windows executable output"; }
            if (!File.Exists(iconPath)) { throw "zanc: icon file does not exist: '" + iconPath + "'"; }
            #else
            throw "zanc: --icon requires a Windows host";
            #endif
        }

        // stdlib auto-include: demand-driven pull-in (mirrors the C
        // host). User sources seed the live-name set and the reached
        // directories; globbed stdlib files join the parse only when a
        // live name or an extension-method host requires them, to a
        // fixpoint, before anything parses.
        int explicitSourceCount = inclPaths.Count;
        stdlibRoot = FindStdlibRoot(explicitStdlib);
        PiInitPkg(inclPaths[0]);
            piDb = File.Exists("/tmp/zan_pullin_debug");
            PiInit();
            int pi = 0;
            while (pi < inclSrcs.Count) {
                PiSeedSource(inclSrcs[pi]);
                pi = pi + 1;
            }
            while (PiCloseOnce(allSources) == 1) { }
            int missingPackages = PiReportMissing();
            if (listMissingPackages) {
                Console.ErrorWriteLine("ZANPKG_STATUS action=list-missing status=ok count=" + missingPackages);
                Environment.Exit(missingPackages == 0 ? 0 : 3);
            }
            if (missingPackages > 0) {
                Console.ErrorWriteLine("error: " + missingPackages + " unresolved imported namespace(s); see ZANPKG_MISSING diagnostics above");
                Environment.Exit(3);
            }
            PiAppendIncluded();
            if (piDb) { Console.WriteLine("[pullin] total " + inclPaths.Count + " files"); }
            phaseStart = ReportPhase(reportTime, "source discovery (" + inclPaths.Count + " files)", phaseStart);

            StringBuilder srcSb = new StringBuilder();
            List<int> fileStarts = new List<int>();
            int nextLine = 1;
            int si = 0;
            while (si < inclSrcs.Count) {
                fileStarts.Add(nextLine);
                string body = inclSrcs[si];
                int nlc = 0;
                int ci = 0;
                while (ci < body.Length) {
                    if ((int)body[ci] == 10) { nlc = nlc + 1; }
                    ci = ci + 1;
                }
                nextLine = nextLine + nlc + 1;
                srcSb.Append(body);
                srcSb.Append("\n");
                si = si + 1;
            }
            string src = srcSb.ToString();

            Lexer lx = new Lexer(src, publishing);
            List<Token> toks = lx.Run();
            phaseStart = ReportPhase(reportTime, "lex", phaseStart);

            Diags d = new Diags();
            d.SetFiles(inclPaths, fileStarts);
            // invalid escapes in character literals, collected by the lexer
            // (B-ID219): same host wording, reported at the literal's loc
            int emi = 0;
            while (emi < lx.escMsgs.Count) {
                d.Error(lx.escMsgs[emi], lx.escMsgLine[emi], lx.escMsgCol[emi]);
                emi = emi + 1;
            }
            Parser ps = new Parser(toks, d);
            ps.SetFileBounds(fileStarts);
            if (declarationOutput) {
                List<string> originalNames;
                Node declarations = ps.ParseMetadata(out originalNames);
                if (d.HasErrors() || (denyWarnings && d.HasWarnings())) {
                    d.Report(src, 0, diagnosticsJsonl, denyWarnings);
                    d.Summary();
                    throw "zanc: metadata export failed";
                }
                if (exportSymbols) {
                    WriteMetadata(symbolsPath, SymbolIndex.Export(declarations));
                } else {
                    if (metadataBodies) { PiPkgIdxEnsure(); }
                    MetadataExporter exporter = new MetadataExporter(inclPaths, fileStarts, stdlibRoot, pkgSourceRoots, metadataBodies);
                    WriteMetadata(metadataPath, exporter.Export(declarations, originalNames));
                }
                ReportPhase(reportTime, exportSymbols ? "symbols" : "metadata", phaseStart);
                return;
            }
            Node unit = ps.ParseUnit();
            phaseStart = ReportPhase(reportTime, "parse", phaseStart);

            Binder b = new Binder();
            b.Bind(unit);
            phaseStart = ReportPhase(reportTime, "bind", phaseStart);

            Checker chk = new Checker(b, d);
            chk.Check(unit);
            phaseStart = ReportPhase(reportTime, "check", phaseStart);
            d.Report(src, 0, diagnosticsJsonl, denyWarnings);
            int reported = d.Count();
            if (d.HasErrors() || (denyWarnings && d.HasWarnings())) {
                d.Summary();
                if (!d.HasErrors()) { throw "zanc: compilation failed: warnings denied by --deny-warnings"; }
                throw "zanc: compilation failed";
            }

            Irgen ig = new Irgen(b, d);
            ig.libOut = emitLib || nativeLibrary;
            if (nativeLibrary) {
                ig.nativeLibraryDependencyLine = explicitSourceCount < fileStarts.Count
                    ? fileStarts[explicitSourceCount] : nextLine;
            }
            #if WINDOWS
            ig.collectNativeImports = linkImage;
            ig.runtimeChecks = runtimeChecks;
            ig.strictRuntime = strictRuntime;
            #endif
            ig.arcGuard = arcGuard < 0 ? debug && !publishing : arcGuard == 1;
            ig.arcNet = arcGuard < 0 && publishing;
            ig.checkLeaks = checkLeaks < 0 ? debug && !publishing : checkLeaks == 1;
            ig.PrepareEmbedResources(embedSpecs);
            string ir = ig.Gen(unit, reportTime, debug);
            phaseStart = ReportPhase(reportTime, "IR generation", phaseStart);
            // The checker phase already reported its own diagnostics; the
            // second flush must start at the irgen phase's first item or
            // every warning prints twice (W2072 probe printed each twice).
            d.Report(src, reported, diagnosticsJsonl, denyWarnings);
            if (d.HasErrors() || (denyWarnings && d.HasWarnings())) {
                d.Summary();
                if (!d.HasErrors()) { throw "zanc: compilation failed: warnings denied by --deny-warnings"; }
                throw "zanc: compilation failed";
            }
            if (linkImage || isArchive) {
                string finalPath = Path.GetFullPath(outPath);
                string outputDir = Path.GetDirectoryName(finalPath);
                string clang = Environment.GetEnvironmentVariable("ZAN_CLANG");
                string toolchain = !nativeLibrary && clang != null && File.Exists(clang) ? "" : BundledToolchain();
                string nm = toolchain + "/llvm-nm.exe";
                if (toolchain == "") {
                    clang = FindClang();
                    string dir = Path.GetDirectoryName(clang);
                    nm = dir + "/llvm-nm.exe";
                    if (dir == "" || !File.Exists(nm)) { nm = "llvm-nm.exe"; }
                }
                List<string> bundleFiles = new List<string>();
                List<string> libraries = new List<string>();
                if (ig.collectNativeImports) { ResolveNativeImports(ig, nm, driverDir, linkInputs, bundleFiles, libraries, staticDrivers); }
                for (int i = 0; i < libraryOptions.Count; i++) { linkInputs.Add(libraryOptions[i]); }
                for (int i = 0; i < libraries.Count; i++) { linkInputs.Add(libraries[i]); }
                string suffix = Guid.New();
                string workDir = outputDir + "/.zanc-" + suffix;
                if (suffix.Length == 0 || !Nio.CreateDirectoryExclusive(workDir)) {
                    throw "zanc: cannot create a staging directory for " + outPath;
                }
                string llPath = workDir + "/module.ll";
                string bitcodePath = workDir + "/module.bc";
                string objPath = workDir + "/module.obj";
                string imageName = Path.GetFileName(finalPath);
                string imagePath = isDll ? workDir + "/image/" + imageName : workDir + "/output" + outputExtension;
                string importName = "lib" + Path.GetFileNameWithoutExtension(imageName) + ".dll.a";
                string importPath = isDll ? workDir + "/" + importName : "";
                string exportsPath = workDir + (isDll ? "/exports.def" : "/exports.txt");
                string resPath = workDir + "/icon.res";
                try {
                    if (!noIcon && iconPath != "") {
                        WriteIconResource(iconPath, resPath);
                        linkInputs.Add(resPath);
                    }
                    File.WriteAllText(llPath, ir);
                    if (toolchain == "") {
                        LinkExe(clang, imagePath, llPath, optLevel, subsystem, linkInputs, stripSymbols, debug && !stripSymbols);
                    } else {
                        if (nativeLibrary) {
                            StringBuilder exports = new StringBuilder();
                            if (isDll) { exports.Append("EXPORTS\n"); }
                            for (int ei = 0; ei < ig.sinitExportRoots.Count; ei++) {
                                exports.Append(ig.sinitExportRoots[ei]); exports.Append("\n");
                            }
                            File.WriteAllText(exportsPath, exports.ToString());
                        }
                        CompileBundledObject(toolchain, llPath, bitcodePath, objPath, optLevel,
                            isArchive ? exportsPath : "");
                        if (isArchive) {
                            string ar = toolchain + "/llvm-ar.exe";
                            if (!File.Exists(ar)) { throw "zanc: missing bundled archive tool '" + ar + "'"; }
                            List<string> archiveArgs = new List<string>() { "--format=gnu", "rcsD", imagePath, objPath };
                            int rc = Process.RunWithStandardStreams(ar, archiveArgs);
                            if (rc != 0) { throw "zanc: static library creation failed with exit code " + rc; }
                        } else {
                            if (isDll && !Nio.CreateDirectoryExclusive(workDir + "/image")) {
                                throw "zanc: cannot create DLL staging directory";
                            }
                            LinkBundledImage(toolchain, imagePath, objPath, subsystem, linkInputs, stripSymbols,
                                importPath, exportsPath);
                        }
                    }
                    StageNativeFiles(bundleFiles, workDir, outputDir, imageName);
                    if (isDll) {
                        PublishDll(imagePath, finalPath, importPath, outputDir + "/" + importName, workDir);
                    } else if (Nio.ReplaceFile(imagePath, finalPath) != 0) {
                        throw "zanc: cannot publish output " + outPath;
                    }
                } finally {
                    File.Delete(llPath);
                    File.Delete(bitcodePath);
                    File.Delete(objPath);
                    File.Delete(imagePath);
                    File.Delete(resPath);
                    File.Delete(exportsPath);
                    if (isDll) { File.Delete(importPath); Directory.Delete(workDir + "/image"); }
                    for (int fi = 0; fi < bundleFiles.Count; fi = fi + 1) {
                        File.Delete(workDir + "/native-" + fi);
                    }
                    Directory.Delete(workDir);
                }
            } else {
                File.WriteAllText(outPath, ir);
            }
            ReportPhase(reportTime, "output", phaseStart);
            Console.WriteLine("Compiled " + inclPaths.Count + " files -> '" + outPath + "'");
    }
}
