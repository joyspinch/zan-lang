using System;
using System.Collections.Generic;
namespace Zan;

// Irgen part: async/await CPS lowering (heap frames, resume steps) and
// await A-normal-form normalization.
partial class Irgen {
    // ===== async / await CPS lowering =====
    // Uniform heap frame is a flat i64 array. The header is the C host's
    // numbering, so the released runtime can drive a self-hosted frame
    // (zan_co_fhdr: the CO_* bits and the pending step come first):
    //   0=sched 1=sched_step 2=state 3=done 4=awaiter 5=awaiter_step
    //   6=result 7=cleanup 8=hcount 9=own_resume
    // `sched` and `sched_step` belong to the scheduler (the runtime writes
    // the CO_* bits and the pending step there); the self-host leaves them
    // zero. Then (for instance methods) the receiver, then params, then
    // frame-resident locals, then one sub-task slot per await point.
    // `cleanup` is a void(i8*) fn releasing every owned slot and freeing the
    // frame; `hcount` counts this frame's armed try handlers. Both drive
    // @__zan_async_unwind: an exception longjmps straight to its handler,
    // skipping suspended frames in between, and the unwinder walks the
    // awaiter chain calling each skipped frame's cleanup, stopping at the
    // first frame with an armed handler (execution resumes there).
    //
    // Ownership across suspension: the frame owns exactly one +1 reference for
    // every live ARC value it captures. The receiver and ARC params are
    // retained once in the ramp (so they outlive the caller's frame) and
    // released once when the coroutine completes. ARC locals get their +1 from
    // their initializer / assignment (mirroring normal codegen) and are
    // released by the same completion epilogue. Reload/save across an await
    // only copies the pointer bits -- it never changes a refcount.
    string ToI64(string v, string lt) {
        if (lt == "i64") { return v; }
        string r = NT();
        if (lt == "double") { L("  " + r + " = bitcast double " + v + " to i64"); return r; }
        if (lt == "i1" || lt == "i8" || lt == "i16" || lt == "i32") {
            L("  " + r + " = zext " + lt + " " + v + " to i64");
            return r;
        }
        if (v == "null" || v == "0") { return "0"; }
        L("  " + r + " = ptrtoint " + lt + " " + v + " to i64");
        return r;
    }
    string FromI64(string v, string lt) {
        if (lt == "i64") { return v; }
        string r = NT();
        if (lt == "double") { L("  " + r + " = bitcast i64 " + v + " to double"); return r; }
        if (lt == "i1" || lt == "i8" || lt == "i16" || lt == "i32") {
            L("  " + r + " = trunc i64 " + v + " to " + lt);
            return r;
        }
        L("  " + r + " = inttoptr i64 " + v + " to " + lt);
        return r;
    }
    string FrameGep(string bp, int idx) {
        string p = NT();
        L("  " + p + " = getelementptr i64, i64* " + bp + ", i64 " + idx);
        return p;
    }
    // An async method called as a statement (fire-and-forget): the call itself
    // only allocates the frame -- the body runs from $resume. Hand the frame
    // to the cooperative scheduler, or the body never runs at all (the C host
    // does the same at the call site, irgen_call.c emit_detach_async_call).
    // The resume entry is read from the frame's slot 9 (the ramp wrote it
    // there), so this also works when the callee was reached through a
    // dispatch instead of a named symbol.
    void EmitAsyncDetach(ExprVal v) {
        if (!v.asyncCall) { return; }
        string subv = v.op;
        string subh = NT();
        L("  " + subh + " = bitcast i8* " + subv + " to i64*");
        string orp = FrameGep(subh, 9);
        string ori = NT(); L("  " + ori + " = load i64, i64* " + orp);
        string orfn = NT(); L("  " + orfn + " = inttoptr i64 " + ori + " to void(i8*)*");
        L("  call void @zan_co_ready(i8* " + subv + ", void(i8*)* " + orfn + ")");
    }
    // The frame pointer an async call returns (the ramp allocated it).
    ExprVal AsyncFrame(string op, Node ty) {
        ExprVal v = new ExprVal(op, ty);
        v.asyncCall = true;
        return v;
    }
    void EmitAsyncSaveSlots() {
        int i = 0;
        while (i < asyncSlotReg.Count) {
            string lt = MapType(asyncSlotTy[i]);
            string v = NT();
            L("  " + v + " = load " + lt + ", " + lt + "* " + asyncSlotReg[i]);
            string vi = ToI64(v, lt);
            string p = FrameGep("%ff", asyncSlotIdx[i]);
            L("  store i64 " + vi + ", i64* " + p);
            i = i + 1;
        }
    }
    // adjust this frame's armed-try-handler count (header slot 8)
    void EmitAsyncHcAdd(int d) {
        string p = FrameGep("%ff", 8);
        string v = NT();
        L("  " + v + " = load i64, i64* " + p);
        string v1 = NT();
        L("  " + v1 + " = add i64 " + v + ", " + d);
        L("  store i64 " + v1 + ", i64* " + p);
    }
    void EmitAsyncReloadSlots() {
        int i = 0;
        while (i < asyncSlotReg.Count) {
            string lt = MapType(asyncSlotTy[i]);
            string p = FrameGep("%ff", asyncSlotIdx[i]);
            string vi = NT();
            L("  " + vi + " = load i64, i64* " + p);
            string v = FromI64(vi, lt);
            L("  store " + lt + " " + v + ", " + lt + "* " + asyncSlotReg[i]);
            i = i + 1;
        }
    }
    bool IsAwaitStmt(Node s) {
        if (s == null) { return false; }
        int k = s.kind;
        if (k == AK.VarDecl()) { return s.b != null && s.b.kind == AK.AwaitExpr(); }
        if (k == AK.ReturnStmt()) { return s.a != null && s.a.kind == AK.AwaitExpr(); }
        if (k == AK.ExprStmt()) {
            Node e = s.a;
            if (e == null) { return false; }
            if (e.kind == AK.AwaitExpr()) { return true; }
            if (e.kind == AK.Assignment() && e.b != null && e.b.kind == AK.AwaitExpr()) { return true; }
            return false;
        }
        return false;
    }

    // ---- await normalization ----
    // CPS lowering suspends with `ret void` and re-enters at a resume label, so
    // SSA values computed earlier in the same expression would not dominate the
    // resume block. Statements are therefore rewritten so `await` only appears
    // in the root positions GenAwaitStmt lowers: each embedded await is hoisted
    // into a fresh temp declared immediately before the statement, preserving
    // left-to-right await order.
    public int awHoistN;

    bool ExprHasAwait(Node e) {
        if (e == null) { return false; }
        if (e.kind == AK.Lambda()) { return false; }
        if (e.kind == AK.AwaitExpr()) { return true; }
        if (ExprHasAwait(e.a)) { return true; }
        if (ExprHasAwait(e.b)) { return true; }
        if (ExprHasAwait(e.c)) { return true; }
        if (ExprHasAwait(e.d)) { return true; }
        int i = 0;
        while (i < e.kids.Count) {
            if (ExprHasAwait(e.kids[i])) { return true; }
            i = i + 1;
        }
        return false;
    }

    // Declared type of a name: method params, then VarDecls in the body.
    Node DeclTypeOf(Node m, string name) {
        int i = 0;
        while (i < m.kids.Count) {
            Node p = m.kids[i];
            if (p.kind == AK.Param() && p.sval == name) { return p.type; }
            i = i + 1;
        }
        return VarDeclTypeIn(m.d, name);
    }
    Node VarDeclTypeIn(Node s, string name) {
        if (s == null) { return null; }
        if (s.kind == AK.Lambda()) { return null; }
        if (s.kind == AK.VarDecl() && s.sval == name) { return s.type; }
        Node t = VarDeclTypeIn(s.a, name);
        if (t != null) { return t; }
        t = VarDeclTypeIn(s.b, name);
        if (t != null) { return t; }
        t = VarDeclTypeIn(s.c, name);
        if (t != null) { return t; }
        t = VarDeclTypeIn(s.d, name);
        if (t != null) { return t; }
        int i = 0;
        while (i < s.kids.Count) {
            t = VarDeclTypeIn(s.kids[i], name);
            if (t != null) { return t; }
            i = i + 1;
        }
        return null;
    }

    // Best-effort static result type of an awaited call (the callee's declared
    // return type). Null when unresolvable; the temp then defaults to int.
    // The callee is resolved the way the CALL SITE resolves it -- by argument
    // type -- not "the first method with that name": with two overloads the
    // by-name pick hands the awaited temp the other overload's return type
    // (a class pointer where a string belongs -> invalid IR).
    Node AwaitCallTy(Node cls, Node m, Node callExpr) {
        if (callExpr == null || callExpr.kind != AK.Call()) { return null; }
        Node callee = callExpr.a;
        if (callee == null) { return null; }
        if (callee.kind == AK.Ident()) {
            Node mm = AwaitTarget(cls, callee.sval, m, callExpr, false);
            if (mm != null) { return mm.type; }
            return null;
        }
        if (callee.kind == AK.MemberAccess()) {
            Node r = callee.a;
            if (r == null) { return null; }
            if (r.kind == AK.ThisExpr()) {
                Node mt = AwaitTarget(cls, callee.sval, m, callExpr, false);
                if (mt != null) { return mt.type; }
                return null;
            }
            if (r.kind == AK.Ident()) {
                Node rc = binder.FindType(r.sval);
                if (rc != null) {
                    Node ms = AwaitTarget(rc, callee.sval, m, callExpr, true);
                    if (ms != null) { return ms.type; }
                    return null;
                }
                Node vt = DeclTypeOf(m, r.sval);
                if (vt != null) {
                    Node rc2 = binder.FindType(vt.sval);
                    if (rc2 != null) {
                        Node mi = AwaitTarget(rc2, callee.sval, m, callExpr, true);
                        if (mi != null) { return mi.type; }
                    }
                }
            }
        }
        return null;
    }

    // The overload an awaited call resolves to: every candidate named `name`
    // in `cls` and its bases, filtered by the argument count and scored by
    // the argument types -- the call site's rule.
    Node AwaitTarget(Node cls, string name, Node m, Node callExpr, bool wantStatic) {
        if (cls == null) { return null; }
        List<Node> cands = new List<Node>();
        Node c = cls;
        int cg = 0;
        while (c != null) {
            int i = 0;
            while (i < c.kids.Count) {
                Node mm = c.kids[i];
                if (mm.kind == AK.MethodDecl() && mm.sval == name) { cands.Add(mm); }
                i = i + 1;
            }
            c = BaseClassOf(c);
            cg = cg + 1;
            if (cg > 512) { c = null; }
        }
        if (cands.Count == 0) { return null; }
        int argc = callExpr.kids.Count;
        List<Node> fit = new List<Node>();
        int i = 0;
        while (i < cands.Count) {
            if (AcceptsArity(cands[i], argc)) { fit.Add(cands[i]); }
            i = i + 1;
        }
        if (fit.Count == 0) { return cands[0]; }
        if (fit.Count == 1) { return fit[0]; }
        int best = -1000000;
        Node pick = fit[0];
        i = 0;
        while (i < fit.Count) {
            int s = AwaitScore(fit[i], m, callExpr, argc, wantStatic);
            if (s > best) { best = s; pick = fit[i]; }
            i = i + 1;
        }
        return pick;
    }

    // Score an overload candidate for an awaited call (the call site's
    // scoring, with the argument types taken from the enclosing method's
    // parameters -- the body's locals do not exist yet at this point).
    int AwaitScore(Node cand, Node m, Node callExpr, int argc, bool wantStatic) {
        int score = 0;
        if (IsStatic(cand) == wantStatic) { score = score + 1; }
        int a = 0;
        while (a < argc) {
            Node pt = ParamTypeNode(cand, a);
            Node aty = AwaitArgType(m, callExpr.kids[a]);
            if (aty != null) {
                string at = TypeTag(aty);
                if (at != "") {
                    if (at == TypeTag(pt)) { score = score + 4; }
                    else if (MentionsTypeParam(pt)) { score = score + 2; }
                    else { score = score - 1; }
                }
            }
            a = a + 1;
        }
        return score;
    }

    // The type of an argument expression, as far as it is knowable while the
    // await is normalized: the body's locals do not exist yet, so an
    // identifier argument is typed from the enclosing method's parameters.
    Node AwaitArgType(Node m, Node arg) {
        if (arg == null) { return null; }
        if (arg.kind == AK.Ident() && m != null) {
            int i = 0;
            while (i < m.kids.Count) {
                Node p = m.kids[i];
                if (p.kind == AK.Param() && p.sval == arg.sval) { return p.type; }
                i = i + 1;
            }
        }
        return ArgTypeNode(arg);
    }

    Node MakeAwaitTemp(Node cls, Node m, Node aw, List<Node> pre) {
        Node d = new Node(AK.VarDecl());
        d.sval = "__aw$" + awHoistN;
        awHoistN = awHoistN + 1;
        d.type = AwaitCallTy(cls, m, aw.a);
        d.b = aw;
        d.line = aw.line; d.col = aw.col;
        pre.Add(d);
        Node id = new Node(AK.Ident());
        id.sval = d.sval;
        id.line = aw.line; id.col = aw.col;
        return id;
    }

    // Rewrite an expression tree: hoist every embedded await into `pre` and
    // replace it with a reference to the hoisted temp.
    Node HoistExpr(Node cls, Node m, Node e, List<Node> pre) {
        if (e == null) { return null; }
        if (e.kind == AK.Lambda()) { return e; }
        e.a = HoistExpr(cls, m, e.a, pre);
        e.b = HoistExpr(cls, m, e.b, pre);
        e.c = HoistExpr(cls, m, e.c, pre);
        e.d = HoistExpr(cls, m, e.d, pre);
        int i = 0;
        while (i < e.kids.Count) {
            e.kids[i] = HoistExpr(cls, m, e.kids[i], pre);
            i = i + 1;
        }
        if (e.kind == AK.AwaitExpr()) { return MakeAwaitTemp(cls, m, e, pre); }
        return e;
    }

    // Hoist awaits nested inside a root-position await's own arguments.
    void HoistInsideRootAwait(Node cls, Node m, Node aw, List<Node> pre) {
        Node call = aw.a;
        if (call == null) { return; }
        call.a = HoistExpr(cls, m, call.a, pre);
        int i = 0;
        while (i < call.kids.Count) {
            call.kids[i] = HoistExpr(cls, m, call.kids[i], pre);
            i = i + 1;
        }
    }

    Node WrapBlock(Node s) {
        if (s == null || s.kind == AK.Block()) { return s; }
        Node b = new Node(AK.Block());
        b.Add(s);
        return b;
    }

    // Normalize one statement; hoisted temp decls are appended to `pre` and
    // must be emitted before the statement.
    void NormStmt(Node cls, Node m, Node s, List<Node> pre) {
        if (s == null) { return; }
        int k = s.kind;
        if (k == AK.Block()) { NormBlock(cls, m, s); return; }
        if (k == AK.VarDecl()) {
            if (s.b != null && s.b.kind == AK.AwaitExpr()) { HoistInsideRootAwait(cls, m, s.b, pre); return; }
            s.b = HoistExpr(cls, m, s.b, pre);
            return;
        }
        if (k == AK.ReturnStmt()) {
            if (s.a != null && s.a.kind == AK.AwaitExpr()) { HoistInsideRootAwait(cls, m, s.a, pre); return; }
            s.a = HoistExpr(cls, m, s.a, pre);
            return;
        }
        if (k == AK.ExprStmt()) {
            Node e = s.a;
            if (e == null) { return; }
            if (e.kind == AK.AwaitExpr()) { HoistInsideRootAwait(cls, m, e, pre); return; }
            if (e.kind == AK.Assignment() && e.b != null && e.b.kind == AK.AwaitExpr()) {
                HoistInsideRootAwait(cls, m, e.b, pre);
                return;
            }
            s.a = HoistExpr(cls, m, e, pre);
            return;
        }
        if (k == AK.IfStmt()) {
            s.a = HoistExpr(cls, m, s.a, pre);
            s.b = WrapBlock(s.b); NormStmt(cls, m, s.b, pre);
            s.c = WrapBlock(s.c); NormStmt(cls, m, s.c, pre);
            return;
        }
        if (k == AK.WhileStmt()) {
            if (ExprHasAwait(s.a)) {
                // while (..await..) body  =>  while (true) { <temps>; if (cond) { body } else { break; } }
                List<Node> cpre = new List<Node>();
                Node cond = HoistExpr(cls, m, s.a, cpre);
                Node brk = new Node(AK.Block());
                brk.Add(new Node(AK.BreakStmt()));
                Node ifs = new Node(AK.IfStmt());
                ifs.a = cond;
                ifs.b = WrapBlock(s.b);
                ifs.c = brk;
                Node nb = new Node(AK.Block());
                int ci = 0;
                while (ci < cpre.Count) { nb.Add(cpre[ci]); ci = ci + 1; }
                nb.Add(ifs);
                Node tl = new Node(AK.BoolLit());
                tl.ival = 1;
                s.a = tl;
                s.b = nb;
            }
            s.b = WrapBlock(s.b); NormStmt(cls, m, s.b, pre);
            return;
        }
        if (k == AK.ForStmt()) {
            if (s.a != null) { NormStmt(cls, m, s.a, pre); }
            s.d = WrapBlock(s.d); NormStmt(cls, m, s.d, pre);
            return;
        }
        if (k == AK.ForeachStmt()) {
            s.b = HoistExpr(cls, m, s.b, pre);
            s.d = WrapBlock(s.d); NormStmt(cls, m, s.d, pre);
            return;
        }
        if (k == AK.TryStmt()) {
            s.a = WrapBlock(s.a); NormStmt(cls, m, s.a, pre);
            if (s.b != null && s.b.a != null) { s.b.a = WrapBlock(s.b.a); NormStmt(cls, m, s.b.a, pre); }
            s.c = WrapBlock(s.c); NormStmt(cls, m, s.c, pre);
            return;
        }
        if (k == AK.SwitchStmt()) {
            s.a = HoistExpr(cls, m, s.a, pre);
            int i = 0;
            while (i < s.kids.Count) {
                Node cse = s.kids[i];
                List<Node> ck = new List<Node>();
                int j = 0;
                while (j < cse.kids.Count) {
                    Node cs = cse.kids[j];
                    List<Node> cpre = new List<Node>();
                    NormStmt(cls, m, cs, cpre);
                    int cj = 0;
                    while (cj < cpre.Count) { ck.Add(cpre[cj]); cj = cj + 1; }
                    ck.Add(cs);
                    j = j + 1;
                }
                cse.kids = ck;
                i = i + 1;
            }
            return;
        }
    }

    void NormBlock(Node cls, Node m, Node blk) {
        if (blk == null) { return; }
        List<Node> outk = new List<Node>();
        int i = 0;
        while (i < blk.kids.Count) {
            Node s = blk.kids[i];
            List<Node> pre = new List<Node>();
            NormStmt(cls, m, s, pre);
            int j = 0;
            while (j < pre.Count) { outk.Add(pre[j]); j = j + 1; }
            outk.Add(s);
            i = i + 1;
        }
        blk.kids = outk;
    }

    void NormalizeAwaits(Node cls, Node m) {
        if (m.d == null) { return; }
        if (CountAwaits(m.d) == 0) { return; }
        awHoistN = 0;
        Node body = WrapBlock(m.d);
        m.d = body;
        NormBlock(cls, m, body);
    }
    // Detect `await Socket.<Intrinsic>(...)` -- the IO-reactor primitives the
    // C host lowers to zan_io_{wait,recv,accept}_co (ReadReady/WriteReady are a
    // readiness probe yielding no value; RecvOv/AcceptOv post a real op and the
    // reactor writes the byte count / accepted fd into this frame's result slot
    // before re-readying it). These suspend the CURRENT frame (no sub-task).
    bool IsSocketIntrinsic(Node callExpr) {
        if (callExpr == null || callExpr.kind != AK.Call()) { return false; }
        Node c = callExpr.a;
        if (c == null || c.kind != AK.MemberAccess()) { return false; }
        if (c.a == null || c.a.kind != AK.Ident()) { return false; }
        string cn = c.a.sval; string mn = c.sval;
        if (cn == "Task" && mn == "Delay") { return true; }
        if (cn == "Gate" && mn == "Park") { return true; }
        if (cn != "Socket") { return false; }
        return mn == "ReadReady" || mn == "WriteReady" || mn == "RecvOv" || mn == "AcceptOv" || mn == "RecvToOv";
    }
    string ArgI64(Node a) {
        ExprVal v = GenExpr(a);
        return ToI64(v.op, MapType(v.ty));
    }
    ExprVal EmitSocketIntrinsic(Node callExpr) {
        string cn = callExpr.a.a.sval;
        string mn = callExpr.a.sval;
        int seq = curAwaitSeq; curAwaitSeq = curAwaitSeq + 1;
        int st = seq + 1;
        if (cn == "Task" && mn == "Delay") {
            string ms = ArgI64(callExpr.kids[0]);
            EmitAsyncSaveSlots();
            L("  store i64 " + st + ", i64* " + FrameGep("%ff", 2));
            L("  call void @zan_co_delay(i64 " + ms + ", i8* %fp, void(i8*)* @" + curResumeSym + ")");
            L("  ret void");
            L("resume_" + st + ":");
            term = false; curLbl = "resume_" + st;
            EmitAsyncReloadSlots();
            return new ExprVal("0", MkType("int"));
        }
        if (cn == "Gate" && mn == "Park") {
            // event-driven wait: the frame is re-readied by zan_gate_signal
            string gh = ArgI64(callExpr.kids[0]);
            EmitAsyncSaveSlots();
            L("  store i64 " + st + ", i64* " + FrameGep("%ff", 2));
            L("  call void @zan_gate_park(i64 " + gh + ", i8* %fp, void(i8*)* @" + curResumeSym + ")");
            L("  ret void");
            L("resume_" + st + ":");
            term = false; curLbl = "resume_" + st;
            EmitAsyncReloadSlots();
            return new ExprVal("0", MkType("int"));
        }
        if (mn == "ReadReady" || mn == "WriteReady") {
            string fd = ArgI64(callExpr.kids[0]);
            string interest = "1"; if (mn == "WriteReady") { interest = "2"; }
            EmitAsyncSaveSlots();
            L("  store i64 " + st + ", i64* " + FrameGep("%ff", 2));
            L("  call void @zan_io_wait_co(i64 " + fd + ", i32 " + interest + ", i8* %fp, void(i8*)* @" + curResumeSym + ")");
            L("  ret void");
            L("resume_" + st + ":");
            term = false; curLbl = "resume_" + st;
            EmitAsyncReloadSlots();
            return new ExprVal("0", MkType("int"));
        }
        if (mn == "RecvOv") {
            string fd = ArgI64(callExpr.kids[0]);
            ExprVal bufv = GenExpr(callExpr.kids[1]);
            string buf = bufv.op;
            if (MapType(bufv.ty) != "i8*") {
                string bt = NT(); L("  " + bt + " = bitcast " + MapType(bufv.ty) + " " + buf + " to i8*"); buf = bt;
            }
            string lenv = ArgI64(callExpr.kids[2]);
            string len32 = NT(); L("  " + len32 + " = trunc i64 " + lenv + " to i32");
            string outn = FrameGep("%ff", 6);
            EmitAsyncSaveSlots();
            L("  store i64 " + st + ", i64* " + FrameGep("%ff", 2));
            L("  call void @zan_io_recv_co(i64 " + fd + ", i8* " + buf + ", i32 " + len32 + ", i8* %fp, void(i8*)* @" + curResumeSym + ", i64* " + outn + ")");
            L("  ret void");
            L("resume_" + st + ":");
            term = false; curLbl = "resume_" + st;
            EmitAsyncReloadSlots();
            string rs = FrameGep("%ff", 6);
            string rv = NT(); L("  " + rv + " = load i64, i64* " + rs);
            return new ExprVal(rv, MkType("int"));
        }
        if (mn == "RecvToOv") {
            // recv with a deadline: same shape as RecvOv plus the timeout --
            // the reactor races the recv against the deadline and delivers
            // the byte count (0 = peer close) or -1 (timeout) into slot 6.
            string fd = ArgI64(callExpr.kids[0]);
            ExprVal bufv = GenExpr(callExpr.kids[1]);
            string buf = bufv.op;
            if (MapType(bufv.ty) != "i8*") {
                string bt = NT(); L("  " + bt + " = bitcast " + MapType(bufv.ty) + " " + buf + " to i8*"); buf = bt;
            }
            string lenv = ArgI64(callExpr.kids[2]);
            string len32 = NT(); L("  " + len32 + " = trunc i64 " + lenv + " to i32");
            string tmo = ArgI64(callExpr.kids[3]);
            string outn = FrameGep("%ff", 6);
            EmitAsyncSaveSlots();
            L("  store i64 " + st + ", i64* " + FrameGep("%ff", 2));
            L("  call void @zan_io_recv_to_co(i64 " + fd + ", i8* " + buf + ", i32 " + len32 + ", i64 " + tmo + ", i8* %fp, void(i8*)* @" + curResumeSym + ", i64* " + outn + ")");
            L("  ret void");
            L("resume_" + st + ":");
            term = false; curLbl = "resume_" + st;
            EmitAsyncReloadSlots();
            string rs = FrameGep("%ff", 6);
            string rv = NT(); L("  " + rv + " = load i64, i64* " + rs);
            return new ExprVal(rv, MkType("int"));
        }
        // AcceptOv
        string fd2 = ArgI64(callExpr.kids[0]);
        string outfd = FrameGep("%ff", 6);
        EmitAsyncSaveSlots();
        L("  store i64 " + st + ", i64* " + FrameGep("%ff", 2));
        L("  call void @zan_io_accept_co(i64 " + fd2 + ", i8* %fp, void(i8*)* @" + curResumeSym + ", i64* " + outfd + ")");
        L("  ret void");
        L("resume_" + st + ":");
        term = false; curLbl = "resume_" + st;
        EmitAsyncReloadSlots();
        string rs2 = FrameGep("%ff", 6);
        string rv2 = NT(); L("  " + rv2 + " = load i64, i64* " + rs2);
        return new ExprVal(rv2, MkType("int"));
    }
    // The result type of an awaited call: `Task<T>` -> T, a bare `Task` ->
    // void (no result). A declared return type spelled `Task<T>` is the C#
    // spelling of an async method -- the awaited value is the element.
    Node AsyncElemTyOf(Node rt) {
        if (rt == null) { return null; }
        if (rt.sval != "Task") { return rt; }
        if (rt.kids.Count == 1) { return rt.kids[0]; }
        return MkType("void");
    }

    // Lower `await <callExpr>`; returns the awaited result (+1 owned if ARC).
    ExprVal EmitAwait(Node callExpr) {
        if (curAsync && IsSocketIntrinsic(callExpr)) { return EmitSocketIntrinsic(callExpr); }
        ExprVal sub = GenExpr(callExpr);
        // The awaited operand has to be a coroutine frame: the lowering reads
        // the frame's slot 9 (the resume entry) and hands the frame to the
        // scheduler. An operand that is not a frame (an unknown call, a task
        // handle, a plain value) has no such slot -- reading it produced
        // `bitcast i8* 0 to i64*` and clang rejected the IR outright. Report
        // it instead of emitting broken IR.
        if (!sub.asyncCall) {
            diags.Error("'await' expects an async call in the self-hosted compiler -- " +
                "this operand is not lowered as a coroutine frame", callExpr.line, callExpr.col);
            return new ExprVal("0", MkType("int"));
        }
        Node resTy = MkType("int");
        if (sub.ty != null && sub.ty.a != null) { resTy = sub.ty.a; }
        // A Task-shaped return (`async Task<T>`) carries the RESULT, not a
        // handle: the awaited value has the element type. The C host's
        // parser rewrites the declared return type the same way
        // (desugar_async_task_method); without the unwrap the awaited value
        // was typed as the handle -- the inttoptr/ptrtoint round trip kept
        // the bits for pointers and integers, but a double result came out as
        // a pointer and the store into the double slot was invalid IR
        // (clang: "'%t8' defined with type 'ptr' but expected 'double'").
        resTy = AsyncElemTyOf(resTy);
        string subv = sub.op;
        string subh = NT();
        L("  " + subh + " = bitcast i8* " + subv + " to i64*");
        string orp = FrameGep(subh, 9);
        string ori = NT(); L("  " + ori + " = load i64, i64* " + orp);
        string orfn = NT(); L("  " + orfn + " = inttoptr i64 " + ori + " to void(i8*)*");
        if (curAsync) {
            int seq = curAwaitSeq; curAwaitSeq = curAwaitSeq + 1;
            int st = seq + 1;
            string ssp = FrameGep("%ff", curSubBase + seq);
            string subi = NT(); L("  " + subi + " = ptrtoint i8* " + subv + " to i64");
            L("  store i64 " + subi + ", i64* " + ssp);
            string selfi = NT(); L("  " + selfi + " = ptrtoint i8* %fp to i64");
            string awp = FrameGep(subh, 4);
            L("  store i64 " + selfi + ", i64* " + awp);
            string stepi = NT(); L("  " + stepi + " = ptrtoint void(i8*)* @" + curResumeSym + " to i64");
            string awsp = FrameGep(subh, 5);
            L("  store i64 " + stepi + ", i64* " + awsp);
            L("  call void @zan_co_ready(i8* " + subv + ", void(i8*)* " + orfn + ")");
            EmitAsyncSaveSlots();
            string stp = FrameGep("%ff", 2);
            L("  store i64 " + st + ", i64* " + stp);
            L("  ret void");
            L("resume_" + st + ":");
            term = false; curLbl = "resume_" + st;
            EmitAsyncReloadSlots();
            string ssp2 = FrameGep("%ff", curSubBase + seq);
            string subi2 = NT(); L("  " + subi2 + " = load i64, i64* " + ssp2);
            string subh2 = NT(); L("  " + subh2 + " = inttoptr i64 " + subi2 + " to i64*");
            string fv = NT(); L("  " + fv + " = inttoptr i64 " + subi2 + " to i8*");
            string lt = MapType(resTy);
            if (lt == "void") {
                L("  call void @__zan_co_frame_free(i8* " + fv + ")");
                return new ExprVal("0", MkType("int"));
            }
            string rp = FrameGep(subh2, 6);
            string resi = NT(); L("  " + resi + " = load i64, i64* " + rp);
            string rvv = FromI64(resi, lt);
            L("  call void @__zan_co_frame_free(i8* " + fv + ")");
            return new ExprVal(rvv, resTy);
        }
        L("  call void @zan_co_ready(i8* " + subv + ", void(i8*)* " + orfn + ")");
        L("  call void @zan_co_sched_run()");
        string lt2 = MapType(resTy);
        if (lt2 == "void") {
            L("  call void @__zan_co_frame_free(i8* " + subv + ")");
            return new ExprVal("0", MkType("int"));
        }
        string rp2 = FrameGep(subh, 6);
        string resi2 = NT(); L("  " + resi2 + " = load i64, i64* " + rp2);
        string rvv2 = FromI64(resi2, lt2);
        L("  call void @__zan_co_frame_free(i8* " + subv + ")");
        return new ExprVal(rvv2, resTy);
    }
    // Release the frame's owned refs (params + locals via ReleaseLocalsFrom, and
    // the receiver which is not tracked as a local). Call exactly once per exit.
    void EmitAsyncEpilogue() {
        ReleaseLocalsFrom(0);
        if (curAsyncThis && curAsyncThisTy != null) {
            EmitArcRelease("%this", curAsyncThisTy);
        }
    }
    // Terminal completion: write result, mark done, wake the awaiter, return.
    // Caller must have already run EmitAsyncEpilogue and ensured a +1 result.
    void EmitAsyncComplete(string resi) {
        string rp = FrameGep("%ff", 6);
        L("  store i64 " + resi + ", i64* " + rp);
        string dp = FrameGep("%ff", 3);
        L("  store i64 1, i64* " + dp);
        string sp = FrameGep("%ff", 2);
        L("  store i64 -1, i64* " + sp);
        string awp = FrameGep("%ff", 4);
        string awi = NT(); L("  " + awi + " = load i64, i64* " + awp);
        string aw = NT(); L("  " + aw + " = inttoptr i64 " + awi + " to i8*");
        string has = NT(); L("  " + has + " = icmp ne i8* " + aw + ", null");
        int lw = NL(); int lr = NL();
        L("  br i1 " + has + ", label %L" + lw + ", label %L" + lr);
        Label(lw);
        string asp = FrameGep("%ff", 5);
        string asi = NT(); L("  " + asi + " = load i64, i64* " + asp);
        string asfn = NT(); L("  " + asfn + " = inttoptr i64 " + asi + " to void(i8*)*");
        L("  call void @zan_co_ready(i8* " + aw + ", void(i8*)* " + asfn + ")");
        L("  br label %L" + lr);
        Label(lr);
        L("  ret void");
        term = true;
    }
    void GenAsyncReturn(Node s) {
        if (s.a != null) {
            ExprVal v = GenExpr(s.a);
            string lt = MapType(v.ty);
            string rv = v.op;
            EmitArcRetain(rv, v.ty);
            EmitAsyncEpilogue();
            EmitAsyncComplete(ToI64(rv, lt));
        } else {
            EmitAsyncEpilogue();
            EmitAsyncComplete("0");
        }
    }
    void GenAwaitStmt(Node s) {
        int k = s.kind;
        if (k == AK.VarDecl()) {
            Node aw = s.b;
            ExprVal res = EmitAwait(aw.a);
            Node ty = s.type; if (ty == null) { ty = res.ty; }
            string lt = MapType(ty);
            string reg;
            if (curAsync) { reg = locReg[LocalIdx(s.sval)]; }
            else { reg = AddLocal(s.sval, ty); L("  " + reg + " = alloca " + lt); }
            string sv = Coerce(res, lt);
            L("  store " + lt + " " + sv + ", " + lt + "* " + reg);
            // await result is already +1 owned; transfer ownership (no retain).
            return;
        }
        if (k == AK.ReturnStmt()) {
            ExprVal res = EmitAwait(s.a.a);
            if (curAsync) {
                // await result already +1; transfer as the coroutine result.
                string lt = MapType(res.ty);
                EmitAsyncEpilogue();
                EmitAsyncComplete(ToI64(res.op, lt));
            } else {
                ReleaseLocalsFrom(0);
                if (curRet == "void") { L("  ret void"); }
                else {
                    ExprVal src = ApplyUserConv(curRetTy, res, false);
                    if (!convApplied) { src = StrSlotConv(curRetTy, res); }
                    L("  ret " + curRet + " " + Coerce(src, curRet));
                }
                term = true;
            }
            return;
        }
        Node e = s.a;
        if (e.kind == AK.AwaitExpr()) {
            ExprVal r0 = EmitAwait(e.a);
            EmitArcRelease(r0.op, r0.ty);
            return;
        }
        ExprVal r2 = EmitAwait(e.b.a);
        StoreTo(e.a, r2);
        // StoreTo retains the stored value; the await result was already +1,
        // so drop the extra reference to keep the count balanced.
        EmitArcRelease(r2.op, r2.ty);
    }
    void PrescanAsyncLocals(Node s, List<string> names, List<Node> types) {
        if (s == null) { return; }
        if (s.kind == AK.VarDecl()) {
            names.Add(s.sval);
            Node ty = s.type; if (ty == null) { ty = MkType("int"); }
            types.Add(ty);
        }
        int i = 0;
        while (i < s.kids.Count) { PrescanAsyncLocals(s.kids[i], names, types); i = i + 1; }
        PrescanAsyncLocals(s.a, names, types);
        PrescanAsyncLocals(s.b, names, types);
        PrescanAsyncLocals(s.c, names, types);
        PrescanAsyncLocals(s.d, names, types);
    }
    int CountAwaits(Node s) {
        if (s == null) { return 0; }
        int n = 0;
        if (s.kind == AK.AwaitExpr()) { n = 1; }
        int i = 0;
        while (i < s.kids.Count) { n = n + CountAwaits(s.kids[i]); i = i + 1; }
        n = n + CountAwaits(s.a) + CountAwaits(s.b) + CountAwaits(s.c) + CountAwaits(s.d);
        return n;
    }
    // Count the foreach statements of an async body (two frame slots each).
    int CountAsyncForeach(Node s) {
        if (s == null) { return 0; }
        int n = 0;
        if (s.kind == AK.ForeachStmt()) { n = 1; }
        int i = 0;
        while (i < s.kids.Count) { n = n + CountAsyncForeach(s.kids[i]); i = i + 1; }
        n = n + CountAsyncForeach(s.a) + CountAsyncForeach(s.b)
              + CountAsyncForeach(s.c) + CountAsyncForeach(s.d);
        return n;
    }
    // Hand every foreach its frame slots: s.ival = the collection slot, the
    // loop counter uses the next one, the element variable the one after.
    void AssignAsyncForeachSlots(Node s) {
        if (s == null) { return; }
        if (s.kind == AK.ForeachStmt()) {
            s.ival = asyncForeachBase + asyncForeachNext;
            asyncForeachNext = asyncForeachNext + 3;
        }
        int i = 0;
        while (i < s.kids.Count) { AssignAsyncForeachSlots(s.kids[i]); i = i + 1; }
        AssignAsyncForeachSlots(s.a);
        AssignAsyncForeachSlots(s.b);
        AssignAsyncForeachSlots(s.c);
        AssignAsyncForeachSlots(s.d);
    }
    void GenAsyncMethod(Node cls, Node m) {
        bool stat = IsStatic(m);
        int thisExtra = 0; if (!stat) { thisExtra = 1; }
        List<string> pn = new List<string>();
        List<Node> pt = new List<Node>();
        int i = 0;
        while (i < m.kids.Count) {
            Node p = m.kids[i];
            if (p.kind == AK.Param()) { pn.Add(p.sval); pt.Add(p.type); }
            i = i + 1;
        }
        List<string> lnames = new List<string>();
        List<Node> ltypes = new List<Node>();
        if (m.d != null) { PrescanAsyncLocals(m.d, lnames, ltypes); }
        int awaitCount = 0; if (m.d != null) { awaitCount = CountAwaits(m.d); }
        int header = 10;
        int thisSlot = header;
        int paramBase = header + thisExtra;
        int localBase = paramBase + pn.Count;
        int subBase = localBase + lnames.Count;
        // Every foreach in the body needs three frame slots: the collection,
        // the loop counter and the element variable. All three are stack
        // allocas (or plain expression values) in the ordinary lowering, and
        // a stack alloca is re-created on every resume -- the loop would
        // restart from zero (or read an uninitialized slot) after an await
        // inside the body. The frame is heap memory, so it survives the
        // suspension.
        int feCount = 0; if (m.d != null) { feCount = CountAsyncForeach(m.d); }
        int nfields = subBase + awaitCount + feCount * 3;
        asyncForeachBase = subBase + awaitCount;
        asyncForeachNext = 0;
        if (m.d != null) { AssignAsyncForeachSlots(m.d); }
        usesAsync = true;
        string sym = MethodSym(cls.sval, m);
        string resumeSym = sym + "$resume";
        Node thisTy = MkType(cls.sval);
        int j = 0;

        // ---- ramp: allocate frame, capture (retain) receiver+params, return ----
        StartFn();
        curClass = cls.sval;
        curHasThis = false;
        string sig = "define i8* @" + sym + "(";
        int np = 0;
        if (!stat) { sig = sig + "%" + cls.sval + "* %this"; np = 1; }
        j = 0;
        while (j < pn.Count) {
            if (np > 0) { sig = sig + ", "; }
            sig = sig + MapType(pt[j]) + " %p" + j;
            np = np + 1;
            j = j + 1;
        }
        L(sig + ") {");
        L("entry:");
        string raw = NT();
        L("  " + raw + " = call i8* @malloc(i64 " + (nfields * 8) + ")");
        L("  %ff = bitcast i8* " + raw + " to i64*");
        int h = 0;
        // Zero the whole frame so every owning (RC) local slot starts null:
        // the completion epilogue releases locals that the executed path may
        // never have assigned, and sub-task slots are read on resume.
        while (h < nfields) { L("  store i64 0, i64* " + FrameGep("%ff", h)); h = h + 1; }
        string orp = FrameGep("%ff", 9);
        string ori = NT(); L("  " + ori + " = ptrtoint void(i8*)* @" + resumeSym + " to i64");
        L("  store i64 " + ori + ", i64* " + orp);
        string clp = FrameGep("%ff", 7);
        string cli = NT(); L("  " + cli + " = ptrtoint void(i8*)* @" + sym + "$cleanup to i64");
        L("  store i64 " + cli + ", i64* " + clp);
        if (!stat) {
            string ti = ToI64("%this", MapType(thisTy));
            L("  store i64 " + ti + ", i64* " + FrameGep("%ff", thisSlot));
            EmitArcRetain("%this", thisTy);
        }
        j = 0;
        while (j < pn.Count) {
            string lt = MapType(pt[j]);
            string vi = ToI64("%p" + j, lt);
            L("  store i64 " + vi + ", i64* " + FrameGep("%ff", paramBase + j));
            EmitArcRetain("%p" + j, pt[j]);
            j = j + 1;
        }
        L("  ret i8* " + raw);
        L("}");

        // ---- resume: dispatch on state, run body, spill/reload across await ----
        StartFn();
        curClass = cls.sval;
        curHasThis = !stat;
        curRet = "void";
        curAsync = true;
        curAwaitSeq = 0;
        curResumeSym = resumeSym;
        curSubBase = subBase;
        curAsyncThis = !stat;
        curAsyncThisSlot = thisSlot;
        curAsyncThisTy = thisTy;
        asyncSlotReg = new List<string>();
        asyncSlotTy = new List<Node>();
        asyncSlotIdx = new List<int>();
        asyncBoxIdx = new List<int>();
        // A closure in this method may capture the method's locals: the names
        // it mentions have to live in a cell. Collected here because StartFn
        // resets the capture set.
        CollectCapturedNames(m.d, capNames);
        L("define void @" + resumeSym + "(i8* %fp) {");
        L("entry:");
        // Every alloca of the resume function must live in the entry block:
        // the function is re-entered on every resume, and an alloca in a
        // block that is not re-executed never allocates its stack slot (a
        // store into it would corrupt the stack).
        StringBuilder obody = body; StringBuilder oea = entryAllocas; bool oact = eaActive;
        body = new StringBuilder(); entryAllocas = new StringBuilder(); eaActive = true;
        L("  %ff = bitcast i8* %fp to i64*");
        if (!stat) {
            // receiver is immutable across the coroutine: load once, dominates all.
            string tr = NT();
            L("  " + tr + " = load i64, i64* " + FrameGep("%ff", thisSlot));
            L("  %this = inttoptr i64 " + tr + " to %" + cls.sval + "*");
        }
        j = 0;
        while (j < pn.Count) {
            string lt = MapType(pt[j]);
            string reg = AddLocal(pn[j], pt[j]);
            L("  " + reg + " = alloca " + lt);
            asyncSlotReg.Add(reg); asyncSlotTy.Add(pt[j]); asyncSlotIdx.Add(paramBase + j);
            j = j + 1;
        }
        j = 0;
        while (j < lnames.Count) {
            string lt = MapType(ltypes[j]);
            string reg = AddLocal(lnames[j], ltypes[j]);
            if (ShouldBox(lnames[j])) {
                // Captured by a closure: the local lives in a heap cell and the
                // spill slot keeps the *cell pointer* across a suspension (the
                // resume function is a fresh call with a fresh stack, so the
                // cell -- not the value -- is what has to survive).
                L("  " + reg + " = alloca i8*");
                locBox[locName.Count - 1] = true;
                asyncBoxIdx.Add(j);
                asyncSlotReg.Add(reg); asyncSlotTy.Add(MkType("string")); asyncSlotIdx.Add(localBase + j);
            } else {
                L("  " + reg + " = alloca " + lt);
                asyncSlotReg.Add(reg); asyncSlotTy.Add(ltypes[j]); asyncSlotIdx.Add(localBase + j);
            }
            j = j + 1;
        }
        string st = NT();
        L("  " + st + " = load i64, i64* " + FrameGep("%ff", 2));
        string sw = "  switch i64 " + st + ", label %co.start [ i64 0, label %co.start";
        int a2 = 1;
        while (a2 <= awaitCount) { sw = sw + " i64 " + a2 + ", label %resume_" + a2; a2 = a2 + 1; }
        L(sw + " ]");
        L("co.start:");
        term = false; curLbl = "co.start";
        EmitAsyncReloadSlots();
        if (m.d != null) { GenStmt(m.d); }
        if (!term) { EmitAsyncEpilogue(); EmitAsyncComplete("0"); }
        L("}");
        obody.Append(entryAllocas.ToString());
        obody.Append(body.ToString());
        body = obody; entryAllocas = oea; eaActive = oact;
        curAsync = false;
        curAsyncThis = false;
        curAsyncThisTy = null;

        // ---- cleanup: release every owned rc slot from the heap frame and
        // free it. Called by @__zan_async_unwind when an exception longjmps
        // past this suspended frame (slots are saved at every suspension and
        // async throw, so the frame is authoritative).
        StartFn();
        L("define internal void @" + sym + "$cleanup(i8* %fp) {");
        L("entry:");
        L("  %ff = bitcast i8* %fp to i64*");
        if (!stat && ArcManaged(thisTy)) {
            string ctp = FrameGep("%ff", thisSlot);
            string cti = NT(); L("  " + cti + " = load i64, i64* " + ctp);
            EmitArcRelease(FromI64(cti, MapType(thisTy)), thisTy);
        }
        j = 0;
        while (j < pn.Count) {
            if (ArcManaged(pt[j])) {
                string cpp = FrameGep("%ff", paramBase + j);
                string cpi = NT(); L("  " + cpi + " = load i64, i64* " + cpp);
                EmitArcRelease(FromI64(cpi, MapType(pt[j])), pt[j]);
            }
            j = j + 1;
        }
        j = 0;
        while (j < lnames.Count) {
            if (ArcManaged(ltypes[j])) {
                string clp2 = FrameGep("%ff", localBase + j);
                string cli2 = NT(); L("  " + cli2 + " = load i64, i64* " + clp2);
                if (ContainsInt(asyncBoxIdx, j)) {
                    // the local lives in a heap cell: the frame slot holds the
                    // CELL pointer, the cell holds the value -- release the
                    // value, not the cell
                    string lt2 = MapType(ltypes[j]);
                    string cp = NT(); L("  " + cp + " = inttoptr i64 " + cli2 + " to i8*");
                    string vp = NT(); L("  " + vp + " = bitcast i8* " + cp + " to " + lt2 + "*");
                    string vv = NT(); L("  " + vv + " = load " + lt2 + ", " + lt2 + "* " + vp);
                    EmitArcRelease(vv, ltypes[j]);
                } else {
                    EmitArcRelease(FromI64(cli2, MapType(ltypes[j])), ltypes[j]);
                }
            }
            j = j + 1;
        }
        L("  call void @__zan_co_frame_free(i8* %fp)");
        L("  ret void");
        L("}");
    }
    // Directory listing + exe-path helpers (Windows host). @zan_dir_list
    // returns the file names matching a glob pattern joined by '\n' (empty
    // string when the directory is missing); @zan_exe_dir returns the
    // directory containing the running executable.
    void EmitDirRuntime() {
        if (!ExternSeen("zan_exe_dir_into")) { externDecls.Add("zan_exe_dir_into"); H("declare i64 @zan_exe_dir_into(i8*, i64)"); }
        if (!ExternSeen("zan_dir_list_into")) { externDecls.Add("zan_dir_list_into"); H("declare i64 @zan_dir_list_into(i8*, i8*, i64)"); }
        H("define i8* @zan_exe_dir() {");
        H("entry:");
        H("  %buf = call i8* @malloc(i64 1024)");
        H("  %n = call i64 @zan_exe_dir_into(i8* %buf, i64 1024)");
        H("  ret i8* %buf");
        H("}");
        H("define i8* @zan_dir_list(i8* %pat) {");
        H("entry:");
        H("  %buf = call i8* @malloc(i64 65536)");
        H("  %n = call i64 @zan_dir_list_into(i8* %pat, i8* %buf, i64 65536)");
        H("  ret i8* %buf");
        H("}");
    }
    void EmitAsyncRuntime() {
        EmitAsyncUnwindClock();
        EmitAsyncPumpReady();
        EmitAsyncSchedRun();
    }

    /// Coroutine unwinder, IO/gate co declares, and the monotonic clock
    /// (__zan_co_now_ms + zan_io_pump_timeout, platform-branched).
    void EmitAsyncUnwindClock() {
        // Exception unwinder for suspended coroutines: a throw longjmps
        // straight to its handler, skipping suspended CPS frames in between.
        // Walk the awaiter chain from the throwing frame calling each frame's
        // cleanup (releases owned slots + frees the frame), stopping at the
        // first frame with an armed try handler (hcount > 0) -- the handler
        // resumes inside it.
        H("define internal void @__zan_async_unwind(i8* %self) {");
        H("entry:");
        H("  %cur.a = alloca i8*");
        H("  store i8* %self, i8** %cur.a");
        H("  br label %head");
        H("head:");
        H("  %cur = load i8*, i8** %cur.a");
        H("  %nn = icmp ne i8* %cur, null");
        H("  br i1 %nn, label %body, label %done");
        H("body:");
        H("  %hf = bitcast i8* %cur to i64*");
        H("  %hcp = getelementptr i64, i64* %hf, i64 8");
        H("  %hc = load i64, i64* %hcp");
        H("  %armed = icmp sgt i64 %hc, 0");
        H("  br i1 %armed, label %done, label %clean");
        H("clean:");
        H("  %awp = getelementptr i64, i64* %hf, i64 4");
        H("  %awi = load i64, i64* %awp");
        H("  %aw = inttoptr i64 %awi to i8*");
        H("  %det = icmp eq i8* %aw, %cur");
        H("  %nxt = select i1 %det, i8* null, i8* %aw");
        H("  %clp = getelementptr i64, i64* %hf, i64 7");
        H("  %cli = load i64, i64* %clp");
        H("  %cl = inttoptr i64 %cli to void(i8*)*");
        H("  %has = icmp ne void(i8*)* %cl, null");
        H("  br i1 %has, label %docall, label %next");
        H("docall:");
        H("  call void %cl(i8* %cur)");
        H("  br label %next");
        H("next:");
        H("  store i8* %nxt, i8** %cur.a");
        H("  br label %head");
        H("done:");
        H("  ret void");
        H("}");
        H("declare void @zan_io_wait_co(i64, i32, i8*, void(i8*)*)");
        H("declare void @zan_gate_park(i64, i8*, void(i8*)*)");
        H("declare void @zan_io_recv_co(i64, i8*, i32, i8*, void(i8*)*, i64*)");
        H("declare void @zan_io_accept_co(i64, i8*, void(i8*)*, i64*)");
        if (hostWin) {
            if (!ExternSeen("GetTickCount64")) { externDecls.Add("GetTickCount64"); H("declare i64 @GetTickCount64()"); }
            if (!ExternSeen("Sleep")) { externDecls.Add("Sleep"); H("declare void @Sleep(i64)"); }
        } else {
            if (!ExternSeen("gettimeofday")) { externDecls.Add("gettimeofday"); H("declare i32 @gettimeofday(i8*, i8*)"); }
            if (!ExternSeen("usleep")) { externDecls.Add("usleep"); H("declare i32 @usleep(i32)"); }
        }
        H("%co_node = type { i8*, i8*, i8* }");
        H("%co_timer = type { i8*, i64, i8*, i8* }");
        H("@co_head = global i8* null");
        H("@co_tail = global i8* null");
        H("@co_timers = global i8* null");
        if (hostWin) {
            H("define internal i64 @__zan_co_now_ms() {");
            H("entry:");
            H("  %n = call i64 @GetTickCount64()");
            H("  ret i64 %n");
            H("}");
            H("define weak i32 @zan_io_pump_timeout(i64 %timeout) {");
            H("entry:");
            H("  %pos = icmp sgt i64 %timeout, 0");
            H("  br i1 %pos, label %sleep, label %ret");
            H("sleep:");
            H("  call void @Sleep(i64 %timeout)");
            H("  br label %ret");
            H("ret:");
            H("  ret i32 0");
            H("}");
        } else {
            H("define internal i64 @__zan_co_now_ms() {");
            H("entry:");
            H("  %tv = alloca [2 x i64]");
            H("  %tvp = bitcast [2 x i64]* %tv to i8*");
            H("  call i32 @gettimeofday(i8* %tvp, i8* null)");
            H("  %secp = getelementptr [2 x i64], [2 x i64]* %tv, i64 0, i64 0");
            H("  %usecp = getelementptr [2 x i64], [2 x i64]* %tv, i64 0, i64 1");
            H("  %sec = load i64, i64* %secp");
            H("  %usec = load i64, i64* %usecp");
            H("  %ms1 = mul i64 %sec, 1000");
            H("  %ms2 = sdiv i64 %usec, 1000");
            H("  %n = add i64 %ms1, %ms2");
            H("  ret i64 %n");
            H("}");
            H("define weak i32 @zan_io_pump_timeout(i64 %timeout) {");
            H("entry:");
            H("  %pos = icmp sgt i64 %timeout, 0");
            H("  br i1 %pos, label %sleep, label %ret");
            H("sleep:");
            H("  %us64 = mul i64 %timeout, 1000");
            H("  %us = trunc i64 %us64 to i32");
            H("  call i32 @usleep(i32 %us)");
            H("  br label %ret");
            H("ret:");
            H("  ret i32 0");
            H("}");
        }
    }

    /// zan_io_pump / zan_co_sched_init / __zan_co_reap / zan_co_ready /
    /// zan_co_delay.
    ///
    /// 这里的协程调度器是「回退实现」：与 C 宿主的 zan_runtime_fallback
    /// 同法，必须用 weak 链接——链接了 C 运行时（rt_io.o/rt_co.o 提供同名
    /// 强符号）时由运行时那份生效，未链接运行时时用自带这份。否则两边
    /// 同时定义会 LNK2005。
    void EmitAsyncPumpReady() {
        H("define weak i32 @zan_io_pump() {");
        H("entry:");
        H("  %w = call i32 @zan_io_pump_timeout(i64 -1)");
        H("  ret i32 %w");
        H("}");
        H("define weak void @zan_co_sched_init() {");
        H("entry:");
        H("  store i8* null, i8** @co_head");
        H("  store i8* null, i8** @co_tail");
        H("  store i8* null, i8** @co_timers");
        H("  ret void");
        H("}");
        H("define internal void @__zan_co_reap(i8* %f) {");
        H("entry:");
        H("  call void @__zan_co_frame_free(i8* %f)");
        H("  ret void");
        H("}");
        // Releasing a coroutine frame goes through the runtime's protocol:
        // the shipped runtime marks the frame dead (CO_DEAD) before freeing
        // it, so its scheduler never touches a freed frame header. The weak
        // fallback (no shipped runtime linked) frees it directly.
        H("define weak void @__zan_co_frame_free(i8* %p) {");
        H("entry:");
        H("  call void @free(i8* %p)");
        H("  ret void");
        H("}");
        H("define weak void @zan_co_ready(i8* %frame, void(i8*)* %step) {");
        H("entry:");
        H("  %n = call i8* @malloc(i64 24)");
        H("  %np = bitcast i8* %n to %co_node*");
        H("  %nx = getelementptr %co_node, %co_node* %np, i32 0, i32 0");
        H("  store i8* null, i8** %nx");
        H("  %frp = getelementptr %co_node, %co_node* %np, i32 0, i32 1");
        H("  store i8* %frame, i8** %frp");
        H("  %stp = getelementptr %co_node, %co_node* %np, i32 0, i32 2");
        H("  %si = bitcast void(i8*)* %step to i8*");
        H("  store i8* %si, i8** %stp");
        H("  %tail = load i8*, i8** @co_tail");
        H("  %isempty = icmp eq i8* %tail, null");
        H("  br i1 %isempty, label %sethead, label %appendtail");
        H("sethead:");
        H("  store i8* %n, i8** @co_head");
        H("  store i8* %n, i8** @co_tail");
        H("  ret void");
        H("appendtail:");
        H("  %tp = bitcast i8* %tail to %co_node*");
        H("  %tnx = getelementptr %co_node, %co_node* %tp, i32 0, i32 0");
        H("  store i8* %n, i8** %tnx");
        H("  store i8* %n, i8** @co_tail");
        H("  ret void");
        H("}");
        H("define weak void @zan_co_delay(i64 %ms, i8* %frame, void(i8*)* %step) {");
        H("entry:");
        H("  %raw = call i8* @malloc(i64 32)");
        H("  %tn = bitcast i8* %raw to %co_timer*");
        H("  %old = load i8*, i8** @co_timers");
        H("  %tnp = getelementptr %co_timer, %co_timer* %tn, i32 0, i32 0");
        H("  store i8* %old, i8** %tnp");
        H("  %now = call i64 @__zan_co_now_ms()");
        H("  %pos = icmp sgt i64 %ms, 0");
        H("  %delay = select i1 %pos, i64 %ms, i64 0");
        H("  %deadline = add i64 %now, %delay");
        H("  %tdp = getelementptr %co_timer, %co_timer* %tn, i32 0, i32 1");
        H("  store i64 %deadline, i64* %tdp");
        H("  %tfp = getelementptr %co_timer, %co_timer* %tn, i32 0, i32 2");
        H("  store i8* %frame, i8** %tfp");
        H("  %tsp = getelementptr %co_timer, %co_timer* %tn, i32 0, i32 3");
        H("  %si = bitcast void(i8*)* %step to i8*");
        H("  store i8* %si, i8** %tsp");
        H("  store i8* %raw, i8** @co_timers");
        H("  ret void");
        H("}");
    }

    /// The cooperative scheduler main loop (zan_co_sched_run).
    void EmitAsyncSchedRun() {
        H("define weak void @zan_co_sched_run() {");
        H("entry:");
        H("  %a.best = alloca i8*");
        H("  %a.bestprev = alloca i8*");
        H("  %a.cur = alloca i8*");
        H("  %a.curprev = alloca i8*");
        H("  br label %loop");
        H("loop:");
        H("  %head = load i8*, i8** @co_head");
        H("  %qe = icmp eq i8* %head, null");
        H("  br i1 %qe, label %timers, label %body");
        H("body:");
        H("  %hp = bitcast i8* %head to %co_node*");
        H("  %frpb = getelementptr %co_node, %co_node* %hp, i32 0, i32 1");
        H("  %fr = load i8*, i8** %frpb");
        H("  %stpb = getelementptr %co_node, %co_node* %hp, i32 0, i32 2");
        H("  %sti8 = load i8*, i8** %stpb");
        H("  %nxpb = getelementptr %co_node, %co_node* %hp, i32 0, i32 0");
        H("  %nx = load i8*, i8** %nxpb");
        H("  store i8* %nx, i8** @co_head");
        H("  %islast = icmp eq i8* %nx, null");
        H("  br i1 %islast, label %last, label %after");
        H("last:");
        H("  store i8* null, i8** @co_tail");
        H("  br label %after");
        H("after:");
        H("  call void @free(i8* %head)");
        H("  %stfn = bitcast i8* %sti8 to void(i8*)*");
        H("  call void %stfn(i8* %fr)");
        H("  br label %loop");
        H("timers:");
        H("  %t0 = load i8*, i8** @co_timers");
        H("  %te = icmp eq i8* %t0, null");
        H("  br i1 %te, label %iopump, label %scansetup");
        H("scansetup:");
        H("  store i8* %t0, i8** %a.best");
        H("  store i8* null, i8** %a.bestprev");
        H("  %t0p = bitcast i8* %t0 to %co_timer*");
        H("  %t0np = getelementptr %co_timer, %co_timer* %t0p, i32 0, i32 0");
        H("  %t0next = load i8*, i8** %t0np");
        H("  store i8* %t0next, i8** %a.cur");
        H("  store i8* %t0, i8** %a.curprev");
        H("  br label %scancond");
        H("scancond:");
        H("  %cur = load i8*, i8** %a.cur");
        H("  %curnull = icmp eq i8* %cur, null");
        H("  br i1 %curnull, label %scandone, label %scanbody");
        H("scanbody:");
        H("  %curb = load i8*, i8** %a.cur");
        H("  %bestb = load i8*, i8** %a.best");
        H("  %curbp = bitcast i8* %curb to %co_timer*");
        H("  %bestbp = bitcast i8* %bestb to %co_timer*");
        H("  %curduep = getelementptr %co_timer, %co_timer* %curbp, i32 0, i32 1");
        H("  %curdue = load i64, i64* %curduep");
        H("  %bestduep = getelementptr %co_timer, %co_timer* %bestbp, i32 0, i32 1");
        H("  %bestdue = load i64, i64* %bestduep");
        H("  %dlt = icmp ult i64 %curdue, %bestdue");
        H("  br i1 %dlt, label %scantake, label %scannext");
        H("scantake:");
        H("  %curt = load i8*, i8** %a.cur");
        H("  %curprevt = load i8*, i8** %a.curprev");
        H("  store i8* %curt, i8** %a.best");
        H("  store i8* %curprevt, i8** %a.bestprev");
        H("  br label %scannext");
        H("scannext:");
        H("  %curn = load i8*, i8** %a.cur");
        H("  store i8* %curn, i8** %a.curprev");
        H("  %curnp = bitcast i8* %curn to %co_timer*");
        H("  %curnextp = getelementptr %co_timer, %co_timer* %curnp, i32 0, i32 0");
        H("  %curnextv = load i8*, i8** %curnextp");
        H("  store i8* %curnextv, i8** %a.cur");
        H("  br label %scancond");
        H("scandone:");
        H("  %best = load i8*, i8** %a.best");
        H("  %bestprev = load i8*, i8** %a.bestprev");
        H("  %bestp = bitcast i8* %best to %co_timer*");
        H("  %bestduep2 = getelementptr %co_timer, %co_timer* %bestp, i32 0, i32 1");
        H("  %bestdued = load i64, i64* %bestduep2");
        H("  %nowd = call i64 @__zan_co_now_ms()");
        H("  %duenow = icmp sle i64 %bestdued, %nowd");
        H("  br i1 %duenow, label %timerdue, label %timerwait");
        H("timerwait:");
        H("  %remaining = sub i64 %bestdued, %nowd");
        H("  call i32 @zan_io_pump_timeout(i64 %remaining)");
        H("  br label %loop");
        H("timerdue:");
        H("  %bestp2 = bitcast i8* %best to %co_timer*");
        H("  %bestnextp = getelementptr %co_timer, %co_timer* %bestp2, i32 0, i32 0");
        H("  %bestnextv = load i8*, i8** %bestnextp");
        H("  %bpnull = icmp eq i8* %bestprev, null");
        H("  br i1 %bpnull, label %unlinkhead, label %unlinkmid");
        H("unlinkhead:");
        H("  store i8* %bestnextv, i8** @co_timers");
        H("  br label %afterunlink");
        H("unlinkmid:");
        H("  %bestprevp = bitcast i8* %bestprev to %co_timer*");
        H("  %bpnextp = getelementptr %co_timer, %co_timer* %bestprevp, i32 0, i32 0");
        H("  store i8* %bestnextv, i8** %bpnextp");
        H("  br label %afterunlink");
        H("afterunlink:");
        H("  %bestp3 = bitcast i8* %best to %co_timer*");
        H("  %bframep = getelementptr %co_timer, %co_timer* %bestp3, i32 0, i32 2");
        H("  %bframe = load i8*, i8** %bframep");
        H("  %bstepp = getelementptr %co_timer, %co_timer* %bestp3, i32 0, i32 3");
        H("  %bstepi8 = load i8*, i8** %bstepp");
        H("  %bstepfn = bitcast i8* %bstepi8 to void(i8*)*");
        H("  call void @zan_co_ready(i8* %bframe, void(i8*)* %bstepfn)");
        H("  call void @free(i8* %best)");
        H("  br label %loop");
        H("iopump:");
        H("  %woke = call i32 @zan_io_pump()");
        H("  %iomore = icmp sgt i32 %woke, 0");
        H("  br i1 %iomore, label %loop, label %exit");
        H("exit:");
        H("  ret void");
        H("}");
    }

    // ===== Task 句柄的内建族（Task.Run / Spawn / Wait / Result / IsCompleted）=====
    //
    // 自举把任务句柄族降级到**自己**的帧布局上（文件头的扁平 i64 帧）：句柄
    // 就是帧指针，done 标志在槽 3，结果在槽 6。宿主做的是同一件事，只是帧头
    // 布局不同（src/compiler/irgen_expr_core.c 的 emit_task_member：先跑
    // test/pump 循环等完成，再读结果并回收）——两边一致的是**可观察行为**，
    // 不是字节。
    //
    // 句柄以 i8*（帧指针）流动：`long h = task` 用 ptrtoint 打包，
    // `Task.IsDone(h)` 用 inttoptr 拆包——与宿主对 i64 句柄的往返一致。

    // 帧的 i64* 视图
    string TaskFrameHeader(string fp) {
        string p = NT();
        L("  " + p + " = bitcast i8* " + fp + " to i64*");
        return p;
    }

    // 等帧跑完：泵协作调度器直到 done 标志置位（宿主的 tk.test/tk.pump 循环）
    void EmitTaskWait(string fp) {
        string fph = TaskFrameHeader(fp);
        string dp = FrameGep(fph, 3);
        int lt = NL(); int lw = NL(); int ld = NL();
        L("  br label %L" + lt);
        term = true;
        Label(lt);
        string dn = NT(); L("  " + dn + " = load i64, i64* " + dp);
        string c = NT(); L("  " + c + " = icmp ne i64 " + dn + ", 0");
        L("  br i1 " + c + ", label %L" + ld + ", label %L" + lw);
        Label(lw);
        L("  call void @zan_co_sched_run()");
        L("  br label %L" + lt);
        Label(ld);
    }

    // 帧的 done 标志（i64 的 0/1）
    string TaskDoneValue(string fp) {
        string fph = TaskFrameHeader(fp);
        string dp = FrameGep(fph, 3);
        string dn = NT(); L("  " + dn + " = load i64, i64* " + dp);
        string c = NT(); L("  " + c + " = icmp ne i64 " + dn + ", 0");
        string r = NT(); L("  " + r + " = zext i1 " + c + " to i64");
        return r;
    }

    // lambda 体里有没有带值的 return（宿主: lambda_body_has_value_return）
    bool TaskLambdaHasValueReturn(Node n) {
        if (n == null) { return false; }
        if (n.kind == AK.ReturnStmt()) { return n.a != null; }
        if (n.kind == AK.Lambda()) { return false; }
        if (TaskLambdaHasValueReturn(n.a) || TaskLambdaHasValueReturn(n.b)
            || TaskLambdaHasValueReturn(n.c) || TaskLambdaHasValueReturn(n.d)) { return true; }
        int i = 0;
        while (i < n.kids.Count) {
            if (TaskLambdaHasValueReturn(n.kids[i])) { return true; }
            i = i + 1;
        }
        return false;
    }

    // action 帧的 step 函数：跑委托，然后置 done。按调用点各生成一份（像
    // lambda 那样），因为委托的函数类型只有调用点知道。宿主用的是一份共享
    // 的 step（它的委托形状被固定成 Action），这里按调用点特化，行为一致。
    string EmitTaskActionStep() {
        int id = lamCount; lamCount = lamCount + 1;
        string fname = "@__task_action_step_" + id;
        // 保存外层函数的状态
        StringBuilder savedBody = body;
        int sTmp = tmp; int sLbl = lbl; bool sTerm = term; string sCurLbl = curLbl;
        string sRet = curRet; Node sRetTy = curRetTy; string sClass = curClass; bool sHasThis = curHasThis;
        List<string> sLocName = locName; List<Node> sLocType = locType;
        List<string> sLocReg = locReg; int sLocSeq = locSeq;
        List<bool> sLocBox = locBox; List<bool> sLocIter = locIter; List<string> sLocCell = locCell;
        List<string> sCapNames = capNames;
        int sBrk = brkTarget; int sCont = contTarget; int sLoopScope = loopScopeBase;
        List<string> svT = stmtTemps; List<Node> svTT = stmtTempTypes;
        StringBuilder sEa = entryAllocas; bool sEaAct = eaActive;
        bool sAsync = curAsync;
        body = new StringBuilder();
        entryAllocas = new StringBuilder(); eaActive = true;
        tmp = 0; lbl = 0; term = false; curLbl = "entry"; curAsync = false;
        locName = new List<string>(); locType = new List<Node>(); locReg = new List<string>(); locSeq = 0;
        locBox = new List<bool>(); locIter = new List<bool>(); locCell = new List<string>();
        capNames = new List<string>();
        curRet = "void"; curRetTy = MkType("void"); curClass = ""; curHasThis = false;
        brkTarget = 0; contTarget = 0;
        stmtTemps = new List<string>(); stmtTempTypes = new List<Node>();

        // %fp 是 action 帧：槽 10 存委托（带闭包标签的指针）
        string fph = NT(); L("  " + fph + " = bitcast i8* %fp to i64*");
        string dlgp = FrameGep(fph, 10);
        string dlgi = NT(); L("  " + dlgi + " = load i64, i64* " + dlgp);
        string dlg = NT();
        L("  " + dlg + " = inttoptr i64 " + dlgi + " to i8*");
        string iv = NT(); L("  " + iv + " = ptrtoint i8* " + dlg + " to i64");
        string bit = NT(); L("  " + bit + " = and i64 " + iv + ", 1");
        string isClo = NT(); L("  " + isClo + " = icmp ne i64 " + bit + ", 0");
        int lClo = NL(); int lBare = NL(); int lFin = NL();
        L("  br i1 " + isClo + ", label %L" + lClo + ", label %L" + lBare);
        Label(lClo);
        // 闭包：记录 { fn, env }，调用时把 env 作为第一个实参
        string uv = NT(); L("  " + uv + " = and i64 " + iv + ", -2");
        string rec = NT(); L("  " + rec + " = inttoptr i64 " + uv + " to i8*");
        string clop = NT(); L("  " + clop + " = bitcast i8* " + rec + " to i8**");
        string fni8 = NT(); L("  " + fni8 + " = load i8*, i8** " + clop);
        string envp = NT(); L("  " + envp + " = getelementptr i8*, i8** " + clop + ", i64 1");
        string env = NT(); L("  " + env + " = load i8*, i8** " + envp);
        string fpc = NT(); L("  " + fpc + " = bitcast i8* " + fni8 + " to void (i8*)*");
        L("  call void (i8*) " + fpc + "(i8* " + env + ")");
        L("  br label %L" + lFin);
        Label(lBare);
        // 裸函数指针：没有 env 槽
        string fnb = NT(); L("  " + fnb + " = inttoptr i64 " + iv + " to i8*");
        string fpb = NT(); L("  " + fpb + " = bitcast i8* " + fnb + " to void ()*");
        L("  call void () " + fpb + "()");
        L("  br label %L" + lFin);
        Label(lFin);
        // done = 1，state = -1
        string dp = FrameGep(fph, 3);
        L("  store i64 1, i64* " + dp);
        string sp = FrameGep(fph, 2);
        L("  store i64 -1, i64* " + sp);
        // 唤醒等待者（槽 4/5）——与 EmitAsyncComplete 同一套协议
        string awp = FrameGep(fph, 4);
        string awi = NT(); L("  " + awi + " = load i64, i64* " + awp);
        string aw = NT(); L("  " + aw + " = inttoptr i64 " + awi + " to i8*");
        string has = NT(); L("  " + has + " = icmp ne i8* " + aw + ", null");
        int lw = NL(); int lr = NL();
        L("  br i1 " + has + ", label %L" + lw + ", label %L" + lr);
        Label(lw);
        string asp = FrameGep(fph, 5);
        string asi = NT(); L("  " + asi + " = load i64, i64* " + asp);
        string asfn = NT(); L("  " + asfn + " = inttoptr i64 " + asi + " to void(i8*)*");
        L("  call void @zan_co_ready(i8* " + aw + ", void(i8*)* " + asfn + ")");
        L("  br label %L" + lr);
        Label(lr);
        L("  ret void");

        deferred.Append("define internal void " + fname + "(i8* %fp) {\n");
        deferred.Append("entry:\n");
        deferred.Append(entryAllocas.ToString());
        deferred.Append(body.ToString());
        deferred.Append("}\n");

        // 恢复外层函数的状态
        body = savedBody;
        tmp = sTmp; lbl = sLbl; term = sTerm; curLbl = sCurLbl;
        curRet = sRet; curRetTy = sRetTy; curClass = sClass; curHasThis = sHasThis;
        locName = sLocName; locType = sLocType; locReg = sLocReg; locSeq = sLocSeq;
        locBox = sLocBox; locIter = sLocIter; locCell = sLocCell; capNames = sCapNames;
        brkTarget = sBrk; contTarget = sCont; loopScopeBase = sLoopScope;
        stmtTemps = svT; stmtTempTypes = svTT;
        entryAllocas = sEa; eaActive = sEaAct;
        curAsync = sAsync;
        return fname;
    }

    // action 帧：跑一个委托、没有结果的任务帧。槽 10 存委托。
    // 帧不释放：宿主靠运行时的活跃帧登记表回收，自举没有那个登记表，而
    // 句柄在任务完成后还要能读 done 标志（IsCompleted）——提前释放就是
    // 读已释放内存。代价是每个 action 帧泄漏 88 字节（不是 ARC 对象，
    // 泄漏检查看不见）。
    ExprVal EmitTaskActionFrame(ExprVal dlg) {
        string raw = NT();
        L("  " + raw + " = call i8* @malloc(i64 88)");
        string fph = NT(); L("  " + fph + " = bitcast i8* " + raw + " to i64*");
        int i = 0;
        while (i < 11) {
            L("  store i64 0, i64* " + FrameGep(fph, i));
            i = i + 1;
        }
        string dlgp = FrameGep(fph, 10);
        string dlgv = NT(); L("  " + dlgv + " = ptrtoint i8* " + dlg.op + " to i64");
        L("  store i64 " + dlgv + ", i64* " + dlgp);
        string step = EmitTaskActionStep();
        L("  call void @zan_co_ready(i8* " + raw + ", void(i8*)* " + step + ")");
        return new ExprVal(raw, MkType("Task"));
    }

    // 把一个 async 调用的帧交给调度器。selfReap=true 时帧自己回收自己
    // （宿主: emit_detach_async_call 把 AWAITER 设成自己、AWAITER_STEP 设成
    // 回收函数）；Task.Run 的带结果形态不设——结果由读者（.Result）取走。
    void EmitTaskReadyFrame(ExprVal sub, bool selfReap) {
        string subv = sub.op;
        string fph = NT(); L("  " + fph + " = bitcast i8* " + subv + " to i64*");
        if (selfReap) {
            string selfi = NT(); L("  " + selfi + " = ptrtoint i8* " + subv + " to i64");
            L("  store i64 " + selfi + ", i64* " + FrameGep(fph, 4));
            string reapi = NT(); L("  " + reapi + " = ptrtoint void(i8*)* @__zan_co_reap to i64");
            L("  store i64 " + reapi + ", i64* " + FrameGep(fph, 5));
        }
        // 帧的槽 9 是自己的 resume 入口（ramp 写的）
        string orp = FrameGep(fph, 9);
        string ori = NT(); L("  " + ori + " = load i64, i64* " + orp);
        string orfn = NT(); L("  " + orfn + " = inttoptr i64 " + ori + " to void(i8*)*");
        L("  call void @zan_co_ready(i8* " + subv + ", void(i8*)* " + orfn + ")");
    }

    // Task.Run(arg) / Task.Spawn(arg)
    ExprVal EmitTaskRunCall(Node e, bool spawn) {
        usesAsync = true;
        Node arg = e.kids[0];
        // 委托形态：宿主把 lambda 固定成 Action 形状（无参、无结果），自举
        // 同样把 lambda 的返回类型按 void 处理。
        bool isLam = (arg.kind == AK.Lambda());
        Node savedTy = null;
        if (isLam) {
            if (arg.kids.Count != 0 || TaskLambdaHasValueReturn(arg.d)
                || TaskLambdaHasValueReturn(arg.a)) {
                diags.Error("Task.Run delegate must be a parameterless void body (an Action); " +
                    "pass an async call for results", arg.line, arg.col);
                return new ExprVal("0", MkType("int"));
            }
            savedTy = arg.type;
            arg.type = MkType("void");
        }
        ExprVal av = GenExpr(arg);
        if (isLam && savedTy != null) { arg.type = savedTy; }
        // 委托形态：没有结果的任务
        if (av.ty != null && IsDelegate(av.ty)) {
            if (DelegParams(av.ty).Count != 0) {
                diags.Error("Task.Run delegate must take no parameters", arg.line, arg.col);
                return new ExprVal("0", MkType("int"));
            }
            Node rt = DelegRet(av.ty);
            if (rt == null || rt.sval != "void") {
                diags.Error("Task.Run delegate must be a parameterless void body (an Action); " +
                    "pass an async call for results", arg.line, arg.col);
                return new ExprVal("0", MkType("int"));
            }
            return EmitTaskActionFrame(av);
        }
        // async 调用形态：调用的帧就是任务帧
        if (!av.asyncCall) {
            diags.Error("call to '" + (spawn ? "Task.Spawn" : "Task.Run")
                + "' is not supported by the self-hosted compiler yet", e.line, e.col);
            return new ExprVal("0", MkType("int"));
        }
        EmitTaskReadyFrame(av, spawn);
        Node hty = MkType("Task");
        if (!spawn && av.ty != null && av.ty.a != null) {
            Node elem = AsyncElemTyOf(av.ty.a);
            if (elem != null && elem.sval != "void") { hty.Add(elem); }
        }
        return new ExprVal(av.op, hty);
    }

    // 句柄上的成员：Wait / Result / IsCompleted
    ExprVal EmitTaskMemberCall(ExprVal recv, string mname, Node e) {
        string fp = recv.op;
        if (mname == "Wait") {
            EmitTaskWait(fp);
            return new ExprVal("0", MkType("void"));
        }
        if (mname == "IsCompleted") {
            return new ExprVal(TaskDoneValue(fp), MkType("int"));
        }
        if (mname == "Result") {
            Node elem = null;
            if (recv.ty != null && recv.ty.kids.Count == 1) { elem = recv.ty.kids[0]; }
            if (elem == null) {
                diags.Error("Task.Result requires a Task<T> value", e.line, e.col);
                return new ExprVal("0", MkType("int"));
            }
            EmitTaskWait(fp);
            string fph = TaskFrameHeader(fp);
            string rp = FrameGep(fph, 6);
            string resi = NT(); L("  " + resi + " = load i64, i64* " + rp);
            string rvv = FromI64(resi, MapType(elem));
            // 帧由读者回收（宿主: co_reap）
            L("  call void @__zan_co_frame_free(i8* " + fp + ")");
            return new ExprVal(rvv, elem);
        }
        diags.Error("member '" + mname + "' of type 'Task' is not supported by the self-hosted "
            + "compiler yet", e.line, e.col);
        return new ExprVal("0", MkType("int"));
    }

    // Task.IsDone(handle)：裸句柄是否已经跑完。
    // 自举没有宿主那样的工作线程池：任务只在**主线程泵调度器**时前进，
    // 所以这里在读到「还没完」时给调度器一次机会——否则
    // `while (Task.IsDone(h) == 0) {}` 这种忙等永远推不动。
    ExprVal EmitTaskIsDone(Node e) {
        ExprVal h = GenExpr(e.kids[0]);
        string fp;
        if (MapType(h.ty) == "i64") {
            fp = NT(); L("  " + fp + " = inttoptr i64 " + h.op + " to i8*");
        } else {
            fp = h.op;
        }
        string fph = TaskFrameHeader(fp);
        string dp = FrameGep(fph, 3);
        string dn = NT(); L("  " + dn + " = load i64, i64* " + dp);
        string c = NT(); L("  " + c + " = icmp ne i64 " + dn + ", 0");
        int lYes = NL(); int lNo = NL(); int lZero = NL(); int lJoin = NL();
        L("  br i1 " + c + ", label %L" + lYes + ", label %L" + lNo);
        Label(lNo);
        L("  call void @zan_co_sched_run()");
        string dn2 = NT(); L("  " + dn2 + " = load i64, i64* " + dp);
        string c2 = NT(); L("  " + c2 + " = icmp ne i64 " + dn2 + ", 0");
        L("  br i1 " + c2 + ", label %L" + lYes + ", label %L" + lZero);
        Label(lZero);
        L("  br label %L" + lJoin);
        Label(lYes);
        L("  br label %L" + lJoin);
        Label(lJoin);
        string r = NT();
        L("  " + r + " = phi i64 [ 0, %L" + lZero + " ], [ 1, %L" + lYes + " ]");
        return new ExprVal(r, MkType("int"));
    }

    void GenMethod(Node cls, Node m, bool ctor) {
        // hardware vectors: every static body (Zero/AllBitsSet getters etc.)
        // is lowered at the call site by GenBuiltinStatic — no function bodies
        if (cls != null && (cls.sval == "Vector128" || cls.sval == "Vector256")) { return; }
        NormalizeAwaits(cls, m);
        if (IsAsync(m)) { GenAsyncMethod(cls, m); return; }
        StartFn();
        // a closure in this method may capture the method's locals: the names
        // it mentions have to live in a cell
        CollectCapturedNames(m.d, capNames);
        curClass = cls.sval;
        curRet = MapType(m.type);
        curRetTy = m.type;
        bool stat = IsStatic(m);
        curHasThis = !stat;
        string sig = "define " + curRet + " @" + MethodSym(cls.sval, m) + "(";
        int np = 0;
        if (!stat) {
            sig = sig + "%" + cls.sval + "* %this";
            np = 1;
        }
        List<string> pn = new List<string>();
        List<Node> pt = new List<Node>();
        List<int> pr = new List<int>();
        int i = 0;
        while (i < m.kids.Count) {
            Node p = m.kids[i];
            if (p.kind == AK.Param()) { pn.Add(p.sval); pt.Add(p.type); pr.Add(p.ival); }
            i = i + 1;
        }
        int j = 0;
        while (j < pn.Count) {
            if (np > 0) { sig = sig + ", "; }
            if (pr[j] == 1) { sig = sig + MapType(pt[j]) + "* %p" + j; }
            else { sig = sig + MapType(pt[j]) + " %p" + j; }
            np = np + 1;
            j = j + 1;
        }
        sig = sig + ") {";
        L(sig);
        L("entry:");
        StringBuilder obody = body; StringBuilder oea = entryAllocas; bool oact = eaActive;
        body = new StringBuilder(); entryAllocas = new StringBuilder(); eaActive = true;
        j = 0;
        while (j < pn.Count) {
            string lt = MapType(pt[j]);
            if (pr[j] == 1) {
                // `ref`/`out` value-type parameter: the incoming pointer IS the
                // storage slot, so reads/writes go through to the caller's
                // variable (mirrors irgen_emit.c). Managed types are rejected
                // at the call site (no byref ARC here).
                locName.Add(pn[j]); locType.Add(pt[j]); locReg.Add("%p" + j);
                locBox.Add(false); locIter.Add(false); locCell.Add("");
                j = j + 1;
                continue;
            }
            string preg = AddLocal(pn[j], pt[j]);
            if (ShouldBox(pn[j])) {
                // a closure in this method may capture the parameter: it has
                // to live in a cell
                preg = BoxLocal(locName.Count - 1);
            } else {
                L("  " + preg + " = alloca " + lt);
            }
            L("  store " + lt + " %p" + j + ", " + lt + "* " + preg);
            EmitArcRetain("%p" + j, pt[j]);
            j = j + 1;
        }
        if (m.d != null) { GenStmt(m.d); }
        if (!term) {
            ReleaseLocalsFrom(0);
            if (curRet == "void") { L("  ret void"); }
            else if (curRet == "i64") { L("  ret i64 0"); }
            else { L("  ret " + curRet + " null"); }
        }
        L("}");
        obody.Append(entryAllocas.ToString());
        obody.Append(body.ToString());
        body = obody; entryAllocas = oea; eaActive = oact;
    }

    void GenCtor(Node cls, Node m) {
        StartFn();
        // a closure in this constructor may capture its locals
        CollectCapturedNames(m.d, capNames);
        curClass = cls.sval;
        curRet = "void";
        curHasThis = true;
        string sig = "define void @" + CtorSym(cls.sval, m) + "(%" + cls.sval + "* %this";
        List<string> pn = new List<string>();
        List<Node> pt = new List<Node>();
        int i = 0;
        while (i < m.kids.Count) {
            Node p = m.kids[i];
            if (p.kind == AK.Param()) { pn.Add(p.sval); pt.Add(p.type); }
            i = i + 1;
        }
        int j = 0;
        while (j < pn.Count) {
            sig = sig + ", " + MapType(pt[j]) + " %p" + j;
            j = j + 1;
        }
        sig = sig + ") {";
        L(sig);
        L("entry:");
        StringBuilder obody = body; StringBuilder oea = entryAllocas; bool oact = eaActive;
        body = new StringBuilder(); entryAllocas = new StringBuilder(); eaActive = true;
        j = 0;
        while (j < pn.Count) {
            string lt = MapType(pt[j]);
            string preg = AddLocal(pn[j], pt[j]);
            if (ShouldBox(pn[j])) {
                preg = BoxLocal(locName.Count - 1);
            } else {
                L("  " + preg + " = alloca " + lt);
            }
            L("  store " + lt + " %p" + j + ", " + lt + "* " + preg);
            EmitArcRetain("%p" + j, pt[j]);
            j = j + 1;
        }
        // Constructor chaining and the field initializers (C# order):
        //   * `: this(...)` hands the whole job to the target constructor of
        //     the same class: it runs the field initializers and the base
        //     chain, so this constructor runs neither;
        //   * otherwise the base constructor runs first (it runs the base
        //     class' own field initializers), then this class' field
        //     initializers, then the constructor body. When no base
        //     constructor is called the base chain's field initializers run
        //     here instead -- before this class' own.
        if (m.c != null) {
            Node thisTarget = ResolveCtorEx(cls, m.c, m);
            if (thisTarget != null) {
                string targs = "%" + cls.sval + "* %this";
                int k = 0;
                while (k < m.c.kids.Count) {
                    Node tpty = CtorParamType(thisTarget, k);
                    ExprVal av = GenArgExpr(m.c.kids[k], tpty);
                    targs = targs + ", " + MapType(tpty) + " " + CallArg(av, tpty);
                    k = k + 1;
                }
                L("  call void @" + CtorSym(cls.sval, thisTarget) + "(" + targs + ")");
            } else {
                diags.Error("no matching this constructor with "
                    + m.c.kids.Count + " argument(s)", m.line, m.col);
            }
        } else {
            Node bcls = BaseClassOf(cls);
            bool baseCalled = false;
            if (bcls != null) {
                // `: base(args)` picks the base constructor by its arguments;
                // without it the parameterless one is taken
                Node bctor = null;
                if (m.b != null) {
                    bctor = ResolveCtor(bcls, m.b);
                    if (bctor == null) {
                        diags.Error("no matching base constructor with "
                            + m.b.kids.Count + " argument(s)", m.line, m.col);
                    }
                } else {
                    bctor = binder.FindCtorArity(bcls, 0);
                }
                if (bctor != null) {
                    string bthis = NT();
                    L("  " + bthis + " = bitcast %" + cls.sval + "* %this to %" + bcls.sval + "*");
                    string bargs = "%" + bcls.sval + "* " + bthis;
                    if (m.b != null) {
                        int k = 0;
                        while (k < m.b.kids.Count) {
                            Node bpty = CtorParamType(bctor, k);
                            ExprVal av = GenArgExpr(m.b.kids[k], bpty);
                            bargs = bargs + ", " + MapType(bpty) + " " + CallArg(av, bpty);
                            k = k + 1;
                        }
                    }
                    L("  call void @" + CtorSym(bcls.sval, bctor) + "(" + bargs + ")");
                    baseCalled = true;
                }
            }
            if (!baseCalled && bcls != null && HasChainFieldInits(bcls)) {
                // no base constructor ran: the base chain's field
                // initializers run here, before this class' own
                string bthis = NT();
                L("  " + bthis + " = bitcast %" + cls.sval + "* %this to %" + bcls.sval + "*");
                L("  call void @" + FieldInitsSym(bcls) + "(%" + bcls.sval + "* " + bthis + ")");
            }
            EmitFieldInits(cls, "%this");
        }
        if (m.d != null) { GenStmt(m.d); }
        if (!term) {
            ReleaseLocalsFrom(0);
            L("  ret void");
        }
        L("}");
        obody.Append(entryAllocas.ToString());
        obody.Append(body.ToString());
        body = obody; entryAllocas = oea; eaActive = oact;
    }

    // A static constructor: `static C() { ... }`. It has no receiver and it
    // runs once at program entry, after the class's static field
    // initializers (the C host's order: the field initializers of a class
    // run before that class's static constructor).
    void GenStaticCtor(Node cls, Node m) {
        StartFn();
        CollectCapturedNames(m.d, capNames);
        curClass = cls.sval;
        curRet = "void";
        curHasThis = false;
        L("define void @" + StaticCtorSym(cls.sval) + "() {");
        L("entry:");
        StringBuilder obody = body; StringBuilder oea = entryAllocas; bool oact = eaActive;
        body = new StringBuilder(); entryAllocas = new StringBuilder(); eaActive = true;
        if (m.d != null) { GenStmt(m.d); }
        if (!term) {
            ReleaseLocalsFrom(0);
            L("  ret void");
        }
        L("}");
        obody.Append(entryAllocas.ToString());
        obody.Append(body.ToString());
        body = obody; entryAllocas = oea; eaActive = oact;
    }

    // The field initializer helper of `cls`: it runs the instance field
    // initializers of the whole inheritance chain, root first. It stands in
    // for the implicit parameterless constructor: the allocation site calls
    // it when no constructor matches, and a derived constructor calls the
    // base class' helper when the base constructor was not called.
    void GenFieldInitsFn(Node cls) {
        StartFn();
        curClass = cls.sval;
        curRet = "void";
        curHasThis = true;
        L("define void @" + FieldInitsSym(cls) + "(%" + cls.sval + "* %this) {");
        L("entry:");
        StringBuilder obody = body; StringBuilder oea = entryAllocas; bool oact = eaActive;
        body = new StringBuilder(); entryAllocas = new StringBuilder(); eaActive = true;
        EmitChainFieldInits(cls, "%this", cls.sval);
        if (!term) { L("  ret void"); }
        L("}");
        obody.Append(entryAllocas.ToString());
        obody.Append(body.ToString());
        body = obody; entryAllocas = oea; eaActive = oact;
    }

    // Emit: if `cond` (an i1) holds, print `msg` and exit(1) -- never falling
    // through with an invalid result. Shared by every I/O return-value check.
    void EmitAbortIf(string cond, string msg, int len) {
        int lf = NL(); int lk = NL();
        L("  br i1 " + cond + ", label %L" + lf + ", label %L" + lk);
        Label(lf);
        string em = NT(); L("  " + em + " = getelementptr inbounds [" + len + " x i8], [" + len + " x i8]* " + msg + ", i64 0, i64 0");
        L("  call i32 (i8*, ...) @printf(i8* " + em + ")");
        L("  call void @exit(i32 1)");
        L("  unreachable");
        Label(lk);
    }

    void EmitFopenCheck(string fp, string msg, int len) {
        string np = NT(); L("  " + np + " = icmp eq i8* " + fp + ", null");
        EmitAbortIf(np, msg, len);
    }

    void GenMainWrapper(Node unit) {
        string owner = "";
        Node mainMeth = null;
        int i = 0;
        while (i < unit.kids.Count) {
            Node d = unit.kids[i];
            if (d.kind == AK.ClassDecl() || d.kind == AK.StructDecl()) {
                Node mm = binder.FindMethod(d, "Main");
                if (mm != null) { owner = d.sval; mainMeth = mm; }
            }
            i = i + 1;
        }
        if (owner == "") { return; }
        L("define i32 @main(i32 %argc, i8** %argv) {");
        L("entry:");
        StringBuilder obody = body; StringBuilder oea = entryAllocas; bool oact = eaActive;
        body = new StringBuilder(); entryAllocas = new StringBuilder(); eaActive = true;
        L("  store i32 %argc, i32* @__zan_argc");
        L("  store i8** %argv, i8*** @__zan_argv");
        // Programs emit UTF-8 bytes; switch the Windows console to code page
        // 65001 so CJK/accented output renders instead of mojibake. Redirected
        // output (pipe/file) keeps its raw UTF-8 bytes.
        if (hostWin) {
            L("  call i32 @SetConsoleOutputCP(i32 65001)");
            L("  call i32 @SetConsoleCP(i32 65001)");
        }
        // Initialize the coroutine scheduler in the program entry, the way the
        // C host does (src/compiler/irgen_emit.c:132 -- emit_main calls
        // zan_co_sched_init).
        //
        // Which implementation this call reaches depends on what is linked:
        //  - the self-host ships its own **weak** fallback (EmitAsyncPumpReady
        //    below) that clears the self-host's own scheduler state; the
        //    self-hosted runtime objects (zanrt_shd_rt_io.obj etc.) define no
        //    zan_co_* strong symbol, so today this call only resets the
        //    self-host's scheduler -- a structural mirror of the host, no
        //    observable behavior change;
        //  - once the full runtime is linked (A385: the frame layout has to
        //    match zan_co_fhdr first), the runtime's strong
        //    zan_co_sched_init wins (src/runtime/rt_io.c:4242) and installs
        //    the timer ready hook, so a delayed frame is re-queued onto the
        //    scheduler instead of being resumed on the timer thread
        //    (src/runtime/rt_timer.c:729).
        L("  call void @zan_co_sched_init()");
        // Install a root exception handler so an uncaught throw prints a
        // message and exits 1 instead of longjmp-ing through an empty stack.
        string rbuf = NT(); L("  " + rbuf + " = alloca [32 x i64], align 32");
        string rbp = NT(); L("  " + rbp + " = bitcast [32 x i64]* " + rbuf + " to i8*");
        string rsp = NT(); L("  " + rsp + " = load i64, i64* @__exc_sp");
        string rslot = NT(); L("  " + rslot + " = getelementptr [64 x i8*], [64 x i8*]* @__exc_stack, i64 0, i64 " + rsp);
        L("  store i8* " + rbp + ", i8** " + rslot);
        string rsp1 = NT(); L("  " + rsp1 + " = add i64 " + rsp + ", 1");
        L("  store i64 " + rsp1 + ", i64* @__exc_sp");
        string rfp = NT(); L("  " + rfp + " = call i8* @llvm.frameaddress.p0(i32 0)");
        string rr = NT(); L("  " + rr + " = call i32 @_setjmp(i8* " + rbp + ", i8* " + rfp + ")");
        string rc = NT(); L("  " + rc + " = icmp ne i32 " + rr + ", 0");
        int lbody = NL(); int lcatch = NL();
        L("  br i1 " + rc + ", label %L" + lcatch + ", label %L" + lbody);
        Label(lbody);
        EmitStaticInits(unit);
        if (mainMeth != null && IsAsync(mainMeth) && IsStatic(mainMeth)) {
            // An async Main is a coroutine: its ramp only allocates the frame
            // and returns it -- the body runs from $resume. Calling the ramp
            // like an ordinary function would allocate a frame and never run
            // the body (the program would print nothing). The entry readies
            // the frame on the cooperative scheduler and runs it to completion
            // (mirrors the C host's emit_main_method).
            string mainSym = MethodSym(owner, mainMeth);
            string fr = NT(); L("  " + fr + " = call i8* @" + mainSym + "()");
            L("  call void @zan_co_sched_init()");
            string rs = NT(); L("  " + rs + " = ptrtoint void(i8*)* @" + mainSym + "$resume to i64");
            string rf = NT(); L("  " + rf + " = inttoptr i64 " + rs + " to void(i8*)*");
            L("  call void @zan_co_ready(i8* " + fr + ", void(i8*)* " + rf + ")");
            L("  call void @zan_co_sched_run()");
            string mrt = MapType(mainMeth.type);
            if (mrt == "void") {
                // The awaiter owns the frame: release it once the coroutine
                // is done. An exception unwinds the frame through its own
                // cleanup (which frees it), so this path is completion only.
                L("  call void @__zan_co_frame_free(i8* " + fr + ")");
                L("  ret i32 0");
            } else {
                // read the result before the frame is released
                string fh = NT(); L("  " + fh + " = bitcast i8* " + fr + " to i64*");
                string rp = FrameGep(fh, 6);
                string ri = NT(); L("  " + ri + " = load i64, i64* " + rp);
                L("  call void @__zan_co_frame_free(i8* " + fr + ")");
                L("  ret i32 (trunc i64 " + ri + " to i32)");
            }
        } else {
            L("  call void @" + owner + "_Main()");
            L("  ret i32 0");
        }
        Label(lcatch);
        string mp = NT(); L("  " + mp + " = getelementptr inbounds [25 x i8], [25 x i8]* @.msg.unhandled, i64 0, i64 0");
        string xv = NT(); L("  " + xv + " = load i8*, i8** @__exc_val");
        string xn = NT(); L("  " + xn + " = icmp eq i8* " + xv + ", null");
        string xm = NT(); L("  " + xm + " = select i1 " + xn + ", i8* getelementptr inbounds ([13 x i8], [13 x i8]* @.msg.exnil, i64 0, i64 0), i8* " + xv);
        L("  call i32 (i8*, ...) @printf(i8* " + mp + ", i8* " + xm + ")");
        L("  ret i32 1");
        L("}");
        obody.Append(entryAllocas.ToString());
        obody.Append(body.ToString());
        body = obody; entryAllocas = oea; eaActive = oact;
    }
}
