using System;
using System.Collections.Generic;
namespace Zan;

partial class Ngen {
    // ---- labels ----
    int NL() { lblPos.Add(-1); nlabel = nlabel + 1; return nlabel - 1; }
    void Mark(int l) { lblPos[l] = txt.Count; }

    string HexByteNg(int b) {
        string h = "0123456789ABCDEF";
        return h.Substring((b >> 4) & 15, 1) + h.Substring(b & 15, 1);
    }

    // emit one instruction word, little-endian. Batch 27 gate: with the
    // x86_64 lane selected, a raw word means an emitter missed its tgt86
    // branch -- such bytes are valid arm64 but derail Rosetta's AOT
    // translator (the k9/k11/k28 wedge), so they fail closed at compile
    // time instead of poisoning the object.
    void E4(int w) {
        if (tgt86 == 1) {
            diags.Error("ngen: raw arm64 word " + HexByteNg((w >> 24) & 255) + HexByteNg((w >> 16) & 255) + HexByteNg((w >> 8) & 255) + HexByteNg(w & 255) + " reached the x86_64 lane (emitter missing its tgt86 arm) [in " + (syms.Count > 0 ? syms[syms.Count - 1].name : "?") + "]", curLine, curCol);
            return;
        }
        txt.Add(ByteAt(w, 0)); txt.Add(ByteAt(w, 1));
        txt.Add(ByteAt(w, 2)); txt.Add(ByteAt(w, 3));
    }

    // ---- local load/store ----
    // Locals are addressed relative to the frame pointer (x29) with a signed
    // unscaled imm9 (LDUR/STUR), so push/pop scratch traffic on sp never
    // changes how a local is found. x29 points at the saved x29/x30 pair and
    // the frame starts right below it: local i lives at x29 + (16*i - frame).
    int LocFpOff(int off) {
        return off - frame;
    }
    void LoadLocal(int li, int reg) {
        if (tgt86 == 1) {
            if (li < 0 || li >= locOff.Count) {
                diags.Error("ngen: local slot " + li + " out of range", curLine, curCol);
                LoadImm(reg, 0);
                return;
            }
            int off = LocFpOff(locOff[li]);
            int r = XMapReal(reg);
            if (r >= 0) { XopRMem(0x8B, r, 5, off); }        // mov r, [rbp+off]
            else { XopRMem(0x8B, 10, 5, off); XSetV(reg, 10); }
            return;
        }
        if (li < 0 || li >= locOff.Count) {
            // fail closed: the runtime list guard would silently read slot 0
            diags.Error("ngen: local slot " + li + " out of range", curLine, curCol);
            LoadImm(reg, 0);
            return;
        }
        int off = LocFpOff(locOff[li]);
        if (off >= -256 && off <= 255) {
            E4(0xF8400000 | ((off & 0x1FF) << 12) | (29 << 5) | reg);
        } else {
            int addr = reg == 16 ? 17 : 16;
            LoadImm(addr, off);
            AddRR(addr, 29, addr);
            LdrU(reg, addr, 0);
        }
    }
    void StoreLocal(int li, int reg) {
        if (tgt86 == 1) {
            if (li < 0 || li >= locOff.Count) {
                diags.Error("ngen: local slot " + li + " out of range", curLine, curCol);
                return;
            }
            int off = LocFpOff(locOff[li]);
            int r = XMapReal(reg);
            if (r >= 0) { XopMemR(0x89, r, 5, off); }        // mov [rbp+off], r
            else { XGetV(reg, 10); XopMemR(0x89, 10, 5, off); }
            return;
        }
        if (li < 0 || li >= locOff.Count) {
            diags.Error("ngen: local slot " + li + " out of range", curLine, curCol);
            return;
        }
        int off = LocFpOff(locOff[li]);
        if (off >= -256 && off <= 255) {
            E4(0xF8000000 | ((off & 0x1FF) << 12) | (29 << 5) | reg);
        } else {
            // x16/x17 are scratch, never an incoming x0..x7 argument.
            int addr = reg == 16 ? 17 : 16;
            LoadImm(addr, off);
            AddRR(addr, 29, addr);
            StrU(reg, addr, 0);
        }
    }

    // ---- immediates ----
    void LoadImm(int reg, long v) {
        if (tgt86 == 1) { XLoadImm(reg, v); return; }
        if (v >= 0 && v < 65536) {
            E4((int)(0xD2800000 | (v << 5) | reg));      // movz x, #v
            return;
        }
        if (v < 0 && v >= -65536) {
            E4((int)(0x92800000 | (((-v) - 1) << 5) | reg)); // movn x, #~v
            return;
        }
        // 16-bit chunks: plain truncating division mis-extracts negative
        // values (e.g. i64min's top chunk comes out as -32768), so fold the
        // chunk back into [0, 65536).
        long chunk0 = v - (v / 65536) * 65536;
        if (chunk0 < 0) { chunk0 = chunk0 + 65536; }
        E4((int)(0xD2800000 | (chunk0 << 5) | reg));     // movz x, #c0
        int h = 1;
        while (h < 4) {
            long sh = ShiftRight(v, h * 16);
            long chunk = sh - (sh / 65536) * 65536;
            if (chunk < 0) { chunk = chunk + 65536; }
            E4((int)(0xF2800000 | (((long)h) << 21) | (chunk << 5) | reg)); // movk
            h = h + 1;
        }
    }

    long ShiftRight(long v, int bits) {
        // arithmetic (floor) shift: plain halving truncates toward zero, so
        // e.g. 0xFF378ADD's narrowed int32 value -13137187 >> 16 must give
        // -201 (chunk 0xFF37), not -200 (chunk 0xFF38)
        long r = v;
        int n = bits;
        while (n > 0) {
            long prev = r;
            r = prev / 2;
            if (prev < 0 && r * 2 != prev) { r = r - 1; }
            n = n - 1;
        }
        return r;
    }

    // add/sub sp immediate (imm < 4096)
    void AddSPImm(int imm, bool isAdd) {
        if (tgt86 == 1) {
            if (isAdd) { XAddRsp(imm); } else { XSubRsp(imm); }
            return;
        }
        // imm12 tops out at 4095; the optional lsl #12 multiplies by 4096,
        // it does not widen the field. A frame above 4095 silently spilled
        // bit 12 into the shift bit -- a 6.4KB frame encoded as
        // `#imm12, lsl #12` == 9.5MB and crashed the first call of every
        // method with more than 251 local slots. Chunk large requests:
        // x4096 units first (scaled form), then the plain remainder.
        while (imm > 0xFFF) {
            int units = imm >> 12;
            if (units > 0xFFF) { units = 0xFFF; }
            if (isAdd) { E4(0x91400000 | (units << 10) | (31 << 5) | 31); }
            else { E4(0xD1400000 | (units << 10) | (31 << 5) | 31); }
            imm = imm - (units << 12);
        }
        if (imm > 0) {
            if (isAdd) { E4(0x91000000 | (imm << 10) | (31 << 5) | 31); }
            else { E4(0xD1000000 | (imm << 10) | (31 << 5) | 31); }
        }
    }

    // add immediate between registers (imm < 4096)
    void AddImm(int rd, int rn, int imm) {
        if (tgt86 == 1) {
            if (rn == 31) {
                // v31 is sp, not a spill slot: rd = rsp + imm via lea
                int d = XMapReal(rd);
                if (d < 0) { XopRMem(0x8D, 10, 4, imm); XSetV(rd, 10); }
                else { XopRMem(0x8D, d, 4, imm); }
                return;
            }
            int d = XMapReal(rd);
            if (d >= 0 && rd == rn) {
                if (imm >= -128 && imm <= 127) { X1(XrexW(0, d)); X1(0x83); X1(0xC0 | (d & 7)); X1(imm); }
                else { X1(XrexW(0, d)); X1(0x81); X1(0xC0 | (d & 7)); X4(imm); }
            } else {
                XGetV(rn, 10);
                if (imm >= -128 && imm <= 127) { X3(0x49, 0x83, 0xC2); X1(imm); }
                else { X3(0x49, 0x81, 0xC2); X4(imm); }
                XSetV(rd, 10);
            }
            return;
        }
        // imm12 is unsigned; negative values encode as SUB imm
        if (imm < 0) { E4(0xD1000000 | ((-imm) << 10) | (rn << 5) | rd); }
        else { E4(0x91000000 | (imm << 10) | (rn << 5) | rd); }
    }

    // ---- branches and calls ----
    void EmitB(int label) {
        if (tgt86 == 1) { XB(label); return; }
        E4(0x14000000); fixups.Add(new Fixup(txt.Count - 4, 0, label, 0, null));
    }
    void EmitBcond(int cond, int label) {
        if (tgt86 == 1) { XBcond(cond, label); return; }
        E4(0x54000000 | cond);                       // B.cond: cond in the low byte
        fixups.Add(new Fixup(txt.Count - 4, 2, label, cond, null));
    }
    void EmitCBZ(int reg, int label) {
        if (tgt86 == 1) { XCbz(reg, label, 0); return; }
        E4(0xB4000000 | reg);
        fixups.Add(new Fixup(txt.Count - 4, 1, label, 0, null));
    }
    void EmitCbnz(int reg, int label) {
        if (tgt86 == 1) { XCbz(reg, label, 1); return; }
        E4(0xB5000000 | reg);
        fixups.Add(new Fixup(txt.Count - 4, 1, label, 0, null));
    }
    void EmitTbnz(int reg, int bit, int label) {
        if (tgt86 == 1) {
            // tbnz reg, #bit: test reg, (1<<bit) then jnz rel32. Only the
            // delegate-invoke tagged/bare dispatch reaches this (reg = v0,
            // bit 0); the generic form stages through rax like XCbz.
            // F7 /0 的立即数恒为 32 位——首版 bit-0 快道写 imm8,把后面
            // 的 jnz 操作码吞进立即数,分支凭空消失(invoke 楔死根因 #3)
            XGetV(reg, 0);
            X3(0x48, 0xF7, 0xC0); X4(1L << bit);          // test rax, imm32
            X2(0x0F, 0x85);
            fixups.Add(new Fixup(txt.Count - 2, 1, label, 1, null));   // jnz rel32
            X4(0);
            return;
        }
        // test-bit-and-branch-if-nonzero: imm14 at bits 18..5, bit at 23:19
        E4(0x37000000 | (bit << 19) | reg);
        fixups.Add(new Fixup(txt.Count - 4, 5, label, 0, null));
    }
    void BLInternal(string sym) {
        if (tgt86 == 1) { XCallSeq(sym, 0); return; }
        E4(0x94000000); fixups.Add(new Fixup(txt.Count - 4, 3, 0, 0, sym));
    }
    void BLExtern(string sym) {
        if (tgt86 == 1) { XCallSeq(sym, 1); return; }
        E4(0x94000000); fixups.Add(new Fixup(txt.Count - 4, 4, 0, 0, sym));
    }

    // 64 位寄存器对比较的统一入口:arm64 发 CMP(SUBS xzr, rn, rm),x86
    // 发 cmp r10, r11(v 寄存器经 XGetV 落物理机,31 = xzr 清零)。异步
    // 恢复体/反射分派/定时器堆共 17 处调用点原本只有 arm64 臂,x86_64
    // 车道 fail-closed 拒编(批 46 现形)。
    void CmpRR(int rn, int rm) {
        if (tgt86 == 1) {
            if (rn == 31) { X3(0x4D, 0x31, 0xD2); } else { XGetV(rn, 10); }
            if (rm == 31) { X3(0x4D, 0x31, 0xDB); } else { XGetV(rm, 11); }
            Xop(0x39, 10, 11);
            return;
        }
        E4(0xEB000000 | (rm << 16) | (rn << 5) | 31);
    }

    // arm64 pre-index push / post-index pop 的多态原语(批 46)。v 是容
    // 器虚拟寄存器号(x0..x5=参数、x9/x10=临时、31=xzr 特例);arm64 侧
    // 逐位不变(金档零扰动),x86 侧 XSubRsp(16)+XMemV 落 v 家(16 字节
    // 步长与 arm64 相同,调用期栈对齐不变量两道一致)。异步/反射/绑定
    // 发射器约 90 处原直发 arm64 字,x86 车道 fail-closed 现形。
    void PushV(int v) {
        if (tgt86 == 1) { XSubRsp(16); XMemV(0, v, 31, 0); return; }
        E4(0xF81F0FE0 | v);
    }
    void PopV(int v) {
        if (tgt86 == 1) { XMemV(1, v, 31, 0); XAddRsp(16); return; }
        E4(0xF84107E0 | v);
    }

    // lsr xN, xN, #n(批 46:反射分派/字符串开关的类型 ID 高半提取现形)。
    // arm64 = UBFM xN, xN, #n, #63,与原裸字逐位一致;x86 = shr r10, imm8。
    void LsrImm64(int rd, int n) {
        if (tgt86 == 1) {
            XGetV(rd, 10);
            X2(0x49, 0xC1); X2(0xEA, n & 63);            // shr r10, imm8
            XSetV(rd, 10);
            return;
        }
        E4(0xD3400000 | (n << 16) | (63 << 10) | (rd << 5) | rd);
    }

    // cset x0, <cond>(批 46:整型比较物化现形)。cond 用 arm64 编号
    // (0 eq 1 ne 2 cs 3 cc 8 hi 9 ls 10 ge 11 lt 12 gt 13 le);arm64 侧
    // 按 CSINC x0, xzr, xzr, ~cond 反码惯用法逐位还原原裸字;x86 侧
    // setcc 进 r10b 零扩展回 v0(前导比较须刚由 CmpRR/cmp 落旗标;
    // 浮点比较走专用孪生体,勿用本原语——comisd 只保证 CF/ZF)。
    void CsetCondX0(int cond) {
        if (tgt86 == 1) {
            int cc = cond == 0 ? 0x94 : cond == 1 ? 0x95
                   : cond == 2 ? 0x93 : cond == 3 ? 0x92
                   : cond == 8 ? 0x97 : cond == 9 ? 0x96
                   : cond == 10 ? 0x9D : cond == 11 ? 0x9C
                   : cond == 12 ? 0x9F : 0x9E;           // 13 = le
            X3(0x45, 0x0F, cc); X1(0xD2);                // setcc r10b
            X3(0x45, 0x0F, 0xB6); X1(0xD2);              // movzx r10d, r10b
            XSetV(0, 10);
            return;
        }
        E4(0x9A9F07E0 | ((cond ^ 1) << 12));             // CSINC x0, xzr, xzr, ~cond
    }

    // ---- strings ----
    int InternStr(string s) {
        strs.Add(s);
        return strs.Count - 1;
    }
    void LoadSymRef(string sym, int reg) {
        if (tgt86 == 1) { XLeaSym(sym, reg); return; }
        E4(0x90000000 | reg);                            // adrp reg, sym@PAGE
        int a = txt.Count - 4;
        E4(0x91000000 | (reg << 5) | reg);               // add reg, reg, sym@PAGEOFF
        strRefs.Add(new StrRef(a, txt.Count - 4, sym));
    }
    // dylib DATA symbols (__stdinp etc.) cannot bind through adrp+add: their
    // page offsets are filled at runtime by the dynamic loader, so the address
    // must be loaded indirectly. Instead of GOT-load relocations (Mach-O
    // types 5/6, which trip an assert in older ld-prime), the reference goes
    // through a homemade __nl_symbol_ptr slot: an 8-byte data word carrying
    // an UNSIGNED reloc against the symbol that the linker binds at link
    // time, loaded here with a plain adrp+ldr pair (PAGE21/PAGEOFF12).
    // ElfRefIdx note: ELF/COFF writers treat got=1 as "ldr not add" so the
    // lo12 halves pick the right opcode shape; the slot itself is a plain
    // .data quad there (ABS64 / ADDR64 reloc).
    void LoadSymRefGOT(string sym, int reg) {
        if (IndexOf(nlExts, sym) < 0) {
            nlExts.Add(sym);
            dglbs.Add(new DGlob("nl." + sym, 8, nlLen));
            nlLen = nlLen + 8;
        }
        string slot = DGlobalSym("nl." + sym);
        if (tgt86 == 1) {
            // mov reg, [rip+slot]: the slot quad itself is rip-rel data, so
            // the plain SIGNED pcrel shape serves (the arm64 adrp+ldr pair's
            // got flag only picked the lo12 opcode shape)
            int r = XMapReal(reg);
            int pos;
            if (r >= 0) {
                pos = txt.Count;
                X1(XrexW(r, 0)); X1(0x8B); X1(0x05 | ((r & 7) << 3)); X4(0);
            } else {
                pos = txt.Count;
                X3(0x4C, 0x8B, 0x15); X4(0);             // mov r10, [rip+slot]
                XSetV(reg, 10);
            }
            StrRef xr = new StrRef(pos, pos, slot);
            xr.got = 1;
            strRefs.Add(xr);
            return;
        }
        E4(0x90000000 | reg);                            // adrp reg, slot@PAGE
        int a = txt.Count - 4;
        E4(0xF9400000 | (reg << 5) | reg);               // ldr reg, [reg, slot@PAGEOFF]
        StrRef r2 = new StrRef(a, txt.Count - 4, slot);
        r2.got = 1;                                       // ldr, not add
        strRefs.Add(r2);
    }
    void LoadStr(int si, int reg) {
        // literals are directly-addressed immutable __data blobs (see
        // RtEmitStrpool); hand out the payload pointer at blob+16
        LoadSymRef(DGlobalSym("strd." + si), reg);
        AddImm(reg, reg, 16);
    }

    // one-argument libm double call: the value arrives as its bit pattern
    // in x0, moves to d0, and the result comes back the same way
    void DblLibm1(string f) {
        if (tgt86 == 1) {
            X3(0x66, 0x48, 0x0F); X2(0x6E, 0xC7);   // movq xmm0, rdi (fmov d0, x0)
            BLExtern(f);
            X3(0x66, 0x48, 0x0F); X2(0x7E, 0xC7);   // movq rdi, xmm0 (fmov x0, d0)
            return;
        }
        if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x6E, 0xC7); } else { E4(0x9E670000); }                                  // fmov d0, x0
        BLExtern(f);
        if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x7E, 0xC7); } else { E4(0x9E660000); }                                  // fmov x0, d0
    }

    // ---- fixup resolution (text offsets are final here) ----
    int WordAt(int pos) {
        return (txt[pos + 3] << 24) | (txt[pos + 2] << 16) | (txt[pos + 1] << 8) | txt[pos];
    }
    void SetWordAt(int pos, int w) {
        txt[pos] = ByteAt(w, 0); txt[pos + 1] = ByteAt(w, 1);
        txt[pos + 2] = ByteAt(w, 2); txt[pos + 3] = ByteAt(w, 3);
    }
    int ByteAt(int v, int i) {
        int b = v >> (i * 8);
        b = b - (b / 256) * 256;
        if (b < 0) { b = b + 256; }
        return b;
    }

    void Patch() {
        int i = 0;
        while (i < fixups.Count) {
            Fixup f = fixups[i];
            if (tgt86 == 1) {
                // x86_64: rel32 displacement at a byte position. kinds:
                // 0 = jmp rel32 (disp at pos+1), 1/2 = jcc rel32 (disp at
                // pos+2, after 0F cc), 3 = call rel32 (disp at pos+1),
                // 4 = extern call (linker reloc, skip), 5 = arm64-only
                // (EmitTbnz's arm64 form; x86 now emits kind 1 jnz).
                if (f.kind == 0) {
                    SetWordAt(f.pos + 1, lblPos[f.lbl] - (f.pos + 5));
                } else if (f.kind == 1 || f.kind == 2) {
                    SetWordAt(f.pos + 2, lblPos[f.lbl] - (f.pos + 6));
                } else if (f.kind == 3) {
                    int target = SymPos(f.sym);
                    if (target < 0) {
                        diags.Error("ngen: unresolved internal symbol '" + f.sym + "'", 0, 0);
                    } else {
                        SetWordAt(f.pos + 1, target - (f.pos + 5));
                    }
                }
                i = i + 1;
                continue;
            }
            int word = WordAt(f.pos);
            if (f.kind == 0) {
                // B: opcode occupies the top 6 bits, imm26 the rest
                int imm = (lblPos[f.lbl] - f.pos) / 4;
                word = (ByteAt(word, 3) / 4) * 67108864 + ModLow(imm, 26);
            } else if (f.kind == 1 || f.kind == 2) {
                // CBZ / B.cond: imm19 at bits 23..5; low byte (Rt / cond) kept.
                // The word is negative (top byte >= 0x80), so the low 5 bits
                // must come from ByteAt -- (word - (word/32)*32) breaks on
                // truncating division for negatives.
                int imm = (lblPos[f.lbl] - f.pos) / 4;
                int lo = ByteAt(word, 0);
                lo = lo - (lo / 32) * 32;
                word = (ByteAt(word, 3) << 24) | (ByteAt(word, 2) << 16)
                     | (ModLow(imm, 19) << 5)
                     | lo;
            } else if (f.kind == 5) {
                // TBZ/TBNZ: imm14 at bits 18..5; opcode, bit (23:19) and Rt
                // stay as emitted.
                int imm = (lblPos[f.lbl] - f.pos) / 4;
                word = (ByteAt(word, 3) << 24) | (ByteAt(word, 2) << 16)
                     | (ModLow(imm, 14) << 5)
                     | ByteAt(word, 0);
            } else if (f.kind == 3) {
                // Missing internal symbols must not silently branch to text
                // offset zero. Unlike externs, no linker relocation can fix it.
                int target = SymPos(f.sym);
                if (target < 0) {
                    diags.Error("ngen: unresolved internal symbol '" + f.sym + "'", 0, 0);
                } else {
                    int imm = (target - f.pos) / 4;
                    word = (ByteAt(word, 3) / 4) * 67108864 + ModLow(imm, 26);
                }
            } else {
                // extern BL: imm26 stays zero, resolved by relocation
            }
            SetWordAt(f.pos, word);
            i = i + 1;
        }
    }

    // imm mod 2^n, normalized to [0, 2^n) (two's-complement field value)
    int ModLow(int imm, int bits) {
        int m = imm - (imm / (1 << bits)) * (1 << bits);
        if (m < 0) { m = m + (1 << bits); }
        return m;
    }

    MethIndex symPosIdx;   // name -> syms index; built at first SymPos call
                           // (Patch time, after all symbols are declared)

    int SymPos(string name) {
        if (symPosIdx == null) {
            symPosIdx = new MethIndex();
            int i = 0;
            while (i < syms.Count) { symPosIdx.Add(syms[i].name, i); i = i + 1; }
        }
        List<int> hit = symPosIdx.Get(name);
        return hit != null ? syms[hit[0]].pos : -1;
    }
}
