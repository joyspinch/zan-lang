using System;
using System.Collections.Generic;
namespace Zan;

partial class Ngen {

    // ptr zan_rt_int2str(i64 v) -- str_alloc a 32-byte buffer and
    // sprintf("%lld", v) into it; 32 bytes hold any 64-bit decimal + NUL.
    // The string goes out with the standard header at buf-8 (str_alloc
    // reserves the slot): Length/Substring read it, and a bare malloc
    // buffer would hand them malloc's own size word as the length.
    // Darwin arm64 passes variadic arguments on the stack (at [sp] at the
    // call), not in x2..x7, so v gets a dedicated stack slot.
    void RtEmitInt2Str() {
        syms.Add(new Sym("_zan_rt_int2str", FnPad()));
        if (tgt86 == 1) {
            // SysV: sprintf(rdi=buf, rsi="%lld", rdx=v) -- the third
            // argument rides a register, no Darwin stack vararg slot;
            // al=0 declares no vector arguments. Same 32-byte str_alloc
            // buffer and buf-8 header stamp as the arm64 body; the two
            // 16-byte pushes give [sp]=buf, [sp+16]=v, matching the
            // arm64 reload offsets.
            RtPrologue();
            XPushV0();                             // save v
            LoadImm(0, 32);
            BLInternal("_zan_rt_str_alloc");       // v0 = buf
            XPushV0();                             // save buf
            LdrU(2, 31, 16);                       // rdx = v
            LdrU(0, 31, 0);                        // rdi = buf
            XLeaSym("l_.str." + fmtnIdx, 1);       // rsi = "%lld"
            X2(0x31, 0xC0);                        // xor eax, eax
            BLExtern("_sprintf");
            LdrU(0, 31, 0);                        // rdi = buf (len returns in v0)
            BLExtern("_strlen");
            MovRR(1, 0);                           // rsi = len
            LoadImm(4, 0x5A414E5300000000);
            Xop(0x09, 6, 8);                       // or rsi, r8
            LdrU(5, 31, 0);                        // r9 = buf
            SubImm(5, 5, 8);
            RtStur(1, 5, 0);                       // mov [r9], rsi (== buf-8)
            LdrU(0, 31, 0);                        // rdi = buf
            AddSPImm(32, true);                    // pop buf + v
            RtEpilogue();
            return;
        }
        RtPrologue();
        PushV(0);                        // str x0, [sp, #-16]! (save v)
        LoadImm(0, 32);
        BLInternal("_zan_rt_str_alloc");      // x0 = buf (header slot at buf-8)
        PushV(0);                        // str x0, [sp, #-16]! (save buf)
        LdrU(2, 31, 16);                       // x2 = v (reload)
        if (EnvTargetElf() == 1) {
            LdrU(0, 31, 0);                    // x0 = buf; v rides in x2
        } else {
            AddSPImm(16, false);               // variadic argument slot (Darwin)
            StrU(2, 31, 0);                    // [sp] = v
            LdrU(0, 31, 16);                   // x0 = buf
        }
        LoadSymRef("l_.str." + fmtnIdx, 1);    // x1 = "%lld"
        BLExtern("_sprintf");
        if (EnvTargetElf() == 0) {
            AddSPImm(16, true);                // drop the vararg slot
        }
        // stamp the Zan string header at buf-8: magic | strlen(buf).
        // strlen0/Substring/Length all read that header -- a bare malloc
        // buffer makes them read malloc's own size word as the length
        LdrU(0, 31, 0);                        // x0 = buf
        BLExtern("_strlen");                  // x0 = len
        LoadImm(4, 0x5A414E5300000000);
        E4(0xAA040001);                        // orr x1, x0, x4
        LdrU(5, 31, 0);                        // x5 = buf
        SubImm(5, 5, 8);
        StrU(1, 5, 0);                         // str x1, [buf-8]
        LdrU(0, 31, 0);                        // x0 = buf
        AddSPImm(32, true);                    // pop buf + v
        RtEpilogue();
    }

    // zan_rt_print_double(double v) -- gen0 embeds this shim in its IR (the
    // C objects only carry the underlying zan_rt_dbl_str writer), so the
    // native backend mirrors it: 40-byte stack buffer, %g render, println.
    // arm64: v rides d0. x86: v rides rdx as bits (the dbl_str ABI).
    void RtEmitPrintDouble() {
        syms.Add(new Sym("_zan_rt_print_double", FnPad()));
        RtPrologue();
        AddSPImm(48, false);                   // 40-byte buffer, 16-aligned
        if (tgt86 == 1) {
            MovRR(2, 0);                       // rdx = v bits
            GuardSp(0, 0);                     // rdi = buf
            LoadImm(1, 40);                    // rsi = cap
            BLInternal("_zan_rt_dbl_str");
            GuardSp(0, 0);                     // rdi = buf
            BLInternal("_zan_rt_println");     // printf("%s\n", buf)
        } else {
            E4(0x910003E0);                    // mov x0, sp
            LoadImm(1, 40);
            BLInternal("_zan_rt_dbl_str");     // v flows through in d0
            E4(0x910003E0);                    // x0 = buf
            BLInternal("_zan_rt_println");     // printf("%s\n", buf)
        }
        AddSPImm(48, true);
        RtEpilogue();
    }

    // ptr zan_rt_uint2str(i64 v) -- as int2str but "%llu", matching
    // gen0's ulong rendering (the high bit prints unsigned)
    void RtEmitUint2Str() {
        syms.Add(new Sym("_zan_rt_uint2str", FnPad()));
        if (tgt86 == 1) {
            // as int2str but "%llu", matching gen0's ulong rendering
            RtPrologue();
            XPushV0();                             // save v
            LoadImm(0, 32);
            BLInternal("_zan_rt_str_alloc");       // v0 = buf
            XPushV0();                             // save buf
            LdrU(2, 31, 16);                       // rdx = v
            LdrU(0, 31, 0);                        // rdi = buf
            XLeaSym("l_.str." + fmtuIdx, 1);       // rsi = "%llu"
            X2(0x31, 0xC0);                        // xor eax, eax
            BLExtern("_sprintf");
            LdrU(0, 31, 0);                        // rdi = buf (len returns in v0)
            BLExtern("_strlen");
            MovRR(1, 0);                           // rsi = len
            LoadImm(4, 0x5A414E5300000000);
            Xop(0x09, 6, 8);                       // or rsi, r8
            LdrU(5, 31, 0);                        // r9 = buf
            SubImm(5, 5, 8);
            RtStur(1, 5, 0);                       // mov [r9], rsi (== buf-8)
            LdrU(0, 31, 0);                        // rdi = buf
            AddSPImm(32, true);                    // pop buf + v
            RtEpilogue();
            return;
        }
        RtPrologue();
        PushV(0);                        // str x0, [sp, #-16]! (save v)
        LoadImm(0, 32);
        BLInternal("_zan_rt_str_alloc");      // x0 = buf (header slot at buf-8)
        PushV(0);                        // str x0, [sp, #-16]! (save buf)
        LdrU(2, 31, 16);                       // x2 = v (reload)
        if (EnvTargetElf() == 1) {
            LdrU(0, 31, 0);                    // x0 = buf; v rides in x2
        } else {
            AddSPImm(16, false);               // variadic argument slot (Darwin)
            StrU(2, 31, 0);                    // [sp] = v
            LdrU(0, 31, 16);                   // x0 = buf
        }
        LoadSymRef("l_.str." + fmtuIdx, 1);    // x1 = "%llu"
        BLExtern("_sprintf");
        if (EnvTargetElf() == 0) {
            AddSPImm(16, true);                // drop the vararg slot
        }
        // stamp the Zan string header at buf-8, like int2str
        LdrU(0, 31, 0);                        // x0 = buf
        BLExtern("_strlen");                  // x0 = len
        LoadImm(4, 0x5A414E5300000000);
        E4(0xAA040001);                        // orr x1, x0, x4
        LdrU(5, 31, 0);                        // x5 = buf
        SubImm(5, 5, 8);
        StrU(1, 5, 0);                         // str x1, [buf-8]
        LdrU(0, 31, 0);                        // x0 = buf
        AddSPImm(32, true);                    // pop buf + v
        RtEpilogue();
    }

    // zan_rt_print_uint(i64 v) -- gen0 embeds this shim in its IR
    // (printf("%llu\n", v); Darwin arm64 takes the variadic on the stack)
    void RtEmitPrintUint() {
        syms.Add(new Sym("_zan_rt_print_uint", FnPad()));
        if (tgt86 == 1) {
            // Same SysV shape as print_int: v rides rdi, moved to rsi
            // before the format lea claims rdi. AL=0: no vector args.
            RtPrologue();
            XMov(6, 7);            // mov rsi, rdi (v)
            XLeaSym("l_.str." + fmtuNIdx, 0);
            X2(0x31, 0xC0);        // xor eax, eax
            BLExtern("_printf");
            RtEpilogue();
            return;
        }
        RtPrologue();
        if (EnvTargetElf() == 1) {
            MovRR(9, 0);                       // x9 = v
        } else {
            AddSPImm(16, false);               // variadic argument slot (Darwin)
            StrU(0, 31, 0);                    // [sp] = v
        }
        LoadSymRef("l_.str." + fmtuNIdx, 0);   // x0 = "%llu\n"
        if (EnvTargetElf() == 1) {
            MovRR(1, 9);                       // x1 = v
        }
        BLExtern("_printf");
        if (EnvTargetElf() == 0) {
            AddSPImm(16, true);
        }
        RtEpilogue();
    }

    // ptr zan_rt_fmt(i64 vbits, ptr cfmt): snprintf-render a value under a
    // printf pattern the compiler mapped from an interpolation format
    // specifier ({v:D4} -> "%08lld"), returned as a heap string. The value
    // arrives as its i64 bit pattern (our expression model carries doubles
    // that way) and is the trailing variadic, so it travels on the stack per
    // AAPCS64 -- unnamed FP arguments are stack slots, not d registers.
    // Frame (48 below the saved pair): cfmt@-16, buf@-24, vbits@-32, len@-40.
    void RtEmitFmt() {
        syms.Add(new Sym("_zan_rt_fmt", FnPad()));
        RtPrologue();
        AddSPImm(48, false);
        RtStur(0, 29, -32);                    // vbits
        RtStur(1, 29, -16);                    // cfmt
        // probe: snprintf(NULL, 0, cfmt, v)
        LoadImm(0, 0);
        LoadImm(1, 0);
        RtLdur(2, 29, -16);
        RtLdur(3, 29, -32);
        if (EnvTargetElf() == 0) {
            StrU(3, 31, 0);                    // [sp] = v (Darwin variadic slot)
        }
        BLExtern("_snprintf");
        RtStur(0, 29, -40);                    // len
        AddImm(0, 0, 1);                       // + NUL
        BLInternal("_zan_rt_str_alloc");       // x0 = buf
        RtStur(0, 29, -24);
        // render: snprintf(buf, len+1, cfmt, v)
        RtLdur(0, 29, -24);
        RtLdur(1, 29, -40);
        AddImm(1, 1, 1);
        RtLdur(2, 29, -16);
        RtLdur(3, 29, -32);
        if (EnvTargetElf() == 0) {
            StrU(3, 31, 0);                    // [sp] = v (Darwin variadic slot)
        }
        BLExtern("_snprintf");
        // stamp the header at buf-8: 0x5A414E53_00000000 | strlen(buf)
        RtLdur(0, 29, -24);
        BLExtern("_strlen");
        LoadImm(4, 0x5A414E5300000000);
        E4(0xAA040001);                        // orr x1, x0, x4
        RtLdur(5, 29, -24);
        SubImm(5, 5, 8);
        RtStur(1, 5, 0);                       // str x1, [x5] (== buf-8)
        RtLdur(0, 29, -24);
        AddSPImm(48, true);
        RtEpilogue();
    }


    // ptr zan_rt_dbl2str(i64 bits) -- the value arrives as the i64 bit
    // pattern our expression model carries (x0 on arm64, rdi on x86);
    // renders with the C runtime's %g writer into a 40-byte stack buffer
    // and returns a heap string (a copy through strcat2's allocator, so
    // it outlives the buffer)
    void RtEmitDbl2Str() {
        syms.Add(new Sym("_zan_rt_dbl2str", FnPad()));
        RtPrologue();
        if (tgt86 == 1) {
            AddSPImm(48, false);               // 40-byte buffer, 16-aligned
            MovRR(2, 0);                       // rdx = v bits (dbl_str ABI)
            GuardSp(0, 0);                     // rdi = buf
            LoadImm(1, 40);                    // rsi = cap
            BLInternal("_zan_rt_dbl_str");
            GuardSp(9, 0);                     // v9 = buf: unlike the arm64
                                               // path, v0 no longer holds buf
                                               // here (the call lands its void
                                               // return in v0 via mov rdi,rax)
            LoadSymRef("l_.str." + emptyIdx, 0);   // rdi = ""
            MovRR(1, 9);                       // rsi = buf
            BLInternal("_zan_rt_strcat2");
        } else {
            E4(0x9E670000);                        // fmov d0, x0
            AddSPImm(48, false);                   // 40-byte buffer, 16-aligned
            E4(0x910003E0);                        // mov x0, sp
            LoadImm(1, 40);
            BLInternal("_zan_rt_dbl_str");
            E4(0x910003E0);                        // x0 = buf
            MovRR(9, 0);                           // x9 = buf
            LoadSymRef("l_.str." + emptyIdx, 0);   // x0 = ""
            MovRR(1, 9);                           // x1 = buf
            BLInternal("_zan_rt_strcat2");
        }
        AddSPImm(48, true);
        RtEpilogue();
    }

    // ptr zan_rt_chrstr(i64 cp) -- render one codepoint as a heap string.
    // Pure UTF-8 arithmetic like gen0's emit_char_to_cstr: snprintf("%lc")
    // is locale-dependent (the C locale drops anything above 0xFF), so the
    // lead/continuum bytes are built and packed into one little-endian i64,
    // covering all four encoded lengths with a single memcpy. Like the
    // oracle, the length stays implicit: char 0 encodes as one NUL byte,
    // whose string length is 0, so the stamp reads zero for it.
    // Frame: [0]=cp [8]=packed [16]=len [24]=dst.
    void RtEmitChrstr() {
        syms.Add(new Sym("_zan_rt_chrstr", FnPad()));
        RtPrologue();
        AddSPImm(48, false);
        StrU(0, 31, 0);                        // [sp] = cp
        LoadImm(9, 0x1FFFFF);
        AndRR(9, 0, 9);                        // and x9, x0, x9 (cp = cp & mask)
        StrU(9, 31, 0);
        // len = cp<0x80 ? 1 : cp<0x800 ? 2 : cp<0x10000 ? 3 : 4
        LdrU(9, 31, 0);
        LoadImm(10, 0x80);
        StringCmp(9, 10);                      // cmp x9, x10
        int l1 = NL(); EmitBcond(3, l1);
        LoadImm(10, 0x800);
        StringCmp(9, 10);
        int l2 = NL(); EmitBcond(3, l2);
        LoadImm(10, 0x10000);
        StringCmp(9, 10);
        int l3 = NL(); EmitBcond(3, l3);
        LoadImm(10, 4);
        int lend = NL(); EmitB(lend);
        Mark(l3); LoadImm(10, 3); EmitB(lend);
        Mark(l2); LoadImm(10, 2); EmitB(lend);
        Mark(l1); LoadImm(10, 1);
        Mark(lend);
        StrU(10, 31, 16);                      // [sp+16] = len
        // packed select: byte(n) = payload | tag, packed at 8*n bits
        LdrU(9, 31, 0);
        LoadImm(10, 0x80);
        StringCmp(9, 10);
        int p1 = NL(); EmitBcond(3, p1);
        LoadImm(10, 0x800);
        StringCmp(9, 10);
        int p2 = NL(); EmitBcond(3, p2);
        LoadImm(10, 0x10000);
        StringCmp(9, 10);
        int p3 = NL(); EmitBcond(3, p3);
        // 4-byte form: 0xF0|(cp>>18) | b1<<8 | b2<<16 | b3<<24
        LoadImm(11, 0x3F);
        AndRR(12, 9, 11);                      // and x12, x9, x11
        LoadImm(13, 0x80);
        OrrRR(12, 12, 13);                     // orr x12, x12, x13
        LoadImm(13, 24);
        LslvVV(12, 12, 13);                    // lslv x12, x12, x13
        LoadImm(14, 6);
        LsrvVV(15, 9, 14);                     // lsrv x15, x9, x14
        LoadImm(13, 0x80);
        OrrRR(15, 15, 13);                     // orr x15, x15, x13
        LoadImm(13, 16);
        LslvVV(15, 15, 13);                    // lslv x15, x15, x13
        OrrRR(12, 12, 15);                     // orr x12, x12, x15
        LoadImm(14, 12);
        LsrvVV(15, 9, 14);                     // lsrv x15, x9, x14
        AndRR(15, 15, 11);                     // and x15, x15, x11
        LoadImm(13, 0x80);
        OrrRR(15, 15, 13);                     // orr x15, x15, x13
        LoadImm(13, 8);
        LslvVV(15, 15, 13);                    // lslv x15, x15, x13
        OrrRR(12, 12, 15);                     // orr x12, x12, x15
        LoadImm(14, 18);
        LsrvVV(15, 9, 14);                     // lsrv x15, x9, x14
        LoadImm(13, 0xF0);
        OrrRR(15, 15, 13);                     // orr x15, x15, x13
        OrrRR(10, 15, 12);                     // orr x10, x15, x12
        int pd = NL(); EmitB(pd);
        Mark(p3);
        // 3-byte form: 0xE0|(cp>>12) | b1<<8 | b2<<16
        LoadImm(11, 0x3F);
        AndRR(12, 9, 11);                      // and x12, x9, x11
        LoadImm(13, 0x80);
        OrrRR(12, 12, 13);                     // orr x12, x12, x13
        LoadImm(13, 16);
        LslvVV(12, 12, 13);                    // lslv x12, x12, x13
        LoadImm(14, 6);
        LsrvVV(15, 9, 14);                     // lsrv x15, x9, x14
        AndRR(15, 15, 11);                     // and x15, x15, x11
        LoadImm(13, 0x80);
        OrrRR(15, 15, 13);                     // orr x15, x15, x13
        LoadImm(13, 8);
        LslvVV(15, 15, 13);                    // lslv x15, x15, x13
        OrrRR(12, 12, 15);                     // orr x12, x12, x15
        LoadImm(14, 12);
        LsrvVV(15, 9, 14);                     // lsrv x15, x9, x14
        LoadImm(13, 0xE0);
        OrrRR(15, 15, 13);                     // orr x15, x15, x13
        OrrRR(10, 15, 12);                     // orr x10, x15, x12
        EmitB(pd);
        Mark(p2);
        // 2-byte form: 0xC0|(cp>>6) | b1<<8
        LoadImm(11, 0x3F);
        AndRR(12, 9, 11);                      // and x12, x9, x11
        LoadImm(13, 0x80);
        OrrRR(12, 12, 13);                     // orr x12, x12, x13
        LoadImm(13, 8);
        LslvVV(12, 12, 13);                    // lslv x12, x12, x13
        LoadImm(14, 6);
        LsrvVV(15, 9, 14);                     // lsrv x15, x9, x14
        LoadImm(13, 0xC0);
        OrrRR(15, 15, 13);                     // orr x15, x15, x13
        OrrRR(10, 15, 12);                     // orr x10, x15, x12
        EmitB(pd);
        Mark(p1);
        MovRR(10, 9);                          // 1-byte form: packed = cp
        Mark(pd);
        StrU(10, 31, 8);                       // [sp+8] = packed
        // char 0 keeps len 0 (single NUL byte, empty string)
        LdrU(9, 31, 0);
        int nz = NL(); CbnzReg(9, nz);
        LoadImm(10, 0);
        StrU(10, 31, 16);
        Mark(nz);
        // dst = str_alloc(len + 1); memcpy(dst, &packed, len); dst[len] = 0
        LdrU(10, 31, 16);
        AddImm(0, 10, 1);
        BLInternal("_zan_rt_str_alloc");
        StrU(0, 31, 24);
        LdrU(0, 31, 24);
        AddImm(1, 31, 8);                      // x1 = &packed
        LdrU(2, 31, 16);
        BLExtern("_memcpy");
        LdrU(0, 31, 24);
        LdrU(9, 31, 16);
        AddRR(0, 0, 9);
        Strb0(0);
        // stamp the real length header: [dst-8] = MAGIC | len
        LdrU(0, 31, 24);
        SubImm(9, 0, 8);                       // sub x9, x0, #8
        LoadImm(10, 0x5A414E5300000000);
        LdrU(11, 31, 16);
        OrrRR(10, 10, 11);                     // orr x10, x10, x11
        StrU(10, 9, 0);
        LdrU(0, 31, 24);
        AddSPImm(48, true);
        RtEpilogue();
    }

    // ptr zan_rt_substr2(ptr s, i64 start) -- caller checked start <= len
    // (gen0 folds an out-of-range start to 0 at the call site). Builds the
    // substring with str_alloc/memcpy and stamps the real length header.
    void RtEmitSubstr2() {
        syms.Add(new Sym("_zan_rt_substr2", FnPad()));
        RtPrologue();
        XPushV0();                             // push s
        XPushV1();                             // push start
        LdrU(1, 31, 16);                       // x1 = s
        SubImm(2, 1, 8);                       // sub x2, x1, #8
        LdrU(2, 2, 0);                         // ldr x2, [x2]
        Uxtw32(2, 2);                          // ubfm x2, x2, #0, #31 (len)
        LdrU(3, 31, 0);                        // x3 = start
        StringSub(4, 2, 3);                    // sub x4, x2, x3 (subl)
        StringCmp(4, 31);                      // cmp x4, xzr
        EmitBcond(10, NL());
        int ok = lblPos.Count - 1;
        LoadImm(4, 0);
        Mark(ok);
        AddImm(0, 4, 1);                       // add x0, x4, #1 (size)
        XPushR(4);                             // push subl
        BLInternal("_zan_rt_str_alloc");       // x0 = dst
        XPushV0();                             // push dst
        LdrU(0, 31, 0);                        // dst
        LdrU(1, 31, 48);                       // s
        LdrU(2, 31, 32);                       // start
        AddRR(1, 1, 2);                        // add x1, x1, x2 (s + start)
        LdrU(2, 31, 16);                       // subl
        BLExtern("_memcpy");
        LdrU(0, 31, 0);                        // dst
        LdrU(1, 31, 16);                       // subl
        AddRR(0, 0, 1);                        // add x0, x0, x1
        Strb0(0);                              // *end = 0
        LdrU(0, 31, 0);                        // dst
        SubImm(9, 0, 8);                       // sub x9, x0, #8
        LoadImm(1, 0x5A414E5300000000);
        LdrU(2, 31, 16);                       // subl
        OrrRR(0, 1, 2);                        // orr x0, x1, x2 (hdr | len)
        StrU(0, 9, 0);
        LdrU(0, 31, 0);                        // return dst
        AddSPImm(64, true);                    // pop dst/subl/start/s
        RtEpilogue();
    }

    // ptr zan_rt_substr3(s, start, len) -- two-argument Substring. gen0's
    // safe-window clamp: any out-of-range window (negative start/len,
    // start past the end, or start+len crossing the NUL) answers the empty
    // string, exactly like the IR backend's select pair.
    // Frame slots: [0]=len [16]=start [32]=s [48]=dst.
    void RtEmitSubstr3() {
        syms.Add(new Sym("_zan_rt_substr3", FnPad()));
        RtPrologue();
        XPushR(0);                             // push s
        XPushR(1);                             // push start
        XPushR(2);                             // push len
        LdrU(1, 31, 32);                       // x1 = s
        SubImm(2, 1, 8);                       // sub x2, x1, #8
        LdrU(2, 2, 0);                         // ldr x2, [x2]
        Uxtw32(2, 2);                          // ubfm x2, x2, #0, #31 (slen)
        LdrU(3, 31, 16);                       // x3 = start
        LdrU(4, 31, 0);                        // x4 = len
        int c1 = NL();
        StringCmp(3, 31);                      // cmp x3, xzr
        EmitBcond(10, c1);                     // b.ge -- start is not negative
        int badL = NL();
        EmitB(badL);
        Mark(c1);
        int c2 = NL();
        StringCmp(4, 31);                      // cmp x4, xzr
        EmitBcond(10, c2);                     // b.ge -- len is not negative
        EmitB(badL);
        Mark(c2);
        int c3 = NL();
        StringCmp(3, 2);                       // cmp x3, x2
        EmitBcond(13, c3);                     // b.le -- start within the string
        EmitB(badL);
        Mark(c3);
        StringSub(5, 2, 3);                    // sub x5, x2, x3 (remaining)
        int c4 = NL();
        StringCmp(4, 5);                       // cmp x4, x5
        EmitBcond(13, c4);                     // b.le -- window fits
        EmitB(badL);
        Mark(c4);
        int okL = NL();
        EmitB(okL);
        Mark(badL);
        LoadImm(3, 0);                         // bad window: start = len = 0
        LoadImm(4, 0);
        Mark(okL);
        StrU(4, 31, 0);                        // [sp] = clamped len
        StrU(3, 31, 16);                       // [sp+16] = clamped start
        LdrU(0, 31, 0);
        AddImm(0, 0, 1);                       // add x0, x0, #1 (size)
        BLInternal("_zan_rt_str_alloc");       // x0 = dst
        XPushR(0);                             // push dst
        LdrU(0, 31, 0);                        // dst
        LdrU(1, 31, 48);                       // s
        LdrU(2, 31, 32);                       // start
        AddRR(1, 1, 2);                        // add x1, x1, x2 (s + start)
        LdrU(2, 31, 16);                       // len
        BLExtern("_memcpy");
        LdrU(0, 31, 0);                        // dst
        LdrU(1, 31, 16);                       // len
        AddRR(0, 0, 1);                        // add x0, x0, x1
        Strb0(0);                              // *end = 0
        LdrU(0, 31, 0);                        // dst
        SubImm(9, 0, 8);                       // sub x9, x0, #8
        LoadImm(1, 0x5A414E5300000000);
        LdrU(2, 31, 16);                       // len
        OrrRR(0, 1, 2);                        // orr x0, x1, x2 (hdr | len)
        StrU(0, 9, 0);
        LdrU(0, 31, 0);                        // return dst
        AddSPImm(64, true);                    // pop dst/len/start/s
        RtEpilogue();
    }

    // ptr zan_rt_substr_raw(s, start, len) -- two-argument Substring on a
    // receiver WITHOUT a trusted length header (raw FFI buffers typed as
    // `string`, e.g. the stdlib's struct dirent* sliced byte by byte). The
    // C host skips the window check for those receivers
    // (expr_has_reliable_string_bounds), so slice raw; a null receiver or a
    // negative start/len answers the empty string. Frame slots:
    // [0]=len [16]=start [32]=s [48]=dst.
    void RtEmitSubstrRaw() {
        syms.Add(new Sym("_zan_rt_substr_raw", FnPad()));
        RtPrologue();
        XPushR(0);                             // push s
        XPushR(1);                             // push start
        XPushR(2);                             // push len
        int snull = NL();
        LdrU(2, 31, 32);                       // x2 = s
        CbzReg(2, snull);                      // s == 0 -> empty
        int c1 = NL();
        LdrU(3, 31, 16);                       // x3 = start
        StringCmp(3, 31);                      // cmp x3, xzr
        EmitBcond(10, c1);                     // b.ge -- start is not negative
        EmitB(snull);
        Mark(c1);
        int c2 = NL();
        LdrU(4, 31, 0);                        // x4 = len
        StringCmp(4, 31);                      // cmp x4, xzr
        EmitBcond(10, c2);                     // b.ge -- len is not negative
        EmitB(snull);
        Mark(c2);
        int okL = NL();
        EmitB(okL);
        Mark(snull);
        LoadImm(3, 0);                         // empty: start = len = 0
        LoadImm(4, 0);
        Mark(okL);
        StrU(4, 31, 0);                        // [sp] = len
        StrU(3, 31, 16);                       // [sp+16] = start
        LdrU(0, 31, 0);
        AddImm(0, 0, 1);                       // add x0, x0, #1 (size)
        BLInternal("_zan_rt_str_alloc");       // x0 = dst
        XPushR(0);                             // push dst
        LdrU(0, 31, 0);                        // dst
        LdrU(1, 31, 48);                       // s
        LdrU(2, 31, 32);                       // start
        AddRR(1, 1, 2);                        // add x1, x1, x2 (s + start)
        LdrU(2, 31, 16);                       // len
        BLExtern("_memcpy");
        LdrU(0, 31, 0);                        // dst
        LdrU(1, 31, 16);                       // len
        AddRR(0, 0, 1);                        // add x0, x0, x1
        Strb0(0);                              // *end = 0
        LdrU(0, 31, 0);                        // dst
        SubImm(9, 0, 8);                       // sub x9, x0, #8
        LoadImm(1, 0x5A414E5300000000);
        LdrU(2, 31, 16);                       // len
        OrrRR(0, 1, 2);                        // orr x0, x1, x2 (hdr | len)
        StrU(0, 9, 0);
        LdrU(0, 31, 0);                        // return dst
        AddSPImm(64, true);                    // pop dst/len/start/s
        RtEpilogue();
    }

    // ptr zan_rt_strjoin(sep, list) -- string.Join(sep, List<string>).
    // Two passes exactly like gen0's __zan_str_join: one strlen pass for
    // the total (sep counted n-1 times, only when n > 0), then str_alloc
    // of align32(total + 1) (min 32) and a copy pass with the sep between
    // elements. Null elements count as "". The length header is stamped
    // at buf-8 like every other heap-string producer.
    // Frame slots: [0]=total [8]=i [16]=list [24]=sep [32]=seplen
    // [40]=pos [48]=buf [56]=elem [64]=sl.
    void RtEmitStrjoin() {
        syms.Add(new Sym("_zan_rt_strjoin", FnPad()));
        RtPrologue();
        AddSPImm(80, false);
        int retNull = NL(); int sepFix = NL(); int retDone = NL();
        StrU(1, 31, 16);                       // [sp+16] = list (x1)
        StrU(0, 31, 24);                       // [sp+24] = sep (x0)
        if (tgt86 == 1) {
            // host join 面的文档契约(null sep/list 都按 "" 处理)在 x86
            // 车道由本面对齐:zan 体只在元素级设防
            sepFix = NL();
            CbnzReg(0, sepFix);                    // sep != 0 -> keep it;
                                                   // fall through == null only
            LoadStr(emptyIdx, 0);
            StrU(0, 31, 24);
            Mark(sepFix);
            retNull = NL();
            LdrU(1, 31, 16);
            CbzReg(1, retNull);
        }
        LdrU(0, 31, 24);
        BLExtern("_strlen");                   // x0 = seplen
        StrU(0, 31, 32);
        // total = n > 0 ? seplen * (n - 1) : 0
        LoadImm(4, 0);                         // movz x4, #0
        LdrU(2, 31, 16);
        LdrU(2, 2, 0);                         // x2 = n
        int sepskip = NL();
        CbzReg(2, sepskip);
        LdrU(3, 31, 32);
        SubImm(2, 2, 1);                       // sub x2, x2, #1
        MulRR(4, 3, 2);                        // mul x4, x3, x2
        Mark(sepskip);
        StrU(4, 31, 0);                        // [sp] = total
        LoadImm(0, 0);                         // movz x0, #0
        StrU(0, 31, 8);                        // i = 0
        // pass 1: total += strlen(elem or "")
        int l1 = NL();
        int d1 = NL();
        int isn1 = NL();
        int isa1 = NL();
        Mark(l1);
        LdrU(0, 31, 8);                        // i
        LdrU(2, 31, 16);
        LdrU(2, 2, 0);                         // n
        if (tgt86 == 1) { Xop(0x39, 7, 2); } else { E4(0xEB02001F); }   // cmp x0, x2
        EmitBcond(10, d1);                     // b.ge d1
        LdrU(3, 31, 16);
        LdrU(3, 3, 16);                        // x3 = data
        EmitArrElemLoad(8, "long", 3, 0, 0);   // ldr x0, [x3, x0, lsl #3]
        CbzReg(0, isn1);
        BLExtern("_strlen");                   // x0 = sl
        EmitB(isa1);
        Mark(isn1);
        LoadImm(0, 0);                         // movz x0, #0
        Mark(isa1);
        LdrU(1, 31, 0);
        AddRR(1, 1, 0);
        StrU(1, 31, 0);                        // total += sl
        LdrU(0, 31, 8);
        AddImm(0, 0, 1);
        StrU(0, 31, 8);                        // i++
        EmitB(l1);
        Mark(d1);
        // buf = str_alloc(max(align32(total + 1), 32))
        LdrU(0, 31, 0);
        AddImm(0, 0, 1);
        AddImm(0, 0, 31);
        if (tgt86 == 1) { X4(0xE0E78348); } else { E4(0x927BE800); }   // and x0, x0, #-32
        LoadImm(9, 32);
        if (tgt86 == 1) { Xop(0x39, 7, 0); } else { E4(0xEB09001F); }   // cmp x0, x9
        int ok32 = NL();
        EmitBcond(2, ok32);                    // b.hs ok32
        LoadImm(0, 32);
        Mark(ok32);
        BLInternal("_zan_rt_str_alloc");
        StrU(0, 31, 48);                       // [sp+48] = buf
        LoadImm(0, 0);                         // movz x0, #0
        StrU(0, 31, 40);                       // pos = 0
        StrU(0, 31, 8);                        // i = 0
        // pass 2: copy element, sep when i + 1 < n, NUL at the end
        int l2 = NL();
        int d2 = NL();
        int nosep = NL();
        int isn2 = NL();
        int isa2 = NL();
        Mark(l2);
        LdrU(0, 31, 8);                        // i
        LdrU(2, 31, 16);
        LdrU(2, 2, 0);                         // n
        if (tgt86 == 1) { Xop(0x39, 7, 2); } else { E4(0xEB02001F); }   // cmp x0, x2
        EmitBcond(10, d2);                     // b.ge d2
        LdrU(3, 31, 16);
        LdrU(3, 3, 16);                        // x3 = data
        EmitArrElemLoad(8, "long", 3, 0, 3);   // ldr x3, [x3, x0, lsl #3]
        StrU(3, 31, 56);                       // [sp+56] = elem
        CbzReg(3, isn2);
        LdrU(0, 31, 56);
        BLExtern("_strlen");
        StrU(0, 31, 64);                       // [sp+64] = sl
        EmitB(isa2);
        Mark(isn2);
        LoadImm(0, 0);                         // movz x0, #0
        StrU(0, 31, 64);
        Mark(isa2);
        LdrU(0, 31, 48);                       // buf
        LdrU(9, 31, 40);                       // pos
        AddRR(0, 0, 9);                        // add x0, x0, x9 (dst)
        LdrU(1, 31, 56);                       // elem
        LdrU(2, 31, 64);                       // sl
        BLExtern("_memcpy");
        LdrU(1, 31, 64);
        LdrU(2, 31, 40);
        AddRR(2, 2, 1);
        StrU(2, 31, 40);                       // pos += sl
        LdrU(0, 31, 8);                        // i
        AddImm(0, 0, 1);                       // i + 1
        LdrU(2, 31, 16);
        LdrU(2, 2, 0);                         // n
        if (tgt86 == 1) { Xop(0x39, 7, 2); } else { E4(0xEB02001F); }   // cmp i+1, n
        EmitBcond(10, nosep);                  // b.ge nosep
        LdrU(0, 31, 48);                       // buf
        LdrU(9, 31, 40);                       // pos
        AddRR(0, 0, 9);                        // add x0, x0, x9 (dst)
        LdrU(1, 31, 24);                       // sep
        LdrU(2, 31, 32);                       // seplen
        BLExtern("_memcpy");
        LdrU(1, 31, 32);
        LdrU(2, 31, 40);
        AddRR(2, 2, 1);
        StrU(2, 31, 40);                       // pos += seplen
        Mark(nosep);
        LdrU(0, 31, 8);
        AddImm(0, 0, 1);
        StrU(0, 31, 8);                        // i++
        EmitB(l2);
        Mark(d2);
        LdrU(0, 31, 48);                       // buf
        LdrU(9, 31, 40);                       // pos
        AddRR(0, 0, 9);                        // add x0, x0, x9
        Strb0(0);                              // buf[pos] = NUL
        // stamp the Zan string header at buf-8: magic | pos. Join results
        // flow into the same Length/Substring readers as any other string
        LdrU(1, 31, 40);                       // x1 = pos (the copy length)
        LoadImm(4, 0x5A414E5300000000);
        OrrRR(1, 1, 4);                        // orr x1, x1, x4
        LdrU(5, 31, 48);                       // x5 = buf
        SubImm(5, 5, 8);
        StrU(1, 5, 0);                         // str x1, [buf-8]
        LdrU(0, 31, 48);                       // return buf
        if (tgt86 == 1) { EmitB(retDone); Mark(retNull); LoadStr(emptyIdx, 0); Mark(retDone); }
        AddSPImm(80, true);
        RtEpilogue();
    }

    // every interned literal becomes a directly-addressed immutable blob in
    // __data: [off+0] rc = -1 (immortal sentinel, mirroring the reflect
    // blobs — nothing in this lane decrements, but -1 documents
    // non-ownership), [off+8] = 0x5A414E53<<32|len, [off+16..] text + NUL,
    // padded to 8. LoadStr hands out blob+16, so Length/index probe the same
    // header layout as any heap string. This replaced the old
    // _zan_rt_strpool_init startup stamping: those l_.g.strp.N slots were
    // only filled when the object holding Main ran its startup shim, so a
    // separately compiled library object's literals read as null.
    void RtEmitStrpool() {
        syms.Add(new Sym("_zan_rt_strpool_init", FnPad()));
        RtPrologue();
        RtEpilogue();
        int i = 0;
        while (i < strs.Count) { EmitStrdBlob(i); i = i + 1; }
    }

    // one literal's initialized __data blob (8-aligned start and size)
    void EmitStrdBlob(int si) {
        string s = strs[si];
        int len = s.Length;
        int pad = dataLen - (dataLen / 8) * 8;
        if (pad != 0) { dataLen = dataLen + 8 - pad; }
        int sz = 16 + len + 1;
        int rem = sz - (sz / 8) * 8;
        if (rem != 0) { sz = sz + 8 - rem; }
        DGlob g = new DGlob("strd." + si, sz, dataLen);
        g.bytes = new List<int>();
        Put32(g.bytes, -1);            // rc: immortal sentinel (64-bit field)
        Put32(g.bytes, -1);
        Put32(g.bytes, len);           // header low word = length
        Put32(g.bytes, 0x5A414E53);    // header high word = SNAZ magic
        int k = 0;
        while (k < len) { g.bytes.Add(ByteAt((int)s[k], 0)); k = k + 1; }
        g.bytes.Add(0);
        while (g.bytes.Count < sz) { g.bytes.Add(0); }
        dglbs.Add(g);
        dataLen = dataLen + sz;
    }

    // __data payload: zeroed except DGlobs carrying initialized bytes (the
    // literal blobs). "nl." slots live past dataLen and never carry bytes.
    void EmitDataPayload(List<int> img) {
        List<int> payload = new List<int>();
        int i = 0;
        while (i < dataLen) { payload.Add(0); i = i + 1; }
        i = 0;
        while (i < dglbs.Count) {
            if (dglbs[i].bytes != null && IsNlSlot(dglbs[i].name) == 0) {
                int k = 0;
                while (k < dglbs[i].bytes.Count) {
                    payload[dglbs[i].off + k] = dglbs[i].bytes[k];
                    k = k + 1;
                }
            }
            i = i + 1;
        }
        Append(img, payload, 0, dataLen);
    }

    // ptr _zan_eh_cls_name(long site): pure-code lookup returning the HEAP
    // strpool string for a thrown object's site id (1-based), or 0. The
    // uncaught-exception tail reports it like the oracle resolves names
    // through its tid-name registry (irgen_stmt.c reh.cls). Returning the
    // pool object (not the raw cstring) lets the tail feed it straight into
    // _zan_rt_strcat2/_zan_rt_println -- the same path as Console.WriteLine.
    void EmitClsNameFn() {
        syms.Add(new Sym("_zan_eh_cls_name", FnPad()));
        RtPrologue();
        int i = 0;
        while (i < classes.Count) {
            LoadImm(1, i + 1);
            if (tgt86 == 1) { Xop(0x39, 7, 6); }     // cmp rdi, rsi (x0 - x1)
            else { E4(0xEB01001F); }                 // cmp x0, x1
            EmitBcond(1, NL());                // b.ne next
            int hit = lblPos.Count - 1;
            strs.Add(classes[i].name);
            LoadStr(strs.Count - 1, 0);        // x0 = heap "Oops"
            RtEpilogue();                      // return name
            Mark(hit);
            i = i + 1;
        }
        LoadImm(0, 0);
        RtEpilogue();                          // unknown site: 0
    }

    // ptr zan_rt_str_alloc(i64 total): malloc'd, rc=1, magic|sentinel at raw+8
    void RtEmitStrAlloc() {        syms.Add(new Sym("_zan_rt_str_alloc", FnPad()));
        RtPrologue();
        if (tgt86 == 1) {
            X4(0x107F8D48);          // lea rdi, [rdi+16]
            BLExtern("_malloc");
            CbzReg(0, NL());
            int oom = lblPos.Count - 1;
            XLoadImm(2, 1);
            XopMemR(0x89, 2, 7, 0);              // [raw] = rc 1
            XLoadImm(2, 0x5A414E5354524D47);
            XopMemR(0x89, 2, 7, 8);              // [raw+8] = magic
            X4(0x107F8D48);          // payload = raw+16
            RtEpilogue();
            Mark(oom);
            RtOom();
            return;
        }
        AddImm(0, 0, 16);
        BLExtern("_malloc");
        CbzReg(0, NL());
        int oom = lblPos.Count - 1;
        LoadImm(2, 1);
        StrU(2, 0, 0);
        LoadImm(2, 0x5A414E5354524D47);
        StrU(2, 0, 8);
        AddImm(0, 0, 16);
        RtEpilogue();
        Mark(oom);
        RtOom();
    }

    // ptr zan_rt_strcat2(ptr a, ptr b)
    // frame 96: a@-96, b@-80, l1@-64, l2@-48, buf@-32 (l1+l2 recomputed via slots)
    void RtEmitStrCat2() {
        syms.Add(new Sym("_zan_rt_strcat2", FnPad()));
        RtPrologue();
        if (tgt86 == 1) {
            // Same shape as the arm64 body; the one extra move is XMov(7,0)
            // after strlen0 (its result lands in rax, the accumulator lives
            // in rdi). v4 is r8 on x86, so the header OR is or rsi, r8.
            AddSPImm(96, false);
            RtStur(0, 29, -96);       // a
            RtStur(1, 29, -80);       // b
            RtLdur(0, 29, -96);
            BLInternal("_zan_rt_strlen0");
            RtStur(0, 29, -64);       // l1
            RtLdur(0, 29, -80);
            BLInternal("_zan_rt_strlen0");
            RtStur(0, 29, -48);       // l2
            // memcpy(buf, a, l1) -- buf allocated after lengths so total is known
            RtLdur(0, 29, -64);       // l1
            RtLdur(1, 29, -48);       // l2
            XAddRR(0, 0, 1);          // l1 + l2
            AddImm(0, 0, 1);          // total (bytes incl NUL)
            BLInternal("_zan_rt_str_alloc");
            RtStur(0, 29, -32);       // buf
            RtLdur(0, 29, -32);
            RtLdur(1, 29, -96);
            RtLdur(2, 29, -64);
            BLExtern("_memcpy");
            // memcpy(buf + l1, b, l2)
            RtLdur(0, 29, -32);
            RtLdur(3, 29, -64);
            XAddRR(0, 0, 3);
            RtLdur(1, 29, -80);
            RtLdur(2, 29, -48);
            BLExtern("_memcpy");
            // *end = 0 at buf + l1 + l2
            RtLdur(0, 29, -32);
            RtLdur(1, 29, -64);
            XAddRR(0, 0, 1);
            RtLdur(1, 29, -48);
            XAddRR(0, 0, 1);
            Strb0(0);
            // stamp header at buf-8: 0x5A414E53_00000000 | (l1 + l2)
            RtLdur(1, 29, -64);
            RtLdur(2, 29, -48);
            XAddRR(1, 1, 2);          // len
            LoadImm(4, 0x5A414E5300000000);
            Xop(0x09, 6, 8);          // or rsi, r8 (v1=rsi, v4=r8)
            RtLdur(5, 29, -32);
            SubImm(5, 5, 8);
            RtStur(1, 5, 0);          // mov [r9], rsi (== buf-8)
            RtLdur(0, 29, -32);
            AddSPImm(96, true);
            RtEpilogue();
            return;
        }
        E4(0xD10403FF);           // sub sp, sp, #96
        RtStur(0, 29, -96);       // a
        RtStur(1, 29, -80);       // b
        RtLdur(0, 29, -96);
        BLInternal("_zan_rt_strlen0");
        RtStur(0, 29, -64);       // l1
        RtLdur(0, 29, -80);
        BLInternal("_zan_rt_strlen0");
        RtStur(0, 29, -48);       // l2
        // memcpy(buf, a, l1) -- buf allocated after lengths so total is known
        RtLdur(0, 29, -64);       // l1
        RtLdur(1, 29, -48);       // l2
        AddRR(0, 0, 1);           // x0 = l1 + l2
        AddImm(0, 0, 1);          // total (bytes incl NUL)
        BLInternal("_zan_rt_str_alloc");
        RtStur(0, 29, -32);       // buf
        RtLdur(0, 29, -32);
        RtLdur(1, 29, -96);
        RtLdur(2, 29, -64);
        BLExtern("_memcpy");
        // memcpy(buf + l1, b, l2)
        RtLdur(0, 29, -32);
        RtLdur(3, 29, -64);
        AddRR(0, 0, 3);
        RtLdur(1, 29, -80);
        RtLdur(2, 29, -48);
        BLExtern("_memcpy");
        // *end = 0 at buf + l1 + l2 (memcpy returned buf+l1, so recompute)
        RtLdur(0, 29, -32);
        RtLdur(1, 29, -64);
        AddRR(0, 0, 1);
        RtLdur(1, 29, -48);
        AddRR(0, 0, 1);
        Strb0(0);
        // stamp header at buf-8: 0x5A414E53_00000000 | (l1 + l2)
        RtLdur(1, 29, -64);
        RtLdur(2, 29, -48);
        AddRR(1, 1, 2);           // len
        LoadImm(4, 0x5A414E5300000000);
        E4(0xAA040021);           // orr x1, x1, x4
        RtLdur(5, 29, -32);
        SubImm(5, 5, 8);
        RtStur(1, 5, 0);          // str x1, [x5] (== buf-8)
        RtLdur(0, 29, -32);
        E4(0x910403FF);           // add sp, sp, #96
        RtEpilogue();
    }

    // i64 _zan_rt_strlen0(ptr s): null-safe strlen -- a null string acts as
    // the empty string, like gen0's probes ("abc" + null, concat of nulls)
    void RtEmitStrlen0() {
        syms.Add(new Sym("_zan_rt_strlen0", FnPad()));
        RtPrologue();
        CbzReg(0, NL());
        int nul = lblPos.Count - 1;
        BLExtern("_strlen");
        if (tgt86 == 1) { XMov(7, 0); }       // move rax home before the epilogue reads rdi
        RtEpilogue();
        Mark(nul);
        LoadImm(0, 0);
        RtEpilogue();
    }

    // i64 _zan_rt_strcmp0(ptr a, ptr b): null-safe strcmp -- null equals
    // null and sorts before every string (gen0 parity for ==, <, ...)
    void RtEmitStrcmp0() {
        syms.Add(new Sym("_zan_rt_strcmp0", FnPad()));
        RtPrologue();
        RtStur(0, 29, -16);                  // a
        RtStur(1, 29, -24);                  // b
        RtLdur(0, 29, -16);
        CbzReg(0, NL());
        int aNull = lblPos.Count - 1;
        RtLdur(0, 29, -24);
        CbzReg(0, NL());
        int bNull = lblPos.Count - 1;
        RtLdur(0, 29, -16);
        RtLdur(1, 29, -24);
        BLExtern("_strcmp");
        RtEpilogue();
        Mark(aNull);
        RtLdur(0, 29, -24);
        CbzReg(0, NL());
        int bothNull = lblPos.Count - 1;
        LoadImm(0, -1);                      // a null, b non-null: a < b
        RtEpilogue();
        Mark(bothNull);
        LoadImm(0, 0);                       // both null: equal
        RtEpilogue();
        Mark(bNull);
        LoadImm(0, 1);                       // b null, a non-null: a > b
        RtEpilogue();
    }

    // void zan_rt_print_int(i64 v) -- printf("%lld\n", v on stack)
    void RtEmitPrintInt() {
        syms.Add(new Sym("_zan_rt_print_int", FnPad()));
        if (tgt86 == 1) {
            // SysV: v arrives in rdi (arg0); move it to rsi BEFORE the
            // format lea overwrites rdi. AL=0 declares no vector arguments.
            RtPrologue();
            XMov(6, 7);            // mov rsi, rdi (v)
            XLeaSym("l_.str." + fmtiIdx, 0);
            X2(0x31, 0xC0);        // xor eax, eax
            BLExtern("_printf");
            RtEpilogue();
            return;
        }
        RtPrologue();
        PushV(0);           // str x0, [sp, #-16]!
        if (EnvTargetElf() == 1) {
            LdrU(1, 31, 0);       // Linux: x1 = v (register vararg)
        }
        LoadSymRef("l_.str." + fmtiIdx, 0);
        BLExtern("_printf");
        PopV(0);           // ldr x0, [sp], #16
        RtEpilogue();
    }

    // void zan_rt_println(ptr s) -- printf("%s\n", s on stack)
    void RtEmitPrintln() {
        syms.Add(new Sym("_zan_rt_println", FnPad()));
        if (tgt86 == 1) {
            RtPrologue();
            XMov(6, 7);            // mov rsi, rdi (s)
            XLeaSym("l_.str." + fmtsIdx, 0);
            X2(0x31, 0xC0);        // xor eax, eax
            BLExtern("_printf");
            RtEpilogue();
            return;
        }
        RtPrologue();
        PushV(0);
        if (EnvTargetElf() == 1) {
            LdrU(1, 31, 0);       // Linux: x1 = s (register vararg)
        }
        LoadSymRef("l_.str." + fmtsIdx, 0);
        BLExtern("_printf");
        PopV(0);
        RtEpilogue();
    }
}
