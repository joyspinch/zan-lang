using System;
using System.Collections.Generic;
namespace Zan;

partial class Ngen {
    bool TryGenStrInstCallNg(Node e, Node callee, Node recv) {
        if (!(e.kids.Count == 1 && IsStrExpr(recv))) { return false; }
        if (callee.sval == "Substring") {
            GenExpr(recv);
            XPushV0();                  // push s
            GenExpr(e.kids[0]);
            XPopV(1);                  // pop s -> x1 (x0 = start)
            SubImm(2, 1, 8);                  // sub x2, x1, #8
            LdrU(2, 2, 0);                  // ldr x2, [x2]
            Uxtw32(2, 2);                  // ubfm x2, x2, #0, #31 (len)
            int bad = NL();
            int cont = NL();
            StringCmp(0, 2);                  // cmp x0, x2
            EmitBcond(12, bad);              // b.gt bad
            EmitB(cont);
            Mark(bad);
            XPushV0();                  // keep start
            LoadSymRef("l_.str." + guardFileIdx, 0);
            LoadImm(1, curLine);
            LoadImm(2, curCol);
            LoadSymRef("l_.str." + guardSubIdx, 3);
            BLInternal("_zan_rt_guard_fail3");
            XPopV(0);                  // pop start
            LoadImm(0, 0);
            Mark(cont);
            // substr2 takes (s, start); the probe left them swapped
            MovRR(9, 0);                  // mov x9, x0
            MovRR(0, 1);                  // mov x0, x1
            MovRR(1, 9);                  // mov x1, x9
            BLInternal("_zan_rt_substr2");
            return true;
        }
        if (callee.sval == "IndexOf") {
            GenExpr(recv);
            XPushV0();                  // push s
            GenExpr(e.kids[0]);
            XPopV(1);                  // pop s -> x1 (x0 = needle)
            E4(0xAA0103E9);                  // mov x9, x1
            E4(0xAA0003E1);                  // mov x1, x0
            E4(0xAA0903E0);                  // mov x0, x9
            BLExtern("_strstr");
            int miss = NL();
            int done = NL();
            CbzReg(0, miss);
            E4(0xCB090000);                  // sub x0, x0, x9
            EmitB(done);
            Mark(miss);
            LoadImm(0, -1);
            Mark(done);
            return true;
        }
        return false;
    }
    bool TryGenDictCallNg(Node e, Node callee, Node recv) {
        if (!(ExprCls(recv) == "Dict" && DictOpKnown(callee.sval, e.kids.Count))) { return false; }
        if (!DictCheckType(recv)) { return true; }
        if (e.kids.Count > 0) { DictCheckOperand(recv, e.kids[0], true); }
        if (callee.sval == "Add" && e.kids.Count == 2) {
            DictCheckOperand(recv, e.kids[1], false);
            // dict.Add(key, value): receiver under the args so a
            // nested call inside any operand cannot clobber the
            // dict; value pushes first, then key, then the dict
            GenExpr(e.kids[1]);              // value -> x0
            GenCloneIfStruct(e.kids[1]);     // struct values: fresh box
            XPushV0();                  // push value
            GenExpr(e.kids[0]);              // key -> x0
            XPushV0();                  // push key
            GenExpr(recv);                   // dict -> x0
            XPushV0();                  // push dict
            RtDictSet3();
            return true;
        }
        if (callee.sval == "ContainsKey" && e.kids.Count == 1) {
            GenExpr(recv);
            XPushV0();                  // push dict
            GenExpr(e.kids[0]);              // key -> x0
            MovRR(1, 0);                     // x1 = key
            XPopV(0);                  // pop dict -> x0
            BLInternal("_zan_rt_dict_contains");
            return true;
        }
        if (callee.sval == "Remove" && e.kids.Count == 1) {
            GenExpr(recv);
            XPushV0();                  // push dict
            GenExpr(e.kids[0]);              // key -> x0
            MovRR(1, 0);                     // x1 = key
            XPopV(0);                  // pop dict -> x0
            BLInternal("_zan_rt_dict_remove");
            return true;
        }
        if (callee.sval == "Clear" && e.kids.Count == 0) {
            GenExpr(recv);
            BLInternal("_zan_rt_dict_clear");
            return true;
        }
        if (callee.sval == "TryGetValue" && e.kids.Count == 2) {
            // dict.TryGetValue(key, out v): found -> 1 and *out = value.
            // A plain argument against the out parameter (no `out`
            // keyword) auto-wraps: the variable's storage passes.
            Node outa = e.kids[1];
            if (outa.type == null && outa.a == null
                    && (outa.kind == AK.Ident() || outa.kind == AK.Index()
                        || outa.kind == AK.MemberAccess())) {
                Node ow = new Node(AK.OutArg());
                ow.a = outa;
                ow.line = outa.line;
                ow.col = outa.col;
                outa = ow;
            }
            Node place = outa.type == null ? outa.a : null;
            bool narrow = place != null && place.kind == AK.Index()
                && ArrContainerTy(place.a) != null
                && ArrElemSize(ArrContainerTy(place.a)) != 8;
            if (narrow) {
                // The runtime store is a full 8-byte slot; a packed
                // narrow element destination (byte[]/short[]/int[]...)
                // would overwrite its neighbors. Stage the value in a
                // scratch slot and store only the element's width.
                GenExpr(recv);
                XPushV0();                  // push dict
                GenExpr(e.kids[0]);              // key -> x0
                XPushV0();                  // push key across out-address evaluation
                GenRefArg(outa);                 // x0 = dest element address
                MovRR(20, 0);                  // mov x20, x0 (callee-saved across the call)
                XPopV(1);                  // pop key -> x1
                XPopV(0);                  // pop dict -> x0
                if (tgt86 == 1) { X2(0x48, 0x83); X2(0xEC, 0x10); } else { E4(0xD10043FF); }                  // sub sp, sp, #16 (scratch BELOW the frame)
                if (tgt86 == 1) { X2(0x48, 0x89); X1(0xE2); } else { E4(0x910003E2); }                  // add x2, sp, #0 (scratch slot)
                BLInternal("_zan_rt_dict_tryget");
                int skip = NL(); int done = NL();
                CbzReg(0, skip);                 // miss: dest unchanged
                if (tgt86 == 1) { X3(0x4C, 0x8B, 0x14); X1(0x24); XSetV(9, 10); } else { E4(0xF94003E9); }                  // ldr x9, [sp] (staged value; REX.R=1 -> r10, XSetV 取的就是 r10)
                int wesz = ArrElemSize(ArrContainerTy(place.a));
                if (wesz == 1) {
                    if (tgt86 == 1) { XGetV(20, 11); XGetV(9, 10); X3(0x44, 0x88, 0x13); } else { E4(0x39000289); }              // strb w9, [x20] (1-byte dest store)
                } else if (wesz == 2) {
                    if (tgt86 == 1) { XGetV(20, 11); XGetV(9, 10); X4(0x13894566); } else { E4(0x79000289); }              // strh w9, [x20] (2-byte dest store)
                } else {
                    if (tgt86 == 1) { XGetV(20, 11); XGetV(9, 10); X3(0x45, 0x89, 0x13); } else { E4(0xB9000289); }              // str w9, [x20] (4-byte dest store)
                }
                Mark(skip);
                if (tgt86 == 1) { X2(0x48, 0x83); X2(0xC4, 0x10); } else { E4(0x910043FF); }                  // add sp, sp, #16 (free scratch)
                Mark(done);
                return true;
            }
            GenExpr(recv);
            XPushV0();                  // push dict
            GenExpr(e.kids[0]);              // key -> x0
            XPushV0();                  // push key across out-address evaluation
            GenRefArg(outa);                 // receiver/index calls may clobber x1
            MovRR(2, 0);                     // x2 = out addr
            XPopV(1);                  // pop key -> x1
            XPopV(0);                  // pop dict -> x0
            BLInternal("_zan_rt_dict_tryget");
            // a struct value leaves the dict as a fresh copy: the out
            // local must not alias the slot's box (the runtime already
            // stored the shared box through x2)
            string tvy = DictSlotTy(recv, false);
            string tvn = tvy != null ? ClassTyOf(tvy) : null;
            Cls tvc = tvn != null ? FindClass(tvn) : null;
            if (tvc != null && tvc.isStruct == 1) {
                int skipTg = NL();
                CbzReg(0, skipTg);           // miss: dest unchanged
                XPushR(2);              // keep out addr across the clone
                LdrU(0, 2, 0);               // x0 = *out (shared box)
                GenCloneStructCls(tvc);      // x0 = fresh copy
                XPopV(2);                    // pop out addr -> x2
                StrU(0, 2, 0);               // *out = fresh box
                Mark(skipTg);
            }
            return true;
        }
        diags.Error("ngen: unsupported Dictionary operation '" + callee.sval + "'", e.line, e.col);
        return true;
        return false;
    }
    bool TryGenListCallNg(Node e, Node callee, Node recv) {
        if (!(ExprCls(recv) == "List")) { return false; }
        if (callee.sval == "Add" && e.kids.Count == 1) {
            GenListAdd(recv, e.kids[0]);
            return true;
        }
        if (callee.sval == "Clear" && e.kids.Count == 0) {
            GenExpr(recv);
            if (tgt86 == 1) { StrU(31, 0, 0); } else { E4(0xF900001F); }   // str xzr, [x0] (count = 0)
            return true;
        }
        if (callee.sval == "Contains" && e.kids.Count == 1) {
            GenListFind(recv, e.kids[0], false);
            return true;
        }
        if (callee.sval == "Remove" && e.kids.Count == 1) {
            GenListSearch(recv, e.kids[0], false, true);
            return true;
        }
        if (callee.sval == "RemoveAt" && e.kids.Count == 1) {
            GenExpr(recv);
            XPushV0();                  // push list
            GenExpr(e.kids[0]);
            MovRR(2, 0);                     // x2 = idx
            XPopV(0);                  // pop list -> x0
            MovRR(1, 2);                     // x1 = idx
            BLInternal("_zan_rt_list_removeat");
            return true;
        }
        if (callee.sval == "Insert" && e.kids.Count == 2) {
            GenExpr(recv);
            XPushV0();                  // push list
            GenExpr(e.kids[0]);              // idx
            XPushV0();
            GenExpr(e.kids[1]);              // value -> x0
            MovRR(2, 0);                     // x2 = value
            XPopV(1);                  // pop idx -> x1
            XPopV(0);                  // pop list -> x0
            BLInternal("_zan_rt_list_insert");
            return true;
        }
        if (callee.sval == "Reverse" && e.kids.Count == 0) {
            GenExpr(recv);
            BLInternal("_zan_rt_list_reverse");
            return true;
        }
        if (callee.sval == "Reserve" && e.kids.Count == 1) {
            // pre-grow the backing buffer: no observable change
            // beyond later Adds skipping a realloc
            GenExpr(recv);
            XPushV0();                  // push list
            GenExpr(e.kids[0]);              // want -> x0
            MovRR(1, 0);                     // x1 = want
            XPopV(0);                  // pop list -> x0
            BLInternal("_zan_rt_list_reserve");
            return true;
        }
        if (callee.sval == "IndexOf" && e.kids.Count == 1) {
            GenListFind(recv, e.kids[0], true);
            return true;
        }
        if (callee.sval == "AddRange" && e.kids.Count == 1) {
            GenExpr(recv);
            XPushV0();                  // push dst
            GenExpr(e.kids[0]);
            MovRR(2, 0);                     // x2 = src
            XPopV(0);                  // pop dst -> x0
            MovRR(1, 2);                     // x1 = src
            BLInternal("_zan_rt_list_addrange");
            return true;
        }
        if (callee.sval == "ToArray" && e.kids.Count == 0) {
            GenExpr(recv);
            // the result packs the STATIC element size (what arr[i]
            // will read): float repacks into a real float[],
            // long/double/string/object stay 8-wide, int/uint/char
            // pack 4, short 2, bool/byte 1 -- the runtime face must
            // match or the reads interleave with zeros
            string rt = StaticTyOf(recv);
            if (rt == "List<float>") { BLInternal("_zan_rt_list_toarray_f32"); return true; }
            string lel = (rt != null && rt.Length >= 6) ? rt.Substring(5, rt.Length - 6) : "object";
            int aesz = ArrElemSize(lel + "[]");
            if (aesz == 8) { BLInternal("_zan_rt_list_toarray"); }
            else if (aesz == 4) { BLInternal("_zan_rt_list_toarray4"); }
            else if (aesz == 2) { BLInternal("_zan_rt_list_toarray2"); }
            else { BLInternal("_zan_rt_list_toarray1"); }
            return true;
        }
        // not an inline List op: fall through to the host, spec and
        // extension dispatchers (Enumerable.Sum(this List<double>)
        // resolves by receiver fit; gen0's member lookup answers the
        // same way)
        return false;
    }
    bool TryGenConsoleCallNg(Node e, Node callee, Node recv) {
        if (!(recv != null && recv.kind == AK.Ident() && recv.sval == "Convert")) { return false; }
        string mn = callee.sval;
        if (e.kids.Count == 1 && !UserDefinesClsMember("Convert", mn)) {
            Node arg = e.kids[0];
            if (mn == "ToString") {
                // gen0's ordering: string -> owned copy, char ->
                // the character, double -> shortest-round-trip
                // text, ulong unsigned decimal, rest signed
                if (IsStrExpr(arg)) {
                    GenExpr(arg);
                    XPushV0();              // push s
                    LoadStr(InternStr(""), 0);   // x0 = ""
                    XPopV(1);              // pop -> x1 (x0="", x1=s)
                    BLInternal("_zan_rt_strcat2");
                } else if (IsCharExpr(arg)) {
                    GenExpr(arg);
                    BLInternal("_zan_rt_chrstr");
                } else if (IsDblExpr(arg)) {
                    GenExpr(arg);
                    BLInternal("_zan_rt_dbl2str");
                } else if (IsUlongExpr(arg)) {
                    GenExpr(arg);
                    BLInternal("_zan_rt_uint2str");
                } else {
                    GenExpr(arg);
                    BLInternal("_zan_rt_int2str");
                }
                return true;
            }
            if (mn == "ToInt32" || mn == "ToInt64" || mn == "ToInt") {
                if (IsStrExpr(arg)) {
                    // strtoll(s, NULL, 10): full signed 64-bit
                    GenExpr(arg);
                    XPushV0();              // push s
                    LoadImm(1, 0);               // endptr = NULL
                    LoadImm(2, 10);
                    XPopV(0);              // pop -> x0 = s
                    BLExtern("_strtoll");
                } else if (IsDblExpr(arg)) {
                    GenExpr(arg);
                    // C# Convert.ToInt* rounds to even; the host rints
                    // before the truncating conversion (TASKS.md A513)
                    if (tgt86 == 1) {
                        X3(0x66, 0x48, 0x0F); X2(0x6E, 0xC7);   // movq xmm0, rdi
                        BLExtern("_rint");
                        X3(0x66, 0x48, 0x0F); X2(0x7E, 0xC7);   // movq rdi, xmm0
                        X2(0xF2, 0x48); X2(0x0F, 0x2C); X1(0xF8);   // cvttsd2si rdi, xmm0
                    } else {
                        E4(0x9E670000);              // fmov d0, x0
                        BLExtern("_rint");
                        E4(0x9E660000);              // fmov x0, d0
                        E4(0x9E780000);              // fcvtzs x0, d0
                    }
                } else {
                    GenExpr(arg);                // int slots are i64 already
                }
                return true;
            }
            if (mn == "ToDouble") {
                if (IsStrExpr(arg)) {
                    GenExpr(arg);
                    LoadImm(1, 0);               // endptr = NULL
                    BLInternal("_zan_rt_dbl_parse");
                    if (tgt86 == 1) {
                        X3(0x66, 0x48, 0x0F); X2(0x7E, 0xC7);   // movq rdi, xmm0
                    } else {
                        if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x7E, 0xC7); } else { E4(0x9E660000); }              // fmov x0, d0
                    }
                } else if (IsDblExpr(arg)) {
                    GenExpr(arg);                // bits unchanged
                } else {
                    GenExpr(arg);
                    if (tgt86 == 1) {
                        X2(0xF2, 0x0F); X2(0x2A, 0xC7);   // cvtsi2sd xmm0, rdi
                        X3(0x66, 0x48, 0x0F); X2(0x7E, 0xC7);   // movq rdi, xmm0
                    } else {
                        if (tgt86 == 1) { X4(0x2A0F48F2); X1(0xC7); } else { E4(0x9E620000); }              // scvtf d0, x0
                        if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x7E, 0xC7); } else { E4(0x9E660000); }              // fmov x0, d0
                    }
                }
                return true;
            }
        }
        return false;
    }
    bool TryGenBaseCallNg(Node e, Node callee, Node recv) {
        if (!(recv != null && (recv.kind == AK.BaseExpr() || (recv.kind == AK.Ident() && recv.sval == "base")))) { return false; }
        int bi2 = ResolveBaseImplNg(callee.sval, e);
        if (bi2 >= 0) {
            GenExpr(new Node(AK.ThisExpr()));
            XPushV0();                          // str x0, [sp, #-16]!
            int pushed2 = PushCallArgs(methNodes[bi2], e);
            int r2 = pushed2;
            int armOvfArea2 = 0;
            if (tgt86 == 1) {
                while (r2 >= 1) {
                    if (r2 < 6) {
                        XopRMem(0x8B, XMapReal(r2), 4, 16 * (pushed2 - r2));
                    } else {
                        XopRMem(0x8B, 10, 4, 16 * (pushed2 - r2));
                        XSetV(XArgVOf(r2), 10);
                    }
                    r2 = r2 - 1;
                }
                XopRMem(0x8B, XMapReal(0), 4, 16 * pushed2);
                XAddRsp(16 * (pushed2 + 1));
                xStackArgs = pushed2 > 5 ? pushed2 - 5 : 0;
            } else if (pushed2 + 1 > 16) {
                int novf2 = pushed2 + 1 - 16;
                armOvfArea2 = 16 * ((novf2 + 1) / 2);
                AddSPImm(armOvfArea2, false);
                LdrU(0, 31, armOvfArea2 + 16 * pushed2);
                int k = 1;
                while (k <= pushed2) {
                    int off = armOvfArea2 + 16 * (pushed2 - k);
                    if (k < 16) { LdrU(k, 31, off); }
                    else { LdrU(10, 31, off); StrU(10, 31, 8 * (k - 16)); }
                    k = k + 1;
                }
            } else {
                while (r2 >= 1) { XPopV(r2); r2 = r2 - 1; }
                XPopV(0);                          // ldr x0, [sp], #16 (this)
            }
            BLInternal(MethSymNg(methCls[bi2], methNodes[bi2]));
            if (armOvfArea2 > 0) { AddSPImm(armOvfArea2 + 16 * (pushed2 + 1), true); }
            return true;
        }
        return false;
    }
}
