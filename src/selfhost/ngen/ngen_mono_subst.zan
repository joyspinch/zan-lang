using System;
using System.Collections.Generic;
namespace Zan;

partial class Ngen {
    // does the method-group argument `ae` (a bare identifier naming a
    // static method) fit delegate type sj: same parameter count and
    // matching return family -- loose ranking evidence, not a binding
    bool MethodGroupFitNg(Node ae, string sj) {
        if (ae == null || ae.kind != AK.Ident() || ae.sval == null) { return false; }
        List<int> cs = MethCandsName(ae.sval);
        if (cs == null) { return false; }
        List<string> dps = DelegateArgsNg(sj);
        int want = dps != null ? dps.Count : 0;
        int rf = RetFamNg(DelegateRetNg(sj));
        int i = 0;
        while (i < cs.Count) {
            int mi = cs[i];
            if (methStat[mi] == 1 && ParamCount(methNodes[mi]) == want
                    && RetFamNg(TypeFullName(methNodes[mi].type)) == rf) { return true; }
            i = i + 1;
        }
        return false;
    }

    int shapeMi;          // best shaped-extension candidate of the last scan
    List<string> shapeBind;
    int shapeScore;

    // scan same-name `this`-receiver generic statics for one whose shaped
    // receiver (`this List<T>`) unifies with rt and whose type parameters
    // bind completely from the receiver and the written arguments; the
    // best-scoring candidate lands in shapeMi/shapeBind/shapeScore. No
    // mutation -- both the dispatch rewrite and the ret-type lookup read
    // the same scan.
    void ScanShapedExtNg(string rt, string name, List<Node> args) {
        shapeMi = -1;
        shapeBind = null;
        shapeScore = -1;
        List<int> cs = MethCandsName(name);
        if (cs == null) { return; }
        List<string> argTys = new List<string>();
        int ai0 = 0;
        while (ai0 < args.Count) {
            Node ae0 = args[ai0];
            string at0 = null;
            if (ae0 != null && ae0.kind != AK.Lambda()) {
                at0 = StaticTyOf(ae0);
                if (at0 == null) { at0 = ArgNaturalTyNg(ae0); }
            }
            argTys.Add(at0);
            ai0 = ai0 + 1;
        }
        int i = 0;
        while (i < cs.Count) {
            int mi = cs[i];
            Node m = methNodes[mi];
            List<string> tps = DeclTps(m);
            if (methStat[mi] == 1 && m.ival == 1 && tps.Count > 0 && m.kids.Count > 0) {
                Node p0 = ParamAt(m, 0);
                string pt = p0 != null && p0.type != null ? TypeFullName(p0.type) : null;
                // bare `this T` receivers belong to the plain extension path
                if (pt != null && IndexOfStrNg(tps, pt) < 0 && TyMentionsAnyTp(pt, tps)) {
                    List<string> bind = new List<string>();
                    int bi = 0;
                    while (bi < tps.Count) { bind.Add(null); bi = bi + 1; }
                    UnifyTps(pt, rt, tps, bind);
                    int pc = ParamCount(m);
                    int j = 1;
                    while (j < pc) {
                        int ai = j - 1;
                        if (ai < args.Count) {
                            Node ae = args[ai];
                            string at2 = ai < argTys.Count ? argTys[ai] : null;
                            string dp2 = null;
                            Node pp = ParamAt(m, j);
                            if (pp != null && pp.type != null) { dp2 = TypeFullName(pp.type); }
                            if (dp2 != null) {
                                if (at2 != null) {
                                    UnifyTps(dp2, at2, tps, bind);
                                } else if (ae != null && ae.kind == AK.Lambda()) {
                                    // a lambda pins the delegate's parameter
                                    // positions from its explicit annotations
                                    // and the return position from its typed
                                    // body (Select<T,R>: R = body type)
                                    LambdaBindNg(ae, dp2, tps, bind);
                                }
                            }
                        }
                        j = j + 1;
                    }
                    bool full = true;
                    int bi2 = 0;
                    while (bi2 < bind.Count) {
                        if (bind[bi2] == null || !KnownTyName(bind[bi2])) { full = false; }
                        bi2 = bi2 + 1;
                    }
                    if (full) {
                        int score = SubstTy(pt, tps, bind) == rt ? 8 : 0;
                        int j2 = 1;
                        while (j2 < pc) {
                            int ai2 = j2 - 1;
                            if (ai2 < args.Count) {
                                Node ae2 = args[ai2];
                                Node pp2 = ParamAt(m, j2);
                                if (ae2 != null && pp2 != null && pp2.type != null) {
                                    string sj = SubstTy(TypeFullName(pp2.type), tps, bind);
                                    if (ae2.kind == AK.Lambda()) {
                                        int rf = RetFamNg(DelegateRetNg(sj));
                                        if (rf != 0 && ae2.d == null && ae2.a != null
                                                && rf == LamFamForNg(ae2, sj)) {
                                            score = score + 4;
                                        }
                                    } else {
                                        string atj = ai2 < argTys.Count ? argTys[ai2] : null;
                                        if (atj != null && atj == sj) { score = score + 8; }
                                        else if (MethodGroupFitNg(ae2, sj)) { score = score + 4; }
                                    }
                                }
                            }
                            j2 = j2 + 1;
                        }
                        if (score > shapeScore) {
                            shapeScore = score;
                            shapeMi = mi;
                            shapeBind = bind;
                        }
                    }
                }
            }
            i = i + 1;
        }
    }

    // return type of an instance-form extension call (`xs.Sum()`) without
    // mutating the call node: the receiver's static type against same-name
    // `this` statics -- exact receiver-type fit first, then shaped generic
    // receivers unified (the receiver binds declared parameter 0)
    string ExtRetTyNg(Node e) {
        return ExtRetTyWithRecvNg(e, null);
    }

    string ExtRetTyWithRecvNg(Node e, string knownRt) {
        if (e == null || e.a == null || e.a.kind != AK.MemberAccess()
                || e.a.a == null) { return null; }
        if (extRetDepth > 128) { return null; }
        extRetDepth = extRetDepth + 1;
        string rt = knownRt != null ? knownRt : ExtRecvTy(e.a.a);
        if (rt == null) {
            extRetDepth = extRetDepth - 1;
            return null;
        }
        string name = e.a.sval;
        List<int> cs = MethCandsName(name);
        if (cs != null) {
            int i = 0;
            while (i < cs.Count) {
                int mi = cs[i];
                Node m = methNodes[mi];
                if (methStat[mi] == 1 && m.ival == 1 && m.kids.Count > 0
                        && ParamCount(m) == e.kids.Count + 1) {
                    Node p0 = ParamAt(m, 0);
                    string pt = p0 != null && p0.type != null ? TypeFullName(p0.type) : null;
                    if (pt != null && pt == rt) {
                        extRetDepth = extRetDepth - 1;
                        return TypeFullName(m.type);
                    }
                }
                i = i + 1;
            }
        }
        ScanShapedExtNg(rt, name, e.kids);
        if (shapeMi >= 0) {
            Node m = methNodes[shapeMi];
            string res = SubstTy(TypeFullName(m.type), DeclTps(m), shapeBind);
            extRetDepth = extRetDepth - 1;
            return res;
        }
        extRetDepth = extRetDepth - 1;
        return null;
    }

    // dispatch twin of the scan: register the best shaped candidate, insert
    // the receiver into the argument list and rewrite the callee
    int ResolveShapedExtNg(Node recv, string name, Node callNode) {
        string rt = ExtRecvTy(recv);
        if (rt == null) { return -1; }
        ScanShapedExtNg(rt, name, callNode.kids);
        if (shapeMi < 0) { return -1; }
        callNode.kids.Insert(0, recv);
        SpecRegister(name, shapeBind, callNode, shapeMi);
        Node ci = new Node(AK.Ident());
        ci.sval = methCls[shapeMi];
        ci.line = callNode.line;
        ci.col = callNode.col;
        Node ma2 = new Node(AK.MemberAccess());
        ma2.a = ci;
        ma2.sval = callNode.a.sval;      // mangled by SpecRegister
        ma2.line = callNode.line;
        ma2.col = callNode.col;
        callNode.a = ma2;
        int spx = FindMethByNameNg(ma2.sval);
        return spx >= 0 ? spx : shapeMi;
    }

    // does a same-name NON-generic overload that fits the written argument
    // count live in the scope the inference would draw from? gen0 ranks the
    // whole overload set before inferring type args, so `SumNum(src)` picks
    // the non-generic `SumNum(this List<double>)` over inferring the generic
    // one (whose extra key-selector parameter then arity-mismatches)
    // does decl m's parameter types agree with the call's written argument
    // types wherever an argument's static type is known (a known type that
    // disagrees disqualifies the overload; unknown types prove nothing)
    bool DeclParamsMatchArgs(Node m, List<string> argTys) {
        int k = 0;
        while (k < argTys.Count && k < ParamCount(m)) {
            string at = argTys[k];
            Node pp = ParamAt(m, k);
            if (at != null && pp != null && pp.type != null) {
                string dp = TypeFullName(pp.type);
                if (dp != null && dp != at && dp != "object") { return false; }
            }
            k = k + 1;
        }
        return true;
    }

    bool NonGenericOverloadFits(Node n, bool owned) {
        List<int> cands = new List<int>();
        if (owned) {
            string rc = SpecRecvClsNg(n);
            while (rc != null) {
                List<int> cs = MethCandsClsName(rc, n.a.sval);
                if (cs != null) {
                    int i = 0;
                    while (i < cs.Count) {
                        if (methStat[cs[i]] != 2 && methStat[cs[i]] != 3
                                && !HasTypeParams(methNodes[cs[i]])) { cands.Add(cs[i]); }
                        i = i + 1;
                    }
                }
                Cls oc = FindClass(rc);
                rc = oc != null ? oc.baseName : null;
            }
        } else {
            List<int> gs = MethCandsName(n.a.sval);
            if (gs != null) {
                int i = 0;
                while (i < gs.Count) {
                    if (methStat[gs[i]] != 2 && methStat[gs[i]] != 3
                            && !HasTypeParams(methNodes[gs[i]])) { cands.Add(gs[i]); }
                    i = i + 1;
                }
            }
        }
        if (cands.Count == 0) { return false; }
        List<string> argTys = new List<string>();
        int ki = 0;
        while (ki < n.kids.Count) {
            string at = StaticTyOf(n.kids[ki]);
            if (at == null) { at = ExtRecvTy(n.kids[ki]); }
            argTys.Add(at);
            ki = ki + 1;
        }
        int want = n.kids.Count;
        int i2 = 0;
        while (i2 < cands.Count) {
            Node m = methNodes[cands[i2]];
            if (ParamCount(m) == want && DeclParamsMatchArgs(m, argTys)) { return true; }
            i2 = i2 + 1;
        }
        // instance-form extension: the receiver occupies the first slot, so
        // a `this T` static with one more parameter than written arguments
        // fits when its receiver type matches (ResolveExtNg's filter)
        if (!owned && n.a.kind == AK.MemberAccess() && n.a.a != null
                && !(n.a.a.kind == AK.Ident() && FindClass(n.a.a.sval) != null)) {
            string rt = ExtRecvTy(n.a.a);
            if (rt != null) {
                int i3 = 0;
                while (i3 < cands.Count) {
                    Node m2 = methNodes[cands[i3]];
                    if (methStat[cands[i3]] == 1 && m2.ival == 1
                            && ParamCount(m2) == want + 1) {
                        Node p0 = ParamAt(m2, 0);
                        string pt = p0 != null && p0.type != null ? TypeFullName(p0.type) : null;
                        if (pt == rt) { return true; }
                    }
                    i3 = i3 + 1;
                }
            }
        }
        return false;
    }

    // plan an un-annotated generic call: the receiver's own scope must
    // declare a single-type-param generic of that name (extension
    // inference keeps the global rule when the chain names nothing) and
    // the type parameters bind by unifying each declared parameter type
    // against its actual argument type (gen0's infer_method_tp_bindings
    // would bind an extension's receiver as parameter 0, but a pre-pass
    // registration has no way to pass the receiver -- instance-form
    // extensions are left to the dispatchers below). Returns false when
    // nothing can be registered, so the caller's else-if chain keeps
    // falling through to the instantiated-class branches.
    // gen0's lambda second pass: the delegate parameter `dp`
    // ("Selector<T,R>") pins its PARAMETER positions from the lambda's
    // explicit annotations and its RETURN position from the typed body
    // (the lambda's parameters are temporarily in scope for the probe).
    // `tps`/`bind` are the method's type parameters and partial bindings.
    void LambdaBindNg(Node ae, string dp, List<string> tps, List<string> bind) {
        if (ae == null || ae.kind != AK.Lambda() || ae.a == null || ae.d != null
                || dp == null || dp.IndexOf("<") <= 0) { return; }
        int lt = dp.IndexOf("<");
        Node dd = layoutBinder.FindDelegate(dp.Substring(0, lt));
        if (dd == null || dd.type == null) { return; }
        List<string> dtps = DeclTps(dd);
        List<string> dargs = SplitTyArgs(dp.Substring(lt + 1, dp.Length - lt - 2));
        List<string> dpt = new List<string>();
        int kd = 0;
        while (kd < dd.kids.Count) {
            if (dd.kids[kd].kind == AK.Param() && dd.kids[kd].type != null) {
                dpt.Add(TypeFullName(dd.kids[kd].type));
            }
            kd = kd + 1;
        }
        if (dpt.Count == 0) { return; }
        List<Node> lps = new List<Node>();
        int li = 0;
        while (li < ae.kids.Count) {
            if (ae.kids[li].kind == AK.Param()) { lps.Add(ae.kids[li]); }
            li = li + 1;
        }
        if (lps.Count != dpt.Count) { return; }
        int savedN = nloc;
        int savedHead = locHead;
        bool known = true;
        int pi = 0;
        while (pi < lps.Count) {
            Node lp = lps[pi];
            string conc = SubstTy(SubstTy(dpt[pi], dtps, dargs), tps, bind);
            if (lp.type != null && lp.type.sval != null && lp.type.sval != "var") {
                string ann = TypeFullName(lp.type);
                if (ann != null) {
                    UnifyTps(dpt[pi], ann, tps, bind);
                    conc = ann;
                }
            }
            if (conc == null || !KnownTyName(conc)) { known = false; }
            if (lp.sval != null) { AddLoc(lp.sval, conc, false); }
            pi = pi + 1;
        }
        if (known) {
            string bt = StaticTyOf(ae.a);
            // arithmetic / comparison bodies have no StaticTyOf arm; the
            // wider inferrer names them (Select<T,R>: R = `n * 2` -> int)
            if (bt == null) { bt = InferExprTyNg(ae.a); }
            if (bt != null && KnownTyName(bt)) {
                string rt2 = TypeFullName(dd.type);
                // the delegate's return may name the DELEGATE's own type
                // parameters (Selector's R); map them through the delegate
                // type arguments first (Selector<T, V> on a method whose
                // parameter is named V) -- the parameter side above already
                // substitutes dargs, the return side must too, or the
                // unify lands outside the method's tp list and V never
                // binds
                string rt3 = SubstTy(rt2, dtps, dargs);
                if (rt3 != null) { UnifyTps(rt3, bt, tps, bind); }
            }
        }
        int pop = lps.Count;
        nloc = savedN;
        locHead = savedHead;
        while (pop > 0) {
            locName.RemoveAt(locName.Count - 1);
            locTy.RemoveAt(locTy.Count - 1);
            locOff.RemoveAt(locOff.Count - 1);
            locRef.RemoveAt(locRef.Count - 1);
            locDecl.RemoveAt(locDecl.Count - 1);
            locPrev.RemoveAt(locPrev.Count - 1);
            locOpaq.RemoveAt(locOpaq.Count - 1);
            locBoxed.RemoveAt(locBoxed.Count - 1);
            pop = pop - 1;
        }
    }

    bool TryPlanInferenceSpecNg(Node n) {
        // the same-name generic overload set, receiver chain first. The
        // oracle ranks the whole set before inferring; taking the first
        // same-name generic hijacks delegate-typed overload families
        List<int> cands = new List<int>();
        string rc = SpecRecvClsNg(n);
        bool inScope = false;
        while (rc != null) {
            List<int> cs = MethCandsClsName(rc, n.a.sval);
            if (cs != null) {
                int i = 0;
                while (i < cs.Count) {
                    int mi = cs[i];
                    if (methStat[mi] != 2 && methStat[mi] != 3 && HasTypeParams(methNodes[mi])) {
                        cands.Add(mi);
                        inScope = true;
                    }
                    i = i + 1;
                }
            }
            Cls oc = FindClass(rc);
            rc = oc != null ? oc.baseName : null;
        }
        if (!inScope && n.a.kind == AK.MemberAccess() && !ReceiverHasNameNg(n, n.a.sval)) {
            List<int> gs = MethCandsName(n.a.sval);
            if (gs != null) {
                int i = 0;
                while (i < gs.Count) {
                    int mi = gs[i];
                    if (methStat[mi] != 2 && methStat[mi] != 3 && HasTypeParams(methNodes[mi])) { cands.Add(mi); }
                    i = i + 1;
                }
            }
        }
        if (cands.Count == 0) { return false; }
        if (NonGenericOverloadFits(n, inScope)) { return false; }
        // class-qualified statics (`Enumerable.SumNum(src)`) pass every
        // written argument to declared parameters 1:1. A genuine
        // instance-form extension (`xs.Sum()`) must not register here: the
        // dispatch's extension path inserts the receiver into the argument
        // list, a pre-pass registration cannot, so the spec would
        // arity-mismatch against its own shaped `this` parameter
        bool classQual = n.a.kind == AK.MemberAccess() && n.a.a != null
            && n.a.a.kind == AK.Ident() && FindClass(n.a.a.sval) != null;
        List<string> inferArgTys = new List<string>();
        int ki2 = 0;
        while (ki2 < n.kids.Count) {
            Node ae2 = n.kids[ki2];
            string at2 = null;
            if (ae2 != null) {
                at2 = StaticTyOf(ae2);
                if (at2 == null) { at2 = ExtRecvTy(ae2); }
                if (at2 == null) { at2 = ArgNaturalTyNg(ae2); }
            }
            inferArgTys.Add(at2);
            ki2 = ki2 + 1;
        }
        int bestDi = -1;
        List<string> bestBind = null;
        int bestScore = -1;
        int ci = 0;
        while (ci < cands.Count) {
            int udi = cands[ci];
            Node gd = methNodes[udi];
            List<string> tps0 = DeclTps(gd);
            if (tps0.Count >= 1) {
                bool instExt = gd.ival == 1 && n.a.kind == AK.MemberAccess() && !classQual;
                if (!instExt) {
                    List<string> bind = new List<string>();
                    int bi = 0;
                    while (bi < tps0.Count) { bind.Add(null); bi = bi + 1; }
                    int pc = ParamCount(gd);
                    int j = 0;
                    while (j < pc) {
                        Node ae = null;
                        if (j < n.kids.Count) { ae = n.kids[j]; }
                        if (ae != null) {
                            string at = j < inferArgTys.Count ? inferArgTys[j] : null;
                            string dp = null;
                            Node pp = ParamAt(gd, j);
                            if (pp != null && pp.type != null) { dp = TypeFullName(pp.type); }
                            if (dp != null) {
                                if (at != null) {
                                    UnifyTps(dp, at, tps0, bind);
                                } else {
                                    LambdaBindNg(ae, dp, tps0, bind);
                                }
                            }
                        }
                        j = j + 1;
                    }
                    bool full = true;
                    int fi = 0;
                    while (fi < bind.Count) {
                        if (bind[fi] == null || !KnownTyName(bind[fi])) { full = false; }
                        fi = fi + 1;
                    }
                    if (full) {
                        int score = InferCandScoreNg(n, gd, bind, inferArgTys);
                        if (score > bestScore) { bestScore = score; bestDi = udi; bestBind = bind; }
                    }
                }
            }
            ci = ci + 1;
        }
        if (bestDi < 0) { return false; }
        inferDi = bestDi;
        inferArgs = bestBind;
        return true;
    }

    // natural type of an argument the light scan cannot type: literals
    // carry their C# natural type (Aggregate's `100` seed pins A=int)
    string ArgNaturalTyNg(Node ae) {
        if (ae == null) { return null; }
        if (ae.kind == AK.IntLit()) { return "int"; }
        if (ae.kind == AK.FloatLit()) { return "double"; }
        if (ae.kind == AK.StringLit()) { return "string"; }
        if (ae.kind == AK.CharLit()) { return "char"; }
        if (ae.kind == AK.BoolLit()) { return "bool"; }
        return null;
    }

    // substitution quality of a fully-bound inference candidate: exact
    // argument/parameter matches dominate, lambda delegate-return family
    // matches break ties (gen0 prefers the selector whose return type the
    // lambda body actually produces)
    int InferCandScoreNg(Node n, Node gd, List<string> bind, List<string> argTys) {
        int score = 0;
        List<string> tps = DeclTps(gd);
        int pc = ParamCount(gd);
        int j = 0;
        while (j < pc) {
            Node ae = null;
            if (j < n.kids.Count) { ae = n.kids[j]; }
            Node pp = ParamAt(gd, j);
            if (ae != null && pp != null && pp.type != null) {
                string sj = SubstTy(TypeFullName(pp.type), tps, bind);
                if (ae.kind == AK.Lambda()) {
                    int rf = RetFamNg(DelegateRetNg(sj));
                    if (rf != 0 && ae.d == null && ae.a != null && rf == LamFamForNg(ae, sj)) { score = score + 4; }
                } else {
                    string atj = j < argTys.Count ? argTys[j] : null;
                    if (atj != null && atj == sj) { score = score + 8; }
                    else if (MethodGroupFitNg(ae, sj)) { score = score + 4; }
                }
            }
            j = j + 1;
        }
        return score;
    }

    void CollectSpecs(Node n) {
        if (n == null) { return; }
        int saved = EnterEnvNg(n);
        CollectSpecsInEnvNg(n);
        locHead = saved;
    }

    void CollectSpecsInEnvNg(Node n) {
        if (n.kind == AK.MemberAccess() && n.sval2 != null && n.sval2 != ""
                && n.a != null && n.a.kind == AK.Ident()
                && KnownTyName(Undunder(n.sval2))) {
            // class-qualified static access through a concrete
            // instantiation: remember it so its statics get materialized
            RegisterInstCls(n.a.sval + "<" + Undunder(n.sval2) + ">");
        }
        if (n.kind == AK.Call() && n.a != null
                && (n.a.kind == AK.Ident() || n.a.kind == AK.MemberAccess())
                && n.d != null && n.d.kind == AK.TypeRef()
                && n.d.sval == "__typeargs") {
            string name = n.a.sval;
            List<string> args = new List<string>();
            // the parser parked the explicit instantiation on the call's d
            // slot as a TypeRef list
            int i = 0;
            while (i < n.d.kids.Count) {
                args.Add(TypeFullName(n.d.kids[i]));
                i = i + 1;
            }
            // the receiver scopes the overload set: instantiate the generic
            // the receiver's own chain declares. Only when the chain names
            // nothing does the global bare-name rule apply (extension
            // methods: db.Query<T> lives in another class) -- a same-named
            // method in an unrelated class (Com.Get vs Control.Get<T>) must
            // never be hijacked by the bare-name match.
            int odi = OwnedGenericDeclArityNg(n, name, n.kids.Count);
            if (odi < 0 && !ReceiverHasNameNg(n, name)) {
                bool extForm2 = n.a != null && n.a.kind == AK.MemberAccess()
                    && !(n.a.a != null && n.a.a.kind == AK.Ident()
                        && FindClass(n.a.a.sval) != null);
                List<int> gcs = MethCandsName(name);
                if (gcs != null) {
                    int gi = 0;
                    while (gi < gcs.Count) {
                        int gmi = gcs[gi];
                        if (methStat[gmi] != 2 && methStat[gmi] != 3 && HasTypeParams(methNodes[gmi])) {
                            int extra = extForm2 && methNodes[gmi].ival == 1 && methStat[gmi] == 1 ? 1 : 0;
                            if (ParamCount(methNodes[gmi]) == n.kids.Count + extra) { odi = gmi; break; }
                        }
                        gi = gi + 1;
                    }
                }
            }
            SpecRegister(name, args, n, odi);
        } else if (n.kind == AK.Call() && n.a != null
                && (n.a.kind == AK.Ident() || n.a.kind == AK.MemberAccess())
                && n.d == null
                && n.kids.Count > 0
                && TryPlanInferenceSpecNg(n)) {
            // un-annotated call: infer the type parameters from the
            // arguments (gen0's inference) -- but only when the receiver's
            // own scope declares a generic of that name; a same-named
            // non-generic (JsonValue.Get(key), Com.Get) resolves normally,
            // and calls that infer nothing must FALL THROUGH to the
            // instantiated-class branches below.
            SpecRegister(n.a.sval, inferArgs, n, inferDi);
        } else if (n.a != null && n.a.kind == AK.MemberAccess() && n.a.a != null
                && n.a.a.kind == AK.Ident() && n.a.sval2 != null && n.a.sval2 != "") {
            // qualified static call on an instantiated generic class:
            // Stat<double>.F() -- specialize F for this instantiation
            string cinst = n.a.a.sval + "<" + Undunder(n.a.sval2) + ">";
            RegisterInstCls(cinst);
            SpecRegisterClass(cinst, n.a.sval, true, n);
        } else if (n.a != null && n.a.kind == AK.MemberAccess() && n.a.a != null
                && n.d == null) {
            // instance call on an instantiated generic receiver:
            // pc.Describe() with pc typed Pool<Conn>
            string rc = StaticTyOf(n.a.a);
            if (rc != null && rc.IndexOf("<") > 0) {
                Cls oc = FindClass(rc);
                if (oc != null && oc.tps.Count > 0) {
                    RegisterInstCls(rc);
                    SpecRegisterClass(rc, n.a.sval, false, n);
                }
            }
        }
        CollectSpecs(n.a);
        CollectSpecs(n.b);
        CollectSpecs(n.c);
        CollectSpecs(n.d);
        int ki = 0;
        while (ki < n.kids.Count) { CollectSpecs(n.kids[ki]); ki = ki + 1; }
    }

    void RunSpecPipeline() {
        // process the worklist: each appended spec's body is scanned for
        // further explicit-generic calls until fixpoint. A light locals
        // table (params + declarations) backs StaticTyOf during the scan,
        // so inference can read a call argument's type.
        int processed = 0;
        while (processed < methNodes.Count) {
            Node m = methNodes[processed];
            if (methStat[processed] != 3) {
                bool inst = methStat[processed] == 0 || methStat[processed] == 2;
                curCls = methCls[processed];
                specScanMeth = m;
                InitLocalsNg();
                if (inst) {
                    string thisTy = m.sval2 != null && m.sval2 != "" ? m.sval2 : curCls;
                    AddLoc("this", thisTy, false);
                }
                int pi = 0;
                while (pi < m.kids.Count) {
                    if (m.kids[pi].kind == AK.Param()) {
                        AddLoc(m.kids[pi].sval, TypeFullName(m.kids[pi].type), m.kids[pi].ival == 1);
                        if (locTy[nloc - 1] == "string") { locOpaq[nloc - 1] = 1; }
                    }
                    pi = pi + 1;
                }
                ReserveLocals(m.d);
                CollectSpecs(m);
            }
            processed = processed + 1;
        }
        specScanMeth = null;     // emission-time registrations must not see
                                 // a stale scan context
    }

}
