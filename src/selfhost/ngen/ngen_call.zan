using System;
using System.Collections.Generic;
namespace Zan;

partial class Ngen {

    // the type test half of `x is T` with the value already in x0: x0 <- 1
    // when it is a T, 0 otherwise. GenSwitchExpr peeks its pushed scrutinee
    // through here so arms share GenIs's exact matching rule (gen0's rule:
    // same-or-base statics answer non-null, strict downcasts and object/
    // interface sources consult the runtime site, and a heap string in the
    // slot carries the "ZANS" obj-8 tag the site walk never matches).
    void GenCall(Node e) {
        // Task.Spawn(<async call>) / Task.Run(<async call>) in a value
        // position: detach the coroutine, yield its handle (the statement
        // form is PrepareAsyncStmtNg's job and runs before this for ExprStmt)
        if (TryGenTaskSpawnValueNg(e)) { return; }
        // the pre-pass scans original bodies only; a call inside a
        // specialization body (the template's `SumNum<T>` after T bound to
        // int) would otherwise resolve to the OPEN generic template, whose
        // symbol is never emitted. The pre-pass's specMeth dedup makes the
        // second pass safe on original bodies.
        if (e.a != null && (e.a.kind == AK.Ident() || e.a.kind == AK.MemberAccess())) {
            CollectSpecsInEnvNg(e);
        }
        if (e.a != null && e.a.kind == AK.MemberAccess() && e.a.ival == 1) {
            // null-conditional call `a?.M(args)`: the receiver is tested
            // once; a null yields the null of the result type (a value
            // return wraps on the taken path). The ordinary call re-reads
            // the receiver -- fine for the suite's local receivers.
            Node qcal = e.a;
            string qrt = CallRetTy(e);
            GenExpr(qcal.a);                             // x0 = receiver
            int cqnull = NL();
            int cqfin = NL();
            CbzReg(0, cqnull);
            qcal.ival = 0;                               // ordinary call
            GenCall(e);
            qcal.ival = 1;
            if (qrt != null && IsNulableValueTy(qrt)) { GenNulWrap(IsDblTy(qrt)); }
            EmitB(cqfin);
            Mark(cqnull);
            LoadImm(0, 0);
            Mark(cqfin);
            return;
        }
        if (TryGenDelegateCall(e)) { return; }
        if (e.a != null && e.a.kind == AK.Ident() && e.a.sval == "sizeof"
                && e.kids.Count == 1) {
            // sizeof(T): the mapped type's store width (the oracle's
            // LLVMSizeOf -- char rides the i64 spelling, so 8); unknown
            // shapes answer the word size
            Node stk = e.kids[0];
            string stn = stk != null ? (stk.type != null ? TypeFullName(stk.type) : stk.sval) : "";
            LoadImm(0, SizeOfTyName(stn));
            return;
        }
        if (TryGenPackedSlice(e)) { return; }
        if (TryGenHostCall(e)) { return; }
        if (TryGenStringCall(e)) { return; }
        if (TryGenReflCall(e)) { return; }
        Node callee = e.a;
        if (callee != null && callee.kind == AK.MemberAccess()) {
            Node recv = callee.a;
            // nullable.GetValueOrDefault([fallback]): the payload when the
            // cell is set, else the fallback (0 / default(T))
            if (callee.sval == "GetValueOrDefault" && recv != null
                    && IsNulTy(StaticTyOf(recv))) {
                string gpay = NulPayOf(StaticTyOf(recv));
                GenExpr(recv);                           // x0 = cell
                int gnull = NL();
                int gend = NL();
                CbzReg(0, gnull);
                LdrU(0, 0, 0);                           // has: the payload
                if (IsDblTy(gpay)) { if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x6E, 0xC7); } else { E4(0x9E670000); } }   // fmov d0, x0
                EmitB(gend);
                Mark(gnull);
                if (e.kids.Count == 1) {
                    GenExpr(e.kids[0]);                  // null: the fallback
                    if (IsDblTy(gpay) && !IsDblExpr(e.kids[0])) { ConvI2D(); }
                } else {
                    LoadImm(0, 0);
                    if (IsDblTy(gpay)) { if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x6E, 0xC7); } else { E4(0x9E670000); } }   // fmov d0, x0
                }
                Mark(gend);
                return;
            }
            // Task-value members: t.Wait() pumps the driver until the frame
            // completes (and rethrows a captured exception, like Task.Wait);
            // t.Result waits and reads frame+32; t.IsCompleted answers the
            // done word. The null frame (an inline-run Task.Run body) is
            // already done with no result.
            if (recv != null) {
                string rtt = StaticTyOf(recv);
                if (rtt != null && (rtt == "Task" || rtt.IndexOf("Task<") == 0)
                        && (callee.sval == "Wait" || callee.sval == "Result"
                            || callee.sval == "IsCompleted")) {
                    GenExpr(recv);                       // x0 = frame handle
                    int tnull = NL();
                    int tend = NL();
                    if (callee.sval == "IsCompleted") {
                        CbzReg(0, tnull);
                        LdrU(0, 0, 8);                   // frame.done
                        if (tgt86 == 1) { X3(0x48, 0x83, 0xFF); X1(0x00); } else { E4(0xEB1F001F); }                  // cmp x0, xzr
                        if (tgt86 == 1) { X3(0x0F, 0x95, 0xC0); X3(0x48, 0x0F, 0xB6); X1(0xF8); } else { E4(0x9A9F07E0); }                  // cset x0, ne
                        EmitB(tend);
                        Mark(tnull);
                        LoadImm(0, 1);                   // null frame: done
                        Mark(tend);
                        return;
                    }
                    CbzReg(0, tnull);
                    XPushV0();                      // hold frame (receiver
                                                         //  must evaluate once)
                    AddImm(0, 0, 8);                     // x0 = &frame.done
                    LoadImm(1, 1);                       // mode 1: quiesce
                    BLInternal("_zan_co_sched_run_until");
                    PopV(9);                      // x9 = frame
                    if (callee.sval == "Result") {
                        AsyncSubExcCheckNg();            // Wait/Result rethrow
                        LdrU(0, 9, 32);                  // frame.result
                    }
                    EmitB(tend);
                    Mark(tnull);
                    LoadImm(0, 0);                       // null frame: inline-run
                                                         //  body, done, no result
                    Mark(tend);
                    return;
                }
            }
            // rect.GetLength(d): the dim lives at arr + 8*d in the mdarray
            // header (the rank>1 shape only)
            if (recv != null && callee.sval == "GetLength" && e.kids.Count == 1
                    && ArrContainerTy(recv) != null
                    && ArrRankOf(ArrContainerTy(recv)) > 1) {
                GenExpr(recv);                           // x0 = arr
                XPushV0();
                GenExpr(e.kids[0]);                      // x0 = dim
                XPopV(1);                          // pop arr -> x1
                E4(0xF8607820);                          // ldr x0, [x1, x0, lsl #3]
                return;
            }
            // arr.AsSpan([start[,len]]) / span.Slice(start[,len]): build the
            // boxed {base, len} view (see GenSpanView)
            if (recv != null && callee.sval == "AsSpan" && e.kids.Count <= 2
                    && ArrContainerTy(recv) != null) {
                GenSpanView(e, recv, ArrContainerTy(recv), false);
                return;
            }
            if (recv != null && callee.sval == "Slice" && e.kids.Count >= 1
                    && e.kids.Count <= 2 && SpanContainerTy(recv) != null) {
                GenSpanView(e, recv, SpanContainerTy(recv), true);
                return;
            }
            // base.Method(args): invoke the nearest implementation above
            // curCls directly (nonvirtual) with `this` as the receiver
            if (TryGenBaseCallNg(e, callee, recv)) { return; }
            if (recv != null && recv.kind == AK.Ident() && recv.sval == "Console"
                    && !UserDefinesClsMember("Console", callee.sval)
                    && callee.sval == "WriteLine" && e.kids.Count == 1) {
                // own runtime core: print_int(i64) / println(str)
                if (IsStrExpr(e.kids[0])) {
                    GenExpr(e.kids[0]);
                    BLInternal("_zan_rt_println");
                } else if (IsCharExpr(e.kids[0])) {
                    GenExpr(e.kids[0]);
                    BLInternal("_zan_rt_chrstr");
                    BLInternal("_zan_rt_println");
                } else if (IsBoolExpr(e.kids[0])) {
                    // gen0 prints bools as true/false (select of literals)
                    GenExpr(e.kids[0]);
                    int fls = NL();
                    int doneb = NL();
                    CbzReg(0, fls);
                    LoadStr(InternStr("true"), 0);
                    EmitB(doneb);
                    Mark(fls);
                    LoadStr(InternStr("false"), 0);
                    Mark(doneb);
                    BLInternal("_zan_rt_println");
                } else if (IsDblExpr(e.kids[0])) {
                    GenExpr(e.kids[0]);
                    if (tgt86 != 1) { E4(0x9E670000); }  // fmov d0, x0 (x86 keeps the bits in rdi)
                    BLExtern("_zan_rt_print_double");
                } else if (IsUlongExpr(e.kids[0])) {
                    GenExpr(e.kids[0]);
                    BLInternal("_zan_rt_print_uint");
                } else if (IsNulExpr(e.kids[0])
                        && NulPayOf(StaticTyOf(e.kids[0])) != null) {
                    // a nullable value prints its payload, or an empty line
                    // when null (gen0's Nullable.ToString())
                    Node w0 = e.kids[0];
                    string wpay = NulPayOf(StaticTyOf(w0));
                    GenExpr(w0);                         // x0 = cell
                    int wnull = NL();
                    int wend = NL();
                    CbzReg(0, wnull);                    // null: empty line
                    LdrU(0, 0, 0);                       // payload
                    if (IsDblTy(wpay)) {
                        if (tgt86 != 1) { E4(0x9E670000); }   // fmov d0, x0 (x86 keeps the bits in rdi)
                        BLExtern("_zan_rt_print_double");
                    } else if (wpay == "char") {
                        BLInternal("_zan_rt_chrstr");
                        BLInternal("_zan_rt_println");
                    } else if (wpay == "ulong") {
                        BLInternal("_zan_rt_print_uint");
                    } else {
                        BLInternal("_zan_rt_print_int");
                    }
                    EmitB(wend);
                    Mark(wnull);
                    LoadStr(InternStr(""), 0);
                    BLInternal("_zan_rt_println");
                    Mark(wend);
                } else {
                    GenExpr(e.kids[0]);
                    BLInternal("_zan_rt_print_int");
                }
                return;
            }
            // Console.WriteLine() with no arguments prints just the newline
            if (recv != null && recv.kind == AK.Ident() && recv.sval == "Console"
                    && !UserDefinesClsMember("Console", callee.sval)
                    && callee.sval == "WriteLine" && e.kids.Count == 0) {
                LoadStr(InternStr(""), 0);
                BLInternal("_zan_rt_println");
                return;
            }
            // Console.Write: no newline; gen0 routes every argument type
            // through its string form and printf("%s", s)
            if (recv != null && recv.kind == AK.Ident() && recv.sval == "Console"
                    && !UserDefinesClsMember("Console", callee.sval)
                    && callee.sval == "Write" && e.kids.Count == 1) {
                Node arg = e.kids[0];
                if (IsStrExpr(arg)) { GenExpr(arg); }
                else if (IsCharExpr(arg)) {
                    GenExpr(arg); BLInternal("_zan_rt_chrstr");
                } else if (IsBoolExpr(arg)) {
                    GenExpr(arg);
                    int fls = NL();
                    int doneb = NL();
                    CbzReg(0, fls);
                    LoadStr(InternStr("true"), 0);
                    EmitB(doneb);
                    Mark(fls);
                    LoadStr(InternStr("false"), 0);
                    Mark(doneb);
                } else if (IsDblExpr(arg)) {
                    GenExpr(arg); BLInternal("_zan_rt_dbl2str");
                } else if (IsUlongExpr(arg)) {
                    GenExpr(arg); BLInternal("_zan_rt_uint2str");
                } else if (IsNulExpr(arg) && NulPayOf(StaticTyOf(arg)) != null) {
                    GenNulToStr(arg);                    // null renders ""
                } else {
                    GenExpr(arg); BLInternal("_zan_rt_int2str");
                }
                XPushV0();                      // push s (stack variadic)
                if (EnvTargetElf() == 1 || tgt86 == 1) {
                    LdrU(1, 31, 0);                  // 寄存器变参:SysV 第 2 参在 rsi
                                                     // (elf 臂同为寄存器变参 r1);
                                                     // arm64-darwin 变参在栈上,push 即可
                }
                LoadSymRef("l_.str." + fmtwIdx, 0);  // x0 = "%s"
                BLExtern("_printf");
                if (EnvTargetElf() == 0) {
                    AddSPImm(16, true);              // drop the Darwin stack slot
                }
                return;
            }
            // Math static methods. Integer forms: Abs is a negate and
            // Max/Min are a csel over a signed compare (gen0 lowers them
            // the same way for i64). Double forms call libm with the value
            // in d0 (Pow takes d0 + d1) and come back as the bit pattern
            // in x0.
            if (recv != null && recv.kind == AK.Ident() && recv.sval == "Math"
                    && !UserDefinesClsMember("Math", callee.sval)) {
                string mn = callee.sval;
                if (mn == "Abs" && e.kids.Count == 1) {
                    GenExpr(e.kids[0]);
                    if (IsDblExpr(e.kids[0])) {
                        DblLibm1("_fabs");
                    } else if (tgt86 == 1) { X3(0x48, 0xF7, 0xDF); }    // neg rdi
                    else {
                        E4(0xCB0003E0);                  // neg x0, x0
                    }
                    return;
                }
                if ((mn == "Max" || mn == "Min") && e.kids.Count == 2) {
                    if (IsDblExpr(e.kids[0]) || IsDblExpr(e.kids[1])) {
                        // both arguments move to d0/d1 only after BOTH are
                        // evaluated: GenExpr may call strtod (returning in
                        // d0) for lazy double literals, which would clobber
                        // a value parked in d0 early
                        GenExpr(e.kids[0]);
                        XPushV0();                  // push a
                        GenExpr(e.kids[1]);
                        XPopV(1);                        // pop a -> x1 (x0 = b)
                        if (tgt86 == 1) {
                            X3(0x66, 0x48, 0x0F); X2(0x6E, 0xCF);           // movq xmm1, rdi
                        } else { E4(0x9E670001); }       // fmov d1, x0
                        if (!IsDblExpr(e.kids[1])) {
                            if (tgt86 == 1) { X4(0x2A0F48F2); X1(0xCE); }   // cvtsi2sd xmm1, rsi
                            else { E4(0x9E620022); }     // scvtf d1, x1
                        }
                        MovRR(0, 1);                     // mov x0, x1
                        if (tgt86 == 1) {
                            X3(0x66, 0x48, 0x0F); X2(0x6E, 0xC7);           // movq xmm0, rdi
                        } else { E4(0x9E670000); }       // fmov d0, x0
                        if (!IsDblExpr(e.kids[0])) {
                            if (tgt86 == 1) { X4(0x2A0F48F2); X1(0xCF); }   // cvtsi2sd xmm0, rdi
                            else { E4(0x9E620020); }     // scvtf d0, x0
                        }
                        if (mn == "Max") { BLExtern("_fmax"); } else { BLExtern("_fmin"); }
                        if (tgt86 == 1) {
                            X3(0x66, 0x48, 0x0F); X2(0x7E, 0xC7);           // movq rdi, xmm0
                        } else { E4(0x9E660000); }       // fmov x0, d0
                    } else {
                        GenExpr(e.kids[0]);
                        XPushV0();                  // push a
                        GenExpr(e.kids[1]);
                        XPopV(1);                        // pop a -> x1 (x0 = b)
                        if (tgt86 == 1) {
                            Xop(0x39, 7, 6);             // cmp b, a (rdi-rsi; 编码 6=rsi, 1 是 rcx)
                            if (mn == "Max") { X4(0xFE4E0F48); }    // cmovle rdi, rsi (b<=a 取 a)
                            else { X4(0xFE4D0F48); }                // cmovge rdi, rsi (b>=a 取 a)
                        } else {
                            CmpRR(0, 1);              // cmp x0, x1
                            if (mn == "Max") { E4(0x9A81C000); } // csel x0, x0, x1, gt
                            else { E4(0x9A81B000); }         // csel x0, x0, x1, lt
                        }
                    }
                    return;
                }
                if (mn == "Sqrt" && e.kids.Count == 1) {
                    GenExpr(e.kids[0]);
                    DblLibm1("_sqrt");
                    return;
                }
                if (mn == "Floor" && e.kids.Count == 1) {
                    GenExpr(e.kids[0]);
                    DblLibm1("_floor");
                    return;
                }
                if (mn == "Ceiling" && e.kids.Count == 1) {
                    GenExpr(e.kids[0]);
                    DblLibm1("_ceil");
                    return;
                }
                // gen0 routes Sin/Cos/Tan/Log/Exp to libm (double -> double),
                // coercing integer arguments with sitofp
                if ((mn == "Sin" || mn == "Cos" || mn == "Tan" || mn == "Log" || mn == "Exp"
                        || mn == "Atan" || mn == "Asin" || mn == "Acos")
                        && e.kids.Count == 1) {
                    GenExpr(e.kids[0]);
                    if (!IsDblExpr(e.kids[0])) {
                        if (tgt86 == 1) { X4(0x2A0F48F2); X1(0xC7); } else { E4(0x9E620000); }                  // scvtf d0, x0
                        if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x7E, 0xC7); } else { E4(0x9E660000); }                  // fmov x0, d0
                    }
                    string lf = "_sin";
                    if (mn == "Cos") { lf = "_cos"; } else if (mn == "Tan") { lf = "_tan"; }
                    else if (mn == "Log") { lf = "_log"; } else if (mn == "Exp") { lf = "_exp"; }
                    else if (mn == "Atan") { lf = "_atan"; } else if (mn == "Asin") { lf = "_asin"; }
                    else if (mn == "Acos") { lf = "_acos"; }
                    DblLibm1(lf);
                    return;
                }
                // Math.Round(x[, digits]): rint(x * 10^d) / 10^d via libm
                // rint/pow (integer arguments coerce with sitofp, like gen0).
                // C# rounds to even (banker's) -- libm rint does that under the
                // default FP mode, libm round is away-from-zero (TASKS.md
                // A513).
                // No value may sit in a d-reg across a GenExpr call (lazy
                // double literals return theirs in d0), so both operands are
                // spilled first; the scale lives in callee-saved x19 across
                // the rint call since the divide needs it again (x is the
                // deepest stack slot, so a second spill copy would bury it).
                if (mn == "Round" && (e.kids.Count == 1 || e.kids.Count == 2)) {
                    GenExpr(e.kids[0]);
                    if (!IsDblExpr(e.kids[0])) {
                        if (tgt86 == 1) { X4(0x2A0F48F2); X1(0xC7); } else { E4(0x9E620000); }                  // scvtf d0, x0
                        if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x7E, 0xC7); } else { E4(0x9E660000); }                  // fmov x0, d0
                    }
                    if (e.kids.Count == 1) {
                        DblLibm1("_rint");
                        return;
                    }
                    XPushV0();                      // push x (bits)
                    GenExpr(e.kids[1]);
                    if (!IsDblExpr(e.kids[1])) {
                        if (tgt86 == 1) { X4(0x2A0F48F2); X1(0xC7); } else { E4(0x9E620000); }                  // scvtf d0, x0
                        if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x7E, 0xC7); } else { E4(0x9E660000); }                  // fmov x0, d0
                    }
                    XPushV0();                      // push digits (bits)
                    LoadImm(0, 4621819117588971520);     // 10.0 IEEE bits
                    XPopV(1);                      // pop digits -> x1 (x0 = 10.0)
                    if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x6E, 0xC7); } else { E4(0x9E670000); }                      // fmov d0, x0
                    if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x6E, 0xCE); } else { E4(0x9E670021); }                      // fmov d1, x1
                    BLExtern("_pow");
                    if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x7E, 0xC7); } else { E4(0x9E660000); }                      // fmov x0, d0 (scale)
                    MovRR(19, 0);                        // x19 = scale (call-preserved)
                    XPopV(0);                      // pop x -> x0
                    if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x6E, 0xC7); } else { E4(0x9E670000); }                      // fmov d0, x0 (d0 = x)
                    if (tgt86 == 1) { XGetV(19, 10); X3(0x66, 0x49, 0x0F); X2(0x6E, 0xCA); } else { E4(0x9E670261); }                      // fmov d1, x19 (d1 = scale)
                    if (tgt86 == 1) { X4(0xC1590FF2); } else { E4(0x1E600820); }                      // fmul d0, d1, d0 (x * scale)
                    if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x7E, 0xC7); } else { E4(0x9E660000); }                      // fmov x0, d0
                    DblLibm1("_rint");                  // rint(x * scale)
                    if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x6E, 0xC7); } else { E4(0x9E670000); }                      // fmov d0, x0 (rounded)
                    if (tgt86 == 1) { XGetV(19, 10); X3(0x66, 0x49, 0x0F); X2(0x6E, 0xCA); } else { E4(0x9E670261); }                      // fmov d1, x19 (scale)
                    if (tgt86 == 1) { X4(0xC15E0FF2); } else { E4(0x1E611800); }                      // fdiv d0, d0, d1
                    if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x7E, 0xC7); } else { E4(0x9E660000); }                      // fmov x0, d0
                    return;
                }
                if (mn == "Pow" && e.kids.Count == 2) {
                    // same ordering discipline as the double Max/Min path:
                    // no value may sit in d0 across a GenExpr call
                    GenExpr(e.kids[0]);
                    XPushV0();                      // push a
                    GenExpr(e.kids[1]);
                    XPopV(1);                      // pop a -> x1 (x0 = b)
                    if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x6E, 0xCF); } else { E4(0x9E670001); }                      // fmov d1, x0
                    MovRR(0, 1);                      // mov x0, x1
                    if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x6E, 0xC7); } else { E4(0x9E670000); }                      // fmov d0, x0
                    BLExtern("_pow");
                    if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x7E, 0xC7); } else { E4(0x9E660000); }                      // fmov x0, d0
                    return;
                }
                if (mn == "Atan2" && e.kids.Count == 2) {
                    GenExpr(e.kids[0]);
                    if (!IsDblExpr(e.kids[0])) {
                        if (tgt86 == 1) { X4(0x2A0F48F2); X1(0xC7); } else { E4(0x9E620000); }                  // scvtf d0, x0
                        if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x7E, 0xC7); } else { E4(0x9E660000); }                  // fmov x0, d0
                    }
                    XPushV0();                      // push y
                    GenExpr(e.kids[1]);
                    if (!IsDblExpr(e.kids[1])) {
                        if (tgt86 == 1) { X4(0x2A0F48F2); X1(0xC7); } else { E4(0x9E620000); }                  // scvtf d0, x0
                        if (tgt86 == 1) { X3(0x66, 0x48, 0x0F); X2(0x7E, 0xC7); } else { E4(0x9E660000); }                  // fmov x0, d0
                    }
                    XPopV(1);                      // pop y -> x1 (x0 = x)
