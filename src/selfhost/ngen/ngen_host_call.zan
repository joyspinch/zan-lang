using System;
using System.Collections.Generic;
namespace Zan;

partial class Ngen {
    bool TryGenHostCall(Node e) {
        if (HostStatic(e, "File", "ReadAllText", 1)) { HostCallArgs(e, "_zan_host_read"); return true; }
        if (HostStatic(e, "File", "WriteAllText", 2)) { HostCallArgs(e, "_zan_host_write"); return true; }
        if (HostStatic(e, "File", "Exists", 1)) { HostCallArgs(e, "_zan_host_exists"); return true; }
        if (HostStatic(e, "Environment", "ArgCount", 0)) { BLInternal("_zan_host_argc"); return true; }
        if (HostStatic(e, "Environment", "ArgAt", 1)) { HostCallArgs(e, "_zan_host_argat"); return true; }
        if (HostStatic(e, "Environment", "ExeDir", 0)) { BLInternal("_zan_host_exedir"); return true; }
        if (HostStatic(e, "Directory", "ListNames", 1)) { HostCallArgs(e, "_zan_host_dir"); return true; }
        // ---- System.IO.Path statics ----
        if (HostStatic(e, "Path", "GetFileName", 1)) { HostCallArgs(e, "_zan_ext_path_filename"); return true; }
        if (HostStatic(e, "Path", "GetExtension", 1)) { HostCallArgs(e, "_zan_ext_path_extension"); return true; }
        if (HostStatic(e, "Path", "GetDirectoryName", 1)) { HostCallArgs(e, "_zan_ext_path_dirname"); return true; }
        if (HostStatic(e, "Path", "GetFileNameWithoutExtension", 1)) { HostCallArgs(e, "_zan_ext_path_stem"); return true; }
        if (HostStatic(e, "Path", "ChangeExtension", 2)) { HostCallArgs(e, "_zan_ext_path_changeext"); return true; }
        if (HostStatic(e, "Path", "Combine", 2)) { HostCallArgs(e, "_zan_ext_path_combine"); return true; }
        if (HostStatic(e, "Path", "GetTempPath", 0)) { BLInternal("_zan_ext_path_temppath"); return true; }
        if (HostStatic(e, "Path", "HasExtension", 1)) {
            GenExpr(e.kids[0]);
            BLInternal("_zan_ext_path_extension");
            LoadStr(extEmpty, 1);
            BLExtern("_strcmp");
            int nz = NL(); CbnzReg(0, nz);
            LoadImm(0, 0);                         // ext == "": no extension
            int hFin = NL(); EmitB(hFin);
            Mark(nz);
            LoadImm(0, 1);
            Mark(hFin);
            return true;
        }
        // ---- System.DateTime statics ----
        if (HostStatic(e, "DateTime", "FromUnixSeconds", 1)) {
            HostGenI64Arg(e.kids[0]);
            BLInternal("_zan_dt_from_unix");
            return true;
        }
        if (HostStatic(e, "DateTime", "FromDate", 3)) { HostCallArgs(e, "_zan_dt_from_date"); return true; }
        if (HostStatic(e, "DateTime", "FromParts", 6)) { HostCallArgs(e, "_zan_dt_from_parts"); return true; }
        if (HostStatic(e, "DateTime", "DaysFromCivil", 3)) { HostCallArgs(e, "_zan_dt_dfc"); return true; }
        if (HostStatic(e, "DateTime", "IsLeapYear", 1)) { HostCallArgs(e, "_zan_dt_isleap"); return true; }
        if (HostStatic(e, "DateTime", "DaysInMonth", 2)) { HostCallArgs(e, "_zan_dt_daysinmonth"); return true; }
        // ---- DateTime instance accessors/formatting (stdlib class absent) ----
        if (e.a != null && e.a.kind == AK.MemberAccess() && e.a.a != null
                && FindClass("DateTime") == null
                && IsDateTimeMemberName(e.a.sval, e.kids.Count)
                && StaticTyOf(e.a.a) == "DateTime") {
            string mn = e.a.sval;
            int n = e.kids.Count;
            if (n == 0 && !UserDefinesClsMember("DateTime", mn)) {
                if (mn == "Year") { GenExpr(e.a.a); LdrU(0, 0, 8); return true; }
                if (mn == "Month") { GenExpr(e.a.a); LdrU(0, 0, 16); return true; }
                if (mn == "Day") { GenExpr(e.a.a); LdrU(0, 0, 24); return true; }
                if (mn == "Hour") { GenExpr(e.a.a); LdrU(0, 0, 32); return true; }
                if (mn == "Minute") { GenExpr(e.a.a); LdrU(0, 0, 40); return true; }
                if (mn == "Second") { GenExpr(e.a.a); LdrU(0, 0, 48); return true; }
                if (mn == "DayOfWeek") { GenExpr(e.a.a); LdrU(0, 0, 56); return true; }
                if (mn == "ToUnixSeconds") { GenExpr(e.a.a); LdrU(0, 0, 0); return true; }
                if (mn == "ToString") { GenExpr(e.a.a); BLInternal("_zan_dt_tostring"); return true; }
                if (mn == "ToDateString") { GenExpr(e.a.a); BLInternal("_zan_dt_todatestring"); return true; }
                if (mn == "ToTimeString") { GenExpr(e.a.a); BLInternal("_zan_dt_totimestring"); return true; }
            }
            if (n == 1 && !UserDefinesClsMember("DateTime", mn)) {
                if (mn == "AddSeconds") { GenDtAdd(e.a.a, e.kids[0], 1); return true; }
                if (mn == "AddMinutes") { GenDtAdd(e.a.a, e.kids[0], 60); return true; }
                if (mn == "AddHours") { GenDtAdd(e.a.a, e.kids[0], 3600); return true; }
                if (mn == "AddDays") { GenDtAdd(e.a.a, e.kids[0], 86400); return true; }
                if (mn == "Equals" || mn == "IsBefore" || mn == "IsAfter") {
                    GenExpr(e.a.a); LdrU(0, 0, 0);      // this.epoch
                    ExtPush(0);
                    GenExpr(e.kids[0]); LdrU(0, 0, 0);  // other.epoch
                    MovRR(1, 0);
                    ExtPop(0);
                    HostCmp(0, 1);
                    int rT = NL(); int cmpFin = NL();
                    EmitBcond(mn == "Equals" ? 0 : (mn == "IsBefore" ? 11 : 12), rT);
                    LoadImm(0, 0); EmitB(cmpFin);
                    Mark(rT);
                    LoadImm(0, 1);
                    Mark(cmpFin);
                    return true;
                }
            }
        }
        // ---- threading / process / environment statics ----
        if (HostStatic(e, "Thread", "Sleep", 1)) {
            GenExpr(e.kids[0]);                  // ms
            LoadImm(1, 1000);
            SdivRR(2, 0, 1);                      // sdiv x2, x0, x1   tv_sec
            if (tgt86 == 1) {
                // v3 家=rcx:rcx = (ms - sec*1000) * 1e6 = tv_nsec
                X3(0x49, 0x89, 0xD3);            // mov r11, rdx(sec)
                X3(0x4D, 0x0F, 0xAF); X1(0xD3);  // imul r11, rsi
                X2(0x48, 0x89); X1(0xF9);        // mov rcx, rdi(ms)
                X3(0x49, 0x29, 0xD9);            // sub rcx, r11
                LoadImm(1, 1000000);
                X3(0x48, 0x0F, 0xAF); X1(0xF1);  // imul rcx, rsi
                XPushR(3);                        // push rcx(nsec 到高址)
                XPushR(2);                        // push rdx(sec 在 [rsp])——timespec {sec,nsec} 顺序
            } else {
                E4(0x9B018043);                  // msub x3, x2, x1, x0  ms%1000
                LoadImm(1, 1000000);
                E4(0x9B017C63);                  // mul x3, x3, x1    tv_nsec
                E4(0xA9BF0FE2);                  // stp x2, x3, [sp, #-0x10]! (contiguous timespec)
            }
            AddImm(0, 31, 0);                    // x0 = sp
            LoadImm(1, 0);                       // rem = NULL
            BLExtern("_nanosleep");
            AddSPImm(16, true);
            return true;
        }
        if (HostStatic(e, "ProcessList", "SelfPid", 0)) { BLExtern("_getpid"); return true; }
        if (HostStatic(e, "Interop", "getenv", 1)) {
            GenExpr(e.kids[0]);
            // raw libc result: null when unset (the null test is the API)
            BLExtern("_getenv");
            return true;
        }
        if (HostStatic(e, "KnownFolders", "Home", 0)) {
            LoadStr(ioHome, 0);
            BLInternal("_zan_ext_getenv");
            return true;
        }
        if (HostStatic(e, "KnownFolders", "Temp", 0)) {
            // oracle order: TEMP -> TMP -> TMPDIR -> /tmp (POSIX)
            LoadStr(ioTemp, 0); BLInternal("_zan_ext_getenv");
            ExtLenOf(0, 9);
            int tDone = NL(); CbnzReg(9, tDone);
            LoadStr(ioTmp, 0); BLInternal("_zan_ext_getenv");
            ExtLenOf(0, 9);
            CbnzReg(9, tDone);
            LoadStr(ioTmpdir, 0); BLInternal("_zan_ext_getenv");
            ExtLenOf(0, 9);
            CbnzReg(9, tDone);
            LoadStr(ioSlashTmp, 0);
            int tFin = NL(); EmitB(tFin);
            Mark(tDone);
            return true;
        }
        if (HostStatic(e, "KnownFolders", "AppData", 0)) {
            // XDG_CONFIG_HOME, else $HOME + "/.config"
            LoadStr(ioXdgCfg, 0); BLInternal("_zan_ext_getenv");
            ExtLenOf(0, 9);
            int aFin = NL(); int aEmpty = NL();
            CbnzReg(9, aFin);
            LoadStr(ioHome, 0); BLInternal("_zan_ext_getenv");
            ExtLenOf(0, 9);
            CbzReg(9, aEmpty);
            ExtPush(0);
            LoadStr(ioDotConfig, 0);
            ExtMov(1, 0);
            ExtPop(0);
            BLInternal("_zan_ext_path_combine");
            EmitB(aFin);
            Mark(aEmpty);
            LoadStr(extEmpty, 0);
            Mark(aFin);
            return true;
        }
        if (HostStatic(e, "KnownFolders", "GetEnv", 1)) {
            GenExpr(e.kids[0]);
            BLInternal("_zan_ext_getenv");
            return true;
        }
        if (HostStatic(e, "KnownFolders", "SetEnv", 2)) {
            GenExpr(e.kids[0]); ExtPush(0);
            GenExpr(e.kids[1]); ExtPush(0);
            ExtPop(1);                           // value
            ExtPop(0);                           // name
            ExtLenOf(1, 9);
            int sUnset = NL(); CbzReg(9, sUnset);
            int sFin = NL();
            LoadImm(2, 1);                       // overwrite = 1
            BLExtern("_setenv");
            EmitB(sFin);
            Mark(sUnset);
            BLExtern("_unsetenv");
            Mark(sFin);
            LoadImm(0, 0);
            return true;
        }
        if (HostStatic(e, "KnownFolders", "Expand", 1)) {
            GenExpr(e.kids[0]);
            BLInternal("_zan_ext_expand");
            return true;
        }
        // ---- file system statics ----
        if (HostStatic(e, "Directory", "Exists", 1)) {
            GenExpr(e.kids[0]);
            BLInternal("_zan_host_direxists");
            return true;
        }
        if (HostStatic(e, "Directory", "CreateDirectory", 1)) {
            GenExpr(e.kids[0]);
            LoadImm(1, 511);                     // 0o777, umask applies
            BLExtern("_mkdir");
            LoadImm(0, 0);
            return true;
        }
        if (HostStatic(e, "Directory", "Delete", 1)) {
            GenExpr(e.kids[0]);
            BLExtern("_rmdir");
            LoadImm(0, 0);
            return true;
        }
        if (HostStatic(e, "File", "Delete", 1)) {
            GenExpr(e.kids[0]);
            BLExtern("_unlink");
            LoadImm(0, 0);
            return true;
        }
        if (HostStatic(e, "Directory", "GetFileNames", 1)) {
            GenExpr(e.kids[0]);
            BLInternal("_zan_host_getfiles");
            return true;
        }
        if (HostStatic(e, "Directory", "GetDirectories", 1)) {
            GenExpr(e.kids[0]);
            BLInternal("_zan_host_getdirs");
            return true;
        }
        // full-path variants and the recursive create/delete pair
        if (HostStatic(e, "Directory", "GetPaths", 1)) {
            GenExpr(e.kids[0]);
            BLInternal("_zan_dir_getpaths");
            return true;
        }
        if (HostStatic(e, "Directory", "GetFiles", 1)) {
            GenExpr(e.kids[0]);
            BLInternal("_zan_dir_getpaths");
            return true;
        }
        if (HostStatic(e, "Directory", "GetDirectoryPaths", 1)) {
            GenExpr(e.kids[0]);
            BLInternal("_zan_dir_getdirpaths");
            return true;
        }
        if (HostStatic(e, "Directory", "CreateDirectoryRecursive", 1)) {
            GenExpr(e.kids[0]);
            BLInternal("_zan_dir_mkdirs");
            return true;
        }
        if (HostStatic(e, "Directory", "DeleteRecursive", 1)) {
            GenExpr(e.kids[0]);
            BLInternal("_zan_dir_delrec");
            return true;
        }
        // ---- Stopwatch statics ----
        if (HostStatic(e, "Stopwatch", "Frequency", 0)) {
            LoadImm(0, 1000000000);              // clock_gettime nanoseconds
            return true;
        }
        if (HostStatic(e, "Stopwatch", "GetMilliseconds", 0)) {
            BLInternal("_zan_host_mono_ms");
            return true;
        }
        // ---- Semaphore (GCD dispatch on macOS, per the stdlib) ----
        if (HostStatic(e, "Semaphore", "Create", 2)) {
            GenExpr(e.kids[0]);                  // initial count
            LoadImm(1, 0);
            BLExtern("_dispatch_semaphore_create");
            return true;
        }
        if (HostStatic(e, "Semaphore", "Wait", 1)) {
            GenExpr(e.kids[0]);
            LoadImm(1, -1);                      // DISPATCH_TIME_FOREVER
            BLExtern("_dispatch_semaphore_wait");
            return true;
        }
        if (HostStatic(e, "Semaphore", "Release", 1)) {
            GenExpr(e.kids[0]);
            BLExtern("_dispatch_semaphore_signal");
            return true;
        }
        if (HostStatic(e, "Semaphore", "Destroy", 1)) {
            GenExpr(e.kids[0]);
            BLExtern("_dispatch_release");
            return true;
        }
        // ---- Stopwatch / Timer / FileInfo instance members ----
        if (HostInst(e, "Stopwatch", "Start", 0)) {
            GenExpr(e.a.a); BLInternal("_zan_host_sw_start"); return true;
        }
        if (HostInst(e, "Stopwatch", "Stop", 0)) {
            GenExpr(e.a.a); BLInternal("_zan_host_sw_stop"); return true;
        }
        if (HostInst(e, "Stopwatch", "Reset", 0)) {
            GenExpr(e.a.a); BLInternal("_zan_host_sw_reset"); return true;
        }
        if (HostInst(e, "Stopwatch", "ElapsedMilliseconds", 0)) {
            GenExpr(e.a.a); BLInternal("_zan_host_sw_elapsed"); return true;
        }
        if (HostInst(e, "Timer", "Start", 0)) {
            GenExpr(e.a.a);                      // x0 = timer
            if (tgt86 == 1) { X3(0x48, 0x63, 0x07); }       // movsxd rax,dword [rdi]
            else { E4(0xB9800009); }             // ldrsw x9, [x0]  interval
            ExtCmpImm(9, 1);
            int tmBad = NL(); EmitBcond(11, tmBad);   // interval < 1 -> false
            LdrU(9, 0, 16);
            int tmOk = NL(); CbnzReg(9, tmOk);        // already running -> true
            LoadImm(9, 1);
            StrU(9, 0, 16);                      // running = 1
            ExtPush(0);                          // timer for the arg slot
            AddImm(0, 0, 24);                    // x0 = &timer->pthread
            LoadImm(1, 0);                       // attr
            LoadSymRef("_zan_host_timer_thread", 2);
            ExtPop(3);                           // x3 = timer
            BLExtern("_pthread_create");
            LoadImm(0, 1);
            int tmFin = NL(); EmitB(tmFin);
            Mark(tmBad);
            LoadImm(0, 0);
            EmitB(tmFin);
            Mark(tmOk);
            LoadImm(0, 1);
            Mark(tmFin);
            return true;
        }
        if (HostInst(e, "Timer", "Stop", 0)) {
            GenExpr(e.a.a);
            LoadImm(9, 0);
            StrU(9, 0, 16);                      // running = 0
            return true;
        }
        if (HostInst(e, "FileInfo", "Exists", 0)) {
            GenExpr(e.a.a); LdrU(0, 0, 0);
            BLInternal("_zan_host_fattr");
            LoadImm(1, 0);
            HostCmp(0, 1);
            int feT = NL(); int feFin = NL();
            EmitBcond(10, feT);                  // b.ge attr >= 0
            LoadImm(0, 0); EmitB(feFin);
            Mark(feT); LoadImm(0, 1);
            Mark(feFin);
            return true;
        }
        if (HostInst(e, "FileInfo", "Length", 0)) {
            GenExpr(e.a.a); LdrU(0, 0, 0);
            BLInternal("_zan_host_flength");
            return true;
        }
        if (HostInst(e, "FileInfo", "IsDirectory", 0)) {
            GenExpr(e.a.a); LdrU(0, 0, 0);
            BLInternal("_zan_host_fattr");
            ExtUbfmR(0, 0, 2, 2);                // attribute bit 2
            return true;
        }
        if (HostInst(e, "FileInfo", "IsReadOnly", 0)) {
            GenExpr(e.a.a); LdrU(0, 0, 0);
            BLInternal("_zan_host_fattr");
            ExtUbfmR(0, 0, 0, 0);                // attribute bit 0
            return true;
        }
        if (HostInst(e, "FileInfo", "LastWriteTime", 0)) {
            GenExpr(e.a.a); LdrU(0, 0, 0);
            LoadImm(1, 0);
            BLInternal("_zan_host_ftime");
            return true;
        }
        if (HostInst(e, "FileInfo", "CreationTime", 0)) {
            GenExpr(e.a.a); LdrU(0, 0, 0);
            LoadImm(1, 1);
            BLInternal("_zan_host_ftime");
            return true;
        }
        if (HostInst(e, "FileInfo", "FullName", 0)) {
            GenExpr(e.a.a); LdrU(0, 0, 0);
            return true;
        }
        if (HostInst(e, "FileInfo", "NewerThan", 1)) {
            GenExpr(e.a.a); LdrU(0, 0, 0);       // obj.path
            ExtPush(0);
            GenExpr(e.kids[0]);
            MovRR(1, 0);
            ExtPop(0);
            BLInternal("_zan_host_fnewer");
            return true;
        }
        if (HostInst(e, "FileInfo", "SetReadOnly", 1)) {
            GenExpr(e.a.a); LdrU(0, 0, 0);       // obj.path
            ExtPush(0);
            GenExpr(e.kids[0]);
            MovRR(1, 0);
            ExtPop(0);
            BLInternal("_zan_host_setreadonly");
            return true;
        }
        if (HostStatic(e, "FileInfo", "GetLength", 1)) {
            GenExpr(e.kids[0]);
            BLInternal("_zan_host_flength");
            return true;
        }
        if (HostStatic(e, "FileInfo", "GetLastWriteTime", 1)) {
            GenExpr(e.kids[0]);
            LoadImm(1, 0);
            BLInternal("_zan_host_ftime");
            return true;
        }
        // ---- dynamic library loading (System.Interop) ----
        if (HostStatic(e, "Interop", "Load", 1)) {
            GenExpr(e.kids[0]);
            LoadImm(1, 1);                         // RTLD_LAZY
            BLExtern("_dlopen");                   // 0 handle when missing
            return true;
        }
        if (HostStatic(e, "Interop", "Symbol", 2)) {
            GenExpr(e.kids[0]); ExtPush(0);
            GenExpr(e.kids[1]); ExtPush(0);
            ExtPop(1);                             // x1 = symbol name
            ExtPop(0);                             // x0 = module handle
            int symFin = NL(); int symNull = NL();
            CbzReg(0, symNull);                    // null handle resolves to 0
            BLExtern("_dlsym");
            EmitB(symFin);
            Mark(symNull);
            LoadImm(0, 0);
            Mark(symFin);
            return true;
        }
        if (HostStatic(e, "Interop", "LastError", 0)) {
            BLInternal("_zan_host_dlerror_str");   // owned "" when no error
            return true;
        }
        if (HostStatic(e, "Interop", "Unload", 1)) {
            GenExpr(e.kids[0]);
            int unlFin = NL();
            CbzReg(0, unlFin);                     // null handle is a no-op
            BLExtern("_dlclose");
            Mark(unlFin);
            LoadImm(0, 0);
            return true;
        }
        // ---- raw memory intrinsics ----
        if (HostStatic(e, "NativeMemory", "Alloc", 1)) {
            HostGenI64Arg(e.kids[0]);
            BLExtern("_malloc");
            return true;
        }
        if (HostStatic(e, "NativeMemory", "Free", 1)) {
            GenExpr(e.kids[0]);
            BLExtern("_free");
            LoadImm(0, 0);
            return true;
        }
        if (HostStatic(e, "NativeMemory", "PutString", 4)) {
            GenExpr(e.kids[0]); ExtPush(0);        // dst
            GenExpr(e.kids[1]); ExtPush(0);        // offset
            GenExpr(e.kids[2]); ExtPush(0);        // source string
            GenExpr(e.kids[3]); ExtPush(0);        // count
            ExtPop(3); ExtPop(2); ExtPop(1); ExtPop(0);
            AddRR(0, 0, 1);                        // dst + offset
            MovRR(1, 2);
            MovRR(2, 3);
            BLExtern("_memcpy");
            LoadImm(0, 0);
            return true;
        }
        if (HostStatic(e, "NativeMemory", "GetString", 3)) {
            GenExpr(e.kids[0]); ExtPush(0);
            GenExpr(e.kids[1]); ExtPush(0);
            GenExpr(e.kids[2]); ExtPush(0);
            ExtPop(2); ExtPop(1); ExtPop(0);
            BLInternal("_zan_nm_getstring");
            return true;
        }
        if (HostStatic(e, "NativeMemory", "Sha256", 2)) {
            GenExpr(e.kids[0]); ExtPush(0);
            GenExpr(e.kids[1]); ExtPush(0);
            ExtPop(1); ExtPop(0);
            BLInternal("_zan_nm_sha256");
            return true;
        }
        // FindNotAnyOf(p, off, rejectSet, n) -> strcspn(p + off, rejectSet),
        // offset of the first byte in the reject set relative to p, or -1
        // when the window holds none (oracle irgen_expr.c:785; the reject
        // set is a literal blob whose payload carries its own NUL)
        if (HostStatic(e, "NativeMemory", "FindNotAnyOf", 4)) {
            GenExpr(e.kids[0]); ExtPush(0);        // p (nint)
            GenExpr(e.kids[1]); ExtPush(0);        // offset
            GenExpr(e.kids[2]); ExtPush(0);        // reject set
            GenExpr(e.kids[3]); ExtPush(0);        // limit n
            ExtPop(3); ExtPop(2); ExtPop(1); ExtPop(0);
            AddRR(0, 0, 1);                        // start = p + off
            MovRR(1, 2);                           // x1 = reject set
            ExtPush(3);                            // keep n across the call
            BLExtern("_strcspn");                  // x0 = run (stops at NUL)
            ExtPop(1);                             // x1 = n
            ExtMov(2, 0);                          // x2 = run
            if (tgt86 == 1) { Xop(0x39, 2, 6); } else { E4(0xEB01005F); }                        // cmp x2, x1 (unsigned)
            int clean = NL(); int done2 = NL();
            EmitBcond(2, clean);                   // b.hs clean: run >= n
            EmitB(done2);                          // hit: x0 = run
            Mark(clean);
            if (tgt86 == 1) { XLoadImm(0, -1); } else { E4(0x92800000); }                        // movn x0, #0 (-1)
            Mark(done2);
            return true;
        }
        // Copy(dst, src, n) -> memmove (overlap-safe by contract)
        if (HostStatic(e, "NativeMemory", "Copy", 3)) {
            GenExpr(e.kids[0]); ExtPush(0);
            GenExpr(e.kids[1]); ExtPush(0);
            GenExpr(e.kids[2]); ExtPush(0);
            ExtPop(2); ExtPop(1); ExtPop(0);
            BLExtern("_memmove");
            LoadImm(0, 0);
            return true;
        }
        // Fill(p, v, n) -> memset; v contributes its low 8 bits
        if (HostStatic(e, "NativeMemory", "Fill", 3)) {
            GenExpr(e.kids[0]); ExtPush(0);
            GenExpr(e.kids[1]); ExtPush(0);
            GenExpr(e.kids[2]); ExtPush(0);
            ExtPop(2); ExtPop(1); ExtPop(0);
            BLExtern("_memset");
            LoadImm(0, 0);
            return true;
        }
        // Compare(a, b, n) -> memcmp; the sign is the result, so sext
        if (HostStatic(e, "NativeMemory", "Compare", 3)) {
            GenExpr(e.kids[0]); ExtPush(0);
            GenExpr(e.kids[1]); ExtPush(0);
            GenExpr(e.kids[2]); ExtPush(0);
            ExtPop(2); ExtPop(1); ExtPop(0);
            BLExtern("_memcmp");
            Sxtw0();                        // sxtw x0, w0
            return true;
        }
        // Find(p, off, b, n) -> memchr(p + off, b, n) reported as an offset
        // from p (resumable), or -1 when the byte is absent
        if (HostStatic(e, "NativeMemory", "Find", 4)) {
            GenExpr(e.kids[0]); ExtPush(0);
            GenExpr(e.kids[1]); ExtPush(0);
            GenExpr(e.kids[2]); ExtPush(0);
            GenExpr(e.kids[3]); ExtPush(0);
            ExtPop(3); ExtPop(2); ExtPop(1); ExtPop(0);
            ExtPush(0);                            // keep p across the call
            AddRR(0, 0, 1);                        // start = p + off
            MovRR(1, 2);                           // x1 = b
            MovRR(2, 3);                           // x2 = n
            BLExtern("_memchr");                   // x0 = hit or 0
            ExtPop(1);                             // x1 = p
            int fHit = NL(); int fMiss = NL();
            CbzReg(0, fMiss);
            E4(0xCB010000);                        // sub x0, x0, x1 (hit - p)
            EmitB(fHit);
            Mark(fMiss);
            if (tgt86 == 1) { XLoadImm(0, -1); } else { E4(0x92800000); }                        // movn x0, #0 (-1)
            Mark(fHit);
            return true;
        }
        // ScanNotAnyOf(p, off, acceptSet, n) -> strspn(p + off, accept),
        // the leading run of accepted bytes clamped to the window
        if (HostStatic(e, "NativeMemory", "ScanNotAnyOf", 4)) {
            GenExpr(e.kids[0]); ExtPush(0);
            GenExpr(e.kids[1]); ExtPush(0);
            GenExpr(e.kids[2]); ExtPush(0);
            GenExpr(e.kids[3]); ExtPush(0);
            ExtPop(3); ExtPop(2); ExtPop(1); ExtPop(0);
            AddRR(0, 0, 1);                        // start = p + off
            MovRR(1, 2);                           // x1 = accept set
            ExtPush(3);                            // keep n across the call
            BLExtern("_strspn");                   // x0 = run (stops at NUL)
            ExtPop(1);                             // x1 = n
            ExtMov(2, 0);                          // x2 = run
            if (tgt86 == 1) { Xop(0x39, 2, 6); } else { E4(0xEB01005F); }                        // cmp x2, x1 (unsigned)
            int sOver = NL(); int sDone = NL();
            EmitBcond(8, sOver);                   // b.hi run > n
            EmitB(sDone);
            Mark(sOver);
            MovRR(0, 1);                           // clamp to n
            Mark(sDone);
            return true;
        }
        // ScanNotByte(p, off, b, n) -> strspn(p + off, {b, 0}); the 2-byte
        // NUL-terminated set is built on the stack per call (b == 0 would
        // make an empty set, which callers never do)
        if (HostStatic(e, "NativeMemory", "ScanNotByte", 4)) {
            GenExpr(e.kids[0]); ExtPush(0);
            GenExpr(e.kids[1]); ExtPush(0);
            GenExpr(e.kids[2]); ExtPush(0);
            GenExpr(e.kids[3]); ExtPush(0);
            ExtPop(3); ExtPop(2); ExtPop(1); ExtPop(0);
            ExtPush(3);                            // keep n
            AddRR(0, 0, 1);                        // start = p + off
            ExtPush(0);                            // keep start
            AddSPImm(16, false);                   // set buffer below sp
            E4(0x390003E2);                        // strb w2, [sp]      (set[0] = b)
            E4(0x390007FF);                        // strb wzr, [sp, #1] (set[1] = NUL)
            AddImm(1, 31, 0);                      // x1 = &set
            BLExtern("_strspn");                   // x0 = run
            AddSPImm(16, true);                    // free the set
            ExtPop(1);                             // x1 = start
            ExtPop(2);                             // x2 = n
            ExtMov(3, 0);                          // x3 = run
            E4(0xEB02007F);                        // cmp x3, x2 (unsigned)
            int bOver = NL(); int bDone = NL();
            EmitBcond(8, bOver);                   // b.hi run > n
            EmitB(bDone);
            Mark(bOver);
            MovRR(0, 2);                           // clamp to n
            Mark(bDone);
            return true;
        }
        // Load64(p, off) -> the unaligned 8-byte load at p + off (the SWAR
        // primitive; callers own the bounds check)
        if (HostStatic(e, "NativeMemory", "Load64", 2)) {
            GenExpr(e.kids[0]); ExtPush(0);
            GenExpr(e.kids[1]); ExtPop(1);
            AddRR(0, 0, 1);                        // addr = p + off
            LdrU(0, 0, 0);                         // *addr
            return true;
        }
        // AsI64(d) / AsF64(v) / AsI32(f) / AsF32(v): pure bit reinterprets -- scalars already ride
        // x0 as raw patterns, so only the ret spelling changes
        if (HostStatic(e, "NativeMemory", "AsI64", 1)
                || HostStatic(e, "NativeMemory", "AsF64", 1)
                || HostStatic(e, "NativeMemory", "AsI32", 1)
                || HostStatic(e, "NativeMemory", "AsF32", 1)) {
            GenExpr(e.kids[0]);
            return true;
        }
        // ---- current working directory ----
        if (HostStatic(e, "Directory", "GetCurrentDirectory", 0)) {
            BLInternal("_zan_host_getcwd");
            return true;
        }
        // ---- string statics: IsNullOrEmpty. The stamp word at ptr-8 is
        // magic|len, so only the low 32 bits are the length; a null string
        // counts as empty. ExtLenOf already handles both. ----
        if (HostStatic(e, "string", "IsNullOrEmpty", 1)
                || HostStatic(e, "String", "IsNullOrEmpty", 1)) {
            GenExpr(e.kids[0]);
            ExtLenOf(0, 0);                        // x0 = len (0 for null)
            ExtCmpImm(0, 0);
            int sneFin = NL();
            LoadImm(0, 1);
            EmitBcond(0, sneFin);                  // len == 0 -> true
            LoadImm(0, 0);
            Mark(sneFin);
            return true;
        }
        // ---- numeric TryParse: full-string decimal parse (strtoll
        // semantics); on failure the out slot receives 0 ----
        if (HostStatic(e, "int", "TryParse", 2)
                || HostStatic(e, "long", "TryParse", 2)) {
            GenRefArg(e.kids[1]);                  // x0 = out address
            ExtPush(0);
            GenExpr(e.kids[0]);                    // x0 = text
            ExtMov(1, 0);                          // x1 = text
            ExtPop(0);                             // x0 = out address
            BLInternal("_zan_host_int_tryparse");
            return true;
        }
        // ---- background threads over the delegate closure ABI ----
        if (HostStatic(e, "Thread", "Start", 1)) {
            GenExpr(e.kids[0]);                    // closure {thunk, env}
            ExtPush(0);
            LoadImm(0, 24); BLExtern("_malloc");   // {tid@0, thunk@8, env@16}
            ExtMov(9, 0);                          // block
            ExtPop(1);
            LdrU(2, 1, 0); StrU(2, 9, 8);          // thunk
            LdrU(2, 1, 8); StrU(2, 9, 16);         // env
            ExtMov(0, 9);                          // x0 = &tid
            LoadImm(1, 0);                         // attr
            LoadSymRef("_zan_host_thread_trampoline", 2);
            ExtMov(3, 9);                          // x3 = block
            BLExtern("_pthread_create");
            LoadImm(0, 1);                         // started
            return true;
        }
        if (HostStatic(e, "Thread", "CurrentId", 0)) {
            BLInternal("_zan_host_thread_id");
            return true;
        }
        // ---- AtomicInt instance members ----
        if (FindClass("AtomicInt") == null && e.a != null
                && e.a.kind == AK.MemberAccess() && e.a.a != null) {
            string an2 = e.a.sval;
            int an = e.kids.Count;
            if (!(an2 == "Load" || an2 == "Add" || an2 == "Increment"
                    || an2 == "Decrement" || an2 == "Exchange"
                    || an2 == "CompareExchange" || an2 == "Store")) { an2 = null; }
            if (an2 != null && HostAtomicRecvTy(e.a.a) != null
                    && !UserDefinesClsMember("AtomicInt", an2)) {
            if (an2 == "Load" && an == 0) {
                GenExpr(e.a.a);
                if (tgt86 == 1) { XopRMem(0x8B, 7, 7, 0); }   // mov rdi,[rdi](x86 TSO:普通 load 即 acquire)
                else { E4(0xC8DFFC00); }           // ldar x0, [x0]
                return true;
            }
            if (an2 == "Store" && an == 1) {
                GenExpr(e.a.a); ExtPush(0);
                GenExpr(e.kids[0]);
                MovRR(1, 0);
                ExtPop(0);
                if (tgt86 == 1) { XopMemR(0x89, 6, 7, 0); }   // mov [rdi],rsi(TSO:普通 store 即 release)
                else { E4(0xC89FFC01); }           // stlr x1, [x0]
                LoadImm(0, 0);
                return true;
            }
            if ((an2 == "Add" && an == 1) || ((an2 == "Increment"
                    || an2 == "Decrement") && an == 0)) {
                GenExpr(e.a.a); ExtPush(0);
                if (an2 == "Add") { HostGenI64Arg(e.kids[0]); }
                else { LoadImm(1, an2 == "Increment" ? 1 : 0 - 1); }
                MovRR(1, 0);
                ExtPop(0);
                if (tgt86 == 1) {
                    // lock xadd [rdi],rsi:[rdi]=old+addend,rsi=old(lock 前
                    // 缀自带全序,等价 ldaddal);新值回载 v0 即返回值
                    X1(0xF0); X2(0x48, 0x0F); X2(0xC1, 0x37);        // lock xadd [rdi],rsi
                    XopRMem(0x8B, 7, 7, 0);                           // mov rdi,[rdi](新值)
                } else {
                    E4(0xF8E10009);                // ldaddal x1, x9, [x0]
                    AddRR(0, 9, 1);                // Add/Increment return NEW
                }
                return true;
            }
            if (an2 == "Exchange" && an == 1) {
                GenExpr(e.a.a); ExtPush(0);
                GenExpr(e.kids[0]);
                MovRR(1, 0);
                ExtPop(0);
                if (tgt86 == 1) {
                    // xchg [rdi],rsi:rsi=old,[rdi]=new(x86 的内存 xchg 天
                    // 然带 lock 语义,等价 swpal)
                    X2(0x48, 0x87); X1(0x37);      // xchg [rdi],rsi
                    XMov(7, 6);                    // v0 = old
                } else {
                    E4(0xF8E18009);                // swpal x1, x9, [x0]
                    ExtMov(0, 9);                  // old value
                }
                return true;
            }
            if (an2 == "CompareExchange" && an == 2) {
                GenExpr(e.a.a); ExtPush(0);
                GenExpr(e.kids[0]); ExtPush(0);
                GenExpr(e.kids[1]); ExtPush(0);
                ExtPop(2);                         // x2 = desired
                ExtPop(1);                         // x1 = expected
                ExtPop(0);                         // x0 = object
                if (tgt86 == 1) {
                    // lock cmpxchg:RAX=expected,与 [rdi] 比对;RAX 总拿回
                    // old(不管成败)——casal 的返回契约
                    X2(0x48, 0x89); X1(0xF0);      // mov rax,rsi(expected)
                    X1(0xF0); X2(0x48, 0x0F); X2(0xB1, 0x17);   // lock cmpxchg [rdi],rdx
                    XMov(7, 0);                    // v0 = old
                } else {
                    E4(0xC8E1FC02);                // casal x1, x2, [x0]
                    ExtMov(0, 1);                  // old value
                }
                return true;
            }
            }
        }
        if (TryGenHostExtCall(e)) { return true; }
        if (e.a == null || e.a.kind != AK.MemberAccess()) { return false; }
        // name gate before HostIsBuilder: typing the receiver re-walks
        // fluent-chain prefixes at every level
        string name = e.a.sval;
        if (!(name == "ToString" || name == "Append" || name == "AppendLine")) { return false; }
        if (!HostIsBuilder(e.a.a)) { return false; }
        if (name == "ToString" && e.kids.Count == 0) {
            GenExpr(e.a.a); BLInternal("_zan_host_sb_string"); return true;
        }
        if ((name == "Append" && e.kids.Count == 1)
                || (name == "AppendLine" && e.kids.Count <= 1)) {
            GenExpr(e.a.a);
            if (e.kids.Count == 1) {
                // sb rides the stack across the length helper (and across
                // HostStringArg, which clobbers x0): the raw fallback's
                // strlen may trash caller-saved x0/x1.
                XPushV0();                    // push sb
                HostStringArg(e.kids[0]);
                MovRR(1, 0);                       // x1 = rendered
                BLInternal("_zan_host_sblen");     // x0 = byte length
                MovRR(2, 0);                       // x2 = len
                XPopV(0);                    // pop sb
                BLInternal("_zan_host_sb_append");
            }
            if (name == "AppendLine") {
                LoadStr(hostNL, 1);
                LoadImm(2, 1);
                BLInternal("_zan_host_sb_append");
            }
            return true;
        }
        diags.Error("ngen host: unsupported StringBuilder method or arity", e.line, e.col);
        return true;
    }

    // Runtime helpers use a fixed 128-byte frame; slots at sp+0..120.
    // Neither code nor flags rely on scratch register values after a BL.
}
