using System;
using System.Collections.Generic;
namespace Zan;

partial class Ngen {
    void HostEmitGetenv() {
        HostBegin("_zan_ext_getenv");
        HostSave(0, 0);
        BLExtern("_getenv");
        int isNull = NL(); CbzReg(0, isNull);    // unset -> ""
        HostSave(0, 1);
        BLExtern("_strlen");
        MovRR(1, 0);
        HostLoad(0, 1);
        BLInternal("_zan_host_copy");
        int fin = NL(); EmitB(fin);
        Mark(isNull);
        LoadStr(extEmpty, 0);
        Mark(fin);
        HostEnd();
    }

    // x0 = text -> $NAME (POSIX letter/digit/underscore run) substituted
    // from the process environment; missing or empty values keep the
    // literal token, matching KnownFolders.Expand in the stdlib.
    void HostEmitExpand() {
        HostBegin("_zan_ext_expand");
        HostSave(0, 0);                          // text
        LoadStr(extEmpty, 0);
        HostSave(0, 3);                          // result
        HostLoad(9, 0);
        ExtLenOf(9, 10);
        HostSave(10, 2);                         // len
        LoadImm(9, 0);
        HostSave(9, 1);                          // i
        int fin = NL(); int loop = NL(); int next = NL();
        int plain = NL(); int dollarBody = NL(); int dollarLit = NL();
        int nameScan = NL(); int nameDone = NL(); int nameOk = NL();
        int notLetter = NL(); int noVal = NL(); int vEmpty = NL();
        EmitB(loop);
        Mark(loop);
        HostLoad(9, 1); HostLoad(10, 2);
        HostCmp(9, 10);
        EmitBcond(2, fin);                       // i >= len
        HostLoad(0, 0);
        ExtLdrbReg(0, 0, 9);                     // c = text[i]
        ExtCmpImm(0, 36);                        // '$'
        EmitBcond(0, dollarBody);
        EmitB(plain);
        Mark(dollarBody);
        // scan the name run: end starts at i + 1 and extends over
        // [A-Za-z0-9_]
        HostLoad(9, 1); AddImm(9, 9, 1);
        HostSave(9, 4);                          // end
        EmitB(nameScan);
        Mark(nameScan);
        HostLoad(9, 4); HostLoad(10, 2);
        HostCmp(9, 10);
        EmitBcond(2, nameDone);
        HostLoad(0, 0);
        HostLoad(12, 4);
        ExtLdrbReg(0, 0, 12);                    // c = text[end]
        ExtCmpImm(0, 95);
        EmitBcond(0, nameOk);                    // '_'
        LoadImm(1, 32);
        OrrRR(0, 0, 1);                          // orr x0, x0, x1 -> c|32
        ExtCmpImm(0, 97);
        EmitBcond(11, notLetter);                // b.lt (unsigned)
        ExtCmpImm(0, 122);
        EmitBcond(12, nameOk);                   // b.gt
        EmitB(nameOk);
        Mark(notLetter);
        AddImm(0, 0, -48);
        ExtCmpImm(0, 9);
        EmitBcond(9, nameOk);                    // digit (unsigned ls)
        EmitB(nameDone);
        Mark(nameOk);
        HostLoad(9, 4); AddImm(9, 9, 1); HostSave(9, 4);
        EmitB(nameScan);
        Mark(nameDone);
        HostLoad(9, 4); HostLoad(10, 1); AddImm(10, 10, 1);
        HostCmp(9, 10);
        EmitBcond(9, dollarLit);                 // end <= i+1 -> bare '$'
        // name = text[i+1 .. end)
        HostLoad(0, 0);
        HostLoad(1, 1); AddImm(1, 1, 1);
        HostLoad(2, 4); HostLoad(9, 1);
        ExtSubRR(2, 2, 9); AddImm(2, 2, -1);
        BLInternal("_zan_ext_path_slice");
        HostSave(0, 5);                          // name (stamped)
        HostLoad(0, 5);
        BLExtern("_getenv");
        int haveV = NL(); CbzReg(0, noVal);
        HostSave(0, 6);                          // raw value
        HostLoad(0, 6);
        BLExtern("_strlen");
        MovRR(1, 0);
        CbzReg(1, vEmpty);                       // empty value = unset
        HostLoad(0, 6);
        BLInternal("_zan_host_copy");
        ExtMov(1, 0);
        HostLoad(0, 3);
        BLInternal("_zan_rt_strcat2");
        HostSave(0, 3);
        HostLoad(9, 4); HostSave(9, 1);          // i = end
        EmitB(next);
        Mark(vEmpty);
        Mark(noVal);
        // unknown token stays literal: result + "$" + name
        HostLoad(0, 3); LoadStr(extDollar, 1);
        BLInternal("_zan_rt_strcat2");
        HostSave(0, 3);
        HostLoad(0, 3); HostLoad(1, 5);
        BLInternal("_zan_rt_strcat2");
        HostSave(0, 3);
        HostLoad(9, 4); HostSave(9, 1);
        EmitB(next);
        Mark(dollarLit);
        HostLoad(0, 3); LoadStr(extDollar, 1);
        BLInternal("_zan_rt_strcat2");
        HostSave(0, 3);
        HostLoad(9, 1); AddImm(9, 9, 1); HostSave(9, 1);
        EmitB(next);
        // plain byte: a one-byte stamped string appended to the result
        Mark(plain);
        ExtPush(0);                              // [sp] = c (low byte)
        AddImm(0, 31, 0);
        LoadImm(1, 1);
        BLInternal("_zan_host_copy");
        ExtPop(1);
        MovRR(1, 0);
        HostLoad(0, 3);
        BLInternal("_zan_rt_strcat2");
        HostSave(0, 3);
        HostLoad(9, 1); AddImm(9, 9, 1); HostSave(9, 1);
        Mark(next);
        EmitB(loop);
        Mark(fin);
        HostLoad(0, 3);
        HostEnd();
    }

    // -> monotonic nanoseconds (CLOCK_MONOTONIC = 6 on Darwin).
    void HostEmitMono() {
        HostBegin("_zan_host_mono_ns");
        AddSPImm(16, false);                     // timespec
        LoadImm(0, 6);
        if (tgt86 == 1) { X3(0x49, 0x89, 0xE2); XSetV(1, 10); }   // x1 = timespec(sp)
        else { AddImm(1, 31, 0); }
        BLExtern("_clock_gettime");
        if (tgt86 == 1) { XopRMem(0x8B, 10, 4, 0); XSetV(9, 10); }   // tv_sec
        else { LdrU(9, 31, 0); }
        LoadImm(10, 1000000000);
        MaddRR(9, 10, 9, 31);                    // mul x9, x10, x9
        if (tgt86 == 1) { XopRMem(0x8B, 10, 4, 8); XSetV(10, 10); }   // tv_nsec
        else { LdrU(10, 31, 8); }
        AddRR(0, 9, 10);
        AddSPImm(16, true);
        HostEnd();

        // MonoScaled(1000): (t/f)*unit + (t%f)*unit/f, divide-first like
        // the stdlib so the multiply cannot overflow i64
        HostBegin("_zan_host_mono_ms");
        BLInternal("_zan_host_mono_ns");
        HostSave(0, 0);                          // t
        LoadImm(1, 1000000000);
        SdivRR(2, 0, 1);                          // sdiv x2, x0, x1
        LoadImm(3, 1000);
        MaddRR(0, 0, 9, 31);                          // mul x0, x2, x3
        HostLoad(4, 0);
        MaddRR(4, 2, 1, 4);                          // msub x4 = x4 - x2*x1 (rem)
        MaddRR(4, 0, 9, 31);                          // mul x4, x4, x3
        SdivRR(4, 0, 1);                          // sdiv x4, x4, x1
        AddRR(0, 0, 4);
        HostEnd();
    }

    // Stopwatch: {start@0, accumulated@8, running@16}; x0 = object.
    void HostEmitStopwatch() {
        HostBegin("_zan_host_sw_start");
        HostSave(0, 0);
        LdrU(9, 0, 16);
        int done = NL(); CbnzReg(9, done);
        LoadImm(9, 1);
        HostLoad(0, 0);
        StrU(9, 0, 16);
        BLInternal("_zan_host_mono_ns");
        HostLoad(9, 0);
        StrU(0, 9, 0);
        Mark(done);
        HostEnd();

        HostBegin("_zan_host_sw_stop");
        HostSave(0, 0);
        LdrU(9, 0, 16);
        int sDone = NL(); CbzReg(9, sDone);
        LoadImm(9, 0);
        HostLoad(0, 0);
        StrU(9, 0, 16);
        BLInternal("_zan_host_mono_ns");         // now
        HostLoad(9, 0);
        LdrU(10, 9, 0);                          // start
        LdrU(11, 9, 8);                          // accumulated
        ExtSubRR(10, 0, 10);                     // now - start
        AddRR(10, 11, 10);
        StrU(10, 9, 8);
        Mark(sDone);
        HostEnd();

        HostBegin("_zan_host_sw_reset");
        HostSave(0, 0);
        LoadImm(9, 0);
        HostLoad(0, 0);
        StrU(9, 0, 8);
        StrU(9, 0, 16);
        HostEnd();

        HostBegin("_zan_host_sw_elapsed");
        HostSave(0, 0);
        LdrU(9, 0, 8);                           // accumulated
        LdrU(10, 0, 16);                         // running
        int have = NL(); CbzReg(10, have);
        BLInternal("_zan_host_mono_ns");
        MovRR(10, 0);                            // now
        HostLoad(9, 0);
        LdrU(11, 9, 0);                          // start
        ExtSubRR(10, 10, 11);
        LdrU(9, 9, 8);                           // reload accumulated
        AddRR(9, 9, 10);
        Mark(have);
        ExtMov(0, 9);                            // ticks
        if (tgt86 == 1) {
            XGetV(0, 10);
            X1(0xF2); X1(0x49); X1(0x0F); X1(0x2A); X1(0xC2);   // cvtsi2sd xmm0, r10
            LoadImm(1, 1000000);
            XGetV(1, 10);
            X1(0xF2); X1(0x49); X1(0x0F); X1(0x2A); X1(0xCA);   // cvtsi2sd xmm1, r10
            X1(0xF2); X1(0x0F); X1(0x5E); X1(0xC1);             // divsd xmm0, xmm1
            X1(0x66); X1(0x49); X1(0x0F); X1(0x7E); X1(0xC2);   // movq r10, xmm0
            XSetV(0, 10);                        // fmov x0, d0
        } else {
            E4(0x9E620000);                      // scvtf d0, x0
            LoadImm(1, 1000000);
            E4(0x9E620021);                      // scvtf d1, x1
            E4(0x1E611800);                      // fdiv d0, d0, d1
            E4(0x9E660000);                      // fmov x0, d0
        }
        HostEnd();
    }

    // pthread body: sleep the interval, fire the delegate, repeat until
    // Stop clears `running`. The timer pointer rides in x20 (callee-saved:
    // usleep/libSystem preserve it; compiled Zan code never touches x19+),
    // so the loop keeps zero stack dependence. The entry LR rides in x21:
    // every `bl` below would otherwise clobber it, and the exit `ret` must
    // still land in the pthread trampoline. Frameless: no HostBegin.
    void HostEmitTimerThread() {
        syms.Add(new Sym("_zan_host_timer_thread", FnPad()));
        if (tgt86 == 1) {
            // x86 pthread 体:计时器指针住 rbx(zan 代码从不写 rbx,libc
            // ABI 保存);裸体入口 rsp≡8 mod 16,push rbx 顺带补齐 16 对
            // 齐——不补则 usleep 的 SSE 指令踩对齐。arm64 侧 x20/x21/LR
            // 的戏份在 x86 全部不需要:ret 即回 trampoline。
            X1(0x53);                            // push rbx
            X3(0x48, 0x89, 0xFB);                // mov rbx, rdi (timer)
            int tLoop = NL(); int tDone = NL();
            EmitB(tLoop);
            Mark(tLoop);
            X3(0x4A, 0x8B, 0x13);                // mov r10d, [rbx] (interval;reg=r10d 需 R——41 解码成 rdx)
            X4(0xD26943); X4(1000);              // imul r10d, r10d, 1000 (usec;reg 需 R|B)
            X3(0x44, 0x89, 0xD7);                // mov edi, r10d
            BLExtern("_usleep");
            XopRMem(0x8B, 10, 3, 16); XSetV(1, 10);   // running
            CbzReg(1, tDone);
            XopRMem(0x8B, 10, 3, 8); XSetV(1, 10);    // closure
            LdrU(0, 1, 8);                       // env
            LdrU(9, 1, 0);                       // thunk
            XSubRsp(16); X2(0xFF, 0xD0); XAddRsp(16); // call thunk(对齐垫)
            EmitB(tLoop);
            Mark(tDone);
            LoadImm(0, 0);                       // pthread return value
            X1(0x5B);                            // pop rbx
            X1(0xC3);                            // ret
            return;
        }
        E4(0xAA0003F4);                          // mov x20, x0 (timer)
        E4(0xAA1E03F5);                          // mov x21, x30 (thread exit)
        int tLoop = NL(); int tDone = NL();
        EmitB(tLoop);
        Mark(tLoop);
        E4(0xB9400281);                          // ldr w1, [x20] (interval)
        E4(0x52807D02);                          // mov w2, #1000
        E4(0x1B027C20);                          // mul w0, w1, w2 (usec)
        BLExtern("_usleep");
        LdrU(1, 20, 16);                         // running
        CbzReg(1, tDone);
        LdrU(1, 20, 8);                          // closure
        LdrU(0, 1, 8);                           // env
        LdrU(9, 1, 0);                           // thunk
        if (tgt86 == 1) { XSubRsp(16); X2(0xFF, 0xD0); XAddRsp(16); } else { E4(0xD63F0120); }                             // blr x9
        EmitB(tLoop);
        Mark(tDone);
        LoadImm(0, 0);                           // pthread return value
        E4(0xD65F02A0);                          // ret x21
    }

    // x0 = path -> -1 or attribute bits (bit0 readable? no: W_OK fails,
    // bit1 basename starts '.', bit2 directory) — matches
    // zan_file_attributes_at in the reference runtime.
    void HostEmitFattr() {
        HostBeginN("_zan_host_fattr", 176);
        HostSave(0, 0);
        HostLoad(0, 0);
        AddImm(1, 31, 128);
        BLExtern("_stat");
        int miss = NL(); HostCbnzW(miss);
        LoadImm(9, 0);
        HostSave(9, 1);                          // bits
        HostLoad(0, 0);
        LoadImm(1, 2);                           // W_OK
        BLExtern("_access");
        int yesW = NL(); HostCbzW(yesW);         // writable -> no bit
        LoadImm(9, 1);
        HostSave(9, 1);
        Mark(yesW);
        HostLoad(0, 0);
        BLInternal("_zan_ext_path_filename");
        ExtLdrbImm(9, 0, 0);
        ExtCmpImm(9, 46);                        // '.'
        int noDot = NL(); EmitBcond(1, noDot);   // not hidden -> no bit
        HostLoad(9, 1); LoadImm(10, 2); AddRR(9, 9, 10);
        HostSave(9, 1);
        Mark(noDot);
        LdrHImm(9, 31, 66);   // ldrh w9, [sp, #132]
        LsrImm(9, 9, 12); LoadImm(10, 15); AndRR(9, 9, 10); Uxtw32(9, 9);                                // ubfm w9, w9, #12, #15
        ExtCmpImm(9, 4);                               // S_IFDIR
        int noDirB = NL(); EmitBcond(1, noDirB);       // not a dir -> no bit
        HostLoad(9, 1); AddImm(9, 9, 4);
        HostSave(9, 1);
        Mark(noDirB);
        HostLoad(0, 1);
        int fin = NL(); EmitB(fin);
        Mark(miss);
        LoadImm(0, -1);
        Mark(fin);
        HostEndN(176);
    }

    // x0 = path -> size in bytes, or -1 when missing.
    void HostEmitFlength() {
        HostBeginN("_zan_host_flength", 176);
        HostSave(0, 0);
        HostLoad(0, 0);
        AddImm(1, 31, 128);
        BLExtern("_stat");
        int miss = NL(); HostCbnzW(miss);
        LdrU(0, 31, 128 + 96);                   // st_size
        int fin = NL(); EmitB(fin);
        Mark(miss);
        LoadImm(0, -1);
        Mark(fin);
        HostEndN(176);
    }

    // x0 = path, x1 = which (0 mtime, 1 ctime) -> Unix seconds, 0 when
    // missing (zan_file_time semantics).
    void HostEmitFtime() {
        HostBeginN("_zan_host_ftime", 176);
        HostSave(0, 0); HostSave(1, 1);
        HostLoad(0, 0);
        AddImm(1, 31, 128);
        BLExtern("_stat");
        int miss = NL(); HostCbnzW(miss);
        HostLoad(9, 1);
        ExtCmpImm(9, 1);
        int isC = NL(); EmitBcond(0, isC);
        LdrU(0, 31, 128 + 48);                   // st_mtimespec.tv_sec
        int got = NL(); EmitB(got);
        Mark(isC);
        LdrU(0, 31, 128 + 64);                   // st_ctimespec.tv_sec
        Mark(got);
        int fin = NL(); EmitB(fin);
        Mark(miss);
        LoadImm(0, 0);
        Mark(fin);
        HostEndN(176);
    }

    // x0 = path, x1 = on -> 1 when the mode change succeeded. Setreadonly
    // clears the 0o222 write bits; making writable restores S_IWUSR, the
    // minimum the reference shim grants back.
    void HostEmitSetReadonly() {
        HostBeginN("_zan_host_setreadonly", 176);
        HostSave(0, 0); HostSave(1, 1);
        HostLoad(0, 0);
        AddImm(1, 31, 128);
        BLExtern("_stat");
        int miss = NL(); int fail = NL(); int fin = NL(); int chmodL = NL();
        HostCbnzW(miss);
        LdrHImm(9, 31, 66);   // ldrh w9, [sp, #132]
        HostLoad(10, 1);
        ExtCmpImm(10, 0);
        int wOn0 = NL(); EmitBcond(0, wOn0);
        LoadImm(10, 146);                        // 0o222
        if (tgt86 == 1) {
            XGetV(10, 11);                       // bic: rd = rn & ~rm
            X3(0x49, 0xF7, 0xD3);                // not r11
            XGetV(9, 10);
            X3(0x4D, 0x23, 0xD3);                // and r10, r11
            XSetV(9, 10);
        } else {
            E4(0x0A2A0129);                      // bic w9, w9, w10
        }
        EmitB(chmodL);
        Mark(wOn0);
        LoadImm(10, 128);                        // S_IWUSR
        OrrRR(9, 9, 10);                         // orr w9, w9, w10(位标志,64位同义)
        Mark(chmodL);
        HostLoad(0, 0);
        ExtMov(1, 9);
        BLExtern("_chmod");
        HostCbnzW(fail);
        LoadImm(0, 1);
        EmitB(fin);
        Mark(fail);
        LoadImm(0, 0);
        EmitB(fin);
        Mark(miss);
        LoadImm(0, 0);
        Mark(fin);
        HostEndN(176);
    }

    // x0 = mine, x1 = other -> other is missing (mtime 0) or mine is newer.
    void HostEmitFnewer() {
        HostBegin("_zan_host_fnewer");
        HostSave(0, 0); HostSave(1, 1);
        HostLoad(0, 1); LoadImm(1, 0);
        BLInternal("_zan_host_ftime");
        HostSave(0, 2);                          // theirs
        HostLoad(0, 0); LoadImm(1, 0);
        BLInternal("_zan_host_ftime");
        MovRR(10, 0);                            // mine
        HostLoad(9, 2);
        int fin = NL(); int cmpP = NL(); int bigger = NL();
        CbnzReg(9, cmpP);                        // theirs != 0 -> compare
        LoadImm(0, 1);                           // missing target: stale
        EmitB(fin);
        Mark(cmpP);
        HostCmp(10, 9);
        EmitBcond(12, bigger);                   // b.gt mine > theirs
        LoadImm(0, 0);
        EmitB(fin);
        Mark(bigger);
        LoadImm(0, 1);
        Mark(fin);
        HostEnd();
    }

    // x0 = path -> 1 when a directory exists there (stat + S_ISDIR).
    void HostEmitDirExists() {
        HostBeginN("_zan_host_direxists", 176);
        HostSave(0, 0);
        HostLoad(0, 0);
        AddImm(1, 31, 128);
        BLExtern("_stat");
        int miss = NL(); int fin = NL(); int isD = NL();
        HostCbnzW(miss);
        LdrHImm(9, 31, 66);
        LsrImm(9, 9, 12); LoadImm(10, 15); AndRR(9, 9, 10); Uxtw32(9, 9);
        ExtCmpImm(9, 4);
        EmitBcond(0, isD);
        LoadImm(0, 0);
        EmitB(fin);
        Mark(isD);
        LoadImm(0, 1);
        EmitB(fin);
        Mark(miss);
        LoadImm(0, 0);
        Mark(fin);
        HostEndN(176);
    }

    // Host List<string>: {count@0, cap@8, data@16}, identical layout to
    // GenListNew/ListAppendRaw so user code can Add/index the result.
    void HostEmitList() {
        HostBegin("_zan_host_list_new");
        HostSave(0, 0);                          // cap
        LoadImm(0, 24); LoadImm(1, 0);
        BLInternal("_zan_rt_alloc");
        HostSave(0, 1);                          // list
        HostLoad(0, 0);
        LoadImm(1, 8);
        BLExtern("_calloc");
        MovRR(9, 0);                             // data
        HostLoad(1, 1);
        StrU(9, 1, 16);
        HostLoad(0, 0);
        StrU(0, 1, 8);                           // cap
        LoadImm(9, 0);
        StrU(9, 1, 0);                           // count
        HostLoad(0, 1);
        HostEnd();

        HostBegin("_zan_host_list_push");
        HostSave(0, 0); HostSave(1, 1);
        LdrU(2, 0, 0);                           // count
        LdrU(3, 0, 8);                           // cap
        HostCmp(2, 3);
        int skip = NL(); EmitBcond(1, skip);
        AddRR(3, 3, 3);                          // ncap = cap * 2
        HostLoad(9, 0);
        StrU(3, 9, 8);
        LdrU(0, 9, 16);                          // old data
        LoadImm(4, 8);
        MaddRR(1, 3, 4, 31);                     // mul x1, x3, x4
        BLExtern("_realloc");
        HostLoad(9, 0);
        StrU(0, 9, 16);
        Mark(skip);
        HostLoad(0, 0);
        LdrU(2, 0, 0);
        LdrU(3, 0, 16);
        HostLoad(1, 1);
        ExtStrScaled(1, 3, 2);                       // str x1, [x3, x2, lsl 3]
        AddImm(2, 2, 1);
        StrU(2, 0, 0);
        HostEnd();
    }

    // x0 = path, wantDirs selects files (0) or directories (1). Bare
    // names, hidden entries included, non-recursive — the stdlib
    // GetFileNames/GetDirectories contract. full=true instead pushes the
    // combined path + "/" + name (the GetPaths/GetDirectoryPaths
    // contract); a missing directory yields an empty list either way.
    void HostEmitDirList(string sym, int wantDirs, bool full) {
        HostBeginN(sym, 176);
        HostSave(0, 0);                          // path
        LoadImm(0, 8);
        BLInternal("_zan_host_list_new");
        HostSave(0, 1);                          // list
        HostLoad(0, 0);
        BLExtern("_opendir");
        int noDir = NL(); CbzReg(0, noDir);
        HostSave(0, 2);                          // DIR*
        int rLoop = NL(); int rNext = NL(); int rDone = NL();
        int keep = NL(); int pushIt = NL(); int badStat = NL(); int cls = NL();
        int d0 = NL(); int d1 = NL();
        EmitB(rLoop);
        Mark(rLoop);
        HostLoad(0, 2);
        BLExtern("_readdir");
        CbzReg(0, rDone);
        HostSave(0, 3);                          // dirent*
        // skip "." and ".." only (hidden entries are listed)
        AddImm(9, 0, 21);                        // d_name
        ExtLdrbImm(10, 9, 0);
        ExtCmpImm(10, 46);
        EmitBcond(0, d0);
        EmitB(keep);
        Mark(d0);
        ExtLdrbImm(10, 9, 1);
        ExtCmpImm(10, 0);
        EmitBcond(0, rNext);                     // "."
        ExtCmpImm(10, 46);
        EmitBcond(0, d1);
        EmitB(keep);
        Mark(d1);
        ExtLdrbImm(10, 9, 2);
        ExtCmpImm(10, 0);
        EmitBcond(0, rNext);                     // ".."
        Mark(keep);
        // classify via stat on the combined path (d_type is unreliable on
        // some filesystems)
        HostLoad(0, 0);
        HostLoad(9, 3);
        AddImm(1, 9, 21);                        // d_name
        BLInternal("_zan_ext_path_combine");
        HostSave(0, 5);                          // full path
        HostLoad(0, 5);
        AddImm(1, 31, 128);
        BLExtern("_stat");
        HostCbnzW(badStat);
        LdrHImm(9, 31, 66);
        LsrImm(9, 9, 12); LoadImm(10, 15); AndRR(9, 9, 10); Uxtw32(9, 9);
        LoadImm(10, 4);
        HostCmp(9, 10);
        int isD = NL(); EmitBcond(0, isD);
        LoadImm(9, 0);
        EmitB(cls);
        Mark(isD);
        LoadImm(9, 1);
        Mark(cls);
        HostSave(9, 6);                          // is_dir
        HostLoad(9, 6);
        ExtCmpImm(9, wantDirs);
        EmitBcond(0, pushIt);
        EmitB(rNext);
        Mark(pushIt);
        if (full) {
            // stamped copy of d_name, then dir + "/" + name (strcat2
            // requires stamped strings)
            HostLoad(9, 3);
            AddImm(0, 9, 21);
            BLExtern("_strlen");
            MovRR(1, 0);
            HostLoad(9, 3);
            AddImm(0, 9, 21);
            BLInternal("_zan_host_copy");
            MovRR(1, 0);
            HostLoad(0, 0);
            BLInternal("_zan_ext_path_combine");
            MovRR(1, 0);
        } else {
            HostLoad(9, 3);
            AddImm(0, 9, 21);                    // d_name
            BLExtern("_strlen");
            MovRR(1, 0);
            HostLoad(9, 3);
            AddImm(0, 9, 21);
            BLInternal("_zan_host_copy");
            MovRR(1, 0);
        }
        HostLoad(0, 1);
        BLInternal("_zan_host_list_push");
        EmitB(rNext);
        Mark(badStat);
        EmitB(rLoop);
        Mark(rNext);
        EmitB(rLoop);
        Mark(rDone);
        HostLoad(0, 2);
        BLExtern("_closedir");
        Mark(noDir);
        HostLoad(0, 1);
        HostEndN(176);
    }

    void HostEmitIo() {
        ioHome = InternStr("HOME");
        ioTemp = InternStr("TEMP");
        ioTmp = InternStr("TMP");
        ioTmpdir = InternStr("TMPDIR");
        ioXdgCfg = InternStr("XDG_CONFIG_HOME");
        ioDotConfig = InternStr(".config");
        ioSlashTmp = InternStr("/tmp");
        extDollar = InternStr("$");
        HostEmitGetenv();
        HostEmitExpand();
        HostEmitMono();
        HostEmitStopwatch();
        HostEmitTimerThread();
        HostEmitFattr();
        HostEmitFlength();
        HostEmitFtime();
        HostEmitSetReadonly();
        HostEmitFnewer();
        HostEmitDirExists();
        HostEmitList();
        HostEmitDirList("_zan_host_getfiles", 0, false);
        HostEmitDirList("_zan_host_getdirs", 1, false);
        HostEmitDirList("_zan_dir_getpaths", 0, true);
        HostEmitDirList("_zan_dir_getdirpaths", 1, true);
    }

    // x0 = fmt, x1 = argc, x2..x4 = pre-rendered argument strings. Scans
    // {N} placeholders: a digit run naming an argument below argc and
    // closed by '}' substitutes it; anything else stays literal text.
    void HostEmitStrFormat() {
        HostBegin("_zan_ext_str_format");
        HostSave(0, 0); HostSave(1, 1);
        HostSave(2, 2); HostSave(3, 3); HostSave(4, 4);
        int gFin = NL(); int gLoop = NL(); int gBrace = NL(); int gDig = NL();
        int gDigEnd = NL(); int gBad = NL(); int gAdv = NL(); int gArgDone = NL();
        int gArgCp = NL(); int gSatC = NL(); int gSat = NL();
        int gA0 = NL(); int gA1 = NL(); int gA2 = NL();
        int gN0 = NL(); int gN1 = NL(); int gN2 = NL();
        // buffer = fmtlen + arg lens + 1 (only args below argc were passed).
        // Arg lengths use strlen: rendered results (int2str etc.) need not
        // carry the Zan length header. Lengths live in slots 7/8/10.
        HostLoad(9, 0);
        ExtLenOf(9, 11);                       // x11 = total (fmtlen)
        HostSave(11, 9);
        HostLoad(1, 1);                        // argc
        ExtCmpImm(1, 0);
        EmitBcond(9, gN0);
        HostLoad(0, 2);
        CbzReg(0, gA0);
        ExtPush(0);
        BLExtern("_strlen");
        ExtMov(12, 0);
        ExtPop(0);
        HostSave(12, 7);
        HostLoad(11, 9); HostLoad(12, 7); AddRR(11, 11, 12); HostSave(11, 9);
        Mark(gA0);
        Mark(gN0);
        HostLoad(1, 1);
        ExtCmpImm(1, 1);
        EmitBcond(9, gN1);
        HostLoad(0, 3);
        CbzReg(0, gA1);
        ExtPush(0);
        BLExtern("_strlen");
        ExtMov(12, 0);
        ExtPop(0);
        HostSave(12, 8);
        HostLoad(11, 9); HostLoad(12, 8); AddRR(11, 11, 12); HostSave(11, 9);
        Mark(gA1);
        Mark(gN1);
        HostLoad(1, 1);
        ExtCmpImm(1, 2);
        EmitBcond(9, gN2);
        HostLoad(0, 4);
        CbzReg(0, gA2);
        ExtPush(0);
        BLExtern("_strlen");
        ExtMov(12, 0);
        ExtPop(0);
        HostSave(12, 10);
        HostLoad(11, 9); HostLoad(12, 10); AddRR(11, 11, 12); HostSave(11, 9);
        Mark(gA2);
        Mark(gN2);
        HostLoad(11, 9);
        AddImm(0, 11, 1);
        BLExtern("_malloc");
        HostNonzero(0, "ext.fmt.malloc");
        HostSave(0, 5);                        // base (cursor tracked in x13)
        HostLoad(9, 0);                        // fmt (no calls during scan)
        ExtLenOf(9, 11);                       // fmtlen
        LoadImm(10, 0);                        // i
        MovRR(12, 0);                          // base
        MovRR(13, 0);                          // cursor
        EmitB(gLoop);
        Mark(gLoop);
        HostCmp(10, 11);
        EmitBcond(2, gFin);                    // i >= fmtlen -> done
        ExtLdrbReg(0, 9, 10);                  // c
        ExtCmpImm(0, 123);                     // '{'
        EmitBcond(0, gBrace);
        ExtStrbImm(0, 13, 0);                  // plain byte
        AddImm(13, 13, 1);
        AddImm(10, 10, 1);
        EmitB(gLoop);
        Mark(gBrace);
        AddImm(15, 10, 1);                     // j = i + 1
        LoadImm(14, 0);                        // val
        EmitB(gDig);
        Mark(gDig);
        HostCmp(15, 11);
        EmitBcond(2, gBad);                    // j >= fmtlen -> literal
        ExtLdrbReg(0, 9, 15);
        ExtCmpImm(0, 48);
        EmitBcond(11, gDigEnd);                // < '0'
        ExtCmpImm(0, 57);
        EmitBcond(12, gDigEnd);                // > '9'
        // val = sat(val * 10 + (c - 48)) with 2^30 as the saturation mark
        ExtLsl(1, 14, 3);
        ExtLsl(2, 14, 1);
        AddRR(1, 1, 2);
        AddRR(1, 1, 0);                        // + c
        AddImm(1, 1, -48);
        LoadImm(2, 1073741824);
        HostCmp(1, 2);
        EmitBcond(2, gSat);                    // hs -> saturate
        ExtMov(14, 1);
        EmitB(gSatC);
        Mark(gSat);
        LoadImm(14, 1073741824);
        Mark(gSatC);
        AddImm(15, 15, 1);
        EmitB(gDig);
        Mark(gDigEnd);
        AddImm(2, 10, 2);
        HostCmp(15, 2);
        EmitBcond(11, gBad);                   // no digits -> literal
        HostCmp(15, 11);
        EmitBcond(2, gBad);                    // '}' out of range -> literal
        ExtLdrbReg(0, 9, 15);
        ExtCmpImm(0, 125);
        EmitBcond(1, gBad);                    // not '}' -> literal
        HostLoad(1, 1);
        HostCmp(14, 1);
        EmitBcond(2, gBad);                    // val >= argc -> literal
        // length: sp + 56 + val * 8; arg pointer: sp + 16 + val * 8
        ExtLsl(0, 14, 3);
        AddImm(0, 0, 56);
        if (tgt86 == 1) {
            XGetV(0, 10);
            X1(0x4E); X1(0x8D); X1(0x1C); X1(0x14); X4(0);   // lea r11,[rsp+r10](base=rsp 须 disp32)
            // 批 35:1B 的 reg 域是 011=rbx(裸踩被调者保存寄存器),
            // XSetV(1,10) 读到的还是陈旧 r10——13 才是 r10 做目的
            X3(0x4B, 0x8B, 0x13); XSetV(1, 10);   // mov r10,[r11] = alen
        } else {
            E4(0xF8606BE1);                        // ldr x1, [sp, x0] = alen
        }
        ExtLsl(0, 14, 3);
        AddImm(0, 0, 16);
        if (tgt86 == 1) {
            XGetV(0, 10);
            X1(0x4E); X1(0x8D); X1(0x1C); X1(0x14); X4(0);   // lea r11,[rsp+r10](base=rsp 须 disp32)
            X3(0x4B, 0x8B, 0x13); XSetV(0, 10);   // mov r10,[r11] = argp(同上 1B->13)
        } else {
            E4(0xF8606BE0);                        // ldr x0, [sp, x0] = argp
        }
        CbzReg(0, gAdv);                       // null arg -> nothing
        MovRR(2, 15);                          // j -> x2 (x15 becomes src)
        MovRR(15, 0);
        LoadImm(3, 0);                         // k
        EmitB(gArgCp);
        Mark(gArgCp);
        HostCmp(3, 1);
        EmitBcond(2, gArgDone);
        ExtLdrbReg(4, 15, 3);                  // src[k]
        ExtStrbImm(4, 13, 0);
        AddImm(13, 13, 1);
        AddImm(3, 3, 1);
        EmitB(gArgCp);
        Mark(gArgDone);
        AddImm(10, 2, 1);                      // i = j + 1
        EmitB(gLoop);
        Mark(gAdv);
        AddImm(10, 2, 1);
        EmitB(gLoop);
        Mark(gBad);
        LoadImm(0, 123);                       // literal '{'
        ExtStrbImm(0, 13, 0);
        AddImm(13, 13, 1);
        AddImm(10, 10, 1);
        EmitB(gLoop);
        Mark(gFin);
        ExtStrbImm(31, 13, 0);
        ExtMov(0, 13);
        ExtSubRR(1, 0, 12);                    // produced length
        ExtMov(0, 12);
        ExtPush(0);
        BLInternal("_zan_host_copy");
        ExtPop(1);
        HostSave(0, 7);
        HostSave(1, 8);
        HostLoad(0, 8);
        BLExtern("_free");
        HostLoad(0, 7);
        HostEnd();
    }

    // x0 = separator, x1 = List<string> (count +0, cap +8, data +16).
    // Null list and null elements behave as empty strings.
    void HostEmitStrJoin() {
        HostBegin("_zan_ext_str_join");
        HostSave(0, 0);                        // sep
        HostSave(1, 1);                        // list
        int jNull = NL(); int jLoop = NL(); int jDone = NL();
        int jHaveE = NL(); int jFirst = NL(); int jSepOk = NL();
        HostLoad(0, 0);
        CbnzReg(0, jSepOk);
        LoadStr(extEmpty, 0);
        HostSave(0, 0);
        Mark(jSepOk);
        HostLoad(0, 1);
        CbzReg(0, jNull);
        LoadStr(extEmpty, 0);
        HostSave(0, 2);                        // acc
        HostLoad(10, 1);
        LdrU(10, 10, 0);                       // count
        HostSave(10, 5);
        HostLoad(11, 1);
        LdrU(11, 11, 16);                      // data
        HostSave(11, 6);
        LoadImm(9, 0);                         // i
        HostSave(9, 4);
        EmitB(jLoop);
        Mark(jLoop);
        HostLoad(9, 4);                        // i (x9 dies in strcat2)
        HostLoad(10, 5);                       // count
        HostCmp(9, 10);
        EmitBcond(2, jDone);
        HostLoad(11, 6);                       // data
        ExtLdrRegScaled(1, 11, 9, 3);          // ldr x1, [x11, x9, lsl #3]
        CbnzReg(1, jHaveE);
        LoadStr(extEmpty, 1);
        Mark(jHaveE);
        HostSave(1, 3);                        // element
        HostLoad(9, 4);
        ExtCmpImm(9, 0);
        EmitBcond(0, jFirst);                  // i == 0 -> no separator
        HostLoad(0, 2);
        HostLoad(1, 0);
        BLInternal("_zan_rt_strcat2");
        HostSave(0, 2);
        Mark(jFirst);
        HostLoad(0, 2);
        HostLoad(1, 3);
        BLInternal("_zan_rt_strcat2");
        HostSave(0, 2);
        HostLoad(9, 4);
        AddImm(9, 9, 1);
        HostSave(9, 4);
        EmitB(jLoop);
        Mark(jDone);
        HostLoad(0, 2);
        HostEnd();
        Mark(jNull);
        LoadStr(extEmpty, 0);
        HostEnd();
    }

    // ASCII case fold: x0 = string -> copy with [lo..hi] shifted by delta.
    void HostEmitStrCase(string sym, int lo, int hi, int delta) {
        HostBegin(sym);
        HostSave(0, 0);
        int fin = NL(); int loop = NL(); int skip = NL();
        HostLoad(9, 0);
        ExtLenOf(9, 10);
        HostLoad(0, 0);
        AddImm(0, 10, 1);
        BLExtern("_malloc");
        HostNonzero(0, "ext.case.malloc");
        MovRR(11, 0);                          // cursor
        MovRR(12, 0);                          // base
        HostLoad(9, 0);                        // s
        LoadImm(13, 0);                        // i
        HostLoad(0, 0);
        ExtLenOf(0, 10);                       // len (reloaded post-call)
        Mark(loop);
        HostCmp(13, 10);
        EmitBcond(2, fin);
        ExtLdrbReg(0, 9, 13);
        ExtCmpImm(0, lo);
        EmitBcond(11, skip);
        ExtCmpImm(0, hi);
        EmitBcond(8, skip);
        AddImm(0, 0, delta);
        Mark(skip);
        ExtStrbImm(0, 11, 0);
        AddImm(11, 11, 1);
        AddImm(13, 13, 1);
        EmitB(loop);
        Mark(fin);
        ExtStrbImm(31, 11, 0);
        ExtMov(0, 11);
        ExtSubRR(1, 0, 12);
        ExtMov(0, 12);
        ExtPush(0);
        BLInternal("_zan_host_copy");
        ExtPop(1);
        HostSave(0, 5);
        HostSave(1, 6);
        HostLoad(0, 6);
        BLExtern("_free");
        HostLoad(0, 5);
        HostEnd();
    }

    // x0 = string -> trimmed copy ({' ', '\t', '\r', '\n'} at both ends).
    // Registers: x9 s, x10 base, x11 end, x12 start, x13 produced,
    // x14 cursor, x15 k.
    void HostEmitStrTrim() {
        HostBegin("_zan_ext_str_trim");
        HostSave(0, 0);
        int fFin = NL(); int fLoop = NL(); int fChk = NL();
        int bFin = NL(); int bLoop = NL(); int bChk = NL();
        int cFin = NL(); int cLoop = NL();
        HostLoad(9, 0);
        ExtLenOf(9, 11);                       // len
        HostLoad(9, 0);                        // s
        MovRR(11, 11);                         // end = len (already in x11)
        LoadImm(12, 0);                        // start
        Mark(fLoop);
        HostCmp(12, 11);
        EmitBcond(2, fFin);
        ExtLdrbReg(0, 9, 12);
        ExtCmpImm(0, 32);
        EmitBcond(0, fChk);
        ExtCmpImm(0, 9);
        EmitBcond(0, fChk);
        ExtCmpImm(0, 10);
        EmitBcond(0, fChk);
        ExtCmpImm(0, 13);
        EmitBcond(0, fChk);
        EmitB(fFin);
        Mark(fChk);
        AddImm(12, 12, 1);
        EmitB(fLoop);
        Mark(fFin);
        Mark(bLoop);
        HostCmp(11, 12);
        EmitBcond(9, bFin);                    // end <= start -> stop
        AddImm(0, 11, -1);
        ExtLdrbReg(0, 9, 0);
        ExtCmpImm(0, 32);
        EmitBcond(0, bChk);
        ExtCmpImm(0, 9);
        EmitBcond(0, bChk);
        ExtCmpImm(0, 10);
        EmitBcond(0, bChk);
        ExtCmpImm(0, 13);
        EmitBcond(0, bChk);
        EmitB(bFin);
        Mark(bChk);
        AddImm(11, 11, -1);
        EmitB(bLoop);
        Mark(bFin);
        ExtSubRR(13, 11, 12);                  // produced = end - start
        HostSave(11, 7); HostSave(12, 8);      // end/start survive malloc
        AddImm(0, 13, 1);
        BLExtern("_malloc");
        HostNonzero(0, "ext.trim.malloc");
        MovRR(10, 0);                          // base (len slot is dead now)
        MovRR(14, 0);                          // cursor
        HostLoad(9, 0);                        // s (reloaded post-call)
        HostLoad(11, 7); HostLoad(12, 8);      // end, start (x9-x15 are dead)
        ExtSubRR(13, 11, 12);                  // produced (reloaded post-call)
        LoadImm(15, 0);
        Mark(cLoop);
        HostCmp(15, 13);
        EmitBcond(2, cFin);
        AddRR(0, 12, 15);                      // add x0, x12, x15 (batch 31: was raw)
        ExtLdrbReg(1, 9, 0);
        ExtStrbImm(1, 14, 0);
        AddImm(14, 14, 1);
        AddImm(15, 15, 1);
        EmitB(cLoop);
        Mark(cFin);
        ExtStrbImm(31, 14, 0);
        ExtMov(0, 14);
        ExtSubRR(1, 0, 10);
        ExtMov(0, 10);
        ExtPush(0);
        BLInternal("_zan_host_copy");
        ExtPop(1);
        HostSave(0, 5);
        HostSave(1, 6);
        HostLoad(0, 6);
        BLExtern("_free");
        HostLoad(0, 5);
        HostEnd();
    }

    // Two-arg string helpers. Registers: x9 a, x10 b, x11 la, x12 lb,
    // x13 index, x14 scratch, x15 scratch. All are call-free bodies
    // returning in x0. which: 0 Equals, 1 CompareTo, 2 StartsWith,
    // 3 EndsWith, 4 LastIndexOf.
    void HostEmitStrCmp2(string sym, int which) {
        HostBegin(sym);
        HostSave(0, 0); HostSave(1, 1);
        HostLoad(9, 0);
        ExtLenOf(9, 11);                       // la
        HostLoad(10, 1);
        ExtLenOf(10, 12);                      // lb
        LoadImm(13, 0);                        // i
        if (which == 4) {
            // LastIndexOf: the LAST i with a match, else -1
            int loop = NL(); int done = NL();
            int mHit = NL(); int mNext = NL();
            LoadImm(14, -1);                   // best = -1
            HostCmp(12, 11);
            EmitBcond(8, done);                // lb > la -> -1
            Mark(loop);
            ExtSubRR(15, 11, 12);              // limit = la - lb
            HostCmp(13, 15);
            EmitBcond(8, done);                // i > limit -> report best
            LoadImm(15, 0);                    // k
            int mLoop = NL();
            Mark(mLoop);
            HostCmp(15, 12);
            EmitBcond(2, mHit);                // k == lb -> full match
            AddRR(0, 9, 13);                    // add x0, x9, x13 (batch 31: was raw)
            ExtLdrbReg(0, 0, 15);              // a[i + k]
            AddRR(1, 10, 15);                   // add x1, x10, x15 (batch 31: was raw)
            ExtLdrbReg(1, 1, 15);              // b[k]
            HostCmp(0, 1);
            EmitBcond(1, mNext);               // mismatch
            AddImm(15, 15, 1);
            EmitB(mLoop);
            Mark(mHit);
            MovRR(14, 13);                     // best = i
            Mark(mNext);
            AddImm(13, 13, 1);
            EmitB(loop);
            Mark(done);
            ExtMov(0, 14);
            HostEnd();
            return;
        }
        int zero = NL(); int one = NL(); int done = NL();
        int loop = NL(); int diff = NL();
        if (which == 0) {
            // Equals: lengths equal and every byte equal
            HostCmp(11, 12);
            EmitBcond(1, zero);
            Mark(loop);
            HostCmp(13, 11);
            EmitBcond(2, one);
            ExtLdrbReg(0, 9, 13);
            ExtLdrbReg(1, 10, 13);
            HostCmp(0, 1);
            EmitBcond(1, zero);
            AddImm(13, 13, 1);
            EmitB(loop);
        } else if (which == 1) {
            // CompareTo == strcmp: byte-wise ordinal compare INCLUDING the
            // NUL terminators (StringExtensions.CompareTo ->
            // String.CompareOrdinal -> gen0's inline _strcmp). The first
            // cut looped i < lb and at the length exit subtracted the LAST
            // compared (equal) bytes, so every prefix pair answered 0 on
            // both lanes -- self-consistent, not correct. "Hello World"
            // vs "Hello" is ' ' - NUL = 32; "a" vs "ab" is NUL - 'b' = -98.
            int eq2 = NL();
            Mark(loop);
            ExtLdrbReg(0, 9, 13);              // a[i] (NUL past the end)
            ExtLdrbReg(1, 10, 13);             // b[i] (NUL past the end)
            HostCmp(0, 1);
            EmitBcond(1, diff);                // bytes differ -> wa - wb
            CbnzReg(0, eq2);                   // equal and nonzero -> next
            LoadImm(0, 0);                     // both NUL -> equal
            EmitB(done);
            Mark(eq2);
            AddImm(13, 13, 1);
            EmitB(loop);
            Mark(diff);
            ExtSubRR(0, 0, 1);
            EmitB(done);
        } else if (which == 2) {
            // StartsWith
            HostCmp(12, 11);
            EmitBcond(8, zero);                // lb > la -> false
            Mark(loop);
            HostCmp(13, 12);
            EmitBcond(2, one);
            ExtLdrbReg(0, 9, 13);
            ExtLdrbReg(1, 10, 13);
            HostCmp(0, 1);
            EmitBcond(1, zero);
            AddImm(13, 13, 1);
            EmitB(loop);
        } else {
            // EndsWith
            HostCmp(12, 11);
            EmitBcond(8, zero);
            ExtSubRR(14, 11, 12);              // offset = la - lb
            Mark(loop);
            HostCmp(13, 12);
            EmitBcond(2, one);
            AddRR(0, 14, 13);                   // add x0, x14, x13 (batch 31: was raw)
            ExtLdrbReg(0, 9, 0);
            ExtLdrbReg(1, 10, 13);
            HostCmp(0, 1);
            EmitBcond(1, zero);
            AddImm(13, 13, 1);
            EmitB(loop);
        }
        Mark(one);
        LoadImm(0, 1);
        EmitB(done);
        Mark(zero);
        LoadImm(0, 0);
        Mark(done);
        HostEnd();
    }

    void HostEmitStrOps() {
        HostEmitStrCase("_zan_ext_str_lower", 65, 90, 32);
        HostEmitStrCase("_zan_ext_str_upper", 97, 122, -32);
        HostEmitStrTrim();
        HostEmitStrCmp2("_zan_ext_str_equals", 0);
        HostEmitStrCmp2("_zan_ext_str_compareto", 1);
        HostEmitStrCmp2("_zan_ext_str_startswith", 2);
        HostEmitStrCmp2("_zan_ext_str_endswith", 3);
        HostEmitStrCmp2("_zan_ext_str_lastidx", 4);
    }

}
