using System;
using System.Collections.Generic;
namespace Zan;

partial class Ngen {
    void EmitMethod(string cls, Node m, int mi) {
        curCls = cls;
        curMeth = m;
        gotoNames.Clear();
        gotoIds.Clear();
        bool inst = methStat[mi] == 0 || methStat[mi] == 2;
        if (methStat[mi] == 2) {
            // a per-instantiation ctor spec emits under its own symbol
            // (the open class's _Cls_ctor symbol would collide); the tag
            // shape must match what InstCtorSpecNg emitted at call sites
            syms.Add(new Sym(m.sval2 != null && m.sval2 != ""
                ? CtorSpecSymOf(m.sval, cls, m) : CtorSymNg(cls, m), FnPad()));
        } else if (methStat[mi] == 3) {
            syms.Add(new Sym("_" + cls + "_cctor", FnPad()));
        } else {
            // 缺口四: the export shim is emitted first and owns the plain
            // exported name; the body follows under the "__body" symbol
            // every internal reference resolves to. Ctors/cctors keep the
            // historical single-symbol layout (internal-only callers).
            string ex = MethExportSymNg(cls, m);
            int shimAt = FnPad();
            EmitExportShimNg(cls, m, inst);
            syms.Add(new Sym(ex, shimAt));
            syms.Add(new Sym(MethSymNg(cls, m), FnPad()));
        }
        InitLocalsNg();
        // late-synthesized specializations may carry tuple types the
        // program sweep never saw; registration is idempotent
        TupleSweepMethodNg(m);
        // instance methods and ctors take `this` as their first argument;
        // a specialization of a generic-class method types `this` as the
        // instantiation ("Pool<Conn>") so field types substitute
        if (inst) {
            AddLoc("this", m.sval2 != null && m.sval2 != "" ? m.sval2 : cls, false);
        }
        // params get frame slots; the prologue stores x0.. into them in order.
        // An out/ref parameter's slot holds the caller's storage ADDRESS
        // (gen0's byref protocol): reads and writes go through it
        int pi = 0;
        while (pi < m.kids.Count) {
            Node p = m.kids[pi];
            if (p.kind == AK.Param()) {
                AddLoc(p.sval, TypeFullName(p.type), p.ival == 1);
                if (locTy[nloc - 1] == "string") { locOpaq[nloc - 1] = 1; }
                paramSlotsNg.Add(nloc - 1);
            }
            pi = pi + 1;
        }
        ReserveLocals(m.d);
        BoxLambdaWrittenLocalsNg(m.d);
        curHasTry = HasTry(m.d);
        if (curHasTry) {
            // EH bookkeeping locals: the top mirror, the outermost open
            // try's arm base, and the loop-entry top for break/continue
            AddLoc("#ehtop", "int", false);
            AddLoc("#ehbase", "int", false);
            AddLoc("#ehbrk", "int", false);
            ehTopLocal = nloc - 3;
            ehBaseLocal = nloc - 2;
            ehBrkLocal = nloc - 1;
        }
        CollectSpanViews(m.d);
        ReserveSpanBoxes();
        frame = 16 * nloc;
        // [ThreadEntry]: POSIX calls this body directly from libpthread's
        // start routine, which keeps its own state in callee-saved x19-x28
        // (Zan bodies use x19-x25 as working registers). Extend the frame by
        // six pair slots and store the registers below the locals -- locals
        // are x29-relative, so the body is untouched. Restore happens in
        // Epilogue, which every return path funnels through.
        curThreadEntryNg = HasMod(m, MOD.ThreadEntry()) ? 1 : 0;
        if (curThreadEntryNg == 1 && HasMod(m, MOD.Async())) {
            // an async body's state machine emits nested runtime helpers
            // that share Epilogue; a thread entry must stay synchronous
            diags.Error("ngen: [ThreadEntry] cannot be combined with async", m.line, m.col);
            curThreadEntryNg = 0;
        }
        tentFrame = frame;
        if (curThreadEntryNg == 1) {
            tentFrame = frame + 96;
            if (tgt86 != 1 && tentFrame > 504) {
                diags.Error("ngen: [ThreadEntry] frame exceeds the ldp/stp immediate range", m.line, m.col);
            }
        }
        if (tgt86 == 1) {
            // 批 35:闸拆除。arm64 的工作寄存器 x19-x25 落在被调者保存
            // 区,线程入口须成对保存;SysV x86 的工作集是 rax,rcx,rdx,
            // rsi,rdi,r8-r11 + 泼溅槽,rbx/r12-r15 全程不碰(批 35 清完
            // 七处坏编码后全对象扫描仅剩 timer 线程的平衡 push/pop 对),
            // libpthread 放在被调者保存寄存器里的线程状态天然无恙——
            // 序言/收尾零改动即可当线程入口
            XPrologue(frame);                            // push rbp; mov rbp,rsp; sub rsp, frame+160
        } else {
            E4(0xA9BF7BFD);                              // stp x29, x30, [sp, #-16]!
            E4(0x910003FD);                              // mov x29, sp
            if (tentFrame > 0) { AddSPImm(tentFrame, false); }        // sub sp, sp, #frame
            if (curThreadEntryNg == 1) {
                E4(0xA90053F3);                          // stp x19, x20, [sp]
                E4(0xA9015BF5);                          // stp x21, x22, [sp, #16]
                E4(0xA90263F7);                          // stp x23, x24, [sp, #32]
                E4(0xA9036BF9);                          // stp x25, x26, [sp, #48]
                E4(0xA90473FB);                          // stp x27, x28, [sp, #64]
            }
        }
        pi = 0;
        int argReg = 0;
        if (inst) {
            StoreLocal(0, 0);        // this
            argReg = 1;
        }
        while (pi < m.kids.Count) {
            Node p = m.kids[pi];
            if (p.kind == AK.Param()) {
                if (tgt86 == 1) {
                    if (coffTarget == 1) {
                        // Windows x64: args 0-3 in registers rcx, rdx, r8, r9.
                        // Args 4+ sit above return address (8) and shadow space (32) at [rbp + 48 + 8*k].
                        if (argReg >= 4) {
                            XopRMem(0x8B, 10, 5, 48 + 8 * (argReg - 4));
                            XSetV(argReg, 10);
                            StoreLocal(argReg, argReg);
                        } else {
                            StoreLocal(argReg, argReg);
                        }
                    } else {
                        // SysV: args 0-5 arrive in the mapped registers; args
                        // 6+ sit on the stack above the return address at
                        // [rbp+16+8k] -- the exact mirror of the caller shim's
                        // [rsp+8k] staging (batch 33: any arity, no cap)
                        if (argReg >= 6) {
                            XopRMem(0x8B, 10, 5, 16 + 8 * (argReg - 6));
                            XSetV(argReg, 10);
                            // 注意 StoreLocal 的源是 v 号不是寄存器号——arm64 的
                            // v10 就是 x10,x86 的 v10 是泼溅槽(陈旧内容);
                            // 值已经在 argReg 自己的家,从家入槽
                            StoreLocal(argReg, argReg);
                        } else {
                            StoreLocal(argReg, argReg);
                        }
                    }
                } else {
                    if (argReg >= 16) {
                        LdrU(9, 29, 16 + 8 * (argReg - 16));
                        StoreLocal(argReg, 9);
                    } else {
                        StoreLocal(argReg, argReg);
                    }
                }
                // a captured-and-rebound parameter shares its value through a
                // heap cell: the slot becomes the cell, the incoming argument
                // its payload (the same wrap shape a T? value uses)
                if (boxParamSlots.Contains(argReg)) {
                    LoadLocal(argReg, 0);
                    GenNulWrap(false);
                    StoreLocal(argReg, 0);
                }
                argReg = argReg + 1;
            }
            pi = pi + 1;
        }
        // batch 12: normalize Span parameters to the uniform pair-in-slot
        // representation. The incoming word is the CALLER's frame box
        // address (a caller frame outlives any synchronous callee); copying
        // the {base,len} pair into the callee's own slot makes the parameter
        // a by-value view, exactly C#'s ref-struct argument semantics. All
        // incoming registers are already stored, so x0-x3 are free here.
        // A ref/out Span parameter has no by-value shape to normalize --
        // rejected loudly rather than silently aliased.
        int psp = 0;
        while (psp < paramSlotsNg.Count) {
            int pli = paramSlotsNg[psp];
            if (SpanTyNg(locTy[pli])) {
                if (locRef[pli]) {
                    diags.Error("ngen: a ref/out parameter cannot be a Span view (its frame box is by-value); pass the array and build a local view", 0, 0);
                } else {
                    LoadLocal(pli, 0);                       // x0 = caller box
                    LdrU(1, 0, 0);
                    LdrU(2, 0, 8);
                    LoadImm(3, LocFpOff(locOff[pli]));
                    AddRR(3, 29, 3);
                    StrU(1, 3, 0);
                    StrU(2, 3, 8);
                }
            }
            psp = psp + 1;
        }
        if (curHasTry) {
            BLInternal("_zan_rt_eh_state");              // x0 = state
            LdrU(1, 0, 0);                               // top at entry
            StoreLocal(ehTopLocal, 1);                   // start the mirror
        }
        // ctor initializer chaining (gen0 parity). `: this(args)` runs
        // another ctor of the same class first (it owns the base chain) and
        // is mutually exclusive with base chaining; otherwise `: base(args)`
        // explicitly, or the parameterless base ctor implicitly -- base
        // fields are a layout prefix, so the base ctor runs on `this`
        // before the body
        if (methStat[mi] == 2 && m.c != null) {
            int tix = FitCtorIdx(cls, m.c, false, m);
            if (tix >= 0) {
                // same-class chaining on a generic spec: the spec this-type
                // ("Pool<Conn>") supplies the substitution source
                pendingCtorInstNg = m.sval2 != null && m.sval2 != "" ? m.sval2 : cls;
                int tpushed = PushCallArgs(methNodes[tix], m.c);
                pendingCtorInstNg = null;
                int tr = tpushed;
                int armOvfArea = 0;
                if (tgt86 != 1 && tpushed + 1 > 16) {
                    int novf = tpushed + 1 - 16;
                    armOvfArea = 16 * ((novf + 1) / 2);
                    AddSPImm(armOvfArea, false);
                    int k = 1;
                    while (k <= tpushed) {
                        int off = armOvfArea + 16 * (tpushed - k);
                        if (k < 16) { LdrU(k, 31, off); }
                        else { LdrU(10, 31, off); StrU(10, 31, 8 * (k - 16)); }
                        k = k + 1;
                    }
                } else {
                    while (tr >= 1) { XPopV(tr); tr = tr - 1; } // args reversed
                }
                LoadLocal(0, 0);                                 // this -> x0
                BLInternal(CtorSymNg(cls, methNodes[tix]));
                if (armOvfArea > 0) { AddSPImm(armOvfArea + 16 * tpushed, true); }
            } else {
                diags.Error("ngen: no matching 'this' constructor with "
                    + m.c.kids.Count + " argument(s)", m.line, m.col);
            }
        } else if (methStat[mi] == 2) {
            Cls c = FindClass(cls);
            if (c != null && c.baseName != null) {
                int bix;
                Node zerocall = new Node(AK.Call());
                if (m.b != null) {
                    bix = FitCtorIdx(c.baseName, m.b, false, null);
                } else {
                    bix = FitCtorIdx(c.baseName, zerocall, true, null);
                }
                if (bix >= 0) {
                    int bpushed;
                    if (m.b != null) {
                        bpushed = PushCallArgs(methNodes[bix], m.b);
                    } else {
                        bpushed = 0;
                    }
                    int br = bpushed;
                    int armOvfAreaB = 0;
                    if (tgt86 != 1 && bpushed + 1 > 16) {
                        int novfB = bpushed + 1 - 16;
                        armOvfAreaB = 16 * ((novfB + 1) / 2);
                        AddSPImm(armOvfAreaB, false);
                        int k = 1;
                        while (k <= bpushed) {
                            int off = armOvfAreaB + 16 * (bpushed - k);
                            if (k < 16) { LdrU(k, 31, off); }
                            else { LdrU(10, 31, off); StrU(10, 31, 8 * (k - 16)); }
                            k = k + 1;
                        }
                    } else {
                        while (br >= 1) { XPopV(br); br = br - 1; } // args reversed
                    }
                    LoadLocal(0, 0);                             // this -> x0
                    BLInternal(CtorSymNg(c.baseName, methNodes[bix]));
                    if (armOvfAreaB > 0) { AddSPImm(armOvfAreaB + 16 * bpushed, true); }
                }
            }
        }
        // instance field initializers run after the base chain and before
        // the body, once per ctor (a `: this(...)` delegator lets the
        // chain target run them, so it skips its own)
        if (methStat[mi] == 2 && m.c == null) {
            // a per-instantiation ctor spec substitutes T in field
            // initializers too -- they lower through the same open nodes
            // (a `new Dict<T, int>()` initializer must specialize as well)
            bool specCtor = m.sval2 != null && m.sval2 != "";
            Cls sc = specCtor ? FindClass(cls) : null;
            List<string> sargs = null;
            if (specCtor) {
                int slt = m.sval2.IndexOf("<");
                sargs = SplitTyArgs(m.sval2.Substring(slt + 1, m.sval2.Length - slt - 2));
            }
            int fi2 = 0;
            while (fi2 < ifInitCls.Count) {
                if (ifInitCls[fi2] == cls) {
                    Fld initFld = FindField(FindClass(cls), ifInitName[fi2]);
                    string fty = initFld != null ? initFld.ty : null;
                    Node iex = ifInitExpr[fi2];
                    if (specCtor) {
                        fty = SubstTy(fty, sc.tps, sargs);
                        iex = CloneNode(iex);
                        if (iex != null) { SubstTypeNode(iex, sc.tps, sargs); }
                    }
                    GenExpr(iex);
                    if (IsDblTy(fty) && !IsDblExpr(iex)) {
                        ConvI2D();
                    } else if (fty == "int" && !IsDblExpr(iex) && !IsStrExpr(iex)) {
                        Sxtw0();                  // sxtw x0, w0 (long literal -> int)
                    }
                    XPushV0();                          // push value
                    LoadLocal(0, 0);                         // this -> x0
                    XPopV(1);                                // pop value -> x1
                    StoreFieldNg(1, 0, initFld);
                }
                fi2 = fi2 + 1;
            }
        }
        // [AtomicCas]/[AtomicLoad]/[AtomicStore]/[StaticAddr]: the Zan body
        // is a placeholder -- the emission IS the implementation. These are
        // the runtime's atomic/synchronization nexus: casal/ldar/stlr give
        // the C oracle's __atomic SEQ_CST semantics on the same instructions
        // clang emits, and the data-global address lets runtime code point
        // OSAtomic/pthread primitives at static cells (spin locks, once
        // gates) that plain static loads/stores cannot address.
        if (HasMod(m, MOD.AtomicCas())) {
            LoadLocal(0, 0);                                 // x0 = cell
            LoadLocal(1, 1);                                 // x1 = expected
            LoadLocal(2, 2);                                 // x2 = desired
            if (tgt86 == 1) {
                // casal x1, x2, [x0] == lock cmpxchg [rdi], rdx with the
                // expected preloaded into rax and the witnessed old landing
                // in v0 (arm64 leaves it in x1; x86 leaves it in rax)
                XMov(0, 6);                                  // mov rax, rsi (expected; XMov takes REAL regs -- v1 is r6)
                X1(0xF0); X1(0x48); X2(0x0F, 0xB1); X1(0x17);   // lock cmpxchg qword [rdi], rdx
                XMov(7, 0);                                  // mov rdi, rax (witnessed old -> v0)
            } else {
                E4(0xC8E1FC02);                                  // casal x1, x2, [x0]
                MovRR(0, 1);                                  // mov x0, x1 (witnessed old)
            }
            Epilogue();
            curThreadEntryNg = 0;
            tentFrame = 0;
            return;
        }
        if (HasMod(m, MOD.AtomicLoad())) {
            LoadLocal(0, 0);                                 // x0 = cell
            if (tgt86 == 1) {
                // ldar x0,[x0]: SEQ_CST acquire-load on x86 is a plain
                // mov -- every load already orders acquire per TSO
                XopRMem(0x8B, 7, 7, 0);                      // mov rdi, [rdi]
            } else {
                E4(0xC8DFFC00);                                  // ldar x0, [x0]
            }
            Epilogue();
            curThreadEntryNg = 0;
            tentFrame = 0;
            return;
        }
        if (HasMod(m, MOD.AtomicStore())) {
            LoadLocal(0, 0);                                 // x0 = cell
            LoadLocal(1, 1);                                 // x1 = value
            if (tgt86 == 1) {
                // stlr x1,[x0]: release-store is a plain mov under TSO;
                // clang emits the same plain store for seq_cst stores
                XopMemR(0x89, 6, 7, 0);                      // mov [rdi], rsi
            } else {
                E4(0xC89FFC01);                                  // stlr x1, [x0]
            }
            Epilogue();
            curThreadEntryNg = 0;
            tentFrame = 0;
            return;
        }
        if (HasMod(m, MOD.StaticAddr())) {
            string sasym = FindStaticSym(curCls, m.attrStaticAddr);
            if (sasym == null) {
                diags.Error("ngen: [StaticAddr] target '" + m.attrStaticAddr
                    + "' is not a static field of this class", m.line, m.col);
            } else {
                LoadSymRef(sasym, 0);                        // adrp x0, sym@PAGE + add
            }
            Epilogue();
            curThreadEntryNg = 0;
            tentFrame = 0;
            return;
        }
        if (m.d != null) { GenStmt(m.d); }
        if (tgt86 == 1) { XLoadImm(0, 0); } else {
        E4(0xD2800000);                                  // movz x0, #0 (fallthrough)
        }
        Epilogue();
        curThreadEntryNg = 0;
        tentFrame = 0;
    }

    // does this statement subtree contain a try anywhere (clauses chain
    // through their .b slot)?
    bool HasTry(Node n) {
        if (n == null) { return false; }
        if (n.kind == AK.TryStmt()) { return true; }
        // lock lowers to try/finally at emission: its EH bookkeeping slots
        // and the state-top mirror must be reserved exactly like a try's
        if (n.kind == AK.LockStmt()) { return true; }
        if (n.kind == AK.CatchClause()) {
            Node cc = n;
            while (cc != null) {
                if (HasTry(cc.a)) { return true; }
                cc = cc.b;
            }
            return false;
        }
        int i = 0;
        while (i < n.kids.Count) { if (HasTry(n.kids[i])) { return true; } i = i + 1; }
        return HasTry(n.a) || HasTry(n.b) || HasTry(n.c) || HasTry(n.d);
    }

    void InitLocalsNg() {
        locName = new List<string>(); locTy = new List<string>();
        locOff = new List<int>(); locRef = new List<bool>();
        locDecl = new List<Node>(); locPrev = new List<int>();
        locOpaq = new List<int>();
        locBoxed = new List<int>();
        boxNames = new List<string>();
        spanSites = new List<Node>(); spanSiteOff = new List<int>();
        paramSlotsNg = new List<int>();
        envNodes = new List<Node>(); envHeads = new List<int>();
        patStamped = new List<Node>();
        locHead = -1; nloc = 0;
    }

    // pattern-binding pre-pass: switch-expression type patterns (`Shape s
    // =>`) and `is`-type bindings (`x is Animal a`) name a hidden local the
    // arm code stores the (cast) scrutinee into. Like the compound-assign
    // temps, the slots must exist before codegen -- the frame size is fixed
    // at the prologue -- so ReserveLocals stamps them up front. Unconditional
    // AddLoc gives C# shadowing (a binding hides an outer same-name local
    // head-first); patStamped keeps the recursive walk from double-adding.
    void StampPatternBindings(Node n) {
        if (n == null) { return; }
        if (n.kind == AK.SwitchExpr() && !patStamped.Contains(n)) {
            patStamped.Add(n);
            int i = 0;
            while (i < n.kids.Count) {
                Node arm = n.kids[i];
                if (arm != null && arm.ival == 1 && arm.sval != null) {
                    AddLoc(arm.sval, arm.type != null ? TypeFullName(arm.type) : "object", false);
                }
                i = i + 1;
            }
        } else if (n.kind == AK.IsExpr() && !patStamped.Contains(n)) {
            patStamped.Add(n);
            if (n.sval != null) {
                AddLoc(n.sval, n.type != null ? TypeFullName(n.type) : "object", false);
            }
        } else if (n.kind == AK.SwitchCase() && !patStamped.Contains(n)) {
            // statement switch: `case T x [when g]:` (the parser leaves
            // sval unset when no binding is named; `case null:` has no type)
            patStamped.Add(n);
            if (n.ival == 1 && n.type != null && n.sval != null && n.sval != "") {
                AddLoc(n.sval, TypeFullName(n.type), false);
            }
        }
        StampPatternBindings(n.a);
        StampPatternBindings(n.b);
        StampPatternBindings(n.c);
        StampPatternBindings(n.d);
        if (n.kids != null) {
            int i = 0;
            while (i < n.kids.Count) { StampPatternBindings(n.kids[i]); i = i + 1; }
        }
    }

    // ---- tuples: `(T1, T2)` values are the synthesized __Tuple_<elems>
    // classes (parser mangles the name into the type ref's sval). ngen
    // registers the layout on demand -- Item1..N fields at 8-byte strides,
    // boxed like any class instance -- so .ItemN reads resolve through the
    // ordinary field path and the literal allocates and stores by field.
    // Unlike gen0's LLVM struct values these are heap pointers, but the
    // observable behavior (construction, member reads, deconstruction)
    // matches as long as nobody mutates through two aliases of one tuple.

    // the parser's SanTy: alphanumerics kept, '[' -> A, '?' -> q, every
    // other non-alphanumeric collapses to one underscore
    string SanTyNg(string s) {
        string r = "";
        int i = 0;
        while (i < s.Length) {
            int c = s[i];
            if ((c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57)) { r = r + Convert.ToString((char)c); }
            else if (c == 91) { r = r + "A"; }
            else if (c == 63) { r = r + "q"; }
            else if (r.Length > 0 && r.Substring(r.Length - 1, 1) != "_") { r = r + "_"; }
            i = i + 1;
        }
        while (r.Length > 0 && r.Substring(r.Length - 1, 1) == "_") { r = r.Substring(0, r.Length - 1); }
        return r;
    }

    string TupleMangleNg(List<string> etys) {
        string r = "__Tuple_";
        int i = 0;
        while (i < etys.Count) {
            if (i > 0) { r = r + "_"; }
            r = r + SanTyNg(etys[i]);
            i = i + 1;
        }
        return r;
    }

    // static element type of a tuple literal's element expression
    string TupleElemTyNg(Node e) {
        string t = e != null ? InferExprTyNg(e) : null;
        return t != null && t != "" ? t : "object";
    }

    // mangled name of a tuple literal, memoized onto the node (StaticTyOf
    // asks repeatedly and the element inference is not free)
    string TupleExprMangledNg(Node e) {
        if (e.sval2 != null && e.sval2 != "") { return e.sval2; }
        List<string> etys = new List<string>();
        int i = 0;
        while (i < e.kids.Count) { etys.Add(TupleElemTyNg(e.kids[i])); i = i + 1; }
        e.sval2 = TupleMangleNg(etys);
        return e.sval2;
    }

    void EnsureTupleClsNg(string name, List<string> etys) {
        if (FindClass(name) != null) { return; }
        Cls c = new Cls(name);
        int i = 0;
        while (i < etys.Count) {
            c.flds.Add(new Fld("Item" + Convert.ToString(i + 1), i * 8, etys[i]));
            i = i + 1;
        }
        c.size = etys.Count * 8;
        RegCls(c);
    }

    void TupleSweepTyNg(Node t) {
        if (t == null) { return; }
        if (t.op == 2 && t.sval != null && t.sval.IndexOf("__Tuple_") == 0) {
            List<string> etys = new List<string>();
            int i = 0;
            while (i < t.kids.Count) { etys.Add(TypeFullName(t.kids[i])); i = i + 1; }
            EnsureTupleClsNg(t.sval, etys);
            return;
        }
        TupleSweepTyNg(t.a);
        int k = 0;
        if (t.kids != null) {
            while (k < t.kids.Count) { TupleSweepTyNg(t.kids[k]); k = k + 1; }
        }
    }

    void TupleSweepNg(Node n) {
        if (n == null) { return; }
        if (n.kind == AK.TupleExpr()) {
            List<string> etys = new List<string>();
            int i = 0;
            while (i < n.kids.Count) { etys.Add(TupleElemTyNg(n.kids[i])); i = i + 1; }
            EnsureTupleClsNg(TupleMangleNg(etys), etys);
        }
        TupleSweepNg(n.a);
        TupleSweepNg(n.b);
        TupleSweepNg(n.c);
        TupleSweepNg(n.d);
        if (n.kids != null) {
            int i = 0;
            while (i < n.kids.Count) { TupleSweepNg(n.kids[i]); i = i + 1; }
        }
    }

    // whole method: return type, parameter types and body. Runs at the
    // program sweep (so cross-method order never matters -- Main may read
    // GetPair().Item2 before GetPair's body is ever emitted) and again per
    // method for later-synthesized specializations.
    void TupleSweepMethodNg(Node m) {
        if (m == null) { return; }
        TupleSweepTyNg(m.type);
        int pi = 0;
        while (pi < m.kids.Count) {
            if (m.kids[pi].kind == AK.Param()) { TupleSweepTyNg(m.kids[pi].type); }
            pi = pi + 1;
        }
        TupleSweepNg(m.d);
    }

    // deconstruction element type: the declared per-target type, else the
    // rhs tuple's registered field type (the program sweep guarantees the
    // class exists by the time any method body is emitted)
    string TupleDeconElemTyNg(Node rhs, int i) {
        if (rhs != null && rhs.kind == AK.TupleExpr() && i < rhs.kids.Count) {
            return TupleElemTyNg(rhs.kids[i]);
        }
        string rt = rhs != null ? InferExprTyNg(rhs) : null;
        if (rt != null && rt.IndexOf("__Tuple_") == 0) {
            Cls c = FindClass(rt);
            if (c != null && i < c.flds.Count) { return c.flds[i].ty; }
        }
        return "object";
    }

    // declared types inside a specialization body: a local or param declared
    // with the CLASS's type parameter ("T keep = item;") burns the parameter
    // name into locTy at decl time, and every type-keyed lowering (ToString
    // dispatch, string/bool/double probes, scalar classification) then sees
    // an unresolvable "T" and falls into name-match dispatch. Field reads
    // resolve lazily through CurField/sval2, and CallRetTy substitutes
    // member-call returns -- declared locals need the same substitution.
    // Open template bodies (no sval2) keep the erased parameter.
    string CurDeclTyNg(string ty) {
        if (ty == null || curMeth == null || curMeth.sval2 == null
                || curMeth.sval2 == "") { return ty; }
        int lt = curMeth.sval2.IndexOf("<");
        if (lt <= 0) { return ty; }
        Cls c = FindClass(curMeth.sval2.Substring(0, lt));
        if (c == null || c.tps.Count == 0) { return ty; }
        List<string> args = SplitTyArgs(curMeth.sval2.Substring(lt + 1, curMeth.sval2.Length - lt - 2));
        if (args.Count != c.tps.Count) { return ty; }
        return SubstTy(ty, c.tps, args);
    }

    // Frame allocation and visibility are separate. Leaving a lexical scope
    // restores its chain head, never its allocated storage.
    void AddLoc(string name, string ty, bool isRef) {
        ty = CurDeclTyNg(ty);
        locName.Add(name); locTy.Add(ty); locOff.Add(16 * nloc);
        locRef.Add(isRef); locDecl.Add(null); locPrev.Add(locHead);
        locOpaq.Add(0);
        locBoxed.Add(0);
        locHead = nloc; nloc = nloc + 1;
    }

}
