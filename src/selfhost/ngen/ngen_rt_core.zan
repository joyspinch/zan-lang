using System;
using System.Collections.Generic;
namespace Zan;

partial class Ngen {

    void EmitRtCore() {
        strs.Add("zan: out of memory\n");
        oomIdx = strs.Count - 1;
        strs.Add("%lld\n");
        fmtiIdx = strs.Count - 1;
        strs.Add("%s\n");
        fmtsIdx = strs.Count - 1;
        strs.Add("%lld");
        fmtnIdx = strs.Count - 1;
        strs.Add("%llu");
        fmtuIdx = strs.Count - 1;
        strs.Add("%llu\n");
        fmtuNIdx = strs.Count - 1;
        strs.Add("%s");
        fmtwIdx = strs.Count - 1;
        strs.Add("%lc");
        fmtcIdx = strs.Count - 1;
        strs.Add("");
        emptyIdx = strs.Count - 1;
        strs.Add("Unhandled exception: ");
        fmtUnhandledIdx = strs.Count - 1;
        strs.Add("Unhandled exception (class object)");
        fmtUnhandledClsIdx = strs.Count - 1;
        strs.Add("Unhandled exception");
        fmtUnhandledBareIdx = strs.Count - 1;
        dglbs.Add(new DGlob("zan_eh", 8, dataLen));
        dataLen = dataLen + 8;
        // batch 27: the soft-diag scratch cell (64 zeroed bytes) -- the
        // softdiag probe DllImports its getter, and the zan-native runtime
        // owns the face now instead of the stale C-host rest stubs
        dglbs.Add(new DGlob("zan_soft_scratch", 64, dataLen));
        dataLen = dataLen + 64;
        if (tgt86 == 1) {
            // batch 16 opener: only the cores kernel1's surface needs are
            // ported. Anything else stays un-emitted, so a program that
            // references it dies at link time (unresolved internal symbol)
            // instead of running arm64 semantics on x86_64. The host
            // argc/argv slots are data-only and unconditional: the _main
            // shim stores through them. The string pool is emitted once by
            // the compile epilogue (it trails every other section).
            dglbs.Add(new DGlob("host_argc", 8, dataLen)); dataLen = dataLen + 8;
            dglbs.Add(new DGlob("host_argv", 8, dataLen)); dataLen = dataLen + 8;
            RtEmitPrintInt();
            RtEmitPrintln();
            // batch 17: the object-model + string slice (kernel2 surface)
            RtEmitAlloc();
            RtEmitStrAlloc();
            RtEmitStrCat2();
            RtEmitStrlen0();
            // batch 19: the exception slice (kernel4 surface)
            RtEmitEhState();
            // batch 20: the int->string concat slice (kernel5 surface)
            RtEmitInt2Str();
            RtEmitUint2Str();
            // batch 21: the guard slice (kernel6 surface) — division/
            // modulo zero-divide guard family + its own lock core
            EmitGuardRuntime();
            // batch 22: the double slice (kernel7 surface) — %g writer,
            // parse specials, dbl2str heap string + print shim
            EmitNumericRuntime();
            RtEmitDbl2Str();
            RtEmitPrintDouble();
            // batch 23: the ulong print shim (kernel8 surface)
            RtEmitPrintUint();
            // batch 24: the string-method family (kernel9 surface) --
            // strcmp0/substr2/chrstr builders + the header/length/index
            // reader family with its own darwin vm_read probe
            RtEmitStrcmp0();
            RtEmitSubstr2();
            RtEmitChrstr();
            EmitStringRuntime();
            // batch 26: the kernel11 surface -- join + list removeat
            // (Contains/IndexOf run inline via GenListSearch)
            RtEmitStrjoin();
            RtEmitListRemoveAt();
            // batch 30: the two-argument Substring faces (safe-window clamp
            // and the raw-receiver form)
            RtEmitSubstr3();
            RtEmitSubstrRaw();
            // batch 28: the dict lane -- the linear-walk core
            // (index/set/get/contains/remove/clear/tryget/keys/values);
            // GenDictNew's calloc/alloc site was already dual-arm
            RtEmitDictIndex();
            RtEmitDictSet();
            RtEmitDictGet();
            RtEmitDictQuery();
            RtEmitDictTryGet();
            RtEmitDictKeysValues(16);
            RtEmitDictKeysValues(24);
            // batch 29: the list operation family -- insert/reverse/
            // reserve/indexof(+str)/addrange/toarray/toarray_f32
            RtEmitListInsert();
            RtEmitListReverse();
            RtEmitListReserve();
            RtEmitListIndexOf(false);
            RtEmitListIndexOf(true);
            RtEmitListAddRange();
            RtEmitListToArray(8);
            RtEmitListToArray(4);
            RtEmitListToArray(2);
            RtEmitListToArray(1);
            RtEmitListToArrayF32();
            // batch 27: the soft-diag scratch getter (both lanes; the face
            // no longer depends on the frozen C-host rest stubs)
            RtEmitSoftScratch();
            // batch 34: the zan-emitted FIPS 180-4 digest (both lanes)
            EmitZanSha256();
            // batch 35: the host family (args/files/paths/sb/utf8/digests/
            // host2) -- the string-op half has been on since batch 31
            EmitHostRuntime();
            // 批 35:HostEmitFail/Copy/StrOps/StrContains 已并入
            // EmitHostRuntime 的面家族(此处曾重复调用,链接期
            // atomShouldReplaceExisting 断言崩),单独入口删除
            // 批 35:七个 C 宿主原语的 zan 本体(exe_path/urandom/
            // thread_id/hmac;sha1/md5/sha512 随后加入)——x86 链接
            // 零运行时对象,arm64 保持 C 宿主,故仅 x86 发射
            EmitZanHostPrims();
            return;
        }
        RtEmitAlloc();
        RtEmitStrAlloc();
        RtEmitStrCat2();
        RtEmitStrlen0();
        RtEmitStrcmp0();
        RtEmitPrintInt();
        RtEmitPrintln();
        RtEmitInt2Str();
        RtEmitDbl2Str();
        RtEmitPrintDouble();
        RtEmitUint2Str();
        RtEmitFmt();
        RtEmitListOps();
        RtEmitPrintUint();
        RtEmitChrstr();
        RtEmitSubstr2();
        RtEmitSubstr3();
        RtEmitSubstrRaw();
        RtEmitStrjoin();
        RtEmitSoftScratch();
        RtEmitEhState();
        EmitHostRuntime();
        EmitNumericRuntime();
        EmitGuardRuntime();
        EmitStringRuntime();
    }

    // ptr _zan_rt_eh_state(): the exception-state block. The STORAGE is
    // per-thread (zan_eh_tls_state, __thread in the transition runtime /
    // a static block in the qemu stub): it used to sit behind one
    // process-global pointer, and with real OS threads a thread could
    // longjmp into a slot armed by another frame's thread (the
    // exception_threads case). The block layout stays compiler-owned:
    // { i32 top, ptr exc, 256 x 1024-byte setjmp slots }.
    void RtEmitEhState() {
        syms.Add(new Sym("_zan_rt_eh_state", FnPad()));
        if (tgt86 == 1) {
            // the x86 lane owns the storage: lazy calloc once, the cached
            // block pointer living in a compiler-owned __data quad. No
            // threads exist on this lane yet, so a process-global cache has
            // the same semantics as the qemu stub's static block; revisit
            // to per-thread storage when ThreadEntry lands.
            dglbs.Add(new DGlob("zan_eh_state_cache", 8, dataLen)); dataLen = dataLen + 8;
            RtPrologue();
            LoadSymRef(DGlobalSym("zan_eh_state_cache"), 1);
            LdrU(0, 1, 0);
            CbzReg(0, NL());
            int have = lblPos.Count - 1;
            RtEpilogue();
            Mark(have);
            LoadImm(0, 16 + 256 * 1024);             // { i32 top, ptr exc, 256 x 1024-byte setjmp slots }
            LoadImm(1, 1);
            BLExtern("_calloc");
            CbzReg(0, NL());
            int oom = lblPos.Count - 1;
            MovRR(9, 0);                             // r9 = block
            LoadSymRef(DGlobalSym("zan_eh_state_cache"), 1);
            StrU(9, 1, 0);                           // cache = block
            RtEpilogue();
            Mark(oom);
            RtOom();
            return;
        }
        RtPrologue();
        BLExtern("_zan_eh_tls_state");
        RtEpilogue();
    }

    // ptr zan_rt_soft_scratch(): stable process-global 64-byte zeroed cell.
    // The compiler's generic lowering (irgen_generics.c: emit_soft_scratch_cached)
    // takes the pointer once per function entry and caches it in a stack slot.
    void RtEmitSoftScratch() {
        syms.Add(new Sym("_zan_rt_soft_scratch", FnPad()));
        RtPrologue();
        LoadSymRef(DGlobalSym("zan_soft_scratch"), 0);
        RtEpilogue();
    }

    // ptr zan_rt_alloc(i64 size, i64 desc): zeroed (calloc), rc=1, desc at raw+8
    void RtEmitAlloc() {
        syms.Add(new Sym("_zan_rt_alloc", FnPad()));
        RtPrologue();
        if (tgt86 == 1) {
            // rdi=size, rsi=desc. The desc survives calloc in the [rsp]
            // scratch; the payload hands back raw+16.
            XSubRsp(16);
            XopMemR(0x89, 6, 4, 0);              // mov [rsp], rsi
            X4(0x107F8D48);          // lea rdi, [rdi+16]
            XLoadImm(1, 1);                      // mov rsi, 1
            BLExtern("_calloc");
            CbzReg(0, NL());
            int oom = lblPos.Count - 1;
            XLoadImm(2, 1);
            XopMemR(0x89, 2, 7, 0);              // mov [rdi], rdx (rc=1)
            XopRMem(0x8B, 6, 4, 0);              // mov rsi, [rsp]
            XopMemR(0x89, 6, 7, 8);              // mov [rdi+8], rsi (desc)
            X4(0x107F8D48);          // lea rdi, [rdi+16]
            XAddRsp(16);
            RtEpilogue();
            Mark(oom);
            RtOom();
            return;
        }
        AddSPImm(16, false);      // sub sp, sp, #16 (scratch below the saved pair)
        StrU(1, 31, 0);           // str x1, [sp]      (save desc)
        AddImm(0, 0, 16);
        LoadImm(1, 1);
        BLExtern("_calloc");
        CbzReg(0, NL());
        int oom = lblPos.Count - 1;
        LoadImm(2, 1);
        StrU(2, 0, 0);
        LdrU(1, 31, 0);
        StrU(1, 0, 8);
        AddImm(0, 0, 16);
        AddSPImm(16, true);       // add sp, sp, #16
        RtEpilogue();
        Mark(oom);
        RtOom();
    }

    // _vtinit_<Cls>: build the class's vtable once -- calloc the slot array,
    // store each slot's effective implementation address (adrp+add materializes
    // the text symbol at runtime, so no data relocations are needed), and
    // publish it in the class's lazy data slot. Returns the table in x0.
    void EmitVtInit(Cls c) {
        syms.Add(new Sym("_vtinit_" + c.name, FnPad()));
        RtPrologue();
        List<string> slots = new List<string>();
        CollectVSlotsNg(c.name, slots);
        // an all-abstract class (interface) legitimately leaves slots
        // unimplemented; such a class is never instantiated, so it gets no
        // table rather than a half-built one
        int pre = 0;
        while (pre < slots.Count) {
            string pc2 = VSlotImplCls(c.name, slots[pre]);
            if (pc2 == null || FindInstanceInClsKey(pc2, slots[pre]) == null) {
                RtEpilogue();
                return;
            }
            pre = pre + 1;
        }
        LoadImm(0, slots.Count * 8);
        LoadImm(1, 1);
        BLExtern("_calloc");
        int okL = NL();
        CbnzReg(0, okL);
        RtOom();
        Mark(okL);
        int s = 0;
        while (s < slots.Count) {
            string implCls = VSlotImplCls(c.name, slots[s]);
            Node impl = FindInstanceInClsKey(implCls, slots[s]);
            LoadSymRef(MethSymNg(implCls, impl), 1);
            StrU(1, 0, s * 8);
            s = s + 1;
        }
        LoadSymRef(DGlobalSym("vt." + c.name), 9);
        StrU(0, 9, 0);                                   // publish the table
        RtEpilogue();
    }
}
