using System;
using System.Collections.Generic;
namespace Zan;

// Irgen part: statement codegen, vtable emission for polymorphic classes
// and the non-emitting argument typer used for overload resolution.
partial class Irgen {
    // ---- statements ----
    void GenStmt(Node s) {
        if (s == null) { return; }
        // A label is a branch target, so it must be emitted even when the
        // current block is already terminated (e.g. code after a goto).
        if (s.kind == AK.LabelStmt()) {
            int lid = LabelId(s.sval);
            if (!term) { L("  br label %L" + lid); }
            Label(lid);
            return;
        }
        if (term) { return; }
        int k = s.kind;
        if (IsAwaitStmt(s)) { GenAwaitStmt(s); return; }
        if (curAsync && k == AK.ReturnStmt()) { GenAsyncReturn(s); return; }
        if (k == AK.Block()) {
            int scopeStart = locName.Count;
            int i = 0;
            while (i < s.kids.Count) { GenStmt(s.kids[i]); i = i + 1; }
            if (!term) { ReleaseLocalsFrom(scopeStart); }
            TrimLocals(scopeStart);
        } else if (k == AK.VarDecl()) {
            stmtTemps = new List<string>(); stmtTempTypes = new List<Node>();
            GenVarDecl(s);
            EmitTempReleases();
        } else if (k == AK.DeconDecl()) {
            GenDecon(s);
        } else if (k == AK.ExprStmt()) {
            stmtTemps = new List<string>(); stmtTempTypes = new List<Node>();
            ExprVal ev = GenExpr(s.a);
            // an async method called as a statement only allocates its frame:
            // hand it to the scheduler so the body runs
            EmitAsyncDetach(ev);
            EmitTempReleases();
        } else if (k == AK.ReturnStmt()) {
            if (s.a != null) {
                stmtTemps = new List<string>(); stmtTempTypes = new List<Node>();
                ExprVal v = GenExpr(s.a);
                if (curRet == "void") {
                    EmitTempReleases();
                    ReleaseLocalsFrom(0);
                    L("  ret void");
                } else {
                    ExprVal src = StrSlotConv(curRetTy, v);
                    string rv = Coerce(src, curRet);
                    EmitArcRetain(rv, v.ty);
                    EmitTempReleases();
                    ReleaseLocalsFrom(0);
                    L("  ret " + curRet + " " + rv);
                }
            } else {
                ReleaseLocalsFrom(0);
                L("  ret void");
            }
            term = true;
        } else if (k == AK.IfStmt()) {
            GenIf(s);
        } else if (k == AK.WhileStmt()) {
            GenWhile(s);
        } else if (k == AK.DoWhileStmt()) {
            GenDoWhile(s);
        } else if (k == AK.ForStmt()) {
            GenFor(s);
        } else if (k == AK.ForeachStmt()) {
            GenForeach(s);
        } else if (k == AK.SwitchStmt()) {
            GenSwitchStmt(s);
        } else if (k == AK.TryStmt()) {
            GenTry(s);
        } else if (k == AK.ThrowStmt()) {
            GenThrow(s);
        } else if (k == AK.BreakStmt()) {
            if (brkTarget > 0) { ReleaseLocalsFrom(loopScopeBase); L("  br label %L" + brkTarget); term = true; }
        } else if (k == AK.ContinueStmt()) {
            if (contTarget > 0) { ReleaseLocalsFrom(loopScopeBase); L("  br label %L" + contTarget); term = true; }
        } else if (k == AK.GotoStmt()) {
            int gid = LabelId(s.sval);
            L("  br label %L" + gid);
            term = true;
        } else {
            GenExpr(s);
        }
    }

    bool IsClassPtr(string s) {
        if (s.Length < 2) { return false; }
        if (s.Substring(0, 1) != "%") { return false; }
        if (s.Substring(s.Length - 1, 1) != "*") { return false; }
        return true;
    }

    // Any LLVM pointer type (class pointer, array i64*, generic i8*, etc.).
    bool IsPtrLL(string s) {
        if (s == null) { return false; }
        int len = s.Length;
        if (len > 0 && s.Substring(len - 1, 1) == "*") { return true; }
        return false;
    }

    // when null literal, retype to the target LLVM type; bitcast class pointers
    // (e.g. a derived instance stored into a base-typed slot)
    string Coerce(ExprVal v, string llty) {
        if (v.op == "null") { if (llty == "i64") { return "0"; } return "null"; }
        if (v.op == "0" && IsPtrLL(llty)) { return "null"; }
        // vector slots: scalar zero folds to zeroinitializer; other scalars
        // never reach here (vectors only mix with vectors)
        if (llty.Length > 0 && llty.Substring(0, 1) == "<") {
            if (v.op == "0") { return "zeroinitializer"; }
            return v.op;
        }
        string vt = MapType(v.ty);
        // erased i64 slots: pack pointers via ptrtoint / unpack via inttoptr
        if (llty == "i64" && IsPtrLL(vt)) { return ToI64(v.op, vt); }
        if (vt == "i64" && IsPtrLL(llty)) {
            string tp = NT();
            L("  " + tp + " = inttoptr i64 " + v.op + " to " + llty);
            return tp;
        }
        // a reference stored into a class-typed slot: bitcast the pointer.
        // The source may be a plain `i8*` (an `object` slot) -- the class
        // pointer and the object pointer are the same address.
        if (vt != llty && IsPtrLL(vt) && IsClassPtr(llty)) {
            string t = NT();
            L("  " + t + " = bitcast " + vt + " " + v.op + " to " + llty);
            return t;
        }
        // implicit integer -> double promotion (e.g. `double x = 5;`)
        if (vt == "i64" && llty == "double") {
            string t = NT();
            L("  " + t + " = sitofp i64 " + v.op + " to double");
            return t;
        }
        return v.op;
    }

    // ---- vtable emission for polymorphic classes ----
    // Slots are matched by name AND parameter tags so overloaded virtual
    // methods each get their own slot bound to the right definition symbol.
    void EmitVtable(Node cls) {
        List<Node> ms = new List<Node>();
        CollectVSlotNodes(cls, ms);
        string s = "@" + cls.sval + "_vtable = global [" + ms.Count + " x i8*] [";
        int i = 0;
        while (i < ms.Count) {
            Node sm = ms[i];
            string tags = ParamTags(sm);
            string impl = "";
            Node im = null;
            Node c = cls;
            while (c != null) {
                Node f = FindMethodSig(c, sm.sval, tags);
                if (f != null && !IsAbstract(f)) { impl = c.sval; im = f; c = null; }
                else { c = BaseClassOf(c); }
            }
            if (im == null) { impl = ResolveImpl(cls, sm.sval); im = FindMethodUp(cls, sm.sval); }
            if (i > 0) { s = s + ", "; }
            s = s + "i8* bitcast (" + MethodFnTypeThis(im, impl) + " @" + MethodSym(impl, im) + " to i8*)";
            i = i + 1;
        }
        s = s + "]";
        H(s);
    }

    // "_tag1_tag2" parameter-type signature of a method, for overload matching.
    string ParamTags(Node m) {
        string s = "";
        int i = 0;
        while (i < m.kids.Count) {
            Node p = m.kids[i];
            if (p.kind == AK.Param()) { s = s + "_" + TypeTag(p.type); }
            i = i + 1;
        }
        return s;
    }

    // method declared directly on cls with the given name and parameter tags
    Node FindMethodSig(Node cls, string name, string tags) {
        if (cls == null) { return null; }
        int i = 0;
        while (i < cls.kids.Count) {
            Node m = cls.kids[i];
            if (m.kind == AK.MethodDecl() && m.sval == name && ParamTags(m) == tags) { return m; }
            i = i + 1;
        }
        return null;
    }

    Node FindMethodUp(Node cls, string name) {
        Node c = cls;
        while (c != null) {
            Node m = binder.FindMethod(c, name);
            if (m != null) { return m; }
            c = BaseClassOf(c);
        }
        return null;
    }

    string MethodOwner(Node cls, string name) {
        Node c = cls;
        while (c != null) {
            if (binder.FindMethod(c, name) != null) { return c.sval; }
            c = BaseClassOf(c);
        }
        return "";
    }

    // The class that declares the method `m` (walking the chain from `cls`).
    // The symbol of a call has to name the DECLARING class: an overload
    // inherited from a base is defined under the base's name, and a name-only
    // lookup would point the call at the derived class (no such symbol).
    string DeclOwnerOf(Node cls, Node m) {
        if (cls == null || m == null) { return ""; }
        string tags = ParamTags(m);
        Node c = cls;
        while (c != null) {
            Node f = FindMethodSig(c, m.sval, tags);
            if (f != null) { return c.sval; }
            c = BaseClassOf(c);
        }
        return cls.sval;
    }

    // Is a method with the same parameter signature already in the list? A
    // derived member hides a base member with the same signature, so the base
    // one is not a separate candidate.
    bool HasSameSig(List<Node> cands, Node m) {
        string tags = ParamTags(m);
        int i = 0;
        while (i < cands.Count) {
            if (ParamTags(cands[i]) == tags) { return true; }
            i = i + 1;
        }
        return false;
    }

    // Does the method accept this many positional arguments? A `params` tail
    // array takes the arguments the fixed parameters do not.
    bool AcceptsArity(Node m, int argc) {        if (m == null) { return false; }
        int tot = 0; int req = 0; int j = 0;
        Node lastP = null;
        while (j < m.kids.Count) {
            if (m.kids[j].kind == AK.Param()) {
                tot = tot + 1;
                if (m.kids[j].b == null) { req = req + 1; }
                lastP = m.kids[j];
            }
            j = j + 1;
        }
        bool vparams = lastP != null && lastP.op == 1;
        if (argc >= req && argc <= tot) { return true; }
        if (vparams && argc >= req - 1) { return true; }
        return false;
    }

    // Number of methods named `name` declared directly in `cls`.
    int MethodCount(Node cls, string name) {
        if (cls == null) { return 0; }
        int n = 0;
        int i = 0;
        while (i < cls.kids.Count) {
            Node m = cls.kids[i];
            if (m.kind == AK.MethodDecl() && m.sval == name) { n = n + 1; }
            i = i + 1;
        }
        return n;
    }

    // A type name reduced to a symbol-safe tag for overload mangling.
    string TypeTag(Node t) {
        if (t == null) { return "v"; }
        if (t.sval == "") { return "v"; }
        string s = t.sval;
        int i = 0;
        while (i < t.kids.Count) { s = s + "." + TypeTag(t.kids[i]); i = i + 1; }
        return s;
    }

    // does a type reference mention an unbound generic type parameter?
    bool MentionsTypeParam(Node t) {
        if (t == null) { return false; }
        if (binder.IsTypeParam(t.sval)) { return true; }
        int i = 0;
        while (i < t.kids.Count) { if (MentionsTypeParam(t.kids[i])) { return true; } i = i + 1; }
        return false;
    }

    // static type of an expression-bodied lambda's result, with its typed
    // parameters visible (only same-name parameter references are resolved).
    Node LambdaRetType(Node lam) {
        if (lam == null || lam.a == null) { return null; }
        Node b = lam.a;
        if (b.kind == AK.Ident()) {
            int i = 0;
            while (i < lam.kids.Count) {
                Node p = lam.kids[i];
                if (p.kind == AK.Param() && p.sval == b.sval) { return p.type; }
                i = i + 1;
            }
            return null;
        }
        return ArgTypeNode(b);
    }

    // The LLVM symbol for a method. Non-overloaded names stay `Owner_Name`
    // (so all existing output -- including the self-host fixed point, which
    // has no overloads -- is unchanged); an overloaded name gains an arity and
    // per-parameter-type suffix so each overload is a distinct definition.
    string MethodSym(string owner, Node m) {
        if (HasMod(m, MOD.Extern())) {
            // NativeMemory hardware helpers route to the zan_hw_* C runtime
            // symbols (the C host's routing); inline-lowered methods never
            // reach here because their call sites return before symbol lookup
            if (owner == "NativeMemory") { return "zan_hw_" + ExternName(m); }
            return ExternName(m);
        }
        Node oc = binder.FindType(owner);
        if (MethodCount(oc, m.sval) <= 1) { return owner + "_" + m.sval; }
        StringBuilder sb = new StringBuilder();
        sb.Append(owner);
        sb.Append("_");
        sb.Append(m.sval);
        sb.Append("__");
        int i = 0;
        while (i < m.kids.Count) {
            Node p = m.kids[i];
            if (p.kind == AK.Param()) {
                sb.Append("_");
                sb.Append(TypeTag(p.type));
            }
            i = i + 1;
        }
        return sb.ToString();
    }

    // number of constructor declarations in a class
    int CtorDeclCount(Node cls) {
        if (cls == null) { return 0; }
        int n = 0; int i = 0;
        while (i < cls.kids.Count) {
            if (cls.kids[i].kind == AK.CtorDecl()) { n = n + 1; }
            i = i + 1;
        }
        return n;
    }

    // Symbol for a constructor. With a single ctor this stays the historical
    // `Type_ctor`; with overloads the parameter types are appended (mirrors
    // MethodSym) so two ctors cannot collide on one LLVM symbol.
    string CtorSym(string owner, Node ctor) {
        if (CtorDeclCount(binder.FindType(owner)) <= 1) { return owner + "_ctor"; }
        string s = owner + "_ctor__";
        int i = 0;
        while (i < ctor.kids.Count) {
            Node p = ctor.kids[i];
            if (p.kind == AK.Param()) { s = s + "_" + TypeTag(p.type); }
            i = i + 1;
        }
        return s;
    }

    // ---- non-emitting argument typer (for overload resolution only) ----
    // Yields the static type of an argument expression without generating any
    // IR. Returns null when the type cannot be determined; callers treat that
    // as "compatible with anything" so nothing is mis-resolved.
    Node ArgTypeNode(Node e) {
        if (e == null) { return null; }
        int k = e.kind;
        if (k == AK.IntLit()) { return MkType("int"); }
        if (k == AK.FloatLit()) { return MkType("double"); }
        if (k == AK.StringLit()) { return MkType("string"); }
        if (k == AK.CharLit()) { return MkType("char"); }
        if (k == AK.BoolLit()) { return MkType("bool"); }
        if (k == AK.ThisExpr()) { return MkType(curClass); }
        if (k == AK.CastExpr()) { return e.type; }
        if (k == AK.NewExpr()) { return e.type; }
        if (k == AK.IsExpr()) { return MkType("bool"); }
        if (k == AK.Ident()) {
            int li = LocalIdx(e.sval);
            if (li >= 0) { return locType[li]; }
            return FieldType(binder.FindType(curClass), e.sval);
        }
        if (k == AK.MemberAccess()) {
            Node cls = ClassOf(ArgTypeNode(e.a));
            if (cls != null) { return FieldType(cls, e.sval); }
            return null;
        }
        if (k == AK.Unary()) { if (e.op == TK.Bang()) { return MkType("bool"); } return ArgTypeNode(e.a); }
        if (k == AK.PostfixUnary()) { return ArgTypeNode(e.a); }
        if (k == AK.Binary()) {
            int op = e.op;
            if (op == TK.EqEq() || op == TK.BangEq() || op == TK.Less() || op == TK.Greater()
                || op == TK.LessEq() || op == TK.GreaterEq() || op == TK.AmpAmp() || op == TK.PipePipe()) {
                return MkType("bool");
            }
            Node lt = ArgTypeNode(e.a);
            Node rt = ArgTypeNode(e.b);
            if (IsStr(lt) || IsStr(rt)) { return MkType("string"); }
            if (lt != null) { return lt; }
            return rt;
        }
        if (k == AK.Index()) {
            Node ot = ArgTypeNode(e.a);
            if (ot != null) {
                if (IsListType(ot)) { return ListElem(ot); }
                if (ot.sval == "string") { return MkType("char"); }
            }
            return null;
        }
        return null;
    }

    // Full tag (including generic arguments) so e.g. List<int> vs List<double>
    // overloads score an exact match instead of tying as ambiguous.
    string ArgTag(Node e) { Node t = ArgTypeNode(e); if (t == null) { return ""; } return TypeTag(t); }

    // How well candidate `m` fits the call `e`: +1 for matching the caller's
    // static/instance context, +4 for each exact argument-type match, -1 for a
    // known mismatch (an implicit conversion may still apply, so it is not
    // disqualifying). Unknown argument types are neutral.
    int ScoreCand(Node m, Node e, int argc, bool wantStatic) {
        int score = 0;
        if (IsStatic(m) == wantStatic) { score = score + 1; }
        int a = 0;
        while (a < argc) {
            Node pt = ParamTypeNode(m, a);
            Node arg = e.kids[a];
            if (arg.kind == AK.Lambda()) {
                // score a lambda argument by its result type against the
                // delegate parameter's declared return type
                Node dd = null;
                if (pt != null) { dd = binder.FindDelegate(pt.sval); }
                if (dd != null) {
                    Node lrt = LambdaRetType(arg);
                    if (lrt != null && !MentionsTypeParam(dd.type)) {
                        if (TypeTag(lrt) == TypeTag(dd.type)) { score = score + 4; }
                        else { score = score - 1; }
                    }
                }
                a = a + 1;
                continue;
            }
            string at = ArgTag(arg);
            if (at != "") {
                if (at == TypeTag(pt)) { score = score + 4; }
                else if (MentionsTypeParam(pt)) { score = score + 2; }
                else { score = score - 1; }
            }
            a = a + 1;
        }
        return score;
    }

    // Select the method named `name` in `cls` for the call `e`. With a single
    // candidate the behaviour is unchanged (arity is not consulted, so
    // default-argument calls still resolve, and the self-host fixed point --
    // which has no overloads -- emits byte-identical IR). With several
    // overloads we keep those whose arity admits the call, then pick the best
    // argument-type match for the caller's static/instance context; an empty
    // candidate set or a tie is a diagnostic.
    Node ResolveMethod(Node cls, string name, Node e, bool wantStatic) {
        if (cls == null) { return null; }
        // The candidates are the class's own overloads PLUS the inherited ones:
        // C# resolves a call over the whole hierarchy, and a derived member
        // hides a base one only when the SIGNATURES match (`Strip.Add(string)`
        // does not hide `Bag.Add(Bag)` -- a call with a Bag argument still
        // reaches the base's overload). A base overload with the same
        // signature is hidden, so it is not a candidate.
        List<Node> cands = new List<Node>();
        Node c = cls;
        int cg = 0;
        while (c != null) {
            int i = 0;
            while (i < c.kids.Count) {
                Node m = c.kids[i];
                if (m.kind == AK.MethodDecl() && m.sval == name && !HasSameSig(cands, m)) { cands.Add(m); }
                i = i + 1;
            }
            c = BaseClassOf(c);
            cg = cg + 1;
            if (cg > 512) { c = null; }
        }
        if (cands.Count == 0) { return null; }
        int argc = e.kids.Count;
        List<Node> fit = new List<Node>();
        int i = 0;
        while (i < cands.Count) {
            if (AcceptsArity(cands[i], argc)) { fit.Add(cands[i]); }
            i = i + 1;
        }
        if (fit.Count == 0) {
            diags.Error("no overload of '" + name + "' takes " + argc + " argument(s)", e.line, e.col);
            return cands[0];
        }
        if (fit.Count == 1) { return fit[0]; }
        bool anyNamed = false;
        i = 0;
        while (i < e.kids.Count) { if (e.kids[i].sval2 != "") { anyNamed = true; } i = i + 1; }
        if (anyNamed) { return fit[0]; }
        int mx = -2000000000;
        List<int> sc = new List<int>();
        i = 0;
        while (i < fit.Count) { int s = ScoreCand(fit[i], e, argc, wantStatic); sc.Add(s); if (s > mx) { mx = s; } i = i + 1; }
        int cntMax = 0;
        Node best = fit[0];
        i = 0;
        while (i < fit.Count) {
            if (sc[i] == mx) { if (cntMax == 0) { best = fit[i]; } cntMax = cntMax + 1; }
            i = i + 1;
        }
        if (cntMax > 1) { diags.Error("ambiguous call to overloaded '" + name + "'", e.line, e.col); }
        return best;
    }

    // Like ResolveMethod but walks base classes, matching FindMethodUp.
    Node ResolveMethodUp(Node cls, string name, Node e, bool wantStatic) {
        Node c = cls;
        while (c != null) {
            Node m = ResolveMethod(c, name, e, wantStatic);
            if (m != null) { return m; }
            c = BaseClassOf(c);
        }
        return null;
    }

    // Select the constructor for `new C(args)`: with a single ctor the
    // behaviour is unchanged (arity is not consulted, so default-argument
    // calls still resolve); with several overloads, keep those whose arity
    // admits the call (trailing defaults fill the gap) and pick the best
    // argument-type match. `exclude` rules a ctor out (a `: this(...)`
    // chain must not retarget itself). Returns null when nothing fits.
    Node ResolveCtorEx(Node cls, Node e, Node exclude) {
        if (cls == null) { return null; }
        List<Node> cands = new List<Node>();
        int i = 0;
        while (i < cls.kids.Count) {
            if (cls.kids[i].kind == AK.CtorDecl() && cls.kids[i] != exclude) { cands.Add(cls.kids[i]); }
            i = i + 1;
        }
        if (cands.Count == 0) { return null; }
        if (cands.Count == 1) { return cands[0]; }
        int argc = e.kids.Count;
        List<Node> fit = new List<Node>();
        i = 0;
        while (i < cands.Count) {
            Node m = cands[i];
            int tot = 0; int req = 0; int j = 0;
            while (j < m.kids.Count) {
                if (m.kids[j].kind == AK.Param()) { tot = tot + 1; if (m.kids[j].b == null) { req = req + 1; } }
                j = j + 1;
            }
            if (argc >= req && argc <= tot) { fit.Add(m); }
            i = i + 1;
        }
        if (fit.Count == 0) { return null; }
        if (fit.Count == 1) { return fit[0]; }
        int mx = -2000000000;
        List<int> sc = new List<int>();
        i = 0;
        while (i < fit.Count) { int s = ScoreCand(fit[i], e, argc, false); sc.Add(s); if (s > mx) { mx = s; } i = i + 1; }
        i = 0;
        while (i < fit.Count) { if (sc[i] == mx) { return fit[i]; } i = i + 1; }
        return fit[0];
    }

    Node ResolveCtor(Node cls, Node e) {
        return ResolveCtorEx(cls, e, null);
    }

    // vtable slot method names, base classes first
    void CollectVSlots(Node cls, List<string> slots) {
        if (cls == null) { return; }
        CollectVSlots(BaseClassOf(cls), slots);
        int i = 0;
        while (i < cls.kids.Count) {
            Node m = cls.kids[i];
            if (m.kind == AK.MethodDecl() && IsVSlotIntro(m)) { slots.Add(m.sval); }
            i = i + 1;
        }
    }

    void CollectVSlotNodes(Node cls, List<Node> ms) {
        if (cls == null) { return; }
        CollectVSlotNodes(BaseClassOf(cls), ms);
        int i = 0;
        while (i < cls.kids.Count) {
            Node m = cls.kids[i];
            if (m.kind == AK.MethodDecl() && IsVSlotIntro(m)) { ms.Add(m); }
            i = i + 1;
        }
    }

    int VSlotIndex(Node cls, string name) {
        List<string> slots = new List<string>();
        CollectVSlots(cls, slots);
        int i = 0;
        while (i < slots.Count) { if (slots[i] == name) { return i; } i = i + 1; }
        return -1;
    }

    // slot index of the specific overload m; falls back to a unique name match
    int VSlotIndexM(Node cls, Node m) {
        List<Node> ms = new List<Node>();
        CollectVSlotNodes(cls, ms);
        string tags = ParamTags(m);
        int i = 0;
        while (i < ms.Count) {
            if (ms[i].sval == m.sval && ParamTags(ms[i]) == tags) { return i; }
            i = i + 1;
        }
        int hit = 0 - 1;
        int n = 0;
        i = 0;
        while (i < ms.Count) {
            if (ms[i].sval == m.sval) { hit = i; n = n + 1; }
            i = i + 1;
        }
        if (n == 1) { return hit; }
        return -1;
    }

    // most-derived class (from cls upward) providing a concrete body for a slot.
    // Matches explicit override AND implicit interface implementation (a plain
    // method whose name matches an inherited abstract/virtual slot).
    string ResolveImpl(Node cls, string name) {
        Node c = cls;
        while (c != null) {
            Node m = binder.FindMethod(c, name);
            if (m != null && !IsAbstract(m)) { return c.sval; }
            c = BaseClassOf(c);
        }
        return "";
    }

    string MethodFnTypeThis(Node m, string thisCls) {
        string ty = MapType(m.type) + " (%" + thisCls + "*";
        int i = 0;
        while (i < m.kids.Count) {
            if (m.kids[i].kind == AK.Param()) { ty = ty + ", " + MapType(m.kids[i].type); }
            i = i + 1;
        }
        return ty + ")*";
    }

    void GenVarDecl(Node s) {
        if (curAsync) {
            int pli = LocalIdx(s.sval);
            if (pli >= 0) {
                Node pty0 = locType[pli]; string preg0 = locReg[pli]; string plt0 = MapType(pty0);
                if (s.b != null) {
                    ExprVal iv0 = GenExpr(s.b);
                    if (curAsync && locBox[pli]) {
                        // the local lives in a heap cell: allocate it here and
                        // keep the cell pointer in the spill slot, so the cell
                        // survives a suspension
                        string c = NT();
                        L("  " + c + " = call i8* @malloc(i64 " + TypeSizeBytes(plt0) + ")");
                        string p = NT();
                        L("  " + p + " = bitcast i8* " + c + " to " + plt0 + "*");
                        string sv0 = Coerce(iv0, plt0);
                        L("  store " + plt0 + " " + sv0 + ", " + plt0 + "* " + p);
                        L("  store i8* " + c + ", i8** " + preg0);
                        EmitArcRetain(sv0, pty0);
                    } else if (IsNullableValue(pty0)) {
                        L("  store i8* " + BoxFor(iv0, pty0) + ", i8** " + preg0);
                    } else {
                        string sv0 = Coerce(iv0, plt0);
                        L("  store " + plt0 + " " + sv0 + ", " + plt0 + "* " + preg0);
                        EmitArcRetain(sv0, pty0);
                    }
                }
                return;
            }
        }
        Node ty = s.type;
        ExprVal init;
        bool hasInit = (s.b != null);
        // propagate delegate parameter/return types onto an initialising lambda
        if (hasInit && s.b.kind == AK.Lambda() && ty != null && IsDelegate(ty)) {
            AnnotateLambda(s.b, ty);
        }
        if (hasInit) { init = GenExpr(s.b); } else { init = new ExprVal("0", MkType("int")); }
        if (ty == null) { ty = init.ty; }
        string lt = MapType(ty);
        string reg = AddLocal(s.sval, ty);
        if (ShouldBox(s.sval)) {
            // a closure in this function may capture the variable: it has to
            // live in a cell the closure can keep
            reg = BoxLocal(locName.Count - 1);
        } else {
            EA(reg, lt);
        }
        if (hasInit) {
            if (IsNullableValue(ty)) {
                L("  store i8* " + BoxFor(init, ty) + ", i8** " + reg);
            } else {
                ExprVal src = StrSlotConv(ty, init);
                // a struct is a value: the new variable gets its own copy
                if (NeedsStructCopy(ty, src)) { src = StructCopyTemp(src, ty); }
                string sv = Coerce(src, lt);
                L("  store " + lt + " " + sv + ", " + lt + "* " + reg);
                EmitArcRetainStore(sv, ty, src.ty);
            }
        } else {
            Node sd = binder.FindType(ty.sval);
            if (sd != null && sd.kind == AK.StructDecl() && ty.ival == 0 && !IsNullable(ty)) {
                // value struct default-initialised: allocate zeroed storage so
                // field accesses operate on real memory (calloc zeroes fields).
                string cn = ty.sval;
                string szp = NT();
                L("  " + szp + " = getelementptr %" + cn + ", %" + cn + "* null, i32 1");
                string szi = NT();
                L("  " + szi + " = ptrtoint %" + cn + "* " + szp + " to i64");
                string raw = NT();
                L("  " + raw + " = call i8* @zalloc(i64 " + szi + ", i8* bitcast (void (i8*)* @" + cn + "_dtor to i8*), i8* bitcast (i8** @__tid_" + cn + " to i8*))");
                string obj = NT();
                L("  " + obj + " = bitcast i8* " + raw + " to %" + cn + "*");
                // a struct-typed field points at a nested instance: allocate it
                InitNestedFields(obj, sd);
                L("  store " + lt + " " + obj + ", " + lt + "* " + reg);
            } else if (ArcManaged(ty)) {
                L("  store " + lt + " null, " + lt + "* " + reg);
            }
        }
        // multi-declarator: extra declarators ride as VarDecl kids; handled
        // after this declaration's store so `int a = 1, b = a + 1` sees a
        int mdi = 0;
        while (mdi < s.kids.Count) {
            GenVarDecl(s.kids[mdi]);
            mdi = mdi + 1;
        }
    }

    string GenCond(Node e) {
        ExprVal v = GenExpr(e);
        string c = NT();
        if (v.op == "null") {
            L("  " + c + " = icmp ne i8* null, null");
        } else if (MapType(v.ty) == "i8*" || IsPtrType(v.ty)) {
            L("  " + c + " = icmp ne " + MapType(v.ty) + " " + v.op + ", null");
        } else {
            L("  " + c + " = icmp ne i64 " + v.op + ", 0");
        }
        return c;
    }

    void GenIf(Node s) {
        string c = GenCond(s.a);
        int lt = NL(); int le = NL(); int lend = NL();
        if (s.c != null) { L("  br i1 " + c + ", label %L" + lt + ", label %L" + le); }
        else { L("  br i1 " + c + ", label %L" + lt + ", label %L" + lend); }
        Label(lt);
        GenStmt(s.b);
        if (!term) { L("  br label %L" + lend); }
        if (s.c != null) {
            Label(le);
            GenStmt(s.c);
            if (!term) { L("  br label %L" + lend); }
        }
        Label(lend);
    }

    void GenWhile(Node s) {
        int lc = NL(); int lb = NL(); int lend = NL();
        int sb = brkTarget; int sc = contTarget;
        int sls = loopScopeBase;
        brkTarget = lend; contTarget = lc;
        loopScopeBase = locName.Count;
        L("  br label %L" + lc);
        Label(lc);
        string c = GenCond(s.a);
        L("  br i1 " + c + ", label %L" + lb + ", label %L" + lend);
        Label(lb);
        GenStmt(s.b);
        if (!term) { L("  br label %L" + lc); }
        Label(lend);
        brkTarget = sb; contTarget = sc;
        loopScopeBase = sls;
    }

    void GenDoWhile(Node s) {
        int lb = NL(); int lc = NL(); int lend = NL();
        int sb = brkTarget; int sc = contTarget;
        int sls = loopScopeBase;
        brkTarget = lend; contTarget = lc;
        loopScopeBase = locName.Count;
        L("  br label %L" + lb);
        Label(lb);
        GenStmt(s.b);
        if (!term) {
            L("  br label %L" + lc);
            Label(lc);
            string c = GenCond(s.a);
            L("  br i1 " + c + ", label %L" + lb + ", label %L" + lend);
        }
        Label(lend);
        brkTarget = sb; contTarget = sc;
        loopScopeBase = sls;
    }

    void GenFor(Node s) {
        int forScope = locName.Count;
        if (s.a != null) { GenStmt(s.a); }
        // a for-statement's init variables are per-iteration captures: every
        // closure made in the body keeps its own iteration's value
        int fi = forScope;
        while (fi < locName.Count) { locIter[fi] = true; fi = fi + 1; }
        int lc = NL(); int lb = NL(); int linc = NL(); int lend = NL();
        int sb = brkTarget; int sc = contTarget;
        int sls = loopScopeBase;
        brkTarget = lend; contTarget = linc;
        loopScopeBase = locName.Count;
        L("  br label %L" + lc);
        Label(lc);
        if (s.b != null) {
            string c = GenCond(s.b);
            L("  br i1 " + c + ", label %L" + lb + ", label %L" + lend);
        } else {
            L("  br label %L" + lb);
        }
        Label(lb);
        GenStmt(s.d);
        if (!term) { L("  br label %L" + linc); }
        Label(linc);
        if (s.c != null) { GenExpr(s.c); }
        L("  br label %L" + lc);
        Label(lend);
        ReleaseLocalsFrom(forScope);
        TrimLocals(forScope);
        brkTarget = sb; contTarget = sc;
        loopScopeBase = sls;
    }

    // Infer the projected element type of a query's `select` expression, with
    // the range variable resolving to the source element type.
    Node QueryElem(Node sel, string qv, Node elemTy) {
        if (sel == null) { return elemTy; }
        int k = sel.kind;
        if (k == AK.IntLit()) { return MkType("int"); }
        if (k == AK.FloatLit()) { return MkType("double"); }
        if (k == AK.StringLit()) { return MkType("string"); }
        if (k == AK.CharLit()) { return MkType("char"); }
        if (k == AK.BoolLit()) { return MkType("bool"); }
        if (k == AK.CastExpr()) { return sel.type; }
        if (k == AK.NewExpr()) { return sel.type; }
        if (k == AK.Ident()) {
            if (sel.sval == qv) { return elemTy; }
            int li = LocalIdx(sel.sval);
            if (li >= 0) { return locType[li]; }
            return elemTy;
        }
        if (k == AK.Unary()) {
            if (sel.op == TK.Bang()) { return MkType("bool"); }
            return QueryElem(sel.a, qv, elemTy);
        }
        if (k == AK.Binary()) {
            int op = sel.op;
            if (op == TK.EqEq() || op == TK.BangEq() || op == TK.Less() || op == TK.Greater()
                || op == TK.LessEq() || op == TK.GreaterEq() || op == TK.AmpAmp() || op == TK.PipePipe()) {
                return MkType("bool");
            }
            Node lt = QueryElem(sel.a, qv, elemTy);
            Node rt = QueryElem(sel.b, qv, elemTy);
            if (IsStr(lt) || IsStr(rt)) { return MkType("string"); }
            if (lt != null) { return lt; }
            return rt;
        }
        if (k == AK.MemberAccess()) {
            if (sel.sval == "Length" || sel.sval == "Count") { return MkType("int"); }
            return MkType("int");
        }
        return elemTy;
    }

    // from x in src [where c]... select e — an eager loop that filters and
    // projects each element into a fresh List<sel>. Mirrors the C host lowering.
    ExprVal GenQuery(Node e) {
        int qScope = locName.Count;
        ExprVal coll = GenExpr(e.a);
        Node srcElem = ListElem(coll.ty);
        if (srcElem == null) { srcElem = MkType("int"); }
        string selt = MapType(srcElem);
        Node resElem = QueryElem(e.b, e.sval, srcElem);
        Node resListTy = MkType("List");
        resListTy.a = resElem; resListTy.Add(resElem);
        string ow = "0"; if (ArcManaged(resElem)) { ow = "1"; }
        string list = NT();
        L("  " + list + " = call i8* @zlist_new(i64 " + ow + ")");
        if (!IsListType(coll.ty)) { AddTemp(list, resListTy); return new ExprVal(list, resListTy); }
        string idx = NT();
        EA(idx, "i64");
        L("  store i64 0, i64* " + idx);
        string ereg = AddLocal(e.sval, srcElem);
        if (ShouldBox(e.sval)) {
            ereg = BoxLocal(locName.Count - 1);
        } else {
            EA(ereg, selt);
        }
        if (ArcManaged(srcElem)) { L("  store " + selt + " null, " + selt + "* " + ereg); }
        int lc = NL(); int lb = NL(); int linc = NL(); int lend = NL();
        L("  br label %L" + lc);
        Label(lc);
        string iv = NT();
        L("  " + iv + " = load i64, i64* " + idx);
        string cnt = NT();
        L("  " + cnt + " = call i64 @zlist_count(i8* " + coll.op + ")");
        string c = NT();
        L("  " + c + " = icmp slt i64 " + iv + ", " + cnt);
        L("  br i1 " + c + ", label %L" + lb + ", label %L" + lend);
        Label(lb);
        string slot = NT();
        L("  " + slot + " = call i64 @zlist_get(i8* " + coll.op + ", i64 " + iv + ")");
        ExprVal ev = FromSlot(slot, srcElem);
        L("  store " + selt + " " + ev.op + ", " + selt + "* " + ereg);
        int wi = 0;
        while (wi < e.kids.Count) {
            string wc = GenCond(e.kids[wi]);
            int lkeep = NL();
            L("  br i1 " + wc + ", label %L" + lkeep + ", label %L" + linc);
            Label(lkeep);
            wi = wi + 1;
        }
        ExprVal sel = GenExpr(e.b);
        string sv = StructElemSlot(sel, resElem);
        L("  call void @zlist_add(i8* " + list + ", i64 " + sv + ")");
        L("  br label %L" + linc);
        Label(linc);
        string iv2 = NT();
        L("  " + iv2 + " = load i64, i64* " + idx);
        string inc = NT();
        L("  " + inc + " = add i64 " + iv2 + ", 1");
        L("  store i64 " + inc + ", i64* " + idx);
        L("  br label %L" + lc);
        Label(lend);
        TrimLocals(qScope);
        AddTemp(list, resListTy);
        return new ExprVal(list, resListTy);
    }

    // foreach (T x in coll) body  — lowered as an indexed walk over the
    // collection: List<T> (zlist_count/zlist_get), T[] (the length header
    // sits one slot before the data) and string (strlen + byte walk).
    // Any other collection kind is rejected instead of silently dropping
    // the loop: a dropped loop compiles but computes the wrong answer.
    void GenForeach(Node s) {
        int feScope = locName.Count;
        ExprVal coll = GenExpr(s.b);
        bool feList = IsListType(coll.ty);
        bool feArr = coll.ty != null && coll.ty.ival >= 1;
        bool feStr = IsStr(coll.ty);
        if (!feList && !feArr && !feStr) {
            // the duck-typed enumerable protocol (GetEnumerator/MoveNext/Current)
            if (GenForeachEnumerable(s, coll)) { return; }
            string cn = "?"; if (coll.ty != null) { cn = coll.ty.sval; }
            diags.Error("foreach over '" + cn + "' is not supported by the self-hosted compiler yet (List<T>, T[] and string are)", s.line, s.col);
            return;
        }
        Node elemTy = s.type;
        if (elemTy == null) {
            if (feList) { elemTy = ListElem(coll.ty); }
            else if (feArr) { elemTy = MkType(coll.ty.sval); elemTy.ival = coll.ty.ival - 1; }
            else { elemTy = MkType("char"); }
        }
        string elt = MapType(elemTy);
        // In an async body the loop state must survive a suspension: the
        // counter lives in the coroutine frame (heap), not in a stack alloca
        // -- an alloca is re-created on every resume, so the loop would
        // restart (or read an uninitialized slot) after an await.
        // The frame slot address is re-derived at every use: a pointer
        // computed in one block does not dominate the resume blocks of the
        // state machine (the resume blocks are entered straight from the
        // dispatch switch), and LLVM would reject the reference.
        // The collection itself is spilled too: it is an expression value,
        // and a value computed before the loop does not dominate the loop
        // body once the body can be re-entered from a resume block.
        string cty = MapType(coll.ty);
        string creg = "";
        if (curAsync) {
            creg = NT();
            EA(creg, cty);
            L("  store " + cty + " " + coll.op + ", " + cty + "* " + creg);
            asyncSlotReg.Add(creg); asyncSlotTy.Add(coll.ty); asyncSlotIdx.Add(s.ival);
        }
        string idx = NT();
        if (!curAsync) {
            EA(idx, "i64");
            L("  store i64 0, i64* " + idx);
        } else {
            string ip0 = FrameGep("%ff", s.ival + 1);
            L("  store i64 0, i64* " + ip0);
        }
        string ereg = AddLocal(s.sval, elemTy);
        // the element variable is a per-iteration capture: every closure made
        // in the body keeps its own element
        locIter[locName.Count - 1] = true;
        if (curAsync) {
            // An async foreach element variable is not boxed: boxing it would
            // need the cell-pointer spill slot the method's own locals use,
            // and the per-iteration snapshot it would need is not modelled in
            // the async frame either. A closure over it captures by value.
            EA(ereg, elt);
        } else if (ShouldBox(s.sval)) {
            ereg = BoxLocal(locName.Count - 1);
        } else {
            EA(ereg, elt);
        }
        if (curAsync) {
            // the element variable crosses the suspension as well
            asyncSlotReg.Add(ereg); asyncSlotTy.Add(elemTy); asyncSlotIdx.Add(s.ival + 2);
        }
        if (ArcManaged(elemTy)) { L("  store " + elt + " null, " + elt + "* " + ereg); }
        int lc = NL(); int lb = NL(); int linc = NL(); int lend = NL();
        int sb = brkTarget; int sc = contTarget;
        int sls = loopScopeBase;
        brkTarget = lend; contTarget = linc;
        loopScopeBase = locName.Count;
        L("  br label %L" + lc);
        Label(lc);
        string iv = NT();
        if (curAsync) {
            string ip = FrameGep("%ff", s.ival + 1);
            L("  " + iv + " = load i64, i64* " + ip);
        } else {
            L("  " + iv + " = load i64, i64* " + idx);
        }
        string cv = coll.op;
        if (curAsync) {
            cv = NT();
            L("  " + cv + " = load " + cty + ", " + cty + "* " + creg);
        }
        string cnt = NT();
        if (feList) {
            L("  " + cnt + " = call i64 @zlist_count(i8* " + cv + ")");
        } else if (feArr) {
            // the length header sits one i64 slot before the element data
            string lp = NT();
            L("  " + lp + " = getelementptr i64, i64* " + cv + ", i64 -1");
            L("  " + cnt + " = load i64, i64* " + lp);
        } else {
            L("  " + cnt + " = call i64 @zstr_len(i8* " + cv + ")");
        }
        string c = NT();
        L("  " + c + " = icmp slt i64 " + iv + ", " + cnt);
        L("  br i1 " + c + ", label %L" + lb + ", label %L" + lend);
        Label(lb);
        ExprVal ev;
        if (curAsync) {
            // reload in this block: the value from the loop header does not
            // dominate the body once the body can be re-entered on resume
            cv = NT();
            L("  " + cv + " = load " + cty + ", " + cty + "* " + creg);
        }
        if (feList) {
            string slot = NT();
            L("  " + slot + " = call i64 @zlist_get(i8* " + cv + ", i64 " + iv + ")");
            ev = FromSlot(slot, elemTy);
        } else if (feArr) {
            string ep = NT();
            L("  " + ep + " = getelementptr i64, i64* " + cv + ", i64 " + iv);
            string raw = NT();
            L("  " + raw + " = load i64, i64* " + ep);
            ev = FromSlot(raw, elemTy);
        } else {
            string cp = NT();
            L("  " + cp + " = getelementptr i8, i8* " + cv + ", i64 " + iv);
            string ch = NT();
            L("  " + ch + " = load i8, i8* " + cp);
            string z = NT();
            L("  " + z + " = zext i8 " + ch + " to i64");
            ev = new ExprVal(z, elemTy);
        }
        if (ArcManaged(elemTy)) {
            string old = NT();
            L("  " + old + " = load " + elt + ", " + elt + "* " + ereg);
            L("  store " + elt + " " + ev.op + ", " + elt + "* " + ereg);
            EmitArcRetain(ev.op, elemTy);
            EmitArcRelease(old, elemTy);
        } else {
            L("  store " + elt + " " + ev.op + ", " + elt + "* " + ereg);
        }
        GenStmt(s.c);
        if (!term) { L("  br label %L" + linc); }
        Label(linc);
        string iv2 = NT();
        string inc = NT();
        if (curAsync) {
            string ip2 = FrameGep("%ff", s.ival + 1);
            L("  " + iv2 + " = load i64, i64* " + ip2);
            L("  " + inc + " = add i64 " + iv2 + ", 1");
            string ip3 = FrameGep("%ff", s.ival + 1);
            L("  store i64 " + inc + ", i64* " + ip3);
        } else {
            L("  " + iv2 + " = load i64, i64* " + idx);
            L("  " + inc + " = add i64 " + iv2 + ", 1");
            L("  store i64 " + inc + ", i64* " + idx);
        }
        L("  br label %L" + lc);
        Label(lend);
        ReleaseLocalsFrom(feScope);
        TrimLocals(feScope);
        brkTarget = sb; contTarget = sc;
        loopScopeBase = sls;
    }

    // foreach (T x in coll) over the duck-typed enumerable protocol:
    // coll.GetEnumerator() -> enumerator, enumerator.MoveNext() -> bool,
    // enumerator.Current -> element. The enumerator is a class instance, so
    // the three calls go through the ordinary instance-call path; the
    // self-hosted backend erases generic type arguments, so a
    // `Foo<T>.GetEnumerator()` needs no specialization here.
    // Returns false when the collection does not speak the protocol (the
    // caller then reports the collection as unsupported).
    bool GenForeachEnumerable(Node s, ExprVal coll) {
        if (curAsync) { return false; }   // no frame slot for the enumerator yet
        Node cls = ClassOf(coll.ty);
        if (cls == null) { return false; }
        Node gm = FindMethodUp(cls, "GetEnumerator");
        if (gm == null || gm.type == null) { return false; }
        Node enumTy = gm.type;
        Node ecls = ClassOf(enumTy);
        if (ecls == null) { return false; }
        if (FindMethodUp(ecls, "MoveNext") == null) { return false; }
        // Current is a property (get_Current), a method (Current()) or a field.
        // The C host lowers the method and the property form
        // (irgen_stmt.c: fe_cur_m / fe_cur_getter); the field form is a C
        // host gap (its checker accepts it, its irgen does not read it).
        Node curGetter = FindMethodUp(ecls, "get_Current");
        Node curMethod = null;
        bool curIsField = false;
        if (curGetter == null) {
            curMethod = FindMethodUp(ecls, "Current");
            if (curMethod == null) {
                curIsField = binder.FindField(ecls, "Current") != null;
                if (!curIsField) { return false; }
            }
        }
        Node elemTy = s.type;
        if (elemTy == null) {
            if (curGetter != null) { elemTy = curGetter.type; }
            else if (curMethod != null) { elemTy = curMethod.type; }
        }
        if (elemTy == null) { return false; }
        int feScope = locName.Count;
        Node call0 = new Node(AK.Call()); call0.kids = new List<Node>();
        ExprVal en = EmitInstanceCall(coll, cls.sval, "GetEnumerator", call0);
        string enTy = MapType(enumTy);
        string enReg = AddLocal("__zenum", enumTy);
        EA(enReg, enTy);
        L("  store " + enTy + " " + en.op + ", " + enTy + "* " + enReg);
        string elt = MapType(elemTy);
        string ereg = AddLocal(s.sval, elemTy);
        // the element variable is a per-iteration capture: every closure made
        // in the body keeps its own element
        locIter[locName.Count - 1] = true;
        if (ShouldBox(s.sval)) { ereg = BoxLocal(locName.Count - 1); } else { EA(ereg, elt); }
        if (ArcManaged(elemTy)) { L("  store " + elt + " null, " + elt + "* " + ereg); }
        int lc = NL(); int lb = NL(); int linc = NL(); int lend = NL();
        int sb = brkTarget; int sc = contTarget;
        int sls = loopScopeBase;
        brkTarget = lend; contTarget = linc;
        loopScopeBase = locName.Count;
        L("  br label %L" + lc);
        Label(lc);
        Node call1 = new Node(AK.Call()); call1.kids = new List<Node>();
        ExprVal mn = EmitInstanceCall(en, ecls.sval, "MoveNext", call1);
        string c = NT();
        L("  " + c + " = icmp ne i64 " + mn.op + ", 0");
        L("  br i1 " + c + ", label %L" + lb + ", label %L" + lend);
        Label(lb);
        ExprVal ev;
        if (curIsField) {
            ev = LoadField(en.op, enumTy, "Current");
        } else if (curGetter != null) {
            Node call2 = new Node(AK.Call()); call2.kids = new List<Node>();
            ExprVal cv = EmitInstanceCall(en, ecls.sval, "get_Current", call2);
            ev = FromSlot(cv.op, elemTy);
        } else {
            Node call2 = new Node(AK.Call()); call2.kids = new List<Node>();
            ExprVal cv = EmitInstanceCall(en, ecls.sval, "Current", call2);
            ev = FromSlot(cv.op, elemTy);
        }
        if (ArcManaged(elemTy)) {
            string old = NT();
            L("  " + old + " = load " + elt + ", " + elt + "* " + ereg);
            L("  store " + elt + " " + ev.op + ", " + elt + "* " + ereg);
            EmitArcRetain(ev.op, elemTy);
            EmitArcRelease(old, elemTy);
        } else {
            L("  store " + elt + " " + ev.op + ", " + elt + "* " + ereg);
        }
        GenStmt(s.c);
        if (!term) { L("  br label %L" + linc); }
        Label(linc);
        L("  br label %L" + lc);
        Label(lend);
        ReleaseLocalsFrom(feScope);
        TrimLocals(feScope);
        brkTarget = sb; contTarget = sc;
        loopScopeBase = sls;
        return true;
    }

    // throw expr — store the exception object, pop the innermost handler and
    // longjmp back into its try (setjmp returns nonzero -> catch path).
    void GenThrow(Node s) {
        ExprVal v = GenExpr(s.a);
        string vt = MapType(v.ty);
        string ev = v.op;
        if (vt != "i8*") {
            string t = NT();
            L("  " + t + " = bitcast " + vt + " " + ev + " to i8*");
            ev = t;
        }
        Node tc = ClassOf(v.ty);
        if (tc != null) {
            L("  store i8* bitcast (i8** @__tid_" + tc.sval + " to i8*), i8** @__exc_tid");
        } else {
            L("  store i8* null, i8** @__exc_tid");
        }
        L("  store i8* " + ev + ", i8** @__exc_val");
        EmitRaise();
    }

    // pop the innermost handler and longjmp into its try (the exception
    // object/tid globals already hold the in-flight exception).
    void EmitRaise() {
        if (curAsync) {
            // the longjmp may skip suspended coroutine frames: persist this
            // frame's locals (the handler reloads them) and release/free the
            // frames the jump bypasses (stops at the first armed handler).
            EmitAsyncSaveSlots();
            L("  call void @__zan_async_unwind(i8* %fp)");
        }
        string sp = NT();
        L("  " + sp + " = load i64, i64* @__exc_sp");
        string sp1 = NT();
        L("  " + sp1 + " = sub i64 " + sp + ", 1");
        L("  store i64 " + sp1 + ", i64* @__exc_sp");
        string slot = NT();
        L("  " + slot + " = getelementptr [64 x i8*], [64 x i8*]* @__exc_stack, i64 0, i64 " + sp1);
        string buf = NT();
        L("  " + buf + " = load i8*, i8** " + slot);
        L("  call void @longjmp(i8* " + buf + ", i32 1)");
        L("  unreachable");
        term = true;
    }

    void EmitExcPop() {
        string sp = NT();
        L("  " + sp + " = load i64, i64* @__exc_sp");
        string sp1 = NT();
        L("  " + sp1 + " = sub i64 " + sp + ", 1");
        L("  store i64 " + sp1 + ", i64* @__exc_sp");
    }

    // try { } catch (T e) { } finally { }  — setjmp/longjmp based
    void GenTry(Node s) {
        // the jmp_buf lives in a global array slot (not a stack alloca): in a
        // coroutine the resume invocation that armed the handler may have
        // returned by the time a throw longjmps here, so its stack is dead.
        string sp = NT();
        L("  " + sp + " = load i64, i64* @__exc_sp");
        string bufe = NT();
        L("  " + bufe + " = getelementptr [64 x [32 x i64]], [64 x [32 x i64]]* @__exc_bufs, i64 0, i64 " + sp);
        string bufp = NT();
        L("  " + bufp + " = bitcast [32 x i64]* " + bufe + " to i8*");
        string slot = NT();
        L("  " + slot + " = getelementptr [64 x i8*], [64 x i8*]* @__exc_stack, i64 0, i64 " + sp);
        L("  store i8* " + bufp + ", i8** " + slot);
        string sp1 = NT();
        L("  " + sp1 + " = add i64 " + sp + ", 1");
        L("  store i64 " + sp1 + ", i64* @__exc_sp");
        if (curAsync) {
            // arm: unwind stops at a frame with hcount > 0 (the handler
            // resumes inside it); keep the heap frame authoritative across
            // this try -- a throw crossing a suspension longjmps into a stale
            // invocation whose stack allocas are garbage.
            EmitAsyncHcAdd(1);
            EmitAsyncSaveSlots();
        }
        // setjmp
        string fp = NT();
        L("  " + fp + " = call i8* @llvm.frameaddress.p0(i32 0)");
        string r = NT();
        L("  " + r + " = call i32 @_setjmp(i8* " + bufp + ", i8* " + fp + ")");
        string c = NT();
        L("  " + c + " = icmp ne i32 " + r + ", 0");
        int ltry = NL(); int lcatch = NL(); int lend = NL();
        L("  br i1 " + c + ", label %L" + lcatch + ", label %L" + ltry);
        Label(ltry);
        GenStmt(s.a);
        if (!term) {
            EmitExcPop();
            if (curAsync) { EmitAsyncHcAdd(-1); }
            if (s.c != null) { GenStmt(s.c); }
            if (!term) { L("  br label %L" + lend); }
        }
        term = false;
        Label(lcatch);
        if (curAsync) {
            // disarm, then reload frame-resident locals: if the throw crossed
            // a suspension this invocation's stack allocas are stale -- the
            // frame (saved at try entry, every suspension and every async
            // throw) is the authoritative copy.
            EmitAsyncHcAdd(-1);
            EmitAsyncReloadSlots();
        }
        // handler already popped by throw; dispatch to the first clause whose
        // type matches the thrown tid (walking the base chain), rethrowing to
        // the outer handler when no clause matches. A null tid (string/legacy
        // throw) matches the first clause.
        int lfin = NL();
        if (s.b != null) {
            int lrethrow = NL();
            string tidSlot = NT();
            L("  " + tidSlot + " = alloca i8*");
            Node cc = s.b;
            bool first = true;
            bool sawAll = false;
            while (cc != null) {
                int lbody = NL();
                int lmiss = lrethrow;
                if (cc.b != null) { lmiss = NL(); }
                Node ct = ClassOf(cc.type);
                if (ct != null && !sawAll) {
                    string tid0 = NT();
                    L("  " + tid0 + " = load i8*, i8** @__exc_tid");
                    if (first) {
                        int lw = NL();
                        string zn = NT();
                        L("  " + zn + " = icmp eq i8* " + tid0 + ", null");
                        L("  br i1 " + zn + ", label %L" + lbody + ", label %L" + lw);
                        Label(lw);
                        string tid1 = NT();
                        L("  " + tid1 + " = load i8*, i8** @__exc_tid");
                        tid0 = tid1;
                    }
                    L("  store i8* " + tid0 + ", i8** " + tidSlot);
                    int lloop = NL(); int lcmp = NL(); int lstep = NL();
                    L("  br label %L" + lloop);
                    Label(lloop);
                    string cur = NT();
                    L("  " + cur + " = load i8*, i8** " + tidSlot);
                    string cn = NT();
                    L("  " + cn + " = icmp eq i8* " + cur + ", null");
                    L("  br i1 " + cn + ", label %L" + lmiss + ", label %L" + lcmp);
                    Label(lcmp);
                    string hit = NT();
                    L("  " + hit + " = icmp eq i8* " + cur + ", bitcast (i8** @__tid_" + ct.sval + " to i8*)");
                    L("  br i1 " + hit + ", label %L" + lbody + ", label %L" + lstep);
                    Label(lstep);
                    string curpp = NT();
                    L("  " + curpp + " = bitcast i8* " + cur + " to i8**");
                    string nx = NT();
                    L("  " + nx + " = load i8*, i8** " + curpp);
                    L("  store i8* " + nx + ", i8** " + tidSlot);
                    L("  br label %L" + lloop);
                } else {
                    // untyped clause (or unknown type): catches everything
                    L("  br label %L" + lbody);
                    sawAll = true;
                }
                Label(lbody);
                int catchScope = locName.Count;
                if (cc.sval != "" && cc.type != null) {
                    string exv = NT();
                    L("  " + exv + " = load i8*, i8** @__exc_val");
                    string cty = MapType(cc.type);
                    string reg = AddLocal(cc.sval, cc.type);
                    L("  " + reg + " = alloca " + cty);
                    string cv = exv;
                    if (cty != "i8*") {
                        string t = NT();
                        L("  " + t + " = bitcast i8* " + exv + " to " + cty);
                        cv = t;
                    }
                    L("  store " + cty + " " + cv + ", " + cty + "* " + reg);
                }
                GenStmt(cc.a);
                if (!term) {
                    ReleaseLocalsFrom(catchScope);
                    L("  br label %L" + lfin);
                }
                term = false;
                TrimLocals(catchScope);
                first = false;
                if (sawAll) { cc = null; } else { cc = cc.b; }
                if (cc != null && lmiss != lrethrow) { Label(lmiss); }
            }
            // no clause matched: re-raise to the next outer handler (this
            // try's frame was already popped by the throw); note the finally
            // body is bypassed on this path (mirrors the C host).
            if (!sawAll) {
                Label(lrethrow);
                EmitRaise();
                term = false;
            }
        } else {
            L("  br label %L" + lfin);
        }
        Label(lfin);
        if (s.c != null) {
            // the finally body may run try/catch of its own; keep the
            // in-flight exception intact across it
            string sv2 = NT(); string st2 = NT();
            L("  " + sv2 + " = alloca i8*");
            L("  " + st2 + " = alloca i8*");
            string ev0 = NT(); L("  " + ev0 + " = load i8*, i8** @__exc_val");
            L("  store i8* " + ev0 + ", i8** " + sv2);
            string td0 = NT(); L("  " + td0 + " = load i8*, i8** @__exc_tid");
            L("  store i8* " + td0 + ", i8** " + st2);
            GenStmt(s.c);
            string ev1 = NT(); L("  " + ev1 + " = load i8*, i8** " + sv2);
            L("  store i8* " + ev1 + ", i8** @__exc_val");
            string td1 = NT(); L("  " + td1 + " = load i8*, i8** " + st2);
            L("  store i8* " + td1 + ", i8** @__exc_tid");
        }
        if (!term) {
            if (s.b == null) {
                // finally-only try: the exception keeps unwinding (the C
                // host runs the finally at the throw site and propagates)
                EmitRaise();
                term = false;
            } else {
                L("  br label %L" + lend);
            }
        }
        Label(lend);
        term = false;
    }
}
