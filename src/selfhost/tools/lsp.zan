using System;
using System.Collections.Generic;

namespace Zan;

/// <summary>
/// 纯 Zan Language Server Protocol (LSP) 服务端 —— B-ID200 首切片。
/// 复用自举前端（src/selfhost/frontend/）做真诊断与符号索引：
/// - 真诊断：Lexer + Parser(ParseDeclsOnly) + Binder + Checker 的完整管线，
///   语法与语义错误映射为 LSP Diagnostics（行列来自前端 token/AST 位置）。
/// - documentSymbol：AST 顶层/成员声明（类声明位置由 token 扫描补位——
///   前端 ParseClass 不回填 line/col）。
/// - definition：打开文档的类/方法/字段声明符号索引跳转。
/// - references：跨打开文档的词边界文本匹配（近似，非语义解析）。
/// - rename/prepareRename：跨打开文档的词边界统一改写（与 references
///   同一近似口径，语义过滤顺延）；新名校验与 C 宿主 lsp_main.c 同形。
/// - documentHighlight/foldingRange：当前文档词边界高亮（kind=1 Text）+
///   花括号折叠区间（跨字符串/注释状态机，与 C 宿主同口径）。
/// - semanticTokens/full：真前端 Lexer token 流 + 符号索引分类，相对
///   编码五元组，legend 与 C 宿主同表（15 类），列/长度出站 UTF-16。
/// - hover：符号索引信息（种类+声明位置）；内建类型写死描述。
/// - completion：符号索引 + 关键字/内建类型，按光标前缀过滤。
/// 已知局限（后续切片收敛，见 TASKS.md B-ID200）：
/// - 语义诊断是单文档视图：using 指向的外部包/项目内其他文件的类型
///   会被报 undefined，尚未做项目级符号解析。
/// - JSON 只覆盖 LSP 会话实际用到的子集；字符串转义完整处理。
/// 入口：zanc --lsp 派发 Run()（driver/main.zan）。
/// </summary>
public class LspDocument {
    public string Uri;
    public string Text;
    public int Version;

    public LspDocument(string uri, string text, int version) {
        Uri = uri;
        Text = text;
        Version = version;
    }
}

/// 打开文档的声明符号。内部 Kind 用本类常量，映射到 LSP 的
/// SymbolKind / CompletionItemKind 两套数值。
public class LspSymbol {
    public string Uri;
    public string Name;
    public int Kind;
    public int Line;   // 1-based（与前端一致）
    public int Col;    // 1-based
    public List<string> ParamNames;
    public string TypeName;

    public LspSymbol(string uri, string name, int kind, int line, int col) {
        Uri = uri;
        Name = name;
        Kind = kind;
        Line = line;
        Col = col;
        ParamNames = new List<string>();
        TypeName = "";
    }

    public static int KindClass() { return 0; }
    public static int KindInterface() { return 1; }
    public static int KindStruct() { return 2; }
    public static int KindEnum() { return 3; }
    public static int KindMethod() { return 4; }
    public static int KindField() { return 5; }
    public static int KindCtor() { return 6; }
    public static int KindDelegate() { return 7; }

    /// LSP SymbolKind：Class=5 Interface=11 Enum=10 Method=6 Field=8
    /// Constructor=9 Function=12；struct 无专属值，按 Class 报。
    public int SymbolKind() {
        if (Kind == KindInterface()) { return 11; }
        if (Kind == KindEnum()) { return 10; }
        if (Kind == KindMethod()) { return 6; }
        if (Kind == KindField()) { return 8; }
        if (Kind == KindCtor()) { return 9; }
        if (Kind == KindDelegate()) { return 12; }
        return 5;
    }

    /// LSP CompletionItemKind：Class=7 Interface=8 Enum=13 Field=5
    /// Method=2 Constructor=4 Keyword=14。
    public int CompletionKind() {
        if (Kind == KindInterface()) { return 8; }
        if (Kind == KindEnum()) { return 13; }
        if (Kind == KindMethod()) { return 2; }
        if (Kind == KindField()) { return 5; }
        if (Kind == KindCtor()) { return 4; }
        if (Kind == KindDelegate()) { return 2; }
        return 7;
    }

    public string KindText() {
        if (Kind == KindInterface()) { return "interface"; }
        if (Kind == KindEnum()) { return "enum"; }
        if (Kind == KindStruct()) { return "struct"; }
        if (Kind == KindMethod()) { return "method"; }
        if (Kind == KindField()) { return "field"; }
        if (Kind == KindCtor()) { return "constructor"; }
        if (Kind == KindDelegate()) { return "delegate"; }
        return "class";
    }
}

/// 0-based 源位置（词扫描中间结果）。
public class LspPos {
    public int Line;
    public int Col;

    public LspPos(int line, int col) {
        Line = line;
        Col = col;
    }
}

/// 代码行格式化扫描元数据（同 C 宿主 fmt_line_t）。
public class FmtLine {
    public int Level;
    public int Lead;
    public string Content;
    public bool Blank;

    public FmtLine(int level, int lead, string content, bool blank) {
        Level = level;
        Lead = lead;
        Content = content;
        Blank = blank;
    }
}

/// InlayHint 数据结构（同 C 宿主 intel_inlay_hint_t）。
public class LspInlayHint {
    public int Line;
    public int Col;
    public string Label;
    public int Kind; // 1 = Type, 2 = Parameter

    public LspInlayHint(int line, int col, string label, int kind) {
        Line = line;
        Col = col;
        Label = label;
        Kind = kind;
    }
}

public class LspServer {
    [DllImport("crt")] public static extern int getchar();
    [DllImport("crt")] public static extern int putchar(int c);

    static List<LspDocument> documents;
    static List<LspSymbol> symbols;
    static bool isRunning = true;

    static void EnsureInit() {
        if (documents == null) {
            documents = new List<LspDocument>();
        }
        if (symbols == null) {
            symbols = new List<LspSymbol>();
        }
    }

    public static LspDocument FindDocument(string uri) {
        EnsureInit();
        int i = 0;
        while (i < documents.Count) {
            LspDocument doc = documents[i];
            if (doc.Uri == uri) { return doc; }
            i = i + 1;
        }
        return null;
    }

    public static void StoreDocument(string uri, string text, int version) {
        EnsureInit();
        LspDocument existing = FindDocument(uri);
        if (existing != null) {
            existing.Text = text;
            existing.Version = version;
        } else {
            documents.Add(new LspDocument(uri, text, version));
        }
    }

    public static void RemoveDocument(string uri) {
        EnsureInit();
        int i = 0;
        while (i < documents.Count) {
            if (documents[i].Uri == uri) {
                documents.RemoveAt(i);
                return;
            }
            i = i + 1;
        }
    }

    static void RemoveSymbolsOf(string uri) {
        int i = 0;
        while (i < symbols.Count) {
            if (symbols[i].Uri == uri) {
                symbols.RemoveAt(i);
            } else {
                i = i + 1;
            }
        }
    }

    // ============================ JSON 层 ============================
    // LSP 会话实际用到的 JSON 子集。字符串扫描全部转义感知（\" \\ 不截断）。

    public static string EncodeJsonString(string s) {
        // 字节收集 + ToStr 还原：Append(char) 对 ≥0x80 的字节会做
        // Latin-1→UTF-8 二次编码（char 是码点不是字节），非 ASCII 消息
        // 出站即成乱码。
        List<byte> outp = new List<byte>();
        outp.Add(34);
        int i = 0;
        while (i < s.Length) {
            int c = s[i] & 255;
            if (c == 34) { outp.Add(92); outp.Add(34); }
            else if (c == 92) { outp.Add(92); outp.Add(92); }
            else if (c == 10) { outp.Add(92); outp.Add(110); }
            else if (c == 13) { outp.Add(92); outp.Add(114); }
            else if (c == 9) { outp.Add(92); outp.Add(116); }
            else if (c < 32) {
                outp.Add(92); outp.Add(117); outp.Add(48); outp.Add(48);
                int hi = c / 16;
                int lo = c % 16;
                outp.Add((byte)(hi < 10 ? 48 + hi : 87 + hi));
                outp.Add((byte)(lo < 10 ? 48 + lo : 87 + lo));
            } else { outp.Add((byte)c); }
            i = i + 1;
        }
        outp.Add(34);
        byte[] arr = outp.ToArray();
        return arr.ToStr(0, arr.Length);
    }

    /// s[i] 必须是开引号；返回对应闭引号下标（跳过 \\" 与 \\\\），未闭合 -1。
    static int JsonSkipString(string s, int i) {
        int j = i + 1;
        while (j < s.Length) {
            if (s[j] == '\\') { j = j + 2; }
            else if (s[j] == '"') { return j; }
            else { j = j + 1; }
        }
        return -1;
    }

    /// 从 from 起找作为 key 出现的 "field"（后跟 ':'），返回其值的首 token
    /// 下标；未命中 -1。字符串字面量整段跳过，不会被值内部的 "field" 误命中。
    static int JsonFindValueFrom(string s, string field, int from) {
        string pattern = "\"" + field + "\"";
        int i = from;
        while (i < s.Length) {
            if (s[i] == '"') {
                int e = JsonSkipString(s, i);
                if (e < 0) { return -1; }
                if (s.Substring(i, e - i + 1) == pattern) {
                    int k = e + 1;
                    while (k < s.Length && (s[k] == ' ' || s[k] == '\t'
                            || s[k] == '\n' || s[k] == '\r')) { k = k + 1; }
                    if (k < s.Length && s[k] == ':') {
                        k = k + 1;
                        while (k < s.Length && (s[k] == ' ' || s[k] == '\t'
                                || s[k] == '\n' || s[k] == '\r')) { k = k + 1; }
                        if (k < s.Length) { return k; }
                        return -1;
                    }
                }
                i = e + 1;
            } else { i = i + 1; }
        }
        return -1;
    }

    /// 值起点 start 处的值结束下标（exclusive）：字符串越过闭引号，
    /// 对象/数组做转义感知的括号平衡，标量扫到分隔符。
    static int JsonScanValue(string s, int start) {
        char c = s[start];
        if (c == '"') {
            int e = JsonSkipString(s, start);
            return e < 0 ? s.Length : e + 1;
        }
        if (c == '{' || c == '[') {
            int depth = 0;
            int i = start;
            while (i < s.Length) {
                if (s[i] == '"') {
                    int e = JsonSkipString(s, i);
                    if (e < 0) { return s.Length; }
                    i = e + 1;
                    continue;
                }
                if (s[i] == '{' || s[i] == '[') { depth = depth + 1; }
                else if (s[i] == '}' || s[i] == ']') {
                    depth = depth - 1;
                    if (depth == 0) { return i + 1; }
                }
                i = i + 1;
            }
            return s.Length;
        }
        if (c == 't' || c == 'f' || c == 'n') {
            int i = start;
            while (i < s.Length && ((s[i] >= 'a' && s[i] <= 'z'))) { i = i + 1; }
            return i;
        }
        int j = start;
        while (j < s.Length && ((s[j] >= '0' && s[j] <= '9') || s[j] == '-'
                || s[j] == '+' || s[j] == '.' || s[j] == 'e' || s[j] == 'E')) {
            j = j + 1;
        }
        return j;
    }

    /// 解码 JSON 字符串值（不含两侧引号的片段）：转义序列与 \uXXXX
    /// （含成对代理对）。按字节收集后 ToStr 还原——Append(char) 对 ≥0x80
    /// 的字节会二次 UTF-8 编码（同 EncodeJsonString）。
    static string DecodeJsonBody(string s) {
        List<byte> outp = new List<byte>();
        int i = 0;
        while (i < s.Length) {
            int c = s[i] & 255;
            if (c == 92 && i + 1 < s.Length) {
                int n = s[i + 1] & 255;
                if (n == 34) { outp.Add(34); i = i + 2; }
                else if (n == 92) { outp.Add(92); i = i + 2; }
                else if (n == 47) { outp.Add(47); i = i + 2; }
                else if (n == 98) { outp.Add(8); i = i + 2; }
                else if (n == 102) { outp.Add(12); i = i + 2; }
                else if (n == 110) { outp.Add(10); i = i + 2; }
                else if (n == 114) { outp.Add(13); i = i + 2; }
                else if (n == 116) { outp.Add(9); i = i + 2; }
                else if (n == 117) {
                    int cp = JsonHex4(s, i + 2);
                    i = i + 6;
                    if (cp >= 0xD800 && cp <= 0xDBFF
                            && i + 1 < s.Length && (s[i] & 255) == 92
                            && (s[i + 1] & 255) == 117) {
                        int lo = JsonHex4(s, i + 2);
                        if (lo >= 0xDC00 && lo <= 0xDFFF) {
                            cp = 0x10000 + ((cp - 0xD800) << 10) + (lo - 0xDC00);
                            i = i + 6;
                        }
                    }
                    if (cp >= 0) { AppendUtf8Bytes(outp, cp); }
                } else { outp.Add((byte)n); i = i + 2; }
            } else { outp.Add((byte)c); i = i + 1; }
        }
        byte[] arr = outp.ToArray();
        return arr.ToStr(0, arr.Length);
    }

    static int JsonHex4(string s, int at) {
        if (at + 4 > s.Length) { return -1; }
        int v = 0;
        int i = 0;
        while (i < 4) {
            char c = s[at + i];
            int d;
            if (c >= '0' && c <= '9') { d = (int)c - (int)'0'; }
            else if (c >= 'a' && c <= 'f') { d = (int)c - (int)'a' + 10; }
            else if (c >= 'A' && c <= 'F') { d = (int)c - (int)'A' + 10; }
            else { return -1; }
            v = v * 16 + d;
            i = i + 1;
        }
        return v;
    }

    static void AppendUtf8Bytes(List<byte> outp, int cp) {
        if (cp < 0x80) {
            outp.Add((byte)cp);
        } else if (cp < 0x800) {
            outp.Add((byte)(0xC0 + (cp >> 6)));
            outp.Add((byte)(0x80 + (cp & 63)));
        } else if (cp < 0x10000) {
            outp.Add((byte)(0xE0 + (cp >> 12)));
            outp.Add((byte)(0x80 + ((cp >> 6) & 63)));
            outp.Add((byte)(0x80 + (cp & 63)));
        } else {
            outp.Add((byte)(0xF0 + (cp >> 18)));
            outp.Add((byte)(0x80 + ((cp >> 12) & 63)));
            outp.Add((byte)(0x80 + ((cp >> 6) & 63)));
            outp.Add((byte)(0x80 + (cp & 63)));
        }
    }

    /// 提取字段值：字符串 → 解码后的内容；标量 → 原文；未命中 ""。
    public static string ExtractJsonField(string json, string field) {
        int start = JsonFindValueFrom(json, field, 0);
        if (start < 0) { return ""; }
        int end = JsonScanValue(json, start);
        if (json[start] == '"') {
            return DecodeJsonBody(json.Substring(start + 1, end - start - 2));
        }
        return json.Substring(start, end - start);
    }

    /// 整数字段（缺省/非数值返回 dflt）。
    static int ExtractJsonInt(string json, string field, int dflt) {
        string raw = ExtractJsonField(json, field);
        if (raw.Length == 0) { return dflt; }
        bool ok = true;
        int i = 0;
        int v = 0;
        int sign = 1;
        if (raw[0] == '-') { sign = -1; i = 1; }
        while (i < raw.Length) {
            if (raw[i] < '0' || raw[i] > '9') { ok = false; break; }
            v = v * 10 + ((int)raw[i] - (int)'0');
            i = i + 1;
        }
        if (!ok) { return dflt; }
        return sign * v;
    }

    /// 提取字段值为对象/数组的平衡片段原文；未命中或非容器返回 ""。
    static string ExtractJsonContainer(string json, string field) {
        int start = JsonFindValueFrom(json, field, 0);
        if (start < 0) { return ""; }
        if (json[start] != '{' && json[start] != '[') { return ""; }
        int end = JsonScanValue(json, start);
        return json.Substring(start, end - start);
    }

    // ============================ 分析层 ============================

    /// 解析文档：发布真诊断并重建该文档的声明符号索引。
    static void Analyze(string uri, string text, int version) {
        RemoveSymbolsOf(uri);
        Lexer lx = new Lexer(text);
        List<Token> toks = lx.Run();
        CollectTopLevelSymbols(uri, toks);

        Diags dg = new Diags();
        Parser ps = new Parser(toks, dg);
        Node unit = ps.ParseDeclsOnly();
        Binder b = new Binder();
        b.Bind(unit);
        Checker ck = new Checker(b, dg);
        ck.Check(unit);
        CollectMemberSymbols(uri, unit);

        PublishDiagnostics(uri, version, DiagArray(dg, text));
    }

    /// 顶层类型声明位置：前端 ParseClass/ParseInterface/ParseEnum 不回填
    /// line/col，声明行从 token 流取（关键字后的标识符）。
    /// delegate 不是关键字 token（上下文关键字），首切片不收。
    static void CollectTopLevelSymbols(string uri, List<Token> toks) {
        int i = 0;
        while (i < toks.Count) {
            int k = toks[i].kind;
            if (k == TK.Class() || k == TK.Interface() || k == TK.Struct()
                    || k == TK.Enum()) {
                int j = i + 1;
                while (j < toks.Count && toks[j].kind != TK.Ident()
                        && toks[j].kind != TK.Eof()) { j = j + 1; }
                if (j < toks.Count && toks[j].kind == TK.Ident()) {
                    int kind;
                    if (k == TK.Interface()) { kind = LspSymbol.KindInterface(); }
                    else if (k == TK.Enum()) { kind = LspSymbol.KindEnum(); }
                    else if (k == TK.Struct()) { kind = LspSymbol.KindStruct(); }
                    else { kind = LspSymbol.KindClass(); }
                    symbols.Add(new LspSymbol(uri, toks[j].text, kind,
                        toks[j].line, toks[j].col));
                }
            }
            i = i + 1;
        }
    }

    /// 成员符号（方法/字段/构造器/枚举成员）来自 AST：这些节点的
    /// line/col 由前端回填，可直接用。字段的多声明符在 kids 里拍平。
    /// 接口与类同为 AK.ClassDecl()（mods 带If位），不单独区分。
    /// namespace 声明递归下钻，覆盖其内层的类型。
    static void CollectMemberSymbols(string uri, Node unit) {
        int i = 0;
        while (i < unit.kids.Count) {
            Node d = unit.kids[i];
            if (d.kind == AK.NamespaceDecl()) {
                CollectMemberSymbols(uri, d);
            } else if (d.kind == AK.ClassDecl() || d.kind == AK.StructDecl()) {
                int j = 0;
                while (j < d.kids.Count) {
                    Node m = d.kids[j];
                    if (m.kind == AK.MethodDecl()) {
                        LspSymbol msym = new LspSymbol(uri, m.sval,
                            LspSymbol.KindMethod(), m.line, m.col);
                        if (m.type != null && m.type.sval != null) {
                            msym.TypeName = m.type.sval;
                        }
                        int pi = 0;
                        while (pi < m.kids.Count) {
                            Node p = m.kids[pi];
                            if (p.kind == AK.Param() && p.sval != null && p.sval != "") {
                                msym.ParamNames.Add(p.sval);
                            }
                            pi = pi + 1;
                        }
                        symbols.Add(msym);
                    } else if (m.kind == AK.FieldDecl()) {
                        AddFieldSymbol(uri, m);
                    } else if (m.kind == AK.CtorDecl()) {
                        LspSymbol csym = new LspSymbol(uri, d.sval,
                            LspSymbol.KindCtor(), m.line, m.col);
                        csym.TypeName = d.sval;
                        int pi = 0;
                        while (pi < m.kids.Count) {
                            Node p = m.kids[pi];
                            if (p.kind == AK.Param() && p.sval != null && p.sval != "") {
                                csym.ParamNames.Add(p.sval);
                            }
                            pi = pi + 1;
                        }
                        symbols.Add(csym);
                    } else if (m.kind == AK.EnumDecl()) {
                        int k = 0;
                        while (k < m.kids.Count) {
                            Node em = m.kids[k];
                            if (em.kind == AK.EnumMember()) {
                                symbols.Add(new LspSymbol(uri, em.sval,
                                    LspSymbol.KindEnum(), em.line, em.col));
                            }
                            k = k + 1;
                        }
                    }
                    j = j + 1;
                }
            }
            i = i + 1;
        }
    }

    static void AddFieldSymbol(string uri, Node f) {
        symbols.Add(new LspSymbol(uri, f.sval, LspSymbol.KindField(),
            f.line, f.col));
        int i = 0;
        while (i < f.kids.Count) {
            Node k = f.kids[i];
            if (k.kind == AK.FieldDecl()) { AddFieldSymbol(uri, k); }
            i = i + 1;
        }
    }

    /// Diags.items → LSP diagnostics 数组 JSON（行列 1-based → 0-based；
    /// 列出站转 UTF-16 口径，text 为该文档正文）。
    static string DiagArray(Diags dg, string text) {
        StringBuilder sb = new StringBuilder();
        sb.Append('[');
        int i = 0;
        while (i < dg.items.Count) {
            Diag d = dg.items[i];
            if (i > 0) { sb.Append(','); }
            int dl = d.line > 0 ? d.line - 1 : 0;
            int dc = d.col > 0 ? Utf16ColOf(text, dl, d.col - 1) : 0;
            sb.Append("{\"severity\":");
            sb.Append(d.warn ? "2" : "1");
            sb.Append(",\"range\":{\"start\":{\"line\":");
            sb.Append(dl);
            sb.Append(",\"character\":");
            sb.Append(dc);
            sb.Append("},\"end\":{\"line\":");
            sb.Append(dl);
            sb.Append(",\"character\":");
            sb.Append(dc + 1);
            sb.Append("}},\"source\":\"zan\",");
            sb.Append("\"message\":");
            sb.Append(EncodeJsonString(d.msg));
            sb.Append('}');
            i = i + 1;
        }
        sb.Append(']');
        return sb.ToString();
    }

    static void PublishDiagnostics(string uri, int version, string diagJson) {
        string res = "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{"
            + "\"uri\":" + EncodeJsonString(uri) + ","
            + "\"version\":" + version + ","
            + "\"diagnostics\":" + diagJson
            + "}}";
        SendResponse(res);
    }

    // ============================ 位置/词工具 ============================

    static bool IsWordChar(char c) {
        return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
            || (c >= '0' && c <= '9') || c == '_';
    }

    /// 0-based 行号 → 行首偏移（行按 '\n' 计，与 LSP 口径一致）。
    static int LineStartOf(string text, int line0) {
        if (line0 <= 0) { return 0; }
        int line = 0;
        int i = 0;
        while (i < text.Length) {
            if (text[i] == '\n') {
                line = line + 1;
                if (line == line0) { return i + 1; }
            }
            i = i + 1;
        }
        return -1;
    }

    /// 光标处词的首字节列（与 WordAt 同一扩展规则）；光标处无词返回 -1。
    /// prepareRename 取 range 起点用。
    static int WordStartAt(string text, int line0, int char0) {
        int ls = LineStartOf(text, line0);
        if (ls < 0) { return -1; }
        int le = ls;
        while (le < text.Length && text[le] != '\n') { le = le + 1; }
        int rel = char0;
        if (rel > le - ls) { rel = le - ls; }
        int s = rel;
        while (s > 0 && IsWordChar(text[ls + s - 1])) { s = s - 1; }
        int e = rel;
        while (e < le - ls && IsWordChar(text[ls + e])) { e = e + 1; }
        return e > s ? s : -1;
    }

    /// 光标处词：先向左扩到词首再向右扩到词尾；光标左邻不是词字符时
    /// 取右侧词（光标停在词首前仍可选中）。
    static string WordAt(string text, int line0, int char0) {
        int s = WordStartAt(text, line0, char0);
        if (s < 0) { return ""; }
        int ls = LineStartOf(text, line0);
        int e = s;
        while (ls + e < text.Length && text[ls + e] != '\n'
                && IsWordChar(text[ls + e])) {
            e = e + 1;
        }
        return text.Substring(ls + s, e - s);
    }

    /// 行内字节列（0-based）→ UTF-16 code unit 列（LSP 口径）。
    /// 每字节序列 1 unit（ASCII/2 字节/3 字节）或 2 units（4 字节代理对），
    /// 与 C 宿主 lsp_main.c utf8_seq_info 同表。
    static int Utf16ColOf(string text, int line0, int byteCol0) {
        if (text == null) { return byteCol0; }
        int ls = LineStartOf(text, line0);
        if (ls < 0) { return byteCol0; }
        int end = ls + byteCol0;
        if (end > text.Length) { end = text.Length; }
        int units = 0;
        int i = ls;
        while (i < end) {
            int c = text[i] & 255;
            if (c >= 240 && i + 3 < text.Length) { i = i + 4; units = units + 2; }
            else if (c >= 224) { i = i + 3; units = units + 1; }
            else if (c >= 192 && i + 1 < text.Length) { i = i + 2; units = units + 1; }
            else { i = i + 1; units = units + 1; }
        }
        return units;
    }

    /// UTF-16 code unit 列（LSP 入站）→ 行内字节列。落在代理对中间
    /// （units + 2 > 目标）时取该码点起点，与客户端点击语义一致。
    static int ByteColAt(string text, int line0, int utf16Col) {
        if (text == null || utf16Col <= 0) { return 0; }
        int ls = LineStartOf(text, line0);
        if (ls < 0) { return 0; }
        int le = ls;
        while (le < text.Length && text[le] != '\n') { le = le + 1; }
        int units = 0;
        int i = ls;
        while (i < le && units < utf16Col) {
            int c = text[i] & 255;
            int step = 1;
            int u = 1;
            if (c >= 240 && i + 3 < text.Length) { step = 4; u = 2; }
            else if (c >= 224) { step = 3; u = 1; }
            else if (c >= 192 && i + 1 < text.Length) { step = 2; u = 1; }
            if (units + u > utf16Col) { break; }
            i = i + step;
            units = units + u;
        }
        return i - ls;
    }

    /// 符号列转换（目标文档未打开时原样透传字节列）。
    static int SymColOf(string text, int line0, int byteCol0) {
        return text != null ? Utf16ColOf(text, line0, byteCol0) : byteCol0;
    }

    /// 关键字表（bootstrap subset 全集；completion 补全与 rename 校验共用）。
    static List<string> KeywordList() {
        string kws = "abstract as base bool break byte case char class const continue"
            + " default do double else enum false finally float for foreach get if"
            + " in int interface is long namespace new null object out override"
            + " params private protected public readonly ref return set short"
            + " static string struct switch this throw true try typeof uint ulong"
            + " ushort using virtual void while";
        return kws.Split(" ");
    }

    /// 关键字判定（rename 拒绝以关键字为词/新名，同 C 宿主 intel_is_keyword）。
    static bool IsKeywordWord(string w) {
        return KeywordList().Contains(w);
    }

    /// 词边界全文匹配（references 用）：命中处前后都不是词字符。
    /// 返回 0-based 位置列表（近似——不含语义过滤，见头部局限说明）。
    static List<LspPos> WordPositions(string text, string word) {
        List<LspPos> outp = new List<LspPos>();
        if (word.Length == 0) { return outp; }
        int line = 0;
        int lineStart = 0;
        int i = 0;
        while (i + word.Length <= text.Length) {
            if (text[i] == '\n') {
                line = line + 1;
                lineStart = i + 1;
                i = i + 1;
                continue;
            }
            if ((i == 0 || !IsWordChar(text[i - 1]))
                    && (i + word.Length == text.Length
                        || !IsWordChar(text[i + word.Length]))) {
                if (text.Substring(i, word.Length) == word) {
                    outp.Add(new LspPos(line, i - lineStart));
                    i = i + word.Length;
                    continue;
                }
            }
            i = i + 1;
        }
        return outp;
    }

    // ============================ 请求处理 ============================

    // 格式化输出 JSON-RPC 2.0 响应 (包含 Content-Length 头部)
    public static void SendResponse(string jsonBody) {
        int len = jsonBody.Length;
        string header = "Content-Length: " + len.ToString() + "\r\n\r\n";
        WriteRaw(header);
        WriteRaw(jsonBody);
    }

    static void WriteRaw(string s) {
        int i = 0;
        while (i < s.Length) {
            putchar((int)s[i]);
            i = i + 1;
        }
    }

    /// LSP 位置对象 JSON（行列 0-based 直传）。
    static string PosJson(int line, int character) {
        return "{\"line\":" + line + ",\"character\":" + character + "}";
    }

    static string LocationJson(string uri, int line0, int col0) {
        return "{\"uri\":" + EncodeJsonString(uri)
            + ",\"range\":{\"start\":" + PosJson(line0, col0)
            + ",\"end\":" + PosJson(line0, col0 + 1) + "}}";
    }

    // 处理一条 LSP 消息（params 是潜在关键字面，局部用 pms）
    public static void HandleMessage(string rawJson) {
        string method = ExtractJsonField(rawJson, "method");
        string id = ExtractJsonField(rawJson, "id");
        string pms = ExtractJsonContainer(rawJson, "params");

        if (method == "initialize") {
            // 能力如实声明：全量同步 + 诊断 + 补全/悬停/定义/引用/文档符号
            // 位置口径：UTF-16 code unit（LSP 默认；出入站均在协议边界转换）
            string res = "{\"jsonrpc\":\"2.0\",\"id\":" + (id == "" ? "1" : id) + ",\"result\":{"
                + "\"capabilities\":{"
                + "\"textDocumentSync\":1,"
                + "\"completionProvider\":{\"resolveProvider\":false,\"triggerCharacters\":[\".\"]},"
                + "\"hoverProvider\":true,"
                + "\"definitionProvider\":true,"
                + "\"referencesProvider\":true,"
                + "\"documentSymbolProvider\":true,"
                + "\"renameProvider\":{\"prepareProvider\":true},"
                + "\"documentHighlightProvider\":true,"
                + "\"foldingRangeProvider\":true,"
                + "\"documentFormattingProvider\":true,"
                + "\"documentRangeFormattingProvider\":true,"
                + "\"inlayHintProvider\":{\"resolveProvider\":false},"
                + "\"semanticTokensProvider\":{"
                + "\"legend\":{\"tokenTypes\":["
                + "\"namespace\",\"type\",\"class\",\"enum\",\"interface\","
                + "\"struct\",\"parameter\",\"variable\",\"property\","
                + "\"function\",\"method\",\"keyword\",\"string\",\"number\","
                + "\"operator\"],\"tokenModifiers\":[]},\"full\":true}"
                + "}}}";
            SendResponse(res);
            return;
        }

        if (method == "textDocument/didOpen") {
            string td = ExtractJsonContainer(pms, "textDocument");
            string uri = ExtractJsonField(td, "uri");
            string text = ExtractJsonField(td, "text");
            int ver = ExtractJsonInt(td, "version", 1);
            StoreDocument(uri, text, ver);
            Analyze(uri, text, ver);
            return;
        }

        if (method == "textDocument/didChange") {
            // textDocumentSync=1 全量同步：取 contentChanges[0].text
            string td = ExtractJsonContainer(pms, "textDocument");
            string uri = ExtractJsonField(td, "uri");
            int ver = ExtractJsonInt(td, "version", 1);
            string changes = ExtractJsonContainer(pms, "contentChanges");
            string text = "";
            if (changes.StartsWith("[") && changes.Length > 1) {
                // 第一个元素的 text 字段（全量同步下通常只有一个变更）
                text = ExtractJsonField(changes.Substring(1), "text");
            }
            StoreDocument(uri, text, ver);
            Analyze(uri, text, ver);
            return;
        }

        if (method == "textDocument/didClose") {
            string td = ExtractJsonContainer(pms, "textDocument");
            string uri = ExtractJsonField(td, "uri");
            LspDocument doc = FindDocument(uri);
            int lastVer = doc != null ? doc.Version : 0;
            RemoveDocument(uri);
            RemoveSymbolsOf(uri);
            // 清空诊断（带最后已知版本号，与 C 宿主行为一致）
            PublishDiagnostics(uri, lastVer, "[]");
            return;
        }

        if (method == "textDocument/completion") {
            HandleCompletion(id, pms);
            return;
        }

        if (method == "textDocument/hover") {
            HandleHover(id, pms);
            return;
        }

        if (method == "textDocument/definition") {
            HandleDefinition(id, pms);
            return;
        }

        if (method == "textDocument/references") {
            HandleReferences(id, pms);
            return;
        }

        if (method == "textDocument/rename") {
            HandleRename(id, pms);
            return;
        }

        if (method == "textDocument/prepareRename") {
            HandlePrepareRename(id, pms);
            return;
        }

        if (method == "textDocument/documentHighlight") {
            HandleDocumentHighlight(id, pms);
            return;
        }

        if (method == "textDocument/foldingRange") {
            HandleFoldingRange(id, pms);
            return;
        }

        if (method == "textDocument/formatting") {
            HandleFormatting(id, pms);
            return;
        }

        if (method == "textDocument/rangeFormatting") {
            HandleRangeFormatting(id, pms);
            return;
        }

        if (method == "textDocument/inlayHint") {
            HandleInlayHint(id, pms);
            return;
        }

        if (method == "textDocument/semanticTokens/full") {
            HandleSemanticTokens(id, pms);
            return;
        }

        if (method == "textDocument/documentSymbol") {
            HandleDocumentSymbol(id, pms);
            return;
        }

        if (method == "shutdown") {
            SendResponse("{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"result\":null}");
            return;
        }

        if (method == "exit") {
            isRunning = false;
            return;
        }

        // 未知通知（initialized、$/cancelRequest 等）静默忽略；
        // 未知带 ID 请求返回空结果
        if (id != "") {
            SendResponse("{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"result\":null}");
        }
    }

    static void HandleCompletion(string id, string pms) {
        string td = ExtractJsonContainer(pms, "textDocument");
        string uri = ExtractJsonField(td, "uri");
        string pos = ExtractJsonContainer(pms, "position");
        int line = ExtractJsonInt(pos, "line", 0);
        int character = ExtractJsonInt(pos, "character", 0);
        string prefix = "";
        LspDocument doc = FindDocument(uri);
        if (doc != null && character > 0) {
            int bcol = ByteColAt(doc.Text, line, character);
            if (bcol > 0) { prefix = WordAt(doc.Text, line, bcol - 1); }
        }
        StringBuilder sb = new StringBuilder();
        sb.Append("{\"jsonrpc\":\"2.0\",\"id\":");
        sb.Append(id);
        sb.Append(",\"result\":[");
        bool first = true;
        List<string> kwList = KeywordList();
        int i = 0;
        while (i < kwList.Count) {
            string kw = kwList[i];
            if (prefix == "" || kw.StartsWith(prefix)) {
                if (!first) { sb.Append(','); }
                first = false;
                sb.Append("{\"label\":");
                sb.Append(EncodeJsonString(kw));
                sb.Append(",\"kind\":14,\"detail\":\"keyword\"}");
            }
            i = i + 1;
        }
        // 内建类型
        string builtins = "sbyte ushort uint ulong nint nfloat double decimal"
            + " char object List Dictionary Task StringBuilder Console Convert Math";
        List<string> biList = builtins.Split(" ");
        i = 0;
        while (i < biList.Count) {
            string bi = biList[i];
            if ((prefix == "" || bi.StartsWith(prefix)) && !kwList.Contains(bi)) {
                if (!first) { sb.Append(','); }
                first = false;
                sb.Append("{\"label\":");
                sb.Append(EncodeJsonString(bi));
                sb.Append(",\"kind\":7,\"detail\":\"built-in type\"}");
            }
            i = i + 1;
        }
        // 打开文档的声明符号
        EnsureInit();
        i = 0;
        while (i < symbols.Count) {
            LspSymbol sym = symbols[i];
            if ((prefix == "" || sym.Name.StartsWith(prefix))
                    && !kwList.Contains(sym.Name)) {
                if (!first) { sb.Append(','); }
                first = false;
                sb.Append("{\"label\":");
                sb.Append(EncodeJsonString(sym.Name));
                sb.Append(",\"kind\":");
                sb.Append(sym.CompletionKind());
                sb.Append(",\"detail\":");
                sb.Append(EncodeJsonString(sym.KindText()));
                sb.Append("}");
            }
            i = i + 1;
        }
        sb.Append("]}");
        SendResponse(sb.ToString());
    }

    /// hover / definition 共用的符号查找：先声明索引，再内建类型。
    static LspSymbol FindSymbol(string name) {
        EnsureInit();
        int i = 0;
        while (i < symbols.Count) {
            if (symbols[i].Name == name) { return symbols[i]; }
            i = i + 1;
        }
        return null;
    }

    static void HandleHover(string id, string pms) {
        string td = ExtractJsonContainer(pms, "textDocument");
        string uri = ExtractJsonField(td, "uri");
        string pos = ExtractJsonContainer(pms, "position");
        int line = ExtractJsonInt(pos, "line", 0);
        int character = ExtractJsonInt(pos, "character", 0);
        string word = "";
        LspDocument doc = FindDocument(uri);
        if (doc != null) {
            word = WordAt(doc.Text, line, ByteColAt(doc.Text, line, character));
        }
        if (word.Length == 0) {
            SendResponse("{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"result\":null}");
            return;
        }
        string kindText = "";
        string whereTxt = "";
        LspSymbol sym = FindSymbol(word);
        if (sym != null) {
            kindText = sym.KindText();
            whereTxt = "declared at " + sym.Uri + ":" + sym.Line;
        } else if (IsBuiltinType(word)) {
            kindText = "built-in type";
            whereTxt = "zan core";
        }
        if (kindText == "") {
            SendResponse("{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"result\":null}");
            return;
        }
        string md = "`" + word + "` — " + kindText + "\n\n" + whereTxt;
        string res = "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"result\":{"
            + "\"contents\":{\"kind\":\"markdown\",\"value\":"
            + EncodeJsonString(md) + "}}}";
        SendResponse(res);
    }

    static bool IsBuiltinType(string name) {
        return name == "int" || name == "long" || name == "short"
            || name == "byte" || name == "sbyte" || name == "uint"
            || name == "ulong" || name == "ushort" || name == "bool"
            || name == "string" || name == "char" || name == "double"
            || name == "float" || name == "object" || name == "void"
            || name == "decimal" || name == "nint";
    }

    static void HandleDefinition(string id, string pms) {
        string td = ExtractJsonContainer(pms, "textDocument");
        string uri = ExtractJsonField(td, "uri");
        string pos = ExtractJsonContainer(pms, "position");
        int line = ExtractJsonInt(pos, "line", 0);
        int character = ExtractJsonInt(pos, "character", 0);
        string word = "";
        LspDocument doc = FindDocument(uri);
        if (doc != null) {
            word = WordAt(doc.Text, line, ByteColAt(doc.Text, line, character));
        }
        LspSymbol sym = word.Length > 0 ? FindSymbol(word) : null;
        if (sym == null) {
            SendResponse("{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"result\":null}");
            return;
        }
        LspDocument tdoc = FindDocument(sym.Uri);
        int tcol = SymColOf(tdoc != null ? tdoc.Text : null, sym.Line - 1, sym.Col - 1);
        string res = "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"result\":"
            + LocationJson(sym.Uri, sym.Line - 1, tcol) + "}";
        SendResponse(res);
    }

    static void HandleReferences(string id, string pms) {
        string td = ExtractJsonContainer(pms, "textDocument");
        string uri = ExtractJsonField(td, "uri");
        string pos = ExtractJsonContainer(pms, "position");
        int line = ExtractJsonInt(pos, "line", 0);
        int character = ExtractJsonInt(pos, "character", 0);
        string word = "";
        LspDocument doc = FindDocument(uri);
        if (doc != null) {
            word = WordAt(doc.Text, line, ByteColAt(doc.Text, line, character));
        }
        if (word.Length == 0) {
            SendResponse("{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"result\":[]}");
            return;
        }
        // 声明处排最前，随后按打开文档顺序做词边界文本匹配（近似）
        StringBuilder sb = new StringBuilder();
        sb.Append("{\"jsonrpc\":\"2.0\",\"id\":");
        sb.Append(id);
        sb.Append(",\"result\":[");
        bool first = true;
        LspSymbol sym = FindSymbol(word);
        if (sym != null) {
            LspDocument tdoc = FindDocument(sym.Uri);
            int tcol = SymColOf(tdoc != null ? tdoc.Text : null,
                sym.Line - 1, sym.Col - 1);
            sb.Append(LocationJson(sym.Uri, sym.Line - 1, tcol));
            first = false;
        }
        EnsureInit();
        int di = 0;
        while (di < documents.Count) {
            LspDocument d = documents[di];
            List<LspPos> hits = WordPositions(d.Text, word);
            int i = 0;
            while (i < hits.Count) {
                LspPos p = hits[i];
                // 声明位置已单独报过，跳过重复
                if (!(sym != null && d.Uri == sym.Uri
                        && p.Line == sym.Line - 1 && p.Col == sym.Col - 1)) {
                    if (!first) { sb.Append(','); }
                    first = false;
                    sb.Append(LocationJson(d.Uri, p.Line,
                        Utf16ColOf(d.Text, p.Line, p.Col)));
                }
                i = i + 1;
            }
            di = di + 1;
        }
        sb.Append("]}");
        SendResponse(sb.ToString());
    }

    /// textDocument/prepareRename：光标处词存在且非关键字即可重命名
    /// （词边界近似口径，不做语义可改性判定）。返回 {range, placeholder}，
    /// 列为 UTF-16；无文档/无词/关键字 → null。
    static void HandlePrepareRename(string id, string pms) {
        string td = ExtractJsonContainer(pms, "textDocument");
        string uri = ExtractJsonField(td, "uri");
        string pos = ExtractJsonContainer(pms, "position");
        int line = ExtractJsonInt(pos, "line", 0);
        int character = ExtractJsonInt(pos, "character", 0);
        LspDocument doc = FindDocument(uri);
        if (doc == null) {
            SendResponse("{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"result\":null}");
            return;
        }
        int bcol = ByteColAt(doc.Text, line, character);
        string word = WordAt(doc.Text, line, bcol);
        if (word.Length == 0 || IsKeywordWord(word)) {
            SendResponse("{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"result\":null}");
            return;
        }
        int scol = WordStartAt(doc.Text, line, bcol);
        int u16s = Utf16ColOf(doc.Text, line, scol);
        int u16e = Utf16ColOf(doc.Text, line, scol + word.Length);
        SendResponse("{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"result\":{"
            + "\"range\":{\"start\":" + PosJson(line, u16s)
            + ",\"end\":" + PosJson(line, u16e)
            + "},\"placeholder\":" + EncodeJsonString(word) + "}}");
    }

    /// textDocument/rename：目标词在全部打开文档的词边界出现处统一改写
    /// （与 references 同一近似口径，含语义过滤顺延；声明处本就是词出现
    /// 之一，天然包含）。newName 空/首字符非字母下划线/含非词字符 → null；
    /// newName 是关键字 → error -32602（与 C 宿主 handle_rename 同形）。
    static void HandleRename(string id, string pms) {
        string td = ExtractJsonContainer(pms, "textDocument");
        string uri = ExtractJsonField(td, "uri");
        string pos = ExtractJsonContainer(pms, "position");
        int line = ExtractJsonInt(pos, "line", 0);
        int character = ExtractJsonInt(pos, "character", 0);
        string newName = ExtractJsonField(pms, "newName");
        if (newName.Length == 0 || !IsIdentStart(newName[0])) {
            SendResponse("{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"result\":null}");
            return;
        }
        int ni = 1;
        while (ni < newName.Length) {
            if (!IsWordChar(newName[ni])) {
                SendResponse("{\"jsonrpc\":\"2.0\",\"id\":" + id
                    + ",\"result\":null}");
                return;
            }
            ni = ni + 1;
        }
        if (IsKeywordWord(newName)) {
            SendResponse("{\"jsonrpc\":\"2.0\",\"id\":" + id
                + ",\"error\":{\"code\":-32602,"
                + "\"message\":\"newName is a keyword\"}}");
            return;
        }
        LspDocument doc = FindDocument(uri);
        if (doc == null) {
            SendResponse("{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"result\":null}");
            return;
        }
        string word = WordAt(doc.Text, line, ByteColAt(doc.Text, line, character));
        if (word.Length == 0) {
            SendResponse("{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"result\":null}");
            return;
        }
        // WorkspaceEdit.changes 按打开文档顺序拼接，每文档一组词边界命中
        EnsureInit();
        StringBuilder sb = new StringBuilder();
        sb.Append("{\"jsonrpc\":\"2.0\",\"id\":");
        sb.Append(id);
        sb.Append(",\"result\":{\"changes\":{");
        bool firstDoc = true;
        int di = 0;
        while (di < documents.Count) {
            LspDocument d = documents[di];
            List<LspPos> hits = WordPositions(d.Text, word);
            if (hits.Count > 0) {
                if (!firstDoc) { sb.Append(','); }
                firstDoc = false;
                sb.Append(EncodeJsonString(d.Uri));
                sb.Append(":[");
                int i = 0;
                bool firstEdit = true;
                while (i < hits.Count) {
                    LspPos p = hits[i];
                    int u16s = Utf16ColOf(d.Text, p.Line, p.Col);
                    int u16e = Utf16ColOf(d.Text, p.Line, p.Col + word.Length);
                    if (!firstEdit) { sb.Append(','); }
                    firstEdit = false;
                    sb.Append("{\"range\":{\"start\":");
                    sb.Append(PosJson(p.Line, u16s));
                    sb.Append(",\"end\":");
                    sb.Append(PosJson(p.Line, u16e));
                    sb.Append("},\"newText\":");
                    sb.Append(EncodeJsonString(newName));
                    sb.Append("}");
                    i = i + 1;
                }
                sb.Append("]");
            }
            di = di + 1;
        }
        sb.Append("}}}");
        SendResponse(sb.ToString());
    }

    /// 标识符首字符：字母或下划线（rename 新名校验，同 C 宿主 isalpha||'_'）。
    static bool IsIdentStart(char c) {
        return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_';
    }

    /// textDocument/documentHighlight：光标词在当前文档的词边界出现处
    /// （与 references 同一近似口径，仅单文档，kind=1 Text；无语义过滤顺延）。
    static void HandleDocumentHighlight(string id, string pms) {
        string td = ExtractJsonContainer(pms, "textDocument");
        string uri = ExtractJsonField(td, "uri");
        string pos = ExtractJsonContainer(pms, "position");
        int line = ExtractJsonInt(pos, "line", 0);
        int character = ExtractJsonInt(pos, "character", 0);
        string word = "";
        LspDocument doc = FindDocument(uri);
        if (doc != null) {
            word = WordAt(doc.Text, line, ByteColAt(doc.Text, line, character));
        }
        StringBuilder sb = new StringBuilder();
        sb.Append("{\"jsonrpc\":\"2.0\",\"id\":");
        sb.Append(id);
        sb.Append(",\"result\":[");
        if (word.Length > 0 && doc != null) {
            List<LspPos> hits = WordPositions(doc.Text, word);
            int i = 0;
            while (i < hits.Count) {
                LspPos p = hits[i];
                int u16s = Utf16ColOf(doc.Text, p.Line, p.Col);
                int u16e = Utf16ColOf(doc.Text, p.Line, p.Col + word.Length);
                if (i > 0) { sb.Append(','); }
                sb.Append("{\"range\":{\"start\":");
                sb.Append(PosJson(p.Line, u16s));
                sb.Append(",\"end\":");
                sb.Append(PosJson(p.Line, u16e));
                sb.Append("},\"kind\":1}");
                i = i + 1;
            }
        }
        sb.Append("]}");
        SendResponse(sb.ToString());
    }

    /// textDocument/foldingRange：花括号折叠区间——跨字符串/行注释/块注释
    /// 的状态机逐行扫描（与 C 宿主 handle_folding_range 同口径：花括号进
    /// 字符串字面量与注释不算配对）。startLine/endLine 0-based，endLine 为
    /// 闭括号前一行（LSP 含端点）；同行闭合的单行区间不报。栈 1024 封顶。
    static void HandleFoldingRange(string id, string pms) {
        string td = ExtractJsonContainer(pms, "textDocument");
        string uri = ExtractJsonField(td, "uri");
        LspDocument doc = FindDocument(uri);
        StringBuilder sb = new StringBuilder();
        sb.Append("{\"jsonrpc\":\"2.0\",\"id\":");
        sb.Append(id);
        sb.Append(",\"result\":[");
        if (doc != null) {
            bool inStr = false;
            bool inBlock = false;
            int[] starts = new int[1024];
            int sp = 0;
            int line = 0;
            int i = 0;
            int emitted = 0;
            while (i < doc.Text.Length) {
                // 行内扫描：行注释折断本行，块注释状态跨行
                while (i < doc.Text.Length && doc.Text[i] != '\n') {
                    char c = doc.Text[i];
                    if (inBlock) {
                        if (c == '*' && i + 1 < doc.Text.Length
                                && doc.Text[i + 1] == '/') {
                            inBlock = false;
                            i = i + 2;
                            continue;
                        }
                        i = i + 1;
                        continue;
                    }
                    if (inStr) {
                        if (c == '\\') {
                            if (i + 1 < doc.Text.Length
                                    && doc.Text[i + 1] != '\n') {
                                i = i + 2;
                            } else {
                                i = i + 1;
                            }
                            continue;
                        }
                        if (c == '"') { inStr = false; }
                        i = i + 1;
                        continue;
                    }
                    if (c == '"') { inStr = true; i = i + 1; continue; }
                    if (c == '/' && i + 1 < doc.Text.Length
                            && doc.Text[i + 1] == '/') { break; }
                    if (c == '/' && i + 1 < doc.Text.Length
                            && doc.Text[i + 1] == '*') {
                        inBlock = true;
                        i = i + 2;
                        continue;
                    }
                    if (c == '{') {
                        if (sp < 1024) {
                            starts[sp] = line;
                            sp = sp + 1;
                        }
                    } else if (c == '}') {
                        if (sp > 0) {
                            sp = sp - 1;
                            int s0 = starts[sp];
                            if (line - 1 > s0) {
                                if (emitted > 0) { sb.Append(','); }
                                emitted = emitted + 1;
                                sb.Append("{\"startLine\":");
                                sb.Append(s0);
                                sb.Append(",\"endLine\":");
                                sb.Append(line - 1);
                                sb.Append("}");
                            }
                        }
                    }
                    i = i + 1;
                }
                if (i < doc.Text.Length && doc.Text[i] == '\n') {
                    line = line + 1;
                    i = i + 1;
                } else {
                    break;
                }
            }
        }
        sb.Append("]}");
        SendResponse(sb.ToString());
    }

    // ===================== formatting / rangeFormatting =====================

    /// 偏移量（字节）→ 行号与 UTF-16 列号（同 C 宿主 offset_to_linecol）。
    static LspPos OffsetToLineCol(string text, int offset) {
        if (text == null || offset <= 0) { return new LspPos(0, 0); }
        int ln = 0;
        int col = 0;
        int i = 0;
        int limit = offset < text.Length ? offset : text.Length;
        while (i < limit) {
            int c = text[i] & 255;
            if (c == 10) {
                ln = ln + 1;
                col = 0;
                i = i + 1;
                continue;
            }
            int bytes = 1;
            int cu = 1;
            if (c >= 240 && i + 3 < text.Length) { bytes = 4; cu = 2; }
            else if (c >= 224 && i + 2 < text.Length) { bytes = 3; cu = 1; }
            else if (c >= 192 && i + 1 < text.Length) { bytes = 2; cu = 1; }
            if (i + bytes > limit) {
                col = col + cu;
                break;
            }
            col = col + cu;
            i = i + bytes;
        }
        return new LspPos(ln, col);
    }

    /// 行级缩进深度与空白扫描（同 C 宿主 fmt_scan；括号深度状态机）。
    static List<FmtLine> FmtScan(string text) {
        List<FmtLine> lines = new List<FmtLine>();
        if (text == null || text.Length == 0) { return lines; }

        bool inBlock = false;
        bool inStr = false;
        int depth = 0;
        int p = 0;
        int len = text.Length;

        while (p < len) {
            int lead = 0;
            while (p < len && (text[p] == ' ' || text[p] == '\t')) {
                lead = lead + 1;
                p = p + 1;
            }
            int cs = p;
            int le = p;
            while (le < len && text[le] != '\n') {
                le = le + 1;
            }
            int ce = le;
            while (ce > cs && (text[ce - 1] == ' ' || text[ce - 1] == '\t' || text[ce - 1] == '\r')) {
                ce = ce - 1;
            }
            string content = (ce > cs) ? text.Substring(cs, ce - cs) : "";
            bool blank = (content.Length == 0);

            bool endsOpen = false;
            int q = cs;
            while (q < ce) {
                char c = text[q];
                if (inBlock) {
                    if (c == '*' && q + 1 < ce && text[q + 1] == '/') {
                        inBlock = false;
                        q = q + 2;
                    } else {
                        q = q + 1;
                    }
                    continue;
                }
                if (inStr) {
                    if (c == '\\') {
                        q = q + 2;
                        continue;
                    }
                    if (c == '"') { inStr = false; }
                    q = q + 1;
                    continue;
                }
                if (c == '"') {
                    inStr = true;
                    q = q + 1;
                    continue;
                }
                if (c == '/' && q + 1 < ce && text[q + 1] == '/') {
                    break;
                }
                if (c == '/' && q + 1 < ce && text[q + 1] == '*') {
                    inBlock = true;
                    q = q + 2;
                    continue;
                }
                endsOpen = (c == '{');
                q = q + 1;
            }

            if (!blank && content.Length > 0 && content[0] == '}') {
                depth = depth - 1;
                if (depth < 0) { depth = 0; }
            }
            int lvl = depth;
            if (endsOpen) { depth = depth + 1; }

            lines.Add(new FmtLine(lvl, lead, content, blank));

            if (le < len && text[le] == '\n') {
                p = le + 1;
            } else {
                p = le;
            }
        }
        return lines;
    }

    /// textDocument/formatting：全文档单范围替换 Edit（(0,0) 到文档末尾）。
    static void HandleFormatting(string id, string pms) {
        string td = ExtractJsonContainer(pms, "textDocument");
        string uri = ExtractJsonField(td, "uri");
        LspDocument doc = uri != "" ? FindDocument(uri) : null;
        if (doc == null || doc.Text.Length == 0) {
            SendResponse("{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"result\":[]}");
            return;
        }

        List<FmtLine> lines = FmtScan(doc.Text);
        StringBuilder outText = new StringBuilder();
        int blanks = 0;
        int i = 0;
        while (i < lines.Count) {
            FmtLine L = lines[i];
            if (L.Blank) {
                blanks = blanks + 1;
                if (blanks <= 1) {
                    outText.Append('\n');
                }
                i = i + 1;
                continue;
            }
            blanks = 0;
            int spaces = L.Level * 4;
            int s = 0;
            while (s < spaces) {
                outText.Append(' ');
                s = s + 1;
            }
            outText.Append(L.Content);
            outText.Append('\n');
            i = i + 1;
        }

        if (outText.Length == 0) {
            SendResponse("{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"result\":[]}");
            return;
        }

        LspPos endPos = OffsetToLineCol(doc.Text, doc.Text.Length);
        StringBuilder sb = new StringBuilder();
        sb.Append("{\"jsonrpc\":\"2.0\",\"id\":");
        sb.Append(id);
        sb.Append(",\"result\":[{\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":");
        sb.Append(endPos.Line);
        sb.Append(",\"character\":");
        sb.Append(endPos.Col);
        sb.Append("}},\"newText\":");
        sb.Append(EncodeJsonString(outText.ToString()));
        sb.Append("}]}");
        SendResponse(sb.ToString());
    }

    /// textDocument/rangeFormatting：按行重写前导缩进空格。
    static void HandleRangeFormatting(string id, string pms) {
        string td = ExtractJsonContainer(pms, "textDocument");
        string uri = ExtractJsonField(td, "uri");
        LspDocument doc = uri != "" ? FindDocument(uri) : null;
        if (doc == null || doc.Text.Length == 0) {
            SendResponse("{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"result\":[]}");
            return;
        }

        string rg = ExtractJsonContainer(pms, "range");
        string startObj = ExtractJsonContainer(rg, "start");
        string endObj = ExtractJsonContainer(rg, "end");
        int l0 = ExtractJsonInt(startObj, "line", 0);
        int l1 = ExtractJsonInt(endObj, "line", l0);
        if (l1 < l0) {
            int t = l0;
            l0 = l1;
            l1 = t;
        }

        List<FmtLine> lines = FmtScan(doc.Text);
        if (lines.Count == 0) {
            SendResponse("{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"result\":[]}");
            return;
        }

        if (l1 > lines.Count - 1) {
            l1 = lines.Count - 1;
        }

        StringBuilder sb = new StringBuilder();
        sb.Append("{\"jsonrpc\":\"2.0\",\"id\":");
        sb.Append(id);
        sb.Append(",\"result\":[");
        bool first = true;
        int i = l0;
        while (i <= l1) {
            FmtLine L = lines[i];
            if (!L.Blank) {
                int want = L.Level * 4;
                if (want != L.Lead) {
                    if (!first) { sb.Append(','); }
                    first = false;
                    sb.Append("{\"range\":{\"start\":{\"line\":");
                    sb.Append(i);
                    sb.Append(",\"character\":0},\"end\":{\"line\":");
                    sb.Append(i);
                    sb.Append(",\"character\":");
                    sb.Append(L.Lead);
                    sb.Append("}},\"newText\":");
                    StringBuilder pad = new StringBuilder();
                    int s = 0;
                    while (s < want) {
                        pad.Append(' ');
                        s = s + 1;
                    }
                    sb.Append(EncodeJsonString(pad.ToString()));
                    sb.Append("}");
                }
            }
            i = i + 1;
        }
        sb.Append("]}");
        SendResponse(sb.ToString());
    }

    // ===================== inlayHint =====================

    static bool IsIdentStartChar(char c) {
        return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_';
    }

    /// 在 AST 子树中查找局部变量的推导类型。
    static string FindInferredVarType(Node node, string varName) {
        if (node == null) { return ""; }
        if (node.kind == AK.VarDecl()) {
            if (node.sval == varName && node.type != null && node.type.sval != null
                    && node.type.sval != "" && node.type.sval != "var" && node.type.sval != "void") {
                return node.type.sval;
            }
            int di = 0;
            while (di < node.kids.Count) {
                Node dk = node.kids[di];
                if (dk.sval == varName && dk.type != null && dk.type.sval != null
                        && dk.type.sval != "" && dk.type.sval != "var" && dk.type.sval != "void") {
                    return dk.type.sval;
                }
                di = di + 1;
            }
        }
        int i = 0;
        while (i < node.kids.Count) {
            string t = FindInferredVarType(node.kids[i], varName);
            if (t != "") { return t; }
            i = i + 1;
        }
        if (node.a != null) {
            string t = FindInferredVarType(node.a, varName);
            if (t != "") { return t; }
        }
        if (node.b != null) {
            string t = FindInferredVarType(node.b, varName);
            if (t != "") { return t; }
        }
        if (node.c != null) {
            string t = FindInferredVarType(node.c, varName);
            if (t != "") { return t; }
        }
        if (node.d != null) {
            string t = FindInferredVarType(node.d, varName);
            if (t != "") { return t; }
        }
        return "";
    }

    /// 收集文档的 InlayHints（类型标注 kind=1 + 参数名提示 kind=2，同 C 宿主 intel_collect_inlay_hints）。
    static List<LspInlayHint> CollectInlayHints(string uri, string text, int r0, int r1) {
        List<LspInlayHint> hints = new List<LspInlayHint>();
        if (text == null || text.Length == 0) { return hints; }

        EnsureInit();

        // 1. 类型标注（kind 1）：对 `var <name> = ...` 变量声明
        Lexer lx = new Lexer(text);
        List<Token> toks = lx.Run();
        Diags dg = new Diags();
        Parser ps = new Parser(toks, dg);
        Node unit = ps.ParseDeclsOnly();
        Binder b = new Binder();
        b.Bind(unit);
        Checker ck = new Checker(b, dg);
        ck.Check(unit);

        int ti = 0;
        while (ti < toks.Count && hints.Count < 256) {
            if (toks[ti].kind == TK.Var()) {
                int vi = ti + 1;
                if (vi < toks.Count && toks[vi].kind == TK.Ident()) {
                    string varName = toks[vi].text;
                    int line0 = toks[vi].line - 1; // 0-based
                    if (line0 >= r0 && line0 <= r1) {
                        int byteCol0 = toks[vi].col - 1 + varName.Length;
                        string tyName = FindInferredVarType(unit, varName);
                        if (tyName != "") {
                            int utf16Col = Utf16ColOf(text, line0, byteCol0);
                            hints.Add(new LspInlayHint(line0, utf16Col, ": " + tyName, 1));
                        }
                    }
                }
            }
            ti = ti + 1;
        }

        // 2. 参数名标注（kind 2）：对调用 `fn(...)`
        int p = 0;
        int end = text.Length;
        int lineNum = 0;
        int lineStart = 0;

        while (p < end && hints.Count < 256) {
            char c = text[p];
            if (c == '\n') {
                lineNum = lineNum + 1;
                p = p + 1;
                lineStart = p;
                continue;
            }
            if (c == '"') {
                p = p + 1;
                while (p < end && text[p] != '"') {
                    if (text[p] == '\\' && p + 1 < end) { p = p + 1; }
                    if (text[p] == '\n') {
                        lineNum = lineNum + 1;
                        lineStart = p + 1;
                    }
                    p = p + 1;
                }
                if (p < end) { p = p + 1; }
                continue;
            }
            if (c == '/' && p + 1 < end && text[p + 1] == '/') {
                while (p < end && text[p] != '\n') { p = p + 1; }
                continue;
            }
            if (c == '/' && p + 1 < end && text[p + 1] == '*') {
                p = p + 2;
                while (p + 1 < end && !(text[p] == '*' && text[p + 1] == '/')) {
                    if (text[p] == '\n') {
                        lineNum = lineNum + 1;
                        lineStart = p + 1;
                    }
                    p = p + 1;
                }
                if (p + 1 < end) { p = p + 2; }
                continue;
            }

            if (IsIdentStartChar(c)) {
                int wStart = p;
                while (p < end && IsWordChar(text[p])) { p = p + 1; }
                string fnName = text.Substring(wStart, p - wStart);

                int peek = p;
                while (peek < end && (text[peek] == ' ' || text[peek] == '\t')) { peek = peek + 1; }
                if (peek < end && text[peek] == '(') {
                    if (fnName == "if" || fnName == "while" || fnName == "for"
                            || fnName == "foreach" || fnName == "switch" || fnName == "catch") {
                        p = peek + 1;
                        continue;
                    }

                    // 排除方法/构造函数自身的声明头
                    bool isDecl = false;
                    int di = 0;
                    while (di < symbols.Count) {
                        LspSymbol ds = symbols[di];
                        if (ds.Uri == uri && ds.Line == lineNum + 1 && ds.Name == fnName
                                && (ds.Kind == LspSymbol.KindMethod() || ds.Kind == LspSymbol.KindCtor())) {
                            isDecl = true;
                            break;
                        }
                        di = di + 1;
                    }
                    if (isDecl) {
                        p = peek + 1;
                        continue;
                    }

                    LspSymbol methodSym = null;
                    int si = 0;
                    while (si < symbols.Count) {
                        LspSymbol s = symbols[si];
                        if ((s.Kind == LspSymbol.KindMethod() || s.Kind == LspSymbol.KindCtor())
                                && s.Name == fnName && s.ParamNames.Count > 0) {
                            methodSym = s;
                            break;
                        }
                        si = si + 1;
                    }

                    if (methodSym != null) {
                        int argP = peek + 1;
                        int argIdx = 0;
                        int parenLvl = 1;
                        while (argP < end && parenLvl > 0 && argIdx < methodSym.ParamNames.Count
                                && hints.Count < 256) {
                            while (argP < end && (text[argP] == ' ' || text[argP] == '\t')) {
                                argP = argP + 1;
                            }
                            if (argP >= end || text[argP] == ')') { break; }

                            if (lineNum >= r0 && lineNum <= r1) {
                                int argByteCol = argP - lineStart;
                                int argCol = Utf16ColOf(text, lineNum, argByteCol);
                                hints.Add(new LspInlayHint(lineNum, argCol,
                                    methodSym.ParamNames[argIdx] + ":", 2));
                            }
                            argIdx = argIdx + 1;

                            while (argP < end && parenLvl > 0) {
                                char ac = text[argP];
                                if (ac == '(') {
                                    parenLvl = parenLvl + 1;
                                } else if (ac == ')') {
                                    parenLvl = parenLvl - 1;
                                    if (parenLvl == 0) { break; }
                                } else if (ac == ',' && parenLvl == 1) {
                                    argP = argP + 1;
                                    break;
                                } else if (ac == '\n') {
                                    lineNum = lineNum + 1;
                                    lineStart = argP + 1;
                                }
                                argP = argP + 1;
                            }
                        }
                        p = argP;
                        continue;
                    }
                }
            }
            p = p + 1;
        }

        return hints;
    }

    /// textDocument/inlayHint：返回参数名提示（kind=2）与 var 推导类型标注（kind=1）。
    static void HandleInlayHint(string id, string pms) {
        string td = ExtractJsonContainer(pms, "textDocument");
        string uri = ExtractJsonField(td, "uri");
        LspDocument doc = uri != "" ? FindDocument(uri) : null;
        if (doc == null || doc.Text.Length == 0) {
            SendResponse("{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"result\":[]}");
            return;
        }

        string rg = ExtractJsonContainer(pms, "range");
        int r0 = 0;
        int r1 = 1000000000;
        if (rg != "") {
            string startObj = ExtractJsonContainer(rg, "start");
            string endObj = ExtractJsonContainer(rg, "end");
            r0 = ExtractJsonInt(startObj, "line", 0);
            r1 = ExtractJsonInt(endObj, "line", 1000000000);
            if (r1 < r0) { int t = r0; r0 = r1; r1 = t; }
        }

        List<LspInlayHint> hints = CollectInlayHints(uri, doc.Text, r0, r1);
        StringBuilder sb = new StringBuilder();
        sb.Append("{\"jsonrpc\":\"2.0\",\"id\":");
        sb.Append(id);
        sb.Append(",\"result\":[");
        int i = 0;
        while (i < hints.Count) {
            LspInlayHint h = hints[i];
            if (i > 0) { sb.Append(','); }
            sb.Append("{\"position\":{\"line\":");
            sb.Append(h.Line);
            sb.Append(",\"character\":");
            sb.Append(h.Col);
            sb.Append("},\"label\":");
            sb.Append(EncodeJsonString(h.Label));
            sb.Append(",\"kind\":");
            sb.Append(h.Kind);
            if (h.Kind == 1) {
                sb.Append(",\"paddingLeft\":true");
            } else if (h.Kind == 2) {
                sb.Append(",\"paddingRight\":true");
            }
            sb.Append("}");
            i = i + 1;
        }
        sb.Append("]}");
        SendResponse(sb.ToString());
    }

    // ===================== semanticTokens =====================

    // legend 与 C 宿主 lsp_main.c 同表：0 namespace 1 type 2 class 3 enum
    // 4 interface 5 struct 6 parameter 7 variable 8 property 9 function
    // 10 method 11 keyword 12 string 13 number 14 operator

    /// 内建类型关键字（归 type=1，与 C 宿主 map_token_type 同表）。
    static bool IsBuiltinTypeToken(int kind) {
        return kind == TK.Bool() || kind == TK.Byte() || kind == TK.Char()
            || kind == TK.Double() || kind == TK.Float() || kind == TK.Int()
            || kind == TK.Long() || kind == TK.Object() || kind == TK.Short()
            || kind == TK.String() || kind == TK.Var() || kind == TK.Void()
            || kind == TK.Uint() || kind == TK.Ulong() || kind == TK.Ushort()
            || kind == TK.Sbyte() || kind == TK.Decimal() || kind == TK.Nint();
    }

    /// 符号索引种类 → legend 类型（与 C 宿主 isym→legend 映射同表；
    /// 本索引无 namespace/parameter/variable 符号，未匹配走大小写兜底）。
    static int SymTokenType(LspSymbol sym) {
        if (sym.Kind == LspSymbol.KindClass()) { return 2; }
        if (sym.Kind == LspSymbol.KindStruct()) { return 5; }
        if (sym.Kind == LspSymbol.KindEnum()) { return 3; }
        if (sym.Kind == LspSymbol.KindInterface()) { return 4; }
        if (sym.Kind == LspSymbol.KindMethod()
                || sym.Kind == LspSymbol.KindCtor()) { return 10; }
        if (sym.Kind == LspSymbol.KindField()) { return 8; }
        if (sym.Kind == LspSymbol.KindDelegate()) { return 9; }
        return -1;
    }

    /// textDocument/semanticTokens/full：真前端 Lexer token 流 + 符号索引
    /// 分类，输出相对编码五元组 [deltaLine, deltaStart, length, type, 0]。
    /// 列与长度出站均 UTF-16。已知口径：字符串/字符字面量的 Token.text 是
    /// 不含引号的值，length +2 补引号（插值串分段近似同口径）；
    /// 括号/分号等结构标点不产出（同 C 宿主 default -1）；C 宿主把
    /// operator 归 keyword(11)，selfhost 按语义归 operator(14)——legend
    /// 由本表声明，客户端按表着色。
    static void HandleSemanticTokens(string id, string pms) {
        string td = ExtractJsonContainer(pms, "textDocument");
        string uri = ExtractJsonField(td, "uri");
        LspDocument doc = FindDocument(uri);
        StringBuilder sb = new StringBuilder();
        sb.Append("{\"jsonrpc\":\"2.0\",\"id\":");
        sb.Append(id);
        sb.Append(",\"result\":{\"data\":[");
        if (doc != null) {
            Lexer lx = new Lexer(doc.Text);
            List<Token> toks = lx.Run();
            int prevLine = 0;
            int prevChar = 0;
            int emitted = 0;
            int i = 0;
            while (i < toks.Count) {
                Token tok = toks[i];
                i = i + 1;
                int ttype = -1;
                int tlenBytes = tok.text.Length;
                if (tok.kind == TK.Ident()) {
                    LspSymbol sym = FindSymbol(tok.text);
                    if (sym != null) { ttype = SymTokenType(sym); }
                    if (ttype < 0) {
                        // 无符号匹配：首字母大写兜底 type，否则 variable
                        // （与 C 宿主 fallback 同口径）
                        if (tlenBytes > 0 && tok.text[0] >= 'A'
                                && tok.text[0] <= 'Z') {
                            ttype = 1;
                        } else {
                            ttype = 7;
                        }
                    }
                } else if (tok.kind == TK.StringLit()
                        || tok.kind == TK.CharLit()) {
                    ttype = 12;
                    tlenBytes = tok.text.Length + 2; // 补两侧引号
                } else if (tok.kind == TK.IntLit()
                        || tok.kind == TK.FloatLit()) {
                    ttype = 13;
                } else if (IsBuiltinTypeToken(tok.kind)) {
                    ttype = 1;
                } else if (tok.kind >= TK.Arrow()) {
                    // => 与算术/比较/逻辑/赋值/移位族
                    ttype = 14;
                } else if (tok.kind >= TK.Abstract() && tok.kind < TK.LParen()) {
                    ttype = 11;
                }
                if (ttype < 0 || tlenBytes <= 0) { continue; }
                int line0 = tok.line - 1;
                if (line0 < 0) { line0 = 0; }
                int u16s = Utf16ColOf(doc.Text, line0, tok.col - 1);
                int u16e = Utf16ColOf(doc.Text, line0,
                    tok.col - 1 + tlenBytes);
                int len16 = u16e - u16s;
                if (len16 <= 0) { continue; }
                int dLine = line0 - prevLine;
                int dStart = dLine == 0 ? u16s - prevChar : u16s;
                if (emitted > 0) { sb.Append(','); }
                emitted = emitted + 1;
                sb.Append(dLine + "," + dStart + "," + len16 + "," + ttype
                    + ",0");
                prevLine = line0;
                prevChar = u16s;
            }
        }
        // ] 收 data 数组，} 收 result 对象，} 收根对象——result 比其他
        // handler 多嵌套一层（对象包数组），收尾三字符缺一不可
        sb.Append("]}}");
        SendResponse(sb.ToString());
    }

    /// 嵌套 DocumentSymbol：类/接口/枚举为父，方法/字段/构造器为 children。
    /// 类节点在 AST 无行列，range 用 token 扫描得到的名字位置（见头部说明）。
    static void HandleDocumentSymbol(string id, string pms) {
        string td = ExtractJsonContainer(pms, "textDocument");
        string uri = ExtractJsonField(td, "uri");
        StringBuilder sb = new StringBuilder();
        sb.Append("{\"jsonrpc\":\"2.0\",\"id\":");
        sb.Append(id);
        sb.Append(",\"result\":[");
        EnsureInit();
        LspDocument sdoc = FindDocument(uri);
        string stext = sdoc != null ? sdoc.Text : null;
        bool first = true;
        int i = 0;
        while (i < symbols.Count) {
            LspSymbol top = symbols[i];
            if (top.Uri != uri || IsMemberKind(top.Kind)) { i = i + 1; continue; }
            int tc0 = SymColOf(stext, top.Line - 1, top.Col - 1);
            if (!first) { sb.Append(','); }
            first = false;
            sb.Append("{\"name\":");
            sb.Append(EncodeJsonString(top.Name));
            sb.Append(",\"kind\":");
            sb.Append(top.SymbolKind());
            sb.Append(",\"range\":{\"start\":");
            sb.Append(PosJson(top.Line - 1, tc0));
            sb.Append(",\"end\":");
            sb.Append(PosJson(top.Line - 1, tc0));
            sb.Append("},\"selectionRange\":{\"start\":");
            sb.Append(PosJson(top.Line - 1, tc0));
            sb.Append(",\"end\":");
            sb.Append(PosJson(top.Line - 1, tc0));
            sb.Append("},\"children\":[");
            int j = 0;
            bool mfirst = true;
            while (j < symbols.Count) {
                LspSymbol m = symbols[j];
                if (m.Uri == uri && IsMemberKind(m.Kind)) {
                    int mc0 = SymColOf(stext, m.Line - 1, m.Col - 1);
                    if (!mfirst) { sb.Append(','); }
                    mfirst = false;
                    sb.Append("{\"name\":");
                    sb.Append(EncodeJsonString(m.Name));
                    sb.Append(",\"kind\":");
                    sb.Append(m.SymbolKind());
                    sb.Append(",\"range\":{\"start\":");
                    sb.Append(PosJson(m.Line - 1, mc0));
                    sb.Append(",\"end\":");
                    sb.Append(PosJson(m.Line - 1, mc0));
                    sb.Append("},\"selectionRange\":{\"start\":");
                    sb.Append(PosJson(m.Line - 1, mc0));
                    sb.Append(",\"end\":");
                    sb.Append(PosJson(m.Line - 1, mc0));
                    sb.Append("}}");
                }
                j = j + 1;
            }
            sb.Append("]}");
            i = i + 1;
        }
        sb.Append("]}");
        SendResponse(sb.ToString());
    }

    static bool IsMemberKind(int kind) {
        return kind == LspSymbol.KindMethod() || kind == LspSymbol.KindField()
            || kind == LspSymbol.KindCtor() || kind == LspSymbol.KindEnum()
            || kind == LspSymbol.KindDelegate();
    }

    // 启动基于标准输入的 LSP 主事件循环
    public static void Run() {
        EnsureInit();
        isRunning = true;
        while (isRunning) {
            string line = "";
            int c = getchar();
            if (c < 0) { break; }
            while (c >= 0 && c != 10) {
                if (c != 13) {
                    line = line + Convert.ToString((char)c);
                }
                c = getchar();
            }
            if (line.StartsWith("Content-Length:")) {
                string lenStr = line.Substring(15).Trim();
                int contentLen = int.Parse(lenStr);
                // 读取随后的空行 (\r\n)
                c = getchar();
                while (c >= 0 && c != 10) { c = getchar(); }
                // 读取指定长度的 JSON 请求体：逐字节入 buf 后 ToStr 还原
                // UTF-8。不能走 (char)c 再 ToString——char 是码点，
                // ≥0x80 的字节会被 Latin-1→UTF-8 二次编码（CJK 全坏，
                // 列口径整体漂移；见 B-ID200 UTF-16 切片）。
                byte[] buf = new byte[contentLen > 0 ? contentLen : 1];
                int count = 0;
                while (count < contentLen) {
                    c = getchar();
                    if (c < 0) { break; }
                    buf[count] = (byte)c;
                    count = count + 1;
                }
                string body = buf.ToStr(0, count);
                if (body.Length > 0) {
                    HandleMessage(body);
                }
            }
        }
    }
}
