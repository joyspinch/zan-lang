using System;
using System.Collections.Generic;
using System.IO;
using System.Text;

namespace Zan;

class LspProjectManifests {
    public string Root;
    public Dictionary<string, bool> Paths = new Dictionary<string, bool>();
}

public class LspDiskFile {
    public string Uri;
    public string FilePath;
    public string Text;

    public LspDiskFile(string uri, string filePath, string text) {
        Uri = uri;
        FilePath = filePath;
        Text = text;
    }
}

class LspExternalFileCache {
    public string Uri;
    public string FilePath;
    public string Text;
    public List<LspSymbol> Symbols;

    public LspExternalFileCache(string uri, string filePath, string text, List<LspSymbol> syms) {
        Uri = uri;
        FilePath = filePath;
        Text = text;
        Symbols = syms;
    }
}

public partial class LspServer {
    static string workspaceRoot;
    static Dictionary<string, LspProjectManifests> projectManifests = new Dictionary<string, LspProjectManifests>();
    static Dictionary<string, List<LspDiskFile>> projectDiskFiles = new Dictionary<string, List<LspDiskFile>>();
    static Dictionary<string, List<LspSymbol>> projectDiskSymbols = new Dictionary<string, List<LspSymbol>>();
    static Dictionary<string, LspExternalFileCache> externalFileCache = new Dictionary<string, LspExternalFileCache>();
    static Dictionary<string, List<LspSymbol>> projectExternalSymbols = new Dictionary<string, List<LspSymbol>>();
    static Dictionary<string, List<LspExternalFileCache>> projectExternalFiles = new Dictionary<string, List<LspExternalFileCache>>();

    static string WorkspacePath(string uri) {
        if (!uri.StartsWith("file://")) { return ""; }
        string path = uri.Substring(7);
        if (path.StartsWith("localhost/")) { path = path.Substring(9); }
        if (path == "") { return ""; }
        #if WINDOWS
        if (!path.StartsWith("/")) { path = "//" + path; }
        #else
        if (!path.StartsWith("/")) { return ""; }
        #endif
        path = Encoding.UrlDecode(path.Replace("+", "%2b"));
        #if WINDOWS
        if (path.Length >= 3 && path[0] == '/' && path[2] == ':') {
            path = path.Substring(1);
        }
        #endif
        try {
            path = Path.GetFullPath(path);
        } catch (ArgumentException ex) {
            return "";
        } catch (IOException ex) {
            return "";
        }
        #if WINDOWS
        path = path.Replace("\\", "/");
        #endif
        while (path.Length > 1 && path.EndsWith("/") && !path.EndsWith(":/")) {
            path = path.Substring(0, path.Length - 1);
        }
        return path;
    }

    static string PathKey(string path) {
        #if WINDOWS
        return path.ToLower();
        #else
        return path;
        #endif
    }

    static string ProjectOf(string path) {
        if (workspaceRoot == null || workspaceRoot == "" || !path.EndsWith(".zan")) { return ""; }
        string root = PathKey(workspaceRoot);
        string prefix = root.EndsWith("/") ? root : root + "/";
        if (!PathKey(path).StartsWith(prefix)) { return ""; }
        int end = path.LastIndexOf("/");
        while (end >= prefix.Length) {
            string dir = path.Substring(0, end);
            if (File.Exists(Path.Combine(dir, "zan.proj"))) { return dir; }
            end = dir.LastIndexOf("/");
        }
        return workspaceRoot;
    }

    static bool SkipSourceDirectory(string name) {
        return name == ".git" || name == "bin" || name == "obj" || name == "build"
            || name == "dist" || name == "node_modules" || name == "target" || name == "_scratch";
    }

    static void AppendDiskSources(string dir, List<string> paths, Dictionary<string, bool> manifests) {
        if (!Directory.ExistsOnDisk(dir)) { return; }
        List<string> files;
        List<string> children;
        try {
            files = Directory.GetFiles(dir, "*.zan");
            children = Directory.GetDirectoryPaths(dir);
        } catch (IOException ex) {
            return;
        }
        for (int i = 0; i < files.Count; i = i + 1) {
            string path = files[i];
            if (path.EndsWith(".zan") && !File.IsReparsePoint(path)) { paths.Add(path); }
        }
        for (int i = 0; i < children.Count; i = i + 1) {
            string child = children[i];
            if (SkipSourceDirectory(Path.GetFileName(child)) || File.IsReparsePoint(child)) { continue; }
            string manifest = Path.Combine(child, "zan.proj");
            bool exists = File.Exists(manifest);
            // Keep excluded boundaries too so removing their manifest brings sources back in.
            manifests[manifest] = exists;
            if (!exists) { AppendDiskSources(child, paths, manifests); }
        }
    }

    static void ReadLexerDiagnostics(Lexer lexer, Diags diagnostics) {
        for (int i = 0; i < lexer.escMsgs.Count; i = i + 1) {
            diagnostics.Error(lexer.escMsgs[i], lexer.escMsgLine[i], lexer.escMsgCol[i]);
        }
    }

    static void AnalyzeDocument(LspDocument doc) {
        RemoveSymbolsOf(doc.Uri);
        Lexer lexer = new Lexer(doc.Text);
        List<Token> tokens = lexer.Run();
        CollectTopLevelSymbols(doc.Uri, tokens);
        Diags diagnostics = new Diags();
        ReadLexerDiagnostics(lexer, diagnostics);
        Parser parser = new Parser(tokens, diagnostics);
        Node unit = parser.ParseDeclsOnly();
        CollectMemberSymbols(doc.Uri, unit);
        RefreshWorkspaceDiagnostics(doc.ProjectRoot, doc);
        if (doc.ProjectRoot == "") {
            AnalyzeStandaloneWithExternals(doc, unit, diagnostics);
            PublishDiagnostics(doc.Uri, doc.Version, DiagArray(diagnostics, doc.Text));
        }
    }

    static string StandaloneExternalKey(string uri) {
        return "standalone:" + PathKey(uri);
    }

    static void ClearStandaloneExternal(string uri) {
        string key = StandaloneExternalKey(uri);
        projectExternalSymbols.Remove(key);
        projectExternalFiles.Remove(key);
    }

    static void AnalyzeStandaloneWithExternals(LspDocument doc, Node unit, Diags diagnostics) {
        List<string> usings = new List<string>();
        Dictionary<string, bool> seenUsing = new Dictionary<string, bool>();
        CollectUsingNamespaces(doc.Text, usings, seenUsing);
        string extKey = StandaloneExternalKey(doc.Uri);
        if (usings.Count == 0) {
            projectExternalSymbols.Remove(extKey);
            projectExternalFiles.Remove(extKey);
            CheckDiagnostics(unit, diagnostics);
            return;
        }
        Dictionary<string, bool> skipPaths = new Dictionary<string, bool>();
        if (doc.FilePath != "") { skipPaths[PathKey(doc.FilePath)] = true; }
        List<LspExternalFileCache> extFiles = new List<LspExternalFileCache>();
        List<LspSymbol> extSyms = new List<LspSymbol>();
        CollectExternalForUsings("", usings, skipPaths, extFiles, extSyms);
        projectExternalFiles[extKey] = extFiles;
        projectExternalSymbols[extKey] = extSyms;
        if (extFiles.Count == 0) {
            CheckDiagnostics(unit, diagnostics);
            return;
        }
        Node merged = new Node(AK.CompUnit());
        Diags mergedDiags = new Diags();
        List<string> names = new List<string>();
        List<int> starts = new List<int>();
        int line = 1;
        names.Add(doc.Uri);
        starts.Add(line);
        line = AppendDiagnosticSource(merged, mergedDiags, doc.Text, line);
        int ei = 0;
        while (ei < extFiles.Count) {
            names.Add("");
            starts.Add(line);
            line = AppendExternalSource(merged, extFiles[ei].Text, line);
            ei = ei + 1;
        }
        mergedDiags.SetFiles(names, starts);
        Parser resolver = new Parser(new List<Token>(), mergedDiags);
        resolver.ResolveWorkspace(merged);
        Binder binder = new Binder();
        binder.Bind(merged);
        Checker checker = new Checker(binder, mergedDiags);
        checker.CheckLsp(merged, true);
        diagnostics.items.Clear();
        int di = 0;
        while (di < mergedDiags.items.Count) {
            Diag d = mergedDiags.items[di];
            if (d.line > 0 && mergedDiags.FileOfLine(d.line) == doc.Uri) {
                diagnostics.Add(new Diag(d.msg, mergedDiags.LineInFile(d.line), d.col, d.warn));
            }
            di = di + 1;
        }
    }

    static void CheckDiagnostics(Node unit, Diags diagnostics) {
        Binder binder = new Binder();
        binder.Bind(unit);
        Checker checker = new Checker(binder, diagnostics);
        checker.CheckLsp(unit, false);
    }

    static void AddAffectedProject(List<string> roots, string root) {
        if (root == "") { return; }
        string key = PathKey(root);
        for (int i = 0; i < roots.Count; i = i + 1) {
            if (PathKey(roots[i]) == key) { return; }
        }
        roots.Add(root);
    }

    static void UpdateProjectRoots(List<string> roots) {
        for (int i = 0; i < documents.Count; i = i + 1) {
            LspDocument doc = documents[i];
            string root = ProjectOf(doc.FilePath);
            if (PathKey(root) != PathKey(doc.ProjectRoot)) {
                AddAffectedProject(roots, doc.ProjectRoot);
                AddAffectedProject(roots, root);
                doc.ProjectRoot = root;
            }
        }
    }

    // Document notifications and watched-file notifications share the same refresh path.
    static void RefreshWorkspaceDiagnostics(string previousRoot, LspDocument changed) {
        List<string> roots = new List<string>();
        AddAffectedProject(roots, previousRoot);
        UpdateProjectRoots(roots);
        if (changed == null) {
            for (int i = 0; i < documents.Count; i = i + 1) {
                AddAffectedProject(roots, documents[i].ProjectRoot);
            }
        } else {
            AddAffectedProject(roots, changed.ProjectRoot);
        }
        for (int i = 0; i < roots.Count; i = i + 1) { AnalyzeProject(roots[i]); }
    }

    static void PollWorkspaceManifests() {
        List<string> roots = new List<string>();
        UpdateProjectRoots(roots);
        List<string> projects = projectManifests.Keys;
        for (int i = 0; i < projects.Count; i = i + 1) {
            LspProjectManifests manifests = projectManifests[projects[i]];
            List<string> paths = manifests.Paths.Keys;
            for (int j = 0; j < paths.Count; j = j + 1) {
                string path = paths[j];
                if (File.Exists(path) != manifests.Paths[path]) {
                    AddAffectedProject(roots, manifests.Root);
                    break;
                }
            }
        }
        for (int i = 0; i < roots.Count; i = i + 1) { AnalyzeProject(roots[i]); }
    }

    static void AnalyzeProject(string root) {
        List<LspDocument> open = new List<LspDocument>();
        Dictionary<string, bool> overlays = new Dictionary<string, bool>();
        string key = PathKey(root);
        for (int i = 0; i < documents.Count; i = i + 1) {
            LspDocument doc = documents[i];
            if (PathKey(doc.ProjectRoot) == key) {
                open.Add(doc);
                overlays[PathKey(doc.FilePath)] = true;
            }
        }
        if (open.Count == 0) {
            projectManifests.Remove(key);
            projectDiskFiles.Remove(key);
            projectDiskSymbols.Remove(key);
            projectExternalSymbols.Remove(key);
            projectExternalFiles.Remove(key);
            return;
        }

        Node unit = new Node(AK.CompUnit());
        Diags diagnostics = new Diags();
        List<string> names = new List<string>();
        List<int> starts = new List<int>();
        List<string> usings = new List<string>();
        Dictionary<string, bool> seenUsing = new Dictionary<string, bool>();
        Dictionary<string, bool> loadedPaths = new Dictionary<string, bool>();
        int line = 1;
        for (int i = 0; i < open.Count; i = i + 1) {
            LspDocument doc = open[i];
            if (doc.FilePath != "") { loadedPaths[PathKey(doc.FilePath)] = true; }
            CollectUsingNamespaces(doc.Text, usings, seenUsing);
            names.Add(doc.Uri);
            starts.Add(line);
            line = AppendDiagnosticSource(unit, diagnostics, doc.Text, line);
        }
        List<string> paths = new List<string>();
        LspProjectManifests manifests = new LspProjectManifests();
        manifests.Root = root;
        AppendDiskSources(root, paths, manifests.Paths);
        projectManifests[key] = manifests;
        paths.Sort();
        List<LspDiskFile> diskFiles = new List<LspDiskFile>();
        List<LspSymbol> diskSyms = new List<LspSymbol>();
        for (int i = 0; i < paths.Count; i = i + 1) {
            string path = paths[i];
            #if WINDOWS
            path = path.Replace("\\", "/");
            #endif
            string pkey = PathKey(path);
            if (overlays.ContainsKey(pkey)) { continue; }
            loadedPaths[pkey] = true;
            string text;
            try {
                text = File.ReadAllText(path);
            } catch (IOException ex) {
                continue;
            }
            CollectUsingNamespaces(text, usings, seenUsing);
            string fileUri = PathToUri(path);
            diskFiles.Add(new LspDiskFile(fileUri, path, text));
            names.Add("");
            starts.Add(line);
            line = AppendDiagnosticSourceIndexed(unit, diagnostics, text, line, fileUri, diskSyms);
        }
        projectDiskFiles[key] = diskFiles;
        projectDiskSymbols[key] = diskSyms;

        // On-demand stdlib / packages declarations matching project `using` namespaces.
        List<LspExternalFileCache> extFiles = new List<LspExternalFileCache>();
        List<LspSymbol> extSyms = new List<LspSymbol>();
        CollectExternalForUsings(root, usings, loadedPaths, extFiles, extSyms);
        projectExternalFiles[key] = extFiles;
        projectExternalSymbols[key] = extSyms;
        for (int i = 0; i < extFiles.Count; i = i + 1) {
            names.Add("");
            starts.Add(line);
            line = AppendExternalSource(unit, extFiles[i].Text, line);
        }

        diagnostics.SetFiles(names, starts);
        Parser resolver = new Parser(new List<Token>(), diagnostics);
        resolver.ResolveWorkspace(unit);
        Binder binder = new Binder();
        binder.Bind(unit);
        Checker checker = new Checker(binder, diagnostics);
        checker.CheckLsp(unit, true);
        Dictionary<string, Diags> byUri = new Dictionary<string, Diags>();
        for (int i = 0; i < open.Count; i = i + 1) { byUri[open[i].Uri] = new Diags(); }
        for (int i = 0; i < diagnostics.items.Count; i = i + 1) {
            Diag d = diagnostics.items[i];
            if (d.line <= 0) { continue; }
            string uri = diagnostics.FileOfLine(d.line);
            if (uri != "") {
                byUri[uri].Add(new Diag(d.msg, diagnostics.LineInFile(d.line), d.col, d.warn));
            }
        }
        for (int i = 0; i < open.Count; i = i + 1) {
            LspDocument doc = open[i];
            PublishDiagnostics(doc.Uri, doc.Version, DiagArray(byUri[doc.Uri], doc.Text));
        }
    }

    static int AppendDiagnosticSource(Node unit, Diags diagnostics, string text, int line) {
        // Each source has an independent lexer/parser, but its positions live in the project unit.
        Lexer lexer = new Lexer(text);
        lexer.line = line;
        List<Token> tokens = lexer.Run();
        ReadLexerDiagnostics(lexer, diagnostics);
        Parser parser = new Parser(tokens, diagnostics);
        Node source = parser.ParseSourceDecls();
        for (int i = 0; i < source.kids.Count; i = i + 1) { unit.Add(source.kids[i]); }
        return lexer.line + 1;
    }

    static int AppendDiagnosticSourceIndexed(Node unit, Diags diagnostics, string text,
            int line, string fileUri, List<LspSymbol> dstSymbols) {
        Lexer lexer = new Lexer(text);
        lexer.line = line;
        List<Token> tokens = lexer.Run();
        ReadLexerDiagnostics(lexer, diagnostics);
        int lineOffset = line - 1;
        CollectTopLevelSymbolsInto(dstSymbols, fileUri, tokens, lineOffset);
        Parser parser = new Parser(tokens, diagnostics);
        Node source = parser.ParseSourceDecls();
        CollectMemberSymbolsInto(dstSymbols, fileUri, source, lineOffset);
        for (int i = 0; i < source.kids.Count; i = i + 1) { unit.Add(source.kids[i]); }
        return lexer.line + 1;
    }

    static string PathToUri(string path) {
        if (path == null || path == "") { return ""; }
        string p = path.Replace("\\", "/");
        if (p.Length >= 2 && p[1] == ':' && p[0] >= 'a' && p[0] <= 'z') {
            char upper = (char)((int)p[0] - 32);
            p = Convert.ToString(upper) + p.Substring(1);
        }
        string hex = "0123456789ABCDEF";
        StringBuilder sb = new StringBuilder();
        if (p.StartsWith("/")) { sb.Append("file://"); }
        else { sb.Append("file:///"); }
        int i = 0;
        while (i < p.Length) {
            int b = (int)p[i] & 255;
            bool safe = (b >= 'A' && b <= 'Z') || (b >= 'a' && b <= 'z')
                || (b >= '0' && b <= '9') || b == '-' || b == '_' || b == '.'
                || b == '~' || b == '/' || (b == ':' && i == 1);
            if (safe) {
                sb.Append(p[i]);
            } else {
                sb.Append('%');
                sb.Append(hex[(b >> 4) & 15]);
                sb.Append(hex[b & 15]);
            }
            i = i + 1;
        }
        return sb.ToString();
    }

    static bool DocInScope(LspDocument active, LspDocument candidate) {
        if (candidate == null) { return false; }
        if (active == null || active.ProjectRoot == "") {
            return candidate.ProjectRoot == "";
        }
        return PathKey(candidate.ProjectRoot) == PathKey(active.ProjectRoot);
    }

    static List<LspDiskFile> ProjectSourcesFor(LspDocument doc) {
        EnsureInit();
        List<LspDiskFile> result = new List<LspDiskFile>();
        int i = 0;
        while (i < documents.Count) {
            LspDocument d = documents[i];
            if (DocInScope(doc, d)) {
                result.Add(new LspDiskFile(d.Uri, d.FilePath, d.Text));
            }
            i = i + 1;
        }
        if (doc != null && doc.ProjectRoot != "") {
            string key = PathKey(doc.ProjectRoot);
            if (projectDiskFiles.ContainsKey(key)) {
                List<LspDiskFile> disk = projectDiskFiles[key];
                int j = 0;
                while (j < disk.Count) {
                    result.Add(disk[j]);
                    j = j + 1;
                }
            }
        }
        return result;
    }

    static List<LspSymbol> ProjectSymbolsFor(LspDocument doc) {
        EnsureInit();
        Dictionary<string, bool> allowedUris = new Dictionary<string, bool>();
        int i = 0;
        while (i < documents.Count) {
            LspDocument d = documents[i];
            if (DocInScope(doc, d)) { allowedUris[d.Uri] = true; }
            i = i + 1;
        }
        List<LspSymbol> result = new List<LspSymbol>();
        i = 0;
        while (i < symbols.Count) {
            LspSymbol s = symbols[i];
            if (allowedUris.ContainsKey(s.Uri)) { result.Add(s); }
            i = i + 1;
        }
        if (doc != null && doc.ProjectRoot != "") {
            string key = PathKey(doc.ProjectRoot);
            if (projectDiskSymbols.ContainsKey(key)) {
                List<LspSymbol> disk = projectDiskSymbols[key];
                int j = 0;
                while (j < disk.Count) {
                    result.Add(disk[j]);
                    j = j + 1;
                }
            }
            if (projectExternalSymbols.ContainsKey(key)) {
                List<LspSymbol> ext = projectExternalSymbols[key];
                int e = 0;
                while (e < ext.Count) {
                    result.Add(ext[e]);
                    e = e + 1;
                }
            }
        } else if (doc != null) {
            string extKey = StandaloneExternalKey(doc.Uri);
            if (projectExternalSymbols.ContainsKey(extKey)) {
                List<LspSymbol> ext = projectExternalSymbols[extKey];
                int e = 0;
                while (e < ext.Count) {
                    result.Add(ext[e]);
                    e = e + 1;
                }
            }
        }
        return result;
    }

    static string LookupSourceText(LspDocument doc, string targetUri) {
        LspDocument open = FindDocument(targetUri);
        if (open != null) { return open.Text; }
        if (doc != null && doc.ProjectRoot != "") {
            string key = PathKey(doc.ProjectRoot);
            if (projectDiskFiles.ContainsKey(key)) {
                List<LspDiskFile> disk = projectDiskFiles[key];
                int i = 0;
                while (i < disk.Count) {
                    if (disk[i].Uri == targetUri) { return disk[i].Text; }
                    i = i + 1;
                }
            }
            if (projectExternalFiles.ContainsKey(key)) {
                List<LspExternalFileCache> ext = projectExternalFiles[key];
                int i = 0;
                while (i < ext.Count) {
                    if (ext[i].Uri == targetUri) { return ext[i].Text; }
                    i = i + 1;
                }
            }
        }
        List<string> keys = projectDiskFiles.Keys;
        int k = 0;
        while (k < keys.Count) {
            List<LspDiskFile> disk = projectDiskFiles[keys[k]];
            int i = 0;
            while (i < disk.Count) {
                if (disk[i].Uri == targetUri) { return disk[i].Text; }
                i = i + 1;
            }
            k = k + 1;
        }
        List<string> ekeys = externalFileCache.Keys;
        int ek = 0;
        while (ek < ekeys.Count) {
            LspExternalFileCache ef = externalFileCache[ekeys[ek]];
            if (ef.Uri == targetUri) { return ef.Text; }
            ek = ek + 1;
        }
        return null;
    }

    static string NormalizePathSlashes(string p) {
        if (p == null || p == "") { return ""; }
        #if WINDOWS
        p = p.Replace("\\", "/");
        #endif
        while (p.Length > 1 && p.EndsWith("/") && !p.EndsWith(":/")) {
            p = p.Substring(0, p.Length - 1);
        }
        return p;
    }

    static string FindStdlibRoot() {
        string env = Environment.GetEnvironmentVariable("ZAN_STDLIB");
        if (env != null && env != "" && Directory.ExistsOnDisk(env)) {
            return NormalizePathSlashes(env);
        }
        if (workspaceRoot != null && workspaceRoot != "") {
            string ws = Path.Combine(workspaceRoot, "stdlib");
            if (Directory.ExistsOnDisk(ws)) { return NormalizePathSlashes(ws); }
        }
        string exe = Environment.ProcessPath;
        if (exe != null && exe != "") {
            string dir = Path.GetDirectoryName(exe);
            int up = 0;
            while (dir != null && dir != "" && up < 4) {
                string cand = Path.Combine(dir, "stdlib");
                if (Directory.ExistsOnDisk(cand)) { return NormalizePathSlashes(cand); }
                string parent = Path.GetDirectoryName(dir);
                if (parent == dir) { break; }
                dir = parent;
                up = up + 1;
            }
        }
        return "";
    }

    static void AddUniqueDir(List<string> dst, Dictionary<string, bool> seen, string dir) {
        if (dir == null || dir == "" || !Directory.ExistsOnDisk(dir)) { return; }
        string norm = NormalizePathSlashes(dir);
        string key = PathKey(norm);
        if (!seen.ContainsKey(key)) {
            seen[key] = true;
            dst.Add(norm);
        }
    }

    static List<string> FindPackageRoots(string projectRoot, string stdlibRoot) {
        List<string> roots = new List<string>();
        Dictionary<string, bool> seen = new Dictionary<string, bool>();
        string env = Environment.GetEnvironmentVariable("ZAN_PACKAGES");
        if (env != null && env != "") { AddUniqueDir(roots, seen, env); }
        if (projectRoot != null && projectRoot != "") {
            AddUniqueDir(roots, seen, Path.Combine(projectRoot, "packages"));
        }
        if (workspaceRoot != null && workspaceRoot != "") {
            AddUniqueDir(roots, seen, Path.Combine(workspaceRoot, "packages"));
        }
        if (stdlibRoot != null && stdlibRoot != "") {
            string repo = Path.GetDirectoryName(stdlibRoot);
            if (repo != null && repo != "") {
                AddUniqueDir(roots, seen, Path.Combine(repo, "packages"));
            }
        }
        return roots;
    }

    static void CollectUsingNamespaces(string text, List<string> dst, Dictionary<string, bool> seen) {
        if (text == null || text == "" || dst.Count >= 64) { return; }
        int i = 0;
        int n = text.Length;
        while (i < n && dst.Count < 64) {
            char c = text[i];
            if (c == '/' && i + 1 < n && text[i + 1] == '/') {
                while (i < n && text[i] != '\n') { i = i + 1; }
                continue;
            }
            if (c == '/' && i + 1 < n && text[i + 1] == '*') {
                i = i + 2;
                while (i + 1 < n && !(text[i] == '*' && text[i + 1] == '/')) { i = i + 1; }
                if (i + 1 < n) { i = i + 2; }
                continue;
            }
            if (c == '"' || c == '\'') {
                char q = c;
                i = i + 1;
                while (i < n && text[i] != q) {
                    if (text[i] == '\\' && i + 1 < n) { i = i + 1; }
                    i = i + 1;
                }
                if (i < n) { i = i + 1; }
                continue;
            }
            if (c == 'u' && i + 6 < n && text.Substring(i, 5) == "using"
                    && (i == 0 || !IsWordChar(text[i - 1]))
                    && !IsWordChar(text[i + 5])) {
                int p = i + 5;
                while (p < n && (text[p] == ' ' || text[p] == '\t')) { p = p + 1; }
                int nsStart = p;
                while (p < n && (IsWordChar(text[p]) || text[p] == '.')) { p = p + 1; }
                int nsEnd = p;
                while (p < n && (text[p] == ' ' || text[p] == '\t')) { p = p + 1; }
                if (p < n && text[p] == ';' && nsEnd > nsStart) {
                    string ns = text.Substring(nsStart, nsEnd - nsStart);
                    if (ns != "static" && !seen.ContainsKey(ns)) {
                        seen[ns] = true;
                        dst.Add(ns);
                    }
                    i = p + 1;
                    continue;
                }
            }
            i = i + 1;
        }
    }

    static void AddZanFilesInDir(string dir, List<string> outPaths, Dictionary<string, bool> seenPaths) {
        if (dir == null || dir == "" || !Directory.ExistsOnDisk(dir) || outPaths.Count >= 128) { return; }
        List<string> files;
        try {
            files = Directory.GetFiles(dir, "*.zan");
        } catch (IOException ex) {
            return;
        }
        files.Sort();
        int i = 0;
        while (i < files.Count && outPaths.Count < 128) {
            string p = NormalizePathSlashes(files[i]);
            string pk = PathKey(p);
            if (p.EndsWith(".zan") && !seenPaths.ContainsKey(pk) && !File.IsReparsePoint(p)) {
                seenPaths[pk] = true;
                outPaths.Add(p);
            }
            i = i + 1;
        }
    }

    static void CollectExternalFilesForNamespace(string ns, string stdlibRoot,
            List<string> pkgRoots, List<string> outPaths, Dictionary<string, bool> seenPaths) {
        if (ns == null || ns == "" || outPaths.Count >= 128) { return; }
        string nsRel = ns.Replace(".", "/");
        if (stdlibRoot != "") {
            string sdir = Path.Combine(stdlibRoot, nsRel);
            AddZanFilesInDir(sdir, outPaths, seenPaths);
            if (ns == "System") {
                AddZanFilesInDir(Path.Combine(sdir, "Exceptions"), outPaths, seenPaths);
            }
        }
        int pi = 0;
        while (pi < pkgRoots.Count && outPaths.Count < 128) {
            List<string> pkgDirs;
            try {
                pkgDirs = Directory.GetDirectoryPaths(pkgRoots[pi]);
            } catch (IOException ex) {
                pi = pi + 1;
                continue;
            }
            pkgDirs.Sort();
            int di = 0;
            while (di < pkgDirs.Count && outPaths.Count < 128) {
                string pkgDir = pkgDirs[di];
                string srcDir = Path.Combine(pkgDir, "src");
                if (Directory.ExistsOnDisk(srcDir)) {
                    AddZanFilesInDir(Path.Combine(srcDir, nsRel), outPaths, seenPaths);
                    if (PathKey(Path.GetFileName(pkgDir)) == PathKey(ns)) {
                        AddZanFilesInDir(srcDir, outPaths, seenPaths);
                    }
                }
                string stdDir = Path.Combine(pkgDir, "stdlib");
                if (Directory.ExistsOnDisk(stdDir)) {
                    AddZanFilesInDir(Path.Combine(stdDir, nsRel), outPaths, seenPaths);
                }
                di = di + 1;
            }
            pi = pi + 1;
        }
    }

    static LspExternalFileCache GetOrLoadExternalFile(string path) {
        string key = PathKey(path);
        if (externalFileCache.ContainsKey(key)) { return externalFileCache[key]; }
        string text;
        try {
            text = File.ReadAllText(path);
        } catch (IOException ex) {
            return null;
        }
        string uri = PathToUri(path);
        List<LspSymbol> syms = new List<LspSymbol>();
        Lexer lx = new Lexer(text);
        List<Token> toks = lx.Run();
        CollectTopLevelSymbolsInto(syms, uri, toks, 0);
        Diags ignored = new Diags();
        Parser ps = new Parser(toks, ignored);
        Node unit = ps.ParseSourceDecls();
        CollectMemberSymbolsInto(syms, uri, unit, 0);
        LspExternalFileCache entry = new LspExternalFileCache(uri, path, text, syms);
        externalFileCache[key] = entry;
        return entry;
    }

    static void CollectExternalForUsings(string projectRoot, List<string> usings,
            Dictionary<string, bool> skipPaths, List<LspExternalFileCache> outFiles,
            List<LspSymbol> outSyms) {
        if (usings.Count == 0) { return; }
        string stdlibRoot = FindStdlibRoot();
        List<string> pkgRoots = FindPackageRoots(projectRoot, stdlibRoot);
        if (stdlibRoot == "" && pkgRoots.Count == 0) { return; }
        List<string> extPaths = new List<string>();
        Dictionary<string, bool> seenPaths = new Dictionary<string, bool>();
        List<string> skipKeys = skipPaths.Keys;
        int sk = 0;
        while (sk < skipKeys.Count) {
            seenPaths[skipKeys[sk]] = true;
            sk = sk + 1;
        }
        int ui = 0;
        while (ui < usings.Count) {
            CollectExternalFilesForNamespace(usings[ui], stdlibRoot, pkgRoots, extPaths, seenPaths);
            ui = ui + 1;
        }
        int ei = 0;
        while (ei < extPaths.Count) {
            LspExternalFileCache entry = GetOrLoadExternalFile(extPaths[ei]);
            if (entry != null) {
                outFiles.Add(entry);
                int si = 0;
                while (si < entry.Symbols.Count) {
                    outSyms.Add(entry.Symbols[si]);
                    si = si + 1;
                }
            }
            ei = ei + 1;
        }
    }

    static void StripMethodBodies(Node node) {
        if (node == null) { return; }
        int i = 0;
        while (i < node.kids.Count) {
            Node k = node.kids[i];
            if (k.kind == AK.MethodDecl() || k.kind == AK.CtorDecl()) {
                // Keep empty block when a body existed so default interface methods stay non-abstract.
                if (k.d != null) { k.d = new Node(AK.Block()); }
            } else if (k.kind == AK.NamespaceDecl() || k.kind == AK.ClassDecl()
                    || k.kind == AK.StructDecl()) {
                StripMethodBodies(k);
            }
            i = i + 1;
        }
    }

    static int AppendExternalSource(Node unit, string text, int line) {
        Lexer lexer = new Lexer(text);
        lexer.line = line;
        List<Token> tokens = lexer.Run();
        Diags ignored = new Diags();
        Parser parser = new Parser(tokens, ignored);
        Node source = parser.ParseSourceDecls();
        StripMethodBodies(source);
        for (int i = 0; i < source.kids.Count; i = i + 1) { unit.Add(source.kids[i]); }
        return lexer.line + 1;
    }

    static string ShortTypeName(string raw) {
        if (raw == null || raw == "") { return ""; }
        string s = raw;
        int lt = s.IndexOf("<");
        if (lt >= 0) { s = s.Substring(0, lt); }
        int lb = s.IndexOf("[");
        if (lb >= 0) { s = s.Substring(0, lb); }
        int dot = -1;
        int i = s.Length - 1;
        while (i >= 0) {
            if (s[i] == '.') { dot = i; break; }
            i = i - 1;
        }
        if (dot >= 0 && dot + 1 < s.Length) {
            s = s.Substring(dot + 1, s.Length - dot - 1);
        }
        return s;
    }

    static void AttachTypeMetaInto(List<LspSymbol> dst, string uri, Node d,
            string owner, string parentType, int lineOffset) {
        if (owner == "") { return; }
        int wantLine = d.line - lineOffset;
        LspSymbol target = null;
        int bestDist = 1000000;
        int i = dst.Count - 1;
        while (i >= 0) {
            LspSymbol s = dst[i];
            if (s.Uri == uri && IsTypeSymbolKind(s.Kind) && s.Name == owner) {
                int dist = s.Line - wantLine;
                if (dist < 0) { dist = -dist; }
                if (dist < bestDist) {
                    bestDist = dist;
                    target = s;
                }
            }
            i = i - 1;
        }
        if (target == null) { return; }
        if (parentType != "" && target.ContainerName == "") {
            target.ContainerName = parentType;
        }
        if (d.sval2 != null && d.sval2 != "") {
            string b = ShortTypeName(d.sval2);
            if (b != "" && !target.BaseTypes.Contains(b)) { target.BaseTypes.Add(b); }
        }
        if (d.interfaces != null) {
            int k = 0;
            while (k < d.interfaces.Count) {
                string itf = ShortTypeName(d.interfaces[k]);
                if (itf != "" && !target.BaseTypes.Contains(itf)) { target.BaseTypes.Add(itf); }
                k = k + 1;
            }
        }
    }

    static List<string> TypeAncestors(List<LspSymbol> pool, string typeName) {
        List<string> chain = new List<string>();
        string start = ShortTypeName(typeName);
        if (start == "") { return chain; }
        Dictionary<string, bool> visited = new Dictionary<string, bool>();
        visited[start] = true;
        chain.Add(start);
        int head = 0;
        while (head < chain.Count) {
            string cur = chain[head];
            head = head + 1;
            int i = 0;
            while (i < pool.Count) {
                LspSymbol s = pool[i];
                if (IsTypeSymbolKind(s.Kind) && s.Name == cur) {
                    int bi = 0;
                    while (bi < s.BaseTypes.Count) {
                        string b = s.BaseTypes[bi];
                        if (b != "" && !visited.ContainsKey(b)) {
                            visited[b] = true;
                            chain.Add(b);
                        }
                        bi = bi + 1;
                    }
                }
                i = i + 1;
            }
        }
        return chain;
    }

    static bool TypeDeclaresMember(List<LspSymbol> pool, string typeName,
            string memberName, int kind, int arity) {
        int i = 0;
        while (i < pool.Count) {
            LspSymbol s = pool[i];
            if (s.ContainerName == typeName && s.Name == memberName && s.Kind == kind) {
                if (kind != LspSymbol.KindMethod() || arity < 0 || s.ParamNames.Count == arity) {
                    return true;
                }
            }
            i = i + 1;
        }
        return false;
    }

    static Dictionary<string, bool> MemberOwnerFamily(List<LspSymbol> pool, LspSymbol target) {
        Dictionary<string, bool> fam = new Dictionary<string, bool>();
        if (target == null || target.ContainerName == "") { return fam; }
        string owner = ShortTypeName(target.ContainerName);
        int arity = target.Kind == LspSymbol.KindMethod() ? target.ParamNames.Count : -1;
        // Walk up to the root ancestor(s) declaring this same member slot.
        List<string> anc = TypeAncestors(pool, owner);
        List<string> roots = new List<string>();
        int ai = anc.Count - 1;
        while (ai >= 0) {
            if (TypeDeclaresMember(pool, anc[ai], target.Name, target.Kind, arity)) {
                roots.Add(anc[ai]);
            }
            ai = ai - 1;
        }
        if (roots.Count == 0) { roots.Add(owner); }
        int ri = 0;
        while (ri < roots.Count) {
            fam[roots[ri]] = true;
            ri = ri + 1;
        }
        fam[owner] = true;
        // Include every type in pool that derives from any root (for overrides + polymorphic calls).
        int i = 0;
        while (i < pool.Count) {
            LspSymbol s = pool[i];
            if (IsTypeSymbolKind(s.Kind) && !fam.ContainsKey(s.Name)) {
                List<string> chain = TypeAncestors(pool, s.Name);
                int ci = 0;
                while (ci < chain.Count) {
                    if (roots.Contains(chain[ci])) {
                        fam[s.Name] = true;
                        break;
                    }
                    ci = ci + 1;
                }
            }
            i = i + 1;
        }
        return fam;
    }

    static int CallArgCountAfterWord(string text, int line0, int byteCol0) {
        if (text == null) { return -1; }
        int ls = LineStartOf(text, line0);
        if (ls < 0) { return -1; }
        int ws = WordStartAt(text, line0, byteCol0);
        if (ws < 0) { return -1; }
        int p = ls + ws;
        while (p < text.Length && text[p] != '\n' && IsWordChar(text[p])) { p = p + 1; }
        while (p < text.Length && (text[p] == ' ' || text[p] == '\t')) { p = p + 1; }
        if (p < text.Length && text[p] == '(') { return CountCallArgs(text, p); }
        return -1;
    }

    static string EnclosingTypeInText(string text, int line0) {
        if (text == null || text == "") { return ""; }
        Lexer lx = new Lexer(text);
        List<Token> toks = lx.Run();
        List<string> typeStack = new List<string>();
        List<int> depthStack = new List<int>();
        int depth = 0;
        string pending = "";
        int i = 0;
        while (i < toks.Count) {
            Token t = toks[i];
            if (t.line - 1 > line0) { break; }
            if (t.kind == TK.Class() || t.kind == TK.Interface()
                    || t.kind == TK.Struct() || t.kind == TK.Enum()) {
                if (i + 1 < toks.Count && toks[i + 1].kind == TK.Ident()) {
                    pending = toks[i + 1].text;
                }
            } else if (t.kind == TK.Semicolon()) {
                pending = "";
            } else if (t.kind == TK.LBrace()) {
                depth = depth + 1;
                if (pending != "") {
                    typeStack.Add(pending);
                    depthStack.Add(depth);
                    pending = "";
                }
            } else if (t.kind == TK.RBrace()) {
                if (depthStack.Count > 0 && depthStack[depthStack.Count - 1] == depth) {
                    typeStack.RemoveAt(typeStack.Count - 1);
                    depthStack.RemoveAt(depthStack.Count - 1);
                }
                if (depth > 0) { depth = depth - 1; }
            }
            i = i + 1;
        }
        return typeStack.Count > 0 ? typeStack[typeStack.Count - 1] : "";
    }

    static LspSymbol FindSymbolFor(LspDocument doc, string name, string receiverType) {
        return FindSymbolForEx(doc, name, receiverType, -1);
    }

    static LspSymbol FindSymbolForEx(LspDocument doc, string name,
            string receiverType, int callArgCount) {
        List<LspSymbol> pool = ProjectSymbolsFor(doc);
        if (receiverType != "") {
            List<string> chain = TypeAncestors(pool, receiverType);
            if (callArgCount >= 0) {
                int ci = 0;
                while (ci < chain.Count) {
                    int i = 0;
                    while (i < pool.Count) {
                        LspSymbol s = pool[i];
                        if (s.Name == name && s.ContainerName == chain[ci]
                                && s.Kind != LspSymbol.KindCtor()
                                && s.ParamNames.Count == callArgCount) {
                            return s;
                        }
                        i = i + 1;
                    }
                    ci = ci + 1;
                }
            }
            int ci2 = 0;
            while (ci2 < chain.Count) {
                int i = 0;
                while (i < pool.Count) {
                    LspSymbol s = pool[i];
                    if (s.Name == name && s.ContainerName == chain[ci2]
                            && s.Kind != LspSymbol.KindCtor()) {
                        return s;
                    }
                    i = i + 1;
                }
                ci2 = ci2 + 1;
            }
            // Receiver resolved to a known type in the project; do not leak an unrelated class member.
            int ti = 0;
            while (ti < pool.Count) {
                if (IsTypeSymbolKind(pool[ti].Kind) && pool[ti].Name == ShortTypeName(receiverType)) {
                    return null;
                }
                ti = ti + 1;
            }
        }
        if (callArgCount >= 0) {
            int j0 = 0;
            while (j0 < pool.Count) {
                LspSymbol s = pool[j0];
                if (s.Name == name && s.Kind != LspSymbol.KindCtor()
                        && s.ParamNames.Count == callArgCount) {
                    return s;
                }
                j0 = j0 + 1;
            }
        }
        int j = 0;
        while (j < pool.Count) {
            LspSymbol s = pool[j];
            if (s.Name == name && s.Kind != LspSymbol.KindCtor()) { return s; }
            j = j + 1;
        }
        int k = 0;
        while (k < pool.Count) {
            if (pool[k].Name == name) { return pool[k]; }
            k = k + 1;
        }
        return null;
    }

    static LspSymbol ResolveSymbolAtPosition(LspDocument doc, int line0, int byteCol0, string word) {
        if (doc == null || word == null || word == "") { return null; }
        List<LspSymbol> pool = ProjectSymbolsFor(doc);
        // 1. Exact declaration hit in current document (handles cursor directly on overload/member header).
        LspSymbol declHit = null;
        int bestDist = 1000000;
        int i = 0;
        while (i < pool.Count) {
            LspSymbol s = pool[i];
            if (s.Uri == doc.Uri && s.Name == word && s.Line == line0 + 1) {
                int dist = s.Col - 1 - byteCol0;
                if (dist < 0) { dist = -dist; }
                if (dist <= word.Length + 1 && dist < bestDist) {
                    bestDist = dist;
                    declHit = s;
                }
            }
            i = i + 1;
        }
        if (declHit != null) { return declHit; }

        int callArgCount = CallArgCountAfterWord(doc.Text, line0, byteCol0);
        string dotRecv = DotReceiverForWord(doc.Text, line0, byteCol0);
        if (dotRecv != "") {
            string recvType = ResolveReceiverType(doc, dotRecv, line0);
            return FindSymbolForEx(doc, word, recvType, callArgCount);
        }
        // 2. Unqualified member inside enclosing class/ancestors (unless word is a top-level type name).
        string enc = EnclosingTypeInText(doc.Text, line0);
        if (enc != "") {
            LspSymbol encHit = FindSymbolForEx(doc, word, enc, callArgCount);
            if (encHit != null) { return encHit; }
        }
        return FindSymbolForEx(doc, word, "", callArgCount);
    }

    static int CountCallArgs(string text, int openParen) {
        if (text == null || openParen < 0 || openParen >= text.Length || text[openParen] != '(') {
            return 0;
        }
        int i = openParen + 1;
        int n = text.Length;
        while (i < n && (text[i] == ' ' || text[i] == '\t' || text[i] == '\r' || text[i] == '\n')) {
            i = i + 1;
        }
        if (i >= n || text[i] == ')') { return 0; }
        int count = 1;
        int depth = 1;
        while (i < n && depth > 0) {
            char ch = text[i];
            if (ch == '"' || ch == '\'') {
                char q = ch;
                i = i + 1;
                while (i < n && text[i] != q) {
                    if (text[i] == '\\' && i + 1 < n) { i = i + 1; }
                    i = i + 1;
                }
                if (i < n) { i = i + 1; }
                continue;
            }
            if (ch == '(' || ch == '[' || ch == '{') { depth = depth + 1; }
            else if (ch == ')' || ch == ']' || ch == '}') { depth = depth - 1; }
            else if (ch == ',' && depth == 1) { count = count + 1; }
            i = i + 1;
        }
        return count;
    }

    static LspSymbol FindCallableSymbol(List<LspSymbol> pool, string name,
            string receiverType, int argCount) {
        if (receiverType != "") {
            List<string> chain = TypeAncestors(pool, receiverType);
            LspSymbol fallbackGe = null;
            LspSymbol fallbackAnyRecv = null;
            int ci = 0;
            while (ci < chain.Count) {
                string ownerName = chain[ci];
                int i = 0;
                while (i < pool.Count) {
                    LspSymbol s = pool[i];
                    bool isCall = s.Kind == LspSymbol.KindMethod() || s.Kind == LspSymbol.KindDelegate();
                    if (isCall && s.Name == name && s.ContainerName == ownerName
                            && s.ParamNames.Count > 0) {
                        if (argCount > 0 && s.ParamNames.Count == argCount) { return s; }
                        if (argCount > 0 && s.ParamNames.Count >= argCount && fallbackGe == null) {
                            fallbackGe = s;
                        }
                        if (fallbackAnyRecv == null) { fallbackAnyRecv = s; }
                    }
                    i = i + 1;
                }
                ci = ci + 1;
            }
            if (fallbackGe != null) { return fallbackGe; }
            if (fallbackAnyRecv != null) { return fallbackAnyRecv; }
        }
        LspSymbol fallbackAny = null;
        LspSymbol fallbackGeAny = null;
        LspSymbol exactAny = null;
        int j = 0;
        while (j < pool.Count) {
            LspSymbol s = pool[j];
            bool isCall = s.Kind == LspSymbol.KindMethod() || s.Kind == LspSymbol.KindCtor()
                || s.Kind == LspSymbol.KindDelegate();
            if (isCall && s.Name == name && s.ParamNames.Count > 0) {
                if (argCount > 0 && s.ParamNames.Count == argCount && exactAny == null) {
                    exactAny = s;
                }
                if (argCount > 0 && s.ParamNames.Count >= argCount && fallbackGeAny == null) {
                    fallbackGeAny = s;
                }
                if (fallbackAny == null) { fallbackAny = s; }
            }
            j = j + 1;
        }
        if (exactAny != null) { return exactAny; }
        if (fallbackGeAny != null) { return fallbackGeAny; }
        return fallbackAny;
    }

    static string DotReceiverBeforeOffset(string text, int offset) {
        if (text == null || offset <= 0 || offset > text.Length) { return ""; }
        int p = offset - 1;
        while (p >= 0 && (text[p] == ' ' || text[p] == '\t')) { p = p - 1; }
        if (p < 0 || text[p] != '.') { return ""; }
        p = p - 1;
        while (p >= 0 && (text[p] == ' ' || text[p] == '\t')) { p = p - 1; }
        if (p < 0 || !IsWordChar(text[p])) { return ""; }
        int end = p + 1;
        while (p >= 0 && IsWordChar(text[p])) { p = p - 1; }
        return text.Substring(p + 1, end - p - 1);
    }

    static string DotReceiverForWord(string text, int line0, int byteCol0) {
        if (text == null) { return ""; }
        int ls = LineStartOf(text, line0);
        if (ls < 0) { return ""; }
        int ws = WordStartAt(text, line0, byteCol0);
        return DotReceiverBeforeOffset(text, ls + ws);
    }

    static string DotReceiverBeforeCompletion(string text, int line0, int byteCol0) {
        if (text == null || byteCol0 <= 0) { return ""; }
        int ls = LineStartOf(text, line0);
        if (ls < 0) { return ""; }
        int cur = ls + byteCol0;
        if (cur > text.Length) { cur = text.Length; }
        while (cur > ls && IsWordChar(text[cur - 1])) { cur = cur - 1; }
        return DotReceiverBeforeOffset(text, cur);
    }

    static bool IsTypeSymbolKind(int kind) {
        return kind == LspSymbol.KindClass() || kind == LspSymbol.KindInterface()
            || kind == LspSymbol.KindStruct() || kind == LspSymbol.KindEnum();
    }

    static string ResolveReceiverType(LspDocument doc, string receiverName, int line0) {
        if (doc == null || receiverName == null || receiverName == "") { return ""; }
        List<LspSymbol> pool = ProjectSymbolsFor(doc);
        Lexer lx = new Lexer(doc.Text);
        List<Token> toks = lx.Run();
        return ResolveReceiverTypeInTokens(pool, toks, doc.Text, receiverName, line0, "");
    }

    static string ResolveReceiverTypeInTokens(List<LspSymbol> pool, List<Token> toks,
            string text, string receiverName, int line0, string enclosingHint) {
        if (receiverName == null || receiverName == "") { return ""; }
        if (receiverName == "this") {
            return enclosingHint != "" ? enclosingHint : EnclosingTypeInText(text, line0);
        }
        if (receiverName == "base") {
            string enc = enclosingHint != "" ? enclosingHint : EnclosingTypeInText(text, line0);
            if (enc != "") {
                List<string> chain = TypeAncestors(pool, enc);
                if (chain.Count > 1) { return chain[1]; }
            }
            return "";
        }
        int ti = 0;
        while (ti < pool.Count) {
            LspSymbol s = pool[ti];
            if (IsTypeSymbolKind(s.Kind) && s.Name == receiverName) {
                return s.Name;
            }
            ti = ti + 1;
        }
        // Scan file tokens for `TypeName receiverName` or `var receiverName = new TypeName(...)`.
        string found = "";
        int i2 = 0;
        while (i2 < toks.Count) {
            if (toks[i2].kind == TK.Ident() && toks[i2].text == receiverName) {
                if (i2 > 0 && toks[i2 - 1].kind == TK.Var()) {
                    if (i2 + 3 < toks.Count && toks[i2 + 1].kind == TK.Eq()
                            && toks[i2 + 2].kind == TK.New()
                            && toks[i2 + 3].kind == TK.Ident()) {
                        int nt = i2 + 3;
                        while (nt + 2 < toks.Count && toks[nt + 1].kind == TK.Dot()
                                && toks[nt + 2].kind == TK.Ident()) {
                            nt = nt + 2;
                        }
                        found = toks[nt].text;
                    }
                } else if (i2 > 0) {
                    int prev = i2 - 1;
                    // Skip array/generic suffix such as `Service[]` or `List<Service>`.
                    if (toks[prev].kind == TK.RBracket()) {
                        while (prev > 0 && toks[prev].kind != TK.LBracket()) { prev = prev - 1; }
                        if (prev > 0) { prev = prev - 1; }
                    }
                    if (prev >= 0 && toks[prev].kind == TK.Greater()) {
                        int depth = 1;
                        prev = prev - 1;
                        while (prev > 0 && depth > 0) {
                            if (toks[prev].kind == TK.Greater()) { depth = depth + 1; }
                            else if (toks[prev].kind == TK.Less()) { depth = depth - 1; }
                            prev = prev - 1;
                        }
                    }
                    if (prev >= 0 && toks[prev].kind == TK.Ident()
                            && !IsKeywordWord(toks[prev].text)) {
                        string candidate = toks[prev].text;
                        if (toks[i2].line - 1 <= line0 || found == "") {
                            found = candidate;
                        }
                    }
                }
            }
            i2 = i2 + 1;
        }
        if (found != "") { return ShortTypeName(found); }
        // Fallback: field with matching name in enclosing hierarchy first, then project.
        string encOwner = enclosingHint != "" ? enclosingHint : EnclosingTypeInText(text, line0);
        if (encOwner != "") {
            List<string> chain = TypeAncestors(pool, encOwner);
            int ci = 0;
            while (ci < chain.Count) {
                int fi = 0;
                while (fi < pool.Count) {
                    LspSymbol s = pool[fi];
                    if (s.Kind == LspSymbol.KindField() && s.ContainerName == chain[ci]
                            && s.Name == receiverName && s.TypeName != "") {
                        return ShortTypeName(s.TypeName);
                    }
                    fi = fi + 1;
                }
                ci = ci + 1;
            }
        }
        int fi2 = 0;
        while (fi2 < pool.Count) {
            LspSymbol s = pool[fi2];
            if (s.Kind == LspSymbol.KindField() && s.Name == receiverName && s.TypeName != "") {
                return ShortTypeName(s.TypeName);
            }
            fi2 = fi2 + 1;
        }
        return "";
    }

    static int CountCallArgsTokens(List<Token> toks, int openIdx) {
        if (openIdx < 0 || openIdx >= toks.Count || toks[openIdx].kind != TK.LParen()) { return -1; }
        if (openIdx + 1 < toks.Count && toks[openIdx + 1].kind == TK.RParen()) { return 0; }
        int count = 1;
        int depth = 1;
        int i = openIdx + 1;
        while (i < toks.Count && depth > 0) {
            int k = toks[i].kind;
            if (k == TK.LParen() || k == TK.LBracket() || k == TK.LBrace()) { depth = depth + 1; }
            else if (k == TK.RParen() || k == TK.RBracket() || k == TK.RBrace()) { depth = depth - 1; }
            else if (k == TK.Comma() && depth == 1) { count = count + 1; }
            i = i + 1;
        }
        return count;
    }

    static int CountDeclParamsTokens(List<Token> toks, int openIdx) {
        if (openIdx < 0 || openIdx >= toks.Count || toks[openIdx].kind != TK.LParen()) { return -1; }
        if (openIdx + 1 < toks.Count && toks[openIdx + 1].kind == TK.RParen()) { return 0; }
        int count = 1;
        int depth = 1;
        int angle = 0;
        int i = openIdx + 1;
        while (i < toks.Count && depth > 0) {
            int k = toks[i].kind;
            if (k == TK.LParen() || k == TK.LBracket() || k == TK.LBrace()) { depth = depth + 1; }
            else if (k == TK.RParen() || k == TK.RBracket() || k == TK.RBrace()) { depth = depth - 1; }
            else if (k == TK.Less()) { angle = angle + 1; }
            else if (k == TK.Greater() && angle > 0) { angle = angle - 1; }
            else if (k == TK.Comma() && depth == 1 && angle == 0) { count = count + 1; }
            i = i + 1;
        }
        return count;
    }

    static List<LspPos> FindSemanticFileHits(LspDocument activeDoc, LspDiskFile file,
            LspSymbol targetSym, string word) {
        List<LspPos> outp = new List<LspPos>();
        if (file == null || file.Text == null || word == null || word == "") { return outp; }
        List<LspSymbol> pool = ProjectSymbolsFor(activeDoc);
        bool isMemberTarget = targetSym != null && IsMemberKind(targetSym.Kind)
            && targetSym.Kind != LspSymbol.KindCtor();
        bool isMethodTarget = targetSym != null && targetSym.Kind == LspSymbol.KindMethod();
        int targetArity = isMethodTarget ? targetSym.ParamNames.Count : -1;
        Dictionary<string, bool> family = isMemberTarget
            ? MemberOwnerFamily(pool, targetSym)
            : new Dictionary<string, bool>();

        Lexer lx = new Lexer(file.Text);
        List<Token> toks = lx.Run();
        List<string> typeStack = new List<string>();
        List<int> depthStack = new List<int>();
        int braceDepth = 0;
        string pendingType = "";

        int i = 0;
        while (i < toks.Count) {
            Token t = toks[i];
            if (t.kind == TK.Class() || t.kind == TK.Interface()
                    || t.kind == TK.Struct() || t.kind == TK.Enum()) {
                if (i + 1 < toks.Count && toks[i + 1].kind == TK.Ident()) {
                    pendingType = toks[i + 1].text;
                }
            } else if (t.kind == TK.Semicolon()) {
                pendingType = "";
            } else if (t.kind == TK.LBrace()) {
                braceDepth = braceDepth + 1;
                if (pendingType != "") {
                    typeStack.Add(pendingType);
                    depthStack.Add(braceDepth);
                    pendingType = "";
                }
            } else if (t.kind == TK.RBrace()) {
                if (depthStack.Count > 0 && depthStack[depthStack.Count - 1] == braceDepth) {
                    typeStack.RemoveAt(typeStack.Count - 1);
                    depthStack.RemoveAt(depthStack.Count - 1);
                }
                if (braceDepth > 0) { braceDepth = braceDepth - 1; }
            }

            if (t.kind == TK.Ident() && t.text == word) {
                string encType = typeStack.Count > 0 ? typeStack[typeStack.Count - 1] : "";
                int memberDepth = depthStack.Count > 0 ? depthStack[depthStack.Count - 1] : -1;
                bool afterDot = i > 0 && toks[i - 1].kind == TK.Dot();
                bool followedByParen = i + 1 < toks.Count && toks[i + 1].kind == TK.LParen();
                bool keep = true;

                if (isMemberTarget) {
                    if (afterDot) {
                        string recv = "";
                        if (i >= 2) {
                            if (toks[i - 2].kind == TK.This()) { recv = "this"; }
                            else if (toks[i - 2].kind == TK.Base()) { recv = "base"; }
                            else if (toks[i - 2].kind == TK.Ident()) { recv = toks[i - 2].text; }
                        }
                        string rType = recv != ""
                            ? ResolveReceiverTypeInTokens(pool, toks, file.Text, recv, t.line - 1, encType)
                            : "";
                        if (rType == "" || !family.ContainsKey(rType)) { keep = false; }
                    } else {
                        if (encType == "" || !family.ContainsKey(encType)) { keep = false; }
                    }
                    if (keep && isMethodTarget) {
                        if (followedByParen) {
                            int arity = (!afterDot && braceDepth == memberDepth)
                                ? CountDeclParamsTokens(toks, i + 1)
                                : CountCallArgsTokens(toks, i + 1);
                            if (arity != targetArity) { keep = false; }
                        } else if (!afterDot && braceDepth == memberDepth) {
                            // Field or type-level declaration with the same name, not a method.
                            keep = false;
                        }
                    }
                } else if (targetSym != null && (IsTypeSymbolKind(targetSym.Kind)
                        || targetSym.Kind == LspSymbol.KindCtor()
                        || targetSym.Kind == LspSymbol.KindDelegate())) {
                    // Exclude member access on a typed variable/field (keep `Namespace.TypeName`).
                    if (afterDot && i >= 2) {
                        if (toks[i - 2].kind == TK.This() || toks[i - 2].kind == TK.Base()) {
                            keep = false;
                        } else if (toks[i - 2].kind == TK.Ident()) {
                            string rType = ResolveReceiverTypeInTokens(
                                pool, toks, file.Text, toks[i - 2].text, t.line - 1, encType);
                            if (rType != "") { keep = false; }
                        }
                    }
                } else {
                    // Unresolved identifier or local variable: skip dot-member access on known receivers.
                    if (afterDot && i >= 2 && (toks[i - 2].kind == TK.This()
                            || toks[i - 2].kind == TK.Base())) {
                        keep = false;
                    }
                }

                if (keep) {
                    outp.Add(new LspPos(t.line - 1, t.col - 1));
                }
            }
            i = i + 1;
        }
        return outp;
    }

    static string FormatSignatureLabel(LspSymbol sym) {
        StringBuilder sb = new StringBuilder();
        if (sym.Kind != LspSymbol.KindCtor() && sym.TypeName != "") {
            sb.Append(sym.TypeName);
            sb.Append(' ');
        }
        sb.Append(sym.Name);
        sb.Append('(');
        int i = 0;
        while (i < sym.ParamNames.Count) {
            if (i > 0) { sb.Append(", "); }
            string pt = i < sym.ParamTypes.Count ? sym.ParamTypes[i] : "";
            if (pt != "") {
                sb.Append(pt);
                sb.Append(' ');
            }
            sb.Append(sym.ParamNames[i]);
            i = i + 1;
        }
        sb.Append(')');
        return sb.ToString();
    }

    static string SymbolDetail(LspSymbol sym) {
        if (sym.Kind == LspSymbol.KindMethod() || sym.Kind == LspSymbol.KindCtor()
                || sym.Kind == LspSymbol.KindDelegate()) {
            return FormatSignatureLabel(sym);
        }
        if (sym.Kind == LspSymbol.KindField() && sym.TypeName != "") {
            return sym.TypeName + " (" + sym.KindText() + ")";
        }
        if (sym.ContainerName != "") {
            return sym.KindText() + " in " + sym.ContainerName;
        }
        return sym.KindText();
    }

    static string FormatHoverMarkdown(LspSymbol sym) {
        StringBuilder sb = new StringBuilder();
        sb.Append('`');
        if (sym.Kind == LspSymbol.KindMethod() || sym.Kind == LspSymbol.KindCtor()
                || sym.Kind == LspSymbol.KindDelegate()) {
            sb.Append(FormatSignatureLabel(sym));
        } else {
            sb.Append(sym.Name);
        }
        sb.Append("` — ");
        sb.Append(sym.KindText());
        if (sym.Kind == LspSymbol.KindField() && sym.TypeName != "") {
            sb.Append(" (`");
            sb.Append(sym.TypeName);
            sb.Append("`)");
        }
        if (sym.ContainerName != "") {
            sb.Append(" in `");
            sb.Append(sym.ContainerName);
            sb.Append('`');
        }
        sb.Append("\n\ndeclared at ");
        sb.Append(sym.Uri);
        sb.Append(':');
        sb.Append(sym.Line);
        return sb.ToString();
    }

    static void HandleWorkspaceSymbol(string id, string pms) {
        EnsureInit();
        string query = ExtractJsonField(pms, "query").ToLower();
        List<LspSymbol> candidates = new List<LspSymbol>();
        int i = 0;
        while (i < symbols.Count) {
            candidates.Add(symbols[i]);
            i = i + 1;
        }
        List<string> pkeys = projectDiskSymbols.Keys;
        int pk = 0;
        while (pk < pkeys.Count) {
            List<LspSymbol> dsyms = projectDiskSymbols[pkeys[pk]];
            int j = 0;
            while (j < dsyms.Count) {
                candidates.Add(dsyms[j]);
                j = j + 1;
            }
            pk = pk + 1;
        }
        if (pkeys.Count == 0 && workspaceRoot != null && workspaceRoot != "") {
            Dictionary<string, bool> overlays = new Dictionary<string, bool>();
            int oi = 0;
            while (oi < documents.Count) {
                if (documents[oi].FilePath != "") {
                    overlays[PathKey(documents[oi].FilePath)] = true;
                }
                oi = oi + 1;
            }
            List<string> paths = new List<string>();
            Dictionary<string, bool> ignoredManifests = new Dictionary<string, bool>();
            AppendDiskSources(workspaceRoot, paths, ignoredManifests);
            paths.Sort();
            int pi = 0;
            while (pi < paths.Count) {
                string path = paths[pi];
                #if WINDOWS
                path = path.Replace("\\", "/");
                #endif
                if (!overlays.ContainsKey(PathKey(path))) {
                    try {
                        string text = File.ReadAllText(path);
                        string furi = PathToUri(path);
                        Lexer lx = new Lexer(text);
                        List<Token> toks = lx.Run();
                        CollectTopLevelSymbolsInto(candidates, furi, toks, 0);
                        Diags dg = new Diags();
                        Parser ps = new Parser(toks, dg);
                        Node unit = ps.ParseSourceDecls();
                        CollectMemberSymbolsInto(candidates, furi, unit, 0);
                    } catch (IOException ex) {
                    }
                }
                pi = pi + 1;
            }
        }

        StringBuilder sb = new StringBuilder();
        sb.Append("{\"jsonrpc\":\"2.0\",\"id\":");
        sb.Append(id);
        sb.Append(",\"result\":[");
        int emitted = 0;
        int ci = 0;
        while (ci < candidates.Count && emitted < 256) {
            LspSymbol sym = candidates[ci];
            ci = ci + 1;
            if (sym.Name == null || sym.Name == "") { continue; }
            if (query != "" && !sym.Name.ToLower().Contains(query)) { continue; }
            string ttext = LookupSourceText(null, sym.Uri);
            int line0 = sym.Line - 1;
            if (line0 < 0) { line0 = 0; }
            int col0 = sym.Col - 1;
            if (col0 < 0) { col0 = 0; }
            int u16s = SymColOf(ttext, line0, col0);
            int u16e = ttext != null
                ? Utf16ColOf(ttext, line0, col0 + sym.Name.Length)
                : u16s + sym.Name.Length;
            if (emitted > 0) { sb.Append(','); }
            emitted = emitted + 1;
            sb.Append("{\"name\":");
            sb.Append(EncodeJsonString(sym.Name));
            sb.Append(",\"kind\":");
            sb.Append(sym.SymbolKind());
            if (sym.ContainerName != "") {
                sb.Append(",\"containerName\":");
                sb.Append(EncodeJsonString(sym.ContainerName));
            }
            sb.Append(",\"location\":{\"uri\":");
            sb.Append(EncodeJsonString(sym.Uri));
            sb.Append(",\"range\":{\"start\":");
            sb.Append(PosJson(line0, u16s));
            sb.Append(",\"end\":");
            sb.Append(PosJson(line0, u16e));
            sb.Append("}}}");
        }
        sb.Append("]}");
        SendResponse(sb.ToString());
    }

    static bool IsControlCallKeyword(string w) {
        return w == "if" || w == "while" || w == "for" || w == "foreach"
            || w == "switch" || w == "catch" || w == "return" || w == "sizeof"
            || w == "typeof";
    }

    static void HandleSignatureHelp(string id, string pms) {
        string td = ExtractJsonContainer(pms, "textDocument");
        string uri = ExtractJsonField(td, "uri");
        string pos = ExtractJsonContainer(pms, "position");
        int line = ExtractJsonInt(pos, "line", 0);
        int character = ExtractJsonInt(pos, "character", 0);
        LspDocument doc = FindDocument(uri);
        if (doc == null || doc.Text == null) {
            SendResponse("{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"result\":null}");
            return;
        }
        int ls = LineStartOf(doc.Text, line);
        if (ls < 0) {
            SendResponse("{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"result\":null}");
            return;
        }
        int bcol = ByteColAt(doc.Text, line, character);
        int cursor = ls + bcol;
        if (cursor > doc.Text.Length) { cursor = doc.Text.Length; }

        // Forward scan up to cursor so strings/comments (including cursors inside
        // an open string argument) and nested calls/brackets are tracked accurately.
        List<int> stackKind = new List<int>();
        List<int> stackPos = new List<int>();
        List<int> stackCommas = new List<int>();
        int p = 0;
        while (p < cursor) {
            char c = doc.Text[p];
            if (c == '/' && p + 1 < cursor && doc.Text[p + 1] == '/') {
                p = p + 2;
                while (p < cursor && doc.Text[p] != '\n') { p = p + 1; }
                continue;
            }
            if (c == '/' && p + 1 < cursor && doc.Text[p + 1] == '*') {
                p = p + 2;
                while (p + 1 < cursor && !(doc.Text[p] == '*' && doc.Text[p + 1] == '/')) {
                    p = p + 1;
                }
                p = p + 2;
                continue;
            }
            if (c == '"' || c == '\'') {
                char q = c;
                p = p + 1;
                while (p < cursor && doc.Text[p] != q) {
                    if (doc.Text[p] == '\\' && p + 1 < cursor) { p = p + 1; }
                    p = p + 1;
                }
                if (p < cursor) { p = p + 1; }
                continue;
            }
            if (c == '(') {
                stackKind.Add(0);
                stackPos.Add(p);
                stackCommas.Add(0);
            } else if (c == '[') {
                stackKind.Add(1);
                stackPos.Add(p);
                stackCommas.Add(0);
            } else if (c == '{') {
                stackKind.Add(2);
                stackPos.Add(p);
                stackCommas.Add(0);
            } else if (c == ')' || c == ']' || c == '}') {
                int want = c == ')' ? 0 : (c == ']' ? 1 : 2);
                int top = stackKind.Count - 1;
                while (top >= 0 && stackKind[top] != want) {
                    stackKind.RemoveAt(top);
                    stackPos.RemoveAt(top);
                    stackCommas.RemoveAt(top);
                    top = top - 1;
                }
                if (top >= 0) {
                    stackKind.RemoveAt(top);
                    stackPos.RemoveAt(top);
                    stackCommas.RemoveAt(top);
                }
            } else if (c == ',' && stackKind.Count > 0
                    && stackKind[stackKind.Count - 1] == 0) {
                int top = stackCommas.Count - 1;
                stackCommas[top] = stackCommas[top] + 1;
            }
            p = p + 1;
        }
        int openParen = -1;
        int activeParam = 0;
        if (stackKind.Count > 0 && stackKind[stackKind.Count - 1] == 0) {
            int top = stackKind.Count - 1;
            openParen = stackPos[top];
            activeParam = stackCommas[top];
        }
        if (openParen < 0) {
            SendResponse("{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"result\":null}");
            return;
        }
        int wEnd = openParen;
        while (wEnd > 0 && (doc.Text[wEnd - 1] == ' ' || doc.Text[wEnd - 1] == '\t')) {
            wEnd = wEnd - 1;
        }
        int wStart = wEnd;
        while (wStart > 0 && IsWordChar(doc.Text[wStart - 1])) { wStart = wStart - 1; }
        if (wStart == wEnd) {
            SendResponse("{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"result\":null}");
            return;
        }
        string callee = doc.Text.Substring(wStart, wEnd - wStart);
        if (IsControlCallKeyword(callee)) {
            SendResponse("{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"result\":null}");
            return;
        }

        string dotRecv = DotReceiverBeforeOffset(doc.Text, wStart);
        string recvType = dotRecv != "" ? ResolveReceiverType(doc, dotRecv, line) : "";
        bool isNew = false;
        if (dotRecv == "") {
            int kwEnd = wStart;
            while (kwEnd > 0 && (doc.Text[kwEnd - 1] == ' ' || doc.Text[kwEnd - 1] == '\t')) {
                kwEnd = kwEnd - 1;
            }
            int kwStart = kwEnd;
            while (kwStart > 0 && IsWordChar(doc.Text[kwStart - 1])) { kwStart = kwStart - 1; }
            if (kwEnd - kwStart == 3 && doc.Text.Substring(kwStart, 3) == "new") {
                isNew = true;
            }
        }

        List<LspSymbol> pool = ProjectSymbolsFor(doc);
        List<LspSymbol> matches = new List<LspSymbol>();
        Dictionary<string, bool> seenLabels = new Dictionary<string, bool>();
        if (recvType != "" && !isNew) {
            List<string> chain = TypeAncestors(pool, recvType);
            int ci = 0;
            while (ci < chain.Count) {
                string ownerName = chain[ci];
                int si = 0;
                while (si < pool.Count) {
                    LspSymbol s = pool[si];
                    si = si + 1;
                    if ((s.Kind == LspSymbol.KindMethod() || s.Kind == LspSymbol.KindDelegate())
                            && s.Name == callee && s.ContainerName == ownerName) {
                        string lbl = FormatSignatureLabel(s);
                        if (!seenLabels.ContainsKey(lbl)) {
                            seenLabels[lbl] = true;
                            matches.Add(s);
                        }
                    }
                }
                ci = ci + 1;
            }
        } else {
            int si = 0;
            while (si < pool.Count) {
                LspSymbol s = pool[si];
                si = si + 1;
                bool ok = false;
                if (isNew) {
                    ok = s.Kind == LspSymbol.KindCtor()
                        && (s.Name == callee || s.ContainerName == callee);
                } else {
                    ok = (s.Kind == LspSymbol.KindMethod() || s.Kind == LspSymbol.KindCtor()
                        || s.Kind == LspSymbol.KindDelegate()) && s.Name == callee;
                }
                if (ok) {
                    string lbl = FormatSignatureLabel(s);
                    if (!seenLabels.ContainsKey(lbl)) {
                        seenLabels[lbl] = true;
                        matches.Add(s);
                    }
                }
            }
        }
        if (matches.Count == 0 && recvType != "") {
            int fi = 0;
            while (fi < pool.Count) {
                LspSymbol s = pool[fi];
                fi = fi + 1;
                if ((s.Kind == LspSymbol.KindMethod() || s.Kind == LspSymbol.KindDelegate())
                        && s.Name == callee) {
                    string lbl = FormatSignatureLabel(s);
                    if (!seenLabels.ContainsKey(lbl)) {
                        seenLabels[lbl] = true;
                        matches.Add(s);
                    }
                }
            }
        }
        if (matches.Count == 0) {
            SendResponse("{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"result\":null}");
            return;
        }

        int activeSig = 0;
        int ai = 0;
        while (ai < matches.Count) {
            if (matches[ai].ParamNames.Count > activeParam) {
                activeSig = ai;
                break;
            }
            ai = ai + 1;
        }

        StringBuilder sb = new StringBuilder();
        sb.Append("{\"jsonrpc\":\"2.0\",\"id\":");
        sb.Append(id);
        sb.Append(",\"result\":{\"signatures\":[");
        int mi = 0;
        while (mi < matches.Count) {
            LspSymbol sig = matches[mi];
            if (mi > 0) { sb.Append(','); }
            sb.Append("{\"label\":");
            sb.Append(EncodeJsonString(FormatSignatureLabel(sig)));
            sb.Append(",\"parameters\":[");
            int pi = 0;
            while (pi < sig.ParamNames.Count) {
                if (pi > 0) { sb.Append(','); }
                string pt = pi < sig.ParamTypes.Count ? sig.ParamTypes[pi] : "";
                string pl = pt != "" ? pt + " " + sig.ParamNames[pi] : sig.ParamNames[pi];
                sb.Append("{\"label\":");
                sb.Append(EncodeJsonString(pl));
                sb.Append("}");
                pi = pi + 1;
            }
            sb.Append("]}");
            mi = mi + 1;
        }
        sb.Append("],\"activeSignature\":");
        sb.Append(activeSig);
        sb.Append(",\"activeParameter\":");
        sb.Append(activeParam);
        sb.Append("}}");
        SendResponse(sb.ToString());
    }
}
