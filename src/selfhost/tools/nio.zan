namespace Zan;

public class Nio {
    [DllImport("crt", EntryPoint = "zan_file_rename")]
    public static extern int ReplaceFile(string source, string destination);

#if WINDOWS
    [DllImport("kernel32", EntryPoint = "CreateDirectoryW")]
    private static extern int CreateDirectoryWide(nint path, nint attributes);

    public static bool CreateDirectoryExclusive(string path) {
        nint wide = System.Wide.Of(path);
        if (wide == 0) { return false; }
        int result = CreateDirectoryWide(wide, 0);
        System.Wide.Free(wide);
        return result != 0;
    }
#else
    [DllImport("crt", EntryPoint = "mkdir")]
    private static extern int MakeDirectory(string path, int mode);

    public static bool CreateDirectoryExclusive(string path) {
        return MakeDirectory(path, 448) == 0; // 0700
    }
#endif
}
