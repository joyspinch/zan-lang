namespace Zan;

public class Nio {
    [DllImport("crt", EntryPoint = "zan_file_rename")]
    public static extern int ReplaceFile(string source, string destination);

#if WINDOWS
    [DllImport("kernel32", EntryPoint = "CreateDirectoryW")]
    private static extern int CreateDirectoryWide(nint path, nint attributes);

    [DllImport("kernel32", EntryPoint = "CreateFileW")]
    private static extern nint CreateFileWide(nint path, uint access, uint share, nint attributes,
                                              uint disposition, uint flags, nint templateFile);

    [DllImport("kernel32", EntryPoint = "CloseHandle")]
    public static extern int CloseFileHandle(nint handle);

    public static nint LockOutput(string path) {
        nint wide = System.Wide.Of(path);
        if (wide == 0) { return -1; }
        // A Windows handle with no sharing serializes publication. The lock
        // file is removed by the OS when the last handle closes.
        nint handle = CreateFileWide(wide, 65536, 0, 0, 4, 67108864, 0);
        System.Wide.Free(wide);
        return handle;
    }

    public static bool CreateDirectoryExclusive(string path) {
        nint wide = System.Wide.Of(path);
        if (wide == 0) { return false; }
        int result = CreateDirectoryWide(wide, 0);
        System.Wide.Free(wide);
        return result != 0;
    }
#else
    [DllImport("crt", EntryPoint = "mkdir")]
    private static extern int MakeDirectory(string path, int mode);

    public static bool CreateDirectoryExclusive(string path) {
        return MakeDirectory(path, 448) == 0; // 0700
    }
#endif
}
