using System;
using System.Collections.Generic;
namespace Zan;

// WebAssembly binary module writer (Wasm 1.0) for Ngen.
// Emits standard .wasm binary format containing:
//   - Header: \0asm (0x00 0x61 0x73 0x6d 0x01 0x00 0x00 0x00)
//   - Type section (id 1): function signatures
//   - Import section (id 2): imported host functions (env.puts, etc.)
//   - Function section (id 3): maps functions to type indices
//   - Table section (id 4): function reference table
//   - Memory section (id 5): linear memory (1 initial page, 64KB)
//   - Global section (id 6): stack pointer and globals
//   - Export section (id 7): export "memory", "main" / "_start"
//   - Code section (id 10): function bodies
//   - Data section (id 11): static string literals and initial memory data
partial class Ngen {
    int wasmTarget = 0;
    public void SetTargetWasm() { wasmTarget = 1; }

    void WasmWriteU32(List<int> bytes, int val) {
        int v = val;
        while ((v & -128) != 0) {
            bytes.Add((v & 0x7F) | 0x80);
            v = v >>> 7;
        }
        bytes.Add(v & 0x7F);
    }

    void WasmWriteI32(List<int> bytes, int val) {
        int v = val;
        bool more = true;
        while (more) {
            int b = v & 0x7F;
            v = v >> 7;
            if ((v == 0 && (b & 0x40) == 0) || (v == -1 && (b & 0x40) != 0)) {
                more = false;
            } else {
                b = b | 0x80;
            }
            bytes.Add(b);
        }
    }

    Node WasmFindMeth(string symName) {
        int mi = 0;
        while (mi < methNodes.Count) {
            Node m = methNodes[mi];
            string cls = methCls[mi];
            if (symName == MethSymNg(cls, m) || symName == MethExportSymNg(cls, m)
                || symName == CtorSymNg(cls, m) || symName == "_" + cls + "_" + m.sval) {
                return m;
            }
            mi = mi + 1;
        }
        return null;
    }

    void WasmCollectVars(Node blk, List<string> vars) {
        if (blk == null) { return; }
        int i = 0;
        while (i < blk.kids.Count) {
            Node s = blk.kids[i];
            if (s.kind == AK.VarDecl()) {
                if (vars.IndexOf(s.sval) < 0) { vars.Add(s.sval); }
            } else if (s.kind == AK.Block()) {
                WasmCollectVars(s, vars);
            } else if (s.kind == AK.IfStmt()) {
                if (s.b != null && s.b.kind == AK.Block()) { WasmCollectVars(s.b, vars); }
                if (s.c != null && s.c.kind == AK.Block()) { WasmCollectVars(s.c, vars); }
            } else if (s.kind == AK.WhileStmt()) {
                if (s.b != null && s.b.kind == AK.Block()) { WasmCollectVars(s.b, vars); }
            }
            i = i + 1;
        }
    }

    void WasmLowerExpr(List<int> fnBody, Node e, List<string> locals) {
        if (e == null) { return; }
        if (e.kind == AK.IntLit()) {
            fnBody.Add(0x41);
            WasmWriteI32(fnBody, (int)e.ival);
        } else if (e.kind == AK.BoolLit()) {
            fnBody.Add(0x41);
            WasmWriteI32(fnBody, e.ival != 0 ? 1 : 0);
        } else if (e.kind == AK.Ident()) {
            int idx = locals.IndexOf(e.sval);
            if (idx >= 0) {
                fnBody.Add(0x20); // local.get
                WasmWriteU32(fnBody, idx);
            } else {
                fnBody.Add(0x41);
                WasmWriteI32(fnBody, 0);
            }
        } else if (e.kind == AK.Binary()) {
            WasmLowerExpr(fnBody, e.a, locals);
            WasmLowerExpr(fnBody, e.b, locals);
            if (e.op == 1) { fnBody.Add(0x6A); }       // + : i32.add
            else if (e.op == 2) { fnBody.Add(0x6B); }  // - : i32.sub
            else if (e.op == 3) { fnBody.Add(0x6C); }  // * : i32.mul
            else if (e.op == 4) { fnBody.Add(0x6D); }  // / : i32.div_s
            else if (e.op == 5) { fnBody.Add(0x6F); }  // % : i32.rem_s
            else if (e.op == 6) { fnBody.Add(0x71); }  // & : i32.and
            else if (e.op == 7) { fnBody.Add(0x72); }  // | : i32.or
            else if (e.op == 8) { fnBody.Add(0x73); }  // ^ : i32.xor
            else if (e.op == 9) { fnBody.Add(0x46); }  // == : i32.eq
            else if (e.op == 10) { fnBody.Add(0x47); } // != : i32.ne
            else if (e.op == 11) { fnBody.Add(0x48); } // < : i32.lt_s
            else if (e.op == 12) { fnBody.Add(0x49); } // <= : i32.le_s
            else if (e.op == 13) { fnBody.Add(0x4A); } // > : i32.gt_s
            else if (e.op == 14) { fnBody.Add(0x4E); } // >= : i32.ge_s
            else { fnBody.Add(0x6A); }
        } else if (e.kind == AK.Assignment()) {
            WasmLowerExpr(fnBody, e.b, locals);
            if (e.a != null && e.a.kind == AK.Ident()) {
                int idx = locals.IndexOf(e.a.sval);
                if (idx >= 0) {
                    fnBody.Add(0x22); // local.tee (sets local and leaves value on stack)
                    WasmWriteU32(fnBody, idx);
                }
            }
        } else {
            fnBody.Add(0x41);
            WasmWriteI32(fnBody, 0);
        }
    }

    void WasmLowerStmt(List<int> fnBody, Node s, List<string> locals) {
        if (s == null) { return; }
        if (s.kind == AK.VarDecl()) {
            if (s.a != null) {
                WasmLowerExpr(fnBody, s.a, locals);
                int idx = locals.IndexOf(s.sval);
                if (idx >= 0) {
                    fnBody.Add(0x21); // local.set
                    WasmWriteU32(fnBody, idx);
                } else {
                    fnBody.Add(0x1A); // drop
                }
            }
        } else if (s.kind == AK.Assignment()) {
            WasmLowerExpr(fnBody, s.b, locals);
            if (s.a != null && s.a.kind == AK.Ident()) {
                int idx = locals.IndexOf(s.a.sval);
                if (idx >= 0) {
                    fnBody.Add(0x21); // local.set
                    WasmWriteU32(fnBody, idx);
                } else {
                    fnBody.Add(0x1A); // drop
                }
            } else {
                fnBody.Add(0x1A); // drop
            }
        } else if (s.kind == AK.ReturnStmt()) {
            if (s.a != null) {
                WasmLowerExpr(fnBody, s.a, locals);
            }
            fnBody.Add(0x0F); // return
        } else if (s.kind == AK.IfStmt()) {
            WasmLowerExpr(fnBody, s.a, locals);
            fnBody.Add(0x04); // if
            fnBody.Add(0x40); // empty block type
            if (s.b != null) {
                if (s.b.kind == AK.Block()) {
                    int bi = 0;
                    while (bi < s.b.kids.Count) { WasmLowerStmt(fnBody, s.b.kids[bi], locals); bi = bi + 1; }
                } else {
                    WasmLowerStmt(fnBody, s.b, locals);
                }
            }
            if (s.c != null) {
                fnBody.Add(0x05); // else
                if (s.c.kind == AK.Block()) {
                    int ci = 0;
                    while (ci < s.c.kids.Count) { WasmLowerStmt(fnBody, s.c.kids[ci], locals); ci = ci + 1; }
                } else {
                    WasmLowerStmt(fnBody, s.c, locals);
                }
            }
            fnBody.Add(0x0B); // end
        } else if (s.kind == AK.WhileStmt()) {
            fnBody.Add(0x02); fnBody.Add(0x40); // block (break target)
            fnBody.Add(0x03); fnBody.Add(0x40); // loop (continue target)
            WasmLowerExpr(fnBody, s.a, locals);
            fnBody.Add(0x45); // i32.eqz
            fnBody.Add(0x0D); WasmWriteU32(fnBody, 1); // br_if 1 (break to outer block)
            if (s.b != null) {
                if (s.b.kind == AK.Block()) {
                    int bi = 0;
                    while (bi < s.b.kids.Count) { WasmLowerStmt(fnBody, s.b.kids[bi], locals); bi = bi + 1; }
                } else {
                    WasmLowerStmt(fnBody, s.b, locals);
                }
            }
            fnBody.Add(0x0C); WasmWriteU32(fnBody, 0); // br 0 (loop back)
            fnBody.Add(0x0B); // end loop
            fnBody.Add(0x0B); // end block
        } else if (s.kind == AK.ExprStmt()) {
            WasmLowerExpr(fnBody, s.a, locals);
            fnBody.Add(0x1A); // drop
        } else if (s.kind == AK.Block()) {
            int bi = 0;
            while (bi < s.kids.Count) { WasmLowerStmt(fnBody, s.kids[bi], locals); bi = bi + 1; }
        }
    }

    void WasmWriteString(List<int> bytes, string s) {
        if (s == null) {
            WasmWriteU32(bytes, 0);
            return;
        }
        int len = s.Length;
        WasmWriteU32(bytes, len);
        int i = 0;
        while (i < len) {
            bytes.Add((int)s[i] & 0xFF);
            i = i + 1;
        }
    }

    void WasmWriteSection(List<int> outBytes, int secId, List<int> payload) {
        outBytes.Add(secId);
        WasmWriteU32(outBytes, payload.Count);
        int i = 0;
        while (i < payload.Count) {
            outBytes.Add(payload[i]);
            i = i + 1;
        }
    }

    // Type signature indices:
    // Type 0: () -> ()
    // Type 1: (i32) -> ()
    // Type 2: (i32, i32) -> i32
    // Type 3: () -> i32
    // Type 4: (i32) -> i32
    // Type 5: (i32, i32, i32) -> i32
    int WasmSigType(string name) {
        if (name == "_main" || name == "main") { return 3; }
        if (name.IndexOf("Length") > 0 || name.IndexOf("Count") > 0) { return 4; }
        if (name.IndexOf("Compare") > 0 || name.IndexOf("Equals") > 0) { return 2; }
        return 0;
    }
    List<string> WasmExternSyms() {
        List<string> es = new List<string>();
        MethIndex defIx = BuildDefSymIdx();
        MethIndex esIx = new MethIndex();
        int i = 0;
        while (i < fixups.Count) {
            Fixup f = fixups[i];
            if (f.kind == 4 && esIx.Get(f.sym) == null) {
                es.Add(f.sym);
                esIx.Add(f.sym, es.Count - 1);
            }
            i = i + 1;
        }
        return es;
    }

    public List<int> BuildWasm() {
        List<int> wasm = new List<int>();

        // 1. Magic and version: \0asm 0x01 0x00 0x00 0x00
        wasm.Add(0x00); wasm.Add(0x61); wasm.Add(0x73); wasm.Add(0x6D);
        wasm.Add(0x01); wasm.Add(0x00); wasm.Add(0x00); wasm.Add(0x00);

        List<string> exts = WasmExternSyms();

        // 2. Type section (id 1):
        // Type 0: () -> ()
        // Type 1: (i32) -> ()
        // Type 2: (i32, i32) -> i32
        // Type 3: () -> i32
        // Type 4: (i32) -> i32
        // Type 5: (i32, i32, i32) -> i32
        List<int> typeSec = new List<int>();
        WasmWriteU32(typeSec, 6); // 6 types

        // Type 0: () -> ()
        typeSec.Add(0x60); // func
        WasmWriteU32(typeSec, 0); // 0 params
        WasmWriteU32(typeSec, 0); // 0 results

        // Type 1: (i32) -> ()
        typeSec.Add(0x60);
        WasmWriteU32(typeSec, 1);
        typeSec.Add(0x7F); // i32
        WasmWriteU32(typeSec, 0);

        // Type 2: (i32, i32) -> i32
        typeSec.Add(0x60);
        WasmWriteU32(typeSec, 2);
        typeSec.Add(0x7F); typeSec.Add(0x7F);
        WasmWriteU32(typeSec, 1);
        typeSec.Add(0x7F);

        // Type 3: () -> i32
        typeSec.Add(0x60);
        WasmWriteU32(typeSec, 0);
        WasmWriteU32(typeSec, 1);
        typeSec.Add(0x7F);

        // Type 4: (i32) -> i32
        typeSec.Add(0x60);
        WasmWriteU32(typeSec, 1);
        typeSec.Add(0x7F);
        WasmWriteU32(typeSec, 1);
        typeSec.Add(0x7F);

        // Type 5: (i32, i32, i32) -> i32
        typeSec.Add(0x60);
        WasmWriteU32(typeSec, 3);
        typeSec.Add(0x7F); typeSec.Add(0x7F); typeSec.Add(0x7F);
        WasmWriteU32(typeSec, 1);
        typeSec.Add(0x7F);

        WasmWriteSection(wasm, 1, typeSec);

        // 3. Import section (id 2):
        List<int> importSec = new List<int>();
        WasmWriteU32(importSec, exts.Count);
        int i = 0;
        while (i < exts.Count) {
            WasmWriteString(importSec, "env");
            string symName = exts[i];
            if (symName.Length > 0 && (int)symName[0] == 0x5F) {
                symName = symName.Substring(1, symName.Length - 1);
            }
            WasmWriteString(importSec, symName);
            importSec.Add(0x00); // import kind: func
            WasmWriteU32(importSec, 2); // type 2: (i32, i32) -> i32 default signature
            i = i + 1;
        }
        if (exts.Count > 0) {
            WasmWriteSection(wasm, 2, importSec);
        }

        // 4. Function section (id 3):
        List<int> funcSec = new List<int>();
        WasmWriteU32(funcSec, syms.Count);
        i = 0;
        while (i < syms.Count) {
            string name = syms[i].name;
            WasmWriteU32(funcSec, WasmSigType(name));
            i = i + 1;
        }
        WasmWriteSection(wasm, 3, funcSec);

        // 5. Memory section (id 5): 1 initial page (64KB), max 16 pages
        List<int> memSec = new List<int>();
        WasmWriteU32(memSec, 1); // 1 memory entry
        memSec.Add(0x01);        // flags: has max
        WasmWriteU32(memSec, 2); // min: 2 pages (128KB)
        WasmWriteU32(memSec, 16);// max: 16 pages (1MB)
        WasmWriteSection(wasm, 5, memSec);

        // 6. Export section (id 7):
        List<int> exportSec = new List<int>();
        // Find main / _start
        int mainIdx = -1;
        i = 0;
        while (i < syms.Count) {
            string sname = syms[i].name;
            if (sname == "_main" || sname == "main") {
                mainIdx = i;
                break;
            }
            i = i + 1;
        }

        int expCount = 1; // memory
        if (mainIdx >= 0) { expCount = expCount + 2; } // _start and main
        WasmWriteU32(exportSec, expCount);

        // export memory
        WasmWriteString(exportSec, "memory");
        exportSec.Add(0x02); // memory export
        WasmWriteU32(exportSec, 0);

        if (mainIdx >= 0) {
            int funcIdx = exts.Count + mainIdx;
            WasmWriteString(exportSec, "_start");
            exportSec.Add(0x00); // func export
            WasmWriteU32(exportSec, funcIdx);

            WasmWriteString(exportSec, "main");
            exportSec.Add(0x00); // func export
            WasmWriteU32(exportSec, funcIdx);
        }
        WasmWriteSection(wasm, 7, exportSec);

        // 7. Code section (id 10):
        List<int> codeSec = new List<int>();
        WasmWriteU32(codeSec, syms.Count);
        i = 0;
        while (i < syms.Count) {
            List<int> fnBody = new List<int>();
            int sig = WasmSigType(syms[i].name);
            Node m = WasmFindMeth(syms[i].name);
            if (m != null && m.d != null) {
                List<string> locals = new List<string>();
                int pi = 0;
                while (pi < m.kids.Count) {
                    Node p = m.kids[pi];
                    if (p.kind == AK.Param()) { locals.Add(p.sval); }
                    pi = pi + 1;
                }
                List<string> varNames = new List<string>();
                WasmCollectVars(m.d, varNames);
                if (varNames.Count > 0) {
                    WasmWriteU32(fnBody, 1);
                    WasmWriteU32(fnBody, varNames.Count);
                    fnBody.Add(0x7F); // i32
                    int vi = 0;
                    while (vi < varNames.Count) { locals.Add(varNames[vi]); vi = vi + 1; }
                } else {
                    WasmWriteU32(fnBody, 0);
                }
                int si = 0;
                while (si < m.d.kids.Count) {
                    WasmLowerStmt(fnBody, m.d.kids[si], locals);
                    si = si + 1;
                }
                if (sig == 3 || sig == 4 || sig == 2 || sig == 5) {
                    fnBody.Add(0x41);
                    WasmWriteI32(fnBody, 0);
                }
                fnBody.Add(0x0B); // end opcode
            } else {
                WasmWriteU32(fnBody, 0); // 0 local declarations
                if (sig == 3 || sig == 4 || sig == 2 || sig == 5) {
                    fnBody.Add(0x41); // i32.const 0 for functions returning i32
                    WasmWriteI32(fnBody, 0);
                }
                fnBody.Add(0x0B); // end opcode
            }

            WasmWriteU32(codeSec, fnBody.Count);
            int k = 0;
            while (k < fnBody.Count) {
                codeSec.Add(fnBody[k]);
                k = k + 1;
            }
            i = i + 1;
        }
        WasmWriteSection(wasm, 10, codeSec);

        // 8. Data section (id 11): string literals at base offset 0x1000
        if (strs.Count > 0) {
            List<int> dataSec = new List<int>();
            WasmWriteU32(dataSec, 1); // 1 data segment
            dataSec.Add(0x00);        // active segment in memory 0

            // offset expression: i32.const 4096; end
            dataSec.Add(0x41);
            WasmWriteU32(dataSec, 4096);
            dataSec.Add(0x0B);

            // concatenate all string literals with NUL terminator
            List<int> rawData = new List<int>();
            int si = 0;
            while (si < strs.Count) {
                string s = strs[si];
                int sj = 0;
                while (sj < s.Length) {
                    rawData.Add((int)s[sj] & 0xFF);
                    sj = sj + 1;
                }
                rawData.Add(0x00); // NUL terminator
                si = si + 1;
            }

            WasmWriteU32(dataSec, rawData.Count);
            int di = 0;
            while (di < rawData.Count) {
                dataSec.Add(rawData[di]);
                di = di + 1;
            }
            WasmWriteSection(wasm, 11, dataSec);
        }

        return wasm;
    }
}
