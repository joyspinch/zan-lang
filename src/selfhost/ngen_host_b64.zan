using System;
using System.Collections.Generic;
namespace Zan;

partial class Ngen {
    void HostEmitB64() {
        HostBegin("_zan_ext_b64_encode");
        HostSave(0, 0);                        // base
        HostSave(1, 1);                        // len
        HostSave(2, 2);                        // stride
        LoadImm(4, 3);
        ExtUdiv(5, 1, 4);                      // groups = len / 3
        HostSave(5, 3);                        // groups
        ExtMsub(6, 5, 4, 1);                   // rem = len - groups * 3
        ExtLsl(7, 5, 2);                       // outlen = groups * 4
        int rem0 = NL();
        CbzReg(6, rem0);
        AddImm(7, 7, 4);
        Mark(rem0);
        HostSave(6, 7);                        // rem → 槽 7(批 35:尾部若再 Udiv 会打掉 v9/rax 里的 base 游标——首版尾部重算 rem,b0 读到的是商,页错误挂死)
        AddImm(0, 7, 1);
        BLExtern("_malloc");
        HostNonzero(0, "ext.b64.malloc");
        ExtMov(10, 0);                         // out cursor
        HostSave(0, 4);                        // out
        HostLoad(9, 0);                        // base cursor
        HostLoad(11, 3);                       // groups remaining
        HostLoad(12, 2);                       // stride
        AddRR(15, 12, 12);                     // 2 * stride
        LoadStr(extTblB64, 13);
        int gDone = NL();
        int gLoop = NL();
        Mark(gLoop);
        CbzReg(11, gDone);
        ExtLdrbImm(3, 9, 0);                   // b0
        ExtLdrbReg(4, 9, 12);                  // b1
        ExtLdrbReg(5, 9, 15);                  // b2
        ExtLsl(6, 3, 16);
        ExtLsl(7, 4, 8);
        ExtOrr(6, 6, 7);
        ExtOrr(6, 6, 5);                       // n = (b0<<16)|(b1<<8)|b2
        ExtLsr(3, 6, 18);
        ExtLdrbReg(3, 13, 3);                  // c0
        ExtStrbImm(3, 10, 0);
        ExtUbfmR(3, 6, 12, 17);                // (n >> 12) & 63
        ExtLdrbReg(3, 13, 3);
        ExtStrbImm(3, 10, 1);
        ExtUbfmR(3, 6, 6, 11);
        ExtLdrbReg(3, 13, 3);
        ExtStrbImm(3, 10, 2);
        ExtUbfmLo(3, 6, 5);
        ExtLdrbReg(3, 13, 3);
        ExtStrbImm(3, 10, 3);
        AddImm(10, 10, 4);
        LoadImm(4, 3);
        ExtMadd(9, 12, 4, 9);                  // base += 3 * stride
        AddImm(11, 11, -1);
        EmitB(gLoop);
        Mark(gDone);
        HostLoad(7, 7);                        // rem(入口已存槽 7;首版重算走 Udiv 打掉 v9/rax)
        // the group cursor (x10) already points past the full groups
        int tRem2 = NL();
        ExtCmpImm(7, 2);
        int tIs2 = NL();
        EmitBcond(0, tIs2);                    // eq -> rem == 2
        ExtCmpImm(7, 1);
        int tIs1 = NL();
        EmitBcond(0, tIs1);                    // eq -> rem == 1
        EmitB(tRem2);                          // rem == 0: nothing
        Mark(tIs1);
        ExtLdrbImm(3, 9, 0);                   // b0
        ExtLsl(6, 3, 16);
        ExtLsr(3, 6, 18);
        ExtLdrbReg(3, 13, 3);
        ExtStrbImm(3, 10, 0);
        ExtUbfmR(3, 6, 12, 17);
        ExtLdrbReg(3, 13, 3);
        ExtStrbImm(3, 10, 1);
        LoadImm(3, 61);                        // '='
        ExtStrbImm(3, 10, 2);
        ExtStrbImm(3, 10, 3);
        AddImm(10, 10, 4);
        EmitB(tRem2);
        Mark(tIs2);
        ExtLdrbImm(3, 9, 0);
        ExtLdrbReg(4, 9, 12);
        ExtLsl(6, 3, 16);
        ExtLsl(7, 4, 8);
        ExtOrr(6, 6, 7);
        ExtLsr(3, 6, 18);
        ExtLdrbReg(3, 13, 3);
        ExtStrbImm(3, 10, 0);
        ExtUbfmR(3, 6, 12, 17);
        ExtLdrbReg(3, 13, 3);
        ExtStrbImm(3, 10, 1);
        ExtUbfmR(3, 6, 6, 11);
        ExtLdrbReg(3, 13, 3);
        ExtStrbImm(3, 10, 2);
        LoadImm(3, 61);
        ExtStrbImm(3, 10, 3);
        AddImm(10, 10, 4);
        Mark(tRem2);
        ExtStrbImm(31, 10, 0);
        ExtMov(0, 10);                         // x0 = end cursor
        HostLoad(1, 4);
        ExtSubRR(1, 0, 1);                     // produced length = end - out
        HostLoad(0, 4);                        // out (string start)
        ExtPush(0);
        BLInternal("_zan_host_copy");
        ExtPop(1);                             // x1 = out (sp restored, x0 = result)
        HostSave(0, 5);                        // result
        HostSave(1, 6);                        // out
        HostLoad(0, 6);                        // free(out)
        BLExtern("_free");
        HostLoad(0, 5);
        HostEnd();

        HostBegin("_zan_ext_b64_str");
        HostSave(0, 0);
        HostLoad(9, 0);
        ExtLenOf(9, 9);
        HostLoad(0, 0);
        ExtMov(1, 9);
        LoadImm(2, 1);
        BLInternal("_zan_ext_b64_encode");
        HostEnd();
    }

    // x0 = msg string, x1 = len -> byte[] digest (len clamped to the string).
    // All digests live in runtime_core.zan (target-agnostic zan_* face), so
    // the emitted code no longer leans on CommonCrypto/libSystem exports.
    // rd = ror32(rn, n) composed on the zero-extended 64-bit form
    void ShaRor32(int rd, int rn, int n) {
        // 批 35:源值(轮内加法 e' = d+T1 等不掩码)可超 32 位——右移的高
        // 32 位会折进低字,左移同样。先掩 32 再两个移位
        Uxtw32(12, rn);
        LsrImm(rd, 12, n);
        Uxtw32(11, 12);
        LslImm(11, 11, 32 - n);
        OrrRR(rd, rd, 11);
        Uxtw32(rd, rd);
    }
    // _zan_sha256(data, len, md): FIPS 180-4, zan-emitted (batch 34) so the
    // x86 lane owns its digest path. 32-bit state rides 64-bit zero-extended
    // registers; rotates compose from LsrImm/LslImm + OrrRR + Uxtw32 (a
    // 64-bit ror would drag the zero high half through the low word). Frame:
    // slots 0..15 (128B), W[64] at [sp+128..639] as 8-byte zero-extended
    // slots, scratch (two 64B blocks) at [sp+640..767].
    void EmitZanSha256() {
        HostBeginN("_zan_sha256", 1280);
        HostSave(0, 0); HostSave(1, 1); HostSave(2, 2);
        // h[0..7] = IV (slots 3..10)
        LoadImm(9, 0x6A09E667L); HostSave(9, 3);
        LoadImm(9, 0xBB67AE85L); HostSave(9, 4);
        LoadImm(9, 0x3C6EF372L); HostSave(9, 5);
        LoadImm(9, 0xA54FF53AL); HostSave(9, 6);
        LoadImm(9, 0x510E527FL); HostSave(9, 7);
        LoadImm(9, 0x9B05688CL); HostSave(9, 8);
        LoadImm(9, 0x1F83D9ABL); HostSave(9, 9);
        LoadImm(9, 0x5BE0CD19L); HostSave(9, 10);
        // K[0..63] -> [sp + 768 + 8t](ShaKImm 运行时取表)
        long[] KT = new long[64];
        KT[0] = 1116352408L; KT[1] = 1899447441L; KT[2] = 3049323471L; KT[3] = 3921009573L;
        KT[4] = 961987163L; KT[5] = 1508970993L; KT[6] = 2453635748L; KT[7] = 2870763221L;
        KT[8] = 3624381080L; KT[9] = 310598401L; KT[10] = 607225278L; KT[11] = 1426881987L;
        KT[12] = 1925078388L; KT[13] = 2162078206L; KT[14] = 2614888103L; KT[15] = 3248222580L;
        KT[16] = 3835390401L; KT[17] = 4022224774L; KT[18] = 264347078L; KT[19] = 604807628L;
        KT[20] = 770255983L; KT[21] = 1249150122L; KT[22] = 1555081692L; KT[23] = 1996064986L;
        KT[24] = 2554220882L; KT[25] = 2821834349L; KT[26] = 2952996808L; KT[27] = 3210313671L;
        KT[28] = 3336571891L; KT[29] = 3584528711L; KT[30] = 113926993L; KT[31] = 338241895L;
        KT[32] = 666307205L; KT[33] = 773529912L; KT[34] = 1294757372L; KT[35] = 1396182291L;
        KT[36] = 1695183700L; KT[37] = 1986661051L; KT[38] = 2177026350L; KT[39] = 2456956037L;
        KT[40] = 2730485921L; KT[41] = 2820302411L; KT[42] = 3259730800L; KT[43] = 3345764771L;
        KT[44] = 3516065817L; KT[45] = 3600352804L; KT[46] = 4094571909L; KT[47] = 275423344L;
        KT[48] = 430227734L; KT[49] = 506948616L; KT[50] = 659060556L; KT[51] = 883997877L;
        KT[52] = 958139571L; KT[53] = 1322822218L; KT[54] = 1537002063L; KT[55] = 1747873779L;
        KT[56] = 1955562222L; KT[57] = 2024104815L; KT[58] = 2227730452L; KT[59] = 2361852424L;
        KT[60] = 2428436474L; KT[61] = 2756734187L; KT[62] = 3204031479L; KT[63] = 3329325298L;
        LoadImm(9, 768);
        AddRR(9, 31, 9);                        // K 表基址(sp+768)
        int iK = 0;
        while (iK < 64) {
            LoadImm(11, KT[iK]);
            StrU(11, 9, 8 * iK);
            iK = iK + 1;
        }
        // nb_full = len >> 6 (slot 13); rem = len - nb_full*64 (slot 14)
        HostLoad(9, 1);
        LsrImm(10, 9, 6);
        HostSave(10, 13);
        LslImm(11, 10, 6);
        StringSub(11, 9, 11);
        HostSave(11, 14);
        // tailCount = rem >= 56 ? 2 : 1 (slot 15); totalBlocks (slot 12)
        LoadImm(12, 56);
        HostLoad(11, 14);
        StringCmp(11, 12);
        int sOne = NL(); int sTwo = NL(); int sTwoDone = NL();
        EmitBcond(10, sTwo);
        LoadImm(12, 1);
        EmitB(sTwoDone);
        Mark(sTwo);
        LoadImm(12, 2);
        Mark(sTwoDone);
        HostSave(12, 15);
        HostLoad(10, 13);
        HostLoad(11, 15);
        AddRR(10, 10, 11);
        HostSave(10, 12);
        // data pointer parked in slot 11; block loop counter b in slot 15
        // (reused after tailCount is consumed)
        HostLoad(10, 0);
        HostSave(10, 11);
        LoadImm(10, 0);
        HostSave(10, 15);
        int bLoop = NL(); int bDone = NL(); int bNext = NL();
        int bFull = NL(); int bTail = NL(); int bTail2 = NL();
        Mark(bLoop);
        HostLoad(10, 15);                       // b
        HostLoad(11, 12);                       // total
        StringCmp(10, 11);
        EmitBcond(10, bDone);                   // b >= total -> finish
        HostLoad(10, 15);
        HostLoad(11, 13);                       // nb_full
        StringCmp(10, 11);
        EmitBcond(10, bTail);   // b >= nb_full -> 尾块(首版 LT 反了)                   // b >= nb_full -> tail
        // full block: memcpy(scratch, data + b*64, 64)
        AddImm(0, 31, 640);                     // v0 = dst = scratch(dst 在前!)
        LslImm(9, 10, 6);                       // b*64
        HostLoad(10, 11);                       // data
        AddRR(1, 10, 9);                        // v1 = src
        LoadImm(2, 64);
        BLExtern("_memcpy");
        EmitB(bNext);
        Mark(bTail);
        // 尾块合成(批 35 修正:首版零化循环把 v10 写进 [sp+0] 而非
        // [v9+0],bitlen 循环移位恒 0 且地址无 scratch 基址——三个循环
        // 全部重写;该面首次被 t17 验证即由此门把住)
        HostLoad(11, 14);                       // rem
        LoadImm(12, 56);
        StringCmp(11, 12);
        EmitBcond(10, bTail2);                  // rem >= 56 -> 两块尾(cond 10=GE;首版 12=GT 把 rem==56 漏进单尾,bitlen 覆写 0x80 —— 批 35)
        // 单尾块(或两块尾的第 1 块,rem < 56):零化 128B,拷 rem 字节,
        // 0x80,bitlen 大端在 +56
        AddImm(0, 31, 640);                     // v0 = scratch 基址
        LoadImm(9, 0);
        int mz = NL(); int mzEnd = NL();
        Mark(mz);
        LoadImm(10, 128);
        StringCmp(9, 10);
        EmitBcond(10, mzEnd);                   // off >= 128(首版 768 连 K 表一起抹了)
        AddRR(10, 9, 0);                        // addr = scratch + off
        LoadImm(11, 0);
        StrU(11, 10, 0);                        // [scratch + off] = 0
        AddImm(9, 9, 8);
        EmitB(mz);
        Mark(mzEnd);
        HostLoad(10, 15);                       // b (== nb_full)
        AddImm(1, 31, 640);                     // v1 = src(dst 已在 v0)
        LslImm(9, 10, 6);
        HostLoad(10, 11);                       // data
        AddRR(1, 10, 9);                        // v1 = src = data + b*64
        HostLoad(2, 14);                        // rem
        BLExtern("_memcpy");
        AddImm(0, 31, 640);                     // v0 = scratch(拷贝后重取)
        HostLoad(1, 14);
        MovRR(2, 1);
        AddRR(0, 0, 2);                         // scratch + rem
        LoadImm(1, 0x80);
        StoreB(1, 0, 0);                        // scratch[rem] = 0x80
        // bitlen 大端 8 字节:scratch[56+i] = (bitlen >> (56-8i)) & 0xFF
        HostLoad(9, 1);
        LslImm(9, 9, 3);                        // v9 = bitlen
        AddImm(0, 31, 640);                     // v0 = scratch 基址
        LoadImm(10, 0);                         // i
        int bw = NL(); int bwEnd = NL();
        Mark(bw);
        LoadImm(11, 8);
        StringCmp(10, 11);
        EmitBcond(10, bwEnd);                   // i >= 8
        LslImm(11, 10, 3);                      // 8i
        LoadImm(12, 56);
        ExtSubRR(11, 12, 11);                   // 56 - 8i
        LsrvVV(12, 9, 11);                      // bitlen >> (56-8i)
        Uxtw32(12, 12);
        LoadImm(11, 56);
        AddRR(11, 11, 10);                      // 56 + i
        AddRR(11, 11, 0);                       // + scratch
        StoreB(12, 11, 0);
        AddImm(10, 10, 1);
        EmitB(bw);
        Mark(bwEnd);
        EmitB(bNext);
        Mark(bTail2);
        // 两块尾的第 1 块:数据 + 0x80 + 零;bitlen 骑第 2 块 +120
        AddImm(0, 31, 640);                     // v0 = scratch 基址
        LoadImm(9, 0);
        int mz2 = NL(); int mz2End = NL();
        Mark(mz2);
        LoadImm(10, 128);
        StringCmp(9, 10);
        EmitBcond(10, mz2End);                  // off >= 128(两块尾:整 128B 零化)
        AddRR(10, 9, 0);                        // addr = scratch + off
        LoadImm(11, 0);
        StrU(11, 10, 0);                        // [scratch + off] = 0
        AddImm(9, 9, 8);
        EmitB(mz2);
        Mark(mz2End);
        HostLoad(10, 15);
        AddImm(1, 31, 640);                     // v1 = src(dst 已在 v0)
        LslImm(9, 10, 6);
        HostLoad(10, 11);
        AddRR(1, 10, 9);                        // v1 = src
        HostLoad(2, 14);
        BLExtern("_memcpy");
        AddImm(0, 31, 640);
        HostLoad(1, 14);
        MovRR(2, 1);
        AddRR(0, 0, 2);
        LoadImm(1, 0x80);
        StoreB(1, 0, 0);
        // bitlen 大端 8 字节:scratch[120+i] = (bitlen >> (56-8i)) & 0xFF
        HostLoad(9, 1);
        LslImm(9, 9, 3);
        AddImm(0, 31, 640);
        LoadImm(10, 0);
        int bw2 = NL(); int bw2End = NL();
        Mark(bw2);
        LoadImm(11, 8);
        StringCmp(10, 11);
        EmitBcond(10, bw2End);
        LslImm(11, 10, 3);
        LoadImm(12, 56);
        ExtSubRR(11, 12, 11);
        LsrvVV(12, 9, 11);
        Uxtw32(12, 12);
        LoadImm(11, 120);
        AddRR(11, 11, 10);
        AddRR(11, 11, 0);
        StoreB(12, 11, 0);
        AddImm(10, 10, 1);
        EmitB(bw2);
        Mark(bw2End);
        Mark(bNext);
        // ---- W[0..15] = big-endian words of the block at scratch + off ----
        // block source offset: b > nb_full -> +64
        HostLoad(10, 15);
        HostLoad(11, 13);
        StringCmp(10, 11);
        int wOff = NL(); int wOffDone = NL();
        EmitBcond(12, wOff);                    // b > nb_full -> 第二尾块
        LoadImm(12, 0);
        EmitB(wOffDone);
        Mark(wOff);
        LoadImm(12, 64);
        Mark(wOffDone);
        // q = scratch + off (v9)
        AddImm(9, 31, 640);
        AddRR(9, 9, 12);
        // t loop 0..15
        LoadImm(10, 0);
        int wLoop = NL(); int wDone = NL();
        Mark(wLoop);
        LoadImm(11, 16);
        StringCmp(10, 11);
        EmitBcond(10, wDone);
        LoadB(11, 9, 0);
        LslImm(11, 11, 24);
        LoadB(12, 9, 1);
        LslImm(12, 12, 16);
        OrrRR(11, 11, 12);
        LoadB(12, 9, 2);
        LslImm(12, 12, 8);
        OrrRR(11, 11, 12);
        LoadB(12, 9, 3);
        OrrRR(11, 11, 12);
        // W[t] -> [sp + 128 + 8*t]: address arithmetics on v13
        LslImm(13, 10, 3);
        AddImm(13, 13, 128);
        AddRR(13, 31, 13);
        StrU(11, 13, 0);
        AddImm(9, 9, 4);                        // next word
        AddImm(10, 10, 1);
        EmitB(wLoop);
        Mark(wDone);
        // ---- W[16..63] schedule ----
        LoadImm(10, 16);
        int dLoop = NL(); int dDone = NL();
        Mark(dLoop);
        LoadImm(11, 64);
        StringCmp(10, 11);
        EmitBcond(10, dDone);
        // s1(W[t-2]) = ror17 ^ ror19 ^ shr10
        LslImm(13, 10, 3);
        AddImm(13, 13, 128 - 16);
        AddRR(13, 31, 13);                      // &[sp+128+8*(t-2)]
        LdrU(27, 13, 0);
        ShaRor32(28, 27, 17);
        ShaRor32(6, 27, 19);
        XorRR(28, 28, 6);
        LsrImm(6, 27, 10);
        XorRR(28, 28, 6);
        Uxtw32(28, 28);
        LdrU(27, 13, -40);                      // W[t-7](基址 W[t-2]:-5 槽)
        AddRR(28, 28, 27);
        LdrU(27, 13, -104);                     // W[t-15](-13 槽)
        ShaRor32(6, 27, 7);
        ShaRor32(27, 27, 18);
        XorRR(6, 6, 27);
        LdrU(27, 13, -104);                     // W[t-15] again for shr3
        LsrImm(27, 27, 3);
        XorRR(6, 6, 27);
        Uxtw32(6, 6);
        AddRR(28, 28, 6);
        LdrU(27, 13, -112);                     // W[t-16](-14 槽)
        AddRR(28, 28, 27);
        Uxtw32(28, 28);
        StrU(28, 13, 16);                       // 批 35:存回 W[t](基址是 W[t-2],首版 +0 把 W[t] 写进 W[t-2] 槽,轮函数读错 2 槽)
        AddImm(10, 10, 1);
        EmitB(dLoop);
        Mark(dDone);
        // ---- a..h from the IV slots (v19..v26) ----
        HostLoad(19, 3); HostLoad(20, 4); HostLoad(21, 5); HostLoad(22, 6);
        HostLoad(23, 7); HostLoad(24, 8); HostLoad(25, 9); HostLoad(26, 10);
        // ---- 64 rounds ----
        LoadImm(15, 0);
        int rLoop = NL(); int rDone = NL();
        Mark(rLoop);
        LoadImm(10, 64);
        StringCmp(15, 10);
        EmitBcond(10, rDone);
        // T1 = h + Sum1(e) + Ch(e,f,g) + K[t] + W[t]  (v27)
        ShaRor32(27, 23, 6);
        ShaRor32(28, 23, 11);
        XorRR(27, 27, 28);
        ShaRor32(28, 23, 25);
        XorRR(27, 27, 28);
        // Ch = g ^ (e & (f ^ g))
        XorRR(28, 24, 25);
        AndRR(28, 23, 28);
        XorRR(28, 25, 28);
        AddRR(27, 27, 28);
        AddRR(27, 27, 26);
        ShaKImm(27, 15);                        // + K[t] (inlined constant)
        // W[t]
        LslImm(28, 15, 3);
        AddImm(28, 28, 128);
        AddRR(28, 31, 28);
        LdrU(6, 28, 0);
        AddRR(27, 27, 6);
        // T2 = Sum0(a) + Maj(a,b,c)  (v28)
        ShaRor32(28, 19, 2);
        ShaRor32(6, 19, 13);
        XorRR(28, 28, 6);
        ShaRor32(6, 19, 22);
        XorRR(28, 28, 6);
        // Maj = (a&b) ^ (a&c) ^ (b&c)——v11 累积 Maj 后与 Sum0 相加
        // (首版把 Maj 的异或直接 Xor 进 v28,T2 = Sum0^Maj)
        AndRR(11, 19, 20);
        AndRR(6, 19, 21);
        XorRR(11, 11, 6);
        AndRR(6, 20, 21);
        XorRR(11, 11, 6);
        AddRR(28, 28, 11);
        // 批 35 修正:首版先覆写 v23(e)/v19(a) 再取旧值——f'/b' 拿到
        // 的是新值。正确序:旧 f -> v28,旧 e -> v24,旧 a -> v20,再算
        // e' = d+T1、a' = T1+T2,最后 h/g/d/c 就位
        // 批 35 修正序:v28 兼任 T2 与旧 f 暂存——T2 必须先被 a' 消耗,
        // 旧 a/b/c/e 的救援也必须赶在各自源被覆写之前
        // 轮旋转是寄存器链,必须完全反向执行(h'->g'->f'->e'->d'->c'
        // ->b'->a):每条 MovRR 的源在链上前一步的写目标里,先读后写。
        // g' 直接从 v24 取旧 f——首版经 v28 暂存,把 a' 要用的 T2(v28)
        // 一起毁掉
        MovRR(26, 25);                          // h' = 旧 g(v25 初值)
        MovRR(25, 24);                          // g' = 旧 f(v24 初值,v25 已被 h' 读)
        MovRR(24, 23);                          // f' = 旧 e(v23 初值)
        AddRR(23, 22, 27);                      // e' = 旧 d + T1(v22 初值)
        MovRR(22, 21);                          // d' = 旧 c(v21 初值)
        MovRR(21, 20);                          // c' = 旧 b(v20 初值)
        MovRR(20, 19);                          // b' = 旧 a(v19 初值)
        AddRR(19, 27, 28);                      // a' = T1 + T2(v28 = T2 完好)
        AddImm(15, 15, 1);
        EmitB(rLoop);
        Mark(rDone);
        // ---- fold a..h into the IV slots ----
        HostLoad(9, 3); AddRR(9, 9, 19); Uxtw32(9, 9); HostSave(9, 3);
        HostLoad(9, 4); AddRR(9, 9, 20); Uxtw32(9, 9); HostSave(9, 4);
        HostLoad(9, 5); AddRR(9, 9, 21); Uxtw32(9, 9); HostSave(9, 5);
        HostLoad(9, 6); AddRR(9, 9, 22); Uxtw32(9, 9); HostSave(9, 6);
        HostLoad(9, 7); AddRR(9, 9, 23); Uxtw32(9, 9); HostSave(9, 7);
        HostLoad(9, 8); AddRR(9, 9, 24); Uxtw32(9, 9); HostSave(9, 8);
        HostLoad(9, 9); AddRR(9, 9, 25); Uxtw32(9, 9); HostSave(9, 9);
        HostLoad(9, 10); AddRR(9, 9, 26); Uxtw32(9, 9); HostSave(9, 10);
        HostLoad(10, 15);                       // b
        AddImm(10, 10, 1);
        HostSave(10, 15);
        EmitB(bLoop);
        Mark(bDone);
        // ---- md: 32 bytes big-endian from the IV slots ----
        HostLoad(10, 2);                        // md
        int wi = 0;
        while (wi < 8) {
            HostLoad(9, 3 + wi);
            int by = 0;
            while (by < 4) {
                int sh = 24 - 8 * by;
                LsrImm(11, 9, sh);
                Uxtw32(11, 11);
                MovRR(1, 10);
                AddImm(1, 1, 4 * wi + by);
                StoreB(11, 1, 0);
                by = by + 1;
            }
            wi = wi + 1;
        }
        HostLoad(10, 2);
        HostEnd();
    }

    // K[t] as an inlined constant into rd (batch 34): LoadImm on the frozen
    // FIPS 180-4 table
    void ShaKImm(int rd, int t) {
        long[] K = new long[64];
        K[0] = 1116352408L; K[1] = 1899447441L; K[2] = 3049323471L; K[3] = 3921009573L;
        K[4] = 961987163L; K[5] = 1508970993L; K[6] = 2453635748L; K[7] = 2870763221L;
        K[8] = 3624381080L; K[9] = 310598401L; K[10] = 607225278L; K[11] = 1426881987L;
        K[12] = 1925078388L; K[13] = 2162078206L; K[14] = 2614888103L; K[15] = 3248222580L;
        K[16] = 3835390401L; K[17] = 4022224774L; K[18] = 264347078L; K[19] = 604807628L;
        K[20] = 770255983L; K[21] = 1249150122L; K[22] = 1555081692L; K[23] = 1996064986L;
        K[24] = 2554220882L; K[25] = 2821834349L; K[26] = 2952996808L; K[27] = 3210313671L;
        K[28] = 3336571891L; K[29] = 3584528711L; K[30] = 113926993L; K[31] = 338241895L;
        K[32] = 666307205L; K[33] = 773529912L; K[34] = 1294757372L; K[35] = 1396182291L;
        K[36] = 1695183700L; K[37] = 1986661051L; K[38] = 2177026350L; K[39] = 2456956037L;
        K[40] = 2730485921L; K[41] = 2820302411L; K[42] = 3259730800L; K[43] = 3345764771L;
        K[44] = 3516065817L; K[45] = 3600352804L; K[46] = 4094571909L; K[47] = 275423344L;
        K[48] = 430227734L; K[49] = 506948616L; K[50] = 659060556L; K[51] = 883997877L;
        K[52] = 958139571L; K[53] = 1322822218L; K[54] = 1537002063L; K[55] = 1747873779L;
        K[56] = 1955562222L; K[57] = 2024104815L; K[58] = 2227730452L; K[59] = 2361852424L;
        K[60] = 2428436474L; K[61] = 2756734187L; K[62] = 3204031479L; K[63] = 3329325298L;
        // 批 35 修正:轮循环是运行时的,首版 LoadImm(rd, K[t]) 用发射期
        // 数组吃运行时 t——64 轮恒加 K[15]。K 表落 sp+768..1279,此处
        // 按运行时 t 取表(调用者负责把表发射进帧,见 EmitZanSha256)
        LoadImm(6, 768);
        AddRR(6, 31, 6);                        // base = sp + 768
        LslImm(28, t, 3);
        AddRR(6, 6, 28);                        // + 8t
        LdrU(6, 6, 0);                          // K[t]
        AddRR(rd, rd, 6);
    }

    void HostEmitDigests() {
        HostBegin("_zan_ext_sha256");
        HostSave(0, 0); HostSave(1, 1);
        HostLoad(9, 0); ExtLenOf(9, 9);
        HostLoad(0, 1); ExtMov(1, 9); ExtClampLen(); HostSave(0, 2);
        HostLoad(0, 0); HostLoad(1, 2); AddImm(2, 31, 64);
        BLExtern("_zan_sha256");
        LoadImm(0, 32); BLInternal("_zan_ext_arr_new"); HostSave(0, 3);
        HostLoad(0, 3); AddImm(1, 31, 64); LoadImm(2, 32);
        BLInternal("_zan_ext_slot_copy");
        HostLoad(0, 3);
        HostEnd();

        HostBegin("_zan_ext_sha1");
        HostSave(0, 0); HostSave(1, 1);
        HostLoad(9, 0); ExtLenOf(9, 9);
        HostLoad(0, 1); ExtMov(1, 9); ExtClampLen(); HostSave(0, 2);
        HostLoad(0, 0); HostLoad(1, 2); AddImm(2, 31, 64);
        BLExtern("_zan_sha1");
        LoadImm(0, 20); BLInternal("_zan_ext_arr_new"); HostSave(0, 3);
        HostLoad(0, 3); AddImm(1, 31, 64); LoadImm(2, 20);
        BLInternal("_zan_ext_slot_copy");
        HostLoad(0, 3);
        HostEnd();

        HostBegin("_zan_ext_md5");
        HostSave(0, 0); HostSave(1, 1);
        HostLoad(9, 0); ExtLenOf(9, 9);
        HostLoad(0, 1); ExtMov(1, 9); ExtClampLen(); HostSave(0, 2);
        HostLoad(0, 0); HostLoad(1, 2); AddImm(2, 31, 64);
        BLExtern("_zan_md5");
        LoadImm(0, 16); BLInternal("_zan_ext_arr_new"); HostSave(0, 3);
        HostLoad(0, 3); AddImm(1, 31, 64); LoadImm(2, 16);
        BLInternal("_zan_ext_slot_copy");
        HostLoad(0, 3);
        HostEnd();

        HostBegin("_zan_ext_sha512");
        HostSave(0, 0); HostSave(1, 1);
        HostLoad(9, 0); ExtLenOf(9, 9);
        HostLoad(0, 1); ExtMov(1, 9); ExtClampLen(); HostSave(0, 2);
        HostLoad(0, 0); HostLoad(1, 2); AddImm(2, 31, 64);
        BLExtern("_zan_sha512");
        LoadImm(0, 64); BLInternal("_zan_ext_arr_new"); HostSave(0, 3);
        HostLoad(0, 3); AddImm(1, 31, 64); LoadImm(2, 64);
        BLInternal("_zan_ext_slot_copy");
        HostLoad(0, 3);
        HostEnd();

        // x0 = key, x1 = keyLen, x2 = msg, x3 = msgLen -> 32-byte MAC
        HostBegin("_zan_ext_hmac_sha256");
        HostSave(0, 0); HostSave(1, 1); HostSave(2, 2); HostSave(3, 3);
        HostLoad(4, 0); ExtLenOf(4, 9);
        HostLoad(0, 1); ExtMov(1, 9); ExtClampLen(); HostSave(0, 4);
        HostLoad(4, 2); ExtLenOf(4, 9);
        HostLoad(0, 3); ExtMov(1, 9); ExtClampLen(); HostSave(0, 5);
        HostLoad(0, 0); HostLoad(1, 4); HostLoad(2, 2); HostLoad(3, 5);
        AddImm(4, 31, 64);
        BLExtern("_zan_hmac_sha256");
        LoadImm(0, 32); BLInternal("_zan_ext_arr_new"); HostSave(0, 6);
        HostLoad(0, 6); AddImm(1, 31, 64); LoadImm(2, 32);
        BLInternal("_zan_ext_slot_copy");
        HostLoad(0, 6);
        HostEnd();
    }

    // ===================== interop / threading emitters =====================
    // Everything here is emitted AFTER HostEmitExt, so the list/string
    // helpers it builds on (_zan_host_list_new/_push, _zan_host_copy,
    // _zan_rt_str_alloc) already exist.

    void HostEmitHost2() {
        HostEmitStrSplit();
        HostEmitStrContains();
        HostEmitDlErrorStr();
        HostEmitGetCwd();
        HostEmitNmGetStr();
        HostEmitNmSha();
        HostEmitThreadHelpers();
        HostEmitIntTryParse();
        HostEmitMkdirs();
        HostEmitDelRec();
    }

    // x0 = path -> void. mkdir every "/"- or "\\"-delimited prefix
    // (mkdir -p); existing prefixes are ignored (mkdir EEXIST).
    void HostEmitMkdirs() {
        HostBeginN("_zan_dir_mkdirs", 2048);
        HostSave(0, 0);                          // path (buffer at sp+128)
        HostLoad(0, 0);
        BLExtern("_strlen");
        HostSave(0, 1);                          // len
        LoadImm(0, 1);
        HostSave(0, 2);                          // i = 1
        int mLoop = NL(); int mNext = NL(); int mDone = NL();
        int mSlash = NL(); int mEqLen = NL();
        EmitB(mLoop);
        Mark(mLoop);
        HostLoad(9, 2);
        HostLoad(10, 1);
        HostCmp(9, 10);
        EmitBcond(12, mDone);                    // i > len
        AddImm(9, 9, -1);
        HostLoad(10, 0);                         // path
        AddRR(10, 10, 9);                        // path + i - 1
        ExtLdrbImm(11, 10, 0);
        ExtCmpImm(11, 47);
        EmitBcond(0, mSlash);                    // '/'
        ExtCmpImm(11, 92);
        EmitBcond(0, mSlash);                    // '\\'
        HostLoad(9, 2);
        HostLoad(10, 1);
        HostCmp(9, 10);
        EmitBcond(0, mEqLen);                    // i == len: full path
        EmitB(mNext);
        Mark(mEqLen);
        Mark(mSlash);
        AddImm(0, 31, 128);                      // dst = buffer
        HostLoad(1, 0);                          // src = path
        HostLoad(2, 2);                          // n = i
        BLExtern("_memcpy");
        AddImm(9, 31, 128);
        HostLoad(10, 2);
        AddRR(9, 9, 10);                         // buffer + i
        if (tgt86 == 1) {
            XGetV(9, 11);
            // 批 35:rm=011 要 REX.B(41)才是 r11——首版 C6 03 把 rbx 当
            // 地址写 0(SysV 被调者保存寄存器被裸踩成基址)
            X1(0x41); X1(0xC6); X1(0x03); X1(0x00);   // mov byte [r11], 0
        } else {
            E4(0x3900013F);                    // strb wzr, [x9]
        }
        AddImm(0, 31, 128);
        LoadImm(1, 511);                         // 0o777, umask applies
        BLExtern("_mkdir");
        Mark(mNext);
        HostLoad(9, 2);
        AddImm(9, 9, 1);
        HostSave(9, 2);
        EmitB(mLoop);
        Mark(mDone);
        HostEndN(2048);
    }

    // x0 = path -> bool. Recursively removes the tree: files unlinked,
    // subdirectories recursed, then rmdir; a missing path is success,
    // anything that survives the attempt fails. Mirrors the reference
    // Directory.DeleteRecursive contract.
    void HostEmitDelRec() {
        HostBeginN("_zan_dir_delrec", 176);      // stat buffer at sp+128
        HostSave(0, 0);                          // path
        int Lmiss = NL(); int Lfile = NL(); int Lrm = NL(); int Lret = NL();
        int Lloop = NL(); int Lnext = NL(); int Ldone = NL();
        int Ldot = NL(); int Lkeep = NL(); int Ld1 = NL(); int Ldir2 = NL();
        int Lmerge = NL(); int Lunlok = NL(); int Lgone = NL();
        HostLoad(0, 0);
        AddImm(1, 31, 128);
        BLExtern("_stat");
        HostCbnzW(Lmiss);                        // stat failed: missing
        LdrHImm(9, 31, 66);   // ldrh w9,[sp,#132]
        LsrImm(9, 9, 12); LoadImm(10, 15); AndRR(9, 9, 10); Uxtw32(9, 9);                          // ubfm w9, w9, #12, #15
        LoadImm(10, 4);
        HostCmp(9, 10);
        int Lisdir = NL();
        EmitBcond(0, Lisdir);
        EmitB(Lfile);
        Mark(Lisdir);
        HostLoad(0, 0);
        BLExtern("_opendir");
        CbzReg(0, Lrm);                          // unreadable: go rmdir
        HostSave(0, 1);                          // DIR*
        LoadImm(0, 1);
        HostSave(0, 2);                          // ok = 1
        EmitB(Lloop);
        Mark(Lloop);
        HostLoad(0, 1);
        BLExtern("_readdir");
        CbzReg(0, Ldone);
        HostSave(0, 3);                          // dirent*
        AddImm(9, 0, 21);                        // d_name
        ExtLdrbImm(10, 9, 0);
        ExtCmpImm(10, 46);
        EmitBcond(0, Ldot);
        EmitB(Lkeep);
        Mark(Ldot);
        ExtLdrbImm(10, 9, 1);
        ExtCmpImm(10, 0);
        EmitBcond(0, Lnext);                     // "."
        ExtCmpImm(10, 46);
        EmitBcond(0, Ld1);
        EmitB(Lkeep);
        Mark(Ld1);
        ExtLdrbImm(10, 9, 2);
        ExtCmpImm(10, 0);
        EmitBcond(0, Lnext);                     // ".."
        Mark(Lkeep);
        // full = path + "/" + name, over a stamped copy of d_name
        // (strcat2 requires stamped strings)
        HostLoad(9, 3);
        AddImm(0, 9, 21);
        BLExtern("_strlen");
        MovRR(1, 0);
        HostLoad(9, 3);
        AddImm(0, 9, 21);
        BLInternal("_zan_host_copy");
        MovRR(1, 0);
        HostLoad(0, 0);
        BLInternal("_zan_ext_path_combine");
        HostSave(0, 4);                          // full path (owning string)
        HostLoad(0, 4);
        AddImm(1, 31, 128);
        BLExtern("_stat");
        HostCbnzW(Lnext);                        // unstatable: skip entry
        LdrHImm(9, 31, 66);
        LsrImm(9, 9, 12); LoadImm(10, 15); AndRR(9, 9, 10); Uxtw32(9, 9);
        LoadImm(10, 4);
        HostCmp(9, 10);
        EmitBcond(0, Ldir2);
        HostLoad(0, 4);
        BLExtern("_unlink");
        ExtCmpImm(0, 0);
        LoadImm(9, 1);
        EmitBcond(0, Lunlok);
        LoadImm(9, 0);
        EmitB(Lmerge);
        Mark(Lunlok);
        EmitB(Lmerge);
        Mark(Ldir2);
        HostLoad(0, 4);
        BLInternal("_zan_dir_delrec");           // recurse
        MovRR(9, 0);
        Mark(Lmerge);
        HostLoad(10, 2);
        AndRR(10, 10, 9);                        // and x10, x10, x9
        HostSave(10, 2);                         // ok &= sub-result
        Mark(Lnext);
        EmitB(Lloop);
        Mark(Ldone);
        HostLoad(0, 1);
        BLExtern("_closedir");
        EmitB(Lrm);
        Mark(Lrm);
        HostLoad(0, 0);
        BLExtern("_rmdir");
        HostLoad(0, 0);
        AddImm(1, 31, 128);
        BLExtern("_stat");
        HostCbnzW(Lgone);                        // stat failed: gone
        LoadImm(0, 0);                           // still present: fail
        EmitB(Lret);
        Mark(Lgone);
        HostLoad(0, 2);                          // gone: return ok
        Mark(Lret);
        Mark(Lfile);
        HostLoad(0, 0);
        BLExtern("_unlink");
        LoadImm(0, 1);
        EmitB(Lret);
        Mark(Lmiss);
        LoadImm(0, 1);
        Mark(Lret);
        HostEndN(176);
    }

    // x0 = text, x1 = out address -> bool. strtoll(base 10); ok = the whole
    // text was consumed (endp moved past the start AND stopped at NUL);
    // *out = ok ? value : 0.
    void HostEmitIntTryParse() {
        // entry: x0 = out address, x1 = text. Slots: 0=out, 1=text,
        // 2=endp, 3=parsed value. ok = endp != text && *endp == 0.
        HostBegin("_zan_host_int_tryparse");
        HostSave(0, 0); HostSave(1, 1);
        LoadImm(0, 0); HostSave(0, 2);         // endp = NULL
        HostLoad(0, 1);                        // x0 = nptr (text)
        AddImm(1, 31, 16);                     // x1 = &endp (char**)
        LoadImm(2, 10);                        // base 10
        BLExtern("_strtoll");
        HostSave(0, 3);                        // parsed value
        HostLoad(0, 2);                        // endp
        HostLoad(1, 1);                        // text
        HostCmp(0, 1);
        int tpFail = NL(); int tpOk = NL(); int tpFin = NL();
        EmitBcond(0, tpFail);                  // endp == text: no digits
        ExtLdrbImm(9, 0, 0);                   // w9 = *endp
        ExtCmpImm(9, 0);
        EmitBcond(0, tpOk);                    // NUL: whole text consumed
        EmitB(tpFail);
        Mark(tpOk);
        LoadImm(0, 1); EmitB(tpFin);
        Mark(tpFail);
        LoadImm(0, 0);
        Mark(tpFin);
        int tpZero = NL(); int tpStore = NL();
        CbzReg(0, tpZero);                     // failure stores 0
        HostLoad(0, 3); EmitB(tpStore);
        Mark(tpZero); LoadImm(0, 0);
        Mark(tpStore);
        HostLoad(1, 0); StrU(0, 1, 0);         // *out = value
        HostEnd();
    }

    // x0 = string, x1 = separator, x2 = list. Pushes every occurrence-free
    // segment as a fresh owning string; an empty separator yields the whole
    // string once; empty segments (including the tail) are kept. Mirrors the
    // reference __zan_str_split exactly.
    void HostEmitStrSplit() {
        HostBegin("_zan_str_split");
        HostSave(0, 0); HostSave(1, 1); HostSave(2, 2);
        HostLoad(0, 1); BLExtern("_strlen"); HostSave(0, 3);
        HostLoad(9, 3); ExtCmpImm(9, 0);
        int spEmpty = NL(); int spDone = NL();
        int spLoop = NL(); int spTail = NL();
        EmitBcond(0, spEmpty);                 // seplen == 0 -> one element
        HostLoad(0, 0); HostSave(0, 4);        // cur = s
        EmitB(spLoop);
        Mark(spEmpty);
        HostLoad(0, 0); BLExtern("_strlen"); MovRR(1, 0);
        HostLoad(0, 0); BLInternal("_zan_host_copy");
        MovRR(1, 0); HostLoad(0, 2); BLInternal("_zan_host_list_push");
        EmitB(spDone);
        Mark(spLoop);
        HostLoad(0, 4); HostLoad(1, 1); BLExtern("_strstr");
        CbzReg(0, spTail);                     // no more separators
        HostSave(0, 5);                        // hit
        HostLoad(0, 5); HostLoad(1, 4); ExtSubRR(0, 0, 1);   // seglen
        MovRR(1, 0); HostLoad(0, 4); BLInternal("_zan_host_copy");
        MovRR(1, 0); HostLoad(0, 2); BLInternal("_zan_host_list_push");
        HostLoad(0, 5); HostLoad(1, 3); AddRR(0, 0, 1);      // cur = hit + seplen
        HostSave(0, 4);
        EmitB(spLoop);
        Mark(spTail);
        HostLoad(0, 4); BLExtern("_strlen"); MovRR(1, 0);
        HostLoad(0, 4); BLInternal("_zan_host_copy");
        MovRR(1, 0); HostLoad(0, 2); BLInternal("_zan_host_list_push");
        Mark(spDone);
        HostLoad(0, 2);
        HostEnd();
    }

    // x0 = string, x1 = needle -> bool via strstr (null-safe for the empty
    // needle: strstr(s, "") == s, so "" is contained everywhere).
    void HostEmitStrContains() {
        HostBegin("_zan_ext_str_contains");
        BLExtern("_strstr");
        int ctNo = NL(); int ctFin = NL();
        ExtCmpImm(0, 0);
        EmitBcond(0, ctNo);
        LoadImm(0, 1); EmitB(ctFin);
        Mark(ctNo); LoadImm(0, 0);
        Mark(ctFin);
        HostEnd();
    }

    // x0 = char* from dlerror -> owning stamped string ("" when null). The
    // error state is consumed by the call, matching libc.
    void HostEmitDlErrorStr() {
        HostBegin("_zan_host_dlerror_str");
        BLExtern("_dlerror");
        int dlNull = NL(); int dlFin = NL();
        CbzReg(0, dlNull);
        HostSave(0, 0);
        BLExtern("_strlen"); MovRR(1, 0);
        HostLoad(0, 0); BLInternal("_zan_host_copy");
        EmitB(dlFin);
        Mark(dlNull);
        LoadStr(extEmpty, 0);
        Mark(dlFin);
        HostEnd();
    }

    // getcwd -> owning stamped string (2048-byte buffer above the frame;
    // the whole frame must stay under the imm12 SP-adjust limit of 4096).
    void HostEmitGetCwd() {
        HostBeginN("_zan_host_getcwd", 2048);
        AddImm(0, 31, 128); LoadImm(1, 2048);
        BLExtern("_getcwd");
        int cwFail = NL(); int cwFin = NL();
        CbzReg(0, cwFail);                     // null result -> fail closed
        HostSave(0, 0);
        BLExtern("_strlen"); MovRR(1, 0);
        HostLoad(0, 0); BLInternal("_zan_host_copy");
        EmitB(cwFin);
        Mark(cwFail);
        HostFailAt("dir.getcwd");
        Mark(cwFin);
        HostEndN(2048);
    }

    // x0 = byte[] object, x1 = offset, x2 = count -> owning string of the
    // byte elements [offset, offset+count). Elements live one per 8-byte
    // slot; off/count are clamped to the array (null array -> "").
    void HostEmitNmGetStr() {
        HostBegin("_zan_nm_getstring");
        HostSave(0, 0); HostSave(1, 1); HostSave(2, 2);
        HostLoad(0, 2); ExtCmpImm(0, 0);
        int gsCPos = NL(); EmitBcond(10, gsCPos); LoadImm(0, 0);
        Mark(gsCPos); HostSave(0, 2);
        HostLoad(0, 1); ExtCmpImm(0, 0);
        int gsOPos = NL(); EmitBcond(10, gsOPos); LoadImm(0, 0);
        Mark(gsOPos); HostSave(0, 1);
        HostLoad(0, 0); ExtCountOf(0, 9);
        HostLoad(1, 1); ExtSubRR(9, 9, 1);     // avail = count - off
        ExtCmpImm(9, 0);
        int gsAPos = NL(); EmitBcond(10, gsAPos); LoadImm(9, 0);
        Mark(gsAPos);
        HostLoad(0, 2); HostCmp(0, 9);         // n = min(count, avail)
        int gsKeep = NL(); EmitBcond(9, gsKeep); ExtMov(0, 9);
        Mark(gsKeep); HostSave(0, 2);
        HostLoad(0, 2); AddImm(0, 0, 1);
        BLInternal("_zan_rt_str_alloc"); HostSave(0, 3);
        LoadImm(4, 0);
        int gsLoop = NL(); int gsDone = NL();
        Mark(gsLoop);
        HostLoad(5, 2); HostCmp(4, 5);
        EmitBcond(2, gsDone);                  // i >= n -> done
        HostLoad(5, 1); AddRR(5, 5, 4); ExtLsl(5, 5, 3);      // (off+i)*8
        HostLoad(6, 0); AddRR(5, 5, 6);
        ExtLdrbImm(5, 5, 0);
        HostLoad(6, 3); AddRR(6, 6, 4);
        ExtStrbReg(5, 6, 4);                   // strb w5, [dst, i]
        AddImm(4, 4, 1);
        EmitB(gsLoop);
        Mark(gsDone);
        HostLoad(0, 3); HostLoad(1, 2); AddRR(2, 0, 1); Strb0(2);
        HostStamp();
        HostLoad(0, 3);
        HostEnd();
    }

    // x0 = raw pointer, x1 = length -> owning 32-byte SHA-256 digest string
    // (a negative length hashes zero bytes, never wraps).
    void HostEmitNmSha() {
        HostBeginN("_zan_nm_sha256", 64);
        HostSave(0, 0); HostSave(1, 1);
        HostLoad(0, 1); ExtCmpImm(0, 0);
        int nmPos = NL(); EmitBcond(10, nmPos); LoadImm(0, 0);
        Mark(nmPos); HostSave(0, 1);
        HostLoad(0, 0); HostLoad(1, 1); AddImm(2, 31, 128);
        BLExtern("_zan_sha256");
        LoadImm(0, 33); BLInternal("_zan_rt_str_alloc"); HostSave(0, 2);
        HostLoad(0, 2); AddImm(1, 31, 128); LoadImm(2, 32);
        BLExtern("_memcpy");
        HostLoad(0, 2); HostLoad(1, 1); AddRR(2, 0, 1); Strb0(2);
        HostStamp();
        HostLoad(0, 2);
        HostEndN(64);
    }

    // pthread entry: x0 = {tid@0, thunk@8, env@16} block built by
    // Thread.Start; invoke the delegate, then return 0 to pthreads.
    void HostEmitThreadHelpers() {
        syms.Add(new Sym("_zan_host_thread_trampoline", FnPad()));
        LdrU(9, 0, 8);                         // thunk
        if (tgt86 == 1) {
            // 闭包槽里的 thunk 带 bit0=1 委托标(x86 FnPad 偶对齐使该标
            // 可逆)。x86 允许非对齐取指,call *rax 直接落进函数第二字节
            // 乱解码——进 call 前必须剥标。
            XGetV(9, 10); X3(0x49, 0x83, 0xE2); X1(0xFE); XSetV(9, 10);   // and r10,-2
        }
        LdrU(0, 0, 16);                        // env
        if (tgt86 == 1) { XSubRsp(16); X2(0xFF, 0xD0); XAddRsp(16); } else { E4(0xD63F0120); }                           // blr x9
        LoadImm(0, 0);
        LeafRet();                        // ret (pthread start routine)

        // per-thread id: the runtime face (gettid on Linux,
        // pthread_threadid_np behind the same symbol on darwin)
        HostBegin("_zan_host_thread_id");
        BLExtern("_zan_thread_current_id");
        HostEnd();
    }
    // ===================== x86-only C-host primitive replacements ======
    // (batch 35) The arm64 lane keeps the frozen C host for these symbols;
    // the x86_64 link is self-contained (no runtime objects), so each one
    // here gets a zan-native body. Emitting only under tgt86 keeps arm64
    // free of duplicate-symbol collisions with zanstubs_rest.o.

}
