using System;
using System.Collections;
namespace Zan;

// Nio: binary file output for the native backend. The File.WriteAllText
// builtin goes through strlen, so it truncates at the first NUL byte —
// object files are full of NULs, hence raw fputc.
class Nio {
    [DllImport("crt")] public static extern long fopen(string path, string mode);
    [DllImport("crt")] public static extern long fputc(int b, long f);
    [DllImport("crt")] public static extern long fclose(long f);

    public static void WriteBytes(string path, List<int> data) {
        long f = fopen(path, "wb");
        if (f == 0) { throw "Nio: cannot open " + path; }
        int i = 0;
        while (i < data.Count) {
            fputc(data[i], f);
            i = i + 1;
        }
        fclose(f);
    }
}
