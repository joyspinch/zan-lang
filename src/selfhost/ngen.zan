            // File built-ins on the raw libc surface: string literals are
            // NUL-terminated heap text, so fopen/remove/access take them
            // directly. WriteAllText holds the FILE* in x20 (callee-saved
            // across the libc calls) and skips the write when fopen failed.
            if (recv != null && recv.kind == AK.Ident() && recv.sval == "File"
                    && !UserDefinesClsMember("File", callee.sval)) {
                if (callee.sval == "Exists" && e.kids.Count == 1) {
                    GenExpr(e.kids[0]);                  // path
                    LoadImm(1, 0);                       // F_OK
                    BLExtern("_access");
                    E4(0xF100001F);                      // cmp x0, #0
                    if (tgt86 == 1) { X3(0x0F, 0x95, 0xC0); X3(0x48, 0x0F, 0xB6); X1(0xF8); } else { E4(0x9A9F07E0); }                      // cset x0, eq
                    return;
